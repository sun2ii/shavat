{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"NUM","translationId":"gmv_etw","name":"ታይቦ","commonName":"ታይቦ","title":"ታይቦ ማጻፋ","order":4,"numberOfChapters":36,"sha256":"142a1508486607d8cc174463cf303de9e2b5ed8fea10663f9f3ce8f863876692","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/gmv_etw/NUM/36.json","totalNumberOfVerses":1271},"chapter":{"number":23,"content":[{"type":"heading","content":["ባላሜይ ዮቲዳ ኮይሮ ቲንቢቴ"]},{"type":"verse","number":1,"content":["ባላሜይ ባላቄ፥ «ኔ ታስ ሃይሳን ላፑን ያርሾ ያርሻናሶታ ኦ፤ ቃሴካ ላፑን ኮርማ ቦራታኔ ላፑን ዶርሳ ርሾታ ታስ ሃ ኤካ ያ» ጊዴስ።"]},{"type":"verse","number":2,"content":["ባላቄይ ባላሜይ ኢዛስ ዮቲዳ ማላ ኦዴስ፤ ኢስቲ ናምኣይ ያርሾ ያርሺዛሶሆታ ቦላ ኢሲ ኢሲ ኮርማ ቦራኔ ኢሲ ኢሲ ርሾ ያርሾ ሺሺዳ።"]},{"type":"verse","number":3,"content":["ሄሳፌ ጉዬ ባላሜይ ባላቄስ፥ «ጾሲ ሃ ታኮ ያናኮኔ ዮንታኮ ታኒ ጌዴ ባዳ ኤራና ጋካናስ ኔኒ ሃይሳን ጹጌቲዛ ያርሾዛ ኣቻን ኤቃሻ፤ ጎዳይ ታስ ቆንጪሲኮ ሄሳ ታ ኔስ ዉርሳ ዮታና» ጊዴስ፤ ሄሳፌ ጉዬ ባላሜይ ባርካ ፑዴ ቃሶ ኬዚዴስ።"]},{"type":"verse","number":4,"content":["ሄን ጾሲ ኢዛራ ጋይቲዴስ፤ ባላሜይካ፥ «ታኒ ላፑን ያርሾ ያርሺዛሶሆታ ጊጊሳዲስ፤ ያርሾ ያርሺዛሶሆታ ኢሳ ኢሳ ቦላ ኢሲ ኢሲ ኮርማ ቦራኔ ኢሲ ኢሲ ርሾ ያርሻዲስ» ጊዴስ።"]},{"type":"verse","number":5,"content":["ጎዳይካ ባላሜይ ባላቄስ ዮታናስ ቤሲዛ ኪታ ኢዛስ ዮቲዳፔ ጉዬ ባላቄኮ ሲሚ ባና ማላ ዮቲዴስ።"]},{"type":"verse","number":6,"content":["ኢዚካ ጉዬ ሲሚ ቢሺን ባላቄይ ሞኣቤ ኣይሲዛ ዳናታ ኡባራ ኢሲፌ ሄ ጹጌቲዛ ያርሾዛ ኣቻን ኤቂዳ ማላ ዴሚዴስ።"]},{"type":"verse","number":7,"content":["ሄሳፌ ጉዬ ባላሜይ ሃሳያ ዶሚዲ፥",{"text":"«ሞኣቤ ካዎ ባላቄይ","poem":1},{"text":"ኣርሼይ ሞኪዛ ባጋራ ዲዛ","poem":2},{"lineBreak":true},{"text":"ዙማቲ ዲዛ ኣራሜፔ","poem":2},{"lineBreak":true},{"text":"ታና ጼይጊ ኤሂዴስ፤","poem":2},{"lineBreak":true},{"text":"ኢዚ ታና፥","poem":2},{"lineBreak":true},{"text":"‹ሃ ያዳ ኢስራኤሌ ኣሳ","poem":2},{"lineBreak":true},{"text":"ታስ ዶቃርኪ!","poem":2},{"lineBreak":true},{"text":"ኢስቲ ያና ማላ","poem":2},{"lineBreak":true},{"text":"ታስ ኢስታ ቃንጋርኪ!› ጊዴስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሂስቲን ታኒ ጾሲ","poem":1},{"text":"ቃንጎንታዴ ዎስታ ቃንጎ?","poem":2},{"lineBreak":true},{"text":"ጾሲ ሂሎንታዴ","poem":2},{"text":"ታኒ ዎስታ ሂሎ?","poem":3}]},{"type":"verse","number":9,"content":[{"text":"ታኒ ኢስታ ሃይታ","poem":1},{"text":"ጊታ ዛላታ ቦላ","poem":2},{"text":"ዳሼ ዴማይስ፤","poem":3},{"text":"ቃ ዙማታ ቦላ ዳሼ","poem":2},{"lineBreak":true},{"text":"ታ ኢስታ ጼላይስ፤","poem":2},{"lineBreak":true},{"text":"ኢስቲ ባርካ ዲዛ ካዎቴ፤","poem":2},{"lineBreak":true},{"text":"ኢስቲ ባና","poem":2},{"text":"ሃራ ካዎቴራ ጋ","poem":3},{"text":"ቆዶንታይሲ ታስ ቤቴስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ጉዱላ ማላ ጮሪዳ","poem":1},{"text":"ያቆቤ ዜሬ","poem":2},{"lineBreak":true},{"text":"ቆዲ ዳንዳያናይ ኦኔ?","poem":2},{"lineBreak":true},{"text":"ዎይኮ ኢስራኤሌስ ጪጎዛካ","poem":2},{"lineBreak":true},{"text":"ቆዲ ካንናይ ኦኔ?","poem":2},{"text":"ጺሎ ኣሳታ ሃይቆ","poem":3},{"lineBreak":true},{"text":"ታ ሃይቃና፤","poem":3},{"text":"ታ ዉርሴይካ","poem":2},{"lineBreak":true},{"text":"ኢስታ ዉርሴ ማላ ጊዶ» ጊዴስ።","poem":2}]},{"type":"verse","number":11,"content":["ባላቄይ ባላሜስ፥ «ሃይሲ ኔ ታ ቦላ ኦዳይሲ ኣዜ? ታኒ ኔና ሃ ኤሂዳይ ኔ ታ ሞርኬታ ቃንጋናሳ፤ ኔኒ ጊዲኮ ኢስታ ኣንጆ ኣንጃዳሳ ኣቲን ቃንጋቤካ» ጊዴስ።"]},{"type":"verse","number":12,"content":["ባላሜይካ ዛሪዲ፥ «ጎዳይ ታስ ቆንጪሲዳይሳ ጻላ ታ ዮታናስ ቤሴኔ?» ጊዴስ።"]},{"type":"heading","content":["ባላሜይ ዮቲዳ ናምኣን ቲንቢቴ"]},{"type":"verse","number":13,"content":["ባላቄይ ባላሜስ፥ «ኢስራኤሌ ኣሳ ኩሜ ጊዶንታ ኢስታፌ ጉቲ ኔስ ቤቲዛሶ ጌዴ ሃራሶ ታናራ ኢሲፌ ባዳ ኔ ኢስታ ሄን ታስ ቃንጋርኪ!» ጊዴስ።"]},{"type":"verse","number":14,"content":["ሄሳፌካ ፑዴ ፒዝጋ ዙማ ሁኤን ዲዛ ጾፊሜ ዴምባ ኤፊዴስ፤ ሄንካ ላፑን ያርሾ ያርሺዛሶ ጊግሲዲ ኢሲ ኢሲ ያርሺዛሶዛ ቦላ ኢሲ ኢሲ ኮርማ ቦራኔ ርሾ ያርሺዴስ።"]},{"type":"verse","number":15,"content":["ባላሜይ ባላቄስ፥ «ኔኒ ሃይሳ ጹጌቲዛ ያርሾዛ ማታን ኤቃሻ፤ ታኒ ጎዳራ ጋይታና ጌዴ ባይስ» ጊዴስ።"]},{"type":"verse","number":16,"content":["ጎዳይካ ባላሜራ ሄን ጋይቲዴስ፤ ኢዚ ዮታና ኪታ ኢዛስ ዮቲዲ ኔኒ ባላቄኮ ሲማ ባዳ ሃይሳ ሃ ኪታ ኢዛስ ዮታ።"]},{"type":"verse","number":17,"content":["ኢዚ ሲሚ ቢሺን ባላቄይ ሞኣቤ ዴሬዛ ካሌዛይታራ ሄ ጹጌቲዛ ያርሾዛ ማታን ኤቂዳ ማላ ዴሚዴስ፤ ባላቄይካ ጎዳይ ኢዛስ ኣይ ዮቲዳኮ ኢዛ ኦይቺዴስ።"]},{"type":"verse","number":18,"content":["ባላሜይካ ኢዛስ ሃሳያ ዶሚሼ፥",{"text":"«ጺፖራ ና ባላቄ!","poem":1},{"text":"ሃ ሺቃ!","poem":2},{"text":"ታኒ ኔስ ዮቲዛይሳ ሲያ።","poem":3}]},{"type":"verse","number":19,"content":[{"text":"ጾሲ ኣሳ ማላ ዎርዶቴና፤","poem":1},{"text":"ኢዛ ቆፋይ","poem":2},{"lineBreak":true},{"text":"ኣሳ ቆፋ ማላ ላሜቴና፤","poem":2},{"text":"ኢዚ ባ ኢሚዳ ሂዶታ","poem":3},{"text":"ኡባ ፖሌስ፤","poem":2},{"text":"ኢዚ ባ ዮቲዳ","poem":3},{"text":"ኡባ ኦስ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ኢዚ ታስ","poem":1},{"text":"ታ ኣንጃና ማላ ዮቲዴስ፤","poem":2},{"lineBreak":true},{"text":"ጾሲ ኣንጂዳ ቃላ","poem":2},{"lineBreak":true},{"text":"ታኒ ላማናስ ዳንዳይኬ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ያቆቤ ዜሬ ቦላ","poem":1},{"text":"ሜቶይ ጋኬና፤","poem":2},{"lineBreak":true},{"text":"ኢስራኤሌ ኣሳ ቦላካ","poem":2},{"lineBreak":true},{"text":"ዋዬይ ጋኮንታይሲ","poem":2},{"text":"ታስ ቤቴስ፤","poem":3},{"text":"ጎዳይ ኢስታራ ዴስ፤","poem":2},{"lineBreak":true},{"text":"ጾሲ ካዎ ጊዲዳይሳ","poem":2},{"lineBreak":true},{"text":"ኢስቲ ቆንጬን ዮቴቴስ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ጾሲ ኢስታ","poem":1},{"text":"ጊብጼፔ ኬሲዴስ፤","poem":2},{"lineBreak":true},{"text":"ኢዚ ኢስታስ","poem":2},{"lineBreak":true},{"text":"ሜን ማላ ቃይጫና።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ያቆቤ ናይታ ቦላ","poem":1},{"text":"ኣይ ቢታይ፥","poem":2},{"lineBreak":true},{"text":"ኢስራኤሌ ቦላ","poem":2},{"lineBreak":true},{"text":"ኣይ ሙሬኖይካ ኦና፤","poem":2},{"lineBreak":true},{"text":"ሄኮ ሃኢ ያቆቤሲኔ","poem":2},{"text":"ኢስራኤሌስ፥","poem":3},{"text":"‹ጾሲ ኢስቲ ኣይ ኦዳኮ","poem":2},{"lineBreak":true},{"text":"ኣኔ ጼሊቴ!› ጌቴታና።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ኢስራኤሌ ኣሳይ","poem":1},{"text":"ማጫ ጋሞ ማላ ዴንዳና፤","poem":2},{"lineBreak":true},{"text":"ባ ሻንካቲ ኤሂዳይሳ ሞንታ፥","poem":2},{"lineBreak":true},{"text":"ሱካ ኡዮንታ ዲሼ","poem":2},{"lineBreak":true},{"text":"ሼምፖንታ ጋሞ ማላ","poem":2},{"lineBreak":true},{"text":"ዴንዳና» ጊ ዮቲዴስ።","poem":2}]},{"type":"verse","number":25,"content":["ሄሳፌ ጉዬ ባላቄይ ባላሜስ፥ «ኔኒ ኢስራኤሌ ኣሳ ቃንጎንታ ኢጺዳ ማላ ኢስታ ኣንጆካ ኣንጆፋ!» ጊዴስ።"]},{"type":"verse","number":26,"content":["ባላሜይካ፥ «ታኒ ካሴ ኔስ ጎዳይ ታስ ዮቶሮ ጻላ ታ ኦና ጋዳ ዮታቤኪና?» ጊዴስ።"]},{"type":"heading","content":["ባላሜይ ዮቲዳ ሄን ቲንቢቴ"]},{"type":"verse","number":27,"content":["ባላቄይካ፥ «ሃ ያ ኣኔ ሃይሳፌ ሃራሶ ቦስ፤ ኦኔ ኤሪዛይ ኔኒ ሄን ዳዳ ሃይሳ ዴሬዛ ታስ ቃንጋና ማላ ጾሲ ኔስ ኤሮ ጎንታ ኣጌና» ጊዴስ።"]},{"type":"verse","number":28,"content":["ሄሳ ጊሻስ ባላቄይ ባላሜ ጌዴ ባዞ ጊናራ ዲዛ ፔኦሬ ዙማ ሁኤ ኤኪ ኬዚዴስ።"]},{"type":"verse","number":29,"content":["ባላሜይካ ኢዛ፥ «ሃይሳን ታስ ላፑን ያርሾ ያርሺዛሶ ጊጊሳ፤ ላፑን ኮርማ ቦራታኔ ላፑን ርሾታ ሃ ታስ ኤካ ያ» ጊዴስ።"]},{"type":"verse","number":30,"content":["ባላቄይካ ባላሜይ ኢዛስ ዮቲዳ ማላ ኦዴስ፤ ያርሾ ያርሺዛሶዛ ቦላ ኢሲ ኢሲ ኮርማ ቦራኔ ኢሲ ኢሲ ርሾ ያርሾ ሺሺዴስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/NUM/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/NUM/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/NUM/22.json","previousChapterAudioLinks":{},"numberOfVerses":30}