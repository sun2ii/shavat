{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"REV","translationId":"gmv_etw","name":"ዮሃኒሳ ኣጁታ","commonName":"ዮሃኒሳ ኣጁታ","title":"ዮሃኒሳ ኣጁታ","order":66,"numberOfChapters":22,"sha256":"453e4ab75fa2dbc7e49fcc390f956678d37210457947a6a4ebb02e75546310c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/gmv_etw/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":15,"content":[{"type":"heading","content":["ዉርሴ ቦሻታ ኦይኪዳ ኪታንቻታ"]},{"type":"verse","number":1,"content":["ታኒ ሃራ ዎልቃማ ማላታ ሳሎ ቦላ ቤያዲስ፤ ጾሳ ሃንቆይ ኢስታን ፖሌታናስ ዉርሴ ጊዲዳ ላፑን ቦሻታ ኦይኪዳ ላፑን ኪታንቻታ ቤያዲስ።"]},{"type":"verse","number":2,"content":["ሄሳፌ ጉዬ ታማራ ዋላኬቲዳ ማስቶቴ ኣባ ሚሳቲዛ ሚሽ ቤያዲስ፤ ሄሳካ ሄ ዶኣዛኔ ኢዛ ሚስሌዛ ኢዛ ሱን ቁጹሬዛ ማላታ ጾኒዳይታ ቤያዲስ፤ ጾሲ ኢስታስ ኢሚዳ ዲ ማላ ባጋና ጌቴቲዛይሳ ኦይኪዲ ማስቶቴ ሚሳቲዛ ኣባ ኣቻን ኤቂዳ።"]},{"type":"verse","number":3,"content":["ጾሳ ኦሳንቻ ሙሴ ዬኔ ዶርሳዛ ማዛሙሬ፥",{"text":"«ኡባ ዳንዳይዛ ጎዳ ጾሶ!","poem":1},{"text":"ኔ ኦሶይ ጊታኔ ማላሊሲዛዛ፤","poem":2},{"lineBreak":true},{"text":"ዴሬ ካዎዞ!","poem":2},{"noteId":1},{"lineBreak":true},{"text":"ኔ ኦጌይ ሊኬኔ ቱማ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ጎዶ፥ ኔስ ባቦንታ ኣሲኔ","poem":1},{"text":"ኔ ሱን ቦንቾንታ ኣሲ ኦኔ?","poem":2},{"lineBreak":true},{"text":"ኔኒ ኔርካ ጌሻ፤","poem":2},{"lineBreak":true},{"text":"ኔ ቱማ ፒርዳይ","poem":2},{"lineBreak":true},{"text":"ቆንጪዳ ጊሻስ","poem":2},{"lineBreak":true},{"text":"ዴሬቲ ዉሪ ዪዲ","poem":2},{"text":"ኔ ሲንን ኔስ ጎይናና»","poem":3},{"text":"ጊ ዬጺዳ።","poem":2}]},{"type":"verse","number":5,"content":["ሄሳፌ ጉዬ ታ ዛራ ጼሊሺን ካሴ ማርካቴ ዱንካኔ ጊዲዳይሲ ጾሳ ኬ ሳሎን ዶዬቲዴስ።"]},{"type":"verse","number":6,"content":["ላፑን ቦሻታ ኦይኪዳ ላፑን ኪታንቻቲ ጾሳ ኬፌ ኬዚዳ፤ ኢስቲ ጌሽ ጊዲዲ ጾልቂዛ ቦ ማይኦ ማይኢዳ፤ ዎርቃፌ ኦሴቲዳ ዳንጮ ማላ ማይኦ ቲራ ቦላ ቃቺዳ።"]},{"type":"verse","number":7,"content":["ኦይዱ ዶኣታፔ ኢሶይ ላፑን ኪታንቻታስ ሜርናፔ ሜርናስ ዲዛ ጾሳ ሃንቆይ ኢስታን ኩሚ ኡቲዳ ላፑን ዎርቃ ጹኣታ ኢሚዴስ።"]},{"type":"verse","number":8,"content":["ጾሳ ኬይካ ጾሳ ቦንቾፌኔ ኢዛ ዎልቃፌ ዴንዲዳይሳን ጩዋይ ኢዛን ኩሚዴስ፤ ላፑን ኪታንቻቲ ባ ኩሼን ኦይኪዳ ላፑን ቦሻቲ ፖሌታና ጋካናስ ኦኒካ ጾሳ ኬ ጌላናስ ዳንዳይቤና።"]}],"footnotes":[{"noteId":1,"caller":"+","text":"15፡3 ዴሬ ካዎዞ፡ ዴሬ ካዎዞ ጊዛይሳ ኢሲ ኢሲ ቢርሼቲ ዎዴታ ካዎዞ ጌቴስ።","reference":{"chapter":15,"verse":3}}]},"thisChapterLink":"/api/gmv_etw/REV/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/REV/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/REV/14.json","previousChapterAudioLinks":{},"numberOfVerses":8}