{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"REV","translationId":"gmv_etw","name":"ዮሃኒሳ ኣጁታ","commonName":"ዮሃኒሳ ኣጁታ","title":"ዮሃኒሳ ኣጁታ","order":66,"numberOfChapters":22,"sha256":"453e4ab75fa2dbc7e49fcc390f956678d37210457947a6a4ebb02e75546310c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/gmv_etw/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":4,"content":[{"type":"heading","content":["ሳሎን ዲዛ ጎይኖ ዎጋ"]},{"type":"verse","number":1,"content":["ሄሳፌ ጉዬ ታኒ ሳሎን ዶያ ዲዛ ፔንጌ ቤያዲስ፤ ታኒ ኮይሮ ሲዪዳይ ዲንኬ ጊሪሳ ማላ ጊሪሲ፥ «ሃ ፑዴ ኬዛ፤ ቡሮፔ ሃናና ሚሻታ ታ ኔና ቤሳና» ጊዴስ።"]},{"type":"verse","number":2,"content":["ታኒ ሄራካ ኣያናን ሊጲጲ ጋዳ ሳሎን ዲዛ ኣልጋ ቤያዲስ፤ ሄ ኣልጋዛ ቦላካ ኢሳዴይ ኡቲዴስ።"]},{"type":"verse","number":3,"content":["ሄ ኣልጋ ቦላ ኡቲዳይሳ ሜይ ኢያስጲዴኔ ሳርዲዮኔ ኢንቁ ሚሳቲዛ ኣልጋዛ ዩዪ ኣዲ ማርጊዴ ጌቴቲዛ ኢንቁ ሚሳቲዛ ዙላይ ዴስ።"]},{"type":"verse","number":4,"content":["ሄሳካ ሄ ኣልጋዛ ዩዪ ኣዳ ናምኡ ታማኔ ኦይዱ ኣልጋቲ ዴቴስ፤ ሄ ኣልጋታ ቦላ ቃሴ ቦ ማይኦ ማይኢዲ ባ ሁኤ ቦላ ዎርቃ ኣኪሊሌ ዎዳ ናምኡ ታማኔ ኦይዱ ጪማቲ ኡቲዳ።"]},{"type":"verse","number":5,"content":["ሄ ኣልጋፌ ዎልቃንኔ ዳዳ ጊሪሲ ኬዜስ፤ ሄ ኣልጋ ሲንን ፖኢዛ ላፑን ጾምፔቲ ዴቴስ፤ ሄይቲካ ጾሳ ኣያና ላፑናታ።"]},{"type":"verse","number":6,"content":["ሄ ኣልጋ ሲንን ጌሽ ሚሊጺ ጊዳ ጾልቂዛ ማስቶቴ ሚሳቲዛ ኣባይ ዴስ፤ ኢዛ ጊዶን ኣልጋ ዩሾን ዳሮ ኣይፌራ ዲዛ ኦይዱ ዶኣቲ ዴቴስ።"]},{"type":"verse","number":7,"content":["ኮይሮ ዶኣዚ ጋሞ ሚሳቴስ፤ ናምኣንዚ ቦራ ሚሳቴስ፤ ሄንዛ ኣይፌሶይ ኣሳ ኣይፌሶ ሚሳቴስ፤ ኦይዳንዚ ፒራዛ ጎሌ ካፎ ሚሳቴስ።"]},{"type":"verse","number":8,"content":["ሄ ኦይዱ ዶኣቲ ኢሶይ ኢሶይ ኡሱፑን ቄፌራ ዴቴስ፤ ቄፌታ ዩሾኒኔ ቄፌታ ጊዶን ኣይፌይ ኩሚዴስ፤ ኢስቲ ቃማኔ ጋላስ፥",{"text":"«ጌሻዉ! ጌሻዉ!","poem":1},{"text":"ጌሻዉ!","poem":2},{"lineBreak":true},{"text":"ኡባ ዳንዳይዛ ጎዶ!","poem":2},{"lineBreak":true},{"text":"ካሴካ ሃኢካ ዲዛይሶ!","poem":2},{"lineBreak":true},{"text":"ቡሮካ ያናይሶ","poem":2},"ጉሳፌ ሼምፒ ኤሬቴና።"]},{"type":"verse","number":9,"content":["«ሄ ዶኣቲ ኣልጋ ቦላ ኡቲዳይሳሲኔ ሜርናፔ ሜርና ጋካናስ ዲዛይሳስ ጊታቴ፥ ቦንቾኔ ጋላታካ ሺሺዛ ዎዴ ኡባን፥"]},{"type":"verse","number":10,"content":["ናምኡ ታማኔ ኦይዱ ጪማቲ ሜርናፔ ሜርና ጋካናስ ዲዛ ባ ኣልጋ ቦላ ኡቲዳይሳ ሲንን ጉፋኒዲ ኢዛስ ጎይኔቴስ፤ ባ ኣኪሊሌታካ ሄ ኣልጋዛ ሲንን ዎዲ፥"]},{"type":"verse","number":11,"content":[{"text":"«ኑ ጎዳ ጾሶ!","poem":1},{"text":"ኔኒ ኡባ ሜዳ ጊሻስ","poem":2},{"text":"ሜቴ ዉሪካ","poem":3},{"text":"ሜቲዳይኔ","poem":2},{"lineBreak":true},{"text":"ሼምፖራ ዲዛይ","poem":2},{"lineBreak":true},{"text":"ኔ ሼኔን ጊዲዳ ጊሻስ","poem":2},{"lineBreak":true},{"text":"ጊታቴ፥ ቦንቾይኔ","poem":2},{"lineBreak":true},{"text":"ዎልቃይካ","poem":2},{"text":"ኔስ ቤሴስ» ጊዳ።","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/REV/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/REV/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/REV/3.json","previousChapterAudioLinks":{},"numberOfVerses":11}