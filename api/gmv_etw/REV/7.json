{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"REV","translationId":"gmv_etw","name":"ዮሃኒሳ ኣጁታ","commonName":"ዮሃኒሳ ኣጁታ","title":"ዮሃኒሳ ኣጁታ","order":66,"numberOfChapters":22,"sha256":"453e4ab75fa2dbc7e49fcc390f956678d37210457947a6a4ebb02e75546310c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/gmv_etw/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":7,"content":[{"type":"heading","content":["ጼታኔ ኦይዱ ታማኔ ኦይዱ ሺ ኣሳ ኣታሜቴ"]},{"type":"verse","number":1,"content":["ሄሳፌ ጉዬ ኦይዱ ኪታንቻታ ቢታ ቦላ ኦይዱ ባጋራ ኤቂዳይታ ቤያዲስ፤ ኢስቲካ ቢታ ቦላ ጊዲን ዎይኮ ኣባ ቦላ ዎይኮ ሚ ቦላ ኣይ ጫርኮይካ ጫርኮንታ ማላ ኦይዱ ባጋራ ዪዛ ቦሻ ጫርኮ ዉርሲ ኦይኪዳ።"]},{"type":"verse","number":2,"content":["ዴኦ ጾሳ ማታሜ ኦይኪዳ ሃራ ኪታንቻይ ኣርሼይ ሞኪዛ ባጋራ ሃ ዪሺን ታ ቤያዲስ፤ ቢታኔ ኣባ ቆሃናስ ኢስታስ ጎዳቴ ኢሜቲዳ ኦይዱ ኪታንቻቲ ባ ቃላ ቁ ሂስቲዲ፥"]},{"type":"verse","number":3,"content":["«ኑኒ ኑ ጎዳ ኦሳንቻታ ሊጴ ቦላ ማታሜ ዎና ጋካናስ ቢታ ቦላ ጊዲን ዎይኮ ኣባ ጊዶን ዲዛይታ ጊዲን ዎይኮ ሚታ ጊዲንካ ሄይታንታ ቆሆፒቴ» ጊ ዋሲዴስ።"]},{"type":"verse","number":4,"content":["ታኒካ ማታሜይ ኢስታ ቦላ ዎዳይታ ቆዳ ሲያዲስ፤ ኢስራኤሌ ኣሳ ኮቻ ኡባፌ ማታሜይ ኢስታ ቦላ ሾጬቲዳይታ ቆዳይ ጼታኔ ኦይዱ ታማኔ ኦይዱ ሺ ኣሳ።"]},{"type":"verse","number":5,"content":[{"text":"ዩሁዳ ቆሞፌ","poem":1},{"text":"ታማኔ ናምኡ ሺ፥","poem":2},{"text":"ኤሮቤሌ ቆሞፌ","poem":1},{"text":"ታማኔ ናምኡ ሺ፥","poem":2},{"text":"ጋዴ ቆሞፌ","poem":1},{"text":"ታማኔ ናምኡ ሺ፥","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኣሴሬ ቆሞፌ","poem":1},{"text":"ታማኔ ናምኡ ሺ፥","poem":2},{"text":"ኒፍታሌሜ ቆሞፌ","poem":1},{"text":"ታማኔ ናምኡ ሺ፥","poem":2},{"text":"ሚናሴ ቆሞፌ","poem":1},{"text":"ታማኔ ናምኡ ሺ፥","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሲሞና ቆሞፌ","poem":1},{"text":"ታማኔ ናምኡ ሺ፥","poem":2},{"text":"ሌዌ ቆሞፌ","poem":1},{"text":"ታማኔ ናምኡ ሺ፥","poem":2},{"text":"ዪሳኮሬ ቆሞፌ","poem":1},{"text":"ታማኔ ናምኡ ሺ፥","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዛቢሎኔ ቆሞፌ","poem":1},{"text":"ታማኔ ናምኡ ሺ፥","poem":2},{"text":"ዮሴፌ ቆሞፌ","poem":1},{"text":"ታማኔ ናምኡ ሺ፥","poem":2},{"text":"ቢኒያሜ ቆሞፌ","poem":1},{"text":"ታማኔ ናምኡ ሺ።","poem":2}]},{"type":"heading","content":["ቦ ማይኦ ማይኢዳ ዳሮ ዴሬ"]},{"type":"verse","number":9,"content":["ሄሳፌ ጉዬ ታ ጼሊሺን ቆዳይ ባይንዳ ዳሮ ዴሬይ ዲዛይሳ ቤያዲስ፤ ሄይታንቲካ ዴሬፔ፥ ዱማ ዱማ ቆሞፌ፥ ዱማ ዱማ ዛርኬፌኔ ዱማ ዱማ ቃላ ሃሳይዛይታፔ ሺቄቲዳይታ። ሄይቲ ዉሪ ቦ ማይኦ ማይኢዲ ዛምባ ሃይ ባ ኩሼን ኦይኪዲ ኣልጋ ሲንኒኔ ዶርሳዛ ሲንን ኤቂዳ።"]},{"type":"verse","number":10,"content":["ቃላ ቁ ሂስቲዲ፥",{"text":"«ኣቶቴ ኣልጋ ቦላ ኡቲዳ","poem":1},{"text":"ኑ ጎዳፔኔ ዶርሳዛፔኮ!» ጊዳ።","poem":2}]},{"type":"verse","number":11,"content":["ኢዛ ኪታንቻቲ ዉሪካ ኢዛ ኣልጋስ፥ ጪማታኔ ኦይዱ ዶኣታ ዩዪ ኣ ኤቂዳ ኣልጋዛ ሲንን ጉፋኒዲ ጾሳስ ጎይኒዳ።"]},{"type":"verse","number":12,"content":[{"text":"«ኣሚን! ሳባይ፥ ጊታቴ፥","poem":1},{"text":"ኤራቴ፥ ጋላታይ፥ ቦንቾይ፥","poem":2},{"text":"ዎልቃይኔ ሚኖቴ","poem":3},{"lineBreak":true},{"text":"ኑ ጎዳስ ጾሳስ","poem":3},{"text":"ሜርናፔ ሜርናስ ጊዶ።","poem":2},{"lineBreak":true},{"text":"ኣሚን!» ጊዳ።","poem":2}]},{"type":"verse","number":13,"content":["ጪማታ ጊዶፌ ኢሳዴይ ታኮ ሲሚዲ ታና፥ «ሃይቲ ቦ ማይኦ ማይኢዳይቲ ኦናንቴ? ኢስቲ ኣዋፔ ዪዳይቴ?» ጊዴስ።"]},{"type":"verse","number":14,"content":["ታኒካ፥ «ጎዳዉ! ኔ ኤራሳ» ጋዲስ። ኢዚካ ታስ፥ «ሃይቲ ዎልቃማ ዋዬዛ ካንዲ ዪዳይታ፤ ኢስቲ ባ ማይኦካ ዶርሳ ሱን ሜጪ ጌሺዳ።"]},{"type":"verse","number":15,"content":["ሄሳ ጊሻስ ጾሳ ኣልጋ ሲንን ዴኢዲ ቃማኔ ጋላስ ኢዛ ኬን ኢዛስ ኦቴስ፤ ኣልጋ ቦላ ኡቲዳይሲ ባ ቦንቾራ ቤቲዲ ኢስታስ ኩዋሶ ጊዳና።"]},{"type":"verse","number":16,"content":["ሃይሳፌ ጉዬ ኢስቲ ጋፌቴና፤ ሳሞቴቴና፤ ኣርሼ ሴላይካ ኢስታ ቦቼናኔ ሆምቤይካ ኢስታ ሆምቤና።"]},{"type":"verse","number":17,"content":["ኣልጋዛስ ጊዶ ኣዳን ኡቲዳ ዶርሳይ ኢስታ ሄሚዛዴ ጊዳና፤ ኢስታካ ጌዴ ዴኦ ሃ ፑልቶይ ዲዛሶ ካሌና፤ ጾሲ ኢስታ ኣይፌፔ ኣፉን ቁጫና» ጊዴስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/REV/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/REV/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/REV/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}