{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"ROM","translationId":"gmv_etw","name":"ኦሮሜ ኣሳስ","commonName":"ኦሮሜ ኣሳስ","title":"ጳዉሎሲ ኦሮሜ ኣሳስ ጻፊዳ ኪታ","order":45,"numberOfChapters":16,"sha256":"47db342dd6ad529cf124d69e837a2bcb5f0c708c2f29ec0dcdec45b24fa78a19","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/ROM/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/gmv_etw/ROM/16.json","totalNumberOfVerses":432},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":["ሂስቲኮ ኣይሁዳ ኣስ ጊዴስ ኣዛ ጎኣይ ዲዜ? ቃጻራይ ኣይ ጎኢዜ?"]},{"type":"verse","number":2,"content":["ኣዋራካ ጊዲን ጎኣይ ዳሮ፤ ሃራፔ ኮይሮ ጾሳ ቃላይ ሃዳራ ኣይሁዳታስ ኢሜቲዴስ።"]},{"type":"verse","number":3,"content":["ኢስታፌ ኢሶታስ ኢሶታስ ኣማኖይ ባይንዳ ኣጊኮ ጾሳን ኣማኔቴ ዲጊዜ?"]},{"type":"verse","number":4,"content":["ሙሌካ ዲጌና! ኣሲ ዉሪካ ዎርዳንቻ፥",{"text":"«ኔኒ ኔ ቃላፔ","poem":1},{"text":"ዴንዲዳይሳን ቱማንቻ፤","poem":2},{"lineBreak":true},{"text":"ኔ ሞርኬ ፒርዳንካ ጾናሳ»","poem":2},{"lineBreak":true},{"text":"ጌቴቲ ጻፌቲዳ ማላ","poem":2},{"lineBreak":true},{"text":"ጾሲ ቃሴ ቱማንቻ።","poem":2}]},{"type":"verse","number":5,"content":["ኑ ማካላ ኦሶይ ጾሳ ጺሎቴ ቆንጬን ቤሲዛይሳ ጊዲኮ ሂስቲን ኑ ኣይ ጋኔ? ጮ ኣሳ ዎጋ ማላ ፓላሜታናስ ጾሲ ባ ሃንቆ ኑ ቦላ ኤሂዛይሲ ኑስ ቤሴና ጋኔዬ? ሄሳካ ታ ጊዛይ ኣሳ ቆፋና።"]},{"type":"verse","number":6,"content":["ቱማፔ ሄሳ ሃኔና፤ ሄሳ ሃኒዛ ጊዲኮ ጾሲ ኣላሜ ቦላ ዎስቲ ፒርዳንዴ?"]},{"type":"verse","number":7,"content":["«ታ ዎርዶቴ ጾሳ ቱማቴ ቆንጪሲዛይሳን ኢዛ ቦንቾ ጌዴ ጉጂዛ ጊዲኮ ሂስቲን ሃኢ ጋካናስ ዎስቲ ታ ቦላ ናጋራንቻ ማላ ፒርዴቲዜ?» ጊዲ ፓላሜታና ኣሲ ዳና ዳንዳዬስ።"]},{"type":"verse","number":8,"content":["ሄሳ ጉሲ፥ «ሎኦይ ያና ማላ ኣኔ ኢታ ኦስ» ጌቴስ ጊዲ ኢሲ ኢሲ ኣሳቲ ኑ ቦላ ዎሬሲዛይሳ ማላ። ሃይታ ኣሳታ ቦላ ጋኪዛ ፒርዳይ ቱሙ ፒርዳ።"]},{"type":"heading","content":["ኣሲ ዉሪ ናጋራንቻ"]},{"type":"verse","number":9,"content":["ሂስቲን ኑ ኣይ ጊኖ? ኑኒ ኢስታፌ ኣዞኒ? ሙሌካ ኣኮ። ኣይሁዳታ ጊዲኮካ፥ ኣይዛቤታ ጊዲኮካ ዉሪካ ናጋራፔ ጋርሳ ባጋራ ዲዛ ጊሻስ ታ ዉርሳካ ካሴታዳ ኢስታስ ዮታዲስ።"]},{"type":"verse","number":10,"content":[{"text":"«ጺሎይ ኦኒካ ዴና፤","poem":1},{"text":"ኢሳዴይካ ዴና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዩሺ ቆፒዛዴይ ባ፤","poem":1},{"text":"ጾስ ኮይዛይ ኢሳዴይካ ባ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዉሪካ ባሌቲዳኔ","poem":1},{"text":"ኢሲ ቦላ ጎኦንታይታ ጊዲዳ።","poem":2},{"lineBreak":true},{"text":"ሎኦ ኦዛይ ኦኒካ ባ፤","poem":2},{"lineBreak":true},{"text":"ኢሳዴይካ ዴና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኢስታ ዶናይ ዶያ ዲዛ ዱፎ ማላ፤","poem":1},{"text":"ኢስታ ዶናይ ኡባ ዎዴ","poem":2},{"lineBreak":true},{"text":"ባሌ ሃሳዬስ፤","poem":2},{"lineBreak":true},{"text":"ኢስታ ሜቴርሻይ","poem":2},{"lineBreak":true},{"text":"ሾሻ ማርዜራ ዴስ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኢስታ ዶናን ቃንጌኔ","poem":1},{"text":"ጫሞ ሚሺ ኩሚዴስ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኢስታ ቶሆይ","poem":1},{"text":"ሱ ጉሳናስ ኤሶቴስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኢስታ ኦጌን ዮይኔ","poem":1},{"text":"ላፋቴ ዴስ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ኢስቲ ሳሮቴ ኦጌ ኤሬቴና።","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ኢስታ ኣይፌሶን ጾሳስ ያሻቴ ባ»","poem":1},"ጌቴቲ ጻፌቲዳ ማላ።"]},{"type":"verse","number":19,"content":["ሄሳ ጊሻስ ዶናይ ዉሪካ ጎርዴታና ማላ ዴሬይ ኩሜ ጾሳስ ዛሮ ኢማና ማላ ዎጋይ ጊዛይ ዉሪካ ዎጋፔ ጊዶራ ዲዛይታስ ጊዲዳይሳ ኑ ኤሮስ።"]},{"type":"verse","number":20,"content":["ሄሳ ጊሻስ ዎጋይ ናጋራይ ኣዛኮ ኤሪሴስ ኣቲን ዎጋ ናጎን ኦኒካ ኢዛ ኣቻን ጺሎ ጌቴታናስ ዳንዳዬና።"]},{"type":"heading","content":["ኣማኖን ቤቲዛ ጺሎቴ"]},{"type":"verse","number":21,"content":["ሃኢ ቃሴ ካሴ ናቤቲ ኢዛስ ማርካቲዳይሲ ዎጋፔ ካሬራ ጊዲዳ ጾሳ ጺሎቴ ቆንጪዴስ።"]},{"type":"verse","number":22,"content":["ሄሲ ጾሳ ጺሎቴ ዬሱስ ኪርስቶሳ ኣማኖን ዱማቴ ባይንዳ ቤቲዛ ጺሎቴ።"]},{"type":"verse","number":23,"content":["ጋሶይካ ኣሲ ዉሪካ ናጋራ ኦዴስ፤ ጾሳ ቦንቾይካ ኣሳ ናስ ፓጪዴስ።"]},{"type":"verse","number":24,"content":["ኣሳይ ዬሱስ ኪርስቶሲ ኣሳ ና ጊሻስ ኦዳ ኪያቴፌ ዴንዲዳይሳን ጮ ሜላ ጺሊዴስ።"]},{"type":"verse","number":25,"content":["ኢዛ ሱን ጊዲዳ ኣማኖን ናጋራፔ ማሬታና ያርሾ ሂስቲዲ ጾሲ ዬሱሳ ሺሺዴስ፤ ኢዚ ሄሳ ኦዳይ ካሴቲዲ ፖሌቲዳ ናጋራ ቃጻዮንታ ዳንዳያን ኣዳ ባ ጺሎቴ ቤሳናሳ።"]},{"type":"verse","number":26,"content":["ኢዚ ሄሳ ሃ ዎዴዛን ኦዳይ ባ ጺሎቴ፤ ሄሲካ ባ ባጋራ ጺሎ ጊዲዳ ዬሱስ ኪርስቶሳን ኣማኒዛዴ ጺሊሲዛይሳ ቤሳናሳ።"]},{"type":"verse","number":27,"content":["ሂስቲን ኑኒ ኢዛን ጬቄቲዛ ሚሺ ኣዚ ዲዜ? ኣይኮ ሚሻንካ ጬቄቶኮ፤ ኑ ጬቄታና ጋሶይካ ኣዜ? ዎጋ ናጊዛ ጊሼ? ጊዴና፤ ኣማኖና።"]},{"type":"verse","number":28,"content":["ኣይ ኣሲካ ኣማኖን ኣቲን ዎጋ ናጎን ኣቶንታይሳ ኑ ጌሺ ዮቶስ።"]},{"type":"verse","number":29,"content":["ጾሲ ኣይሁዳታስ ጻላ? ኣይዛቤታስካ ጾስ ጊዴኔ? ኤ ኣይዛቤታስካ ኢዚ ጾሳ።"]},{"type":"verse","number":30,"content":["ቃጻሬቲዳይሳ ኣማኖን ቃሴ ቃጻሬቶንታይሳካ ሄ ኣማኖንካ ጺሊሲዛይካ ኢዚ ኢሲ ጾሳ ጻላ።"]},{"type":"verse","number":31,"content":["ሂስቲን ሄሲ ሄሳ ጊዲኮ ኣማኖ ጋሶን ዎጋ ጎኣይ ባይንዳ ሚሽ ኦኖ? ሙሌካ ሄሳ ሃኔና፤ ዎጋ ኑ ሚንና ኣቲን።"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/ROM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/ROM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/ROM/2.json","previousChapterAudioLinks":{},"numberOfVerses":31}