{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"SNG","translationId":"gmv_etw","name":"ሲቆ ሳባ","commonName":"ሲቆ ሳባ","title":"ሲቆ ሳባ","order":22,"numberOfChapters":8,"sha256":"ae219cb167295eee62be6742c4b2b436ad35d884672eb4ed0962bff9b0744103","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gmv_etw/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["ማዛሙሬ ኡባፌ ኣዛ ሶሎሞኔ ማዛሙሬ።"]},{"type":"verse","number":2,"content":[{"text":"«ኔ ሲቆይ ዎይኔ ኡሻፌ","poem":1},{"text":"ኣ ኡፋይሴስ፤","poem":2},{"lineBreak":true},{"text":"ኔ ሜቴርሻን ዛራ ዛራዳካ","poem":2},{"lineBreak":true},{"text":"ታና ዬራ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኔ ቲዬቲዛ ሺቶይ","poem":1},{"text":"ኣይ ማላ ሳዊዜ!","poem":2},{"lineBreak":true},{"text":"ኔ ሱንይ ጼይጌቲዛ ዎዴካ","poem":2},{"lineBreak":true},{"text":"ኣይ ማላ ኡፋይሲዜ!","poem":2},{"lineBreak":true},{"text":"ጌላኦቲ ኔና","poem":2},{"lineBreak":true},{"text":"ሄሳ ጊሻስ ሲቄቴስ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታና ኔናራ ኤካዳ ባ፤","poem":1},{"text":"ሃ ያ፥ ኣኔ ናምኣይ ኢሲፌ ዎጾስ!","poem":2},{"lineBreak":true},{"text":"ታ ካዎ፥ ታና ኔ ቁሩጾ","poem":2},{"text":"ጊዶ ጌል» ጋዱስ።","poem":3},"ላጌቲ",{"text":"«ኢዛን ኑኒ ኣይ ኬና","poem":2},{"lineBreak":true},{"text":"ኡፋዬቲዶኒ!","poem":2},{"lineBreak":true},{"text":"ኑኒ ኢዛ ሲቆ","poem":2},{"lineBreak":true},{"text":"ዎይኔ ኡሻፌካ","poem":2},{"lineBreak":true},{"text":"ኣዲ ናሾስ።","poem":2},{"lineBreak":true},{"text":"ቱሙካ ማጫሳይ ኡባይ ኔና","poem":2},{"text":"ሲቃናስ ቤሴስ» ጊዳ።","poem":3}]},{"type":"verse","number":5,"content":[{"text":"«ኢንቴኖ ዬሩሳላሜ","poem":1},{"text":"ማጫሳቶ፥ ሲዪቴ!","poem":2},{"lineBreak":true},{"text":"ታኒ ካሬ ጊዲኮካ ማላ ሎኦ።","poem":2},{"lineBreak":true},{"text":"ታ ካሬቴይ","poem":2},{"lineBreak":true},{"text":"ቄዳሬ ዱንካኔ ማላ፤","poem":2},{"text":"ጊዶ ኣቲን ታ ሜይ","poem":3},{"lineBreak":true},{"text":"ካዎ ሶሎሞኔ ኬ","poem":3},{"lineBreak":true},{"text":"ማጋላሻታ ማላ።","poem":3}]},{"type":"verse","number":6,"content":[{"text":"ታ ሜ ካሬዳይ ኣዋ ሴላ፤","poem":1},{"text":"ታኒ ካሬ ጊዲዳ ጊሻስ","poem":2},{"text":"ታና ካፒቴ።","poem":3},{"text":"ታ ኣዪ ና ኢሻቲ","poem":2},{"text":"ታናራ ኦዬቲዲ","poem":3},{"text":"ታና ዎይኔ ኣታኪልቴ","poem":2},{"lineBreak":true},{"text":"ናጋናስ ዎዳ፤","poem":2},{"lineBreak":true},{"text":"ሄሳ ጊሻስ ታኒ ታይሳ","poem":2},{"lineBreak":true},{"text":"ናጋቤኬ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታ ሲቆዞ! ኣኔ ታስ ዮታ፤","poem":1},{"text":"ኔ ዶርሳ ዉዴ ሄሚዛይ ኣዋኔ?","poem":2},{"lineBreak":true},{"text":"ጋላስ ኣዋፔ ኔ ኢስታ","poem":2},{"text":"ጉሪሲዛይ ኣዋኔ?","poem":3},{"lineBreak":true},{"text":"ኔና ዴማናስ","poem":3},{"lineBreak":true},{"text":"ኔ ላጌታ ዉዴ ካላሼ","poem":3},{"lineBreak":true},{"text":"ኣይስ ጮ ቶይላቲዛ","poem":3},{"lineBreak":true},{"text":"ማጫሳ ማላ ጊዶ?» ጋዱስ።","poem":3}]},{"type":"verse","number":8,"content":[{"text":"«ሃ ማጫ ኡባፌ ኣ","poem":1},{"text":"ሎኢዛ ማላንቻዬ!","poem":2},{"lineBreak":true},{"text":"ታ ዲዛሶ ኤሮንታ ኣጊኮ","poem":2},{"text":"ዶርሳቲ ቢዳ ጌዶ ካላዳ ያ፤","poem":3},{"text":"ኔ ዴይሻ ላቃታካ","poem":2},{"text":"ሄንንቻታ ዱንካኔ","poem":3},{"lineBreak":true},{"text":"ማታን ሄማ።»","poem":3}]},{"type":"verse","number":9,"content":[{"text":"«ታ ጎዴ! ጊብጼ ካዎስ","poem":1},{"text":"ፓራ-ጋሬ ጎቺዛ","poem":2},{"lineBreak":true},{"text":"ፓራታ ጊዶን ዲዛ","poem":2},{"text":"ማጫ ፓራይ ማላ ሎኣሳ።","poem":3}]},{"type":"verse","number":10,"content":[{"text":"ኔ ሻጋላሶይ ሎዡ ጊዴስ፤","poem":1},{"text":"ኔ ቆይ ኢንቁ ጌቴቲዛ","poem":2},{"text":"ሴሎን ኣሌቄቲዴስ።","poem":3}]},{"type":"verse","number":11,"content":[{"text":"ኑኒ ኔስ ቢራን ኣሌቄቲዳ","poem":1},{"text":"ዎርቃ ጌጼ ኦሲሳና» ጊዴስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"«ካዎይ ማዳን ኡቲ ዲሺን","poem":1},{"text":"ታ ሺቶ ሳዎይ ኬ ጊዶ","poem":2},{"text":"ኡባን ቱኑ ጊዴስ።","poem":3}]},{"type":"verse","number":13,"content":[{"text":"ታ ሲቆዚ ታ ንታ","poem":1},{"text":"ጊዶን ዲዛ","poem":2},{"lineBreak":true},{"text":"ሳዊዛ ካርቤ ጹንቴ ማላ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ታ ሲቆዚ ኤን-ጋዴ ጌቴቲዛ","poem":1},{"text":"ዎይኔ ቶኪዛ ጋዴን ሞኪዳ","poem":2},{"text":"ባዞ ጪሻ ማላ» ጋዱስ።","poem":3}]},{"type":"verse","number":15,"content":[{"text":"«ታ ጎዴ! ኔኒ ኣይ ማላ ሎኣይ!","poem":1},{"text":"ኔኒ ኣይ ማላ ሎኣይ!","poem":2},{"lineBreak":true},{"text":"ኔ ኣይፌቲ ሃራጴ ማላ","poem":2},{"text":"ሎኤቴስ» ጊዴስ።","poem":3}]},{"type":"verse","number":16,"content":[{"text":"«ታ ሲቆዞ፥","poem":1},{"text":"ኔኒካ ኣይ ማላ ሎኣይ!","poem":2},{"lineBreak":true},{"text":"ኔ ኬሃ ሎኣሳ፤","poem":2},{"lineBreak":true},{"text":"ኑ ሂይ ጪሊላ ማታ ማላ","poem":2},{"lineBreak":true},{"text":"ኡፋይሴስ» ጋዱስ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"«ኑ ኬ ቱሲ","poem":1},{"text":"ሊባኖሴ ዚጋ፤","poem":2},{"lineBreak":true},{"text":"ካራይካ","poem":2},{"lineBreak":true},{"text":"ጺዳን ኦሴቲዴስ» ጊዴስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}