":2},{"lineBreak":true},{"text":"ሚዚዲ ጋዚዲሲቴ፤","poem":2},{"lineBreak":true},{"text":"ኣፒሌ ሚዚዲ ታና ቤጎቴ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ባ ሃዲርሳ ኩሼ ቦላ","poem":1},{"text":"ታና ቦርኮቲሲዴስ፤","poem":2},{"lineBreak":true},{"text":"ባ ኡሻቻ ኩሼን","poem":2},{"lineBreak":true},{"text":"ታና ኢዲሚዴስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኢንቴኖ ዬሩሳላሜ","poem":1},{"text":"ዬላጋ ማጫሳቶ!","poem":2},{"lineBreak":true},{"text":"ሲቆይ ባስ ዶሲዲ","poem":2},{"lineBreak":true},{"text":"ዴንዳና ጋካናስ","poem":2},{"text":"ኢዛ ኢንቴ ቤጎንታ ማላ፥","poem":3},{"lineBreak":true},{"text":"ታኒ ኢንቴና ጌኔሳታኒኔ","poem":3},{"lineBreak":true},{"text":"ባዞ ዉሻን ኣማታይስ።","poem":3}]},{"type":"verse","number":8,"content":[{"text":"ቤኢቴ! ታ ሲቆዛ ጬንጉርሲ","poem":1},{"text":"ዙማታ ቦላራ ፒሪሼ፥","poem":2},{"lineBreak":true},{"text":"ዙምቡላታ ቦላራ ጾንጌቲሼ","poem":2},{"text":"ዪዛይሲ ሲዬቴስ።","poem":3}]},{"type":"verse","number":9,"content":[{"text":"ታ ሲቆዚ ዉሻ ላቃ","poem":1},{"text":"ዎይኮ ጌኔሳ","poem":2},{"lineBreak":true},{"text":"ላቃ ሚሳቴስ።","poem":2},{"text":"ቤኢቴ! ኢዚ ኑ ኬ","poem":3},{"lineBreak":true},{"text":"ዳራንቻን ኤቂዴስ፤","poem":3},{"lineBreak":true},{"text":"ማስኮቴራ ሶ ጼሌስ፤","poem":3},{"text":"ማጋላሻ ጾኤራ","poem":2},{"lineBreak":true},{"text":"ጹሉንጊ ጼሌስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታ ሲቆዚ ታና፥","poem":1},{"text":"‹ታ ጎዴ፥ ዴንዳ!","poem":2},{"lineBreak":true},{"text":"ታ ሎኦዬ! ሃ ያ!","poem":2},{"lineBreak":true},{"text":"ኣኔ ኢሲፌ ቦስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ቤያ፥ ባልጎይ ኣዴስ፤","poem":1},{"text":"ኢራይካ ኣጊዴስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኡባሶን ጪሺ ጪዪዴስ፤","poem":1},{"text":"ማዛሙሬ ዬጺዛ","poem":2},{"lineBreak":true},{"text":"ኣጊናይካ ጋኪዴስ፤","poem":2},{"lineBreak":true},{"text":"ሃራጴ ዬካ","poem":2},{"lineBreak":true},{"text":"ኑ ቢታን ሲዬቴስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ባላሴይ ኣይፌ ኢሞ ዶሚዴስ፤","poem":1},{"text":"ዎይኔይ ጪዪዴስ፤","poem":2},{"lineBreak":true},{"text":"ኢዛ ጪሻ ሳዎይ","poem":2},{"text":"ኡባሶን ቱኑ ጌስ።","poem":3},{"text":"ሄሳ ጊሻስ ታ ጎዴ፥ ዴንዳ፤","