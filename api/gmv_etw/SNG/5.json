3,"content":[{"text":"ታኒ ታ ማይኦ ኬሳዲስ፤","poem":1},{"text":"ሂስቲን ዛራ ማይኦ?","poem":2},{"lineBreak":true},{"text":"ታ ቶሆካ ሜጬታዲስ፤","poem":2},{"lineBreak":true},{"text":"ቃሴ ዛራዳ ኡርቃሶ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታ ሲቆዚ ፔንጌ ጾኤራ","poem":1},{"text":"ኩሼ ዬዲዴስ፤","poem":2},{"lineBreak":true},{"text":"ሂስቲን ታስ ማራጬን","poem":2},{"text":"ፖልኡ ጊዴስ።","poem":3}]},{"type":"verse","number":5,"content":[{"text":"ሄሳፌ ጉዬ ታ ሲቆዛስ","poem":1},{"text":"ካሬ ዶያናስ ዴንዳዲስ፤","poem":3},{"text":"ካሬዛ ዶያና ታ ኦይኪሺን","poem":2},{"text":"ታ ኩሼፔ ካርቤይ ጾኬቲዴስ፤","poem":3},{"lineBreak":true},{"text":"ታ ቢራታፔካ","poem":3},{"lineBreak":true},{"text":"ሺቶይ ጎጊዴስ።","poem":3}]},{"type":"verse","number":6,"content":[{"text":"ታ ካሬዛ ዶይሺን ታ ሲቆዚ","poem":1},{"text":"ሲሚዲ ቢቺዴስ፤","poem":2},{"lineBreak":true},{"text":"ኢዛ ቃላ ጬንጉርሳ ሲያናስ","poem":2},{"text":"ኬሃ ኣሞታዲስ።","poem":3},{"text":"ሚንዳካ ኮያዲስ፤","poem":2},{"text":"ጊዶ ኣቲን ዴማናስ","poem":3},{"lineBreak":true},{"text":"ዳንዳያቤኬ፤","poem":3},{"text":"ጼይጋዲስ ሺን","poem":2},{"text":"ኢዚ ታስ ኮዪቤና።","poem":3}]},{"type":"verse","number":7,"content":[{"text":"ካታማ ናጊዛይቲ ታና ዴሚ","poem":1},{"text":"ዋዲ ማዱንዳ፤","poem":2},{"text":"ካታማ ጊምቤ ናጊዛይቲ","poem":3},{"lineBreak":true},{"text":"ታ ማይኢዳ ሴሎ ማይኦዛ","poem":3},{"lineBreak":true},{"text":"ቃሪ ኤኪዳ።","poem":3}]},{"type":"verse","number":8,"content":[{"text":"ኢንቴኖ ዬሩሳላሜ ጌላኦቶ!","poem":1},{"text":"ኢንቴ ታ ሲቆዛ","poem":2},{"lineBreak":true},{"text":"ዴሚዳ ጊዲኮ","poem":2},{"text":"ታኒ ኢዛ ሲቆፔ ዴንዲዳይሳን","poem":3},{"lineBreak":true},{"text":"ሃርጊዳይሳ ሃዳራ","poem":3},{"lineBreak":true},{"text":"ኢዛስ ዮቲቴ» ጋዱስ።","poem":3}]},{"type":"verse","number":9,"content":[{"text":"«ሃኔ ማጫሳ","poem":1},{"text":"ኡባፌ ኣ ሎኦዬ!","poem":2},{"lineBreak":true},{"text":"ቱሙ ኔ ሲቆ ላጌዚ","poem":2},{"lineBreak":true},{"text":"ሃራታፔ ዱማቲዜ?","poem":2},{"lineBreak":true},{"text":"ኔኒ ሃይሳ ማላ","poem":2},{"lineBreak":true},{"text":"ኑና ሃዳራ ጊዛይ","poem":2},{"lineBreak":true},{"text":"ኢዚ ሃራታፔ ዋኒኔ?» ጊዳ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"«ታ ሲቆይ ዳሮ ሎኦኔ ሚኖ፤","poem":1},{"text":"10,0