{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"ZEC","translationId":"gmv_etw","name":"ዛካራሳ ቲንቢቴ","commonName":"ዛካራሳ ቲንቢቴ","title":"ዛካራሳ ቲንቢቴ","order":38,"numberOfChapters":14,"sha256":"9ba3a168723b145294676f4f7378ac90c18d4b5bc2f38e29dc944b18748bc8dd","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gmv_etw/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":11,"content":[{"type":"heading","content":["ፒርዳ ሌሚሶ"]},{"type":"verse","number":1,"content":[{"text":"ሊባኖሴ ኔናን ዲዛ","poem":1},{"text":"ዚጋ ሚ","poem":2},{"lineBreak":true},{"text":"ታማይ ማና ማላ","poem":2},{"lineBreak":true},{"text":"ኔ ፔንጌታ ዶያ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ጺዳቶ! ዚጋ ሚይ","poem":1},{"text":"ኩንዲዳ ጊሻስ ዬኪቴ፤","poem":2},{"lineBreak":true},{"text":"ቦንቼቲዳ ሚቲ ይዳ፤","poem":2},{"lineBreak":true},{"text":"ባሳኔ ዎላቲ «ዉ! ዉይ»","poem":2},{"text":"ጊ ዋሲቴ፤","poem":3},{"text":"ፒ ጊዳ ዎራይ ቄጼቲዴስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሄን ናይታ ዋሶ ሲዪቴ፤","poem":1},{"text":"ኢስታ ቦንቾይ ቃሬቲዴስ፤","poem":2},{"lineBreak":true},{"text":"ዮርዳኖሴ ሻፋ ዶናን ዲዛ","poem":2},{"text":"ፒ ጊዳ ዎራይ","poem":3},{"text":"ዉሪዳ ጊሻስ","poem":2},{"text":"ጋሞታ ጻጎ ሲዪቴ።","poem":3}]},{"type":"heading","content":["ናምኡ ቆሞ ሄንንቻታ"]},{"type":"verse","number":4,"content":["ጎዳ ታ ጾሳይ ኔና፥ «ሹኬታናስ ዶሬቲዳ ዶርሳታ ካ።"]},{"type":"verse","number":5,"content":["ኢስታ ሻሚ ሹኪዳይቲ ቃጻዬቴቴና፤ ኢስታ ባይዚዳይቲ፥ ‹ጎዳይ ጋላቴቶ፤ ኑ ዱሬቲዶስ› ጌቴስ። ኢስታ ሄሚዛይቲካ ኢስታስ ቃቴቴና።"]},{"type":"verse","number":6,"content":["«ሃይሳፌ ጉዬ ሃ ቢታይ ቦላ ዲዛ ኣሳስ ታ ቃቲኬ፤ ታኒ ታ ባጋራ ኢሳ ኢሳ ኢዛ ላጌሲኔ ኢዛ ካዎስ ኣ ኢማና፤ ኢስቲካ ቢታ ኡንኤና፤ ታኒካ ኢስታ ኢስታ ኩሼፔ ኣሺኬ» ጌስ።"]},{"type":"verse","number":7,"content":["ሄሳ ጊሻስ ታኒ ባይዚዛይታሲኔ ሻሚዛይታስ ቃጻሬታ ሹኬታናስ ዶሬቲዳ ዶርሳታ ሄሚዛዴ ጊዳዲስ፤ ዶርሳታካ ሄማሼ ናምኡ ጉፌታ ኤካዳ ኢሳ፥ «ኪያቴ» ናምኣንዛ፥ «ኢሲፌቴ» ጋ ሱንዲስ።"]},{"type":"verse","number":8,"content":["ኢሲ ኣጊና ጊዶን ሜሄ ሄሚዛ ሄታ ዲጋዲስ፤ ኢስቲካ ታና ኢጺዳ ጊሻስ ታኒካ ኢስታ ሳሌታዲስ።"]},{"type":"verse","number":9,"content":["ታኒ ኢስታስ፥ «ሃይሳፌ ጉዬ ታኒ ኢንቴና ሄሚኬ፤ ሃይቃናይቲ ሃይቄቶ፤ ያናይቲካ ዬቶ፤ ኣቲዳይቲካ ኢሶይ ኢሳ ኣሾ ሞ» ጋዲስ።"]},{"type":"verse","number":10,"content":["ቃሴካ ዴሬ ኡባራ ታ ጫቄቲዳ ቃላ ላላናስ፥ «ኪያቴ» ጋዳ ሱንዳ ታ ጉፌዛ ሜንዲስ።"]},{"type":"verse","number":11,"content":["ሄ ጋላስ ካሴ ጫቆዚ ላሌቲዴስ፤ ኡንኤቲ ኡቲዲ ታና ጼሊዛ ዶርሳቲ ሄሲ ጎዳ ቃላ ጊዲዳይሳ ኤሪዳ።"]},{"type":"verse","number":12,"content":["ታኒካ ኢስታስ፥ «ኢንቴስ ሎኦ ሚሳቲኮ ታ ዋጋ ታስ ቃንጺቴ፤ ኣካይ ጊኮ ኣጋጊቴ» ጋዲስ፤ ሄሳ ጊሻስ ኢስቲ ታስ ሄ ታሙ ሳቂሌ ቢራ ቃንጺዳ።"]},{"type":"verse","number":13,"content":["ጎዳይካ ኢስቲ ታስ ኢማና ጊጊዳ ካቲዳ ቢራ ኤካዳ፥ «ሚንጃ ኬን ዎ!» ጊዴስ። ታኒካ ሄ ሄ ታሙ ሳቂሌ ቢራ ኤካዳ ጎዳ ኬ ጊዶን ሚንጃሶን ዎዲስ።"]},{"type":"verse","number":14,"content":["ሄሳፌ ቃሴ ኢስራኤሌኔ ዩሁዳ ኢሻቴ ላላዳ፥ «ኢሲፌቴ» ጋዳ ታ ሱንዳ ናምኣን ጉፌዛካ ሜንዲስ።"]},{"type":"verse","number":15,"content":["ቃሴካ ጎዳይ ታና፥ «ኣዛላ ሄንንቻቲ ኦይኪዛ ሚሽ ኢስታፌ ዎ ኤካ።"]},{"type":"verse","number":16,"content":["ሄኮ ታኒ ቢታ ቦላ ኦራ ሄንንቻ ዴንና፤ ሄ ሄንንቻይ ካሴ ይዳይሳ ዛሪ ቆፔና፤ ላሌቲዳይሳካ ኮዬና፤ ሜቂዳይሳካ ኮሌና፤ ፓጺዳይሳካ ኬና፤ ጊዶ ኣቲን ሞዳይሳ ኣሾ ማና፤ ቂንጪፊሌካ ኣሾንታ ዲፒ ሂስታና።"]},{"type":"verse","number":17,"content":["ዉዴዛ ዬጊ ኣጊዛ ጎኣይ ባይንዳ ሄንንቻስ ኣዬ ኣና!",{"text":"«ኢዛ ኡሻቻ ኣይፌኔ","poem":1},{"text":"ኢዛ ቄሴ ማሻይ ጫዶ፤","poem":2},{"lineBreak":true},{"text":"ኢዛ ቄሴይ ሲሎ፤","poem":2},{"lineBreak":true},{"text":"ኢዛ ኡሻቻ ኣይፌይካ","poem":2},{"text":"ቂልች ጊ ቆቆ» ጊዴስ።","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/ZEC/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/ZEC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/ZEC/10.json","previousChapterAudioLinks":{},"numberOfVerses":17}