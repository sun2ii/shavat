{"translation":{"id":"gmv_etw","name":"ጌሻ ማጻፋ","website":"https://ebible.org/Scriptures/details.php?id=gmve","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmve","licenseNotes":null,"shortName":"ETW","englishName":"Gamo Bible","language":"gmv","textDirection":"ltr","sha256":"18c06e2c8ed296812be8d65e321f67ffd96f8a91c4218cc15d66f2f1cdcfe1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"ZEC","translationId":"gmv_etw","name":"ዛካራሳ ቲንቢቴ","commonName":"ዛካራሳ ቲንቢቴ","title":"ዛካራሳ ቲንቢቴ","order":38,"numberOfChapters":14,"sha256":"9ba3a168723b145294676f4f7378ac90c18d4b5bc2f38e29dc944b18748bc8dd","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_etw/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gmv_etw/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":13,"content":[{"type":"heading","content":["ናጋራፔ ጌማዛሙሬ"]},{"type":"verse","number":1,"content":["ኡባፌ ዎልቃማ ጎዳይ፥ «ሄ ጋላስ ዳዊቴ ኬ ኣሳኔ ዬሩሳላሜን ዲዛ ኣሳ ናጋራፔኔ ቱናቴፌ ጌሻናስ ፑልቶይ ፑልታና።"]},{"type":"verse","number":2,"content":["«ታኒ ሄ ዎዴ ቢታፌ ኤቃ ጾሳታ ሱን ይሳና፤ ሄሳፌ ናምኣን ኢስቲ ቆፌቴቴና፤ ኢስታ ናቤታኔ ቱና ኣያናታ ቢታይ ቦላፌ ታ ዲጋና።"]},{"type":"verse","number":3,"content":["ኦኒካ ታኒ ናቤ ጊኮ ኢዛዴ ዬሊዳ ኣዋይኔ ኣዬያ ኢዛ ኔ ጎዳ ሱንን ዎርዶ ሃሳይዳ ጊሻስ ኔስ ሃይቆይ ቤሴስ ጌቶ፤ ኢዚ ቲንቢቴ ሃሳይሺን ኢዛ ዬሊዳይቲ ኢዛ ጫዴቶ።"]},{"type":"verse","number":4,"content":["ሄ ዎዴ ዎርዶ ሃሳይዳዴይ ኦኒካ ባ ሃሳይዳ ዎርዶ ቲንቢቴን ዬላታና፤ ባሌናስ ኢስኬራ ዲዛ ናቤታ ማይኦ ማይኤና።"]},{"type":"verse","number":5,"content":["ኢዚካ፥ ‹ታ ጎሻ ኣሳ ኣቲን ናቤ ጊዲኬ፤ ታ ናቴቴፌ ዶማዳ ሃኖ ጋካናስ ጎሻንቻ› ጋና።"]},{"type":"verse","number":6,"content":["ኢሲ ኣሲ፥ ‹ሄሲ ኔ ቦላ ኣይ ማዱን?› ጊ ኦይቺኮ ኢዚ፥ ‹ታ ሃይሳ ታ ላጌታሶን ዳሼ ማዱንጻዲስ› ጊዴስ።"]},{"type":"heading","content":["ሄንንቻይ ሾጬቲን ኢዛ ዶርሳታ ላሌቴ"]},{"type":"verse","number":7,"content":["«ኡባፌ ዎልቃማ ጎዳይ፥",{"text":"‹ማሻ! ታ ሄንንቻ","poem":2},{"text":"ታ ዳሮ ዶሲዛይሳ ቦላ ቤጋ!","poem":3},{"text":"ሄሚዛይሳ ሾጫ፤","poem":2},{"lineBreak":true},{"text":"ዶርሳቲካ ላሌታና፤","poem":2},{"lineBreak":true},{"text":"ታኒካ ታ ቄሴ ጉታ ቦላ","poem":2},{"text":"ዴንና› » ጌስ።","poem":3}]},{"type":"verse","number":8,"content":["ጎዳይ፥ «ቢታ ኡባን ዲዛ",{"text":"ሄ ኩሼ ኣሳፔ","poem":2},{"lineBreak":true},{"text":"ናምኡ ኩሼይ ያና፤","poem":2},{"lineBreak":true},{"text":"ኢሲ ኩሼ ኣሲ ኣታና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሄ ኣቲዳ ኢሲ ኩሼ ኣሳ","poem":1},{"text":"ታ ጌዴ ታማን ዬጋና፤","poem":2},{"lineBreak":true},{"text":"ቢራ ታማን ጌሺዛ ማላ","poem":2},{"lineBreak":true},{"text":"ታ ጌሻና፤","poem":2},{"lineBreak":true},{"text":"ዎርቃ ማላካ ፓጫና፤","poem":2},{"lineBreak":true},{"text":"ኢስቲ ታ ሱን ጼይጋና፤","poem":2},{"lineBreak":true},{"text":"ታኒካ ኢስታስ ኮያና፤","poem":2},{"lineBreak":true},{"text":"ታ ኢስታስ፥ ‹ታ ዴሬታ› ጋና፤","poem":2},{"lineBreak":true},{"text":"ኢስቲካ፥ ‹ኑ ጎዳ›","poem":2},{"lineBreak":true},{"text":"ጋና» ጊዴስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_etw/ZEC/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_etw/ZEC/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_etw/ZEC/12.json","previousChapterAudioLinks":{},"numberOfVerses":9}