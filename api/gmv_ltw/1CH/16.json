{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"1CH","translationId":"gmv_ltw","name":"1Taarike Maxaafa","commonName":"1Taarike Maxaafa","title":"1Taarike Maxaafa","order":13,"numberOfChapters":29,"sha256":"d3263de5e023e124923b661041016e3d3b70e7f291289d68ff9eabae20a902a5","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/gmv_ltw/1CH/29.json","totalNumberOfVerses":939},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":["Istti Xoossa Taabotaa ehidi Dawiti Taabotaa woththanaas tolida dunkaaneza giddon woththida; histtidi xuugettiza yarshonne issifeteththa yarsho Xoossas yarshida."]},{"type":"verse","number":2,"content":["Dawiti xuugettiza yarshozanne issifeteththa yarsho yarshidaappe guye GODAA sunththan dereza anjjides."]},{"type":"verse","number":3,"content":["Hessafe guye Isra7eele asa ubbaas, maccassaassinne attumasaas, hu7en hu7en issi issi guuththa uketh, issi issi qanxxo ashonne issi issi zabibe kompa",{"noteId":5},"gishides."]},{"type":"verse","number":4,"content":["GODAA Taabotaa sinththan ooththana malanne GODAA Isra7eele Xoossa woossanaas, sabbanaassinne galatanaas Dawiti Lewe qommotappe guuththata sunththides."]},{"type":"verse","number":5,"content":["Leweta halaqay Aasaafe; izappe garsara Zakaraasa; Zakaraasara dizayti Yi7i7eele, Shamiramoote, Yihi7eele, Matitiya, Elyaabe, Bannayanne Obeed-Eedoomenne Yi7i7eele; heyti maasinqonne diith diixxana mala summida; Asaafi gidikko daala qaaththanaas summides.",{"noteId":6}]},{"type":"verse","number":6,"content":["Qeese Bannayaynne Yahazi7eeley Xoossaa Taabotaa sinththan ubba wode zaye punnana mala summida."]},{"type":"heading","content":["Galata Yeththa"]},{"type":"verse","number":7,"content":["He gallas Dawiti kasetidi Aasaafessinne izara ooththiza laggetas GODAA galatiza mazamure immides."]},{"type":"verse","number":8,"content":[{"text":"GODAA galatite;","poem":1},{"text":"iza sunththaa xeygite;","poem":2},{"lineBreak":true},{"text":"izi ooththida ubbaa","poem":2},{"lineBreak":true},{"text":"kawoteththatas yootite.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iza sabbite;","poem":1},{"text":"galata mazamurekka izas yexxite;","poem":2},{"lineBreak":true},{"text":"izi ooththida malalisiza ooso","poem":2},{"lineBreak":true},{"text":"ubbaa yootite.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iza geeshsha sunththaan","poem":1},{"text":"bonchchite;","poem":2},{"lineBreak":true},{"text":"GODAA koyzayta","poem":2},{"lineBreak":true},{"text":"wozinay ufayetto.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"GODAANNE iza wolqqa xomosite;","poem":1},{"text":"ubba wode iza koyite.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Izi ooththida malalisiza oosota,","poem":1},{"text":"malaatatanne iza pirdaa akeekite.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Intteno Xoossa aylle","poem":1},{"text":"Isra7eele zereththatoo!","poem":2},{"lineBreak":true},{"text":"Intteno doorettida","poem":2},{"lineBreak":true},{"text":"Yaaqoobe naytoo!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Izi GODAY nu Xoossa;","poem":1},{"text":"iza pirday ubbaa bollanna.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ba caaqqida qaalaa mernaas,","poem":1},{"text":"ba azazidayssaka shii yeleta","poem":2},{"lineBreak":true},{"text":"gakkanaas qoppees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Abrahaames caaqqida caaqaa,","poem":1},{"text":"Yisaaqas immida hidota qaalaa,","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yaaqoobes woga gidana mala,","poem":2},{"lineBreak":true},{"text":"Isra7eelesikka mernaa caaqo","poem":2},{"lineBreak":true},{"text":"qaala gidana mala minththides.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"«Kanaaney nees","poem":1},{"text":"xinxxo gidana mala","poem":2},{"lineBreak":true},{"text":"ta nena laatissana» gides.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Istti qoodan guuth gidi diza wode,","poem":1},{"text":"deraasikka imath gidi diza wode,","poem":2}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"issi dereppe hara dere,","poem":2},{"lineBreak":true},{"text":"issi kawoteththafe","poem":2},{"lineBreak":true},{"text":"hara kawoteth toylattida.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Oonikka istta un7eththana mala","poem":1},{"text":"aaththi immibeenna;","poem":2},{"lineBreak":true},{"text":"istta gishshas kawota seerides;","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"«Ta tiydayta bochchofte;","poem":2},{"lineBreak":true},{"text":"ta nabeta qohopite» gides.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Biitta ubbay GODAAS yexxite;","poem":1},{"text":"izi ashshizayssa","poem":2},{"lineBreak":true},{"text":"hach hach yootite.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kawoteththatas","poem":1},{"text":"iza bonchcho awajjite;","poem":2},{"lineBreak":true},{"text":"izi ooththida malalisiza","poem":2},{"lineBreak":true},{"text":"miishshata dere","poem":2},{"lineBreak":true},{"text":"ubbaas yootite.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"GODAY gita;","poem":1},{"text":"izas bessiza galataykka dhoqqa;","poem":2},{"lineBreak":true},{"text":"xoossata ubbaafe aadhdhees;","poem":2},{"lineBreak":true},{"text":"izas yayyanaas bessees.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ayzaabeta xoossati","poem":1},{"text":"ubbay eeqa xoossata;","poem":2},{"lineBreak":true},{"text":"GODAY gidikko","poem":2},{"lineBreak":true},{"text":"salota medhdhida Xoossa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bonchchoynne teemay izas dees;","poem":1},{"text":"minoteththinne ufayssi","poem":2},{"lineBreak":true},{"text":"iza Keeththan dees.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Intteno asa zare ubbatoo!","poem":1},{"text":"GODAA sabbite;","poem":2},{"lineBreak":true},{"text":"«Bonchchoynne wolqqay","poem":2},{"lineBreak":true},{"text":"GODAASSA» gi yootite.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"GODAA sunththaas bessiza","poem":1},{"text":"bonchcho immite;","poem":2},{"lineBreak":true},{"text":"yarsho ekkidi iza sinth shiiqite;","poem":2},{"lineBreak":true},{"text":"iza geeshshateththa bonchcho","poem":2},{"lineBreak":true},{"text":"gishshas GODAAS goynnite.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Biittan diza as ubbay","poem":1},{"text":"iza sinththan kokkorite;","poem":2},{"lineBreak":true},{"text":"Sa7ay minni eqqides;","poem":2},{"lineBreak":true},{"text":"mulekka qaaxxenna.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Saloti ufayetetto!","poem":1},{"text":"sa7aykka hashshu go!","poem":2},{"lineBreak":true},{"text":"Kawoteththata giddon isttas,","poem":2},{"lineBreak":true},{"text":"«GODAY kawotides!» getto.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Abbaynne iza giddon diza","poem":1},{"text":"ubbay guummetto;","poem":2},{"lineBreak":true},{"text":"dembatinne istta bolla diza","poem":2},{"lineBreak":true},{"text":"ubbati ufayetetto.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Izi biitta bolla pirdanaas yaana.","poem":1},{"text":"He wode wora miththati","poem":2},{"lineBreak":true},{"text":"Godaa Xoossaa","poem":2},{"lineBreak":true},{"text":"sinththan ufayssan yexxana.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"GODAY kiya;","poem":1},{"text":"iza maaroteththayka mernaassa;","poem":2},{"lineBreak":true},{"text":"hessa gishshas GODAA galatite.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"«Abeet nuna ashshiza GODAWU!","poem":1},{"text":"Nuna ashsha;","poem":2},{"lineBreak":true},{"text":"ne geeshsha sunththaa","poem":2},{"lineBreak":true},{"text":"nu galatana mala,","poem":2},{"lineBreak":true},{"text":"nu nena galatan","poem":2},{"lineBreak":true},{"text":"bonchchana mala","poem":2},{"lineBreak":true},{"text":"kawoteththata giddofe nuna","poem":2},{"lineBreak":true},{"text":"shiishshada ashsha» giite.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"GODAA Isra7eele Xoossay","poem":1},{"text":"mernaappe mernaa gakkanaas galatetto!","poem":2},"Hessafe guye dere ubbay, «Amiin» giidi GODAA galatides."]},{"type":"heading","content":["Yerusalaameninne Geba7oonen Hanida Goyno Maara"]},{"type":"verse","number":37,"content":["GODAA Taabotaa sinththan hach hach goynos koshshizaaz ubba wode istti ooththana mala Dawiti Aasaafenne iza dabbota woththides."]},{"type":"verse","number":38,"content":["Qasseka Obeed-Eedoomenne iza dabbota usuppun tammanne osppunata isttara ooththana mala woththides; Edotaane naa Obeed-Eedoomenne Hoosa dirsaa penge naagana mala woththides."]},{"type":"verse","number":39,"content":["Qeese Saadooqenne izara ooththiza qeeseti Geba7oonen dhoqqasohon diza GODAA Dunkaaneza sinththan ooththana mala heen woththides."]},{"type":"verse","number":40,"content":["Gaasoykka GODAY Isra7eeles immida wogaa mala istti ubba wode xuugettiza yarshoy yarshettizason maaladonne omars xuugettiza yarsho yarshanaassa."]},{"type":"verse","number":41,"content":["Iza maarotay mernaas gidida gishshas GODAA galatana mala Hemaane, Edotaanenne doorettida harata Dawiti isttara issife essides."]},{"type":"verse","number":42,"content":["Hemaanessinne Edotaanes xurumba punnanaas, daala giirissanaasinne mazamure yexxishe go7ettiza hara massarata bolla aawateththi isttas imettides; Edotaane nayti dirsa penge naagana mala alaafeteththi imettides."]},{"type":"verse","number":43,"content":["Hessafe guye ubba asay baso baso bides; Dawitikka baso asaa anjjanaas soo simmides."]}],"footnotes":[{"noteId":5,"caller":"+","text":"Kompa geetettizayssi issi issi bagga gamoththo qaalan dhebbo woykko lichchako geetettees.","reference":{"chapter":16,"verse":3}},{"noteId":6,"caller":"+","text":"Daala gizayssi xinaaxile gizayssa bessees.","reference":{"chapter":16,"verse":5}}]},"thisChapterLink":"/api/gmv_ltw/1CH/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/1CH/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/1CH/15.json","previousChapterAudioLinks":{},"numberOfVerses":43}