{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"1CH","translationId":"gmv_ltw","name":"1Taarike Maxaafa","commonName":"1Taarike Maxaafa","title":"1Taarike Maxaafa","order":13,"numberOfChapters":29,"sha256":"d3263de5e023e124923b661041016e3d3b70e7f291289d68ff9eabae20a902a5","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/gmv_ltw/1CH/29.json","totalNumberOfVerses":939},"chapter":{"number":24,"content":[{"type":"heading","content":["Qeeseta Ooso"]},{"type":"verse","number":1,"content":["Aaroone nayta cugay hayssafe kaallizayssa; Aaroone nayti Nadaabe, Abihu, El7ezeerenne Itamaare."]},{"type":"verse","number":2,"content":["Nadaabeynne Abihuy naa yelontta ba aawappe kaseti hayqqida; hessa gishshas El7ezeereynne Itamaarey qeese gidida."]},{"type":"verse","number":3,"content":["Dawiti El7ezeere zarkkefe Saadooqenne Itamaare zarkkefe Ahimelekera gididi Aaroone zareta istta ooson ooson maaddana mala shaakki woththides."]},{"type":"verse","number":4,"content":["El7ezeere zare halaqati Itamaare zare halaqatappe daro gidida gishshas El7ezeere zareti tammanne usuppun cugan shaakettiin, Itamaare zareti osppun cugan shaakettida."]},{"type":"verse","number":5,"content":["Xoossa Keeththaa kaaleththizaytinne Xoossa cimati El7ezeere zareta giddoninne Itamaare zareta giddon diza gishshas oonakka maaddontta oosoza saaman shaakkida."]},{"type":"verse","number":6,"content":["Lewe zare Natina7eele naa xaafezi Shama7ey kawoza sinththaninne iza shuumeta sinththan, qeese Saadooqe sinththaninne Abiyaataare naa Ahimeleke sinththan, qeeseta sinththaninne Lewetaso asaa halaqata sinththan istta sunththaa xaafides; histtiin El7ezeere keeththa asata halaqatappe issoynne Itamaare keeththa asata halaqatappe issoy bantta taran taran saama kessida."]},{"type":"verse","number":7,"content":["Ha asati saama kessiin",{"text":"koyro saamay Yoharibe gakkides;","poem":2},{"lineBreak":true},{"text":"nam7anththozi","poem":2},{"lineBreak":true},{"text":"Yaddaya gakkides;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Heedzdzanththozi","poem":1},{"text":"Harime gakkides;","poem":2},{"lineBreak":true},{"text":"Oydanththozi","poem":2},{"lineBreak":true},{"text":"Sa7oorime gakkides.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ichchashanththozi","poem":1},{"text":"Malkiya gakkides;","poem":2},{"lineBreak":true},{"text":"Usuppunththozi","poem":2},{"lineBreak":true},{"text":"Miyaamine gakkides;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Laappunththozi","poem":1},{"text":"Haqoxe gakkides;","poem":2},{"lineBreak":true},{"text":"osppunththozi","poem":2},{"lineBreak":true},{"text":"Abiya gakkides;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Uddufunththozi","poem":1},{"text":"Iyaaso gakkides;","poem":2},{"lineBreak":true},{"text":"tammanththozi","poem":2},{"lineBreak":true},{"text":"Shakaaniya gakkides;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tamman issinththozi","poem":1},{"text":"Elyaasheebe gakkides;","poem":2},{"lineBreak":true},{"text":"tamman nam7anththozi","poem":2},{"lineBreak":true},{"text":"Yaaqime gakkides;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tamman heedzdzanththozi","poem":1},{"text":"Huppa gakkides;","poem":2},{"lineBreak":true},{"text":"tamman oydanththozi","poem":2},{"lineBreak":true},{"text":"Yasheba7aabe gakkides;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tamman ichchashanththozi","poem":1},{"text":"Bilga gakkides;","poem":2},{"lineBreak":true},{"text":"Tamman usuppunththozi","poem":2},{"lineBreak":true},{"text":"Imere gakkides;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tamman laappunththazi","poem":1},{"text":"Hezire gakkides;","poem":2},{"lineBreak":true},{"text":"tamman osppunththozi","poem":2},{"lineBreak":true},{"text":"Hafixeexe gakkides;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tamman uddufunththozi","poem":1},{"text":"Pattaya gakkides;","poem":2},{"lineBreak":true},{"text":"nam7u tammanththazi","poem":2},{"lineBreak":true},{"text":"Hiziqeela gakkides;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nam7u tamman issinththozi","poem":1},{"text":"Yaakine gakkides;","poem":2},{"lineBreak":true},{"text":"nam7u tamman nam7anththozi","poem":2},{"lineBreak":true},{"text":"Gaamule gakkides;","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nam7u tamman heedzdzanththozi","poem":1},{"text":"Dallaya gakkides;","poem":2},{"lineBreak":true},{"text":"Nam7u tamman oydanththozi","poem":2},{"lineBreak":true},{"text":"Ma7aaziya gakkides.","poem":2}]},{"type":"verse","number":19,"content":["Isra7eele GODAY istta azazida malanne kase istta aawa Aarooney isttas woththida waaga mala istti Xoossaa keeth geliza wode ooththana mala imettida wogay hayssa."]},{"type":"heading","content":["Attida Hara Leweta Ooso"]},{"type":"verse","number":20,"content":["Attida hara Lewe zareti",{"text":"Amiraame naytappe Shebu7eele,","poem":1},{"text":"Shebu7eele naytappe Yehidaye.","poem":2}]},{"type":"verse","number":21,"content":["Erahaabiya naytappe bayra naaza Yishiya."]},{"type":"verse","number":22,"content":["Yixihaaretappe Shalomite;",{"text":"Shalomite naytappe Yahaate.","poem":2}]},{"type":"verse","number":23,"content":["Kebroone naytappe koyrozi Yiriya, nam7anththozi Amaariya, heedzdzanththozi Yahazi7eele, oydanththozi Yoqima7aame."]},{"type":"verse","number":24,"content":["Uzi7eele naytappe Mikiyaasa naa Shamire."]},{"type":"verse","number":25,"content":["Mikiyaasa isha Yishiya naytappe Zakaraasa."]},{"type":"verse","number":26,"content":["Meraare attuma nayti Mahile, Mushenne Yaa7ize."]},{"type":"verse","number":27,"content":["Yaa7ize attuma nayti Benno, Shohaame, Zakurenne Ibire."]},{"type":"verse","number":28,"content":["Mahile attuma nayti El7ezeerenne Qiise; El7ezeeres attuma nay deenna."]},{"type":"verse","number":29,"content":["Qiises Yerahim7eele geetettiza issi attuma nay dees."]},{"type":"verse","number":30,"content":["Mushes Mahile, Edeerenne Yarmoote geetettiza heedzdzu attuma nayti deettes. Haytanti baso asan asan qoodettida Lewe zareta."]},{"type":"verse","number":31,"content":["Istta isha Aaroone nayti ooththoyssaththo kawo Dawite sinththan, Saadooqe sinththan, Ahimeleke sinththan, hessaththoka qeesetaso asata halaqatinne Lewetaso asata halaqati dizason saama yeggida; bayrazappe biidi wurseth gakkanaas dizaytas issi gina saama yeggida."]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/1CH/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/1CH/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/1CH/23.json","previousChapterAudioLinks":{},"numberOfVerses":31}