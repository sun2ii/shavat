{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"1CH","translationId":"gmv_ltw","name":"1Taarike Maxaafa","commonName":"1Taarike Maxaafa","title":"1Taarike Maxaafa","order":13,"numberOfChapters":29,"sha256":"d3263de5e023e124923b661041016e3d3b70e7f291289d68ff9eabae20a902a5","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/gmv_ltw/1CH/29.json","totalNumberOfVerses":939},"chapter":{"number":25,"content":[{"type":"heading","content":["Xoossa Keeththan Yexxizayta"]},{"type":"verse","number":1,"content":["Dawitinne ola gadawati Aasaafe naytappe, Hemaane naytappenne Edotaane naytappe maasinqon, diiththaninne daalan awajjishe tinbite yootizayta doori woththida; hayssa ha oosoza ooththana mala doorettida asata sunththi hayssafe kaalli dizayssa."]},{"type":"verse","number":2,"content":["Aasaafe naytappe Zakure, Yooseefe, Nataniyanne Asher7eele; hayti Aasaafe nayti kawoy azaziin tinbite yootiza Aasaafeppe garsara azazetteettes."]},{"type":"verse","number":3,"content":["Edotaane naytappe Godoliyaasa, Xeere, Yesha7iya, Shim7e, Hashaabiyanne Matitiya; ha usuppunati maasinqon GODAA galatishenne bonchchishe tinbite yootiza ba aawa Edotaaneppe garsara azazetteettes."]},{"type":"verse","number":4,"content":["Hemaane naytappe Buuqiya, Maataaniya, Uzi7eele, Shuba7eele, Yarmoote, Hanaaniya, Hanaane, El7aata, Gidolte, Eromaamte-Eezere, Yoshibaqaashe, Maalota, Hotirenne Mahizi7oote."]},{"type":"verse","number":5,"content":["Hayti ubbatikka kawozas tinbite yootiza Hemaane nayta; Xoossay izas immana gida mala Hemaane dhoqqu dhoqqu histtanaas ha 14 attuma naytanne 3 macca nayta izas immides."]},{"type":"verse","number":6,"content":["Hayti ubbay GODAA keeththan daala giirissishe, maasinqonne diith diixxishe bantta aawappe garsara Xoossa Keeththan ooththeettes. Aasaafey, Edotaaneynne Hemaaney kawozappe garsara azazettishe deettes."]},{"type":"verse","number":7,"content":["Hayti ba dabbotara gididi GODAA sinththan shiiqiza mazamure tamaari loohidayta; istta qooday mulera nam7u xeetanne osppun tammanne osppuna."]},{"type":"verse","number":8,"content":["Istti bantta ooso shaakki eranaas cimanne naa, astamaarenne tamaare gi shaakkontta issi gina saama yeggida."]},{"type":"verse","number":9,"content":[{"text":"Koyro saamay","poem":1},{"text":"Aasaafe baggafe gidida","poem":2},{"lineBreak":true},{"text":"Yooseefe naytassinne","poem":2},{"lineBreak":true},{"text":"iza dabbotas kezides;","poem":2},{"lineBreak":true},{"text":"isttas qooday 12;","poem":2},{"lineBreak":true},{"text":"nam7anththo","poem":2},{"lineBreak":true},{"text":"saamay Godoliyaasas,","poem":2},{"lineBreak":true},{"text":"iza naytassinne","poem":2},{"lineBreak":true},{"text":"iza dabbotas kezides;","poem":2},{"lineBreak":true},{"text":"isttas qooday 12.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Heedzdzanththo","poem":1},{"text":"saamay Zakures,","poem":2},{"lineBreak":true},{"text":"iza naytassinne","poem":2},{"lineBreak":true},{"text":"iza dabbotas kezides;","poem":2},{"lineBreak":true},{"text":"isttas qooday 12.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Oydanththo","poem":1},{"text":"saamay Yexires,","poem":2},{"lineBreak":true},{"text":"iza naytassinne","poem":2},{"lineBreak":true},{"text":"iza dabbotas kezides;","poem":2},{"lineBreak":true},{"text":"isttas qooday 12.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ichchashanththo","poem":1}