,{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Addayay Etaane naa;","poem":2},{"lineBreak":true},{"text":"Etaaney Ziima naa;","poem":2},{"lineBreak":true},{"text":"Ziimay Shim7e naa;","poem":2}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Shim7ay Yahaate naa;","poem":2},{"lineBreak":true},{"text":"Yahaatey Gershoome naa;","poem":2},{"lineBreak":true},{"text":"Gershoomey Lewe naa.","poem":2}]},{"type":"verse","number":44,"content":["Isttas hadirsa baggara istta dabbo Meraare zarkketi eqqeettes;",{"text":"Etaaney Qiisha naa;","poem":1},{"text":"Qiishi Abide naa;","poem":2},{"lineBreak":true},{"text":"Abdey Maallukke naa;","poem":2}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Maallukkey Hashaabiya naa;","poem":2},{"lineBreak":true},{"text":"Hashaabiyay Amasiyaasa naa;","poem":2},{"lineBreak":true},{"text":"Amasiyaasi Kilqiyaasa naa;","poem":2}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Kilqiyaasi Amoze naa;","poem":2},{"lineBreak":true},{"text":"Amozey Baane naa;","poem":2},{"lineBreak":true},{"text":"Baaney Shemere naa;","poem":2}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Shemerey Mahile naa;","poem":2},{"lineBreak":true},{"text":"Mahiley Mushe naa;","poem":2},{"lineBreak":true},{"text":"Mushey Meraare naa;","poem":2},{"lineBreak":true},{"text":"Meraarey Lewe naa.","poem":2}]},{"type":"verse","number":48,"content":["Isttas ishantta gidida hankko Lewe qommoti Xoossa Keeththan Gaytoteththa Dunkaanen oosettiza hara ooso ubbaas doorettida."]},{"type":"heading","content":["Aaroone Nayta Zarkke"]},{"type":"verse","number":49,"content":["Aarooneynne iza nayti gidikko Xoossa aylle Musey azazida mala Isra7eele deraa nagara wursanaas ubbaafe dummatida giddo qol7aan oosettiza oosota ubbaas, yarsho yarshizasoza bolla xuugettiza yarsho yarshanaassinne Exaane cuwasi yarshizasoza bolla exaane cuwasanaas isttas aawateththi imettides."]},{"type":"verse","number":50,"content":["Aaroone nayta zarkketi hayssafe kaalli xaafettidayta;",{"text":"Aaroone nay El7ezeere;","poem":1},{"text":"El7ezeere nay Finihaase;","poem":2},{"lineBreak":true},{"text":"Finihaase nay Abishu7a;","poem":2}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Abishu7a nay Buuqa;","poem":2},{"lineBreak":true},{"text":"Buuqa nay Uuze;","poem":2},{"lineBreak":true},{"text":"Uuze nay Zarahiya;","poem":2}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"Zarahiya nay Marayoote;","poem":2},{"lineBreak":true},{"text":"Marayoote nay Amaariya;","poem":2},{"lineBreak":true},{"text":"Amaariya nay Ahixuube;","poem":2}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"Ahixuube nay Saadooqe;","poem":2},{"lineBreak":true},{"text":"Saadooqe nay Akimaase.","poem":2}]},{"type":"heading","content":["Lewe Qommoti Daana Mala Imettida Sohota"]},{"type":"verse","number":54,"content":["Aaroone naytas imettida duussa sohoti hayssafe kaalli xaafettida; koyro saamay Qa7aate baggatas kezides;"]},{"type":"verse","number":55,"content":["Isttas Yuhuda biittan diza Kebroonenne iza heeran diza mehe heemmizasohota immida."]},{"type":"verse","number":56,"content":["Kebroone yuushon diza goshsha gadetinne mooththati Yoofine naa Kaalebes imettida."]},{"type":"verse","number":57,"content":["Aaroone naytas shemppo wodhidaadey baqati biidi attiza katamata, Kebroone, Yetire, Libinanne mehe heemmizasohota, Eshttamo7anne mehe heemmizasohota,"]},{"type":"verse","number":58,"content":["Hiilenenne mehe heemmizasohota, Dabirenne mehe heemmizasohota,"]},{"type":"verse","number":59,"content":["Ashaanenne mehe heemmizasohota, Beeti-Shemishenne mehe heemmizasohota immida."]},{"type":"verse","number":60,"content":["Qasse Biniyaame qommota gadeppe Geebanenne mehe heemmizasohota, Alemeetenne mehe heemmizasohota, Anatootenne mehe heemmizasohota immida; Aaroone naytas imettida katamati mulera tammanne heedzdza."]},{"type":"verse","number":61,"content":["Arshey wulliza baggara diza Minaase zarkke baggati oykkida gadezappe 10 katamati hankko attida Qa7aate zarkketas imettida."]},{"type":"verse","number":62,"content":["Yisakoore zarkketa biittafe, Aaseere zarkketa biittafe, Niftaaleme zarkketa biittafenne Baasaanen diza Minaase zarkketa biittafe 13 katamata Gershoone zarkketas immida."]},{"type":"verse","number":63,"content":["Oroobeele zarkketa biittafe, Gaade zarkketa biittafenne Zaabiloone zarkketa biittafe 12 katamata Meraare zarkketas saaman immida."]},{"type":"verse","number":64,"content":["Hessaththo ooththidi Isra7eele asay Lewetas ha katamatanne istta heeran diza mehe heenththasohota immides."]},{"type":"verse","number":65,"content":["Hayssafe bollara sunththay isttas xeygettida katamata Yuhuda zarkketappe, Simoona zarkketappe, Biniyaame zarkketappe hara katamatan ooththoyssa mala Saama yeggidi istta gakkidayssa gisha immida."]},{"type":"verse","number":66,"content":["Qa7aate zarkketa giddofe issi keeththa asatas Efreeme zarkketa gakkida biittaafe katamatanne mehe heemmizasoho immida."]},{"type":"verse","number":67,"content":["Isttas shemppo wodhidaadey baqati biidi attiza katamata, Efreeme deren gezze biittan diza Seekeemenne mehe heemmizasohota, Gezeerenne mehe heemmizasohota,"]},{"type":"verse","number":68,"content":["Yoqima7aamenne mehe heemmizasohota, Beeti-Horoonenne iza mehe heemmizasohota,"]},{"type":"verse","number":69,"content":["Ayaaloonenne mehe heemmizasohota, Geet-Ermoonenne mehe heemmizasohota immida."]},{"type":"verse","number":70,"content":["Minaase zarkketa baggafe Aneerenne mehe heemmizasohotanne Balaamanne mehe heemmizasohota ekkidi Qa7aate zarkketappe attidaytas immida."]},{"type":"verse","number":71,"content":["Minaase zarkketa baggafe Baasaanen diza Golaanenne mehe heemmizasohotanne Astarootenne mehe heemmizasohota ekkidi Gershoone zarkketas immida."]},{"type":"verse","number":72,"content":["Qasse Yisakoore zarkketappe Qaadeesenne mehe heemmizasohota, Dabiraatenne mehe heemmizasohota,"]},{"type":"verse","number":73,"content":["Eramootenne mehe heemmizasohotanne Aneemanne mehe heemmizasohota ekkidi isttas immida."]},{"type":"verse","number":74,"content":["Aaseere zarkketappe Mashaalanne mehe heemmizasohota, Abdoonenne mehe heemmizasohota,"]},{"type":"verse","number":75,"content":["Huqooqenne mehe heemmizasohotanne Erahoobenne mehe heemmizasohota ekkidi isttas immida."]},{"type":"verse","number":76,"content":["Hessaththoka Niftaaleme zarkketappe Galilan diza Qaadeesenne mehe heemmizasohota, Hamoonenne mehe heemmizasohotanne Qiriyaataymenne mehe heemmizasohota ekkidi isttas immida."]},{"type":"verse","number":77,"content":["Attida Meraare zarkketas Zaabiloone zarkketappe Armoonenne mehe heemmizasohotanne Taaboorenne mehe heemmizasohota ekkidi immida."]},{"type":"verse","number":78,"content":["Qasse Oroobeele zarkketappe Iyarkko ginan, Yordaanooseppe he pinththan arshey wulliza baggara, bazzon diza Baxiranne mehe heemmizasohota, Yahaaxenne mehe heemmizasohota,"]},{"type":"verse","number":79,"content":["Qidimootenne mehe heemmizasohotanne Mefa7aatenne mehe heemmizasohota ekkidi isttas immida."]},{"type":"verse","number":80,"content":["Gaade zarkketappe Gala7aaden diza Eramootenne mehe heemmizasohota, Mahanaymenne mehe heemmizasohota,"]},{"type":"verse","number":81,"content":["Haseboonenne mehe heemmizasohotanne Iyaazeerenne mehe heemmizasohota ekkidi isttas immida."]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/1CH/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/1CH/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/1CH/5.json","previousChapterAudioLinks":{},"numberOfVerses":81}