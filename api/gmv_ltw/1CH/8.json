{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"1CH","translationId":"gmv_ltw","name":"1Taarike Maxaafa","commonName":"1Taarike Maxaafa","title":"1Taarike Maxaafa","order":13,"numberOfChapters":29,"sha256":"d3263de5e023e124923b661041016e3d3b70e7f291289d68ff9eabae20a902a5","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/gmv_ltw/1CH/29.json","totalNumberOfVerses":939},"chapter":{"number":8,"content":[{"type":"heading","content":["Biniyaame Nayta Zarkke"]},{"type":"verse","number":1,"content":["Biniyaames bayra naazi Beela; iza kaaloti Ashibeele, Ahirahe,"]},{"type":"verse","number":2,"content":["Noha, Erafe."]},{"type":"verse","number":3,"content":["Beela zareti Adaare, Geera, Abihuude,"]},{"type":"verse","number":4,"content":["Abishu7a, Na7imaane, Ahoowa,"]},{"type":"verse","number":5,"content":["Geera, Shafaamenne Huraame."]},{"type":"verse","number":6,"content":["Ehuude zareti Na7imaane, Akayanne Geera; istti Geeban diza bantta keeththa asatas halaqata; hessafe guye istti Manahaate biitta di7etti bida; Oozanne Ahihuude aawa Geeray isttas halaqa."]},{"type":"verse","number":8,"content":["Shaharaymey ba machcheta Hushimonne Ba7iro anjji yeddidaappe guye Mo7aabe biittan attuma nayta yelides."]},{"type":"verse","number":9,"content":["Shaharayme ba machcho Hodeeshippe Yobaabe, Ziibiya, Meeshe, Malkaame,"]},{"type":"verse","number":10,"content":["Ya7uuxe, Saakiyanne Mirma yelides; iza nayti ubbay baso asatas halaqa gidida."]},{"type":"verse","number":11,"content":["Qasse ba machcho Hushimippe Ahixuubenne Elpa7eele yelides."]},{"type":"verse","number":12,"content":["Elpa7eele nayti Eboore, Mishaamenne Shemede; Shemedi Oonno katamata, Looda katamatanne istta yuushon diza qeeri katamata essides."]},{"type":"verse","number":13,"content":["Bariheynne Shema7ey Ayaaloone katamaan diza bantta keeththa asatas halaqa gidida; istti Geete katamaan diza asaa yedeththida."]},{"type":"verse","number":14,"content":["Barihe zareti Ahiyo, Shaashaqe, Yarmoote,"]},{"type":"verse","number":15,"content":["Zabaadiya, Araade, Edeere,"]},{"type":"verse","number":16,"content":["Mika7eele, Yishiphanne Yooha geetetteettes."]},{"type":"verse","number":17,"content":["Elpa7eele zareti Zabaadiya, Mashulaame, Hizqa, Heebere,"]},{"type":"verse","number":18,"content":["Yishimaraye, Yuzila7enne Yobaabe."]},{"type":"verse","number":19,"content":["Shim7e zareti Yaaqime, Zikire, Zabde,"]},{"type":"verse","number":20,"content":["El7enaaye, Elnaye, El7eele,"]},{"type":"verse","number":21,"content":["Adaya, Birayenne Shimiraate."]},{"type":"verse","number":22,"content":["Shaashaqe zareti Yishipha, Eboore, El7eele,"]},{"type":"verse","number":23,"content":["Abdoone, Zikire, Hanaane,"]},{"type":"verse","number":24,"content":["Hanaaniya, Elaame, Antooteya,"]},{"type":"verse","number":25,"content":["Yifidayenne Panu7eele."]},{"type":"verse","number":26,"content":["Yirohaame zareti Shaamisharaye, Shahaariya, Attaaliya,"]},{"type":"verse","number":27,"content":["Ya7ireeshe, Eelaasanne Zikire."]},{"type":"verse","number":28,"content":["Hayti ubbati ba keeththa asatas halaqata; ba zereththa zarkketi xaafetti diza Yerusalaamen deettes."]},{"type":"verse","number":29,"content":["Geba7oone aawa Yi7i7eeley Geba7oone kataman dees; iza machchey sunththika Ma7ikko."]},{"type":"verse","number":30,"content":["Izas bayra naazi Abdoone geetettees; iza kaaloti Xuure, Qiise, Ba7aale, Neerey Nadaabe,"]},{"type":"verse","number":31,"content":["Gadoore, Ahiyo, Zekurenne"]},{"type":"verse","number":32,"content":["Shime7e aawa Miqiloote; hayti ubbati ba dabbota matan Yerusalaamen deettes."]},{"type":"heading","content":["Sa7oole Zarkketa"]},{"type":"verse","number":33,"content":[{"text":"Neerey Qiise yelides;","poem":1},{"text":"Qiisey Sa7oole yelides;","poem":2},{"lineBreak":true},{"text":"Sa7ooli Yoonataane, Malkeshu7a,","poem":2},{"lineBreak":true},{"text":"Abinadaabenne","poem":2},{"lineBreak":true},{"text":"Eshiba7aale yelides.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Yoonataane nay Mariiba-Ba7aale;","poem":1},{"noteId":0},{"text":"Mariiba-Ba7aaley","poem":2},{"lineBreak":true},{"text":"Mikiyaasa yelides.","poem":2}]},{"type":"verse","number":35,"content":["Mikiyaasa attuma nayti Pitoone, Meleeke, Tare7anne Akaaze."]},{"type":"verse","number":36,"content":[{"text":"Akaazey Yaho7aade yelides;","poem":1},{"text":"Yaho7aadi Alemeete,","poem":2},{"lineBreak":true},{"text":"Azimootenne Zimire yelides;","poem":2},{"lineBreak":true},{"text":"Zimirey Mooza yelides;","poem":2}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Moozay Bini7e yelides;","poem":2},{"lineBreak":true},{"text":"Bini7ey Erafaye yelides;","poem":2},{"lineBreak":true},{"text":"Erafayey El7aasa yelides;","poem":2},{"lineBreak":true},{"text":"El7aasi Azeele yelides.","poem":2}]},{"type":"verse","number":38,"content":["Azeeles 6 attuma nayti deettes; heytikka Azirqaame, Bookere, Isma7eele, Sha7aariya, Abdiyunne Hanaane; hayti ubbay Azeele nayta."]},{"type":"verse","number":39,"content":["Azeele isha Esheeqes heedzdzu attuma nayti deettes; bayrazi Ulaame kaaloti Ya7uushenne Elfaleexe."]},{"type":"verse","number":40,"content":["Ulaame nayti wolqqamanne mino olanchchata; isttika wondafen duko erizayta; Ulaames 150 attuma naytinne nayta nayti deettes. Hayti ubbati Biniyaame zareta."]}],"footnotes":[{"noteId":0,"caller":"+","text":"Mariiba-Ba7aaley Memfeboste geetettides; 2Same 4:4 xeella.","reference":{"chapter":8,"verse":34}}]},"thisChapterLink":"/api/gmv_ltw/1CH/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/1CH/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/1CH/7.json","previousChapterAudioLinks":{},"numberOfVerses":39}