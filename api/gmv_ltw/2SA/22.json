pe","poem":2},{"lineBreak":true},{"text":"tana ashshadasa.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Abeet ta GODAWU!","poem":1},{"text":"Kawoteththata giddon","poem":2},{"lineBreak":true},{"text":"ta nena galatana;","poem":2},{"lineBreak":true},{"text":"ne sunththaas galata mazamure","poem":2},{"lineBreak":true},{"text":"ta yexxana.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Izi kawozas gita xoono immees;","poem":1},{"text":"ba tiyda Dawitesinne","poem":2},{"lineBreak":true},{"text":"iza zereththas,","poem":2},{"lineBreak":true},{"text":"ba mernaa kiyateth bessees.»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/2SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":51}