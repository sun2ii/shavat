{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"2SA","translationId":"gmv_ltw","name":"2Sameela Maxaafa","commonName":"2Sameela Maxaafa","title":"2Sameela Maxaafa","order":10,"numberOfChapters":24,"sha256":"18290f11f884d2b3e001d6b31c6170325a2959c939e1d15ca7850c94f825021a","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/gmv_ltw/2SA/24.json","totalNumberOfVerses":694},"chapter":{"number":23,"content":[{"type":"heading","content":["Dawiti Wurseththan Yootida Qaala"]},{"type":"verse","number":1,"content":["Dawiti wurseththan haasayda qaalay hayssafe kaallizayssa;",{"text":"«Yaaqoobe Xoossaan tiyettidayssi,","poem":1},{"text":"Ubbaafe Dhoqqa Xoossay","poem":2},{"lineBreak":true},{"text":"dhoqqu dhoqqu histtida asi,","poem":2},{"lineBreak":true},{"text":"Isra7eelen dosettida yeththanchchay,","poem":2},{"lineBreak":true},{"text":"Isseye naa Dawite tinbite","poem":2},{"lineBreak":true},{"text":"qaalay hayssa;","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«GODAA Ayanay","poem":1},{"text":"ta baggara haasaydes;","poem":2},{"lineBreak":true},{"text":"iza qaalay ta doonan dees.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isra7eele Xoossi haasaydes;","poem":1},{"text":"Isra7eele zaallay taas,","poem":2},{"lineBreak":true},{"text":"‹Asaa xilloteththan haarizay,","poem":2},{"lineBreak":true},{"text":"Xoossa yashshateththan ayssizay,","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"izi shaaray bayndason,","poem":2},{"lineBreak":true},{"text":"maalado xalqqey keziza","poem":2},{"lineBreak":true},{"text":"wode diza poo7o mala;","poem":2},{"lineBreak":true},{"text":"izi biitta bolla maata","poem":2},{"lineBreak":true},{"text":"purccisiza xalqqe mala,","poem":2},{"lineBreak":true},{"text":"iray bukki aadhdhishin","poem":2},{"lineBreak":true},{"text":"ke7iza awa mala› gides.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Ta keeththi Xoossa matan","poem":1},{"text":"likke gidennee?","poem":2},{"lineBreak":true},{"text":"Ubba miish giigsidinne naagidi,","poem":2},{"lineBreak":true},{"text":"tanara mernaa caaqo qaala","poem":2},{"lineBreak":true},{"text":"geliday iza gidennee?","poem":2},{"text":"Ta atoteththa polo gaththanay","poem":1},{"text":"ta amo ubbaa taas immanay","poem":2},{"lineBreak":true},{"text":"iza gidennee?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gido attiin iita asati ubbay,","poem":1},{"text":"kushen shiishshana dandayettontta","poem":2},{"lineBreak":true},{"text":"agunththa mala","poem":2},{"lineBreak":true},{"text":"wora wodhdhana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Agunth bochchiza ubbaas,","poem":1},{"text":"birata woykko","poem":2},{"lineBreak":true},{"text":"toora tooma koshshees;","poem":2},{"lineBreak":true},{"text":"istti ba dizason mulera","poem":2},{"lineBreak":true},{"text":"taman xuugettana.»","poem":2}]},{"type":"heading","content":["Erettida Qara Asata"]},{"type":"verse","number":8,"content":["Dawites erettida qara asata sunththi hayssafe kaallizayssa; koyroyssi Tahikimoone dere as Yoshebi-Baashebete gidishin izi heedzdzu halaqatas halaqa; izikka issi olan ba toora xongidi 800 as wodhida qara."]},{"type":"verse","number":9,"content":["Nam7anththozi Ahihohe dere as Doode naa El7ezeere; olettanaas issi bolla shiiqida Filisxeeme asay eqettiza wode Isra7eele asay baqatides; Dawitera diza heedzdzu qarata garsafe issoy iza."]},{"type":"verse","number":10,"content":["Izi gidikko ba eqqidaso yeddibeenna; iza kushey argacanaashenne mashshara issife oykettanaashe gakkanaas Filisxeemeta olides; he gallas GODAY izas gita xoono immides. Baqati bida olanchchati hayqqida asaappe ola miishshinne may7o xalla qaaratanaas Ele7eezerekko guye simmida."]},{"type":"verse","number":11,"content":["Heedzdzanththozi Harare dere as Aage naa Shaama; Filisxeemeti Leehan kumeth misiray zerettida gaden istti issi bolla shiiqi dishin Isra7eele olanchchati Filisxeemeta sinththafe baqatida."]},{"type":"verse","number":12,"content":["Shaamay gidikko ba eqqidaso yeddibeenna; he olaa eqettidi Filisxeemeta wodhides; he gallas GODAY gita xoono immides."]},{"type":"verse","number":13,"content":["Kaththa shiisho wode Filisxeeme olanchchati Erafayme zullen dunkaani uttidaashe heedzdzu tammu halaqatappe heedzdzati Dawiti dizaso Adulaame gongolo yida."]},{"type":"verse","number":14,"content":["He wode Dawiti miixa giddon dees; Filisxeeme olanchchati Beeteliheemen deettes."]},{"type":"verse","number":15,"content":["Dawiti laamotidi, «Beeteliheeme penge achchan diza olla haaththaafe taas oonee ehanay!» gides."]},{"type":"verse","number":16,"content":["Hessa gishshas erettida ola qara heedzdzati Filisxeeme olanchchata giddora kanththi biidi Beeteliheeme penge achchan diza haaththa ollafe duuqqi Dawites ehida; izi gidikko GODAA sinththan yarsho histti gussides attiin uyibeenna."]},{"type":"verse","number":17,"content":["«Abeet GODAWU! Hayssa mala ooso ta wostta ooththoo? Hayssi taappe haakko! Hayssi bantta shemppo bolla pirdida asata suuth deennee?» giidi Dawiti uyana koyibeenna; hekko erettida heedzdzu ola qarati ooththida goobateththa oosoy hessa."]},{"type":"verse","number":18,"content":["Xuriya naa Iyo7aabe ishaa Abisayey heedzdzu erettida ola qaratas halaqa; heedzdzu xeetu asaa bolla ba toora xongidi wodhidanne ha heedzdzu qarata mala erettida gooba asa."]},{"type":"verse","number":19,"content":["Abisayey heedzdzatappe bollara keehi erettida as gidennee? Izi isttafe gidontta aggikokka izi isttas halaqa."]},{"type":"verse","number":20,"content":["Hara erettida qaray Qabxi7eele dere as Yoodahe naa Bannayay gita erettida ooso ooththides. Izikka nam7u erettida Mo7aabe asata wodhides; qasseka shachchi bukkida gallas olla giddo gelidi gaammo wodhides."]},{"type":"verse","number":21,"content":["Hessaththoka issi gita Gibxe as wodhides; he Gibxe addezi ba kushen toora oykkides; gido attiin Bannayay izara olettanaas guufe oykkidi izakko bides; Gibxe addeza kusheppe iza toora woththi ekkidi iza tooran iza wodhides."]},{"type":"verse","number":22,"content":["Yoodahe naa Bannaya goobateththi hessa; izikka erettida heedzdzu qara asata mala erettida gooba asa."]},{"type":"verse","number":23,"content":["Izi he heedzdzu tammu asatappe aadhdhi bonchchettidaade; gido attiin erettida heedzdzu qara asata mala sabettenna. Dawiti Bannaya ba bonchcho zabeta bolla shuumides."]},{"type":"verse","number":24,"content":["He heedzdzu tammatappe baggayta sunththi hayssafe kaallizayssa.",{"text":"Iyo7aabe ishaa Asaheele,","poem":1},{"lineBreak":true},{"text":"Beeteliheeme dere as Doode","poem":1},{"text":"naa Elyaane,","poem":2}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Harare dere as Shammaha,","poem":2},{"text":"Harare dere as Eliqa,","poem":1}]},{"type":"verse","number":26,"content":[{"text":"Palixe dere as Heleexe,","poem":2},{"text":"Tequhe dere as Iqesha","poem":1},{"text":"naa Ira,","poem":2}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Anatoote dere as Abi7eezere,","poem":2},{"text":"Huushe dere as Mebunaye,","poem":1}]},{"type":"verse","number":28,"content":[{"text":"Ahihohe dere as Xalmoone,","poem":2},{"text":"Naxoofe dere as Mahiraye,","poem":1}]},{"type":"verse","number":29,"content":[{"text":"Naxoofe dere as Ba7aana","poem":2},{"lineBreak":true},{"text":"naa Helebe,","poem":2},{"text":"Biniyaame baggafe Gibi7a dere as","poem":1},{"text":"Eribaye naa Ittaye,","poem":2}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Piraatoone dere as Bannaya,","poem":2},{"text":"Ga7aashe zulle as Hidaaye,","poem":1}]},{"type":"verse","number":31,"content":[{"text":"Arabe dere as Abi-Elboone,","poem":2},{"text":"Barhume dere as Azimoote,","poem":1}]},{"type":"verse","number":32,"content":[{"text":"Shaalboone dere as Eliyaahibe,","poem":2},{"text":"Yashene nayta,","poem":1},{"text":"Yoonataane,","poem":2}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Harare dere as Shammaha naa,","poem":2},{"text":"Harare dere as","poem":1},{"text":"Sharare naa Ahi7aame,","poem":2}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Ma7ikate dere as","poem":2},{"lineBreak":true},{"text":"Ahasiba naa Elfaleexe,","poem":2},{"text":"Gilo dere as","poem":1},{"text":"Akxofeele naa El7aame,","poem":2}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Qarmeloose dere as Hexiro,","poem":2},{"text":"Arabe dere as Paaraye,","poem":1}]},{"type":"verse","number":36,"content":[{"text":"Xoobba dere as","poem":2},{"lineBreak":true},{"text":"Naataane naa Yigi7aale,","poem":2},{"text":"Gaade dere as Baane,","poem":1}]},{"type":"verse","number":37,"content":[{"text":"Amoone dere as Zallaqa,","poem":2},{"text":"Xuriya naa Iyo7aabes","poem":1},{"text":"gondalle oykkiza Bi7eroote","poem":2},{"lineBreak":true},{"text":"dere as Nahiraye,","poem":2}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Yatire dere as Ira,","poem":2},{"lineBreak":true},{"text":"Yatire dere as Gaareebe,","poem":2}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Hessaththoka Hiite","poem":2},{"lineBreak":true},{"text":"dere as Ooriyo,","poem":2},{"lineBreak":true},{"text":"istti issi bolla heedzdzu","poem":2},{"lineBreak":true},{"text":"tammanne laappuna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/2SA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/2SA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/2SA/22.json","previousChapterAudioLinks":{},"numberOfVerses":39}