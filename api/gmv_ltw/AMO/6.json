{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"AMO","translationId":"gmv_ltw","name":"Amoxe Tinbite","commonName":"Amoxe Tinbite","title":"Amoxe Tinbite","order":30,"numberOfChapters":9,"sha256":"994b0df562974c7a2eb011694ff74a7e224b1dea0772e823a629c55da2cd99db","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/gmv_ltw/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":6,"content":[{"type":"heading","content":["Isra7eele Qaxxayeteth"]},{"type":"verse","number":1,"content":["Xiyoonen badhdhi gi uttidaytoo! Samaariya zuma bolla hirgay baynda dizaytoo! Isra7eele asay maado koyidi intteko yizaytoo! Intteno dere halaqatoo! Inttes aayye ana!"]},{"type":"verse","number":2,"content":["Ane intte gede Kalanahe katama biidi xeellite; heeppeka aadhdhidi Hamaate geetetti xeygettiza gita katamayonne duge Filisxeeme katama Geete wodhdhite; istti intte nam7u kawoteththatappe lo7izoo? Istta biittay intte biittafe aakkizee?"]},{"type":"verse","number":3,"content":["Intte qasse, «Iita gallassi elle gakkenna» giza qofan intte daannateththan gene ooso eesoseeta."]},{"type":"verse","number":4,"content":["Intte danggarsa zaaleppe oosettida algan ichcheeta; ohala laaqqa ashonne mara asho mishe soofa bolla utti shempeeta."]},{"type":"verse","number":5,"content":["Dawite mala yeththa miish inttes giigsidi bagananinne dumma dumma mazamure yexxizaytoo!"]},{"type":"verse","number":6,"content":["Woyne ushshu birillera gidontta otora uyizaytoo! Keehi al7o gidida shitto tiyettizaytoo! Isra7eele deraa bolla gakkida meto gishshas qadhettonttayto inttena aayye ana!"]},{"type":"verse","number":7,"content":[{"text":"Hessa gishshas heera asappe","poem":1},{"text":"koyro intte di7ettana;","poem":2},{"lineBreak":true},{"text":"he wode intte kase ufayssan","poem":2},{"lineBreak":true},{"text":"guppiza gufaynne","poem":2},{"lineBreak":true},{"text":"badhdhi gi diza duussi attana.","poem":2}]},{"type":"verse","number":8,"content":["GODAY Salo Xoossay,",{"text":"«Isra7eele asa otoreteththaa","poem":1},{"text":"tani harassettadis;","poem":2},{"lineBreak":true},{"text":"istta miixatikka","poem":2},{"lineBreak":true},{"text":"tana shuunneettes;","poem":2},{"lineBreak":true},{"text":"hessa gishshas tani katamayonne","poem":2},{"lineBreak":true},{"text":"izin dizayta ubbaa","poem":2},{"lineBreak":true},{"text":"morkkes aaththa immana» giidi","poem":2},{"lineBreak":true},{"text":"barkka banan caaqqides.","poem":2}]},{"type":"verse","number":9,"content":["Issi keeththan tammati attiko he attidaytikka hayqqana."]},{"type":"verse","number":10,"content":["Hayqqidaytappe issaades mata dabbo gididaadeynne moogo woga polizaadey ahaza keeththafe kessi efana; he wode izaadey soon diza issi as xeygidi, «Nenara attida hara asi dizee?» giidi iza oychchana shin izaadey qasse, «Attida asi oonikka deenna» gaana. Oychchizayssika zaaridi, «GODAA nu Xoossa sunth xeyganaas bessontta gishshas co7u ga!» gaana."]},{"type":"verse","number":11,"content":[{"text":"GODAA azazon","poem":1},{"text":"wogga keeththati laalettana;","poem":2},{"lineBreak":true},{"text":"guuththa keeththatikka","poem":2},{"lineBreak":true},{"text":"laaletti attana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Paray shuchcha bolla togettizee?","poem":1},{"text":"Goshshanchchay abba giddon","poem":2},{"lineBreak":true},{"text":"boora waaxi goyanaas","poem":2},{"lineBreak":true},{"text":"dandayzee?","poem":2},{"lineBreak":true},{"text":"Intte gidikko","poem":2},{"lineBreak":true},{"text":"pirda marzen laammideta;","poem":2},{"lineBreak":true},{"text":"tumakka gede camon shirdeta.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Intte Lodibaare katama","poem":1},{"text":"xoonida gishshas ufayettideta;","poem":2},{"noteId":0},{"lineBreak":true},{"text":"«Qarnayme katamayo","poem":2},{"lineBreak":true},{"text":"nuni nu wolqqan oykkidos»","poem":2},{"lineBreak":true},{"text":"gidi ceeqetteeta.","poem":2},{"noteId":1}]},{"type":"verse","number":14,"content":["GODAY Salo Xoossay,",{"text":"«Isra7eele asawu!","poem":1},{"text":"Tani intte bolla","poem":2},{"lineBreak":true},{"text":"hara wolqqama dere denththana;","poem":2},{"lineBreak":true},{"text":"hessika pudeha baggafe","poem":2},{"lineBreak":true},{"text":"Hamaate pengefe doommidi","poem":2},{"lineBreak":true},{"text":"dugeha baggara Arabe","poem":2},{"lineBreak":true},{"text":"shoobba gakkanaas inttena","poem":2},{"lineBreak":true},{"text":"un7eththana» gees.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Lodibaare geetettizayssi katama sunth gidishin Ibraaweta qaalara hada miish guussa.","reference":{"chapter":6,"verse":13}},{"noteId":1,"caller":"+","text":"Qarnayme geetettizayssi guuththa katama sunththa; Ibraaweta qaalara kacey wolqqa leemiso gidi beettees.","reference":{"chapter":6,"verse":13}}]},"thisChapterLink":"/api/gmv_ltw/AMO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/AMO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/AMO/5.json","previousChapterAudioLinks":{},"numberOfVerses":14}