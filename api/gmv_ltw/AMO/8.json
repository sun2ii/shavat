{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"AMO","translationId":"gmv_ltw","name":"Amoxe Tinbite","commonName":"Amoxe Tinbite","title":"Amoxe Tinbite","order":30,"numberOfChapters":9,"sha256":"994b0df562974c7a2eb011694ff74a7e224b1dea0772e823a629c55da2cd99db","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/gmv_ltw/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":8,"content":[{"type":"heading","content":["Amoxey Ajjuutan Be7ida Teeray Kumida Keeshe"]},{"type":"verse","number":1,"content":["Ubbaafe Wolqqama GODAY tana hara ajjuuta bessides; hessika teeray izan kumi diza keeshe."]},{"type":"verse","number":2,"content":["GODAY tana, «Hessi ne be7izayssi aazee?» gi oychchides; tanikka izas, «Teerara diza daachcho beyays» gadis; qasseka Xoossi taas, «Ta dere Isra7eeles wurseththi gakkides; hayssafe guyen tani istta qaxxayontta aggike."]},{"type":"verse","number":3,"content":["«Istti Xoossa Keeththan sissiza yeththay he wode yeehon laamettana; daro asa ahay awan awanka kundi attana; awanka coo yegetti attana» gees."]},{"type":"heading","content":["Isra7eele Kundeth"]},{"type":"verse","number":4,"content":[{"text":"Intteno metotida asa qohizaytoo!","poem":1},{"text":"Qasse manqota biittafe dhayssana","poem":2},{"lineBreak":true},{"text":"koyzaytoo! Hayssa siyite!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Intte, «Nuni nu kaththa","poem":1},{"text":"bayzana mala","poem":2},{"lineBreak":true},{"text":"agina xeeron bonchchiza","poem":2},{"lineBreak":true},{"text":"ba7aaley ayde aadhdhaneeshaa!","poem":2},{"lineBreak":true},{"text":"Nuni kath giya gelththanaas","poem":2},{"lineBreak":true},{"text":"sambataykka nuus ayde","poem":2},{"lineBreak":true},{"text":"aadhdhaneeshaa!","poem":2},{"lineBreak":true},{"text":"He ba7aaley aadhdhiko","poem":2},{"lineBreak":true},{"text":"nuni maka","poem":2},{"lineBreak":true},{"text":"miishsha guuththidi","poem":2},{"lineBreak":true},{"text":"al7o waagan bayzana;","poem":2},{"lineBreak":true},{"text":"qasseka wordo meezaanen","poem":2},{"lineBreak":true},{"text":"asaa baleththana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gistte harqqoka muuruta","poem":1},{"text":"gistte waagan bayzana;","poem":2},{"lineBreak":true},{"text":"manqota biran, metotidaytakka","poem":2},{"lineBreak":true},{"text":"toho caamman shammana» geeta.","poem":2}]},{"type":"verse","number":7,"content":["Yaaqoobeynne iza zereththati izan ceeqettiza GODAY, «Istti ooththida ooso ubbaa tani balikke."]},{"type":"verse","number":8,"content":["Hayssa geedon biittay buro qaaxxana; biittay bolla dizay wurikka yeekkana; Abbaye shaafay kixxidi guummizayssaththo biitta ubbay qaaththi yoshikuyoshikana» giidi barkka banan caaqqides."]},{"type":"verse","number":9,"content":["Ubbaafe Wolqqama GODAY, «He wode tani gallassa seetan awa arshe wulsana; gallassa seetan gade dhumisana."]},{"type":"verse","number":10,"content":["Intte layththan layththan bonchchiza ba7aaleza yeehon laammana; intte yexxiza yeththaaka waason laammana; diza pexi issi nay hayqqiin camo yeeho yeekkiza asa mala intte intte hu7e binana buucidi maaqa may7ana mala tani inttena ooththana; he wurseththa gallassay camo gallas gidana."]},{"type":"verse","number":11,"content":["Hekko tani biitta bolla kosha ehana wodey yaana;",{"text":"hessika asay Xoossa qaala","poem":2},{"lineBreak":true},{"text":"siyana gafanne","poem":2},{"lineBreak":true},{"text":"saamo attiin kaththa gafanne","poem":2},{"lineBreak":true},{"text":"haaththa saamo gidenna.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Derey wuri pudehappe","poem":1},{"text":"dugeha gakkanaas","poem":2},{"lineBreak":true},{"text":"arshey mokkizasoppe","poem":2},{"lineBreak":true},{"text":"wullizaso gakkanaas","poem":2},{"lineBreak":true},{"text":"GODAA qaala kosh","poem":2},{"lineBreak":true},{"text":"yaanne haa yeemottanashin","poem":2},{"lineBreak":true},{"text":"demmenna.","poem":2}]},{"type":"verse","number":13,"content":["He wode lo7o geela7otinne",{"text":"mino panththati","poem":2},{"lineBreak":true},{"text":"saamoppe dendanayssan","poem":2},{"lineBreak":true},{"text":"daaburana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Samaariya deren, ‹Ashamo›","poem":1},{"text":"geetetta xeygettiza","poem":2},{"lineBreak":true},{"text":"eeqa xoossayn caaqqizayti,","poem":2},{"lineBreak":true},{"text":"‹Daane xoossay beyiin›","poem":2},{"lineBreak":true},{"text":"woykko, ‹Bersaabehe","poem":2},{"lineBreak":true},{"text":"xoossay beyiin›","poem":2},{"lineBreak":true},{"text":"gi caaqqizayti wurikka kundana;","poem":2},{"lineBreak":true},{"text":"ba kundidasohoppe mulekka","poem":2},{"lineBreak":true},{"text":"dendanaas dandayettenna» gees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/AMO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/AMO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/AMO/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}