;","poem":1},{"text":"qasseka ba mokkizaso baanaas eesotees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Carkoy dugeha bagga carkees;","poem":1},{"text":"hara wode pudeha bagga","poem":2},{"lineBreak":true},{"text":"simmees;","poem":2},{"lineBreak":true},{"text":"qasse yuuyi yuuyi aadhdhidi","poem":2},{"lineBreak":true},{"text":"ba losida ogen gelees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Shaafa haath ubbay","poem":1},{"text":"biidi abban gelees;","poem":2},{"lineBreak":true},{"text":"gido attiin abbay mulekka","poem":2},{"lineBreak":true},{"text":"kumi erenna;","poem":2},{"lineBreak":true},{"text":"shaafa haaththati kase ba yidaso","poem":2},{"lineBreak":true},{"text":"simmi beettes.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Asi haasayanaas","poem":1},{"text":"dandayzaazappe bollara","poem":2},{"lineBreak":true},{"text":"yo7oti ubbay saleththizaaza;","poem":2},{"lineBreak":true},{"text":"ayfey xeellidi kalli erenna;","poem":2},{"lineBreak":true},{"text":"hayththika siyidi,","poem":2},{"lineBreak":true},{"text":"«Taas gidides» gi erenna.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kase haniday simmi izi hanana;","poem":1},{"text":"qasse ha7i hanishe dizaykka","poem":2},{"lineBreak":true},{"text":"kase hanidayssa.","poem":2},{"lineBreak":true},{"text":"Hessa gishshas salo gufanththon","poem":2},{"lineBreak":true},{"text":"aykkoyka ooraththa","poem":2},{"lineBreak":true},{"text":"miishshi deenna.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Oonikka, «Be7ite!","poem":1},{"text":"Hayssi ooraththa miishsha» giikko","poem":2},{"lineBreak":true},{"text":"hessi ooraththa miish gidenna;","poem":2},{"lineBreak":true},{"text":"hessi nuni yelettanaappe","poem":2},{"lineBreak":true},{"text":"kasekka diza miishsha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Beni wode hanida hanota","poem":1},{"text":"zaaridi hassa7issiza","poem":2},{"lineBreak":true},{"text":"miishshi deenna;","poem":2},{"lineBreak":true},{"text":"sinththafe yaanaytikka","poem":2},{"lineBreak":true},{"text":"isttafe kaalli yaanaytan","poem":2},{"lineBreak":true},{"text":"qofettettenna.","poem":2}]},{"type":"heading","content":["Eranchchazi De7o Loseppe Demmida Timirte"]},{"type":"verse","number":12,"content":[{"text":"Tani eranchchazi Yerusalaamen","poem":1},{"text":"Isra7eeles kawo gidada de7adis.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tani salo gufanththon diza ubbaa","poem":1},{"text":"shaakka eranaassinne","poem":2},{"lineBreak":true},{"text":"aadho erateththan","poem":2},{"lineBreak":true},{"text":"pilgga xeellanaas","poem":2},{"lineBreak":true},{"text":"ta qofaa qachchadis;","poem":2},{"lineBreak":true},{"text":"Xoossi asa nayta toossida toohoy","poem":2},{"lineBreak":true},{"text":"ay mala deexoo!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Salo gufanththon hanida hanota","poem":1},{"text":"ubbaa ta be7adis;","poem":2},{"lineBreak":true},{"text":"gido attiin ubbayka hada;","poem":2},{"lineBreak":true},{"text":"carko oykkana yedeththiza mala.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Geellattida miishshi","poem":1},{"text":"sitti gaanawu dandayenna;","poem":2},{"lineBreak":true},{"text":"qasse baynda miishshi","poem":2},{"lineBreak":true},{"text":"qoodettana dandayenna.","poem":2}]},{"type":"verse","number":16,"content":["Tanikka ta wozinan, «Taappe kase Yerusalaame haarida ubbatappe tani gitanne aadho eranchcha gidadis; tani aadho erateththaninne eran keeha loohadis» ga qoppadis."]},{"type":"verse","number":17,"content":["Qasse tani aadho erateth, gooshshateththinne eeyateth shaakka eranaas keeha baaxetadis; gido attiin wurseththan hessika carko oykkanaas yedeththiza mala hada gididayssa eradis."]},{"type":"verse","number":18,"content":[{"text":"Aadho erateththi darshin","poem":1},{"text":"ceecey darees;","poem":2},{"lineBreak":true},{"text":"eray dariza wodekka","poem":2},{"lineBreak":true},{"text":"metoy