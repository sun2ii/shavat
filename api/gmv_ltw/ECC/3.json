es.","poem":2},{"lineBreak":true},{"text":"kayottanaas wodey dees;","poem":2},{"lineBreak":true},{"text":"qasse ufayettishe guppanaaskka wodey dees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Shuch laallanaas wodey dees;","poem":1},{"text":"shuch shiishshanaaskka wodey dees.","poem":2},{"lineBreak":true},{"text":"Idimettanaas wodey dees;","poem":2},{"lineBreak":true},{"text":"shaakettanaaskka wodey dees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Koyanaas wodey dees;","poem":1},{"text":"agganaaskka wodey dees.","poem":2},{"lineBreak":true},{"text":"Shiishshi oykkanaas wodey dees;","poem":2},{"lineBreak":true},{"text":"kessi olanaaska wodey dees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Daakkanaas wodey dees;","poem":1},{"text":"sikkanaaska wodey dees.","poem":2},{"lineBreak":true},{"text":"Co7u gaanaas wodey dees;","poem":2},{"lineBreak":true},{"text":"haasayanaaskka wodey dees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dosanaas wodey dees;","poem":1},{"text":"ixxanaaskka wodey dees.","poem":2},{"lineBreak":true},{"text":"Olas wodey dees;","poem":2},{"lineBreak":true},{"text":"saron daanaaskka wodey dees.","poem":2}]},{"type":"verse","number":9,"content":["Histtiin oosanchchay ba dafetti daaburdayssafe ay wodhe demmanee?"]},{"type":"verse","number":10,"content":["Tani qasse asaa nayti daaburdi ooththana mala Xoossi immida toohoy keehi deexo gididayssa be7adis."]},{"type":"verse","number":11,"content":["Ubbaa miish iza woden woden lo7eththidi ooththides. Xoossi asaa wozinan mernateth woththides; gidikkoka Xoossi ooththidayssa ubbaa koyroppe wurseth gakkanaas asi ubbaa eranaas dandayenna."]},{"type":"verse","number":12,"content":["Hessa gishshas asi ba de7o layththan lo7o ooso ooththizayssafenne ufayssizaaz ooththizaazappe aadhdhiza hara miishshi bayndayssa tani eradis."]},{"type":"verse","number":13,"content":["Qasse asas izas iza daaburaas waaga gidizay miidinne uyidi bana ufayssizayssa; hessika izas Xoossafe imettida imota."]},{"type":"verse","number":14,"content":["Xoossay ooththidayssi ubbay mernaas de7anayssa ta erays; izi ooththidayssa bolla gujjanaas woykko izappe guuththanaas dandayettenna. Xoossi hessa ooththiday asay iza bonchchana malassa."]},{"type":"verse","number":15,"content":[{"text":"Ha7i dizayssi","poem":1},{"text":"hayssafe kasekka dizayssa;","poem":2},{"lineBreak":true},{"text":"sinththafe hananayssi","poem":2},{"lineBreak":true},{"text":"benikka dizayssa;","poem":2},{"lineBreak":true},{"text":"Xoossi kase aadhdhidayssa","poem":2},{"lineBreak":true},{"text":"zaari koyees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Qasseka tani salo gufanththon","poem":1},{"text":"hara miish be7adis;","poem":2},{"lineBreak":true},{"text":"pirda sohon","poem":2},{"lineBreak":true},{"text":"makkallateththi dees;","poem":2},{"lineBreak":true},{"text":"suure pirda sohon geney dees.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tanikka ta wozinan,","poem":1},{"text":"«Ubbaa yo7ossinne oosos","poem":2},{"lineBreak":true},{"text":"wodey diza gishshas","poem":2},{"lineBreak":true},{"text":"Xoossi xillozanne wordanchchaza","poem":2},{"lineBreak":true},{"text":"pirdas shiishshana»","poem":2},{"lineBreak":true},{"text":"gaada qoppadis.","poem":2}]},{"type":"verse","number":18,"content":["Qasse tani ta wozinan, «Asi mehe mala gididayssa istti erana mala Xoossi paaccees."]},{"type":"verse","number":19,"content":["Asa qaadaykka meheyssa mala; nam7aa qaadaykka issino; issoy hayqqiza mala hankkoyssika hayqqees; nam7aaska issi qommo peenoy dees; hessa gishshas izi meheppe dummatenna; hessika hada."]},{"type":"verse","number":20,"content":["Nam7ayka issi soho beettes; nam7ayka biittafe medhettida gishshas biittan simmeettes."]},{"type":"verse","number":21,"content":["Histtiin asaa shemppoy pude salo kezizayssa, meheta shemppoyka duge biittan gelizayssa oonee erizay?» gaada qoppadis."]},{"type":"verse","number":22,"content":["Hessa gishshas asi ba ooththida ooson ufayssafe hara aadhdhiza miishshi bayndayssa ta be7adis; hessika asas imettida qaada; izi hayqqidaappe guye oosettida oosota iza zaari ehidi bessanay oonee?"]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/ECC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/ECC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/ECC/2.json","previousChapterAudioLinks":{},"numberOfVerses":22}