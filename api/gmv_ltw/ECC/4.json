"lineBreak":true},{"text":"Hessika hadanne tugga de7o.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Istta oosoy lo7o ayfe immanaas","poem":1},{"text":"dandayza gishshas","poem":2},{"lineBreak":true},{"text":"issino gidanaappe","poem":2},{"lineBreak":true},{"text":"nam7u gideththi lo7o.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Qasse nam7aafe","poem":1},{"text":"issoy kundiko issoy denththees;","poem":2},{"lineBreak":true},{"text":"gido attiin kundiko denththiza","poem":2},{"lineBreak":true},{"text":"laggey bayndaadey","poem":2},{"lineBreak":true},{"text":"ay mala qadheththizee!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nam7ay issife ichchiko ho7ees;","poem":1},{"text":"gido attiin barkka ichchidaade","poem":2},{"lineBreak":true},{"text":"waani ho7ana dandayzee?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Asi bizza qohana dandayees;","poem":1},{"text":"nam7u gidikko","poem":2},{"lineBreak":true},{"text":"izara eqettana dandayeettes;","poem":2},{"lineBreak":true},{"text":"Heedzdzan dooqettida wodoroy","poem":2},{"lineBreak":true},{"text":"elle duuxxenna.","poem":2}]},{"type":"verse","number":13,"content":["Zore ekkontta eeyanne cima kawo gidanaappe aadho erateththi diza naateththa manqoy lo7o."]},{"type":"verse","number":14,"content":["Ays giikko izi he hiyeesa gidida sohoppe dendidi woykko qasho keeththafe kezidi ba biittan kawotanaas dandayees."]},{"type":"verse","number":15,"content":["Tani salo gufanththon dizaytinne simerettizayti ubbay kawo araata laattiza yelagaa kaallizayssa be7adis."]},{"type":"verse","number":16,"content":["Iza sinththan qooday baynda derey dees; kawoteththafe izi kichchiza wode izi ooththidayssas oonikka iza galatenna. Hessika hada; carko oykkanaas yedeththiza mala."]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/ECC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/ECC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/ECC/3