{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"ECC","translationId":"gmv_ltw","name":"Eranchchata Maxaafa","commonName":"Eranchchata Maxaafa","title":"Eranchchata Maxaafa","order":21,"numberOfChapters":12,"sha256":"59faecc0fcd64608468a17f7fb7b5d21ad19b8c41b9495ab6ef9f9b1ac64e040","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/gmv_ltw/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":5,"content":[{"type":"heading","content":["Adinas Eesotoppa"]},{"type":"verse","number":1,"content":["Xoossa Keeth gelashe ne toho shiishsha ekka; siyanaas shiiqoy eeyata yarshofe aadhdhees; ays giikko istti bantta oosoy iita gididayssa erettenna."]},{"type":"verse","number":2,"content":[{"text":"Haasayanawu eesotoppa;","poem":1},{"text":"qasse issi miish Xoossas","poem":2},{"lineBreak":true},{"text":"immana gaada eeson geppofa;","poem":2},{"lineBreak":true},{"text":"ays giikko Xoossi salon dees;","poem":2},{"lineBreak":true},{"text":"neni gidikko sa7an daasa;","poem":2},{"lineBreak":true},{"text":"hessa gishshas ne haasayana","poem":2},{"lineBreak":true},{"text":"qaalay ginara gido.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ooso daron agumoy beettiza mala","poem":1},{"text":"haasaya daron","poem":2},{"lineBreak":true},{"text":"eeyateththa qaalay qonccees.","poem":2}]},{"type":"verse","number":4,"content":["Xoossas neni adinida adina gam7ontta gaththa; eeson polontta attiko izi ufayettenna; hessa gishshas neni adinettidayssa ubbaa pola."]},{"type":"verse","number":5,"content":["Issi miish Xoossas adinettidi he adinettidayssa gaththontta agganaappe kase adinettontta agoy lo7o."]},{"type":"verse","number":6,"content":["Nena ne doonay nagaran yeggontta mala ne doona shiishsha; qasse Xoossa Keeththa oosanchcha sinth shiiqada, «Ta hayssa qoppontta adinettadis» gooppa. Xoossa hanqeththada ne ooso ays dhayssisay?"]},{"type":"verse","number":7,"content":["Daro agumoynne daro haasayay hada; hessa gishshas neni Xoossas yayya."]},{"type":"heading","content":["Dureteththi Hada"]},{"type":"verse","number":8,"content":["Dere garsan manqoy sugettiin, pirday pacciin, maatay yedhettiin ne be7ikko heytanttan keeha malalettofa. Issi issi halaqaas izappe bollara halaqay dees; qasse ubbatappe bollara hara halaqati deettes."]},{"type":"verse","number":9,"content":["Biittafe beettiza go7ay ubbaassa; kawoykka ba hu7es hessafe go7ettees."]},{"type":"verse","number":10,"content":[{"text":"Bira siiqiza asas","poem":1},{"text":"biray gidi erenna;","poem":2},{"lineBreak":true},{"text":"dureteth koyza asi","poem":2},{"lineBreak":true},{"text":"duretidikka kalli erenna;","poem":2},{"lineBreak":true},{"text":"hessi ubbayka hada.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Aqotay dari dari bishin","poem":1},{"text":"mizay darees;","poem":2},{"lineBreak":true},{"text":"haaridaades ayfen be7oppe","poem":2},{"lineBreak":true},{"text":"hara aaza go7ay dizee?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ooso ooththiza asi guuth miikko,","poem":1},{"text":"daro miikko saro dhisko","poem":2},{"lineBreak":true},{"text":"dhiski aqees;","poem":2},{"lineBreak":true},{"text":"gido attiin dure as","poem":2},{"lineBreak":true},{"text":"dureteththi dhisko diggees.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Salo gufanththon keehi ceecesiza","poem":1},{"text":"iita miish ta be7adis;","poem":2},{"lineBreak":true},{"text":"hessika iita woden","poem":2},{"lineBreak":true},{"text":"bana maaddo giidi","poem":2},{"lineBreak":true},{"text":"asi guye yeggi dagasida miishshi","poem":2},{"lineBreak":true},{"text":"izaades meto;","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"woykko issi gaason","poem":2},{"lineBreak":true},{"text":"coo dhayza dureteththa.","poem":2},{"lineBreak":true},{"text":"Izi naa yelikkoka","poem":2},{"lineBreak":true},{"text":"he yelettidayssas","poem":2},{"lineBreak":true},{"text":"laatissiza miishshi deenna.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Asi ba aayi uloppe kallo","poem":1},{"text":"yelettida mala kallo bees;","poem":2},{"lineBreak":true},{"text":"ay keena daaburkkoka","poem":2},{"lineBreak":true},{"text":"izi ba daaburdayssafe","poem":2},{"lineBreak":true},{"text":"aykkoka ekkibeenna.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hessika keehippe iita;","poem":1},{"text":"asi ba yida mala simmi bees;","poem":2},{"lineBreak":true},{"text":"iza daabura ubbay","poem":2},{"lineBreak":true},{"text":"carko oykkiza mala","poem":2},{"lineBreak":true},{"text":"hada gidizaa gidikko","poem":2},{"lineBreak":true},{"text":"izas ay go7ay dizee?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Izi ba layth ubbaa ceecen, waayen,","poem":1},{"text":"yiilloninne dhuma","poem":2},{"lineBreak":true},{"text":"duussan wursees.","poem":2}]},{"type":"verse","number":18,"content":["Asa qaaday hessa gidida gishshas salo gufanththon Xoossi asi de7ana mala immida qaanththa layththa garsan asi ba daaburda daaburappe muussinne ushshi lo7onne bessizayssa gididayssa ta akeekadis."]},{"type":"verse","number":19,"content":["Xoossay asas dureteththinne aqo immizay ba daaburda waaga demmidi miidinne uyidi ufayettanaassa. Hessi Xoossafe izas imettida imota."]},{"type":"verse","number":20,"content":["Xoossay iza wozinan ubba wode ufays kunththi woththiza gishshas izi ba de7o layththas daro hirgenna."]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/ECC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/ECC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/ECC/4.json","previousChapterAudioLinks":{},"numberOfVerses":20}