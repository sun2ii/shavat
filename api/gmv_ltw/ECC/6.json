{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"ECC","translationId":"gmv_ltw","name":"Eranchchata Maxaafa","commonName":"Eranchchata Maxaafa","title":"Eranchchata Maxaafa","order":21,"numberOfChapters":12,"sha256":"59faecc0fcd64608468a17f7fb7b5d21ad19b8c41b9495ab6ef9f9b1ac64e040","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/gmv_ltw/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":["Salo gufanththon hara iita miish tani be7adis; hessika asas keehi deexo."]},{"type":"verse","number":2,"content":["Asi ba wozinan amottida miish demmana mala Xoossi asas aqota, dureteththinne bonchcho immees; gido attiin keeththaaway isttan ufayettana mala kumeththa maata izas immenna; izi daaburi demmidayssan haray ufayettees; hessika hadanne keehi iita miishsha."]},{"type":"verse","number":3,"content":["Issi asi xeetu nayta gakkanaas yeli cimmidi adussa layth de7anawu dandayees; gido attiin izi ba aqotan ufayettontta aggikonne hayqqidi wogara moogettontta aggiko izappe awucayay kiya."]},{"type":"verse","number":4,"content":["Gaasoykka coo hada yiidi dhuman bees; iza sunththika dhuman kamettides."]},{"type":"verse","number":5,"content":["Izi eronttanne poo7o be7ontta aggikokka he addezappe izas aadho woppay dees."]},{"type":"verse","number":6,"content":["Ufayssi baynda dishin nam7u shii layth de7ikkoka izas aaza go7ay dizee? Wurseththan nam7ayka issi soho baana deettennee?"]},{"type":"verse","number":7,"content":[{"text":"Asi daaburdi ooththiza","poem":1},{"text":"ubbay ulossa;","poem":2},{"lineBreak":true},{"text":"gido attiin iza amoy","poem":2},{"lineBreak":true},{"text":"mulekka kalli erenna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Histtiin aadho eranchchay","poem":1},{"text":"eeyappe aazan aadhdhizee?","poem":2},{"lineBreak":true},{"text":"Manqoy harata sinththan","poem":2},{"lineBreak":true},{"text":"waani simerettanaakko eroy","poem":2},{"lineBreak":true},{"text":"iza ay maaddizee?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Amon toylattanaappe","poem":1},{"text":"ayfen be7oy kiya;","poem":2},{"lineBreak":true},{"text":"hessika hadanne carko oykkanaas","poem":2},{"lineBreak":true},{"text":"yedeththiza mala","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ha7i diza ubbaas","poem":1},{"text":"kaseti sunththi","poem":2},{"lineBreak":true},{"text":"imetti uttides;","poem":2},{"lineBreak":true},{"text":"asi hananaazi eretti uttides;","poem":2},{"lineBreak":true},{"text":"asi baappe minnizayssara","poem":2},{"lineBreak":true},{"text":"baaxettenna.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Haasayay darshin","poem":1},{"text":"hada yo7oy darees;","poem":2},{"lineBreak":true},{"text":"histtiin hessi as ay go7anee?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hadanne eesho mala elle aadhdhiza","poem":1},{"text":"guuththa layththatan","poem":2},{"lineBreak":true},{"text":"asas lo7o miishshi hananayssa","poem":2},{"lineBreak":true},{"text":"erizay oonee?","poem":2},{"lineBreak":true},{"text":"Qasseka izi hayqqidaappe guye","poem":2},{"lineBreak":true},{"text":"salo gufanththon haniza miish","poem":2},{"lineBreak":true},{"text":"izas yootana dandayzay oonee?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/ECC/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/ECC/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/ECC/5.json","previousChapterAudioLinks":{},"numberOfVerses":12}