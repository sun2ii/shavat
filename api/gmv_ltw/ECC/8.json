{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"ECC","translationId":"gmv_ltw","name":"Eranchchata Maxaafa","commonName":"Eranchchata Maxaafa","title":"Eranchchata Maxaafa","order":21,"numberOfChapters":12,"sha256":"59faecc0fcd64608468a17f7fb7b5d21ad19b8c41b9495ab6ef9f9b1ac64e040","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/gmv_ltw/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"Yo7ota birshana dandayza","poem":1},{"text":"aadho eranchcha mala","poem":2},{"lineBreak":true},{"text":"asi oonee?","poem":2},{"lineBreak":true},{"text":"Yo7ota ubbaa birsheth","poem":2},{"lineBreak":true},{"text":"erizay oonee?","poem":2},{"lineBreak":true},{"text":"Aadho erateththi","poem":2},{"lineBreak":true},{"text":"asa ayfeso poo7isees;","poem":2},{"lineBreak":true},{"text":"xirphotida sinththika birshees.","poem":2}]},{"type":"heading","content":["Kawos Azazeteth"]},{"type":"verse","number":2,"content":["Ne kase Xoossaa sinththan caaqqida gishshas kawos azazetta."]},{"type":"verse","number":3,"content":["Kawo sinththafe eeson kezoppa; izi ba dosidayssa ooththanaas dandayza gishshas iita oosos zuppetoppa."]},{"type":"verse","number":4,"content":["Ubbaa miish ooththanaas kawos maatay diza gishshas, «Hayssa ays ooththay?» giidi iza oychchanaas dandayzay oonee?"]},{"type":"verse","number":5,"content":[{"text":"Izas azazettiza asi","poem":1},{"text":"ubbay qohettenna;","poem":2},{"lineBreak":true},{"text":"aadho erateththi diza wozinay","poem":2},{"lineBreak":true},{"text":"likke wodenne bessiza ooso oge","poem":2},{"lineBreak":true},{"text":"shaakki erees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"As metoy keehi un7eththikokka","poem":1},{"text":"ubbaa miishshaska","poem":2},{"lineBreak":true},{"text":"likke wodeynne","poem":2},{"lineBreak":true},{"text":"bessiza ooso ogey dees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sinththafe hananayssa","poem":1},{"text":"erizay deenna;","poem":2},{"lineBreak":true},{"text":"hessa gishshas","poem":2},{"lineBreak":true},{"text":"sinththafe hananayssa","poem":2},{"lineBreak":true},{"text":"yootanaas dandayzay oonee?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Asi ba shemppo","poem":1},{"text":"naagi ashshanaas dandayenna;","poem":2},{"lineBreak":true},{"text":"woykko ba hayqqana","poem":2},{"lineBreak":true},{"text":"gallassa bolla","poem":2},{"lineBreak":true},{"text":"maatay diza asi deenna;","poem":2},{"lineBreak":true},{"text":"ola gallas oonikka ola yeggidi","poem":2},{"lineBreak":true},{"text":"guye simmonttayssa mala","poem":2},{"lineBreak":true},{"text":"iita oosoykka","poem":2},{"lineBreak":true},{"text":"banara meezetidayta yeddenna.","poem":2}]},{"type":"heading","content":["Iita Asata Hanotanne Kiya Asata Hanota"]},{"type":"verse","number":9,"content":[{"text":"Salo gufanththon","poem":1},{"text":"haniza miish ubbaa","poem":2},{"lineBreak":true},{"text":"tani pilgga be7adis;","poem":2},{"lineBreak":true},{"text":"asi as qohanaas","poem":2},{"lineBreak":true},{"text":"daannatiza wodey dees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Qasse iitati bonchchon","poem":1},{"text":"moogettishininne","poem":2},{"lineBreak":true},{"text":"geeshsha kataman sabettishin,","poem":2},{"lineBreak":true},{"text":"Xoossa asati geeshsha kataman","poem":2},{"lineBreak":true},{"text":"dogettishin ta be7adis;","poem":2},{"lineBreak":true},{"text":"hessi ubbayka hada.","poem":2}]},{"type":"verse","number":11,"content":["Iita ooththida asa bolla eeson pirdontta aggiko asa wozinay iita ooththana halchchon kumees."]},{"type":"verse","number":12,"content":["Nagaranchchay xeetuto iita miish ooththishin iza layththay aduqqikokka, Xoossa bonchchizaytassinne Xoossa yayyizaytas lo7oy hananayssa ta erays."]},{"type":"verse","number":13,"content":["Gido attiin iitati Xoossas yayyontta gishshas lo7o miishshi isttas hanenna; istta layththi eesho mala elle aadhdhana."]},{"type":"verse","number":14,"content":["Sa7a bolla oosettiza haray hada miishshi dees; hessika xilloti iitatas bessiza qixaate, iitati xillotas bessiza lo7o miish ekkeettes. Heyti ubbayka hada."]},{"type":"verse","number":15,"content":["Salo gufanththon asas muussafe, ushshafenne ufayeteththafe aadhdhiza hara miishshi baynda gishshas ba de7o layththan ufayeteththi lo7o gadis; hessa gishshas Xoossi salo gufanththon izas immida layththatan izi ba ooson ufayettana."]},{"type":"verse","number":16,"content":["Tani aadho erateth eranaassinne asi ha sa7a bollan omarsinne gallas dhiskoy baynda daaburza daaburaa eranaas ta wozinan pilggadis."]},{"type":"verse","number":17,"content":["Hessafe guye Xoossi ooththida ubbaa be7adis; salo gufanththon oosettiza miish oonikka erenna; asi keehi dafettidi pilggi xeellikokka iza birsheththaa demmanaas dandayenna. Aadho eranchchay, «Ta erays» giikkoka ubbaa eranaas dandayenna."]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/ECC/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/ECC/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/ECC/7.json","previousChapterAudioLinks":{},"numberOfVerses":17}