{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"ECC","translationId":"gmv_ltw","name":"Eranchchata Maxaafa","commonName":"Eranchchata Maxaafa","title":"Eranchchata Maxaafa","order":21,"numberOfChapters":12,"sha256":"59faecc0fcd64608468a17f7fb7b5d21ad19b8c41b9495ab6ef9f9b1ac64e040","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/gmv_ltw/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":9,"content":[{"type":"heading","content":["Ubbaas Diza Wurseththa Qaada"]},{"type":"verse","number":1,"content":["Hessa gishshas ha ubbaa yo7ota ta wozinan qoppada aadho eranchchatinne xilloti ooththiza oosoy Xoossa kushenna; gido attiin asi sinththafe bana naagizayssi siiqo gidiin woykko ixo gidiin erenna."]},{"type":"verse","number":2,"content":["Xillota woykko nagaranchchata gidiin, suureta woykko iitata gidiin, geeshshata woykko tunata gidiin, yarsho shiishshizayta woykko yarsho shiishshonttayta gidiin ubbatasikka wurseththa qaaday issino.",{"text":"Lo7o asas hanzayssa mala","poem":2},{"lineBreak":true},{"text":"nagaranchchaska hanees;","poem":2},{"lineBreak":true},{"text":"caaqqizayssas","poem":2},{"lineBreak":true},{"text":"hanizayssa malakka","poem":2},{"lineBreak":true},{"text":"caaqos babbizaytas hanees.","poem":2}]},{"type":"verse","number":3,"content":["Salo gufanththon ubbaa bolla gakkiza iitateththi hayssa; ubbaas wurseththa qaaday issino; hessafe bollarakka asa wozinay iitateththan kumidessinne gooyides; wurseththankka hayqqida asan gayttees."]},{"type":"verse","number":4,"content":["Hayqqida gaammofe paxa diza kanay kiya; hessaththoka shemppora paxa dizayta giddon diza asas hidotay dees."]},{"type":"verse","number":5,"content":[{"text":"Shemppora paxa diza asi","poem":1},{"text":"ba hayqqanayssa erees;","poem":2},{"lineBreak":true},{"text":"gido attiin hayqqidayti","poem":2},{"lineBreak":true},{"text":"aykkoka erettenna;","poem":2},{"lineBreak":true},{"text":"istta qofsiza miishshi","poem":2},{"lineBreak":true},{"text":"ubbay dogettees;","poem":2},{"lineBreak":true},{"text":"istti go7ettana miishshika deenna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Istta siiqoy, ixoynne","poem":1},{"text":"qanaatey ubbay","poem":2},{"lineBreak":true},{"text":"isttara issife dhaydes.","poem":2},{"lineBreak":true},{"text":"Hessa gishshas salo gufanththon","poem":2},{"lineBreak":true},{"text":"haniza miish ubbaan","poem":2},{"lineBreak":true},{"text":"aykko qaadaykka isttas deenna.","poem":2}]},{"type":"verse","number":7,"content":["Baada ne kath ufayssan ma; ne woyne ushshaaka ne wozinay ufayettishin uya; ays giikko Xoossi ne ooththida ooson ufayettees."]},{"type":"verse","number":8,"content":["Ubbaa wode ne may7oy booth gido; ne hu7eykka zayten tiyetto."]},{"type":"verse","number":9,"content":["Salo gufanththon Xoossi nees immida guuth gidida ne de7o layththata ubbaan ne siiqiza ne machcheyra ufayssan de7a; ays giikko salo gufanththon ne de7oninne ne daaburda daabura ubbaan hayssi nees qaada."]},{"type":"verse","number":10,"content":["Ne kushey ooththanaas demmidayssa ubbaa ne kumeththa wolqqan ooththa; ays giikko neni baana duufon oosoy, halchchoy, erateththinne aadho erateththi deenna."]},{"type":"verse","number":11,"content":[{"text":"Tani salo gufanththon","poem":1},{"text":"hara miish be7adis;","poem":2},{"lineBreak":true},{"text":"woththan xoonoy pilatatas","poem":2},{"lineBreak":true},{"text":"olan xoonoy wolqqamatas gidenna;","poem":2},{"lineBreak":true},{"text":"kaththi aadho eranchchatas,","poem":2},{"lineBreak":true},{"text":"dureteththi kiphatanchchatas,","poem":2},{"lineBreak":true},{"text":"sabay eranchchatas gidenna;","poem":2},{"lineBreak":true},{"text":"gido attiin ubbatikka wodeynne","poem":2},{"lineBreak":true},{"text":"qaaday gaththida mala haneettes.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Qasseka ba wode eriza asi deenna;","poem":1},{"text":"kafoy yarden geliza mala,","poem":2},{"lineBreak":true},{"text":"moley giten oykettiza mala,","poem":2},{"lineBreak":true},{"text":"asikka qoppontta dishin yiza","poem":2},{"lineBreak":true},{"text":"iita wodetan oykettees.","poem":2}]},{"type":"heading","content":["Aadho Erateththinne Eeyateth"]},{"type":"verse","number":13,"content":["Hessaththoka tana keehi malalisida hayssa aadho leemiso salo gufanththon be7adis."]},{"type":"verse","number":14,"content":["Hessika issi biittan amarda asati de7iza qeeri katamay dawus; he katamayo olanaas issi wolqqama kawoy worajji dooddides; izi yuushon miixa giigsides."]},{"type":"verse","number":15,"content":["He katamayn aadho eranchcha gidida issi manqo asi dees; izi ba aadho erateththan he katamayo ashshides. Gido attiin he manqozas oonikka qoppibeenna."]},{"type":"verse","number":16,"content":["Hessa gishshas tani, «Aadho erateththi wolqqafe aadhdhees» gadis. Gidikkoka he manqozas diza aadho erateththazi kadhettides; iza qaalaykka siyettibeenna."]},{"type":"verse","number":17,"content":[{"text":"Eeyata ayssiza daanna waasoppe","poem":1},{"text":"aadho eranchchay","poem":2},{"lineBreak":true},{"text":"liiqon haasayza","poem":2},{"lineBreak":true},{"text":"qaalay seetettees.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Aadho erateththi","poem":1},{"text":"ola miishshafe aadhdhees;","poem":2},{"lineBreak":true},{"text":"gido attiin issi nagaranchchay","poem":2},{"lineBreak":true},{"text":"daro lo7o miish dhayssees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/ECC/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/ECC/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/ECC/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}