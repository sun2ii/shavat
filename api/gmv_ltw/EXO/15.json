]},{"type":"verse","number":4,"content":[{"text":"Gibxe kawo para-gaaretanne","poem":1},{"text":"iza olanchchata","poem":2},{"lineBreak":true},{"text":"abban wursides;","poem":2},{"lineBreak":true},{"text":"ubbaafe aadhdhi doorettida","poem":2},{"lineBreak":true},{"text":"Gibxe kawo halaqati,","poem":2},{"lineBreak":true},{"text":"Zo7o abbaan mitettida.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ciimma haaththi","poem":1},{"text":"istta kammides;","poem":2},{"lineBreak":true},{"text":"istti shuchchaththo","poem":2},{"lineBreak":true},{"text":"ciimman mitettida.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Abeet GODAWU!","poem":1},{"text":"Ne ushachcha kushey","poem":2},{"lineBreak":true},{"text":"wolqqan goobides;","poem":2},{"lineBreak":true},{"text":"GODAWU ne wolqqama","poem":2},{"lineBreak":true},{"text":"ushachcha","poem":2},{"lineBreak":true},{"text":"kushey morkke","poem":2},{"lineBreak":true},{"text":"menththereththides.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne gita wolqqaan","poem":1},{"text":"nenara eqettidayta","poem":2},{"lineBreak":true},{"text":"kundisadasa.","poem":2},{"lineBreak":true},{"text":"Eexxiza ne hanqo ne yeddadasa,","poem":2},{"lineBreak":true},{"text":"izikka istta","poem":2},{"lineBreak":true},{"text":"gafe mala mides.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne peenoy","poem":1},{"text":"haaththaa pude essi doorides.","poem":2},{"lineBreak":true},{"text":"Goggiza haaththika goda mala","poem":2},{"lineBreak":true},{"text":"minni eqqides;","poem":2},{"lineBreak":true},{"text":"ciimma giddon diza haaththi","poem":2},{"lineBreak":true},{"text":"abbaa giddon irkkides.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Morkkey ceeqettishe,","poem":1},{"text":"‹Tani istta yedeththa oykkana.","poem":2},{"lineBreak":true},{"text":"Tani istta haaro shaakkada,","poem":2},{"lineBreak":true},{"text":"ta koyidayssa ubbaa ekkana.","poem":2},{"lineBreak":true},{"text":"Tani ta giththa","poem":2},{"lineBreak":true},{"text":"mashsha shoddada,","poem":2},{"lineBreak":true},{"text":"istta dhayssana› gides.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gido attiin neni istta","poem":1},{"text":"ne peenon punniin,","poem":2},{"lineBreak":true},{"text":"abbay istta kammides.","poem":2},{"lineBreak":true},{"text":"Istti wolqqama haaththan","poem":2},{"lineBreak":true},{"text":"biratay mitettiza mala","poem":2},{"lineBreak":true},{"text":"mitettida.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Abeet GODAWU!","poem":1},{"text":"Eeqa xoossata giddon","poem":2},{"lineBreak":true},{"text":"ne malay oonee?","poem":2},{"lineBreak":true},{"text":"Geeshshateththan","poem":2},{"lineBreak":true},{"text":"bonchchettizay,","poem":2},{"lineBreak":true},{"text":"bonchchon babisizaynne,","poem":2},{"lineBreak":true},{"text":"malalisiza miish ooththizay","poem":2},{"lineBreak":true},{"text":"ne malay oonee?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Neni ne ushachcha","poem":1},{"text":"kushe piddisadasa,","poem":2},{"lineBreak":true},{"text":"biittayka istta mittides.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Ne wozzida ne asaa","poem":1},{"text":"wurontta ne siiqon","poem":2},{"lineBreak":true},{"text":"kaaleththadasa.","poem":2},{"text":"Neni ne wolqqan","poem":1},{"text":"istta ne aqiza","poem":2},{"lineBreak":true},{"text":"geeshsha soo gelththadasa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dere asay","poem":1},{"text":"hessa siyidi kokkorides.","poem":2},{"lineBreak":true},{"text":"Filisxeeme biitta asatakka","poem":2},{"lineBreak":true},{"text":"hirga miixay oykkides.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"He wode Eedoome biitta","poem":1},{"text":"halaqati dagammida.","poem":2},{"lineBreak":true},{"text":"Mo7aabe biitta haarizayti","poem":2},{"lineBreak":true},{"text":"hirgan kokkorida.","poem":2},{"lineBreak":true},{"text":"Kanaane dere asay","poem":2},{"lineBreak":true},{"text":"wuri seerides.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Abeet GODAWU!","poem":1},{"text":"Dagamaynne hirgay","poem":2},{"lineBreak":true},{"text":"istta oykkana.","poem":2},{"lineBreak":true},{"text":"Istti ne wolqqa","poem":2},{"lineBreak":true},{"text":"gitateth be7idi,","poem":2},{"lineBreak":true},{"text":"ne asay aadhdhana gakkanaas,","poem":2},{"lineBreak":true},{"text":"neni wozzida asay","poem":2},{"lineBreak":true},{"text":"aadhdhana gakkanaas,","poem":2},{"lineBreak":true},{"text":"shuchcha mala toletti eqqana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Neni istta ehada,","poem":1},{"text":"nees buzo biittan diza","poem":2},{"lineBreak":true},{"text":"zuma hu7en tokkana.","poem":2},{"lineBreak":true},{"text":"Abeet Mernaa Godoo,","poem":2},{"lineBreak":true},{"text":"he sohoy","poem":2},{"lineBreak":true},{"text":"neni nees deyanaas","poem":2},{"lineBreak":true},{"text":"ooththida sohokko.","poem":2},{"lineBreak":true},{"text":"Abeet GODAWU! He geeshsha sohoy","poem":2},{"lineBreak":true},{"text":"neni ne kushen","poem":2},{"lineBreak":true},{"text":"minththa essida sohokko.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"GODAY mernaappe","poem":1},{"text":"mernaa gakkanaas kawotana.»","poem":2}]},{"type":"verse","number":19,"content":["Gibxe kawo parati wuri, para-gaaretinne toga asati abbaan gelida wode GODAY istta bolla abba haaththaa guye zaari ehides; gido attiin Isra7eele asay abbaa giddora mela biitta bollara hemettidi pinnides."]},{"type":"heading","content":["Maarami Yeththa"]},{"type":"verse","number":20,"content":["Aaroone michcheya, nabe Maarama karabe ekkadus; maccassay wuri karabe baqqidi yexxishenne guppishe izo kaallides."]},{"type":"verse","number":21,"content":[{"text":"Maarama isttas mazamureza yexxashe,","poem":1},{"lineBreak":true},{"text":"«GODAY keehi dhoqqu dhoqqu","poem":1},{"text":"gida gishshas","poem":2},{"lineBreak":true},{"text":"izas yexxite.","poem":2},{"lineBreak":true},{"text":"Paranne para toggidayta","poem":2},{"lineBreak":true},{"text":"izi abban olides»","poem":2},{"lineBreak":true},{"text":"ga yexxadus.","poem":2}]},{"type":"heading","content":["Camo Haath"]},{"type":"verse","number":22,"content":["Hessafe guye Musey Isra7eele asaa Zo7o abbaafe pinththiin istti Shuura geetettiza bazzo bida. He bazzon istti haath demmontta heedzdzu gallas hemettida."]},{"type":"verse","number":23,"content":["Istti Maara geetettizaso gakkida wode Maara haaththi camo gidida gishshas uyana dandaybeettenna; hessa gishshas he sohoy Maara geetettides."]},{"type":"verse","number":24,"content":["Asaykka, «Nuni ay uyanee?» giidi Muse bolla zuuzumides."]},{"type":"verse","number":25,"content":["Musey GODAAS waassiin GODAY iza issi mith bessides; Musey he miththaa haaththaan yeggiin haaththay mal7ides. Heen GODAY isttas woganne maara kessidessinne istta paaccides."]},{"type":"verse","number":26,"content":["Izi isttas, «GODAA intte Xoossay yootizayssa intte lo7eththi siyikko, iza ayfe sinththan lo7o ooththiko, intte iza azazo wozinan woththi naagikko, iza wogaakka ubbaa naagikko, tani Gibxe asaa bolla ehida hargefe issaaka intte bolla ehikke; gaasoykka tani inttena paththiza GODAA» gides."]},{"type":"verse","number":27,"content":["Hessafe istti tammanne nam7u haaththa pulttotinne laappun tammu zamba miththati dizaso Eelaame yiidi heen haaththa doonan uttida."]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}