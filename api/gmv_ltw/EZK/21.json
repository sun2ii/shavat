{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"EZK","translationId":"gmv_ltw","name":"Hiziqeela Tinbite","commonName":"Hiziqeela Tinbite","title":"Hiziqeela Tinbite","order":26,"numberOfChapters":48,"sha256":"2eefb227badd1ff36f63e680da44999a8aabb75d854db2c8be047e1ace1b78fb","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/gmv_ltw/EZK/48.json","totalNumberOfVerses":1268},"chapter":{"number":21,"content":[{"type":"heading","content":["Pirdas Giigi Uttida Godaa Mashsha"]},{"type":"verse","number":1,"content":["GODAA qaalay taakko yiidi,"]},{"type":"verse","number":2,"content":["«Haysso asa nawu! Ne ayfeso gede Yerusalaamekko zaara; Xoossa Keeththa bolla qaala yoota; Isra7eele biitta bolla tinbite yoota."]},{"type":"verse","number":3,"content":["Isttas GODAY, ‹Ta ne bolla dendadis; tani ta mashsha koohoppe shoddada xillo asaanne iita asaa ne giddofe diggana."]},{"type":"verse","number":4,"content":["Xillonne wordo dhayssana ta mashshay dugehappe pudeha gakkanaas diza deraa ubbaa bolla koohoppe shodettana."]},{"type":"verse","number":5,"content":["Tani GODAY ta mashshaa kohozappe shoddidayssanne zaarada guye koohon guye gelththonttayssa asi ubbay erana.›"]},{"type":"verse","number":6,"content":["«Hessa gishshas haysso asa nawu! Meqqida wozinan camo oole oola."]},{"type":"verse","number":7,"content":["Istti nena, ‹Ays oolay?› gi oychchiko, neni, ‹Sinththara yiza iita wore gishshas oolays; wozina ubbay taahana; kushe ubbay doccana; shemppo ubbay poodhu gaana; gulbate ubbay haaxxana› ga yoota. Ubbaa Haariza GODAY, ‹Be7ite hessi yaananne polettana› gees» gides."]},{"type":"verse","number":8,"content":["GODAA qaalay taakko yiidi,"]},{"type":"verse","number":9,"content":[{"text":"«Haysso asa nawu! Tinbite yoota;","poem":1},{"text":"GODAY, ‹Mashsha! Mashsha,","poem":2},{"lineBreak":true},{"text":"leefettidanne qucettida mashsha!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Leefettiday siifanaas,","poem":1},{"text":"qucettiday wolqqanththa mala","poem":2},{"lineBreak":true},{"text":"phoollanaassa.","poem":2},{"lineBreak":true},{"text":"Histtiin hessi nuna","poem":2},{"lineBreak":true},{"text":"waani ufayssana dandayzee?","poem":2},{"lineBreak":true},{"text":"Iza mashshazi ta naaza","poem":2},{"lineBreak":true},{"text":"kawoteththa guufe","poem":2},{"lineBreak":true},{"text":"coo guufe mala kadhides.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kushen oykkana mala","poem":1},{"text":"mashshay qucettidi imettides;","poem":2},{"lineBreak":true},{"text":"wodhizayssi kushen oykkanaas","poem":2},{"lineBreak":true},{"text":"mashshay leefettidi imettides.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Haysso asa nawu!","poem":1},{"text":"Hayssi ta dere bolla","poem":2},{"lineBreak":true},{"text":"Isra7eele daannata","poem":2},{"lineBreak":true},{"text":"ubbaa bolla yides;","poem":2},{"lineBreak":true},{"text":"hessa gishshas yeehonne","poem":2},{"lineBreak":true},{"text":"waaso sissa;","poem":2},{"lineBreak":true},{"text":"istti ta derezara issife","poem":2},{"lineBreak":true},{"text":"mashshas imettida;","poem":2},{"lineBreak":true},{"text":"hessas ne gishshas ne tira icca.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tumappe paacey yaana;","poem":1},{"text":"iza mashshay kadhida","poem":2},{"lineBreak":true},{"text":"kawoteththa guufezas","poem":2},{"lineBreak":true},{"text":"wurseththi baynda","poem":2},{"lineBreak":true},{"text":"aggiko waananee?› gees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Ha7ikka asa nawu! Tinbite yoota;","poem":1},{"text":"ne kushekka baqqa.","poem":2},{"lineBreak":true},{"text":"Mashshay nam7uto woykko","poem":2},{"lineBreak":true},{"text":"heedzdzuto shoco;","poem":2},{"lineBreak":true},{"text":"hessika keehi wodhiza, siifizanne","poem":2},{"lineBreak":true},{"text":"ubbasora istta dooddi","poem":2},{"lineBreak":true},{"text":"oykkida mashsha.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wozina ubbay taahana mala,","poem":1},{"text":"kundizayti darana mala,","poem":2},{"lineBreak":true},{"text":"tani istta pengeta ubbaan","poem":2},{"lineBreak":true},{"text":"popol7u giza mashsha","poem":2},{"lineBreak":true},{"text":"woththadis.","poem":2},{"lineBreak":true},{"text":"Aayye ana, popol7u","poem":2},{"lineBreak":true},{"text":"gaana mala qucettides;","poem":2},{"lineBreak":true},{"text":"siifanaaska koohoppe","poem":2},{"lineBreak":true},{"text":"shodettides.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Haysso mashshazoo!","poem":1},{"text":"Ne qarattida baggara hadirsinne","poem":2},{"lineBreak":true},{"text":"ushach qanxxa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tanikka ta kushe baqqana;","poem":1},{"text":"ta hanqoyka irxxana gadis","poem":2},{"lineBreak":true},{"text":"tani GODAY» gides.","poem":2}]},{"type":"heading","content":["Baabiloone Kawoza Mashsha"]},{"type":"verse","number":18,"content":["GODAA qaalay taakko yiidi,"]},{"type":"verse","number":19,"content":["«Haysso asa nawu! Baabiloone kawoza mashshay yiza nam7u ogetan malata tuus essa. Nam7u ogetikka issi dereppe doommeettes. Katama efiza ogeti shaakettizason malata tuus essa."]},{"type":"verse","number":20,"content":["Amooneta katama Eraaba biza mashshaas issi ogezan malata tuus essa; qasse Yuhudanne gimbettida Yerusalaame katama biza mashshaas nam7anththo ogezan malata tuus essa."]},{"type":"verse","number":21,"content":["Baabiloone kawozi ba baanaaso maroththi demmanaas daggala ogetan eqqana; ba wondafeta qaaseththidi saama yeggana; ba eeqa xoossatakka zore oychchana; tire micci xeellana."]},{"type":"verse","number":22,"content":["Izi biidi gimbe penge laalliza durumata ehana mala, wodhanaas azazana mala, ceeqeteth sissana mala, gimbe pengeza laalliza durumata katamata pengen essana mala, biitta shiishshi doorana malanne miixata giigsana mala Yerusalaame saamay izas ushachcha kushen kezides."]},{"type":"verse","number":23,"content":["Hessika izara caaqettida asatas bala kaaleththo misatides. Izi gidikko istta qoho istta qofsana; istti di7i ekkidikka baana."]},{"type":"verse","number":24,"content":["«Hessa gishshas Ubbaa Haariza GODAY, ‹Intte ooththida miish ubbaan intte qonccera nagara ooththidi intte qohoza intte qofsida gishshassinne hessaththoka intte ooththida gishshas intte di7etti baana."]},{"type":"verse","number":25,"content":["« ‹Haysso genenne tuna gidida Isra7eele daannazoo! Ne qaxxayettiza wodey gakkides› gees; tunaninne iitateththan kumida Isra7eele daannazoo,"]},{"type":"verse","number":26,"content":["Ubbaa Haariza GODAY, ‹Ne hu7en diza goossaa birsha; ne kallachcha denththa. Hayssafe guye kaseyssa mala hanenna; ziqqi giday dhoqqu gaana; dhoqqu gidaykka ziqqi gaana."]},{"type":"verse","number":27,"content":["Bulasana! Bulasana! Aawateththi bessizaadey yaana gakkanaas iza beni mala hanukku; ta izas izo aaththa immana› gees."]},{"type":"verse","number":28,"content":["«Haysso asa nawu! Ubbaa Haariza GODAY nena Amooneta gishshassinne istta cashsha gishshas,",{"text":"‹Mashsha! Mashsha!","poem":2},{"lineBreak":true},{"text":"Wodhanaas shodettida","poem":2},{"lineBreak":true},{"text":"dhayssanaas qucettida,","poem":2},{"lineBreak":true},{"text":"wolqqanththa mala popol7u","poem":2},{"lineBreak":true},{"text":"gaana qucettida mashsha.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ne gishshas be7ida wordo ajjuutay,","poem":1},{"text":"nees yootettida","poem":2},{"lineBreak":true},{"text":"muurennoy diikkoka,","poem":2},{"lineBreak":true},{"text":"isttas gene xuu7ay kumishin,","poem":2},{"lineBreak":true},{"text":"istta barey gakkishin","poem":2},{"lineBreak":true},{"text":"siifettana bessiza iitata","poem":2},{"lineBreak":true},{"text":"qoodhe bolla wodhdhana.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Mashsha koohozan zaara;","poem":1},{"text":"ne medhettida biittan,","poem":2},{"lineBreak":true},{"text":"ne yelettida deren heen","poem":2},{"lineBreak":true},{"text":"ta ne bolla pirdana.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Tani ta hanqo ne bolla gussana;","poem":1},{"text":"tani ta hanqo tamaa","poem":2},{"lineBreak":true},{"text":"ne bolla eeththana;","poem":2},{"lineBreak":true},{"text":"iitateththan erettida","poem":2},{"lineBreak":true},{"text":"menxe iita asatas","poem":2},{"lineBreak":true},{"text":"ta nena aaththa immana.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Neni eeso mith gidana;","poem":1},{"text":"ne deren ne suuththi gukkana;","poem":2},{"lineBreak":true},{"text":"hayssafe guye nena qofsiza","poem":2},{"lineBreak":true},{"text":"miishshi deenna;","poem":2},{"lineBreak":true},{"text":"tani GODAY hayssa","poem":2},{"lineBreak":true},{"text":"yootadis› gees» gides.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/EZK/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/EZK/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/EZK/20.json","previousChapterAudioLinks":{},"numberOfVerses":32}