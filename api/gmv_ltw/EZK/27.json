{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"EZK","translationId":"gmv_ltw","name":"Hiziqeela Tinbite","commonName":"Hiziqeela Tinbite","title":"Hiziqeela Tinbite","order":26,"numberOfChapters":48,"sha256":"2eefb227badd1ff36f63e680da44999a8aabb75d854db2c8be047e1ace1b78fb","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/gmv_ltw/EZK/48.json","totalNumberOfVerses":1268},"chapter":{"number":27,"content":[{"type":"heading","content":["Xiroosis Zilalettida Zilas"]},{"type":"verse","number":1,"content":["GODAA qaalay taakko yiidi,"]},{"type":"verse","number":2,"content":["«Haysso asa nawu! Xiroosi gishshas zilala."]},{"type":"verse","number":3,"content":["Abban gelizaso pengen dizaarissinne daro abba gaxatan diza deretara zal7iza Xiroosis, Ubbaa Haariza GODAY,",{"text":"«Hanne Xiroosee!","poem":1},{"text":"‹Neni nena keehippe","poem":2},{"lineBreak":true},{"text":"lo7o› gadasa;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne zaway abba giddon dees;","poem":1},{"text":"nena ooththidayti keehi","poem":2},{"lineBreak":true},{"text":"lo7eththi ooththida.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne sanqqata ubbaa,","poem":1},{"text":"Sanireppe yida","poem":2},{"lineBreak":true},{"text":"xiiddan ooththida;","poem":2},{"lineBreak":true},{"text":"markabe tuussati","poem":2},{"lineBreak":true},{"text":"Libaanooseppe yida","poem":2},{"lineBreak":true},{"text":"zigappe giigida.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Baasaaneppe yida wolappe","poem":1},{"text":"markabe laaggiza miish ooththida;","poem":2},{"lineBreak":true},{"text":"Qophiroose zawappe yida","poem":2},{"lineBreak":true},{"text":"ziga miththaa,","poem":2},{"lineBreak":true},{"text":"danggarsa zaalen aleqessidi","poem":2},{"lineBreak":true},{"text":"ne wuygeza ooththida.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne Markabeza xibabey","poem":1},{"text":"Gibxe biitta laynoppe oosettides;","poem":2},{"lineBreak":true},{"text":"hessi nena bandira mala go7ides.","poem":2},{"lineBreak":true},{"text":"Salo misatizanne ochcha","poem":2},{"lineBreak":true},{"text":"teera misatiza","poem":2},{"lineBreak":true},{"text":"ne sharati Qophirooseppe yida.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Markabe sololissizayti","poem":1},{"text":"Sidoonappenne","poem":2},{"lineBreak":true},{"text":"Arwaadeppe yidayta;","poem":2},{"lineBreak":true},{"text":"hanne Xiroose,","poem":2},{"lineBreak":true},{"text":"ne markabe laaggizayti","poem":2},{"lineBreak":true},{"text":"loohida ne asata.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gebaaleppe loohida daannatinne","poem":1},{"text":"hiillanchchati","poem":2},{"lineBreak":true},{"text":"ne markabeta koolanaas","poem":2},{"lineBreak":true},{"text":"ne giddon deettes;","poem":2},{"lineBreak":true},{"text":"abba bollara biza markabetinne","poem":2},{"lineBreak":true},{"text":"markabe laaggizayti ubbay","poem":2},{"lineBreak":true},{"text":"heregettidi nenara zal7ettanaas","poem":2},{"lineBreak":true},{"text":"neekko yeettes.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Paarise, Luudenne Puuxe asati","poem":1},{"text":"wottadara gididi","poem":2},{"lineBreak":true},{"text":"ne olanchchata giddon","poem":2},{"lineBreak":true},{"text":"nena haggazeettes;","poem":2},{"lineBreak":true},{"text":"nees teema gidana mala","poem":2},{"lineBreak":true},{"text":"bantta gondallenne","poem":2},{"lineBreak":true},{"text":"bantta birata qoobe","poem":2},{"lineBreak":true},{"text":"ne godaa bolla kaqqida.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Arwaadenne Heleeke asati","poem":1},{"text":"ne gimbeta ubbasora","poem":2},{"lineBreak":true},{"text":"naageettes;","poem":2},{"lineBreak":true},{"text":"Gamaadeppe yida asati","poem":2},{"lineBreak":true},{"text":"ne gimbe giddon deettes;","poem":2},{"lineBreak":true},{"text":"istti bantta gondalle","poem":2},{"lineBreak":true},{"text":"ne gimbeza yuushon kaqqida;","poem":2},{"lineBreak":true},{"text":"ne puulateththaa","poem":2},{"lineBreak":true},{"text":"kumeth ooththida.","poem":2}]},{"type":"verse","number":12,"content":["«Keehi daro gidida ne dureteththa gaason Tarseesey nenara zal7en gayttadus; iza biranne birata, qorqoronne irsaase ehada ne shaqaceta laame ekkawus."]},{"type":"verse","number":13,"content":["«Yaawaaney, Tubaaleynne Mesheekey nenara issife zal7eettes; aylletanne xarqimalappe oosettida miishshata shaqacera laammeettes."]},{"type":"verse","number":14,"content":["«Beeti-Togarma asati caana parata, ola paratanne baqulota shaqacen laammeettes."]},{"type":"verse","number":15,"content":["«Erodoose",{"noteId":4},"asati zal7en nenara gayttida; daro haruro dereti ne shaqaceta danggarsa zaaleninne Zophe geetettiza miththan laammeettes."]},{"type":"verse","number":16,"content":["«Keehi daro gidida ne aqota gaason Aaraamey nenara zal7en gayttadus; ne shaqacekka beluren, ochcha teera misatiza carqqan, xibaben, lo7o laynon, heleloninne zo7o inqqun laammeettes."]},{"type":"verse","number":17,"content":["«Yuhudaynne Isra7eeleykka attontta nenara zal7en gayttida; istti Miniteppe yida gistte, malido, ees, zaytenne balasaane geetettiza dhalliza zayte ne shaqacezara laammeettes."]},{"type":"verse","number":18,"content":["«Ne daro dureteththanne ishalo duussa gaason Damasqo asati Helboone woyne ushshinne Zahaare dere dorsa iske shiishshidi nenara zal7ettida."]},{"type":"verse","number":19,"content":["«Oozeelen diza Daaneynne Girke asay ne dumma dumma miishshaa shammida; istti ne miishshaara laammanaas aleqettida birata, dumma dumma sawotanne qarafa ehida."]},{"type":"verse","number":20,"content":["«Dadaaney ne shaqace gilaasera laammawus."]},{"type":"verse","number":21,"content":["«Arabiya halaqatinne Qeedaare halaqati ubbay ne laggeta; istti laaqqa, dharshonne deyshe ehidi nenara zal7eettes."]},{"type":"verse","number":22,"content":["«Saaba zal7anchchatinne Eraa7ime zal7anchchati nenara zal7etteettes; doorettida qimame ubbaa, al7o shuchchinne worqqa shiishshidi shaqacen nenara zal7etteettes."]},{"type":"verse","number":23,"content":["«Kaaraane, Kaane, Edene, Saaba, Asoorenne Kilmaade zal7anchchati nenara zal7etteettes."]},{"type":"verse","number":24,"content":["Heytikka ne giya giddon lo7o may7o, salo misatiza kaabba, xibabe, hessaththoka birata qalamen phoollizanne minni dadettida sigaajja ehidi nenara zal7etteettes."]},{"type":"verse","number":25,"content":[{"text":"«Tarseese markabeti","poem":1},{"text":"ne shaqace caani caani efida;","poem":2},{"lineBreak":true},{"text":"neni abba giddon deexo caana","poem":2},{"lineBreak":true},{"text":"caanettada daasa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Markabe sololissizayti ciimma","poem":1},{"text":"abba giddon nena efida;","poem":2},{"lineBreak":true},{"text":"gido attiin arshey","poem":2},{"lineBreak":true},{"text":"mokkiza bagga carkoy","poem":2},{"lineBreak":true},{"text":"abba giddon","poem":2},{"lineBreak":true},{"text":"nena menththereththides.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Markabe daafay","poem":1},{"text":"ne bolla gakkiza gallas","poem":2},{"lineBreak":true},{"text":"ne aqotay, ne shaqaceynne","poem":2},{"lineBreak":true},{"text":"ne zal7e miishshay,","poem":2},{"lineBreak":true},{"text":"ne markabeza sololissizayti,","poem":2},{"lineBreak":true},{"text":"markabezan bizaytinne","poem":2},{"lineBreak":true},{"text":"markabe oosanchchati,","poem":2},{"lineBreak":true},{"text":"ne zal7anchchatinne","poem":2},{"lineBreak":true},{"text":"ne wottadarati ubbay,","poem":2},{"lineBreak":true},{"text":"markabezan dizayti ubbay,","poem":2},{"lineBreak":true},{"text":"duge ciimma abban mitettana.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ne markabe sololissizayti","poem":1},{"text":"waassishin,","poem":2},{"lineBreak":true},{"text":"abba gaxan dizayti","poem":2},{"lineBreak":true},{"text":"yarkiyarkeettes.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Markabe sololissizayti ubbay","poem":1},{"text":"bantta markabeta oli baana;","poem":2},{"lineBreak":true},{"text":"markabe sololissizaytinne","poem":2},{"lineBreak":true},{"text":"markaben dizayti ubbay","poem":2},{"lineBreak":true},{"text":"wodhdhidi abbaa gaxan eqqana.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Bantta qaala dhoqqu histtidi","poem":1},{"text":"camo yeeho nees yeekkana;","poem":2},{"lineBreak":true},{"text":"bantta hu7en gudulla qolidi","poem":2},{"lineBreak":true},{"text":"bidinththa bolla bululettana.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ne gishshas kayottidi","poem":1},{"text":"bantta hu7e bulusana;","poem":2},{"lineBreak":true},{"text":"maaqaka may7ana;","poem":2},{"lineBreak":true},{"text":"wozinappe ceecidi","poem":2},{"lineBreak":true},{"text":"camo yeeho nees yeekkana.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ne gishshas istti waassishe","poem":1},{"text":"yeekkana;","poem":2},{"lineBreak":true},{"text":"istti nees zilalishe,","poem":2},{"lineBreak":true},{"text":"‹Abban mitetti co7u giday,","poem":2},{"lineBreak":true},{"text":"Xiroose malay oonee?› gaana.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ne shaqacey","poem":1},{"text":"abbaafe pinni kezida wode,","poem":2},{"lineBreak":true},{"text":"daro dereta kalssaasa;","poem":2},{"lineBreak":true},{"text":"neni ne gita aqotaninne","poem":2},{"lineBreak":true},{"text":"ne shaqacezan biittan diza","poem":2},{"lineBreak":true},{"text":"kawoteththata duresadasa.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Ha7i gidikko ciimma haaththan","poem":1},{"text":"abba giddon meqeretta","poem":2},{"lineBreak":true},{"text":"kundadasa;","poem":2},{"lineBreak":true},{"text":"ne caanaynne caanettida","poem":2},{"lineBreak":true},{"text":"asay ubbay","poem":2},{"lineBreak":true},{"text":"nenara abban mitettida.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Abba gaxan de7iza asay ubbay","poem":1},{"text":"ne bolla gakkidayssa be7idi","poem":2},{"lineBreak":true},{"text":"dagammida.","poem":2},{"lineBreak":true},{"text":"Istta kawotikka hirgan kokkorida;","poem":2},{"lineBreak":true},{"text":"istta ayfesoy laamettides.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Hara kawoteththata giddon diza","poem":1},{"text":"zal7anchchati","poem":2},{"lineBreak":true},{"text":"ne bolla ay keena wayqidoo!","poem":2},{"lineBreak":true},{"text":"ne wurseththay","poem":2},{"lineBreak":true},{"text":"daganththizaaz gidides;","poem":2},{"lineBreak":true},{"text":"ne mernaas beettaka» gides.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Erodoose gizayssa hara hara birsheththati Dedaane geettes.","reference":{"chapter":27,"verse":15}}]},"thisChapterLink":"/api/gmv_ltw/EZK/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/EZK/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/EZK/26.json","previousChapterAudioLinks":{},"numberOfVerses":36}