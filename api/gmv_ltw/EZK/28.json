akka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Neni allagata kushen","poem":1},{"text":"ammanontta asata","poem":2},{"lineBreak":true},{"text":"hayqo mala hayqqana;","poem":2},{"lineBreak":true},{"text":"Ubbaa Haariza GODAY,","poem":2},{"lineBreak":true},{"text":"‹Tani hayssa yootadis›","poem":2},{"lineBreak":true},{"text":"gees» gides.","poem":2}]},{"type":"heading","content":["Xiroose Kawo Kundeth"]},{"type":"verse","number":11,"content":["Qasseka GODAA qaalay taakko yiidi,"]},{"type":"verse","number":12,"content":["«Haysso asa nawu! Xiroose kawo gishshas zilalashe Ubbaa Haariza GODAY nena,",{"lineBreak":true},{"text":"« ‹Aadho erateththan kumada,","poem":1},{"text":"kumeththa puulateth may7ada","poem":2},{"lineBreak":true},{"text":"neni asas tumu leemiso gidadasa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Neni Edenen,","poem":1},{"text":"Xoossa atakilte giddon de7adasa;","poem":2},{"lineBreak":true},{"text":"bonchcho shuchchazi issoy issoy","poem":2},{"lineBreak":true},{"text":"nena alleqissides;","poem":2},{"lineBreak":true},{"text":"isttika sardiyoone,","poem":2},{"lineBreak":true},{"text":"tophaaziyoonenne almaaze,","poem":2},{"lineBreak":true},{"text":"margide, iyasphidenne simpere,","poem":2},{"lineBreak":true},{"text":"belure, birillenne al7o inqqu;","poem":2},{"lineBreak":true},{"text":"ne may7otikka xolqiza","poem":2},{"lineBreak":true},{"text":"inqqunne worqqa;","poem":2},{"lineBreak":true},{"text":"hayti neni medhettida","poem":2},{"lineBreak":true},{"text":"gallas oosettida.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Neni naagiza","poem":1},{"text":"kirube gidada tiyettadasa;","poem":2},{"lineBreak":true},{"text":"hessas ta nena shuumadis;","poem":2},{"lineBreak":true},{"text":"neni kase geeshsha zumaan","poem":2},{"lineBreak":true},{"text":"Xoossayssan de7adasa;","poem":2},{"lineBreak":true},{"text":"tama mala shuchchata giddon","poem":2},{"lineBreak":true},{"text":"simerettadasa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Neni medhettida gallassafe doommiin,","poem":1},{"text":"iitateththi ne bolla","poem":2},{"lineBreak":true},{"text":"beettida gallas gakkanaas,","poem":2},{"lineBreak":true},{"text":"ne oge ubbaan","poem":2},{"lineBreak":true},{"text":"borey baynda de7adasa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ne zal7ey minnida gishshas,","poem":1},{"text":"makkallateththan kumadasa;","poem":2},{"lineBreak":true},{"text":"nagarakka ooththadasa.","poem":2},{"lineBreak":true},{"text":"Hessa gishshas ta nena","poem":2},{"lineBreak":true},{"text":"Xoossa zuma bollafe","poem":2},{"lineBreak":true},{"text":"kawushshada yedeththadis;","poem":2},{"lineBreak":true},{"text":"haysso naagiza kirubee!","poem":2},{"lineBreak":true},{"text":"ta nena tama misatiza","poem":2},{"lineBreak":true},{"text":"shuchchata giddofe kessadis.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ne puulateththaa gaason,","poem":1},{"text":"ne wozinay otorettides;","poem":2},{"lineBreak":true},{"text":"ne bonchcho gitateththaafe","poem":2},{"lineBreak":true},{"text":"dendidayssan,","poem":2},{"lineBreak":true},{"text":"ne aadho erateththaa tunisadasa;","poem":2},{"lineBreak":true},{"text":"hessa gishshas tani nena","poem":2},{"lineBreak":true},{"text":"duge biittan oladis;","poem":2},{"lineBreak":true},{"text":"hara kawota seeranaas","poem":2},{"lineBreak":true},{"text":"malata ooththadis.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ne nagaraninne ne cimo zal7e","poem":1},{"text":"daroppe dendidayssan,","poem":2},{"lineBreak":true},{"text":"ne goynniza keeththata","poem":2},{"lineBreak":true},{"text":"tunisadasa.","poem":2},{"lineBreak":true},{"text":"Hessa gishshas","poem":2},{"lineBreak":true},{"text":"tani tamay ne giddofe","poem":2},{"lineBreak":true},{"text":"kezana mala ooththadis;","poem":2},{"lineBreak":true},{"text":"izikka nena mides.","poem":2},{"lineBreak":true},{"text":"Nena be7iza ubbaa sinththan,","poem":2},{"lineBreak":true},{"text":"biitta bolla nena bidinth kessadis.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nena eriza kawoteththati ubbay,","poem":1},{"text":"ne bolla gakkidayssan dagammida.","poem":2},{"lineBreak":true},{"text":"Ne wurseththi","poem":2},{"lineBreak":true},{"text":"ceecissizaaz gidides;","poem":2},{"lineBreak":true},{"text":"hayssafe guye nees","poem":2},{"lineBreak":true},{"text":"de7oy deenna› gees» gides.","poem":2}]},{"type":"heading","content":["Sidoona Bolla Yootettida Tinbite"]},{"type":"verse","number":20,"content":["GODAA qaalay taakko yiidi,"]},{"type":"verse","number":21,"content":["«Haysso asa nawu! Ne ayfeso Sidoona bagga zaarada tinbite izi bolla yoota."]},{"type":"verse","number":22,"content":["Neni deraas Ubbaa Haariza GODAY nena, ‹Hanne Sidoona tani ne bolla dendadis;",{"text":"ne giddon tani bonchchettana;","poem":2},{"lineBreak":true},{"text":"qixaate tani izi bolla ehishin,","poem":2},{"lineBreak":true},{"text":"ta geeshshateththaaka","poem":2},{"lineBreak":true},{"text":"ta izi giddon qonccisishin,","poem":2},{"lineBreak":true},{"text":"tani GODAA gididayssa istti erana.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Tani izi bolla iita harge ehana;","poem":1},{"text":"izi ogetan suuththi gukkana mala","poem":2},{"lineBreak":true},{"text":"ta ooththana;","poem":2},{"lineBreak":true},{"text":"Ubbaa baggara yiza","poem":2},{"lineBreak":true},{"text":"mashshan siifettidayti,","poem":2},{"lineBreak":true},{"text":"izi giddon kundana;","poem":2},{"lineBreak":true},{"text":"hessafe guye","poem":2},{"lineBreak":true},{"text":"tani GODAA gididayssa","poem":2},{"lineBreak":true},{"text":"istti erana.","poem":2}]},{"type":"verse","number":24,"content":["« ‹Hayssafe guye Isra7eele asaa un7eththiza kindichchoynne caddiza agunth gidida shooroti istta yuushon deettenna; hessan tani Ubbaa Haariza GODAA gididayssa istti erana› gees» gides."]},{"type":"heading","content":["Isra7eele Asaa Anjjeteth"]},{"type":"verse","number":25,"content":["Ubbaa Haariza GODAY, «Ta Isra7eele deraa istti laalettida kawoteththata biittafe shiishshiza wode, kawoteththati xeellishin ta geeshshateththaa tani istta giddon qonccisana; hessafe guye istti tani ta aylle Yaaqoobes immida bantta biittan de7ana."]},{"type":"verse","number":26,"content":["Heen istti saron daana; keeththata keexxana; woyne tura tokkizasohota giigsana; istti kadhida shoorota ta qaxxayiza wode istti saron daana; hessafe guye tani GODAY istta Xoos gididayssa istti erana» gees."]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/EZK/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/EZK/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/EZK/27.json","previousChapterAudioLinks":{},"numberOfVerses":26}