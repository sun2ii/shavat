{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"EZK","translationId":"gmv_ltw","name":"Hiziqeela Tinbite","commonName":"Hiziqeela Tinbite","title":"Hiziqeela Tinbite","order":26,"numberOfChapters":48,"sha256":"2eefb227badd1ff36f63e680da44999a8aabb75d854db2c8be047e1ace1b78fb","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/gmv_ltw/EZK/48.json","totalNumberOfVerses":1268},"chapter":{"number":30,"content":[{"type":"heading","content":["Gibxe Bolla Yaana Qixaate"]},{"type":"verse","number":1,"content":["GODAA qaalay taakko yiidi,"]},{"type":"verse","number":2,"content":["«Haysso asa nawu! Hayssa mala gaada tinbite yoota: Ubbaa Haariza GODAY,",{"text":"« ‹Wu! Wuy› ga waassa;","poem":1},{"text":"‹He gallassays aayye ana!› ga.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gallassay matides!","poem":1},{"text":"GODAA gallassay gakkides!","poem":2},{"lineBreak":true},{"text":"He gallassay shaara gallassa;","poem":2},{"lineBreak":true},{"text":"kawoteththata ubbaas","poem":2},{"lineBreak":true},{"text":"bashsha gallassa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gibxe bolla olay yaana;","poem":1},{"text":"Tophphiya bollaka tuggay yaana.","poem":2},{"lineBreak":true},{"text":"Daroti Gibxen shuketti kundana;","poem":2},{"lineBreak":true},{"text":"izi aqotay bonqqettana;","poem":2},{"lineBreak":true},{"text":"izi yochchatikka laalettana.","poem":2}]},{"type":"verse","number":5,"content":["«Tophphiyaynne Puuxey, Luudeynne Arabey, Liibiyaynne caaqo qaala biitta asay Gibxera issife mashshan wurana."]},{"type":"verse","number":6,"content":[{"text":"«Ubbaa Haariza GODAY,","poem":1},{"text":"‹Gibxera zuppetizayti kundana;","poem":2},{"lineBreak":true},{"text":"iza otorettiza minoteththay dhayana;","poem":2},{"lineBreak":true},{"text":"Migidooleppe biidi","poem":2},{"lineBreak":true},{"text":"Asiwa gakkanaas,","poem":2},{"lineBreak":true},{"text":"istti mashshan hayqqana› gees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bula biittata giddon","poem":1},{"text":"istti aadhdhi bula gidana;","poem":2},{"lineBreak":true},{"text":"istta katamatikka","poem":2},{"lineBreak":true},{"text":"laalettida katamata giddofe","poem":2},{"lineBreak":true},{"text":"issaa gidana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tani Gibxen tama oyththiza wode,","poem":1},{"text":"izo maaddizayti ubbay","poem":2},{"lineBreak":true},{"text":"kundiza wode,","poem":2},{"lineBreak":true},{"text":"tani GODAA gididayssa","poem":2},{"lineBreak":true},{"text":"istti he wode erana.","poem":2}]},{"type":"verse","number":9,"content":["«He gallas ta qasttanneti markaben biidi badhdhi ga uttidasohoppe kessanaas Tophphiya daganththana; Gibxey dhuman mitettiza wode istta ceecey oykkana; tumappe he gallassay yaana»."]},{"type":"verse","number":10,"content":["Ubbaa Haariza GODAY,",{"text":"«Baabiloone kawo Nabukadanaxoore kushen","poem":1},{"text":"qooday baynda Gibxe dere asaa","poem":2},{"lineBreak":true},{"text":"ta dhayssana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kawoteththata ubbaafe","poem":1},{"text":"menxe iita gidida","poem":2},{"lineBreak":true},{"text":"izinne iza oosanchchati","poem":2},{"lineBreak":true},{"text":"biittayo dhayssanaas","poem":2},{"lineBreak":true},{"text":"yaana mala ooththana;","poem":2},{"lineBreak":true},{"text":"bantta mashsha","poem":2},{"lineBreak":true},{"text":"Gibxe bolla shoddidi","poem":2},{"lineBreak":true},{"text":"biittayo aha xalla histtana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abbaye shaafa tani melissana;","poem":1},{"text":"biittayokka iita asatas bayzana;","poem":2},{"lineBreak":true},{"text":"allagata kushen biittayonne","poem":2},{"lineBreak":true},{"text":"izin diza ubbaa ta bula histtana;","poem":2},{"lineBreak":true},{"text":"tani GODAY hayssa yootadis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Eeqa xoossata","poem":1},{"text":"ta dhayssana;","poem":2},{"lineBreak":true},{"text":"Memppisan diza misleta","poem":2},{"lineBreak":true},{"text":"ta dippi histtana;","poem":2},{"lineBreak":true},{"text":"hayssafe guye Gibxen","poem":2},{"lineBreak":true},{"text":"halaqatanay deenna;","poem":2},{"lineBreak":true},{"text":"biittay bolla","poem":2},{"lineBreak":true},{"text":"ta yashshateth kiittana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tani Phaxiroose biitta","poem":1},{"text":"bula histtana;","poem":2},{"lineBreak":true},{"text":"Xaanoose bolla tama yeddana;","poem":2},{"lineBreak":true},{"text":"Teebeese bolla qixaate yeggana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Gibxes miixa gidida","poem":1},{"text":"Siina bolla ta bashshaa gussana;","poem":2},{"lineBreak":true},{"text":"qooday baynda Teebeese asaa","poem":2},{"lineBreak":true},{"text":"ta dhayssana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tani Gibxe bolla tama eeththana;","poem":1},{"text":"Siiney ceecen bul7akettana;","poem":2},{"lineBreak":true},{"text":"Teebeesey dambalan mitettana;","poem":2},{"lineBreak":true},{"text":"Memppisay duuxxontta","poem":2},{"lineBreak":true},{"text":"ceece giddo gelana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Heeliyootenne","poem":1},{"text":"Buubastte naateththati","poem":2},{"lineBreak":true},{"text":"mashshan siifettana;","poem":2},{"lineBreak":true},{"text":"he katamatikka di7ettana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tani Gibxe qambara menththiza wode","poem":1},{"text":"Xaafinaasen gallassay qammana;","poem":2},{"lineBreak":true},{"text":"hessafe guye iza otorettida","poem":2},{"lineBreak":true},{"text":"izi minoteththay kundana;","poem":2},{"lineBreak":true},{"text":"iza shaaran kamettana;","poem":2},{"lineBreak":true},{"text":"izi gutatikka di7ettana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hessa gishshas ta Gibxe bolla","poem":1},{"text":"ta qixaate ehana;","poem":2},{"lineBreak":true},{"text":"isttika tani GODAA gididayssa","poem":2},{"lineBreak":true},{"text":"he wode erana» gides.","poem":2}]},{"type":"heading","content":["Gibxe Kawo Kundeth"]},{"type":"verse","number":20,"content":["Nuni di7ettida tammanne issinththa layththan, koyro aginan, laappunththa gallassan GODAA qaalay taakko yiidi,"]},{"type":"verse","number":21,"content":["«Haysso asa nawu! Tani Gibxe kawo qese menththadis; izi paxana mala iza qesey koolettibeenna; woykko izi mashsha oykki dandayana mala iza kushey maqqan koolettibeenna."]},{"type":"verse","number":22,"content":["Hessa gishshas Ubbaa Haariza GODAY, ‹Tani Gibxe kawo Paaroone bolla dendadis; izas paxa qesezaranne meqo qesezara nam7aa gaththa menththana; iza mashshay iza kusheppe kessi ekki wodhdhana mala ta ooththana."]},{"type":"verse","number":23,"content":["Tani Gibxe asaa kawoteththata giddon laallana; hara dereta giddonkka zerana."]},{"type":"verse","number":24,"content":["Tani Baabiloone kawo qese minththada ta mashshaaka iza oyththana. Gido attiin Paaroone qeseza ta menththana; izikka ba morkkeza sinththan iita madunxida asa mala toqqana."]},{"type":"verse","number":25,"content":["Baabiloone kawo qese ta minththana; gido attiin Paaroone qesey daaburana; tani ta mashshaa Baabiloone kawo kushen oyththiin izikka qaaththishin tani GODAA gididayssa istti erana."]},{"type":"verse","number":26,"content":["Ta Gibxeta kawoteththata giddon laallana; dereta giddonkka zerana; hessafe guye tani GODAA gididayssa istti he wode erana› gees» gides."]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/EZK/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/EZK/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/EZK/29.json","previousChapterAudioLinks":{},"numberOfVerses":26}