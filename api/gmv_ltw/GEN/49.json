:24,"content":[{"text":"Gido attiin Yaaqoobe","poem":1},{"text":"Godaa Xoossa wolqqan","poem":2},{"lineBreak":true},{"text":"iza heemmiza Isra7eele zaallan","poem":2},{"lineBreak":true},{"text":"iza wondafey minnides;","poem":2},{"lineBreak":true},{"text":"iza mino qeseykka","poem":2},{"lineBreak":true},{"text":"pilatides.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nena maaddiza ne aawa Xoossan","poem":1},{"text":"Ubbaa Dandayzayssaninne","poem":2},{"lineBreak":true},{"text":"nena anjjiza Xoossan","poem":2},{"lineBreak":true},{"text":"pude bollafe beettiza maadoninne","poem":2},{"lineBreak":true},{"text":"garsa biittafe beettizan anjjon","poem":2},{"lineBreak":true},{"text":"qasseka aayi uloppenne","poem":2},{"lineBreak":true},{"text":"dhanththafe beettiza anjjon","poem":2},{"lineBreak":true},{"text":"nena anjjana.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ne aawa anjjoy beni wodeppe","poem":1},{"text":"hanno gakkanaas","poem":2},{"lineBreak":true},{"text":"minni diza zumatappenne","poem":2},{"lineBreak":true},{"text":"mernaa zumata","poem":2},{"lineBreak":true},{"text":"ubbaafe aadhdhees.","poem":2},{"lineBreak":true},{"text":"Hessa gishshas hayssi","poem":2},{"lineBreak":true},{"text":"ha anjjoy wurikka Yooseefe gakko.","poem":2},{"lineBreak":true},{"text":"Ba ishata bolla halaqa gidida","poem":2},{"lineBreak":true},{"text":"Yooseefe bolla wodhdho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"«Biniyaamey bonqqiza","poem":1},{"text":"kana suyte mala.","poem":2},{"lineBreak":true},{"text":"Ba shankkatidayssa","poem":2},{"lineBreak":true},{"text":"maalado mees;","poem":2},{"lineBreak":true},{"text":"ba di7idayssa","poem":2},{"lineBreak":true},{"text":"omars gishereththees» gides.","poem":2}]},{"type":"verse","number":28,"content":["Hayti tammanne nam7u Isra7eele qommota; qasse istta aaway istta issaa issaa istta hano mala isttas bessiza anjjo hessaththo anjjides."]},{"type":"heading","content":["Yaaqoobe Hayqo"]},{"type":"verse","number":29,"content":["Hessafe guye izi isttas, «Tani ta aawatan gaaggana gays; tana Hiite as Efroone gaden diza gongolon, ta aawatara moogite."]},{"type":"verse","number":30,"content":["Hessika Kanaane biittan, Mamire achchan diza Makipheele geetettiza gongolo; hayssika Abrahaamey moogos Hiite as Efrooneppe gadaara gaththi shammida gongolo."]},{"type":"verse","number":31,"content":["Abrahaameynne iza machcheya Saaray heen moogettida; Yisaaqinne iza machcheya Irbiqaykka heen moogettida; tani qasse Liya heen moogadis."]},{"type":"verse","number":32,"content":["He gadezinne izan diza gongoloy Hiitetappe shamettidayssa» gi azazides."]},{"type":"verse","number":33,"content":["Yaaqoobey ba naytas azazo wursidaappe guye ba toho pude ba hiixan shiishshi ekkidi hayqqidi ba aawatan gaaggides."]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}