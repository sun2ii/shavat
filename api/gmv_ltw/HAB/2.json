"line_break"},{"type":"verse","number":4,"content":[{"text":"«Hekko izi otorettides;","poem":1},{"text":"iza amoy suure gidenna;","poem":2},{"lineBreak":true},{"text":"xillo asi gidikko ammanon dees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dureteththi","poem":1},{"noteId":0},{"text":"as baleththees;","poem":1},{"text":"otoranchchas mulekka","poem":2},{"lineBreak":true},{"text":"shemppoy deenna;","poem":2},{"lineBreak":true},{"text":"izi duufo mala yora;","poem":2},{"lineBreak":true},{"text":"wodhiza hayqo malakka","poem":2},{"lineBreak":true},{"text":"kalo erenna;","poem":2},{"lineBreak":true},{"text":"dere ubbaa","poem":2},{"lineBreak":true},{"text":"shiishsheessinne","poem":2},{"lineBreak":true},{"text":"di7i ekki bees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Histtiin hessa mala","poem":1},{"text":"asa bolla qidheninne","poem":2},{"lineBreak":true},{"text":"kadhen asay, ‹Ba kaysi ekkida","poem":2},{"lineBreak":true},{"text":"shaqaceza baas shiishshizaades,","poem":2},{"lineBreak":true},{"text":"genen duretizaades aayye ana!","poem":2},{"lineBreak":true},{"text":"Hessaththo ayde gakkanaas","poem":2},{"lineBreak":true},{"text":"shiishshanee?›","poem":2},{"lineBreak":true},{"text":"gi iza bolla miiccennee?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne acon yeggida asati","poem":1},{"text":"ne qoppontta ne bolla","poem":2},{"lineBreak":true},{"text":"dendettennee?","poem":2},{"lineBreak":true},{"text":"Istti beeggidi","poem":2},{"lineBreak":true},{"text":"nena daganththettenee?","poem":2},{"lineBreak":true},{"text":"Hessafe guye","poem":2},{"lineBreak":true},{"text":"ne istta kushen kundana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne daro dere miish","poem":1},{"text":"bonqqida gishshas","poem":2},{"lineBreak":true},{"text":"hankko bonqqettonttayti","poem":2},{"lineBreak":true},{"text":"nena bonqqana;","poem":2},{"lineBreak":true},{"text":"ne asa suuth gussadasa;","poem":2},{"lineBreak":true},{"text":"deraa, katamanne","poem":2},{"lineBreak":true},{"text":"izan dizayta wursa dhayssadasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Wordora baleththi ekkida","poem":1},{"text":"miishshan baas daana keeth","poem":2},{"lineBreak":true},{"text":"keexxizaadessinne","poem":2},{"lineBreak":true},{"text":"ba morkke kusheppe attanaas","poem":2},{"lineBreak":true},{"text":"ba keeth dhoqqasohon keexxizaades","poem":2},{"lineBreak":true},{"text":"aayye ana!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Daro asa shemppoy","poem":1},{"text":"dhayana mala qachchadasa;","poem":2},{"lineBreak":true},{"text":"ne keeththa bollanne","poem":2},{"lineBreak":true},{"text":"ne bolla dhayssizaaz ehadasa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gimbe giddon shuchchi waassees;","poem":1},{"text":"giddon goda eqqida miththatikka","poem":2},{"lineBreak":true},{"text":"izas zaaro immeettes.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Suuth gussidinne iita ooththidi","poem":1},{"text":"katama essizaytas aayye ana!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Asa oosoy ubbay","poem":1},{"text":"taman xuugettana mala","poem":2},{"lineBreak":true},{"text":"dereykka mela daaburana mala","poem":2},{"lineBreak":true},{"text":"GODAY Ubbaafe","poem":2},{"lineBreak":true},{"text":"Wolqqama Xoossay","poem":2},{"lineBreak":true},{"text":"ubbaa woththibeennee?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Abbay kumiza mala biittay","poem":1},{"text":"GODAA gitateth eron kumana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«Asa kalloteth beyanaas","poem":1},{"text":"ba laggeta ushshu","poem":2},{"lineBreak":true},{"text":"ushshizaadessinne","poem":2},{"lineBreak":true},{"text":"istti uyidi maththottana gakkanaas","poem":2},{"lineBreak":true},{"text":"woyne ushshu duuqqizaades","poem":2},{"lineBreak":true},{"text":"aayye ana!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Neni bonchcho gishshas yeellatana;","poem":1},{"text":"hessika ha7i taray nees gidida","poem":2},{"lineBreak":true},{"text":"gishshas uyada gandigara;","poem":2},{"lineBreak":true},{"text":"ne kallotta.","poem":2},{"lineBreak":true},{"text":"GODAA ushachcha kushen diza","poem":2},{"lineBreak":true},{"text":"hanqo xuu7ay ne bolla simmana;","poem":2},{"lineBreak":true},{"text":"kase nees diza bonchchoza","poem":2},{"lineBreak":true},{"text":"kawushshateththan laammana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ne Libaanoose bolla","poem":1},{"text":"ooththida geney","poem":2},{"lineBreak":true},{"text":"nena mittana;","poem":2},{"lineBreak":true},{"text":"neni medosata dhayssidayssi","poem":2},{"lineBreak":true},{"text":"zaari nena daganththana;","poem":2},{"lineBreak":true},{"text":"hessika ne asa suuth gussida","poem":2},{"lineBreak":true},{"text":"gishshassinne","poem":2},{"lineBreak":true},{"text":"dereta, katamatanne","poem":2},{"lineBreak":true},{"text":"isttan dizayta","poem":2},{"lineBreak":true},{"text":"ne ubbaa dhayssida gishshassa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«Asa kushey massi giigsida eeqanne","poem":1},{"text":"wordo haasayza misles","poem":2},{"lineBreak":true},{"text":"ay go7ay dizee?","poem":2},{"lineBreak":true},{"text":"Histtiin iza ooththidaadey","poem":2},{"lineBreak":true},{"text":"barkka ba ooson ammanettiza","poem":2},{"lineBreak":true},{"text":"gishshassinne","poem":2},{"lineBreak":true},{"text":"isttika haasayanaas dandayontta","poem":2},{"lineBreak":true},{"text":"eeqa ooththiza gishshassa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Miththaa, ‹Ne beegga!›","poem":1},{"text":"Shemppoy baynda shuchchaaka,","poem":2},{"lineBreak":true},{"text":"‹Ne denda!› gizaades aayye ana!","poem":2},{"lineBreak":true},{"text":"Tumukka izi tamaarsana","poem":2},{"lineBreak":true},{"text":"dandayzee?"