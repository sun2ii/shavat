":"Tani intte giddon diza Geeshsha","poem":1},{"text":"Xoossa attiin as gidikke.","poem":2},{"lineBreak":true},{"text":"Ta hanqora intte intteko yiikke;","poem":2},{"lineBreak":true},{"text":"ta bosha hanqo","poem":2},{"lineBreak":true},{"text":"intte bolla yeddike;","poem":2},{"lineBreak":true},{"text":"Efreeme zaarada dhayssike.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Tani GODAY istta ashshanaas","poem":1},{"text":"xaaggiza gaammo mala","poem":2},{"lineBreak":true},{"text":"tani ta qaala sissishin","poem":2},{"lineBreak":true},{"text":"istti tana kaallana;","poem":2},{"lineBreak":true},{"text":"ta nayti kokkorishe","poem":2},{"lineBreak":true},{"text":"arshey mokkiza baggafe yaana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gibxeppe kafo mala","poem":1},{"text":"Asooreppe haraphphe mala","poem":2},{"lineBreak":true},{"text":"piradhdhi yaana.","poem":2},{"lineBreak":true},{"text":"Tani istta isttasohon","poem":2},{"lineBreak":true},{"text":"woththana» gees.","poem":2}]},{"type":"heading","content":["Isra7eele Nagaranne Yuhuda Nagara"]},{"type":"verse","number":12,"content":["GODAY, «Efreeme wordon",{"text":"Isra7eeleykka genen","poem":2},{"lineBreak":true},{"text":"tana giddoththides;","poem":2},{"lineBreak":true},{"text":"Yuhuday Xoossas","poem":2},{"lineBreak":true},{"text":"haarettonttaade;","poem":2},{"lineBreak":true},{"text":"ammanettida Geeshshazara","poem":2},{"lineBreak":true},{"text":"eqettizaade» gees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}