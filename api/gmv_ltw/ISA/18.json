xt":"iza dere shaakki biza","poem":2},{"lineBreak":true},{"text":"kawoteththaako biite.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Intteno sa7a bolla diza as ubbatoo!","poem":1},{"text":"zumata bolla malatay kaqettishin","poem":2},{"lineBreak":true},{"text":"intte be7ana;","poem":2},{"lineBreak":true},{"text":"zayey punettishin intte siyana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"GODAY taas, «Ta co7u ga uttana;","poem":1},{"text":"seeta gallas awa seelan","poem":2},{"lineBreak":true},{"text":"xolqettiza misha mala","poem":2},{"lineBreak":true},{"text":"bone hombe mala,","poem":2},{"lineBreak":true},{"text":"shaarappe bukkiza","poem":2},{"lineBreak":true},{"text":"ira mala gidada","poem":2},{"lineBreak":true},{"text":"ta xeellana» gides.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kath maxiza wodeppe kase","poem":1},{"text":"ciishsha wodey aadhdhishin,","poem":2},{"lineBreak":true},{"text":"ciishshay gakkidi woyney","poem":2},{"lineBreak":true},{"text":"ayfe ayfana gishin,","poem":2},{"lineBreak":true},{"text":"woyne bolla diza","poem":2},{"lineBreak":true},{"text":"koshshonttayssa xunqqana;","poem":2},{"lineBreak":true},{"text":"daayida haggatakka","poem":2},{"lineBreak":true},{"text":"qanxxereththi diggana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Istti ubbayka zuma bolla diidi","poem":1},{"text":"baqqi miza kafotassinne","poem":2},{"lineBreak":true},{"text":"bazzo do7atas attana;","poem":2},{"lineBreak":true},{"text":"kafoti bone kumeth","poem":2},{"lineBreak":true},{"text":"mishe shaaccana;","poem":2},{"lineBreak":true},{"text":"bazzo do7ati balgo ubbaan","poem":2},{"lineBreak":true},{"text":"mishe shaaccana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"He wode GODAAS","poem":1},{"text":"Ubbaafe Wolqqama","poem":2},{"lineBreak":true},{"text":"Xoossaas adussanne","poem":2},{"lineBreak":true},{"text":"liiqo asaappe,","poem":2},{"lineBreak":true},{"text":"matappe haahoppe","poem"