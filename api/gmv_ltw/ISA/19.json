{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"ISA","translationId":"gmv_ltw","name":"Isayaasa Tinbite","commonName":"Isayaasa Tinbite","title":"Isayaasa Tinbite","order":23,"numberOfChapters":66,"sha256":"d074f522a3282bfda9b9144056654f45f094b00e7d7ec2af7b7fb3050350602a","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gmv_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":19,"content":[{"type":"heading","content":["Gibxe Bolla Yootettida Tinbite"]},{"type":"verse","number":1,"content":["Gibxe gishshas yootettida qaalay,",{"text":"«Be7ite, GODAY eesotiza shaara","poem":1},{"text":"toggidi Gibxe yees.","poem":2},{"lineBreak":true},{"text":"Gibxe eeqa xoossati","poem":2},{"lineBreak":true},{"text":"iza sinththan kokkoreettes;","poem":2},{"lineBreak":true},{"text":"Gibxe wozinay","poem":2},{"lineBreak":true},{"text":"istta giddon seerees» gees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«Tani Gibxeta","poem":1},{"text":"issaa issaa bolla denththana;","poem":2},{"lineBreak":true},{"text":"ishay ishara, shooroy shoorora,","poem":2},{"lineBreak":true},{"text":"katamay katamara,","poem":2},{"lineBreak":true},{"text":"kawoy kawora olettana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gibxeta wozinay labettana;","poem":1},{"text":"tani istta halchcho","poem":2},{"lineBreak":true},{"text":"hada ooththana.","poem":2},{"lineBreak":true},{"text":"Istta eeqa xoossatanne moytilleta,","poem":2},{"lineBreak":true},{"text":"tuna ayana xeygizaytanne","poem":2},{"lineBreak":true},{"text":"marota zore oychchana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Qasse menxe iita asa kushen","poem":1},{"text":"ta Gibxeta aaththa immana;","poem":2},{"lineBreak":true},{"text":"babisiza kawoy","poem":2},{"lineBreak":true},{"text":"istta haarana» gees","poem":2},{"lineBreak":true},{"text":"GODAY, Ubbaafe","poem":2},{"lineBreak":true},{"text":"Wolqqama Xoossay.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Abbaye shaafa haaththi paccana;","poem":1},{"text":"haaththi guuxxi guuxxi melana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Zara haaththati xinqqana;","poem":1},{"text":"Gibxe kanchcheti micci dhayana;","poem":2},{"lineBreak":true},{"text":"shaccatinne care","poem":2},{"lineBreak":true},{"text":"maatati shullana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abbaye shaafa lanqen","poem":1},{"text":"haaththa matan diza","poem":2},{"lineBreak":true},{"text":"miththati shullana;","poem":2},{"lineBreak":true},{"text":"shaafaa matan zerettida","poem":2},{"lineBreak":true},{"text":"kath ubbay","poem":2},{"lineBreak":true},{"text":"carkon pitetti dhayana;","poem":2},{"lineBreak":true},{"text":"aykkoyka attenna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mole oykkizayti ceecana;","poem":1},{"text":"Abbaye shaafan","poem":2},{"lineBreak":true},{"text":"gaattile yeggizayti","poem":2},{"lineBreak":true},{"text":"ubbay yeekkana;","poem":2},{"lineBreak":true},{"text":"haaththa bolla bantta","poem":2},{"lineBreak":true},{"text":"gite yeggizayta","poem":2},{"lineBreak":true},{"text":"ubbaa wolqqay ixxana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Paatettida talbba","poem":1},{"text":"suqizayti dhayana;","poem":2},{"lineBreak":true},{"text":"qasse booththa puuttofe","poem":2},{"lineBreak":true},{"text":"may7o dadizayti","poem":2},{"lineBreak":true},{"text":"hidota qanxxana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"May7o dadizayti ceecana;","poem":1},{"text":"damozan aqizayta","poem":2},{"lineBreak":true},{"text":"wozinay meqqana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Xaanoose biitta halaqati keehi eeya;","poem":1},{"text":"aadho eranchcha gidida","poem":2},{"lineBreak":true},{"text":"kawo Paaroone aadho eranchchata","poem":2},{"lineBreak":true},{"text":"zorey hada.","poem":2},{"text":"Paaroones, «Tani aadho","poem":1},{"text":"eranchchatappe issaa;","poem":2},{"lineBreak":true},{"text":"tani kase kawota kaallizaade»","poem":2},{"lineBreak":true},{"text":"waanidi geetii?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Intte aadho eranchchati","poem":1},{"text":"ha7i awan dizoo?","poem":2},{"lineBreak":true},{"text":"Ubbaafe Wolqqama GODAY","poem":2},{"lineBreak":true},{"text":"Gibxe bolla ooththana qoppidayssa","poem":2},{"lineBreak":true},{"text":"ane inttena bessettonne erisetto.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Xaanoose halaqati eeyda;","poem":1},{"text":"Memppisa shuumeti balettida;","poem":2},{"lineBreak":true},{"text":"izi dere kaaleththiza erettidayti","poem":2},{"lineBreak":true},{"text":"Gibxe asaa baleththida.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"GODAY istta bolla","poem":1},{"text":"dochchiza ayana gussides;","poem":2},{"lineBreak":true},{"text":"maththottida asi ba cooshshan","poem":2},{"lineBreak":true},{"text":"gandigarza mala","poem":2},{"lineBreak":true},{"text":"Gibxey ba ooso ubbaan","poem":2},{"lineBreak":true},{"text":"gandigarana mala ooththida.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kace woykko goyna,","poem":1},{"text":"zamba woykko shacca","poem":2},{"lineBreak":true},{"text":"heyti ubbay","poem":2},{"lineBreak":true},{"text":"Gibxes aykkoka maadettenna.","poem":2}]},{"type":"verse","number":16,"content":["He wode Gibxe asay maccassa mala gidana. Qasse Ubbaafe Wolqqama GODAY istta bolla ba qese denththiza wode istti yashshan kokkorana."]},{"type":"verse","number":17,"content":["Yuhuda asay Gibxe asaa bolla shiro denththeththana; Ubbaafe Wolqqama GODAY istta bollan ooththana halchchida halchchofe dendidayssan Yuhuda gishshas siyida ubbay shirotana."]},{"type":"verse","number":18,"content":["He wode Gibxe biittan diza ichchash katamati Kanaane qaalan haasayana; Ubbaafe Wolqqama GODAA bagga gidanaas caaqqana. He katamatappe issiniya Bashsha Katama geetetta xeygettana."]},{"type":"verse","number":19,"content":["He wode Gibxe biittan GODAAS yarshosoy oosettana; qasse Gibxe biitta zawan GODAAS tuussi eqqana."]},{"type":"verse","number":20,"content":["Hessi Ubbaafe Wolqqama GODAAS Gibxe biittan malatanne markka gidana; istti banttana un7eththizaytappe dendidayssan GODAAKKO waassiza wode izi istta ashshizaadenne maaddizaade kiittidi istta ashshana."]},{"type":"verse","number":21,"content":["GODAY bana Gibxetas qonccisana; isttika he gallas GODAA erana; yarshoninne kaththa yarshon iza goynnana. Istti GODAAS adinettana; ba adinettidayssaka gaththana."]},{"type":"verse","number":22,"content":["GODAY Gibxe boshan shocana; zaaridikka istta paththana; isttika GODAAKKO simmana; izikka istta woosa siyidi istta paththana."]},{"type":"verse","number":23,"content":["He wode Gibxeppe Asoore gakkanaas wogga ogey oosettana; Asooreti Gibxe, Gibxe asay Asoore baana; qasse Gibxetinne Asooreti issi bolla goynnana."]},{"type":"verse","number":24,"content":["He wode Isra7eeley biittas anjjo gidanaas heedzdzanththo maaran Gibxeranne Asoorera issife qoodettana."]},{"type":"verse","number":25,"content":["Ubbaafe Wolqqama GODAY isttas, «Ta dere Gibxey, ta kushey medhdhida Asoorey, ta xinxxo Isra7eeley anjjettidayta gidetto» gi anjjana."]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/ISA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/ISA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/ISA/18.json","previousChapterAudioLinks":{},"numberOfVerses":25}