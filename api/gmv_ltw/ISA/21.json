paratan","poem":1},{"text":"gooshettiza para-gaaretan yides;","poem":2},{"lineBreak":true},{"text":"histtidi, ‹Baabilooney","poem":2},{"lineBreak":true},{"text":"kundadus! Kundadus!","poem":2},{"lineBreak":true},{"text":"izi eeqa xoossa misletikka","poem":2},{"lineBreak":true},{"text":"meqeretti gaden kundida›","poem":2},{"lineBreak":true},{"text":"gi zaarides» gi waassides.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Balen bukettida ta derezoo!","poem":1},{"text":"Ubbaafe Wolqqama GODAA","poem":2},{"lineBreak":true},{"text":"Isra7eele Xoossafe","poem":2},{"lineBreak":true},{"text":"ta siyida qaala nees yootays.","poem":2}]},{"type":"heading","content":["Eedoome Bolla Yootettida Tinbite"]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Eedoome gishshas yootettida","poem":1},{"text":"mino yo7o;","poem":2},{"lineBreak":true},{"text":"issi asi Seyreppe","poem":2},{"lineBreak":true},{"text":"tana xeygidi «Naagizayssoo!","poem":2},{"lineBreak":true},{"text":"Gadey wonttanaas","poem":2},{"lineBreak":true},{"text":"ay keena saatey attidee?","poem":2},{"lineBreak":true},{"text":"Naagizayssoo! Gadey wonttanaas","poem":2},{"lineBreak":true},{"text":"ay keena saatey attidee?» gides.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Naagizayssi zaaridi, «Wonttana;","poem":1},{"text":"gido attiin simmidi qammana;","poem":2},{"lineBreak":true},{"text":"oychchana koykko oychchite;","poem":2},{"lineBreak":true},{"text":"gido attiin simmidi","poem":2},{"lineBreak":true},{"text":"haa yiite» gides.","poem":2}]},{"type":"heading","content":["Arabe Bolla Yootettida Tinbite"]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Arabe gishshas yootettida mino yo7o;","poem":1},{"text":"Intteno Dadaane zal7anchchatoo!","poem":2},{"lineBreak":true},{"text":"intte intte caana","poem":2},{"lineBreak":true},{"text":"gaamellatara Arabe bazzon aqana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Saamettidaytas haa