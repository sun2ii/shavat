1,"content":[{"text":"Kase gal7a eele haaththaa zaaridi,","poem":1},{"text":"iza minjjizaso nam7u gimbetappe","poem":2},{"lineBreak":true},{"text":"giddon giigsideta.","poem":2},{"text":"Gido attiin intte hessa ooththiday","poem":1},{"text":"oonakko eribeekketa;","poem":2},{"lineBreak":true},{"text":"koyro halchchi","poem":2},{"lineBreak":true},{"text":"ooththidayssa akeekibeekketa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"He gallas","poem":1},{"text":"GODAY Ubbaafe Wolqqama Xoossay","poem":2},{"lineBreak":true},{"text":"intte yeekkana malanne","poem":2},{"lineBreak":true},{"text":"waassana mala,","poem":2},{"lineBreak":true},{"text":"intte hu7e binana","poem":2},{"lineBreak":true},{"text":"buucana malanne","poem":2},{"lineBreak":true},{"text":"maaqa may7ana mala xeygides.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gido attiin injjenne ufays,","poem":1},{"text":"booranne dharsho shukay,","poem":2},{"lineBreak":true},{"text":"asho muussinne","poem":2},{"lineBreak":true},{"text":"woyne ushshi dees;","poem":2},{"lineBreak":true},{"text":"«Nuni wonto hayqqana gishshas","poem":2},{"lineBreak":true},{"text":"ane moossinne uyoos» gideta.","poem":2}]},{"type":"verse","number":14,"content":["GODAY Ubbaafe Wolqqama Xoossay hayssafe kaallizayssa taas qonccisides; izakka ta hayththan siyadis; «Hayssi ha nagarazi intte hayqqana gakkanaas wursiin wurenna.»"]},{"type":"verse","number":15,"content":[{"text":"GODAY, GODAY Ubbaafe","poem":1},{"text":"Wolqqama Xoossay,","poem":2},{"lineBreak":true},{"text":"«Baada kawo keeththa","poem":2},{"lineBreak":true},{"text":"alaafe Sheebina,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hayssan ay ooththay?","poem":1},{"text":"Hayssa nees duufo giigsanaas,","poem":2},{"lineBreak":true},{"text":"dhoqqasohon ne moogettanaaso","poem":2},{"lineBreak":true},{"text":"woocanaas, ne ahay","poem":2},{"lineBreak":true},{"text":"uttanaaso zaalla woocanaas","poem":2},{"lineBreak":true},{"text":"ooni nena azazidee?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Haysso mino addezoo! Naagetta;","poem":1},{"text":"GODAY nena minththi oykkidi","poem":2},{"lineBreak":true},{"text":"ba kushen cuucumi oykkidi","poem":2},{"lineBreak":true},{"text":"olana hanees.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nena yanbarsha mala yuushshidi","poem":1},{"text":"aako biittan olana;","poem":2},{"lineBreak":true},{"text":"ne godaa keeththas","poem":2},{"lineBreak":true},{"text":"ne yeella gidadasa;","poem":2},{"lineBreak":true},{"text":"ne heen hayqqana;","poem":2},{"lineBreak":true},{"text":"ne bonchcho para-gaaretikka","poem":2},{"lineBreak":true},{"text":"heen attana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ne bonchchettidasoppe","poem":1},{"text":"ta nena kawushshana;","poem":2},{"lineBreak":true},{"text":"alaafeteththaafekka","poem":2},{"lineBreak":true},{"text":"ne goodettana» ga.","poem":2}]},{"type":"verse","number":20,"content":["«He gallas tani Kilqiyaasa naa ta ashkara Elyaaqeeme xeygana."]},{"type":"verse","number":21,"content":["Ne seeloza ta iza mayzana; ne giththaa iza gixissana; ne daannateththaaka ta izas aaththa immana. Izi Yerusalaamen diza asaassinne Yuhuda asaas aawa gidana."]},{"type":"verse","number":22,"content":["Tani Dawite keeththa qulpe iza hashen woththana; izi doyiin oonikka gordenna; izi gordiin oonikka doyenna."]},{"type":"verse","number":23,"content":["Tani iza ammanettizasohon dhishke mala essana; izi ba aawa keeththas bonchcho araata gidana."]},{"type":"verse","number":24,"content":["Qeeri xaaroppe biidi baath gakkanaas soon diza miish ubbaa kocan kaqqiza mala iza aawa keeththa bonchcho ubbay naytappe biidi naa naa gakkanaas iza bolla qaaphettana» gides."]},{"type":"verse","number":25,"content":["GODAY Ubbaafe Wolqqama Xoossay, «He gallas ammanththizason eqqida dhishkey shodettana; meqqi wodhdhana; iza bolla kaqettida ubbay kundidi meqerettana» gides; hayssa GODAY yootides."]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/ISA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/ISA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/ISA/21.json","previousChapterAudioLinks":{},"numberOfVerses":25}