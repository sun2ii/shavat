,"poem":2},{"lineBreak":true},{"text":"tamay istta mo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abeet GODAWU!","poem":1},{"text":"Neni nuus saroteth","poem":2},{"lineBreak":true},{"text":"yoch ooththadasa;","poem":2},{"lineBreak":true},{"text":"nu ooso ubbaa neni ooththadasa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Abeet GODAWU Nu Xoossawu!","poem":1},{"text":"neeppe hara allaga xoossati","poem":2},{"lineBreak":true},{"text":"nuna haarida;","poem":2},{"lineBreak":true},{"text":"nuni gidikko ne sunththaa","poem":2},{"lineBreak":true},{"text":"xalla bonchchoos.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Istti hayqqida;","poem":1},{"text":"simmidi shemppora","poem":2},{"lineBreak":true},{"text":"paxa de7ettenna;","poem":2},{"lineBreak":true},{"text":"istta shemppoy simmi yeenna;","poem":2},{"lineBreak":true},{"text":"neni istta qaxxayadasanne","poem":2},{"lineBreak":true},{"text":"dhayssadasa;","poem":2},{"lineBreak":true},{"text":"istta hassa7issiza miish ubbaa","poem":2},{"lineBreak":true},{"text":"pitta dhayssadasa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Abeet GODAWU!","poem":1},{"text":"Neni kawoteththaa darsadasa;","poem":2},{"lineBreak":true},{"text":"Neni deraa darsadasa.","poem":2},{"lineBreak":true},{"text":"Neni bonchchettadasa;","poem":2},{"lineBreak":true},{"text":"biittaa zawa ubbaaka aassadasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Abeet GODAWU!","poem":1},{"text":"Istti metotida wode neekko yida;","poem":2},{"lineBreak":true},{"text":"Neni istta seerida wode,","poem":2},{"lineBreak":true},{"text":"saasuki nena woosseettes.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Abeet GODAWU! Shaara maccassi","poem":1},{"text":"miixan metotiza malanne","poem":2},{"lineBreak":true},{"text":"waassiza mala","poem":2},{"lineBreak":true},{"text":"nunikka ne sinththan","poem":2},{"lineBreak":true},{"text":"metotidi waassoos.","poem"