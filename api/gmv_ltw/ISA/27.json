{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"ISA","translationId":"gmv_ltw","name":"Isayaasa Tinbite","commonName":"Isayaasa Tinbite","title":"Isayaasa Tinbite","order":23,"numberOfChapters":66,"sha256":"d074f522a3282bfda9b9144056654f45f094b00e7d7ec2af7b7fb3050350602a","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gmv_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":["He gallas GODAY lewataane geetettiza",{"text":"xongettiza shooshshaanne","poem":2},{"lineBreak":true},{"text":"xaaxettiza shooshshaa","poem":2},{"lineBreak":true},{"text":"ba mino, gitanne wolqqama","poem":2},{"lineBreak":true},{"text":"giththa mashshan qaxxayana;","poem":2},{"lineBreak":true},{"text":"abban diza wogga do7aa","poem":2},{"lineBreak":true},{"text":"qanxxereththi yeggana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"He gallas, «Woyne mith tokkiza","poem":1},{"text":"lo7osozas yexxite!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tani GODAY iza naagays;","poem":1},{"text":"tani ubbaa gallas haath ushshays;","poem":2},{"lineBreak":true},{"text":"omarsinne gallas iza naagays;","poem":2},{"lineBreak":true},{"text":"hessa gishshas ooninne","poem":2},{"lineBreak":true},{"text":"iza qohenna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tani hanqettike;","poem":1},{"text":"tanara olettanaas agunththinne","poem":2},{"lineBreak":true},{"text":"kindichchoy kezidaakko","poem":2},{"lineBreak":true},{"text":"ta istta issi bolla xuuggana!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Woykko taakko yiidi tana banttas","poem":1},{"text":"qotettizaso kessetto;","poem":2},{"lineBreak":true},{"text":"tanara giigetto;","poem":2},{"lineBreak":true},{"text":"ee tanara giigetto» geetettana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yaana gallassatan","poem":1},{"text":"Yaaqoobey xapho yeddana;","poem":2},{"lineBreak":true},{"text":"Isra7eeley aacananne ciiyana;","poem":2},{"lineBreak":true},{"text":"histtiin istta ayfey","poem":2},{"lineBreak":true},{"text":"sa7a kumana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Izo shocidayta shocida mala","poem":1},{"text":"GODAY izo shocidee?","poem":2},{"lineBreak":true},{"text":"Izo wodhidayta izi wodhida mala","poem":2},{"lineBreak":true},{"text":"izo wodhidee?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Olaninne di7on ne izo qaxxayadasa;","poem":1},{"text":"arshey mokkiza bagga carkoy","poem":2},{"lineBreak":true},{"text":"carkiza mala","poem":2},{"lineBreak":true},{"text":"wolqqama gote carkon","poem":2},{"lineBreak":true},{"text":"ne izo gooddadasa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yaaqoobey yarsho","poem":1},{"text":"yarshizaso shuchchata","poem":2},{"lineBreak":true},{"text":"booqintta shuchcha mala","poem":2},{"lineBreak":true},{"text":"gaacci liiqisishin","poem":2},{"lineBreak":true},{"text":"Asheero geetettiza","poem":2},{"lineBreak":true},{"text":"eeqa xoossay mislenne","poem":2},{"lineBreak":true},{"text":"exaane cuwasiza sohota","poem":2},{"lineBreak":true},{"text":"istti dizasohotappe shoddi olishin","poem":2},{"lineBreak":true},{"text":"he gallas mooroy atto geetettana;","poem":2},{"lineBreak":true},{"text":"hessi izi ba nagara diggoyssas","poem":2},{"lineBreak":true},{"text":"kumeththa ayfe gidana.","poem":2}]},{"type":"verse","number":10,"content":["Gimbettida katamaya kayzadus;",{"text":"bazzo biitta mala","poem":2},{"lineBreak":true},{"text":"olettidaso gidadus;","poem":2},{"lineBreak":true},{"text":"marati heen heemettidi","poem":2},{"lineBreak":true},{"text":"heen ichchana;","poem":2},{"lineBreak":true},{"text":"izi haggatakka poqqi maana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Izi xeeray melidi meqqana;","poem":1},{"text":"maccassatikka mixi eeththana;","poem":2},{"lineBreak":true},{"text":"akeekay baynda","poem":2},{"lineBreak":true},{"text":"dere gidida gishshas","poem":2},{"lineBreak":true},{"text":"iza medhdhiday","poem":2},{"lineBreak":true},{"text":"izas qadhettenna;","poem":2},{"lineBreak":true},{"text":"ooththidayssika iza maarenna.","poem":2}]},{"type":"verse","number":12,"content":["He gallas Efiraaxise shaafappe haaththi baynda Gibxe Shaafa gakkanaas GODAY ba kaththaa bukkana; intteno Isra7eele asatoo, intte issoy issoy shiiqana."]},{"type":"verse","number":13,"content":["He gallas gita zayey punettana; Asooren di7ettidaytinne Gibxen un7ettidayti guye Yerusalaame simmi yiidi geeshsha zumaa bolla GODAAS goynnana."]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/ISA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/ISA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/ISA/26.json","previousChapterAudioLinks":{},"numberOfVerses":13}