2},{"lineBreak":true},{"text":"qeeri nayti istta haarana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Derey dere bolla,","poem":1},{"text":"asi issoy issaa bolla,","poem":2},{"lineBreak":true},{"text":"shooroy shooro bolla,","poem":2},{"lineBreak":true},{"text":"yelaga nayti cimata bolla,","poem":2},{"lineBreak":true},{"text":"shufuroy bonchchettidayta bolla","poem":2},{"lineBreak":true},{"text":"dendana.","poem":2}]},{"type":"verse","number":6,"content":["Asi ba aawa keeththan",{"text":"ba ishanttafe oykkidi,","poem":2},{"text":"«Nees may7oy diza gishshas","poem":1},{"text":"nuna kaaleththizayssa gida;","poem":2},{"lineBreak":true},{"text":"ha laalettida sohoza aawateth","poem":2},{"lineBreak":true},{"text":"ne ekka» gaana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Histtiin izi he wode","poem":1},{"text":"ba qaala dhoqqu histtidi,","poem":2},{"lineBreak":true},{"text":"«Tani aykkoka maaddike;","poem":2},{"lineBreak":true},{"text":"tason may7oynne miza kaththi","poem":2},{"lineBreak":true},{"text":"baynda gishshas tana","poem":2},{"lineBreak":true},{"text":"dere kaaleththizaade","poem":2},{"lineBreak":true},{"text":"histtofte» gaana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yerusalaamey gandigarawus;","poem":1},{"text":"Yuhudaykka kundana matadus;","poem":2},{"lineBreak":true},{"text":"gaasoykka istti","poem":2},{"lineBreak":true},{"text":"bantta haasayaninne","poem":2},{"lineBreak":true},{"text":"ooson GODAARA eqettishe","poem":2},{"lineBreak":true},{"text":"iza bonchchoza toochcheettes.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Istta ayfesoy","poem":1},{"text":"istta bolla markkattees;","poem":2},{"lineBreak":true},{"text":"istti Sodoome asaa mala","poem":2},{"lineBreak":true},{"text":"bantta nagaraa qottontta","poem":2},{"lineBreak":true},{"text":"qonccen haasayeettes;","poem":2},{"lineBreak":true},{"text":"istti bantta bolla iita miish","poem":2},{"lineBreak":true},{"text":"ehiza gishshas","poem":2},{"lineBreak":true},{"text":"isttas aayye ana!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Xillotas, «Xilloti ba lo7o ooso","poem":1},{"text":"ayfe maana;","poem":2},{"lineBreak":true},{"text":"hessa gishshas","poem":2},{"lineBreak":true},{"text":"isttas lo7o gidana» ga yoota.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Iitatas aayye ana!","poem":1},{"text":"Istta bolla iita miishshi yaana;","poem":2},{"lineBreak":true},{"text":"ays giikko istti","poem":2},{"lineBreak":true},{"text":"bantta ooso mala ekkana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yelagati ta deraa un7eththeettes;","poem":1},{"text":"maccassatikka istta haareettes;","poem":2},{"lineBreak":true},{"text":"Ta derezoo!","poem":2},{"lineBreak":true},{"text":"Inttena kaaleththizayti","poem":2},{"lineBreak":true},{"text":"inttena baleththida;","poem":2},{"lineBreak":true},{"text":"intte biza ogeppeka","poem":2},{"lineBreak":true},{"text":"inttena kare kessida.","poem":2}]},{"type":"heading","content":["Goday Ba Asaa Bolla Pirdana Pirda"]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"GODAY pirdanaas shilotan uttides;","poem":1},{"text":"deraa bolla pirdanaas dendides.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"GODAY dere cimatanne","poem":1},{"text":"kaaleththizayta pirdanaas","poem":2},{"lineBreak":true},{"text":"issi bolla shiishshidi,","poem":2},{"lineBreak":true},{"text":"«Tani woyne tokkizasohoza","poem":2},{"lineBreak":true},{"text":"iissideta;","poem":2},{"lineBreak":true},{"text":"manqotappe intte bonqqidayssi","poem":2},{"lineBreak":true},{"text":"intte qol7an dees.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ta deraa ays meton liiqisidetii?","poem":1},{"text":"Manqota ays yeesseetii?","poem":2},{"lineBreak":true},{"text":"Hayssa yootiday tana Goda,","poem":2},{"lineBreak":true},{"text":"Ubbaafe Wolqqama","poem":2},{"lineBreak":true},{"text":"GODAA Xoossaa» gees.","poem":2}]},{"type":"heading","content":["Xiyoone Maccassatas Imettida Seera"]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"GODAY, «Xiyoone maccassati","poem":1},{"text":"otorettida;","poem":2},{"lineBreak":true},{"text":"bantta qoodhe warxi histtishe,","poem":2},{"lineBreak":true},{"text":"bantta ayfen som7i bessishe,","poem":2},{"lineBreak":true},{"text":"bantta duca qaaththishe,","poem":2},{"lineBreak":true},{"text":"bantta tohon diza sagayo","poem":2},{"lineBreak":true},{"text":"giirissishe hemetteettes.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hessa gishshas tani GODAY","poem":1},{"text":"Xiyoone maccassata hu7e","poem":2},{"lineBreak":true},{"text":"citton goo7issana;","poem":2},{"lineBreak":true},{"text":"tani GODAY istta hu7e","poem":2},{"lineBreak":true},{"text":"bo7asana» gees.","poem":2}]},{"type":"verse","number":18,"content":["He gallas GODAY Xiyoone maccassata alleqo miishshata, heytikka toho sagayota, hu7e alleqota, qoodhe gozdata,"]},{"type":"verse","number":19,"content":["hayththa gutichchata, kushe sagayota, ayfeso kammiza quraaceta,"]},{"type":"verse","number":20,"content":["hu7e goosseta, sagayota, hu7e alleqota, xeessan dancciza danccota, shitto bilqaaxeta, ashenkitaabeta,"]},{"type":"verse","number":21,"content":["siidhe midigata, biradhdhe midigata,"]},{"type":"verse","number":22,"content":["seelo may7ota, garsara may7iza may7ota, kaabbata, kushe karaxiiteta,"]},{"type":"verse","number":23,"content":["Heregata, laynota, giddora may7iza may7ota, binana qachchiza alleqotanne ayfeso kammiza qolleta ubbaa dafi ekkana."]},{"type":"verse","number":24,"content":[{"text":"Shitto xinqqon, dancco wodoron,","poem":1},{"text":"goofare bo7an,","poem":2},{"lineBreak":true},{"text":"seelo may7o maaqan,","poem":2},{"lineBreak":true},{"text":"puulateth pigen laammana.","poem":2}]},{"type":"verse","number":25,"content":["Inttes attuma asati giththa mashshan,",{"text":"olanchchati olan hayqqana.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Xiyoone pengeti","poem":1},{"text":"kallo gaden wodhdha uttada","poem":2},{"lineBreak":true},{"text":"yeekkiza maccassa mala","poem":2},{"lineBreak":true},{"text":"yeekkananne zilalana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/ISA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/ISA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}