a","poem":1},{"text":"«Minnite! Yayyofte!","poem":2},{"lineBreak":true},{"text":"Intte Xoossi yiidi halo kessana;","poem":2},{"lineBreak":true},{"text":"izi inttena ashshanaasinne","poem":2},{"lineBreak":true},{"text":"halo kessanaas yaana» giite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"He wode qooqeta ayfey xeellana;","poem":1},{"text":"tulleta hayththi siyana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wobbey genessa mala guppana;","poem":1},{"text":"duude doonay ufayssan yexxana;","poem":2},{"lineBreak":true},{"text":"bazzofe haaththi kezana;","poem":2},{"lineBreak":true},{"text":"pulttoy bazzo biittafe pulttana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Xuuggiza biittan","poem":1},{"text":"eele haaththi kumana;","poem":2},{"lineBreak":true},{"text":"mela biittati haath pulttana;","poem":2},{"lineBreak":true},{"text":"worakanati aqiza ollan","poem":2},{"lineBreak":true},{"text":"maatay, maqqaynne","poem":2},{"lineBreak":true},{"text":"shaccay mokkana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Heen wogga","poem":1},{"text":"ogey oosettana;","poem":2},{"lineBreak":true},{"text":"izikka, «Geeshshateththa","poem":2},{"lineBreak":true},{"text":"Oge» geetettana.","poem":2},{"lineBreak":true},{"text":"Tunati he ogera beettenna;","poem":2},{"lineBreak":true},{"text":"ogezi he ogera bizaytas","poem":2},{"lineBreak":true},{"text":"xalla gidana;","poem":2},{"lineBreak":true},{"text":"geellati he ogaara","poem":2},{"lineBreak":true},{"text":"baana dandayettenna.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Heen gaammoy de7enna;","poem":1},{"text":"dafi miza do7aykka izan kezenna;","poem":2},{"lineBreak":true},{"text":"heytantti heen beettettenna;","poem":2},{"lineBreak":true},{"text":"wozzettidayti xalla heera baana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"GODAY maaddidayti simmana;","poem":1},{"text":"istti yexxishe Xiyoone