{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"ISA","translationId":"gmv_ltw","name":"Isayaasa Tinbite","commonName":"Isayaasa Tinbite","title":"Isayaasa Tinbite","order":23,"numberOfChapters":66,"sha256":"d074f522a3282bfda9b9144056654f45f094b00e7d7ec2af7b7fb3050350602a","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gmv_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":37,"content":[{"type":"heading","content":["Kawo Hizqiyaasi Isayaasa Oychchida Zore"]},{"type":"verse","number":1,"content":["Kawo Hizqiyaasi hessa siyida mala ba may7o daakkides; hessafe guye maaqa may7idi GODAA Keeth gelides."]},{"type":"verse","number":2,"content":["Kawo keeth ayssiza Elyaaqeemey, xaafe Sheebinaynne qeesetappe erettidayti ubbay maaqa may7idi Amoxe naa nabe Isayaasakko baana mala kiittides."]},{"type":"verse","number":3,"content":["Isttika Isayaasas biidi, «Hizqiyaasi, ‹Ha gallassay ceece, qixaatenne kawushshateththa gallassa; hessika nay yelettana hanishin abbey ixxiza gallassa mala gidides."]},{"type":"verse","number":4,"content":["De7o Xoossaa cayana mala iza godaa Asoore kawoy kiittida ola gadawa qaala GODAA ne Xoossay siyontta aggenna. Qasse GODAA ne Xoossay he siyida qaalaa gaason iza qaxxayontta aggenna. Hessa gishshas neni shemppora paxa attida cashata gishshas woossa› gees» gida."]},{"type":"verse","number":5,"content":["Kawo Hizqiyaasi kiittidayti Isayaasakko yida wode,"]},{"type":"verse","number":6,"content":["Isayaasi isttas zaaridi, «Intte godaassi biidi, ‹GODAY nena, Asoore kawo ashkarati tana cayishin neni siyida cashsha qaalaas hirgofa."]},{"type":"verse","number":7,"content":["Beya, ta iza bolla ayana kiittana; izi wore siyidi ba dere simmi baana; heen ba deren mashshan hayqqana mala ta ooththana› giite» gides."]},{"type":"heading","content":["Asooreti Nam7anththo Kiittida Mande Qaala"]},{"type":"verse","number":8,"content":["Asoore kawoy Laakishe katamappe dendi bidayssa ola gadawazi siyidi guye simmides. Histtidi kawozi Libina katama olishin demmides."]},{"type":"verse","number":9,"content":["Kawo Senakireemey, Tophphiya Kawo Tiraaqey iza olana yizayssa siyides; hessa siyida mala Hizqiyaasas kiita yeddidi,"]},{"type":"verse","number":10,"content":["«Yuhuda Kawo Hizqiyaasas, ‹Yerusalaamey Asoore kawo kushen gelenna› giin ne ammanettida Xoossi nena cimmofo."]},{"type":"verse","number":11,"content":["Hekko Asoore kawoti biitta ubbaa bolla istti ooththidayssanne mulera istta dhayssidayssa ne siyadasa. Histtiin ne kessa ekka attana misatizee?"]},{"type":"verse","number":12,"content":["Kase ta aawati dhayssida Gozaanen, Kaaraaneninne Erafesen hessaththoka Talasaaren de7iza Edene asaa istta xoossati he biittata ashshidoo?"]},{"type":"verse","number":13,"content":["Hamaate kawoy, Arfaade kawoy, Sefarwayme kawoy, Heena kawoynne Iwa kawoy awan dizoo?» gides."]},{"type":"heading","content":["Hizqiyaasa Woosa"]},{"type":"verse","number":14,"content":["Hizqiyaasi dabdaabbeza kiitettida asatappe ekkidi nababides. GODAA Keeth ekki efidi GODAA sinththan miccides."]},{"type":"verse","number":15,"content":["Histtidi GODAA woossishe,"]},{"type":"verse","number":16,"content":["«Abeet GODAWU, Ubbaafe Wolqqama Xoossawu, kirubetappe giddon uttiza Isra7eele Xoossawu, sa7aa kawoteththata ubbaa bolla ne xalla Xoossaa. Salonne sa7a neni medhdhadasa."]},{"type":"verse","number":17,"content":["Abeet GODAWU, ne hayth haa yeggada ezga. Abeet GODAWU, ne ayfe pogada haa xeella. Nena De7o Xoossaa cayanaas Senakireemey kiittida qaala siya."]},{"type":"verse","number":18,"content":["«Abeet GODAWU tumakka, Asoore kawoti ha kawoteththatanne istta biitta ubbaa bazzo kessida."]},{"type":"verse","number":19,"content":["Istta xoossata taman xuuggida; istta xoossati wonikka miththafenne shuchchafe asa kushen masetti kezida misleppe attiin xoossata gidettenna."]},{"type":"verse","number":20,"content":["Ha7ikka abeet GODAWU, nu Xoossawu neni GODAY xalla Xoossa gididayssa sa7a kawoteththati ubbay erana mala nuna iza kusheppe ashsha!» gi woossides."]},{"type":"heading","content":["Isayaasi Kawo Hizqiyaasas Yeddida Kiita"]},{"type":"verse","number":21,"content":["Hessafe guye Amoxe naa Isayaasi kawo Hizqiyaasasi, «GODAY Isra7eele Xoossay, ‹Neni Asoore Kawo Senakireemey mandida mandeththa gishshas woossida woosaa ta siyadis› gees."]},{"type":"verse","number":22,"content":["«GODAY Senakireeme gishshas yootida qaalay,",{"text":"«Geela7oya Xiyoone naya","poem":1},{"text":"nena kadhadussinne leqqadus.","poem":2},{"lineBreak":true},{"text":"Yerusalaame naya","poem":2},{"lineBreak":true},{"text":"ne baqatishin be7ada","poem":2},{"lineBreak":true},{"text":"ba qoodhe","poem":2},{"lineBreak":true},{"text":"qaaththadus.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ne oona cayaynne kawushshay?","poem":1},{"text":"Oona bolla ne qaala","poem":2},{"lineBreak":true},{"text":"dhoqqu histta haasayay?","poem":2},{"lineBreak":true},{"text":"Otoro ayfen oona xeellay?","poem":2},{"lineBreak":true},{"text":"Isra7eele Geeshshaa bolla","poem":2},{"lineBreak":true},{"text":"gidennee!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Neni kiittida asata baggara","poem":1},{"text":"Godaa bolla daro","poem":2},{"lineBreak":true},{"text":"cashsha qaala haasayadasa.","poem":2},{"lineBreak":true},{"text":"Qasseka, ‹Tani cora para-gaaretan","poem":2},{"lineBreak":true},{"text":"zumata kaara,","poem":2},{"lineBreak":true},{"text":"Libaanoose hu7e kezadis.","poem":2},{"lineBreak":true},{"text":"Histtada adussa zigatanne","poem":2},{"lineBreak":true},{"text":"ubbaafe lo7iza xiiddata qanxxadis.","poem":2},{"lineBreak":true},{"text":"Tani keehi dhoqqasohotaninne","poem":2},{"lineBreak":true},{"text":"keehi kayshiza woran gakkadis.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Tani allaga biittatan","poem":1},{"text":"haaththa ollata bookkadis,","poem":2},{"lineBreak":true},{"text":"isttafekka haath uyadis.","poem":2},{"lineBreak":true},{"text":"Gibxe biittan diza","poem":2},{"lineBreak":true},{"text":"pultto haaththata ubbaa","poem":2},{"lineBreak":true},{"text":"ta tohon yedhdha","poem":2},{"lineBreak":true},{"text":"melissadis› gadasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"«Tani daro wodeppe","poem":1},{"text":"kase qachchidayssa,","poem":2},{"lineBreak":true},{"text":"ta beni halchchidayssa","poem":2},{"lineBreak":true},{"text":"ne siyabeekkii?","poem":2},{"lineBreak":true},{"text":"Ha7i gidikko","poem":2},{"lineBreak":true},{"text":"polettana mala ooththadis;","poem":2},{"lineBreak":true},{"text":"nenikka gimbettida katamata","poem":2},{"lineBreak":true},{"text":"laallada shuchcha doore kessana.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Istta deraas wolqqay ixxides;","poem":1},{"text":"isttika dagammidanne kawuyida.","poem":2},{"lineBreak":true},{"text":"Istti gaden diza doozata mala,","poem":2},{"lineBreak":true},{"text":"mul7o caarechchata mala,","poem":2},{"lineBreak":true},{"text":"keeththa kaaran mokkida","poem":2},{"lineBreak":true},{"text":"maata malanne","poem":2},{"lineBreak":true},{"text":"kessontta qooyda kaththa","poem":2},{"lineBreak":true},{"text":"mala gidida.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"«Gido attiin neni uttizaso,","poem":1},{"text":"ne ayde yaada ayde baanaakko,","poem":2},{"lineBreak":true},{"text":"ne ta bolla waana","poem":2},{"lineBreak":true},{"text":"hanqon dendanaakko","poem":2},{"lineBreak":true},{"text":"ta erays.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Neni ta bolla","poem":1},{"text":"hanqon dendettida gishshassinne,","poem":2},{"lineBreak":true},{"text":"ne hallacizayssi ta hayththan","poem":2},{"lineBreak":true},{"text":"wodhdhida gishshas,","poem":2},{"lineBreak":true},{"text":"tani ne siidhen dafo aaththana;","poem":2},{"lineBreak":true},{"text":"ne doonankka bixala barsana;","poem":2},{"lineBreak":true},{"text":"ne yida ogerakka ta nena","poem":2},{"lineBreak":true},{"text":"guye zaara yeddana» gides.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"«Hessafe guye Isayaasi","poem":1},{"text":"kawo Hizqiyaasas,","poem":2},{"lineBreak":true},{"text":"hayssi nees malata gido;","poem":2},{"lineBreak":true},{"text":"ha layth intte azabba mokkida","poem":2},{"lineBreak":true},{"text":"kath maana;","poem":2},{"lineBreak":true},{"text":"yiza layththika azabbaafe","poem":2},{"lineBreak":true},{"text":"wodhdhi mokkidaaz maana.","poem":2},{"lineBreak":true},{"text":"Gido attiin heedzdzanththo layth","poem":2},{"lineBreak":true},{"text":"intte zerananne maxana;","poem":2},{"lineBreak":true},{"text":"woyne tokkananne","poem":2},{"lineBreak":true},{"text":"iza ayfekka shiishshana.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Yuhudappe attida cashati","poem":1},{"text":"xapho duge yeddidi","poem":2},{"lineBreak":true},{"text":"bollan ayfe ayfana.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Attida cashati Yerusalaameppe,","poem":1},{"text":"shemppora paxa attidayti","poem":2},{"lineBreak":true},{"text":"Xiyooneppe kezana.","poem":2},{"lineBreak":true},{"text":"Ubbaafe Wolqqama GODAA","poem":2},{"lineBreak":true},{"text":"zil7eteththi hessa ooththana.","poem":2}]},{"type":"verse","number":33,"content":["«Asoore kawo gishshas GODAY,",{"text":"‹Asoore kawoy","poem":2},{"lineBreak":true},{"text":"ha katamaa gelenna;","poem":2},{"lineBreak":true},{"text":"izi bolla ba wondafe dukkenna;","poem":2},{"lineBreak":true},{"text":"izi bolla ba gondalle","poem":2},{"lineBreak":true},{"text":"oykkidi yeenna;","poem":2},{"lineBreak":true},{"text":"qasse katamaa yuushon","poem":2},{"lineBreak":true},{"text":"biitta dooren gordenna.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Ba yida ogera guye simmana;","poem":1},{"text":"izi ha katamayo gelenna› gees.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Tani ta bonchcho gishshassinne","poem":1},{"text":"ta ashkara Dawite gishshas,","poem":2},{"lineBreak":true},{"text":"ha katamayo","poem":2},{"lineBreak":true},{"text":"kamma ashshana» gides.","poem":2}]},{"type":"verse","number":36,"content":["He gallassa omarsi GODAA kiitanchchay ke7idi, Asoore asay dunkkaani dizason, 185,000 attumasata wodhides. Histtiin asay maalado suuridi be7iza wode hayqqida asaa ahay heen kumides."]},{"type":"verse","number":37,"content":["Hessa gishshas Asoore Kawo Senakireemey kessi ekkides; guye simmi biidikka Nannawe kataman uttides."]},{"type":"verse","number":38,"content":["Sanaakireemi ba xoossaa Nisraake keeththan goynnishe de7ishin, iza nayti Adiramelekeynne Sarsarey mashshan iza wodhida. Histtidi Araraate biitta baqatida. Iza naa Aseradooney izasohon kawotides.",{"noteId":4}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Ibraaweta qaalara Asiraadooni Esar-Haddon geetettees.","reference":{"chapter":37,"verse":38}}]},"thisChapterLink":"/api/gmv_ltw/ISA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/ISA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/ISA/36.json","previousChapterAudioLinks":{},"numberOfVerses":38}