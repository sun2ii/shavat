{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"ISA","translationId":"gmv_ltw","name":"Isayaasa Tinbite","commonName":"Isayaasa Tinbite","title":"Isayaasa Tinbite","order":23,"numberOfChapters":66,"sha256":"d074f522a3282bfda9b9144056654f45f094b00e7d7ec2af7b7fb3050350602a","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gmv_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":38,"content":[{"type":"heading","content":["Hargefe Hizqiyaasa Paxo"]},{"type":"verse","number":1,"content":["He wode Kawo Hizqiyaasi hargidi, hayqqana matides. Histtiin Amoxe naa nabe Isayaasi izakko biidi, «GODAY nena, ‹Neni hayqqanaappe attiin hargezappe paxakka; hessa gishshas ne keeththaa giigsa› gees» gides."]},{"type":"verse","number":2,"content":["Histtiin Hizqiyaasi keeththa godaakko simmidi GODAA woossides."]},{"type":"verse","number":3,"content":["Woossishe, «Abeet GODAWU, tani ne sinththan ammaneteththaninne kumeththa wozinappe nena ufayssiza miish ooththashe ta waana de7idaakko neni akeekana mala tani nena woossays» gi woossides; Hizqiyaasikka keehi camo yeeho yeekkides."]},{"type":"verse","number":4,"content":["Hessafe guye GODAA qaalay Isayaasakko yides."]},{"type":"verse","number":5,"content":["Histtidi, «Neni baada Hizqiyaasa, ‹GODAY ne aawaa Dawite Xoossay, Tani ne woosaa siyadis; ne afunththaaka be7adis. Ne layththa bolla tani nees tammanne ichchashu layth gujjana."]},{"type":"verse","number":6,"content":["Nenanne ha katamayo Asoore biitta kawoza kusheppe ashshana; tani ha katamay bolla yizayssa teqqana› gees» gides."]},{"type":"verse","number":7,"content":["Isayaasi gujjidikka, «GODAY nees gida qaala polanayssas malatay hayssafe kaallizayssa;"]},{"type":"verse","number":8,"content":["beya, Akaazey pude ke7anaas giigsida kechchata bolla wodhdhiza awa kuway tammu kech guye simmi baana mala tani ooththana» gides. Histtiin kuway tammu kech guye simmidi bides."]},{"type":"verse","number":9,"content":["Yuhuda kawo Hizqiyaasi hargi paxidaappe guyen xaafida qaalay hayssafe kaallizayssa;"]},{"type":"verse","number":10,"content":["tani, «Ta de7o layththas buron bagga gakkiza wode, hayqo pengera gelana bessizee? Taas attida layththay taappe bonqqettanaas bessizee?» gadis."]},{"type":"verse","number":11,"content":[{"text":"Qasseka, «Tani shemppora paxa","poem":1},{"text":"de7izayta biittan","poem":2},{"lineBreak":true},{"text":"nena GODAA zaara be7ikke;","poem":2},{"lineBreak":true},{"text":"hayssafe guyen","poem":2},{"lineBreak":true},{"text":"ta asa zereth be7ikke;","poem":2},{"lineBreak":true},{"text":"ha sa7an de7izayta","poem":2},{"lineBreak":true},{"text":"giddonkka de7ikke.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ta keeththi heenththanchchata","poem":1},{"text":"dunkaane mala shodettides;","poem":2},{"lineBreak":true},{"text":"taappeka ekettides;","poem":2},{"lineBreak":true},{"text":"Shemmaaney afala wondiraashen","poem":2},{"lineBreak":true},{"text":"xaaxiza mala,","poem":2},{"lineBreak":true},{"text":"tani ta de7o xaaxadis;","poem":2},{"lineBreak":true},{"text":"izikka tana wondiraasheppe","poem":2},{"lineBreak":true},{"text":"duuththides.","poem":2},{"lineBreak":true},{"text":"Malladoppe omars gakkanaas,","poem":2},{"lineBreak":true},{"text":"neni tana dhayssanaas","poem":2},{"lineBreak":true},{"text":"eesotadasa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sa7ay wonttana gakkanaas","poem":1},{"text":"tani nena dandayan naagadis;","poem":2},{"lineBreak":true},{"text":"Gido attiin gaammo","poem":2},{"lineBreak":true},{"text":"mala ta meqeththaa","poem":2},{"lineBreak":true},{"text":"ubbaa menththereththides.","poem":2},{"lineBreak":true},{"text":"Qasse maaladoppe omarsi gakkanaas","poem":2},{"lineBreak":true},{"text":"neni tana dhayssanaas eesotadasa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tani cirashanne","poem":1},{"text":"haaththa kafo mala waassadis;","poem":2},{"lineBreak":true},{"text":"haraphphe malakka guugumadis.","poem":2},{"lineBreak":true},{"text":"Ta ayfeti pude salo","poem":2},{"lineBreak":true},{"text":"xeellidi daaburda.","poem":2},{"lineBreak":true},{"text":"Abeet Godawu, tani un7ettadis;","poem":2},{"lineBreak":true},{"text":"neni tana hannife kessa!» gadis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Histtiin ta ay gaanee?","poem":1},{"text":"Izi ba hu7era taas yootides;","poem":2},{"lineBreak":true},{"text":"qasseka ba hu7era","poem":2},{"lineBreak":true},{"text":"hayssa ooththides;","poem":2},{"lineBreak":true},{"text":"Ta shemppoya","poem":2},{"lineBreak":true},{"text":"keehippe ceecida gishshas,","poem":2},{"lineBreak":true},{"text":"ta de7o layth ubbaan","poem":2},{"lineBreak":true},{"text":"ashketeththan baana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Abeet Godawu heytantta mala","poem":1},{"text":"yo7otan asay paxa dees.","poem":2},{"lineBreak":true},{"text":"Ta ayanaykka heytanttan","poem":2},{"lineBreak":true},{"text":"de7o demmana.","poem":2},{"lineBreak":true},{"text":"Ne tana paththadasa,","poem":2},{"lineBreak":true},{"text":"tana shemppora paxa woththadasa!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hekko ta meton ceecidayssi","poem":1},{"text":"taas go7as gidides.","poem":2},{"lineBreak":true},{"text":"Neni ta shemppo bashsha ollafe","poem":2},{"lineBreak":true},{"text":"ne siiqon naagadasa;","poem":2},{"lineBreak":true},{"text":"neni ta nagara ubbaa","poem":2},{"lineBreak":true},{"text":"neeppe guye zaarada oladasa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Duufoy nena galatenna;","poem":1},{"text":"hayqoykka nena sabbenna.","poem":2},{"lineBreak":true},{"text":"Duge ollan wodhdhizayti","poem":2},{"lineBreak":true},{"text":"ne ammaneteth hidota oosettenna.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tani hach nena galatizayssa mala","poem":1},{"text":"shemppora paxa de7izayti xalla","poem":2},{"lineBreak":true},{"text":"nena galatana;","poem":2},{"lineBreak":true},{"text":"ne ammaneteththa gishshas","poem":2},{"lineBreak":true},{"text":"aawati ba naytas yooteettes.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"GODAY tana ashshana;","poem":1},{"text":"hessa gishshas nuni","poem":2},{"lineBreak":true},{"text":"nu de7iza layththata ubbaan,","poem":2},{"lineBreak":true},{"text":"GODAA keeththan","poem":2},{"lineBreak":true},{"text":"waaxettida diiththan yexxana.","poem":2}]},{"type":"verse","number":21,"content":["Isayaasi kase, «Balase miththa ayfe daaxxidi, iza kixaa bolla woththite. Histtiko izi paxana»",{"text":"gi woththides.","poem":2}]},{"type":"verse","number":22,"content":["Hizqiyaasikka, «Tani paxada GODAA Keeth pude kezanayssas malatay aazee?» giidi Isayaasa oychchi woththides."]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/ISA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/ISA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/ISA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}