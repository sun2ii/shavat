{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"ISA","translationId":"gmv_ltw","name":"Isayaasa Tinbite","commonName":"Isayaasa Tinbite","title":"Isayaasa Tinbite","order":23,"numberOfChapters":66,"sha256":"d074f522a3282bfda9b9144056654f45f094b00e7d7ec2af7b7fb3050350602a","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gmv_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":["He wode laappun maccassati issi adde oykkidi,",{"text":"«Maana kath gidiin","poem":2},{"lineBreak":true},{"text":"may7ana may7o","poem":2},{"lineBreak":true},{"text":"nuni nurkka nuna dandayana;","poem":2},{"lineBreak":true},{"text":"ne sunththan xalla","poem":2},{"lineBreak":true},{"text":"xeygettana mala histtada","poem":2},{"lineBreak":true},{"text":"nu kawushshateththaa","poem":2},{"lineBreak":true},{"text":"nuuppe diggarkkii!» gi woossana.","poem":2}]},{"type":"heading","content":["Yerusalaame Ooraththateth"]},{"type":"verse","number":2,"content":["He wode GODAA miththa haggay lo7ananne bonchchettana; Isra7eele asaappe dhayshe attidaytas he biitta kaththay ceeqossinne bonchchos gidana."]},{"type":"verse","number":3,"content":["Xiyoonen attidayti, Yerusalaamen dhayontta attidayti, Yerusalaamen shemppora paxa dishe xaafettida ubbatara, «Istti geeshshata» geetettana."]},{"type":"verse","number":4,"content":["GODAY Xiyoone maccassata qitaa meeccana; maadhetti uttida suuththaafe Yerusalaame pirda ayananinne xuuggiza ayanan geeshshana."]},{"type":"verse","number":5,"content":["GODAY Xiyoone zuma bollanne heen shiiqiza ubbata bolla gallas shaaranne cuwa, omars eexxiza tama poo7o kiittana; Xoossa bonchchoy katamayo dunkaane mala kammi naagana."]},{"type":"verse","number":6,"content":["Izi gallassa awa suuleppe ashshiza kuwa, uushoppenne irappe baqati attizasoho gidana."]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/ISA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/ISA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/ISA/3.json","previousChapterAudioLinks":{},"numberOfVerses":6}