text":"Intteno duge abban wodhdhizaytoo,","poem":1},{"text":"heen diza ubbatoo!","poem":2},{"lineBreak":true},{"text":"Intteno harurotoo!","poem":2},{"lineBreak":true},{"text":"Heenkka diza ubbatoo!","poem":2},{"lineBreak":true},{"text":"GODAASSI ooraththa mazamure yexxite;","poem":2},{"lineBreak":true},{"text":"biittaa gaxaappe doommidi","poem":2},{"lineBreak":true},{"text":"izas galata mazamure shiishshite.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bazzoynne katamati bantta cenggurssaa","poem":1},{"text":"dhoqqu histtetto;","poem":2},{"lineBreak":true},{"text":"Qeedaarey de7iza gutay ufayetto;","poem":2},{"lineBreak":true},{"text":"Seela dere asati","poem":2},{"lineBreak":true},{"text":"ufayssan yexetto;","poem":2},{"lineBreak":true},{"text":"zuma xeerankka ililetto.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Istti bonchcho GODAAS immetto;","poem":1},{"text":"iza galataykka harurotan awajjetto.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"GODAY ola qara mala kezana;","poem":1},{"text":"olanchcha mala ho7etti dendana.","poem":2},{"lineBreak":true},{"text":"Ceeqeteththa gayro sissana;","poem":2},{"lineBreak":true},{"text":"ba morkketakka oli xoonana.","poem":2}]},{"type":"heading","content":["Goday Ba Deraa Maaddana Immida Hidota"]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"GODAY, «Tani adussa wodeesofe","poem":1},{"text":"co7u gadis;","poem":2},{"lineBreak":true},{"text":"sirphi gadis;","poem":2},{"lineBreak":true},{"text":"tana qum7a oykkadis;","poem":2},{"lineBreak":true},{"text":"ha7i gidikko miixa oykettida","poem":2},{"lineBreak":true},{"text":"maccassa mala waassays;","poem":2},{"lineBreak":true},{"text":"sheenottayssinne bannakays.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tani zumatanne zumbullata woddisana;","poem":1},{"text":"doozata ubbaa melissana.","poem":2},{"lineBreak":true},{"text":"Shaafata haruro biitta kessana;","poem":2},{"lineBreak":true},{"text":"eele haaththatakka micinchchana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tani qooqeta istti erontta","poem":1},{"text":"oge kaaleththana;","poem":2},{"lineBreak":true},{"text":"istti meezetontta ogerakka","poem":2},{"lineBreak":true},{"text":"ta istta efana;","poem":2},{"lineBreak":true},{"text":"dhumaza ta istta sinththan poo7isana;","poem":2},{"lineBreak":true},{"text":"kundukurcco sohota ta giigsana;","poem":2},{"lineBreak":true},{"text":"haytantta ubbaa ta ooththontta aggike.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Eeqa xoossatan ammanettizayti gidikko","poem":1},{"text":"misletakka, ‹Intte nu xoossata› gizayti guye simmana;","poem":2},{"lineBreak":true},{"text":"istti mulera kawuyana» gees.","poem":2}]},{"type":"heading","content":["Isra7eele Asaa Qooqeteththinne Tulleteth"]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"GODAY, «Intteno tulletoo siyite!","poem":1},{"text":"intteno qooqetoo be7itenne xeellite!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ta ashkaraappe attiin","poem":1},{"text":"hara qooqey oonee?","poem":2},{"lineBreak":true},{"text":"Tani kiittidaadefe attiin","poem":2},{"lineBreak":true},{"text":"hara tulley oonee?","poem":2},{"lineBreak":true},{"text":"taas ammanettidaade mala","poem":2},{"lineBreak":true},{"text":"qooqey,","poem":2},{"lineBreak":true},{"text":"GODAA ashkara mala","poem":2},{"lineBreak":true},{"text":"qooqey oonee?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Daro miish be7ideta shin","poem":1},{"text":"akeekibeekketa;","poem":2},{"lineBreak":true},{"text":"intte hayththay doya dees shin","poem":2},{"lineBreak":true},{"text":"siyekketa» gees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"GODAY ba xilloteththaa","poem":1},{"text":"gishshas giidi,","poem":2},{"lineBreak":true},{"text":"ba wogaa gitanne","poem":2},{"lineBreak":true},{"text":"bonchcho","poem":2},{"lineBreak":true},{"text":"kessida gishshas ufayettides.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ha derey bogettidanne bonqqettida,","poem":1},{"text":"olla giddon wodhdhida,","poem":2},{"lineBreak":true},{"text":"woyne keeththay iza bolla","poem":2},{"lineBreak":true},{"text":"gordettida dere;","poem":2},{"lineBreak":true},{"text":"istti bogettida;","poem":2},{"lineBreak":true},{"text":"istta ashshizaadey deenna;","poem":2},{"lineBreak":true},{"text":"istti di7ettida;","poem":2},{"lineBreak":true},{"text":"«Istta zaarite» gizaykka baawa.","poem":2}]},{"type":"verse","number":23,"content":["Intte giddofe hayssa siyizay,",{"text":"sinththafe yaana wodes","poem":2},{"lineBreak":true},{"text":"akeeki siyizay oonee?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yaaqoobey bogettana mala,","poem":1},{"text":"Isra7eeley di7ettana mala","poem":2},{"lineBreak":true},{"text":"ooththiday oonee?","poem":2},{"lineBreak":true},{"text":"Nagara ooththidi","poem":2},{"lineBreak":true},{"text":"nu qohida GODAA gidennee?","poem":2},{"lineBreak":true},{"text":"Istti iza oge kaallanaassinne","poem":2},{"lineBreak":true},{"text":"iza wogaas azazettana koyontta","poem":2},{"lineBreak":true},{"text":"aggida gishshassa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Hessa gishshas eexxiza ba hanqoza,","poem":1},{"text":"iita ola istta bolla yeddides;","poem":2},{"lineBreak":true},{"text":"tama lacon istta giddoththides;","poem":2},{"lineBreak":true},{"text":"istti gidikko hessa akeekibeettenna;","poem":2},{"lineBreak":true},{"text":"istta xuuggides shin","poem":2},{"lineBreak":true},{"text":"istti wozinan woththibeettenna.","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"Karchchalle guussi qasho keeththa woykko woyne keeththa.","reference":{"chapter":42,"verse":7}}]},"thisChapterLink":"/api/gmv_ltw/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/ISA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/ISA/41.json