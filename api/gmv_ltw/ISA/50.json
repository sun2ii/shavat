","poem":2},{"lineBreak":true},{"text":"ta kushey qaammadee?","poem":2},{"lineBreak":true},{"text":"Woykko inttena ashshanaas","poem":2},{"lineBreak":true},{"text":"taas wolqqay guuththee?","poem":2},{"lineBreak":true},{"text":"Be7ite ta hanqon","poem":2},{"lineBreak":true},{"text":"abba melissays;","poem":2},{"lineBreak":true},{"text":"shaafatakka bazzo kessays;","poem":2},{"lineBreak":true},{"text":"isttan diza moleti","poem":2},{"lineBreak":true},{"text":"saamon hayqqidi zeeqqeettes.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tani salo dhumisana;","poem":1},{"text":"tani iza maaqa mayzana» gees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ubbaa Haariza GODAY taas","poem":1},{"text":"inxarsa erateth immides;","poem":2},{"lineBreak":true},{"text":"hessa gishshas daaburanchchatas","poem":2},{"lineBreak":true},{"text":"ta ay gaana bessizaakko ta erays;","poem":2},{"lineBreak":true},{"text":"maalado maalado","poem":2},{"lineBreak":true},{"text":"tana beegoththees;","poem":2},{"lineBreak":true},{"text":"tamaarshe diza tamaare mala","poem":2},{"lineBreak":true},{"text":"siyanaas ta hayth doyees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ubbaa Haariza GODAY","poem":1},{"text":"ta hayth doydes;","poem":2},{"lineBreak":true},{"text":"tani makkallanchcha diikke;","poem":2},{"lineBreak":true},{"text":"guyekka baqatabeekke.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ta zokko shocizaytas,","poem":1},{"text":"ta buuchcha shoddizaytas","poem":2},{"lineBreak":true},{"text":"aaththa immadis;","poem":2},{"lineBreak":true},{"text":"Ta ayfeso cuchchafe","poem":2},{"lineBreak":true},{"text":"genththabeekke.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ubbaa Haarizaa GODAY","poem":1},{"text":"tana maaddiza gishshas","poem":2},{"lineBreak":true},{"text":"tani kawuykke;","poem":2},{"lineBreak":true},{"text":"hessa gishshas ta ayfeso","poem":2},{"lineBreak":true},{"text":"daldacha shuchcha mala","poem":2},{"lineBreak":true},{"text":"ooththadis;","poem":2},{"lineBreak":true},{"text":"tani yeellatonttayssa erays.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ta xilloteththa qonccisizaadey","poem":1},{"text":"ta matan dees;","poem":2},{"lineBreak":true},{"text":"histtiin tana mootana","poem":2},{"lineBreak":true},{"text":"dandayzay izi oonee?","poem":2},{"lineBreak":true},{"text":"Ane issife tiran gayttoos!","poem":2},{"lineBreak":true},{"text":"Ta baalgaaray oonee?","poem":2},{"lineBreak":true},{"text":"Ane haayo!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Be7ite, Ubbaa Haariza GODAY","poem":1},{"text":"tana maaddees;","poem":2},{"lineBreak":true},{"text":"histtiin ta bolla pirdanay oonee?","poem":2},{"lineBreak":true},{"text":"Be7ite, istti ubbayka","poem":2},{"lineBreak":true},{"text":"may7o mala ceeggana;","poem":2},{"lineBreak":true},{"text":"bilay istta maana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Intte giddofe GODAAS yayyizay,","poem":1},{"text":"iza ayllaa qaalas","poem":2},{"lineBreak":true},{"text":"azazettizay oonee?","poem":2},{"lineBreak":true},{"text":"Hessaadey dhuman","poem":2},{"lineBreak":true},{"text":"bizaa gidikkonne","poem":2},{"lineBreak":true},{"text":"poo7oy izas baynda aggiko","poem":2},{"lineBreak":true},{"text":"izi GODAA sunththan","poem":2},{"lineBreak":true},{"text":"ammanetto;","poem":2},{"lineBreak":true},{"text":"ba Xoossankka zemppo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ha7i gidikko intte tama eeththidi,","poem":1},{"text":"laciza intte xomppe xomppe","poem":2},{"lineBreak":true},{"text":"oykkida ubbati","poem":2},{"lineBreak":true},{"text":"intte poo7on biite;","poem":2},{"lineBreak":true},{"text":"intte oyththida xomppe","poem":2},{"lineBreak":true},{"text":"poo7on simerettite;","poem":2},{"lineBreak":true},{"text":"Intte ta kusheppe","poem":2},{"lineBreak":true},{"text":"ekkanayssi hayssa;","poem":2},{"lineBreak":true},{"text":"intte i