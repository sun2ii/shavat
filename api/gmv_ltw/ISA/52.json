{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"ISA","translationId":"gmv_ltw","name":"Isayaasa Tinbite","commonName":"Isayaasa Tinbite","title":"Isayaasa Tinbite","order":23,"numberOfChapters":66,"sha256":"d074f522a3282bfda9b9144056654f45f094b00e7d7ec2af7b7fb3050350602a","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gmv_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":52,"content":[{"type":"heading","content":["Xoossay Yerusalaame Ashshana"]},{"type":"verse","number":1,"content":[{"text":"Hanne Xiyoone denda; denda;","poem":1},{"text":"wolqqa may7a;","poem":2},{"lineBreak":true},{"text":"geeshsha katamaye","poem":2},{"lineBreak":true},{"text":"Yerusalaamee!","poem":2},{"lineBreak":true},{"text":"Ne bonchcho may7o may7a;","poem":2},{"lineBreak":true},{"text":"hayssafe guye qaxxarettonttaynne","poem":2},{"lineBreak":true},{"text":"tunay ne giddo gelenna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hanne Yerusalaame, denda;","poem":1},{"text":"gudullaa pitta; ne araatan utta.","poem":2},{"lineBreak":true},{"text":"Di7ettida Xiyoone nayee,","poem":2},{"lineBreak":true},{"text":"ne qoodhen qashettida","poem":2},{"lineBreak":true},{"text":"sansalata kessa yegga.","poem":2}]},{"type":"verse","number":3,"content":["GODAY, «Intte coo",{"text":"hada bayzettideta;","poem":2},{"lineBreak":true},{"text":"ha7ikka miishshi baynda","poem":2},{"lineBreak":true},{"text":"coo intte wozzettana» gees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ubbaa Haariza GODAY,","poem":1},{"text":"«Koyro ta derey de7anaas","poem":2},{"lineBreak":true},{"text":"duge Gibxe wodhdhides;","poem":2},{"lineBreak":true},{"text":"guyeppe Asoorey gaasoykka baynda","poem":2},{"lineBreak":true},{"text":"un7eththi haarides.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"‹Histtiin ta derey","poem":1},{"text":"gaasoykka baynda","poem":2},{"lineBreak":true},{"text":"di7etti biichchiin","poem":2},{"lineBreak":true},{"text":"taas haan aazi dizee?›","poem":2},{"lineBreak":true},{"text":"Istta haaridayti","poem":2},{"lineBreak":true},{"text":"istta bolla qilccida;","poem":2},{"lineBreak":true},{"text":"gallas kumeth ta sunththaa","poem":2},{"lineBreak":true},{"text":"pacey baynda cayeettes.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hessa gishshas ta derey","poem":1},{"text":"ta sunththaa erana;","poem":2},{"lineBreak":true},{"text":"he gallas kasekka yootiday","poem":2},{"lineBreak":true},{"text":"tana gididayssa istti erana.","poem":2},{"lineBreak":true},{"text":"Ee hessi tana» gees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Zuma bolla eqqida tohoti,","poem":1},{"text":"mishiraachcho ekki yiza tohoti,","poem":2},{"lineBreak":true},{"text":"saroteth yootizayti,","poem":2},{"lineBreak":true},{"text":"lo7o mishiraachcho yootizayti,","poem":2},{"lineBreak":true},{"text":"atoteth awajjizayti,","poem":2},{"lineBreak":true},{"text":"Xiyoonokka,","poem":2},{"lineBreak":true},{"text":"«Ne Xoossay kawotides»","poem":2},{"lineBreak":true},{"text":"giza tohoti ay mala lo7o!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hanne siya!","poem":1},{"text":"Nena naagiyzayti","poem":2},{"lineBreak":true},{"text":"bantta qaala dhoqqu histtida.","poem":2},{"lineBreak":true},{"text":"Issi bolla ililishe yexxeettes;","poem":2},{"lineBreak":true},{"text":"GODAY Xiyoone simmiza wode,","poem":2},{"lineBreak":true},{"text":"istti iza bantta ayfera be7ana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Intteno Yerusalaamen","poem":1},{"text":"qolettida sohotoo!","poem":2},{"lineBreak":true},{"text":"Intte issi bolla ililisan yexxite;","poem":2},{"lineBreak":true},{"text":"GODAY ba deraa minththeththides;","poem":2},{"lineBreak":true},{"text":"Yerusalaame katamaakka wozzides.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"GODAY ba geeshsha qesaa","poem":1},{"text":"kawoteththata ubbaa","poem":2},{"lineBreak":true},{"text":"sinththan qonccisana;","poem":2},{"lineBreak":true},{"text":"qasse biittaa gaxan diza ubbayka","poem":2},{"lineBreak":true},{"text":"nu Xoossaa atoteththaa be7ana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Intteno GODAA keeththa","poem":1},{"text":"miishshata tookkizaytoo!","poem":2},{"lineBreak":true},{"text":"Shaakettite, shaakettite;","poem":2},{"lineBreak":true},{"text":"heeppe kezite.","poem":2},{"lineBreak":true},{"text":"Tuna miish bochchofte;","poem":2},{"lineBreak":true},{"text":"heeppe kezite;","poem":2},{"lineBreak":true},{"text":"intte hu7esikka geeyte.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Gidikkoka eeson kezekketa;","poem":1},{"text":"woykko beti beekketa;","poem":2},{"lineBreak":true},{"text":"GODAY inttefe sinth aadhdhidi","poem":2},{"lineBreak":true},{"text":"inttena kaaleththana;","poem":2},{"lineBreak":true},{"text":"Isra7eele Xoossayka","poem":2},{"lineBreak":true},{"text":"guyera inttena naagana.","poem":2}]},{"type":"heading","content":["Metoy Iza Gakkiza Oosanchcha"]},{"type":"verse","number":13,"content":["GODAY, «Be7ite,",{"text":"ta ashkaray akeekan ooththana;","poem":2},{"lineBreak":true},{"text":"izi erettidaade gidana,","poem":2},{"lineBreak":true},{"text":"izi dhoqqu dhoqqu gaana;","poem":2},{"lineBreak":true},{"text":"izi keehi bonchchettana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Daro asay izan","poem":1},{"text":"dagamanaashe gakkanaas","poem":2},{"lineBreak":true},{"text":"as ubbaafe qohettida gishshas","poem":2},{"lineBreak":true},{"text":"iza medhay","poem":2},{"lineBreak":true},{"text":"asa medhappe laamettides.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hessa gishshas izi","poem":1},{"text":"daro kawoteththata malalisana;","poem":2},{"lineBreak":true},{"text":"iza gaason kawoteththati","poem":2},{"lineBreak":true},{"text":"bantta doona oykkana;","poem":2},{"lineBreak":true},{"text":"isttas yootettonttayssa","poem":2},{"lineBreak":true},{"text":"istti be7ana;","poem":2},{"lineBreak":true},{"text":"istti siyi erontta","poem":2},{"lineBreak":true},{"text":"miish akeekana» gees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}