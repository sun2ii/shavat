{"lineBreak":true},{"text":"ne zareti kawoteththata laattana;","poem":2},{"lineBreak":true},{"text":"histtidi aykkoy baynda","poem":2},{"lineBreak":true},{"text":"istta katamatan istti daana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«Aykkoy baa babbofa;","poem":1},{"text":"ne yeellatakka;","poem":2},{"lineBreak":true},{"text":"hirgofa; ne kawuyaka;","poem":2},{"lineBreak":true},{"text":"ne yelagateththa yeellaa","poem":2},{"lineBreak":true},{"text":"neni dogana;","poem":2},{"lineBreak":true},{"text":"ne am7eteththaa borokka","poem":2},{"lineBreak":true},{"text":"hayssafe sinththan hassa7akka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nena medhdhidayssi nees azina;","poem":1},{"text":"iza sunththayka Ubbaafe","poem":2},{"lineBreak":true},{"text":"Wolqqama GODAA.","poem":2},{"lineBreak":true},{"text":"Nena wozziday","poem":2},{"lineBreak":true},{"text":"Isra7eele Geeshsha;","poem":2},{"lineBreak":true},{"text":"izi biitta ubbaa Xoossa geetettees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Naateththan ekkidi","poem":1},{"text":"kadhida machchi mala;","poem":2},{"lineBreak":true},{"text":"neni wozina meqqidanne","poem":2},{"lineBreak":true},{"text":"kadhettida machchi mala;","poem":2},{"lineBreak":true},{"text":"gido attiin GODAY","poem":2},{"lineBreak":true},{"text":"nena guye zaari xeygana»","poem":2},{"lineBreak":true},{"text":"gees Xoossay.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Guuththa wode tani nena aggadis;","poem":1},{"text":"gido attiin gita qadhetan","poem":2},{"lineBreak":true},{"text":"ta nena zaara shiishshana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ta guuththa wodes","poem":1},{"text":"keeha hanqettida gishshas,","poem":2},{"lineBreak":true},{"text":"ta ayfeso neeppe genththadis;","poem":2},{"lineBreak":true},{"text":"gido attiin ta mernaa","poem":2},{"lineBreak":true},{"text":"kiyateththan nees qadhettana»","poem":2},{"lineBreak":true},{"text":"gees nena Wozziza GODAY.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Hayssi taas Nohe wode haaththi","poem":1},{"text":"biitta zaari dhayssontta mala","poem":2},{"lineBreak":true},{"text":"ta caaqqoyssaththo","poem":2},{"lineBreak":true},{"text":"ha7ikka ne bolla zaarada","poem":2},{"lineBreak":true},{"text":"hanqettontta malanne","poem":2},{"lineBreak":true},{"text":"seerontta mala ta caaqqadis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Zumati qaaxxiko,","poem":1},{"text":"zumbullati ba dizasoppe","poem":2},{"lineBreak":true},{"text":"kichchikokka,","poem":2},{"lineBreak":true},{"text":"nees diza ta siiqoy qaaxxenna;","poem":2},{"lineBreak":true},{"text":"nenara ta caaqqida","poem":2},{"lineBreak":true},{"text":"saroteththa qaalay laalettenna»","poem":2},{"lineBreak":true},{"text":"gees nena maariza GODAY.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"GODAY, «Hanne","poem":1},{"text":"un7ettida katamayee!","poem":2},{"lineBreak":true},{"text":"Gote carkon shocettidaaree!","poem":2},{"lineBreak":true},{"text":"minettonttaaree! Be7a,","poem":2},{"lineBreak":true},{"text":"tani nena bonchchettida","poem":2},{"lineBreak":true},{"text":"shuchchatan","poem":2},{"lineBreak":true},{"text":"alleqissa keexxana;","poem":2},{"lineBreak":true},{"text":"semppere shuch nees","poem":2},{"lineBreak":true},{"text":"yoch yeggana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tani ne qustte zo7o inqqun,","poem":1},{"text":"ne pengeta xolqiza inqqutan,","poem":2},{"lineBreak":true},{"text":"ne dirsata bonchchettida","poem":2},{"lineBreak":true},{"text":"shuchchatan ooththana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ne attuma nayti ubbay","poem":1},{"text":"GODAAPPE tamaardayta gidana;","poem":2},{"lineBreak":true},{"text":"ne nayta saroteththika darana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Neni xilloteththan minna eqqana;","poem":1},{"text":"gene ogera aysoy","poem":2},{"lineBreak":true},{"text":"neeppe haakkana.","poem":2},{"lineBreak":true},{"text":"Nena babisiza miishshi deenna;","poem":2},{"lineBreak":true},{"text":"shiroteththi neeppe haakkana;","poem":2},{"lineBreak":true},{"text":"ne matakka shiiqenna.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Oonikka nena qohikko,","poem":1},{"text":"hessi taappe gidenna;","poem":2},{"lineBreak":true},{"text":"nena qohiday diikko","poem":2},{"lineBreak":true},{"text":"ne sinththan kundana;","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«Be7a, xiifay taman bonqqana mala","poem":1},{"text":"womppiina punnizayssa,","poem":2},{"lineBreak":true},{"text":"ola miish qoxxiza wogace","poem":2},{"lineBreak":true},{"text":"medhdhiday tana.","poem":2},{"lineBreak":true},{"text":"Qasse bash gaththana mala","poem":2},{"lineBreak":true},{"text":"medhdhidaykka tana;","poem":2},{"lineBreak":true},{"text":"bashshizayssa","poem":2},{"lineBreak":true},{"text":"medhdhidaykka tana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nena qohanaas oosettida","poem":1},{"text":"miishshi ooththenna.","poem":2},{"lineBreak":true},{"text":"Nena mootiza inxars ubbaa","poem":2},{"lineBreak":true},{"text":"ne laththana;","poem":2},{"lineBreak":true},{"text":"hessa gishshas GODAA aylleta","poem":2},{"lineBreak":true},{"text":"xinxxoy hayssa;","poem":2},{"lineBreak":true},{"text":"istti taappe demmana","poem":2},{"lineBreak":true},{"text":"anjjoy hessa» gees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":17}