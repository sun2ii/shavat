{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"ISA","translationId":"gmv_ltw","name":"Isayaasa Tinbite","commonName":"Isayaasa Tinbite","title":"Isayaasa Tinbite","order":23,"numberOfChapters":66,"sha256":"d074f522a3282bfda9b9144056654f45f094b00e7d7ec2af7b7fb3050350602a","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gmv_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":58,"content":[{"type":"heading","content":["Tumu Xooma"]},{"type":"verse","number":1,"content":["GODAY, «Ne qaalaa",{"text":"dhoqqu histta waassa;","poem":2},{"lineBreak":true},{"text":"aykkoka ashshofa.","poem":2},{"lineBreak":true},{"text":"Ne cenggurssa zaye mala sissa.","poem":2},{"lineBreak":true},{"text":"Ta deraas istta makkallateththa,","poem":2},{"lineBreak":true},{"text":"Yaaqoobe keeththa asaasikka","poem":2},{"lineBreak":true},{"text":"istta nagaraa yoota.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Istti tana hach hach koyeettes;","poem":1},{"text":"ta ogeza eranaas","poem":2},{"lineBreak":true},{"text":"laamotiza misateettes.","poem":2},{"lineBreak":true},{"text":"Suure miish ooththida","poem":2},{"lineBreak":true},{"text":"kawoteththa malanne","poem":2},{"lineBreak":true},{"text":"ba Xoossaa azazo yeggi","poem":2},{"lineBreak":true},{"text":"aggontta dere mala,","poem":2},{"lineBreak":true},{"text":"istti tana","poem":2},{"lineBreak":true},{"text":"suure pirda oychcheettes;","poem":2},{"lineBreak":true},{"text":"Xoossi isttako shiiqanayssa","poem":2},{"lineBreak":true},{"text":"istti dosiza misatees» gees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Istti shiiqidi, «Ne ekkonttaashin","poem":1},{"text":"nu aazas xoomidonii?","poem":2},{"lineBreak":true},{"text":"Ne wudu gonttaashin ays nuna","poem":2},{"lineBreak":true},{"text":"kawushshidonii?» gaana.","poem":2},{"lineBreak":true},{"text":"GODAY zaaridi isttas,","poem":2},{"lineBreak":true},{"text":"«Gidikkoka intte xoomiza gallas","poem":2},{"lineBreak":true},{"text":"intte wozina","poem":2},{"lineBreak":true},{"text":"qofa mala ooththeeta;","poem":2},{"lineBreak":true},{"text":"inttes ooththizaytappe","poem":2},{"lineBreak":true},{"text":"bonqqeeta.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Intte xoomay","poem":1},{"text":"ooshshaninne palaman,","poem":2},{"lineBreak":true},{"text":"gene oosoninne wadhetan polettees;","poem":2},{"lineBreak":true},{"text":"hayssafe sinththan","poem":2},{"lineBreak":true},{"text":"intte xoomizayssa mala","poem":2},{"lineBreak":true},{"text":"hachchife guye intte woosay","poem":2},{"lineBreak":true},{"text":"salon siyettana giidi","poem":2},{"lineBreak":true},{"text":"hidota ooththofte.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tani dooriday hayssa mala xoomaa?","poem":1},{"text":"Asi bana kawushshanay","poem":2},{"lineBreak":true},{"text":"hayssa mala","poem":2},{"lineBreak":true},{"text":"gallas xallaa?","poem":2},{"lineBreak":true},{"text":"Shacca mala bana","poem":2},{"lineBreak":true},{"text":"ziqqi histteththee?","poem":2},{"lineBreak":true},{"text":"woykko maaqa may7idi","poem":2},{"lineBreak":true},{"text":"bidinththaa bolla bululeteththee?","poem":2},{"lineBreak":true},{"text":"Histtiin ne xooma ga","poem":2},{"lineBreak":true},{"text":"xeygizayssi hayssee?","poem":2},{"lineBreak":true},{"text":"GODAY hessa malan ufayettizee?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Be7ite tani doorida xoomay,","poem":1},{"text":"un7ettidayta sansalata","poem":2},{"lineBreak":true},{"text":"intte duuththana mala,","poem":2},{"lineBreak":true},{"text":"qambara wodoro","poem":2},{"lineBreak":true},{"text":"intte birshana mala,","poem":2},{"lineBreak":true},{"text":"un7ettidayta intte","poem":2},{"lineBreak":true},{"text":"la7a yeddana mala,","poem":2},{"lineBreak":true},{"text":"tooho gidida qambara intte","poem":2},{"lineBreak":true},{"text":"menththana mala gidennee?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Qasseka ne qumaappe","poem":1},{"text":"gafidaades shaakkanaas,","poem":2},{"lineBreak":true},{"text":"toylattida manqoza","poem":2},{"lineBreak":true},{"text":"neso gelththanaas,","poem":2},{"lineBreak":true},{"text":"kallottida be7ada mayzanaas,","poem":2},{"lineBreak":true},{"text":"nees asho dabbozas ne sinththi","poem":2},{"lineBreak":true},{"text":"ne tukkontta mala gidennee?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne hessaththo ooththiko ne poo7oy","poem":1},{"text":"wontta xalqqe mala caarana;","poem":2},{"lineBreak":true},{"text":"paxateththi nees eeson gakkana;","poem":2},{"lineBreak":true},{"text":"xilloteththi neeppe","poem":2},{"lineBreak":true},{"text":"sinththara baana;","poem":2},{"lineBreak":true},{"text":"Xoossa bonchchoy","poem":2},{"lineBreak":true},{"text":"nena garadana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"He wode neni xeygana;","poem":1},{"text":"GODAYKKA nees koyana.","poem":2},{"lineBreak":true},{"text":"Neni maado","poem":2},{"lineBreak":true},{"text":"demmanaas waassana;","poem":2},{"lineBreak":true},{"text":"izikka, ‹Ta nees days› gaana.","poem":2},{"lineBreak":true},{"text":"«Ne neeppe metoththiza qambara,","poem":1},{"text":"iita haasayanne","poem":2},{"lineBreak":true},{"text":"biradhdhen malata","poem":2},{"lineBreak":true},{"text":"bessizayssa aggiko,","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"gafidaades ne qadhettiko,","poem":2},{"lineBreak":true},{"text":"qohettidayti kallana mala","poem":2},{"lineBreak":true},{"text":"ne histtiko","poem":2},{"lineBreak":true},{"text":"nees poo7oy dhuma","poem":2},{"lineBreak":true},{"text":"giddon poo7ana;","poem":2},{"lineBreak":true},{"text":"nees dhumidayssika","poem":2},{"lineBreak":true},{"text":"seeta gallassa mala gidana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"GODAY nena ubbatoo kaaleththana;","poem":1},{"text":"away xuuggida biittan","poem":2},{"lineBreak":true},{"text":"ne amo izi kunththana;","poem":2},{"lineBreak":true},{"text":"ne meqeththatakka","poem":2},{"lineBreak":true},{"text":"izi minththana.","poem":2},{"lineBreak":true},{"text":"Neni haath alada atakiltesohonne","poem":2},{"lineBreak":true},{"text":"mulekka to7ontta","poem":2},{"lineBreak":true},{"text":"pultto mala gidana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne dabboti beni yochchata yeggana;","poem":1},{"text":"kase laalettidayta zaari keexxana;","poem":2},{"lineBreak":true},{"text":"neni laalettida gimbe","poem":2},{"lineBreak":true},{"text":"zaari ooraxissizaade,","poem":2},{"lineBreak":true},{"text":"wogga ogeti diza katamata","poem":2},{"lineBreak":true},{"text":"zaari giigsizaade geetettana» gees.","poem":2}]},{"type":"heading","content":["Sambata Bonchchon Beettiza Go7a"]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Qasseka, «Ne tohoti","poem":1},{"text":"sambata shaarontta mala","poem":2},{"lineBreak":true},{"text":"ne shempisikko dummatida","poem":2},{"lineBreak":true},{"text":"ta gallassaan","poem":2},{"lineBreak":true},{"text":"ne wozina qofa ooththontta aggiko,","poem":2},{"lineBreak":true},{"text":"sambata gallassaa ufays,","poem":2},{"lineBreak":true},{"text":"GODAAS dummatida gallassa","poem":2},{"lineBreak":true},{"text":"neni bonchcho gallas","poem":2},{"lineBreak":true},{"text":"ga xeygikko,","poem":2},{"lineBreak":true},{"text":"ne shene mala","poem":2},{"lineBreak":true},{"text":"ne ooththizayssafenne","poem":2},{"lineBreak":true},{"text":"hada yo7oppe ne naagettiko,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"he wode ne GODAAN ufayettana.","poem":2},{"lineBreak":true},{"text":"Biitta bollan dhoqqasohotan","poem":2},{"lineBreak":true},{"text":"ta nena togisana;","poem":2},{"lineBreak":true},{"text":"ne aawa Yaaqoobe xinxxo","poem":2},{"lineBreak":true},{"text":"ne kalla maana mala ooththana»","poem":2},{"lineBreak":true},{"text":"giidi GODAY hayssa","poem":2},{"lineBreak":true},{"text":"ba doonan haasaydes.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/ISA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/ISA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/ISA/57.json","previousChapterAudioLinks":{},"numberOfVerses":14}