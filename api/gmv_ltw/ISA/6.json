{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"ISA","translationId":"gmv_ltw","name":"Isayaasa Tinbite","commonName":"Isayaasa Tinbite","title":"Isayaasa Tinbite","order":23,"numberOfChapters":66,"sha256":"d074f522a3282bfda9b9144056654f45f094b00e7d7ec2af7b7fb3050350602a","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gmv_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":6,"content":[{"type":"heading","content":["Nabeteththas Isayaasa Xeygeteth"]},{"type":"verse","number":1,"content":["Kawo Ooziyay hayqqida layth GODAY dhoqqa araata bolla uttidayssa beyadis; izi may7ida afala macaray Xoossa Keeth kumi uttides."]},{"type":"verse","number":2,"content":["Suraafeele geetettiza kiitanchchati izappe bollara deettes; issi issi suraafeeles usuppun qefeti deettes; nam7u qefetan ba ayfeso ayfeso kammeettes; nam7u qefetan ba toho toho kammeettes; nam7u qefetan piradhdheettes."]},{"type":"verse","number":3,"content":["Issoy issaara,",{"text":"«Geeshshawu, geeshshawu,","poem":1},{"text":"geeshshawu","poem":2},{"lineBreak":true},{"text":"Ubbaafe Wolqqama","poem":2},{"lineBreak":true},{"text":"GODAA Xoossawu!","poem":2},{"lineBreak":true},{"text":"Sa7a ubbay","poem":2},{"lineBreak":true},{"text":"iza bonchchon kumides» gida.","poem":2}]},{"type":"verse","number":4,"content":["Istta qaala cenggurssafe dendidayssan Xoossa Keeththas yochchay qaaxxides; qasseka Xoossa Keeththaa cuway dhippi gi kumides."]},{"type":"verse","number":5,"content":["Histtiin tani, «Tani doonay tunida asa; qasse doonay tunida asata giddon de7ays; tani Kawoza, Ubbaafe Wolqqama GODAA Xoossa ta ayfen be7ida gishshas taas aayye ana! Ta dhayadis» gadis."]},{"type":"verse","number":6,"content":["Histtiin suraafeeletappe issoy yarshizasozappe qaphen tama bonqqo ekkidi piradhdhishe taakko yides."]},{"type":"verse","number":7,"content":["Tamaa bonqqozan ta doonaa bochchidi, «Be7a; hayssi tamaa bonqqozi ne doonaa bochchides; ne mooroy neeppe kichchides; ne nagaraykka qucetti kichchides» gides."]},{"type":"verse","number":8,"content":["Hessafe guye GODAY, «Oona kiittoo? Nuus oonee kiitettanay?» gishin siyadis. Tanikka zaarada, «Hekko, tana kiita» gadis."]},{"type":"verse","number":9,"content":["Histtiin GODAY;",{"text":"«Ba; baada ha asaas,","poem":1},{"text":"‹Intte sissi siyeeta;","poem":2},{"lineBreak":true},{"text":"gido attiin yuushshi qoppeketa;","poem":2},{"lineBreak":true},{"text":"ayfen xeelleeta shin akeekkeketa›","poem":2},{"lineBreak":true},{"text":"gaada isttas yoota.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hayssa deraa wozinaa dammisa;","poem":1},{"text":"istta hayththaka tullisa;","poem":2},{"lineBreak":true},{"text":"istta ayfezakka qooqisa;","poem":2},{"lineBreak":true},{"text":"histtontta aggiko","poem":2},{"lineBreak":true},{"text":"istti bantta ayfen be7ana;","poem":2},{"lineBreak":true},{"text":"bantta hayththan siyana;","poem":2},{"lineBreak":true},{"text":"bantta wozinankka akeekana;","poem":2},{"lineBreak":true},{"text":"histtidi istti taakko","poem":2},{"lineBreak":true},{"text":"simmidi paxana» gides.","poem":2}]},{"type":"verse","number":11,"content":["Tanikka,",{"text":"«Abeet Godawu!","poem":1},{"text":"Hayssi ayde gakkanaas","poem":2},{"lineBreak":true},{"text":"hananee?» gadis.","poem":2},{"lineBreak":true},{"text":"Izikka zaaridi taas,","poem":2},{"lineBreak":true},{"text":"«Katamati isttan de7iza asi","poem":2},{"lineBreak":true},{"text":"dhayiin istti laalettana","poem":2},{"lineBreak":true},{"text":"gakkanaas,","poem":2},{"lineBreak":true},{"text":"keeththatikka ubbay","poem":2},{"lineBreak":true},{"text":"kayzana gakkanaassinne","poem":2},{"lineBreak":true},{"text":"biittayka mulera aykkoy baynda","poem":2},{"lineBreak":true},{"text":"bula gidana gakkanaassa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tani GODAY asaa","poem":1},{"text":"haassana gakkanaassa;","poem":2},{"lineBreak":true},{"text":"biittaaka aykkoy baynda","poem":2},{"lineBreak":true},{"text":"bazzo kessana gakkanaassa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tammu asaappe issi asi","poem":1},{"text":"biittaa bolla attiko,","poem":2},{"lineBreak":true},{"text":"izikka dhayana;","poem":2},{"lineBreak":true},{"text":"qanxxi yeggiin attida","poem":2},{"lineBreak":true},{"text":"wolaa duruma mala gidana;","poem":2},{"lineBreak":true},{"text":"geeshsha zarey hessaththo","poem":2},{"lineBreak":true},{"text":"he duruma mala gidana» gides.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/ISA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/ISA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/ISA/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}