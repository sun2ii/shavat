true},{"text":"hara Xoos be7ida ayfeynne","poem":2},{"lineBreak":true},{"text":"siyida hayththi mulekka deenna.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Suure miish ufayssan","poem":1},{"text":"ooththizaytanne","poem":2},{"lineBreak":true},{"text":"ne oge qoppizayta","poem":2},{"lineBreak":true},{"text":"neni maaddaasa;","poem":2},{"lineBreak":true},{"text":"gido attiin nuni istta bolla","poem":2},{"lineBreak":true},{"text":"pacey baynda","poem":2},{"lineBreak":true},{"text":"nagara ooththida gishshas","poem":2},{"lineBreak":true},{"text":"hekko neni nu bolla","poem":2},{"lineBreak":true},{"text":"hanqettadasa;","poem":2},{"lineBreak":true},{"text":"histtiin nuni waani","poem":2},{"lineBreak":true},{"text":"attana dandayzonii?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nuni ubbayka","poem":1},{"text":"tuna asa mala gididos;","poem":2},{"lineBreak":true},{"text":"nu xilloteththa ooso ubbay","poem":2},{"lineBreak":true},{"text":"tunida carqqa mala.","poem":2},{"lineBreak":true},{"text":"Nuni ubbayka","poem":2},{"lineBreak":true},{"text":"boncco mala qokkidos;","poem":2},{"lineBreak":true},{"text":"nu nagaray nuna carko mala","poem":2},{"lineBreak":true},{"text":"pitti efides.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Oonikka woosan","poem":1},{"text":"ne sunth xeygenna;","poem":2},{"lineBreak":true},{"text":"nena oykkana","poem":2},{"lineBreak":true},{"text":"paaccizaykka deenna;","poem":2},{"lineBreak":true},{"text":"neni ne ayfeso","poem":2},{"lineBreak":true},{"text":"nuuppe genththadasa;","poem":2},{"lineBreak":true},{"text":"nu nagaray nuna","poem":2},{"lineBreak":true},{"text":"dhayssana mala aggadasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gidikkoka abeet GODAWU,","poem":1},{"text":"neni nuus aawa; nuni urqqata;","poem":2},{"lineBreak":true},{"text":"neni nuna medhdhidayssa;","poem":2},{"lineBreak":true},{"text":"nuni ubbayka","poem":2},{"lineBreak":true},{"text":"ne kushen medhettidayta.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abeet GODAWU, keeha hanqettofa;","poem":1},{"text":"nu nagaraakka mernaas qoppofa;","poem":2},{"lineBreak":true},{"text":"nuus woosetta;","poem":2},{"lineBreak":true},{"text":"nu ubbay ne dere gidida gishshas","poem":2},{"lineBreak":true},{"text":"ne ayfeso nuukko haa zaara.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne geeshsha katamati aykkoy baynda","poem":1},{"text":"bazzo gidida;","poem":2},{"lineBreak":true},{"text":"Xiyoonakka aykkoy baynda","poem":2},{"lineBreak":true},{"text":"bazzo biitta gidadus;","poem":2},{"lineBreak":true},{"text":"Yerusalaameykka yegetta attadus.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nu aawati kase nena","poem":1},{"text":"izan galatiza Xoossa Keeththay","poem":2},{"lineBreak":true},{"text":"taman xuugettides;","poem":2},{"lineBreak":true},{"text":"kase lo7osoti ubbatikka dhayda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abeet GODAWU,","poem":1},{"text":"hayssi ubbay haniinkka","poem":2},{"lineBreak":true},{"text":"ne simmikii?","poem":2},{"lineBreak":true},{"text":"Neni co7u gaada nuna","poem":2},{"lineBreak":true},{"text":"zaway baynda qixaate qaxxayay?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/ISA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/ISA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/ISA/63.json","previousChapterAudioLinks":{},"numberOfVerses":12}