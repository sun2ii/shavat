{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"ISA","translationId":"gmv_ltw","name":"Isayaasa Tinbite","commonName":"Isayaasa Tinbite","title":"Isayaasa Tinbite","order":23,"numberOfChapters":66,"sha256":"d074f522a3282bfda9b9144056654f45f094b00e7d7ec2af7b7fb3050350602a","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gmv_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":66,"content":[{"type":"heading","content":["Pirdanne Hidota"]},{"type":"verse","number":1,"content":["GODAY, «Saloy taas araata;",{"text":"sa7aykka taas yedhdhizaso;","poem":2},{"lineBreak":true},{"text":"histtiin intte taas","poem":2},{"lineBreak":true},{"text":"keexxana keeththinne","poem":2},{"lineBreak":true},{"text":"ta shemppana soy awayssee?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hayta ubbaa","poem":1},{"text":"ta kushey ooththibeennee?","poem":2},{"lineBreak":true},{"text":"Hayti beettana mala ooththiday","poem":2},{"lineBreak":true},{"text":"tana gidikkinaa?","poem":2},{"lineBreak":true},{"text":"Tani ashke;","poem":2},{"lineBreak":true},{"text":"wozinay meqqidaadenne","poem":2},{"lineBreak":true},{"text":"ta qaalaska kokkorizaadeko","poem":2},{"lineBreak":true},{"text":"ta xeellays.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«Gido attiin taas boora yarshizaadey","poem":1},{"text":"as wodhizaade mala,","poem":2},{"lineBreak":true},{"text":"dorsa laaqqa yarshizaadey","poem":2},{"lineBreak":true},{"text":"kana cuulli wodhiza asa mala;","poem":2},{"lineBreak":true},{"text":"kaththa yarsho shiishshizaadey,","poem":2},{"lineBreak":true},{"text":"guddunththa suuth","poem":2},{"lineBreak":true},{"text":"shiishshizaade mala;","poem":2},{"lineBreak":true},{"text":"qofsos exaane taas cu7asizaadey,","poem":2},{"lineBreak":true},{"text":"eeqa xoos goynniza asa mala;","poem":2},{"lineBreak":true},{"text":"istti bantta oge doorida;","poem":2},{"lineBreak":true},{"text":"istta shemppoyakka","poem":2},{"lineBreak":true},{"text":"istta tunateththan ufayettawus.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hessa gishshas meto","poem":1},{"text":"ta istta bolla gaththana;","poem":2},{"lineBreak":true},{"text":"istti yayyida miishshika","poem":2},{"lineBreak":true},{"text":"ta istta bolla ehana;","poem":2},{"lineBreak":true},{"text":"gaasoykka ta xeygiza wode","poem":2},{"lineBreak":true},{"text":"istti koyibeettenna;","poem":2},{"lineBreak":true},{"text":"ta yootishin istti ezgibeettenna;","poem":2},{"lineBreak":true},{"text":"ta sinththan iita miish ooththida;","poem":2},{"lineBreak":true},{"text":"tana iitiza miish doorida» gees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Intteno qaalaas kokkorizaytoo,","poem":1},{"text":"hayssa GODAA qaala siyite;","poem":2},{"lineBreak":true},{"text":"«Intte ishantti inttena ixxidaytoo,","poem":2},{"lineBreak":true},{"text":"ta sunththa gishshas","poem":2},{"lineBreak":true},{"text":"inttena kessi yeggidaytoo!","poem":2},{"lineBreak":true},{"text":"Inttena, ‹Ane GODAY","poem":2},{"lineBreak":true},{"text":"bonchchettoo!","poem":2},{"lineBreak":true},{"text":"Ane intte ufayssaaka be7oos› gida;","poem":2},{"lineBreak":true},{"text":"gidikkoka istti","poem":2},{"lineBreak":true},{"text":"yeellatanayssi attenna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hessa kataman diza waasoza siyite;","poem":1},{"text":"Xoossa keeththan diza","poem":2},{"lineBreak":true},{"text":"caabba siyite;","poem":2},{"lineBreak":true},{"text":"hessika GODAA cenggurssa;","poem":2},{"lineBreak":true},{"text":"izi ba morkketas","poem":2},{"lineBreak":true},{"text":"bessiza waaga qanxxana.","poem":2}]},{"type":"verse","number":7,"content":["Miixattanaappe kaseta yelawus;",{"text":"miixa waaye be7ontta dashe","poem":2},{"lineBreak":true},{"text":"attuma naa yelawus.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hessa mala yo7o siyi erizay oonee?","poem":1},{"text":"Hessa mala yo7o","poem":2},{"lineBreak":true},{"text":"be7i erizay oonee?","poem":2},{"lineBreak":true},{"text":"Derey issi gallas medhetti erizee?","poem":2},{"lineBreak":true},{"text":"Woykko kawoteththati","poem":2},{"lineBreak":true},{"text":"qiphida ayfey","poem":2},{"lineBreak":true},{"text":"xeellanaashe gakkanaas","poem":2},{"lineBreak":true},{"text":"beetti erizoo?","poem":2},{"lineBreak":true},{"text":"Xiyoono buro miixay oykkishin","poem":2},{"lineBreak":true},{"text":"heerakka ba nayta yelawus.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yelettana matidayssa","poem":1},{"text":"yelettontta mala","poem":2},{"lineBreak":true},{"text":"tani diggazinaa?» gees GODAY.","poem":2},{"lineBreak":true},{"text":"«Yelishin yeliza ulo","poem":2},{"lineBreak":true},{"text":"ta gorda erazinaa?»","poem":2},{"lineBreak":true},{"text":"gees ne GODAY.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"«Intteno Yerusalaamo","poem":1},{"text":"siiqiza ubbatoo,","poem":2},{"lineBreak":true},{"text":"izira ufayettite;","poem":2},{"lineBreak":true},{"text":"intte izira hombocite;","poem":2},{"lineBreak":true},{"text":"izis yeekkida ubbati","poem":2},{"lineBreak":true},{"text":"izira keehi ufayettite.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Minththeththiza izi dhanththaa","poem":1},{"text":"intte dhammidi kallana;","poem":2},{"lineBreak":true},{"text":"inttes gidanaashe gakkanaas","poem":2},{"lineBreak":true},{"text":"intte uyana;","poem":2},{"lineBreak":true},{"text":"keehippe daro gidida","poem":2},{"lineBreak":true},{"text":"izi dureteththan","poem":2},{"lineBreak":true},{"text":"intte ufayettana» gees GODAY.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"GODAY, «Be7ite,","poem":1},{"text":"tani izis saroteth","poem":2},{"lineBreak":true},{"text":"gita shaafa mala gogisana;","poem":2},{"lineBreak":true},{"text":"kawoteththata aqota","poem":2},{"lineBreak":true},{"text":"shaafa haaththa mala gogisana","poem":2},{"lineBreak":true},{"text":"intte izi ki7on","poem":2},{"lineBreak":true},{"text":"idimetti dhammana;","poem":2},{"lineBreak":true},{"text":"izi ki7on uttidi intte guppana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Aaya ba naa al7isiza mala","poem":1},{"text":"takka inttena al7isana;","poem":2},{"lineBreak":true},{"text":"intte Yerusalaamen","poem":2},{"lineBreak":true},{"text":"minettana» gees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Intte hessa be7iza wode","poem":1},{"text":"intte wozinay ufayettana;","poem":2},{"lineBreak":true},{"text":"intte meqeththaykka","poem":2},{"lineBreak":true},{"text":"maata mala cililana;","poem":2},{"lineBreak":true},{"text":"qasse GODAA kushey","poem":2},{"lineBreak":true},{"text":"iza aylleta bolla dizayssi erettana;","poem":2},{"lineBreak":true},{"text":"iza hanqoy gidikko","poem":2},{"lineBreak":true},{"text":"iza morkketa bolla qonccana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Hekko GODAY tama lacon yaana;","poem":1},{"text":"iza para-gaareti gote carko mala;","poem":2},{"lineBreak":true},{"text":"izi ba yiillo hanqon,","poem":2},{"lineBreak":true},{"text":"ba seera tama lacon qonccisana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tamaninne mashshan","poem":1},{"text":"GODAY ba pirdaa","poem":2},{"lineBreak":true},{"text":"asa ubbaa bolla ehana;","poem":2},{"lineBreak":true},{"text":"daroti GODAA","poem":2},{"lineBreak":true},{"text":"mashshan shukettana.","poem":2}]},{"type":"verse","number":17,"content":["GODAY, «Atakiltey dizasoho biidi isttafe issaas goynnanaas bana geeshshizaytinne dummasizayti, guddunththa ashonne ecere asho, tunida miishshata miza ubbati ba pirda wurseththan issife ekkana» gees."]},{"type":"verse","number":18,"content":["«Tani istta oosonne istta qofa eriza gishshas, kawoteththata ubbaanne dumma dumma qaalan haasayza ubbata issife shiishshanaas yaana; isttika yiidi ta bonchcho be7ana."]},{"type":"verse","number":19,"content":["Tani istta giddon malata ooththana; isttafe attida issi issineta gede kawoteththatakko, Tarseese, Puuxe, wondafen olettiza erettida Luudetakko, Tubaalenne Yaawaane hessaththoka ta goobateththaa siyonttaytakkonne ta bonchcho beyonttaytakko haakon diza abba giddon diza harurotakko ta yeddana; ta bonchcho kawoteththata giddon yootana."]},{"type":"verse","number":20,"content":["GODAAS yarsho gidana mala intte ishata ubbata kawoteththatappe bonchchettida ta zumaa Yerusalaame paran, para-gaareninne gaaren, baquloninne gaamellan istta ehana. Isra7eele asay kaththa yarsho wogan diza mala geeshsha miishshan woththidi GODAA Keeth shiishshiza mala haytakka shiishshana."]},{"type":"verse","number":21,"content":["Tanikka isttafe baggayta qeesetanne Leweta gidana mala ta doorana» gees."]},{"type":"verse","number":22,"content":["GODAY, «Tani medhdhana ooraththa salotinne ooraththa sa7ay ta sinththan minni daanayssaththo intte sunththinne intte zereththa sunththi hessaththo minni daana."]},{"type":"verse","number":23,"content":["Agina xeeroppe biidi hara aginay xeerana gakkanaas, issi Sambatappe biidi hara Sambata gakkanaas, as gidida ubbay taas goynnana yaana."]},{"type":"verse","number":24,"content":["Istti kezidi ta bolla makkallida asata aha be7ana. Istta miza guxuneykka hayqqenna; istta miza tamaykka to7enna. Istti asa zereth ubbaas harassizaaz gidana» gees."]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/ISA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/JER/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/ISA/65.json","previousChapterAudioLinks":{},"numberOfVerses":24}