{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"ISA","translationId":"gmv_ltw","name":"Isayaasa Tinbite","commonName":"Isayaasa Tinbite","title":"Isayaasa Tinbite","order":23,"numberOfChapters":66,"sha256":"d074f522a3282bfda9b9144056654f45f094b00e7d7ec2af7b7fb3050350602a","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gmv_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":8,"content":[{"type":"heading","content":["Asoore Kawo Yuus"]},{"type":"verse","number":1,"content":["GODAY tana, «Gita xaaththa waraqata ekkada, ‹Maher-shalal hash-baaz›",{"noteId":2},"gaada nababettiza pidalen xaafa."]},{"type":"verse","number":2,"content":["Qeese Ooriyanne Baarakiyo naa Zakaraasa taas ammanettida markkata gidana mala ta istta xeygana» gides."]},{"type":"verse","number":3,"content":["Hessafe guye ba machcho nabeyra aqides; izakka shaarada attuma naa yeladus; histtiin GODAY tana, «Iza sunththaa, ‹Maher-shalal hash-baaz› gaada sunththa."]},{"type":"verse","number":4,"content":["Naazi, ‹Aabboo! Aayee!› gi xeys eranaappe kase Asoore biitta kawoy Samaariyanne Damasqo aqota di7i efana» gides."]},{"type":"line_break"},{"type":"verse","number":5,"content":["Qasseka GODAY taas,"]},{"type":"verse","number":6,"content":[{"text":"«Ha derey co7u gi goggiza","poem":1},{"text":"Selihoome haaththata","poem":2},{"lineBreak":true},{"text":"aggidi Eraasooneninne","poem":2},{"lineBreak":true},{"text":"Eromeliyo naazan ufayettides.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hessa gishshas","poem":1},{"text":"tani GODAY minonne","poem":2},{"lineBreak":true},{"text":"wolqqama gidida","poem":2},{"lineBreak":true},{"text":"Efiraaxise haaththa haro,","poem":2},{"lineBreak":true},{"text":"Asoore kawo iza teemaranne","poem":2},{"lineBreak":true},{"text":"bonchchozara istta bolla ehana;","poem":2},{"lineBreak":true},{"text":"haaththazi shaafaza","poem":2},{"lineBreak":true},{"text":"kumi polchchidi","poem":2},{"lineBreak":true},{"text":"shaafa doonan diza","poem":2},{"lineBreak":true},{"text":"biitta ubbaa mittana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Buuri ekkidi","poem":1},{"text":"duge Yuhuda wodhdhana;","poem":2},{"lineBreak":true},{"text":"biittaa kumidi aadhdhana;","poem":2},{"lineBreak":true},{"text":"qoodhe gakkanaas","poem":2},{"lineBreak":true},{"text":"mittana» gides.","poem":2},{"lineBreak":true},{"text":"Gido attiin Amanu7eelee!","poem":2},{"lineBreak":true},{"text":"Micettida iza qefey","poem":2},{"lineBreak":true},{"text":"ne biittaa gaxappe","poem":2},{"lineBreak":true},{"text":"gaxa gakkanaas","poem":2},{"lineBreak":true},{"text":"kammi oykkides.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Intteno kawoteththatoo!","poem":1},{"text":"Olas dendidi waassite;","poem":2},{"lineBreak":true},{"text":"intte dippi gaana;","poem":2},{"lineBreak":true},{"text":"haaho deren dizayti ezgite!","poem":2},{"lineBreak":true},{"text":"Olaska giigettite!","poem":2},{"lineBreak":true},{"text":"Intte dippi gaana;","poem":2},{"lineBreak":true},{"text":"Olaska giigettite!","poem":2},{"lineBreak":true},{"text":"Intte meqerettana;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Olas zorettite;","poem":1},{"text":"gido attiin inttes suurenna;","poem":2},{"lineBreak":true},{"text":"halchcho kessite;","poem":2},{"lineBreak":true},{"text":"gido attiin inttes minnenna.","poem":2},{"lineBreak":true},{"text":"Gaasoykka Xoossay nunara dees.","poem":2}]},{"type":"heading","content":["Godaan Ammaneteth"]},{"type":"verse","number":11,"content":["GODAY ba mino kushe ta bolla woththidi tani ha asaa oge kaallontta mala seerides;"]},{"type":"verse","number":12,"content":[{"text":"«Hayssi asay, ‹Iita maqqo›","poem":1},{"text":"gi xeygiza miish","poem":2},{"lineBreak":true},{"text":"intte aykkoka,","poem":2},{"lineBreak":true},{"text":"‹Iita maqqo› goopite;","poem":2},{"lineBreak":true},{"text":"istti babbizayssas intte babbofte;","poem":2},{"lineBreak":true},{"text":"izas yarkiyarkofte.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Intte dummasana bessizay","poem":1},{"text":"Ubbaafe Wolqqama GODAA xalla;","poem":2},{"lineBreak":true},{"text":"intte yayyanaassinne","poem":2},{"lineBreak":true},{"text":"kokkoranaas bessizay iza.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Izi geeshshasoho gidana;","poem":1},{"text":"gido attiin izi","poem":2},{"lineBreak":true},{"text":"Yuhuda biittaa asaassinne","poem":2},{"lineBreak":true},{"text":"Isra7eele keeththaa asaas","poem":2},{"lineBreak":true},{"text":"dhuphiza shuchchinne","poem":2},{"lineBreak":true},{"text":"kundisiza zaalla gidana;","poem":2},{"lineBreak":true},{"text":"Yerusalaamen diza asaas","poem":2},{"lineBreak":true},{"text":"izi gitenne woximade gidana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Isttafe daroti dhuphettana;","poem":1},{"text":"kundidikka meqqana;","poem":2},{"lineBreak":true},{"text":"woximaden","poem":2},{"lineBreak":true},{"text":"geli oykettana» gides.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Markkateththaa lo7eththa oykka;","poem":1},{"text":"ta tamaareta giddon","poem":2},{"lineBreak":true},{"text":"wogaa maatamen shoca.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tani ba sinth Yaaqoobe zaretappe","poem":1},{"text":"genththida GODAA naagana;","poem":2},{"lineBreak":true},{"text":"izakka hidota ooththana.","poem":2}]},{"type":"verse","number":18,"content":["Tananne taas GODAY immida nayta be7ite. Nuni Xiyoone zuman diza Ubbaafe Wolqqama GODAAPPE Isra7eeles malatanne markka."]},{"type":"verse","number":19,"content":["Asay inttena, «Bessonttaaz tattafettishenne Saasukettishe haasayettiza bitizaytanne moytille xeygizayta oychchite» giikko derey ba GODAA oychchanaas bessennee? De7o Xoossaa aggidi hayqqidayta oysho ays koshshizee?"]},{"type":"verse","number":20,"content":["Wogaakkonne markkateththa qaalaakko biite! Istti hayssa mala qaala inttes yootontta aggiko wontta poo7oy isttas poo7enna."]},{"type":"verse","number":21,"content":["Istti ceecishenne gafishe biitta bolla toylattana; istti keehi gafida wode hanqettana; pude xeellidi bantta kawaanne bantta Xoossaa qanggana."]},{"type":"verse","number":22,"content":["Hessafe guye istti duge biitta xeellana; istti xeellanayssika waaye, dhumanne dhippi gida babisiza miish xalla; istti girdi gida dhuman yegettana."]}],"footnotes":[{"noteId":2,"caller":"+","text":"Maher-shalal hash-baaz guussi di7anaassinne bonqqanaas elela.","reference":{"chapter":8,"verse":1}}]},"thisChapterLink":"/api/gmv_ltw/ISA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/ISA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/ISA/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}