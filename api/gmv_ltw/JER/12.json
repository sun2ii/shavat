{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"JER","translationId":"gmv_ltw","name":"Ermaasa Tinbite","commonName":"Ermaasa Tinbite","title":"Ermaasa Tinbite","order":24,"numberOfChapters":52,"sha256":"93dc341c498dc777b4574d7579ba75f7c63468149d8f420fcbf8b21a8a3d04cc","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gmv_ltw/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":12,"content":[{"type":"heading","content":["Ermaasa Oysha"]},{"type":"verse","number":1,"content":[{"text":"Abeet GODAWU!","poem":1},{"text":"Tani nenara palamettiza wode","poem":2},{"lineBreak":true},{"text":"ubbaankka ne xillo.","poem":2},{"lineBreak":true},{"text":"Iita asati ooththizayssi","poem":2},{"lineBreak":true},{"text":"isttas ays injjetizee?","poem":2},{"lineBreak":true},{"text":"Ammanettonttayti","poem":2},{"lineBreak":true},{"text":"ays ishalo duus dizoo?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Neni istta tokkadasa;","poem":1},{"text":"histtiin xapho yeddida;","poem":2},{"lineBreak":true},{"text":"diccidi ayfe ayfida.","poem":2},{"lineBreak":true},{"text":"Istti nena doonappe yeggettenna;","poem":2},{"lineBreak":true},{"text":"neni gidikko istta wozinappe","poem":2},{"lineBreak":true},{"text":"haakon daasa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gido attiin abeet GODAWU!","poem":1},{"text":"Neni tana eraasa.","poem":2},{"lineBreak":true},{"text":"Tana be7aasa;","poem":2},{"lineBreak":true},{"text":"tani nees","poem":2},{"lineBreak":true},{"text":"ay qoppizaakko paaccaasa.","poem":2},{"lineBreak":true},{"text":"Shukettana biza dorsata mala","poem":2},{"lineBreak":true},{"text":"neni istta laagga!","poem":2},{"lineBreak":true},{"text":"Shuka gallassas istta dumma","poem":2},{"lineBreak":true},{"text":"shaakka woththa!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iray dhayiin biittay","poem":1},{"text":"ayde gakkanaas melanee?","poem":2},{"lineBreak":true},{"text":"Maataykka","poem":2},{"lineBreak":true},{"text":"ayde gakkanaas melanee?","poem":2},{"lineBreak":true},{"text":"Asaa iitateththaafe dendidayssan","poem":2},{"lineBreak":true},{"text":"medosatinne kafoti dhayda.","poem":2},{"lineBreak":true},{"text":"Hessa bollaka asay,","poem":2},{"text":"«GODAY nuni ooththizayssa","poem":1},{"text":"demmenna» gees.","poem":2}]},{"type":"heading","content":["Goday Ermaasa Oyshaas Immida Zaaro"]},{"type":"verse","number":5,"content":[{"text":"GODAY Ermaasas,","poem":1},{"text":"«Neni tohon woxxiza asatara","poem":2},{"lineBreak":true},{"text":"woxxada daaburkko","poem":2},{"lineBreak":true},{"text":"parara waana gaadde woxxanee?","poem":2},{"lineBreak":true},{"text":"Neni saro biittan dhuphettiko,","poem":2},{"lineBreak":true},{"text":"Yordaanoose wora garsan","poem":2},{"lineBreak":true},{"text":"waana hemettanee?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne ishatinne ne soho asati","poem":1},{"text":"nena hilida;","poem":2},{"lineBreak":true},{"text":"ne bolla waassida;","poem":2},{"lineBreak":true},{"text":"hessa gishshas istti nees","poem":2},{"lineBreak":true},{"text":"lo7o haasaykkoka","poem":2},{"lineBreak":true},{"text":"ne istta ammanoppa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tani ta keeththaa aggana;","poem":1},{"text":"ta xinxxoyokka yegga aggana;","poem":2},{"lineBreak":true},{"text":"tani ta siiqiza asaa","poem":2},{"lineBreak":true},{"text":"istta morkketa kushen","poem":2},{"lineBreak":true},{"text":"aaththa immana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ta xinxxoya","poem":1},{"text":"wora giddon diza gaammo mala","poem":2},{"lineBreak":true},{"text":"ta bolla dendadus;","poem":2},{"lineBreak":true},{"text":"ta bollaka xaaggadus;","poem":2},{"lineBreak":true},{"text":"hessa gishshas tani izo ixxadis.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ta xinxxoya phircoti","poem":1},{"text":"maana giddoththida","poem":2},{"lineBreak":true},{"text":"kafo mala gidabeekkee?","poem":2},{"lineBreak":true},{"text":"Biidi wora do7ata","poem":2},{"lineBreak":true},{"text":"ubbaa shiishshite;","poem":2},{"lineBreak":true},{"text":"istti izo duuththeththi","poem":2},{"lineBreak":true},{"text":"maana mala xeygite.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Daro heenththanchchati","poem":1},{"text":"ta woyne tura soho moorida;","poem":2},{"lineBreak":true},{"text":"tani izan ufayettiza","poem":2},{"lineBreak":true},{"text":"ta gadeza bulasida.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"He biittay ta sinththan","poem":1},{"text":"bazzo, bulanne","poem":2},{"lineBreak":true},{"text":"mela biitta gidana;","poem":2},{"lineBreak":true},{"text":"izis qoppizay baynda gishshas","poem":2},{"lineBreak":true},{"text":"biittaya bazzo gidana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bazzon diza zumbullata bollafe","poem":1},{"text":"dhayssizayti yaana;","poem":2},{"lineBreak":true},{"text":"gaasoykka GODAA","poem":2},{"lineBreak":true},{"text":"mashshay biitta","poem":2},{"lineBreak":true},{"text":"ha gaxaappe","poem":2},{"lineBreak":true},{"text":"he gaxa gakkanaas maana.","poem":2},{"lineBreak":true},{"text":"Hessa gishshas","poem":2},{"lineBreak":true},{"text":"oonikka attanaas dandayenna.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Istti gistte zeridi","poem":1},{"text":"agunth cakkana;","poem":2},{"lineBreak":true},{"text":"istti daro daaburanaashin","poem":2},{"lineBreak":true},{"text":"aykkoka demmettenna;","poem":2},{"lineBreak":true},{"text":"daro zeridi GODAA hanqo","poem":2},{"lineBreak":true},{"text":"gaason intte guuth","poem":2},{"lineBreak":true},{"text":"demmidi yeellatana» gides.","poem":2}]},{"type":"verse","number":14,"content":["GODAY, «Tani ta dere Isra7eeles immida xinxxo biitta oykkiza iita shoorota tani istta istta biittafe dhoqallana. Qasse Yuhuda asatakka istta giddofe dhoqallana."]},{"type":"verse","number":15,"content":["Gido attiin tani istta istta biittafe dhoqallidaappe guye zaarada maarana; tani istta dereninne istta xinxxon xinxxon zaara ehana."]},{"type":"verse","number":16,"content":["Kase ta asaa Ba7aale sunththan caaqqana mala tamaarsoyssaththoka, ‹GODAY be7iin!› giidi ta sunththan caaqqiko istti ta asaa giddon xaphphidi daana."]},{"type":"verse","number":17,"content":["Ta gizaaz ekkontta kawoteththi diikko ta iza mulera dhoqalla dhayssana» gees."]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/JER/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/JER/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/JER/11.json","previousChapterAudioLinks":{},"numberOfVerses":17}