{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"JER","translationId":"gmv_ltw","name":"Ermaasa Tinbite","commonName":"Ermaasa Tinbite","title":"Ermaasa Tinbite","order":24,"numberOfChapters":52,"sha256":"93dc341c498dc777b4574d7579ba75f7c63468149d8f420fcbf8b21a8a3d04cc","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gmv_ltw/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":13,"content":[{"type":"heading","content":["Laynoppe Oosettida Dancco"]},{"type":"verse","number":1,"content":["GODAY tana, «Baada laynoppe oosettida dancco shammada ne xeessan dancca; gido attiin haaththan boshisoppa» gides."]},{"type":"verse","number":2,"content":["Hessa gishshas tani GODAY azazida mala dancco shammada ta xeessan danccadis."]},{"type":"verse","number":3,"content":["GODAA qaalay nam7anththo taakko yiidi,"]},{"type":"verse","number":4,"content":["«Neni shamma danccida danccoza ekkada Efiraaxise Shaafa ba; histtada zaalla za7a giddon qotta» gides."]},{"type":"verse","number":5,"content":["Histtiin tani GODAY taas yootida mala efada Efiraaxise Shaafa lanqen qottadis."]},{"type":"verse","number":6,"content":["Daro gallassafe guye GODAY, «Denda Efiraaxise Shaafa baada tani nena, ‹Heen qotta› gida danccoza kessa» gides."]},{"type":"verse","number":7,"content":["Histtiin tani Efiraaxise Shaafa ba bookkada danccoza ta qottidaasoppe kessadis; gido attiin he danccozi moorettidi mulera go7onttaaz gidides."]},{"type":"verse","number":8,"content":["Hessafe guye GODAA qaalay taakko yiidi,"]},{"type":"verse","number":9,"content":["«GODAY tani Yuhuda asaa otoreteththinne Yerusalaame asaa ceeqeteth hessa mala dhayssana."]},{"type":"verse","number":10,"content":["Ta qaala siyontta ixxidi, bantta wozina muumeteththa kaallidi, eeqa xoossatas ooththanaassinne goynnanaas biza ha iita asay hayssa danccoza mala mulekka go7onttayssa gidana."]},{"type":"verse","number":11,"content":["Danccoy asa xeessa baqqi oykkiza mala Yuhuda asay ubbaynne Isra7eele asay ubbay taakko shiphphi gaana malanne ta sunththas galatanne bonchcho immana mala ta ooththiin istti ta gizaaz siyibeettenna» gees."]},{"type":"heading","content":["Woyne Ushsha Oto"]},{"type":"verse","number":12,"content":["Qasseka GODAA Isra7eele Xoossay, «Ermaasa! Asaas, ‹Oto ubbaan woyne ushshay kumana› gees. Istti nees zaaridi, ‹Oto ubbaan woyne ushshi kumanayssa waani nu erokkonii?› giikko,"]},{"type":"verse","number":13,"content":["neni isttas, ‹GODAY tani ha biittan diza asaa ubbaa, Dawite kawoteththa araatan uttiza kawota, qeeseta, nabetanne Yerusalaamen diza asaa ubbaaka ta woyne ushshan maththosana."]},{"type":"verse","number":14,"content":["Tani issi as hara asara, aawa naara ooshshana; tani istta dhayssana attiin isttas mishettike; qadhettikenne maarikke› gees ga» gides."]},{"type":"heading","content":["Otoreteththi Ehiza Ayfe"]},{"type":"verse","number":15,"content":[{"text":"GODAY yootides;","poem":1},{"text":"wozinan woththi siyite;","poem":2},{"lineBreak":true},{"text":"aggite otoranchcha gidopite.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Izi dhuma ehontta dishin","poem":1},{"text":"dhumida zumata bolla intte tohoy","poem":2},{"lineBreak":true},{"text":"dhuphettontta dishin","poem":2},{"lineBreak":true},{"text":"GODAAS intte Xoossas","poem":2},{"lineBreak":true},{"text":"bonchcho immite;","poem":2},{"lineBreak":true},{"text":"Intte, «Poo7oy yaana»","poem":2},{"lineBreak":true},{"text":"giidi naageeta;","poem":2},{"lineBreak":true},{"text":"gido attiin","poem":2},{"lineBreak":true},{"text":"izi dhuman laammana;","poem":2},{"lineBreak":true},{"text":"sakkanna dhuma ooththana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Intte siyontta ixxiko,","poem":1},{"text":"intte otoreteththaa gishshas","poem":2},{"lineBreak":true},{"text":"ta shemppoya geeman yeekkana;","poem":2},{"lineBreak":true},{"text":"GODAA wudey","poem":2},{"lineBreak":true},{"text":"di7etti bichchida gishshas","poem":2},{"lineBreak":true},{"text":"tani camo yeeho yeekkays;","poem":2},{"lineBreak":true},{"text":"ta ayfeppe afunththi","poem":2},{"lineBreak":true},{"text":"haaththa mala goggees.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"GODAY tana, «Kawozasinne","poem":1},{"text":"iza aayo godatteys,","poem":2},{"lineBreak":true},{"text":"‹Intte bonchcho kallachchay","poem":2},{"lineBreak":true},{"text":"intte hu7eppe","poem":2},{"lineBreak":true},{"text":"wodhdhana gishshas,","poem":2},{"lineBreak":true},{"text":"intte kawoteththa araataappe","poem":2},{"lineBreak":true},{"text":"duge wodhdhite.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Negebe biittan diza katamati","poem":1},{"text":"ubbay gordettana.","poem":2},{"lineBreak":true},{"text":"Istta doyanaadeyka deenna;","poem":2},{"lineBreak":true},{"text":"Yuhuda asay ubbay","poem":2},{"lineBreak":true},{"text":"di7ettidi baana;","poem":2},{"lineBreak":true},{"text":"istta ogeykka","poem":2},{"lineBreak":true},{"text":"gordettana› ga» gides.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Qasseka GODAY, «Ane dhoqqu giidi","poem":1},{"text":"pudeha baggafe yizayta xeellite;","poem":2},{"lineBreak":true},{"text":"inttes imettida wudey,","poem":2},{"lineBreak":true},{"text":"intte ceeqettiza dorsati","poem":2},{"lineBreak":true},{"text":"awan dizoo?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Neni nees dabbo gidana mala","poem":1},{"text":"koyidayti nena xoonidi","poem":2},{"lineBreak":true},{"text":"haariza wode","poem":2},{"lineBreak":true},{"text":"ne ay gaanee?","poem":2},{"lineBreak":true},{"text":"Yelo miixay oykkida","poem":2},{"lineBreak":true},{"text":"maccassa mala","poem":2},{"lineBreak":true},{"text":"nena miixay oykkennee?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Neni ne wozinan,","poem":1},{"text":"‹Hayssi ubbay ta bolla","poem":2},{"lineBreak":true},{"text":"ays gakkidee?› giikko,","poem":2},{"lineBreak":true},{"text":"ne may7oy qaarettiin","poem":2},{"lineBreak":true},{"text":"ne sugettiday,","poem":2},{"lineBreak":true},{"text":"ne asa kushen waaye be7iday","poem":2},{"lineBreak":true},{"text":"ne nagaray darida gishshassa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Tumu Tophphiya asi ba medha,","poem":1},{"text":"woykko maahey ba masarateththaa","poem":2},{"lineBreak":true},{"text":"laammanaas dandayzee?","poem":2},{"lineBreak":true},{"text":"Intte iita ooththi meezetidayti","poem":2},{"lineBreak":true},{"text":"lo7o ooththanaas","poem":2},{"lineBreak":true},{"text":"dandayekketa» gides.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"GODAY, «Bazzo carkoy","poem":1},{"text":"suulla laalliza mala","poem":2},{"lineBreak":true},{"text":"tanikka inttena laallana.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Intte tana dogida gishshassinne","poem":1},{"text":"wordo xoossatan","poem":2},{"lineBreak":true},{"text":"ammanettida gishshas","poem":2},{"lineBreak":true},{"text":"intte saamaynne","poem":2},{"lineBreak":true},{"text":"intte qaaday hayssa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Intte kalloy","poem":1},{"text":"beettanaashe gakkanaas","poem":2},{"lineBreak":true},{"text":"tani intte may7o qaarada","poem":2},{"lineBreak":true},{"text":"intte sinth kammana.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Intte zumbullata bollanne","poem":1},{"text":"demban ooththida harassiza ooso","poem":2},{"lineBreak":true},{"text":"tani be7adis;","poem":2},{"lineBreak":true},{"text":"intte laymateththanne intte ziita","poem":2},{"lineBreak":true},{"text":"hanota ta be7adis;","poem":2},{"lineBreak":true},{"text":"Yerusalaame nees aayye ana!","poem":2},{"lineBreak":true},{"text":"Neni ayde gakkanaas","poem":2},{"lineBreak":true},{"text":"ne tunateththaafe","poem":2},{"lineBreak":true},{"text":"geeyontta daanee?» gees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/JER/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/JER/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/JER/12.json","previousChapterAudioLinks":{},"numberOfVerses":27}