ota qanxxidi","poem":2},{"lineBreak":true},{"text":"bantta hu7e gulluntteettes.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iray bukkontta gishshas","poem":1},{"text":"biittay melidi za7ees.","poem":2},{"lineBreak":true},{"text":"Goshshanchchati yeellatidi","poem":2},{"lineBreak":true},{"text":"bantta hu7e gulluntteettes.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Maatay baynda gishshas","poem":1},{"text":"qorkkey ba yelida mara","poem":2},{"lineBreak":true},{"text":"demban yeggada bawus.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hardidati aykkoy baynda","poem":1},{"text":"zumbullata bolla eqqida;","poem":2},{"lineBreak":true},{"text":"worakanata mala","poem":2},{"lineBreak":true},{"text":"haath koyidi leessotteettes.","poem":2},{"lineBreak":true},{"text":"Isttas miza miishshi","poem":2},{"lineBreak":true},{"text":"dhayda gaason istta ayfey","poem":2},{"lineBreak":true},{"text":"xeellanaas daaburdes» gides.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Asay, «Abeet GODAWU!","poem":1},{"text":"ne sinththafe baqata darssidos;","poem":2},{"lineBreak":true},{"text":"ne sunththaa gishshas","poem":2},{"lineBreak":true},{"text":"nuus issi miish ooththa;","poem":2},{"lineBreak":true},{"text":"nuni neeppe daroti","poem":2},{"lineBreak":true},{"text":"guye simmidos;","poem":2},{"lineBreak":true},{"text":"ne bollan nagara ooththidos.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abeet Isra7eele hidotawu!","poem":1},{"text":"Meto wode ashshizayssoo!","poem":2},{"lineBreak":true},{"text":"neni biittan imaththa mala,","poem":2},{"lineBreak":true},{"text":"issi omars aqidi biza","poem":2},{"lineBreak":true},{"text":"oge asa mala ays hanay?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neni hanizaazi dhayda asa mala,","poem":1},{"text":"ashshanaas wolqqay dhayda","poem":2},{"lineBreak":true},{"text":"olanchcha mala ays giday?","poem":2},{"lineBreak":true},{"text":"Abeet GODAWU!","poem":2},{"lineBreak":true},{"text":"Neni nu giddon daasa;","poem":2},{"lineBreak":true},{"text":"nunikka ne sunththan xeygettidos;","poem":2},{"lineBreak":true},{"text":"nuna neni aggofarkkii!» gides.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ha asata gishshas GODAY,","poem":1},{"text":"«Istti toylatteteth keehi doseettes;","poem":2},{"lineBreak":true},{"text":"bantta toho naagettenna.","poem":2},{"lineBreak":true},{"text":"Hessa gishshas GODAY","poem":2},{"lineBreak":true},{"text":"isttan ufayettenna;","poem":2},{"lineBreak":true},{"text":"ha7i izi istta qoho qoppees;","poem":2},{"lineBreak":true},{"text":"istta nagara gaason","poem":2},{"lineBreak":true},{"text":"istta qaxxayees» gees.","poem":2}]},{"type":"verse","number":11,"content":["Hessafe guye GODAY tana,",{"text":"«Ha deraa lo7oteththas woossofa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Istti xoomi woossikokka","poem":1},{"text":"tani istta waaso siyikke;","poem":2},{"lineBreak":true},{"text":"xuugettiza yarshonne","poem":2},{"lineBreak":true},{"text":"kaththa yarshoza","poem":2},{"lineBreak":true},{"text":"istti yarshikokka","poem":2},{"lineBreak":true},{"text":"tani istta yarshoza ekkike.","poem":2},{"lineBreak":true},{"text":"Tani istta mashshan,","poem":2},{"lineBreak":true},{"text":"koshaninne iita hargen","poem":2},{"lineBreak":true},{"text":"dhayssana» gides.","poem":2}]},{"type":"verse","number":13,"content":["Histtiin tani, «Abeet Ubbaafe wolqqama GODAWU! Aayye ana! Nabeti isttas, ‹Intte ola be7ekketa woykko koshay inttena demmenna; tani inttes wurseth gakkanaas saroteth immana› geettes» gadis."]},{"type":"verse","number":14,"content":["Histtiin GODAY taas, «Nabeti ta sunththan wordo yooteettes. Tani istta kiittabeekke, azazabeekke, isttaskka yootabeekke. Istti inttes wordo ajjuuta, muurenno yo7o, hada yo7onne bantta wozinan diza baleththo yo7o yooteettes."]},{"type":"verse","number":15,"content":["Hessa gishshas ta kiittontta dishin, ‹Olaynne koshay ha biittay bolla yeenna› giidi ta sunththan wordo tinbite yootiza nabeta tani olaninne koshan dhayssana."]},{"type":"verse","number":16,"content":["Qasse istti tinbite yootida dereykka koshaninne ola gaason Yerusalaame dubbushatan kundana; isttas, istta machcheta, istta attuma naytanne macca nayta aha moogizay dhayana; tani istta mooro mala istta bolla qixaate ehana» gides."]},{"type":"verse","number":17,"content":[{"text":"Ha qaala isttas,","poem":1},{"text":"« ‹Ta derey","poem":2},{"lineBreak":true},{"text":"keehi deshettidi","poem":2},{"lineBreak":true},{"text":"madunxida gishshas,","poem":2},{"lineBreak":true},{"text":"ta ayfeti omarsinne","poem":2},{"lineBreak":true},{"text":"gallas shempontta afunxxeettes.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tani gaxare biikko,","poem":1},{"text":"mashshan hayqqidayta be7ays;","poem":2},{"lineBreak":true},{"text":"katama gelikko","poem":2},{"lineBreak":true},{"text":"koshay wursidayta be7ays.","poem":2},{"lineBreak":true},{"text":"Nabetinne qeeseti","poem":2},{"lineBreak":true},{"text":"ba erontta dere baqatida›","poem":2},{"lineBreak":true},{"text":"gees GODAY» gides.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Abeet GODAWU!","poem":1},{"text":"Neni Yuhuda mulekka aggadii?","poem":2},{"lineBreak":true},{"text":"Xiyoone asaa harassetadii?","poem":2},{"lineBreak":true},{"text":"Neni nuna paxontta mala","poem":2},{"lineBreak":true},{"text":"ooththada ays dechchadii?","poem":2},{"lineBreak":true},{"text":"Nuni saroteth naagidos;","poem":2},{"lineBreak":true},{"text":"gido attiin saroteth","poem":2},{"lineBreak":true},{"text":"demmibeekko;","poem":2},{"lineBreak":true},{"text":"«Paxana wodey yaana»","poem":2},{"lineBreak":true},{"text":"giidi naagidos;","poem":2},{"lineBreak":true},{"text":"gido attiin dagama xalla gidides.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Abeet GODAWU!","poem":1},{"text":"Nuni nu iitateththaa eridos;","poem":2},{"lineBreak":true},{"text":"Nu aawata qohokka akeekidos;","poem":2},{"lineBreak":true},{"text":"tumappeka ne bolla","poem":2},{"lineBreak":true},{"text":"nagara ooththidos.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nuna ne sunththaa gishshas","poem":1},{"text":"gaada kadhopparkkii!","poem":2},{"lineBreak":true},{"text":"Ne bonchcho araata kawushshofa.","poem":2},{"lineBreak":true},{"text":"Neni nunara caaqettida","poem":2},{"lineBreak":true},{"text":"caaqoza qoppa;","poem":2},{"lineBreak":true},{"text":"ne caaqqida qaala mooppa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kawoteththata eeqa xoossati","poem":1},{"text":"ira bukisana dandayzoo?","poem":2},{"lineBreak":true},{"text":"Saloti ba shenen","poem":2},{"lineBreak":true},{"text":"puuse duge yeddanaas dandayzoo?","poem":2},{"lineBreak":true},{"text":"Dandayettenna;","poem":2},{"lineBreak":true},{"text":"Abeet nu GODAWU!","poem":2},{"lineBreak":true},{"text":"Hessa ubbaa ooththana","poem":2},{"lineBreak":true},{"text":"dandayzay nena;","poem":2},{"lineBreak":true},{"text":"hessa gishshas nuni nenan","poem":2},{"lineBreak":true},{"text":"hidota ooththoos.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/JER/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/JER/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/JER/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}