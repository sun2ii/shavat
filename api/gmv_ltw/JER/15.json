ext":"peenora dhayana","poem":2},{"lineBreak":true},{"text":"izis gallassay qammana;","poem":2},{"lineBreak":true},{"text":"iza yeellatananne kawuyana;","poem":2},{"lineBreak":true},{"text":"attidaytakka morkketa mashshas","poem":2},{"lineBreak":true},{"text":"aaththa immana» gees GODAY.","poem":2}]},{"type":"heading","content":["Ermaasi Ba Metto Godaas Magannides"]},{"type":"verse","number":10,"content":[{"text":"Ta aayee! Hanno poora!","poem":1},{"text":"Tani as ubbaas ooshshasinne","poem":2},{"lineBreak":true},{"text":"palamas gidana mala","poem":2},{"lineBreak":true},{"text":"ays tana yeladii?","poem":2},{"lineBreak":true},{"text":"Tani oonaska tal7e immabeekke;","poem":2},{"lineBreak":true},{"text":"oonappeka tal7e ekkabeekke;","poem":2},{"lineBreak":true},{"text":"gido attiin asi ubbay","poem":2},{"lineBreak":true},{"text":"tana qanggees.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"GODAY, «Tumappe tani nena","poem":1},{"text":"lo7o miishshas ashsha ekkana;","poem":2},{"lineBreak":true},{"text":"Tumappe ne morkketi","poem":2},{"lineBreak":true},{"text":"meto wodenne","poem":2},{"lineBreak":true},{"text":"waaye wode","poem":2},{"lineBreak":true},{"text":"nena shoobbana mala","poem":2},{"lineBreak":true},{"text":"tani ooththana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":["Asi birata, pudeha baggafe yida birata",{"text":"woykko xarqimala","poem":2},{"lineBreak":true},{"text":"menththana dandayzee?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ne dere ubbaan oosettida","poem":1},{"text":"nagara gishshas","poem":2},{"lineBreak":true},{"text":"ne aqota ubbaa di7izaytas","poem":2},{"lineBreak":true},{"text":"coo aaththa immana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ta hanqoy intte bolla","poem":1},{"text":"tama mala eexxana;","poem":2},{"lineBreak":true},{"text":"hessa gishshas neni","poem":2},{"lineBreak":true},{"text":"ne erontta biittan","poem":2},{"lineBreak":true},{"text":"ne morkketas","poem":2},{"lineBreak":true},{"text":"tani nena ayllesana» gides.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Abeet GODAWU! Ne eraasa.","poem":1},{"text":"Tana qoppa; mokkaka xeella;","poem":2},{"lineBreak":true},{"text":"tana yedeththizayta bolla","poem":2},{"lineBreak":true},{"text":"halo kessa;","poem":2},{"lineBreak":true},{"text":"ne dandayanchcha gidida","poem":2},{"lineBreak":true},{"text":"gishshas tana dhayssofa;","poem":2},{"lineBreak":true},{"text":"ne gaason tana gakkiza kadheza","poem":2},{"lineBreak":true},{"text":"ne qoppa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Abeet Ubbaafe","poem":1},{"text":"Wolqqama GODAWU!","poem":2},{"lineBreak":true},{"text":"tani ne sunththan","poem":2},{"lineBreak":true},{"text":"xeygettida gishshas","poem":2},{"lineBreak":true},{"text":"ne qaalay taakko yiin madis;","poem":2},{"lineBreak":true},{"text":"histtiin ne qaalay taas pashkanne","poem":2},{"lineBreak":true},{"text":"wozina ufays immides.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Guppizaytara uttabeekke;","poem":1},{"text":"isttarakka guppabeekke.","poem":2},{"lineBreak":true},{"text":"Neni ne kushe ta bolla","poem":2},{"lineBreak":true},{"text":"denththida gishshassinne","poem":2},{"lineBreak":true},{"text":"ne hanqo ta bolla yeddida gishshas","poem":2},{"lineBreak":true},{"text":"tani tarkka uttadis.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ta bolla hargey ays minnidee?","poem":1},{"text":"Ta madunththay","poem":2},{"lineBreak":true},{"text":"ays dari dari bidee?","poem":2},{"lineBreak":true},{"text":"Ays paxontta ixxidee?","poem":2},{"lineBreak":true},{"text":"Neni taas baleththiza","poem":2},{"lineBreak":true},{"text":"shaafa malanne","poem":2},{"lineBreak":true},{"text":"cimmiza pultto mala","poem":2},{"lineBreak":true},{"text":"ays gidadii?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hessa gishshas GODAY,","poem":1},{"text":"«Neni simmi