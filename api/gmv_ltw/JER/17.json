{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"JER","translationId":"gmv_ltw","name":"Ermaasa Tinbite","commonName":"Ermaasa Tinbite","title":"Ermaasa Tinbite","order":24,"numberOfChapters":52,"sha256":"93dc341c498dc777b4574d7579ba75f7c63468149d8f420fcbf8b21a8a3d04cc","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gmv_ltw/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":17,"content":[{"type":"heading","content":["Yuhuday Ooththida Nagara Gishshas Imettida Qixaate"]},{"type":"verse","number":1,"content":[{"text":"GODAY, «Yuhuda nagaray","poem":1},{"text":"birata bi7ireninne","poem":2},{"lineBreak":true},{"text":"hoxe almaaze xeeran xaafettides;","poem":2},{"lineBreak":true},{"text":"istta wozina bollanne","poem":2},{"lineBreak":true},{"text":"istti yarshizason diza","poem":2},{"lineBreak":true},{"text":"kaceta bolla xaafettides.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Isttas naytikka attontta cilila","poem":1},{"text":"miththata garsaninne","poem":2},{"lineBreak":true},{"text":"dhoqqa zumbullata bolla diza","poem":2},{"lineBreak":true},{"text":"yarshosotanne","poem":2},{"lineBreak":true},{"text":"Asheero geetettiza","poem":2},{"lineBreak":true},{"text":"eeqa misleyo qoppeettes.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne biittan oosettida nagara gaason","poem":1},{"text":"zumata bollanne","poem":2},{"lineBreak":true},{"text":"zumbullata bolla diza","poem":2},{"lineBreak":true},{"text":"ne aqota,","poem":2},{"lineBreak":true},{"text":"ne dureteththinne ne goynosota","poem":2},{"lineBreak":true},{"text":"tani di7os aaththa immana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne mooro gaason","poem":1},{"text":"ta nees immida xinxxozappe","poem":2},{"lineBreak":true},{"text":"ne mela attana;","poem":2},{"lineBreak":true},{"text":"nena tani ne erontta biittan","poem":2},{"lineBreak":true},{"text":"ne morkketas ayllesana.","poem":2},{"lineBreak":true},{"text":"Gaasoykka mernaas","poem":2},{"lineBreak":true},{"text":"tama mala eexxiza","poem":2},{"lineBreak":true},{"text":"ta hanqoza","poem":2},{"lineBreak":true},{"text":"ne denththeththadasa» gees.","poem":2}]},{"type":"heading","content":["Dumma Dumma Leemisota"]},{"type":"verse","number":5,"content":[{"text":"GODAY, «Asan ammanettizay,","poem":1},{"text":"asho may7ida asan ceeqettizay,","poem":2},{"lineBreak":true},{"text":"ba wozina GODAAPPE","poem":2},{"lineBreak":true},{"text":"haassizay qanggettidaade.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Izi bazzon diza","poem":1},{"text":"qeeri wora mala gidana;","poem":2},{"lineBreak":true},{"text":"izi lo7o miish be7enna;","poem":2},{"lineBreak":true},{"text":"izi asi baynda maxine biittan","poem":2},{"lineBreak":true},{"text":"bazzon mela sohon uttana.","poem":2}]},{"type":"verse","number":7,"content":["Gido attiin GODAAN ammanettiza asi,",{"text":"izi ammanettizay","poem":2},{"lineBreak":true},{"text":"GODAA gididaadey anjjettidaade.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Izi haaththa lanqen tokettidi,","poem":1},{"text":"ba xapho duge haaththan yeddida","poem":2},{"lineBreak":true},{"text":"miththa mala.","poem":2},{"lineBreak":true},{"text":"Awa seelaskka yayyenna;","poem":2},{"lineBreak":true},{"text":"iza hayththay","poem":2},{"lineBreak":true},{"text":"cililida mala daana;","poem":2},{"lineBreak":true},{"text":"away darida layththika babbenna;","poem":2},{"lineBreak":true},{"text":"ayfe imoppeka paccenna.","poem":2}]},{"type":"verse","number":9,"content":["Asa wozinay ubbaa miishshafekka gene;",{"text":"izas paxateththika deenna;","poem":2},{"lineBreak":true},{"text":"iza eranaas ooni dandayanee?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tani GODAY as ubbaas","poem":1},{"text":"iza oge malanne","poem":2},{"lineBreak":true},{"text":"iza ooso mala immanaas","poem":2},{"lineBreak":true},{"text":"asaa wozina pilggayssinne","poem":2},{"lineBreak":true},{"text":"iza kaha paaccays» gees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bessontta ogera aqota dagasiza asi","poem":1},{"text":"ba phuqisontta ciye","poem":2},{"lineBreak":true},{"text":"haphphiza kuracho mala.","poem":2},{"lineBreak":true},{"text":"Iza layththay buro baggattishin","poem":2},{"lineBreak":true},{"text":"izi aqota aggi baana;","poem":2},{"lineBreak":true},{"text":"wurseththan iza eeyateththi","poem":2},{"lineBreak":true},{"text":"qoncce kezana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nu Xoossa Keeththi dizasoy","poem":1},{"text":"benippe doommidi dhoqqu gida","poem":2},{"lineBreak":true},{"text":"bonchcho araata.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Isra7eeles hidota gidida GODAWU!","poem":1},{"text":"nena aggi bida ubbay yeellatana;","poem":2},{"lineBreak":true},{"text":"nena de7o haaththa pultto gidida","poem":2},{"lineBreak":true},{"text":"GODAA aggida gishshas","poem":2},{"lineBreak":true},{"text":"ba ayfeso neeppe","poem":2},{"lineBreak":true},{"text":"haraso zaarizayti","poem":2},{"lineBreak":true},{"text":"gudulla bolla","poem":2},{"lineBreak":true},{"text":"xaafettidayssa mala gidana.","poem":2}]},{"type":"heading","content":["Ermaasa Woosa"]},{"type":"verse","number":14,"content":["Abeet GODAWU! Tana paththa;",{"text":"tanikka paxana;","poem":2},{"lineBreak":true},{"text":"tana ashsha;","poem":2},{"lineBreak":true},{"text":"tanikka attana;","poem":2},{"lineBreak":true},{"text":"gaasoykka ta galatay nena.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Asay tana zaari zaaridi,","poem":1},{"text":"«GODAA qaalay awan dizee?","poem":2},{"lineBreak":true},{"text":"Ane ha7i poletto!» geettes.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Heenththanchcha gidada","poem":1},{"text":"nees ooththanaappe","poem":2},{"lineBreak":true},{"text":"guye gabeekke;","poem":2},{"lineBreak":true},{"text":"ta isttas iita gallas","poem":2},{"lineBreak":true},{"text":"amottonttayssa ne eraasa;","poem":2},{"lineBreak":true},{"text":"ta doonappe kezizayssi","poem":2},{"lineBreak":true},{"text":"ne sinththan qoncce.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tana daganththizaade gidoppa;","poem":1},{"text":"neni taas meto gallas","poem":2},{"lineBreak":true},{"text":"ta baqata attizasoho.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tana yedeththizayti yeellatetto;","poem":1},{"text":"tana yeellasoppa;","poem":2},{"lineBreak":true},{"text":"istti dagammetto;","poem":2},{"lineBreak":true},{"text":"gido attiin tana dagamappe qotta;","poem":2},{"lineBreak":true},{"text":"istta bolla iita gallas eha;","poem":2},{"lineBreak":true},{"text":"istta bolla dakko bash eha.","poem":2}]},{"type":"heading","content":["Sambata Bonchcho"]},{"type":"verse","number":19,"content":["GODAY tana, «Yuhuda kawoti katama gelizaasoninne kezizaaso deraa pengeninne hara Yerusalaame pengeta ubbaan baada eqqa."]},{"type":"verse","number":20,"content":["Histtada isttas, ‹Ha pengetara geliza Yuhuda kawoto! Yuhuda asatoo! Yerusalaamen diza as ubbatoo GODAA qaala siyite!› ga» gees."]},{"type":"verse","number":21,"content":["GODAY taas, «Sambata gallas tooho tookkidi Yerusalaame pengetara gelontta mala inttes naagettite!"]},{"type":"verse","number":22,"content":["Sambata gallassan intte keeththafe tooho tookkidi kessofte; woykko aykko oosonne ooththofte. Kase intte aawata tani azazida mala, Sambata gallas dummasidi bonchchite."]},{"type":"verse","number":23,"content":["Istti gidikko siyibeettenna; wozinankka woththibeettenna; istti siyontta malanne simmontta mala ba wozina muumisida."]},{"type":"verse","number":24,"content":["Gido attiin intte tani GODAY yootizayssa naagetti azazettiko, Sambata gallassan ay miishshika tookkidi hanno ha katamay pengetara gelontta aggiko, Sambata gallas dummasidi izan ay oosonne ooththontta bonchchiko,"]},{"type":"verse","number":25,"content":["Dawite kawoteththa araatan uttiza kawotinne istta shuumeti ha katamay pengera gelana; istti ba parataninne ba para-gaareta bolla uttidi Yuhuda asaynne Yerusalaame asay azhabiin yaana; ha katamaya mernaas asi diza katama gidana."]},{"type":"verse","number":26,"content":["Asay xuugettiza yarshonne hara yarsho, kaththa yarsho, exaanenne galata yarsho ekkidi, Yuhuda katamatappe, Yerusalaame yuushon diza mooththatappe, Biniyaame biittafe, gadhappenne gezzefe qasseka Negebe biittafe GODAA Keeth yaana."]},{"type":"verse","number":27,"content":["Gido attiin intte Sambata gallassata dummasontta ixxidi sambata gallas tooho tookkidi Yerusalaame pengetara gelidi ta azazo menththiko tani Yerusalaame pengeta bolla izi miixata miza to7ontta tama ta eeththana» gides."]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/JER/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/JER/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/JER/16.json","previousChapterAudioLinks":{},"numberOfVerses":27}