{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"JER","translationId":"gmv_ltw","name":"Ermaasa Tinbite","commonName":"Ermaasa Tinbite","title":"Ermaasa Tinbite","order":24,"numberOfChapters":52,"sha256":"93dc341c498dc777b4574d7579ba75f7c63468149d8f420fcbf8b21a8a3d04cc","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gmv_ltw/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":18,"content":[{"type":"heading","content":["Mana Keeththan Ermaasa"]},{"type":"verse","number":1,"content":["GODAA matappe Ermaasakko,"]},{"type":"verse","number":2,"content":["«Dendada manaso ba; heen ta nees ta kiita yootana» giza qaalay yides."]},{"type":"verse","number":3,"content":["Tanikka duge manazaso badis; izi ba medhdhiza irzo bolla oto medhdhishin be7adis."]},{"type":"verse","number":4,"content":["Izi medhdhishin otozi iza kushen moorettides; histtiin izi he urqqaa zaaridi ba koyida mala medhdhides."]},{"type":"verse","number":5,"content":["He wode GODAA qaalay,"]},{"type":"verse","number":6,"content":["«Isra7eele asawu! Manazi ooththizayssaththo ta inttena ooththanaas dandaykkinaa? Isra7eele asawu! Urqqay mana kushen dizayssaththo intteka ta kushen deeta."]},{"type":"verse","number":7,"content":["Tani issi derey woykko issi kawoteththi shodettana mala, laalettana malanne dhayana mala yootikko,"]},{"type":"verse","number":8,"content":["he tani yootida kawoteththay ba iitateththaafe aggidi simmiko, tani istta bolla ehana gida iita miish ehontta aggaagana."]},{"type":"verse","number":9,"content":["Qasse hara wodekka tani issi dere woykko issi kawoteth minththa essanaas yootikko,"]},{"type":"verse","number":10,"content":["ta sinththan iita miish ooththikonne taas azazettontta ixxiko, ‹Ta izas ooththana› gida lo7o miishsha ubbaa ooththontta aggaagana» gees."]},{"type":"verse","number":11,"content":["GODAY, «Hessa gishshas, Ermaasa ha7i Yuhuda asatassinne Yerusalaamen dizaytas baada, ‹Hekko tani intte bolla bash giigso bolla days; intte bolla iita miish medhdhashe days; hessa gishshas intte ubbayka intte biza iita ogeppe simmite; intte ogenne intte ooso suurisite› ga yoota."]},{"type":"verse","number":12,"content":["Gido attiin isttas, ‹Daaburoppa; nu halchchida ogera baana; nuni issoy issoy nu iita wozina qofa kaallana› geettes» gides."]},{"type":"verse","number":13,"content":[{"text":"Hessa gishshas GODAY,","poem":1},{"text":"«Ane kawoteththata,","poem":2},{"lineBreak":true},{"text":"‹Hayssa mala miishshi","poem":2},{"lineBreak":true},{"text":"intte giddon seetetti erizee?›","poem":2},{"lineBreak":true},{"text":"gi oychchite.","poem":2},{"lineBreak":true},{"text":"Geela7oya Isra7eeley harassiza","poem":2},{"lineBreak":true},{"text":"iita miish ooththadus.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Shuch xalla gidida","poem":1},{"text":"Libaanoose zumata","poem":2},{"lineBreak":true},{"text":"bollafe shachchi dhayi erizee?","poem":2},{"lineBreak":true},{"text":"Ladde bollafe duge goggiza","poem":2},{"lineBreak":true},{"text":"irxxa haaththi","poem":2},{"lineBreak":true},{"text":"gogeth aggi erizee?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ta derey gidikko tana balides;","poem":1},{"text":"istti go7ontta xoossatas","poem":2},{"lineBreak":true},{"text":"exaane cuwaseettes;","poem":2},{"lineBreak":true},{"text":"bantta ogera biidi dhuphettida;","poem":2},{"lineBreak":true},{"text":"beni ogeppe kare kezida;","poem":2},{"lineBreak":true},{"text":"baasettontta diza kundukurcco","poem":2},{"lineBreak":true},{"text":"ogera bida.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Istta biittay bulanne","poem":1},{"text":"mernaas kadhettidaaz gidana;","poem":2},{"lineBreak":true},{"text":"heera aadhdhiza","poem":2},{"lineBreak":true},{"text":"ubbay malalettana;","poem":2},{"lineBreak":true},{"text":"ba hu7ekka qidhishe qaaththana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Arshey mokkiza bagga carko mala","poem":1},{"text":"tani istta istta","poem":2},{"lineBreak":true},{"text":"morkketa","poem":2},{"lineBreak":true},{"text":"sinththan laallana.","poem":2},{"lineBreak":true},{"text":"Istti dhayza gallas ta isttas","poem":2},{"lineBreak":true},{"text":"zokko zaarana attiin","poem":2},{"lineBreak":true},{"text":"ta ayfeso bessike» gees.","poem":2}]},{"type":"heading","content":["Ermaasa Bolla Maqettida Maqqo"]},{"type":"verse","number":18,"content":["Isttika, «Ane haa yiite; Ermaasa bolla maqettoos; wogay qeeseta achchan, zorey aadho eranchchata achchan, qaalaykka nabeta achchan dhayenna; ane haa yiite; nu inxarsan iza toochchoos; izi gizayssaka ubbaa siyokko» gida."]},{"type":"verse","number":19,"content":[{"text":"Abeet GODAWU! Ta gizaaz siya;","poem":1},{"text":"ta morkketi ta bolla","poem":2},{"lineBreak":true},{"text":"haasayzayssa ezga.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Lo7o ooththidaades iita zaarizoo?","poem":1},{"text":"Istti gidikko","poem":2},{"lineBreak":true},{"text":"taas olla bookkida;","poem":2},{"lineBreak":true},{"text":"ne hanqoy isttafe simmana mala","poem":2},{"lineBreak":true},{"text":"ne sinththan eqqada","poem":2},{"lineBreak":true},{"text":"istta gishshas","poem":2},{"lineBreak":true},{"text":"ta yootidayssa qoppa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hessa gishshas","poem":1},{"text":"istta nayta koshassinne","poem":2},{"lineBreak":true},{"text":"mashshas aaththa imma;","poem":2},{"lineBreak":true},{"text":"istta maccassati maynnenne","poem":2},{"lineBreak":true},{"text":"am7eta gidetto;","poem":2},{"lineBreak":true},{"text":"istta attumasatikka","poem":2},{"lineBreak":true},{"text":"para hayqon wuretto;","poem":2},{"lineBreak":true},{"text":"istta naateththa nayti","poem":2},{"lineBreak":true},{"text":"olason mashshas gidetto","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Istti tana kundisanaas","poem":1},{"text":"olla bookkiza gishshassinne","poem":2},{"lineBreak":true},{"text":"ta tohoska woximade","poem":2},{"lineBreak":true},{"text":"woththida gishshas","poem":2},{"lineBreak":true},{"text":"istti qoppontta neni istta bolla","poem":2},{"lineBreak":true},{"text":"bonqqizayta yeddiin","poem":2},{"lineBreak":true},{"text":"istta keeththan waasoy kezo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Gido attiin abeet GODAWU!","poem":1},{"text":"istti tana wodhanaas maqettidayssa","poem":2},{"lineBreak":true},{"text":"ubbaa neni eraasa;","poem":2},{"lineBreak":true},{"text":"neni istta iitateththaa","poem":2},{"lineBreak":true},{"text":"atto gooppa,","poem":2},{"lineBreak":true},{"text":"woykko istta nagara","poem":2},{"lineBreak":true},{"text":"ne sinththafe quccofa;","poem":2},{"lineBreak":true},{"text":"istti ne sinththan","poem":2},{"lineBreak":true},{"text":"xoonettidi kundetto;","poem":2},{"lineBreak":true},{"text":"Ne hanqo gallas","poem":2},{"lineBreak":true},{"text":"ne istta maaroppa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/JER/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/JER/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/JER/17.json","previousChapterAudioLinks":{},"numberOfVerses":23}