{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"JER","translationId":"gmv_ltw","name":"Ermaasa Tinbite","commonName":"Ermaasa Tinbite","title":"Ermaasa Tinbite","order":24,"numberOfChapters":52,"sha256":"93dc341c498dc777b4574d7579ba75f7c63468149d8f420fcbf8b21a8a3d04cc","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gmv_ltw/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":20,"content":[{"type":"heading","content":["Ermaasanne Pashkure"]},{"type":"verse","number":1,"content":["He wode GODAA Keeththan Imere naa qeese Pashkurey Ermaasi tinbite yootishin siyidi,"]},{"type":"verse","number":2,"content":["nabe Ermaasa shocides; Xoossa Keeththaafe pude baggara diza Biniyaame gimbe penge bolla agrimooqen qachchides."]},{"type":"verse","number":3,"content":["Wonteththa gallas Pashkurey Ermaasa qashoppe birshiin Ermaasi izas, «Hachchife doommiin GODAY ne sunth Maagormisaabibe",{"noteId":3},"gaana attiin Pashkure geenna."]},{"type":"verse","number":4,"content":["Gaasoykka GODAY, ‹Tani nenanne ne laggeta ubbaa dagamas aaththa immana; istti neni xeellishin bantta morkketa mashshan wurana; tani Yuhuda asaa ubbaa Baabiloone kawo kushen aaththa immana; izi istta di7idi Baabiloone efana; histtidi heen istta mashshan siifana."]},{"type":"verse","number":5,"content":["Ha katamay aqota, iza ooththa demmida ubbaa, Yuhuda kawota aqotanne isttas diza al7o miish ubbaa tani istta morkketas aaththa immana; isttika di7i ekkidi Baabiloone efana."]},{"type":"verse","number":6,"content":["Pashkure! Neninne ne sohon diza ubbayka di7ettidi Baabiloone baana. Neninne ne isttas wordo tinbite yootida ne laggeti ubbay heen hayqqananne moogettana› gees» gides."]},{"type":"heading","content":["Ermaasa Zuuzunth"]},{"type":"verse","number":7,"content":[{"text":"Abeet GODAWU!","poem":1},{"text":"Neni tana cimmadasa;","poem":2},{"lineBreak":true},{"text":"tanikka cimettadis.","poem":2},{"lineBreak":true},{"text":"Neni taappe keeha minnada","poem":2},{"lineBreak":true},{"text":"tana xoonadasa.","poem":2},{"lineBreak":true},{"text":"Gallas kumeth tani asas","poem":2},{"lineBreak":true},{"text":"miichchas attadis;","poem":2},{"lineBreak":true},{"text":"ubbayka tana qidhees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tani haasayza wode","poem":1},{"text":"ubbaan waassays;","poem":2},{"lineBreak":true},{"text":"«Shironne bash» ga awajjays;","poem":2},{"lineBreak":true},{"text":"Hessa gishshas GODAA qaalay","poem":2},{"lineBreak":true},{"text":"taas kumeththa gallas ta bolla","poem":2},{"lineBreak":true},{"text":"cashshenne qidhe ehides.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tani, «Hayssafe guye","poem":1},{"text":"GODAA sunththaa denththike;","poem":2},{"lineBreak":true},{"text":"iza sunththankka","poem":2},{"lineBreak":true},{"text":"haasaykke» giikko","poem":2},{"lineBreak":true},{"text":"iza qaalay ta wozina giddon","poem":2},{"lineBreak":true},{"text":"tama mala,","poem":2},{"lineBreak":true},{"text":"ta meqeththa giddonkka","poem":2},{"lineBreak":true},{"text":"surquntto mala gidides;","poem":2},{"lineBreak":true},{"text":"hessa gishshas","poem":2},{"lineBreak":true},{"text":"ta kamma oykkanaas xoonides;","poem":2},{"lineBreak":true},{"text":"mulerakka eqettanawu","poem":2},{"lineBreak":true},{"text":"dandayabeekke.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"«Ubbason shiroy dees;","poem":1},{"text":"hilite ane nunikka hiloos» giidi","poem":2},{"lineBreak":true},{"text":"daroti saasukettishin ta siyadis;","poem":2},{"lineBreak":true},{"text":"ta kundeth naagettishe diza","poem":2},{"lineBreak":true},{"text":"ta laggeti ubbay,","poem":2},{"lineBreak":true},{"text":"«Oonee erizay","poem":2},{"lineBreak":true},{"text":"balettana dandayzaakko","poem":2},{"lineBreak":true},{"text":"histtiko nuni iza xoonanakkonne","poem":2},{"lineBreak":true},{"text":"nu halo kessanakko» geettes.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gido attiin GODAY yashissiza","poem":1},{"text":"toora qara mala tanara dees;","poem":2},{"lineBreak":true},{"text":"hessa gishshas tana yedeththizayti","poem":2},{"lineBreak":true},{"text":"dhuphettana attiin","poem":2},{"lineBreak":true},{"text":"tana xoonettenna;","poem":2},{"lineBreak":true},{"text":"istti iita kawush kawuyana attiin","poem":2},{"lineBreak":true},{"text":"isttas giigenna;","poem":2},{"lineBreak":true},{"text":"istta kawushshateththay","poem":2},{"lineBreak":true},{"text":"mulekka dogettenna.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abeet Ubbaafe","poem":1},{"text":"Wolqqama GODAWU!","poem":2},{"lineBreak":true},{"text":"xilloza paaccizayssoo!","poem":2},{"lineBreak":true},{"text":"wozinanne kaha","poem":2},{"lineBreak":true},{"text":"pilgga xeellizayssoo!","poem":2},{"lineBreak":true},{"text":"tani ta mooto nees","poem":2},{"lineBreak":true},{"text":"aaththa immida gishshas","poem":2},{"lineBreak":true},{"text":"neni istta bolla halo kessishin","poem":2},{"lineBreak":true},{"text":"ta ayfen be7anaas tana gaththa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"GODAAS yexxite!","poem":1},{"text":"Izas galata shiishshite;","poem":2},{"lineBreak":true},{"text":"izi metotanchchata shemppo","poem":2},{"lineBreak":true},{"text":"iitata kusheppe ashshees.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tani yelettida gallassaya","poem":1},{"text":"qanggettidaaro gidu!","poem":2},{"lineBreak":true},{"text":"Ta aayeya tana yelida","poem":2},{"lineBreak":true},{"text":"gallassaya anjjettufu!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ta aawaas, «Nees mishiraachcho;","poem":1},{"text":"nees attuma nay yelettides!»","poem":2},{"lineBreak":true},{"text":"gi yootiday qanggettidaade gido!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hessaadey GODAY qadhetay baynda","poem":1},{"text":"shirechchi yeggida","poem":2},{"lineBreak":true},{"text":"katamata mala gido;","poem":2},{"lineBreak":true},{"text":"maalado waaso, gallassa seetan","poem":2},{"lineBreak":true},{"text":"ola shiro siyo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ta aaya taas duufo gidana mala,","poem":1},{"text":"izi uloy taas mernaa","poem":2},{"lineBreak":true},{"text":"duussaso gidana mala","poem":2},{"lineBreak":true},{"text":"tana heen ays wodhibeennee?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tani metonne ceece be7anaassinne","poem":1},{"text":"ta de7o layththaa ubbaa","poem":2},{"lineBreak":true},{"text":"kawushshateththan","poem":2},{"lineBreak":true},{"text":"wursanaas ta aayi uloppe","poem":2},{"lineBreak":true},{"text":"ays kezadinaa?","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"Maagormisaabibe: Maagormisaabibe geetettizayssa Ibraaweta qaala birsheththi ubbaa miishshankka dagama guussa.","reference":{"chapter":20,"verse":3}}]},"thisChapterLink":"/api/gmv_ltw/JER/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/JER/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/JER/19.json","previousChapterAudioLinks":{},"numberOfVerses":18}