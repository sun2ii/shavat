{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"JER","translationId":"gmv_ltw","name":"Ermaasa Tinbite","commonName":"Ermaasa Tinbite","title":"Ermaasa Tinbite","order":24,"numberOfChapters":52,"sha256":"93dc341c498dc777b4574d7579ba75f7c63468149d8f420fcbf8b21a8a3d04cc","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gmv_ltw/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":22,"content":[{"type":"heading","content":["Ermaasi Yuhuda Kawo Keeththa Asaas Yootida Qaala"]},{"type":"verse","number":1,"content":["GODAY, «Duge Yuhuda kawo soo baada,"]},{"type":"verse","number":2,"content":["‹Nenoo Dawite kawoteththa araata bolla uttida Yuhuda kawoo! Neninne ne shuumeti, ha pengetara geliza as ubbay GODAA qaala siyite› ga» gees."]},{"type":"verse","number":3,"content":["GODAY, «Suure pirdanne xillo ooththite; bonqqettidayta un7eththizayta kusheppe ashshite; beteta, yi7otanne am7eta qohopite; ha sohonkka xillo suuth gussofte."]},{"type":"verse","number":4,"content":["Hayta azazota intte lo7eththi naagikko Dawite kawoteththa araata bolla uttiza kawoti ba shuumetaranne ba dere asaara para-gaarenne para toggidi hayssa kawoteththa keeththa pengera gelananne kezana."]},{"type":"verse","number":5,"content":["Gido attiin intte ta azazota naagontta ixxiko, ‹Ha kawoteththa keeththay mulera dhayana› gaada tani tarkka tanan caaqqays» gides."]},{"type":"verse","number":6,"content":["GODAY Yuhuda kawo keeththas,",{"text":"«Neni taas Gala7aade biittanne","poem":1},{"text":"Libaanoose zuma xeera mala","poem":2},{"lineBreak":true},{"text":"lo7ikkoka tani nena","poem":2},{"lineBreak":true},{"text":"addafe bazzonne","poem":2},{"lineBreak":true},{"text":"asi izan baynda","poem":2},{"lineBreak":true},{"text":"katama ooththana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tani nena olizayta hu7en hu7en","poem":1},{"text":"ola miish oyththada","poem":2},{"lineBreak":true},{"text":"ne bolla yeddana;","poem":2},{"lineBreak":true},{"text":"istti zigappe masettida tuuqeta","poem":2},{"lineBreak":true},{"text":"qanxxereththidi taman yeggana.","poem":2}]},{"type":"verse","number":8,"content":["«Dumma dumma kawoteththafe yida asay ha katamayra aadhdhi bishe, ‹GODAY hanno gita katamayo ays hayssaththo ooththidee?› giidi ba garsan haasayettana."]},{"type":"verse","number":9,"content":["«Istti, ‹GODAA bantta Xoossaara caaqettida caaqo aggidi eeqa xoossatas goynnida gishshassinne isttas ooththida gishshassa› gaana» gees."]},{"type":"heading","content":["Ermaasi Shaalume Gishshas Yootida Qaala"]},{"type":"verse","number":10,"content":[{"text":"Hayqqida Kawo","poem":1},{"text":"Iyosiyaasas yeekkofte","poem":2},{"lineBreak":true},{"text":"woykko kayottofte;","poem":2},{"lineBreak":true},{"text":"Hessa aggidi di7etti bida","poem":2},{"lineBreak":true},{"text":"Shaalumes mishettidi yeekkite.","poem":2},{"lineBreak":true},{"text":"Gaasoykka izi mulekka","poem":2},{"lineBreak":true},{"text":"guye simmenna;","poem":2},{"lineBreak":true},{"text":"ba yelettida biitta","poem":2},{"lineBreak":true},{"text":"nam7anththo be7enna.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ba aawa sohon","poem":1},{"text":"Yuhudan kawotidi dishe","poem":2},{"lineBreak":true},{"text":"ha sohoppe bida","poem":2},{"lineBreak":true},{"text":"Iyosiyaasa naa Shaalume gishshas","poem":2},{"lineBreak":true},{"text":"GODAY, «Izi mulekka","poem":2},{"lineBreak":true},{"text":"guye simmenna.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Izi di7etti bida biittan","poem":1},{"text":"heen hayqqana;","poem":2},{"lineBreak":true},{"text":"simmi yiidi ha biittayo be7enna.","poem":2}]},{"type":"heading","content":["Ermaasi Iyo7aaqeme Gishshas Yootida Qaala"]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Ba kawoteththa keeththa","poem":1},{"text":"genen keexxizayssas,","poem":2},{"lineBreak":true},{"text":"pirda geellasidi","poem":2},{"lineBreak":true},{"text":"pooqe keexxizayssas,","poem":2},{"lineBreak":true},{"text":"as coo mela oosisizayssas,","poem":2},{"lineBreak":true},{"text":"iza wolqqa waaga ciggonttaades,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Izi, ‹Gita pooqenne","poem":1},{"text":"aaho kawoteththa keeth","poem":2},{"lineBreak":true},{"text":"taas keexxana› gizaades","poem":2},{"lineBreak":true},{"text":"aayye ana!","poem":2},{"lineBreak":true},{"text":"Izi ba keeththas","poem":2},{"lineBreak":true},{"text":"gita maskooteta kessees;","poem":2},{"lineBreak":true},{"text":"ziga miththan alleqissees;","poem":2},{"lineBreak":true},{"text":"zo7o qalamekka tiyees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«Ne kawoteththa keeththa","poem":1},{"text":"daro ziga miththan keexxidayssi","poem":2},{"lineBreak":true},{"text":"nees kawotidaa misatizee?","poem":2},{"text":"Ne aaway suure pirdanne","poem":1},{"text":"xillo ooththida gishshas","poem":2},{"lineBreak":true},{"text":"mizaazinne uyizaazi paccidee?","poem":2},{"lineBreak":true},{"text":"Izas ubbaa miishshika injjetides.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Izi manqotassinne metotanchchatas","poem":1},{"text":"pirda geellasibeenna;","poem":2},{"lineBreak":true},{"text":"hessa gishshas ubbaa","poem":2},{"lineBreak":true},{"text":"miishshika izas eeno gides;","poem":2},{"lineBreak":true},{"text":"taas ero guussi hessa gidennee?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Gido attiin ne ayfeynne","poem":1},{"text":"ne wozinay shempiday","poem":2},{"lineBreak":true},{"text":"haa hee shocechchon","poem":2},{"lineBreak":true},{"text":"demmiza go7an,","poem":2},{"lineBreak":true},{"text":"xillota suuth gusson,","poem":2},{"lineBreak":true},{"text":"asaa un7eththoninne","poem":2},{"lineBreak":true},{"text":"gene oosonna» gees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Hessa gishshas GODAY","poem":1},{"text":"Yuhuda Kawo Iyosiyaasa naa","poem":2},{"lineBreak":true},{"text":"Iyo7aaqeme gishshas,","poem":2},{"lineBreak":true},{"text":"«Woo ta ishawu!","poem":2},{"lineBreak":true},{"text":"Waay waay ta michchee!","poem":2},{"lineBreak":true},{"text":"Qasse, ‹Ta godawu woo woo!","poem":2},{"lineBreak":true},{"text":"Ne gitateththaa woo woo!›","poem":2},{"lineBreak":true},{"text":"giidi zilalettenna.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Harey moogettiza mala","poem":1},{"text":"izi moogettana;","poem":2},{"lineBreak":true},{"text":"Iza ahay Yerusalaame","poem":2},{"lineBreak":true},{"text":"pengetappe gooshettidi","poem":2},{"lineBreak":true},{"text":"kare olettana» gees.","poem":2}]},{"type":"heading","content":["Yerusalaame Gishshas Ermaasi Yootida Qaala"]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"GODAY Yerusalaame,","poem":1},{"text":"«Pude Libaanoose baada waassa;","poem":2},{"lineBreak":true},{"text":"Ne qaalakka Baasaanen sissa;","poem":2},{"lineBreak":true},{"text":"Abaarimen eqqada waassa;","poem":2},{"lineBreak":true},{"text":"gaasoykka nees ola laggeti","poem":2},{"lineBreak":true},{"text":"ubbay wurida.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Neni saro dishin","poem":1},{"text":"ta nees minththa yootadis;","poem":2},{"lineBreak":true},{"text":"gido attiin neni, ‹Siyikke› gadasa.","poem":2},{"lineBreak":true},{"text":"Yelagateththafe doommiin","poem":2},{"lineBreak":true},{"text":"ne ogey hayssa;","poem":2},{"lineBreak":true},{"text":"neni taas azazettontta ixxadasa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ne heenththanchchata ubbaa","poem":1},{"text":"carkoy efana;","poem":2},{"lineBreak":true},{"text":"ne laggeti ubbay di7etti baana;","poem":2},{"lineBreak":true},{"text":"ne iitateththaa ubbaa gaason","poem":2},{"lineBreak":true},{"text":"yeellatananne kawuyana.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hanne Libaanoosen dizaaree!","poem":1},{"text":"Ne keeththaa ziga","poem":2},{"lineBreak":true},{"text":"miththafe keexxidaaree!","poem":2},{"lineBreak":true},{"text":"miixay oykkida maccassa mala","poem":2},{"lineBreak":true},{"text":"metoy ne bolla yishin","poem":2},{"lineBreak":true},{"text":"waana waassandii!» gees.","poem":2}]},{"type":"verse","number":24,"content":["GODAY, « ‹Tani ta de7on caaqqays› Yuhuda kawo Iyo7aaqeme naa Ikoniyaane neni taas ushachcha kushe qalabate maatame gididaakkoka ta nena kessa olana."]},{"type":"verse","number":25,"content":["Nena wodhanaas koyzaytas, neni yayyiza Baabiloone Kawo Nabukadanaxooressinne iza olanchchatas tani nena aaththa immana."]},{"type":"verse","number":26,"content":["Tani nenakka nena yelida ne aayeyokka intte yelettontta allaga biittan ola aggana; intteka heen hayqqana."]},{"type":"verse","number":27,"content":["Intte simmanaas laamotiza biittayo mulekka simmeketa» gees."]},{"type":"verse","number":28,"content":[{"text":"Hayssi Ikoniyaaney kadhettidi","poem":1},{"text":"meqqida oto mala","poem":2},{"lineBreak":true},{"text":"oonikka koyontta miishshe?","poem":2},{"text":"Izinne iza nayti","poem":1},{"text":"ays kare oletti attidoo?","poem":2},{"text":"Istti ba erontta allaga biittan","poem":1},{"text":"ays yegetti attidoo?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Hanne biittayee, hanne biittayee!","poem":1},{"text":"GODAA qaala siya!","poem":2}]},{"type":"verse","number":30,"content":[{"text":"GODAY, «Yuhuda ayssanaas","poem":1},{"text":"asi baynda gishshas,","poem":2},{"lineBreak":true},{"text":"Dawite araatan uttana","poem":2},{"lineBreak":true},{"text":"issaadeyka ke7ontta gishshas,","poem":2},{"lineBreak":true},{"text":"issi paxa asi kezontta gishshas","poem":2},{"lineBreak":true},{"text":"izas de7o layththa","poem":2},{"lineBreak":true},{"text":"ubbaan injjetontta","poem":2},{"lineBreak":true},{"text":"dhonththa as giidi xaafte» gees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/JER/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/JER/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/JER/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}