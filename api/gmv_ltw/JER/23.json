{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"JER","translationId":"gmv_ltw","name":"Ermaasa Tinbite","commonName":"Ermaasa Tinbite","title":"Ermaasa Tinbite","order":24,"numberOfChapters":52,"sha256":"93dc341c498dc777b4574d7579ba75f7c63468149d8f420fcbf8b21a8a3d04cc","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gmv_ltw/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":23,"content":[{"type":"heading","content":["Sinththafe Yaana Hidota"]},{"type":"verse","number":1,"content":["GODAY, «Ta heenththasohon diza ta dorsata dhayssizaytassinne laalliza heenththanchchatas aayye ana!» gees."]},{"type":"verse","number":2,"content":["GODAA Isra7eele Xoossay ba asaa heemmiza heenththanchchatas, «Intte ta dorsata laallidi wora yeddida gishshassinne intte istta lo7eththi xeellontta aggida gishshas intte iitateththaas bessiza qixaate ta immana."]},{"type":"verse","number":3,"content":["Hessafe guye ta wudeppe attidayta kase ta goodda yeddida dere ubbaafe tani tarkka shiishshada kase ta heemmizasoho zaara ehana; isttika hessan yelettidi corattana."]},{"type":"verse","number":4,"content":["Tani lo7eththi heemmiza heenththanchchata isttas denththana; istti nam7anththo babbettennanne dagammettenna; isttafe issaadeyka dhayenna» gees."]},{"type":"verse","number":5,"content":["GODAY,",{"text":"«Tani Dawites xillo zare","poem":1},{"text":"denththana wodey yaana;","poem":2},{"lineBreak":true},{"text":"izi tumu pirdanne","poem":2},{"lineBreak":true},{"text":"xilloteth ooththizaade,","poem":2},{"lineBreak":true},{"text":"aadho erateththan haariza kawo gidana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iza kawoteththa layththan","poem":1},{"text":"Yuhuday attana;","poem":2},{"lineBreak":true},{"text":"Isra7eeleykka saron daana;","poem":2},{"lineBreak":true},{"text":"iza sunththi,","poem":2},{"lineBreak":true},{"text":"‹GODAY Nuus Xilloteththa› geetettana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hessa gishshas asay","poem":1},{"text":"hayssafe guye iza,","poem":2},{"lineBreak":true},{"text":"‹Isra7eele asaa Gibxe biittafe","poem":2},{"lineBreak":true},{"text":"kessidi ehida GODAY be7iin›","poem":2},{"lineBreak":true},{"text":"gi caaqqontta wodey yaana gees GODAY.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gido attiin, ‹Isra7eele zareta","poem":1},{"text":"pudeha bagga biittafenne","poem":2},{"lineBreak":true},{"text":"izi istta laallida hara deretappe","poem":2},{"lineBreak":true},{"text":"kessida de7o GODAY be7iin›","poem":2},{"lineBreak":true},{"text":"gi caaqqana wodey yaana;","poem":2},{"lineBreak":true},{"text":"hessafe guye istti","poem":2},{"lineBreak":true},{"text":"bantta deren daana» gees.","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Wordo Nabeta"]},{"type":"verse","number":9,"content":[{"text":"Nabeta gishshas ta wozinay meqqides;","poem":1},{"text":"ta meqeththati ubbayka kokkorida.","poem":2},{"lineBreak":true},{"text":"GODAA gaasoninne","poem":2},{"lineBreak":true},{"text":"iza geeshsha qaala gaason","poem":2},{"lineBreak":true},{"text":"woyne ushshu uyidi","poem":2},{"lineBreak":true},{"text":"maththottiza asa mala gidadis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Biittaya layman xalla kumadus;","poem":1},{"text":"qanggettida gishshas yeekkawus;","poem":2},{"lineBreak":true},{"text":"bazzon diza mehe heenththasohoti melida;","poem":2},{"lineBreak":true},{"text":"nabetikka geella oge kaallida;","poem":2},{"lineBreak":true},{"text":"baas imettida maataa","poem":2},{"lineBreak":true},{"text":"wogay baynda go7ettida.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"GODAY, «Nabeti, qeeseti","poem":1},{"text":"xilloteththa ogera beettenna;","poem":2},{"lineBreak":true},{"text":"ta Keeththaa garsankka istti","poem":2},{"lineBreak":true},{"text":"ooththiza iitateththaa ta be7adis.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hessa gishshas istta ogey hallixana;","poem":1},{"text":"isttika dhuman kundana;","poem":2},{"lineBreak":true},{"text":"istti gandigardi kundana;","poem":2},{"lineBreak":true},{"text":"istti qaxxayettiza wode","poem":2},{"lineBreak":true},{"text":"ta istta bolla pala miish ehana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tani Samaariyan diza nabeta bolla","poem":1},{"text":"ufayssontta miish be7adis;","poem":2},{"lineBreak":true},{"text":"istti Ba7aale sunththan","poem":2},{"lineBreak":true},{"text":"tinbite yootida;","poem":2},{"lineBreak":true},{"text":"ta deraa Isra7eelekka baleththida.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yerusalaamen diza nabeta bolla","poem":1},{"text":"deexxiza iita miish be7adis;","poem":2},{"lineBreak":true},{"text":"istti laymateettes;","poem":2},{"lineBreak":true},{"text":"wordoteththan de7eettes;","poem":2},{"lineBreak":true},{"text":"oonikka ba iita oosoppe","poem":2},{"lineBreak":true},{"text":"simmontta mala","poem":2},{"lineBreak":true},{"text":"iitata minththeettes;","poem":2},{"lineBreak":true},{"text":"ta matan istti ubbayka","poem":2},{"lineBreak":true},{"text":"Sodoome mala,","poem":2},{"lineBreak":true},{"text":"izin diza asaykka","poem":2},{"lineBreak":true},{"text":"Gamoora mala» gees.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hessa gishshas Ubbaafe Wolqqama GODAY","poem":1},{"text":"hayta nabeta gishshas,","poem":2},{"lineBreak":true},{"text":"«Yerusalaamen diza nabetappe","poem":2},{"lineBreak":true},{"text":"tuna miishshi kezidi","poem":2},{"lineBreak":true},{"text":"biitta ubbaan laalettida gishshas","poem":2},{"lineBreak":true},{"text":"ta istta camo kath mizana;","poem":2},{"lineBreak":true},{"text":"qasse marzettida","poem":2},{"lineBreak":true},{"text":"haath ushshana» gees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ubbaafe Wolqqama GODAY,","poem":1},{"text":"«Hayti nabeti tinbite","poem":2},{"lineBreak":true},{"text":"inttes yootizayssa siyopite;","poem":2},{"lineBreak":true},{"text":"istti inttena","poem":2},{"lineBreak":true},{"text":"wordo hidotan kunththeettes;","poem":2},{"lineBreak":true},{"text":"istti GODAAPPE gidontta","poem":2},{"lineBreak":true},{"text":"baappe medhdhi ekki yooteettes.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tana kadhizayta isttas,","poem":1},{"text":"‹GODAY inttes","poem":2},{"lineBreak":true},{"text":"saro gidana gides› geettes;","poem":2},{"lineBreak":true},{"text":"bantta wozina muumeteththa","poem":2},{"lineBreak":true},{"text":"kaallizayta ubbaa","poem":2},{"lineBreak":true},{"text":"isttas, ‹Iita miishshi","poem":2},{"lineBreak":true},{"text":"inttena gakkenna› geettes.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Iza qaala siyanaassinne azazettanaas","poem":1},{"text":"GODAY de7iza shiiqon isttafe","poem":2},{"lineBreak":true},{"text":"oonee eqqanay?","poem":2},{"lineBreak":true},{"text":"Iza qaala ezgi siyiday oonee?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"GODAA hanqoy gote carko mala dendana;","poem":1},{"text":"mino dambalay","poem":2},{"lineBreak":true},{"text":"iita asata hu7e shocana.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Iza wozina qofa","poem":1},{"text":"mulera polontta dishe","poem":2},{"lineBreak":true},{"text":"iza hanqoy coo hada simmenna;","poem":2},{"lineBreak":true},{"text":"guyeppe yiza layththatan hayssa","poem":2},{"lineBreak":true},{"text":"qonccen intte erana.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hayta ha nabeta ta kiittabeekke;","poem":1},{"text":"gido attiin istti bantta kiita","poem":2},{"lineBreak":true},{"text":"ekki woxxeettes;","poem":2},{"lineBreak":true},{"text":"ta isttas yootontta","poem":2},{"lineBreak":true},{"text":"tinbite yooteettes.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Istti ta zoren eqqidaakko","poem":1},{"text":"ta qaala ta deraa sissana;","poem":2},{"lineBreak":true},{"text":"iita ogeppenne iita oosoppe","poem":2},{"lineBreak":true},{"text":"istta zaarana.","poem":2}]},{"type":"verse","number":23,"content":["Tani matas xalla Xoossee?",{"text":"Haahoska Xoos gidikkinaa?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Tani be7ontta mala geemason","poem":1},{"text":"qotetti attana asi dizee?","poem":2},{"lineBreak":true},{"text":"Salonne sa7a kumiday","poem":2},{"lineBreak":true},{"text":"tana gidikkinaa!» gees GODAY.","poem":2}]},{"type":"verse","number":25,"content":["GODAY, «Tani agumettadis; tani agumettadis» gishe ta sunththan wordo tinbite haasayza nabeta qaala siyadis."]},{"type":"verse","number":26,"content":["Ha yo7oy bantta wozina baleththon wordo tinbite haasayza nabeta wozinan ayde gakkanaas gam7anee?"]},{"type":"verse","number":27,"content":["Istta aawati Ba7aale geetettiza eeqaza gaason ta sunththaa dogida mala, istti issoy issaas yootiza agumon ta asay ta sunththaa dogana mala ooththidaa isttas misatees."]},{"type":"verse","number":28,"content":["Agumettiza nabey ba agumaa yooto; ta qaalay izan dizaadey gidikko he qaala ammaneteththan yooto; happassinne kaththa ayfes ay gaytoteththi dizee?"]},{"type":"verse","number":29,"content":["«Ta qaalay tama malanne shuch qeriza naariqa mala gidennee?» gees."]},{"type":"verse","number":30,"content":["GODAY, «Hessa gishshas qaala issoy issaafe kaysi kaysi ekkidi taappe ekkida mala yootiza nabetara ta eqettays."]},{"type":"verse","number":31,"content":["Bantta doona cinccateththan, ‹GODAY hizgees› giza nabetara ta eqettays» gees."]},{"type":"verse","number":32,"content":["GODAY, «Tani wordo agumo kaallidi tinbite yootiza nabetara eqettays; ta kiittontta dishin woykko ta shuumontta dishin xalateththan wordo yo7o yooteettes; ta derezakka baleththeettes; hayssa ha dereza aykkoka go7ettenna» gees."]},{"type":"heading","content":["Wordo Nabeta Tinbite"]},{"type":"verse","number":33,"content":["GODAY taas, «Ha derey, woykko nabey, woykko qeesey, ‹GODAAS tooho gididay aazee?› giidi oychchiko, ‹GODAAS toohoy inttena; hessa gishshas tani inttena wora olana› gees ga yoota."]},{"type":"verse","number":34,"content":["Nabey, woykko qeesey, woykko ay asikka, ‹Hayssi GODAA tooho› giidi haasaykko tani hessaadenne iza soho asaa qaxxayana."]},{"type":"verse","number":35,"content":["Issoy issoy ba lagge woykko ba dabbo, ‹GODAY ay zaaro immidee?› woykko, ‹GODAY yootiday aazee?› giidi oychchanaas bessees."]},{"type":"verse","number":36,"content":["Hayssafe guyen gidikko, ‹GODAA tooho› giidi intte haasayanaas bessenna. Gaasoykka as ubbaas izi haasayda qaalay izas tooho gidiza gishshas de7o Xoossa, Ubbaafe Wolqqama GODAA nu Xoossa qaala intte bokkiseeta."]},{"type":"verse","number":37,"content":["Hessa gishshas nabezas, ‹GODAY inttes ay zaaro immidee?› woykko, ‹GODAY yootiday aazee?› gaada oychchanaas bessees."]},{"type":"verse","number":38,"content":["Gido attiin intte, ‹Hayssi GODAA tooho› giikko, GODAY tani inttena, ‹Hayssi GODAA tooho› goopite giinkka intte, ‹Hayssi GODAA tooho› gideta."]},{"type":"verse","number":39,"content":["Hessa gishshas inttena, qasseka inttessinne intte aawatas ta immida katamayra gaththada yegga aggana; ta sinththafekka wora olana."]},{"type":"verse","number":40,"content":["Mernaas dogettontta mernaa yeellateththinne kawushshateth ta intte bolla ehana» gides."]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/JER/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/JER/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/JER/22.json","previousChapterAudioLinks":{},"numberOfVerses":40}