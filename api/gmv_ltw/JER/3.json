{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"JER","translationId":"gmv_ltw","name":"Ermaasa Tinbite","commonName":"Ermaasa Tinbite","title":"Ermaasa Tinbite","order":24,"numberOfChapters":52,"sha256":"93dc341c498dc777b4574d7579ba75f7c63468149d8f420fcbf8b21a8a3d04cc","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gmv_ltw/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":3,"content":[{"type":"heading","content":["Ammanettontta Ixxida Isra7eele"]},{"type":"verse","number":1,"content":["«Issi asi ba keeththaayo anjji yeddiin",{"text":"iza baada hara azina gelikko,","poem":2},{"lineBreak":true},{"text":"kase anjji yeddidaadey","poem":2},{"lineBreak":true},{"text":"simmi izikko bizee?","poem":2},{"lineBreak":true},{"text":"izi biikko he biittaya","poem":2},{"lineBreak":true},{"text":"mule tunekkee?","poem":2},{"lineBreak":true},{"text":"Neni gidikko ne siiqiza","poem":2},{"lineBreak":true},{"text":"cora laggetara laymatadasa;","poem":2},{"lineBreak":true},{"text":"histtadakka ha7i neni","poem":2},{"lineBreak":true},{"text":"taakko simmana koyay?» gees.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"«Ane dhoqqu gaada aykkoy baynda","poem":1},{"text":"zumbullata xeella;","poem":2},{"lineBreak":true},{"text":"neni laymas ichchonttasoy","poem":2},{"lineBreak":true},{"text":"hessan dizee?","poem":2},{"lineBreak":true},{"text":"Bonqqana bazzon uttida","poem":2},{"lineBreak":true},{"text":"panga mala","poem":2},{"lineBreak":true},{"text":"oge doonan uttada","poem":2},{"lineBreak":true},{"text":"ne laggeththota naagadasa;","poem":2},{"lineBreak":true},{"text":"histtada neni laymateththaninne","poem":2},{"lineBreak":true},{"text":"iitateththan biittayo tunisadasa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hessa gishshas puuseykka","poem":1},{"text":"puusontta mala digettides;","poem":2},{"lineBreak":true},{"text":"balgo iraykka bukkontta aggides;","poem":2},{"lineBreak":true},{"text":"ne gidikko hanno gakkanaas","poem":2},{"lineBreak":true},{"text":"laymateth aggabeekka;","poem":2},{"lineBreak":true},{"text":"neni yeellatonttaka ixxadasa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ha7i neni tana,","poem":1},{"text":"‹Ta aawawu,","poem":2},{"lineBreak":true},{"text":"taas naateteththa laggezoo!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neni ubbato ta bolla hanqettanee?","poem":1},{"text":"Ne hanqoy mernaassee?› gadasa.","poem":2},{"lineBreak":true},{"text":"Ee neni hizgaasa;","poem":2},{"lineBreak":true},{"text":"gido attiin neni dandayda keena","poem":2},{"lineBreak":true},{"text":"iita miish ubbaa","poem":2},{"lineBreak":true},{"text":"ooththaasa» gees.","poem":2}]},{"type":"heading","content":["Maaroteththas Isra7eelenne Yuhuda Xeygeteth"]},{"type":"verse","number":6,"content":["Kawo Iyosiyaasi kawotida layth GODAY taas, «Hanna ammanoy baynda Isra7eeley ooththidayssa neni be7adii? Iza dhoqqa zumbullata bolla kezada daashsha miththata garsan laymatadus."]},{"type":"verse","number":7,"content":["Iza hayssa ubbaa ooththadakka taakko simmana gaada qoppadis shin simmabeekku. Qasse ammanettontta izi michcho Yuhudaykka hessa beyadus."]},{"type":"verse","number":8,"content":["Ammanoy baynda Isra7eele dereti laymatida gishshas anjjo waraqata imma yeddadis; Isra7eele michcho ammanettontta Yuhudaykka hayssa be7ashe yayyontta kezada laymatishin be7adis."]},{"type":"verse","number":9,"content":["Ba kawushshateththan biitta tunisadus; miththarakka shuchcharakka laymatadus."]},{"type":"verse","number":10,"content":["Hessan ubbaankka izi michchiya, ammanettontta Yuhuday coo simmidaa misatawusife attiin kumeththa wozinappe taakko simmabeekku» gides."]},{"type":"verse","number":11,"content":["GODAY taas, «Ammanettontta Yuhudappe ammanoy baynda Isra7eeley xilla beettadus."]},{"type":"verse","number":12,"content":[{"text":"«Ba; baada pudeha baggas,","poem":1},{"text":"‹Hanne ammanoy baynda","poem":2},{"lineBreak":true},{"text":"Isra7eelee simma!","poem":2},{"lineBreak":true},{"text":"Tani maarotay","poem":2},{"lineBreak":true},{"text":"kumidaade gidida gishshas","poem":2},{"lineBreak":true},{"text":"nena iita ayfen xeellike;","poem":2},{"lineBreak":true},{"text":"mernaaskka hanqettike›","poem":2},{"lineBreak":true},{"text":"gees GODAY.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gidikkonne neni,","poem":1},{"text":"‹GODAA ne Xoossaa bolla","poem":2},{"lineBreak":true},{"text":"makkallateththan,","poem":2},{"lineBreak":true},{"text":"ne bonchchoka allaga xoossatas","poem":2},{"lineBreak":true},{"text":"daashsha miththata garsan","poem":2},{"lineBreak":true},{"text":"aaththa imoninne","poem":2},{"lineBreak":true},{"text":"taas azazettontta ixon neni","poem":2},{"lineBreak":true},{"text":"mooranchcha gididayssa","poem":2},{"lineBreak":true},{"text":"xalla ammana›","poem":2},{"lineBreak":true},{"text":"gees GODAY» gides.","poem":2}]},{"type":"verse","number":14,"content":["Qasseka GODAY,",{"text":"«Intteno ammanettontta","poem":2},{"lineBreak":true},{"text":"asatoo, simmite;","poem":2},{"lineBreak":true},{"text":"tani inttes azina;","poem":2},{"lineBreak":true},{"text":"Tani intte giddofe","poem":2},{"lineBreak":true},{"text":"issi katamappe issaa,","poem":2},{"lineBreak":true},{"text":"issi qommofe nam7ata doorada","poem":2},{"lineBreak":true},{"text":"Xiyoone ehana.","poem":2}]},{"type":"verse","number":15,"content":["«Hessafe guye tani ta wozina mala inttena erateththaninne akeekan heemmiza heenththanchchata inttes immana."]},{"type":"verse","number":16,"content":["Qasseka GODAY intte qooday biitta bolla corattiza wode, ‹GODAA Caaqo Qaala Taabotaa› gi xeygekketa. Izi isttas qofettennanne akeekettenna, dhayennanne haray oosettenna."]},{"type":"verse","number":17,"content":["He woden istti Yerusalaame, ‹GODAA araata› gi xeygana. Kawoteththa ubbaafe asay GODAA sunth bonchchanaas Yerusalaame shiiqana. Hessafe istti bantta iita wozina hanoteththaa kaallettenna."]},{"type":"verse","number":18,"content":["He gallassatan Yuhuda asati Isra7eele asatara gayttidi pudeha bagga biittafe tani kase intte aawatas xinxxo histta immida biitta issife yaana» gees."]},{"type":"heading","content":["Xoossa Derey Eeqa Misletas Goynnida Goyno"]},{"type":"verse","number":19,"content":[{"text":"GODAY, «Tani nena","poem":1},{"text":"attuma nayta mala","poem":2},{"lineBreak":true},{"text":"wostta woththanaakko,","poem":2},{"lineBreak":true},{"text":"doorettida biittayonne","poem":2},{"lineBreak":true},{"text":"ay kawoteththika demmontta","poem":2},{"lineBreak":true},{"text":"lo7o biittayo","poem":2},{"lineBreak":true},{"text":"nena laatissana qoppadis.","poem":2},{"lineBreak":true},{"text":"Qasse tana, ‹Ta aawawu!› gaada","poem":2},{"lineBreak":true},{"text":"xeygana misatides;","poem":2},{"lineBreak":true},{"text":"tana kaallizasoppe","poem":2},{"lineBreak":true},{"text":"guye simmontta misatadasa;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Gido attiin Isra7eele asawu!","poem":1},{"text":"Intte ba azinaas","poem":2},{"lineBreak":true},{"text":"ammanettontta maccassa mala","poem":2},{"lineBreak":true},{"text":"taas ammanettibeekketa» gees.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Istti GODAA bantta Xoossaa balidi","poem":1},{"text":"bantta oge geellasida gishshas","poem":2},{"lineBreak":true},{"text":"Isra7eele deraa waasoy,","poem":2},{"lineBreak":true},{"text":"misha yeehoy aykkoy baynda","poem":2},{"lineBreak":true},{"text":"zumbullata bolla siyettees;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Istti, «Intteno ammanoy baynda","poem":1},{"text":"asatoo! Taakko simmite.","poem":2},{"lineBreak":true},{"text":"Intte ammanettana mala,","poem":2},{"lineBreak":true},{"text":"tani inttena paththana» gides.","poem":2},{"text":"Histtiin isttas,","poem":1},{"text":"«Ero, nuni neekko simmana.","poem":2},{"lineBreak":true},{"text":"Ays giikko neni GODAA","poem":2},{"lineBreak":true},{"text":"nu Xoossa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nuni zumbullata bollanne","poem":1},{"text":"zumata bolla eeqa xoossatas","poem":2},{"lineBreak":true},{"text":"goynoy tumappe nuus bala;","poem":2},{"lineBreak":true},{"text":"tumappe nuus Isra7eeletas","poem":2},{"lineBreak":true},{"text":"atoteththi GODAA nu Xoossaafe.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nuni yelagateththafe doommiin","poem":1},{"text":"nu aawati daaburi","poem":2},{"lineBreak":true},{"text":"demmida ayfeta,","poem":2},{"lineBreak":true},{"text":"istta dorsatanne meheta,","poem":2},{"lineBreak":true},{"text":"istta macca naytanne","poem":2},{"lineBreak":true},{"text":"attuma nayta","poem":2},{"lineBreak":true},{"text":"tuna xoossati mi dhayssida.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nuni yelagateththafe doommidi","poem":1},{"text":"hach gakkanaas,","poem":2},{"lineBreak":true},{"text":"nunikka nu aawatikka","poem":2},{"lineBreak":true},{"text":"GODAA nu Xoossa bolla","poem":2},{"lineBreak":true},{"text":"nagara ooththidos;","poem":2},{"lineBreak":true},{"text":"GODAAS nu Xoossaas","poem":2},{"lineBreak":true},{"text":"azazettibeekko;","poem":2},{"lineBreak":true},{"text":"hessa gishshas ane nuni yeellateth","poem":2},{"lineBreak":true},{"text":"gullunttidi ichchoos;","poem":2},{"lineBreak":true},{"text":"qasse kawushshateththi nuna","poem":2},{"lineBreak":true},{"text":"afala mala kammo» geettes.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/JER/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/JER/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/JER/2.json","previousChapterAudioLinks":{},"numberOfVerses":25}