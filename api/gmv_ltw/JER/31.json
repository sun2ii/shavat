eekkishenne","poem":2},{"lineBreak":true},{"text":"woossishe yaana.","poem":2},{"lineBreak":true},{"text":"Tani istta pultto","poem":2},{"lineBreak":true},{"text":"haaththa achchara","poem":2},{"lineBreak":true},{"text":"suure ogera kaaleththana.","poem":2},{"lineBreak":true},{"text":"Gaasoykka tani Isra7eeles aawa;","poem":2},{"lineBreak":true},{"text":"Efreemeykka taas bayra naa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Intteno kawoteththatoo","poem":1},{"text":"GODAA qaala siyite!","poem":2},{"lineBreak":true},{"text":"Haahon diza abba gaxatankka,","poem":2},{"lineBreak":true},{"text":"‹Isra7eele laalliday","poem":2},{"lineBreak":true},{"text":"izi istta zaari shiishshana;","poem":2},{"lineBreak":true},{"text":"ba wudezakka","poem":2},{"lineBreak":true},{"text":"heenththanchcha mala","poem":2},{"lineBreak":true},{"text":"izi heemmana› giidi awajjite.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gaasoykka GODAY","poem":1},{"text":"Yaaqoobe wozzana;","poem":2},{"lineBreak":true},{"text":"izappe minnizayta kusheppe","poem":2},{"lineBreak":true},{"text":"iza kessi ekkana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Istti yiidi Xiyoone zuma bolla","poem":1},{"text":"ufayssa mazamure yexxana;","poem":2},{"lineBreak":true},{"text":"istti GODAA kiyateth gidida","poem":2},{"lineBreak":true},{"text":"kaththan, woyne ushshan,","poem":2},{"lineBreak":true},{"text":"zayten, deyshaninne","poem":2},{"lineBreak":true},{"text":"dorsa laaqqatan, wofanotaninne","poem":2},{"lineBreak":true},{"text":"ussatan ufayettana;","poem":2},{"lineBreak":true},{"text":"istti haaththi paccontta","poem":2},{"lineBreak":true},{"text":"atakilte soho mala gidana;","poem":2},{"lineBreak":true},{"text":"hayssafe guye istti","poem":2},{"lineBreak":true},{"text":"muuzottettenna.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"He wode geela7oti","poem":1},{"text":"ufayettidi yexxana;","poem":2},{"lineBreak":true},{"text":"wodallatinne cimati guppana;","poem":2},{"lineBreak":true},{"text":"ta istta yeehoza","poem":2},{"lineBreak":true},{"text":"ufayssan laammana;","poem":2},{"lineBreak":true},{"text":"ta istta muuzoteththafe","poem":2},{"lineBreak":true},{"text":"minththeththana;","poem":2},{"lineBreak":true},{"text":"ta isttas ufays immana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tani qeeseta keeha anjjana;","poem":1},{"text":"ta derezakka","poem":2},{"lineBreak":true},{"text":"kiyateththi kaallana» gees.","poem":2}]},{"type":"verse","number":15,"content":["GODAY,",{"text":"«Waasoynne camo yeehoy","poem":1},{"text":"Eraama katamappe seetettides;","poem":2},{"lineBreak":true},{"text":"izi nayti wurida gishshas","poem":2},{"lineBreak":true},{"text":"Eraheela yeekkadus;","poem":2},{"lineBreak":true},{"text":"minetonttaka ixxadus» gees.","poem":2}]},{"type":"verse","number":16,"content":["GODAY, «Yeekkofanne afunxxofa;",{"text":"ne daaburay coo hada attenna;","poem":2},{"lineBreak":true},{"text":"morkketa biittafe istti simmana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sinththafe nees","poem":1},{"text":"hidotay diza gishshas","poem":2},{"lineBreak":true},{"text":"ne nayti bantta","poem":2},{"lineBreak":true},{"text":"biitta simmana» gees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«Efreemey camo milas milalishin","poem":1},{"text":"addafe ta siyadis;","poem":2},{"lineBreak":true},{"text":"‹Loohontta wofano mala","poem":2},{"lineBreak":true},{"text":"tana qaxxayadasa;","poem":2},{"lineBreak":true},{"text":"tanikka qaxxayettadis;","poem":2},{"lineBreak":true},{"text":"neni GODAA ta Xoossa;","poem":2},{"lineBreak":true},{"text":"neni tana zaara;","poem":2},{"lineBreak":true},{"text":"tanikka simmana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ta neeppe haakka bidaappe guye","poem":1},{"text":"simmada modhettadis;","poem":2},{"lineBreak":true},{"text":"ta akeekida wode","poem":2},{"lineBreak":true},{"text":"ta hu7e baqqadis;","poem":2},{"lineBreak":true},{"text":"ta yelagateththaa","poem":2},{"lineBreak":true},{"text":"kawushshateth tookkadis;","poem":2},{"lineBreak":true},{"text":"yeellatada guuxxadis› gides.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Efreemey ta dosada","poem":1},{"text":"ufayettiza ta naaza gidennee?","poem":2},{"lineBreak":true},{"text":"Daro wode ta izara","poem":2},{"lineBreak":true},{"text":"eqetta haasaykkoka","poem":2},{"lineBreak":true},{"text":"zaarada iza gishshas ta qoppays;","poem":2},{"lineBreak":true},{"text":"ta maracey kokkorees;","poem":2},{"lineBreak":true},{"text":"ta izas keeha qadhettays»","poem":2},{"lineBreak":true},{"text":"gees GODAY.","poem":2}]},{"type":"verse","number":21,"content":["GODAY, «Ogen malata essa;",{"text":"bizaso bessiza malata tokka;","poem":2},{"lineBreak":true},{"text":"ne baana wogga ogeza akeeka;","poem":2},{"lineBreak":true},{"text":"geela7oye Isra7eele simma;","poem":2},{"lineBreak":true},{"text":"histtada ne katamata gela.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hanne kaddida nayee!","poem":1},{"text":"Ne ayde gakkanaas toylattanee?","poem":2},{"lineBreak":true},{"text":"GODAY sa7a bolla","poem":2},{"lineBreak":true},{"text":"ooraththa miish medhdhana;","poem":2},{"lineBreak":true},{"text":"hessika maccay","poem":2},{"lineBreak":true},{"text":"adde dooddana» gees.","poem":2}]},{"type":"heading","content":["Xoossa Deres Sinththafe Yaana Ishalo De7o"]},{"type":"verse","number":23,"content":["Ubbaafe Wolqqama GODAA Isra7eele Xoossay, «Tani isttafe di7ettida miishshaa ta isttas zaariza wode istti Yuhuda biittaninne izi katamatan, ‹Nenoo xilloteththi aqiza geeshsha zumazoo! GODAY nena anjjo!› giza qaala zaari go7ettana."]},{"type":"verse","number":24,"content":["Goshshanchchatinne mehe haaron aqizayti Yuhudaninne Yuhuda katamatan issife daana;"]},{"type":"verse","number":25,"content":["Tani labbanida shemppoyo ooraxissana; daaburdaarokka minththana» gees."]},{"type":"verse","number":26,"content":["He wode tani dhiskofe beeggada yuushsha xeelladis; tani mal7o dhisko dhiskadis."]},{"type":"verse","number":27,"content":["GODAY, «Tani Isra7eele biittaninne Yuhuda biittan asinne mehe kunththiza wodey yaana."]},{"type":"verse","number":28,"content":["Istta dhoqallanaas, laallanaas, shira yegganaas, dhayssanaassinne bash istta bolla ehanaas keeha tani minnida mala istta zaara keexxanaassinne tokkanaas keeha minnana» gees."]},{"type":"verse","number":29,"content":["«He wode asay,",{"text":"‹Aawati woyne miththa teera","poem":1},{"text":"caalidayssa miin","poem":2},{"lineBreak":true},{"text":"istta nayta achchi zil7ides›","poem":2},{"lineBreak":true},{"text":"geetettiza leemiso","poem":2},{"lineBreak":true},{"text":"nam7anththo haasayettenna.","poem":2}]},{"type":"verse","number":30,"content":["Gido attiin asay issoy issoy ba nagaran nagaran hayqqana; woyne teera qawu7e mida asa achchi ubbay zil7ana» gees GODAY."]},{"type":"verse","number":31,"content":[{"text":"GODAY, «Tani Isra7eele deraaranne","poem":1},{"text":"Yuhuda deraara ooraththa caaqo","poem":2},{"lineBreak":true},{"text":"caaqettana wodey yaana.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"He caaqozi tani istta Gibxeppe","poem":1},{"text":"kessanaas istta kushe oykkada","poem":2},{"lineBreak":true},{"text":"istta aawatara caaqettida","poem":2},{"lineBreak":true},{"text":"caaqoza mala gidenna;","poem":2},{"lineBreak":true},{"text":"tani isttas","poem":2},{"lineBreak":true},{"text":"azina mala gida dishin","poem":2},{"lineBreak":true},{"text":"istti tanara diza","poem":2},{"lineBreak":true},{"text":"caaqo qaalaza laallida» gees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"«Gido attiin tani GODAY","poem":1},{"text":"he wodeppe guye","poem":2},{"lineBreak":true},{"text":"Isra7eele deraara","poem":2},{"lineBreak":true},{"text":"ta caaqettana caaqoy hayssa;","poem":2},{"lineBreak":true},{"text":"tani ta woga","poem":2},{"lineBreak":true},{"text":"istta wozinan xaafa woththana;","poem":2},{"lineBreak":true},{"text":"tanikka isttas Xoossa gidana;","poem":2},{"lineBreak":true},{"text":"isttika ta dere gidana.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Hayssafe guye oonikka ba lagge","poem":1},{"text":"woykko ba isha,","poem":2},{"lineBreak":true},{"text":"‹GODAA era› giidi tamaarsenna;","poem":2},{"lineBreak":true},{"text":"gaasoykka guuththafe doommidi","poem":2},{"lineBreak":true},{"text":"gita gakkanaas","poem":2},{"lineBreak":true},{"text":"istti ubbay tana erana;","poem":2},{"lineBreak":true},{"text":"tanikka istta qoho atto gaana;","poem":2},{"lineBreak":true},{"text":"istta nagarakka nam7anththo","poem":2},{"lineBreak":true},{"text":"zaara qoppike» gees GODAY.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Gallassan poo7isana mala","poem":1},{"text":"arshe woththiday,","poem":2},{"lineBreak":true},{"text":"omarsan poo7isana mala aginanne","poem":2},{"lineBreak":true},{"text":"xoolintteta azaziday,","poem":2},{"lineBreak":true},{"text":"dambalay guummana mala abba qaaththizay","poem":2},{"lineBreak":true},{"text":"iza sunththay GODAA Ubbaafe","poem":2},{"lineBreak":true},{"text":"Wolqqama Xoossa geetettizayssi,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"«Ha eqqidi diza medheta wogay","poem":1},{"text":"ta sinththafe kichchiko","poem":2},{"lineBreak":true},{"text":"he wode Isra7eele zereththati","poem":2},{"lineBreak":true},{"text":"ta sinththan","poem":2},{"lineBreak":true},{"text":"mernaas kawoteth gididi","poem":2},{"lineBreak":true},{"text":"duussay attana» gees GODAY.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"GODAY, «Bollan diza salota","poem":1},{"text":"gakki wadhdhanaas dandayettiko,","poem":2},{"lineBreak":true},{"text":"woykko garsan diza biitta xapho","poem":2},{"lineBreak":true},{"text":"gakki pilggi eranaas dandayettiko","poem":2},{"lineBreak":true},{"text":"he wode tani Isra7eeley ooththida","poem":2},{"lineBreak":true},{"text":"ooso ubbaa gishshas","poem":2},{"lineBreak":true},{"text":"ta istta yegga aggana» gees.","poem":2}]},{"type":"verse","number":38,"content":["GODAY, «Hanani7eele Gimbefe doommidi gula penge gakkanaas katamaya taas GODAAS oosettana wodey yaana."]},{"type":"verse","number":39,"content":["Wadha wodorozi heeppe doommi sitti giidi Gaareebe zumbullatara aadhdhidi Go7aha gakkanaas micettana."]},{"type":"verse","number":40,"content":["Ahaynne bidinththi yegettiza shoobba ubbay arshey mokkiza Qediroone shoobbara biidi Para Penge gakkanaas diza tidhdhi gida dembay ubbay GODAAS dummatidaaz gidana; hessafe guye he katamaya shodettukunne laalettuku» gees."]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/JER/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/JER/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/JER/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}