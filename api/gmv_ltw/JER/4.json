e;","poem":2},{"lineBreak":true},{"text":"agunththa giddon zeropite.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Intteno Yuhuda asatoo,","poem":1},{"text":"Yerusalaamen dizaytoo!","poem":2},{"lineBreak":true},{"text":"GODAAS intte qaxxarettite;","poem":2},{"lineBreak":true},{"text":"intte wozina","poem":2},{"lineBreak":true},{"text":"iitateththaa diggite;","poem":2},{"lineBreak":true},{"text":"histtontta aggiko","poem":2},{"lineBreak":true},{"text":"intte ooththida","poem":2},{"lineBreak":true},{"text":"iitateththaa gishshas","poem":2},{"lineBreak":true},{"text":"ta hanqoy tama mala","poem":2},{"lineBreak":true},{"text":"eexxi kezana;","poem":2},{"lineBreak":true},{"text":"oonikka iza toyssanaas","poem":2},{"lineBreak":true},{"text":"dandayenna» gees.","poem":2}]},{"type":"heading","content":["Pudeha Baggafe Yaana Bash"]},{"type":"verse","number":5,"content":["GODAY, « ‹Biitta ubbaan",{"text":"zaye punnite!›","poem":2},{"lineBreak":true},{"text":"giidi Yuhudan yootite.","poem":2},{"lineBreak":true},{"text":"Yerusalaamenkka awajjite;","poem":2},{"lineBreak":true},{"text":"‹Issife shiiqite!","poem":2},{"lineBreak":true},{"text":"Ane gimbettida katamatakko","poem":2},{"lineBreak":true},{"text":"baqatoos!› gi waassite.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xiyoone gelanaas bandira oykkite!","poem":1},{"text":"eeson baqati attite;","poem":2},{"lineBreak":true},{"text":"Ays giikko tani pudeha baggafe","poem":2},{"lineBreak":true},{"text":"hanqonne bash ehana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gaammoy ba dizasoppe kezides;","poem":1},{"text":"kawoteththata","poem":2},{"lineBreak":true},{"text":"dhayssizay kiitettides;","poem":2},{"lineBreak":true},{"text":"ne biittayokka bulasanaas","poem":2},{"lineBreak":true},{"text":"ba dizasoppe kezides;","poem":2},{"lineBreak":true},{"text":"ne katamati laalettana;","poem":2},{"lineBreak":true},{"text":"kundidikka kayzi attana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hessa gishshas maaqa may7ite;","poem":1},{"text":"kayottishe, ‹Wuu! Wuy›","poem":2},{"lineBreak":true},{"text":"gi yeekkite.","poem":2},{"lineBreak":true},{"text":"Ays giikko GODAA hanqo seelay","poem":2},{"lineBreak":true},{"text":"nu bollafe simmibeenna» gees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Qasseka GODAY,","poem":1},{"text":"«He gallas kawo wozinaynne","poem":2},{"lineBreak":true},{"text":"shuumeta wozinay taahana;","poem":2},{"lineBreak":true},{"text":"qeeseti dagammana;","poem":2},{"lineBreak":true},{"text":"nabetikka kokkorana» gees.","poem":2}]},{"type":"verse","number":10,"content":["Histtiin tani, «Abeet Ubbaa Haariza GODAWU! Mashshay istta qoodhen wodhdhiin, ‹Inttes sa7ay saro gidana› gaada ha asaanne Yerusalaame ays keeha baleththadii?» gadis."]},{"type":"verse","number":11,"content":["He woden ha asaassinne Yerusalaames, «Bazzon diza aykkoy baynda zumbullatappe xuuggiza carkoy ta deraa bolla carkana; gido attiin hessi kath suragganaassinne geeshshanaas gidenna."]},{"type":"verse","number":12,"content":["Hessafekka keehi wolqqamiza carkoy ta azazon carkana; ha7i tani istta bolla pirdana» geetetti yootettana."]},{"type":"heading","content":["Morkken Yuhuda Doodeteth"]},{"type":"verse","number":13,"content":[{"text":"Be7ite! Morkkey shaara mala","poem":1},{"text":"biitta kumides;","poem":2},{"lineBreak":true},{"text":"iza para-gaaretikka","poem":2},{"lineBreak":true},{"text":"gote carko mala yeettes;","poem":2},{"lineBreak":true},{"text":"iza paratikka","poem":2},{"lineBreak":true},{"text":"golle kafota mala eesoteettes;","poem":2},{"lineBreak":true},{"text":"aayye ana nu dhayana goos!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nenoo Yerusalaamee!","poem":1},{"text":"Ne attana koykko ne wozina","poem":2},{"lineBreak":true},{"text":"iitateththaa meecetta;","poem":2},{"lineBreak":true},{"text":"Iita qofay ne wozinan","poem":2},{"lineBreak":true},{"text":"ayde gakkanaas gam7anee?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Cenggurssi Daaneppe seetettees;","poem":1},{"text":"Efreeme zumata bolla","poem":2},{"lineBreak":true},{"text":"bashshi awajjeettes.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"«Kawoteththatas yootite;","poem":1},{"text":"Yerusalaameskka,","poem":2},{"lineBreak":true},{"text":"‹Dooddi un7eththizayti","poem":2},{"lineBreak":true},{"text":"haaho biittafe yaana;","poem":2},{"lineBreak":true},{"text":"Yuhuda katamata","poem":2},{"lineBreak":true},{"text":"bollaka ceeqettana;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Iza ta bolla makkallida gishshas","poem":1},{"text":"kath naagiza asa mala","poem":2},{"lineBreak":true},{"text":"istti Yuhuda giddoththana› giite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":["Ne hanoynne ne oosoy",{"text":"hessa ne bolla ehides;","poem":2},{"lineBreak":true},{"text":"hessi nees qixaate;","poem":2},{"lineBreak":true},{"text":"hessika ay mala cammizaazee!","poem":2},{"lineBreak":true},{"text":"ay mala wozina menththizaazee!»","poem":2},{"lineBreak":true},{"text":"gees GODAY.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Waanoo tanii!","poem":1},{"text":"Tani hayssa wostta dandayanee!","poem":2},{"lineBreak":true},{"text":"Tana metides!","poem":2},{"lineBreak":true},{"text":"Ta wozinay hirgees;","poem":2},{"lineBreak":true},{"text":"tani co7u gaanaas dandaykke.","poem":2},{"lineBreak":true},{"text":"Ays giikko tani zaye","poem":2},{"lineBreak":true},{"text":"cenggurssinne","poem":2},{"lineBreak":true},{"text":"ola cenggurs siyadis.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Iita miishshi iita miish kaallees;","poem":1},{"text":"mule biittay moorettides;","poem":2},{"lineBreak":true},{"text":"ta dunkaanetinne magalashati","poem":2},{"lineBreak":true},{"text":"eeson dhayda.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Tani ayde gakkanaas","poem":1},{"text":"ola malata xeellanee?","poem":2},{"lineBreak":true},{"text":"ta ayde gakkanaas","poem":2},{"lineBreak":true},{"text":"zaye giiris siyanee?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"GODAY, «Ta asay eeya;","poem":1},{"text":"istti tana erettenna.","poem":2},{"lineBreak":true},{"text":"Istti yuushshi qopponttayta;","poem":2},{"lineBreak":true},{"text":"istti akeekay bayndayta;","poem":2},{"lineBreak":true},{"text":"istti iita miish","poem":2},{"lineBreak":true},{"text":"ooththanaas eranchchata;","poem":2},{"lineBreak":true},{"text":"lo7o ooththanaas","poem":2},{"lineBreak":true},{"text":"eray paccidayta» gees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Tani sa7a xeellada sa7ay","poem":1},{"text":"lo7i giigonttayssanne","poem":2},{"lineBreak":true},{"text":"coo mela dizayssa be7adis.","poem":2},{"lineBreak":true},{"text":"Qasse salota xeellada isttan","poem":2},{"lineBreak":true},{"text":"poo7oy bayndayssa be7adis.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Tani zumata xeellada","poem":1},{"text":"istti kokkorishininne","poem":2},{"lineBreak":true},{"text":"zumbullati ubbay","poem":2},{"lineBreak":true},{"text":"yon7iyon7ishin be7adis.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Tani xeelladis shin","poem":1},{"text":"ay asikka be7abeekke;","poem":2},{"lineBreak":true},{"text":"salo kafotikka ubbay","poem":2},{"lineBreak":true},{"text":"piradhdhidi dhayda.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Aradda biittay","poem":1},{"text":"bazzo gididayssa be7adis;","poem":2},{"lineBreak":true},{"text":"GODAA sinththan,","poem":2},{"lineBreak":true},{"text":"iza suule hanqo sinththan","poem":2},{"lineBreak":true},{"text":"he katamatikka laalettida.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"GODAY, «Mule biittay bulattana;","poem":1},{"text":"gido attiin tani izo","poem":2},{"lineBreak":true},{"text":"mulera dhayssike.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Hessa gishshas sa7ay yeekkana;","poem":1},{"text":"saloykka dhumana.","poem":2},{"lineBreak":true},{"text":"Ays giikko tani gadis;","poem":2},{"lineBreak":true},{"text":"he qofaa ta laammontta mala","poem":2},{"lineBreak":true},{"text":"qachchadis» gees.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Para asatanne wondafe","poem":1},{"text":"asata kachcha gaason","poem":2},{"lineBreak":true},{"text":"asay katama ubbaafe baqatana.","poem":2},{"lineBreak":true},{"text":"Baggay woxxidi wora gars gelana;","poem":2},{"lineBreak":true},{"text":"baggay qasse","poem":2},{"lineBreak":true},{"text":"zaalla bolla kezana;","poem":2},{"lineBreak":true},{"text":"katamay ubbay asi baynda","poem":2},{"lineBreak":true},{"text":"kayzi attana.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Hanne bashshas uttidaaree!","poem":1},{"text":"Neni ay ooththay?","poem":2},{"lineBreak":true},{"text":"Ne zo7o may7o ays may7ay?","poem":2},{"lineBreak":true},{"text":"Worqqa alleqokka ays aaththay?","poem":2},{"lineBreak":true},{"text":"Ne ayfe ciro ays tiyay?","poem":2},{"lineBreak":true},{"text":"Neni coo mela","poem":2},{"lineBreak":true},{"text":"nena lo7eththaasa;","poem":2},{"lineBreak":true},{"text":"Ne laggeththoti nena kadhida;","poem":2},{"lineBreak":true},{"text":"istti nena wodhanaas koyeettes.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Tani koyro bayra naa yelanaas","poem":1},{"text":"miixattiza maccassa mala","poem":2},{"lineBreak":true},{"text":"ne waassishin ta siyadis;","poem":2},{"lineBreak":true},{"text":"Yerusalaame macca naya","poem":2},{"lineBreak":true},{"text":"peenoy tucettanaashe","poem":2},{"lineBreak":true},{"text":"gakkanaas waassishininne","poem":2},{"lineBreak":true},{"text":"ba kushe miccada,","poem":2},{"lineBreak":true},{"text":"«Ta waanoo! Hekko tana","poem":2},{"lineBreak":true},{"text":"wodhana geettes!»","poem":2},{"lineBreak":true},{"text":"gishin siyadis.","poem":2}]}],"foo