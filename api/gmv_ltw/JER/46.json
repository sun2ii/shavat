eBreak":true},{"text":"giigettida gishshas","poem":2},{"lineBreak":true},{"text":"intte dizason dizason","poem":2},{"lineBreak":true},{"text":"giigetti uttite.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wolqqama gidida Aphphise geetettiza","poem":1},{"text":"eeqa xoossay ays kundidee?","poem":2},{"lineBreak":true},{"text":"GODAY iza sugi yeggida gishshas","poem":2},{"lineBreak":true},{"text":"eqqana dandaybeenna.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Iza kaalliza asati","poem":1},{"text":"zaari zaari dhuphettana;","poem":2},{"lineBreak":true},{"text":"issoy issaa bolla kundana;","poem":2},{"lineBreak":true},{"text":"‹Ane dendite!","poem":2},{"lineBreak":true},{"text":"Gede nu derenne","poem":2},{"lineBreak":true},{"text":"nu asaakko ane simmoos;","poem":2},{"lineBreak":true},{"text":"morkke mashshafekka","poem":2},{"lineBreak":true},{"text":"ane kessi ekkoos› gaana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Istti heen, ‹Gibxe kawo Paarooney","poem":1},{"text":"baas imettida qaadan","poem":2},{"lineBreak":true},{"text":"go7ettontta dishe","poem":2},{"lineBreak":true},{"text":"coo ta days ta days gi","poem":2},{"lineBreak":true},{"text":"ceeqettizaade gi xeygana› gides.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Iza sunththay GODAA","poem":1},{"text":"Ubbaafe Wolqqama","poem":2},{"lineBreak":true},{"text":"Xoossa geetettiza Kawoy,","poem":2},{"lineBreak":true},{"text":"tani ta de7on caaqqays;","poem":2},{"lineBreak":true},{"text":"zumata giddon diza","poem":2},{"lineBreak":true},{"text":"Taaboore zuma misatizay,","poem":2},{"lineBreak":true},{"text":"abba achchan diza","poem":2},{"lineBreak":true},{"text":"Qarmeloose zuma","poem":2},{"lineBreak":true},{"text":"misatiza issaadey yaanaas dees.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Intteno Gibxe biittan dizaytoo!","poem":1},{"text":"Di7etti baanaas","poem":2},{"lineBreak":true},{"text":"inttes dizaaz giigsite;","poem":2},{"lineBreak":true},{"text":"Memppisa laallettada izin","poem":2},{"lineBreak":true},{"text":"asi baynda bula gidana.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Gibxe biittay lo7o ussa mala;","poem":1},{"text":"gido attiin saxxiza","poem":2},{"lineBreak":true},{"text":"boxey pudeha baggafe yaana.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Miishshan shametti yida","poem":1},{"text":"izi olanchchati","poem":2},{"lineBreak":true},{"text":"modhdhida wofano mala.","poem":2},{"lineBreak":true},{"text":"Istti qaxxayettana","poem":2},{"lineBreak":true},{"text":"wodey gakkida gishshassinne","poem":2},{"lineBreak":true},{"text":"istti dhayanaas wodey","poem":2},{"lineBreak":true},{"text":"matida gishshas","poem":2},{"lineBreak":true},{"text":"istti issife","poem":2},{"lineBreak":true},{"text":"guye simmi baqatana;","poem":2},{"lineBreak":true},{"text":"ba dizason minni eqqidi","poem":2},{"lineBreak":true},{"text":"eqettanaas dandayettenna.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Morkkey xooni xooni yishin","poem":1},{"text":"Gibxe asay baqatishe","poem":2},{"lineBreak":true},{"text":"shooshshi suyqiza mala suyqana;","poem":2},{"lineBreak":true},{"text":"mith qanxxana biza asa mala","poem":2},{"lineBreak":true},{"text":"izi morkketi izo qanxxana","poem":2},{"lineBreak":true},{"text":"kaltta ekki yaana.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Dhippi gida wora gidikkoka","poem":1},{"text":"woray qeexettees;","poem":2},{"lineBreak":true},{"text":"istta daroteththay boole mala;","poem":2},{"lineBreak":true},{"text":"istti qoodettanaas dandayettenna.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Gibxe macca naya yeellatana;","poem":1},{"text":"pudeha bagga deres","poem":2},{"lineBreak":true},{"text":"aadhdha imettana.»","poem":2}]},{"type":"verse","number":25,"content":["Ubbaafe Wolqqama GODAA Isra7eele Xoossay, «Teebeese xoossa Amoone bolla, Paaroone bolla, Gibxe bollanne izi eeqa xoossata bolla, izi kawota bollanne Paaroonen ammanettizayta bolla tani qixaate ehana."]},{"type":"verse","number":26,"content":["Istta wodhanaas koyza Baabiloone Kawo Nabukadanaxoore kusheninne iza olanchchata kushen ta aaththa immana. Guuththa wodeppe guye Gibxey kaseyssaththo asi dizaso gidana» gees."]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"«Ta oosanchcha Yaaqoobe yayyofa;","poem":1},{"text":"Isra7eele shirotoppa;","poem":2},{"lineBreak":true},{"text":"ta nena haaho biittafe","poem":2},{"lineBreak":true},{"text":"ne zarekka di7etti","poem":2},{"lineBreak":true},{"text":"bidasoppe ashshana.","poem":2},{"lineBreak":true},{"text":"Yaaqoobeykka simmidi","poem":2},{"lineBreak":true},{"text":"saroteththan woppu gi daana;","poem":2},{"lineBreak":true},{"text":"iza babisana miishshika deenna.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ta nenara diza gishshas","poem":1},{"text":"ta oosanchcha Yaaqoobe babbofa.","poem":2},{"lineBreak":true},{"text":"Ta nena izan laallida kawoteth","poem":2},{"lineBreak":true},{"text":"ubbaa mulera dhayssikokka","poem":2},{"lineBreak":true},{"text":"nena gidikko","poem":2},{"lineBreak":true},{"text":"mulera dhayssike.","poem":2},{"lineBreak":true},{"text":"Ta nees bessiza qixaate qaxxayana attiin","poem":2},{"lineBreak":true},{"text":"mela aggike» gees GODAY.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/JER/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/JER/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/JER/45.json","previousChapterAudioLinks":{},"numberOfVerses":28}