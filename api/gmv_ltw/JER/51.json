agati geeshshasoho","poem":1},{"text":"GODAA Keeth gelida gishshas,","poem":2},{"lineBreak":true},{"text":"‹Nuni cayettidos;","poem":2},{"lineBreak":true},{"text":"yeellay nu sinth kammides;","poem":2},{"lineBreak":true},{"text":"kawushshateththika","poem":2},{"lineBreak":true},{"text":"gulluntidos› giite» gees.","poem":2}]},{"type":"verse","number":52,"content":["Gido attiin GODAY,",{"text":"«Baabiloone eeqa xoossata","poem":1},{"text":"qaxxayana wodey yaana;","poem":2},{"lineBreak":true},{"text":"izi biitta ubbaan","poem":2},{"lineBreak":true},{"text":"madunxidayti goottarana.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Baabilooney pude salo kezikokka,","poem":1},{"text":"dhoqqu gida mino miixa","poem":2},{"lineBreak":true},{"text":"ooththikokka tani dhayssizayta","poem":2},{"lineBreak":true},{"text":"izi bolla yeddana» gees.","poem":2}]},{"type":"heading","content":["Baabiloone Dhayo"]},{"type":"line_break"},{"type":"verse","number":54,"content":[{"text":"«Baabilooneppe waasoy siyettana;","poem":1},{"text":"istta biittafe gita bashsha","poem":2},{"lineBreak":true},{"text":"cenggurssi siyettana.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"GODAY Baabiloone dhayssana;","poem":1},{"text":"keeha waassiza izi waasoza","poem":2},{"lineBreak":true},{"text":"co7u histtana;","poem":2},{"lineBreak":true},{"text":"istta morkketi","poem":2},{"lineBreak":true},{"text":"gita haaththa mala guummana;","poem":2},{"lineBreak":true},{"text":"istta waasoykka kooshumana.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Baabiloone dhayssiza miishshi yaana;","poem":1},{"text":"izi olanchchati di7ettana;","poem":2},{"lineBreak":true},{"text":"istta wondafeykka meqqana;","poem":2},{"lineBreak":true},{"text":"GODAY gene ooso gishshas","poem":2},{"lineBreak":true},{"text":"halo kessizaadenne","poem":2},{"lineBreak":true},{"text":"izi haniza miish ubbaas","poem":2},{"lineBreak":true},{"text":"bessiza waaga qanxxiza Xoossa.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Izi shuumetanne aadho eranchchata","poem":1},{"text":"izo haarizaytanne gita asata,","poem":2},{"lineBreak":true},{"text":"izi olanchchata tani maththosana;","poem":2},{"lineBreak":true},{"text":"istti mernaas ichchana;","poem":2},{"lineBreak":true},{"text":"simmidikka beeggettenna» gees","poem":2},{"lineBreak":true},{"text":"iza sunththi GODAA","poem":2},{"lineBreak":true},{"text":"Ubbaafe Wolqqama","poem":2},{"lineBreak":true},{"text":"Xoossaa geetettiza kawoy.","poem":2}]},{"type":"verse","number":58,"content":["GODAY Ubbaafe Wolqqama Xoossay,",{"text":"«Gubbay dalga gidida","poem":1},{"text":"Baabiloone gimbetti laalettana;","poem":2},{"lineBreak":true},{"text":"dhoqqu gida izi pengetikka","poem":2},{"lineBreak":true},{"text":"taman xuugettana;","poem":2},{"lineBreak":true},{"text":"asay hada daaburees;","poem":2},{"lineBreak":true},{"text":"kawoteththata daaburay","poem":2},{"lineBreak":true},{"text":"tamas xalla gidana» gees.","poem":2}]},{"type":"verse","number":59,"content":["Yuhuda kawo Sedeqiyaasi kawotida oydanththo layththan kawoza gibbe zabezi Ma7iseya naaza Neeriya naa Sarayay kawozara Baabiloone bida wode nabe Ermaasi izas yootida kiitay hayssa."]},{"type":"verse","number":60,"content":["Ermaasi Baabiloone gishshas kase xaafi woththidayssa ubbaa Baabiloone bolla yaana bash ubbaa xaaththa maxaafan xaafides."]},{"type":"verse","number":61,"content":["Sarayaska, «Neni Baabiloone gakkida mala hayssa qaala ubbaaka ne qaala dhoqqu histtada nababanayssa baloppa."]},{"type":"verse","number":62,"content":["Neni, ‹Abeet GODAWU! Neni hanno ha sohoyin as gidiin mehey mulera dhayana gakkanaas mernaas bula kessana gadasa› ga."]},{"type":"verse","number":63,"content":["Neni hayssa xaaththa maxaafaza nababa wursidaappe guye iza giddon shuch qachchada Efiraaxise shaafan efa yegga."]},{"type":"verse","number":64,"content":["Histtada, ‹Baabilooneykka ta izi bolla ehiza bashshaafe dendidayssan hayssaththo mitettana; nam7anththo simma denduku; izi asaykka kundana› ga» gees. Ermaasi haasayda qaalay hayssan polettides."]}],"footnotes":[{"noteId":6,"caller":"+","text":"Sheshaakay Baabiloone katama guussa.","reference":{"chapter":51,"verse":41}}]},"thisChapterLink":"/api/gmv_ltw/JER/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/JER/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/JER/50.json","previousChapterAudioLinks":{},"numberOfVerses":64}