{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"JER","translationId":"gmv_ltw","name":"Ermaasa Tinbite","commonName":"Ermaasa Tinbite","title":"Ermaasa Tinbite","order":24,"numberOfChapters":52,"sha256":"93dc341c498dc777b4574d7579ba75f7c63468149d8f420fcbf8b21a8a3d04cc","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gmv_ltw/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["Ubbaafe Wolqqama GODAY, «He woden Yuhuda kawota meqeththi, shuumeta meqeththi, qeeseta meqeththi, nabeta meqeththinne Yerusalaamen diza asata meqeththi ubbay duufoppe maxettidi kezana."]},{"type":"verse","number":2,"content":["Histtidi istti siiqida, kiitettida, kaallida, zore oychchidanne goynnida arshe sinththan, agina sinththaninne salo xoolintteta ubbaa sinththan micettana. Istta meqeththay shiiqenna woykko moogettenna; gido attiin biitta bolla olettida buura mala gidana."]},{"type":"verse","number":3,"content":["Ha iita asaa kusheppe attidayti ubbay ta istta goodda yeddidaso ubbaan de7oppe hayqo doorana» gees."]},{"type":"heading","content":["Nagara Gaason Gakkiza Qixaate"]},{"type":"verse","number":4,"content":["GODAY tana, «Asaas, ‹Asi kundiko kundidasohoppe simmidi dendennee?",{"text":"Woykko asi balidaa gidikko","poem":2},{"lineBreak":true},{"text":"guyeppe ba balaappe simmennee?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Histtiin hayssi derezi","poem":1},{"text":"ays guye simmi bizee?","poem":2},{"lineBreak":true},{"text":"Yerusalaamey ays ubbato","poem":2},{"lineBreak":true},{"text":"guye simmazee?","poem":2},{"lineBreak":true},{"text":"Istti gene ooso minththi oykkida;","poem":2},{"lineBreak":true},{"text":"simmanaaska koyettenna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tani istta lo7eththa ezgadis;","poem":1},{"text":"istti suure haasayettenna;","poem":2},{"lineBreak":true},{"text":"ta ay ooththadinaa?› gees.","poem":2},{"lineBreak":true},{"text":"Gido attiin ba iita ooso","poem":2},{"lineBreak":true},{"text":"paaxizay issoyka deenna;","poem":2},{"lineBreak":true},{"text":"olas dirgiza para mala","poem":2},{"lineBreak":true},{"text":"ubbayka baas baas woxxees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Shimela geetettiza kafoti","poem":1},{"text":"bantti simmiza wode ereettes;","poem":2},{"lineBreak":true},{"text":"haraphpheti, dagicetinne","poem":2},{"lineBreak":true},{"text":"waalla geetettiza kafoti","poem":2},{"lineBreak":true},{"text":"ba dendi biza wode ereettes;","poem":2},{"lineBreak":true},{"text":"gido attiin ta derey","poem":2},{"lineBreak":true},{"text":"GODAA woga eribeenna.","poem":2},{"noteId":1}]},{"type":"verse","number":8,"content":["Wordanchcha xaafeti bantta bi7iren",{"text":"ta wogaa wordora xaafida;","poem":2},{"lineBreak":true},{"text":"histtiin waanidi,","poem":2},{"lineBreak":true},{"text":"‹Nuni aadho eranchcha;","poem":2},{"lineBreak":true},{"text":"GODAA wogay","poem":2},{"lineBreak":true},{"text":"nunara dees› geetii?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Aadho eranchchati yeellatana;","poem":1},{"text":"istti kawuyananne","poem":2},{"lineBreak":true},{"text":"woximaden oykettana.","poem":2},{"lineBreak":true},{"text":"GODAA qaalara","poem":2},{"lineBreak":true},{"text":"istti eqettichchiin","poem":2},{"lineBreak":true},{"text":"isttas aaza erateththi dizee?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hessa gishshas tani istta machcheta","poem":1},{"text":"hara azinatas,","poem":2},{"lineBreak":true},{"text":"istta biittatakka","poem":2},{"lineBreak":true},{"text":"allagatas immana;","poem":2},{"lineBreak":true},{"text":"guuththayka gitaykka ubbay","poem":2},{"lineBreak":true},{"text":"bantta go7as yiiqeteettes.","poem":2},{"lineBreak":true},{"text":"Nabetinne qeesetikka ubbay","poem":2},{"lineBreak":true},{"text":"as baleththeettes.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Istti ta dereza madunththaa","poem":1},{"text":"qeeri miishshan qoodidi","poem":2},{"lineBreak":true},{"text":"maaddontta dhale immeettes;","poem":2},{"lineBreak":true},{"text":"saroy baynda,","poem":2},{"lineBreak":true},{"text":"‹Saro, saro› geettes.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tuna ooso ooththidi yeellatidoo?","poem":1},{"text":"Chii! Mulekka yeellatibeettenna.","poem":2},{"lineBreak":true},{"text":"Istti yeellay aazakkoka erettenna.","poem":2},{"lineBreak":true},{"text":"Hessa gishshas","poem":2},{"lineBreak":true},{"text":"isttika kundidaytara","poem":2},{"lineBreak":true},{"text":"issife kundana;","poem":2},{"lineBreak":true},{"text":"ta istta qaxxayiza wode","poem":2},{"lineBreak":true},{"text":"istti kawuyana» gees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"GODAY, «Istti goyi kessida","poem":1},{"text":"kath ubbaa","poem":2},{"lineBreak":true},{"text":"ta isttafe ekkaychchana;","poem":2},{"lineBreak":true},{"text":"istta woyne turan","poem":2},{"lineBreak":true},{"text":"ayfey dhayana;","poem":2},{"lineBreak":true},{"text":"balase miththika ayfe immenna;","poem":2},{"lineBreak":true},{"text":"istta bonccotikka qokkana;","poem":2},{"lineBreak":true},{"text":"tani isttas immidayssi","poem":2},{"lineBreak":true},{"text":"isttafe ekettichchana» gees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Histtiin asati,","poem":1},{"text":"«Nuni hayssan ays uttinoo?","poem":2},{"lineBreak":true},{"text":"Ane issi bolla shiiqite;","poem":2},{"lineBreak":true},{"text":"gimbetti uttida katamatan","poem":2},{"lineBreak":true},{"text":"baqati biidi heen hayqqoos;","poem":2},{"lineBreak":true},{"text":"GODAA nu Xoossay nuna","poem":2},{"lineBreak":true},{"text":"hayqqana mala pirdides;","poem":2},{"lineBreak":true},{"text":"nuni iza bolla","poem":2},{"lineBreak":true},{"text":"nagara ooththida gishshas","poem":2},{"lineBreak":true},{"text":"nu uyana mala marzera diza","poem":2},{"lineBreak":true},{"text":"haath immides.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"‹Saroy yaana› giidi","poem":1},{"text":"hidota ooththidos;","poem":2},{"lineBreak":true},{"text":"gido attiin","poem":2},{"lineBreak":true},{"text":"lo7o miishshi yibeenna.","poem":2},{"lineBreak":true},{"text":"‹Nuni paxana› giidi amottidos;","poem":2},{"lineBreak":true},{"text":"gido attiin dagama xalla gidides.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Morkketa para peenoy","poem":1},{"text":"Daane katamappe siyettees;","poem":2},{"lineBreak":true},{"text":"istta wodalla parata caashan","poem":2},{"lineBreak":true},{"text":"biittay ubbay qaaxxees;","poem":2},{"lineBreak":true},{"text":"biittayonne biittay bolla","poem":2},{"lineBreak":true},{"text":"diza ubbaa,","poem":2},{"lineBreak":true},{"text":"katamayonne izin diza ubbaa","poem":2},{"lineBreak":true},{"text":"mittanaas yida» geettes.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"GODAY, «Be7ite,","poem":1},{"text":"tani marzera diza shooshshata,","poem":2},{"lineBreak":true},{"text":"muurennizayta hiillateththi","poem":2},{"lineBreak":true},{"text":"teqqanaas dandayontta","poem":2},{"lineBreak":true},{"text":"haso shooshshata","poem":2},{"lineBreak":true},{"text":"intte giddo yeddana;","poem":2},{"lineBreak":true},{"text":"istti inttena dukkana» gees.","poem":2}]},{"type":"heading","content":["Ermaasi Deraas Ceecida Ceece"]},{"type":"verse","number":18,"content":[{"text":"Ta ceeciza wode","poem":1},{"text":"tana minththeththizayssoo!","poem":2},{"lineBreak":true},{"text":"Ta wozinay keehi meqqides.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ta asay haaho biittan dishe","poem":1},{"text":"waassiza waaso siya.","poem":2},{"lineBreak":true},{"text":"Istti, «GODAY Xiyoonen deennee?","poem":2},{"lineBreak":true},{"text":"Izi kawoykka heen deennee?»","poem":2},{"lineBreak":true},{"text":"giidi waasseettes.","poem":2},{"lineBreak":true},{"text":"Histtiin GODAY izas,","poem":2},{"lineBreak":true},{"text":"«Istti baas massida misletan,","poem":2},{"lineBreak":true},{"text":"hada gidida eeqa xoossatan","poem":2},{"lineBreak":true},{"text":"tana ays hanqeththidoo?» gees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Histtiin asay,","poem":1},{"text":"«Hekko kaththa shiishsho","poem":2},{"lineBreak":true},{"text":"wodey aadhdhides;","poem":2},{"lineBreak":true},{"text":"boneykka wurides;","poem":2},{"lineBreak":true},{"text":"nunikka attibeekko»","poem":2},{"lineBreak":true},{"text":"giidi waasseettes.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ta derey madunxishin","poem":1},{"text":"tanikka madunxadis;","poem":2},{"lineBreak":true},{"text":"yeekkadissinne dagammadis.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Gala7aaden tiyiza dhaley deennee?","poem":1},{"text":"Woykko heen aakimey deennee?","poem":2},{"lineBreak":true},{"text":"Histtiin ta deraa madunththi","poem":2},{"lineBreak":true},{"text":"ays paxibeennee?","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Dagicey kafo qommo gididayssa qonccisees.","reference":{"chapter":8,"verse":7}}]},"thisChapterLink":"/api/gmv_ltw/JER/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/JER/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/JER/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}