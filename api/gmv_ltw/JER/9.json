ordora","poem":2},{"lineBreak":true},{"text":"biittay bolla minnida;","poem":2},{"lineBreak":true},{"text":"istti iita bolla iita","poem":2},{"lineBreak":true},{"text":"gujji gujji bida;","poem":2},{"lineBreak":true},{"text":"tanakka erettenna» gees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Qasseka GODAY,","poem":1},{"text":"«Ishay isha baleththees;","poem":2},{"lineBreak":true},{"text":"laggey ba lagge zigirees;","poem":2},{"lineBreak":true},{"text":"hessa gishshas ishay","poem":2},{"lineBreak":true},{"text":"ishaappe naagetto;","poem":2},{"lineBreak":true},{"text":"laggey ba laggaan ammanettofo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Laggey ba lagge cimmees;","poem":1},{"text":"tuma haasayzay deenna;","poem":2},{"lineBreak":true},{"text":"istti bantta inxars","poem":2},{"lineBreak":true},{"text":"wordo haasaya tamaarsida.","poem":2},{"lineBreak":true},{"text":"Nagara ooson","poem":2},{"lineBreak":true},{"text":"banttana daaburseettes.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Neni baleththoy kumidason daasa;","poem":1},{"text":"istti bantta cimo gaason tana","poem":2},{"lineBreak":true},{"text":"erana koyibeettenna» gees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hessa gishshas Ubbaafe","poem":1},{"text":"Wolqqama GODAY,","poem":2},{"lineBreak":true},{"text":"«Tani istta birata mala","poem":2},{"lineBreak":true},{"text":"paaccada seerisa geeshshana.","poem":2},{"lineBreak":true},{"text":"Ta deraa nagara gishshas","poem":2},{"lineBreak":true},{"text":"ta hayssafe hara","poem":2},{"lineBreak":true},{"text":"ay ooththana dandayazinaa?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Istta inxarsay","poem":1},{"text":"wodhiza yiishsha mala;","poem":2},{"lineBreak":true},{"text":"istti cimo haasaya haasayeettes.","poem":2},{"lineBreak":true},{"text":"Ubbayka bantta laggetara","poem":2},{"lineBreak":true},{"text":"siiqo qaalan haasayeettes;","poem":2},{"lineBreak":true},{"text":"gido attiin bantta wozinara","poem":2},{"lineBreak":true},{"text":"woximade giigsseettes.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Histtiin hayta ha yo7ota gishshas","poem":1},{"text":"ta istta qaxxayana bessennee?","poem":2},{"lineBreak":true},{"text":"Tani ta hu7es hayssa mala","poem":2},{"lineBreak":true},{"text":"kawoteththa bolla","poem":2},{"lineBreak":true},{"text":"halo kessikinaa?» gees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tani dhoqqa deretas","poem":1},{"text":"yeekkananne waassana;","poem":2},{"lineBreak":true},{"text":"bazzon heenththasohotas","poem":2},{"lineBreak":true},{"text":"kayottana.","poem":2},{"lineBreak":true},{"text":"Gaasoykka istti dhayda;","poem":2},{"lineBreak":true},{"text":"heera issi asinne kanththenna.","poem":2},{"lineBreak":true},{"text":"Mehe waasoy siyettenna;","poem":2},{"lineBreak":true},{"text":"salo kafotinne do7ati","poem":2},{"lineBreak":true},{"text":"baqatidi bichchida.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"GODAY, «Yerusalaame katama","poem":1},{"text":"tani budhetti kayzidasonne","poem":2},{"lineBreak":true},{"text":"worakanati kaa7izaso ooththana.","poem":2},{"lineBreak":true},{"text":"Yuhuda katamatakka","poem":2},{"lineBreak":true},{"text":"asi bayndaso","poem":2},{"lineBreak":true},{"text":"bula kessana» gees.","poem":2}]},{"type":"verse","number":12,"content":["Hessa akeekanaas dandayza aadho eranchchay oonee? GODAY izas qonccisiin hayssa izas yootana dandayzay oonee? Biittaya asi baynda kays ays gidadee?"]},{"type":"verse","number":13,"content":["GODAY, «Hayssi haniday isttas tani immida woga istti aggidi azazettontta gishshassinne ta maara kaallontta aggida gishshassa."]},{"type":"verse","number":14,"content":["Histtidi istti bantta wozina muumeteththan biidi bantta aawati tamaarsida malakka Ba7aale geetettiza eeqa xoossa kaallida» gides."]},{"type":"verse","number":15,"content":["Hessa gishshas Ubbaafe Wolqqama GODAA Isra7eele Xoossay, «Be7ite, tani ha asaa cammiza quma mizananne marzera diza haath ushshana."]},{"type":"verse","number":16,"content":["Istta woykko istta aawati erontta kawoteththata giddon tani istta laallana. Tani istta dhayssana gakkanaas mashshan yedeththana» gees."]},{"type":"heading","content":["Yerusalaame Asaa Zilas"]},{"type":"verse","number":17,"content":[{"text":"Qasseka Ubbaafe Wolqqama GODAY,","poem":1},{"text":"«Ane yeeho yeekkiza maccassata xeygite;","poem":2},{"lineBreak":true},{"text":"zilas lo7eththi eriza maccassata ehite.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Istti eeson yetto;","poem":1},{"text":"nu ayfera afunththi","poem":2},{"lineBreak":true},{"text":"gogganaashe gakkanaassinne","poem":2},{"lineBreak":true},{"text":"nu siphinththara afunththi pulttana","poem":2},{"lineBreak":true},{"text":"gakkanaas nu gishshas zilaletto.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Xiyoonen zilassaa cenggurssi siyettees;","poem":1},{"text":"‹Nuni dhaydos!","poem":2},{"lineBreak":true},{"text":"Nuni keehi kawuyidos!","poem":2},{"lineBreak":true},{"text":"Nu keeththi laalettichchida gishshas","poem":2},{"lineBreak":true},{"text":"nu biittaa aggidi dendi boos›","poem":2},{"lineBreak":true},{"text":"gi zilaleettes» gees.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Intteno maccassatoo!","poem":1},{"text":"GODAA qaala siyite!","poem":2},{"lineBreak":true},{"text":"Intte hayththay iza doonappe keziza","poem":2},{"lineBreak":true},{"text":"qaala ezgo.","poem":2},{"lineBreak":true},{"text":"Intte macca nayta","poem":2},{"lineBreak":true},{"text":"zilas tamaarsite;","poem":2},{"lineBreak":true},{"text":"issiniya hankkooro yeeho tamaarsu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hayqoy nayta ogeppe,","poem":1},{"text":"naateththa nayta dubbushappe","poem":2},{"lineBreak":true},{"text":"pitti dhayssides;","poem":2},{"lineBreak":true},{"text":"nu maskootetara gelides;","poem":2},{"lineBreak":true},{"text":"nu qol7a giddo kanththides.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hessa gishshas GODAY tana,","poem":1},{"text":"« ‹Asa ahay buura mala","poem":2},{"lineBreak":true},{"text":"demban laalettana;","poem":2},{"lineBreak":true},{"text":"kath shiishshizayti guyen aggida","poem":2},{"lineBreak":true},{"text":"pushulo mala attana;","poem":2},{"lineBreak":true},{"text":"istta oonikka shiishshenna› ga»","poem":2},{"lineBreak":true},{"text":"giidi azazides.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"GODAY, «Aadho eranchchay","poem":1},{"text":"ba aadho erateththan ceeqettofo;","poem":2},{"lineBreak":true},{"text":"wolqqamay ba wolqqan ceeqettofo;","poem":2},{"lineBreak":true},{"text":"woykko durey ba dureteththan ceeqettofo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Gido attiin ceeqettiza oonikka","poem":1},{"text":"tani GODAA gididayssa eroninne","poem":2},{"lineBreak":true},{"text":"biitta bolla siiqo, suure pirdanne","poem":2},{"lineBreak":true},{"text":"xilloteth ooththizay tana gidoyssa","poem":2},{"lineBreak":true},{"text":"akeekon ceeqetto.","poem":2},{"lineBreak":true},{"text":"Tani haytan ufayettays» gees.","poem":2}]},{"type":"verse","number":25,"content":["Qasseka GODAY, «Be7ite, bantta asho xalla qaxxarettida asaa tani qaxxayana wodey yees."]},{"type":"verse","number":26,"content":["Heytikka Gibxe, Yuhuda, Eedoome, Amoone, Mo7aabenne bantta hu7e ciiri meedidi bazzon diza asaa ubbata. Ha kawoteththatan diza asay ubbay tumukka qaxxarettibeenna; Isra7eele asaa ubbaa wozinaykka qaxxarettibeenna» gees."]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/JER/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/JER/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/JER/8.json","previousChapterAudioLinks":{},"numberOfVerses":26}