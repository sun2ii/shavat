{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"JOB","translationId":"gmv_ltw","name":"Iyoobe Maxaafa","commonName":"Iyoobe Maxaafa","title":"Iyoobe Maxaafa","order":18,"numberOfChapters":42,"sha256":"7c0355f48567b45837a788e2f5ff9585d4e9f6240b795f708b47edcfd5ed7fd0","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gmv_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"«Duussi tana saleththides;","poem":1},{"text":"ta de7iza camo de7oza","poem":2},{"lineBreak":true},{"text":"qonccen sissana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tani Xoossa hizgana;","poem":1},{"text":"ta bolla nees lancey diikko","poem":2},{"lineBreak":true},{"text":"taas qonccisa attiin","poem":2},{"lineBreak":true},{"text":"ta bolla pirdofa!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hayssa likke ne tana metoththoyssi","poem":1},{"text":"nees wogaa?","poem":2},{"lineBreak":true},{"text":"Neni nerkka medhdhida asaa","poem":2},{"lineBreak":true},{"text":"ne kadhanaas nees bessizee?","poem":2},{"lineBreak":true},{"text":"Iita asata duulatay","poem":2},{"lineBreak":true},{"text":"nena ufayssizee?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne ayfey asa ayfe malaa?","poem":1},{"text":"Woykko ne asaththo xeellay?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne wodeti asayssa malaa?","poem":1},{"text":"Woykko ne layththati","poem":2},{"lineBreak":true},{"text":"asa layththa mala qaanththee?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ays ne ta qohoza xeellay?","poem":1},{"text":"Ays ne ta nagarakka","poem":2},{"lineBreak":true},{"text":"kaalla kaallada aggontta ixxay?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tani qohonttayssanne","poem":1},{"text":"ne kusheppe oonikka","poem":2},{"lineBreak":true},{"text":"tana ashshonttayssa ne eraasa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Taas medhanne mala","poem":1},{"text":"immi medhdhiday","poem":2},{"lineBreak":true},{"text":"ne kusheta;","poem":2},{"lineBreak":true},{"text":"histtiin ha7i ha kusheti","poem":2},{"lineBreak":true},{"text":"tana zaari laalli dhayssanee?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mana miishsha mala ne tana","poem":1},{"text":"biittafe medhdhoyssa qoppa;","poem":2},{"lineBreak":true},{"text":"histtiin ha7i ne tana","poem":2},{"lineBreak":true},{"text":"gudulla mala liiqisanee?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tana maaththa mala tigada,","poem":1},{"text":"meqo maaththa mala","poem":2},{"lineBreak":true},{"text":"irkkisa ooththadasa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ta asateththa galbaninne","poem":1},{"text":"ashon kammadasa;","poem":2},{"lineBreak":true},{"text":"meqeththaninne shayan","poem":2},{"lineBreak":true},{"text":"gaththa oyththadasa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"De7onne mernaa siiqo","poem":1},{"text":"taas immadasa;","poem":2},{"lineBreak":true},{"text":"ne naagoykka","poem":2},{"lineBreak":true},{"text":"ta ayana minththides.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Hekko hayta ha miishshata","poem":1},{"text":"ne wozinan","poem":2},{"lineBreak":true},{"text":"qotta woththada daasa;","poem":2},{"lineBreak":true},{"text":"ne qofaykka hayssa gididayssa","poem":2},{"lineBreak":true},{"text":"ta eradis.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ta qohidaa gidikko","poem":1},{"text":"ne ayfeti beyana;","poem":2},{"lineBreak":true},{"text":"ta nagara gishshas","poem":2},{"lineBreak":true},{"text":"tana qaxxayontta aadhdhaka.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ta nagara ooththidaakko","poem":1},{"text":"eesora meto giddon kundana;","poem":2},{"lineBreak":true},{"text":"lo7o miish ooththidaa gidikkoka","poem":2},{"lineBreak":true},{"text":"galatetikke;","poem":2},{"lineBreak":true},{"text":"ta gilqiin yeellay tana gakkides.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ta otorettidaakko","poem":1},{"text":"ne tana gaammo mala","poem":2},{"lineBreak":true},{"text":"shankkatada oykkana;","poem":2},{"lineBreak":true},{"text":"ne tana qohanaas","poem":2},{"lineBreak":true},{"text":"zaara zaara shankkatana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ta bolla markkattiza asata","poem":1},{"text":"ne ubbaa gallas demmana;","poem":2},{"lineBreak":true},{"text":"ta bolla ne hanqoy","poem":2},{"lineBreak":true},{"text":"gede dari dari baana;","poem":2},{"lineBreak":true},{"text":"neni tana qohanaas","poem":2},{"lineBreak":true},{"text":"ubba gallas ooraththa qofata","poem":2},{"lineBreak":true},{"text":"ola asata mala","poem":2},{"lineBreak":true},{"text":"ta bolla denththaasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«Ta Godaa Xoossawu!","poem":1},{"text":"Ays ta yelettana mala ooththadii?","poem":2},{"lineBreak":true},{"text":"Oonikka tana be7ontta","poem":2},{"lineBreak":true},{"text":"ta hayqqaychchidaakko","poem":2},{"lineBreak":true},{"text":"lo7okkoshin!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ta medhettontta attarkina;","poem":1},{"text":"tani ta aayey uloppe","poem":2},{"lineBreak":true},{"text":"duufon bidaakko","poem":2},{"lineBreak":true},{"text":"taas lo7o gidanakkoshin!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ta daana layththaya","poem":1},{"text":"qaanth gidekkee?","poem":2},{"lineBreak":true},{"text":"he qaanththa layththayn","poem":2},{"lineBreak":true},{"text":"guuththara ta ufayettana mala","poem":2},{"lineBreak":true},{"text":"tana aggarkkii!","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hessika tani nam7anththo","poem":1},{"text":"haa simmanaas dandayontta","poem":2},{"lineBreak":true},{"text":"girdi gida dhumaso","poem":2},{"lineBreak":true},{"text":"baanaappe sinththana.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ta baanaasozi dhuma kuwaynne","poem":1},{"text":"shiroy kumida biitta;","poem":2},{"lineBreak":true},{"text":"heen diza poo7ozi dhuma mala.»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/JOB/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/JOB/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/JOB/9.json","previousChapterAudioLinks":{},"numberOfVerses":22}