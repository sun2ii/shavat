.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hessa malakka ta doonan","poem":1},{"text":"inttena minththeththananne","poem":2},{"lineBreak":true},{"text":"minththanaas daro","poem":2},{"lineBreak":true},{"text":"haasayanakkoshin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Gido attiin daro haasaykkoka","poem":1},{"text":"ta hargey haa lo7enna;","poem":2},{"lineBreak":true},{"text":"co7u ga dandaykkoka","poem":2},{"lineBreak":true},{"text":"ta waayey taappe kichchenna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Xoossawu! Tana asateththafe","poem":1},{"text":"kare kessadasa,","poem":2},{"lineBreak":true},{"text":"ta dere asaa ubbaa dhayssadasa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ta asateththay gundoyssi","poem":1},{"text":"ta bolla dendidi","poem":2},{"lineBreak":true},{"text":"neni nagaranchcha giidi","poem":2},{"lineBreak":true},{"text":"ta bolla markkattees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Xoossi tana hanqidi","poem":1},{"text":"ta asateththa qanxxereththides;","poem":2},{"lineBreak":true},{"text":"tana ixxidi ba ach","poem":2},{"lineBreak":true},{"text":"ta bolla garccides;","poem":2},{"lineBreak":true},{"text":"ta morkkey ba ayfe","poem":2},{"lineBreak":true},{"text":"ta bolla maxi kessides.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Asay ta yuushon shiiqettidi","poem":1},{"text":"ta bolla ceeqettides;","poem":2},{"lineBreak":true},{"text":"tana qidhe qaalan baqqida.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Xoossi tana iita asatas","poem":1},{"text":"aaththi immides;","poem":2},{"lineBreak":true},{"text":"makkallanchchata","poem":2},{"lineBreak":true},{"text":"kushen yeggides.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ta saron daysikoshin","poem":1},{"text":"gidikkoka Xoossi ba hanqozan","poem":2},{"lineBreak":true},{"text":"tana menththereththides;","poem":2},{"lineBreak":true},{"te