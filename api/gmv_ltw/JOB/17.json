2}]},{"type":"verse","number":5,"content":[{"text":"Miishshe demmanawu giidi","poem":1},{"text":"ba laggeza aaththi immiza","poem":2},{"lineBreak":true},{"text":"asa nayta","poem":2},{"lineBreak":true},{"text":"bolla gomey gakkana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Xoossi tana asas","poem":1},{"text":"kaassa miish ooththides;","poem":2},{"lineBreak":true},{"text":"asay izaade bolla cuttiza","poem":2},{"lineBreak":true},{"text":"asa mala gidadis.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Afunththafe dendidayssan","poem":1},{"text":"ta ayfeti doljumida;","poem":2},{"lineBreak":true},{"text":"kumeththa ta asateththayka","poem":2},{"lineBreak":true},{"text":"eesho mala gidides.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Xillo asati hayssan dagamettida;","poem":1},{"text":"geeshshati Xoossa ammanontta","poem":2},{"lineBreak":true},{"text":"asata bolla hanqettida.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gido attiin xilloti tuma ogeppe","poem":1},{"text":"kare ke7ettenna;","poem":2},{"lineBreak":true},{"text":"geeshshati minoteththa bolla","poem":2},{"lineBreak":true},{"text":"minoteththi gujettees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Intte ubbayka nam7anththo yiidi","poem":1},{"text":"ta sinththan marshettiko;","poem":2},{"lineBreak":true},{"text":"intte giddofe issi akeekara diza","poem":2},{"lineBreak":true},{"text":"as demmike.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ta layththay wurides;","poem":1},{"text":"ta qofaynne taas wozina amoy","poem":2},{"lineBreak":true},{"text":"hada gidi attides.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hayti ha asati","poem":1},{"text":"omarsa gallas geettes;","poem":2},{"lineBreak":true},{"text":"poo7oza qasse dhumana","poem":2},{"lineBreak":true},{"text":"hanees geettes.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hayssafe guye taas diza qaaday","poem":1},{"text":"duge hayqqida asati dizaso","poem":2},{"lineBreak":true},{"text":"duufon wodheththa;","poem":2},{"lineBreak":true},{"text":"yaan dhumason tani","poem":2},{"lineBreak":true},{"text":"ta hiixa ongana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Duufo, ‹Ta aawawu!›","poem":1},{"text":"gaada ta xeygana;","poem":2},{"lineBreak":true},{"text":"tana miza guxuneta tani,","poem":2},{"lineBreak":true},{"text":"‹Ta aayee, ta michcheyee!›","poem":2},{"lineBreak":true},{"text":"gaada xeygana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Histtiin taas ay hidotay dizee?","poem":1},{"text":"taas hidota gidiza miish","poem":2},{"lineBreak":true},{"text":"oonee taas xeellanay?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tani duge si7oole wodhishin","poem":1},{"text":"hidotay tanara issife wodhanee?","poem":2},{"lineBreak":true},{"text":"Issifekka duge duufon","poem":2},{"lineBreak":true},{"text":"nu gelanee?»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}