em":2}]},{"type":"verse","number":16,"content":[{"text":"Xaphoppe meliza miththa malanne","poem":1},{"text":"haggatikka meqerettiza","poem":2},{"lineBreak":true},{"text":"miththa mala gidana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Biitta bolla iza qoppiza asi deenna;","poem":1},{"text":"iza goobateththika","poem":2},{"lineBreak":true},{"text":"biittafe dhayana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Izi Poo7osoppe","poem":1},{"text":"gede dhuman goodettana;","poem":2},{"lineBreak":true},{"text":"biitta bollafe izi kichchana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Iza dabbota giddofe","poem":1},{"text":"iza laattana yeletay beettenna;","poem":2},{"lineBreak":true},{"text":"iza baachchanka","poem":2},{"lineBreak":true},{"text":"zarey izas attenna.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ushachcha baggaranne","poem":1},{"text":"hadirsa baggara diza asay;","poem":2},{"lineBreak":true},{"text":"iza bolla gakkida metoza gishshas","poem":2},{"lineBreak":true},{"text":"keehi babbidi kokkorana.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ay wodekka iita asata wurseththay","poem":1},{"text":"hessa mala;","poem":2},{"lineBreak":true},{"text":"Xoossas yayyontta","poem":2},{"lineBreak":true},{"text":"asa qaaday hayssa.»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}