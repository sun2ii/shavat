.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Xoossa hanqoy mashshan","poem":1},{"text":"qaxxayeteththan","poem":2},{"lineBreak":true},{"text":"gaththiza gishshas mashshay","poem":2},{"lineBreak":true},{"text":"inttena montta mala naagettite.","poem":2},{"lineBreak":true},{"text":"Xoossa pirday dizayssaka erite.»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}