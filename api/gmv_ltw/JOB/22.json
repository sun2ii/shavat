","poem":1},{"text":"ne iitateththi darida","poem":2},{"lineBreak":true},{"text":"gishshassinne","poem":2},{"lineBreak":true},{"text":"ne nagaray zaway bayndayssa","poem":2},{"lineBreak":true},{"text":"gidida gishshas gidennee?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Issi gaasoykka baynda","poem":1},{"text":"ne ishatappe oyso ekkadasa;","poem":2},{"lineBreak":true},{"text":"qasse istta may7o qaara ekkada","poem":2},{"lineBreak":true},{"text":"istta kallo ashshadasa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gafidinne saamettidi daaburdayta","poem":1},{"text":"kaththinne haath diggadasa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne gadaadenne wolqqama","poem":1},{"text":"as gidada","poem":2},{"lineBreak":true},{"text":"izan diza bonchcho","poem":2},{"lineBreak":true},{"text":"as gidikkoka,","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Neni am7e maccassata","poem":2},{"lineBreak":true},{"text":"mela kushe yeddadasa;","poem":2},{"lineBreak":true},{"text":"yi7o naytikka","poem":2},{"lineBreak":true},{"text":"bana ayssana de7oza dhayssadasa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hayssa gaason","poem":1},{"text":"nena oykkana woximadey","poem":2},{"lineBreak":true},{"text":"nena yuuyi aadhdhides;","poem":2},{"lineBreak":true},{"text":"ne ezgontta","poem":2},{"lineBreak":true},{"text":"metoy nena daganththana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nena Xeeloy metana gakkanaas","poem":1},{"text":"nees dhumides;","poem":2},{"lineBreak":true},{"text":"di7o haaththika nena meeccides.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Xoossay dhoqqa salon","poem":1},{"text":"dizayssa gidennee?","poem":2},{"lineBreak":true},{"text":"Xoolintteti aykkoka","poem":2},{"lineBreak":true},{"text":"dhoqqasohon diikkoka","poem":2},{"lineBreak":true},{"text":"izi isttafe bollara diidi","poem":2},{"lineBreak":true},{"text":"istta xeellees.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Neni gidikko, ‹Xoossi ay erizee?","poem":1},{"text":"Girdi gida dhuman","poem":2},{"lineBreak":true},{"text":"izi waani nu bolla","poem":2},{"lineBreak":true},{"text":"pirdanawu dandayzee?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Salo bollan izi simerettishin","poem":1},{"text":"dhippi gida shaaray","poem":2},{"lineBreak":true},{"text":"iza kammiza gishshas","poem":2},{"lineBreak":true},{"text":"izi beyanawu dandayenna› gaasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«Nagaranchchati simerettiza","poem":1},{"text":"beni ogeza ne kaallay?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Isttika wodey gakkontta","poem":1},{"text":"sinththara boshan shocettida;","poem":2},{"lineBreak":true},{"text":"di7onkka meecettidi","poem":2},{"lineBreak":true},{"text":"xaphora dhayda.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Isttika Ubbaa Dandayza Xoossa,","poem":1},{"text":"‹Nuuppe ne haakka;","poem":2},{"lineBreak":true},{"text":"ne nuus ay ooththanaas","poem":2},{"lineBreak":true},{"text":"dandayay?› gida.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Gidikkoka istta keeththa","poem":1},{"text":"dureteththan","poem":2},{"lineBreak":true},{"text":"kunththiday Xoossa.","poem":2},{"lineBreak":true},{"text":"Hessa gishshas tani","poem":2},{"lineBreak":true},{"text":"iita asata qofa ekkike.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«Kiya asati iita asati","poem":1},{"text":"qaxxayettishin","poem":2},{"lineBreak":true},{"text":"be7idi ufayetteettes;","poem":2},{"lineBreak":true},{"text":"suure asati istta bolla qilcceettes,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"‹Tunkka nu morkketi dhayda;","poem":1},{"text":"istta haarozi kumeth","poem":2},{"lineBreak":true},{"text":"taman xuugettides.›","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«Hessa gishshas Iyoobe","poem":1},{"text":"nenateththaa Xoossas haarisa;","poem":2},{"lineBreak":true},{"text":"izarakka ne saron da;","poem":2},{"lineBreak":true},{"text":"ne hayssa ooththiko","poem":2},{"lineBreak":true},{"text":"lo7o miish demmana.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Xoossi nees immiza timirtaa ekka;","poem":1},{"text":"iza qaalakka ne wozinan woththa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nenateththaa ne Ubbaa","poem":1},{"text":"Dandayza Xoossaako","poem":2},{"lineBreak":true},{"text":"ne zaaridaakko,","poem":2},{"lineBreak":true},{"text":"ne kase mala hanana;","poem":2},{"lineBreak":true},{"text":"ne sooppe iita ooso digga.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Worqqa gudullan ola;","poem":1},{"text":"ofire worqqa","poem":2},{"lineBreak":true},{"text":"shaafa shuchcha mala","poem":2},{"lineBreak":true},{"text":"wora ola.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"He wode Ubbaa Dandayza","poem":1},{"text":"Xoossay nees","poem":2},{"lineBreak":true},{"text":"worqqanne muuruta bira gidana.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"He wode Ubbaa Dandayza Xoossaan","poem":1},{"text":"neni ufayettana;","poem":2},{"lineBreak":true},{"text":"izan ammanettada ne daana.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ne izakko woossiza wode","poem":1},{"text":"izi ne woosaa siyana;","poem":2},{"lineBreak":true},{"text":"ne adinettidayssa izas gaththana.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ne qofay ubbay nees polettana;","poem":1},{"text":"nees oge ubbay poo7o gidana.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Xoossi otoranchchata kawushshana;","poem":1},{"text":"ashketa gidikko izi ashshana.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Nenikka suure wozinay","poem":1},{"text":"dizaade gidikko","poem":2},{"lineBreak":true},{"text":"Xoossi iita ubbaafe nena naagana;","poem":2},{"lineBreak":true},{"text":"ne kushetikka qoho oosoppe","poem":2},{"lineBreak":true},{"text":"geesh gidikko","poem":2},{"lineBreak":true},{"text":"Xoossi nena ashshi ekkana.»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}