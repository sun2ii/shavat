umber":5,"content":[{"text":"«Wolqqama wogga gita abbaafe","poem":1},{"text":"garsan diza hayqqidayta shemppoti","poem":2},{"lineBreak":true},{"text":"wolqqama kokkorsan deettes.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Si7ooleykka Xoossa sinththan","poem":1},{"text":"qonccen dees;","poem":2},{"lineBreak":true},{"text":"Abadoone geetettizasoza","poem":2},{"lineBreak":true},{"text":"ay miishshika","poem":2},{"lineBreak":true},{"text":"kammanawu dandayenna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Xoossi pudeha baggara diza saloza","poem":1},{"text":"carko bolla miccides;","poem":2},{"lineBreak":true},{"text":"biittaaka aykkoy bayndason","poem":2},{"lineBreak":true},{"text":"kuulloti daana mala ooththides.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Xoossi shaarati","poem":1},{"text":"haath xunxi oykkana mala ooththees;","poem":2},{"lineBreak":true},{"text":"haaththafe dendoyssan","poem":2},{"lineBreak":true},{"text":"shaarati daaketettenna.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Izi uttiza","poem":1},{"text":"kawoteththa araata genththana;","poem":2},{"lineBreak":true},{"text":"shaararakka kammana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Poo7onne dhuma shaakkanaas;","poem":1},{"text":"wolqqama wogga gita abbaa sinththan","poem":2},{"lineBreak":true},{"text":"saloza zawa ooththidi miccides.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Izi hanqiza wode","poem":1},{"text":"salo tuussati dagaman kokkoreettes.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Izi ba wolqqan abbaa co7u ooththees;","poem":1},{"text":"iza aadho erateththayka","poem":2},{"lineBreak":true},{"text":"Era7aabe geetettizayssa dhayssana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ba peenozan saloza geeshshana;","poem":1},{"text":"xongettiza shooshshaa","poem":2},{"lineBreak":true},{"text":"ba kushen caddana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Haytanti ubbay","poem":1},{"text":"Xoossi ooththiza oosotappe","poem":2},{"lineBreak":true},{"text":"guuththata;","poem":2},{"lineBreak":true},{"text":"nu siyizayssi izas saasuketh xalla;","poem":2},{"lineBreak":true},{"text":"wolqqama giirissa izayssa","poem":2},{"lineBreak":true},{"text":"ooni akeekanawu dandayzee?»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}