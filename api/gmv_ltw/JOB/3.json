,"number":23,"content":[{"text":"Izi biza ogey","poem":1},{"text":"izaadefe geemettidaadessinne","poem":2},{"lineBreak":true},{"text":"Xoossi gordi woththida asas","poem":2},{"lineBreak":true},{"text":"poo7oy ays imettizee?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yeehoy taas kath gidides;","poem":1},{"text":"waasoykka taas","poem":2},{"lineBreak":true},{"text":"goggiza haaththa mala gidides.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ta yayyida miish ta bolla yides;","poem":1},{"text":"ta dagammidayssika","poem":2},{"lineBreak":true},{"text":"ta bolla gakkides.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ta giddon hirgay xalla diza gishshas","poem":1},{"text":"saroy, woppaynne","poem":2},{"lineBreak":true},{"text":"shemppoy deenna» gi qanggides.","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Lewataane geetettizayssi beni woden haylasho misatiza gita do7akko.","reference":{"chapter":3,"verse":8}}]},"thisChapterLink":"/api/gmv_ltw/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":25}