{"text":"Neni iza darsa darsa qohikko","poem":2},{"lineBreak":true},{"text":"iza ay ooththanawu dandayay?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Neni xillo gidikko izas ay immanee?","poem":1},{"text":"Izi neeppe aykkoka koyenna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne nagara ooththiko qohanay","poem":1},{"text":"ne mala asata xalla.","poem":2},{"lineBreak":true},{"text":"Ne lo7o miish ooththikoka","poem":2},{"lineBreak":true},{"text":"ne go7izay as xalla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Asi haray darssi","poem":1},{"text":"qohishin waassees;","poem":2},{"lineBreak":true},{"text":"baappe wolqqatizaade kusheppe","poem":2},{"lineBreak":true},{"text":"bana ashshi ekkanaades","poem":2},{"lineBreak":true},{"text":"magannees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gido attiin isttafe oonikka,","poem":1},{"text":"‹Tana medhdhida","poem":2},{"lineBreak":true},{"text":"Xoossay awanee?","poem":2},{"lineBreak":true},{"text":"Leela giddoth","poem":2},{"lineBreak":true},{"text":"mazamure immizayssi awanee?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mehetappe nuna aaththi","poem":1},{"text":"tamaarsida;","poem":2},{"lineBreak":true},{"text":"salo kafotappeka","poem":2},{"lineBreak":true},{"text":"aadho eranchchata","poem":2},{"lineBreak":true},{"text":"ooththiday iza› giday baawa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Istti waasseettes;","poem":1},{"text":"izi gidikko istti otoranchchatanne","poem":2},{"lineBreak":true},{"text":"iitata gidida gishshas","poem":2},{"lineBreak":true},{"text":"isttas zaaro immenna.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Xoossi tuma wozinappe gidontta","poem":1},{"text":"waaso siyenna;","poem":2},{"lineBreak":true},{"text":"Ubbaa Dandayza Xoossay","poem":2},{"lineBreak":true},{"text":"hessa mala ezgenna.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iyoobee! Neni ta Xoossa aykkoka","poem":1},{"text":"be7ikke giikkoka,","poem":2},{"lineBreak":true},{"text":"ne metoy iza sinththan","poem":2},{"lineBreak":true},{"text":"de7iza gishshas,","poem":2},{"lineBreak":true},{"text":"neni dandayan","poem":2},{"lineBreak":true},{"text":"naagana koshshees.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Qasseka Xoossi nena","poem":1},{"text":"ba hanqon hanqontta","poem":2},{"lineBreak":true},{"text":"asa iitateththa co7u giidi","poem":2},{"lineBreak":true},{"text":"aadhdhana nees misatizee?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Iyoobee! Neni coo mela","poem":1},{"text":"haasaya darsaasa;","poem":2},{"lineBreak":true},{"text":"erateththi baynda","poem":2},{"lineBreak":true},{"text":"coo gaada haasayaasa.»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}