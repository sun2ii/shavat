":2},{"lineBreak":true},{"text":"Yordaanoose shaafay","poem":2},{"lineBreak":true},{"text":"keehi kumidi goggiinkka","poem":2},{"lineBreak":true},{"text":"izi yayyenna.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Iza ayfeta toyssidi","poem":1},{"text":"iza oykkana asi dizee?","poem":2},{"lineBreak":true},{"text":"iza siidhekka dafon qachchidi","poem":2},{"lineBreak":true},{"text":"iza oykkanaas dandayzay oonee?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":24}