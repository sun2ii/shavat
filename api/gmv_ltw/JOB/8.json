uurenne geesh gidikko","poem":2},{"lineBreak":true},{"text":"izi eesoti nees bessiza sohon","poem":2},{"lineBreak":true},{"text":"nena zaarana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne doomeththay","poem":1},{"text":"guuth misatikkoka,","poem":2},{"lineBreak":true},{"text":"nees poloy keehi lo7o gidana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Ane kase yeleta oychcha;","poem":1},{"text":"kase aawati gakkidasoza","poem":2},{"lineBreak":true},{"text":"pilgga xeella.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nu layththazi","poem":1},{"text":"buro guuth gidida gishshas","poem":2},{"lineBreak":true},{"text":"nuni aykkoka erokko;","poem":2},{"lineBreak":true},{"text":"nu layththayka","poem":2},{"lineBreak":true},{"text":"eesho mala aadhdhizaaza.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Istti nees tamaarsizayssinne","poem":1},{"text":"nees yootizayssi","poem":2},{"lineBreak":true},{"text":"ba akeekizayssafe","poem":2},{"lineBreak":true},{"text":"ekkidi gidennee?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tumukka carey bayndason","poem":1},{"text":"shacca maatay mokki erizee?","poem":2},{"lineBreak":true},{"text":"Haaththi bayndason","poem":2},{"lineBreak":true},{"text":"marcoy cililizee?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hayssi hanontta aggiko diccidi","poem":1},{"text":"buuch gakkanaappe sinththan","poem":2},{"lineBreak":true},{"text":"buro cililan dishe melees.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Xoossa dogiza asata","poem":1},{"text":"ubbaa wurseththay","poem":2},{"lineBreak":true},{"text":"hessa mala hanana;","poem":2},{"lineBreak":true},{"text":"Xoossi baawa giza asata","poem":2},{"lineBreak":true},{"text":"hidotay qanxxettana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Achcharo keeththa mala","poem":1},{"text":"miishshan ammanetteettes;","poem":2},{"lineBreak":true},{"text":"istti hidota ooththiza","poem":2},{"lineBreak":true},{"text":"miishshi diikkoka","poem":2},{"lineBreak":true},{"text":"kawushshara dhayana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Achcharo keeththa bolla","poem":1},{"text":"istti zemppizaa gidikko","poem":2},{"lineBreak":true},{"text":"izi minni eqqenna;","poem":2},{"lineBreak":true},{"text":"achcharo keeththaza izi oykkiko","poem":2},{"lineBreak":true},{"text":"duuxeretti wodhdhana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Haaththa kallida harumay","poem":1},{"text":"ho7o demmidi daayees;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Xaphoza shuchcha","poem":1},{"text":"muuhe giddon yeddees;","poem":2},{"lineBreak":true},{"text":"zaalla za7an xaphees.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ba dizasoppe shodettiza wode","poem":1},{"text":"izi dizasozi erettenna.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Iza wurseththi hessa mala gidees;","poem":1},{"text":"hara maatati biittafe doleettes.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«Xoossi wosoy baynda","poem":1},{"text":"asata olenna;","poem":2},{"lineBreak":true},{"text":"iita asata qese minththenna.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hessa gishshas nenikka","poem":1},{"text":"ufayssan miiccana malanne","poem":2},{"lineBreak":true},{"text":"‹Ililana› mala izi ooththana.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nena ixxiza asati gidikko","poem":1},{"text":"yeella may7ana;","poem":2},{"lineBreak":true},{"text":"iita asata keeththika dhayana.»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}