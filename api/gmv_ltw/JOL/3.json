{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"JOL","translationId":"gmv_ltw","name":"Iyu7eele Tinbite","commonName":"Iyu7eele Tinbite","title":"Iyu7eele Tinbite","order":29,"numberOfChapters":3,"sha256":"b3703fb20fd91b515f8f47d7f08a713c5c79b1b534ed6648ee0356cebe919b6a","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gmv_ltw/JOL/3.json","totalNumberOfVerses":72},"chapter":{"number":3,"content":[{"type":"heading","content":["Kawoteththata Bolla Yida Pirda"]},{"type":"verse","number":1,"content":["Xoossi,",{"text":"«He wode tani Yerusalaameppenne","poem":1},{"text":"Yuhudappe di7etti ekettida","poem":2},{"lineBreak":true},{"text":"miish ubbaa zaarana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tani kawoteththata","poem":1},{"text":"ubbaa shiishshada","poem":2},{"lineBreak":true},{"text":"duge Iyoosaafixe","poem":2},{"noteId":1},{"lineBreak":true},{"text":"zulle woththana;","poem":2},{"lineBreak":true},{"text":"heenkka ta istta bolla pirdana;","poem":2},{"lineBreak":true},{"text":"gaasoykka ta dere Isra7eele asaa","poem":2},{"lineBreak":true},{"text":"kawoteththata giddon laallidi","poem":2},{"lineBreak":true},{"text":"istti biitta gishetti","poem":2},{"lineBreak":true},{"text":"ekkida gishshassa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Istti ba di7i ehida","poem":1},{"text":"ta dereta gishetti ekkanaas","poem":2},{"lineBreak":true},{"text":"istta bolla saama yeggida;","poem":2},{"lineBreak":true},{"text":"layma maccassata demmanaas","poem":2},{"lineBreak":true},{"text":"attuma nayta aaththi immida;","poem":2},{"lineBreak":true},{"text":"woyne ushshu uyanaas","poem":2},{"lineBreak":true},{"text":"macca nayta","poem":2},{"lineBreak":true},{"text":"aylleteththas bayzida.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Intteno Xiroose,","poem":1},{"text":"Sidoonanne Filisxeeme asatoo!","poem":2},{"lineBreak":true},{"text":"Intte ay ooththishe deetii?","poem":2},{"lineBreak":true},{"text":"Intte ta bolla","poem":2},{"lineBreak":true},{"text":"halo kessana qoppeetii?","poem":2},{"lineBreak":true},{"text":"Intte hessa mala qoppiko","poem":2},{"lineBreak":true},{"text":"tanikka kasetada intte bolla","poem":2},{"lineBreak":true},{"text":"halo kessana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ta bira, worqqanne","poem":1},{"text":"taas diza al7o miish","poem":2},{"lineBreak":true},{"text":"ubbaa intte bonqqi ekkidi","poem":2},{"lineBreak":true},{"text":"intte eeqa keeth gelththideta.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yuhudanne Yerusalaame yeletata","poem":1},{"text":"istta dere dhassafe haassi efidi","poem":2},{"lineBreak":true},{"text":"Girike asas bayzideta.","poem":2}]},{"type":"verse","number":7,"content":["«Hekko tani ha7i istti bayzetti dizasoppe istta denththeththada zaarana; intte istta bolla gaththida qohoza ta intte bolla zaara ehana."]},{"type":"verse","number":8,"content":["Intte macca naytinne attuma nayti Yuhuda asaas bayzettana mala ta ooththana; isttika haaho deren diza Saabaane asaas aaththi bayzana; hayssa wursa yootiday tana GODAA."]},{"type":"verse","number":9,"content":[{"text":"«Hayssa ubbaa","poem":1},{"text":"kawoteththatas awajjite!","poem":2},{"lineBreak":true},{"text":"olas giigettite!","poem":2},{"lineBreak":true},{"text":"ola qarata denththeththite!","poem":2},{"lineBreak":true},{"text":"Intte olanchchati ubbay","poem":2},{"lineBreak":true},{"text":"kezidi morkketa oletto!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Maarasha giththa mashsha qoxxite;","poem":1},{"text":"baaca qasse toora qoxxite;","poem":2},{"lineBreak":true},{"text":"laafaykka bana,","poem":2},{"lineBreak":true},{"text":"‹Tani mino asa› go.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Intteno yuuyi aadhdhanaas diza kawoteththatoo!","poem":1},{"text":"Intte wurikka eeson kezite!","poem":2},{"lineBreak":true},{"text":"Hirki shoobban issi bolla shiiqite.","poem":2},{"lineBreak":true},{"text":"GODAWU, neni","poem":2},{"lineBreak":true},{"text":"ne olanchchata kiita!","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Kawoteththati ubbay dendidi","poem":1},{"text":"duge Iyoosaafixe shoobba betto;","poem":2},{"lineBreak":true},{"text":"tani Xoossay intte yuushon diza","poem":2},{"lineBreak":true},{"text":"kawoteththata bolla pirdanaas","poem":2},{"lineBreak":true},{"text":"ta heen uttana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Istta iitateththi keehi darides;","poem":1},{"text":"hessa gishshas kaxxida kaththi","poem":2},{"lineBreak":true},{"text":"baacan cakettiza mala","poem":2},{"lineBreak":true},{"text":"istta cakkite;","poem":2},{"lineBreak":true},{"text":"woyne miththa ayfey","poem":2},{"lineBreak":true},{"text":"gum7ettizason kumidi","poem":2},{"lineBreak":true},{"text":"yedhettiza mala","poem":2},{"lineBreak":true},{"text":"intte istta yedhettite» gides.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Yo7o pirdiza zullen","poem":1},{"text":"GODAY pirdiza gallassi gakkides;","poem":2},{"lineBreak":true},{"text":"hessa gishshas daro derey","poem":2},{"lineBreak":true},{"text":"heen shiiqi uttides.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"He gallas arsheynne","poem":1},{"text":"aginay dhumana;","poem":2},{"lineBreak":true},{"text":"xoolintteyka poo7enna.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"GODAY Xiyoone zumaa bolla","poem":1},{"text":"Yerusalaamen dishe","poem":2},{"lineBreak":true},{"text":"babisiza ba qaala giiris sissana;","poem":2},{"lineBreak":true},{"text":"saloynne sa7ay qaaxxana;","poem":2},{"lineBreak":true},{"text":"GODAY gidikko","poem":2},{"lineBreak":true},{"text":"ba dere Isra7eeles","poem":2},{"lineBreak":true},{"text":"shiiqi attizaso gidana.","poem":2}]},{"type":"heading","content":["Xoossa Deraa Anjjeteth"]},{"type":"verse","number":17,"content":[{"text":"«Isra7eele asawu! He wode tani","poem":1},{"text":"GODAA intte Xoossa gididayssa","poem":2},{"lineBreak":true},{"text":"intte erana;","poem":2},{"lineBreak":true},{"text":"tani geesh gidida ta zuma","poem":2},{"lineBreak":true},{"text":"Xiyoone bolla de7ana;","poem":2},{"lineBreak":true},{"text":"Yerusalaamey anjjettida","poem":2},{"lineBreak":true},{"text":"katama gidana;","poem":2},{"lineBreak":true},{"text":"hessafe guye hara allaga wottadaray","poem":2},{"lineBreak":true},{"text":"izo worajjenna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«He wode zumati wurikka","poem":1},{"text":"woyne miththan kumana;","poem":2},{"lineBreak":true},{"text":"zumbullan daro maaththa miizati","poem":2},{"lineBreak":true},{"text":"heemettana;","poem":2},{"lineBreak":true},{"text":"GODAA Keeththafe","poem":2},{"lineBreak":true},{"text":"pulttoy pulttana;","poem":2},{"lineBreak":true},{"text":"Yuhuda deren diza shaafata","poem":2},{"lineBreak":true},{"text":"ubbaa haaththi kumana;","poem":2},{"lineBreak":true},{"text":"Shiixime shoobbay haath kallana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Gibxe asaynne Eedoome asay","poem":1},{"text":"Yuhuda asaa bolla","poem":2},{"lineBreak":true},{"text":"gene ooththida gishshas","poem":2},{"lineBreak":true},{"text":"qasseka xillo asaa wodhida gishshas","poem":2},{"lineBreak":true},{"text":"Gibxey bazzo gidana;","poem":2},{"lineBreak":true},{"text":"Eedoomey asi bayndaso gidana.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hessa gakkanawu tani","poem":1},{"text":"halo kessontta aggida","poem":2},{"lineBreak":true},{"text":"xillota suuththa gishshas","poem":2},{"lineBreak":true},{"text":"halo kessana;","poem":2},{"lineBreak":true},{"text":"Yuhudaynne Yerusalaamey","poem":2},{"lineBreak":true},{"text":"qasse mernaas ta derey","poem":2},{"lineBreak":true},{"text":"de7izaso gidana;","poem":2},{"lineBreak":true},{"text":"tanikka Xoossay","poem":2},{"lineBreak":true},{"text":"Xiyoone zuma bolla","poem":2},{"lineBreak":true},{"text":"de7ana» gides.","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Ibraaweta qaalara Iyoosaafixe guussi Xoossi pirdees guussa.","reference":{"chapter":3,"verse":2}}]},"thisChapterLink":"/api/gmv_ltw/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}