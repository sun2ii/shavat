{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"MIC","translationId":"gmv_ltw","name":"Mikiyaasa Tinbite","commonName":"Mikiyaasa Tinbite","title":"Mikiyaasa Tinbite","order":33,"numberOfChapters":7,"sha256":"9e625fd4fc77c2d904abc0adea9025ce154e7556fb4c80491aabb7a04a048cdd","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/gmv_ltw/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["Xoossa Zuma"]},{"type":"verse","number":1,"content":["Wurseththa wode",{"text":"Xoossa keeththi","poem":1},{"text":"iza bolla diza zumay","poem":2},{"lineBreak":true},{"text":"hara zuma ubbaafe","poem":2},{"lineBreak":true},{"text":"aadhdhi beettana;","poem":2},{"lineBreak":true},{"text":"hara zumatappe bollara","poem":2},{"lineBreak":true},{"text":"dhoqqu gaana;","poem":2},{"lineBreak":true},{"text":"dereykka izakko goochchana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Daro kawoteththati izakko yiidi,","poem":1},{"text":"«Xoossa zumaakko haa yiite;","poem":2},{"lineBreak":true},{"text":"Yaaqoobe Godaakko ane boos;","poem":2},{"lineBreak":true},{"text":"nu iza ogera baana mala","poem":2},{"lineBreak":true},{"text":"nuna izi ba oge","poem":2},{"lineBreak":true},{"text":"tamaarsana» gida;","poem":2},{"lineBreak":true},{"text":"wogay Xiyooneppe,","poem":2},{"lineBreak":true},{"text":"Xoossa qaalay","poem":2},{"lineBreak":true},{"text":"qasse Yerusalaameppe yaana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Izi daro asa giddon pirdana;","poem":1},{"text":"haahoninne matan diza","poem":2},{"lineBreak":true},{"text":"wolqqama katama giddon diza","poem":2},{"lineBreak":true},{"text":"oosh essana;","poem":2},{"lineBreak":true},{"text":"istti ba giththa","poem":2},{"lineBreak":true},{"text":"mashsha maarasha,","poem":2},{"lineBreak":true},{"text":"ba toorakka baaca histti qoxxana;","poem":2},{"lineBreak":true},{"text":"issi kawoy hara kawo bolla","poem":2},{"lineBreak":true},{"text":"mashsha denththenna;","poem":2},{"lineBreak":true},{"text":"hessafe guye istti","poem":2},{"lineBreak":true},{"text":"ola timirte tamaarettenna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Issi asi ba woyne miththa garsankka","poem":1},{"text":"ba balase miththa garsan uttana;","poem":2},{"lineBreak":true},{"text":"istta babisiza miishshi deenna;","poem":2},{"lineBreak":true},{"text":"Ubbaafe wolqqama","poem":2},{"lineBreak":true},{"text":"GODAA doonay","poem":2},{"lineBreak":true},{"text":"hayssa yootides.","poem":2}]},{"type":"verse","number":5,"content":["Hankko derey ba eeqa sunththan bees; nuni qasse mernaappe mernaa gakkanaas nu GODAA sunththan baana."]},{"type":"heading","content":["Buroppe Hanana Xoossa Qofa"]},{"type":"verse","number":6,"content":["GODAY, «Tani he gallas gundidayta shiishshana; bete bidaytanne muuzottana mala ta aaththa immidayta ubbaa issiso shiishshana."]},{"type":"verse","number":7,"content":["Gundatappe attidaytanne qohettidayta ta istta mino dere kessana; he gallassayfe doommidi mernaa gakkanaas GODAY Xiyoone zuman istta bolla kawotana."]},{"type":"verse","number":8,"content":["Haysso nenan uttidi mehe heemmiza dhoqqa zumazoo! Xiyoone macca nayta naagana giiga uttida zumazoo! Beni ne haariza derey nees simmana; ne kawoteththay Yerusalaame macca nays gidana."]},{"type":"verse","number":9,"content":["Histtiin ne ha7i aazas waassay? Nees kawoy bayee? Neni miixay oykkida maccassay mala un7ettiday nena zorizay dhaynee?"]},{"type":"verse","number":10,"content":["Hanne Xiyoone macca nayee! Miixattiza maccassay mala ne metotana; ha7i qasse ne katamappe gede kezada coo demban de7ana bessiza gishshas Baabiloone baana; ne hee baada heen ne morkketa kusheppe attana; GODAY nena heen ne morkketappe ashshana."]},{"type":"verse","number":11,"content":["Ha7i qasse daro hankko dere asay ne bolla shiiqides; Isttika, ‹Hanna tunidaaz gidu! nu ayfey Xiyoono qidhen xeello› gaana."]},{"type":"verse","number":12,"content":["Gido attiin istti Xoossa qofa erettenna; bukettanaas balen shiiqiza mirqqe kaththa mala bana shiishshizaade qofa istti erettenna."]},{"type":"verse","number":13,"content":["Hanne Xiyoone nayee dendada kaththaa bukka; ta nees birata kacenne xarqimala xugunth immana; nekka hankko dereza izan liiqisana» gides. Istti genen shiishshidayssa Xoossas, istta haarokka ubbaa biitta ubbaa haariza Godaas ne shiishshandasa."]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}