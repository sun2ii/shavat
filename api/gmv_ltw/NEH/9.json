},{"lineBreak":true},{"text":"taman poo7isada","poem":2},{"lineBreak":true},{"text":"istti baanaas bessiza ogera","poem":2},{"lineBreak":true},{"text":"baana mala kaaleththadasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Saloppe duge","poem":1},{"text":"Siina zuma bolla wodhdhada","poem":2},{"lineBreak":true},{"text":"ne dereza haasayssadasa;","poem":2},{"lineBreak":true},{"text":"lo7o wogatanne suure timirteta","poem":2},{"lineBreak":true},{"text":"ne isttas immadasa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Geeshsha ne Sambata","poem":1},{"text":"istti bonchchana mala","poem":2},{"lineBreak":true},{"text":"tamaarsadasa;","poem":2},{"text":"Ne azazota, wogatanne maarata","poem":1},{"text":"ne oosanchcha Muse baggara","poem":2},{"lineBreak":true},{"text":"isttas immadasa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Istti gafettida wode","poem":1},{"text":"saloppe kath immadasa;","poem":2},{"lineBreak":true},{"text":"istti saamettida wode haath","poem":2},{"lineBreak":true},{"text":"zaallafe isttas pulttisadasa;","poem":2},{"lineBreak":true},{"text":"qasse ne isttas immana gaada","poem":2},{"lineBreak":true},{"text":"caaqqida biittaa gelidi","poem":2},{"lineBreak":true},{"text":"ekkana mala azazadasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«Kase nu aawati otoranchchanne","poem":1},{"text":"wozina muume gidida gishshas","poem":2},{"lineBreak":true},{"text":"ne azazo naagibeettenna;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nees azazettibeettenna;","poem":1},{"text":"ne isttas ooththida gita","poem":2},{"lineBreak":true},{"text":"malaataakka ubbaa dogida;","poem":2},{"lineBreak":true},{"text":"wozina muume gidida;","poem":2},{"lineBreak":true},{"text":"qasse guye Gibxe aylleteththan","poem":2},{"lineBreak":true},{"text":"zaarana mala","poem":2},{"lineBreak":true},{"text":"banttana kaaleththiza","poem":2},{"lineBreak":true},{"text