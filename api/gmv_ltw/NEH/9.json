se","number":5,"content":["Iyaaso, Qadim7eele, Baane, Hashabinaye, Sherebiya, Hoddiya, Shebaaniyanne Pattaya geetettiza Lewe bagga asati,",{"text":"«Intte dendi eqqidi mernaa GODAA","poem":1},{"text":"intte Xoossaa galatite;","poem":2},{"lineBreak":true},{"text":"galatappenne anjjofe","poem":2},{"lineBreak":true},{"text":"dhoqqu dhoqqu gida","poem":2},{"lineBreak":true},{"text":"bonchchettida Xoossa sunththa","poem":2},{"lineBreak":true},{"text":"sabbite» gida.","poem":2}]},{"type":"heading","content":["Maarettana Woossida Woosa"]},{"type":"verse","number":6,"content":["Hessafe guye Isra7eele asay,",{"text":"«Xoossoo, ne xalla Goda;","poem":1},{"text":"Salonne salo bolla dizayta,","poem":2},{"lineBreak":true},{"text":"sa7anne sa7a bolla dizayta,","poem":2},{"lineBreak":true},{"text":"gita abbanne iza giddon dizayta","poem":2},{"lineBreak":true},{"text":"ubbaa medhdhiday nena.","poem":2},{"lineBreak":true},{"text":"Ubbaas de7o shemppo immadasa;","poem":2},{"text":"Salo medheteththati ubbay","poem":1},{"text":"nees goynneettes.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"GODAWU, neni Xoossa!","poem":1},{"text":"Neni Abraame Uure geetettiza","poem":2},{"lineBreak":true},{"text":"Kaladaawe dereppe doorada","poem":2},{"lineBreak":true},{"text":"xeyga kessadasa;","poem":2},{"lineBreak":true},{"text":"iza sunththaaka","poem":2},{"lineBreak":true},{"text":"Abrahaame gadasa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Izi nees ammanettida as","poem":1},{"text":"gididayssa beyada","poem":2},{"lineBreak":true},{"text":"izara caaqettadasa;","poem":2},{"text":"Kanaane asay, Hiite asay,","poem":1},{"text":"Amoore asay,","poem":2},{"lineBreak":true},{"text":"Paarize asay, Yaabuse asaynne","poem":2},{"lineBreak":true},{"text":"Gergese asay","poem":2},{"lineBreak":true},{"text":"izan diza biitta,","poem":2},{"lineBreak":true},{"text":"iza zereththatas","poem":2},{"lineBreak":true},{"text":"duussa biitta gidana mala","poem":2},{"lineBreak":true},{"text