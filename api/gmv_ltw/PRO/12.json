ak":true},{"text":"woyzazire harge mala.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xillota qofay suure;","poem":1},{"text":"iitata zorey gidikko cimo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iitata haasayay as wodhees;","poem":1},{"text":"xillota haasayay gidikko","poem":2},{"lineBreak":true},{"text":"as ashshees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iita asati kundana;","poem":1},{"text":"isttas zereththika attenna;","poem":2},{"lineBreak":true},{"text":"xillota zereththi gidikko","poem":2},{"lineBreak":true},{"text":"minni daana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Asi ba aadho erateththa mala","poem":1},{"text":"galateettes;","poem":2},{"lineBreak":true},{"text":"gido attiin geella qofay","poem":2},{"lineBreak":true},{"text":"de7iza asi kadhettees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Aykkoy baynda dishin","poem":1},{"text":"dure asa mala ceeqettiza asappe","poem":2},{"lineBreak":true},{"text":"bana ziqqi histti","poem":2},{"lineBreak":true},{"text":"baas ooththi aqiza asi kiya.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Xillo asi ba mehes qadhettees;","poem":1},{"text":"iita asi kiyattees giikkoka","poem":2},{"lineBreak":true},{"text":"menxe iita.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ba biittaa minththi ooththiza asi","poem":1},{"text":"kath kallees;","poem":2},{"lineBreak":true},{"text":"akeekay paccida asi","poem":2},{"lineBreak":true},{"text":"go7ay baynda hidota gooddees.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nagaranchchati iitati","poem":1},{"text":"di7i ehidayssa amotteettes;","poem":2},{"lineBreak":true},{"text":"xillota zereththi gidikko daayana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Iita asi ba haasayda","poem":1},{"text":"iita haasayan oykettees;","poem":2},{"lineBreak":true},{"text":"xilloy gidikko metoppe","poem":2},{"lineBreak":true},{"text":"kessi ekki attees.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Asi ba doonappe ke7iza qaalan","poem":1},{"text":"lo7o miish kallees;","poem":2},{"lineBreak":true},{"text":"ba ooththida ooso","poem":2},{"lineBreak":true},{"text":"waagakka demmees.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Eeya asas izi biza ogey","poem":1},{"text":"izas lo7o misatees;","poem":2},{"lineBreak":true},{"text":"aadho eranchchay zore siyees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Eeya asa hanqoy heerakka erettees;","poem":1},{"text":"cincca asi gidikko","poem":2},{"lineBreak":true},{"text":"cashshe wudu geenna.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Suure markkay tuma markkattees;","poem":1},{"text":"wordoy gidikko","poem":2},{"lineBreak":true},{"text":"wordo markkattees.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Akeekontta haasayza haasayay","poem":1},{"text":"toora mala caddees;","poem":2},{"lineBreak":true},{"text":"aadho eranchcha","poem":2},{"lineBreak":true},{"text":"inxarsi gidikko paththees.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wordo haasayay guuththa wodessa;","poem":1},{"text":"tuma haasayay gidikko","poem":2},{"lineBreak":true},{"text":"mernaassa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Iita qoppizayta wozinan","poem":1},{"text":"baleththoy dees;","poem":2},{"lineBreak":true},{"text":"gido attiin saro miish qoppizayta","poem":2},{"lineBreak":true},{"text":"wozinan ufayssi dees.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Xillota qohoy gakkenna;","poem":1},{"text":"iitati gidikko meto kallana.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"GODAY wordo haasaya harasettees;","poem":1},{"text":"tumanchchatan gidikko","poem":2},{"lineBreak":true},{"text":"ufayettees.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Akeekara diza asi","poem":1},{"text":"ba erateth qottees;","poem":2},{"lineBreak":true},{"text":"woz