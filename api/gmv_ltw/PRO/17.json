:"zaarizaadesoppe","poem":2},{"lineBreak":true},{"text":"iitay mulekka dhayenna.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Oosh doomeththi eele haath","poem":1},{"text":"pogi yeddo mala;","poem":2},{"lineBreak":true},{"text":"hessa gishshas ooshshi","poem":2},{"lineBreak":true},{"text":"medhettanaappe","poem":2},{"lineBreak":true},{"text":"kasetada kichchaycha.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wordanchcha xillo","poem":1},{"text":"xilloza wordo guussi","poem":2},{"lineBreak":true},{"text":"nam7ayka GODAA sinththan","poem":2},{"lineBreak":true},{"text":"ixettida ooso.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Aadho erateththi demmanaas","poem":1},{"text":"izi koyontta gishshas","poem":2},{"lineBreak":true},{"text":"eeya kushen gelida miish","poem":2},{"lineBreak":true},{"text":"iza ay go7anee?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Laggey ay wodekka lagge;","poem":1},{"text":"ishaykka meto wodes yelettees.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Akeekay paccida asi baqqi caaqqidi","poem":1},{"text":"hara asas waase gelees.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Oosh dosiza asi nagara dosees;","poem":1},{"text":"ubbato bana dhoqqu histtizaadey","poem":2},{"lineBreak":true},{"text":"ba bolla bash xeygees.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Geella qofay de7izaades injjetenna;","poem":1},{"text":"wordo haasayza asikka","poem":2},{"lineBreak":true},{"text":"meton gelees.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Eeya naa yeloy ceecisees;","poem":1},{"text":"eeya naa aawaas ufayssi deenna.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ufayettiza wozinay lo7o dhale;","poem":1},{"text":"gido attiin meqqida wozinay","poem":2},{"lineBreak":true},{"text":"asas wolqqa dhayssees.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Iita asi pirda geellasanaas","poem":1},{"text":"geema