ber":23,"content":["Aadho eranchchati",{"text":"gujjidikka hayssaththo gida;","poem":2},{"text":"Pirdishe maado pirday","poem":1},{"text":"lo7o gidenna.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mooranchcha, «Neni xillo» gizaade","poem":1},{"text":"derey qanggees;","poem":2},{"lineBreak":true},{"text":"kawoteththatikka iza hileettes.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Gido attiin Mooranchcha,","poem":1},{"text":"«Neni mooradasa» gizayta","poem":2},{"lineBreak":true},{"text":"isttara lo7o miishshi gayttana;","poem":2},{"lineBreak":true},{"text":"isttas keehi daro anjjoy yaana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Suure zaaro imoy","poem":1},{"text":"doona yeereteththa mala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Kasetada ne karen diza","poem":1},{"text":"ooso ooththa;","poem":2},{"lineBreak":true},{"text":"ne goshsha giigsa;","poem":2},{"lineBreak":true},{"text":"hessafe guye ne keeth keexxa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ne shooroza bolla","poem":1},{"text":"gaasoy baynda markkattofa;","poem":2},{"lineBreak":true},{"text":"ne doonanka cimmofa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Izi taas ooththida mala","poem":1},{"text":"tani izas ooththana;","poem":2},{"lineBreak":true},{"text":"«Tani izas iza ooso","poem":2},{"lineBreak":true},{"text":"kushe zaarana» gooppa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Tani azalla asa gadera aadhdhadis;","poem":1},{"text":"akeekay paccida asa","poem":2},{"lineBreak":true},{"text":"woyne tura giddora kanththadis.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ubbason agunththi mokkides;","poem":1},{"text":"gadaa sharafay goozides;","poem":2},{"lineBreak":true},{"text":"gimbeyka laalettides.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Tani be7idayssa yuushsha qoppadis;","poem":1},{"text":"tani beyooysafe","poem":2},{"lineBreak":true},{"text":"timirte demmadis.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Neni, «Guuththara liphiphi gays;","poem":1},{"text":"guuththara dhiska ekkays;","poem":2},{"lineBreak":true},{"text":"ne kushezakka shiishshada","poem":2},{"lineBreak":true},{"text":"guuththara shempa","poem":2},{"lineBreak":true},{"text":"ekkays» giikko,","poem":2}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"manqoteththi ne bolla","poem":2},{"lineBreak":true},{"text":"panga mala yaana;","poem":2},{"lineBreak":true},{"text":"paceykka ola miishsha","poem":2},{"lineBreak":true},{"text":"oykkida asa mala puttu gaana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}