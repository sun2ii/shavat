oy dees;","poem":1},{"text":"yashshiza gaammoy","poem":2},{"lineBreak":true},{"text":"wogga ogen yuuyees» gees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Pengey ba maaxafa bollan","poem":1},{"text":"yaanne haa qaaxxiza mala","poem":2},{"lineBreak":true},{"text":"azallaykka ba hiixan yaanne haa","poem":2},{"lineBreak":true},{"text":"shiretti shiretti wodhdhees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Azallay ba kushe maaddan yeddees;","poem":1},{"text":"gido attiin pude ba doonan","poem":2},{"lineBreak":true},{"text":"zaaranaas waayettees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Azalla asi akeekan yootiza","poem":1},{"text":"laappun eranchchatappe","poem":2},{"lineBreak":true},{"text":"bana aadho eranchcha","poem":2},{"lineBreak":true},{"text":"giidi qoppees.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bana gaththontta asa yo7on","poem":1},{"text":"guppi geliza asi","poem":2},{"lineBreak":true},{"text":"kana hayth oykkiza asa mala.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Gooyiza asi tamaa xiifa oliza mala","poem":1},{"text":"woykko wondafe dukkiza mala;","poem":2}]},{"type":"verse","number":19,"content":[{"text":"«Tani kaassas ooththadis» gishe","poem":1},{"text":"ba laggeza cimmiza asikka","poem":2},{"lineBreak":true},{"text":"hessa mala.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Miththi wurikko tamay to7ees;","poem":1},{"text":"zigirssi dhaykko ooshshi attees.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Xiixinththi bonqo","poem":1},{"text":"darssizayssa malanne","poem":2},{"lineBreak":true},{"text":"miththi tamaa darssizayssa mala,","poem":2},{"lineBreak":true},{"text":"doonama asi oosh darssees.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Zigirsanchcha qaalay","poem":1},{"text":"mal7o qumaa mala","poem":2},{"lineBreak":true},{"text":"asas duge marace