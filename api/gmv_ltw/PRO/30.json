t":"woththiday oonee?","poem":2},{"lineBreak":true},{"text":"Ane erikko iza sunth taas yoota;","poem":2},{"lineBreak":true},{"text":"Iza naaza sunththi","poem":2},{"lineBreak":true},{"text":"oona geetettizee?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Xoossay yootiza qaalay","poem":1},{"text":"ubbay tuma;","poem":2},{"lineBreak":true},{"text":"Izan ammanettiza ubbaas","poem":2},{"lineBreak":true},{"text":"izi gondalle.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iza qaala bolla aykkoka gujjofa;","poem":1},{"text":"gujjiko izi nena seerana;","poem":2},{"lineBreak":true},{"text":"neni wordanchcha gididayssaka","poem":2},{"lineBreak":true},{"text":"izi qonccisana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«GODAWU! Tani nena","poem":1},{"text":"nam7u miish oychchays;","poem":2},{"lineBreak":true},{"text":"tani hayqqana gakkanaas","poem":2},{"lineBreak":true},{"text":"istta tana diggofa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tani as cimmontta malanne","poem":1},{"text":"wordo haasayontta mala","poem":2},{"lineBreak":true},{"text":"tana naaga;","poem":2},{"lineBreak":true},{"text":"tana dure woykko","poem":2},{"lineBreak":true},{"text":"manqo histtofa;","poem":2},{"lineBreak":true},{"text":"gido attiin hachchis hachchis","poem":2},{"lineBreak":true},{"text":"gidiza kath taas imma.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Histtontta aggiko","poem":1},{"text":"tani keeha kallada nena kaddana;","poem":2},{"lineBreak":true},{"text":"‹GODAY izi oonee?› gaana;","poem":2},{"lineBreak":true},{"text":"woykko manqada kaysana;","poem":2},{"lineBreak":true},{"text":"histtada tani Xoossa","poem":2},{"lineBreak":true},{"text":"sunththaa caysana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Nena qanggontta malanne","poem":1},{"text":"izi qanggiin nees","poem":2},{"lineBreak":true},{"text":"gometontta mala,","poem":2},{"lineBreak":true},{"text":"aylle iza goda sinththan","poem":2},{"lineBreak":true},{"text":"iitan denththofa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ba aawa qanggizanne","poem":1},{"text":"ba aayokka anjjontta","poem":2},{"lineBreak":true},{"text":"yeletay dees.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tuna gidi uttidi","poem":1},{"text":"banttana geeshsha mala","poem":2},{"lineBreak":true},{"text":"qoodiza asati deettes.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Otoron kumida asatinne","poem":1},{"text":"as kadhidi xeelliza asati deettes.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hiyeesatanne metotanchchata","poem":1},{"text":"dere giddofe dhayssanaas","poem":2},{"lineBreak":true},{"text":"istta achchay mashsha mala gidida","poem":2},{"lineBreak":true},{"text":"istta gaaginay biillama mala","poem":2},{"lineBreak":true},{"text":"gidida asati deettes.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«Ulos nam7u macca nayti deettes.","poem":1},{"text":"Istti, ‹Nuus imma! Nuus imma!›","poem":2},{"lineBreak":true},{"text":"giidi waasseettes.","poem":2},{"lineBreak":true},{"text":"Mulekka kalli erontta","poem":2},{"lineBreak":true},{"text":"heedzdzati deettes;","poem":2},{"lineBreak":true},{"text":"oydanththozi qasse mulera,","poem":2},{"lineBreak":true},{"text":"‹Gidana› gi erenna.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hessanttika duufo, maynida ulo,","poem":1},{"text":"haaththi kalli erontta","poem":2},{"lineBreak":true},{"text":"mela biittanne,","poem":2},{"lineBreak":true},{"text":"‹Taas gidana!› gi erontta tama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«Ba aawa qidhiza naa ayfenne,","poem":1},{"text":"ba aayo kadhiza naa ayfe","poem":2},{"lineBreak":true},{"text":"kelkan de7iza quuroti woocana;","poem":2},{"lineBreak":true},{"text":"iza ashoza ankkoti maana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tana keehi malalisiza","poem":1},{"text":"heedzdzu miishshati deettes;","poem":2},{"lineBreak":true},{"text":"oydanththozi","poem":2},{"lineBreak":true},{"text":"ubbaarakka taas gelenna.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hessanttika golleti","poem":1},{"text":"salora paalliza paalo,","poem":2},{"lineBreak":true},{"text":"shooshshi shuchcha bollara","poem":2},{"lineBreak":true},{"text":"sololu gi buus,","poem":2},{"lineBreak":true},{"text":"markabey abbaa bollara biza","poem":2},{"lineBreak":true},{"text":"buus addey macca naa siiqo","poem":2},{"lineBreak":true},{"text":"demmanaas haniza hanota.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«Layma maccassaya","poem":1},{"text":"haniza hanoykka","poem":2},{"lineBreak":true},{"text":"hessa mala.","poem":2},{"lineBreak":true},{"text":"Iza muussa mawus;","poem":2},{"lineBreak":true},{"text":"gido attiin midaappe guyen,","poem":2},{"lineBreak":true},{"text":"ba doona quccada,","poem":2},{"lineBreak":true},{"text":"‹Tani aykkoka","poem":2},{"lineBreak":true},{"text":"moorabeekke› gawus.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«Heedzdzu yo7otan","poem":1},{"text":"biittay qaaxxees;","poem":2},{"lineBreak":true},{"text":"oydanththoza ubbaaka","poem":2},{"lineBreak":true},{"text":"tookkanaas dandayenna.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hessanttika aylley kawotida wode,","poem":1},{"text":"eeyay kath kallida wode,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"asi ixxida maccassaya","poem":1},{"text":"adde gelida wodenne","poem":2},{"lineBreak":true},{"text":"macca ashkariya ba godatteyo","poem":2},{"lineBreak":true},{"text":"laattida wode haniza hanota.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"«Sa7a bolla oyddu","poem":1},{"text":"guuththa medhetati deettes;","poem":2},{"lineBreak":true},{"text":"gido atti