":true},{"text":"iita miish ooththanaas","poem":2},{"lineBreak":true},{"text":"halchchidaa gidikko","poem":2},{"lineBreak":true},{"text":"ane takki gaada qoppa.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Maaththi bukkiin oysi ke7iza mala,","poem":1},{"text":"siidhe iccinkka","poem":2},{"lineBreak":true},{"text":"suuththi yiza mala","poem":2},{"lineBreak":true},{"text":"hanqo denththeththiko","poem":2},{"lineBreak":true},{"text":"oosh medhdhees.»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PRO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}