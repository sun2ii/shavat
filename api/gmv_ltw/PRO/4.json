o erateththinne akeeka oykka;","poem":1},{"text":"ta qaala dogoppa;","poem":2},{"lineBreak":true},{"text":"izippeka kare kezoppa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Aadho erateth aggofa;","poem":1},{"text":"iza nees gondalle gidana;","poem":2},{"lineBreak":true},{"text":"izo siiqa;","poem":2},{"lineBreak":true},{"text":"izakka nena naagana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Aadho erateththi bayra;","poem":1},{"text":"hessa gishshas izo demma.","poem":2},{"lineBreak":true},{"text":"Akeekay ne aqoza ubbaa","poem":2},{"lineBreak":true},{"text":"ekkizaa gidikkoka iza demma.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Neni aadho erateth bonchcha;","poem":1},{"text":"iza nena","poem":2},{"lineBreak":true},{"text":"dhoqqu dhoqqu ooththana;","poem":2},{"lineBreak":true},{"text":"neni izo idimma;","poem":2},{"lineBreak":true},{"text":"iza nena bonchchana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iza ne hu7en","poem":1},{"text":"saba akilile woththana;","poem":2},{"lineBreak":true},{"text":"bonchcho kallachchaka","poem":2},{"lineBreak":true},{"text":"immana» gees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta naazoo! Ta gizayssa ezga;","poem":1},{"text":"ta qaalaakka","poem":2},{"lineBreak":true},{"text":"ne wozinan woththa;","poem":2},{"lineBreak":true},{"text":"ne layththi aduqqana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tani nena aadho erateththa","poem":1},{"text":"oge kaaleththana;","poem":2},{"lineBreak":true},{"text":"suure ogekka bessana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne hemettashe dhuphettaka;","poem":1},{"text":"woxxikokka kundaka.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ta timirte lo7eththa oykka;","poem":1},{"text":"izo yeddofa;","poem":2},{"lineBreak":true},{"text":"iza nees de7o gidida gishshas","poem":2},{"lineBreak":true},{"text":"izo naaga.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nagaranchchata oge yedhdhofa;","poem":1},{"text":"iita asata ogenkka hemettofa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Izippe haakka; izin hemettofa;","poem":1},{"text":"izippe guye simma;","poem":2},{"lineBreak":true},{"text":"histtada ne ogeyra ba.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Istti iita ooththontta dishe","poem":1},{"text":"dhiski erettenna;","poem":2},{"lineBreak":true},{"text":"as dhupheththontta dishin","poem":2},{"lineBreak":true},{"text":"dhiskoy istta ayfen yeenna.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Istti iitateth kaththa mala meettes;","poem":1},{"text":"genekka ushsha mala uyeettes.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Xillota ogey seeta gallas gakkanaas","poem":1},{"text":"poo7i poo7i biza","poem":2},{"lineBreak":true},{"text":"mallado xalqqe mala.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Gido attiin nagaranchchata ogey","poem":1},{"text":"sakkanna dhuma mala;","poem":2},{"lineBreak":true},{"text":"istti aazan dhuphettanaakkoka","poem":2},{"lineBreak":true},{"text":"erettenna.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ta naazoo! Ta gizayssa akeeka;","poem":1},{"text":"ta qaalaakka lo7eththa ezga.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ne ayfe sinththafe haassofa;","poem":1},{"text":"ne wozinan woththa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Gaasoykka istti demmiza asas","poem":1},{"text":"de7o immeettes;","poem":2},{"lineBreak":true},{"text":"istti asateththaska","poem":2},{"lineBreak":true},{"text":"payyateth immeettes.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ubbaafekka bollara","poem":1},{"text":"neni ne wozina","poem":2},{"lineBreak":true},{"text":"minththada naaga;","poem":2},{"lineBreak":true},{"text":"ays giikko de7oy izappe pulttees.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ne doonappe gene haasaya digga;","poem":1},{"text":"iita haasaya","poem":2},{"lineBreak":true},{"text":"ne metershafe haassa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ne ayfeti sitti giidi","poem":1},{"text":"sinth xeelletto;","poem":2},{"lineBreak":true},{"text":"tishshi histtada","poem":2},{"lineBreak":true},{"text":"ne sinththan dizayssa xeella.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ne tohos oge giigsa;","poem":1},{"text":"suure oge xalla hemetta.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ushach hadirsi gooppa;","poem":1},{"text":"ne toho iitappe naaga.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}