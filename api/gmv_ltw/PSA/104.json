,"number":23,"content":[{"text":"He wode asi ba oosos kezees;","poem":1},{"text":"sa7ay qammana gakkanaas","poem":2},{"lineBreak":true},{"text":"ooththees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Abeet GODAWU!","poem":1},{"text":"Ne oosoy ay keena daroo!","poem":2},{"lineBreak":true},{"text":"Ne aadho erateththan","poem":2},{"lineBreak":true},{"text":"neni istta ubbaa medhdhadasa;","poem":2},{"lineBreak":true},{"text":"ne medhdhida medhetati","poem":2},{"lineBreak":true},{"text":"biitta kumida.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Hanna abbaya gitanne aaho;","poem":1},{"text":"qooday baynda qaaxxiza","poem":2},{"lineBreak":true},{"text":"medheteththati,","poem":2},{"lineBreak":true},{"text":"guuththatinne gitati izin kumida.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Izi bollan markabeti simeretteettes;","poem":1},{"text":"qasse neni medhdhida","poem":2},{"lineBreak":true},{"text":"Lewataane geetettiza miiminttey","poem":2},{"lineBreak":true},{"text":"izin kaa7ees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Koshshiza wode ne isttas","poem":1},{"text":"mizaaz immana mala","poem":2},{"lineBreak":true},{"text":"istti ubbay neekko xeelleettes.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Neni isttas immida wode","poem":1},{"text":"istti shiishsheettes;","poem":2},{"lineBreak":true},{"text":"neni ne kusheppe yeggiin","poem":2},{"lineBreak":true},{"text":"istti lo7o miish kalleettes.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Neni ne sinththa","poem":1},{"text":"genththiza wode dagammeettes;","poem":2},{"lineBreak":true},{"text":"ne istta shemppo","poem":2},{"lineBreak":true},{"text":"ekkiza wode hayqqeettes;","poem":2},{"lineBreak":true},{"text":"duge biittankka simmi geleettes.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Gido attiin neni isttas","poem":1},{"text":"ne ayana kiittida wode","poem":2}