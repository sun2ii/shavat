{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"PSA","translationId":"gmv_ltw","name":"Mazamure Maxaafa","commonName":"Mazamure Maxaafa","title":"Mazamure Maxaafa","order":19,"numberOfChapters":150,"sha256":"b41b54467d4ccd217c1e17f8b492e2d5b20ef4f2e46fb67681b6a866a5d7ea88","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gmv_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"GODAA galatite!","poem":1},{"text":"Suureta shiiqoninne","poem":2},{"lineBreak":true},{"text":"dere duulatan","poem":2},{"lineBreak":true},{"text":"tani kumeththa wozinappe","poem":2},{"lineBreak":true},{"text":"GODAA galatana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"GODAA oosoti ay keena gitaa!","poem":1},{"text":"Isttan ufayettizayti ubbay","poem":2},{"lineBreak":true},{"text":"istti yuushshi qoppanaas bessees.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iza oosoti bonchchoninne","poem":1},{"text":"teeman kumidayta;","poem":2},{"lineBreak":true},{"text":"iza xilloteththika mernaas dees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Izi ba malalisiza oosota","poem":1},{"text":"hassa7ettana mala ooththides.","poem":2},{"lineBreak":true},{"text":"Izi kiyanne maariza GODAA.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Baas yayyizaytas kath immees;","poem":1},{"text":"ba caaqo qaalaakka","poem":2},{"lineBreak":true},{"text":"mernaas qoppees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Allagata biitta ba deraas immidi","poem":1},{"text":"ba mino oosoza","poem":2},{"lineBreak":true},{"text":"ba kawoteththaa bessides.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iza oosoti tumanne suure;","poem":1},{"text":"iza wogatikka","poem":2},{"lineBreak":true},{"text":"ubbay ammanettizayta.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Istti mernaas eqqi de7izayta;","poem":1},{"text":"tumateththaninne","poem":2},{"lineBreak":true},{"text":"suureteththan imettida.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Izi ba asaas atoteth immides;","poem":1},{"text":"ba caaqo qaalakka","poem":2},{"lineBreak":true},{"text":"isttas mernaas azazides;","poem":2},{"lineBreak":true},{"text":"iza sunththi geeshshinne yashissizaaza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Aadho erateththas koyroy","poem":1},{"text":"GODAAS yashshateththa;","poem":2},{"lineBreak":true},{"text":"iza azazo ooththizaytas","poem":2},{"lineBreak":true},{"text":"lo7o akeekay dees.","poem":2},{"lineBreak":true},{"text":"GODAY mernaas galatetto!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}