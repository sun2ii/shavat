{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"PSA","translationId":"gmv_ltw","name":"Mazamure Maxaafa","commonName":"Mazamure Maxaafa","title":"Mazamure Maxaafa","order":19,"numberOfChapters":150,"sha256":"b41b54467d4ccd217c1e17f8b492e2d5b20ef4f2e46fb67681b6a866a5d7ea88","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gmv_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"GODAY galatetto!","poem":1},{"text":"GODAAS yayyiza asi,","poem":2},{"lineBreak":true},{"text":"iza azazotakka polanaas","poem":2},{"lineBreak":true},{"text":"ufayettiza asi anjjettidayssa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Iza nayti biittan wolqqama gidana;","poem":1},{"text":"suure asata yeletay anjjettana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Aqotaynne dureteththi","poem":1},{"text":"iza keeththan dees;","poem":2},{"lineBreak":true},{"text":"iza xilloteththayka","poem":2},{"lineBreak":true},{"text":"mernaas de7ana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kiya, qadhettizanne xillo ooththiza","poem":1},{"text":"suure asas dhuma giddon","poem":2},{"lineBreak":true},{"text":"poo7oy poo7ees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kiyateththan coo tal7iza asas,","poem":1},{"text":"ba ooso suureteththan ooththiza","poem":2},{"lineBreak":true},{"text":"asas de7oy injjetana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xillo asi awudenne kundenna;","poem":1},{"text":"mernaas izi hassa7ettishe de7ana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iita miishshi iza daganththenna;","poem":1},{"text":"ays giikko iza wozinay hirgenna;","poem":2},{"lineBreak":true},{"text":"GODAAN ammaneettes.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iza wozinay mino;","poem":1},{"text":"mulekka yayyenna;","poem":2},{"lineBreak":true},{"text":"wurseththan ba morkketa","poem":2},{"lineBreak":true},{"text":"kundeth izi be7ana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Izi hiyeesatas kiyateththan immees;","poem":1},{"text":"qasse iza xilloteththay","poem":2},{"lineBreak":true},{"text":"mernaas dees;","poem":2},{"lineBreak":true},{"text":"iza kacey bonchchon","poem":2},{"lineBreak":true},{"text":"dhoqqu dhoqqu gaana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Iita asi hessa be7idi yiillotees;","poem":1},{"text":"ba achchaa garccishe","poem":2},{"lineBreak":true},{"text":"coo gilqi dhayees;","poem":2},{"lineBreak":true},{"text":"iitata amoy hada gidana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}