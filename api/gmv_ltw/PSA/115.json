o!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Salonne sa7a medhdhida","poem":1},{"text":"GODAY inttena anjjo!","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Saloti Xoossassa;","poem":1},{"text":"gido attiin sa7a","poem":2},{"lineBreak":true},{"text":"asa naytas immides.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hayqqidi duge duufon gelidayti","poem":1},{"text":"GODAA galatanaas","poem":2},{"lineBreak":true},{"text":"dandayettenna.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Gido attiin nuni","poem":1},{"text":"shemppora paxa dizayti","poem":2},{"lineBreak":true},{"text":"hachchife doommidi","poem":2},{"lineBreak":true},{"text":"mernaa gakkanaas","poem":2},{"lineBreak":true},{"text":"GODAA galatana.","poem":2},{"lineBreak":true},{"text":"GODAY galatetto!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}