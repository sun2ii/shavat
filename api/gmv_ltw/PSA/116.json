gaada GODAA sunth xeygadis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"GODAY kiyanne xillo;","poem":1},{"text":"nu Xoossay maarizayssa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"GODAY ashketa naagees;","poem":1},{"text":"tani metotida wode","poem":2},{"lineBreak":true},{"text":"izi tana ashshides.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta shemppoyee ane woppu ga;","poem":1},{"text":"GODAY nees","poem":2},{"lineBreak":true},{"text":"lo7o miish ooththides.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"GODAY tana hayqoppe,","poem":1},{"text":"ta ayfe afunththafe,","poem":2},{"lineBreak":true},{"text":"ta tohokka","poem":2},{"lineBreak":true},{"text":"dhupheppe ashshides.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hessa gishshas","poem":1},{"text":"tani GODAA sinththan","poem":2},{"lineBreak":true},{"text":"shemppora paxa dizayta","poem":2},{"lineBreak":true},{"text":"giddon hemettays.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta, «Tani keeha un7ettadis»","poem":1},{"text":"giza wodekka","poem":2},{"lineBreak":true},{"text":"ammano aggabeekke.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Taas gizaazi dhayiin,","poem":1},{"text":"«Asi ubbay wordo» gadis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Izi taas kiyida kiyateththaa gishshas","poem":1},{"text":"tani GODAAS","poem":2},{"lineBreak":true},{"text":"ay qanxxanaas dandayazinaa?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"GODAY tana ashshida gishshas","poem":1},{"text":"woyne ushshu galatas shiishshada","poem":2},{"lineBreak":true},{"text":"iza sunththu xeygana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iza deraa ubbaa sinththan","poem":1},{"text":"tani adinida adina","poem":2},{"lineBreak":true},{"text":"GODAAS gaththana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Geeshshata hayqoy","poem":1},{"text":"GODAA sinththan bonchcho.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Abeet GODAWU! Tani ne aylle;","poem":1},{"text":"tani ne aylley naa;","poem":2},{"lineBreak":true},{"text":"tana qashoppe birshadasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Abeet GODAWU!","poem":1},{"text":"Tani galata yarsho nees yarshana;","poem":2},{"lineBreak":true},{"text":"histtada ne sunththaa xeygana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Iza deraa ubbaa sinththan","poem":1},{"text":"tani adinettida adina","poem":2},{"lineBreak":true},{"text":"GODAAS gaththana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hessaka tani gaththanay,","poem":1},{"text":"Yerusalaamen diza GODAA","poem":2},{"lineBreak":true},{"text":"keeththa dabaabanna.","poem":2},{"lineBreak":true},{"text":"GODAY galatetto!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}