_break"},{"type":"verse","number":5,"content":[{"text":"GODAY, «Hiyeesati un7ettida","poem":1},{"text":"gishshassinne,","poem":2},{"lineBreak":true},{"text":"metotanchchata waaso gishshas","poem":2},{"lineBreak":true},{"text":"ha7i tani dendana;","poem":2},{"lineBreak":true},{"text":"tani istti amottiza saroteththan","poem":2},{"lineBreak":true},{"text":"istta woththana» gees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"GODAA qaalay izan","poem":1},{"text":"walakay baynda muuruta;","poem":2},{"lineBreak":true},{"text":"cooce taman laappunto","poem":2},{"lineBreak":true},{"text":"paacetti geeyida bira mala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Abeet GODAWU!","poem":1},{"text":"Neni nuna saroteththan naaga;","poem":2},{"lineBreak":true},{"text":"ha woden diza iita yeletappe","poem":2},{"lineBreak":true},{"text":"mernaas ne nuna ashsha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Asaa giddon iitay","poem":1},{"text":"bonchchettida wode","poem":2},{"lineBreak":true},{"text":"geellati ubba wode","poem":2},{"lineBreak":true},{"text":"otoreteththan simeretteettes.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}