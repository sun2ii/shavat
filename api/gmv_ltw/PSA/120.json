e deraa giddon days;","poem":1},{"text":"Qeedaare dunkaanenkka","poem":2},{"lineBreak":true},{"text":"uttida gishshas","poem":2},{"lineBreak":true},{"text":"taas aayye ana!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Saroteth ixxiza asatara","poem":1},{"text":"tani daro wode de7adis.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tani saro koyays;","poem":1},{"text":"gido attiin tani saro","poem":2},{"lineBreak":true},{"text":"haasayza wode","poem":2},{"lineBreak":true},{"text":"istti oosh koyeettes.","poem":2}]}],"footnotes":[{"noteId":17,"caller":"+","text":"Pude kezishe yexxida mazamure gizayssi Ibraawe deren asay Yerusalaame bishe yexxiza mazamure bessees.","reference":{"chapter":120,"verse":1}}]},"thisChapterLink":"/api/gmv_ltw/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}