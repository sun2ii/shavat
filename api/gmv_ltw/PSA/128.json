na","poem":2},{"lineBreak":true},{"text":"Yerusalaame lo7eteth besso!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Izi nena nayta nayta gaththi besso!","poem":1},{"lineBreak":true},{"text":"Isra7eeles saroy gido!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}