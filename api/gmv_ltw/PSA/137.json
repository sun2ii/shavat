t":"ta ushachcha kushey","poem":2},{"lineBreak":true},{"text":"ba ooso balo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tani nena hassa7ontta aggiko","poem":1},{"text":"ta ufayssa ubbaafe aaththada","poem":2},{"lineBreak":true},{"text":"Yerusalaame dosontta aggiko","poem":2},{"lineBreak":true},{"text":"ta inxarsay","poem":2},{"lineBreak":true},{"text":"gonggiraththara oyketto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Abeet GODAWU!","poem":1},{"text":"Yerusalaamey kundiza gallas","poem":2},{"lineBreak":true},{"text":"Eedoome asati","poem":2},{"lineBreak":true},{"text":"ooththidayssa qoppa;","poem":2},{"lineBreak":true},{"text":"istti, «Laallite! Laallite!","poem":2},{"lineBreak":true},{"text":"Yochchaafe dhoqalli dhayssite!»","poem":2},{"lineBreak":true},{"text":"gidayssa baloppa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Hanne Baabiloone biittayee","poem":1},{"text":"ne dhayana!","poem":2},{"lineBreak":true},{"text":"Neni nu bolla polida iita ooso","poem":2},{"lineBreak":true},{"text":"ne bolla zaari ooththizay","poem":2},{"lineBreak":true},{"text":"anjjettidayssa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ne guuththa nayta oykkidi","poem":1},{"text":"zaalla bolla dincereththizay","poem":2},{"lineBreak":true},{"text":"anjjettidayssa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}