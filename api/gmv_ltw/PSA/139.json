Break":true},{"text":"tana tila medhdhadasa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Neni tana keehi yegalththinne","poem":1},{"text":"malalisizaaz histta","poem":2},{"lineBreak":true},{"text":"medhdhida gishshas","poem":2},{"lineBreak":true},{"text":"ta nena galatays;","poem":2},{"lineBreak":true},{"text":"ne oosoti malalisizayta!","poem":2},{"lineBreak":true},{"text":"Ta shemppoya","poem":2},{"lineBreak":true},{"text":"hessa ubbaa erawus.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tani geemason medhettida wode","poem":1},{"text":"ta meqeththati","poem":2},{"lineBreak":true},{"text":"neeppe geemmibeettenna;","poem":2},{"lineBreak":true},{"text":"tani ta aayey ulon ciimma giddon","poem":2},{"lineBreak":true},{"text":"hiillan oosettiza wode,","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ta aayi ulon buro suuth gida","poem":2},{"lineBreak":true},{"text":"ta dishin ne ayfeti be7ida;","poem":2},{"lineBreak":true},{"text":"ta layththatappe issoynne","poem":2},{"lineBreak":true},{"text":"doomettontta dishin","poem":2},{"lineBreak":true},{"text":"taas neni barida gallassati ubbay","poem":2},{"lineBreak":true},{"text":"ne mazgaban xaafettida.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Abeet Xoossawu!","poem":1},{"text":"Ne taas qoppiza qofay","poem":2},{"lineBreak":true},{"text":"ay mala lo7oo!","poem":2},{"lineBreak":true},{"text":"Izikka ay keena coraa!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tani iza qoodikko aceppeka daro;","poem":1},{"text":"ta ichcha beeggiza wode","poem":2},{"lineBreak":true},{"text":"ha7ikka nenara de7ays.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Abeet Xoossawu!","poem":1},{"text":"Neni iitata siifidaakko aazee dizay!","poem":2},{"lineBreak":true},{"text":"Suuth gussana saamettiza asati","poem":2},{"lineBreak":true},{"text":"taappe haakkite!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Istti ne bolla iita miish haasayeettes;","poem":1},{"text":"ne morkketi","poem":2},{"lineBreak":true},{"text":"ne sunththaa mooreettes.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Abeet GODAWU!","poem":1},{"text":"Nena ixxizayta tani ixxikinaa?","poem":2},{"lineBreak":true},{"text":"Ne bolla dendizayta","poem":2},{"lineBreak":true},{"text":"tani harassettikinaa?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ta istta mulera ixxays;","poem":1},{"text":"istta tani","poem":2},{"lineBreak":true},{"text":"ta morkketa mala qoodays.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Abeet Xoossawu!","poem":1},{"text":"Ta wozina pilggada era;","poem":2},{"lineBreak":true},{"text":"tana paaccada ta ceece qofaakka","poem":2},{"lineBreak":true},{"text":"shaakka era.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ane tanan iitay de7ikko xeella;","poem":1},{"text":"histtada mernaa ogera","poem":2},{"lineBreak":true},{"text":"tana kaaleththa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}