i aazee?","poem":2},{"lineBreak":true},{"text":"Ne hayssaththo asas qoppanawu","poem":2},{"lineBreak":true},{"text":"asa nay aazee?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Asi issito carki aadhdhiza","poem":1},{"text":"carko mala;","poem":2},{"lineBreak":true},{"text":"iza layththatikka","poem":2},{"lineBreak":true},{"text":"eeson dhayza kuwa mala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Abeet GODAWU!","poem":1},{"text":"neni salaa daakkada","poem":2},{"lineBreak":true},{"text":"duge wodhdha!","poem":2},{"lineBreak":true},{"text":"zumata bochchada cuwasa!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wolqqanth yeddada","poem":1},{"text":"ne morkketa laalla!","poem":2},{"lineBreak":true},{"text":"Ne wondafe yiishshan","poem":2},{"lineBreak":true},{"text":"dukkada yedeththa!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bollafe ne kushe yeddada,","poem":1},{"text":"tana wolqqama haaththafe","poem":2},{"lineBreak":true},{"text":"goochcha kessa;","poem":2},{"lineBreak":true},{"text":"allaga asata kusheppe","poem":2},{"lineBreak":true},{"text":"ne tana ashsha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Istta doonay wordo haasayees;","poem":1},{"text":"istti ushachcha kushe denththidi","poem":2},{"lineBreak":true},{"text":"wordo caaqqeettes.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Abeet Xoossawu!","poem":1},{"text":"Tani nees ooraththa","poem":2},{"lineBreak":true},{"text":"mazamure yexxana;","poem":2},{"lineBreak":true},{"text":"tammu shayan waaxettida diiththan","poem":2},{"lineBreak":true},{"text":"nees yexxana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kawotas xoono immaasa;","poem":1},{"text":"ne aylle Dawite giththa","poem":2},{"lineBreak":true},{"text":"mashshafe ashshaasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Wordo haasayzaytappenne","poem":1},{"text":"ba ushachcha kushe denththidi","poem":2},{"lineBreak":true},{"text":"wordo caaqqizaytappenne","poem":2},{"lineBreak":true},{"text":"allagatappe tana ashshanne naaga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nu attuma nayti","poem":1},{"text":"ba naateteththan dalqidalqidi","poem":2},{"lineBreak":true},{"text":"dicciza miththa mala gidetto!","poem":2},{"lineBreak":true},{"text":"Nu macca naytikka","poem":2},{"lineBreak":true},{"text":"kawo keeththa gulan","poem":2},{"lineBreak":true},{"text":"alleqos essida","poem":2},{"lineBreak":true},{"text":"tuuqe mala gidetto.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nu gootaratan dumma dumma","poem":1},{"text":"qommo kaththi kumo;","poem":2},{"lineBreak":true},{"text":"nu dorsati shii laaqqa","poem":2},{"lineBreak":true},{"text":"gakkanaas yeletto;","poem":2},{"lineBreak":true},{"text":"heemettizason tammu shii","poem":2},{"lineBreak":true},{"text":"gakkanawu daretto.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nu miizati yelizayta gidetto;","poem":1},{"text":"istti awucayontta","poem":2},{"lineBreak":true},{"text":"yelettidi corattetto.","poem":2},{"lineBreak":true},{"text":"Nuna asi di7oppo;","poem":2},{"lineBreak":true},{"text":"nu zagon waasoy siyettofo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ha anjjoy iza gakkiza derey","poem":1},{"text":"anjjettida dere;","poem":2},{"lineBreak":true},{"text":"Xoossi izas GODAA gidida derey","poem":2},{"lineBreak":true},{"text":"anjjettida dere.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}