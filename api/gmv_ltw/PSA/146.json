":"he gallas attana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yaaqoobe Xoossay maaddiza asi","poem":1},{"text":"ba hidotakka ba GODAA bolla","poem":2},{"lineBreak":true},{"text":"woththida asi anjjettidaade.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"GODAY salonne sa7a,","poem":1},{"text":"gita abbanne istta","poem":2},{"lineBreak":true},{"text":"giddon diza ubbaa","poem":2},{"lineBreak":true},{"text":"medhdhidayssa;","poem":2},{"lineBreak":true},{"text":"izi ba ammaneteththaa","poem":2},{"lineBreak":true},{"text":"mernaas naagizayssa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Izi qohettidaytas pirdizayssa;","poem":1},{"text":"gafidayta mizi kalssizayssa.","poem":2},{"lineBreak":true},{"text":"GODAY qashettidayta","poem":2},{"lineBreak":true},{"text":"birshi yeddizayssa;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"GODAY qooqeta xeelisees.","poem":1},{"text":"GODAY kundidayta denththees;","poem":2},{"lineBreak":true},{"text":"GODAY xillotakka siiqees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"GODAY bete asata naagees.","poem":1},{"text":"Am7etanne yi7o nayta maaddees;","poem":2},{"lineBreak":true},{"text":"gido attiin iitata oge dhayssees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"GODAY mernaas kawo;","poem":1},{"text":"Xiyoone! Ne Xoossi","poem":2},{"lineBreak":true},{"text":"yeletappe yeleta gakkanaas","poem":2},{"lineBreak":true},{"text":"kawotana.","poem":2},{"lineBreak":true},{"text":"GODAY galatetto!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}