ita;","poem":1},{"text":"izi keehippe wolqqama;","poem":2},{"lineBreak":true},{"text":"iza erateththaas zaway deenna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"GODAY kadhettidayta bonchchees;","poem":1},{"text":"gido attiin iitata kawushshees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"GODAAS galata mazamure yexxite;","poem":1},{"text":"nu Xoossas maasinqo","poem":2},{"lineBreak":true},{"text":"shocishe galatite.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Izi salo shaara mayzees;","poem":1},{"text":"sa7as ira bukisees;","poem":2},{"lineBreak":true},{"text":"zumata bollaka maata mokisees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Medosassinne quuro yelotas","poem":1},{"text":"miza miish izi immees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Izi ufayettizay","poem":1},{"text":"parata wolqqaninne","poem":2},{"lineBreak":true},{"text":"tooranchchata","poem":2},{"lineBreak":true},{"text":"minoteththan gidenna.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"GODAY baas yayyizaytaninne","poem":1},{"text":"iza siiqon","poem":2},{"lineBreak":true},{"text":"ammanettizaytan ufayettees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yerusalaame katamayee!","poem":1},{"text":"GODAA galata!","poem":2},{"lineBreak":true},{"text":"Hanne Xiyoonee! Ne Xoossa sabba!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Izi ne penge kolata minththees;","poem":1},{"text":"ne giddon diza ne nayta anjjees.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Izi ne zawa saroteththan naagees;","poem":1},{"text":"nena keehippe lo7iza","poem":2},{"lineBreak":true},{"text":"gistte kalssees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Izi ba kiita sa7as kiittees;","poem":1},{"text":"iza qaalaykka eeson gakkees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Izi shach afala mala miccees;","poem":1},{"text":"kenchchoka bidinththa mala","poem":2},{"lineBreak":true},{"text":"laallees.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Izi shach shuchcha mala","poem":1},{"text":"duge yeddana;","poem":2},{"lineBreak":true},{"text":"he moocezan eqqanaas","poem":2},{"lineBreak":true},{"text":"ooninne dandayenna.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Izi ba qaala kiittidi","poem":1},{"text":"shachchaa mayisees.","poem":2},{"lineBreak":true},{"text":"Izi carko carkissiin","poem":2},{"lineBreak":true},{"text":"haaththi goggees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Izi ba qaala Yaaqoobe zereththas","poem":1},{"text":"ba maaraanne wogaa","poem":2},{"lineBreak":true},{"text":"Isra7eele asaas qonccisees.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Izi hessa mala","poem":1},{"text":"hara kawoteththatas","poem":2},{"lineBreak":true},{"text":"ooththibeenna;","poem":2},{"lineBreak":true},{"text":"istti iza woga erettenna.","poem":2},{"lineBreak":true},{"text":"GODAY galatetto!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}