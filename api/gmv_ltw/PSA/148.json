{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"PSA","translationId":"gmv_ltw","name":"Mazamure Maxaafa","commonName":"Mazamure Maxaafa","title":"Mazamure Maxaafa","order":19,"numberOfChapters":150,"sha256":"b41b54467d4ccd217c1e17f8b492e2d5b20ef4f2e46fb67681b6a866a5d7ea88","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gmv_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"GODAY galatetto!","poem":1},{"lineBreak":true},{"text":"Salon de7izaytoo! GODAA galatite;","poem":1},{"text":"bolla dhoqqan de7izaytoo!","poem":2},{"lineBreak":true},{"text":"Iza sabbite.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Intteno iza kiitanchchatoo!","poem":1},{"text":"Ubbay iza galatite;","poem":2},{"lineBreak":true},{"text":"salon de7iza iza olanchchatoo!","poem":2},{"lineBreak":true},{"text":"Ubbay iza galatite.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Arsheynne aginay iza galatite;","poem":1},{"text":"poo7isiza xoolinttetoo!","poem":2},{"lineBreak":true},{"text":"Ubbay iza galatite.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Intteno ubbaafe bolla dhoqqan","poem":1},{"text":"diza salotoo! Iza galatite;","poem":2},{"lineBreak":true},{"text":"Salo gufanththofe bollara diza","poem":2},{"lineBreak":true},{"text":"haaththatoo! Iza sabbite.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Izi azaziin istti ubbayka","poem":1},{"text":"medhettida gishshas","poem":2},{"lineBreak":true},{"text":"ubbati GODAA","poem":2},{"lineBreak":true},{"text":"sunththaa galatetto!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Izi istta istti dizason","poem":1},{"text":"meri mernaas","poem":2},{"lineBreak":true},{"text":"minththi woththides;","poem":2},{"lineBreak":true},{"text":"Izi isttas laamettontta","poem":2},{"lineBreak":true},{"text":"woga immides.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sa7an de7izaytoo! GODAA galatite!","poem":1},{"text":"Abba giddon diza","poem":2},{"lineBreak":true},{"text":"gita medheteththatinne","poem":2},{"lineBreak":true},{"text":"wogga gita abba ciimmati","poem":2},{"lineBreak":true},{"text":"ubbayka iza sabbite.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wolqqanththinne shachchi,","poem":1},{"text":"kenchchoynne gubbanay,","poem":2},{"lineBreak":true},{"text":"iza azazo poliza gote carkoti","poem":2},{"lineBreak":true},{"text":"ubbatikka iza galatite.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Zumatoo, zumbullatoo,","poem":1},{"text":"ayfe ayfiza miththatoo, zigatoo","poem":2},{"lineBreak":true},{"text":"ubbatikka iza galatite.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mehetoo, do7atoo,","poem":1},{"text":"sa7ara gooshettiza medhetatoo!","poem":2},{"lineBreak":true},{"text":"Paalliza kafotoo ubbatikka","poem":2},{"lineBreak":true},{"text":"iza galatite.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sa7aa kawotoo, kawoteththatoo!","poem":1},{"text":"Daannatoo, dere haarizaytoo!","poem":2},{"lineBreak":true},{"text":"Ubbatikka iza galatite.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Panththatoo, geela7otoo,","poem":1},{"text":"cimatoo, naytoo!","poem":2},{"lineBreak":true},{"text":"Ubbatikka iza galatite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Iza sunththi ubbaa bolla dhoqqa;","poem":1},{"text":"iza bonchchoy","poem":2},{"lineBreak":true},{"text":"sa7appenne saloppe bolla;","poem":2},{"lineBreak":true},{"text":"hessa gishshas hayti ubbay","poem":2},{"lineBreak":true},{"text":"iza sunth galatetto.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iza bagga gidida Isra7eele asati","poem":1},{"text":"iza galatana mala","poem":2},{"lineBreak":true},{"text":"izi istta kace kessides.","poem":2},{"lineBreak":true},{"text":"GODAY galatetto!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}