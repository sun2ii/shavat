"},{"type":"verse","number":5,"content":[{"text":"GODAWU! Taas laata xinxxoynne","poem":1},{"text":"qaaday nena;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne taas wadhdhida zaway","poem":1},{"text":"lo7o gidides;","poem":2},{"lineBreak":true},{"text":"keehippe lo7o xinxxoy","poem":2},{"lineBreak":true},{"text":"tana gakkides.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tana zoriza GODAA galatays;","poem":1},{"text":"omars ta wozinay","poem":2},{"lineBreak":true},{"text":"tana tamaarssees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tani ubbato GODAA sinththasays;","poem":1},{"text":"izi ta ushachchan diza gishshas","poem":2},{"lineBreak":true},{"text":"tani kokkorikke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Hessa gishshas","poem":1},{"text":"ta wozinay ufayettees;","poem":2},{"lineBreak":true},{"text":"ta shemppoyka woppu gees;","poem":2},{"lineBreak":true},{"text":"ta asateththayka hirgay baynda","poem":2},{"lineBreak":true},{"text":"shempi dees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne tana Si7oolen aggaka;","poem":1},{"text":"ne geeshshaza","poem":2},{"lineBreak":true},{"text":"wooqqana mala aggaka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Neni tana de7o oge bessaasa;","poem":1},{"text":"ne matan kumeththa ufayssi,","poem":2},{"lineBreak":true},{"text":"nees ushachchan","poem":2},{"lineBreak":true},{"text":"mernaa ufayssi dees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}