{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"PSA","translationId":"gmv_ltw","name":"Mazamure Maxaafa","commonName":"Mazamure Maxaafa","title":"Mazamure Maxaafa","order":19,"numberOfChapters":150,"sha256":"b41b54467d4ccd217c1e17f8b492e2d5b20ef4f2e46fb67681b6a866a5d7ea88","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gmv_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Kawoteththati ays dendizoo?","poem":1},{"text":"Qasse kawoteththay","poem":2},{"lineBreak":true},{"text":"ays iita ooththanaas maqettizee?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sa7a kawotinne daannati dendida;","poem":1},{"text":"istti GODAA bollanne","poem":2},{"lineBreak":true},{"text":"GODAY tiydayssa bolla","poem":2},{"lineBreak":true},{"text":"dendanaas issife duulatida.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Istti, «Ane nuni","poem":1},{"text":"istta sansalataa duuththoos;","poem":2},{"lineBreak":true},{"text":"istti nuna qachchizayssaka","poem":2},{"lineBreak":true},{"text":"kessi wora oloos» geettes.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Salon ba araata bolla uttidayssi","poem":1},{"text":"istta bolla miiccees;","poem":2},{"lineBreak":true},{"text":"Goday istta qidhees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Goday ba hanqon istta seerees;","poem":1},{"text":"ba wolqqama hanqon","poem":2},{"lineBreak":true},{"text":"istta daganththees.","poem":2}]},{"type":"verse","number":6,"content":["Goday, «Tani ta geeshsha zuma",{"text":"Xiyoone bolla ta kawoza","poem":2},{"lineBreak":true},{"text":"kawoththadis» gees.","poem":2}]},{"type":"verse","number":7,"content":["He kawoy, «Tani GODAA",{"text":"woga awajjana;","poem":2},{"lineBreak":true},{"text":"GODAY tana, ‹Neni ta naa;","poem":2},{"lineBreak":true},{"text":"tani nena hach yeladis.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Neni tana oychcha;","poem":1},{"text":"tani kawoteththa ubbaa","poem":2},{"lineBreak":true},{"text":"nees immana;","poem":2},{"lineBreak":true},{"text":"sa7a ubbay nees gidana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neni birata guufen","poem":1},{"text":"istta qoxereththana;","poem":2},{"lineBreak":true},{"text":"istta neni mana miishshi","poem":2},{"lineBreak":true},{"text":"meqqiza mala","poem":2},{"lineBreak":true},{"text":"menththereththana› gees» gides.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Hessa gishshas intteno","poem":1},{"text":"kawotoo akeekite;","poem":2},{"lineBreak":true},{"text":"ha sa7a haarizaytoo","poem":2},{"lineBreak":true},{"text":"intte naagettite!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"GODAAS yashshateththan ooththite;","poem":1},{"text":"izas kokkorsan haarettite.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"GODAY hanqettiin","poem":1},{"text":"ogen intte dhayontta mala","poem":2},{"lineBreak":true},{"text":"izas suure wozinan goynnite;","poem":2},{"lineBreak":true},{"text":"ays giikko iza hanqoy","poem":2},{"lineBreak":true},{"text":"eeson eexxi kezana.","poem":2},{"lineBreak":true},{"text":"Iza banttas zemppo","poem":2},{"lineBreak":true},{"text":"ooththizayti anjjettidayta.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}