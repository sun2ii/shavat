":"verse","number":5,"content":[{"text":"Ta morkketa sinththan","poem":1},{"text":"taas maadda giigsadasa;","poem":2},{"lineBreak":true},{"text":"ta hu7e zayten tiyadasa;","poem":2},{"lineBreak":true},{"text":"ta ushshi kunththa palahissadasa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne kiyateththinne ne maaroteththay","poem":1},{"text":"ta de7o layththa ubbaan","poem":2},{"lineBreak":true},{"text":"tana kaallana;","poem":2},{"lineBreak":true},{"text":"tani GODAA keeththan mernaas daana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}