ak":true},{"text":"tani GODAAN ammanettays.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tani GODAA issi miish oychchays;","poem":1},{"text":"hessika tani","poem":2},{"lineBreak":true},{"text":"ta de7o layth ubbaan","poem":2},{"lineBreak":true},{"text":"GODAA keeththan de7anaassa;","poem":2},{"lineBreak":true},{"text":"tani GODAA bonchcho","poem":2},{"lineBreak":true},{"text":"lo7oteththa be7anaassa;","poem":2},{"lineBreak":true},{"text":"iza Keeththankka","poem":2},{"lineBreak":true},{"text":"iza koyashe de7anaassa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hessa gishshas meto gallas","poem":1},{"text":"izi tana ba dizason genththana;","poem":2},{"lineBreak":true},{"text":"ba dunkaanen","poem":2},{"lineBreak":true},{"text":"tana qotti ashshana;","poem":2},{"lineBreak":true},{"text":"dhoqqa zaalla bollaka","poem":2},{"lineBreak":true},{"text":"izi tana essana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"He wode tana dooddida","poem":1},{"text":"ta morkketappe bollara","poem":2},{"lineBreak":true},{"text":"dhoqqu dhoqqu gaana;","poem":2},{"lineBreak":true},{"text":"tani iza Dunkaaneza sinththan","poem":2},{"lineBreak":true},{"text":"ufayssa yarsho yarshana;","poem":2},{"lineBreak":true},{"text":"tani GODAAS diixxananne","poem":2},{"lineBreak":true},{"text":"yexxana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Abeet GODAWU!","poem":1},{"text":"Tani nena xeygiza wode","poem":2},{"lineBreak":true},{"text":"neni taas koya;","poem":2},{"lineBreak":true},{"text":"taas qadhetta; tana siya.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Neni, «Ta sinththa","poem":1},{"text":"koyite» gida wode,","poem":2},{"lineBreak":true},{"text":"ta wozinay,","poem":2},{"lineBreak":true},{"text":"«Abeet GODAWU! Eeno;","poem":2},{"lineBreak":true},{"text":"tani ne sinththa koyana» gides.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abeet tana ashshiza ta X