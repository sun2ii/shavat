":4,"content":[{"text":"Ne isttas istta iitateththaa malanne","poem":1},{"text":"istta ooso mala imma;","poem":2},{"lineBreak":true},{"text":"isttas istta kushe","poem":2},{"lineBreak":true},{"text":"ooso mala zaara;","poem":2},{"lineBreak":true},{"text":"istti ooththida iita oosozas","poem":2},{"lineBreak":true},{"text":"halo kessa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Istti GODAA oosos wudu gontta","poem":1},{"text":"ixxida gishshas,","poem":2},{"lineBreak":true},{"text":"iza kushe oosotas soho","poem":2},{"lineBreak":true},{"text":"immontta aggida gishshas,","poem":2},{"lineBreak":true},{"text":"izi istta laallana;","poem":2},{"lineBreak":true},{"text":"zaaridikka keexxenna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ta woosa siyida gishshas,","poem":1},{"text":"GODAY galatetto.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"GODAY taas wolqqanne gondalle;","poem":1},{"text":"ta wozinay izan ammaneettes;","poem":2},{"lineBreak":true},{"text":"hessan tani maadettadis;","poem":2},{"lineBreak":true},{"text":"hessa gishshas","poem":2},{"lineBreak":true},{"text":"ta wozinay izan ufayettees;","poem":2},{"lineBreak":true},{"text":"tani iza yeththan sabbana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"GODAY ba deraas wolqqa;","poem":1},{"text":"izi ba tiyda kawoza","poem":2},{"lineBreak":true},{"text":"ashshiza miixa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"GODAWU! Ne deraa ashsha;","poem":1},{"text":"nees gidizayta anjja;","poem":2},{"lineBreak":true},{"text":"istta heenththanchchay","poem":2},{"lineBreak":true},{"text":"nena gida;","poem":2},{"lineBreak":true},{"text":"neni istta mernaaskka tookka.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/27.json","previousChapter