}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"GODAY tana naagiza gishshas,","poem":1},{"text":"tani ichchada dhiskayssinne","poem":2},{"lineBreak":true},{"text":"beegottays.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tani tana giddoththi uttida","poem":1},{"text":"cora morkketaska babbike.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Abeet GODAWU! Denda!","poem":1},{"text":"Abeet ta Xoossawu! Tana ashsha!","poem":2},{"lineBreak":true},{"text":"Neni ta morkketa","poem":2},{"lineBreak":true},{"text":"ubbaa banqila shoca;","poem":2},{"lineBreak":true},{"text":"iitata achchaaka menththa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Maadoy GODAASSA;","poem":1},{"text":"GODAWU ne anjjoy","poem":2},{"lineBreak":true},{"text":"ne deraa bolla gido.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}