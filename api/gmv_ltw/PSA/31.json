ththa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Neni taas zemppo gidiza gishshas,","poem":1},{"text":"istti taas waaxi woththida","poem":2},{"lineBreak":true},{"text":"narxafe tana ne naaga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abeet GODAWU tumu Xoossawu!","poem":1},{"text":"tani ta shemppo","poem":2},{"lineBreak":true},{"text":"ne kushen hadara immays;","poem":2},{"lineBreak":true},{"text":"neni tana wozza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Paththontta eeqatas","poem":1},{"text":"goynnizayta tani ixxays;","poem":2},{"lineBreak":true},{"text":"tani gidikko GODAAN ammanettays.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta meto neni be7ida gishshassinne","poem":1},{"text":"ta tuggaa neni erida gishshas","poem":2},{"lineBreak":true},{"text":"tani ne siiqon ufayettays.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Neni tana ta morkketas aaththa","poem":1},{"text":"aaththa immabeekka;","poem":2},{"lineBreak":true},{"text":"ta tohotakka","poem":2},{"lineBreak":true},{"text":"aaho sohon essadasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Abeet GODAWU!","poem":1},{"text":"Tani meton geladis;","poem":2},{"lineBreak":true},{"text":"taas qadhetta.","poem":2},{"lineBreak":true},{"text":"Tani daro mishettadis;","poem":2},{"lineBreak":true},{"text":"ta ayfey, ta ashoynne","poem":2},{"lineBreak":true},{"text":"ta shemppoy daaburdes.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta shemppoya waayen daaburadus;","poem":1},{"text":"ta layththayka ceecen wurides.","poem":2},{"lineBreak":true},{"text":"Meto daron","poem":2},{"lineBreak":true},{"text":"ta wolqqay cingides;","poem":2},{"lineBreak":true},{"text":"ta meqeththatikka","poem":2},{"lineBreak":true},{"text":"giddon seerida.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ta morkketa ubbaas","poem":1},{"text":"tani qidhe miish gidadis;","poem":2},{"lineBreak":true},{"text":"ta shoorotas miires attadis;","poem":2},{"lineBreak":true},{"text":"tana erizaytas kadhes gidadis;","poem":2},{"lineBreak":true},{"text":"ogen tana be7idaytikka","poem":2},{"lineBreak":true},{"text":"taappe baqateettes.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tani hayqqida asa mala dogettadis;","poem":1},{"text":"mooho oto mala gidadis.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tani daroti saasukettishin siyadis;","poem":1},{"text":"dagamay Ubbasora dees;","poem":2},{"lineBreak":true},{"text":"istti ta bolla genen duulateettes;","poem":2},{"lineBreak":true},{"text":"tana wodhanawukka","poem":2},{"lineBreak":true},{"text":"maqetteettes.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Gido attiin GODAWU!","poem":1},{"text":"Tani nenan ammanettada,","poem":2},{"lineBreak":true},{"text":"«Neni ta Xoossa» gays.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ta de7o layththay","poem":1},{"text":"ne kushenna;","poem":2},{"lineBreak":true},{"text":"tana gooddiza","poem":2},{"lineBreak":true},{"text":"ta morkketa kusheppe","poem":2},{"lineBreak":true},{"text":"ne tana ashsha.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ne aylleza bolla","poem":1},{"text":"ne sinththa poo7isa;","poem":2},{"lineBreak":true},{"text":"ne maaroteththan tana ashsha.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Abeet GODAWU!","poem":1},{"text":"Tani nena xeygays;","poem":2},{"lineBreak":true},{"text":"tana yeellasoppa;","poem":2},{"lineBreak":true},{"text":"iitati gidikko yeellatetto;","poem":2},{"lineBreak":true},{"text":"duge duufon gelidi sirphi getto.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Xilloza bolla otoron, kadheninne","poem":1},{"text":"xalateththan haasayza gishshas","poem":2},{"lineBreak":true},{"text":"wordanchchata doona duudisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Nenan zemppanaas","poem":1},{"text":"neekko shiiqidaytassinne","poem":2},{"lineBreak":true},{"text":"nees yayyizaytas","poem":2},{"lineBreak":true},{"text":"neni asaa sinththan isttas","poem":2},{"lineBreak":true},{"text":"immana gaada minjja woththida","poem":2},{"lineBreak":true},{"text":"kiyateththi ay mala daroo!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Neni istta ne keeththan genththada","poem":1},{"text":"asaa maqqofe ashshaasa;","poem":2},{"lineBreak":true},{"text":"neni istta ne dizason qottada","poem":2},{"lineBreak":true},{"text":"iita inxarsafe naagaasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tani morkkey dooddi oykkida","poem":1},{"text":"katamaa giddon diza wode","poem":2},{"lineBreak":true},{"text":"izi malalisiza ba maaroteth","poem":2},{"lineBreak":true},{"text":"tana bessida gishshas","poem":2},{"lineBreak":true},{"text":"GODAY galatetto.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Tani dagammada,","poem":1},{"text":"«Ne sinththafe kichchadis» gadis.","poem":2},{"lineBreak":true},{"text":"Gido attiin tana maaddana mala","poem":2},{"lineBreak":true},{"text":"nena ta xeygida wode","poem":2},{"lineBreak":true},{"text":"ta waasoza neni siyadasa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Intteno Xoossa asatoo!","poem":1},{"text":"GODAA siiqite.","poem":2},{"lineBreak":true},{"text":"GODAY izan ammanettizayta","poem":2},{"lineBreak":true},{"text":"naagees;","poem":2},{"lineBreak":true},{"text":"gido attiin otoranchchatas","poem":2},{"lineBreak":true},{"text":"isttas bessiza qixaate immees.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Intte hidota","poem":1},{"text":"GODAAN ooththidaytoo!","poem":2},{"lineBreak":true},{"text":"Beeggitenne minnite.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLin