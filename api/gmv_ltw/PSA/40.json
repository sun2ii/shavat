,"number":16,"content":[{"text":"Gido attiin nena koyza ubbati","poem":1},{"text":"nenan ufayetettonne","poem":2},{"lineBreak":true},{"text":"hashshu getto;","poem":2},{"lineBreak":true},{"text":"ne atoteththaa dosiza ubbati,","poem":2},{"lineBreak":true},{"text":"«GODAY gitato!» getto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Tani hiyeesanne metotanchcha;","poem":1},{"text":"Goday taas qoppees;","poem":2},{"lineBreak":true},{"text":"tana maaddizaynne","poem":2},{"lineBreak":true},{"text":"ashshizay nena;","poem":2},{"lineBreak":true},{"text":"abeet ta Xoossawu","poem":2},{"lineBreak":true},{"text":"tana eeson maadda.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}