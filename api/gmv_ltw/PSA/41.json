{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"PSA","translationId":"gmv_ltw","name":"Mazamure Maxaafa","commonName":"Mazamure Maxaafa","title":"Mazamure Maxaafa","order":19,"numberOfChapters":150,"sha256":"b41b54467d4ccd217c1e17f8b492e2d5b20ef4f2e46fb67681b6a866a5d7ea88","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gmv_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":41,"content":[{"type":"heading","content":["Dawiti Zammareta Kaabbos Yexxida Mazamure"]},{"type":"verse","number":1,"content":[{"text":"Hiyeesas qoppiza asi anjjettidayssa;","poem":1},{"text":"meto gallas GODAY iza ashshees.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"GODAY iza naagidi paxa woththees;","poem":1},{"text":"izikka biitta bolla anjjettana;","poem":2},{"lineBreak":true},{"text":"GODAY iza morkketas","poem":2},{"lineBreak":true},{"text":"iza aaththidi immenna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"GODAY izi hargettidi","poem":1},{"text":"hiixan dishin maaddees;","poem":2},{"lineBreak":true},{"text":"sakettinkka iza paththees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tani gidikko, «Abeet GODAWU!","poem":1},{"text":"tani nena qohida gishshas","poem":2},{"lineBreak":true},{"text":"tana maara;","poem":2},{"lineBreak":true},{"text":"hargefe tana paththa» gadis.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ta morkketi ta bolla","poem":1},{"text":"iita miish haasaydi,","poem":2},{"lineBreak":true},{"text":"«Izi awude hayqqandeeshaa?","poem":2},{"lineBreak":true},{"text":"Qasse iza sunththayka","poem":2},{"lineBreak":true},{"text":"awude dhayandeeshaa?» geettes.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tana beyanawu yiza oonikka","poem":1},{"text":"ba wozinan","poem":2},{"lineBreak":true},{"text":"iita miish suuththishe","poem":2},{"lineBreak":true},{"text":"qoodheppe qommon haasayees;","poem":2},{"lineBreak":true},{"text":"kare kezidikka zigirs punnees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tana ixxiza ubbati","poem":1},{"text":"zuppetidi ta bollan","poem":2},{"lineBreak":true},{"text":"saasuketteettes;","poem":2},{"lineBreak":true},{"text":"iita miishshi ta bolla","poem":2},{"lineBreak":true},{"text":"gakkana mala amotteettes.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"«Iza iita hargey oykkides;","poem":1},{"text":"izi he ichchidasoppe","poem":2},{"lineBreak":true},{"text":"mulekka dendenna» geettes.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Haray attiin tani ammanettiza","poem":1},{"text":"ta siiqo laggey,","poem":2},{"lineBreak":true},{"text":"tanara issi maaddafe miday","poem":2},{"lineBreak":true},{"text":"ta bolla toho denththides.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gido attiin abeet GODAWU!","poem":1},{"text":"Neni tana maara;","poem":2},{"lineBreak":true},{"text":"tani halo kessana mala","poem":2},{"lineBreak":true},{"text":"tana hargefe paththa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ta morkkey","poem":1},{"text":"tana xoononttayssan","poem":2},{"lineBreak":true},{"text":"ne tana dosizayssa","poem":2},{"lineBreak":true},{"text":"ta erays.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Neni tana","poem":1},{"text":"ta suureteththa gishshas maaddaasa;","poem":2},{"lineBreak":true},{"text":"ne sinththan tana","poem":2},{"lineBreak":true},{"text":"mernaas woththaasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"GODAA Isra7eele Xoossay","poem":1},{"text":"mernaappe mernaa","poem":2},{"lineBreak":true},{"text":"gakkanawu galatetto.","poem":2},{"text":"Amiin! Amiin!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}