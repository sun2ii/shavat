a ceecashe","poem":2},{"lineBreak":true},{"text":"ays de7oo?» gays.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta morkketi tana ubba wode,","poem":1},{"text":"«Ne Xoossay awan dizee?»","poem":2},{"lineBreak":true},{"text":"giidi yo7on tana caddeettes;","poem":2},{"lineBreak":true},{"text":"meqeththika menththi cayeettes.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Tani ays hidota qanxxazinaa?","poem":1},{"text":"Qasse ays ceecazinaa?","poem":2},{"lineBreak":true},{"text":"Tani Xoossan ammanettays;","poem":2},{"lineBreak":true},{"text":"tana ashshiza ta Xoossaa","poem":2},{"lineBreak":true},{"text":"ta buro galatana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}