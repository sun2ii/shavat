{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"PSA","translationId":"gmv_ltw","name":"Mazamure Maxaafa","commonName":"Mazamure Maxaafa","title":"Mazamure Maxaafa","order":19,"numberOfChapters":150,"sha256":"b41b54467d4ccd217c1e17f8b492e2d5b20ef4f2e46fb67681b6a866a5d7ea88","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gmv_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Abeet Xoossawu! Ne taas pirda;","poem":1},{"text":"Xoossa erontta kawoteththatara","poem":2},{"lineBreak":true},{"text":"ne ta gishshas mootetta;","poem":2},{"lineBreak":true},{"text":"Cimmiza asatappenne","poem":2},{"lineBreak":true},{"text":"iita asatappe tana ashsha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta Xoossawu! Taas ne mino miixa;","poem":1},{"text":"histtiin ne tana ays aggadii?","poem":2},{"lineBreak":true},{"text":"Ta morkketi tana qohishin","poem":2},{"lineBreak":true},{"text":"ta ceecashe ays de7oo?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne poo7onne ne tuma taas kiitta;","poem":1},{"text":"istti tana kaaleththetto;","poem":2},{"lineBreak":true},{"text":"pude geeshsha zuma bolla","poem":2},{"lineBreak":true},{"text":"ne dizaso tana gaththetto.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"He wode tani","poem":1},{"text":"tana ufayssiza Xoossako baana;","poem":2},{"lineBreak":true},{"text":"nees yarsho yarshizasoza baada","poem":2},{"lineBreak":true},{"text":"nees goynnana;","poem":2},{"lineBreak":true},{"text":"Abeet Godaa ta Xoossawu!","poem":2},{"lineBreak":true},{"text":"Tani diiththan nena sabbana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tani ays hidota qanxxazinaa?","poem":1},{"text":"Qasse ays ceecazinaa?","poem":2},{"lineBreak":true},{"text":"Tani Xoossan ammanettays;","poem":2},{"lineBreak":true},{"text":"tana ashshiza ta Xoossaa","poem":2},{"lineBreak":true},{"text":"ta buro galatana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}