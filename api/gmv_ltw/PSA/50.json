eBreak":true},{"text":"shiishshite» gees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xoossi barkka pirdiza","poem":1},{"text":"Xoossa gidida gishshas","poem":2},{"lineBreak":true},{"text":"saloti iza xilloteththa awajjeettes.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Ta asazoo ne siya!","poem":1},{"text":"Tani nees yootays;","poem":2},{"lineBreak":true},{"text":"Isra7eele asawu!","poem":2},{"lineBreak":true},{"text":"Tani ne bolla markkattays.","poem":2},{"lineBreak":true},{"text":"Tani Xoossay ne Xoossa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne yarsho gishshassinne","poem":1},{"text":"neni ubbato shiishshiza","poem":2},{"lineBreak":true},{"text":"xuugettiza yarsho gishshas","poem":2},{"lineBreak":true},{"text":"tani nena borikke.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hessa malakka ne dirsafe kormata,","poem":1},{"text":"woykko ne xarphphafe deyshata","poem":2},{"lineBreak":true},{"text":"ekkanawu koykke.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Woran diza do7a ubbati taassa;","poem":1},{"text":"shii zumata bollan diza","poem":2},{"lineBreak":true},{"text":"mehetikka tayta.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tani zumata bolla diza kafota","poem":1},{"text":"ubbaa erays;","poem":2},{"lineBreak":true},{"text":"demban diza medheteththati","poem":2},{"lineBreak":true},{"text":"ubbay tayta.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Salo gufanththon diza ubbay taassa;","poem":1},{"text":"hessa gishshas ta gafikkoka","poem":2},{"lineBreak":true},{"text":"nees yootikke.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tani kormata asho miikke;","poem":1},{"text":"Woykko deyshata suuth uyikke.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Xoossas galata yarsho shiishsha;","poem":1},{"text":"ne adina Ubbaafe Dhoqqa","poem":2},{"lineBreak":true},{"text":"Xoossas gaththa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Meto gallas","poem":1},{"text":"ne tana xeyga;","poem":2},{"lineBreak":true},{"text":"ta nena ashshana;","poem":2},{"lineBreak":true},{"text":"nekka tana bonchchana» gees.","poem":2}]},{"type":"verse","number":16,"content":["Gido attiin Xoossi nagaranchchas,",{"text":"«Ta woga neni","poem":1},{"text":"zaara zaarada biddanaas","poem":2},{"lineBreak":true},{"text":"woykko ta caaqo qaala","poem":2},{"lineBreak":true},{"text":"ne yootanaas","poem":2},{"lineBreak":true},{"text":"nees ay maatay dizee?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ne ta seera ixxaasa;","poem":1},{"text":"ta qaalatakka kadhaasa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Neni kayso be7ida wode","poem":1},{"text":"izara dabbotadasa;","poem":2},{"lineBreak":true},{"text":"laymatizayta maabarankka","poem":2},{"lineBreak":true},{"text":"zuppetaasa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Neni ne doona","poem":1},{"text":"iita haasayanaas doyadasa;","poem":2},{"lineBreak":true},{"text":"ne haasayza haasayay","poem":2},{"lineBreak":true},{"text":"wordo xalla.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Aadhdhooson aadhdhooson","poem":1},{"text":"ne ishaa zigiraasa;","poem":2},{"lineBreak":true},{"text":"ne aayi naa sunththika mooraasa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Neni hayssa ubbaa ooththiza wode","poem":1},{"text":"tani co7u gadis;","poem":2},{"lineBreak":true},{"text":"hessa gishshas neni tana","poem":2},{"lineBreak":true},{"text":"ne mala gaada qoppadasa;","poem":2},{"lineBreak":true},{"text":"gido attiin ha7i tani","poem":2},{"lineBreak":true},{"text":"nena walassays;","poem":2},{"lineBreak":true},{"text":"qasseka ta nena","poem":2},{"lineBreak":true},{"text":"qonccen seerays.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Intteno Xoossa dogizaytoo!","poem":1},{"text":"Hayssa akeekite;","poem":2},{"lineBreak":true},{"text":"intte ixxis giikko","poem":2},{"lineBreak":true},{"text":"tani inttena menththereththana;","poem":2},{"lineBreak":true},{"text":"he wode inttena oonikka","poem":2},{"lineBreak":true},{"text":"ashshenna.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Taas galata immiza asi","poem":1},{"text":"tana bonchchees.","poem":2},{"lineBreak":true},{"text":"Suure ogera biza as","poem":2},{"lineBreak":true},{"text":"tani atoteththaa bessana» gees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}