aleththon kumida","poem":1},{"text":"wordanchchazoo!","poem":2},{"lineBreak":true},{"text":"Neni as madunththiza","poem":2},{"lineBreak":true},{"text":"qaala siiqaasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Gido attiin Xoossi nena","poem":1},{"text":"mernaas dhayssana;","poem":2},{"lineBreak":true},{"text":"izi nena ne keeththafe","poem":2},{"lineBreak":true},{"text":"buuci kessana;","poem":2},{"lineBreak":true},{"text":"paxa dizayta giddofekka","poem":2},{"lineBreak":true},{"text":"dhoqalli diggana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xilloti hayssa be7idi yayyana;","poem":1},{"text":"istti iza bolla hizgi miiccana;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"«Xoossa baas zemppo","poem":1},{"text":"ooththonttaade,","poem":2},{"lineBreak":true},{"text":"ba dureteththa daron","poem":2},{"lineBreak":true},{"text":"ammanettizaade","poem":2},{"lineBreak":true},{"text":"ba iita ooson minnizaade","poem":2},{"lineBreak":true},{"text":"hayssa be7ite!» gaana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gido attiin aaciza","poem":1},{"text":"wogara miththa mala","poem":2},{"lineBreak":true},{"text":"tani Xoossa Keeththan aacays;","poem":2},{"lineBreak":true},{"text":"iza mernaa siiqon tani","poem":2},{"lineBreak":true},{"text":"meri mernaas ammanettays.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neni ooththida ubbaas","poem":1},{"text":"tani nena mernaas galatays;","poem":2},{"lineBreak":true},{"text":"ne lo7o gidida gishshas","poem":2},{"lineBreak":true},{"text":"ta ne sunththan hidota ooththays;","poem":2},{"lineBreak":true},{"text":"tani Xoossa deraa sinththan","poem":2},{"lineBreak":true},{"text":"ne kiyateththaa sabbana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PS