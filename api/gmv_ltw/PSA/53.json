awa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Xoossi, «Asi kath miza mala","poem":1},{"text":"ta deraa bonqqi mizayti,","poem":2},{"lineBreak":true},{"text":"Xoos woossi eronttayti,","poem":2},{"lineBreak":true},{"text":"heyti iita ooththizayti","poem":2},{"lineBreak":true},{"text":"yuushshi qoppettennee?» gees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xoossi ba asaa morkkizayta","poem":1},{"text":"meqeththaa laallana;","poem":2},{"lineBreak":true},{"text":"istti kase dagammi erontta","poem":2},{"lineBreak":true},{"text":"dagama dagammana.","poem":2},{"lineBreak":true},{"text":"Xoossi istta kadhida gishshas","poem":2},{"lineBreak":true},{"text":"istti yeellatana;","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Isra7eeles atoteththi","poem":1},{"text":"Xiyooneppe yidaakko!","poem":2},{"lineBreak":true},{"text":"Xoossi ba deraappe di7ettidayssa","poem":2},{"lineBreak":true},{"text":"zaariza wode","poem":2},{"lineBreak":true},{"text":"Yaaqoobe zareti ufayettana;","poem":2},{"lineBreak":true},{"text":"Isra7eele asay ufayettana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}