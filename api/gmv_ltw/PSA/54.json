etas","poem":2},{"lineBreak":true},{"text":"istta iitateththaa mala","poem":2},{"lineBreak":true},{"text":"isttas zaara.","poem":2},{"lineBreak":true},{"text":"Ne ammaneteththan","poem":2},{"lineBreak":true},{"text":"ne istta dhayssa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Abeet GODAWU!","poem":1},{"text":"Tani ta dosan nees yarshana;","poem":2},{"lineBreak":true},{"text":"nees bessiza gishshas","poem":2},{"lineBreak":true},{"text":"tani ne sunththaa galatana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ays giikko neni tana","poem":1},{"text":"ta meto ubbaafe ashshadasa;","poem":2},{"lineBreak":true},{"text":"ta morkketi kundishin","poem":2},{"lineBreak":true},{"text":"ta ayfen beyadis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}