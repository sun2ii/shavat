{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"PSA","translationId":"gmv_ltw","name":"Mazamure Maxaafa","commonName":"Mazamure Maxaafa","title":"Mazamure Maxaafa","order":19,"numberOfChapters":150,"sha256":"b41b54467d4ccd217c1e17f8b492e2d5b20ef4f2e46fb67681b6a866a5d7ea88","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gmv_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":57,"content":[{"type":"heading","content":["Dawiti Sa7oole sinththafe baqatidi gongolo giddon dishe zammareta kaabbos, «Dhayssofa» geetettiza diiththa giigson shiishshida woosa mazamure"]},{"type":"verse","number":1,"content":[{"text":"Abeet Xoossawu!","poem":1},{"text":"Ne taas qadhetta;","poem":2},{"lineBreak":true},{"text":"tana maara;","poem":2},{"lineBreak":true},{"text":"ta shemppoya nenan zemppadus;","poem":2},{"lineBreak":true},{"text":"bashshay aadhdhana gakkanaas","poem":2},{"lineBreak":true},{"text":"tani ne qefeta garsan qotettana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Izi ba halchcho mala taas poliza","poem":1},{"text":"Ubbaafe Dhoqqa","poem":2},{"lineBreak":true},{"text":"Xoossako waassays.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Xoossi saloppe maado kiittidi","poem":1},{"text":"tana ashshana;","poem":2},{"lineBreak":true},{"text":"tana yedhdhizayta kawushshana;","poem":2},{"lineBreak":true},{"text":"Xoossi ba mernaa siiqonne","poem":2},{"lineBreak":true},{"text":"ba tumateththaa taas kiittana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tani ta morkketa giddon,","poem":1},{"text":"as puuzidi miza gaammo","poem":2},{"lineBreak":true},{"text":"misatizayta giddon days.","poem":2},{"lineBreak":true},{"text":"Istta achchay tooranne","poem":2},{"lineBreak":true},{"text":"wondafe yiishshaa mala;","poem":2},{"lineBreak":true},{"text":"istta inxarsayka","poem":2},{"lineBreak":true},{"text":"qara mashsha mala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Abeet Xoossawu! Neni salotappe","poem":1},{"text":"bollara dhoqqu dhoqqu ga;","poem":2},{"lineBreak":true},{"text":"ne bonchchoy sa7a ubbaa kumo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Istti ta tohos woximade woththida;","poem":1},{"text":"ta asateththaa kuunissida;","poem":2},{"lineBreak":true},{"text":"istti ta ogen olla bookkida;","poem":2},{"lineBreak":true},{"text":"gido attiin he ollan","poem":2},{"lineBreak":true},{"text":"banttas kundida.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ta wozinay minni dees;","poem":1},{"text":"abeet Xoossawu!","poem":2},{"lineBreak":true},{"text":"Ta wozinay minnidi dees;","poem":2},{"lineBreak":true},{"text":"tani nees yexxananne","poem":2},{"lineBreak":true},{"text":"nena sabbana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ta shemppoyee birkka!","poem":1},{"text":"Diiththatinne maasinqoti","poem":2},{"lineBreak":true},{"text":"beeggite!","poem":2},{"lineBreak":true},{"text":"Tanikka wonttara dendana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Abeet Godawu, tani nena","poem":1},{"text":"asa ubbaa sinththan galatana;","poem":2},{"lineBreak":true},{"text":"qasse deraa giddon","poem":2},{"lineBreak":true},{"text":"ta nena yeththan sabbana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne mernaa siiqoy","poem":1},{"text":"pude salo gakkides;","poem":2},{"lineBreak":true},{"text":"ne tumateththayka","poem":2},{"lineBreak":true},{"text":"salo shaara gakkides.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Abeet Xoossawu!","poem":1},{"text":"Neni salotappe bollara","poem":2},{"lineBreak":true},{"text":"dhoqqu dhoqqu ga;","poem":2},{"lineBreak":true},{"text":"ne bonchchoy","poem":2},{"lineBreak":true},{"text":"sa7a ubbaa kumo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}