et GODAWU!","poem":1},{"text":"Neni simmada tana ashsha;","poem":2},{"lineBreak":true},{"text":"ne maaroteththa daron","poem":2},{"lineBreak":true},{"text":"tana kessa ekka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hayqqida asi ooninne","poem":1},{"text":"nena qoppenna;","poem":2},{"lineBreak":true},{"text":"duufon nena galatizay deenna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ta ceecen xalla daaburadis;","poem":1},{"text":"omars omars tani yeekkashe","poem":2},{"lineBreak":true},{"text":"ta hiixa caphisays;","poem":2},{"lineBreak":true},{"text":"ta borkoththaaka","poem":2},{"lineBreak":true},{"text":"ta afunththan musissays.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta ayfeti","poem":1},{"text":"daro afunxxida gishshas daaburda;","poem":2},{"lineBreak":true},{"text":"ta morkketa ubbaa gaasonkka","poem":2},{"lineBreak":true},{"text":"demo ixxida.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"GODAY tani yeekkiza yeeho","poem":1},{"text":"siyida gishshas,","poem":2},{"lineBreak":true},{"text":"intteno iita ooththiza ubbatoo!","poem":2},{"lineBreak":true},{"text":"Taappe haakkite.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"GODAY ta shoobeththaa be7ides;","poem":1},{"text":"ta woosaakka siyides.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta morkke ubbati","poem":1},{"text":"yeellatananne dagammana;","poem":2},{"lineBreak":true},{"text":"qoppontta kawuyidi guye simmana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}