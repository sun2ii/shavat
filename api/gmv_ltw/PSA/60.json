":"verse","number":5,"content":[{"text":"Neni siiqizayti attana mala","poem":1},{"text":"ne wolqqan nuna ashsha;","poem":2},{"lineBreak":true},{"text":"neni nuukko alla.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xoossi ba keeththan dishe,","poem":1},{"text":"«Tani xoonada Seekeeme","poem":2},{"lineBreak":true},{"text":"biitta shaakkana;","poem":2},{"lineBreak":true},{"text":"qasse Sukoote shoobbaa gishana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gala7aadeynne Minaasey tayta;","poem":1},{"text":"Efreemey taas hu7e qoobe;","poem":2},{"lineBreak":true},{"text":"Yuhuday taas kawoteththa guufe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mo7aabey ta meecettizaso;","poem":1},{"text":"Eedoomey taas caamma","poem":2},{"lineBreak":true},{"text":"woththizaso;","poem":2},{"lineBreak":true},{"text":"tani Filisxeeme","poem":2},{"lineBreak":true},{"text":"xoonada gererana» gides.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Gimbettida katamaakko","poem":1},{"text":"tana oonee efanay?","poem":2},{"lineBreak":true},{"text":"Eedoome gakkanaas","poem":2},{"lineBreak":true},{"text":"tana oonee kaaleththanay?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abeet Xoossawu!","poem":1},{"text":"Nuna aggiday nena gidikkii?","poem":2},{"lineBreak":true},{"text":"«Neni nu tooranchchatara","poem":2},{"lineBreak":true},{"text":"olas kezikke» gadasa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Asappe gidida maadoy hada;","poem":1},{"text":"hessa gishshas nu morkketa bolla","poem":2},{"lineBreak":true},{"text":"nuus xoono imma.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xoossa wolqqan nu morkketa","poem":1},{"text":"nuni xoonana;","poem":2},{"lineBreak":true},{"text":"izi nu morkketa yedhettana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/61.json","nextChapterAudi