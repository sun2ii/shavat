},{"lineBreak":true},{"text":"ooththoos» gida.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Istti issi wozina gididi","poem":1},{"text":"issife maqettida;","poem":2},{"lineBreak":true},{"text":"ne bolla dendanaas caaqettida.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isttika Eedoome asata,","poem":1},{"text":"Isma7eele asata,","poem":2},{"lineBreak":true},{"text":"Mo7aabe zareta, Aggaari zareta,","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gebaale asata, Amoone asata,","poem":2},{"lineBreak":true},{"text":"Amaaleeqe asata, Filisxeeme","poem":2},{"lineBreak":true},{"text":"asatanne Xiroose asata.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Asoore asati isttara","poem":1},{"text":"issifeteth medhdhida;","poem":2},{"lineBreak":true},{"text":"Looxe zaretaskka maado gidida.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Neni Midiyaame asata bolla,","poem":1},{"text":"Sisaaranne Yaabine bolla","poem":2},{"lineBreak":true},{"text":"Qisoone Shaafan ooththida","poem":2},{"lineBreak":true},{"text":"mala istta bolla ooththa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Istti En-Doore","poem":1},{"text":"geetettizason dhayda;","poem":2},{"lineBreak":true},{"text":"istta ahay moogettontta","poem":2},{"lineBreak":true},{"text":"biitta bolla wooqqides.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Oreebe bollanne","poem":1},{"text":"Za7eebe bolla ooththida mala","poem":2},{"lineBreak":true},{"text":"istta halaqata bolla ooththa;","poem":2},{"lineBreak":true},{"text":"Zebahanne Xalmuna","poem":2},{"lineBreak":true},{"text":"dhayssida mala","poem":2},{"lineBreak":true},{"text":"istta haarizaytakka neni dhayssa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Heyti, «Nuni Xoossa asaa biitta","poem":1},{"text":"nuus buzoththana» gidayta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Abeet ta Xoossawu!","poem":1},{"text":"Istta gudulla mala laalla;","poem":2},{"lineBreak":true},{"text":"carkoy efiza suulla mala ooththa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Xaragay wora miidi wursiza mala,","poem":1},{"text":"tama lacoy","poem":2},{"lineBreak":true},{"text":"zuma may7iza mala,","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"goten ne istta daganththa;","poem":2},{"lineBreak":true},{"text":"ne uushonkka istta yedeththa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Abeet GODAWU!","poem":1},{"text":"Asay ne sunth koyana mala","poem":2},{"lineBreak":true},{"text":"neni istta ayfeso yeella mayza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Istti mernaas yeellatetto;","poem":1},{"text":"hirgettonne kawuyi dhayetto.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ne sunththay GODAA","poem":1},{"text":"gididayssanne","poem":2},{"lineBreak":true},{"text":"sa7a ubbaa bolla neni xalla","poem":2},{"lineBreak":true},{"text":"Ubbaafe Dhoqqa Xoossa","poem":2},{"lineBreak":true},{"text":"gididayssa istti eretto.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}