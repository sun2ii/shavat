htha","poem":2},{"lineBreak":true},{"text":"wozinappe galatana;","poem":2},{"lineBreak":true},{"text":"Ne sunththaaka","poem":2},{"lineBreak":true},{"text":"mernaas bonchchana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ays giikko ne tana bessida","poem":1},{"text":"mernaa siiqoy keehi gita;","poem":2},{"lineBreak":true},{"text":"neni ta shemppoyo","poem":2},{"lineBreak":true},{"text":"duufoppe ashshadasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Abeet Xoossawu! Otoranchchati","poem":1},{"text":"ta bolla dendida;","poem":2},{"lineBreak":true},{"text":"tana wodhana koyidi","poem":2},{"lineBreak":true},{"text":"pangati duulateettes;","poem":2},{"lineBreak":true},{"text":"nena wudankka yeggibeettenna.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Gido attiin abeet Godawu!","poem":1},{"text":"Neni qadhettizaadenne","poem":2},{"lineBreak":true},{"text":"maariza Xoossa;","poem":2},{"lineBreak":true},{"text":"hanqettanaas gam7iza Xoossa;","poem":2},{"lineBreak":true},{"text":"ne siiqoynne ne ammaneteththay","poem":2},{"lineBreak":true},{"text":"keehi daro.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Taakko simmada taas qadhetta;","poem":1},{"text":"taas ne ayllezas wolqqa imma;","poem":2},{"lineBreak":true},{"text":"ne aylley naaza tana ashsha.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Abeet GODAWU!","poem":1},{"text":"ne tana maaddizayssanne","poem":2},{"lineBreak":true},{"text":"minththeththizayssa","poem":2},{"lineBreak":true},{"text":"tana ixxizayti be7idi","poem":2},{"lineBreak":true},{"text":"yeellatana mala","poem":2},{"lineBreak":true},{"text":"ne kiyateththa malata tana bessa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}