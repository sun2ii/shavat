 ahata giddon","poem":1},{"text":"olettida asa mala,","poem":2},{"lineBreak":true},{"text":"hayqqidi duufon moogettida","poem":2},{"lineBreak":true},{"text":"aha mala,","poem":2},{"lineBreak":true},{"text":"tani ubbaaka","poem":2},{"lineBreak":true},{"text":"neni dogida asa malanne","poem":2},{"lineBreak":true},{"text":"ne maadoppe duuxxida","poem":2},{"lineBreak":true},{"text":"asa mala gidadis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Neni tana ciimma ollan,","poem":1},{"text":"duge dhuma sohon yeggadasa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne hanqoy tana deexxees;","poem":1},{"text":"ne hanqoza dambalay","poem":2},{"lineBreak":true},{"text":"tana mulera mittides.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Neni ta laggeta taappe haassadasa;","poem":1},{"text":"istti tana shuunettana mala","poem":2},{"lineBreak":true},{"text":"ooththadasa;","poem":2},{"lineBreak":true},{"text":"tana giddoththida;","poem":2},{"lineBreak":true},{"text":"kessa ekkanawukka dandaykke.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abeet GODAWU!","poem":1},{"text":"Kayo gaason ta ayfeti doljumida;","poem":2},{"lineBreak":true},{"text":"Ubbaa gallas","poem":2},{"lineBreak":true},{"text":"tani neekko waassays;","poem":2},{"lineBreak":true},{"text":"ta kushetakka neekko miccays.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Neni hayqqidaytas","poem":1},{"text":"malalisiza miish ooththay?","poem":2},{"lineBreak":true},{"text":"Istti dendidi nena galatanee?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne mernaa siiqoy duufon","poem":1},{"text":"ne ammaneteththayka","poem":2},{"lineBreak":true},{"text":"bashshason yootettizee?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne malalisiza oosoy","poem":1},{"text":"dhuman erettizee?","poem":2},{"lineBreak":true},{"text":"Woykko ne xilloteththay","poem":2},{"lineBrea