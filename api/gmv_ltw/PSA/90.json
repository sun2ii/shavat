{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"PSA","translationId":"gmv_ltw","name":"Mazamure Maxaafa","commonName":"Mazamure Maxaafa","title":"Mazamure Maxaafa","order":19,"numberOfChapters":150,"sha256":"b41b54467d4ccd217c1e17f8b492e2d5b20ef4f2e46fb67681b6a866a5d7ea88","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gmv_ltw/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":90,"content":[{"type":"heading","content":["Xoossa As Musey Woossida Woosa"]},{"type":"verse","number":1,"content":[{"text":"Godawu! Neni nuus","poem":1},{"text":"yeletappe yeleta","poem":2},{"lineBreak":true},{"text":"gakkanaas shiiqi attizaso gidadasa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Zumati medhettanaappe kase,","poem":1},{"text":"woykko neni sa7a","poem":2},{"lineBreak":true},{"text":"ooththanaappe kase","poem":2},{"lineBreak":true},{"text":"mernaappe mernaa gakkanaasi","poem":2},{"lineBreak":true},{"text":"neni Xoossa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Neni asa nayta,","poem":1},{"text":"«Asa naytoo!","poem":2},{"lineBreak":true},{"text":"Guye biittan simmite»","poem":2},{"lineBreak":true},{"text":"gaada istti medhettida biittan","poem":2},{"lineBreak":true},{"text":"guye zaaraasa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Shii layththi nees aadhdhida","poem":1},{"text":"issi gallassa mala;","poem":2},{"lineBreak":true},{"text":"woykko omarsafe issi saate mala.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"As qoppontta efiza di7o mala","poem":1},{"text":"ne efishin,","poem":2},{"lineBreak":true},{"text":"istti agumo mala aadhdhana;","poem":2},{"lineBreak":true},{"text":"maalado maalado","poem":2},{"lineBreak":true},{"text":"mokkiza maata mala cilileettes.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Maatay maalado diccidi ciiyees;","poem":1},{"text":"omarsa wode gidikko","poem":2},{"lineBreak":true},{"text":"shullidi melees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nuni ne qanggeththan wuridos;","poem":1},{"text":"ne hanqo suulen dagammidos.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Neni nu iita ooso","poem":1},{"text":"ne sinththan woththadasa;","poem":2},{"lineBreak":true},{"text":"qasse nu genththida nagara","poem":2},{"lineBreak":true},{"text":"ne sinththa poo7okko","poem":2},{"lineBreak":true},{"text":"aaththadasa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nu wode ubbay","poem":1},{"text":"ne hanqon aadhdhides;","poem":2},{"lineBreak":true},{"text":"nu layththaaka oolen wursoos.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nu daana layththay","poem":1},{"text":"laappun tamma;","poem":2},{"lineBreak":true},{"text":"dares giikko osppun tamma;","poem":2},{"lineBreak":true},{"text":"heytikka metoninne","poem":2},{"lineBreak":true},{"text":"ceecen kumida;","poem":2},{"lineBreak":true},{"text":"nu layththay eeson aadhdhees;","poem":2},{"lineBreak":true},{"text":"nunikka eeson baana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ne hanqoza wolqqa oonee erizay?","poem":1},{"text":"ne hanqo seelay yashshees.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nu layththa maarara","poem":1},{"text":"nu go7ettana mala","poem":2},{"lineBreak":true},{"text":"nuna aadho erateth tamaarsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Abeet GODAWU!","poem":1},{"text":"Ne hanqoy","poem":2},{"lineBreak":true},{"text":"awude gakkana gam7anee?","poem":2},{"lineBreak":true},{"text":"Simma! Ne aylletas qadhetta!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nu layththa ubbaan","poem":1},{"text":"nuni ufayettana malanne","poem":2},{"lineBreak":true},{"text":"yexxana mala maalado maalado","poem":2},{"lineBreak":true},{"text":"ne siiqon nuna kalssa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Neni nuna metoththida","poem":1},{"text":"gallassata keenanne","poem":2},{"lineBreak":true},{"text":"nuni tugga be7ida layththata","poem":2},{"lineBreak":true},{"text":"likke nuna ufayssa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nuus ne aylletas","poem":1},{"text":"ne oosoy qoncco;","poem":2},{"lineBreak":true},{"text":"ne bonchchoy nu naytas beetto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Abeet GODAWU! Nu Xoossawu!","poem":1},{"text":"Ne kiyateththi nunara gido;","poem":2},{"lineBreak":true},{"text":"nu ooththiza ubbaa","poem":2},{"lineBreak":true},{"text":"nuus injjesa; ero!","poem":2},{"lineBreak":true},{"text":"Nu ooththiza ubbaa nuus injjesa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}