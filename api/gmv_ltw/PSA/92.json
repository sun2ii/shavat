poem":2},{"lineBreak":true},{"text":"tani ufayssan yexxays.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Abeet GODAWU!","poem":1},{"text":"Ne oosoy ay keena gitaa!","poem":2},{"lineBreak":true},{"text":"Ne qofaykka ay keena ciimmaa!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hessa eeya asi eranawu dandayenna;","poem":1},{"text":"damma asikka","poem":2},{"lineBreak":true},{"text":"akeekanawu dandayenna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iitati maata mala diccikokka,","poem":1},{"text":"gene ooththiza ubbati ciiykkoka","poem":2},{"lineBreak":true},{"text":"istti mernaas dhayana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gido attiin abeet GODAWU!","poem":1},{"text":"Neni mernaas ubbaafe dhoqqa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Abeet GODAWU!","poem":1},{"text":"Ne morkketi dhayana;","poem":2},{"lineBreak":true},{"text":"iita ooththiza ubbati","poem":2},{"lineBreak":true},{"text":"piski gaanayssa nu eroos.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta kaceza menththa","poem":1},{"text":"kace mala dhoqqisadasa;","poem":2},{"lineBreak":true},{"text":"lo7o zaytenkka tana tiyadasa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ta morkketi xoonettidayssa","poem":1},{"text":"ta ayfen be7adis;","poem":2},{"lineBreak":true},{"text":"ta baalgaarata kundeth","poem":2},{"lineBreak":true},{"text":"ta ayfen be7adis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Xilloti zamba mala daayana;","poem":1},{"text":"qasse Libaanoose","poem":2},{"lineBreak":true},{"text":"xiidda mala diccana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Istti GODAA keeththan tokettida;","poem":1},{"text":"istti Xoossa Keeththa","poem":2},{"lineBreak":true},{"text":"zago gakkanaas daayana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Istti ceeggidikka ayfana;","poem":1},{"text":"istti ubba wode cililida malanne","poem":2},{"lineBreak":true},{"text":"minnida mala daana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Istti, «GODAY likke;","poem":1},{"text":"izi taas wogga zaalla;","poem":2},{"lineBreak":true},{"text":"iza bolla wosoy deenna» gaana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}