nt":[{"text":"Haa yiite!","poem":1},{"text":"Hokkidi ane izas goynnoos;","poem":2},{"lineBreak":true},{"text":"nuna medhdhida GODAA","poem":2},{"lineBreak":true},{"text":"sinththan gulbatoos.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Izi nu Xoossa;","poem":1},{"text":"Nuni iza qooron heemettizayta;","poem":2},{"lineBreak":true},{"text":"nuni izas dorsa wudeta.","poem":2},{"lineBreak":true},{"text":"GODAY inttena gizayssa hach siyite!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"«Kase intte aawati","poem":1},{"text":"Maasaninne Mariiban","poem":2},{"lineBreak":true},{"text":"ooththoyssaththo","poem":2},{"lineBreak":true},{"text":"intte wozina muumisopite.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Istti ta ooso be7idikka","poem":1},{"text":"tanara eqettidanne tana paaccida.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"He yeletaa bolla tani","poem":1},{"text":"oyddu tammu layth hanqettadis;","poem":2},{"lineBreak":true},{"text":"tanikka, ‹Istti ubba wode","poem":2},{"lineBreak":true},{"text":"bantta wozinan baliza asa;","poem":2},{"lineBreak":true},{"text":"istti ta oge eribeettenna› gadis.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hessa gishshas tani,","poem":1},{"text":"‹Istti ta shemposo","poem":2},{"lineBreak":true},{"text":"mulekka gelettenna›","poem":2},{"lineBreak":true},{"text":"gaada hanqetta caaqqadis.»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}