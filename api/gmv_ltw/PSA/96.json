5,"content":[{"text":"Dere asay goynniza xoossati","poem":1},{"text":"ubbay eeqa xoossata;","poem":2},{"lineBreak":true},{"text":"gido attiin GODAY","poem":2},{"lineBreak":true},{"text":"salota medhdhida Xoossa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bonchchoynne teemay","poem":1},{"text":"iza yuushon dees;","poem":2},{"lineBreak":true},{"text":"minoteththaynne puulay","poem":2},{"lineBreak":true},{"text":"iza Keeththan dees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Intteno biitta bolla diza","poem":1},{"text":"dere ubbatoo!","poem":2},{"lineBreak":true},{"text":"GODAA bonchcho gishshassinne","poem":2},{"lineBreak":true},{"text":"iza wolqqa gishshas galatite.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iza sunththas bessiza bonchcho","poem":1},{"text":"GODAAS immite;","poem":2},{"lineBreak":true},{"text":"Yarsho ekkidi iza Keeththa zago gelite.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iza geeshshateththa puulan GODAAS goynnite;","poem":1},{"text":"biittan de7iza as ubbay","poem":2},{"lineBreak":true},{"text":"iza sinththan kokkorite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kawoteththata giddon,","poem":1},{"text":"«GODAY kawotides!","poem":2},{"lineBreak":true},{"text":"Sa7ay minni eqqides;","poem":2},{"lineBreak":true},{"text":"mulekka qaaxxenna;","poem":2},{"lineBreak":true},{"text":"izi as ubbaas","poem":2},{"lineBreak":true},{"text":"issi gina pirdana» giite.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Saloynne sa7ay ufayetetto!","poem":1},{"text":"abbaynne iza giddon diza","poem":2},{"lineBreak":true},{"text":"ubbati guummetto!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Goshsha gadeynne iza bolla diza","poem":1},{"text":"ubbay ufayetto!","poem":2},{"lineBreak":true},{"text":"Woran diza mith ubbay","poem":2},{"lineBreak":true},{"text":"iza sinththan ufayssan yexxana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ays giikko GODAY yaana;","poem":1},{"text":"izi sa7a bollan pirdanaas yaana;","poem":2},{"lineBreak":true},{"text":"izi ha sa7a bolla xilloteththan,","poem":2},{"lineBreak":true},{"text":"asa bollaka","poem":2},{"lineBreak":true},{"text":"tumateththan pirdana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}