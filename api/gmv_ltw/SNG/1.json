m":2},{"lineBreak":true},{"text":"ufayettidonii!","poem":2},{"lineBreak":true},{"text":"Nuni iza siiqo","poem":2},{"lineBreak":true},{"text":"woyne ushshafekka","poem":2},{"lineBreak":true},{"text":"aaththidi nashshoos.","poem":2},{"lineBreak":true},{"text":"Tumukka maccassay ubbay nena","poem":2},{"lineBreak":true},{"text":"siiqanaas bessees» gida.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"«Intteno Yerusalaame","poem":1},{"text":"maccassatoo, siyite!","poem":2},{"lineBreak":true},{"text":"Tani kareth gidikkoka mala lo7o.","poem":2},{"lineBreak":true},{"text":"Ta kareththateththay","poem":2},{"lineBreak":true},{"text":"Qeedaare dunkaane mala;","poem":2},{"lineBreak":true},{"text":"gido attiin ta medhay","poem":2},{"lineBreak":true},{"text":"kawo Solomoone keeththa","poem":2},{"lineBreak":true},{"text":"magalashata mala.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ta medha kareththiday awa seela;","poem":1},{"text":"tani kareth gidida gishshas","poem":2},{"lineBreak":true},{"text":"tana kadhopite.","poem":2},{"lineBreak":true},{"text":"Ta aayi naa ishati","poem":2},{"lineBreak":true},{"text":"tanara ooyettidi","poem":2},{"lineBreak":true},{"text":"tana woyne atakilte","poem":2},{"lineBreak":true},{"text":"naaganaas woththida;","poem":2},{"lineBreak":true},{"text":"hessa gishshas tani tayssa","poem":2},{"lineBreak":true},{"text":"naagabeekke.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta siiqozoo! Ane taas yoota;","poem":1},{"text":"ne dorsa wude heemmizay awanee?","poem":2},{"lineBreak":true},{"text":"Gallas awappe ne istta","poem":2},{"lineBreak":true},{"text":"guurissizay awanee?","poem":2},{"lineBreak":true},{"text":"Nena demmanaas","poem":2},{"lineBreak":true},{"text":"ne laggeta wude kaallashe","poem":2},{"lineBreak":true},{"text":"ays coo toylattiza","poem":2},{"lineBreak":true},{"text":"maccassa mala gidoo?» gadus.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"«Haa macca ubbaafe aadhdha","poem":1},{"text":"lo7iza malanchchayee!","poem":2},{"lineBreak":true},{"text":"Ta dizaso erontta aggiko","poem":2},{"lineBreak":true},{"text":"dorsati bida geedo kaallada ya;","poem":2},{"lineBreak":true},{"text":"ne deysha laaqqatakka","poem":2},{"lineBreak":true},{"text":"heenththanchchata dunkaane","poem":2},{"lineBreak":true},{"text":"matan heemma.»","poem":2}]},{"type":"verse","number":9,"content":[{"text":"«Ta godee! Gibxe kawos","poem":1},{"text":"para-gaare goochchiza","poem":2},{"lineBreak":true},{"text":"parata giddon diza","poem":2},{"lineBreak":true},{"text":"macca paray mala lo7aasa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne shagalasoy lozhzhu gides;","poem":1},{"text":"ne qoodhey inqqu geetettiza","poem":2},{"lineBreak":true},{"text":"seelon alleqettides.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nuni nees biran alleqettida","poem":1},{"text":"worqqa geexe oosisana» gides.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"«Kawoy maaddan utti dishin","poem":1},{"text":"ta shitto sawoy keeththa giddo","poem":2},{"lineBreak":true},{"text":"ubbaan tunnu gides.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ta siiqozi ta dhanththata","poem":1},{"text":"giddon diza","poem":2},{"lineBreak":true},{"text":"sawiza karbbe xuntte mala.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ta siiqozi En-Gaade geetettiza","poem":1},{"text":"woyne tokkiza gaden mokkida","poem":2},{"lineBreak":true},{"text":"bazzo ciishsha mala» gadus.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"«Ta godee! Neni ay mala lo7ay!","poem":1},{"text":"Neni ay mala lo7ay!","poem":2},{"lineBreak":true},{"text":"Ne ayfeti haraphphe mala","poem":2},{"lineBreak":true},{"text":"lo7eettes» gides.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"«Ta siiqozoo,","poem":1},{"text":"nenikka ay mala lo7ay!","poem":2},{"lineBreak":true},{"text":"Ne keeha lo7aasa;","poem":2},{"lineBreak":true},{"text":"nu hiiththay cilila maata mala","poem":2},{"lineBreak":true},{"text":"ufayssees» gadus.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"«Nu keeththa tuussi","poem":1},{"text":"Libaanoose ziga;","poem":2},{"lineBreak":true},{"text":"kaaraykka","poem":2},{"lineBreak":true},{"text":"xiiddan oosettides» gides.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}