ththides;","poem":2},{"lineBreak":true},{"text":"ba siiqo ta bolla bandira mala","poem":2},{"lineBreak":true},{"text":"dhoqqu dhoqqu ooththides.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tani iza siiqon oykettada hargadis;","poem":1},{"text":"hessa gishshas tana zabibe ayfe","poem":2},{"lineBreak":true},{"text":"mizidi gazidissite;","poem":2},{"lineBreak":true},{"text":"appile mizidi tana beegoththite.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ba hadirsa kushe bolla","poem":1},{"text":"tana borkotissides;","poem":2},{"lineBreak":true},{"text":"ba ushachcha kushen","poem":2},{"lineBreak":true},{"text":"tana idimmides.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Intteno Yerusalaame","poem":1},{"text":"yelaga maccassatoo!","poem":2},{"lineBreak":true},{"text":"siiqoy baas dosidi","poem":2},{"lineBreak":true},{"text":"dendana gakkanaas","poem":2},{"lineBreak":true},{"text":"iza intte beegoththontta mala,","poem":2},{"lineBreak":true},{"text":"tani inttena genessataninne","poem":2},{"lineBreak":true},{"text":"bazzo wushan amatays.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Be7ite! Ta siiqoza cenggurssi","poem":1},{"text":"zumata bollara pirishe,","poem":2},{"lineBreak":true},{"text":"zumbullata bollara xongettishe","poem":2},{"lineBreak":true},{"text":"yizayssi siyettees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ta siiqozi Wusha laaqqa","poem":1},{"text":"woykko genessa","poem":2},{"lineBreak":true},{"text":"laaqqa misatees.","poem":2},{"lineBreak":true},{"text":"Be7ite! Izi nu keeththa","poem":2},{"lineBreak":true},{"text":"daaranchchan eqqides;","poem":2},{"lineBreak":true},{"text":"maskootera soo xeellees;","poem":2},{"lineBreak":true},{"text":"magalasha xoo7era","poem":2},{"lineBreak":true},{"text":"xuulungi xeellees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta siiqozi tana,","poem":1},{"text":"‹Ta godee, denda!","poem":2},{"lineBreak":true},{"text":"Ta lo7oyee! Haa ya!","poem":2},{"lineBreak":true},{"text":"Ane issife boos.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Beya, balgoy aadhdhides;","poem":1},{"text":"iraykka aggides.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ubbason ciishshi ciiyides;","poem":1},{"text":"mazamure yexxiza","poem":2},{"lineBreak":true},{"text":"aginaykka gakkides;","poem":2},{"lineBreak":true},{"text":"haraphphe yeththika","poem":2},{"lineBreak":true},{"text":"nu biittan siyettees.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Balasey ayfe imo doommides;","poem":1},{"text":"woyney ciiyides;","poem":2},{"lineBreak":true},{"text":"iza ciishsha sawoy","poem":2},{"lineBreak":true},{"text":"ubbason tunnu gees.","poem":2},{"lineBreak":true},{"text":"Hessa gishshas ta godee, Denda;","poem":2},{"lineBreak":true},{"text":"ta lo7oyee! Haa ya;","poem":2},{"lineBreak":true},{"text":"ane issife boos› gees» gadus.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"«Neni aafo doonan","poem":1},{"text":"zaalla za7a giddon diza","poem":2},{"lineBreak":true},{"text":"haraphphey mala;","poem":2},{"lineBreak":true},{"text":"ane issito ne ayfeso","poem":2},{"lineBreak":true},{"text":"tana bessa;","poem":2},{"lineBreak":true},{"text":"ne qaala cenggurssikka","poem":2},{"lineBreak":true},{"text":"tana sissa.","poem":2},{"lineBreak":true},{"text":"Ays giikko ne cenggurssay","poem":2},{"lineBreak":true},{"text":"tana ufayssees;","poem":2},{"lineBreak":true},{"text":"ne ayfesoykka","poem":2},{"lineBreak":true},{"text":"tana lo7ees» gides.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nu woyne atakiltey ciiyides;","poem":1},{"text":"hessa gishshas nu woyne atakilte","poem":2},{"lineBreak":true},{"text":"giddo moorontta mala","poem":2},{"lineBreak":true},{"text":"worakanatanne istta butulata","poem":2},{"lineBreak":true},{"text":"woximaden oykkite.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"«Ta siiqozi taassa;","poem":1},{"text":"