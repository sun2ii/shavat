":"gidida mishirayee!","poem":2},{"lineBreak":true},{"text":"Nenan wosoy baynda","poem":2},{"lineBreak":true},{"text":"ta haraphpheyee!","poem":2},{"lineBreak":true},{"text":"Nena shoobbays taas kareza doya;","poem":2},{"lineBreak":true},{"text":"ta hu7ey kenchchon wooqqides.","poem":2},{"lineBreak":true},{"text":"Ta binanaykka omarsa puusen","poem":2},{"lineBreak":true},{"text":"musides› gishin siyadis.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tani ta may7o kessadis;","poem":1},{"text":"histtiin zaara may7oo?","poem":2},{"lineBreak":true},{"text":"Ta tohokka meecettadis;","poem":2},{"lineBreak":true},{"text":"qasse zaarada urqqasoo?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ta siiqozi penge xoo7era","poem":1},{"text":"kushe yeddides;","poem":2},{"lineBreak":true},{"text":"histtiin taas maracen","poem":2},{"lineBreak":true},{"text":"pol7u gides.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hessafe guye ta siiqozas","poem":1},{"text":"kare doyanaas dendadis;","poem":2},{"lineBreak":true},{"text":"kareza doyana ta oykkishin","poem":2},{"lineBreak":true},{"text":"ta kusheppe karbbey xokettides;","poem":2},{"lineBreak":true},{"text":"ta biradhdhetappeka","poem":2},{"lineBreak":true},{"text":"shittoy goggides.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ta kareza doyshin ta siiqozi","poem":1},{"text":"simmidi bichchides;","poem":2},{"lineBreak":true},{"text":"iza qaala cenggurssa siyanaas","poem":2},{"lineBreak":true},{"text":"keeha amottadis.","poem":2},{"lineBreak":true},{"text":"Minththadakka koyadis;","poem":2},{"lineBreak":true},{"text":"gido attiin demmanaas","poem":2},{"lineBreak":true},{"text":"dandayabeekke;","poem":2},{"lineBreak":true},{"text":"Xeygadis shin","poem":2},{"lineBreak":true},{"text":"izi taas koyibeenna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Katama naagizayti tana demmi","poem":1},{"text":"wadhdhidi madunththida;","poem":2},{"lineBreak":true},{"text":"katama gimbe naagizayti","poem":2},{"lineBreak":true},{"text":"ta may7ida seelo may7oza","poem":2},{"lineBreak":true},{"text":"qaari ekkida.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Intteno Yerusalaame geela7otoo!","poem":1},{"text":"Intte ta siiqoza","poem":2},{"lineBreak":true},{"text":"demmidaa gidikko","poem":2},{"lineBreak":true},{"text":"tani iza siiqoppe dendidayssan","poem":2},{"lineBreak":true},{"text":"hargidayssa hadara","poem":2},{"lineBreak":true},{"text":"izas yootite» gadus.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"«Hanne maccassa","poem":1},{"text":"ubbaafe aadho lo7oyee!","poem":2},{"lineBreak":true},{"text":"Tumu ne siiqo laggezi","poem":2},{"lineBreak":true},{"text":"haratappe dummatizee?","poem":2},{"lineBreak":true},{"text":"Neni hayssa mala","poem":2},{"lineBreak":true},{"text":"nuna hadara gizay","poem":2},{"lineBreak":true},{"text":"izi haratappe waaninee?» gida.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"«Ta siiqoy daro lo7onne mino;","poem":1},{"text":"10,000 attumasa garsan","poem":2},{"lineBreak":true},{"text":"iza malay deenna.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Iza hu7ey geeshsha","poem":1},{"text":"worqqa misatees;","poem":2},{"lineBreak":true},{"text":"iza binanaykka olossinne","poem":2},{"lineBreak":true},{"text":"dum7a kareth misatees.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Iza ayfeti","poem":1},{"text":"shaafa lanqen diza","poem":2},{"lineBreak":true},{"text":"haraphpheta malanne","poem":2},{"lineBreak":true},{"text":"maaththan meecettida","poem":2},{"lineBreak":true},{"text":"inqquta mala.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Iza shagalati mal7iza","poem":1},{"text":"sawo maatata mala;","poem":2},{"lineBreak":true},{"text":"dumma dumma","poem":2},{"lineBreak":true},{"text":"qimameti tokettida","poem":2},{"lineBreak":true},{"text":"atakilteso misateettes;","poem":2},{"lineBreak":true},{"text":"iza metershati karb