{"translation":{"id":"gmv_ltw","name":"Geeshsha Mexaafa","website":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gmvl","licenseNotes":null,"shortName":"LTW","englishName":"Gamo Bible (Latin)","language":"gmv","textDirection":"ltr","sha256":"c0e5f6002129bb9f294a2ace8cce9a960f46adebc2e7333534d36da6308cd805","availableFormats":["json"],"listOfBooksApiLink":"/api/gmv_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30906,"languageName":"Gamo","languageEnglishName":"Gamo"},"book":{"id":"ZEC","translationId":"gmv_ltw","name":"Zakaraasa Tinbite","commonName":"Zakaraasa Tinbite","title":"Zakaraasa Tinbite","order":38,"numberOfChapters":14,"sha256":"1d0169b2d21e98f404597a715fd19ca31fada24c9fa9afd197d0efe62b9153b3","firstChapterNumber":1,"firstChapterApiLink":"/api/gmv_ltw/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gmv_ltw/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":13,"content":[{"type":"heading","content":["Nagarappe Geeyeth"]},{"type":"verse","number":1,"content":["Ubbaafe Wolqqama GODAY, «He gallas Dawite keeththa asanne Yerusalaamen diza asaa nagarappenne tunateththafe geeshshanaas pulttoy pulttana."]},{"type":"verse","number":2,"content":["«Tani he wode biittafe eeqa xoossata sunth dhayssana; hessafe nam7anththo istti qofettettenna; istta nabetanne tuna ayanata biittay bollafe ta diggana."]},{"type":"verse","number":3,"content":["Oonikka tani nabe giikko izaade yelida aawaynne aayeya iza ne GODAA sunththan wordo haasayda gishshas nees hayqoy bessees getto; izi tinbite haasayshin iza yelidayti iza caddetto."]},{"type":"verse","number":4,"content":["He wode wordo haasaydaadey oonikka ba haasayda wordo tinbiten yeellatana; baleththanaas iskera diza nabeta may7o may7enna."]},{"type":"verse","number":5,"content":["Izikka, ‹Ta gooshsha asa attiin nabe gidikke; ta naateteththafe doommada hanno gakkanaas goshshanchcha› gaana."]},{"type":"verse","number":6,"content":["Issi asi, ‹Hessi ne bolla ay madunththee?› gi oychchiko izi, ‹Ta hayssa ta laggetason dashe madunxadis› gides."]},{"type":"heading","content":["Heenththanchchay Shocettiin Iza Dorsata Laaleteth"]},{"type":"verse","number":7,"content":["«Ubbaafe Wolqqama GODAY,",{"text":"‹Mashsha! Ta heenththanchcha","poem":2},{"lineBreak":true},{"text":"ta daro dosizayssa bolla beegga!","poem":2},{"lineBreak":true},{"text":"Heemmizayssa shoca;","poem":2},{"lineBreak":true},{"text":"dorsatikka laalettana;","poem":2},{"lineBreak":true},{"text":"tanikka ta qese guuththata bolla","poem":2},{"lineBreak":true},{"text":"denththana› » gees.","poem":2}]},{"type":"verse","number":8,"content":["GODAY, «Biitta ubbaan diza",{"text":"heedzdzu kushe asaappe","poem":2},{"lineBreak":true},{"text":"nam7u kushey dhayana;","poem":2},{"lineBreak":true},{"text":"issi kushe asi attana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"He attida issi kushe asaa","poem":1},{"text":"ta gede taman yeggana;","poem":2},{"lineBreak":true},{"text":"bira taman geeshshiza mala","poem":2},{"lineBreak":true},{"text":"ta geeshshana;","poem":2},{"lineBreak":true},{"text":"worqqa malakka paaccana;","poem":2},{"lineBreak":true},{"text":"istti ta sunth xeygana;","poem":2},{"lineBreak":true},{"text":"tanikka isttas koyana;","poem":2},{"lineBreak":true},{"text":"ta isttas, ‹Ta dereta› gaana;","poem":2},{"lineBreak":true},{"text":"isttika, ‹Nu GODAA›","poem":2},{"lineBreak":true},{"text":"gaana» gides.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/ZEC/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/ZEC/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/ZEC/12.json","previousChapterAudioLinks":{},"numberOfVerses":9}