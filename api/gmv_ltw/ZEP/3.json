!","poem":2},{"lineBreak":true},{"text":"Hanne Yerusalaame nayee!","poem":2},{"lineBreak":true},{"text":"Kumeththa wozinappe ufayetta!","poem":2},{"lineBreak":true},{"text":"Ufayettashe hashshu ga!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"GODAY ne bolla","poem":1},{"text":"yiza qixaateza diggides;","poem":2},{"lineBreak":true},{"text":"ne morkketakka neeppe zaarides.","poem":2},{"lineBreak":true},{"text":"GODAY Isra7eele kawoy","poem":2},{"lineBreak":true},{"text":"nenara dees;","poem":2},{"lineBreak":true},{"text":"hayssafe guye","poem":2},{"lineBreak":true},{"text":"ay iitasikka babbaka.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"He wode asay Yerusalaames,","poem":1},{"text":"‹Xiyoone ne babbofa;","poem":2},{"lineBreak":true},{"text":"ne qesey daaburoppo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"GODAA ne Xoossay nenara dees;","poem":1},{"text":"izi ashshiza mino olanchcha.","poem":2},{"lineBreak":true},{"text":"Izi nenan daro ufayettees;","poem":2},{"lineBreak":true},{"text":"izi ba siiqon nena woppisana;","poem":2},{"lineBreak":true},{"text":"ne yeththan izi bonchchettidi","poem":2},{"lineBreak":true},{"text":"ufayettana› gaana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«Bonchcho ba7aale gallassati","poem":1},{"text":"attida gishshas","poem":2},{"lineBreak":true},{"text":"neni muuzottidayssanne,","poem":2},{"lineBreak":true},{"text":"nees tooho gidida yeellaa","poem":2},{"lineBreak":true},{"text":"ta neeppe diggana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"He wode nena un7eththidayta","poem":1},{"text":"ta qaxxayana.","poem":2},{"lineBreak":true},{"text":"Wobbeta ta ashshana;","poem":2},{"lineBreak":true},{"text":"laalettidaytakka","poem":2},{"lineBreak":true},{"text":"ta shiishshana.","poem":2},{"lineBreak":true},{"text":"Istti kawuyida dere ubbaan","poem":2},{"lineBreak":true},{"text":"ta istta bonchchosinne","poem":2},{"lineBreak":true},{"text":"sabas gaththana.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"He wode ta inttena shiishshana;","poem":1},{"text":"intte dere ta inttena zaarana.","poem":2},{"lineBreak":true},{"text":"Intte intte ayfera beyishin,","poem":2},{"lineBreak":true},{"text":"inttefe di7ettida miishshaa","poem":2},{"lineBreak":true},{"text":"ta inttes zaariza wode","poem":2},{"lineBreak":true},{"text":"biitta bolla diza","poem":2},{"lineBreak":true},{"text":"dere ubbaa sinththan","poem":2},{"lineBreak":true},{"text":"ta inttes sabanne","poem":2},{"lineBreak":true},{"text":"bonchcho immana» gees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gmv_ltw/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gmv_ltw/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gmv_ltw/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}