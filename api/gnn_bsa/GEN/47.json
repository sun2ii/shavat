{"translation":{"id":"gnn_bsa","name":"Gumatj Bible","website":"https://ebible.org/Scriptures/details.php?id=gnn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gnn","licenseNotes":null,"shortName":"BSA","englishName":"Gumatj Bible","language":"gnn","textDirection":"ltr","sha256":"328eafc2271933edf555c513f8cd212d1e7f36e9e14906afcbdf552833d8114c","availableFormats":["json"],"listOfBooksApiLink":"/api/gnn_bsa/books.json","numberOfBooks":56,"totalNumberOfChapters":654,"totalNumberOfVerses":13785,"languageName":"Gumatj","languageEnglishName":"Gumatj"},"book":{"id":"GEN","translationId":"gnn_bsa","name":"ŊURRUTHANHARAWUYNHA DHÄWU'","commonName":"ŊURRUTHANHARAWUYNHA DHÄWU'","title":"GENESIS Ŋurruthanharawuy dhäwu' wal'ŋu","order":1,"numberOfChapters":44,"sha256":"017120c9fb07accdb599c1ca6ab05ef1e570b1f4f40a437a84d12b4ed6afd713","firstChapterNumber":1,"firstChapterApiLink":"/api/gnn_bsa/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/gnn_bsa/GEN/50.json","totalNumberOfVerses":844},"chapter":{"number":47,"content":[{"type":"heading","content":["Djaykupku dhä‐yawar'yunaramirrina dhäruk"]},{"type":"verse","number":27,"content":["Yo, ŋunhi",{"noteId":313},"Yitjuralpuyŋunydja yolŋu'yulŋu nhinanana‐a‐a yukurrana ŋunhilina",{"noteId":314},"Yetjip, yanana liŋgu‐u‐u, bala walala ḻukunydjayinana dhikana, ŋatha‐guḻku'mirriyinana ga wäyindja guḻku'yinana marrtjina dhika dhaŋaŋdhinana ga yumurrkuny'tja malanydja guḻku'yinana."]},{"type":"verse","number":28,"content":["Ga ŋunhi ŋayi",{"noteId":315},"Djaykuptja liŋguna worruŋuyinana, dhuŋgarranydja nhanŋu 147‐nha, walunydja marrtjina galkithinana nhanŋu rakunydhinyarawuna, bala yana ŋayi gawaw'yurruna nhanukalayŋuwu gäthu'mirriŋuwuna",{"noteId":316},"Djotjipkuna, ga waŋananydja nhanukala ŋayi bitjarra, “Nhenydja ŋarranha dhawu'mirriyaŋanydja yuwalkkuŋa yana. Ŋunhi ŋarra yurru rakunydhirrinydja dhiyala, ga yaka ŋarranha dholkuŋa dhipalanydja bäyma Yetjiplilinydja."]},{"type":"verse","number":30,"content":["Djaw'yurra ŋarranha rumbalnydja balayi",{"noteId":317},"Gaynanlili, ga dholkuŋa ŋunhamala yana bili wäŋalili ŋunhi bäpa'mirriŋu ŋarraku dholthirri nhina.”"]},{"type":"verse","number":31,"content":["Ga ŋayi Djotjiptja yoraŋalana nhanŋu, bala waŋana dhawu'nherrara bitjarrana, “Yuwalk yana ŋarra yurru nhuna dholkumanydja ŋunhamala liŋgu, bitjan yana liŋgu bitjan dhuwali nhe yukurra waŋa.”"]}],"footnotes":[{"noteId":313,"caller":"+","text":"47:27 Israel","reference":{"chapter":47,"verse":27}},{"noteId":314,"caller":"+","text":"47:27 Egypt","reference":{"chapter":47,"verse":27}},{"noteId":315,"caller":"+","text":"-29 47:28–29 Jacob","reference":{"chapter":47,"verse":28}},{"noteId":316,"caller":"+","text":"-29 47:28–29 Joseph","reference":{"chapter":47,"verse":28}},{"noteId":317,"caller":"+","text":"47:30 Canaan","reference":{"chapter":47,"verse":30}}]},"thisChapterLink":"/api/gnn_bsa/GEN/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gnn_bsa/GEN/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gnn_bsa/GEN/46.json","previousChapterAudioLinks":{},"numberOfVerses":4}