{"translation":{"id":"gnn_bsa","name":"Gumatj Bible","website":"https://ebible.org/Scriptures/details.php?id=gnn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gnn","licenseNotes":null,"shortName":"BSA","englishName":"Gumatj Bible","language":"gnn","textDirection":"ltr","sha256":"328eafc2271933edf555c513f8cd212d1e7f36e9e14906afcbdf552833d8114c","availableFormats":["json"],"listOfBooksApiLink":"/api/gnn_bsa/books.json","numberOfBooks":56,"totalNumberOfChapters":654,"totalNumberOfVerses":13785,"languageName":"Gumatj","languageEnglishName":"Gumatj"},"book":{"id":"ISA","translationId":"gnn_bsa","name":"YITJAYAWUŊU DHÄRUK","commonName":"YITJAYAWUŊU DHÄRUK","title":"ISAIAH Yitjayayunydja yukurra ḻakarama yalalaŋumirriwuna, ŋunhi yurru yolŋu walala nhina yukurra mäwaya'na yanana, rom‐dhunupana wal'ŋu","order":23,"numberOfChapters":33,"sha256":"3faad567ade28d089886bdf3884a0229c0ee1f78690e306a301913e259f4b480","firstChapterNumber":1,"firstChapterApiLink":"/api/gnn_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gnn_bsa/ISA/66.json","totalNumberOfVerses":462},"chapter":{"number":12,"content":[{"type":"heading","content":["Dhuwalanydja manikay wokthunarawuna ŋilimurruŋgalaŋuwu Walŋakunharamirriwu"]},{"type":"verse","number":1,"content":["Yo, yalalaŋumirriyunydja ŋunhinydja yolŋu'‐yulŋu yurru miyaman dhuwalana manikay gam'.",{"text":"“Garray, ŋarra yurru wokthunna nhuŋu.","poem":1},{"lineBreak":true},{"text":"Ŋäthilinydja ŋunhinydja nhe ŋaramurryina ŋarraku,","poem":1},{"text":"yurru dhiyaŋunydja‐wala ŋunhiyi ŋaramurrnydja ŋanydjaḻa'yurrunana,","poem":2},{"lineBreak":true},{"text":"bitjarra nhe ŋarranha marrparaŋ'kuŋalana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Godtja ŋunhi ŋarraku walŋakunharamirri,","poem":1},{"text":"ŋarra yurru ŋayaŋu‐nherraṉmirrinydja nhanukalaynha yana, ga yakana barrarirri.","poem":2},{"text":"Garraynydja dhiyalaŋumina gay' ŋarrakala ŋayaŋuŋurana,","poem":1},{"text":"ga ŋayina ŋarraku ganydjarrnydja;","poem":2},{"text":"ŋarraku ŋayaŋunydja djulŋithirri yukurra miyamanna,","poem":1},{"text":"liŋgu ŋayi ŋarranhanydja walŋakuŋala.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ŋayaŋu‐djulŋithirrina ŋarra ŋuli wurkthundja ŋunhiyi walŋanydja gapu, ŋunhi wekanhara nhanukuŋuwaynha yana Garraywuŋuna,","poem":1},{"text":"liŋgu ŋayipi ŋarraku walŋakunharamirrinydja.”","poem":2}]},{"type":"verse","number":4,"content":["Yo, ŋuriŋiyinydjayi waluyu nhuma yurru waŋa bitjan,",{"text":"“Wokthurrana walala Garraywu. Wäthurra nhanukala, ga ŋayinydja yurru nhuna guŋga'yunna.","poem":1},{"text":"Ḻakaraŋa birrka'mirriwana yolŋu'‐yulŋuwanydja nhaltjarra ŋayi Garrayyu djäma ŋamakurru' wal'ŋu.","poem":2},{"lineBreak":true},{"text":"Ḻakaraŋanydja ŋanya biyaka nhäyinyara ŋayi, biyapul wal'ŋu bathala.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Buku‐ŋal'yurranydja manikayyu manaparra nhanukala Garraywalanydja,","poem":1},{"text":"liŋgu yuwalk yana ŋayi djämanydja mirithirri wal'ŋu, ḻatju' dhika ŋanya;","poem":2},{"text":"bukmak dhuwala munatha' wäŋa ḻiw'marama yurru yolŋu'‐yulŋunydja wokthun nhanŋu yäkuwunydja ŋunhi ŋayi bathala yäku.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nhuma yolŋu'‐yulŋu ŋunhi nhuma","poem":1},{"noteId":31},{"text":"Djurutjalambuy, ma' yiŋgathiya biyakana Garraywu,","poem":1},{"text":"miyamalana manikaynha wokthurrana manaparra,","poem":2},{"lineBreak":true},{"text":"liŋgu Garray Godtja biyapul warray dharrpal wal'ŋu nhumalaŋgu,","poem":2},{"lineBreak":true},{"text":"ga nhinanydja ŋayi yukurra dhuwali ṉapuŋga'na nhumalaŋgala.”","poem":2}]}],"footnotes":[{"noteId":31,"caller":"+","text":"Jerusalem","reference":{"chapter":12,"verse":6}}]},"thisChapterLink":"/api/gnn_bsa/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gnn_bsa/ISA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gnn_bsa/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}