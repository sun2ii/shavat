{"translation":{"id":"gnn_bsa","name":"Gumatj Bible","website":"https://ebible.org/Scriptures/details.php?id=gnn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gnn","licenseNotes":null,"shortName":"BSA","englishName":"Gumatj Bible","language":"gnn","textDirection":"ltr","sha256":"328eafc2271933edf555c513f8cd212d1e7f36e9e14906afcbdf552833d8114c","availableFormats":["json"],"listOfBooksApiLink":"/api/gnn_bsa/books.json","numberOfBooks":56,"totalNumberOfChapters":654,"totalNumberOfVerses":13785,"languageName":"Gumatj","languageEnglishName":"Gumatj"},"book":{"id":"PSA","translationId":"gnn_bsa","name":"MANIKAYKURRU MÄRR‐YIŊGATHINYARAWUY","commonName":"MANIKAYKURRU MÄRR‐YIŊGATHINYARAWUY","title":"PSALMS Märr‐yiŋgathinyarawuynha manikaykurru, wokthunarana Godku","order":19,"numberOfChapters":36,"sha256":"a1474ebf1f8a5dcb7acd4cfb01b5f7a3341a3084829312512bdd7fb316176ba8","firstChapterNumber":1,"firstChapterApiLink":"/api/gnn_bsa/PSA/1.json","lastChapterNumber":148,"lastChapterApiLink":"/api/gnn_bsa/PSA/148.json","totalNumberOfVerses":484},"chapter":{"number":100,"content":[{"type":"heading","content":["Wokthun Garraywu"]},{"type":"verse","number":1,"content":[{"text":"Go wäŋa malanha bukmak, yiŋgathiya Garraywu,","poem":1},{"text":"goŋmirriyiyana nhanŋu go rirrakay‐djulŋithinyamirriyuna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Märr‐ŋal'yurra nhanŋu ŋoy‐djulŋithinyarayu,","poem":1},{"text":"ga marrtjiya lili nhanukala, miyamala ŋayaŋu‐djulŋithinyaramirri manikay.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Marŋgithiyana nhanŋu Garraywu, ŋunhi ŋayi dhuwala Gunhu' Waŋarr, ŋayipi yana.","poem":1},{"text":"Ŋayi bokmara ŋilimurrunha, ga ŋilimurrunydja dhuwala nhanŋuwaynha mala yolŋu;","poem":2},{"lineBreak":true},{"text":"ŋilimurru nhanukalana goŋŋura, liŋgu ŋayi ŋilimurruŋgunydja djäkamirri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Go gärriyana lili nhanukala Buṉbulilina, buku‐wekaŋana ŋanya,","poem":1},{"text":"ŋilimurru wokthunna nhanŋu wal'ŋu mirithirrina;","poem":2},{"text":"Buku‐wekaŋa ŋanya, ga yäkuna ŋanya garrwarkuŋa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bili Garray dhuwala ḻatjuny'tja,","poem":1},{"text":"nhanŋu märr‐ŋamathinyaranydja dhärrana yukurra,","poem":2},{"lineBreak":true},{"text":"ga bitjanna liŋguna yurru, weyinŋumirrina.","poem":2},{"text":"Garraynydja dhuwala märr‐yuwalkthinyaramirri;","poem":1},{"lineBreak":true},{"text":"Ŋilimurrunydja yurru ga yumurrku' ŋilimurruŋgu märr‐nherraṉmirrina nhanukala,","poem":1},{"text":"liŋgu ŋayipinydja yurru yukurra dhärra bitjanna liŋguna djambimiriwnha‐wala yana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gnn_bsa/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gnn_bsa/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gnn_bsa/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":5}