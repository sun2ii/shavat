{"translation":{"id":"gnn_bsa","name":"Gumatj Bible","website":"https://ebible.org/Scriptures/details.php?id=gnn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gnn","licenseNotes":null,"shortName":"BSA","englishName":"Gumatj Bible","language":"gnn","textDirection":"ltr","sha256":"328eafc2271933edf555c513f8cd212d1e7f36e9e14906afcbdf552833d8114c","availableFormats":["json"],"listOfBooksApiLink":"/api/gnn_bsa/books.json","numberOfBooks":56,"totalNumberOfChapters":654,"totalNumberOfVerses":13785,"languageName":"Gumatj","languageEnglishName":"Gumatj"},"book":{"id":"PSA","translationId":"gnn_bsa","name":"MANIKAYKURRU MÄRR‐YIŊGATHINYARAWUY","commonName":"MANIKAYKURRU MÄRR‐YIŊGATHINYARAWUY","title":"PSALMS Märr‐yiŋgathinyarawuynha manikaykurru, wokthunarana Godku","order":19,"numberOfChapters":36,"sha256":"a1474ebf1f8a5dcb7acd4cfb01b5f7a3341a3084829312512bdd7fb316176ba8","firstChapterNumber":1,"firstChapterApiLink":"/api/gnn_bsa/PSA/1.json","lastChapterNumber":148,"lastChapterApiLink":"/api/gnn_bsa/PSA/148.json","totalNumberOfVerses":484},"chapter":{"number":130,"content":[{"type":"heading","content":["Märrliliyaŋa Garraywala"]},{"type":"verse","number":1,"content":[{"text":"Garray, guŋga'yurra ŋarranha,","poem":1},{"text":"liŋgu ŋarra dhuwala ŋayaŋu‐ḏaḏawyunna yukurra.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ŋäka ŋarranha rirrakaynydja, Garray,","poem":1},{"text":"ga guŋga'yurrana go.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ŋunhi bini nhe bothurrunydja ŋanapurruŋgu yätjtja rom malanha,","poem":1},{"text":"nhe bini ŋanapurrunha bukmaknha murr'maranha,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yurru nhenydja bäy‐ḻakarama warray ŋuli ŋanapurruŋgu,","poem":1},{"text":"märr yurru ŋanapurru borrk‐barrarirri nhuŋu,","poem":2},{"lineBreak":true},{"text":"bala märramana yurru nhuŋu dhäruk.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ŋe. Bulnha ŋarra yurru galkun gatjpu'yun yukurra nhanŋu Garraywu.","poem":1},{"lineBreak":true},{"text":"Ŋarranydja yukurra märr‐yuwalkthirri dhärukku nhanŋu,","poem":1},{"text":"Yuwalk ŋayi yurru ŋarranha guŋga'yundja.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yo, galkundja ŋarra ŋuli yukurra Garraywu,","poem":1},{"text":"bitjandhi liŋgu bitjan yolŋu ŋuli nhina marrtji bira'yun dhukarr‐nhämana munha‐ŋupan,","poem":2},{"lineBreak":true},{"text":"yana liŋgu ga wäŋa ŋuli djaḏaw'yun.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nhuma","poem":1},{"noteId":12},{"text":"Yitjuralpuynydja yolŋu'‐yulŋu, biyakayi märr‐nherraṉmiya Garraywala.","poem":1},{"lineBreak":true},{"text":"liŋgu ŋayaŋu‐ŋamathinyara nhanŋunydja ḻatju'na dhikana, djambimiriwnha.","poem":1},{"lineBreak":true},{"text":"Dhunupana ŋayi yurru nhuna guŋga'yunna,","poem":1},{"text":"yakana yurru ŋayi waŋa nhuŋu yaka'yundja.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ŋayi yurru yana yätjtja dhuwurr warrkuḻumana nhanukalaŋuwala miṯtjiwalanydja,","poem":1},{"text":"walŋakumana yurru walalanha dhawaṯmarama ŋula yolkala goŋŋuru.","poem":2}]}],"footnotes":[{"noteId":12,"caller":"+","text":"Israel","reference":{"chapter":130,"verse":7}}]},"thisChapterLink":"/api/gnn_bsa/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gnn_bsa/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gnn_bsa/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":8}