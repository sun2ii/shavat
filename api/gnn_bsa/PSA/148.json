{"translation":{"id":"gnn_bsa","name":"Gumatj Bible","website":"https://ebible.org/Scriptures/details.php?id=gnn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gnn","licenseNotes":null,"shortName":"BSA","englishName":"Gumatj Bible","language":"gnn","textDirection":"ltr","sha256":"328eafc2271933edf555c513f8cd212d1e7f36e9e14906afcbdf552833d8114c","availableFormats":["json"],"listOfBooksApiLink":"/api/gnn_bsa/books.json","numberOfBooks":56,"totalNumberOfChapters":654,"totalNumberOfVerses":13785,"languageName":"Gumatj","languageEnglishName":"Gumatj"},"book":{"id":"PSA","translationId":"gnn_bsa","name":"MANIKAYKURRU MÄRR‐YIŊGATHINYARAWUY","commonName":"MANIKAYKURRU MÄRR‐YIŊGATHINYARAWUY","title":"PSALMS Märr‐yiŋgathinyarawuynha manikaykurru, wokthunarana Godku","order":19,"numberOfChapters":36,"sha256":"a1474ebf1f8a5dcb7acd4cfb01b5f7a3341a3084829312512bdd7fb316176ba8","firstChapterNumber":1,"firstChapterApiLink":"/api/gnn_bsa/PSA/1.json","lastChapterNumber":148,"lastChapterApiLink":"/api/gnn_bsa/PSA/148.json","totalNumberOfVerses":484},"chapter":{"number":148,"content":[{"type":"heading","content":["Wokthurrana Garraywu go"]},{"type":"verse","number":1,"content":[{"text":"Wokthurrana Garraywu go, nhuma bukmak yana djiwarr'wuynydja nhä malanha.","poem":1},{"lineBreak":true},{"text":"Wokthurrana Garraywuna nhuma yolŋu walala djiwarr'wuy, nhanŋu dhäruk‐märranhamirri walala,","poem":1},{"text":"wokthurrana nhanŋu, goŋmirriyiyana walala.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nhe walu ga ŋaḻindi,","poem":1},{"text":"ga wiripuwurru ganyu' walala, wokthurrayi nhumanydja nhanŋu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nhe gärak, ga waŋupini malanha,","poem":1},{"text":"nhumanydja wokthurrayi yukirriya walala, biyakayi bili.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nhumanydja dhuwalinydja malanha djiwarr'puyŋunydja, wokthurra bukmaknha yana,","poem":1},{"text":"yäkuna garrwarkuŋa ŋanya Garraynhana.","poem":2},{"text":"Bili ŋayi Garray waŋana, dhäruk waŋgany,","poem":1},{"text":"bala yana marrtjina nhä malanha maḻŋ'thurrunana;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ŋayi nherra'‐nhirrara nhumalanha nininygarrmurana,","poem":1},{"text":"nhuma dhuwali bukmak yana djiwarr'puyŋunydja;","poem":2},{"text":"Wokthurrana walala,","poem":1},{"text":"märr‐yiŋgathiyana Garraywu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ga nhuma bukmak yana munatha'wuynydja nhä malanha,","poem":1},{"lineBreak":true},{"text":"Wokthurrayi Garraywuna,","poem":1},{"text":"nhuma guya walala, ga wiripu‐guḻku' nhä malanha ŋunhi marrtji ŋorra gapuŋura dhuḻupurrŋura,","poem":2},{"lineBreak":true},{"text":"wokthurrana nhumanydja gatjuy.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nhe maḻwurrk, ga maykarraṉ', ga wärrk, nhanŋu dhäruk‐malthunaramirri walala,","poem":1},{"text":"wokthurrana nhanŋu Garraywu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ga nhe wäŋa ŋaraka, buku ga djulam,","poem":1},{"text":"borummirri dharpa ga retja malanha,","poem":2},{"lineBreak":true},{"text":"wokthurrana walala nhumanydja.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ga nhuma wäyin walala boḏinymirri ga maḏakarritjmirri,","poem":1},{"text":"gaḻ'yunaramirri ga buṯthunaramirri,","poem":2},{"lineBreak":true},{"text":"ḏiltjiwuy ga raŋiwuy,","poem":2},{"lineBreak":true},{"text":"wokthurrana nhumanydja bukmaknha yana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nhuma yolŋu walala, buŋgawamirri ŋurru'‐ŋurruŋu ga wiripu‐guḻku' yolŋu walala,","poem":1},{"text":"yuḏayuḏa yawirriny' dhäykawurru ga ḏarramuwurru,","poem":2},{"lineBreak":true},{"text":"worru'‐wurruŋu ga djamarrkuḻi',","poem":2},{"lineBreak":true},{"text":"nhumanydja wokthurrayi Garraywu, goŋmirriyiyana walala.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nhuma dhuwala bukmak yana munatha'wuynydja nhä malanha,","poem":1},{"text":"wokthurrana walala,","poem":2},{"lineBreak":true},{"text":"märr‐yiŋgathiyana Garraywu.","poem":2},{"text":"Liŋgu Garraynydja dhuwala yäku‐ḏumurru, djuḻkmarama yukurra wiripu‐guḻku'nhanydja;","poem":1},{"lineBreak":true},{"text":"Ŋayinydja yukurra nhina ŋunha djeŋarra'na dhikana, garrkuḻuknha,","poem":1},{"text":"biyapulnha‐wala wal'ŋu garrwarnha,","poem":2},{"lineBreak":true},{"text":"buku‐nyumaramana yukurra munatha'na ga djiwarr'nha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Garraynydja yukurra wirrkina ŋayaŋu‐ŋamathirri nhanukalayŋuwu yolŋu'‐yulŋuwu;","poem":1},{"lineBreak":true},{"text":"Ŋilimurru","poem":1},{"noteId":13},{"text":"Yitjuralpuyŋunydja marrkapmirrina walala nhanŋu,","poem":1},{"text":"ŋayi ŋilimurrunha ganydjarrmirriyaŋala,","poem":2},{"lineBreak":true},{"text":"märr ŋilimurrunydja yurru nhanŋu wokthunna.","poem":2},{"text":"Wokthurrana go Garraywuna.","poem":1}]}],"footnotes":[{"noteId":13,"caller":"+","text":"Israel","reference":{"chapter":148,"verse":14}}]},"thisChapterLink":"/api/gnn_bsa/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gnn_bsa/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gnn_bsa/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":12}