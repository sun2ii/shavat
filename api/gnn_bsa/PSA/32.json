{"translation":{"id":"gnn_bsa","name":"Gumatj Bible","website":"https://ebible.org/Scriptures/details.php?id=gnn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gnn","licenseNotes":null,"shortName":"BSA","englishName":"Gumatj Bible","language":"gnn","textDirection":"ltr","sha256":"328eafc2271933edf555c513f8cd212d1e7f36e9e14906afcbdf552833d8114c","availableFormats":["json"],"listOfBooksApiLink":"/api/gnn_bsa/books.json","numberOfBooks":56,"totalNumberOfChapters":654,"totalNumberOfVerses":13785,"languageName":"Gumatj","languageEnglishName":"Gumatj"},"book":{"id":"PSA","translationId":"gnn_bsa","name":"MANIKAYKURRU MÄRR‐YIŊGATHINYARAWUY","commonName":"MANIKAYKURRU MÄRR‐YIŊGATHINYARAWUY","title":"PSALMS Märr‐yiŋgathinyarawuynha manikaykurru, wokthunarana Godku","order":19,"numberOfChapters":36,"sha256":"a1474ebf1f8a5dcb7acd4cfb01b5f7a3341a3084829312512bdd7fb316176ba8","firstChapterNumber":1,"firstChapterApiLink":"/api/gnn_bsa/PSA/1.json","lastChapterNumber":148,"lastChapterApiLink":"/api/gnn_bsa/PSA/148.json","totalNumberOfVerses":484},"chapter":{"number":32,"content":[{"type":"heading","content":["Milkunharaminyarana Garraywala"]},{"type":"verse","number":1,"content":[{"text":"Yolŋu yurru galŋa‐djulŋithirrinydja yukurra nhina,","poem":1},{"text":"ŋunhi nhanŋu yätjpuynydja dhuwurrwuy liŋguna buwayakkunharana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yo, ŋunhi yurru Garrayyu nhämanydja nhuna, bala ŋayaŋu‐dhunupa ḻakaramana,","poem":1},{"text":"nhenydja dhuwala yolŋu yuwalknha wal'ŋu yurru galŋa‐ŋamathirrina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Märr‐yawungunydja ŋarra rom‐yätjthinya,","poem":1},{"text":"bala djuḻuḻ'maranhana ŋarrakuway yätjtja rom;","poem":2},{"lineBreak":true},{"text":"yakana ŋarra milkunharaminya ḻakaranhaminya Garraywala.","poem":2},{"text":"Bala ŋarra galŋa‐yätjthinana,","poem":1},{"text":"ŋäthinana yukurrana bitjarrana liŋguna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Walu‐ŋupara ga munha‐ŋupara ŋarra dhäkay‐ŋänharaminanydja baṉḏanynha, ganbarknha,","poem":1},{"text":"bitjan ŋuli wäŋa räwakthirri ŋuriŋiyi waluyu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bala ŋarra guyaŋina bitjarra,","poem":1},{"text":"“Yakana ŋarra yurru djuḻuḻ'maramanydja;","poem":2},{"lineBreak":true},{"text":"Ḻakaranharamirrina yurru ŋarra Garraywalana ŋarrakuway yätjtja rom.”","poem":2},{"text":"Bala ŋarra wekanhaminana nhokala, Garray,","poem":1},{"text":"bala nhe ŋarraku bäy‐ḻakaraŋalana,","poem":2},{"lineBreak":true},{"text":"buwayakkuŋala yätjtja ŋarraku rom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yo. Ŋunhi ŋilimurru yurru galŋa‐yätjthirri ya', ga bitjan buku‐warwumirriyirri,","poem":1},{"text":"ŋilimurrunydja yurru yana bukumirriyamana Garraynha, ḻakaranhamirrina nhanukala;","poem":2},{"text":"Yakana yurru ŋula nhäyu ŋilimurrunha mulkanydja,","poem":1},{"text":"ŋunhi ŋilimurru yurru yukurra djuḻuḻ'yundja nhanukala ŋurrwu'ŋura.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Garray, nhenydja ŋurrwu ŋarraku,","poem":1},{"lineBreak":true},{"text":"ŋarra yurru ŋurrwu'yundja nhokala muka,","poem":1},{"text":"ga walŋakuma nhe ŋuli ŋarranha ŋula nhäŋuru romŋuru.","poem":2},{"text":"Ŋarra yurru miyaman manikay,","poem":1},{"text":"wokthun ŋarra yurru nhuŋu manikaykurru,","poem":2},{"lineBreak":true},{"text":"liŋgu nhe ŋuli ŋarraku watjarr‐mulkanydja.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Garraynydja waŋa yukurra bitjanna,","poem":1},{"lineBreak":true},{"text":"“Ŋarra nhuna yurru gäma marrtji bala,","poem":1},{"text":"marŋgikuma marrtji,","poem":2},{"lineBreak":true},{"text":"märr yurru nhe marrtjinydja dhukarrkurru dhunupakurru yana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yaka nhenydja ḏalwurthiya, bitjan ŋunha yarraman' ya'.","poem":1},{"text":"Yarraman'tja ŋuli marrtjina‐wala nhanukalay ŋayi ḏukṯukthu,","poem":2},{"lineBreak":true},{"text":"bala yana yolŋuyuna ŋuli bilyu'‐bilyunmaramanydja ŋanya raki'yuna,","poem":2},{"lineBreak":true},{"text":"märr yurru ŋayi marrtji dhunupakurru dhukarrkurru.","poem":2},{"text":"Yaka nhenydja biyakayi ḏalwurthiya,","poem":1},{"text":"yana nyilŋ'maranhamiya nhepi, ga malthurra marrtjiya nhanŋuway Garraywu ḏukṯukku.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yätjmirrinydja yolŋu'‐yulŋu ŋuli wirrkina warwuyunmirri, galŋa‐yätjthirri manapan.","poem":1},{"lineBreak":true},{"text":"Ga ŋunhinydja walala yolŋu'‐yulŋu ŋunhi walala ŋayaŋu‐nherraṉmina Garraywala,","poem":1},{"text":"walalanhanydja yukurra ḻiw'marama monyguma nhanukalay ŋayi märr‐ŋamathinyarayuna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Go nhuma ŋayaŋu‐dhunupamirrinydja, ŋayaŋu‐djulŋithiyana,","poem":1},{"text":"märr‐yiŋgathiyana Garraywala go wirrkina;","poem":2},{"text":"Ŋilimurru nhanbalanydja malthumaramirri walala,","poem":1},{"text":"wokthunna nhanŋu ŋayaŋu‐djulŋithinyarayuna,","poem":2},{"lineBreak":true},{"text":"märr‐yiŋgathirrina wirrkina go.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gnn_bsa/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gnn_bsa/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gnn_bsa/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":11}