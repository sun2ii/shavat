{"translation":{"id":"gnn_bsa","name":"Gumatj Bible","website":"https://ebible.org/Scriptures/details.php?id=gnn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gnn","licenseNotes":null,"shortName":"BSA","englishName":"Gumatj Bible","language":"gnn","textDirection":"ltr","sha256":"328eafc2271933edf555c513f8cd212d1e7f36e9e14906afcbdf552833d8114c","availableFormats":["json"],"listOfBooksApiLink":"/api/gnn_bsa/books.json","numberOfBooks":56,"totalNumberOfChapters":654,"totalNumberOfVerses":13785,"languageName":"Gumatj","languageEnglishName":"Gumatj"},"book":{"id":"PSA","translationId":"gnn_bsa","name":"MANIKAYKURRU MÄRR‐YIŊGATHINYARAWUY","commonName":"MANIKAYKURRU MÄRR‐YIŊGATHINYARAWUY","title":"PSALMS Märr‐yiŋgathinyarawuynha manikaykurru, wokthunarana Godku","order":19,"numberOfChapters":36,"sha256":"a1474ebf1f8a5dcb7acd4cfb01b5f7a3341a3084829312512bdd7fb316176ba8","firstChapterNumber":1,"firstChapterApiLink":"/api/gnn_bsa/PSA/1.json","lastChapterNumber":148,"lastChapterApiLink":"/api/gnn_bsa/PSA/148.json","totalNumberOfVerses":484},"chapter":{"number":42,"content":[{"type":"heading","content":["Godku ŋar'ŋaryun"]},{"type":"verse","number":1,"content":[{"text":"Gunhu' Waŋarr. Ŋarra yukurra dhuwala ŋanhdharkthirrina;","poem":1},{"lineBreak":true},{"text":"Ŋarranydja nhuŋu ḏukṯukthirri yukurra wirrkina,","poem":1},{"text":"bitjan ŋuli wäyin ḏukṯukthirri gapuwu, wirrkina ŋar'ŋaryun.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ŋarraku ŋayaŋunydja yukurra ŋanhdharkthirrina, baṉḏanynha.","poem":1},{"lineBreak":true},{"text":"Nhepina dhuwala walŋa‐ḏikṯiktja waŋarr,","poem":1},{"text":"nhuŋunydja ŋarra yukurra ḏukṯukthirri wirrkina.","poem":2},{"text":"Nhäthana ŋarra yurru balanydja marrtji?","poem":1},{"text":"Wirrki yana ŋarra ḏukṯukthirri yukurra nhänharawu bukuwunydja nhuŋu,","poem":2},{"lineBreak":true},{"text":"ga buku‐ŋal'yunarawunydja nhuŋu yana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bitjanna liŋguna ŋarra ŋuli ŋäthinydja marrtji, munha‐ŋupan ga walu‐ŋupan,","poem":1},{"text":"liŋgu bitjanna liŋgu walala ŋuli miriŋuyunydja waŋa marrtji ŋarranha,","poem":2},{"lineBreak":true},{"text":"“Wanhaka be nhuŋu Waŋarrnydja?” bitjanna ŋuli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Roŋiyirri ŋarra ŋuli guyaŋirri ŋurikiy ŋäthiliŋuwuy,","poem":1},{"text":"bala ŋarraku ŋuli ŋayaŋunydja yätjthirrina.","poem":2},{"text":"Yo, marrtjinya ŋarra ŋuli Buṉbulili Dhuyulili, rrambaŋi wiripu‐guḻku'wala miṯtjiwala;","poem":1},{"text":"marrtjinya ŋarra ŋuli, ŋurru‐warryuna yolŋunha miṯtjinha;","poem":2},{"text":"Rrambaŋi ŋanapurru ŋuli marrtjinya Godkalanydja Buṉbulili,","poem":1},{"text":"bala ŋanapurru ŋuli miyamana manikay, märr‐yiŋgathinya rrambaŋi,","poem":2},{"lineBreak":true},{"text":"wokthuna ŋuli yukurranha Garraywu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nhäku ŋarra yukurra dhuwala galŋa‐yätjthirrinydja?","poem":1},{"text":"Nhäku ŋarra warwuyundja yukurra?","poem":2},{"text":"Ŋarra yurru yana märr‐nherraṉmirri Garraywalana,","poem":1},{"text":"gatjpu'yun yukurra galkunna nhanŋu;","poem":2},{"text":"Ŋarra yurru biyapul wokthun yukurra Garraywunydja,","poem":1},{"text":"bili ŋayi ŋarraku Walŋakunharamirrinydja ga Waŋarr Godtja,","poem":2},{"lineBreak":true},{"text":"nhanukalaynha yana ŋarra yurru ŋayaŋu‐nherraṉmirrinydja.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gnn_bsa/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gnn_bsa/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gnn_bsa/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":5}