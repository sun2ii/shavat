{"translation":{"id":"gnn_bsa","name":"Gumatj Bible","website":"https://ebible.org/Scriptures/details.php?id=gnn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gnn","licenseNotes":null,"shortName":"BSA","englishName":"Gumatj Bible","language":"gnn","textDirection":"ltr","sha256":"328eafc2271933edf555c513f8cd212d1e7f36e9e14906afcbdf552833d8114c","availableFormats":["json"],"listOfBooksApiLink":"/api/gnn_bsa/books.json","numberOfBooks":56,"totalNumberOfChapters":654,"totalNumberOfVerses":13785,"languageName":"Gumatj","languageEnglishName":"Gumatj"},"book":{"id":"PSA","translationId":"gnn_bsa","name":"MANIKAYKURRU MÄRR‐YIŊGATHINYARAWUY","commonName":"MANIKAYKURRU MÄRR‐YIŊGATHINYARAWUY","title":"PSALMS Märr‐yiŋgathinyarawuynha manikaykurru, wokthunarana Godku","order":19,"numberOfChapters":36,"sha256":"a1474ebf1f8a5dcb7acd4cfb01b5f7a3341a3084829312512bdd7fb316176ba8","firstChapterNumber":1,"firstChapterApiLink":"/api/gnn_bsa/PSA/1.json","lastChapterNumber":148,"lastChapterApiLink":"/api/gnn_bsa/PSA/148.json","totalNumberOfVerses":484},"chapter":{"number":47,"content":[{"type":"heading","content":["Garray ŋurruŋu buŋgawa bukmakku bäpurru'wu"]},{"type":"verse","number":1,"content":[{"text":"Go walala yolŋu'‐yulŋu, goŋ‐ḻurr'‐ḻurryurrana walala,","poem":1},{"text":"märr‐yiŋgathiyana, ga manikaynha miyamala go!","poem":2},{"lineBreak":true},{"text":"Wokthurrana wirrkina yana rirrakaynydja buku‐warrwarthiyana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Liŋgu Garray warray biyapulnydja‐wala wal'ŋu garrwarnydja,","poem":1},{"text":"ŋilimurru borrk‐beyaṉiyirri nhanŋu;","poem":2},{"text":"Ŋayi dhuwala buŋgawa ŋurruŋunydja,","poem":1},{"lineBreak":true},{"text":"ga bukmak dhuwala wäŋa nhanukala yukurra goŋŋura djingaryun.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wiripu bäpurru' yolŋu miriŋuyina ŋilimurruŋgu,","poem":1},{"text":"yurru ŋilimurrunydja djuḻkmaraŋala walalanha Garraywalana ŋuriŋi ganydjarryu,","poem":2},{"lineBreak":true},{"text":"bala ŋayi nherrara dharraylili walalanhanydja ŋilimurruŋgalana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ŋayi djarr'yurruna ŋilimurruŋgu wäŋa nhinanharawu,","poem":1},{"text":"liŋgu wirrkina ŋayi yukurra märryu‐ḏapthunmarama ŋilimurrunha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Godtja dhuwala liŋguna ŋurruŋuyina buŋgawayina,","poem":1},{"text":"ŋunha ŋayi nhinanydja yukurra djiwarr'ŋurana,","poem":2},{"text":"ga yolŋunydja walala girrirriyunna yukurra yiŋgathirrina,","poem":1},{"text":"wokthunna nhanŋu bena buku‐warrwaryuna rirrakayyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Go ŋilimurrunydja miyamanna, wokthundhi nhanŋu,","poem":1},{"text":"wokthunna ŋilimurru go ŋilimurruŋgalaŋuwu Garraywu Godkunydja,","poem":2},{"lineBreak":true},{"text":"liŋgu ŋayi ŋilimurruŋgu buŋgawa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yo, Gunhu' Waŋarrnydja buŋgawana bukmakku wäŋawu buku‐ḻiw'marama yana.","poem":1},{"text":"Wokthunna go nhanŋu,","poem":2},{"lineBreak":true},{"text":"manikaynha miyaman wokthunna manapan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yo, Gunhuny'tja ŋunha nhina yukurra nhanukalay wäŋaŋura djiwarr'ŋurana,","poem":1},{"text":"ŋayathama ŋayi yukurra yolŋu'‐yulŋunha bukmaknha, bäpurru'nha ga bäpurru'nha.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mulku'‐mulkurunydja yolŋu walala marrtjina yurrum'thurrunana waŋgany‐manapanminana ŋanapurruŋgala,","poem":1},{"text":"waŋganyŋura ŋilimurru yukurra buku‐ŋal'yundja Garraywu;","poem":2},{"text":"Ga mariwuynydja girri' ŋunhinydja goŋŋuru yupthurrunana,","poem":1},{"text":"liŋgu ŋayi Gunhu' Waŋarr buŋgawa ŋurruŋunydja bukmakku bäpurru'wu,","poem":2},{"lineBreak":true},{"text":"bukmak dhuwala yolŋu'‐yulŋu nhanukala waŋganygala yukurra djingaryun goŋŋura.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gnn_bsa/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gnn_bsa/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gnn_bsa/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}