{"translation":{"id":"gnn_bsa","name":"Gumatj Bible","website":"https://ebible.org/Scriptures/details.php?id=gnn","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gnn","licenseNotes":null,"shortName":"BSA","englishName":"Gumatj Bible","language":"gnn","textDirection":"ltr","sha256":"328eafc2271933edf555c513f8cd212d1e7f36e9e14906afcbdf552833d8114c","availableFormats":["json"],"listOfBooksApiLink":"/api/gnn_bsa/books.json","numberOfBooks":56,"totalNumberOfChapters":654,"totalNumberOfVerses":13785,"languageName":"Gumatj","languageEnglishName":"Gumatj"},"book":{"id":"PSA","translationId":"gnn_bsa","name":"MANIKAYKURRU MÄRR‐YIŊGATHINYARAWUY","commonName":"MANIKAYKURRU MÄRR‐YIŊGATHINYARAWUY","title":"PSALMS Märr‐yiŋgathinyarawuynha manikaykurru, wokthunarana Godku","order":19,"numberOfChapters":36,"sha256":"a1474ebf1f8a5dcb7acd4cfb01b5f7a3341a3084829312512bdd7fb316176ba8","firstChapterNumber":1,"firstChapterApiLink":"/api/gnn_bsa/PSA/1.json","lastChapterNumber":148,"lastChapterApiLink":"/api/gnn_bsa/PSA/148.json","totalNumberOfVerses":484},"chapter":{"number":8,"content":[{"type":"heading","content":["Godthu gurrunhara ḻatju'kuŋala yolŋuwu"]},{"type":"verse","number":1,"content":[{"text":"Garray gay' marrkapmirri,","poem":1},{"text":"nhe muka ŋanapurruŋgu Garraynydja,","poem":2},{"text":"bukmak dhuwala munatha'ŋura ŋorra marrtji, nhunana yukurra mel‐ḻakarama;","poem":1},{"lineBreak":true},{"text":"Ḻatju' dhuwala nhe yolŋunydja, Garray.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dhuwali djiwarr'ŋura wokthun yukurra nhuŋu yana,","poem":1},{"text":"ga yutjuwaḻa'mirrinydja yumurrku' yolŋu'‐yulŋu nhuŋu yukurra yana märr‐gorruma,","poem":2},{"lineBreak":true},{"text":"wokthundhi nhuŋu ga ḻatju'‐ḻakarama.","poem":2},{"text":"Nhinanydja nhe yukurra wuṉḏaŋarr yana wal'ŋu dhika,","poem":1},{"text":"ga yakana yurru ŋula miriŋunydja marrtji galkithirrinydja,","poem":2},{"lineBreak":true},{"text":"liŋgu nhe yukurra gulmaramana ŋula yolnhanydja ŋunhi ŋayi ŋuli nhuŋu ŋapa‐nherraṉmirri.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wiripunydja ŋarra ŋuli bakuruma garrwar,","poem":1},{"text":"bala nhämana ŋuli gäraktja ŋunhi nhokuŋu bokmanaranydja.","poem":2},{"text":"Nhe bokmara ŋaḻindi ga ganyu' malanha,","poem":1},{"text":"ga nherrara nhe walalanha gäraklili.","poem":2},{"text":"Nhäma ŋarra ŋuli yulŋunydja,","poem":1},{"text":"bala ŋarra ŋuli guyaŋirrina bitjan,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Nhäku warray Garrayyu yukurra guyaŋirri ga ḻayḻayyun yolŋuwalanydja?","poem":1},{"lineBreak":true},{"text":"Yolŋunydja dhuwala yutjuwaḻa'na, nyumukuṉiny'nha yana,","poem":1},{"text":"yurru mukthun ŋayi ŋuli Garraynydja yolŋuwu djäka.","poem":2},{"text":"Nhäyinyarana dhuwala ŋayi yolŋunydja?”","poem":1},{"text":"Bitjan ŋarra ŋuli guyaŋirri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yuwalk muka nhe bokmara yolŋunhanydja,","poem":1},{"text":"bala ŋurrulilina nhe ŋanya nherraranydja.","poem":2},{"text":"Yolŋunydja dhuwala yaka nyumukuṉiny' nhokala maŋutjiŋura.","poem":1},{"lineBreak":true},{"text":"Nhepina wal'ŋu biyapulnydja‐wala ŋurruŋu yolŋuwu,","poem":1},{"text":"ga yolŋunydja ŋurruŋu dhiyaku malanyŋuwu ŋunhi nhe goŋ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Goŋ‐nherraranydja nhe ŋanya yolŋunhanydja;","poem":1},{"lineBreak":true},{"text":"Nhanukala yolŋuwala goŋŋura bukmak dhika ŋorra yukurra;","poem":1},{"text":"boḏiny wäyin ga wäyin wakinŋu,","poem":2},{"lineBreak":true},{"text":"buṯthunaramirri wäyin ga gaḻ'yunaramirri, ga gapuŋura guya.","poem":2},{"text":"Bukmaknha yana nhe wekaŋala yolŋuwala dharraylili.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Garray gay', marrkapmirri,","poem":1},{"text":"nhe muka ŋanapurruŋgu Garraynydja.","poem":2},{"text":"Bukmakthu dhiyaŋu malaŋuyu nhuna yukurra mel‐ḻakaramana.","poem":1},{"lineBreak":true},{"text":"Ḻatjuŋ'ka dhuwala nhe yulŋunydja, Garray.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gnn_bsa/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gnn_bsa/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gnn_bsa/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":7}