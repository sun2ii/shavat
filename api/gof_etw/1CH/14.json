{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"1CH","translationId":"gof_etw","name":"1 ታርከ ማፃፋ","commonName":"1 ታርከ ማፃፋ","title":"1 ታርከ ማፃፋ","order":13,"numberOfChapters":29,"sha256":"e94e896a0eea4145a6f7a300e1de77b7c1b60d2f586d92509649b5899758b90e","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/gof_etw/1CH/29.json","totalNumberOfVerses":940},"chapter":{"number":14,"content":[{"type":"heading","content":["ዳዊታ ሶ አሳ"]},{"type":"verse","number":1,"content":["ፅሮሳ ካዎይ ክራም ዳዊታስ ጋ ኬፃና መላ ኪተትያ አሳታ፥ ሹቹ ማሰይሳታነ አናፀታ ዝጋ ምራ የድስ።"]},{"type":"verse","number":2,"content":["ጎዳይ እስራኤለ ቦላ እያ ካዎ ኦድ ምንዳይሳነ ባ አሳ እስራኤለ ግሾ እያ ካዎተ ቦንችዳይሳ ዳዊቲ ኤርስ።"]},{"type":"verse","number":3,"content":["ሄሳፈ ጉየ፥ ዳዊቲ የሩሳላመን ሀራ ማቾ ኤክድ አደ ናይታነ ማጫ ናይታ የልስ።"]},{"type":"verse","number":4,"content":["ዳዊቲ የሩሳላመን የልዳ አደ ናይት ሳሙሳ፥ ሶባባ፥ ናታና፥ ሶሎሞነ፥"]},{"type":"verse","number":5,"content":["ይብሃራ፥ ኤልሱአ፥ ኤልፋላፃ፥"]},{"type":"verse","number":6,"content":["ኖጋ፥ ናፈጋ፥ ያፋያ፥"]},{"type":"verse","number":7,"content":["ኤልሳማ፥ ኤልዳና፥ ኤልፋላፃ።"]},{"type":"heading","content":["ዳዊቲ ፍልስፄመታ ፆንስ"]},{"type":"verse","number":8,"content":["ዳዊቲ እስራኤለ ኡባ ቦላ ካዎ ግድድ ትየትዳይሳ ፍልስፄመት ስእዳ ዎደ ኡባይ ዳዊታ ኦልድ ኦይካናዉ ከይዶሶና። ዳዊቲ ሄሳ ስእድ ኤንታራ ኦለታናዉ ከይስ።"]},{"type":"verse","number":9,"content":["ፍልስፄመት ራፋይመ ዛንጋራ ይድ ኦይክዶሶና።"]},{"type":"verse","number":10,"content":["ዳዊቲ፥ “ታኒ ፍልስፄመታ ኦሎ? ኔኒ ኤንታ ታዉ አ እማኔ?” ያግድ ፆሳ ኦይችስ። ጎዳይ፥ “ባዳ ኦላ፤ ታኒ ኤንታ ነዉ አ እማና” ያግስ።"]},{"type":"verse","number":11,"content":["ዳዊቲነ እያ አሳይ ባአል-ፓራስመ ጌተትያ በሳ ብድ ያን ኤንታ ፆንዶሶና። ዳዊቲ፥ “ሃ ስድ ከየይሳዳ ፆሳይ ታ ሞርከታ ግዶራ ታና ካንስስ” ያግስ። ሄ በሳ ሱንይ ባአል-ፓራስመ ጌተትስ።"]},{"type":"verse","number":12,"content":["ፍልስፄመት ባንታ ኤቃታ ሄ በሳን የግድ ብን፥ ዳዊቲ ኪትድ ኤንታ ኤቃታ ፁግስስ።"]},{"type":"verse","number":13,"content":["ፍልስፄመት ዛር ሄ ዛንጋራ ይድ ኦልዶሶና።"]},{"type":"verse","number":14,"content":["ዳዊቲ ፆሳ ዛሪድ ኦይችስ። ፆሳይ፥ “ኤንታ ጉየራ ዩያ አዳ ዎላ ማታን ኤቃዳ ኦላፐ አትሽን፥ ስን ባጋራ ከዮፓ።"]},{"type":"verse","number":15,"content":["ዎላ ሁጰን ሳልፐ ግርስ ኔኒ ስእያ ዎደ ኦላናዉ ከያ። ሄስ ፍልስፄመ ኦላንቾታ ሾጫናዉ ፆሳይ ኔፐ ስን አዳይሳስ ማላ” ያግስ።"]},{"type":"verse","number":16,"content":["ፆሳይ ኪትዳይሳዳ ዳዊቲ ኦስ። ጋባኦናፐ ገዘራ ጋካናዉ እስራኤለ አሳይ ፍልስፄመ ኦላንቾታ ዎዶሶና።"]},{"type":"verse","number":17,"content":["ዳዊታ ሱንይ ቢታ ኡባ ጋክስ። ካዎተ ኡባይ ዳዊታስ ያያና መላ ጎዳይ ኦስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/1CH/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/1CH/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/1CH/13.json","previousChapterAudioLinks":{},"numberOfVerses":17}