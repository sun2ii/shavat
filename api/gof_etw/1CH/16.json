{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"1CH","translationId":"gof_etw","name":"1 ታርከ ማፃፋ","commonName":"1 ታርከ ማፃፋ","title":"1 ታርከ ማፃፋ","order":13,"numberOfChapters":29,"sha256":"e94e896a0eea4145a6f7a300e1de77b7c1b60d2f586d92509649b5899758b90e","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/gof_etw/1CH/29.json","totalNumberOfVerses":940},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":["ኤንቲ ፆሳ ታቦትያ ኤህድ ዳዊቲ ታቦትያ ዎናዉ ኤስዳ ዱንካንያ ግዶን ዎድ፥ ፁሳ ያርሾነ እስፈተ ያርሾ ፆሳስ ያርሽዶሶና።"]},{"type":"verse","number":2,"content":["ዳዊቲ ፁሳ ያርሾነ እስፈተ ያርሾ ያርሽድ ፖልዳፐ ጉየ ጎዳ ሱንን አሳ አንጅስ።"]},{"type":"verse","number":3,"content":["እስራኤለ አሳ ኡባስ ማጫስነ አደስ፥ ሁጰን ሁጰን እስ ሙመ ኡይ፥ እስ ቃንፆ አሾነ እስ ዎይነ ኑካ ግሽስ።"]},{"type":"verse","number":4,"content":["ጎዳ ታቦትያ ስንን ኦና መላነ ጎዳ እስራኤለ ፆሳ ሳባና መላ፥ ጋላታና መላነ ቦንቻና መላ ጉ ሌወታ ዳዊቲ ሹምስ።"]},{"type":"verse","number":5,"content":["ሌወታ ሀላቃይ አሳፋ፤ አሳፋ ካልድ ዛካርያሳ። ዛካርያሳ ካልድ ደኤይ ይኤላ፥ ሻምራሞታ፥ ይኤላ፥ ማትታ፥ ኤልኣባ፥ ባናያነ ኦቤድ-ኤዶመ። ኤንቲ ማስንቆነ ዲ ዲፃናዉ ሹመትዶሶና፤ ሽን አሳፍ ዳላ ግርሳናዉ ሹመትስ።"]},{"type":"verse","number":6,"content":["ካህነይ ባናይነ ያሀዝኤል ፆሳ ጫቆ ታቦትያ ስንን ኡባ ዎደ ሞይዘ ፑናናዉ ሹመትዶሶና።"]},{"type":"verse","number":7,"content":["ሄ ጋላስ ዳዊቲ አሳፍነ እያ ዳቦት ጎዳ ሳባና መላ ሀ ማዝሙርያ ኮይሮ ኪትስ።"]},{"type":"heading","content":["ጋላታ ማዝሙረ"]},{"type":"verse","number":8,"content":[{"text":"ጎዳ ጋላትተ፤ እያ ሱን ፄግተ፤","poem":1},{"text":"እያ ኦሱዋ ካዎተታ ግዶን ኦድተ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እያ ሳቢተ፤ ጋላታ ማዝሙርያ እያዉ የፅተ፤","poem":1},{"text":"ማላልስያ እያ ኦሶ ኡባ ኦድተ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እያ ጌሻ ሱንን ጬቀትተ፤","poem":1},{"text":"ጎዳ ኮየይሳታ ዎዛናይ ኡፋይቶ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጎዳነ እያ ዎልቃ በእተ፤","poem":1},{"text":"ኡባ ዎደ እያ ስን ኮይተ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ህንተኖ፥ እስራኤለ ኮቻቶ፥","poem":1},{"text":"ዶረትዳ ያይቆባ ናይቶ፥","poem":2},{"lineBreak":true},{"text":"እያ ማላታ፥ እ እምዳ ፕርዳነ ማላልስያባታ ሀሳይተ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እ ጎዳ ኑ ፆሳ፤","poem":1},{"text":"እያ ፕርዳይ ቢታ ኡባ ቦላና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እያ ጫቁዋ መርናዉ","poem":1},{"text":"ሙኩሉ የለተ ጋካናዉ፥","poem":2},{"lineBreak":true},{"text":"እያ ቃላ ናግተ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አብራሃመራ ጫቅዳ ጫቁዋ ናጌስ፤","poem":1},{"text":"ይሳቃስ ገልዳ ቃላ ምንስ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ያይቆባስ ዎጋ፥","poem":1},{"text":"እስራኤለስ መርና ጫቁዋ፥","poem":2},{"lineBreak":true},{"text":"ኦድ ምንስ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“ታኒ ነዉ ካናነ ቢታ እማና፤","poem":1},{"text":"እ ነ ኮቻስ ላታ ግዳና” ያግስ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሄስ ህንተ ታይቦን ጉነ","poem":1},{"text":"ካናነን በተ ግድድ ደእያ ዎደ ሀንስ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እስ ደርያፐ ሀራ ደረ ፕንዶሶና፤","poem":1},{"text":"እስ ካዎተፈ ሀራ ካዎተ ዩይዶሶና።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ፆሳይ ኤንታ ኦንካ ናቃና መላ እምቤና፤","poem":1},{"text":"ኤንታ ግሾ ካዎታ ሴርስ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“ታኒ ትይዳይሳታ ቦቾፍተ፤","poem":1},{"text":"ታ ናበታ ቆሆፕተ” ያግስ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ሳአን ደእያ አሳ ኡባይ ጎዳስ የፅተ፤","poem":1},{"text":"እያ አሹዋ ጋላስ ጋላስ ኦድተ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ካዎተታ ግዶን እያ ቦንቹዋ፥","poem":1},{"text":"ማላልስያ እያ ኦሱዋ አሳ ኡባ ግዶን አዋጅተ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ጎዳይ ግታ፤ አ ጋላታይ እያዉ በሴስ፤","poem":1},{"text":"ፆሳታ ኡባፈ አድ ቦንቸታናዉ በሴስ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ሀራ ካዎተታ ፆሳት ኡባይ ኤቃታ፤","poem":1},{"text":"ሽን ጎዳይ ሳሎታ መዳ ፆሳ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"እያ ስንን ቦንቾይነ ቴም ደኤስ፤","poem":1},{"text":"ምኖተነ ኡፋይስ እ ደእያ በሳን ደኤስ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ህንተኖ፥ ቢታ ካዎተቶ፥","poem":1},{"lineBreak":true},{"text":"ጎዳ ቦንቾነ ዎልቃ እምተ።","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"እያ ሱንስ በሲያ ቦንቾ እምተ፤","poem":1},{"text":"ያርሾ ኤክድ እያ ስን ዪተ፤","poem":2},{"lineBreak":true},{"text":"እያ ጌሻተ ቴማን ጎዳ ጎይንተ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ቢታን ደእያ አሳ ኡባይ እያ ስንን ኮኮርተ፤","poem":1},{"text":"ሳአይ ምን ኤቅዳ ግሾ ቃፀና።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ሳሎት ኡፋይቶ፤ ሳእ ሀሹ ጎ!","poem":1},{"lineBreak":true},{"text":"ካዎተታ ግዶን ኤንቲ “ጎዳይ ካዎትስ!” ያጎ።","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"አባይነ እያ ግዶን ደእያ ኡባይ ጉሞ፤","poem":1},{"text":"ጋደይነ እያን ደእያ ካ ኡባይ ኡፋይቶ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ሄ ዎደ ዎራን ደእያ ም ኡባይ","poem":1},{"text":"ኡፋይሳን ጎዳ ስንን የፃና።","poem":2},{"lineBreak":true},{"text":"እ ሳኣ ቦላ ፕርዳናዉ ዬስ።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ጎዳይ ኬሀ ግድያ ግሾነ","poem":1},{"text":"እያ ሲቆይ መርናሳ ግድያ ግሾ፥","poem":2},{"lineBreak":true},{"text":"ጎዳ ጋላትተ።","poem":2}]},{"type":"verse","number":35,"content":[{"text":"“አቤት ኑና አሽያ ፆሳዉ ኑና አሻ፤","poem":1},{"text":"ኑኒ ነ ጌሻ ሱን ጋላታና መላነ","poem":2},{"lineBreak":true},{"text":"ነ ቦንቹዋን ኑ ቦንቸታና መላ፥","poem":2},{"lineBreak":true},{"text":"ካዎተታ ግዶፈ ሺሻዳ ኑና አሻ” ያግተ።","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ጎዳይ እስራኤለ ፆሳይ፥","poem":1},{"text":"መርናፐ መርና ጋካናዉ ጋላተቶ!","poem":2},"አሳ ኡባይ፥ “አምንእ” ግድ፥ ጎዳ ጋላትዶሶና።"]},{"type":"verse","number":37,"content":["ጎዳ ጫቆ ታቦትያ ስንን ጋላስ ጋላስ ጎይኖስ ኮሽያባ ኡባ ዎደ ኤንቲ ኦና መላ ዳዊቲ አሳፋነ እያ ዳቦታ ዎስ።"]},{"type":"verse","number":38,"content":["ቃስ ኦቤድ-ኤዶመነ ኡሱፑን ታማነ ሆስፑን እያ ዳቦታ ኤንታራ ኦና መላ ዎስ፤ የዱቱና ናኣ ኦቤድ-ኤዶመነ ሆሳ ፐንግያ ናጋና መላ ዎስ።"]},{"type":"verse","number":39,"content":["ካህነይ ሳዶቅነ እያራ ኦያ ካህነት ጋባኦናን ደእያ ቃ በሳን፥ ዱንካንያ ስንን ኦና መላ ኤንታ ያን አግስ።"]},{"type":"verse","number":40,"content":["ጎዳይ እስራኤለስ እምዳ ህግያን ፃፈትዳይሳዳ ኤንቲ ዎንታነ ኦማርስ ኡባ ዎደ ፁሳ ያርሾ ያርሻና መላ ኦስ።"]},{"type":"verse","number":41,"content":["እያ ሲቆይ መርናሳ ግድያ ግሾ ጎዳ ማዝሙረን ጋላታና መላ ሄማና፥ የዱቱናነ ዶረትዳ ሀራታ ዳዊቲ ኤንታራ እስፈ ዎስ።"]},{"type":"verse","number":42,"content":["ሄማንነ የዱቱን ሞይዘ ፑኖሶና፥ ዳላ ጊርሶሶና ጋላታ ማዝሙረ የፅሸ ካእያ ሀራ ሚሸታ ካኦሶና። የዱቱና አደ ናይት ፐንግያ ናጋናዉ ሹመትዶሶና።"]},{"type":"verse","number":43,"content":["ሄሳፈ ጉየ አሳ ኡባይ ባ ሶ ሶ ብስ። ዳዊቲካ ባ ሶ አሳ አንጃናዉ ስምስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/1CH/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/1CH/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/1CH/15.json","previousChapterAudioLinks":{},"numberOfVerses":42}