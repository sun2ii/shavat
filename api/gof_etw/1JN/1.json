{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"1JN","translationId":"gof_etw","name":"1 ዮሃንሳ ኪታ","commonName":"1 ዮሃንሳ ኪታ","title":"ዮሃንስ ፃፍዳ ኮይሮ ኪታ","order":62,"numberOfChapters":5,"sha256":"e09d6c137452ad37d44993f93cc1725c3998ad976fbfea267d11cf9f75291705","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/1JN/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/gof_etw/1JN/5.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"heading","content":["ደኦ ቃላ"]},{"type":"verse","number":1,"content":["ኑኒ ኮይሮፐ ዶምድ ደእያ፥ ኑ ሀይን ስእዳ፥ ኑ ፄልዳ፥ አይፈን በእዳ፥ ኑ ኩሸን ቦችዳ ደኦ ቃላባ ህንተዉ ፃፎስ።"]},{"type":"verse","number":2,"content":["ሄ ደኦይ ቆንጭን፥ ኑኒ እያ በእድ፥ እያባ ማርካቶስ። አዋ ማታን ደእያ ኑስ ቆንጭዳ፥ መርና ደኡዋባ ህንተዉ አዋጆስ።"]},{"type":"verse","number":3,"content":["ኑራ ህንተዉ እስፈተ ዳና መላ ኑኒ በእዳይሳነ ስእዳይሳ ህንተዉ ኦዶስ። ህንተዉ ኑራ እስፈተ ደእያ ግሾ፥ አዋራነ እያ ናኣ የሱስ ክርስቶሳራ እስፈተ ደኤስ።"]},{"type":"verse","number":4,"content":["ኑ ኡፋይሳይ ፖሎ ግዳና መላ ሄሳ ህንተዉ ፃፎስ።"]},{"type":"heading","content":["ፆሳይ ፖኦ"]},{"type":"verse","number":5,"content":["ኑኒ ደኦ ግድዳ እያፐ ስእድ፥ ህንተዉ ኦድያ ኪታይ ሀይሳ፦ “ፆሳይ ፖኦ፤ እያን ም ባዋ” ያገይሳ።"]},{"type":"verse","number":6,"content":["ኑስ እያራ እስፈተ ደኤስ ያግሸ ማን ደእኮ፥ ኑ ኦዳንነ ኑ ኦሱዋን ዎርዶቶስ።"]},{"type":"verse","number":7,"content":["ሽን ፖኦን እ ደኤይሳዳ፥ ኑካ ፖኦን ደእኮ፥ ኑስ ዎል ግዶን እስፈተ ደኤስ። እያ ናኣ፥ የሱሳ ሱይ ናጋራ ኡባፈ ኑና ጌሼስ።"]},{"type":"verse","number":8,"content":["ኑኒ፥ ኑናን ናጋር ባዋ ጊኮ ኑ ኑና ጭሞስ፤ ኑናን ቱም ባዋ።"]},{"type":"verse","number":9,"content":["ሽን ፆሳስ ኑ ናጋራ ፓፅኮ፥ እ ኑ ናጋራ አቶ ጋናዉነ ኑ ቆሆ ኦሶ ኡባፈ ኑና ጌሻናዉ፥ አማነትዳይሳነ ቱማ።"]},{"type":"verse","number":10,"content":["ኑኒ ናጋራ ኦቦኮ ጊኮ ፆሳ ዎርዳንቾ ከሶስ፤ እያ ቃላይካ ኑናን ዴና።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/1JN/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/1JN/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/2PE/3.json","previousChapterAudioLinks":{},"numberOfVerses":10}