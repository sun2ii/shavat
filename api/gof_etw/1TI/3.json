{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"1TI","translationId":"gof_etw","name":"1 ፅሞትዮሳ ኪታ","commonName":"1 ፅሞትዮሳ ኪታ","title":"ጳዉሎስ ፅሞትዮሳስ ፃፍዳ ኮይሮ ኪታ","order":54,"numberOfChapters":6,"sha256":"fe8ff3e2d7b3f5628a7fe62c438b8a0be9184a9a2284ed4ab87ef94ec64f5265","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/1TI/1.json","lastChapterNumber":6,"lastChapterApiLink":"/api/gof_etw/1TI/6.json","totalNumberOfVerses":113},"chapter":{"number":3,"content":[{"type":"heading","content":["ዎሳ ኬ ጭማታ"]},{"type":"verse","number":1,"content":["ኦንካ፥ “ዎሳ ኬ ካለያ አስ ግዳናዉ ኮይኮ ሎኦባ አሞቴስ” ግያ ኦዳይ ቱማ።"]},{"type":"verse","number":2,"content":["ዎሳ ኬ ካለያ አስ ቦረቶናይሳ፥ እስ ማቸ ፃላል ደኤይሳ፥ ማራን ደኤይሳ፥ ባና ሃረይሳ፥ በሰይሳዳ ኦይሳ፥ እማ ሞከይሳ፥ ታማርሳናዉ ዳንዳኤይሳ፥"]},{"type":"verse","number":3,"content":["ማቶናይሳ፥ ኦየቶናይሳ፥ ፓላሞናይሳ፥ ሚሸ ሲቆናይሳ፥"]},{"type":"verse","number":4,"content":["እያ ናይት እያዉ ኪተተይሳነ ቦንቸይሳ፥ ባ ኬ አይሳናዉ ዳንዳኤይሳ ግዳናዉ በሴስ።"]},{"type":"verse","number":5,"content":["እስ አስ ባ ኬ አይሳናዉ ዳንዳኦና እፅኮ፥ ፆሳ ዎሳ ኬ ዋት አይሳናዉ ዳንዳኢ?"]},{"type":"verse","number":6,"content":["ኦቶሮን ሱገትድ፥ ፃላሄይ ፆሳ ፕርዳን ኩንድዳይሳዳ ኩንዶና መላ፥ ኦራ አማንዳ አስ ግዳናዉ በሰና።"]},{"type":"verse","number":7,"content":["ቦረንነ ፃላሄ ፅሄን ገሎና መላ ሄ ኡራይ አማኖና አሳ ማታን ናሸተይሳ ግዳናዉ በሴስ።"]},{"type":"heading","content":["ዎሳ ኬ ዳቆነታ"]},{"type":"verse","number":8,"content":["ሄሳዳ ቃስ ዎሳ ኬ ዳቆነት ቦንቸትዳይሳታ፥ ናምኡ ዶና ኦደቶናይሳታ፥ ዳሮ ዎይነ ኡሹ ኡዮናይሳታ፥ ሚሸ ያረቶናይሳታ፥"]},{"type":"verse","number":9,"content":["አማኑዋ ፁራ ጌሻ ካሀን ናገይሳታ ግዳናዉ በሴስ።"]},{"type":"verse","number":10,"content":["ኤንቲ ኮይሮትድ ፓጨታናዉ ኮሼስ፤ ኤንታ ቦላ ቦረይ ባይና እፅኮ፥ ዎሳ ኬ ዳቆነ ግድድ ኦ።"]},{"type":"verse","number":11,"content":["ሄሳዳካ፥ ኤንታ ማጫሳት ቦንቸትዳይሳታ፥ ዝግሮናይሳታ፥ ማራን ደኤይሳታ፥ ኡባባን አማነተይሳታ ግዳናዉ በሴስ።"]},{"type":"verse","number":12,"content":["ዎሳ ኬ ዳቆነት እስ ማች ፃላል ደኤይሳ ግዶ። ባ ናይታነ ባ ኬ ሎይ አይሰይሳ ግዳናዉ በሴስ።"]},{"type":"verse","number":13,"content":["ዎሳ ኬ ዳቆነ ግድድ፥ ሎኦ ኦሶ ኦይሳት፥ ኤንታዉ ግታ ቦንቾ ቃስ ክርስቶስ የሱሳን ባንታዉ ደእያ አማኑዋባ ኦዳናዉ ዳሮ ምኖተ ደማና።"]},{"type":"heading","content":["አማኖ ግታ ፁራ"]},{"type":"verse","number":14,"content":["ታኒ ሀ ኪታ ነዉ ፃፋሸ፥ ኤለሳዳ ኔኮ ባና ጋዳ ኡፋይስ ዎይስ።"]},{"type":"verse","number":15,"content":["ሽን ታኒ ቦና ጋምእኮ፥ ፆሳ ኬን አሳይ ዋንድ ዳናዉ በሲያኮ ኤራና መላ ሀይሳ ነዉ ፃፋይስ። ደኦ ፆሳ ኬይ ቱማተስ ቱስነ ባሶ።"]},{"type":"verse","number":16,"content":["ኑ አማኑዋ ፁራይ ስይ ባይና ግታ።",{"text":"ክርስቶስ አሾ ማእድ ቆንጭስ፤","poem":1},{"text":"እያ ቱማተ ጌሻ አያናይ ማርካትስ።","poem":2},{"text":"ኪታንቾታስ በንትስ፤","poem":1},{"text":"እ ካዎተ ኡባስ ሳባከትስ።","poem":2},{"text":"አላመን ደእያ አሳን አማነትስ፤","poem":1},{"text":"ቦንቾን ሳሎ ኤከትስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/1TI/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/1TI/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/1TI/2.json","previousChapterAudioLinks":{},"numberOfVerses":16}