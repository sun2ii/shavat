{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"2CH","translationId":"gof_etw","name":"2 ታርከ ማፃፋ","commonName":"2 ታርከ ማፃፋ","title":"2 ታርከ ማፃፋ","order":14,"numberOfChapters":36,"sha256":"c612ffc4cbb7b26106fe941bd36ac9d5d1e66d711c6c899d68c5f373ac5b035e","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/2CH/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/gof_etw/2CH/36.json","totalNumberOfVerses":821},"chapter":{"number":27,"content":[{"type":"heading","content":["ይሁዳ ካዋ እዮአታማ"]},{"type":"verse","number":1,"content":["እዮአታም ካዎትያ ዎደ እያዉ ላይ ላታማነ እቻሻ፤ እ የሩሳላመን ታማነ ኡሱፑን ላይ ካዎትስ። እያ አየ ሱንይ ያሩሾ፤ እያ ሳዶቃ ናአ።"]},{"type":"verse","number":2,"content":["እያ አዋይ ኦዝያን ኦዳይሳዳ እዮአታም ጎዳ ስንን ሱረባ ኦስ። እያ አዋይ ፆሳ ኬ ገልዳይሳዳ እ ገልበና፤ ግዶሽን፥ አሳይ ናጋራ ኦሶ አግቤና።"]},{"type":"verse","number":3,"content":["እዮአታም ፆሳ ኬ ገልያ ቆሞ ፐንግያ ዛሪድ ኦስ፤ የሩሳላመ ኦፌላ ደርያ ቦላ ዳሮ ኦሶ ኦስ።"]},{"type":"verse","number":4,"content":["ደረይ ዳርያ ይሁዳ ቢታን ካታማታ ኬፅስ፤ ዎር ዳርያ ዙማ ቦላ ሚፃነ አዱሳ ግምበ ሻኮታ ግምብስ።"]},{"type":"verse","number":5,"content":["እዮአታም አሞነ ካዉዋራ ኦለትድ ፆንስ። አሞነት ሄ ላይ ሄ ሙኩሉነ ኦይዱ ፄቱ ክሎ ግራመ ብራ፥ ታሙ ሙኩሉ ኩንታለ ግድያ ግስተነ ታሙ ሙኩሉ ኩንታለ ግድያ ባንጋ እያዉ ጊርዶሶና። አሞነት ናምአን ላይነ ሄን ላይ ሄሳዳ እያዉ ጊርዶሶና።"]},{"type":"verse","number":6,"content":["እዮአታም ጎዳ ባ ፆሳ ስንን ሱረ ሄመትዳ ግሾ ዳሮ ምንስ።"]},{"type":"verse","number":7,"content":["እዮአታማ ዎደ ኦሰትዳ ኦሶት፥ እ ኦለትዳ ኦላይነ እ ኦዳባ ኡባይ እስራኤለ ካዎታነ ይሁዳ ካዎታ ታርከ ማፃፋን ፃፈትስ።"]},{"type":"verse","number":8,"content":["እዮአታም ካዎትያ ዎደ እያዉ ላይ ላታማነ እቻሻ፤ እ የሩሳላመን ታማነ ኡሱፑን ላይ ካዎትስ።"]},{"type":"verse","number":9,"content":["እዮአታም ሀይቅድ ባ ማይዛታ ጋክስ። ኤንቲ እያ ዳዊታ ካታማን ሞግዶሶና። እያ በሳን እያ ናአይ አካዝ ካዎትስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/2CH/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/2CH/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/2CH/26.json","previousChapterAudioLinks":{},"numberOfVerses":9}