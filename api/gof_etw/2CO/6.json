{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"2CO","translationId":"gof_etw","name":"2 ቆሮንቶሳ ኪታ","commonName":"2 ቆሮንቶሳ ኪታ","title":"ጳዉሎስ ቆሮንቶሳ አሳስ ፃፍዳ ናምአን ኪታ","order":47,"numberOfChapters":13,"sha256":"ebf17cb19e39a767d757abcb480fe6083821cf867be75e158e1722e1316b589d","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/2CO/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/gof_etw/2CO/13.json","totalNumberOfVerses":257},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":["ኑኒ ፆሳራ እስፈ ኦያ አስ ግደይሳዳ፥ ህንተ ኤክዳ አ ኬሀተ ሀዳ ኦና መላ ኑ ህንተና ዎሶስ።"]},{"type":"verse","number":2,"content":["ፆሳይ፥",{"text":"“ታ ነና ስአና ዎደን ስአስ፤","poem":1},{"text":"አቶተ ጋላሳን ነና ማዳስ” ያጌስ። ሄኮ፥ ታ ስእያ ዎደይ ሀእ፤ አቶተ ጋላሳይ ሀች።","poem":2}]},{"type":"verse","number":3,"content":["ኦንካ ኑ ኦሱዋ ቦራና መላነ ኑናን በታና መላ ኮዮኮ።"]},{"type":"verse","number":4,"content":["ግዶሽን፥ ኑ ቱማ ፆሳ ኦሳንቾታ ግደይሳ ኑ ኦያ ኡባባን በስዳ። ዳሮ ገንጫን፥ ዋየን፥ መቶን፥ ኡንአን፥"]},{"type":"verse","number":5,"content":["ጋራፈተን፥ ቃሾን፥ እፆን ኩምዳ ዎጫማን፥ ዳቡራን፥ ስኮ ዮን፥ ፆማን፥"]},{"type":"verse","number":6,"content":["ጌሻተን፥ ኤራተን፥ ዳንዳአን፥ ኬሀተን፥ ጌሻ አያናን፥ ቱማ ሲቆን፥"]},{"type":"verse","number":7,"content":["ቱማ ኦዳንነ ፆሳ ዎልቃን ኑኒ እያ ኦሳንቾታ ግደይሳ በስዳ። ቃስ ፅሎተይ ኑስ ቶራነ ጎንዳለ።"]},{"type":"verse","number":8,"content":["ኑኒ ቦንቸትዳነ ቶሸትዳ፤ ጫየትዳነ ጋላተትዳ። ቱማ ሃሳዮስ፥ ሽን አሳይ ኑና ዎርዳንቾ ግዶሶና።"]},{"type":"verse","number":9,"content":["ኑ አሳን ኤረትዳ አስ፥ ሽን ኤረቶና አሳ መላ ግድዳ። ሀይቅዶሶና ያገትዳ፥ ሽን ፓፃ ደኦስ፤ ሾጨትዳ፥ ሽን ሀይቅቦኮ።"]},{"type":"verse","number":10,"content":["ኑኒ አዛንኮካ ኡባ ዎደ ኡፋይቶስ። ኑ ማንቆ ዳኖስ፥ ሽን ዳሮ አሳ ዱረዮስ። ቃስ አይኮይካ ባይና አስ ዳኖስ፥ ሽን ኡባይ ኑባ።"]},{"type":"verse","number":11,"content":["ቆሮንቶሳ አሳቶ፥ ኑ ህንተዉ ቆንጨን ኦድዳ፤ ኑ ኡሉዋ ህንተና በስዳ።"]},{"type":"verse","number":12,"content":["ህንተ ኑና ህንተ ሲቁዋ በሶና ድግደታፐ አትሽን፥ ኑኒ ኑ ሲቁዋ ህንተና ድግቦኮ።"]},{"type":"verse","number":13,"content":["አዉ ባ ናይታስ ኦደይሳዳ ታ ህንተዉ ኦዳይስ፤ ኑ ህንተና ኑ ኡሉዋ በስዳይሳዳ፥ ህንተካ ህንተ ኡሉዋ ኑና በስተ።"]},{"type":"heading","content":["አማኖና አሳራ ደእያ ጋሄተ"]},{"type":"verse","number":14,"content":["አማኖና አሳራ በሶና ኦገን ዋፀቶፍተ። ፅሎተስነ ናጋራስ አይብ ጋሄተ ደኢ? ፖኦስነ ማስ አይብ እስፈተ ደኢ?"]},{"type":"verse","number":15,"content":["ክርስቶሳነ ፃላሄ እስፈ ጋያባይ አይቤ? ቃስ አማነይስነ አማኖናይስ እስፈ ኮፅያባይ አይቤ?"]},{"type":"verse","number":16,"content":["ፆሳ ኬስ ኤቃታራ አይብ እስፈተ ደኢ? ፆሳይ፥",{"text":"“ታኒ ኤንታ ግዶን ደአና፥","poem":1},{"text":"ኤንታ ግዶን ሄመታና።","poem":2},{"text":"ታኒ ኤንታ ፆሳ ግዳና፤","poem":1},{"text":"ኤንትካ ታ አሰ ግዳና”","poem":2},"ግዳይሳዳ፥ ኑኒ ደኦ ፆሳ ኬ።"]},{"type":"verse","number":17,"content":["ሄሳዳካ፥ ጎዳይ፥",{"text":"“ኤንታ ግዶፈ ሻከትድ ከይተ፤","poem":1},{"text":"ቱና ግድዳባ ቦቾፍተ፤","poem":2},{"lineBreak":true},{"text":"ታ ህንተና ኤካና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ታ ህንተዉ አዋ ግዳና፤","poem":1},{"text":"ህንተ ታዉ አደ ናይታነ ማጫ ናይታ ግዳና፤","poem":2},{"lineBreak":true},{"text":"ያጌስ ኡባፈ ዎልቃማ ጎዳይ” ያግስ።","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/2CO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/2CO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/2CO/5.json","previousChapterAudioLinks":{},"numberOfVerses":18}