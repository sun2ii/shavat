{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"2SA","translationId":"gof_etw","name":"2 ሳሜላ ማፃፋ","commonName":"2 ሳሜላ ማፃፋ","title":"2 ሳሜላ ማፃፋ","order":10,"numberOfChapters":24,"sha256":"7637848282362392df7196c6e9be07afb55c586825847d1aa10d8b99d031d229","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/gof_etw/2SA/24.json","totalNumberOfVerses":695},"chapter":{"number":1,"content":[{"type":"heading","content":["ዳዊቲ ሳኦላ ሀይቁዋ ስእስ"]},{"type":"verse","number":1,"content":["ሳኦል ሀይቅዳፐ ጉየ፥ ዳዊቲ አማለቃታ ፆን ስሚድ ፅቅላጋን ናምኡ ጋላስ ጋምእስ።"]},{"type":"verse","number":2,"content":["ሄን ጋላስ እስ አደይ ባ ማኡዋ ዳክድ፥ ባ ሁጰን ባና ቆልድ፥ ሳኦል ዱንካንዳ ጉታፐ ይስ። እ ዳዊታኮ ይድ ሳአን ጉፋንድ ዝግስ።"]},{"type":"verse","number":3,"content":["ዳዊቲ፥ “ኔኒ አዋፐ ያዲ?” ያግድ ኦይችስ። እ ዛሪድ፥ “ታኒ እስራኤለት ዱንካንዳ ጉታፐ ከሳ ኤካዳ ያስ” ያግስ።"]},{"type":"verse","number":4,"content":["ዳዊቲ፥ “አነ ሀንዳባ ታዉ ኦዳ” ያግስ። እ ዛሪድ፥ “ኑ ኦላንቾት ኦላፐ ባቃትዶሶና፤ ኑ አሳፐ ዳሮት ሀይቅዶሶና፤ ሳኦልነ እያ ናአይ ዮናታን ሀይቅዶሶና” ያግስ።"]},{"type":"verse","number":5,"content":["ዳዊቲ እያዉ ኦድዳ ፓን፥ “ሳኦልነ እያ ናኣ ዮናታን ሀይቅዳይሳ ኔኒ አይብን ኤራይ?” ያግድ ኦይችስ።"]},{"type":"verse","number":6,"content":["ፓንይ፥ “ታኒ ግልቦአ ደርያ ቦላ ደእሽን፥ ሳኦል ባ ቶራ ጉፈትድ ኤቅዳይሳ በአስ፤ ፓራ ጋረትነ ፓራ አሳት ሳኦላኮ ማታትዶሶና።"]},{"type":"verse","number":7,"content":["ሄ ዎደ ሳኦል ጉየ ስሚድ ታና ደምድ ፄግስ። ታኒ፥ ‘ዬ’ ያጋዳ ኮያስ።"]},{"type":"verse","number":8,"content":["ሳኦል፥ ‘ኔኒ ኦኔ?’ ያግድ ኦይችን፥ ‘ታኒ አማለቃ አስ’ ያጋዳ ዛራስ።"]},{"type":"verse","number":9,"content":["ሄሳፈ ጉየ ሳኦል፥ ‘ታኒ ማዱንፃዳ፥ ሀይቆስ ጋካስ፤ ኔኒ ታ ቦላ ከይያ ኤቃዳ ታና ዎ’ ያግስ።"]},{"type":"verse","number":10,"content":["እ ኩንድዳፐ ጉየ ሀይቆፐ አቶናይሳ ኤርዳ ግሾ ታኒ እያ ቦላ ከያ ኤቃዳ እያ ዎስ። እያ ሁጰን ደእያ ካላቻነ እያ ቀሰን ደእያ አምባርያ ኤካዳ ኔኮ ታ ጎዳኮ ያስ” ያግስ።"]},{"type":"verse","number":11,"content":["ዳዊቲነ ዳዊታ አሳይ ካዮትድ፥ ባንታ ማኡዋ ዳክዶሶና።"]},{"type":"verse","number":12,"content":["ኤንቲ ሳኦል፥ ዮናታን፥ ጎዳ ኦላንቾትነ እስራኤለ አሳይ ኦላን ዉርዳ ግሾ ኦማርስ ጋካናዉ ካዮትዶሶና፤ ዬክዶሶና፤ ፆምዶሶና።"]},{"type":"verse","number":13,"content":["ዳዊቲ ሄሳ ኤንታዉ ኤህዳ ፓን፥ “ነ አዉፐ ያዲ?” ያግድ ኦይችስ። እ ዛሪድ፥ “ታኒ በተ አስ ግድድ ደእያ አማለቃ አድያ ናአ” ያግስ።"]},{"type":"verse","number":14,"content":["ዳዊቲ፥ “ጎዳይ ትይዳ ካዋ ዎናዉ ነ ኩሽያ ደንሸ ዋናዳ ያያብኪ?” ያግስ።"]},{"type":"verse","number":15,"content":["ዳዊቲ ባ አሳታፐ እሱዋ ፄግድ፥ “እያ ዎ” ያግን፥ እ አማለቃ ፓን ጫድድ ዎስ።"]},{"type":"verse","number":16,"content":["ዳዊቲ አማለቃ አድያኮ፥ “ጎዳይ ትይዳ ካዋ ታኒ ዎስ” ያጋዳ “ኔኒ ነ ዶናን ማርካትዳ ግሾ ነ ሱ ጎመይ ነና ኦይኮ” ያግስ።"]},{"type":"heading","content":["ዳዊቲ ሳኦላስነ ዮናታናስ ዬክስ"]},{"type":"verse","number":17,"content":["ዳዊቲ ሳኦላስነ እያ ናኣ ዮናታናስ ሀይሳዳ ያግድ ዘሌልስ።"]},{"type":"verse","number":18,"content":["ይሁዳ አሳይ፥ “ዶንገ ዬሆ” ጌተትያ ሀ ዘለልሳ ታማራና መላ ኪትስ፤ ሀ ዘለልሳይ ያሻራ",{"noteId":0},"ማፃፋን ፃፈትስ።"]},{"type":"verse","number":19,"content":[{"text":"“ነኖ እስራኤለ፥ ነ ሀላቃት፥","poem":1},{"text":"ቃ በሳን ሀይቅዶሶና።","poem":2},{"lineBreak":true},{"text":"ዎልቃማት ዋንድ ኩንድዶና!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ፍልስፄመ ማጫ ናይት ሄሳ ስእድ ኡፋይቶና መላ፥","poem":1},{"text":"ቃፃረትቦና አሳ ማጫ ናይት ሀሹ ጎና መላ፥","poem":2},{"lineBreak":true},{"text":"ሀይሳ ጋተ ካታማን ኦዶፕተ","poem":2},{"lineBreak":true},{"text":"አስቃሎና ኦገታን አዋጆፍተ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ህንተኖ ግልቦአ ደረቶ፥","poem":1},{"text":"ህንተ ቦላ እር ቡኮፎ፤ አክ ዎፎ።","poem":2},{"text":"ሄ በሳን ዎልቃማታ ጎንዳለይ ቱንዳ ግሾ፥","poem":1},{"lineBreak":true},{"text":"ሳኦላ ጎንዳለይ ዛይተን ቁሸትቦና ግሾ፥","poem":1},{"text":"ሄ ጋድያን ካ ዶሎፖ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ጎይረትዳይሳታ ሱፈ፥","poem":1},{"text":"ዎልቃማታ ሞዋፈ፥","poem":2},{"text":"ዮናታና ዶንገይ ጉየ ግቤና፤","poem":1},{"text":"ሳኦላ ማሻይ ካሎና ስምቤና።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ሳኦልነ ዮናታን ዶሰተይሳታ፤","poem":1},{"text":"ሀይቆንነ ፓፃን ሻከትቦኮና።","poem":2},{"text":"ኤንቲ አርጋንፈ አድ ኤሶ፤","poem":1},{"text":"ጋሞፈ አድ ምኖ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ህንተኖ እስራኤለ ማጫሳዉ፥","poem":1},{"text":"ዞኦነ አሌቆ ማኦ ማይዝዳይሳስ፥","poem":2},{"lineBreak":true},{"text":"ህንተ ማኡዋ ዎርቃን አሌቅስዳ ሳኦላስ ዬክተ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ዎልቃማት ኦላን ዋንድ ኩንድዶና?","poem":1},{"text":"ዮናታን ቃ በሳን ሀይቅስ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ታ እሻ ዮናታና፥ ታ ነዉ አዛናይስ፤","poem":1},{"text":"ነ ታዉ ዳሮ አልኦ።","poem":2},{"text":"ኔኒ ታና ዶስያ ዶሶይ ማላልሴስ፤","poem":1},{"text":"ማጫ ሲቆፐካ አስ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ዎልቃማት ዋንድ ኩንድዶና?","poem":1},{"text":"ኦላ ሚሸይካ ዋንድ ይዴ?”","poem":2},"ያግድ ዳዊቲ ዘሌልስ።"]}],"footnotes":[{"noteId":0,"caller":"+","text":"ያሻራ፦ ፅሎታ ማፃፋ ጉሱ","reference":{"chapter":1,"verse":18}}]},"thisChapterLink":"/api/gof_etw/2SA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/2SA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/1SA/31.json","previousChapterAudioLinks":{},"numberOfVerses":27}