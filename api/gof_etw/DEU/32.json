_break"},{"type":"verse","number":7,"content":[{"text":"በን ዎድያ ቆፓ፤","poem":1},{"text":"አዳ የለተ አኬካ።","poem":2},{"text":"ነ አዋ ኦይቻ፤ እ ነዉ ኦዳና፤","poem":1},{"text":"ጭማታ ኦይቻ፤ ኤንቲ ነዉ ቆንጭሳና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኡባፈ ዎልቃማይ ካዎተታስ","poem":1},{"text":"ኤንታ ላታ ሻክዳ ዎደ፥","poem":2},{"lineBreak":true},{"text":"አሳ ዘረካ ዱማይዳ ዎደ፥","poem":2},{"text":"እስራኤለ አሳ ታይቡዋ መላ፥","poem":1},{"text":"አሳስ ኤንታ ዛዋ ኤስስ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ጎዳ ጋክዳ ግሾይ እስራኤለ፤","poem":1},{"text":"ያይቆብ እያ ጋክዳ ላታ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"እ ኤንታ መላ ቢታን፥","poem":1},{"text":"አይኮይ ባይና መላ ቢታን፥","poem":2},{"lineBreak":true},{"text":"ጫርኮይ ባቅሽን ደምስ።","poem":2},{"text":"እያዉ ጎንዳለ ግድስ፥ እያ ናግስ፤","poem":1},{"text":"ባ አይፈ ናኤዳ ምንድ ናግስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አርጋን ባ ናአ ፓሎ ታማርሰይሳዳ፥","poem":1},{"text":"ባ ምጭዳ ቀፍያን ጋክድ አሸይሳዳ፥","poem":2},{"lineBreak":true},{"text":"ጎዳይ ባ ቀፍያን ሀጵድ ኤንታ አሽስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ጎዳይ ባ ፃላላ ኤንታ ካለስ፤","poem":1},{"text":"ሀራ አላጋ ፆሲ እያራ ባዋ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"እ ቢታስ ቃ በሳ ኤንታ ከስስ፤","poem":1},{"text":"ጎሻ አይፍያ ኤንታ ሙዝስ።","poem":2},{"text":"ዛላ ቆጶፐ ኤንታ ኤስ ካልስስ፤","poem":1},{"text":"ሹቻ ቢታፈ በንትያ ዛይተ ኡሽስ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኤንታ መህያፐ ቄሳ ማ፥","poem":1},{"text":"ዶርሳፈነ ዴሻፐ ፃማታ ማ፥","poem":2},{"lineBreak":true},{"text":"ሞ ዶርሰነ ዴሻ አሾ ምዶሶና።","poem":2},{"text":"ባሳነ ዶርሳነ ዴሻ አሹዋ፥","poem":1},{"text":"ሎኦ ግስተ ኡይራ ምዶሶና፤","poem":2},{"lineBreak":true},{"text":"ሱ ዳንያ ዎይነ ኡሻ ኡይዶሶና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ሽን እስራኤለይ ኦርድስ፤ ማካልስ፤","poem":1},{"text":"ምድ ካልድ ሞሎትስ።","poem":2},{"text":"ባና መዳ ፆሳ አግስ፤","poem":1},{"text":"ባ አቶተ ዛላ ካዉሽስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኤንቲ አላጋ ፆሳታ ጎይንድ፥","poem":1},{"text":"እያ ቃናትስዶሶና።","poem":2},{"text":"እፀትዳ ባንታ ኤቃ