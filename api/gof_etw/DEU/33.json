":["ሙሰይ ይሁዳ ኮቻባ፥",{"text":"“ጎዳዉ፥ ይሁዳ ዋሱዋ ስአ፤","poem":1},{"text":"ሀንኮ እያ ያራታራ እያ ቡአ።","poem":2},{"text":"ኤንታ ኩሽያ ምን፤","poem":1},{"text":"ኤንቲ ባንታ ሞርከታራ ኦለትያ ዎደ","poem":2},{"lineBreak":true},{"text":"ኤንታ ማዳ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሙሰይ ሌወ ኮቻባ፥","poem":1},{"text":"ነ ቱሚመይነ ኡሪመይ፥","poem":2},{"lineBreak":true},{"text":"ኔኒ ማሳሀን ፓጭዳነ ማርባን ፓላምዳ፥","poem":2},{"lineBreak":true},{"text":"ነ ጌሻ አሳሳ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ባንታና የልዳይሳታፐ፥","poem":1},{"text":"ባንታ እሻታፐነ ባንታ ናይታፐ አድ፥","poem":2},{"lineBreak":true},{"text":"ኤንቲ ነዉ አማነትዶሶና፤","poem":2},{"lineBreak":true},{"text":"ነ ጫቆ ቃላ ናግዶሶና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኤንቲ ነ ዎጋ ያይቆባ፥","poem":1},{"text":"ነ ህግያ እስራኤለ ታማርሶሶና።","poem":2},{"text":"ኤንቲ ነ ስንን እፃነ ጩይሶሶና፤","poem":1},{"text":"ያርሾ በሳን ፁሳ ያርሾ ያርሾሶና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አቤት ጎዳዉ፥ ሌወታ አንጃ፤","poem":1},{"text":"ኤንታ ኩሸ ኦሱዋን ነ ኡፋይታ።","poem":2},{"text":"ኤንታ ቦላ ደንድያ ሞርከታ መንረ","poem":1},{"text":"ዛር ደንዶና መላ ኤንታ ሞርከታ ጫዳ።”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ብንያመ ኮቻባ፥","poem":1},{"text":"“ጎዳን ዶሰትዳይ እያን አማነትድ ደኤስ፤","poem":2},{"lineBreak":true},{"text":"ቃማ ጋላስ እ ኤንታ ናጌስ፤","poem":2},{"lineBreak":true},{"text":"ባ ሀሽያን ቶክድ ሸምፕሴስ።”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዮሰፋ ኮቻባ፥","poem":1},{"text":"“ጎዳይ፥ ሳሎፐ እራን፥","poem":2},{"lineBreak":true},{"text":"ሳአፐ ፑልቶ ሃን","poem":2},{"lineBreak":true},{"text":"ኤንታ ቢታ አንጆ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አዋን ካፅድ ዶረትዳ አይፈንነ","poem":1},{"text":"ዎደን ዎደን ካፅያ አይፈን አንጀቶ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"በንፐ ደእያ ደረትነ","poem":1},{"text":"ዙማት ሎኦ አይፈን አንጀቶ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኤንታ ቢታይ ሎኦባይ ኩምዳ ቢታ ግዶ፤","poem":1},{"text":"ቱሽያ ግዶን ኤፅያ ታማን ቆንጭዳ ጎዳይ እያ አንጆ።","poem":2},{"text":"ሀ አንጆት ኡባይ ዮሰፋ ኮቻ ጋኮ፤","poem":1},{"text":"እ ባ እሻታ ግዶን ሀላቃ ግዶ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዮሰፍ ኮይሮ የለትዳ ኮርማዳ ምኖ፤","poem":1},{"text":"እያ ካጨት መን ካጨዳ ምኖ።","poem":2},{"text":"እያ ካጨት ታሙ ሙኩሉን ታይበትያ ኤፍሬማ ኮቻታ፤","poem":1},{"text":"ሙኩላን ታይበትያ ምናሰ ኮቻታ።","poem":2},{"text":"ሄ ካጨታን እ ካዎተታ ቃይጫና፤","poem":1},{"text":"ቢታ ጋፃ ጋካናዉ እ ኤንታ ሱጋና።”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዛብሎና ኮቻባ፥","poem":1},{"text":"“ዛብሎና፥ ኔኒ ነ ከሳን ኡፋይታ፤","poem":2},{"lineBreak":true},{"text":"ይሳኮራ፥ ኔኒ ነ ዱንካንያን ኡፋይታ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ኤንቲ አሳ ባንታ ዙማኮ ፄጋና፤","poem":1},{"text":"ያን ኤንቲ ጌሻተ ያርሾ ያርሻና።","poem":2},{"text":"ባንታ አቁዋነ ባንታ ዱረተ፥","poem":1},{"text":"አባፈነ አባ ጋፃን ደእያ ሻፍያፐ ደማና” ያግስ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ጋደ ኮቻባ፥","poem":1},{"lineBreak":true},{"text":"“ኤንታ ቢታ ዳልግስዳ ጎዳይ ጋላተቶ፤","poem":1},{"text":"ጋድ ሞርከ ሶምኦ ዎይኮ ቀሰ መንናዉ፥","poem":2},{"lineBreak":true},{"text":"ጋሞዳ ናጌስ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ኤንቲ ሎኦ ቢታ ባንታዉ ዶርዶሶና፤","poem":1},{"text":"ሀላቃታስ ግዳ ቢታ ኤንቲ ኤክዶሶና።","poem":2},{"text":"እስራኤለ ሀላቃት ሺቅዳ ዎደ፥","poem":1},{"text":"ጎዳ ጌሻ ሸንያ ሻክድ ኤርዶሶና","poem":2},{"lineBreak":true},{"text":"እስራኤለስ ሱረ ፕርዳ ፕርድዶሶና” ያግስ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዳነ ኮቻባ፥","poem":1},{"lineBreak":true},{"text":"“ዳነይ ዎዳላ ጋሞ መላ፤","poem":1},{"text":"እ ባሳነፐ ጉፕድ ከያና” ያግስ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ንፍታለመ ኮቻባ፥","poem":1},{"lineBreak":true},{"text":"“ንፍታለመይ ጎዳ አ ኬሀተን፥","poem":1},{"text":"እያ አንጁዋን ዱረትስ፤","poem":2},{"lineBreak":true},{"text":"ኤንታ ቢታይ አባፈ ዱገሀ ባጋ ጋኬስ” ያግስ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"አሴራ ኮቻባ፥","poem":1},{"lineBreak":true},{"text":"“አሴር ሀራ ኮቻታፐ አድ አንጀትዳይሳ፤","poem":1},{"text":"ባ እሻታን ዶሰትዳይሳ ግዶ፤","poem":2},{"lineBreak":true},{"text":"እያ ቢታይ ሻማሆ ዛይተን ዱረቶ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"እያ ካታማት ብራታ ፐንገን ጎርደትድ ናገቶ፤","poem":1},{"text":"ባ ላይ ኡባን እ ዎልቃማ ግዶ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"እስራኤለ፥ ሳሎፐ ነና ማዳናዉ፥","poem":1},{"text":"ባ ግታተን ሻራ ቦላ ሄመትያ፥","poem":2},{"lineBreak":true},{"text":"ነ ፆሳ መላ ፆሲ ኦኔ?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"መርና ፆሳይ ነ ደእያ በሲ፤","poem":1},{"text":"እያ መርና ኩሸት ኔፐ ጋርሳራ ደኦሶና።","poem":2},{"text":"እ ነ ሞርከታ ነ ስንፈ ከስድ፥","poem":1},{"text":"‘ኤንታ ይሳ’ ያግስ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ሄሳ ግሾ፥ እስራኤለ ኮቻይ፥","poem":1},{"text":"ሳሎ እራይ ቡክያ በሳን፥","poem":2},{"lineBreak":true},{"text":"ካነ ዎይነይ ኩምዳ ቢታን፥","poem":2},{"lineBreak":true},{"text":"ህርግ ባይና ሳሮ ዳና።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"እስራኤለ፥ ነ አንጀታዳይሳ፤","poem":1},{"text":"ጎዳይ አሽዳ ነ መል ኦኔ?","poem":2},{"text":"እ ነዉ ጎንዳለነ ማድያ ማሻ፤","poem":1},{"text":"ነ ሞርከት ነ ስንን ጉፋናና፤","poem":2},{"lineBreak":true},{"text":"ነ ኤንታ ባሱዋ ላላና” ያግስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}