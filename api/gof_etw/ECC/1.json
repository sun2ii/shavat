{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ECC","translationId":"gof_etw","name":"ኤራታ ማፃፋ","commonName":"ኤራታ ማፃፋ","title":"ኤራታ ማፃፋ","order":21,"numberOfChapters":12,"sha256":"07e59d88fa30d6408bbbf15a456d71576284acd1ef0903559b59372f5a524b9e","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/gof_etw/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":1,"content":[{"type":"heading","content":["ኡባባይ ሀዳ"]},{"type":"verse","number":1,"content":["ሀይስ፥ ዳዊታ ናኣ፥ የሩሳላመን ካዎትዳ ጭንጫ ኡራ ቃላ።"]},{"type":"verse","number":2,"content":[{"text":"ሄ ጭንጫይ፥ “ኡባባይ ሀዳ፤","poem":1},{"text":"ኡባባይ ሀዳፐ ሀዳ፤","poem":2},{"lineBreak":true},{"text":"ኡባባይ ኩመ ሀዳ” ያግስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ባ ደእያ በሳን ኡባን፥","poem":1},{"text":"አስ ዳቡርድ ኦያባ ኡባን","poem":2},{"lineBreak":true},{"text":"እያዉ ዎይ አይቤ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እስ የለተ አያ ዎደ፥ ሀራ የለተ በሳ ኦይኬስ።","poem":1},{"text":"ሽን ሀ ቢታይ መርናዉካ ላመቶና ደኤስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አው ዶሌስ ዉሌስ፤","poem":1},{"text":"ናምአን ዶላናዉ ያ ዶልያ በሳ ኤለሴስ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ጫርኮይ እስ ቶሆ ዱገ እስ ቶሆ ፑደ ጫርኬስ፤","poem":1},{"text":"ቃስ ዩይ ዩይ አድ፥ ስመረትድ ዬስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ጎግያ ሃ ኡባይ አባን ገሌስ፤","poem":1},{"text":"ሽን አባይ ኩም ኤረና።","poem":2},{"text":"ሄ ሃይ ስሚድ ጎጋናዉ፥","poem":1},{"text":"ጉየ ባ ፑልትያ በሳ ቤስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኡባባይ ሳለያባ፤","poem":1},{"text":"እ አይ መላ ሳለያኮ ኦድ ዉርሳናዉ ዳንዳኤተና።","poem":2},{"text":"አይፈይ ፄልድ ካል ኤረና፤","poem":1},{"text":"ሀይ ስእድ፥ ታዉ ግድስ ጌና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ካሰ ሀንዳባይ ዎንቶካ ስሚድ እ ሀናና፤","poem":1},{"text":"ቃስ ሀእ ሀንሸ ደኤይስ ካሰ ሀንዳባ።","poem":2},{"lineBreak":true},{"text":"ሄሳ ግሾ፥ ሳሎ ጉፋንን ኦራባይ አይብካ ባዋ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኦንካ፥ “ሄኮ፥ ሀይስ ኦራባ” ጊኮ፥","poem":1},{"text":"ሄስ ኦራ ግደና፤ ሄስ ኑኒ የለታናፐ ካሰ ሀንዳባ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ካሰ አዳ ዎደታን ሀንዳባታ ዛሪድ ሀሳያባይ ባዋ፤","poem":1},{"text":"ጉየፐ ሀናናባታ ኤንታፈ ጉየ ኦንካ ሀሳየና።","poem":2}]},{"type":"heading","content":["ጭንጫተ ሀዳ"]},{"type":"verse","number":12,"content":["ታኒ ጭንጫይ፥ የሩሳላመን እስራኤለስ ካዎ ግዳዳ ደአስ።"]},{"type":"verse","number":13,"content":["ታኒ ሳአን ደእያባ ኡባ ሻካዳ ኤራናዉነ ጭንጫተን ፕልጋዳ ፄላናዉ ቆፋ ቃቻስ። ያታዳ አሳ ኡባስ ፆሳይ እምዳ ደኦይ ዳሮ ዳቡርስያባነ ኡፋይሶናባ ግደይሳ አኬካስ።"]},{"type":"verse","number":14,"content":["ሳሎፐ ጋርሳን ሀንዳባ ኡባ ታኒ በአስ፤ ሽን ኡባይካ ሀዳ፤ ጫርኮ ኦይካናዉ የደይሳ መላ።"]},{"type":"verse","number":15,"content":[{"text":"ጌል ሱራናዉ ዳንዳኤና፤","poem":1},{"text":"ባይናባ ታይባናዉ ዳንዳኤተና።","poem":2}]},{"type":"verse","number":16,"content":["ታኒ ታ ዎዛናን ሀይሳዳ ያጋዳ ቆፓስ፤ “ታፐ ካሰ የሩሳላመ ሃርዳ ኡባታፐ ታኒ ግታነ ጭንጫ ግዳስ። ጭንጫተነ ኤራ ጉስ እ አይበኮ ፓጫዳ ኤራስ” ያጋስ።"]},{"type":"verse","number":17,"content":["ታኒ ጭንጫተፈ፥ ጎሻተፈነ ኤያተፈ ግዶን ደእያ ዱማተ አይበኮ ኤራናዉ ዳሮ ዳቡራስ። ሽን ዉርሰን ሄስካ ጫርኮ ኦይካናዉ የደይሳ መላ ሀዳ ግደይሳ ኤራስ።"]},{"type":"verse","number":18,"content":[{"text":"ጭንጫተ ዳርያ ዎደ አዛንያባይ ዳሬስ፤","poem":1},{"text":"ኤር ዳርያ ዎደ ቃስ መቶይ ዳሬስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ECC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ECC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PRO/31.json","previousChapterAudioLinks":{},"numberOfVerses":18}