{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ECC","translationId":"gof_etw","name":"ኤራታ ማፃፋ","commonName":"ኤራታ ማፃፋ","title":"ኤራታ ማፃፋ","order":21,"numberOfChapters":12,"sha256":"07e59d88fa30d6408bbbf15a456d71576284acd1ef0903559b59372f5a524b9e","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/gof_etw/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":11,"content":[{"type":"heading","content":["ዱማ ዱማ ዞረታ"]},{"type":"verse","number":1,"content":["ነ ካ ሃ ቦላ የጋ፤ ዳሮ ጋላሳፐ ጉየ ኔኒ ዛራዳ ደማና።"]},{"type":"verse","number":2,"content":["ነዉ ደእያ ሻሉዋ ላፑን ዎይኮ ሆስፑን በሳን ሻካዳ ዎ። ስንፈ ሀ ሳኣ ቦላ አይ ኢታባይ ያነኮ ኔኒ ኤራካ።"]},{"type":"verse","number":3,"content":["ሻር እራ ቶክኮ ቢታ ቦላ እር ቡኬስ። ም ፑደ ኩንድን ዱገ ኩንድን ባ ኩንድዳ በሳን ደኤስ።"]},{"type":"verse","number":4,"content":["ጫርኮ ናግያ ኦንካ ካ ዘረና፤ ሻር ደንዳና ጋካናዉ ናግያ ኦንካ ባ ካ ጫከና።"]},{"type":"verse","number":5,"content":["ጫርኮይ ብያ ኦግያነ ናእ ባ አየ ኡሎን ዋንድ መትያኮ ነ ኤሮናይሳዳ ኡባባ መዳ ፆሳይ ባ ኦሱዋ ዋት ኦያኮ ኤራናዉ ዳንዳአካ።"]},{"type":"verse","number":6,"content":["ጉራ ግድን ኦማርስ ነ ዘረ ዘረይሳ አጎፋ፤ ዎንታይስ ዎይኮ ኦማርሳይስ ሎአነኮ ኔኒ ኤራካ።"]},{"type":"heading","content":["ነ ናአተ ዎደን ፆሳ ቆፓ"]},{"type":"verse","number":7,"content":["ፖኦይ ኡፋይስያባ፤ አዋ አይፈ በኦይ ሎኦባ።"]},{"type":"verse","number":8,"content":["አስ አዱሳ ላይ ሀ ሳአን ደእኮ ሄ ላይን ኡፋይቶ። ሽን ሀ አላምያባይ ሀዳ ግደይሳነ ያና ማ ዎደይ መርናዉ ዳናይሳ ቆፖ።"]},{"type":"verse","number":9,"content":["ነኖ ናአተዉ፥ ናአተ ዳሮ ሎኦባ ግድያ ግሾ ነ ናአተ ላይን ኡፋይታ፤ ነ ዎዛናይካ ኡፋይቶ። ነ አይፈይ በእዳባነ ነ ዎዛናይ አሞትዳባ ኡባ ፖላ። ሽን ሄ ኔኒ ኦዳባ ኡባ ግሾ ነና ፆሳይ ፕርዳናዉ ደኤይሳ ዶጎፓ።"]},{"type":"verse","number":10,"content":["ናአተነ ጎባተ ሀዳ ግድያ ግሾ ነ ዎዛናፐ አዛኖ፥ ነ አሳተፈ ኢታተ ድጋ።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ECC/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ECC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ECC/10.json","previousChapterAudioLinks":{},"numberOfVerses":10}