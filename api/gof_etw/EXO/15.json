{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"EXO","translationId":"gof_etw","name":"ከሳ ማፃፋ","commonName":"ከሳ ማፃፋ","title":"ከሳ ማፃፋ","order":2,"numberOfChapters":40,"sha256":"0d7f82088e6af586b787b3f024919e94334b1b2c5ad471c0b077b4d814c0624b","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/gof_etw/EXO/40.json","totalNumberOfVerses":1212},"chapter":{"number":15,"content":[{"type":"heading","content":["ሙሰነ ማይራም ማዝሙረ"]},{"type":"verse","number":1,"content":["ሄ ዎደ ሙሰይነ እስራኤለ አሳይ ሀ ማዝሙርያ ጎዳስ የፅዶሶና።",{"lineBreak":true},{"text":"እ ባ ግታ ፆኑዋን ቦንቸትዳ ግሾ፥","poem":1},{"text":"ታኒ ታ ጎዳስ ጋላታ ማዝሙርያ የፃና።","poem":2},{"lineBreak":true},{"text":"ፓራነ ፓራ ቶገይሳ አባን የግስ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ጎዳይ ታ ምኖተነ ታ ማዝሙርያ ጋሱዋ፥","poem":1},{"text":"እ ታና አሸይሳ።","poem":2},{"text":"እ ታ ፆሳ፤ ታኒ እያ ሳባና።","poem":1},{"text":"እ ታ አዋታ ፆሳ፤ ታኒ እያ ቦንቻና፤ ጋላታና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ጎዳይ ኦላንቾ፤","poem":1},{"text":"እያ ሱንይካ ጎዳ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ግብፀ ካዉዋ ፓራ ጋረታነ እያ ኦላንቾታ አባን የግስ።","poem":1},{"text":"ግብፀ ካዉዋ፥ ኡባፈ አ ግድዳ ቶራ ሞጮናታ፥ ዞኦ አባን ምትስስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኤንታና ጪሞ ሃይ ምትስ፤","poem":1},{"text":"ኤንቲ ሹቻዳ ጪሞን ምተትዶሶና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“አቤት ጎዳዉ፥ ነ ኡሻቻ ኩሸይ ዎልቃን ጎባ፤","poem":1},{"text":"ነ ኩሸይ ሞርክያ መንረስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ነ ግታ ፆኑዋን፥","poem":1},{"text":"ኔራ ኤቀተይሳታ ኦላዳሳ።","poem":2},{"text":"ነ ሸነይ ታማዳ ኤፅድ፥","poem":1},{"text":"ኤንታ ካፍለዳ ምስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ነ ሀንቁዋን ነ አባ ፑንን፥","poem":1},{"text":"ሃይ ጎዳዳ ኤቅስ።","poem":2},{"lineBreak":true},{"text":"አባ ጪሞት ጋርሳን ሹቻዳ ምንዶሶና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ሞርከይ፥ ‘ታኒ ኤንታ የደዳ ኦይካና፤","poem":1},{"text":"ታኒ ኤንታ ሻሉዋ ሻካዳ፥","poem":2},{"lineBreak":true},{"text":"ታ ኮይዳባ ኡባ ኤካና።","poem":2},{"lineBreak":true},{"text":"ታኒ ታ ማሻ ሾዳዳ ኤንታ ይሳና’ ያግድ ጬቀትስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሽን ኔኒ ኤንታ ፑንን፥ አባይ ኤንታ ምትስ።","poem":1},{"text":"ኤንቲ አባ ጪሙዋን ብራታዳ ምተትዶሶና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አቤት ጎዳዉ፥ ፆሳታ ግዶን ነ ማል ኦኔ?","poem":1},{"text":"ጌሻተን ያሸይ ነ ማል ኦኔ?","poem":2},{"lineBreak":true},{"text":"ቦንቾይ ዳጋንይነ ማላልስያባ ኦይ ነ ማል ኦኔ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኔኒ ነ ኡሻቻ ኩሽያ ምጭዳ ዎደ፥","poem":1},{"text":"ቢታይ ኤንታ ምትስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ኔኒ ዎዝዳ አሳ ነ መርና ሲቁዋን ካለዳሳ።","poem":1},{"text":"ኔኒ ነ ዎልቃን ኤንታ ነ ጌሻ ቢታ ገልሳዳሳ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ካዎተት ሄሳ ስእድ ያሻን ኮኮርዶሶና።","poem":1},{"text":"ፍልስፄመ ቢታ አሳትካ ኡንኤትዶሶና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሄ ዎደ ኤዶመ ቢታ ሀላቃት ዳጋምዶሶና፤","poem":1},{"text":"ሞአበ ቢታ ሃረይሳት ያሻን ኮኮርዶሶና፤","poem":2},{"text":"ካናነ አሳት ዳጋማን ዳቡርዶሶና።","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ዳጋምነ ያሽ ኤንታ ኦይክስ።","poem":1},{"lineBreak":true},{"text":"አቤት ጎዳዉ፥ ኤንቲ ነ ዎልቃ ግታተ በእድ፥","poem":1},{"text":"ነ አሳይ አና ጋካናዉ፥","poem":2},{"lineBreak":true},{"text":"ኔኒ ዎዝዳ አሳይ አና ጋካናዉ፥","poem":2},{"lineBreak":true},{"text":"ሹቻዳ ቶለትድ ኤቅዶሶና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ኔኒ ኤንታ ኤሀዳ፥ ነ ዙማ ሁጰን ቶካና።","poem":1},{"text":"አቤት ጎዳዉ፥ ሄ በሳይ ኔኒ ነዉ ዳናዉ ዶርዳ በሲ፥","poem":2},{"lineBreak":true},{"text":"ኔኒ ነ ኩሽያን ምንዳ ኬፅዳ ነ ኬ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ጎዳይ መርና ጋካናዉ ካዎታና”","poem":1},{"text":"ያግድ የፅዶሶና።","poem":2}]},{"type":"verse","number":19,"content":["እስራኤለት አባ ግዶራ መላ ቢታራ ፕንን፥ ግብፀ ካዉዋ ፓራት፥ እያ ፓራ ጋረትነ እያ ፓራ ቶገይሳት አባን ገልዳ ዎደ ጎዳይ ኤንታ ቦላ አባ ሃ ዛርን ሃይ ኤንታ ምትስ።"]},{"type":"verse","number":20,"content":["አሮና ምችያ፥ ናብያ ማይራማ ካራቦ ኤካሱ። ሀራ ማጫሳት ኡባይ ባንታ ካራቦ ኤክድ ባቅሸነ የፅሸ እዮ ካልዶሶና።"]},{"type":"verse","number":21,"content":["ማይራማ፥",{"text":"“እ ባ ግታ ፆኑዋን ቦንቸትዳ ግሾ፥","poem":1},{"text":"ፓራነ ፓራ ቶገይሳታ እ አባን የግዳ ግሾ፥","poem":2},{"lineBreak":true},{"text":"እያዉ ማዝሙርያ የፅተ” ያጋዳ ኤንታዉ የፃሱ።","poem":2}]},{"type":"heading","content":["ጫሞ ሃ"]},{"type":"verse","number":22,"content":["ሄሳፈ ጉየ፥ ሙሰይ ዞኦ አባ ማታፐ እስራኤለታ ደንድ ሹራ መላ ቢታ ጋካናዉ ካለስ። ሄ መላ ቢታን ኤንቲ ሄ ጋላስ ሄመትዶሶና ሽን ሃ ደምቦኮና።"]},{"type":"verse","number":23,"content":["ኤንቲ ማራ ጌተትያ በሲ ጋክድ ሃ ደምዶሶና፥ ሽን ሃይ ጫሞ ግድያ ግሾ ኡያናዉ ዳንዳእቦኮና። ሄሳ ግሾ ሄ በሳይ ማራ",{"noteId":4},"ጌተትስ።"]},{"type":"verse","number":24,"content":["አሳይ፥ “ኑኒ አይ ኡያኔ?” ግድ ሙሰ ቦላ ዙዙምዶሶና።"]},{"type":"verse","number":25,"content":["ያንን፥ ሙሰይ ጎዳኮ ዋስስ፤ ጎዳይ እያ እስ ም በስስ። ሙሰይ ሄ ም ሃን የግን ሃይ ማልእስ። ያን ጎዳይ ኤንታዉ ህገ እሚስ፤ ያን ጎዳይ ኤንታ ፓጭስ።"]},{"type":"verse","number":26,"content":["ሙሰይ ኤንታኮ፥ “ህንተ ህንተ ጎዳ ፆሳስ ኪተትተ፤ እ ኮያባ ኦተ። ህንተ ታዉ ፖሎ ኪተትኮነ ታ ግያባ ስእኮ ግብፀታ ቦላ ታ የድዳ ሀርግያን ህንተና ፕርድከ። ታኒ ህንተና ፓያ ጎዳ” ያግስ።"]},{"type":"verse","number":27,"content":["ሄሳፈ ጉየ ኤንቲ ኤልማ ብዶሶና። ያን ታማነ ናምኡ ሃ ፑልቶትነ ላፑን ታሙ ዛምባ ምት ደኦሶና። ኤንቲ ያን ሃ ዶናን ኡትዶሶና።"]}],"footnotes":[{"noteId":4,"caller":"+","text":"ማራ: ማራ ጉሳይ “ጫሞ” ጉሱ።","reference":{"chapter":15,"verse":23}}]},"thisChapterLink":"/api/gof_etw/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}