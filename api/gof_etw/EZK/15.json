{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"EZK","translationId":"gof_etw","name":"ህዝቄላ ማፃፋ","commonName":"ህዝቄላ ማፃፋ","title":"ህዝቄላ ማፃፋ","order":26,"numberOfChapters":48,"sha256":"dd81aeed3daf484f88fb4d481554e4a0ff45c046dcf8f31b19fffae560974a6e","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/gof_etw/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":15,"content":[{"type":"heading","content":["ዎይነ ሌምሶ"]},{"type":"verse","number":1,"content":["ጎዳ ቃላይ ሀይሳዳ ያግሸ ታኮ ይስ።"]},{"type":"verse","number":2,"content":["“አሳ ናአዉ፥ ዎይነይ ዎራን ደእያ ሀራ ምፈ አይብን አ?"]},{"type":"verse","number":3,"content":["ጎእ ደእያ ባ ኦናዉ ቃንፀትድ ኤርዬ? አይኮባ ካቅያ ኮጫ እያፐ ከሳናዉ ዳንዳኤቲ?"]},{"type":"verse","number":4,"content":["እያ ታማ ኦይሰናዉ ታማን የግን፥ ፄራይነ ዱለይ ታማን ሜተትን አትዳ ዱንቻይ አይ ማዳኔ?"]},{"type":"verse","number":5,"content":["ፁገቶና ደእሸ፥ አይኮ ማዶናይስ ታም ምን ምጭድ አይ ማዳኔ?”"]},{"type":"verse","number":6,"content":["ሄሳ ግሾ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦ “ታኒ ዎራን ደእያ ም ግዶፈ ዎይነ ም ታማስ አዳ እምዳይሳዳ የሩሳላመን ደእያ አሳ ሄሳዳ ኦና።"]},{"type":"verse","number":7,"content":["ታኒ ታ ሶምኡዋ ኤንታ ቦላ ዛራና፤ ኤንቲ እስ ታማፐ ከይኮካ፥ ሀራ ታም ኤንታ ማና። ታኒ ታ ሶምኡዋ ኤንታ ቦላ ዛርያ ዎደ ታኒ ጎዳ ግደይሳ ህንተ ኤራና።"]},{"type":"verse","number":8,"content":["ኤንቲ ታናን አማነቶና አግዳ ግሾ ታ ኤንታ ቢታ ባይሳ ከሳና” ያጌስ ኡባ ሃርያ ጎዳይ።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/EZK/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/EZK/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/EZK/14.json","previousChapterAudioLinks":{},"numberOfVerses":8}