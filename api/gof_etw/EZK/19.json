{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"EZK","translationId":"gof_etw","name":"ህዝቄላ ማፃፋ","commonName":"ህዝቄላ ማፃፋ","title":"ህዝቄላ ማፃፋ","order":26,"numberOfChapters":48,"sha256":"dd81aeed3daf484f88fb4d481554e4a0ff45c046dcf8f31b19fffae560974a6e","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/gof_etw/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":19,"content":[{"type":"heading","content":["እስራኤለ ካዎታስ ከስዳ ዘለልስ"]},{"type":"verse","number":1,"content":["ጎዳይ ህዝቄላኮ፥ እስራኤለ ሀላቃታስ ሀይሳዳ ያጋዳ ዘሌላ፦"]},{"type":"verse","number":2,"content":[{"text":"“ህንተ አይያ ጋሞታ ግዶን ዋንዳ ጋሞ!","poem":1},{"text":"ያላጋ ጋሞታ ግዶን ዝንአዳ፥ ባ ማራታ ድቻሱ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እያ ባ ማራታፐ እሱዋ ድችን፥","poem":1},{"text":"እ ዎዳላ ጋሞ ግድስ፤","poem":2},{"lineBreak":true},{"text":"ሻንካ ታማርስ፤ አሰ ሙሱ ዶምስ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ካዎተት ኡባይ እያባ ስእዶሶና፤","poem":1},{"text":"ኤንቲ ቦክዳ ኦላን ገልድ ኦይከትስ፤","poem":2},{"lineBreak":true},{"text":"ሲን ዎዶሮ አድ ግብፀ ቢታ ኤፍዶሶና።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እያ አይያ ናግዳይስ ሀኖና እፅን፥","poem":1},{"text":"እ ኡፋይሳይ ይዳይሳ በእዳ ዎደ፥","poem":2},{"lineBreak":true},{"text":"ባ ማራታፐ እሱዋ ድቻዳ፥ ዎዳላ ጋሞ ከሳሱ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እ ዎዳላ ጋሞ ግድድ፥ ሀራ ጋሞታራ ስመረትስ፤","poem":1},{"text":"እ ሻንካ ታማርስ፤ አሰ ሙሱ ኦይክስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እ ኤንታ ሚፃ መንረስ፤ ካታማታ ይስስ፤","poem":1},{"text":"እ ጉድያ ዎደ ቢታን ደእያ አሳ ኡባይ ዳጋሜስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እያ ዩሹዋን ደእያ ካዎተት ኡባይ","poem":1},{"text":"እያ ኦይካናዉ ፅሄ ዎዶሶና፤","poem":2},{"lineBreak":true},{"text":"ባንታ ግትያ ምጭዶሶና፤ ኤንታ ኦላን እ ኦይከትስ፤","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኤንቲ እያ ስን ዎዶሮ አድ ሆን የግድ፥","poem":1},{"text":"ባብሎነ ካዋኮ ኤፍዶሶና።","poem":2},{"text":"እ ጉደይስ ዛሪድ እስራኤለን ስኤቶና መላ","poem":1},{"text":"ኤንቲ እያ ቃሾ ኬን የግዶሶና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ነ አይያ ሃ ዶናን ቶከትዳ ዎይነ መላ፤","poem":1},{"text":"ዳሮ ሃ ደእያ ግሾ","poem":2},{"lineBreak":true},{"text":"ዎይነይ ዳሻንነ አይፈን ኩምድ ደኤስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እያ ታሸት ምኖ ግድያ ግሾ","poem":1},{"text":"ካዎታ ፃምአ ግድዶሶና።","poem":2},{"text":"ዎይነይ ዎራን ደእያ ምታፐ አድ ድጭስ፤","poem":1},{"text":"ባ ታሽያ ዳሮተንነ አዱሳተን","poem":2},{"lineBreak":true},{"text":"ኡባፈ ቦላራ በንትስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሽን ሄ ዎይነይ ሀንቆን ሾደትድ ሳአን የገትስ፤","poem":1},{"text":"ዶሎሀ ጫርኮይ እያ አይፍያ መልስስ፤","poem":2},{"lineBreak":true},{"text":"እያ ምኖ ታሸይ መልን ታም ምስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሀእ እ ሃ ባይና","poem":1},{"text":"መላ ቢታን ቶከትስ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ታም እያ ኡባፈ ከይድ፥","poem":1},{"text":"እያ አይፍያነ ታሽያ ምስ።","poem":2},{"text":"ካዎታ ፃምአ ግዳና ምኖ ታሸይ፥","poem":1},{"text":"እያ ቦላ በንትቤና።","poem":2},"ሀይስ ዬሆ ዘለልስ፤ ሀይሳ ዘለልስ ከስያ ዎደ ጎኤታናዉ በሴስ” ያግስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}