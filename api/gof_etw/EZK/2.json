{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"EZK","translationId":"gof_etw","name":"ህዝቄላ ማፃፋ","commonName":"ህዝቄላ ማፃፋ","title":"ህዝቄላ ማፃፋ","order":26,"numberOfChapters":48,"sha256":"dd81aeed3daf484f88fb4d481554e4a0ff45c046dcf8f31b19fffae560974a6e","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/gof_etw/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":2,"content":[{"type":"heading","content":["ህዝቄላ ፄገተ"]},{"type":"verse","number":1,"content":["እ ታኮ፥ “አሳ ናአዉ፥ ደንዳ ኤቃ። ታ ኔራ ኦደታናዉ ኮያይስ” ያግስ።"]},{"type":"verse","number":2,"content":["እ ታራ ኦደትያ ዎደ ፆሳ አያን ታ ግዶ ገልድ፥ ታና ታ ቶሁዋን ኤስስ፤ እ ታዉ ኦደይሳ ስአስ።"]},{"type":"verse","number":3,"content":["“አሳ ናአዉ፥ ታ ነና እስራኤለ አሳኮ፥ ታ ቦላ ማካልዳ ደርያኮ ኪታይስ። ኤንትነ ኤንታ ማይዛት ሀች ጋካናዉ ታ ቦላ ማካልዳ መላ ደኦሶና።"]},{"type":"verse","number":4,"content":["ኤንቲ ዎዛና ሙመነ ዬል ባይናይሳታ ግድያ ግሾ፥ ታ ነና ኤንታኮ ኪታይስ። ታኒ፥ ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጋይስ።"]},{"type":"verse","number":5,"content":["ሀ ማካላንቾ አሳይ ስእን፥ ስኦና እፅን፥ ናበይ ኤንታ ግዶን ደኤይሳ ኤንቲ ኤራና።"]},{"type":"verse","number":6,"content":["አሳ ናአዉ፥ ኤንታዉነ ኤንታ ቃላስ ያዮፋ! ክንቾተይነ ፁንዱቀይ ነ ዩሾን ደእኮካ፥ ቃስ ኮርነታ ግዶን ነ ኡትኮካ ያዮፋ። ኤንቲ ማካላንቾ ኮቸ ግድያ ግሾ ኤንታዉ ዎይኮ ኤንታ ቃላስ ያዮፋ።"]},{"type":"verse","number":7,"content":["ኤንቲ ማካላንቾ ኮቸ ግድያ ግሾ ኤንቲ ስእን፥ ስኦና እፅን ታ ቃላ ኤንታዉ ኦዳ።"]},{"type":"verse","number":8,"content":["ሽን፥ አሳ ናአዉ፥ ታ ነዉ ኦደይሳ ስአ። ሀ ማካላንቾ አሳዳ ነካ ማካላንቾ ግዶፓ፤ ነ ዶና ዶያዳ ታ ነዉ እመይሳ ማ” ያግስ።"]},{"type":"verse","number":9,"content":["ታ ፄልያ ዎደ፥ ሄኮ፥ ታኮ ምጨትዳ ኩሸ በአስ፤ ሄ ኩሽያን ፃ ማፃፍ ደኤስ።"]},{"type":"verse","number":10,"content":["እ ታ ስንን ሄ ፃ ማፃፋ ብልስ፤ ሄ ማፃፋስ ናምኡ ባጋራ ዬሆይ፥ አዛኖይነ ዘለልስ ሁጰ ቆፋ ግድድ ፃፈትስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/EZK/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/EZK/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/EZK/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}