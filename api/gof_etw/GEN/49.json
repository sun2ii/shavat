{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"GEN","translationId":"gof_etw","name":"መተ ማፃፋ","commonName":"መተ ማፃፋ","title":"መተ ማፃፋ","order":1,"numberOfChapters":50,"sha256":"0b1a23d6d1bc5db20425dc5f7f6946dadd4b61c43d2882c1b697beef2792100d","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/gof_etw/GEN/50.json","totalNumberOfVerses":1524},"chapter":{"number":49,"content":[{"type":"heading","content":["ያይቆብ ባ ናይታ አንጁዋ"]},{"type":"verse","number":1,"content":["ሄሳፈ ጉየ፥ ያይቆብ ባ አደ ናይታ ፄግድ፥ “ስንፈ ሀናናባ ታኒ ህንተዉ ኦዳና መላ ሀ ሺቅተ” ያግስ።"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“ህንተኖ ያይቆባ ናይቶ፥","poem":1},{"text":"እስፈ ሺቅድ ስእተ፤","poem":2},{"lineBreak":true},{"text":"ህንተ አዋይ እስራኤለይ ኦደይሳ ሀይዝተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“ሮቤላ፥ ታ ባይራ ናአዉ፥","poem":1},{"text":"ኔኒ ታ ዎልቃ፤ ታ ምኖተስ ኮይሩዋ፤","poem":2},{"lineBreak":true},{"text":"ኔኒ ቦንቾንካ ዎልቃንካ ኡባፈ አሳ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኔኒ ሃ መላ፥ ኤቅዳሶን ደአካ፤","poem":1},{"text":"ነ እሻታ ቦላ ባይራተ ነዉ በሰና።","poem":2},{"text":"ኔኒ ነ አዋ ሂፃን ከያዳሳ፤","poem":1},{"text":"ነ አዋ አርሳ ቱንሳዳሳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ስሞንነ ሌወይ እሻታ፤","poem":1},{"text":"ኤንቲ ባንታ ማሻ ማካላተስ ደንሶና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኤንቲ ባንታ ሀንቁዋን አደ ዎዶሶና፥","poem":1},{"text":"ባንታ አሙዋ ኩንናዉ ቦራታ ጋድያ ቃንፅዶሶና