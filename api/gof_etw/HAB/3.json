{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"HAB","translationId":"gof_etw","name":"እንባቆመ ማፃፋ","commonName":"እንባቆመ ማፃፋ","title":"እንባቆመ ማፃፋ","order":35,"numberOfChapters":3,"sha256":"140c612076c7105dad27253338cc1a3be8c420893f47779ad969c520244e6fc1","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gof_etw/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["እንባቆመ ዎሳ"]},{"type":"verse","number":1,"content":["ማዝሙረን ሽቅዳ ናብያ እንባቆመ ዎሳይ ሀይሳ፦"]},{"type":"verse","number":2,"content":[{"text":"አቤት ጎዳዉ፥ ኔኒ ካሰ ኦዳባ ታኒ ስአዳ ያያስ።","poem":1},{"text":"ጎዳዉ፥ ኑ ዎድያንካ ሄ ኦሶታ ዛራዳ ኦ፤","poem":2},{"lineBreak":true},{"text":"ኤንቲ ኑ ዎድያንካ ኤረቶ።","poem":2},{"lineBreak":true},{"text":"ነ ሀንቀትያ ዎደ ነ ማሮታ ቆፓ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ፆሳይ ተማና ቢታፈ ዬስ፤","poem":1},{"text":"ጌሻይ ፓራና ደርያፐ ዎስ።","poem":2},{"text":"እያ ቦንቾይ ሳሉዋ ካምስ፤","poem":1},{"text":"እያ ጋላታይ ሳኣ ኩምስ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እያ ፖኦይ ጶልያ አዋ መላ፤","poem":1},{"text":"እያ ዎልቃይ ቆሰትድ ኡትዳ እያ ኩሽያፐ","poem":2},{"lineBreak":true},{"text":"ፆልቅያ ፖኦይ ከዬስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ጋዶይ እያ ስንን ቤስ፤","poem":1},{"text":"ታማ ላጮይ እያ ቶሁዋፐ ከዬስ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እ ኤቅን ቢታይ ቃፅስ፤","poem":1},{"text":"እ ፄልን ካዎተት ኮኮርዶሶና።","poem":2},{"text":"መርና ደረት ዎድዶሶና፤","poem":1},{"text":"እ ኤንታ ቦላ ሄመትያ በንፐ ደእያ ዙማት ላለትዶሶና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታኒ ቶጰ አሳ ዱንካነይ መቶትሽን በአስ፤","poem":1},{"text":"ምድያመ ቢታ አሳይ ኮኮርሽን በአስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አቤት ጎዳዉ፥ ኔኒ አይስ ሀንቀታዲ?","poem":1},{"text":"ሻፋት ነና ሀንቀዶና?","poem":2},{"lineBreak":true},{"text":"ዎይኮ ነ ሀንቆይ አባ ቦሌ?","poem":2},{"text":"አካይ፥ ኔኒ ነ ፓራታነ ነ ፓራ ጋረታ ቶግዳይ","poem":1},{"text":"ነ አሳስ ፆኖ እማናሳ ግደኔ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኔኒ ነ ዶንግያ ዋፃዳሳ፤","poem":1},{"text":"ዱካናዉ ጊግሳዳሳ፤","poem":2},{"lineBreak":true},{"text":"ቢታ ጳልቃዳ ሃ ከሳዳሳ። ሳላሀ","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ደረት ነና በእድ ያሻን ኮኮርዶሶና፤","poem":1},{"text":"ክፃ ሃይ አስ።","poem":2},{"text":"ጪሞ ሃት ዋስዶሶና፤","poem":1},{"text":"ባንታ ዙልያ ቁ ቁ ኦሶና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ነ ዶንግያ ዱካን፥ ነ ቶራ ጶለን፥","poem":1},{"text":"አውነ አጌን ባንታ ደእያ በሳን ኤቅዶሶና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኔኒ ሀንቁዋን ቢታ ኡባ ዩያዳሳ፤","poem":1},{"text":"ካዎተታ ነ ሀንቁዋን የዳሳ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ነ አሳነ ነ ትይዳይሳ አሻናዉ ከያዳሳ፤","poem":1},{"text":"ኢታታ ሀላቃ ሾጫዳሳ፤","poem":2},{"lineBreak":true},{"text":"እያ ማኡዋ ቃራዳ ካሎ አሻዳሳ። ሳላሀ","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኑና ላላናዉ ጎተዳ ይዳ ኑ ሞርክያ፥","poem":1},{"text":"መቶታንቾታ ምታናዉ ጌማን ቆሰትዳይሳ፥","poem":2},{"lineBreak":true},{"text":"እያ ቶራን እያ ጫዳዳሳ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኔኒ ነ ፓራታራ አባ ቦላ ሄመታዳሳ፤","poem":1},{"text":"ዳሮ ሃ የዳሳ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ታኒ ሄሳ ኡባ ስእን ታ ዎዛናይ ዳጋምስ፤","poem":1},{"text":"ታ መተርሻይ ኮኮርስ።","poem":2},{"text":"ታ መቀይ ዳጋምስ፤","poem":1},{"text":"ታ ቶሆይ ጉንድስ።","poem":2},{"text":"ኑ ሞርከታ ጎዳይ ሴራና ጋካናዉ፥","poem":1},{"text":"ታኒ መቱዋ ጋላሳ ዳንዳአን ናጋና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ባላሰ ምይ አይፎና እፅኮካ፥","poem":1},{"text":"ዎይንያ ቦላ አይፈይ በንቶና እፅኮካ፥","poem":2},{"lineBreak":true},{"text":"ሻማሆይ አይፎና እፅኮካ፥","poem":2},{"lineBreak":true},{"text":"ጎሻን ካ ካፅናኮካ፥","poem":2},{"lineBreak":true},{"text":"ግርበን ዶርስ ይኮካ፥","poem":2},{"lineBreak":true},{"text":"ዛዳሎን መሄይ ይኮካ፥","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ታኒ ጎዳን ኡፋይታና፤","poem":2},{"lineBreak":true},{"text":"ታና አሽያ ፆሳን ኡፋይሳን ኩማና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ታ ዎልቃይ ኡባ ሃርያ ጎዳ፤","poem":1},{"text":"እ ታ ቶሁዋ ጋራ ቶሆዳ ምንስ፤","poem":2},{"lineBreak":true},{"text":"እ ታና ቃ በሳን ሄመስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}