{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"HEB","translationId":"gof_etw","name":"እብራወ ኪታ","commonName":"እብራወ ኪታ","title":"እብራወ አሳስ ፃፈትዳ ኪታ","order":58,"numberOfChapters":13,"sha256":"15a944f02b4af020096a7ce3c1e971e373cb3b5a8898e56cd57d1b994a1080d8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/gof_etw/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["ናአይ ኪታንቾታፐ ቦላ"]},{"type":"verse","number":1,"content":["ካሰ ፆሳይ፥ ኑ አዋታስ ናበታ ባጋራ ዱማ ዱማ ኦገን ዳሮ ዎደ ኦድስ።"]},{"type":"verse","number":2,"content":["ሽን ሀ ዉርሰ ዎድያን ኡባ እያ ላትስዳ ቃስ አላመ እያ ባጋራ መዳ ባ ናኣ ባጋራ ኑስ ኦድስ።"]},{"type":"verse","number":3,"content":["ናአይ ፆሳ ቦንቹዋ ጶለነ ኩመ ፆሳ ፆሳተ ኤክድ፥ ባ ዎልቃማ ቃላን ሀ አላምያ ካትስድ ኦይክስ። አሳ ኤንታ ናጋራፐ ጌሽዳፐ ጉየ ኡባፈ ቦላ ፆሳ ኡሻቻ ባጋን ሳሉዋን ኡትስ።"]},{"type":"verse","number":4,"content":["እያዉ እመትዳ ሱንይ ኪታንቾታ ሱንፈ ቦላ ግደይሳዳ እ ኤንታፈ ቦላ።"]},{"type":"verse","number":5,"content":["ህዛ፥ ፆሳይ ኪታንቾታፐ ኦደኮ፥",{"text":"“ኔኒ ታ ናአ፤","poem":1},{"text":"ታ ሀች ነዉ አዋ ግዳስ” ግዴ?","poem":2},"ዎይኮ ቃስ ኦደኮ፥",{"text":"“ታኒ እያዉ አዋ ግዳና፤","poem":1},{"text":"እካ ታዉ ናአ ግዳና” ግዴ?","poem":2}]},{"type":"verse","number":6,"content":["ቃስ ፆሳይ ባ ባይራ ናኣ ሀ አላምያ ኪትሸ፥",{"text":"“ፆሳ ኪታንቾት ኡባይ እያዉ ጎይኖ”","poem":1},"ያግስ።"]},{"type":"verse","number":7,"content":["ፆሳይ ኪታንቾታባ ኦድሸ፥",{"text":"“ፆሳይ ባ ኪታንቾታ ጫርኮ፥","poem":1},{"text":"ባ አይለታ ታማ ላጮ ኦስ”","poem":2},"ያጌስ።"]},{"type":"verse","number":8,"content":["ሽን ባ ናአባ ኦድሸ፥",{"text":"“ፆሳዉ፥ ነ አራታይ መርናዉ ደኤስ።","poem":1},{"text":"ነ ካዎተ ነ ፅሎተን አይሳሳ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኔኒ ፅሎተ ዶሳዳሳ፤ ኢታ እፃዳሳ።","poem":1},{"text":"ፆሳይ፥ ነ ጎዳይ፥ ነና ነ ላገታፐ አድ ዶርስ፥","poem":2},{"lineBreak":true},{"text":"ኡፋይሳ ዛይተ","poem":2},{"noteId":0},{"text":"ነና ትይስ”","poem":2},"ያጌስ።"]},{"type":"verse","number":10,"content":["ፆሳይ ዛሪድ፥",{"text":"“ጎዳዉ፥ ኮይሮ ኔኒ ሳአ መዳሳ፤","poem":1},{"text":"ሳሎት ነ ኩሸ ኦሶ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሄሳት ኡባይ ያና፤","poem":1},{"text":"ሽን ኔኒ ዳና።","poem":2},{"lineBreak":true},{"text":"ኤንቲ ኡባይ አፍላዳ ዉራና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኔኒ ኤንታ ሳሌናዳ ፃፃና፤","poem":1},{"text":"ቃስ ኤንቲ አፍላዳ ላመታና።","poem":2},{"text":"ሽን ኔኒ ኡባ ዎደ ነና፤","poem":1},{"text":"ነ ላይይካ ዉረና”","poem":2},"ያጌስ።"]},{"type":"verse","number":13,"content":["ሽን ፆሳይ ኪታንቾታፐ ኦደኮ፥",{"text":"“ታኒ ነ ሞርከታ ነ ቶሆይ","poem":1},{"text":"የያሶ ኦና ጋካናዉ፥","poem":2},{"lineBreak":true},{"text":"ሀይሳን ታፐ ኡሻቻ ባጋን ኡታ” ግዴ?","poem":2}]},{"type":"verse","number":14,"content":["ኪታንቾት ኡባይ አቶተ ደማናዉ ደእያ አሳታ ማዳናዉ ፆሳይ ኪትዳ አያናታ ግዶኮናዬ?"]}],"footnotes":[{"noteId":0,"caller":"+","text":"ኡፋይሳ ዛይተ፦ እ ካዎትያ ዎደ አሳይ ኡፋይሳን እልልድ እያ ካዎይሳ በሴስ።","reference":{"chapter":1,"verse":9}}]},"thisChapterLink":"/api/gof_etw/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}