{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"HEB","translationId":"gof_etw","name":"እብራወ ኪታ","commonName":"እብራወ ኪታ","title":"እብራወ አሳስ ፃፈትዳ ኪታ","order":58,"numberOfChapters":13,"sha256":"15a944f02b4af020096a7ce3c1e971e373cb3b5a8898e56cd57d1b994a1080d8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/gof_etw/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":3,"content":[{"type":"heading","content":["የሱሲ ሙሰፐ ቦላ"]},{"type":"verse","number":1,"content":["ሄሳ ግሾ፥ ፆሳይ ፄግዳ ጌሻ እሻቶ፥ ኑ አማኖን ጎዳ ግድ ፄግያ ሀዋርያነ ካህነ ሀላቃ የሱሳ በእተ።"]},{"type":"verse","number":2,"content":["ሙሰይ ፆሳ ኬ ኡባን አማነትዳይሳዳ የሱሲካ ባና ዶርዳ ፆሳስ አማነትዳይሳ።"]},{"type":"verse","number":3,"content":["ኬ ኬፀይስ ኬፈ አድ ቦንቸተይሳዳ የሱሲ ሙሰፐ አያ ቦንቾ ኤካናዉ በሴስ።"]},{"type":"verse","number":4,"content":["እስ እስ ኬ ኬፅዳ አስ ደኤስ፥ ሽን ኡባ ጊግስዳይ ፆሳ።"]},{"type":"verse","number":5,"content":["ሙሰይ ፆሳ ኬ ኡባን አማነትዳ አይለ ግድድ፥ ፆሳይ ስንፈ ጋናባስ ማርካ ግድስ።"]},{"type":"verse","number":6,"content":["ሽን ክርስቶስ ፆሳ ኬን ናአዳ አማነትዳይሳ። ኑኒ ኤካና ግድ ናግያ ኡፋይሳ ምንድ ናግኮ ፆሳ ኬ ግዶስ።"]},{"type":"heading","content":["ፆሳ አሳስ ደእያ ሸምፖ"]},{"type":"verse","number":7,"content":["ሄሳ ግሾ፥ ጌሻ አያናይ ገይሳዳ፥",{"text":"“ሀች ህንተ ፆሳይ ገይሳ ስእያ ዎደ፥","poem":1}]},{"type":"verse","number":8,"content":[{"text":"መላ ቢታን ፓጭያ ጋላስ፥","poem":2},{"lineBreak":true},{"text":"ህንተ አዋት ማካልዳይሳዳ፥","poem":2},{"lineBreak":true},{"text":"ህንተ ዎዛና ምንፍተ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ህንተ አዋት ታና ፓጭዶሶና፤","poem":1},{"text":"ኦይታሙ ላይ ታ ኦሱዋ በእዶሶና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሄሳ ግሾ፥ ታ ሄ የለተ ሀንቀታዳ፥","poem":1},{"text":"‘ኤንቲ ኡባ ዎደ ባንታ ዎዛናን ባሎሶና፤","poem":2},{"lineBreak":true},{"text":"ታ ኦግያ ኤርቦኮና’ ያጋስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሄሳ ግሾ፥ ታኒ ታ ሀንቁዋን ጫቃዳ፥","poem":1},{"text":"‘ታ ሸምፖ በሳ ኡባካ ገሎኮና’ ያጋስ”","poem":2},"ያጌስ።"]},{"type":"verse","number":12,"content":["ታ እሻቶ፥ ህንተፈ ኦደንካ፥ ደኦ ፆሳፈ ህንተና ሻክያ ኢታነ አማኖና ዎዛን ዶና መላ ናገትተ።"]},{"type":"verse","number":13,"content":["ህንተፈ ኦናካ ናጋር ባለን፥ ባ ዎዛና ምንና መላ “ሀች” ያገትድ ፄገትሽን ጋላስ ጋላስ እሶይ እሱዋራ ዞረትተ።"]},{"type":"verse","number":14,"content":["ኑ ኮይሮ አማኑዋ ኑኒ ዉርሰ ጋካናዉ ምንድ ናግኮ፥ ክርስቶሳራ እስፈ ላታና።"]},{"type":"verse","number":15,"content":["ጌሻ ማፃፋን፥",{"text":"“ሀች ፆሳይ ገይሳ ህንተ ስእያ ዎደ፥","poem":1},{"text":"ሄ ዎደ ኤንቲ ማካላተን ሀንዳይሳዳ፥","poem":2},{"lineBreak":true},{"text":"ህንተ ዎዛና ምንፍተ”","poem":2},"ያግስ።"]},{"type":"verse","number":16,"content":["ፆሳይ ግያባ ስእድ ማካልዳይ ኦኔ? ሙሰይ ግብፀፈ ካለ ከስዳ ኡባ ግዶኮናዬ?"]},{"type":"verse","number":17,"content":["ፆሳይ ኦይታሙ ላይ ኦና ሀንቀትዴ? ናጋራ ኦዳይሳታነ ኤንታ አሀይ መላ ቢታን ዎ አትዳ አሳታ ግዶኮናዬ?"]},{"type":"verse","number":18,"content":["ቃስ ፆሳይ፥ “ታ ሸምፖ በሳ ገለከታ” ያግድ ጫቅዳይ፥ እያዉ ኪተቶና እፅዳ አሳፐ አትሽን፥ ኦደሴ?"]},{"type":"verse","number":19,"content":["ህዛ፥ ኤንቲ ሄ ሸምፖ በሳ ገሎና አትዳይ አማንቦና ግሾ፥ ግደይሳ ኑ በኦስ።"]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/HEB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/HEB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/HEB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}