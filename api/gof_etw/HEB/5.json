{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"HEB","translationId":"gof_etw","name":"እብራወ ኪታ","commonName":"እብራወ ኪታ","title":"እብራወ አሳስ ፃፈትዳ ኪታ","order":58,"numberOfChapters":13,"sha256":"15a944f02b4af020096a7ce3c1e971e373cb3b5a8898e56cd57d1b994a1080d8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/gof_etw/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":["እስ እስ ካህነ ሀላቅ አሳ ግዶፈ ዶረትድ፥ ፆሳራ ጋያባን አሳ ግሾ እሞታነ ናጋራ ያርሾ ያርሻናዉ ሹመቴስ።"]},{"type":"verse","number":2,"content":["እ ባ ሁጰን ዳቡራንቾ ግድያ ግሾ፥ ኤሮናይሳታስነ ባለይሳታስ ቃታናዉ ዳንዳኤስ።"]},{"type":"verse","number":3,"content":["እ ባ ናጋራ ግሾነ አሳ ኡባ ናጋራ ግሾ ያርሾ ያርሻናዉ በሰይ ሄሳሳ።"]},{"type":"verse","number":4,"content":["ኦንካ ሀ ቦንቹዋ ባዉ ኤካናዉ ዳንዳኤና፥ ሽን አሮን ካህነ ሀላቃ ግዳናዉ ፄግዳይሳዳ ፆሳን ፄገታናዉ በሴስ።"]},{"type":"verse","number":5,"content":["ሄሳዳካ፥ ክርስቶስ ካህነ ሀላቃ ግድያ ቦንቹዋ ባዉ ኤክቤና። ሽን ፆሳይ እያ፥",{"text":"“ኔኒ ታ ናአ፤","poem":1},{"text":"ሀች ታ ነዉ አዋ ግዳስ”","poem":2},"ያጌስ።"]},{"type":"verse","number":6,"content":["ቃስ ሀራሶን፥",{"text":"“ማልከፃደቅ ካህነ ግድዳይሳዳ፥","poem":1},{"text":"ኔኒ መርናዉ ካህነ ግዳና”","poem":2},"ያጌስ።"]},{"type":"verse","number":7,"content":["የሱሲ አሰ ግድድ ሀ አላምያን ደእያ ዎደ ባና ሀይቆፐ አሻናዉ ዳንዳእያ ፆሳ ዳሮ ዬሆንነ አፉን ዎስስ። እ፥ እያ ቦንችድ ኪተትዳ ግሾ ፆሳይ እያ ዎሳ ስእስ።"]},{"type":"verse","number":8,"content":["የሱሲ ፆሳ ናአ ግድኮካ ባ ዋየትዳ ዋያን ኪተተ ታማርስ።"]},{"type":"verse","number":9,"content":["ሄሳንካ፥ የሱሲ ባ ኦሱዋ ፖልዳፐ ጉየ ባዉ ኪተትያ ኡባይ መርና አቶተ ደማና መላ ጋሶ ግድስ።"]},{"type":"verse","number":10,"content":["ፆሳይ ማልከፃደቃ ሹምዳይሳዳ ካህነ ሀላቃ ኦድ እያ ሹምስ።"]},{"type":"heading","content":["ህንተ አማኑዋን ዳቡሮፕተ"]},{"type":"verse","number":11,"content":["ሀ ኑ ኦዳ ቦላ ጉጅ ኦዳናባይ ዳሮባይ ደኤስ፥ ሽን ህንተ አኬካይ ጉ ግድያ ግሾ ህንተዉ ኦድ ገልሳናዉ ዋይሴስ።"]},{"type":"verse","number":12,"content":["ህንተ ሀኖደ አስታማረ ግዳናዉ በሴስ፥ ሽን ፆሳ ቃላ ኮይሮ ትምርትያ ህንተና ዛር ታማርስያ ሀራ አስ ኮሼስ። ህንተ ምኖ ካ ማናዉ ዳንዳኦና ግሾ ማ ኮሼስ።"]},{"type":"verse","number":13,"content":["ማ ፓሄትያ ኦንካ ዮጋ ናአ ግድያ ግሾ፥ ሎኦነ ኢታ ሻክ ኤረና።"]},{"type":"verse","number":14,"content":["ሽን ምኖ ካ ሎኦነ ኢታ ሻክ ኤርያ ካሃማ አሳሳ።"]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/HEB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/HEB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/HEB/4.json","previousChapterAudioLinks":{},"numberOfVerses":14}