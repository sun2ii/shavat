{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"HEB","translationId":"gof_etw","name":"እብራወ ኪታ","commonName":"እብራወ ኪታ","title":"እብራወ አሳስ ፃፈትዳ ኪታ","order":58,"numberOfChapters":13,"sha256":"15a944f02b4af020096a7ce3c1e971e373cb3b5a8898e56cd57d1b994a1080d8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/gof_etw/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":8,"content":[{"type":"heading","content":["የሱሲ ኑ ካህነ ሀላቃ"]},{"type":"verse","number":1,"content":["ኑኒ ሃሳያ ግታባይ ሄሳ። ሳሉዋን ኡባፈ ቦላ ፆሳ አራታፐ ኡሻቻ ባጋን ኡትዳ ሀይሳ መላ ካህነ ሀላቃይ ኑስ ደኤስ።"]},{"type":"verse","number":2,"content":["እ አሳን ግዶናሽን፥ ጎዳን ኤቅዳ ቱማ ዱንካንያን ፆሳ ኬን ኦስ።"]},{"type":"verse","number":3,"content":["ካህነ ሀላቃ ኡባይ እሞነ ያርሾ ያርሻናዉ ሹመቴስ። ሄሳ ግሾ፥ ሀ ካህነይ ያርሻናዉ እስባይ ዳናዉ ኮሼስ።"]},{"type":"verse","number":4,"content":["ህገይ ኪተይሳዳ ያርሽያ ካህነት ደእያ ግሾ፥ ክርስቶስ ሳአን ደእያባ ግድያኮ እ ካህነ ግደና።"]},{"type":"verse","number":5,"content":["ኤንቲ ካህነተን ኦያ ዱንካነይ ሳሎን ደኤይሳስ ሌምሶነ ኩያ። ሙሰይ ዱንካንያ ኤስያ ዎደ ፆሳይ እያኮ፥ “ታኒ ነና ዙማ ቦላ በስዳ ሌምሱዋ ካላዳ ኦ” ያግስ።"]},{"type":"verse","number":6,"content":["ሽን የሱሲ ግዶ ግድድ ስገያ ጫቆይ፥ ኮይሮ ጫቁዋፐ አይሳዳ እ ኤክዳ ኦሶይ ኤንታይሳፈ አስ። ሄስ ኤቅዳይ አያ ጫቆ ቃላና።"]},{"type":"verse","number":7,"content":["ኮይሮ ጫቁዋን ባል ባይናባ ግድያኮ ናምአን ጫቆ ኮሸና።"]},{"type":"verse","number":8,"content":["ሽን ጎዳይ ኤንታ ቦርድ፥ ሀይሳዳ ያግስ፦",{"text":"“ታኒ እስራኤለ አሳራነ ይሁዳ አሳራ","poem":1},{"text":"ኦራ ጫቆ ጫቅያ ዎደይ ያና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሄ ጫቆይ ታ ኤንታ አዋታ ግብፀ ቢታፈ ኩሽያ ኦይካዳ፥","poem":1},{"text":"ጎቻ ከስዳ ዎደ ኤንታራ ጫቅዳ ጫቁዋ መላ ግደና።","poem":2},{"text":"ኤንቲ ታ ጫቁዋን አማነትቦና ግሾ፥","poem":1},{"text":"ታኒ ኤንታ የጋ አጋስ ያጌስ ጎዳይ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሽን ህዛፐ ጉየ እስራኤለ አሳራ","poem":1},{"text":"ታ ጫቃና ጫቆይ ሀይሳ ያጌስ ጎዳይ።","poem":2},{"text":"ታኒ ታ ህግያ ኤንታ ጉግያን ዎና፤","poem":1},{"text":"ኤንታ ዎዛናን ፃፋና።","poem":2},{"text":"ታኒ ኤንታ ፆሳ ግዳና፤","poem":1},{"text":"ኤንትካ ታ አሰ ግዳና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኤንታፈ ኦንካ ባ ሾሩዋ ዎይኮ ባ እሻ፥","poem":1},{"text":"‘ጎዳ ኤራ’ ያግድ ታማርሰና።","poem":2},{"text":"ኤንቲ ጉፈ ግታ ጋካናዉ","poem":1},{"text":"ኡባይ ታና ኤራና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ታኒ ኤንታ ናቁዋ አቶ ጋና፤","poem":1},{"text":"ኤንታ ናጋራ ዛራ ቆፕከ” ያጌስ።","poem":2}]},{"type":"verse","number":13,"content":["ፆሳይ ሀ ጫቁዋ “ኦራ” ግድ ፄግሸ ኮይሮይሳ ጋልእስስ። ህዛ፥ ጋልአይነ ጬጋይ ይያ ዎደይ ጋክስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/HEB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/HEB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/HEB/7.json","previousChapterAudioLinks":{},"numberOfVerses":13}