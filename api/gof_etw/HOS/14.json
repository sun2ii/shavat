{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"HOS","translationId":"gof_etw","name":"ሆሰ ማፃፋ","commonName":"ሆሰ ማፃፋ","title":"ሆሰ ማፃፋ","order":28,"numberOfChapters":14,"sha256":"ca286b9b9fadd683fb6c27962eca2b21bb38cc8dc058f56d34e0e10bc1f3e3e3","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gof_etw/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"heading","content":["ጎዳኮ ስሞይ ኤህያ አንጆ"]},{"type":"verse","number":1,"content":["እስራኤለ አሳዉ፥ ህንተ ናጋራ ጋሶን በትድ ኩንድዳ ግሾ ሀእ ጎዳ፥ ህንተ ፆሳኮ ስምተ።"]},{"type":"verse","number":2,"content":["ጎዳኮ ስሚድ፥ ሀይሳዳ ያግድ ዎስተ፤ “ኑ ናጋራ ኡባፈ ኑና ማራ፤ ኑኒ ኑ መተርሻ አይፈ ግድዳ ጋላታ ነዉ ሺሻና መላ ነ ኑና ነ ኬሀተን ሺሻ ኤካ።"]},{"type":"verse","number":3,"content":["አሶረይ ኑና አሸና፤ ኑ ኦላ ፓራታንካ አማነቶኮ። ኑኒ ኑ ኩሸን መዳ ኤቃ ምስለታ ኡባ፥ ‘ኑ ፆሳታ’ ጎኮ። አዋይ ባይናይሳታስ ቃተይ ነና” ያግተ።"]},{"type":"verse","number":4,"content":["ጎዳይ፥ “ታ ሀንቆይ ኤንታፈ ስምዳ ግሾ፥ ታኒ ኤንታ ማካላ ሀኑዋፐ ኤንታ ፓዳ፥ ኤንታ ዎዛናፐ ሲቃና።"]},{"type":"verse","number":5,"content":["ታኒ እስራኤለ አሳስ አካ ግዳና፤ ኤንቲ ጪሻዳ ጭይድ፥ ልባኖሰ ዝጋ መላ ፃጶ የዳና።"]},{"type":"verse","number":6,"content":["ኤንታ ዶላይ ጭልአና፤ ኤንቲ ሻማሆዳ ሎአና። ኤንታ ሳዎይ ልባኖሰ ዝጋዳ ቶንኩ ጋና።"]},{"type":"verse","number":7,"content":["አሳይ ስሚድ ታ ኩያ ጋርሳን ሸምፓና፤ ኤንቲ ዶላዳ ጭልአና፤ ኤንቲ ዎይነዳ ጪያና፤ ልባኖሰ ዎይነ ኡሻዳ ኤረትያባ ግዳና።"]},{"type":"verse","number":8,"content":["ኤፍሬማ አሳዉ፥ ህዛፐ ጉየ ኤቃ ምስለራ ታዉ አይ ጋሄተ ደኢ? ህንተ ዎሳ ስኤይነ ህንተና ናገይ ታና። ታኒ ጭልኦ ዝጋ መላ፤ ህንተ አይፈ አይፋና መላ ኦይ ታና” ያጌስ።"]},{"type":"verse","number":9,"content":["ጭንጫተ ደእያ ኦንካ ሀይሳ አኬኮ፤ ዎዛን ደእያ ኦንካ ሄሳ ኤሮ። ጎዳ ኦገይ ሱረ፤ ፅሎት ሄ ኦግያራ ሄመቶሶና፤ ሽን ናጋራንቾት እያን በቶሶና።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":9}