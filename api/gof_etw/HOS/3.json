{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"HOS","translationId":"gof_etw","name":"ሆሰ ማፃፋ","commonName":"ሆሰ ማፃፋ","title":"ሆሰ ማፃፋ","order":28,"numberOfChapters":14,"sha256":"ca286b9b9fadd683fb6c27962eca2b21bb38cc8dc058f56d34e0e10bc1f3e3e3","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gof_etw/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":3,"content":[{"type":"heading","content":["ሆሰይ ባ ማቸራ ስገተ"]},{"type":"verse","number":1,"content":["ጎዳይ ታና፥ “እስራኤለ አሳይ ሀራ ፆሳታኮ ስሚድ፥ ዛብበ ኡይ ያርሻናዉ ኮይኮካ፥ ጎዳይ ኤንታ ዶሰይሳዳ እዮ ዶሳ። እያ ሀራ ላገያባነ ላይማትያባ ግድኮካ ኔኒ እዮ ዶሳ” ያግስ።"]},{"type":"verse","number":2,"content":["ያግን፥ ታኒ እዮ ታማነ እቻሹ ብራ ሳንትመንነ ፄታነ እሻታሙ ክሎ ግራመ ባንጋን ሻማስ።"]},{"type":"verse","number":3,"content":["ታኒ እዮ፥ “ኔኒ ላይማቶናነ ሀራ አደራ ዶና ታራ ዳሮ ዎደ ዳናዉ ኮሼስ። ታንካ ኔራ ዳና” ያጋስ።"]},{"type":"verse","number":4,"content":["እስራኤለ አሳይ ካዎይ ዎይኮ ሀላቅ ባይና፥ ያርሾይ ዎይኮ ኤቃ ቱስ ባይና፥ ኤፉደ ማኦይ ዎይኮ ኤቃ ምስለይ ባይና ዳሮ ዎደ ዳና።"]},{"type":"verse","number":5,"content":["ሄሳፈ ጉየ፥ እስራኤለ አሳይ ጎዳ ባንታ ፆሳኮነ ባንታ ካዋ ዳዊታኮ ስማና። ዉርሰ ዎድያን ኤንቲ ኮኮርሸ፥ ጎዳኮነ እያ አንጁዋኮ ያና።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/HOS/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/HOS/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/HOS/2.json","previousChapterAudioLinks":{},"numberOfVerses":5}