{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"HOS","translationId":"gof_etw","name":"ሆሰ ማፃፋ","commonName":"ሆሰ ማፃፋ","title":"ሆሰ ማፃፋ","order":28,"numberOfChapters":14,"sha256":"ca286b9b9fadd683fb6c27962eca2b21bb38cc8dc058f56d34e0e10bc1f3e3e3","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/gof_etw/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"heading","content":["እስራኤለይ ስምቤና"]},{"type":"verse","number":1,"content":["እስራኤለ አሳይ፥ “ሃይተ! አነ ጎዳኮ ስሞስ። እ ኑና መንረስ፥ ሽን እ ኑና ኮላና፤ እ ኑና ማዱንፅስስ፥ ሽን እ ኑ ማዱን ቃቻና።"]},{"type":"verse","number":2,"content":["ናምኡ ጋላሳፐ ጉየ እ ኑና ፓና፤ ሄን ጋላሳን ኑ እያ ስንን ዳና መላ ኑና ደንና።"]},{"type":"verse","number":3,"content":["አነ ጎዳ ኤሮስ፤ እያ ኤራናዉ ምንድ ካሎስ። ፃልቀይ ዶለይሳዳ እ ቆንጫና፤ ቶርቸ እር የይሳዳ እ ኑኮ ያና” ያግዶሶና።"]},{"type":"verse","number":4,"content":["ጎዳይ፥ “ታ ህንተና ኤፍሬማ አሳ ዋቶ? ታ ህንተና ይሁዳ አሳ ዋቶ? ህንተ ሲቆይ ዎንታ ፃሳ መላ፤ ኤለስድ ይያ አካ መላ።"]},{"type":"verse","number":5,"content":["ሄሳ ግሾ፥ ታኒ ናበታ ባጋራ ህንተና ቃንፀረስ፤ ታ ዶናፐ ከይዳ ቃላን ህንተና ዎስ። ታ ፕርዳይ ህንተ ቦላ ፖኦዳ ዋጋግ ጋና።"]},{"type":"verse","number":6,"content":["ታ ያርሾ ግዶናሽን ማሮታ ኮያይስ፤ ፁሳ ያርሾ ግዶናሽን ፆሳ ኤሮ ኮያይስ።"]},{"type":"verse","number":7,"content":["“ሽን ኤንቲ አዳመዳ፥ ጫቆ መንዶሶና፤ ያን ታዉ አማነቶና እፅዶሶና።"]},{"type":"verse","number":8,"content":["ጋላዳ ካታማይ ሱ ጉክያ ኢታ ኦሶ ኦያ አሳይ ኩምዳ ካታማ።"]},{"type":"verse","number":9,"content":["ፓንጋት አሰ ዎናዉ ቆሰትድ ናገይሳዳ ካህነታ ጩጋይ ሄሳዳ ናጎሶና። ሴከማ ካታማ ኤፍያ ኦግያን ናግድ አሰ ዎኦሶና፤ ኤንቲ ዬላያ ዎራን ኦሶ ኦሶና።"]},{"type":"verse","number":10,"content":["ታኒ እስራኤለ አሳ ግዶን ዳጋንያባ በአስ። ኤፍሬማ ግዶን ላይማተ ደኤስ፤ እስራኤለይ ቱንስ።"]},{"type":"verse","number":11,"content":["“ይሁዳ፥ ታኒ ታ አሳ ድኡዋ ዛርያ ዎደ ነዉ ቃስ ጫካ ዎደ ጊግሳስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}