{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_etw","name":"እሳያሳ ማፃፋ","commonName":"እሳያሳ ማፃፋ","title":"እሳያሳ ማፃፋ","order":23,"numberOfChapters":66,"sha256":"4ab89101f9b620becbbf3e12322e1f109302962dc48ac0ae8b6da090f19837b1","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["ኦዝያን፥ እዮአታም፥ አካዝነ ህዝቅያስ ይሁዳን ካል ካልድ ካዎትዳ ዎደ አሞፀ ናአይ እሳያስ ይሁዳባነ የሩሳላመባ በእዳ ቆንጨይ ሀይሳ።"]},{"type":"heading","content":["ስኦና ደረ"]},{"type":"verse","number":2,"content":[{"text":"ሳሎቶ ስእተ፤ ሳአዉ ሀይዛ ስአ፤","poem":1},{"text":"ጎዳይ ሀይሳዳ ያጌስ፤","poem":2},{"text":"“ታ ናይታ የላዳ ድቻስ፤","poem":1},{"text":"ሽን ኤንቲ ታዉ ማካልዶሶና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ቦር ባ ጎዳ ኤሬስ፤","poem":1},{"text":"ሀረይካ ባና ሃርዳይሳ ዛዳሉዋ ኤሬስ።","poem":2},{"text":"ሽን እስራኤለይ ኤረና፤","poem":1},{"text":"ታ አሳይ አኬከና።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ህንተኖ፥ ናጋራንቾ ካዎተቶ፥","poem":1},{"text":"ባላ ኦሶን ዴፅዳይሳቶ፥","poem":2},{"lineBreak":true},{"text":"ኢታ ኦያ የለተቶ፥","poem":2},{"lineBreak":true},{"text":"ቱና ኦሶስ እመትዳ ናይቶ፥","poem":2},{"text":"ጎዳ አግዳይሳቶ፥","poem":1},{"text":"ህንተና አየ!","poem":2},{"text":"እስራኤለ ጌሻ ካደታ፤","poem":1},{"text":"እያዉ ዞኮ ዛርደታ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ማካላ ቦላ ማካላ አይስ ጉጄቲ?","poem":1},{"text":"አይስ ዛር ዛር ሾጨቴቲ?","poem":2},{"text":"ህንተ ሁጰይ ሀርገትስ፤","poem":1},{"text":"ህንተ ዎዛናይ ዳቡርስ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሁጰ ብናናፐ ቶሆ ፁጉን ጋካናዉ ፓያተ ባዋ፤","poem":1},{"text":"ማዱን፥ ክፅነ ስ ማእስ።","poem":2},{"text":"ኤንቲ ጊይቦኮና፥ ዎይኮ ሜጨትድ ቃሸትቦኮና","poem":1},{"text":"ዎይኮ ዛይተን ትየትድ ሎፅክቦኮና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“ህንተ ቢታይ ኦፅስ፤","poem":1},{"text":"ህንተ ካታማት ታማን ፁገትዶሶና።","poem":2},{"text":"ህንተ በእሽን ህንተ ጎሻ አላጋት ኤካና፤","poem":1},{"text":"እማ አሳት ህንተ ቢታ ቁኤ ከሳና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"የሩሳላመይ ዎይነ ጋደን ደእያ ሻቃራዳ፥","poem":1},{"text":"ሌሄ ግዶን ደእያ ጋባዳነ","poem":2},{"lineBreak":true},{"text":"ሞርከን ተቀትዳ ካታማዳ ሀናዳ አታና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኡባፈ ዎልቃማ ጎዳይ ኑስ ጉ ኮቸ አሾናኮ","poem":1},{"text":"ኑኒ ሶዶመነ ጋሞራ ካታማዳ ሀናናሽን” ያግስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ህንተኖ፥ ሶዶመ ሀላቃቶ፥ ጎዳ ቃላ ስእተ!","poem":1},{"text":"ህንተኖ፥ ጋሞራ አሳዉ፥ ኑ ፆሳ ህግያ ስእተ!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“ህንተ ያርሾ ዳሮይ ታዉ አይ ኦ?","poem":1},{"text":"ሀኖ ጋካናዉ ህንተ ታዉ ሺሽዳ ኡርገ ዶርሳነ","poem":2},{"lineBreak":true},{"text":"ሞ መሄ ፁሳ ያርሾይ ታዉ ግዳና።","poem":2},{"text":"ታኒ ኮርማታ፥ ዶርሳ ኡርገታነ","poem":1},{"text":"ዴሻታ ሱን ኡፋይትከ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ህንተ ታ ስንን በንታናዉ ያ ዎደ","poem":1},{"text":"ታ ኬ ዳባባ ህንተ የና መላ ኦነ ኦይችዳይ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሀዳ ያርሹዋ ኤሄይሳ አግተ!","poem":1},{"text":"ህንተ ጩይስያ እፃነይ ታና ሻቴስ።","poem":2},{"text":"አጌና ፄሮን ህንተ ቦንችያ ጋላሳ፥","poem":1},{"text":"ሳምባታነ ኢታተን ህንተ ሺቅያ ሺቁዋ ታኒ እፃይስ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አጌና ፄሮን ህንተ ቦንችያ ጋላሳነ","poem":1},{"text":"ህንተ ባኣለ ጋላሳታ ታኒ እፃስ፤","poem":2},{"lineBreak":true},{"text":"ኤንቲ ታዉ ቶሆ ግድዶሶና፤","poem":2},{"lineBreak":true},{"text":"ታኒ ኤንታ ቶካናዉ ዳንዳእከ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ህንተ ኩሸ ምጭድ ታና ዎስያ ዎደ","poem":1},{"text":"ታኒ ታ አይፍያ ህንተፈ ገንና።","poem":2},{"text":"ህንተ ኩሸይ ሱን ኩምዳ ግሾ","poem":1},{"text":"ህንተ ዳርስ ዎስኮካ ታኒ ስእከ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሜጨትተ፤ ህንተና ጌሽተ፤","poem":1},{"text":"ህንተ ኢታ ኦሱዋ ታ ስንፈ ድግተ፤","poem":2},{"lineBreak":true},{"text":"ገነ ሀኑዋ አግተ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሎኦባ ኦሶ ታማርተ፤","poem":1},{"text":"ፅሎ ፕርዳ ኮይተ።","poem":2},{"text":"ኡንኤትዳይሳታ አሽተ፤ ይኦታስ ኤቅተ፤","poem":1},{"text":"አምኤታስ ሞተትተ”","poem":2},"ያጌስ ጎዳይ።"]},{"type":"verse","number":18,"content":["“ሃይተ፤ አነ ዎል አማንስ። ህንተ ናጋራይ ባራ ቢታዳ ዞእኮካ፥ ሻቻዳ ቦፃና፤ ሱዳ ዞእኮካ ፑቶዳ ቦፃና።"]},{"type":"verse","number":19,"content":["ህንተ ኤሮ ግድ ታዉ ኪተትኮ ቢታ አንጁዋ ማና።"]},{"type":"verse","number":20,"content":["ሽን ህንተ እፃስ ግድ ማካልኮ፥ ማሻን ሜተታና” ያጌስ ጎዳይ ባ ዶናን።"]},{"type":"verse","number":21,"content":["አማነትዳ ካታምያ ዋናዳ ላይማ ግዳዴ? ካሰ ሱረተነ ፅሎተ እ ግዶን ኩምስ፥ ሽን ሀእ ሸምፖ ዎይሳት እ ግዶን ደኤስ።"]},{"type":"verse","number":22,"content":["ነ ብራይ ባልትስ፤ ነ ማልኦ ዎይነይ ሃን የለትስ።"]},{"type":"verse","number":23,"content":["ህንተ ሀላቃት ማካላንቾታነ ካይሶ ላገ ግድዶሶና፤ ኤንቲ ኡባይ ዎፈ ዶሰይሳታነ ኩሸ ፄለይሳታ። ይኦታስ ሱረ ፕርዶኮና፤ አምኤታ ዋሱዋ ስኦኮና።"]},{"type":"verse","number":24,"content":["ሄሳ ግሾ፥ ጎዳይ፥ ኡባፈ ዎልቃማ ፆሳይ፥ እስራኤለ ዎልቃማይ፥ ሀይሳዳ ያጌስ፤ “ሀእ ታኒ ታ ሞርከታ ቦላ ታ ሀንቁዋ ጉሳና፤ ታራ ኤቀተይሳታ ሀሎ ከያና።"]},{"type":"verse","number":25,"content":["ታኒ ታ ኩሽያ ነ ቦላ ዛራና፤ ነ ባልተ ጌሻና፤ ነ ቱናተ ኡባ ኔፐ ድጋና።"]},{"type":"verse","number":26,"content":["ታኒ በንይሳዳ ነ ሀላቃታ፥ ኮይሮይሳዳ ነ ዞራንቾታ ደንና። ሄሳፈ ጉየ፥ ኔኒ አማነትዳ ቢታ፤ ፅሎተ ካታማ ጌተታና” ያጌስ።"]},{"type":"verse","number":27,"content":["ፅዮነይ ሱረ ፕርዳን፥ ባንታ ናጋራ ፓፀይሳትካ ፅሎተን ዎዘታና።"]},{"type":"verse","number":28,"content":["ሽን ማካላንቾትነ ናጋራንቾት እስፈ መቃና፤ ጎዳ አገይሳት ያና።"]},{"type":"verse","number":29,"content":["ህንተ ኡፋይትዳ ያርሾ ዎላን ዬላታና፤ ህንተ ዶርዳ ኮራን ካዉያና።"]},{"type":"verse","number":30,"content":["ህንተ ሀይ ቆቆፈትድ ዉርዳ ዎላዳነ ሃ ይዳ አታክልተ በሳዳ ግዳና።"]},{"type":"verse","number":31,"content":["ባና ምኖ ገይ ቡፃ ግዳና፤ እያ ኦሶይካ ፖልኡ ግድ ቶእያ ታማ ግዳና፤ ኤንቲ እስፈ ፁገታና፤ ሄ ታማ ቶይሳና አስ ባዋ።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}