{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_etw","name":"እሳያሳ ማፃፋ","commonName":"እሳያሳ ማፃፋ","title":"እሳያሳ ማፃፋ","order":23,"numberOfChapters":66,"sha256":"4ab89101f9b620becbbf3e12322e1f109302962dc48ac0ae8b6da090f19837b1","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":11,"content":[{"type":"heading","content":["እሰየፐ ከይዳ አጫ"]},{"type":"verse","number":1,"content":["እሰየ ዱሩማይ አጫና፤ እያ ፃጱዋፐ አይፍያ ታሸይ ከያና።"]},{"type":"verse","number":2,"content":[{"text":"ጎዳ አያናይ እያ ቦላ ሸምፓና፤","poem":1},{"text":"ጭንጫተነ አኬካ አያናይ፥","poem":2},{"lineBreak":true},{"text":"ዞርያነ ዎልቃ አያናይ፥","poem":2},{"lineBreak":true},{"text":"ኤራተነ ጎዳስ ያይያ አያናይ፥ እያ ቦላ ሸምፓና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ጎዳስ ያይድ ኡፋይቴስ፤","poem":1},{"text":"ባ አይፈይ በእዳባን ጮ ፕርደና፤","poem":2},{"lineBreak":true},{"text":"ዎይኮ ባ ሀይይ ስእዳባን ጮ ኩየና።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሽን እ፥ ማንቆታስ ፅሎተን ፕርዳና፤","poem":1},{"text":"ሳአን ደእያ መቶታንቾታስ ሱረተን ኩያና።","poem":2},{"text":"እ ባ እንፃርሳ ፃምአን ሳኣ ሾጫና፤","poem":1},{"text":"ባ ዶና ሸምፑዋን ኢታታ ዎና።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ፅሎተ እያ ፄሳ ዳንጮ ግዳና፤","poem":1},{"text":"አማነተ እያ ምያስ ሳቀ ግዳና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሱመይ ዶርሳ ማራራ እስፈ ዳና፤","poem":1},{"text":"ማሄይ ዴሻ ማራራ እስፈ ዝንአና።","poem":2},{"text":"ማር ጋሞ ቡታለራ እስፈ ሄመታና፤","poem":1},{"text":"ጉ ናእ ኤንታ ሄማና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሚዝነ ባባን እስፈ ሄመታና፤","poem":1},{"text":"ኤንታ ማራት እስፈ ዝንአና፤","poem":2},{"lineBreak":true},{"text":"ጋሞይ ቦራዳ ካለ ማና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ምያ ናእ ሾሻ ኦላን ካአና፤","poem":1},{"text":"ን ዱፅዳ ናእ ዎያ ሾሻ ኦላን ባ ኩሽያ የዳና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ታ ጌሻ ዙማ ቦላ","poem":1},{"text":"ኦንካ ቆሄተና ዎይኮ የና።","poem":2},{"text":"አቢ ሃን ኩመይሳዳ","poem":1},{"text":"ሳእ ጎዳ ኤሮን ኩማና።","poem":2}]},{"type":"verse","number":10,"content":["ሄ ዎደ እሰየ ፃጶይ አሳስ ማላ ግዳና፤",{"text":"ካዎተ ኡባይ እያ ኮያና፤","poem":2},{"lineBreak":true},{"text":"እ ደእያ በሳይ ቦንቸታና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሄ ጋላስ ጎዳይ አትዳ ባ አሳ፥ አሶረፐ፥ ግብፀፈ፥ ጳትሮሳፐ፥ ቶጰፈ፥ ኤላማፐ፥ ሳናኦረፐ፥ ሀማታፐነ ዩሾይ አባን ተቀትዳ ቢታፈ ናምአን ኤሀናዉ ባ ኩሽያ ዛሪድ የዳና።","poem":1}]},{"type":"verse","number":12,"content":[{"text":"እ ካዎተታስ ማላ ቁ ኦድ ደንና፤ እስራኤለፐ ላለትዳይሳታ እስፈ ጋና፤ ይሁዳፐ ሳኣ ኦይዱ ባጋን ዘረትዳይሳታ ሺሻና።","poem":1}]},{"type":"verse","number":13,"content":["ሄሳፈ ጉየ፥ ኤፍሬማ ቃናተይ እያፐ ክቻና፤ ይሁዳ ሞርከተይ እያፐ ቃንፀታና። ኤፍሬም ይሁዳ ቃናተና፤ ይሁድ ኤፍሬማ ሞርከና።"]},{"type":"verse","number":14,"content":["ኤንቲ ዉሎሀ ባጋን ደእያ ፍልስፄመ ቢታ ቦላ ጉፕ ዎና፤ ኤንቲ ዶሎሀ ባጋን ደእያ አሳ ቦንቃና። ኤንቲ ኤዶመ ቦላነ ሞአበ ቦላ ባንታ ኩሽያ ዎና፤ አሞነት ኤንታዉ ሃረታና።"]},{"type":"verse","number":15,"content":["ጎዳይ ግብፀ ማታን ደእያ ዞኦ አባ መልሳና፤ ባ መልስያ ጫርኩዋራ ባ ኩሽያ ኤፍራፂሳ ሻፋ ቦላ ቃና። ያትድ አሳይ መላ በሳራ ፕናና መላ ላፑን ጉ ሻፋ ከስድ ሻካና።"]},{"type":"verse","number":16,"content":["እስራኤለ አሳይ ግብፀ ቢታፈ ከይያ ዎደ ኦገይ ከይዳይሳዳ፥ አትዳ እያ አሳይ፥ አሶረ ቢታፈ ስምያ ኦገይ ከያና።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/10.json","previousChapterAudioLinks":{},"numberOfVerses":16}