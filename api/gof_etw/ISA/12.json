2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}