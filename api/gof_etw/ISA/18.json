{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_etw","name":"እሳያሳ ማፃፋ","commonName":"እሳያሳ ማፃፋ","title":"እሳያሳ ማፃፋ","order":23,"numberOfChapters":66,"sha256":"4ab89101f9b620becbbf3e12322e1f109302962dc48ac0ae8b6da090f19837b1","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":18,"content":[{"type":"heading","content":["ቶጰ ቦላ ኦደትዳ ትንብተ"]},{"type":"verse","number":1,"content":["ቶጰ ሻፋታፐ ሄፍንን ጊርያ ቀፈት ደእያ ቢታ አየ!"]},{"type":"verse","number":2,"content":["ሄ ቢታይ፥ ኪተትያ አሳታ ማይረ ዎጎሎን ዎድ ናይለ ሻፋ ቦላራ ኪቴስ። ህንተኖ፥ ኤሶን ኪተተይሳቶ፥ አዱሰነ ሊቆ አሳኮ፥ ማታንነ ሃሆን ያሽያ አሳኮ፥ ዎልቃማነ ፆንያ ካዎተኮ፥ ሻፋን ኤንታ ዛዋይ ሻከትዳ ቢታኮ ቢተ።"]},{"type":"verse","number":3,"content":["ህንተኖ፥ ሳአን ደእያ ኡባቶ፥ ህንተኖ፥ ቢታን ደኤይሳቶ፥ ዙማ ቦላ ማል ኤቅያ ዎደ ህንተ በአና፤ ሞይዘይ ፑነትያ ዎደ ህንተ ስአና።"]},{"type":"verse","number":4,"content":["ጎዳይ ታኮ፥ “ሴታ ጋላስ ስእ ግድ ፖእያ አዋዳ፥ ቃስ ካ ጫክያ አጌናን፥ ሆምብያ ቃማን በንትያ አካ መላ ታኒ ስእ ጋዳ፥ ታ ደእያ በሳፈ ዱገ ፄላና” ያግስ።"]},{"type":"verse","number":5,"content":["ካ ጫክያ ዎድያፐ ካሰ፥ ጪሻይ ቆለትድ ስምን፥ ዎይነ ቴርያ ዎደ ኦጮ ባጫን ፄራ ቃንፀይሳዳ እ ሄ ቢታ አሳ ይሳና።"]},{"type":"verse","number":6,"content":["ኤንቲ ኡባይ ደርያ ሁጵያን ደእያ፥ ምያባ ዎችያ ካፎታስነ ዶአታስ አታና። ካፎት ባልጎን፥ ዶአት ቦነን ኤንታ ምድ ሻጫና።"]},{"type":"verse","number":7,"content":["ሄ ዎደ አዱሰነ ሊቆ አሳፐ፥ ማታንነ ሃሆን ያሽያ አሳፐ፥ ዎልቃማነ ፆንያ ካዎተፈ፥ ዛዋይ ሻፋን ሻከትዳ ቢታፈ፥ ኡባፈ ዎልቃማ ጎዳስ እሞት ፅዮነ ዙማ፥ እያ ሱንይ ደእያ በሳ ያና።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/17.json","previousChapterAudioLinks":{},"numberOfVerses":7}