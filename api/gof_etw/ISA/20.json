{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_etw","name":"እሳያሳ ማፃፋ","commonName":"እሳያሳ ማፃፋ","title":"እሳያሳ ማፃፋ","order":23,"numberOfChapters":66,"sha256":"4ab89101f9b620becbbf3e12322e1f109302962dc48ac0ae8b6da090f19837b1","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":20,"content":[{"type":"heading","content":["ግብፀነ ቶጰ ቦላ ኦደትዳ ትንብተ"]},{"type":"verse","number":1,"content":["አሶረ ካዎይ ሳርጎን ኪትዳ ቶራ ሞጮናት ይድ፥ ፍልስፄመ ካታማ ግድዳ አሽዶዳ ኦልድ ኦይክዳ ላይ፥"]},{"type":"verse","number":2,"content":["ጎዳይ አሞፀ ናኣ እሳያሳ ሀይሳዳ ያግስ፦ “ነ ካዮ ማኡዋ ቃራ፤ ነ ቶሁዋፐ ጫማ ከሳ” ያግስ። እሳያስ ጎዳይ ግዳይሳዳ ኦድ ካሎነ መላ ቶሆን ሄመትስ።"]},{"type":"verse","number":3,"content":["ያትን ጎዳይ ሀይሳዳ ያግስ፦ “ታ አይለይ እሳያስ ግብፀነ ቶጰ ቦላ ጋካና መቱዋስ ማላ ግዳና መላ ሄ ላይ ካሎነ መላ ቶሆን ሄመትስ።"]},{"type":"verse","number":4,"content":["ሄሳ ግሾ አሶረ ካዎይ፥ ግብፀታስ ዬላ ግዳና መላ ግብፀፈነ ቶጰፈ ድኤትዳ ናአተታነ ጭማታ ካሎነ መላ ቶሆ ላግድ ኤፋና።"]},{"type":"verse","number":5,"content":["ቶጰን አማነተይሳትነ ግብፀን ጬቀተይሳት ያያና፤ ዬላታና።"]},{"type":"verse","number":6,"content":["ሄ ጋላስ አባ ጋፃን ደእያ አሳይ ሀይሳዳ ያጋና፦ ‘ኑና አሶረ ካዉዋፐ አሻና ግድ ኡፋይስ ኦድ ኤንታኮ ባቃትዳ አሳ ቦላ ሀይስ ጋክኮ፥ ያትን፥ ኑኒ ዋንድ ከስ ኤካኔ?’ ያጋና” ያግስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/19.json","previousChapterAudioLinks":{},"numberOfVerses":6}