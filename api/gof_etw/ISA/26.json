ber":19,"content":[{"text":"ሀይቅዳ ነ አሳይ ፓፃና፤","poem":1},{"text":"ኤንታ አሀይ ደንዳና።","poem":2},{"text":"ህንተኖ፥ ቢታ ጋርሳን ደኤይሳቶ፥","poem":1},{"text":"ደንድድ ኡፋይሳ ማዝሙረ የፅተ።","poem":2},{"text":"ህንተ አካይ ዎንታ አካ መላ፤","poem":1},{"text":"ቢትያ ሀይቅዳይሳታ ዛራዳ እማና።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ታ አሳዉ፥ ብድ ህንተ ሶ ገልድ፥","poem":1},{"text":"ካርያ ህንተ ቦላ ጎርድተ።","poem":2},{"text":"ጎዳ ሀንቆይ አና ጋካናዉ፥","poem":1},{"text":"ጉ ዎደስ ህንተና ቆስተ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ቢታ ቦላ ደእያ አሳ፥","poem":1},{"text":"ኤንታ ናጋራ ግሾ ሴራናዉ፥","poem":2},{"lineBreak":true},{"text":"ጎዳይ ባ ደእያ በሳፈ ከይድ ዬስ።","poem":2},{"text":"ቢትያ ባ ቦላ ጉክዳ ሱ ቆንጭሳና፤","poem":1},{"text":"ሀይቅዳይሳታ ዛራዳ ገንኩ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}