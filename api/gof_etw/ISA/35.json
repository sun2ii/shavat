{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_etw","name":"እሳያሳ ማፃፋ","commonName":"እሳያሳ ማፃፋ","title":"እሳያሳ ማፃፋ","order":23,"numberOfChapters":66,"sha256":"4ab89101f9b620becbbf3e12322e1f109302962dc48ac0ae8b6da090f19837b1","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":35,"content":[{"type":"heading","content":["ዎዘትዳ ደርያ ኡፋይሳ"]},{"type":"verse","number":1,"content":["ባይሳ ቢታይነ መላ ቢታይ ኡፋይታና፤ አይኮይ ባይና መላ ቢታይ ኡፋይታናነ ጪያና።"]},{"type":"verse","number":2,"content":["መላ ቢታይ ጪሸ ማአና፤ ኡፋይሳ ማዝሙረ የፃና። ልባኖሰ ቦንቹዋ ማአና፤ ቃርመሎሳነ ሳሮና ግታተይ እመታና፤ ኤንቲ ጎዳ ቦንቹዋነ ኑ ፆሳ ግታተ በአና።"]},{"type":"verse","number":3,"content":["ዳቡርዳ ኩሸታነ አርጋጭዳ ጉልባታታ ምንተ።"]},{"type":"verse","number":4,"content":["ያሻ ዎዛን ደኤይሳታኮ፥ “ምንተ! ያዮፍተ! ሄኮ፥ ህንተ ፆሳይ ሀሎ ከያናዉነ ባ ፆሳተን ኩሸ ዛራናዉ ይድ ህንተና አሻና” ያግተ።"]},{"type":"verse","number":5,"content":["ሄ ዎደ፥ ቆቀታ አይፈይ ዶየታና፤ ቱለታ ሀይይ ስአና።"]},{"type":"verse","number":6,"content":["ዎበት ገንኤዳ ጉፓና፤ ደዶት ኡፋይሳን የፃና፤ መላ ቢታን ሃ ጎጋና፤ መላ በሳን ፑልቶይ ቃና።"]},{"type":"verse","number":7,"content":["ፁግያ ሻፈይ ኤለ ሃ ግዳና፤ መላ ቢታይ ሃ ፑልታና፤ ዎርካናት አላትያ በሳን ማትነ ማይረይነ ማቅ ዶላና።"]},{"type":"verse","number":8,"content":["ያራ ዎጋ ኦገይ ከያና፤ እካ “ጌሻተ ኦገ” ጌተታና። ቱናት ሄ ኦግያራ ቦኮና፤ ኤያት ያን ስመረቶኮና፤ ሽን ጌሻታስ ግዳና።"]},{"type":"verse","number":9,"content":["ጋሞይ ዎይኮ ያሽያ ዶአት ያራ ካንኮና፤ ያን በንቶኮና፤ ሽን ዎዘትዳይሳታ ፃላል ሄመታና።"]},{"type":"verse","number":10,"content":["ጎዳይ ዎዝዳይሳት ስማና፤ የፅሽ፥ ፅዮነ ገላና፤ መርና ኡፋይሳይ ኤንታ ሁጵያን ኡታና። ኤንቲ ኡፋይታናነ ሀሹ ጋና፤ አዛኖይነ ኦለይ ኤንታፈ ሃካና።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}