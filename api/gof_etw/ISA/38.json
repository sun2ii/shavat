{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_etw","name":"እሳያሳ ማፃፋ","commonName":"እሳያሳ ማፃፋ","title":"እሳያሳ ማፃፋ","order":23,"numberOfChapters":66,"sha256":"4ab89101f9b620becbbf3e12322e1f109302962dc48ac0ae8b6da090f19837b1","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":38,"content":[{"type":"heading","content":["ህዝቅያሳ ሀርግያ"]},{"type":"verse","number":1,"content":["ሄ ዎደ ካዎይ ህዝቅያስ ሀርግድ፥ ሀይቃናዉ ማትስ። አሞፀ ናአይ ናበይ እሳያስ እያኮ ብድ፥ ጎዳይ፥ “ነ ሀይቃና ሀንያ ግሾ ነ ኬ ጊግሳ” ያግስ።"]},{"type":"verse","number":2,"content":["ህዝቅያስ ጎዳኮ ስም ዝንእድ፥ ጎዳ ዎስስ።"]},{"type":"verse","number":3,"content":["“አቤት ጎዳዉ፥ ታኒ ነ ስንን ቱማተንነ ኩመ ዎዛናን ሄመትዳይሳነ ነና ኡፋይስያባ ኦዳይሳ ሀሳያ” ያግድ ጫመትድ ዬክስ።"]},{"type":"verse","number":4,"content":["ሄሳፈ ጉየ፥ ጎዳ ቃላይ እሳያሳኮ፥"]},{"type":"verse","number":5,"content":["ባዳ ህዝቅያሳኮ፥ ጎዳይ ነ ማይዛ ዳዊታ ፆሳይ፥ “ታኒ ነ ዎሳ ስአስ፤ ነ አፉ በአስ። ነ ላይ ቦላ ታኒ ታማነ እቻሹ ላይ ጉጃና።"]},{"type":"verse","number":6,"content":["ነናነ ሀ ካታማ አሶረ ካዋ ኩሸፐ አሻና፤ ታኒ ሀ ካታማስ ኦለታና” ያጋ።"]},{"type":"verse","number":7,"content":["“ጎዳይ ባ ግዳ ቃላ ፖላናዉ እምዳ ማላይ ሀይሳ ያግስ፦"]},{"type":"verse","number":8,"content":["አካዝ ከያናዉ ጊግስዳ ደን ደእያ ኩያይ ታሙ ታንጎ ጉየ ስሚድ ባና መላ ታኒ ኦና” ያግስ። ኩያይ ታሙ ታንጎ ጉየ ስሚድ ብስ።"]},{"type":"verse","number":9,"content":["ይሁዳ ካዎይ ህዝቅያስ ሀርግያፈ ፓፅድ ፃፍዳ ማዝሙረይ ሀይሳ፦"]},{"type":"verse","number":10,"content":[{"text":"ታኒ፥ “ታ ደኦ ላይይ ባጋ ጋኮና ደእሽን፥","poem":1},{"text":"ሀይቆ ፐንገራ ገላና ሀንያና?","poem":2},{"lineBreak":true},{"text":"አትዳ ላይ ቦንቀታና ሀንያና?” ያጋስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“ታኒ ደኦን ደኤይሳታ ቢታን ጎዳ በእከ፤","poem":1},{"text":"ሀ ሳአን አሰ በእከ፤","poem":2},{"lineBreak":true},{"text":"ሀ አላምያን ደኤይሳታራ ዛራዳ ደእከ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዶርሰ ሄመይሳታ ዱንካንያዳ፥","poem":1},{"text":"ታ ደኦይ ሾደትስ።","poem":2},{"text":"ዶርዘይ አፍላ ዋንዳራሸን ፃፀይሳዳ፥","poem":1},{"text":"ታ ደኦይ ፃፀትስ።","poem":2},{"text":"ዶርዘይ አፍላ ዱያዳ፥","poem":1},{"text":"ታ ደኡዋ ዱስ።","poem":2},{"text":"ዎንታፈ ኦማርስ ጋካናዉ","poem":1},{"text":"ታና ይሳሳ” ያጋስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“ቃማ ኩመ ዳንዳአን ናጋስ፤","poem":1},{"text":"ጋሞዳ ታ መቀ ኡባ መንዳሳ፤","poem":2},{"lineBreak":true},{"text":"ዎንታፈ ኦማርስ ጋካናዉ ታና ይሳዳሳ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ታኒ ካሮዳነ ጭላሾዳ ዋሳስ፤","poem":1},{"text":"ሆለዳ ዙዙማስ።","poem":2},{"text":"ታ አይፈይ ሳሎ ፄልሸ ዳቡርስ፤","poem":1},{"text":"ጎዳዉ፥ ታኒ ኡንኤታስ፤","poem":2},{"lineBreak":true},{"text":"ኔኒ ታና ሀ ኡንኣፈ ከሳ” ያጋስ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሀይሳ ኡባ ኦዳይ ጎዳ፤","poem":1},{"text":"ታኒ አይ ጋናዉ ዳንዳእያና?","poem":2},{"text":"ታ ሸምፖይ ኡንኤትዳ ግሾ፥","poem":1},{"text":"ታ ላይ ኡባ አሽከተን ዳና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ጎዳዉ፥ ሀይሳ መላ ሴራን","poem":1},{"text":"አሳይ ደኦን ደኤስ።","poem":2},{"text":"ሀእ ታ ፓያተ ዛራዳ፥","poem":1},{"text":"ታና ደኦን ዎ!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ታ ኡንኤተይ ታዉ ሎኦ ግድስ፤","poem":1},{"text":"ኔኒ ታ ሸምፑዋ ዮ ኦላፈ አሻዳሳ፤","poem":2},{"lineBreak":true},{"text":"ታ ናጋራ ኡባ ኔኒ ጉየ የጋዳሳ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዱፎይ ነና ጋላተና፤","poem":1},{"text":"ሀይቆይ ነና ሳበና።","poem":2},{"text":"ኦላን ዎዳይሳት፥","poem":1},{"text":"ነ አማነተ ኡፋይስ ኦኮና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ታኒ ሀች ነና ጋላተይሳዳ፥","poem":1},{"text":"ደኦን ደኤይሳት ነና ጋላቶሶና።","poem":2},{"text":"ነ አማነተ","poem":1},{"text":"አዋት ባንታ ናይታስ ኦዶሶና።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ጎዳይ ታና አሻና፤","poem":1},{"text":"ሄሳ ግሾ፥ ኑኒ ኑ ደኦ ላይ ኡባን፥","poem":2},{"lineBreak":true},{"text":"ጎዳ ኬን ዲን የፃና።","poem":2}]},{"type":"verse","number":21,"content":["እሳያስ ካሰ፥ “ባላሰ ዳፅድ፥",{"text":"እያ ክፃ ቦላ ዎተ፤","poem":2},{"lineBreak":true},{"text":"እ ፓፃና” ያግስ።","poem":2}]},{"type":"verse","number":22,"content":["ህዝቅያስ ካሰ፥ “ታኒ ፓፃዳ ጎዳ ኬ ባናይሳስ ማላይ አይበ” ያግድ እሳያሳ ኦይችስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}