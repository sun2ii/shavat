{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_etw","name":"እሳያሳ ማፃፋ","commonName":"እሳያሳ ማፃፋ","title":"እሳያሳ ማፃፋ","order":23,"numberOfChapters":66,"sha256":"4ab89101f9b620becbbf3e12322e1f109302962dc48ac0ae8b6da090f19837b1","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":["ሄ ጋላስ ላፑን ማጫሳት እስ አደ ኦይክድ፥ “ኑኒ ኑ ካ ማና፤ ኑ ማኦ ማአና። ነ ሱንን ፄገታና መላ ኦዳ ኑ ካዉሻ ኑፐ ድጋርኪ?” ያግድ ዎሳና።"]},{"type":"heading","content":["ፆሳ ም ታሸ"]},{"type":"verse","number":2,"content":["ሄ ዎደ ጎዳ ታሸይ፥ ሎአናነ ቦንቸታና፤ አትዳ እስራኤለ አሳስ ቢታ ካይ ጬቆነ ቦንቾ ግዳና።"]},{"type":"verse","number":3,"content":["ፅዮነን አትዳይሳት፥ የሩሳላመን ዮፐ ከስ ኤክዳይሳትነ ደኦስ ፃፈትዳይሳት ጌሻታ ጌተታና።"]},{"type":"verse","number":4,"content":["ጎዳይ ፅዮነ ማጫሳ ቅታ ሜጫና፤ ባ ፕርዳንነ ባ አያና ታማን ሱ ጉሶ የሩሳላመፐ ድጋና።"]},{"type":"verse","number":5,"content":["ጎዳይ ፅዮነ ዙማ ቦላነ ያን ሺቅያ ኡባ ቦላ ጋላስ ሻራ ጩያነ ቃማ ታማ ላጮ መና፤ እያ ቦንቾ ኡባ ቦላ ካማ ግዳና።"]},{"type":"verse","number":6,"content":["እ፥ ጋላሳ ምሻፐ አሽያ ኩያነ ኡሾፐነ እራፐ ቆሰትያ በሰ ግዳና።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/3.json","previousChapterAudioLinks":{},"numberOfVerses":6}