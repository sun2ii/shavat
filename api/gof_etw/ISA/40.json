ype":"verse","number":6,"content":[{"text":"እስ ግርስ፥ “ዋሳ” ያግሽን ስአስ፤","poem":1},{"text":"ታኒ፥ “ዎይጋዳ ዋሶ?” ያጋስ።","poem":2},{"lineBreak":true},{"text":"“አስ ኡባይ ማታ መላ፤","poem":1},{"text":"እያ ቦንቾ ኡባይ ጪሻ መላ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ጎዳ እያ ቦላ ሸምፕያ ዎደ፥","poem":1},{"text":"ማታይ መሌስ፤ ጪሻይ ቆቆፈቴስ፤","poem":2},{"lineBreak":true},{"text":"አስ ቱማ ማታ መላ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ማት መሌስ፤ ጪሽ ቆቆፈቴስ፤","poem":1},{"text":"ሽን ኑ ፆሳ ቃላይ","poem":2},{"lineBreak":true},{"text":"መርናዉ ኤቅድ ደኤስ” ያጋዳ ዋሳ።","poem":2}]},{"type":"verse","number":9,"content":["ነኖ ፅዮነስ ሎኦባ ኦደይሶ፤",{"text":"ዙማ ቦላ ከያ።","poem":2},{"text":"ነኖ የሩሳላመስ ሎኦባ ኦደተይሶ፤","poem":1},{"text":"ነ ቃላ ቁ ኦዳ ዋሳ።","poem":2},{"text":"ያዮፋ፤ ቁ ኦ፤","poem":1},{"text":"ይሁዳ ካታማታስ፥ “ህንተ ፆሳይ ሀይስሽ” ያጋ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሄኮ፥ ኡባ ሃርያ ጎዳይ ዎልቃራ ዬስ፤","poem":1},{"text":"እያ ቀሰይ እያዉ ሃራና።","poem":2},{"text":"እያ ዎይቶይ እያራ ደኤስ፤","poem":1},{"text":"ጭግያ ጋተይ እያ ስንና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እ ባ ዉድያ ሄንንቾዳ ሄማና፤","poem":1},{"text":"ባ ዶርሳ ማራታ ባ ቀስያን ሺሻና፤","poem":2},{"lineBreak":true},{"text":"ኤንታ ባ ክኦን እድማና፤","poem":2},{"lineBreak":true},{"text":"ንይሳታ ሎዳራ ካለና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሃታ ባ ኩሸ ቃቃን፥","poem":1},{"text":"ሳሎታ ታካን ልክዳይ፥","poem":2},{"lineBreak":true},{"text":"ቢታ ባና ዳቾን ማክዳይ፥","poem":2},{"lineBreak":true},{"text":"ደረታነ ዙማታ ምዛነን ልክዳይ ኦኔ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ጎዳ አያና ኤርዳይ፥","poem":1},{"text":"እያ ዞርድ ታማርስዳይ ኦኔ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እያዉ ቆንጭሳና መላ ኦና ዞረ ኦይችዴ?","poem":1},{"text":"ሱረ ፕርዳ እያ ታማርስዳይ ኦኔ?","poem":2},{"text":"እያ ጭንጫተ ታማርስዳይ፥","poem":1},{"text":"እያ አኬካ በስዳይ ኦኔ?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሄኮ፥ ካዎተት ፁጋን ደእያ እስ ፆኮ መላ፤","poem":1},{"text":"ኤንቲ ምዛነ ቦላ ደእያ ባና መላ፤","poem":2},{"lineBreak":true},{"text":"እ ዩሾይ አባን ተቀትዳ ቢታታ ባናዳ ልከስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ልባኖሰ ምይ ያርሾ በሳን ኤፃናዉ ግደና፤","poem":1},{"text":"እያን ደእያ ዶአት ፁሳ ያርሾስ ግዶኮና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ካዎተት ኡባይ እያ ስንን ባይናባ መላ፤","poem":1},{"text":"ኤንቲ እያ ስንን ኡባ አይኮካ ግዶኮና፤","poem":2},{"lineBreak":true},{"text":"ባይናባፐካ ላፋ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ያትን፥ ፆሳ ህንተ ኦደራ ግናየቲ?","poem":1},{"text":"አይባ ምስለራ ጋድ ፄለቲ?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ኩሸ ሂላንቾይ ኤቃ ምስለ ጊግሴስ፤","poem":1},{"text":"ዎርቃ ሼሸይስ ዎርቃን ላንፄስ፤","poem":2},{"lineBreak":true},{"text":"ብራ ሼሸይስ እያ ቦላ","poem":2},{"lineBreak":true},{"text":"ብራ ሳንላታ መስ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ሚሸይ ባይና ማንቆይ፥","poem":1},{"text":"ያርሾስ ፆና ም ዶሬስ።","poem":2},{"text":"ምስለይ ቃፆና መላ ኤሳናዉ","poem":1},{"text":"ኩሸ ሂላንቾ ኮዬስ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ኤርቤከቲ? ዎይኮ ስእቤከቲ?","poem":1},{"text":"ሀይስ ህንተዉ ኮይሮፐ ኦደትቤኔ?","poem":2},{"text":"ዎይኮ ሳእ መቶሳፐ","poem":1},{"text":"ሀይሳ ህንተ አኬክበከቲ?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"እ ቢታ ገርቱዋፈ ቦላ ባጋን","poem":1},{"text":"ባ አራታን ኡቴስ፤","poem":2},{"lineBreak":true},{"text":"ቢታን ደእያ አሳት ፃቆ መላ።","poem":2},{"text":"ሳሎታ ገሸዳ ምጬስ፤","poem":1},{"text":"ዱንካነዳ ደእያ በሲ ኦድ ቶሌስ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"እ፥ ሀላቃታ ባይናባዳ ኦስ፤","poem":1},{"text":"ሀ አላምያ ሃረይሳታ ሀዳ ከሴስ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ኤንቲ ቶከትድ ቡሮ ጋምኦናሽን፥","poem":1},{"text":"ዘረትድ ቡሮ ፃጶ የዶናሽን፥","poem":2},{"text":"ጎዳይ ኤንታ ቦላ ጫርኮ የድስ፤","poem":1},{"text":"ኤንቲ መልን ጎተይ ኤንታ ፑኖዳ ኤፍስ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ያትን፥ ታና ኦደራ ልከየቲ?","poem":1},{"text":"ታና ኦደራ ግናየቲ? ያጌስ ጌሻይ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ህንተ አይፍያ ቁ ኦድ ሳሎ ፄልተ፤","poem":1},{"text":"ሀ ፆልንቶታ መዳይ ኦኔ?","poem":2},{"text":"እ ኤንታ ኦላንቾዳ ካለስ፤","poem":1},{"text":"ኤንታ ታይቡዋ ኤሬስ።","poem":2},{"text":"እ ኤንታ ኡባ ኤንታ ሱንን ሱንን ፄጌስ፤","poem":1},{"text":"እያ ዎልቃ ግታተፈነ ምኖተፈ ደንዶይሳን፥","poem":2},{"lineBreak":true},{"text":"ኤንታፈ እሶይካ የና።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ነኖ ያይቆባ፥ ነኖ እስራኤለ፥","poem":1},{"text":"ታ ኦገይ ጎዳፐ ጌምስ፤","poem":2},{"lineBreak":true},{"text":"ታ ፕርዳይ ፆሳፈ ቆሰትስ፤","poem":2},"ያጋዳ አይስ ኦደታይ?"]},{"type":"verse","number":28,"content":[{"text":"ኤራብኪ? ስአብኪ?","poem":1},{"text":"ጎዳይ መርና ፆሳ፤","poem":2},{"lineBreak":true},{"text":"ቢታ ኡባ መዳይ እያ።","poem":2},{"text":"እ ዳቡረና፤ ዎይኮ አርጋጨና፤","poem":1},{"text":"ኦንካ እያ ቆፋ ኤራናዉ ዳንዳኤና።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"እ ዳቡርዳይሳታስ ዎልቃ እሜስ፤","poem":1},{"text":"ምኖተ ባይናይሳስ ምኖተ ጉጄስ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ሀር አቶሽን ያላጋ ናይት","poem":1},{"text":"ዳቡሮሶና፤ አርጋጮሶና፤","poem":2},{"lineBreak":true},{"text":"ናአተት ዳቡርድ ኩንዶሶና።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ሽን ጎዳ አማነትድ ናገይሳት፥","poem":1},{"text":"ባንታ ዎልቃ ኦራና።","poem":2},{"text":"ኤንቲ አርጋንዳ ቀፈን ፓላና፤","poem":1},{"text":"ዎፃና፥ ሽን ዳቡሮኮና፤","poem":2},{"lineBreak":true},{"text":"ሄመታና፥ ሽን አርጋጮኮና።","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"አይኮይካ ባይና ማንቆ ቢታ ዎይኮ መላ ቢታ ዎይኮ ፁገትዳ ቢታ ጉሱ","reference":{"chapter":40,"verse":3}}]},"thisChapterLink":"/api/gof_etw/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}