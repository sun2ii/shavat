{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_etw","name":"እሳያሳ ማፃፋ","commonName":"እሳያሳ ማፃፋ","title":"እሳያሳ ማፃፋ","order":23,"numberOfChapters":66,"sha256":"4ab89101f9b620becbbf3e12322e1f109302962dc48ac0ae8b6da090f19837b1","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":41,"content":[{"type":"heading","content":["እስራኤለ ማዱዋ"]},{"type":"verse","number":1,"content":[{"text":"ህንተኖ፥ ዩሾይ አባን ተቀትዳ ቢታቶ፥","poem":1},{"text":"ስእ ግድ፥ ታኒ ኦደይሳ ስእተ!","poem":2},{"text":"ደረይ ባንታ ዎልቃ ኦራ፤","poem":1},{"text":"ኤንቲ ሃ ሺቅድ፥ ኦደቶ፤","poem":2},{"lineBreak":true},{"text":"አነ ኑኒ ፕርደታናዉ እስፈ ሺቆስ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“ዶሎሀ ባጋፈ እሱዋ ደንድ ብያ በሳ ኡባን ፆኖ እመይ ኦኔ?","poem":1},{"text":"እ ካዎተታ እያ ኩሸን አድ እሜስ፤","poem":2},{"lineBreak":true},{"text":"ካዎታ እያዉ ሃርስስ።","poem":2},{"text":"እ ኤንታ ባ ማሻን ብዶ ከሴስ፤","poem":1},{"text":"ባ ዶንግያን ኤንታ ፑኖ ኦስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እ ኤንታ የደሸ፥ እያ ቶሆይ ካሰ የቦና","poem":1},{"text":"ኦግያራ ሳሮ ካንስ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሀይሳ ኦዳይነ ፖልዳይ","poem":1},{"text":"የለተካ ኮይሮፐ ፄግዳይ ኦኔ?","poem":2},{"text":"ታኒ ጎዳይ፥ ኮይሩዋራ ደአይስ","poem":1},{"text":"ዉርሰራካ ደኤይ ታና” ያጌስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዩሾይ አባን ተቀትዳ ቢታት፥","poem":1},{"text":"ሄሳ በእድ ያይዶሶና፤","poem":2},{"lineBreak":true},{"text":"ሳኣ ጋፃን ደኤይሳት ኮኮርዶሶና።","poem":2},{"text":"ኤንቲ እስፈ ሺቅድ ታኮ ይዶሶና።","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"እሶይ እሱዋ ማዴስ፤","poem":1},{"text":"ባ እሻ፥ “ምና” ያጌስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኩሸ ሂላንቾይ ዎርቃ ሼሸይሳ ምንስ፤","poem":1},{"text":"ናርቃን ቆፅድ ሌእሰይስ","poem":2},{"lineBreak":true},{"text":"ባቻን ብራታ ሴርሰይሳ፥ “ምና” ጌስ።","poem":2},{"text":"እ ብራታ ንይሳ፥ “ሎኦ ኦሳ” ያጌስ፤","poem":1},{"text":"ኤቃይ ቃፆና መላ ምስማረን ሼስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“ሽን ነኖ እስራኤለ፥ ታ አይልያዉ፥","poem":1},{"text":"ታ ዶርዳ ያይቆባ፥","poem":2},{"lineBreak":true},{"text":"ታ ላግያ አብራሃመ ኮቻዉ፥","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ታኒ ነና ቢታ ጋፃፐ ኤሀስ፤","poem":2},{"lineBreak":true},{"text":"ሃሆሶፐ ፄጋዳ፥ ‘ኔኒ ታ አይለ’","poem":2},{"lineBreak":true},{"text":"ታኒ ነና ዶራስ፤ ታኒ ነና የግከ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ያዮፋ፥ ታኒ ኔራ ደአይስ፤","poem":1},{"text":"ዳጋሞፋ፥ ታኒ ነ ፆሳ።","poem":2},{"text":"ታኒ ነና ምንና፤ ነና ማዳና፤","poem":1},{"text":"ታኒ ነና ፆንያ ታ ኡሻቻ ኩሽያን ካትሳና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ነ ቦላ ሀንቀትያ ኡባይ ዬላትድ ካዉያና፤","poem":1},{"text":"ኔራ ኤቀተይሳት ባይናባ ግዳና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ነ ሞርከታ ኔኒ ኮያና፤","poem":1},{"text":"ሽን ኤንታ ደማካ፤","poem":2},{"lineBreak":true},{"text":"ነና ኦለይሳት ባይናባ ግዳና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታኒ ጎዳይ፥ ነ ፆሳይ፥","poem":1},{"text":"ነ ኡሻቻ ኩሽያ ኦይካና፤","poem":2},{"lineBreak":true},{"text":"ያዮፋ፥ ታኒ ነና ማዳና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ነኖ ጉፁንያዉ፥ ያይቆባ፥ ህንተኖ እስራኤለ አሳዉ፥","poem":1},{"text":"ያዮፍተ፤ ታኒ ህንተና ማዳና፤","poem":2},{"lineBreak":true},{"text":"ህንተና ዎዝያ እስራኤለ ጌሻይ ታና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሄኮ፥ ታኒ ነና ኦራ፥","poem":1},{"text":"ቃራነ አቻራ ደእያ፥","poem":2},{"lineBreak":true},{"text":"ካ ቆፅያ ሚሸ ኦስ።","poem":2},{"text":"ኔኒ ደረታ ቆፃዳ ሊቅሳና፤","poem":1},{"text":"ዙማታካ ፑኖ ኦና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኔኒ ኤንታ ፑናና፤ ጫርኮይ ኤንታ ኤፋና፤","poem":1},{"text":"ሽን ኔኒ ጎዳን ኡፋይታና፤","poem":2},{"lineBreak":true},{"text":"እስራኤለ ጌሻን ቦንቸታና።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“ማንቆትነ መቶታንቾት ሃ ኮያና፥","poem":1},{"text":"ሽን ደሞኮና፤ ኤንታ ቆይ ሳሞን መላና።","poem":2},{"text":"ግዶሽን፥ ታኒ ጎዳይ ኤንታ ስአና፤","poem":1},{"text":"ታኒ፥ እስራኤለ ፆሳይ፥ ኤንታ አግከ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ታኒ መላ ዙማታ ቦላ ሻፋ፥","poem":1},{"text":"ዛንጋራታን ፑልቶ ሳና።","poem":2},{"text":"ባዙዋ ሃ ኤልያ በሲ፥","poem":1},{"text":"መላ ቢታ ፑልቶይ ከያሶ ኦና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ታኒ መላ ቢታን፥ ዝጋ፥ ሶቃላ ም፥","poem":1},{"text":"ባርሰኔተ ምነ ሻማሆ ዶልሳና።","poem":2},{"text":"መላ ቢታ ፂድ፥ ማሮይነ","poem":1},{"text":"ጫጭ ኩምዳ ቢታ ኦና።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እስራኤለ ጌሻይ ሄሳ መዳይሳነ","poem":1},{"text":"ጎዳ ኩሸይ ሄሳ ኦዳይሳ","poem":2},{"lineBreak":true},{"text":"አሳይ በአና፥ ኤራና፥ ቆፓናነ","poem":2},{"lineBreak":true},{"text":"አኬካና መላ ታኒ ሄሳ ኦስ።”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“አነ ህንተ ሞቱዋ ሺሽተ” ያጌስ ጎዳይ፤","poem":1},{"text":"“አነ ህንተ ማርካ ሃ ኤህተ” ያጌስ ያይቆባ ካዎይ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"አነ ኤንቲ ባንታ ኤቃታ ሃ ኤሆ፥","poem":1},{"text":"አይብ ሀናኔኮ ኤንታ ኤቃት ኑስ ኦዶ።","poem":2},{"text":"ኑኒ አኬካና መላነ ኤንታ ዉርሰ ኤራና መላ","poem":1},{"text":"ካሰ ሀንዳባይ አይበኮ ኑስ ኦዶ፤","poem":2},{"lineBreak":true},{"text":"ዎይኮ ስንፈ ሀናናባ ኑስ ቆንጭሶ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ህንተ ፆሳታ ግደይሳ ኑኒ ኤራና መላ","poem":1},{"text":"ስንፈ ያናዉ ደእያባ ኑስ ኦድተ።","poem":2},{"text":"ኑኒ ዳጋማና መላነ ያያና መላ፥","poem":1},{"text":"ሎኦ ግድን ኢታ ግድን አነ እስባ ኦተ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ሽን ህንተ ባይናባ መላ፤","poem":1},{"text":"ህንተ ኦሶይካ ሀዳ፤","poem":2},{"lineBreak":true},{"text":"ህንተና ዶርያ አሳይካ እፀትዳይሳታ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ታኒ ፑደሀ ባጋፈ እሱዋ ደንን፥","poem":1},{"text":"እ ዬስ።","poem":2},{"text":"ታ ሱን ፄግያ እሶይ ዶሎሀፐ ያና፤","poem":1},{"text":"ኦቶ መይስ ኡርቃ የይሳዳ፥","poem":2},{"lineBreak":true},{"text":"እ ካለይሳታ የና።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ኑኒ ኤራና መላነ እ ልከ ጋና መላ","poem":1},{"text":"ካሰትድ ኑስ ሀይሳ ኦድዳይ ኦኔ?","poem":2},{"text":"ህንተፈ ኦንካ ካሰትድ ሀይሳ ቆንጭስዳይ፥","poem":1},{"text":"ዎይኮ አዋጅዳይ ዎይኮ ባ ቃላ ስስዳይ ባዋ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ታኒ ሀይሳ ካሰታዳ ፅዮነስ ኦዳስ፤","poem":1},{"text":"ታኒ የሩሳላመስ ምሽራቾ ኦደይሳ እማስ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ሽን ታኒ ፄልያ ዎደ እሶይካ ባዋ፤","poem":1},{"text":"ታኒ ዞረ ኦይችያ ዎደ ኤንታ ኤቃታ ግዶፈ","poem":2},{"lineBreak":true},{"text":"ዛሮ እምያ እሶይካ ባዋ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ሄኮ፥ ኤንቲ ኡባይ ሀዳ፤ ኤንታ ኦሶይካ ፓና፤","poem":1},{"text":"ሼሽድ መዳ ኤንታ ምስለትካ ጫርኮ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":29}