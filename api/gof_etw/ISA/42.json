":true},{"text":"እያን ሄመትያ ኡባስ ደኦ እምዳይ፥","poem":2},{"text":"ጎዳ ፆሳይ ሀይሳዳ ያጌስ።","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ታኒ ጎዳይ ነና ፅሎተን ፄጋስ፤","poem":1},{"text":"ነ ኩሽያ ኦይካዳ ነና ናጋና።","poem":2},{"text":"ታኒ ነና አሳስ ጫቆ ኦና፤","poem":1},{"text":"ካዎተታስ ፖኦ ኦዳ እማና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኔኒ ቆቀ አይፈታ ዶያና፤","poem":1},{"text":"ማ ኦላን፥ ቃሾ ኬን ደኤይሳታ ከሳና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታኒ ጎዳ፤ ሄስ ታ ሱን፤","poem":1},{"text":"ታ ቦንቹዋ ታኒ ሀራስ እምከ፤","poem":2},{"lineBreak":true},{"text":"ታ ጋላታ ኤቃታስ እምከ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሄኮ ታኒ ካሰ ኦድዳባ ኡባይ ፖለትዶሶና፤","poem":1},{"text":"ሀእ ታኒ ኦራባ አዋጃይስ፤","poem":2},{"lineBreak":true},{"text":"ኤንቲ ሀናናፐ ስን ታኒ ህንተዉ ኦዳይስ” ያጌስ።","poem":2}]},{"type":"heading","content":["ፆሳይ ጋላተቶ"]},{"type":"verse","number":10,"content":[{"text":"ጎዳስ ኦራ ማዝሙረ የፅተ፤","poem":1},{"text":"ቢታ ጋፃፐ ጋፃ ጋካናዉ እያ ጋላታ የፅተ።","poem":2},{"text":"አባ ግዶራ በይሳትነ እያን ደኤይሳት፥","poem":1},{"text":"ዩሾይ አባን ተቀትዳ ቢታትነ እያን ደእያ ኡባይ የፆ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"መላ ቢታን ደእያ ካታማት፥","poem":1},{"text":"ቀዳረ አሳይ ደእያ ጉታት","poem":2},{"lineBreak":true},{"text":"ባንታ ቃላ ቁ ኦና።","poem":2},{"text":"ሰላአ ካታማን ደኤይሳት ኡፋይሳን የፆ፤","poem":1},{"text":"ደርያ ሁጰን ባንታ እልልሳ ስሶ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኤንቲ ቦንቾ ጎዳስ እሞ፤","poem":1},{"text":"እያ ጋላታ ዩሾይ አባን ተቀትዳ ቢታታን ኦዶ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ጎዳይ ምኖ አሳዳ ከያና፤","poem":1},{"text":"ባ ቃላ ቁ ኦድ ኦላ አዋጃና።","poem":2},{"text":"ባ ቃላ ቁ ኦድ ገሬራና፤","poem":1},{"text":"ባ ሞርከታ ፆናና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ዳሮ ዎደ ስእ ጋዳ ጋምአስ፤","poem":1},{"text":"ስእ ጋዳ ዳንዳአስ።","poem":2},{"text":"ሽን ሀእ እቀ ኦይክዳ ማጫሳዳ ታ ዋሳና፤","poem":1},{"text":"ቶካ ሸምፓናነ ፔኑቃና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ደረታነ ዙማታ ላላና፤","poem":1},{"text":"ኤንታ ቦላ ዶልዳባ ኡባ መልሳና።","poem":2},{"text":"ሻፋታ ዩሾይ አባን ተቀትዳ ቢታ ከሳና፤","poem":1},{"text":"ኤለ ሃታ መልሳና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ታኒ ቆቀታ ኤንቲ ኤሮና ኦግያራ ካለና፤","poem":1},{"text":"ኤንቲ ኤሮና ሆሮጋራ ኤፋና።","poem":2},{"text":"ኤንታ ስንን ማ ፖኦ ከሳና፤","poem":1},{"text":"ኤንታ ስንን ደእያ ኦግያ ባሳና።","poem":2},{"text":"ሀ ኡባ ታኒ ኤንታዉ ኦና፤","poem":1},{"text":"ታኒ ኤንታ ኦና አግከ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“ሽን ኤቃ ምስለታን አማነተይሳት፥","poem":1},{"text":"ምስለታ፥ ‘ህንተ ኑ ፆሳታ’ ያገይሳት፥","poem":2},{"lineBreak":true},{"text":"ዬላን ጉየ ስማና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ህንተ ቱለት፥ ስእተ፤","poem":1},{"text":"ህንተ ቆቀት፥ ፄልተ፥","poem":2},{"lineBreak":true},{"text":"ሎይድ በእተ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ታ አይልያፈ ሀር ቆቀይ ኦኔ?","poem":1},{"text":"ታ ኪትዳይሳፈ ሀር ቱለይ ኦኔ?","poem":2},{"text":"ባና ጎዳስ አድ እምዳ ኡራፐ","poem":1},{"text":"ጎዳ አይልያፈ ሀር ቆቀይ ኦኔ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዳሮባ በአዳሳ፥ ሽን አኬካካ፤","poem":1},{"text":"ነ ሀይይ ዶያ፥ ሽን ስአካ” ያጌስ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ጎዳይ ባ ፅሎተ ግሾ፥","poem":1},{"text":"ባ ህግያ ግታያናዉነ ቦንቻናዉ ዶስስ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ሽን ሀ አሳይ ቦንቀትስ፤","poem":1},{"text":"ደእያባ ኤከትስ።","poem":2},{"text":"ኦላ ግዶን ፅሄን ኦይከትስ፥","poem":1},{"text":"ቃሾ ኬን ኤንታ ቦላ ጎርደትስ።","poem":2},{"text":"ኤንቲ ቦንቀትዶሶና፥ ሽን ኤንታ አሸይ ባዋ፤","poem":1},{"text":"ድኤትዶሶና፥ ሽን ኦንካ “ኤንታ ጉየ ዛራ”","poem":2},"ግያ አስ ባዋ።"]},{"type":"verse","number":23,"content":[{"text":"ህንተ ግዶፈ ሀይሳ ስኤይ ኦኔ?","poem":1},{"text":"ስንፈ ያና ዎድያባ ቆፐይ ኦኔ?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ያይቆባ ድኤተስ፥","poem":1},{"text":"እስራኤለ ቦንቄስ አድ እምዳይ ኦኔ?","poem":2},{"text":"ናጋራ ኦድ ኑ ቆህዳ፥","poem":1},{"text":"እያ ኦግያ ካላናዉነ፥ እያ ህግያ ኪተታናዉ","poem":2},{"lineBreak":true},{"text":"ኑኒ እፅዳ ጎዳ ግደነዬ?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ሄሳ ግሾ፥ እ ኤንታ ቦላ ባ ኤፅያ ሀንቁዋ ጉስስ፤","poem":1},{"text":"ኤንታ ዩሹዋ ታማ ላጮን ተቅስ፥","poem":2},{"lineBreak":true},{"text":"ሽን ኤንቲ ኤርቦኮና፤","poem":2},{"text":"እ ኤንታ ፁግስ፥","poem":1},{"text":"ሽን ኤንቲ አ