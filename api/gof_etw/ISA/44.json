ineBreak":true},{"text":"ባጋ ኤድ ካ ካስ።","poem":2},{"text":"አትዳይሳ ኤክድ ፆሰ ኦድ እያዉ ጎይኔስ፤","poem":1},{"text":"ኤቃ መድ እያ ስንን ጉፋኔስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እያፐ ባጋ ኤድ ካ ካስ፤","poem":1},{"text":"ባጋን አሾ ጫጭድ ካልድ ሜስ።","poem":2},{"text":"ቃስ ታማ ካይሸ፥ “ኤሮሾ፥ ታማ ጎፓ፤","poem":1},{"text":"ዋን ሆእ” ያጌስ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ቃስ አትዳ ም ማስድ፥","poem":1},{"text":"ጎይንያ ፆሳ ምስለ ከሴስ።","poem":2},{"text":"ሄ ምስልያ ስንን ጉፋንድ፥ እያዉ ጎይኔስ፤","poem":1},{"text":"“ኔኒ ታዉ ፆሰ ግድያ ግሾ፥","poem":2},{"lineBreak":true},{"text":"ታና አሻ” ያግድ ዎሴስ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ኤንቲ አይኮካ ኤሮኮና፤ አይኮካ አኬኮኮና፤","poem":1},{"text":"ኤንቲ በኦና መላ ኤንታ አይፈይ ጎዘትስ፤","poem":2},{"lineBreak":true},{"text":"አኬኮና መላ ኤንታ ዎዛናይ ጎርደትስ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ኤቃ ኦያ አሳ ግዶፈ ባ ዎዛናን፥","poem":1},{"text":"“እያፐ ባጋ ታማን ኤስ፤","poem":2},{"lineBreak":true},{"text":"እያ ቦንቁዋን ካ ካስ፤","poem":2},{"lineBreak":true},{"text":"እያን አሾ ጫጫዳ ማስ።","poem":2},{"text":"እያፐ አትዳይሳ እፀትዳ ኤቃ ኦዳ መ?","poem":1},{"text":"አትዳ ጩገ ምስ ጉፋናዳ ጎይኖ?”","poem":2},{"lineBreak":true},{"text":"ያግድ ቆፕያ ዎይኮ አኬክያ አስ ባዋ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እ ብዶ ሜስ፤ እያ ጭመትዳ ዎዛናይ","poem":1},{"text":"እያ ሀራ ሶ ካለስ።","poem":2},{"text":"እ ባ ሸምፑዋ አሻናዉ ዳንዳኤና፤","poem":1},{"text":"“ሀይስ ታ ኡሻቻ ኩሸን ደኤይ ዎርዶ ግደና”","poem":2},{"lineBreak":true},{"text":"ጋናዉ ዳንዳኤና።","poem":2}]},{"type":"verse","number":21,"content":["ጎዳይ ሀይሳዳ ያጌስ፦",{"text":"“ያይቆባ፥ ሀይሳ አኬካ፤","poem":1},{"text":"እስራኤለ፥ ኔኒ ታ አይለ ግድያ ግሾ ሀይሳ ሀሳያ።","poem":2},{"text":"ታኒ ነና መስ፤ ኔኒ ታ አይለ፤","poem":1},{"text":"ነኖ እስራኤለ፥ ታኒ ነና ዶግከ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ታኒ ነ ናጋራ ፕታዳ ድጋስ፥","poem":1},{"text":"ነ ናቁዋ ጫጋናዳ ቁቻስ።","poem":2},{"text":"ታኒ ነና ዎዝዳ ግሾ፥","poem":1},{"text":"ታኮ ስማ” ያጌስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“ህንተኖ ሳሎቶ፥ ጎዳይ ሀይሳ ኦዳ ግሾ፥","poem":1},{"text":"ኡፋይሳን የፅተ፤ ነኖ ቢታዉ፥ እልላ።","poem":2},{"text":"ህንተኖ ደ