{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_etw","name":"እሳያሳ ማፃፋ","commonName":"እሳያሳ ማፃፋ","title":"እሳያሳ ማፃፋ","order":23,"numberOfChapters":66,"sha256":"4ab89101f9b620becbbf3e12322e1f109302962dc48ac0ae8b6da090f19837b1","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":46,"content":[{"type":"heading","content":["ባብሎነ ፆሳታ"]},{"type":"verse","number":1,"content":[{"text":"ቤላ ጌተትያ ባብሎነ ኤቃይ ሆክስ፤","poem":1},{"text":"ነቦ ጌተትያ ኤቃይ ጉፋንስ።","poem":2},{"text":"ኤንታ ምስለት ጫና መሄ ቦላ ጫነትዶሶና፤","poem":1},{"text":"ዳቡርዳ መሄታስ ዴፆ ቶሆ ግድዶሶና።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዴፁዋፐ ደንድዳይሳን ጫና መሄት፥","poem":1},{"text":"ጫናራ እስፈ ኩንድዶሶና።","poem":2},{"text":"ኤቃት ባንታና አሻናዉ ዳንዳኦና ግሾ","poem":1},{"text":"ባንታዉ ድኤትድ ብዶሶና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ህንተኖ፥ እስራኤለፐ አትዳይሳቶ፥ ያይቆባ ኮቻቶ፥","poem":1},{"text":"ህንተ ቃንትዳ ዎደፐ ዶማዳ ናግዳይ፥","poem":2},{"lineBreak":true},{"text":"ህንተ የለትዳ ዎደፐ ዶማዳ ቶክዳይ፥","poem":2},{"lineBreak":true},{"text":"ታኒ ኦደይሳ ስእተ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ህንተ ጭማና ጋካናዉ፥","poem":1},{"text":"ፑሉማና ጋካናዉ ታኒ ታና፤","poem":2},{"lineBreak":true},{"text":"ታ ህንተና ማዳና።","poem":2},{"text":"ታኒ ህንተና መስ፤ ታ ህንተና ናጋና፤","poem":1},{"text":"ታ ህንተና ቶካናነ አሻና።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ታና ኦደራ ጋደዬቲ?","poem":1},{"text":"ዎይኮ ኦደራ ልክሴቲ?","poem":2},{"text":"ኤንቲ ዎል ዳኔስ ጋናዉ","poem":1},{"text":"ታና ኦደራ ግናየቲ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አሳይ ዎርቃነ ብራ ባንታ ቃርፂታፐ ቆልድ፥","poem":1},{"text":"ፆሰ ኦድ መና መላ ዎርቃ ሼሸይሳስ እሞሶና።","poem":2},{"text":"እ ኦድ ስምን","poem":1},{"text":"ኤንቲ ኤቃ ስንን ጉፋንድ ጎይኖሶና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኤንቲ እያ ደንድ፥ ባንታ ሀሽያን ቶክድ፥","poem":1},{"text":"እያ በሳን እያ ዎን፥ እ ሄ በሳን ኤቅ አጌስ።","poem":2},{"text":"ባ ደእያ በሳፈ ቃፀና፤","poem":1},{"text":"አስ እያኮ ዋስኮ እያዉ ዛሮ እመና፤","poem":2},{"lineBreak":true},{"text":"እያ መቱዋፐ እያ አሸና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ህንተኖ ናጋራንቾቶ፥","poem":1},{"text":"ሀይሳ ሀሳይተ፤ ቆፕተ፤","poem":2},{"lineBreak":true},{"text":"ህንተ ዎዛናን ዎተ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"በን ዎደ ሀንዳባታ ሀሳይተ፤","poem":1},{"text":"ታፐ አትሽን፥ ሀራ ፆሲ ባዋ፤ ታኒ ፆሰ፤","poem":2},{"lineBreak":true},{"text":"ታ መል ኦንካ ባዋ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታ ቆፋይ ምናና፤","poem":1},{"text":"ታኒ ታ ሀልቹዋ ኡባ ፖላና።","poem":2},{"text":"ዉርሰን ሀናናባ ዶመን፥","poem":1},{"text":"ስንፈ ሀናናባ ኮይሮታዳ ኤርሳይስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዶሎሀ ባጋፈ ቦንቅያ ካፎ፥","poem":1},{"text":"ሃሆ ቢታፈ ታ ቆፋ ፖልያ አስ ፄጋና።","poem":2},{"lineBreak":true},{"text":"ታኒ ቆፕዳባ ፖላና፤","poem":2},{"lineBreak":true},{"text":"ታኒ ሀልችዳባ ኦና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ህንተኖ ዎዛን ሙምዳይሳቶ፥","poem":1},{"text":"ፅሎተፈ ሃክዳይሳቶ ታና ስእተ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታኒ ታ ፅሎተ ማታያና፤","poem":1},{"text":"እካ ሃሆና ግደና።","poem":2},{"text":"ታ አቶተይ ጋምኤና፤ ታ አቶተ ፅዮነስ፥","poem":1},{"text":"ታ ቦንቹዋ እስራኤለስ እማና” ያጌስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/45.json","previousChapterAudioLinks":{},"numberOfVerses":13}