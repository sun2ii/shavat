{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_etw","name":"እሳያሳ ማፃፋ","commonName":"እሳያሳ ማፃፋ","title":"እሳያሳ ማፃፋ","order":23,"numberOfChapters":66,"sha256":"4ab89101f9b620becbbf3e12322e1f109302962dc48ac0ae8b6da090f19837b1","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":47,"content":[{"type":"heading","content":["ባብሎነ ኩንደ"]},{"type":"verse","number":1,"content":[{"text":"“ባብሎነ ጌላኤ፥","poem":1},{"text":"ዱገ ዎዳ ባና ቦላ ኡታ።","poem":2},{"text":"ባብሎነ ናተ፥","poem":1},{"text":"ነ አራታ አጋዳ ሳአን ኡታ።","poem":2},{"text":"ህዛፐ ጉየ ኔኒ ሳጶትያሮነ","poem":1},{"text":"ባሎትያሮ ጌተታካ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዎፃ ተቃዳ ካ ጋጫ፤","poem":1},{"text":"ነ ጉሉን ቃራ፤","poem":2},{"lineBreak":true},{"text":"ነ አዱሳ ማኡዋ ከሳ፤","poem":2},{"lineBreak":true},{"text":"ነ ዎድርያ ቃራዳ ሻፋ ፕና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ነ ካሎይ ቃረታና፤","poem":1},{"text":"ነ ፖኮይ በንታና።","poem":2},{"text":"ታኒ ሀሎ ከያና፤","poem":1},{"text":"ኦደስካ ቃትከ” ያጌስ ጎዳይ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ኑና ዎዝያ እስራኤለ ጌሻ ሱንይ","poem":1},{"text":"ኡባፈ ዎልቃማ ጎዳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ባብሎነ ናተ፥","poem":1},{"text":"ባዳ ማን ስእ ጋዳ ኡታ፤","poem":2},{"lineBreak":true},{"text":"ህዛፐ ጉየ ኔኒ ካዎተታ ካውዉ ጌተታካ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታኒ ታ አሳ ሀንቀታስ፤ ታ ላታ ቱንሳስ፤","poem":1},{"text":"ታኒ ኤንታ ነ ኩሸን አዳ እማስ።","poem":2},{"text":"ኔኒ ኤንታዉ ቃታባካ፤","poem":1},{"text":"ጭምዳይሳታ ቦላ ነ ዴፆ ቃምባራ ዎዳሳ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኔኒ፥ ‘ታኒ መርናዉ ካዎ ግዳና’ ያጋዳሳ፤","poem":1},{"text":"ሽን ነ ኦዳ ኦሱዋነ","poem":2},{"lineBreak":true},{"text":"እያ ዉርሰይ ዋናነኮ ቆፓባካ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ነኖ ዎፑ ጋዳ ኡትዳረነ ናገታዳ ደእዳረ ስአ። ነ ዎዛናን፥ ‘ታፐ አትሽን፥ ሀር ባዋ፤ ታኒ አምኦ ግድከ፤ ዎይኮ የላዳ ናእ ባይና አስ ግድከ’ ያጋዳሳ።","poem":1}]},{"type":"verse","number":9,"content":[{"text":"ሀ ናምኡባት ቆፖና እስ ጋላስ ነ ቦላ ያና። ነ ብታይ አይ ዳርኮካ፥ ነ ሙሩኖይ አይ ዎልቃምኮካ ኔኒ ነ ናይታፐ መላ አተይስነ አምኤተይ አተና።","poem":1}]},{"type":"verse","number":10,"content":["“ኔኒ ነ ኢታተን አማነታዳ፥ ‘ኦንካ ታና በኤና’ ያጋዳሳ። ነ ኤራተይነ ጭንጫተይ ነና ባለን፥ ኔኒ ነ ዎዛናን፥ ‘ታፐ አትሽን፥ ሀር ባዋ’ ያጋዳሳ።"]},{"type":"verse","number":11,"content":["ሽን ኔኒ ዋታዳ ነ ብታን ሃሳኔኮ ኤሮና ኢታይ ነ ቦላ ያና። ኔኒ ጋተ ቃንፃናዉ ዳንዳኦና ዮይ ነ ቦላ ዎና፤ ቃስ ኔኒ አይኮካ ቆፖና ጋዶይ ነ ቦላ ያና።"]},{"type":"verse","number":12,"content":["“አነ ኔኒ ነ ናአተፈ ዶማዳ ኦሸ ደእዳ ነ ብታነ ነ ሙሩኑዋ ሀእካ ኦ። ኦን ኤር ነ ቆፕዳይሳ መላ ሀናኔኮ ዎይኮ ኔኒ እያራ ዳጋንኔኮ።"]},{"type":"verse","number":13,"content":["ኔኒ ኤክዳ ዞረይ ኡባይ ዳቡርሳፈ አትሽን፥ ነና አይኮካ ማድቤና። ሳሎ ፆልንቶ ታይበይሳትነ እያ ፄልድ አጌናን አጌናን ሀናናባ ኦደይሳት አነ ነና አሾ።"]},{"type":"verse","number":14,"content":["ኤንቲ ቡረ መላ፤ ታም ኤንታ ማና። ኤንቲ ታማ ላጩዋፐ ባንታና አሻናዉ ዳንዳኦኮና። አስ ካያ ቦንቆይ ዎይኮ አስ እያ ስንን ኡትድ ሆእያ ታማ ግደና።"]},{"type":"verse","number":15,"content":["ኔኒ ኤንታራ ዳቡርዳይሳት፥ ናአተፈ ዶምድ ኔራ ዛልእዳይሳት ነዉ ሄሳ መላ። ኤንቲ እሶይ እሶይ ባ ባላን ባላን ኦይከታና፤ ነና አሽያ ኦንካ ባዋ።”"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}