{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_etw","name":"እሳያሳ ማፃፋ","commonName":"እሳያሳ ማፃፋ","title":"እሳያሳ ማፃፋ","order":23,"numberOfChapters":66,"sha256":"4ab89101f9b620becbbf3e12322e1f109302962dc48ac0ae8b6da090f19837b1","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":48,"content":[{"type":"heading","content":["ስሞና እፅዳ እስራኤለ"]},{"type":"verse","number":1,"content":[{"text":"“ህንተኖ፥ ያይቆባ ሶ አሳዉ፥","poem":1},{"text":"እስራኤለ ሱንን ፄገትዳይሳቶ፥","poem":2},{"lineBreak":true},{"text":"ይሁዳ ኮቻፈ ይዳይሳቶ፥ ሀይሳ ስእተ።","poem":2},{"text":"ህንተ ጎዳ ሱንን ጫቀታ፤","poem":1},{"text":"እስራኤለ ፆሳ ፄገታ፤","poem":2},{"lineBreak":true},{"text":"ሽን ቱማተንነ ፅሎተን ግደና።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ህንተ፥ ‘ኑኒ ጌሻ ካታማን ደኦስ፤","poem":1},{"text":"እስራኤለ ፆሳን ዘምፖስ፤","poem":2},{"lineBreak":true},{"text":"እያ ሱንይ ኡባፈ ዎልቃማ ጎዳ’ ”","poem":2},"ያግድ ጬቀተታ።"]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ታኒ ስንፈ ሀናናባታ ዳሮ ዎደፐ ካሰ ኦዳስ።","poem":1},{"text":"ታ ዶናፐ ኤንቲ ከይን፥","poem":2},{"lineBreak":true},{"text":"ኤንቲ ኤሶን ፖለታና መላ ኦስ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኔኒ ኦድን ስኦናይሳ፥","poem":1},{"text":"ነ ሞርገይ ብራታ መላ ግደይሳ","poem":2},{"lineBreak":true},{"text":"ነ ሶምኦይ ናሰ ብራታዳ","poem":2},{"lineBreak":true},{"text":"ሌቃሞናይሳ ታኒ ኤራይስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሄሳ ግሾ፥ ኔኒ፥ “ሀይሳ ታ ኤቃይ ኦስ፤","poem":1},{"text":"ታ ማሰትዳ ምስለት፥ ታ ሼሻዳ ኦዳ ምስለት ኦዶሶና” ጎናዳ፥","poem":2},{"text":"ታኒ ሄሳ ነዉ በንፐ ዶማዳ ኦዳስ።","poem":1},{"text":"ኤንቲ ሀናናፐ ስን ታኒ ኤንታ ነዉ ኤርሳስ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“ታ ካሰ ኦድዳይሳ ነ ስአዳሳ፤","poem":1},{"text":"እ ፖለትዳይሳ በአዳሳ፥","poem":2},{"lineBreak":true},{"text":"ያትን እያ ቱማተ ኤክኪ?","poem":2},{"lineBreak":true},{"text":"ህዛፐ ነ ኤሮና ኦራባታ ታ ነዉ ኦዳና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኤንቲ በን መትዳባ ግዶናሽን","poem":1},{"text":"ሀእ መትዶሶና።","poem":2},{"text":"ኔኒ፥ ‘ታኒ ኤንታ ኤራይስ’ ጎናዳ","poem":1},{"text":"ሀይሳፈ ካሰ ኔኒ ኤንታባ ስአባካ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኔኒ ስአባካ፤ ኤራባካ፤","poem":1},{"text":"ነ ሀይይ በንፐካ ዶየትቤና።","poem":2},{"text":"ኔኒ አይ ጭምያ አሴኮ ታኒ ኤራይስ፤","poem":1},{"text":"ኔኒ የለቶሳፐ ጌላ ጌተታዳ ፄገተይሳ ኤራይስ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ታ ሱን ግሾ፥ ታኒ ታ ሀንቁዋ ዛራና፤","poem":1},{"text":"ታ ቦንቹዋ ግሾ ነና ይሶና መላ","poem":2},{"lineBreak":true},{"text":"ታ ሀንቁዋ ተቃና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታኒ ነና ፓጫስ፤","poem":1},{"text":"ብራዳ ግዶናሽን","poem":2},{"lineBreak":true},{"text":"ታኒ ነና መቶ ታማን ፓጫስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታኒ ታ ግሾ፥ ሀይሳ ኦና፤","poem":1},{"text":"ታ ሱንይ ቶሸታና መላ ኮይከ፤","poem":2},{"lineBreak":true},{"text":"ታኒ ታ ቦንቹዋ ሀራስ እምከ።”","poem":2}]},{"type":"heading","content":["ባብሎነፐ ከስ"]},{"type":"verse","number":12,"content":[{"text":"“ነኖ ያይቆባ፥ ታኒ ፄግዳ እስራኤለ፥","poem":1},{"text":"ታኒ ኦድያባ ስአ፤","poem":2},{"lineBreak":true},{"text":"ታኒ እያ፤ ኮይሮይካ ታና፤ ዉርሰይካ ታና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታ ኩሸይ ቢታ ባሱዋ መስ፤","poem":1},{"text":"ታ ኡሻቻ ኩሸይ ሳሎታ ምጭስ።","poem":2},{"text":"ታኒ ኤንታ ፄግያ ዎደ","poem":1},{"text":"ኤንቲ እስፈ ኤቆሶና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ህንተ ኡባይ እስፈ ሺቅድ ስእተ፤","poem":1},{"text":"ኤቃታፐ ሀይስ ሀናናይሳ ስንትድ ኦድዳይ ኦኔ?","poem":2},{"text":"ጎዳይ ዶርዳይስ እያ ቆፋ ባብሎነ ቦላ ፖላና፤","poem":1},{"text":"እያ ቀሰይካ ባብሎነ ቢታ ቦላ ግዳና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ታኒ፥ ታ ሁጰን እያዉ ኦዳስ፤ እያ ፄጋስ፤","poem":1},{"text":"ታ እያ ኤሀና፤ እ ኦያባ ኡባይ እያዉ ፖለታና።","poem":2}]},{"type":"verse","number":16,"content":["“ታኮ ሃ ሺቅድ ሀይሳ ስእተ፤",{"text":"“ታኒ ኮይሮፐ ዶማዳ ጌማን ኦዳብከ፤","poem":1},{"text":"ሄስ ሀንዳ ዎደፐ ዶማዳ ታኒ ያን ደአይስ” ያጌስ።","poem":2},{"text":"ሀእካ ኡባ ሃርያ ጎዳይነ","poem":1},{"text":"እያ አያናይ ታና ኪትዶሶና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ነና ዎዝያ ጎዳይ፥","poem":1},{"text":"እስራኤለ ጌሻይ ሀይሳዳ ያጌስ፦","poem":2},{"text":"“ነና ማድያባ ታማርሰይ","poem":1},{"text":"ነ ባናዉ በሲያ ኦግያ ነ ካለይ፥","poem":2},{"lineBreak":true},{"text":"ታና ነ ጎዳ፥ ነ ፆሳ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ኔኒ ታ ኪታ ስእዳባ ግድያኮ፥","poem":1},{"text":"ነ ሳሮተይ ሻፋ ሃዳ ጎጋናሽን፤","poem":2},{"lineBreak":true},{"text":"ነ ፅሎተይ አባ ቤታዳ ሀናናሽን።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ነ ኮቻይ አባ ሻፈዳ፥","poem":1},{"text":"ነ ናይት ታይበቶና ባና መላ ዳራናሽን፤","poem":2},{"lineBreak":true},{"text":"ኤንታ ሱንይ ታ ስንፈ የና፤ ክቸናሽን” ያጌስ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ባብሎነ ቢታፈ ከይተ፤","poem":1},{"text":"ባብሎነፐ ባቃትተ!","poem":2},{"text":"ቃላ ቁ ኦድ፥","poem":1},{"text":"ኡፋይሳን ሀይሳዳ ያግድ ዋስተ።","poem":2},{"text":"ሳኣ ጋፃፐ ጋፃ ጋካናዉ ሀይሳ ኪትተ፤","poem":1},{"text":"“ጎዳይ ባ አይልያ ያይቆባ ዎዝስ” ያግድ ኦድተ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"እ ኤንታ መላ ቢታራ ካለዳ ዎደ","poem":1},{"text":"ሳሞትቦኮና።","poem":2},{"text":"ዛላፈ ሃ ኤንታዉ ፑልትስ፤","poem":1},{"text":"እ ዛላ ጳልቅን ሃ ቅስ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“ኢታታስ ሳሮይ ባዋ” ያጌስ ጎዳይ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/47.json","previousChapterAudioLinks":{},"numberOfVerses":22}