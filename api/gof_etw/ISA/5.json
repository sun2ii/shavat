{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_etw","name":"እሳያሳ ማፃፋ","commonName":"እሳያሳ ማፃፋ","title":"እሳያሳ ማፃፋ","order":23,"numberOfChapters":66,"sha256":"4ab89101f9b620becbbf3e12322e1f109302962dc48ac0ae8b6da090f19837b1","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":5,"content":[{"type":"heading","content":["ዎይነ ጋደ ሌምሶ"]},{"type":"verse","number":1,"content":[{"text":"ታ ዶስያ አድያ ዎይነ ጋድያባ፥","poem":1},{"text":"ሲቆ የ የፃና።","poem":2},{"text":"ታኒ ዶስያ አድያስ፥","poem":1},{"text":"አራዳ ዙማ ቦላ እያዉ ዎይነ ጋደይ ደኤስ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ቢታ ቦክድ፥ ሹቻ ቆር ከስድ፥","poem":1},{"text":"ሎኦ ዎይነ ቶክስ።","poem":2},{"text":"ናጎ ሻኮ እያ ግዶን ሻክስ፤","poem":1},{"text":"ዎይንያ ጉምእያ በሳ ጊግስስ።","poem":2},{"text":"ሄሳፈ ጉየ፥ ሎኦ አይፈ አይፋና ግድ ናግስ፤","poem":1},{"text":"ሽን ጫላ አይፈ አይፍስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“ህንተኖ፥ የሩሳላመን ደኤይሳቶ፥","poem":1},{"text":"ህንተኖ ይሁዳ አሳዉ፥","poem":2},{"lineBreak":true},{"text":"ታፐነ ታ ዎይነ ጋድያ ግዶን","poem":2},{"lineBreak":true},{"text":"ደእያ ኦዳ አነ ፕርድተ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታኒ ታ ዎይነ ጋድያስ ኦዳይሳፈ","poem":1},{"text":"ሀራ አይ ኦናባይ አትዴ?","poem":2},{"text":"ሎኦ አይፈ አይፋና ጋዳ ናጋስ፥","poem":1},{"text":"ሽን አይስ ጫላ አይፈ አይፍዴ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሀእ ታኒ ታ ዎይነ ጋድያ ቦላ","poem":1},{"text":"ኦናባ ህንተዉ ኦዳና።","poem":2},{"text":"ታኒ እያ ድርሳ ድጋና፤","poem":1},{"text":"ዎይነይ ያናዳ ኦና።","poem":2},{"text":"ታኒ ግምብያ ላላና፤","poem":1},{"text":"ዎይነ ጋደይ የታና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታኒ ሄ ጋድያ ቁኤ ኦና፤","poem":1},{"text":"ዎይነይ ፅንተተና፥ ሀርመተና።","poem":2},{"text":"ሄ በሳን ክንቾተይነ አጉን ዶላና፤","poem":1},{"text":"እር እያ ቦላ ቡኮና መላ","poem":2},{"lineBreak":true},{"text":"ታኒ ሻራ ኪታና” ያግስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ኡባፈ ዎልቃማ ጎዳ","poem":1},{"text":"ዎይነ ጋደይ እስራኤለ አሳ።","poem":2},{"lineBreak":true},{"text":"እ፥ ኡፋይትያ አታክልተ በሳይ ይሁዳ አሳ።","poem":2},{"text":"ኤንታ ሱረ ፕርዶሶና ግድ ናግስ፤","poem":1},{"text":"ሽን ሱ ጉስዶሶና።","poem":2},{"text":"ፅሎተ ኦሶና ግድ ናግስ፤","poem":1},{"text":"ሽን ኡንአ ዋሶይ ዳራና መላ ኦዶሶና።","poem":2}]},{"type":"heading","content":["ኢታታ አየ!"]},{"type":"verse","number":8,"content":[{"text":"በሲ ይን፥ ህንተ ፃላላ ቢታ ቦላ ዳና ጋካናዉ፥","poem":1},{"text":"ኬ ኬ ቦላ፥ ጋደ ጋደ ቦላ፥","poem":2},{"lineBreak":true},{"text":"ጉጀይሳቶ ህንተና አየ!","poem":2}]},{"type":"verse","number":9,"content":["ኡባፈ ዎልቃማ ጎዳይ ሀይሳዳ ግድ ጫቅሽን ታ ስአስ።",{"text":"“ሄ ግታ ኬት ካይሳታና፤","poem":1},{"text":"ሄ ሎኦ ኬታን ዳናዉ አስ ያና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታሙ ዋፃን ቶክዳ ዎይንያፐ፥","poem":1},{"text":"እስ ኦቶ ጉምኤ ዎይነ ፃላላ ኤካና።","poem":2},{"text":"ሆስፑን ታሙ ክሎ ግራመ ዘርዳ ጋደፐ፥","poem":1},{"text":"ታማነ ሆስፑን ክሎ ግራመ ፃላላ ኤካና” ያግስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ማያ ኡሻ ኮያናዉ","poem":1},{"text":"ዎንታ ጉራ ደንደይሳታነ","poem":2},{"lineBreak":true},{"text":"ዎይነ ኡሻይ ፁጋና ጋካናዉ፥","poem":2},{"lineBreak":true},{"text":"ያን ቃምስያ አሳ አየ!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኤንታ እማቱዋን ማስንቆይ፥","poem":1},{"text":"ዲ፥ ካራቦይ፥ ሱሱልኤይነ","poem":2},{"lineBreak":true},{"text":"ዎይነ ኡሽ ደኤስ።","poem":2},{"text":"ሽን ኤንቲ ጎዳ ኦሱዋ በእቦኮና፤","poem":1},{"text":"እያ ኩሸ ኦሱዋ አኬኮኮና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ህዛ ታ አሳይ አኬካ ይዳ ግሾ፥ ድኤታና፤","poem":1},{"text":"አይሰይሳት ኮሻን ሀይቃና፤ አሳይ ሳሞን ፁገታና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዱፎይ ባ ጎምፓ ዳልግስስ፤","poem":1},{"text":"ባ ዶና ዛው ባይና ዶይስ።","poem":2},{"text":"የሩሳላመን ደእያ ግታ አሳ፥ ዳሮ አሳ፥","poem":1},{"text":"ዎጫመይሳታነ ኡፋይተይሳታ ምታና።","poem":2}]},{"type":"verse","number":15,"content":["አስ ቶሸታና፤ አሳ ኮቸ ኡባይ ካዉያና፤ ኦቶርትያ ኡባይ ጉፃና።"]},{"type":"verse","number":16,"content":["ሽን ኡባፈ ዎልቃማ ጎዳይ፥ ባ ሱረ ፕርዳን ቁ ቁ ጋና፤ ፆሳ ጌሻተይ እያ ፅሎተን ቆንጫና።"]},{"type":"verse","number":17,"content":["ሄ ዎደ ዶርሳት ሄ በሳን ሄመታና፤ ዶርሳ ኡርገት ላለትዳ ኬ በሳታን ማና።"]},{"type":"verse","number":18,"content":["ጭሞ ዎዶሮን ናጋራ፥ ጋረ ዎዶሮን ኢታተ ጎቸይሳታ አየ!"]},{"type":"verse","number":19,"content":["“አነ ፆሳይ ኤለሶ! ኑኒ በአና መላ ባ ኦሱዋ ኤሶዮ! ኑኒ ኤራና መላ እስራኤለ ጌሻይ ቆፕዳ ቆፋ ፖሎ” ያገይሳታ አየ!"]},{"type":"verse","number":20,"content":["ኢታ ሎኦ፥ ሎኡዋ ኢታ፤ ማ ፖኦ፥ ፖኡዋ ማ፤ ጫሙዋ ማልኦ፥ ማልኡዋ ጫሞ ገይሳታ አየ!"]},{"type":"verse","number":21,"content":["ባንታና ጭንጫነ ቃራ ገይሳታ አየ!"]},{"type":"verse","number":22,"content":["ዎይነ ኡሻን ኤረትዳ አሳነ ማይያ ኡሹ ዋላካናዉ ዎዛን ምኖ ግድዳ አሳ አየ!"]},{"type":"verse","number":23,"content":["ቆህዳ ኡራ ፅልሳናዉ ዎፈ ኤክድ፥ ፅሎ አሳ ሱረ ፕርዳ ጌላየይሳታ አየ!"]},{"type":"verse","number":24,"content":["ኤንቲ ኡባፈ ዎልቃማ ጎዳ ህግያ እፅዳ ግሾነ እስራኤለ ጌሻ ቃላ ካዳ ግሾ ታማ ላጮይ ካለ ኦይከይሳዳነ ቡረይ ታማን ሜተትድ የይሳዳ ኤንታ ፃጶይ ዎቃና። ኤንታ ጪሻይ ባናዳ ላለትድ ያና።"]},{"type":"verse","number":25,"content":["ሄሳ ግሾ፥ ጎዳ ሀንቆይ እያ አሳ ቦላ ኤፅስ፤ እያ ኩሸይ ደንድድ፥ ኤንታ ይስስ። ደረት ቃፅዶሶና፤ ሀይቅዳ አሳ አሀይ ኦገ ቦላ ቡረዳ ሀንስ። ሄ ኡባንካ እያ ሀንቆይ ስምቤና፤ እያ ኩሸይ ሀእካ ደንድዳ በሳን ደኤስ።"]},{"type":"verse","number":26,"content":["ጎዳይ ሃሆ ሶን ደእያ ካዎተታስ ማላ ቃን ኤስስ፤ ሳኣ ጋፃን ደእያ አሳ ሱይቅድ ፄግስ፤ ኤንቲ ድርግሸ ፑቱ ጎሶና።"]},{"type":"verse","number":27,"content":["ኤንታ ግዶን ዳቡረይነ በተይ ባዋ፤ ኤንታፈ እሶይካ ስከና ዎይኮ ዝንኤና። ፄሳን ዳንጭዳ ሳቀይ ብርሸተና፤ ኤንታ ጫማ ዎዶሮይ ዱፀና።"]},{"type":"verse","number":28,"content":["ኤንታ ቶራይ ቃራ፤ ኤንታ ዶንገይካ ዋፀትድ ደኤስ። ኤንታ ፓራታ ቶሆይ ቃራ ሹቻ መላ፤ ኤንታ ፓራ ጋረታ ገርቶይ ጎተ መላ።"]},{"type":"verse","number":29,"content":["ኤንቲ ጋሞ መላ ጉሞሶና፤ ዎዳላ ጋሞ መላ ጉዶሶና። ኤንቲ ሳርቡቅሸ ምያባ ኦይክድ፥ ቶክ ኤክድ ቦሶና፤ ኤንታፈ ዎድ ኤከይ ኦንካ ባዋ።"]},{"type":"verse","number":30,"content":["ሄ ዎደ ኤንቲ ግታ አባ ጉንዳ እስራኤለ ቦላ ጉማና። እስ አስ ሄ ቢታ ፄልያ ዎደ ምነ ዋየይ በአና፤ ፖኦይ ሻራን ምተታና።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/4.json","previousChapterAudioLinks":{},"numberOfVerses":30}