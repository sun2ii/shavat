{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_etw","name":"እሳያሳ ማፃፋ","commonName":"እሳያሳ ማፃፋ","title":"እሳያሳ ማፃፋ","order":23,"numberOfChapters":66,"sha256":"4ab89101f9b620becbbf3e12322e1f109302962dc48ac0ae8b6da090f19837b1","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":50,"content":[{"type":"heading","content":["እስራኤለ ናጋራነ አይልያ ኪተተ"]},{"type":"verse","number":1,"content":["ጎዳይ ያጌስ፤",{"text":"“ታኒ ህንተ አይዉ የድዳ ፕርማ ዎርቃተይ አዉን ደኢ?","poem":2},{"lineBreak":true},{"text":"ታኒ ኦደስ ህንተና ባይዛድና?","poem":2},{"text":"ሄኮ፥ ህንተ ናጋራ ግሾ ህንተ ባይዘትደታ፤","poem":1},{"text":"ህንተ ናቁዋ ግሾ ህንተ አይያ የደታሱ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታኒ ይዳ ዎደ፥ ሀይሳን አስ አይስ ይዴ?","poem":1},{"text":"ታኒ ፄግዳ ዎደ፥ ‘ዬ!’ ጋናዉ አይስ አስ ይዴ?","poem":2},{"text":"ታኒ ህንተና ዎዛናዉ ታ ኩሸይ ቃንዬ?","poem":1},{"text":"ህንተና አሻናዉ ታዉ ዎልቅ ባወዬ?","poem":2},{"text":"ታኒ አባ ሴራዳ መልሳይስ፤","poem":1},{"text":"ሻፋታ መላ ቢታ ኦይስ።","poem":2},{"text":"ሃ ይን ኤንታን ደእያ ሞሎት ዎቆሶና፤","poem":1},{"text":"ሳሞይ ዎን ሀይቆሶና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታኒ ሳሎታ ማ ማይዛይስ፤","poem":1},{"text":"ኤንታ ካማይ ካዮ ማኦ ዳኔስ” ያግስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ዳቡርዳይሳ ታኒ ቃላን ምን ኤራና መላ፥","poem":1},{"text":"ኡባ ሃርያ ጎዳይ ታዉ ታማርዳ እንፃርስ እሚስ።","poem":2},{"text":"እ ታና ዎንታ ዎንታ ባርክስድ፥","poem":1},{"text":"ታኒ ታማረዳ ስአናዳ ታ ሀይ ዶዬስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኡባ ሃርያ ጎዳይ ታ ሀይ ዶይስ፤","poem":1},{"text":"ታኒ ጌላ ግዳብከ፤ ጉየ ስማብከ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታኒ ታ ዞኩዋ ሾጨይሳታስ፥","poem":1},{"text":"ታ ቡቻ ሾደይሳታስ","poem":2},{"lineBreak":true},{"text":"ታ ጋጩዋ አዳ እማስ።","poem":2},{"text":"ታ ቦላ ጩተይሳታፐነ ታና ካዉሸይሳታፐ","poem":1},{"text":"ታ ሶምኡዋ ገንብከ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኡባ ሃርያ ጎዳይ ታና ማድያ ግሾ፥","poem":1},{"text":"ታኒ ዬላትከ።","poem":2},{"text":"ታኒ ታ ሶምኡዋ ሳሎ ሹቹ ኦስ፤","poem":1},{"text":"ታኒ ዬላቶናይሳ ኤራይስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታዉ ፕርደይስ ማታን ደኤስ፤","poem":1},{"text":"ያትን፥ ታና ሞተይ ኦኔ?","poem":2},{"lineBreak":true},{"text":"አነ ታራ ሞተታናዉ ኤቆ!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኡባ ሃርያ ጎዳይ ታና ማዴስ፤","poem":1},{"text":"ያትን፥ ታ ቦላ ፕርደይ ኦኔ?","poem":2},{"text":"ኤንቲ ኡባይ ማኦዳ ጭማና፤","poem":1},{"text":"ኤንታ ብል ማና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ህንተ ግዶፈ ጎዳ ያየይ፥","poem":1},{"text":"እያ አይልያ ቃላስ ኪተተይ ኦኔ?","poem":2},{"text":"ማን ሄመተይነ ፖኦይ ባይናይ እ ኦኔ?","poem":1},{"text":"ሄ ኡራይ ጎዳ ሱንን አማነቶ፤ ባ ፆሳን ዘምፖ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ህንተኖ ታማ ኤያ ኡባቶ፥","poem":1},{"text":"ላጮ ፆምፐ ህንተዉ ሺሸይሳቶ፥","poem":2},{"lineBreak":true},{"text":"ህንተ ኤዳ ታማ ፖኡዋን ሄመትተ።","poem":2},{"text":"ላጮ ፆምፕያን ስመረትተ፤","poem":1},{"text":"ህንተ ታ ኩሸፐ ኤካናዉ ደኤይ ሀይሳ፤","poem":2},{"lineBreak":true},{"text":"ህንተ ዎልቃማ መቶ ሴላን ዝንአና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/49.json","previousChapterAudioLinks":{},"numberOfVerses":11}