{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_etw","name":"እሳያሳ ማፃፋ","commonName":"እሳያሳ ማፃፋ","title":"እሳያሳ ማፃፋ","order":23,"numberOfChapters":66,"sha256":"4ab89101f9b620becbbf3e12322e1f109302962dc48ac0ae8b6da090f19837b1","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":51,"content":[{"type":"heading","content":["መርና አቶተ ፅዮነስ"]},{"type":"verse","number":1,"content":[{"text":"ህንተኖ ፅሎተ ካለይሳቶ፥","poem":1},{"text":"ህንተኖ ጎዳ ኮየይሳቶ ስእተ።","poem":2},{"text":"ህንተ ጳልቀትድ ኤከትዳ ሹቻ","poem":1},{"text":"ህንተ ቦከትድ ከይዳ ኦላ ፄልተ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ህንተ አዋ አብራሃመነ","poem":1},{"text":"ህንተና የልዳ ሳሮ ፄልተ።","poem":2},{"text":"እ ባርካ ደእሽን፥ ታኒ እያ ፄጋዳ","poem":1},{"text":"አንጃስነ ታይቦን ዳርሳስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“ጎዳይ ፅዮነነ","poem":1},{"text":"ላለትዳ በሳን ደእያ አሳ ኡባ ምንና።","poem":2},{"text":"እ መላ ቢታ ኤደነ፥","poem":1},{"text":"ካሎትዳ ቢታ ጎዳ አታክልተ ጋደዳ ኦና።","poem":2},{"text":"ያን ኡፋይስነ ሀሹ ጉስ ዳና፤","poem":1},{"text":"ጋላትነ ማዝሙረይ ስኤታና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“ታ አሳዉ፤ ታ ኦድያባ ስእተ፤","poem":1},{"text":"ታ ደርያዉ፥ ህንተ ሀይ ታኮ ዛርተ።","poem":2},{"text":"ህገይ ታፐ ከዬስ፤","poem":1},{"text":"ታ ሱረ ፕርዳይ ካዎተታስ ፖኦ ግዳና።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ታ ፅሎተይ ኤለስድ ሺቃና፤ ታ አቶተይ ማትስ፤","poem":1},{"text":"ታ ቀሰይ ካዎተታስ ሱረ ፕርዳ ኤሀና።","poem":2},{"text":"ዩሾይ አባን ተቀትዳ ቢታት ኡባይ","poem":1},{"text":"ታናን አማነትድ ናጋና፤","poem":2},{"lineBreak":true},{"text":"ታኒ ኤንታ ታ ዎልቃን አሻናይሳ ኡፋይሳን ናጋና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ፑደ ቁ ግድ ሳሎታ ፄልተ፤","poem":1},{"text":"ዱገ ሳኣካ ፄልተ።","poem":2},{"text":"ሳሎት ጩያዳ ላለትድ ያና፤","poem":1},{"text":"ሳእ አፍላዳ ዉራና፤","poem":2},{"lineBreak":true},{"text":"እያን ደእያ አሳ ኡባይ ኡዱንፀዳ ሀይቃና።","poem":2},{"text":"ሽን ታ አቶተይ መርናዉ ዳና፤","poem":1},{"text":"ታ ፅሎተይ ዉረና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“ህንተኖ ፅሎተ ኤረይሳቶ፥","poem":1},{"text":"ታ ህገይ ህንተ ዎዛናን ደኤይሳቶ፥ ስእተ።","poem":2},{"text":"አሳ ቦረ ያዮፍተ፤","poem":1},{"text":"ኤንታ ጫሻስ ዳጋሞፕተ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ብል ማኦ፥ ዶርሳ እክሰ ጉፁነይ መይሳዳ፥","poem":1},{"text":"ኤንቲ ሜተታና።","poem":2},{"text":"ሽን ታ ፅሎተይ መርናዉ ዳና፤","poem":1},{"text":"ታ አቶተይ የለተ ኡባስ ግዳና” ያጌስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"አቤት ጎዳዉ፥ ደንዳ! ደንዳ!","poem":1},{"text":"ጎዳ ቀስያዉ፥ ዎልቃ ማአ።","poem":2},{"text":"በን ዎደታንነ የለተን ሀንዳይሳዳ ደንዳ፤","poem":1},{"text":"ራኣባ ጌተትያ ዳውያ ቃንፀረዳይነ","poem":2},{"lineBreak":true},{"text":"ጫድዳይ ነና ግድክዬ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አባነ ግታ ጪሞ ሃ","poem":1},{"text":"መልስዳይ ነና ግድክዬ?","poem":2},{"text":"ነ ዎዝዳይሳት ፕናና መላ","poem":1},{"text":"ጪሞ አባ ኦገ ኦዳይ ነና ግድክዬ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጎዳይ ዎዝዳይሳት የፅሸ ስሚድ ፅዮነ ያና፤","poem":1},{"text":"መርና ኡፋይሳይ ካላቻ መላ ኤንታ ቦላ ኡታና።","poem":2},{"text":"ኤንቲ ኡፋይስነ ሀሹ ግያባ ደማና፤","poem":1},{"text":"አዛኖይነ ዬሆይ ኤንታፈ ሃካና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ጎዳይ፥ “ታኒ፥ ህንተና ምንይ ታና፤","poem":1},{"text":"ያትን፥ ሀይቅያ አሰነ ማታዳ ሹልያ","poem":2},{"lineBreak":true},{"text":"አሳ ናአ ያያናዉ ህንተ ኦኔ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሳሎታ ምጭዳነ ሳአ ባሱዋ ኤስዳ ጎዳ፥","poem":1},{"text":"ህንተና መዳ ፆሳ ዶግደታ።","poem":2},{"text":"ኤንቲ ህንተና ይሳናዉ ኡንኤያ","poem":1},{"text":"አሳ ሀንቁዋ ጋሶን ኡባ ጋላስ ያሻን ደኤታ።","poem":2},{"text":"ሽን ህንተና ኡንኤይሳታ ሀንቆይ አዉን ደኢ?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ድኤትዳይሳት ኤሶን ብርሸታና፤","poem":1},{"text":"ቃሸትዳ ኦላን ሀይቆኮና፤ ኮሻቶኮና።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“ታኒ ጎዳ፥ ነ ፆሳ፤","poem":1},{"text":"ጉማና መላ አባ ቃይ ታና፤","poem":2},{"lineBreak":true},{"text":"ታ ሱንይ ኡባፈ ዎልቃማ ጎዳ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ታ ቃላ ነ ዶናን ዎዳይ፥","poem":1},{"text":"ታ ኩሸ ኩያን ነና ገንዳይ፥","poem":2},{"lineBreak":true},{"text":"ሳሎታ ምጭዳይ፥ ሳኣ ባሱዋ ኤስዳይ፥","poem":2},{"lineBreak":true},{"text":"ፅዮነኮ፥ ‘ኔኒ ታ አሰ’ ” ያግዳይ ታና።","poem":2}]},{"type":"heading","content":["ፆሳ ሀንቆ ፁአ"]},{"type":"verse","number":17,"content":[{"text":"ነኖ፥ ጎዳ ኩሸፐ ጋንድጋርስያ","poem":1},{"text":"ሀንቆ ፁኣ አሾና ኡይዳ የሩሳላመ፥","poem":2},{"lineBreak":true},{"text":"ባርካ! ደንዳ! ደንዳ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እያ የልዳ ናይታፐ እዮ ካለያ እሶይካ ባዋ፤","poem":1},{"text":"እያ ድችዳ ናይታፐ እ ኩሽያ ኦይክድ","poem":2},{"lineBreak":true},{"text":"ኤፍዳ እሶይካ ባዋ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሀ ናምኡባት ነ ቃዳ ግድዶሶና፤","poem":1},{"text":"ሄሳት ላለተነ ዮ፤","poem":2},{"lineBreak":true},{"text":"ኮሽነ ማሽ ነ ቦላ ያና፤","poem":2},{"lineBreak":true},{"text":"ያትን፥ ነና ኦን ምንኔ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ነ ናይት ግተን ገልዳ ገንኤዳ","poem":1},{"text":"ኦገ ጋፃን ኩንድድ ላባንዶሶና።","poem":2},{"text":"ኤንቲ ጎዳ ሀንቁዋንነ","poem":1},{"text":"ነ ፆሳ ሴራን ኩምዶሶና።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሄሳ ግሾ፥ ዎይነ ኡሻን ግዶናሽን","poem":1},{"text":"መቶን ማትዳይሳቶ፥ ህንተ ሀይሳ ስእተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“ባ አሳስ ሞተትያ ነ ጎዳይ፥","poem":1},{"text":"ነ ፆሳይ ያጌስ፤","poem":2},{"text":"ሄኮ፥ ነና ጋንድጋርስያ፥","poem":1},{"text":"ታ ሀንቆ ፁኣ ታኒ ነ ኩሸፐ ኤካስ፤","poem":2},{"lineBreak":true},{"text":"ኔኒ ዛራዳ ሄ ማይያ ኡሻ ኡያካ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ታኒ ሄሳ ነና ኡንኤያ","poem":1},{"text":"አሳ ኩሸን ዎና፤","poem":2},{"text":"ኤንቲ ኔኮ፥ ‘ኑኒ ነ ቦላራ ሄመትድ","poem":1},{"text":"አና መላ ዛቁላ’ ” ያግዶሶና።","poem":2},{"text":"ኔኒ ኤንቲ አና ጋካናዉ","poem":1},{"text":"ነ ዞኩዋ ኤንታዉ ቢታዳነ ኦገዳ ኦዳሳ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":23}