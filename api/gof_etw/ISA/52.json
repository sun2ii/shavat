{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_etw","name":"እሳያሳ ማፃፋ","commonName":"እሳያሳ ማፃፋ","title":"እሳያሳ ማፃፋ","order":23,"numberOfChapters":66,"sha256":"4ab89101f9b620becbbf3e12322e1f109302962dc48ac0ae8b6da090f19837b1","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":52,"content":[{"type":"verse","number":1,"content":[{"text":"ነኖ ፅዮነ፥ ባርካ፤ ባርካ፥","poem":1},{"text":"ምኖተ አፍላዳ ማአ።","poem":2},{"text":"ነኖ ጌሻ ካታመ፥ የሩሳላመ፥","poem":1},{"text":"ነ ቦንቾ ማኡዋ ማአ።","poem":2},{"text":"ህዛፐ ጉየ ቃፃረቶናይነ","poem":1},{"text":"ቱን ነ ግዶ ገለና።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ነኖ፥ ድኤትዳ የሩሳላመ፥ ነ ባና ቆቆፋ፤","poem":1},{"text":"ደንዳዳ ነ አራታ ቦላ ኡታ።","poem":2},{"text":"ነኖ ፅዮነ አሳዉ፥","poem":1},{"text":"ነ ቆን ቃሸትዳ ሳንላታ ብርሻ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኡባ ሃርያ ጎዳይ ሀይሳዳ ያጌስ፦","poem":1},{"lineBreak":true},{"text":"“ህንተ ካሰ ጋተይ ባይና ባይዘትደታ፤","poem":1},{"text":"ሀእ ቃስ ሚሸ እሞና ጮ ዎዘታና።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ጎዳይ ሀይሳዳ ያጌስ፦","poem":1},{"lineBreak":true},{"text":"ታ አሳይ ኮይሮ በተ አስ ግድድ ግብፀ ብስ፤","poem":1},{"text":"ጉየፐ አሶረት ታ አሳ ጮ ኡንኤዶሶና።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ፆሳይ ሀይሳዳ ያግድ ኦዴስ፦","poem":1},{"lineBreak":true},{"text":"ታ አሳይ ጋተይ ባይና ጮ ድኤትድ ብን፥","poem":1},{"text":"ታዉ ሀይሳን አይበ ደኤይ?","poem":2},{"text":"ኤንታ ሃረይሳት ቶቾሶና፤","poem":1},{"text":"ታ ሱንይ ኡባ ዎደ ጫየቴስ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሄሳ ግሾ፥ ታ አሳይ ታ ሱን ኤራና፤","poem":1},{"text":"ሄ ጋላስ ሀይሳ ኦደይ ታና ግደይሳ ኤንቲ ኤራና፤","poem":2},{"lineBreak":true},{"text":"ኤ፥ እ ታና” ያጌስ ኡባ ሃርያ ጎዳይ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ሎኦ ምሽራቾ ኤህያ፥","poem":1},{"text":"ሳሮተ አዋጅያ፥ አቶተ ኦድያ፥","poem":2},{"text":"ፅዮነኮ፥ “ነ ፆሳይ ካዎትስ” ያግሸ","poem":1},{"text":"ደርያ ቦላራ ያ ቶሆት ዋን ሎኦና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ነ ካታማ ናገይሳት ባንታ ቃላ ቁ ኦድ፥","poem":1},{"text":"ኡፋይሳን እስፈ የፆሶና።","poem":2},{"text":"ጎዳይ ፅዮነ ስምያ ዎደ","poem":1},{"text":"ኤንቲ ባንታ አይፈን በአና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ህንተኖ የሩሳላመን ላለትዳ በሳቶ፥","poem":1},{"text":"እስፈ ኡፋይሳን የፅተ፤","poem":2},{"text":"ጎዳይ ባ አሳ ምንስ፤","poem":1},{"text":"የሩሳላመ ዎዝስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ጎዳይ ባ ጌሻ ቀስያ","poem":1},{"text":"ካዎተታ ኡባ ስንን ቆንጭስስ።","poem":2},{"text":"ቢታ ጋፃ ጋካናዉ ደእያ","poem":1},{"text":"አሳ ኡባይ ኑ ፆሳ አቶተ በአና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ህንተኖ ጎዳ ሚሽያ ቶከይሳቶ፥ ሻከትተ፥","poem":1},{"text":"ሻከትተ፥ ያፐ ከይተ።","poem":2},{"text":"ቱናባ ቦቾፍተ፤ እያ ግዶፈ ከይተ፤","poem":1},{"text":"ህንተና ጌሽተ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሽን ህንተ ከይሸ ኤሶን ከየከታ፤","poem":1},{"text":"ዎይኮ ጎደትድ ቤከታ።","poem":2},{"text":"ጎዳይ ህንተፈ ስን አድ ካለና፤","poem":1},{"text":"እስራኤለ ፆሳይ ጉየራ ግድድ ህንተና ናጋና።","poem":2}]},{"type":"heading","content":["ዋየ ኤክያ አይለ"]},{"type":"verse","number":13,"content":[{"text":"“ሄኮ፥ ታ አይለይ አኬካን ኦና፤","poem":1},{"text":"እ ቦንቸትድ፥ ቁ ቁ ጋና፤ ዳሮ ግታታና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እያ ሶምኦይ አሳ ኡባፈ፥","poem":1},{"text":"እያ መይ አሳ ናይታፐ አድ ቆሄትስ፤","poem":2},{"lineBreak":true},{"text":"እያ በእድ ዳሮ አሳይ ዳጋምዶሶና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሽን ሀእ ዳሮ ካዎተት ኡባይ","poem":1},{"text":"እያባን ማላለታና፤","poem":2},{"lineBreak":true},{"text":"እያ ጋሶን፥ ዳሮ ካዎት ባንታ ዶና ኦይካና።","poem":2},{"text":"ኤንቲ ባንታዉ ኦደትቦናባ በአና፤","poem":1},{"text":"ስእቦናባ አኬካና” ያጌስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}