{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_etw","name":"እሳያሳ ማፃፋ","commonName":"እሳያሳ ማፃፋ","title":"እሳያሳ ማፃፋ","order":23,"numberOfChapters":66,"sha256":"4ab89101f9b620becbbf3e12322e1f109302962dc48ac0ae8b6da090f19837b1","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":[{"text":"ኑኒ ኦድዳባ ኦን አማንዴ?","poem":1},{"text":"ጎዳ ቀሰይ ኦደስ ቆንጭዴ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እ እያ ስንን መላ ቢታን አጭዳ ዱሩማ መላ፤","poem":1},{"text":"ፃጶ የድዳ ዶላ መላ ድጭስ።","poem":2},{"text":"ኑኒ እያ ሎይ ፄሎና መላ","poem":1},{"text":"ማል ዎይኮ ቴም ባዋ።","poem":2},{"text":"ኑኒ እያኮ ሺቆና መላ","poem":1},{"text":"ጩቹ ማልኦ ግደና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እ አሳን ካትስ፥ እፀትስ፤","poem":1},{"text":"እ መቶፐነ አዛኖፐ","poem":2},{"lineBreak":true},{"text":"ሻከት ኤሮና አስ ግድስ።","poem":2},{"text":"አስ እያ በአናፐ ግድ","poem":1},{"text":"ባ ሶምኡዋ ዎራ ዛርያ አሳዳ ካትስ፤","poem":2},{"lineBreak":true},{"text":"ኑኒ እያ ቦንችቦኮ።","poem":2}]},{"type":"verse","number":4,"content":["እ ቱማ ኑ ዋይያ ባዉ ኤክስ፤",{"text":"ቃስ ኑ ዳቡራ ቶክስ።","poem":2},{"text":"ሽን ኑኒ፥ እ ፆሳን ደሸትድ ኩንድዳዳነ","poem":1},{"text":"ማዱንፅዳዳ ቆፕዳ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሽን እ ኑ ናጋራ ግሾ፥","poem":1},{"text":"ጫደትድ ማዱንፅስ፤","poem":2},{"lineBreak":true},{"text":"ኑ ቆሁዋ ግሾ ሾጨትድ ሊቅስ።","poem":2},{"text":"እያ ሴራን ኑኒ ሳሮ ደምዳ፤","poem":1},{"text":"እያ ማዱንን ኑኒ ፓፅዳ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኑኒ ኡባይ ኦገ ባልዳ ዶርሳዳ ዎራ ብዳ፤","poem":1},{"text":"ኑ ኡባይ ኑ ኦግያ ኦግያ ብዳ።","poem":2},{"text":"ሽን ጎዳይ ኑ ኡባ ናቁዋ","poem":1},{"text":"እያ ቦላ ዎስ።","poem":2}]},{"type":"verse","number":7,"content":["እ ኡንኤትስ፤ ቆሄትስ፤",{"text":"ሽን ባ ዶና ዶይቤና።","poem":2},{"text":"ሹካናዉ ኤፍያ ኡርገ ዶርሳዳ ላገትስ፤","poem":1},{"text":"ባ እክስያ ሜድያ ኡራ ስንን","poem":2},{"lineBreak":true},{"text":"ስእ ግያ ዶርሳ መላ አይኮካ ፖግቤና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኤንቲ እያ ኡንኤንነ ጌላ ፕርዳን ኤፍዶሶና፤","poem":1},{"text":"እ ታ አሳ ናጋራ ግሾ ሾጨትድ፥","poem":2},{"lineBreak":true},{"text":"ደኦን ደኤይሳታ ቢታፈ ክችዳይሳ","poem":2},{"lineBreak":true},{"text":"እያ ኮቻፈ ኦን አኬክዴ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እያ ዶናን ባል ባይና፥ እ፥ ኢታባ ኦና፥","poem":1},{"text":"ባ ሀይቁዋን ኢታ አሳታራ ታይበትስ፤","poem":2},{"lineBreak":true},{"text":"እያ ዱፎይ ዱረ አሳታራ ግድስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ሽን እያ ቆሄተይነ እያ ኡንኤተይ","poem":1},{"text":"ጎዳ ሸነ ግድስ።","poem":2},{"text":"እ ባና ናጋራ ያርሾ ኦያ ዎደ","poem":1},{"text":"ባ ኮቻ በአና።","poem":2},{"text":"እያ ላይይ አዱቃና፤","poem":1},{"text":"ጎዳ ሸነይ እያ ኩሸን ፖለታና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ባ ሸምፑዋ ዋያፐ ጉየ፥","poem":1},{"text":"እ ደኦ ፖኦ በአና፤ ኡፋይታና።","poem":2},{"text":"ታ ፅሎ አይለይ ባ ኤራተን ዳሮታ ፅልሳና፤","poem":1},{"text":"ኤንታ ቆሁዋካ ቶካና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሄሳ ግሾ፥ ታኒ እያ ግሹዋ","poem":1},{"text":"ግታ አሳታ ግዶን እማና፤","poem":2},{"lineBreak":true},{"text":"ምኖታራ እ ድኡዋ ሻከታና።","poem":2},{"text":"እ ባ ሸምፑዋ ሀይቆስ አድ እምድ፥","poem":1},{"text":"ኢታታራ ፓይደትስ።","poem":2},{"text":"እ ዳሮ አሳ ናጋራ ቶክስ፤","poem":1},{"text":"ጌላታስ ጋናትስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/52.json","previousChapterAudioLinks":{},"numberOfVerses":12}