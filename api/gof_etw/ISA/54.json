{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_etw","name":"እሳያሳ ማፃፋ","commonName":"እሳያሳ ማፃፋ","title":"እሳያሳ ማፃፋ","order":23,"numberOfChapters":66,"sha256":"4ab89101f9b620becbbf3e12322e1f109302962dc48ac0ae8b6da090f19837b1","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":54,"content":[{"type":"heading","content":["ፅዮነ ስን ቦንቹዋ"]},{"type":"verse","number":1,"content":[{"text":"ናተ፥ የሎና ማይን፥ የፃ!","poem":1},{"text":"ናተ፥ እቀታ ኤሮናረ፥ ኡፋይሳን እልላ!","poem":2},{"text":"አዝናራ ደእያ ማጫሰ ናይታፐ","poem":1},{"text":"ባርካ ደእያ ማጫሰ ናይት ዳራና።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ነ ዱንካንያ በሳ ዳልግሳ፤","poem":1},{"text":"ዱንካንያ ገሸታ ፕድ ኦዳ ምጫ፤","poem":2},{"lineBreak":true},{"text":"ፁምሶፓ፤ ዎዶሩዋ አዱሳ፤ ሽያ ምን።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኔኒ ኡሻችነ ሀድርስ ዳልጋና፤","poem":1},{"text":"ነ ኮቻት ካዎተታ ላታና፤","poem":2},{"lineBreak":true},{"text":"ባይሳትዳ ኤንታ ካታማታን ኬፅድ ዳና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“ያዮፋ፤ ኔኒ ዬላታካ፤","poem":1},{"text":"ዳጋሞፋ፤ ኔኒ ካዉያካ።","poem":2},{"text":"ነ ያላጋተ ዬላ ኔኒ ዶጋና፤","poem":1},{"text":"ነ አምኤተ ቦርያ ህዛፐ ጉየ ሀሳያካ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ነ አዝናይ ነና መዳይሳ፤","poem":1},{"text":"እያ ሱንይ ኡባፈ ዎልቃማ ጎዳ።","poem":2},{"text":"እስራኤለ ጌሻይ ነና ዎዝዳይሳ፤","poem":1},{"text":"እ ቢታ ኡባ ፆሳ ጌተታና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አዝን አግን፥ ዶገታዳ አዛንያ ማጫሳዳ፥","poem":1},{"text":"ያላጋተን አዝና ሶፐ ከይዳ፥","poem":2},{"lineBreak":true},{"text":"ማጫሳዳ ኔኒ ሀናዳ ደእሽን፥","poem":2},{"lineBreak":true},{"text":"ታኒ ጎዳይ ነና ዛራዳ ፄጋስ።","poem":2}]},{"type":"verse","number":7,"content":["“ጉ ዎደ ታኒ ነና አጋስ፥",{"text":"ሽን ግታ ቃን ታኒ ነና ዛራዳ ኤሀና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሱልያ ሀንቆን ታኒ ታ ሶምኡዋ","poem":1},{"text":"ኔፐ ጉ ዎደስ ገንስ።","poem":2},{"text":"ሽን መርና ማሮተን ታኒ ነዉ ቃታና”","poem":1},{"text":"ያጌስ ነና ዎዝያ ጎዳይ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“ሀይስ ታዉ ኖሄ ዎድያ መላ፤","poem":1},{"text":"ሄ ዎደ ታኒ ዮ ሃን","poem":2},{"lineBreak":true},{"text":"ዛራዳ ሳኣ ይስከ ጋዳ ጫቅዳይሳዳ፥","poem":2},{"lineBreak":true},{"text":"ዛራዳ ነ ቦላ ሀንቀቶና መላነ","poem":2},{"lineBreak":true},{"text":"ሴሮና መላ ታኒ ጫቃስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ደረት ቃፃናዉ፥ ዙማት ባንታ በሳፈ ክቻናዉ ዳንዳኦሶና፤","poem":1},{"text":"ሽን ታ መርና ሲቆይ ኔፐ ሻከተና፤","poem":2},{"lineBreak":true},{"text":"ታ ሳሮተ ጫቆይ ኔፐ ክቸና”","poem":2},"ያጌስ ነዉ ቃትያ ጎዳይ።"]},{"type":"verse","number":11,"content":[{"text":"“ነኖ፥ መቶትዳ ካታመ፥ ጎተይ ያነ ሃነ ሾጭዳረ፥","poem":1},{"text":"ምንያባይ ይዳረ፥","poem":2},{"lineBreak":true},{"text":"ሄኮ፥ ታኒ ነና ቦንቾ ሹቻን አሌቅሳዳ ኬፃና፤","poem":2},{"lineBreak":true},{"text":"ነ ባሱዋ ሳንፓረ ሹቻን ሂፃና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ነ ሹቻ ግምብያ ቁስትያ ዞኦ እንቆ ሹቻን፥","poem":1},{"text":"ነ ፐንግያ ጶልያ አልኦ ሹቻን፥","poem":2},{"lineBreak":true},{"text":"ነ ድርሳ ቦንቾ ሹቻን ግምባና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ነ ናይት ኡባይ ጎዳፐ ታማራና፤","poem":1},{"text":"ነ ናይታ ሳሮተይ ዳራና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኔኒ ፅሎተን ምናዳ ኤቃና፤","poem":1},{"text":"ገነይነ ኡንኤይ ኔፐ ሃካና።","poem":2},{"text":"ነና ያሽስያባ ዴና፤","poem":1},{"text":"ዳጋም ኔኮ ሺቀና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ነና ኦላናዉ ደንደይ ደእኮ፥ ሄስ ታፐ ግደና፤","poem":1},{"text":"ነና ቆሀናዉ ኮየይ ደእኮ፥ እ ኩንዳና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“ሄኮ፥ ሁበን ታማ ሁብድ፥","poem":1},{"text":"ባ ቆፕዳ ኦላ ሚሽያ ቆፅያ ኡራ ታኒ መስ፤","poem":2},{"lineBreak":true},{"text":"ይሳና መላ ይሰይሳ መዳይ ታና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ነና ቆሀናዉ ኦሰትዳ አይ ሚሸይካ ነ ቦላ ኦና፤","poem":1},{"text":"ነና ሞትያ እንፃርሳ ኡባስ ነ ዛሮ እማና።","poem":2},{"text":"ጎዳ አይለታ ላታይ ሀይሳ፤","poem":1},{"text":"ታፐ ኤንቲ ኤክያ ፅሎ ሀይሳ” ያጌስ ጎዳይ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":17}