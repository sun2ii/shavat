{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_etw","name":"እሳያሳ ማፃፋ","commonName":"እሳያሳ ማፃፋ","title":"እሳያሳ ማፃፋ","order":23,"numberOfChapters":66,"sha256":"4ab89101f9b620becbbf3e12322e1f109302962dc48ac0ae8b6da090f19837b1","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":55,"content":[{"type":"heading","content":["ሳሞትዳ ኡባይ ዮ"]},{"type":"verse","number":1,"content":[{"text":"ህንተኖ፥ ሳሞትዳይሳቶ፥ ኡባይ ታኮ ሃ ዪተ፤","poem":1},{"text":"ሚሸይ ባይናይሳቶ፥ ሃ ዪተ።","poem":2},{"text":"ሻምድ ሚተ፤","poem":1},{"text":"ሃ ይድ፥ ሚሸ ቃንፆና","poem":2},{"lineBreak":true},{"text":"ጮ ዎይነ ኡሽነ ማ ሻምተ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ካ ግዶናባስ ህንተ ሚሽያ አይስ ከሴቲ?","poem":1},{"text":"ካልሶናባን ህንተ ዎልቃ አይስ ዉርሴቲ?","poem":2},{"text":"አነ ታና ስእተ፥ ታኒ ኦደይሳ ሀይዝተ፤","poem":1},{"text":"ሎኦ ካ ሚተ፤","poem":2},{"lineBreak":true},{"text":"ሎኦ ካን ህንተ አሳተ ኡፋይስተ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“ህንተ ሀይ ታኮ ዛሪድ ታና ስእተ፤","poem":1},{"text":"ደኦን ዳናዉ ታ ኦደይሳ ስእተ፤","poem":2},{"lineBreak":true},{"text":"ታኒ ዳዊታስ ገልዳ ኡፋይሳ ቃላን ህንተና አንጃና።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሄኮ፥ ታኒ እያ ካዎተታስ ማርካ፥","poem":1},{"text":"ካለይሳነ ሀላቃ ኦስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ጎዳይ፥ ነ ፆሳይ፥ እስራኤለ ጌሻይ","poem":1},{"text":"ነና ቦንችዳ ግሾ፥","poem":2},{"lineBreak":true},{"text":"ኔኒ ኤሮና ካዎተታ ፄጋና፤","poem":2},{"lineBreak":true},{"text":"ነና ኤሮና ካዎተት ኤለስድ ኔኮ ያና።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“ጎዳይ በንትያ ዎደ እያ ኮይተ፤","poem":1},{"text":"ማታን ደእያ ዎደ እያ ፄግተ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኢታ አስ ባ ኦግያፐ ስሞ፤","poem":1},{"text":"ናጋራንቾይ ባ ቆፋ አጎ።","poem":2},{"text":"ጎዳኮ ስሞ፥ እካ እያ ማራና፤","poem":1},{"text":"እ ኑ ፆሳኮ ስሞ፥ እያዉ አቶ ጋና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታ ቆፋይ ህንተ ቆፋ መላ፥","poem":1},{"text":"ታ ኦገይ ህንተ ኦግያ መላ ግደና”","poem":2},"ያጌስ ጎዳይ።"]},{"type":"verse","number":9,"content":[{"text":"ሳሎት ሳኣፐ ቀይሳዳ፥","poem":1},{"text":"ታ ኦገይ ህንተ ኦግያፐ፥","poem":2},{"lineBreak":true},{"text":"ታ ቆፋይ ህንተ ቆፋፐ ቄስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እርነ ሻች ሳሎፐ ዎድ፥","poem":1},{"text":"ቢታ ላክስድ፥ ካ ዶላና መላነ","poem":2},{"lineBreak":true},{"text":"አይፋና መላ ኦይሳዳ፥ ዘረይሳስ ዘረ፥","poem":2},{"lineBreak":true},{"text":"መይሳስ ካ እሞና ጉየ ሳሎ ስመና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታ ዶናፐ ከይያ ቃላይ ሄሳ ማላ፤","poem":1},{"text":"እ ታኒ ሀልችዳይሳ ፖሎናነ","poem":2},{"lineBreak":true},{"text":"ታ ኪትዳይሳ ኦና ታኮ ጮ ስመና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“ህንተ ኡፋይሳን ከያና፤ ሳሮን ሞይዘታና፤","poem":1},{"text":"ደረትነ ዙማት ህንተ ስንን ኡፋይትድ የፃና፤","poem":2},{"lineBreak":true},{"text":"ባዞ ምት ኡባይ ባንታ ኩሽያ ባቃና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አጉን ግሾ ፂዳ፥","poem":1},{"text":"ጎምኦረ ግሾ ፃይ ዶላና።","poem":2},{"text":"ሄስ ጎዳ ቆፍስያባነ","poem":1},{"text":"መርናዉ ዮና ማላ ግዳና”","poem":2},"ያጌስ ጎዳይ።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}