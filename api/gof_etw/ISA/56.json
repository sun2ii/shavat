{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_etw","name":"እሳያሳ ማፃፋ","commonName":"እሳያሳ ማፃፋ","title":"እሳያሳ ማፃፋ","order":23,"numberOfChapters":66,"sha256":"4ab89101f9b620becbbf3e12322e1f109302962dc48ac0ae8b6da090f19837b1","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":56,"content":[{"type":"heading","content":["አቶተ ሀራታስ"]},{"type":"verse","number":1,"content":["“ሱረ ፕርዳ ናግተ፤ ፅሎ ኦተ፤",{"text":"ታ አቶተይ ኤለስድ ያና፤","poem":2},{"lineBreak":true},{"text":"ታ ፅሎተይ ማታን ቆንጫና።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሀይሳ ኦያ ኡራይ፥","poem":1},{"text":"ሳምባታ ቱንሶና ቦንችያ ኡራይነ","poem":2},{"lineBreak":true},{"text":"ባ ኩሸይ ኢታባ ኦና መላ ተቅያ ኡራይ አንጀትዳይሳ”","poem":2},"ያጌስ ጎዳይ።"]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ጎዳኮ ሺቅዳ በተ አስ፥","poem":1},{"text":"“ጎዳይ ታና ባ አሳፐ ሻካና” ጎፖ፤","poem":2},{"lineBreak":true},{"text":"ሹፋይ፥ “ታኒ መልዳ ም” ጎፖ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“ታ ሳምባታ ቦንችያ፥","poem":1},{"text":"ታና ኡፋይስያባ ዶረይነ","poem":2},{"lineBreak":true},{"text":"ታ ጫቁዋ ምንድ ናግያ ሹፋታስ፥","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ኤንታዉ ታኒ ታ ኬንነ ታ ድርሳ ግምብያ ግዶን","poem":2},{"lineBreak":true},{"text":"ኤንቲ ሀሳየትያባ እማና።","poem":2},{"text":"ኤንቲ ማጫ ናአነ አደ ናአ የልድ፥","poem":1},{"text":"ደምያ ቦንቹዋፈ አያ","poem":2},{"lineBreak":true},{"text":"ሱን ታኒ ኤንታዉ እማና፤","poem":2},{"lineBreak":true},{"text":"ታኒ መርናዉ ዮና ሱን ኤንታዉ እማና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ጎዳ ሀጋዛናዉ፥ ጎዳ ዶሳናዉነ","poem":1},{"text":"እያ አይለ ግዳናዉ ባንታና እያኮ ሺሽያ፥","poem":2},{"lineBreak":true},{"text":"ሳምባታ ቱንሶና ቦንችያነ","poem":2},{"lineBreak":true},{"text":"ታ ጫቆ ቃላ ምንድ ናግያ በተ አሳታ፥","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ታኒ ታ ጌሻ ዙማ ቦላ ኤሀዳ","poem":2},{"lineBreak":true},{"text":"ታ ዎሳ ኬን ኤንታ ኡፋይሳና።","poem":2},{"text":"ኤንቲ ታ ያርሾ በሳን ሺሽያ ፁሳ ያርሾይነ","poem":1},{"text":"ሀራ ያርሾይ ኤከታና፤","poem":2},{"lineBreak":true},{"text":"ታ ኬይ አሳ ኡባይ ፆሳ ዎስያ ኬ ጌተታና”","poem":2},"ያጌስ።"]},{"type":"verse","number":8,"content":[{"text":"“ሽቅዳይሳታ ቦላ ጉጃዳ ሀራታካ ታኒ ሺሻና”","poem":1},{"text":"ያጌስ እስራኤለፐ ላለትዳይሳታ ሺሽያ፥ ኡባ ሃርያ ጎዳይ።","poem":2}]},{"type":"heading","content":["ፆሳይ ኢታታ ሞቴስ"]},{"type":"verse","number":9,"content":[{"text":"ህንተኖ ባዞ ዶአቶ፥","poem":1},{"text":"ህንተኖ ዎራ ዶአቶ፥","poem":2},{"lineBreak":true},{"text":"ኡባይ ሃ ይድ ሚተ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እስራኤለ አሳ ናገይሳት ቆቀ፤ ኤንታዉ ኤር ባዋ፤","poem":1},{"text":"ኤንቲ ኡባይ ቦጫናዉ ዳንዳኦና ቡታለ ካናታ፤","poem":2},{"lineBreak":true},{"text":"ኤንቲ ዝንእድ ኤልሞቶሶና፤ ስኮ ዶሶሶና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኤንቲ ምድ ካሎና ያራምባ ካና መላ፤","poem":1},{"text":"ኤንቲ አኬክ ፓጭዳ ሄንንቾ።","poem":2},{"text":"ኤንቲ ኡባይ ባንታ ኦገ ብዶሶና፤","poem":1},{"text":"ኡባይ ባንታ ጎአ ፃላላ ኮዮሶና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኤንቲ፥ “ሃ ዪተ፤ ዎይነ ኡሻ አነ ኡዮስ፤","poem":1},{"text":"ማይያ ኡሻ አነ ጋኖስ!","poem":2},{"text":"ዎንቶይ ሀች መላ ግዳና፤","poem":1},{"text":"ሀችፈካ አድ ሎአና” ያጎሶና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}