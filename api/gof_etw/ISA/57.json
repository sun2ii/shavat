{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_etw","name":"እሳያሳ ማፃፋ","commonName":"እሳያሳ ማፃፋ","title":"እሳያሳ ማፃፋ","order":23,"numberOfChapters":66,"sha256":"4ab89101f9b620becbbf3e12322e1f109302962dc48ac0ae8b6da090f19837b1","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":57,"content":[{"type":"verse","number":1,"content":[{"text":"ፅሎ አስ ሀይቄስ፤","poem":1},{"text":"ሽን ሄሳ ቆፐይ ባዋ።","poem":2},{"text":"ባንታና ፆሳስ እምዳ አሳይ ቢታፈ ኤከቶሶና፥","poem":1},{"text":"ሽን ፅሎ አስ ኢት ያናፐ ስንትድ፥","poem":2},{"lineBreak":true},{"text":"ኤከተይሳ ኦንካ አኬከና።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እ፥ ብድ ሳሮተ ደእያ በሲ ገሌስ፤","poem":1},{"text":"ሱረተን ሄመተይሳት ሀይቅድ፥","poem":2},{"lineBreak":true},{"text":"ሸምፖ ደሞሶና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“ህንተኖ፥ ማሮ ናይቶ፥ ህንተኖ ላምያነ","poem":1},{"text":"ላይማትያ ዛረቶ፥ ሃ ዪተ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ህንተ ኦና ቀልቅሴቲ?","poem":1},{"text":"ህንተ ኦና ቦሬቲእ?","poem":2},{"text":"ህንተ እንፃርሳ ኦደ ቦላ ከሴቲ?","poem":1},{"text":"ህንተ ጌላታነ ዎርዳንቾ ናይታ ግደከቲ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ህንተ ዎላ ጋርሳንነ","poem":1},{"text":"ዳሻ ም ጋርሳን አሞን ፁገቴታ።","poem":2},{"text":"ህንተ ናይታ ዛንጋራንነ","poem":1},{"text":"ዛላ ቆጶን ሹክድ ያርሼታ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዛንጋራን ደእያ ሊቆ ሹቻት ህንተ ፆሳታ፤","poem":1},{"text":"ህንተ ኤንታዉ ኡሻ ያርሾ ትግደታ።","poem":2},{"text":"ካ ያርሾካ እምደታ","poem":1},{"text":"ያትን፥ ታኒ ሀይሳን ሀንቀትክና?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዙማ ሁጰን ሂፃ የግደታ፤","poem":1},{"text":"ያን ያርሻናዉ ከይደታ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ህንተ ፐንግያፈነ ጎባነታፐ","poem":1},{"text":"ሶ ባጋራ ኤቃ ምስለታ ኤስደታ።","poem":2},{"text":"ታና አግድ ህንተ አርሳ ዳልግስድ፥ ያ ከይደታ፤","poem":1},{"text":"ኤንታራ ጫቅደታ፤ ያትድ ኤንታ አርሳ ዶስደታ፤","poem":2},{"lineBreak":true},{"text":"ኤንታ ካሉዋ በእደታ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዛይተነ ሽቶ ኤክድ ሞሎካ ጌተትያ ኤቃኮ ብደታ፤","poem":1},{"text":"ህንተ ኪታንቾታ ሃሆ ሶ ኪትደታ፤","poem":2},{"lineBreak":true},{"text":"ሀር አቶሽን ስኦለ ጋካናዉ ዎደታ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ህንተ ሀራ ፆሳታ ኮይሸ ዳቡርደታ፤","poem":1},{"text":"ሽን፥ ‘ኡፋይስ ባዋ’ ግቤከታ።","poem":2},{"text":"ህንተ ዎልቃይ ሃ ኦራፅስ፤","poem":1},{"text":"ሄሳ ግሾ፥ ላባንድ ኩንድቤከታ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“ህንተ ኦና ያይድ፥ ታዉ ዎርዶትደቲ?","poem":1},{"text":"ህንተ ታና ቆፕበከታ፤","poem":2},{"lineBreak":true},{"text":"ህንተ ዎዛናን ቆፕበከታ።","poem":2},{"text":"ህንተ ታዉ ያዮና እፅዳይ","poem":1},{"text":"ታኒ ዳሮ ዎደ ስእ ግዳ ግሾ ግደኔ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ታኒ ህንተ ፅሎተነ ህንተ ኦሶታ አዋጃና፤","poem":1},{"text":"ሽን ህንተና አይኮካ ጎኦኮና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ህንተ ማዶ ደማናዉ ዋስያ ዎደ","poem":1},{"text":"ህንተ ሺሽዳ ኤቃት ህንተና አሸና!","poem":2},{"text":"ኤንታ ኡባ ጫርኮይ ኤፋና፤","poem":1},{"text":"እስ ቶሆ ጫርክያ ጫርኮይ ኤንታ ፑንድ ይሳና።","poem":2},{"text":"ሽን ታና ባዉ ባቃትድ አትያ በሰ ኦያ","poem":1},{"text":"ኡራይ ቢታ ላታና፤","poem":2},{"lineBreak":true},{"text":"ታ ጌሻ ዙማ ኤካና”","poem":2},"ያጌስ።"]},{"type":"heading","content":["ዎዛን መቅዳ አሳስ ምን"]},{"type":"verse","number":14,"content":["“ባስተ፥ ባስተ! ኦገ ጊግስተ፤",{"text":"ታ አሳ ኦግያፐ ብያባ ኡባ ድግተ”","poem":2},"ያጌስ ጎዳይ።"]},{"type":"verse","number":15,"content":[{"text":"መርናዉ ደኤይስ፥ ግታይ፥ ቃ በሳን ደኤይስ፥","poem":1},{"text":"እያ ሱንይ ጌሻ ጌተተይስ፥ ያጌስ፦","poem":2},{"text":"“ካዉይዳ አሳ አያና ደንናዉ፥","poem":1},{"text":"መቅዳ ዎዛን ደኤይሳታ ኮላናዉ፥","poem":2},{"lineBreak":true},{"text":"ካዉይዳነ መቅዳ አያን ደኤይሳራ ዳና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ታ መዳ አሳ አያናይነ ሸምፖይ፥","poem":1},{"text":"ታ ስንን ዶጮና መላ ታኒ መርናዉ ሞትከ፤","poem":2},{"lineBreak":true},{"text":"ኡባ ዎደ ሀንቀትከ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ኤንታ ናጋራ ጋሶን ታኒ ኤንታ ሀንቀታዳ ሴራስ፤","poem":1},{"text":"ታ ሶምኡዋ ኤንታፈ ገንስ፤","poem":2},{"lineBreak":true},{"text":"ሽን ኤንቲ ሀእካ ባንታ ዎዛና ቆፋን ብዶሶና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ታኒ ኤንታ ኦግያ በአስ፤","poem":1},{"text":"ሽን ታኒ ኤንታ ፓና፥ ካለና፤","poem":2},{"lineBreak":true},{"text":"እያዉነ እያ ግሾ ዬከይሳታ ምንና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"እስራኤለ ቢታን ዬከይሳታ፥","poem":1},{"text":"መተርሻን ጋላታ ኩንና።","poem":2},{"text":"ሃሆንነ ማታን ደኤይሳታስ፥","poem":1},{"text":"ሳሮይ ግዶ፤ ታኒ ኤንታ ፓና”","poem":2},"ያጌስ ጎዳይ።"]},{"type":"verse","number":20,"content":[{"text":"ሽን ኢታት ኡርቃነ ስልሞ ከስያ፥","poem":1},{"text":"ዎፑ ጋናዉ ዳንዳኦና አባ ቤታ መላ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“ኢታታስ ሳሮይ ባዋ”","poem":1},"ያጌስ ታ ፆሳይ።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":21}