{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_etw","name":"እሳያሳ ማፃፋ","commonName":"እሳያሳ ማፃፋ","title":"እሳያሳ ማፃፋ","order":23,"numberOfChapters":66,"sha256":"4ab89101f9b620becbbf3e12322e1f109302962dc48ac0ae8b6da090f19837b1","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":58,"content":[{"type":"heading","content":["ቱማ ፆማ"]},{"type":"verse","number":1,"content":[{"text":"ጎዳይ ሀይሳዳ ያጌስ፦","poem":1},{"text":"“ነ ቃላ ቁ ኦዳ ዋሳ፤ ጉየ ጎፓ፤","poem":2},{"lineBreak":true},{"text":"ነ ቃላ ሞይዘዳ ቁ ኦ።","poem":2},{"text":"ታ አሳስ ኤንታ ጌላተ፥","poem":1},{"text":"ያይቆባ ኬስ ኤንታ ናጋራ ኦዳ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሽን ኤንቲ ታና ጋላስ ጋላስ ኮዮሶና፤","poem":1},{"text":"ታ ኦግያ ካላናዉ ዶስያ ዳኖሶና።","poem":2},{"text":"ፅሎ ኦዳነ ፆሳ ኪታ አግቦና አሳዳ","poem":1},{"text":"ኤንቲ ታና ሱረ ፕርዳ ኦይቾሶና፤","poem":2},{"lineBreak":true},{"text":"ታኮ ፆሳኮ ሺቃናዉ ዶስያ ዳኖሶና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኤንቲ ጎዳኮ፥","poem":1},{"text":"‘ኑኒ ፆሞስ፥ ሽን ኔኒ አይስ ኑና ፄልኪ?","poem":2},{"lineBreak":true},{"text":"ኑኒ ኑናተ ካዉሽዳ፥","poem":2},{"lineBreak":true},{"text":"ሽን ኔኒ አይስ ኤሮናዳ ሀናድ’ ያጎሶና።","poem":2},{"text":"ጎዳይ ዛሪድ፥ ‘ሄኮ፥ ህንተ ፆምያ ዎደ","poem":1},{"text":"ህንተና ኡፋይስያባ ኦታ፤","poem":2},{"lineBreak":true},{"text":"ህንተ ኦሳንቾታ ኡንኤታ።’","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ህንተ ኦሻንነ ፓላማን ፆሜታ፤","poem":1},{"text":"ቃይ ባይና ኢታ ደሸ ደቻናዉ ፆሜታ።","poem":2},{"text":"ሄሳ መላ ፆምያ ህንተ ዎሳይ ቦላ ሳሉዋን","poem":1},{"text":"ስኤቶና መላ ኦስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ታኒ ዶርዳ ፆማይ ሀይሳ መላ ፆሜ?","poem":1},{"text":"እስ አስ ባናተ ካዉሸይ ሀይሳ መላ ጋላሳ ፃላላኔ?","poem":2},{"text":"ታኒ ኮይያ ፆማይ አስ ባ ሁጵያ","poem":1},{"text":"ካፅዳ ጋሸዳ ሆክሳና መላነ","poem":2},{"lineBreak":true},{"text":"ብዶ ትየትድ ካዮ ማኦ ማእድ ኡተዬ?","poem":2},{"text":"ህንተ ሄሳ ፆማ ግድ ፄገትዬ?","poem":1},{"text":"ሄ ፆማ ጋላሳይ ጎዳ ስንን ኤከትዬ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“ታኒ ዶርያ ፆማይ ሀይሳ፤","poem":1},{"text":"ሱረ ፕርዳ ዮ ሳንላታ ብላና መላነ","poem":2},{"lineBreak":true},{"text":"ቃምባራ መንድ ኡንኤትዳይሳታ","poem":2},{"lineBreak":true},{"text":"ላአ ከሳና መላ ግደነዬ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታኒ ዶርያ ፆማይ ኮሻትዳይሳ ሙዛና መላ፥","poem":1},{"text":"ኬ ባይና ማንቆታ ሶ ኤካና መላ፥","poem":2},{"lineBreak":true},{"text":"ካሎትዳይሳ በአዳ ማይዛና መላነ","poem":2},{"lineBreak":true},{"text":"ማዶ ኮይያ ህንተ ዳቡዋፈ","poem":2},{"lineBreak":true},{"text":"ህንተና ገንና መላሳ ግደኔ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ያትኮ፥ ህንተ ፖኦይ ዎንታ ፃልቀዳ ፖአና፤","poem":1},{"text":"ህንተ ፓፆተይ ኤሶን ያና።","poem":2},{"text":"ህንተ ፅሎተይ ህንተፈ ስንራ ባና፤","poem":1},{"text":"ጎዳ ቦንቾይ ህንተፈ ጉየራ ግድድ፥","poem":2},{"lineBreak":true},{"text":"ህንተና ናጋና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሄ ዎደ ህንተ ፄጋና፤","poem":1},{"text":"ጎዳይ ህንተዉ ኮያና።","poem":2},{"text":"ህንተ ማዶ ኮይድ ዋሳና፤","poem":1},{"text":"እ፥ ‘ሄኮ፥ ታኒ ሀይሳን ደአይስ!’ ያጋና።","poem":2},{"lineBreak":true},{"text":"“ህንተ ግዶፈ ኡንኤያ ቃምባራ ድግኮ፥","poem":1},{"text":"ብራን ማለይሳነ ኢታባ ኦደተይሳ አግኮ፥","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኮሻትዳይሳ ሙዝኮ፥","poem":1},{"text":"መቶትዳይሳታ ኮሽያባን ማድኮ፥","poem":2},{"lineBreak":true},{"text":"ሄ ዎደ ህንተ ፖኦይ ማን ፖአና፤","poem":2},{"lineBreak":true},{"text":"ህንተ ቃማይ ሴታ ጋላስ ግዳና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጎዳይ ህንተና ኡባ ዎደ ካለና፤","poem":1},{"text":"ህንተና መላ ቢታን ኮሽያባን ካልሳና፤","poem":2},{"lineBreak":true},{"text":"ህንተ ፃጱዋ ፃልሳና።","poem":2},{"text":"ህንተ ሃ ኡያ ጋናተ መላነ","poem":1},{"text":"መል ኤሮና ሃ ፑልቶ መላ ግዳና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ነ አሳይ በን ላለትዳ በሳታ ዛሪድ ኬፃና፤","poem":1},{"text":"ዳሮ ዎደፐ ካሰ ባሰትዳ ባሶታ ኬፅድ ቁ ኦና።","poem":2},{"text":"ህንተ ‘ላለትዳ ግምበታ ግምበይሳታነ","poem":1},{"text":"አሳይ ደእያ በሳነ ዎጋ ኦገይ","poem":2},{"lineBreak":true},{"text":"ደእያ ካታማታ ኤሰይሳታ ጌተታና።’","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ሳምባታ ጋላሳ ቦንቾ አጎና እፅኮ፥","poem":1},{"text":"ታ ጌሻ ጋላስ ህንተ ጎአ የደይሳ አግኮ፥","poem":2},{"lineBreak":true},{"text":"ሳምባታ ኡፋይስነ ቦንቸትዳ፥","poem":2},{"lineBreak":true},{"text":"ጎዳ ጋላሳ ቦንቾ ጋዳ ፄግኮ፥","poem":2},{"lineBreak":true},{"text":"ህንተ ህንተ ኦግያ ቦና አግድ ሄ ጋላሳ ቦንችኮ፥","poem":2},{"lineBreak":true},{"text":"ህንተና ኡፋይስያባ ኦናነ ሀዳባ ኦደቶና አግኮ፥","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ሄ ዎደ ህንተ ጎዳን ኡፋይታና፤","poem":2},{"lineBreak":true},{"text":"ታኒ ህንተና ዳሮ ቦንቸትዳይሳታ ኦና፤","poem":2},{"lineBreak":true},{"text":"ህንተ አዋ ያይቆባ ላታ ህንተ ማና መላ ኦና።","poem":2},"ታኒ ጎዳይ ሀይሳ ኦዳስ” ያጌስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/57.json","previousChapterAudioLinks":{},"numberOfVerses":14}