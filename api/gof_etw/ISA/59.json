,{"text":"ጱጱልያፈ እሶይ መቅኮ፥","poem":2},{"lineBreak":true},{"text":"እያፐ ሾሽ ከዬስ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኤንቲ ዳድዳ ሻንጎ ሃዳይ ማኦስ ሀነና፤","poem":1},{"text":"እያራ ባንታ አሳተ ካማናዉ ዳንዳኦኮና።","poem":2},{"text":"ኤንታ ኦሶይ ኢታ፤","poem":1},{"text":"ጌላ ኦሶይ ኤንታ ኩሸን ኩምስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኤንታ ቶሆት ኢታባ ኦናዉ ዎፆሶና፤","poem":1},{"text":"ፅሎ ሱ ጉሳናዉ ኤሶቶሶና።","poem":2},{"text":"ኤንታ ቆፋይ ኢታ፤ ኤንቲ ብዳ በሳ ኡባን","poem":1},{"text":"ቆሆይነ ቦሽ ደኤስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኤንቲ ሳሮተ ኦገ ኤሮኮና፤","poem":1},{"text":"ኤንታ ኦግያን ሱረ ፕርድ ባዋ።","poem":2},{"text":"ኤንቲ ባንታ ኦግያ ጌላይዶሶና፤","poem":1},{"text":"ሄ ኦግያራ ሄመትያ ኦንካ ሳሮ ደመና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሄሳ ግሾ፥ ሱረ ፕርድ ኑፐ ሃክስ፤","poem":1},{"text":"ፅሎተ ኑኮ ሺቀና።","poem":2},{"text":"ኑኒ ፖኦ ኮዮስ፥ ሽን ማ ግድስ፤","poem":1},{"text":"ዋጋጋ ፖኦ ኮዮስ፥","poem":2},{"lineBreak":true},{"text":"ሽን ሳካና ማን ሄመቶስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኑኒ ቆቀዳ ድርሳ ግምብያ ቦላ ታታፎስ፤","poem":1},{"text":"ሴታ ጋላስ፥ ሳእ ለምእን ሄመትያዳ በቶስ፤","poem":2},{"lineBreak":true},{"text":"ዎልቃራ ደእያ አሳ ግዶን","poem":2},{"lineBreak":true},{"text":"ኑኒ ሀይቅዳ አሳ መላ ግድዳ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኑኒ ኡባይ ባባንዳ ዋሶስ፤","poem":1},{"text":"ሆለዳ ካዮትድ ኦሎስ።","poem":2},{"text":"ኑኒ ሱረ ፕርዳ ኮይዳ፥","poem":1},{"text":"ሽን ደምቦኮ፤","poem":2},{"lineBreak":true},{"text":"አቶተ ኮይዳ፥ ሽን እ ኑፐ ሃክስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ኑ ባላይ ነ ስንን ዳርስ፤","poem":1},{"text":"ኑ ናጋራይ ኑ ቦላ ማርካቴስ።","poem":2},{"text":"ኑ ናቆይ ኑራ ደኤስ፤","poem":1},{"text":"ኑ ቆሁዋ ኑ ኤሮስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኑኒ ማካልድ፥ ጎዳ ካዳ፤","poem":1},{"text":"ኑ ፆሳ አግድ ጉየ ስምዳ።","poem":2},{"text":"ጌላተነ ገነ ኦደትዳ፤","poem":1},{"text":"ኑኒ ዎርዶ ቃንትድ ዎርዶ የልዳ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሱረ ፕርድ ጉየ ሱገትስ፤","poem":1},{"text":"ፅሎተ ኑፐ ሃክስ።","poem":2},{"text":"ቱማተ ዳባባን በቴስ፤","poem":1},{"text":"አማነተ ገላናዉ በሰ ይስ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ቱማተ አዉንካ በንተና፤","poem":1},{"text":"ኢታተፈ ሃክያ አስ ቆሆስ አድ እመቴስ፤","poem":2},{"lineBreak":true},{"text":"ጎዳይ ሱረ ፕርድ ባይናይሳ በእድ አዛንስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኡንኤተይሳታ ማድያ አስነ","poem":1},{"text":"ኤንታዉ ጋናትያ አስ ባይናይሳ","poem":2},{"lineBreak":true},{"text":"ጎዳይ በእድ ማላለትስ።","poem":2},{"text":"ሄሳ ግሾ፥ እያ ቀሰይ እያዉ አቶተ ኤህስ፤","poem":1},{"text":"እያ ፅሎተይ እያ ካትስድ ኦይክስ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እ፥ ፅሎተ ትራን ዎያ ኦላ ሚሸዳ ማእስ፤","poem":1},{"text":"ባ ሁጵያን አቶተ ባርኔፃ ዎስ፤","poem":2},{"lineBreak":true},{"text":"ሀሎ ከስ ማኦዳ፥ ሀንቆ አፍላዳ ማእስ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እ ኤንታዉ ኤንታ ኦሱዋዳ ኦሱዋዳ ዛራና፤","poem":1},{"text":"ሀንቁዋ ባ ሞርከታስ፥","poem":2},{"lineBreak":true},{"text":"ሴራ ባራ ኤቀተይሳታስ ጭጋና፤","poem":2},{"lineBreak":true},{"text":"ዩሾይ አባን ተቀትዳ ቢታታስ ኤንታ ኦሱዋዳ እማና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ጎዳ ፔኖይ ዎልቃማ ጎተዳ ድእሸ ያና ግሾ፥","poem":1},{"text":"ዉሎሀ ባጋን ደኤይሳት ጎዳ ሱንስ ያያና፤","poem":2},{"lineBreak":true},{"text":"ዶሎሀ ባጋን ደኤይሳት እያ ቦንቻና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“ፅዮነስነ ያይቆባ ዘረ ግዶን","poem":1},{"text":"ባንታ ናጋራፐ ስመይሳታ ዎዘይስ ያና።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ታዉ ኤንታራ ደእያ ጫቆይ ሀይሳ፦","poem":1},{"text":"ህንተ ቦላ ደእያ ታ አያናይነ","poem":2},{"lineBreak":true},{"text":"ታኒ ህንተ ዶናን ዎዳ ታ ቃላይ፥","poem":2},{"lineBreak":true},{"text":"ሀችፈ ዶምድ፥ መርና ጋካናዉ፥","poem":2},{"lineBreak":true},{"text":"ህንተ ዶናፐ፥ ህንተ ናይታ ዶናፐነ","poem":2},{"lineBreak":true},{"text":"ህንተ ናይታ ናይታ ዶናፐ ሻከተና”","poem":2},"ያጌስ ጎዳይ።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/58.json","previousChapterAudioLinks":{},"numberOfVerses":21}