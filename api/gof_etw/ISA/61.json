{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_etw","name":"እሳያሳ ማፃፋ","commonName":"እሳያሳ ማፃፋ","title":"እሳያሳ ማፃፋ","order":23,"numberOfChapters":66,"sha256":"4ab89101f9b620becbbf3e12322e1f109302962dc48ac0ae8b6da090f19837b1","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":61,"content":[{"type":"heading","content":["አቶተ ምሽራቾ"]},{"type":"verse","number":1,"content":[{"text":"ኡባ ሃርያ ጎዳ አያናይ ታ ቦላ ደኤስ፤","poem":1},{"text":"ማንቆታስ ሎኦባ ኦዳና መላ ጎዳይ ታና ትይስ።","poem":2},{"text":"ዎዛን መቅዳይሳታ ኮላና መላ፥","poem":1},{"text":"ድኤትዳይሳታ ላአ ከሳና መላነ","poem":2},{"lineBreak":true},{"text":"ቃሸትዳይሳታ ብላና መላ ጎዳይ ታና ኪትስ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዶሰትዳ ጎዳ ላይ ኦዳና መላ፥","poem":1},{"text":"ኑ ፆሳይ ሀሎ ከያና ጋላሳ አዋጃና መላ፥","poem":2},{"lineBreak":true},{"text":"አዛነይሳታ ኡባ ምንና መላ ታና ኪትስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ፅዮነን ካዮተይሳታስ፥ ብዶ ግሾ ካላቻ፥","poem":1},{"text":"ዬሆ ግሾ ኡፋይሳ ዛይተ፥","poem":2},{"lineBreak":true},{"text":"አዛኖ ግሾ ጋላታ ማኦ እማና መላ ታና ኪትስ።","poem":2},{"text":"ኤንቲ ጎዳይ ባ ቦንቹዋስ","poem":1},{"text":"ቶክዳ ፅሎ ም ጌተትድ ፄገታና።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኤንቲ በን ላለትዳ በሳታ ዛሪድ ኬፃና፤","poem":1},{"text":"በን ኩንድዳ በሳታ ዛሪድ ኤሳና።","poem":2},{"text":"ኤንቲ ዳሮ የለተፈ ካሰ ላለትድ","poem":1},{"text":"ኦንዳ ካታማታ ዛሪድ ኬፃና።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አላጋ አሳት ህንተ ዶርሳ ዉድያ ሄማና፤","poem":1},{"text":"እማት ህንተ ጋድያ ጎያና","poem":2},{"lineBreak":true},{"text":"ኤንቲ ህንተ ዎይነ ጋድያ ናጋና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አሳይ ህንተና፥ “ጎዳ ካህነታነ","poem":1},{"text":"ኑ ፆሳ ኦሳንቾታ” ያግድ ፄጋና።","poem":2},{"text":"ህንተ ካዎተታ ዱረተ ማና፤","poem":1},{"text":"ኤንታ ሻሉዋን ህንተ ናሸታና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ታ አሳይ ባንታ ዬላ ግሾ ናምኡ ኩሸ ኤካና፤","poem":1},{"text":"ባንታ ካዉሻ ግሾ ላታን ኡፋይታና።","poem":2},{"text":"ሄሳ ግሾ፥ ህንተ ኤንታ ቢታን ዳኮ ላታና፤","poem":1},{"text":"ህንተ ኡፋይሳይ መርና ኡፋይስ ግዳና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ታኒ፥ ጎዳይ ሱረ ፕርዳ ዶሳይስ፤","poem":1},{"text":"ቦንቀነ ኢታ ኦሶ እፃይስ።","poem":2},{"text":"ታኒ ቱማ ኤንታ ኦሱዋ ጋትያ ቃንፃና፤","poem":1},{"text":"ታኒ ኤንታራ መርናዉ ጫቃና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኤንታ ኮቻት ካዎተታ ግዶን፥","poem":1},{"text":"ኤንታ ናይት ደረታ ግዶን ኤረታና፤","poem":2},{"lineBreak":true},{"text":"ኤንታ በእዳ ኡባይ ታኒ፥ ጎዳይ፥","poem":2},{"lineBreak":true},{"text":"ኤንታ አንጅዳ አስ ግደይሳ ኤራና።”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ታኒ ጎዳን ዳሮ ኡፋይታይስ፤","poem":1},{"text":"ታ ሸምፕያ ታ ፆሳን ሀሹ ጋዉሱ።","poem":2},{"text":"ኤከይስ ባ ሁጰን ካላቻ ዎይሳዳ፥","poem":1},{"text":"ገልያራ ባና አሌቅሰይሳዳ፥","poem":2},{"text":"እ ታና አቶተ ማኦ ማይዝስ፤","poem":1},{"text":"ፅሎተ አፍላ ቦላራ ጉጅስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ቢታፈ ም ማት ዶለይሳዳ፥","poem":1},{"text":"ጋደይ ቶክዳባ ድቸይሳዳ፥","poem":2},{"text":"ኡባ ሃርያ ጎዳይ ፅሎተነ","poem":1},{"text":"ጋላታ ካዎተ ኡባ ስንን ፑርጭሳና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/60.json","previousChapterAudioLinks":{},"numberOfVerses":11}