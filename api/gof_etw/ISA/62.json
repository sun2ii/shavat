{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_etw","name":"እሳያሳ ማፃፋ","commonName":"እሳያሳ ማፃፋ","title":"እሳያሳ ማፃፋ","order":23,"numberOfChapters":66,"sha256":"4ab89101f9b620becbbf3e12322e1f109302962dc48ac0ae8b6da090f19837b1","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":62,"content":[{"type":"heading","content":["ፅዮነ ኦራ ሱን"]},{"type":"verse","number":1,"content":[{"text":"ፅዮነ ግሾ፥ ታኒ ስእ ጊከ፤","poem":1},{"text":"የሩሳላመ ፅሎተይ ፖኦዳ፥","poem":2},{"text":"እ አቶተይ ዎንታ ፃልቀዳ ከያና ጋካናዉ","poem":1},{"text":"ታኒ ስእ ጊከ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ካዎተት ነ ፅሎተ፥","poem":1},{"text":"ካዎት ኡባይ ነ ቦንቹዋ በአና።","poem":2},{"text":"ጎዳይ ሱንያ ኦራ ሱንን","poem":1},{"text":"ኔኒ ፄገታና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኔኒ ጎዳ ኩሸን ሎእዳ","poem":1},{"text":"ካዎተ ካላቻ ግዳና።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኔኒ፥ “ዶገትዳሮ” ጌተታካ፤","poem":1},{"text":"ነ ቢትያ፥ “ን” ጌተቱኩ።","poem":2},{"text":"ሽን ኔኒ፥ “ታ ኡፋይሳይ እን ደእያሮ”፥","poem":1},{"text":"ነ ቢትያ፥ “አዝና ገልዳሮ” ጌተታና።","poem":2},{"text":"ጎዳይ ነናን ኡፋይታና፤","poem":1},{"text":"ነ ቢትያካ አዝን ደእያሮ ግዳና።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ፓን ጌላኦ ኤከይሳዳ፥","poem":1},{"text":"ነ ናይት ነና ማቻና።","poem":2},{"text":"ኤከይስ ገልያርን ኡፋይተይሳዳ፥","poem":1},{"text":"ነ ፆሳይ ነናን ኡፋይታና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ነኖ የሩሳላመ፥ ነ ድርሳ ግምብያ ቦላ","poem":1},{"text":"ዎቸይሳታ ታኒ ዎስ፤","poem":2},{"lineBreak":true},{"text":"ኤንቲ ጋላስነ ቃማ ስእ ጎኮና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ህንተኖ፥ ጎዳ ቆፍሰይሳቶ፥","poem":1},{"text":"እ፥ የሩሳላመ ኬፃና ጋካናዉነ","poem":2},{"lineBreak":true},{"text":"ቢታ ኡባን ናሸትዳ ካታማ ኦና ጋካናዉ","poem":2},{"lineBreak":true},{"text":"ህንተካ ሸምፖፕተ፤ እያካ ሸምፕሶፕተ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ጎዳይ ባ ኡሻቻ ኩሽያንነ","poem":1},{"text":"ባ ዎልቃማ ቀስያን ሀይሳዳ ያግድ ጫቅስ፦","poem":2},{"text":"“ታኒ ናምአን ህንተ ካ","poem":1},{"text":"ህንተ ሞርከት ማና መላ ኦከ።","poem":2},{"text":"ህንተ ዳቡርዳ ህንተ ዎይነ ኡሻ","poem":1},{"text":"አላጋት ኡዮኮና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሽን ባንታ ካ ጫክዳይሳት","poem":1},{"text":"ምድ ጎዳ ጋላታና፤","poem":2},{"lineBreak":true},{"text":"ዎይነ ማፀይሳት ታ ኬ ዳባባን ኡያና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አተ! ፐንገራ ከይድ ቢተ!","poem":1},{"text":"አሳስ ኦገ ጊግስተ! ዎጋ ኦገ ከስተ።","poem":2},{"text":"ሹቻ ድግተ፤","poem":1},{"text":"ካዎተት ኦግያ ደማና መላ ማላ ኤስተ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጎዳይ ሳአ ጋፃስ","poem":1},{"text":"ሀይሳዳ ያግድ አዋጅስ:","poem":2},{"text":"‘ፅዮነ አሳስ ሀይሳዳ ያግተ፤","poem":1},{"text":"ሄኮ፥ ህንተና አሸይስ ጋክስ!","poem":2},{"text":"እያ ጋተይ እያራ ደኤስ፤","poem":1},{"text":"እ እምያ ዎይቶይ እያ ስንን ደኤስ’","poem":2},"ያግተ።"]},{"type":"verse","number":12,"content":[{"text":"ህንተ፥ ‘ጎዳይ ዎዝዳ ጌሻ አሳታ’","poem":1},{"text":"ጌተትድ ፄገታና።","poem":2},{"text":"የሩሳላመይ፥ ‘ኮየትያሮነ","poem":1},{"text":"የገታ አታቦና ካታምዉ’ ” ጌተታና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}