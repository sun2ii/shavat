{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_etw","name":"እሳያሳ ማፃፋ","commonName":"እሳያሳ ማፃፋ","title":"እሳያሳ ማፃፋ","order":23,"numberOfChapters":66,"sha256":"4ab89101f9b620becbbf3e12322e1f109302962dc48ac0ae8b6da090f19837b1","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":64,"content":[{"type":"verse","number":1,"content":["አቤት ጎዳዉ፥ ሳሎታ ዳካዳ ዱገ ዎ፤",{"text":"ደረት ነ ስንን ኮኮሮ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታም ኤፅድ ሃ ፐንትሰይሳዳ ዱገ ዎዳ፥","poem":1},{"text":"ነ ሱን ነ ሞርከታ ኤርሳ፤","poem":2},{"lineBreak":true},{"text":"ካዎተታካ ነ ስንን ኮኮርሳ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ካሰ ኑኒ ናግቦና ማላታታ","poem":1},{"text":"ኔኒ ኦዳ ዎደ ዎዳሳ፤","poem":2},{"lineBreak":true},{"text":"ደረት ነ ስንን ኮኮርዶሶና።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"በንፐ ዶምድ፥ ነና አማነትድ፥","poem":1},{"text":"ናገይሳታስ ማላታታ ኦዳይ ኔፐ አትሽን፥","poem":2},{"lineBreak":true},{"text":"ሀራ ፆሲ፥ አሳ ሀይ ስእቤና፤","poem":2},{"lineBreak":true},{"text":"አሳ አይፈይ በእቤና።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኡፋይትድ ፅሎተ ኦይሳታነ","poem":1},{"text":"ነ ኦግያ ቆፐይሳታ ኔኒ ማዳዳሳ።","poem":2},{"text":"ሽን ኑኒ ናጋራ ኦሶ አጎና እፅዳ ዎደ","poem":1},{"text":"ኔኒ ሀንቀታዳሳ፤ ኑኒ ዋንድ አታኔ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኑኒ ኡባይ ቱና አስ ግድዳ፤","poem":1},{"text":"ኑ ፅሎተ ኦሶ ኡባይ ቱና ጩርቃ መላ።","poem":2},{"text":"ኑ ኡባይ ቦንጮዳ ቆለትዳ፤","poem":1},{"text":"ኑ ናጋራይ ኑና ጫርኮዳ ፕትድ ኤፍስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኔኒ ነ ስን ኑፐ ገንዳሳ፤","poem":1},{"text":"ኑ ናጋራይ ኑና ይሳና መላ አጋዳሳ።","poem":2},{"text":"ነ ሱን ፄገይ ዴና፤","poem":1},{"text":"ነና ምንድ ኦይካናዉ ኮየይ ባዋ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ግዶሽን፥ አቤት ጎዳዉ፥ ኔኒ ኑ አዋ፤","poem":1},{"text":"ኑኒ ኡርቃ፤ ነ ኡርቃ መዳሳ፤","poem":2},{"lineBreak":true},{"text":"ኑኒ ኡባይ ነ ኩሸን መትዳ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አቤት ጎዳዉ፥ ዳሮ ሀንቀቶፋ፤","poem":1},{"text":"ኑ ናጋራ መርናዉ ቆፖፋ።","poem":2},{"text":"ኑኒ ኡባይ ነ አሰ ግድያ ግሾ፥","poem":1},{"text":"ኑና በአ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ነ ጌሻ ካታማት መላ ቢታ ግድዶሶና፤","poem":1},{"text":"ፅዮነ ካታማይ መላ ቢታ፥","poem":2},{"lineBreak":true},{"text":"የሩሳላመይ ባይሳ ግድስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኑ አዋት እያን ነና ጋላትዳ ጌሽነ","poem":1},{"text":"ሎኦ ግድዳ ኑ ፆሳ ኬይ ታማን ፁገትስ፤","poem":2},{"lineBreak":true},{"text":"ኑ ሎኦ በሳ ኡባይ ላለትስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አቤት ጎዳዉ፥ ኔኒ ሀይሳ ኡባ በአሸ ስእ ጋኔ?","poem":1},{"text":"ሀ ኡባይ ሀንን፥ ኑኮ ስምኪ?","poem":2},{"lineBreak":true},{"text":"ኔኒ ስእ ጋዳ ዛው ባይና ሴራኔ?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/63.json","previousChapterAudioLinks":{},"numberOfVerses":12}