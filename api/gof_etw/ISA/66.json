{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_etw","name":"እሳያሳ ማፃፋ","commonName":"እሳያሳ ማፃፋ","title":"እሳያሳ ማፃፋ","order":23,"numberOfChapters":66,"sha256":"4ab89101f9b620becbbf3e12322e1f109302962dc48ac0ae8b6da090f19837b1","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_etw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":66,"content":[{"type":"heading","content":["ፕርዳነ ኡፋይስ"]},{"type":"verse","number":1,"content":[{"text":"ጎዳይ ያጌስ፤","poem":1},{"text":"ሳሎይ ታ አራታ፥","poem":2},{"lineBreak":true},{"text":"ሳእ ታ ቶሆይ የያ በሰ።","poem":2},{"text":"ያትን ህንተ ታዉ ኬፅያ ኬይ፥","poem":1},{"text":"አይ መላ ኬ?","poem":2},{"lineBreak":true},{"text":"ታ ሸምፓና በሳይ አዉሴ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሀይሳ ኡባ ታ ኩሸይ ኦስ፤","poem":1},{"text":"ኤንትካ ሀንዶሶና።","poem":2},{"text":"ሽን ታኒ ባና ዝቅ ኦያ ኡራ፥","poem":1},{"text":"ባ አያናን መቅዳ ኡራነ","poem":2},{"lineBreak":true},{"text":"ታ ቃላን ኮኮርያ ኡራ ፄላና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኮርማ ያርሸይ አሰ ዎያ አሳ መላ፤","poem":1},{"text":"ኡርገ ዶርስ ያርሸይ ካና ያርሽያ አሳ መላ፤","poem":2},{"lineBreak":true},{"text":"ካ ያርሾ ያርሸይ፥","poem":2},{"lineBreak":true},{"text":"ጉዱን ሱ ያርሽያ አሳ መላ፤","poem":2},{"lineBreak":true},{"text":"ቆፍሶ እፃነ ጩይሰይ ኤቃ ጎይንያ አሳ መላ።","poem":2},{"text":"አሳ ኡባይ ባዉ እንጀትያ ኦገ ዶርዶሶና፤","poem":1},{"text":"ኤንታ ሸምፖይ ኤንታ ቱናተን ኡፋይቴስ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሄሳ ግሾ፥ ታኒ ኤንታ መቶስ አ እማና፤","poem":1},{"text":"ኤንቲ ያይዳባ ኤንታ ቦላ ኤሀና።","poem":2},{"text":"ታኒ ፄግዳ ዎደ ኦንካ ኮይቤና፤","poem":1},{"text":"ታኒ ኦድያ ዎደ ኦንካ ስእቤና።","poem":2},{"text":"ኤንቲ ታ ስንን ኢታባ ኦዶሶና፤","poem":1},{"text":"ታና ኡፋይሶናባ ዶርዶሶና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ህንተኖ፥ ጎዳ ቃላስ ኮኮረይሳቶ","poem":1},{"text":"እያ ቃላ ስእተ፦","poem":2},{"text":"“ህንተና እፅያ ህንተ እሻት፥ ታ ሱን ግሾ፥","poem":1},{"text":"ህንተና ኩረይሳት፥ ‘ህንተ ኡፋይትን ኑኒ በአና መላ","poem":2},{"lineBreak":true},{"text":"አነ ጎዳይ ቦንቸቶ’ ” ያግዶሶና፤","poem":2},{"lineBreak":true},{"text":"ሽን ኤንቲ ዬላታና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ካታማፐ ያ ዋሱዋ ስእተ፤","poem":1},{"text":"ፆሳ ኬፈ ከይያ ግርሳ ስእተ።","poem":2},{"text":"ሄ ግርሳይ ባ ሞርከታስ ኤንታ ኦሱዋዳ","poem":1},{"text":"ኩሸ ዛርያ ጎዳ ግርሳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“እቀቶና ናአ የልያ ማጫስ ደኢ?","poem":1},{"text":"ባናኮና አደ ናአ የልያ ማጫስ ደኢ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሀይሳ መላባ ኦነ ስእዳይ?","poem":1},{"text":"ሄሳ መላባ ኦነ በእዳይ?","poem":2},{"text":"እስ ደረይ እስ ጋላስ የለታናዉ ዳንዳእዬ?","poem":1},{"text":"እስ ካዎተ ቅጵ ዛሮን መትዬ?","poem":2},{"text":"ፅዮነይ ቡሮ እቀ ኦይኮና፥","poem":1},{"text":"ኤለሳዳ ባ ናይታ የላሱ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"የላና ዎደ ጋያ ታኒ","poem":1},{"text":"ኤንቲ የላናዳ ኦክናዬ?","poem":2},{"text":"የላናዳ ኦያ ታኒ","poem":1},{"text":"የልያ ኡሎ ጎርዳይናዬ?","poem":2},{"lineBreak":true},{"text":"ሀይሳ ግዳይ ታና፥ ጎዳ፥ ነ ፆሳ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ህንተኖ የሩሳላሞ ዶስያ ኡባዉ፥ ኢራ ኡፋይትተ፤","poem":1},{"text":"እ ግሾ ኡፋይሳን ኖጩ ጊተ።","poem":2},{"text":"ህንተኖ እዉ ዬክያ ኡባዉ፥","poem":1},{"text":"ኢራ ኡፋይትተ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ህንተ፥ እያ ምንያ ን ምድ ካላና፤","poem":1},{"text":"እ ዳሮ ቦንቹዋፈ ሎይ ኡይድ፥ ኡፋይታና።”","poem":2}]},{"type":"verse","number":12,"content":["ጎዳይ ያጌስ፤",{"text":"“ታኒ እዉ ሳሮተ ሻፋዳ ዳርሳና፤","poem":1},{"text":"እዉ ካዎተታ ዱረተ ክፃ ሻፋዳ ኤሀና።","poem":2},{"text":"ህንተ ሄሳ ማና፤ እ ሀሽያን ቶከታና፤","poem":1},{"text":"እ ክኦን ኡትድ ባሎታና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አይያ ባ ናአ ምንይሳዳ","poem":1},{"text":"ታኒ ህንተና ምንና፤","poem":2},{"lineBreak":true},{"text":"ህንተ የሩሳላመን ምነታና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሄሳ ህንተ በእያ ዎደ ህንተ ዎዛናይ ኡፋይታና፤","poem":1},{"text":"ህንተ መቀይ ማታ መላ አጫና።","poem":2},{"text":"ጎዳ ኩሸይ እያ አይለታ ቦላ ደኤይስን","poem":1},{"text":"እያ ሀንቆይ እያ ሞርከታ ቦላ ደኤይስ ኤረታና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሄኮ፥ ጎዳይ ታማራ ያና፤","poem":1},{"text":"እያ ፓራ ጋረት ጎተ መላ።","poem":2},{"text":"ባ ሸንያ ሀንቆን፤","poem":1},{"text":"ባ ሴራካ ታማ ላጮን ቆንጭሴስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ጎዳይ አሾ ማእዳ ኡባ","poem":1},{"text":"ታማንነ ማሻን ፕርዳና፤","poem":2},{"lineBreak":true},{"text":"ዳሮት ጎዳ ማሻን ሀይቃና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“ባንታ ኤቃ ጎይናናዉ አታክልተ ጋደ ባናዉ፥","poem":1},{"text":"ባንታና ዱማየይሳትነ ጌሸይሳት፤","poem":2},{"lineBreak":true},{"text":"ጉዱን፥ ኤጨረነ ሀራ ቱናባታ መይሳታ ግዶፈ","poem":2},{"lineBreak":true},{"text":"እሱዋ ካልድ በይሳት ኡባይ ያና።","poem":2}]},{"type":"verse","number":18,"content":["“ታኒ ኤንታ ኦሱዋነ ኤንታ ቆፋ ኤርያ ግሾ፥",{"text":"ካዎተታነ ዱማ ዱማ ዶናን ኦደተይሳታ፥","poem":2},{"lineBreak":true},{"text":"እስፈ ሺሻና፤ ኤንቲ ሺቅድ፥ ታ ቦንቹዋ በአና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ታኒ ኤንታ ግዶን ማላታ ኦና፤","poem":1},{"text":"ኤንታፈ አትዳይሳታ ግዶፈ","poem":2},{"lineBreak":true},{"text":"ታ ግታተ ስእቦናነ","poem":2},{"lineBreak":true},{"text":"ታ ቦንቹዋ በእቦና ካዎተታኮ፥","poem":2},{"text":"ታርሰሳኮ፥ ሊበኮ፥ ሊደኮ፥ ቱባላኮ፥","poem":1},{"text":"ያዋናኮነ ዩሾይ አባን ተቀትድ ሃሆ ቢታታኮ ኪታና፤","poem":2},{"lineBreak":true},{"text":"ኤንቲ ታ ቦንቹዋ ካዎተታ ግዶን አዋጃና።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እስራኤለ አሳይ ካ ያርሹዋ","poem":1},{"text":"ጌሻ ሚሸን ዎድ ፆሳ ኬ ኤሄይሳዳ፥","poem":2},{"lineBreak":true},{"text":"ኤንቲ ህንተ እሻታ ኡባ ካዎተታ ግዶፈ፥","poem":2},{"lineBreak":true},{"text":"ፓራታን፥ ፓራ ጋረታን፥ ግማለታን፥ ባቁሎታንነ","poem":2},{"lineBreak":true},{"text":"ጫነ ጋረታን ኡትስድ፥ ጎዳስ እሞ ኦድ","poem":2},{"lineBreak":true},{"text":"ታ ጌሻ ዙማ ቦላ የሩሳላመ ኤሀና።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ኤንታፈ እሶታ እሶታ ካህነነ ሌወ ኦና”","poem":1},"ያጌስ ጎዳይ።"]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“ታኒ መዳ ኦራ ሳሎትነ","poem":1},{"text":"ኦራ ሳእ ታ ስንን ምንድ ደኤይሳዳ፥","poem":2},{"lineBreak":true},{"text":"ህንተ ኮቻይነ ህንተ ሱንይ ምንድ ዳና።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"አጌና ፄሮፐ ብድ አጌና ፄሮ ጋካናዉ፥","poem":1},{"text":"ሳምባታፐ ብድ ሳምባታ ጋካናዉ","poem":2},{"lineBreak":true},{"text":"አሳ ኡባይ ታ ስንን ጎይናናዉ ያና።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ኤንቲ ከይድ ብሸ፥","poem":1},{"text":"ታ ቦላ ማካልዳ አሳ አሀ በአና።","poem":2},{"text":"ኤንታ ምያ ጉፁነይ ሀይቀና፤","poem":1},{"text":"ኤንታ ፁግያ ታማይ ቶኤና፤","poem":2},{"lineBreak":true},{"text":"ኤንቲ አሳ ኡባስ ሻትያባ ግዳና”","poem":2},"ያጌስ ጎዳይ።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ISA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JER/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ISA/65.json","previousChapterAudioLinks":{},"numberOfVerses":24}