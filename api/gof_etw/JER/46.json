},{"text":"ኑ አሳኮ፥ ኑ ቢታ ስሞስ” ያጎሶና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ኤንቲ ያን ግብፀ ካዋኮ፥","poem":1},{"text":"“ባ ቃዳ ጎኤቶና ጮ ዉርስያ ኦዳንቾ” ግድ ሱንና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“ኡባፈ ዎልቃማ ጎዳ” ጌተትያ","poem":1},{"text":"ካዎይ ሀይሳዳ ያጌስ፦","poem":2},{"text":"“ታኒ፥ ታ ሸምፑዋን ጫቃይስ፤","poem":1},{"text":"ደረታ ግዶን ታቦረ ደረይ፥","poem":2},{"lineBreak":true},{"text":"አባ ማታን ደእያ ቃርመሎሳ ደረይ፥","poem":2},{"lineBreak":true},{"text":"አዱቀይሳዳ አዱቅያ ሞርከይ ህንተ ቦላ ያና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ህንተኖ፥ ግብፀን ደኤይሳቶ፥","poem":1},{"text":"ድኤትድ ባናዉ ጊግተ።","poem":2},{"text":"መምፕሳ ካታማይ ላለትድ፥","poem":1},{"text":"ኦንካ ደኦና መላ ቢታ ግዳና።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ግብፀይ ሎኦ ኡሳ መላ፤","poem":1},{"text":"ሽን ፑደሀ ባጋ ቢታፈ ያ","poem":2},{"lineBreak":true},{"text":"ቦፅያን እያ ሳፀታና።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሚሸይ ጭገትን ኦያ ኦላንቾት","poem":1},{"text":"ሞዳ ዎፋኖ መላ።","poem":2},{"text":"ኤንታ ዮ ጋላሳይ ማትዳ ግሾ፥","poem":1},{"text":"ኤንቲ ሴረትያ ዎደይ ጋክዳ ግሾ፥","poem":2},{"lineBreak":true},{"text":"ኤንቲ እስፈ ጉየ ስሚድ ባቃትዶሶና፤","poem":2},{"lineBreak":true},{"text":"ኤንቲ ባንታ በሳን ኤቅቦኮና።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ሞርከይ ዎልቃን ሱግድ ያ ዎደ፥","poem":1},{"text":"ግብፀ አሳይ ባቃትያ ሾሻዳ ኮልፃና።","poem":2},{"text":"ሞርከት ም ቃንፅያ አሳዳ፥","poem":1},{"text":"ካልታ ኤክድ እያ ቦላ ያና።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"አሳይ ስፅዳ ዎራ ቄፅድ ይሰይሳዳ፥","poem":1},{"text":"ግብፀ አሳ ቃንፅድ ዉርሳና","poem":2},{"text":"ሞርከታ ታይቦይ ቦለፐ ዳሮ፤","poem":1},{"text":"ኤንታ ታይባናዉ ዳንዳኤተና።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ግብፀ ማጫ ናእያ ካዉያና፤","poem":1},{"text":"ፑደሀ ባጋ አሳስ አዳ እመታና።”","poem":2}]},{"type":"verse","number":25,"content":["ኡባፈ ዎልቃማ ጎዳይ፥ እስራኤለ ፆሳይ ሀይሳዳ ያጌስ። “ታኒ ተብሳ ፆሳ አሞነ፥ ካዋ ፓሮና፥ ግብፀ ቢታነ ግብፀ ፆሳታ፥ ግብፀ ካዎታነ ካዋ ፓሮና ቦላ ዘምፕያ ኡባ ሴራና።"]},{"type":"verse","number":26,"content":["ኤንታ ሸምፑዋ ኮይያ ባብሎነ ካዋ ናቡካዳናፆራ ኩሸንነ እያ ኦላንቾታ ኩሸን አዳ እማና። ሄሳፈ ጉየ፥ ግብፀ ቢታይ ካሰይሳዳ አስ ደእያ ቢታ ግዳና” ያጌስ ጎዳይ።"]},{"type":"verse","number":27,"content":["“ታ አይልያዉ፥ ያይቆባ ያዮፋ፤",{"text":"እስራኤለ፥ ዳጋሞፋ።","poem":2},{"text":"ነና ሃሆ በሳፈ፥","poem":1},{"text":"ነ ኮቻይ ድኤትድ ብዳ ቢታፈ አሻና።","poem":2},{"text":"ያይቆብ ስሚድ፥ ሳሮን ዎፑ ግድ ዳና፤","poem":1},{"text":"ኤንታ ያሽስያባይ ዴና።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ታ አይልያዉ፥ ያይቆባ፥","poem":1},{"text":"ታ ኔራ ደእያ ግሾ፥ ያዮፋ።","poem":2},{"text":"ታ ነና ላልዳ ካዎተታ ኡባ ይሳና፤","poem":1},{"text":"ሽን ነና ይስከ።","poem":2},{"text":"ታ ነና ፅሎ ፕርዳን ሴራና፤","poem":1},{"text":"ሽን ሴር ባይና ነና ጮ አግከ” ያጌስ ጎዳይ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JER/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JER/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JER/45.json","previousChapterAudioLinks":{},"numberOfVerses":28}