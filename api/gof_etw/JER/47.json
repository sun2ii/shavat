m":1},{"text":"አስቃሎን ባ ኩሽያ ዶና ቦላ ዎሱ።","poem":2},{"text":"ህንተኖ፥ አባ ጋፃን አትዳይሳቶ፥","poem":1},{"text":"አዉደ ጋካናዉ ህንተ አሳተ ጋረቲ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ህንተ፥ ‘ጎዳ ማሻዉ፥ ኔኒ ስእ ጎና እፀይ አዉደሴ?","poem":1},{"text":"ነ በሳ ስማዳ ገላ፤","poem":2},{"lineBreak":true},{"text":"ስእ ጋዳ ኡታ’ ያጌታ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሽን ጎዳይ እያ ኪትን፥ እ ዋንድ ስእ ጋኔ?","poem":1},{"text":"አስቃሎናነ አባ ጋፃን ደእያ ቢታ","poem":2},{"lineBreak":true},{"text":"ኦላና መላ ኪታስ” ያግስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}