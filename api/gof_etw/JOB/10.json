{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"ታና ዱስ ሻትስ!","poem":1},{"text":"ሄሳ ግሾ፥ ታ ዙዙማናፐ አትሽን፥ ስእ ጊከ፤","poem":2},{"lineBreak":true},{"text":"ታ ሸምፑዋ ሴላ ከሳና።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታኒ ፆሳኮ ሀይሳዳ ጋና፤","poem":1},{"text":"ታ ባላ ታዉ ኦዳፐ አትሽን፥ ታ ቦላ ፕርዶፋ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኔኒ ኢታታ ቆፋ ኡፋይሳን ኤካሸ፥","poem":1},{"text":"ታና ኡንኤናዉ በሲ?","poem":2},{"lineBreak":true},{"text":"ነ ኩሸን መዳ ኡራ ካይስ ዎጌ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ነ አይፈይ አሳ አይፈ መለዬ?","poem":1},{"text":"ኔኒ አስ ፄለይሳዳ ፄላዬ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ነ ደኦ ላይይ አሳ ደኦ ላይ መለዬ?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ያትን፥ ታ ባላ አይስ ኮያይ?","poem":1},{"text":"ታ ናጋራ አይስ ካላይ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታኒ ባላ ግዶናይሳነ","poem":1},{"text":"ነ ኩሸፐ ታና ኦንካ አሻናዉ ዳንዳኦናይሳ ነ ኤራሳ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታና ነ ኩሸይ ጊግስድ መስ፤","poem":1},{"text":"ሽን ሀእ ሄ ኩሸይ ስሚድ ታና መንስ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኔኒ ታና ቢታፈ መዳይሳ ሀሳያ","poem":1},{"text":"ያትን፥ ሀእ ታና ዛራዳ ባና ኦናዉ ኮያይ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታና ማዳ ታ አየ ኡሎን ትግዳይነ","poem":1},{"text":"መቃ ማዳ እርክስዳይ ነና ግድኪ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኔኒ ታና አሾነ ጎጋ ማይዛዳሳ፤","poem":1},{"text":"ሻያንነ መቀን ዋፃዳሳ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኔኒ ታዉ ደኦነ መርና ሲቆ እማዳሳ፤","poem":1},{"text":"ነ ናጎይ ታና ፓፃ ዎስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሽን ኔኒ ሄ ዎደፐ ዶማዳ ነ ዎዛናን","poem":1},{"text":"ታና ቆሀናዉ ቆፓዳ ደኤይሳ ታ ኤራይስ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ታ ናቁዋ ነ በኣሳ፤","poem":1},{"text":"ታ ናጋራ ኦኮ ሴሮና አካ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ታኒ ባልኮካ ታና አየ!","poem":1},{"text":"ታ ፅሎ ግድኮካ ጬቀታናዉ ዳንዳእከ።","poem":2},{"text":"ነ ታና ዬላ ማይዛዳሳ፤","poem":1},{"text":"ዋየን ዎዳሳ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ታ ኦቶርኮ ታና ጋሞዳ ሻንካታዳ ኦይካሳ፤","poem":1},{"text":"ታና ቆሀናዉ ነ ማላልስያ ዎልቃ ዛራ ዛራ በሳሳ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ኔኒ ታ ቦላ ኦራ ማርካታ ኤሃሳ፤","poem":1},{"text":"ነ ሀንቁዋ ታ ቦላ ዳርሳሳ፤","poem":2},{"lineBreak":true},{"text":"ታና ኦላናዉ ኦራ ኦላንቾታ ጊግሳሳ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ያትን፥ ታና ታ አየ ኡሎፐ አይስ ከሳዲ?","poem":1},{"text":"ኦንካ ታና በኦና ሀይቅዳኮ ታው ሎኦሽን!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ታኒ መቶና አትዳኮ፥","poem":1},{"text":"ዎይኮ ታ አየ ኡሎፐ ከያሸ ዱፎ ገልዳኮ ሎኦሽን!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ታ ጉ ደኦ ላይይ ዉሬስ ግደነዬ?","poem":1},{"text":"ሀ ጉ ላይን ኡፋይታና መላ ታና አጋርክ!","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ታ ስሞና በሳ ቦና ደእሽን፥","poem":1},{"text":"ሌልዳ ማ ቢታ ጋኮና ደእሽን፥","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"እያ ፖኦይ ማ ግድዳ በሳነ ሀይቆይ ካዎትዳ በሳ፥","poem":2},{"lineBreak":true},{"text":"ማር ባይና በሳነ ሌልዳ ማ ቢታ ቦና ደእሽን፥","poem":2},{"lineBreak":true},{"text":"ታና አጋርክ!”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/9.json","previousChapterAudioLinks":{},"numberOfVerses":22}