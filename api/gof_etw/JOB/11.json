{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":11,"content":[{"type":"heading","content":["ሶፋራ ሃሳያ"]},{"type":"verse","number":1,"content":["ናእማ ቢታፈ ይዳ ሶፋር ዛሪድ፥"]},{"type":"verse","number":2,"content":[{"text":"“ሀ ሀዳ ሃሳያ ኡባስ ዛሮ እምያ አስ ባዌ?","poem":1},{"text":"ዎይኮ ሄሳ ኦድዳ ኡራይ ቱማ ግዳናዉ ዳንዳኢ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ነ ሀዳ ኦዳይ አሰ ስእ ኦያ ዳኒ?","poem":1},{"text":"ነ ቀልቅስያ ዎደ ነና ሴርያ አስ ባዌ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኔኒ፥ ‘ታ ትምርተይ ቱማ፤","poem":1},{"text":"ታኒ ፆሳ ስንን ጌሽ’ ” ጋሳ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ፆሳይ ነዉ ኦድያኮ፥","poem":1},{"text":"ባ ዶና ዶይድ ኦደትያኮ አይበ!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ጭንጫተስ ዳሮ ኦገይ ደእያ ግሾ፥","poem":1},{"text":"ፆሳይ ነዉ ጭንጫተ ፁራ ቆንጭስያኮ አይበ!","poem":2},{"text":"ሄ ዎደ ነ ሴረትዳ ሴራይ፥","poem":1},{"text":"በሰይሳፈ ጉ ግደይሳ ኤራናሽን።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“ጪሞ ግድዳ ፆሳ ፁራ ኤራናዉ ዳንዳአይ?","poem":1},{"text":"ዎይኮ ኡባ ዳንዳእያ ፆሳባ ፕልጋዳ ጋካናዉ ዳንዳአይ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኤንቲ ሳሎታፐ ቃ፤ ነ አይ ኦናዉ ዳንዳአይ?","poem":1},{"text":"ኤንቲ ስኦለፐካ አዳ ጪሞ፤ ነ ኤራናዉ ዳንዳአካ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ፆሳ ጭንጫተይ ቢታፈ ዳልጌስ፤","poem":1},{"text":"አባፈካ አድ ጪሞቴስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እ ይድ ነና ቃሾ ኬን የግያኮ፥","poem":1},{"text":"ፕርዳ ኬ ሺሽኮ፥ እያ ድጋናይ ኦኔ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ፆሳይ ፓና አሳ ኤሬስ፤","poem":1},{"text":"ኢታባ በእያ ዎደ ስእ ግድ አገና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኤያ አስ ጭንጫ ግደይሳፈ፥","poem":1},{"text":"ዎራ ሀረይ አሰ ግድድ የለታናይስ ማታ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኔኒ ነ ዎዛና ሱረ ኦኮ፥","poem":1},{"text":"ነ ኩሽያ እያኮ ምጭኮ፥","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ናጋራ ነ ኩሸፐ ሃስኮ፥","poem":2},{"lineBreak":true},{"text":"ነ ኬን ኢታባይ ዶና መላ ኦኮ፥","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሄ ዎደ ኔኒ ቁ ጋዳ ዬል ባይና ኡባባ በአን፤","poem":1},{"text":"ያሽ ባይና ምናዳ ኤቃና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኔኒ ነ መቱዋ ኡባ ዶጋና፤","poem":1},{"text":"ጎግድ አዳ ድኦዳ ዛራ ሀሳያካ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ነ ደኦይ ሴታ ጋላሳ አዋፐ አድ ፖአና፤","poem":1},{"text":"ነ ደኡዋ ማይ ዎንታ ፃልቀዳ ፖአና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ነዉ ኡፋይስ ደእያ ግሾ ኔኒ ህርጎና ዳና፤","poem":1},{"text":"ፆሳይ ነና ናግያ ግሾ ዎፑ ጋዳ ዳና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ኔኒ ያሽ ባይና ስካና፤","poem":1},{"text":"ዳሮ አሳይ ነናን ናሸታናዉ ኮያና።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ሽን ኢታት መቶ በእሸ አኬኮኮና፤","poem":1},{"text":"እያፐ ባቃትድ አታናዉ ዳንዳኦኮና፤","poem":2},{"lineBreak":true},{"text":"ኤንታ ኡፋይሳይ ሀይቆ” ያግስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/10.json","previousChapterAudioLinks":{},"numberOfVerses":20}