{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":12,"content":[{"type":"heading","content":["እዮባ ሃሳያ"]},{"type":"verse","number":1,"content":["እዮብ ሀይሳዳ ያግድ ዛርስ።"]},{"type":"verse","number":2,"content":[{"text":"ኤ፥ ህንተ ቱማካ አሰ፤","poem":1},{"text":"ጭንጫተ ህንተራ ሀይቃና!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሽን ታካ ህንተዳ አኬክ ደእያ አስ፤","poem":1},{"text":"ታኒ ህንተፈ ጉፅከ፤","poem":2},{"lineBreak":true},{"text":"ሀ ህንተ ኦደትዳባ ኤሮናይ ኦኔ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታኒ ፆሳ ዎስን እ ታና ስእዳ አስ ግድኮካ፥","poem":1},{"text":"ሀእ ታ ላገታስ ሚቻስ አታስ፤","poem":2},{"lineBreak":true},{"text":"ታኒ ፅሎነ ቦረይ ባይና አስ ግድኮካ ቀልቅሰስ አታስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"መቶትድ በእቦና አስ ሀራ አሳ መቶን ሚጬስ፤","poem":1},{"text":"ህንተ ኩንዳናዉ ጋንድጋርያ አስ ሱጌታ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ቦንቀይሳታ ኬይ ሳሮ ደኤስ፤","poem":1},{"text":"ፆሳ ይሎየይሳት ህርግ ባይና ደኦሶና፤","poem":2},{"lineBreak":true},{"text":"ባንታ ዎልቃ ባንታዉ ፆሰ ኦሶና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"አነ መሄታ ኦይቻ፤ ኤንቲ ነና ታማርሳና፤","poem":1},{"text":"ዎይኮ ሳሎ ካፎታ ኦይቻ፤ ኤንቲ ነዉ ኦዳና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዎይኮ ሳአ መተታስ ኦዳ፤ ኤንቲ ነና ታማርሳና፤","poem":1},{"text":"አባ ሞሎትካ ነዉ ኦዳና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ጎዳ ኩሸይ ሄሳ ኦዳይሳ ኤሮናይ ኦኔ?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ደኦይ ደእያ መተ ኡባይነ","poem":1},{"text":"አሳ ሸምፖይ እያ ኩሸና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እንፃርስ ካ ሻክድ ኤረይሳዳ፥","poem":1},{"text":"ሀይ ኦዳ ሻክድ ኤረነዬ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ጭንጫተ ዶንዳ አሳ ማታን ደነዬ?","poem":1},{"text":"ዳሮ ላይ ደእዳ አሳ ማታን አኬክ በንተነዬ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ጭንጫተነ ዎልቅ ፆሳሳ፤","poem":1},{"text":"ዞረይነ አኬክ እያ ማታን በንቴስ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ፆሳይ ላልዳባ ዛር ኬፃናይ ኦኔ?","poem":1},{"text":"እ ቃችዳ ኡራ ብርሻናይ ኦኔ?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ፆሳይ እራ ተቅኮ ቢታይ መሌስ፤","poem":1},{"text":"እራ ቡክስኮ ድኦይ ቢታ ይሴስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ምኖተነ ፆኖይ ፆሳሳ፤","poem":1},{"text":"ጭመተይስነ ጭመይስ ናምአይካ እያፐ ጋርሳን ደኤስ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዞረይሳታፐ ጭንጫተ ቃር ኤኬስ፤","poem":1},{"text":"ሀላቃታካ ኤያ ከሴስ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እ ካዎታ አራታፐ ዎድ አይለ ከሴስ።","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ካህነታፐ ቦንቹዋ ቃር ኤኬስ፤","poem":1},{"text":"አዱሳ ዎደ ፃጶ የድዳ ዎልቃማታ ሽር የጌስ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አማነትዳ ዞረይሳታ ስእ ኦስ፤","poem":1},{"text":"ጭማታፐካ አኬካ የግሴስ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ቦንቸትዳይሳታ ካዉሼስ፤","poem":1},{"text":"ምኖታ ዳንጮ ብልሴስ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ማን ደእያ ፁራ ቆንጨ ከሴስ፤","poem":1},{"text":"ሌልዳ ማ ፖኦ ከሴስ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ፆሳይ ካዎተታ ግታዬስ፤ ዛሪድ ይሴስ፤","poem":1},{"text":"ካዎተታ ዳልግሴስ፤ ዛሪድ ላሌስ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"አላምያ ካዎታ አኬካ ድጌስ፤","poem":1},{"text":"ኦገይ ባይና መላ ቢታን ቶይላታና መላ ኦስ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ፖኦይ ባይና ማን ታታፎሶና፤","poem":1},{"text":"ማትዳ አሳዳ ጋንድጋሮሶና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/11.json","previousChapterAudioLinks":{},"numberOfVerses":25}