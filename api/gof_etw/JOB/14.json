{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"“ማጫሳፐ የለትዳ አሳስ ላይ ቃን፤","poem":1},{"text":"እካ ቃስ መቶን ኩምስ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ጪሻዳ በንትድ ኤለስድ ቆቆፈቴስ፤","poem":1},{"text":"ኩያዳ ጋምኦና ኤሶን አስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ያትን፥ ኔኒ ሄሳ መላ አስ ካላዬ?","poem":1},{"text":"ፕርዳስ ነ ስን ሺሻዬ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ቱናባፐ ጌሻባ ከሳናዉ ዳንዳኤይ ኦኔ?","poem":1},{"text":"ኦንካ ባዋ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አስ ዳና ላይስ ዛው ደኤስ፤","poem":1},{"text":"እ ዳና አጌና ኔኒ ታይባ ዎዳሳ፤","poem":2},{"lineBreak":true},{"text":"ኔኒ ዎዳ ዛዋፐ አይ ኦንካ ባዋ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኡነ ኦያ አስ ባ ኦሱዋ ፖልድ ሸምፐይሳዳ፥","poem":1},{"text":"እ ሸምፓና መላ ነ አይፍያ እያፐ ደንዳ እያ አጋጋ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ቃንፀትዳ ምስ ኡፋይስ ደኤስ፤","poem":1},{"text":"ዛሪድ አጬስ፤","poem":2},{"lineBreak":true},{"text":"ኦራ ታሸ ከስድ ድጬስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ም ፃጶይ ቢታ ጋርሳን ጭምኮካ፥","poem":1},{"text":"ዱሩማይ ቢታን ዎቅኮካ፥","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ሃ ደምድ አጬስ፤","poem":2},{"lineBreak":true},{"text":"ኦራ ዶላዳ ታሸ ከሴስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሽን አስ ሀይቄስ፤ ሄስ እያዉ ዉርሰ፤","poem":1},{"text":"እያ ሸምፖይ ከያፐ ጉየ እ አዉን ደኢ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አባ ሃ መለይሳዳ፥","poem":1},{"text":"ሻፋ ሃ ዉረይሳዳ፥","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ሄሳዳ አስካ ሀይቄስ፤ ስሚድ ደንደና፤","poem":2},{"lineBreak":true},{"text":"ሳሎት አና ጋካናዉ አስ ባርከና፤","poem":2},{"lineBreak":true},{"text":"ባ ስኩዋፈካ ደንደና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኔኒ ታና ዱፎን ገንዳኮ አይበ!","poem":1},{"text":"ነ ሀንቆይ አና ጋካናዉ ቆትዳኮ አይበ!","poem":2},{"lineBreak":true},{"text":"ነ ታዉ ቃሚዳ ሄ ጋላስ ታና ሀሳይዳኮ አይበ!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አስ ሀይቅኮ ስሚድ ደኦን ዳኔ?","poem":1},{"text":"ታ ሸምፕያ ዎደይ ያና ጋካናዉ፥","poem":2},{"lineBreak":true},{"text":"ሀ መቶ ዎደ ኡባ ዳንዳአን ናጋና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሄ ዎደ ነ ታና ፄጋና ታካ ኮያና፤","poem":1},{"text":"ነ መዳ ታና በአናዉ ላሞትያ ዎደይ ያና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሄ ዎደ ኔኒ ቱማ ታ ታንጉዋ ዎቻና፤","poem":1},{"text":"ሽን ታ ናጋራ ካላካ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ታ ባላይ ኦጎሮን ዪጨታና፤","poem":1},{"text":"ታ ናጋራ ኔኒ ካማና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዙም ዎደይሳዳ፥","poem":1},{"text":"ዛል ቃለተይሳዳ፥","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ሃ ሹቻ ፃጶ ቦከይሳዳ፥","poem":2},{"lineBreak":true},{"text":"ድኦይ ቢታ ሜጭድ ኤፈይሳዳ፥","poem":2},{"lineBreak":true},{"text":"ኔኒ አሳ ኡፋይስ ይሳሳ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ኔኒ እያ መርናዉ ፆናሳ፤ እ ስመና፤","poem":1},{"text":"እያ ማላ ላማዳ ነ ስንፈ ድጋሳ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"እያ ናይት ቦንቸትኮ እ ኤረና፤","poem":1},{"text":"ኤንቲ ካዉይኮ እ በኤና።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ሽን እያ አሳተ ሴላይ እያ ፃላላስ ስኤቴስ፤","poem":1},{"text":"እ ባ ፃላላስ ዬኬስ” ያግስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}