tent":[{"text":"ኑኒ ኤሮናባይ ኔኒ ኤርያባይ አይቤ?","poem":1},{"text":"ኑስ ጌምዳ ነዉ ቆንጭዳ አይባ ጭንጫተ ደኢ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ነ አዋፐ ባይራትያ አሳት፥","poem":1},{"text":"ጭምድ ፑሉምዳ አሳት ኑራ ደኦሶና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“ፆሳይ ነዉ እምዳ ምንይ ግደነዬ?","poem":1},{"text":"ኑኒ ካሃማተባ ኦድዳ ቃላይ ጉዬ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ነ ዎዛናይ ነና አይስ ዎራ ኤፊ?","poem":1},{"text":"ነ አይፈይ አይስ ደሬቅድ ፄሊ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ያታዳ ኔኒ ፆሳ ቦላ ሀንቀታዳሳ፤","poem":1},{"text":"ኢታ ቃላ ነ ዶናፐ ከሳዳሳ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አስ ፆሳ ስንን ጌሽ ግዳናዉ ዳንዳኢ?","poem":1},{"text":"ዎይኮ ማጫፈ የለትዳ አስ ፅሎ ግዳናዉ ዳንዳኢ?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ፆሳይ ባ ኪታንቾታን አማነተና፤","poem":1},{"text":"ሀር አቶሽን ሳሎት እያ ስንን ጌሽ ግዶኮና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኢታነ ቱና ግድዳ አስ፥","poem":1},{"text":"ናጋራ ሃዳ ኡያ አስ ዋንድ አማነታኔ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“አነ ስአ፥ ቆንጭሳዳ ታ ነዉ ኦዳና፥","poem":1},{"text":"ታኒ በእዳባ ኡባ ነዉ ኦዳና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ጭንጫት ባንታ አዋታፐ ኤክዳይሳ፥","poem":1},{"text":"ታ ነዉ ገንና ኦዳና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ቢታይ ኤንታ ፃላላስ እመትስ፤","poem":1},{"text":"ሀራ ቢታ አስ ኤንታራ ዋላከትቤና።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አሰ ኡንኤሸ ደእያ ኢታ አስ፥","poem":1},{"text":"ባ ደኦ ላይ ኡባን ዋየትሸ ደኤስ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዳጋንያባይ እያ ሀይን ስኤቴስ፤","poem":1},{"text":"እ ሳሮ ደአይስ ግሽን ይሰይሳት እያ ቦላ ከያና።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ማፐ ከስ ኤኮይ እያዉ ሀነና፤","poem":1},{"text":"እያ ቃዳይ ማሻን ዮ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"እያ አሀይ አንኮ ቁማ ግዳና፤","poem":1},{"text":"ባዉ ማ ጋላስ ማታትዳይሳ እ ኤሬስ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"መቶይነ ኡንእ እያ ቦላ ያና፤","poem":1},{"text":"ኦላናዉ ከይዳ ካዎ መላ እያ ቦላ ጎባና።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ሄስካ እ ባ ኩሽያ ፆሳ ቦላ ደንዳ ግሾሳ፤","poem":1},{"text":"ኡባ ዳንዳእያ ፆሳ ቦላ ፃልዳ ግሾሳ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"እ ኤቀታናዉ ምኖነ ዳልጋ ጎንዳለ ኦይክስ፤","poem":1},{"text":"ኦቶሮን ፆሳኮ ሆርዶፌስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“እያ ክላሆይ ሙምዳ ግሾ፥","poem":1},{"text":"እያ ፄሳይ ኩምዳ ግሾ፥","poem":2}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"እ ላለትዳ ካታማታን፥","poem":2},{"lineBreak":true},{"text":"ካይሳ ኬንነ፥","poem":2},{"lineBreak":true},{"text":"ኩንዳናዉ ጋክዳ ኬን ደኤስ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"እ ባ ዱረተን ዳሮ ጋምኤና፤","poem":1},{"text":"እያ ዛዋይ አከና።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ማፐ ከስ ኤከናዉ ዳንዳኤና፤","poem":1},{"text":"ታሽያ ታም ላብዳ ምዳነ","poem":2},{"lineBreak":true},{"text":"ጫርኮይ ጪሻ ቆቆፍዳ ምዳ ግዳና።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ፓናባን አማነትድ ባና ጭሞፎ፤","poem":1},{"text":"እያፐ አይኮካ ደሞና አታና።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ዎደይ ጋኮና እያ ኡባይ መልድ","poem":1},{"text":"ታሸይካ አጮና ም መላ ግዳና።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"እ ቴሮና ቃዉኤ ደእሸ ቆቆፈትያ ዎይነ መላ፤","poem":1},{"text":"ጪሻን ደእሸ ቆቆፈትያ ሻማሆ መላ።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ፆሳስ ያዮና አሳ ኮቻይ ያና፤","poem":1},{"text":"ዎፈን ኬፀትዳ ኬይ ታማን ሜተታና።","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ኤንቲ ኢታተ ቃንትድ መቶ የሎሶና፤","poem":1},{"text":"ኤንታ ኡሉዋን ገነይ ኩምስ” ያግስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":35}