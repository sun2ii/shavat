{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":16,"content":[{"type":"heading","content":["እዮባ ሃሳያ"]},{"type":"verse","number":1,"content":["እዮብ ሀይሳዳ ያግድ ዛርስ፤"]},{"type":"verse","number":2,"content":[{"text":"“ታኒ ሄሳ መላ ሃሳያ ዳሮ ስአስ፤","poem":1},{"text":"ህንተ ምንይ ታና ሳለስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ጎእ ባይና ህንተ ኦዳስ ዉርሰ ባዌ?","poem":1},{"text":"ታራ ህንተና ሄሳዳ ፓላንያ ጋሶይ አይቤ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ህንተ ታ በሳን፥ ታኒ ህንተ በሳን ግድዳባ ግድያኮ፥","poem":1},{"text":"ታኒ ታ ሁጵያ ቃሸ፥","poem":2},{"lineBreak":true},{"text":"ሀእ ህንተ ግያባ ኡባ ህንተ ቦላ ሎይዳ ጋናሽን!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ታ ዞርያን ታ ህንተና ምንናሽን!","poem":1},{"text":"ታ ዶናፐ ከይያ ኦዳይ ህንተና ምንናሽን!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“ሽን ታ ሃሳይኮካ ታ ሳሆይ ደጨና፤","poem":1},{"text":"ታ ስእ ጋዳ ዳንዳእኮካ ታፐ ክቸና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አቤት ፆሳዉ፥ ነ ታና ታ አሳተፈ ከሳዳሳ፤","poem":1},{"text":"ታ ኬ አሳ ኡባ ይሳዳሳ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሹቅዳ ታ ጎጋይ ታዉ ማርካ ግድስ፤","poem":1},{"text":"ታ ግልቃተይ ታና ናጋራንቾ ከስስ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ፆሳይ ሀንቀትድ ታ አሳተ ቃንፀረስ፤","poem":1},{"text":"ታና እፅድ ባ አቻ ታ ቦላ ጋርጭስ፤","poem":2},{"lineBreak":true},{"text":"ታ ሞርከይ ባ አይፍያ ታ ቦላ ከስስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አሳይ ታ ዩሾን ሺቅድ ታና ቀልቅስዶሶና፤","poem":1},{"text":"ታና ለቅድ ባቅዶሶና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ፆሳይ ታና ናጋራቾታስ አድ እሚስ፤","poem":2},{"lineBreak":true},{"text":"ኢታታ ኩሸን ታና የግስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ታኒ ካሰ ሳሮ ደአስ፤","poem":1},{"text":"ሽን ፆሳይ ታና ትንቸረስ፤","poem":2},{"lineBreak":true},{"text":"ታ ምርጋጭያ ኦይክድ ታና መንረስ፤","poem":2},{"lineBreak":true},{"text":"ጫቸ ሎህስያ ማላ ኦስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እያ ቶራንቾት ባንታ ዶንገን ታና ተቅዶሶና፤","poem":1},{"text":"ቃይ ባይና ታ ክላሁዋ ሙፀረዶሶና፤","poem":2},{"lineBreak":true},{"text":"ታ ጭያ ሳአን ጉስዶሶና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እ ታና ዛር ዛር ማዱንፅስስ፤","poem":1},{"text":"ኦላንቾዳ ቶልድ ጫድስ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ታኒ ካዮ ማኦ ማአስ፤","poem":1},{"text":"ታ ዎልቃይ ዉርን ባናን ኡታስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዬሆን ታ ሶምኦይ ጋቢስ፤","poem":1},{"text":"ታ አይፈይ ዞእስ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሽን ሄ ኡባን ታ ባልዳባይ ባዋ፤","poem":1},{"text":"ታ ጌሻ ዎዛናን ዎሳይስ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ቢታዉ፥ ታና ጋክዳ ቆሁዋ ካሞፋ፤","poem":1},{"text":"ታ ዋሶይ ሸምፕያ ሶ ደሞፎ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሄኮ ታ ማርካይ ሳሎና፤","poem":1},{"text":"ታ ፃባቃይ ቦላና።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ታ ላገት ታና ካድ ፄሎሶና፤","poem":1},{"text":"ታ አይፈይ ፆሳ ስንን አፉ ትጌስ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አሰ አሳራ ስገያ አስ ደኤይሳዳ፥","poem":1},{"text":"ታና ፆሳራ ስገያ አስ ደእዳባ ግድረነሽን።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ታ ላይይ ዉራና ሀኔስ፤","poem":1},{"text":"ጉ ዎደፐ ጉየ ታ ስሞና ሶ ባና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}