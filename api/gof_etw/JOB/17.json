{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"ታ ሸምፖይ ከዬስ፤","poem":1},{"text":"ታ ላይይ ቃምስ፤","poem":2},{"lineBreak":true},{"text":"ታዉ ዱፎይ ጊግስ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታ ቦላ ቀልቅሰይሳት ታ ዩሹዋን ደኦሶና፤","poem":1},{"text":"ኤንቲ ታና ይሎይዳ መላ አይስዶሶና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አቤት ፆሳዉ፥ ኔፐ ሀር ታና ማደይ ባይና ግሾ፥","poem":1},{"text":"ነ ታዉ ዋሰ ግዳ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኤንቲ አኬኮና መላ ኤንታ ቆፋ ጎርዳዳሳ፤","poem":1},{"text":"ሄሳ ግሾ፥ ነ ኤንታዉ ፆኖ እሞፋ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሚሸ ደማና ግድ፥","poem":1},{"text":"ባ ላገታ አድ እምያ ኡራ ናይታ አይፈይ ቆቃና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ፆሳይ ታና አሳስ ሚቻስ አግስ፤","poem":1},{"text":"አስ ጩትሸ አያ አስ ግዳስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታ ዳሮ ካዮትዳ ግሾ ታ አይፈይ ኤይስ፤","poem":1},{"text":"ታ አሳተይ ላፍድ ኤሾ ግድስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኬሀ አሳት ታና በእድ ዳጋምዶሶና፤","poem":1},{"text":"ሱረት ፆሳ አማኖናይሳታ ቦላ ይሎትዶሶና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ግዶሽን ፅሎት ባንታ ኦግያፐ ደሾኮና፤","poem":1},{"text":"ሱረት ዎልቃ ጉጅ ጉጅ ቦሶና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሽን ዛሪድ ኡባይ ታኮ ሃ ዪተ!","poem":1},{"text":"ታ ህንተ ግዶፈ እስ ጭንጫ አስ ደምከ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታ ደኦ ላይይ ዉርስ፤","poem":1},{"text":"ታ ሀልቾይ ሀዳ ግድስ፤","poem":2},{"lineBreak":true},{"text":"ታ ዎዛና አሞይ ጮ አትስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ታ ላገት ቃማ ጋላስ ጎሶና፤","poem":1},{"text":"ማ በእሸ ‘ፖአና ሀኔስ’ ያጎሶና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታ ኡፋይሳን ናግያ ኬይ ዱፎ፤","poem":1},{"text":"ታ ሂፃ ማን ሂፃይስ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዱፎኮ፥ ‘ነ ታ አዋ’ ያጋና፤","poem":1},{"text":"ጉፁነኮ፥ ‘ነ ታ አዮ ዎይኮ ታ ምቾ’ ያጋና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ያትን፥ ታዉ አይ ኡፋይስ ደኢ?","poem":1},{"text":"ታዉ ኡፋይስ ግድያባ ኦን ደማናይ?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ታ ኡፋይሳይ ታራ ዱፎ ባንዴ?","poem":1},{"text":"ኑ እስፈ ቢታን ዱገ ገላኔ?” ያግስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}