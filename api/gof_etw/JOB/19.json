{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":19,"content":[{"type":"heading","content":["እዮባ ሃሳያ"]},{"type":"verse","number":1,"content":[{"text":"እዮብ ዛሪድ ሀይሳዳ ያግስ፤","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ህንተ ታና አዉደ ጋካናዉ ማዱንፅሴቲ?","poem":1},{"text":"አዉደ ጋካናዉ ህንተ ቃላን ታና ጫደቲ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ህንተ ታና ታሙ ቶሆ ጫይደታ፤","poem":1},{"text":"ታና ካዉሽሸ ዬላተከታ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ቱማ ታ ባልዳባ ግድኮ፥","poem":1},{"text":"ታ ባላይ ታና ኦይቻና።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ህንተ ህንተና ቁ ቁ ኦድ፥","poem":1},{"text":"ታ ካዉሻ ታና ሞታናዉ ጎኤትኮ፥","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ሀ መቱዋ ታ ቦላ ኤህዳይ ፆሰ ግደይሳነ","poem":2},{"lineBreak":true},{"text":"ባ ግትያን ታና ገልስዳይ እያ ግደይሳ ኤርተ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታ ቆሄታስ ጋዳ ዋስን፥ ታና አለይ ባዋ፤","poem":1},{"text":"ታ ቃላ ቁ ኦዳ ዋስንካ ታና ስኤይ ባዋ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታ ካንዳ ቦናዳ ፆሳይ ታ ኦግያ ድርስ፤","poem":1},{"text":"ታ ሄመትያ ኦግያ ማን ጎርድስ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ታ ቦንቹዋ ታፐ ቃርስ፤","poem":1},{"text":"ታ ካላቻ ታ ሁጰፐ ኤክስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እ ታና መንረ የግስ፤","poem":1},{"text":"ታ ኡፋይሳ ፃጶራ ሾደትዳ ም መላ ኦስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እያ ሀንቆይ ታ ቦላ ኤፅ ከይስ፤","poem":1},{"text":"እ ታና ሞርከዳ ታይቤስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ታና ኦላናዉ ባ ቶራንቾታ ኪቴስ፤","poem":1},{"text":"ኤንቲ ታና ኦላናዉ ሚፃ ኬፅድ፥","poem":2},{"lineBreak":true},{"text":"ታ ዱንካንያ ዩሹዋን ኡትዶሶና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ፆሳይ ታ እሻታ ታፐ ሃስስ፤","poem":1},{"text":"ታና ኤረይሳት ታዉ አላጋ ግድዶሶና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ታ ዳቦት ታፐ ሃክዶሶና፤","poem":1},{"text":"ታ ላገት ታና ዶግዶሶና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ታ ሶን ሞከትያ እማት ታና ዶግዶሶና፤","poem":1},{"text":"ታ ማጫ አይለት ታና ኦገ አሳዳ ፄልዶሶና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ታ አይልያ ታ ፄግን ታዉ ኮየና፤","poem":1},{"text":"ታ ዎስን ታዉ ኤሮ ጌና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ታ ማችያ ታ ዶና ፔኑዋ ሻተታሱ፤","poem":1},{"text":"ታ እሻት ታና ኡፍዶሶና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሀር አቶሽን ጉ ናይት ታና ካኦሶና፤","poem":1},{"text":"ታና በእድ ለቆሶና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ታ ማታ ላገት ኡባይ ታና ኡፎሶና፤","poem":1},{"text":"ታ ዶሰይሳት ታዉ ዞኮ ዛርዶሶና።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ታ መቀይ ታ ጎጋራ ኦይከትስ፤","poem":1},{"text":"ታኒ ሀይቃ ክቻዳ አታስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ታ ላገቶ፥ ፆሳ ኩሸይ ታና ደችዳ ግሾ፥","poem":1},{"text":"ታዉ ቃተርከት።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ፆሳይ ታና የደይሳዳ፥ ህንተ ታና አይስ የደቲ?","poem":1},{"text":"ሀእ ጋካናዉ ህንተ ታና ዋይስዳይስ ግደኔ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“ሀእ ጋካናዉ ታ ኦደትዳ ቃላይ ማዝጋበትዳኮ፥","poem":1},{"text":"ማፃፋን ፃፈትዳኮ ታ ዶሳይስ ሽን።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"መርናዉ ዳና መላ ማርሳንነ","poem":1},{"text":"እርሳሰን ዛላ ቦላ ዎጨትድ ፃፈትዳ ግዴረነ!","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ታና ዎዝዳይስ ደኦን ደኤይሳነ","poem":1},{"text":"ዉርሰን ቢታ ቦላ እ ኤቃናይሳ ታ ኤራይስ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ታ ጎጋይ ሜተትድ ዉርኮካ፥","poem":1},{"text":"ታኒ ታ አሹዋፐ ሻከታዳ ፆሳ በአናይሳ ኤራይስ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ሀራ አስ ግዶና ታኒ ታ ሁጰን፥","poem":2},{"lineBreak":true},{"text":"ታ አይፈን እያ በአና፤","poem":2},{"lineBreak":true},{"text":"ታ ዎዛናይ ሄ ቃማ ላሞቴስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“ሀ መቱዋስ ጋሶይ እያ፥","poem":1},{"text":"ኑ እያ ዋት የደኖ ግድ ህንተ ቆፕያባ ግድኮ፥","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ማሻስ ያይተ!","poem":1},{"text":"ፆሳ ሀንቆይ ማሻራ ያና፤","poem":2},{"lineBreak":true},{"text":"ፕርድ ደኤይሳ ኤርተ” ያግስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}