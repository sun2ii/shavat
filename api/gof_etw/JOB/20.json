{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":20,"content":[{"type":"heading","content":["ሶፋራ ሃሳያ"]},{"type":"verse","number":1,"content":["ናእማ ቢታ አስ ግድዳ ሶፋር ሀይሳዳ ያግድ ዛርስ፤"]},{"type":"verse","number":2,"content":[{"text":"“ነ ኦዳይ ታና ላንጭስዳ ግሾ፥","poem":1},{"text":"ታ ኤለሳዳ ነ ኦዳስ ዛሮ እማና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ነ ኦዳይ ታ ቦንቹዋ ቃርያ ግሾ፥","poem":1},{"text":"ታ አኬካይ ነዉ ዛሮ እማና መላ ታና ደንስ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አስ ቢታ ቦላ ደእዳ ዎደፐ ዶምድ፥","poem":1},{"text":"በንፐ ሀንዳባ ኤራሳ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኢታ አሳ ጬቆይ ቃን ዎደሳ፤","poem":1},{"text":"ፆሳ ኤሮና አሳ ኡፋይሳይ ጉ ዎደሳ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኢታ አሳ ኦቶሮይ ሳሎ ጋካናዉ ቁ ጊኮካ፥","poem":1},{"text":"እያ ሁጰይ ሻራ ጋክድ ቦችኮካ፥","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"እ ባና መላ ፕተትድ ያና፤","poem":2},{"lineBreak":true},{"text":"እያ ካሰ ኤርያ አሳይ ‘እ አዉን ደኢ?’ ያጋና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኤልሞዳ ፓልድ ያና፤ ስሚድ በንተና፤","poem":1},{"text":"ቃማ አሙሆዳ ጮ ያና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እያ ካሰ በእዳ አይፈት ዛሪድ እያ በኦኮና፤","poem":1},{"text":"እ ባ ደእያ በሳፈ ትምእ ግድ ያና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አዋይ ቦንቅ ኤክዳ ሚሸ፥","poem":1},{"text":"እያ ናይት ባንታ ኩሸን ጉየ ዛራና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እያ መቀ ኩምዳ ናአተ ዎልቃይ","poem":1},{"text":"እያራ እስፈ ቢታን ዝንአና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“ኢታተ እያ ዶናን ማልእኮ፥","poem":1},{"text":"እ ባ እንፃርሳፈ ጋርሳን ቆስኮ፥","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ዉሮናዳ ባ ዶናን ኦይክድ፥","poem":2},{"lineBreak":true},{"text":"ዎ አግኮ፥","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"እያ ኡሉዋን ጫሞ ግዳና፤","poem":2},{"lineBreak":true},{"text":"ዎያ ሾሻ ማርዘ ግዳና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኢታ አስ ምትዳ ሻሉዋ ዛር ጩታና፤","poem":1},{"text":"እያ ኡሉዋን ደእያ ኡባ ፆሳይ ጮሻና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኢታ አስ ምያባይ እያዉ ማርዘ ግድድ፥","poem":1},{"text":"እያ ዎና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ኤስነ ማ ሃዳ ጎግሽን፥","poem":1},{"text":"እ በኦና አታና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ባ ዳቡራ አይፍያ ሞና ሀራስ እማና፤","poem":1},{"text":"ዛልእድ ዎስዳ ዎያን ኡፋይተና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሄስ ሀንዳይ እ ማንቆታ ኡንኤዳ ግሾነ","poem":1},{"text":"ሀራ አስ ኬፅዳ ኬ ቦንቅዳ ግሾሳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“እያ ኢታ አሞይ ሸምፖ ድግስ፤","poem":1},{"text":"ሺሽዳ ሻሎይ እያ አሻናዉ ዳንዳኤና።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"እያ ሻሎይ ዉርያ ግሾ፥","poem":1},{"text":"እያ ዱረተይ ጋምኤና።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"እያዉ አቆይ ኩምድ ደእሽን፥","poem":1},{"text":"መቶይ አኬኮና እያ ቦላ ጋክ ዎና።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"እያ ኡሎይ ካልያ ዎደ፥","poem":1},{"text":"ፆሳይ ዎልቃማ ሀንቁዋ እያ ቦላ ጉሳና።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ብራታ ማሻፈ እ ባቃታና፤","poem":1},{"text":"ሽን ናሰ ብራታ ዶንገይ እያ ጫዳና።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ሄ ዶንገይ እያ ዞኮራ ካን ከያና፤","poem":1},{"text":"ጶልያ ፄራይ እያ ትርያ ካን አና፤","poem":2},{"lineBreak":true},{"text":"ዳጋም እያ ዎዛና ዋባቅሳና።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"እ ሺሽዳ አቆይ ሳካና ማን ያና፤","poem":1},{"text":"አስ ኦይቦና ታም እያ ማና፤","poem":2},{"lineBreak":true},{"text":"እያ ኬን አትዳ ሻሎ ኡባ ፁጋና።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ሳሎት እያ ናጋራ ቆንጭሳና፤","poem":1},{"text":"ሳእካ እያዉ ሞርከ ግዳና።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ፆሳ ሀንቆ ጋላሳን፥","poem":1},{"text":"እያ ኬነ እያዉ ደእያባ ድኦይ ኤፋና።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ፆሳይ ጌላታስ ዎዳ ቃዳይ፥","poem":1},{"text":"ኢታ አሳስ ጊግስዳ ጋተይ ሀይሳ” ያግስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}