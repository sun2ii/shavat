{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":21,"content":[{"type":"heading","content":["እዮባ ሃሳያ"]},{"type":"verse","number":1,"content":["ያትን እዮብ ሀይሳዳ ያግድ ዛርስ፤"]},{"type":"verse","number":2,"content":[{"text":"አነ ታ ኦዳ አኬክድ ስእተ፤","poem":1},{"text":"ሄስ ህንተ ታና ምንዳ መላ ግዶ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታኒ እስ ቶሆ ኦደታና መላ ታዉ ዎደ እምተ፤","poem":1},{"text":"ታኒ ሃሳያ ስምኮ ታና ቀልቅስተ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታኒ ሞተተይ አሳራ ግደና።","poem":1},{"text":"ያትን፥ ዳንዳአይ ዉርኮ ሄስ ማላልስዬ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አነ ታና ፄልድ ማላለትተ፤","poem":1},{"text":"ህንተ ኩሽያ ህንተ ዶና ቦላ ዎተ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታ ሄሳ ቆፕያ ዎደ ታና ዳጋንስ፤","poem":1},{"text":"ታ አሳተይ ኮኮሬስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኢታ አሳት አይስ ፓፃ ደኦና?","poem":1},{"text":"ኤንታ ላይይ አይስ አዱቂ?","poem":2},{"lineBreak":true},{"text":"ኤንታ ዎልቃይ አይስ ዳር ዳር ብዴ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኤንታ ናይትነ ናይታ ናይት፥","poem":1},{"text":"ድጭሽንነ እንጀን ደእሽን ኤንቲ አይስ በኦና?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኤንታ ሶይ ህርግ ባይና ሳሮ ደኤስ፤","poem":1},{"text":"ፆሳ ፃምአይ ኤንታ ጋከና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኤንታ ሚዛት ብራይስ ኤክድ ኮፆኮና፤","poem":1},{"text":"የልሸ አዉጫዮኮና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ባንታ ናይታ ዶርሳ ዉደዳ ከሶሶና፤","poem":1},{"text":"ኤንታ ናይት ዱሮሶና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ካራቦ ባቅሸ ዲ ዲፅሸ፥","poem":1},{"text":"ሱሱልኤ ፑንሸ ኡፋይሳን የፆሶና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኤንቲ ባንታ ደኦ ላይ እንጀን ደእድ፥","poem":1},{"text":"ዱፎ ሳሮራ ቦሶና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ግዶሽን፥ ኤንቲ ፆሳኮ “ኑፐ ሃካ!","poem":1},{"text":"ኑኒ ነ ኦግያ ኤራናዉ ኮዮኮ” ያጎሶና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“ኑ እያ ጎይናናዉ ኡባ ዳንዳእያ ፆሳይ ኦኔ?","poem":1},{"text":"ኑ እያ ዎስድ አይ ጎኤታኔ?” ያጎሶና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኤንቲ ዱረተ ባንታ ምኖተን ደምዳ ጎሶና፤","poem":1},{"text":"ሽን ታኒ ኤንታ ቆፋ ኤክከ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“ሀኖሽን፥ ኢታ አሳ ፆምፐይ ቶኢ?","poem":1},{"text":"ኤንታና ቦሽ ጋክ ኤሪ?","poem":2},{"lineBreak":true},{"text":"ፆሳይ ባ ሀንቁዋን ኤንታ ሴር ኤሪ?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ጫርኮይ ኤንታ ካለዳ ኤፍዳ ዎደይ፥","poem":1},{"text":"ጎተይ ኤንታ ባናዳ ደንዳ ዎደይ ደኢ?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ህንተ፥ ‘ፆሲ አዋታ ባላ ግሾ ኤንታ ናይታ ሴሬስ’ ያጌታ።","poem":1},{"text":"አነ ፆሳይ ናጋራንቾታ ኤንታ ሁጰን ሴሮ፤","poem":2},{"lineBreak":true},{"text":"ያትኮ ኤንቲ ባንታ ናቁዋ ኤራና።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ናጋራንቾት ባንታ ሴራ ባንታዉ ኤኮ፤","poem":1},{"text":"ኡባ ዳንዳእያ ፆሳ ሀንቆይ ኤንታ ቦላ ዎ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አስ ሀይቅዳፐ ጉየ፥","poem":1},{"text":"ባ ናይታባ አይ ኤሪ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“ቃ በሳን ደኤይሳታ ፕርድያ ፆሳ፥","poem":1},{"text":"ኤራተ ታማርሳናዉ ዳንዳእያ አስ ደኢ?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"እስ እስ አስ ኩመ ዎልቃይነ ሳሮይ ደእሽን፥","poem":1},{"text":"እንጀ ዱሱ ደእሸ ሀይቆሶና።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ኤንታ አሳተይ ኦርደ ሽን፥","poem":1},{"text":"ኤንታ መቀ ኮልዘይ ሽጫ ደእሽን ሀይቆሶና።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ሽን ሀራት ሎኦባ በኦና፥","poem":1},{"text":"መቶን ኡንኤትድ ካዮትዳ መላ ሀይቆሶና።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ናምአይካ ሀይቅድ ቢታን ሞገቶሶና፤","poem":1},{"text":"ኤንቲ ጉፁንቶሶና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“ህንተ ታና ቆሀናዉ ቆፕድ፥","poem":1},{"text":"ህንተ ዎዛናን ቆፕዳ ቆፋ ታ ሎይዳ ኤራይስ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ህንተ፥ ‘ሄ ግታ ኡራ ኬይ አዉኔ?","poem":1},{"text":"ኢታ ኦያ ኡራይ ደእያ ሶይ አዉኔ?’ ያጌታ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ኦገ አሳታ ኦይችቤከቲ?","poem":1},{"text":"ኤንታ ማርካተ አማንበከቲ?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ኤንቲ፥ ‘ኢታ አሳይ ዮ ጋላስ ቆሄቶኮና፤","poem":1},{"text":"ፆሳ ሀንቆይ ቆንጭያ ጋላስ ኤንቲ አታና’ ያጎሶና።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ኢታ አስ እያ ኢታተ ግሾ ካጫናይ ኦኔ?","poem":1},{"text":"እያ ኦሱዋ ግሾ እያ ሴራናይ ኦኔ?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"እ ሀይቅን፥ እያ አሀ ዱፎ ኤፎሶና፤","poem":1},{"text":"እያ ዱፎይ ቦንቾን ናገቴስ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ዛንጋራ ቢታይ እያዉ እንጀቴስ፤","poem":1},{"text":"ዳሮ አሳይ እያ ስንን ቦሶና፤","poem":2},{"lineBreak":true},{"text":"ታይቦይ ባይና አሳይ እያ ካሎሶና።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ያትን፥ ህንተ ታና ፓና ቃላን ዋት ምንኔ?","poem":1},{"text":"ህንተ ታ ኦይሻስ ዛርያ ዛሮ ኡባይ ዎርዶ” ያግስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/20.json","previousChapterAudioLinks":{},"numberOfVerses":34}