{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":22,"content":[{"type":"heading","content":["ኤልፋዛ ሃሳያ"]},{"type":"verse","number":1,"content":["ሄሳፈ ጉየ፥ ተማና ቢታፈ ይዳ ኤልፋዝ ሀይሳዳ ያግድ ዛርስ፤"]},{"type":"verse","number":2,"content":[{"text":"“አስ ፆሰ ጎአናዉ ዳንዳኢ?","poem":1},{"text":"ሀር አቶሽን ጭንጫ ግድኮካ፥","poem":2},{"lineBreak":true},{"text":"ባና ጎአናፐ አትሽን፥ ፆሰ ጎኤና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኔኒ ፅሎ ግድኮ ሄስ ኡባ ዳንዳእያ ፆሳ ኡፋይስዬ?","poem":1},{"text":"ነ ኦገይ ቦረይ ባይናባ ግድኮ ሄሳን እ አይ ዎ ደሚ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“እ ነና ሴረይነ ፕርደይ፥","poem":1},{"text":"ኔኒ እያዉ ያይያ ግሾዬ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ነ ኢታተይ ዳሮ ግደነዬ?","poem":1},{"text":"ነ ናጋራስ ዛው ባዋ ግደኔ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ጋሶይ ባይና ነ እሻታ ዋሰ ፄግሳዳሳ፤","poem":1},{"text":"አሳ ማኡዋ ቃራ ኤካዳ ኤንታ ካሎ የዳዳሳ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሳሞትዳይሳታ ሃ ኡሻባካ፤","poem":1},{"text":"ኮሻትዳይሳታ ካ ሙዛባካ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኔኒ ዎልቃማ፥ ዱረነ","poem":1},{"text":"ቦንቸትዳ አስ ግዳዳ ደአሸ፥","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አምኤታ መላ ኩሸ የዳዳሳ፤","poem":1},{"text":"ይኦታስ ዎልቃ ይሳዳሳ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ነ ዩሾይ ግተትዳይ፥","poem":1},{"text":"አኬኮና ያሽ ነና ኮኮርሰይ ሄሳሳ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ነ በኦና መላ ምዳይ፥","poem":1},{"text":"ቃስ ክፃ ሃን ነ ሙከትዳይ ሄሳሳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“ፆሳይ ቃ ሳሉዋን ኡትድ፥","poem":1},{"text":"ቃን ደእያ ፆልንቶታ ዱገ ፄሌስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሽን ኔኒ፥ ‘ፆሲ አይ ኤሪ?","poem":1},{"text":"ሳካና ማ ግዶራ ካንድ፥","poem":2},{"lineBreak":true},{"text":"ፕርዳናዉ ዳንዳኢ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሳሎ ጉፋን ቦላ እ ስመረትያ ዎደ፥","poem":1},{"text":"እ በኦና መላ ስከትዳ ሻራይ እያ ጎዜስ’ ያጋሳ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ናጋራንቾት ሄመትዳ በን ኦግያራ","poem":1},{"text":"ባናዉ ቆፋ ቃቻዲ?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኤንታዉ ዎደይ ጋኮና ደእሽን ሀይቅዶሶና፤","poem":1},{"text":"ኤንታ ደኦ ባሶይ ድኦን ሜጨትድ ይስ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ኤንቲ ፆሳኮ፥ ‘ኑፐ ሃካ!","poem":1},{"text":"ኡባ ዳንዳእያ ፆሳይ ኑስ አይ ኦናዉ ዳንዳኢ?’ ያግዶሶና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ግድኮካ፥ ኤንታ ኬ ሎኦባን ኩንዳይ ፆሳ፤","poem":1},{"text":"ሄሳ ግሾ፥ ኢታ አሳ ቆፋ ታ ኤክከ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“ኢታ አሳት ሴረትያ ዎደ፥","poem":1},{"text":"ፅሎት ኡፋይቶሶና፤","poem":2},{"lineBreak":true},{"text":"ሱረ አሳት ሀይሳዳ ያግድ፥ ኤንታ ቦላ ቀልቅሶሶና።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"‘ኑ ሞርከት ይዶሶና፤","poem":1},{"text":"ኤንታ ዱረተይ ታማስ አትስ’ ያጎሶና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“እዮባ፥ ሀእካ ፆሳራ ጊጋ፤","poem":1},{"text":"እያራ ሳሮ ደአ፤","poem":2},{"lineBreak":true},{"text":"ያትኮ ኔኒ አንጀታና።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"እያ ትምርትያ ስአ፤","poem":1},{"text":"እያ ቃላ ነ ዎዛናን ዎ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ኔኒ ኡባ ዳንዳእያ ፆሳኮ ስምኮ፤","poem":1},{"text":"ነዉ ሳእ ስማና፤","poem":2},{"lineBreak":true},{"text":"ኢታ ኦሶ ኡባ ነ ሶፐ ድጋ፤","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ነ ዎርቃ ሳአን ሆላ፤","poem":1},{"text":"ነ ኦፍራ ዎርቃ ሻፋን የጋ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ያትኮ ኡባ ዳንዳእያ ፆሳይ፥","poem":1},{"text":"ነዉ ዎርቃነ ዶረትዳ ብራ ግዳና።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ሄ ዎደ ነ ኡባ ዳንዳእያ ፆሳን ኡፋይታና፤","poem":1},{"text":"ዬላቶና ፆሳኮ ፑደ ፄላና።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ኔኒ እያ ዎሳና፥ እ ነና ስአና፤","poem":1},{"text":"ነ ቃንገ እያዉ ጋና።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ነ ቆፕዳባይ ፖለታና፤","poem":1},{"text":"ነ ሄመትያ ኦገይ ፖኦ ግዳና።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ፆሳይ ኦቶረይሳታ ካዉሼስ፤","poem":1},{"text":"ሽን አሽከታ አሼስ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ነ ኩሸይ ጌሽ ግድኮ፥","poem":1},{"text":"ባላ አሳይ ነ ጋሶን ማሮታ ኤካናነ አታና” ያግስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}