{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":23,"content":[{"type":"heading","content":["እዮባ ሃሳያ"]},{"type":"verse","number":1,"content":["እዮብ ሀይሳዳ ያግድ ዛርስ፤"]},{"type":"verse","number":2,"content":[{"text":"ሀችካ ታ ጫመታዳ ዙዙማይስ፤","poem":1},{"text":"ታ ኦለይ ምኖ ግድኮካ","poem":2},{"lineBreak":true},{"text":"እያ ኩሸይ ታ ቦላ ዴፀይሳ አግቤና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እያ ደማና በሳ ታ ኤርዳ ግዳርክና፤","poem":1},{"text":"እ ደእያ በሳ ታ ጋካርክና!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታኒ ታ መቱዋ እያ ስንን ዎናሽን!","poem":1},{"text":"ታ ዶና ሞቶን ኩንናሽን!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እ ታዉ ዛራናይ አይበኮ ኤራናሽን፥","poem":1},{"text":"እ አይ ግያኮ በአናሽን!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እ ባ ግታ ዎልቃን ታራ ኤቀታነሻ?","poem":1},{"text":"አካይ፥ እ ታና ስአና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ያን ሱረ አስ እያራ ሞተታናዉ ዳንዳኤስ፤","poem":1},{"text":"ታ ዳይናይ ታና መርናዉ ሻትንና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ሽን ታኒ ዶሎሀ ቢኮ እ ያን ዴና፤","poem":1},{"text":"ታኒ ዉሎሀ ቢኮ እያ ያን ደምከ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እ ፑደሀን ኦያ ዎደ ታኒ እያ በእከ፤","poem":1},{"text":"ዱገሀ ባጋ ስምያ ዎደ ታኒ እያ ደምከ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሽን እ ታ ታንጉዋ ኡባ ኤሬስ፤","poem":1},{"text":"እ ታና ፓጭያ ዎደ ታኒ ዎርቃዳ ጌያዳ ከያና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታ ቶሆይ እያ ታንጉዋ ካልድ ቤስ፤","poem":1},{"text":"እያ ኦግያፐ ሀድርስ ኡሻች ስማብከ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እያ ዶናፐ ከይያ ኪታፐ ታኒ ሻከታብከ፤","poem":1},{"text":"እያ ቃላ ታ ዎዛናን ዎስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ፆሳይ ላመተና፤","poem":1},{"text":"እያራ ኤቀታናይ ባዋ፥","poem":2},{"lineBreak":true},{"text":"እ ኮይዳባ ኦስ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እ ታ ቦላ ቆፕዳይሳ ፖልስ፤","poem":1},{"text":"ሄሳ መላ ሀራ ዳሮ ሀልቾት እያዉ ደኦሶና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሄሳ ግሾ፥ እያ ስንን ኤቃናዉ ዳሮ ያሼስ፤","poem":1},{"text":"ሄሳ ኡባ ቆፕያ ዎደ ኮኮራይስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ፆሳይ ታ ዎዛናይ ዶጫና መላ ኦስ፤","poem":1},{"text":"ኡባ ዳንዳእያ ፆሳይ ታና ዳጋንስ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሳካና ማይ ታ ሶምኡዋ ጎዝኮካ፥","poem":1},{"text":"ታና ሄ ማይ ሃሳያ ድግቤና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}