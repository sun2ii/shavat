{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"ኡባ ዳንዳእያ ፆሳይ ፕርዳ ዎደ አይስ ቃንፀኔ?","poem":1},{"text":"እያ ኤረይሳት ሄ ዎድያ አይስ ጮ ናጎና?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ኢታ አሳት ዛዋን ደእያ ሹቻ ደንሶና፤","poem":1},{"text":"ካይስ ኤህዳ ዶርሳታ ያን ሄሞሶና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ይኦ ናይታ ሀረታ ቦንቆሶና፤","poem":1},{"text":"አምኤ ቦራ አጮስ ኦይክድ ኤኮሶና።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ማንቆታ ሻተትድ ኦገፐ ጎዶሶና፤","poem":1},{"text":"ባንታ ስንፈ ቆሰታና መላ ኦሶና።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ባዞን ደእያ ዎራ ሀረ መላ፥","poem":1},{"text":"ማንቆት ባንታ ናይታስ ምያባ ኮይሸ ዳቡሮሶና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኤንቲ ሀራ አሳ ጋደን ካ ጫኮሶና፤","poem":1},{"text":"ኢታ አሳ ዎይነ ጋደን ቡ ማፆሶና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኤንቲ ቃማ ካሎ አቆሶና፤","poem":1},{"text":"ሜጎስ ቦላን የግያባይ ኤንታዉ ባዋ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዙማ ቦላ ቡክያ እራን ኤንቲ ሱሩፆሶና፤","poem":1},{"text":"ገልያ በሲ ይድ ሹቻ ሆምኦን አቆሶና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አው ባይና ናአ አየ ክኦፐ ዳፍ ኤኮሶና፤","poem":1},{"text":"ማንቁዋ ናአ አጮስ ኦይኮሶና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ማንቆት ማኦ ይድ ካሎ ሄመቶሶና፤","poem":1},{"text":"ኤንቲ ባንታዉ ኮሻትሸ ሀራ አሳ ምርቀ ቶኮሶና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኤንቲ ባንታዉ ሳሞትሸ፥","poem":1},{"text":"ዛይተ ከሳናዉ ሀራ አሳ ጋደን ሻማሆ አይፈ ማፆሶና፤","poem":2},{"lineBreak":true},{"text":"ዎይነ ኡሻ ጉሙአናዉ ዎይነ አይፈ ቆሮሶና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ካታማን ካታማን ሀይቃና ሀንያ አሳይ ኦሎሶና፤","poem":1},{"text":"ደሸትድ ማዱንፅዳ አሳይ ማዶ ኮይድ ዋሶሶና፤","poem":2},{"lineBreak":true},{"text":"ሽን ፆሳይ ኤንታ መቱዋ ፄለና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ፖኦ እፅያ አሳት፥","poem":1},{"text":"እያ ኦግያ ኤሮና አሳትነ፤","poem":2},{"lineBreak":true},{"text":"እያን ኤቆና አሳት ደኦሶና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሳእ ቃምያ ዎደ ሸምፖ ዎይስ ደንድድ፥","poem":1},{"text":"ማንቆታነ መቶታንቾታ ዎስ፤","poem":2},{"lineBreak":true},{"text":"ቃም ቃስ ካይሶስ ቦሶና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ላይማትያ አስ ሳእ ለምአናይሳ ናጌስ፤","poem":1},{"text":"ኦንካ በኦና መላ ባ ሶምኡዋ ካሜስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ካይሶት ቃማ ኬ ቦክድ ካይሶታናዉ ገሎሶና፤","poem":1},{"text":"ሽን ጋላስ ቆሰትድ ፔኦሶና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዳጋንያ ማራ ኤንቲ ዳቦትያ ግሾ፥","poem":1},{"text":"ሳካና ማይ ኤንታዉ ሴታ ጋላሳ መላ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“ሽን ኢታ አሳት ሃ ጎፖንቶ መላ፤","poem":1},{"text":"ኤንታ ላታ ቢታይ ባደትዳይሳ፤","poem":2},{"lineBreak":true},{"text":"ኦንካ ኤንታ ዎይነ ጋደ ቤና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሻች ማይን፥ ሃ መልድ የይሳዳ፥","poem":1},{"text":"ናጋራንቾት ሀይቅድ ቢታፈ ዮሶና።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"የልዳ አየት ኤንታ ዶጋና፤","poem":1},{"text":"ጉፁነይ ኤንታ አሹዋ ማና፤","poem":2},{"lineBreak":true},{"text":"ኢታ አሳይ ሀሳየቶኮና፤","poem":2},{"lineBreak":true},{"text":"ምዳ መቃና።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ኤንቲ ናእ ባይና ማይን ማጫሳ ናቅዶሶና፤","poem":1},{"text":"አምኤታ ቃቶና እፅዶሶና።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ፆሳይ ባ ዎልቃን ምኖታ ይስስ፤","poem":1},{"text":"ኤንታዉ ሳእ እንጀትዳ ዳንኮካ፥","poem":2},{"lineBreak":true},{"text":"ኩንዶና አቶኮና።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ፆሳይ ኤንቲ ሳሮ ዳናዳ ኦኮካ፥","poem":1},{"text":"ኤንታ ኦግያ ዎቼስ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ኢታ አሳት ጉ ዎደስ ቁ ቁ ጎሶና፤","poem":1},{"text":"ሽን ኤለስድ ሻራፋዳ ሹልድ ዮሶና፤","poem":2},{"lineBreak":true},{"text":"ካዳ ጫከቶሶና።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ሄስ ሀነና ግድ ካድያ አስ ደኢ?","poem":1},{"text":"ታኒ ኦድዳ ቃላ ዎርዶ ጋና አስ ደኢ?” ያግስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}