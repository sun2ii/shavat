{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":27,"content":[{"type":"heading","content":["እዮባ ሃሳያ"]},{"type":"verse","number":1,"content":["እዮብ ካልድ ሀይሳዳ ያግስ፤"]},{"type":"verse","number":2,"content":[{"text":"“ሱረ ፕርዳ ታና ድግድ፥","poem":1},{"text":"ታ ደኡዋ ጫሞ ኦዳ፥","poem":2},{"lineBreak":true},{"text":"ኡባ ዳንዳእያ ፆሳን ታኒ ጫቃይስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታ ሸምፖይ ደእሽን፥","poem":1},{"text":"ታ ሲይ ሸምፕሽን","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ታ ዶናይ ዎርዶ ኦደተና፤","poem":2},{"lineBreak":true},{"text":"ታ እንፃርሳይ ጭሞ ኦደተና።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ህንተ ኦዳይ ልከ ጋዳ ታ ኤክከ፤","poem":1},{"text":"ሀይቃና ጋካናዉ ታ ታና ሱረ ገይሳ አግከ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታ ፅሎተ ምን ኦይካናፐ አትሽን፥ አግከ፤","poem":1},{"text":"ታ ደእዳ ላይ ኡባን ታ ካሀይ ታና ሞተና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“ታ ሞርከት ናጋራንቾዳ፥","poem":1},{"text":"ታራ ኤቀተይሳት ባላ ግዶ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ፆሳይ ኤንታ ሸምፑዋ ኤንታፈ ኤክያ ዎደ፥","poem":1},{"text":"ኤንታ ላይ ቃምስያ ዎደ፥","poem":2},{"lineBreak":true},{"text":"ኢታታስ ደእያ ኡፋይሳይ አይቤ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኤንታ ቦላ መቶይ ጋክያ ዎደ፥","poem":1},{"text":"ፆሳይ ኤንታ ዋሱዋ ስኢ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኡባ ዳንዳእያ ፆሳን ኤንቲ ኡፋይታኔ?","poem":1},{"text":"ኤንቲ ኡባ ዎደ ፆሳ ፄጋኔ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“ታኒ ህንተና ፆሳ ዎልቃባ ታማርሳና፤","poem":1},{"text":"ኡባ ዳንዳእያ ፆሳ ቆፋ ታ ህንተፈ ቆትከ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ህንተ ኡባይ ሄሳ በእደታ፤","poem":1},{"text":"ያትን፥ ሀይሳ መላ ጮ ሃሳያ አይስ ኦደቴቲ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ፆሳይ ኢታ አሳታስ ጊግስዳ ቃዳይ፥","poem":1},{"text":"ኡባ ዳንዳእያ ፆሳፈ ኤክያ ዎይቶይ ሀይሳ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኤንታ ናይት አይ ዳርኮካ ኦላን ዉራና፤","poem":1},{"text":"ኤንታ ኮቻይ ምያባ ይድ ኮሻታና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሄሳፈ አትዳይሳት ጋዶን ዉራና፤","poem":1},{"text":"ኤንታ አምኤት ኤንታዉ ዬኮኮና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኢታ አሳት ብራ ቢታዳ ሺሽኮካ፥","poem":1},{"text":"ማኦ ኡርቃዳ ሺሽድ ዶርኮካ፥","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ኤንታ ብራ ፅሎ አሳት ሻክ ኤካና፤","poem":2},{"lineBreak":true},{"text":"ኤንታ ማኡዋ ጌሻት ማአና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ኤንቲ ኬፅያ ኬት ሻንጎ ሃዳ መላነ","poem":1},{"text":"ጋባ መላ ላለታና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ኢታ አሳት ዱረ ግድድ ሂፃን ዝንኦሶና፤","poem":1},{"text":"ሽን ኤንቲ ስኮፈ ባርክያ ዎደ አይኮይካ ባዋ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዳጋም ድኦ ሃዳ ቆፖና ኤንታ ቦላ ያና፤","poem":1},{"text":"ቃማ ጎተይ ኤንታ ደንድ ኤፋና።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዶሎሀ ጫርኮይ ኤንቲ ደእያሱዋፐ ፕትድ ኤፋና።","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ኤንቲ ከስ ኤካናዉ ባቃትሽን፥","poem":1},{"text":"ቃይ ባይና ኤንታ ቦላ ዎና።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ባ ኩሽያ ባቅድ ኤንታ ቦላ ቀልቅሳና","poem":1},{"text":"ባ ሱይቀን ኤንታ ሱግ የዳና።","poem":2}]}],"