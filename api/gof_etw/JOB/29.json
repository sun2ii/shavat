{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":["እዮብ ካልድ ሀይሳዳ ያግስ፤"]},{"type":"verse","number":2,"content":[{"text":"ሀእ ታ ደእያ ዱሳይ፥","poem":1},{"text":"ፆሳይ በን ታና ናግዳ ዎድያ ግዴረነ!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሄ ዎደ እያ ፆምፐይ ታ ቦላ ፖኤስ፤","poem":1},{"text":"እያ ፖኡዋን ማ ካንዳ ባይስ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሄ ዎደይ ፆሳይ ታ ኬ አንጅን፥","poem":1},{"text":"ታኒ ታ ናአተ ዎልቃራ ደእዳ ዎደ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሄ ዎደ ኡባ ዳንዳእያ ፆሳይ ታፐ ሻከትቤና፤","poem":1},{"text":"ታ ናይት ታ ዩሾን ደኦሶና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሄ ዎደ ታኒ ታ ኩሽያ ማን ሜጫይስ፤","poem":1},{"text":"ሹቻ ቢታን ቶከትዳ ሻማሆይ፥","poem":2},{"lineBreak":true},{"text":"ሻፋ ሃዳ ጎግያ ዛይተ እሜስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ታኒ ካታማ ፕርዳ ኬ ብዳ ዎደ፥","poem":1},{"text":"ሻንጎታራ እስፈ ኡታይስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሄ ዎደ ናአተት ታና በእድ ኦገ የዶሶና፤","poem":1},{"text":"ጭማት ታና ቦንቻናዉ ደንድ ኤቅዶሶና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሀላቃት ኦዳ አጋግዶሶና፤","poem":1},{"text":"ባንታ ኩሽያ ባንታ ዶና ቦላ ዎዶሶና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሄ ካታማን ደእያ ግታ አሳት ስእ ግዶሶና፤","poem":1},{"text":"ኤንታ እንፃርሳይ ኤንታ ኮቶኑዋ ባቅድ ኦይክስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታባ ስእዳ ኡባይ ናሼስ፤","poem":1},{"text":"ታና በእዳ ኡባይ ቦንቼስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሄስ ሀንዳይ፥","poem":1},{"text":"ታኒ ማንቆታ ዋሱዋ ስአዳ አሽዳ ግሾነ፥","poem":2},{"lineBreak":true},{"text":"ይኦ ናይታ ማድዳ ግሾሳ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሀይቃና ሀንያ አሳት ታና አንጅዶሶና፤","poem":1},{"text":"አምኤት ታ ማዱዋን ኡፋይትዶሶና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ፅሎተ ማኦዳ ማአስ፤","poem":1},{"text":"ሱረ ፕርዳ አፍላዳ ማአስ፤","poem":2},{"lineBreak":true},{"text":"ባርኔፃዳ ዎስ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ታኒ ቆቀታስ አይፈ፥","poem":1},{"text":"ዎበታስ ቶሆ ግዳስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ማንቆታስ አዋ ግዳስ፤","poem":1},{"text":"ኦገ አሳስ ፃባቃ ግዳስ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ታኒ ኢታታ ጋጩዋ መንስ፤","poem":1},{"text":"ኤንቲ ቦንቅዳይሳ ኤንታ ዶናፐ የግሳስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ታኒ ታ ዎዛናን፥ “ታ ላይይ ሻፈዳ ዳርን፥","poem":1},{"text":"ታ ሶን ቦንቾን ሀይቃና” ጋዳ ቆፓስ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ታኒ ፃጱዋ ሃን የድዳ፥","poem":1},{"text":"ታሽያ ቦላ አክ ኩምዳ ም መላሽን!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ታ ቦንቸትዳ መላ ደአስ፤","poem":1},{"text":"ታ ዎልቃይ ኡባ ዎደ ኦራሽን!","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ታ ሃሳያ ዎደ ስእ ግድ ስኤስ፤","poem":1},{"text":"ታ ዞርያ ኡፋይሳን ኤኮሶና።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ታ ኤንታና አልያ ግሾ፥","poem":1},{"text":"ታ ኦዳ ስምን ታፐ ጉየራ ኦድያ አስ ባዋ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ጎሻንቾይ እራ ናገይሳዳ፥","poem":1},{"text":"ኤንቲ ታ ሃሳያ ስአናዉ ሀካንክድ ናጎሶና።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ኤንቲ ህርጋን ደእሽን ታ ሶምኡዋ ፓሽክሳይስ፤","poem":1},{"text":"ታ ሚቻይ ኤንታ ምንስ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ታኒ ኤንቲ ዳና ኦግያ ዶራዳ ኤንታዉ ሀላቃ ግዳስ።","poem":1},{"text":"ባ ኦላንቾታ ግዶን ደእያ ካዎዳ ታ ኤንታ ግዶን ደአስ፤","poem":2},{"lineBreak":true},{"text":"ኤንቲ አዛንያ ዎደ ምንስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/28.json","previousChapterAudioLinks":{},"numberOfVerses":25}