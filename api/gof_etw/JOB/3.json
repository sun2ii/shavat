{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":3,"content":[{"type":"heading","content":["እዮባ ሃሳያ"]},{"type":"verse","number":1,"content":["ሄሳፈ ጉየ፥ እዮብ ባ ዶና ዶይድ፥ ባ የለትዳ ጋላሳ ሀይሳዳ ያግድ ባድስ።"]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“ታኒ ቃንትዳ ቃማይነ","poem":1},{"text":"የለትዳ ጋላሳይ ባደትዳባ ግዶ!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሄ ጋላሳይ ማን ላመቶ!","poem":1},{"text":"ሳሎ ፆሳይ ሄ ጋላሳ ቆፖፎ፤","poem":2},{"lineBreak":true},{"text":"እያ ቦላ ፖኦይካ ፖኦፖ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሳካና ምነ ጫጋን እያ ጎዞ፤","poem":1},{"text":"እያ ሻሪ ካሞ፤","poem":2},{"lineBreak":true},{"text":"እያ ፖኡዋ ም ቆሶ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሄ ጋላሳ ቃማ ሳካና ም ኦይኮ።","poem":1},{"text":"ላይ ግዶን ደእያ ጋላሳታን ታይበቶፎ፤","poem":2},{"lineBreak":true},{"text":"አጌናታ ታይቦንካ ገሎፖ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሄ ቃማይ ማይኖ፤","poem":1},{"text":"ኡፋይሳ እልልስ እያን ስኤቶፎ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሌዋታነ","poem":1},{"noteId":0},{"text":"ደንናዉ ዳንዳኤይሳትነ","poem":1},{"text":"ጋላሳታ ባደይሳት ሄ ጋላሳ ባዶ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሄ ቃማን ባካል ፖኦፖ፤","poem":1},{"text":"ፖኦ ናግድ ደሞፎ፤","poem":2},{"lineBreak":true},{"text":"ዎንታ ፃልቀይ እያዉ ዶሎፖ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሄ ጋላሳይ ታኒ ታ አየ ኡሎን ቃንቶና መላነ","poem":1},{"text":"ሀ ዋይያ በኦና መላ አሽቦና ግሾ ባደትዳይሳ ግዶ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“ታኒ ታ አየ ኡሎን ሃ ግድዳ ግዳርክና!","poem":1},{"text":"ታ አየ ኡሎፐ የለታ ዎዳ መላ ሀይቅዳ ግዳርክና!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ታ አይያ ታና አይስ ባ ክኦን ኤካደሻ?","poem":1},{"text":"ባ ንካ ታና አይስ ንደሻ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሄ ዎደ ታኒ ሀይቅዳባ ግድያኮ፥","poem":1},{"text":"ሀእ ታኒ ሸምፓዳ ስካና ሽን!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሀእ ላለትዳ በሳታ ባንታዉ ኬፅዳ፥","poem":1},{"text":"ሀ ሳኣ ካዎታራነ ዞረይሳታራ፥","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ኤንታ ኬን ዎርቃይነ ብራይ ኩምዳ ሀላቃታራ","poem":2},{"lineBreak":true},{"text":"እስፈ ዱፎን ዝንአናሽን!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዎይኮ ቦሻ ግድድ የለትዳ ናአዳ፥","poem":1},{"text":"ጋላሳ ፖኦ በእቦና ዮጋ ናአዳ ቢታ ግዶን አይስ ቆሰታብክና?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዱፎን ኢታት ባንታ ኢታ ኦሶ አጎሶና፤","poem":1},{"text":"ያን ዳቡራንቾት ሸምፖሶና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሄ በሳን ቃሾ አሳት ሸምፕድ ኡፋይቶሶና፤","poem":1},{"text":"ኤንታ ኡንኤይሳታ ዋሱዋ ያን ስኦኮና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ግትነ ጉ ያን ደኤስ፤","poem":1},{"text":"አይለትካ አይለተፈ ያን ላአ ከዮሶና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“መቶን ደኤይሳታስ፥","poem":1},{"text":"ሸምፖይ ጫመትዳይሳታስ፥","poem":2},{"lineBreak":true},{"text":"ፖኦይ አይስ እመትዴ?","poem":2}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ሀይቆ አሞትድ ደሞናይሳታስ፥","poem":2},{"lineBreak":true},{"text":"ቆትድ ዎዳ ሻሎፐ አድ ኮየይሳታስ፥","poem":2},{"lineBreak":true},{"text":"ደኦይ አይስ እመትዴ?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዱፎ ጋክያ ዎደ ኡፋይተይሳታስ፥","poem":1},{"text":"ደኦይ አይስ እመትዴ?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ኦገይ ይዳ ኡራስ፥","poem":1},{"text":"ፆሳይ እያ ዩሹዋ ድርዳ ኡራስ፥","poem":2},{"lineBreak":true},{"text":"ፖኦይ አይስ እመትዴ?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ኦለይ ታዉ ካ ግድስ፤","poem":1},{"text":"ታ ዋሶይ ጎግያ ሃ ግድስ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ታኒ ያይዳባይ ታ ቦላ ጋክስ፤","poem":1},{"text":"ታኒ ዳጋምዳባይ ታዉ ሀንስ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ታዉ መቶፐ አትሽን፥","poem":1},{"text":"ሳሮይ፥ ዎፕነ ሸምፖይ ባዋ” ያግስ።","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"ሌዋታነ፦ ሃን ደእያ ዎልቃማ ዶአ።","reference":{"chapter":3,"verse":8}}]},"thisChapterLink":"/api/gof_etw/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":25}