_break"},{"type":"verse","number":9,"content":[{"text":"ሀእ ኤንታ ናይት ታና የን ጫዶሶና፤","poem":1},{"text":"ታኒ ኤንታ ግዶን ሀይሰስ አታስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኤንቲ ታና ሻተትድ ታፐ ሃኮሶና፤","poem":1},{"text":"ዬላቶና ታ ሶምኦን ጩቶሶና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ፆሳይ ታ ዎልቃ ላፈድ ታና ካዉሽዳ ግሾ፥","poem":1},{"text":"ኤንቲ ታና ቆሀናዉ የዳ ፓራ ግድዶሶና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሴር ባይና ድጭዳ ናይት ታ ቦላ ደንድዶሶና፤","poem":1},{"text":"ታ ቶሁዋስ ፅሄ ዎዶሶና፤","poem":2},{"lineBreak":true},{"text":"ኤንቲ ታና ይሳናዉ ተቅዶሶና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኤንቲ ታ ኦግያ ጎርድድ ታና ይሳናዉ ኮዮሶና፤","poem":1},{"text":"ኤንቲ ሄሳ ኦና መላ ተቅያ ኦንካ ባዋ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኦላንቾት ካታማ ድርሳ መንድ ገለይሳዳ፥","poem":1},{"text":"ኤንቲ ታ ቦላ ይዶሶና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ታኒ ግታ ዳጋማ ዳጋማስ፤","poem":1},{"text":"ታ ቦንቾይ ጫርኮይ ኤፍያዳ ብስ፤","poem":2},{"lineBreak":true},{"text":"ታ ሳሮ ዱሳይ ሻራዳ ይስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ታ ሸምፕያ ዳሮ ኡንኤታሱ፤","poem":1},{"text":"መቶይ ታና ጩጩምድ ኦይክስ።","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ቃማ ቃማ ሳሆይ ታ መቀ ጮሜስ፤","poem":2},{"lineBreak":true},{"text":"ሴላይ ታዉ ሸምፖ እመና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ፆሳይ ባ ግታ ዎልቃን ታ ማኡዋ ሺሽድ ኦይክስ፤","poem":1},{"text":"ቆ ኦይክያ ማኦዳ ታና ጩልስ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ፆሳይ ታና ኡርቃን ሆልስ፤","poem":1},{"text":"ታኒ ባናነ ብድን ግዳስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"አቤት ፆሳዉ፥ ታኒ ኔኮ ዋሳይስ፤","poem":1},{"text":"ሽን ኔኒ ታና አላባካ።","poem":2},{"text":"ኤቃዳ ነና ዎሳስ፤","poem":1},{"text":"ሽን ኔኒ ታ ዎሳ ስአባካ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ኔኒ ታዉ ዎዛና ምኖ ግዳዳሳ፤","poem":1},{"text":"ነ ግታ ዎልቃን ታና የደሳ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ኔኒ ታና ጫርኮራ ደንዳ ጎዳዳሳ፤","poem":1},{"text":"ጎተን ታና ሀርቃዳሳ።","poem":2}]},{"type":"v