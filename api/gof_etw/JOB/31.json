{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":[{"text":"“ጌላኦ ፄላዳ አሞቶና መላ፥","poem":1},{"text":"ታኒ ታ አይፍያራ ጫቀታስ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ቦላን ደእያ ፆሳ ማታፐ አሳስ እመትዳ ቃዳይ አይቤ?","poem":1},{"text":"ሳሎን ደእያ ኡባ ዳንዳእያ ፆሳይ አሳስ እምያ ግሾይ አይቤ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኢታታ ቦላ ቦሽ፥ ባላ ኦይሳታ ቦላ ጋዶይ","poem":1},{"text":"ጋካናይስ ኤረትዳባ ግደነዬ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ፆሳይ ታ ኦግያ ኡባ በኤነዬ?","poem":1},{"text":"ታ ታንጉዋ ኡባ ታይበነዬ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ታኒ ዎርዶን ደእዳባ ግድኮ፥","poem":1},{"text":"አሰ ጭምዳባ ግድኮ፥","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ፆሳይ ታና ልከ ምዛነን ማዛኖ፤","poem":1},{"text":"ያትድ ታ ፅሎ ግደይሳ በኦ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታ ሄመይ ኦገፐ ከይዳባ ግድኮ፥","poem":1},{"text":"ታ ዎዛናይ ታ አይፈይ ፄልዳባ አሞትዳባ ግድኮ፥","poem":2},{"lineBreak":true},{"text":"ታ ኩሸይ ናጋራን ቱንዳባ ግድኮ፥","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ታ ዶላይ ሾደትድ ዮ፤","poem":2},{"lineBreak":true},{"text":"ታ ዘርዳይሳ ሀር ሞ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ታ ዎዛናይ ሀራ ማጫስ አሞትዳባ ግድኮ፥","poem":1},{"text":"ዎይኮ ታኒ ታ ሾሩዋ ማችዉ ጌድዳባ ግድኮ፥","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ታ ማችያ ሀራ አሳስ ጋጮ፤","poem":2},{"lineBreak":true},{"text":"ኢራ ሀራ አደይ አቆ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሄስ ዬላይያ ናጋራስ ኮሽያ","poem":1},{"text":"ግታ ፕርዳ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሀ ናጋራይ ታማዳ ፁግያባ ግድያ ግሾ፥","poem":1},{"text":"ታ አቁዋ ኡባ ይሳናሽን።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ታ አደ ዎይኮ ታ ማጫ አይለት አቤት ግን፥","poem":1},{"text":"ኤንታዉ ፕርዶና እፅዳባ ግድኮ፥","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ፆሳ ስንን ታ ፕርዳስ ሺቅያ ዎደ ዋናኔ?","poem":1},{"text":"እ ታና ኦይችያ ዎደ ታኒ ዎይጋ ዛራኔ?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ታና መዳ ፆሳይ ኤንታ እ መበነዬ?","poem":1},{"text":"ኑና ኡባ ኑ አየ ኡሎን መዳይ እስ እያ ግደነዬ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“ታኒ ማንቆት ዎስዳባ ድግዳባ ግድኮ፥","poem":1},{"text":"ዎይኮ አምኤታ ምንና አግዳባ ግድኮ፥","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ይኦ ናይት መላ አቅያ ዎደ በአሸ፥ ታኒ ታርካ ምዳባ ግድኮ፥","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ታኒ ኤንታ ታ ናአተፈ ዶማዳ ኤንታ አዋዳ ድቻስ፤","poem":1},{"text":"ታ የለቶሶፐ ዶማዳ አምኤታ ማዳስ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ማኦይ ይን ሜጎይ ዎያ ኡራ፥","poem":1},{"text":"ዎይኮ ካሎ ደእያ መቶታንቹዋ በአዳ፥","poem":2}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ታ ዶርሳታ እክሰፐ ኦሰትዳ ማኦ ማይዝን፥","poem":2},{"lineBreak":true},{"text":"ታና አንጆና ብዳይ ደእኮ፥","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ታኒ ሞቶን ኤንታ ሻትማናይሳ ኤራዳ፥","poem":1},{"text":"ይኦ ናይታ ናቅዳባ ግድኮ፥","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ታ ቀሰይ ኩርያፐ መኦ፤","poem":2},{"lineBreak":true},{"text":"ታ ኩሸይ ሀሽያፐ ካረት ዎ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ፆሳ ሀንቁዋ ያይዳ ግሾ","poem":1},{"text":"ሄሳ ኦናዉ ዳንዳእከ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“ታኒ ዎርቃን አማነትዳባ ግድኮ፥","poem":1},{"text":"ዎይኮ ዋላህ ባይና ዎርቃ ‘ታ ጬቆይ ነና’ ግዳባ ግድኮ፥","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ታ ዱረተ ዳሮተን፥","poem":1},{"text":"ታ ኩሸይ ደምዳ ዎን ኡፋይትዳባ ግድኮ፥","poem":2}]},{"type":"verse","number":26,"content":[{"text":"አዋ ጶለ በአዳ፥","poem":1},{"text":"ዎይኮ አጌና ሎኦተ ፄላዳ፥","poem":2}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ታ ዎዛናይ ጌማን ኤንታ ናሽቤና፥","poem":2},{"lineBreak":true},{"text":"ዎይኮ ታ ኤንታ ዬራዳ ጎይናብከ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ሄስ ፕርዳ ኤህያ ናጋራ ግድያ ግሾ","poem":1},{"text":"ፆሳ ካዳስ ጉሱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“ታ ሞርከታ ኩንደን ኡፋይታብከ፤","poem":1},{"text":"ኤንታ ጋክዳ መቱዋን ሀሹ ጋብከ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"‘ታ ሞርከይ ዮ’ ያጋ ባዳዳ፥","poem":1},{"text":"ናጋራ ኦብከ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ታ ሶ አሳይ፥ ‘እያ ሶን","poem":1},{"text":"ካ ምድ ካሎናይ ኦኔ?’ ያግድ ማርካቶሶና።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ታ ሶይ ኡባ ዎደ ዶያ ግድያ ግሾ፥","poem":1},{"text":"ኦገ አስ ካረን አቅ ኤረና።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ሀራት ኦይሳዳ፥","poem":1},{"text":"ታ ናጋራ ታ ዎዛናን ገንብከ።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"አሳ ፖኮስ ያያዳ፥","poem":1},{"text":"ኤንታ ቦርያስ ዳጋማዳ፥","poem":2},{"lineBreak":true},{"text":"ሶ ገላዳ ቆሰትዳ ዎደይ ዴና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"“ታና ስእያ አስ ደኤረነሽን፥","poem":1},{"text":"ታ ኦዳይ ቱማ ግደይሳ ፓራማይስ፤","poem":2},{"text":"ኡባ ዳንዳእያ ፆሳይ ታዉ ዛሮ እሞ","poem":1},{"text":"ታ ሞርከይ ባ ሞቱዋ ፃፍድ ሺሽን","poem":2},{"lineBreak":true},{"text":"ታ በአርክናሽን።","poem":2}]},{"type":"verse","number":36,"content":[{"text":"በእያኮ ዎይቶዳ ቆን አዳ ማአናሽን፥","poem":1},{"text":"ካላቻዳ ታ ሁጰን ዎናሽን!","poem":2}]},{"type":"verse","number":37,"content":[{"text":"ታኒ ማት ደእያ አሳዳ ፆሳኮ ሺቃዳ፥","poem":1},{"text":"ታ ኦዳባ ኡባ እያዉ ቆንጭሳናሽን!","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"“ታ ጎሻ ቢታይ ታ ቦላ ዋስዳባ ግድኮ፥","poem":1},{"text":"ዳሳትካ አፉን ላክዳባ ግድኮ፥","poem":2}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"ሄ ቢታን ካፅዳባ ሚሸ ቃንፆና ኤክዳባ ግድኮ፥","poem":2},{"lineBreak":true},{"text":"ዎይኮ ሄ ቢታ ኦይሳታ ኮሻን ዎዳባ ግድኮ፥","poem":2}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"ታዉ ሄ ቢታን ግስተ ግሾ አጉን፥","poem":2},{"lineBreak":true},{"text":"ባንጋ ግሾ ሻራፍ ዶሎ” ያግስ።","poem":2},"እዮባ ኦዳይ ሄሳን ፖለትስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}