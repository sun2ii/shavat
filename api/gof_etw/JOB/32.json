{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":32,"content":[{"type":"heading","content":["ኤልሁ ሃሳያ"]},{"type":"verse","number":1,"content":["እዮብ፥ “ታኒ ፅሎ አስ” ግዳ ግሾ፥ ሀ ሄ አሳት እያዉ ዛሮ እሞ አጋግዶሶና።"]},{"type":"verse","number":2,"content":["እዮብ ፆሳፈ አድ ባና ፅሎ ኦዳ ግሾ፥ ራማ ያራፐ ግድዳ ቡዛ ቢታፈ ይዳ ባርከላ ናአይ ኤልሁይ እዮባ ቦላ ሀንቀትስ።"]},{"type":"verse","number":3,"content":["ኤንቲ እያ ጮ ባላ ግድ ፕርድድ፥ እያዉ በሲያ ዛሮ እማናዉ ዳንዳእቦና ግሾ ኤልሁይ ሀ ሄ ላገታ ቦላካ ሀንቀትስ።"]},{"type":"verse","number":4,"content":["ኤልሁይ ኤንታፈ ካሎትያ ግሾ ኤንቲ ኡባይ ሃሳያ ዉርሳና ጋካናዉ ናግስ።"]},{"type":"verse","number":5,"content":["ሀ ሄ አሳት እዮባስ በሲያ ዛሮ እማናዉ ዳንዳእቦናይሳ በእድ እ ዳሮ ይሎትስ።"]},{"type":"verse","number":6,"content":["ቡዛ ቢታፈ ይዳ ባርከላ ናአይ ኤልሁይ ሀይሳዳ ያግድ ሃሳያ ዶምስ።",{"text":"“ታኒ ህንተፈ ናአታይስ፤","poem":1},{"text":"ህንተ ታፐ ባይራተታ፤","poem":2},{"lineBreak":true},{"text":"ሄሳ ግሾ፥ ታኒ ታ ቆፋ ህንተዉ ኦዳናዉ ያያስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታኒ፥ ‘ጭማት ኦደቶ፤","poem":1},{"text":"ባንታ ዳሮ ላይን ደምዳ ጭንጫተ ታማርሶና’ ” ጋዳ ቆፓስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሽን አሳ ግዶን አቅድ ጭንጫተ እመይ፥","poem":1},{"text":"ኡባ ዳንዳእያ ፆሳ አያና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አሰ ጭንጫ ኦይ ጭማተ ግደና፥","poem":1},{"text":"ዎይኮ አሳስ አኬካ እመይ ላይ ዳሮተ ግደና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሄሳ ግሾ፥ ስእተ፤","poem":1},{"text":"ታካ ታ ቆፋ ህንተዉ ኦዳና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ህንተ ሃሳያ ዎደ፥","poem":1},{"text":"ታኒ ስእ ጋዳ ሀይዛስ፤","poem":2},{"lineBreak":true},{"text":"ህንተ ኦዳና ቃላ ኮይሽን ናጋስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ህንተ ገይሳ ኡባ ዉርሳዳ ስአስ፤","poem":1},{"text":"ሽን ህንተፈ ኦንካ እዮባ ባላ ግድ አማንበና፤","poem":2},{"lineBreak":true},{"text":"ህንተፈ ኦንካ እያ ፓላማስ በሲያ ዛሮ እምቤና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እዮባ ኦዳስ ካልስያ ዛሮ እማናዉ ዳንዳኤይ፥","poem":1},{"text":"ፆሰፈ አትሽን፥ አሰ ግዶና ግሾ፥","poem":2},{"lineBreak":true},{"text":"ህንተ፥ “ኑስ ጭንጫተ ደኤስ” ጎፕተ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እዮብ ፓላምዳይ ታራ ግዶናሽን ህንተራ፤","poem":1},{"text":"ታኒ ህንተ ኦዳዳ እያዉ ዛሮ እምከ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ኤንቲ ዳጋምድ፥","poem":1},{"text":"ጋናባ ይዳ ግሾ፥","poem":2},{"lineBreak":true},{"text":"ዛሮ እማናዉ ዳንዳእቦኮና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ያትን ኤንቲ ኦደትያባ ይድ ስእ ግድ ኤቅኮ፥","poem":1},{"text":"ታኒ ናጋናዉ ኮሺ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ግደና፥ ታኒ ኦድያባይ ደኤስ፤","poem":1},{"text":"ታካ ታ ቆፋ ቆንጭሳና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ታ ኦዳናባይ ዳሮይ ደእያ ግሾ፥","poem":1},{"text":"ታ ግዶን ደእያ አያናይ ታና ኦዳ ግድ ሱጌስ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ታ ጋይ ጎዘትዳ ማናጨዳ፥","poem":1},{"text":"ዎይኮ ማልአንቶ ዎይነ ኡሽ ኩምዳ ኦጎሮዳ","poem":2},{"lineBreak":true},{"text":"ቃና ሀኔስ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ታ ኦዳዳ ከሳናዉ በሴስ፤","poem":1},{"text":"ታ ዶና ዶያዳ ዛሮ እማናዉ ኮሼስ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሀ ኦዳን ታኒ ኦናካ ማድከ፥","poem":1},{"text":"ዎይኮ ኦናካ ጮ ሳቢከ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"አሰ ጮ ሳቢያባይ ታዉ ኤረተና፤","poem":1},{"text":"ታ ሄሳ ኦያኮ ታና መዳይስ ፕርዳናሽን።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/31.json","previousChapterAudioLinks":{},"numberOfVerses":22}