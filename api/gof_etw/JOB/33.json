:1},{"text":"ታኒ ፅሎነ ናጋራ ኦቦና አስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሽን ፆሳይ ታና ሴራናዉ ጋሶ ኮዬስ፤","poem":1},{"text":"እ ታና ባ ሞርከዳ ታይቤስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታ ቶሁዋ ዱፅስ፤","poem":1},{"text":"ታ ታንጎ ኡባ እ ዎቼስ” ያጋዳሳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“እዮባ፥ ነ ኦዳይ ልከ ግደና፤","poem":1},{"text":"ታ ነዉ ኦዳይስ፥ ፆሳይ አሳፐ አስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"‘ፆሳይ አሳ ኦዳስ ዛሮ እመና’ ጋዳ፥","poem":1},{"text":"አይስ እያራ ፓላማይ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አስ አኬከናፈ አትሽን፥","poem":1},{"text":"ፆሳይ ዱማ ዱማ ኦገራ ኦዴስ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አስ ቃማ ሂፃን ዝንእድ፥","poem":1},{"text":"ስኮ ኤይድ ደእያ ዎደ፥","poem":2},{"lineBreak":true},{"text":"ፆሲ አሙሆንነ ቆንጨን ኦዴስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሄ ዎደ አሳይ ስአናዳ ሀይ ዶዬስ፤","poem":1},{"text":"ባ ሴራን ኤንታ ዳጋንስ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ያትድ አስ ናጋራ ኦና መላ ተቄስ፤","poem":1},{"text":"ኦቶሮ አሳፐ ድጌስ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ፆሲ አሰ ዮፐ አሼስ፤","poem":1},{"text":"ሀይቆፐካ ናጌስ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አስ ሀርገትድ ሂፃን ደእሽን፥","poem":1},{"text":"እያ መቀ ጋርሳን ቃንፆና ሳሆ የድድ ሴሬስ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ሄሳዳ ሀንድ ሀርግዳ ኡራይ ካ እፄስ፤","poem":1},{"text":"ዳሮ ማልኦ ካ እያ ሻቴስ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"እያ አሾይ ግልቅድ ዉሬስ፤","poem":1},{"text":"እያ አሳተይ መልን መቀ ታይበቴስ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"እያ ሸምፖይ ዱፎኮ፥","poem":1},{"text":"እያ ደኦይ ሀይቆ ኪታንቾታኮ ማቴስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“አሳስ ሱረ ኦግያ በሲያ","poem":1},{"text":"ሙኩሉን ታይበትያ ኪታንቾታፐ","poem":2},{"lineBreak":true},{"text":"እሶይ እያ ማዳናዉ ዳንዳኤስ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"እያዉ ቃትድ፥ ‘እ ዱፎ ገሎና መላ እያ አሻ፤","poem":1},{"text":"ታኒ እያ ዎዝያባ ደማስ፤","poem":2},{"lineBreak":true},{"text":"እያ አጋጋ’ ያግድ ሀይቆስ ኦዴስ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ሄሳ ግሾ፥ እያ አሳተይ ናአ አሳተ ግዳና፤","poem":1},{"text":"እያ ያላጋተ ዎልቃይ እያዉ ስማና።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ሄ ዎደ እ ፆሳ ዎሳና፤","poem":1},{"text":"ፆሳይ እያ ዎሳ ስአና፤","poem":2},{"lineBreak":true},{"text":"ፆሳይ እያዉ እያ ፅሎተ ዛርያ ግሾ፥ እ ኡፋይሳን ፆሳ ጎይናና።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ሄ ዎደ አሳ ስንን እ ሀይሳዳ ያግድ የፃና፤","poem":1},{"text":"‘ታኒ ናጋራ ኦስ፤ ሱረባ ጌላያስ፤","poem":2},{"lineBreak":true},{"text":"ሽን ፆሳይ ታ ሀኑዋ ታዉ ቃንፅቤና።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ታ ዱፎን ገሎና መላ ታና አሽስ፤","poem":1},{"text":"ሀእ ፓፃ ደአዳ ፖኦ በአይስ’ ያጋና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“ሄኮ፥ ፆሲ አሳስ ሄሳ ኡባ","poem":1},{"text":"ዛር ዛር ኦስ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"እ ደኦ ፖኦ በአና መላ፥","poem":1},{"text":"እያ ሸምፑዋ ዱፎፐ አሼስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“እዮባ፥ ታኒ ኦደይሳ ሀይዛዳ ስአ፤","poem":1},{"text":"አነ ነ ስእ ጋ፤ ታኒ ኦደታና።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ነ ኦዳናዉ ኮያባይ ደእኮ ኦዳ፤","poem":1},{"text":"ታኒ ነ ፅሎ ግደይሳ በአናዉ ኮያይስ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"አቶ ጊኮ ስእ ጋዳ፥ ታ ሃሳያ ስአ፤","poem":1},{"text":"ታ ነና ጭንጫተ ታማርሳና” ያግስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/32.json","previousChapterAudioLinks":{},"numberOfVerses":33}