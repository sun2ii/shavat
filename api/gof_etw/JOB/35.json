{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":["ኤልሁይ ቃስ ሀይሳዳ ያግስ፤"]},{"type":"verse","number":2,"content":[{"text":"“እዮባ፥ ኔኒ፥ ‘ታኒ ፆሳ ስንን ፅሎ’","poem":1},{"text":"ገይስ ልኬ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"‘ታኒ ናጋራ ኦና አጋዳ አይ ጎኤትያና?","poem":1},{"text":"አይ ዎ ደማኔ?’","poem":2},{"lineBreak":true},{"text":"ያጋዳ ነ ፆሳ ኦይቻናዉ ዳንዳኣሳ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታኒ ነዉነ","poem":1},{"text":"ነ ላገታስ ዛሮ እማና።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ቁ ጋዳ ሳሎታ ፄላ፤","poem":1},{"text":"ኔፐ ቦላራ ደእያ ሻራ አኬካዳ በአ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ነ ናጋራ ኦኮ ፆሳ አይብን ቆሀኔ?","poem":1},{"text":"ነ ባላይ ዳርኮ ሄስ እያዉ አይ ኦ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ነ ፅሎ ግድኮ እያዉ አይ እማኔ?","poem":1},{"text":"ዎይኮ ነ ኩሸፐ እ አይ ኤካኔ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ነ ናጋራ ኦኮ ነ መላ አሰ ቆሃሳ፤","poem":1},{"text":"ቃስ ፅልኮካ አሰ ጎኣሳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ኡንእ ዳርያ ዎደ አሳይ ዋሴስ፤","poem":1},{"text":"ዎልቃማታ ኩሸፐ ከስ ኤክያ አስ ኮይድ ዎባቶሶና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሽን ኦንካ፥ ‘ቃማ ማዝሙረ እምያ፥","poem":1},{"text":"ታና መዳ ፆሳይ አዉን ደኢ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዶአታፐ አድ ታማርሰይስ፥","poem":2},{"lineBreak":true},{"text":"ካፎታፐ አድ ጭንጫ ኦይስ አዉን ደእ’ ያገና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኤንቲ ዋሶሶና፤","poem":1},{"text":"ሽን ፆሳይ ኤንታ ኦቶሩዋ ጋሶን፥","poem":2},{"lineBreak":true},{"text":"ኤንታዉ ዛሮ እመና።","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ጮ ዋሱዋ ፆሲ ቱማ ስኤና፤","poem":2},{"lineBreak":true},{"text":"ኡባ ዳንዳእያ ፆሳይ ሄሳ ሀይዘና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኔኒ ታ ፆሳ በአናዉ ዳንዳእከ ያግኮካ፥","poem":1},{"text":"ነ ሞቶይ እያ ስንን ደእያ ግሾ፥","poem":2},{"lineBreak":true},{"text":"ነ እያ ዳንዳአን ናጋናዉ በሴስ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ፆሳይ አሰ ፕርዶናባነ","poem":1},{"text":"ናጋራ አግድ አና ጋዳ ቆፓይ?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሄሳ ግሾ፥ ኔኒ ነ ዶና ጮ ዶያሳ፤","poem":1},{"text":"ኤር ባይና ሃሳያ ዳርሳሳ” ያግስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}