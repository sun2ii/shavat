{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":36,"content":[{"type":"verse","number":1,"content":["ኤልሁይ ጉጅድ ሀይሳዳ ያግስ፤"]},{"type":"verse","number":2,"content":[{"text":"“ፆሳ ዶና ግዳዳ ታ ነዉ ኦድያባይ ደእያ ግሾ፥","poem":1},{"text":"ጉ ዳንዳአዳ ስአ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታኒ ታ ኤራ ሃሆ ሶፐ ኤሀና፤","poem":1},{"text":"ታና መዳይስ ፅሎ ግደይሳ ቆንጭሳና።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታኒ ዎርዶ ሃሳይከ፤","poem":1},{"text":"ኩመ ኤር ደእያ አስ ኔራ ደኤይሳ አማና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ፆሳይ ቱማ ዎልቃማ፤","poem":1},{"text":"ሽን እ ኦናካ ካና።","poem":2},{"lineBreak":true},{"text":"እ ባ አኬካን ምኖ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እ ኢታት ደኦን ዳና መላ ኦና፤","poem":1},{"text":"ሽን ኡንኤትዳይሳታስ ሱረ ፕርዴስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ፆሳይ ባ አይፍያ ፅሎታ ቦላፈ ደንና፤","poem":1},{"text":"ኤንታ ካዎታራ ኡትስድ፥","poem":2},{"lineBreak":true},{"text":"መርናዉ ቁ ቁ ኦስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሽን አሳይ ሳንላታን ቃሸትኮ፥","poem":1},{"text":"ዎይኮ መቶ ዎዶሮን ኦይከትኮ፥","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"እ ኤንታ ኦሱዋነ","poem":2},{"lineBreak":true},{"text":"ኦቶሮን ኦዳ ናጋራ ኤንታ ቦላ ቆንጭሴስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሴራ ስአናዳ ኤንታ ሀይ ዶዬስ፤","poem":1},{"text":"ናጋራፐ ስማና መላ ኤንታ ኪቴስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኤንቲ ስእድ እያዉ ኪተትኮ፥","poem":1},{"text":"ባንታ ላይ ሳሮንነ ኡፋይሳን ዉርሳና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሽን ኤንቲ ስኦና እፅኮ ማሻን ዉራና፤","poem":1},{"text":"ኤንቲ ኤራ ይዳ ግሾ ሀይቃና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ፆሳ አማኖና አሳት","poem":1},{"text":"ባንታ ዎዛናን ይሎትዳ መላ ደኦሶና፤","poem":2},{"lineBreak":true},{"text":"እ ኤንታ ፕርድያ ዎደ ማደ ኮይድ ዎሶኮና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኤንቲ ኦያ ቱና ኦሱዋን ያና፤","poem":1},{"text":"ባንታ ናአተን ሀይቃና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሽን ዋየተይሳታ ኤንታ ዋያፐ አሼስ፤","poem":1},{"text":"ኤንታ መቱዋ ባጋራ ኤንታዉ ኦዴስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“ፆሳይ ነና መቶ ዎዶሮፐ፥","poem":1},{"text":"ኡንእ ባይና ዳልጋ በሲ፥","poem":2},{"lineBreak":true},{"text":"ዶረትዳ ካ ኩምዳ ጋይታኮ ከሳና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሽን ሀእ ኢታታ ቦላ ጋክያ ፕርዳይ ነ ቦላ ጋክን፤","poem":1},{"text":"ፅሎ ፕርዳን ኦይከታዳሳ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ኦንካ ነና ዱረተ በስድ ጭሞና መላ፥","poem":1},{"text":"ዎፈ ዳሮይ ባለና መላ ናገታ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ነ ዱረተይ","poem":1},{"text":"ዎይኮ ነ ዳፈተይ ነና መቶፐ አሻኔ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አሳይ ባንታ በሳፈ ይያ ቃማይ፥","poem":1},{"text":"ያና መላ አሞቶፋ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሀ መቶ ኡባይ ነና ጋክዳይ ሄሳ ጋሶና፤","poem":1},{"text":"ሄሳ ግሾ፥ ኢታ ኦና መላ ናገታ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“ፆሳይ ባ ዎልቃን ቁ ቁ ግስ፤","poem":1},{"text":"እያ መላ አስታማረይ ኦኔ?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ፆሳ፥ ‘ሀይሳ ኦ’ ግድ ኪተይ፥","poem":1},{"text":"ዎይኮ፥ ‘ኔኒ ኢታ ኦሶ ኦዳሳ’ ያጋናዉ ዳንዳኤይ ኦኔ?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"አሳይ ማዝሙረን ሳቢዳ እያ ኦሱዋ፥","poem":1},{"text":"ነካ ማዝሙረን ሳባ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"አሳ ኮቸ ኡባይ ፆሳ ኦሱዋ በእስ፤","poem":1},{"text":"አሳይ ሃሆን ኤቅድ ፄልዶሶና።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ፆሳይ ግታ! እያ ግታተ ኑ አኬካናዉ ዳንዳኦኮ፤","poem":1},{"text":"እያ ላይ ዳሮተስ ዛው ባዋ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“ፆሳይ ሃ አባፈ ፑደ ሳሎ ኤፌስ፤","poem":1},{"text":"ዱገ ዛሪድ እራ ኦድ ቡክሴስ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ሄ እራይ ሻራፐ ከይድ፥","poem":1},{"text":"አሳ ቦላ ቡካና መላ ኦስ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ፆሲ ሻራ ዋትድ ምጭያኮ፥","poem":1},{"text":"ፆሳይ ደእያ ሳሉዋን ዋንድ ጉምያኮ፥","poem":2},{"lineBreak":true},{"text":"ኦንካ ኤረና።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"እ ባ ዩሾን ዎልአን ፖኡዋ ላሌስ፤","poem":1},{"text":"አባ ጪሙዋ ዋትድ ካምያኮ በአ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ያትድ ፆሳይ ደርያ አይሴስ፤","poem":1},{"text":"ካ ዳርስድ እሜስ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"እ ዎልአን ባ ኩሸን ኦይኬስ፤","poem":1},{"text":"ባ ማልዳ በሳ ጫዳና መላ ኪቴስ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ዳድ ቅድ ኡሾይ ያናይሳ በሴስ፤","poem":1},{"text":"መሄይካ ኡሾይ ያናይሳ ኤሬስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/35.json","previousChapterAudioLinks":{},"numberOfVerses":33}