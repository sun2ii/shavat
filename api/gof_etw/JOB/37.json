{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":37,"content":[{"type":"verse","number":1,"content":["“እያ ኡሹዋን ታ ዎዛናይ ድርጌስ፤",{"text":"ባ በሳን ቃፄስ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እያ ዶናፐ ከይያ ቃላ ስእተ፤","poem":1},{"text":"ዳዳዳ ጉምያ እያ ግርሳ ሀይዝተ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እ ሳሎ ጋርሳን ባ ዎልአን ላሌስ፤","poem":1},{"text":"ቢታ ጋፃፐ ጋፃ ጋካናዉ ኪቴስ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሄሳፈ ጉየ፥ እያ ጉንይ ስኤቴስ፤","poem":1},{"text":"ባ ያሽያ ግርሳ ስሴስ።","poem":2},{"text":"እያ ግርሳይ ስኤትያ ዎደ፥","poem":1},{"text":"ባ ዎልአን ተቀና።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ፆሳ ማላልስያ ኦገን ባ ጉን ስሴስ፤","poem":1},{"text":"ኑኒ አኬካናዉ ዳንዳኦና ግታባ እ ኦስ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እ ሻቻኮ፥ ‘ሳአን ዎ’ ያጌስ፤","poem":1},{"text":"ዎልቃማ እራኮ፥ ‘ቡካ’ ያግድ ኪቴስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እ መዳ አሳ ኡባይ እያ ኦሱዋ ኤራና መላ፥","poem":1},{"text":"አሳይ ባንታ ኦሱዋ አጋና መላ ኦስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሄ ዎደ ዶአት ባንታ በሳ ገሎሶና፤","poem":1},{"text":"ባንታ ጎንጎሉዋን ቆሰቶሶና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዎልቃማ ጎተይ ዱገሀፐ ደንዴስ፤","poem":1},{"text":"እርፃ ጫርኮይ ፑደሀፐ ዬስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ፆሳ ደኦ ሸምፖይ ሻች መስ፤","poem":1},{"text":"ዳልጋ ሃታ ሹቻዳ ምንስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሻር ሃ ቶካና መላ ኦስ፤","poem":1},{"text":"ባ ዎልአን ሻራ ግዶን ላሌስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሻራት እያ ኪታን ቢታ ጋፃ ዩዮሶና፤","poem":1},{"text":"እ ኪትያ ኪታ ኡባ ፖሎሶና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ፆሳይ እራ ቡክሰይ ቢታ እርፅሳናሳ፥","poem":1},{"text":"ዎይኮ አሳ ሴራናሳ፥ ዎይኮ ባ ሲቁዋ በሳናሳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“እዮባ፥ ሄሳ ስአ፤","poem":1},{"text":"ፆሳይ ኦያ ማላልስያ ኦሱዋ ታክ ጋዳ አኬካ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ፆሳይ ሻራታ ዋትድ ኪትያኮ፥","poem":1},{"text":"ባ ዎልአን ዋትድ ዎልአምስያኮ ኤራይ?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሻራት ሳሎን ዋንድ ኡትያኮ፥","poem":1},{"text":"ኤራን ፖሎ ግድዳ ፆሳይ","poem":2},{"lineBreak":true},{"text":"ኦያ ማላልስያ ኦሱዋ ኔኒ ኤራይ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዱገሀ ጫርኮይ ጫርክድ ቢታ ምሽስያ ዎደ፥","poem":1},{"text":"ኔኒ ዎልቃማ ባዞ ሴላን ትልአና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ፆሳይ ሳሉዋ ትልእዳ ማስቶተዳ ምጭያ ዎደ፥","poem":1},{"text":"ኔኒ እያ ማዳናዉ ዳንዳአይ?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ኑኒ ኤራ ፓጫ ግድያ ግሾ፥","poem":1},{"text":"ፆሳስ ዎይግድ ኦደታነኮ ነ ኑና ታማርሳ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ፆሳራ ኦደታና ጋዳ ታኒ ኦይቻናዉ ኮሺ?","poem":1},{"text":"ታና ይሳና መላ ታ አይስ እያ ደንኔ?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ጫርኮይ ሳሎፐ ሻራ ጌሽያ ዎደ፥","poem":1},{"text":"ሳሎን ጶልያ አዋ ኦንካ በአናዉ ዳንዳኤና።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ፑደሀ ባጋራ ዎርቃ ዳንያ ፖኦይ በንቴስ፤","poem":1},{"text":"ፆሳይ ያሽያ ቴማን ቆንጬስ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ኡባ ዳንዳእያ ፆሳኮ ሺቃናዉ ዳንዳኦኮ፤","poem":1},{"text":"እያ ዎልቃይ ግታ።","poem":2},{"text":"እ ባ ቱማ ፕርዳንነ ባ ግታ ፅሎተን","poem":1},{"text":"አሰ ቆሄና።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ሄሳ ግሾ፥ አሳይ እያዉ ያዬስ፤","poem":1},{"text":"ባንታና ጭንጫ ገይሳታ እ ካስ” ያግስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/36.json","previousChapterAudioLinks":{},"numberOfVerses":24}