{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":39,"content":[{"type":"verse","number":1,"content":[{"text":"“ዎሽኤይ አዉደ የልያኮ ኔኒ ኤራይ?","poem":1},{"text":"ባቾት ባናክድ ባንታ ማራታ የልያ ዎደ በአዲ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ኤንቲ አይ መላ አጌና ጋምእያኮ፥","poem":1},{"text":"አዉደ የልያኮ ነ ኤራይ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኤንቲ ጉልባት ኤቀትድ፥","poem":1},{"text":"ባንታ ማራታ የለይ አዉደኮ ኤራይ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኤንታ ማራት ባዞን ድጭድ ምኖሶና፤","poem":1},{"text":"ባንታ አየታ አግድ ቦሶና፤ ናምአን ጉየ ስሞኮና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ዎራ ሀረት የዳ ዳናዳ ኦዳይ ኦኔ?","poem":1},{"text":"ቃሾፐ ኤንታ ብርሽድ የድዳይ ኦኔ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኤንታዉ ባዙዋ ደእያ በሲ ኦዳ እማስ፤","poem":1},{"text":"ማፅነ ቢታን ኤንቲ ዳናዳ ኦስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ካታማ ዋሱዋፐ ሃክድ ደኦሶና፤","poem":1},{"text":"ላገይስታ ቆደ ስኦኮና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኤንቲ ደረታ ቦላ ባንታና ሄሞሶና፤","poem":1},{"text":"ያን ምያ ፑርጮ ማታ ቆሮሶና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“መን ነዉ ኦናዉ ኤሮ ጋንዴ?","poem":1},{"text":"ዎይኮ ነ ዛዳሎን ቃማ አቃንዴ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ጎያና መላ ነ እያ ዋፃኔ?","poem":1},{"text":"ዎይኮ ዋፃዳ ጎያናዉ ዳንዳአይ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኔኒ እያ ዎልቃ ምኖተን አማነታኔ?","poem":1},{"text":"ዴፆ ኦሶ እ ኦና መላ እያዉ የጋ አጋኔ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኔኒ ካ ሻለን ቆላና መላ፥","poem":1},{"text":"ዎይኮ ዉዱማን ሺሻና መላ እያ አማናይ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ያንቾይ ባ ቀፍያ ኤለሳዳ ቃዉሱ፤","poem":1},{"text":"ሽን ሃ ካፎዳ ፕራናዉ ዳንዳኡኩ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ያንቾይ ባ ጱጱልያ ቢታን ጱጱላዉሱ፤","poem":1},{"text":"ሻፈን ሆአና መላ አጋጋዉሱ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"‘ቶሆይ መንና፥","poem":1},{"text":"ባዞ ዶአት የና’ ጋዳ ቆፑኩ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ናይት ባባ ግዶናዳ ኦዳ ኤንታዉ ዳሮ ኢታዉሱ።","poem":1},{"text":"እ ዳቡራ ኡባይ መላ አተይስ እዉ አይኮካ ዳነና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሄሳዳ ኦዳ እዮ ጭንጫተ ድግዳይነ","poem":1},{"text":"አኬካ ይስዳይ ታና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሽን ደንዳዳ እያ ዎፅያ ዎደ፥","poem":1},{"text":"ባራ ጋደትያ ፓራ ቦላነ ፓራዋ ቦላ ሚጫዉሱ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“እዮባ፥ ፓራታስ ዎልቃ እምዳይ፥","poem":1},{"text":"ዎይኮ ፓራታ ሞርገን ጭምባ ማይዝዳይ ነኔ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ፓራት ቦለዳ ጉፓናዳነ","poem":1},{"text":"ጋርማምድ ዳጋንናዳ ኦዳይ ነኔ?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ፓራት ባንታ ዎልቃን አማነትድ ስኮሶና፤","poem":1},{"text":"ኦለታናዉ ኦላ ደምባ ጋላቦሶና።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ያሽ ኤሮኮና፤ ኤንታ አይብካ ዳጋንና፤","poem":1},{"text":"ኤንታ ቦላ ማሻ ሾድኮካ ጉየ ስሞኮና።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ኤንታ ቶግያ ኦላንቾት ኦይክዳ ኦላ ሚሸት፥","poem":1},{"text":"ጶልሸ እሶይ እሱዋራ ጋሄትድ ጊሮሶና።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ሽን ፓራት ቢታ ካሽሸነ ያሽስሸ ጋላቦሶና፤","poem":1},{"text":"ሞይዘ ግርስ ስእያ ዎደ ስእ ግድ ኤቃናዉ ዳንዳኦኮና።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ሞይዘይ ፑነትያ ዎደ ኡፋይሳን ጋርማሞሶና፤","poem":1},{"text":"ኦላ ፔኖ ሃሆን ኤኮሶና፤","poem":2},{"lineBreak":true},{"text":"ቶራ ሞጮና ኪታነ ኦላንቾታ ጬቁዋ ስኦሶና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“ፅሎይ ባ ቀፍያ ዱገሀ ባጋ ምጭድ፥","poem":1},{"text":"ፓላናዉ ዳንዳኤይ ነ ጭንጫተኔ?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"አርጋን ፑደ ከይድ፥","poem":1},{"text":"ባ ኬ ቃ ደረታ ቦላ ኬፀይ ነ ኪታኔ?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"አርጋን አፎ ዶናን ባ ኬ ኬፅድ ደኤስ፤","poem":1},{"text":"ዛላ ቆጶት እያዉ ቆልአ ግድዶሶና።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ያን ኡትድ ባዉ ምያባ ዎቼስ፤","poem":1},{"text":"እያ አይፈይ ሃሆን ጌሽድ ደሜስ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"አርጋን ናይት ሱ ኡዮሶና፤","poem":1},{"text":"ጋዉፅ ደእያ በሳን ሺቆሶና” ያግስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":30}