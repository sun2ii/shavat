{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":4,"content":[{"type":"heading","content":["ኤልፋዛ ሃሳያ"]},{"type":"verse","number":1,"content":["ተማናፐ ይዳ ኤልፋዝ ዛሪድ፥"]},{"type":"verse","number":2,"content":[{"text":"“እስ አስ ፃልታምድ ኔራ ኦደትኮ ኔኒ ላንጫኔ?","poem":1},{"text":"ሽን ሃሳዮና አጋናይ ኦኔ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሄኮ፥ ኔኒ ዳሮታ ታማርሳዳሳ፤","poem":1},{"text":"አርጋጭዳ ኩሸታ ምንዳሳ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ነ ቃላይ በትዳይሳታ ኮልድ ኤስስ፤","poem":1},{"text":"ዳቡርዳ ጉልባታታ ምንስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሽን ሀእ መቶይ ነና ጋክን ኡፋይስ ቃንፃዳሳ፤","poem":1},{"text":"ኡንእ ነና ተቅን ዳጋማዳሳ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ነ ፆሳስ ያየይስ ነና አማንድ ዎቤኔ?","poem":1},{"text":"ነ ሱረ ሄመይ ነዉ ኡፋይስ ግድቤኔ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“አነ ቆፓ፤ ጌሻ አስ ግድድ ይዳይ ኦኔ?","poem":1},{"text":"ሱረ አስ ግድድ ሾደትድ ይዳይ ኦኔ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታ በእዳይሳዳ፥ ኢታተ ጎይድ መቶ ዘረይሳት፥","poem":1},{"text":"እያ ዛሪድ ቡጫና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኤንቲ ፆሳፈ ከያ ሸምፖን ፑነትድ ያና፤","poem":1},{"text":"እያ ሀንቁዋ ላጩዋን ሜተታና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኢታት ጉድያ ጋሞ መላ ፃጎሶና፤","poem":1},{"text":"ሽን ኤንታ አቻይ መቀረትስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሻንካትድ ምያባ ይዳ ጋሞይ ሀይቀይሳዳ፥","poem":1},{"text":"ኤንታ ናይትካ ላለተይሳዳ ኢታታ ናይት ላለታና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“እስ ጋላስ እስ ፁራይ ታኮ ይስ፤","poem":1},{"text":"ሄ ፁራ ካልካሻን ታ ስአስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዎልቃማ ስኮይ አሰ ኦይክዳ ዎደ","poem":1},{"text":"ኡንኤያ ቃማ አሙሆ ግዶን፥","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ያሽነ ኮኮርስ ታና ኦይክስ፤","poem":2},{"lineBreak":true},{"text":"ታ መቀት ኮኮርዶሶና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ጫርኮይ ታ ሶምኡዋ ባቅድ አስ፤","poem":1},{"text":"ታ ዳጋምን ታ አሳተ እክሰይ ኤቅስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እ ታ ስንን ኤቅስ፤","poem":1},{"text":"ሽን እ አይበኮ ሻካዳ ኤራብከ።","poem":2},{"text":"ሄሳፈ ጉየ፥ ስእ ግዳ በሳፈ","poem":1},{"text":"ሀይሳዳ ግያ ግርሳ ስአስ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"‘ሀይቅያ አስ ፆሳ ስንን ፅሎ ግዳናዉ ዳንዳኢ?","poem":1},{"text":"ዎይኮ አስ ባና መዳይሳ ስንን ጌሽ ግዳናዉ ዳንዳኢ?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ፆሳይ ባ አይለታን አማነቶናባ ግድኮ፥","poem":1},{"text":"ባ ኪታንቾታንካ ባላ ደምያባ ግድኮ፥","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ያትን፥ ኡርቃ ኬን ደኤይሳት፥","poem":1},{"text":"ኤንታ ደኡዋ ባሶይ ቢታ ግድዳይሳት፥","poem":2},{"lineBreak":true},{"text":"ጉፁነፐ ኤሶን ሀይቀይሳት ዋናኔ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዎንታ በንትድ ኦማርስ ሀይቆሶና፤","poem":1},{"text":"ኦንካ ሀሳዮና መርናዉ ዮሶና።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሸይ ሾደትዳ ዱንካነ መላ","poem":1},{"text":"ጭንጫተ ባይና ሀይቆሶና።’ ”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}