{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":40,"content":[{"type":"verse","number":1,"content":["ጎዳይ እዮባኮ ዛሪድ ያግስ፤"]},{"type":"verse","number":2,"content":[{"text":"“እዮባ፥ አስ ኡባ ዳንዳእያ ጎዳራ ሞተትድ፥ ላናዉ ዳንዳኢ?","poem":1},{"text":"አነ ፆሳራ ሞተትያ ኡራይ እያዉ ዛሮ” ያግስ።","poem":2}]},{"type":"verse","number":3,"content":["ሄሳፈ ጉየ፥ እዮብ ዛሪድ፥ ሀይሳዳ ያግስ፤"]},{"type":"verse","number":4,"content":[{"text":"“ጎዳዉ፥ ታኒ ፓና ላፋ አስ፤","poem":1},{"text":"ታ ዶና ቦላ ኩሸ ዎዳ ስእ ጋናፐ አትሽን፥","poem":2},{"lineBreak":true},{"text":"ነዉ አይ ዛሮ እማናዉ ዳንዳእያና?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ታኒ እስ ቶሆ ኦዳስ፤ ሽን ታዉ ዛርያባይ ባዋ፤","poem":1},{"text":"ናምአን ኦዳስ ሀራ ጉጅከ” ያግስ።","poem":2}]},{"type":"verse","number":6,"content":["ሄሳፈ ጉየ፥ ጎዳይ ጎተ ግዶን ግድድ እዮባኮ ሀይሳዳ ያግስ።"]},{"type":"verse","number":7,"content":[{"text":"አደዳ ነ ፄሳ ዳንጫዳ ደንዳዳ፥","poem":1},{"text":"ታ ኦይሻስ ዛሮ እማ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ነ ታና ባላ አስ ከሳና ሀናዬ?","poem":1},{"text":"ነዉ ፅሎ ግዳናዉ ታና ዎርዳንቾ ከሳዬ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ፆሳ ዎልቃ መላ ዎልቅ ነዉ ደኢ?","poem":1},{"text":"ፆሳይ ጉመይሳዳ ነ ጉማናዉ ዳንዳአይ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሄሳ ግድኮ፥ ነ ቦንቹዋነ ግታተ ማአ፤","poem":1},{"text":"ነ ዎልቃነ ቴሙዋ ግፃ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ነ ሀንቁዋ ጉሳ፤","poem":1},{"text":"አነ ኦቶራንቾታ ፄላዳ ካዉሻ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አነ ሎይ ፄላዳ ኦቶርትያ ኡባ ዬላያ፤","poem":1},{"text":"ኢታታ ኡባ ኤንቲ ደእያ በሳፈ ይሳ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኤንታ ኡባ ቢታን ሞጋ፤","poem":1},{"text":"ዱፎን የጋዳ ኤንታ ቦላ ጎርዳ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሄ ዎደ ነ ዎልቃይ ነና አሻናዉ ዳንዳኤይሳ","poem":1},{"text":"ታ ማርካታና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ታኒ ነና መዳዳ መዳ ብሄሞታ ጌተትያ ዶአ በአ፤","poem":1},{"text":"እ ቦራዳ ማታ ሜስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እያ ፄሳን ደእያ ዎልቃይነ","poem":1},{"text":"እያ ኡሉዋ ካምዳ ሻያ ምኖተይ ዳሮ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እያ ጎይናይ ዝጋዳ ቦላን ቃፄስ፤","poem":1},{"text":"እያ ገዳ ፃጶት ምኖን ዶቀትዶሶና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እያ መቀይ ናሰ ብራታ መላ፤","poem":1},{"text":"እያ ገዳይ ብራታ ኩረ መላ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ፆሳይ መዳ መታ ኡባ ጋርሳን እ አስ፤","poem":1},{"text":"ታፐ አትሽን፥ ሀር እያ ፆናናዉ ዳንዳኤይ ባዋ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዶእ ጉፕያ ደረይ፥","poem":1},{"text":"እያዉ ምያባ ዶልሴስ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ም ኩያ ጋርሳን ዝንኤስ፤","poem":1},{"text":"ጫረን ማቃ ግዶን ቆሰቴስ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ምት ባንታ ኩያን እያ ገንሶና፤","poem":1},{"text":"ሻፋ ጋፃን ድጭያ ምት እያ ካሞሶና።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ሻፋይ ክፅድ ጎገይ ዎደ ዳጋመና፤","poem":1},{"text":"ዮርዳኖሰ ሻፋይ ቆ ጋካናዉ ኩምኮካ እ ህርገና።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"እያ አይፍያ ቶይስድ፥ እያ ኦይካናዉ ዳንዳእያ አስ ደኢ?","poem":1},{"text":"እያ ሲያ ሉክድ ኦይካናዉ ዳንዳኤይ ኦኔ?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":24}