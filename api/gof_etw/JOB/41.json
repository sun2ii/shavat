{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":[{"text":"“ኔኒ ሌዋታነ ጌተትያ አባ ዶኣ ማንፃቆን ኦይካናዉ፥","poem":1},{"text":"ዎይኮ እያ እንፃርሳ ዎዶሮን አንጫፋናዉ ዳንዳአይ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እያ ሲያ ሉካዳ ዳፎ አናዉ ዳንዳአይ?","poem":1},{"text":"ዎይኮ እያ ጋጩዋ ዎስፐን ሉካናዉ ዳንዳአይ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እ ነና፥ ‘ሀያና ታና አጋርክ’ ያግድ ዎሲ?","poem":1},{"text":"ዎይኮ ነዉ ማልኦ ቃላ ኦዲ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ነ እያ መርናዉ አይለ ኦዳ ሃራና መላ፥","poem":1},{"text":"እ ነዉ ኤሮ ግድ ጫቃኔ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አስ ካፎ ሎህሰይሳዳ ነ እያ ሎህሳናዉ ዳንዳአይ?","poem":1},{"text":"ዎይኮ እያ ቃቻዳ ነ ማጫ ናይታራ ካአና መላ ኦኔ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሞሎ ዛልአንቾት እያ ጋትያ ቦላ ፓላሞና?","poem":1},{"text":"ዎይኮ እያ ቃንፀረድ ባይዞና?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኔኒ እያ ጋልባ ቶራን፥","poem":1},{"text":"ዎይኮ እያ ሁጵያ ማሻን ጫዳናዉ ዳንዳአይ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አነ እያ ነ ኩሸን ቦቻ፤","poem":1},{"text":"ነ እያራ ቡተትዳ ቡትያ ዶጋካ፤","poem":2},{"lineBreak":true},{"text":"ናምአን እያራ ቡተታናዉ ቆፓካ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሄ ዶኣ ኦይካናዉ ፓጨይ መላ ዋየ፤","poem":1},{"text":"ሀር አቶሽን እያ በእዳ ኡባይ ያሻን ኮኮሬስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እ ዝንእዳ በሳፈ እያ ደንናዉ ኦንካ ፃለና፤","poem":1},{"text":"ያትን፥ ታ ስንን ኤቃናዉ ዳንዳኤይ ኦኔ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታ እያዉ ዛራና መላ ኮይሮ ታዉ ታልእዳይ ኦኔ?","poem":1},{"text":"ሳሎፐ ጋርሳን ደእያባ ኡባይ ታባ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“ታኒ ሌዋታነ ቶሆታባ፥ እያ ግታ ዎልቃባነ","poem":1},{"text":"ሎእያ እያ አሳተባ ቆንጭሶና አግከ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እያ ጋልባ ቃራናዉ ዳንዳኤይ ኦኔ?","poem":1},{"text":"እያ ጋጩዋ ፖቅድ ብፃላ ባርሳናይ ኦኔ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ያሽያ አቻይ ደእያ","poem":1},{"text":"እያ ጋጩዋ ፖቃናዉ ዳንዳኤይ ኦኔ?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እያ ዞኮ ጋልባይ እሶይ እሱዋ ቦላ ዶረትድ፤","poem":1},{"text":"ሹቻዳ ምንዳ ጎንዳለ ዳኔስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኤንቲ እሶይ እሱዋስ ዳሮ ማታትዳ ግሾ፥","poem":1},{"text":"ኤንታ ግዶራ ሀር አቶሽን ጫርኮይ ካንናዉ ዳንዳኤና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እሶይ እሱዋራ ጋሄትድ ደእያ ግሾ፥","poem":1},{"text":"ኤንታ አይብካ ሻከና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እ ሀሽያ ዎደ ፖኦይ ፖልኡ ጌስ፤","poem":1},{"text":"እያ አይፈት ዎንታ ፃልቀዳ ጫዴስ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"እያ ዶናፐ ታማ ላጮይ ከዬስ፤","poem":1},{"text":"ፕንፅያ ታም በንቴስ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እያ ሲያፐ ጩያይ፥","poem":1},{"text":"ታማ ቦላ ደእያ ኦቶፐ ከያ ፐንቶ መላ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"እያ ሲራ ከያ ሸምፖይ ከንችከሎ ቦንቅሴስ፤","poem":1},{"text":"ታማ ላጮይ እያ ዶናፐ ከዬስ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"እያ ሞርግያን ዎልቃይ ደእያ ግሾ፥","poem":1},{"text":"እ ዳሮ ያሼስ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"እያ አሾይ እስፈ ኦይከትድ ደእያ ግሾ፥","poem":1},{"text":"እያ አሳተይ ብራታዳ ምኔስ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"እያ ዎዛናይ ሹቻዳ ምኖ፤","poem":1},{"text":"ጋቻ ዎፃ መላ ምኖ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"እ ደንድያ ዎደ ምኖት ያዮሶና፤","poem":1},{"text":"ዳጋምድ ባቃቶሶና።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"እያ ጋክያ ማሻይ አይኮካ ኦና፤","poem":1},{"text":"ቶር ዎይኮ ዶንገይ ዎይኮ ማሽ እያ ቆሄና።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"እ ብራታ ፅንቃ ማታዳ፥","poem":1},{"text":"ናሰ ብራታ ዎቅዳ ምዳ መንረስ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ዶንገይ እያ በትሰና፤","poem":1},{"text":"ያምባርሻ ሹች እያዉ ሱላ መላ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ጉምባ ፃምእ እያዉ ፅንቆ መላ፤","poem":1},{"text":"ቶራ ፆንግያ ዎደ ቀልቅስድ ሚጬስ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"እያ ኡሉዋ ቦላ ደእያ ጋልባይ መቅዳ ኩንአ መላ ቃራ፤","poem":1},{"text":"ኡርቃራ እ ብያ ዎደ ማራሻ መላ ቢታ ጳልቄስ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"አባ ፐንትዳ ሃ መላ ቱምቡል ቱምቡል ኦስ፤","poem":1},{"text":"ፃሮን ፐንትያ ዛይተ መላ ሽር ሽር የጌስ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"እያ ብያ ኦገይ ፖኤስ፤","poem":1},{"text":"አባ ሃ ጎፖንቶ ላሜስ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"እ ያሽ ኤሮና ግሾ፥","poem":1},{"text":"ቢታ ቦላ እያ መላ መተ ሀር ባዋ።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"እ ዳሮ ግታ መተታ ኡባ ካስ፤","poem":1},{"text":"ዶአ ኡባስ እ ካዎ” ያግስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/40.json","previousChapterAudioLinks":{},"numberOfVerses":34}