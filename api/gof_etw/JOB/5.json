{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"“እዮባ፥ ነዉ ኮያና አስ ደእኮ አነ ፄጋ!","poem":1},{"text":"ኪታንቾታፐ ኦደኮ ነ ፄላኔ?”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ኤያ ኡራ ላንጨይ ዎስ፤","poem":1},{"text":"አኬክ ባይና ኡራ ቃናተይ ይሴስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኤያ ኡራይ ምንድ ደእሽን በአስ፤","poem":1},{"text":"ሽን ቆፖና እያ ኬይ ባደትስ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እያ ናይት ሳሮይ ባይና ዳና፤","poem":1},{"text":"ፕርዳ ዳባባን ኤንታዉ ኤቅያ አስ ባይና ግሾ ኤንቲ ቆሄታና።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እ ሺሽዳ ካ ኮሻትዳ አሳይ ማና፤","poem":1},{"text":"ሀር አቶሽን አጉን ግዶን ዶልዳይሳካ አጎኮና።","poem":2},{"lineBreak":true},{"text":"ሳሞትዳይሳት እያ ሻሉዋ ኤካናዉ አሞቶሶና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"መቶይ ሳአፐ ከየና፤","poem":1},{"text":"ዋየይ ቢታፈ ዶለና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታም ፕንፅድ ዎይሳዳ፥","poem":1},{"text":"አስ መቶስ የለትስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ታ ነና ግድያኮ ታ ፆሳኮ ሺቃና፤","poem":1},{"text":"ታ ሞቱዋካ እያ ስንን ዎና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እ ታይበቶና ማላታታ፥","poem":1},{"text":"ፕልገቶና ዎልቃማባታ ኦስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እራ ቢታን ቡክሴስ፤","poem":1},{"text":"ጎሻ ጋድያስ ሃ የዴስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ካዉሻታ ቁ ቁ ኦስ፤","poem":1},{"text":"ካዮተይሳታ ምንድ ኡፋይሴስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኤንታ ቆፋይ ፖለቶና መላ፥","poem":1},{"text":"ገናንቾታ ሀልቹዋ ሀዳ ኦስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ጭንጫታ ኤንታ ገነ ኦሱዋን ኦይኬስ፤","poem":1},{"text":"ገናንቾታ ማቁዋ አድ የጌስ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ጋላሳይ ኤንታዉ ማ ግዳና፤","poem":1},{"text":"ሴታ ጋላስ ማን ሄመትያ አሳዳ ታታፋና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ማንቆታ ኤንታ ሞርከታ ማሻፈ አሼስ፤","poem":1},{"text":"ኤንታ ዎልቃማታ ኩሽያፐ ዎ ኤኬስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሄሳ ግሾ፥ ማንቆታስ ኡፋይስ ደኤስ፤","poem":1},{"text":"ጌላተ ስእ ኦስ።”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“ፆሳይ ሴርያ አስ አንጀትዳይሳ፤","poem":1},{"text":"ሄሳ ግሾ፥ ኡባ ዳንዳእያ ፆሳ ሴራ ካፓ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እ መንስ፥ ሽን ዛሪድ ኮሌስ፤","poem":1},{"text":"እ ማዱንፅሴስ፥ ሽን እያ ኩሸይ ሌስ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ኡሱፑን ቆሞ ቆሆታፐ እ ነና አሻና፤","poem":1},{"text":"ላፑንይ ነና ቦቸና።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ኮሻ ላይ ሀይቆፐ፥","poem":1},{"text":"ኦላ ዎደ ማሻፈ ነና አሼስ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"እ ነና ኢታ እንፃርሳፈ ናጋና፤","poem":1},{"text":"ቦሽ ጋክያ ዎደ ያያካ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ቦሻ ቦላነ ኮሻ ቦላ ነ ሚጫና፤","poem":1},{"text":"ባዞ ዶአታስ ያያካ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ነ ጎሻ ቢታን ሹች ዴና፤","poem":1},{"text":"ባዞ ዶአታራ ነ ሳሮን ዳና።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ነ ዱንካነይ ሳሮ ግደይሳ ነ ኤራና፤","poem":1},{"text":"ነ ዳራ ነ ፆሞስያ ዎደ አይብካ ፓጨና።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ነ የለታይ ዳራናይሳነ","poem":1},{"text":"ነ ኮቻይ ማታ መላ ግዳናይሳ ነ ኤራና።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ካ ዎደ ናግድ ጫከተይሳዳ፥","poem":1},{"text":"ኔኒ ጭማተ ካላዳ ዱፎ ባና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“እዮባ፥ ኑኒ ሄሳ ኡባ ፕልግድ ፄልዳ።","poem":1},{"text":"ሄስ ቱማ ግድያ ግሾ አኬካዳ ኤካ” ያግስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}