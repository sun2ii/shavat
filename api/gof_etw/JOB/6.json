{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":6,"content":[{"type":"heading","content":["እዮባ ሃሳያ"]},{"type":"verse","number":1,"content":["ሄሳፈ ጉየ እዮብ ዛሪድ፥"]},{"type":"verse","number":2,"content":[{"text":"ታ ዋየይነ ታ አዛኖይ ኡባይ","poem":1},{"text":"ምዛነን ልከትድ በኤትያኮ፥","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አባ ጋፃን ደእያ ሻፍያፐ አድ ዴፃና፤","poem":1},{"text":"ሄሳ ግሾ፥ ታ ቃላይ ነና ማላልሰናሽን።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኡባ ዳንዳእያ ፆሳ ዶንገት ታና ጫድዶሶና፤","poem":1},{"text":"ታ አሳተይ ኤንታ ዪሻ ኡዬስ፤","poem":2},{"lineBreak":true},{"text":"ፆሳ ዳጋንይ ታ ቦላ ሳልፕስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሀረይ ዎይኮ ቦር ማት ደእሽን ዋስዬ?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ማልኦና ካ ማፅነይ ገሎና ሜተትዬ?","poem":1},{"text":"ዎይኮ ጱጱለ ሃ ማልእዬ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሄሳ መላ ካ ታና ሱከየና፤","poem":1},{"text":"ሄሳ መላ ካ ታ ሚኮ ታና ሳኬስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ታ ዎሳ ፆሲ ስእያኮ አይቤ?","poem":1},{"text":"ታ አሙዋካ ታዉ ኩንያኮ አይቤ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ፆሳ ሸነ ግድን እ ታና መንረያኮ፥","poem":1},{"text":"እ ባ ኩሽያ የድድ ታና ይስያኮ፥","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታ ጌሻ ፆሳ ቃላ ካዳቦና ግሾ፥","poem":1},{"text":"ዋየይ ዳርኮካ ኡፋይሳን ታ ጉፓና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታ ፓፃ ዳናዉ ታዉ አይባ ዎልቅ ደኢ?","poem":1},{"text":"ታዉ አይባ ኡፋይስ ደእሽን ዳንዳእያና?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ታ ዎልቃይ ሹቻ መለዬ?","poem":1},{"text":"ዎይኮ ታ አሾይ ናሰ ብራታ መለዬ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታኒ ታና ማዳናዉ አይባ ዎልቅ ታዉ ደኢ?","poem":1},{"text":"ማዶ ደማናዉ ፄልያ በስካ ባዋ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"መቶን ደእያ አስ ኡባ ዳንዳእያ ፆሳስ ያየይሳ አግኮካ፥","poem":1},{"text":"እያ ላገት እያዉ ኬሀተ በሳናዉ ኮሼስ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሽን ታ እሻት ህንተ እር ቡኮና ዎደ መልያ ሻፋ መላ ታና ጭሜታ።","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ባልጎ አጌናን ሀ ሻፋይ ሻቻን ኩሜስ።","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ሽን ቦነይ ጋክያ ዎደ ሻቻይ ትልኤስ፤","poem":1},{"text":"ሻፋይካ መሌስ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ጫና መሄ ላግሸ ብያ ዛልአንቾት፥","poem":1},{"text":"ሃ ኮያናዉ ባንታ ኦግያፐ ጋፃ ከይድ፥","poem":2},{"lineBreak":true},{"text":"መላ ቢታን ቶይላትሸ ዮሶና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ቴማ ቢታ ዛልአንቾት ሃ ኮዮሶና፤","poem":1},{"text":"ሳባ ቢታ ኦገ አሳት ኡፋይስ ቃንፆኮና።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ኤንቲ አማነትድ ኮይድ ይዳ ግሾ ይሎትዶሶና፥","poem":1},{"text":"ሄ በሳ ጋክድ ዬላትዶሶና።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ህንተካ ታዉ ሄ ሻፋታ መላ ግድደታ፤","poem":1},{"text":"ታና ጋክዳ መቱዋ በእድ ያይደታ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ሀኖሽን ታ ህንተና፥ “ታዉ እስባ እምተ”","poem":1},{"text":"ዎይኮ፥ “ህንተ ሻሉዋራ ታና ዎዝተ” ጋድና?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"“ታና ታ ሞርከታ ኩሸፐ አሽተ”","poem":1},{"text":"ዎይኮ፥ “ቃይ ባይና አሳ ኩሸፐ ታና ዎዝተ” ጋድና?","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“ታ ስእ ጋና፤ ህንተ ታና ታማርስተ፤","poem":1},{"text":"ታ አይ ባልዳኮ አነ ታና በስተ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ቱማ ኦድ ጫምኮካ ኤከቴስ!","poem":1},{"text":"ሽን ህንተ ኦዳይ አይብስካ ማደና።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ህንተ ታ ሃሳያ ጫርኮ መላ ሀዳ ኦታ፤","poem":1},{"text":"ያትን፥ ኡፋይስ ቃንፅዳይሳስ ታዉ አይ ዛሮ እማናዉ ኮዬቲ?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"አው ባይና ናአ ቦላ ሳማ የጌታ፤","poem":1},{"text":"ህንተ ላግያ ባይዛናዉ ዋሽሴታ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"አነ ሻማ አይፈን ታና ፄልተ፤","poem":1},{"text":"ታ ህንተ ስንን ዎርዶትያና?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ሀያና፥ አነ ዛረድ ቆፕተ፤","poem":1},{"text":"ታኒ ፅሎ ታ ቦላ ጮ ፕርዶፍተ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ታ እንፃርሳን ዎርዶይ ደኢ?","poem":1},{"text":"ታ ዶናይ ዎርዶነ ቱማ ሻካናዉ ዳንዳኤኔ?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}