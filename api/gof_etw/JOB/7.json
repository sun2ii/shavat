{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"አሳ ደኦይ ሳአ ቦላ ዎልቃማ ባፀ ግደነዬ?","poem":1},{"text":"እያ ላይይ ኡነ ኦያ አሳ ደኦ መላ ግደነዬ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዉልያ አዋ አሞትያ ጋቻ መላ፥","poem":1},{"text":"ዎይኮ ባ ዳሞዝያ ኤካናዉ ናግያ ኦሳንቾዳ፥","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ሄሳዳ ታዉ መላ አጌናት","poem":2},{"lineBreak":true},{"text":"መቶ ቃማት እመትዶሶና።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታኒ ዝንእያ ዎደ አዉደ ባርካንድናሻ ጋይስ፤","poem":1},{"text":"ሽን ቃማይ ታዉ አዱቄስ፤","poem":2},{"lineBreak":true},{"text":"ሳእ ዎንታና ጋካናዉ ሂፃን ሽረታ ሽረታ ዎይስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ታ አሳተይ ጉፁንትስ፤","poem":1},{"text":"ታ ማዱንይ ጊሽ ጎጌስ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታ ላይይ ዶርዘ ሞቀፐ አድ ኤለሴስ፤","poem":1},{"text":"ኡፋይስ ባይናሽን ታ ላይይ ዉሬስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አቤት ፆሳዉ፥ ታ ላይይ እስ ሸምፖ መላ ግደይሳ ቆፓ!","poem":1},{"text":"ታ አይፈይ ዛሪድ ኬሀባ በኤና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሀእ በኤይ ዛሪድ በኤና፤","poem":1},{"text":"ታና ኮያና ሽን ዛር ደመና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሻር ላለትድ የይሳዳ፥","poem":1},{"text":"ዱፎ ዎያ አስ ስሚድ ከየና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ባ ሶ ስሚድ ዬና፤","poem":1},{"text":"እያ ኤርያ አሳይካ ዶጌስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“ሄሳ ግሾ፥ ታ ስእ ጊከ፤","poem":1},{"text":"ታ አያና ኡንኤተ ኦዳና፤","poem":2},{"lineBreak":true},{"text":"ታ ሸምፑዋ ጫመተ ግሾ ዙዙማና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሄሳ መላ ኔኒ ታና አይስ ናጋይ?","poem":1},{"text":"ታ ነዉ አባ ዎይኮ አባን ደእያ ኢታ ዶአ ጋድዬ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"‘ታ ሂፃይ ታና ምንና፤","poem":1},{"text":"ታ አርሳይ ታና ዙዙንፈ ሸምፕሳና!’ ጋዳ ቆፓስ፤","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሽን ኔኒ ታና አሙሆን ያሽሳሳ፤","poem":1},{"text":"ቆንጨን ታና ዳጋንሳ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ታኒ ሀ ዋየይ ኩምዳ አሳተ ቶካዳ ዳናፐ፥","poem":1},{"text":"ሱለታዳ ሀይቅያኮ ዶሳይስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ታኒ ታ ደኡዋ ሻተታስ፤ ዳናዉ ኮይከ፤","poem":1},{"text":"ታ ላይይ እስ ሸምፖ መላ ግድያ ግሾ ታና አጋርክ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ነ እያ ግታያዳ ፄላናዉ አስ አይቤ?","poem":1},{"text":"ነ እያዉ ቆፓናዉ አስ አይቤ?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዎንታ ዎንታ ነ እያ ፆሞሳሳ፤","poem":1},{"text":"ዎደን ዎደን ነ እያ ፓጫሳ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ነ ታ ቦላ አይፈ ዎይሳ አግኪ?","poem":1},{"text":"ጩቹ ምትያ ዎደ ታዉ እምኪ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አቤት አሰ ካለይሶ፥","poem":1},{"text":"ታ ናጋራ ኦን ነና አይ ቆህዴ?","poem":2},{"text":"ነ አይስ ታና ጫዳ ኦይካይ?","poem":1},{"text":"ነዉ ታ ቶሆ ግዳድናዬ?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ታ ናቁዋ አይስ አግኪ?","poem":1},{"text":"ታ ናጋራ አይስ አቶ ጊኪ?","poem":2},{"text":"ታ ዱፎ ገልያ ዎደይ ጋክስ፤","poem":1},{"text":"ነ ታና ኮያና፥ ሽን ህዛፐ ደማካ” ያግስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/6.json","previousChapterAudioLinks":{},"numberOfVerses":21}