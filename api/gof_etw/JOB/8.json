{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":8,"content":[{"type":"heading","content":["ባልዳዶሳ ሃሳያ"]},{"type":"verse","number":1,"content":["ሹሀ ቢታፈ ይዳ በልዳዶስ ዛሪድ፥"]},{"type":"verse","number":2,"content":[{"text":"“ኔኒ ሄሳ አዉደ ጋካናዉ ኦደታይ?","poem":1},{"text":"ነ ዶናፐ ከያ ቃላይ ዎልቃማ ጎተ መላ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኡባ ዳንዳእያ ፆሳይ ፅሎ ፕርደኔ?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ነ ናይት ፆሳ ቦላ ናጋራ ኦዳ ግሾ፥","poem":1},{"text":"እ ኤንታ ኤንታ ናጋራ ግሾ ሴርስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሽን ኔኒ ፆሳኮ ስምኮ፥","poem":1},{"text":"ኡባ ዳንዳእያ ፆሳ ዎስኮ፥","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ኔኒ ጌሽነ ሱረ ግድኮ፥","poem":2},{"lineBreak":true},{"text":"እ ነ ግሾ ደንድድ ነና ማዳና፤","poem":2},{"lineBreak":true},{"text":"እ ካሰ ነ ደኡዋ ዛሪድ ዎይታና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ነ ዶመይ ጉ ዳንኮካ፥","poem":1},{"text":"ነ ዉርሰይ ዳሮ አድ ዳራና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ካሰ የለታ አነ ኦይቻ፤","poem":1},{"text":"ኑ ማይዛት አይ ታማርዳኮ ፕልጋዳ ደማ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኑኒ ዝነ ናይታ አይባካ ኤሮኮ፤","poem":1},{"text":"ኑ ሀ ሳአን ደእያ ላይይ ኩያ መላ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኤንቲ ነና ታማርሰይነ ነዉ ኦደይ፥","poem":1},{"text":"ባንታ ዎዛናን ዎዳባፐ ግደነዬ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጫረይ ባይና በሳን ፓልክ ዶላናዉ ዳንዳኢ?","poem":1},{"text":"ሃ ባይና በሳን ማይረይ ጭልአናዉ ዳንዳኢ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ቡሮ ድጭድ ቃንፀቶና ደእሸ፥","poem":1},{"text":"ጭልኦ ማታፐካ ኤሶን መሌስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ፆሳ ዶግያ አሳ ኡባ ዉርሰይ ሄሳ መላ፤","poem":1},{"text":"ፆሰ ኤሮና አሳ ኡፋይሳይ ያና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እ አማነትያባይ መቅያባ፤","poem":1},{"text":"እ ጬቀትያባይካ ሻንጎ ሃዳ መላ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እ ባ ሻንጎ ሃዳ ቦላ ዘምፓና፥ ሽን ኤቀና፤","poem":1},{"text":"እ እያ ኦይካና፥ ሽን ዱፅ ዎና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እ አዋ ዎደ ሃ ኡይድ ጭልእያ አታክልተ መላ፤","poem":1},{"text":"ባ ፃጱዋ ቢታ ኡባን የድዳ ም መላ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ባ ፃጱዋ ኬላን የዴስ፤","poem":1},{"text":"ግታ ሹቻ ቦላ ባ ፃጱዋ ፃፄስ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሽን እ ባ በሳፈ ሾደትኮ፥","poem":1},{"text":"ሄ በሳይ፥ ‘ታ ነና በአብከ’ ያጋና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ኢታ አሳታ ኡፋይሳይ ሄሳ መላ፤","poem":1},{"text":"ሀራት ይድ ኤንታ በሳ ኦይካና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“ፆሳይ ቦረይ ባይና አሳ የግ አገና፤","poem":1},{"text":"ኢታ ኦይሳታ ማደና።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"እ ዛሪድ ነና ሚቻናነ እልልሳና።","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ነና እፀይሳት ዬላ ማአና፤","poem":1},{"text":"ኢታታ ኬይ ያና” ያግስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}