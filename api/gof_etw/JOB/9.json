{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_etw","name":"እዮባ ማፃፋ","commonName":"እዮባ ማፃፋ","title":"እዮባ ማፃፋ","order":18,"numberOfChapters":42,"sha256":"d3ad7d0315d6430ee3cdcc656a86ef8ab881a2752d8f0d39bebc3a66f6d078d7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_etw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":9,"content":[{"type":"heading","content":["እዮባ ሃሳያ"]},{"type":"verse","number":1,"content":["እዮብ ዛሪድ፥"]},{"type":"verse","number":2,"content":[{"text":"“ኤ፥ ህንተ ገይስ ቱማ ግደይሳ ታ ኤራይስ፤","poem":1},{"text":"ሽን አስ ፆሳ ስንን ዋንድ ፅሎ ግዳናዉ ዳንዳኢ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እያራ ኦን ፓላማናዉ ዳንዳኢ?","poem":1},{"text":"እ ኦይችያ ሙኩሉ ኦይሻታፐ እሱዋካ ዛራናዉ ዳንዳኤና።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ፆሳይ ጭንጫነ ዎልቃማ፤","poem":1},{"text":"እያራ ኤቀታናዉ ዳንዳኤይ ኦንካ ባዋ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ቆፖና ደእሽን ደረታ ኤንታ በሳፈ ድጌስ፤","poem":1},{"text":"ባ ሀንቁዋን አድ የጌስ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እ ቢታ እያ በሳፈ ቃስ፤","poem":1},{"text":"ቢታ ቱቀታካ ይጌስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አዋይ ከዮና መላ ኦስ፤","poem":1},{"text":"ፆልንቶት ፖኦና መላ ድጌስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እ ባርካ ሳሎታ ምጭስ፤","poem":1},{"text":"አባ ሆቢያ ቦላ ሄመቴስ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ፆሳይ ቢረ፥ ኦርዮና፥ ፕላድሳ ጌተትያ ፆልንቶታነ፥","poem":1},{"text":"ዱገሀ ባጋራ ደእያ ፆልንቶ ኮጬታ መስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እ አስ ፕልግድ ኤራናዉ ዳንዳኦና ግታባታ፥","poem":1},{"text":"ታይበቶና ማላልስያባታ ኦስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እ ታ ማታራ አያ ዎደ ታ በአናዉ ዳንዳእከ፤","poem":1},{"text":"እ ታኮ ሺቅያ ዎደ ኤራናዉ ዳንዳእከ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እ ቦንቅኮ ድጋናዉ ዳንዳኤይ ኦኔ?","poem":1},{"text":"‘ዋታይ?’ ያግድ እያ ኦይቻናይ ኦኔ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ፆሳይ ባ ሀንቁዋ ተቀና፤","poem":1},{"text":"ራኣባ ጌተትያ ዶአ ማደይሳት","poem":2},{"lineBreak":true},{"text":"እያ ቶሁዋ ጋርሳን ኩንዶሶና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ያትን፥ እያ ኦይሻ ዛራናዉ፥","poem":1},{"text":"እያራ ሞተታናዉ ታኒ ኦኔ?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ታኒ ፅሎ ግድኮካ፥","poem":1},{"text":"ፕርድያ ፆሳይ ታና ማራናዳ ዎሳናፐ አትሽን፥","poem":2},{"lineBreak":true},{"text":"ታኒ እያዉ ዛሮ እምከ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ታ እያ ፄግን፥ እ ታዉ ኮያኮካ፥","poem":1},{"text":"ታና ስኤስ ጋዳ አማንከ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ታና ጎተን መንረስ፤","poem":1},{"text":"ጋሶይ ባይና ታ ማዱን ዳርሴስ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ታና ሸምፖ ድጌስ፤","poem":1},{"text":"ታ ደኡዋ ጫመስ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዎልቃባ ግድኮ፥ እ ዎልቃማ።","poem":1},{"text":"ፅሎ ፕርዳባ ግድኮ፥ እያ ፕርዳ ኬ ሺሻናይ ኦኔ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ታኒ ታና ፅሎ ጊኮካ ታ ዶናይ ታና ባላ ከሴስ፤","poem":1},{"text":"ታናን ቦረይ ባዋ ታ ጊኮካ ታ እንፃርሳይ ታና ጌላ ከሴስ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ታኒ ቦረይ ባይና አስ ግድኮካ ታባ ቆፕከ፤","poem":1},{"text":"ታኒ ታ ደኡዋ ካይስ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ፆሳይ ቦረይ ባይናይሳነ ኢታ እስፈ ይሴስ፤","poem":1},{"text":"ታ ዱማተ ባዋ ገይ ሄሳ ግሾሳ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ጋዶይ ገልድ አሳ ቆፖና ዎያ ዎደ፥","poem":1},{"text":"እ ፅሎ አሳ ዋያን ሚጬስ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ሀ ሳአይ ኢታ አሳ ኩሸን ዎያ ዎደ፥","poem":1},{"text":"እ ፕርደይሳታ አይፍያ ጎዜስ።","poem":2},{"text":"ሄሳ ኡባ ኦይ እያ ግዶና እፅኮ፥ ሀር ኦኔ?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"ታ ደኦ ላይት ዎፅያ ኡራፐ አድ ኤለሶሶና፤","poem":1},{"text":"ኤንቲ ሎኦባ በኦና ፕራድ ዮሶና።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ታ ደኦ ላይይ ፓልካ ዎጎሎዳ ዎፄስ፤","poem":1},{"text":"አርጋን ምያባ ኦይካናዉ ሳሎፐ ዱገ ፓለይሳዳ ፓለስ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"‘ታ ዙዙን ዶጋና፤","poem":1},{"text":"ሶምኦ ቱከይሳ አጋዳ ፖእሳና ግያኮ፥’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ኔኒ ታና ጌሽ ጎናይሳ ታኒ ኤርያ ግሾ፥","poem":1},{"text":"ታና ጋካና ዋየ ኡባ ታኒ ያያይስ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ያትን፥ ታኒ ባላ ግደይስ አቶና እፅኮ፥","poem":1},{"text":"ጮ መላ አይስ ዳቡራይና?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ታኒ ታ አሳተ ሀር አቶሽን ሳሙናን ሜጨትያኮካ፥","poem":1},{"text":"ታ ኩሽያ ዱማባራ ሜጨትያኮካ፥","poem":2}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"ታ ማኦይካ ታና ሻተታና ጋካናዉ፥","poem":2},{"lineBreak":true},{"text":"ኔኒ ታና ኡርቃ ኦላን ሆላና።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ታ እያዉ ዛሮ እማናዉ ፆሳይ ታ መላ አሰ ግደና፤","poem":1},{"text":"ግድያኮ ኑ ናምአይ ዳይና ስንን ኤቃና።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ሽን ኑ ናምኣ ቦላ ባ ኩሸ ዎድ፥","poem":1},{"text":"ኑና ስገያ አስ ኑ ግዶን ደኤረነ!","poem":2}]},{"type":"verse","number":34,"content":[{"text":"እያ ቴሞይ ታና ዳጋንና መላ፥","poem":1},{"text":"እስ አስ ፆሳ ፃምኣ ታፐ ድገረነሽን!","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ያንኮ፥ ታኒ እያዉ ያዮና ኦደታና፤","poem":1},{"text":"ሽን ሀእ ታኒ ዳንዳእከ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOB/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOB/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOB/8.json","previousChapterAudioLinks":{},"numberOfVerses":35}