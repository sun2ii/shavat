{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOL","translationId":"gof_etw","name":"እዩኤላ ማፃፋ","commonName":"እዩኤላ ማፃፋ","title":"እዩኤላ ማፃፋ","order":29,"numberOfChapters":3,"sha256":"7e1ccd8ffe37ca899300ccdc9f6f4c72077067d47eba8ce0552442cc7e670add","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gof_etw/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"heading","content":["ቦለ ጋዶ"]},{"type":"verse","number":1,"content":["ባቱኤላ ናኣ እዩኤላኮ ጎዳይ ኪትዳ ቃላይ ሀይሳ።"]},{"type":"verse","number":2,"content":["ህንተኖ ጭማቶ፥ ሀይሳ ስእተ! ይሁዳ ቢታን ደእያ አሳ ኡባይ ስእተ! ሀይሳ መላባይ ህንተ ዎደ ዎይኮ ህንተ አዋታ ዎደ ሀን ኤሪ?"]},{"type":"verse","number":3,"content":[{"text":"ሀይሳ ህንተ ናይታስ ኦድተ፤","poem":1},{"text":"ህንተ ናይት ባንታ ናይታስ ኦዶ፤","poem":2},{"lineBreak":true},{"text":"ኤንታ ናይት ካልያ የለታስ ኦዶ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ጎንዶፈ አትዳ ካ ቦለይ ምስ፤","poem":1},{"text":"ቦለፐ አትዳ ካ ጉዶይ ምስ፤","poem":2},{"lineBreak":true},{"text":"ጉዶፈ አትዳ ካ ፃቆይ ምስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ማልእያ ዎይነይ ህንተፈ አትዳ ግሾ፥","poem":1},{"text":"ህንተኖ፥ ማተይሳቶ ባርክተ ዬክተ!","poem":2},{"lineBreak":true},{"text":"ህንተኖ፥ ዎይነ ኡያ ኡባት ዘሌልተ!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታይቦይ ባይና ቦለይ ታ ቢታ ኦይክስ፤","poem":1},{"text":"ኤንታ አቻይ ጋሞ አቻ መላ፤","poem":2},{"lineBreak":true},{"text":"ኤንታ ጋጮይ ማጫ ጋሞ ጋጮ መላ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኤንቲ ታ ዎይንያ ይስዶሶና፤","poem":1},{"text":"ታ ባላስያ ም ግዶሶና።","poem":2},{"text":"ኤንቲ ፖቅድ ምዳ ግሾ፥","poem":1},{"text":"ዎይንያነ ባላስያ ታሸት ፑፁ ግስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጌላእያ፥ ባ ጊግዳ አዝናይ ሀይቅን፥","poem":1},{"text":"ካዮ ማኦ ማአዳ ዬከይሳዳ ህንተካ ዬክተ!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ካ ያርሾይነ ኡሻ ያርሾይ","poem":1},{"text":"ጎዳ ኬን ይዳ ግሾ፥","poem":2},{"lineBreak":true},{"text":"ጎዳ ኬን ኦያ ካህነት ዬኮሶና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ጎሻይ መላ አትስ፤ ቢታይ ዬኬስ፤","poem":1},{"text":"ካይ ይስ፤ ዎይነይነ ዛይተይ መልስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጋደን ደእያ ግስተይነ ባንግ ይዳ ግሾ፥","poem":1},{"text":"ህንተኖ ጎሻንቾቶ፥ ካዮትተ፤","poem":2},{"lineBreak":true},{"text":"ህንተኖ ዎይነ ቶከይሳቶ፥ ዘሌልተ!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዎይነይ መልስ፤ ባላሰይ ሹልስ፤","poem":1},{"text":"ኦሮማነይ፥ ተምረይ፥ አፕለይ፥","poem":2},{"lineBreak":true},{"text":"ጋደን ደእያ ሀራ ም ኡባይ መልስ፤","poem":2},{"lineBreak":true},{"text":"ሄሳ ግሾ፥ አሳፐ ኡፋይስ ሃክስ።","poem":2}]},{"type":"heading","content":["ማሮታኮ ፄስ"]},{"type":"verse","number":13,"content":[{"text":"ህንተኖ ካህነቶ፥ ካዮ ማኦ ማእድ ዬክተ፤","poem":1},{"text":"ህንተኖ ያርሾ በሳ ስንን ኦይሳቶ፥ ዘሌልተ።","poem":2},{"text":"ህንተኖ ታ ፆሳ ስንን ኦይሳቶ፥","poem":1},{"text":"ፆሳ ኬ ገልድ ካዮ ማኦ ማእድ አቅተ።","poem":2},{"text":"ካ ያርሾይነ ኡሻ ያርሾይ፥","poem":1},{"text":"ፆሳ ኬን ያርሽያባይ ባዋ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ፆማ አዋጅተ፤","poem":1},{"text":"ጌሻ ሺቆ ፄግተ።","poem":2},{"text":"ጭማታነ ቢታን ደእያ አሳ ኡባ","poem":1},{"text":"ጎዳ ህንተ ፆሳ ኬን ሺሽተ፤","poem":2},{"lineBreak":true},{"text":"ያን ጎዳኮ ዋስተ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ጎዳ ጋላሳይ ማትስ፤","poem":1},{"text":"ሄ ጋላሳ አየ!","poem":2},{"text":"ሄ ጋላሳይ ኡባ ዳንዳእያ ፆሳ","poem":1},{"text":"ሀንቆ ጋላስ ግድድ ዬስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኑ ስንፈ ካ፥","poem":1},{"text":"ኑ ፆሳ ኬፈ፥","poem":2},{"lineBreak":true},{"text":"ኡፋይስነ እልልስ ይስ ግደኔ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዘረትዳ ዘረይ ቢታ ግዶን ቡቅስ፤","poem":1},{"text":"ካይ ይዳ ግሾ ኤለይ ካሎትስ፤","poem":2},{"lineBreak":true},{"text":"ሻለይ ላለትስ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሄምያ በሲ ባይና ግሾ፥","poem":1},{"text":"መሄይ ዋሴስ።","poem":2},{"lineBreak":true},{"text":"ሀር አቶሽን ዶርሳ ዉደይካ","poem":2},{"lineBreak":true},{"text":"ማታ ይድ ኡንኤቴስ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አቤት ጎዳዉ፥ ባዙዋ ታም ምዳ ግሾ፥","poem":1},{"text":"ፃራግ ደንባን ደእያ ማታ ፁግዳ ግሾ፥","poem":2},{"lineBreak":true},{"text":"ዎራ ም ታማ ላጮይ ይስዳ ግሾ፥","poem":2},{"lineBreak":true},{"text":"ታኒ ኔኮ ዋሳይስ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ጎግያ ሃ መልዳ ግሾ፥","poem":1},{"text":"ታም ባዞን ደእያ ማታ ምድግዳ ግሾ፥","poem":2},{"lineBreak":true},{"text":"ባዞ ዶአትካ ኔኮ ዋሶሶና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}