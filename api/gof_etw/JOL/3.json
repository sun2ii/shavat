{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOL","translationId":"gof_etw","name":"እዩኤላ ማፃፋ","commonName":"እዩኤላ ማፃፋ","title":"እዩኤላ ማፃፋ","order":29,"numberOfChapters":3,"sha256":"7e1ccd8ffe37ca899300ccdc9f6f4c72077067d47eba8ce0552442cc7e670add","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gof_etw/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["ሀራ ካዎተት ፕርደታና"]},{"type":"verse","number":1,"content":[{"text":"“ሄ ጋላሳንነ ሄ ዎድያን","poem":1},{"text":"ታኒ ይሁዳነ የሩሳላመ አሳ","poem":2},{"lineBreak":true},{"text":"ድኤተፈ ዛራዳ አንጃና።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታኒ ካዎተታን ደእያ አሳ ሺሻዳ፥","poem":1},{"text":"ዮሳፈፃ ዛንጋራ ዎሳና።","poem":2},{"text":"ታ አሳ እስራኤለ ቦላ ኤንቲ ኦዳ ኢታ ኦሱዋ ግሾ፥","poem":1},{"text":"ታኒ ኤንታ ያን ፕርዳና።","poem":2},{"text":"ኤንቲ ካዎተታ ግዶን ታ አሳ ላልዶሶና፤","poem":1},{"text":"ታ ቢታ ባንታዉ ሻክ ኤክዶሶና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታ አሳ ቦላ ሳማ የግዶሶና፤","poem":1},{"text":"ላይማትያ ማጫስ ደማናዉ፥ አደ ናይታ እምዶሶና፤","poem":2},{"lineBreak":true},{"text":"ዎይነ ኡሻስ ማጫ ናይታ ባይዝዶሶና።","poem":2}]},{"type":"verse","number":4,"content":["“ህንተኖ፥ ፅሮሳ፥ ስዶናነ ፍልስፄመ ቢታ አሳቶ፥ ህንተ ታ ቦላ አይ ኦናዉ ቆፕደቲ? ታ ቦላ ሀሎ ከያናዉ ኮዬቲ? ህንተ ሄሳ ኮይኮ፥ ታኒ ኤለሳዳ ህንተ ኦሱዋ ህንተ ቦላ ዛራና።"]},{"type":"verse","number":5,"content":["ታ ብራ፥ ታ ዎርቃነ ታ አልኦ ሚሽያ ኡባ ኤክድ ህንተ ኤቃ ኬ ገልስደታ።"]},{"type":"verse","number":6,"content":["ይሁዳነ የሩሳላመ አሳ ኤንታ ቢታፈ ሃስ ኤፍድ፥ ግርከ አሳስ ባይዝደታ።"]},{"type":"verse","number":7,"content":["ሄኮ፥ ህንተ ባይዝዳ በሳፈ ታኒ ሀእ ኤንታ ከሳዳ ህንተ ኦዳባ ኡባ ህንተ ሁጰን ዛራና።"]},{"type":"verse","number":8,"content":["ታኒ ህንተ አደ ናይታነ ህንተ ማጫ ናይታ ይሁዳ አሳስ አ እማና። ኤንቲ ሃሆ ቢታን ደእያ ሳባ አሳስ ኤንታ ባይዛና። ታኒ ጎዳይ ሀይሳ ኦዳስ።"]},{"type":"verse","number":9,"content":[{"text":"“ሀይሳዳ ያግድ ካዎተታ ግዶን አዋጅተ፤","poem":1},{"text":"ኦላስ ጊግተ፤ ምኖ አሳታ ደንተ፥","poem":2},{"lineBreak":true},{"text":"ኦላንቾት ሺቅድ ኦላስ ከዮ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ህንተ ማራሻ ማሸ፥","poem":1},{"text":"ህንተ ባጫ ቶራ ኦድ ቆፅተ!","poem":2},{"lineBreak":true},{"text":"ዳቡራንቾይ፥ ‘ታኒ ምኖ!’ ያጎ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ህንተኖ፥ ዩሹዋን ደእያ ካዎተቶ፥","poem":1},{"text":"ኤለ ከይተ፤ ሃ ሺቅተ” ያግተ።","poem":2},{"text":"አቤት ጎዳዉ፥ ነ ኦላንቾታ ዱገ የዳ!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"“ካዎተት ደንድድ፥","poem":1},{"text":"ዮሳፈፃ ዛንጋራ ዮ፤","poem":2},{"text":"እስራኤለ ዩሹዋን ደእያ ካዎተታ፥","poem":1},{"text":"ኡባ ቦላ ፕርዳናዉ ታኒ ያን ኡታና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኤንታ ኢታተይ ዳሮ፤","poem":1},{"text":"ጫካ ዎደይ ጋክዳ ካዳ ኤንታ ጫክተ።","poem":2},{"text":"ዎይነ አይፈይ ኦላን ኩምን የይሳዳ፥","poem":1},{"text":"ኤንታ የተ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ፕርዳ ዛንጋራን ጎዳይ ፕርድያ ጋላሳይ ጋክስ፤","poem":1},{"text":"ሄሳ ግሾ፥ ታይቦን ዳሮ አሳይ ሄ ዛንጋራን ሺቅስ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሄ ጋላስ አውነ አጌን ማና፤","poem":1},{"text":"ፆልንቶት ባንታ ፖኡዋ ድጋና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ጎዳይ ፅዮነን ግድድ ደቻና፤","poem":1},{"text":"የሩሳላመን ባ ቃላ ስሳና፤","poem":2},{"lineBreak":true},{"text":"ሳሎይነ ሳእ ኮኮራና።","poem":2},{"text":"ሽን ጎዳይ ባ አሳስ፥","poem":1},{"text":"እስራኤለስ ባቃትድ አትያ በሲ ግዳና።”","poem":2}]},{"type":"heading","content":["ፆሳ ደረይ አንጀታና"]},{"type":"verse","number":17,"content":[{"text":"“ሄ ዎደ ህንተ፥ ታኒ ታ ጌሻ ዙማ ቦላ፥","poem":1},{"text":"ፅዮነን ደእያ ጎዳ ህንተ ፆሳ ግደይሳ ኤራና።","poem":2},{"text":"የሩሳላመ ካታማይ ጌሽ ግዳና፤","poem":1},{"text":"አላጋት ዛሪድ የሩሳላመ ኦሎኮና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሄ ጋላስ ደረት ማልአንቶ ዎይነ ኡሻን ፆካና፤","poem":1},{"text":"ዙማት ማ ጎጋና።","poem":2},{"text":"ይሁዳ ቢታን ደእያ ሻፋ ኡባን","poem":1},{"text":"ሃ ፑልታና።","poem":2},{"text":"ጎዳ ኬን ፑልቶይ ቃና፤","poem":1},{"text":"ሴፅማ ዛንጋራ ኡሻና።","poem":2}]},{"type":"verse","number":19,"content":["“ግብፀይ ባይሳ ግዳና፤",{"text":"ኤዶመይ ቦድላ ባዞ ግዳና።","poem":2},{"text":"ኤንቲ ይሁዳ አሳ ቦላ ኢታባ ኦዶሶና፤","poem":1},{"text":"ፅሎ አሳ ሱ ጉስዶሶና።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ሽን ይሁድነ የሩሳላመይ መርናዉ፥","poem":1},{"text":"የለታ ኡባስ ደእያ በሲ ግዳና።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ታኒ ሀሎ ከዮና አግዳ ኤንታ ሱ","poem":1},{"text":"ሃሉዋ ቡሮ ከያና” ያጌስ ጎዳይ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":21}