{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JON","translationId":"gof_etw","name":"ዮናሳ ማፃፋ","commonName":"ዮናሳ ማፃፋ","title":"ዮናሳ ማፃፋ","order":32,"numberOfChapters":4,"sha256":"a1ca4244767f9479d164b7f253be9e79bb08dacea7a2345c6a00b1f4d2619cf0","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/gof_etw/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["ዮናሳ ዎሳ"]},{"type":"verse","number":1,"content":["ዮናስ ሞሉዋ ኡሎን ደእሸ፥ ባ ጎዳ ፆሳ ሀይሳዳ ያግድ ዎስስ።"]},{"type":"verse","number":2,"content":[{"text":"“ታኒ ታ ዋያን ደአሸ ነና ፄጋስ፤","poem":1},{"text":"ነካ ታዉ ስአዳሳ።","poem":2},{"text":"ታኒ ስኦለ ጪሙዋ ግዶን ደአሸ፥","poem":1},{"text":"ማዶ ኮያዳ ኔኮ ዋሳስ","poem":2},{"lineBreak":true},{"text":"ነካ ታ ዋሱዋ ስአዳሳ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኔኒ ታና አባ ጪሙዋን ዱገ የጋዳሳ።","poem":1},{"text":"ሃ ታ ዩሹዋ ተቅስ፤","poem":2},{"lineBreak":true},{"text":"ዎልቃማ ዙለይ ታ ቦላራ አስ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"‘ታኒ ነ ስንፈ ዎራ ሆለታስ፥","poem":1},{"text":"ሽን ነ ጌሻ ኬ ዛራዳ በአና’ ጋዳ ቆፓስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሃ ታዉ ቆ ጋክስ፥","poem":1},{"text":"አባ ጪሞይ ታና ምትስ።","poem":2},{"lineBreak":true},{"text":"አባን ደእያ ማታይ ታ ሁጰን ፃፀትስ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታኒ ሃ ጋርሳን ደእያ ደረታ ባሱዋ ጋካዳ ምተታስ፥","poem":1},{"text":"ቢታ ዉላይ መርናዉ ታ ቦላ ጎርደትስ፥","poem":2},{"lineBreak":true},{"text":"ሽን ታ ጎዳዉ ፆሳዉ፥ ኔኒ ታ ሸምፕዉ ኢታ ኦላፈ ከሳዳሳ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታ ሸምፕያ ዶጭዳ ዎደ፥","poem":1},{"text":"ጎዳዉ ታ ነና ቆፓስ፤","poem":2},{"lineBreak":true},{"text":"ታ ዎሳይ ኔኮ ነ ጌሻ ኬ ጋክስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሀዳ ግድዳ ኤቃ ፆሳታ ቦላ ዘምፐይሳት፥","poem":1},{"text":"ነዉ ደእያ ባንታ አማነተ አጎሶና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሽን ታኒ ጋላታ ማዝሙረ ነዉ ያርሻና።","poem":1},{"text":"ታ ቃንግዳባካ ነዉ ጋና።","poem":2},{"lineBreak":true},{"text":"አይስ ጊኮ፥ አቶተይ ፆሳፈ” ያግስ።","poem":2}]},{"type":"verse","number":10,"content":["ሄሳፈ ጉየ፥ ጎዳይ ሞሉዋ ኪትስ። ሞሎይ ዮናሳ መላ ቢታ ቦላ ጮይስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}