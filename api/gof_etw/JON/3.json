{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JON","translationId":"gof_etw","name":"ዮናሳ ማፃፋ","commonName":"ዮናሳ ማፃፋ","title":"ዮናሳ ማፃፋ","order":32,"numberOfChapters":4,"sha256":"a1ca4244767f9479d164b7f253be9e79bb08dacea7a2345c6a00b1f4d2619cf0","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/gof_etw/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":3,"content":[{"type":"heading","content":["ዮናስ ናናወ ቡሳ"]},{"type":"verse","number":1,"content":["ጎዳ ቃላይ ናምአን ዮናሳኮ ሀይሳዳ ያግድ ይስ።"]},{"type":"verse","number":2,"content":["“ደንዳዳ ግታ ካታማ ናናወ ባ፤ ታ ነዉ ኦድያ ቃላ ኤንታዉ አዋጃ” ያግስ።"]},{"type":"verse","number":3,"content":["ዮናስ ጎዳስ ኪተትድ ናናወ ብስ። ናናወይ ዳሮ ግታ ካታማ። ሀ ጋፃፐ ህን ጋፃ ጋካናዉ ሄ ቃማ ሄመስ።"]},{"type":"verse","number":4,"content":["ዮናስ ካታማ ገልድ እስ ጋላሳ ኦገ ሄመትድ፥ “ናናወይ ኦይታሙ",{"noteId":0},"ጋላሳፐ ጉየ ያና” ያግድ አዋጅስ።"]},{"type":"verse","number":5,"content":["ናናወ አሳይ ፆሳ አማንዶሶና። ፆማ አዋጅዶሶና፤ ጉፈ ግታ ጋካናዉ አስ ኡባይ ካዮ ማኦ ማእዶሶና።"]},{"type":"heading","content":["ናናወ አሳይ ጎዳኮ ስሙዋ"]},{"type":"verse","number":6,"content":["ናናወ ካዎይ ሄ ኦዳ ስእዳ ዎደ ባ ካዎተ አራታፐ ዎድ፥ ካዎተ ማኡዋ ቃርድ ካዮ ማኦ ማእድ ብዶ ቦላ ኡትስ።"]},{"type":"verse","number":7,"content":["ናናወ ደርያስ ሀይሳዳ ያግድ አዋጅስስ፦ “ካዋፐነ እያ ሞርናታፐ ከይዳ ኪታዳ ሀችፈ ዶምድ ህንተራነ ህንተ መሄታራ፥ አይብባካ ሞና መላ ኡዮና መላ።"]},{"type":"verse","number":8,"content":["አስነ መሄ ኡባይ ካዮ ማኦ ማኦ። እስ እስ አስ ምንድ ፆሳኮ ዋሶ። ባ ኢታ ኦግያፐ ስሞ፥ ባ ኢታ ኦሱዋካ አጎ።"]},{"type":"verse","number":9,"content":["ፆሳይ ኑስ ቃትድ፥ ኑኒ ዮና መላ ባ ዎልቃማ ሀንቁዋፈ ስማነኮ ኦን ኤር!” ያግስ።"]},{"type":"verse","number":10,"content":["ኤንቲ ባንታ ኢታ ኦግያፐ ስምዳይሳ ፆሳይ በእዳ ዎደ ኤንታዉ ቃትድ ኤንታ ቦላ ኤሀና ግዳ ኢታባ አጋግስ።"]}],"footnotes":[{"noteId":0,"caller":"+","text":"እብራወ ዶናን ፃፈትዳይሳን ኦይታሙ ግያ ዎደ ሀራ ካሰ ብርሸት ሄ ጎሶና።","reference":{"chapter":3,"verse":4}}]},"thisChapterLink":"/api/gof_etw/JON/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JON/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JON/2.json","previousChapterAudioLinks":{},"numberOfVerses":10}