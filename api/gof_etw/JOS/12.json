{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOS","translationId":"gof_etw","name":"እያሱ ማፃፋ","commonName":"እያሱ ማፃፋ","title":"እያሱ ማፃፋ","order":6,"numberOfChapters":24,"sha256":"1e893e6e16f84318d1b2f991cbc85eb9d119eed3591c98b650a4a7111cec640b","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/JOS/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/gof_etw/JOS/24.json","totalNumberOfVerses":656},"chapter":{"number":12,"content":[{"type":"heading","content":["ፆነትዳ ካዎታ"]},{"type":"verse","number":1,"content":["እስራኤለ አሳይ ዮርዳኖሰ ሻፋፐ ዶሎሀ ባጋራ ደእያ አርኖና ዛንጋራፐ ብድ አርሞና ዙማ ጋካናዉ፥ ቃስ ዶሎሀ ባጋራ ዮርዳኖሰ ዛንጋራ ጋካናዉ ደእያ ቢታ ኡባ ኦልድ ኦይክስ። ሄ ፆነትዳ ካዎት ሀይሳፈ ካልድ ፃፈትዳይሳታ፤"]},{"type":"verse","number":2,"content":["ሀሰቦናን ኡትድ ሃርያ አሞረታ ካዋ ስሆና። እ ጋላዳ ቢታስ ባጋ ኤክድ፥ አርኖና ዛንጋራ ማታን ደእያ አሮራፐ ደንድድ፥ አሞነታ ዛዋ ያቦቃ ሻፋ ጋካናዉ ደኤይሳ ሃሬስ።"]},{"type":"verse","number":3,"content":["ቃስ ዶሎሀ ባጋራ ዮርዳኖሰ ዛንጋራን ከነሬታ አባፈ ብድ፥ ቤት-ያሽሞታ ባጋራ ማፅነ አባ ካንድ፥ ፕስጋ ደርያፐ ጋርሳ ባጋራ ደእያ ቢታታ ሃሬስ።"]},{"type":"verse","number":4,"content":["ሄሳዳካ፥ ራፋይመታ ሼሻፐ ዉርሰ ግድዳ፥ አስታሮተነ ኤድራአ ሃርያ፥ ባሳነ ካዋ ኦገ ፆንስ።"]},{"type":"verse","number":5,"content":["ኦገይ፥ ሃርያ ዛዋይ ፑደሀን አርሞና ዙማ፥ ዶሎሀን ሳላካ ካታማ ጋክድ፥ ዉሎሀን ጌሹረታነ ማካታ ዛዋ ጋካናዉ ደእያ ባሳነ ቢታ ኡባ ጋኬስ። ሀሰቦና ካዋ ስሆና ቢታ ጋላዳ ፑደሀ ባጋ ጉጅድ ሃሬስ።"]},{"type":"verse","number":6,"content":["ጎዳ አይለይ ሙሰይ ካለን፥ እስራኤለ አሳይ ሀ ካዎታ ፆንዶሶና። ጎዳ አይለይ ሙሰይ ኤንታ ቢታ ሮቤላ ኮቻታስ፥ ጋዳ ኮቻታስነ ምናሰ ኮቻፈ ባጋስ ሻክድ ላትስስ።"]},{"type":"verse","number":7,"content":["እያሱይነ እስራኤለ አሳይ ዮርዳኖሰ ሻፋፐ ዉሎሀ ባጋን ደእያ ካዎታ ኡባ ፆንዶሶና። ሄ ቢታይ ልባኖሰ ዛንጋራን ደእያ ባኣል-ጋደፐ ብድ፥ ዱገሀ ባጋራ ሳይረ ማታን ደእያ ሀላቃ ደርያ ጋኬስ። እያሱይ ሄ ቢታ ሻክድ፥ እስራኤለ ኮቻታስ ላታ ቢታ ኦድ እምስ።"]},{"type":"verse","number":8,"content":["ሄ እ እምዳ ቢታይ፥ ደረይ ዳርያ ቢታ፥ ዉሎሀ ባጋን ደእያ ጋ፥ ዮርዳኖሰ ዛንጋራ፥ ይሁዳነ ነገበ መላ ቢታ። ሄ ቢታይ ካሰ ህተት፥ አሞረት፥ ካናነት፥ ፓርዘት፥ ህወትነ ያቡሰት ደእያ ቢታ።"]},{"type":"verse","number":9,"content":["እስራኤለ አሳይ ፆንዳ ካዎት ሀይሳፈ ካልድ ፃፈትዳይሳታ፤ እያርኮ ካዋ፥ ቤተለ ማታን ደእያ ጋየ ካዋ፥"]},{"type":"verse","number":10,"content":["የሩሳላመ ካዋ፥ ከብሮና ካዋ፥"]},{"type":"verse","number":11,"content":["ያርሙታ ካዋ፥ ላክሶ ካዋ፥"]},{"type":"verse","number":12,"content":["ኤግሎና ካዋ፥ ገዘራ ካዋ፥"]},{"type":"verse","number":13,"content":["ዳብራ ካዋ፥ ገደራ ካዋ፥"]},{"type":"verse","number":14,"content":["ሆርማ ካዋ፥ አራዳ ካዋ፥"]},{"type":"verse","number":15,"content":["ልብና ካዋ፥ አዱላማ ካዋ፥"]},{"type":"verse","number":16,"content":["ማቀዳ ካዋ፥ ቤተለ ካዋ፥"]},{"type":"verse","number":17,"content":["ታፑሀ ካዋ፥ ሄፌራ ካዋ፥"]},{"type":"verse","number":18,"content":["አፌቃ ካዋ፥ ሳሮና ካዋ፥"]},{"type":"verse","number":19,"content":["ማዶና ካዋ፥ ሀዞራ ካዋ፥"]},{"type":"verse","number":20,"content":["ሽምሮን-ማሮና ካዋ፥ አዝፋ ካዋ፥"]},{"type":"verse","number":21,"content":["ታናካ ካዋ፥ ማግዶ ካዋ፥"]},{"type":"verse","number":22,"content":["ቃደሳ ካዋ፥ ቃርመሎሳን ደእያ ዮቅናመ ካዋ፥"]},{"type":"verse","number":23,"content":["ገዘን ደእያ ዶራ ካዋ፥ ጋልጋላን ደእያ ጎይማ ካዋነ"]},{"type":"verse","number":24,"content":["ትርሳ ካዋ። ኤንቲ ኩመ ሀስታማነ እስ ካዎታ።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/JOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/JOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":24}