2},{"text":"ያን ደእያ ጌላኦ ናይት ኡንኤትዶሶና፤","poem":1},{"text":"እያካ ኡንኤታዳ ዬካዉሱ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እ ሞርከት እዉ ጎዳ ግድዶሶና፤","poem":1},{"text":"ኤንታዉ እንጀትን ደእዶሶና።","poem":2},{"text":"እ፥ ናጋራ ጋሶን ጎዳይ እዮ ኡንኤስ፤","poem":1},{"text":"እ ናይት ሞርከታን ድኤትድ ብዶሶና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ፅዮን ቦንቾይ ኢፐ ቃረትስ፤","poem":1},{"text":"እ፥ ሀላቃትካ ምያ በሲ ይዳ ጋራዳ ሀንዶሶና፤","poem":2},{"text":"ኤንቲ ዎልቃ ይድ","poem":1},{"text":"ባንታና የደይሳታ ስንፈ ባቃትዶሶና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"የሩሳላመይ ባ መቱዋነ ባ ኡንአ ጋላሳን፥","poem":1},{"text":"በን ባ ቦንቾ ሻሉዋ ሀሳያዉሱ።","poem":2},{"text":"እ፥ አሳይ ሞርከታ ኩሸን አድ እመትዳ ዎደ፥","poem":1},{"text":"እዮ ማድያ እሶይካ በንትቤና።","poem":2},{"text":"እ ሞርከት እዮ ፄልድ፥","poem":1},{"text":"እ ዩዋን ሚጭዶሶና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"የሩሳላመይ ግታ ናጋራ ኦዳ ግሾ ቱናሱ፤","poem":1},{"text":"እዮ ቦንችዳ ኡባይ እ ካሉዋ በእዳ ግሾ ካስ፤","poem":2},{"lineBreak":true},{"text":"እያ ኦላሸ ጉየ ስማሱ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ቱናተ እ አፍላ ቦላ በንትስ፤","poem":1},{"text":"ስንፈ ባ ቦላ ያናባ ቆፓቡኩ።","poem":2},{"text":"እ ኩንደይ ዳጋንያባ ግድስ፤","poem":1},{"text":"እዮ ምንያ ኦንካ ባዋ።","poem":2},{"text":"እያ፥ “አቤት ጎዳዉ፥ ታ ኡንኤተ በአ!","poem":1},{"text":"ታ ሞርከት ታና ፆንዶሶና” ያጋሱ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሞርከት እ ቦንቾ ሻሉዋ ቦንቅዶሶና፤","poem":1},{"text":"ካሰ ነ ማባራ ግዶ ገሎና መላ፥","poem":2},{"lineBreak":true},{"text":"ኔኒ ድግዳ አሳት፥ እ ኬ ገልሽን በአሱ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እ አሳት ኮሻትድ ካ ደማናዉ ኦሎሶና፤","poem":1},{"text":"ኤንቲ ደኦን ዳናዉ ባንታ ሻሉዋ ካን ላሞሶና።","poem":2},{"text":"የሩሳላመይ ሀይሳዳ ያጋሱ፤","poem":1},{"text":"አቤት ጎዳዉ፥ ታና ፄላ፤","poem":2},{"lineBreak":true},{"text":"ታ ካዉሻተ በአ!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ህንተኖ፥ ሀይሳራ አይሳቶ፥","poem":1},{"text":"ሀይስ ህንተዉ አይኮካ ዳነኔ?","poem":2},{"text":"አነ በእተ፤ አኬክተ፤","poem":1},{"text":"ባ ኤፅያ ሀንቆ ጋላሳን፥","poem":2},{"text":"ፆሳይ ታ ቦላ ኤህዳ","poem":1},{"text":"መቱዋ መላ መቶይ ደኢ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ቦላፈ ታማ ዱገ የድስ፤","poem":1},{"text":"ሄ ታማይ ታ መቀ ግዶ ገልስ።","poem":2},{"text":"ታ ቶሆይ ፅሄን ኦይከትስ፤ ታና ጉየ ዛርስ፤","poem":1},{"text":"ታና ጋላስ ኡባ ላባንድ የግ አግስ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ታ ኦዳ ናጋራ ኡባ ሺሽ ቃችድ፥","poem":1},{"text":"ቃምባራዳ ታ ጋናን ዎስ፤","poem":2},{"lineBreak":true},{"text":"ያትድ ታ ዎልቃ ዉርስስ።","poem":2},{"text":"ታ ኤቀታናዉ ዳንዳኦና አሳስ፥","poem":1},{"text":"ታና አድ እሚስ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ጎዳይ ታ ግዶን ደእያ","poem":1},{"text":"ዎልቃማ ኦላንቾታ ኡባ ድግስ።","poem":2},{"text":"ታ ያላጋታ ይሳናዉ ዎደ ቃችስ፤","poem":1},{"text":"ዎይነ የይሳዳ፥","poem":2},{"lineBreak":true},{"text":"ጎዳይ ይሁዳ ጌላኦታ የስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ታኒ ዬካሸ ታ አፉ ጉሰይ ሄሳሳ፤","poem":1},{"text":"ታና ምንይነ ካትስያ ኦንካ ባዋ፤","poem":2},{"lineBreak":true},{"text":"ሞርከይ ጎብን፥ ታ ናይት ኡንኤትዶሶና።","poem":2}]},{"type":"verse","number":17,"content":["ፅዮነይ ባ ኩሽያ ምጫሱ፤",{"text":"ሽን እዮ ምንያ ኦንካ ባዋ።","poem":2},{"text":"እ ዩሹዋን ደኤይሳት","poem":1},{"text":"እዮ ሞርካናዳ ጎዳይ ኦስ።","poem":2},{"lineBreak":true},{"text":"የሩሳላመይ ኤንታ ግዶን ቱና ግዳሱ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እያ ሀይሳዳ ያጋሱ፤ “ጎዳይ ፅሎ፤","poem":1},{"text":"እያ ኪተቶና እፅዳይ ታና።","poem":2},{"text":"ህንተኖ፥ አሳቶ ኡባይ ስእተ፤ ታ መቱዋካ በእተ፤","poem":1},{"text":"ታ ፓንትነ ታ ጌላኦት ድኤትዶሶና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ታ ላገታ ፄጋስ፤ ሽን ኤንቲ ታና ጭምዶሶና፤","poem":1},{"text":"ካህነትነ ጭማት ባንታ ሸምፑዋ አሻናዉ፥","poem":2},{"lineBreak":true},{"text":"ካ ኮይሸ ካታማ ግዶን ሀይቅዶሶና።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አቤት ጎዳዉ፥ ታ ዋይያ በአ!","poem":1},{"text":"ታ ጋርሳይ ዳጋምስ።","poem":2},{"text":"ታኒ ዳሮ ማካልዳ ግሾ፥ ታ ዎዛናይ መቅስ፤","poem":1},{"text":"ካረን ማሽ ዉርሴስ፤ ሶን ሀይቆይ ደኤስ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አሳይ ታ ዘለልሳ ስእዶሶና፤","poem":1},{"text":"ሽን ታና ምንያ እስ አስካ ባዋ።","poem":2},{"text":"ታ ሞርከት ታ መቱዋ ስእዶሶና፤","poem":1},{"text":"ነ ታ ቦላ ኦዳባን ኡፋይትዶሶና።","poem":2},{"text":"ኤንቲ ታዳ ሀናና መላ፥","poem":1},{"text":"ኤንታ ቦላ ነ አዋጅዳ ጋላሳ ኤሀ!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ኤንታ ኢታተ ኡባይ ነ ስን ጋኮ፤","poem":1},{"text":"ታ ናጋራ ግሾ ታና ሴርዳይሳዳ ኤንታካ ሴራ፤","poem":2},{"lineBreak":true},{"text":"ታ ዘለልሳይ ዳርስ፤ ታ ዎዛናይካ መቅስ።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}