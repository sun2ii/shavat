{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"LAM","translationId":"gof_etw","name":"ኤርምያሳ ምላልሳ","commonName":"ኤርምያሳ ምላልሳ","title":"ኤርምያሳ ዘለልሳ","order":25,"numberOfChapters":5,"sha256":"fc38ec0cca73c6a87bbc080ac45c2c00371a943056226d7c87cad00ebcde3208","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/gof_etw/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"heading","content":["ቃይ ባይና ሴራ"]},{"type":"verse","number":1,"content":[{"text":"ጎዳይ ባ ሀንቆ ሻራፐ ጋርሳን፥","poem":1},{"text":"ፅዮነ ናእዉ፥ ዋትድ ዎደ!","poem":2},{"text":"እስራኤለ ቦንቹዋ ሳሎፐ ሳአ ሆልስ፤","poem":1},{"text":"ባ ሀንቁዋ ጋላስ፥","poem":2},{"lineBreak":true},{"text":"እያ ቶሆይ የያ በሳ ቆፕቤና።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ጎዳይ ይሁዳን ኬታ ኡባ ቃቶና ይስስ፤","poem":1},{"text":"ባ ሀንቁዋን ይሁዳ ቢታ ሚፃ ኡባ ላልስ፤","poem":2},{"lineBreak":true},{"text":"ሄ ካዎተነ ሀላቃታ ሳአን ዱገ የግድ ካዉሽስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ባ ዎልቃማ ሀንቁዋን እስራኤለ ዎልቃ መንረስ፤","poem":1},{"text":"ሞርከይ እያ ኦላናዉ ያ ዎደ","poem":2},{"lineBreak":true},{"text":"ጎዳይ ባ ኡሻቻ ኩሽያ ኤንታ ቦላፈ ድግስ።","poem":2},{"text":"ባ ዩሹዋን ደእያባ ኡባ ምያ ታማዳ፥","poem":1},{"text":"ያይቆባ ቦላ ታማ ላጮይ ኤፅስ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሞርከዳ እ ባ ዶንግያ ኤንታ ቦላ ዳፍስ፤","poem":1},{"text":"ኡንኤያ እያ ኡሻቻ ኩሸይ ጊግስ።","poem":2},{"text":"አይፌስ ሎእያ አሳ ኡባ ዎስ፤","poem":1},{"text":"ፅዮነ ቦላ ባ ሸንያ ታማዳ ቆልስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ጎዳይ ሞርከዳ ሀንድ፥ እስራኤለ ይስስ፤","poem":1},{"text":"ካዎ ጋታነ ሚፃ ኡባ ላልስ","poem":2},{"lineBreak":true},{"text":"ይሁዳ አሳስ ዬሆነ ካዮ ጉጅስ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ባ ኬ አታክልተ ጋደን ደእያ ሻቃራዳ ሾድድ ሆልስ፤","poem":1},{"text":"ላይ ባለትነ ሳምባታት ዶገታናዳ ኦስ፤","poem":2},{"lineBreak":true},{"text":"ባ ግታ ሀንቁዋን ካዋነ ካህንያ ካዉሽስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ጎዳይ ባ ያርሾ በሳ ካስ፤ ባ ኬ አጋግስ፤","poem":1},{"text":"ካዎ ጋታ ግምብያ ሞርከታ ኩሸን የግስ።","poem":2},{"text":"ላይ ባኣለ ቦንችያ ጋላሳ ዎጫማዳ፥","poem":1},{"text":"ሞርከት ፆሳ ኬን ዎጫምዶሶና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጎዳይ ፅዮን ናኤ ድርሳ ግምብያ፥","poem":1},{"text":"ላላናዉ ቃችስ፤ እ ቦላ ዋ ዎዶሮ የግስ።","poem":2},{"text":"እዮ ይሶና ደእሸ ባ ኩሽያ ዛረና፤","poem":1},{"text":"ግምበይነ ሚፃይ እስፈ ኩንዳናዳ ኦስ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"የሩሳላመ ፐንገ ሳንቃት ቢታን ሞገትዶሶና፤","poem":1},{"text":"ኤንታ ጎርደ ምታ መንረድ ይስስ።","poem":2},{"text":"ካዎይነ ሞርናት ድኤትድ ካዎተታ ግዶ ብዶሶና፤","poem":1},{"text":"ህገ ታማርሰይ ባዋ፤","poem":2},{"lineBreak":true},{"text":"ናበትካ ህዛፐ ጉየ ቆንጨ በኦኮና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ፅዮነ ጭማት ስእ ግድ ቢታን ኡትዶሶና፤","poem":1},{"text":"ባንታ ሁጰን ባና ቆልድ ካዮ ማኦ ማእዶሶና፤","poem":2},{"lineBreak":true},{"text":"የሩሳላመ ጌላኦት ሳአን ዱገ ሆክዶሶና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታ አሳይ ይዳ ግሾ፥","poem":1},{"text":"ጉ ናይት ካታማ ኦግያ ቦላ","poem":2},{"lineBreak":true},{"text":"ዳቡርድ ኩንድዳ ግሾ፥","poem":2},{"lineBreak":true},{"text":"ታ አይፈይ አፉን ቱልጫትስ፤","poem":2},{"lineBreak":true},{"text":"ታ ዎዛናይ አዛኖን ዳጋምስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኤንቲ ባንታ አየታኮ፥","poem":1},{"text":"“ካ እማ! ሃ እማ”","poem":2},"ያግድ ዋሶሶና፤",{"text":"ካታማ ኦግያን ማዱንፅድ ላባንያ አሳዳ፥","poem":2},{"lineBreak":true},{"text":"ኤንቲ ዳቡርን ኤንታ ሸምፖይ ኤንታ አየታ ክኦን ከዬስ።","poem":2}]},{"type":"verse","number":13,"content":["የሩሳላመ ናተ፥ ታኒ ነባ አይ ጋኔ?",{"text":"ነ ቆሁዋ ታ አይብራ ግናዮ?","poem":2},{"text":"ዶሰትዳ ፅዮነ ጌላኤ፥ ታ ነና ዋታዳ ምን?","poem":1},{"text":"ነ ማዱንይ አባ መላ ጪሞ፤","poem":2},{"lineBreak":true},{"text":"ነና ኦን ፓናዉ ዳንዳኢ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ነ ናበት ዎርዶነ ፓና ቆንጨ በእዶሶና፤","poem":1},{"text":"ነ ድኤቶና መላ ነ ናጋራ ቆንጭስድ ኦድቦኮና፤","poem":2},{"lineBreak":true},{"text":"ኤንቲ ባለያ ዎርዶ ቆንጨ ነዉ በእዶሶና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ነ ማታራ አያ ኡባይ ባ ኩሽያ ባቄስ፤","poem":1},{"text":"“ቢታን ኡባፈ አዳ ሎእያ ካታምያ ሀኖ?","poem":2},{"text":"ቢታ ኡባስ ኡፋይስ ጌተትዳ ካታምያ ሀኖ?”","poem":1},{"text":"ያግድ ነና ቀልቅስሸ ባንታ ሁጵያ ቃዶሶና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ነ ሞርከት ኡባይ ባንታ ዶና","poem":1},{"text":"ነ ቦላ ዶይዶሶና፤","poem":2},{"lineBreak":true},{"text":"ነ ቦላ ቀልቅስዶሶና።","poem":2},{"text":"ባንታ አቻ ቃርጭሸ ሀይሳዳ ያጎሶና፤","poem":1},{"text":"ኑ ኤንታ ይስዳ፥ ኑ አሞትዳይ ሄሳ","poem":2},{"lineBreak":true},{"text":"ዉርሰን በእዳ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ጎዳይ ባ ቆፕዳባ ኦስ፤","poem":1},{"text":"ካሰ ኦድዳ ባ ቃላ ፖልስ።","poem":2},{"text":"የሩሳላመስ ቃቶና እዮ ላልስ","poem":1},{"lineBreak":true},{"text":"እ ሞርከት ኡፋይታና መላ፥","poem":1},{"text":"ሞርከታ ዎልቃ ምንስ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ፅዮነ፥ ነ ድርሳ ግምበይ ጎዳኮ ዋሶ!","poem":1},{"text":"ነ አፉይ ቃማነ ጋላስ ሻፋዳ ጎጎ!","poem":2},{"text":"ነዉካ ሸምፖፋ፤","poem":1},{"text":"ነ አይፍያስ ሸምፖ እሞፋ!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ቃማ ደንዳዳ ዋሳ፤","poem":1},{"text":"ጎዳ ስንን ነ ዎዛና ሃዳ ጉሳ።","poem":2},{"text":"ኮሻትድ ኦገ ዶናን ኩንድዳ ነ ናይታ ሸምፑዋስ","poem":1},{"text":"ነ ኩሽያ እያኮ ፑደ ደንዳ ዎሳ!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አቤት ጎዳዉ፥ በአ!","poem":1},{"text":"ካሰ ሀይሳዳ ኔኒ ኦደ ቦላ ኦዲ?","poem":2},{"text":"አየት ባንታ ክኦን ኮእስድ","poem":1},{"text":"ድችዳ ባንታ ናይታ ሞ ጋይ?","poem":2},{"lineBreak":true},{"text":"ካህነትነ ናበት ፆሳ ኬን ሀይቆ ጋይ?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ጭምነ ናአተ ኦገ ቦላ ኩንድዶሶና፤","poem":1},{"text":"ጌላኦትነ ፓንት ማሻን ዉርዶሶና።","poem":2},{"text":"ኔኒ ነ ሀንቁዋ ጋላስ ኤንታ ዎዳሳ፤","poem":1},{"text":"ኤንታዉ ቃቶና ኤንታ ቡዳሳ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ግብራ ጋላስ አሰ ፄገይሳዳ፥","poem":1},{"text":"ዳጋንያ ታ ሞርከታ ኡባ በሳፈ ፄጋዳሳ።","poem":2},{"text":"ጎዳ ሀንቆ ጋላሳን","poem":1},{"text":"ኦንካ ከስ ኤክቤና ዎይኮ አትቤና።","poem":2},{"text":"ታኒ ታ ክኦን ኮእሳዳ ድችዳ","poem":1},{"text":"ናይታ ኡባ ሞርከይ ዎድ ይስስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}