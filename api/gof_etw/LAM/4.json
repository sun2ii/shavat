{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"LAM","translationId":"gof_etw","name":"ኤርምያሳ ምላልሳ","commonName":"ኤርምያሳ ምላልሳ","title":"ኤርምያሳ ዘለልሳ","order":25,"numberOfChapters":5,"sha256":"fc38ec0cca73c6a87bbc080ac45c2c00371a943056226d7c87cad00ebcde3208","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/gof_etw/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"heading","content":["ጌሻ ሹቻት ላለትዶሶና"]},{"type":"verse","number":1,"content":["ዎርቀይ ጶለይሳ ዋንድ አግዴ?",{"text":"ጌሻ ዎርቃይ ዋንድ ዳምዴ? ፆሳ ኬይ ግምበትዳ ሹቻይ ኦገ ዶናን ላለትስ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ካሰ አልኦ ዎርቃ መላ ቦንቸትዳ ፅዮነ ናይት","poem":1},{"text":"ሀእ ቢታፈ መትዳ ኦቶ ግድዶሶና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሀር አቶሽን ዎራካን ባ ማር ንዉሱ፤","poem":1},{"text":"ሽን ታ አሳይ ባዞን ደእያ ያንቾዳ፥ ባ ናይታስ ኢታ ግድስ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሳሞ ጋሶን ዮጋ ናይታ እንፃርሳይ ኮቶኖራ ኦይከትስ፤","poem":1},{"text":"ናይት ካ ዎሶሶና፤","poem":2},{"lineBreak":true},{"text":"ሽን ኤንታዉ እምያ ኦንካ ባዋ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ካሰ ማልኦ ካ ፃላላ መይሳት","poem":1},{"text":"ሀእ ኦገ ዶናን ኮሻን ዉርዶሶና።","poem":2},{"text":"ካሰ ሊኖ ማእድ ድጭዳይሳት","poem":1},{"text":"ሀእ ብዶ ቦላ ዝንእዶሶና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታ አሳ ናጋራይ፥","poem":1},{"text":"ኦደ ኩሸይካ እዮ ቦቾና፥","poem":2},{"lineBreak":true},{"text":"ቆፖና ሽረትድ ዎዳ ሶዶመ አሳ ናጋራፐ ዳሮ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ይሁዳ ሀላቃት ሻቻፈ አዳ ጌሽ፥","poem":1},{"text":"ማፈ አዳ ቦ።","poem":2},{"text":"ኤንታ አሳተይ ዞኦ እንቆፈ አዳ አርሰ፤","poem":1},{"text":"ኤንታ መይ ሳንፓረ አልኦ ሹቻ መላ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሽን ሀእ ኤንታ ሶምኦይ ሻላፐ አድ ካሬፅስ፤","poem":1},{"text":"አስ ኦገን ኤንታ በእድ ኤረና፤","poem":2},{"lineBreak":true},{"text":"ኤንታ ጎጋይ መቀራ ኦይከትድ ምዳ መልስ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ምያባ ይድ፥ ኮሻን ሀይቅዳይሳታፐ","poem":1},{"text":"ኦላን ሀይቅዳይሳት ሎኦ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታ አሳ ቦላ ይዳ ዩዋ ጋሶን፥","poem":1},{"text":"ቃትያ አየት ባንታ ናይታ ዶይስድ ምዶሶና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጎዳ ሀንቆ ፁአይ ኩምስ፤ እ ባ ሱልያ ሸንያ ትግስ።","poem":1},{"text":"የሩሳላመ ባሱዋ ታማ ኦይስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሀ ሳአ ካዎታፐ ዎይኮ ካዎተታን ደእያ አሳፐ ኦንካ","poem":1},{"text":"ሞርከይ የሩሳላመ ፐንግያራ ገላና ግድ አማንበና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሽን ሀይስ ሀንዳይ እያ ናበታ ናጋራስነ እያ ካህነት ኦዳ ናቁዋሳ፥","poem":1},{"text":"ፅሎታ ሱ እያ ግዶን ጉስዳ ግሾሳ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኤንቲ ቆቀ አሳዳ፥ ኦገ ታታፎሶና፤","poem":1},{"text":"ኤንቲ ሱን ቱንዳ ግሾ","poem":2},{"lineBreak":true},{"text":"ኤንታ ማኡዋ ኦንካ ቦቻናዉ ኮየና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሄሳ ግሾ፥ አሳይ፥ “ክችተ! ህንተ ቱና ግድያ ግሾ፥","poem":1},{"text":"ኑና ቦቾፍተ!” ያግድ ኤንታ ቦላ ዋስዶሶና።","poem":2},{"text":"ኤንቲ ባቃትድ ቶይላትያ ዎደ፥","poem":1},{"text":"ካዎተታን ደእያ አሳይ፥","poem":2},{"lineBreak":true},{"text":"“ህንተ ኑራ ሀይሳን ዳናዉ ዳንዳኤከታ” ያግዶሶና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ጎዳይ ኤንታ ላልስ፤ እ ኤንታባ ዛሪድ ቆፐና፤","poem":1},{"text":"ኤንታ ካህነት ቦንቸቶኮና፤","poem":2},{"lineBreak":true},{"text":"ኤንታ ጭማት ናሸቶኮና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ኑ አይፈይ ማዶ ደማናዉ ፄልሸ ጮ ዳቡርስ፤","poem":1},{"text":"ኑና አሻናዉ ዳንዳኦና","poem":2},{"lineBreak":true},{"text":"ካዎተታፐ ማዶ ናግዳ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"አሳይ ኑ ገዳ ካልያ ግሾ፥","poem":1},{"text":"ኑ ካታማ ኦገራ ሄመታናዉ ዳንዳእቦኮ።","poem":2},{"text":"ኑ ዉርሰይ ማትስ፤ ኑ ላይይ ዉርስ፤","poem":1},{"text":"ኑስ ዮ ዎደይካ ጋክስ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ኑና የደይሳት ፕራያ አርጋንፈ አድ ኤሶቶሶና፤","poem":1},{"text":"ኤንቲ ኑና ደረ ሁጰራ የደዶሶና፤","poem":2},{"lineBreak":true},{"text":"ባዞን ሆክድ ኑና ናግዶሶና።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ጎዳይ ትይዳ ካዎይ፥ ኑ ደኡዋስ ሸምፖይ፥","poem":1},{"text":"ኤንታ ፅህያን ኦይከትስ።","poem":2},{"text":"ኑ እያ ኩያ ጋርሳን ኡትድ፥","poem":1},{"text":"ካዎተታ ግዶን ዳና ግድ ቆፕዳ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ህንተኖ፥ ኡፃ ቢታን ደእያ ኤዶመ አሳዉ፥","poem":1},{"text":"ኡፋይትተ፤ ሀሹ ጊተ።","poem":2},{"text":"ሽን ፁአይ ህንተ ቦላ ያና፤","poem":1},{"text":"ህንተ ማትድ ካሎ አታና።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ህንተኖ፥ ፅዮነ አሳዉ፥ ህንተ ሴራይ ግዳና፤","poem":1},{"text":"እ ህዛፐ ህንተና ድኦ ቢታን ዎና።","poem":2},{"text":"ሽን ኤዶመ አሳዉ፥ ህንተ ሴረታና፤","poem":1},{"text":"ህንተ ናጋራይካ ቆንጫና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}