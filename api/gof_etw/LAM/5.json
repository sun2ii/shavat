poem":2}]},{"type":"verse","number":9,"content":[{"text":"ማሻን ዎይሳት ባዞን ደእያ ግሾ፥","poem":1},{"text":"ኑ ሸምፑዋ ባይዝድ ካ ደምዳ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኢታ ኮሻ ጋሶን፥","poem":1},{"text":"ኑ ጎጋይ ታማ ጮጨዳ ምቼስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ማጫሳታ ፅዮነን","poem":1},{"text":"ጌላኦታ ይሁዳ ካታማታን","poem":2},{"lineBreak":true},{"text":"ዎልቃን ኦይክድ ቱንስዶሶና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሀላቃታ ኤፍድ ካቅዶሶና፤","poem":1},{"text":"ጭማት ቦንቸትቦኮና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ያላጋ አደት ዎፃን ጋጭዶሶና፤","poem":1},{"text":"አደ ናይት ዴፆ ም ቶክድ ጋንድጋርዶሶና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ጭማት ካታማ ፐንገን ፕርዳናዉ ኡተይሳ አግዶሶና፤","poem":1},{"text":"ያላጋ አደት ናይት የ ዶግዶሶና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኑ ዎዛናፐ ኡፋይስ ክችስ፤","poem":1},{"text":"ኑ ዱርሳይ ዬሆን ላመትስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኑ ሁጵያፐ ካላቻይ ኩንድስ፤","poem":1},{"text":"ኑ ናጋራ ኦዳ ግሾ ኑና አየ!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሄሳ ግሾ፥ ኑ ዎዛናይ ዳቡርስ፤","poem":1},{"text":"ኑ አይፈይ ተልጁምስ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ፅዮነ ደረይ ባይሳ ግድዳ ግሾ፥","poem":1},{"text":"ዎርካናት ያን ጉፖሶና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አቤት ጎዳዉ፥ ነ መርናዉ ሃራሳ፤","poem":1},{"text":"ነ አራታይ የለታፐ የለታ ጋካናሳ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ኔኒ ኑና አይስ ኡባ ዎደ ዶጋይ?","poem":1},{"text":"ሀይሳ መላ አዱሳ ዎደ ኑና አይስ አጋይ?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አቤት ጎዳዉ፥ ኑና ኔኮ ዛራ፤ ኑ ስማና፤","poem":1},{"text":"ኑ ዎድያ በንይሳ ዛራዳ ኦራ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ኔኒ ኑና ፖሎ አጋድዬ?","poem":1},{"text":"ነ ሀንቁዋስ ዛው ባወዬ?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}