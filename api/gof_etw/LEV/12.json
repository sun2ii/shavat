{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"LEV","translationId":"gof_etw","name":"ሌወታ ማፃፋ","commonName":"ሌወታ ማፃፋ","title":"ሌወታ ማፃፋ","order":3,"numberOfChapters":27,"sha256":"ab21e581d9b36ff022d6fba68db8b6592afbe06f39203aaa82c4e8917da9fb4c","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/LEV/1.json","lastChapterNumber":27,"lastChapterApiLink":"/api/gof_etw/LEV/27.json","totalNumberOfVerses":859},"chapter":{"number":12,"content":[{"type":"heading","content":["ማጫስ የል ስሚድ ጌይያ ዎጋ"]},{"type":"verse","number":1,"content":["ጎዳይ ሙሰኮ ሀይሳዳ ያግስ፤"]},{"type":"verse","number":2,"content":["እስራኤለ አሳስ ሀይሳዳ ያጋዳ ኦዳ፤ “እስ ማጫስ ቃንታዳ አደ ናአ የልኮ፥ ባ ኩሸ መቱዋ በእያ ዎደ ቱና ግደይሳዳ ላፑን ጋላስ ጋካናዉ ቱና ግዳና።"]},{"type":"verse","number":3,"content":["ሆስፑን ጋላስ ናአይ ቃፃረታናዉ ኮሼስ።"]},{"type":"verse","number":4,"content":["ሄሳፈ ጉየ፥ ማጫስያ ባ የሎ ሱይ ፅዝአና ጋካናዉ ሀስታማነ ሄ ጋላስ ጋምኦ፤ ቃስ ባ ጌይያ ጋላሳይ ዉራና ጋካናዉ ጌሻባ ቦቾፎ፤ ጌሻ ዱንካንያካ ገሎፖ።"]},{"type":"verse","number":5,"content":["“ሽን እስ ማጫስ ማጫ ናአ የልኮ፥ ባ ኩሸ መቶ በእዳ ዎደ እያ ቱና ግድዳይሳዳ ናምኡ ሳምንታ ጋካናዉ እያ ቱና ግዳና። ሄሳፈ ጉየ፥ ባ የሎ ሱይ ፅዝአና ጋካናዉ ኡሱፑን ታማነ ኡሱፑን ጋላስ ጋምኦ።"]},{"type":"verse","number":6,"content":["“ማጫስያ አደ ናአ ዎይኮ ማጫ ናአ የላዳ ባ ጌይያ ዎድያ ኦንግዳፐ ጉየ፥ ፁሳ ያርሾስ እስ ላይ ዶርሰነ ናጋራ ያርሾስ ቃስ እስ ሆለ ዎይኮ እስ ኩራቾ ጌሻ ዱንካንያ ፐንገን ደእያ ካህንያኮ ኤሆ።"]},{"type":"verse","number":7,"content":["ካህነይ ሄሳ ኤክድ ጎዳ ስንን እ ናጋራ አቶተስ ያርሼስ። ሄሳፈ ጉየ፥ እያ ጌያና። አደ ናአ ዎይኮ ማጫ ናአ የልያ ማጫሳስ ደእያ ዎጋይ ሀይሳ።"]},{"type":"verse","number":8,"content":["“ሽን እያ እስ ላይ ዶርሰ ኤሀናዉ ዳንዳኦና እፅኮ፥ ናምኡ ሆለታ ዎይኮ ናምኡ ኩራቾታ ኤሆ። ኤንታፈ እሶይ ፁሳ ያርሾስ፥ ቃስ እሶይ ናጋራ ያርሾስ ግዶ። ሄሳዳ ኦድ ካህነይ እ ናጋራ አቶተስ ያርሼስ፤ እያካ ጌሽ ግዳና።”"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/LEV/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/LEV/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/LEV/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}