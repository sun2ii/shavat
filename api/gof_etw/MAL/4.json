{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"MAL","translationId":"gof_etw","name":"ምልክያሳ ማፃፋ","commonName":"ምልክያሳ ማፃፋ","title":"ምልክያሳ ማፃፋ","order":39,"numberOfChapters":4,"sha256":"72d5f426364da9ded247f3b3660fb15572b92f382e860ddb79b13302ca89979b","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/MAL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/gof_etw/MAL/4.json","totalNumberOfVerses":55},"chapter":{"number":4,"content":[{"type":"heading","content":["ጎዳ ጋላሳ"]},{"type":"verse","number":1,"content":["“ሄኮ፥ ጮጨ ታማዳ ኤፅያ ጋላስ ያና፤ ኦቶራንቾትነ ኢታ ኦይሳት ኡባይ ቡረ መላ ግዳና። ሄ ያ ጋላሳይ ኤንታ ፁጋና፤ ኤንታዉ ፃጶነ ፄራ አሸና” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።"]},{"type":"verse","number":2,"content":["ሽን “ህንተዉ፥ ታ ሱንስ ያየይሳታስ፥ ፅሎተ አው ባ ቀፈ ጋርሳን ፓፆተ ኤክድ ከያና። ህንተ ቃሾፐ የደትዳ ኮኦ ጋሎዳ ጉፓና።"]},{"type":"verse","number":3,"content":["ታኒ ኦያ ጋላስ፥ ናጋራንቾት ህንተ ቶሆፐ ጋርሳን ብድን ግዳና፤ ህንተ ኤንታ የና” ያጌስ ኡባፈ ዎልቃማ ጎዳይ።"]},{"type":"verse","number":4,"content":["“እስራኤለ አሳይ ኪተታና መላ ታኒ ኮሬባ ዙማ ቦላ ታ አይልያ ሙሰ ባጋራ እምዳ ህግያነ ኪታ አኬክተ።"]},{"type":"verse","number":5,"content":["“ሄኮ፥ ግታነ ያሽያ ጎዳ ጋላሳይ ያናፐ ካሰታዳ፥ ታኒ ህንተዉ ናብያ ኤልያሳ ኪታና።"]},{"type":"verse","number":6,"content":["ታኒ ያዳ ቢታ ባደን ይሶና መላ አዋታ ዎዛና ናይታኮ፥ ናይታ ዎዛና አዋታኮ ዛራና” ያጌስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/MAL/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/MAT/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/MAL/3.json","previousChapterAudioLinks":{},"numberOfVerses":6}