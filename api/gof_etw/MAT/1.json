,{"lineBreak":true},{"text":"ዳዊቲ ኮይሮ ኦርዮ ማቸፈ ሶሎሞነ የልስ፤","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ሶሎሞነይ ኦሮብኣማ የልስ፤","poem":1},{"lineBreak":true},{"text":"ኦሮብኣመይ አብያ የልስ፤","poem":1},{"lineBreak":true},{"text":"አብይ አሳፋ የልስ፤","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"አሳፍ እዮሳፈፃ የልስ፤","poem":1},{"lineBreak":true},{"text":"እዮሳፈፅ እዮራማ የልስ፤","poem":1},{"lineBreak":true},{"text":"እዮራም ኦዝያና የልስ፤","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ኦዝያን እዮአታመ የልስ፤","poem":1},{"lineBreak":true},{"text":"እዮአታም አካዛ የልስ፤","poem":1},{"lineBreak":true},{"text":"አካዝ ህዝቅያሳ የልስ፤","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ህዝቅያስ ምናሰ የልስ፤","poem":1},{"lineBreak":true},{"text":"ምናሰይ አሞነ የልስ፤","poem":1},{"lineBreak":true},{"text":"አሞን እዮስያሳ የልስ፤","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"እስራኤለ አሳይ ድኤትድ ባብሎነ ቢታ ብዳ ዎደ እዮስያስ እኮንያናነ እያ እሻታ የልስ።","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ባብሎነ ቢታ እስራኤለ አሳይ ድኤትድ ብዳፐ ጉየ እኮንያን ሳላትያላ የልስ።","poem":1},{"lineBreak":true},{"text":"ሳላትያል ዛሩባበላ የልስ፤","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ዛሩባበል አብድዩ የልስ፤","poem":1},{"lineBreak":true},{"text":"አብድዩይ ኤልያቄመ የልስ፤","poem":1},{"lineBreak":true},{"text":"ኤልያቄም አዛራ የልስ፤","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"አዛር ሳዶቃ የልስ፤","poem":1},{"lineBreak":true},{"text":"ሳዶቅ አክመ የልስ፤","poem":1},{"lineBreak":true},{"text":"አክመይ ኤልዩዳ የልስ፤","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ኤልዩድ አላዛራ የልስ፤","poem":1},{"lineBreak":true},{"text":"አላዛር ማታነ የልስ፤","poem":1},{"lineBreak":true},{"text":"ማታነይ ያይቆባ የልስ፤","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ያይቆብ ዮሰፋ የልስ፤","poem":1},{"lineBreak":true},{"text":"ዮሰፍ ክርስቶሳ ጌተትያ የሱሳ የልዳ ማይራም አዝና።","poem":1}]},{"type":"verse","number":17,"content":["ህዛ፥ የለተይ አብራሃመፐ ዳዊታ ጋካናዉ ታማነ ኦይዳ። ዳዊታፐ ብድ ባብሎነ ድኡዋ ጋካናዉ ታማነ ኦይዳ። ባብሎነ ድኡዋፐ ብድ ክርስቶሳ ጋካናዉ ታማነ ኦይዱ የለተ ግዴስ።"]},{"type":"heading","content":["የሱስ ክርስቶሳ የለተ"]},{"type":"verse","number":18,"content":["የሱስ ክርስቶሳ የለተ ታርከይ ሀይሳፈ ካለይሳ። እያ አይያ ማይራማ ዮሰፋስ ኦይሸታ ደአሸ ዮሰፋራ ጋሄቶና ጌሻ አያናፐ ቃንታሱ።"]},{"type":"verse","number":19,"content":["ዮሰፍ ፅሎ አስ ግድዳ ግሾ እዮ አሳን ከሳናዉ ኮይቤና። ያንያ ግሾ ቆሳን እዮ አጋናዉ ቆፕስ።"]},{"type":"verse","number":20,"content":["እ ሄ ቆፋን ደእሽን ፆሳ ኪታንቾይ አሙሆን ቆንጭድ፥ “ዳዊታ ናአዉ፥ ዮሰፋ፥ ማይራማ ቃንትዳይ ጌሻ አያናፐ ግድያ ግሾ እዮ ኤካናዉ ያዮፋ” ያግስ።"]},{"type":"verse","number":21,"content":["እያ አደ ናአ የላና፥ እ ባ ደርያ ኤንታ ናጋራፐ አሽያ ግሾ እያ ሱን ነ የሱሳ ጋዳ ፄጋና።"]},{"type":"verse","number":22,"content":["ጎዳይ ናብያ እሳያሳ ዶናን፥"]},{"type":"verse","number":23,"content":["“ሄኮ ጌላእያ ቃንታና፤ አደ ናአ የላና፤ እያ ሱንይ አማኑኤላ” ጌተታና ጎይስ ፖለታና መላ ሀ ኡባይ ሀንስ። አማኑኤላ ገይሳስ ብርሸይ “ፆሳይ ኑራ ደኤስ” ጉሱ።"]},{"type":"verse","number":24,"content":["ዮሰፍ ስኮፈ ባርክድ ጎዳ ኪታንቾይ ኪትዳይሳ መላ ማይራሞ ባ ሶ ኤፍስ።"]},{"type":"verse","number":25,"content":["ሽን ባ ባይራ ናአ የላና ጋካናዉ እዮ ቦችቤና፤",{"noteId":0},"የለትዳ ናአካ የሱሳ ግድ ፄግስ።"]}],"footnotes":[{"noteId":0,"caller":"+","text":"እዮ ቦችቤና፦ ማችራ አዝናራ አቀይሳዳ እስፈ አቅቦኮና ጉሱ።","reference":{"chapter":1,"verse":25}}]},"thisChapterLink":"/api/gof_etw/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/MAL/4.json","previousChapterAudioLinks":{},"numberOfVerses":25}