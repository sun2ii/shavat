{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"MIC","translationId":"gof_etw","name":"ምክያሳ ማፃፋ","commonName":"ምክያሳ ማፃፋ","title":"ምክያሳ ማፃፋ","order":33,"numberOfChapters":7,"sha256":"b2bbf1ed8a0453fd92eeac49df31014ffea82a3d11166cf2a3cbe523ed14c2db","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/gof_etw/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"heading","content":["እስራኤለ አሳ ዋየ"]},{"type":"verse","number":1,"content":["ታና አየ! ታኒ ቴራ አይፈይ ማፀትድ ዉርን፥ ዎይንያፐነ ባላሰ ምፈ ባ አሞትዳይሳ ደማናዉ ዳንዳእቦና ኮሻትዳ ኡራ መላ ግዳስ።"]},{"type":"verse","number":2,"content":["ፆሳ አስ ቢታን ባዋ፤ አሳ ጋርሳን ሱረ አስ ይስ። አስ ኡባይ አሳ ሱ ጉሳናዉ ሆክድ ናጌስ፤ ኡባይ ባ እሻ ግተን ኦይካናዉ ካሌስ።"]},{"type":"verse","number":3,"content":["ኤንታ ናምኡ ኩሸት ኢታባ ኦናዉ ሎህዶሶና። ሀላቅነ ዳይን ዎፈ ኦይቾሶና፤ ዎልቃራ ደእያ አሳት ባንታ ኮይዳባ ዎልቃን ፖልሶሶና። ኤንቲ ኡባይ እስፈ ፕርዳ ምርቅድ ይሶሶና።"]},{"type":"verse","number":4,"content":[{"text":"ኤንታ ጋርሳን ኬሀ ጌተተይስ አጉን መላ፤","poem":1},{"text":"ሱረ ጌተተይስ ክንቾተ መላ።","poem":2},{"text":"ጎዳይ ናበታ ባጋራ ኦድዳይሳዳ","poem":1},{"text":"እ ባ አሳ ሴራና ጋላሳይ ጋክስ፤","poem":2},{"lineBreak":true},{"text":"ኤንቲ ያርካና ዎደይ ሀእ ማትስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ነ ሾሩዋ አማኖፓ፤","poem":1},{"text":"ነ ላግያን አማነቶፋ።","poem":2},{"text":"ኔራ ደእያ ነ ማቸፈ ነ ዶና ናጋ።","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ሄ ዎደ ናአይ ባ አዋ ካስ፤","poem":1},{"text":"ናእያ ባ አየ ቦላ፥","poem":2},{"lineBreak":true},{"text":"ናኣ ማችያ ባ አዝና አየ ቦላ","poem":2},{"lineBreak":true},{"text":"ሞርከተን ደንዳና።","poem":2},{"text":"አሳስ እያ ሶ አሳይ ሞርከ ግዳና።","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ሽን ታኒ ኡፋይሳን ጎዳ ፄላና፤","poem":1},{"text":"ታና አሽያ ፆሳ ናጋና፤","poem":2},{"lineBreak":true},{"text":"ታ ፆሳይ ታና ስአና።","poem":2}]},{"type":"heading","content":["እስራኤለይ ደንዳና"]},{"type":"verse","number":8,"content":[{"text":"ታ ሞርክያዉ፥ ታ መቱዋን ኡፋይቶፋ፤","poem":1},{"text":"ታኒ ኩንድኮካ ደንዳና፤","poem":2},{"lineBreak":true},{"text":"ታ ማን ኡትኮካ ጎዳይ ታዉ ፖአና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ታኒ ጎዳ ናቃስ፤","poem":1},{"text":"እ ታዉ ሞተትድ፥ ታባ ፕርዳና ጋካናዉ፥","poem":2},{"lineBreak":true},{"text":"ታኒ እያ ሀንቁዋ ዳንዳአና።","poem":2},{"text":"እ ታና ፖኦን ከሳና፤","poem":1},{"text":"ታኒ እያ ፅሎ ፕርዳ በአና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሄ ዎደ ታ ሞርከይ ሄሳ በአና፤","poem":1},{"text":"ታኮ፥ “ጎዳይ ነ ፆሳይ አዉን ደኢ?”","poem":2},{"lineBreak":true},{"text":"ያግድ ቀልቅስዳይ ዬላ ማአና።","poem":2},{"text":"እ ኦገን ደእያ ኡርቃዳ የትን፥","poem":1},{"text":"ታኒ ታ አይፈን በአና።","poem":2}]},{"type":"verse","number":11,"content":["ህንተኖ፥ እስራኤለ አሳዉ፥ ህንተ ካታማ ግምበ ድርሳት ድረትያ ጋላሳይ ያና፤ ሄ ጋላስ ህንተ ዛዋይ አካና።"]},{"type":"verse","number":12,"content":["ሄ ጋላስ ህንተ አሳይ ህንተኮ ስማና። ኤንቲ አሶረፐ፥ ግብፀፈ፥ ኤፍራፂሳ ሻፋ ሄራን ደእያ ቢታታፐ፥ ሃሆ በሳን ደእያ አባ ጋፃፐነ ቃ ዙማታፐ ህንተኮ ስማና።"]},{"type":"verse","number":13,"content":["ሽን ቢታይ እያ ቦላ ደእያ አሳ ኢታተ ጋሶን አስ ባይና ባይሳ ግዳና።"]},{"type":"heading","content":["ዎሳነ ጋላታ"]},{"type":"verse","number":14,"content":["ኔኒ ባዞን ባርካ ደእያ፥ ነ ላታ ደርያ ነ አራዳ ቢታን ነ አሳ ሄማ። ኤንቲ ካሰ ዎድያዳ ባሳነንነ ጋላዳን ሄመታና መላ ኦ።"]},{"type":"verse","number":15,"content":["ጎዳይ፥ “ህንተ ግብፀፐ ከይዳ ዎድያዳ ታኒ ህንተና ማላልስያባ በሳና” ያጌስ።"]},{"type":"verse","number":16,"content":["ኤንታ ዎልቃይ ግታ ግድኮካ፥ ካዎተት ኡባይ ሄሳ በእድ ዬላታና። ኤንቲ ዬላትድ፥ ባንታ ዶና ኦይካና፤ ኤንታ ሀይይ ቱላና።"]},{"type":"verse","number":17,"content":["ኤንቲ ሾሻዳነ ሳአራ ጎሸትያ መተታዳ ቢታ ላጫና። ኤንቲ ባንታ ሚፃፐ ኮኮርሸ ከይድ ግታ ዳጋማን ጎዳኮ፥ ኑ ፆሳኮ፥ ስማና፤ ኤንቲ ጎዳ ያይድ ዳና።"]},{"type":"verse","number":18,"content":["ናጋራ ኡባ አቶ ያገይ፥ አትዳ ባ አሳ ናቁዋ ታይቦናይ ነ መላ ፆሲ ኦኔ? ማሮተ ነና ኡፋይስያ ግሾ ነ ሀንቁዋን መርናዉ ጋምአ ኤራካ።"]},{"type":"verse","number":19,"content":["ኔኒ ዛራዳ ነ አሳስ ቃታሳ፤ ኑ ናቁዋ ነ ቶሁዋን የሳ፤ ኑ ናጋራ አባ ጪሞን ሆላሳ።"]},{"type":"verse","number":20,"content":["ኔኒ በን ኑ ማይዛታስ ጫቅዳ ጫቁዋዳ አብራሃመነ ያይቆባ ዛረ ግድዳ ነ አሳስ ነ አማነተነ ነ መርና ሲቁዋ በሳና።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}