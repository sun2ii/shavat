{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"NUM","translationId":"gof_etw","name":"ታይቦ ማፃፋ","commonName":"ታይቦ ማፃፋ","title":"ታይቦ ማፃፋ","order":4,"numberOfChapters":36,"sha256":"625dc3646db5367fd3cdb3a9b42faeb387807ae96e762cd1e5e2a5a4f6d4eeba","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/gof_etw/NUM/36.json","totalNumberOfVerses":1212},"chapter":{"number":17,"content":[{"type":"heading","content":["አሮና ፃምአ አጨ"]},{"type":"verse","number":1,"content":["ጎዳይ ሙሰኮ፥"]},{"type":"verse","number":2,"content":["“እስራኤለ አሳይ እስ እስ ኮቻ ሀላቃታፐ እስ እስ ፃምአ ኤክድ ታማነ ናምኡ ፃምአ ነዉ ኤሀና መላ ኤንታዉ ኦዳ። ሄ ፃምኣ ቦላ እስ እስ አሳ ሱን ፃፋ።"]},{"type":"verse","number":3,"content":["እስ እስ ኮቻ ሀላቃስ እስ ፃምአ ኮሽያ ግሾ፥ ሌወ ፃምኣ ቦላ አሮና ሱን ፃፋ።"]},{"type":"verse","number":4,"content":["ሄ ፃምአታ ጌሻ ዱንካንያ ግዶን ታ ኔራ ጋሄትያ ታቦትያ ስንን ዎ።"]},{"type":"verse","number":5,"content":["ታ ዶርያ ኡራ ፃምአይ አጫና፤ ሄሳዳ ኦዳ ህንተ ቦላ እስራኤለ አሳ ዙዙን ታ ተቃና” ያግስ።"]},{"type":"verse","number":6,"content":["ሄሳ ሙሰይ እስራኤለ አሳስ ኦድን፥ ታማነ ናምኡ ሀላቃት ሁጰን ሁጰን እስ እስ ፃምአ ኤህዶሶና። አሮና ፃምአይካ ሄ ፃምአታ ግዶን ደኤስ።"]},{"type":"verse","number":7,"content":["ሙሰይ ሄ ፃምአታ ኡባ ጌሻ ዱንካንያ ግዶን ጎዳ ስንን ዎስ።"]},{"type":"verse","number":8,"content":["ዎንተ ጋላስ ሙሰይ ጌሻ ዱንካንያ ግዶ ገልያ ዎደ ሌወ ኮቸ ግድዳ አሮና ፃምአይ አጭዳይሳ፥ ጋምቡፅዳይሳ፥ ጪይዳይሳነ ላዉዘ ም አይፈ አይፍዳይሳ በእስ።"]},{"type":"verse","number":9,"content":["ሙሰይ ፃምአ ኡባ ጎዳ ስንፈ ኤህድ እስራኤለ አሳ በስስ። ኤንቲ ሀንዳባ በእዳፐ ጉየ እስ እስ ሀላቃይ ባንታ ፃምኣ ፃምኣ ኤክዶሶና።"]},{"type":"verse","number":10,"content":["ጎዳይ ሙሰኮ፥ “አሮና ፃምኣ ታቦትያ ስንን ዛራዳ ዎ። ማካልዳ እስራኤለ አሳይ ታ ቦላ ዙዙን አጎና እፅኮ ሀይቃናይሳ ኤንታዉ ማላታ ኦዳ ዎ” ያግስ።"]},{"type":"verse","number":11,"content":["ሙሰይ፥ ጎዳይ ኪትዳይሳዳ ኦስ።"]},{"type":"verse","number":12,"content":["እስራኤለ አሳይ ሙሰኮ፥ “ሄሳ ግድኮ፥ ኑ ኡባይ ሀይቃና፤ ያና።"]},{"type":"verse","number":13,"content":["ጌሻ ዱንካንያኮ ሺቅያ ኡባይ ሀይቃና ግድኮ፥ ኑ ኡባይካ ሀይቆስ ጉሰዬ?” ያግዶሶና።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/NUM/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/NUM/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/NUM/16.json","previousChapterAudioLinks":{},"numberOfVerses":13}