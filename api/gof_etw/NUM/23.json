{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"NUM","translationId":"gof_etw","name":"ታይቦ ማፃፋ","commonName":"ታይቦ ማፃፋ","title":"ታይቦ ማፃፋ","order":4,"numberOfChapters":36,"sha256":"625dc3646db5367fd3cdb3a9b42faeb387807ae96e762cd1e5e2a5a4f6d4eeba","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/gof_etw/NUM/36.json","totalNumberOfVerses":1212},"chapter":{"number":23,"content":[{"type":"heading","content":["ባላማ ኮይሮ ሃሳያ"]},{"type":"verse","number":1,"content":["ባላም ባላቃኮ፥ “ሀይሳን ታዉ ላፑን ያርሾ በሳታ ግምባ፤ ቃስ ላፑን ኮርማታነ ላፑን ማራዘታ ታዉ ጊግሳ” ያግስ።"]},{"type":"verse","number":2,"content":["ባላም ግዳይሳዳ ባላቅ ኦስ፤ ኤንቲ ናምአይ እስ እስ ያርሾ በሳን እስ ኮርማነ እስ ማራዘ ያርሽዶሶና።"]},{"type":"verse","number":3,"content":["ያትድ፥ ባላም ባላቃኮ፥ “ኔኒ ነ ያርሹዋ ማታን ደኣሻ፤ ታኒ ገደ ባና። ኦን ኤር ጎዳይ ታራ ጋሄታናዉ ዮና አገና፤ እ ታዉ ቆንጭስያባ ኡባ ታ ነዉ ኦዳና” ያግድ እስ ደረ ቦላ ከይስ።"]},{"type":"verse","number":4,"content":["ያን ፆሳይ ባላማራ ጋሄትን፥ ባላም፥ “ታኒ ላፑን ያርሾ በሳታ ጊግሳስ፤ እስ እስ ያርሾ በሳን እስ ኮርማነ እስ ማራዘ ያርሻስ” ያግስ።"]},{"type":"verse","number":5,"content":["ባላም ጋናባ ጎዳይ እያዉ ኦድድ፥ “ኔኒ ባላቃኮ ስማዳ እያዉ ሀ ኪታ ኦዳ” ያግስ።"]},{"type":"verse","number":6,"content":["ባላም ስምያ ዎደ ባላቅ ሞአበ ሀላቃታ ኡባራ ባ ያርሹዋ ማታን ኤቅስ።"]},{"type":"verse","number":7,"content":["ባላም ሀይሳዳ ያግድ ትንብተ ኦድስ፤",{"text":"“ሞአበ ካዎይ፥ ባላቅ፥ ዶሎሀ ባጋ ደረታፐ፥","poem":1},{"text":"ሶረ ቢታፈ ታና ኤህስ፤","poem":2},{"text":"‘ሃ ያ፤ ያይቆባ ታዉ ባዳ፤","poem":1},{"text":"እስራኤለ አሳ ባዳ’ ያግስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ፆሲ ባድቦናይሳ ታ ዋታዳ ባዶ?","poem":1},{"lineBreak":true},{"text":"ጎዳይ፥ ባድቦናይሳ ታ ዋታዳ ባዶ?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ታ ቃ ዛላ ሁጰን ኤቃዳ ኤንታ ፄላይስ፤","poem":1},{"text":"ዙማ ቦላ ኤቃዳ ኤንታ በአይስ።","poem":2},{"text":"ኤንቲ ባንታርካ ደእያ ደረ፤","poem":1},{"text":"ኤንቲ ሀራ ካዎተታፐ ዱማ ግደይሳ ኤሮሶና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ያይቆባ ባና ኦን ታይብ ኦንጋኔ?","poem":1},{"text":"እስራኤለ ሳይሱዋ ኦን ታይብ ካንኔ?","poem":2},{"text":"ፅሎታ ሀይቁዋ ታ ሀይቃርክና፤","poem":1},{"text":"ታ ዉርሰይ ኤንታይሳዳ ሀኖ” ያግስ።","poem":2}]},{"type":"verse","number":11,"content":["ባላቅ ባላማኮ፥ “ኔኒ ታ ቦላ ኦያባይ አይቤ? ታኒ ነና ታ ሞርከታ ባዳና መላ ኤሀስ፥ ሽን ኔኒ ኤንታ አንጃዳሳ፤ ሀራባ አይኮካ ኦባካ” ያግስ።"]},{"type":"verse","number":12,"content":["ባላም ዛሪድ፥ “ጎዳይ ታዉ ኦደይሳፈ ሀራ ኦዶዬ?” ያግስ።"]},{"type":"heading","content":["ባላማ ናምአን ሃሳያ"]},{"type":"verse","number":13,"content":["ባላቅ ባላማኮ፥ “ኤንታ ኔኒ በአናዉ ዳንዳእያ ሀራ በሲ ታራ የ፤ ያንካ ነ ኤንታፈ ጉራ በኣሳፐ አትሽን፥ ኡባ በአካ። ኔኒ ያን ኤቃዳ ኤንታ ባዳርክ” ያግስ።"]},{"type":"verse","number":14,"content":["ፕስጋ ደርያ ሁጰን ደእያ ፆፍማ ደምባ ኤፍስ። ያን ላፑን ያርሾ በሳታ ግምብድ፥ እስ እስ ያርሾ በሳን እስ ኮርማነ እስ ማራዘ ያርሽስ።"]},{"type":"verse","number":15,"content":["ባላም ባላቃኮ፥ “ኔኒ ሀይሳን ነ ያርሹዋ ማታን ደኣሻ፤ ታኒ ጎዳራ ጋሄታናዉ ገደ ባና” ያግስ።"]},{"type":"verse","number":16,"content":["ጎዳይ ባላማራ ጋሄትድ፥ “ኔኒ ባላቃኮ ስማዳ እያዉ ሀ ኪታ ኦዳ” ያግስ።"]},{"type":"verse","number":17,"content":["ባላም ስሚድ ያ ዎደ ባላቅ ሞአበ ቢታ ሀላቃታራ ያርሹዋ ማታን ኤቅዳይሳ ደምስ። ባላቅ እያኮ፥ “ጎዳይ ነዉ አይ ኦድዴ?” ያግስ።"]},{"type":"verse","number":18,"content":["ባላም ሀይሳዳ ያግድ ትንብተ ኦድስ፤",{"text":"“ስፎራ ናአዉ፥ ባላቃ፥ ደንዳ፤","poem":1},{"text":"ታ ኦደይሳ ሎይዳ ስአ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዎርዶታናዉ ፆሳይ አሰ ግደና፤","poem":1},{"text":"ባ ቆፋ ላማናዉ አሳ ናአ ግደና።","poem":2},{"text":"ኦድድ፥ ባ ኦድዳይሳ ኦኔ?","poem":1},{"text":"ዎይኮ ባ ግዳይሳ ፖለኔ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ታኒ አንጃናዉ ኪታ ኤካስ፤","poem":1},{"text":"እ አንጅስ፤ ታ ላማናዉ ዳንዳእከ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ያይቆባ ኮቻ ቦላ ኢታባይ ዬና፤","poem":1},{"text":"እስራኤለ አሳ መቶይ ጋከና።","poem":2},{"text":"ጎዳይ፥ ኤንታ ፆሳይ ኤንታራ ደኤስ፤","poem":1},{"text":"እ ኤንታዉ ካዎ ግደይሳ አዋጆሶና።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ፆሳይ ኤንታ ግብፀፈ ከስስ፤","poem":1},{"text":"እ ምኖ መንዳ ኤንታዉ ኦለቴስ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ያይቆባ ኮቻ ቦላ ብት ኦና፤","poem":1},{"text":"እስራኤለ አሳ ቆሀና ሙሩኖይ ባዋ።","poem":2},{"text":"ሄኮ፥ ያይቆባስነ እስራኤለስ","poem":1},{"text":"‘ፆሳይ ኦዳባ በእተ’ ያጋና።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ሀ አሳይ ማጫ ጋሞዳ ደንዴስ፤","poem":1},{"text":"ባ ኦይክዳባ ማና ጋካናዉ፥","poem":2},{"lineBreak":true},{"text":"ባ ዎዳይሳ ሱ ኡያና ጋካናዉ፥","poem":2},{"lineBreak":true},{"text":"ሸምፖና ጋሞዳ ደንዶሶና” ያግስ።","poem":2}]},{"type":"verse","number":25,"content":["ያትን፥ ባላቅ ባላማኮ፥ “ነ ኤንታ ኡባካ ባዶፋ፤ ኡባካ አንጆፋ” ያግስ።"]},{"type":"verse","number":26,"content":["ባላም ዛሪድ፥ “ታኒ ጎዳይ ግያባ ፃላላ ኦና ጋዳ ነዉ ኦዳብክና?” ያግስ።"]},{"type":"heading","content":["ባላማ ሄን ሃሳያ"]},{"type":"verse","number":27,"content":["ባላቅ ባላማኮ፥ “ሃያ፤ ታ ነና ሀራ በሲ ኤፋና። ኦን ኤር፥ ሄሳን ፆሳይ ኡፋይትድ፥ ኔኒ ያን ኤቃዳ ኤንታ ባዳና መላ ኦናዉ ዳንዳኤስ” ያግስ።"]},{"type":"verse","number":28,"content":["ባላቅ ባላማ ባዙዋ ዱገ ፄልያ ፓኦራ ዙማ ቦላ ኤፍስ።"]},{"type":"verse","number":29,"content":["ባላም፥ “ኔኒ ሀይሳን ታዉ ላፑን ያርሾ በሳታ ግምባ፤ ቃስ ላፑን ኮርማታነ ላፑን ማራዘታ ታዉ ጊግሳ” ያግስ።"]},{"type":"verse","number":30,"content":["ባላም ግዳይሳዳ ባላቅ ኦስ፤ እስ እስ ያርሾ በሳን እስ ኮርማነ እስ ማራዘ ያርሽስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/NUM/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/NUM/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/NUM/22.json","previousChapterAudioLinks":{},"numberOfVerses":30}