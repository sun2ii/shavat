{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"NUM","translationId":"gof_etw","name":"ታይቦ ማፃፋ","commonName":"ታይቦ ማፃፋ","title":"ታይቦ ማፃፋ","order":4,"numberOfChapters":36,"sha256":"625dc3646db5367fd3cdb3a9b42faeb387807ae96e762cd1e5e2a5a4f6d4eeba","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/gof_etw/NUM/36.json","totalNumberOfVerses":1212},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":["ባላም እስራኤለ አንጀይስ ጎዳ ኡፋይስዳይሳ እ በእዳ ዎደ ካሰ እ ኦይሳዳ ብታ ማላ ኮይቤና፥ ሽን ባ ሶምኡዋ መላ ቢታኮ ዛርስ።"]},{"type":"verse","number":2,"content":["እ ቁ ግድ ፄልያ ዎደ እስራኤለ አሳይ ባ ኮቻን ኮቻን ዱንካንድ ኡትዳይሳ በእያ ዎደ ፆሳ አያናይ እያ ቦላ ዎስ።"]},{"type":"verse","number":3,"content":["እ ሀይሳዳ ያግድ ትንብተ ኦድስ፤",{"text":"“ብኦራ ናኣ ባላማ ትንብትያ፤","poem":1},{"text":"እያ አይፈይ ዶየትን ፄልያ አድያ ትንብትያ፤","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ፆሳይ ግያባ ስኤይሳ ትንብትያ፤","poem":1},{"text":"እ ሶምኦራ ጉፋንን፥ እያ አይፈይ ዶየትዳይስ፤","poem":2},{"lineBreak":true},{"text":"ኡባ ዳንዳእያ ፆሳ ቆንጨ በእዳ አድያ ትንብተይ ሀይሳ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ያይቆባ፥ ነ ዱንካነት፥","poem":1},{"text":"እስራኤለ፥ ነ ጉታት፥","poem":2},{"lineBreak":true},{"text":"አይባ ሎኦና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኤንቲ ምጨትዳ ዛንጋራዳ፥","poem":1},{"text":"ሻፋ ጋፃን ደእያ አታክልትያ በሳዳ፥","poem":2},{"lineBreak":true},{"text":"ጎዳይ ቶክዳ ጎዳረ ኡዳ፥","poem":2},{"lineBreak":true},{"text":"ሃ ጋፃን ደእያ ዝጋ ምዳ ሀኖሶና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኤንታ ፁጋይ ሃን ኩማና፤","poem":1},{"text":"ኤንታ ኮቻይ ግድያ ሃ ደማና።","poem":2},{"text":"ኤንታ ካዎይ ካዋ አጋጋፐ አና፤","poem":1},{"text":"ኤንታ ካዎተይ ቦንቸታና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ፆሳይ ኤንታ ግብፀፈ ከስስ፤","poem":1},{"text":"እ ምኖ መንዳ ኤንታዉ ኦለቴስ።","poem":2},{"text":"ኤንታ ሞርከታ መንረስ፤","poem":1},{"text":"ኤንታ መቀ ጋጬስ፤","poem":2},{"lineBreak":true},{"text":"ባ ዶንግያን ጫዴስ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኤንቲ ጋሞዳ ዝንእዶሶና፤","poem":1},{"text":"ማጫ ጋሞዳ ዛቁልዶሶና፤","poem":2},{"lineBreak":true},{"text":"ኤንታ ቦሸቻናዉ ዳንዳኤይ ኦኔ?","poem":2},{"text":"ኤንታ አንጅያ ኡባይ አንጀታና፤","poem":1},{"text":"ኤንታ ባድያ ኡባይ ባደታና” ያግስ።","poem":2}]},{"type":"verse","number":10,"content":["ያትን፥ ባላቅ ባላማ ቦላ ይሎትስ። ባ ኩሽያ ባቅድ ባላማኮ፥ “ታ ሞርከታ ባዳና መላ ታ ነና ኤሀስ፥ ሽን ኔኒ ሄ ቶሆ ኤንታ አንጃዳሳ።"]},{"type":"verse","number":11,"content":["ሀእ ኤለሳዳ ነ ሶ ባ፤ ታ ነና ዳሮባ ዎይታና ጋስ፥ ሽን ኔኒ ዎይቱዋ ኤኮና መላ ጎዳይ ነና ድግስ” ያግስ።"]},{"type":"verse","number":12,"content":["ባላም ባላቃኮ ዛሪድ፥ “ኔኒ ታኮ ኪትዳ አሳኮ፥"]},{"type":"verse","number":13,"content":["‘ባላቅ ሀር አቶሽን ባ ካዎተን ኩምዳ ብራነ ዎርቃ ታዉ እምያባ ግድኮካ ጎዳይ ኦድዳይሳ መንዳ ሎኦ ዎይኮ ኢታ ታ ሸነን ኦናዉ ዳንዳእከ። ታኒ ጎዳይ ግያባ ፃላላ ኦዳና’ ጋዳ ነዉ ኦዳብክናዬ?” ያግስ።"]},{"type":"heading","content":["ባላማ ኦይዳን ሃሳያ"]},{"type":"verse","number":14,"content":["ባላም ባላቃኮ፥ “ታኒ ሀእ ታ አሳኮ ባይስ፤ ሽን ነ ሃያ፤ እስራኤለ አሳይ ያና ዎድያን ነ አሳ ኦናባ ታ ነዉ ኦዳና” ያግስ።"]},{"type":"verse","number":15,"content":["እ ባ ትንብትያ ሀይሳዳ ያግድ ኦድስ፤",{"text":"“እያ አይፈይ ትሽ ኦድ ፄልያ፥","poem":1},{"text":"ብኦራ ናኣ ባላማ ትንብተይ ሀይሳ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሀይስ ፆሳይ ግያባ ስኤይሳ ትንብትያ፥","poem":1},{"text":"ኡባ ዳንዳእያ ፆሳፈ","poem":2},{"lineBreak":true},{"text":"ግድዳ ኤራተ ደእያ ኡራይ።","poem":2},{"text":"ልች ግድ ሶምኦራ ጉፋንን፥","poem":1},{"text":"እያ አይፈይ ዶየትዳይስነ","poem":2},{"text":"ኡባ ዳንዳእያ ፆሳ","poem":1},{"text":"ቆንጨ በኤይሳ ትንብተይ ሀይሳ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“ታኒ እያ በአይስ፥ ሽን ዎደይ ሀእ ግደና፤","poem":1},{"text":"ታ እያ ፄላይስ፥ ሽን ማታን ዴና።","poem":2},{"text":"ያይቆባ ሼሻፐ ፆልንቶይ ከያና፤","poem":1},{"text":"እስራኤለፐ ካዎተ ፃምአይ ከያና።","poem":2},{"text":"ሞአበ አሳ ሶምኡዋ እ ጋጫና፤","poem":1},{"text":"ሴታ አሳ ኡባ ሁጵያ እ ትንቻና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ኤዶመይ ፆነታና፤","poem":1},{"text":"እያ ሞርከይ ሳይረይ ኦይከታና፤","poem":2},{"lineBreak":true},{"text":"ሽን እስራኤለይ ምን ምን ባና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ያይቆባፐ ሃረይስ ከያና፤","poem":1},{"text":"ካታማን ፓፃ አትዳይሳታ ይሳና” ያግስ።","poem":2}]},{"type":"verse","number":20,"content":["ሄሳፈ ጉየ፥ ባላም አማለቃ በእድ ሀይሳዳ ያግድ ትንብተ ኦድስ፤",{"text":"“አማለቅ ካዎተታ ግዶን ኮይሮ፥","poem":1},{"text":"ሽን ኤንታ ዉርሰይ ዮ” ያግስ።","poem":2}]},{"type":"verse","number":21,"content":["ቃስ ባላም ቄና በእድ ሀይሳዳ ያግድ ትንብተ ኦድስ።",{"text":"“ህንተ ደእያ በሳይ ሳሮ በሲ፤","poem":1},{"text":"ህንተ ኬይ ዛላ ቦላ ኬፀትስ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ሽን አሶረት ህንተና ድእያ ዎደ፥","poem":1},{"text":"ህንተ ቄና አሳይ ያና” ያግስ።","poem":2}]},{"type":"verse","number":23,"content":["ዉርሰን ባላም ሀይሳዳ ያግድ ትንብተ ኦድስ፤",{"text":"“ፆሳይ ሄሳ ኦያ ዎደ፥","poem":1},{"text":"ኦን ደኦን ዳናዉ ዳንዳኢ?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ማርካበት ቆጵሮሳፐ ያና፤","poem":1},{"text":"ኤንቲ አሶረነ ኤቤራ ፆናና፤","poem":2},{"lineBreak":true},{"text":"ሽን ኤንትካ ቃስ ያና” ያግስ።","poem":2}]},{"type":"verse","number":25,"content":["ሄሳፈ ጉየ፥ ባላም ደንድድ ባ ሶ ስምስ፤ ባላቅካ ባ ኦግያ ብስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/NUM/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/NUM/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/NUM/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}