ber":11,"content":[{"text":"ኤንቲ፥ “ኑራ የ፤","poem":1},{"text":"አሰ ዎናዉ ሆክድ ናጎስ፤","poem":2},{"lineBreak":true},{"text":"ፅሎታ ዎናዉ ቆሰቶስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ስኦለይ ምተይሳዳ ኑካ ኤንታ ፓፃ ምቶስ፤","poem":1},{"text":"ኑ ኤንታ ኦላን የገትያ አሳዳ ኦና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኑኒ አልኦ ሚሸ ኡባ ደማና፤","poem":1},{"text":"ኑ ኬ ቦንቀ ሚሸን ኩንና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኑራ ላገታ፤","poem":1},{"text":"ኑ ደምዳባ እስፈ ሻከታና” ያጋና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ታ ናአዉ፥ ኤንታራ ሄመቶፋ፤","poem":1},{"text":"ኤንታ ኦግያራ ባናዉ ነ ቶሁዋ ደንፋ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኤንቲ ኢታባ ኦናዉ ዎፆሶና፤","poem":1},{"text":"አሳ ሱ ጉሳናዉ ያ ሃ ጎሶና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ካፎይ ፄልሽን፥","poem":1},{"text":"እያ ኦይካናዉ ግተ የገ ማደና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሽን ኤንቲ ባንታ ሱ ጉሳናዉ ሆኮሶና፤","poem":1},{"text":"ባንታ ሸምፑዋ ዎናዉ ቆሰቶሶና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ገነን ጎአ ደምያ አሳ ዉርሰ ሄሳ መላ፤","poem":1},{"text":"ኤንቲ ሺሽዳ ሻሎይ ኤንታ ሸምፑዋ ኤኬስ።","poem":2}]},{"type":"heading","content":["ጭንጫተ ፄጌስ"]},{"type":"verse","number":20,"content":[{"text":"ጭንጫተ ዳጋላ ቦላ ኤቃዳ ፄጋዉሱ፤","poem":1},{"text":"ዳባባን ባ ቃላ ቁ ኦዳ ስሳዉሱ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ጭንጫተ አስ ሺቅያ በሳን ኤቃዳ ፄጋዉሱ፤","poem":2},{"lineBreak":true},{"text":"ካታማ ገልያ ፐንገን ኤቃዳ ሀይሳዳ ያጋዉሱ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“ህንተኖ፥ አኬክ ፓጭዳይሳቶ፥","poem":1},{"text":"ህንተ አዉደ ጋካናዉ ኤያ ግድድ ዳኔ?","poem":2},{"text":"ቀልቅሰይሳቶ፥ አዉደ ጋካናዉ ኡፋይታኔ?","poem":1},{"text":"ኤያቶ፥ አዉደ ጋካናዉ ኤራተ እፃኔ?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ታ ሴራ ህንተ ስእዳባ ግድያኮ፥","poem":1},{"text":"ታኒ ታ ኤራ ህንተ ቦላ ጉሳና፤","poem":2},{"lineBreak":true},{"text":"ታ ቃላካ ህንተና ታማርሳና።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ሽን ታ ፄግዳ ዎደ ህንተ ኮዮና እፅዳ ግሾ፤","poem":1},{"text":"ታኒ ኩሸ ምጭን ኦንካ አኬክቦና ግሾ፤","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ታ ዞርያ ህንተ ካዳ ግሾ፤","poem":1},{"text":"ታ ሴራካ ኤክቦና ግሾ፤","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ህንተና መቶይ ጋክያ ዎደ ታ ሚጫና፤","poem":1},{"text":"ህንተ ዳጋማን ኮኮርያ ዎደ ታ ቀልቅሳና።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ጋዶይ ኡሾዳ ህንተ ቦላ ያ ዎደ፥","poem":2},{"lineBreak":true},{"text":"መቶይ ጎተዳ ህንተ ቦላ ኤቅያ ዎደ፥","poem":2},{"lineBreak":true},{"text":"ኡንእነ ዋየይ ህንተ ቦላ ጋክያ ዎደ፥","poem":2},{"lineBreak":true},{"text":"ታኒ ህንተና ቀልቅሳና።","poem":2}]},{"type":"verse","number":28,"content":["“ሄ ዎደ ኤንቲ ታና ፄጋና፤ ሽን ታ ኮይከ፤",{"text":"ኤንቲ ታና ምንድ ኮያና፤ ሽን ደሞኮና።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ኤንቲ ኤራተ እፅዳ ግሾ፤","poem":2},{"lineBreak":true},{"text":"ጎዳ ያሽ ዶርቦና ግሾ፥","poem":2}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"ታ ዞርያ ኤክቦና ግሾ፤","poem":2},{"lineBreak":true},{"text":"ታ ሴራ ካዳ ግሾ፤","poem":2}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"ኤንቲ ባንታ ኦሱዋ አይፍያ ማና፤","poem":2},{"lineBreak":true},{"text":"ባንታ ቆፋ አይፍያ ካላና።","poem":2}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"አኬክ ፓጭዳይሳታ ጭንጫተፈ ሃከይስ ዎስ፤","poem":2},{"lineBreak":true},{"text":"ኤያታ ቀል ጉስ ይሴስ።","poem":2}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"ሽን ታ ኦድያባ ስእያ ኡባይ ሳሮ ዳና፤","poem":2},{"lineBreak":true},{"text":"መቶ ህርጋፈካ ሸምፓና።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}