{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_etw","name":"ሌምሶ ማፃፋ","commonName":"ሌምሶ ማፃፋ","title":"ሌምሶ ማፃፋ","order":20,"numberOfChapters":31,"sha256":"b9b9ecd06cfa4516217d880648cb3322ef1f40bd36b07bdc8a0903d302627723","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_etw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":["ኤራንቾ ናአይ ባ አዋ ሴራ ስኤስ፤ ሽን ቀልቅሰይስ ሴራ ኤከና።"]},{"type":"verse","number":2,"content":["አስ ባ ዶናፐ ከይያ ቃላን ሎኦባ ኤኬስ፤ ሽን አማነቶናይሳት ማካላባ አሞቶሶና።"]},{"type":"verse","number":3,"content":["ባ ዶና ናግያ ኡራይ ባ ሸምፑዋ ናጌስ፤",{"text":"ሽን ኤሶን ሃሳያ ኡራይ ባና ይሴስ።","poem":2}]},{"type":"verse","number":4,"content":["አዛላይ አሞቴስ፤ አሞትኮነ አይባካ ደመና፤ ሽን ምንድ ኦይሳት ካላና።"]},{"type":"verse","number":5,"content":["ፅሎ አሳት ዎርዶ ኦዳ እፆሶና። ሽን ኢታ አሳታ ኦድ ዬላዬስነ ካዉሼስ።"]},{"type":"verse","number":6,"content":["ሱረ ደኡዋ ደእያ ኡራ እያ ፅሎተይ ናጌስ፤ ሽን ናጋራንቾ እያ ናጋራይ ኦንጌስ።"]},{"type":"verse","number":7,"content":["ባና ዱረ ዳንስያ አስ ደኤስ፤ ሽን እያዉ አይብነ ባዋ፤ ቃስ ባና ማንቆ ዳንስያ አስ ደኤስ፤ ሽን እያዉ ዳሮ አቆይ ደኤስ።"]},{"type":"verse","number":8,"content":["አስ ባ ሚሸን ባ ሸምፖ ዎዛናዉ ዳንዳኤስ፤ ሽን ማንቁዋ ያሽስያባይ ባዋ።"]},{"type":"verse","number":9,"content":["ፅሎታ ፖኦይ ጶሌስ፤",{"text":"ሽን ኢታታ ፆምፐይ ቶአና።","poem":2}]},{"type":"verse","number":10,"content":["ኦቶሮይ ኦሽ የሌስ፤ ሽን ዞረ ኤከይሳት ጭንጫታ።"]},{"type":"verse","number":11,"content":["ዳቡር ባይና ደምዳ ሚሸይ ኤሶን ዬስ፤ ሽን ምን ኦድ ደምዳ አቆይ፥ ዳር ዳርድ ቤስ።"]},{"type":"verse","number":12,"content":["ኮይያባይ ፖለቶና ጋምኤይስ አዛንስ፤ ሽን አሞትዳባይ ፖለተይስ ኡፋይሴስ።"]},{"type":"verse","number":13,"content":["ዞረ ካያ ኡራይ መቶን ገሌስ፤ ሽን ኪታ ቦንችያ ኡራይ ሳሮ ደአና።"]},{"type":"verse","number":14,"content":["ጭንጫተ እምያ ትምርተይ ደኦ ፑልቶ፤ ህገይ አሰ ሀይቆ ፅሄፐ ከስ ኤካናዉ ማዴስ።"]},{"type":"verse","number":15,"content":["አኬክ ደእያ ኡራይ ቦንቸቴስ፤ ሽን አማነቶና እፆይ ቆሆስ ጋስ።"]},{"type":"verse","number":16,"content":["ጭንጫ አስ ኡባይ ኤራን ኦስ፤ ሽን ኤይ ባ ኤያተ ቆንጭሴስ።"]},{"type":"verse","number":17,"content":["ኢታ አሳት ኪተትድ፥ መቶን ገሎሶና፤ ሽን አማንያ አሳት ኪተትድ፥ ሳሮተ ኤሆሶና።"]},{"type":"verse","number":18,"content":["ሴራ እፅያ አስ ማንቄስነ ዬላቴስ፤",{"text":"ሽን ሴራ ኤክያ ኡራይ ቦንቸቴስ።","poem":2}]},{"type":"verse","number":19,"content":["አሞትዳባይ ፖለተይስ ዳሮ ኡፋይሴስ፤",{"text":"ሽን ኢታት ኢታባፐ ሃካናዉ ኮዮኮና።","poem":2}]},{"type":"verse","number":20,"content":["ጭንጫ አሳራ ሄመትያ አስ ጭንጫ ግዴስ፤",{"text":"ሽን ኤያ አሳራ ሄመትያ አስ መቶን ገሌስ።","poem":2}]},{"type":"verse","number":21,"content":["ናጋራንቾታ ኢታ ቃዳይ ካሌስ፤",{"text":"ሽን ዱረተ ፅሎታ ዎይቶ።","poem":2}]},{"type":"verse","number":22,"content":["ሎኦ አስ ባ ናይታ ናይታ ላትሴስ፤",{"text":"ሽን ናጋራንቹዋ አቆይ ፅሉዋስ ዳጋየቴስ።","poem":2}]},{"type":"verse","number":23,"content":["ማንቁዋ ጎሻይ ዳሮ ካ አይፈናዉ ዳንዳኤስ፤",{"text":"ሽን ሱረ ፕርዳ ፓጫን ዬስ።","poem":2}]},{"type":"verse","number":24,"content":["ፕርጮን ሴራናዉ ዶሶና አስ ባ ናኣ እፄስ፤",{"text":"ሽን ባ ናኣ ሲቅያ ኡራይ ምንድ ሴሬስ።","poem":2}]},{"type":"verse","number":25,"content":["ፅሎይ፥ ኡሎይ ካላና ጋካናዉ ሜስ፤",{"text":"ሽን ናጋራንቾይ ኡባ ዎደ ኮሻታና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PRO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PRO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PRO/12.json","previousChapterAudioLinks":{},"numberOfVerses":25}