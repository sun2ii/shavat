{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_etw","name":"ሌምሶ ማፃፋ","commonName":"ሌምሶ ማፃፋ","title":"ሌምሶ ማፃፋ","order":20,"numberOfChapters":31,"sha256":"b9b9ecd06cfa4516217d880648cb3322ef1f40bd36b07bdc8a0903d302627723","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_etw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":["ጭንጫ ማጫስ ባ ኬ ኬፃዉሱ፤",{"text":"ሽን ኤያ ማጫስያ ባ ኬ ባ ኩሸን ላላዉሱ።","poem":2}]},{"type":"verse","number":2,"content":["ሱረ ሄመትያ አስ ጎዳ ያዬስ፤",{"text":"ሽን ባ ኦገ ጌላይያ አስ ጎዳ ካስ።","poem":2}]},{"type":"verse","number":3,"content":["ኤያ ኦድ እያ ዞኩዋስ ፃምአ ኤሄስ፤",{"text":"ሽን ጭንጫታ እንፃርሳይ ኤንታ ናጌስ።","poem":2}]},{"type":"verse","number":4,"content":["ቦር ባይና እፅኮ ሻለይ ካይስ ግዴስ፤",{"text":"ሽን ጎሻ ቦር ደእኮ፥ ነ ሻለይ ካን ኩሜስ።","poem":2}]},{"type":"verse","number":5,"content":["አማነትያ ማርክ ኡባ ዎደ ቱማ ኦዴስ፤",{"text":"ሽን ዎርዶ ማርክ ዎርዶ ፃላላ ኦደቴስ።","poem":2}]},{"type":"verse","number":6,"content":["ቀልቅስያ አስ ጭንጫተ ኮዬስ፥ ሽን ደመና፤",{"text":"አኬክ ደእያ አስ ኤራተ ደሞይ ዋይሰና።","poem":2}]},{"type":"verse","number":7,"content":["ኤያ አሳፐ ሃካ፤",{"text":"ኔኒ እያ ኦዳፐ ኤራተ ደማካ።","poem":2}]},{"type":"verse","number":8,"content":["ጭንጫ አስ ጭንጫ ግድያ ባ ኦያባ ኤሬስ፤",{"text":"ሽን ኤያ አሳ ኤያተይ እያ ባለስ።","poem":2}]},{"type":"verse","number":9,"content":["ኤያት ናጋራ ኦሸ፥ ቂሮታናይሳ አግድ ቀልቅሶሶና፤",{"text":"ሽን ሱረት ባንታ ናጋራይ አቶ ጌተታናዉ ኮዮሶና።","poem":2}]},{"type":"verse","number":10,"content":["እስ እስ ዎዛን ባ አዛኑዋ ኤሬስ፤",{"text":"እያ ኡፋይሳ ኦንካ እያራ ኮፀና።","poem":2}]},{"type":"verse","number":11,"content":["ኢታታ ኬይ ላለታና፤",{"text":"ሽን ሱረታ ኬይ ምንድ ዳና።","poem":2}]},{"type":"verse","number":12,"content":["አሳስ ልከ ዳንያ ኦገይ ደኤስ፤",{"text":"ሽን እያ ዉርሰይ ሀይቆኮ ጋስ።","poem":2}]},{"type":"verse","number":13,"content":["ሚቻ ዎደካ ዎዛናን አዛኖይ ደኤስ፤",{"text":"ኡፋይሳ ዉርሰይ አዛኖ ግዳናዉ ዳንዳኤስ።","poem":2}]},{"type":"verse","number":14,"content":["ኢታ አስ ባ ኢታ ኦሱዋ ጋተ ኤካና፤",{"text":"ሎኦ አስካ ባ ሎኦ ኦሱዋ ጋተ ኤካና።","poem":2}]},{"type":"verse","number":15,"content":["ኤያ አስ ኡባባ አማኔስ፤",{"text":"ሽን ጭንጫ አስ አኬክድ ታንጌስ።","poem":2}]},{"type":"verse","number":16,"content":["ጭንጫ አስ ጎዳ ያዬስ፤ ኢታፐ ሃኬስ፤",{"text":"ሽን ኤያ አስ ኤሶተስነ ኢታፐ ናገተና።","poem":2}]},{"type":"verse","number":17,"content":["ኤለ ሀንቀትያ አስ ኤያ ኦሶ ኦስ፤",{"text":"ሽን ጭንጫ አስ ዳንዳአንቾ።","poem":2}]},{"type":"verse","number":18,"content":["አኬክ ባይና አስ ባ ኤያተ ጋትያ ኤኮሶና፤",{"text":"ሽን ጭንጫ አስ ኤራተ ካላቻዳ ጎፆሶና።","poem":2}]},{"type":"verse","number":19,"content":["ኢታት ሎኦታ ስንን ጉልባታና፤",{"text":"ናጋራንቻት ፅሎታ ፐንገን ሆካና።","poem":2}]},{"type":"verse","number":20,"content":["ማንቆይ ባ ሾሩዋን እፀቴስ፤",{"text":"ሽን ዱረታስ ዳሮ ላገት ደኦሶና።","poem":2}]},{"type":"verse","number":21,"content":["ባ ሾሩዋ ካያ አስ ናጋራ ኦስ፤",{"text":"ሽን ማንቁዋ ማድያ አስ አንጀትዳይሳ።","poem":2}]},{"type":"verse","number":22,"content":["ኢታባ ማቀተይሳት ባሎሶና ግዶኮና?",{"text":"ሽን ሎኦባ ኦናዉ ሀልቸይሳት","poem":2},{"lineBreak":true},{"text":"አማነተነ ሲቆ ደሞሶና።","poem":2}]},{"type":"verse","number":23,"content":["ምንድ ኦያ ኦሶ ኡባን ዎይ ደኤስ፤",{"text":"ሽን ጮ ኦድ ማንቆተ ኤሄስ።","poem":2}]},{"type":"verse","number":24,"content":["ጭንጫታስ ኤንታ ዱረተይ ኤንታዉ ካላቻ፤",{"text":"ሽን ኤያት ጉጅ ጉጅ ኤዮሶና።","poem":2}]},{"type":"verse","number":25,"content":["ቱማ ማርክ ሸምፖ አሼስ፤",{"text":"ሽን ዎርዶ ማርክ ባለስ።","poem":2}]},{"type":"verse","number":26,"content":["ጎዳ ያይያ አሳስ ምኖ ሚፃይ ደኤስ፤",{"text":"እያ ናይታስ ባቃትድ አትያ በሲ ደኤስ።","poem":2}]},{"type":"verse","number":27,"content":["ጎዳ ያሽ ደኦ ፑልቶ፤",{"text":"ሀይቆ ፅሄፐ አሰ አሼስ።","poem":2}]},{"type":"verse","number":28,"content":["ካዎ ግታተ እ ሃርያ አሳ ዳሮተና፤",{"text":"ሽን ሃረትያ አስ ይኮ እካ ፓና።","poem":2}]},{"type":"verse","number":29,"content":["ዳንዳአንቾ አሳስ ግታ አኬክ ደኤስ፤",{"text":"ሽን ኤለ ሀንቀትያ አስ ባ ኤያተ ቆንጭሴስ።","poem":2}]},{"type":"verse","number":30,"content":["ሳሮ ዎዛን አሳተስ ፓያተ እሜስ፤",{"text":"ሽን ቃናተይ አሳተስ አጃጀ ሀርገ መላ።","poem":2}]},{"type":"verse","number":31,"content":["ማንቆታ ናቅያ አስ ኤንታ መዳይሳ ጫዬስ፤",{"text":"ሽን መቶታንቾታስ ኬህያ አስ ፆሳ ቦንቼስ።","poem":2}]},{"type":"verse","number":32,"content":["ኢታት ባንታ ኢታ ኦሶን ኩንዳና፤",{"text":"ሽን ፅሎታስ ሀይቆፐ አትያ ሚፅ ደኤስ።","poem":2}]},{"type":"verse","number":33,"content":["አኬካንቾ አሳ ዎዛናን ጭንጫተ ኩምስ፤",{"text":"ሽን ኤያት ጭንጫተ አይበኮ ኤሮኮና።","poem":2}]},{"type":"verse","number":34,"content":["ፅሎተ እስ ካዎተ ቁ ቁ ኦስ፤",{"text":"ሽን ናጋር አይ አስካ ካዉሼስ።","poem":2}]},{"type":"verse","number":35,"content":["ኤራንቾ አይለታን ካዎይ ኡፋይቴስ፤",{"text":"ሽን ዬላያ አይለይ ካዋ ሀንቀስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PRO/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PRO/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PRO/13.json","previousChapterAudioLinks":{},"numberOfVerses":35}