{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_etw","name":"ሌምሶ ማፃፋ","commonName":"ሌምሶ ማፃፋ","title":"ሌምሶ ማፃፋ","order":20,"numberOfChapters":31,"sha256":"b9b9ecd06cfa4516217d880648cb3322ef1f40bd36b07bdc8a0903d302627723","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_etw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":["አስ ባ ዎዛናን ሀልቼስ፤",{"text":"ሽን ልከ ዛሮይ ጎዳፐ በንቴስ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"አስ ኦያ ኦሶ ኡባይ እያዉ ልከ ዳኔስ፤","poem":1},{"text":"ሽን ጎዳይ ደንዶ ቆፋ በኤስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ነ ኦሶ ኡባ ጎዳስ ሀዳራ እማ፤","poem":1},{"text":"ኔኒ ቆፕዳባይ ፖለታና።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ጎዳይ ኡባባይ ቆፕዳይሳ ባና መላ ኦስ፤","poem":1},{"text":"ሀንኮካ፥ ማካላንቾታ ዉርሰይ ዮ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ጎዳይ ኦቶራንቾታ እፄስ፤","poem":1},{"text":"ኤንቲ ሴረቶና አቶኮና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሲቆንነ አማነተን ናጋር አቶ ጌተቴስ፤","poem":1},{"text":"ጎዳስ ያይድ አስ ኢታባፐ አቴስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አሳ ሄመ ጎዳ ኡፋይስያባ ግድኮ፥","poem":1},{"text":"እ ባ ሞርከታራ ሳሮ ዳናዳ ኦስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ፅሎተን በንትያ ጉባይ፥","poem":1},{"text":"ዎርዶን ደምያ ዳሮ ዎፐ ሎኦ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አስ ዎዛናን ባ ኦናባ ሀልቼስ፤","poem":1},{"text":"ሽን ሀልቾይ ጎዳ ማደን ፖለቴስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ካዎይ ፆሳፈ ኤክዳ ማታን ፕርዴስ፤","poem":1},{"text":"እያ እንፃርሳይ ሱረ ፕርዴስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ግና ምዛነትነ ማካ ሚሸት ጎዳባ፤","poem":1},{"text":"ባይዝያባ ኡባን ገነይ ዶና መላ ጎዳይ ኮዬስ።","poem":2}]},{"type":"verse","number":12,"content":["ካዎት ኢታ ኦሶ እፆሶና፤",{"text":"ኤንታ አራታይ ፅሎተን ኤቄስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ካዎት ፅሎ እንፃርሳን ኡፋይቶሶና፤","poem":1},{"text":"ቱማ ሃሳያ ኡራ ዶሶሶና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ካዋ ሀንቆይ ሀይቆ ኪታንቾ መላ፤","poem":1},{"text":"ሽን ጭንጫ አስ ሀንቁዋ እርፅሴስ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ካዋ ሶምኦይ ፖእኮ ደኦይ ደኤስ፤","poem":1},{"text":"እያ ሎኦተይ እራ ኤህያ ሻራ መላ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ጭንጫተ ደሞይ ዎርቃ ደሞፐ አስ፤","poem":1},{"text":"አኬካ ደሞይ ብራ ደሞፐ ሎኦ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሱረታ ኦገይ ኢታፐ ሃኮ፤","poem":1},{"text":"ባ ሄመ ናግያ ኡራይ ባ ሸምፑዋ ናጌስ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ኦቶሮይ ዮ ካለስ፤","poem":1},{"text":"ጬቀተ ኩንደ ኤሄስ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ኦቶራንቾታራ ድኦ ሻከታናፐ፥","poem":1},{"text":"አሽከ ግድድ ማንቅድ ደኤይስ ሎኦ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዞረ ስእያ ኡራስ እ ኦያባ ኡባይ እንጀታና፤","poem":1},{"text":"ጎዳን አማነትያ ኡራይ አንጀታና።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ባ ቆፋን ጭንጫ ግድዳ አስ አኬካንቾ ጌተቴስ፤","poem":1},{"text":"ሎኦ ቃል ኤራተ ጉጄስ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ጭንጫ አሳስ ኤራተ ደኦ ፑልቶ መላ፤","poem":1},{"text":"ሽን ኤያታ ሴሮይ ጮ ዎደ ዉርሴስ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ጭንጫ አስ ኦደታናፐ ስን ቆፔስ፤","poem":1},{"text":"እያ መተርሻይ ኤራተ ጉጄስ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ሎኦ ቃል ኤሳ እልሎዳ ማልኤስ፤","poem":1},{"text":"ሸምፖስ ማልኦ፤ መቀስ ፓፆ ግዴስ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"አሳስ ሱረ ዳንያ ኦገይ ደኤስ፤","poem":1},{"text":"ሽን ዉርሰን ሀይቆኮ ጋስ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"አስ ምንድ ኦና መላ ኦይ ካ አሞ፤","poem":1},{"text":"ኮሽ ምንድ ኦና መላ ደንስ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ካዉሻ አስ ኢታባ ሀልቼስ፤","poem":1},{"text":"እያ ኦዳይ ታማዳ ፁጌስ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ዎበ አስ ኦሽ ደንስ፤","poem":1},{"text":"ዝግርስ አማነትያ ላገታ ሻኬስ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ገነ አስ ባ ሾሩዋ ጭሜስ፤","poem":1},{"text":"ሎኦ ግዶና ኦገ ካለስ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ባ አይፈን ቃምኦትያ አስ ጌላባ ቆፔስ፤","poem":1},{"text":"ባ መተርሻ ሳፅድ ማንድያ አስ ኢታባ ኦስ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ፑሉምዳ ሁጰይ ቦንቾ ካላቻ፤","poem":1},{"text":"ሄስካ በንተይ ፅሎ ደኦ ደእና።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ዎልቃማ አስ ግዳናፐ ዳንዳአ አስ ግዶይ ሎኦ፥","poem":1},{"text":"ዳሮ ካታማታ ኦልድ ኦይካናፐ ባና ሃሮይ አስ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"አስ ሳማ የጌስ፤","poem":1},{"text":"ሽን ዉርሰ ዛሮይ ጎዳፐ በንቴስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PRO/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PRO/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PRO/15.json","previousChapterAudioLinks":{},"numberOfVerses":33}