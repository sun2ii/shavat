{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_etw","name":"ሌምሶ ማፃፋ","commonName":"ሌምሶ ማፃፋ","title":"ሌምሶ ማፃፋ","order":20,"numberOfChapters":31,"sha256":"b9b9ecd06cfa4516217d880648cb3322ef1f40bd36b07bdc8a0903d302627723","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_etw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":["ኦሽ ደእያ በሳን ደእያ ግታ ግብራፐ",{"text":"ሳሮይነ ዎፕ ደእያ በሳን ኡይ ፖቆይ ሎኦ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ጭንጫ አይለይ ፓና ባ ጎዳ ናኣ ሃሬስ፤","poem":1},{"text":"እያ እሻታራ እስፈ ላታ ሻከቴስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዎርቅነ ብር ታማን ፓጨተይሳዳ፤","poem":1},{"text":"ጎዳይ አሳ ዎዛና ፓጬስ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኢታ አስ ኢታ ሃሳያ ስኤስ፤","poem":1},{"text":"ዎርዳንቾይ ዎርዶ ሃሳያ ሀይዜስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ማንቆታ ቦላ ቀልቅስያ አስ ኤንታ መዳ ፆሳ ጫዬስ፤","poem":1},{"text":"ሀራ አስ ጋክያ መቶን ኡፋይትያ አስ ሴረቶና አተና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ናአ ናእ ጭማ አሳስ ካላቻ፤","poem":1},{"text":"አዋት ባንታ ናይታስ ቦንቾ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሎኦ ኦድ ኤያ አሳስ ጊገና፤","poem":1},{"text":"ሄሳዳካ ዎርዶ ኦድ አይሰይሳስ ጊገና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዎፈ እመይሳስ ዎፈይ ብታ መላ፤","poem":1},{"text":"እ ብያ በሳ ኡባይ እያዉ እንጀቴስ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ቆሆ ገንያ ኡራይ ሲቆ ኮዬስ፤","poem":1},{"text":"ሽን ኦዳ ዛሪድ ዛሪድ ዎጭያ ኡራይ፥","poem":2},{"lineBreak":true},{"text":"አማነትያ ላገታ ሻኬስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኤያይ ፄቱ ቶሆ ልሶን ሾጭን ኤረይሳፈ፤","poem":1},{"text":"አኬክ ደእያ አሳስ ጮ ሀንቆይ ኤራ እሜስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኢታ አስ ኡባ ዎደ ጌላ፤","poem":1},{"text":"ቃይ ባይና አስ እያ ቦላ ኪተታና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኤያራ እያ ኤያተን ጋሄታናፐ","poem":1},{"text":"ማራት ኤከትዳ ማሄራ ጋሄተ ሎኦ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሎኦ ኦዳይሳስ ኢታ ኩሸ ዛርያ","poem":1},{"text":"ኡራ ሶፐ ኢታባይ ክቸና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኦሽ ዶምሸ ሃ ዋ መንይሳ መላ፤","poem":1},{"text":"ሄሳ ግሾ ኦሽ ዶማናፐ ኮይሮታዳ ፓላማ አጋ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ናጋራንቹዋ ፅልሶይነ","poem":1},{"text":"ፅሉዋ ቦላ ፕርዶይ፥","poem":2},{"lineBreak":true},{"text":"ናምአይካ ጎዳይ እፅያ ኦሶ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ጭንጫተ ደማናዉ አሞይ ባይና ደእሽን፥","poem":1},{"text":"ኤያ ኩሸን ደእያ ሚሸይ አይ እያ ማዲ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ላገይ ኡባ ዎደካ ላገ፤","poem":1},{"text":"እሽ መቶ ዎደ ማዳናዉ የለቴስ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"አኬክ ባይና አስ ኤሮና ኡራ","poem":1},{"text":"አጩዋ ቃንፃናዉ ዋሰ ግዴስ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ኦሹ ዶስያ አስ ናጋራ ዶሴስ፤","poem":1},{"text":"ኡባ ዎደ ጬቀትያ አስ ባ ቦላ ዮ ፄጌስ።","poem":2}]},{"type":"verse","number":20,"content":["ዎበ ቆፍ ደእያ አስ ሎኦባ ደመና፤",{"text":"ባ እንፃርሳን ጭምያ አስ መቶን ገሌስ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ኤያ ናአ የልዳ አው አዛኔስ፤","poem":1},{"text":"ኤያ ናአ አዋስ ኡፋይስ ዴና።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ኡፋይትያ ዎዛን አሳስ ሎኦ ለ፤","poem":1},{"text":"ሽን መቅዳ ዎዛን አሳስ ዎልቃ ይሴስ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ኢታ አስ ፕርዳ ጌላያናዉ","poem":1},{"text":"ጌማን ዎፈ ኤኬስ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"አኬካ አስ ጭንጫተ ባ ስንፈ ሃሰና፤","poem":1},{"text":"ሽን ኤያ አሳ አይፈይ ሳአ ጋፃ ዩዬስ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ኤያ ናእ ባ አዋ አዛንስ፤","poem":1},{"text":"ባ አይዉካ ጫምሴስ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ፅሎ አስ ሴሮይ በሰና፤","poem":1},{"text":"ሱረ አስ ሾጮይ ሎኦ ግደና።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ጉ ቃላ ሃሳያ አስ ኤራንቾ፤","poem":1},{"text":"ዎፓ አያን ደእያ አስ አኬካንቾ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ኤያ አስ ስእ ጊኮ ጭንጫ ዳኔስ፤","poem":1},{"text":"ባ ዶና ዶዮና እፅኮ ኤራንቾ ዳኔስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PRO/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PRO/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PRO/16.json","previousChapterAudioLinks":{},"numberOfVerses":28}