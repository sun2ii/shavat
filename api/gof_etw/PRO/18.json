"poem":1},{"text":"ይስያ አሳፐ አይባካ ዱማተና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ጎዳ ሱንይ ምኖ ግምበ መላ፤","poem":1},{"text":"ፅሎ አስ ያ ዎፅድ ሳሮ አቴስ።","poem":2}]},{"type":"verse","number":11,"content":["ዱረ አሳታ ዱረተይ ግምበትዳ ካታማ መላ፤",{"text":"ኤንታ ቆፋን ኤንታ ዱረተይ","poem":2},{"lineBreak":true},{"text":"ምኖ ድርሳዳ ኤንታ ናግያባ ዳኔስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኦቶሮይ ኩንደፈ ስንቴስ፤","poem":1},{"text":"አሽከተ ቦንቾ ኤሄስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ስኦና ደእሸ ዛሮ እሞይ፥","poem":1},{"text":"ሄ ኡራስ ኤያተነ ዬላ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዳና ግድ ቆፕኮ፥ እያ አያናይ ሀርገ ዳንዳእሴስ፤","poem":1},{"text":"ሽን ኡፋይስ ቃንፅኮ እያ ማደይ ባዋ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አኬካ አስ ኤራተ ኮዬስ፤","poem":1},{"text":"ጭንጫ አሳ ሀይ ጭንጫተ ስኤስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እሞት እመይሳስ ኦገ ዶዬስ፤","poem":1},{"text":"ግታ አሳታራ ኤርሴስ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዳይና ስንን ኮይሮ ሺቅድ ሞትያ ኡራይ፥","poem":1},{"text":"እያ ሞርከይ ይን፥ እያ ኦይቻና ጋካናዉ፥","poem":2},{"lineBreak":true},{"text":"ኡባ ዎደ ባና ፅሎ ግድ ቆፔስ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሳማ የገ ፓላማ ተቄስ፤","poem":1},{"text":"ናምኡ ፓላምያ አሳታ ሻኬስ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ቆሄትዳ እሻይ ግምበትዳ","poem":1},{"text":"ካታማፐ አድ ምኔስ፤","poem":2},{"lineBreak":true},{"text":"እያ ፓላማይ ብራታ ጎርደ መላ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አስ ባ ዶና ኦዳን ባ ኡሎ ኩንስ፤","poem":1},{"text":"ባ እንፃርሳ አይፈን ካሌስ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሀይቆይነ ደኦይ እንፃርሳና፤","poem":1},{"text":"ኔኒ ነ እንፃርሳ አይፍያ ማና።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ማቾ ደምዳይ ሎኦባ ደምስ፤","poem":1},{"text":"እ፥ ጎዳፐ ቴማ ደሜስ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ማንቆ አስ አዳሽድ ኦደቴስ፤","poem":1},{"text":"ሽን ዱረ አስ ኦቶሮን ዛሬስ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዳሮ ላገይ ደእያ አስ ባ ቦላ መቶ ኤሄስ፤","poem":1},{"text":"ሽን እሻፐ አድ ማታትያ ላገይ 