ype":"verse","number":9,"content":[{"text":"ዎርዶ ማርክ ሴረቶና አተና፤","poem":1},{"text":"ዎርዶ ኦደተይ ያና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኤያ አሳስ እንጀ ደኦይ በሰና፤","poem":1},{"text":"አይለይ ሀላቃታ ሃሮይ ዳሮ ኢታ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጭንጫተ አሰ ዳንዳአ ታማርሴስ፤","poem":1},{"text":"ቆሆ ካድ አ ቦንችሴስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ካዋ ሀንቆይ ጋሞ ጉደ መላ፤","poem":1},{"text":"ሽን እያ ናሾይ ማታ አጭስያ አካ መላ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኤያ ናእ ባ አዋ ይሴስ፤","poem":1},{"text":"ዶናማ ማቻ ፆክያ ኬ መላ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አስ ኬነ ሻሎ አዉፐ ላቴስ፤","poem":1},{"text":"ሽን አኬካ ማቾ ጎዳይ እሜስ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አዛላተ ስኮ ኤሄስ፤","poem":1},{"text":"ኦሶ ኦና አስ ኮሻቴስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኪታ ናግያ አስ ባ ሸምፑዋ ናጌስ፤","poem":1},{"text":"ሽን ቀል ግያ አስ ሀይቄስ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ማንቆስ ኬህያ አስ ጎዳስ ታልኤስ፤","poem":1},{"text":"ጎዳይ ሄ ሎኦ ኦሱዋ ግሾ ዎይቴስ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ስሞ ኡፋይስ ደእሽን ነ ናይታ ሴራ፤","poem":1},{"text":"ሴሮና እፅኮ፥ ነ ኤንታ ይሳሳ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ኤለ ሸነትያ አስ ባ ጋትያ ኤካናዉ በሴስ፤","poem":1},{"text":"ኔኒ እያ እስ ቶሆ አሽያባ ግድኮ፥","poem":2},{"lineBreak":true},{"text":"ሀራ ዎደካ ነ እያ ሄሳዳ አሻናይስ አተና።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዞረ ስአ፤ ታማራናዉ ኮያ፤","poem":1},{"text":"ኔኒ ዉርሰ ጋካናዉ ጭንጫ ግዳና።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አስ ዳሮባ ሀልቼስ፤","poem":1},{"text":"ሽን ጎዳይ ግዳባይ ፖለቴስ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"አሳፐ ኮየተይ አማነተ፤","poem":1},{"text":"ዎርዶ ግዳናፐ ማንቆ ግደይስ ሎኦ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ጎዳስ ያሽ ደኦኮ ካለስ፤","poem":1},{"text":"እያ ያይያ አስ ካልድ ደኤስ፤ ኢት እያ ቦቸና።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"እስ እስ አስ ዳሮ አዛላ፤","poem":1},{"text":"ሀር አቶሽን ዎፀን ቱሽክዳ","poem":2},{"lineBreak":true},{"text":"ኡይ ፑደ ባራናዉ ዋየቴስ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ኔኒ ቀልቅስያ አስ ሾጭኮ፥","poem":1},{"text":"አኬክ ፓጭዳይስ ጭንጫተ ታማራና፤","poem":2},{"lineBreak":true},{"text":"አኬካ አስ ነ ሀንቀትኮ፥ እ ኤራተ ደማና።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ባ አዋ ቦንቅያ ናአይ፥","poem":1},{"text":"ባ አይዉ የደያ ናአይ፥","poem":2},{"lineBreak":true},{"text":"ዬላነ ካዉሻተ ኤህያ ናአ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ታ ናአዉ፥ ነ ዞረ ስኦና እፅኮ፥","poem":1},{"text":"ኤራ ኦግያፐ ሃካሳ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ዎርዶ ማርክ ሱረ ፕርዳ ቦላ ቀልቅሴስ፤","poem":1},{"text":"ኢታ አሳ ዶን ኢታተ ምቴስ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ቀልቅስያ አሳስ ፕርዳ","poem":1},{"text":"ኤያታስ ዋ ኮሼስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PRO/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PRO/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PRO/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}