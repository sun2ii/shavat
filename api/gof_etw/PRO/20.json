9,"content":[{"text":"“ታ ዎዛናይ ጌሽ፤ ታናን ናጋር ባዋ”","poem":1},{"text":"ጋናዉ ዳንዳእያ አስ ዳነሻ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ጎዳይ ዎርዶ ምዛነነ","poem":1},{"text":"ግና ግዶና ማካ ሚሸን ጎኤተይሳታ እፄስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ናእ ጌሽነ ሱረ ግደይስ","poem":1},{"text":"እ ኦያ ኦሶን ኤረቴስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ስእያ ሀይነ ፄልያ አይፈ፥","poem":1},{"text":"ጎዳይ መስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ስኮን ነ ዎደ ዉርስኮ ነ ማንቃና፤","poem":1},{"text":"ምናዳ ኦኮ ነ ካ ካላና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሻምያ አስ፥ “ቆሄስ! ቆሄስ!” ያጌስ፤","poem":1},{"text":"ሽን ብዳፐ ጉየ፥ “ገላን ሻማስ” ያግድ ጬቀቴስ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዎርቀይ ኩምስ፤ አልኦ ሹችካ በንቴስ፤","poem":1},{"text":"ሽን ኤር ኩምዳ እንፃርስ ኡባፈ አዳ አሌቆ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኤሮና አሳስ ዋሰ ገልያ ኡራ ማኡዋ ቃር ኤክተ፤","poem":1},{"text":"እማ አሳስ ዋሰ ገልያ ኡራ ማኦ ኦይክተ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዎርዶን ደምዳ ካ ማልኤስ፤","poem":1},{"text":"ሽን አቅድ ፔእሸ ዶናን አጨዳ ሀኔስ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዞረ ኤካዳ ነ ቆፋ ቃቻ፤","poem":1},{"text":"ዞረ ኤኮና ደአሸ ኦላ ቦፓ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዝግርያ አስ ፁራ ገንና፤","poem":1},{"text":"ሄሳ ግሾ ጮ ሃሳያ አሳፐ ሃካ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ባ አዋ ዎይኮ ባ አይዉ ባድያ አሳ፥","poem":1},{"text":"ደኦ ፆምፐይ ሳካና ማን ቶአና።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ኮይሮራ ኤሶን ሺቅዳ ሻሎይ","poem":1},{"text":"ዉርሰን አንጀተና።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ነና ቆህዳ ኡራ ቆሀዳ ዛራና ጎፓ፤","poem":1},{"text":"ጎዳን አማነታ፤ እ ነና አሻና።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ጎዳይ ናምኡ ቆሞ ምዛነ እፄስ፤","poem":1},{"text":"ዎርዶ ምዛነይ እያ ኡፋይሰና።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"አሳይ ባና ኦግያ ጎዳይ ካለስ፤","poem":1},{"text":"ያትን፥ አስ ባ ደኦን ባና ኦግያ","poem":2},{"lineBreak":true},{"text":"ዋትድ አኬካናዉ ዳንዳኢ?","poem":2}]},{"type":"verse","number":25,"content":["ኤሶን፥ “ሀይሳ ታኒ ፆሳስ እማስ” ጉስነ",{"text":"ጉየፐ ቂሮተ አሳስ ፅሄ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ጭንጫ ካዎይ ጌላታ ሻክድ ኤሬስ፤","poem":1},{"text":"እ ኤንታ ቃቶና ሴሬስ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"አሳ አያን ጎዳስ ፆምፐ፤","poem":1},{"text":"እያ ጋ አሳተ ኡባ ፕልግድ ፄሌስ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ሲቆይነ አማነተ ካዋ ናጎሶና፤","poem":1},{"text":"እያ አራታይ ቱማ ፕርዳን ምኔስ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ያላጋታ ቦንቾይ ኤንታ ዎልቃ፤","poem":1},{"text":"ጭማታ ቦንቾይ ኤንታ ፑሉን።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ምኖ ሴር ኢታተ ሾዴስ፤","poem":1},{"text":"ዋይ ኢታ ዎዛና ላሜስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PRO/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PRO/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PRO/19.json","previousChapterAudioLinks":{},"numberOfVerses":30}