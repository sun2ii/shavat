[{"text":"ዶናትያ ማችራ እስ ኬን ዳናፐ","poem":1},{"text":"ካረ ዳርማቻን ዱስ ሎኦ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኢታት ኢታባ ኦናዉ አሞቶሶና፤","poem":1},{"text":"ባንታ ሾሮታስ ቃቶኮና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ቀልቅስያ አስ ሴረትያ ዎደ","poem":1},{"text":"ዎዛን ባይና ኡራይ ጭንጫተ ታማሬስ፤","poem":2},{"lineBreak":true},{"text":"ዎዛናማ ኡራይ ኤራ ደሜስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ፅሎ ፆሳይ ኢታታ ሶን ኦሰትያባ ኡባ በኤስ፤","poem":1},{"text":"ኤንታ ሽር የግድ ይሴስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ማንቆታ ዋሱዋ ስአናፐ ግድ፥","poem":1},{"text":"ባ ሀይ ቱጭያ ኡራይ፥ እካ ዋሳና፤","poem":2},{"lineBreak":true},{"text":"እ ዋስን አልያ አስ ያና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ጌማን እምያ እሞይ ሀንቆ ዶሽሴስ፤","poem":1},{"text":"ቆሳን እምዳ ዎፈይ ሀንቆ እርፅሴስ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሱረ ፕርድ ፕርደትያ ዎደ፥","poem":1},{"text":"ፅሎት ኡፋይቶሶና፤","poem":2},{"lineBreak":true},{"text":"ሽን ኢታ ኦይሳታ ዳጋንስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አኬካ ኦግያ ሃክያ ኡራ","poem":1},{"text":"ሀይቆይ ናጌስ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እንጀትን ዳና ግያ ኡራይ ማንቄስ፤","poem":1},{"text":"ዎይነነ ዛይተ ዶስያ ኡራይ ዱረተና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ፆሳ አሳታ አሻናዉ ኢታ አሳት ሴረቶሶና፤","poem":1},{"text":"አማነቶና አሳት ሱረ አሳታ ግሾ ሴረቶሶና።","poem":2}]},{"type":"verse","number":19,"content":["ዶናትያነ ይሎትያ ማችራ ዳናፐ",{"text":"ባዞን ደኦይ ሎኦ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዎዛናማ ኡራ ሶን ማልኦ ቁምነ ኦይስ ምንጀቴስ፤","poem":1},{"text":"ሽን ኤያ አስ ደእያባ ኡባ ምድጌስ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ፅሎተነ ሲቆ ኮይያ ኡራ ላይይ አዱቄስ፤","poem":1},{"text":"ሄ ኡራይ ፅሎተነ ቦንቾ ደሜስ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዎዛናማ አስ ዎልቃማ ኦላንቾታ ካታማ ኦልድ ኦይኬስ፤","poem":1},{"text":"ኤንቲ አማነትያ ምኖ ሚፃ ላሌስ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ባ ዶናነ ባ እንፃርሳ","poem":1},{"text":"ናግያ አስ ባና መቶፐ ናጌስ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ኦቶረይነ ጬቀተይ ቀልቅስያ አስ፤","poem":1},{"text":"እ ኦቶራንቾ ግድዳ ግሾ አሳስ ቆፐና።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ኦናዉ ኮዮና ግሾ","poem":1},{"text":"አዛላ አሞይ ዎስ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"አዛላ አስ ኡባ ዎደ ዳሮባ ደማናዉ አሞቴስ፤","poem":1},{"text":"ሽን ፅሎይ ባዉ አሾና እሜስ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ጎዳይ ኢታታ ያርሹዋ እፄስ፤","poem":1},{"text":"ኤንቲ እያዉ ኢታ ቆፋን ሺሽያ ያርሹዋ አድ እፄስ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ዎርዶ ማርክ ያና፤","poem":1},{"text":"ሽን ቱማ ማርክ ኤቅድ ዳና።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ኢታ አስ በሶና ፃላ ፃሌስ፤","poem":1},{"text":"ሽን ሱረ አስ ዩሽ ቆፔስ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"አስ ባ ጭንጫተን፥ አኬካንነ ዞረን","poem":1},{"text":"ጎዳራ ኤቀታናዉ ዳንዳኤና።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ኦላስ ፓራ ኮራናዉ ዳንዳኤቴስ፤","poem":1},{"text":"ሽን ፆኖይ ጎዳባ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PRO/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PRO/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PRO/20.json","previousChapterAudioLinks":{},"numberOfVerses":31}