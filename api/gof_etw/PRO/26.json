{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_etw","name":"ሌምሶ ማፃፋ","commonName":"ሌምሶ ማፃፋ","title":"ሌምሶ ማፃፋ","order":20,"numberOfChapters":31,"sha256":"b9b9ecd06cfa4516217d880648cb3322ef1f40bd36b07bdc8a0903d302627723","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_etw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":["ቦነ ሻች፥ ካ ጫክያ ዎደ እር ኮሾናይሳዳ፥",{"text":"ኤያስ ቦንቾ ኮሸና።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ካፎት ያነ ሃነ ፕራሸ አሰ ቆሆናይሳዳ፥","poem":1},{"text":"ጋሶይ ባይና ባድያ ባደ አሰ ጋከና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ፓራስ ልሶ፥ ሀረስ ብፃላ ኮሸይሳዳ","poem":1},{"text":"ኤያ አሳ ዞኮስ ፃምአ ኮሼስ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኤያ አሳስ እያ ኤያተዳ ዛሮፓ፤","poem":1},{"text":"ዛርኮ ነ እያ መላ ግዳና።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኤያ አሳስ እያ ኤያተ ቆንጭሳዳ ዛራ፤","poem":1},{"text":"ሄስ ሀኖና እፅኮ እ ባና ጭንጫ ግድ ቆፓና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኤያ አሳ ቦላ ኪታ የዶይ፥","poem":1},{"text":"ባ ቶሆ ቃንፅ የገይሳ መላ","poem":2},{"lineBreak":true},{"text":"ዎይኮ ዎያባ ኡየይሳ መላ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኤያ አሳ ሌምሶይ፥","poem":1},{"text":"ስልዳ ቶሆ መላ ማደና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኤያ አሳስ ቦንቾ እሞይ፥","poem":1},{"text":"ሹቹ ያምባርሻን ቃች ዎድ","poem":2},{"lineBreak":true},{"text":"ያምባራናዉ ፓጭያ አሳ መላ።","poem":2}]},{"type":"verse","number":9,"content":["ኤያ አሳ ሌምሶይ",{"text":"ማትዳ አስ ባ ኩሸ ጫድዳ አጉን","poem":2},{"lineBreak":true},{"text":"ከሳናዉ ባፀተይሳ መላ።","poem":2}]},{"type":"verse","number":10,"content":["ኤያ አሳ ዎይኮ ባ ኦገ ብያ አስ",{"text":"ኡነ ኦስሳናዉ ቃፃርያ አስ","poem":2},{"lineBreak":true},{"text":"ባ ቶራ ሻራን ፆንግያ አሳ መላ።","poem":2}]},{"type":"verse","number":11,"content":["ካን ባ ጮሻኮ ጉየ ስሚድ ላጨይሳዳ፥",{"text":"ኤያ አስ ባ ኤያተ ዛር ዛር ቆንጭሴስ።","poem":2}]},{"type":"verse","number":12,"content":["ባና ጭንጫ ኦድ ፄልያ አሳፐ",{"text":"ኤያ አሳስ ሎኦ ቃድ ደኤስ።","poem":2}]},{"type":"verse","number":13,"content":["“አዛላ አስ ኦገን ጋሞይ ደኤስ፤",{"text":"ያሽያ ጋሞይ ኦገን ዩዬስ” ያጌስ።","poem":2}]},{"type":"verse","number":14,"content":["ሳንቅ ማፃፈ ቦላ ያነ ሃነ ቃፀይሳዳ፥",{"text":"አዛላ አስ ባ ሂፃን ያነ ሃነ ሽረቴስ።","poem":2}]},{"type":"verse","number":15,"content":["እስ እስ አዛላ አስ ሀር አቶሽን፥",{"text":"ዎፀን ቱሽድ ባራናዉ ዋየቴስ።","poem":2}]},{"type":"verse","number":16,"content":["አዛላ አስ ማርካራ ኦድያ ላፑን ጭንጫታፐ",{"text":"ባና አዳ ጭንጫ ግድ ቆፔስ።","poem":2}]},{"type":"verse","number":17,"content":["ባና ጋያባይ ባይናባን ፓላምያ አስ",{"text":"ኦገራ ብያ ካና ሀይ ኦይክያ አሳ መላ።","poem":2}]},{"type":"verse","number":18,"content":["ባ ሾሩዋ፥ “ታኒ ካሰ ጋይስ”",{"text":"ያግድ ጭምያ አስ፥","poem":2},{"lineBreak":true},{"text":"ጎይድ ቦንቆ ታማ ሆልያ፥","poem":2},{"lineBreak":true},{"text":"ዎይኮ ዎያ ዶንገ ቶራ ዱክያ አሳ መላ።","poem":2}]},{"type":"verse","number":20,"content":["ም ዉርኮ ታም ቶኤስ፤",{"text":"ዝግርስ ይኮ ኦሽ አቴስ።","poem":2}]},{"type":"verse","number":21,"content":["ፂፍ ቦንቆ ዳርሰይሳዳነ",{"text":"ም ታማ ዳርሰይሳዳ","poem":2},{"lineBreak":true},{"text":"ፓላማ ዳርስያ አስ ኦሹ ዳርሴስ።","poem":2}]},{"type":"verse","number":22,"content":["ዝግርሳ ቃል ማልኦ ካ መላ",{"text":"ኡፋይስሸ ዱገ ጋንጀ ቤስ።","poem":2}]},{"type":"verse","number":23,"content":["ዎዛናን ኢታባይ ደእሽን፥",{"text":"ባ እንፃርሳን ጭሞ ቃላ ሃሳያ አስ","poem":2},{"lineBreak":true},{"text":"ብራን ላንፀትዳ ኡርቃ ሚሸ መላ።","poem":2}]},{"type":"verse","number":24,"content":["ገነ አስ ባ ዎዛናን ደእያ ኢታተ",{"text":"ባ እንፃርሳን ገንስ።","poem":2}]},{"type":"verse","number":25,"content":["እያ ዎዛናን ላፑን ቱናት ኩምዳ ግሾ፥",{"text":"እ ሎኦ ቃላ ሃሳይኮካ እያ አማኖፓ።","poem":2}]},{"type":"verse","number":26,"content":["ባ ሞርከተ እ ገንኮካ፥",{"text":"እ ኦያ ኢታይ ዳባባን ቆንጫና።","poem":2}]},{"type":"verse","number":27,"content":["ሀራታስ ኦላ ቦክያ አስ ሄ ኦላን ባዉ ኩንዳና፤",{"text":"ሀራታ ቦላ ሹቹ ጎንዶርስያ አሳ ቦላ","poem":2},{"lineBreak":true},{"text":"ሄ ሹቻይ ስሚድ ጎንዶረታና።","poem":2}]},{"type":"verse","number":28,"content":["ዎርዶትያ እንፃርስ ባ ቆህዳ አሳታ እፄስ፤",{"text":"ጭሞ ኦድ ኩንደ ካለስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PRO/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PRO/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PRO/25.json","previousChapterAudioLinks":{},"numberOfVerses":27}