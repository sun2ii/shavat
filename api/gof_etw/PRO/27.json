{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_etw","name":"ሌምሶ ማፃፋ","commonName":"ሌምሶ ማፃፋ","title":"ሌምሶ ማፃፋ","order":20,"numberOfChapters":31,"sha256":"b9b9ecd06cfa4516217d880648cb3322ef1f40bd36b07bdc8a0903d302627723","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_etw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":["ዎንቶይ ኤሀናባ ነ ኤሮና ግሾ",{"text":"ዎንቶባን ጬቀቶፋ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሀራ አስ ነና ጋላቶፐ አትሽን ኔኒ ነና ጋላቶፓ፤","poem":1},{"text":"አስ ነ ግሾ ማርካቶፈ አትሽን፥ ኔኒ ነ ኬሀተባ ኦዶፓ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሹች ግታ ቶሆ፤ ሻፈይ ዴፆ፤","poem":1},{"text":"ሽን ኤያ አስ መያ ኦሽ","poem":2},{"lineBreak":true},{"text":"ናምኣፈካ ዴፄስ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሀንቆስ ቃይ ባዋ፤","poem":1},{"text":"ይሎይ ይስያ ድኦ መላ፤","poem":2},{"lineBreak":true},{"text":"ሽን ቃናተይ ኡባፈ ኢታ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ጌምዳ ሲቆፐ","poem":1},{"text":"ባልያ ዎደ ቆንጨን ሀንቀተ ሎኦ።","poem":2}]},{"type":"verse","number":6,"content":["ሞርከይ ነና ታሙ ቶሆ ዬራናፐ",{"text":"ሲቆይ ነና ማዱንፅሰይስ ሎኦ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ካልዳ አስ እልሎ ኤስ ሻቴስ፤","poem":1},{"text":"ሽን ኮሻትዳ ኡራ ጫምያባይ ማልኤስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ባ ሶ አግድ ዩይያ አስ፥","poem":1},{"text":"ባ ኬ አጋዳ ፓልያ ካፎ መላ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሽቶይነ ሳውያ እፃነይ አሰ ኡፋይሰይሳዳ","poem":1},{"text":"ሲቆ ላገ ዞረይ ሄሳዳ ኡፋይሴስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ነ ላገታነ ነ አዋ ላገታ አጎፋ፤","poem":1},{"text":"ነ መቶትዳ ዎደ ነ እሻ ሶ ቦፓ፤","poem":2},{"lineBreak":true},{"text":"ሃሆን ደእያ እሻፐ ማታን ደእያ ሾሮይ ሎኦ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታ ናአዉ፥ ጭንጫ ግዳ፤ ታና ኡፋይሳ፤","poem":1},{"text":"ታና ካያ አሳስ ታ ዛሮ እማና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ጭንጫ አስ መቶይ ያ ዎደ በእድ ቆሰቴስ፤","poem":1},{"text":"ሽን አኬክ ባይና አስ ብድ መቶን ገሌስ፤","poem":2},{"lineBreak":true},{"text":"ያትድ ጉየፐ ቂሮቴስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኤሮና አሳስ ዋሰ ገልያ ኡራ ማኡዋ ቃር ኤክተ፤","poem":1},{"text":"እማ አሳስ ዋሰ ገልዳ ኡራ ማኡዋ ኦይክተ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዎንታ ጉራ ባ ቃላ ቁ ኦድ፥","poem":1},{"text":"ባ ሾሩዋ ሳሮተይ እያ ባድያ አሳ መላ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዶናትያ ማቻነ","poem":1},{"text":"አያ ኬ እስኖ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ጫርኮ ተቃናዉ፥ ዛይተ ኩጭድ ኦይካናዉ ዳንዳኤቶናይሳዳ፥","poem":1},{"text":"እዮ ስእ ኦናዉ ዳንዳኤተና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ብራት ብራታ ፖሸይሳዳ፥","poem":1},{"text":"አስ እሶይ እሱዋፈ ታማሬስ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ባላሰ ም ሎይድ ናግያ አስ እያ አይፈ ማና፤","poem":1},{"text":"ባ ሀላቃ ካቦያ ኦሳንቾይ ቦንቸታና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሃ ማስቶተዳ ሶምኦ በሰይሳዳ፥","poem":1},{"text":"አሳ ዎዛን እያ ኦናተ በሴስ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ሀይቆይነ ዱፎይ ካል ኤሮናይሳዳ፥","poem":1},{"text":"አሳ አይፈይ ካልድ ኤረና።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ብርነ ዎርቀይ ታማን ፓጨትድ ጌየይሳዳ፥","poem":1},{"text":"አስ ባ ኤክያ ጋላታን ፓጨቴስ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ካ ኡዱላን ጫደይሳዳ፥","poem":1},{"text":"ኤያ አስ ኡዱላን ጫድያኮካ","poem":2},{"lineBreak":true},{"text":"እያፐ ኤያተይ ክቸና።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ነ ዶርሳታ ሀኖታ ሎይዳ ኤራ፤","poem":1},{"text":"ነ ዉድያካ አኬካዳ ሄማ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"አይስ ጊኮ፥ ዱረተ መርናዉ ዴና፤","poem":1},{"text":"ካላችካ የለተፈ የለተስ አና።","poem":2}]},{"type":"verse","number":25,"content":["መላ ማታይ ቡጨትን፥ አጫ ማት ከያ ዎደ፥",{"text":"ደርያ ቦላ ደእያ ማታይ ሺቅዳፐ ጉየ፥","poem":2}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ዶርሳታ እክሰፐ ነ ነዉ ማኦ ከሳና፤","poem":2},{"lineBreak":true},{"text":"ዴሻታ ባይዛዳ ጋደ ሻማና።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"አትዳ ዴሻታ ማይ ነዉ፥","poem":1},{"text":"ነ ሶ አሳስነ ነ ማጫ አይለታስ ካ ግዳና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PRO/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PRO/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PRO/26.json","previousChapterAudioLinks":{},"numberOfVerses":27}