{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_etw","name":"ሌምሶ ማፃፋ","commonName":"ሌምሶ ማፃፋ","title":"ሌምሶ ማፃፋ","order":20,"numberOfChapters":31,"sha256":"b9b9ecd06cfa4516217d880648cb3322ef1f40bd36b07bdc8a0903d302627723","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_etw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":["ኢታት ኦንካ የደና ባቃቶሶና፤",{"text":"ሽን ፅሎት ጋሞ መላ ያዮና ደኦሶና።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እስ ካዎተይ ማካልኮ፥ ሃረይሳት ዳሮሶና፤","poem":1},{"text":"ሽን ካለይስ ጭንጫነ አኬካንቾ ግድኮ፥","poem":2},{"lineBreak":true},{"text":"ሳሮተነ ዎፕ ደኤስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ማንቆታ ኡንኤያ ካዎይ","poem":1},{"text":"ካ ይስያ ዎልቃማ እራ መላ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ህገ ቦንቾና አስ ኢታ አሳ ሳቤስ፤","poem":1},{"text":"ሽን ህገ ቦንችያ አስ ኢታ አሳ እፄስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኢታ አሳታስ ሱረ ፕርድ ገለና፤","poem":1},{"text":"ሽን ጎዳ ጎይንያ አስ ኡባ አኬከስ።","poem":2}]},{"type":"verse","number":6,"content":["ዱረ ግድድ ጭምያ አስ ግዳናፐ፥",{"text":"ማንቆ ግድድ ሱረ ግደይስ ሎኦ።","poem":2}]},{"type":"verse","number":7,"content":["ህገ ናግያ ናአይ አኬካ ናአ፤",{"text":"ሽን ፓና አሳራ ሄመተይ ባ አዋ ዬላዬስ።","poem":2}]},{"type":"verse","number":8,"content":["ምሸ የሎን ታልኤይነ አሰ ቦንቅድ ዱረትያ አስ",{"text":"ሄ አቁዋ ማንቆታስ ኬህያ አሳስ ሺሼስ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ህገ ስአናፐ ግድ ባ ሀይ ቱጭያ፥","poem":1},{"text":"ኡራ ዎሳይ ጎዳ ስንን እፀትዳባ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሱረታ ኢታ ኦገን ካለያ ኡራይ","poem":1},{"text":"ባ ቦክዳ ኦላን ኩንዳና፤","poem":2},{"lineBreak":true},{"text":"ሽን ጌሻት ሎኦባ ላታና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዱረ አስ ባና ጭንጫ ግድ ቆፔስ፤","poem":1},{"text":"ሽን አኬክ ደእያ ማንቆይ እያ ፓጬስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ፅሎት ፆንያ ዎደ አሳ ኡባይ ኡፋይቴስ፤","poem":1},{"text":"ሽን ኢታት ማታ ኦይክያ ዎደ አሳይ ቆሰቴስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ባ ናጋራ ገንያ አስ አጨና፤","poem":1},{"text":"ሽን ፓፀይነ ናጋራ አገይ ማሮታ ኤካና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ጎዳ ኡባ ዎደ ያይያ አስ አንጀትዳይሳ፤","poem":1},{"text":"ሽን ባ ዎዛና ምንያ አስ መቶን ገላና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ማንቆ አሳ ሃርያ ኢታ ሀላቃይ፥","poem":1},{"text":"ጉድያ ጋሞነ ኮሻትዳ ባባን መላ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አኬክ ባይና ካዎይ ባ ደርያ ቆሄስ፤","poem":1},{"text":"ሽን አሰ ቆሆና ሀላቅ ዳሮ ላይ ሃራና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አሰ ዎያ አስ ሀይቃና ጋካናዉ ባቃትሸ ደኤስ፤","poem":1},{"text":"እያ ኦንካ ማደና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ቦረይ ባይና ሄመትያ አስ ቆሄተና፤","poem":1},{"text":"ሽን ጌላ አስ አኬኮና ኩንዳና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ምንድ ኦያ አስ ካ ካሌስ፤","poem":1},{"text":"ሽን ፓና አሞ ካልያ አስ ማንቆተ ላታና።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"አማነትያ ኡራይ ዳሮ አንጀታና፤","poem":1},{"text":"ሽን ዱረታናዉ ዎፅያ አስ መቶ በአና።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሶምኦ በእድ ፕርዶይ ሎኦ ግደና፤","poem":1},{"text":"ሽን አስ ባሶ ኡይ ግሾ ግድ ቆሄስ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ያረ አስ ዱረታናዉ ባቀቴስ፤","poem":1},{"text":"ማንቆተ አኬኮና ኦይካናይሳ ኤረና።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"አሰ ጮ ሳቢያ አሳፐ","poem":1},{"text":"ሀንቀትያ አስ ጉየፐ ጋላተቴስ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ባ አዋነ ባ አይዉ ካይሶትድ፥ “ናጋራ ኦብከ”","poem":1},{"text":"ግያ አስነ ደምዳባ ይስያ አስ እስኖ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ኡዘ አስ ኦሽ ደንስ፤","poem":1},{"text":"ሽን ጎዳን አማነትያ አስ ካሌስ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ባናን አማነትያ አስ ኤያ፤","poem":1},{"text":"ሽን ጭንጫተን ሄመተያ አስ ሳሮ ደኤስ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ማንቆስ እምያ አስ መቶተና፤","poem":1},{"text":"ሽን ኤንታ በአናፐ ግድ ቅልምኤይ ባደታና።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ኢታ አሳት ሹመትያ ዎደ አሳይ ቆሰቴስ፤","poem":1},{"text":"ሽን ኤንቲ ይያ ዎደ ፅሎት ዳሮሶና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PRO/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PRO/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PRO/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}