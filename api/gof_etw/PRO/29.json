{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_etw","name":"ሌምሶ ማፃፋ","commonName":"ሌምሶ ማፃፋ","title":"ሌምሶ ማፃፋ","order":20,"numberOfChapters":31,"sha256":"b9b9ecd06cfa4516217d880648cb3322ef1f40bd36b07bdc8a0903d302627723","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_etw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":["ዳሮ ዎደ ሴረትድ ስሞና አስ",{"text":"ሀሳዮና መቃና፤","poem":2},{"lineBreak":true},{"text":"ሄ ኡራስ ፓፆይ ባዋ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ፅሎ አሳት ሹመትያ ዎደ አሳይ ኡፋይቴስ፤","poem":1},{"text":"ሽን ኢታት ቢታ ሃርያ ዎደ አሳይ ኡንኤቴስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ጭንጫተ ዶስያ አስ ባ አዋ ኡፋይሴስ፤","poem":1},{"text":"ሽን ላይማ ማጫሳ ሄራን ዩይያ አስ ባ ሚሽያ ዉርሴስ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ቱማ ፕርዳን ካዎይ ባ ካዎተ ዎፑ ኦስ፤","poem":1},{"text":"ሽን ዎፈ ኤክያ ካዎይ ባ ካዎተ ይሴስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ባ ሾሩዋ ጭሞን ሳቢያ አስ፥","poem":1},{"text":"ባ ቶሆስ ፅሄ የጌስ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኢታ አስ ባ ናጋራን ኦይከቴስ፤","poem":1},{"text":"ሽን ፅሎ አስ ኡፋይቴስ፥ የፄስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ፅሎ አስ ማንቆታስ ሱረ ፕርዴስ፤","poem":1},{"text":"ሽን ኢታ አሳት ሄሳ ኤሮኮና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጫይያ አሳት ካታማን ኦሹ ደንሶና፤","poem":1},{"text":"ሽን ጭንጫ አሳት ሀንቆ እርፅሶሶና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ጭንጫ አስ ኤያ አሳ ፕርደ ኬ ኤፍኮ፥","poem":1},{"text":"ኤያይ ሀንቀቴስ፤ ቅስ፤ እያዉ ሳሮይ ባዋ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሱ ጉሳናዉ ሳሞትያ አሳት ሱረ አስ እፆሶና፤","poem":1},{"text":"ፅሎ አሳ ዎናዉ ኮዮሶና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኤያ አስ ባ ሀንቁዋ የድ በሴስ፤","poem":1},{"text":"ሽን ጭንጫ አስ ባና ሃሬስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሹማይ ዎርዶ ኦዳ ስእያባ ግድኮ፥","poem":1},{"text":"እያ ሞርናት ኡባይ ኢታ ግዶሶና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ማንቆይነ አሰ ናቅያ አስ እስባ ኮፆሶና፤","poem":1},{"text":"ኤንታ ናምኣስ አይፈ እምዳይ ጎዳ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ካዎይ ማንቆታስ ሱረ ፕርድኮ፥","poem":1},{"text":"እ ባ አራታን ጋምአና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ፕርጮን ሴር ናይታስ ጭንጫተ እሜስ፤","poem":1},{"text":"ሽን የዳን ድጭዳ ናእ ባ አይዉ ካዉሼስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኢታ አሳት ዳርያ ዎደ ናጋር ዳሬስ፤","poem":1},{"text":"ሽን ፅሎት ኤንታ ኩንደ በአና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ነ ናኣ ሴራ፤","poem":1},{"text":"እ ነዉ ሳሮ እማና፤","poem":2},{"lineBreak":true},{"text":"እ ነና ኡፋይሳና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ቆንጨ ባይና እፅኮ ደረይ የዳ ግዴስ፤","poem":1},{"text":"ሽን ህገ ናግያ አስ አንጀትዳይሳ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"አይለይ ጮ ኦዳ ፃላላን ሴረተና፤","poem":1},{"text":"እያዉ ገልያኮካ እ ኪተተና።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ኤሶን ሃሳያ አስ በአ ኤራይ?","poem":1},{"text":"እያፐ ኤያ አሳስ ኡፋይስ ደኤስ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ነ አይልያ ናአ የዳ ድችኮ፥","poem":1},{"text":"እያ ዉርሰይ አዛኖ ግዳና።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ሀንቀትያ አስ ኦሹ ደንስ፤","poem":1},{"text":"ኤለ ይሎትያ አስ ዳሮ ናጋራ ኦስ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ኦቶሮይ አሰ ካዉሼስ፤","poem":1},{"text":"ሽን አሽከ አያን ደእያ አስ ቦንቸቴስ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ካይሶራ ላገትያ አስ ባና እፅያ አስ፤","poem":1},{"text":"እ ዳባባን ቱማ ኦድኮ ሴረቴስ፤","poem":2},{"lineBreak":true},{"text":"እ ቱማ ኦዶና እፅኮ ጎዳን ባደታና።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"አሳስ ያሽ ሄ ኡራስ ፅሄ ግዴስ፤","poem":1},{"text":"ሽን ጎዳን አማነትያ አስ ሳሮ ደኤስ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዳሮት ማት ደእያ አሳፐ ማደ ኮዮሶና፤","poem":1},{"text":"ሽን ሱረ ፕርድ ጎዳፐ በንቴስ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ፅሎት ናጋራንቾታ ሻተቶሶና፤","poem":1},{"text":"ኢታት ሱረ አሳ እፆሶና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PRO/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PRO/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PRO/28.json","previousChapterAudioLinks":{},"numberOfVerses":27}