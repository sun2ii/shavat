rse","number":7,"content":[{"text":"ጎዳዉ፥ ታ ነና ናምኡባ ኦይቻይስ፤","poem":1},{"text":"ታ ሀይቃና ጋካናዉ ኤንታ ታና ድጎፋ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታ አሰ ጭሞና መላነ ዎርዶ ሃሳዮና መላ ታና ናጋ፤","poem":1},{"text":"ታዉ ኮሽያ ካ እማፈ አትሽን፥ ታና ዱረ ዎይኮ ማንቆ ኦፋ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዱረ ግዳዳ፥ “ጎዳይ ኦኔ?” ጋዳ ነና ካዳና፤","poem":1},{"text":"ማንቆ ግዳዳ፥ ካይሳዳ ታ ፆሳ ሱን ጫይሳና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ነና ባዶና መላነ","poem":1},{"text":"እያ ባደይ ነዉ ጎመ ግዶና መላ፥","poem":2},{"lineBreak":true},{"text":"አይልያ እያ ጎዳራ ዝግሮፓ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ባ አዋ ባድያነ ባ አይዉ አንጆና የለተ ደኤስ።","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ዳሮ ቱና ግድ ኡትድ","poem":1},{"text":"ባንታና ጌሽ ኦያ አሳት ደኦሶና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኦቶሮን ኩምዳ አሳትነ","poem":1},{"text":"አሰ ካድ ፄልያ አሳት ደኦሶና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኤንታ አቻይ ማሸ ግድን፥","poem":1},{"text":"ኤንታ ጋጮይ ቶራ ግድን፥","poem":2},{"lineBreak":true},{"text":"ማንቆታነ መቶታንቾታ ናቅድ፥","poem":2},{"lineBreak":true},{"text":"ኤንታባ ቦንቅያ አሳት ደኦሶና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኡላስ ናምኡ ማጫ ናይት ደኦሶና፤","poem":1},{"text":"ኤንቲ፥ “ሀማ! ሀማ!” ያግድ ዋሶሶና።","poem":2},{"text":"ካልድ ኤሮና ሄባት ደኦሶና፤","poem":1},{"text":"ኦይዳንይ ቃስ “ግዳና” ግድ ኤረና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሄሳት፥","poem":1},{"text":"ዱፎ፥","poem":2},{"lineBreak":true},{"text":"ማይንዳ ማጫስ፥","poem":2},{"lineBreak":true},{"text":"ሃ ካልድ ኤሮና መላ ቢታነ፥","poem":2},{"lineBreak":true},{"text":"“ግዳና!” ግድ ኤሮና ታማ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ባ አዋ ለቅያ ናኣ አይፍያ፥","poem":1},{"text":"ባ አይያ ጭምን ካያ ናኣ አይፍያ፥","poem":2},{"lineBreak":true},{"text":"ዛንጋራን ደእያ ቁሮት ዎጫና፤","poem":2},{"lineBreak":true},{"text":"እያ አሹዋ አንኮት ማና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ታና ሄባት ማላልሶሶና፤","poem":1},{"text":"ኦይዳንይ ኡባ ታዉ ገለና።","poem":2}]},{"type":"verse","number":19,"content":