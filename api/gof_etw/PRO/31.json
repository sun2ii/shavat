{"type":"verse","number":9,"content":[{"text":"ኤንታ ምየን ኤቃዳ ኤንታዉ ሱረ ፕርዳ፤","poem":1},{"text":"ማንቆታነ መቶታንቾታ ማታ ናጋ” ያጋዳ ታማርሳሱ።","poem":2}]},{"type":"heading","content":["ዎዛናማ ማቾ"]},{"type":"verse","number":10,"content":["“ዎዛናማ ማቾ ኦን ደማናዉ ዳንዳኢ?",{"text":"እ ጋተይ ዞኦ አልኦ ሹቻፈ አስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እ አዝናይ እዮ አማነቴስ፤","poem":1},{"text":"እያዉ ኮሽያባፐ አይብካ ፓጨና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እያ ባ ደኦ ላይ ኡባን፥","poem":1},{"text":"እያዉ ሎኦባፐ አትሽን፥ ኢታባ ኦኩ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሱፈነ ሊኖ ኮያዳ፥","poem":1},{"text":"ኡፋይታሸ ባ ኩሸን ኦዉሱ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እያ ዛልአንቾታ ማርካበ መላ፤","poem":1},{"text":"ባ ካ ሃሆ ቢታፈ ሺሻዉሱ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እያ ባ ሶ አሳስ ካ ጊግሳናዉነ","poem":1},{"text":"ባ ማጫ አይለታስ ኦሶ እማናዉ፥","poem":2},{"lineBreak":true},{"text":"ሳእ ዎንቶና ደእሽን ደንዳዉሱ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሎኦ ጋደ ኮያዳ ሻማዉሱ፤","poem":1},{"text":"ባ ኩሸን ኦዳ ደምዳ","poem":2},{"lineBreak":true},{"text":"ሚሸን ዎይነ ቶካዉሱ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እያ ባ ፄሳ ምንዳ ዳንጫዉሱ፤","poem":1},{"text":"ባ ቀስያ ኦሶስ ምንዉሱ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"እያ ዎ ደማናዉ ምናዳ ዛልአዉሱ፤","poem":1},{"text":"እያ ኦሸ ቃምስያ ግሾ እ ፆምፐይ ቶኤና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"እያ ባ ህንርትያ ኦይካዉሱ፤","poem":1},{"text":"ባ ብራን ሎይዳ ሱቃዉሱ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"እያ ማንቆታስነ መቶታንቾታስ እማዉሱ።","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"እ ሶ አሳ ኡባይ ሆእያ ማኦ ማእያ ግሾ፥","poem":1},{"text":"ሻች ቡክኮካ እያ ህርጉኩ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"አልጋ ቦላ ሂፅያ ማኦ ስካዉሱ፤","poem":1},{"text":"ሊኖፐ ኦሰትዳ ኦቻ ቴራ ዳንያ ማኦ ማአዉሱ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ቢታ ጭማት ሺቅያ ዱቡሻን","poem":1},{"text":"እ አዝናይ ቦንቸትዳ አስ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ሊኖፐ ማኦነ ዳንጮ ኦዳ፥","poem":1},{"text":"ዛልአንቾታስ ባይዛዉሱ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"እያ ምኖነ ቦንቾ አስ፤","poem":1},{"text":"ያና ላይ ኡባን ኡፋይታዳ ደአዉሱ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ጭንጫተን ባ ዶና ዶያዉሱ፤","poem":1},{"text":"አማንያ ዞረይ እ እንፃርሳን ደኤስ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"እያ ባ ሶ አሳ ደኡዋ እንጀያናዉ ኡባ ዎደ ኦዉሱ፤","poem":1},{"text":"አዛላተ እ ቦላ በንትድ ኤረና።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"እ ናይት ደንድድ፥ እዮ ናሾሶና፤","poem":1},{"text":"እ አዝናይ እዮ ያግድ ጋላቴስ፤","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ሎኦባ ኦያ ዳሮ ማጫሳት ደኦሶና፤","poem":1},{"text":"ሽን ነ ኤንታ ኡባፈ አሳ” ያጌስ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ማል ጭሜስ፤","poem":1},{"text":"የገልሳተ ያና።","poem":2},{"text":"ሽን ጎዳ ያይያ ማጫስያ፥","poem":1},{"text":"እያ አንጀትዳሮ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"እያ ኦዳባ ኡባስ እዮ ዎይትተ፤","poem":1},{"text":"እ ኦሶ ኡባይ ዳባባን እዮ ጋላትሶ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":31}