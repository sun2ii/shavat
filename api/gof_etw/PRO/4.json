"poem":1},{"text":"እያ ነና ቁ ቁ ኦና፤","poem":2},{"lineBreak":true},{"text":"ነ እዮ ኦይክኮ፥ እያ ነና ቦንቻና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እያ ነ ሁጵያስ ሳባ ግዳና፤","poem":1},{"text":"ቦንቾ ካላቻ እማና” ያግስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታ ናአዉ፥ ስአ፤ ታ ኦደይሳ ኤካ፤","poem":1},{"text":"ነ ላይይ አዱቃና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታኒ ነና ጭንጫተ ኦገ ካለና፤","poem":1},{"text":"ሱረ ሆሮጋ በሳና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ነ ሄመትያ ዎደ ብያባይ ዴና፤","poem":1},{"text":"ዎፅያኮካ በታካ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታ ትምርትያ ሎይ ናጋ፤ የዶፋ፤","poem":1},{"text":"ትምርተይ ነዉ ደኦ እምያ ግሾ ሎይ ናጋ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ናጋራንቾታ ኦግያራ ቦፓ፤","poem":1},{"text":"ኢታ አሳታ ኦግያን ሄመቶፋ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እያፐ ሃካ፤ እያን ሄመቶፋ፤","poem":1},{"text":"ጉየ ስማ፤ ነ ኦግያን ባ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኤንቲ ኢታባ ኦና ደእሽን ስኮይ ኤከና፤","poem":1},{"text":"ኤንቲ አሰ ቦና ደእሽን ስኮይ ኤፈና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ኤንቲ ናጋራ ካዳ ሞሶና፤","poem":1},{"text":"ጌላተ ኡሻዳ ኡዮሶና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ፅሎታ ኦገይ ሴታ ጋላስ ጋካናዉ፥","poem":1},{"text":"ጉጅ ጉጅ ፖእያ ዎንታ ፃልቀ መላ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሽን ጌላታ ኦገይ ሳካና ማ መላ፤","poem":1},{"text":"ኤንቲ አይብን በትያኮካ ኤሮኮና።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ታ ናአዉ፥ ታ ኦደይሳ ስአ፤","poem":1},{"text":"ነ ሀይ ታኮ ዛራ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ነ አይፍያ ስንፈ ሃሶፋ፤","poem":1},{"text":"ነ ዎዛናን ናጋ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ኤንታ ደምያ ኡባስ ኤንቲ ደኦ፤","poem":1},{"text":"ኤንቲ አሳተስ ፓያተ እሞሶና።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ደኦይ እያፐ ፑልትያ ግሾ፥","poem":1},{"text":"ኡባፈ አዳ ነ ዎዛና ምንዳ ናጋ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ነ ዶናፐ ኢታ ሃሳያ ድጋ፤","poem":1},{"text":"ዎርዶ ሃሳያ ነ ማታፐ ሃሳ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ስት ጋዳ ስን ፄላ፤","poem":1},{"text":"ነ አይፈይ ነ ስንን ደእያባ","poem":2},{"lineBreak":true},{"text":"ትሽ ኦድ ፄሎ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ነ ቶሁዋ ኦግያ ጊግሳ፤","poem":1},{"text":"ሱረ ኦገ ፃላላን ሄመታ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ሱረ ኦገፐ ኡሻች ሀድርስ ጎፓ፤","poem":1},{"text":"ነ ቶሆይ ኢታ ኦገ ቦናዳ ናጋ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}