{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_etw","name":"ሌምሶ ማፃፋ","commonName":"ሌምሶ ማፃፋ","title":"ሌምሶ ማፃፋ","order":20,"numberOfChapters":31,"sha256":"b9b9ecd06cfa4516217d880648cb3322ef1f40bd36b07bdc8a0903d302627723","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_etw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":5,"content":[{"type":"heading","content":["ላይማተፈ ሃካ"]},{"type":"verse","number":1,"content":[{"text":"ታ ናአዉ፥ ታ ጭንጫተ ሀይዛ ስአ፤","poem":1},{"text":"ነ ሀይ ታ ትምርትያኮ ዛራ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሄስ ነና ዎዛናማ ኦና፤","poem":1},{"text":"ነ ኦዳይ ነ ኤራተ ቆንጭሳና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ላይማ ማጫሳ እንፃርሳፈ እልሎ ኤስ ፆኬስ፤","poem":1},{"text":"እ ኦዳይ ኦይሳፐ አድ ሎፅኬስ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሽን ዉርሰን እያ ጎዳረ ኡዳ ጫማዉሱ፤","poem":1},{"text":"ናምኡ ባጋራ ቃንፅያ ማሻዳ ቃራ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እ ቶሆይ ሀይቆኮ ቤስ፤","poem":1},{"text":"እ ታንጎይ ዱፎ ጋስ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እያ ደኦ ኦገ ቆፑኩ፤ እ ኦገይ ጌላ፤","poem":1},{"text":"ሽን ጌላ ግደይሳ እያ ኤሩኩ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታ ናአዉ፥ ታና ስአ፤","poem":1},{"text":"ታ ኦደይሳፈ ከዮፓ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ላይማ ማጫሳ ሄራ ቦፕተ፤","poem":1},{"text":"እ ኬ ፐንግያኮ ሺቆፕተ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሄስ ሀኖና እፅኮ ህንተ ቦንቹዋ ሀራት ኤካና፤","poem":1},{"text":"ናአተን ዎዛና ምኖ አሳ ኩሸን ህንተ ሀይቃና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ህንተ አቁዋ አላጋት ኤካና፤","poem":1},{"text":"ህንተ ዳቡራድ ሺሽዳባይ ሀራ አሳስ ግዳና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዉርሰን ህንተ አሾይነ","poem":1},{"text":"ህንተ አሳተይ ዉርን ህንተ ዬካና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ህንተ ያጋና፤ “ታ አይስ ትምርተ እፃድና?","poem":1},{"text":"ታ ዎዛናይ ሴራ አይስ ካዴ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታኒ ታ አስታማረታ ስአብከ፤","poem":1},{"text":"ታና ዞረይሳታ ዞርያ ኤካብከ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሄሳ ግሾ፥ ታ አሳይ ሺቅዳ ሺቁዋን፥","poem":1},{"text":"ካዉያናዉ ማታስ” ያጋና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኔኒ ነ ፑልቱዋፈ ሃ ኡያ፤","poem":1},{"text":"ነ ማቸ ፃላላ ሲቃ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ነ ፑልቱዋ ዳባባን፥","poem":1},{"text":"ነ ኦላ ሃ ደንባን አይስ ጉሳይ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ኤንታ ነዉ ቡዞ ኦ፤","poem":1},{"text":"ሀራ አላጋ ኡራራ ኮፆፋ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ነ ፑልቶይ ነዉ አንጀቶ፤","poem":1},{"text":"ነ ናአተ ማቸራ ኡፋይታ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሎእያ ጋረዳንነ ኡፋይስያ ገንኤዳ","poem":1},{"text":"እ ንይ ኡባ ዎደ ነና አሎ፤","poem":2},{"lineBreak":true},{"text":"ኡባ ዎደ እ ሲቆይ ነና ድኦ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ታ ናአዉ፥ ላይማ ማጫሳን አይስ ድኤታይ?","poem":1},{"text":"ሀራ አሳ ማቾ አይስ ቆማይ?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"አስ ኦያባ ኡባ ጎዳይ በኤስ፤","poem":1},{"text":"እ ሄመትያ ሆሮጋ ኡባ ፄሌስ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ናጋራንቹዋ እ ኦዳ ናጋራይ ኦይኬስ፤","poem":1},{"text":"እያ ናጋራ ግተይ እያ ቃቼስ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"እ ባ ኤያተን ይስ፤","poem":1},{"text":"ባና ናግቦና ግሾ ሀይቅስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PRO/4.json","previousChapterAudioLinks":{},"numberOfVerses":23}