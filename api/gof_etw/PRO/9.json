{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_etw","name":"ሌምሶ ማፃፋ","commonName":"ሌምሶ ማፃፋ","title":"ሌምሶ ማፃፋ","order":20,"numberOfChapters":31,"sha256":"b9b9ecd06cfa4516217d880648cb3322ef1f40bd36b07bdc8a0903d302627723","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_etw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":9,"content":[{"type":"heading","content":["ጭንጫተ፥ ኤራተነ ኤያተ"]},{"type":"verse","number":1,"content":[{"text":"ጭንጫተ ባ ኬ ኬፃሱ፤","poem":1},{"text":"ላፑን ቱሳታ ባ ኬስ ኤሳሱ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እያ ባ ጊግስያ ግብራስ ሞ መሄ ሹካሱ፤","poem":1},{"text":"ዎይነ አጋሱ፤ ጋይታ አሳ ስን አሱ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አሳ ፄጋናዉ ባ አይለታ ኪታሱ፤","poem":1},{"text":"ኦሳንቾት ካታማ ቃ በሳን ኤቅድ፥","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ህንተኖ፥ ኤር ፓጭዳይሳቶ ሃ ገልተ! ኤያታኮ ሀይሳዳ ያጋሱ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“ሃ ዪተ፤ ታ ካ ሚተ፤","poem":2},{"lineBreak":true},{"text":"ታ አግዳ ዎይንያ ኡይተ።","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ህንተ ኤያተ አግድ ደኦን ደእተ፤","poem":2},{"lineBreak":true},{"text":"አኬክድ ሄመትተ” ያጋሱ።","poem":2}]},{"type":"verse","number":7,"content":["ቀልቅስያ ኡራ ሴርያ አስ ጫሸ ኤኬስ፤",{"text":"ኢታ ኡራ ዞርያ አስ ባዉ ቆሄቴስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ቀልቅስያ ኡራ ዞሮፓ፤ እ ነና እፃና፤","poem":1},{"text":"ጭንጫ ኡራ ዞራ፤ እ ነና ዶሳና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ጭንጫተ ኡራ ታማርሳ፤ እ ጭንጫ ግዳና፤","poem":2},{"lineBreak":true},{"text":"ፅሎ ኡራ ታማርሳ፤ እ ኤራ ጉጃና።","poem":2}]},{"type":"verse","number":10,"content":["ጎዳስ ያሽ ጭንጫተስ ዶመ፥ ጌሻ ጎዳ ኤሮይ አኬካ።"]},{"type":"verse","number":11,"content":[{"text":"ታ ጋሶን ነ ላይይ ዳራና፤","poem":1},{"text":"ነ ደኦ ላይይ አዱቃና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ነ ጭንጫ ግድኮ፥ ጎኤተይ ነና፤","poem":1},{"text":"ነ ቀልቅስያ አስ ግድኮ ነና ቆሃሳ።","poem":2}]},{"type":"verse","number":13,"content":["ኤያ ማጫስ ዋሶ ዳራዉሱ፤",{"text":"እዉ ዬል ባዋ፤ እያ አይኮካ ኤሩኩ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እያ ባ ካረን ዎይኮ ካታማ ቃ በሳን ኡታዉሱ።","poem":1}]},{"type":"verse","number":15,"content":[{"text":"ባንታ ኦግያ ብያ አሳ ፄጋዳ፥","poem":1}]},{"type":"verse","number":16,"content":[{"text":"“ህንተኖ፥ ኤር ፓጭዳይሳቶ","poem":1},{"text":"ታኮ ሃ ዪተ” ያጋሱ። ኤር ባይናይሳታኮ፥","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“ካይስድ ኡያ ሃ ማልኤስ፤","poem":2},{"lineBreak":true},{"text":"ጌማን ምያ ካ ሎኤስ” ያጋሱ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሽን ሀይቅዳ አሳይ ያን ደኤይሳ፥","poem":1},{"text":"እ እማትካ ዱፎን ደኤይሳ እ ኤረና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}