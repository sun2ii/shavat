{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_etw","name":"ማዝሙረ ማፃፋ","commonName":"ማዝሙረ ማፃፋ","title":"ማዝሙረ ማፃፋ","order":19,"numberOfChapters":150,"sha256":"0c025deb66520f61a3c823a973fb5df9bd3589998b1748b5e7240ec0298578c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_etw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":102,"content":[{"type":"heading","content":["ነ ሶምኡዋ ታፐ ገንፋ"]},{"type":"hebrew_subtitle","content":["ኡንኤትዳ ዎደ ፆሳ ስንን ዎስዳ አሳ ዎሳ"]},{"type":"verse","number":1,"content":["ጎዳዉ፥ ታ ዎሳ ስአ፤",{"text":"ታ ዋሶይ ኔኮ ጋኮ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታ ዋይያ ጋላስ ነ ሶምኡዋ ታፐ ገንፋ፤","poem":1},{"text":"ነ ሀይ ታኮ ዛራ፤","poem":2},{"lineBreak":true},{"text":"ታኒ ኔኮ ዋስያ ዎደ፥ ታና ኤሶን አላ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታ ላይይ ጩያዳ ዬስ፤","poem":1},{"text":"ታ መቀይ ታማዳ ኤፄስ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታ ዎዛናይ ቡጭድ የግዳ ማታዳ መልስ፤","poem":1},{"text":"ካካ ታዉ ሜተተና።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ታኒ ታ ቃላ ቁ ኦዳ ኦልዳ ግሾ፤","poem":1},{"text":"ታ ጎጋይ መቀራ ኦይከትስ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታኒ ዎራን ደእያ ሶሎ መላ፥","poem":1},{"text":"ካይሳ ኬን ደእያ ጉቶ መላ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታኒ ዝንእን ስኮይ ዬና፤","poem":1},{"text":"ታኒ ኬ ሁጰን ባርካ ኡትዳ ካፎ ግዳስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታ ሞርከት ጋላስ ኩመ ታና ጫዮሶና፤","poem":1},{"text":"ታና ቀልቅሰይሳት ታ ሱንን ባዶሶና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ብዶይ ታዉ ካ ግድስ፤","poem":1},{"text":"ታ አፉይ ታ ኡሻራ ዋላከትስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሄስ ሀንዳይ ነ ሀንቆይነ ነ ይሎይ፥","poem":1},{"text":"ታና ደንድ ዎራ ሆልዳ ግሾሳ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታ ላይይ ኦማርሳ ኩያ መላ ኤለስድ አስ፤","poem":1},{"text":"ታኒ ማታዳ ሹላይስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሽን ጎዳዉ፥ ኔኒ ነ አራታን መርናዉ ኡታዳሳ፤","poem":1},{"text":"ነ ሱንይ የለታፐ የለታ ጋካናዉ ሀሳየታና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኔኒ እዮ ማርያ ዎደይ ጋክዳ ግሾ፤","poem":1},{"text":"ደንዳዳ ፅዮነስ ቃታ፤","poem":2},{"lineBreak":true},{"text":"ኔኒ ዶርዳ ዎደይ ጋክስ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እ ሹቻት ነ ኦሳንቾታስ አልኦ፤","poem":1},{"text":"እ ቢታይካ ኤንታ ቃስ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ካዎተት ጎዳ ሱንስ ያያና፤","poem":1},{"text":"ሳኣ ካዎት እያ ቦንቹዋስ ዳጋማና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ጎዳይ ፅዮነ ዛሪድ ኬፃና፤","poem":1},{"text":"ባ ግታተ በሳና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እ ማንቆታ ዎሳ ስአና፤","poem":1},{"text":"ኤንታ ኦይሻ ካና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ቡሮ የለታና አሳይ ጎዳ ጋላታና መላ፥","poem":1},{"text":"ሀይስ ያ የለታስ ፃፈቶ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ጎዳይ ቃን ደእያ","poem":1},{"text":"ባ ጌሻ በሳፈ ፄልስ፤","poem":2},{"lineBreak":true},{"text":"ሳሎን ግድድ ሳኣ ፆሞሴስ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ሄስካ ቃሸትዳ አሳ ዋሱዋ ስአናዉነ","poem":1},{"text":"ሀይቆ ፕርደትዳ አሳ ብርሻናሳ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሄሳ ግሾ፥ ጎዳ ሱንይ ፅዮነን ኦደታና፤","poem":1},{"text":"እያ ጋላታይ የሩሳላመን አዋጀታና።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ደረይነ ካዎተይ ሺቅድ፥","poem":1},{"text":"ጎዳስ ሄ ዎደ ጎይናና።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ታኒ ናአተን ደእሽን፥","poem":1},{"text":"ታ ዎልቃ እፅስስ፤ ታ ላይ ቃምስስ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ታኒ፥ “ታ ፆሳዉ፥","poem":1},{"text":"ታ ላይ ግዶ ዛዋን ታና ኮፋ” ያጋይስ።","poem":2},{"lineBreak":true},{"text":"ጎዳዉ፥ ኔኒ የለታፐ የለታ ጋካናዉ ደኣሳ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ኔኒ በን ሳኣ መዳሳ፤","poem":1},{"text":"ሳሎይካ ነ ኩሸ ኦሶ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ሀይሳቲ ኡባይ ያና፤ ሽን ኔኒ ዳና፤","poem":1},{"text":"ኤንቲ ኡባይ አፍላዳ ዉራና።","poem":2},{"text":"ኔኒ ኤንታ ጩርቃ አፍላዳ ላማና፤","poem":1},{"text":"ኤንትካ አና።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ሽን ኔኒ ነና፤","poem":1},{"text":"ነ ላይይ ዉረና።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ነ አይለታ ናይታ ኔኒ ሳሮ ዎሳ፤","poem":1},{"text":"ኤንታ ኮቻይ ነ ስንን ምንድ ዳና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}