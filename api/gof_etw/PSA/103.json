{"type":"verse","number":9,"content":[{"text":"እ ኡባ ዎደ ሴረና፤","poem":1},{"text":"መርናዉ ሀንቀተና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እ ኑስ ኑ ናጋራዳ ኦና፤","poem":1},{"text":"ኑ ኢታተ መላ ዛረና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሳሎይ ሳአፐ ቀይሳዳ፥","poem":1},{"text":"ጎዳ ያየይሳታስ እያ ሲቆይ ግታ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዶሎሀፐ ዉሎህ ሃከይሳዳ፥","poem":1},{"text":"ጎዳይ ኑ ናጋራ ኑፐ ሃሴስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አው ባ ናይታስ ቃተይሳዳ፥","poem":1},{"text":"ጎዳይ ባዉ ያየይሳታስ ቃቴስ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኑኒ አይብፐ መትዳኮ እ ኤሬስ፤","poem":1},{"text":"ኑኒ ቢታ ግደይሳ እ አኬከስ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አስ ባዉ ማታ መላ፤","poem":1},{"text":"እ ባዞ ጪሻዳ ጭዬስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ጫርኮይ እያ ቦላ ጫርክያ ዎደ ዬስ፤","poem":1},{"text":"እ ዶልዳ በሳይ ዛሪድ ኤረተና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሽን ጎዳስ ያየይሳታስ","poem":1},{"text":"እያ ሲቆይ መርናፐ መርና ጋካናሳ፤","poem":2},{"lineBreak":true},{"text":"እያ ፅሎተይ ናአ ናአ ጋካናሳ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሄስ ሀነይ እያ ጫቁዋ ናገይሳታነ","poem":1},{"text":"እያ ኪታ ፖላናዉ ምነይሳታሳ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ጎዳይ ሳሎታን ባ አራታ ኤስስ፤","poem":1},{"text":"እያ ካዎተይ ኡባ ሃሬስ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ህንተኖ፥ እያ ኪታንቻቶ፥","poem":1},{"text":"እያ ኪታ ናግያ ዎልቃማቶ፥","poem":2},{"lineBreak":true},{"text":"እ ኦድያባ ስኤይሳቶ፥ ጎዳ ጋላትተ!","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ህንተኖ ሳሎን ደእያ ምኖቶ፥","poem":1},{"text":"እያ ሸንያ ፖለይሳቶ፥ ጎዳ ጋላትተ!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ህንተኖ፥ እ ሃርያ በሳ ኡባን፥","poem":1},{"text":"ደእያ መተቶ፥ ጎዳ ጋላትተ!","poem":2},{"lineBreak":true},{"text":"ታ ሸምፐ ጎዳ ጋላታ!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}