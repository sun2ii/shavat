:"verse","number":37,"content":[{"text":"ኤንቲ ባንታ አደነ ማጫ ናይታ","poem":1},{"text":"ቱና አያናታስ ያርሽዶሶና።","poem":2}]},{"type":"verse","number":38,"content":[{"text":"ኤንቲ ፅሎ ሱ ካናነ ኤቃታስ ያርሽድ፥","poem":1},{"text":"ባንታ አደነ ማጫ ናይታ ሱ ጉስዶሶና፤","poem":2},{"lineBreak":true},{"text":"ሄ ሱን ቢታይ ቱንስ።","poem":2}]},{"type":"verse","number":39,"content":[{"text":"ሄሳዳ ኤንቲ ባንታ ኦሶን ቱንዶሶና፤","poem":1},{"text":"ባንታ ሀኖታን ባንታ ላይማ ከስዶሶና።","poem":2}]},{"type":"verse","number":40,"content":[{"text":"ሄሳ ግሾ፥ ጎዳ ሀንቆይ","poem":1},{"text":"እያ አሳ ቦላ ኤፅስ፤","poem":2},{"lineBreak":true},{"text":"እ ባ ላታ ሻተትስ።","poem":2}]},{"type":"verse","number":41,"content":[{"text":"እ ኤንታ አላጋ ኩሸን አድ እሚስ፤","poem":1},{"text":"ኤንታ ሞርከት ኤንታ ሃርዶሶና።","poem":2}]},{"type":"verse","number":42,"content":[{"text":"ኤንታ ሞርከት ኤንታ ኡንኤዶሶና","poem":1},{"text":"ባንታ ሸነን ኤንታ አይስዶሶና።","poem":2}]},{"type":"verse","number":43,"content":[{"text":"እ ኤንታ ዳሮ ዎደ አሽስ፤","poem":1},{"text":"ሽን ኤንቲ ባንታ ማካላ አጎና እፅዶሶና፤","poem":2},{"lineBreak":true},{"text":"ባንታ ናጋራ ጋሶን ይዶሶና።","poem":2}]},{"type":"verse","number":44,"content":[{"text":"ግዶሽን፥ እ ኤንታ ዋሱዋ ስእስ፤","poem":1},{"text":"ኤንታ ዋይያ ቆፕስ።","poem":2}]},{"type":"verse","number":45,"content":[{"text":"እ ኤንታ ግሾ፥ ባ ኡፋይሳ ቃላ ሀሳይስ፤","poem":1},{"text":"ባ ሲቁዋ ዳሩዋን ኤንታ ማርስ።","poem":2}]},{"type":"verse","number":46,"content":[{"text":"ኤንታ ድእዳ ኡባይ፥","poem":1},{"text":"ኤንታዉ ቃታና መላ ኦስ።","poem":2}]},{"type":"verse","number":47,"content":[{"text":"ኑኒ ነ ጌሻ ሱን ጋላታና መላ","poem":1},{"text":"አቤት ጎዳዉ፥ ኑ ፆሳዉ፥ ኑና አሻ።","poem":2},{"text":"ነ ቦንቹዋን ኑ ጬቀታና መላ፥","poem":1},{"text":"ካዎተታ ግዶፈ ኑና ሺሻ።","poem":2}]},{"type":"verse","number":48,"content":[{"text":"እስራኤለ ጎዳይ፥ ፆሳይ፥","poem":1},{"text":"መርናፐ መርና ጋካናዉ ጋላተቶ!","poem":2},{"lineBreak":true},{"text":"አሳ ኡባይ፥ “አምንእ” ያጎ።","poem":2},{"lineBreak":true},{"text":"ጎዳ ጋላትተ!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}