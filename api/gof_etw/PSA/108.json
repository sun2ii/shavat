{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_etw","name":"ማዝሙረ ማፃፋ","commonName":"ማዝሙረ ማፃፋ","title":"ማዝሙረ ማፃፋ","order":19,"numberOfChapters":150,"sha256":"0c025deb66520f61a3c823a973fb5df9bd3589998b1748b5e7240ec0298578c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_etw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":108,"content":[{"type":"heading","content":["ፆሳይ ኑ ባጋ"]},{"type":"hebrew_subtitle","content":["ዳዊታ ማዝሙረ"]},{"type":"verse","number":1,"content":[{"text":"ታ ዎዛናይ ምንድ ደኤስ፤","poem":1},{"text":"አቤት ፆሳዉ፥ ታ ዎዛናይ ምንድ ደኤስ።","poem":2},{"lineBreak":true},{"text":"ታ ነዉ የፃና፤ ነና ሳባና።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታ ሸምፐ፥ ባርካ፤","poem":1},{"text":"ዲነ ማስንቆይ ደንዳ፤","poem":2},{"lineBreak":true},{"text":"ታ ዎንታ ጉራ ደንዳና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አቤት ጎዳዉ፥ ታ ነና አሳ ግዶን ጋላታና፤","poem":1},{"text":"ካዎተ ግዶን ነና ሳባና።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ነ መርና ሲቆይ ሳሎፐ ቃ፤","poem":1},{"text":"ነ አማነተይ ሻራፐ ቃ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አቤት ፆሳዉ፥ ሳሎፐ ቦላራ ነ ቁ ቁ ጋ፤","poem":1},{"text":"ነ ቦንቾይ ሳአ ኡባ ቦላ ግዶ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ነ ዶሰይሳት አታና መላ፥","poem":1},{"text":"ነ ኡሻቻ ኩሸን ኑና አሻ፤","poem":2},{"lineBreak":true},{"text":"ኔኒ ታ ዎሳ ስአ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ፆሳይ ባ ጌሻ በሳን ሀይሳዳ ያግስ፤","poem":1},{"text":"“ታ ፆናዳ ሴከማ ሻካና፤","poem":2},{"lineBreak":true},{"text":"ሱኮታ ዛንጋራ ግሻና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጋላድነ ምናሰይ ታባ፤","poem":1},{"text":"ኤፍሬም ታ ሁጰን ዎያ ኡከ፤","poem":2},{"lineBreak":true},{"text":"ይሁድ ታ ካዎታ ፃምኣ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሞአበይ ታ ሜጨትያ ጋባተ፤","poem":1},{"text":"ኤዶመይ ታባ ግደይሳ ኤርሳናዉ","poem":2},{"lineBreak":true},{"text":"ታ ጫማ እያ ቦላ ዎና።","poem":2},{"lineBreak":true},{"text":"ፍልስፄመ ፆናዳ ገሬራና” ያግስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ጎዳዉ፥ ግምበትዳ ካታማኮ፥ ታና ኤፋናይ ኦኔ?","poem":1},{"text":"ኤዶመ ጋካናዉ ታና ካለናይ ኦኔ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አቤት ፆሳዉ፥ ኑና አግዳይ ነና ግድኪ?","poem":1},{"text":"አቤት ፆሳዉ፥ ነ ኑ ቶራንቾታራ ኦላስ ከያካ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አሳ ማዶይ ፓና ግሾ፥","poem":1},{"text":"ሞርክያ ኦላናዉ ነ ኑና ማዳ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ፆሳ ዎልቃን ኑ ሞርከታ ፆናና፤","poem":1},{"text":"ኑ ሞርከታ ካዉሻናይ እያ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}