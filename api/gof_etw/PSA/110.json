{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_etw","name":"ማዝሙረ ማፃፋ","commonName":"ማዝሙረ ማፃፋ","title":"ማዝሙረ ማፃፋ","order":19,"numberOfChapters":150,"sha256":"0c025deb66520f61a3c823a973fb5df9bd3589998b1748b5e7240ec0298578c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_etw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":110,"content":[{"type":"heading","content":["ፆሳይ ታ ምየና"]},{"type":"hebrew_subtitle","content":["ዳዊታ ማዝሙረ"]},{"type":"verse","number":1,"content":["ጎዳይ ታ ጎዳ፥ “ታ ነ ሞርከታ ነ ቶሆይ",{"text":"የያ በሲ ኦና ጋካናዉ፥","poem":2},{"lineBreak":true},{"text":"ሀይሳን ታፐ ኡሻቻ ባጋን ኡታ” ያግስ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ጎዳዉ ነ ምኖተ ፃምአ ፅዮነፐ የዳ፤","poem":1},{"text":"“ነ ሞርከታ ሃራ” ያጋና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ነ ሃርያ ጋላስ ነ ደረይ ዶስድ ነዉ ሃረታና፤","poem":1},{"text":"ነ ጌሻ ማኡዋ ማአዳ፥","poem":2},{"lineBreak":true},{"text":"ዎንታ ፃልቀዳ ነ ኩመ ዎልቃን ጶላና።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ጎዳይ፥ “ማልከፃደቅ ካህነ ግድዳይሳዳ፥","poem":1},{"text":"ነ መርናዉ ካህነ ግዳና” ያግድ ጫቅስ፤","poem":2},{"lineBreak":true},{"text":"እያ ጫቆይ ላመተና።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ጎዳይ ነ ኡሻቻን ደኤስ፤","poem":1},{"text":"ባ ሀንቁዋ ጋላስ ካዎታ ትንቸረና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"እ ካዎተታ ቦላ ፕርዳና፤","poem":1},{"text":"ኦላ ደንባታ አሀ ፃላላ ኦና፤","poem":2},{"lineBreak":true},{"text":"ቢታ ኡባን ደእያ ካዎታ ይሳና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ካዎይ ኦገ ላንቀን ደእያ ፑልቱዋፈ ኡይድ፥","poem":1},{"text":"እ ባ ሁጵያ ቁ ኦና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}