":8,"content":[{"text":"ኤንታ መይሳትነ","poem":1},{"text":"ኤንታ አማነተይሳት ኤንታ መላ ግዶ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እስራኤለ አሳዉ፥ ጎዳን አማነትተ፤","poem":1},{"text":"ህንተና ማደይነ ህንተ ጎንዳለይ እያ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አሮና ኬ አሳዉ፥ ጎዳን አማነትተ፤","poem":1},{"text":"ህንተና ማደይነ ህንተ ጎንዳለይ እያ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጎዳስ ያየይሳቶ፥ ጎዳን አማነትተ፤","poem":1},{"text":"ህንተና ማደይነ ህንተ ጎንዳለይ እያ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ጎዳይ ኑና ቆፔስ፤ እ ኑና አንጃና፤","poem":1},{"text":"እ እስራኤለ አሳ አንጃና፤","poem":2},{"lineBreak":true},{"text":"እ አሮና ኬ አሳ አንጃና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ጎዳስ ያየይሳታ፥","poem":1},{"text":"እ ጉ ግታ አንጃና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ጎዳይ ህንተና ዳርሶ፤","poem":1},{"text":"ህንተናነ ህንተ ናይታ አንጆ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሳሉዋነ ሳኣ መዳ","poem":1},{"text":"ጎዳይ ህንተና አንጆ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሳሎይ ፆሳባ፤","poem":1},{"text":"ሽን ሳአ አሳስ እሚስ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሀይቅዳይሳት ጎዳ ጋላቶኮና፤","poem":1},{"text":"ዱፎን ዝንእዳይሳት እያ ሳቦኮና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሽን ኑኒ፥ ደኦን ደኤይሳት፥","poem":1},{"text":"ሀችፈ መርና ጋካናዉ፥","poem":2},{"lineBreak":true},{"text":"ጎዳ ጋላቶስ።","poem":2},{"lineBreak":true},{"text":"ጎዳ ጋላትተ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}