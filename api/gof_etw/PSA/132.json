},{"type":"verse","number":8,"content":[{"text":"ጎዳዉ፥ ደንዳ!","poem":1},{"text":"ነ ምኖተ ማላ ግድዳ","poem":2},{"lineBreak":true},{"text":"ነ ታቦትያራ ነ ኬ ገላ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ነ ካህነት ፅሎተ ማኦ፤","poem":1},{"text":"ነ አሳይ ኡፋይሳን የፆ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ነ አይልያ ዳዊታ ግሾ፥","poem":1},{"text":"ኔኒ ትይዳ ካዋ አጎፋ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጎዳይ ዳዊታስ ላመቶና ጫቆ","poem":1},{"text":"ሀይሳዳ ያግድ ጫቅስ፤","poem":2},{"text":"“ነ ጉልባታፐ ከይዳ፥","poem":1},{"text":"ነ ናይታፐ እሱዋ ነ አራታን ኡትሳና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ነ ናይት ታ ጫቁዋነ","poem":1},{"text":"ታ ታማርስያ ትምርትያ ናግኮ፥","poem":2},{"lineBreak":true},{"text":"ኤንታ ናይት ነ አራታን መርናዉ ኡታና” ያግስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ጎዳይ ፅዮነ ዶርስ፤","poem":1},{"text":"ባዉ ደእያ በሲ ኦናዉ አሞትድ፥","poem":2},{"lineBreak":true},{"text":"ሀይሳዳ ያግስ፤","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“ሀይስ ታ መርናዉ ደእያ በሰ፤","poem":1},{"text":"ታኒ አሞትዳ ግሾ ሀይሳን ዳና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ታኒ ዳሮ ካ እማዳ ፅዮነ አንጃና፤","poem":1},{"text":"እያን ደእያ ማንቆታካ ካ ካልሳና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እያን ደእያ ካህነታ አቶተ ማይዛና፤","poem":1},{"text":"እያን ደእያ ፅሎት ኡፋይሳን የፃና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሄ በሳን ዳዊታ ዘርያፐ ካዎ ከሳና፤","poem":1},{"text":"ታኒ ትይዳ ካዋ ካዎተን ጋምእሳና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ታኒ እያ ሞርከታ ዬላ ማይዛና፤","poem":1},{"text":"ሽን እያ ሁጰን ደእያ ካላቻይ ጶላና” ያጋስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":16}