em":2}]},{"type":"verse","number":8,"content":[{"text":"ግብፀ ቢታን አሳፐ መሄ ጋካናዉ፥","poem":1},{"text":"ባይራ የለትዳ ኡባ ዎስ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ነኖ ግብፀ፥","poem":1},{"text":"ፓሮናነ እያ አይለታ ኡባ ሴራናዉ","poem":2},{"lineBreak":true},{"text":"ማላታታነ ማላልስያባታ ኪትስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"እ ዳሮ ካዎተታ ይስስ፤","poem":1},{"text":"ዎልቃማ ካዎታ ዎስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አሞረ ካዋ ስሆና","poem":1},{"text":"ባሳነ ካዋ ኦገነ","poem":2},{"lineBreak":true},{"text":"ካናነ ካዎታ ኡባ ዎስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኤንታ ቢታ ባ አሳ፥","poem":1},{"text":"እስራኤለ ላትስስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ጎዳዉ፥ ነ ሱንይ መርናዉ ዳና፤","poem":1},{"text":"የለታፐ የለታ ጋካናዉ ነ ሀሳየታና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ጎዳይ ባ አሳስ ፕርዳና፤","poem":1},{"text":"እ ባ አይለታስ ቃታና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ካዎተታ ኤቃት አሳ ኩሸ ኦሶታ፤","poem":1},{"text":"ብራፐነ ዎርቃፈ መትዳይሳታ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኤንታዉ ዶን ደኤስ፥ ሽን ሃሳዮኮና፤","poem":1},{"text":"አይፈይ ደኤስ፥ ሽን ፄሎኮና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሀይ ደኤስ፥ ሽን ስኦኮና፤","poem":1},{"text":"ኤንታ ሲን ሸምፖይ ባዋ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ኤንታ መዳይሳትነ","poem":1},{"text":"ኤንታን አማነተይሳት","poem":2},{"lineBreak":true},{"text":"ኡባይ ኤንታዳ ሀኖ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"እስራኤለ አሳዉ ጎዳ ጋላትተ፤","poem":1},{"text":"አሮና ሶ አሳዉ ጎዳ ጋላትተ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ሌወ ሶ አሳዉ ጎዳ ጋላትተ፤","poem":1},{"text":"ጎዳ ያየይሳቶ ኡባይ ጎዳ ጋላትተ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"የሩሳላመን ደእያ ጎዳይ","poem":1},{"text":"ፅዮነን ጋላተቶ!","poem":2},{"lineBreak":true},{"text":"ጎዳ ጋላትተ!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/136.json","nextChapterAudioLinks":{},"previousChap