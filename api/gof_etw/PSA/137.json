፤","poem":2},{"text":"ኤንቲ፥ “ላልተ! ላልተ!","poem":1},{"text":"ህርክ ፃጱዋ ጋካናዉ ላልተ!”","poem":2},"ያግዳይሳ ዶጎፓ።"]},{"type":"verse","number":8,"content":[{"text":"ባብሎነ፥ ኔኒ ያና!","poem":1},{"text":"ኔኒ ኑ ቦላ ኦዳ ኢታ ኦሱዋስ","poem":2},{"lineBreak":true},{"text":"ሀሎ ከሰይስ አንጀትዳይሳ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ነ ጉ ናይታ ኦይክድ፥","poem":1},{"text":"ዛላ ቦላ ሾጨይስ አንጀትዳይሳ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}