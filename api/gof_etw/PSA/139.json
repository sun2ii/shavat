{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_etw","name":"ማዝሙረ ማፃፋ","commonName":"ማዝሙረ ማፃፋ","title":"ማዝሙረ ማፃፋ","order":19,"numberOfChapters":150,"sha256":"0c025deb66520f61a3c823a973fb5df9bd3589998b1748b5e7240ec0298578c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_etw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":139,"content":[{"type":"heading","content":["ታ ዎዛና ፕልጋዳ በአ"]},{"type":"hebrew_subtitle","content":["ዳዊታ ማዝሙረ"]},{"type":"verse","number":1,"content":["ጎዳዉ፥ ኔኒ ታና ፕልጋዳ ኤራዳሳ።"]},{"type":"verse","number":2,"content":[{"text":"ኔኒ ታ ኡተነ ታ ኤቁዋ ኤራሳ፤","poem":1},{"text":"ታ ቆፋ ኡባ ሃሆን አኬካሳ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታኒ ብያ በሳነ ሸምፕያ በሳ ፆሞሳሳ፤","poem":1},{"text":"ታ ኦገታ ኡባ ኤራሳ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ጎዳዉ፥ ታኒ ታ እንፃርሳን","poem":1},{"text":"እስ ቃላ ኦደታናፐ ስን፥","poem":2},{"lineBreak":true},{"text":"ታ ቆፋ ኡባ ኤራሳ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኔኒ ታ ዩሹዋን ደኣሳ፤","poem":1},{"text":"ነ ኩሽያ ታ ቦላ ዎሳ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ነ ኤራተይ ታና ዳሮ ማላልሴስ፤","poem":1},{"text":"ታ አኬካፐ ቃ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታ ነ አያናፐ አዉ ባቃታኔ?","poem":1},{"text":"ነ ስንፈ አዉ ባኔ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ፑደ ሳሎ ከይኮ ነ ያን ደኣሳ!","poem":1},{"text":"ዱገ ስኦለ ዎኮካ ነ ያን ደኣሳ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዶሎሀ ባጋ ፓላዳ ቢኮ፥","poem":1},{"text":"ዎይኮ ዉሎሀ ባጋን ሃካዳ ደእኮ፥","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ያን ነ ኩሸይ ታና ካለስ፤","poem":2},{"lineBreak":true},{"text":"ነ ኡሻቻ ኩሸይ ታና ዘምፕሴስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“ማዉ ታና ገን፤","poem":1},{"text":"ጋላሳዉ ቃማ ላመታ” ግያኮካ፥","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ሳካና ም ነዉ መና፤","poem":2},{"lineBreak":true},{"text":"ቃም ጋላሳዳ ፖኤስ፤","poem":2},{"lineBreak":true},{"text":"ነዉ ም ፖኦ መላ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኔኒ ታ ግዶ አሳተ መዳሳ፤","poem":1},{"text":"ታ አየ ኡሎን ታና ኔኒ ትላዳሳ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኔኒ ታና ማላልስያባነ","poem":1},{"text":"የገልስ ኦዳ መዳ ግሾ፥","poem":2},{"lineBreak":true},{"text":"ታኒ ነና ጋላታይስ።","poem":2},{"text":"ነ ኦሶት ማላልሴስ!","poem":1},{"text":"ታኒ ሄሳ ሎይዳ ኤራይስ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ታኒ ጌማ በሳን መትያ ዎደ፥","poem":1},{"text":"ታ መቀይ ኔፐ ጌምቤና።","poem":2},{"text":"ታ አሳተይ ታ አየ ኡሎን ጪሞ ግዶን","poem":1},{"text":"ሂላን አሌቀትድ ኦሰትያ ዎደ፥","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ነ አይፈት ጊጎና ታ አሳተ በእዶሶና።","poem":2},{"lineBreak":true},{"text":"ቡሮ እሶይካ ዶመቶና ደእሽን፥","poem":2},{"lineBreak":true},{"text":"ነ ታዉ ቡዞይዳ ጋላሳ ኡባይ","poem":2},{"lineBreak":true},{"text":"ነ ማዝጋበን ፃፈትዶሶና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ፆሳዉ፥ ነ ታዉ ቆፕያ ቆፋይ","poem":1},{"text":"ዋንዳ ቦንቾ!","poem":2},{"lineBreak":true},{"text":"ኤንታ ታይቦይ ዋንድ ዳርደ!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ታኒ ኤንታ ታይብያኮ ሻፈፐ ዳሮ፤","poem":1},{"text":"ታኒ ባርክያ ዎደ ሀእካ ኔራ ደአስ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ፆሳዉ፥ ኔኒ ኢታታ ዎያኮ አይበ!","poem":1},{"text":"ሱ ጉስያ አሳት ታፐ ሃኮ!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ኤንቲ ነ ቦላ ኢታባ ሃሳዮሶና፤","poem":1},{"text":"ነ ሞርከት ነ ሱን ኢሶሶና።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ጎዳዉ፥ ነና እፀይሳታ ታ እፅክና?","poem":1},{"text":"ነ ቦላ ደንደይሳታ ታ ሻተትክና?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ታኒ ኤንታ ኩመ እፃይስ፤","poem":1},{"text":"ኤንታ ታኒ ታ ሞርከዳ ታይባይስ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ፆሳዉ፥ ታና ፕልጋዳ ታ ዎዛና ኤራ፤","poem":1},{"text":"ታና ኡንኤዳ ታ ቆፋ በአ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ታናን ኢታባይ ደእኮ ፄላ፤","poem":1},{"text":"መርና ኦግያን ታና ካለ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}