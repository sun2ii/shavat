text":"ሽን ጎዳይ ማንቆት ቆሰትድ አትያ በሰ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እስራኤለስ አቶተ ፅዮነፐ ዬረነ!","poem":1},{"text":"ጎዳይ ኤንታ ዱሳ ዛርያ ዎደ፥","poem":2},{"text":"ያይቆባ ኮቻይ ኡፋይታና፤","poem":1},{"text":"እስራኤለ አሳይ ሀሹ ጋና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}