true},{"text":"ኦላ ጋላስ ታዉ ጎንዳለ ግዳዳሳ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጎዳዉ፥ ኢታታስ ኤንታ አሙዋ እሞፋ፤","poem":1},{"text":"ኤንቲ ኦቶርቶና መላ ኤንታ ማቁዋ ፖልሶፓ። ሳላሀ","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ታ ሞርከታን ታና ፆንሶፓ፤","poem":1},{"text":"ኤንታ ዶናፐ ከይያ ኢታይ","poem":2},{"lineBreak":true},{"text":"ኤንታ ቦላ ስሞ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኤንታ ቦላ ፁግያ ታማ ቦንቆይ ቆለቶ፤","poem":1},{"text":"ኤንቲ ታማ ኦላን የገቶ፤","poem":2},{"lineBreak":true},{"text":"ከያናዉ ዳንዳኦና ኦላ ሆለቶ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዮያማት ቢታ ቦላ ደኦፖ፤","poem":1},{"text":"ቡቀይሳታ ኢታባይ የደድ ኦይኮ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ጎዳይ ማንቆታስ ፕርደይሳነ","poem":1},{"text":"መቶታንቾታስ ሞተተይሳ ኤራይስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ፅሎት ቱማ ነ ሱን ጋላታና፤","poem":1},{"text":"ሱረ አሳት ነ ስንን ዳና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}