{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_etw","name":"ማዝሙረ ማፃፋ","commonName":"ማዝሙረ ማፃፋ","title":"ማዝሙረ ማፃፋ","order":19,"numberOfChapters":150,"sha256":"0c025deb66520f61a3c823a973fb5df9bd3589998b1748b5e7240ec0298578c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_etw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":141,"content":[{"type":"heading","content":["ነ ሀይ ታኮ ዛራ"]},{"type":"hebrew_subtitle","content":["ዳዊታ ማዝሙረ"]},{"type":"verse","number":1,"content":["ጎዳዉ፥ ታኒ ነና ፄጋይስ፤",{"text":"ታና ማዳናዉ ኤለሳ፤","poem":2},{"lineBreak":true},{"text":"ታ ኔኮ ዋስያ ዎደ ታና ስአ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታ ዎሳይ እፃነዳ ነ ስን ሺቆ፤","poem":1},{"text":"ታ ኩሸ ምጨይ ኦማርሳ ያርሾ መላ ግዶ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ጎዳዉ፥ ታ ዶና ናግያ አስ ዎ፤","poem":1},{"text":"ታ መተርሻ ፐንግያ ናጋ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኢታ ኦያ አሳታራ ኢታ ኦና መላ፥","poem":1},{"text":"ታ ዎዛና ኢታኮ ዛሮፓ፤","poem":2},{"lineBreak":true},{"text":"ኤንታ ግብራ ታና ሙዞፓ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ፅሎ አስ ታና ሴሮ፥ ሄስ ታዉ ኬሀተ፥","poem":1},{"text":"እ ታና ሀንቀቶ፥ ሄስ ታ ሁጰን ዛይተ ትዮ መላ።","poem":2},{"text":"ታ ዎዛናይ ሄሳ እፀና፤","poem":1},{"text":"ታ ዎሳይ ኡባ ዎደ ኤንታ ኢታ ኦሱዋ ቦላና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኤንታ ዳይናት አፎ ሆለትያ ዎደ፥","poem":1},{"text":"ታ ቃላይ ቱማ ግደይሳ ኤንቲ ኤራና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኤንቲ፥ “አስ ቢታ ጎየይሳዳነ ጳሻ ላለይሳዳ፥","poem":1},{"text":"ኑ መቀይ ዱፎ ዶናን ላለታና” ያጎሶና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኡባ ሃርያ ጎዳዉ፥","poem":1},{"text":"ታ አይፈይ ነና ፄሌስ።","poem":2},{"text":"ታኒ ኔኮ ባቃታይስ፤","poem":1},{"text":"ታና ሀይቆስ አዳ እሞፋ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኤንቲ ታዉ የግዳ ግትያፐነ","poem":1},{"text":"ኢታ ኦይሳታ ፅህያፐ ታና ናጋ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታኒ ሳሮ አን፥","poem":1},{"text":"ኢታት ባንታ ዎዳ ግትያን ኦይከቶ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}