{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_etw","name":"ማዝሙረ ማፃፋ","commonName":"ማዝሙረ ማፃፋ","title":"ማዝሙረ ማፃፋ","order":19,"numberOfChapters":150,"sha256":"0c025deb66520f61a3c823a973fb5df9bd3589998b1748b5e7240ec0298578c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_etw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":144,"content":[{"type":"heading","content":["ፆሳይ ታዉ ሚፃ"]},{"type":"hebrew_subtitle","content":["ዳዊታ ማዝሙረ"]},{"type":"verse","number":1,"content":["ጎዳይ፥ ታ ዛላይ፥ ጋላተቶ!",{"text":"ታ ኩሽያ ኦላ ታማርሴስ፤","poem":2},{"lineBreak":true},{"text":"ታ ብራታ ቶራስ ጊግሴስ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እ ታ ሲቆ ፆሳነ ታ ቆሰታ አትያ በሰ፤","poem":1},{"text":"ታ ሚፃነ ታና አሸይሳ።","poem":2},{"text":"ታ ጎንዳለነ ታኒ ባቃታዳ አትያ በሰ፤","poem":1},{"text":"እ ካዎተት ታዉ ሃረታና መላ ኦስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ጎዳዉ፥ ኔኒ እያዉ ቆፓናዉ አስ አይቤ?","poem":1},{"text":"ነ ዎዛናን እያዉ በሰ እማናዉ አሳ ናእ አይቤ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አስ እስ ቶሆ ጫርክያ ጫርኮ መላ፤","poem":1},{"text":"እያ ጋላሳት አያ ኩያ መላ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ጎዳዉ፥ ሳሉዋ ጳልቃዳ ዱገ ዎ!","poem":1},{"text":"ደረታ ቦቻ፤ ኤንቲ ጩዮ!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዎልአን የዳዳ ነ ሞርከታ ላላ፤","poem":1},{"text":"ነ ዶንግያ ዪሻን ዱካዳ ኤንታ የደ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ቦላራ ነ ኩሽያ የዳዳ፥","poem":1},{"text":"ታና ዎልቃማ ሃፈ ጎቻዳ ከሳ፤","poem":2},{"lineBreak":true},{"text":"አላጋ አሳታ ኩሸፐ ታና ዎስሳ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኤንቲ ቱማ ሃሳይድ ኤሮኮና፤","poem":1},{"text":"ባንታ ኡሻቻ ኩሽያ ደንድ","poem":2},{"lineBreak":true},{"text":"ዎርዶን ጫቆሶና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ፆሳዉ ታኒ ነዉ ኦራ ማዝሙረ የፃና፤","poem":1},{"text":"ታሙ ሻያን ዋፀትዳ ዲን የፃና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ካዎታስ ፆኖ እማሳ፤","poem":1},{"text":"ነ አይልያ ዳዊታ አሻሳ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታና ኢታ ማሻፈ አሻ፤","poem":1},{"text":"አላጋ አሳታ ኩሸፐ ታና ዎስሳ።","poem":2},{"text":"ኤንታ ዶናይ ዎርዶን፥","poem":1},{"text":"ኤንታ ኡሻቻ ኩሸይ ጭሞን ኩምስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኑ አደ ናይት ባንታ ናአተን፥","poem":1},{"text":"ሎኦ ድጭያ ም መላ ግዶ።","poem":2},{"text":"ኑ ማጫ ናይት ካዎ ጋ አሌቅሳናዉ፥","poem":1},{"text":"ኦሰትዳ ቱቀ መላ ግዶ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኑ ሻለት ዱማ ዱማ ካ ቆሞን ኩሞ፤","poem":1},{"text":"ሄመትያ በሳን ደእያ ኑ ዶርሳት","poem":2},{"lineBreak":true},{"text":"ሙኩላንነ ታሙ ሙኩላን የሎ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኑ ሚዛት ብራይሶ፤","poem":1},{"text":"አዉጫዮና የለትድ ዳሮ፤","poem":2},{"lineBreak":true},{"text":"ኑ ኦገታን ዋሶይ ስኤቶፎ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሀ አንጆት ጋክያ አሳት ቱማ አንጀትዳይሳታ፤","poem":1},{"text":"ፆሳይ ኤንታዉ ጎዳ ግድዳ አሳት አንጀትዳይሳታ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}