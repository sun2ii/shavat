{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_etw","name":"ማዝሙረ ማፃፋ","commonName":"ማዝሙረ ማፃፋ","title":"ማዝሙረ ማፃፋ","order":19,"numberOfChapters":150,"sha256":"0c025deb66520f61a3c823a973fb5df9bd3589998b1748b5e7240ec0298578c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_etw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":146,"content":[{"type":"heading","content":["ካዎታን አማነቶፍተ"]},{"type":"verse","number":1,"content":[{"text":"ጎዳ ጋላትተ!","poem":1},{"text":"ታ ሸምፐ ጎዳ ጋላታ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታ ደኦ ላይ ኡባን ጎዳ ጋላታና፤","poem":1},{"text":"ታ ደእዳ ዎደ ኡባን ታ ፆሳ ሳባና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሀላቃታን አማነቶፍተ፤","poem":1},{"text":"አሻናዉ ዳንዳኦና አሳ ናአን ጬቀቶፍተ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኤንታ ሸምፖይ ከይያ ዎደ ቢታኮ ስሞሶና፤","poem":1},{"text":"ኤንታ ሀልቾይ ኡባይ ሄ ጋላስ አስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ያይቆባ ፆሳይ ማድያ አስነ","poem":1},{"text":"ጎዳ፥ ባ ፆሳን ኡፋይስ ኦያ አስ አንጀትዳይሳ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ጎዳይ ሳሎነ ሳኣ፥","poem":1},{"text":"አባነ እያ ግዶን ደእያ ኡባ መስ፤","poem":2},{"lineBreak":true},{"text":"ፆሳይ መርናዉ አማነቴስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ጎዳይ ኡንኤትዳይሳታስ ፕርዴስ፤","poem":1},{"text":"ኮሻትዳይሳታስ ካ እሜስ፤","poem":2},{"lineBreak":true},{"text":"ጎዳይ ቃሸትዳይሳታ ብርሼስ፤","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጎዳይ ቆቀታ ፄልሴስ።","poem":1},{"text":"ጎዳይ ኩንድዳይሳታ ደንስ፤","poem":2},{"lineBreak":true},{"text":"ጎዳይ ፅሎታ ዶሴስ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ጎዳይ በተ አሳታ ናጌስ፤","poem":1},{"text":"አምኤታነ ይኦ ናይታ ማዴስ፤","poem":2},{"lineBreak":true},{"text":"ሽን ኢታታ ኦግያ ይሴስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ጎዳይ መርናዉ ካዎታና፤","poem":1},{"text":"ፅዮነ፥ ነ ፆሳይ፥","poem":2},{"lineBreak":true},{"text":"የለተፈ የለተ ጋካናዉ ካዎታና።","poem":2},{"lineBreak":true},{"text":"ጎዳ ጋላትተ!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}