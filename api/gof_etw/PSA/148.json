er":8,"content":[{"text":"ዎልአንዉ፥ ሻቻዉ፥ ሻራዉ፥","poem":1},{"text":"ጫጋናዉ፥ እያ ኪታ ፖልያ ጫርኩዋዉ፥","poem":2},{"lineBreak":true},{"text":"ኡባይ እያ ጋላትተ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ደረቶ፥ ዙማቶ፥","poem":1},{"text":"ሜተትያ አይፈ አይፍያ ምቶ፥ ዝጋቶ፥","poem":2},{"lineBreak":true},{"text":"ኡባይ እያ ጋላትተ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"መሄቶ፥ ዶአቶ፥","poem":1},{"text":"ሳአራ ጎሸትያ መተቶ፥","poem":2},{"lineBreak":true},{"text":"ፓልያ ካፎቶ ኡባይ እያ ጋላትተ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ካዎቶ፥ ካዎተቶ፥","poem":1},{"text":"ሀላቃቶ፥ ደርያ ሃረይሳቶ፥","poem":2},{"lineBreak":true},{"text":"ኡባይ እያ ጋላትተ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ፓንቶ፥ ጌላኦቶ፥ ጭማቶ፥ ናይቶ፥","poem":1},{"text":"ኡባይ እያ ጋላትተ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እያ ሱንይ ኡባፈ ቃ ግድያ ግሾነ","poem":1},{"text":"እያ ቦንቾይ ሳሎታፐነ ሳአፐ ቃ ግድያ ግሾ፥","poem":2},{"lineBreak":true},{"text":"ኤንቲ ኡባይ ጎዳ ሱን ጋላቶ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እያዉ ማታ ግድዳ እስራኤለ፥","poem":1},{"text":"እ ቁ ቁ ኦስ፤","poem":2},{"lineBreak":true},{"text":"እያ ጋላታና መላ ኤንታ ምንስ።","poem":2},{"lineBreak":true},{"text":"ጎዳ ጋላትተ!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}