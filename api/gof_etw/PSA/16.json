{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_etw","name":"ማዝሙረ ማፃፋ","commonName":"ማዝሙረ ማፃፋ","title":"ማዝሙረ ማፃፋ","order":19,"numberOfChapters":150,"sha256":"0c025deb66520f61a3c823a973fb5df9bd3589998b1748b5e7240ec0298578c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_etw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":16,"content":[{"type":"heading","content":["ፆሳይ ታ ላታ"]},{"type":"hebrew_subtitle","content":["ዳዊታ ዎሳ"]},{"type":"verse","number":1,"content":["አቤት ፆሳዉ፥",{"text":"ታ ኔኮ ባቃትያ ግሾ ታና ናጋ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታኒ ፆሳ፥ “ኔኒ ታ ጎዳ፤","poem":1},{"text":"ኔፐ አትሽን፥ ሀር ሎኦባይ ታዉ ባዋ” ያጋስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሳአን ደእያ ጌሻት","poem":1},{"text":"አይ መላ ቦንቸትዶና!","poem":2},{"lineBreak":true},{"text":"ታ ኤንታራ እስፈ ኡፋይታይስ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሀራ ፆሳታ ካለይሳት","poem":1},{"text":"ባንታ ቦላ መቶ ዳርሶሶና።","poem":2},{"text":"ሽን ታኒ ሀራ ፆሳታስ ሱ ያርሽከ፤","poem":1},{"text":"ታኒ ኤንታ ሱን ፄግከ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ታ ጎዳዉ ታ ላታይ ነና፤","poem":1},{"text":"ታዉ ኮሽያ ኡባ ታዉ እማሳ፤","poem":2},{"lineBreak":true},{"text":"ታ ደኡዋ ሳማይ ነና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታና ጋክዳ ሳማይ አይ መላ ሎኦ!","poem":1},{"text":"ኤ ታ ላታይ ቱማ ሎኦ!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታና ዞርዳ ጎዳ ጋላታይስ፤","poem":1},{"text":"ቃማ ታ ዎዛናይ ታና ታማርሴስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታኒ ኡባ ዎደ ጎዳ ታ ስንን በአይስ፤","poem":1},{"text":"እ ታ ኡሻቻን ደእያ ግሾ ዳጋምከ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሄሳ ግሾ፥ ታ ዎዛናይ ኡፋይቴስ፤","poem":1},{"text":"ታ እንፃርሳይ ጋላቴስ፤","poem":2},{"lineBreak":true},{"text":"ታ አሳተይ ህርግ ባይና ደኤስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታ ሸምፕዉ ስኦለን አጋካ፤","poem":1},{"text":"ነ ጌሻ ዎቃና መላ ኦካ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታና ደኦ ኦግያ በሳሳ፤","poem":1},{"text":"ነ ስንን ኩመ ኡፋይስ ደኤስ፤","poem":2},{"lineBreak":true},{"text":"ነ ኡሻቻን መርና እንጀይ ደኤስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}