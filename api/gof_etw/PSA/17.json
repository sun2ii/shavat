pe":"verse","number":7,"content":[{"text":"ባንታ ሞርከታፐ ባቃተይሳታ፥","poem":1},{"text":"ነ ኡሻቻ ኩሸን ቆታዳ አሸይሶ፥","poem":2},{"lineBreak":true},{"text":"ነ ኬሀተ ማላልስያ ኦገን በሳ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ነ አይፈ ናኤ መላ ታና ናጋ፤","poem":1},{"text":"ነ ቀፍያ ጋርሳን ታና ቆሳ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ታና ኡንኤያ ኢታታፐ፤","poem":1},{"text":"ተቅድ ኦይክዳ ሞርከታፐ አሻ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኤንታዉ ቃይ ባዋ፤","poem":1},{"text":"ኦቶሮን ሃሳዮሶና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታና ጎድድ ኦይክዶሶና፤ ተቅዶሶና፤","poem":1},{"text":"ታና ቢታን ሆልድ የጋናዉ ፄሎሶና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኤንቲ ምያባ ኮይያ ጋሞ መላ፤","poem":1},{"text":"ቆሰትድ ናግያ ዎዳላ ጋሞ መላ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ጎዳዉ፥ ደንዳ፤","poem":1},{"text":"ታ ሞርከታራ ኤቀታዳ ኤንታ ሳአን የጋ፤","poem":2},{"lineBreak":true},{"text":"ነ ማሻን ኢታታ ኩሸፐ ታና አሻ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ጎዳዉ፥ ሀይሳ መላ አሳፐ ታና ቆሳ፤","poem":1},{"text":"ኤንታ ቃዳይ ሳአባ ግድዳ አሳፐ","poem":2},{"lineBreak":true},{"text":"ነ ኩሸን ታና አሻ።","poem":2},{"text":"ነ ምንጅዳ ሴራን ኤንታ ካልሳ፤","poem":1},{"text":"ሄ ሴራይ ኤንታ ናይታስ ግድድ፥","poem":2},{"lineBreak":true},{"text":"ኤንታ ናይታ ናይታስ ፓላሆ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሽን ታኒ ፅሎተን ነ ሶምኡዋ በአና፤","poem":1},{"text":"ታ ባርክያ ዎደ ነ ማላ በአዳ ኡፋይታና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}