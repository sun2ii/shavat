":20,"content":[{"text":"ታ ፅሎተዳ ጎዳይ ታዉ ቃንፅስ፤","poem":1},{"text":"ታ ኩሸ ጌሻተዳ እ ታዉ ዛርስ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ታኒ ጎዳ ኦግያ ካላስ፤","poem":1},{"text":"ታ ፆሳ አጋዳ ካረ ከያብከ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ታኒ እያ ህግያ ኡባ ናጋስ፤","poem":1},{"text":"እያ ኪታ ፖሎ አጋብከ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ታኒ እያ ስንን ሱረ ደአስ፤","poem":1},{"text":"ታና ናጋራፐ ናጋስ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ጎዳይ ታ ፅሎተዳነ","poem":1},{"text":"ታ ኩሸ ጌሻተዳ ታዉ ዛርስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"አማነተይሳታስ ነ አማነታሳ፤","poem":1},{"text":"ሱረታስ ነ ሱረ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ጌሻታስ ነ ጌሽ፤","poem":1},{"text":"ሽን ጌላታስ ነ ጌላ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"አሽከታ አሻሳ፤","poem":1},{"text":"ሽን ኦቶራንቾታ ካዉሻሳ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"አቤት ጎዳዉ፥ ነ ታዉ ፆምፓሳ፤","poem":1},{"text":"ታ ፆሳይ ታ ማ ፖእሳሳ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ነ ማዱዋን ታ ሞርከ ቶራ ቦላ ደንዳይስ፤","poem":1},{"text":"ታ ፆሳን ሚፃ ፄራራ ጉፓዳ አይስ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ፆሳ ኦገይ ፖሎ፤","poem":1},{"text":"ጎዳ ቃላይ ጌሽ፤","poem":2},{"lineBreak":true},{"text":"እያኮ ባቃትያ ኡባስ እ ጎንዳለ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ጎዳፐ አትሽን፥ ሀራ ፆሲ ኦኔ?","poem":1},{"text":"ኑ ፆሳፈ አትሽን፥ ሀራ ዛል ኦኔ?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ታዉ ዎልቃ እመይነ","poem":1},{"text":"ታ ኦግያ ሳሮ ኦይ ፆሳ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"እ ታ ቶሁዋ ገንኤ ቶሆዳ ምንስ፤","poem":1},{"text":"ቃ በሳን ህርግ ባይና ኤሴስ።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ታ ኩሽያ ኦላ ታማርሴስ፤","poem":1},{"text":"ናሰ ብራታ ዶንግያ ዱካና መላ","poem":2},{"lineBreak":true},{"text":"ታ ቀስያ ምንስ።","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ታና አሽያ ነ ጎንዳልያ ታዉ እማዳሳ፤","poem":1},{"text":"ነ ኡሻቻ ኩሸይ ታና ዘምፕሴስ፤","poem":2},{"lineBreak":true},{"text":"ነ ሎኦ ኦይከይ ታና ግታ