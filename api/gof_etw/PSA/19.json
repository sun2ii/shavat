er":7,"content":[{"text":"ጎዳ ህገይ ሱረ፤","poem":1},{"text":"ሸምፖ ዛሬስ።","poem":2},{"text":"ጎዳ ኪታይ አማነትዳይሳ፤","poem":1},{"text":"አኬክ ፓጭዳይሳታ ጭንጫ ኦስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጎዳ ዎጋይ ልከ፤","poem":1},{"text":"ዎዛና ኡፋይሴስ።","poem":2},{"lineBreak":true},{"text":"ጎዳ ኪታይ ጌሽ፤","poem":2},{"lineBreak":true},{"text":"አይፈ ፖእሴስ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ጎዳስ ያሽ ጌሽ፤","poem":1},{"text":"መርናዉ ኤቅድ ደኤስ።","poem":2},{"lineBreak":true},{"text":"ጎዳ ፕርዳይ ኩመ ቱማነ ፅሎ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዎርቃፈ አድ ኮየቴስ፤","poem":1},{"text":"ዋላህ ባይና ዎርቃፈ አድ ሎኦ።","poem":2},{"text":"ኤሳፈ አድ ሎኦ","poem":1},{"text":"እልሎ ኤሳፈ አድ ማልኦ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ነ አይለይ ናገታና መላ ዞሬስ፤","poem":1},{"text":"ነ ህግያ ናጎይ ዳሮ ጎኤስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ባ ቆሁዋ ደመይ ኦኔ?","poem":1},{"text":"አቤት ጎዳዉ፥ ጌምዳ ናጋራፐ ታና ጌሻ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታና ነ አይልያ፥","poem":1},{"text":"ኤርሸ ኦያ ናጋራፐ ናጋ።","poem":2},{"text":"ናጋር ታና ሃሮና መላ ማዳ፤","poem":1},{"text":"ሄ ዎደ ታኒ ሱረ ግዳና፥","poem":2},{"lineBreak":true},{"text":"ግታ ባላፐ ጌያና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አቤት ጎዳዉ፥ ታ ዛላዉ፥ ታና ዎዘይሶ፤","poem":1},{"text":"ታ ዶናፐ ከይያ ቃላይነ","poem":2},{"lineBreak":true},{"text":"ታ ዎዛና ቆፋይ ነና ኡፋይስያባ ግዶ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}