":1},{"text":"ታ አሳን ካትዳይሳነ ቦረትዳይሳ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታና በእያ ኡባይ ቀልቅሶሶና፤","poem":1},{"text":"ባንታ ሁጵያ ቃሸ ደሬቆሶና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“እ ጎዳን አማነትስ፤ አነ እያ አሾ፤","poem":1},{"text":"ጎዳይ እያ ዶስኮ፥ አነ እያ አሾ” ያጎሶና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ግዶሽን ታኒ ታ አየ ኡሎፐ","poem":1},{"text":"ሱረ የለታናዳ ኦዳይ ነና።","poem":2},{"text":"ታ አየ ን ምያ ዎደካ","poem":1},{"text":"ታና ናግዳይ ነና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታ የለቶሶፐ ዶማዳ ነናን ድጫስ፤","poem":1},{"text":"ታ አየ ኡሎፐ ዶምን ነ ታ ፆሳ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"መቶይ ታኮ ማትያ ግሾነ","poem":1},{"text":"ታና ማድያ አስ ባይና ግሾ፥","poem":2},{"lineBreak":true},{"text":"ሀእ ኔኒ ታፐ ሃኮፋ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዳሮ ሞርከት ቃይጭያ ቦራዳ ታና ተቅዶሶና፤","poem":1},{"text":"ቃይጭያ ባሳነ ኮርማታዳ ታና ኦይክዶሶና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"መንረድ ጉድያ ጋሞዳ","poem":1},{"text":"ባንታ ዶና ታ ቦላ ዶዮሶና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ታኒ ሃዳ ጎጋስ፤","poem":1},{"text":"ታ መቀይ ባ ከሱዋፐ ከይስ፤","poem":2},{"lineBreak":true},{"text":"ታ ዎዛናይ ኦይሳዳ ታ ጋን ትልእስ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ታ ቆይ ኩንአዳ መልስ፤","poem":1},{"text":"ታ እንፃርሳይ ኮቶኑዋራ ኦይከትስ፤","poem":2},{"lineBreak":true},{"text":"ነ ታና ሀይቅዳ አሳዳ ባናን የጋዳሳ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ካናት ታና ተቅዶሶና፤","poem":1},{"text":"ኢታ አሳት ታ ዩሹዋ ኦይክዶሶና፤","poem":2},{"lineBreak":true},{"text":"ታ ኩሸታነ ታ ቶሆታ ጫዶሶና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ታ መቀት ታይበቶሶና፤","poem":1},{"text":"ታ ሞርከት ታና ደሬቆሶና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ታ ማኡዋ ሻክድ ኤኮሶና፤","poem":1},{"text":"ታ አዱሳ ማኡዋ ቦላ ሳማ የጎሶና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ታ ጎዳዉ፥ ነ ታ ማታይ ታፐ ሃኮፋ፤","poem":1},{"text":"ታ ዎልቃዉ፥ ታና ማዳናዉ ኤለሳዳ ሃያ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ታና ማሻፈ ከሳ ኤካ፤","poem":1},{"text":"ታ አልኦ