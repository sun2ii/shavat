text":"ዛሪድ ኤንታ ኬፀና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታ ዎሳ ስእዳ ግሾ","poem":1},{"text":"ጎዳይ ጋላተቶ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ጎዳይ ታዉ ዎልቃነ ጎንዳለ፤","poem":1},{"text":"ታ ዎዛናይ እያን አማነቴስ፤","poem":2},{"lineBreak":true},{"text":"ታ እያን ማደታስ።","poem":2},{"text":"ታ ዎዛናይ እያን ኡፋይቴስ፤","poem":1},{"text":"ታ እያ ማዝሙረን ሳባና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጎዳይ ባ አሳስ ዎልቃ፤","poem":1},{"text":"ባ ዶርድ ካዋ አሽያ ሚፃ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ጎዳዉ፥ ነ አሳ አሻ፤","poem":1},{"text":"ነባ ግድዳይሳታ አንጃ።","poem":2},{"text":"ኤንታ ሄመይ ነና ግዳ፤","poem":1},{"text":"ኤንታ መርናዉ ቶካ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}