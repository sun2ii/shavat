umber":7,"content":[{"text":"አቤት ጎዳዉ፥ ነ ታዉ ኬህዳ ዎደ፥","poem":1},{"text":"ዙማዳ ታና ምንዳ ኤሳዳሳ።","poem":2},{"text":"ሽን ነ ሶምኡዋ ሀራ ሶ ዛርዳ ዎደ፥","poem":1},{"text":"ታ ዳጋማስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አቤት ጎዳዉ፥ ታ ነና ፄጋስ፤","poem":1},{"text":"ነና ማሮታ ዎሳስ፤","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“ታ ዱፎ ገልኮ ነና አይ ጎኢ?","poem":1},{"text":"ቢታ ግዶ ገልዳ አስ","poem":2},{"lineBreak":true},{"text":"ዋትድ ነና ጋላታናዉ ዳንዳኢ?","poem":2},{"lineBreak":true},{"text":"ነ አማነተ ዋትድ ማርካታኔ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አቤት ጎዳዉ፥ ነ ታና ስአ፤","poem":1},{"text":"ታዉ ቃታ።","poem":2},{"lineBreak":true},{"text":"አቤት ጎዳዉ፥ ነ ታዉ ማዶ ግዳ” ያጋስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታ ዬሁዋ የን ላማዳሳ፤","poem":1},{"text":"ካዮ ማኡዋ ታፐ ቃራዳ፥","poem":2},{"lineBreak":true},{"text":"ታና ኡፋይስ ማይዛዳሳ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሄሳ ግሾ፥ ታ ነና ሳባና፤ ስእ ጊከ።","poem":1},{"text":"አቤት ጎዳዉ፥ ታ ፆሳዉ፥ ታ ነና መርናዉ ጋላታና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}