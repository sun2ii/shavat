"type":"verse","number":7,"content":[{"text":"ታ መቱዋነ ታ ኡንአ ነ በእዳ ግሾ","poem":1},{"text":"ታኒ መርናዉ ነ ሲቁዋን ኡፋይታና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ነ ታና ሞርከ ኩሸን አዳ እማባካ፤","poem":1},{"text":"ታ ቶሆታ ዳልጋ በሳን ኤሳዳሳ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አቤት ጎዳዉ፥ ታኒ መቶን ገልዳ ግሾ ታዉ ቃታ፤","poem":1},{"text":"ታ ዳሮ አዛንዳ ግሾ ታ አይፈይ ሙልጫትስ፤","poem":2},{"lineBreak":true},{"text":"ታ አሾይነ ታ ሸምፖይ ዳቡርስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታ ደኦይ አዛኖን፥ ታ ላይይ ኦለን ዉርስ፤","poem":1},{"text":"ዋየ ዳሮተን ታ ዎልቃይ ዉርስ፤","poem":2},{"lineBreak":true},{"text":"ታ መቀት አርጋጭዶሶና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታ ሞርከታ ኡባስ ቅስ አታስ፤","poem":1},{"text":"ታ ሾሮታስ ዬላ ግዳስ።","poem":2},{"text":"ታ ላገታስ ዳጋንያባ ግዳስ፤","poem":1},{"text":"ታና በኤይሳት ታፐ ሃክዶሶና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ታ ሀይቅዳ አሳዳ ዶገታስ፤","poem":1},{"text":"መቃ ሚሸዳ ዎራ የገታስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታኒ ዳሮታ ካልካሻ ስአስ፤","poem":1},{"text":"ኡባ በሳራ ዳጋም ደኤስ።","poem":2},{"text":"ኤንቲ ታ ቦላ ቶቦሶና፤","poem":1},{"text":"ታና ዎናዉ ማቀቶሶና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሽን ጎዳዉ፥ ታ ነናን አማነታና፤","poem":1},{"text":"ኔኒ ታ ፆሳ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ታ ደኦ ላይይ ነ ኩሽያና፤","poem":1},{"text":"ታና የደያ ታ ሞርከታ ኩሸፐ አሻ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ነ አይልያ ቦላ ነ ሶምኡዋ ፖእሳ፤","poem":1},{"text":"ነ ማሮተን ታና አሻ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አቤት ጎዳዉ፥ ታ ነና ፄግያ ግሾ፥","poem":1},{"text":"ታና ዬላዮፓ።","poem":2},{"text":"ሽን ኢታት ዬላቶ፤","poem":1},{"text":"ዱፎን ገልድ ስእ ጎ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ኦቶሮንነ ቦረን ፅሎታ ቦላ","poem":1},{"text":"ምንድ ሃሳያ ግሾ፥","poem":2},{"lineBreak":true},{"text":"ኤንታ ዎርዶ እንፃርሳ ስእ ኦ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ነና ያየይሳታስ ነ ምንጅዳ፥","poem":1},{"text":"ኔኮ ባቃተይሳታስ ነ ጊግስዳ፥","poem":2},{"lineBreak":true},{"text":"ኬሀተይ አይ መላ ዳሮ!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ኔኒ ኤንታ ነ ስንን፥ ጌማ በሳን ገን ዎዳሳ፤","poem":1},{"text":"አሳ ኢታ ማቁዋፈ አሻሳ፤","poem":2},{"lineBreak":true},{"text":"ኢታ እንፃርሳፈ ነ ዱንካንያን ቆሳዳሳ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሞርከይ ተቅዳ ካታማ ግዶን፥","poem":1},{"text":"ማላልስያ ባ ማሮተ ታና በስዳ፥","poem":2},{"lineBreak":true},{"text":"ጎዳይ ጋላተቶ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ታ ዳጋማዳ፥ “ነ ስንፈ ሃካስ” ጋስ፤","poem":1},{"text":"ሽን ታ ማዶ ኮያዳ ኔኮ ዋስዳ ዎደ፥","poem":2},{"lineBreak":true},{"text":"ታ ዋሱዋ ነ ስአዳሳ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ህንተኖ፥ ፆሳ አሳዉ፥ ጎዳ ዶስተ፤","poem":1},{"text":"ጎዳይ አማነተይሳታ ናጌስ፤","poem":2},{"lineBreak":true},{"text":"ሽን ኦቶራንቾታስ ኤንታ ጋትያ ቃንፄስ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ህንተኖ፥ ጎዳን ኡፋይስ ኦይሳቶ፥","poem":1},{"text":"ምንተ፤ ገንጭተ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}