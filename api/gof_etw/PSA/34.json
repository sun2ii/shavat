8,"content":[{"text":"ጎዳይ ኬሀ ግደይሳ ላጭድ በእተ፤","poem":1},{"text":"እያኮ ባቃትያ አስ አንጀትዳይሳ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ህንተኖ፥ ጌሻ አሳዉ፥ ጎዳስ ያይተ፤","poem":1},{"text":"እያዉ ያየይሳታስ አይኮይካ ፓጨና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ጋሞት ምያባ ይድ ኮሻቶሶና፤","poem":1},{"text":"ሽን ጎዳ ኮየይሳታስ ሎኦባይ ፓጨና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ናይቶ፥ ሃ ዪተ፤ ስእተ፤","poem":1},{"text":"ታ ህንተና ጎዳ ያሽ ታማርሳና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሎኦ ደኦ ዳናዉነ","poem":1},{"text":"ኬሀባ በአናዉ አዱሳ ላይ ዳናዉ፥","poem":2},{"lineBreak":true},{"text":"አሞተይ ኦኔ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ነ እንፃርሳይ ኢታባ ኦደቶናዳ፥","poem":1},{"text":"ነ ዶናይ ጭሞናዳ ተቃ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኢታፐ ሃካ፤ ሎኦባ ኦ፤","poem":1},{"text":"ሳሮተ ኮያ፤ ካላ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ጎዳ አይፈይ ፅሎታ ፄሌስ፤","poem":1},{"text":"እያ ሀይይ ኤንታ ዋሱዋ ስኤስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኤንታ ቆፍስያባ ቢታፈ ይሳናዉ፥","poem":1},{"text":"ጎዳይ ኢታ ኦይሳታ ባ ሀንቆ አይፈን ፄሌስ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ፅሎት ዋሶሶና፤","poem":1},{"text":"ጎዳይ ኤንታ ዋሱዋ ስኤስ፤","poem":2},{"lineBreak":true},{"text":"እ ኤንታ መቶ ኡባፈ አሼስ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዎዛን መቅዳይሳታስ ጎዳይ ማታና፤","poem":1},{"text":"እ ኡፋይስ ቃንፅዳይሳታ አሼስ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ፅሎ አሳስ መቶይ ዳሮ፤","poem":1},{"text":"ሽን ጎዳይ እያ ሄ ኡባፈ አሼስ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ጎዳይ እያ መቀታ ናግያ ግሾ፥","poem":1},{"text":"ኤንታፈ እሶይካ መቀና።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ኢታታ ኤንታ ኢታተይ ዎና፤","poem":1},{"text":"ፅሎታ እፀይሳት ፕርደታና።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ጎዳይ ባ አይለታ ዎዜስ፤","poem":1},{"text":"እያኮ ባቃትያ ኦንካ ፕርደተና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/35.json","nextChap