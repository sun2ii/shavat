,{"type":"verse","number":8,"content":[{"text":"ኤሮና ደእሽን ኤንታ ቦላ ዮይ ዮ፤","poem":1},{"text":"ኤንቲ ዎዳ ፅሄይ ኤንታ ኦይኮ፤","poem":2},{"lineBreak":true},{"text":"ኤንቲ ቦክዳ ኦላን ኩንድድ ዮ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሄ ዎደ ታኒ ጎዳን ኡፋይታና፤","poem":1},{"text":"እ አሽዳ ግሾ ሀሹ ጋና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታ ኩመ አሳተይ ነና፥","poem":1},{"text":"“ጎዳዉ፥ ነ መል ኦኔ?","poem":2},{"text":"ማንቁዋ ዎልቃማ ኩሽያፐ ከሳ ኤካሳ፤","poem":1},{"text":"መቶታንቹዋነ ኡንኤትዳይሳ፥","poem":2},{"lineBreak":true},{"text":"ቦንቀይሳታ ኩሸፐ አሻሳ” ያጋና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዎርዶ ማርካተይሳት ታ ቦላ ደንዶሶና፤","poem":1},{"text":"ታ ኤሮናባን ታና ሞቶሶና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ታ ሎኦ ኦዳ ግሾ ኢታ ዛርዶሶና፤","poem":1},{"text":"ታና ብዛ ኦዶሶና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሽን ኤንቲ ሀርግዳ ዎደ ታኒ ካዮ ማኦ ማአስ፤","poem":1},{"text":"ታ አሳተ ፆማን ዳቡርሳስ፤","poem":2},{"lineBreak":true},{"text":"ታ ዎሳይ ዛሮ ደሞና አትስ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ታና ካዉሻዳ","poem":1},{"text":"ዳቦስ ዎይኮ እሻስ ዬከይሳዳ ዬካስ።","poem":2},{"text":"እስ አስ ባ አየስ ካዮተይሳዳ","poem":1},{"text":"ታ ሁጵያ ኦይካዳ ዬካስ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሽን ታኒ በትዳ ዎደ ኡፋይትድ ሺቅዶሶና፤","poem":1},{"text":"ጋሶይ ባይና ታና ዋድ፥","poem":2},{"lineBreak":true},{"text":"አጎና እፅዶሶና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኢታ አሳት ኦይሳዳ ኤንቲ ታና ቀልቅስዶሶና፤","poem":1},{"text":"ይሎትድ ባንታ አቻ ጋርጭዶሶና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ጎዳዉ፥ ኔኒ አዉደ ጋካናዉ፥","poem":1},{"text":"ስእ ጋዳ ፄላይ?","poem":2},{"text":"ኤንታ ኢታ ኦሱዋፐ ታና አሻ፤","poem":1},{"text":"ታ አልኦ ሸምፑዋ ሀ ጋሞታፐ ዎስሳ ኤካ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሄ ዎደ ግታ ሺቆን ታ ነና ጋላታና፤","poem":1},{"text":"ዳሮ አሳይ ደእያ በሳን ነና ቦንቻና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ጋሶይ ባይና ታና ሞርከይሳት ኡፋይቶፎ፤","poem":1},{"text":"ታና ጮ እፀይሳት ታ ቦላ ቃምኦቶፖ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ኤንቲ ሳሮባ ሃሳዮኮና፤","poem":1},{"text":"ስእ ግድ ደእያ አሳ ቦላ ኦዳ ፃፆሶና።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ኤንቲ ባንታ ዶና ታ ቦላ ዶይድ፥","poem":1},{"text":"“ሀይሳ በአ፥ ነ ኦዳይሳ","poem":2},{"lineBreak":true},{"text":"ኑኒ ኑ አይፈን በእዳ” ያጎሶና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ጎዳዉ፥ ኔኒ ሄሳ በአዳሳ፤","poem":1},{"text":"ስእ ጎፓ።","poem":2},{"lineBreak":true},{"text":"ጎዳዉ፥ ታፐ ሃኮፋ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ታ ፆሳዉ፥ ታ ጎዳዉ ታ ግሾ፥","poem":1},{"text":"ደንዳ፤ ባርካ፤","poem":2},{"lineBreak":true},{"text":"ታ ዶና ግዳዳ ሞተታ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ታ ጎዳዉ፥ ታ ፆሳዉ፥ ፅሎተን ታዉ ፕርዳ፤","poem":1},{"text":"ታ ሞርከታ ኡፋይሶፋ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ኤንቲ ባንታ ዎዛናን፥ “ሀሹ፥ ኑ አሞይ ፖለትስ፤","poem":1},{"text":"ኑኒ እያ ምትዳ” ጋና መላ ኦፋ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ታ ዋያን ኡፋይተይሳት፥ ዬላቶ፥ ካዉዮ፤","poem":1},{"text":"ታ ቦላ ጬቀተይሳት ዬላነ ካዉሸ ማኦ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ታ ፆኑዋ ዶሰይሳት ኡፋይቶ፤","poem":1},{"text":"እልሎ፤ ሀሹ ያጎ።","poem":2},{"text":"“ኡባ ዎደ ባ አይልያ ሳሮተን፥","poem":1},{"text":"ኡፋይትያ ጎዳይ ቁ ቁ ጎ” ያጎ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ታ እንፃርሳይ ነ ፅሎተነ ነ ጋላታ፥","poem":1},{"text":"ጋላሳ ኩመን ኦዴስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}