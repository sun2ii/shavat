xt":"አሳይ ነ ቀፍያ ጋርሳን ቆሰትድ አቴስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኤንቲ ነ ግብራፐ ምድ ካሎሶና፤","poem":1},{"text":"ነ ኬሀተ ሻፋፐ ኡይድ አሎሶና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ደኦ ፑልቶይ ኔፐ ከዬስ፤","poem":1},{"text":"ነ ፖኡዋን ኑኒ ፖኦ በኦስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ነና ኤረይሳታስ ነ ሲቆይ፥","poem":1},{"text":"ዎዛና ሱረታስ ነ ፅሎተይ ቃንፀተና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኦቶራንቾታ ቶሆይ ታና የፎ፤","poem":1},{"text":"ናጋራንቾታ ኩሸይ ታና የደፎ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኢታ አሳታ ኩንደ በእተ፤","poem":1},{"text":"ኤንቲ ኩንድዶሶና፤ ደንዳናዉ ዳንዳኦኮና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}