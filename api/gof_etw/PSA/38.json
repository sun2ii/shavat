erse","number":9,"content":[{"text":"አቤት ጎዳዉ፥ ታ ዎዛና አሞ ኡባ ኤራሳ፤","poem":1},{"text":"ታ ኦለይ ኔፐ ጌምቤና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታ ዎዛናይ ድርጌስ፤","poem":1},{"text":"ታ ዎልቃይ ህት ግስ፤","poem":2},{"lineBreak":true},{"text":"ታ አይፍያ ፖኦይ ይስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታ ማዱን ጋሶን","poem":1},{"text":"ታ ሾሮትነ ታ ላገት ሃክድ ኤቅዶሶና፤","poem":2},{"lineBreak":true},{"text":"ታ ዳቦት ታፐ ሃክዶሶና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ታና ዎናዉ ኮየይሳት","poem":1},{"text":"ባንታ ፅህያ ታዉ የጎሶና።","poem":2},{"text":"ታና ቆሀናዉ ኮየይሳት፥","poem":1},{"text":"“ኑ ነና ደማና” ያግድ ማንዶሶና","poem":2},{"lineBreak":true},{"text":"ጋላስ ኩመ ታ ቦላ ቶቦሶና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታ ቱለ አሳ መላ ስእከ፤","poem":1},{"text":"ሙመ አሳ መላ ዶና ፖግከ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ቱማ ሀይ ስኦና አስ፥","poem":1},{"text":"እንፃርስ ኦድድ ዛሮና አስ ግዳስ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ጎዳዉ፥ ታ ነና ኡፋይሳን ናጋይስ፤","poem":1},{"text":"ታ ጎዳዉ፥ ፆሳዉ ነ ታዉ ዛሮ እማ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ታኒ፥ “ታ ቶሆይ በትን፥","poem":1},{"text":"ኤንቲ ሀሹ ጋናዳነ","poem":2},{"lineBreak":true},{"text":"ታ ቦላ ጬቀታናዳ ኦፋ” ያጋስ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ታ ኩንዳና ሀናይስ፥","poem":1},{"text":"ታ ሳኮይ ታና አጎና እፅስ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ታ ናጋራ ፓፃይስ፤","poem":1},{"text":"ታ ናቁዋ ጋሶን አዛናይስ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ታ ሞርከት ግታነ ዎልቃማ፤","poem":1},{"text":"ታና ጮ እፀይሳት ዳሮ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ታኒ ሎኦባ ኦን ኢታ ዛረይሳት፥","poem":1},{"text":"ታ ሎኦባ ካልያ ግሾ ታራ ኤቀቶሶና።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ጎዳዉ፥ ታና የጎፋ፤","poem":1},{"text":"ታ ፆሳዉ፥ ታፐ ሃኮፋ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ታና አሽያ ታ ጎዳዉ፥","poem":1},{"text":"ታና ማዳናዉ ኤለሳ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApi