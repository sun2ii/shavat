e},{"text":"ካረ ከይድ ታ ሱን ኢሴስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ታና እፅያ ኡባይ እስፈ ታና ዝግሮሶና፤","poem":1},{"text":"ኢታባይ እያ ጋኬስ ግድ ቆፖሶና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“እያ ኢታ ሀርገይ ኦይክስ፤","poem":1},{"text":"እ ህዛ ሂፃፐ ደንደና” ያጎሶና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሀር አቶሽን ታ አማነትያ ላገይ፥","poem":1},{"text":"ታራ ምዳይስ ታዉ ዞኮ ዛርስ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ሽን ጎዳዉ ታና ማራ፤","poem":1},{"text":"ታ ኤንታዉ ኩሸ ዛራና መላ፥","poem":2},{"lineBreak":true},{"text":"ሀርገ ሂፃፐ ታና ደን።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታ ሞርከይ ታና ፆኖና ግሾ፥","poem":1},{"text":"ነ ታናን ኡፋይታናይሳ ታ ኤራይስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ነ ታና ታ ሱረተ ግሾ ካትሳሳ፤","poem":1},{"text":"ነ ስንን ታና መርናዉ ዎሳ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ጎዳይ፥ እስራኤለ ፆሳይ፥","poem":1},{"text":"መርናፐ መርና ጋካናዉ ጋላተቶ።","poem":2},{"lineBreak":true},"አምንእ! አምንእ!"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}