"type":"verse","number":6,"content":[{"text":"ታ ዎዛናይ አዛንስ፤","poem":1},{"text":"ሄሳ ግሾ ታኒ ዮርዳኖሰ ቢታን፥","poem":2},{"text":"አርሞና ቃን፥ ምዛረ ዙማን፥","poem":1},{"text":"ኤቃዳ ነና ቆፓና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ነ ሶሱዋ ጉንን ጪሞይ ጪሙዋ ፄጌስ፤","poem":1},{"text":"ነ ቤታይነ ነ ዙለይ ታ ቦላራ አስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጎዳይ ባ ሲቁዋ ጋላስ ታዉ ኪቴስ፤","poem":1},{"text":"ቃማ ጋላታ የይ ታራ ደኤስ፤","poem":2},{"lineBreak":true},{"text":"ታ ደኦ ፆሳ ዎሳና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ፆሳ፥ ታ ዛላኮ፥","poem":1},{"text":"“ታና አይስ ዶጋዲ?","poem":2},{"text":"ታ ሞርከት ታና ኡንኤን፥","poem":1},{"text":"ዬካሸ አይስ ሄመቶ” ያጋና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታ ሞርከት፥ “ነ ፆሳይ አዉን ደኢ?”","poem":1},{"text":"ያግድ ጫይያ ዎደ ታ መቀይ መቄስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታ ሸምፐ አይስ አዛናይ?","poem":1},{"text":"አይስ ኡንኤታይ?","poem":2},{"text":"ፆሳን ኡፋይስ ዎ፤","poem":1},{"text":"ታና አሽያ፥ ታ ፆሳ ታ ቡሮ ጋላታና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}