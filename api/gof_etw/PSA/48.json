},{"type":"verse","number":8,"content":[{"text":"ኑ ስእዳይሳዳ፥","poem":1},{"text":"ኡባፈ ዎልቃማ ጎዳ ካታማን፥","poem":2},{"lineBreak":true},{"text":"ኑ ፆሳ ካታማን እ ኦዳባ በእዳ፤","poem":2},{"lineBreak":true},{"text":"ፆሳይ ሄ ካታማ መርናዉ ምንድ ናጌስ። ሳላሀ","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አቤት ፆሳዉ፥ ነ ኬን","poem":1},{"text":"መርና ነ ሲቁዋ ቆፖስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አቤት ፆሳዉ፥ ነ ሱንዳ","poem":1},{"text":"ነ ጋላታይ ሳኣ ጋፃ ጋክስ፤","poem":2},{"lineBreak":true},{"text":"ነ ኡሻቻ ኩሸይ ፅሎተን ኩምዳይሳ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ነ ፕርዳ ጋሶን ፅዮነ አሳይ ኡፋይቶ፤","poem":1},{"text":"ይሁዳ ኩመይ ኡፋይሳን እልሎ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ፅዮነ ዩሹዋን ሄመትተ፤","poem":1},{"text":"እ ድርሳ ዩይተ እ ሻኮታ ታይብተ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ያ የለታስ ኦዳና መላ","poem":1},{"text":"እያ ግምብያ አኬክተ፤ ሚፃታ ዎችተ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ህንተ፥ “መርናዉ ፆሳይ ኑ ፆሳ፤","poem":1},{"text":"እ ኑና ሀይቃና ጋካናዉ ካለና” ያግድ ኦድተ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}