true},{"text":"ፆሳስ ቃንፃናዉ ዳንዳኤና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አሳ ሸምፖ ጋተይ ዳሮ አልኦ፤","poem":1},{"text":"አይ ጋተ ቃንፅንካ ግደና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እ ሀይቆናዳነ ዱፎ ገሎናዳ፥","poem":1},{"text":"ዎይኮ እ ሀይቆናዳ ኦናዉ ጋከና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኤያትነ ፓና አሳት ሀይቀይሳዳ፥","poem":1},{"text":"ጭንጫት ባንታ ሻሉዋ","poem":2},{"lineBreak":true},{"text":"ሀራታስ የግድ በይሳ አሳ ኡባይ በኤስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኤንቲ ባንታ ቢታ ባንታባ ጊኮካ፥","poem":1},{"text":"ዱፎይ መርናዉ ኤንታዉ ኬ ግዳና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አስ አይ ግታትኮካ ባ ግታተራ ካንና፤","poem":1},{"text":"እ ዶአዳ ሀይቄስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ባንታርካ ባንታ ሁጰን አማነተይሳታ ቃዳይነ","poem":1},{"text":"ኤንቲ ግዳባ ቱማ ግያ ኤያታ ዉርሰይ ሀይሳ። ሳላሀ","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሹካስ ጊገትዳ ዶርሳታዳ፥","poem":1},{"text":"ሀይቆይ ኤንታ ዱፎ ካለስ።","poem":2},{"text":"ሱረት ኤንታ ዱፉዋ ቦላራ ሄመታና፤","poem":1},{"text":"ኤንታ አሳተይ ዱፎን ዎቃና፤","poem":2},{"lineBreak":true},{"text":"ኬፈ ከይድ ሃክድ ስኦለን አታና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሽን ፆሳይ ታ ሸምፑዋ ዎዛና፤","poem":1},{"text":"እ ታና ሀይቆ ዎልቃፈ አሻና። ሳላሀ","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አስ ዱረትያ ዎደነ","poem":1},{"text":"እያ ቦንቾይ ዳርያ ዎደ ያዮፋ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እ ሀይቅያ ዎደ አይኮካ ኤክድ ቤና፤","poem":1},{"text":"እያ ሻሎይ እያራ እስፈ ዱፎ ገለና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"አስ ፓፃ ደእያ ዎደ ታዉ ኩምስ ጊኮ፥","poem":1},{"text":"ኡባባይ እያዉ እንጀትዳ ግሾ ጋላተትኮካ፥","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ስሚድ ፖኦ በኦና፥","poem":2},{"lineBreak":true},{"text":"ባ ማይዛታን ጋሄቴስ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ኤራተ ባይና ዱረትዳ አስ","poem":1},{"text":"ዶአዳ ጮ ያና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/50.json","nextChapterAu