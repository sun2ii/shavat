{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_etw","name":"ማዝሙረ ማፃፋ","commonName":"ማዝሙረ ማፃፋ","title":"ማዝሙረ ማፃፋ","order":19,"numberOfChapters":150,"sha256":"0c025deb66520f61a3c823a973fb5df9bd3589998b1748b5e7240ec0298578c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_etw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":5,"content":[{"type":"heading","content":["ዎንታ ዎሳ"]},{"type":"hebrew_subtitle","content":["ዛማረታ ሀላቃስ ፃፈትዳ ዳዊታ ማዝሙረ"]},{"type":"hebrew_subtitle","content":["ሱሱልኤን የፀትያ ማዝሙረ"]},{"type":"verse","number":1,"content":["አቤት ጎዳዉ፥ ታ ቃላ ስአ፤",{"text":"ታ ኦልያ ቆፓ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታ ካዋዉ፥ ታ ፆሳዉ ታ ዋሱዋ ስአ፤","poem":1},{"text":"ታ ማደ ኮያዳ ዎስያ ዎሳ ሀይዛ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አቤት ጎዳዉ፥ ዎንታ ዎንታ","poem":1},{"text":"ታ ቃላ ስኣሳ።","poem":2},{"text":"ዎንታ ዎንታ ታ ዎሳ ነ ስን ሺሻይስ፤","poem":1},{"text":"ታ ነ ዛሩዋ ናጋይስ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኔኒ ኢታተን ኡፋይቶና ፆሰ፤","poem":1},{"text":"ኢታባይ ኔራ ዴና።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኦቶራንቾት ነ ስንን ኤቆኮና፤","poem":1},{"text":"ኢታባ ኦያ ኡባ ነ እፃሳ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዎርዶ ኦደተይሳታ ነ ይሳሳ፤","poem":1},{"text":"ጎዳይ ሱ ጉሰይሳታነ","poem":2},{"lineBreak":true},{"text":"ጭመይሳታ እፄስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሽን ታ ነ ግታ ማሮተን ነ ኬ ገላና፤","poem":1},{"text":"ነ ጌሻ በሳኮ ስማዳ ነና ቦንቾን ጎይናና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አቤት ጎዳዉ፥ ታ ሞርከታ ግሾ ጋዳ፥","poem":1},{"text":"ታና ነ ፅሎተን ካለ፤","poem":2},{"lineBreak":true},{"text":"ነ ኦግያ ታ ስንን ሱርሳ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኤንታ መተርሻን ቱም ባዋ፤","poem":1},{"text":"ኤንታ ዎዛናን ይሶይ ኩምስ።","poem":2},{"text":"ኤንታ ዶናይ ዶየትዳ ዱፎ መላ፤","poem":1},{"text":"ኤንቲ ባንታ እንፃርሳን ጭሞሶና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኤንቲ ነ ቦላ ማካልዳ ግሾ፥","poem":1},{"text":"አቤት ፆሳዉ፥ ኤንታ ፕርዳ፤","poem":2},{"text":"ኤንታ ቶባይ ኤንታ ኤክድ ቦ፤","poem":1},{"text":"ኤንታ ዳሮ ናጋራ ግሾ ኤንታ የደ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሽን ኔኮ ባቃትድ አትዳ ኡባይ ኡፋይቶ፤","poem":1},{"text":"ኤንቲ መርናዉ ኡፋይሳን የፆ።","poem":2},{"text":"ነ ሱን ዶስያ ኡባይ ነናን ኡፋይታና መላ፤","poem":1},{"text":"ኔኒ ኤንታ መርናዉ ናጋ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አቤት ጎዳዉ፥ ኔኒ ፅሎታ አንጃሳ፤","poem":1},{"text":"ጎንዳለን አሸይሳዳ ነ ኬሀተን እያ አሻ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}