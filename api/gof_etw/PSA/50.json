{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_etw","name":"ማዝሙረ ማፃፋ","commonName":"ማዝሙረ ማፃፋ","title":"ማዝሙረ ማፃፋ","order":19,"numberOfChapters":150,"sha256":"0c025deb66520f61a3c823a973fb5df9bd3589998b1748b5e7240ec0298578c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_etw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":50,"content":[{"type":"heading","content":["ፆሳይ ቱማ ዳይና"]},{"type":"hebrew_subtitle","content":["አሳፋ ማዝሙረ"]},{"type":"verse","number":1,"content":["ዎልቃማ ጎዳይ፥ ፆሳይ ኦዴስ፤",{"text":"ዶሎሀፐ ዉሎሀ ጋካናዉ ቢታ ኡባ ፄጌስ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"መን ፖሎ የገልስ ግድዳ","poem":1},{"text":"ፅዮነፐ ፆሳይ ፖኤስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኑ ፆሳይ ያና፤ ስእ ጌና፤","poem":1},{"text":"ኤፅያ ታማይ እያ ስንና፤","poem":2},{"lineBreak":true},{"text":"ዎልቃማ ጎተይ እያ ዩሹዋና።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ፆሳይ ባ አሳ ፕርድያ ዎደ፥","poem":1},{"text":"ሳሎታነ ሳኣ ፄጌስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“ያርሾን ታራ ጫቅዳ፥","poem":1},{"text":"ታ ጌሻታ ታኮ ሺሽተ” ያግስ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ፆሳይ ፕርድያ ግሾ፥","poem":1},{"text":"ሳሎት እያ ፅሎተ አዋጆሶና። ሳላሀ","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“ታ አሳዉ፥ ስእተ፤ ታ ህንተዉ ኦዳይስ፤","poem":1},{"text":"እስራኤለ አሳዉ፥ ታ ነ ቦላ ማርካታና፤","poem":2},{"lineBreak":true},{"text":"ታኒ ፆሳይ፥ ነ ፆሳ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ነ ያርሹዋ ግሾነ","poem":1},{"text":"ነ ፁሳ ያርሹዋ ግሾ፥","poem":2},{"lineBreak":true},{"text":"ነና ቦርከ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ነ ዳራፐ ኮርማታ፥","poem":1},{"text":"ነ ግርብያፈ ኮለ ኤካናዉ ኮይከ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዎራን ደእያ ዶአት ኡባይ ታባ፤","poem":1},{"text":"ሙኩሉ ዙማ ቦላ ደእያ መሄትካ ታሳ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታኒ ቃ ደርያን ደእያ ካፎታ ኡባ ኤራይስ፤","poem":1},{"text":"ደንባን ደእያ መተት ታይሳታ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ታና ኮሻይኮካ ነና ኦይችከ፤","poem":1},{"text":"ሳእነ ሳአን ኩምዳባ ኡባይ ታባ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታኒ ኮርማታ አሹዋ ማይናዬ?","poem":1},{"text":"ዎይኮ ዴሻታ ሱ ኡያናዬ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ፆሳስ ጋላታ ያርሾ እማ፤","poem":1},{"text":"ኡባፈ ቃ ፆሳስ ነ ቃንገ ጋ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"መቶ ጋላስ ታና ፄጋ፤","poem":1},{"text":"ታ ነና አሻና፤ ነካ ታና ቦንቻና” ያጌስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሽን ፆሳይ ኢታ አሳ ሀይሳዳ ያጌስ፤","poem":1},{"text":"“ታ ህግያ ነ ናባባናዉ ነዉ አይ ማት ደኢ?","poem":2},{"lineBreak":true},{"text":"ዎይኮ ታ ጫቁዋ ነ ዶናን ቆንጭሳናዉ ነዉ አይ ማት ደኢ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ኔኒ ታ ትምርትያ እፃዳሳ፤","poem":1},{"text":"ታ ቃላ ጉየ የጋዳሳ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ካይሱዋ በእዳ ዎደ ኔኒ እያራ ዳቦታዳሳ፤","poem":1},{"text":"ላይማተይሳታ ማባራን ገላዳሳ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ነ ዶና ኢታባ ኦደታናዉ ብላ የዳዳሳ፤","poem":1},{"text":"ነ እንፃርሳይ ዎርዶ ሃሳያ ሜዘትስ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ኡታዳ ነ እሻ ዝግራዳሳ፤","poem":1},{"text":"ነ አየ ናኣ ቦላ ኢታባ ኦደታዳሳ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ነ ሀይሳ ኡባ ኦያ ዎደ፥","poem":1},{"text":"ታኒ ስእ ግዳ ግሾ","poem":2},{"lineBreak":true},{"text":"ታና ነ መላ ጋዳ ቆፓዳሳ።","poem":2},{"lineBreak":true},{"text":"ሽን ሀእ ታ ነና ሀንቃና፤","poem":2},{"lineBreak":true},{"text":"ነ ናጋራ ነ ስንን ታይባና።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ህንተኖ፥ ፆሳ ዶገይሳቶ፥ ሀይሳ አኬክተ፤","poem":1},{"text":"ሄስ ሀኖና እፅኮ ታ ህንተና መንረና፤","poem":2},{"lineBreak":true},{"text":"ሄ ዎደ ህንተና አሻናይ ባዋ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ታዉ ጋላታ ያርሸይ ታና ቦንቼስ፤","poem":1},{"text":"ባ ኦግያ ሱርስዳ አሳስ","poem":2},{"lineBreak":true},{"text":"ታኒ ፆሳ አቶተ በሳና” ያጌስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}