{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_etw","name":"ማዝሙረ ማፃፋ","commonName":"ማዝሙረ ማፃፋ","title":"ማዝሙረ ማፃፋ","order":19,"numberOfChapters":150,"sha256":"0c025deb66520f61a3c823a973fb5df9bd3589998b1748b5e7240ec0298578c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_etw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":51,"content":[{"type":"heading","content":["ታዉ ጌሻ ዎዛና እማ"]},{"type":"hebrew_subtitle","content":["ዳዊቲ ዛማረታ ሀላቃስ ፃፍዳ ማዝሙረ"]},{"type":"hebrew_subtitle","content":["ዳዊቲ በርሳበራ ላይማትዳ ዎደ ናብያ ናታን እያዉ ኦድ ስምን ዳዊቲ የፅዳ ማዝሙረ"]},{"type":"verse","number":1,"content":["አቤት ፆሳዉ፥ ነ መርና ሲቁዋዳ ታና ማራ፤",{"text":"ነ ቃታ ዳሩዋ መላ ታ ናጋራ ቁቻ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታ ኢታተፈ ታና ሜጫ፤","poem":1},{"text":"ታ ናጋራፐ ታና ጌሻ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታኒ ታ ቆሁዋ ኤራይስ፤","poem":1},{"text":"ታ ናጋራይ ኡባ ዎደ ታ ስንና።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታኒ ነና፥ ነ ፃላላ ቆሀስ፤","poem":1},{"text":"ነ ስንን ኢታባ ኦስ።","poem":2},{"text":"ሄሳ ግሾ፥ ነ ሀንቁዋን ነ ልከ፤","poem":1},{"text":"ነ ፕርዳንካ ነ ፅሎ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሄኮ ታ የለትያ ዎደ ናጋራንቾ፤","poem":1},{"text":"ታ አየ ኡሎን ቡሮ አትያ፥","poem":2},{"lineBreak":true},{"text":"ዎደፐ ዶማዳ ታኒ ናጋራንቾ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኔኒ አሳ ዎዛናፐ ቱማተ ኮያሳ፤","poem":1},{"text":"ታ ጋ አሳተ ጭንጫተ ታማርሳ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ህሶጰ ቦንጮን ታና ዉርፃ፤ ታ ጌያና፤","poem":1},{"text":"ታና ሜጫ፤ ታ ሻቻፈ አዳ ቦፃና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ነ ታና ኡፋይስነ ሎኦባ ስሳ፤","poem":1},{"text":"ነ መንረዳ ታ መቀ ዛራዳ ኡፋይሳ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ነ ሶምኡዋ ታ ናጋራፐ ሀራ ሶ ዛራ፤","poem":1},{"text":"ታ ባላ ኡባ ቁቻ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አቤት ፆሳዉ፥ ጌሻ ዎዛና ታናን መ፤","poem":1},{"text":"ቃፆና አያና ታ ግዶን ኦራ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታና ነ ስንፈ የጎፋ፤","poem":1},{"text":"ነ ጌሻ አያና ታፐ ኤኮፋ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ነ አቶተ ኡፋይሳ ታዉ ዛራ፤","poem":1},{"text":"ታ ነዉ ኪተታና መላ ታና ዘምፕሳ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታ ሄ ዎደ ህገ መንይሳታ ነ ኦግያ ታማርሳና፤","poem":1},{"text":"ናጋራንቾትካ ኔኮ ስማና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"አቤት ፆሳዉ፥ ታና አሽያ ፆሳዉ፥","poem":1},{"text":"ሱ ጉስያ ናጋራፐ ታና አሻ፤","poem":2},{"lineBreak":true},{"text":"ሄ ዎደ ታ እንፃርሳይ ነ ፅሎተ የፃና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"አቤት ጎዳዉ፥ ታ ዶና ዶያ፤","poem":1},{"text":"ታ እንፃርሳይ ነ ጋላታ አዋጃና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ነ ያርሾን ኡፋይትያኮ፥ ታ ነዉ ያርሻናሽን፥","poem":1},{"text":"ነ ፁሳ ያርሾን ኡፋይታካ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ፆሳ ያርሾይ አዳ አያና፤","poem":1},{"text":"ፆሳዉ፥ ነ መቅዳነ","poem":2},{"lineBreak":true},{"text":"ካዉይዳ ዎዛና ካካ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"አቤት ፆሳዉ፥ ዶሳን ፅዮነስ ኬሀ፤","poem":1},{"text":"የሩሳላመ ግምበታ ግምባ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሄ ዎደ ነ ፅሎተ ያርሾንነ","poem":1},{"text":"ፁሳ ያርሾን ኡፋይታና።","poem":2},{"text":"ፖሎ ሽቂያ መሄ ያርሾን ኡፋይታና፤","poem":1},{"text":"ኮርማት ነ ያርሾ በሳን ያርሸታና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/50.json","previousC