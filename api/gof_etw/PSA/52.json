{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_etw","name":"ማዝሙረ ማፃፋ","commonName":"ማዝሙረ ማፃፋ","title":"ማዝሙረ ማፃፋ","order":19,"numberOfChapters":150,"sha256":"0c025deb66520f61a3c823a973fb5df9bd3589998b1748b5e7240ec0298578c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_etw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":52,"content":[{"type":"heading","content":["ፆሳ ሲቆይ መርናሳ"]},{"type":"hebrew_subtitle","content":["ዳዊቲ ዛማረታ ሀላቃስ አኬካን ፃፍዳ ግንፆ"]},{"type":"hebrew_subtitle","content":["ኤዶመ ቢታ አስ ግድዳ ዶይቅ ሳኦላኮ ብድ፥ “ዳዊቲ አብመለከ ሶ ብስ” ያግድ ኦድ ስምን፥ ዳዊቲ ፃፍዳ ማዝሙረ"]},{"type":"verse","number":1,"content":["ነኖ፥ ዎልቃማ ኡራዉ፥ ኢታተን አይስ ኦቶርታይ?",{"text":"ነኖ ፆሳን ካትዳይሶ ኡባ ዎደ አይስ ጬቀታይ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ነኖ፥ ዎርዶ ኦደተይሶ፥","poem":1},{"text":"ነ ሀራታ ይሳናዉ ማቀታሳ፤","poem":2},{"lineBreak":true},{"text":"ነ እንፃርሳይ ቃራ ማቅላ መላ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ነ ሎኦ አጋዳ ኢታ ዶሳሳ፤","poem":1},{"text":"ቱማ አጋዳ ዎርዶ ኦደታሳ። ሳላሀ","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ነኖ፥ ዎርዳንቹዋዉ፥","poem":1},{"text":"ነ ቦሻ ቃላ ኡባ ዶሳሳ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ፆሳይ ነና መርናዉ መንና፤","poem":1},{"text":"ፆሳይ ነና መንረናነ ነ ኬፈ ዳፍድ ከሳና፤","poem":2},{"lineBreak":true},{"text":"ነና ደኦን ደኤይሳታ ግዶፈ ሾድድ የጋና። ሳላሀ","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ፅሎት ሄሳ በእድ ያያና፤","poem":1},{"text":"ኤንቲ ሀይሳዳ ያግድ፥ ነ ቦላ ሚጫና፤","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“ፆሳ ባዉ ገሸ ኦቦና፥","poem":1},{"text":"ባ ዱረተን አማነትዳ፥","poem":2},{"lineBreak":true},{"text":"ኢታ ኦሶን ምንዳ፥","poem":2},{"lineBreak":true},{"text":"አድያ ሀይሳ በእተ” ያጋና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሽን ታኒ ፆሳ ኬን አጭያ ሻማሆ መላ፤","poem":1},{"text":"እያ ሲቁዋን ታኒ መርናዉ አማነታይስ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ነ ኦዳ ግሾ መርናዉ ታ ነና ጋላታና፤","poem":1},{"text":"ኔኒ ሎኦ ግድያ ግሾ ነ ሱንን ኡፋይስ ኦና፤","poem":2},{"lineBreak":true},{"text":"ጌሻታ ስንን ታ ነና ሳባና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}