type":"verse","number":6,"content":[{"text":"እስራኤለ አቶተይ ፅዮነፐ ዬረነ!","poem":1},{"text":"ፆሳይ ባ አሳ ድኡዋ ዛርያ ዎደ፥","poem":2},{"text":"ያይቆባ ዛረት ኡፋይቶ፤","poem":1},{"text":"እስራኤለ አሳይ ኡፋይሳን ሀሹ ጎ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}