{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_etw","name":"ማዝሙረ ማፃፋ","commonName":"ማዝሙረ ማፃፋ","title":"ማዝሙረ ማፃፋ","order":19,"numberOfChapters":150,"sha256":"0c025deb66520f61a3c823a973fb5df9bd3589998b1748b5e7240ec0298578c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_etw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":56,"content":[{"type":"heading","content":["ፆሳ ቦላ ዘምፓ"]},{"type":"hebrew_subtitle","content":["ፍልስፄመ አሳይ ጌተ ካታማን ዳዊታ ኦይክዳ ዎደ ዳዊቲ ዛማረታ ሀላቃስ ፃፍዳ ዎሳ"]},{"type":"hebrew_subtitle","content":["“ሃሆ በሳን ዎላ ቦላ ኡትዳ ሆሌስ” ጌተትያ ዲ ጩን የፀትዳ ዎሳ"]},{"type":"verse","number":1,"content":["አቤት ፆሳዉ፥ አሳይ ታና ኡንኤያ ግሾነ",{"text":"ኡባ ዎደ ታ ሞርከት ታና የደያ ግሾ ታዉ ቃታ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታ ሞርከት ኩመ ጋላስ ታና የኦሶና፤","poem":1},{"text":"ኦቶሮን ታና ኦልያ አሳይ ዳሮ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታና ያሽያ ዎደ","poem":1},{"text":"ታ ነናን አማነታይስ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታኒ ፆሳን አማነታይስ፤ ያይከ፤","poem":1},{"text":"እያ ቃላ ጋላትያ ፆሳን አማነታይስ፤","poem":2},{"lineBreak":true},{"text":"አስ ታና አይ ኦኔ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኩመ ጋላሳን ታ ሞርከት ባላ ኮዮሶና፤","poem":1},{"text":"ታና ቆሀናዉ ኡባ ዎደ ቶቦሶና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኤንቲ ታ ቦላ ማቀቶሶና፤","poem":1},{"text":"ታና ቆሀናዉ ጌዶሶና።","poem":2},{"text":"ታ ታንጎ ኡባ ካሎሶና፤","poem":1},{"text":"ታና ዎናዉ ኮዮሶና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኤንቲ አይ ኦገራካ ከስ ኤካና መላ ኦፋ፤","poem":1},{"text":"ነ ሀንቁዋን ሄ ካዎተታ ካዉሻ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታ ዋይያ ታይባ፤","poem":1},{"text":"ነ ታ አፉ ማካዳሳ፤","poem":2},{"lineBreak":true},{"text":"ኤንቲ ነ ማዝጋብያን ደኦኮና?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ታ ነና ፄግያ ዎደ፥","poem":1},{"text":"ታ ሞርከት ጉየ ስማና፤","poem":2},{"lineBreak":true},{"text":"ፆሳይ ታ ባጋ ግደይሳ ታ ሄሳን ኤራይስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታ እያ ቃላ ጋላትያ ፆሳን፥","poem":1},{"text":"ታ እያ ቃላ ጋላትያ ጎዳን፥","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ታ ሄ ፆሳን አማነታይስ፤ ያይከ።","poem":2},{"lineBreak":true},{"text":"አስ ታና አይ ኦኔ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አቤት ፆሳዉ ታ ነዉ ቃንግዳባይ ደኤስ፤","poem":1},{"text":"ሄሳ ጋላታ ያርሾ ኦዳ ታ ነዉ እማና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ደኦን ደኤይሳታ ቦላ ፖእያ ፖኡዋን","poem":1},{"text":"ፆሳ ስንን ስመረታና መላ፥","poem":2},{"lineBreak":true},{"text":"ታ ሸምፑዋ ሀይቆፐ፥","poem":2},{"lineBreak":true},{"text":"ታ ቶሁዋ በፐ አሻዳሳ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}