verse","number":6,"content":[{"text":"ኤንቲ ታ ቶሁዋስ ፅሄ ዎዶሶና፤","poem":1},{"text":"ታኒ ኡንኤታዳ ሆካስ።","poem":2},{"text":"ኤንቲ ታ ኦግያን ኦላ ቦክዶሶና፤","poem":1},{"text":"ሽን ሄ ኦላን ባንታዉ ኩንድዶሶና። ሳላሀ","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታ ዎዛናይ ምኖ፤","poem":1},{"text":"አቤት ፆሳዉ፥ ታ ዎዛናይ ምኖ፤","poem":2},{"lineBreak":true},{"text":"ታኒ ነና ማዝሙረን ሳባና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታ ሸምፐ፥ ባርካ፤","poem":1},{"text":"ዲነ ማስንቆይ ደንድተ፤","poem":2},{"lineBreak":true},{"text":"ታኒ ጉራ ባርካና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አቤት ጎዳዉ፥ ታ ነና አሳ ግዶን ጋላታና፤","poem":1},{"text":"ካዎተታ ግዶን ነና ሳባና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ነ ሲቆይ ሳሎታፐ ቃ፤","poem":1},{"text":"ነ አማነተይ ሻራፐ ቦላ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"አቤት ፆሳዉ፥ ነ ሳሎፐ አዳ ቁ ቁ ጋ፤","poem":1},{"text":"ነ ቦንቾይ ሳአ ኡባ ካሞ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}