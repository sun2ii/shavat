{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_etw","name":"ማዝሙረ ማፃፋ","commonName":"ማዝሙረ ማፃፋ","title":"ማዝሙረ ማፃፋ","order":19,"numberOfChapters":150,"sha256":"0c025deb66520f61a3c823a973fb5df9bd3589998b1748b5e7240ec0298578c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_etw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":58,"content":[{"type":"heading","content":["ፆሳይ ሳአ ኡባ ፕርዳና"]},{"type":"hebrew_subtitle","content":["ዳዊቲ ዛማረታ ሀላቃስ ፃፍዳ ዎሳ"]},{"type":"hebrew_subtitle","content":["“ይሶፋ” ጌተትያ ዲ ጩን የፀትዳ ዎሳ"]},{"type":"verse","number":1,"content":["ደርያ ሃረይሳቶ፥ ቱማ ህንተ ልከ ኦደቴቲ?",{"text":"አሳ ኡባስ ፅሎ ፕርዴቲ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ግደና፥ ህንተ ዎዛናን ኢታባ ሀልቼታ፤","poem":1},{"text":"ህንተ ኩሸይ ቢታ ቦላ ጌላባ ኦስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኢታ አስ አየ ኡሎፐ ዶምድ ሀሌስ፤","poem":1},{"text":"የለትዳ ጋላሳፐ ዶምድ፥","poem":2},{"lineBreak":true},{"text":"ባሌስነ ዎርዶ ኦደቴስ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኤንቲ ሾሻዳ ዪሻራ ደኦሶና፤","poem":1},{"text":"ኤንቲ ቱለ ጎፐዳ ስኦኮና።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ብተይስ አይ ጭንጫ ግድኮካ፥","poem":1},{"text":"ጎፐይ እያ ፄስ ስኤና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አቤት ፆሳዉ፥ ጋሞ አች ዳንያ ኤንታ አቻ መን፤","poem":1},{"text":"ጎዳዉ ኤንታ ሳክልያ ካ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኤንቲ ጉክዳ ሃ ግዶ፤","poem":1},{"text":"ባንታ ዶንግያ ዱክያ ዎደ፥","poem":2},{"lineBreak":true},{"text":"ዶንገ ቶራ አይፈይ ዮ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኤንቲ ማይድ ይያ  ሳሶዳ ሀኖ፤","poem":1},{"text":"አየ ኡሎፐ ሀይቅድ ዎያ፥","poem":2},{"lineBreak":true},{"text":"አዋ ፖኦ በኦና ቦሻዳ ሀኖ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኤንቲ አጉን ግድድ ዳያናፐ ካሰ፥","poem":1},{"text":"ኤንቲ ቡሮ ፑቶ ግድድ ደእሽን፥","poem":2},{"lineBreak":true},{"text":"ኤንታ ባ ሀንቁዋን ይሳና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ናጋራንቾታ ቦላ ሀሎ ከይያ ዎደ ፅሎት ኡፋይታና፤","poem":1},{"text":"ኢታታ ሱን ባንታ ቶሁዋ ሜጨታና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሄ ዎደ አሳይ፥","poem":1},{"text":"“ቱማ ፅሎታስ ዎይቶይ ደኤስ፤","poem":2},{"lineBreak":true},{"text":"ሳአ ቦላ ፕርድያ ፆሲ ደኤስ” ያጋና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}