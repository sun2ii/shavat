rse","number":6,"content":[{"text":"ኤንቲ ካታማ ግዶን ዩይሸ ፔእድ፥","poem":1},{"text":"ካና ላውሸ ስሞሶና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኤንታ ዶናፐ ከየይሳ በአ፤","poem":1},{"text":"ኤንታ እንፃርሳይ ማሻ መላ፤","poem":2},{"lineBreak":true},{"text":"አስ ኤንታና ስኤይሳ ቆፖኮና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሽን አቤት ጎዳዉ፥ ነ ኤንታ ቦላ ሚጫሳ፤","poem":1},{"text":"ካዎተታ ኡባ ለቅሳሳ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ፆሳዉ፥ ነ ታ ሚፃ ግድያ ግሾ፥","poem":1},{"text":"ታ ነ ዎልቃን አማነታይስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታ ፆሳይ ባ ሲቁዋን ታኮ ያና፤","poem":1},{"text":"ታ ፆሳይ ታ ሞርከታ ፆነተ ታና በሳና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታ አሳት ዶጎና መላ ነ ኤንታ ዎፓ።","poem":1},{"text":"አቤት ጎዳዉ፥ ኑ ጎንዳልያዉ፥","poem":2},{"lineBreak":true},{"text":"ነ ዎልቃን ኤንታ ላላነ ካዉሻ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኤንታ ዶናፐ ከይያ ናጋራ ግሾ","poem":1},{"text":"ኤንታ እንፃርሳፈ ፑልትያ ቃላ ግሾ፥","poem":2},{"lineBreak":true},{"text":"ባንታ ኦቶሩዋን ኦይከቶ፤","poem":2},{"text":"ኤንታ ባደነ ዎርዱዋ ግሾ፥","poem":1}]},{"type":"verse","number":13,"content":[{"text":"ነ ሀንቁዋን ኤንታ ይሳ፤","poem":2},{"lineBreak":true},{"text":"ኤንታ ኩመ ድጋ።","poem":2},{"text":"ሄሳን ፆሳይ ያይቆባ ዘረ ሃረይሳነ","poem":1},{"text":"ሳኣ ጋፃ ጋካናዉ ሃረይስ ኤረታና። ሳላሀ","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኤንቲ ካታማ ግዶን ዩይሸ ፔእድ፥","poem":1},{"text":"ካና ላውሸ ስሞሶና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኤንቲ ምያባ ደማናዉ ቶይላቶሶና፤","poem":1},{"text":"ካሎና አትዳ ላውያ ካና ግዶሶና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሽን ታኒ ነ ዎልቃ ሳባና፤","poem":1},{"text":"ዎንታ ነ ሲቁዋ የፃና።","poem":2},{"text":"ኔኒ ታዉ ታ ዋይያ ጋላስ፥","poem":1},{"text":"ታ ባቃታ አትያ በሰነ ሚፃ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አቤት ታዉ ዎልቃ ግድዳ ፆሳዉ፥","poem":1},{"text":"ታ ነና ሳባና።","poem":2},{"text":"ታ ቆሰታዳ አትያ በሳይነ","poem":1},{"text":"ሲቁዋ ታና በሲያ ፆሳይ ነና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}