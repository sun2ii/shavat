ታ አይፈይ ሙልጫትስ፤","poem":1},{"text":"ታኒ አፉፅዳ ግሾ ደሞና እፅስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጎዳይ ታ ዬሁዋ ስእዳ ግሾ፥","poem":1},{"text":"ህንተኖ፥ ኢታ ኦይሳቶ ታፐ ሃክተ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ጎዳይ ታ ዋሱዋ ስእስ፤","poem":1},{"text":"ታ ዎሳ ኤክስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታ ሞርከት ኡባይ ዬላትዶሶና፤ ዳጋምዶሶና፤","poem":1},{"text":"ቆፖና ጉየ ስሚድ ካዉይዶሶና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}