 ናጋ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሄሳ ግሾ ታ ቃንገ ጋላስ ጋላስ ጋና፤","poem":1},{"text":"ነ ሱን ኡባ ዎደ ሳባና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}