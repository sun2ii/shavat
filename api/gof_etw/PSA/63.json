poem":1},{"text":"ታ ነ ቀፍያ ኩያን ኡታዳ ኡፋይሳን የፃና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታ ሸምፕያ ኔራ ኦይከታሱ፤","poem":1},{"text":"ነ ኡሻቻ ኩሸይ ታና ኦይክድ ናጌስ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሽን ታና ዎናዉ ኮየይሳት፥","poem":1},{"text":"ቢታ ጋርሳን ሞገታና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኤንቲ ማሻስ አድ እመታና፤","poem":1},{"text":"ኤንቲ ሱመስ ካሆ ግዳና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሽን ካዎይ ፆሳን ኡፋይታና።","poem":1},{"text":"ፆሳ ሱንን ጫቅያ ኡባይ እያ ጋላታና፤","poem":2},{"lineBreak":true},{"text":"ሽን ዎርዳንቾታ ዶናይ ጎርደታና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}