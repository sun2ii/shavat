{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_etw","name":"ማዝሙረ ማፃፋ","commonName":"ማዝሙረ ማፃፋ","title":"ማዝሙረ ማፃፋ","order":19,"numberOfChapters":150,"sha256":"0c025deb66520f61a3c823a973fb5df9bd3589998b1748b5e7240ec0298578c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_etw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":65,"content":[{"type":"heading","content":["ፆሳይ ታ አቶተ"]},{"type":"hebrew_subtitle","content":["ዛማረታ ሀላቃስ የፀትዳ ዳዊታ ማዝሙረ"]},{"type":"verse","number":1,"content":["አቤት ፆሳዉ፥ ፅዮነን ነዉ ጋላት በሴስ፤",{"text":"ኑኒ ኑ ቃንገ ነዉ ጋና።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ኔኒ ዎሳ ስእያ ግሾ፥","poem":1},{"text":"አሳ ኡባይ ኔኮ ዮሶና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኑ ናጋራይ ኑና ሙክዳ ዎደ፥","poem":1},{"text":"ነ ኑስ አቶተ እማዳሳ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ነ ዶርዳይሳትነ ነ ዳባባን ዳና መላ","poem":1},{"text":"ኔኮ ሺሽዳ አስ አንጀትዳይሳ።","poem":2},{"text":"ኑኒ ነ ሶን፥ ነ ጌሻ ዱንካንያን","poem":1},{"text":"ደእያ ሎኦባን ካሎስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"አቤት ኑ አቶተዉ፥","poem":1},{"text":"ማላልስያ ነ ፅሎ ኦሱዋን ኑስ ዛራ።","poem":2},{"text":"ሳኣ ጋፃፐ ጋፃ ጋካናዉ፥","poem":1},{"text":"ሃሆን ደእያ ኡባስ ነ ኡፋይስ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኔኒ ነ ዎልቃን ደረታ ምንዳሳ፤","poem":1},{"text":"ነ ዎልቃ ዳንጫዳሳ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኔኒ አባ ግርሳነ ቤታ ጉን ስእ ኦሳ፤","poem":1},{"text":"ያርክያ አሳ ዋሱዋ እርፅሳሳ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ነ ኦዳ ማላታ ግሾ፥","poem":1},{"text":"ሳኣ ጋፃ ጋካናዉ ደእያ አሳ ኡባይ ነዉ ያያና፤","poem":2},{"lineBreak":true},{"text":"ዶሎሀፐ ዉሎሀ ጋካናዉ ደእያ አሳ ኡባ ኡፋይሳዳሳ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ነ እራ እማዳ ቢታ ናጋሳ፤ ዳሮ ዱረያሳ፤","poem":1},{"text":"አሳስ ካይ ዶላና መላ","poem":2},{"text":"ፆሳ ሻፋይ ሃን ኩምዳይሳ፤","poem":1},{"text":"ሄሳዳ ኦዳ ነ ጊግሳዳሳ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ጎሻስ ሃ እማሳ፤","poem":1},{"text":"ቢታ ሹግሳዳ ኦላ ኩንሳ።","poem":2},{"text":"ነ እራን ዛራዳ እርፅሳሳ፤","poem":1},{"text":"ካይ ዶላና ድጫና መላ አንጃሳ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ላይ ካሎ ላይ ኦሳ፤","poem":1},{"text":"ነ አያ በሳ ኡባይ ኩምድ ፓላሀና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሄን በሳታ ማታን ኩንሳ፤","poem":1},{"text":"ዙማታ ኡፋይስ ማይዛሳ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ነ ሄን በሳታ ዶርሳታ ኩንሳ፤","poem":1},{"text":"ዛንጋራ ቢታን ካ ኩንሳ፤","poem":2},{"lineBreak":true},{"text":"ኤንቲ ኡፋይሳን እልልሸ የፆሶና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}