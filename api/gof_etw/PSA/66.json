rse","number":7,"content":[{"text":"እ ባ ዎልቃን መርናዉ ሃሬስ።","poem":1},{"text":"ካዎተታ ባ አይፈን ፄሌስ፤","poem":2},{"lineBreak":true},{"text":"ሄሳ ግሾ፥ ማካለይሳት እያ ቦላ ደንዶፎ። ሳላሀ","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አሳዉ፥ ኑ ፆሳ ጋላትተ፤","poem":1},{"text":"ህንተ እያ ጋላትያ ጋላታይ ስኤቶ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እ ኑና ፓፃ ዎስ፤","poem":1},{"text":"ኑ ኩንዶና መላ ናግስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አቤት ፆሳዉ ነ ኑና ፓጫዳሳ፤","poem":1},{"text":"ብር ታማን ፓጨትድ ጌየይሳዳ","poem":2},{"lineBreak":true},{"text":"ነ ኑና ጌሻዳሳ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ነ ኑና ፅሄን ገልሳዳሳ፤","poem":1},{"text":"ኑ ዞኮን ዴፆ ቶሆ ዎዳሳ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሞርከት ኑ ሁጰራ ቶግድ አናዳ ኦዳሳ፤","poem":1},{"text":"ኑ ሃ ግዶራነ ታማ ግዶራ አዳ፤","poem":2},{"lineBreak":true},{"text":"ሽን ሀእ ኑና እንጀ በሲ ኤሀዳሳ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታ ፁሳ ያርሾ ኤካዳ ነ ኬ ገላና፥","poem":1},{"text":"ታ ቃንገ ጋና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ታ መቶትዳ ዎደ ታ ዶናይ ግዳ ቃላ፥","poem":1},{"text":"ታ እንፃርሳፈ ከይዳ ቃንገ ጋና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ታ ነዉ ሞዋ፥ ፁሳ ያርሾ ኦዳ ሺሻና።","poem":1},{"lineBreak":true},{"text":"ማራዘታ ሳዎ ቶንኩ ግያ ያርሾ ኦዳ ሺሻና፤","poem":1},{"text":"ኮርማነ ኮለታ ነዉ ያርሻና። ሳላሀ","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ህንተኖ፥ ፆሳስ ያየይሳቶ፥","poem":1},{"text":"ኡባይ ሃ ይድ፥ ስእተ፤","poem":2},{"lineBreak":true},{"text":"ፆሳይ ታዉ ኦዳባ ታ ህንተዉ ኦዳና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ታ ቃላ ቁ ኦዳ ዎሳስ፤","poem":1},{"text":"ታ እንፃርሳን እያ ጋላታስ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ታኒ ዎዛን ኤርሽን ናጋራ ገንዳባ ግድያኮ፥","poem":1},{"text":"ጎዳይ ታና ስኤና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሽን ፆሳይ ቱማ ታና ስእስ፤","poem":1},{"text":"ታ ኦይሻ ዛርስ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ፆሳይ ታ ዎሳ እፅቦና ግሾ፥","poem":1},{"text":"ባ መርና ሲቁዋ","poem":2},{"lineBreak":true},{"text":"ታና ድግቦና ግሾ ጋላተቶ።","poem":2}]}