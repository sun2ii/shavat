{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_etw","name":"ማዝሙረ ማፃፋ","commonName":"ማዝሙረ ማፃፋ","title":"ማዝሙረ ማፃፋ","order":19,"numberOfChapters":150,"sha256":"0c025deb66520f61a3c823a973fb5df9bd3589998b1748b5e7240ec0298578c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_etw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":68,"content":[{"type":"heading","content":["ፆሳይ ባ ሞርከታ ላላና"]},{"type":"hebrew_subtitle","content":["ዛማረታ ሀላቃስ የፀትዳ ዳዊታ ማዝሙረ"]},{"type":"verse","number":1,"content":["ፆሳይ ደንዶ፤ እያ ሞርከት ላለቶ፤",{"text":"እያ እፀይሳት እያ ስንፈ ባቃቶ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ጩያይ ጫርኮራ ደንድድ ይስያ መላ፥","poem":1},{"text":"ሙቃድ ታማን ትልኤይሳዳ፥","poem":2},{"lineBreak":true},{"text":"ኢታት ፆሳ ስንፈ ዮ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሽን ፅሎት ሀሹ ጎ፤","poem":1},{"text":"ፆሳ ስንን ኡፋይቶ፤","poem":2},{"lineBreak":true},{"text":"ኡፋይሳን እልሎ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ፆሳስ የፅተ፤ እያ ሱን ሳቢተ፤","poem":1},{"text":"ሻራን በይሳስ ኦገ ከስተ፤","poem":2},{"lineBreak":true},{"text":"እያ ሱንይ ጎዳ፤ እያ ስንን ኡፋይትተ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ፆሳይ ባ ደእያ ጌሻ በሳን፥","poem":1},{"text":"ይኦታስ አዋ፤ አምኤታስ ዳይና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ፆሳይ ብዛታስ ሶ አስ እሜስ፤","poem":1},{"text":"ቃሾ ኬን ደኤይሳታ ብርሽድ፥ ዱረተን ዎስ፤","poem":2},{"lineBreak":true},{"text":"ሽን ማካላ