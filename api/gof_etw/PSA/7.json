{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_etw","name":"ማዝሙረ ማፃፋ","commonName":"ማዝሙረ ማፃፋ","title":"ማዝሙረ ማፃፋ","order":19,"numberOfChapters":150,"sha256":"0c025deb66520f61a3c823a973fb5df9bd3589998b1748b5e7240ec0298578c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_etw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":7,"content":[{"type":"heading","content":["መቶ ዎደ ፅሎ አሳ ዎሳ"]},{"type":"hebrew_subtitle","content":["ብንያመ ኮቻ ኩዛባ ዳዊታ ጎዳስ የፅዳ ማዝሙረ"]},{"type":"verse","number":1,"content":["አቤት ጎዳዉ ታ ፆሳዉ፥ ታ ነናን ቆሰታይስ፤",{"text":"ታና የደያ ኡባፈ ታና አሻ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ኔኒ ታና አሾናባ ግድያኮ፥","poem":1},{"text":"ኤንቲ ታና ጋሞዳ ዛዛና፤","poem":2},{"lineBreak":true},{"text":"አሽያ አስ ባይና መንረናሽን።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አቤት ጎዳዉ ታ ፆሳዉ፥","poem":1},{"text":"ታ ሀይሳ መላባ ኦዳባ ግድኮ፥","poem":2},{"lineBreak":true},{"text":"ታኒ አሰ ናቅዳባ ግድኮ፥","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ታ ላገታስ ሎኦ ግሾ ኢታ ዛርዳባ ግድኮ፥","poem":2},{"lineBreak":true},{"text":"ጋሶይ ባይና ታ ሞርክያ ቦንቅዳባ ግድኮ፥","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ታ ሞርከይ ታና የደድ ኦይኮ፤","poem":2},{"lineBreak":true},{"text":"ታና ሳአን የግድ የ፤","poem":2},{"lineBreak":true},{"text":"ታና ባናን ጎንዶርስድ ካዉሾ። ሳላህ","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አቤት ጎዳዉ፥ ነ ሀንቁዋን ደንዳዳ፥","poem":1},{"text":"ኤፅያ ታ ሞርከታ ሀንቁዋ ቦላ ኤቃ፤","poem":2},{"lineBreak":true},{"text":"ታ ፆሳዉ፥ ታ ግሾ ባርካ፤","poem":2},{"lineBreak":true},{"text":"ኔኒ ፅሎ ፕርዳ ኮያሳ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አሳይ ነ ዩሾን ሺቆ፤","poem":1},{"text":"ኔኒ ኤንታፈ ቦላራ ሃራ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጎዳይ ካዎተታ ቦላ ፕርዴስ፤","poem":1},{"text":"አቤት ጎዳዉ፥ ታ ፅሎተዳነ","poem":2},{"lineBreak":true},{"text":"ታ ሱረተዳ ፕርዳ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ቆፋነ ዎዛና ሻካዳ ኤርያ ፅሎ ፆሳዉ፥","poem":1},{"text":"ኢታታ ጌላ ሀኖታ ኔኒ ተቃ፤","poem":2},{"lineBreak":true},{"text":"ሽን ፅሉዋ ሳሮን ናጋ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዎዛና ሱረታ አሽያ፥","poem":1},{"text":"ፆሳይ ታዉ ጎንዳለ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ፆሳይ ፅሎ ፕርደይሳ፤","poem":1},{"text":"እ ኡባ ዎደ ኢታታ ቦላ ሀንቀትያ ፆሳ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኢታት ባንታ ኢታተፈ ስሞና እፅኮ፥","poem":1},{"text":"ፆሳይ ባ ማሻ ሌፈስ፤","poem":2},{"lineBreak":true},{"text":"ባ ዶንግያ ጊግሴስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እ ባ ዎያ ኦላ ሚሸታ ጊግሴስ፤","poem":1},{"text":"ላፅያ ባ ዶንገ ቶራ ፕቴስ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኢታት ቆሆ ቃንትድ፥","poem":1},{"text":"ገነ ዎደፅድ፥","poem":2},{"lineBreak":true},{"text":"ዎርዶ የሎሶና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሀራ አሳስ ኦላ ቦክዳ አስ","poem":1},{"text":"ባ ቦክዳ ኦላን ባዉ ኩንዴስ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እያ ገነይ እያ ሁጰን ስሜስ።","poem":1},{"text":"እያ ጌላተይ እያ ሜስ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"እያ ፅሎተ ግሾ ታኒ ጎዳ ሳባና፤","poem":1},{"text":"ኡባፈ ቃ ጎዳ ሱንስ","poem":2},{"lineBreak":true},{"text":"ታኒ ጋላታ ማዝሙረ የፃና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}