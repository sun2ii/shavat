,"number":8,"content":[{"text":"ጋላሳ ኡባን ታ ዶናይ","poem":1},{"text":"ነ ጋላታንነ ነ ቦንቹዋን ኩምስ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ታኒ ጭምዳ ዎደ ታና የጎፋ፤","poem":1},{"text":"ታ ዎልቃይ እፅዳ ዎደ ታና አጎፋ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታ ሞርከት ታ ቦላ ቶቦሶና፤","poem":1},{"text":"ታና ዎናዉ ኮየይሳት ታ ቦላ ማቀቶሶና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኤንቲ፥ “ፆሳይ እያ አግስ፤ የደድ ኦይኮስ፤","poem":1},{"text":"እያ አሻናይ ኦንካ ባዋ” ያጎሶና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ፆሳዉ፥ ታፐ ሃኮፋ","poem":1},{"text":"ታ ፆሳዉ፥ ታና ማዳናዉ ኤለሳ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታና ሞተይሳት ዬላትድ ዮ፤","poem":1},{"text":"ታና ቆሀናዉ ኮየይሳት፥","poem":2},{"lineBreak":true},{"text":"ዬላነ ካዉሸ ማኦ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሽን ታኒ ኡባ ዎደ ኡፋይሳን ነና ናጋና፤","poem":1},{"text":"ዛራ ዛራዳካ ነና ጋላታና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ነ ኦዳባ ታ ታይባናዉ ፆነትኮካ፥","poem":1},{"text":"ታ ዶናይ ጋላስ ኡባን ነ ፅሎተነ","poem":2},{"lineBreak":true},{"text":"ነ አቶተባ ኦዳና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ታኒ ኡባ ሃርያ ጎዳ ዎልቃን ያዳ፤","poem":1},{"text":"ነ ፃላላ ፅሎ ግደይሳ አዋጃና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ፆሳዉ፥ ኔኒ ታ ናአተፈ ዶማዳ ታና ታማርሳዳሳ፤","poem":1},{"text":"ሀእካ ነ ማላልስያ ኦሱዋ ታ ኦዳና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ፆሳዉ ነ ዎልቃነ ነ ምኖተን","poem":1},{"text":"ያ የለታ ኡባስ ኦዳና ጋካናዉ፥","poem":2},{"lineBreak":true},{"text":"ታኒ ጭማዳ ፑሉምኮካ ታና አጎፋ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ፆሳዉ፥ ነ ፅሎተይ ሳሎ ጋክስ፤","poem":1},{"text":"ግታባ ኦዳ ፆሲ፥ ነ መል ኦኔ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ኔኒ ታ ቦላ ዳሮ መቶ ኤሀዳሳ፤","poem":1},{"text":"ግዶሽን ታ ደኡዋ ዛራዳ ኦራፅሳዳሳ፤","poem":2},{"lineBreak":true},{"text":"ኔኒ ታና ቢታ ጋርሳፈ ከሳዳሳ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ኔኒ ታ ቦንቹዋ ዳርሳዳሳ፤","poem":1},{"text":"ታና ዛራዳ ምንዳሳ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ታ ፆሳዉ፥ ነ ቱማተ ግሾ፥","poem":1},{"text":"ታ