{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_etw","name":"ማዝሙረ ማፃፋ","commonName":"ማዝሙረ ማፃፋ","title":"ማዝሙረ ማፃፋ","order":19,"numberOfChapters":150,"sha256":"0c025deb66520f61a3c823a973fb5df9bd3589998b1748b5e7240ec0298578c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_etw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":72,"content":[{"type":"heading","content":["ኡፋይሳን ናገትያ ካዋ"]},{"type":"hebrew_subtitle","content":["ሶሎሞነ ማዝሙረ"]},{"type":"verse","number":1,"content":["ፆሳዉ፥ ነ ሱረ ፕርዳ ካዋስ፥",{"text":"ነ ፅሎተ ካዋ ናኣስ እማ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እ ነ አሳስ ፅሎተን ፕርዳና፤","poem":1},{"text":"ቆሄትዳይሳታስ ሱረን ዳይናታና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ደረት ዱረተ፥","poem":1},{"text":"ዙማት ፅሎተ አይፈ ነ አሳስ አይፎ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ካዎይ ቆሄትዳይሳታ ግሾ ሞተቶ፤","poem":1},{"text":"ማንቆታ አሾ፤ ኡንኤይሳታ መን።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ፆሳዉ፥ እ አዋዳነ አጌናዳ ደኦ፤","poem":1},{"text":"የለተፈ የለተ ጋካናዉ ደኦ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ካዎይ ጎሻን ቡክያ እራ መላነ","poem":1},{"text":"ቢታ ካልስያ ፑሰ እራ መላ ግዶ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"እያ ላይ ኡባን ፅሎ አሳት ዳዮ፤","poem":1},{"text":"አጌን ያና ጋካናዉ ሳሮተ ዳሮ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አባፈ አባ ጋካናዉ፥","poem":1},{"text":"ኤፍራፂሳ ሻፋፐ ሳኣ ጋፃ ጋካናዉ እ ሃሮ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ባዞን ደእያ አሳት እያ ጎይኖ፤","poem":1},{"text":"እያ ሞርከት ባና ላጮ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታርሰሳነ ዩሾይ አባን ተቀትዳ ቢታታ፥","poem":1},{"text":"ካዎት እያዉ ጊራ ጊሮ፤","poem":2},{"lineBreak":true},{"text":"አራበነ ቶጰ ካዎት እያዉ እሞታ ኤሆ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ካዎት ኡባይ እያዉ ጉልባቶ፤","poem":1},{"text":"ካዎተት ኡባይ እያዉ ኪተቶ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እያኮ ዋስያ ማንቆታ፥ ቆሄትዳይሳታነ","poem":1},{"text":"ማዶይ ባይናይሳታ እ አሻና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ማንቆታስነ ዳቡራንቾታስ እ ቃቴስ፤","poem":1},{"text":"ማንቆታ ሸምፑዋ ሀይቆፐ አሼስ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኤንታ ሱይ እያ ስንን አልኦ ግድያ ግሾ፥","poem":1},{"text":"እ፥ ኤንታ ቆሆፐነ ኢታፐ ዎዛና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ካዎይ ዳሮ ላይ ጋምኦ፤","poem":1},{"text":"አራበ ቢታ ዎርቃይ እያዉ ዮ።","poem":2},{"text":"አሳይ እያ ግሾ ኡባ ዎደ ዎሶ፤","poem":1},{"text":"ጋላስ ኡባን እ አንጀቶ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ቢታን ካ ፓላሆ፤","poem":1},{"text":"ደረት ካን ካመቶ።","poem":2},{"text":"ልባኖሰ ደርያ ቦላ ካ አይፍያዳ አይፎ፤","poem":1},{"text":"ደንብ ማታን ኩምያዳ አሳይ ካታማ ኩሞ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ካዋ ሱንይ መርናዉ ደኦ፤","poem":1},{"text":"አዋዳ ኡባ ዎደ ፄገትሸ ጋምኦ።","poem":2},{"text":"አሳ ኡባይ እያ ባጋራ አንጀታና፤","poem":1},{"text":"ካዎተት እያ “አንጀትዳይሳ” ያጋና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ማላልስያባ ባርካ ኦያ ጎዳይ፥ ፆሳይ","poem":1},{"text":"እስራኤለ ፆሳይ ጋላተቶ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"እያ ቦንቾ ሱንይ መርናዉ ጋላተቶ፤","poem":1},{"text":"እያ ቦንቾይ ሳአ ኡባ ኩሞ።","poem":2},{"lineBreak":true},"አምንእ! አምንእ!"]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"እሰየ ናኣ ዳዊታ ዎሳይ ሀይሳን ፖለትስ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}