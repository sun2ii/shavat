":24,"content":[{"text":"ነ ዞርያን ታና ካለሳ፤","poem":1},{"text":"ዉርሰን ታና ቦንቾን ኤካሳ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ታዉ ሳሎን ኔፐ አትሽን፥ ሀር ኦን ደኢ?","poem":1},{"text":"ታኒ ኔፐ አትሽን፥ ሳአን ሀራ አሞትከ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ታ ዎልቃይነ ታ ዎዛናይ ዳቡራናዉ ዳንዳኤስ፤","poem":1},{"text":"ሽን ፆሳይ ታ ዎዛና ምኖተነ","poem":2},{"lineBreak":true},{"text":"መርናዉ ታና ጋክዳ ሳማ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ኔፐ ሃከይሳት ያና፤","poem":1},{"text":"ነና ካደይሳታ ኡባ ነ ዉርሳና።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ሽን ታዉ ፆሳኮ ሺቆይ ሎኦ፤","poem":1},{"text":"እያ ኦሶ ኡባ ታኒ ኦዳና መላ፥","poem":2},{"lineBreak":true},{"text":"ኡባ ሃርያ ጎዳ ቆሰትድ አትያ በሰ ኦስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}