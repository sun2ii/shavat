ኑ ቢታን ደእያ ማ በሲ ኡባይ","poem":1},{"text":"ማካላንቾታን ኩምዳ ግሾ፥","poem":2},{"lineBreak":true},{"text":"ነ ኑስ ጫቅዳ ጫቁዋ ቆፓ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ቆሄትዳይሳታ ዬላዮፓ፤","poem":1},{"text":"ማንቆትነ መቶታንቾት ነ ሱን ጋላቶ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"አቤት ፆሳዉ፥ ደንዳ፤ ሞተታ፤","poem":1},{"text":"ጋላስ ኩመ ኤያት ነና ቀልቅሰይሳ ሀሳያ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ነ ሞርከት ነ ቦላ ዋስያ ዋሱዋነ","poem":1},{"text":"ነና እፀይሳት ጬቀትያ ጬቁዋ አኬካ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":23}