{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_etw","name":"ማዝሙረ ማፃፋ","commonName":"ማዝሙረ ማፃፋ","title":"ማዝሙረ ማፃፋ","order":19,"numberOfChapters":150,"sha256":"0c025deb66520f61a3c823a973fb5df9bd3589998b1748b5e7240ec0298578c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_etw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":76,"content":[{"type":"heading","content":["ፆሳ ስንን ኤቃናይ ኦኔ?"]},{"type":"hebrew_subtitle","content":["አሳፍ ዛማረታ ሀላቃስ ዲን የፅዳ ማዝሙረ"]},{"type":"verse","number":1,"content":["ፆሳይ ይሁዳን ኤረትስ፤",{"text":"እያ ሱንይ እስራኤለን ግታ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"እያ ዱንካነይ ሳለማና፤","poem":1},{"text":"እ ደእያ በሳይ ፅዮነና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ያን ፆንገትያ ሞርከ ዶንግያ፥","poem":1},{"text":"ጎንዳለ፥ ማሸነ ኦላ ሚሸታ መንረስ። ሳላሀ","poem":2}]},{"type":"verse","number":4,"content":[{"text":"አቤት ፆሳዉ፥ ነ ቦንቾይ አይ መላ ግተ!","poem":1},{"text":"ኔኒ ነ ሞርከታ ፆናዳ ዙማፐ ስምያ ዎደ፥","poem":2},{"lineBreak":true},{"text":"ነ ቴማይ አይ መላ ያሽ!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ጎባ ቶራንቾት ቦንቀትዶሶና፤","poem":1},{"text":"ኤንቲ ዎልቃማ ስኮ ስክዶሶና፤","poem":2},{"lineBreak":true},{"text":"ኤንታፈ እሶይካ ባ ኩሽያ ደንቤና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አቤት ያይቆባ ፆሳዉ፥ ነ ሴርዳ ዎደ፥","poem":1},{"text":"ፓራ አሳትነ ፓራት ኩንድድ አትዶሶና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሽን አቤት ፆሳዉ፥ ኔኒ ያሻሳ፤","poem":1},{"text":"ነ ሀንቆይ ሱልያ ዎደ፥","poem":2},{"lineBreak":true},{"text":"ነ ስንን ኦነ ኤቃናይ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኔኒ ፕርዳ ሳሎፐ ስስዳ ዎደ፥","poem":1},{"text":"ቢታይ ዳጋማን ስእ ግስ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኔኒ ቢታን ቆሄትዳ አሳ አሻናዉነ","poem":1},{"text":"ኤንታዉ ፕርዳናዉ ደንድያ ዎደ ሄስ ሀንስ። ሳላሀ","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ነ አሰ ሀንቅኮካ ነዉ ቦንቾ ግዴስ፤","poem":1},{"text":"ኦላፐ አትዳ አሳት ነ ባኣለ ቦንቻና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጎዳስ ህንተ ፆሳስ ቃንገ ጋተ፤","poem":1},{"text":"ህንተኖ እያ ማታን ደእያ ካዎተቶ፥","poem":2},{"lineBreak":true},{"text":"ያሽያ እያዉ እሞታ ኤህተ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እ ሀላቃታ አያና ካዉሼስ፤","poem":1},{"text":"ዎልቃማ ካዎታካ ዳጋንስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}