"poem":1},{"text":"ህዛፐ ጉየ እ ኑስ ኬሄነዬ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እያ ሲቆይ አትደዬ?","poem":1},{"text":"እ ኦድዳ ቃላ መርናዉ ፖለነዬ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ፆሳይ ባ ማሮታ ዶግደዬ?","poem":1},{"text":"ባ ቃያ ሀንቆን ላምደዬ?” ያጋዳ ኦይቻስ። ሳላሀ","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኡባፈ ቃ ፆሳዉ፥ ታና ኡንኤዳይ፥","poem":1},{"text":"ነ ኡሻቻ ኩሽያን ኑና ማዶ አግዳይሳ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጎዳ ኦሶታ ታኒ ቆፓና፤","poem":1},{"text":"እ በን ኦዳ ማላልስያ ኦሶታ ሀሳያና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ነ ኦሶታ ታኒ ዛራ ዛራዳ ቆፓና፤","poem":1},{"text":"ነ ዎልቃማ ኦሶታ ታኒ ዎ ደንና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"አቤት ፆሳዉ፥ ነ ኦገይ ጌሽ፤","poem":1},{"text":"ነ መላ ግታ ፆሲ ኦኔ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኔኒ ማላልስያባ ኦያ ፆሳ፤","poem":1},{"text":"አሳ ግዶን ነ ዎልቃ ቆንጭሳሳ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ነ አሳ፥ ያይቆባነ ዮሰፋ ኮቻ","poem":1},{"text":"ነ ቀስያን ዎዛዳሳ። ሳላሀ","poem":2}]},{"type":"verse","number":16,"content":[{"text":"አቤት ፆሳዉ፥ ሃት ነና በእድ ያይዶሶና፤","poem":1},{"text":"አባ ጪሞትካ ኮኮርዶሶና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሻራት ሃ ዱገ ትግዶሶና፤","poem":1},{"text":"ዳዳይ ሳሎን ጉምስ፤","poem":2},{"lineBreak":true},{"text":"ነ ዎልአንይ ያን ሀን ዎልአምስ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ነ ዳዳ ጉንይ ኡሹዋ ግዶን ጉምስ፤","poem":1},{"text":"ነ ዎልአንይ ሳኣ ፖእስስ፤","poem":2},{"lineBreak":true},{"text":"ቢታይ ቃፅስ፤ ኮኮርስ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ኔኒ አባ ግዶራ ሄመታሳ፤","poem":1},{"text":"ጪሞ አባ ግዶራ ካንሳ፤","poem":2},{"lineBreak":true},{"text":"ሽን ነ ቶሆይ የዳ በሳይ በንተና።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ሙሰ ኩሸንነ አሮና ኩሸን","poem":1},{"text":"ነ አሳ ዶርሳ ዉደዳ ካለዳሳ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}