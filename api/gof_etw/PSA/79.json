":2}]},{"type":"verse","number":7,"content":[{"text":"ሄስካ ኤንቲ ያይቆባ ምዳ ግሾነ","poem":1},{"text":"ኤንቲ ደእያ በሳ ይስዳ ግሾሳ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኑኒ ዳሮ መቶትዳ ግሾ፥","poem":1},{"text":"ኑ ማይዛታ ኢታተ ኑ ቦላ ታይቦፓ፤","poem":2},{"lineBreak":true},{"text":"ኤሶን ነ ማሮታ ኑስ ኪታ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አቤት ኑና አሽያ ፆሳዉ፥","poem":1},{"text":"ነ ቦንቾ ሱን ግሾ ኑና ማዳ።","poem":2},{"text":"ነ ሱን ግሾ ኑና አሻ፤","poem":1},{"text":"ኑ ናጋራ አቶ ጋ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ደረት፥ “ኤንታ ፆሳይ አዉን ደኢ?” አይስ ጋኔ?","poem":1},{"text":"ነ አይለታ ሱ ኤንቲ ጉስዳ ግሾ፤","poem":2},{"lineBreak":true},{"text":"ኔኒ ሀሎ ከየይሳ ኑ ፄልሽን፥","poem":2},{"lineBreak":true},{"text":"ኤንታ ግዶን ቆንጭሳ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ቃሾ አሳ ኦለይ ነ ስን ጋኮ፤","poem":1},{"text":"ሀይቆ ፕርደትዳይሳታ","poem":2},{"lineBreak":true},{"text":"ነ ዎልቃ ግታተን አሻ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ጎዳዉ፥ ኑ ሾሮት ነና ቶችዳ ግሾ፥","poem":1},{"text":"ላፑን ኩሸ ሀሎ ከያዳ ኤንታ ክኦን እድን።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሄ ዎደ ኑኒ ነ አሳይ፥ ነ ዶርሳት፥","poem":1},{"text":"መርናዉ ነና ጋላታና።","poem":2},{"text":"የለተፈ የለተ ጋካናዉ፥","poem":1},{"text":"ነ ፔሻ ኦዳና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}