":"verse","number":7,"content":[{"text":"ኡባፈ ዎልቃማ ፆሳዉ ኑና ዛራ፤","poem":1},{"text":"ኑ አታናዳ ነ ሶምኡዋ ኑስ ፖእሳ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ግብፀፈ ዎይነ ኤሀዳሳ፤","poem":1},{"text":"ካዎተታ የደዳ፥","poem":2},{"lineBreak":true},{"text":"ኤንታ ቢታን እያ ቶካዳሳ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኔኒ ቢታ ቄፃዳሳ፤","poem":1},{"text":"እ ፃጶ የድድ፥ ዳይድ ቢታ ጋክስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ደረት እያ ኩያን፥","poem":1},{"text":"ልባኖሰ ዝጋት እያ ታሽያን ካመትዶሶና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ባ ታሸታ መደትራነ አባ ጋካናዉ፥","poem":1},{"text":"ባ ፄራታ ኤፍራፂሳ ሻፋ ጋካናዉ የድስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ያትን፥ ኦገራ አያ ኡባይ","poem":1},{"text":"እያ አይፍያ ዱናዳ፥","poem":2},{"lineBreak":true},{"text":"እያ ዩሾን ደእያ ግምብያ አይስ ላላዲ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ባዞ ጉዱንይ እያ ቦላ ጉፕስ፤","poem":1},{"text":"ዎራ ዶአት እያ ምዶሶና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኡባፈ ዎልቃማ ፆሳዉ ኑኮ ስማ፤","poem":1},{"text":"ሳሎራ ዱገ ፄላዳ፤ ሀ ዎይንያ ናጋ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እ ነ ኡሻቻ ኩሸይ ቶክዳ ፃጶ፤","poem":1},{"text":"ኔኒ ነዉ ድችዳ ፑተ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ነ ሞርከት ነ ዎይንያ ቃንፅዶሶና፤","poem":1},{"text":"ታማን ፁግዶሶና፤","poem":2},{"lineBreak":true},{"text":"ኤንታ ነ ሀንቁዋን ይሳ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ነ ኩሸይ ነ ኡሻቻን ደእያ አሳ፥","poem":1},{"text":"ኔኒ ነዉ ድችዳ አሳ ናጎ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ህዛ ኑኒ ጉየ ስሞኮ፤","poem":1},{"text":"ኑና ፓፃ ዎ፤ ነ ሱን ጋላታና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ኡባፈ ዎልቃማ ጎዳዉ ፆሳዉ፥ ኑና ዛራ፤","poem":1},{"text":"ኑ አታናዳ ነ ሶምኡዋ ኑስ ፖእሳ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}