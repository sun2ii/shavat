{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_etw","name":"ማዝሙረ ማፃፋ","commonName":"ማዝሙረ ማፃፋ","title":"ማዝሙረ ማፃፋ","order":19,"numberOfChapters":150,"sha256":"0c025deb66520f61a3c823a973fb5df9bd3589998b1748b5e7240ec0298578c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_etw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":81,"content":[{"type":"heading","content":["ሻቃራ ባኣለ ዎደ የፅያ ሳባ"]},{"type":"hebrew_subtitle","content":["ዛማረታ ሀላቃስ ፃፈትዳ ሱሱልኤን የፀትያ አሳፋ ማዝሙረ"]},{"type":"verse","number":1,"content":["ኑስ ዎልቃ ግድዳ ፆሳስ ኡፋይሳን የፅተ፤",{"text":"ያይቆባ ፆሳስ እልልተ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"የ ዶምተ፤ ካራቦ ባቅተ፤","poem":1},{"text":"ዲንነ ማስንቆን የፅተ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"አጌን ፄርያ ዎደ፥","poem":1},{"text":"ቃስ ማ ኡትያ ዎደ፥","poem":2},{"lineBreak":true},{"text":"ባኣለ ጋላሳን ሞይዘ ፑንተ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሄስ እስራኤለ ቢታን ህገ፤","poem":1},{"text":"ያይቆባ ፆሳይ እምዳ ዎጋ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"እ ግብፀ ቢታ ሾጭዳ ዎደ፥","poem":1},{"text":"ዮሰፋ ኮቻስ ሀ ዎጋ አዋጅስ።","poem":2},{"lineBreak":true},{"text":"ኤሮና ዶናን ሀይሳዳ ያግሽን ስአስ፤","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"“ህንተ ሀሽያ ቶሆፐ፥","poem":1},{"text":"ህንተ ኩሽያ ኬሸፐ ሸምፕሳስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ህንተ መቱዋን ታና ፄግደታ፤ ታ ህንተና አሻስ፤","poem":1},{"text":"ታኒ ደችያ ሻራ ግዶፈ ህንተና አላስ፤","poem":2},{"lineBreak":true},{"text":"ማርባ ፑልቱዋ ማታን ታ ህንተና ፓጫስ።” ሳላሀ","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“ታ አሳዉ፥ ታ ህንተና ሴረይሳ ስእተ፤","poem":1},{"text":"እስራኤለ አሳዉ ህንተ ታና ስእኮ አይቤ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ህንተ ግዶን አላጋ ፆሲ ደኦፖ፤","poem":1},{"text":"ሀራ ፆሰ ጎይኖፍተ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ግብፀ ቢታፈ ህንተና ከስዳ፥","poem":1},{"text":"ታኒ ጎዳ ህንተ ፆሳ፤","poem":2},{"text":"ነ ዶና ሎይዳ ሀካንካ፤","poem":1},{"text":"ታኒ እያን ኩንና።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“ሽን ታ አሳይ ታና ስእቦኮና፤","poem":1},{"text":"እስራኤለይ ታዉ ኪተትቤና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሄሳ ግሾ፥ ኤንቲ ባንታ ቆፋ ካላና መላ፥","poem":1},{"text":"ስሞና ኤንታ ዎዛናስ አዳ እማስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታ አሳይ ታና ስእዳኮ አይበ፤","poem":1},{"text":"እስራኤለይ ታ ኦግያ ካልዳኮ አይብ ደእ፤","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ታኒ ኤንታ ሞርከታ ኤሶን ፆናናሽን፤","poem":1},{"text":"ኤንታ እፀይሳታ ቦላ ታ ኩሽያ ደንናሽን።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ጎዳ እፀይሳት እያ ስንን ሆካና፤","poem":1},{"text":"ኤንታ ሴራይ መርናዉ ግዳና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ታኒ ህንተና ሎኦ ግስተ ሙዛና፤","poem":1},{"text":"ዛላፈ ከይያ ኤሳን ህንተና ካልሳና።”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}