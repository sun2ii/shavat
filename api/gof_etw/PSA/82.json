"poem":2}]},{"type":"verse","number":8,"content":[{"text":"ፆሳዉ፥ ደንዳ፤ ቢታ ቦላ ፕርዳ፤","poem":1},{"text":"ካዎተት ኡባይ ነባ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}