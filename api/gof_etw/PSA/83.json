{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_etw","name":"ማዝሙረ ማፃፋ","commonName":"ማዝሙረ ማፃፋ","title":"ማዝሙረ ማፃፋ","order":19,"numberOfChapters":150,"sha256":"0c025deb66520f61a3c823a973fb5df9bd3589998b1748b5e7240ec0298578c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_etw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":83,"content":[{"type":"heading","content":["ፆሳዉ ስእ ጎፓ"]},{"type":"hebrew_subtitle","content":["አሳፋ ማዝሙረ"]},{"type":"verse","number":1,"content":["አቤት ፆሳዉ፥ ስእ ጎፓ፤",{"text":"ፆሳዉ ስርጵ ጎፓ፤ ሙሞፓ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ነ ሞርከት ነ ቦላ ደንደይሳ፥","poem":1},{"text":"ነና እፀይሳት ነ ቦላ ማካለይሳ በአ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኤንቲ ነ አሳ ቦላ ጌማን ዱላቶሶና፤","poem":1},{"text":"ኔኒ ዶስያ አሳ ቦላ ማቀቶሶና።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“ሃይተ፥ ኤንታ ካዎተ ይሶስ፤","poem":1},{"text":"እስራኤለ ጌተትያ ሱንይ መርናዉ ሀሳየቶና መላ ኦስ” ያጎሶና።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኤንቲ እስ ዎዛናን ግድድ ማቀቶሶና፤","poem":1},{"text":"ነ ቦላ ደንዳናዉ ጫቅዶሶና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኤንቲ፥ ኤዶመነ እስማኤላ አሳ፥","poem":1},{"text":"ሞአበነ አጋር ኮቻታ፤","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ገባላነ አሞነ አሳ፥","poem":1},{"text":"አማለቃ፥ ፍልስፄመነ ፅሮሳ አሳ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"አሶረት ኤንታራ ጋሄትዶሶና፤","poem":1},{"text":"አሶረት ሎፀ አሳስ ዎልቃማ ማዶ ግድዶሶና። ሳላሀ","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኔኒ፥ ምድያመ፥ ስሳራነ ያብና ቦላ","poem":1},{"text":"ቅሶና ሻፋን ኦዳይሳዳ ኤንታ ቦላ ኦ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኤንቲ ኤንዶራን ይዶሶና፤","poem":1},{"text":"ኤንታ አሀይ ደንባን ዎቅድ አትስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኤንታ ሀላቃታ ኦሬባነ ዘባዳ ኦ፤","poem":1},{"text":"ኤንታ ሃረይሳታ ዛብሄላነ ስልማናዳ ይሳ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኤንቲ፥ “ኑኒ ፆሳ አሳ ላታ","poem":1},{"text":"ኑስ ቡዞ ኦና” ያግዶሶና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታ ፆሳዉ፥ ኤንታ ባናዳ ላላ፤","poem":1},{"text":"ጫርኮይ ኤፍያ ሱላዳ ኦ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ታም ዎራ መይሳዳ፥","poem":1},{"text":"ታማ ላጮይ ደርያ ፁገይሳዳ፥","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ነ ኡሹዋን ኤንታ የደ፤","poem":2},{"lineBreak":true},{"text":"ነ ጎትያን ኤንታ ዳጋን።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ጎዳዉ፥ አሳይ ነ ሱን ኮያና መላ፥","poem":1},{"text":"ኤንታ ሶምኡዋ ዬላ ማይዛ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ኤንቲ መርናዉ ዬላቶ፤ ህርጎ፤","poem":1},{"text":"ካዉይድ ዮ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ነ ሱንይ ጎዳ ግድዳ ነ ፃላል፥","poem":1},{"text":"ኡባፈ ቃ ፆሳይ፥","poem":2},{"lineBreak":true},{"text":"ሳአ ኡባ ሃረይሳ ኤንቲ ኤሮ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}