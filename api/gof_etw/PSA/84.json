{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_etw","name":"ማዝሙረ ማፃፋ","commonName":"ማዝሙረ ማፃፋ","title":"ማዝሙረ ማፃፋ","order":19,"numberOfChapters":150,"sha256":"0c025deb66520f61a3c823a973fb5df9bd3589998b1748b5e7240ec0298578c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_etw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":84,"content":[{"type":"heading","content":["ፆሳ ኬ ብሸ የፅያ ማዝሙረ"]},{"type":"hebrew_subtitle","content":["ዛማረታ ሀላቃስ ቆረ ናይት ፃፍዳ ሱሱልኤን የፀትያ ማዝሙረ"]},{"type":"verse","number":1,"content":["ኡባፈ ዎልቃማ ጎዳዉ፥",{"text":"ነ ደእያ በሳይ ዋን ሎእ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታኒ ጎዳ ኬ ዳባባ ላሞታይስ፤","poem":1},{"text":"ታ ኩመ አሳተይ","poem":2},{"lineBreak":true},{"text":"ደኦ ፆሳስ ኡፋይሳን የፄስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኡባፈ ዎልቃማ ጎዳዉ፥","poem":1},{"text":"ታ ካዋዉ፥ ታ ፆሳዉ፥","poem":2},{"lineBreak":true},{"text":"ነ ያርሾ በሳ ማታን","poem":2},{"lineBreak":true},{"text":"ቡበ ካፎይ ባዉ ደእያ በሲ ደማሱ፤","poem":2},{"lineBreak":true},{"text":"ሆለይካ ባ ናይታ ዎያ ኬ ኬፃሱ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ነ ኬን ደኤይሳትነ","poem":1},{"text":"መርናዉ ነና ሳበይሳት አንጀትዳይሳታ። ሳላሀ","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ነና ባንታ ምኖተ ኦይሳት፥","poem":1},{"text":"ባንታ ዎዛና ፅዮነ ኦግያ ቦላ፥","poem":2},{"lineBreak":true},{"text":"ዎይሳት አንጀትዳይሳታ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኤንቲ ዬሆ ዛንጋራራ አያ ዎደ፥","poem":1},{"text":"ሄ በሳይ ፑልቶይ ከይያ በሲ ግድስ፤","poem":2},{"lineBreak":true},{"text":"ቶርቸ እራይ ቡክድ ኦላ ኩንስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኤንቲ ዎልቃ ቦላ ዎልቃ ጉጅ ጉጅ ባና፤","poem":1},{"text":"እሶይ እሶይ ፆሳ ስንን ፅዮነን በንታና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኡባፈ ዎልቃማ ጎዳዉ ፆሳዉ፥","poem":1},{"text":"ታ ዎሳ ኔኒ ስአ፤","poem":2},{"lineBreak":true},{"text":"ያይቆባ ፆሳዉ ሀይዛ። ሳላሀ","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ፆሳዉ፥ ኑ ጎንዳልያ በአ፤","poem":1},{"text":"ነ ዶርዳ ካዋ ኬሀ አይፈን ፄላ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታኒ ሀራ በሳን ሙኩሉ ጋላስ ዳናፐ፥","poem":1},{"text":"ነ ዳባባን እስ ጋላስ ደኤይስ ታዉ ሎኦ።","poem":2},{"text":"ኢታታ ዱንካንያን ዳናፐ፥","poem":1},{"text":"ፆሳ ኬ ፐንገ ናጎይ ታዉ ሎኦ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጎዳ ፆሳይ ኑስ ጎንዳለነ ፖኦ፤","poem":1},{"text":"ኑስ ቦንቾነ ኬሀተ እሜስ፤","poem":2},{"lineBreak":true},{"text":"ሱረተን ሄመተይሳታ ሎኦባ ድገና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኡባፈ ዎልቃማ ጎዳዉ፥","poem":1},{"text":"ነናን አማነተይሳት አንጀትዳይሳታ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}