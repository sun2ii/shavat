em":1},{"text":"ኤንቲ ባንታ ኤያ ኦግያኮ ስሞና እፅኮ፥","poem":2},{"lineBreak":true},{"text":"እ ባ ጌሻ ደርያስ ሳሮተ ኦዴስ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እያ ቦንቾይ ኑ ቢታን ዳና መላ፥","poem":1},{"text":"ፆሳ ያየይሳታ አሻናዉ እ ማታን ደኤስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሲቆይነ ቱማተ ጋሄትዶሶና፤","poem":1},{"text":"ፅሎተነ ሳሮተ እድመትዶሶና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ቱማተ ሳኣፐ ፑደ ከዬስ፤","poem":1},{"text":"ፅሎተ ሳሎፐ ዱገ ፄሌስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ፆሳይ ሎኦባ ኑስ እማና፤","poem":1},{"text":"ኑ ቢታይ ዳሮ ካ አይፋና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ፅሎተ ጎዳ ስንን ሄመታና፤","poem":1},{"text":"እያ ኦግያ ጊግሳና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}