"type":"verse","number":38,"content":[{"text":"ሽን ሀእ ነ ትይዳ ካዋ ቦላ ሀንቀታዳሳ፤","poem":1},{"text":"እያ እፃዳሳ፤ አጋዳሳ።","poem":2}]},{"type":"verse","number":39,"content":[{"text":"ነ አይልያራ ጫቅዳ ጫቁዋ መንዳሳ፤","poem":1},{"text":"እያ ካላቻ ባናን ሆላዳ ቱንሳዳሳ።","poem":2}]},{"type":"verse","number":40,"content":[{"text":"እያ ካታማ ግምበ ድርሳ ላላዳሳ፤","poem":1},{"text":"እያ ሚፃ ይሳዳሳ።","poem":2}]},{"type":"verse","number":41,"content":[{"text":"ኦገራ አያ ኡባይ እያ ቦንቅዶሶና፤","poem":1},{"text":"እ ባ ሾሮታስ ሚቻስ አትስ።","poem":2}]},{"type":"verse","number":42,"content":[{"text":"እያ ሞርከታስ ፆኖ እማዳሳ፥","poem":1},{"text":"ኤንታ ኡባ ኡፋይሳዳሳ።","poem":2}]},{"type":"verse","number":43,"content":[{"text":"እያ ማሻ ፄራ ቃላምአዳሳ፤","poem":1},{"text":"እያ ኦላን ማዳባካ።","poem":2}]},{"type":"verse","number":44,"content":[{"text":"እያ ካዎታ ፃምኣ እያ ኩሸፐ ኤካዳሳ፤","poem":1},{"text":"እያ አራታ ቢታን ሆላዳሳ።","poem":2}]},{"type":"verse","number":45,"content":[{"text":"እያ ያላጋተ ዎድያ ቃምሳዳሳ፤","poem":1},{"text":"እያ ዬላ ማይዛዳሳ። ሳላሀ","poem":2}]},{"type":"verse","number":46,"content":[{"text":"ጎዳዉ፥ ኔኒ አዉደ ጋካናዉ ጋምአይ?","poem":1},{"text":"ኔኒ መርናዉ ጌማኔ?","poem":2},{"lineBreak":true},{"text":"ነ ሀንቆይ ታማዳ አዉደ ጋካናዉ ኤፃኔ?","poem":2}]},{"type":"verse","number":47,"content":[{"text":"ታ ላይይ አይ መላ ቃንኮ ቆፓ፤","poem":1},{"text":"አሳ ኡባ ጮ መላ መድ!","poem":2}]},{"type":"verse","number":48,"content":[{"text":"ሀይቆፐ አታናዉ ዳንዳእያ አስ ደኢ?","poem":1},{"text":"ዱፎ ገሎና ዳናዉ ዳንዳኤይ ኦኔ? ሳላሀ","poem":2}]},{"type":"verse","number":49,"content":[{"text":"ጎዳዉ፥ ኔኒ ነ ቱማተን ዳዊታስ ጫቅዳ፥","poem":1},{"text":"ነ ሲቆይ አዉን ደኢ?","poem":2}]},{"type":"verse","number":50,"content":[{"text":"ጎዳዉ፥ ነ አይለይ አይ መላ ቦረትዳኮ በአ፤","poem":1},{"text":"አሳ ኡባ ቦርያ ዋታ ዳንዳእዳኮ ሀሳያ።","poem":2}]},{"type":"verse","number":51,"content":[{"text":"ጎዳዉ፥ ነ ሞርከት ቀልቅስዳይሳ፥","poem":1},{"text":"ነ ትይዳ ካዋ ታንጎን ታንጎን ቦረይሳ በአ።","poem":2}]},{"type":"verse","number":52,"content":[{"text":"ጎዳይ መርናዉ ጋላተቶ!","poem":1},{"lineBreak":true},"አምንእ! አምንእ!"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":52}