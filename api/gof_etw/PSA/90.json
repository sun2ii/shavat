em":2}]},{"type":"verse","number":8,"content":[{"text":"ኑ ኢታ ኦሱዋ ነ ስንን ዎዳሳ፤","poem":1},{"text":"ኑ ጌምዳ ናጋራ ነ ሶምኡዋ ፖኡዋን ዎዳሳ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኑ ጋላሳ ኡባይ ነ ሀንቁዋን አስ፤","poem":1},{"text":"ኑ ላይ ኦለን ዉርሶስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኑ ደኦ ላይይ ላፑን ታማ፤","poem":1},{"text":"ዎይኮ ዳርኮ ሆስፑን ታማ።","poem":2},{"text":"ሄስካ መቶይነ ዋየይ ኩምዳይሳ፤","poem":1},{"text":"ኑ ላይይ ኤሶን ዉሬስ፤ ኑካ ኤሶን አኦስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ነ ሀንቁዋ ዎልቃ ኤረይ ኦኔ?","poem":1},{"text":"ነ ሀንቁዋ ሱሎይ ዎልቃማ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኑ ላይ ማራ ኦገን ኑ ጎኤታና መላ፥","poem":1},{"text":"ኑና ጭንጫተ ታማርሳ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ጎዳዉ፥ ነ ሀንቆይ አዉደ ጋካናሴ?","poem":1},{"text":"ሀያና ነ አይለታስ ቃታ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኑ ላይ ኡባን","poem":1},{"text":"ኑ ኡፋይታናዳነ የፃናዳ፥","poem":2},{"lineBreak":true},{"text":"ዎንታ ዎንታ ነ ሲቁዋ ኑና ካልሳ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ነ ኑና መቶዳ ጋላሳታ ኬና፥","poem":1},{"text":"ኑኒ ኡንኤትዳ ላይታ ኬና ኑና ኡፋይሳ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኑስ ነ አይለታስ ነ ኦሶይ ቆንጮ፤","poem":1},{"text":"ነ ቦንቾይ ኤንታ ናይታስ በንቶ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ጎዳ ኑ ፆሳ ኬሀተይ ኑ ቦላ ግዶ፤","poem":1},{"text":"ኑ ኩሸ ኦሶ ኡባ ኑስ አይፍሳ፤","poem":2},{"lineBreak":true},{"text":"ኤ፥ ኑ ኩሸ ኦሶ ኡባ አይፍሳ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}