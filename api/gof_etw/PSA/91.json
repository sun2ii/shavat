ntent":[{"text":"ኢታት ሴረትሽን፥","poem":1},{"text":"ኔኒ ነ አይፈ ፃላላን በአና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኔኒ ጎዳ ነዉ ቆሰታዳ አትያ በሲ ኦዳ ግሾነ፥","poem":1},{"lineBreak":true},{"text":"ኡባፈ ቃ ፆሳ ነ ደእያ በሲ ኦዳ ግሾ፥","poem":1}]},{"type":"verse","number":10,"content":[{"text":"ኢታባይ ነና ቦቸና፤","poem":2},{"lineBreak":true},{"text":"ጋዶይ ነ ኬኮ ሺቀና።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ነ ኦገ ኡባን ነና ናጋና መላ፥","poem":1},{"text":"ፆሳይ ባ ኪታንቾታ ኪታና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ነ ቶሆይ ሹቻን በቶና መላ፥","poem":1},{"text":"ኪታንቾት ባንታ ኩሸን ነና ደንና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኔኒ ጋሞነ ሾሻ ቦላ ሄመታና፤","poem":1},{"text":"ዎዳላ ጋሞነ ኢታ ሾሻ የና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ፆሳይ፥","poem":1},{"text":"“እ ታና ሲቅዳ ግሾ ታኒ እያ አሻና፤","poem":2},{"lineBreak":true},{"text":"ታ ሱን ኤርያ ግሾ ታኒ እያ ናጋና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እ ታና ፄግያ ዎደ ታኒ እያዉ ኮያና፤","poem":1},{"text":"መቶ ዎደ ታኒ እያራ ግዳና፤","poem":2},{"lineBreak":true},{"text":"ታኒ እያ አሻናነ ቦንቻና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ታኒ እያ ላይ አዱሳና፤","poem":1},{"text":"ታ አቶተ እያ በሳና” ያጌስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}