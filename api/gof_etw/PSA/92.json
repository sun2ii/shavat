{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_etw","name":"ማዝሙረ ማፃፋ","commonName":"ማዝሙረ ማፃፋ","title":"ማዝሙረ ማፃፋ","order":19,"numberOfChapters":150,"sha256":"0c025deb66520f61a3c823a973fb5df9bd3589998b1748b5e7240ec0298578c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_etw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":92,"content":[{"type":"heading","content":["ፆሳ ኦሶይ ግታ"]},{"type":"hebrew_subtitle","content":["ሳምባታ ጋላሳ ማዝሙረ"]},{"type":"verse","number":1,"content":["ጎዳ ጋላቶይ ሎኦ፤",{"text":"ኡባፈ ቃ ፆሳዉ፥","poem":2},{"lineBreak":true},{"text":"ነ ሱን ሳቦይ ሎኦ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዎንታ ዎንታ ነ ሲቁዋ ኦዶይ፥","poem":1},{"text":"ቃማ ነ አማነተ አዋጆይ ሎኦ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታሙ ሻያን ዋፀትዳ ዲን","poem":1},{"text":"ማስንቆ ካእሸ ነና ጋላቶይ ሎኦ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታኒ ነ ኦሱዋን ኡፋይትዳ ግሾ፥","poem":1},{"text":"ነ ኩሸ ኦሱዋ ግሾ ነና ጋላታይስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ጎዳዉ፥ ነ ኦሶይ አይ መላ ግተ!","poem":1},{"text":"ነ ቆፋይ አይ መላ ጪሞ!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኤያ አስ ኤራናዉ ዳንዳኤና፤","poem":1},{"text":"ዎዛን ባይና አስ አኬካናዉ ዳንዳኤና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኢታት ማታዳ ድጭኮካ፥","poem":1},{"text":"ኢታ ኦይሳት ዳይኮካ፥","poem":2},{"lineBreak":true},{"text":"ኤንቲ መርናዉ ያና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሽን አቤት ጎዳዉ፥","poem":1},{"text":"ኔኒ መርናዉ ኡባፈ ቃ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አቤት ጎዳዉ፥ ቱማ ነ ሞርከት ያና፤","poem":1},{"text":"ኢታ ኦያ ኡባይ ፕስክ ጋና።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታ ካጭያ መን ካጨዳ ቁ ኦዳሳ፤","poem":1},{"text":"ሎኦ ዛይተ ታ ሁጰን ትያዳሳ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታ ሞርከት ፆነትሽን ታ አይፈን በአስ፤","poem":1},{"text":"ታና ኡንኤይሳት ዋስሽን ታ ሀይን ስአስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ፅሎት ዛምባዳ ድጫና፤","poem":1},{"text":"ልባኖሰ ዝጋዳ ዳያና።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኤንቲ ጎዳ ኬን ቶከትዳ ም መላ፤","poem":1},{"text":"ኤንቲ ኑ ፆሳ ዳባባን ዳና።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኤንቲ ጬግድካ አይፋና፤","poem":1},{"text":"ኤንቲ እርፃነ ጭልኦ ግድድ ዳና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኤንቲ፥ “ጎዳይ ሱረ፤","poem":1},{"text":"እ ታ ዛላ፤ እያን ኢታተ ባዋ” ያጋና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}