:9,"content":[{"text":"ሀይ ኦዳ ፆሳይ ስኤኔ?","poem":1},{"text":"አይፈ መዳ ጎዳይ በኤኔ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ካዎተታ ሴርያ ፆሳይ ሴረኔ?","poem":1},{"text":"አሰ ኤራተ ታማርስያ እ፥ ኤረኔ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጎዳይ አሳ ቆፍ ፓናባነ","poem":1},{"text":"ሀዳ ግደይሳ ኤሬስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"አቤት ጎዳዉ፥ ኔኒ ሴርያ አስነ","poem":1},{"text":"ነ ህግያ ታማርስያ አስ አንጀትዳይሳ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኢታት ኩንድያ ኦላይ ቦከታና ጋካናዉ፥","poem":1},{"text":"መቶ ጋላስ ኔኒ እያ ሸምፕሳሳ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ፆሳይ ባ አሳ የገና፤","poem":1},{"text":"እ ባ ላታ አገና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ፕርድ ስሚድ ፅሎተ ቦላ ኤቃና፤","poem":1},{"text":"ዎዛና ሱረት ኡባይ ፅሎ ፕርዳ ካላና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ማካላንቾታ ቦላ ታ ግሾ ደንደይ ኦኔ?","poem":1},{"text":"ኢታ ኦይሳታራ ታ ግሾ ኤቀተይ ኦኔ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ጎዳይ ታና ማዶናኮ፥","poem":1},{"text":"ታኒ ኤሶን ዱፎ ገላዳ አታናሽን።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ታኒ፥ “ታ ቶሆይ ሀልፅስ” ግዳ ዎደ፥","poem":1},{"text":"ነ ሲቆይ ታና ካትስስ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ታ ዎዛናን ኡንኤተ ኩምዳ ዎደ፥","poem":1},{"text":"ኔኒ ታና ዎፑ ኦዳ ኡፋይሳሳ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ህገ ሻርያ ጌላ ዳይናታራ","poem":1},{"text":"ጌላ አሳራ ኔኒ ሃሼታይ?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ፅሎታ ዎናዉ ኤንቲ ቶቦሶና፤","poem":1},{"text":"ሱረታ ቦላ ሀይቆ ፕርዶሶና።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ግዶሽን ጎዳይ ታ ሚፃ፤","poem":1},{"text":"ታ ፆሳይ ታኒ ቆሰታዳ አትያ ዛላ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ኤንታ ኢታተ ግሾ እ ኤንታ ሴራና፤","poem":1},{"text":"ኤንታ ናጋራ ግሾ እ ኤንታ ይሳና፤","poem":2},{"lineBreak":true},{"text":"ጎዳይ ኑ ፆሳይ ኤንታ ይሳና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/95.json","nextChapterAudioLinks":{},"previousC