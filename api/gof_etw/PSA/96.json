{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_etw","name":"ማዝሙረ ማፃፋ","commonName":"ማዝሙረ ማፃፋ","title":"ማዝሙረ ማፃፋ","order":19,"numberOfChapters":150,"sha256":"0c025deb66520f61a3c823a973fb5df9bd3589998b1748b5e7240ec0298578c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_etw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":96,"content":[{"type":"heading","content":["ፆሳ ጌሻተን ጎይንተ"]},{"type":"verse","number":1,"content":["ጎዳስ ኦራ ማዝሙረ የፅተ፤",{"text":"ሳአን ደእያ አሳ ኡባይ ጎዳስ የፅተ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ጎዳስ የፅተ፤ እያ ሱን ሳቢተ፤","poem":1},{"text":"እያ አሹዋ ጋላስ ጋላስ ኦድተ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ካዎተታ ግዶን እያ ቦንቹዋ፥","poem":1},{"text":"አሳ ኡባ ግዶን እያ ማላልስያ ኦሱዋ አዋጅተ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ጎዳይ ግታ ግድያ ግሾ እያዉ ግታ ጋላቲ በሴስ፤","poem":1},{"text":"ፆሳታ ኡባፈ አድ ያየታናዉ በሴስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሀራ ካዎተታ ፆሳት ኡባይ ኤቃታ፤","poem":1},{"text":"ሽን ጎዳይ ሳሎታ መዳ ፆሳ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ቦንቾይነ ሳብ እያ ዩሾን ደኤስ፤","poem":1},{"text":"ምኖተነ ፑላተ እያ ኬን ደኤስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ቢታን ደእያ አሳ ዛረ ኡባይ ጎዳባ ኦድተ፤","poem":1},{"text":"ቦንቾይነ ዎልቅ ጎዳባ ጊተ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"እያ ሱንስ በሲያ ቦንቹዋ ጎዳስ ኤህተ፤","poem":1},{"text":"ያርሾ ኤክድ እያ ዳባባ ገልተ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እያ ጌሻተ ቴሙዋን ጎዳ ጎይንተ፤","poem":1},{"text":"ቢታን ደእያ አሳዉ ኡባይ እያ ስንን ኮኮርተ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ካዎተታ ግዶን፥ “ጎዳይ ካዎትስ!","poem":1},{"text":"ሳአይ ምንድ ኤቅስ፤ ቃፀና፤","poem":2},{"lineBreak":true},{"text":"እ አሳ ቦላ ሱረ ፕርዳና” ያግተ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሳሎት ኡፋይቶ፤ ሳእካ ሀሹ ጎ፤","poem":1},{"text":"አባይነ እያ ግዶን ደእያ ኡባይ ጉሞ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ጎሻይነ እያን ደእያ ኡባይ ኡፋይቶ!","poem":1},{"text":"ዎራን ደእያ ም ኡባይ ኡፋይሳን የፆ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ጎዳይ ያ ግሾ እያ ስንን የፆ፤","poem":1},{"text":"እ ሳአ ቦላ ፕርዳናዉ ዬስ።","poem":2},{"text":"እ ሀ ሳኣ ቦላ ፅሎተን፥","poem":1},{"text":"አሳ ቦላ ቱማተን ፕርዳና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}