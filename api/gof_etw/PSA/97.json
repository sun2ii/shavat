"ነ ፅሎ ፕርዳ ስእድ ኡፋይቴስ፤","poem":2},{"lineBreak":true},{"text":"ይሁዳ ማጫ ናይትካ ሀሹ ጎሶና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አቤት ጎዳዉ፥ ኔኒ ሳአ ኡባ ቦላ ቃ፤","poem":1},{"text":"ፆሳታ ኡባፈ ኔኒ ቁ ጋዳሳ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ጎዳ ዶሰይሳቶ፥ ኢታ እፅተ፤","poem":1},{"text":"እያን አማነተይሳታ ሸምፑዋ እ ናጌስ፤","poem":2},{"lineBreak":true},{"text":"ኢታታ ኩሸፐ ኤንታ አሼስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ፅሎታ ቦላ ፖኦይ ፖኤስ፤","poem":1},{"text":"ዎዛና ሱረታስ ኡፋይስ ደኤስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ህንተኖ ፅሎቶ፥ ጎዳን ኡፋይትተ፤","poem":1},{"text":"እያ ጌሻ ሱን ጋላትተ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}