{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_etw","name":"ማዝሙረ ማፃፋ","commonName":"ማዝሙረ ማፃፋ","title":"ማዝሙረ ማፃፋ","order":19,"numberOfChapters":150,"sha256":"0c025deb66520f61a3c823a973fb5df9bd3589998b1748b5e7240ec0298578c7","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_etw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":98,"content":[{"type":"heading","content":["ፆሳስ ኡፋይሳን እልልተ"]},{"type":"hebrew_subtitle","content":["ማዝሙረ"]},{"type":"verse","number":1,"content":["ጎዳይ ማላልስያባ ኦዳ ግሾ፥",{"text":"እያዉ ኦራ ማዝሙረ የፅተ።","poem":2},{"lineBreak":true},{"text":"እያ ኡሻቻ ኩሸይ፥ እያ ጌሻ ቀሰይ","poem":2},{"lineBreak":true},{"text":"እያዉ ፆኖ እሚስ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ጎዳይ ባ ፆኑዋ ኤርስስ፤","poem":1},{"text":"ባ ፅሎተ ካዎተታስ ቆንጭስስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"እ እስራኤለ አሳ ሲቀይሳነ","poem":1},{"text":"ኤንታዉ አማነተይሳ ሀሳይስ።","poem":2},{"text":"ሳኣ ጋፃ ጋካናዉ ደእያ አሳ ኡባይ","poem":1},{"text":"ኑ ፆሳ አቶተ በእዶሶና።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሳአ ቦላ ደእያ አሳዉ፥","poem":1},{"text":"ጎዳስ ኡፋይሳን የፅተ፤","poem":2},{"lineBreak":true},{"text":"ኡፋይሳን እልልሸ ሳቢተ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ጎዳስ ዲ ዲፅተ፤","poem":1},{"text":"ዲንነ ማዝሙረን ጎዳ ሳቢተ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሱሱልኤነ ሞይዘ ፑንሸ፥","poem":1},{"text":"ኡፋይሳን ጎዳ ኑ ካዋ ስንን የፅተ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"አባይነ አባ ግዶን ኩምዳ ኡባይ ጉሞ፤","poem":1},{"text":"ሳአይነ ሳኣ ቦላ ደእያ ኡባይ የፆ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሻፋት ባንታ ኩሽያ ባቆ፤","poem":1},{"text":"ዙማት እስፈ ጎዳ ስንን ኡፋይሳን የፆ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ጎዳይ ሳኣ ቦላ ፕርዳናዉ ዬስ፤","poem":1},{"text":"እ ሀ ሳኣ ቦላ ፅሎተን","poem":2},{"lineBreak":true},{"text":"አሳ ቦላ ሱረተን ፕርዳና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}