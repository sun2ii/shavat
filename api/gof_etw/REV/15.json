{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"REV","translationId":"gof_etw","name":"ዮሃንሳ ቆንጨ","commonName":"ዮሃንሳ ቆንጨ","title":"ዮሃንሳ ቆንጨ","order":66,"numberOfChapters":22,"sha256":"5d24bcb2146bb10a779c94bf836539eb5919a5ed61bc0246a37ea5a43ebfb46d","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/gof_etw/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":15,"content":[{"type":"heading","content":["ዉርሰ ቦሻታ"]},{"type":"verse","number":1,"content":["ታኒ ሳሎን ሀራ ግታነ ማላልስያ ማላታ በአስ። ፆሳ ዉርሰ ሀንቁዋ ቆንጭስያ ላፑን ቦሻታ ኦይክዳ ላፑን ኪታንቾት ደኦሶና።"]},{"type":"verse","number":2,"content":["ቃስ ታማራ ዋላከትዳ ቡርጩኮ አባ ዳነይሳ በአስ። ሄ አባ ጋፃን ዶኣ፥ እያ ምስልያነ እያ ሱን ታይቡዋ ፆንዳይሳታ በአስ። ፆሳይ ኤንታዉ እምዳ ዲ ኦይክድ ኤቅዶሶና።"]},{"type":"verse","number":3,"content":["ኤንቲ ፆሳ አይልያ ሙሰ ማዝሙርያነ ዶርሳ ማዝሙርያ ሀይሳዳ ያግድ የፆሶና።",{"text":"“ጎዳዉ፥ ኡባፈ ዎልቃማ ፆሳዉ፥","poem":1},{"text":"ነ ኦሶይ ግታነ ማላልስያባ።","poem":2},{"text":"ደረ ኡባ ካዋዉ፥","poem":1},{"text":"ነ ኦገይ ፅሎነ ቱማ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ጌሽ ነ ፃላላ ግድያ ግሾ፥","poem":1},{"text":"ጎዳዉ፥ ነዉ ያዮናይነ","poem":2},{"lineBreak":true},{"text":"ነ ሱን ቦንቾናይ ኦኔ?","poem":2},{"text":"ነ ፅሎ ኦሶይ አሳ ኡባስ ቆንጨ ግድያ ግሾ፥","poem":1},{"text":"ካዎተ ኡባይ ነ ስን ይድ ጎይናና”","poem":2},"ያግድ የፆሶና።"]},{"type":"verse","number":5,"content":["ሄሳፈ ጉየ፥ ሳሎን ዶየትድ ደእያ ፆሳ ኬ፥ እካ ማርካተ ዱንካንያ በአስ።"]},{"type":"verse","number":6,"content":["ላፑን ቦሻታ ኦይክዳ ላፑን ኪታንቾት ፆሳ ኬፈ ከይዶሶና። ኤንቲ ጌሽነ ጶልያ ሊኖ ማኦ ማእዶሶና፤ ባንታ ትራን ዎርቃ ዳንጮ ዳንጭዶሶና።"]},{"type":"verse","number":7,"content":["ኦይዱ መተታፐ እሶይ፥ መርናዉ ደእያ ፆሳ ሀንቆይ ኩምዳ ላፑን ዎርቃ ፁአታ ላፑን ኪታንቾታስ እሚስ።"]},{"type":"verse","number":8,"content":["ፆሳ ቦንቹዋፈነ እያ ዎልቃፈ ደንዶይሳን ፆሳ ኬይ ጩያን ኩምስ። ላፑን ኪታንቾት ኦይክዳ ላፑን ቦሻት ፖለታና ጋካናዉ ፆሳ ኬ ኦንካ ገላናዉ ዳንዳእቤና።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/REV/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/REV/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/REV/14.json","previousChapterAudioLinks":{},"numberOfVerses":8}