{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"REV","translationId":"gof_etw","name":"ዮሃንሳ ቆንጨ","commonName":"ዮሃንሳ ቆንጨ","title":"ዮሃንሳ ቆንጨ","order":66,"numberOfChapters":22,"sha256":"5d24bcb2146bb10a779c94bf836539eb5919a5ed61bc0246a37ea5a43ebfb46d","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/gof_etw/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":5,"content":[{"type":"heading","content":["ዶርሳነ ፃ ማፃፋ"]},{"type":"verse","number":1,"content":["ሄሳፈ ጉየ፥ አራታ ቦላ ኡትዳይሳ ኡሻቻ ኩሸን ግዶራነ ካረራ ፃፈትዳ ላፑን ማታመን ጎርደትዳ ፃ ማፃፋ በአስ።"]},{"type":"verse","number":2,"content":["እስ ምኖ ኪታንቾይ ባ ቃላ ቁ ኦድ፥ “ማታምያ ብላናዉነ ማፃፋ ዶያናዉ በሰይ ኦኔ?” ያግድ አዋጅሽን በአስ።"]},{"type":"verse","number":3,"content":["ሽን ሳሎን ግድን ሳአን ዎይኮ ሳአፐ ጋርሳን ግድን ሄ ፃ ማፃፋ ብላናዉነ ግዱዋ በአናዉ ዳንዳኤይ ኦንካ በንትቤና።"]},{"type":"verse","number":4,"content":["ፃ ማፃፋ ብላናዉነ እያ ግዱዋ በአናዉ በሲያ አስ ይዳ ግሾ ታ ዳሮ ዬካስ።"]},{"type":"verse","number":5,"content":["ያትን፥ ጭማታፐ እሶይ ታኮ፥ “ዬኮፋ! ሄኮ፥ ይሁዳ ኮቸ ግድያ ጋሞይ፥ ዳዊታ ሼሻይ፥ ላፑን ማታመታ ብላናዉነ ማፃፋ ዶያናዉ ዳንዳእስ” ያግስ።"]},{"type":"verse","number":6,"content":["ሄሳፈ ጉየ፥ ሹከትዳ ዶርሳይ አራታስ፥ ኦይዱ ደኦን ደእያ መተታስነ ጭማታስ ግዶን፥ ኤቅዳይሳ በአስ። እያዉ ላፑን ካጨትነ ላፑን አይፈት ደኦሶና። ሄሳት ሳአ ኡባ ኪተትዳ ፆሳ ላፑን አያናታ።"]},{"type":"verse","number":7,"content":["ሄ ዶርሳይ ብድ፥ አራታ ቦላ ኡትዳይሳ ኡሻቻ ኩሸፐ ፃ ማፃፋ ኤክስ።"]},{"type":"verse","number":8,"content":["እ ሄ ፃ ማፃፋ ኤክዳ ዎደ፥ ደኦን ደእያ ኦይዱ መተትነ ላታማነ ኦይዱ ጭማት ዶርሳ ስንን ኩንድዶሶና። ኤንቲ እሶይ እሶይ ዲነ ጌሻታ ዎሳ ግድዳ እፃነይ ኩምዳ ዎርቃ ሻተ ኦይክዶሶና።"]},{"type":"verse","number":9,"content":["ኤንቲ፥",{"text":"“ፃ ማፃፋ ኤካናዉ፥","poem":1},{"text":"ማታመታ ብላናዉ ነዉ በሴስ።","poem":2},{"text":"አይስ ጊኮ፥ ኔኒ ሹከታዳሳ፤","poem":1},{"text":"ኮቸ ኡባፈ፥ ዱማ ዱማ ዶናፐ፥","poem":2},{"lineBreak":true},{"text":"ያራታፐነ ካዎተታ ኡባፈ","poem":2},{"lineBreak":true},{"text":"ነ ሱን ፆሳስ ዎዛዳሳ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኤንቲ እያ ፆሳ አዋስ ኦና መላ","poem":1},{"text":"ኤንታና ካህነ ካዎተ ኦዳሳ።","poem":2},{"text":"ኤንትካ ቢታ ኡባ ሃራና”","poem":1},"ያግድ ኦራ ማዝሙረ የፅዶሶና።"]},{"type":"verse","number":11,"content":["ታ በእያ ዎደ ሙኩሉ ቶሆ ሙኩሉነ ታሙ ሙኩሉ ቶሆ ታሙ ሙኩሉ ግድያ ኪታንቾታ ግርሳ ስአስ። ኤንትካ አራታ፥ ኦይዱ ደኦን ደእያ መተታነ፥ ጭማታ ዩሹዋን ኤቅዶሶና።"]},{"type":"verse","number":12,"content":["ሄ ኪታንቾት ቁ ግዳ ቃላን፥",{"text":"“ሹከትዳ ዶርሳይ ዎልቃ፥ ዱረተ፥","poem":1},{"text":"ጭንጫተነ ምኖተ፥","poem":2},{"lineBreak":true},{"text":"ቦንቾ፥ ሳባነ ጋላታ ኤካናዉ በሴስ”","poem":2},"ያግዶሶና።"]},{"type":"verse","number":13,"content":["ሄሳፈ ጉየ፥ ሳአን፥ ሳሎን፥ ሳአፐ ጋርሳንነ አባ ግዶን ደእያ መተ ኡባይ፥",{"text":"“አራታ ቦላ ኡትዳይሳስነ ዶርሳስ፥","poem":1},{"text":"ጋላታይ፥ ቦንቾይ፥ ሳብነ ዎልቅ፥","poem":2},{"lineBreak":true},{"text":"መር መርናዉ ግዶ”","poem":2},"ያግድ የፅሽን ስአስ።"]},{"type":"verse","number":14,"content":["ኦይዱ ደኦን ደእያ መተት፥ “አምንእ” ያግዶሶና፤ ቃስ ጭማት ጉፋንድ ጎይንዶሶና።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/REV/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/REV/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/REV/4.json","previousChapterAudioLinks":{},"numberOfVerses":14}