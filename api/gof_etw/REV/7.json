{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"REV","translationId":"gof_etw","name":"ዮሃንሳ ቆንጨ","commonName":"ዮሃንሳ ቆንጨ","title":"ዮሃንሳ ቆንጨ","order":66,"numberOfChapters":22,"sha256":"5d24bcb2146bb10a779c94bf836539eb5919a5ed61bc0246a37ea5a43ebfb46d","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/gof_etw/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":7,"content":[{"type":"heading","content":["144,000 አሳት ማለትዶሶና"]},{"type":"verse","number":1,"content":["ሄሳፈ ጉየ፥ ኦይዱ ኪታንቾት ኦይዱ ሳኣ ጋፃን ኤቅዳይሳታ በአስ። ሄ ኪታንቾት ሳአ ቦላ ዎይኮ አባ ቦላ ዎይኮ አይ ም ቦላ ጫርኮይ ኦይዱ ሳኣ ጋፃፐ ጫርኮና መላ ተቅዶሶና።"]},{"type":"verse","number":2,"content":["ቃስ ደኦ ፆሳ ማታምያ ኦይክዳ ሀራ ኪታንቾይ ዶሎሀ ባጋፈ ከየይሳ በአስ። ሄ ኪታንቾይ ባ ቃላ ቁ ኦድ፥ ሳኣነ አባ ቆሀናዉ ዎልቅ እመትዳ ኦይዱ ኪታንቾታ፥"]},{"type":"verse","number":3,"content":["ፄግድ፥ “ኑኒ ፆሳ አይለታ ሶምኦን ማታምያ ዎና ጋካናዉ ቢታ ዎይኮ አባ ዎይኮ ም ቆሆፕተ” ያግስ።"]},{"type":"verse","number":4,"content":["ያትን፥ ታኒ ፆሳ ማታመይ ሶምኦን ዎሰትዳይሳታ ፓይዱዋ ስአስ። እስራኤለ ማይዛታ ኡባፈ 144,000 አሳስ ሶምኦን ማታመ ዎስ።"]},{"type":"verse","number":5,"content":[{"text":"ይሁዳ ኮቻፈ ታማነ ናምኡ ሙኩሉ፥","poem":1},{"lineBreak":true},{"text":"ሮቤላ ኮቻፈ ታማነ ናምኡ ሙኩሉ፥","poem":1},{"lineBreak":true},{"text":"ጋደ ኮቻፈ ታማነ ናምኡ ሙኩሉ፥","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"አሴራ ኮቻፈ ታማነ ናምኡ ሙኩሉ፥","poem":1},{"lineBreak":true},{"text":"ንፍታለመ ኮቻፈ ታማነ ናምኡ ሙኩሉ፥","poem":1},{"lineBreak":true},{"text":"ምናሰ ኮቻፈ ታማነ ናምኡ ሙኩሉ፥","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ስሞና ኮቻፈ ታማነ ናምኡ ሙኩሉ፤","poem":1},{"lineBreak":true},{"text":"ሌወ ኮቻፈ ታማነ ናምኡ ሙኩሉ፥","poem":1},{"lineBreak":true},{"text":"ይሳኮራ ኮቻፈ ታማነ ናምኡ ሙኩሉ፥","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ዛብሎና ኮቻፈ ታማነ ናምኡ ሙኩሉ፥","poem":1},{"lineBreak":true},{"text":"ዮሰፋ ኮቻፈ ታማነ ናምኡ ሙኩሉ፥","poem":1},{"lineBreak":true},{"text":"ብንያመ ኮቻፈ ታማነ ናምኡ ሙኩሉ፥","poem":1},"አሳ ሶምኦን ማታመ ዎስ።"]},{"type":"heading","content":["ቦ ማኦ ማእዳ አሳታ"]},{"type":"verse","number":9,"content":["ሄሳፈ ጉየ፥ ኮቸ ኡባፈ፥ ካዎተ ኡባፈ፥ ያራ ኡባፈነ ዱማ ዱማ ዶናፐ ዛው ባይና ዳሮ አሳ በአስ። ሄ አሳይ ቦ ማኦ ማእድ፥ ዛምባ ሀይ ባንታ ኩሸን ኦይክድ፥ አራታ ስንንነ ዶርሳ ስንን ኤቅዶሶና።"]},{"type":"verse","number":10,"content":["ኤንቲ ባንታ ቃላ ቁ ኦድ፥ “አቶተይ አራታን ኡትዳ ኑ ፆሳፈነ ዶርሳፈ ዬስ” ያግዶሶና።"]},{"type":"verse","number":11,"content":["ኪታንቾት ኡባይ አራታ፥ ጭማታነ ኦይዱ መተታ ዩሹዋን ኤቅዶሶና። ኤንቲ አራታ ስንን ጉፋንድ ፆሳ ጎይንዶሶና።"]},{"type":"verse","number":12,"content":[{"text":"“አምንእ!","poem":1},{"text":"አንጆይ፥ ቦንቾይ፥ ጭንጫተ፥ ጋላት፥ ሳብ","poem":2},{"lineBreak":true},{"text":"ዎልቅ፥ ምኖተ መር መርናዉ ኑ ፆሳስ ግዶ።","poem":2},{"text":"አምንእ!”","poem":1},"ያግዶሶና።"]},{"type":"verse","number":13,"content":["ጭማታፐ እሶይ ታኮ፥ “ሀ ቦ ማኡዋ ማእዳ አሳት ኦናንቴ? ኤንቲ አዉፐ ይዶና?” ያግድ ኦይችስ።"]},{"type":"verse","number":14,"content":["ታኒ ዛራዳ፥ “ጎዳዉ፥ ነ ኤራሳ” ያጋስ። እካ ታኮ፥ “ሀይሳቲ ዳሮ ዋየ ዋይድ አዳይሳታ። ኤንቲ ባንታ ማኡዋ ዶርሳ ሱን ሜጭድ ጌሽዶሶና።"]},{"type":"verse","number":15,"content":["ሄሳ ግሾ፥",{"text":"ኤንቲ ፆሳ አራታ ስንን ግድድ","poem":2},{"lineBreak":true},{"text":"ቃማነ ጋላስ እያ ኬን ኦሶና፤","poem":2},{"lineBreak":true},{"text":"አራታ ቦላ ኡትዳይስ ኤንታዉ ኩያ ግዳና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ህዛፐ ጉየ፥ ኤንቲ ኮሻቶኮና፥ ሳሞቶኮና።","poem":1},{"text":"አው ዎይኮ ምሽ ኤንታ ሜና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"አራታ ግዶን ኡትዳ ዶርሳይ ኤንታ ሄማና።","poem":1},{"text":"ደኦ ፑልቶ ሃኮ ኤንታ ካለና።","poem":2},{"text":"ፆሳይ ኤንታ አይፈፐ አፉ ኡባ ቁቻና”","poem":1},"ያግስ።"]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/REV/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/REV/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/REV/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}