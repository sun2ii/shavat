{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"SNG","translationId":"gof_etw","name":"ሶሎሞነ ማዝሙረ ማፃፋ","commonName":"ሶሎሞነ ማዝሙረ ማፃፋ","title":"ሶሎሞነ ማዝሙረ ማፃፋ","order":22,"numberOfChapters":8,"sha256":"77ffcc6f496f8d2a03ba7d1a0728aedf98134fd3dc3e338c099f2da1e22c9364","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gof_etw/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["ማዝሙረ ኡባፈ አያ ሶሎሞነ ማዝሙረይ ሀይሳ።"]},{"type":"heading","content":["ጌላእዉ"]},{"type":"verse","number":2,"content":[{"text":"ነ ሲቆይ ዎይነፐ አድ ኡፋይስያ ግሾ","poem":1},{"text":"ታና ዛራ ዛራ ዬራ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ነ ትየትያ ሽቶይ ዋንድ ሳዊ!","poem":1},{"text":"ነ ሱንይ ጎግያ ሽቶ መላ፤","poem":2},{"lineBreak":true},{"text":"ጌላኦት ነና ሲቀይ ሄሳሳ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታና ኔራ ኤካዳ ባ፤ አነ እስፈ ዎፆስ!","poem":1},{"text":"ካዋዉ፥ ታና ነ ቁሩፁዋን ገልሳ።","poem":2},"የሩሳላመ ማጫሳታ",{"text":"ነናን ኑ ኡፋይቶስ፤","poem":1},{"text":"ነ ሲቁዋ ዎይነ ኡሻፈ አድ ናሾስ።","poem":2},{"lineBreak":true},{"text":"ማጫስ ኡባይ ነና ሲቀይሳ በሳ።","poem":2}]},{"type":"heading","content":["ጌላእዉ"]},{"type":"verse","number":5,"content":[{"text":"ህንተኖ፥ የሩሳላመ ማጫሳቶ ስእተ፤","poem":1},{"text":"ታኒ ካሬ ግድኮካ ማላ ሎኦ።","poem":2},{"text":"ታ ካሬተይ ቀዳረ ዱንካነ መላ፤","poem":1},{"text":"ሽን ታ ማላይ ሶሎሞነ ማጋራጆታ መላ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታ ማላ ካሬዳይ አዋ፤","poem":1},{"text":"ታኒ ካሬ ግድዳ ግሾ ታና ቦሮፕተ።","poem":2},{"text":"ታ እሻት፥ ታ አየ ናይት ታራ ኦየትድ፥","poem":1},{"text":"ታና ዎይነ ጋደ ናግስዶሶና፤","poem":2},{"lineBreak":true},{"text":"ሄሳ ግሾ ታ ዎይንያ ናጋብከ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታ ሲቁዋዉ፥ አነ ታዉ ኦዳ፤","poem":1},{"text":"ነ ዶርሳ ዉድያ አዉን ሄማይ?","poem":2},{"lineBreak":true},{"text":"ሴታ ጋላስ ኤንታ አዉን ሸምፕሳይ?","poem":2},{"text":"ነና ደማናዉ ነ ላገታ ዉድያ ካላዳ፥","poem":1},{"text":"አይስ ጉሉንታዳ ብያ ማጫስ ግዶ?","poem":2}]},{"type":"heading","content":["ፓን"]},{"type":"verse","number":8,"content":[{"text":"ማጫሳ ኡባፈ ሎእያረ፥","poem":1},{"text":"በሳ ኤሮና እፅኮ ዶርሳታ ጌዶ ካላ።","poem":2},{"text":"ነ ዴሻ ማራታ ሄንንቾታ","poem":1},{"text":"ዱንካንያ ማታን ሄማ።","poem":2}]},{"type":"verse","number":9,"content":["ታ ሲቀ! ግብፀ ካዎ ፓራ ጋረታ ጎችያ፥",{"text":"ፓራታ ግዶን ደእያ ማጋየዳ ሎኣሳ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ነ ሀይን ደእያ አሌቁዋራ ሺቅድ፥","poem":1},{"text":"ነ ሻካላይ ዋንድ ሎእ!","poem":2},{"lineBreak":true},{"text":"ነ ቆይ አልኦ ሹቻን አሌቀትስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኑኒ ነዉ ብራን ጫደትዳ፥","poem":1},{"text":"ዎርቃ አሌቁዋ ኦስሳና።","poem":2}]},{"type":"heading","content":["ጌላእዉ"]},{"type":"verse","number":12,"content":[{"text":"ካዎይ ጋይታ ቦላ ኡትዳሽን፥","poem":1},{"text":"ታ ሽቱዋ ሳዎይ ኬን ቶንኩ ግስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታ ሲቆይ ታ ንታ ግዶን ደእያ፥","poem":1},{"text":"ፁንተትዳ ሳውያ ካርበ ዳኔስ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ታ ሲቆይ፥ ኤንጋዳ ዎይነ ጋደን፥","poem":1},{"text":"ዶልዳ ሄና ጪሻ መላ።","poem":2}]},{"type":"heading","content":["ፓን"]},{"type":"verse","number":15,"content":["ታ ሲቀ፥ ኔኒ ዋና ሎአይ!",{"text":"ኔኒ ዋና ሎአይ!","poem":2},{"lineBreak":true},{"text":"ነ አይፈት ሆለ አይፈዳ ሎኦሶና።","poem":2}]},{"type":"line_break"},{"type":"heading","content":["ጌላእዉ"]},{"type":"verse","number":16,"content":[{"text":"ታ ሲቁዋዉ፥ ኔኒ ዋና ሎአይ!","poem":1},{"text":"አይባ ኡፋይሳይ፤","poem":2},{"lineBreak":true},{"text":"ኑ አርሳይ ጭልኦ ማታ መላ ኡፋይሴስ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ኑ ኬ ቱሳይ ዝጋ፤","poem":1},{"text":"ኑ ካራይ ፂዳን ኦይከትስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}