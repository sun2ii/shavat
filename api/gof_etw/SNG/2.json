{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"SNG","translationId":"gof_etw","name":"ሶሎሞነ ማዝሙረ ማፃፋ","commonName":"ሶሎሞነ ማዝሙረ ማፃፋ","title":"ሶሎሞነ ማዝሙረ ማፃፋ","order":22,"numberOfChapters":8,"sha256":"77ffcc6f496f8d2a03ba7d1a0728aedf98134fd3dc3e338c099f2da1e22c9364","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gof_etw/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"heading","content":["ጌላእዉ"]},{"type":"verse","number":1,"content":[{"text":"ታኒ ሳሮናን ዶልያ ጪሻነ","poem":1},{"text":"ዛንጋራን ዶልያ ሱፈ ጪሻ መላ።","poem":2}]},{"type":"heading","content":["ፓን"]},{"type":"verse","number":2,"content":[{"text":"ታ ሲቅያ ማጫሳ ግዶን በእያ ዎደ፥","poem":1},{"text":"አጉን ግዶን በንትያ ሱፈ ጪሻ መላ።","poem":2}]},{"type":"heading","content":["ጌላእዉ"]},{"type":"verse","number":3,"content":[{"text":"ታ ሲቆይ ሀራ ፓንታ ግዶን ፄልያ ዎደ","poem":1},{"text":"ዎራን ደእያ አፕለ ም መላ።","poem":2},{"text":"ታና ዳሮ ኡፋይስን፥ እያ ኩያ ግዶን ኡታስ፤","poem":1},{"text":"እያ አይፈይ ምን ታና ማልኤስ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"እ ታና ግብራ ምያ ኬ ገልስስ፤","poem":1},{"text":"ባ ሲቁዋ ባንድራዳ ታ ቦላ ቁ ቁ ኦስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ታኒ እያ ሲቁዋን ኦይከታዳ ሀርግዳ ግሾ፥","poem":2},{"lineBreak":true},{"text":"ዛብበ አይፈ ሙዝድ ታና ጋሽትስተ፤","poem":2},{"lineBreak":true},{"text":"አፕለ ሙዝድ ታ ዎልቃ ምንተ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ባ ሀድርሳ ኩሽያ ታና ቦርኮትስስ፤","poem":1},{"text":"ባ ኡሻቻ ኩሽያን ታና ቆምስ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ህንተኖ፥ የሩሳላመ ያላጋ ማጫሳዉ፥","poem":1},{"text":"ሲቆይ ባዉ ዶስድ ደንዳና ጋካናዉ፥","poem":2},{"lineBreak":true},{"text":"እያ ህንተ ባርከና መላ፥","poem":2},{"lineBreak":true},{"text":"ታ ህንተና ገንኤንነ ዎራ ዎሽኤን አማታይስ።","poem":2}]},{"type":"verse","number":8,"content":["ታ ሲቁዋ ግርሳይ ደርያ ቦላራ ጉፕሸነ፥",{"text":"ዙማ ቦላራ ፆንገትሸ የይስ ስኤቴስ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ታ ሲቆይ ዎሽኤ ዎይኮ ገንኤ ማር ዳኔስ፤","poem":1},{"text":"ሄኮ፥ ኑ ኬ ማታን ኤቅስ፤","poem":2},{"lineBreak":true},{"text":"ማስኮተራ ሶ ፄሌስ፤","poem":2},{"lineBreak":true},{"text":"ማጋራጁዋ ግዶራ ፄሌስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታ ሲቆይ፥ ሀይሳዳ ያጌስ፤","poem":1},{"text":"“ታ ሲቀ፥ ደንዳ!","poem":2},{"lineBreak":true},{"text":"ታ የገልሰ፥ ሃያ፥ እስፈ አነ ቦስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሄኮ፥ ባልጎይ አስ፤","poem":1},{"text":"እራይካ ኤቅስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ቢታን ጪሽ ጪይስ፤","poem":1},{"text":"የ የፅያ አጌናይ ጋክስ፤","poem":2},{"lineBreak":true},{"text":"ሆለ የ ኑ ቢታን ስኤትስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ባላሰ ምይ አይፈ ዶምስ፤","poem":1},{"text":"ዎይነይ ጪይስ፤","poem":2},{"lineBreak":true},{"text":"ጪሻ ሳዎይ ቢታን ቶንኩ ጌስ።","poem":2},{"text":"ታ ሲቀ፥ ደንዳ፤ ታ የገልሰ፥","poem":1},{"text":"ሃያ፤ አነ እስፈ ቦስ።”","poem":2}]},{"type":"heading","content":["ፓን"]},{"type":"verse","number":14,"content":[{"text":"አፎ ዶናን ዛላ ቆጶን፥","poem":1},{"text":"ቆሰትዳ ሆለ ዳንያረ፤","poem":2},{"lineBreak":true},{"text":"አነ እስ ቶሆ ታና ነ ሶምኡዋ በሳ፤","poem":2},{"lineBreak":true},{"text":"ነ ግርሳ ስሳ።","poem":2},{"text":"ነ ቃላይ ታና ማልኤስ፤","poem":1},{"text":"ነ ሶምኦይ ዳሮ ሎኤስ።","poem":2}]},{"type":"heading","content":["የሩሳላመ ጌላኦታ"]},{"type":"verse","number":15,"content":[{"text":"ኑ ዎይነይ ጪይስ፤","poem":1},{"text":"ኑ ዎይነ ጋድያ ኢስያ ዎርካናታ፥","poem":2},{"lineBreak":true},{"text":"ሄ ጉ ቡታለታ ፅሄን ኦይክተ።","poem":2}]},{"type":"line_break"},{"type":"heading","content":["ጌላእዉ"]},{"type":"verse","number":16,"content":[{"text":"ታ ሲቆይ ታባ፤ ታንካ እያባ፤","poem":1},{"text":"ጪሻታ ግዶን እ ባ ዉድያ ሄሜስ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሳእ ጌያና ጋካናዉ፥","poem":1},{"text":"ኩያይ ያና ጋካናዉ፥","poem":2},{"lineBreak":true},{"text":"ታ ሲቁዋዉ፥ ገንኤዳ ዎይኮ ዎሽኤ ማራዳ፥","poem":2},{"lineBreak":true},{"text":"አፎትያ ደርያራ ዎፃሸ ሃ ስማ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}