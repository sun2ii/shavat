{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"SNG","translationId":"gof_etw","name":"ሶሎሞነ ማዝሙረ ማፃፋ","commonName":"ሶሎሞነ ማዝሙረ ማፃፋ","title":"ሶሎሞነ ማዝሙረ ማፃፋ","order":22,"numberOfChapters":8,"sha256":"77ffcc6f496f8d2a03ba7d1a0728aedf98134fd3dc3e338c099f2da1e22c9364","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gof_etw/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"heading","content":["ጌላእዉ"]},{"type":"verse","number":1,"content":[{"text":"ቃማ ኩመ ሂፃን ዝንአዳ፥","poem":1},{"text":"ታ ሲቁዋ ደማናዉ አሞታስ፤","poem":2},{"lineBreak":true},{"text":"ምንዳ ኮያስ፤ ሽን ደማብከ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ካታማ ግዶን ደእያ ዳልጋነ","poem":1},{"text":"ፁን ኦገታ ኡባን ዩያስ።","poem":2},{"lineBreak":true},{"text":"ታ ሲቁዋ ደማናዉ ኮያስ፤","poem":2},{"lineBreak":true},{"text":"ምንዳ ኮያስ፤ ሽን ደማናዉ ዳንዳአብከ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ካታማ ዩይድ ናገይሳት ታና ደምዶሶና፤","poem":1},{"text":"ታኒ፥ “ታ ሲቁዋ በእደቲ?” ያጋዳ ኦይቻስ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኤንታ አጋዳ አዳ መላ ታ ሲቁዋ ደማስ፤","poem":1},{"text":"እ ታፐ ከስ ኤኮናዳ ምንዳ ኦይካስ።","poem":2},{"text":"ታ አየ ሶ ኤፋስ፤","poem":1},{"text":"ታ የለትዳ ክፍልያ ገልሳስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ህንተኖ የሩሳላመ ማጫ ናይቶ፥","poem":1},{"text":"ሲቆይ ባዉ ዶስድ ደንዳና ጋካናዉ፥","poem":2},{"lineBreak":true},{"text":"እያ ህንተ ባርክሶና መላ","poem":2},{"lineBreak":true},{"text":"ታኒ ህንተና ገንኤንነ ዎሽኤን አማታይስ።","poem":2}]},{"type":"heading","content":["የሩሳላመ ጌላኦታ"]},{"type":"verse","number":6,"content":[{"text":"ዛልአንቾ እፃነዳነ ካርበዳ ሳውያራ፥","poem":1},{"text":"ጩያ ቱሱ ዳንያራ፥","poem":2},{"lineBreak":true},{"text":"ሀና መላ ቢታፈ ያራ እያ ኦኔ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሄኮ፥ ሶሎሞነ ፓራ ጋርያ ያዉሱ፤","poem":1},{"text":"ሄ ፓራ ጋርዉ እስራኤለፐ ዶረትዳ፥","poem":2},{"lineBreak":true},{"text":"ኡሱፑን ታሙ ዎልቃማ ቶራንቾት አጃብዶሶና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኤንቲ ኡባይ ማሻ ኦይን ሜዘትዶሶና፤","poem":1},{"text":"ኦላንካ ፓጨትዶሶና።","poem":2},{"text":"ቃማ ጋክያ መቱዋ ተቃናዉ፥","poem":1},{"text":"ኤንቲ ማሸ ዳንጭድ ጊግዶሶና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ካዋ ሶሎሞነይ ፓራ ጋረ ግዶን፥","poem":1},{"text":"ባዉ ኡትያ አራታ ጊግስስ፤","poem":2},{"lineBreak":true},{"text":"እያ አራታይ ልባኖሰፐ ይዳ ምን ኦሰትስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"አራታ ቱሳይ ብራን ላንፀትስ፤","poem":1},{"text":"ዘምፖይ ዎርቃን አሌቀትስ።","poem":2},{"text":"ኦይደይ ኦቻ ቴራ ዳንያ ቃጭናን ካመትስ፤","poem":1},{"text":"ጋይ የሩሳላመ ጌላኦታ ሲቆን አሌቀትስ።","poem":2}]},{"type":"line_break"},{"type":"heading","content":["ጌላእዉ"]},{"type":"verse","number":11,"content":[{"text":"ህንተኖ፥ ፅዮነ ጌላኦቶ፥","poem":1},{"text":"ካዋ ሶሎሞነ በአናዉ ሃይተ።","poem":2},{"text":"እ ዳሮ ኡፋይትዳ እያ ያጋኑዋ ጋላስ","poem":1},{"text":"እያ አይያ እያ ሁጰን ዎዳ ካላቻ ዎስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}