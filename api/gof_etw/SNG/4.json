"poem":2},{"lineBreak":true},{"text":"ምያ ዎሽኤ ማራታ ዳኖሶና።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሳእ ጌያናፐ ስን፥","poem":1},{"text":"ማይ ክቻናፐ ስን፥","poem":2},{"lineBreak":true},{"text":"ካርበ ደርያነ እፃነ ዙማ ባዳ ሸምፓና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታ ሲቀ፥ ነ አሳተይ ኩመ ሎኦ፤","poem":1},{"text":"ነናን ቦረትያባይ ባዋ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታ ሙሹራተ፥ ልባኖሰፐ ሃያ፤","poem":1},{"text":"ጋሞይ ፔእያ፥ ማሄይ አቅያ፥","poem":2},{"text":"አማና ዙማፐ፥ ሳንራ ሊጰፐ","poem":1},{"text":"አርሞና ሁጵያፐ ዎ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ታ ሲቀ፥ ምቾ ግድዳ ታ ሙሹራተ፤","poem":1},{"text":"ነ አይፍያ ፄሎይነ ነ ቆያ አሌቆይ፥","poem":2},{"lineBreak":true},{"text":"ታ ዎዛና ኡፋይሳን ጎሽስ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታ ሲቆ ምቾ ግድዳ ታ ሙሹራተ!","poem":1},{"text":"ነ ሲቆይ ታና ዋን ኡፋይስ!","poem":2},{"text":"ነ ሲቆይ ዎይነ ኡሻፈ አድ ኡፋይሴስ፤","poem":1},{"text":"ነ ሽቶይ ኡባፈ አድ ሳዌስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታ ሙሹራተ፥ ነ መተርሻፈ እልሎ ኤስ ፆኬስ፤","poem":1},{"text":"ነ ዶናፐ ኤስነ ማ ፑልቴስ፤","poem":2},{"lineBreak":true},{"text":"ነ ማኦይ ልባኖሰ ሽቶዳ ሳዌስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ታ ሲቆ ምቾ ግድዳ ታ ሙሹራተ፥","poem":1},{"text":"ነ ዩሾይ ድረትድ ናገትያ አታክልተ በሳ መላ፤","poem":2},{"lineBreak":true},{"text":"ነ ሀራታስ ጎርደትዳ፥ ታዉ ዶየትዳ ፑልቶ መላ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኔኒ አታክልተ ግዶን፥","poem":1},{"text":"ኦሮማነይ፥ ዶረትዳ አታክልተ አይፈት፥","poem":2},{"lineBreak":true},{"text":"ናርዶሰ ጌተትያ አይፈት ደእያ በሳ መላ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ናርዶሰይ፥ ላደይ፥ ሳውያ ማት፥ ቃራፍን፥","poem":1},{"text":"እፃናዳ ሳውያባት ደኦሶና።","poem":2},{"text":"ካርበይ፥ ጎዳረ ኡ ጪሽነ","poem":1},{"text":"ዱማ ዱማ ቅማመ አታክልተት ዶሎሶና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኔኒ አታክልተ በሳ ኡሽያ ፑልቶ መላ፤","poem":1},{"text":"ደኦ ሃ በንትያ ኦላ መላ፤","poem":2},{"lineBreak":true},{"text":"ልባኖሰ ዙማፐ ጎግያ ሻፋ መላ።","poem":2}]},{"type":"heading","content":["ጌላእዉ"]},{"type":"verse","number":16,"content":[{"text":"ፑደሀ ባጋ ጫርኩዋዉ፥ ደንዳ!","poem":1},{"text":"ዱገሀ ባጋ ጫርኩዋዉ፥ ሃያ!","poem":2},{"text":"ታ አታክልትያ ቦላ ጫርካ!","poem":1},{"text":"እያ ሳዎይ ቶንኩ ጎ።","poem":2},{"text":"ታ ሲቆይ ባ አታክልትያ ግዶ ዮ፤","poem":1},{"text":"ዳሮ ማልእያ አይፈታ ሞ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}