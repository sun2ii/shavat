{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"SNG","translationId":"gof_etw","name":"ሶሎሞነ ማዝሙረ ማፃፋ","commonName":"ሶሎሞነ ማዝሙረ ማፃፋ","title":"ሶሎሞነ ማዝሙረ ማፃፋ","order":22,"numberOfChapters":8,"sha256":"77ffcc6f496f8d2a03ba7d1a0728aedf98134fd3dc3e338c099f2da1e22c9364","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gof_etw/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"heading","content":["ፓን"]},{"type":"verse","number":1,"content":[{"text":"ታ ምቸ፥ ታ ሙሹራተ፥","poem":1},{"text":"ታኒ ታ አታክልትያ ግዶ ገላስ።","poem":2},{"text":"ታ ካርብያነ ታ ሽቶ ጪሻ ቆራስ፤","poem":1},{"text":"ታኒ ኤሳ ኡይ ማስ፤","poem":2},{"lineBreak":true},{"text":"ታ ዎይንያነ ታ ማ ኡያስ።","poem":2},"የሩሳላመ ጌላኦታ",{"text":"እያ ላገቶ፥ ሚተ ኡይተ፤","poem":1},{"text":"ሲቆ አላና ጋካናዉ ኡይተ።","poem":2}]},{"type":"heading","content":["ጌላእዉ"]},{"type":"verse","number":2,"content":[{"text":"ታኒ ስካስ፤ ሽን ታ ዎዛናይ ባርክስ፤","poem":1},{"text":"ታ ሲቆይ ሀይሳዳ ያግድ ፐንግያ ቆንክሽን ስአስ።","poem":2},{"text":"“ታ ምቸ፥ ታ ሲቀ፥ ታ የገልሰ፤","poem":1},{"text":"ቦረይ ባይና ታ ሆለ፥","poem":2},{"lineBreak":true},{"text":"ታዉ ፐንግያ ዶያ።","poem":2},{"text":"ታ ሁጰይ አካን ላክስ፤","poem":1},{"text":"ታ ብናናይ ቃማ ፑሰን እርፅስ።”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታ ማኡዋ ቃራስ፥ ዛራዳ ማኦዬ?","poem":1},{"text":"ታ ቶሁዋ ሜጨታስ፥ ዛራዳ ቅታዮዬ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታ ሲቆይ እብ ፆኤራ ባ ኩሽያ ሶ የድስ፤","poem":1},{"text":"ታ ዎዛናይ እያ ግሾ ሴሌስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ታ ሲቁዋስ ዶያናዉ ደንዳስ፤","poem":1},{"text":"ፐንግያ ዶያናዉ ኮብያ ኦይክያ ዎደ፥","poem":2},{"lineBreak":true},{"text":"ታ ኩሽያፐ ካርበይ፥","poem":2},{"lineBreak":true},{"text":"ታ ብራያፈ ሽቶይ ፆኬስ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታ ሲቁዋስ ካርያ ዶያስ፥ ሽን እ ዴና፤","poem":1},{"text":"እያ ቃላ ስአናዉ ዳሮ አሞታስ።","poem":2},{"text":"ምንዳ ኮያስ፥ ሽን እያ ደማብከ፤","poem":1},{"text":"ፄጋስ፥ ሽን ታዉ ኮይቤና።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ካታማ ናገይሳት ታና ደምድ፥","poem":1},{"text":"ዋዶሶና፤ ማዱንፅስዶሶና።","poem":2},{"text":"ካታማ ድርሳ ናገይሳት፥","poem":1},{"text":"ታ ላፃና ቃር ኤክዶሶና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ህንተኖ፥ የሩሳላመ ጌላኦቶ፥","poem":1},{"text":"ታ ሲቁዋ ደምኮ፥","poem":2},{"lineBreak":true},{"text":"ታኒ እያ ሲቁዋን ሀርግዳይሳ፥","poem":2},{"lineBreak":true},{"text":"ሀዳራ እያዉ ኦድተ።","poem":2}]},{"type":"heading","content":["የሩሳላመ ጌላኦታ"]},{"type":"verse","number":9,"content":[{"text":"ነኖ፥ ማጫሳ ኡባፈ ሎእያራ፥","poem":1},{"text":"ነ ላገይ ሀራታፐ ዋንድ ዱማቲ?","poem":2},{"text":"ኔኒ ኑና ሀዳራ ገይ፥","poem":1},{"text":"እ ሀራታፐ አይብን ዱማቲ?","poem":2}]},{"type":"line_break"},{"type":"heading","content":["ጌላእዉ"]},{"type":"verse","number":10,"content":[{"text":"ታ ሲቆይ ማላ ሎኦነ አያንታ፤","poem":1},{"text":"ታሙ ሙኩሉ አደታ ግዶን እያ መል ባዋ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"እያ ሁጰይ አልኦ ዎርቃ ዳኔስ፤","poem":1},{"text":"እያ ብናናይ ሎኦነ ቁሮ መላ ካሬ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"እያ አይፈይ ሻፋ ማታን ኤቅዳ፥","poem":1},{"text":"ማን ሜጨትዳ ሆለታ ዳኔስ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"እያ ሻካላይ ሳውያ ቅማመይ ቶከትዳ ማዳበዳ ሎኤስ፤","poem":1},{"text":"እያ መተርሻይ ካርበ ሽቶይ ፆክያ ዎራ ጪሻዳ ሎኤስ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"እያ ቀሰይ አልኦ ሹቻን አሌቀትዳ ዎርቃ ፃምአዳ ሎኤስ፤","poem":1},{"text":"እያ አሳተይ ሳንፓረ አልኦ ሹቻን አሌቀትዳ ዳንጋርሳ ዛለ መላ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"እያ ቶሆት ዎርቃ ባሶን ኤቅዳ ሳሎ ሹቻ ቱስ ዳኖሶና፤","poem":1},{"text":"እያ ማላይ ዝጋን አሌቀትዳ ልባኖሰ ዙማ መላ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"እያ ዶናይ ኤሳዳ ማልኤስ፤","poem":1},{"text":"እያ ኩመ አሳተይ ሎኤስ።","poem":2},{"text":"ህንተኖ የሩሳላመ ጌላኦቶ፥","poem":1},{"text":"ታ ሲቆይነ ታ ላገይ ሀይሳ ዳነስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}