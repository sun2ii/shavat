{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"SNG","translationId":"gof_etw","name":"ሶሎሞነ ማዝሙረ ማፃፋ","commonName":"ሶሎሞነ ማዝሙረ ማፃፋ","title":"ሶሎሞነ ማዝሙረ ማፃፋ","order":22,"numberOfChapters":8,"sha256":"77ffcc6f496f8d2a03ba7d1a0728aedf98134fd3dc3e338c099f2da1e22c9364","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gof_etw/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"heading","content":["የሩሳላመ ጌላኦታ"]},{"type":"verse","number":1,"content":[{"text":"ማጫሳ ኡባፈ ሎእያረ፥ ነ ላገይ አዉ ብዴ?","poem":1},{"text":"ኑ ኔራ ኮያና መላ እ ብዳ ግና ኑስ ኦዳ።","poem":2}]},{"type":"heading","content":["ጌላእዉ"]},{"type":"verse","number":2,"content":[{"text":"ታ ሲቆይ ዶርሳ ዉደ ሄማናዉ፥","poem":1},{"text":"ሎኦ ጪሻ ሺሻናዉ፥","poem":2},{"lineBreak":true},{"text":"ሽቶ ማታይ ደእያ አታክልትያ ግዶ ብስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታኒ ታ ሲቁዋባ፤ ታ ሲቆይ ታባ፤","poem":1},{"text":"እ ሱፈ ጪሻ ግዶን ዉደ ሄሜስ።","poem":2}]},{"type":"heading","content":["ፓን"]},{"type":"verse","number":4,"content":[{"text":"ታ ሲቀ፥ ነ ትርሳ ካታሜዳ ሎኣሳ፤","poem":1},{"text":"የሩሳላመዳ ዳሮ ሎኣሳ።","poem":2},{"text":"ባንድራ ኦይክድ ሳልፕያ፥","poem":1},{"text":"ኦላንቾዳ ያሻሳ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኤንቲ ታና ኡንኤዳ ግሾ፥","poem":1},{"text":"ሀያና ነ አይፍያ ታፐ ደን።","poem":2},{"text":"ነ ብናናይ ጋላዳ ዙማፐ ዎያ፥","poem":1},{"text":"ዴሻ ዉደ ዳኔስ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ነ አቻይ ሜጨትድ ከይያ፥","poem":1},{"text":"ኡባይ መንተ የልያ፥","poem":2},{"lineBreak":true},{"text":"ኤንታ ግዶን አዉጫየይ ባይና ዶርሳ ዉደ መላ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ነ ናምኡ ሻካላይ ጉሉን ግዶራ ፄልያ ዎደ፥","poem":1},{"text":"ናምኡ ከስድ ጳልቅዳ ኦሮማነ ዳኖሶና።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኡሱፑን ታሙ ማጫ ካዎት፥","poem":1},{"text":"ሆስፑን ታሙ ላገት፥","poem":2},{"lineBreak":true},{"text":"ታይቦይ ባይና ጌላኦት ደኦሶና።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሽን ቦረይ ባይና ታ ሆልያ ታዉ ዱማ፤","poem":1},{"text":"እያ ባ አየስ እስኖ።","poem":2},{"text":"እዮ የልዳ አይያ ኡባፈ አዳ እዮ ዶሳዉሱ፤","poem":1},{"text":"ጌላኦት እዮ በእድ፥ “ሀና አንጀትዳሮ” ያጎሶና፤","poem":2},{"lineBreak":true},{"text":"ማጫ ካዎትነ ላገት እዮ ሳቦሶና።","poem":2}]},{"type":"heading","content":["የሩሳላመ ጌላኦታ"]},{"type":"verse","number":10,"content":[{"text":"ሀና ዎንታ ፃልቀዳ ዶልያራ፥","poem":1},{"text":"አጌናዳ ፖእያራ፥ ፃልቀዳ ጫድያራ፥","poem":2},{"lineBreak":true},{"text":"ባንድራ ኦይክድ ሳልፐ ከይዳ፥","poem":2},{"lineBreak":true},{"text":"ኦላንቾዳ ያሽያራ ሀና ኦኔ?","poem":2}]},{"type":"heading","content":["ፓን"]},{"type":"verse","number":11,"content":[{"text":"ታኒ ዛንጋራን ቶከትዳ ምታ በአናዉ፥","poem":1},{"text":"ዎይነይ አጭዳኮ ኦሮማነይ አይፍዳኮ ፄላናዉ፥","poem":2},{"lineBreak":true},{"text":"ዱገ ኦቾሎነ ጋደ ዎስ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ታ ቆፖና ደእሽን ታ አሞይ ታና ኤፍድ፥","poem":1},{"text":"ካዋ አሳ ፓራ ጋረታ ግዶን ታና ኡትስስ።","poem":2}]},{"type":"heading","content":["የሩሳላመ ጌላኦታ"]},{"type":"verse","number":13,"content":[{"text":"ነኖ ሱላማፐ ይዳረ፥ ሃያ፤ ሃ ስማ፤","poem":1},{"text":"ኑ ነና ሎይድ ፄላና መላ ሃ ስማ።","poem":2},"ጌላእዉ",{"text":"ዳሮ አሳ ስንን የፅያ አሳዳ፥","poem":1},{"text":"ታና አይስ ፄሌቲ?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}