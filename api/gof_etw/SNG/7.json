{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"SNG","translationId":"gof_etw","name":"ሶሎሞነ ማዝሙረ ማፃፋ","commonName":"ሶሎሞነ ማዝሙረ ማፃፋ","title":"ሶሎሞነ ማዝሙረ ማፃፋ","order":22,"numberOfChapters":8,"sha256":"77ffcc6f496f8d2a03ba7d1a0728aedf98134fd3dc3e338c099f2da1e22c9364","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gof_etw/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"heading","content":["ፓን"]},{"type":"verse","number":1,"content":[{"text":"ካዎ ናአዳ ሎእያረ፥","poem":1},{"text":"ላፃና ጫማ አዳ ነ ቶሆት ዋን ሎእ!","poem":2},{"text":"ነ ሼቸይ ሂላንቾይ ቆፅድ፥","poem":1},{"text":"አሌቅስዳ አልኦ ሹቹ ዳኔስ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ነ ጉልአይ ዎይነይ ኩምዳ ብርለ ዳኔስ፤","poem":1},{"text":"ነ ፄሳ ዩሾይ ጪሻን ቃሸትዳ ግስተ ምርቀ ዳኔስ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ነ ንት መንተ የለትዳ፥","poem":1},{"text":"ገንኤ ማር ዳኖሶና።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ነ ቆይ ዳንጋርሳ ዛለን","poem":1},{"text":"አሌቀትዳ አዱሳ ሻኮ መላ።","poem":2},{"text":"ነ አይፈይ ግታ ሀሰቦና ካታማ ፐንግያ ማታን፥","poem":1},{"text":"ደእያ ዜሮ ሃ ዳኔስ።","poem":2},{"text":"ነ ሲይ ዳማስቆኮ ዛሪድ ግምብዳ፥","poem":1},{"text":"ልባኖሰ ግምብያ ዳኔስ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ነ ሁጰይ ቃርመሎሳ ዙማ ዳኔስ፤","poem":1},{"text":"ነ ብናናይ ቃጭና ፃ ዳኔስ፤","poem":2},{"lineBreak":true},{"text":"ነ ሁጵያ ዳይ ካዋ ኡፋይሴስ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታ ሲቀ፥ ነ ዋና ሎአይ!","poem":1},{"text":"ነ ዋንዳ የገልሰ!","poem":2},{"lineBreak":true},{"text":"ነ ሲቆይ ታና ዋን ኡፋይስ!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ነ ጌሳይ ዛምባ ዳኔስ፤","poem":1},{"text":"ነ ንይ ዛምባ ሞርኤ ዳኔስ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታኒ፥ “ዛምባ ቦላ ከያና፤","poem":1},{"text":"እያ አይፍያ ማፃና” ያጋስ።","poem":2},{"text":"ነ ንይ ዎይነ ሞርኤ መላ፤","poem":1},{"text":"ነ ሲያራ ከያ ፔኖይ አፕለዳ ሳዌስ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ነ ዶናፐ ከይያ ፔኖይ","poem":1},{"text":"ሎኦ ዎይነ መላ።","poem":2},"ጌላእዉ",{"text":"ህዛ ሎእያ ዎይነ ኡሻይ፥","poem":1},{"text":"ነ ሲቀ መተርሻፈነ አቻፈ ግዶራ፥","poem":2},{"lineBreak":true},{"text":"ለፕ ግድ ጎጎ።","poem":2}]},{"type":"heading","content":["ጌላእዉ"]},{"type":"verse","number":10,"content":[{"text":"ታኒ ታ ሲቁዋባ፤ እካ ታና አሞቴስ።","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ታ ሲቁዋዉ፥ ሃያ፤","poem":1},{"text":"ካታማፐ ከይድ ጋፃረ ቦስ፤","poem":2},{"lineBreak":true},{"text":"ናምአይ ቃማ ያን አና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዎንታ ጉራ ዎይነ አታክልትያ ግዶ ቦስ፤","poem":1},{"text":"ዎይነይ ጪይዳኮ፥ አይፈ አዳኮ፥","poem":2},{"lineBreak":true},{"text":"ኦሮማነይ አይፍዳኮ አነ በኦስ።","poem":2},{"text":"ታኒ ታ ሲቁዋ ነና ያን በሳና።","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"እንኮየ አይፈ ሳዎይነ","poem":1},{"text":"ዱማ ዱማ ኡፋይስያ አታክልተ አይፈይ","poem":2},{"lineBreak":true},{"text":"ኑ ካረን ኩምስ።","poem":2},{"text":"ታ ሲቁዋዉ! ሀ አይፈታፐ ቴርዳይሳነ","poem":1},{"text":"ኦራ ማፅዳይሳ ነዉ ዎስ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}