{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"SNG","translationId":"gof_etw","name":"ሶሎሞነ ማዝሙረ ማፃፋ","commonName":"ሶሎሞነ ማዝሙረ ማፃፋ","title":"ሶሎሞነ ማዝሙረ ማፃፋ","order":22,"numberOfChapters":8,"sha256":"77ffcc6f496f8d2a03ba7d1a0728aedf98134fd3dc3e338c099f2da1e22c9364","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gof_etw/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["ነ ታዉ ታ አየ ን ምዳ",{"text":"ታ እሻ ግድዳኮ አይበ!","poem":2},{"text":"ታ ነና ኦገን ደማዳ ዬርዳኮ፥","poem":1},{"text":"ታና ኦንካ ቦረናሽን።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታኒ ነና ካለዳ፥","poem":1},{"text":"ታና ታማርስዳ ታ አየ ሶ ገልሳርክናሽን።","poem":2},{"text":"ማልእያ ኦሮማነ ጉምኤነ","poem":1},{"text":"ሎእያ ዎይነ ኡሻ ታ ነና ያን ኡሻርክና።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታና ነ ሀድርሳ ኩሸይ ቦርኮትሴስ፥","poem":1},{"text":"ነ ኡሻቻ ኩሸይ ታና ቆመስ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ህንተኖ፥ የሩሳላመ ጌላኦቶ፥","poem":1},{"text":"ታ ሲቆይ ባ ዎደ ደንዳና ጋካናዉ፥","poem":2},{"lineBreak":true},{"text":"ኮይሮትድ ህንተ እያ ደንናዳ ሀዳራ ጋይስ።","poem":2}]},{"type":"heading","content":["የሩሳላመ ጌላኦታ"]},{"type":"verse","number":5,"content":[{"text":"ባ ሲቁዋ ሀሸን ዘምፓዳ፥","poem":1},{"text":"መላ ቢታፈ ያራ ሀና ኦኔ?","poem":2},"ጌላእዉ",{"text":"በን ነ አይያ ነና እቀታዳ የልዳ፥","poem":1},{"text":"አፕለ ም ጋርሳን ነ ዝንእዳሽን፥","poem":2},{"lineBreak":true},{"text":"ነና ታ ባርክሳስ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"መርና ሲቁዋን ታና ነ ዎዛናን አታማ፤","poem":1},{"text":"ነ ቀስያን ማታመዳ ታ ፃላላ ኦይካ።","poem":2},{"text":"ሲቆይ ሀይቆ መላ ምኖ፤","poem":1},{"text":"ቃናተይ ስኦለ መላ ኢታ፤","poem":2},{"lineBreak":true},{"text":"እያ ላጮይ ፆሳ ታማ ላጮ መላ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዳሮ ሃ ሲቆ ታማ ቶይሳናዉ ዳንዳኤና፤","poem":1},{"text":"ድኦይካ ሜጭድ ኤፋናዉ ዳንዳኤና።","poem":2},{"text":"አስ ሲቆ ሻማናዉ ባዉ ደእያ ኡባ እምኮካ፥","poem":1},{"text":"ሲቆይ ሚሸን ሻመቶና ግሾ፥ አስ እያ ካስ።","poem":2}]},{"type":"heading","content":["ጌላኤ እሻታ"]},{"type":"verse","number":8,"content":[{"text":"ን ትራን ኡትቦና ምቻ ኑስ ደአዉሱ፤","poem":1},{"text":"አዝን እዮ ኦይችኮ፥ ኑ እዉ አይ ኦኔ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"እያ ግምበ ድርስ ግድያኮ፥","poem":1},{"text":"ኑኒ እ ቦላ አዱሳ ብራ ግምበ ግምባና፤","poem":2},{"lineBreak":true},{"text":"እያ ድርሳ ፐንገ ግድያኮ ዝጋ እብ መና።","poem":2}]},{"type":"heading","content":["ጌላእዉ"]},{"type":"verse","number":10,"content":["ታኒ ድርሳ ግምበ፤",{"text":"ታ ንይ ግምበ ቦላ ደእያ ሻኮ መላ፤","poem":2},{"lineBreak":true},{"text":"ታኒ ታ ሲቁዋራ ደእያ ዎደ እ ታናን ኡፋይቴስ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሶሎሞነስ ባኣል-ሀሞናን ዎይነ ጋደይ ደኤስ፤","poem":1},{"text":"ሄ ዎይነ ጋድያ ኡነ ኦይሳታስ እሚስ።","poem":2},{"text":"ከራ ኤክዳይሳት አይፍያ ግሾ፥","poem":1},{"text":"እሶይ እሶይ ሙኩሉ ብራ እያዉ ኤሆሶና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሽን ታዉ ታ ቡዞ ዎይነ ጋደይ ደኤስ፤","poem":1},{"text":"ሶሎሞነ፥ ኔኒ ሙኩሉ ብራ ኤካ፤","poem":2},{"lineBreak":true},{"text":"ኡነ ኤክድ ኦይሳት ናምኡ ፄቱ ብራ ኤኮ።","poem":2}]},{"type":"heading","content":["ፓን"]},{"type":"verse","number":13,"content":[{"text":"ነኖ፥ አታክልትያ ግዶን ደእያ ታ ሲቀ፥","poem":1},{"text":"ነ ላገት ነ ቃላ ስአናዉ ኮዮሶና፤","poem":2},{"lineBreak":true},{"text":"ነ ቃላ ታናካ ስሳ።","poem":2}]},{"type":"heading","content":["ጌላእዉ"]},{"type":"verse","number":14,"content":[{"text":"ታ ሲቁዋዉ፥ ታኮ ኤለ ያ!","poem":1},{"text":"ሽቶ ማታይ ዶልያ ደረታ ቦላራ፥","poem":2},{"lineBreak":true},{"text":"ጉፕያ ገንኤ ዎይኮ ዎሽኤ ማራዳ ሀና።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}