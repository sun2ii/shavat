{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ZEP","translationId":"gof_etw","name":"ሶፎናሳ ማፃፋ","commonName":"ሶፎናሳ ማፃፋ","title":"ሶፎናሳ ማፃፋ","order":36,"numberOfChapters":3,"sha256":"55d96436790e4583b95fa1cde20cb5f7c6eb9aa818b623c9936a5b36be3812f9","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gof_etw/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":1,"content":[{"type":"heading","content":["ጎዳ ፕርዳ ጋላሳ"]},{"type":"verse","number":1,"content":["አሞነ ናአይ እዮስያስ ይሁዳን ካዎትዳ ዎደ ሶፎንያሳኮ ይዳ ጎዳ ቃላይ ሀይሳ። ሶፎንያስ ኩሻ ናኣ፤ ኩሽ ጋዳላ ናአ፤ ጋዳል አማረ ናአ፤ አማረይ ህዝቅያሳ ናኣ።"]},{"type":"verse","number":2,"content":["“ታኒ ቢታ ቦላ ደእያባ ኡባ ይሳና።"]},{"type":"verse","number":3,"content":["አሰነ መሄ፥ ሳሎ ካፎታነ አባ ሞሎታ ይሳና። ኢታ አሳታ ሽራ የጋና፤ አሳ ዛረ ቢታ ቦላፈ ይሳና” ያጌስ ጎዳይ።"]},{"type":"heading","content":["ይሁዳ ቦላ ያና ፕርዳ"]},{"type":"verse","number":4,"content":["“ይሁዳንነ የሩሳላመን ደእያ ኡባ ሴራናዉ ታ ኩሽያ ደንና። ባኣለ ኤቃ ጎይነይሳታነ እያ ሀጋዝያ ካህነታ ሄ በሳፈ ይሳና።"]},{"type":"verse","number":5,"content":["ኬ ቦላ ከይድ አዋስ፥ አጌናስነ ፆልንቶታስ ጎይነይሳታ ታኒ ይሳና። ጎዳ ጎይንሸነ እያ ሱንን ጫቅሸ ሞሎካ ጌተትያ ኤቃ ሱንን ጫቀይሳታ ታኒ ይሳና።"]},{"type":"verse","number":6,"content":["ታና ካሎ አግድ ጉየ ስምዳይሳታ፥ ታና ኮይቦናይሳታነ ታና ኦይችቦናይሳታ ታኒ ይሳና” ያጌስ ጎዳይ።"]},{"type":"verse","number":7,"content":["ጎዳ ጋላሳይ ማትዳ ግሾ፥ ኡባ ሃርያ ጎዳ ስንን ስእ ጊተ! ጎዳይ ያርሹዋ ጊግስስ፤ ቃስ ባ ፄግዳ እማታ ጌሽስ።"]},{"type":"verse","number":8,"content":["“ጎዳ ያርሹዋ ጋላስ ሀላቃታ፥ ካዋ ናይታነ አላጋ ቢታ ማኦ ማእዳ ኡባ ታኒ ሴራና።"]},{"type":"verse","number":9,"content":["ሄ ጋላስ አላጋ ቢታ አሳታዳ፥ ኤቃ ጎይነይሳታነ ባንታ ጎዳ ኬ ጌላተንነ ጭሞን ኩንይሳታ ታኒ ሴራና” ያጌስ ጎዳይ።"]},{"type":"verse","number":10,"content":["“ሄ ጋላስ ሞሎ ፐንግያ ባጋራ ዋሶይ፥ ካታማስ ናምአን ሻሁዋን ዬሆነ ዙማታ ቦላ ግታ ዶምኤ ግርስ ስኤታና።"]},{"type":"verse","number":11,"content":["ህንተኖ፥ ካታማስ ጋርሳ ባጋን ደኤይሳቶ፥ ዬክተ። ያን ዛልእያ ኡባይ ይዶሶና፤ ብራ ኦይክዳይሳት ሀይቅ ዉርዶሶና።"]},{"type":"verse","number":12,"content":["ሄ ጋላስ ታኒ ፆምፐ ኦይዳ የሩሳላመ ግዱዋ ኮያና። ህርግ ባይና ዎ ኡትድ ባንታ ዎዛናን፥ ‘ጎዳይ ሎኦካ ኢታካ’ ገይሳታ ታኒ ሴራና።"]},{"type":"verse","number":13,"content":["ኤንታ ሻሎይ ቦንቀታና፤ ኤንታ ኬይ ላለታና። ኤንቲ ኬ ኬፃና፥ ሽን ሄ ኬን ዶኮና፤ ዎይነ ቶካና፥ ሽን ሄ ዎይንያ ኡዮኮና” ያጌስ ጎዳይ።"]},{"type":"heading","content":["ጎዳ ግታ ጋላሳ"]},{"type":"verse","number":14,"content":[{"text":"“ጎዳ ግታ ጋላሳይ ማትስ፤","poem":1},{"text":"ኤለስድ ጋክስ።","poem":2},{"text":"ጎዳ ጋላሳይ ጫሞ ጋላስ፤","poem":1},{"text":"ሄ ጋላስ ምኖ ኦላንቾትካ ዋሶ ጎቻና።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሄ ጋላሳይ ሀንቆ ጋላስ፥","poem":1},{"text":"ሄ ጋላሳይ መቶነ ኡንአ ጋላስ፥","poem":2},{"lineBreak":true},{"text":"ዮነ ላለተ ጋላስ፥","poem":2},{"lineBreak":true},{"text":"ማነ ጫጋና ጋላስ፥","poem":2},{"lineBreak":true},{"text":"ሻራነ ሳካና ማ ጋላስ ግዳና።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሄ ጋላሳይ ድረትዳ ካታማታ ቦላ፥","poem":1},{"text":"አዱሳ ግምበታ ቦላ ኦላ ሞይዘይ ፑነታና፤","poem":2},{"lineBreak":true},{"text":"ጊገታ ግያ ዋሶይ ስኤታና።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ኤንቲ ታና ቆህዳ ግሾ፥","poem":1},{"text":"ቆቀዳ ታታፋና ጋካናዉ፥ ኤንታ ቦላ መቶ ኤሀና።","poem":2},{"text":"ኤንታ ሱይ ድኦዳ ጎጋና፤","poem":1},{"text":"ኤንታ አሀይ ፕቶዳ የገታና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ጎዳ ሀንቆ ጋላስ","poem":1},{"text":"ኤንታ ብራይነ ኤንታ ዎርቃይ ኤንታ አሸና።","poem":2},{"text":"እ ሳአን ደእያ ኡባ ቆፖና ይሳና፤","poem":1},{"text":"ቢታ ኡባይ እያ ሀንቁዋ ታማን ሜተታና” ያጌስ ጎዳይ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ZEP/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/ZEP/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/HAB/3.json","previousChapterAudioLinks":{},"numberOfVerses":18}