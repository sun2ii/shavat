{"translation":{"id":"gof_etw","name":"ጌሻ ማፃፋ","website":"https://ebible.org/Scriptures/details.php?id=gofe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofe","licenseNotes":null,"shortName":"ETW","englishName":"Gofa: ጌሻ ማፃፋ Bible","language":"gof","textDirection":"ltr","sha256":"1a2b92836c500dd4e1114ca5dd7104f12e3bdc396d3d9164a830d01023473032","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_etw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ZEP","translationId":"gof_etw","name":"ሶፎናሳ ማፃፋ","commonName":"ሶፎናሳ ማፃፋ","title":"ሶፎናሳ ማፃፋ","order":36,"numberOfChapters":3,"sha256":"55d96436790e4583b95fa1cde20cb5f7c6eb9aa818b623c9936a5b36be3812f9","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_etw/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gof_etw/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"heading","content":["የሩሳላመ ዎዘተ"]},{"type":"verse","number":1,"content":["ማካላንቹዋስ፥ ቱንዳይሳስነ ባ ደርያ ኡንኤዳ የሩሳላመ ካታማ አየ!"]},{"type":"verse","number":2,"content":["እ ኦናካ ኪተተና፤ ሴርን ስመና፤ ጎዳን አማነተና፤ ባ ፆሳኮ ሺቀና።"]},{"type":"verse","number":3,"content":["እያ ሀላቃት ጉድያ ጋሞ መላ፤ እያ ዳይናት ደምዳባ ዎንቶስ አሾና ኡባ ምድ ኦንግያ ኦማርሳ ሱመ መላ።"]},{"type":"verse","number":4,"content":["እያ ናበት ኦቶራንቾነ ገናንቾ፤ እያ ካህነት ጌሻ ቱንሰይሳታ፤ ኤንቲ ጎዳ ህግያ ምርቆሶና።"]},{"type":"verse","number":5,"content":["ሽን እያ ግዶን ደእያ ጎዳይ ፅሎ፤ እ ባላ ኦና። ዎንታ ዎንታ እ ፅሎ ፕርዴስ፤ ጋላስ ጋላስ ሄሳ አገና። ግዶሽን፥ ያን ደእያ ጌላይ ዬላ ኤረና።"]},{"type":"verse","number":6,"content":["“ታኒ ካዎተታ ይሳስ፤ ኤንታ ግምበታ ላላስ። ኤንታ ካታማታ እስ ዶና ባይሳ ቢታ ኦስ፤ ኤንታ ኦገታ አስ ካንና ባዞ ኦስ።"]},{"type":"verse","number":7,"content":["ታኒ ሀይሳ ኡባ ኦዳ፥ ‘ታ አሳይ ታና ቦንቻና፤ ታ ሴራ ኤካና፤ ታ ኪትዳባ ዶገና’ ያጋስ። ሽን ኤንቲ ካሰፐ አድ ኢትዶሶና፤ ባንታ ኦሱዋን ቱንዶሶና” ያጌስ ጎዳይ።"]},{"type":"verse","number":8,"content":["“አነ ታኒ ፕርድያ ጋላሳይ ጋካናዉ ጉ ናግተ። ታኒ ደረታነ ካዎተታ ሺሻናዉ ቆፋ ቃቻስ፤ ታ ሀንቁዋ ሱላ ኤንታ ቦላ ጉሳና፤ ቢታይ ኩመ ታ ሀንቁዋ ታማን ፁገታና።"]},{"type":"verse","number":9,"content":["“ሄ ዎደ አሳ ኡባይ ጌሻ ኦዳ ኦደታና መላ ኦና። ኤንቲ ኡባይ ጎዳ ሱን ፄጋና፤ እስፈ እያዉ ጎይናና።"]},{"type":"verse","number":10,"content":["ላለትዳ አሳይ፥ ታና ቱማ ጎይነይሳት፥ ቶጰ ሻፋታፐ ሄፍንን ደኤይሳት ታዉ እሞታ ኤሀና።"]},{"type":"verse","number":11,"content":["ኦቶረይሳታነ ጬቀተይሳታ ታ ህንተ ግዶፈ ይስያ ግሾ፥ ሄ ዎደ ህንተ ታ ቦላ ኦዳ ኦሱዋ ጋሶን ዬላተከታ። ህዛፐ ጉየ ህንተ ታ ጌሻ ዙማ ቦላ ኦቶርተከታ።"]},{"type":"verse","number":12,"content":["ታኒ ህንተ ግዶፈ ባንታና ካዉሸይሳታነ አዳታ አሻና፤ ኤንቲ ጎዳ ሱንን አማነታና።"]},{"type":"verse","number":13,"content":["እስራኤለ አሳፐ አትዳይሳት ኢታባ ኦኮና፤ ዎርዶ ኦደቶኮና፤ ኤንታ እንፃርሳን ጭሞይ በንተና። ሄሳ ግሾ፥ ኤንቲ ምድ ካልድ ሳሮን ዳና፤ ኤንታ ያሽስያባይ ባዋ” ያጌስ።"]},{"type":"verse","number":14,"content":[{"text":"ፅዮነ ናኤ፥ ማዝሙርያ የፃ!","poem":1},{"text":"እስራኤለ አሳዉ፥ እልልተ!","poem":2},{"text":"የሩሳላመ ናኤ፥ ነ ፖሎ ዎዛናፐ ኡፋይታ፤","poem":1},{"text":"ሀሹ ጋ!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ጎዳይ ህንተ ቦላ ፕርድዳ ፕርዳ አግስ፤","poem":1},{"text":"ህንተ ሞርከታ ድግስ።","poem":2},{"text":"ጎዳይ፥ እስራኤለ ካዎይ ህንተ ግዶን ደኤስ፤","poem":1},{"text":"ህዛፐ ጉየ ህንተና ያሽስያባይ ባዋ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሄ ጋላስ ኤንቲ የሩሳላመ ሀይሳዳ ያጋና፦","poem":1},{"text":"“ፅዮነ፥ ያዮፋ! ነ ኩሸይ አርጋጮፖ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ጎዳይ፥ ነ ፆሳይ ነ ግዶን ደኤስ፤","poem":1},{"text":"እ ነዉ ፆኖ እምያ ኦላንቹዋ።","poem":2},{"text":"እ ነናን ኡፋይታና፤","poem":1},{"text":"ባ ሲቁዋን ነና ኦራና።","poem":2},{"text":"አሳይ ባኣለ ጋላስ ማዝሙረ የፀይሳዳ፥","poem":1},{"text":"እ ነናን ኡፋይተይሳ ማዝሙረ የፅድ በሳና” ያጋና።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ጎዳይ ሀይሳዳ ያጌስ፦","poem":1},{"text":"“ህዛፐ ጉየ ነ ቦላ ዮይ ጋኮናዳ ኦና፤","poem":2},{"lineBreak":true},{"text":"ነ ዬላ ድጋና።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሄ ዎደ ታኒ ነና ኡንኤዳይሳታ ኡባ ሴራና፤","poem":1},{"text":"ዎበታ አሻና፤ ላለትዳይሳታ ሺሻና።","poem":2},{"text":"ኤንቲ ዬላትዳ በሳን ዛራዳ ቦንቻና፤","poem":1},{"text":"ኤንታ ዬላ ቦንቾንነ ሳባን ላማና።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ሄ ዎደ ታኒ ህንተና ሺሻና፤","poem":1},{"text":"ህንተና እስፈ ዛራዳ ሺሻና።","poem":2},{"text":"ታኒ ህንተና ናንስያ ዎደ፥","poem":1},{"text":"ህንተ ሀ ሳአን ደእያ አሳ ኡባ ማታን፥","poem":2},{"lineBreak":true},{"text":"ቦንቸትዳይሳታነ ኤረትዳይሳታ ግዳና” ያጌስ ጎዳይ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_etw/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_etw/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_etw/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}