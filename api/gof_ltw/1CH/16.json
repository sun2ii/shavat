{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"1CH","translationId":"gof_ltw","name":"1 Taarike Maxaafa","commonName":"1 Taarike Maxaafa","title":"1 Taarike Maxaafa","order":13,"numberOfChapters":29,"sha256":"a9778499f76369936a4ef905450cd23688c7270dddddbd20222b48ef002c6997","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/gof_ltw/1CH/29.json","totalNumberOfVerses":940},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":["Enti Xoossa Taabotiya ehidi Dawiti Taabotiya wothanaw essida dunkaaniya giddon wothidi, xuussa yarshonne issifetetha yarsho Xoossas yarshidosona."]},{"type":"verse","number":2,"content":["Dawiti xuussa yarshonne issifetetha yarsho yarshidi polidaape guye Godaa sunthan asaa anjis."]},{"type":"verse","number":3,"content":["Isra7eele asa ubbaas maccasinne addes, huuphen huuphen issi muume uythi, issi qanxo ashonne issi woyne nuka gishis."]},{"type":"verse","number":4,"content":["Godaa Taabotiya sinthan oothana melanne Godaa Isra7eele Xoossaa sabbana mela, galatana melanne bonchana mela guutha Leeweta Dawiti shuumis."]},{"type":"verse","number":5,"content":["Leeweta halaqay Asaafa; Asaafa kaallidi Zakariyasa. Zakariyasa kaallidi de7ey Yi7eela, Shamramoota, Yi7eela, Matita, Eli7aaba, Banayanne Obeed-Edoome. Enti maasinqonne diithi diixanaw shuumetidosona; shin Asaafi daala girsanaw shuumetis."]},{"type":"verse","number":6,"content":["Kahiney Banayinne Yahazi7eeli Xoossa caaqo Taabotiya sinthan ubba wode moyze punnanaw shuumetidosona."]},{"type":"verse","number":7,"content":["He gallas Dawiti Asaafinne iya dabboti Godaa sabbana mela ha mazmuriya koyro kiittis."]},{"type":"heading","content":["Galata Mazmure"]},{"type":"verse","number":8,"content":[{"text":"Godaa galatite; iya sunthaa xeegite;","poem":1},{"text":"Iya oosuwa kawotethata giddon odite.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iya sabbite; galata mazmuriya iyaw yexite;","poem":1},{"text":"Malaalisiya iya ooso ubbaa odite.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iya geeshsha sunthan ceeqetite;","poem":1},{"text":"Godaa koyeyisata wozanay ufayto.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Godaanne iya wolqaa be7ite;","poem":1},{"text":"ubba wode iya sinthaa koyite.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hinteno, Isra7eele kochato,","poem":1},{"text":"dooretida Yayqooba nayto,","poem":2},{"lineBreak":true},{"text":"Iya malaata, I immida pirdaanne malaalsiyabata hassayite.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"I Godaa nu Xoossaa;","poem":1},{"text":"iya pirday biitta ubbaa bollana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Iya caaquwa merinaw","poem":1},{"text":"mukulu yeletethaa gakanaw,","poem":2},{"lineBreak":true},{"text":"iya qaala naagite.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Abrahaamera caaqida caaquwa naagees;","poem":1},{"text":"Yisaaqas gelida qaala minthees.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yayqoobas wogaa,","poem":1},{"text":"Isra7eeles merinaa caaquwa,","poem":2},{"lineBreak":true},{"text":"oothidi minthis.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“Taani new Kanaane biitta immana;","poem":1},{"text":"I ne kochaas laata gidana” yaagis.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hessi hinte taybon guuthanne","poem":1},{"text":"Kanaanen bete gididi de7iya wode hannis.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Issi deriyape hara dere pinnidosona;","poem":1},{"text":"issi kawotethaafe hara kawotethi yuuyidosona.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Xoossay enta oonika naaqana mela immibeenna;","poem":1},{"text":"enta gisho kawota seeris.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“Taani tiyidaysata bochofite;","poem":1},{"text":"ta nabeta qohopite” yaagis.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Sa7an de7iya asa ubbay Godaas yexite;","poem":1},{"text":"iya ashuwa gallas gallas odite.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kawotethata giddon iya bonchuwa,","poem":1},{"text":"malaalsiya iya oosuwa asa ubbaa giddon awaajite.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Goday gita; aadho galatay iyaw bessees;","poem":1},{"text":"xoossata ubbaafe aadhidi bonchetanaw bessees.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hara kawotethata xoossati ubbay eeqata;","poem":1},{"text":"shin Goday salota medhida Xoossaa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Iya sinthan bonchoynne teemi de7ees;","poem":1},{"text":"minotethinne ufaysi I de7iya bessan de7ees.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Hinteno, biitta kawotethato,","poem":1},{"lineBreak":true},{"text":"Godaa bonchonne wolqa immite.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Iya sunthaas bessiya boncho immite;","poem":1},{"text":"yarsho ekidi iya sinthe yiite;","poem":2},{"lineBreak":true},{"text":"iya geeshshatetha teeman Godaa goyinnite.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Biittan de7iya asa ubbay iya sinthan kokorite;","poem":1},{"text":"Sa7ay minni eqida gisho qaaxenna.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Saloti ufayto; sa7i hashshu go!","poem":1},{"lineBreak":true},{"text":"Kawotethata giddon enti “Goday kawotis!” yaago.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Abbaynne iya giddon de7iya ubbay guummo;","poem":1},{"text":"gadeynne iyan de7iya katha ubbay ufayto.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"He wode woran de7iya mitha ubbay","poem":1},{"text":"ufaysan Godaa sinthan yexana.","poem":2},{"lineBreak":true},{"text":"I sa7aa bolla pirdanaw yees.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Goday keeha gidiya gishonne","poem":1},{"text":"iya siiqoy merinaasa gidiya gisho,","poem":2},{"lineBreak":true},{"text":"Godaa galatite.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"“Abeeti nuna ashshiya Xoossaw nuna ashsha;","poem":1},{"text":"Nuuni ne geeshsha suntha galatana melanne","poem":2},{"lineBreak":true},{"text":"ne bonchuwan nu bonchetana mela,","poem":2},{"lineBreak":true},{"text":"kawotethata giddofe shiishada nuna ashsha” yaagite.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Goday Isra7eele Xoossay,","poem":1},{"text":"merinaape merinaa gakanaw galatetto!","poem":2},"Asa ubbay, “Amin7i” gidi, Godaa galatidosona."]},{"type":"verse","number":37,"content":["Godaa caaqo Taabotiya sinthan gallas gallas goyinnoos koshshiyaba ubba wode enti oothana mela Dawiti Asaafanne iya dabbota wothis."]},{"type":"verse","number":38,"content":["Qassi Obeed-Edoomenne usupun tammanne hospun iya dabbota entara oothana mela wothis; Yedutuuna na7aa Obeed-Edoomenne Hosa pengiya naagana mela wothis."]},{"type":"verse","number":39,"content":["Kahiney Saadoqinne iyara oothiya kahineti Gaba7oonan de7iya dhoqa bessan, Dunkaaniya sinthan oothana mela enta yan aggis."]},{"type":"verse","number":40,"content":["Goday Isra7eeles immida higgiyan xaafetidaysada enti wontanne omarsi ubba wode xuussa yarsho yarshana mela oothis."]},{"type":"verse","number":41,"content":["Iya siiqoy merinaasa gidiya gisho Godaa mazmuren galatana mela Hemaana, Yedutuunanne dooretida harata Dawiti entara issife wothis."]},{"type":"verse","number":42,"content":["Hemaaninne Yedutuuni moyze punnoosona, daala giirsoosona galata mazmure yexishe kaa7iya hara miisheta kaa7oosona. Yedutuuna adde nayti pengiya naaganaw shuumetidosona."]},{"type":"verse","number":43,"content":["Hessafe guye asa ubbay ba soo soo bis. Dawitika ba soo asaa anjanaw simmis."]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/1CH/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/1CH/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/1CH/15.json","previousChapterAudioLinks":{},"numberOfVerses":42}