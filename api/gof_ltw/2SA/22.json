{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"2SA","translationId":"gof_ltw","name":"2 Sameela Maxaafa","commonName":"2 Sameela Maxaafa","title":"2 Sameela Maxaafa","order":10,"numberOfChapters":24,"sha256":"1dfd90d88e819f47da4b34999557480d3aba12351535d3253075b0abcf18d1c6","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/gof_ltw/2SA/24.json","totalNumberOfVerses":695},"chapter":{"number":22,"content":[{"type":"heading","content":["Dawita Xoono Mazmure"]},{"type":"verse","number":1,"content":["Goday Saa7ola kushepenne iya morketa ubbaa kushepe ashshida gallas Dawiti Godaas ha mazmuriya yexis."]},{"type":"verse","number":2,"content":[{"text":"Goday ta zaalla;","poem":1},{"text":"taw miixaa;","poem":2},{"lineBreak":true},{"text":"I tana ashsheysa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ta Xoossay taani baqatada attiya zaalla;","poem":1},{"text":"I ta gondalliya;","poem":2},{"lineBreak":true},{"text":"I ta atotetha wolqaa.","poem":2},{"text":"I taani baqatada attiya bessi;","poem":1},{"text":"ne tana makallanchota kushepe ashshaasa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Galati bessiya Godaa taani xeegana;","poem":1},{"text":"taani ta morketape attana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hayqo zuley tana teqis;","poem":1},{"text":"dhayo di7oy tana daganthis.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Si7oole wodoroy tana qachana hanees;","poem":1},{"text":"hayqoy xiheda tana oykis.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tana metoy un7ethin Godaa xeegas;","poem":1},{"text":"tana maaddana mela ta Xoossaako waassas.","poem":2},{"text":"I ba keethan ta qaala si7is;","poem":1},{"text":"ta waassida waasoy iya haythan wodhis.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Xoossay hanqetida gisho,","poem":1},{"text":"biitti qaaxis; buqetis;","poem":2},{"lineBreak":true},{"text":"salota xaphoy kokoris; qaaxis","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iya siidhiyape cuyay keyis;","poem":1},{"text":"iya doonape tama lacoynne","poem":2},{"lineBreak":true},{"text":"xuuggiya bonqoy keyis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Saluwa phalqidi duge wodhis;","poem":1},{"text":"iya tohuwape garsara sakana dhumi de7ees.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kiruubetan uttidi paallis;","poem":1},{"text":"carko qefiya bolla uttidi bis.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bana dhuman teqis;","poem":1},{"text":"iya dunkaaney irara siketida shaara.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Iya sinthan de7iya poo7uwape","poem":1},{"text":"tama bonqoy keyees.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Goday salope guummis;","poem":1},{"text":"Ubbaafe dhoqa Xoossay ba qaala sissis.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ba dongiya dukidi, ba morketa laallis;","poem":1},{"text":"wol7antha poo7o kiittidi, enta yedethis.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Goday seerida wodenne","poem":1},{"text":"hanqetidi peenuqida wode,","poem":2},{"lineBreak":true},{"text":"abba giddon biittay bentis;","poem":2},{"text":"Sa7aa baasoyka qoncis.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Goday bollafe kushe yeddidi,","poem":1},{"text":"tana oykis;","poem":2},{"lineBreak":true},{"text":"ciimmo haathaafe tana kessis.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"I tana ta wolqaama morketape,","poem":1},{"text":"ta wolqaafe bolla gidida tana ixeysatape ashshis.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ta metuwa gallas enti ta bolla dendidosona;","poem":1},{"text":"shin Goday tana zempiseysa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"I tana dalga bessi kessis;","poem":1},{"text":"tanan ufaytida gisho tana ashshis.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ta xillotethaada Goday taw qanxis;","poem":1},{"text":"ta kushe geeshshatethaada taw zaaris.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ayis giiko taani Godaa ogiya kaallas;","poem":1},{"text":"qassi ta Xoossaa aggada iita oothabike.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Taani iya higgiya ubbaa naagas;","poem":1},{"text":"iya wogaa polanaysa aggabike.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Taani iya sinthan suure de7as;","poem":1},{"text":"tana nagarape naagas.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Goday taw ta xillotethaadanne","poem":1},{"text":"ta geeshshatethaada zaaris.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Neeni keehatas keeha;","poem":1},{"text":"suuretas neeni suure.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Geeshshatas neeni geeshshi;","poem":1},{"text":"shin geellatas neeni morke.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Bantana kawusheyisata ashshaasa;","poem":1},{"text":"shin otoranchota kawushaasa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Abeeti Godaw, ta xompey nena;","poem":1},{"text":"Goday ta dhumaa poo7isis.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ne maaduwan ta morketa yedhada baana;","poem":1},{"text":"ta Xoossan gimbe dirsa gupa aadhana.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Xoossaa ogey suure;","poem":1},{"text":"Godaa qaalay geeshshi;","poem":2},{"lineBreak":true},{"text":"iyako baqatiya ubbaas I gondalle.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Goday attishin, hara xoossi oonee?","poem":1},{"text":"Nu Xoossay attishin, hara zaalli oonee?","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Xoossay taw mino miixaa;","poem":1},{"text":"I ta ogiya polo oothees.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"I ta tohuwa gen7e tohoda minthees;","poem":1},{"text":"tana dhoqa bessan minthidi essees.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"I ta kushiya olas loohisees;","poem":1},{"text":"ta qesey naase birata donge dukees.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Tana ashshiya ne gondalliya taw immadasa;","poem":1},{"text":"ne katisoy tana gitayees.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Ta hemethaa dalgisaasa;","poem":1},{"text":"ta gaadiya minthaasa.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Ta morketa yedethada mentherethas;","poem":1},{"text":"enti dhayonna de7ishin guye simmike.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Enti zaaridi dendonna mela shocas;","poem":1},{"text":"ta tohuwape garsan kundidosona.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Olas taw wolqa dancisadasa;","poem":1},{"text":"ta morketa taw gulbatisadasa.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Ta morketa ta sinthafe baqatisadasa;","poem":1},{"text":"tana ixeyisata dhaysas.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Maade koyidi waassidosona;","poem":1},{"text":"shin oonika enta ashshibeenna.","poem":2},{"text":"Godaa enti xeegidosona;","poem":1},{"text":"shin I entaw koybeenna.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Taani enta baanada liiqisas;","poem":1},{"text":"oge urqada enta yedhas.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Makalla ta asaape tana ashshadasa;","poem":1},{"text":"kawotethata bolla tana shuumadasa;","poem":2},{"lineBreak":true},{"text":"ta eronna asay taw haaretis.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Allaga derey tana aaddashees;","poem":1},{"text":"ta woriya si7idi taw kiitetoosona.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Enti wolqa dhayidosona;","poem":1},{"text":"banta miixape kokorishe keyidi yoosona.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Goday de7on de7ees! Ta zaallay anjeto.","poem":1},{"text":"Tana ashshiya zaallay dhoqu dhoqu go.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"I ta haluwa keyiya Xoossaa;","poem":1},{"text":"kawotethata taape garsan haarisees.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Ta morketape tana ashshees;","poem":1},{"text":"ta morketa bolla tana dhoqu dhoqu oothaasa;","poem":2},{"lineBreak":true},{"text":"Oda medhiya asape tana ashshaasa.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Abeeti Godaw taani kawotethata giddon nena galatana;","poem":1},{"text":"ne sunthaa yexana.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Xoossay ba kawas gita xoono immees;","poem":1},{"text":"ba tiyida Dawitasinne iya kochaas,","poem":2},{"lineBreak":true},{"text":"merinaa siiquwa bessees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/2SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":51}