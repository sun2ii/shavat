{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"DEU","translationId":"gof_ltw","name":"Zaaretho Maxaafa","commonName":"Zaaretho Maxaafa","title":"Zaaretho Maxaafa","order":5,"numberOfChapters":34,"sha256":"0cbe3b8a916a692c624c9aa29478ea12711ec2bef91c1d7a765912a63a7adbcc","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/gof_ltw/DEU/34.json","totalNumberOfVerses":958},"chapter":{"number":32,"content":[{"type":"verse","number":1,"content":[{"text":"Saloto, taani odeysa si7ite;","poem":1},{"text":"biittay ta doona qaala hayzo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta timirtey ira mela buko;","poem":1},{"text":"ta qaalay akada wodho.","poem":2},{"text":"Maata bolla wodhiya xaasada","poem":1},{"text":"dola bolla wodhiya puuseda wodho.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taani Godaa sunthaa awaajana;","poem":1},{"text":"gitatetha nu Xoossaas immite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"I nu Zaalla; iya oosoy polo;","poem":1},{"text":"iya ogey suure.","poem":2},{"text":"Xoossay ammantheysa; wordoy baynaysa;","poem":1},{"text":"I tumanchonne suure.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iya sinthan banta tunatethaa bessidosona;","poem":1},{"text":"enti iya na7a gidokona;","poem":2},{"lineBreak":true},{"text":"enti iitanne geella yeletethi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hinteno, eeyanne akeeki bayna asaw,","poem":1},{"text":"hinte Godaas immiya zaaroy haysee?","poem":2},{"text":"I hintena medhida hinte Aawa gidennee?","poem":1},{"text":"hintena medhidi minthi essiday iya gidennee?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Beni wodiya qopa;","poem":1},{"text":"aadhida yeletethaa akeeka.","poem":2},{"text":"Ne aawa oycha; I new odana;","poem":1},{"text":"cimata oycha; enti new qoncisana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ubbaafe Wolqaamay kawotethatas","poem":1},{"text":"enta laata shaakida wode,","poem":2},{"lineBreak":true},{"text":"asa zerethika dummayida wode,","poem":2},{"text":"Isra7eele asaa taybuwa mela,","poem":1},{"text":"asaas enta zawa essis.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Godaa gakida gishoy Isra7eele;","poem":1},{"text":"Yayqoobi iya gakida laata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"I enta mela biittan,","poem":1},{"text":"aykoy bayna mela biittan,","poem":2},{"lineBreak":true},{"text":"carkoy baqishin demmis.","poem":2},{"text":"Iyaw gondalle gidis, iya naagis;","poem":1},{"text":"ba ayfe na77eda minthidi naagis.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Arganthi ba na7a paalo tamaarseysada,","poem":1},{"text":"ba miccida qefiyan gakidi ashsheysada,","poem":2},{"lineBreak":true},{"text":"Goday ba qefiyan haphidi enta ashshis.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Goday ba xalaala enta kaalethis;","poem":1},{"text":"hara allaga xoossi iyara baawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"I biittas dhoqa bessaa enta kessis;","poem":1},{"text":"goshsha ayfiya enta muzis.","poem":2},{"text":"Zaalla qophope enta eessi kalsis;","poem":1},{"text":"shucha biittafe bentiya zayte ushshis.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Enta mehiyape qeesa maathi,","poem":1},{"text":"dorsafenne deeshape xamaata maathi,","poem":2},{"lineBreak":true},{"text":"modho dorsenne deesha asho midosona.","poem":2},{"text":"Baasane dorsaanne deesha ashuwa,","poem":1},{"text":"lo77o giste uythara midosona;","poem":2},{"lineBreak":true},{"text":"suuthi daaniya woyne ushsha uyidosona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Shin Isra7eeley ordis; makallis;","poem":1},{"text":"midi kallidi moollotis.","poem":2},{"text":"Bana medhida Xoossaa aggis;","poem":1},{"text":"ba Atotethaa Zaalla kawushis.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Enti allaga xoossata goyinnidi,","poem":1},{"text":"iya qanaatisidosona.","poem":2},{"text":"Ixetida banta eeqatan","poem":1},{"text":"iya hanqethidosona.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Xoosse gidonaysatas,","poem":1},{"text":"kase enti eronna xoossatas,","poem":2},{"lineBreak":true},{"text":"zine dendidaysatas,","poem":2},{"lineBreak":true},{"text":"enta aawati goyinniboona","poem":2},{"lineBreak":true},{"text":"xoossatas yarshidosona.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Entaw de7o immiya Zaalla dogidosona;","poem":1},{"text":"yelidi dichida Xoossa aggidosona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Adde naytinne macca nayti iya yiloyidosona;","poem":1},{"text":"Goday hessa be7idi enta kadhis.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"I, “Enti geellanne ammanetona dere gidiya gisho,","poem":1},{"text":"taani ta som7uwa entafe genthana;","poem":2},{"lineBreak":true},{"text":"enta wursethaa si77i gada be7ana” yaagis.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Xoosse gidonaysatan tana qanaatisidosona;","poem":1},{"text":"banta eeqatan tana yiloyidosona.","poem":2},{"text":"Taani enta kadhetida asan qanaatisana;","poem":1},{"text":"eeya asan enta yiloyana.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ta hanqoy tamada eexana;","poem":1},{"text":"Si7oole gakanaw xuuggana.","poem":2},{"text":"Biittan de7iyaba ubbaa maana,","poem":1},{"text":"deriya baasuwa gakanaw xuuggana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“Taani enta bolla meto doorana;","poem":1},{"text":"ta dongiyan enta dukana.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ta enta bolla iita kosha yeddana;","poem":1},{"text":"enti hargeninne gadon wurana.","poem":2},{"text":"Enta bolla iita bazzo do7atanne","poem":1},{"text":"dukidi wodhiya iita shooshata yeddana.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Enta, mashshi oge bolla wursana;","poem":1},{"text":"keetha garsan dagami kawotana.","poem":2},{"text":"Na7atetha addetinne maccati wurana;","poem":1},{"text":"guutha naytinne cimati attokona.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ta enta dhaysanawunne","poem":1},{"text":"enta hassayiya asi","poem":2},{"lineBreak":true},{"text":"doonna mela oothanaw qopas.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Shin enta morketi, ‘Xooniday nuna;","poem":1},{"text":"ha ubbaa oothiday Godaa gidenna;","poem":2},{"lineBreak":true},{"text":"yaagidi otoron ceeqetonna mela gada aggaagas’ ” yaagis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Isra7eele asay wozani bayna asi;","poem":1},{"text":"enti akeekokona.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Enti cincidi akeekidako haysa erana,","poem":1},{"text":"banta wursethaka shaakanashin.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Goday enta Xoossay enta bayzonaako,","poem":1},{"text":"enta medhida Wolqaamay aathidi immonaako,","poem":2},{"lineBreak":true},{"text":"waatidi issi asi mukulu asaa,","poem":2},{"lineBreak":true},{"text":"num7u asi tammu mukulu asaa xoonii?","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Nu Zaallay nu morketa zaalla mela","poem":1},{"text":"gidonnaysa enti eroosona.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Enta woyney Soodome woyniyape yees,","poem":1},{"text":"enti Gamoora goshshan dolidosona;","poem":2},{"lineBreak":true},{"text":"ayfiyan marzeynne camoy kumis.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Enta woyney shoosha marze;","poem":1},{"text":"wodhiya soggo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Goday, “Ta hessa dogadina?","poem":1},{"text":"Ta mazgaben xaafabikina?","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Entaw dhayo gallasi matis;","poem":1},{"text":"enta bolla gakanabay ellesees.","poem":2},{"text":"He wode enta tohoy dhubetana;","poem":1},{"text":"ta halo keyananne kushe zaarana.”","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Enta wolqay wuridaysanne","poem":1},{"text":"enta maaddiya asi baynaysa be7ida wode,","poem":2},{"lineBreak":true},{"text":"Goday ba asaas pirdana; ba aylletas qadhetana.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Xoossay entako, “Enti ammanetiya enta xoossati awunee?","poem":1},{"text":"Enti baqatidi qosetiya enta zaallay awunee?” yaagana.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Enta modho yarshuwa midaysati,","poem":1},{"text":"enta woyne ushsha yarshuwa uydaysati,","poem":2},{"lineBreak":true},{"text":"ha77i dendidi enta maaddo; enta asho.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"“Tuma, Godi tana; Xoossi ta xalaala;","poem":1},{"text":"taape attishin, hara Xoossi baawa.","poem":2},{"text":"Wodheynne paathey tana;","poem":1},{"text":"ta madunxisayis; ta pathayis;","poem":2},{"lineBreak":true},{"text":"ta kushepe oonika ashshena.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Ta kushiya denthada haysada yaagana;","poem":1},{"text":"Taani merinaw de7o;","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Phooliya ta mashsha leefada,","poem":1},{"text":"pirdanaw ta kushen oykiya wode,","poem":2},{"lineBreak":true},{"text":"ta morketa bolla ta halo keyana;","poem":2},{"lineBreak":true},{"text":"tana ixeysatas kushe zaarana.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Ta dongey enta suuthan mathotana;","poem":1},{"text":"ta mashshay enta ashuwa maana.","poem":2},{"text":"Tana ixiya ubbaa maarike;","poem":1},{"text":"madunxidaysatinne di7etidaysati hayqana.”","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Kawotethato, Godaa asaara ufaytite;","poem":1},{"text":"I ba aylleta suutha accana.","poem":2},{"text":"Ba morketa bolla halo keyana;","poem":1},{"text":"biittan de7iya ba asaa nagaraa atto gaana.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Museynne Nawe na7ay Iyyasuy Isra7eele asaa shiishidi, ha mazmuriya ubbaa asay si7ishin yexidosona.","poem":1}]},{"type":"verse","number":45,"content":["Musey ha qaala ubbaa Isra7eele asaas odi wursidaape guye,"]},{"type":"verse","number":46,"content":["entako, “Ha higge qaala ubbaa hinte nayti naagana melanne kiitetana mela hachi ta hintew marka oothada immiya qaala ubbaa hinte wozanan wothite."]},{"type":"verse","number":47,"content":["Ha qaalay hintew de7ope attishin, coo qaala gidenna. Hinte ha qaala naagiko, Yordaanose pinnidi laattana biittan adussa laythi daana” yaagis."]},{"type":"verse","number":48,"content":["He gallas Goday Muse haysada yaagis;"]},{"type":"verse","number":49,"content":["“Moo7aben, Iyaarko katamape sintha baggara de7iya Abariima Zumatape issuwa gidida Nabo Zuma bolla keya; yan Isra7eele asaa ta laatisana, Kanaane biitta haahon xeella."]},{"type":"verse","number":50,"content":["Ne ishaa Aaroni Hoora Zuma bolla hayqidi, ba mayzata gakidaysada neka ha zumaa bolla hayqada ne mayzata gakana."]},{"type":"verse","number":51,"content":["Hinte nam7ay Isra7eele asaa sinthan taw ammanetibeketa. Siina mela biittan, Qaadesa matan de7iya Mariba haatha matan ta geeshshatetha Isra7eele asaa bessibeketa."]},{"type":"verse","number":52,"content":["Hessa gisho, neeni he biitta haahon xeellanaape attishin, ta Isra7eele asaa laatisana biitta gelaka” yaagis."]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/DEU/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/DEU/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/DEU/31.json","previousChapterAudioLinks":{},"numberOfVerses":52}