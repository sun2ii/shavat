{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"DEU","translationId":"gof_ltw","name":"Zaaretho Maxaafa","commonName":"Zaaretho Maxaafa","title":"Zaaretho Maxaafa","order":5,"numberOfChapters":34,"sha256":"0cbe3b8a916a692c624c9aa29478ea12711ec2bef91c1d7a765912a63a7adbcc","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/gof_ltw/DEU/34.json","totalNumberOfVerses":958},"chapter":{"number":33,"content":[{"type":"heading","content":["Musey Isra7eele Kocha Anjis"]},{"type":"verse","number":1,"content":["Xoossa asi gidida Musey hayqanaape sinthe, Isra7eele asaa anjida anjo qaalay haysa."]},{"type":"verse","number":2,"content":[{"text":"Musey, “Goday Siina zumaape yis;","poem":1},{"text":"Sayre zumaape nu bolla poo7is.","poem":2},{"lineBreak":true},{"text":"Paarana zumaape phoolis.","poem":2},{"text":"Mukulan taybetiya kiitanchoti iyara de7oosona;","poem":1},{"text":"Iya ushachan tama lacoy de7ees.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Godaw neeni ne asaa dosadasa;","poem":1},{"text":"Geeshshati ubbay ne kushen de7oosona.","poem":2},{"text":"Ne tohuwa garsan ubbay gulbatidi goyinnoosona;","poem":1},{"text":"neepe kiita ekoosona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Musey immida higgiya","poem":1},{"text":"Isra7eele asaa laata ekoosona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isra7eele zerethati deriya halaqatara shiiqida wode,","poem":1},{"text":"Goday ba asaa, Isra7eele bolla kawotis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Robeela kochay taybon guutha gidikoka,","poem":1},{"text":"I hayqofo; paxa de7o.”","poem":2}]},{"type":"verse","number":7,"content":["Musey Yihuda kochaaba,",{"text":"“Godaw, Yihuda waasuwa si7a;","poem":1},{"text":"hanko iya yaratara iya bu7a.","poem":2},{"text":"Enta kushiya minthetha;","poem":1},{"text":"enti banta morketara oletiya wode","poem":2},{"lineBreak":true},{"text":"enta maadda.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Musey Leewe kochaaba,","poem":1},{"text":"ne Tumiimeynne Uriimey,","poem":2},{"lineBreak":true},{"text":"neeni Masahan paacidanne Mariban palamida,","poem":2},{"lineBreak":true},{"text":"ne geeshsha asaasa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bantana yelidaysatape,","poem":1},{"text":"banta ishatapenne banta naytape aathidi,","poem":2},{"lineBreak":true},{"text":"enti new ammanetidosona;","poem":2},{"lineBreak":true},{"text":"ne caaqo qaala naagidosona.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Enti ne wogaa Yayqooba,","poem":1},{"text":"ne higgiya Isra7eele tamaarsoosona.","poem":2},{"text":"Enti ne sinthan ixaane cuyisoosona;","poem":1},{"text":"yarsho bessan xuussa yarsho yarshoosona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abeeti Godaw, Leeweta anja;","poem":1},{"text":"enta kushe oosuwan ne ufayta.","poem":2},{"text":"Enta bolla dendiya morketa mentheretha","poem":1},{"text":"zaari dendonna mela enta morketa cadda.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Biniyaame kochaaba,","poem":1},{"text":"“Godan dosetiday iyan ammanetidi de7ees;","poem":2},{"lineBreak":true},{"text":"qamma gallas I enta naagees;","poem":2},{"lineBreak":true},{"text":"ba hashiyan tookidi shempisees.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yoosefa kochaaba,","poem":1},{"text":"“Goday, salope iran,","poem":2},{"lineBreak":true},{"text":"sa7ape pulto haathan","poem":2},{"lineBreak":true},{"text":"enta biitta anjo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Awan kaxidi dooretida ayfeninne","poem":1},{"text":"woden woden kaxiya ayfen anjeto.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Benipe de7iya deretinne","poem":1},{"text":"zumati lo77o ayfen anjeto.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Enta biittay lo77obay kumida biitta gido;","poem":1},{"text":"tushiya giddon eexiya taman qoncida Goday iya anjo.","poem":2},{"text":"Ha anjoti ubbay Yoosefa kochaa gako;","poem":1},{"text":"I ba ishata giddon halaqa gido.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yoosefi koyro yeletida kormada mino;","poem":1},{"text":"iya kaceti mentha kaceda mino.","poem":2},{"text":"Iya kaceti tammu mukulan taybetiya Efreema kochata;","poem":1},{"text":"mukulun taybetiya Minaase kochata.","poem":2},{"text":"He kacetan I kawotethata qaycana;","poem":1},{"text":"biitta gaxaa gakanaw I enta sugana.”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Zabloona kochaaba,","poem":1},{"text":"“Zabloona, neeni ne kessan ufayta;","poem":2},{"lineBreak":true},{"text":"Yisaakora, neeni ne dunkaaniyan ufayta.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Enti asaa banta zumako xeegana;","poem":1},{"text":"yan enti geeshshatetha yarsho yarshana.","poem":2},{"text":"Banta aquwanne banta duretetha,","poem":1},{"text":"abbaafenne abba gaxan de7iya shafiyape demmana” yaagis.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Gaade kochaaba,","poem":1},{"lineBreak":true},{"text":"“Enta biitta dalgisida Goday galatetto;","poem":1},{"text":"Gaadi morke som7o woyko qese menthanaw,","poem":2},{"lineBreak":true},{"text":"gaammoda naagees.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Enti lo77o biitta bantaw dooridosona;","poem":1},{"text":"halaqatas gida biitta enti ekidosona.","poem":2},{"text":"Isra7eele halaqati shiiqida wode,","poem":1},{"text":"Godaa geeshsha sheniya shaakidi eridosona","poem":2},{"lineBreak":true},{"text":"Isra7eeles suure pirdaa pirdidosona” yaagis.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Daane kochaaba,","poem":1},{"lineBreak":true},{"text":"“Daaney wodala gaammo mela;","poem":1},{"text":"I Baasanepe gupidi keyana” yaagis.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Niftaaleme kochaaba,","poem":1},{"lineBreak":true},{"text":"“Niftaalemey Godaa aadho keehatethan,","poem":1},{"text":"iya anjuwan duretis;","poem":2},{"lineBreak":true},{"text":"enta biittay Abbaafe dugeha bagga gakees” yaagis.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Aseera kochaaba,","poem":1},{"lineBreak":true},{"text":"“Aseeri hara kochatape aadhidi anjetidaysa;","poem":1},{"text":"ba ishatan dosetidaysa gido;","poem":2},{"lineBreak":true},{"text":"iya biittay shamaho zayten dureto.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Iya katamati birata pengen gordetidi naageto;","poem":1},{"text":"ba laytha ubban I wolqaama gido.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Isra7eele, salope nena maaddanaw,","poem":1},{"text":"ba gitatethan shaara bolla hemetiya,","poem":2},{"lineBreak":true},{"text":"ne Xoossaa mela xoossi oonee?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Merinaa Xoossay ne de7iya bessi;","poem":1},{"text":"iya merinaa kusheti neepe garsara de7oosona.","poem":2},{"text":"I ne morketa ne sinthafe kessidi,","poem":1},{"text":"‘enta dhaysa’ yaagis.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Hessa gisho, Isra7eele kochay,","poem":1},{"text":"salo iray bukiya bessan,","poem":2},{"lineBreak":true},{"text":"kathinne woyney kumida biittan,","poem":2},{"lineBreak":true},{"text":"hirgi bayna saro daana.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Isra7eele, ne anjetadaysa;","poem":1},{"text":"Goday ashshida ne meli oonee?","poem":2},{"text":"I new gondallenne maaddiya mashsha;","poem":1},{"text":"ne morketi ne sinthan gufannana;","poem":2},{"lineBreak":true},{"text":"ne enta baasuwa laallana” yaagis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}