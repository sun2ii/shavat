{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"EZK","translationId":"gof_ltw","name":"Hizqeela Maxaafa","commonName":"Hizqeela Maxaafa","title":"Hizqeela Maxaafa","order":26,"numberOfChapters":48,"sha256":"e408d2463161fe9715872964dd19039ad77776c240db9851f836816164813870","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/gof_ltw/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":19,"content":[{"type":"heading","content":["Isra7eele Kawotas Kessida Zelelsi"]},{"type":"verse","number":1,"content":["Goday Hizqeelako, Isra7eele halaqatas haysada yaagada zeleela:"]},{"type":"verse","number":2,"content":[{"text":"“Hinte aayiya gaammota giddon waanida gaammo!","poem":1},{"text":"Yalaga gaammota giddon zin7ada, ba marata dichasu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iya ba maratape issuwa dichin,","poem":1},{"text":"I wodala gaammo gidis;","poem":2},{"lineBreak":true},{"text":"shanka tamaaris; ase muussu doomis.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kawotethati ubbay iyabaa si7idosona;","poem":1},{"text":"enti bookida ollan gelidi oyketis;","poem":2},{"lineBreak":true},{"text":"siidhen wodoro aathidi Gibxe biitta efidosona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iya aayiya naagidaysi hanonna ixin,","poem":1},{"text":"I ufaysay dhaydaysa be7ida wode,","poem":2},{"lineBreak":true},{"text":"ba maratape issuwa dichada, wodala gaammo kessasu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I wodala gaammo gididi, hara gaammota simeretis;","poem":1},{"text":"I shanka tamaaris; ase muussu oykis.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I enta miixaa mentherethis; katamata dhaysis;","poem":1},{"text":"I gudiya wode biittan de7iya asa ubbay dagammees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iya yuushuwan de7iya kawotethati ubbay","poem":1},{"text":"iya oykanaw xihe wothidosona;","poem":2},{"lineBreak":true},{"text":"banta gitiya miccidosona; enta ollan I oyketis;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Enti iya sidhen wodoro aathidi hoothen yeggidi,","poem":1},{"text":"Babiloone kawako efidosona.","poem":2},{"text":"I gudeysi zaaridi Isra7eelen si7etonna mela","poem":1},{"text":"enti iya qasho keethan yeggidosona.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne aayiya haatha doonan toketida woyne mela;","poem":1},{"text":"daro haathi de7iya gisho","poem":2},{"lineBreak":true},{"text":"woyney daashshaninne ayfen kumidi de7ees.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Iya tasheti mino gidiya gisho","poem":1},{"text":"kawota xam7a gididosona.","poem":2},{"text":"Woyney woran de7iya mithatape aadhidi diccis;","poem":1},{"text":"ba tashiya darotethaaninne adussatethan","poem":2},{"lineBreak":true},{"text":"ubbaafe bollara bentis.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Shin he woyney hanqon shodetidi sa7an yegetis;","poem":1},{"text":"doloha carkoy iya ayfiya melisis;","poem":2},{"lineBreak":true},{"text":"iya mino tashey melin tami mis.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ha77i I haathi bayna","poem":1},{"text":"mela biittan toketis.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tami iya ubbaafe keyidi,","poem":1},{"text":"iya ayfiyanne tashiya mis.","poem":2},{"text":"Kawota xam7a gidana mino tashey,","poem":1},{"text":"iya bolla bentibeenna.","poem":2},"Haysi yeeho zelelsi; haysa zelelsi kessiya wode go7etanaw bessees” yaagis."]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}