{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"GEN","translationId":"gof_ltw","name":"Medhetetha Maxaafa","commonName":"Medhetetha Maxaafa","title":"Medhetetha Maxaafa","order":1,"numberOfChapters":50,"sha256":"6328ff24629f53feca4ea2dd87beb19665268871cec7692ef13920bc35cb5b19","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/gof_ltw/GEN/50.json","totalNumberOfVerses":1524},"chapter":{"number":49,"content":[{"type":"heading","content":["Yayqoobi Ba Nayta anjuwa"]},{"type":"verse","number":1,"content":["Hessafe guye, Yayqoobi ba adde nayta xeegidi, “Sinthafe hananaba taani hintew odana mela ha shiiqite” yaagis."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Hinteno Yayqooba nayto,","poem":1},{"text":"issife shiiqidi si7ite;","poem":2},{"lineBreak":true},{"text":"hinte aaway Isra7eeley odeysa hayzite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Robeela, ta bayra na7aw,","poem":1},{"text":"neeni ta wolqaa; ta minotethas koyruwa;","poem":2},{"lineBreak":true},{"text":"neeni bonchonka wolqanka ubbaafe aadhasa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Neeni haatha mela, eqidason de7aka;","poem":1},{"text":"ne ishata bolla bayratethi new bessena.","poem":2},{"text":"Neeni ne aawa hiixan keyadasa;","poem":1},{"text":"ne aawa arsa tunisadasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Simooninne Leewey ishata;","poem":1},{"text":"enti banta mashsha makallatethas denthoosona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Enti banta hanquwan adde wodhidosona,","poem":1},{"text":"banta amuwa kunthanaw boorata gaadiya qanxidosona.","poem":2},{"text":"Yaaniya gisho, taani enta zoretan gelike;","poem":1},{"text":"enta shiiquwanka uttike.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Enta wolqaama hanqoy","poem":1},{"text":"enta wozanaa iitatethay baadetidaba gido.","poem":2},{"text":"Taani, enta Yayqooba asa giddon laallana.","poem":1},{"text":"Isra7eele biittan dharcana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Yihuda,","poem":1},{"noteId":39},{"text":"ne ishati nena galatana;","poem":1},{"lineBreak":true},{"text":"Ne kushey ne morketa qoodhe oykana;","poem":1},{"text":"Ne aawa nayti new hokidi ziggana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yihudaa, neeni wodala gaammo;","poem":1},{"text":"Ta na7aw, neeni shankafe wodhi simmidi,","poem":2},{"lineBreak":true},{"text":"cogotidi zin7ida gaammo mela.","poem":2},{"lineBreak":true},{"text":"Nena bochanaw danda7ey baawa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Merinaw haareysi yaana gakanaw","poem":1},{"text":"kawotetha xam7ay,","poem":2},{"lineBreak":true},{"text":"Yihuda kushepe keyenna;","poem":2},{"lineBreak":true},{"text":"kawotethati iyaw kiitetana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"I ba hariya woyne bolla,","poem":1},{"text":"ba hare mara dooretida woyne bolla qachana;","poem":2},{"lineBreak":true},{"text":"I ba ma7uwa suuthi daaniya woyne ushshan meeccana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Iya ayfey woyne ushshafe aadhidi dulkana;","poem":1},{"text":"iya achay xaamatape aadhidi booxana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Zabloni abba doonan daana;","poem":1},{"text":"I abba doonan markabeti eqiya bessi gidana;","poem":2},{"lineBreak":true},{"text":"iya zaway Sidoona gakana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Yisakoori mino hare mela,","poem":1},{"text":"caanata giddon zin7ees.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Shin I ba shempiya bessay lo77o gideysanne","poem":1},{"text":"ba biittay ufayseysa gideysa be7iya wode,","poem":2},{"lineBreak":true},{"text":"caana tookanaw ba hashiya ziqi oothidi,","poem":2},{"lineBreak":true},{"text":"aylletetha ooso oothana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Daaney","poem":1},{"noteId":40},{"text":"Isra7eele zerethafe issuwa gidiya ba asa bolla pirdana.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Daaney oge gaxan de7iya shoosha mela,","poem":1},{"lineBreak":true},{"text":"Para shuquliya dukidi,","poem":1},{"text":"para toggidaysa guye yeggiya gope mela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Abeeti Godaw, taani ne ashuwa naagayis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Gaade, bonqeysati qohana;","poem":1},{"text":"shin I enta geedo kaallidi oykana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Aseera biittay orde;","poem":1},{"text":"I kawotas lo77o kathi immana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Niftaalemey qashetonna yeda de7iya,","poem":1},{"text":"lo77o marata yeliya gen7e mela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Yoosefi haatha matan toketidi,","poem":1},{"text":"dere bolla zaa7ida, ayfey kumida woyne mela.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Dongen dukeysati iya bolla dendana;","poem":1},{"text":"banta dongiyan dukishe iya gooddana.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Shin Yayqooba Xoossa wolqan,","poem":1},{"text":"Isra7eele henthanchuwa naaguwan,","poem":2},{"lineBreak":true},{"text":"iya dongey mino, iya qesey xaala gidana.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ne aawa Xoossay nena maaddana.","poem":1},{"lineBreak":true},{"text":"Ubbaa Danda7iya Xoossay,","poem":1},{"lineBreak":true},{"text":"Bolla salo anjuwan,","poem":1},{"lineBreak":true},{"text":"Garsa ciimmuwa anjuwan,","poem":1},{"text":"mehenka yelonka nena anjana.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ne aawa anjoy benipe minnidi de7iya zumata anjuwafeka,","poem":1},{"text":"merinaw de7iya deretape bentiya ufaysiya anjuwafeka aadhees.","poem":2},{"text":"Haysi ubbay Yoosefa huuphen,","poem":1},{"text":"ba ishata giddon kaapo gideysa liiphen shempo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Biniyaamey bonqiya suudhume;","poem":1},{"text":"ba olidaaba wonta mees;","poem":2},{"lineBreak":true},{"text":"ba di77idabaa omarsi shaakees” yaagis.","poem":2}]},{"type":"verse","number":28,"content":["Haysati tammanne nam7u Isra7eele sheeshata. Enta aaway enta huuphen huuphen entaw bessiya anjuwa anjishe entako gidabay haysa."]},{"type":"heading","content":["Yayqooba Hayquwa"]},{"type":"verse","number":29,"content":["Hessafe guye, I enta haysada yaagidi kiittis; “Taani ta mayzatan gahetana hanayis. Tana Hite addiya Efroona gaden de7iya gongoluwan ta aawata matan moogite."]},{"type":"verse","number":30,"content":["Hessika, Kanaane biittan, Maammire matan de7iya, Makifeelan de7iya gongoluwa. He gongoloy Abrahaamey moogoos Hite addiya Efroonape iya gadiyara shammida duufuwa."]},{"type":"verse","number":31,"content":["Abrahaameynne iya machiya Saara, Yisaaqinne iya machiya Irbiqa yan moogetidosona. Taani qassi Liyaka yan moogas."]},{"type":"verse","number":32,"content":["He gadeynne iyan de7iya gongoloy Hitetape shametidaysa. Tana yan moogite” yaagis."]},{"type":"verse","number":33,"content":["Yayqoobi, ba nayta kiitaa ongidaape guye ba tohuwa ba hiixan shiishi ekidi, ba mayzatan gahetis."]}],"footnotes":[{"noteId":39,"caller":"+","text":"Yihuda: Yihuda guussay Ibraawetho doonan galata guussu.","reference":{"chapter":49,"verse":8}},{"noteId":40,"caller":"+","text":"Daane: Daane guussay Ibraawetho doonan Pirda guussu.","reference":{"chapter":49,"verse":16}}]},"thisChapterLink":"/api/gof_ltw/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}