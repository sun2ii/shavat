{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"HAB","translationId":"gof_ltw","name":"Inbaqoome Maxaafa","commonName":"Inbaqoome Maxaafa","title":"Inbaqoome Maxaafa","order":35,"numberOfChapters":3,"sha256":"afe1b533c4f77486bf0f47202dcbfdf3a1f014ab5782a4bc442c7a5018eccc15","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gof_ltw/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["Inbaqoome Woosa"]},{"type":"verse","number":1,"content":["Mazmuren shiqida nabiya Inbaqoome woosay haysa:"]},{"type":"verse","number":2,"content":[{"text":"Abeeti Godaw, neeni kase oothidaba taani si7ada yayyas.","poem":1},{"text":"Godaw, nu wodiyanka he oosota zaarada ootha;","poem":2},{"lineBreak":true},{"text":"enti nu wodiyanka ereto.","poem":2},{"lineBreak":true},{"text":"Ne hanqetiya wode ne maarota qopa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Xoossay Temaana biittafe yees;","poem":1},{"text":"Geeshshay Paarana deriyape wodhees.","poem":2},{"text":"Iya bonchoy saluwa kammis;","poem":1},{"text":"iya galatay sa7aa kumis.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iya poo7oy phooliya awa mela;","poem":1},{"text":"iya wolqay qosetidi uttida iya kushiyape","poem":2},{"lineBreak":true},{"text":"xolqiya poo7oy keyees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gadoy iya sinthan bees;","poem":1},{"text":"tama lacoy iya tohuwape keyees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I eqin biittay qaaxis;","poem":1},{"text":"I xeellin kawotethati kokoridosona.","poem":2},{"text":"Merinaa dereti woddidosona;","poem":1},{"text":"I enta bolla hemetiya benipe de7iya zumati laaletidosona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Taani Tophe asaa dunkaaney metootishin be7as;","poem":1},{"text":"Midiyaame biitta asay kokorishin be7as.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abeeti Godaw, neeni ayis hanqetadii?","poem":1},{"text":"Shaafati nena hanqethidona?","poem":2},{"lineBreak":true},{"text":"Woyko ne hanqoy abba bollee?","poem":2},{"text":"Akay, neeni ne paratanne ne para gaareta toggiday","poem":1},{"text":"ne asaas xoono immanaasa gidennee?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neeni ne dongiya waaxadasa;","poem":1},{"text":"dukanaw giigisadasa;","poem":2},{"lineBreak":true},{"text":"biitta phalqada haathe kessadasa. Salaha","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dereti nena be7idi yashshan kokoridosona;","poem":1},{"text":"kixa haathay aadhis.","poem":2},{"text":"Ciimmo haathati waassidosona;","poem":1},{"text":"banta zuliya dhoqu dhoqu oothosona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne dongiya dukan, ne toora phoolethan,","poem":1},{"text":"awinne ageeni banta de7iya bessan eqidosona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Neeni hanquwan biitta ubba yuuyadasa;","poem":1},{"text":"kawotethata ne hanquwan yedhadasa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ne asaanne ne tiyidaysa ashshanaw keyadasa;","poem":1},{"text":"iitata halaqaa shocadasa;","poem":2},{"lineBreak":true},{"text":"iya ma7uwa qaarada kallo ashshadasa. Salaha","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nuna laallanaw goteda yida nu morkiya,","poem":1},{"text":"metootanchota mittanaw geeman qosetidaysa,","poem":2},{"lineBreak":true},{"text":"iya tooran iya caddadasa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Neeni ne paratara abba bolla hemetadasa;","poem":1},{"text":"daro haatha yedhadasa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Taani hessa ubbaa si7in ta wozanay dagammis;","poem":1},{"text":"ta mettershay kokoris.","poem":2},{"text":"Ta meqethay dagammis;","poem":1},{"text":"ta tohoy gundis.","poem":2},{"text":"Nu morketa Goday seerana gakanaw,","poem":1},{"text":"taani metuwa gallasaa danda7an naagana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Balase mithay ayfonna ixikoka,","poem":1},{"text":"woyniya bolla ayfey bentonna ixikoka,","poem":2},{"lineBreak":true},{"text":"shamahoy ayfonna ixikoka,","poem":2},{"lineBreak":true},{"text":"goshshan kathi kaxikoka,","poem":2},{"lineBreak":true},{"text":"girben dorsi dhaykoka,","poem":2},{"lineBreak":true},{"text":"zadalon mehey dhaykoka,","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"taani Godan ufaytana;","poem":2},{"lineBreak":true},{"text":"tana ashshiya Xoossan ufaysan kumana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ta wolqay Ubbaa Haariya Godaa;","poem":1},{"text":"I ta tohuwa gaara tohoda minthees;","poem":2},{"lineBreak":true},{"text":"I tana dhoqa bessan hemethees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}