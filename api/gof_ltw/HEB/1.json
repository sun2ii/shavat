{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"HEB","translationId":"gof_ltw","name":"Ibraawe Kiita","commonName":"Ibraawe Kiita","title":"Ibraawe Asaas Xaafetida Kiita","order":58,"numberOfChapters":13,"sha256":"f1e674ff4b868cae2d2104196ed210b7515471d916246033f9c6eaa3a55f1982","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/gof_ltw/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Na7ay Kiitanchotape Bolla"]},{"type":"verse","number":1,"content":["Kase Xoossay, nu aawatas nabeta baggara dumma dumma ogen daro wode odis."]},{"type":"verse","number":2,"content":["Shin ha wursetha wodiyan ubbaa iya laatisida qassi alame iya baggara medhida ba Na7aa baggara nuus odis."]},{"type":"verse","number":3,"content":["Na7ay Xoossaa bonchuwa phoolethaanne kumetha Xoossa Xoossatetha ekidi, ba wolqaama qaalan ha alamiya katisidi oykis. Asaa enta nagaraape geeshidaape guye Ubbaafe Bolla Xoossaa ushacha baggan saluwan uttis."]},{"type":"verse","number":4,"content":["Iyaw imetida sunthay kiitanchota sunthafe bolla gideysada I entafe bolla."]},{"type":"verse","number":5,"content":["Hiza, Xoossay kiitanchotape oodeko,",{"text":"“Neeni ta Na7a;","poem":1},{"text":"ta hachi new aawa gidas” gidee?","poem":2},"Woyko qassi oodeko,",{"text":"“Taani iyaw aawa gidana;","poem":1},{"text":"ika taw na7a gidana” gidee?","poem":2}]},{"type":"verse","number":6,"content":["Qassi Xoossay ba bayra Na7aa ha alamiya kiittishe,",{"text":"“Xoossaa kiitanchoti ubbay iyaw goyinno”","poem":1},"yaagis."]},{"type":"verse","number":7,"content":["Xoossay kiitanchotaba odishe,",{"text":"“Xoossay ba Kiitanchota carko,","poem":1},{"text":"ba aylleta tama laco oothees”","poem":2},"yaagees."]},{"type":"verse","number":8,"content":["Shin ba Na7aba odishe,",{"text":"“Xoossaw, ne araatay merinaw de7ees.","poem":1},{"text":"Ne kawotethaa ne xillotethan aysaasa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neeni xillotethi dosadasa; iita ixadasa.","poem":1},{"text":"Xoossay, ne Goday, nena ne laggetape aathidi dooris,","poem":2},{"lineBreak":true},{"text":"ufaysa zayte","poem":2},{"noteId":0},{"text":"nena tiyis”","poem":2},"yaagees."]},{"type":"verse","number":10,"content":["Xoossay Zaaridi,",{"text":"“Godaw, koyro neeni sa7a medhadasa;","poem":1},{"text":"saloti ne kushe ooso.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hessati ubbay dhayana;","poem":1},{"text":"shin neeni daana.","poem":2},{"lineBreak":true},{"text":"Enti ubbay afilada wurana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Neeni enta saleenada xaaxana;","poem":1},{"text":"qassi enti afilada laametana.","poem":2},{"text":"Shin neeni ubba wode nena;","poem":1},{"text":"ne laythayka wurenna”","poem":2},"yaagees."]},{"type":"verse","number":13,"content":["Shin Xoossay kiitanchotape oodeko,",{"text":"“Taani ne morketa ne tohoy","poem":1},{"text":"yedhiyaso oothana gakanaw,","poem":2},{"lineBreak":true},{"text":"haysan taape ushacha baggan utta” gidee?","poem":2}]},{"type":"verse","number":14,"content":["Kiitanchoti ubbay atotethi demmanaw de7iya asata maaddanaw Xoossay kiitida ayyaanata gidokonaayee?"]}],"footnotes":[{"noteId":0,"caller":"+","text":"Ufaysa zayte: I kawotiya wode asay ufaysan ililidi iya kawotheysa bessees.","reference":{"chapter":1,"verse":9}}]},"thisChapterLink":"/api/gof_ltw/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}