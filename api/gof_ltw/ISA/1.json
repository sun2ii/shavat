{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Ooziyani, Iyo7atami, Akaazinne Hizqiyaasi Yihudan kaalli kaallidi kawotida wode Amoxe na7ay Isayaasi Yihudabaanne Yerusalaameba be7ida qoncethay haysa."]},{"type":"heading","content":["Si7onna Dere"]},{"type":"verse","number":2,"content":[{"text":"Saloto si7ite; sa7aw hayza si7a;","poem":1},{"text":"Goday haysada yaagees;","poem":2},{"text":"“Ta nayta yelada dichas;","poem":1},{"text":"shin enti taw makallidosona.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Boori ba godaa erees;","poem":1},{"text":"hareyka bana haaridaysa zadaluwa erees.","poem":2},{"text":"Shin Isra7eeley erenna;","poem":1},{"text":"ta asay akeekenna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hinteno, nagarancho kawotethato,","poem":1},{"text":"bala ooson deexidaysato,","poem":2},{"lineBreak":true},{"text":"iitaa oothiya yeletethato,","poem":2},{"lineBreak":true},{"text":"tuna oosos imetida nayto,","poem":2},{"text":"Godaa aggidaysato,","poem":1},{"text":"hintena ayye!","poem":2},{"text":"Isra7eele Geeshshaa kadhideta;","poem":1},{"text":"iyaw zoko zaarideta.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Makalla bolla makalla ayis gujeetii?","poem":1},{"text":"Ayis zaari zaari shoceteetii?","poem":2},{"text":"Hinte huuphey hargetis;","poem":1},{"text":"hinte wozanay daaburis.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Huuphe binaanape toho xugunthi gakanaw payyatethi baawa;","poem":1},{"text":"madunthi, kixinne dhuusi ma7is.","poem":2},{"text":"Enti giiybookona, woyko meecetidi qashetibookona","poem":1},{"text":"woyko zayten tiyetidi looxikbookona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Hinte biittay oxis;","poem":1},{"text":"hinte katamati taman xuugetidosona.","poem":2},{"text":"Hinte be7ishin hinte goshsha allagati ekana;","poem":1},{"text":"imatha asati hinte biitta quu7e kessana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yerusalaamey woyne gaden de7iya shaqarada,","poem":1},{"text":"leehe giddon de7iya gaabbadanne","poem":2},{"lineBreak":true},{"text":"morken teqetida katamada hanada attana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ubbaafe Wolqaama Goday nuus guutha koche ashshonaako","poem":1},{"text":"nuuni Soodomenne Gamoora katamaada hananashin” yaagis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Hinteno, Soodome halaqato, Godaa qaala si7ite!","poem":1},{"text":"Hinteno, Gamoora asaw, nu Xoossa higgiya si7ite!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Hinte yarsho daroy taw ay oothii?","poem":1},{"text":"Hanno gakanaw hinte taw shiishida urge dorsaanne","poem":2},{"lineBreak":true},{"text":"modho mehe xuussa yarshoy taw gidana.","poem":2},{"text":"Taani kormata, dorsa urgetanne","poem":1},{"text":"deeshata suuthan ufaytike.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hinte ta sinthan bentanaw yaa wode","poem":1},{"text":"ta keethaa dabaaba hinte yedhana mela oone oychiday?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hada yarshuwa eheysa aggite!","poem":1},{"text":"Hinte cuyisiya ixaaney tana shaattees.","poem":2},{"text":"Ageena xeeron hinte bonchiya gallasa,","poem":1},{"text":"Sambaatanne iitatethan hinte shiiqiya shiiquwa taani ixayis.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ageena xeeron hinte bonchiya gallasaanne","poem":1},{"text":"hinte ba7aale gallasata taani ixas;","poem":2},{"lineBreak":true},{"text":"enti taw tooho gididosona;","poem":2},{"lineBreak":true},{"text":"taani enta tookanaw danda7ike.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hinte kushe miccidi tana woossiya wode","poem":1},{"text":"taani ta ayfiya hintefe genthana.","poem":2},{"text":"Hinte kushey suuthan kumida gisho","poem":1},{"text":"hinte darsi woossikoka taani si7ike.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Meecetite; hintena geeshshite;","poem":1},{"text":"hinte iita oosuwa ta sinthafe diggite;","poem":2},{"lineBreak":true},{"text":"gene hanuwa aggite.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Lo77oba ooso tamaarite;","poem":1},{"text":"xillo pirdaa koyite.","poem":2},{"text":"Un7etidaysata ashshite; yi7otas eqite;","poem":1},{"text":"am7etas mootetite”","poem":2},"yaagees Goday."]},{"type":"verse","number":18,"content":["“Haayite; ane woli ammanthoos. Hinte nagaray baara biittada zo7ikoka, shachada booxana; suuthada zo7ikoka puutoda booxana."]},{"type":"verse","number":19,"content":["Hinte ero gidi taw kiitetiko biitta anjuwa maana."]},{"type":"verse","number":20,"content":["Shin hinte ixas gidi makalliko, mashshan meetetana” yaagees Goday ba doonan."]},{"type":"verse","number":21,"content":["Ammanetida katamiya waanada layma gidadee? Kase suuretethinne xillotethi I giddon kumis, shin ha77i shempo wodheysati I giddon de7ees."]},{"type":"verse","number":22,"content":["Ne biray baltis; ne mal7o woyney haathan yeletis."]},{"type":"verse","number":23,"content":["Hinte halaqati makallanchotanne kayso lagge gididosona; enti ubbay wodhaafe doseysatanne kushe xeelleyisata. Yi7otas suure pirdokona; am7eta waasuwa si7okona."]},{"type":"verse","number":24,"content":["Hessa gisho, Goday, Ubbaafe Wolqaama Xoossay, Isra7eele Wolqaamay, haysada yaagees; “Ha77i taani ta morketa bolla ta hanquwa gussana; taara eqeteyisata halo keyana."]},{"type":"verse","number":25,"content":["Taani ta kushiya ne bolla zaarana; ne baltetha geeshshana; ne tunatetha ubbaa neepe diggana."]},{"type":"verse","number":26,"content":["Taani beniysada ne halaqata, koyroysada ne zoranchota denthana. Hessafe guye, neeni ammanetida biitta; xillotetha Katama geetetana” yaagees."]},{"type":"verse","number":27,"content":["Xiyooney suure pirdan, banta nagara paaxeysatika xillotethan wozetana."]},{"type":"verse","number":28,"content":["Shin makallanchotinne nagaranchoti issife meqana; Godaa aggeysati dhayana."]},{"type":"verse","number":29,"content":["Hinte ufaytida yarsho wolan yeellatana; hinte doorida kooran kawuyana."]},{"type":"verse","number":30,"content":["Hinte haythi qoqofetidi wurida woladanne haathi dhayida atakilte bessada gidana."]},{"type":"verse","number":31,"content":["Bana mino gey buuxa gidana; iya oosoyka pol7u gidi to7iya tama gidana; enti issife xuugetana; he tama toysana asi baawa."]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}