{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":11,"content":[{"type":"heading","content":["Isseyepe Keyda Aaca"]},{"type":"verse","number":1,"content":["Isseye durumay aacana; iya xaphuwape ayfiya tashey keyana."]},{"type":"verse","number":2,"content":[{"text":"Godaa Ayyaanay iya bolla shempana;","poem":1},{"text":"cincatethaanne akeeka Ayyaanay,","poem":2},{"lineBreak":true},{"text":"zoriyanne wolqaa Ayyaanay,","poem":2},{"lineBreak":true},{"text":"eratethaanne Godaas yayiya Ayyaanay, iya bolla shempana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Godaas yayyidi ufaytees;","poem":1},{"text":"ba ayfey be7idaban coo pirdenna;","poem":2},{"lineBreak":true},{"text":"woyko ba haythay si7idaban coo kuuyenna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Shin I, manqotas xillotethan pirdana;","poem":1},{"text":"sa7an de7iya metootanchotas suuretethan kuuyana.","poem":2},{"text":"I ba inxarsaa xam7an sa7aa shocana;","poem":1},{"text":"ba doona shempuwan iitata wodhana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xillotethi iya xeessa danco gidana;","poem":1},{"text":"ammanetethi iya miyaas saqe gidana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Suudhumey dorsa marara issife daana;","poem":1},{"text":"maahey deesha marara issife zin7ana.","poem":2},{"text":"Mari gaammo butalera issife hemetana;","poem":1},{"text":"guutha na7i enta heemmana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Miizinne babanthi issife heemetana;","poem":1},{"text":"enta marati issife zin7ana;","poem":2},{"lineBreak":true},{"text":"gaammoy boorada kale maana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dhammiya na7i shoosha ollan kaa7ana;","poem":1},{"text":"dhanthi duuxida na7i wodhiya shoosha ollan ba kushiya yeddana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ta geeshsha zumaa bolla","poem":1},{"text":"oonika qohetenna woyko dhayenna.","poem":2},{"text":"Abbi haathan kumeysada","poem":1},{"text":"sa7i Godaa eron kumana.","poem":2}]},{"type":"verse","number":10,"content":["He wode Isseye xaphoy asaas malla gidana;",{"text":"kawotetha ubbay iya koyana;","poem":2},{"lineBreak":true},{"text":"I de7iya bessay bonchetana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"He gallas Goday attida ba asaa, Asoorepe, Gibxefe, Phatroosape, Tophefe, Elaamape, Sana7oorepe, Hamaatapenne yuushoy abban teqetida biittafe nam7antho ehanaw ba kushiya zaaridi yeddana.","poem":1}]},{"type":"verse","number":12,"content":[{"text":"I kawotethatas malla dhoqu oothidi denthana; Isra7eelepe laaletidaysata issife gathana; Yihudape sa7aa oyddu baggan zeretidaysata shiishana.","poem":1}]},{"type":"verse","number":13,"content":["Hessafe guye, Efreema qanaatey iyape kichana; Yihuda morketethay iyape qanxetana. Efreemi Yihuda qanaatenna; Yihudi Efreema morkenna."]},{"type":"verse","number":14,"content":["Enti wuloha baggan de7iya Filisxeeme biitta bolla gupi wodhana; enti doloha baggan de7iya asaa bonqana. Enti Edoome bollanne Moo7abe bolla banta kushiya wothana; Amooneti entaw haaretana."]},{"type":"verse","number":15,"content":["Goday Gibxe matan de7iya Zo7o Abbaa melisana; ba melsiya carkuwara ba kushiya Efraxiisa shaafa bolla qaathana. Yaatidi asay mela bessaara pinnana mela laapun guutha shaafa kessidi shaakana."]},{"type":"verse","number":16,"content":["Isra7eele asay Gibxe biittafe keyiya wode ogey keydaysada, attida iya asay, Asoore biittafe simmiya ogey keyana."]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/10.json","previousChapterAudioLinks":{},"numberOfVerses":16}