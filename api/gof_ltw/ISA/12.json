t":[{"text":"Goday gita ooso oothida gisho, iyaw yexite;","poem":1},{"text":"haysi sa7a ubban ereto.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isra7eele Geeshshay hinte giddon gita gidiya gisho,","poem":1},{"text":"Xiyoone asaw, ililite, ufaysan yexite!” yaagana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}