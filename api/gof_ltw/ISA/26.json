{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":26,"content":[{"type":"heading","content":["Xoono Mazmure"]},{"type":"verse","number":1,"content":["He gallas Yihuda biittan ha mazmurey yexetana.",{"text":"Nuus mino katami de7ees;","poem":1},{"text":"Xoossay atotetha","poem":2},{"lineBreak":true},{"text":"iya yuushuwan gimbenne miixa oothis.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ba ammanuwa naagiya xillo derey,","poem":1},{"text":"gelana mela kareta dooyite.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"I nenan ammanetida gisho,","poem":1},{"text":"ba wozanaa nenan wothida uraa,","poem":2},{"lineBreak":true},{"text":"neeni polo sarotethan naagasa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Goday merinaa zaalla gidiya gisho,","poem":1},{"text":"Godan merinaw ammaneta.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dhoqan de7eyisata ziqi oothis;","poem":1},{"text":"dhoqu gida katamaa kawushis.","poem":2},{"text":"Iya sa7an duge yeggis;","poem":1},{"text":"biitta baanan holis.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Manqoti iya yedhana","poem":1},{"text":"un7etidaysati iya bollara hemetana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Xillota ogey suure;","poem":1},{"text":"Abeeti Xilluwaw, neeni xillota ogiya giigisaasa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abeeti Godaw, nuuni ne higgiya naaganaw amottoos;","poem":1},{"text":"ne sunthaa bonchoynne ne teemay nu wozanaa amo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Qamma taani nena laamotas;","poem":1},{"text":"wonta ta ayyaanay nena minthidi koyees.","poem":2},{"text":"Ne biitta pirdanaw yaa wode,","poem":1},{"text":"sa7an de7iya asay xillotethi tamaarees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iita asas keehatethi oosetikoka,","poem":1},{"text":"I xillotethi tamaarenna.","poem":2},{"text":"Suure biittan iitabaa oothees;","poem":1},{"text":"Godaa gitatetha erenna.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abeeti Godaw, ne kushey dhoqu gis;","poem":1},{"text":"shin enti be7okona.","poem":2},{"text":"Ne asaas neeni mishetiya misha","poem":1},{"text":"be7idi yeellato.","poem":2},{"text":"Neeni ne morketas giigisida tamay","poem":1},{"text":"enta midi dhayso.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abeeti Godaw, nuus sarotethi immadasa;","poem":1},{"text":"nu ooso ubbaa ne oothadasa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Abeeti Godaw, nu Xoossaw,","poem":1},{"text":"hara godati nuna haaridosona;","poem":2},{"lineBreak":true},{"text":"shin nuuni ne sunthaa xalaala bonchoos.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Enti hayqidosona; simmidi de7on dookona.","poem":1},{"text":"Ne seerin dhayida gisho, zaaridi dendokona.","poem":2},{"lineBreak":true},{"text":"Enta qofisuwa ubbaa quchada dhaysadasa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Abeeti Godaw, neeni kawotethaa darsadasa;","poem":1},{"text":"kawotethaa darsada neeni bonchetadasa;","poem":2},{"lineBreak":true},{"text":"biitta zawa ubbaa dalgisadasa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Abeeti Godaw, meto wode enti nena koydosona.","poem":1},{"text":"Ne enta seerida wode nena kalkashidi woossidosona.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Abeeti Godaw, qanthatida maccasi,","poem":1},{"text":"yelo wodey gakin un7etada waasseysada,","poem":2},{"lineBreak":true},{"text":"nuuni ne sinthan hessada hanida.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nuuni qanthatida; iqetida;","poem":1},{"text":"shin carko yelida.","poem":2},{"text":"Nuuni sa7aas atotethi ehibooko;","poem":1},{"text":"biittan de7iya asaa yelibooko.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hayqida ne asay paxana;","poem":1},{"text":"enta ahay dendana.","poem":2},{"text":"Hinteno, biitta garsan de7eysato,","poem":1},{"text":"dendidi ufaysa mazmure yexite.","poem":2},{"text":"Hinte akay wonta aka mela;","poem":1},{"text":"biittiya hayqidaysata zaarada immana.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ta asaw, bidi hinte soo gelidi,","poem":1},{"text":"kariya hinte bolla gordite.","poem":2},{"text":"Godaa hanqoy aadhana gakanaw,","poem":1},{"text":"guutha wodes hintena qosite.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Biitta bolla de7iya asaa,","poem":1},{"text":"enta nagaraa gisho seeranaw,","poem":2},{"lineBreak":true},{"text":"Goday ba de7iya bessaafe keyidi yees.","poem":2},{"text":"Biittiya ba bolla gukida suuthaa qoncisana;","poem":1},{"text":"hayqidaysata zaarada genthuku.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}