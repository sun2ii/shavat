{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":38,"content":[{"type":"heading","content":["Hizqiyaasa Hargiya"]},{"type":"verse","number":1,"content":["He wode kawoy Hizqiyaasi hargidi, hayqanaw matis. Amoxe na7ay nabey Isayaasi iyako bidi, Goday, “Ne hayqana haniya gisho ne keetha giigisa” yaagis."]},{"type":"verse","number":2,"content":["Hizqiyaasi godaako simmi zin7idi, Godaa woossis."]},{"type":"verse","number":3,"content":["“Abeeti Godaw, taani ne sinthan tumatethaninne kumetha wozanan hemetidaysanne nena ufaysiyabaa oothidaysa hassaya” yaagidi cametidi yeekis."]},{"type":"verse","number":4,"content":["Hessafe guye, Godaa qaalay Isayaasako,"]},{"type":"verse","number":5,"content":["Bada Hizqiyaasako, Goday ne mayza Dawita Xoossay, “Taani ne woosa si7as; ne afuthaa be7as. Ne laytha bolla taani tammanne ichashu laytha gujana."]},{"type":"verse","number":6,"content":["Nenanne ha katamaa Asoore kawa kushepe ashshana; taani ha katamaas oletana” yaaga."]},{"type":"verse","number":7,"content":["“Goday ba gida qaala polanaw immida mallay haysa yaagis:"]},{"type":"verse","number":8,"content":["Akaazi keyanaw giigisida dethan de7iya kuyay tammu tango guye simmidi baana mela taani oothana” yaagis. Kuyay tammu tango guye simmidi bis."]},{"type":"verse","number":9,"content":["Yihuda kawoy Hizqiyaasi hargiyafe paxidi xaafida mazmurey haysa:"]},{"type":"verse","number":10,"content":[{"text":"Taani, “Ta de7o laythay bagga gakonna de7ishin,","poem":1},{"text":"hayqo pengera gelana haniyana?","poem":2},{"lineBreak":true},{"text":"Attida laytha bonqetana haniyana?” yaagas.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Taani de7on de7eyisata biittan Godaa be7ike;","poem":1},{"text":"ha sa7an ase be7ike;","poem":2},{"lineBreak":true},{"text":"ha alamiyan de7eysatara zaarada de7ike.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dorse heemmeyisata dunkaaniyada,","poem":1},{"text":"ta de7oy shodetis.","poem":2},{"text":"Dorzey afila wandaraashen xaaxeysada,","poem":1},{"text":"ta de7oy xaaxetis.","poem":2},{"text":"Dorzey afila duuthiyada,","poem":1},{"text":"ta de7uwa duuthis.","poem":2},{"text":"Wontafe omarsi gakanaw","poem":1},{"text":"tana dhaysaasa” yaagas.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Qamma kumetha danda7an naagas;","poem":1},{"text":"gaammoda ta meqetha ubbaa menthadasa;","poem":2},{"lineBreak":true},{"text":"wontafe omarsi gakanaw tana dhaysadasa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Taani kaarodanne cilashoda waassas;","poem":1},{"text":"holleda zuuzumas.","poem":2},{"text":"Ta ayfey salo xeellishe daaburis;","poem":1},{"text":"Godaw, taani un7etas;","poem":2},{"lineBreak":true},{"text":"neeni tana ha un7aafe kessa” yaagas.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Haysa ubbaa oothiday Godaa;","poem":1},{"text":"taani ay gaanaw danda7iyana?","poem":2},{"text":"Ta shempoy un7etida gisho,","poem":1},{"text":"ta laytha ubbaa ashketethan daana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Godaw, haysa mela seeran","poem":1},{"text":"asay de7on de7ees.","poem":2},{"text":"Ha77i ta payyatetha zaarada,","poem":1},{"text":"tana de7on wotha!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ta un7etethay taw lo77o gidis;","poem":1},{"text":"neeni ta shempuwa dhayo ollafe ashshadasa;","poem":2},{"lineBreak":true},{"text":"ta nagara ubbaa neeni guye yeggadasa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Duufoy nena galatenna;","poem":1},{"text":"hayqoy nena sabbenna.","poem":2},{"text":"Ollan wodhidaysati,","poem":1},{"text":"ne ammanetetha ufaysi oothokona.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Taani hachi nena galateysada,","poem":1},{"text":"de7on de7eysati nena galatoosona.","poem":2},{"text":"Ne ammanetetha","poem":1},{"text":"aawati banta naytas odoosona.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Goday tana ashshana;","poem":1},{"text":"hessa gisho, nuuni nu de7o laytha ubban,","poem":2},{"lineBreak":true},{"text":"Godaa keethan diithan yexana.","poem":2}]},{"type":"verse","number":21,"content":["Isayaasi kase, “Balase daaxidi,",{"text":"iya kixa bolla wothite;","poem":2},{"lineBreak":true},{"text":"I paxana” yaagis.","poem":2}]},{"type":"verse","number":22,"content":["Hizqiyaasi kase, “Taani paxada Godaa keethi baanaysas mallay aybe” yaagidi Isayaasa oychis."]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}