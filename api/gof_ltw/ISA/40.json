{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":40,"content":[{"type":"heading","content":["Minthetho Qaala"]},{"type":"verse","number":1,"content":[{"text":"Hinte Xoossay haysada yaagees:","poem":1},{"text":"“Ta deriya minthethite! Minthethite!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"I aylletethan de7ida wodey poletis;","poem":1},{"text":"iya nagaray atto geetetis;","poem":2},{"lineBreak":true},{"text":"ba nagaraa gisho, Goday iya dako seeridaysa,","poem":2},{"lineBreak":true},{"text":"Yerusalaames liiqo qaalan odite; awaajite” yaagees.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Haysada giya girsay si7etees;","poem":1},{"text":"“Mela biittan Godaa ogiya giigisite;","poem":2},{"lineBreak":true},{"text":"nu Xoossaas Araba mela biittan","poem":2},{"noteId":2},{"text":"horoga sitti oothite.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Zangaara ubbay dhoqu gaana;","poem":1},{"text":"dereynne zumay ziqi gaana;","poem":2},{"lineBreak":true},{"text":"iita ogetinne gela kessati dembatana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"He wode Godaa bonchoy qoncana;","poem":1},{"text":"asho ma7ida ubbay hessa issife be7ana.","poem":2},{"lineBreak":true},{"text":"Godaa doonay haysa odis” yaagees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Issi girsi, “Waassa” yaagishin si7as;","poem":1},{"text":"taani, “Woygada waasso?” yaagas.","poem":2},{"lineBreak":true},{"text":"“Asi ubbay maata mela;","poem":1},{"text":"iya boncho ubbay ciishsha mela.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Godaa iya bolla shempiya wode,","poem":1},{"text":"maatay melees; ciishshay qoqofetees;","poem":2},{"lineBreak":true},{"text":"asi tuma maata mela.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Maati melees; ciishshi qoqofetees;","poem":1},{"text":"shin nu Xoossaa qaalay","poem":2},{"lineBreak":true},{"text":"merinaw eqidi de7ees” yaagada waassa.","poem":2}]},{"type":"verse","number":9,"content":["Neno Xiyoones lo77oba odeyso;",{"text":"zuma bolla keya.","poem":2},{"text":"Neno Yerusalaames lo77oba odeteyso;","poem":1},{"text":"ne qaala dhoqu oothada waassa.","poem":2},{"text":"Yayyofa; dhoqu ootha;","poem":1},{"text":"Yihuda katamatas, “Hinte Xoossay haysish” yaaga.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Heko, Ubbaa Haariya Goday wolqara yees;","poem":1},{"text":"iya qesey iyaw haarana.","poem":2},{"text":"Iya woytoy iyara de7ees;","poem":1},{"text":"ciggiya gatey iya sinthana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"I ba wudiya henthanchoda heemmana;","poem":1},{"text":"Ba dorsa marata ba qesiyan shiishana;","poem":2},{"lineBreak":true},{"text":"enta ba ki7on idimmana;","poem":2},{"lineBreak":true},{"text":"dhantheyisata loddara kaalethana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Haathata ba kushe qaaqan,","poem":1},{"text":"salota takadhon likiday,","poem":2},{"lineBreak":true},{"text":"biitta baana daachon makiday,","poem":2},{"lineBreak":true},{"text":"deretanne zumata mizaanen likiday oonee?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Godaa Ayyaana eriday,","poem":1},{"text":"iya zoridi tamaarsiday oonee?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iyaw qoncisana mela oona zore oychidee?","poem":1},{"text":"Suure pirdaa iya tamaarsiday oonee?","poem":2},{"text":"Iya cincatethi tamaarsiday,","poem":1},{"text":"iya akeeka bessiday oonee?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Heko, kawotethati xuggan de7iya issi xoko mela;","poem":1},{"text":"enti mizaane bolla de7iya baana mela;","poem":2},{"lineBreak":true},{"text":"I yuushoy abban teqetida biittata baanada likes.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Libaanose mithay yarsho bessan eexanaw gidenna;","poem":1},{"text":"iyan de7iya do7ati xuussa yarshos gidokona.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kawotethati ubbay iya sinthan baynaba mela;","poem":1},{"text":"enti iya sinthan ubba aykoka gidokona;","poem":2},{"lineBreak":true},{"text":"baynabapeka laafa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yaatin, Xoossaa hinte oodera ginayetii?","poem":1},{"text":"Ayba misilera gathidi xeelletii?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kushe hiillanchoy eeqa misile giigisees;","poem":1},{"text":"worqa sheesheysi worqan lanxees;","poem":2},{"lineBreak":true},{"text":"bira sheesheysi iya bolla","poem":2},{"lineBreak":true},{"text":"bira santhalaata medhees.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Miishey bayna manqoy,","poem":1},{"text":"yarshos xoodhonna mithi doorees.","poem":2},{"text":"Misiley qaaxonna mela essanaw","poem":1},{"text":"kushe hiillancho koyees.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Eribeeketii? Woyko si7ibeeketii?","poem":1},{"text":"Haysi hintew koyrope odetibeennee?","poem":2},{"text":"Woyko sa7i medhetoosape","poem":1},{"text":"haysa hinte akeekibeketii?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"I biitta gertuwafe bolla baggan","poem":1},{"text":"ba araatan uttees;","poem":2},{"lineBreak":true},{"text":"biittan de7iya asati xaqo mela.","poem":2},{"text":"Salota gesheda miccees;","poem":1},{"text":"dunkaaneda de7iya bessi oothidi tolees.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"I, halaqata baynabaada oothees;","poem":1},{"text":"ha alamiya haareyisata hada kessees.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Enti toketidi buroo gam7onnashin,","poem":1},{"text":"zeretidi buroo xapho yeddonnashin,","poem":2},{"text":"Goday enta bolla carko yeddis;","poem":1},{"text":"enti melin gotey enta punoda efis.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yaatin, tana oodera likeyetii?","poem":1},{"text":"Tana oodera ginayetii? yaagees geeshshay.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hinte ayfiya dhoqu oothidi salo xeellite;","poem":1},{"text":"ha xoolintota medhiday oonee?","poem":2},{"text":"I enta olanchoda kaalethees;","poem":1},{"text":"enta taybuwa erees.","poem":2},{"text":"I enta ubbaa enta sunthan sunthan xeegees;","poem":1},{"text":"iya wolqa gitatethaafenne minotethafe dendoysan,","poem":2},{"lineBreak":true},{"text":"entafe issoyka dhayenna.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Neno Yayqoobaa, neno Isra7eele,","poem":1},{"text":"Ta ogey Godaape geemmis;","poem":2},{"lineBreak":true},{"text":"ta pirday Xoossaafe qosetis;","poem":2},"yaagada ayis odetay?"]},{"type":"verse","number":28,"content":[{"text":"Erabikii? Si7abikii?","poem":1},{"text":"Goday merina Xoossa;","poem":2},{"lineBreak":true},{"text":"biitta ubbaa medhiday iya.","poem":2},{"text":"I daaburenna; woyko argaacena;","poem":1},{"text":"oonika iya qofaa eranaw danda7ena.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"I daaburidaysatas wolqa immees;","poem":1},{"text":"minotethi baynaysas minotethi gujees.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Hari attoshin yalaga nayti","poem":1},{"text":"daaburoosona; argaacosona;","poem":2},{"lineBreak":true},{"text":"na7atethati daaburidi kundoosona.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Shin Godaa ammanetidi naageysati,","poem":1},{"text":"banta wolqaa oorathana.","poem":2},{"text":"Enti arganthada qefen paallana;","poem":1},{"text":"woxana, shin daaburokona;","poem":2},{"lineBreak":true},{"text":"hemetana, shin argaacokona.","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":": Aykoyka bayna manqo biitta woyko mela biitta woyko xuugetida biitta guussu","reference":{"chapter":40,"verse":3}}]},"thisChapterLink":"/api/gof_ltw/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}