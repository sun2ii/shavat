{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":41,"content":[{"type":"heading","content":["Isra7eele Maaduwa"]},{"type":"verse","number":1,"content":[{"text":"Hinteno, yuushoy abban teqetida biittato,","poem":1},{"text":"si77i gidi, taani odeysa si7ite!","poem":2},{"text":"Derey banta wolqaa ooratho;","poem":1},{"text":"enti haa shiiqidi, odeto;","poem":2},{"lineBreak":true},{"text":"ane nuuni pirdetanaw issife shiiqoos.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“Doloha baggafe issuwa denthidi biya bessa ubban xoono immey oonee?","poem":1},{"text":"I kawotethata iya kushen aathidi immees;","poem":2},{"lineBreak":true},{"text":"kawota iyaw haarisis.","poem":2},{"text":"I enta ba mashshan bido kessees;","poem":1},{"text":"ba dongiyan enta puno oothees.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"I enta yedethishe, iya tohoy kase yedhiboona","poem":1},{"text":"ogiyara saro kanthees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Haysa oothidaynne poliday","poem":1},{"text":"yeletethaaka koyrope xeegiday oonee?","poem":2},{"text":"Taani Goday, koyruwara de7ayis","poem":1},{"text":"wursetharaka de7ey tana” yaagees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yuushoy abban teqetida biittati,","poem":1},{"text":"hessa be7idi yayyidosona;","poem":2},{"lineBreak":true},{"text":"sa7aa gaxan de7eysati kokoridosona.","poem":2},{"text":"Enti issife shiiqidi taako yidosona.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Issoy issuwa maaddees;","poem":1},{"text":"ba ishaa, “Minna” yaagees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kushe hiillanchoy worqa sheesheysa minthethees;","poem":1},{"text":"naariqan qoxidi lee7iseysi","poem":2},{"lineBreak":true},{"text":"baachan birata seeriseysa, “Minna” gees.","poem":2},{"text":"I birata dhantheysa, “Lo77o oothaasa” yaagees;","poem":1},{"text":"eeqay qaaxonna mela mismaaren dhishees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Shin neno Isra7eele, ta aylliyaw,","poem":1},{"text":"ta doorida Yayqoobaa,","poem":2},{"lineBreak":true},{"text":"ta laggiya Abrahaame kochaw,","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"taani nena biitta gaxape ehas;","poem":2},{"lineBreak":true},{"text":"haahosoope xeegada, ‘Neeni ta aylle’","poem":2},{"lineBreak":true},{"text":"taani nena dooras; taani nena yeggike.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yayyofa, taani neera de7ayis;","poem":1},{"text":"dagammofa, taani ne Xoossaa.","poem":2},{"text":"Taani nena minthana; nena maaddana;","poem":1},{"text":"taani nena xooniya ta ushacha kushiyan katisana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne bolla hanqetiya ubbay yeellatidi kawuyana;","poem":1},{"text":"neera eqeteysati baynaba gidana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne morketa neeni koyana;","poem":1},{"text":"shin enta demmaka;","poem":2},{"lineBreak":true},{"text":"nena oleysati baynaba gidana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Taani Goday, ne Xoossay,","poem":1},{"text":"ne ushacha kushiya oykana;","poem":2},{"lineBreak":true},{"text":"yayyofa, taani nena maaddana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Neno guxuniyaw, Yayqooba, hinteno Isra7eele asaw,","poem":1},{"text":"yayyofite; taani hintena maaddana;","poem":2},{"lineBreak":true},{"text":"hintena woziya Isra7eele Geeshshay tana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Heko, taani nena oorathi,","poem":1},{"text":"qaranne achara de7iya,","poem":2},{"lineBreak":true},{"text":"kathi qoxiya miishe oothas.","poem":2},{"text":"Neeni dereta qoxada liiqisana;","poem":1},{"text":"zumataka puno oothana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Neeni enta punnana; carkoy enta efana;","poem":1},{"text":"shin neeni Godan ufaytana;","poem":2},{"lineBreak":true},{"text":"Isra7eele Geeshshan bonchetana.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Manqotinne metootanchoti haathe koyana,","poem":1},{"text":"shin demmokona; enta qoodhey saamon melana.","poem":2},{"text":"Gidoshin, taani Goday enta si7ana;","poem":1},{"text":"taani, Isra7eele Xoossay, enta aggike.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Taani mela zumata bolla shaafa,","poem":1},{"text":"zangaaratan pulto dhuusana.","poem":2},{"text":"Bazzuwa haathi eelliya bessi,","poem":1},{"text":"mela biitta pultoy keyaso oothana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Taani mela biittan, ziga, soqala mithi,","poem":1},{"text":"barseneete mithaanne shamaho dolisana.","poem":2},{"text":"Mela biitta xiiddi, maaroynne","poem":1},{"text":"caci kumida biitta oothana.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Isra7eele Geeshshay hessa medhidaysanne","poem":1},{"text":"Godaa kushey hessa oothidaysa","poem":2},{"lineBreak":true},{"text":"asay be7ana, erana, qopananne","poem":2},{"lineBreak":true},{"text":"akeekana mela taani hessa oothas.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“Ane hinte mootuwa shiishite” yaagees Goday;","poem":1},{"text":"“Ane hinte marka haa ehite” yaagees Yayqooba kawoy.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ane enti banta eeqata haa eho,","poem":1},{"text":"aybi hananeeko enta eeqati nuus odo.","poem":2},{"text":"Nuuni akeekana melanne enta wursethaa erana mela","poem":1},{"text":"kase hanidabay aybeko nuus odo;","poem":2},{"lineBreak":true},{"text":"woyko sinthafe hananaba nuus qonciso.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hinte xoossata gideysa nuuni erana mela","poem":1},{"text":"sinthafe yaanaw de7iyaba nuus odite.","poem":2},{"text":"Nuuni dagammana melanne yayyana mela,","poem":1},{"text":"lo77o gidin iita gidin ane issiba oothite.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Shin hinte baynaba mela;","poem":1},{"text":"hinte oosoyka hada;","poem":2},{"lineBreak":true},{"text":"hintena dooriya asayka ixetidaysata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Taani pudeha baggafe issuwa denthin,","poem":1},{"text":"I yees.","poem":2},{"text":"Ta sunthaa xeegiya issoy dolohape yaana;","poem":1},{"text":"oto medheysi urqa yedheysada,","poem":2},{"lineBreak":true},{"text":"I kaaletheyisata yedhana.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nuuni erana melanne I like gaana mela","poem":1},{"text":"kasetidi nuus haysa odiday oonee?","poem":2},{"text":"Hintefe oonika kasetidi haysa qoncisiday,","poem":1},{"text":"woyko awaajiday woyko ba qaala sissiday baawa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Taani haysa kasetada Xiyoones odas;","poem":1},{"text":"taani Yerusalaames mishiraacho odeysa immas.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Shin taani xeelliya wode issoyka baawa;","poem":1},{"text":"taani zore oychiya wode enta eeqata giddofe","poem":2},{"lineBreak":true},{"text":"zaaro immiya issoyka baawa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Heko, enti ubbay hada; enta oosoyka pathenna;","poem":1},{"text":"sheeshidi medhida enta misiletika carko.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":29}