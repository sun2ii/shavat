{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":42,"content":[{"type":"heading","content":["Xoossa Aylle"]},{"type":"verse","number":1,"content":[{"text":"“Taani katisada oykida ta aylley,","poem":1},{"text":"ta iyan ufayteysi,","poem":2},{"lineBreak":true},{"text":"taani dooridaysi haysa.","poem":2},{"text":"Taani ta Ayyaana iya bolla wothas;","poem":1},{"text":"I kawotethatas suure pirda ehana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"I waassenna;","poem":1},{"text":"ba qaala dhoqu oothenna","poem":2},{"lineBreak":true},{"text":"ba qaala ogen sissenna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dincetida mayriya I menthenna;","poem":1},{"text":"lii7i lii7idi eexiya muqaada I toysenna;","poem":2},{"lineBreak":true},{"text":"ammanetethan I suure pirda ehana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I biittan suure pirda essenna gakanaw","poem":1},{"text":"argaacena woyko guye geenna.","poem":2},{"text":"Yuushoy abban teqetida biittan de7iya asay","poem":1},{"text":"iya higgiya si7anaw naagees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Salota medhidaynne enta micciday,","poem":1},{"text":"sa7aanne sa7a bolla de7iyaba medhiday,","poem":2},{"lineBreak":true},{"text":"sa7an de7iya asaas shempo immiday,","poem":2},{"lineBreak":true},{"text":"iyan hemetiya ubbaas de7o immiday,","poem":2},{"text":"Godaa Xoossay haysada yaagees.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Taani Goday nena xillotethan xeegas;","poem":1},{"text":"ne kushiya oykada nena naagana.","poem":2},{"text":"Taani nena asaas caaqo oothana;","poem":1},{"text":"kawotethatas poo7o oothada immana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Neeni qooqe ayfeta dooyana;","poem":1},{"text":"dhuma ollan, qasho keethan de7eyisata kessana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Taani Godaa; hessi ta sunthaa;","poem":1},{"text":"ta bonchuwa taani haras immike;","poem":2},{"lineBreak":true},{"text":"ta galataa eeqatas immike.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Heko taani kase odidaba ubbay poletidosona;","poem":1},{"text":"ha77i taani oorathaba awaajayis;","poem":2},{"lineBreak":true},{"text":"enti hananaape sinthe taani hintew odayis” yaagees.","poem":2}]},{"type":"heading","content":["Xoossay Galateto"]},{"type":"verse","number":10,"content":[{"text":"Godaas ooratha mazmure yexite;","poem":1},{"text":"biitta gaxape gaxaa gakanaw iya galata yexite.","poem":2},{"text":"Abba giddora beysatinne iyan de7eysati,","poem":1},{"text":"yuushoy abban teqetida biittatinne iyan de7iya ubbay yexo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mela biittan de7iya katamati,","poem":1},{"text":"Qedaare asay de7iya gutati","poem":2},{"lineBreak":true},{"text":"banta qaala dhoqu oothonna.","poem":2},{"text":"Sela7a kataman de7eysati ufaysan yexo;","poem":1},{"text":"deriya huuphen banta ililsaa sisso.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Enti boncho Godaas immo;","poem":1},{"text":"iya galata yuushoy abban teqetida biittatan odo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Goday mino asada keyana;","poem":1},{"text":"ba qaala dhoqu oothidi ola awaajana.","poem":2},{"text":"Ba qaala dhoqu oothidi gereerana;","poem":1},{"text":"ba morketa xoonana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Daro wode si77i gada gam7as;","poem":1},{"text":"si77i gada danda7as.","poem":2},{"text":"Shin ha77i iqethi oykida maccasada ta waassana;","poem":1},{"text":"tooka shempananne peenuqana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Deretanne zumata laallana;","poem":1},{"text":"enta bolla dolidaba ubbaa melisana.","poem":2},{"text":"Shaafata yuushoy abban teqetida biitta kessana;","poem":1},{"text":"eele haathata melisana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Taani qooqeta enti eronna ogiyara kaalethana;","poem":1},{"text":"enti eronna horogara efana.","poem":2},{"text":"Enta sinthan dhumaa poo7o kessana;","poem":1},{"text":"enta sinthan de7iya ogiya baasana.","poem":2},{"text":"Ha ubbaa taani entaw oothana;","poem":1},{"text":"taani enta oothonna aggike.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“Shin eeqa misiletan ammaneteysati,","poem":1},{"text":"misileta, ‘Hinte nu xoossata’ yaageysati,","poem":2},{"lineBreak":true},{"text":"yeellan guye simmana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hinte tulleti, si7ite;","poem":1},{"text":"hinte qooqeti, xeellite,","poem":2},{"lineBreak":true},{"text":"loythidi be7ite.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ta aylliyafe hari qooqey oonee?","poem":1},{"text":"Ta kiittidaysafe hari tulley oonee?","poem":2},{"text":"Bana Godaas aathidi immida uraape","poem":1},{"text":"Godaa aylliyafe hari qooqey oonee?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Darobaa be7adasa, shin akeekaka;","poem":1},{"text":"ne haythay dooya, shin si7aka” yaagees.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Goday ba xillotetha gisho,","poem":1},{"text":"ba higgiya gitayanawunne bonchanaw dosis.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Shin ha asay bonqetis;","poem":1},{"text":"de7iyaba eketis.","poem":2},{"text":"Olla giddon xihen oyketis,","poem":1},{"text":"qasho keethan enta bolla gordetis.","poem":2},{"text":"Enti bonqetidosona, shin enta ashshey baawa;","poem":1},{"text":"di7etidosona, shin oonika “Enta guye zaara”","poem":2},"giya asi baawa."]},{"type":"verse","number":23,"content":[{"text":"Hinte giddofe haysa si7ey oonee?","poem":1},{"text":"sinthafe yaana wodiyaba qopey oonee?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yayqooba di7etethas,","poem":1},{"text":"Isra7eele bonqees aathidi immiday oonee?","poem":2},{"text":"Nagara oothidi nu qohida,","poem":1},{"text":"iya ogiya kaallanawunne, iya higgiya kiitetanaw","poem":2},{"lineBreak":true},{"text":"nuuni ixida Godaa gidenneyee?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Hessa gisho, I enta bolla ba eexiya hanquwa gussis;","poem":1},{"text":"enta yuushuwa tama lacon teqis,","poem":2},{"lineBreak":true},{"text":"shin enti eribookona;","poem":2},{"text":"I enta xuuggis,","poem":1},{"text":"shin enti akeekibokona.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/41.json","previousChapterAudioLinks":{},"numberOfVerses":25}