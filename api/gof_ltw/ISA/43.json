{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":43,"content":[{"type":"heading","content":["Isra7eele Ashshiya Issuwa"]},{"type":"verse","number":1,"content":[{"text":"Shin neno Yayqoobaa nena medhiday,","poem":1},{"text":"neno Isra7eele, nena giigisiday,","poem":2},{"text":"Goday haysada yaagees:","poem":1},{"lineBreak":true},{"text":"“Taani nena wozida gisho yayyofa;","poem":1},{"text":"taani nena ne sunthan xeegas; neeni tabaa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Neeni haatha giddora pinniya wode","poem":1},{"text":"taani neera gidana.","poem":2},{"text":"Neeni shaafata giddora pinniya wode","poem":1},{"text":"enti nena mittokona.","poem":2},{"text":"Neeni tama giddora aadhiya wode","poem":1},{"text":"xuugetaka; lacoyka nena meenna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taani nena Ashshiysa, Isra7eele Geeshshaa,","poem":1},{"text":"Godaa ne Xoossaa.","poem":2},{"text":"Gibxe new wozo oothada,","poem":1},{"text":"Tophenne Saaba","poem":2},{"lineBreak":true},{"text":"new laame oothada immana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Neeni ta sinthan al7onne boncho gidiya gisho,","poem":1},{"text":"taani nena dosiya gisho,","poem":2},{"lineBreak":true},{"text":"asaa ne gisho, kawotethata ne shempuwa gisho","poem":2},{"lineBreak":true},{"text":"laame oothada immana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Taani neera de7iya gisho yayyofa;","poem":1},{"text":"taani ne nayta dolohape","poem":2},{"lineBreak":true},{"text":"nena wulohape shiishana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taani pudeha baggaa, ‘Enta zaarada eha!’","poem":1},{"text":"dugeha baggaa, ‘Enta teqofa’ yaagana.","poem":2},{"text":"Ta adde nayta haahosoope,","poem":1},{"text":"ta macca nayta sa7aa gaxape ehana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Enti ta sunthan xeegetidaysata,","poem":1},{"text":"taani ta bonchuwas medhidaysata,","poem":2},{"lineBreak":true},{"text":"taani giigisidaysatanne oothidaysata hammite.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ayfey de7ishin qooqida asata,","poem":1},{"text":"haythi de7ishin tullida asata kessa.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kawotethati ubbay issife shiiqo;","poem":2},{"lineBreak":true},{"text":"asay duulata utto.","poem":2},{"text":"Enta eeqata giddofe haysa odanaw,","poem":1},{"text":"kase aadhidabata nuus qoncisanaw","poem":2},{"lineBreak":true},{"text":"danda7ey oonee?","poem":2},{"text":"Hara asay si7idi, “Haysi tuma” gaana mela,","poem":1},{"text":"enti like gideysa bessanaw banta markata eho.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Goday haysada yaagees: “Hinte ta markata;","poem":1},{"text":"hinte tana erana melanne ammanana mela","poem":2},{"lineBreak":true},{"text":"taani Xoosse gideysa akeekana mela","poem":2},{"lineBreak":true},{"text":"taani doorida ta aylleti hintena.","poem":2},{"text":"Taape kase hara xoossi medhetibeenna;","poem":1},{"text":"taape guye hara xoossi deenna.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Taani Godaa;","poem":1},{"text":"taape attishin, hari ashshey baawa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ta kasetada odas,","poem":1},{"text":"ta oothanaba awaajas, ta ashshas.","poem":2},{"text":"Hinte giddon de7iya allaga xoossatape","poem":1},{"text":"hessa oothiday baawa.","poem":2},{"text":"Taani Xoosse gideysas hinte taw markata.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Merinaape merinaw taani Xoosse;","poem":1},{"text":"ta kushepe oonika ashshena;","poem":2},{"lineBreak":true},{"text":"ta oothidaba laammanaw danda7ey baawa”","poem":2},"yaagees Goday."]},{"type":"heading","content":["Xoossa maarotanne Ammanetona Isra7eele"]},{"type":"verse","number":14,"content":[{"text":"Goday, hintena Woziya,","poem":1},{"text":"Isra7eele Geeshshay, haysada yaagees:","poem":2},{"text":"“Hinte gisho, taani Babiloone bolla","poem":1},{"text":"olanchota kiittana.","poem":2},{"text":"Babilooneta ubbaa enti ceeqetiya","poem":1},{"text":"markabetara betana mela oothana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Taani Godaa, hinte Geeshshaa,","poem":1},{"text":"Isra7eele medhida hinte Kawa” yaagees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Abba giddon oge,","poem":1},{"text":"wolqaama haathata giddora horoga","poem":2},{"lineBreak":true},{"text":"kessida Goday haysada yaagees.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Para gaaretanne parata,","poem":1},{"text":"olanchotanne mino asata abban ehidi,","poem":2},{"lineBreak":true},{"text":"enti dendonna mela yeggiday,","poem":2},{"lineBreak":true},{"text":"enta muqaada tamada toysida.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Goday haysada yaagees:","poem":1},{"text":"“Kasebata haasayopite;","poem":2},{"lineBreak":true},{"text":"benibata qopofite.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Heko, ha77i taani oorathaba oothayis;","poem":1},{"text":"ika ha77i dolana.","poem":2},{"text":"Hessi hintew bentennee?","poem":1},{"text":"Taani mela biittan oge,","poem":2},{"lineBreak":true},{"text":"mela biittan shaafata kessana.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Taani doorida, ta asaas mela biittan haathe,","poem":1},{"text":"mela biittan haatha shaafata immas.","poem":2},{"text":"Wora do7ati, workanatinne yanchoti","poem":1},{"text":"tana bonchana.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Taani taw medhida dere gidiya gisho,","poem":1},{"text":"ta galataa awaajana mala ta haysa oothas.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Shin neno Yayqoobaa,","poem":1},{"text":"neeni ta sunthaa xeegabaka;","poem":2},{"lineBreak":true},{"text":"neno Isra7eele, neeni tana saletadasa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Neeni taw xuussa yarshos dorse ehabaaka;","poem":1},{"text":"hara yarshonka tana bonchabaaka.","poem":2},{"text":"Taani nena katha yarsho eha gada waaysabike;","poem":1},{"text":"ixaane taw cuyiso gada daabursabike.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Neeni taw sawiya ixaane shammabaaka;","poem":1},{"text":"ne modho yarshon tana ufaysabaka.","poem":2},{"text":"Shin neeni ne nagaran tana waaysadasa;","poem":1},{"text":"ne naaquwan tana daabursadasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Ta gisho gada ne nagaraa quchey tana;","poem":1},{"text":"ne nagaraa zaarada qopike.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ane tana hassayisa;","poem":1},{"text":"neeni xillo gideysa erisanaw","poem":2},{"lineBreak":true},{"text":"issife shiiqidi mootetoos.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ne koyro aaway nagara oothis;","poem":1},{"text":"ne astamaareti tana qohidosona.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Hessa gisho, taani ta keetha halaqata kawushas;","poem":1},{"text":"Yayqooba gados, Isra7eele cashshas","poem":2},{"lineBreak":true},{"text":"aathada immas.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/42.json","previousChapterAudioLinks":{},"numberOfVerses":28}