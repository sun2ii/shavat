{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":44,"content":[{"type":"heading","content":["Dooretida Isra7eele"]},{"type":"verse","number":1,"content":[{"text":"Shin ta aylliya Yayqooba, ta doorida Isra7eele,","poem":1},{"text":"ha77ika si7a.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nena medhida, ne aaye ulon nena giigisida","poem":1},{"text":"Goday haysada yaagees.","poem":2},{"text":"Ta aylliya Yayqooba,","poem":1},{"text":"taani doorida Yishuruuna, yayyofa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taani saamotida biittan haatha gussana;","poem":1},{"text":"mela biitta bolla shaafa gogisana.","poem":2},{"text":"Ta Ayyaana ne nayta bolla,","poem":1},{"text":"ta anjuwa ne kochaa bolla gussana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Enti haatha doonan dolida maatada,","poem":1},{"text":"shaafa lanqen de7iya mithada aacana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Issoy bana, taani Godaaba yaagana;","poem":1},{"text":"hankoy bana Yayqooba sunthan xeegana;","poem":2},{"lineBreak":true},{"text":"haray ba kushiya bolla, “Taani Godaaba” yaagidi caddana;","poem":2},{"lineBreak":true},{"text":"I Isra7eele iya sunthan xeegetana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Goday, Isra7eele Kawoynne iya Woziday,","poem":1},{"text":"Ubbaafe Wolqaama Goday haysada yaagees:","poem":2},{"text":"“Koyroy tana; wursethay tana;","poem":1},{"text":"taape hara Xoossi baawa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta meli oonee? De7iko ane awaajo;","poem":1},{"text":"ane ta sinthan eqidi odo.","poem":2},{"text":"Benipe doomidi, hanidaba odo;","poem":1},{"text":"sinthafe hananaba qonciso.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yayyofite; dagammopite;","poem":1},{"text":"taani haysa benipe doomada odabikina?","poem":2},{"text":"Kasetada erisabikina?","poem":1},{"text":"Hessas hinte taw marka.","poem":2},{"text":"Taape attishin, hara Xoossi de7ii?","poem":1},{"text":"Hara Zaalli baawa;","poem":2},{"lineBreak":true},{"text":"oonika baynaysa ta erayis” yaagees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Eeqa misileta medhiya ubbay hada;","poem":1},{"text":"iyan ufaytiyabati enta go7okona.","poem":2},{"text":"Enta markati qooqeta entaw eri baawa;","poem":1},{"text":"enti yeellatana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bana go77onna eeqa","poem":1},{"text":"Xoossa oothidi giigisiday oonee?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Eeqa medhey asepe attishin, hara gidenna;","poem":1},{"text":"inne iya laggeti yeellatana;","poem":2},{"lineBreak":true},{"text":"ubbati issife shiiqidi eqo, yayyo, yeellato.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Birata qoxeysi eeqa oothanaw","poem":1},{"text":"ba birata taman seerisidi mala immanaw","poem":2},{"lineBreak":true},{"text":"ba mino kushiyan naariqan qoxees.","poem":2},{"text":"Hessa giigisishe koshatees;","poem":1},{"text":"iya wolqay wurees;","poem":2},{"lineBreak":true},{"text":"saamotesinne labbanees.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Anaaxey wodoron likidi","poem":1},{"text":"irsaasen iya bolla malla wothees;","poem":2},{"lineBreak":true},{"text":"liiqisiya miishen liiqisees.","poem":2},{"text":"Lo77o asa malan medhidi","poem":1},{"text":"ba eeqa keethan wothees.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"I hessa oothanaw ziga qanxees;","poem":1},{"text":"wola woyko xiidda wora giddofe dooridi","poem":2},{"lineBreak":true},{"text":"diccana mela oothees.","poem":2},{"text":"Woyko ziga tokidi","poem":1},{"text":"iran diccana mela naagees.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Iyape baggaa eethanaw go7etees;","poem":1},{"text":"iyape baggaa ekidi, eethidi kayees;","poem":2},{"lineBreak":true},{"text":"baggaa eethidi kathi kathees.","poem":2},{"text":"Attidaysa ekidi xoosse oothidi iyaw goyinnees;","poem":1},{"text":"eeqa medhidi iya sinthan gufannees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Iyape baggaa eethidi kathi kathees;","poem":1},{"text":"baggan asho caacidi kallidi mees.","poem":2},{"text":"Qassi tama kayishe, “Eroshsho, tama goopa;","poem":1},{"text":"waani ho77i” yaagees.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Qassi attida mithaa massidi,","poem":1},{"text":"goyinniya xoossa misile kessees.","poem":2},{"text":"He misiliya sinthan gufannidi, iyaw goyinnees;","poem":1},{"text":"“Neeni taw xoosse gidiya gisho,","poem":2},{"lineBreak":true},{"text":"tana ashsha” yaagidi woossees.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Enti aykoka erokona; aykoka akeekokona;","poem":1},{"text":"enti be7onna mela enta ayfey goozetis;","poem":2},{"lineBreak":true},{"text":"akeekona mela enta wozanay gordetis.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Eeqa oothiya asaa giddofe ba wozanan,","poem":1},{"text":"“Iyape baggaa taman eethas;","poem":2},{"lineBreak":true},{"text":"iya bonquwan kathi kathas;","poem":2},{"lineBreak":true},{"text":"iyan asho caacada mas.","poem":2},{"text":"Iyape attidaysa ixetida eeqa oothada medho?","poem":1},{"text":"attida cugetha mithas gufannada goyinno?”","poem":2},{"lineBreak":true},{"text":"yaagidi qopiya woyko akeekiya asi baawa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"I bido mees; iya cimetida wozanay","poem":1},{"text":"iya hara soo kaalethis.","poem":2},{"text":"I ba shempuwa ashshanaw danda7enna;","poem":1},{"text":"“Haysi ta ushacha kushen de7ey wordo gidenna”","poem":2},{"lineBreak":true},{"text":"gaanaw danda7enna.","poem":2}]},{"type":"verse","number":21,"content":["Goday haysada yaagees:",{"text":"“Yayqoobaa, haysa akeeka;","poem":1},{"text":"Isra7eele, neeni ta aylle gidiya gisho haysa hassaya.","poem":2},{"text":"Taani nena medhas; neeni ta aylle;","poem":1},{"text":"neno Isra7eele, taani nena dogike.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Taani ne nagaraa pittada diggas,","poem":1},{"text":"ne naaquwa caaganada quchas.","poem":2},{"text":"Taani nena wozida gisho,","poem":1},{"text":"taako simma” yaagees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“Hinteno saloto, Goday haysa oothida gisho,","poem":1},{"text":"ufaysan yexite; neno biittaw, ilila.","poem":2},{"text":"Hinteno dereto, worawnne","poem":1},{"text":"iya giddon de7iya mitha ubbay mazmure yexite.","poem":2},{"text":"Goday Yayqooba wozis;","poem":1},{"text":"Isra7eele giddon bonchetis.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ne aaye ulon nena medhidaysi,","poem":1},{"text":"nena wozidaysi Goday haysada yaagees:","poem":2},{"text":"Ubbabaa Medhiday, salota tarka micciday;","poem":1},{"text":"sa7aaka tarka hiixiday, taani Godaa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Taani wordo nabeta tinbitiya hada oothas;","poem":1},{"text":"marota kaayowa eeyatethi kessas.","poem":2},{"text":"Taani cincata cincatethaa shira yeggas;","poem":1},{"text":"enta eraa eeya oothas.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Taani ta aylleta qaala minthana;","poem":1},{"text":"ta nabeta tinbitiya polana.","poem":2},{"text":"Taani Yerusalaame katamaa,","poem":1},{"text":"‘Neeni asay de7iya bessi gidana’ yaagas;","poem":2},{"text":"Yihuda katamata,","poem":1},{"text":"‘Hinte simmidi keexetana; hinte gimbey ooraxana’ yaagas.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Taani goggiya haathata melisana gisho","poem":1},{"text":"ciimmo haatha, ‘Ne mela’ yaagana.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Qiroosako, ‘Neeni ta asaa heemmeysa;","poem":1},{"text":"neeni ta halchuwa poleysa’ yaagana.","poem":2},{"text":"I, Yerusalaame katamaa, ‘Neeni simmada keexetana’;","poem":1},{"text":"xoossa keethaa, ‘Ne baasoy yegetana’ ” yaagana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/43.json","previousChapterAudioLinks":{},"numberOfVerses":28}