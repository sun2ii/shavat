{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":45,"content":[{"type":"heading","content":["Qiroosa Dooretetha"]},{"type":"verse","number":1,"content":[{"text":"Goday tiyidaysas,","poem":1},{"text":"kawota danco bilisaana mela,","poem":2},{"lineBreak":true},{"text":"deriya iyaw haarisana mela,","poem":2},{"lineBreak":true},{"text":"pengeti iya sinthan dooyetana mela","poem":2},{"lineBreak":true},{"text":"iya ushacha kushiya oykida Qiroosa","poem":2},{"lineBreak":true},{"text":"Goday haysada yaagees:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taani ne sinthara baana; dereta dembayana;","poem":1},{"text":"naase birata sanqata menthana;","poem":2},{"lineBreak":true},{"text":"birata kobeta qanxana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nena ne sunthan xeegey tana Godaa,","poem":1},{"text":"Isra7eele Xoossaa gideysa neeni erana mela","poem":2},{"lineBreak":true},{"text":"taani new dhuman de7iya shaluwa,","poem":2},{"lineBreak":true},{"text":"geeman qosetida duretetha immana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ta aylliya Yayqooba gisho,","poem":1},{"text":"taani doorida Isra7eele gisho,","poem":2},{"lineBreak":true},{"text":"taani nena ne sunthan xeegas.","poem":2},{"text":"Neeni tana eronna ixikoka,","poem":1},{"text":"taani nena boncho sunthan xeegas.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Taani Godaa; taape hara xoosse baawa;","poem":1},{"text":"neeni tana eronna ixikoka","poem":2},{"lineBreak":true},{"text":"taani new wolqa immana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hessika awi doliyasope wulliyaso gakanaw","poem":1},{"text":"taape hari baynaysa asay erana melasa;","poem":2},{"lineBreak":true},{"text":"taani Godaa; taape hara xoossi baawa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Taani poo7onne dhuma medhas;","poem":1},{"text":"Sarotethinne dhayo ehayis;","poem":2},{"lineBreak":true},{"text":"ha ubba taani Goday oothayis.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hinteno saloto, bollafe xillotethi tigite;","poem":1},{"text":"shaarati bukiso.","poem":2},{"text":"Biittay dooyeto, atotethi xillotethay issife dolo;","poem":1},{"text":"taani Goday haysa medhas.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bana Medhidaysara palamiya uraa ayye!","poem":1},{"text":"I sa7an meqidi wodhida","poem":2},{"lineBreak":true},{"text":"otope issuwa mela.","poem":2},{"text":"Otoy bana medheysako,","poem":1},{"text":"Neeni, “Ay oothay?”","poem":2},{"lineBreak":true},{"text":"“New kushey baawa” yaagiyee?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ba aawa, “Tana ayis yeladii?” giya,","poem":1},{"text":"ba aayiw, “Tana haysada ayis bannakadii?”","poem":2},{"lineBreak":true},{"text":"giya uraa ayye!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Goday, Isra7eele Geeshshay,","poem":1},{"text":"iya Medhidaysi haysada yaagees:","poem":2},{"text":"“Sinthafe hananaba,","poem":1},{"text":"hinte tana ta naytabaa oychanaw,","poem":2},{"lineBreak":true},{"text":"ta kushe oosotaba tana kiittanaw bessetii?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Taani sa7aa oothas;","poem":1},{"text":"aseka iya bolla medhas.","poem":2},{"text":"Salota taani ta kushen miccas;","poem":1},{"text":"enta bolla xoolintota ubbaa wothas.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Taani Qiroosa xillotethan denthas;","poem":1},{"text":"iya ogiya ubbaa suure oothana.","poem":2},{"text":"Miishe qanxonna woyko woyto immonna","poem":1},{"text":"I ta katamaa keexana; ta asaa di7ope zaarana”","poem":2},"yaagees ubbaafe Wolqaama Goday."]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Goday haysada yaagees:","poem":1},{"text":"Gibxe duretethaynne Tophe zal7ey,","poem":2},{"lineBreak":true},{"text":"geesay adussa gidida Saaba asati","poem":2},{"lineBreak":true},{"text":"neeko yidi, nebaa gidana;","poem":2},{"lineBreak":true},{"text":"enti santhalaatan qashetidi, nena kaallana.","poem":2},{"text":"Enti new goyinnishe, ‘Xoossi neera de7ees;","poem":1},{"text":"iyape attishin, hara xoossi baawa’ ” yaagana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Isra7eele Ashshiya Godaa Xoossaw,","poem":1},{"text":"tuma neeni nena genthiya Xoosse.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Eeqa medheysati ubbay yeellatananne kawuyana;","poem":1},{"text":"enti issife yeella ma7ana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Shin Goday Isra7eele merinaa atotethan ashshana;","poem":1},{"text":"hinte merinaw yeellateketa kawuyeketa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Salota medhida Goday, biitta giigisidi oothiday,","poem":1},{"text":"asi daana melape attishin, biitta coo medhiboonna","poem":2},{"text":"Xoossay haysada yaagees:","poem":1},{"text":"taani Godaa; taape hari baawa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Taani geeman,","poem":1},{"text":"woyko dhuma biittan uttada odabike.","poem":2},{"text":"Yayqooba zerethaako, ‘Tana coo bessan koyite’ gabike;","poem":1},{"text":"taani Goday tumaa haasayis; like gididaba qoncisayis.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hinteno kawotethata giddofe attidaysato,","poem":1},{"text":"issife haa mata shiiqite.","poem":2},{"text":"Mithafe oosetida eeqa misiliya tooki yuuyeysatas,","poem":1},{"text":"ashshanaw danda7onna xoossata woosseysatas eri baawa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ane palamit; hinte mootuwas gaaso shiishite;","poem":1},{"text":"issife zoretite.","poem":2},{"text":"Daro wodepe kase haysa odiday oonee?","poem":1},{"text":"Benipe haysa awaajiday oonee?","poem":2},{"text":"Tana Godaa gidikinaayee?","poem":1},{"text":"Taape attishin, hara Xoossi baawa.","poem":2},{"lineBreak":true},{"text":"Taape attishin, hari xilloynne ashshiya Xoossi baawa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hinteno biitta gaxape gaxa gakanaw de7eysato,","poem":1},{"text":"taako simmidi attite; taape attishin, hara Xoossi baawa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Taani tanan caaqas;","poem":1},{"text":"guye simmonna qaali","poem":2},{"lineBreak":true},{"text":"ta doonape xillotethan keyis.","poem":2},{"text":"Gulbati ubbay taw gulbatana;","poem":1},{"text":"inxarsi ubbay tanan caaqana.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Enti tabaa haasayishe,","poem":1},{"text":"‘Xillotethinne minotethi","poem":2},{"lineBreak":true},{"text":"Godaa xalaalan de7ees’ yaagana.","poem":2},{"text":"Iya ixiya ubbay iyako yidi yeellatana.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Shin Isra7eele zeretha ubbay,","poem":1},{"text":"Godan, xoononne boncho demmana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}