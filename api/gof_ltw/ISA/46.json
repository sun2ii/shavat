{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":46,"content":[{"type":"heading","content":["Babiloone Xoossata"]},{"type":"verse","number":1,"content":[{"text":"Beella geetetiya Babiloone eeqay hokis;","poem":1},{"text":"Nebo geetetiya eeqay gufannis.","poem":2},{"text":"Enta misileti caana mehe bolla caanetidosona;","poem":1},{"text":"daaburida mehetas deexo tooho gididosona.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Deexuwape dendidaysan caana meheti,","poem":1},{"text":"caanara issife kundidosona.","poem":2},{"text":"Eeqati bantana ashshanaw danda7onna gisho","poem":1},{"text":"bantaw di7etidi bidosona.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hinteno, Isra7eelepe attidaysato, Yayqooba kochato,","poem":1},{"text":"hinte qanthatida wodepe doomada naagiday,","poem":2},{"lineBreak":true},{"text":"hinte yeletida wodepe doomada tookiday,","poem":2},{"lineBreak":true},{"text":"taani odeysa si7ite.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hinte cimana gakanaw,","poem":1},{"text":"puulumana gakanaw taani tana;","poem":2},{"lineBreak":true},{"text":"ta hintena maaddana.","poem":2},{"text":"Taani hintena medhas; ta hintena naagana;","poem":1},{"text":"ta hintena tookananne ashshana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tana oodera gaaddeyeetii?","poem":1},{"text":"woyko oodera likiseetii?","poem":2},{"text":"Enti woli daanees gaanaw","poem":1},{"text":"tana oodera ginayetii?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Asay worqanne bira banta qarxiitape qolidi,","poem":1},{"text":"xoosse oothidi medhana mela worqa sheesheysas immoosona.","poem":2},{"text":"I oothidi simmin","poem":1},{"text":"enti eeqa sinthan gufannidi goyinnoosona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Enti iya denthidi, banta hashiyan tookidi,","poem":1},{"text":"iya bessan iya wothin, I he bessan eqi aggees.","poem":2},{"text":"Ba de7iya bessaafe qaaxenna;","poem":1},{"text":"asi iyako waassiko iyaw zaaro immenna;","poem":2},{"lineBreak":true},{"text":"iya metuwape iya ashshena.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hinteno nagaranchoto,","poem":1},{"text":"haysa hassayite; qopite;","poem":2},{"lineBreak":true},{"text":"hinte wozanan wothite.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Beni wode hanidabata hassayite;","poem":1},{"text":"taape attishin, hara Xoossi baawa; taani Xoosse;","poem":2},{"lineBreak":true},{"text":"ta meli oonika baawa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta qofay minnana;","poem":1},{"text":"taani ta halchuwa ubbaa polana.","poem":2},{"text":"Wursethan hananaba doomethan,","poem":1},{"text":"sinthafe hananaba koyrottada erisayis.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Doloha baggafe bonqiya kafo,","poem":1},{"text":"haaho biittafe ta qofaa poliya asi xeegana.","poem":2},{"lineBreak":true},{"text":"Taani qopidaba polana;","poem":2},{"lineBreak":true},{"text":"taani halchidaba oothana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hinteno wozani muumidaysato,","poem":1},{"text":"xillotethafe haakidaysato tana si7ite.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Taani ta xillotethaa matayana;","poem":1},{"text":"ika haahona gidenna.","poem":2},{"text":"Ta atotethay gam7enna; ta atotetha Xiyoones,","poem":1},{"text":"ta bonchuwa Isra7eeles immana” yaagees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/45.json","previousChapterAudioLinks":{},"numberOfVerses":13}