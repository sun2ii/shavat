{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":48,"content":[{"type":"heading","content":["Simmonna Ixida Isra7eele"]},{"type":"verse","number":1,"content":[{"text":"“Hinteno, Yayqooba soo asaw,","poem":1},{"text":"Isra7eele sunthan xeegetidaysato,","poem":2},{"lineBreak":true},{"text":"Yihuda kochaafe yidaysato, haysa si7ite.","poem":2},{"text":"Hinte Godaa sunthan caaqeta;","poem":1},{"text":"Isra7eele Xoossaa xeegeta;","poem":2},{"lineBreak":true},{"text":"shin tumatethaninne xillotethan gidenna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hinte, ‘Nuuni geeshsha kataman de7oos;","poem":1},{"text":"Isra7eele Xoossan zempoos;","poem":2},{"lineBreak":true},{"text":"iya sunthay Ubbaafe Wolqaama Godaa’ ”","poem":2},"yaagidi ceeqeteta."]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Taani sinthafe hananabata daro wodepe kase odas.","poem":1},{"text":"ta doonape enti keyin,","poem":2},{"lineBreak":true},{"text":"enti eeson poletana mela oothas.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Neeni odin si7onnaysa,","poem":1},{"text":"ne morgey birata mela gideysa","poem":2},{"lineBreak":true},{"text":"ne som7oy naase biratada","poem":2},{"lineBreak":true},{"text":"leeqamonaysa taani erayis.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hessa gisho, neeni, “Haysa ta eeqay oothis;","poem":1},{"text":"ta masetida misileti, ta sheeshada oothida misileti oothidosona” goonnaada,","poem":2},{"text":"Taani hessa new benipe doomada odas.","poem":1},{"text":"Enti hananaape sinthe taani enta new erisas.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Ta kase odidaysa ne si7adasa;","poem":1},{"text":"I poletidaysa be7adasa,","poem":2},{"lineBreak":true},{"text":"yaatin iya tumatethaa ekikii?","poem":2},{"lineBreak":true},{"text":"Hizape ne eronna oorathabata ta new odana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Enti beni medhetidaba gidonashin","poem":1},{"text":"ha77i medhetidosona.","poem":2},{"text":"Neeni, ‘Taani enta erayis’ goonnaada","poem":1},{"text":"haysafe kase neeni entaba si7abaka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Neeni si7abaka; erabaaka;","poem":1},{"text":"ne haythay benipeka dooyetibeenna.","poem":2},{"text":"Neeni ay cimmiya aseeko taani erayis;","poem":1},{"text":"neeni yeletoosape geella geetetada xeegeteysa erayis.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ta sunthaa gisho, taani ta hanquwa zaarana;","poem":1},{"text":"ta bonchuwa gisho nena dhaysona mela","poem":2},{"lineBreak":true},{"text":"ta hanquwa teqana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Taani nena paacas;","poem":1},{"text":"birada gidonashin","poem":2},{"lineBreak":true},{"text":"taani nena meto taman paacas.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Taani ta gisho, haysa oothana;","poem":1},{"text":"ta sunthay tooshetana mela koyke;","poem":2},{"lineBreak":true},{"text":"taani ta bonchuwa haras immike.”","poem":2}]},{"type":"heading","content":["Babiloonepe Kessi"]},{"type":"verse","number":12,"content":[{"text":"“Neno Yayqooba, taani xeegida Isra7eele,","poem":1},{"text":"taani odiyaba si7a;","poem":2},{"lineBreak":true},{"text":"taani iya; koyroyka tana; wursethayka tana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ta kushey biitta baasuwa medhis;","poem":1},{"text":"ta ushacha kushey salota miccis.","poem":2},{"text":"Taani enta xeegiya wode","poem":1},{"text":"enti issife eqoosona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Hinte ubbay issife shiiqidi si7ite;","poem":1},{"text":"eeqatape haysi hananaysa sinthatidi odiday oonee?","poem":2},{"text":"Goday dooridaysi iya qofaa Babiloone bolla polana;","poem":1},{"text":"iya qeseyka Babiloone biitta bolla gidana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Taani, ta huuphen iyaw odas; iya xeegas;","poem":1},{"text":"ta iya ehana; I oothiyaba ubbay iyaw poletana.","poem":2}]},{"type":"verse","number":16,"content":["“Taako haa shiiqidi haysa si7ite;",{"text":"“Taani koyrope doomada geeman odabike;","poem":1},{"text":"hessi hanida wodepe doomada taani yan de7ayis” yaagees.","poem":2},{"text":"Ha77ika Ubbaa Haariya Godaynne","poem":1},{"text":"iya Ayyaanay tana kiittidosona.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nena woziya Goday,","poem":1},{"text":"Isra7eele Geeshshay haysada yaagees:","poem":2},{"text":"“Nena maaddiyaba tamaarsey","poem":1},{"text":"ne baanaw bessiya ogiya ne kaalethey,","poem":2},{"lineBreak":true},{"text":"tana ne Godaa, ne Xoossaa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Neeni ta kiitaa si7idaba gidiyako,","poem":1},{"text":"ne sarotethay shaafa haathada gogganashin;","poem":2},{"lineBreak":true},{"text":"ne xillotethay abba beetada hananashin.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ne kochay abba shafeda,","poem":1},{"text":"ne nayti taybetonna baana mela daranashin;","poem":2},{"lineBreak":true},{"text":"enta sunthay ta sinthafe dhayenna; kichennashin” yaagees.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Babiloone biittafe keyite;","poem":1},{"text":"Babiloonepe baqatite!","poem":2},{"text":"Qaala dhoqu oothidi,","poem":1},{"text":"ufaysan haysada yaagidi waassite.","poem":2},{"text":"Sa7aa gaxape gaxa gakanaw haysa kiittite;","poem":1},{"text":"“Goday ba aylliya Yayqooba wozis” yaagidi odite.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"I enta mela biittara kaalethida wode","poem":1},{"text":"saamotibookona.","poem":2},{"text":"Zaallafe haathi entaw pultis;","poem":1},{"text":"I zaalla phalqin haathi dhuuqis.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“Iitatas saroy baawa” yaagees Goday.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/47.json","previousChapterAudioLinks":{},"numberOfVerses":22}