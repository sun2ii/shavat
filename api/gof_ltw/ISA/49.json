{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":49,"content":[{"type":"heading","content":["Godaa Aylle"]},{"type":"verse","number":1,"content":["Hinteno, yuushoy abban teqetida biittato,",{"text":"taani odeysa si7ite.","poem":2},{"text":"Hinteno, haahoson de7iya kawotethato akeekite;","poem":1},{"text":"taani yeletanaape kase Goday tana xeegis;","poem":2},{"lineBreak":true},{"text":"ta aaye ulon de7ishin, ta suntha sunthis.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta inxarsaa qara mashshi oothis;","poem":1},{"text":"ba kushiya kuyan tana genthis.","poem":2},{"text":"I tana poshetida donge yiishshi oothidi","poem":1},{"text":"ba shoohuwan tana qottis.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"I taako, “Isra7eele, neeni ta aylle;","poem":1},{"text":"taani ta bonchuwa nenan qoncisana” yaagis.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Shin taani, “Taani coo daaburas;","poem":1},{"text":"ta wolqaa go77i baynabaninne hadaban wursas.","poem":2},{"text":"Gidoshin, ta pirday Godaa matana;","poem":1},{"text":"ta gatey ta Xoossaa matana” yaagas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":["Taani Godaa ayfe sinthan bonchetida gisho,",{"text":"ta Xoossay taw wolqa gidida gisho,","poem":2},{"text":"Yayqooba iyako zaaranaw","poem":1},{"text":"Isra7eele iyako shiishanaw,","poem":2},{"lineBreak":true},{"text":"taani iya aylle gidana mela","poem":2},{"lineBreak":true},{"text":"tana ta aaye ulon doorida","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Goday taako haysada yaagees;","poem":1},{"text":"Neeni Yayqooba kochaa denthanaw","poem":2},{"lineBreak":true},{"text":"Isra7eelepe attida guuthata zaarada ehanaw","poem":2},{"lineBreak":true},{"text":"neeni taw aylle gideysi daro guuthaba.","poem":2},{"text":"Hessafe aathada, ta atotethay biitta gaxa gakana mela","poem":1},{"text":"taani nena kawotethatas poo7o oothana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kadhetidaysasinne ixetidaysas","poem":1},{"text":"qassi kawotethata haariya aylliyas,","poem":2},{"text":"Isra7eele woziya Goday,","poem":1},{"text":"Isra7eele Geeshshay haysada yaagees;","poem":2},{"text":"Ammanthiya Godaa gisho,","poem":1},{"text":"nena doorida Isra7eele Geeshsha gisho","poem":2},{"lineBreak":true},{"text":"kawoti be7idi dendi eqana;","poem":2},{"lineBreak":true},{"text":"deriya haareysati be7idi goyinnana.","poem":2}]},{"type":"heading","content":["Yerusalaamey Ooraxana"]},{"type":"verse","number":8,"content":["Goday yaagees;",{"text":"“Taani doorida woden ne oysha zaarana;","poem":1},{"text":"atotetha gallas taani nena maadana.","poem":2},{"text":"Taani nena naagana;","poem":1},{"text":"neeni biitta zaarada essana mela;","poem":2},{"lineBreak":true},{"text":"asi doonna biitta neeni laatisana mela","poem":2},{"lineBreak":true},{"text":"taani nena asaas caaqo oothada immas.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Di7etidaysata, ‘Keyite!’","poem":1},{"text":"dhuma qashon de7eyisata, ‘Birshetite!’","poem":2},{"lineBreak":true},{"text":"gaana mela taani nena oothana.","poem":2},{"text":"Enti oge matan heemetana;","poem":1},{"text":"mela dere bolla heemetiya bessi demmana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Enti koshatokona woyko saamotokona;","poem":1},{"text":"enta mela biitta mishay xuuggenna;","poem":2},{"lineBreak":true},{"text":"away enta meenna.","poem":2},{"text":"Entaw qadheteysi enta kaalethana;","poem":1},{"text":"pulto haathaako enta laaggana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Taani ta dereta ubbaa oge kessana;","poem":1},{"text":"ta wogga ogeta dhoqu oothana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Heko, ta asay haahosoope yaana:","poem":1},{"text":"pudeha baggaafenne wuloha baggafe,","poem":2},{"lineBreak":true},{"text":"qassi Aswaana biittafe yaana” yaagees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Hinteno saloto, ufaysan yexite;","poem":1},{"text":"neno biittaw ufayta.","poem":2},{"text":"Hinteno dereto, ililite!","poem":1},{"text":"Goday ba asa minthethis;","poem":2},{"lineBreak":true},{"text":"ba metootetida ba asaas qadhetis.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Shin Xiyooney, “Goday tana aggis;","poem":1},{"text":"Xoossay tana dogis” yaagasu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Aayiya ba dhanthiya na7aa doganaw danda7ay?","poem":1},{"text":"Ba ulope keyida na7as qadhetekee?","poem":2},{"lineBreak":true},{"text":"Iya dogikoka, taani nena dogike!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Heko, taani nena ta kushe qaaqan xaafa wothas;","poem":1},{"text":"ne dirsa gimbeti ubba wode ta sinthan de7oosona.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nena zaaridi keexeysati ellesidi yaana;","poem":1},{"text":"nena laallidaysati neepe haakana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ane dhoqu gada ne yuushuwa xeella;","poem":1},{"text":"ne nayti ubbay issife shiiqidi neeko yaana.","poem":2},{"text":"Taani Goday, tanan caaqas:","poem":1},{"text":"neeni enta ubbaa alleeqoda ma7ana;","poem":2},{"lineBreak":true},{"text":"gelanaw haniya maccasi alleeqeteysada","poem":2},{"lineBreak":true},{"text":"neeni entan alleeqetana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Neeni laaletada baysa gidikoka,","poem":1},{"text":"ne biittay dhaykoka,","poem":2},{"lineBreak":true},{"text":"ha77i nenan de7iya asaas daro xuummana;","poem":2},{"lineBreak":true},{"text":"nena laallidaysati neepe haakana.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Neeni kayotiya laythan","poem":1},{"text":"new yeletida nayti ne haythan,","poem":2},{"text":"“Haysi bessay nuus daro xuunthu gidiya gisho,","poem":1},{"text":"nu daana dalga bessi imma” yaagana.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Neeni ne wozanan, “Ha nayta ubbaa taw oone yeliday?","poem":1},{"text":"Taani yelada dhonthu gidas; taani di7etas, ixetas.","poem":2},{"text":"Yaatin, haysata oone dichiday?","poem":1},{"lineBreak":true},{"text":"Taani tarka attas;","poem":1},{"text":"yaatin ha nayti ubbay awupe yidona? yaagana.”","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ubbaa Haariya Goday haysada yaagees:","poem":1},{"text":"“Heko, taani kawotethata mallata bessaana;","poem":2},{"lineBreak":true},{"text":"asaas ta bandira essana.","poem":2},{"text":"Enti ne adde nayta idimmidi,","poem":1},{"text":"ne macca nayta banta hashiyan tookidi ehana.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kawoti nena dichiya aawata gidana;","poem":1},{"text":"enta macca kawoti nena dhanthiya aayo gidana.","poem":2},{"text":"Enti gufannidi new goyinnana;","poem":1},{"text":"ne toho baana laaccana.","poem":2},{"text":"Taani Godaa gideysa neeni hessan erana;","poem":1},{"text":"tanan ammanetidi naageysati yeellatokona” yaagees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Olanchuwafe di7o yegisanaw,","poem":1},{"text":"wozan iita asa kushepe di7etida asi","poem":2},{"lineBreak":true},{"text":"kessi ekanaw danda7etiyee?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Shin Goday yaagees:","poem":1},{"text":"Olancho kushepe di7etida asi kessi ekanaw,","poem":2},{"lineBreak":true},{"text":"wozana mino asape di7o yegisanaw danda7etees.","poem":2},{"text":"Neera oleteysatara taani oletana;","poem":1},{"text":"ne naytaka ashshana.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nena un7etheysati banta ashuwa maana mela oothana;","poem":1},{"text":"woyne uyidi mathoteysada","poem":2},{"lineBreak":true},{"text":"enti banta suuthaa uyidi mathotana.","poem":2},{"text":"He wode asa ubbay taani Godaa,","poem":1},{"text":"nena Ashshiya, Woziyanne Yayqooba Wolqaamaa","poem":2},{"lineBreak":true},{"text":"gideysa erana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/48.json","previousChapterAudioLinks":{},"numberOfVerses":26}