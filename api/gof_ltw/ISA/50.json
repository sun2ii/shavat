{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":50,"content":[{"type":"heading","content":["Isra7eele Nagaranne Aylliya Kiitetethi"]},{"type":"verse","number":1,"content":["Goday yaagees;",{"text":"“Taani hinte aayiw yeddida pirima worqatey awun de7ii?","poem":2},{"lineBreak":true},{"text":"taani ooddes hintena taani bayzadina?","poem":2},{"text":"Heko, hinte nagaraa gisho hinte bayzetideta;","poem":1},{"text":"hinte naaquwa gisho hinte aayiya yedetasu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taani yida wode, haysan asi ayis dhayidee?","poem":1},{"text":"Taani xeegida wode, ‘Yee!’ gaanaw ayis asi dhayidee?","poem":2},{"text":"Taani hintena wozanaw ta kushey qantheyee?","poem":1},{"text":"hintena ashshanaw taw wolqi baaweyee?","poem":2},{"text":"Taani abba seerada melisayis;","poem":1},{"text":"shaafata mela biitta oothayis.","poem":2},{"text":"Haathi dhayin entan de7iya moloti wooqosona;","poem":1},{"text":"saamoy wodhin hayqoosona.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taani salota dhuma mayzayis;","poem":1},{"text":"enta kamay kayo ma7o daanees” yaagis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Daaburidaysa taani qaalan minthetho erana mela,","poem":1},{"text":"Ubbaa Haariya Goday taw tamaarida inxarsi immis.","poem":2},{"text":"I tana wonta wonta barkisidi,","poem":1},{"text":"taani tamaareda si7anaada ta haythaa dooyees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ubbaa Haariya Goday ta haythaa dooyis;","poem":1},{"text":"taani geella gidabike; guye simmabike.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taani ta zokuwa shoceysatas,","poem":1},{"text":"ta buuchaa shoddeysatas","poem":2},{"lineBreak":true},{"text":"ta gacuwa aathada immas.","poem":2},{"text":"Ta bolla cutteysatapenne tana kawusheysatape","poem":1},{"text":"ta som7uwa genthabike.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ubbaa Haariya Goday tana maaddiya gisho,","poem":1},{"text":"taani yeellatike.","poem":2},{"text":"Taani ta som7uwa salo shuchu oothas;","poem":1},{"text":"taani yeellatonnaysa erayis.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Taw pirdeysi matan de7ees;","poem":1},{"text":"yaatin, tana mootey oonee?","poem":2},{"lineBreak":true},{"text":"Ane taara mootetanaw eqo!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ubbaa Haariya Goday tana maaddees;","poem":1},{"text":"yaatin, ta bolla pirdey oonee?","poem":2},{"text":"Enti ubbay ma7oda cimana;","poem":1},{"text":"enta bili maana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Hinte giddofe Godaa yayyey,","poem":1},{"text":"iya aylliya qaalas kiitetey oonee?","poem":2},{"text":"Dhuman hemeteynne poo7oy baynay I oonee?","poem":1},{"text":"He uray Godaa sunthan ammaneto; ba Xoossan zempo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hinteno tama eethiya ubbato,","poem":1},{"text":"laco xompe hintew shiisheysato,","poem":2},{"lineBreak":true},{"text":"hinte eethida tama poo7uwan hemetite.","poem":2},{"text":"Laco xompiyan simeretite;","poem":1},{"text":"Hinte ta kushepe ekanaw de7ey haysa;","poem":2},{"lineBreak":true},{"text":"hinte wolqaama meto seelan zin7ana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/49.json","previousChapterAudioLinks":{},"numberOfVerses":11}