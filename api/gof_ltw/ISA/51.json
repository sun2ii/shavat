{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":51,"content":[{"type":"heading","content":["Merina Atotethi Xiyoones"]},{"type":"verse","number":1,"content":[{"text":"Hinteno xillotethi kaalleysato,","poem":1},{"text":"hinteno Godaa koyeysato si7ite.","poem":2},{"text":"Hinte phalqetidi eketida shuchaa","poem":1},{"text":"hinte booketidi keyida ollaa xeellite.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hinte aawa Abrahaamenne","poem":1},{"text":"hintena yelida Saaro xeellite.","poem":2},{"text":"I barka de7ishin, taani iya xeegada","poem":1},{"text":"anjasinne taybon darsas.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Goday Xiyoonenne","poem":1},{"text":"laaletida bessan de7iya asa ubbaa minthethana.","poem":2},{"text":"I mela biitta Edene,","poem":1},{"text":"kalotida biitta Godaa atakilte gadeda oothana.","poem":2},{"text":"Yan ufaysinne hashshu guussi daana;","poem":1},{"text":"galatinne mazmurey si7etana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ta asaw; ta odiyaba si7ite;","poem":1},{"text":"ta deriyaw, hinte haythaa taako zaarite.","poem":2},{"text":"Higgey taape keyees;","poem":1},{"text":"ta suure pirday kawotethatas poo7o gidana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ta xillotethay ellesidi shiiqana; ta atotethay matis;","poem":1},{"text":"ta qesey kawotethatas suure pirdaa ehana.","poem":2},{"text":"Yuushoy abban teqetida biittati ubbay","poem":1},{"text":"tanan ammanetidi naagana;","poem":2},{"lineBreak":true},{"text":"taani enta ta wolqan ashshanaysa ufaysan naagana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pude dhoqu gidi salota xeellite;","poem":1},{"text":"duge sa7aaka xeellite.","poem":2},{"text":"Saloti cuyada laaletidi dhayana;","poem":1},{"text":"sa7i afilada wurana;","poem":2},{"lineBreak":true},{"text":"iyan de7iya asa ubbay udunxeda hayqana.","poem":2},{"text":"Shin ta atotethay merinaw daana;","poem":1},{"text":"ta xillotethay wurenna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Hinteno xillotethaa ereysato,","poem":1},{"text":"ta higgey hinte wozanan de7eysato, si7ite.","poem":2},{"text":"Asaa bore yayyofite;","poem":1},{"text":"enta cashshas dagammopite.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bili ma7o, dorsa ikise guxuney meysada,","poem":1},{"text":"enti meetetana.","poem":2},{"text":"Shin ta xillotethay merinaw daana;","poem":1},{"text":"ta atotethay yeletetha ubbaas gidana” yaagees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Abeeti Godaw, denda! Denda!","poem":1},{"text":"Godaa qesiyaw, wolqaa ma7a.","poem":2},{"text":"Beni wodetaninne yeletethan hanidaysada denda;","poem":1},{"text":"Ra7aaba geetetiya dawiya qanxerethidaynne","poem":2},{"lineBreak":true},{"text":"caddiday nena gidikiyee?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abbaanne gita ciimmo haatha","poem":1},{"text":"melisiday nena gidikiyee?","poem":2},{"text":"Ne wozidaysati pinnana mela","poem":1},{"text":"ciimmo abba oge oothiday nena gidikiyee?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Goday wozidaysati yexishe simmidi Xiyoone yaana;","poem":1},{"text":"merinaa ufaysay kallacha mela enta bolla uttana.","poem":2},{"text":"Enti ufaysinne hashshu giyaba demmana;","poem":1},{"text":"azzanoynne yeehoy entafe haakana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Goday, “Taani, hintena minthethey tana;","poem":1},{"text":"yaatin, hayqiya asenne maatada shulliya","poem":2},{"lineBreak":true},{"text":"asa na7a yayyanaw hinte oonee?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Salota miccidanne sa7a baasuwa essida Godaa,","poem":1},{"text":"hintena medhida Xoossaa dogideta.","poem":2},{"text":"Enti hintena dhaysanaw un7ethiya","poem":1},{"text":"asaa hanquwa gaason ubba gallas yashshan de7eeta.","poem":2},{"text":"Shin hintena un7etheyisata hanqoy awun de7ii?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Di7etidaysati eeson birshetana;","poem":1},{"text":"qashetida ollan hayqokona; koshatokona.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Taani Godaa, ne Xoossaa;","poem":1},{"text":"guummana mela abba qaathey tana;","poem":2},{"lineBreak":true},{"text":"ta sunthay Ubbaafe Wolqaama Godaa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ta qaala ne doonan wothiday,","poem":1},{"text":"ta kushe kuyan nena genthiday,","poem":2},{"lineBreak":true},{"text":"salota micciday, sa7aa baasuwa essiday,","poem":2},{"lineBreak":true},{"text":"Xiyooneko, ‘Neeni ta ase’ ” yaagiday tana.","poem":2}]},{"type":"heading","content":["Xoossa Hanqo Xuu7a"]},{"type":"verse","number":17,"content":[{"text":"Neno, Godaa kushepe gandigarsiya","poem":1},{"text":"hanqo xuu7aa ashshona uyida Yerusalaame,","poem":2},{"lineBreak":true},{"text":"barka! Denda! Denda.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Iya yelida naytape iyo kaalethiya issoyka baawa;","poem":1},{"text":"iya dichida naytape I kushiya oykidi","poem":2},{"lineBreak":true},{"text":"efida issoyka baawa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ha nam7ubati ne qaada gididosona;","poem":1},{"text":"hessati laaletethinne dhayo;","poem":2},{"lineBreak":true},{"text":"koshinne mashshi ne bolla yaana;","poem":2},{"lineBreak":true},{"text":"yaatin, nena ooni minthethanee?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ne nayti giten gelida gen7eda","poem":1},{"text":"oge gaxan kundidi labbanidosona.","poem":2},{"text":"Enti Godaa hanquwaninne","poem":1},{"text":"ne Xoossaa seeran kumidosona.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hessa gisho, woyne ushshan gidonashin","poem":1},{"text":"meton mathotidaysato, hinte haysa si7ite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Ba asaas mootetiya ne Goday,","poem":1},{"text":"ne Xoossay yaagees;","poem":2},{"text":"Heko, nena gandigarisiya,","poem":1},{"text":"ta hanqo xuu7aa taani ne kushepe ekas;","poem":2},{"lineBreak":true},{"text":"neeni zaarada he mathoyiya ushsha uyaka.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Taani hessa nena un7ethiya","poem":1},{"text":"asaa kushen wothana;","poem":2},{"text":"Enti neeko, ‘Nuuni ne bollara hemetidi","poem":1},{"text":"aadhana mela zaqulla’ ” yaagidosona.","poem":2},{"text":"Neeni enti aadhana gakanaw","poem":1},{"text":"ne zokuwa entaw biittadanne ogeda oothadasa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":23}