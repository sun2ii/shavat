{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":52,"content":[{"type":"verse","number":1,"content":[{"text":"Neno Xiyoone, barka; barka,","poem":1},{"text":"minotethi afilada ma7a.","poem":2},{"text":"Neno geeshsha katame, Yerusalaame,","poem":1},{"text":"ne boncho ma7uwa ma7a.","poem":2},{"text":"Hizape guye qaxaretonaynne","poem":1},{"text":"tuni ne giddo gelenna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Neno, di7etida Yerusalaame, ne baana qoqofa;","poem":1},{"text":"dendada ne araata bolla utta.","poem":2},{"text":"Neno Xiyoone asaw,","poem":1},{"text":"ne qoodhen qashetida santhalaata birsha.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ubbaa Haariya Goday haysada yaagees:","poem":1},{"lineBreak":true},{"text":"“Hinte kase gatey bayna bayzetideta;","poem":1},{"text":"ha77i qassi miishe immonna coo wozetana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Goday haysada yaagees:","poem":1},{"lineBreak":true},{"text":"Ta asay koyro bete asi gididi Gibxe bis;","poem":1},{"text":"guyepe Asooreti ta asaa coo un7ethidosona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xoossay haysada yaagidi odees:","poem":1},{"lineBreak":true},{"text":"Ta asay gatey bayna coo di7etidi bin,","poem":1},{"text":"taw haysan aybe de7ey?","poem":2},{"text":"Enta haareysati toochoosona;","poem":1},{"text":"ta sunthay ubba wode cayetees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hessa gisho, ta asay ta sunthaa erana;","poem":1},{"text":"he gallas haysa odey tana gideysa enti erana;","poem":2},{"lineBreak":true},{"text":"ee, I tana” yaagees Ubbaa Haariya Goday.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lo77o mishiraacho ehiya,","poem":1},{"text":"sarotethaa awaajiya, atotethi odiya,","poem":2},{"text":"Xiyooneko, “Ne Xoossay kawotis” yaagishe","poem":1},{"text":"deriya bollara yaa tohoti waani lo77oona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne katamaa naageysati banta qaala dhoqu oothidi,","poem":1},{"text":"ufaysan issife yexoosona.","poem":2},{"text":"Goday Xiyoone simmiya wode","poem":1},{"text":"enti banta ayfen be7ana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hinteno Yerusalaamen laaletida bessato,","poem":1},{"text":"issife ufaysan yexite;","poem":2},{"text":"Goday ba asaa minthethis;","poem":1},{"text":"Yerusalaame wozis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Goday ba geeshsha qesiya","poem":1},{"text":"kawotethata ubbaa sinthan qoncisis.","poem":2},{"text":"Biitta gaxaa gakanaw de7iya","poem":1},{"text":"asa ubbay nu Xoossaa atotetha be7ana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Hinteno Godaa miishiya tookeysato, shaaketite,","poem":1},{"text":"shaaketite, yaape keyite.","poem":2},{"text":"Tunabaa bochofite; iya giddofe keyite;","poem":1},{"text":"hintena geeshshite.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Shin hinte keyishe eeson keyeketa;","poem":1},{"text":"woyko goodetidi beeketa.","poem":2},{"text":"Goday hintefe sinthe aadhidi kaalethana;","poem":1},{"text":"Isra7eele Xoossay guyera gididi hintena naagana.","poem":2}]},{"type":"heading","content":["Waaye Ekiya Aylle"]},{"type":"verse","number":13,"content":[{"text":"“Heko, ta aylley akeekan oothana;","poem":1},{"text":"I bonchetidi, dhoqu dhoqu gaana; daro gitatana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iya som7oy asa ubbaafe,","poem":1},{"text":"iya medhoy asa naytape aadhidi qohetis;","poem":2},{"lineBreak":true},{"text":"iya be7idi daro asay dagammidosona.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Shin ha77i daro kawotethati ubbay","poem":1},{"text":"iyaban malaaletana;","poem":2},{"lineBreak":true},{"text":"iya gaason, daro kawoti banta doona oykana.","poem":2},{"text":"Enti bantaw odetiboonnaba be7ana;","poem":1},{"text":"si7iboonaba akeekana” yaagees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}