{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":[{"text":"Nuuni odidaba ooni ammanidee?","poem":1},{"text":"Godaa qesey ooddes qoncidee?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"I iya sinthan mela biittan aacida duruma mela;","poem":1},{"text":"xapho yeddida dola mela diccis.","poem":2},{"text":"Nuuni iya loythi xeellonna mela","poem":1},{"text":"mali woyko teemi baawa.","poem":2},{"text":"Nuuni iyako shiiqonna mela","poem":1},{"text":"cuchu mal7o gidenna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"I asan kadhetis, ixetis;","poem":1},{"text":"I metopenne azzanope","poem":2},{"lineBreak":true},{"text":"shaaketi eronna asi gidis.","poem":2},{"text":"Asi iya be7anaape gidi","poem":1},{"text":"ba som7uwa wora zaariya asada kadhetis;","poem":2},{"lineBreak":true},{"text":"nuuni iya bonchibooko.","poem":2}]},{"type":"verse","number":4,"content":["I tuma nu waayiya baw ekis;",{"text":"qassi nu daabura tookis.","poem":2},{"text":"Shin nuuni, I Xoossan deshetidi kundidadanne","poem":1},{"text":"madunxidaada qopida.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Shin I nu nagaraa gisho,","poem":1},{"text":"cadetidi madunxis;","poem":2},{"lineBreak":true},{"text":"nu qohuwa gisho shocetidi liiqis.","poem":2},{"text":"Iya seeran nuuni saro demmida;","poem":1},{"text":"iya madunthan nuuni paxida.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nuuni ubbay oge balida dorsada wora bida;","poem":1},{"text":"nu ubbay nu ogiya ogiya bida.","poem":2},{"text":"Shin Goday nu ubbaa naaquwa","poem":1},{"text":"iya bolla wothis.","poem":2}]},{"type":"verse","number":7,"content":["I un7etis; qohetis;",{"text":"shin ba doona dooybeenna.","poem":2},{"text":"Shukanaw efiya urge dorsada laagetis;","poem":1},{"text":"ba ikisiya meediya uraa sinthan","poem":2},{"lineBreak":true},{"text":"si77i giya dorsa mela aykoka pogibeenna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Enti iya un7ethoninne geella pirdan efidosona;","poem":1},{"text":"I ta asaa nagaraa gisho shocetidi,","poem":2},{"lineBreak":true},{"text":"de7on de7eyisata biittafe kichidaysa","poem":2},{"lineBreak":true},{"text":"iya kochaafe ooni akeekidee?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iya doonan bali bayna, I, iitaba oothonna,","poem":1},{"text":"ba hayquwan iita asatara taybetis;","poem":2},{"lineBreak":true},{"text":"iya duufoy dure asatara gidis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Shin iya qohetethaynne iya un7etethay","poem":1},{"text":"Godaa shene gidis.","poem":2},{"text":"I bana nagara yarsho oothiya wode","poem":1},{"text":"ba kochaa be7ana.","poem":2},{"text":"Iya laythay aduqana;","poem":1},{"text":"Godaa sheney iya kushen poletana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ba shempuwa waayiyape guye,","poem":1},{"text":"I de7o poo7o be7ana; ufaytana.","poem":2},{"text":"Ta xillo aylley ba eratethan darota xillisana;","poem":1},{"text":"enta qohuwaka tookana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hessa gisho, taani iya gishuwa","poem":1},{"text":"gita asata giddon immana;","poem":2},{"lineBreak":true},{"text":"minotara I di7uwa shaaketana.","poem":2},{"text":"I ba shempuwa hayqos aathidi immidi,","poem":1},{"text":"iitatara paydetis.","poem":2},{"text":"I daro asaa nagaraa tookis;","poem":1},{"text":"geellatas gaannatis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/52.json","previousChapterAudioLinks":{},"numberOfVerses":12}