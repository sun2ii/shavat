{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":54,"content":[{"type":"heading","content":["Xiyoone Sintha Bonchuwa"]},{"type":"verse","number":1,"content":[{"text":"Naate, yelonna maynthe, yexa!","poem":1},{"text":"Naate, iqeta eronnaare, ufaysan ilila!","poem":2},{"text":"Azinara de7iya maccase naytape","poem":1},{"text":"barka de7iya maccase nayti darana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne dunkaaniya bessaa dalgisa;","poem":1},{"text":"dunkaaniya gesheta piddi oothada micca;","poem":2},{"lineBreak":true},{"text":"xuumisopa; wodoruwa adussa; dhishiya mintha.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Neeni ushachinne haddirsi dalgana;","poem":1},{"text":"ne kochati kawotethata laattana;","poem":2},{"lineBreak":true},{"text":"baysatida enta katamatan keexidi daana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Yayyofa; neeni yeellataka;","poem":1},{"text":"dagammofa; neeni kawuyaka.","poem":2},{"text":"Ne yalagatetha yeella neeni dogana;","poem":1},{"text":"ne am7etetha boriya hizape guye hassayaka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne azinay nena Medhidaysa;","poem":1},{"text":"iya sunthay Ubbaafe Wolqaama Godaa.","poem":2},{"text":"Isra7eele Geeshshay nena Wozidaysa;","poem":1},{"text":"I biitta ubbaa Xoossaa geetetana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Azini aggin, dogetada azzaniya maccasada,","poem":1},{"text":"yalagatethan azina soope keyida,","poem":2},{"lineBreak":true},{"text":"maccasada neeni hanada de7ishin,","poem":2},{"lineBreak":true},{"text":"taani Goday nena zaarada xeegas.","poem":2}]},{"type":"verse","number":7,"content":["“Guutha wode taani nena aggas,",{"text":"shin gita qadhen taani nena zaarada ehana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Suulliya hanqon taani ta som7uwa","poem":1},{"text":"neepe guutha wodes genthas.","poem":2},{"text":"Shin merinaa maarotethan taani new qadhetana”","poem":1},{"text":"yaagees nena woziya Goday.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Haysi taw Nohe wodiya mela;","poem":1},{"text":"he wode taani dhayo haathan","poem":2},{"lineBreak":true},{"text":"zaarada sa7aa dhaysike gada caaqidaysada,","poem":2},{"lineBreak":true},{"text":"zaarada ne bolla hanqetonna melanne","poem":2},{"lineBreak":true},{"text":"seeronna mela taani caaqas.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dereti qaxanaw, zumati banta bessaafe kichanaw danda7oosona;","poem":1},{"text":"shin ta merinaa siiqoy neepe shaaketenna;","poem":2},{"lineBreak":true},{"text":"ta sarotetha caaqoy neepe kichenna”","poem":2},"yaagees new qadhetiya Goday."]},{"type":"verse","number":11,"content":[{"text":"“Neno, metootida katame, gotey yaanne haanne shocidaare,","poem":1},{"text":"minthethiyabay dhayidare,","poem":2},{"lineBreak":true},{"text":"Heko, taani nena boncho shuchan alleeqisada keexana;","poem":2},{"lineBreak":true},{"text":"ne baasuwa sanpare shuchan hiixana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne shucha gimbiya qustiya zo7o inqo shuchan,","poem":1},{"text":"ne pengiya phooliya al7o shuchan,","poem":2},{"lineBreak":true},{"text":"ne dirsa boncho shuchan gimbana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ne nayti ubbay Godaape tamaarana;","poem":1},{"text":"ne nayta sarotethay darana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Neeni xillotethan minnada eqana;","poem":1},{"text":"geneynne un7ethoy neepe haakana.","poem":2},{"text":"Nena yashisiyaba deenna;","poem":1},{"text":"dagami neeko shiiqenna.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nena olanaw dendey de7iko, hessi taape gidenna;","poem":1},{"text":"nena qohanaw koyey de7iko, I kundana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Heko, huben tama hubidi,","poem":1},{"text":"ba qopida ola miishiya qoxiya uraa taani medhas;","poem":2},{"lineBreak":true},{"text":"dhaysana mela dhayseysa medhiday tana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nena qohanaw oosetida ay miisheyka ne bolla oothenna;","poem":1},{"text":"nena mootiya inxarsa ubbaas ne zaaro immana.","poem":2},{"text":"Godaa aylleta laatay haysa;","poem":1},{"text":"taape enti ekiya xillo haysa” yaagees Goday.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":17}