{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":55,"content":[{"type":"heading","content":["Saamotida Ubbay Yo"]},{"type":"verse","number":1,"content":[{"text":"Hinteno, saamotidaysato, ubbay taako haa yiite;","poem":1},{"text":"miishey baynaysato, haa yiite.","poem":2},{"text":"Shammidi miite;","poem":1},{"text":"haa yidi, miishe qanxonna","poem":2},{"lineBreak":true},{"text":"coo woyne ushshinne maathi shammite.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kathi gidonnabaas hinte miishiya ayis kesseetii?","poem":1},{"text":"Kalsonnaban hinte wolqaa ayis wurseetii?","poem":2},{"text":"Ane tana si7ite, taani odeysa hayzite;","poem":1},{"text":"lo77o kathaa miite;","poem":2},{"lineBreak":true},{"text":"lo77o kathan hinte asatethaa ufaysite.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Hinte haytha taako zaaridi tana si7ite;","poem":1},{"text":"de7on daanaw ta odeysa si7ite;","poem":2},{"lineBreak":true},{"text":"taani Dawitas gelida ufaysa qaalan hintena anjana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Heko, taani iya kawotethatas marka,","poem":1},{"text":"kaaletheysanne halaqa oothas.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Goday, ne Xoossay, Isra7eele Geeshshay","poem":1},{"text":"nena bonchida gisho,","poem":2},{"lineBreak":true},{"text":"neeni eronna kawotethata xeegana;","poem":2},{"lineBreak":true},{"text":"nena eronna kawotethati ellesidi neeko yaana.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Goday bentiya wode iya koyite;","poem":1},{"text":"matan de7iya wode iya xeegite.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iita asi ba ogiyape simmo;","poem":1},{"text":"nagaranchoy ba qofaa aggo.","poem":2},{"text":"Godaako simmo, ika iya maarana;","poem":1},{"text":"I nu Xoossaako simmo, iyaw atto gaana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ta qofay hinte qofaa mela,","poem":1},{"text":"ta ogey hinte ogiya mela gidenna”","poem":2},"yaagees Goday."]},{"type":"verse","number":9,"content":[{"text":"Saloti sa7aape dhoqeysada,","poem":1},{"text":"ta ogey hinte ogiyape,","poem":2},{"lineBreak":true},{"text":"ta qofay hinte qofaape dhoqees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Irinne shachi salope wodhidi,","poem":1},{"text":"biitta laakisidi, kathi dolana melanne","poem":2},{"lineBreak":true},{"text":"ayfana mela ootheysada, zereysas zerethi,","poem":2},{"lineBreak":true},{"text":"meysas kathi immonna guye salo simmenna.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ta doonape keyiya qaalay hessa mala;","poem":1},{"text":"I taani halchidaysa polonnanne","poem":2},{"lineBreak":true},{"text":"ta kiittidaysa oothonna taako coo simmenna.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Hinte ufaysan keyana; saron moyzetana;","poem":1},{"text":"deretinne zumati hinte sinthan ufaytidi yexana;","poem":2},{"lineBreak":true},{"text":"bazzo mithati ubbay banta kushiya baqana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Aguntha gisho xiidda,","poem":1},{"text":"gom7ore gisho xaythi dolana.","poem":2},{"text":"Hessi Godaa qofisiyabaanne","poem":1},{"text":"merinaw dhayonna malla gidana”","poem":2},"yaagees Goday."]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}