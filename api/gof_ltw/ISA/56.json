{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":56,"content":[{"type":"heading","content":["Atotethi Haratas"]},{"type":"verse","number":1,"content":["“Suure pirdaa naagite; xillo oothite;",{"text":"ta atotethay ellesidi yaana;","poem":2},{"lineBreak":true},{"text":"ta xillotethay matan qoncana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Haysa oothiya uray,","poem":1},{"text":"Sambaata tunisonna bonchiya uraynne","poem":2},{"lineBreak":true},{"text":"ba kushey iitabaa oothonna mela teqiya uray anjetidaysa”","poem":2},"yaagees Goday."]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Godaako shiiqida bete asi,","poem":1},{"text":"“Goday tana ba asaape shaakana” goopo;","poem":2},{"lineBreak":true},{"text":"shuufay, “Taani melida mithi” goopo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Ta Sambaata bonchiya,","poem":1},{"text":"tana ufaysiyaba dooreynne","poem":2},{"lineBreak":true},{"text":"ta caaquwa minthidi naagiya shuufatas,","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"entaw taani ta keethaninne ta dirsa gimbiya giddon","poem":2},{"lineBreak":true},{"text":"enti hassayetiyaba immana.","poem":2},{"text":"Enti macca na7anne adde na7a yelidi,","poem":1},{"text":"demmiya bonchuwafe aadhiya","poem":2},{"lineBreak":true},{"text":"sunthi taani entaw immana;","poem":2},{"lineBreak":true},{"text":"taani merinaw dhayonna sunthi entaw immana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Godaa haggaazanaw, Godaa dosanawunne","poem":1},{"text":"iya aylle gidanaw bantana iyako shiishiya,","poem":2},{"lineBreak":true},{"text":"sambaata tunisonna bonchiyanne","poem":2},{"lineBreak":true},{"text":"ta caaqo qaala minthidi naagiya bete asata,","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"taani ta geeshsha zumaa bolla ehada","poem":2},{"lineBreak":true},{"text":"ta woosa keethan enta ufaysana.","poem":2},{"text":"Enti ta yarsho bessan shiishiya xuussa yarshoynne","poem":1},{"text":"hara yarshoy eketana;","poem":2},{"lineBreak":true},{"text":"ta keethay asa ubbay Xoossaa woossiya keethi geetetana”","poem":2},"yaagees."]},{"type":"verse","number":8,"content":[{"text":"“Shiqidaysata bolla gujada harataka taani shiishana”","poem":1},{"text":"yaagees Isra7eelepe laaletidaysata shiishiya, Ubbaa Haariya Goday.","poem":2}]},{"type":"heading","content":["Xoossay Iitata Mootees"]},{"type":"verse","number":9,"content":[{"text":"Hinteno bazzo do7ato,","poem":1},{"text":"hinteno wora do7ato,","poem":2},{"lineBreak":true},{"text":"ubbay haa yidi miite.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Isra7eele asaa naageysati qooqe; entaw eri baawa;","poem":1},{"text":"enti ubbay boccanaw danda7onna butale kanata;","poem":2},{"lineBreak":true},{"text":"enti zin7idi elmotoosona; dhisko dosoosona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Enti midi kallonna yaramba kana mela;","poem":1},{"text":"enti akeeki pacida henthancho.","poem":2},{"text":"Enti ubbay banta oge bidosona;","poem":1},{"text":"ubbay banta go77a xalaala koyoosona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Enti, “Haa yiite; woyne ushsha ane uyoos;","poem":1},{"text":"mathoyiya ushsha ane ganoos!","poem":2},{"text":"Wontoy hachi mela gidana;","poem":1},{"text":"hachifeka aadhidi lo77ana” yaagosona.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}