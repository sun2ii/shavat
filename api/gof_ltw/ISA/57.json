{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":57,"content":[{"type":"verse","number":1,"content":[{"text":"Xillo asi hayqees;","poem":1},{"text":"shin hessa qopey baawa.","poem":2},{"text":"Bantana Xoossas immida asay biittafe eketoosona,","poem":1},{"text":"shin xillo asi iiti yaanape sinthatidi,","poem":2},{"lineBreak":true},{"text":"eketeysa oonika akeekenna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"I, bidi sarotethi de7iya bessi gelees;","poem":1},{"text":"suuretethan hemeteysati hayqidi,","poem":2},{"lineBreak":true},{"text":"shempo demmoosona.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Hinteno, maro nayto, hinteno laammiyanne","poem":1},{"text":"laymatiya zareto, haa yiite.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hinte oona qelqiseetii?","poem":1},{"text":"Hinte oona boreetiii?","poem":2},{"text":"Hinte inxarsaa oodde bolla kesseetii?","poem":1},{"text":"Hinte geellatanne wordancho nayta gideketii?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hinte wolaa garsaninne","poem":1},{"text":"daashsha mitha garsan amon xuugeteeta.","poem":2},{"text":"Hinte nayta zangaaraninne","poem":1},{"text":"zaalla qophon shukidi yarsheeta.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Zangaaran de7iya liiqo shuchati hinte xoossata;","poem":1},{"text":"Hinte entaw ushsha yarsho tigideta.","poem":2},{"text":"Kathaa yarshoka immideta","poem":1},{"text":"yaatin, taani haysan hanqetikina?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Zumaa huuphen hiixa yeggideta;","poem":1},{"text":"yan yarshanaw keydeta.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hinte pengiyafenne gobanetape","poem":1},{"text":"soo baggara eeqa misileta essideta.","poem":2},{"text":"Tana aggidi hinte arsa dalgisidi, yaa keydeta;","poem":1},{"text":"entara caaqideta; yaatidi enta arsa dosideta;","poem":2},{"lineBreak":true},{"text":"enta kalluwa be7ideta.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Zaytenne shitto ekidi Moloka geetetiya eeqako bideta;","poem":1},{"text":"hinte kiitanchota haaho soo kiittideta;","poem":2},{"lineBreak":true},{"text":"hari attoshin si7oole gakanaw wodhideta.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hinte hara xoossata koyishe daaburideta;","poem":1},{"text":"shin, ‘Ufaysi baawa’ gibeeketa.","poem":2},{"text":"Hinte wolqay haa ooraxis;","poem":1},{"text":"hessa gisho, labbanidi kundibeeketa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Hinte oona yayyidi, taw wordotidetii?","poem":1},{"text":"Hinte tana qopibeketa;","poem":2},{"lineBreak":true},{"text":"hinte wozanan qopibeketa.","poem":2},{"text":"Hinte taw yayyonna ixiday","poem":1},{"text":"taani daro wode si77i gida gisho gidennee?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Taani hinte xillotethaanne hinte oosota awaajana;","poem":1},{"text":"shin hintena aykoka go77okona.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hinte maado demmanaw waassiya wode","poem":1},{"text":"hinte shiishida eeqati hintena ashshena!","poem":2},{"text":"Enta ubbaa carkoy efana;","poem":1},{"text":"issi toho carkiya carkoy enta punnidi dhaysana.","poem":2},{"text":"Shin tana baw baqatidi attiya besse oothiya","poem":1},{"text":"uray biitta laattana;","poem":2},{"lineBreak":true},{"text":"ta geeshsha zumaa ekana”","poem":2},"yaagees."]},{"type":"heading","content":["Wozani Meqida Asaas Minthetho"]},{"type":"verse","number":14,"content":["“Baasite, baasite! Oge giigisite;",{"text":"ta asaa ogiyape dhubiyaba ubbaa diggite”","poem":2},"yaagees Goday."]},{"type":"verse","number":15,"content":[{"text":"Merinaw de7eysi, gitay, dhoqa bessan de7eysi,","poem":1},{"text":"iya sunthay Geeshsha geeteteysi, yaagees:","poem":2},{"text":"“Kawuyida asaa ayyaana denthethanaw,","poem":1},{"text":"meqida wozani de7eyisata koolanaw,","poem":2},{"lineBreak":true},{"text":"kawuyidanne meqida ayyaani de7eysara daana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ta medhida asa ayyaanaynne shempoy,","poem":1},{"text":"ta sinthan docconna mela taani merinaw mootike;","poem":2},{"lineBreak":true},{"text":"ubba wode hanqetike.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Enta nagaraa gaason taani enta hanqetada seeras;","poem":1},{"text":"ta som7uwa entafe genthas;","poem":2},{"lineBreak":true},{"text":"shin enti ha77ika banta wozanaa qofan bidosona.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Taani enta ogiya be7as;","poem":1},{"text":"shin taani enta pathana, kaalethana;","poem":2},{"lineBreak":true},{"text":"iyawunne iya gisho yeekeyisata minthethana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Isra7eele biittan yeekeyisata,","poem":1},{"text":"mettershan galata kunthana.","poem":2},{"text":"Haahoninne matan de7eysatas,","poem":1},{"text":"saroy giddo; taani enta pathana”","poem":2},"yaagees Goday."]},{"type":"verse","number":20,"content":[{"text":"Shin iitati urqanne silimo kessiya,","poem":1},{"text":"wopu gaanaw danda7onna abba beeta mela.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“Iitatas saroy baawa”","poem":1},"yaagees ta Xoossay."]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":21}