{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":58,"content":[{"type":"heading","content":["Tuma Xooma"]},{"type":"verse","number":1,"content":[{"text":"Goday haysada yaagees:","poem":1},{"text":"“Ne qaala dhoqu oothada waassa; guye goopa;","poem":2},{"lineBreak":true},{"text":"ne qaala moyzeda dhoqu ootha.","poem":2},{"text":"Ta asaas enta geellatetha,","poem":1},{"text":"Yayqooba keethaas enta nagaraa oda.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Shin enti tana gallas gallas koyoosona;","poem":1},{"text":"ta ogiya kaallanaw dosiya daanosona.","poem":2},{"text":"Xillo oothidanne Xoossaa kiitaa aggiboonna asada","poem":1},{"text":"enti tana suure pirda oychoosona;","poem":2},{"lineBreak":true},{"text":"taako Xoossaako shiiqanaw dosiya daanosona.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Enti Godaako,","poem":1},{"text":"‘Nuuni xoomos, shin neeni ayis nuna xeellikii?","poem":2},{"lineBreak":true},{"text":"Nuuni nunatethaa kawushida,","poem":2},{"lineBreak":true},{"text":"shin neeni ayis eronnaada hanadi’ yaagosona.","poem":2},{"text":"Goday zaaridi, ‘Heko, hinte xoomiya wode","poem":1},{"text":"hintena ufaysiyabaa ootheeta;","poem":2},{"lineBreak":true},{"text":"hinte oosanchota un7etheeta.’","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hinte ooshshaninne palaman xoomeeta;","poem":1},{"text":"qadhey bayna iita deshethi dechanaw xoomeeta.","poem":2},{"text":"Hessa mela xoomiya hinte woosay bolla saluwan","poem":1},{"text":"si7etonna mela oothees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Taani doorida xoomay haysa mela xoomee?","poem":1},{"text":"Issi asi banatetha kawushey haysa mela gallasa xalaalanee?","poem":2},{"text":"Taani koyiya xoomay asi ba huuphiya","poem":1},{"text":"kaxida gasheda hoksana melanne","poem":2},{"lineBreak":true},{"text":"bido tiyetidi kayo ma7o ma7idi utetheyee?","poem":2},{"text":"Hinte hessa xooma gidi xeegetiyee?","poem":1},{"text":"He xooma gallasay Godaa sinthan eketiyee?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Taani dooriya xoomay haysa;","poem":1},{"text":"suure pirda dhayo santhalaata billana melanne","poem":2},{"lineBreak":true},{"text":"qambara menthidi un7etidaysata","poem":2},{"lineBreak":true},{"text":"la77a kessana mela gidenneyee?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Taani dooriya xoomay koshatidaysa muzana mela,","poem":1},{"text":"keethi bayna manqota soo ekana mela,","poem":2},{"lineBreak":true},{"text":"kallotidaysa be7ada mayzana melanne","poem":2},{"lineBreak":true},{"text":"maado koyiya hinte dabbuwafe","poem":2},{"lineBreak":true},{"text":"hintena genthonna melasa gidennee?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yaatiko, hinte poo7oy wonta xalqeda poo7ana;","poem":1},{"text":"hinte paxotethay eeson yaana.","poem":2},{"text":"Hinte xillotethay hintefe sinthara baana;","poem":1},{"text":"Godaa bonchoy hintefe guyera gididi,","poem":2},{"lineBreak":true},{"text":"hintena naagana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"He wode hinte xeegana;","poem":1},{"text":"Goday hintew koyana.","poem":2},{"text":"Hinte maado koyidi waassana;","poem":1},{"text":"I, ‘Heko, taani haysan de7ayis!’ yaagana.","poem":2},{"lineBreak":true},{"text":"“Hinte giddofe un7ethiya qambara diggiko,","poem":1},{"text":"biradhen malleysanne iitaba odeteysa aggiko,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Koshatidaysa muziko,","poem":1},{"text":"metootidaysata koshshiyaban maaddiko,","poem":2},{"lineBreak":true},{"text":"he wode hinte poo7oy dhuman poo7ana;","poem":2},{"lineBreak":true},{"text":"hinte qammay seeta gallas gidana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Goday hintena ubba wode kaalethana;","poem":1},{"text":"hintena mela biittan koshshiyaban kalsana;","poem":2},{"lineBreak":true},{"text":"hinte xaphuwa xaalisana.","poem":2},{"text":"Hinte haathe uyaa gannate melanne","poem":1},{"text":"meli eronna haatha pulto mela gidana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne asay beni laaletida bessata zaaridi keexana;","poem":1},{"text":"daro wodepe kase baasetida baasota keexidi dhoqu oothana.","poem":2},{"text":"Hinte ‘Laaletida gimbeta gimbeysatanne","poem":1},{"text":"asay de7iya bessaanne wogga ogey","poem":2},{"lineBreak":true},{"text":"de7iya katamata esseyisata geetetana.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Sambaata gallasaa boncho aggonna ixiko,","poem":1},{"text":"ta geeshsha gallas hinte go77a yedetheysa aggiko,","poem":2},{"lineBreak":true},{"text":"Sambaata ufaysinne bonchetida,","poem":2},{"lineBreak":true},{"text":"Godaa gallasaa boncho gada xeegiko,","poem":2},{"lineBreak":true},{"text":"hinte hinte ogiya boonna aggidi he gallasaa bonchiko,","poem":2},{"lineBreak":true},{"text":"hintena ufaysiyabaa oothonnanne hadaba odetonna aggiko,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"he wode hinte Godan ufaytana;","poem":2},{"lineBreak":true},{"text":"taani hintena daro bonchetidaysata oothana;","poem":2},{"lineBreak":true},{"text":"hinte aawa Yayqooba laata hinte maana mela oothana.","poem":2},"Taani Goday haysa odas” yaagees."]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/57.json","previousChapterAudioLinks":{},"numberOfVerses":14}