{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":59,"content":[{"type":"heading","content":["Nagaranne Pirda"]},{"type":"verse","number":1,"content":[{"text":"Heko, Godaa kushey","poem":1},{"text":"hintena ashshanaw qaammibeenna;","poem":2},{"lineBreak":true},{"text":"iya haythay si7anaw tullibeenna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Shin hinte nagaray hintefenne","poem":1},{"text":"hinte Xoossaafe giddon shaahetethi medhis.","poem":2},{"text":"I si7onna mela hinte nagaray","poem":1},{"text":"iya som7uwa hintefe genthis.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hinte kushey suuthan,","poem":1},{"text":"hinte biradhey naaqon tunis;","poem":2},{"lineBreak":true},{"text":"hinte doonay wordo odetees;","poem":2},{"lineBreak":true},{"text":"hinte inxarsay iitaba zuuzumees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Xillotethan mootey baawa;","poem":1},{"text":"suuretethan pirdeyka baawa.","poem":2},{"text":"Enti coo palaman ceeqetoosona;","poem":1},{"text":"wordo odetoosona;","poem":2},{"lineBreak":true},{"text":"cimo qanthatidi iitatethi yeloosona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Enti shoosha phuuphulle haphoosona;","poem":1},{"text":"shango haada daddoosona.","poem":2},{"text":"He phuuphulleta miya asi hayqees;","poem":1},{"text":"phuuphulliyafe issoy meqiko,","poem":2},{"lineBreak":true},{"text":"iyape shooshi keyees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Enti daddida shango haaday ma7os hanenna;","poem":1},{"text":"iyara banta asatethaa kammanaw danda7okona.","poem":2},{"text":"Enta oosoy iita;","poem":1},{"text":"geella oosoy enta kushen kumis.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Enta tohoti iitabaa oothanaw woxoosona;","poem":1},{"text":"xillo suuthi gussanaw eesotoosona.","poem":2},{"text":"Enta qofay iita; enti bida bessa ubban","poem":1},{"text":"qohoynne boshi de7ees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Enti sarotetha oge erokona;","poem":1},{"text":"enta ogiyan suure pirdi baawa.","poem":2},{"text":"Enti banta ogiya geellayidosona;","poem":1},{"text":"he ogiyara hemetiya oonika saro demmenna.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hessa gisho, suure pirdi nuupe haakis;","poem":1},{"text":"xillotethi nuuko shiiqenna.","poem":2},{"text":"Nuuni poo7o koyoos, shin dhuma gidis;","poem":1},{"text":"wagagga poo7o koyoos,","poem":2},{"lineBreak":true},{"text":"shin sakana dhuman hemetoos.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nuuni qooqeda dirsaa gimbiya bolla tattafoos;","poem":1},{"text":"seeta gallas, sa7i lem7in hemetiyada dhubetoos;","poem":2},{"lineBreak":true},{"text":"wolqara de7iya asaa giddon","poem":2},{"lineBreak":true},{"text":"nuuni hayqida asa mela gidida.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nuuni ubbay babanthada waassos;","poem":1},{"text":"holleda kayotidi oolos.","poem":2},{"text":"Nuuni suure pirda koyida,","poem":1},{"text":"shin demmibooko;","poem":2},{"lineBreak":true},{"text":"atotethi koyida, shin I nuupe haakis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nu balay ne sinthan daris;","poem":1},{"text":"nu nagaray nu bolla markatees.","poem":2},{"text":"Nu naaqoy nuura de7ees;","poem":1},{"text":"nu qohuwa nu eroos.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nuuni makallidi, Godaa kadhida;","poem":1},{"text":"nu Xoossaa aggidi guye simmida.","poem":2},{"text":"Geellatethinne gene odetida;","poem":1},{"text":"nuuni wordo qanthatidi wordo yelida.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Suure pirdi guye sugetis;","poem":1},{"text":"xillotethi nuupe haakis.","poem":2},{"text":"Tumatethi dabaaban dhubetees;","poem":1},{"text":"ammanetethi gelanaw besse dhayis.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tumatethi awunka bentenna;","poem":1},{"text":"iitatethafe haakiya asi qohos aadhidi imetees;","poem":2},{"lineBreak":true},{"text":"Goday suure pirdi baynaysa be7idi azzanis.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Un7eteyisata maaddiya asinne","poem":1},{"text":"entaw gaannatiya asi baynaysa","poem":2},{"lineBreak":true},{"text":"Goday be7idi malaaletis.","poem":2},{"text":"Hessa gisho, iya qesey iyaw atotethi ehis;","poem":1},{"text":"iya xillotethay iya katisidi oykis.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"I, xillotethi tiran wothiya ola miisheda ma7is;","poem":1},{"text":"ba huuphiyan atotetha barneexa wothis;","poem":2},{"lineBreak":true},{"text":"halo kessi ma7oda, hanqo afilada ma7is.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"I entaw enta oosuwada oosuwada zaarana;","poem":1},{"text":"hanquwa ba morketas,","poem":2},{"lineBreak":true},{"text":"seera baara eqeteysatas ciggana;","poem":2},{"lineBreak":true},{"text":"yuushoy abban teqetida biittatas enta oosuwada immana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Godaa peenoy wolqaama goteda di77ishe yaana gisho,","poem":1},{"text":"wuloha baggan de7eysati Godaa sunthaas yayyana;","poem":2},{"lineBreak":true},{"text":"doloha baggan de7eysati iya bonchana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Xiyoonesinne Yayqooba zeretha giddon","poem":1},{"text":"banta nagarape simmeyisata Wozeysi yaana.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Taw entara de7iya caaqoy haysa:","poem":1},{"text":"hinte bolla de7iya ta Ayyaanaynne","poem":2},{"lineBreak":true},{"text":"taani hinte doonan wothida ta qaalay,","poem":2},{"lineBreak":true},{"text":"hachife doomidi, merinaa gakanaw,","poem":2},{"lineBreak":true},{"text":"hinte doonape, hinte nayta doonapenne","poem":2},{"lineBreak":true},{"text":"hinte nayta nayta doonape shaaketenna”","poem":2},"yaagees Goday."]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/58.json","previousChapterAudioLinks":{},"numberOfVerses":21}