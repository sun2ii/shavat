{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":60,"content":[{"type":"heading","content":["Xiyoone Bonchuwa"]},{"type":"verse","number":1,"content":["Ne poo7oy yida gisho, dendada poo7isa;",{"text":"Godaa bonchoy ne bolla poo7ana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Heko, dhumi sa7aa, sakana dhumi asaa kammana;","poem":1},{"text":"shin Goday ne bolla dendana;","poem":2},{"lineBreak":true},{"text":"iya bonchoy ne bolla poo7ana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kawotethati ne poo7uwako,","poem":1},{"text":"kawotika ne wonta xolqethaako yaana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dhoqu gada ne yuushuwa xeella;","poem":1},{"text":"ubbay issife neeko yaana.","poem":2},{"text":"Ne adde nayti haahope yaana;","poem":1},{"text":"ne macca nayti ba7etidi neeko yaana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"He wode neeni be7ada ufaytana;","poem":1},{"text":"ne wozanay ufaysan noocu gaana.","poem":2},{"text":"Abbaa bolla de7iya shaloy neeko yaana;","poem":1},{"text":"kawotethata duretethay nebaa gidana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Midiyaamepenne Efa biittafe yida,","poem":1},{"text":"gimale wudey ne biitta kammana.","poem":2},{"lineBreak":true},{"text":"Worqanne ixaane eheysati","poem":2},{"lineBreak":true},{"text":"Godaa galataa awaajishe Saabape yaana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Qedaarenne Nebayoota dorsa wude ubbay,","poem":1},{"text":"ta yarsho bessa neeko yaana;","poem":2},{"lineBreak":true},{"text":"taani ta boncho keethaa bonchana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Haysati shaarada woyko holleda","poem":1},{"text":"banta keethako paalleysati oonee?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tuma yuushoy abban teqetida biittati,","poem":1},{"text":"tanan ufaysi wothana;","poem":2},{"text":"Isra7eele geeshshay, Goday hinte Xoossay,","poem":1},{"text":"hintena bonchida gisho,","poem":2},{"text":"Tarsesa markabeti sinthati keyidi,","poem":1},{"text":"ne nayta haaho biittafe enta biraranne worqara","poem":2},{"lineBreak":true},{"text":"Xoossaa bonchuwas ehana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Allaga biittati ne dirsaa gimbana;","poem":1},{"text":"enta kawoti new oothana.","poem":2},{"text":"Nena taani ta hanquwan kase shocas,","poem":1},{"text":"shin ha77i ta qadhiyan nena maaras.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne pengeti ubba wode dooya daana;","poem":1},{"text":"kawotethata duretethaynne","poem":2},{"lineBreak":true},{"text":"enta kawoti di7etidi neeko yaana mela","poem":2},{"lineBreak":true},{"text":"gallasinne qamma gordetokona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"New oothonna asi","poem":1},{"text":"woyko kawotethi ubbay dhayana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ta keethaa bessaa loythana mela","poem":1},{"text":"Libaanose boncho gidida zigay,","poem":2},{"lineBreak":true},{"text":"xiiddaynne xaythay neeko yaana;","poem":2},{"lineBreak":true},{"text":"taani ta tohuwa wothiya bessaa bonchana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nena un7ethida asaa nayti yidi new hokana;","poem":1},{"text":"nena kadhida ubbay ne sinthan goyinnana.","poem":2},{"text":"Enti nena, ‘Godaa Katame, Xiyoone,","poem":1},{"text":"Isra7eele, Geeshsha Katame’ yaagidi xeegana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Haysafe kase oonika ne giddora kanthonna mela","poem":1},{"text":"yegetadasanne ixetadasa.","poem":2},{"text":"Shin ha77i taani nena merinaw gita oothana;","poem":1},{"text":"yeletethaa ubbay nenan ufaytana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Neeni kawotethata maatha uyana;","poem":1},{"text":"kawota dhantha dhammana.","poem":2},{"text":"Goday, nena Ashsheysa, wozeysanne","poem":1},{"text":"Yayqooba wolqaama gideysa neeni erana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Naase birata gisho worqa,","poem":1},{"text":"birata gisho bira, mitha gisho naase birata,","poem":2},{"lineBreak":true},{"text":"shucha gisho birata taani new ehana.","poem":2},{"text":"Taani, sarotethi nena ayseysa,","poem":1},{"text":"xillotethi new halaqa oothana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Geellatethi ne biittan, dhayoy woyko boshi","poem":1},{"text":"ne zawan si7etenna.","poem":2},{"text":"Neeni ne dirsa gimbiya, ‘Atotethaa’,","poem":1},{"text":"ne pengiya, ‘Galata’ yaagada xeegana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Gallas awa poo7o, qamma ageena poo7o new koshshenna;","poem":1},{"text":"Goday new merinaa poo7o,","poem":2},{"lineBreak":true},{"text":"ne Xoossay new boncho gidana.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Awi nam7antho wullenna;","poem":1},{"text":"ne ageenay poo7o aggenna.","poem":2},{"text":"Goday new merinaa poo7o gidana;","poem":1},{"text":"neeni yeekida gallasati new gidana.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ne asa ubbay xillo gidana;","poem":1},{"text":"enti biitta merinaw laattana.","poem":2},{"text":"Enti taani ta bonchuwa qoncisanaw tokida puutota;","poem":1},{"text":"ta kushe oosota.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hinte giddon issi keethan de7iya guutha asata darsana;","poem":1},{"text":"ubbaafe guuthaa gita kawotethi oothana.","poem":2},{"text":"Taani Godaa; wodey gakiya wode,","poem":1},{"text":"taani hessa eeson polana” yaagees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/59.json","previousChapterAudioLinks":{},"numberOfVerses":22}