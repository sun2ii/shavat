{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":61,"content":[{"type":"heading","content":["Atotetha Mishiraacho"]},{"type":"verse","number":1,"content":[{"text":"Ubbaa Haariya Godaa Ayyaanay ta bolla de7ees;","poem":1},{"text":"manqotas lo77oba odana mela Goday tana tiyis.","poem":2},{"text":"Wozani meqidaysata koolana mela,","poem":1},{"text":"di7etidaysata la77a kessana melanne","poem":2},{"lineBreak":true},{"text":"qashetidaysata billana mela Goday tana kiittis.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dosetida Godaa laytha odana mela,","poem":1},{"text":"nu Xoossay halo keyana gallasaa awaajana mela,","poem":2},{"lineBreak":true},{"text":"azzaneyisata ubbaa minthethana mela tana kiittis.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Xiyoonen kayoteysatas, bido gisho kallacha,","poem":1},{"text":"yeeho gisho ufaysa zayte,","poem":2},{"lineBreak":true},{"text":"azzano gisho galata ma7o immana mela tana kiittis.","poem":2},{"text":"Enti Goday ba bonchuwas","poem":1},{"text":"tokida xillo mitha geetetidi xeegetana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Enti beni laaletida bessata zaaridi keexana;","poem":1},{"text":"beni kundida bessata zaaridi essana.","poem":2},{"text":"Enti daro yeletethaafe kase laaletidi","poem":1},{"text":"onida katamata zaaridi keexana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Allaga asati hinte dorsa wudiya heemmana;","poem":1},{"text":"imathati hinte gadiya goyana","poem":2},{"lineBreak":true},{"text":"enti hinte woyne gadiya naagana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Asay hintena, “Godaa kahinetanne","poem":1},{"text":"nu Xoossaa oosanchota” yaagidi xeegana.","poem":2},{"text":"Hinte kawotethata duretetha maana;","poem":1},{"text":"enta shaluwan hinte nashetana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ta asay banta yeella gisho nam7u kushe ekana;","poem":1},{"text":"banta kawusha gisho laatan ufaytana.","poem":2},{"text":"Hessa gisho, hinte enta biittan dako laattana;","poem":1},{"text":"hinte ufaysay merinaa ufaysi gidana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Taani, Goday suure pirda dosayis;","poem":1},{"text":"bonqenne iita ooso ixayis.","poem":2},{"text":"Taani tuma enta oosuwa gatiya qanxana;","poem":1},{"text":"Taani entara merinaw caaqana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Enta kochati kawotethata giddon,","poem":1},{"text":"enta nayti dereta giddon eretana;","poem":2},{"lineBreak":true},{"text":"enta be7ida ubbay taani, Goday,","poem":2},{"lineBreak":true},{"text":"enta anjida asi gideysa erana.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Taani Godan daro ufaytayis;","poem":1},{"text":"ta shempiya ta Xoossan hashshu gawusu.","poem":2},{"text":"Ekeysi ba huuphen kallacha wotheysada,","poem":1},{"text":"geliyara bana alleeqiseysada,","poem":2},{"text":"I tana atotetha ma7o mayzis;","poem":1},{"text":"xillotethi afila bollara gujis.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Biittafe mithi maati doleysada,","poem":1},{"text":"gadey tokidaba dicheysada,","poem":2},{"text":"Ubbaa Haariya Goday xillotethinne","poem":1},{"text":"galata kawotetha ubbaa sinthan purcisana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/60.json","previousChapterAudioLinks":{},"numberOfVerses":11}