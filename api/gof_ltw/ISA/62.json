biittiyaka azini de7iyaro gidana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Panthi geela7o ekeysada,","poem":1},{"text":"ne nayti nena machana.","poem":2},{"text":"Ekeysi geliyarin ufayteysada,","poem":1},{"text":"ne Xoossay nenan ufaytana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Neno Yerusalaame, ne dirsa gimbiya bolla","poem":1},{"text":"wocheyisata taani wothas;","poem":2},{"lineBreak":true},{"text":"enti gallasinne qamma si77i gookona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hinteno, Godaa qofiseysato,","poem":1},{"text":"I, Yerusalaame keexana gakanawunne","poem":2},{"lineBreak":true},{"text":"biitta ubban nashetida katama oothana gakanaw","poem":2},{"lineBreak":true},{"text":"hinteka shempopite; iyaka shempisopite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Goday ba ushacha kushiyaninne","poem":1},{"text":"ba wolqaama qesiyan haysada yaagidi caaqis:","poem":2},{"text":"“Taani nam7antho hinte katha","poem":1},{"text":"hinte morketi maana mela oothike.","poem":2},{"text":"Hinte daaburida hinte woyne ushsha","poem":1},{"text":"allagati uyokona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Shin banta kathaa cakidaysati","poem":1},{"text":"midi Godaa galatana;","poem":2},{"lineBreak":true},{"text":"woyne maxeysati ta keethaa dabaaban uyana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Aadhite! Pengera keyidi biite!","poem":1},{"text":"Asaas oge giigisite! Wogga oge kessite.","poem":2},{"text":"Shuchaa diggite;","poem":1},{"text":"kawotethati ogiya demmana mela malla essite.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Goday sa7a gaxas","poem":1},{"text":"haysada yaagidi awaajis:","poem":2},{"text":"‘Xiyoone asaas haysada yaagite;","poem":1},{"text":"heko, hintena Ashsheysi gakis!","poem":2},{"text":"Iya gatey iyara de7ees;","poem":1},{"text":"I immiya woytoy iya sinthan de7ees’","poem":2},"yaagite."]},{"type":"verse","number":12,"content":[{"text":"Hinte, ‘Goday Wozida Geeshsha asata’","poem":1},{"text":"geetetidi xeegetana.","poem":2},{"text":"Yerusalaamey, ‘Koyetiyaronne","poem":1},{"text":"Yegeta Attaboona Katamiw’ ” geetetana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}