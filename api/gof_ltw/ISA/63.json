{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":63,"content":[{"type":"heading","content":["Xoossa Pirda Gallas"]},{"type":"verse","number":1,"content":[{"text":"Edoome biittan, Baasora katamaape","poem":1},{"text":"zo7o ma7o ma7idi yey haysi oonee?","poem":2},{"text":"Boncho ma7o ma7idi","poem":1},{"text":"ba wolqaa minotethan sinthe hordofey oonee?","poem":2},{"text":"“Xillo odeteynne","poem":1},{"text":"ashshiya wolqi de7ey tana”","poem":2},"yaagees Goday."]},{"type":"verse","number":2,"content":[{"text":"Woyne gum7iyason woyne yedhiya asa ma7oda","poem":1},{"text":"ne ma7oy ayis zo77idee?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Taani woyne gum7iyason woyniya tarka yedhas;","poem":1},{"text":"kawotethatape issi asika taara baawa.","poem":2},{"text":"Taani enta ta hanquwan yedhas;","poem":1},{"text":"ta yiluwan enta dirxerethas.","poem":2},{"text":"Enta suuthay ta ma7uwa bolla dharcetin,","poem":1},{"text":"ta ma7o ubbay iitis.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taani ta asaa woziya gallasaynne","poem":1},{"text":"enta morketa halo keyiya laythay gakis.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Taani be7as,","poem":1},{"text":"shin tana maaddiya issi asika demmabike;","poem":2},{"lineBreak":true},{"text":"maaddey dhayida gisho, taani malaaletas.","poem":2},{"text":"Hessa gisho, ta qesey taw atotethi ehis;","poem":1},{"text":"ta hanqoy tana maaddis.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taani ta hanquwan kawotethata yedhas;","poem":1},{"text":"ta yiluwan enta dirxerethas;","poem":2},{"lineBreak":true},{"text":"enta suuthaa biittan gussas” yaagees Goday.","poem":2}]},{"type":"heading","content":["Woosanne Galata"]},{"type":"verse","number":7,"content":["Goday nuus oothida ooso ubbaa,",{"text":"Goday ba maarotethaaninne ba qadhiyan","poem":2},{"text":"Isra7eele asaas oothida lo77o ooso ubbaanne","poem":1},{"text":"iya sunthay galatetana mela","poem":2},{"lineBreak":true},{"text":"bessida keehatetha ubbaa taani odana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"I, “Enti tuma ta asenne ta na7a gidiya gisho,","poem":1},{"text":"taw wordotokona” yaagis.","poem":2},{"lineBreak":true},{"text":"Hessa gisho, I enta ashsheysa gidis.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Enta waaye ubbaa I waayetis;","poem":1},{"text":"iya Sinthaa Kiitanchoy enta ashshis.","poem":2},{"text":"I enta ba siiquwaninne ba maarotan wozis;","poem":1},{"text":"kase aadhida wodeta ubban I enta tookis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Shin enti makallidosona;","poem":1},{"text":"iya Geeshsha Ayyaana azzanthidosona.","poem":2},{"text":"Hessa gisho, I simmidi,","poem":1},{"text":"entaw morke gidis; enta olis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Hessafe guye asay benibaanne","poem":1},{"text":"ba aylliya Muse wode oothidaba qopidi,","poem":2},{"lineBreak":true},{"text":"haysada yaagidosona:","poem":2},{"text":"“Ba wudiya henthanchotara issife","poem":1},{"text":"abba giddora kanthisida Xoossay awun de7ii?","poem":2},{"text":"He wode ba Geeshsha Ayyaana enta giddon,","poem":1},{"text":"wothida Xoossay ha77i awun de7ii?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Baw merinaa sunthu gidana mela","poem":1},{"text":"enta sinthan haatha shaakidi, ba boncho wolqaama qesey","poem":2},{"lineBreak":true},{"text":"Muses ushacha kushe gidana mela kiittidaysi awun de7ii?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Biitta bollara pari biyada enti dhubetonna","poem":1},{"text":"ciimmo haatha giddora pinthidaysi awun de7ii?”","poem":2},"yaagidosona."]},{"type":"verse","number":14,"content":["Zangaara wodhiya meheda,",{"text":"Godaa Ayyaanay entaw shempo immis.","poem":2},{"text":"Ne sunthay bonchetana mela","poem":1},{"text":"hessada oothada ne asaa kaalethadasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Abeeti Godaw, salora duge xeella;","poem":1},{"text":"neeni de7iya geeshshinne","poem":2},{"lineBreak":true},{"text":"boncho gidida araatape be7a.","poem":2},{"text":"Ne qinaateynne ne wolqay anee?","poem":1},{"text":"Ne maarotaynne ne qadhey nuupe haakis.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Abrahaamey nuna eronna ixikoka,","poem":1},{"text":"Yayqoobi nuna akeekona ixikoka,","poem":2},{"lineBreak":true},{"text":"abeeti Godaw, neeni nu aawa;","poem":2},{"lineBreak":true},{"text":"benipe doomidi, ne sunthay nuna wozeysa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Abeeti Godaw, nuuni ne ogiyape","poem":1},{"text":"dhayanaadanne new yayyonnaada","poem":2},{"lineBreak":true},{"text":"nu wozanaa ayis muumisadii?","poem":2},{"text":"Godaw, ne aylleta gisho,","poem":1},{"text":"ne laata gidida kochata gisho,","poem":2},{"lineBreak":true},{"text":"nuuko simma.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ne geeshsha asay","poem":1},{"text":"ne keetha guutha wodes laattidosona;","poem":2},{"lineBreak":true},{"text":"shin ha77i nu morketi iya yedhidosona.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nuuni benipe nebaa;","poem":1},{"text":"shin enta neeni haarabaaka;","poem":2},{"lineBreak":true},{"text":"ne sunthanka enti xeegetibookona.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/62.json","previousChapterAudioLinks":{},"numberOfVerses":19}