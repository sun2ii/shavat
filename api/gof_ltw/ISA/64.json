{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":64,"content":[{"type":"verse","number":1,"content":["Abeeti Godaw, salota daakada duge wodha;",{"text":"dereti ne sinthan kokoro.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tami eexidi haathe pentiseysada duge wodhada,","poem":1},{"text":"ne suntha ne morketa erisa;","poem":2},{"lineBreak":true},{"text":"kawotethataka ne sinthan kokorsa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kase nuuni naagiboonna malaatata","poem":1},{"text":"neeni oothida wode wodhadasa;","poem":2},{"lineBreak":true},{"text":"dereti ne sinthan kokoridosona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Benipe doomidi, nena ammanetidi,","poem":1},{"text":"naageysatas malaatata oothiday neepe attishin,","poem":2},{"lineBreak":true},{"text":"hara Xoossi asa haythi si7ibeenna;","poem":2},{"lineBreak":true},{"text":"asa ayfey be7ibeenna.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ufaytidi xillotethi ootheysatanne","poem":1},{"text":"ne ogiya qopeyisata neeni maaddadasa.","poem":2},{"text":"Shin nuuni nagara ooso aggonna ixida wode","poem":1},{"text":"neeni hanqetadasa; nuuni waanidi attanee?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nuuni ubbay tuna asi gidida;","poem":1},{"text":"nu xillotetha ooso ubbay tuna curqa mela.","poem":2},{"text":"Nu ubbay boncoda qoletida;","poem":1},{"text":"nu nagaray nuna carkoda pitidi efis.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Neeni ne sinthaa nuupe genthadasa;","poem":1},{"text":"nu nagaray nuna dhaysana mela aggadasa.","poem":2},{"text":"Ne sunthaa xeegey deenna;","poem":1},{"text":"nena minthidi oykanaw koyey baawa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gidoshin, abeeti Godaw, neeni nu aawa;","poem":1},{"text":"nuuni urqa; ne urqa medhadasa;","poem":2},{"lineBreak":true},{"text":"nuuni ubbay ne kushen medhetida.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abeeti Godaw, daro hanqetofa;","poem":1},{"text":"nu nagaraa merinaw qopofa.","poem":2},{"text":"Nuuni ubbay ne ase gidiya gisho,","poem":1},{"text":"nuna be7a.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne geeshsha katamati mela biitta gididosona;","poem":1},{"text":"Xiyoone katamay mela biitta,","poem":2},{"lineBreak":true},{"text":"Yerusalaamey baysa gidis.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nu aawati iyan nena galatida geeshshinne","poem":1},{"text":"lo77o gidida nu xoossa keethay taman xuugetis;","poem":2},{"lineBreak":true},{"text":"nu lo77o bessa ubbay laaletis.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abeeti Godaw, neeni haysa ubbaa be7ashe si77i gaanee?","poem":1},{"text":"ha ubbay hanin, nuuko simmikii?","poem":2},{"lineBreak":true},{"text":"Neeni si77i gada zawi bayna seeranee?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/63.json","previousChapterAudioLinks":{},"numberOfVerses":12}