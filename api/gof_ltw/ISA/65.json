{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":65,"content":[{"type":"heading","content":["Pirdanne Atotethi"]},{"type":"verse","number":1,"content":[{"text":"“Tana oychiboonaysatas qoncas;","poem":1},{"text":"tana koyboonaysatas bentas.","poem":2},{"text":"Ta sunthaa xeegiboonna kawotethas,","poem":1},{"text":"‘Yee! Yee!’ yaagada koyas.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Banta qofaa kaallidi,","poem":1},{"text":"lo77o gidonna ogiyan hemetiya geella asaas","poem":2},{"lineBreak":true},{"text":"gallas kumethi ta kushiya miccas.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ha asay, ta sinthan atakilte gaden yarshishenne","poem":1},{"text":"xuube yarsho bessan ixaane cuyisishe","poem":2},{"lineBreak":true},{"text":"tana ubba wode hanqethoosona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Enti duufon utteyisata, geema bessan aqeyisata,","poem":1},{"text":"guduntho asho meyisata; enta xaaruwan,","poem":2},{"lineBreak":true},{"text":"tuna asho cambi de7eyisata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Enti, ‘New yan de7a;","poem":1},{"text":"taani neepe geeshshi gidiya gisho","poem":2},{"lineBreak":true},{"text":"taako shiiqopa!’ yaagosona.","poem":2},{"text":"Hessa mela asati siidhe tucciya cuyaa mela;","poem":1},{"text":"gallas kumethi eexiya tama mela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Heko, ta sinthan xaafeti uttis;","poem":1},{"text":"taani entaw zaarana si77i giike;","poem":2},{"lineBreak":true},{"text":"enta seeranaw dendas.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Taani enta nagaraanne enta aawata nagaraa","poem":1},{"text":"acuwa issife entaw qanxana.","poem":2},{"text":"Enti deriya bolla ixaane cuyisidosona;","poem":1},{"text":"zumata bolla tana cayidosona.","poem":2},{"text":"Enti kase oothida oosuwa acuwa","poem":1},{"text":"taani entaw qanxana” yaagees Goday.","poem":2}]},{"type":"verse","number":8,"content":["Goday yaagees:",{"text":"“Iita woyne susa giddon","poem":1},{"text":"lo77o woyne ayfey de7eysada,","poem":2},{"lineBreak":true},{"text":"asay, ‘Iya giddon lo77o woyne ayfey de7iya gisho","poem":2},{"lineBreak":true},{"text":"ubbaa wora holopite’ geysa mela,","poem":2},{"text":"Taani ta aylleta haysada oothana;","poem":1},{"text":"taani enta ubbaa dhaysike.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Taani Yayqoobape koche,","poem":1},{"lineBreak":true},{"text":"Yihudape ta deriya laatteyisata kessana;","poem":1},{"text":"ta dooridaysati iya laattana; ta aylleti yan daana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tana minthidi koyiya ta asaas,","poem":1},{"text":"Saaroni dorsa wudey heemetiya bessi gidana;","poem":2},{"lineBreak":true},{"text":"Akoora zangaaray miiza wudey allatiya bessi gidana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Shin hinteno, Godaa aggidi,","poem":1},{"text":"ta geeshsha zumaa dogidaysato,","poem":2},{"lineBreak":true},{"text":"‘Qaada’ geetetiya eeqas gibira giigiseysato,","poem":2},{"lineBreak":true},{"text":"hinte wursethaa eranaw","poem":2},{"lineBreak":true},{"text":"‘Saama’ geetetiya eeqas walaha woyne","poem":2},{"lineBreak":true},{"text":"ushsha wancan kuntheysato,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Taani hinte wursethaa mashshas aathada immana;","poem":1},{"text":"hinte ubbay goyretanaw hokana.","poem":2},{"text":"Taani hintena xeegin koybeketa;","poem":1},{"text":"odisin si7ibeeketa.","poem":2},{"text":"Hinte ta sinthan iitabaa oothideta;","poem":1},{"text":"taani dosonnaba doorideta.”","poem":2}]},{"type":"verse","number":13,"content":["Ubbaa Haariya Goday yaagees:",{"text":"“Ta aylleti maana, shin hinte koshatana;","poem":2},{"lineBreak":true},{"text":"ta aylleti uyana, shin hinte saamotana;","poem":2},{"lineBreak":true},{"text":"ta aylleti ufaytana, shin hinte yeellatana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ta aylleti wozanape ufaytidi yexana,","poem":1},{"text":"shin hinte wozanape kayotana;","poem":2},{"lineBreak":true},{"text":"hinte ayyaanay meqida gisho,","poem":2},{"lineBreak":true},{"text":"hinte zeleelidi yeekana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hinte, hinte sunthaa ta dooretida deriyas","poem":1},{"text":"qangethi oothidi immana.","poem":2},{"text":"Ubbaa Haariya Goday hintena wodhana;","poem":1},{"text":"shin I ba aylleta dumma sunthan xeegana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kase metoti dogetida gishonne","poem":1},{"text":"ta ayfiya sinthafe geemmida gisho","poem":2},{"lineBreak":true},{"text":"he biittan anjo koyiya ubbay","poem":2},{"lineBreak":true},{"text":"tuma Xoossaa sunthan woossana.","poem":2},{"text":"He biittan caaqo caaqiya ubbay","poem":1},{"text":"tuma Xoossaa sunthan caaqana.","poem":2}]},{"type":"heading","content":["Ooratha Salonne Sa7a"]},{"type":"verse","number":17,"content":["“Heko, taani ooratha salotanne",{"text":"ooratha sa7a medhana;","poem":2},{"lineBreak":true},{"text":"kaseba ubbay hassayetenna; qofetenna.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Shin taani medhiyaban","poem":1},{"text":"merinaw ufaytitenne hashshu giite.","poem":2},{"text":"Taani Yerusalaame ufaysasinne","poem":1},{"text":"I asaaka galatan kumidaysata oothada medhana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Taani Yerusalaamen ufaytana;","poem":1},{"text":"ta asan hashshu gaana.","poem":2},{"text":"Hizape guye yeehoynne","poem":1},{"text":"un7a waasoy yan si7etenna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Yerusalaamen hizape guye,","poem":1},{"text":"guutha wode de7idi hayqiya na7i,","poem":2},{"lineBreak":true},{"text":"ba laytha wursonna hayqiya cima asi deenna.","poem":2},{"text":"Xeetu laythara hayqiya uray,","poem":1},{"text":"na7atethan hayqis geetetana;","poem":2},{"lineBreak":true},{"text":"xeetu laythi gathonna hayqey,","poem":2},{"lineBreak":true},{"text":"baadetida asada taybetana.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"He wode asay keethe keexidi daana;","poem":1},{"text":"woyne tokidi iya ayfiya maana.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Enti keexin hari deenna;","poem":1},{"text":"enti tokin hari meenna.","poem":2},{"text":"Ta asaa laythay mitha laythada aduqana;","poem":1},{"text":"taani dooridaysati adussa wode","poem":2},{"lineBreak":true},{"text":"banta kushe oosuwan ufaytana.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Enti coo daaburokona","poem":1},{"text":"qaadi bayna na7a yelokona.","poem":2},{"text":"Enti banta naytara","poem":1},{"text":"Godan anjetida kochata gidana.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Enti tana xeeganaape sinthe,","poem":1},{"text":"taani entaw koyana;","poem":2},{"lineBreak":true},{"text":"enti buroo haasayonna de7ishin","poem":2},{"lineBreak":true},{"text":"taani enta si7ana.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Suudhumeynne dorsa urgey issife heemetana;","poem":1},{"text":"gaammoy boorada kale maana;","poem":2},{"lineBreak":true},{"text":"baani shooshas kathi gidana.","poem":2},{"text":"He wode ta geeshsha zumaa bolla","poem":1},{"text":"enti qohetokonanne dhayokona”","poem":2},"yaagees Godaa Xoossay."]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ISA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/64.json","previousChapterAudioLinks":{},"numberOfVerses":25}