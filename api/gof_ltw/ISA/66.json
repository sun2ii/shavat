{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"ISA","translationId":"gof_ltw","name":"Isayaasa Maxaafa","commonName":"Isayaasa Maxaafa","title":"Isayaasa Maxaafa","order":23,"numberOfChapters":66,"sha256":"23701bb87afa65479129e61a32cd6071281419523fb085e0299ea0ff91a582e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/gof_ltw/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":66,"content":[{"type":"heading","content":["Pirdanne Ufaysi"]},{"type":"verse","number":1,"content":[{"text":"Goday yaagees;","poem":1},{"text":"Saloy ta araata,","poem":2},{"lineBreak":true},{"text":"sa7i ta tohoy yedhiya besse.","poem":2},{"text":"Yaatin hinte taw keexiya keethay,","poem":1},{"text":"ay mela keethee?","poem":2},{"lineBreak":true},{"text":"Ta shempana bessay awusee?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Haysa ubbaa ta kushey oothis;","poem":1},{"text":"entika hanidosona.","poem":2},{"text":"Shin taani bana ziqi oothiya uraa,","poem":1},{"text":"ba ayyaanan meqida uraanne","poem":2},{"lineBreak":true},{"text":"ta qaalan kokoriya ura xeellana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Korma yarshey ase wodhiya asa mela;","poem":1},{"text":"urge dorsi yarshey kana yarshiya asa mela;","poem":2},{"lineBreak":true},{"text":"katha yarsho yarshey,","poem":2},{"lineBreak":true},{"text":"guduntho suuthi yarshiya asa mela;","poem":2},{"lineBreak":true},{"text":"qofiso ixaane cuyisey eeqa goyinniya asa mela.","poem":2},{"text":"Asa ubbay baw injetiya oge dooridosona;","poem":1},{"text":"enta shempoy enta tunatethan ufaytees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hessa gisho, taani enta metos aatha immana;","poem":1},{"text":"enti yayyidaba enta bolla ehana.","poem":2},{"text":"Taani xeegida wode oonika koybeenna;","poem":1},{"text":"taani odiya wode oonika si7ibeenna.","poem":2},{"text":"Enti ta sinthan iitabaa oothidosona;","poem":1},{"text":"tana ufaysonnaba dooridosona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Hinteno, Godaa qaalas kokoreysato","poem":1},{"text":"iya qaala si7ite:","poem":2},{"text":"“Hintena ixiya hinte ishati, ta sunthaa gisho,","poem":1},{"text":"hintena kureysati, ‘Hinte ufaytin nuuni be7ana mela","poem":2},{"lineBreak":true},{"text":"ane Goday boncheto’ ” yaagidosona;","poem":2},{"lineBreak":true},{"text":"shin enti yeellatana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Katamaape yaa waasuwa si7ite;","poem":1},{"text":"xoossa keethafe keyiya girsaa si7ite.","poem":2},{"text":"He girsay ba morketas enta oosuwada","poem":1},{"text":"kushe zaariya Godaa girsaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Iqetonna na7a yeliya maccas de7ii?","poem":1},{"text":"Bannakonna adde na7a yeliya maccas de7ii?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Haysa melaba oone si7iday?","poem":1},{"text":"Hessa melaba oone be7iday?","poem":2},{"text":"Issi derey issi gallas yeletanaw danda7iyee?","poem":1},{"text":"issi kawotethi qiphi zaaron medhetiyee?","poem":2},{"text":"Xiyooney buroo iqethi oykonna,","poem":1},{"text":"ellesada ba nayta yelasu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yelana wode gathiya taani","poem":1},{"text":"enti yelanaada oothikinaayee?","poem":2},{"text":"Yelanaada oothiya taani","poem":1},{"text":"yeliya ulo gordaynaayee?","poem":2},{"lineBreak":true},{"text":"Haysa giday tana, Godaa, ne Xoossaa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hinteno Yerusalaamo dosiya ubbaw, iira ufaytite;","poem":1},{"text":"I gisho ufaysan noocu giite.","poem":2},{"text":"Hinteno iw yeekiya ubbaw,","poem":1},{"text":"iira ufaytite.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hinte, iya minthethiya dhantha dhammidi kallana;","poem":1},{"text":"I daro bonchuwafe loythi uyidi, ufaytana.”","poem":2}]},{"type":"verse","number":12,"content":["Goday yaagees;",{"text":"“Taani iw sarotethaa shaafada darsana;","poem":1},{"text":"iw kawotethata duretetha kixa shaafada ehana.","poem":2},{"text":"Hinte hessa dhammana; I hashiyan tooketana;","poem":1},{"text":"I ki7on uttidi baalotana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Aayiya ba na7a minthetheysada","poem":1},{"text":"taani hintena minthethenna;","poem":2},{"lineBreak":true},{"text":"hinte Yerusalaamen minettana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hessa hinte be7iya wode hinte wozanay ufaytana;","poem":1},{"text":"hinte meqethay maata mela aacana.","poem":2},{"text":"Godaa kushey iya aylleta bolla de7eysin","poem":1},{"text":"iya hanqoy iya morketa bolla de7eysi eretana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Heko, Goday tamara yaana;","poem":1},{"text":"iya para gaareti gote mela.","poem":2},{"text":"Ba sheniya hanqon;","poem":1},{"text":"ba seeraka tama lacon qoncisees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Goday asho ma7ida ubbaa","poem":1},{"text":"tamaninne mashshan pirdana;","poem":2},{"lineBreak":true},{"text":"daroti Godaa mashshan hayqana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Banta eeqa goyinnanaw atakilte gade baanaw,","poem":1},{"text":"bantana dummayeysatinne geeshsheysati;","poem":2},{"lineBreak":true},{"text":"guduntho, ecerenne hara tunabata meyisata giddofe","poem":2},{"lineBreak":true},{"text":"issuwa kaallidi beysati ubbay dhayana.","poem":2}]},{"type":"verse","number":18,"content":["“Taani enta oosuwanne enta qofaa eriya gisho,",{"text":"kawotethatanne dumma dumma doonan odeteyisata,","poem":2},{"lineBreak":true},{"text":"issife shiishana; enti shiiqidi, ta bonchuwa be7ana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Taani enta giddon malaata oothana;","poem":1},{"text":"entafe attidaysata giddofe","poem":2},{"lineBreak":true},{"text":"ta gitatetha si7iboonanne","poem":2},{"lineBreak":true},{"text":"ta bonchuwa be7iboona kawotethatako,","poem":2},{"text":"Tarsesako, Liibeko, Liideko, Tubaalako,","poem":1},{"text":"Yawaanakonne yuushoy abban teqetidi haaho biittatako kiittana;","poem":2},{"lineBreak":true},{"text":"enti ta bonchuwa kawotethata giddon awaajana.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Isra7eele asay katha yarshuwa","poem":1},{"text":"geeshsha miishen wothidi xoossa keethi eheysada,","poem":2},{"lineBreak":true},{"text":"enti hinte ishata ubbaa kawotethata giddofe,","poem":2},{"lineBreak":true},{"text":"paratan, para gaaretan, gimaletan, baqulotaninne","poem":2},{"lineBreak":true},{"text":"caane gaaretan utisidi, Godaas imo oothidi","poem":2},{"lineBreak":true},{"text":"ta geeshsha zumaa bolla Yerusalaame ehana.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Entafe issota issota kahinenne Leewe oothana”","poem":1},"yaagees Goday."]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Taani medhida ooratha salotinne","poem":1},{"text":"ooratha sa7i ta sinthan minnidi de7eysada,","poem":2},{"lineBreak":true},{"text":"hinte kochaynne hinte sunthay minnidi daana.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ageena xeerope bidi ageena xeero gakanaw,","poem":1},{"text":"Sambaatape bidi Sambaata gakanaw","poem":2},{"lineBreak":true},{"text":"asa ubbay ta sinthan goyinnanaw yaana.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Enti keyidi bishe,","poem":1},{"text":"ta bolla makallida asaa aha be7ana.","poem":2},{"text":"Enta miya guxuney hayqenna;","poem":1},{"text":"enta xuuggiya tamay to7enna;","poem":2},{"lineBreak":true},{"text":"enti asa ubbaas shaatiyaba gidana”","poem":2},"yaagees Goday."]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/ISA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JER/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ISA/65.json","previousChapterAudioLinks":{},"numberOfVerses":24}