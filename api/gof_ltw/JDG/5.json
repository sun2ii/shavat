{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JDG","translationId":"gof_ltw","name":"Ayseysata Maxaafa","commonName":"Ayseysata Maxaafa","title":"Ayseysata Maxaafa","order":7,"numberOfChapters":21,"sha256":"9723ebdf43b6a8ef38faf15f2a9cd32ed5f2fcbe37903a3b8963fd3a4a6369ad","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/gof_ltw/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":5,"content":[{"type":"heading","content":["Xoono Gerersi"]},{"type":"verse","number":1,"content":["He gallas Dibooranne Abinooma na7ay Baaraqi ha mazmuriya yexidosona."]},{"type":"verse","number":2,"content":[{"text":"Halaqati Isra7eele asaa kaalethida gisho,","poem":1},{"text":"asayka bana aathidi immida gisho,","poem":2},{"lineBreak":true},{"text":"Godaa galatite.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hinteno kawoto, si7ite;","poem":1},{"text":"Hinteno haareysato, hayzite;","poem":2},{"text":"Taani Godaas yexana.","poem":1},{"text":"Isra7eele Xoossaa galatana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Abeeti Godaw, neeni Sayre zumaape dendiya wode,","poem":1},{"text":"Edoome biittafe ne keyiya wode,","poem":2},{"lineBreak":true},{"text":"biitti qaaxis; Salope iri bukis;","poem":2},{"lineBreak":true},{"text":"haathi shaarape goggis.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Siina Godaa,","poem":1},{"text":"Isra7eele Xoossaa sinthan,","poem":2},{"lineBreak":true},{"text":"dereti qaaxidosona;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Anaata na7aa Samgaara wodenne","poem":1},{"text":"Ya7eela wode ogey dogetis;","poem":2},{"lineBreak":true},{"text":"zal7anchoti yuusho ogera boosona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Diboori Isra7eele asaas,","poem":1},{"text":"aayo gidada dendana gakanaw,","poem":2},{"lineBreak":true},{"text":"Isra7eele gutati baysatidosona;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Isra7eele asay allaga xoossata doorida wode,","poem":1},{"text":"biitta bolla oli dendis.","poem":2},{"text":"Oytamu mukulu Isra7eele olanchota giddon,","poem":1},{"text":"issi gondalley woyko issi toori bentibeenna.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ta wozanay Isra7eele toora moconatara,","poem":1},{"text":"Asaa giddofe dosan bantana aathidi,","poem":2},{"lineBreak":true},{"text":"immidaysatara de7ees.","poem":2},{"text":"Godaa galatite;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hinteno, bootha hareta toggeysato,","poem":1},{"text":"lo77o gilaasiya bolla uttidi dincaketeysato,","poem":2},{"lineBreak":true},{"text":"oge gaxara hemeteysato haysa si7ite.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Haatha ollata matan,","poem":1},{"text":"shiiqida asaa yetha si7ite.","poem":2},{"text":"Enti Godaa xoonuwa yexoosona;","poem":1},{"text":"Isra7eele asaa xoonuwa odoosona.","poem":2},{"text":"Hessafe guye, Godaa asay","poem":1},{"text":"katamaa pengetako wodhidosona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Diboora, Denda! Denda!","poem":1},{"text":"Denda! Dendada mazmure yexa.","poem":2},{"text":"Abinooma na7aw, Baaraqa, denda!","poem":1},{"text":"ne di77idabaa ekada ya.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hessafe guye, attida asati,","poem":1},{"text":"halaqatako wodhidosona.","poem":2},{"text":"Godaa asati oletanaw giigidi","poem":1},{"text":"Baaraqako yidosona.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Amaaleqa kochati beni de7ida bessan","poem":1},{"text":"de7iya Efreema asati yidosona.","poem":2},{"lineBreak":true},{"text":"Biniyaame asati enta kaallidosona.","poem":2},{"text":"Makirape halaqati,","poem":1},{"text":"Zabloonape kawotetha","poem":2},{"lineBreak":true},{"text":"xam7a oykeysati yidosona.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yisakoora halaqati Diboorara de7oosona;","poem":1},{"text":"ee, Yisakoore asay Baaraqara yidosona;","poem":2},{"lineBreak":true},{"text":"enti iya kaallidi, zangaara gelidosona.","poem":2},{"text":"Shin Robeela kochati qofan shaaketidi,","poem":1},{"text":"banta wozanan heettidosona.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Enti ayis attidonaa?","poem":1},{"text":"Dorsata heemmanaseyee?","poem":2},{"text":"Robeela kochati qofan shaaketidi,","poem":1},{"text":"banta wozanan heettidosona.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Gaade kochati Yordaanose pinthan attis,","poem":1},{"text":"Daana kochati markabetan attidosona.","poem":2},{"text":"Aseera kochati banta de7iyason,","poem":1},{"text":"Abbaa gaxan attidosona.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Zabloona kochati,","poem":1},{"text":"bantana hayqos aathidi immidosona.","poem":2},{"text":"Niftaaleme kochati,","poem":1},{"text":"toora denban bantana aathidi immidosona.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Magido pultota matan Tanakan,","poem":1},{"text":"kawoti oletidosona.","poem":2},{"text":"Kanaane kawoti yan oletidi,","poem":1},{"text":"bira woyko haraba di77ibookona.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Salope xoolintoti oletidosona;","poem":1},{"text":"banta yuushan Sisaara olidosona.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Qisoona shaafay enta efis;","poem":1},{"text":"benipe de7iya Qisooni enta shokis.","poem":2},{"text":"Ta shempe, minna; sinthe hordofa.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Parati adarsishe yidosona,","poem":1},{"text":"banta tohuwan biitta giirsoosona.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Godaa kiitanchoy haysada yaagis;","poem":1},{"text":"“Merooza baaddite!","poem":2},{"lineBreak":true},{"text":"Yan de7iya asaa iissidi baaddite!","poem":2},{"text":"Enti Godaa maaddanaw yibookona;","poem":1},{"text":"iya wolqaama morketa olanaw keybookona.”","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Qeena asi gidida Hebeera machiya,","poem":1},{"text":"Ya7eeli maccasa ubbaafe anjetidaaro gido.","poem":2},{"text":"Dunkaanen de7iya maccasa ubbaafe,","poem":1},{"text":"iya anjetidaaro gido.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Sisaari iyo haathe oychin maathi immasu;","poem":1},{"text":"lo77o ogoron meqida maathi ehasu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ba haddirsa kushen dunkaane dhishe,","poem":1},{"text":"ba ushacha kushen","poem":2},{"lineBreak":true},{"text":"oosanchota naariqa oykasu.","poem":2},{"text":"Sisaara huuphen dhishasu;","poem":1},{"text":"iya haytha karera kantha kessasu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"I tohuwa garsan kundis;","poem":1},{"text":"I tohuwa matan zohetis.","poem":2},{"text":"I tohuwa garsan kundis;","poem":1},{"text":"he kundida bessan hayqis.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Sisaara aayiya maskootera kare xeellasu;","poem":1},{"text":"“Ta na7aa para gaarey ayis gam7idee?","poem":2},{"text":"Parati ayis ellesidi simmibokona?”","poem":1},{"text":"yaagada bana oychasu.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"I cinca maccasati I oysha zaaridosona;","poem":1},{"text":"shin iya ba qofan zaara zaarada yaagasu.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"“Enti di77o demmidi shaaketonna aggokona;","poem":1},{"text":"Issi issi addes issi geela7oy woyko","poem":2},{"lineBreak":true},{"text":"nam7u geela7oti gakonna aggenna.","poem":2},{"text":"Enti Sisaaras lo77iya ma7o immana;","poem":1},{"text":"tawka qoodhen ma7iya,","poem":2},{"lineBreak":true},{"text":"alleeqetida ma7o ehana” yaagasu.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Abeeti Godaw, ne morketi ubbay haysada hayqo;","poem":1},{"text":"shin nena doseysati wonta xalqeda phoolo.","poem":2},"Hessafe guye, biittay oytamu laythi wopu gidi de7is."]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}