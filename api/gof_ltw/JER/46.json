{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JER","translationId":"gof_ltw","name":"Ermiyaasa Maxaafa","commonName":"Ermiyaasa Maxaafa","title":"Ermiyaasa Maxaafa","order":24,"numberOfChapters":52,"sha256":"3f392cef2b7699e202e9e7d123f664e7130cf3b13192f4af500fd6b1103b2ee3","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gof_ltw/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":46,"content":[{"type":"heading","content":["Gibxes Odetida Tinbite"]},{"type":"verse","number":1,"content":["Kawotethatabaa Goday Ermiyaasas odida qaalay haysa."]},{"type":"verse","number":2,"content":["Iyo7aasa na7ay Iyo7aqeemi Yihudan kawotida oyddantho laythan, Efraxiisa shaafa matan, Karkamisha geetetiya bessan, Babiloone kawoy Nabukadanaxoori xoonida Gibxe kawa Nako olanchotabaa Goday haysada yaagees."]},{"type":"verse","number":3,"content":[{"text":"Hinte tooranne gondalle giigisite;","poem":1},{"text":"olas keyite.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hinte parata bixaalidi toggite;","poem":1},{"text":"hinte huuphiyan birata barneexa wothite.","poem":2},{"text":"Hinte bessaa bessaa oykite;","poem":1},{"text":"hinte toora leefite;","poem":2},{"lineBreak":true},{"text":"hinte ola ma7uwa ma7ite.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Shin haysi ta be7ey aybee?","poem":1},{"text":"enti yayyidi guye simmidosona.","poem":2},{"text":"Wolqaamati xoonetidosona;","poem":1},{"text":"guye xeellonna baqatidosona;","poem":2},{"lineBreak":true},{"text":"Enta yuusho ubban dagami de7ees”","poem":2},"yaagees Goday."]},{"type":"verse","number":6,"content":[{"text":"Eesoteysi kessi ekenna;","poem":1},{"text":"minoyka attanaw danda7enna.","poem":2},{"text":"Pudeha baggan Efraxiisa shaafa matan,","poem":1},{"text":"ubbay dhubetidi kundidosona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Haysi Nayle shaafa kixada dendey,","poem":1},{"text":"di7o haathada goggey oonee?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gibxey Nayle shaafada dendees;","poem":1},{"text":"di7o haathada gupees.","poem":2},{"text":"Gibxey, “Taani kixada, biittan eellana;","poem":1},{"text":"katamatanne iyan de7iya asa ubbaa dhaysana” yaagees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Parato, gupidi keyite;","poem":1},{"text":"para gaareto woxite.","poem":2},{"text":"Gondalle oykida Tophenne Puuxa asaw,","poem":1},{"text":"dongen dukiya Luuda asaw,","poem":2},{"lineBreak":true},{"text":"mino olanchoto, dendidi oletite.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"He gallasay Godaa Ubbaafe Wolqaama Godaa gallas,","poem":1},{"text":"Goday ba morketa bolla halo keyiya gallas.","poem":2},{"text":"Iya mashshay kallana gakanaw enta maana;","poem":1},{"text":"alana gakanaw enta suuthaa uyana.","poem":2},{"text":"Goday, Ubbaafe Wolqaama Xoossay,","poem":1},{"text":"pudeha baggan Efraxiisa shaafa matan,","poem":2},{"lineBreak":true},{"text":"enta yarsho oothidi ekana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Geela7ee, Gibxe macca naatte,","poem":1},{"text":"Galada biitta bada tiyetiya dhale eha.","poem":2},{"text":"Gidoshin, ne coo dhale darsaasape attishin,","poem":1},{"text":"new paxoy baawa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kawotethati ne yeella si7idosona;","poem":1},{"text":"ne yeehoy biitta ubbaa kumana.","poem":2},{"text":"Ne olanchoti issoy issuwan dhubetidi,","poem":1},{"text":"ubbay issife kundidosona.","poem":2}]},{"type":"verse","number":13,"content":["Babiloone kawoy Nabukadanaxoori Gibxe olanaw yaanaysa, Goday nabiya Ermiyaasas odida qaalay haysa:"]},{"type":"verse","number":14,"content":[{"text":"Haysa Gibxen oda;","poem":1},{"text":"Migdoolan, Mempisaninne Xafinaasan awaaja.","poem":2},{"text":"Hinte bessan bessan eqite; giigetite;","poem":1},{"text":"hinte yuushuwan de7iya ubbaa mashshi maana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hinte mino olanchoti ayis kundidee?","poem":1},{"text":"Goday enta sugida gisho gidennee?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Olanchoti dhubetidi kundidosona;","poem":1},{"text":"issoy issuwa, “Dendidi yedhite;","poem":2},{"lineBreak":true},{"text":"morke mashshafe attanaw,","poem":2},{"lineBreak":true},{"text":"nu asaako, nu biitta simmoos” yaagosona.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Enti yan Gibxe kawako,","poem":1},{"text":"“Ba qaada go7etonna coo wursiya odancho” gidi sunthana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“Ubbaafe Wolqaama Godaa” geetetiya","poem":1},{"text":"kawoy haysada yaagees:","poem":2},{"text":"“Taani, ta shempuwan caaqayis;","poem":1},{"text":"dereta giddon Taabore Derey,","poem":2},{"lineBreak":true},{"text":"abba matan de7iya Qarmeloosa Derey,","poem":2},{"lineBreak":true},{"text":"aduqeysada aduqiya morkey hinte bolla yaana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hinteno, Gibxen de7eysato,","poem":1},{"text":"di7etidi baanaw giigite.","poem":2},{"text":"Mempisa katamay laaletidi,","poem":1},{"text":"oonika de7onna mela biitta gidana.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Gibxey lo77o ussa mela;","poem":1},{"text":"shin pudeha bagga biittafe yaa","poem":2},{"lineBreak":true},{"text":"boxiyan iya saxetana.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Miishey cigetin oothiya olanchoti","poem":1},{"text":"modhida wofaano mela.","poem":2},{"text":"Enta dhayo gallasay matida gisho,","poem":1},{"text":"enti seeretiya wodey gakida gisho,","poem":2},{"lineBreak":true},{"text":"enti issife guye simmidi baqatidosona;","poem":2},{"lineBreak":true},{"text":"enti banta bessan eqibookona.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Morkey wolqan sugidi yaa wode,","poem":1},{"text":"Gibxe asay baqatiya shooshada kolxana.","poem":2},{"text":"Morketi mithi qanxiya asada,","poem":1},{"text":"kalta ekidi iya bolla yaana.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Asay sixida wora qeexidi dhayseysada,","poem":1},{"text":"Gibxe asaa qanxidi wursana","poem":2},{"text":"Morketa tayboy boolepe daro;","poem":1},{"text":"enta taybanaw danda7etenna.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Gibxe macca na7iya kawuyana;","poem":1},{"text":"pudeha bagga asaas aadhada imetana.”","poem":2}]},{"type":"verse","number":25,"content":["Ubbaafe Wolqaama Goday, Isra7eele Xoossay haysada yaagees. “Taani Tebisa xoossa Amoone, kawa paarona, Gibxe biittanne Gibxe xoossata, Gibxe kawotanne kawa paarona bolla zempiya ubbaa seerana."]},{"type":"verse","number":26,"content":["Enta shempuwa koyiya Babiloone kawa Nabukadanaxoora kusheninne iya olanchota kushen aathada immana. Hessafe guye, Gibxe biittay kaseysada asi de7iya biitta gidana” yaagees Goday."]},{"type":"verse","number":27,"content":["“Ta aylliyaw, Yayqooba yayyofa;",{"text":"Isra7eele, dagammofa.","poem":2},{"text":"Nena haaho bessafe,","poem":1},{"text":"ne kochay di7etidi bida biittafe ashshana.","poem":2},{"text":"Yayqoobi simmidi, saron wopu gidi daana;","poem":1},{"text":"enta yashisiyabay deenna.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ta aylliyaw, Yayqooba,","poem":1},{"text":"ta neera de7iya gisho, yayyofa.","poem":2},{"text":"Ta nena laallida kawotethata ubbaa dhaysana;","poem":1},{"text":"shin nena dhaysike.","poem":2},{"text":"Ta nena xillo pirdan seerana;","poem":1},{"text":"shin seeri bayna nena coo aggike” yaagees Goday.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JER/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JER/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JER/45.json","previousChapterAudioLinks":{},"numberOfVerses":28}