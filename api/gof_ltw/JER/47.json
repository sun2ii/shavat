{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JER","translationId":"gof_ltw","name":"Ermiyaasa Maxaafa","commonName":"Ermiyaasa Maxaafa","title":"Ermiyaasa Maxaafa","order":24,"numberOfChapters":52,"sha256":"3f392cef2b7699e202e9e7d123f664e7130cf3b13192f4af500fd6b1103b2ee3","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/gof_ltw/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":47,"content":[{"type":"heading","content":["Filisxeemes Odetida Tinbite"]},{"type":"verse","number":1,"content":["Gibxe kawoy Gaaza olidi oykanaape kase, Filisxeemeba Godaape nabiya Ermiyaasako yida qaalay haysa:"]},{"type":"verse","number":2,"content":["Goday haysada yaagees;",{"text":"“Heko, pudeha baggafe haathi dhuuqana;","poem":1},{"text":"di7oy gelida kixa haathada goggana.","poem":2},{"text":"Biittanne biittan de7iyaba ubbaa,","poem":1},{"text":"katamatanne enta giddon de7iya asa ubbaa muukana.","poem":2},{"text":"Asay waassana;","poem":1},{"text":"biittan de7iya ubbay yeekana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Parata girsaa,","poem":1},{"text":"para gaareta kooshincha,","poem":2},{"lineBreak":true},{"text":"gaareta gondorsa girsaa si7ana.","poem":2},{"text":"Aawata kushey argaacida gisho,","poem":1},{"text":"banta nayta maaddanaw guye simmokona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Filisxeeme asa dhaysanaw,","poem":1},{"text":"Xiroosanne Sidoona maaddanaw attiya","poem":2},{"lineBreak":true},{"text":"asaa dhaysanaw wodey gakis.","poem":2},{"text":"Goday Filisxeemepe attidaysata,","poem":1},{"text":"Haathan teqetida de7iya Kaftoorape yida kochata dhaysana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gaazi kayotada ba huuphiya meedasu;","poem":1},{"text":"Asqalooni ba kushiya doonna bolla wothasu.","poem":2},{"text":"Hinteno, abba gaxan attidaysato,","poem":1},{"text":"awude gakanaw hinte asatethaa gaaretii?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hinte, ‘Godaa mashshaw, neeni si77i goonna ixey awudesee?","poem":1},{"text":"Ne bessaa simmada gela;","poem":2},{"lineBreak":true},{"text":"si77i gada utta’ yaageeta.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Shin Goday iya kiittin, I waanidi si77i gaanee?","poem":1},{"text":"Asqaloonanne abba gaxan de7iya biitta","poem":2},{"lineBreak":true},{"text":"olana mela kiittas” yaagis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}