{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Tana duussi shaattis!","poem":1},{"text":"Hessa gisho, ta zuuzumanaape attishin, si77i giike;","poem":2},{"lineBreak":true},{"text":"ta shempuwa seela kessana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taani Xoossaako haysada gaana;","poem":1},{"text":"ta bala taw odape attishin, ta bolla pirdofa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Neeni iitata qofaa ufaysan ekashe,","poem":1},{"text":"tana un7ethanaw bessii?","poem":2},{"lineBreak":true},{"text":"ne kushen medhida uraa kadheysi wogee?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne ayfey asa ayfe meleyee?","poem":1},{"text":"neeni asi xeelleysada xeellayee?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne de7o laythay asa de7o laytha meleyee?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yaatin, ta bala ayis koyay?","poem":1},{"text":"Ta nagaraa ayis kaallay?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Taani bala gidonaysanne","poem":1},{"text":"ne kushepe tana oonika ashshanaw danda7onnaysa ne eraasa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tana ne kushey giigisidi medhis;","poem":1},{"text":"shin ha77i he kushey simmidi tana menthees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neeni tana biittafe medhidaysa hassaya","poem":1},{"text":"Yaatin, ha77i tana zaarada baana oothanaw koyay?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tana maathada ta aaye ulon tigidaynne","poem":1},{"text":"meqa maathada Irkisiday nena gidikii?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Neeni tana ashonne goga mayzadasa;","poem":1},{"text":"shayaninne meqethan waaxadasa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Neeni taw de7onne merinaa siiqo immadasa;","poem":1},{"text":"ne naagoy tana paxa wothis.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Shin neeni he wodepe doomada ne wozanan","poem":1},{"text":"tana qohanaw qopada de7eysa ta erayis.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ta naaquwa ne be7aasa;","poem":1},{"text":"ta nagara oothiko seeronna aadhaka.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Taani balikoka tana ayye!","poem":1},{"text":"Ta xillo gidikoka ceeqetanaw danda7ike.","poem":2},{"text":"Ne tana yeella mayzadasa;","poem":1},{"text":"waayen wothadasa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ta otoriko tana gaammoda shankatada oykaasa;","poem":1},{"text":"tana qohanaw ne malaalsiya wolqaa zaara zaara bessaasa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Neeni ta bolla ooratha markata ehaasa;","poem":1},{"text":"ne hanquwa ta bolla darsaasa;","poem":2},{"lineBreak":true},{"text":"tana olanaw ooratha olanchota giigisaasa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yaatin, tana ta aaye ulope ayis kessadii?","poem":1},{"text":"Oonika tana be7onna hayqidaako taw lo77oshin!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Taani medhetonna attidaako,","poem":1},{"text":"woyko ta aaye ulope keyashe duufo gelidaako lo77oshin!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ta guutha de7o laythay wurees gidenneyee?","poem":1},{"text":"Ha guutha laythan ufaytana mela tana aggarki!","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ta simmonna bessaa boonna de7ishin,","poem":1},{"text":"leelida dhuma biitta gakonna de7ishin,","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"iya poo7oy dhuma gidida bessaanne hayqoy kawotida bessaa,","poem":2},{"lineBreak":true},{"text":"maari bayna bessaanne leelida dhuma biitta boonna de7ishin,","poem":2},{"lineBreak":true},{"text":"tana aggarki!”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/9.json","previousChapterAudioLinks":{},"numberOfVerses":22}