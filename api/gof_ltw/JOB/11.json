{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":11,"content":[{"type":"heading","content":["Soofara Haasaya"]},{"type":"verse","number":1,"content":["Na7ima biittafe yida Soofari zaaridi,"]},{"type":"verse","number":2,"content":[{"text":"“Ha hada haasaya ubbaas zaaro immiya asi baawee?","poem":1},{"text":"Woyko hessa odida uray tuma gidanaw danda7ii?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne hada oday ase si77i oothiya daanii?","poem":1},{"text":"Ne qelqisiya wode nena seeriya asi baawee?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Neeni, ‘Ta timirtey tuma;","poem":1},{"text":"taani Xoossaa sinthan geeshshi’ ” gaasa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xoossay new odiyako,","poem":1},{"text":"ba doona dooyidi odetiyako aybe!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Cincatethas daro ogey de7iya gisho,","poem":1},{"text":"Xoossay new cincatetha xuura qoncisiyako aybe!","poem":2},{"text":"He wode ne seeretida seeray,","poem":1},{"text":"besseysafe guutha gideysa eranashin.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Ciimmo gidida Xoossaa xuuraa eranaw danda7ay?","poem":1},{"text":"Woyko Ubbaa Danda7iya Xoossaba pilgada gakanaw danda7ay?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Enti salotape dhoqa; ne ay oothanaw danda7ay?","poem":1},{"text":"Enti Si7oolepeka aadhida ciimmo; ne eranaw danda7aka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Xoossaa cincatethay biittafe dalgees;","poem":1},{"text":"abbafeka aadhidi ciimmotees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"I yidi nena qasho keethan yeggiyako,","poem":1},{"text":"pirda keethi shiishiko, iya digganay oonee?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Xoossay pathonna asaa erees;","poem":1},{"text":"iitabaa be7iya wode si77i gidi aggenna.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Eeya asi cinca gideysafe,","poem":1},{"text":"wora harey ase gididi yeletanaysi mata.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Neeni ne wozanaa suure oothiko,","poem":1},{"text":"ne kushiya iyako micciko,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"nagaraa ne kushepe haassiko,","poem":2},{"lineBreak":true},{"text":"ne keethan iitabay doonna mela oothiko,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"He wode neeni dhoqu gada yeelli bayna ubbaba be7an;","poem":1},{"text":"yashshi bayna minnada eqana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Neeni ne metuwa ubbaa dogana;","poem":1},{"text":"goggidi aadhida di7oda zaara hassayaka.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ne de7oy seeta gallasa awape aadhidi poo7ana;","poem":1},{"text":"ne de7uwa dhumay wonta xalqeda poo7ana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"New ufaysi de7iya gisho neeni hirgonna daana;","poem":1},{"text":"Xoossay nena naagiya gisho wopu gada daana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Neeni yashshi bayna dhiskana;","poem":1},{"text":"daro asay nenan nashetanaw koyana.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Shin iitati meto be7ishe akeekokona;","poem":1},{"text":"iyape baqatidi attanaw danda7okona;","poem":2},{"lineBreak":true},{"text":"Enta ufaysay hayqo” yaagis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/10.json","previousChapterAudioLinks":{},"numberOfVerses":20}