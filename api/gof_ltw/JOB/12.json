{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":12,"content":[{"type":"heading","content":["Iyyoba Haasaya"]},{"type":"verse","number":1,"content":["Iyyobi haysada yaagidi zaaris."]},{"type":"verse","number":2,"content":[{"text":"Ee, hinte tumaka ase;","poem":1},{"text":"cincatethi hintera hayqana!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Shin taka hinteda akeeki de7iya asi;","poem":1},{"text":"taani hintefe guuxike;","poem":2},{"lineBreak":true},{"text":"Ha hinte odetidaba eronnay oonee?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taani Xoossaa woossin I tana si7ida asi gidikoka,","poem":1},{"text":"ha77i ta laggetas miichas attas;","poem":2},{"lineBreak":true},{"text":"taani xillonne borey bayna asi gidikoka qelqisethas attas.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Metootidi be7iboona asi hara asa meton miicees;","poem":1},{"text":"hinte kundanaw gandigariya asi sugeeta.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bonqeyisata keethay saro de7ees;","poem":1},{"text":"Xoossaa yiloyeysati hirgi bayna de7oosona;","poem":2},{"lineBreak":true},{"text":"banta wolqaa bantaw xoosse oothosona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ane meheta oycha; enti nena tamaarsana;","poem":1},{"text":"Woyko salo kafota oycha; enti new odana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Woyko sa7a medhetethatas oda; enti nena tamaarsana;","poem":1},{"text":"abba molotika new odana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Godaa kushey hessa oothidaysa eronnay oonee?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"De7oy de7iya medhetethi ubbaynne","poem":1},{"text":"asa shempoy iya kushena.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inxarsi kathi shaakidi ereysada,","poem":1},{"text":"haythi oda shaakidi erenneyee?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Cincatethi dondzida asaa matan deneyee?","poem":1},{"text":"daro laythi de7ida asaa matan akeeki benteneyee?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Cincatethinne wolqi Xoossasa;","poem":1},{"text":"zoreynne akeeki iya matan bentees.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Xoossay laallidaba zaari keexanay oonee?","poem":1},{"text":"I qachida uraa birshanay oonee?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Xoossay ira teqiko biittay melees;","poem":1},{"text":"ira bukisiko di7oy biitta dhaysees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Minotethinne xoonoy Xoossasa;","poem":1},{"text":"cimeteysinne cimmeysi nam7ayka iyape garsan de7ees.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Zoreysatape cincatethaa qaari ekees;","poem":1},{"text":"halaqataka eeya kessees.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"I kawota araatape wothidi aylle kessees.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Kahinetape bonchuwa qaari ekees;","poem":1},{"text":"adussa wode xapho yeddida wolqaamata shiri yeggees.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ammanetida zoreyisata si77i oothees;","poem":1},{"text":"cimatapeka akeeka yegisees.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bonchetidaysata kawushshees;","poem":1},{"text":"minota danco bilisees.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Dhuman de7iya xuura qonce kessees;","poem":1},{"text":"leelida dhumaa poo7o kessees.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Xoossay kawotethata gitayees; zaaridi dhaysees;","poem":1},{"text":"Kawotethata dalgisees; zaaridi laallees.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Alamiya kawota akeeka diggees;","poem":1},{"text":"ogey bayna mela biittan toylatana mela oothees.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Poo7oy bayna dhuman tattafoosona;","poem":1},{"text":"mathotida asada gandigaroosona.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/11.json","previousChapterAudioLinks":{},"numberOfVerses":25}