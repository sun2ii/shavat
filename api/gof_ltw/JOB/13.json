{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"Ha ubbaa ta ayfey be7is;","poem":1},{"text":"ta haythay si7idi akeekis.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hinte ereysa taka erayis;","poem":1},{"text":"taani hintefe guuxike.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Shin taani Ubbaa Danda7iya Xoossara odetanaw koyayis;","poem":1},{"text":"taani ta metuwaba iyara mootetanaw amottayis.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Shin hinte wordon kammeyisata;","poem":1},{"text":"hinte ubbayka pathonna aakimeta.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hinte si77i gidaba gidiyako,","poem":1},{"text":"cinca gidi bentanashin!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ha77i ta mootuwa si7ite;","poem":1},{"text":"ta doonape keya palama hayzite.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hinte Xoossaa gisho wordo odeteetii?","poem":1},{"text":"Iya gisho gidi cimon odeteetii?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hinte iya maaddiyabay de7ii?","poem":1},{"text":"Woyko iyaw xabaqa eqidi mootetetii?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"I hintena pilgi xeelliyako hintefe lo77oba demmanee?","poem":1},{"text":"Hinte ase cimmeysada iya cimmanaw danda7eetii?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hinte geeman asa som7o be7idi maaddiko,","poem":1},{"text":"I tuma hintena seerana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Iya bonchoy hintena daganthennee?","poem":1},{"text":"Iya teemay hintena yashshennee?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hinte odida leemisoy bidintha mela pathonnaba;","poem":1},{"text":"hinte mootoy biittafe medhetida gondalle mela.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ane si77i giite; ta odetana;","poem":1},{"text":"hizape hanidabay hano.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Taani tanatethaa ayis meton yeggiyana?","poem":1},{"text":"Ta de7uwa ayis ta kushen oykiyana?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Xoossay tana wodhikoka taani iya danda7an naagana;","poem":1},{"text":"taani ta metuwa iya sinthe shiishana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nagarancho asi iya sinthe shiiqanaw danda7onna gisho;","poem":1},{"text":"ooni eri ta xaalatethay atotethas gaaso gidanaw danda7ees.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ta haasaya akeekidi si7ite;","poem":1},{"text":"ta oday hinte haythan gelo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ha77i taani ta metuwa eka shiiqas;","poem":1},{"text":"I taw pirdanaysa erayis.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tana mootana asi de7ii?","poem":1},{"text":"De7iko taani si77i gada hayqana.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Xoossaw ne taw ha nam7ubata ootha;","poem":1},{"text":"yaatiko ta ne sinthafe geemmike.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ne seera kushiya taape dentha;","poem":1},{"text":"tana dagantheysa agga.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hessafe guye, tana xeega; ta koyana;","poem":1},{"text":"Woyko ta odana, ne taw zaara.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ta balaynne nagaray aapunee?","poem":1},{"text":"Ane ta naaquwanne ta nagaraa tana bessa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Neeni ayis ne som7uwa taape genthay?","poem":1},{"text":"ne morkeda ayis tana taybay?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Carkoy efiya kaliya ayis un7ethay?","poem":1},{"text":"melida punuwa ayis yedethay?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Neeni ta bolla xaafida mootoy camo;","poem":1},{"text":"ta na7atetha balaka aggabaaka.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Neeni ta tohuwa duxadasa;","poem":1},{"text":"ta tanguwa ubbaa wochaasa;","poem":2},{"lineBreak":true},{"text":"ta tohoy yedhiyasuwa kaallasa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Hessa gisho, taani wooqida mithada;","poem":1},{"text":"bili mida afilada wurayis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}