{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"“Maccasape yeletida asas laythi qanthi;","poem":1},{"text":"ika qassi meton kumis.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ciishshada bentidi ellesidi qoqofetees;","poem":1},{"text":"kuyada gam7onna eeson aadhees.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yaatin, neeni hessa mela asi kaallayee?","poem":1},{"text":"pirdas ne sinthe shiishayee?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tunabaape geeshshaba kessanaw danda7ey oonee?","poem":1},{"text":"Oonika baawa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Asi daana laythas zawi de7ees;","poem":1},{"text":"I daana ageena neeni tayba wothadasa;","poem":2},{"lineBreak":true},{"text":"neeni wothida zawape aadhey oonika baawa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Une oothiya asi ba oosuwa polidi shempeysada,","poem":1},{"text":"I shempana mela ne ayfiya iyape denthada iya aggaaga.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Qanxetida mithas ufaysi de7ees;","poem":1},{"text":"zaaridi aacees;","poem":2},{"lineBreak":true},{"text":"ooratha tashe kessidi diccees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mithaa xaphoy biitta garsan cimikoka,","poem":1},{"text":"durumay biittan wooqikoka,","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"haathe demmidi aacees;","poem":2},{"lineBreak":true},{"text":"ooratha dolada tashe kessees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Shin asi hayqees; hessi iyaw wursethi;","poem":1},{"text":"iya shempoy keyape guye I awun de7ii?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abbaa haathi meleysada,","poem":1},{"text":"shaafa haathi wureysada,","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"hessada asika hayqees; simmidi dendenna;","poem":2},{"lineBreak":true},{"text":"saloti aadhana gakanaw asi baarkenna;","poem":2},{"lineBreak":true},{"text":"ba dhiskuwafeka dendenna.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Neeni tana duufon genthidaako aybe!","poem":1},{"text":"Ne hanqoy aadhana gakanaw qottidaako aybe!","poem":2},{"lineBreak":true},{"text":"Ne taw qamida he gallas tana hassaydaako aybe!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Asi hayqiko simmidi de7on daanee?","poem":1},{"text":"Ta shempiya wodey yaana gakanaw,","poem":2},{"lineBreak":true},{"text":"ha meto wode ubbaa danda7an naagana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"He wode ne tana xeegana taka koyana;","poem":1},{"text":"ne medhida tana be7anaw laamotiya wodey yaana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"He wode neeni tuma ta tanguwa wochana;","poem":1},{"text":"shin ta nagaraa kaallaka.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ta balay ogoron yiicetana;","poem":1},{"text":"ta nagaraa neeni kammana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Zumi woddeysada,","poem":1},{"text":"zaalli dhoqalleteysada,","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"haathi shucha xapho bookeysada,","poem":2},{"lineBreak":true},{"text":"di7oy biitta meeccidi efeysada,","poem":2},{"lineBreak":true},{"text":"neeni asa ufaysi dhaysaasa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Neeni iya merinaw xoonasa; I simmenna;","poem":1},{"text":"iya malaa laammada ne sinthafe diggaasa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Iya nayti bonchetiko I erenna;","poem":1},{"text":"enti kawuyiko I be7enna.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Shin iya asatethaa seelay iya xalaalas si7etees;","poem":1},{"text":"I ba xalaalas yeekees” yaagis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}