{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":15,"content":[{"type":"heading","content":["Elfaaza Haasaya"]},{"type":"verse","number":1,"content":["Temaana biittafe yida Elfaazi haysada yaagis;"]},{"type":"verse","number":2,"content":[{"text":"“Cinca asi carkoda oyketonnaba odeetii?","poem":1},{"text":"Woyko doloha bagga carkuwan ba uluwa coo kunthii?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pathonna qaalan zuuzumii?","poem":1},{"text":"Woyko gatey bayna odan mootetii?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Neeni Xoossas yayyeysa aggadasa;","poem":1},{"text":"harati Xoossaa goyinnona mela dhubbadasa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne iitatethay ne odan eretees;","poem":1},{"text":"shin ne cinca oday nena genthees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne doonay ne bolla pirdees tana gidike;","poem":1},{"text":"ne inxarsay ne bolla markatees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Asape koyro yeletiday nenee?","poem":1},{"text":"Neeni dereti medhetanaape kase yeletadii?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Neeni Xoossaa xuura duulatan de7ay?","poem":1},{"text":"asa cincatethi ne xalaalas de7iyee?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nuuni eronnabay neeni eriyabay aybee?","poem":1},{"text":"Nuus geemmidi new qoncida ayba cincatethi de7ii?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne aawape bayratiya asati,","poem":1},{"text":"cimidi puulumida asati nuura de7oosona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Xoossay new immida minthethoy gidenneyee?","poem":1},{"text":"nuuni kahaamatethaba odida qaalay guutheyee?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne wozanay nena ayis wora efii?","poem":1},{"text":"Ne ayfey ayis dereeqidi xeellii?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yaatada neeni Xoossaa bolla hanqetadasa;","poem":1},{"text":"iita qaala ne doonape kessadasa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Asi Xoossa sinthan geeshshi gidanaw danda7ii?","poem":1},{"text":"Woyko maccafe yeletida asi xillo gidanaw danda7ii?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Xoossay ba kiitanchotan ammanetena;","poem":1},{"text":"hari attoshin saloti iya sinthan geeshshi gidokona.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Iitanne tuna gidida asi,","poem":1},{"text":"nagara haathada uyaa asi waanidi ammanetanee?","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Ane si7a, qoncisada ta new odana,","poem":1},{"text":"taani be7idaba ubbaa new odana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Cincati banta aawatape ekidaysa,","poem":1},{"text":"ta new genthonna odana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Biittay enta xalaalas imetis;","poem":1},{"text":"hara biitta asi entara walaketibeenna.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ase un7ethishe de7iya iita asi,","poem":1},{"text":"ba de7o laytha ubban waayetishe de7ees.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Daganthiyabay iya haythan si7etees;","poem":1},{"text":"I saro de7ayis gishin dhayseysati iya bolla keyana.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Dhumape kessi ekoy iyaw hanenna;","poem":1},{"text":"iya qaaday mashshan dhayo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Iya ahay anko quma gidana;","poem":1},{"text":"baw dhuma gallas matatidaysa I erees.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Metoynne un7i iya bolla yaana;","poem":1},{"text":"olanaw keyida kawo mela iya bolla goobana.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Hessika I ba kushiya Xoossaa bolla denthida gishosa;","poem":1},{"text":"Ubbaa Danda7iya Xoossaa bolla xaalida gishosa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"I eqetanaw minonne dalga gondalle oykis;","poem":1},{"text":"otoron Xoossaako hordofees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Iya kilahoy muumida gisho,","poem":1},{"text":"iya xeessay kumida gisho,","poem":2}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"I laaletida katamatan,","poem":2},{"lineBreak":true},{"text":"kaysa keethaninne,","poem":2},{"lineBreak":true},{"text":"kundanaw gakida keethan de7ees.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"I ba duretethan daro gam7enna;","poem":1},{"text":"iya zaway aakenna.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Dhumape kessi ekenaw danda7enna;","poem":1},{"text":"tashiya tami labida mithadanne","poem":2},{"lineBreak":true},{"text":"carkoy ciishsha qoqofida mithada gidana.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Pathonnaban ammanetidi bana cimmofo;","poem":1},{"text":"iyape aykoka demmonna attana.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Wodey gakonna iya ubbay melidi","poem":1},{"text":"tasheyka aaconna mitha mela gidana.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"I teeronna qawu7e de7ishe qoqofetiya woyne mela;","poem":1},{"text":"ciishshan de7ishe qoqofetiya shamaho mela.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Xoossas yayyonna asaa kochay dhayana;","poem":1},{"text":"wodhaafen keexetida keethay taman meetetana.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Enti iitatethi qanthatidi meto yeloosona;","poem":1},{"text":"enta uluwan geney kumis” yaagis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":35}