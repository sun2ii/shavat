{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":16,"content":[{"type":"heading","content":["Iyyoba Haasaya"]},{"type":"verse","number":1,"content":["Iyyobi haysada yaagidi zaaris;"]},{"type":"verse","number":2,"content":[{"text":"“Taani hessa mela haasaya daro si7as;","poem":1},{"text":"hinte minthethoy tana salethis.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Go77i bayna hinte odaas wursethi baawee?","poem":1},{"text":"taara hintena hessada palanthiya gaasoy aybee?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hinte ta bessan, taani hinte bessan gididaba gidiyako,","poem":1},{"text":"taani ta huuphiya qaathashe,","poem":2},{"lineBreak":true},{"text":"ha77i hinte giyaba ubbaa hinte bolla loythada gaanashin!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ta zoriyan ta hintena minthethanashin!","poem":1},{"text":"Ta doonape keyiya oday hintena minthethanashin!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Shin ta haasaykoka ta sahoy decenna;","poem":1},{"text":"ta si77i gada danda7ikoka taape kichenna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abeeti Xoossaw, ne tana ta asatethafe kessadasa;","poem":1},{"text":"ta keethaa asa ubbaa dhaysadasa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Shuuqida ta gogay taw marka gidis;","poem":1},{"text":"ta gilqatethay tana nagarancho kessis.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Xoossay hanqetidi ta asatethaa qanxerethis;","poem":1},{"text":"tana ixidi ba acha ta bolla garcis;","poem":2},{"lineBreak":true},{"text":"ta morkey ba ayfiya ta bolla kessis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Asay ta yuushon shiiqidi tana qelqisidosona;","poem":1},{"text":"tana leqidi baqidosona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Xoossay tana nagarachotas aathidi immis;","poem":2},{"lineBreak":true},{"text":"iitata kushen tana yeggis.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Taani kase saro de7as;","poem":1},{"text":"shin Xoossay tana tincherethis;","poem":2},{"lineBreak":true},{"text":"ta mirgaciya oykidi tana mentherethis;","poem":2},{"lineBreak":true},{"text":"cache loohisiya malla oothis.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Iya tooranchoti banta dongen tana teqidosona;","poem":1},{"text":"qadhey bayna ta kilahuwa muxerethidosona;","poem":2},{"lineBreak":true},{"text":"ta ciyaa sa7an gussidosona.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"I tana zaari zaari madunxisis;","poem":1},{"text":"olanchoda toollidi caddis.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Taani kayo ma7o ma7as;","poem":1},{"text":"ta wolqay wurin baanan uttas.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yeehon ta som7oy gabbis;","poem":1},{"text":"ta ayfey zo77is.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Shin he ubban ta balidabay baawa;","poem":1},{"text":"ta geeshsha wozanan woossayis.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Biittaw, tana gakida qohuwa kammofa;","poem":1},{"text":"ta waasoy shempiya soo demmofo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Heko ta markay salona;","poem":1},{"text":"ta xabaqay bollana.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ta laggeti tana kadhidi xeelloosona;","poem":1},{"text":"ta ayfey Xoossa sinthan afuthi tigees.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ase asara sigethiya asi de7eysada,","poem":1},{"text":"tana Xoossara sigethiya asi de7idaba gidernishin.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ta laythay wurana hanees;","poem":1},{"text":"guutha wodepe guye ta simmonna soo baana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}