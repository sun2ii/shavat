{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"Ta shempoy keyees;","poem":1},{"text":"ta laythay qaammis;","poem":2},{"lineBreak":true},{"text":"taw duufoy giigis.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta bolla qelqiseysati ta yuushuwan de7oosona;","poem":1},{"text":"enti tana yiloyida mela aysidosona.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abeeti Xoossaw, neepe hari tana maaddey bayna gisho,","poem":1},{"text":"ne taw waase gida.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Enti akeekona mela enta qofaa gordadasa;","poem":1},{"text":"Hessa gisho, ne entaw xoono immofa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Miishe demmana gidi,","poem":1},{"text":"ba laggeta aathidi immiya uraa nayta ayfey qooqana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xoossay tana asas miichas aggis;","poem":1},{"text":"asi cuttishe aadhiya asi gidas.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta daro kayotida gisho ta ayfey eeyis;","poem":1},{"text":"ta asatethay laafidi eesho gidis.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Keeha asati tana be7idi dagammidosona;","poem":1},{"text":"suureti Xoossaa ammanonayisata bolla yilotidosona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gidoshin xilloti banta ogiyape deshokona;","poem":1},{"text":"suureti wolqa guji guji boosona.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Shin zaaridi ubbay taako haa yiite!","poem":1},{"text":"ta hinte giddofe issi cinca asi demmike.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ta de7o laythay wuris;","poem":1},{"text":"ta halchoy hada gidis;","poem":2},{"lineBreak":true},{"text":"ta wozanaa amoy coo attis.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ta laggeti qamma gallas goosona;","poem":1},{"text":"dhuma be7ishe ‘Poo7ana hanees’ yaagosona.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ta ufaysan naagiya keethay duufo;","poem":1},{"text":"ta hiixa dhuman hiixayis.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Duufoko, ‘Ne ta aawa’ yaagana;","poem":1},{"text":"guxuneko, ‘Ne ta aayo woyko ta micho’ yaagana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yaatin, taw ay ufaysi de7ii?","poem":1},{"text":"taw ufaysi gidiyaba ooni demmanay?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ta ufaysay taara duufo bandee?","poem":1},{"text":"Nu issife biittan duge gelanee?” yaagis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}