{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":18,"content":[{"type":"heading","content":["Baldadoosa Haasaya"]},{"type":"verse","number":1,"content":["Hessafe guye, Shuuha biittafe yida Beldadoosi zaaridi,"]},{"type":"verse","number":2,"content":[{"text":"“Iyyoba, ne odaas wursethi baawee?","poem":1},{"text":"Ane akeeka; nu odiyaba si7a.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne nuna ayis miizi oothay?","poem":1},{"text":"Ayis nuna tulle kessay?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne hanqetada nena qohaasa;","poem":1},{"text":"Ne hanquwan biittay kallo attanee?","poem":2},{"lineBreak":true},{"text":"Woyko zaallay ba bessaafe qaaxennee?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nagaranchota xompey to7ana;","poem":1},{"text":"iya tama lacoy dhayana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Enta keethan de7iya xompey dhayana;","poem":1},{"text":"enta poo7oyka dhumana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I tangiya tangoy qaammees;","poem":1},{"text":"iya iita qofay iya zaaridi mees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iya hemethay iya xihen gelsees;","poem":1},{"text":"iya tohoti gitetana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Xihey iya ginde oykana;","poem":1},{"text":"diizi iya qaaxo diggana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yurde wodoroy sa7an iyaw geemmi uttees;","poem":1},{"text":"I hemetiya ogiyan gitey de7ees.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dagami iya teqidi oykees;","poem":1},{"text":"iya guyera kaallidi iya yedethees.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Iya wolqaa koshi wursis;","poem":1},{"text":"dhayoy iya miyen naagees.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hargey iya laafethees;","poem":1},{"text":"hayqoy iya mokidi ekees.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hirgi bayna de7iya ba keethaafe goodetees;","poem":1},{"text":"enti iya hayqo geetetiya kawako efoosona.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Iya keethay taman oyketana;","poem":1},{"text":"I de7iyasuwan diinney laaletana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Garsara xaphoy melana;","poem":1},{"text":"bollara haythi qoqofetana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Iya qopiya asi biittafe dhayana;","poem":1},{"text":"iya sunthay sa7an hassayetonna attana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"I poo7ope dhuman goodettana;","poem":1},{"text":"alamiyape dhayana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Iyaw na7i woyko kochi dhayana;","poem":1},{"text":"I de7ida bessan issi asi paxa attenna.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wuloha bagga asay, iya gakida metuwan dagammidosona;","poem":1},{"text":"doloha bagga asay yashshan kokoridosona.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Iita asaa wursethay awudeka hessa mela;","poem":1},{"text":"Xoossaa eronna asaa qaaday hessa mela” yaagis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}