{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":19,"content":[{"type":"heading","content":["Iyyoba Haasaya"]},{"type":"verse","number":1,"content":[{"text":"Iyyobi zaaridi haysada yaagis;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hinte tana awude gakanaw madunxiseetii?","poem":1},{"text":"Awude gakanaw hinte qaalan tana caddetii?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hinte tana tammu toho cayideta;","poem":1},{"text":"tana kawushishe yeellateketa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tuma ta balidaba gidiko,","poem":1},{"text":"ta balay tana oychana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hinte hintena dhoqu dhoqu oothidi,","poem":1},{"text":"ta kawusha tana mootanaw go7etiko,","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ha metuwa ta bolla ehiday Xoosse gideysanne","poem":2},{"lineBreak":true},{"text":"ba gitiyan tana gelsiday iya gideysa erite.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta qohetas gada waassin, tana alley baawa;","poem":1},{"text":"ta qaala dhoqu oothada waassinka tana si7ey baawa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ta kanthada boonnada Xoossay ta ogiya diris;","poem":1},{"text":"ta hemetiya ogiya dhuman gordis.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ta bonchuwa taape qaaris;","poem":1},{"text":"ta kallachaa ta huuphepe ekis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"I tana mentherethi yeggis;","poem":1},{"text":"ta ufaysa xaphora shodetida mitha mela oothis.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Iya hanqoy ta bolla eexi keyis;","poem":1},{"text":"I tana morkeda taybees.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tana olanaw ba tooranchota kiittees;","poem":1},{"text":"enti tana olanaw miixa keexidi,","poem":2},{"lineBreak":true},{"text":"ta dunkaaniya yuushuwan uttidosona.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Xoossay ta ishata taape haassis;","poem":1},{"text":"tana ereysati taw allaga gididosona.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ta dabboti taape haakidosona;","poem":1},{"text":"ta laggeti tana dogidosona.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ta son moketiya imathati tana dogidosona;","poem":1},{"text":"ta macca aylleti tana oge asada xeellidosona.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ta aylliya ta xeegin taw koyenna;","poem":1},{"text":"ta woossin taw ero geenna.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ta machiya ta doona peenuwa shaatetasu;","poem":1},{"text":"ta ishati tana uufidosona.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hari attoshin guutha nayti tana kadhoosona;","poem":1},{"text":"tana be7idi leqoosona.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ta mata laggeti ubbay tana uufosoona;","poem":1},{"text":"ta doseysati taw zoko zaaridosona.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ta meqethay ta gogaara oyketis;","poem":1},{"text":"taani hayqa kichada attas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ta laggeto, Xoossaa kushey tana dechida gisho,","poem":1},{"text":"taw qadheterketi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Xoossay tana yedetheysada, hinte tana ayis yedetheetii?","poem":1},{"text":"ha77i gakanaw hinte tana waaysidaysi gidennee?","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“Ha77i gakanaw ta odetida qaalay mazgabetidaako,","poem":1},{"text":"maxaafan xaafetidaako ta dosayis shin.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Merinaw daana mela maarisaninne","poem":1},{"text":"irsaasen zaalla bolla woocetidi xaafetida gideerenne!","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Tana Wozidaysi de7on de7eysanne","poem":1},{"text":"wursethan biitta bolla I eqanaysa ta erayis.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ta gogay meetetidi wurikoka,","poem":1},{"text":"taani ta ashuwape shaaketada Xoossaa be7anaysa erayis.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Hara asi gidonna taani ta huuphen,","poem":2},{"lineBreak":true},{"text":"ta ayfen iya be7ana;","poem":2},{"lineBreak":true},{"text":"ta wozanay he qamma laamotees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Ha metuwas gaasoy iya,","poem":1},{"text":"nu iya waati yedethino gidi hinte qopiya gidiko,","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Mashshas yayyite!","poem":1},{"text":"Xoossa hanqoy mashshara yaana;","poem":2},{"lineBreak":true},{"text":"pirdi de7eysa erite” yaagis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}