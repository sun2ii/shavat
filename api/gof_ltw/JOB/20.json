{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":20,"content":[{"type":"heading","content":["Soofara Haasaya"]},{"type":"verse","number":1,"content":["Na7ima biitta asi gidida Soofari haysada yaagidi zaaris;"]},{"type":"verse","number":2,"content":[{"text":"“Ne oday tana lancisida gisho,","poem":1},{"text":"ta ellesada ne odaas zaaro immana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne oday ta bonchuwa qaariya gisho,","poem":1},{"text":"ta akeekay new zaaro immana mela tana denthethees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Asi biitta bolla de7ida wodepe doomidi,","poem":1},{"text":"benipe hanidaba eraasa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iita asa ceeqoy qantha wodesa;","poem":1},{"text":"Xoossaa eronna asaa ufaysay guutha wodesa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iita asa otoroy salo gakanaw dhoqu giikoka,","poem":1},{"text":"iya huuphey shaara gakidi bochikoka,","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I baana mela pitetidi dhayana;","poem":2},{"lineBreak":true},{"text":"Iya kase eriya asay ‘I awun de7ii?’ yaagana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Elmoda paallidi dhayana; simmidi bentenna;","poem":1},{"text":"qamma amuhoda coo dhayana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iya kase be7ida ayfeti zaaridi iya be7okona;","poem":1},{"text":"I ba de7iya bessaafe tim7i gidi dhayana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Aaway bonqi ekida miishe,","poem":1},{"text":"iya nayti banta kushen guye zaarana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Iya meqethaa kumida na7atetha wolqay","poem":1},{"text":"iyara issife biittan zin7ana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Iitatethi iya doonan mal7iko,","poem":1},{"text":"I ba inxarsaafe garsan qosiko,","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"wuronnaada ba doonan oykidi,","poem":2},{"lineBreak":true},{"text":"wothi aggiko,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"iya uluwan camo gidana;","poem":2},{"lineBreak":true},{"text":"wodhiya shoosha marze gidana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Iita asi mitida shaluwa zaari cuttana;","poem":1},{"text":"iya uluwan de7iya ubbaa Xoossay cooshshana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Iita asi miyabay iyaw marze gididi,","poem":1},{"text":"iya wodhana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Eessinne maathi haathada goggishin,","poem":1},{"text":"I be7onna attana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ba daabura ayfiya moonna haras immana;","poem":1},{"text":"zal7idi wodhisida wodhiyan ufaytenna.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hessi haniday I manqota un7ethida gishonne","poem":1},{"text":"hara asi keexida keethaa bonqida gishosa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Iya iita amoy shempo diggis;","poem":1},{"text":"shiishida shaloy iya ashshanaw danda7enna.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Iya shaloy wuriya gisho,","poem":1},{"text":"iya duretethay gam7enna.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Iyaw aqoy kumidi de7ishin,","poem":1},{"text":"metoy akeekona iya bolla gaki wodhana.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Iya uloy kaalliya wode,","poem":1},{"text":"Xoossay wolqaama hanquwa iya bolla gussana.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Birata mashshafe I baqatana;","poem":1},{"text":"shin naase birata dongey iya caddana.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"He dongey iya zokora kanthi keyana;","poem":1},{"text":"phooliya xeeray iya tiriya kanthi aadhana;","poem":2},{"lineBreak":true},{"text":"dagami iya wozanaa waabaqisana.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"I shiishida aqoy sakana dhuman dhayana;","poem":1},{"text":"asi oythiboonna tami iya maana;","poem":2},{"lineBreak":true},{"text":"iya keethan attida shalo ubbaa xuuggana.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Saloti iya nagaraa qoncisana;","poem":1},{"text":"sa7ika iyaw morke gidana.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Xoossaa hanqo gallasan,","poem":1},{"text":"iya keethaanne iyaw de7iyaba di7oy efana.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Xoossay geellatas wothida qaaday,","poem":1},{"text":"iita asaas giigisida gatey haysa” yaagis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}