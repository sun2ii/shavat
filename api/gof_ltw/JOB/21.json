{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":21,"content":[{"type":"heading","content":["Iyyoba Haasaya"]},{"type":"verse","number":1,"content":["Yaatin Iyyobi haysada yaagidi zaaris;"]},{"type":"verse","number":2,"content":[{"text":"Ane ta oda akeekidi si7ite;","poem":1},{"text":"hessi hinte tana minthethida mela gido.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taani issi toho odetana mela taw wode immite;","poem":1},{"text":"taani haasaya simmiko tana qelqisite.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taani mootetey asara gidenna.","poem":1},{"text":"Yaatin, danda7ay wuriko hessi malaalsiyee?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ane tana xeellidi malaaletite;","poem":1},{"text":"hinte kushiya hinte doona bolla wothite.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ta hessa qopiya wode tana daganthees;","poem":1},{"text":"ta asatethay kokorees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iita asati ayis paxa de7oona?","poem":1},{"text":"Enta laythay ayis aduqii?","poem":2},{"lineBreak":true},{"text":"Enta wolqay ayis dari dari bidee?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Enta naytinne nayta nayti,","poem":1},{"text":"diccishininne injen de7ishin enti ayis be7oona?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Enta soy hirgi bayna saro de7ees;","poem":1},{"text":"Xoossaa xam7ay enta gakenna.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Enta miizati biraysi ekidi koxokona;","poem":1},{"text":"yelishe awucayokona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Banta nayta dorsaa wudeda kessoosona;","poem":1},{"text":"enta nayti duroosona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Karaabo baqishe diithi diixishe,","poem":1},{"text":"suusul7e punnishe ufaysan yexoosona.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Enti banta de7o laytha injen de7idi,","poem":1},{"text":"duufo sarora boosona.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Gidoshin, enti Xoossaako “Nuupe haaka!","poem":1},{"text":"Nuuni ne ogiya eranaw koyoko” yaagosona.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“Nu iya goyinnanaw Ubbaa Danda7iya Xoossay oonee?","poem":1},{"text":"Nu iya woossidi ay go7etanee?” yaagosona.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Enti duretetha banta minotethan demmida goosona;","poem":1},{"text":"shin taani enta qofaa ekike.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Hanoshin, iita asaa xompey to7ii?","poem":1},{"text":"Entana boshi gaki erii?","poem":2},{"lineBreak":true},{"text":"Xoossay ba hanquwan enta seeri erii?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Carkoy enta kaleda efida wodey,","poem":1},{"text":"Gotey enta baanada denthida wodey de7ii?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hinte, ‘Xoossi aawata bala gisho enta nayta seerees’ yaageeta.","poem":1},{"text":"Ane Xoossay nagaranchota enta huuphen seero;","poem":2},{"lineBreak":true},{"text":"yaatiko enti banta naaquwa erana.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nagaranchoti banta seera bantaw eko;","poem":1},{"text":"Ubbaa Danda7iya Xoossaa hanqoy enta bolla wodho.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Asi hayqidaape guye,","poem":1},{"text":"ba naytabaa ay erii?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Dhoqa bessan de7eyisata pirdiya Xoossaa,","poem":1},{"text":"eratethi tamaarsanaw danda7iya asi de7ii?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Issi issi asi kumetha wolqaynne saroy de7ishin,","poem":1},{"text":"inje duussu de7ishe hayqoosona.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Enta asatethay orde shin,","poem":1},{"text":"enta meqethaa kolizey shica de7ishin hayqoosona.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Shin harati lo77oba be7onna,","poem":1},{"text":"meton un7etidi kayotida mela hayqoosona.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nam7ayka hayqidi biittan moogetosona;","poem":1},{"text":"enti guxuntoosona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Hinte tana qohanaw qopidi,","poem":1},{"text":"hinte wozanan qopida qofaa ta loythada erayis.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Hinte, ‘He gita uraa keethay awunee?","poem":1},{"text":"Iita oothiya uray de7iya soy awunee?’ yaageeta.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Oge asata oychibeeketii?","poem":1},{"text":"Enta markatethaa ammanibeketii?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Enti, ‘Iita asay dhayo gallas qohetokona;","poem":1},{"text":"Xoossaa hanqoy qonciya gallas enti attana’ yaagosona.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Iita asi iya iitatethaa gisho kaccanay oonee?","poem":1},{"text":"Iya oosuwa gisho iya seeranay oonee?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"I hayqin, iya aha duufo efoosona;","poem":1},{"text":"iya duufoy bonchon naagetees.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Zangaara biittay iyaw injetees;","poem":1},{"text":"daro asay iya sinthan boosona;","poem":2},{"lineBreak":true},{"text":"tayboy bayna asay iya kaalloosona.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Yaatin, hinte tana pathonna qaalan waati minthethanee?","poem":1},{"text":"Hinte ta oyshaas zaariya zaaro ubbay wordo” yaagis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/20.json","previousChapterAudioLinks":{},"numberOfVerses":34}