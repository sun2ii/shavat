{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":22,"content":[{"type":"heading","content":["Elfaaza Haasaya"]},{"type":"verse","number":1,"content":["Hessafe guye, Temaana biittafe yida Elfaazi haysada yaagidi zaaris;"]},{"type":"verse","number":2,"content":[{"text":"“Asi Xoosse go77anaw danda7ii?","poem":1},{"text":"Hari attoshin cinca gidikoka,","poem":2},{"lineBreak":true},{"text":"bana go77anaape attishin, Xoosse go77enna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Neeni xillo gidiko hessi Ubbaa Danda7iya Xoossaa ufaysiyee?","poem":1},{"text":"Ne ogey borey baynaba gidiko hessan I ay wodhe demmii?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“I nena seereynne pirdey,","poem":1},{"text":"Neeni iyaw yayya gishoyee?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne iitatethay daro gidenneyee?","poem":1},{"text":"Ne nagaraas zawi baawa gidennee?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gaasoy bayna ne ishata waase xeegisadasa;","poem":1},{"text":"asaa ma7uwa qaara ekada enta kallo yeddadasa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Saamotidaysata haathe ushshabaaka;","poem":1},{"text":"koshatidaysata kathi muzabaaka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Neeni wolqaama, durenne","poem":1},{"text":"bonchetida asi gidada de7ashe,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Am7eta mela kushe yeddadasa;","poem":1},{"text":"yi7otas wolqa dhaysadasa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne yuushoy gitetiday,","poem":1},{"text":"akeekona yashshi nena kokorsey hessasa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne be7onna mela dhumiday,","poem":1},{"text":"qassi kixa haathan ne muuketiday hessasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Xoossay dhoqa saluwan uttidi,","poem":1},{"text":"dhoqan de7iya xoolintota duge xeellees.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Shin neeni, ‘Xoossi ay erii?","poem":1},{"text":"Sakana dhumaa giddora kanthidi,","poem":2},{"lineBreak":true},{"text":"pirdanaw danda7ii?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Salo gufantho bolla I simeretiya wode,","poem":1},{"text":"I be7onna mela siketida shaaray iya goozees’ yaagasa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nagaranchoti hemetida beni ogiyara","poem":1},{"text":"baanaw qofaa qachadii?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Entaw wodey gakonna de7ishin hayqidosona;","poem":1},{"text":"enta de7o baasoy di7on meecetidi dhayis.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Enti Xoossaako, ‘Nuupe haaka!","poem":1},{"text":"Ubbaa Danda7iya Xoossay nuus ay oothanaw danda7ii?’ yaagidosona.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Gidikoka, enta keetha lo77oban kunthiday Xoossaa;","poem":1},{"text":"Hessa gisho, iita asaa qofaa ta ekike.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Iita asati seeretiya wode,","poem":1},{"text":"xilloti ufaytoosona;","poem":2},{"lineBreak":true},{"text":"suure asati haysada yaagidi, enta bolla qelqisoosona.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"‘Nu morketi dhayidosona;","poem":1},{"text":"enta duretethay tamas attis’ yaagosona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Iyyoba, ha77ika Xoossara giiga;","poem":1},{"text":"iyara saro de7a;","poem":2},{"lineBreak":true},{"text":"yaatiko neeni anjetana.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Iya timirtiya si7a;","poem":1},{"text":"iya qaala ne wozanan wotha.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Neeni Ubbaa Danda7iya Xoossaako simmiko;","poem":1},{"text":"new sa7i simmana;","poem":2},{"lineBreak":true},{"text":"iita ooso ubbaa ne soope digga;","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ne worqaa sa7an hola;","poem":1},{"text":"ne Ofira worqaa shaafan yegga.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yaatiko Ubbaa Danda7iya Xoossay,","poem":1},{"text":"new worqanne dooretida bira gidana.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"He wode ne Ubbaa Danda7iya Xoossan ufaytana;","poem":1},{"text":"yeellatonna Xoossako pude xeellana.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Neeni iya woossana, I nena si7ana;","poem":1},{"text":"ne qangetha iyaw gathana.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ne qopidabay poletana;","poem":1},{"text":"ne hemetiya ogey poo7o gidana.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Xoossay otoreyisata kawushshees;","poem":1},{"text":"shin ashketa ashshees.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ne kushey geeshshi gidiko,","poem":1},{"text":"bala asay ne gaason maarota ekananne attana” yaagis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}