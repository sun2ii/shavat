{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":23,"content":[{"type":"heading","content":["Iyyoba Haasaya"]},{"type":"verse","number":1,"content":["Iyyobi haysada yaagidi zaaris;"]},{"type":"verse","number":2,"content":[{"text":"Hachika ta cametada zuuzumayis;","poem":1},{"text":"ta ooley mino gidikoka","poem":2},{"lineBreak":true},{"text":"iya kushey ta bolla deexeysa aggibeenna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iya demmana bessaa ta erida gidarkina;","poem":1},{"text":"I de7iya bessaa ta gakarkina!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taani ta metuwa iya sinthan wothanashin!","poem":1},{"text":"Ta doona mooton kunthanashin!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"I taw zaaranay aybeko eranashin,","poem":1},{"text":"I ay giyako be7anashin!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I ba gita wolqan taara eqetanesha?","poem":1},{"text":"Akay, I tana si7ana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yan suure asi iyara mootetanaw danda7ees;","poem":1},{"text":"ta daynnay tana merinaw shatinthana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Shin taani doloha biiko I yan deenna;","poem":1},{"text":"taani wuloha biiko iya yan demmike.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"I pudehan oothiya wode taani iya be7ike;","poem":1},{"text":"dugeha bagga simmiya wode taani iya demmike.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Shin I ta tanguwa ubbaa erees;","poem":1},{"text":"I tana paaciya wode taani worqada geeyada keyana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ta tohoy iya tanguwa kaallidi bees;","poem":1},{"text":"iya ogiyape haddirsi ushachi simmabike.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Iya doonape keyiya kiitaape taani shaaketabike;","poem":1},{"text":"iya qaala ta wozanan wothas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Xoossay laametenna;","poem":1},{"text":"Iyara eqetanay baawa,","poem":2},{"lineBreak":true},{"text":"I koydaba oothees.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"I ta bolla qopidaysa polis;","poem":1},{"text":"hessa mela hara daro halchoti iyaw de7oosona.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hessa gisho, iya sinthan eqanaw daro yashshees;","poem":1},{"text":"hessa ubbaa qopiya wode kokorayis.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Xoossay ta wozanay doccana mela oothis;","poem":1},{"text":"Ubbaa danda7iya Xoossay tana daganthis.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sakana dhumay ta som7uwa goozikoka,","poem":1},{"text":"tana he dhumay haasaya diggibeenna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}