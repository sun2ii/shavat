{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"Ubbaa Danda7iya Xoossay pirda wode ayis qanxennee?","poem":1},{"text":"Iya ereysati he wodiya ayis coo naagonna?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iita asati zawan de7iya shuchaa denthoosona;","poem":1},{"text":"kaysi ehida dorsata yan heemmoosona.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yi7o nayta hareta bonqoosona;","poem":1},{"text":"am7e booraa acos oykidi ekoosona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Manqota shaatetidi ogepe gooddosona;","poem":1},{"text":"banta sinthafe qosetana mela oothosona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bazzon de7iya wora hare mela,","poem":1},{"text":"manqoti banta naytas miyaba koyishe daaburoosona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Enti hara asa gaden kathi cakoosona;","poem":1},{"text":"iita asaa woyne gaden budhe maxoosona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Enti qamma kallo aqoosona;","poem":1},{"text":"meegos bolla yeggiyabay entaw baawa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Zuma bolla bukiya iran enti suuruxoosona;","poem":1},{"text":"geliya bessi dhayidi shucha hom7on aqoosona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Aawi bayna na7a aaye ki7ope dafi ekoosona;","poem":1},{"text":"manquwa na7a acos oykoosona.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Manqoti ma7o dhayidi kallo hemetoosona;","poem":1},{"text":"enti bantaw koshatishe hara asa mirqe tookosona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Enti bantaw saamotishe,","poem":1},{"text":"zayte kessanaw hara asa gaden shamaho ayfe maxoosona;","poem":2},{"lineBreak":true},{"text":"woyne ushsha gum7anaw woyne ayfe qoroosona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kataman kataman hayqana haniya asay oolosona;","poem":1},{"text":"deshetidi madunxida asay maado koyidi waassoosona;","poem":2},{"lineBreak":true},{"text":"shin Xoossay enta metuwa xeellenna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Poo7o ixiya asati,","poem":1},{"text":"iya ogiya eronna asatinne;","poem":2},{"lineBreak":true},{"text":"iyan eqona asati de7oosona.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sa7i qammiya wode shempo wodheysi dendidi,","poem":1},{"text":"manqotanne metootanchota wodhees;","poem":2},{"lineBreak":true},{"text":"qammi qassi kaysos boosona.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Laymatiya asi sa7i lem7anaysa naagees;","poem":1},{"text":"oonika be7onna mela ba som7uwa kammees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kaysoti qamma keethe bookidi kaysotanaw geloosona;","poem":1},{"text":"shin gallas qosetidi pee7osona.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Daganthiya dhumara enti dabbotiya gisho,","poem":1},{"text":"sakana dhumay entaw seeta gallasa mela.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“Shin iita asati haatha goponto mela;","poem":1},{"text":"enta laata biittay baadetidaysa;","poem":2},{"lineBreak":true},{"text":"oonika enta woyne gade beenna.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Shachi maayin, haathi melidi dhayeysada,","poem":1},{"text":"nagaranchoti hayqidi biittafe dhayoosona.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yelida aayeti enta dogana;","poem":1},{"text":"Guxuney enta ashuwa maana;","poem":2},{"lineBreak":true},{"text":"iita asay hassayetokona;","poem":2},{"lineBreak":true},{"text":"mithada meqana.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Enti na7i bayna mayntha maccasa naaqidosona;","poem":1},{"text":"am7eta qadhetonna ixidosona.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Xoossay ba wolqan minota dhaysis;","poem":1},{"text":"entaw sa7i injetida daanikoka,","poem":2},{"lineBreak":true},{"text":"kundonna attokona.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Xoossay enti saro daanada oothikoka,","poem":1},{"text":"enta ogiya wochees.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Iita asati guutha wodes dhoqu dhoqu goosona;","poem":1},{"text":"shin ellesidi sharaafada shullidi dhayoosona;","poem":2},{"lineBreak":true},{"text":"kathada caketoosona.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Hessi hanenna gidi kaddiya asi de7ii?","poem":1},{"text":"taani odida qaala wordo gaana asi de7ii?” yaagis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}