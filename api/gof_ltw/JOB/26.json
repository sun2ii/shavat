{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":26,"content":[{"type":"heading","content":["Iyyoba Haasaya"]},{"type":"verse","number":1,"content":["Iyyobi haysada yaagidi zaaris;"]},{"type":"verse","number":2,"content":[{"text":"“Neeni wolqi baynaysa ayba maaddadii?","poem":1},{"text":"Daaburanchuwa waata ashshadii?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Cincatethi pacidaysas ay zore immadii?","poem":1},{"text":"Ay mela eratethi qoncisadii?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Neeni ha qaala odetana mela nena maaddiday oonee?","poem":1},{"text":"Ne odan mela nena denthethiday oodde ayyaanee?” yaagis.","poem":2}]},{"type":"heading","content":["Baldadoosa Haasaya"]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Beldadoosi zaaridi, “Hayqida asaa ayyaanati,","poem":1},{"text":"garsan haatha giddon de7eysati kokoroosona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xoossa sinthan Si7ooley qonce;","poem":1},{"text":"aybika iya genthanaw danda7enna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Xoossay pudeha salota coo miccis;","poem":1},{"text":"sa7aa kaqoy bayna bessan kaqis.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"I shaaratan haathe kunthees;","poem":1},{"text":"haatha deexuwan shaarati daaketokona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"I ba shaara miccidi,","poem":1},{"text":"kumtha ageena kammees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Poo7o dhumape shaakanaw,","poem":1},{"text":"abba gaxan Xoossay zawa wothis.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"I hanqetiya wode,","poem":1},{"text":"salo tuuqeti dagaman kokoroosona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ba wolqan abba si77i oothees;","poem":1},{"text":"ba cincatethan Ra7aaba geetetiya do7aa dhaysees.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"I ba shempuwan salota geeshshees;","poem":1},{"text":"iya kushey xongetiya shooshaa caddees.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Haysati Xoossay oothiya oosotape guuthata;","poem":1},{"text":"nu iya kalkashaa xalaala si7oos;","poem":2},{"lineBreak":true},{"text":"iya wolqaa deshuwa akeekanaw danda7ey oonee?” yaagis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}