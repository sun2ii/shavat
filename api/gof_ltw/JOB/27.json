{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":27,"content":[{"type":"heading","content":["Iyyoba Haasaya"]},{"type":"verse","number":1,"content":["Iyyobi kaallidi haysada yaagis;"]},{"type":"verse","number":2,"content":[{"text":"“Suure pirdaa tana diggidi,","poem":1},{"text":"ta de7uwa camo oothida,","poem":2},{"lineBreak":true},{"text":"Ubbaa Danda7iya Xoossan taani caaqayis.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ta shempoy de7ishin,","poem":1},{"text":"ta siidhey shempishin","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ta doonay wordo odetenna;","poem":2},{"lineBreak":true},{"text":"ta inxarsay cimo odetenna.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hinte oday like gada ta ekike;","poem":1},{"text":"hayqana gakanaw ta tana suure geysa aggike.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ta xillotethaa mintha oykanaape attishin, aggike;","poem":1},{"text":"ta de7ida laytha ubban ta kahay tana mootenna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ta morketi nagaranchoda,","poem":1},{"text":"taara eqeteysati bala gido.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Xoossay enta shempuwa entafe ekiya wode,","poem":1},{"text":"enta laytha qaamisiya wode,","poem":2},{"lineBreak":true},{"text":"iitatas de7iya ufaysay aybee?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Enta bolla metoy gakiya wode,","poem":1},{"text":"Xoossay enta waasuwa si7ii?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ubbaa Danda7iya Xoossan enti ufaytanee?","poem":1},{"text":"Enti ubba wode Xoossaa xeeganee?","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Taani hintena Xoossaa wolqaaba tamaarsana;","poem":1},{"text":"Ubbaa Danda7iya Xoossaa qofaa ta hintefe qottike.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hinte ubbay hessa be7ideta;","poem":1},{"text":"yaatin, haysa mela coo haasaya ayis odeteetii?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Xoossay iita asatas giigisida qaaday,","poem":1},{"text":"Ubbaa Danda7iya Xoossaafe ekiya woytoy haysa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Enta nayti ay darikoka olan wurana;","poem":1},{"text":"enta kochay miyaba dhayidi koshatana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hessafe attidaysati gadon wurana;","poem":1},{"text":"enta am7eti entaw yeekokona.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Iita asati bira biittada shiishikoka,","poem":1},{"text":"ma7o urqada shiishidi doorikoka,","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"enta bira xillo asati shaaki ekana;","poem":2},{"lineBreak":true},{"text":"enta ma7uwa geeshshati ma7ana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Enti keexiya keethati shango haada melanne","poem":1},{"text":"gaabba mela laaletana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Iita asati dure gididi hiixan zin7oosona;","poem":1},{"text":"shin enti dhiskofe barkiya wode aykoyka baawa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dagami di7o haathada qoponna enta bolla yaana;","poem":1},{"text":"qamma gotey enta denthidi efana.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Doloha carkoy enti de7iyasuwape pitidi efana.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Enti kessi ekanaw baqatishin,","poem":1},{"text":"qadhey bayna enta bolla wodhana.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ba kushiya baqidi enta bolla qelqisana","poem":1},{"text":"ba suyqethan enta sugi yeddana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}