{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":["“Bira bookidi kessiya bessinne",{"text":"worqaa seerisiya bessi de7ees.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Birati biittafe keyees;","poem":1},{"text":"naase birati shuchu seerisin keyees.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Asay xompe ekidi dhumaa poo7isees;","poem":1},{"text":"biitta gaathi gakanaw gelees;","poem":2},{"lineBreak":true},{"text":"sakana dhuman he shuchaa koyees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Asay de7iya bessaafe haakidi,","poem":1},{"text":"asa tohoy yedhi eronna soo gakidi,","poem":2},{"lineBreak":true},{"text":"yan gita olla bookees.","poem":2},{"text":"Wodoron yaanne haanne kuullotishe,","poem":1},{"text":"asaape koxetidi de7ees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kathi biittafe mokees;","poem":1},{"text":"shin iya giddoy taman seeridi,","poem":2},{"lineBreak":true},{"text":"shireti shireti wodhees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"He zaallafe sanpare geetetiya al7o shuchay keyees;","poem":1},{"text":"iya biittafe worqay bentees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"He shuchaa bookiya bessa xiloy erenna;","poem":1},{"text":"phircoyka be7ibeenna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iita do7ati he bessaa yedhi erokona;","poem":1},{"text":"gaammoy yaara aadhibeenna.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Asi mino zaalla mentherethees;","poem":1},{"text":"deriya bookidi xaphuwape aathidi yeggees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Zaalla lukidi kanthiya oge kessees;","poem":1},{"text":"he al7o shuchaa demmees.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Haathi he bessaara goggonna mela zeeres;","poem":1},{"text":"geemmidabata poo7o kessees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Shin cincatethi awupe bentanaw danda7ii?","poem":1},{"text":"Akeeki de7iya awee?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Asi iya gatiya erenna;","poem":1},{"text":"I de7on de7iya medhetethati de7iya biittan bentenna.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Abbaa ciimmoy, ‘Cincatethi ta giddon baawa’ yaagees.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Cincatethi worqan shametenna","poem":1},{"text":"woyko biran bentenna.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Cincatethi Ofira worqan,","poem":1},{"text":"margidenne sanpare geetetiya al7o shuchan shametenna.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Worqinne mastootey iyara liketenna;","poem":1},{"text":"worqafe oosetida al7o miishen laametenna.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Cincatetha gatey zaagolepe,","poem":1},{"text":"almaazepenne al7o shucha ubbaafe aadhees.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Toophaze geetetiya Tophe inqoy iyara liketenna;","poem":1},{"text":"walahi bayna worqan I shametenna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Yaatin, cincatethi awupe yii?","poem":1},{"text":"Akeeki awupe bentii?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"De7on de7iya medhetetha ubbaafe geemmidi de7ees;","poem":1},{"text":"salo kafoti iya demmokona.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Gadoynne hayqoy,","poem":1},{"text":"‘Nuuni cincatethaba haythan si7ida’ yaagosona.","poem":2}]},{"type":"verse","number":23,"content":["“Cincatethako efiya ogiyanne I de7iya bessaa",{"text":"erey Xoossaa xalaala.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Xoossay sa7aa gaxa ubbaa xeellees;","poem":1},{"text":"salope garsan de7iyaba ubbaa be7ees.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Xoossay carkos wolqaa immida wode,","poem":1},{"text":"haatha makida wode,","poem":2}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"iri bukana woga immida wode,","poem":2},{"lineBreak":true},{"text":"dadas oge wothida wode,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Xoossay cincatetha be7is;","poem":1},{"text":"be7idi bonchis; paacidi essis.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"He wode Xoossay asako,","poem":1},{"text":"‘Cincatethi Xoossas yayyeysa;","poem":2},{"lineBreak":true},{"text":"akeeki iitaape haakeysa’ yaagees” yaagis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}