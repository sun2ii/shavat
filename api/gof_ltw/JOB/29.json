{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":["Iyyobi kaallidi haysada yaagis;"]},{"type":"verse","number":2,"content":[{"text":"Ha77i ta de7iya duussay,","poem":1},{"text":"Xoossay beni tana naagida wodiyatho gideerenne!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"He wode iya xompey ta bolla poo7ees;","poem":1},{"text":"iya poo7uwan dhumaa kanthada bayis.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"He wodey Xoossay ta keethaa anjin,","poem":1},{"text":"taani ta na7atetha wolqara de7ida wode.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"He wode Ubbaa Danda7iya Xoossay taape shaaketibeenna;","poem":1},{"text":"ta nayti ta yuushon de7oosona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"He wode taani ta kushiya maathan meeccayis;","poem":1},{"text":"shucha biittan toketida shamahoy,","poem":2},{"lineBreak":true},{"text":"shaafa haathada goggiya zayte immees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Taani katamaa pirda keethaa bida wode,","poem":1},{"text":"shangotara issife uttayis.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"He wode na7atethati tana be7idi oge yeddoosona;","poem":1},{"text":"cimati tana bonchanaw dendi eqidosona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Halaqati oda aggaagidosona;","poem":1},{"text":"banta kushiya banta doona bolla wothidosona.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"He kataman de7iya gita asati si77i gidoosona;","poem":1},{"text":"enta inxarsay enta kottonuwa baqidi oykis.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tabaa si7ida ubbay nashshees;","poem":1},{"text":"tana be7ida ubbay bonchees.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hessi haniday,","poem":1},{"text":"taani manqota waasuwa si7ada ashshida gishonne,","poem":2},{"lineBreak":true},{"text":"yi7o nayta maaddida gishosa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hayqana haniya asati tana anjidosona;","poem":1},{"text":"am7eti ta maaduwan ufaytidosona.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Xillotethaa ma7oda ma7as;","poem":1},{"text":"suure pirdaa afilada ma7as;","poem":2},{"lineBreak":true},{"text":"barneexada wothas.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Taani qooqetas ayfe,","poem":1},{"text":"wobbetas toho gidas.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Manqotas aawa gidas;","poem":1},{"text":"oge asas xabaqa gidas.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Taani iitata gacuwa menthas;","poem":1},{"text":"enti bonqidaysa enta doonape yegisas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Taani ta wozanan, “Ta laythay shafeda darin,","poem":1},{"text":"ta son bonchon hayqana” gada qopas.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Taani xaphuwa haathan yeddida,","poem":1},{"text":"tashiya bolla aki kumida mitha melashin!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ta bonchetida mela de7as;","poem":1},{"text":"ta wolqay ubba wode oorathishin!","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ta haasaya wode si77i gidi si7ees;","poem":1},{"text":"ta zoriya ufaysan ekoosona.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ta entana alliya gisho,","poem":1},{"text":"ta oda simmin taape guyera odiya asi baawa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Goshshanchoy ira naageysada,","poem":1},{"text":"enti ta haasaya si7anaw hakankidi naagoosona.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Enti hirgan de7ishin ta som7uwa pashkisayis;","poem":1},{"text":"ta miichay enta minthethees.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Taani enti daana ogiya doorada entaw halaqa gidas.","poem":1},{"text":"Ba olanchota giddon de7iya kawoda ta enta giddon de7as;","poem":2},{"lineBreak":true},{"text":"enti azzaniya wode minthethas.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/28.json","previousChapterAudioLinks":{},"numberOfVerses":25}