{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":3,"content":[{"type":"heading","content":["Iyyoba Haasaya"]},{"type":"verse","number":1,"content":["Hessafe guye, Iyyobi ba doona dooyidi, ba yeletida gallasaa haysada yaagidi baaddis."]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Taani qanthatida qammaynne","poem":1},{"text":"yeletida gallasay baadetidaba gido!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"He gallasay dhuman laameto!","poem":1},{"text":"Salo Xoossay he gallasaa qopofo;","poem":2},{"lineBreak":true},{"text":"iya bolla poo7oyka poo7opo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sakana dhuminne caagani iya goozo;","poem":1},{"text":"iya shaarii kammo;","poem":2},{"lineBreak":true},{"text":"iya poo7uwa dhumi qoso.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"He gallasaa qamma sakana dhumi oyko.","poem":1},{"text":"Laytha giddon de7iya gallasatan taybetofo;","poem":2},{"lineBreak":true},{"text":"ageenata taybonka gelopo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"He qammay mayno;","poem":1},{"text":"ufaysa ililsi iyan si7etofo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Leewataane","poem":1},{"noteId":0},{"text":"denthanaw danda7eysatinne","poem":1},{"text":"gallasata baaddeysati he gallasaa baaddo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"He qamman bakali poo7opo;","poem":1},{"text":"poo7o naagidi demmofo;","poem":2},{"lineBreak":true},{"text":"wonta xalqey iyaw dolopo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"He gallasay taani ta aaye ulon qanthatonna melanne","poem":1},{"text":"ha waayiya be7onna mela ashshiboona gisho baadetidaysa gido.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Taani ta aaye ulon haatha gidida gidarkina!","poem":1},{"text":"Ta aaye ulope yeleta wodhida mela hayqida gidarkina!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ta aayiya tana ayis ba ki7on ekadesha?","poem":1},{"text":"Ba dhanthaaka tana ayis dhanthadesha?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"He wode taani hayqidaba gidiyako,","poem":1},{"text":"ha77i taani shempada dhiskana shin!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ha77i laaletida bessata bantaw keexida,","poem":1},{"text":"ha sa7aa kawotaranne zoreysatara,","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"enta keethan worqaynne biray kumida halaqatara","poem":2},{"lineBreak":true},{"text":"issife duufon zin7anashin!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Woyko bosha gididi yeletida na7ada,","poem":1},{"text":"gallasa poo7o be7iboona yooga na7ada biitta giddon ayis qosetabikina?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Duufon iitati banta iita ooso aggoosona;","poem":1},{"text":"yan daaburanchoti shempoosona.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"He bessan qasho asati shempidi ufaytoosona;","poem":1},{"text":"enta un7etheyisata waasuwa yan si7okona.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Gitinne guuthi yan de7ees;","poem":1},{"text":"aylletika aylletethafe yan la77a keyoosona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Meton de7eysatas,","poem":1},{"text":"shempoy cametidaysatas,","poem":2},{"lineBreak":true},{"text":"poo7oy ayis imetidee?","poem":2}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Hayqo amotidi demmonaysatas,","poem":2},{"lineBreak":true},{"text":"qottidi wothida shalope aathidi koyeysatas,","poem":2},{"lineBreak":true},{"text":"de7oy ayis imetidee?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Duufo gakiya wode ufayteysatas,","poem":1},{"text":"de7oy ayis imetidee?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ogey dhayida uraas,","poem":1},{"text":"Xoossay iya yuushuwa dirida uraas,","poem":2},{"lineBreak":true},{"text":"poo7oy ayis imetidee?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ooley taw kathi gidis;","poem":1},{"text":"ta waasoy goggiya haathi gidis.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Taani yayyidabay ta bolla gakis;","poem":1},{"text":"taani dagammidabay taw hanis.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Taw metope attishin,","poem":1},{"text":"saroy, wopinne shempoy baawa” yaagis.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Leewataane: Haathan de7iya wolqaama do7a.","reference":{"chapter":3,"verse":8}}]},"thisChapterLink":"/api/gof_ltw/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":25}