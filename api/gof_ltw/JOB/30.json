{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":["Shin ha77i taape na7attiya asati tana qelqisoosona.",{"text":"Enti ta dorsa wudiya heemmiya kanatara pee7onna mela","poem":2},{"lineBreak":true},{"text":"taani diggida aawata nayta.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Enta aawati wolqi ixidaysatanne","poem":1},{"text":"gilqata gidiya gisho tana aykoka maaddibokona.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Metoynne koshi un7ethin,","poem":1},{"text":"biitta bazzo bidi xapho coommosona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Cumadhenne bonco maxidosona;","poem":1},{"text":"mal7onna sankara xapho midosona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Asi waassishe kayso gooddeysada,","poem":1},{"text":"entana asaa giddofe gooddidosona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Enti zangaaran, gongoloninne","poem":1},{"text":"zaalla qophon de7idosona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Enti woran do7ada waassishe yuuyidosona;","poem":1},{"text":"aguntha giddon shiiqidi issife de7idosona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Enti biittafe goodetidosona;","poem":1},{"text":"sunthi bayna eeyata gididi de7idosona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ha77i enta nayti tana yethan caddoosona;","poem":1},{"text":"taani enta giddon hayses attas.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Enti tana shaatetidi taape haakoosona;","poem":1},{"text":"yeellatonna ta som7on cuttoosona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Xoossay ta wolqaa laafethidi tana kawushida gisho,","poem":1},{"text":"enti tana qohanaw yeda para gididosona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Seeri bayna diccida nayti ta bolla dendidosona;","poem":1},{"text":"ta tohuwas xihe wothidosona;","poem":2},{"lineBreak":true},{"text":"enti tana dhaysanaw teqidosona.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Enti ta ogiya gordidi tana dhaysanaw koyoosona;","poem":1},{"text":"enti hessa oothonna mela teqiya oonika baawa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Olanchoti katama dirsaa menthidi geleysada,","poem":1},{"text":"enti ta bolla yidosona.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Taani gita dagama dagammas;","poem":1},{"text":"ta bonchoy carkoy efiyada bis;","poem":2},{"lineBreak":true},{"text":"ta saro duussay shaarada dhayis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ta shempiya daro un7etasu;","poem":1},{"text":"metoy tana cuucummidi oykis.","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Qamma qamma sahoy ta meqetha coommees;","poem":2},{"lineBreak":true},{"text":"seelay taw shempo immenna.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Xoossay ba gita wolqan ta ma7uwa shiishidi oykis;","poem":1},{"text":"qoodhe oykiya ma7oda tana cuullis.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Xoossay tana urqan holis;","poem":1},{"text":"taani baananne bidinthe gidas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Abeeti Xoossaw, taani neeko waassayis;","poem":1},{"text":"shin neeni tana allabaka.","poem":2},{"text":"Eqada nena woossas;","poem":1},{"text":"shin neeni ta woosa si7abaka.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Neeni taw wozana mino gidadasa;","poem":1},{"text":"ne gita wolqan tana yedethaasa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Neeni tana carkora denthada gooddadasa;","poem":1},{"text":"goten tana harqadasa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Asa ubbaas wursethi gidida,","poem":1},{"text":"hayqos ne tana aatha immanaysa erayis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Meqida asi, “Tana maaddarki” gidi waassin,","poem":1},{"text":"iyaw qadhetonna asi de7ii?","poem":2}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"waayen de7eysatas ta yeekabikina?","poem":2},{"lineBreak":true},{"text":"manqotas ta qadhetabikina?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Lo77oba demmana gada amotas shin iitabay gakis;","poem":1},{"text":"Taw sa7i keehana gada naagas shin gallasi taw dhumis.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ta wozanay hirga aggibeenna;","poem":1},{"text":"taani wopa demmabike;","poem":2},{"lineBreak":true},{"text":"un7a qammi ta bolla gakis.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ta asatethay awa suulon gidonashin azzanon kareexis;","poem":1},{"text":"taani deriya shiiquwan eqada maade koyayis.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Taani worakanatas isha,","poem":1},{"text":"diidinthas lagge gidas.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ta gogay kareexidi poqeti poqeti wodhees;","poem":1},{"text":"ta asatethay mishan xuugetees.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ta ufaysi qoncisiya diithinne suusul7ey,","poem":1},{"text":"ha77i ta zelelsas gidis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/29.json","previousChapterAudioLinks":{},"numberOfVerses":31}