{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":[{"text":"“Geela7o xeellada amottonna mela,","poem":1},{"text":"taani ta ayfiyara caaqetas.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bollan de7iya Xoossaa matape asas imetida qaaday aybee?","poem":1},{"text":"Salon de7iya Ubbaa Danda7iya Xoossay asas immiya gishoy aybee?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iitata bolla boshi, bala ootheyisata bolla gadoy","poem":1},{"text":"gakanaysi eretidaba gidenneyee?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Xoossay ta ogiya ubbaa be7eneyee?","poem":1},{"text":"ta tanguwa ubbaa taybeneyee?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Taani wordon de7idaba gidiko,","poem":1},{"text":"ase cimmidaba gidiko,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xoossay tana like mizaanen mazzano;","poem":1},{"text":"yaatidi ta xillo gideysa be7o.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta hemethay ogepe keydaba gidiko,","poem":1},{"text":"ta wozanay ta ayfey xeellidaba amotidaba gidiko,","poem":2},{"lineBreak":true},{"text":"ta kushey nagaran tunidaba gidiko,","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ta dolay shodetidi dhayo;","poem":2},{"lineBreak":true},{"text":"ta zeridaysa hari mo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Ta wozanay hara maccas amotidaba gidiko,","poem":1},{"text":"woyko taani ta shooruwa machiw geeddidaba gidiko,","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ta machiya hara asas gaacco;","poem":2},{"lineBreak":true},{"text":"iira hara addey aqo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hessi yeellayiya nagaras koshshiya","poem":1},{"text":"gita pirda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ha nagaray tamada xuuggiyaba gidiya gisho,","poem":1},{"text":"ta aquwa ubbaa dhaysanashin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Ta adde woyko ta macca aylleti abeeti gin,","poem":1},{"text":"entaw pirdonna ixidaba gidiko,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Xoossa sinthan ta pirdas shiiqiya wode waananee?","poem":1},{"text":"I tana oychiya wode taani woyga zaaranee?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tana medhida Xoossay enta I medhibeneyee?","poem":1},{"text":"Nuna ubbaa nu aaye ulon medhiday issi iya gidenneyee?","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Taani manqoti woossidaba diggidaba gidiko,","poem":1},{"text":"woyko am7eta minthethonna aggidaba gidiko,","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"yi7o nayti mela aqiya wode be7ashe, taani tarka midaba gidiko,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Taani enta ta na7atethafe doomada enta aawada dichas;","poem":1},{"text":"ta yeletoosope doomada am7eta maaddas.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ma7oy dhayin meegoy wodhiya uraa,","poem":1},{"text":"woyko kallo de7iya metootanchuwa be7ada,","poem":2}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ta dorsata ikisepe oosetida ma7o mayzin,","poem":2},{"lineBreak":true},{"text":"tana anjona biday de7iko,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Taani mooton enta shatimmanaysa erada,","poem":1},{"text":"yi7o nayta naaqidaba gidiko,","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ta qesey kuriyape me77o;","poem":2},{"lineBreak":true},{"text":"ta kushey hashiyape kareti wodho.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Xoossaa hanquwa yayyida gisho","poem":1},{"text":"hessa oothanaw danda7ike.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“Taani worqan ammanetidaba gidiko,","poem":1},{"text":"woyko walahi bayna worqaa ‘Ta ceeqoy nena’ gidaba gidiko,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ta duretetha darotethan,","poem":1},{"text":"ta kushey demmida wodhen ufaytidaba gidiko,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Awa phoolethi be7ada,","poem":1},{"text":"woyko ageena lo77otethi xeellada,","poem":2}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ta wozanay geeman enta nashshibeenna,","poem":2},{"lineBreak":true},{"text":"woyko ta enta yeerada goyinnabike.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Hessi pirda ehiya nagara gidiya gisho","poem":1},{"text":"Xoossaa kaddas guussu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Ta morketa kundethan ufaytabike;","poem":1},{"text":"enta gakida metuwan hashshu gabike.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"‘Ta morkey dhayo’ yaaga baaddada,","poem":1},{"text":"nagara oothabike.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ta soo asay, ‘Iya son","poem":1},{"text":"kathi midi kallonnay oonee?’ yaagidi markatoosona.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ta soy ubba wode dooya gidiya gisho,","poem":1},{"text":"oge asi karen aqi erenna.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Harati ootheysada,","poem":1},{"text":"ta nagaraa ta wozanan genthabike.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Asa pokos yayyada,","poem":1},{"text":"enta boriyas dagammada,","poem":2},{"lineBreak":true},{"text":"soo gelada qosetida wodey deenna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"“Tana si7iya asi de7eerenneshin,","poem":1},{"text":"Ta oday tuma gideysa paramayis;","poem":2},{"text":"Ubbaa Danda7iya Xoossay taw zaaro immo","poem":1},{"text":"Ta morkey ba mootuwa xaafidi shiishin","poem":2},{"lineBreak":true},{"text":"ta be7arkinashin.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Be7iyako woytoda qoodhen aathada ma7anashin,","poem":1},{"text":"Kallachada ta huuphen wothanashin!","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Taani maati de7iya asada xoossaako shiiqada,","poem":1},{"text":"ta oothidaba ubbaa iyaw qoncisanashin!","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"“Ta goshsha biittay ta bolla waassidaba gidiko,","poem":1},{"text":"daasatika afuthan laakidaba gidiko,","poem":2}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"he biittan kaxidaba miishe qanxonna ekidaba gidiko,","poem":2},{"lineBreak":true},{"text":"woyko he biitta ootheyisata koshan wodhidaba gidiko,","poem":2}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"taw he biittan giste gisho agunthi,","poem":2},{"lineBreak":true},{"text":"banga gisho sharaafi dolo” yaagis.","poem":2},"Iyyoba oday hessan poletis."]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}