{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":32,"content":[{"type":"heading","content":["Elihu Haasaya"]},{"type":"verse","number":1,"content":["Iyyobi, “Taani xillo asi” gida gisho, ha heedzu asati iyaw zaaro imo aggaagidosona."]},{"type":"verse","number":2,"content":["Iyyobi Xoossaafe aathidi bana xillo oothida gisho, Rama yarape gidida Buza biittafe yida Barkela na7ay Elihuy Iyyoba bolla hanqetis."]},{"type":"verse","number":3,"content":["Enti iya coo bala gidi pirdidi, iyaw bessiya zaaro immanaw danda7iboona gisho Elihuy ha heedzu laggeta bollaka hanqetis."]},{"type":"verse","number":4,"content":["Elihuy entafe kaalotiya gisho enti ubbay haasaya wursana gakanaw naagis."]},{"type":"verse","number":5,"content":["Ha heedzu asati Iyyobas bessiya zaaro immanaw danda7iboonaysa be7idi I daro yilotis."]},{"type":"verse","number":6,"content":["Buza biittafe yida Barkela na7ay Elihuy haysada yaagidi haasaya doomis.",{"text":"“Taani hintefe na7atayis;","poem":1},{"text":"hinte taape bayrateta;","poem":2},{"lineBreak":true},{"text":"Hessa gisho, taani ta qofaa hintew odanaw yayyas.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Taani, ‘Cimati odeto;","poem":1},{"text":"banta daro laythan demmida cincatethaa tamaarsonna’ ” gada qopas.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Shin asa giddon aqidi cincatethi immey,","poem":1},{"text":"Ubbaa Danda7iya Xoossaa Ayyaana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ase cinca oothey cimatethi gidenna,","poem":1},{"text":"woyko asas akeeka immey laytha darotethi gidenna.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hessa gisho, si7ite;","poem":1},{"text":"taka ta qofaa hintew odana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hinte haasaya wode,","poem":1},{"text":"taani si77i gada hayzas;","poem":2},{"lineBreak":true},{"text":"hinte odana qaala koyishin naagas.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hinte geysa ubbaa wursada si7as;","poem":1},{"text":"shin hintefe oonika Iyyoba bala gidi ammanthibena;","poem":2},{"lineBreak":true},{"text":"hintefe oonika iya palamas bessiya zaaro immibeenna.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Iyyoba odaas kalsiya zaaro immanaw danda7ey,","poem":1},{"text":"Xoossefe attishin, ase gidonna gisho,","poem":2},{"lineBreak":true},{"text":"hinte, “Nuus cincatethi de7ees” goopite.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iyyobi palamiday taara gidonashin hintera;","poem":1},{"text":"taani hinte odada iyaw zaaro immike.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Enti dagammidi,","poem":1},{"text":"gaanaba dhayida gisho,","poem":2},{"lineBreak":true},{"text":"zaaro immanaw danda7ibookona.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yaatin enti odetiyaba dhayidi si77i gidi eqiko,","poem":1},{"text":"taani naaganaw koshshii?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Gidenna, taani odiyabay de7ees;","poem":1},{"text":"taka ta qofaa qoncisana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ta odanabay daroy de7iya gisho,","poem":1},{"text":"ta giddon de7iya ayyaanay tana oda gidi sugees.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ta gaathay goozetida manaaceda,","poem":1},{"text":"woyko mal7anto woyne ushshi kumida ogoroda","poem":2},{"lineBreak":true},{"text":"dhuuqana hanees.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ta odada kessanaw bessees;","poem":1},{"text":"ta doona dooyada zaaro immanaw koshshees.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ha odan taani oonaka maaddike,","poem":1},{"text":"woyko oonaka coo sabbike.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ase coo sabbiyabay taw eretenna;","poem":1},{"text":"ta hessa oothiyako tana medhidaysi pirdanashin.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/31.json","previousChapterAudioLinks":{},"numberOfVerses":22}