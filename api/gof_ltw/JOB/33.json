{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":["Iyyoba, ha77i ta odaa si7a;",{"text":"ta giyaba ubbaa hayza.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taani ta doona dooyas;","poem":1},{"text":"ta qaalati ta inxarsaa xeeran de7oosona.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ta qaalati ta wozana suuretetha qoncisosona;","poem":1},{"text":"ta ereysa ta inxarsay tumatethan odees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tana medhiday Xoossaa Ayyaana;","poem":1},{"text":"Ubbaa Danda7iya Xoossaa shempoy taw de7o immis.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne danda7iko taw zaaro imma;","poem":1},{"text":"nena giigisada taara palama.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taani Xoossaa sinthan ne mela;","poem":1},{"text":"taanika urqafe medhetas.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Neeni taw yayiya gaasoy baawa;","poem":1},{"text":"taani nena naaqike.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Ne haasaya ubbaa taani si7ashe gam7as;","poem":1},{"text":"ne doonape keyida qaalata hayzas.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Taani geeshshinne borey bayna asi;","poem":1},{"text":"taani xillonne nagara oothaboonna asi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Shin Xoossay tana seeranaw gaaso koyees;","poem":1},{"text":"I tana ba morkeda taybees.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ta tohuwa duxis;","poem":1},{"text":"ta tango ubbaa I wochees” yaagadasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Iyyoba, ne oday like gidenna;","poem":1},{"text":"ta new odayis, Xoossay asape aadhees.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"‘Xoossay asa odaas zaaro immenna’ gada,","poem":1},{"text":"ayis iyara palamay?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Asi akeekennafe attishin,","poem":1},{"text":"Xoossay dumma dumma ogera odees.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Asi qamma hiixan zin7idi,","poem":1},{"text":"dhisko eeyidi de7iya wode,","poem":2},{"lineBreak":true},{"text":"Xoossi amuhoninne qoncethan odees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"He wode asay si7anaada haythe dooyees;","poem":1},{"text":"ba seeran enta daganthees.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yaatidi asi nagara oothonna mela teqees;","poem":1},{"text":"otoro asape diggees.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Xoossi ase dhayope ashshees;","poem":1},{"text":"hayqopeka naagees.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Asi hargetidi hiixan de7ishin,","poem":1},{"text":"iya meqethaa garsan qanxonna saho yeddidi seerees.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hessada hanidi hargida uray kathi ixees;","poem":1},{"text":"daro mal7o kathi iya shaatees.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Iya ashoy gilqidi wurees;","poem":1},{"text":"iya asatethay melin meqethi taybetees.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Iya shempoy duufoko,","poem":1},{"text":"iya de7oy hayqo kiitanchotako matees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“Asas suure ogiya bessiya","poem":1},{"text":"mukulun taybetiya kiitanchotape","poem":2},{"lineBreak":true},{"text":"issoy iya maaddanaw danda7ees.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Iyaw qadhetidi, ‘I duufo gelonna mela iya ashsha;","poem":1},{"text":"taani iya woziyaba demmas;","poem":2},{"lineBreak":true},{"text":"iya aggaaga’ yaagidi hayqos odees.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Hessa gisho, iya asatethay na7a asatethi gidana;","poem":1},{"text":"iya yalagatetha wolqay iyaw simmana.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"He wode I Xoossaa woossana;","poem":1},{"text":"Xoossay iya woosa si7ana;","poem":2},{"lineBreak":true},{"text":"Xoossay iyaw iya xillotethaa zaariya gisho, I ufaysan Xoossaa goyinnana.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"He wode asa sinthan I haysada yaagidi yexana;","poem":1},{"text":"‘Taani nagaraa oothas; suureba geellayas;","poem":2},{"lineBreak":true},{"text":"shin Xoossay ta hanuwa taw qanxibeenna.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ta duufon gelonna mela tana ashshis;","poem":1},{"text":"ha77i paxa de7ada poo77o be7ayis’ yaagana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Heko, Xoossi asas hessa ubbaa","poem":1},{"text":"zaari zaari oothees.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"I de7o poo7o be7ana mela,","poem":1},{"text":"iya shempuwa duufope ashshees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Iyyoba, taani odeysa hayzada si7a;","poem":1},{"text":"ane ne si77i ga; taani odetana.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ne odanaw koyaabay de7iko oda;","poem":1},{"text":"taani ne xillo gideysa be7anaw koyayis.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Atto giiko si77i gada, ta haasaya si7a;","poem":1},{"text":"ta nena cincatethi tamaarsana” yaagis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/32.json","previousChapterAudioLinks":{},"numberOfVerses":33}