{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":34,"content":[{"type":"verse","number":1,"content":["Qassika Elihuy haysada yaagis;"]},{"type":"verse","number":2,"content":[{"text":"“Hinteno, cincato ta haasaya si7ite;","poem":1},{"text":"hinteno, eranchoto tana hayzite.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inxarsi mal7o kathi shaaki ereysada,","poem":1},{"text":"haythi oda shaakidi erees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ane nuuni suureba shaakidi,","poem":1},{"text":"lo77oba tamaaridi eroos.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Iyyobi, ‘Taani xillo;","poem":1},{"text":"shin Xoossi tana suure pirdaa diggis.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taani tuma shin wordancho gidas;","poem":1},{"text":"tanan bali baawa shin,","poem":2},{"lineBreak":true},{"text":"paxonna madunthi madunxisis’ yaagis.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iyyobada Xoossa bolla,","poem":1},{"text":"qelqisiya asi de7ii?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"I iita ootheysatara laggetees;","poem":1},{"text":"nagaranchotara hemetees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"I, ‘Asi Xoosse ufaysana gidi oothiyabay","poem":1},{"text":"aykoka maaddenna’ yaagees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Hessa gisho, hinteno, akeekancho asato si7ite,","poem":1},{"text":"iita oosoy Xoossaafe,","poem":2},{"lineBreak":true},{"text":"Ubbaa Danda7iya Xoossaafe bala oosoy haako.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Xoossay asas iya oosuwada immees;","poem":1},{"text":"iya ogiyada iyaw qanxees.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xoossay tuma iita oothenna;","poem":1},{"text":"Ubbaa Danda7iya Xoossay suure pirdaa geellayenna.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sa7a bolla iyaw maata immiday oonee?","poem":1},{"text":"biitta ubbaa bolla iya shuumiday oonee?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Xoossay ba Ayyaananne ba de7o shempuwa","poem":1},{"text":"zaaridi baako ekiyako,","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"asho ma7ida ubbay issife dhayana;","poem":2},{"lineBreak":true},{"text":"asi biitta simmanashin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“New akeeki de7iko haysa si7a;","poem":1},{"text":"ta haasaya hayza.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Suure pirdaa ixey haaranaw danda7ii?","poem":1},{"text":"Neeni xillonne wolqaama Xoossaa pirday?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Xoossay kawotako, ‘Hinte pathonayisata’;","poem":1},{"text":"qassi biitta haareysatako, ‘Hinte iita’ yaagees.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Enti ubbay iya kushe oosota gidiya gisho,","poem":1},{"text":"Halaqata som7o xeellidi maaddenna;","poem":2},{"lineBreak":true},{"text":"dureta manqotape aathidi xeellenna.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Enti gidi bilahe akeekona hayqana;","poem":1},{"text":"ubbay kokorishe dhayana;","poem":2},{"lineBreak":true},{"text":"wolqaamati asa kushey bochonna kichana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Xoossay asa hemethaa xeellees;","poem":1},{"text":"iya tango ubbaa wochees.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Iita ootheyisata,","poem":1},{"text":"genthanaw danda7iya sakana dhumi baawa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Asay iya sinthe pirdas shiiqana mela,","poem":1},{"text":"Xoossay qaxaro immenna.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Oyshi bayna wolqaamata mentherethees;","poem":1},{"text":"enta bessan harata shuumees.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"I enta oosuwa eriya gisho,","poem":1},{"text":"enta issi qamman maatape wothidi dhaysees.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Enta iitatethaa gisho,","poem":1},{"text":"nagaranchota asa sinthan seerees.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Hessa I oothey,","poem":1},{"text":"enti iya kaallonna ixida gishonne","poem":2},{"lineBreak":true},{"text":"iya kiitaa aggida gishosa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Enti manqota un7ethidi Xoossako waassana mela oothidosona;","poem":1},{"text":"Xoossay manqota waasuwa si7is.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Xoossay si77i giiko iya oone mootanay?","poem":1},{"text":"I ba som7uwa qosiko iya be7anay oonee?","poem":2},{"lineBreak":true},{"text":"I asaapenne kawotethaafe bolla.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Hessi haniday geellay deriya haaronna melanne","poem":1},{"text":"enta sinthan xihe wothonna melasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Asi Xoossako yaagiyako Lo77o;","poem":1},{"text":"kase ta nagara oothidaba gidiko zaarada oothike.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ta be7onnaysa tana tamaarsa;","poem":1},{"text":"nagara oothidaba gidiko zaarada oothike.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Yaatin neeni paaxike gashe,","poem":1},{"text":"ne doseysa mela Xoossay new woytaneyee?","poem":2},{"text":"Hiza qofa qachanay nenape attishin, tana gidike;","poem":1},{"text":"hessa gisho, ne ereysa taw oda.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Akeeka asay haysada yaagosona;","poem":1},{"text":"cincati yaagosona;","poem":2}]},{"type":"verse","number":35,"content":[{"text":"‘Iyyobi eri bayna odetees;","poem":1},{"text":"Iya odan ayfey baawa.’","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Iyyobi iita asada zaaro immida gisho,","poem":1},{"text":"wursethi gakanaw paacetida gideerenne!","poem":2}]},{"type":"verse","number":37,"content":[{"text":"I ba nagaraa bolla geellatethi gujis;","poem":1},{"text":"nu sinthan Xoossaa bolla qelqisis;","poem":2},{"lineBreak":true},{"text":"Xoossa bolla daro odetis” yaagis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/33.json","previousChapterAudioLinks":{},"numberOfVerses":37}