{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":["Elihuy qassi haysada yaagis;"]},{"type":"verse","number":2,"content":[{"text":"“Iyyoba, neeni, ‘Taani Xoossaa sinthan xillo’","poem":1},{"text":"geysi likee?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"‘Taani nagaraa oothonna aggada ay go7etiyana?","poem":1},{"text":"ay wodhe demmanee?’","poem":2},{"lineBreak":true},{"text":"yaagada ne Xoossaa oychanaw danda7aasa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taani newunne","poem":1},{"text":"ne laggetas zaaro immana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dhoqu gada salota xeella;","poem":1},{"text":"neepe bollara de7iya shaara akeekada be7a.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne nagara oothiko Xoossaa aybin qohanee?","poem":1},{"text":"Ne balay dariko hessi iyaw ay oothii?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne xillo gidiko iyaw ay immanee?","poem":1},{"text":"Woyko ne kushepe I ay ekanee?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne nagaraa oothiko ne mela ase qohaasa;","poem":1},{"text":"qassi xillikoka ase go77aasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Un77i dariya wode asay waassees;","poem":1},{"text":"wolqaamata kushepe kessi ekiya asi koyidi wobbatoosona.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Shin oonika, ‘Qamma mazmure immiya,","poem":1},{"text":"tana medhida Xoossay awun de7ii?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Do7atape aathidi tamaarseysi,","poem":2},{"lineBreak":true},{"text":"kafotape aathidi cinca ootheysi awun de7i’ yaagenna.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Enti waassoosona;","poem":1},{"text":"shin Xoossay enta otoruwa gaason,","poem":2},{"lineBreak":true},{"text":"entaw zaaro immenna.","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Coo waasuwa Xoossi tuma si7enna;","poem":2},{"lineBreak":true},{"text":"Ubbaa Danda7iya Xoossay hessa hayzenna.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Neeni ta Xoossaa be7anaw danda7ike yaagikoka,","poem":1},{"text":"ne mootoy iya sinthan de7iya gisho,","poem":2},{"lineBreak":true},{"text":"ne iya danda7an naaganaw bessees.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Xoossay ase pirdonnabaanne","poem":1},{"text":"nagara aggidi aadhana gada qopay?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hessa gisho, neeni ne doona coo dooyasa;","poem":1},{"text":"eri bayna haasaya darsaasa” yaagis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}