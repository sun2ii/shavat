{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":36,"content":[{"type":"verse","number":1,"content":["Elihuy gujidi haysada yaagis;"]},{"type":"verse","number":2,"content":[{"text":"“Xoossaa doona gidada ta new odiyabay de7iya gisho,","poem":1},{"text":"guuthu danda7ada si7a.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taani ta eraa haaho soope ehana;","poem":1},{"text":"tana Medhidaysi xillo gideysa qoncisana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taani wordo haasayike;","poem":1},{"text":"kumetha eri de7iya asi neera de7eysa ammana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Xoossay tuma wolqaama;","poem":1},{"text":"shin I oonaka kadhenna.","poem":2},{"lineBreak":true},{"text":"I ba akeekan mino.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I iitati de7on daana mela oothenna;","poem":1},{"text":"shin un7etidaysatas suure pirdees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Xoossay ba ayfiya xillota bollafe denthenna;","poem":1},{"text":"enta kawotara utisidi,","poem":2},{"lineBreak":true},{"text":"merinaw dhoqu dhoqu oothees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Shin asay santhalaatan qashetiko,","poem":1},{"text":"woyko meto wodoron oyketiko,","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I enta oosuwanne","poem":2},{"lineBreak":true},{"text":"otoron oothida nagaraa enta bolla qoncisees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Seera si7anaada enta haytha dooyees;","poem":1},{"text":"nagarape simmana mela enta kiittees.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Enti si7idi iyaw kiitetiko,","poem":1},{"text":"banta laytha saroninne ufaysan wursana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Shin enti si7onna ixiko mashshan wurana;","poem":1},{"text":"enti era dhayida gisho hayqana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Xoossaa ammanonna asati","poem":1},{"text":"banta wozanan yilotida mela de7oosona;","poem":2},{"lineBreak":true},{"text":"I enta pirdiya wode maade koyidi woossokona.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Enti oothiya tuna oosuwan dhayana;","poem":1},{"text":"banta na7atethan hayqana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Shin waayeteyisata enta waayiyape ashshees;","poem":1},{"text":"enta metuwa baggara entaw odees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Xoossay nena meto wodorope,","poem":1},{"text":"un7i bayna dalga bessi,","poem":2},{"lineBreak":true},{"text":"dooretida kathi kumida gaytaako kessana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Shin ha77i iitata bolla gakiya pirday ne bolla gakin;","poem":1},{"text":"xillo pirdan oyketadasa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Oonika nena duretethi bessidi cimmonna mela,","poem":1},{"text":"wodhaafe daroy balethonna mela naageta.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ne duretethay","poem":1},{"text":"woyko ne dafetethay nena metope ashshanee?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Asay banta bessaafe dhayiya qammay,","poem":1},{"text":"yaana mela amottofa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ha meto ubbay nena gakiday hessa gaasona;","poem":1},{"text":"hessa gisho, iita oothonna mela naageta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Xoossay ba wolqan dhoqu dhoqu gis;","poem":1},{"text":"iya mela astamaarey oonee?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Xoossaa, ‘Haysa ootha’ gidi kiittey,","poem":1},{"text":"woyko, ‘Neeni iita ooso oothadasa’ yaaganaw danda7ey oonee?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Asay mazmuren sabbida iya oosuwa,","poem":1},{"text":"neka mazmuren sabba.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Asa koche ubbay Xoossaa oosuwa be7is;","poem":1},{"text":"asay haahon eqidi xeellidosona.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Xoossay gita! Iya gitatetha nu akeekanaw danda7oko;","poem":1},{"text":"iya laytha darotethaas zawi baawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Xoossay haathe abbafe pude salo efees;","poem":1},{"text":"duge zaaridi ira oothidi bukisees.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"He iray shaarape keyidi,","poem":1},{"text":"asa bolla bukana mela oothees.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Xoossi shaara waatidi micciyako,","poem":1},{"text":"Xoossay de7iya saluwan waanidi guummiyako,","poem":2},{"lineBreak":true},{"text":"oonika erenna.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"I ba yuushon wol7antha poo7uwa laallees;","poem":1},{"text":"abba ciimmuwa waatidi kammiyako be7a.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Yaatidi Xoossay deriya aysees;","poem":1},{"text":"kathaa darsidi immees.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"I wol7anthi ba kushen oykees;","poem":1},{"text":"ba mallida bessaa caddana mela kiittees.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Dadi dhuuqidi uushoy yaanaysa bessees;","poem":1},{"text":"meheyka uushoy yaanaysa erees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/35.json","previousChapterAudioLinks":{},"numberOfVerses":33}