{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":37,"content":[{"type":"verse","number":1,"content":["“Iya uushuwan ta wozanay dirgees;",{"text":"ba bessan qaaxees.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iya doonape keyiya qaala si7ite;","poem":1},{"text":"dadada guummiya iya girsaa hayzite.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"I salo garsan ba wol7antha laallees;","poem":1},{"text":"biitta gaxape gaxa gakanaw kiittees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hessafe guye, iya guunthay si7etees;","poem":1},{"text":"ba yashshiya girsaa sissees.","poem":2},{"text":"Iya girsay si7etiya wode,","poem":1},{"text":"ba wol7antha teqenna.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xoossaa malaalsiya ogen ba guuntha sissees;","poem":1},{"text":"nuuni akeekanaw danda7onna gitaba I oothees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I shachako, ‘Sa7an wodha’ yaagees;","poem":1},{"text":"wolqaama iraako, ‘Buka’ yaagidi kiittees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I medhida asa ubbay iya oosuwa erana mela,","poem":1},{"text":"asay banta oosuwa aggana mela oothees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"He wode do7ati banta bessaa geloosona;","poem":1},{"text":"banta gongoluwan qosetoosona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wolqaama gotey dugehape dendees;","poem":1},{"text":"irxa carkoy pudehape yees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Xoossaa de7o shempoy shachi medhees;","poem":1},{"text":"dalga haathata shuchada minthees.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Shaari haathe tookana mela oothees;","poem":1},{"text":"ba wol7antha shaara giddon laallees.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Shaarati iya kiitan biitta gaxaa yuuyosona;","poem":1},{"text":"I kiittiya kiita ubbaa poloosona.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Xoossay ira bukisey biitta irxisanaasa,","poem":1},{"text":"woyko asaa seeranaasa, woyko ba siiquwa bessanaasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Iyyoba, hessa si7a;","poem":1},{"text":"Xoossay oothiya malaalsiya oosuwa taki gada akeeka.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Xoossay shaarata waatidi kiittiyako,","poem":1},{"text":"ba wol7antha waatidi wol7amisiyako eray?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Shaarati salon waanidi uttiyako,","poem":1},{"text":"eran polo gidida Xoossay","poem":2},{"lineBreak":true},{"text":"oothiya malaalsiya oosuwa neeni eray?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dugeha carkoy carkidi biitta mishisiya wode,","poem":1},{"text":"neeni wolqaama bazzo seelan til7ana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Xoossay saluwa til7ida mastooteda micciya wode,","poem":1},{"text":"neeni iya maaddanaw danda7ay?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nuuni era paca gidiya gisho,","poem":1},{"text":"Xoossas woygidi odetaneko ne nuna tamaarsa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Xoossara odetana gada taani oychanaw koshshii?","poem":1},{"text":"tana dhaysana mela ta ayis iya denthethanee?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Carkoy salope shaara geeshshiya wode,","poem":1},{"text":"salon phooliya awa oonika be7anaw danda7enna.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Pudeha baggara worqaa daaniya poo7oy bentees;","poem":1},{"text":"Xoossay yashshiya teeman qoncees.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ubbaa Danda7iya Xoossaako shiiqanaw danda7oko;","poem":1},{"text":"iya wolqay gita.","poem":2},{"text":"I ba tuma pirdaaninne ba gita xillotethan","poem":1},{"text":"ase qohenna.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Hessa gisho, asay iyaw yayyees;","poem":1},{"text":"bantana cinca geyisata I kadhees” yaagis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/36.json","previousChapterAudioLinks":{},"numberOfVerses":24}