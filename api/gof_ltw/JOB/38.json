{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":38,"content":[{"type":"heading","content":["Xoossa Zaaruwa"]},{"type":"verse","number":1,"content":["Hessafe guye, Goday gote giddon gididi Iyyobas haysada yaagidi zaaris."]},{"type":"verse","number":2,"content":[{"text":"Eri bayna odan","poem":1},{"text":"ta zoriya dhumisey I hessi oonee?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ane addeda danceta;","poem":1},{"text":"ta nena oychana, taw zaara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Taani alamiya medhiya wode neeni awun de7ay?","poem":1},{"text":"Ane ne akeekiyako taw oda.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne eriko, ha sa7aa dalgatethaas zawa wothiday oonee?","poem":1},{"text":"Wadha wodoruwa sa7a bolla yeggiday oonee?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ha sa7aa tuussata kundonna mela minthidi oykiday aybee?","poem":1},{"text":"Ha sa7aa baasuwas koyro shuchaa wothiday oonee?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wonta bakalati issife yexiya wode,","poem":1},{"text":"kiitanchoti ubbay ufaysan ilili giya wode ne eray?","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Abba haathi biittafe dhuuqidi keyiya wode,","poem":1},{"text":"iya pengeta gordiday oonee?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abbaa shaara mayzas;","poem":1},{"text":"sakana dhuman gooziday tana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abbay kanthonna mela zawa medhiday,","poem":1},{"text":"iyaw pengenne teqe wothiday tana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Haysa gakanaw ya;","poem":1},{"text":"shin haysafe aadhofa;","poem":2},{"lineBreak":true},{"text":"ne wolqaama hobbey hessan eqo” yaagiday tana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Iyyoba, ne yeletoosope wonti wontana mela kiita eray,","poem":1},{"text":"away dolana bessaa malla eray?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wonta poo7oy biitta ubban poo7ana mela,","poem":1},{"text":"iita asata qosetida bessaafe qonce kessana mela,","poem":2},{"lineBreak":true},{"text":"neeni wonta kiitta eray?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wonta poo7oy zumatanne zangaarata,","poem":1},{"text":"dakoydi wothida ma7oy eqidi benteysada bessees;","poem":2},{"lineBreak":true},{"text":"oto bolla wothida maatameda qoncees.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Iitata poo7oy eketana;","poem":1},{"text":"enta makalla qesey meqana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ciimmo abba giddo gelada pultuwa be7adii?","poem":1},{"text":"Woyko iya baasuwa gakada iya olla simeretadii?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"New hayqo pengeti bentidona?","poem":1},{"text":"Woyko sakana dhumaa pengeta be7adii?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Sa7ay ay mela giteeko ne eray?","poem":1},{"text":"Hessa ubbaa ne eriya gidiko taw oda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Poo7oko efiya ogey awunee?","poem":1},{"text":"dhumi awun de7iyako eray?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Poo7onne dhuma enta bessaa bessaa efanaw danda7ay?","poem":1},{"text":"Enti de7iya bessaa efiya ogiya eray?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Neeni sa7i medhetiya wode yeletida gishonne","poem":1},{"text":"daro laythi de7ida gisho hessa eronna aggaka!","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Shachi minjetiya keethaa geladii?","poem":1},{"text":"woyko shachi dooretida bessaa be7adii?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Taani enta meto wodes, ola wodesinne","poem":1},{"text":"toora gallasas minja wothas.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Wol7anthi keya bessaa efiya ogey awun de7ii?","poem":1},{"text":"Woyko doloha carkoy awupe keyidi carkii?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Iri wodhiya bessaa giigisiday,","poem":1},{"text":"dadas oge kessiday oonee?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Asi doonna mela biittan","poem":1},{"text":"ira bukisey oonee?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Melida mela biittay iran laakidi,","poem":1},{"text":"purco maatay dolana mela oothiday oonee?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Iras aawi de7ii?","poem":1},{"text":"Woyko aka yeliday oonee?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Shachas aayiya de7ay?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Haathay shuchada minthees;","poem":1},{"text":"abba baasoy shachada uuketees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Pilaadisa geetetiya xoolintota issife gathada qachanaw danda7ay?","poem":1},{"text":"Ooriyoona geetetiya xoolintoti qashetida wodoruwa billanaw danda7ay?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Cugan cugan de7iya xoolintota enta woden woden kessanaw danda7ay?","poem":1},{"text":"Biire geetetiya xoolintota enta naytara kaalethanaw danda7ay?","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Saloti ay higgen aqiyako ne eray?","poem":1},{"text":"He higgey sa7aa haarana mela oothanaw danda7ay?","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Di7oy nena muukana mela ira bukisanaw,","poem":1},{"text":"ne qaala dhoqu oothada shaarata sissanaw danda7ay?","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Wol7anthi kiittanaw danda7ay?","poem":1},{"text":"Enti neeko yidi, “Heko, ay oothino?” goonna?","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Wozanas cincatethi,","poem":1},{"text":"kahas akeeka immiday oonee?","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Ba cincatethan shaarata taybanaw danda7ey oonee?","poem":1},{"text":"Baana munuqidi, urqa kessidi minthanaw,","poem":2},{"lineBreak":true},{"text":"salo otota gedi oothidi haathe tiganaw danda7ey oonee?","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Shankatada macca gaammos miyaba eha eray?","poem":1},{"text":"koshatida gaammo marata muza eray?","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Enti gongolon qoseti naagoosona;","poem":1},{"text":"bazzon zin7idi pee7osona.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Quuroti koshatidi daaburiya wode,","poem":1},{"text":"enta nayti miyaba demmanaw taako waassiya wode,","poem":2},{"lineBreak":true},{"text":"entaw miyaba immey oonee?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/37.json","previousChapterAudioLinks":{},"numberOfVerses":40}