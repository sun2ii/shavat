{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":39,"content":[{"type":"verse","number":1,"content":[{"text":"“Woshi7ey awude yeliyako neeni eray?","poem":1},{"text":"Baachoti bannakidi banta marata yeliya wode be7adii?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Enti ay mela ageena gam7iyako,","poem":1},{"text":"awude yeliyako ne eray?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Enti gulbati eqetidi,","poem":1},{"text":"banta marata yeley awudeko eray?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Enta marati bazzon diccidi minnoosona;","poem":1},{"text":"banta aayeta aggidi boosona; nam7antho guye simmokona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Wora hareti yeda daanada oothiday oonee?","poem":1},{"text":"Qashope enta birshidi yeddiday oonee?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Entaw bazzuwa de7iya bessi oothada immas;","poem":1},{"text":"maxine biittan enti daanada oothas.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Katama waasuwape haakidi de7oosona;","poem":1},{"text":"laaggeysta qodethi si7okona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Enti dereta bolla bantana heemmoosona;","poem":1},{"text":"yan miya purco maata qoroosona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Menthi new oothanaw ero gandee?","poem":1},{"text":"Woyko ne zadalon qamma aqandee?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Goyana mela ne iya waaxanee?","poem":1},{"text":"Woyko waaxada goyanaw danda7ay?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Neeni iya wolqaa minotethan ammanetanee?","poem":1},{"text":"deexo ooso I oothana mela iyaw yegga agganee?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Neeni kathaa shaalen qolana mela,","poem":1},{"text":"woyko wudumman shiishana mela iya ammanay?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Yanchoy ba qefiya ellesada qaathawusu;","poem":1},{"text":"shin haatha kafoda piradhanaw danda7uku.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yanchoy ba phuuphulliya biittan phuuphulawusu;","poem":1},{"text":"shafen ho7ana mela aggaagawusu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"‘Tohoy menthana,","poem":1},{"text":"bazzo do7ati yedhana’ gada qopuku.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nayti babaa gidonnaada oothada entaw daro iitawusu.","poem":1},{"text":"I daabura ubbay mela atteysi iw aykoka daanenna.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hessada oothada iyo cincatethi diggidaynne","poem":1},{"text":"akeeka dhaysiday tana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Shin dendada iya woxiya wode,","poem":1},{"text":"baara gaadetiya para bollanne paraawa bolla miiccawusu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Iyyoba, paratas wolqaa immiday,","poem":1},{"text":"woyko parata morgen cimba mayziday nenee?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Parati booleda gupanaadanne","poem":1},{"text":"garmamidi daganthanaada oothiday nenee?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Parati banta wolqan ammanetidi dhiskoosona;","poem":1},{"text":"oletanaw ola demba gaallaboosona.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yashshi erokona; enta aybika daganthenna;","poem":1},{"text":"enta bolla mashsha shoddikoka guye simmokona.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Enta toggiya olanchoti oykida ola miisheti,","poem":1},{"text":"phoolishe issoy issuwara gahetidi giiroosona.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Shin parati biitta kaashishenne yashisishe gaallaboosona;","poem":1},{"text":"Moyze girsi si7iya wode si77i gidi eqanaw danda7okona.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Moyzey punetiya wode ufaysan garmamoosona;","poem":1},{"text":"ola peeno haahon ekoosona;","poem":2},{"lineBreak":true},{"text":"toora mocona kiitaanne olanchota ceequwa si7oosona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Xiloy ba qefiya dugeha bagga miccidi,","poem":1},{"text":"paallanaw danda7ey ne cincatethanee?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Arganthi pude keyidi,","poem":1},{"text":"ba keethaa dhoqa dereta bolla keexey ne kiitanee?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Arganthi aafo doonan ba keethaa keexidi de7ees;","poem":1},{"text":"zaalla qophoti iyaw qol7a gididosona.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Yan uttidi baw miyaba wochees;","poem":1},{"text":"iya ayfey haahon geeshshidi demmees.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Argantha nayti suuthi uyoosona;","poem":1},{"text":"gawuxi de7iya bessan shiiqoosona” yaagis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":30}