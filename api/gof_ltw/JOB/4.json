{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":4,"content":[{"type":"heading","content":["Elfaaza Haasaya"]},{"type":"verse","number":1,"content":["Temaanape yida Elfaazi zaaridi,"]},{"type":"verse","number":2,"content":[{"text":"“Issi asi xaltaamidi neera odetiko neeni lancanee?","poem":1},{"text":"Shin haasayonna agganay oonee?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Heko, neeni darota tamaarsadasa;","poem":1},{"text":"argaacida kusheta minthethadasa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne qaalay dhubetidaysata koolidi essis;","poem":1},{"text":"daaburida gulbatata minthis.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Shin ha77i metoy nena gakin ufaysi qanxadasa;","poem":1},{"text":"un7i nena teqin dagammadasa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne Xoossaas yayyeysi nena ammanthidi wothibeennee?","poem":1},{"text":"Ne suure hemethay new ufaysi gidibeennee?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ane qopa; geeshsha asi gididi dhayday oonee?","poem":1},{"text":"Suure asi gididi shodetidi dhayday oonee?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ta be7idaysada, iitatethi goyidi meto zereysati,","poem":1},{"text":"iya zaaridi buucana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Enti Xoossaafe keya shempon punetidi dhayana;","poem":1},{"text":"iya hanquwa lacuwan meetetana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iitati gudiya gaammo mela xaaggoosona;","poem":1},{"text":"shin enta achay meqeretis.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Shankatidi miyaba dhayida gaammoy hayqeysada,","poem":1},{"text":"enta naytika laaleteysada iitata nayti laaletana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Issi gallas issi xuuray taako yis;","poem":1},{"text":"he xuura kalkashan ta si7as.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wolqaama dhiskoy ase oykida wode","poem":1},{"text":"un7ethiya qamma amuho giddon,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"yashshinne kokorsi tana oykis;","poem":2},{"lineBreak":true},{"text":"ta meqethati kokoridosona.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Carkoy ta som7uwa baqidi aadhis;","poem":1},{"text":"ta dagammin ta asatethaa ikisey eqis.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"I ta sinthan eqis;","poem":1},{"text":"shin I aybeko shaakada erabike.","poem":2},{"text":"Hessafe guye, si77i gida bessafe","poem":1},{"text":"haysada giya girsaa si7as.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"‘Hayqiya asi Xoossaa sinthan xillo gidanaw danda7ii?","poem":1},{"text":"Woyko asi bana medhidaysa sinthan geeshshi gidanaw danda7ii?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Xoossay ba aylletan ammanetonaba gidiko,","poem":1},{"text":"ba kiitanchotanka bala demmiyaba gidiko,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yaatin, urqa keethan de7eysati,","poem":1},{"text":"enta de7uwa baasoy biitta gididaysati,","poem":2},{"lineBreak":true},{"text":"guxunepe eeson hayqeysati waananee?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wonta bentidi omarsi hayqoosona;","poem":1},{"text":"oonika hassayonna merinaw dhayoosona.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Dhishey shodetida dunkaane mela","poem":1},{"text":"cincatethi bayna hayqoosona.’ ”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}