{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":40,"content":[{"type":"verse","number":1,"content":["Goday Iyyobako zaaridi yaagis;"]},{"type":"verse","number":2,"content":[{"text":"“Iyyoba, asi Ubbaa Danda7iya Godaara mootetidi, lathanaw danda7ii?","poem":1},{"text":"Ane Xoossara mootetiya uray iyaw zaaro” yaagis.","poem":2}]},{"type":"verse","number":3,"content":["Hessafe guye, Iyyobi zaaridi, haysada yaagis;"]},{"type":"verse","number":4,"content":[{"text":"“Godaw, taani pathonna laafa asi;","poem":1},{"text":"ta doona bolla kushe wothada si77i gaanape attishin,","poem":2},{"lineBreak":true},{"text":"new ay zaaro immanaw danda7iyana?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Taani issi toho odas; shin taw zaariyabay baawa;","poem":1},{"text":"nam7antho odas haraa gujike” yaagis.","poem":2}]},{"type":"verse","number":6,"content":["Hessafe guye, Goday gote giddon giddon gididi Iyyobako haysada yaagis."]},{"type":"verse","number":7,"content":[{"text":"Addeda ne xeessaa dancada dendada,","poem":1},{"text":"ta oyshaas zaaro imma.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne tana bala asi kessana hanayee?","poem":1},{"text":"New xillo gidanaw tana wordancho kessayee?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Xoossa wolqaa mela wolqi new de7ii?","poem":1},{"text":"Xoossay guummeysada ne guummanaw danda7ay?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hessa gidiko, ne bonchuwanne gitatetha ma7a;","poem":1},{"text":"ne wolqaanne teemuwa gixa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne hanquwa gussa;","poem":1},{"text":"ane otoranchota xeellada kawusha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ane loytha xeellada otortiya ubbaa yeellaya;","poem":1},{"text":"iitata ubbaa enti de7iya bessaafe dhaysa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Enta ubbaa biittan mooga;","poem":1},{"text":"duufon yeggada enta bolla gorda.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"He wode ne wolqay nena ashshanaw danda7eysa","poem":1},{"text":"ta markatana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Taani nena medhidaada medhida Bihemoota geetetiya do7a be7a;","poem":1},{"text":"I boorada maata mees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Iya xeessan de7iya wolqaynne","poem":1},{"text":"iya uluwa kammida shayaa minotethay daro.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Iya goynay zigada bollan qaaxees;","poem":1},{"text":"iya gedaa xaphoti minon dooqetidosona.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Iya meqethay naase birata mela;","poem":1},{"text":"iya geday birata kure mela.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Xoossay medhida medheta ubbaa garsan I aadhees;","poem":1},{"text":"taape attishin, hari iya xoonanaw danda7ey baawa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Do7i gupiya derey,","poem":1},{"text":"iyaw miyaba dolisees.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mitha kuya garsan zin7ees;","poem":1},{"text":"caren maqa giddon qosetees.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mithati banta kuyan iya genthoosona;","poem":1},{"text":"shaafa gaxan dicciya mithati iya kammoosona.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Shaafay kixidi goggey wode dagammenna;","poem":1},{"text":"Yordaanose shaafay qoodhe gakanaw kumikoka I hirgenna.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Iya ayfiya toysidi, iya oykanaw danda7iya asi de7ii?","poem":1},{"text":"Iya siidhiya lukidi oykanaw danda7ey oonee?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":24}