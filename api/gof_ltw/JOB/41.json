{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":[{"text":"“Neeni Leewataane geetetiya abba do7aa manxaqon oykanaw,","poem":1},{"text":"woyko iya inxarsaa wodoron ancafanaw danda7ay?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iya siidhiya lukada dafo aathanaw danda7ay?","poem":1},{"text":"Woyko iya gacuwa wospen lukanaw danda7ay?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"I nena, ‘Hayyana tana aggarki’ yaagidi woossii?","poem":1},{"text":"Woyko new mal7o qaala odii?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne iya merinaw aylle oothada haarana mela,","poem":1},{"text":"I new ero gidi caaqanee?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Asi kafo loohiseysada ne iya loohisanaw danda7ay?","poem":1},{"text":"Woyko iya qachada ne macca naytara kaa7ana mela oothanee?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Molo zal7anchoti iya gatiya bolla palamona?","poem":1},{"text":"Woyko iya qanxerethidi bayzoona?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Neeni iya galbaa tooran,","poem":1},{"text":"woyko iya huuphiya mashshan caddanaw danda7ay?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ane iya ne kushen bocha;","poem":1},{"text":"ne iyara butetida butiya dogaka;","poem":2},{"lineBreak":true},{"text":"nam7antho iyara butetanaw qopaka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"He do7aa oykanaw paacey mela waaye;","poem":1},{"text":"hari attoshin iya be7ida ubbay yashshan kokorees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"I zin7ida bessaafe iya denthanaw oonika xaalenna;","poem":1},{"text":"yaatin, ta sinthan eqanaw danda7ey oonee?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Taani iyaw zaarana mela koyro taw tal7iday oonee?","poem":1},{"text":"Salope garsan de7iyaba ubbay tabaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Taani Leewataane tohotaba, iya gita wolqaabanne","poem":1},{"text":"lo77iya iya asatethaba qoncisonna aggike.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Iya galbaa qaaranaw danda7ey oonee?","poem":1},{"text":"Iya gacuwa pooqidi bixaala barsanay oonee?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yashshiya achay de7iya","poem":1},{"text":"iya gacuwa pooqanaw danda7ey oonee?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Iya zoko galbay issoy issuwa bolla dooretidi;","poem":1},{"text":"shuchada minnida gondalle daanees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Enti issoy issuwas daro matatida gisho,","poem":1},{"text":"enta giddora hari attoshin carkoy kanthanaw danda7enna.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Issoy issuwara gahetidi de7iya gisho,","poem":1},{"text":"enta aybika shaakenna.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"I hadhishiya wode poo7oy pol7u gees;","poem":1},{"text":"iya ayfeti wonta xalqeda caddees.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Iya doonape tama lacoy keyees;","poem":1},{"text":"pinxiya tami bentees.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Iya siidhiyape cuyay,","poem":1},{"text":"tama bolla de7iya otope keya pento mela.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Iya siidhera keya shempoy kenchikelo bonqisees;","poem":1},{"text":"tama lacoy iya doonape keyees.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Iya morgiyan wolqay de7iya gisho,","poem":1},{"text":"I daro yashshees.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Iya ashoy issife oyketidi de7iya gisho,","poem":1},{"text":"iya asatethay biratada minnees.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Iya wozanay shuchada mino;","poem":1},{"text":"gaacha woxa mela mino.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"I dendiya wode minoti yayyoosona;","poem":1},{"text":"dagammidi baqatoosona.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Iya gakiya mashshay aykoka oothenna;","poem":1},{"text":"toori woyko dongey woyko mashshi iya qohenna.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"I birata xinqa maatada,","poem":1},{"text":"naase birata wooqida mithada mentherethees.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Dongey iya betisenna;","poem":1},{"text":"yambarsha shuchi iyaw suulla mela.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Gumba xam7i iyaw xinqo mela;","poem":1},{"text":"toora xongiya wode qelqisidi miicees.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Iya uluwa bolla de7iya galbay meqida kun7a mela qara;","poem":1},{"text":"urqara I biya wode marasha mela biitta phalqees.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Abbaa pentida haatha mela tumbul tumbul oothees;","poem":1},{"text":"xaaron pentiya zayte mela shiri shiri yeggees.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Iya biya ogey poo7ees;","poem":1},{"text":"abba haatha goponto laammees.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"I yashshi eronna gisho,","poem":1},{"text":"biitta bolla iya mela medhetethi hari baawa.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"I daro gita medhetethata ubbaa kadhees;","poem":1},{"text":"do7a ubbaas I kawo” yaagis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/40.json","previousChapterAudioLinks":{},"numberOfVerses":34}