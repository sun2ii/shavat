{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"“Iyyoba, new koyana asi de7iko ane xeega!","poem":1},{"text":"Kiitanchotape oodeko ne xeellanee?”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Eeya uraa lancey wodhees;","poem":1},{"text":"akeeki bayna uraa qanaatey dhaysees.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Eeya uray minnidi de7ishin be7as;","poem":1},{"text":"shin qoponna iya keethay baadetis.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iya nayti saroy bayna daana;","poem":1},{"text":"pirda dabaaban entaw eqiya asi bayna gisho enti qohetana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"I shiishida kathaa koshatida asay maana;","poem":1},{"text":"hari attoshin aguntha giddon dolidaysaka aggokona.","poem":2},{"lineBreak":true},{"text":"Saamotidaysati iya shaluwa ekanaw amottoosona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Metoy sa7ape keyenna;","poem":1},{"text":"waayey biittafe dolenna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tami pinxidi wodheysada,","poem":1},{"text":"asi metos yeletis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Ta nena gidiyako ta Xoossako shiiqana;","poem":1},{"text":"ta mootuwaka iya sinthan wothana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"I taybetonna malaatata,","poem":1},{"text":"pilgetonna wolqaamabata oothees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ira biittan bukisees;","poem":1},{"text":"goshsha gadiyas haathe yeddees.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kawushata dhoqu dhoqu oothees;","poem":1},{"text":"kayoteyisata minthethidi ufaysees.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Enta qofay poletonna mela,","poem":1},{"text":"genanchota halchuwa hada oothees.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Cincata enta gene oosuwan oykees;","poem":1},{"text":"genanchota maquwa aathidi yeggees.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Gallasay entaw dhuma gidana;","poem":1},{"text":"seeta gallas dhuman hemetiya asada tattafana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Manqota enta morketa mashshafe ashshees;","poem":1},{"text":"enta wolqaamata kushiyape wothi ekees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hessa gisho, manqotas ufaysi de7ees;","poem":1},{"text":"geellatethi si77i oothees.”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“Xoossay seeriya asi anjetidaysa;","poem":1},{"text":"hessa gisho, Ubbaa Danda7iya Xoossaa seera kadhopa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"I menthees, shin zaaridi koolees;","poem":1},{"text":"I madunxisees, shin iya kushey dhallees.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Usupun qommo qohotape I nena ashshana;","poem":1},{"text":"laapunthoy nena bochenna.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kosha laythi hayqope,","poem":1},{"text":"ola wode mashshafe nena ashshees.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"I nena iita inxarsafe naagana;","poem":1},{"text":"boshi gakiya wode yayyaka.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bosha bollanne kosha bolla ne miicana;","poem":1},{"text":"bazzo do7atas yayyaka.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ne goshsha biittan shuchi deenna;","poem":1},{"text":"bazzo do7atara ne saron daana.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ne dunkaaney saro gideysa ne erana;","poem":1},{"text":"ne daraa ne xomoosiya wode aybika pacenna.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ne yeletay daranaysanne","poem":1},{"text":"ne kochay maata mela gidanaysa ne erana.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kathi wode naagidi caketeysada,","poem":1},{"text":"neeni cimatethi kaallada duufo baana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Iyyoba, nuuni hessa ubbaa pilgidi xeellida.","poem":1},{"text":"Hessi tuma gidiya gisho akeekada eka” yaagis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}