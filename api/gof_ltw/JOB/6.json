{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":6,"content":[{"type":"heading","content":["Iyyoba Haasaya"]},{"type":"verse","number":1,"content":["Hessafe guye Iyyobi zaaridi,"]},{"type":"verse","number":2,"content":[{"text":"Ta waayeynne ta azzanoy ubbay","poem":1},{"text":"mizaanen liketidi be7etiyako,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abba gaxan de7iya shafiyape aadhidi deexana;","poem":1},{"text":"Hessa gisho, ta qaalay nena malaalsenashin.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ubbaa Danda7iya Xoossaa dongeti tana caddidosona;","poem":1},{"text":"ta asatethay enta yiishsha uyees;","poem":2},{"lineBreak":true},{"text":"Xoossaa daganthoy ta bolla salpis.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Harey woyko boori maati de7ishin waassiyee?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mal7onna kathi maxiney gelonna meetetiyee?","poem":1},{"text":"Woyko phuuphulle haathi mal7iyee?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hessa mela kathi tana suukeyenna;","poem":1},{"text":"hessa mela kathi ta miiko tana sakees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ta woosa Xoossi si7iyako aybee?","poem":1},{"text":"Ta amuwaka taw kunthiyako aybee?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Xoossaa shene gidin I tana mentherethiyako,","poem":1},{"text":"I ba kushiya yeddidi tana dhaysiyako,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta Geeshsha Xoossaa qaala kaddaboonna gisho,","poem":1},{"text":"waayey darikoka ufaysan ta gupana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ta paxa daanaw taw ayba wolqi de7ii?","poem":1},{"text":"Taw ayba ufaysi de7ishin danda7iyana?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ta wolqay shucha meleyee?","poem":1},{"text":"Woyko ta ashoy naase birata meleyee?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Taani tana maaddanaw ayba wolqi taw de7ii?","poem":1},{"text":"maado demmanaw xeelliya bessika baawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Meton de7iya asi Ubbaa Danda7iya Xoossas yayyeysa aggikoka,","poem":1},{"text":"iya laggeti iyaw keehatethi bessanaw koshshees.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Shin ta ishati hinte iri bukonna wode meliya shaafa mela tana cimmeeta.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Balgo ageenan ha shaafay shachan kumees.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Shin boney gakiya wode shachay til7ees;","poem":1},{"text":"shaafayka melees.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Caana mehe laaggishe biya zal7anchoti,","poem":1},{"text":"haathe koyanaw banta ogiyape gaxa keyidi,","poem":2},{"lineBreak":true},{"text":"mela biittan toylatishe dhayoosona.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Teema biitta zal7anchoti haathe koyoosona;","poem":1},{"text":"Saaba biitta oge asati ufaysi qanxokona.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Enti ammanetidi koyidi dhayida gisho yilotidosona,","poem":1},{"text":"he bessaa gakidi yeellatidosona.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hinteka taw he shaafata mela gidideta;","poem":1},{"text":"tana gakida metuwa be7idi yayyideta.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hanoshin ta hintena, “Taw issiba immite”","poem":1},{"text":"woyko, “Hinte shaluwara tana wozite” gadinaa?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"“Tana ta morketa kushepe ashshite”","poem":1},{"text":"woyko, “Qadhey bayna asaa kushepe tana wozite” gadinaa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“Ta si77i gaana; hinte tana tamaarsite;","poem":1},{"text":"ta ay balidaako ane tana bessite.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Tuma odi cammikoka eketees!","poem":1},{"text":"shin hinte oday aybiska maaddenna.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hinte ta haasaya carko mela hada ootheeta;","poem":1},{"text":"Yaatin, ufaysi qanxidaysas taw ay zaaro immanaw koyeetii?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Aawi bayna na7a bolla saama yeggeeta;","poem":1},{"text":"hinte laggiya bayzanaw washiseeta.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ane shama ayfen tana xeellite;","poem":1},{"text":"ta hinte sinthan wordotiyana?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Hayyana, ane zaarethidi qopite;","poem":1},{"text":"taani xillo ta bolla coo pirdofite.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ta inxarsan wordoy de7ii?","poem":1},{"text":"Ta doonay wordonne tumaa shaakanaw danda7ennee?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}