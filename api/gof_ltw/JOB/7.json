{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"Asa de7oy sa7a bolla wolqaama baaxe gidenneyee?","poem":1},{"text":"Iya laythay une oothiya asa de7o mela gidenneyee?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wulliya awa amotiya gaacha mela,","poem":1},{"text":"woyko ba damooziya ekanaw naagiya oosanchoda,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"hessada taw mela ageenati","poem":2},{"lineBreak":true},{"text":"meto qammati imetidosona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taani zin7iya wode awude barkandinasha gayis;","poem":1},{"text":"Shin qammay taw aduqees;","poem":2},{"lineBreak":true},{"text":"sa7i wontana gakanaw hiixan shireta shireta wodhayis.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ta asatethay guxuntis;","poem":1},{"text":"ta madunthay giishshi goggees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ta laythay dorze mooqepe aadhidi ellesees;","poem":1},{"text":"ufaysi baynashin ta laythay wurees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abeeti Xoossaw, ta laythay issi shempo mela gideysa qopa!","poem":1},{"text":"Ta ayfey zaaridi keehaba be7enna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ha77i be7ey zaaridi be7enna;","poem":1},{"text":"tana koyana shin zaari demmenna.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Shaari laaletidi dhayeysada,","poem":1},{"text":"duufo wodhiya asi simmidi keyenna.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ba soo simmidi yeenna;","poem":1},{"text":"iya eriya asayka dogees.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Hessa gisho, ta si77i giike;","poem":1},{"text":"ta ayyaana un7etetha odana;","poem":2},{"lineBreak":true},{"text":"ta shempuwa cametethaa gisho zuuzumana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hessa mela neeni tana ayis naagay?","poem":1},{"text":"Ta new abba woyko abban de7iya iita do7a gadiyee?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"‘Ta hiixay tana minthethana;","poem":1},{"text":"ta arsay tana zuuzunthafe shempisana!’ gada qopas;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Shin neeni tana amuhon yashisaasa;","poem":1},{"text":"qoncethan tana daganthaasa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Taani ha waayey kumida asatethaa tookada daanape,","poem":1},{"text":"suletada hayqiyako dosayis.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Taani ta de7uwa shaatettas; daanaw koyke;","poem":1},{"text":"ta laythay issi shempo mela gidiya gisho tana aggarki.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ne iya gitayada xeellanaw asi aybee?","poem":1},{"text":"Ne iyaw qopanaw asi aybee?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wonta wonta ne iya xomoosasa;","poem":1},{"text":"woden woden ne iya paacasa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ne ta bolla ayfe wotheysa aggikii?","poem":1},{"text":"Cuchu mittiya wode taw immikii?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Abeeti ase kaalleyso,","poem":1},{"text":"ta nagaraa oothin nena ay qohidee?","poem":2},{"text":"Ne ayis tana cadda oykay?","poem":1},{"text":"New ta tooho gidadinaayee?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ta naaquwa ayis aggikii?","poem":1},{"text":"Ta nagara ayis atto giikii?","poem":2},{"text":"Ta duufo geliya wodey gakis;","poem":1},{"text":"ne tana koyana, shin hizape demmaka” yaagis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/6.json","previousChapterAudioLinks":{},"numberOfVerses":21}