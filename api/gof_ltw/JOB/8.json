{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":8,"content":[{"type":"heading","content":["Baldadoosa Haasaya"]},{"type":"verse","number":1,"content":["Shuha biittafe yida Beldadoosi zaaridi,"]},{"type":"verse","number":2,"content":[{"text":"“Neeni hessa awude gakanaw odetay?","poem":1},{"text":"Ne doonape keya qaalay wolqaama gote mela.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ubbaa Danda7iya Xoossay xillo pirdennee?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ne nayti Xoossaa bolla nagaraa oothida gisho,","poem":1},{"text":"I enta enta nagaraa gisho seeris.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Shin neeni Xoossaako simmiko,","poem":1},{"text":"Ubbaa Danda7iya Xoossaa woossiko,","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"neeni geeshshinne suure gidiko,","poem":2},{"lineBreak":true},{"text":"I ne gisho dendidi nena maaddana;","poem":2},{"lineBreak":true},{"text":"I kase ne de7uwa zaaridi woytana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne doomethay guutha daanikoka,","poem":1},{"text":"ne wursethay daro aadhidi darana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kase yeletaa ane oycha;","poem":1},{"text":"nu mayzati ay tamaaridaako pilgada demma.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nuuni zine nayta aybaka eroko;","poem":1},{"text":"nu ha sa7an de7iya laythay kuya mela.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Enti nena tamaarseynne new odey,","poem":1},{"text":"banta wozanan wothidabaape gidenneyee?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Carey bayna bessan palki dolanaw danda7ii?","poem":1},{"text":"haathi bayna bessan mayrey cil7anaw danda7ii?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Buroo diccidi qanxetonna de7ishe,","poem":1},{"text":"cil7o maatapeka eeson melees.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Xoossaa dogiya asaa ubbaa wursethay hessa mela;","poem":1},{"text":"Xoosse eronna asaa ufaysay dhayana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"I ammanetiyabay meqiyaba;","poem":1},{"text":"I ceeqetiyabayka shango haada mela.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"I ba shango haada bolla zempana, shin eqenna;","poem":1},{"text":"I iya oykana, shin duuxi wodhana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"I awa wode haathe uyidi cil7iya atakilte mela;","poem":1},{"text":"ba xaphuwa biitta ubban yeddida mitha mela.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ba xaphuwa keelan yeddees;","poem":1},{"text":"gita shucha bolla ba xaphuwa xaaxees.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Shin I ba bessaafe shodetiko,","poem":1},{"text":"he bessay, ‘Ta nena be7abike’ yaagana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Iita asata ufaysay hessa mela;","poem":1},{"text":"harati yidi enta bessaa oykana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Xoossay borey bayna asaa yeggi aggenna;","poem":1},{"text":"iita ootheyisata maaddenna.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"I zaaridi nena miichananne ililsana.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Nena ixeysati yeella ma7ana;","poem":1},{"text":"iitata keethay dhayana” yaagis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}