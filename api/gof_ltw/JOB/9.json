{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOB","translationId":"gof_ltw","name":"Iyyoba Maxaafa","commonName":"Iyyoba Maxaafa","title":"Iyyoba Maxaafa","order":18,"numberOfChapters":42,"sha256":"595d6f6fd69d3a93c3b3b37f172eeb6bab2443d8b011835963bb5ca8aba66482","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gof_ltw/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":9,"content":[{"type":"heading","content":["Iyyoba Haasaya"]},{"type":"verse","number":1,"content":["Iyyobi zaaridi,"]},{"type":"verse","number":2,"content":[{"text":"“Ee, hinte geysi tuma gideysa ta erayis;","poem":1},{"text":"shin asi Xoossa sinthan waanidi xillo gidanaw danda7ii?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iyara ooni palamanaw danda7ii?","poem":1},{"text":"I oychiya mukulu oyshatape issuwaka zaaranaw danda7enna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Xoossay cincanne wolqaama;","poem":1},{"text":"iyara eqetanaw danda7ey oonika baawa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Qoponna de7ishin dereta enta bessaafe diggees;","poem":1},{"text":"ba hanquwan aathidi yeggees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I biitta iya bessaafe qaathees;","poem":1},{"text":"biitta tuuqetaka yiggees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Away keyonna mela oothees;","poem":1},{"text":"xoolintoti poo7onna mela diggees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"I barka salota miccis;","poem":1},{"text":"abba hobbiya bolla hemetees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Xoossay Biire, Ooriyoona, Pilaadisa geetetiya xoolintotanne,","poem":1},{"text":"dugeha baggara de7iya xoolinto koceeta medhis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"I asi pilgid eranaw danda7onna gitabata,","poem":1},{"text":"taybetonna malaalsiyabata oothees.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"I ta matara aadhiya wode ta be7anaw danda7ike;","poem":1},{"text":"I taako shiiqiya wode eranaw danda7ike.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"I bonqiko digganaw danda7ey oonee?","poem":1},{"text":"‘Waatay?’ yaagidi iya oychanay oonee?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Xoossay ba hanquwa teqenna;","poem":1},{"text":"Ra7aaba geetetiya do7a maaddeysati","poem":2},{"lineBreak":true},{"text":"iya tohuwa garsan kundoosona.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yaatin, iya oysha zaaranaw,","poem":1},{"text":"iyara mootetanaw taani oonee?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Taani xillo gidikoka,","poem":1},{"text":"pirdiya Xoossay tana maaranaada woossanaape attishin,","poem":2},{"lineBreak":true},{"text":"taani iyaw zaaro immike.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ta iya xeegin, I taw koyaakoka,","poem":1},{"text":"tana si7ees gada ammanike.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tana goten mentherethees;","poem":1},{"text":"gaasoy bayna ta madunthaa darsees.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tana shempo diggees;","poem":1},{"text":"ta de7uwa camethees.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wolqaba gidiko, I wolqaama.","poem":1},{"text":"Xillo pirdaba gidiko, iya pirda keethi shiishanay oonee?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Taani tana xillo giikoka ta doonay tana bala kessees;","poem":1},{"text":"tanan borey baawa ta giikoka ta inxarsay tana geella kessees.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Taani borey bayna asi gidikoka tabaa qopike;","poem":1},{"text":"taani ta de7uwa kadhayis.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Xoossay borey baynaysanne iita issife dhaysees;","poem":1},{"text":"ta dummatethi baawa gey hessa gishosa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Gadoy gelidi asaa qoponna wodhiya wode,","poem":1},{"text":"I xillo asaa waayan miicees.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ha sa7ay iita asaa kushen wodhiya wode,","poem":1},{"text":"I pirdeyisata ayfiya goozees.","poem":2},{"text":"Hessa ubbaa oothey iya gidonna ixiko, hari oonee?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ta de7o laythati woxiya uraape aadhidi ellesoosona;","poem":1},{"text":"enti lo77oba be7onna piradhidi dhayoosona.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ta de7o laythay palka wogoloda woxees;","poem":1},{"text":"arganthi miyaba oykanaw salope duge paalleysada paallees.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"‘Ta zuuzuntha dogana;","poem":1},{"text":"som7o tukeysa aggada poo7isana giyako,’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Neeni tana geeshshi goonnaysa taani eriya gisho,","poem":1},{"text":"tana gakana waaye ubbaa taani yayyayis.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Yaatin, taani bala gideysi attonna ixiko,","poem":1},{"text":"coo mela ayis daaburayna?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Taani ta asatethaa hari attoshin saamunan meecetiyakoka,","poem":1},{"text":"ta kushiya dummabaara meecetiyakoka,","poem":2}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"ta ma7oyka tana shaatettana gakanaw,","poem":2},{"lineBreak":true},{"text":"neeni tana urqa ollan holana.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ta iyaw zaaro immanaw Xoossay ta mela ase gidenna;","poem":1},{"text":"gidiyako nu nam7ay daynna sinthan eqana.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Shin nu nam7aa bolla ba kushe wothidi,","poem":1},{"text":"nuna sigethiya asi nu giddon de7eerenne!","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Iya teemoy tana daganthonna mela,","poem":1},{"text":"issi asi Xoossaa xam7aa taape digereneshin!","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Yaaniko, taani iyaw yayyonna odetana;","poem":1},{"text":"shin ha77i taani danda7ike.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOB/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOB/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/8.json","previousChapterAudioLinks":{},"numberOfVerses":35}