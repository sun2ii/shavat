{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOL","translationId":"gof_ltw","name":"Iyyu7eela Maxaafa","commonName":"Iyyu7eela Maxaafa","title":"Iyyu7eela Maxaafa","order":29,"numberOfChapters":3,"sha256":"6912cf6094434f3789d37d4cfd39e5becb7ede46dc64eb81898056d5e6df0cbb","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gof_ltw/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"heading","content":["Boole Gado"]},{"type":"verse","number":1,"content":["Batu7eela na7aa Iyyu7eelako Goday kiitida qaalay haysa."]},{"type":"verse","number":2,"content":["Hinteno cimato, haysa si7ite! Yihuda biittan de7iya asa ubbay si7ite! Haysa melabay hinte wode woyko hinte aawata wode hani erii?"]},{"type":"verse","number":3,"content":[{"text":"Haysa hinte naytas odite;","poem":1},{"text":"hinte nayti banta naytas odo;","poem":2},{"lineBreak":true},{"text":"enta nayti kaalliya yeletas odo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gondofe attida kathaa booley mis;","poem":1},{"text":"boolepe attida kathaa guddoy mis;","poem":2},{"lineBreak":true},{"text":"guddofe attida kathaa xaqoy mis.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mal7iya woyney hintefe attida gisho,","poem":1},{"text":"hinteno, mathoteysato barkite yeekite!","poem":2},{"lineBreak":true},{"text":"Hinteno, woyne uyiya ubbati zeleelite!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tayboy bayna booley ta biitta oykis;","poem":1},{"text":"Enta achay gaammo acha mela;","poem":2},{"lineBreak":true},{"text":"enta gacoy macca gaammo gaco mela.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Enti ta woyniya dhaysidosona;","poem":1},{"text":"ta balasiya mitha dhoggidosona.","poem":2},{"text":"Enti poqidi mida gisho,","poem":1},{"text":"woyniyanne balasiya tasheti puxu gis.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Geela7iya, ba giigida azinay hayqin,","poem":1},{"text":"kayo ma7o ma7ada yeekeysada hinteka yeekite!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Katha yarshoynne ushsha yarshoy","poem":1},{"text":"Godaa keethan dhayida gisho,","poem":2},{"lineBreak":true},{"text":"Godaa keethan oothiya kahineti yeekosona.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Goshshay mela attis; biittay yeekees;","poem":1},{"text":"kathay dhayis; woyneynne zaytey melis.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gaden de7iya gisteynne bangi dhayida gisho,","poem":1},{"text":"hinteno goshshanchoto, kayotite;","poem":2},{"lineBreak":true},{"text":"hinteno woyne tokeysato, zeleelite!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Woyney melis; balasey shullis;","poem":1},{"text":"oromaaney, temirey, apiley,","poem":2},{"lineBreak":true},{"text":"gaden de7iya hara mithi ubbay melis;","poem":2},{"lineBreak":true},{"text":"hessa gisho, asape ufaysi haakis.","poem":2}]},{"type":"heading","content":["Maarotako Xeessi"]},{"type":"verse","number":13,"content":[{"text":"Hinteno kahineto, kayo ma7o ma7idi yeekite;","poem":1},{"text":"hinteno yarsho bessa sinthan ootheysato, zeleelite.","poem":2},{"text":"Hinteno ta Xoossaa sinthan ootheysato,","poem":1},{"text":"xoossa keethi gelidi, kayo ma7o ma7idi aqite.","poem":2},{"text":"Katha yarshoynne ushsha yarshoy,","poem":1},{"text":"Xoossa keethan yarshiyabay baawa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Xooma awaajite;","poem":1},{"text":"geeshsha shiiqo xeegite.","poem":2},{"text":"Cimatanne biittan de7iya asa ubbaa","poem":1},{"text":"Godaa hinte Xoossaa keethan shiishite;","poem":2},{"lineBreak":true},{"text":"yan Godaako waassite.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Godaa gallasay matis;","poem":1},{"text":"he gallasaa ayye!","poem":2},{"text":"He gallasay Ubbaa Danda7iya Xoossaa","poem":1},{"text":"hanqo gallas gididi yees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nu sinthafe kathi,","poem":1},{"text":"nu Xoossaa keethaafe,","poem":2},{"lineBreak":true},{"text":"ufaysinne ililsi dhayis gidennee?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Zeretida zerethay biitta giddon buuqis;","poem":1},{"text":"kathay dhayida gisho eley kallotis;","poem":2},{"lineBreak":true},{"text":"shaaley laaletis.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Heemmiya bessi bayna gisho,","poem":1},{"text":"mehey waassees.","poem":2},{"lineBreak":true},{"text":"Hari attoshin dorsa wudeyka","poem":2},{"lineBreak":true},{"text":"maata dhayidi un7etees.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Abeeti Godaw, bazzuwa tami mida gisho,","poem":1},{"text":"xaragi denban de7iya maata xuuggida gisho,","poem":2},{"lineBreak":true},{"text":"wora mithaa tama lacoy dhaysida gisho,","poem":2},{"lineBreak":true},{"text":"taani neeko waassayis.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Goggiya haathi melida gisho,","poem":1},{"text":"tami bazzon de7iya maata midigida gisho,","poem":2},{"lineBreak":true},{"text":"bazzo do7atika neeko waassoosona.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}