{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOL","translationId":"gof_ltw","name":"Iyyu7eela Maxaafa","commonName":"Iyyu7eela Maxaafa","title":"Iyyu7eela Maxaafa","order":29,"numberOfChapters":3,"sha256":"6912cf6094434f3789d37d4cfd39e5becb7ede46dc64eb81898056d5e6df0cbb","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gof_ltw/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"heading","content":["Booley Olanchoda Yaana"]},{"type":"verse","number":1,"content":[{"text":"Xiyoonen moyze punnite;","poem":1},{"text":"ta geeshsha zumaa bolla waassite.","poem":2},{"text":"Biittan de7iya asi ubbay kokoro;","poem":1},{"text":"Godaa gallasay yees; karen de7ees.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"He gallasay dhumanne caagana gallas;","poem":1},{"text":"shaaranne sakana dhuma gallas!","poem":2},{"text":"Zumaa bolla xalqey caareysada","poem":1},{"text":"daronne wolqaama booley biitta ma7ana.","poem":2},{"text":"Hessa melabay kase hanibeenna,","poem":1},{"text":"sinthafeka hessa melabay hanenna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Entafe sinthara miya tami bees;","poem":1},{"text":"entafe guyera lacoy xuuggees.","poem":2},{"text":"Enta sinthay Gannate mela;","poem":1},{"text":"shin enta guyey booddila bazzo mela;","poem":2},{"lineBreak":true},{"text":"entafe aybika kessi ekenna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Enta medhoy para medho mela;","poem":1},{"text":"enti ola parada adarsoosona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Pari goochiya gaareda giiroosona;","poem":1},{"text":"deriya huuphera gupoosona.","poem":2},{"text":"Buuriya miya tama lacoda xuuggoosona;","poem":1},{"text":"ola baanaw keyida wolqaama olancho daanosona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Enta sinthan asi kokorees;","poem":1},{"text":"yashshan asa som7oy kareexees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Enti olanchoda woxoosona;","poem":1},{"text":"toora asada dirsaa bollara gupoosona.","poem":2},{"text":"Enti ubbay maaran boosona;","poem":1},{"text":"banta salpiyafe gaxa keyokona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Issoy issuwara sugetokona;","poem":1},{"text":"ubbay qinxi gidi sinthe boosona.","poem":2},{"text":"Enti bantara eqeteyisata menthidi boosona;","poem":1},{"text":"enta teqiyabay baawa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Enti katamaa oykoosona;","poem":1},{"text":"dirsa gimbiya bollara woxoosona.","poem":2},{"text":"Enti keetha bolla keyoosona;","poem":1},{"text":"kaysoda maskootera geloosona.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Enta sinthan biitti qaaxees;","poem":1},{"text":"saloti kokoroosona.","poem":2},{"text":"Awinne ageeni dhumees;","poem":1},{"text":"xoolintoti banta poo7uwa diggoosona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Goday ba olanchota sinthan guummees;","poem":1},{"text":"iyaw kiitetiya olanchoti taybope bolla.","poem":2},{"text":"Godaa gallasay gitanne daro yashshees;","poem":1},{"text":"He gallasa danda7anay oonee?","poem":2}]},{"type":"heading","content":["Hinte Wozana Pheedhite"]},{"type":"verse","number":12,"content":[{"text":"“Ha7ika xooman, yeehoninne azzanon","poem":1},{"text":"hinte polo wozanaape taako simmite.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hinte wozanaape attishin,","poem":1},{"text":"hinte ma7uwa peedhopite.","poem":2},{"text":"Godaa, hinte Xoossaako, simmite;","poem":1},{"text":"I, qadheynne maaroti kumidaysa;","poem":2},{"text":"I, hanqanaw ellesonaysanne siiqoy daridaysa;","poem":1},{"text":"I, hintena seeranaw ellesenna.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Goday hinte Xoossay,","poem":1},{"text":"ba hanquwafe simmidi,","poem":2},{"lineBreak":true},{"text":"hintena anjaneko ooni erii?","poem":2},{"text":"He wode Godaas hinte Xoossaas,","poem":1},{"text":"katha yarshonne ushsha yarsho yarshana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Xiyoonen moyze punnite;","poem":1},{"text":"xooma awaajite;","poem":2},{"lineBreak":true},{"text":"geeshsha shiiquwa shiiqite!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Asaa shiishidi, hinte shiiquwa geeshshite;","poem":1},{"text":"cimata issife shiishite;","poem":2},{"lineBreak":true},{"text":"guutha naytanne dhammeyisata ashshofite.","poem":2},{"text":"Meddan de7eysati","poem":1},{"text":"banta quruxuwape keyo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Godaas oothiya kahineti Xoossaa keethaa","poem":1},{"text":"barandaafenne yarsho bessaafe giddon eqidi yeeko.","poem":2},{"text":"Enti haysada yaagidi woosso;","poem":1},{"text":"“Abeeti Godaw, ne asaas qadheta;","poem":2},{"lineBreak":true},{"text":"kawotethati, ‘Enta Xoossay awunee? yaagana mela oothada,","poem":2},{"lineBreak":true},{"text":"ne asaa boresinne miichas yeggofa’ ” yaago.","poem":2}]},{"type":"heading","content":["Godaa Qadhiya"]},{"type":"verse","number":18,"content":[{"text":"Goday ba biittas de7iya mishan","poem":1},{"text":"ba asaas qadhetis.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Goday zaaridi ba asa haysada yaagana;","poem":1},{"text":"“Heko, taani hintew kathaa, woyniyanne zaytiya,","poem":2},{"lineBreak":true},{"text":"kalsana gakanaw yeddana;","poem":2},{"lineBreak":true},{"text":"hizape guye kawotethata giddon hintena bores aggike.”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"“Pudeha baggara yida booliya,","poem":1},{"text":"taani yedethada hintefe haassana.","poem":2},{"text":"Baysanne mela biitta enta gooddana;","poem":1},{"text":"sintha baggara de7eyisata Maxine Abba,","poem":2},{"lineBreak":true},{"text":"guye baggara de7eyisata Medetiraane Abbaa, yedethana.","poem":2},{"text":"Yan enti hayqidi xinqana.","poem":1},{"text":"tuma Goday wolqaamaba hintew oothis” yaagana.","poem":2}]},{"type":"verse","number":21,"content":["Biittaw, hiza yayyofa;",{"text":"Goday gitaba oothida gisho,","poem":2},{"lineBreak":true},{"text":"ufaytanne hashshu ga!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hinteno sa7aa meheto, yayyofite;","poem":1},{"text":"bazzon de7iya maatay aacis.","poem":2},{"text":"Mithay ayfis;","poem":1},{"text":"balaseynne woyne ayfey burkukis.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hinteno Xiyoone asato, ufaytite;","poem":1},{"text":"Godan hinte Xoossan, hashshu giite!","poem":2},{"text":"I, balgo ira hintew darsidi immis;","poem":1},{"text":"kaseysada silanne torche ira gidisidi immis.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kathaa bukiya wudumman kathi kumana;","poem":1},{"text":"woyniyanne zaytiya gum7iya ollay kumidi palahana.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kase taani hinte giddo yeddida,","poem":1},{"text":"wolqaama gondoy, booley, guddotinne xaqoti midaysa,","poem":2},{"lineBreak":true},{"text":"ta hintew zaarana.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hinte min kalsidi palahiya kathi daana;","poem":1},{"text":"malaalsiyaba hintew oothida Godaa;","poem":2},{"lineBreak":true},{"text":"hinte Xoossa sunthu galatana;","poem":2},{"lineBreak":true},{"text":"ta asay zaaridi yeellatenna.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"He wode taani Isra7eele giddon de7eysa,","poem":1},{"text":"taani Goday hinte Xoossaa gideysanne","poem":2},{"lineBreak":true},{"text":"taape hara xoossi baynaysa hinte erana;","poem":2},{"lineBreak":true},{"text":"ta asay zaaridi yeellatenna.","poem":2}]},{"type":"heading","content":["Godaa Gallasa"]},{"type":"verse","number":28,"content":["Hizape guye haysada hanana;",{"text":"taani asa ubbaa bolla ta Ayyaana gussana.","poem":2},{"text":"Hinte adde naytinne macca nayti tinbite odana;","poem":1},{"text":"hinte cimati amuho amuhana;","poem":2},{"lineBreak":true},{"text":"hinte na7atethati qoncethi be7ana.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"He gallasatan ta adde aylleta bollanne","poem":1},{"text":"ta macca aylleta bolla ta Ayyaana gussana.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Taani saloninne sa7an malaalsiyaba oothana,","poem":1},{"text":"tamanne salo dendiya cuyaa bessaana.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Gitanne yashshiya Godaa gallasay yaanape kase,","poem":1},{"text":"awi dhumana; ageeni suuthu daanana.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"He wode haysada hanana;","poem":1},{"text":"Godaa sunthaa xeegiya ubbay attana.","poem":2},{"text":"Goday gidaysada Xiyoone zumaaninne","poem":1},{"text":"Yerusalaamen attidaysati daana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}