{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JOL","translationId":"gof_ltw","name":"Iyyu7eela Maxaafa","commonName":"Iyyu7eela Maxaafa","title":"Iyyu7eela Maxaafa","order":29,"numberOfChapters":3,"sha256":"6912cf6094434f3789d37d4cfd39e5becb7ede46dc64eb81898056d5e6df0cbb","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/gof_ltw/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["Hara Kawotethati Pirdetana"]},{"type":"verse","number":1,"content":[{"text":"“He gallasaninne he wodiyan","poem":1},{"text":"taani Yihudanne Yerusalaame asaa","poem":2},{"lineBreak":true},{"text":"di7etethaafe zaarada anjana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taani kawotethatan de7iya asaa shiishada,","poem":1},{"text":"Yoosafexa zangaara wodhisana.","poem":2},{"text":"Ta asaa Isra7eele bolla enti oothida iita oosuwa gisho,","poem":1},{"text":"taani enta yan pirdana.","poem":2},{"text":"Enti kawotethata giddon ta asaa laallidosona;","poem":1},{"text":"ta biitta bantaw shaaki ekidosona.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ta asaa bolla saama yeggidosona;","poem":1},{"text":"laymatiya maccas demmanaw, adde nayta immidosona;","poem":2},{"lineBreak":true},{"text":"woyne ushshas macca nayta bayzidosona.","poem":2}]},{"type":"verse","number":4,"content":["“Hinteno, Xiroosa, Sidoonanne Filisxeeme biitta asato, hinte ta bolla ay oothanaw qopidetii? Ta bolla halo keyanaw koyeetii? Hinte hessa koyiko, taani ellesada hinte oosuwa hinte bolla zaarana."]},{"type":"verse","number":5,"content":["Ta bira, ta worqanne ta al7o miishiya ubbaa ekidi hinte eeqa keethaa gelsideta."]},{"type":"verse","number":6,"content":["Yihudanne Yerusalaame asaa enta biittafe haassi efidi, Girike asaas bayzideta."]},{"type":"verse","number":7,"content":["Heko, hinte bayzida bessaafe taani ha77i enta kessada hinte oothidaba ubbaa hinte huuphen zaarana."]},{"type":"verse","number":8,"content":["Taani hinte adde naytanne hinte macca nayta Yihuda asaas aatha immana. Enti haaho biittan de7iya Saaba asaas enta bayzana. Taani Goday haysa odas."]},{"type":"verse","number":9,"content":[{"text":"“Haysada yaagidi kawotethata giddon awaajite;","poem":1},{"text":"Olas giigite; mino asata denthethite,","poem":2},{"lineBreak":true},{"text":"olanchoti shiiqidi olas keyo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hinte marasha mashshe,","poem":1},{"text":"hinte baaca toora oothidi qoxite!","poem":2},{"lineBreak":true},{"text":"Daaburanchoy, ‘Taani mino!’ yaago.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hinteno, yuushuwan de7iya kawotethato,","poem":1},{"text":"elle keyite; haa shiiqite” yaagite.","poem":2},{"text":"Abeeti Godaw, ne olanchota duge yedda!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"“Kawotethati dendidi,","poem":1},{"text":"Yoosafexa zangaara yo;","poem":2},{"text":"Isra7eele yuushuwan de7iya kawotethata,","poem":1},{"text":"ubbaa bolla pirdanaw taani yan uttana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Enta iitatethay daro;","poem":1},{"text":"caka wodey gakida kathada enta cakite.","poem":2},{"text":"Woyne ayfey ollan kumin yedheysada,","poem":1},{"text":"enta yedhite.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Pirda zangaaran Goday pirdiya gallasay gakis;","poem":1},{"text":"hessa gisho, taybon daro asay he zangaaran shiiqis.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"He gallas awinne ageeni dhumana;","poem":1},{"text":"xoolintoti banta poo7uwa diggana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Goday Xiyoonen gididi dechana;","poem":1},{"text":"Yerusalaamen ba qaala sissana;","poem":2},{"lineBreak":true},{"text":"saloynne sa7i kokorana.","poem":2},{"text":"Shin Goday ba asaas,","poem":1},{"text":"Isra7eeles baqatidi attiya bessi gidana.”","poem":2}]},{"type":"heading","content":["Xoossa Derey Anjetana"]},{"type":"verse","number":17,"content":[{"text":"“He wode hinte, taani ta geeshsha zumaa bolla,","poem":1},{"text":"Xiyoonen de7iya Godaa hinte Xoossaa gideysa erana.","poem":2},{"text":"Yerusalaame katamay geeshshi gidana;","poem":1},{"text":"allagati zaaridi Yerusalaame olokona.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"He gallas dereti mal7anto woyne ushshan xokana;","poem":1},{"text":"zumati maathi goggana.","poem":2},{"text":"Yihuda biittan de7iya shaafa ubban","poem":1},{"text":"haathi pultana.","poem":2},{"text":"Godaa keethan pultoy dhuuqana;","poem":1},{"text":"Seexima zangaara ushshana.","poem":2}]},{"type":"verse","number":19,"content":["“Gibxey baysa gidana;",{"text":"Edoomey booddila bazzo gidana.","poem":2},{"text":"Enti Yihuda asaa bolla iitabaa oothidosona;","poem":1},{"text":"xillo asaa suuthaa gussidosona.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Shin Yihudinne Yerusalaamey merinaw,","poem":1},{"text":"yeleta ubbaas de7iya bessi gidana.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Taani halo keyonna aggida enta suuthaa","poem":1},{"text":"haluwa buroo keyana” yaagees Goday.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":21}