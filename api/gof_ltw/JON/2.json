{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"JON","translationId":"gof_ltw","name":"Yoonasa maxaafa","commonName":"Yoonasa maxaafa","title":"Yoonasa Maxaafa","order":32,"numberOfChapters":4,"sha256":"ecc35adaaaf7d634812da217651091000aedf59d36b1244334b11cbe05a14453","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/gof_ltw/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Yoonasa Woosa"]},{"type":"verse","number":1,"content":["Yoonasi moluwa ulon de7ishe, ba Godaa Xoossaa haysada yaagidi woossis."]},{"type":"verse","number":2,"content":[{"text":"“Taani ta waayan de7ashe nena xeegas;","poem":1},{"text":"neka taw si7adasa.","poem":2},{"text":"Taani Si7oole ciimmuwa giddon de7ashe,","poem":1},{"text":"maado koyada neeko waassas","poem":2},{"lineBreak":true},{"text":"Neka ta waasuwa si7adasa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Neeni tana abba ciimmuwan duge yeggadasa.","poem":1},{"text":"Haathi ta yuushuwa teqis;","poem":2},{"lineBreak":true},{"text":"wolqaama zuley ta bollara aadhis.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"‘Taani ne sinthafe wora holetas,","poem":1},{"text":"Shin ne Geeshsha Keetha zaarada be7ana’ gada qopas.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Haathi taw qoodhe gakis,","poem":1},{"text":"Abbaa ciimmoy tana mittis.","poem":2},{"lineBreak":true},{"text":"Abban de7iya maatay ta huuphen xaaxetis.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taani haatha garsan de7iya dereta baasuwa gakada mitettas,","poem":1},{"text":"biitta wulay merinaw ta bolla gordetis,","poem":2},{"lineBreak":true},{"text":"Shin ta Godaw Xoossaw, neeni ta shempiw iita ollafe kessadasa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta shempiya doccida wode,","poem":1},{"text":"Godaw ta nena qopas;","poem":2},{"lineBreak":true},{"text":"ta woosay neeko ne Geeshsha keethaa gakis.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hada gidida eeqa xoossata bolla zempeysati,","poem":1},{"text":"new de7iya banta ammanetetha aggoosona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Shin taani galata mazmure new yarshana.","poem":1},{"text":"Ta qangidabaaka new gathana.","poem":2},{"lineBreak":true},{"text":"Ayis giiko, atotethay Xoossafe” yaagis.","poem":2}]},{"type":"verse","number":10,"content":["Hessafe guye, Goday moluwa kiittis. Moloy Yoonasa mela biitta bolla cooyis."]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}