{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"LAM","translationId":"gof_ltw","name":"Ermiyaasa Milalsa","commonName":"Ermiyaasa Milalsa","title":"Ermiyaasa Milalsa","order":25,"numberOfChapters":5,"sha256":"419a53b743f2de0b179f8e91c9e23d4e240fade6d2f1f75e972fdd00461b013b","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/gof_ltw/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"heading","content":["Yerusalaame Waaye"]},{"type":"verse","number":1,"content":[{"text":"Kase asi kumida katamiya","poem":1},{"text":"ha77i waanada asi bayna bessi gidadee?","poem":2},{"text":"Kase kawotethata giddon gita gididaara","poem":1},{"text":"ha77i waanada am7o gidadee?","poem":2},{"text":"Katamata giddon kawo gididaara","poem":1},{"text":"ha77i waanada aylle gidadee?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Qamma yibbata yeeho yeekashe aqawusu;","poem":1},{"text":"afuthi I ayfe karera duge wodhees.","poem":2},{"text":"Kase iyo doseysatape","poem":1},{"text":"ha77i iyo minthethiya issoyka baawa.","poem":2},{"text":"I laggeti iyo aathidi immidosona;","poem":1},{"text":"iw morke gididosona.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yihudi naaqetada; aylletada di7etasu;","poem":1},{"text":"ha77i kawotethata giddon de7awusu;","poem":2},{"lineBreak":true},{"text":"shin shempo bessi demmabuku.","poem":2},{"text":"Iya metootada de7ishin,","poem":1},{"text":"yedetheysati iyo demmidosona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Laytha ba7aale bonchanaw yaa asi bayna gisho,","poem":1},{"text":"Xiyoone ogeti yeekosona.","poem":2},{"text":"I dirsa pengeti baysatidosona;","poem":1},{"text":"I kahineti oolosona.","poem":2},{"text":"Yan de7iya geela7o nayti un7etidosona;","poem":1},{"text":"iyaka un7etada yeekawusu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"I morketi iw godaa gididosona;","poem":1},{"text":"entaw injetin de7idosona.","poem":2},{"text":"I, nagaraa gaason Goday iyo un7ethis;","poem":1},{"text":"I nayti morketan di7etidi bidosona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xiyooni bonchoy iipe qaaretis;","poem":1},{"text":"I, halaqatika miya bessi dhayida gaarada hanidosona;","poem":2},{"text":"Enti wolqa dhayidi","poem":1},{"text":"bantana yedetheyisata sinthafe baqatidosona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yerusalaamey ba metuwanne ba un7a gallasan,","poem":1},{"text":"beni ba boncho shaluwa hassayawusu.","poem":2},{"text":"I, asay morketa kushen aadhidi imetida wode,","poem":1},{"text":"iyo maaddiya issoyka bentibeenna.","poem":2},{"text":"I morketi iyo xeellidi,","poem":1},{"text":"I dhayuwan miicidosona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yerusalaamey gita nagara oothida gisho tunasu;","poem":1},{"text":"iyo bonchida ubbay I kalluwa be7ida gisho kadhees;","poem":2},{"lineBreak":true},{"text":"iya oolashe guye simmasu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tunatethi I afilaa bolla bentis;","poem":1},{"text":"sinthafe ba bolla yaanaba qopabuuku.","poem":2},{"text":"I kundethay daganthiyaba gidis;","poem":1},{"text":"iyo minthethiya oonika baawa.","poem":2},{"text":"Iya, “Abeeti Godaw, ta un7etetha be7a!","poem":1},{"text":"ta morketi tana xoonidosona” yaagasu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Morketi I boncho shaluwa bonqidosona;","poem":1},{"text":"kase ne maabara giddo gelonna mela,","poem":2},{"lineBreak":true},{"text":"neeni diggida asati, I keethaa gelishin be7asu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"I asati koshatidi kathi demmanaw oolosona;","poem":1},{"text":"enti de7on daanaw banta shaluwa kathan laammoosona.","poem":2},{"text":"Yerusalaamey haysada yaagasu;","poem":1},{"text":"Abeeti Godaw, tana xeella;","poem":2},{"lineBreak":true},{"text":"ta kawushatethaa be7a!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hinteno, haysara aadheysato,","poem":1},{"text":"haysi hintew aykoka daanennee?","poem":2},{"text":"Ane be7ite; akeekite;","poem":1},{"text":"ba eexiya hanqo gallasan,","poem":2},{"text":"Xoossay ta bolla ehida","poem":1},{"text":"metuwa mela metoy de7ii?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bollafe tama duge yeddis;","poem":1},{"text":"he tamay ta meqethaa giddo gelis.","poem":2},{"text":"Ta tohoy xihen oyketis; tana guye zaaris;","poem":1},{"text":"tana gallas ubbaa labbanthidi yeggi aggis.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ta oothida nagara ubbaa shiishi qachidi,","poem":1},{"text":"qambarada ta gannan wothis;","poem":2},{"lineBreak":true},{"text":"yaatidi ta wolqaa wursis.","poem":2},{"text":"Ta eqetanaw danda7onna asaas,","poem":1},{"text":"tana aathidi immis.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Goday ta giddon de7iya","poem":1},{"text":"wolqaama olanchota ubbaa diggis.","poem":2},{"text":"Ta yalagata dhaysanaw wode qachis;","poem":1},{"text":"woyne yedheysada,","poem":2},{"lineBreak":true},{"text":"Goday Yihuda geela7ota yedhis.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Taani yeekashe ta afuthaa gussey hessasa;","poem":1},{"text":"tana minthetheynne katisiya oonika baawa;","poem":2},{"lineBreak":true},{"text":"morkey goobin, ta nayti un7etidosona.","poem":2}]},{"type":"verse","number":17,"content":["Xiyooney ba kushiya miccasu;",{"text":"shin iyo minthethiya oonika baawa.","poem":2},{"text":"I yuushuwan de7eysati","poem":1},{"text":"iyo morkanaada Goday oothis.","poem":2},{"lineBreak":true},{"text":"Yerusalaamey enta giddon tuna gidasu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Iya haysada yaagasu; “Goday xillo;","poem":1},{"text":"iya kiitetonna ixiday tana.","poem":2},{"text":"Hinteno, asato ubbay si7ite; ta metuwaka be7ite;","poem":1},{"text":"ta panthatinne ta geela7oti di7etidosona.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ta laggeta xeegas; shin enti tana cimmidosona;","poem":1},{"text":"kahinetinne cimati banta shempuwa ashshanaw,","poem":2},{"lineBreak":true},{"text":"kathi koyishe katama giddon hayqidosona.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Abeeti Godaw, ta waayiya be7a!","poem":1},{"text":"ta garsay dagammis.","poem":2},{"text":"Taani daro makallida gisho, ta wozanay meqis;","poem":1},{"text":"karen mashshi wursees; son hayqoy de7ees.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Asay ta zelelsa si7idosona;","poem":1},{"text":"shin tana minthethiya issi asika baawa.","poem":2},{"text":"Ta morketi ta metuwa si7idosona;","poem":1},{"text":"ne ta bolla oothidaban ufaytidosona.","poem":2},{"text":"Enti taada hanana mela,","poem":1},{"text":"enta bolla ne awaajida gallasaa eha!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Enta iitatetha ubbay ne sinthe gako;","poem":1},{"text":"ta nagaraa gisho tana seeridaysada entaka seera;","poem":2},{"lineBreak":true},{"text":"ta zelelsay daris; ta wozanayka meqis.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}