{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"LAM","translationId":"gof_ltw","name":"Ermiyaasa Milalsa","commonName":"Ermiyaasa Milalsa","title":"Ermiyaasa Milalsa","order":25,"numberOfChapters":5,"sha256":"419a53b743f2de0b179f8e91c9e23d4e240fade6d2f1f75e972fdd00461b013b","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/gof_ltw/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"heading","content":["Qadhey Bayna Seera"]},{"type":"verse","number":1,"content":[{"text":"Goday ba hanqo shaarape garsan,","poem":1},{"text":"Xiyoone na7iw, waatidi wothide!","poem":2},{"text":"Isra7eele bonchuwa salope sa7a holis;","poem":1},{"text":"ba hanquwa gallas,","poem":2},{"lineBreak":true},{"text":"iya tohoy yedhiya bessaa qopibeenna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Goday Yihudan keethata ubbaa qadhetonna dhaysis;","poem":1},{"text":"ba hanquwan Yihuda biitta miixaa ubbaa laallis;","poem":2},{"lineBreak":true},{"text":"he kawotethaanne halaqata sa7an duge yeggidi kawushis.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ba wolqaama hanquwan Isra7eele wolqaa mentherethis;","poem":1},{"text":"morkey iya olanaw yaa wode","poem":2},{"lineBreak":true},{"text":"Goday ba ushacha kushiya enta bollafe diggis.","poem":2},{"text":"Ba yuushuwan de7iyaba ubbaa miya tamada,","poem":1},{"text":"Yayqooba bolla tama lacoy eexis.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Morkeda I ba dongiya enta bolla dafis;","poem":1},{"text":"un7ethiya iya ushacha kushey giigis.","poem":2},{"text":"Ayfees lo77iya asa ubbaa wodhis;","poem":1},{"text":"Xiyoone bolla ba sheniya tamada qolis.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Goday morkeda hanidi, Isra7eele dhaysis;","poem":1},{"text":"kawo gadhotanne miixa ubbaa laallis","poem":2},{"lineBreak":true},{"text":"yihuda asaas yeehonne kayo gujis.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ba keetha atakilte gaden de7iya shaqarada shoddidi holis;","poem":1},{"text":"laytha ba7aaletinne Sambaatati dogetanaada oothis;","poem":2},{"lineBreak":true},{"text":"ba gita hanquwan kawanne kahiniya kawushis.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Goday ba yarsho bessa kadhis; ba keethaa aggaagis;","poem":1},{"text":"kawo gadhota gimbiya morketa kushen yeggis.","poem":2},{"text":"Laytha ba7aale bonchiya gallasa wocamada,","poem":1},{"text":"morketi Xoossa keethan wocamidosona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Goday Xiyooni na7e dirsa gimbiya,","poem":1},{"text":"laallanaw qachis; I bolla wadha wodoro yeggis.","poem":2},{"text":"Iyo dhaysona de7ishe ba kushiya zaarenna;","poem":1},{"text":"gimbeynne miixay issife kundanaada oothis.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yerusalaame penge sanqati biittan moogetidosona;","poem":1},{"text":"enta gorde mithata mentherethidi dhaysis.","poem":2},{"text":"Kawoynne moorinnati di7etidi kawotethata giddo bidosona;","poem":1},{"text":"higge tamaarsey baawa;","poem":2},{"lineBreak":true},{"text":"nabetika hizape guye qoncethi be7okona.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Xiyoone cimati si77i gidi biittan uttidosona;","poem":1},{"text":"banta huuphen baana qolidi kayo ma7o ma7idosona;","poem":2},{"lineBreak":true},{"text":"Yerusalaame geela7oti sa7an duge hokidosona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ta asay dhayida gisho,","poem":1},{"text":"guutha nayti katamaa ogiya bolla","poem":2},{"lineBreak":true},{"text":"daaburidi kundida gisho,","poem":2},{"lineBreak":true},{"text":"ta ayfey afuthan tulcatis;","poem":2},{"lineBreak":true},{"text":"ta wozanay azzanon dagammis.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Enti banta aayetako,","poem":1},{"text":"“Kathi imma! haathe imma”","poem":2},"yaagidi waassoosona;",{"text":"katamaa ogiyan madunxidi labbaniya asada,","poem":2},{"lineBreak":true},{"text":"enti daaburin enta shempoy enta aayeta ki7on keyees.","poem":2}]},{"type":"verse","number":13,"content":["Yerusalaame naatte, taani nebaa ay gaanee?",{"text":"ne qohuwa ta aybira ginayo?","poem":2},{"text":"Dosetida Xiyoone geela7e, ta nena waatada minthetho?","poem":1},{"text":"Ne madunthay abba mela ciimmo;","poem":2},{"lineBreak":true},{"text":"nena ooni pathanaw danda7ii?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ne nabeti wordonne pathonna qoncethi be7idosona;","poem":1},{"text":"ne di7etonna mela ne nagaraa qoncisidi odibookona;","poem":2},{"lineBreak":true},{"text":"enti balethiya wordo qoncethi new be7idosona.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ne matara aadhiya ubbay ba kushiya baqees;","poem":1},{"text":"“Biittan ubbaafe aadhada lo77iya katamiya hanno?","poem":2},{"text":"Biitta ubbaas ufaysi geetetida katamiya hanno?”","poem":1},{"text":"yaagidi nena qelqisishe banta huuphiya qaathidosona.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ne morketi ubbay banta doona","poem":1},{"text":"ne bolla dooyidosona;","poem":2},{"lineBreak":true},{"text":"ne bolla qelqisidosona.","poem":2},{"text":"Banta achaa qarcishe haysada yaagosona;","poem":1},{"text":"nu enta dhaysida, nu amotiday hessa","poem":2},{"lineBreak":true},{"text":"wursethan be7ida.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Goday ba qopidaba oothis;","poem":1},{"text":"kase odida ba qaala polis.","poem":2},{"text":"Yerusalaames qadhetonna iyo laallis","poem":1},{"lineBreak":true},{"text":"I morketi ufaytana mela,","poem":1},{"text":"morketa wolqaa minthis.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Xiyoone, ne dirsa gimbey Godaako waasso!","poem":1},{"text":"ne afuthay qammanne gallas shaafada goggo!","poem":2},{"text":"Newuka shempofa;","poem":1},{"text":"ne ayfiyas shempo immofa!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Qamma dendada waassa;","poem":1},{"text":"Godaa sinthan ne wozanaa haathada gussa.","poem":2},{"text":"Koshatidi oge doonan kundida ne nayta shempuwas","poem":1},{"text":"ne kushiya iyako pude denthada woossa!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Abeeti Godaw, be7a!","poem":1},{"text":"kase haysada neeni oodde bolla oothadii?","poem":2},{"text":"Aayeti banta ki7on ko77isidi","poem":1},{"text":"dichida banta nayta mo gay?","poem":2},{"lineBreak":true},{"text":"kahinetinne nabeti Xoossa keethan hayqo gay?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ciminne na7atethi oge bolla kundidosona;","poem":1},{"text":"geela7otinne panthati mashshan wuridosona.","poem":2},{"text":"Neeni ne hanquwa gallas enta wodhadasa;","poem":1},{"text":"entaw qadhetonna enta buthadasa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Gibira gallas ase xeegeysada,","poem":1},{"text":"daganthiya ta morketa ubba bessafe xeegadasa.","poem":2},{"text":"Godaa hanqo gallasan","poem":1},{"text":"oonika kessi ekibeenna woyko attibeenna.","poem":2},{"text":"Taani ta ki7on ko77isada dichida","poem":1},{"text":"nayta ubbaa morkey wodhidi dhaysis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}