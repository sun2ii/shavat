{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"LAM","translationId":"gof_ltw","name":"Ermiyaasa Milalsa","commonName":"Ermiyaasa Milalsa","title":"Ermiyaasa Milalsa","order":25,"numberOfChapters":5,"sha256":"419a53b743f2de0b179f8e91c9e23d4e240fade6d2f1f75e972fdd00461b013b","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/gof_ltw/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"heading","content":["Xoossay Ammanthees"]},{"type":"verse","number":1,"content":["Godaa shene xam7an",{"text":"meto be7ida asi tana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tana ba sinthafe kessidi,","poem":1},{"text":"poo7oy bayna dhuman wothis.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gallas kumethi tana shocanaw","poem":1},{"text":"zaari zaari ba kushiya denthis.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I, ta galbaanne ta ashuwa cimisis;","poem":1},{"text":"ta meqethaa menthis.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"I, ta yuushuwa metoninne","poem":1},{"text":"daaburan diris.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Beni hayqida asada","poem":1},{"text":"tana dhuman wothis.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta kessa ekonna mela,","poem":1},{"text":"ta yuushuwa diris;","poem":2},{"lineBreak":true},{"text":"deexo duthan tana duxis.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Taani maade koyada iya xeegin,","poem":1},{"text":"iyako waassin, tana si7onna ixis.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ta ogiya wolqaama shuchan gordis;","poem":1},{"text":"ta ogiya geellayis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"I, taw zugidi naagiya babantha mela,","poem":1},{"text":"qosetidi naagiya gaammo mela gidis.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"I, tana ta ogiyape kessidi duuserethis;","poem":1},{"text":"tana asi bayna bessan yeggi aggis.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ba dongiya dafidi,","poem":1},{"text":"tana dukanaw mallis.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ba dongiya dafidi,","poem":1},{"text":"ta wozana ayfen caddis.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Taani asa ubbaas miichas attas;","poem":1},{"text":"gallas kumethi bore yethas gidas.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"I, tana meton camisis;","poem":1},{"text":"camo godare uuthi tana ushshidi kalsis.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"I, ta achaa acen menthis;","poem":1},{"text":"tana baanan yedhis.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Saroy taape haakis;","poem":1},{"text":"taani inje duussu dogas.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hessa gisho,","poem":1},{"text":"“Ta wolqay taape eketis;","poem":2},{"lineBreak":true},{"text":"taani Godan wothida ufaysa ubbay dhayis”","poem":2},"yaagas."]},{"type":"verse","number":19,"content":[{"text":"Ta metuwanne ta un7aa hassayin de7oy tana cammis.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ta hessa kumethi dogike; ta shempoy azzanees.","poem":1}]},{"type":"verse","number":21,"content":["Gidoshin, ta issiba ta wozanan qopiya wode ta ufaysan kumayis."]},{"type":"verse","number":22,"content":[{"text":"Hessika, nuuni dhayboonay","poem":1},{"text":"Godaa siiquwape dendoysana;","poem":2},{"lineBreak":true},{"text":"iya qadhey wuri erenna.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Enti wonta wonta oorathi;","poem":1},{"text":"ne daro ammanthasa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Goday ta saama;","poem":1},{"text":"hessa gisho, ta iyan ufaysi wothana.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Iyan banta ufaysa wotheysatasinne","poem":1},{"text":"iya koyeysatas Goday lo77o.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Asi si77i gidi Godaa atotethan naagiko lo77o.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"As ba na7atethan meto danda7a tamaariko lo77o.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Goday meto ehiya wode si77i gidi utto.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Iyaw sinthafe ufaysi daanaw danda7iya gisho bana ziqi ootho.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"I ba shakala baqeysas immo; cashshe kallo.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Goday ase merinaw yeggenna.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"I asa bolla meto ehikoka,","poem":1},{"text":"ba merina siiquwa darotethan zaaridi qadhetees.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"I asa bolla meto woyko un7a ehidi ufaytenna.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Bittan de7iya qasho asa banta tohuwpe garsan yedhiya wode,","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Ubbaafe Wolqaama Xoossaa sinthan asa maati yedhetiya wode,","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Xillo pirdi dhayiya wode Goday hessa ubbaa be7eneyee?","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Goday kiittonashin odidi polisanaw danda7ey oonee?","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Iitaba gidin lo77oba odi poley Ubbaafe Dhoqa Xoossa gidenneyee?","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Yaatin, asi de7on de7ishe ba nagaraa gisho seeretiya wode ayis zuuzumii?","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Ane nu ogiya paacoos; Godaako simmoos.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Nu wozanaa nu kushiyara salon de7iya Xoossaako denthidi haysada yaagos:","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Nu nena naaqida; new makallida;","poem":1},{"text":"neka nuus atto gabaaka.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Ne hanquwan kametada nuna yedethada;","poem":1},{"text":"ne nuus qadhetonna nuna wodhadasa.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Nu woosay neeko gakonnaada, nenatethaa shaaran kammadasa.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Asaa giddon nuna pitonne buure oothadasa.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Nu morketi ubbay nu bolla banta doona dooyidosona.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Nu dagamaninne giten gelida; metoninne un7an laaletida.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Ta asaa gakida waayiya gaason ta ayfepe afuthu shaafada goggees.","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"Ta ayfey aggonna afuxees.","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Goday salope duge be7ana gakanaw hessi hanees.","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Ta kataman de7iya maccasata bolla gakidaba ta ayfey be7ida wode ta wozanay azzanis.","poem":1}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"Coo tana morkeysati kafo shankatiyada tana shankatidosona.","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"Ta paxa de7ishin tana ollan yeggidi,","poem":1},{"text":"ollaa doona shuchan gordidosona.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"Haathi kumidi ta huuphera goggiya wode ta dhayas gada qopas.","poem":1}]},{"type":"verse","number":55,"content":[{"lineBreak":true},{"text":"Abeeti Godaw, ta ciimmo ollan de7ashe ne sunthaa xeegas.","poem":1}]},{"type":"verse","number":56,"content":[{"lineBreak":true},{"text":"Ta waasuwa si7anaada ta nena woossiya wode tana si7adasa.","poem":1}]},{"type":"verse","number":57,"content":[{"lineBreak":true},{"text":"Taani nena xeegida wode taako shiiqada, “Babofa” yaagadasa.","poem":1}]},{"type":"verse","number":58,"content":[{"lineBreak":true},{"text":"Abeeti Godaw ne ta mootuwa mootetada tana wozadasa.","poem":1}]},{"type":"verse","number":59,"content":[{"lineBreak":true},{"text":"Abeeti Godaw, ne ta un7aa be7adasa;","poem":1},{"text":"hessa gisho, ne taw pirda.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Enti halo keyanaw ta bolla maqetiya maquwa ubbaa be7adasa.","poem":1}]},{"type":"verse","number":61,"content":[{"lineBreak":true},{"text":"Abeeti Godaw, enti tana cayiya cashshaanne","poem":1},{"text":"ta bolla maqetiya maquwa ubbaa si7adasa.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"Ta morketi gallas kumethi","poem":1},{"text":"ta bolla zuuzumeysanne kalkasheysa si7adasa.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Enti uttishenne eqishe tana boridi yexoosona.","poem":1}]},{"type":"verse","number":64,"content":[{"lineBreak":true},{"text":"Abeeti Godaw, enti oothida oosuwas bessiya zaaruwa entaw qanxa!","poem":1}]},{"type":"verse","number":65,"content":[{"lineBreak":true},{"text":"Enta wozanaa eysa; ne baadethay enta gako.","poem":1}]},{"type":"verse","number":66,"content":[{"lineBreak":true},{"text":"Abeeti Godaw, ne enta ne hanquwan yedetha;","poem":1},{"text":"salope garsan enta dhaysa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}