{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"LAM","translationId":"gof_ltw","name":"Ermiyaasa Milalsa","commonName":"Ermiyaasa Milalsa","title":"Ermiyaasa Milalsa","order":25,"numberOfChapters":5,"sha256":"419a53b743f2de0b179f8e91c9e23d4e240fade6d2f1f75e972fdd00461b013b","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/gof_ltw/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"heading","content":["Geeshsha Shuchati Laaletidosona"]},{"type":"verse","number":1,"content":["Worqey phooleysa waanidi aggidee?",{"text":"geeshsha worqay waanidi dammidee? Xoossa keethay gimbetida shuchay oge doonan laaletis.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kase al7o worqa mela bonchetida Xiyoone nayti","poem":1},{"text":"ha77i biittafe medhetida oto gididosona.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hari attoshin worakani ba mari dhanthawusu;","poem":1},{"text":"shin ta asay bazzon de7iya yanchoda, ba naytas iita gidis.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Saamo gaason yooga nayta inxarsay kottonora oyketis;","poem":1},{"text":"nayti kathi woossosona;","poem":2},{"lineBreak":true},{"text":"shin entaw immiya oonika baawa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kase mal7o katha xalaala meysati","poem":1},{"text":"ha77i oge doonan koshan wuridosona.","poem":2},{"text":"Kase liino ma7idi diccidaysati","poem":1},{"text":"ha77i bido bolla zin7idosona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ta asaa nagaray,","poem":1},{"text":"oodde kusheyka iyo bochonna,","poem":2},{"lineBreak":true},{"text":"qoponna shiretidi wodhida Soodome asa nagarape daro.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yihuda halaqati shachafe aadhida geeshshi,","poem":1},{"text":"maathafe aadhida boothu.","poem":2},{"text":"Enta asatethay zo7o inqofe aadhida aarise;","poem":1},{"text":"enta medhoy sanpare al7o shucha mela.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Shin ha77i enta som7oy shaalape aadhidi kareexis;","poem":1},{"text":"asasi ogen enta be7idi erenna;","poem":2},{"lineBreak":true},{"text":"enta gogay meqethaara oyketidi mithada melis.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Miyaba dhayidi, koshan hayqidaysatape","poem":1},{"text":"olan hayqidaysati lo77o.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta asaa bolla yida dhayuwa gaason,","poem":1},{"text":"qadhetiya aayeti banta nayta doysidi midosona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Godaa hanqo xuu7ay kumis; I ba suulliya sheniya tigis.","poem":1},{"text":"Yerusalaame baasuwa tama oythis.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ha sa7a kawotape woyko kawotethatan de7iya asaape oonika","poem":1},{"text":"morkey Yerusalaame pengiyara gelana gidi ammanibena.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Shin haysi haniday iya nabetinne nagarasinne iya kahineti oothida naaquwasa,","poem":1},{"text":"xillota suuthaa iya giddon gussida gishosa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Enti qooqe asada, oge tattafoosona;","poem":1},{"text":"enti suuthan tunida gisho","poem":2},{"lineBreak":true},{"text":"enta ma7uwa oonika bochanaw koyenna.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hessa gisho, asay, “Kichite! hinte tuna gidiya gisho,","poem":1},{"text":"nuna bochofite!” yaagidi enta bolla waassidosona.","poem":2},{"text":"Enti baqatidi toylatiya wode,","poem":1},{"text":"kawotethatan de7iya asay,","poem":2},{"lineBreak":true},{"text":"“Hinte nuura haysan daanaw danda7eketa” yaagidosona.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Goday enta laallis; I entaba zaaridi qopenna;","poem":1},{"text":"enta kahineti bonchetokona;","poem":2},{"lineBreak":true},{"text":"enta cimati nashetookona.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nu ayfey maado demmanaw xeellishe coo daaburis;","poem":1},{"text":"nuna ashshanaw danda7onna","poem":2},{"lineBreak":true},{"text":"kawotethatape maado naagida.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Asay nu gedaa kaalliya gisho,","poem":1},{"text":"nu katama ogera hemetanaw danda7ibooko.","poem":2},{"text":"Nu wursethay matis; nu laythay wuris;","poem":1},{"text":"nuus dhayo wodeyka gakis.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nuna yedetheysati piradhiya arganthafe aadhidi eesotoosona;","poem":1},{"text":"enti nuna dere huuphera yedethidosona;","poem":2},{"lineBreak":true},{"text":"bazzon hokidi nuna naagidosona.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Goday tiyida kawoy, nu de7uwas shempoy,","poem":1},{"text":"enta xihiyan oyketis.","poem":2},{"text":"Nu iya kuya garsan uttidi,","poem":1},{"text":"kawotethata giddon daana gidi qopida.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hinteno, Uxa biittan de7iya Edoome asaw,","poem":1},{"text":"ufaytite; hashshu giite.","poem":2},{"text":"Shin xuu7ay hinte bolla yaana;","poem":1},{"text":"hinte mathotidi kallo attana.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hinteno, Xiyoone asaw, hinte seeray gidana;","poem":1},{"text":"I hizape hintena di7o biittan wothenna.","poem":2},{"text":"Shin Edoome asaw, hinte seeretana;","poem":1},{"text":"hinte nagarayka qoncana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}