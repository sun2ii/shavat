{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"LAM","translationId":"gof_ltw","name":"Ermiyaasa Milalsa","commonName":"Ermiyaasa Milalsa","title":"Ermiyaasa Milalsa","order":25,"numberOfChapters":5,"sha256":"419a53b743f2de0b179f8e91c9e23d4e240fade6d2f1f75e972fdd00461b013b","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/gof_ltw/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"heading","content":["Godaw, Nuna Neeko Zaara"]},{"type":"verse","number":1,"content":["Abeeti Godaw, nuna gakidaba ubbaa qopa;",{"text":"nu kawushatethaa be7a!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nu laatay allagatas,","poem":1},{"text":"nu keethayka imatha asaas imetis.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nuuni aawi hayqida na7a gidida;","poem":1},{"text":"nu aayetika am7o gididosona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nuuni ushsha haatha shammidi ekoos;","poem":1},{"text":"eethiya mithas gate qanxoos.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nuna yedetheysati nu gindiya garsana;","poem":1},{"text":"nu daaburida shin shempanaw danda7ibooko.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nuuni kathi kallana gidi,","poem":1},{"text":"Gibxetasinne Asooretas kushe immida.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nagara oothiday nu mayzata,","poem":1},{"text":"shin enti ha77i dookona;","poem":2},{"lineBreak":true},{"text":"enti ekanaw bessiya seera ekiday nuna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nuna aylleti haaroosona;","poem":1},{"text":"enta kushepe nuna ashshiya oonika baawa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mashshan wodheysati bazzon de7iya gisho,","poem":1},{"text":"nu shempuwa bayzidi kathi demmida.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iita kosha gaason,","poem":1},{"text":"nu gogay tama cooceda michees.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Maccasata Xiyoonen","poem":1},{"text":"geela7ota Yihuda katamatan","poem":2},{"lineBreak":true},{"text":"wolqan oykidi tunisidosona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Halaqata efidi kaqidosona;","poem":1},{"text":"cimati bonchetibookona.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yalaga addeti woxan gaaccidosona;","poem":1},{"text":"adde nayti deexo mithi tookidi gandigaridosona.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Cimati katama pengen pirdanaw utteysa aggidosona;","poem":1},{"text":"yalaga addeti nayti yethi dogidosona.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nu wozanaape ufaysi kichis;","poem":1},{"text":"nu dursay yeehon laametis.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nu huuphiyape kallachay kundis;","poem":1},{"text":"nu nagara oothida gisho nuna ayye!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hessa gisho, nu wozanay daaburis;","poem":1},{"text":"nu ayfey teljumis.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Xiyoone Derey baysa gidida gisho,","poem":1},{"text":"workanati yan gupoosona.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Abeeti Godaw, ne merinaw haarasa;","poem":1},{"text":"ne araatay yeletaape yeletaa gakanaasa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Neeni nuna ayis ubba wode dogay?","poem":1},{"text":"haysa mela adussa wode nuna ayis aggay?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Abeeti Godaw, nuna neeko zaara; nu simmana;","poem":1},{"text":"nu wodiya beniysatho zaarada ooratha.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Neeni nuna polo aggadiyee?","poem":1},{"text":"Ne hanquwas zawi baaweyee?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}