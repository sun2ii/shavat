},{"lineBreak":true},{"text":"Boo7ezi Uruutipe Iyobeeda yelis;","poem":1},{"lineBreak":true},{"text":"Iyobeedi Isseye yelis;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Isseyey kawa Dawita yelis;","poem":1},{"lineBreak":true},{"text":"Dawiti koyro Ooriyo machefe Solomone yelis;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Solomoney Orobi7aama yelis;","poem":1},{"lineBreak":true},{"text":"Orobi7aamey Abiya yelis;","poem":1},{"lineBreak":true},{"text":"Abiyi Asaafa yelis;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asaafi Iyosaafexa yelis;","poem":1},{"lineBreak":true},{"text":"Iyosaafexi Iyoraama yelis;","poem":1},{"lineBreak":true},{"text":"Iyoraami Ooziyana yelis;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ooziyani Iyo7ataame yelis;","poem":1},{"lineBreak":true},{"text":"Iyo7atami Akaaza yelis;","poem":1},{"lineBreak":true},{"text":"Akaazi Hizqiyaasa yelis;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hizqiyaasi Minaase yelis;","poem":1},{"lineBreak":true},{"text":"Minaasey Amoone yelis;","poem":1},{"lineBreak":true},{"text":"Amooni Iyosiyaasa yelis;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Isra7eele asay di7etidi Babiloone biitta bida wode Iyosiyaasi Ikoniyaananne iya ishata yelis.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Babiloone biitta Isra7eele asay di7etidi bidaape guye Ikoniyaani Salatiyaala yelis.","poem":1},{"lineBreak":true},{"text":"Salatiyaali Zarubaabela yelis;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zarubaabeli Abdiyu yelis;","poem":1},{"lineBreak":true},{"text":"Abdiyuy Eliyaqeeme yelis;","poem":1},{"lineBreak":true},{"text":"Eliyaqeemi Azaara yelis;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Azaari Saadoqa yelis;","poem":1},{"lineBreak":true},{"text":"Saadoqi Akime yelis;","poem":1},{"lineBreak":true},{"text":"Akimey Elyuuda yelis;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Elyuudi Alaazara yelis;","poem":1},{"lineBreak":true},{"text":"Alaazari Maatane yelis;","poem":1},{"lineBreak":true},{"text":"Maataney Yayqooba yelis;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yayqoobi Yoosefa yelis;","poem":1},{"lineBreak":true},{"text":"Yoosefi Kiristoosa geetetiya Yesuusa yelida Mayraami azina.","poem":1}]},{"type":"verse","number":17,"content":["Hiza, yeletethay Abrahaamepe Dawita gakanaw tammanne oydda. Dawitape bidi Babiloone di7uwa gakanaw tammanne oydda. Babiloone di7uwape bidi Kiristoosa gakanaw tammanne oyddu yeletethi gidees."]},{"type":"heading","content":["Yesuus Kiristoosa Yeletethi"]},{"type":"verse","number":18,"content":["Yesuus Kiristoosa yeletethaa taarikey haysafe kaalleysa. Iya aayiya Mayraama Yoosefas oysheta de7ashe Yoosefara gahetonna Geeshsha Ayyaanape qanthatasu."]},{"type":"verse","number":19,"content":["Yoosefi Xillo asi gidida gisho iyo asan kessanaw koybeenna. Yaaniya gisho qosan iyo agganaw qopis."]},{"type":"verse","number":20,"content":["I he qofan de7ishin Xoossaa kiitanchoy amuhon qoncidi, “Dawita na7aw, Yoosefa, Mayraama qanthatiday Geeshsha Ayyaanape gidiya gisho iyo ekanaw yayyofa” yaagis."]},{"type":"verse","number":21,"content":["Iya adde na7a yelana, I ba deriya enta nagaraape ashshiya gisho iya sunthaa ne Yesuusa gada xeegana."]},{"type":"verse","number":22,"content":["Goday nabiya Isayaasa doonan,"]},{"type":"verse","number":23,"content":["“Heko geela7iya qanthatana; adde na7a yelana; iya sunthay Amanu7eela” geetetana goysi poletana mela ha ubbay hanis. Amanu7eela geysas birshethay “Xoossay nuura de7ees” guussu."]},{"type":"verse","number":24,"content":["Yoosefi dhiskofe barkidi Godaa kiitanchoy kiittidaysa mela Mayraamo ba soo efis."]},{"type":"verse","number":25,"content":["Shin ba bayra na7a yelana gakanaw iyo bochibeenna;",{"noteId":0},"yeletida na7aka Yesuusa gidi xeegis."]}],"footnotes":[{"noteId":0,"caller":"+","text":"Iyo bochibeenna: Machira azinara aqeysada issife aqibookona guussu.","reference":{"chapter":1,"verse":25}}]},"thisChapterLink":"/api/gof_ltw/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/MAL/4.json","previousChapterAudioLinks":{},"numberOfVerses":25}