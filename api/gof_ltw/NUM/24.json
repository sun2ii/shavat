{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"NUM","translationId":"gof_ltw","name":"Taybo Maxaafa","commonName":"Taybo Maxaafa","title":"Taybo Maxaafa","order":4,"numberOfChapters":36,"sha256":"107d7a0d3a44a15574613d4f9d9e87494ec8681fdb20fc7b79acf92345d5f6bf","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/gof_ltw/NUM/36.json","totalNumberOfVerses":1212},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":["Balaami Isra7eele anjeysi Godaa ufaysidaysa I be7ida wode kase I ootheysada bita malla koybeenna, shin ba som7uwa mela biittako zaaris."]},{"type":"verse","number":2,"content":["I dhoqu gidi xeelliya wode Isra7eele asay ba kochan kochan dunkaanidi uttidaysa be7iya wode Xoossaa Ayyaanay iya bolla wodhis."]},{"type":"verse","number":3,"content":["I haysada yaagidi tinbite odis;",{"text":"“Bi7oora na7aa Balaama tinbitiya;","poem":1},{"text":"iya ayfey dooyetin xeelliya addiya tinbitiya;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Xoossay giyaba si7eysa tinbitiya;","poem":1},{"text":"I som7ora gufannin, iya ayfey dooyetidaysi;","poem":2},{"lineBreak":true},{"text":"Ubbaa danda7iya Xoossaa qoncethaa be7ida addiya tinbitey haysa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yayqooba, ne dunkaaneti,","poem":1},{"text":"Isra7eele, ne gutati,","poem":2},{"lineBreak":true},{"text":"ayba lo77oona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Enti micetida zangaarada,","poem":1},{"text":"shaafa gaxan de7iya atakiltiya bessada,","poem":2},{"lineBreak":true},{"text":"Goday tokida godare uuthada,","poem":2},{"lineBreak":true},{"text":"haatha gaxan de7iya ziga mithada hanoosona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Enta xuggay haathan kumana;","poem":1},{"text":"enta kochay gidiya haathi demmana.","poem":2},{"text":"Enta kawoy kawa Agaagape aadhana;","poem":1},{"text":"enta kawotethay bonchetana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Xoossay enta Gibxefe kessis;","poem":1},{"text":"I mino menthada entaw oletees.","poem":2},{"text":"Enta morketa mentherethees;","poem":1},{"text":"enta meqethaa gaaccees;","poem":2},{"lineBreak":true},{"text":"ba dongiyan caddees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Enti gaammoda zin7idosona;","poem":1},{"text":"macca gaammoda zaqullidosona;","poem":2},{"lineBreak":true},{"text":"enta boshechanaw danda7ey oonee?","poem":2},{"text":"Enta anjiya ubbay anjetana;","poem":1},{"text":"enta baaddiya ubbay baadetana” yaagis.","poem":2}]},{"type":"verse","number":10,"content":["Yaatin, Balaaqi Balaama bolla yilotis. Ba kushiya baqidi Balaamako, “Ta morketa baaddana mela ta nena ehas, shin neeni heedzu toho enta anjadasa."]},{"type":"verse","number":11,"content":["Ha77i ellesada ne soo ba; ta nena darobaa woytana gas, shin neeni woytuwa ekonna mela Goday nena diggis” yaagis."]},{"type":"verse","number":12,"content":["Balaami Balaaqako zaaridi, “Neeni taako kiitida asaako,"]},{"type":"verse","number":13,"content":["‘Balaaqi hari attoshin ba kawotethan kumida biraanne worqaa taw immiyaba gidikoka Goday odidaysa menthada lo77o woyko iita ta shenen oothanaw danda7ike. Taani Goday giyaba xalaala odana’ gada new odabikinayee?” yaagis."]},{"type":"heading","content":["Balaama Oyddantho Haasaya"]},{"type":"verse","number":14,"content":["Balaami Balaaqako, “Taani ha77i ta asaako bayis; shin ne haaya; Isra7eele asay yaana wodiyan ne asaa oothanaba ta new odana” yaagis."]},{"type":"verse","number":15,"content":["I ba tinbitiya haysada yaagidi odis;",{"text":"“Iya ayfey tishshi oothidi xeelliya,","poem":1},{"text":"Bi7oora na7aa Balaama tinbitey haysa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Haysi Xoossay giyaba si7eysa tinbitiya,","poem":1},{"text":"Ubbaa danda7iya Xoossafe","poem":2},{"lineBreak":true},{"text":"gidida eratethi de7iya uray.","poem":2},{"text":"Lichi gidi som7ora gufannin,","poem":1},{"text":"iya ayfey dooyetidaysinne","poem":2},{"text":"Ubbaa Danda7iya Xoossaa","poem":1},{"text":"qoncethaa be7eysa tinbitey haysa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Taani iya be7ayis, shin wodey ha7i gidenna;","poem":1},{"text":"ta iya xeellayis, shin matan deenna.","poem":2},{"text":"Yayqooba sheeshape xoolintoy keyana;","poem":1},{"text":"Isra7eelepe kawotetha xam7ay keyana.","poem":2},{"text":"Moo7abe asaa som7uwa I gaaccana;","poem":1},{"text":"Seeta asaa ubbaa huuphiya I tinchana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Edoomey xoonetana;","poem":1},{"text":"iya morkey Sayrey oyketana;","poem":2},{"lineBreak":true},{"text":"shin Isra7eeley minni minni baana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yayqoobape haareysi keyana;","poem":1},{"text":"kataman paxa attidaysata dhaysana” yaagis.","poem":2}]},{"type":"verse","number":20,"content":["Hessafe guye, Balaami Amaaleqa be7idi haysada yaagidi tinbite odis;",{"text":"“Amaaleqi kawotethata giddon koyro,","poem":1},{"text":"shin enta wursethay dhayo” yaagis.","poem":2}]},{"type":"verse","number":21,"content":["Qassi Balaami Qeena be7idi haysada yaagidi tinbite odis.",{"text":"“Hinte de7iya bessay saro bessi;","poem":1},{"text":"hinte keethay zaalla bolla keexetis.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Shin Asooreti hintena di77iya wode,","poem":1},{"text":"hinte Qeena asay dhayana” yaagis.","poem":2}]},{"type":"verse","number":23,"content":["Wursethan Balaami haysada yaagidi tinbite odis;",{"text":"“Xoossay hessa oothiya wode,","poem":1},{"text":"ooni de7on daanaw danda7ii?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Markabeti Qophiroosape yaana;","poem":1},{"text":"enti Asoorenne Ebeera xoonana;","poem":2},{"lineBreak":true},{"text":"shin entika qassi dhayana” yaagis.","poem":2}]},{"type":"verse","number":25,"content":["Hessafe guye, Balaami dendidi ba soo simmis; Balaaqika ba ogiya bis."]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/NUM/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/NUM/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/NUM/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}