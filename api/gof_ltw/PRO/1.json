{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_ltw","name":"Leemiso Maxaafa","commonName":"Leemiso Maxaafa","title":"Leemiso Maxaafa","order":20,"numberOfChapters":31,"sha256":"95d70e6d82da62b90de57969d9cb4fede4fc023eb08e912eaff45805545a5370","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_ltw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":1,"content":[{"type":"heading","content":["Leemiso Go77a"]},{"type":"verse","number":1,"content":["Haysati Isra7eele kawa Dawita na7aa Solomone leemisota."]},{"type":"verse","number":2,"content":["Leemisoti asay cincatethi, seeranne era haasaya akeekanaw maaddoosona."]},{"type":"verse","number":3,"content":["Enti cincatethi, xillotethi, suure pirdinne suure wozani daana mela tamaarsoosona."]},{"type":"verse","number":4,"content":["Eeyatas akeeka immees; na7atethatas eratethinne kahaamatethi immees."]},{"type":"verse","number":5,"content":["Cincati ha leemisota si7idi, era gujoosona; akeekanchoti lo77o zore ekoosona."]},{"type":"verse","number":6,"content":["Hessan leemisotanne enta birshethaa, cincatetha odaanne enta qan7isheta akeekanaw danda7etees."]},{"type":"verse","number":7,"content":["Godaas yashshi cincatethas doomethi; shin eeyati cincatethinne seera kadhoosona."]},{"type":"heading","content":["Cincatethi New Miishe Ootha"]},{"type":"verse","number":8,"content":[{"text":"Ta na7aw, ne aawa zoriya si7a;","poem":1},{"text":"ne aaye timirtiya kadhopa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hessi ne huuphiyas boncho kallacha;","poem":1},{"text":"ne qoodhiyas gozda gidana.","poem":2}]},{"type":"verse","number":10,"content":["Ta na7aw, nena nagaranchoti",{"text":"cimmiko ero goopa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Enti, “Nuura yedha;","poem":1},{"text":"ase wodhanaw hokidi naagoos;","poem":2},{"lineBreak":true},{"text":"xillota wodhanaw qosetoos.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Si7ooley mitteysada nuka enta paxa mittoos;","poem":1},{"text":"nu enta ollan yegetiya asada oothana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nuuni al7o miishe ubbaa demmana;","poem":1},{"text":"nu keethaa bonqe miishen kunthana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nuura laggeta;","poem":1},{"text":"nu demmidaba issife shaaketana” yaagana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ta na7aw, entara hemetofa;","poem":1},{"text":"enta ogiyara baanaw ne tohuwa denthofa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Enti iitabaa oothanaw woxoosona;","poem":1},{"text":"asa suuthi gussanaw yaa haa goosona.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kafoy xeellishin,","poem":1},{"text":"iya oykanaw gite yegethi maaddenna.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Shin enti banta suuthi gussanaw hokosona;","poem":1},{"text":"banta shempuwa wodhanaw qosetoosona.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Genen go77a demmiya asa wursethi hessa mela;","poem":1},{"text":"enti shiishida shaloy enta shempuwa ekees.","poem":2}]},{"type":"heading","content":["Cincatethi Xeegees"]},{"type":"verse","number":20,"content":[{"text":"Cincatethi daggala bolla eqada xeegawusu;","poem":1},{"text":"dabaaban ba qaala dhoqu oothada sissawusu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Cincatethi asi shiiqiya bessan eqada xeegawusu;","poem":2},{"lineBreak":true},{"text":"katamaa geliya pengen eqada haysada yaagawusu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“Hinteno, akeeki pacidaysato,","poem":1},{"text":"hinte awude gakanaw eeya gididi daanee?","poem":2},{"text":"Qelqiseysato, awude gakanaw ufaytanee?","poem":1},{"text":"Eeyato, awude gakanaw eratethi ixanee?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ta seera hinte si7idaba gidiyako,","poem":1},{"text":"taani ta eraa hinte bolla gussana;","poem":2},{"lineBreak":true},{"text":"ta qaalaka hintena tamaarsana.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Shin ta xeegida wode hinte koyonna ixida gisho;","poem":1},{"text":"taani kushe miccin oonika akeekibona gisho;","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ta zoriya hinte kadhida gisho;","poem":1},{"text":"ta seeraka ekiboonna gisho;","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hintena metoy gakiya wode ta miicana;","poem":1},{"text":"hinte dagaman kokoriya wode ta qelqisana.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Gadoy uushoda hinte bolla yaa wode,","poem":2},{"lineBreak":true},{"text":"metoy goteda hinte bolla eqiya wode,","poem":2},{"lineBreak":true},{"text":"un7inne waayey hinte bolla gakiya wode,","poem":2},{"lineBreak":true},{"text":"taani hintena qelqisana.","poem":2}]},{"type":"verse","number":28,"content":["“He wode enti tana xeegana; shin ta koyke;",{"text":"enti tana minthidi koyana; shin demmokona.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Enti eratethi ixida gisho;","poem":2},{"lineBreak":true},{"text":"Godaa yashshi dooriboonna gisho,","poem":2}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ta zoriya ekiboonna gisho;","poem":2},{"lineBreak":true},{"text":"ta seera kadhida gisho;","poem":2}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Enti banta oosuwa ayfiya maana;","poem":2},{"lineBreak":true},{"text":"banta qofaa ayfiya kallana.","poem":2}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Akeeki pacidaysata cincatethafe haakeysi wodhees;","poem":2},{"lineBreak":true},{"text":"eeyata qelli guussi dhaysees.","poem":2}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Shin ta odiyaba si7iya ubbay saro daana;","poem":2},{"lineBreak":true},{"text":"meto hirgafeka shempana.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}