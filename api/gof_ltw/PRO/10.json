{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_ltw","name":"Leemiso Maxaafa","commonName":"Leemiso Maxaafa","title":"Leemiso Maxaafa","order":20,"numberOfChapters":31,"sha256":"95d70e6d82da62b90de57969d9cb4fede4fc023eb08e912eaff45805545a5370","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_ltw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":10,"content":[{"type":"heading","content":["Solomone Leemisota"]},{"type":"verse","number":1,"content":["Haysati Solomone leemisota.",{"text":"Cinca na7i ba aawa ufaysees;","poem":1},{"text":"shin eeya na7i ba aayiw azzanthees.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nagaran demmida miishey go77enna;","poem":1},{"text":"shin xillotethi hayqope ashshees.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Goday xillota koshaysenna;","poem":1},{"text":"shin nagaranchota amuwa polisenna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Azallatethi manqisees;","poem":1},{"text":"shin minnidi oosoy dureyees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Cinca asi ba kathaa bone shiishees;","poem":1},{"text":"shin kathi cakiya wode dhiskiya asi kawuyees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xillo asi anjetees;","poem":1},{"text":"shin nagarancho asi","poem":2},{"lineBreak":true},{"text":"ba makallatethaa doonan genthees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Xilluwa sunthay anjon xeegetishe de7ees;","poem":1},{"text":"shin nagaranchota sunthay elle dogetees.","poem":2}]},{"type":"verse","number":8,"content":["Cinca asi kiittidaba oothees;",{"text":"shin eeya asi dhayoko bees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Suure asi saro de7ees;","poem":1},{"text":"shin geella asi ba gomen oyketees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gene ayfen qam7otiya asi meto ehees;","poem":1},{"text":"shin yayyonna seeriya asi sarotethi medhees.","poem":2}]},{"type":"verse","number":11,"content":["Xillo asa odi de7o pulto;",{"text":"shin nagarancho asa odi makalla genthees.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ixoy palama denthethees;","poem":1},{"text":"shin siiqoy bala ubbaa kammees.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wozanaama asi cincatethan odees;","poem":1},{"text":"shin eeya asa zokoy xam7as attees.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Cincati eratethi dagayoosona;","poem":1},{"text":"shin eeyata doonay dhayo dafees.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Dure asa miishey diretida katamada naagees;","poem":1},{"text":"shin manqotethi manqota dhaysees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Xillo asa oosoy iya de7o;","poem":1},{"text":"shin iita asa wursethay dhayo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Seerin simmiya asi de7o ogen hemetees;","poem":1},{"text":"shin seerin ixiya asi balees.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ixo kammiya asi wordancho;","poem":1},{"text":"zigirsi laaliya asi eeya.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Daro haasaya giddon nagari dhayenna;","poem":1},{"text":"shin ba doona shiishiya asi cinca.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Xillo asa inxarsi geeshsha bira mela;","poem":1},{"text":"shin iita asa wozani iitaban kumis.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Xillo asa odi daro asaa go77ees;","poem":1},{"text":"shin eeyati banta paca wozanan hayqoosona.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Godaa anjoy dure kessees;","poem":1},{"text":"he duretetha bolla meto gujenna.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Eeya uraas iitabaa oosoy kaassa mela;","poem":1},{"text":"shin wozanaama asi cincatethan ufaytees.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Iita asi hirgidabay iya bolla gakana;","poem":1},{"text":"shin xilloy amotidabay imetana.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Gotey aadhiya wode nagaranchoy bentenna;","poem":1},{"text":"shin xilloti merinaw minnidi daana.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Caalabay ache, cuyi ayfe qoheysada,","poem":1},{"text":"azalla asi kiittidaysa yiloyees.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Godaas yashshi laythi adussees;","poem":2},{"lineBreak":true},{"text":"shin nagaranchota laythay qaammees.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Xillo asi ufaysi yaana gidi naagees;","poem":1},{"text":"shin nagaranchota ufaysay dhayana.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Godaa ogey xillotas baqatidi attiya besse;","poem":1},{"text":"shin iita oothiya asaas dhayo.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Xilloti ubba wode qaaxokona;","poem":1},{"text":"shin iitati biitta bolla dookona.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Xillo asi cincatethan odees;","poem":1},{"text":"shin geellaba odetiya inxarsi qanxetana","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Xillo asa inxarsi bessiya haasaya erees;","poem":1},{"text":"shin iita asaa oday wobbe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PRO/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PRO/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PRO/9.json","previousChapterAudioLinks":{},"numberOfVerses":32}