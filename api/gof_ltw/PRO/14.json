{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_ltw","name":"Leemiso Maxaafa","commonName":"Leemiso Maxaafa","title":"Leemiso Maxaafa","order":20,"numberOfChapters":31,"sha256":"95d70e6d82da62b90de57969d9cb4fede4fc023eb08e912eaff45805545a5370","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_ltw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":["Cinca maccasi ba keethaa keexawusu;",{"text":"shin eeya maccasiya ba keethaa ba kushen laallawusu.","poem":2}]},{"type":"verse","number":2,"content":["Suure hemetiya asi Godaa yayyees;",{"text":"shin ba oge geellayiya asi Godaa kadhees.","poem":2}]},{"type":"verse","number":3,"content":["Eeya odi iya zokuwas xam7a ehees;",{"text":"shin cincata inxarsay enta naagees.","poem":2}]},{"type":"verse","number":4,"content":["Boori bayna ixiko shaaley kaysi gidees;",{"text":"shin goshsha boori de7iko, ne shaaley kathan kumees.","poem":2}]},{"type":"verse","number":5,"content":["Ammanetiya marki ubba wode tuma odees;",{"text":"shin wordo marki wordo xalaala odetees.","poem":2}]},{"type":"verse","number":6,"content":["Qelqisiya asi cincatethi koyees, shin demmenna;",{"text":"akeeki de7iya asi eratethi demoy waaysenna.","poem":2}]},{"type":"verse","number":7,"content":["Eeya asape haaka;",{"text":"neeni iya odape eratethi demmaka.","poem":2}]},{"type":"verse","number":8,"content":["Cinca asi cinca gidiya ba oothiyaba erees;",{"text":"shin eeya asa eeyatethay iya balethees.","poem":2}]},{"type":"verse","number":9,"content":["Eeyati nagara oothishe, qiirotanaysa aggidi qelqisoosona;",{"text":"shin suureti banta nagaray atto geetetanaw koyoosona.","poem":2}]},{"type":"verse","number":10,"content":["Issi issi wozani ba azzanuwa erees;",{"text":"iya ufaysa oonika iyara koxenna.","poem":2}]},{"type":"verse","number":11,"content":["Iitata keethay laaletana;",{"text":"shin suureta keethay minnidi daana.","poem":2}]},{"type":"verse","number":12,"content":["Asas like daaniya ogey de7ees;",{"text":"shin iya wursethay hayqoko gathees.","poem":2}]},{"type":"verse","number":13,"content":["Miicha wodeka wozanan azzanoy de7ees;",{"text":"ufaysa wursethay azzano gidanaw danda7ees.","poem":2}]},{"type":"verse","number":14,"content":["Iita asi ba iita oosuwa gate ekana;",{"text":"lo77o asika ba lo77o oosuwa gate ekana.","poem":2}]},{"type":"verse","number":15,"content":["Eeya asi ubbaba ammanees;",{"text":"shin cinca asi akeekidi tangees.","poem":2}]},{"type":"verse","number":16,"content":["Cinca asi Godaa yayyees; iitape haakees;",{"text":"shin eeya asi eesotesinne iitape naagetenna.","poem":2}]},{"type":"verse","number":17,"content":["Elle hanqetiya asi eeya ooso oothees;",{"text":"shin cinca asi danda7ancho.","poem":2}]},{"type":"verse","number":18,"content":["Akeeki bayna asi ba eeyatetha gatiya ekoosona;",{"text":"shin cinca asi eratethi kallachada goxoosona.","poem":2}]},{"type":"verse","number":19,"content":["Iitati lo77ota sinthan gulbatana;",{"text":"nagaranchati xillota pengen hokana.","poem":2}]},{"type":"verse","number":20,"content":["Manqoy ba shooruwan ixetees;",{"text":"shin duretas daro laggeti de7oosona.","poem":2}]},{"type":"verse","number":21,"content":["Ba shooruwa kadhiya asi nagara oothees;",{"text":"shin manquwa maaddiya asi anjetidaysa.","poem":2}]},{"type":"verse","number":22,"content":["Iitabaa maqeteysati baloosona gidokona?",{"text":"shin lo77oba oothanaw halcheysati","poem":2},{"lineBreak":true},{"text":"ammanetethinne siiqo demmoosona.","poem":2}]},{"type":"verse","number":23,"content":["Minnidi oothiya ooso ubban wodhey de7ees;",{"text":"shin coo odi manqotethi ehees.","poem":2}]},{"type":"verse","number":24,"content":["Cincatas enta duretethay entaw kallacha;",{"text":"shin eeyati guji guji eeyoosona.","poem":2}]},{"type":"verse","number":25,"content":["Tuma marki shempo ashshees;",{"text":"shin wordo marki balethees.","poem":2}]},{"type":"verse","number":26,"content":["Godaa yayiya asas mino miixay de7ees;",{"text":"iya naytas baqatidi attiya bessi de7ees.","poem":2}]},{"type":"verse","number":27,"content":["Godaa yashshi de7o pulto;",{"text":"hayqo xihepe ase ashshees.","poem":2}]},{"type":"verse","number":28,"content":["Kawo gitatethi I haariya asaa darotethaana;",{"text":"shin haaretiya asi dhayiko ika pathenna.","poem":2}]},{"type":"verse","number":29,"content":["Danda7ancho asas gita akeeki de7ees;",{"text":"shin elle hanqetiya asi ba eeyatetha qoncisees.","poem":2}]},{"type":"verse","number":30,"content":["Saro wozani asatethas payyatethi immees;",{"text":"shin qanaatey asatethas ajaaje harge mela.","poem":2}]},{"type":"verse","number":31,"content":["Manqota naaqiya asi enta medhidaysa cayees;",{"text":"shin metootanchotas keehiya asi Xoossaa bonchees.","poem":2}]},{"type":"verse","number":32,"content":["Iitati banta iita ooson kundana;",{"text":"shin xillotas hayqope attiya miixi de7ees.","poem":2}]},{"type":"verse","number":33,"content":["Akeekancho asa wozanan cincatethi kumis;",{"text":"shin eeyati cincatethi aybeko erokona.","poem":2}]},{"type":"verse","number":34,"content":["Xillotethi issi kawotetha dhoqu dhoqu oothees;",{"text":"shin nagari ay asika kawushshees.","poem":2}]},{"type":"verse","number":35,"content":["Erancho aylletanan kawoy ufaytees;",{"text":"shin yeellaya aylley kawa hanqethees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PRO/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PRO/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PRO/13.json","previousChapterAudioLinks":{},"numberOfVerses":35}