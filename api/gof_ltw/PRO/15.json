{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_ltw","name":"Leemiso Maxaafa","commonName":"Leemiso Maxaafa","title":"Leemiso Maxaafa","order":20,"numberOfChapters":31,"sha256":"95d70e6d82da62b90de57969d9cb4fede4fc023eb08e912eaff45805545a5370","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_ltw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":["Liiqo inxarsi hanqo zarbisees;",{"text":"shin dom7ethiya qaali hanqo denthethees.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Cincata inxarsay era puulayees;","poem":1},{"text":"shin eeyata doonay eeyatethi pultisees.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Godaa ayfeti ubba bessi xeelloosona;","poem":1},{"text":"iitatanne lo77ota shaakidi be7oosona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lo77o odi de7o mitha mela;","poem":1},{"text":"shin geella odi ayyaana menthees.","poem":2}]},{"type":"verse","number":5,"content":["Eeyi ba aawa seera kadhees;",{"text":"shin ba aawa seera ekiya asi cinca.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xillo uraa keethan daro miishey de7ees;","poem":1},{"text":"shin iitata soo geliya miishey meto ehees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Cincata doonay era zerees;","poem":1},{"text":"shin eeyata wozanay hessa mela gidenna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Goday iitata yarshuwa ixees;","poem":1},{"text":"shin suureta woosan I ufaytees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Goday iita asata ogiya ixees;","poem":1},{"text":"shin xillotethi kaalleyisata I dosees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Like ogiya aggida asi pirdi naagees;","poem":1},{"text":"seera ixiya asi hayqees.","poem":2}]},{"type":"verse","number":11,"content":["Duufoynne dhayoy Godaa sinthan qonce;",{"text":"yaatin, asa wozana qofay waani iyape geemmanee?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Qelqisiya asi seera dosenna;","poem":1},{"text":"cincatape zore oychenna.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wozani ufaytin, som7oy poo7ees;","poem":1},{"text":"shin wozani azzaniko, ayyaani meqees.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Akeeka wozani de7iya asi eratethi koyees;","poem":1},{"text":"shin eeyati banta eeyatethan ufaytoosona.","poem":2}]},{"type":"verse","number":15,"content":["Manqota de7oy ubba wode baaxe;",{"text":"shin ufaytiya asi ubba wode alees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ooshshara de7iya gita aqope","poem":1},{"text":"Godaa yashshara de7iya guuthabay keeha.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ooshshi de7iya bessan modho asho maanape","poem":1},{"text":"siiqoy de7iya bessan santhi keeha.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hanqoy ooshshi kessees;","poem":1},{"text":"shin danda7i ooshshi irxisees.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Azalla asa ogey agunthan diretis;","poem":1},{"text":"shin suure asa ogey giiga.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Cinca na7i ba aawa ufaysees;","poem":1},{"text":"shin eeya na7i ba aayiw kadhees.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Wozani bayna asi ba eeyatethan ufaytees;","poem":1},{"text":"shin wozanaama asi bessiya ba oothees.","poem":2}]},{"type":"verse","number":22,"content":["Zorey dhayiko, qopidabay haddirees;",{"text":"daro zorey de7iya bessan qopidabay poletees.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Oyshas bessiya zaaro imoy he uraa ufaysees;","poem":1},{"text":"ba woden odetiya odi ay mela ufaysi!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Garsan de7iya si7oolepe attana mela","poem":1},{"text":"de7o ogey akeeka uraa pude kaalethees.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Goday otoranchota keetha laallana;","poem":1},{"text":"shin am7e zawa naagees.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Goday iitata qofaa ixees;","poem":1},{"text":"shin geeshsha qaalan I ufaytees.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Wordon wodhe demmanaw aaliya asi","poem":1},{"text":"ba soo asaa bolla meto ehees;","poem":2},{"lineBreak":true},{"text":"shin wodhaafe ixiya asi de7on daana.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Xillo asi odetanape sinthatidi qopees;","poem":1},{"text":"shin iitata inxarsaape iitabay pultees.","poem":2}]},{"type":"verse","number":29,"content":["Goday iitatape haakees;",{"text":"shin xillota woosa si7ees.","poem":2}]},{"type":"verse","number":30,"content":["Som7oy pashkin wozani ufaytees;",{"text":"mishiraachoy meqethi minthees.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"De7o immiya zore si7iya asi","poem":1},{"text":"cincatethara issife daana.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Seera ixiya asi bana qohees;","poem":1},{"text":"shin seera ekiya asi akeeka demmees.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Godaas yashshi cincatethi tamaarsees;","poem":1},{"text":"ashketethi bonchofe sinthatees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PRO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PRO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PRO/14.json","previousChapterAudioLinks":{},"numberOfVerses":33}