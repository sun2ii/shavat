{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_ltw","name":"Leemiso Maxaafa","commonName":"Leemiso Maxaafa","title":"Leemiso Maxaafa","order":20,"numberOfChapters":31,"sha256":"95d70e6d82da62b90de57969d9cb4fede4fc023eb08e912eaff45805545a5370","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_ltw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":["Asi ba wozanan halchees;",{"text":"shin like zaaroy Godaape bentees.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Asi oothiya ooso ubbay iyaw like daanees;","poem":1},{"text":"shin Goday dendo qofaa be7ees.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne ooso ubbaa Godaas hadara imma;","poem":1},{"text":"neeni qopidabay poletana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Goday ubbabay qopidaysatho bana mela oothees;","poem":1},{"text":"hanikoka, makallanchota wursethay dhayo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Goday otoranchota ixees;","poem":1},{"text":"enti seerettonna attokona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Siiqoninne ammanetethan nagari atto geetetees;","poem":1},{"text":"Godaas yayyidi asi iitabaape attees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Asa hemethi Godaa ufaysiyabaa gidiko,","poem":1},{"text":"I ba morketara saro daanada oothees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Xillotethan bentiya guuthabay,","poem":1},{"text":"wordon demmiya daro wodhepe lo77o.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Asi wozanan ba oothanaba halchees;","poem":1},{"text":"shin halchoy Godaa maaden poletees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kawoy Xoossaafe ekida maatan pirdees;","poem":1},{"text":"iya inxarsay suure pirdees.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gina mizaanetinne maka miisheti Godaaba;","poem":1},{"text":"bayziyaba ubban geney doonna mela Goday koyees.","poem":2}]},{"type":"verse","number":12,"content":["Kawoti iita ooso ixoosona;",{"text":"enta araatay xillotethan eqees.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kawoti xillo inxarsan ufaytoosona;","poem":1},{"text":"tumaa haasaya uraa dosoosona.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kawa hanqoy hayqo kiitancho mela;","poem":1},{"text":"shin cinca asi hanquwa irxisees.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kawa som7oy poo7iko de7oy de7ees;","poem":1},{"text":"Iya lo77otethay ira ehiya shaara mela.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Cincatethi demoy worqa demope aadhees;","poem":1},{"text":"akeeka demoy bira demope lo77o.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Suureta ogey iitape haako;","poem":1},{"text":"ba hemethaa naagiya uray ba shempuwa naagees.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Otoroy dhayo kaalethees;","poem":1},{"text":"ceeqetethi kundethi ehees.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Otoranchotara di7o shaaketanaape,","poem":1},{"text":"ashke gididi manqidi de7eysi lo77o.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Zore si7iya uraas I oothiyaba ubbay injetana;","poem":1},{"text":"Godan ammanetiya uray anjetana.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ba qofan cinca gidida asi akeekancho geetetees;","poem":1},{"text":"lo77o qaali eratethi gujees.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Cinca asas eratethi de7o pulto mela;","poem":1},{"text":"shin eeyata seeroy coo wode wursees.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Cinca asi odetanaape sinthe qopees;","poem":1},{"text":"iya mettershay eratethi gujees.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Lo77o qaali eessa ililoda mal7ees;","poem":1},{"text":"shempos mal7o; meqethas paxo gidees.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Asas suure daaniya ogey de7ees;","poem":1},{"text":"shin wursethan hayqoko gathees.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Asi minnidi oothana mela oothey katha amo;","poem":1},{"text":"koshi minnidi oothana mela denthethees.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kawusha asi iitabaa halchees;","poem":1},{"text":"iya oday tamada xuuggees.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Wobe asi ooshshi denthethees;","poem":1},{"text":"zigirsi ammanetiya laggeta shaakees.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Gene asi ba shooruwa cimmees;","poem":1},{"text":"lo77o gidonna oge kaalethees.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ba ayfen qam7otiya asi geellaba qopees;","poem":1},{"text":"ba mettersha saxidi mandiya asi iitabaa oothees.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Puulumida huuphey boncho kallacha;","poem":1},{"text":"hessika bentey xillo de7o de7ina.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Wolqaama asi gidanaape danda7a asi gidoy lo77o,","poem":1},{"text":"daro katamata olidi oykanaape bana haaroy aadhees.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Asi saama yeggees;","poem":1},{"text":"shin wursetha zaaroy Godaape bentees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PRO/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PRO/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PRO/15.json","previousChapterAudioLinks":{},"numberOfVerses":33}