{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_ltw","name":"Leemiso Maxaafa","commonName":"Leemiso Maxaafa","title":"Leemiso Maxaafa","order":20,"numberOfChapters":31,"sha256":"95d70e6d82da62b90de57969d9cb4fede4fc023eb08e912eaff45805545a5370","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_ltw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":["Ooshshi de7iya bessan de7iya gita gibiraape",{"text":"saroynne wopi de7iya bessan uytha poqoy lo77o.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Cinca aylley pathonna ba godaa na7aa haarees;","poem":1},{"text":"iya ishatara issife laata shaaketees.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Worqinne biri taman paaceteysada;","poem":1},{"text":"Goday asa wozana paacees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iita asi iita haasaya si7ees;","poem":1},{"text":"wordanchoy wordo haasaya hayzees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Manqota bolla qelqisiya asi enta medhida Xoossaa cayees;","poem":1},{"text":"hara asi gakiya meton ufaytiya asi seerettonna attenna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Na7a na7i cima asas kallacha;","poem":1},{"text":"aawati banta naytas boncho.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lo77o odi eeya asas giigenna;","poem":1},{"text":"hessadaka wordo odi ayseysas giigenna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wodhaafe immeysas wodhaafey bita mela;","poem":1},{"text":"I biya bessa ubbay iyaw injetees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Qoho genthiya uray siiqo koyees;","poem":1},{"text":"shin oda zaaridi zaaridi woociya uray,","poem":2},{"lineBreak":true},{"text":"ammanetiya laggeta shaakees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Eeyay xeetu toho lisson shocin ereysafe;","poem":1},{"text":"akeeki de7iya asas coo hanqoy era immees.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Iita asi ubba wode geella;","poem":1},{"text":"qadhey bayna asi iya bolla kiitetana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Eeyara iya eeyatethan gahetanaape","poem":1},{"text":"marati eketida maahera gahetethi lo77o.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Lo77o oothidaysas iita kushe zaariya","poem":1},{"text":"uraa soope iitabay kichenna.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ooshshi doomishe haatha dhawa mentheysa mela;","poem":1},{"text":"hessa gisho ooshshi doomanaape koyrottada palama agga.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nagaranchuwa xillisoynne","poem":1},{"text":"xilluwa bolla pirdoy,","poem":2},{"lineBreak":true},{"text":"nam7ayka Goday ixiya ooso.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Cincatethi demmanaw amoy bayna de7ishin,","poem":1},{"text":"eeya kushen de7iya miishey ay iya maaddii?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Laggey ubba wodeka lagge;","poem":1},{"text":"ishi meto wode maaddanaw yeletees.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Akeeki bayna asi eronna uraa","poem":1},{"text":"acuwa qanxanaw waase gidees.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ooshshu dosiya asi nagara dosees;","poem":1},{"text":"ubba wode ceeqetiya asi ba bolla dhayo xeegees.","poem":2}]},{"type":"verse","number":20,"content":["Wobe qofi de7iya asi lo77oba demmenna;",{"text":"ba inxarsan cimmiya asi meton gelees.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Eeyaa na7a yelida aawi azzanees;","poem":1},{"text":"eeya na7a aawas ufaysi deenna.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ufaytiya wozani asas lo77o dhale;","poem":1},{"text":"shin meqida wozani asas wolqa dhaysees.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Iita asi pirda geellayanaw","poem":1},{"text":"geeman wodhaafe ekees.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Akeeka asi cincatethi ba sinthafe haassenna;","poem":1},{"text":"shin eeya asa ayfey sa7a gaxa yuuyees.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Eaya na7i ba aawa azzanthees;","poem":1},{"text":"ba aayiwuka camisees.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Xillo asi seeroy bessenna;","poem":1},{"text":"suure asi shocoy lo77o gidenna.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Guutha qaala haasaya asi erancho;","poem":1},{"text":"wopa ayyaani de7iya asi akeekancho.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Eeya asi si77i giiko cinca daanees;","poem":1},{"text":"ba doona dooyonna ixiko erancho daanees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PRO/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PRO/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PRO/16.json","previousChapterAudioLinks":{},"numberOfVerses":28}