{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_ltw","name":"Leemiso Maxaafa","commonName":"Leemiso Maxaafa","title":"Leemiso Maxaafa","order":20,"numberOfChapters":31,"sha256":"95d70e6d82da62b90de57969d9cb4fede4fc023eb08e912eaff45805545a5370","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_ltw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":["Shaahetethi koyiya asi ba amuwa kaallees;",{"text":"suure qofa ubbaa ixees.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Eeya asi ba qofaa xalaala qoncisanaw dosees;","poem":1},{"text":"hara asape era ekanaw dosenna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iitatethi yaa wode kadhey yees;","poem":1},{"text":"kawushatethi yaa wode yeelli yees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Asa doonape keya odi,","poem":1},{"text":"ciimmo haatha mela;","poem":2},{"lineBreak":true},{"text":"cincatethi goggiya pulto mela.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Naaqida uraa maaddidi, xilluwa pirdaa","poem":1},{"text":"geellayeysi lo77o gidenna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eeya asa odi ooshshu denthethees;","poem":1},{"text":"iya doonay wadho xeegees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Eeya asa odi bana qohees;","poem":1},{"text":"iya oday xihe gididi iya oykees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Zigirsi mal7o katha mela;","poem":1},{"text":"ufaysishe duge ganje gakees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Azalla asi","poem":1},{"text":"dhaysiya asape aybaka dummatenna.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Godaa sunthay mino gimbe mela;","poem":1},{"text":"xillo asi yaa woxidi saro attees.","poem":2}]},{"type":"verse","number":11,"content":["Dure asata duretethay gimbetida katama mela;",{"text":"enta qofan enta duretethay","poem":2},{"lineBreak":true},{"text":"mino dirsada enta naagiyaba daanees.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Otoroy kundethafe sinthatees;","poem":1},{"text":"ashketethi boncho ehees.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Si7onna de7ishe zaaro imoy,","poem":1},{"text":"he uraas eeyatethinne yeella.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Daana gidi qopiko, iya ayyaanay harge danda7isees;","poem":1},{"text":"shin ufaysi qanxiko iya maaddey baawa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Akeeka asi eratethi koyees;","poem":1},{"text":"cinca asa haythi cincatethi si7ees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Imoti immeysas oge dooyees;","poem":1},{"text":"gita asatara erisees.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Daynna sinthan koyro shiiqidi mootiya uray,","poem":1},{"text":"iya morkey yin, iya oychana gakanaw,","poem":2},{"lineBreak":true},{"text":"ubba wode bana xillo gidi qopees.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Saama yegethi palama teqees;","poem":1},{"text":"nam7u palamiya asata shaakees.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Qohetida ishay gimbetida","poem":1},{"text":"katamape aadhidi minnees;","poem":2},{"lineBreak":true},{"text":"iya palamay birata gorde mela.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Asi ba doona odan ba ulo kunthees;","poem":1},{"text":"ba inxarsaa ayfen kallees.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hayqoynne de7oy inxarsana;","poem":1},{"text":"neeni ne inxarsaa ayfiya maana.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Macho demmiday lo77oba demmis;","poem":1},{"text":"i, Godaape teema demmees.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Manqo asi aaddashidi odetees;","poem":1},{"text":"shin dure asi otoron zaarees.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Daro laggey de7iya asi ba bolla meto ehees;","poem":1},{"text":"shin ishape aadhidi matatiya laggey de7ees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PRO/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PRO/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PRO/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}