{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_ltw","name":"Leemiso Maxaafa","commonName":"Leemiso Maxaafa","title":"Leemiso Maxaafa","order":20,"numberOfChapters":31,"sha256":"95d70e6d82da62b90de57969d9cb4fede4fc023eb08e912eaff45805545a5370","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_ltw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":["Ba doonan wordotiya eeya asape",{"text":"ba de7uwan borey bayna manqoy lo77o.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Eri bayna dafetethi lo77o gidenna;","poem":1},{"text":"eeso daroy oge balethees.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Asi ba eeyatethan ba de7uwa iissees;","poem":1},{"text":"yaatidi Godaa bolla yilotees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Duretethi daro lagge shiishees;","poem":1},{"text":"shin manqotethi de7iya laggeta duuthees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wordo marki seerettonna attenna;","poem":1},{"text":"wordo odetey kessi ekenna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Daro asay shuuma som7o koyoosona;","poem":1},{"text":"imota immiya asara asi ubbay dabbotees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Manqo asi hari attoshin iya ishati ixoosona;","poem":1},{"text":"iya laggeti iyape haakoosona;","poem":2},{"lineBreak":true},{"text":"I enta aaddashinka enti iya koyokona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Cincatethi demmiya asi ba shempuwa dosees;","poem":1},{"text":"eratethi minthidi oykiya uraas injetees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wordo marki seerettonna attenna;","poem":1},{"text":"wordo odetey dhayana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Eeya asas inje de7oy bessenna;","poem":1},{"text":"aylley halaqata haaroy daro iita.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Cincatethi ase danda7a tamaarsees;","poem":1},{"text":"qoho kadhidi aadhethi bonchisees.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kawa hanqoy gaammo gudetha mela;","poem":1},{"text":"shin iya nashshoy maata aacisiya aka mela.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Eeya na7i ba aawa dhaysees;","poem":1},{"text":"doonama macha xokiya keetha mela.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Asi keethenne shalo aawupe laattees;","poem":1},{"text":"shin akeeka macho Goday immees.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Azallatethi dhisko ehees;","poem":1},{"text":"ooso oothonna asi koshatees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kiita naagiya asi ba shempuwa naagees;","poem":1},{"text":"shin qelli giya asi hayqees.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Manqos keehiya asi Godaas tal7ees;","poem":1},{"text":"Goday he lo77o oosuwa gisho woytees.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Simo ufaysi de7ishin ne nayta seera;","poem":1},{"text":"seeronna ixiko, ne enta dhaysaasa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Elle shenetiya asi ba gatiya ekanaw bessees;","poem":1},{"text":"neeni iya issi toho ashshiyaba gidiko,","poem":2},{"lineBreak":true},{"text":"hara wodeka ne iya hessada ashshanaysi attenna.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Zore si7a; tamaaranaw koya;","poem":1},{"text":"neeni wursethi gakanaw cinca gidana.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Asi darobaa halchees;","poem":1},{"text":"shin Goday gidabay poletees.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Asape koyetey ammanetethi;","poem":1},{"text":"wordo gidanaape manqo gideysi lo77o.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Godaas yashshi de7oko kaalethees;","poem":1},{"text":"iya yayiya asi kallidi de7ees; iiti iya bochenna.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Issi issi asi daro azalla;","poem":1},{"text":"hari attoshin woxen tushkida","poem":2},{"lineBreak":true},{"text":"uythaa pude baaranaw waayetees.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Neeni qelqisiya asi shociko,","poem":1},{"text":"akeeki pacidaysi cincatethi tamaarana;","poem":2},{"lineBreak":true},{"text":"akeeka asi ne hanqetiko, I eratethi demmana.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ba aawa bonqiya na7ay,","poem":1},{"text":"ba aayiw yedethiya na7ay,","poem":2},{"lineBreak":true},{"text":"yeellanne kawushatethi ehiya na7a.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ta na7aw, ne zore si7onna ixiko,","poem":1},{"text":"era ogiyape haakaasa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Wordo marki suure pirda bolla qelqisees;","poem":1},{"text":"iita asa dooni iitatethi mittees.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Qelqisiya asas pirda","poem":1},{"text":"eeyatas wadho koshshees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PRO/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PRO/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PRO/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}