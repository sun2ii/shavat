{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_ltw","name":"Leemiso Maxaafa","commonName":"Leemiso Maxaafa","title":"Leemiso Maxaafa","order":20,"numberOfChapters":31,"sha256":"95d70e6d82da62b90de57969d9cb4fede4fc023eb08e912eaff45805545a5370","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_ltw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":2,"content":[{"type":"heading","content":["Cincatetha Go77a"]},{"type":"verse","number":1,"content":["Ta na7aw, ta timirtiya ne ekiko;",{"text":"ta kiitaa ne wozanan wothiko;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ne haythaa cincatethako zaariko;","poem":2},{"lineBreak":true},{"text":"ne wozanaa akeekako zaariko;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Eratethi xeegiko;","poem":1},{"text":"akeeka dhoqu oothada xeegiko;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bira woyko geemmida miishe koyeysada,","poem":1},{"text":"neeni eratethi koyko,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"He wode neeni Godaas yashshi guussi aybeko erana;","poem":1},{"text":"Xoossaa loythada erana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Goday cincatethi immees;","poem":1},{"text":"iyape eratethinne akeeki bentees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I suuretas maaddiya zore minjees;","poem":1},{"text":"borey baynaysatas gondalle gidees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Suure pirda ogiya naagees;","poem":1},{"text":"iyaw ammaneteyisata ogiya minthees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"He wode neeni xillotethi, suure pirdaa,","poem":1},{"text":"suure ogenne lo77o oosoy aybeko akeekana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Cincatethi ne wozana giddo gelana;","poem":1},{"text":"eratethi new ufaysi gidana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Shaakidi eroy nena naagana;","poem":1},{"text":"akeeki nena kammana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Cincatethi nena iita asata ogiyape naagana;","poem":1},{"text":"geella odape nena ashshana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Enti nagara dhuman daanaw,","poem":1},{"text":"xillotetha ogiya aggidosona.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iita ooson ufaytoosona;","poem":1},{"text":"geellatethan hashshu goosona.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Enta oosoy mirqethi;","poem":1},{"text":"enta de7oy geella.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Cincatethi layma maccasape,","poem":1},{"text":"qaalan cimmiya laggethofe nena ashshana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Iya ba na7atetha azina aggaagasu;","poem":1},{"text":"Xoossa sinthan caaqida caaquwa dogasu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"I soo ogey hayqoko gathees;","poem":1},{"text":"iiko buussi moytilletako gathees.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Iiko biya oonika guye simmenna;","poem":1},{"text":"de7o oge demmenna.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hessa aggada, lo77o asata leemisuwa kaalla;","poem":1},{"text":"xillo asata hemethaa naaga.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Suure asatinne borey baynaysati,","poem":1},{"text":"biittan adussa laythi daana.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Shin iitati biittafe shodetana;","poem":1},{"text":"ammanetonaysati dhayana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}