{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_ltw","name":"Leemiso Maxaafa","commonName":"Leemiso Maxaafa","title":"Leemiso Maxaafa","order":20,"numberOfChapters":31,"sha256":"95d70e6d82da62b90de57969d9cb4fede4fc023eb08e912eaff45805545a5370","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_ltw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":["Mathoya ushshi eeyanne ooshancho oothees;",{"text":"ushshan baletiya asi cinca gidanaw danda7enna.","poem":2}]},{"type":"verse","number":2,"content":["Kawo hanqoy gaammo gudetha mela;",{"text":"iya yiloyiya asi ba shempuwa bolla pirdees.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Palamape haakeysi boncho;","poem":1},{"text":"shin eeya asi ooyetanaw ellesees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Azalla goshshanchoy wode naagidi goyenna;","poem":1},{"text":"kathi cakiya wode I woossanaw koyees;","poem":2},{"lineBreak":true},{"text":"shin aybaka demmenna.","poem":2}]},{"type":"verse","number":5,"content":["Asa wozana halchoy ciimmo haatha mela;",{"text":"shin wozanaama asi duuqidi kessees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Daro asati banta lo77otetha odoosona;","poem":1},{"text":"shin tuma ammanetiya asi demmanay oonee?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Xillo asi borey bayna de7o de7ees;","poem":1},{"text":"iya kaalliya iya nayti anjetidaysata.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kawoy pirdanaw ba araatan uttiya wode,","poem":1},{"text":"iita ubbaa ba ayfen harqidi kessees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Ta wozanay geeshshi; tanan nagari baawa”","poem":1},{"text":"gaanaw danda7iya asi daanesha?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Goday wordo mizaanenne","poem":1},{"text":"gina gidonna maka miishen go7eteyisata ixees.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Na7i geeshshinne suure gideysi","poem":1},{"text":"I oothiya ooson eretees.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Si7iya haythinne xeelliya ayfe,","poem":1},{"text":"Goday medhis.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dhiskon ne wode wursiko ne manqana;","poem":1},{"text":"minnada oothiko ne kathi kallana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Shammiya asi, “Qohees! Qohees!” yaagees;","poem":1},{"text":"shin bidaape guye, “Gelan shammas” yaagidi ceeqetees.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Worqey kumis; al7o shuchika bentees;","poem":1},{"text":"shin eri kumida inxarsi ubbaafe aadhida alleeqo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Eronna asas waase geliya uraa ma7uwa qaari ekite;","poem":1},{"text":"imatha asas waase geliya uraa ma7o oykite.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wordon demmida kathi mal7ees;","poem":1},{"text":"shin aqidi pee7ishe doonan aceda hanees.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Zore ekada ne qofaa qacha;","poem":1},{"text":"zore ekonna de7ashe ola boopa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Zigiriya asi xuura genthenna;","poem":1},{"text":"hessa gisho, coo haasaya asape haaka.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ba aawa woyko ba aayiw baaddiya asa,","poem":1},{"text":"de7o xompey sakana dhuman to7ana.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Koyrora eeson shiiqida shaloy","poem":1},{"text":"wursethan anjetenna.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nena qohida uraa qohada zaarana goopa;","poem":1},{"text":"Godan ammaneta; I nena ashshana.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Goday nam7u qommo mizaane ixees;","poem":1},{"text":"wordo mizaaney iya ufaysenna.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Asay baana ogiya Goday kaalethees;","poem":1},{"text":"yaatin, asi ba de7on baana ogiya","poem":2},{"lineBreak":true},{"text":"waatidi akeekanaw danda7ii?","poem":2}]},{"type":"verse","number":25,"content":["Eeson, “Haysa taani Xoossas immas” guussinne",{"text":"guyepe qiirotethi asas xihe.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Cinca kawoy geellata shaakidi erees;","poem":1},{"text":"I enta qadhetonna seerees.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Asa ayyaani Godaas xompe;","poem":1},{"text":"iya gaatha asatethaa ubbaa pilgidi xeellees.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Siiqoynne ammanetethi kawa naagoosona;","poem":1},{"text":"iya araatay tuma pirdan minnees.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Yalagata bonchoy enta wolqaa;","poem":1},{"text":"cimata bonchoy enta puulunthaa.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Mino seeri iitatethi shoddees;","poem":1},{"text":"wadhoy iita wozana laammees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PRO/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PRO/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PRO/19.json","previousChapterAudioLinks":{},"numberOfVerses":30}