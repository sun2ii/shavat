{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_ltw","name":"Leemiso Maxaafa","commonName":"Leemiso Maxaafa","title":"Leemiso Maxaafa","order":20,"numberOfChapters":31,"sha256":"95d70e6d82da62b90de57969d9cb4fede4fc023eb08e912eaff45805545a5370","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_ltw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":["Kawo wozani Godaa kushena;",{"text":"iya wozanaa dhawa haathada","poem":2},{"lineBreak":true},{"text":"ba koyida soo zaarees.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Asi oothiyaba ubbay iyaw like daanees;","poem":1},{"text":"shin Goday iya wozanaa qofaa paacees.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yarsho yarshanaape aathidi,","poem":1},{"text":"xillonne suure ootheysa Goday dosees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iitati otoroninne ceeqetethan eretoosona;","poem":1},{"text":"hessi qassi nagara.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mino oothiya asa halchoy dureyees;","poem":1},{"text":"shin eesotiya ubbay manqees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wordon dagayida shaloy pentoda dhayees;","poem":1},{"text":"hessa koyeysati hayqo koyoosona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iitati suureba oothanaw koyonna gisho,","poem":1},{"text":"enta geella oosoy enta ekidi bees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nagaranchoti geella ogen hemetoosona;","poem":1},{"text":"shin geeshshati suureba oothosona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Doonatiya machira issi keethan daanape","poem":1},{"text":"kare darmachan duussi lo77o.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iitati iitaba oothanaw amottoosona;","poem":1},{"text":"banta shoorotas qadhetokona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Qelqisiya asi seeretiya wode","poem":1},{"text":"wozani bayna uray cincatethi tamaarees;","poem":2},{"lineBreak":true},{"text":"wozanaama uray era demmees.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xillo Xoossay iitata son oosetiyaba ubbaa be7ees;","poem":1},{"text":"enta shiri yeggidi dhaysees.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Manqota waasuwa si7anaape gidi,","poem":1},{"text":"ba haythaa tucciya uray, ika waassana;","poem":2},{"lineBreak":true},{"text":"I waassin alliya asi dhayana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Geeman immiya imoy hanqo doshisees;","poem":1},{"text":"qosan immida wodhaafey hanqo irxisees.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Suure pirdi pirdetiya wode,","poem":1},{"text":"xilloti ufaytoosona;","poem":2},{"lineBreak":true},{"text":"shin iita ootheyisata daganthees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Akeeka ogiya haakiya uraa","poem":1},{"text":"hayqoy naagees.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Injetin daana giya uray manqees;","poem":1},{"text":"woynenne zayte dosiya uray duretenna.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Xoossa asata ashshanaw iita asati seeretosona;","poem":1},{"text":"ammanetona asati suure asata gisho seeretosona.","poem":2}]},{"type":"verse","number":19,"content":["Doonatiyanne yilotiya machira daanape",{"text":"bazzon de7oy lo77o.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wozanaama uraa son mal7o quminne oysi minjettees;","poem":1},{"text":"shin eeya asi de7iyaba ubbaa midigees.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Xillotethinne siiqo koyiya uraa laythay aduqees;","poem":1},{"text":"he uray xillotethinne boncho demmees.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Wozanaama asi wolqaama olanchota katamaa olidi oykees;","poem":1},{"text":"enti ammanetiya mino miixaa laallees.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ba doonanne ba inxarsaa","poem":1},{"text":"naagiya asi bana metope naagees.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Otoreynne ceeqetey qelqisiya asi;","poem":1},{"text":"I otorancho gidida gisho asas qopenna.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Oothanaw koyonna gisho","poem":1},{"text":"azalla amoy wodhees.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Azalla asi ubba wode darobaa demmanaw amottees;","poem":1},{"text":"shin xilloy baw ashshona immees.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Goday iitata yarshuwa ixees;","poem":1},{"text":"enti iyaw iita qofan shiishiya yarshuwa aathidi ixees.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Wordo marki dhayana;","poem":1},{"text":"shin tuma marki eqidi daana.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Iita asi bessona xaala xaalees;","poem":1},{"text":"shin suure asi yuushshi qopees.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Asi ba cincatethan, akeekaninne zoren","poem":1},{"text":"Godaara eqetanaw danda7enna.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Olas para kooranaw danda7etees;","poem":1},{"text":"shin xoonoy Godaaba.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PRO/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PRO/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PRO/20.json","previousChapterAudioLinks":{},"numberOfVerses":31}