{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_ltw","name":"Leemiso Maxaafa","commonName":"Leemiso Maxaafa","title":"Leemiso Maxaafa","order":20,"numberOfChapters":31,"sha256":"95d70e6d82da62b90de57969d9cb4fede4fc023eb08e912eaff45805545a5370","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_ltw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":["Lo77o sunthi daro duretethafe aadhees;",{"text":"bonchoy birapenne worqafe aadhees.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Durenne manqo Goday medhis;","poem":1},{"text":"hessan enti nam7ay issino.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Cinca asi iita be7idi qosetidi attees;","poem":1},{"text":"shin akeeki bayna asi meton gelidi qohetees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ashketethinne Godaa yashshi,","poem":1},{"text":"duretethi, bonchonne de7o immees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iitata ogen agunthinne xihey de7ees;","poem":1},{"text":"shin bana naagiya asi entafe haakees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Na7i waanidi daanaw bessiyako tamaarsa;","poem":1},{"text":"I cimiya wodeka iyape haakenna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Durey manquwa haarees;","poem":1},{"text":"tal7e ekiday tal7e immidaysas aylle gidees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nagara zeriya uray waaye cakees;","poem":1},{"text":"iya hanqo xam7ay meqana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ba kathaa manqotas shaakiya gisho","poem":1},{"text":"keeha asi anjetana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Qelqisiya asi diggiko,","poem":1},{"text":"palami, ooshshinne cashshi attana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wozani geeshshi gidida asinne","poem":1},{"text":"lo77o oda dosiya asi kawora dabbotees.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Godaa ayfey eratethi naagees;","poem":1},{"text":"shin wordanchota qaala shiri yeggees.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Azalla asi, “Karen gaammoy de7ees;","poem":1},{"text":"tana ogen maana” yaagees.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Layma maccasa dooni wolqaama olla mela;","poem":1},{"text":"Goday hanqetidaysati iyan kundoosona.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Eeyatethi na7a wozanan de7ees;","poem":1},{"text":"shin pircoy iyape haassees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Shalo shiishanaw manquwa naaqeynne","poem":1},{"text":"dure asas imota immiya nam7ay manqana.","poem":2}]},{"type":"heading","content":["Hastamu Cinca Zoreta"]},{"type":"verse","number":17,"content":["Ne haytha zaarada cincata qaala si7a;",{"text":"ne wozanaa ta timirtiyako zaara.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Enta ne wozanan wothikonne","poem":1},{"text":"ne doonan enta haasayiko, ne ufaytana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ne ammanoy Godan gidana mela,","poem":1},{"text":"taani nena hachi tamaarsayis.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Taani new zorenne eratethi kumida","poem":1},{"text":"hastamu leemisota xaafas.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nena kiittidaysas like zaaro zaarana mela,","poem":1},{"text":"taani nena tumatethi tamaarsas.","poem":2}]},{"type":"heading","content":["1"]},{"type":"verse","number":22,"content":[{"text":"Manqotas aybika bayna gisho, enta bonqofa;","poem":1},{"text":"pirdan enta maata dhaysofa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Goday enta gisho mootetana;","poem":1},{"text":"enta bonqidaysata I bonqana.","poem":2}]},{"type":"heading","content":["2"]},{"type":"verse","number":24,"content":[{"text":"Yilotiya uraara laggetopa;","poem":1},{"text":"elle shenetiya uraara hemetofa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Neeni iya yiluwara meezetiko,","poem":1},{"text":"guyepe agganaw danda7aka.","poem":2}]},{"type":"heading","content":["3"]},{"type":"verse","number":26,"content":[{"text":"Asa aco ta qanxana gada","poem":1},{"text":"waase gidopa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ne qanxiyaba dhayiko,","poem":1},{"text":"ne zin7iya hiixay attonna,","poem":2},{"lineBreak":true},{"text":"new de7iyaba ubbay eketana.","poem":2}]},{"type":"heading","content":["4"]},{"type":"verse","number":28,"content":[{"text":"Ne mayzati tokida","poem":1},{"text":"beni zawa shoddofa.","poem":2}]},{"type":"heading","content":["5"]},{"type":"verse","number":29,"content":[{"text":"Ba oosuwan loohida asi be7adii?","poem":1},{"text":"I coo asatas gidonashin kawotas oothees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PRO/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PRO/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PRO/21.json","previousChapterAudioLinks":{},"numberOfVerses":29}