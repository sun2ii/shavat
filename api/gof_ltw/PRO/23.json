{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_ltw","name":"Leemiso Maxaafa","commonName":"Leemiso Maxaafa","title":"Leemiso Maxaafa","order":20,"numberOfChapters":31,"sha256":"95d70e6d82da62b90de57969d9cb4fede4fc023eb08e912eaff45805545a5370","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_ltw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":23,"content":[{"type":"heading","content":["6"]},{"type":"verse","number":1,"content":["Halaqara kathi maanaw uttiya wode,",{"text":"neera de7eysa akeeka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Neeni daro yaramba asi gidiko naageta.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I nena paacanaw danda7iya gisho,","poem":1},{"text":"mal7o kathas yaaretopa.","poem":2}]},{"type":"heading","content":["7"]},{"type":"verse","number":4,"content":[{"text":"Duretana gada daaburopa;","poem":1},{"text":"ne qofaa haaranaw cinca gida.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hessa mela duretethi ne xeellishin dhayana;","poem":1},{"text":"qefe kessidi arganthada salo paallana.","poem":2}]},{"type":"heading","content":["8"]},{"type":"verse","number":6,"content":[{"text":"Uuze asa kathi moopa;","poem":1},{"text":"iya mal7o kathay nena amoyopo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Qoodhepe qommon “Ma; uya” gees;","poem":1},{"text":"shin iya wozanay neera gidenna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne mida guutha kathaaka cooyana;","poem":1},{"text":"ne galatay mela gidana.","poem":2}]},{"type":"heading","content":["9"]},{"type":"verse","number":9,"content":[{"text":"Ne cincatetha haasaya kadhiya gisho,","poem":1},{"text":"eeya asas paxaba haasayopa.","poem":2}]},{"type":"heading","content":["10"]},{"type":"verse","number":10,"content":[{"text":"Beni zawa shoddofa;","poem":1},{"text":"yi7o nayta zawa sugopa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Enta ashshiya Goday mino gidiya gisho;","poem":1},{"text":"i, enta gisho neera mootetana.","poem":2}]},{"type":"heading","content":["11"]},{"type":"verse","number":12,"content":[{"text":"Ne wozanaa zore qaalako,","poem":1},{"text":"ne haytha timirteko zaara.","poem":2}]},{"type":"heading","content":["12"]},{"type":"verse","number":13,"content":[{"text":"Na7a seeronna aggofa;","poem":1},{"text":"ne iya pircon shociko I hayqenna.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ne iya pircon shociko,","poem":1},{"text":"iya shempuwa hayqope ashshaasa.","poem":2}]},{"type":"heading","content":["13"]},{"type":"verse","number":15,"content":[{"text":"Ta na7aw, ne wozanay cinca gidiko,","poem":1},{"text":"ta wozanay ufaytana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ne inxarsay suureba haasaya wode,","poem":1},{"text":"ta gaatha asatethay ufaytees.","poem":2}]},{"type":"heading","content":["14"]},{"type":"verse","number":17,"content":[{"text":"Nagaranchota qanaatopa;","poem":1},{"text":"shin ubba wode Godaa yayya.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yaatiko new sintha de7oy suurana;","poem":1},{"text":"ne ufaysay dhayenna.","poem":2}]},{"type":"heading","content":["15"]},{"type":"verse","number":19,"content":[{"text":"Ta na7aw, si7a; cinca gida;","poem":1},{"text":"ne wozanaa suure ogiyan naaga.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Daro woyne ushshu uyeysataranne","poem":1},{"text":"asho maanaw yaareteysatara hemetofa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mathoteysatinne yarambati manqana;","poem":1},{"text":"dhisko daroy curqa mayzees.","poem":2}]},{"type":"heading","content":["16"]},{"type":"verse","number":22,"content":[{"text":"Nena yelida ne aaway odiyaba si7a;","poem":1},{"text":"ne aayiya cimida wode kadhopa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Tumaa, cinca, seeranne","poem":1},{"text":"akeeka shammafe attishin, bayzopa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Xillo na7a aawi daro ufaytees;","poem":1},{"text":"wozanaama na7a yelida asi iyan ceeqetees.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ne aawaynne ne aayiya nenan ufayto;","poem":1},{"text":"nena yelidaara hashshu go.","poem":2}]},{"type":"heading","content":["17"]},{"type":"verse","number":26,"content":[{"text":"Ta na7aw, ne wozanaa taw imma;","poem":1},{"text":"ne ayfeti ta ogiya kallo.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Layma maccasi ciimmo haatha mela;","poem":1},{"text":"laggetho maccasi xuntha olla mela.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Iya paannoda zugada naagawusu;","poem":1},{"text":"ammanetona addeta darsawusu.","poem":2}]},{"type":"heading","content":["18"]},{"type":"verse","number":29,"content":[{"text":"Waasoy oossee? Azzanoy oossee?","poem":1},{"text":"Ooshshi oossee? Zuuzunthi oossee?","poem":2},{"text":"Gaasoy bayna madunxethi oossee?","poem":1},{"text":"Ayfe zo7oy oossee?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Woyne ushshu uyishe wode ongeysatasa gidennee?","poem":1},{"text":"Walahetida woyne ushsha","poem":2},{"lineBreak":true},{"text":"ganxidi be7eysatasa gidennee?","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Woyne ushshi zo7ida wode,","poem":1},{"text":"iya malay birille giddon phooliya wode,","poem":2},{"lineBreak":true},{"text":"uyin mal7ishe geliya wode iya xeellofa.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Wursethan shooshada I dukees;","poem":1},{"text":"iita shooshada ba marziya puukees.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ne ayfey be7i eronnabaa be7ana;","poem":1},{"text":"ne wozanay suure qopanaw danda7enna.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Neeni abba giddon zin7ida,","poem":1},{"text":"markabiya tuussa bolla katida ase daanasa.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Neeni, “Enti tana dechidosona;","poem":1},{"text":"shin ta qohetabike.","poem":2},{"text":"Enti tana wadhidosona;","poem":1},{"text":"shin taw eretibeenna.","poem":2},{"text":"Hara ushshu uyanaw","poem":1},{"text":"taani awude dendanee?” yaagana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":35}