{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_ltw","name":"Leemiso Maxaafa","commonName":"Leemiso Maxaafa","title":"Leemiso Maxaafa","order":20,"numberOfChapters":31,"sha256":"95d70e6d82da62b90de57969d9cb4fede4fc023eb08e912eaff45805545a5370","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_ltw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":24,"content":[{"type":"heading","content":["19"]},{"type":"verse","number":1,"content":[{"text":"Ta na7aw, iita asata qanaatopa;","poem":1},{"text":"entara laggetanaw amottofa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Enti ubba wode iitabaa maqetoosona;","poem":1},{"text":"banta inxarsan gene haasayoosona.","poem":2}]},{"type":"heading","content":["20"]},{"type":"verse","number":3,"content":[{"text":"Keethi cincatethan keexetees;","poem":1},{"text":"akeekan minnees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Eri de7iko, qol7i","poem":1},{"text":"al7obaaninne lo77oban kumees.","poem":2}]},{"type":"heading","content":["21"]},{"type":"verse","number":5,"content":[{"text":"Cinca asi wolqaama asape aadhees;","poem":1},{"text":"era asi mino asape lo77o.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Olas keyanaape koyro halchanaw koshshees;","poem":1},{"text":"daro zore zoriya asatan xoonoy bentees.","poem":2}]},{"type":"heading","content":["22"]},{"type":"verse","number":7,"content":[{"text":"Eeya asi cincatethi akeekanaw danda7enna;","poem":1},{"text":"shiiqo bessan I odiyabay aybika baawa.","poem":2}]},{"type":"heading","content":["23"]},{"type":"verse","number":8,"content":[{"text":"Iita oothanaw qopiya asi","poem":1},{"text":"gene asi geetetees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Eeya asa qofi nagara;","poem":1},{"text":"qelqisiya asi ixetees.","poem":2}]},{"type":"heading","content":["24"]},{"type":"verse","number":10,"content":[{"text":"Meto wode ne dol7iko,","poem":1},{"text":"ne wolqay guutha.","poem":2}]},{"type":"heading","content":["25"]},{"type":"verse","number":11,"content":[{"text":"Pirdi bayna hayqos beyisata ashsha;","poem":1},{"text":"shukettanaw biya wode si77i gada xeellofa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne, “Ta hessa erike” giiko,","poem":1},{"text":"wozana eriya i, be7ennee?","poem":2},{"text":"Ne de7uwa naageysi erennee?","poem":1},{"text":"Asa ubbaas iya oosuwada oosuwada zaarennee?","poem":2}]},{"type":"heading","content":["26"]},{"type":"verse","number":13,"content":[{"text":"Ta na7aw, eessi lo77o gidiya gisho,","poem":1},{"text":"eessi ma; ililo eessi mal7ees.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Cincatethika hessada","poem":1},{"text":"ne shempuwas mal7o gideysa era.","poem":2},{"text":"Neeni iya demmiyaba gidiko,","poem":1},{"text":"sinthara yaana keehay nebaa;","poem":2},{"lineBreak":true},{"text":"ne ufaysay dhayenna.","poem":2}]},{"type":"heading","content":["27"]},{"type":"verse","number":15,"content":["Xillo asa keethi bonqanaw naagopa;",{"text":"iya aquwa dhaysanaw dendofa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Xillo asi laapun toho kundikoka dendees;","poem":1},{"text":"shin iitati gadon dhayana.","poem":2}]},{"type":"heading","content":["28"]},{"type":"verse","number":17,"content":[{"text":"Ne morkey kundiya wode ufaytofa;","poem":1},{"text":"I dhubetiya wode hashshu goopa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Goday hessa be7idi ufaytenna;","poem":1},{"text":"iya hanqetonna aggaagana.","poem":2}]},{"type":"heading","content":["29"]},{"type":"verse","number":19,"content":[{"text":"Iita ootheyisata gaason hirgofa;","poem":1},{"text":"enta mela gidarkina gada qopofa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Iita asas sinthara yaana keehi baawa;","poem":1},{"text":"iitata xompey to7ana.","poem":2}]},{"type":"heading","content":["30"]},{"type":"verse","number":21,"content":[{"text":"Ta na7aw, Godaanne kawa yayya;","poem":1},{"text":"enta bolla makalleysatara hemetofa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hessa mela asata qoponna metoy gakees;","poem":1},{"text":"kawuwapenne Godaape yaana meto oone erey?","poem":2}]},{"type":"heading","content":["Hara Cinca Zoreta"]},{"type":"verse","number":23,"content":["Cincati gujidi haysada yaagidosona;",{"text":"Som7o be7idi pirdoy lo77o gidenna.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Qohidaysa lo77o oothadasa","poem":1},{"text":"giya daynna, asi baaddana;","poem":2},{"lineBreak":true},{"text":"kawotethati iya ixana.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Qohidaysa ne bala","poem":1},{"text":"giya daynnati lo77oba ekana","poem":2},{"lineBreak":true},{"text":"daro anjo demmana.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Tuma zaaro zaariya asi,","poem":1},{"text":"tuma lagge mela.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kasetada ne gadiya goya; kathi zera;","poem":1},{"text":"hessafe guye, ne keethaa keexa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ne shooruwa bolla gaasoy bayna markatofa;","poem":1},{"text":"ne doonan cimmofa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"“I taw oothidaysada ta iyaw oothana;","poem":1},{"text":"ta iyaw kushe zaarana” yaagopa.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Taani booza asa goshshara aadhas;","poem":1},{"text":"azalla addiya woyne gadera kanthas.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Agunthinne sharaafi goozi wothis;","poem":1},{"text":"yuushon de7iya dirsayka laaletis.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Taani iya be7ida wode qopas;","poem":1},{"text":"iyape timirte ekas.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Neeni guuthu liipha; guuthu dhiska;","poem":1},{"text":"ne kushiya shiishada guuthu shempa.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Shin manqotethi paannoda yaana;","poem":1},{"text":"duussa waayey ola miishe oykida asada puttu gaana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}