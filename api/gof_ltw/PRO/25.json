{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_ltw","name":"Leemiso Maxaafa","commonName":"Leemiso Maxaafa","title":"Leemiso Maxaafa","order":20,"numberOfChapters":31,"sha256":"95d70e6d82da62b90de57969d9cb4fede4fc023eb08e912eaff45805545a5370","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_ltw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":25,"content":[{"type":"heading","content":["Hara Solomone Leemisota"]},{"type":"verse","number":1,"content":["Haysati Yihuda kawa Hizqiyaasa asati duuqidi xaafida Solomone leemisota."]},{"type":"verse","number":2,"content":[{"text":"Xuura genthoy Xoossas boncho;","poem":1},{"text":"xuura pilgidi kesoy kawotas boncho.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Saloy dhoqu gidaysadanne","poem":1},{"text":"sa7i ziqa gididaysada","poem":2},{"lineBreak":true},{"text":"kawota qofaa asi eranaw danda7enna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Birape qita digga;","poem":1},{"text":"hessafe guye, hiillanchoy loythana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kawo sinthafe iita asata digga;","poem":1},{"text":"iya araatay xillotethan minnidi eqana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kawo sinthan eqiya wode ceeqetofa;","poem":1},{"text":"gita asata giddon new besse koyopa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Neepe gitatiya asas besse immanaw","poem":1},{"text":"halaqay nena denthin, kawuyeysafe,","poem":2},{"lineBreak":true},{"text":"I nena, “Ha dhoqa bessan utta” geysi lo77o.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne ayfen be7idaba markatanaw","poem":1},{"text":"daynna sinthe baanaw ellesopa.","poem":2},{"text":"Ne markata simmin hara asi","poem":1},{"text":"ne markatethay bala gideysa qoncisiko, ne yeellatana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ne giddoninne ne shooruwa giddon palami medhetiko,","poem":1},{"text":"iyara odetada ne palama wursa;","poem":2},{"lineBreak":true},{"text":"hara asa xuura qoncisopa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hessi hanonna ixiko ne odeysa si7ida asi","poem":1},{"text":"nena kawushana;","poem":2},{"lineBreak":true},{"text":"ne sunthay zaaridi simmonnaada iitana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bessiya wode odetida like qaali,","poem":1},{"text":"bira miishe bolla tigetida worqa alleeqo mela.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Era asi zoriya zore si7iya haythas,","poem":1},{"text":"hessi worqafe woyko geeshsha worqafe","poem":2},{"lineBreak":true},{"text":"oosetida alleeqo mela.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Katha cakiya wode irxa haathi uyin aleysada,","poem":1},{"text":"ammanthiya kiitanchoy bana kiittoysa ufaysees.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Immonnaba immana gidi ceeqetiya asi","poem":1},{"text":"iri bayna shaaranne carko mela.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Danda7a asi halaqa odidi mayzees;","poem":1},{"text":"liiqo qaali meqethi kanthi gelees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Eessi demmiko kallana gakanaw ma;","poem":1},{"text":"shin darsiko nena cooshshana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nena uufishe ixonnaada,","poem":1},{"text":"ne shooruwa soo ubba wode boopa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ba shooruwa bolla wordon markatiya asi,","poem":1},{"text":"xam7i, mashshinne toori qoheysada qohees.","poem":2}]},{"type":"verse","number":19,"content":["Meto wode ammanetona asan zempoy,",{"text":"qaaxiya achan coommiyanne","poem":2},{"lineBreak":true},{"text":"silida tohon hemeteysa mela.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Azzanida asas yethi yexiya asi,","poem":1},{"text":"meego wode ma7o qaariyanne","poem":2},{"lineBreak":true},{"text":"maduntha bolla caalaba tigiya asa mela.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ne morkey koshatiko muza;","poem":1},{"text":"saamotiko ushsha.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ne hessa oothiko iya huuphen tama bonqo","poem":1},{"text":"kaashidi qoleysa mela;","poem":2},{"lineBreak":true},{"text":"Goday nena woytana.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Doloha bagga carkoy ira eheysada,","poem":1},{"text":"zigirsi hanqo ehees.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Doonatiya machira issi keethan daanape","poem":1},{"text":"kare barandan duussi lo77o.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Daaburida asi irxa haathi uyidi aleysada,","poem":1},{"text":"haaho biittafe yaa lo77o odi ufaysees.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Iita asa sinthan gulbatiya xillo asi,","poem":1},{"text":"buullotida pultonne iitida olla haatha mela.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Daro eessi muussi lo77o gidenna;","poem":1},{"text":"hessadaka, ba boncho koshshi bonchisenna.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Bana haaronna asi","poem":1},{"text":"dirsi laaletida katama mela.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PRO/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PRO/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PRO/24.json","previousChapterAudioLinks":{},"numberOfVerses":28}