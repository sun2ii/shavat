{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_ltw","name":"Leemiso Maxaafa","commonName":"Leemiso Maxaafa","title":"Leemiso Maxaafa","order":20,"numberOfChapters":31,"sha256":"95d70e6d82da62b90de57969d9cb4fede4fc023eb08e912eaff45805545a5370","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_ltw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":["Bone shachi, kathi cakiya wode iri koshshonaysada,",{"text":"eeyas boncho koshshenna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kafoti yaanne haanne piradhishe ase qohonnaysada,","poem":1},{"text":"gaasoy bayna baaddiya baadethi ase gakenna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Paras lisso, hares bixaala koshsheysada","poem":1},{"text":"eeya zokos xam7a koshshees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Eeya asas iya eeyatethaada zaaropa;","poem":1},{"text":"zaariko ne iya mela gidana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Eeya asas iya eeyatetha qoncisada zaara;","poem":1},{"text":"hessi hanonna ixiko I bana cinca gidi qopana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eeya asa bolla kiita yedoy,","poem":1},{"text":"ba toho qanxi yeggeysa mela","poem":2},{"lineBreak":true},{"text":"woyko wodhiyaba uyeysa mela.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Eeya asa leemisoy,","poem":1},{"text":"silida toho mela maaddenna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Eeya asas boncho imoy,","poem":1},{"text":"shuchu yambarshan qachi wothidi","poem":2},{"lineBreak":true},{"text":"yambaranaw paaciya asa mela.","poem":2}]},{"type":"verse","number":9,"content":["Eeya asa leemisoy",{"text":"mathotida asi ba kushe caddida agunthu","poem":2},{"lineBreak":true},{"text":"kessanaw baaxeteysa mela.","poem":2}]},{"type":"verse","number":10,"content":["Eeya asa woyko ba oge biya asi",{"text":"une oosisanaw qaxariya asi","poem":2},{"lineBreak":true},{"text":"ba toora shaaran xongiya asa mela.","poem":2}]},{"type":"verse","number":11,"content":["Kani ba cooshshako guye simmidi laaceysada,",{"text":"eeya asi ba eeyatetha zaari zaari qoncisees.","poem":2}]},{"type":"verse","number":12,"content":["Bana cinca oothidi xeelliya asape",{"text":"eeya asas lo77o qaadi de7ees.","poem":2}]},{"type":"verse","number":13,"content":["“Azalla asi ogen gaammoy de7ees;",{"text":"yashshiya gaammoy ogen yuuyees” yaagees.","poem":2}]},{"type":"verse","number":14,"content":["Sanqi maxaafe bolla yaanne haanne qaaxeysada,",{"text":"azalla asi ba hiixan yaanne haanne shiretees.","poem":2}]},{"type":"verse","number":15,"content":["Issi issi azalla asi hari attoshin,",{"text":"woxen tushidi baaranaw waayetees.","poem":2}]},{"type":"verse","number":16,"content":["Azalla asi markara odiya laapun cincatape",{"text":"bana aadhida cinca gidi qopees.","poem":2}]},{"type":"verse","number":17,"content":["Bana gathiyabay baynaban palamiya asi",{"text":"ogera biya kana haythi oykiya asa mela.","poem":2}]},{"type":"verse","number":18,"content":["Ba shooruwa, “Taani kaasse gayis”",{"text":"yaagidi cimmiya asi,","poem":2},{"lineBreak":true},{"text":"gooyidi bonqo tama holiya,","poem":2},{"lineBreak":true},{"text":"woyko wodhiya donge toora dukiya asa mela.","poem":2}]},{"type":"verse","number":20,"content":["Mithi wuriko tami to7ees;",{"text":"zigirsi dhayiko ooshshi attees.","poem":2}]},{"type":"verse","number":21,"content":["Xiifi bonqo darseysadanne",{"text":"mithi tama darseysada","poem":2},{"lineBreak":true},{"text":"palama darsiya asi ooshshu darsees.","poem":2}]},{"type":"verse","number":22,"content":["Zigirsa qaali mal7o katha mela",{"text":"ufaysishe duge ganje bees.","poem":2}]},{"type":"verse","number":23,"content":["Wozanan iitabay de7ishin,",{"text":"ba inxarsan cimo qaala haasaya asi","poem":2},{"lineBreak":true},{"text":"biran lanxetida urqa miishe mela.","poem":2}]},{"type":"verse","number":24,"content":["Gene asi ba wozanan de7iya iitatethaa",{"text":"ba inxarsan genthees.","poem":2}]},{"type":"verse","number":25,"content":["Iya wozanan laapun tunati kumida gisho,",{"text":"I lo77o qaala haasaykoka iya ammanopa.","poem":2}]},{"type":"verse","number":26,"content":["Ba morketetha I genthikoka,",{"text":"I oothiya iitay dabaaban qoncana.","poem":2}]},{"type":"verse","number":27,"content":["Haratas olla bookiya asi he ollan baw kundana;",{"text":"harata bolla shuchu gondorsiya asa bolla","poem":2},{"lineBreak":true},{"text":"he shuchay simmidi gondoretana.","poem":2}]},{"type":"verse","number":28,"content":["Wordotiya inxarsi ba qohida asata ixees;",{"text":"cimo odi kundethi kaalethees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PRO/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PRO/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PRO/25.json","previousChapterAudioLinks":{},"numberOfVerses":27}