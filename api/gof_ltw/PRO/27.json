{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_ltw","name":"Leemiso Maxaafa","commonName":"Leemiso Maxaafa","title":"Leemiso Maxaafa","order":20,"numberOfChapters":31,"sha256":"95d70e6d82da62b90de57969d9cb4fede4fc023eb08e912eaff45805545a5370","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_ltw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":["Wontoy ehanaba ne eronna gisho",{"text":"wontoban ceeqetofa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hara asi nena galatope attishin neeni nena galatopa;","poem":1},{"text":"asi ne gisho markatofe attishin, neeni ne keehatethabaa odopa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Shuchi gita tooho; shafey deexo;","poem":1},{"text":"shin eeya asi medhiya ooshshi","poem":2},{"lineBreak":true},{"text":"nam7aafeka deexees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hanqos qadhey baawa;","poem":1},{"text":"yiloy dhaysiya di7o mela;","poem":2},{"lineBreak":true},{"text":"shin qanaatey ubbaafe iita.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Geemmida siiqope","poem":1},{"text":"baliya wode qoncen hanqetethi lo77o.","poem":2}]},{"type":"verse","number":6,"content":["Morkey nena tammu toho yeeranaape",{"text":"siiqoy nena madunxiseysi lo77o.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kallida asi ililo eessi shaattees;","poem":1},{"text":"shin koshatida uraa cammiyabay mal7ees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ba soo aggidi yuuyiya asi,","poem":1},{"text":"ba keethaa aggada paalliya kafo mela.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Shittoynne sawiya ixaaney ase ufayseysada","poem":1},{"text":"siiqo lagge zorey hessada ufaysees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne laggetanne ne aawa laggeta aggofa;","poem":1},{"text":"ne metootida wode ne ishaa soo boopa;","poem":2},{"lineBreak":true},{"text":"haahon de7iya ishape matan de7iya shooroy lo77o.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ta na7aw, cinca gida; tana ufaysa;","poem":1},{"text":"tana kadhiya asaas ta zaaro immana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Cinca asi metoy yaa wode be7idi qosetees;","poem":1},{"text":"shin akeeki bayna asi bidi meton gelees;","poem":2},{"lineBreak":true},{"text":"yaatidi guyepe qiirotees.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Eronna asas waase geliya uraa ma7uwa qaari ekite;","poem":1},{"text":"imatha asas waase gelida uraa ma7uwa oykite.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wonta guura ba qaala dhoqu oothidi,","poem":1},{"text":"ba shooruwa sarotey iya baaddiya asa mela.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Doonatiya machanne","poem":1},{"text":"aathiya keethi issino.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Carko teqanaw, zayte kuucidi oykanaw danda7etonaysada,","poem":1},{"text":"iyo si77i oothanaw danda7etenna.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Birati birata posheysada,","poem":1},{"text":"asi issoy issuwafe tamaarees.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Balase mithi loythidi naagiya asi iya ayfe maana;","poem":1},{"text":"ba halaqaa kaaboya oosanchoy bonchetana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Haathi mastooteda som7o besseysada,","poem":1},{"text":"asa wozani iya oonatetha bessees.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hayqoynne Duufoy kalli eronnaysada,","poem":1},{"text":"asa ayfey kallidi erenna.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Birinne worqey taman paacetidi geeyeysada,","poem":1},{"text":"asi ba ekiya galatan paacetees.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kathi udulan caddeysada,","poem":1},{"text":"eeya asi udulan caddiyakoka","poem":2},{"lineBreak":true},{"text":"iyape eeyatethay kichenna.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ne dorsata hanota loythada era;","poem":1},{"text":"ne wudiyaka akeekada heemma.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ayis giiko, duretethi merinaw deenna;","poem":1},{"text":"kallachika yeletethafe yeletethaas aadhenna.","poem":2}]},{"type":"verse","number":25,"content":["Mela maatay buucetin, aaca maati keya wode,",{"text":"deriya bolla de7iya maatay shiiqidaape guye,","poem":2}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"dorsata ikisepe ne new ma7o kessana;","poem":2},{"lineBreak":true},{"text":"deeshata bayzada gade shammana.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Attida deeshata maathay new,","poem":1},{"text":"ne soo asaasinne ne macca aylletas kathi gidana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PRO/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PRO/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PRO/26.json","previousChapterAudioLinks":{},"numberOfVerses":27}