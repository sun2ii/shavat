{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_ltw","name":"Leemiso Maxaafa","commonName":"Leemiso Maxaafa","title":"Leemiso Maxaafa","order":20,"numberOfChapters":31,"sha256":"95d70e6d82da62b90de57969d9cb4fede4fc023eb08e912eaff45805545a5370","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_ltw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":["Daro wode seeretidi simmonna asi",{"text":"hassayonna meqana;","poem":2},{"lineBreak":true},{"text":"he uraas paxoy baawa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Xillo asati shuumetiya wode asay ufaytees;","poem":1},{"text":"shin iitati biitta haariya wode asay un7etees.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Cincatethi dosiya asi ba aawa ufaysees;","poem":1},{"text":"shin layma maccasa heeran yuuyiya asi ba miishiya wursees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tuma pirdan kawoy ba kawotethaa wopu oothees;","poem":1},{"text":"shin wodhaafe ekiya kawoy ba kawotethaa dhaysees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ba shooruwa cimon sabbiya asi,","poem":1},{"text":"ba tohos xihe yeggees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iita asi ba nagaran oyketees;","poem":1},{"text":"shin xillo asi ufaytees; yexees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Xillo asi manqotas suure pirdees;","poem":1},{"text":"shin iita asati hessa erokona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Cayiya asati kataman ooshshu denthoosona;","poem":1},{"text":"shin cinca asati hanqo irxisoosona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Cinca asi eeya asa pirda keethi efiko,","poem":1},{"text":"eeyay hanqetees; qidhees; iyaw saroy baawa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Suuthu gussanaw saamotiya asati suure asi ixoosona;","poem":1},{"text":"xillo asaa wodhanaw koyoosona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Eeya asi ba hanquwa yeddi bessees;","poem":1},{"text":"shin cinca asi bana haarees.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Shuumay wordo oda si7iyaba gidiko,","poem":1},{"text":"iya moorinnati ubbay iita gidoosona.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Manqoynne ase naaqiya asi issiba koxoosona;","poem":1},{"text":"enta nam7aas ayfe immiday Godaa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kawoy manqotas suure pirdiko,","poem":1},{"text":"I ba araatan gam7ana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Pircon seeri naytas cincatethi immees;","poem":1},{"text":"shin yedan diccida na7i ba aayiw kawushshees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Iita asati dariya wode nagari darees;","poem":1},{"text":"shin xilloti enta kundethaa be7ana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ne na7aa seera;","poem":1},{"text":"I new saro immana;","poem":2},{"lineBreak":true},{"text":"I nena ufaysana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Qoncethi bayna ixiko derey yeda gidees;","poem":1},{"text":"shin higge naagiya asi anjetidaysa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Aylley coo oda xalaalan seeretenna;","poem":1},{"text":"iyaw geliyakoka I kiitetenna.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Eeson haasaya asi be7a eray?","poem":1},{"text":"Iyape eeya asas ufaysi de7ees.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ne aylliya na7a yeda dichiko,","poem":1},{"text":"iya wursethay azzano gidana.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hanqetiya asi ooshshu denthethees;","poem":1},{"text":"elle yilotiya asi daro nagara oothees.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Otoroy ase kawushshees;","poem":1},{"text":"shin ashke ayyaani de7iya asi bonchetees.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kaysora laggetiya asi bana ixiya asi;","poem":1},{"text":"I dabaaban tuma odiko seeretees;","poem":2},{"lineBreak":true},{"text":"I tumaa odonna ixiko Godan baadetana.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Asas yashshi he uraas xihe gidees;","poem":1},{"text":"shin Godan ammanetiya asi saro de7ees.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Daroti maati de7iya asape made koyoosona;","poem":1},{"text":"shin suure pirdi Godaape bentees.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Xilloti nagaranchota shaatettoosona;","poem":1},{"text":"iitati suure asaa ixoosona.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PRO/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PRO/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PRO/28.json","previousChapterAudioLinks":{},"numberOfVerses":27}