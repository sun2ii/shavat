{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_ltw","name":"Leemiso Maxaafa","commonName":"Leemiso Maxaafa","title":"Leemiso Maxaafa","order":20,"numberOfChapters":31,"sha256":"95d70e6d82da62b90de57969d9cb4fede4fc023eb08e912eaff45805545a5370","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_ltw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":3,"content":[{"type":"heading","content":["Godan Ammaneta"]},{"type":"verse","number":1,"content":[{"text":"Ta na7aw, ta timirtiya dogopa;","poem":1},{"text":"ta kiitaa ne wozanan wotha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Enti ne laytha adussana;","poem":1},{"text":"injenne sarotethi new gujana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Siiqoynne tumatethi neepe haakofo;","poem":1},{"text":"enta ne qoodhen qacha; ne wozanan xaafa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hessa oothiko ne Xoossanne asa sinthan","poem":1},{"text":"sabetananne nashetana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne kumetha wozanan Godaa ammaneta;","poem":1},{"text":"ne akeekan zempofa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne ooso ubban iya sinthaya;","poem":1},{"text":"I nena suure oge kaalethana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nena ne huuphen cinca oothofa;","poem":1},{"text":"Godaa yayya; iitape haaka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hessi ne asatethaas payyatethi ehana;","poem":1},{"text":"ne meqethaaka xaalisana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ne shaluwan Godaa boncha;","poem":1},{"text":"koyro ayfida kathaafe","poem":2},{"lineBreak":true},{"text":"bayraa immada iya boncha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hessa ne oothiko, ne shaaliyan kathi kumana;","poem":1},{"text":"ne daalloy woyne ushshan kumidi palahana.","poem":2}]},{"type":"verse","number":11,"content":["Ta na7aw, Godaa seera kadhopa;",{"text":"I nena seeriya wode lancofa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Aaway ba dosiya na7a seereysada,","poem":1},{"text":"Goday ba dosiya uraa seerees.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Cincatethi demmeynne,","poem":1},{"text":"akeeka baw miishe oothiya uray anjetidaysa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Cincatethi birape aadhidi go77ees;","poem":1},{"text":"worqafe aadhidi maaddees.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Cincatethi worqafe aadhidi al7o;","poem":1},{"text":"ne demmanaw amotiya ubbay cincatethara ginenna.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Cincatethi ushacha kushen adussa laythi,","poem":1},{"text":"haddirsa kushen duretethinne boncho oykasu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"I ogeti ufaysiya ogeta;","poem":1},{"text":"I horogay saro horoga.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Iya bana oykeysatas de7o mithi;","poem":1},{"text":"iyo minthidi oykiya ubbay anjetidaysata.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Goday ba cincatethan sa7aa medhis;","poem":1},{"text":"ba akeekan salota minthis.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Iya eratethan shaafati goggoosona;","poem":1},{"text":"shaaratape iri bukees.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ta na7aw, suure pirdanne","poem":1},{"text":"shaakidi ero minthada oyka","poem":2},{"lineBreak":true},{"text":"enti neepe shaaketofo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Enti new de7o gidana;","poem":1},{"text":"injenne ufaysi immana.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"He wode ne hirgi bayna hemetana;","poem":1},{"text":"ne tohoy dhubetenna.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Neeni zin7iya wode yayyaka;","poem":1},{"text":"qamma kumethi mal7o dhisko dhiskana.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Akeekona gakiya gados yayyaka;","poem":1},{"text":"iitati dhayiya dhayuwan dagammaka.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Goday new zempo gidana;","poem":1},{"text":"ne tohoy xihen oyketonnaada I naagana.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"New wolqi de7ishin,","poem":1},{"text":"metootida uraas lo77oba ooso aggofa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ha77i maaddanaw danda7ashe ne shooruwa,","poem":1},{"text":"“Simmada ya; ta new wonto immana” yaagopa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Nena ammanetidi, ne matan de7iya,","poem":2},{"lineBreak":true},{"text":"ne shooruwa bolla gene oothofa.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Nena qohonna de7ishin,","poem":1},{"text":"ase coo mootopa.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Gene oothiya asata qanaatopa;","poem":1},{"text":"enta iita oosuwa kaallofa.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Goday iita oothiya asata ixees;","poem":1},{"text":"shin suureta dosees.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Goday iita oothiya asaa keethaa baaddees;","poem":1},{"text":"shin suureba oothiya asaa keethaa anjees.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Otoron qelqiseyisata Goday qelqisees;","poem":1},{"text":"shin bantana kawusheyisata sabbees.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Cincati boncho demmana;","poem":1},{"text":"shin eeyati kawuyana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}