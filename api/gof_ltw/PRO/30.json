{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_ltw","name":"Leemiso Maxaafa","commonName":"Leemiso Maxaafa","title":"Leemiso Maxaafa","order":20,"numberOfChapters":31,"sha256":"95d70e6d82da62b90de57969d9cb4fede4fc023eb08e912eaff45805545a5370","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_ltw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":30,"content":[{"type":"heading","content":["Agura Leemisota"]},{"type":"verse","number":1,"content":["Yaaqe na7aa Agura leemisoti haysafe kaallidi xaafetidaysata. Aguri Iti7eelasinne Ukaalas haysa haasayis."]},{"type":"verse","number":2,"content":["Taani asa ubbaafe aadhida eeya;",{"text":"asas de7iya akeeki taw deenna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taani cincatethi tamaarabike;","poem":1},{"text":"Geeshsha Xoossabaaka erike.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Salo pude keyidi duge wodhiday oonee?","poem":1},{"text":"Carko ba kushen oykiday,","poem":2},{"lineBreak":true},{"text":"haathe ba afilan yiiciday,","poem":2},{"lineBreak":true},{"text":"sa7aa gaxaa minthidi essiday oonee?","poem":2},{"text":"Iya sunthay oonee?","poem":1},{"text":"Iya na7aa sunthay oonee?","poem":2},{"lineBreak":true},{"text":"Iya eriya gidiko ane taw oda?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xoossa qaalan borey baawa; ubbay tuma","poem":1},{"text":"iyan ammanetiya ubbaas I gondalle.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iya qaala bolla aybaka gujofa;","poem":1},{"text":"gujiko I nena seerana;","poem":2},{"lineBreak":true},{"text":"ne wordancho gideysa I qoncisana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Godaw, ta nena nam7ubba oychayis;","poem":1},{"text":"ta hayqana gakanaw enta tana diggofa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ta ase cimmonna melanne wordo haasayonna mela tana naaga;","poem":1},{"text":"taw koshshiya kathi immafe attishin, tana dure woyko manqo oothofa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dure gidada, “Goday oonee?” gada nena kaddana;","poem":1},{"text":"manqo gidada, kaysada ta Xoossaa sunthaa cayisana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nena baaddonna melanne","poem":1},{"text":"iya baadethay new gome gidonna mela,","poem":2},{"lineBreak":true},{"text":"aylliya iya godaara zigropa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ba aawa baaddiyanne ba aayiw anjona yeletethi de7ees.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Daro tuna gidi uttidi","poem":1},{"text":"bantana geeshshi oothiya asati de7oosona.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Otoron kumida asatinne","poem":1},{"text":"ase kadhidi xeelliya asati de7oosona.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Enta achay mashshe gidin,","poem":1},{"text":"enta gaccoy toora gidin,","poem":2},{"lineBreak":true},{"text":"manqotanne metootanchota naaqidi,","poem":2},{"lineBreak":true},{"text":"entaba bonqiya asati de7oosona.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ullathas nam7u macca nayti de7oosona;","poem":1},{"text":"enti, “Hamma! Hamma!” yaagidi waassoosona.","poem":2},{"text":"Kallidi eronna heedzubati de7oosona;","poem":1},{"text":"oyddanthoy qassi “Gidana” gidi erenna.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hessati,","poem":1},{"text":"duufo,","poem":2},{"lineBreak":true},{"text":"maynnida maccas,","poem":2},{"lineBreak":true},{"text":"haathe kallidi eronna mela biittanne,","poem":2},{"lineBreak":true},{"text":"“Gidana!” gidi eronna tama.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ba aawa leqiya na7aa ayfiya,","poem":1},{"text":"ba aayiya cimin kadhiya na7aa ayfiya,","poem":2},{"lineBreak":true},{"text":"zangaaran de7iya quuroti woocana;","poem":2},{"lineBreak":true},{"text":"iya ashuwa ankoti maana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tana heedzubati malaalsoosona;","poem":1},{"text":"oyddanthoy ubba taw gelenna.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hessati,","poem":1},{"text":"salora paalliya arganthi,","poem":2},{"lineBreak":true},{"text":"zaalla bollara kolxiya shooshi","poem":2},{"lineBreak":true},{"text":"abba bollara biya markabenne","poem":2},{"lineBreak":true},{"text":"geela7ora shiiqo oyketida adde.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Layma maccasi haniya hanoyka hessa mela;","poem":1},{"text":"Iya masu; shin ba doona quchada,","poem":2},{"lineBreak":true},{"text":"“Taani aykoka balabiike” yaagawusu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Heedzuban biitti qaaxees;","poem":1},{"text":"oyddanthuwa ubba tookanaw danda7etenna.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hessatika,","poem":1},{"text":"aylley kawotida wode,","poem":2},{"lineBreak":true},{"text":"eeya asi kathi kallida wode,","poem":2}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"asi ixida maccasi azina gelida wodenne","poem":2},{"lineBreak":true},{"text":"macca aylliya ba godatiw laattida wode medhetiya hanota.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Sa7a bolla oyddu guutha medhetethati de7oosona;","poem":1},{"text":"shin enti aadhida cinca.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Hessatika,","poem":1},{"lineBreak":true},{"text":"Cuncalley wolqi bayna medhetethi;","poem":1},{"text":"shin bantaw miyaba bone shiishidi, minjoosona.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Gupaleti wolqi baynayisata;","poem":1},{"text":"shin banta keetha zaalla qophon keexoosona.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Booletas kawoy baawa;","poem":1},{"text":"shin enti ubbay maaran zattoosona.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Zareti kushen oyketoosona;","poem":1},{"text":"shin kawo gadhon de7oosona.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Banta maata bessishe hemetiya heedzu medhetethati de7oosona;","poem":1},{"text":"oyddanthoy lo77o hemethi hemetees.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Hessika,","poem":1},{"text":"do7a ubbaafe minonne yashshi eronna gaammo.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Macca kuttota giddon hemetiya adde kutto,","poem":1},{"text":"wude kaalethiya deesha kole;","poem":2},{"lineBreak":true},{"text":"ba olanchota giddon qoncen eqiya kawa.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Neeni eeyada otortidaba gidikoka,","poem":1},{"text":"iita oothanaw halchidaba gidiko,","poem":2},{"lineBreak":true},{"text":"ane taki gada qopa.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Maathi bukey oysu kesseysada,","poem":1},{"text":"siidhe dichin suuthi yeysada,","poem":2},{"lineBreak":true},{"text":"hanqo denthethoy ooshshu ehees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PRO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}