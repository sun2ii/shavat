{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_ltw","name":"Leemiso Maxaafa","commonName":"Leemiso Maxaafa","title":"Leemiso Maxaafa","order":20,"numberOfChapters":31,"sha256":"95d70e6d82da62b90de57969d9cb4fede4fc023eb08e912eaff45805545a5370","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_ltw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":31,"content":[{"type":"heading","content":["Kawa Limu7eela Leemisota"]},{"type":"verse","number":1,"content":["Haysafe kaallidi xaafetida leemisoy, kawa Limu7eela aayiya kawa Limu7eela tamaarsidaysa."]},{"type":"verse","number":2,"content":[{"text":"Ta na7aw, ta ulope wodhidayso,","poem":1},{"text":"taani qangetada yelidayso,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"maccasan ne wolqaa wursofa;","poem":2},{"lineBreak":true},{"text":"kawota dhaysiya maccasatan ne minotethaa dhaysofa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Limu7eela, woyne ushshi kawotas bessenna;","poem":1},{"text":"mathoyiya ushshi shuumatas bessenna.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Enti uyaa wode higge baloosona;","poem":1},{"text":"naaqetida asaa maata qelli goosona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mathoyaa ushshu hayqana haniya uraasinne","poem":1},{"text":"sa7i iitida uraas immite.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Enti banta manqotethaanne","poem":1},{"text":"banta waayiya doganaw uyo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Banta gisho odetanaw danda7onna asaa gisho ne odeeta;","poem":1},{"text":"maaddiya asi baynayisata gisho ne eqa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Enta miyen eqada entaw suure pirda;","poem":1},{"text":"manqotanne metootanchota maata naaga” yaagada tamaarsasu.","poem":2}]},{"type":"heading","content":["Wozanaama Macho"]},{"type":"verse","number":10,"content":["“Wozanaama macho ooni demmanaw danda7ii?",{"text":"I gatey zo7o al7o shuchafe aadhees.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"I azinay iyo ammanetees;","poem":1},{"text":"iyaw koshshiyabaape aybika pacenna.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Iya ba de7o laytha ubban,","poem":1},{"text":"iyaw lo77obaape attishin, iitaba oothuku.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Suufenne liino koyada,","poem":1},{"text":"ufaytashe ba kushen oothawusu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iya zal7anchota markabe mela;","poem":1},{"text":"ba kathaa haaho biittafe shiishawusu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Iya ba soo asaas kathi giigisanawunne","poem":1},{"text":"ba macca aylletas ooso immanaw,","poem":2},{"lineBreak":true},{"text":"sa7i wontonna de7ishin dendawusu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Lo77o gade koyada shammawusu;","poem":1},{"text":"ba kushen oothada demmida","poem":2},{"lineBreak":true},{"text":"miishen woyne tokawusu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Iya ba xeessa minthada dancawusu;","poem":1},{"text":"ba qesiya oosos minthawusu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Iya wodhe demmanaw minnada zal7awusu;","poem":1},{"text":"iya oothashe qamisiya gisho I xompey to7enna.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Iya ba hindziritiya oykawusu;","poem":1},{"text":"ba biradhen loythada suqawusu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Iya manqotasinne metootanchotas immawusu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"I soo asa ubbay ho77iya ma7o ma7iya gisho,","poem":1},{"text":"shachi bukikoka iya hirguku.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Alga bolla hiixiya ma7o sikawusu;","poem":1},{"text":"liinope oosetida ocha teera daaniya ma7o ma7awusu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Biitta cimati shiiqiya dubbushan","poem":1},{"text":"I azinay bonchetida asi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Liinope ma7onne danco oothada,","poem":1},{"text":"zal7anchotas bayzawusu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Iya minonne boncho asi;","poem":1},{"text":"yaana laytha ubban ufaytada de7awusu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Cincatethan ba doona dooyawusu;","poem":1},{"text":"ammanthiya zorey I inxarsan de7ees.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Iya ba soo asaa de7uwa injeyanaw ubba wode oothawusu;","poem":1},{"text":"azallatethi I bolla bentidi erenna.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"I nayti dendidi, iyo nashshoosona;","poem":1},{"text":"I azinay iyo yaagidi galatees;","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Lo77oba oothiya daro maccasati de7oosona;","poem":1},{"text":"shin ne enta ubbaafe aadhasa” yaagees.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Mali cimmees;","poem":1},{"text":"yegelssatethi dhayana.","poem":2},{"text":"Shin Godaa yayiya maccasiya,","poem":1},{"text":"iya anjetidaaro.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Iya oothidaba ubbaas iyo woytite;","poem":1},{"text":"I ooso ubbay dabaaban iyo galatiso.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":31}