{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_ltw","name":"Leemiso Maxaafa","commonName":"Leemiso Maxaafa","title":"Leemiso Maxaafa","order":20,"numberOfChapters":31,"sha256":"95d70e6d82da62b90de57969d9cb4fede4fc023eb08e912eaff45805545a5370","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_ltw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":4,"content":[{"type":"heading","content":["Cincatethi Ubbaafe Bolla"]},{"type":"verse","number":1,"content":[{"text":"Ta nayto, hinte aawa zoriya si7ite;","poem":1},{"text":"loythi si7ite; hinte akeeka demmana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta hintew lo77o timirte immiya gisho,","poem":1},{"text":"ta timirtiya kadhopite.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taka ta aawas na7a;","poem":1},{"text":"ta aayes iya dosiya issi na7a.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ta aaway tana haysada yaagidi tamaarsis;","poem":1},{"text":"“Ta oday new gelo; ta kiita naaga;","poem":2},{"lineBreak":true},{"text":"neeni hessa oothiko de7on daana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Cincatethinne akeeka demmanaw minna;","poem":1},{"text":"ta new odiyaba dogopa; iyape kare keyopa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Cincatethas zoko zaaropa; iya nena ashshana;","poem":1},{"text":"iyo dosa; iya nena naagana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Cincatethi aadhiya gisho iyo demma;","poem":1},{"text":"new de7iyaba wursidi ekikoka akeeka demma.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne iyo boncha;","poem":1},{"text":"iya nena dhoqu dhoqu oothana;","poem":2},{"lineBreak":true},{"text":"ne iyo oykiko, iya nena bonchana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iya ne huuphiyas saba gidana;","poem":1},{"text":"boncho kallacha immana” yaagis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta na7aw, si7a; ta odeysa eka;","poem":1},{"text":"ne laythay aduqana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Taani nena cincatetha oge kaalethana;","poem":1},{"text":"suure horoga bessaana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne hemetiya wode dhubiyabay deenna;","poem":1},{"text":"woxiyakoka dhubetaka.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ta timirtiya loytha naaga; yeddofa;","poem":1},{"text":"timirtey new de7o immiya gisho loytha naaga.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nagaranchota ogiyara boopa;","poem":1},{"text":"iita asata ogiyan hemetofa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Iyape haaka; iyan hemetofa;","poem":1},{"text":"guye simma; ne ogiyan ba.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Enti iitaba oothonna de7ishin dhiskoy ekenna;","poem":1},{"text":"enti ase dhubbonna de7ishin dhiskoy efenna.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Enti nagara kathada moosona;","poem":1},{"text":"geellatethi ushshada uyoosona.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Xillota ogey seeta gallas gakanaw,","poem":1},{"text":"guji guji poo7iya wonta xalqe mela.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Shin geellata ogey sakana dhuma mela;","poem":1},{"text":"enti aybin dhubetiyakoka erokona.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ta na7aw, ta odeysa si7a;","poem":1},{"text":"ne haythaa taako zaara.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ne ayfiya sinthafe haassofa;","poem":1},{"text":"ne wozanan naaga.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Enta demmiya ubbaas enti de7o;","poem":1},{"text":"enti asatethas payyatethi immoosona.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"De7oy iyape pultiya gisho,","poem":1},{"text":"ubbaafe aathada ne wozanaa minthada naaga.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ne doonape iita haasaya digga;","poem":1},{"text":"wordo haasaya ne matape haassa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Sitti gada sinthe xeella;","poem":1},{"text":"ne ayfey ne sinthan de7iyaba","poem":2},{"lineBreak":true},{"text":"tishshi oothidi xeello.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ne tohuwa ogiya giigisa;","poem":1},{"text":"suure oge xalaalan hemeta.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Suure ogepe ushachi haddirsi goopa;","poem":1},{"text":"ne tohoy iita oge boonnada naaga.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}