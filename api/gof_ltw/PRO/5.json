{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_ltw","name":"Leemiso Maxaafa","commonName":"Leemiso Maxaafa","title":"Leemiso Maxaafa","order":20,"numberOfChapters":31,"sha256":"95d70e6d82da62b90de57969d9cb4fede4fc023eb08e912eaff45805545a5370","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_ltw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":5,"content":[{"type":"heading","content":["Laymatethafe Haaka"]},{"type":"verse","number":1,"content":[{"text":"Ta na7aw, ta cincatetha hayza si7a;","poem":1},{"text":"ne haythaa ta timirtiyako zaara.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hessi nena wozanaama oothana;","poem":1},{"text":"ne oday ne eratethaa qoncisana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Layma maccasa inxarsafe ililo eessi xokees;","poem":1},{"text":"I oday oysape aadhidi looxikees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Shin wursethan iya godare uthada cammawusu;","poem":1},{"text":"nam7u baggara qanxiya mashshada qara.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"I tohoy hayqoko bees;","poem":1},{"text":"I tangoy duufo gathees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iya de7o oge qopuku; I ogey geella;","poem":1},{"text":"shin geella gideysa iya eruku.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta na7aw, tana si7a;","poem":1},{"text":"ta odeysafe keyopa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Layma maccasa heera boopite;","poem":1},{"text":"I keetha pengiyako shiiqopite.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hessi hanonna ixiko hinte bonchuwa harati ekana;","poem":1},{"text":"na7atethan wozana mino asa kushen hinte hayqana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hinte aquwa allagati ekana;","poem":1},{"text":"hinte daaburadi shiishidabay hara asas gidana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wursethan hinte ashoynne","poem":1},{"text":"hinte asatethay wurin hinte yeekana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hinte yaagana; “Ta ayis timirte ixadina?","poem":1},{"text":"Ta wozanay seera ayis kadhidee?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Taani ta astamaareta si7abike;","poem":1},{"text":"tana zoreyisata zoriya ekabike.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hesaa gisho, ta asay shiiqida shiiquwan,","poem":1},{"text":"kawuyanaw matas” yaagana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Neeni ne pultuwafe haathe uya;","poem":1},{"text":"ne mache xalaala siiqa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ne pultuwa dabaaban,","poem":1},{"text":"ne olla haatha denban ayis gussay?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Enta new buzo ootha;","poem":1},{"text":"hara allaga uraara koxofa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ne pultoy new anjeto;","poem":1},{"text":"ne na7atetha machera ufayta.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Lo77iya gaaredaninne ufaysiya gen7eda","poem":1},{"text":"I dhanthay ubba wode nena alo;","poem":2},{"lineBreak":true},{"text":"ubba wode I siiqoy nena di77o.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ta na7aw, layma maccasan ayis di7etay?","poem":1},{"text":"Hara asa macho ayis qoommay?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Asi oothiyaba ubbaa Goday be7ees;","poem":1},{"text":"I hemetiya horoga ubbaa xeellees.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nagaranchuwa I oothida nagaray oykees;","poem":1},{"text":"Iya nagaraa gitey iya qachees.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"I ba eeyatethan dhayis;","poem":1},{"text":"bana naagiboonna gisho hayqis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PRO/4.json","previousChapterAudioLinks":{},"numberOfVerses":23}