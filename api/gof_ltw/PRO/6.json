{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_ltw","name":"Leemiso Maxaafa","commonName":"Leemiso Maxaafa","title":"Leemiso Maxaafa","order":20,"numberOfChapters":31,"sha256":"95d70e6d82da62b90de57969d9cb4fede4fc023eb08e912eaff45805545a5370","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_ltw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":6,"content":[{"type":"heading","content":["Eeyatethafe Haaka"]},{"type":"verse","number":1,"content":["Ta na7aw, miishe tal7ida ne shooruwas waase gelidaba gidiko,",{"text":"hara asas kushe baqada caaqidaba gidiko,","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ne caaqida ne caaquwan xihen gelidaba gidiko,","poem":2},{"lineBreak":true},{"text":"ne doonape keyida qaalan oyketidaba gidiko,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"hiza ne shooruwa kushen geladasa.","poem":2},{"text":"Hessa gisho, ta na7aw, iyape keyanaw koyko,","poem":1},{"text":"ne shooruwa soo bada waasetetha","poem":2},{"lineBreak":true},{"text":"ne bollafe wothana mela aaddashada iya woossa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hessa oothonna de7ashe zin7ofa;","poem":1},{"text":"dhiskoyka nena ekofo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Shankafe gen7ey kessi ekiyada,","poem":1},{"text":"gitepe kafoy attiyada nena ashsha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Neno azallaw, zimadoko ba;","poem":1},{"text":"iyape cincatethi tamaara.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Zimaddota kiittey baawa,","poem":1},{"text":"halaqi woyko enta haarey baawa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Shin bantaw maanaba bone minjoosona;","poem":1},{"text":"kathi cakiya wode bantaw koshshiya kathaa shiishosona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neno azallaw, ne awude gakanaw dhiskay?","poem":1},{"text":"Ne dhiskofe awude barkanee?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Neeni “guuthu zin7ana; guuthu dhiskana;","poem":1},{"text":"kushe shiisha ekada guuthu shempana” yaagasa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"He wode manqotethi pangada,","poem":1},{"text":"paci ola miishe oykida asada ne bolla yaana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Laafanne iita asi yuuyidi oda mirqees;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I ba ayfen qam7otees;","poem":1},{"text":"ba tohon bessees; ba biradhen mallees.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iya ulon geellatethi de7ees; iitabaa qopees;","poem":1},{"text":"ubba wode ooshshu medhees.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hessa gisho dhayoy akeekona iya bolla yaana;","poem":1},{"text":"I hassayonna meqana; zaaridi paxenna.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Goday ixiya usupun qommoti de7oosona;","poem":1},{"text":"I shaatetiya qommoti laapuna;","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"kadhidi xeelliya ayfe,","poem":2},{"lineBreak":true},{"text":"wordotiya inxarsi,","poem":2},{"lineBreak":true},{"text":"xillo asata wodhiya kushe,","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"iitaba maqiya wozanaa,","poem":2},{"lineBreak":true},{"text":"iitabaako woxanaw eesotiya toho,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wordo bolla wordo gujiya wordo marka,","poem":1},{"text":"ishata giddon ooshshi medhiya asi.","poem":2}]},{"type":"heading","content":["Laymatethafe Naageta"]},{"type":"verse","number":20,"content":["Ta na7aw, ne aawa kiita pola;",{"text":"ne aaye timirtiya aggofa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Enta ubba wode ne wozanan oyka;","poem":1},{"text":"ne qoodhiyan qacha.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ne hemetiya wode enti nena kaalethana;","poem":1},{"text":"ne zin7iya wode, enti nena naagana;","poem":2},{"lineBreak":true},{"text":"ne barkiya wode enti nena zorana.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Godaa kiitay xompe; iya timirtey poo7o;","poem":1},{"text":"iya seeray de7oko efiya oge.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ha timirteti iita maccafenne","poem":1},{"text":"hara cimmiya maccasa inxarsafe nena naagana.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"I mala lo77otethay nena qadhethofo;","poem":1},{"text":"I qam7otoy nena di77ofo.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Issi addey guutha miishen layma maccas demmanaw danda7ees;","poem":1},{"text":"shin hara asa macho laggethoy shempo ekees.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Tama idimmin","poem":1},{"text":"iya ma7oy meetetonna attey de7ii?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Tama bonqo yedhin,","poem":1},{"text":"iya tohoy xuugetonna attey de7ii?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Asa macho laggethiya uray hessa mela;","poem":1},{"text":"iyo bochiya ubbay seerettonna attenna.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Kaysoy koshatidi maanaw kaysiko,","poem":1},{"text":"asi iya borenna.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Shin I oyketiyabaa gidiko,","poem":1},{"text":"laapun kushe qanxana;","poem":2},{"lineBreak":true},{"text":"ba son de7iya miishe ubbaa immana.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Shin maccasara laymatiya asi wozani bayna asi;","poem":1},{"text":"he uray ba shempuwa dhaysees.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Deshethinne kawushi iya qaada;","poem":1},{"text":"yeelli iyape qushetenna.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Qanaatey azinas yilo denthethees;","poem":1},{"text":"halo kessiya wode iw qadhetenna.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"I ay acaka ekenna;","poem":1},{"text":"ay mela imotika iya hanquwa doshisenna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}