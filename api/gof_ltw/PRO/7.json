{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_ltw","name":"Leemiso Maxaafa","commonName":"Leemiso Maxaafa","title":"Leemiso Maxaafa","order":20,"numberOfChapters":31,"sha256":"95d70e6d82da62b90de57969d9cb4fede4fc023eb08e912eaff45805545a5370","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_ltw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":7,"content":[{"type":"heading","content":["Layma Maccasape Naageta"]},{"type":"verse","number":1,"content":["Ta na7aw, ta qaala naaga;",{"text":"ta kiitaa ne wozanan wotha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"De7on daanaw ta kiita ootha;","poem":1},{"text":"ta timirtiya ne ayfe na77eda naaga.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ne kushen enta qacha;","poem":2},{"lineBreak":true},{"text":"ne wozanan enta xaafa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Cincatethi ne michida,","poem":1},{"text":"akeeka ne mata dabboda xeella.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Enti nena layma maccasapenne","poem":1},{"text":"ba qaalan cimmiya hara maccasape naagana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Issi gallas ta maskootera kare xeellas.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Eratethi pacida na7atethata be7as;","poem":1},{"text":"enta giddofe issoy daro eeya.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"He na7atethay ogera bishe,","poem":1},{"text":"issi layma maccase keethaa matara aadhees;","poem":2},{"lineBreak":true},{"text":"I soo efiya ogiya simmidi I sooko bis.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"He wode sa7i laadees.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Maccasiya iya demmasu;","poem":1},{"text":"iya layma gideysa I ma7oy erisees;","poem":2},{"lineBreak":true},{"text":"iya asa cimmanaw halchada keyasu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Iya xaltaamanne yeelli bayna maccas;","poem":1},{"text":"son wopu gada uttuku.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Iya issi toho ogen, issi toho giyan,","poem":1},{"text":"issi toho dabaaban eqada naagawusu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Iya he na7atetha qoommada yeerasu;","poem":1},{"text":"iya tishshi oothada xeellashe haysada yaagasu;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“Taani ta yarshuwa yarshada,","poem":1},{"text":"ta qangetha hachi gathas.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yaatada nena mokanaw keyas;","poem":1},{"text":"nena daro koyas; hiza nena demmas.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Taani Gibxefe yida,","poem":1},{"text":"alleeqetida afila hiixas.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Taani ta hiixa,","poem":1},{"text":"karbefe, almunepenne qarafape,","poem":2},{"lineBreak":true},{"text":"oosetida shittuwa puukas.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Haaya; wontana gakanaw siiqo aloos;","poem":1},{"text":"qoometidi ufaytoos.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ta azinay son deenna;","poem":1},{"text":"haaho biitta bis.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Miishe karxiita kunthidi bida gisho,","poem":1},{"text":"ageena kumonna soo simmenna” yaagasu.","poem":2}]},{"type":"verse","number":21,"content":["Ba mal7o odan iya balethasu;",{"text":"ba liiqo inxarsan iya cimmasu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Boori shukettanaw beysada,","poem":1},{"text":"gaari eesotidi xihen geleysada,","poem":2},{"lineBreak":true},{"text":"I iyo kaallidi bis.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Toori iya wozanaa caddidaada hanis;","poem":1},{"text":"gite giddo gelida kafo daanis;","poem":2},{"lineBreak":true},{"text":"hessi ubbay iya shempuwa dhaysanaw haneysa eribeenna.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Hiza ta na7aw, tana si7a;","poem":1},{"text":"ta doonape keyiya qaala hayza.","poem":2}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ne wozanay maccasa geedo boopo;","poem":2},{"lineBreak":true},{"text":"I ogiyan gelada dhayopa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Iya cadda yeggidaysati daro;","poem":1},{"text":"iya wodhidaysati guutha gidokona.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"I soy duufoko efiya oge;","poem":1},{"text":"hayqoko kaalethiya horoga.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}