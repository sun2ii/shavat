{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_ltw","name":"Leemiso Maxaafa","commonName":"Leemiso Maxaafa","title":"Leemiso Maxaafa","order":20,"numberOfChapters":31,"sha256":"95d70e6d82da62b90de57969d9cb4fede4fc023eb08e912eaff45805545a5370","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_ltw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":8,"content":[{"type":"heading","content":["Cincatetha Oge"]},{"type":"verse","number":1,"content":[{"text":"Cincatethi xeegawusu; si7ite;","poem":1},{"text":"akeeki ba qaala dhoqu oothida sissawusu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Oge doonan de7iya zumata bollanne","poem":1},{"text":"daggala ogiyan iya eqawusu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dirsa penge matan, katamaa geliya pengen eqada,","poem":1},{"text":"ba qaala dhoqu oothada haysada yaagawusu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Asaw, ta hintena xeegayis;","poem":1},{"text":"asa koche ubbaa xeegayis.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hinteno eratethi baynaysato eratethi tamaarite;","poem":1},{"text":"hinteno eeyato, akeeka demmite.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taani lo77oba odiya gisho si7ite;","poem":1},{"text":"taani doonape suurebay keyees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Taani tuma odetayis;","poem":1},{"text":"wordoy ta matan ixetidaba.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ta oday tuma;","poem":1},{"text":"geella woyko mirqethi gidenna.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akeeki de7iya uraas ta oday like;","poem":1},{"text":"eri de7iya uraas ta oday qonce.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Birape aathidi ta zoriya doorite;","poem":1},{"text":"geeshsha worqafe aathidi eratethi doorite.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Cincatethi zo7o al7o shuchafe aadhees;","poem":1},{"text":"ne amotiya ubbay iira liketenna.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Taw, cincatethas akeeki de7ees;","poem":1},{"text":"eratethinne shaakidi eroy tabaa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Godaas yashshi iitatethi ixo;","poem":1},{"text":"taani otoronne ceeqetethi ixayis;","poem":2},{"lineBreak":true},{"text":"iita ogenne wordo oda dosike.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Zoreynne lo77o eray tabaa;","poem":1},{"text":"akeekinne wolqi taw de7ees.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kawoti ta baggara kawotoosona;","poem":1},{"text":"haareysati suure higge ta baggara kessoosona.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Halaqati ta maaddin deriya haaroosona;","poem":1},{"text":"biitta aysiya gita asata ta maaddayis.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tana doseyisata ta dosayis;","poem":1},{"text":"tana minthidi koyeysati demmana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Duretethinne bonchoy taara de7oosona;","poem":1},{"text":"wuronna shaloynne injey ta matana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hinte taape demmiya go77ay,","poem":1},{"text":"geeshsha worqafenne birape aadhees.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ta xillotetha ogen hemetayis;","poem":1},{"text":"suure pirda ogiyara kanthayis.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Tana doseysatas ta shalo immana;","poem":1},{"text":"enta keethaa duretethan kunthana.","poem":2}]},{"type":"verse","number":22,"content":["“Goday tana ubbaafe koyro medhis;",{"text":"benipeka iya oosuwas doomethay tana.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Alamey medhetanaape kase","poem":1},{"text":"taani shuumetas.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Abbay bayna wode, pultoti dhuuqonna","poem":1},{"text":"de7ishin ta yeletas.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Deretinne zumati medhetanaape","poem":1},{"text":"sinthe ta yeletas.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Goday sa7aanne sa7an de7iya ubbaa medhanaape sinthe","poem":2},{"lineBreak":true},{"text":"woyko koyro kophe biittay oosetanaape sinthe ta yeletas.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Goday salota miccida wode,","poem":1},{"text":"abbatape bollara salo gufantho giigisida wode,","poem":2},{"lineBreak":true},{"text":"taani yan de7ayis.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Goday shaarata bollara wothida wode,","poem":1},{"text":"abba pultota dhuusida wode,","poem":2}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"abba haathati imetida zawape pinnidi, bolla aadhonada,","poem":2},{"lineBreak":true},{"text":"I enta kiitida wode sa7aa baasuwa minthida wode,","poem":2},{"lineBreak":true},{"text":"taani yan de7ayis.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"He wode ta iya matan waanna oosancho;","poem":1},{"text":"ubba wode ta iya ufaysayis;","poem":2},{"lineBreak":true},{"text":"tawuka iya sinthan ufaytayis.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"I medhida alamiyan ufaytayis;","poem":1},{"text":"asa naytika tana ufaysoosona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"“Hiza ta nayto, si7ite;","poem":1},{"text":"ta odeysada ootheysati anjetidaysata.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ta timirtiya si7ite; cinca gidite;","poem":1},{"text":"si7idaba dogopite.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Taani odidaba si7iya uray,","poem":1},{"text":"gallas gallas ta pengiyan bentiya uray,","poem":2},{"lineBreak":true},{"text":"ta pengiyan naagiya uray anjetidaysa.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Tana demmiday de7o demmees;","poem":1},{"text":"Godaape saba ekees.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Shin tana demmonna uray bana qohees;","poem":1},{"text":"tana ixiya ubbay hayqo dosees.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}