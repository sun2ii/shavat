{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PRO","translationId":"gof_ltw","name":"Leemiso Maxaafa","commonName":"Leemiso Maxaafa","title":"Leemiso Maxaafa","order":20,"numberOfChapters":31,"sha256":"95d70e6d82da62b90de57969d9cb4fede4fc023eb08e912eaff45805545a5370","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/gof_ltw/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":9,"content":[{"type":"heading","content":["Cincatethi, Eratethinne Eeyatethi"]},{"type":"verse","number":1,"content":[{"text":"Cincatethi ba keethaa keexasu;","poem":1},{"text":"laapun tuussata ba keethaas essasu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iya ba giigisiya gibiras modho mehe shukasu;","poem":1},{"text":"woyne aggasu; gayta asaa sinthe aathasu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Asaa xeeganaw ba aylleta kiittasu;","poem":1},{"text":"oosanchoti katamaa dhoqa bessan eqidi,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hinteno, eri pacidaysato haa gelite! Eeyatako haysada yaagasu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Haa yiite; ta kathaa miite;","poem":2},{"lineBreak":true},{"text":"ta aggida woyniya uyite.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hinte eeyatethi aggidi de7on de7ite;","poem":2},{"lineBreak":true},{"text":"akeekidi hemetite” yaagasu.","poem":2}]},{"type":"verse","number":7,"content":["Qelqisiya uraa seeriya asi cashshe ekees;",{"text":"iita uraa zoriya asi baw qohetees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Qelqisiya uraa zoropa; I nena ixana;","poem":1},{"text":"cinca uraa zora; I nena dosana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Cincatethi uraa tamaarsa; I cinca gidana;","poem":2},{"lineBreak":true},{"text":"Xillo uraa tamaarsa; I era gujana.","poem":2}]},{"type":"verse","number":10,"content":["Godaas yashshi cincatethas doomethi, Geeshsha Godaa eroy akeeka."]},{"type":"verse","number":11,"content":[{"text":"Ta gaason ne laythay darana;","poem":1},{"text":"ne de7o laythay aduqana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne cinca gidiko, go7etey nena;","poem":1},{"text":"Ne qelqisiya asi gidiko nena qohaasa.","poem":2}]},{"type":"verse","number":13,"content":["Eeyo maccasi waaso darawusu;",{"text":"iw yeelli baawa; iya aykoka eruku.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iya ba karen woyko katamaa dhoqa bessan uttawusu.","poem":1}]},{"type":"verse","number":15,"content":[{"text":"Banta ogiya biya asaa xeegada,","poem":1}]},{"type":"verse","number":16,"content":[{"text":"“Hinteno, eri pacidaysato","poem":1},{"text":"taako haa yiite” yaagasu. Eri baynaysatako,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“Kaysidi uyaa haathi mal7ees;","poem":2},{"lineBreak":true},{"text":"geeman miya kathi lo77ees” yaagasu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Shin hayqida asay yan de7eysa,","poem":1},{"text":"I imathatika duufon de7eysa I erenna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}