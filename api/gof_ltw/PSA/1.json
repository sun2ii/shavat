uulatan bentokona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Goday xillota ogiya erees;","poem":1},{"text":"shin iitata ogey dhayana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}