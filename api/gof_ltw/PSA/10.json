{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":10,"content":[{"type":"heading","content":["Suure Pirda Kosha Woosa"]},{"type":"hebrew_subtitle","content":["Dawita Mazmure"]},{"type":"verse","number":1,"content":[{"text":"Abeeti Godaw, ayis haakada eqay?","poem":1},{"text":"Meto wode ayis neeni geemmay?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ba otoruwan iita asi manquwa yedethees;","poem":1},{"text":"enti banta maquwan bantaw oyketidosona.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iita asi ba iita amuwan ceeqetees;","poem":1},{"text":"ba uuziyan Godaa cayeesinne kadhees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iitati banta otoruwan Xoossaa koyokona;","poem":1},{"text":"banta qofan Xoossas besse immokona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iyaw ubba wode injetees;","poem":1},{"text":"ne higgey iyaw gelenna;","poem":2},{"lineBreak":true},{"text":"ba morketa I qelqisees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ba wozanan, “Tana aybika qaathenna","poem":1},{"text":"tana metoy gakenna” yaagidi qopees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iya doonan baadethi,","poem":1},{"text":"wordoynne mandethi kumis.","poem":2},{"lineBreak":true},{"text":"Geneynne iitatethi iyan inxarsan de7ees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gutatan zugidi uttees;","poem":1},{"text":"suure asata wodhanaw qosetidi naagees;","poem":2},{"lineBreak":true},{"text":"wolqi bayna daaburanchota wochees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ba qosetida bessan geemmidi,","poem":1},{"text":"manquwa oykanaw gaammoda zugees;","poem":2},{"lineBreak":true},{"text":"iya oykidi ba xihiyan goochidi efees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wolqi bayna manquwa shocidi yeggees;","poem":1},{"text":"iya tohuwa garsan I kundees.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"I ba wozanan, “Xoossay dogis.","poem":1},{"text":"Ba som7uwa genthidi be7enna” yaagees.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abeeti Godaw, denda!","poem":1},{"text":"Xoossaw, ne wolqaama kushiya dentha;","poem":2},{"lineBreak":true},{"text":"manqota dogopa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Iita asati Xoosse ayis kadhoona?","poem":1},{"text":"Banta wozanan, “Xoossay nuna seerenna” ayis yaagona?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Shin Xoossaw, ne metuwanne un7aa be7aasa;","poem":1},{"text":"neeni maaddanaw giiga uttadasa.","poem":2},{"text":"Neeni yi7otas maade,","poem":1},{"text":"qohetiday ne maaddana mela","poem":2},{"lineBreak":true},{"text":"bana new aathidi immees.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Gene asata wolqaa mentha;","poem":1},{"text":"iita asata seera;","poem":2},{"lineBreak":true},{"text":"zaaridi enta giddon iitatethi bentofo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Goday merinaw kawotidi de7ees;","poem":1},{"text":"hara kawotethati iya biittafe dhayana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Abeeti Godaw, neeni ashketa amuwa kunthaasa;","poem":1},{"text":"enta minthetha; enta woosa si7a.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yi7otanne un7etidaysata qohonna mela,","poem":1},{"text":"sa7an de7iya oonika enta yashisonna mela,","poem":2},{"lineBreak":true},{"text":"neeni entaw pirda.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}