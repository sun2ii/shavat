{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":101,"content":[{"type":"heading","content":["Taani Suure Oge Hemetana"]},{"type":"hebrew_subtitle","content":["Dawita Mazmure"]},{"type":"verse","number":1,"content":["Ta ne siiquwabaanne ne xillo pirdaba yexana;",{"text":"Godaw, ta nena mazmuren galatana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taani suure ogiyan daana;","poem":1},{"text":"neeni taako awude yaanee?","poem":2},{"lineBreak":true},{"text":"Taani ta keethan suuretethan hemetana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taani ta ayfey iitabaa xeellenna;","poem":1},{"text":"Xoossafe haakida asaa oosuwa ixayis;","poem":2},{"lineBreak":true},{"text":"enti taara gahetokona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wozanaa geellatethi taape haako;","poem":1},{"text":"iitatethaas besse immike.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Geeman ba laggiya zigiriya uraa si77i oothana;","poem":1},{"text":"otortiyanne ceeqetiya asi taani danda7ike.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Enti taara daana mela,","poem":1},{"text":"biitta bolla de7iya ammanetiya asata","poem":2},{"text":"Taani keeha ayfen xeellayis;","poem":1},{"text":"suuretethan hemetiya asi taw kiitetees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Cimmiya asi ta keethan deenna;","poem":1},{"text":"wordo haasaya asi ta sinthan eqenna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Biittan de7iya iita asaa,","poem":1},{"text":"taani gallas gallas si77i oothana.","poem":2},{"lineBreak":true},{"text":"Iitaa ootheyisata ubbaa","poem":2},{"lineBreak":true},{"text":"taani Godaa katamaape shoddana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}