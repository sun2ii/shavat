{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":102,"content":[{"type":"heading","content":["Ne Som7uwa Taape Genthofa"]},{"type":"hebrew_subtitle","content":["Un7etida wode Xoossa sinthan woossida asa woosa"]},{"type":"verse","number":1,"content":["Godaw, ta woosa si7a;",{"text":"ta waasoy neeko gako.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta waayiya gallas ne som7uwa taape genthofa;","poem":1},{"text":"ne haytha taako zaara;","poem":2},{"lineBreak":true},{"text":"taani neeko waassiya wode, tana eeson alla.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ta laythay cuyada dhayees;","poem":1},{"text":"ta meqethay tamada eexees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ta wozanay buucidi yeggida maatada melis;","poem":1},{"text":"kathika taw meetetenna.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Taani ta qaala dhoqu oothada oolida gisho;","poem":1},{"text":"ta gogay meqethaara oyketis.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taani woran de7iya solo mela,","poem":1},{"text":"kaysa keethan de7iya gutto mela.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Taani zin7in dhiskoy yeenna;","poem":1},{"text":"taani keetha huuphen barka uttida kafo gidas.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ta morketi gallas kumethi tana cayoosona;","poem":1},{"text":"tana qelqiseysati ta sunthan baaddoosona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bidoy taw kathi gidis;","poem":1},{"text":"ta afuthay ta ushshara Walaketis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hessi haniday ne hanqoynne ne yiloy,","poem":1},{"text":"tana denthadi wora holida gishosa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ta laythay omarsa kuya mela ellesidi aadhees;","poem":1},{"text":"taani maatada shullayis.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Shin Godaw, neeni ne araatan merinaw uttadasa;","poem":1},{"text":"ne sunthay yeletaape yeletaa gakanaw hassayetana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Neeni iyo maariya wodey gakida gisho;","poem":1},{"text":"dendada Xiyoones qadheta;","poem":2},{"lineBreak":true},{"text":"neeni doorida wodey gakis.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"I shuchati ne oosanchotas al7o;","poem":1},{"text":"I biittayka enta qadhethees.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kawotethati Godaa sunthaas yayyana;","poem":1},{"text":"sa7aa kawoti iya bonchuwas dagammana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Goday Xiyoone zaaridi keexana;","poem":1},{"text":"ba gitatetha bessana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"I manqota woosa si7ana;","poem":1},{"text":"enta oysha kadhenna.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Buroo yeletana asay Godaa galatana mela,","poem":1},{"text":"haysi yaa yeletas xaafeto.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Goday dhoqan de7iya","poem":1},{"text":"ba geeshsha bessaafe xeellis;","poem":2},{"lineBreak":true},{"text":"salon gididi sa7aa xomoosees.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hessika qashetida asaa waasuwa si7anawunne","poem":1},{"text":"hayqo pirdetida asaa birshanaasa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hessa gisho, Godaa sunthay Xiyoonen odetana;","poem":1},{"text":"iya galatay Yerusalaamen awaajettana.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Dereynne kawotethay shiiqidi,","poem":1},{"text":"Godaas he wode goyinnana.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Taani na7atethan de7ishin,","poem":1},{"text":"ta wolqaa ixisis; ta laytha qaamisis.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Taani, “Ta Xoossaw,","poem":1},{"text":"ta laytha giddo zawan tana dhukofa” yaagayis.","poem":2},{"lineBreak":true},{"text":"Godaw, neeni yeletape yeletaa gakanaw de7aasa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Neeni beni sa7aa medhadasa;","poem":1},{"text":"saloyka ne kushe ooso.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Haysati ubbay dhayana; shin neeni daana;","poem":1},{"text":"enti ubbay afilada wurana.","poem":2},{"text":"Neeni enta curqa afilada laammana;","poem":1},{"text":"entika aadhana.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Shin neeni nena;","poem":1},{"text":"ne laythay wurenna.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ne aylleta nayta neeni saro wothaasa;","poem":1},{"text":"enta kochay ne sinthan minnidi daana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}