{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":103,"content":[{"type":"heading","content":["Ta Shempe Xoossa Galata"]},{"type":"hebrew_subtitle","content":["Dawita Mazmure"]},{"type":"verse","number":1,"content":["Ta shempe Godaa galata!",{"text":"Ta kumetha asatethaw, iya geeshsha suntha galata.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta shempe Godaa galata!","poem":1},{"text":"I new oothida keehatetha ubbaa dogopa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"I ne nagaraa ubbaa atto gees;","poem":1},{"text":"ne harge ubbaafe nena pathees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I nena hayqope ashshees;","poem":1},{"text":"siiqoninne maarotan nena anjees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne yalagatethay arganthada ooraxana mela,","poem":1},{"text":"ne de7uwa lo77oban kalsees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Goday qohetidaysatas","poem":1},{"text":"xillotethaninne suuren pirdees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I ba ogiya Muse,","poem":1},{"text":"ba oosuwa Isra7eele asaa erisis.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Goday qadheteysanne maareysa;","poem":1},{"text":"hanqetanaw eesotenna; iya siiqoy daro.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"I ubba wode seerenna;","poem":1},{"text":"merinaw hanqetenna.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"I nuus nu nagaraada oothenna;","poem":1},{"text":"nu iitatethaa mela zaarenna.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Saloy sa7ape dhoqeysada,","poem":1},{"text":"Godaa yayyeysatas iya siiqoy gita.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dolohape wulohi haakeysada,","poem":1},{"text":"Goday nu nagara nuupe haassees.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Aawi ba naytas qadheteysada,","poem":1},{"text":"Goday baw yayyeysatas qadhetees.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nuuni aybipe medhetidaako I erees;","poem":1},{"text":"nuuni biitta gideysa I akeekes.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Asi baw maata mela;","poem":1},{"text":"I bazzo ciishshada ciyees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Carkoy iya bolla carkiya wode dhayees;","poem":1},{"text":"I dolida bessay zaaridi eretenna.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Shin Godaas yayyeysatas","poem":1},{"text":"iya siiqoy merinaape merinaa gakanaasa;","poem":2},{"lineBreak":true},{"text":"iya xillotethay na7a na7a gakanaasa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hessi haney iya caaquwa naageysatanne","poem":1},{"text":"iya kiitaa polanaw minneysatasa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Goday salotan ba araata essis;","poem":1},{"text":"iya kawotethay ubbaa haarees.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hinteno, iya kiitanchato,","poem":1},{"text":"iya kiita naagiya wolqaamato,","poem":2},{"lineBreak":true},{"text":"I odiyaba si7eysato, Godaa galatite!","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hinteno salon de7iya minoto,","poem":1},{"text":"iya sheniya poleysato, Godaa galatite!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hinteno, I haariya bessa ubban,","poem":1},{"text":"de7iya medhetethato, Godaa galatite!","poem":2},{"lineBreak":true},{"text":"Ta shempe Godaa galata!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}