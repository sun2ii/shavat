{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":104,"content":[{"type":"heading","content":["Xoossay Ba Medhetetha Heemmees"]},{"type":"verse","number":1,"content":["Ta shempe, Godaa galata;",{"text":"abeeti Godaw, ta Xoossaw ne gita;","poem":2},{"lineBreak":true},{"text":"neeni bonchonne teema ma7adasa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Poo7o afilada guuluntadasa;","poem":1},{"text":"neeni saluwa dunkaaneda toladasa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne keethaa salo bolla keexaasa;","poem":1},{"text":"shaara para gaare kessaasa;","poem":2},{"lineBreak":true},{"text":"carko qefe bolla uttada baasa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Carkoy new kiitancho,","poem":1},{"text":"tama laco new oosancho oothaasa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne, sa7aa iya baasuwa bolla essadasa;","poem":1},{"text":"hessa gisho, merinaw qaaxenna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ciimmo abbay afilada biitta kammis;","poem":1},{"text":"haathay gita dereta kammis.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne hanqetin haathati baqatidosona;","poem":1},{"text":"ne deshuwa si7ida wode qosetidosona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Enti dereta bollanne zangaarata giddo,","poem":1},{"text":"ne entaw giigisida bessaa goggidosona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Haathati simmidi biitta kammonnaada,","poem":1},{"text":"enti aadhanaw danda7onna zawa wothadasa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Neeni, pultoti zangaaran gogganaada oothadasa;","poem":1},{"text":"shaafa haathati dereta giddora goggoosona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bazzo do7ati ubbay iyape uyoosona;","poem":1},{"text":"bazzo hareti iyape saamo aloosona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Salo kafoti he haatha matan banta keethaa keexidi,","poem":1},{"text":"tashiya giddon yexoosona.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ne gita dereta bolla salope ira buksaasa;","poem":1},{"text":"iya kushe ooso ayfen biittiya kallasu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Neeni mehes maata, asas kathi dolisaasa;","poem":1},{"text":"hessan asay biitta oothidi, kathi shiishees.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Asa wozana ufaysiya woyne,","poem":2},{"lineBreak":true},{"text":"som7o cil7isiya zaytenne","poem":2},{"lineBreak":true},{"text":"wolqa immiya kathi dolisaasa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Godaa mithati,","poem":1},{"text":"I tokida Libaanose zigati,","poem":2},{"lineBreak":true},{"text":"daro ira demmoosona.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kafoti banta keetha yan keexoosona;","poem":1},{"text":"xiloti xiidda bolla keexidi de7oosona.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Dhoqa dereta bolla gaarati de7oosona;","poem":1},{"text":"gupalleti shucha qophon qosetoosona.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wode taybuwa erisana mela,","poem":1},{"text":"ne ageena medhadasa;","poem":2},{"lineBreak":true},{"text":"away ba wulliya wodiya erees.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Neeni dhumaa medhadasa; qamma oothadasa;","poem":1},{"text":"he dhuman wora do7i ubbay keyees.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Wodala gaammoti shankatishe gudoosona;","poem":1},{"text":"enti bantaw miyaba Xoossafe koyoosona.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Awi doliya wode guye simmoosona;","poem":1},{"text":"banta bessaa gelidi zin7oosona.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"He wode asi ba oosos keyees;","poem":1},{"text":"sa7i qammana gakanaw oothees.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Abeeti Godaw, ne oosoy ay mela daro;","poem":1},{"text":"ne cincatethan ne enta ubbaa medhadasa;","poem":2},{"lineBreak":true},{"text":"sa7i ne medhidaban kumis.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Heko, Abbay gitanne dalga;","poem":1},{"text":"tayboy bayna qaaxiya medhetethan,","poem":2},{"lineBreak":true},{"text":"gitatanne guutha medhetethan kumidi de7ees.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Iya bolla markabeti boosona;","poem":1},{"text":"ne medhida Leewataane geetetiya dawey iyan kaa7ees.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ne entaw koshshiya wodiyan","poem":1},{"text":"miyaba immana mela,","poem":2},{"lineBreak":true},{"text":"enti ubbay nena xeelloosona.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ne entaw immin enti maxoosona;","poem":1},{"text":"neeni ne kushiya miccin,","poem":2},{"lineBreak":true},{"text":"enti lo77oba kalloosona.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Neeni ne som7uwa genthiya wode dagammoosona;","poem":1},{"text":"neeni shempuwa ekiya wode hayqidi,","poem":2},{"lineBreak":true},{"text":"banta biitta simmoosona.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Shin neeni ne shempuwa immiya wode,","poem":1},{"text":"enti medhetoosona; biitta ooraxisaasa.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Godaa bonchoy merinaw de7o;","poem":1},{"text":"Goday ba oosuwan ufayto.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"I biitta xeelliya wode biittay qaaxees;","poem":1},{"text":"I dereta bochiya wode dereti cuyoosona.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ta de7o laytha ubban Godaas yexana;","poem":1},{"text":"ta paxa de7iya wode ubban ta Xoossaa zammarana.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Taani Godan ufaytiya gisho,","poem":1},{"text":"ta qofay iya ufayso.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Nagaranchoti biittafe dhayo;","poem":1},{"text":"iita ootheysati de7opo.","poem":2},{"text":"Ta shempe, Godaa galata;","poem":1},{"text":"Goday galatetto.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}