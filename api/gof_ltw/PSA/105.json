{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":105,"content":[{"type":"heading","content":["Xoossa Gita Oosuwa Odite"]},{"type":"verse","number":1,"content":["Godaa galatite; iya suntha xeegite;",{"text":"I oothidaba kawotethatas odite.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iya sabbite; galata mazmure yexite;","poem":1},{"text":"malaalsiya iya ooso ubbaa odite.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iya geeshsha sunthan ceeqite;","poem":1},{"text":"Godaa koyeyisata wozanay ufayto.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Godaanne iya wolqan ammanetite;","poem":1},{"text":"ubba wode iya koyite.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hinteno, iya aylliya Abrahaame zareto,","poem":1},{"text":"dooretida Yayqooba nayto,","poem":2},{"text":"I oothida malaalsiyabata,","poem":1},{"text":"iya malaatanne suure pirdaa hassayite.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I Godaa, nu Xoossaa;","poem":1},{"text":"iya pirday biitta ubbaa bollana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"I ba caaquwa merinaw,","poem":1},{"text":"ba gelida qaala mukulu yeleta gakanaw naagees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"I Abrahaamera caaqida ufaysa qaala,","poem":1},{"text":"Yisaaqas gelida ufaysa qaala,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yayqoobas woga,","poem":1},{"text":"Isra7eeles merinaa caaquwa","poem":2},{"lineBreak":true},{"text":"oothidi minthis.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"I, “Kanaane biitta new immana;","poem":1},{"text":"I ne kochaa gakida laata gidana” yaagis.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xoossa asati taybon guuthanne","poem":1},{"text":"Kanaane biittan bete asi gididi de7iya wode,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Issi deriyape hara deriya,","poem":1},{"text":"issi kawotethaafe hara kawotethi yuuyidosona.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Xoossay oonika enta un7ethana mela oothibeenna;","poem":1},{"text":"enta gisho kawota seeris.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“Ta tiyidaysata bochofite;","poem":1},{"text":"ta nabeta qohopite” yaagis.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Goday biittan kosha yeddidi,","poem":1},{"text":"enta kathaa ubbaa dhaysis.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Shin I ba asaa ashshanaw,","poem":1},{"text":"issi addiya Gibxe kiittis;","poem":2},{"lineBreak":true},{"text":"he uray aylle gididi bayzetida Yoosefa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Iya tohoti biratan duxetidosona;","poem":1},{"text":"I santhalaatan qashetis.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"I kase odidaysi tumattana gakanaw,","poem":1},{"text":"Godaa qaalay iya paacis.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hessafe guye Gibxe kawoy ase yeddidi,","poem":1},{"text":"iya qasho keethafe kessis.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Iya ba keethaa bolla godaa oothis;","poem":1},{"text":"baw de7iya ubbaa bolla shuumis.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ba moorinnata zorana mela,","poem":1},{"text":"ba cimata cincatethi tamaarsana mela shuumis.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Isra7eeley Gibxe bis;","poem":1},{"text":"Yayqoobi Kaama biittan uttis.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Goday ba asaa darsis;","poem":1},{"text":"enta morketape aathidi enta minthis.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ba asaa ixana mela Gibxe asaa wozanaa laammis;","poem":1},{"text":"ba aylleta cimmana mela oothis.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ba aylliya Musenne","poem":1},{"text":"ba doorida Aarona entako kiittis.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Enti Gibxe asaa sinthan malaata,","poem":1},{"text":"Kaama biittan malaalsiyaba oothidosona.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Goday dhumaa kiittidi, biitta dhumisis;","poem":1},{"text":"shin Gibxe asay iya kiita polibookona.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Enta haatha suuthi laammidi,","poem":1},{"text":"molota wodhis.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Enta biitta ubbaa,","poem":1},{"text":"kawo gadhoka shodhe kunthis.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"I kiittin, udunxenne biinne","poem":1},{"text":"enta biitta ubbaa bolla biinney wodhis.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ira gisho enta biitta bolla","poem":1},{"text":"shachi, dadanne wol7anthi bukisis.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"I enta woyniyanne balasiya shocis;","poem":1},{"text":"enta biittan de7iya mithaa mentherethis.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"I kiittin, booleynne","poem":1},{"text":"tayboy bayna duggoy keyis.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Enta biittan dolida katha ubbaa mis;","poem":1},{"text":"gaden de7iya cil7oba ubbaa dhaysis.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Goday Gibxe asaa bayra nayta ubbaa wodhis;","poem":1},{"text":"koyro yeletida ubbaa dhaysis.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Hessafe guye, Isra7eele asaa","poem":1},{"text":"worqanne bira alleeqora kessis;","poem":2},{"lineBreak":true},{"text":"enta kochaa giddofe guye attiday oonika baawa.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Gibxe asay entaw yayyida gisho,","poem":1},{"text":"enta kessan ufaytidosona.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Goday enta kammanaw shaara miccis;","poem":1},{"text":"qamma entaw poo7isanaw tama giigisis.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Enti miyaba oychida wode,","poem":1},{"text":"kuraacho daaniya kafota entaw yeddis;","poem":2},{"lineBreak":true},{"text":"enta salo kathi kalsis.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"I shuchaa phalqin, haathi pultis;","poem":1},{"text":"mela biittan shaafada goggis.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"I ba aylliya Abrahaames,","poem":1},{"text":"gelida geeshsha qaala hassayis.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"I ba asaa ufaysan,","poem":1},{"text":"ba dooridaysata ililsan kessis.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"I entaw allaga kawotethata biitta immis;","poem":1},{"text":"Harati daaburida goshsha laattidosona.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"I hessa oothiday enti iya wogaa","poem":1},{"text":"iya higgiya naagananne oothana melasa.","poem":2},{"lineBreak":true},{"text":"Goday galatetto!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/105.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/106.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/104.json","previousChapterAudioLinks":{},"numberOfVerses":44}