{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":106,"content":[{"type":"heading","content":["Xoossay Gita, Iya Galatite"]},{"type":"verse","number":1,"content":["Godaa galatite!",{"text":"I keeha gidiya gishonne","poem":1},{"text":"iya siiqoy merinaasa gidiya gisho,","poem":2},{"lineBreak":true},{"text":"Godaa galatite.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Goday oothida wolqaama ooso odanaw,","poem":1},{"text":"woyko iya galataa ubbaa qoncisanaw","poem":2},{"lineBreak":true},{"text":"danda7ey oonee?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pirdaa naageysatinne","poem":1},{"text":"ubba toho xillobaa ootheysati anjetidaasaata.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Abeeti Godaw, neeni ne asaas keehiya wode tana qopa;","poem":1},{"text":"enta neeni ashshiya wode tana alla.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hessika ne doorida asaa dichaa ta be7ana mela,","poem":1},{"text":"ne asaa ufaysan taani ufaytana melanne","poem":2},{"lineBreak":true},{"text":"ne asaara issife taani galatana melasa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nuuni nu aawatada nagara oothida;","poem":1},{"text":"nu balida; iitabaa oothida.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nu aawati Gibxen de7iya wode,","poem":1},{"text":"malaalsiya ne oosuwa qopibookona.","poem":2},{"text":"Ne siiquwa darotethaa enti hassaybookona;","poem":1},{"text":"Zo7o abba matan iya bolla makallidosona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gidoshin, I ba sunthaa gisho,","poem":1},{"text":"ba gita wolqaa erisanaw enta ashshis.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"I Zo7o abba kiittin, abbay melis;","poem":1},{"text":"mela biittara kanthidi aadhiyada,","poem":2},{"lineBreak":true},{"text":"ciimmo giddora enta kaalethidi pinthis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"I enta ixeyisata kushepe ashshis;","poem":1},{"text":"morketa kushepe enta wozis.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Enta morketa haathay mittis;","poem":1},{"text":"entafe issoyka attibeenna.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"He wode enti iya ufaysa qaala ammanidosona;","poem":1},{"text":"iya mazmuren sabboosona.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gidoshin, enti I oothidaba dogidosona;","poem":1},{"text":"I zoriya ogiya naagidi baanaw dosibookona.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mela biittan de7ishe daro amotidosona;","poem":1},{"text":"mela biittan Xoossaa paacidosona.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Enti woossidaysa I immis;","poem":1},{"text":"shin iita harge enta giddo kiittis.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mela biittan dunkaanen de7ishe Musenne","poem":1},{"text":"Godaas dummatida Aarona qanaatidosona.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Biittay dooyetidi Daatane mittis;","poem":1},{"text":"Abeero iya keetha asaara moogis.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Enta maabara giddon tami eexis;","poem":1},{"text":"lacoy he iita asata xuuggis.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Koreeba zuman worqafe","poem":1},{"text":"mara misile medhidosona;","poem":2},{"lineBreak":true},{"text":"he misiliya goyinnidosona.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Enti, banta boncho Xoossa","poem":1},{"text":"maata miya mehe misilen laammidosona.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Enti Gibxen gita ooso oothidanne","poem":1},{"text":"entana ashshida Xoossaa dogidosona.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kaama biittan oosetida malaalsiyabanne","poem":1},{"text":"Zo7o Abban hanida malaata oothidaasaa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hessa gisho, Xoossay enta dhaysana gis;","poem":1},{"text":"shin dhaysonna mela iya hanqo zaaranaw,","poem":2},{"lineBreak":true},{"text":"Xoossay doorida Musey giddon eqis.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Hessafe guye, enti","poem":1},{"text":"iya qaala ammanonna gisho,","poem":2},{"lineBreak":true},{"text":"he lo77o biitta kadhidosona.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Enti banta dunkaaniya giddon zuuzumidosona","poem":1},{"text":"Godaa qaalas kiitetibookona.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hessa gisho, I enta bazzon yegganaw,","poem":1},{"text":"ba kushiya denthidi caaqis.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Enta kochaa kawotethata giddon,","poem":1},{"text":"yegganawunne biitta bolla laallanaw caaqis.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Hessafe guye, enti Bi7eel-Fagoora eeqa goyinneysatara issife gahetidosona;","poem":1},{"text":"shempoy bayna eeqatas yarshetida yarshuwa midosona.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Banta oosuwan Godaa hanqethidosona;","poem":1},{"text":"hessa gaason enta giddon iita hargey wodhis.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Shin Pinihaasi dendidi,","poem":1},{"text":"enta nagaraa pirdin,","poem":2},{"lineBreak":true},{"text":"iita hargey enta bollafe kichis.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Hessika, iyaw, yeletethaafe yeletethaa gakanaw","poem":1},{"text":"merinaw xillotetha gididi taybetis.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Mariba pultuwa matan Godaa hanqethidosona;","poem":1},{"text":"enta gaason Muse bolla metoy gakis.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Enti iya yiloyidosona;","poem":1},{"text":"Muse doonape bessonna qaalay keyis.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Goday dhaysite gin,","poem":1},{"text":"enti Kanaane asata dhaysibookona.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"He palabaape, enti he asatara","poem":1},{"text":"walaketidosona;","poem":2},{"lineBreak":true},{"text":"enta de7o woga kaallidosona.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Xoossa asati enta eeqa goyinnidosona;","poem":1},{"text":"hessi entaw xihe gidis.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Enti banta addenne macca nayta","poem":1},{"text":"tuna ayyaanatas yarshidosona.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Enti xillo suuthu Kanaane eeqatas yarshidi,","poem":1},{"text":"banta addenne macca nayta suutha gussidosona;","poem":2},{"lineBreak":true},{"text":"he suuthan biittay tunis.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Hessada enti banta ooson tunidosona;","poem":1},{"text":"banta hanotan banta layma kessidosona.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Hessa gisho, Godaa hanqoy","poem":1},{"text":"iya asaa bolla eexis;","poem":2},{"lineBreak":true},{"text":"I ba laata shaatetis.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"I enta allaga kushen aathidi immis;","poem":1},{"text":"enta morketi enta haaridosona.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Enta morketi enta un7ethidosona","poem":1},{"text":"banta shenen enta aysidosona.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"I enta daro wode ashshis;","poem":1},{"text":"shin enti banta makalla aggonna ixidosona;","poem":2},{"lineBreak":true},{"text":"banta nagaraa gaason dhayidosona.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Gidoshin, I enta waasuwa si7is;","poem":1},{"text":"enta waayiya qopis.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"I enta gisho, ba ufaysa qaala hassayis;","poem":1},{"text":"ba siiquwa daruwan enta maaris.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Enta di77ida ubbay,","poem":1},{"text":"entaw qadhetana mela oothis.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Nuuni ne geeshsha sunthaa galatana mela","poem":1},{"text":"Abeeti Godaw, nu Xoossaw, nuna ashsha.","poem":2},{"text":"Ne bonchuwan nu ceeqetana mela,","poem":1},{"text":"kawotethata giddofe nuna shiisha.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Isra7eele Goday, Xoossay,","poem":1},{"text":"merinaape merinaa gakanaw galatetto!","poem":2},{"lineBreak":true},{"text":"Asa ubbay, “Amin7i” yaago.","poem":2},{"lineBreak":true},{"text":"Godaa galatite!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}