thida nagara gaason","poem":2},{"lineBreak":true},{"text":"banta iitatetha gaason metootidosona.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Enti kathi ixida gisho","poem":1},{"text":"hayqos gakidosona.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Enti metootida wode,","poem":1},{"text":"Godaako waassidosona;","poem":2},{"lineBreak":true},{"text":"I enta waayiyape enta ashshis.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"I ba qaala kiittidi enta pathis;","poem":1},{"text":"duufope enta ashshis.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Iya siiquwa gishonne","poem":1},{"text":"I entaw oothida malaalsiya oosuwa gisho","poem":2},{"lineBreak":true},{"text":"enti Godaa galato.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Enti iyaw galata yarsho shiisho;","poem":1},{"text":"ufaysa yethan iya oosuwa odo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Issoti issoti markaben abba bollara bidosona;","poem":1},{"text":"abba bolla banta oosuwa oothidosona.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Enti Godaa oosuwa be7idosona;","poem":1},{"text":"ciimmo abban oothida malaalsiyaba xeellidosona.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"I kiitida wode gotey dendis;","poem":1},{"text":"abba zuley qaaxis.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Enti pude dendidosona;","poem":1},{"text":"duge ciimmon wodhidosona;","poem":2},{"lineBreak":true},{"text":"iita metoy gakin enta wozanay til7is.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Enti mathotida asada","poem":1},{"text":"dhubetidi gandigaridosona;","poem":2},{"lineBreak":true},{"text":"enta eray maayis.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Enti metootida wode,","poem":1},{"text":"Godaako waassidosona;","poem":2},{"lineBreak":true},{"text":"I enta waayiyape enta ashshis.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"I gotiya si77i oothis;","poem":1},{"text":"abba beeta sirphi oothis.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Si77i gida gisho ufaytidosona;","poem":1},{"text":"enti koyida katamaa Goday gathis.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Iya siiquwa gishonne","poem":1},{"text":"I entaw oothida malaalsiya oosuwa gisho","poem":2},{"lineBreak":true},{"text":"enti Godaa galato.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Deriya shiiquwan iya gitatetha awaajo;","poem":1},{"text":"cimata duulatan iya galato.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Goday shaafata melisis;","poem":1},{"text":"pultoti goggonnaada teqis.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"He bessan de7iya asaa iitatethaa gisho,","poem":1},{"text":"aradda biitta quu7e kessis.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"I mela biittan haathe eelisis;","poem":1},{"text":"mela biittan pultoy dhuuqanaada oothis.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Koshatida asaa he bessan wothis;","poem":1},{"text":"bantaw daana katamaa yan keexidosona.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Enti banta goshshan zeridosona;","poem":1},{"text":"woyne tokidosona;","poem":2},{"lineBreak":true},{"text":"daro muruuto shiishidosona.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"I enta anjin enti daridosona;","poem":1},{"text":"enta mehiya taybuwa guuthibeenna.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Enti xoonetiya wodenne un7etiya wode,","poem":1},{"text":"metoninne azzanon kawuyiya wode,","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Goday enta halaqata kawushis;","poem":1},{"text":"mela biittan toylatana mela oothis.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Shin manqota metope kessis;","poem":1},{"text":"enta soo asaa dorsa wudeda darsis.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Suure asay 