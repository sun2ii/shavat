{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":108,"content":[{"type":"heading","content":["Xoossay Nu Bagga"]},{"type":"hebrew_subtitle","content":["Dawita Mazmure"]},{"type":"verse","number":1,"content":[{"text":"Ta wozanay minnidi de7ees;","poem":1},{"text":"abeeti Xoossaw, ta wozanay minnidi de7ees.","poem":2},{"lineBreak":true},{"text":"Ta new yexana; nena sabbana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta shempe, barka;","poem":1},{"text":"diithinne maasinqoy denda;","poem":2},{"lineBreak":true},{"text":"Ta wonta guura dendana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abeeti Godaw, ta nena asaa giddon galatana;","poem":1},{"text":"kawotethaa giddon nena sabbana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne merinaa siiqoy salope dhoqa;","poem":1},{"text":"ne ammanetethay shaarape dhoqa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abeeti Xoossaw, salope bollara ne dhoqu dhoqu ga;","poem":1},{"text":"ne bonchoy sa7a ubbaa bolla gido.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne doseysati attana mela,","poem":1},{"text":"ne ushacha kushen nuna ashsha;","poem":2},{"lineBreak":true},{"text":"neeni ta woosa si7a.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Xoossay ba geeshsha bessan haysada yaagis;","poem":1},{"text":"“Ta xoonada Seekema shaakana;","poem":2},{"lineBreak":true},{"text":"Sukota zangaara gishana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Galadinne Minaasey tabaa;","poem":1},{"text":"Efreemi ta huuphen wothiya uke;","poem":2},{"lineBreak":true},{"text":"Yihudi ta kawota xam7aa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Moo7abey ta meecetiya gabate;","poem":1},{"text":"Edoomey tabaa gideysa erisanaw","poem":2},{"lineBreak":true},{"text":"ta caammaa iya bolla wothana.","poem":2},{"lineBreak":true},{"text":"Filisxeeme xoonada gereerana” yaagis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Godaw, gimbetida katamaako, tana efanay oonee?","poem":1},{"text":"Edoome gakanaw tana kaalethanay oonee?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abeeti Xoossaw, nuna aggiday nena gidikii?","poem":1},{"text":"Abeeti Xoossaw, ne nu tooranchotara olas keyaka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Asa maadoy pathenna gisho,","poem":1},{"text":"morkiya olanaw ne nuna maadda.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Xoossaa wolqan nu morketa xoonana;","poem":1},{"text":"nu morketa kawushanay iya.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}