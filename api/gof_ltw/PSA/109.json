{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":109,"content":[{"type":"heading","content":["Ta Xoossaw Tana Ashsha"]},{"type":"hebrew_subtitle","content":["Dawita Mazmure"]},{"type":"verse","number":1,"content":["Abeeti ta nena galatiya Xoossaw,",{"text":"ne taw si77i goopa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iita asatinne wordanchoti,","poem":1},{"text":"banta doona ta bolla dooyidosona;","poem":2},{"lineBreak":true},{"text":"banta wordo inxarsan ta bolla haasayoosona.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ixon ta yuushuwa teqidosona;","poem":1},{"text":"gaasoy bayna tana olidosona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ta enta dosaysinne entaw woossayis;","poem":1},{"text":"gidoshin, enti tana mootosona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ta lo77o oothin, taw iita zaarosona;","poem":1},{"text":"ta enta dosin, enti tana ixoosona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ta morkiya bolla iita daynna shuuma;","poem":1},{"text":"mootanchoy iya ushachan eqo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iya pilgiya wode I bala gididi bento;","poem":1},{"text":"iya woosay iyaw gome gido.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iya laythay qaammo;","poem":1},{"text":"iya shuumatetha hari eko.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iya nayti yi7o gido;","poem":1},{"text":"iya machiya am7o gido.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iya nayti woosancho gididi toylato;","poem":1},{"text":"banta de7iya humpa keethaafe goodeto.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Iya shalo ubbaa acoy oyko;","poem":1},{"text":"I daaburidi kessidaba ubba allagi bonqo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Oonika iyaw keehopo;","poem":1},{"text":"iya naytas qadhetiya asi bentofo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Iya nayti ubbay hayqidi wuro;","poem":1},{"text":"kaalliya yeletethan iya sunthay dogeto.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iya aawata nagaray Godaa sinthan qofeto;","poem":1},{"text":"iya aaye nagaray qushetofo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Goday enta nagara ubba wode qopo;","poem":1},{"text":"enti sa7a bolla hassayetofo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"I keeha oothanaw polo qopibeenna;","poem":1},{"text":"manqota, metootanchota,","poem":2},{"lineBreak":true},{"text":"qohetidaysata gooddidi wodhis.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"I baaddanaw dosida gisho,","poem":1},{"text":"I baadetidaysa gido.","poem":2},{"lineBreak":true},{"text":"I anjanaw dosonna gisho,","poem":2},{"lineBreak":true},{"text":"iya anjoy iyape haakis.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Baadethi iya afilada ma7is;","poem":1},{"text":"iya baadethi haathada iya bolla laakisis;","poem":2},{"lineBreak":true},{"text":"zayteda iya meqethaa giddo gelo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Afilada iya kammo;","poem":1},{"text":"dancoda ubba wode iya xeessan de7o.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ha tana mooteysanne","poem":1},{"text":"ta bolla iita odeteyisata","poem":2},{"lineBreak":true},{"text":"Goday hessada oothidi seero.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Shin abeeti Ubbaa Haariya Godaw,","poem":1},{"text":"ne suntha gisho tana maadda.","poem":2},{"text":"Ne merinaa siiquwanne","poem":1},{"text":"ne keehatetha gisho tana ashsha.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Taani manqonne metootancho asi;","poem":1},{"text":"ta wozanay madunxis.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ta omarsa kuyada dhayana hanayis;","poem":1},{"text":"ta booleda qoqofetas.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Xooman ta gulbatay daaburis;","poem":1},{"text":"ta asatethay laafin meqethi attis.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Tana mooteysatas qelqisethas attas;","poem":1},{"text":"tana be7idi, banta huuphiya qaathosona.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Abeeti Godaw ta Xoossaw, tana maadda;","poem":1},{"text":"merinaa ne siiquwada tana ashsha.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ne kushey haysa oothidaysanne,","poem":1},{"text":"ne haysa oothidaysa ta morketi ero.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Enti tana baaddoosona, shin ne tana anjana;","poem":1},{"text":"tana gooddeysati yeellato; shin ne tana ufaysa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Tana mooteysati yeella ma7o;","poem":1},{"text":"banta kawushaa afilada ma7o.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Taani ta inxarsan Godaa galatana;","poem":1},{"text":"deriya shiiquwan iya sabbana.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"I manqota gisho mootetees;","poem":1},{"text":"hayqos pirdetidaysata ashshees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}