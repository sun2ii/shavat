{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":110,"content":[{"type":"heading","content":["Xoossay Ta Miyena"]},{"type":"hebrew_subtitle","content":["Dawita mazmure"]},{"type":"verse","number":1,"content":["Goday ta godaa, “Ta ne morketa ne tohoy",{"text":"yedhiya bessi oothana gakanaw,","poem":2},{"lineBreak":true},{"text":"haysan taape ushacha baggan utta” yaagis.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Godaw ne minotetha xam7a Xiyoonepe yedda;","poem":1},{"text":"“Ne morketa haara” yaagana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne haariya gallas ne derey dosidi new haaretana;","poem":1},{"text":"ne geeshsha ma7uwa ma7ada,","poem":2},{"lineBreak":true},{"text":"wonta xalqeda ne kumetha wolqan phoolana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Goday, “Malkexaadeqi kahine gididaysada,","poem":1},{"text":"ne merinaw kahine gidana” yaagidi caaqis;","poem":2},{"lineBreak":true},{"text":"iya caaqoy laametenna.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Goday ne ushachan de7ees;","poem":1},{"text":"ba hanquwa gallas kawota tincherethana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I kawotethata bolla pirdana;","poem":1},{"text":"ola denbata aha xalaala oothana;","poem":2},{"lineBreak":true},{"text":"biitta ubban de7iya kawota dhaysana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kawoy oge lanqen de7iya pultuwafe uyidi,","poem":1},{"text":"I ba huuphiya dhoqu oothana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}