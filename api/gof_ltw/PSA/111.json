{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":111,"content":[{"type":"heading","content":["Xoossa Galatite"]},{"type":"verse","number":1,"content":["Godaa galatite;",{"text":"Suureta shiiqon","poem":2},{"lineBreak":true},{"text":"ta kumetha wozanan Godaa galatana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Godaa oosoti ay mela gite!","poem":1},{"text":"Entan ufaytiya ubbay enta qopees.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iya oosoti bonchoninne teeman kumis;","poem":1},{"text":"iya xillotethay merinaw de7ees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iya malaalsiya oosoy hassayetishe daanada oothis;","poem":1},{"text":"I keehanne qadhetiya Godaa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Baw yayyeysatas kathi immees;","poem":1},{"text":"ba caaqo qaala merinaw baletenna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Allagata biitta ba asaas aathidi immidi,","poem":1},{"text":"ba gita wolqaa ba asaa bessis.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iya kushe oosoti tumanne suure;","poem":1},{"text":"iya woga ubbay ammanetidaysa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Enti merinaw eqidi de7oosona;","poem":1},{"text":"tumatethaninne suuretethan imetidosona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"I ba asaa wozis;","poem":1},{"text":"caaqo entara merinaw essis;","poem":2},{"lineBreak":true},{"text":"iya sunthay geeshshinne yashsheysa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Cincatethas koyroy Godaas yashshi;","poem":1},{"text":"iya wogaa naageysatas lo77o akeeki de7ees.","poem":2},{"lineBreak":true},{"text":"Goday merinaw galatetto!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}