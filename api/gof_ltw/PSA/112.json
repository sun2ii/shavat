{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":112,"content":[{"type":"heading","content":["Xilloy Qaaxenna"]},{"type":"verse","number":1,"content":["Godaa galatite;",{"text":"Godaas yayeysinne","poem":2},{"lineBreak":true},{"text":"iya kiita naageysi anjetidaysa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iya nayti biittan wolqaama gidana;","poem":1},{"text":"suure asaa yeletay anjetana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Shaloynne duretethi iya keethan de7ees;","poem":1},{"text":"iya xillotethay merinaw daana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Keeha, xillonne qadhetiya asas,","poem":1},{"text":"dhuma giddon poo7oy poo7ees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Keehatethan coo tal7iya uraas,","poem":1},{"text":"ba oosuwa suuretethan oothiya uraas","poem":2},{"lineBreak":true},{"text":"keehabay yaana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xillo asi awudeka kundenna;","poem":1},{"text":"I merinaw hassayetana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iya wozanay hirgonna gishonne","poem":1},{"text":"I Godan ammanetiya gisho,","poem":2},{"lineBreak":true},{"text":"iitabaa si7ikoka I dagammenna;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iya wozanay mino gidiya gisho yayyenna;","poem":1},{"text":"wursethan iya morketi xoonetin be7ana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"I manquwas darsidi immees;","poem":1},{"text":"iya xillotethay merinaw de7ees;","poem":2},{"lineBreak":true},{"text":"iya kacey bonchon dhoqu dhoqu gaana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iita asi hessa be7idi yilotees;","poem":1},{"text":"mettershe saxishe coo dhayees;","poem":2},{"lineBreak":true},{"text":"iita asa amoy coo attana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}