{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":114,"content":[{"type":"heading","content":["Iya Sinthan Yashshan Kokorite"]},{"type":"verse","number":1,"content":[{"text":"Isra7eele asay Gibxe biittafe keyida wode,","poem":1},{"text":"Yayqooba sheeshay allaga qaalan,","poem":2},{"lineBreak":true},{"text":"haasaya asaa aggidi bida wode,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yihuda asay Godaas geeshsha asi gidis;","poem":1},{"text":"Isra7eele asay iyaw haaretis.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abbay hessa be7idi baqatis;","poem":1},{"text":"Yordaanose shaafay guye simmis.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dereti deeshada gupidosona;","poem":1},{"text":"zumati dorsa marada dozgidosona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abbaw, ne ayis baqatadii?","poem":1},{"text":"Yordaanose, ne ayis guye simmadii?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dereto, deeshada ayis gupidetii?","poem":1},{"text":"zumato, dorsada ayis dozgidetii?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Neno biittaw, Godaa sinthan,","poem":1},{"text":"Yayqooba Xoossaa sinthan kokora.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"I zaalla eele haathi kessees;","poem":1},{"text":"mino zaalla haatha pulto oothees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}