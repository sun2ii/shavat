{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":115,"content":[{"type":"heading","content":["Nu Xoossay Dumma"]},{"type":"verse","number":1,"content":[{"text":"Abeeti Godaw, nu gisho gidonashin,","poem":1},{"text":"ne siiquwanne ne ammanetetha gisho,","poem":2},{"lineBreak":true},{"text":"ne sunthaa boncha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ayis kawotethati,","poem":1},{"text":"“Enta Xoossay awunee?” yaaganee?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nu Xoossay salon de7ees;","poem":1},{"text":"ba dosidaba ubbaa oothees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Shin enta eeqati ase kushen oosetidosona;","poem":1},{"text":"enti birapenne worqafe medhetidosona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Entaw dooni de7ees, shin haasayokona;","poem":1},{"text":"ayfey de7ees, shin xeellokona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Entaw haythi de7ees, shin si7okona;","poem":1},{"text":"siidhey de7ees, shin singokona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Entaw kushey de7ees, shin bochi erokona;","poem":1},{"text":"tohoy de7ees, shin hemetokona;","poem":2},{"lineBreak":true},{"text":"enta siixinathara kooshinchi keyenna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Enta medheysatinne","poem":1},{"text":"enta ammaneteysati enta mela gido.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isra7eele asaw, Godan ammanetite;","poem":1},{"text":"hintena maaddeynne hinte gondalley iya.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Aarona keetha asaw, Godan ammanetite;","poem":1},{"text":"hintena maaddeynne hinte gondalley iya.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Godaas yayyeysato, Godan ammanetite;","poem":1},{"text":"hintena maaddeynne hinte gondalley iya.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Goday nuna qopees; I nuna anjana;","poem":1},{"text":"I Isra7eele asaa anjana;","poem":2},{"lineBreak":true},{"text":"I Aarona keetha asaa anjana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Godaas yayyeyisata,","poem":1},{"text":"guuthaa gita anjana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Goday hintena darso;","poem":1},{"text":"hintenanne hinte nayta anjo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Saluwanne sa7aa medhida","poem":1},{"text":"Goday hintena anjo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Saloy Xoossaba;","poem":1},{"text":"shin sa7a asas immis.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hayqidaysati Godaa galatokonna;","poem":1},{"text":"duufon zin7idaysati iya sabbokona.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Shin nuuni, de7on de7eysati,","poem":1},{"text":"hachife merinaa gakanaw,","poem":2},{"lineBreak":true},{"text":"Godaa galatoos.","poem":2},{"lineBreak":true},{"text":"Godaa galatite.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}