{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":116,"content":[{"type":"heading","content":["Hayqope Attida Asa Galata"]},{"type":"verse","number":1,"content":["Goday ta waasuwanne ta woosa si7ida gisho,",{"text":"taani iya dosayis.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"I ba haytha taako zaarida gisho,","poem":1},{"text":"ta de7o laytha ubban iya xeegana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hayqoy xiheda tana teqis;","poem":1},{"text":"duufo hirgay tana oykis;","poem":2},{"lineBreak":true},{"text":"un7inne metoy tana qachis.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"He wode, “Abeeti Godaw, tana ashsha”","poem":1},{"text":"yaagada Godaa suntha xeegas.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Goday keehanne xillo;","poem":1},{"text":"nu Xoossay qadhetees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Goday ashketa naagees;","poem":1},{"text":"ta metootida wode tana ashshis.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Goday new keeha gidiya gisho,","poem":1},{"text":"hiza ta shempe, wopu ga.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Goday ta shempuwa hayqope,","poem":1},{"text":"ta ayfiya afuthafe,","poem":2},{"lineBreak":true},{"text":"ta tohuwa dhubepe ashshis.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Taani de7on de7eyisata giddon,","poem":1},{"text":"Godaa sinthan hemetayis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Taani, “Daro waayetas” gida wode,","poem":1},{"text":"ta ammanuwa aggabike.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Taw sa7i haddirida wode,","poem":1},{"text":"“Asi ubbay wordancho” yaagas.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"I taw keehida keehatetha gisho","poem":1},{"text":"Godaas ay qanxanaw danda7iyana?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Goday tana ashshida gisho galatana,","poem":1},{"text":"xuu7a woyne ushsha yarsho oothada shiishana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iya asaa ubbaa sinthan","poem":1},{"text":"ta qangetha Godaas gathana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Geeshshata hayqoy","poem":1},{"text":"Godaa sinthan, daro al7o.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Abeeti Godaw, taani ne aylle;","poem":1},{"text":"taani ne aylle, ne gadhinde na7aa;","poem":2},{"lineBreak":true},{"text":"tana qashope ne birshadasa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Godaw, ta galata yarsho new yarshana;","poem":1},{"text":"ne sunthaa xeegana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Asa ubbaa sinthan","poem":1},{"text":"ta qangetha Godaas gathana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yerusalaamen de7iya Xoossa keethaa dabaaban,","poem":1},{"text":"ta qangetha gathana.","poem":2},{"lineBreak":true},{"text":"Godaa galatite.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}