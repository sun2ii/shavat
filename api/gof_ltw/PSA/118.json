{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":118,"content":[{"type":"heading","content":["Iya Siiqoy Merinaasa"]},{"type":"verse","number":1,"content":["Goday keeha gidiya gisho galatite;",{"text":"iya siiqoy merinaasa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Isra7eele asay,","poem":1},{"text":"“Iya siiqoy merinaasa” yaago.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Aarona keetha asay,","poem":1},{"text":"“Iya siiqoy merinaasa” yaago.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Godaas yayiya ubbay,","poem":1},{"text":"“Iya siiqoy merinaasa” yaago.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ta un7etida wode Godaako waassas;","poem":1},{"text":"I ta waasuwa si7idi tana la77a kessis.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Goday taara de7iya gisho ta yayyike;","poem":1},{"text":"asi tana ay oothanee?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Goday tana maaddanaw taara de7ees;","poem":1},{"text":"ta morketa xoonetethaa ta be7ana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Asan ammanetanape","poem":1},{"text":"Godan geemmidi atteysi lo77o.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gita asan ammanetanape","poem":1},{"text":"Godan geemmidi atteysi lo77o.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kawotethati ubbay tana teqidi oykidosona;","poem":1},{"text":"shin Godaa sunthan ta enta xoonas.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Enti ta yuushuwa teqidosona;","poem":1},{"text":"shin Godaa sunthan ta enta xoonas.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Enti ta yuushuwa mathada teqidosona;","poem":1},{"text":"Shin buurey taman eexeysada eexidi dhayidosona;","poem":2},{"lineBreak":true},{"text":"Godaa sunthan ta enta dhaysas.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Taani sugetada kundanaw gakas;","poem":1},{"text":"shin Goday tana maaddis.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Goday ta minotethaanne yethaa;","poem":1},{"text":"I tana ashsheysa gidis.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Xillota dunkaaniyan ola xoonidi,","poem":1},{"text":"simmiya asaa ufaysas giyaba si7ite;","poem":2},{"lineBreak":true},{"text":"Godaa ushacha kushey gitaba oothis.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Godaa ushacha kushey xoono immis;","poem":1},{"text":"Godaa ushacha kushey gitaba oothis.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Taani hayqike; de7on daana;","poem":1},{"text":"Goday oothidaba awaajana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Goday tana iita seera seeris;","poem":1},{"text":"shin hayqos aathidi immibeenna.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Taani gido gelada Godaa galatana mela,","poem":1},{"text":"xillotetha pengeta taw dooyite.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Haysi Godaa penge;","poem":1},{"text":"xilloti iyara geloosona.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Godaw, ne tana si7ida gishonne","poem":1},{"text":"taw xoono immida gisho ta nena galatayis.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Gimbeysati kadhidi yeggida shuchay,","poem":1},{"text":"godaa xaphuwa minthiya shuchu gidis.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Haysi Godaa ooso;","poem":1},{"text":"nu ayfiyas malaalsiyaba.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Haysi gallasay Goday oothida gallas;","poem":1},{"text":"ane nuuni iyan ufaytoosinne ililoos.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Godaw, ha77i nuna ashsha;","poem":1},{"text":"Godaw, ha77i nuus injeya.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Godaa sunthan yaa asi anjetidaysa gido;","poem":1},{"text":"nuuni Xoossa keethaafe hintena anjoos.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Goday Xoossaa; I nu bolla poo7isis;","poem":1},{"text":"yarsho bessan de7iya kaciyako keyite;","poem":2},{"lineBreak":true},{"text":"irxa tashe oykidi ba7aale bonchite.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Neeni ta Xoossaa; ta nena galatana;","poem":1},{"text":"neeni ta Xoossaa; ta nena sabbana.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Goday keeha gidiya gisho iya galatite;","poem":1},{"text":"iya siiqoy merinaasa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}