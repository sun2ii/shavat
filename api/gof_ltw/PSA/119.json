{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":119,"content":[{"type":"heading","content":["Ne Higgey Ta Tohuwas Poo7o"]},{"type":"verse","number":1,"content":["Banta ogiyan borey baynaysatinne",{"text":"Godaa wogaada hemeteysati anjetidaysata.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iya kiitaa naageysatinne","poem":1},{"text":"banta kumetha wozanan","poem":2},{"lineBreak":true},{"text":"iya koyeysati anjetidaysata.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Enti bala oothidi erokona;","poem":1},{"text":"Godaa ogiyan hemetoosona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne kiita ammanetidi naagana mela,","poem":1},{"text":"neeni nuna kiittadasa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne wogaa naagada","poem":1},{"text":"ta ogey minnana mela koyayis.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne kiita ubbaa akeekada,","poem":1},{"text":"ta polo yeellatike.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne xillo pirdaa ta tamaarida wode,","poem":1},{"text":"ta nena suure wozanan galatana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ta ne higgiya naagana;","poem":1},{"text":"tana polo yeggofa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yalagay ba ogiya waatidi,","poem":1},{"text":"geeshshatethan naaganaw danda7ii?","poem":2},{"lineBreak":true},{"text":"Ne qaala kiitetiko danda7ees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta kumetha wozanan nena koyas;","poem":1},{"text":"ne kiitaape kare keyonnaada tana naaga.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Taani ne bolla nagara oothonna mela","poem":1},{"text":"ne qaala ta wozanan qosas.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abeeti Godaw, ne galateta;","poem":1},{"text":"ne awaajuwa tana tamaarsa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ne doonape keyiya pirda ubbaa","poem":1},{"text":"taani ta inxarsan odana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Duretethan ufayteysafe aathada,","poem":1},{"text":"ta ne higgiyan ufaytayis.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ne wogata zaara zaarada qopayis","poem":1},{"text":"ne ogiya loythada akeekayis.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Taani ne higgiyan ufaytayis;","poem":1},{"text":"ne qaala dogike.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Taani de7on daana melanne ne qaala kiitetana mela","poem":1},{"text":"taw ne aylliyas lo77oba ootha.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ne higgiyan de7iya malaalsiya tumatethaa","poem":1},{"text":"ta be7ana mela ta ayfiya dooya.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Taani ha sa7an imathe;","poem":1},{"text":"ne kiita taape genthofa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ta shempiya ubba wode","poem":1},{"text":"ne pirdaa laamotashe hayqasu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Otoreyisata, baadetidaysatanne,","poem":1},{"text":"ne kiitaape kare keyeyisata ne seerasa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Taani neeni odidaysa oothida gisho,","poem":1},{"text":"enta cashshaanne boriya ta bollafe digga.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hari attoshin halaqati shiiqidi,","poem":1},{"text":"ta bolla maqetikoka,","poem":2},{"lineBreak":true},{"text":"taani, ne oosanchoy,","poem":2},{"lineBreak":true},{"text":"ne awaajuwa zaara zaarada qopana.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ne markatethay tana ufaysees;","poem":1},{"text":"I tana zorees.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Taani hayqana hanayis;","poem":1},{"text":"ne gida qaalada tana ashsha.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Taani ta ogiyaba new odin,","poem":1},{"text":"ne tana si7adasa;","poem":2},{"lineBreak":true},{"text":"hiza ne awaajuwa tana tamaarsa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ne wogaa tana akeekisa;","poem":1},{"text":"malaalsiya oosuwa","poem":2},{"lineBreak":true},{"text":"taani zaara zaarada qopana.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Azzanoy darida gisho ta shempoy daaburis;","poem":1},{"text":"neeni gida qaalada tana minthetha.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Wordo oge taape haassa;","poem":1},{"text":"ne keehatethan ne higgiya tana tamaarsa.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Taani tuma oge dooras;","poem":1},{"text":"ne pirdaa hayzas.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Abeeti Godaw, ta ne higgiya minthada oykas;","poem":1},{"text":"hiza tana yeellayopa!","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ta wozanaa la77a kessida gisho,","poem":1},{"text":"taani ne higgiya ogiyan woxayis.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Abeeti Godaw,","poem":1},{"text":"ne awaajuwa birshethaa tana tamaarsa;","poem":2},{"lineBreak":true},{"text":"taani wursethi gakanaw iya naagana.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Taani ne higgiya naagana malanne","poem":1},{"text":"ta kumetha wozanaape iyaw kittaatan mela,","poem":2},{"lineBreak":true},{"text":"ne taw akeeka imma.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Taani iyan ufaytiya gisho,","poem":1},{"text":"ne kiita ogiyan tana kaaletha;","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ta wozanaa amuwako gidonashin,","poem":1},{"text":"ne higgiyako tana zaara.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Pathonnaba xeellonna mela,","poem":1},{"text":"ta ayfeta teqa;","poem":2},{"lineBreak":true},{"text":"ne ogiyan ta de7uwa ooraxisa.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"New yayyana mela,","poem":1},{"text":"ne gelida qaala, taw ne aylliyas, pola.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Tana yashshiya cashsha taape digga;","poem":1},{"text":"ne pirday ay mela lo77o!","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Taani ne wogaa naaganaw amottayis;","poem":1},{"text":"neeni xillo gidiya gisho,","poem":2},{"lineBreak":true},{"text":"ta de7uwa ooraxisa.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Abeeti Godaw, ne siiquwa tana bessa;","poem":1},{"text":"neeni gelida qaalada tana ashsha.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Taani ne qaalan ammanetiya gisho,","poem":1},{"text":"tana cayeyisata zaaranaw danda7ayis.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Taani ne pirda ufaysi oothida gisho,","poem":1},{"text":"ta inxarsaafe tumatethaa qaala dhaysofa.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Taani merii merinaw","poem":1},{"text":"ne higgiya kiitetana.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Taani ne woga poliya gisho,","poem":1},{"text":"aahon hemetana.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Taani kawota sinthan eqada,","poem":1},{"text":"neeni gidaba odashe yeellatike.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Taani ne kiitata dosayis,","poem":1},{"text":"entan ufaytayis.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Taani dosiya ne kiita bonchayis;","poem":1},{"text":"ne awaajuwa zaara zaarada qopana.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Neeni taw, ne aylliyas,","poem":1},{"text":"immida qaala qopa;","poem":2},{"lineBreak":true},{"text":"ne qaalan taani ufaysi oothayis.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Ne qaalay tana de7on wothees;","poem":1},{"text":"I meto wode tana minthethees.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Otoranchoti tana likefe aathidi cayoosona;","poem":1},{"text":"shin taani ne higgiyafe sher7i giike.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"Abeeti Godaw,","poem":1},{"text":"benipe de7iya ne pirda taani hassayayis;","poem":2},{"lineBreak":true},{"text":"hessan taani minettayis.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Iitati ne higgiya kiitetonaysa be7in,","poem":1},{"text":"tana yiloy wodhis.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"Taani de7iya allaga biittan","poem":1},{"text":"ne awaajoy taw yethi gidis.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Abeeti Godaw,","poem":1},{"text":"taani qamma ne suntha qopayis;","poem":2},{"lineBreak":true},{"text":"ne higgiya naagayis.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Ta Ne woga naagana;","poem":1},{"text":"I taw ooso gidis.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Abeeti Godaw, ta saamay nena;","poem":1},{"text":"ta ne higgiya naaganaw qanxas.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Ta kumetha wozanan nena woossayis;","poem":1},{"text":"ne gelida qaalada taw qadheta.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Taani ta ogiya akeeka xeellada,","poem":1},{"text":"ne higgiya kaallanaw simmas.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Taani ne kiita naaganaw,","poem":1},{"text":"eesotanaape attishin, gam7ike.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"Iitati taw xihe yeggikoka,","poem":1},{"text":"taani ne higgiya dogike.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"Ne xillo pirda gisho, nena galatanaw,","poem":1},{"text":"taani gidi bilahe dendayis.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Taani new yayyeyisata ubbaasinne","poem":1},{"text":"ne wogaa naageysata dabbo.","poem":2}]},{"type":"verse","number":64,"content":[{"text":"Abeeti Godaw, sa7i ne siiquwan kumis;","poem":1},{"text":"ne awaajuwa tana tamaarsa.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"Abeeti Godaw, ne gelida qaalada","poem":1},{"text":"taw ne aylliyas keehaba oothadasa.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Taani ne kiitatan ammanetiya gisho,","poem":1},{"text":"lo77o pirdanne eratethi tana tamaarsa.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"Taani seeretanaape kase kare hemetas;","poem":1},{"text":"shin ha77i ne qaalas kiitetayis.","poem":2}]},{"type":"verse","number":68,"content":[{"text":"Neeni keeha; neeni keehaba oothaasa;","poem":1},{"text":"ne awaajuwa tana tamaarsa.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"Otoranchoti ta sunthaa wordon iissoosona;","poem":1},{"text":"shin ta ne wogaa ta kumetha wozanan naagana.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"Enta wozanay kumthi doccis;","poem":1},{"text":"shin taani ne higgiyan ufaytayis.","poem":2}]},{"type":"verse","number":71,"content":[{"text":"Ne higgiya tamaarana mela","poem":1},{"text":"ne tana seeridaysi taw lo77o gidis.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"Daro worqafenne birape,","poem":1},{"text":"ne doonape keyiya higgey taw aadhees.","poem":2}]},{"type":"verse","number":73,"content":[{"text":"Tana ne kushey medhis; ne kushey giigisis;","poem":1},{"text":"ne kiita tamaarana mela taw akeeka imma.","poem":2}]},{"type":"verse","number":74,"content":[{"text":"Taani ne qaalan ufaysi oothida gisho,","poem":1},{"text":"nena boncheysati tana be7idi ufayto.","poem":2}]},{"type":"verse","number":75,"content":[{"text":"Abeeti Godaw, ne pirday xillo gideysa eras;","poem":1},{"text":"ne tana seeriday ammanetethan gideysa ta akeekas.","poem":2}]},{"type":"verse","number":76,"content":[{"text":"Taw ne aylliyas gida qaalada,","poem":1},{"text":"ne siiqoy tana minthetho.","poem":2}]},{"type":"verse","number":77,"content":[{"text":"Ne higgey tana ufaysiya gisho,","poem":1},{"text":"taani de7on daana mela taw qadheta.","poem":2}]},{"type":"verse","number":78,"content":[{"text":"Otoranchoti tana wordon mootiya gisho yeellato;","poem":1},{"text":"taani ne wogaa zaara zaarada qopayis.","poem":2}]},{"type":"verse","number":79,"content":[{"text":"New yayyeysatinne","poem":1},{"text":"ne markatethaa ereysati taako yo.","poem":2}]},{"type":"verse","number":80,"content":[{"text":"Ta yeellatonna mela,","poem":1},{"text":"ta wozanay ne higgiyan borey baynaysa gido.","poem":2}]},{"type":"verse","number":81,"content":[{"text":"Neeni tana ashshana mela,","poem":1},{"text":"taani naagashe daaburas;","poem":2},{"lineBreak":true},{"text":"taani ne qaalan ufaysi oothayis.","poem":2}]},{"type":"verse","number":82,"content":[{"text":"Neeni gida qaalay poletin","poem":1},{"text":"be7anaw naagishin ta ayfey teljumis.","poem":2},{"lineBreak":true},{"text":"“Ne tana awude minthethane” yaagas.","poem":2}]},{"type":"verse","number":83,"content":[{"text":"Cuyan kaqetida ogoroda gundas;","poem":1},{"text":"gidoshin ne awaajuwa balabiike.","poem":2}]},{"type":"verse","number":84,"content":[{"text":"Taani ne aylley awude gakanaw naago?","poem":1},{"text":"Tana yedetheyisata ne awude pirdanee?","poem":2}]},{"type":"verse","number":85,"content":[{"text":"Ne higgiya naagonna otoranchoti","poem":1},{"text":"tana oykanaw olla bookosona.","poem":2}]},{"type":"verse","number":86,"content":[{"text":"Ne kiita ubbay ammantheyisata;","poem":1},{"text":"gaasoy bayna asay tana yedethiya gisho","poem":2},{"lineBreak":true},{"text":"tana maadda.","poem":2}]},{"type":"verse","number":87,"content":[{"text":"Enti tana wodhi diggidi aggidosona;","poem":1},{"text":"shin ta ne wogaa aggabike.","poem":2}]},{"type":"verse","number":88,"content":[{"text":"Ne siiquwan ta de7uwa naaga;","poem":1},{"text":"ta ne kiitaa naagana.","poem":2}]},{"type":"verse","number":89,"content":[{"text":"Abeeti Godaw, ne qaalay merinaasa;","poem":1},{"text":"I salon minnidi de7ees.","poem":2}]},{"type":"verse","number":90,"content":[{"text":"Yeletape yeletaa gakanaw ne ammanetaasa;","poem":1},{"text":"ne ha sa7aa minthada essadasa; ika minnidi de7ees.","poem":2}]},{"type":"verse","number":91,"content":[{"text":"Ubbay ne aylle gidiya gisho,","poem":1},{"text":"hachi gakanaw ubbay ne kiittada minnidi de7ees;","poem":2}]},{"type":"verse","number":92,"content":[{"text":"Ne higgey tana ufaysonnaba gidiyako,","poem":1},{"text":"ta waayan ta dhayanashin.","poem":2}]},{"type":"verse","number":93,"content":[{"text":"Taani ne wogaa kumethi dogike;","poem":1},{"text":"neeni iyan tana de7on wothadasa.","poem":2}]},{"type":"verse","number":94,"content":[{"text":"Taani nebaa gidiya gisho tana ashsha;","poem":1},{"text":"taani ne wogaa naaganaw koyayis.","poem":2}]},{"type":"verse","number":95,"content":[{"text":"Iitati tana dhaysanaw zugidi naagoosona;","poem":1},{"text":"shin taani neena qopayis.","poem":2}]},{"type":"verse","number":96,"content":[{"text":"Polo geetetidaba ubbaas zawi de7eysa ta be7as;","poem":1},{"text":"shin polo gidida higgiyas zawi baawa.","poem":2}]},{"type":"verse","number":97,"content":[{"text":"Taani ne higgiya waanada dosiyana!","poem":1},{"text":"kumetha gallas taani iya qopayis.","poem":2}]},{"type":"verse","number":98,"content":[{"text":"Ne kiitay ubba wode taara de7iya gisho,","poem":1},{"text":"ta morketape aathidi tana akeeka kessoosona.","poem":2}]},{"type":"verse","number":99,"content":[{"text":"Taani nee higgiya qopiya gisho,","poem":1},{"text":"ta astamaaretape aadhida cincatethi taw de7ees.","poem":2}]},{"type":"verse","number":100,"content":[{"text":"Taani ne wogaa kiitetiya gisho,","poem":1},{"text":"cimatape aathada akeekayis.","poem":2}]},{"type":"verse","number":101,"content":[{"text":"Taani ne qaala kiitetanaw koyiya gisho,","poem":1},{"text":"ta tohuwa iita oge ubbaafe naagas.","poem":2}]},{"type":"verse","number":102,"content":[{"text":"Neeni tana tamaarsida gisho,","poem":1},{"text":"ta ne higgiyafe gaxa keyike.","poem":2}]},{"type":"verse","number":103,"content":[{"text":"Ne qaalay waanidi mal7i!","poem":1},{"text":"ililo eessafe aadhidi mal7ees.","poem":2}]},{"type":"verse","number":104,"content":[{"text":"Ne wogaape akeeka demmas;","poem":1},{"text":"hessa gisho, geella oge ubbaa ixas.","poem":2}]},{"type":"verse","number":105,"content":[{"text":"Ne qaalay ta tohuwas xompe,","poem":1},{"text":"ta ogiyas poo7o.","poem":2}]},{"type":"verse","number":106,"content":[{"text":"Ne xillo pirdada daanaw,","poem":1},{"text":"ta caaqida caaquwa minthana.","poem":2}]},{"type":"verse","number":107,"content":[{"text":"Abeeti Godaw, ta waayey daro;","poem":1},{"text":"ne ufaysa qaalada tana de7on wotha.","poem":2}]},{"type":"verse","number":108,"content":[{"text":"Abeeti Godaw,","poem":1},{"text":"ta galataa yarshuwa eka;","poem":2},{"lineBreak":true},{"text":"tana ne pirdaa tamaarsa.","poem":2}]},{"type":"verse","number":109,"content":[{"text":"Ta shempoy ubba wode meton de7ees;","poem":1},{"text":"shin taani ne higgiya dogike.","poem":2}]},{"type":"verse","number":110,"content":[{"text":"Iitati taw gite yeggidosona;","poem":1},{"text":"shin taani ne wogaape kare keyabike.","poem":2}]},{"type":"verse","number":111,"content":[{"text":"Ne higgey taw merinaa shalo;","poem":1},{"text":"I ta wozanaas ufaysi immees.","poem":2}]},{"type":"verse","number":112,"content":[{"text":"Ta hayqana gakanaw","poem":1},{"text":"ne awaajuwada oothanaw qofa qachas.","poem":2}]},{"type":"verse","number":113,"content":[{"text":"Taani nam7u qofi de7iya asaa ixayis;","poem":1},{"text":"shin ne higgiya dosayis.","poem":2}]},{"type":"verse","number":114,"content":[{"text":"Ne taw gondallenne qosetada attiya besse","poem":1},{"text":"taani ne qaalan ufaysi oothayis.","poem":2}]},{"type":"verse","number":115,"content":[{"text":"Taani ta Xoossaa kiita naagana mela,","poem":1},{"text":"hinteno, iita oothiya ubbay taape haakite.","poem":2}]},{"type":"verse","number":116,"content":[{"text":"Taani de7on daana mela","poem":1},{"text":"ne ufaysa qaalada tana minthetha;","poem":2},{"lineBreak":true},{"text":"ta ufaysaa dhumisopa.","poem":2}]},{"type":"verse","number":117,"content":[{"text":"Ta saro daana mela tana zempisa;","poem":1},{"text":"ta ubba wode ne awaajuwa si7ana.","poem":2}]},{"type":"verse","number":118,"content":[{"text":"Ne awaajuwafe haakeyisata ne koyaka;","poem":1},{"text":"enta cimoy hada.","poem":2}]},{"type":"verse","number":119,"content":[{"text":"Iitata ubbaa ne pitoda taybaasa;","poem":1},{"text":"hessa gisho, taani ne kiitaa dosayis.","poem":2}]},{"type":"verse","number":120,"content":[{"text":"Ta asatethay yashshan new kokorees;","poem":1},{"text":"ta ne higgiya daro yayyayis.","poem":2}]},{"type":"verse","number":121,"content":[{"text":"Ta suurenne xillo oothas;","poem":1},{"text":"tana ta morketas aathada immofa.","poem":2}]},{"type":"verse","number":122,"content":[{"text":"Tana ne aylliya maaddanaw caaqa;","poem":1},{"text":"tana otoranchoti un7ethana mela oothofa.","poem":2}]},{"type":"verse","number":123,"content":[{"text":"Ne tana ashshana gada ta xeellishin,","poem":1},{"text":"ne xillo qaala ta naagishin,","poem":2},{"lineBreak":true},{"text":"ta ayfey teljumis.","poem":2}]},{"type":"verse","number":124,"content":[{"text":"Taw ne aylliyas, ne siiquwada ootha;","poem":1},{"text":"ne higgiya tana tamaarsa.","poem":2}]},{"type":"verse","number":125,"content":[{"text":"Tana ne aylliya ne siiquwa bessa;","poem":1},{"text":"ne wogaa erana mela taw akeeka imma.","poem":2}]},{"type":"verse","number":126,"content":[{"text":"Abeeti Godaw, asay ne higgiya menthida gisho,","poem":1},{"text":"ne pirdana wodey ha77i gakis.","poem":2}]},{"type":"verse","number":127,"content":[{"text":"Taani ne kiita worqafe aathada dosay;","poem":1},{"text":"ee, walahi bayna worqafe aathada dosayis.","poem":2}]},{"type":"verse","number":128,"content":[{"text":"Hessa gisho, ta ne wogata ubbaa kaallayis;","poem":1},{"text":"geella oge ubbaa ixas.","poem":2}]},{"type":"verse","number":129,"content":[{"text":"Ne woga ubbay malaalsiyaba;","poem":1},{"text":"hessa gisho, ta iya kiitetayis.","poem":2}]},{"type":"verse","number":130,"content":[{"text":"Ne qaala birshethay poo7o immees;","poem":1},{"text":"cincatethi pacidaysatas akeeka immees.","poem":2}]},{"type":"verse","number":131,"content":[{"text":"Taani ne kiitaa saamotada,","poem":1},{"text":"ta doona dooyas.","poem":2}]},{"type":"verse","number":132,"content":[{"text":"Haa taako simma;","poem":1},{"text":"nena doseysatas ne ootheysada taw qadheta.","poem":2}]},{"type":"verse","number":133,"content":[{"text":"Ne ufaysa qaalada ta hemethaa suurisa;","poem":1},{"text":"nagari tana haarana mela oothofa.","poem":2}]},{"type":"verse","number":134,"content":[{"text":"Ta ne wogaa kiitetana mela","poem":1},{"text":"tana un7etheyisata kushepe woza.","poem":2}]},{"type":"verse","number":135,"content":[{"text":"Ne aylliya ta bolla ne som7uwa poo7isa;","poem":1},{"text":"ne higgiya tamaarsa.","poem":2}]},{"type":"verse","number":136,"content":[{"text":"Asay ne higgiya menthida gisho,","poem":1},{"text":"ta afuthay haathada goggees.","poem":2}]},{"type":"verse","number":137,"content":[{"text":"Abeeti Godaw, ne xillo;","poem":1},{"text":"ne pirday suure.","poem":2}]},{"type":"verse","number":138,"content":[{"text":"Ne higgey xillo;","poem":1},{"text":"ay wodeka ammanetees.","poem":2}]},{"type":"verse","number":139,"content":[{"text":"Ta morketi ne qaala toochida gisho,","poem":1},{"text":"ta mishay tamada eexidi keyis.","poem":2}]},{"type":"verse","number":140,"content":[{"text":"Ne ufaysa qaalay daro ammanetees;","poem":1},{"text":"ta ne aylley daro dosayis.","poem":2}]},{"type":"verse","number":141,"content":[{"text":"Taani pathonnanne kadhetida asi;","poem":1},{"text":"gidoshin ta ne wogaa dogike.","poem":2}]},{"type":"verse","number":142,"content":[{"text":"Ne xillotethay merinaw de7ees;","poem":1},{"text":"ne higgey tuma.","poem":2}]},{"type":"verse","number":143,"content":[{"text":"Metoynne un7i tana gakis;","poem":1},{"text":"shin ne kiitati tana ufaysoosona.","poem":2}]},{"type":"verse","number":144,"content":[{"text":"Ne wogay merinaw xillo;","poem":1},{"text":"ta de7on daana mela taw akeeka imma.","poem":2}]},{"type":"verse","number":145,"content":[{"text":"Abeeti Godaw, ta kumetha wozanaape","poem":1},{"text":"neeko waassas; tana alla;","poem":2},{"lineBreak":true},{"text":"Ta ne awaajuwa naagana.","poem":2}]},{"type":"verse","number":146,"content":[{"text":"Ta neeko waassas; tana ashsha;","poem":1},{"text":"ta ne higgiya naagana.","poem":2}]},{"type":"verse","number":147,"content":[{"text":"Xalqey caaronna wonta dendada,","poem":1},{"text":"tana maadda gada neeko waassayis;","poem":2},{"lineBreak":true},{"text":"ne gelida qaalan ufaysi wothayis.","poem":2}]},{"type":"verse","number":148,"content":[{"text":"Ne qaalaba zaara zaara qopanaw,","poem":1},{"text":"qamma utta aqayis.","poem":2}]},{"type":"verse","number":149,"content":[{"text":"Abeeti Godaw, ne siiquwa gisho, tana si7a;","poem":1},{"text":"ne xillo pirdada tana de7on wotha.","poem":2}]},{"type":"verse","number":150,"content":[{"text":"Tana yedethiya iitati tako matoosona;","poem":1},{"text":"shin enti ne higgiyafe haakoosona.","poem":2}]},{"type":"verse","number":151,"content":[{"text":"Shin abeeti Godaw, ne taw matan de7aasa;","poem":1},{"text":"ne kiita ubbay tuma.","poem":2}]},{"type":"verse","number":152,"content":[{"text":"Taani benipe doomada, ne higgiya tamaaras;","poem":1},{"text":"ne iya merinaw minthada essadasa.","poem":2}]},{"type":"verse","number":153,"content":[{"text":"Ta ne higgiya dogonna gisho,","poem":1},{"text":"ta metuwa be7ada tana ashsha;","poem":2}]},{"type":"verse","number":154,"content":[{"text":"Ta gisho mootetada tana woza;","poem":1},{"text":"ne ufaysa qaalada tana de7on wotha.","poem":2}]},{"type":"verse","number":155,"content":[{"text":"Ne higgiya enti ekonna gisho,","poem":1},{"text":"iitati atotethi demmokona.","poem":2}]},{"type":"verse","number":156,"content":[{"text":"Abeeti Godaw, ne qadhey daro;","poem":1},{"text":"ne xillo pirdada tana de7on wotha.","poem":2}]},{"type":"verse","number":157,"content":[{"text":"Tana ixeysatinne yedetheysati daro;","poem":1},{"text":"shin ta ne higgiyafe gaxa keyike.","poem":2}]},{"type":"verse","number":158,"content":[{"text":"Enti ne kiita naagonna gisho,","poem":1},{"text":"ta nena kaddeyisata be7ada shaatettas.","poem":2}]},{"type":"verse","number":159,"content":[{"text":"Abeeti Godaw, ta ne wogaa doseysa be7a;","poem":1},{"text":"ne siiquwada tana de7on wotha.","poem":2}]},{"type":"verse","number":160,"content":[{"text":"Ne qaalay tuma;","poem":1},{"text":"ne xillo pirday merinaw de7ees.","poem":2}]},{"type":"verse","number":161,"content":[{"text":"Halaqati tana coo yedethoosona;","poem":1},{"text":"shin ta wozanay ne qaala yayyees.","poem":2}]},{"type":"verse","number":162,"content":[{"text":"Darobaa di77ida asi ufayteysada,","poem":1},{"text":"ne ufaysa qaalan ta ufaytayis.","poem":2}]},{"type":"verse","number":163,"content":[{"text":"Taani wordo ixayis; shaatettayis;","poem":1},{"text":"shin ne higgiya dosayis.","poem":2}]},{"type":"verse","number":164,"content":[{"text":"Ne xillo pirdaa gisho,","poem":1},{"text":"ta nena gallas laapun toho galatayis.","poem":2}]},{"type":"verse","number":165,"content":[{"text":"Ne higgiya doseysatas polo sarotethi de7ees;","poem":1},{"text":"enta aybika dhubethanaw danda7enna.","poem":2}]},{"type":"verse","number":166,"content":[{"text":"Abeeti Godaw, ta ne atotetha ufaysan naagayis;","poem":1},{"text":"ne kiita kaallayis.","poem":2}]},{"type":"verse","number":167,"content":[{"text":"Taani ne higgiya naagayis;","poem":1},{"text":"ta kumetha wozanaape dosayis.","poem":2}]},{"type":"verse","number":168,"content":[{"text":"Ta oge ubbaa ne be7iya gisho,","poem":1},{"text":"taani ne higgiyanne ne wogaa naagana;","poem":2}]},{"type":"verse","number":169,"content":[{"text":"Abeeti Godaw, ta waasoy ne sinthe gako;","poem":1},{"text":"ne ufaysa qaalada taw akeeka imma.","poem":2}]},{"type":"verse","number":170,"content":[{"text":"Ta woosay ne sinthe gako;","poem":1},{"text":"ne ufaysa qaalada tana ashsha.","poem":2}]},{"type":"verse","number":171,"content":[{"text":"Neeni ne awaajuwa tana tamaarsiya gisho,","poem":1},{"text":"ta doonape galati pultana.","poem":2}]},{"type":"verse","number":172,"content":[{"text":"Ne kiita ubbay xillo gidiya gisho,","poem":1},{"text":"ta inxarsay ne qaalaba yexana.","poem":2}]},{"type":"verse","number":173,"content":[{"text":"Taani ne wogaa doorida gisho,","poem":1},{"text":"ne kushey tana maaddanaw giigidaysa gido.","poem":2}]},{"type":"verse","number":174,"content":[{"text":"Abeeti Godaw, ne ashshana mela ta laamotayis;","poem":1},{"text":"ne higgey tana ufaysees.","poem":2}]},{"type":"verse","number":175,"content":[{"text":"Taani nena galatana mela,","poem":1},{"text":"tana de7on wotha;","poem":2},{"lineBreak":true},{"text":"ne pirday tana maaddo.","poem":2}]},{"type":"verse","number":176,"content":[{"text":"Taani dhayida dorsada toylatas;","poem":1},{"text":"tana ne aylliya koya;","poem":2},{"lineBreak":true},{"text":"ta ne kiita dogike.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/120.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":176}