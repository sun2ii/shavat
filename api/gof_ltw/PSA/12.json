{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":12,"content":[{"type":"heading","content":["Alame Iitatethaafe Atetha Woosa"]},{"type":"hebrew_subtitle","content":["Zammaareta Halaqaas Xaafetida Dawita Mazmure."]},{"type":"verse","number":1,"content":["Xoossa asi biittafe wurida gisho,",{"text":"asa giddon ammanetethi bayna gisho,","poem":2},{"lineBreak":true},{"text":"Godaw nuna maaddarkii?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ubbay wordo haasayoosona;","poem":1},{"text":"issoy issuwa cimmiya inxarsan","poem":2},{"lineBreak":true},{"text":"nam7u wozanan odetoosona.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abeeti Godaw, cimmiya doona gorda;","poem":1},{"text":"otoron ceeqetiya inxarsaa teqa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Enti, “Nu inxarsan nu xoonana;","poem":1},{"text":"nu doonay nuusa;","poem":2},{"lineBreak":true},{"text":"nuus godi oonee?” yaagosona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Manqota un7aa gishonne,","poem":1},{"text":"metootanchota ooliya gisho,","poem":2},{"lineBreak":true},{"text":"ha77i taani dendana;","poem":2},{"lineBreak":true},{"text":"enti amotiya sarotethaa entaw immana” yaagees Goday.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Godaa qaalay geeshshi;","poem":1},{"text":"taman laapun toho seerida birada geeshshi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abeeti Godaw neeni enta naaga;","poem":1},{"text":"haysa mela asape merinaw enta ashsha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iiti asaa giddon bonchetiya wode,","poem":1},{"text":"geella asati ceeqetishe simeretoosona.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}