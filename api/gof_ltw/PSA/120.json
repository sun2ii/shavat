poem":2}]},{"type":"verse","number":7,"content":[{"text":"Taani saro asi;","poem":1},{"text":"shin ta sarotethaba haasaya wode,","poem":2},{"lineBreak":true},{"text":"enti olaba haasayoosona.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}