:1},{"text":"I nena saro wothana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Goday ne kessaane ne geluwa,","poem":1},{"text":"hachife merinaw naagana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}