se","number":7,"content":[{"text":"Ne gimbeta giddon saroy gido;","poem":1},{"text":"ne kawo keethan wopatethi de7o” yaagite.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ta ishatanne ta dabbota gisho,","poem":1},{"text":"“Ne giddon saroy de7o” yaagana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Godaa nu Xoossaa keethaa gisho,","poem":1},{"text":"new lo77oba amottayis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}