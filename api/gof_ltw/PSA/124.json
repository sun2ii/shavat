ontent":[{"text":"Kafoy shanka gitepe kessi ekeysada,","poem":1},{"text":"nuuni kessi ekida;","poem":2},{"lineBreak":true},{"text":"xihey meqis, nuuni kessi ekida.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Salonne sa7aa medhida,","poem":1},{"text":"Godaa sunthan nuus maadoy yees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}