exishe cakana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Zerethi tookidi yeekishe bidaysati,","poem":1},{"text":"ufaysa yethe yexishe,","poem":2},{"lineBreak":true},{"text":"mirqe tookidi simmana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}