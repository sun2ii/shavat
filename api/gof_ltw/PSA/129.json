","poem":1},{"text":"dicconna melida maata mela gido.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"He maata buucanaw kushen dankey","poem":1},{"text":"woyko mirqanaw oykey baawa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ogera aadheysati,","poem":1},{"text":"“Goday wolqa immo” gin,","poem":2},{"lineBreak":true},{"text":"cakeysati “Godi anjo” giyabay deenna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}