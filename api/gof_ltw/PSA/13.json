nt":[{"text":"Shin taani ne maarotethan ammanetayis;","poem":1},{"text":"neeni tana ashshiya gisho ufaytayis.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne taw keehida gisho,","poem":1},{"text":"Godaw, ta new yexana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}