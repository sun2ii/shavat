{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":130,"content":[{"type":"heading","content":["Ta Shempiya Nena Naagawusu"]},{"type":"hebrew_subtitle","content":["Pudethe keyishe yexiya mazmure"]},{"type":"verse","number":1,"content":["Godaw, taani meto ciimmon de7ashe,",{"text":"neeko waassayis.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Godaw, ta waasuwa si7a;","poem":1},{"text":"ta woosa ne haythay hayzo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Xoossaw, nu nagaraa ne xaafa oykidaako,","poem":1},{"text":"Godaw, ooni pirdafe attanaw danda7ii?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Shin nuuni new yayyana mela,","poem":1},{"text":"nu nagaraa atto yaagasa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Taani Godaa laamotan naagayis;","poem":1},{"text":"ta shempiya laamotan naagawusu;","poem":2},{"lineBreak":true},{"text":"taani iya qaalan ufaysi wothayis.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sa7i awude wontane gidi,","poem":1},{"text":"naagiya wotaadarepe aathada,","poem":2},{"lineBreak":true},{"text":"taani Godaa laamotan naagayis.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iya siiqoy merinaasa gidiya gishonne","poem":1},{"text":"iyan kumetha atotethi de7iya gisho","poem":2},{"lineBreak":true},{"text":"Isra7eele, Godan ufaysi ootha;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Goday Isra7eele,","poem":1},{"text":"iya nagaraa ubbaafe ashshana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}