{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":132,"content":[{"type":"heading","content":["Xoossay Xiyoone Dooris"]},{"type":"hebrew_subtitle","content":["Pudethe keyishe yexiya mazmure"]},{"type":"verse","number":1,"content":["Godaw, Dawitanne",{"text":"I danda7ida metuwa ubbaa qopa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Godaas I caaqidaysa,","poem":1},{"text":"wolqaama gidida Yayqooba Xoossaas,","poem":2},{"lineBreak":true},{"text":"I odidaysa hassaya.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Godaas besse giigisana gakanaw,","poem":1},{"text":"Wolqaama gidida Yayqooba Xoossaas,","poem":2},{"lineBreak":true},{"text":"keethe keexana gakanaw,","poem":2},{"lineBreak":true},{"text":"ta soo gelike;","poem":2},{"lineBreak":true},{"text":"ta hiixan zin7ike.","poem":2},{"text":"Ta ayfey qilim7enna,","poem":1},{"text":"woyko tana dhiskoy ekenna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nuuni Taabotiyabaa","poem":1},{"text":"Efraatan si7ida;","poem":2},{"lineBreak":true},{"text":"Yi7aarime biittan iya demmida.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Ane I de7iya bessaa boos;","poem":1},{"text":"iya tohoy yedhiya bessan","poem":2},{"lineBreak":true},{"text":"iya goyinnoos.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Godaw, denda!","poem":1},{"text":"Ne minotethaa malla gidida","poem":2},{"lineBreak":true},{"text":"ne Taabotiyara ne keethaa gela.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ne kahineti xillotethi ma7o;","poem":1},{"text":"ne asay ufaysan yexo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne aylliya Dawita gisho,","poem":1},{"text":"neeni tiyida kawa aggofa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Goday Dawitas laametonna caaqo","poem":1},{"text":"haysada yaagidi caaqis;","poem":2},{"text":"“Ne gulbatape keyida,","poem":1},{"text":"ne naytape issuwa ne araatan utisana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne nayti ta caaquwanne","poem":1},{"text":"ta tamaarsiya timirtiya naagiko,","poem":2},{"lineBreak":true},{"text":"enta nayti ne araatan merinaw uttana” yaagis.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Goday Xiyoone dooris;","poem":1},{"text":"baw de7iya bessi oothanaw amotidi,","poem":2},{"lineBreak":true},{"text":"haysada yaagis;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“Haysi ta merinaw de7iya besse;","poem":1},{"text":"taani amotida gisho haysan daana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Taani daro kathi immada Xiyoone anjana;","poem":1},{"text":"iyan de7iya manqotaka kathi kalsana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Iyan de7iya kahineta atotethi mayzana;","poem":1},{"text":"iyan de7iya xilloti ufaysan yexana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"He bessan Dawita zeriyape kawo kessana;","poem":1},{"text":"taani tiyida kawa kawotethan gam7isana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Taani iya morketa yeella mayzana;","poem":1},{"text":"shin iya huuphen de7iya kallachay phoolana” yaagas.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":16}