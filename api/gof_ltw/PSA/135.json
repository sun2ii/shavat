{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":135,"content":[{"type":"heading","content":["Xoossa Sunthay Merinaw Eretees"]},{"type":"verse","number":1,"content":["Godaa galatite!",{"text":"Hinteno, Godaa aylleto,","poem":1},{"text":"Godaa sunthaa galatite!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hinteno, Godaa keethan,","poem":1},{"text":"nu Xoossa keethaa dabaaban eqeysato,","poem":2},{"lineBreak":true},{"text":"Godaa galatite!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"I keeha gidiya gisho Godaa galatite!","poem":1},{"text":"I lo77o gidiya gisho iya sunthaa sabbite!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Goday Yayqooba babaa,","poem":1},{"text":"Isra7eele baw buzo oothidi dooris.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Goday gita gideysanne","poem":1},{"text":"nu Goday, xoossata ubbaafe aadheysa","poem":2},{"lineBreak":true},{"text":"taani erayis.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Salon sa7an, abbaninne iya giddon","poem":1},{"text":"Goday ba dosidaba ubbaa oothees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Shaara sa7aa gaxape denthees;","poem":1},{"text":"wol7anthi irara kiittees;","poem":2},{"lineBreak":true},{"text":"carko ba minja keethaafe kessees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gibxe biittan asape mehe gakanaw,","poem":1},{"text":"bayra yeletida ubbaa wodhis.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neno Gibxe,","poem":1},{"text":"Paaronanne iya aylleta ubbaa seeranaw","poem":2},{"lineBreak":true},{"text":"malaatatanne malaalsiyabata kiittis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"I daro kawotethata dhaysis;","poem":1},{"text":"wolqaama kawota wodhis.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amoore kawa Sihoona","poem":1},{"text":"Baasane kawa Oogenne","poem":2},{"lineBreak":true},{"text":"Kanaane kawota ubbaa wodhis.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Enta biitta ba asaa,","poem":1},{"text":"Isra7eele laatisis.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Godaw, ne sunthay merinaw daana;","poem":1},{"text":"yeletaape yeleta gakanaw ne hassayetana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Goday ba asaas pirdana;","poem":1},{"text":"I ba aylletas qadhetana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kawotethata eeqati asa kushe oosota;","poem":1},{"text":"birapenne worqafe medhetidaysata.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Entaw dooni de7ees, shin haasayokona;","poem":1},{"text":"ayfey de7ees, shin xeellokona.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Haythi de7ees, shin si7okona;","poem":1},{"text":"enta siidhen shempoy baawa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Enta medhidaysatinne","poem":1},{"text":"entan ammaneteysati","poem":2},{"lineBreak":true},{"text":"ubbay entada hano.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Isra7eele asaw Godaa galatite;","poem":1},{"text":"Aarona soo asaw Godaa galatite.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Leewe soo asaw Godaa galatite;","poem":1},{"text":"Godaa yayyeysato ubbay Godaa galatite.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yerusalaamen de7iya Goday","poem":1},{"text":"Xiyoonen galatetto!","poem":2},{"lineBreak":true},{"text":"Godaa galatite!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}