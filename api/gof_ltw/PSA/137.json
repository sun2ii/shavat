{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":137,"content":[{"type":"heading","content":["Aylletethan De7iya Asaa Yeeho"]},{"type":"verse","number":1,"content":[{"text":"Babiloone shaafata matan uttidi,","poem":1},{"text":"Xiyoone qopida wode yeekida.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"He bessan nuuni","poem":1},{"text":"nu diithaa haatha gaxan dicciya,","poem":2},{"lineBreak":true},{"text":"mithata bolla kaqida.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nuna di77ida asati nuuni yexidi,","poem":1},{"text":"enta ufaysana mela","poem":2},{"lineBreak":true},{"text":"“Xiyoone yethatape issuwa ane nuus yexite” yaagidosona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Godaa yethaa nuuni allaga biittan","poem":1},{"text":"waati yexanee?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yerusalaame taani nena dogiko,","poem":1},{"text":"ta ushacha kushey tana balo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taani nena hassayonna aggiko,","poem":1},{"text":"ta gita ufaysi gidida Yerusalaame dosonna ixiko,","poem":2},{"lineBreak":true},{"text":"ta inxarsay kottonuwara oyketo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Godaw, Yerusalaame di7etiya gallas","poem":1},{"text":"Edoome asay oothidaysa hassaya;","poem":2},{"text":"Enti, “Laallite! Laallite!","poem":1},{"text":"Hirki xaphuwa gakanaw laallite!”","poem":2},"yaagidaysa dogopa."]},{"type":"verse","number":8,"content":[{"text":"Babiloone, neeni dhayana!","poem":1},{"text":"Neeni nu bolla oothida iita oosuwas","poem":2},{"lineBreak":true},{"text":"halo kesseysi anjetidaysa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ne guutha nayta oykidi,","poem":1},{"text":"zaalla bolla shoceysi anjetidaysa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}