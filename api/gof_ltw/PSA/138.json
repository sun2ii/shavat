{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":138,"content":[{"type":"heading","content":["Xoossa Galatite"]},{"type":"hebrew_subtitle","content":["Dawita Mazmure"]},{"type":"verse","number":1,"content":["Godaw, ta kumetha wozanan nena galatana;",{"text":"xoossata sinthan nena sabbana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne geeshsha keethaako simmada nena goyinnana;","poem":1},{"text":"ne siiquwa gishonne ne tumatethaa gisho galatana.","poem":2},{"text":"Ne sunthaa gishonne","poem":1},{"text":"ne qaala dhoqatethaa gisho galatana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taani xeegida wode ne taw koyadasa;","poem":1},{"text":"ne minotethan tana minthadasa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Godaw, ne doonape keyiya qaala si7iya wode,","poem":1},{"text":"sa7an de7iya kawoti ubbay nena galato.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Godaa bonchoy gita gidiya gisho,","poem":1},{"text":"enti Godaa ogiyaba yexo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Goday bolla dhoqan de7ikoka,","poem":1},{"text":"manqota keeha ayfen xeellees;","poem":2},{"lineBreak":true},{"text":"shin otoranchota haahon erees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Taani meto giddora hemetikoka,","poem":1},{"text":"neeni tana naagasa.","poem":2},{"text":"Ta morketa hanquwa bolla ne kushiya miccaasa;","poem":1},{"text":"ne ushacha kushiyan tana ashshaasa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Goday taw gelida qaala polana;","poem":1},{"text":"Godaw, ne siiqoy merinaasa;","poem":2},{"lineBreak":true},{"text":"Ne kushe oosuwa yegga aggofa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}