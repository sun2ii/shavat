{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":139,"content":[{"type":"heading","content":["Ta Wozana Pilgada Be7a"]},{"type":"hebrew_subtitle","content":["Dawita Mazmure"]},{"type":"verse","number":1,"content":["Godaw, neeni tana pilgada eradasa."]},{"type":"verse","number":2,"content":[{"text":"Neeni ta utethaanne ta equwa eraasa;","poem":1},{"text":"ta qofa ubbaa haahon akeekasa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taani biya bessaanne shempiya bessaa xomoosasa;","poem":1},{"text":"ta ogeta ubbaa eraasa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Godaw, taani ta inxarsan","poem":1},{"text":"issi qaala odetanaape sinthe,","poem":2},{"lineBreak":true},{"text":"ta qofa ubbaa eraasa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neeni ta yuushuwan de7aasa;","poem":1},{"text":"ne kushiya ta bolla wothaasa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne eratethay tana daro malaalsees;","poem":1},{"text":"ta akeekape dhoqa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta ne Ayyaanape aw baqatanee?","poem":1},{"text":"ne sinthafe aw baanee?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Pude salo keyiko ne yan de7aasa!","poem":1},{"text":"Duge Si7oole wodhikoka ne yan de7aasa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Doloha bagga paallada biiko,","poem":1},{"text":"woyko wuloha baggan haakada de7iko,","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"yan ne kushey tana kaalethees;","poem":2},{"lineBreak":true},{"text":"ne ushacha kushey tana zempisees.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Dhumaw tana gentha;","poem":1},{"text":"gallasaw qamma laameta” yaagiyakoka,","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"sakana dhumi new dhumenna;","poem":2},{"lineBreak":true},{"text":"qammi gallasada poo7ees;","poem":2},{"lineBreak":true},{"text":"new dhumi poo7o mela.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Neeni ta giddo asatethaa medhadasa;","poem":1},{"text":"ta aaye ulon tana neeni tiladasa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Neeni tana malaalsiyabanne","poem":1},{"text":"yegelsi oothada medhida gisho,","poem":2},{"lineBreak":true},{"text":"taani nena galatayis.","poem":2},{"text":"Ne oosoti malaalsees!","poem":1},{"text":"taani hessa loythada erayis.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Taani geema bessan medhetiya wode,","poem":1},{"text":"ta meqethay neepe geemmibeenna.","poem":2},{"text":"Ta asatethay ta aaye ulon ciimmo giddon","poem":1},{"text":"hiillan alleeqetidi oosetiya wode,","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ne ayfeti giigonna ta asatethaa be7idosona.","poem":2},{"lineBreak":true},{"text":"Buroo issoyka doometonna de7ishin,","poem":2},{"lineBreak":true},{"text":"ne taw buzoyida gallasa ubbay","poem":2},{"lineBreak":true},{"text":"ne mazgaben xaafetidosona.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Xoossaw, ne taw qopiya qofay","poem":1},{"text":"waanida boncho!","poem":2},{"lineBreak":true},{"text":"Enta tayboy waanidi daride!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Taani enta taybiyako shafepe daro;","poem":1},{"text":"taani barkiya wode ha77ika neera de7as.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Xoossaw, neeni iitata wodhiyako aybe!","poem":1},{"text":"Suuthu gussiya asati taape haako!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Enti ne bolla iitabaa haasayoosona;","poem":1},{"text":"ne morketi ne suntha iissoosona.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Godaw, nena ixeyisata ta ixikina?","poem":1},{"text":"Ne bolla dendeyisata ta shaatetikina?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Taani enta kumethi ixayis;","poem":1},{"text":"enta taani ta morkeda taybayis.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Xoossaw, tana pilgada ta wozanaa era;","poem":1},{"text":"tana un7ethida ta qofaa be7a.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Tanan iitabay de7iko xeella;","poem":1},{"text":"merina ogiyan tana kaaletha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}