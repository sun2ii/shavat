{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":14,"content":[{"type":"heading","content":["Xoosse Erona Asata"]},{"type":"hebrew_subtitle","content":["Zammaareta Halaqaas Xaafetida Dawita Mazmure."]},{"type":"verse","number":1,"content":["Eeyati banta wozanan, “Xoossi baawa” yaagosona;",{"text":"enta de7oy iitis.","poem":2},{"text":"Enti ixetidaba oothosona;","poem":1},{"text":"lo77oba oothiya asi baawa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Akeekeynne Xoosse koyey de7iyako be7anaw,","poem":1},{"text":"Goday salope duge ase xeellees.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Shin ubbay zoko zaaridosona;","poem":1},{"text":"ubbay go77onnaba gididosona.","poem":2},{"text":"Lo77oba oothiya oonika baawa;","poem":1},{"text":"hari attoshin issi asika baawa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Asi kathi meysada,","poem":1},{"text":"enti ta asaa bonqidi moosona;","poem":2},{"lineBreak":true},{"text":"ha iita asati aybaka erokona;","poem":2},{"lineBreak":true},{"text":"enti Xoossaa woossokona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Shin Xoossay xillo asaara de7iya gisho,","poem":1},{"text":"iita asati yashshan kokoroosona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hinte manqota qofaa laalleeta;","poem":1},{"text":"shin Goday manqoti qosetidi attiya besse.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Isra7eeles atotethi Xiyoonepe yeerenne!","poem":1},{"text":"Goday enta duussa zaariya wode,","poem":2},{"text":"Yayqooba kochay ufaytana;","poem":1},{"text":"Isra7eele asay hashshu gaana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}