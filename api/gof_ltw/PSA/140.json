{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":140,"content":[{"type":"heading","content":["Iita Asa Kushepe Tana Ashsha"]},{"type":"hebrew_subtitle","content":["Dawita Mazmure"]},{"type":"verse","number":1,"content":["Godaw, iitatape tana ashsha;",{"text":"makallanchotape tana naaga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Enti iita oothanaw maqetoosona;","poem":1},{"text":"gallas gallas ola denthoosona.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Banta inxarsaa shoosha inxarsada qarayoosona;","poem":1},{"text":"enta doonan wodhiya marzey de7ees. Salaha","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Godaw, iitata kushepe tana ashsha;","poem":1},{"text":"ta tohuwa qaxanaw qopiya","poem":2},{"lineBreak":true},{"text":"makallanchotape tana naaga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Otorancho asati taw xihe wothoosona;","poem":1},{"text":"gite hiixoosona;","poem":2},{"lineBreak":true},{"text":"tana oykanaw gite yeggoosona. Salaha","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Godaa, “Neeni ta Xoossaa” gaana;","poem":1},{"text":"Godaw, ta woosa si7a.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ubbaa Haariya Godaw,","poem":1},{"text":"tana ashshiya minuwaw,","poem":2},{"lineBreak":true},{"text":"ola gallas taw gondalle gidadasa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Godaw, iitatas enta amuwa immofa;","poem":1},{"text":"enti otortonna mela enta maquwa polisopa. Salaha","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ta morketan tana xoonisopa;","poem":1},{"text":"enta doonape keyiya iitay","poem":2},{"lineBreak":true},{"text":"enta bolla simmo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Enta bolla xuuggiya tama bonqoy qoletto;","poem":1},{"text":"enti tama ollan yegeto;","poem":2},{"lineBreak":true},{"text":"keyanaw danda7onna olla holeto.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yooyamati biitta bolla de7opo;","poem":1},{"text":"buqeyisata iitabay yedethidi oyko.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Goday manqotas pirdeysanne","poem":1},{"text":"metootanchotas mooteteysa erayis.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Xilloti tuma ne sunthaa galatana;","poem":1},{"text":"suure asati ne sinthan daana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}