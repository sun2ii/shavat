{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":141,"content":[{"type":"heading","content":["Ne Haytha Taako Zaara"]},{"type":"hebrew_subtitle","content":["Dawita Mazmure"]},{"type":"verse","number":1,"content":["Godaw, taani nena xeegayis;",{"text":"tana maaddanaw ellesa;","poem":2},{"lineBreak":true},{"text":"Ta neeko waassiya wode tana si7a!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta woosay ixaaneda ne sinthe shiiqo;","poem":1},{"text":"ta kushe micethay omarsa yarsho mela gido.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Godaw, ta doona naagiya asi wotha;","poem":1},{"text":"ta mettersha pengiya naaga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iita oothiya asatara iita oothonna mela,","poem":1},{"text":"ta wozanaa iitako zaaropa;","poem":2},{"lineBreak":true},{"text":"enta gibira tana muzopa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xillo asi tana seero, hessi taw keehatethi,","poem":1},{"text":"I tana hanqeto, hessi ta huuphen zayte tiyo mela.","poem":2},{"text":"Ta wozanay hessa ixenna;","poem":1},{"text":"Ta woosay ubba wode enta iita oosuwa bollana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Enta daynnati aafo holetiya wode,","poem":1},{"text":"ta qaalay tuma gideysa enti erana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Enti, “Asi biitta goyeysadanne phasha laalleysada,","poem":1},{"text":"nu meqethay duufo doonan laaletana” yaagosona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ubbaa Haariya Godaw,","poem":1},{"text":"ta ayfey nena xeellees.","poem":2},{"text":"Taani neeko baqatayis;","poem":1},{"text":"tana hayqos aathada immofa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Enti taw yeggida gitiyapenne","poem":1},{"text":"iitaa ootheyisata xihiyape tana naaga.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Taani saro aadhin,","poem":1},{"text":"iitati banta wothida gitiyan oyketo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}