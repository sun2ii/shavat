{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":142,"content":[{"type":"heading","content":["Neeni Taw Qosetiya Bessi"]},{"type":"hebrew_subtitle","content":["Dawiti gongolon de7iya wode xaafida timirte"]},{"type":"verse","number":1,"content":["Ta qaala dhoqu oothada Godaako waassayis;",{"text":"maarota demmanaw iya woossayis.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta oysha ubbaa iya bessayis;","poem":1},{"text":"ta metuwa ubbaa iyaw odayis.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taani heettida wode ne ta ogiya eraasa;","poem":1},{"text":"ta ogiyan gite yeggidi wothidosona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taani ta yuushuwa xeelliya wode,","poem":1},{"text":"tana maaddey issoyka baawa.","poem":2},{"lineBreak":true},{"text":"Taani qosetada attiya bessi baawa;","poem":2},{"lineBreak":true},{"text":"tana naagiya oonika baawa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Godaw, taani neeko waassayis;","poem":1},{"text":"taani, “Ne taw baqatada attiya bessi;","poem":2},{"lineBreak":true},{"text":"de7on de7eyisata biittan ta saamay nena” yaagas.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taani daro metootiya gisho,","poem":1},{"text":"ta waasuwa si7a.","poem":2},{"text":"Tana yedetheysati wolqaamida gisho,","poem":1},{"text":"tana entafe ashsha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta ne sunthaa galatana mela,","poem":1},{"text":"tana qashope birsha.","poem":2},{"text":"Neeni taw keeha gidiya gisho,","poem":1},{"text":"xilloti ta yuushon shiiqana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}