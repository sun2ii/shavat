{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":143,"content":[{"type":"heading","content":["Ta Shempiya Nena Koyawusu"]},{"type":"hebrew_subtitle","content":["Dawita Mazmure"]},{"type":"verse","number":1,"content":["Godaw, ta woosa si7a;",{"text":"maarota demmanaw ta waasseysa hayza.","poem":2},{"text":"Neeni xillotethaninne ne ammanetethan","poem":1},{"text":"taw zaaro imma.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne sinthan xillo asi bayna gisho","poem":1},{"text":"tana ne aylliya pirdas shiishopa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tana ta morkey yedethidi,","poem":1},{"text":"tincherethidi sa7an yeggis.","poem":2},{"text":"Beni hayqida asada","poem":1},{"text":"tana dhuman wothis.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hessa gisho taani heettas;","poem":1},{"text":"ta wozanayka til7is.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Taani beni wodeta hassayayis;","poem":1},{"text":"ne oothida ooso ubbaa qopayis;","poem":2},{"lineBreak":true},{"text":"ne kushe ooso ubbaa akeekayis.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taani ta kushiya neeko miccas;","poem":1},{"text":"mela biitti haathe koyeysada,","poem":2},{"lineBreak":true},{"text":"ta shempoy nena saamotees. Salaha","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Godaw, ta wozanay heettida gisho","poem":1},{"text":"taw zaaro immanaw ellesa.","poem":2},{"text":"Taani duufon geliya asada hanonna mela","poem":1},{"text":"ne som7uwa taape genthofa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Taani nenan ammanetiya gisho,","poem":1},{"text":"wonta wonta ne siiquwaba tana bessa.","poem":2},{"text":"Taani ta shempuwafe nena woossiya gisho,","poem":1},{"text":"ta baana ogiya tana bessa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Godaw, taani new maggannida gisho,","poem":1},{"text":"ta morketape tana ashsha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Neeni ta Xoossaa gidiya gisho,","poem":1},{"text":"ta ne sheniya oothana mela tana tamaarsa;","poem":2},{"lineBreak":true},{"text":"ne lo77o ayyaanay suure ogiyan tana kaaletho.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Godaw, ne sunthaa gisho tana ashsha;","poem":1},{"text":"ne xillotethan tana metope kessa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne siiquwan ta morketa wodha;","poem":1},{"text":"ta ne aylle gidiya gisho","poem":2},{"lineBreak":true},{"text":"tana un7etheyisata ubbaa dhaysa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}