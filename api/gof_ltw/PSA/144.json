{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":144,"content":[{"type":"heading","content":["Xoossay Taw Miixa"]},{"type":"hebrew_subtitle","content":["Dawita Mazmure"]},{"type":"verse","number":1,"content":["Goday, ta zaallay, galatetto!",{"text":"Ta kushiya ola tamaarsees;","poem":2},{"lineBreak":true},{"text":"ta biradheta tooras giigisees.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"I ta siiqo Xoossaanne ta qosetta attiya besse;","poem":1},{"text":"ta miixanne tana ashsheysa.","poem":2},{"text":"Ta gondallenne taani baqatada attiya besse;","poem":1},{"text":"I kawotethati taw haaretana mela oothis.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Godaw, neeni iyaw qopanaw asi aybee?","poem":1},{"text":"Ne wozanan iyaw besse immanaw asa na7i aybee?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Asi issi toho carkiya carko mela;","poem":1},{"text":"iya gallasati aadhiya kuya mela.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Godaw, saluwa phalqada duge wodha!","poem":1},{"text":"dereta bocha; enti cuyo!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wol7anthi yeddada ne morketa laalla;","poem":1},{"text":"ne dongiya yiishshan dukada enta yedetha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bollara ne kushiya yeddada,","poem":1},{"text":"tana wolqaama haathaafe goochada kessa;","poem":2},{"lineBreak":true},{"text":"allaga asata kushepe tana wosisa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Enti tuma haasayidi erokona;","poem":1},{"text":"banta ushacha kushiya denthidi","poem":2},{"lineBreak":true},{"text":"wordon caaqoosona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Xoossaw taani new ooratha mazmure yexana;","poem":1},{"text":"tammu shayan waaxetida diithan yexana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kawotas xoono immaasa;","poem":1},{"text":"ne aylliya Dawita ashshaasa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tana iita mashshafe ashsha;","poem":1},{"text":"allaga asata kushepe tana wosisa.","poem":2},{"text":"Enta doonay wordon,","poem":1},{"text":"enta ushacha kushey cimon kumis.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nu adde nayti banta na7atethan,","poem":1},{"text":"lo77o dicciya mitha mela gido.","poem":2},{"text":"Nu macca nayti kawo gadho alleeqisanaw,","poem":1},{"text":"oosetida tuuqe mela gido.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nu shaaleti dumma dumma katha qommon kumo;","poem":1},{"text":"heemetiya bessan de7iya nu dorsati","poem":2},{"lineBreak":true},{"text":"mukulaninne tammu mukulan yelo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nu miizati birayso;","poem":1},{"text":"awucayona yeletidi daro;","poem":2},{"lineBreak":true},{"text":"nu ogetan waasoy si7etofo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ha anjoti gakiya asati tuma anjetidaysata;","poem":1},{"text":"Xoossay entaw Godaa gidida asati anjetidaysata.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}