{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":145,"content":[{"type":"heading","content":["Xoossay Gita"]},{"type":"hebrew_subtitle","content":["Dawita Galata Mazmure"]},{"type":"verse","number":1,"content":["Ta Xoossaw, ta kawaw, ta nena gitayana;",{"text":"ne sunthaa merinaw galatana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taani nena ubba gallas sabbana;","poem":1},{"text":"ne sunthaa merinaw galatana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Goday gita; aadho galati iyaw bessees;","poem":1},{"text":"iya gitatethay asa qofape aadhees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Issi yeletay hara yeletas ne oosuwa odana;","poem":1},{"text":"ne malaalsiya oosota awaajana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Enti ne bonchuwa, ne teemaanne","poem":1},{"text":"ne gitatetha odana.","poem":2},{"lineBreak":true},{"text":"Taani ne malaalsiya oosuwa","poem":2},{"lineBreak":true},{"text":"zaara zaarada qopana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Malaalisiya gita ne oosuwaba odana;","poem":1},{"text":"taani ne gitatetha awaajana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Enti ne keehatetha darotethaa odana;","poem":1},{"text":"ne xillotethabaa ufaysan yexana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Goday keehanne qadheteysa;","poem":1},{"text":"hanqetanaw ellesenna; siiqon kumidaysa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Goday ubbaas keeha;","poem":1},{"text":"I ba medhetetha ubbaas qadhetees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Godaw, medhetetha ubbay nena galatana;","poem":1},{"text":"ne asa ubbay nena sabbana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Enti ne kawotethaa bonchuwaba odana;","poem":1},{"text":"ne wolqaaba odana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hessan enti ne wolqaama oosuwabaanne","poem":1},{"text":"ne kawotethaa boncho teemaba erisana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ne kawotethay merina kawotethi;","poem":1},{"text":"ne maatay yeleta ubbaa haarees.","poem":2},{"lineBreak":true},{"text":"Goday ba gida qaala ubban ammanetees;","poem":2},{"lineBreak":true},{"text":"ba ooso ubban keeha.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Goday kundanaw gedgadeyisata katisees;","poem":1},{"text":"kundidaysata denthees.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ubbaa ayfey nena xeellees;","poem":1},{"text":"entaw koshshiya woden kathi immaasa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Neeni ne kushiya miccada,","poem":1},{"text":"medhetetha ubbaa amo alaasa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Xoossay ba oge ubban xillo;","poem":1},{"text":"ba ooso ubban keeha.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Goday bana xeegiya ubbaas,","poem":1},{"text":"tuman bana xeegiya ubbaas matan de7ees.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"I baw yayyeyisata amuwa kunthees;","poem":1},{"text":"enta waasuwa si7idi ashshees.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Goday bana doseyisata ubbaa naagees;","poem":1},{"text":"shin iitata ubbaa dhaysana.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Taani ta doonan Godaa galatana;","poem":1},{"text":"Medhetetha ubbay iya geeshsha sunthaa","poem":2},{"lineBreak":true},{"text":"merinaw galato!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}