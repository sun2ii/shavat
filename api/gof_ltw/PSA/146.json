{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":146,"content":[{"type":"heading","content":["Kawotan Ammanetofite"]},{"type":"verse","number":1,"content":[{"text":"Godaa galatite!","poem":1},{"text":"Ta shempe Godaa galata!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta de7o laytha ubban Godaa galatana;","poem":1},{"text":"ta de7ida wode ubban ta Xoossaa sabbana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Halaqatan ammanetofite;","poem":1},{"text":"ashshanaw danda7onna asa na7an ceeqetofite.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Enta shempoy keyiya wode biittako simmoosona;","poem":1},{"text":"enta halchoy ubbay he gallas aadhees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yayqooba Xoossay maaddiya asinne","poem":1},{"text":"Godaa, ba Xoossan ufaysi oothiya asi anjetidaysa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Goday salonne sa7aa,","poem":1},{"text":"abbanne iya giddon de7iya ubbaa medhis;","poem":2},{"lineBreak":true},{"text":"Xoossay merinaw ammanetees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Goday un7etidaysatas pirdees;","poem":1},{"text":"koshatidaysatas kathi immees;","poem":2},{"lineBreak":true},{"text":"Goday qashetidaysata birshees;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Goday qooqeta xeelisees.","poem":1},{"text":"Goday kundidaysata denthees;","poem":2},{"lineBreak":true},{"text":"Goday xillota dosees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Goday bete asata naagees;","poem":1},{"text":"Am7etanne yi7o nayta maaddees;","poem":2},{"lineBreak":true},{"text":"shin iitata ogiya dhaysees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Goday merinaw kawotana;","poem":1},{"text":"Xiyoone, ne Xoossay,","poem":2},{"lineBreak":true},{"text":"yeletethafe yeletethi gakanaw kawotana.","poem":2},{"lineBreak":true},{"text":"Godaa galatite!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}