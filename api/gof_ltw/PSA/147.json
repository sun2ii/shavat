galata yethi yexite;","poem":1},{"text":"nu Xoossaas diithan yexite.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"I saluwa shaara mayzees;","poem":1},{"text":"biittas ira immees;","poem":2},{"lineBreak":true},{"text":"zumata bolla maata dolisees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mehetas kathi,","poem":1},{"text":"Koshatidi waassiya quuro naytas","poem":2},{"lineBreak":true},{"text":"miyaba immees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"I parata wolqaninne","poem":1},{"text":"tooranchota minotethan ufaytenna.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Shin Goday baw yayyeysataninne","poem":1},{"text":"iya maarotan ammaneteysatan ufaytees.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yerusalaame, Godaa galata!","poem":1},{"text":"Xiyoone, ne Xoossaa galata!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"I ne pengiya kobeta minthana;","poem":1},{"text":"ne giddon de7iya ne asaa anjana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"I ne zawa sarotethan naagana;","poem":1},{"text":"nena lo77o gisten kalsana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"I ba kiitaa biittas yeddees;","poem":1},{"text":"iya qaalay eeson gakees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"I shachi bullukoda miccees;","poem":1},{"text":"caagana bidoda laallees.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"I shacha shuchada holees;","poem":1},{"text":"iya meeguwan oonika eqanaw danda7enna.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"I ba qaala kiittidi shacha maaysees.","poem":1},{"text":"I carkuwa kiittin haathi goggees.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"I ba qaala Yayqoobas,","poem":1},{"text":"ba higgiyanne wogaa","poem":2},{"lineBreak":true},{"text":"Isra7eeles awaajees.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"I hara kawotethatas hessa oothibeenna;","poem":1},{"text":"enti iya higgiya erokona.","poem":2},{"lineBreak":true},{"text":"Godaa galatite!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}