{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":148,"content":[{"type":"heading","content":["Xoossa Suntha Galatite"]},{"type":"verse","number":1,"content":[{"text":"Godaa galatite!","poem":1},{"text":"Salope Godaa galatite;","poem":2},{"lineBreak":true},{"text":"bolla dhoqan iya galatite.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iya kiitanchoti ubbay iya galatite;","poem":1},{"text":"Salon de7iya iya olanchoti ubbay iya galatite.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Away, ageenay iya galatite;","poem":1},{"text":"poo7iya xoolintoti ubbay iya galatite.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dhoqa saloti iya galatite;","poem":1},{"text":"Salope bollara de7iya haathati iya galatite.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Enti ubbay Godaa sunthaa galato;","poem":1},{"text":"I kiittin enti medhetidosona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I enta merinaw enta bessan bessan wothis;","poem":1},{"text":"shaaretonna higge entaw immis.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sa7ape Godaa galatite!","poem":1},{"text":"abban de7iya gita medhetethato;","poem":2},{"lineBreak":true},{"text":"abba ciimmoto ubbay iya galatite.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wol7anthaw, shachaw, shaaraw,","poem":1},{"text":"caaganaw, iya kiita poliya carkuwaw,","poem":2},{"lineBreak":true},{"text":"ubbay iya galatite.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dereto, zumato,","poem":1},{"text":"meetetiya ayfe ayfiya mithato, zigato,","poem":2},{"lineBreak":true},{"text":"ubbay iya galatite.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Meheto, do7ato,","poem":1},{"text":"sa7ara gooshetiya medhetethato,","poem":2},{"lineBreak":true},{"text":"paalliya kafoto ubbay iya galatite.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kawoto, kawotethato,","poem":1},{"text":"halaqato, deriya haareysato,","poem":2},{"lineBreak":true},{"text":"ubbay iya galatite.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Panthato, geela7oto, cimato, nayto,","poem":1},{"text":"ubbay iya galatite.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Iya sunthay ubbaafe dhoqa gidiya gishonne","poem":1},{"text":"iya bonchoy salotapenne sa7ape dhoqa gidiya gisho,","poem":2},{"lineBreak":true},{"text":"enti ubbay Godaa sunthaa galato.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iyaw mata gidida Isra7eele,","poem":1},{"text":"I dhoqu dhoqu oothis;","poem":2},{"lineBreak":true},{"text":"iya galatana mela enta minthethis.","poem":2},{"lineBreak":true},{"text":"Godaa galatite!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}