"number":7,"content":[{"text":"Hessan enti kawotethata bolla halo keyana;","poem":1},{"text":"asaa seerana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Enta kawota santhalaatan,","poem":1},{"text":"enta moorinnata biratan qachana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Enta bolla xaafetida pirdaa polana;","poem":1},{"text":"Hessi Xoossaa asata ubbaas xoono.","poem":2},{"lineBreak":true},{"text":"Godaa galatite!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}