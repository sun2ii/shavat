{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":16,"content":[{"type":"heading","content":["Xoossay Ta Laata"]},{"type":"hebrew_subtitle","content":["Dawita Woosa."]},{"type":"verse","number":1,"content":["Abeeti Xoossaw,",{"text":"ta neeko baqatiya gisho tana naaga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taani Xoossaa, “Neeni ta Godaa;","poem":1},{"text":"neepe attishin, hari lo77obay taw baawa” yaagas.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sa7an de7iya geeshshati","poem":1},{"text":"ay mela bonchetidonaa!","poem":2},{"lineBreak":true},{"text":"Ta entara issife ufaytayis.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hara xoossata kaalleysati","poem":1},{"text":"banta bolla meto darsoosona.","poem":2},{"text":"Shin taani hara xoossatas suuthi yarshike;","poem":1},{"text":"taani enta sunthaa xeegike.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ta Godaw ta laatay nena;","poem":1},{"text":"taw koshshiya ubbaa taw immaasa;","poem":2},{"lineBreak":true},{"text":"ta de7uwa saamay nena.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tana gakida saamay ay mela lo77o!","poem":1},{"text":"Ee ta laatay tuma lo77o!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tana zorida Godaa galatayis;","poem":1},{"text":"qamma ta wozanay tana tamaarsees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Taani ubba wode Godaa ta sinthan be7ayis;","poem":1},{"text":"I ta ushachan de7iya gisho dagammike.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hessa gisho, ta wozanay ufaytees;","poem":1},{"text":"ta inxarsay galatees;","poem":2},{"lineBreak":true},{"text":"ta asatethay hirgi bayna de7ees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta shempiw si7oolen aggaka;","poem":1},{"text":"ne Geeshshaa wooqana mela oothaka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tana de7o ogiya bessaasa;","poem":1},{"text":"ne sinthan kumetha ufaysi de7ees;","poem":2},{"lineBreak":true},{"text":"ne ushachan merinaa injey de7ees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}