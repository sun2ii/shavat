{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":17,"content":[{"type":"heading","content":["Xillo Asa Woosa"]},{"type":"hebrew_subtitle","content":["Dawita Woosa."]},{"type":"verse","number":1,"content":["Abeeti Godaw, ta xillo maggannuwa si7a;",{"text":"taani neeko waassiya waasuwa hayza.","poem":2},{"text":"Cimon gidonashin tuman,","poem":1},{"text":"woossiya woosa zaara.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne xillo pirday taw qonco;","poem":1},{"text":"ne ayfey tumaa xeello.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Neeni qamma tana xomoosadasa;","poem":1},{"text":"ta wozanaa paacadasa.","poem":2},{"text":"Shin paacadaka ta bolla aykoka demmabaaka;","poem":1},{"text":"ta inxarsayka baletibeenna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taani hara asatada iitabaa haasayike;","poem":1},{"text":"taani ne qaala naagiya gisho, gene ogiya kaallabike.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ta tohoy dhubetonna mela,","poem":1},{"text":"ta tangoy ne ogiyape gaxa keybeenna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Abeeti Xoossaw ta woosa ne si7iya gisho,","poem":1},{"text":"taani nena woossayis.","poem":2},{"text":"Ne haythaa taako zaarada,","poem":1},{"text":"ta qaala si7a.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Banta morketape baqateyisata,","poem":1},{"text":"ne ushacha kushen qottada ashsheyso,","poem":2},{"lineBreak":true},{"text":"ne keehatetha malaalsiya ogen bessa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne ayfe na77e mela tana naaga;","poem":1},{"text":"ne qefiya garsan tana qosa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tana un7ethiya iitatape;","poem":1},{"text":"teqidi oykida morketape ashsha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Entaw qadhey baawa;","poem":1},{"text":"otoron haasayoosona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tana gooddidi oykidosona; teqidosona;","poem":1},{"text":"tana biittan holidi yegganaw xeelloosona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Enti miyaba koyiya gaammo mela;","poem":1},{"text":"qosetidi naagiya wodala gaammo mela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Godaw, denda;","poem":1},{"text":"ta morketara eqetada enta sa7an yegga;","poem":2},{"lineBreak":true},{"text":"ne mashshan iitata kushepe tana ashsha.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Godaw, haysa mela asape tana qosa;","poem":1},{"text":"enta qaaday sa7aba gidida asape","poem":2},{"lineBreak":true},{"text":"ne kushen tana ashsha.","poem":2},{"text":"Ne minjida seeran enta kalsa;","poem":1},{"text":"he seeray enta naytas gididi,","poem":2},{"lineBreak":true},{"text":"enta nayta naytas palaho.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Shin taani xillotethan ne som7uwa be7ana;","poem":1},{"text":"ta barkiya wode ne malaa be7ada ufaytana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}