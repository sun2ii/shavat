{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":18,"content":[{"type":"heading","content":["Xoono Mazmure"]},{"type":"hebrew_subtitle","content":["Zammaareta Halaqaas Xaafetida Dawita Mazmure"]},{"type":"hebrew_subtitle","content":["Goday iya morketapenne Saa7ola kushepe ashshida wode Dawiti Godaas yexida mazmure."]},{"type":"verse","number":1,"content":["Abeeti Godaw, ta wolqaw,",{"text":"taani nena dosayis.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Goday ta zaalla; ta miixa; tana ashsheysa;","poem":1},{"text":"ta Xoossay ta iyako baqatiya ta zaalla.","poem":2},{"text":"I taw gondalle; tana ashshiya wolqa;","poem":1},{"text":"taani qosetada attiya besse.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Galata bessiya Godaa ta xeegayis;","poem":1},{"text":"ta morketape taani attana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hayqo wodoroy tana cuullis;","poem":1},{"text":"dhayo di7oy tana daganthis.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Duufo wodoroy ta bolla xaaxetis;","poem":1},{"text":"hayqo xihey tana oykis.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ta un7an Godaa xeegas;","poem":1},{"text":"tana maaddana mela ta Xoossaako waassas.","poem":2},{"text":"Ba keethan gididi ta girsaa si7is;","poem":1},{"text":"ta waasoy iya haythan wodhis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Xoossay hanqetida gisho,","poem":1},{"text":"biittay qaaxis;","poem":2},{"lineBreak":true},{"text":"dereta xaphoy kokoris.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iya siidhiyape hanqo cuyay keyis;","poem":1},{"text":"iya doonape miya tama lacoy keyis;","poem":2},{"lineBreak":true},{"text":"I xuuggiya bonqo cuttis.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Saluwa phalqidi wodhis;","poem":1},{"text":"iya tohuwape garsan dhuma shaari de7ees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kiruubeta bolla uttidi paallis;","poem":1},{"text":"carko qefen pude dendis.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bana dhuman kammis;","poem":1},{"text":"iya dunkaaney iran kumida shaara.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Iya sinthan de7iya gita poo7uwape","poem":1},{"text":"shachinne tama lacoy keyidi","poem":2},{"lineBreak":true},{"text":"dhuma shaara kanthidi bis.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Goday dadada salope guummis;","poem":1},{"text":"Ubbaafe Dhoqa Xoossay ba girsaa sissis;","poem":2},{"lineBreak":true},{"text":"wol7anthaninne tama lacon qoncis.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ba dongiya dukidi ba morketa laallis;","poem":1},{"text":"wol7antha poo7o kiittidi enta yedethis.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Abeeti Godaw, neeni seerida wode,","poem":1},{"text":"shenetada peenuqida wode,","poem":2},{"text":"Abbay zin7ida biittay bentis;","poem":1},{"text":"sa7a baasoy qoncis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Goday bollafe kushiya yeddidi tana oykis;","poem":1},{"text":"ciimmo haathaafe tana dafidi kessis.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ta bolla daro wolqaamida","poem":1},{"text":"ta morketapenne","poem":2},{"lineBreak":true},{"text":"tana ixeysatape ashshis.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ta metootida wode enti ta bolla dendidosona;","poem":1},{"text":"shin Goday tana katisis.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"I tana dalga bessi kessis;","poem":1},{"text":"tanan ufaytida gisho tana ashshis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ta xillotethaada Goday taw qanxis;","poem":1},{"text":"ta kushe geeshshatethaada I taw zaaris.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Taani Godaa ogiya kaallas;","poem":1},{"text":"ta Xoossaa aggada kare keyabike.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Taani iya higgiya ubbaa naagas;","poem":1},{"text":"iya kiitaa polo aggabike.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Taani iya sinthan suure de7as;","poem":1},{"text":"tana nagarape naagas.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Goday ta xillotethaadanne","poem":1},{"text":"ta kushe geeshshatethaada taw zaaris.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ammaneteysatas ne ammanetaasa;","poem":1},{"text":"suuretas ne suure.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Geeshshatas ne geeshshi;","poem":1},{"text":"shin geellatas ne geella.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ashketa ashshaasa;","poem":1},{"text":"shin otoranchota kawushaasa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Abeeti Godaw, ne taw xompaasa;","poem":1},{"text":"ta Xoossay ta dhumaa poo7isaasa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ne maaduwan ta morke toora bolla dendayis;","poem":1},{"text":"ta Xoossan miixaa xeerara gupada aadhayis.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Xoossaa ogey polo;","poem":1},{"text":"Godaa qaalay geeshshi;","poem":2},{"lineBreak":true},{"text":"iyako baqatiya ubbaas I gondalle.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Godaape attishin, hara xoossi oonee?","poem":1},{"text":"nu Xoossaafe attishin, hara zaalli oonee?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Taw wolqa immeynne","poem":1},{"text":"ta ogiya saro oothey Xoossaa.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"I ta tohuwa gen7e tohoda minthees;","poem":1},{"text":"dhoqa bessan hirgi bayna essees.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Ta kushiya ola tamaarsees;","poem":1},{"text":"naase birata dongiya dukana mela","poem":2},{"lineBreak":true},{"text":"ta qessiya minthees.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Tana ashshiya ne gondalliya taw immadasa;","poem":1},{"text":"ne ushacha kushey tana zempisees;","poem":2},{"lineBreak":true},{"text":"ne lo77o oykethay tana gitayees.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ta hemetiya bessaa dalgisadasa;","poem":1},{"text":"ta tohuwa harchuchi ekibeenna.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Ta morketa yedethada oykas;","poem":1},{"text":"enta dhaysona guye simmike.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Enti zaari dendonnaada shocas;","poem":1},{"text":"enti ta tohuwa garsan kundidosona.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Olas tana dancisadasa;","poem":1},{"text":"taara gaaddeteyisata taw gulbatisadasa.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Ta morketa ta sinthafe guye zaaradasa;","poem":1},{"text":"tana ixeyisata dhaysas.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Maade koyidi waassidosona,","poem":1},{"text":"shin oonika enta ashshibeenna.","poem":2},{"text":"Godaa enti xeegidosona,","poem":1},{"text":"shin I entaw koybeenna.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Carkoy pitidi efiya baanada enta liiqisas;","poem":1},{"text":"oge urqada enta yedhas.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Gene asape tana ashshadasa;","poem":1},{"text":"tana kawotethata bolla shuumadasa;","poem":2},{"lineBreak":true},{"text":"ta eronna asay taw haaretidosona.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Enti tabaa si7idi taw kiitetoosona;","poem":1},{"text":"allaga derey ta sinthan ziggees.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Enti kaha dhayidosona;","poem":1},{"text":"banta miixape kokorishe yoosona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"Goday de7ees!","poem":1},{"text":"Xoossay, ta zaallay galatetto!","poem":2},{"lineBreak":true},{"text":"Tana ashshiya Xoossay dhoqu dhoqu go!","poem":2}]},{"type":"verse","number":47,"content":[{"text":"I taw halo kessiya Xoossaa;","poem":1},{"text":"kawotethata ta garsan haariseysa.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Ta morketape tana ashsheysa;","poem":1},{"text":"tana ixeyisata bolla dhoqu dhoqu oothaasa;","poem":2},{"lineBreak":true},{"text":"iitatape tana ashshaasa.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Hessa gisho, Godaw","poem":1},{"text":"kawotethata giddon taani nena galatana;","poem":2},{"lineBreak":true},{"text":"ne sunthaa sabbana.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"I ba kawas xoono immees;","poem":1},{"text":"ba tiyidaysas, Dawitasinne iya kochaas,","poem":2},{"lineBreak":true},{"text":"ba keehatetha bessees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/17.json","previousChapterAudioLinks":{},"numberOfVerses":50}