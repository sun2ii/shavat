{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":19,"content":[{"type":"heading","content":["Xoossa Higgen Borey Baawa"]},{"type":"hebrew_subtitle","content":["Zammaareta Halaqaas Xaafetida Dawita Mazmure."]},{"type":"verse","number":1,"content":["Saloti Xoossaa bonchuwa haasayoosona;",{"text":"salo gufanthoy iya kushe oosuwa awaajees.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Issi gallasi hara gallassas hessa odees;","poem":1},{"text":"issi qammi hara qammas eratethi qoncisees.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Odi woyko qaali baawa;","poem":1},{"text":"enta girsay si7etenna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gidoshin enta oday sa7a ubban laaletis;","poem":1},{"text":"enta qaalay biitta gaxaa gakis.","poem":2},{"text":"Awi de7iya bessi Xoossay salon giigisis.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ba soope keyiya mishirada,","poem":1},{"text":"gaadde woxanaw ufaytidi giigida asada,","poem":2},{"lineBreak":true},{"text":"away wonta wonta keyees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Issi bagga salo gaxape keyidi,","poem":1},{"text":"hara bagga salo gaxa gakanaw bees;","poem":2},{"lineBreak":true},{"text":"iya suulape geemmiyabay baawa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Godaa higgey suure;","poem":1},{"text":"shempo zaarees.","poem":2},{"text":"Godaa kiitay ammanetidaysa;","poem":1},{"text":"akeeki pacidaysata cinca oothees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Godaa wogay like;","poem":1},{"text":"wozana ufaysees.","poem":2},{"lineBreak":true},{"text":"Godaa kiitay geeshshi;","poem":2},{"lineBreak":true},{"text":"ayfe poo7isees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Godaas yashshi geeshshi;","poem":1},{"text":"merinaw eqidi de7ees.","poem":2},{"lineBreak":true},{"text":"Godaa pirday kumethi tumanne xillo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Worqafe aadhidi koyetees;","poem":1},{"text":"walahi bayna worqafe aadhidi lo77o.","poem":2},{"text":"Eessafe aadhidi lo77o","poem":1},{"text":"ililo eessafe aadhidi mal7o.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne aylley naagetana mela zorees;","poem":1},{"text":"ne higgiya naagoy daro go77ees.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ba qohuwa demmey oonee?","poem":1},{"text":"Abeeti Godaw, geemmida nagarape tana geeshsha.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tana ne aylliya,","poem":1},{"text":"erishe oothiya nagarape naaga.","poem":2},{"text":"Nagari tana haaronna mela maadda;","poem":1},{"text":"he wode taani suure gidana,","poem":2},{"lineBreak":true},{"text":"gita balape geeyana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Abeeti Godaw, ta zaallaw, tana wozeyso;","poem":1},{"text":"ta doonape keyiya qaalaynne","poem":2},{"lineBreak":true},{"text":"ta wozanaa qofay nena ufaysiyabaa gido.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}