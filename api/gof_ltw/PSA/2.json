awaajana;","poem":1},{"text":"Goday tana, “Neeni ta na7aa;","poem":2},{"lineBreak":true},{"text":"taani hachi new aawa gidas.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne tana oycha;","poem":1},{"text":"ta new kawotethata immana;","poem":2},{"lineBreak":true},{"text":"sa7a ubbay nebaa gidana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neeni birata xam7an enta menthana;","poem":1},{"text":"meqa miisheda enta tincherethana” yaagis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hiza, kawoto eeyopite;","poem":1},{"text":"ha sa7aa haareysato akeekite.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Godaa yashshan goyinnite;","poem":1},{"text":"kokoridi kiitetite.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Goday hanqetin ogen hinte dhayonnaada","poem":1},{"text":"iya tumatethan goyinnite.","poem":2},{"text":"Iya hanqoy eeson eexi keyana;","poem":1},{"text":"iyan qosetidi attida ubbay anjetidaysata.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}