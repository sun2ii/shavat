{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":21,"content":[{"type":"heading","content":["Kawoy Xoossan Ufaytees"]},{"type":"hebrew_subtitle","content":["Zammaareta Halaqaas Xaafetida Dawita Mazmure."]},{"type":"verse","number":1,"content":["Godaw, kawoy ne wolqan ufaytees;",{"text":"ne immida xoonuwan hashshu gees.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iya Wozanaa amuwa iyaw immadasa;","poem":1},{"text":"iya mettersha woosa iya diggabaaka. Salaha","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lo77o anjora iya mokaasa;","poem":1},{"text":"walahi bayna worqa kallacha iya huuphen wothaasa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I nena de7o oychis;","poem":1},{"text":"daro laythinne adussa de7o immadasa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neeni iyaw xoono immida gisho,","poem":1},{"text":"iya bonchoy daris;","poem":2},{"lineBreak":true},{"text":"gitatethinne teema iyaw immadasa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Merinaa anjuwa iyaw immadasa;","poem":1},{"text":"ne bentuwan iya ufaysaasa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kawoy Godan ammanetees;","poem":1},{"text":"Ubbaafe dhoqa Xoossaa maarotay,","poem":2},{"lineBreak":true},{"text":"iyara de7iya gisho I dagammenna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne kushey ne morketa,","poem":1},{"text":"ne ushacha kushey nena ixeyisata demmana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ne qonciya wode cooce tamada enta xuuggana;","poem":1},{"text":"Goday ba hanqo suulon enta mittana;","poem":2},{"lineBreak":true},{"text":"iya tamay enta maana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Neeni enta nayta biittafe,","poem":1},{"text":"enta kochaa asaa giddofe dhaysana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne morketi ne bolla tobboosona;","poem":1},{"text":"iitabaa maqetoosona, shin polokona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Neeni enta ne dongiyan dukana;","poem":1},{"text":"enta guye zaarada gooddana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Godaw, ne minotethan dhoqu dhoqu ga;","poem":1},{"text":"ne wolqaa gisho galata mazmure yexoos.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}