{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":22,"content":[{"type":"heading","content":["Xillo Asa Metonne Ufaysi"]},{"type":"hebrew_subtitle","content":["Zammaareta Halaqaas Xaafetida Dawita Mazmure"]},{"type":"hebrew_subtitle","content":["“Guura gen7e” geetetiya diitha cuudhethan yexetida mazmure"]},{"type":"verse","number":1,"content":[{"text":"Ta Xoossaw, ta Xoossaw, tana ayis aggadii?","poem":1},{"text":"Tana maadda gada ta nena woossiya wode,","poem":2},{"lineBreak":true},{"text":"ayis taape haakay?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta Xoossaw, gallas kumethi ta neeko waassas;","poem":1},{"text":"shin ne tana allaka.","poem":2},{"lineBreak":true},{"text":"Qamma ubban neeko waassayis,","poem":2},{"lineBreak":true},{"text":"shin wopatethi demmike.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gidoshin neeni geeshshi;","poem":1},{"text":"Isra7eele galatay ne araata yuushon de7ees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nu aawati nenan ammanetidosona;","poem":1},{"text":"nenan ammanetin, ne enta ashshadasa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neeko waassidi attidosona;","poem":1},{"text":"nenan ammanetidi yeellatibookona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Shin ta ase gidike; guxune;","poem":1},{"text":"ta asan kadhetidaysanne boretidaysa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tana be7iya ubbay qelqisoosona;","poem":1},{"text":"banta huuphiya qaathishe dereeqosona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“I Godan ammanetis; ane iya asho;","poem":1},{"text":"Goday iya dosiko, ane iya asho” yaagosona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gidoshin taani ta aaye ulope","poem":1},{"text":"suure yeletanaada oothiday nena.","poem":2},{"text":"Ta aaye dhantha dhammiya wodeka","poem":1},{"text":"tana naagiday nena.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta yeletoosope doomada nenan diccas;","poem":1},{"text":"ta aaye ulope doomin ne ta Xoossaa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Metoy taako matiya gishonne","poem":1},{"text":"tana maaddiya asi bayna gisho,","poem":2},{"lineBreak":true},{"text":"ha77i neeni taape haakofa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Daro morketi qayciya boorada tana teqidosona;","poem":1},{"text":"qayciya Baasane kormatada tana oykidosona.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mentherethidi gudiya gaammoda","poem":1},{"text":"banta doona ta bolla dooyosona.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Taani haathada goggas;","poem":1},{"text":"ta meqethay ba kesuwape keyis;","poem":2},{"lineBreak":true},{"text":"ta wozanay oysada ta gaathan til7is.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ta qoodhey kun7ada melis;","poem":1},{"text":"ta inxarsay kottonuwara oyketis;","poem":2},{"lineBreak":true},{"text":"ne tana hayqida asada baanan yeggadasa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kanati tana teqidosona;","poem":1},{"text":"iita asati ta yuushuwa oykidosona;","poem":2},{"lineBreak":true},{"text":"ta kushetanne ta tohota caddoosona.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ta meqethati taybetoosona;","poem":1},{"text":"ta morketi tana dereeqosona.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ta ma7uwa shaakidi ekoosona;","poem":1},{"text":"ta adussa ma7uwa bolla saama yeggoosona.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ta Godaw, ne ta matay taape haakofa;","poem":1},{"text":"Ta wolqaw, tana maaddanaw ellesada haaya.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Tana mashshafe kessa eka;","poem":1},{"text":"ta al7o de7uwa kanatape ashsha.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Gaammota doonape tana ashsha;","poem":1},{"text":"qayciya bazzo boorata kacepe tana naaga.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Taani ne sunthaa ta ishatas odana;","poem":1},{"text":"enta shiiquwan nena galatana.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hinteno, Godaa yayyesato, iya galatite;","poem":1},{"text":"hinteno, Yayqooba zareto, iya bonchite.","poem":2},{"text":"Hinteno, Isra7eele kochato,","poem":1},{"text":"yashshan iya dhoqu dhoqu oothite.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"I un7etidaysa kadhenna;","poem":1},{"text":"enta qohuwa be7ishe qelli geenna.","poem":2},{"text":"Ba som7uwa entafe genthenna;","poem":1},{"text":"enti iyako waassiya wode,","poem":2},{"lineBreak":true},{"text":"entaw zoko zaaribeenna.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ta ne lo77o oosuwa gisho gita shiiqon galatana;","poem":1},{"text":"ta qangetha new yayiya asaa sinthan gathana.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Manqoti midi kallana;","poem":1},{"text":"Godaa koyeysati iya galatana;","poem":2},{"lineBreak":true},{"text":"enti merinaw ufaysan daana.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Sa7a gaxa gakanaw de7iya asa ubbay,","poem":1},{"text":"akeekan Godaako simmana;","poem":2},{"lineBreak":true},{"text":"asa zare ubbay iya goyinnana.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Maati ubbay Godaasa;","poem":1},{"text":"I kawotethata haarees.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Sa7an de7iya dure ubbay iya goyinnana;","poem":1},{"text":"bantanan hayqope ashshanaw danda7onaysatinne","poem":2},{"lineBreak":true},{"text":"biitta simmiya ubbay iyaw gulbatana.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Yaana yeletay iyaw kiitetana;","poem":1},{"text":"sintha yeletas Godaaba odana.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Buroo yeletiboona asaska,","poem":1},{"text":"iya geeshshatetha odana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}