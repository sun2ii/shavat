;","poem":2},{"lineBreak":true},{"text":"ta wancay kumidi goggana gakanaw kunthaasa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne keehatethaynne ne maarotethay","poem":1},{"text":"ta de7o laytha ubban tana kaallana;","poem":2},{"lineBreak":true},{"text":"taani Godaa keethan merinaw daana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}