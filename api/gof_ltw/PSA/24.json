ayqooba Xoossaa som7uwa","poem":2},{"lineBreak":true},{"text":"koyiya asi hessa mela ase. Salaha","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Boncho kawoy gelana mela,","poem":1},{"text":"hinteno pengeto dooyetite;","poem":2},{"lineBreak":true},{"text":"beni pengeti iya ufaysan mokite.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"He boncho kawoy oonee?","poem":1},{"text":"Minonne wolqaama gidida Godaa;","poem":2},{"lineBreak":true},{"text":"olan wolqaama gidida Godaa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Boncho kawoy gelana mela,","poem":1},{"text":"hinteno pengeto dooyetite;","poem":2},{"lineBreak":true},{"text":"beni pengeti iya ufaysan mokite.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ha boncho kawoy oonee?","poem":1},{"text":"Ha boncho kawoy salo medhetethata Godaa! Salaha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}