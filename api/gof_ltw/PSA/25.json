{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":25,"content":[{"type":"heading","content":["Un7a Wode Woosa"]},{"type":"hebrew_subtitle","content":["Dawita Mazmure"]},{"type":"verse","number":1,"content":["Abeeti Godaw,",{"text":"shempofe ta nena woossayis.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abeeti ta Xoossaw, ta nenan ammanetayis;","poem":1},{"text":"tana yeellayopa;","poem":2},{"lineBreak":true},{"text":"ta morketas tana aathada immofa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nenan ufaysi ootheysati yeellatokona;","poem":1},{"text":"shin gaasoy bayna geneysati yeellatana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Abeeti Godaw, tana ne ogiya bessa;","poem":1},{"text":"ne geedo tana kaaletha.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tana ashshiya Xoossay nena gidiya gisho,","poem":1},{"text":"ne tumatethaa tana kaalethanne tamaarsa;","poem":2},{"lineBreak":true},{"text":"gallas kumetha ta nenan ufaysi oothayis.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Abeeti Godaw, benipe de7iya","poem":1},{"text":"ne qadhiyanne ne keehatetha hassaya.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta na7atetha nagaraanne iitaba hassayopa;","poem":1},{"text":"abeeti Godaw, ne keehatethaanne lo77otetha hassaya.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Goday keehanne suure gidiya gisho;","poem":1},{"text":"nagaranchota ba ogiya tamaarsees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ashketa suuretethan kaalethees;","poem":1},{"text":"entana ba ogiya tamaarsees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Godaa caaquwanne","poem":1},{"text":"iya kiitaa naageysatas","poem":2},{"lineBreak":true},{"text":"iya oge ubbay tumanne keeha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abeeti Godaw, ta nagaray daro;","poem":1},{"text":"gidoshin ne sunthaa gisho taw atto ga.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Godaa yayiya asi oonee?","poem":1},{"text":"I kaallanaw bessiya ogiya","poem":2},{"lineBreak":true},{"text":"Goday iya tamaarsana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"I ubba wode duretethan daana;","poem":1},{"text":"iya nayti biitta laattana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Goday yayyeysatas ba xuuraa genthenna;","poem":1},{"text":"I entaw ba caaquwa erisees.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Goday ta tohuwa xihepe naagiya gisho,","poem":1},{"text":"ta ayfey maado ekanaw ubba wode iyako xeellees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Godaw, taani bizzanne","poem":1},{"text":"metootida asi gidiya gisho,","poem":2},{"lineBreak":true},{"text":"taako simma; ne maarotethaa tana bessa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Taw hirgi daris;","poem":1},{"text":"ta metuwape tana ne ashsha.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ta metuwanne ta waayiya be7a;","poem":1},{"text":"ta nagara ubbaa atto ga.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ta morketi ay mela daridaako be7a;","poem":1},{"text":"enti tana ay mela ixiyako xeella.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ne tana naaga; ne tana ashsha;","poem":1},{"text":"ta neeko baqatiya gisho tana yeellayopa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ta nenan ufaysi oothida gisho,","poem":1},{"text":"suuretethinne tumatethi tana naago.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Abeeti Xoossaw, Isra7eele asaa","poem":1},{"text":"enta meto ubbaafe ne woza.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}