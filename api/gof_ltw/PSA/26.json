{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":26,"content":[{"type":"heading","content":["Xillo Asa Woosa"]},{"type":"hebrew_subtitle","content":["Dawita Mazmure"]},{"type":"verse","number":1,"content":["Abeeti Godaw, ta suuretethan hemetida gishonne",{"text":"sidhey bayna nenan ammanetida gisho,","poem":2},{"lineBreak":true},{"text":"taw pirda.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abeeti Godaw, tana paaca;","poem":1},{"text":"tana pilgada be7a;","poem":2},{"lineBreak":true},{"text":"ta wozanaa xomoosa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne siiqoy ta sinthan de7iya gisho,","poem":1},{"text":"ta ubba wode ne tuma ogiyan hemetayis.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Cimmiya asaara ta uttike;","poem":1},{"text":"cubbota maabaran gelike.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iitata duulata ta ixayis;","poem":1},{"text":"makallachotara issife uttike.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Abeeti Godaw, ta xillotethaa bessanaw","poem":1},{"text":"ta kushiya meeccayis;","poem":2},{"lineBreak":true},{"text":"ne yarsho bessa yuuyayis.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Galata mazmure yexashe","poem":1},{"text":"ne malaalsiya ooso ubba odana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abeeti Godaw, ne keethaanne,","poem":1},{"text":"ne bonchoy aqiya bessaa ta dosayis.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tana nagaranchotara issife pittofa;","poem":1},{"text":"asa suuthu gusseysatara ta shempuwa dhaysofa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Enta kushen iita halchoy de7ees;","poem":1},{"text":"enta ushacha kushen wodhaafey kumis.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Shin ta suuretethan hemetana;","poem":1},{"text":"tana woza; taw qadheta.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ta tohoy demba bessan eqis;","poem":1},{"text":"gita shiiquwan Godaa galatana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}