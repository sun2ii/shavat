{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":27,"content":[{"type":"heading","content":["Xoossara De7iya Asa Xaalatethi"]},{"type":"hebrew_subtitle","content":["Dawita Mazmure"]},{"type":"verse","number":1,"content":["Goday taw poo7onne tana ashsheysa;",{"text":"yaatin, ta oona yayiyanee?","poem":2},{"text":"Goday, ta de7oy naagetiya miixaa;","poem":1},{"text":"yaatin, ta ayis dagammanee?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iita asati, tana ixeysatinne ta morketi","poem":1},{"text":"tana wodhanaw hordofiya wode,","poem":2},{"lineBreak":true},{"text":"bantaw dhubetidi kundana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Morke toori tana teqiko","poem":1},{"text":"ta wozanay yayyenna.","poem":2},{"text":"Oli ta bolla dendiyakoka,","poem":1},{"text":"taani Godan ammanetayis.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ta Godaa issiba oychas;","poem":1},{"text":"hessika, ta de7o laytha ubban","poem":2},{"text":"Godaa keethan de7anaasa;","poem":1},{"text":"Godaa lo77otetha be7anaasanne","poem":2},{"lineBreak":true},{"text":"iya keethan iya koyanaasa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Meto gallas tana ba de7iya bessan genthana;","poem":1},{"text":"ba dunkaaniyan tana qosana;","poem":2},{"lineBreak":true},{"text":"tana dhoqa zaalla bolla essana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"He wode taani tana teqida","poem":1},{"text":"ta morketape aadhada,","poem":2},{"lineBreak":true},{"text":"dhoqu dhoqu gaana.","poem":2},{"text":"Taani iya dunkaaniyan","poem":1},{"text":"ufaytashe yarsho yarshana;","poem":2},{"lineBreak":true},{"text":"Godaa mazmuren galatana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abeeti Godaw,","poem":1},{"text":"ta nena xeegiya wode ne taw koya;","poem":2},{"lineBreak":true},{"text":"taw qadheta; tana si7a.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Neeni, “Ta som7uwa koyite” gadasa,","poem":1},{"text":"ta wozanay Abeeti Godaw,","poem":2},{"lineBreak":true},{"text":"“Ta ne som7uwa koyana” yaagis.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ne som7uwa taape genthofa;","poem":1},{"text":"tana maaddeyso; ne shenetada","poem":2},{"lineBreak":true},{"text":"tana ne aylliya guye zaaropa.","poem":2},{"text":"Abeeti tana ashshiya Xoossaw,","poem":1},{"text":"tana yeggofa; aggofa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta aawaynne ta aayiya tana aggikoka","poem":1},{"text":"Goday tana shiishidi ekana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abeeti Godaw, tana ne ogiya tamaarsa;","poem":1},{"text":"ta morketa gisho tana suure oge kaaletha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tana mandiya wordo markati","poem":1},{"text":"ta bolla wolqan dendida gisho,","poem":2},{"lineBreak":true},{"text":"tana ta morketa amuwas aathada immofa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Taani de7on de7ashe,","poem":1},{"text":"Godaa keehatetha be7anaysa ammanayis.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Godan ufaysi ootha;","poem":1},{"text":"minna, yayyofa;","poem":2},{"lineBreak":true},{"text":"Godan ufaysi ootha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}