{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":28,"content":[{"type":"heading","content":["Xoossay Taw Gondallenne Wolqa"]},{"type":"hebrew_subtitle","content":["Dawita Mazmure"]},{"type":"verse","number":1,"content":["Abeeti Godaw, ta zaallaw,",{"text":"ta nena xeegayis;","poem":2},{"lineBreak":true},{"text":"ne taw si77i goopa.","poem":2},{"text":"Ne si77i giiko,","poem":1},{"text":"ta duufo gelida asi gidayis.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Maade koyada ta waassiya wode;","poem":1},{"text":"ubbaafe geeshsha dunkaaniyako,","poem":2},{"lineBreak":true},{"text":"ta kushiya micciya wode ta woosa si7a.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iita oothiya iita asatara tana gathada oykofa;","poem":1},{"text":"enti banta wozanan gene qopishe,","poem":2},{"lineBreak":true},{"text":"banta doonan sarotethi haasayoosona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Enta oosuwada enta seera;","poem":1},{"text":"enta iitatethaada entaw qanxa.","poem":2},{"text":"Enta kushe oosuwada enta pirda;","poem":1},{"text":"entaw bessiya iitaa entaw zaara.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Enti Godaa oosuwanne iya kushe medhuwas,","poem":1},{"text":"besse immonna gisho Goday enta laallana;","poem":2},{"lineBreak":true},{"text":"zaaridi enta keexenna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ta woosa si7ida gisho","poem":1},{"text":"Goday galatetto.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Goday taw wolqanne gondalle;","poem":1},{"text":"ta wozanay iyan ammanetees;","poem":2},{"lineBreak":true},{"text":"ta iyan maadetas.","poem":2},{"text":"Ta wozanay iyan ufaytees;","poem":1},{"text":"ta iya mazmuren sabbana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Goday ba asaas wolqa;","poem":1},{"text":"ba dooridi kawa ashshiya miixa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Godaw, ne asaa ashsha;","poem":1},{"text":"nebaa gididaysata anja.","poem":2},{"text":"Enta heemmey nena gida;","poem":1},{"text":"enta merinaw tooka.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}