{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":3,"content":[{"type":"heading","content":["Meto Be7iya Ura Woosa"]},{"type":"hebrew_subtitle","content":["Dawiti ba na7a Abeseloomepe baqatida wode xaafida mazmure"]},{"type":"verse","number":1,"content":["Abeeti Godaw, ta morketi ay mela daridona!",{"text":"Ta bolla dendeysati aapune!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Daroti, “Xoossay iya ashshena” yaagidi,","poem":1},{"text":"tabaa haasayoosona. Salah","poem":2},{"noteId":0}]},{"type":"verse","number":3,"content":[{"text":"Shin abeeti Godaw, ne taw gondalle;","poem":1},{"text":"ta bonchoynne tana dhoqu oothey nena.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ta qaala dhoqu oothada Godaako waassayis.","poem":1},{"text":"I ba geeshsha zumaape taw zaarees. Salah","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Goday tana naagiya gisho,","poem":1},{"text":"ta zin7asinne dhiskas","poem":2},{"lineBreak":true},{"text":"hirgi bayna barkas.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ubba bessara ta bolla dendida,","poem":1},{"text":"daro mukulu asaas yayyike.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abeeti Godaw, denda!","poem":1},{"text":"Abeeti ta Xoossaw tana ashsha!","poem":2},{"text":"Ta morketa gacuwa shoca;","poem":1},{"text":"iitata acha mentha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Xoonoy Godaasa;","poem":1},{"text":"Godaw, neeni ne asaa anja. Salah","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":": Mazmurey yexetiya wode azmaachesinne paydos giddon Godaa bonchoos kaa7etiya muuzuqa kaasse. Shin qaala birshethay eretenna.","reference":{"chapter":3,"verse":2}}]},"thisChapterLink":"/api/gof_ltw/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}