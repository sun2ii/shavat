{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":30,"content":[{"type":"heading","content":["Qohope Attida Asa Galata"]},{"type":"hebrew_subtitle","content":["Keethe Anjisos Dawiti Yexida Mazmure."]},{"type":"verse","number":1,"content":["Abeeti Godaw, ne tana ollafe kessida gishonne",{"text":"ta morketi ufaytonna mela oothida gisho,","poem":2},{"lineBreak":true},{"text":"ta nena dhoqu dhoqu oothana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abeeti Godaw, ta Xoossaw tana maaddana mela,","poem":1},{"text":"ta nena xeegin ne tana pathadasa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abeeti Godaw, duufo gelonnaada tana naagadasa;","poem":1},{"text":"ollan wodhonnaada tana paxa ashshadasa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hinteno Xoossaa asaw,","poem":1},{"text":"Godaas yexite;","poem":2},{"lineBreak":true},{"text":"iya geeshsha sunthaa sabbite.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iya hanqoy guutha wodesa,","poem":1},{"text":"shin iya keehatethay de7o laytha ubbaasa.","poem":2},{"text":"Qamma yeekishe aqiko,","poem":1},{"text":"wonta zawi bayna ufaysi gidees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ta naagetada de7eysa erida wode","poem":1},{"text":"“Hiza ta qaaxike” yaagas.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abeeti Godaw, ne taw keehida wode,","poem":1},{"text":"zumada tana minthada essadasa.","poem":2},{"text":"Shin ne som7uwa hara soo zaarida wode,","poem":1},{"text":"ta dagammas.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abeeti Godaw, ta nena xeegas;","poem":1},{"text":"nena maarota woossas;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Ta duufo geliko nena ay go77ii?","poem":1},{"text":"Biitta giddo gelida asi","poem":2},{"lineBreak":true},{"text":"waatidi nena galatanaw danda7ii?","poem":2},{"lineBreak":true},{"text":"Ne ammanetetha waatidi markatanee?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abeeti Godaw, ne tana si7a;","poem":1},{"text":"taw qadheta.","poem":2},{"lineBreak":true},{"text":"Abeeti Godaw, ne taw maado gida” yaagas.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ta yeehuwa yethan laammadasa;","poem":1},{"text":"kayo ma7uwa taape qaarada,","poem":2},{"lineBreak":true},{"text":"tana ufaysi mayzadasa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hessa gisho, ta nena sabbana; si77i giike.","poem":1},{"text":"Abeeti Godaw, ta Xoossaw, ta nena merinaw galatana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}