{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":31,"content":[{"type":"heading","content":["Ta Shempiw Ne Kushen Wothas"]},{"type":"hebrew_subtitle","content":["Zammaareta Halaqaas Xaafetida Dawita Mazmure."]},{"type":"verse","number":1,"content":["Abeeti Godaw, ta neeko baqatayis;",{"text":"awudeka tana yeellayopa;","poem":2},{"lineBreak":true},{"text":"ne xillotethan tana ashsha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne haythaa taako zaara;","poem":1},{"text":"ellesada tana ashsha.","poem":2},{"text":"Neeni, taw geemmiya zaalla;","poem":1},{"text":"tana ashshiya mino miixa gida.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ee, ne taw zaallanne miixa;","poem":1},{"text":"ne sunthaa gisho tana kaaletha;","poem":2},{"lineBreak":true},{"text":"ogiya bessa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne taw geemmiya besse gidiya gisho,","poem":1},{"text":"enti qotidi wothida xihepe tana naaga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abeeti Godaw, tuma Xoossaw,","poem":1},{"text":"ta shempuwa ne kushen wothayis;","poem":2},{"lineBreak":true},{"text":"ne tana woza.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pathonna eeqata goyinneyisata ta ixayis;","poem":1},{"text":"gidoshin taani Godan ammanetayis.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta metuwanne ta un7a ne be7ida gisho","poem":1},{"text":"taani merinaw ne siiquwan ufaytana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne tana morke kushen aathada immabaaka;","poem":1},{"text":"ta tohota dalga bessan essadasa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abeeti Godaw, taani meton gelida gisho taw qadheta;","poem":1},{"text":"Ta daro azzanida gisho ta ayfey mulcatis;","poem":2},{"lineBreak":true},{"text":"ta ashoynne ta shempoy daaburis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta de7oy azzanon, ta laythay oolen wuris;","poem":1},{"text":"waaye darotethan ta wolqay wuris;","poem":2},{"lineBreak":true},{"text":"ta meqethati argaacidosona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ta morketa ubbaas qidhes attas;","poem":1},{"text":"ta shoorotas yeella gidas.","poem":2},{"text":"Ta laggetas daganthiyaba gidas;","poem":1},{"text":"tana be7eysati taape haakidosona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ta hayqida asada dogetas;","poem":1},{"text":"meqa miisheda wora yegetas.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Taani darota kalkashaa si7as;","poem":1},{"text":"ubba bessara dagami de7ees.","poem":2},{"text":"Enti ta bolla tobboosona;","poem":1},{"text":"tana wodhanaw maqetoosona.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Shin Godaw, ta nenan ammanetana;","poem":1},{"text":"neeni ta Xoossaa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ta de7o laythay ne kushiyana;","poem":1},{"text":"tana yedethiya ta morketa kushepe tana ashsha.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ne aylliya bolla ne som7uwa poo7isa;","poem":1},{"text":"ne maarotethan tana ashsha.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Abeeti Godaw, ta nena xeegiya gisho,","poem":1},{"text":"tana yeellayopa.","poem":2},{"text":"Shin iitati yeellato;","poem":1},{"text":"duufon gelidi si77i go.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Otoroninne boren xillota bolla","poem":1},{"text":"minnidi haasaya gisho,","poem":2},{"lineBreak":true},{"text":"enta wordo inxarsaa si77i ootha.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nena yayyeysatas ne minjida,","poem":1},{"text":"neeko baqateysatas ne giigisida,","poem":2},{"lineBreak":true},{"text":"keehatethay ay mela daro!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Neeni enta ne sinthan, geema bessan gentha wothadasa;","poem":1},{"text":"asaa iita maquwafe ashshaasa;","poem":2},{"lineBreak":true},{"text":"iita inxarsafe ne dunkaaniyan qosadasa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Morkey teqida katamaa giddon,","poem":1},{"text":"malaalsiya ba maarotethaa tana bessida,","poem":2},{"lineBreak":true},{"text":"Goday galatetto.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ta dagammada, “Ne sinthafe haakas” gas;","poem":1},{"text":"shin ta maado koyada neeko waassida wode,","poem":2},{"lineBreak":true},{"text":"ta waasuwa ne si7adasa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hinteno, Xoossa asaw, Godaa dosite;","poem":1},{"text":"Goday ammaneteyisata naagees;","poem":2},{"lineBreak":true},{"text":"shin otoranchotas enta gatiya qanxees.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Hinteno, Godan ufaysi ootheysato,","poem":1},{"text":"minnite; gencite.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}