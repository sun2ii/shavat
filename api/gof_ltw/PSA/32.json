{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":32,"content":[{"type":"heading","content":["Nagari Atto Geetetida Asi Anjetidaysa"]},{"type":"hebrew_subtitle","content":["Dawita Timirte"]},{"type":"hebrew_subtitle","content":["Akeekan xaafetida ginxo"]},{"type":"verse","number":1,"content":["Iya nagaray atto geetetidaynne",{"text":"iya nagaray kametida uray anjetidaysa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Goday iya iitatethaa taybonna asi,","poem":1},{"text":"iya qofan cimoy bayna asi anjetidaysa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taani ta nagaraa paaxonna aggada,","poem":1},{"text":"kumetha gallas oolidaysi,","poem":2},{"lineBreak":true},{"text":"ta asatethaa daabursis.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gallasinne qamma ne kushey tana deexis;","poem":1},{"text":"haathi dhayin bone awan melidibada,","poem":2},{"lineBreak":true},{"text":"ta wolqay wuris. Salaha","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Taani ta nagaraa new paaxas;","poem":1},{"text":"ta naaquwa neepe genthabike.","poem":2},{"text":"“Ta nagaraa Godaas paaxana” yaagas;","poem":1},{"text":"tana deexida nagaraa atto gadasa. Salaha","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hessa gisho, xillo asi oonika,","poem":1},{"text":"ne bentiya wode nena woosso;","poem":2},{"lineBreak":true},{"text":"iita di7oy yaa wode he uraa gakenna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne taw qosetiya bessi;","poem":1},{"text":"ne tana metope naagasa.","poem":2},{"lineBreak":true},{"text":"Atotetha yethi yexiya asaa","poem":2},{"lineBreak":true},{"text":"ta yuushuwan wothadasa. Salaha","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Xoossay, “Ta nena tamaarsana;","poem":1},{"text":"ne baana ogiya bessaana;","poem":2},{"lineBreak":true},{"text":"ta nena zorananne naagana” yaagees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bixaalaninne puulon oyketonna;","poem":1},{"text":"kiitetonna wozani bayna baquloda","poem":2},{"lineBreak":true},{"text":"woyko parada hanopite.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iitatas waayey darana;","poem":1},{"text":"shin Godan ammaneteyisata siiqoy kammana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hinteno, xilloto,","poem":1},{"text":"Godan ufaytitenne hashshu giite;","poem":2},{"lineBreak":true},{"text":"hinteno, wozana suureto, ililite.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}