{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":33,"content":[{"type":"heading","content":["Keeha Xoossay Sabeto"]},{"type":"verse","number":1,"content":["Hinteno, xilloto Godaas ufaysan ililite;",{"text":"suure asati iya galatanaw bessees.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Maasinqon Godaa galatite;","poem":1},{"text":"tammu shayan waaxetida diithan yexite.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ooratha yethi iyaw yexite;","poem":1},{"text":"diithi loythidi diixishe ililite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Godaa qaalay tuma;","poem":1},{"text":"iya ooso ubbay ammaneteysa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Goday xillotethinne tuma pirda dosees;","poem":1},{"text":"iya maarotay sa7aa kumis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Godaa qaalan saloti medhetidosona;","poem":1},{"text":"iya doonape keyiya shempuwan","poem":2},{"lineBreak":true},{"text":"salon de7iya medhetethati yeletidosona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abba haatha issi bessan eelisis;","poem":1},{"text":"ciimmo haatha minja keethan wothis.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sa7a ubbay Godaa yayyo;","poem":1},{"text":"asa ubbay Godaa boncho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iya odan ubbay hanis;","poem":1},{"text":"I kiittin minnidi eqis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Goday kawotethata halchuwa hada oothees;","poem":1},{"text":"enta qofaa laallees.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Godaa halchoy merinaw eqidi de7ees;","poem":1},{"text":"iya wozanaa qofay yeletetha ubbaasa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xoossay entaw Godaa gidida kawotethay,","poem":1},{"text":"I babaa oothidi doorida asay anjetidaysata.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Goday salon uttidi xeellees;","poem":1},{"text":"asa koche ubbaa be7ees.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Goday ba araatan uttidi,","poem":1},{"text":"sa7an de7iya ubbaa be7ees.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Enta wozanaa medhiday iya;","poem":1},{"text":"enti oothiyaba ubbaa I erees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kawoy ba wotaadare darotethan attenna;","poem":1},{"text":"olanchoy ba wolqaa minotethan kessi ekenna.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Paran xoonana gidi naagoy hada;","poem":1},{"text":"I ba minotethan ashshanaw danda7enna.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Godaa ayfeti iyaw yayyanne","poem":1},{"text":"iya maarotan ufaysi oothiya asaa be7oosona.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hessika enta hayqope ashshanaasanne","poem":1},{"text":"kosha wode enta naaganaassa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nuuni Godaa ufaysan naagoos;","poem":1},{"text":"nuna maaddeynne nu gondalley iya.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Iya geeshsha sunthan nuuni ammanetiya gisho,","poem":1},{"text":"nu wozanay iyan ufaytees.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Godaw, nuuni nenan ufaysi oothidaysada,","poem":1},{"text":"ne maarotay nu bolla gido.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}