{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":34,"content":[{"type":"heading","content":["Xoossay Keeha Gideysa Be7ite"]},{"type":"hebrew_subtitle","content":["Dawiti gooshshu daanidi shiiqida gisho, Abimeleke sinthafe goodetidi keyda wode yexida mazmure."]},{"type":"verse","number":1,"content":["Taani ubba wode Godaa galatana;",{"text":"iya galatay ta doonape pacenna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taani Godan ceeqetayis;","poem":1},{"text":"aadati hessa si7idi ufayto.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taara Godaa bonchite;","poem":1},{"text":"iya sunthaa issife dhoqu dhoqu oothoos.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taani Godaa koyin, I taw zaaris;","poem":1},{"text":"ta yayyiyaba ubbaafe tana ashshis.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iyako xeelliya ubbay poo7osona;","poem":1},{"text":"enta som7oy yeellatenna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ha manqoy waassis;","poem":1},{"text":"Goday iya waasuwa si7is;","poem":2},{"lineBreak":true},{"text":"iya meto ubbaafe iya ashshis.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Godaa kiitanchoy iyaw yayyeyisata naagees;","poem":1},{"text":"enta yuushon gididi enta ashshees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Goday keeha gideysa laacidi be7ite;","poem":1},{"text":"iyako baqatiya asi anjetidaysa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hinteno, geeshsha asaw, Godaas yayyite;","poem":1},{"text":"iyaw yayyeysatas aykoyka pacenna.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gaammoti miyaba dhayidi koshatoosona;","poem":1},{"text":"shin Godaa koyeysatas lo77obay pacenna.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nayto, haa yiite; si7ite;","poem":1},{"text":"ta hintena Godaa yashshi tamaarsana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lo77o de7o daanawunne","poem":1},{"text":"keehaba be7anaw adussa laythi daanaw,","poem":2},{"lineBreak":true},{"text":"amottey oonee?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ne inxarsay iitabaa odetonaada,","poem":1},{"text":"ne doonay cimmonnaada teqa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iitape haaka; lo77oba ootha;","poem":1},{"text":"sarotethi koya; kaalla.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Godaa ayfey xillota xeellees;","poem":1},{"text":"iya haythay enta waasuwa si7ees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Enta qofisiyaba biittafe dhaysanaw,","poem":1},{"text":"Goday iita ootheyisata ba hanqo ayfen xeellees.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Xilloti waassoosona;","poem":1},{"text":"Goday enta waasuwa si7ees;","poem":2},{"lineBreak":true},{"text":"I enta meto ubbaafe ashshees.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wozani meqidaysatas Goday matana;","poem":1},{"text":"I ufaysi qanxidaysata ashshees.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Xillo asas metoy daro;","poem":1},{"text":"shin Goday iya he ubbaafe ashshees.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Goday iya meqethata naagiya gisho,","poem":1},{"text":"entafe issoyka meqenna.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Iitata enta iitatethay wodhana;","poem":1},{"text":"xillota ixeysati pirdetana.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Goday ba aylleta wozees;","poem":1},{"text":"iyako baqatiya oonika pirdetenna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}