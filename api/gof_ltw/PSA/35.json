{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":35,"content":[{"type":"heading","content":["Bixatida Asa Woosa"]},{"type":"hebrew_subtitle","content":["Dawita Mazmure"]},{"type":"verse","number":1,"content":["Godaw, taara baaxeteysatar ne baaxeta;",{"text":"tana oleyisata ne ola.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gondallenne toora oykada,","poem":1},{"text":"tana maaddanaw denda.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tana gooddeyisata bolla","poem":1},{"text":"ne tooranne mashsha dentha;","poem":2},{"lineBreak":true},{"text":"taako “Ta nena ashsheysa” yaaga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ta shempuwa wodhanaw koyeysati,","poem":1},{"text":"yeellato; kawuyo.","poem":2},{"text":"Ta bolla iitabaa maqeteysati,","poem":1},{"text":"kawuyidi guye simmo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Godaa kiitanchoy enta yedethiya wode,","poem":1},{"text":"enti carkon laaletiya suullada hano.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Godaa kiitanchoy enta gooddiya wode,","poem":1},{"text":"enta ogey dhumanne hallithi gido.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gaasoy bayna tana oykanaw xihe wothoosona;","poem":1},{"text":"tana kundisanaw olla bookosona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Eronna de7ishin enta bolla dhayoy yo;","poem":1},{"text":"enti wothida xihey enta oyko;","poem":2},{"lineBreak":true},{"text":"enti bookida ollan kundidi dhayo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"He wode taani Godan ufaytana;","poem":1},{"text":"I ashshida gisho hashshu gaana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta kumetha asatethay nena,","poem":1},{"text":"“Godaw, ne meli oonee?","poem":2},{"text":"Manquwa wolqaamaa kushiyape kessa ekaasa;","poem":1},{"text":"metootanchuwanne un7etidaysa,","poem":2},{"lineBreak":true},{"text":"bonqeyisata kushepe ashshaasa” yaagana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wordo markateysati ta bolla dendoosona;","poem":1},{"text":"ta eronnaban tana mootosona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ta lo77o oothida gisho iita zaaridosona;","poem":1},{"text":"tana bizza oothidosona.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Shin enti hargida wode taani kayo ma7o ma7as;","poem":1},{"text":"ta asatethaa xooman daabursas;","poem":2},{"lineBreak":true},{"text":"ta woosay zaaro demmonna attis.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tana kawushada","poem":1},{"text":"dabbos woyko ishas yeekeysada yeekas.","poem":2},{"text":"Issi asi ba aayes kayoteysada","poem":1},{"text":"ta huuphiya oykada yeekas.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Shin taani dhubetida wode ufaytidi shiiqidosona;","poem":1},{"text":"gaasoy bayna tana wadhidi,","poem":2},{"lineBreak":true},{"text":"aggonna ixidosona.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Iita asati ootheysada enti tana qelqisidosona;","poem":1},{"text":"yilotidi banta acha garcidosona.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Godaw, neeni awude gakanaw,","poem":1},{"text":"si77i gada xeellay?","poem":2},{"text":"Enta iita oosuwape tana ashsha;","poem":1},{"text":"ta al7o shempuwa ha gaammotape wosisa eka.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"He wode gita shiiqon ta nena galatana;","poem":1},{"text":"daro asay de7iya bessan nena bonchana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Gaasoy bayna tana morkeysati ufaytofo;","poem":1},{"text":"tana coo ixeysati ta bolla qam7otopo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Enti saroba haasayokona;","poem":1},{"text":"si77i gidi de7iya asaa bolla oda xaaxosona.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Enti banta doona ta bolla dooyidi,","poem":1},{"text":"“Haysa be7a, ne oothidaysa","poem":2},{"lineBreak":true},{"text":"nuuni nu ayfen be7ida” yaagosona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Godaw, neeni hessa be7adasa;","poem":1},{"text":"si77i goopa.","poem":2},{"lineBreak":true},{"text":"Godaw, taape haakofa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ta Xoossaw, ta Godaw ta gisho,","poem":1},{"text":"denda; barka;","poem":2},{"lineBreak":true},{"text":"ta doona gidada mooteta.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ta Godaw, ta Xoossaw, xillotethan taw pirda;","poem":1},{"text":"ta morketa ufaysofa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Enti banta wozanan, “Hashshu, nu amoy poletis;","poem":1},{"text":"nuuni iya mittida” gaana mela oothofa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ta waayan ufayteysati, yeellato, kawuyo;","poem":1},{"text":"ta bolla ceeqeteysati yeellanne kawushe ma7o.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ta xoonuwa doseysati ufayto;","poem":1},{"text":"ililo; hashshu yaago.","poem":2},{"text":"“Ubba wode ba aylliya sarotethan,","poem":1},{"text":"ufaytiya Goday dhoqu dhoqu go” yaago.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ta inxarsay ne xillotethaanne ne galataa,","poem":1},{"text":"gallasa kumethan odees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}