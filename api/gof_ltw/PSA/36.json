{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":36,"content":[{"type":"heading","content":["Al7o Gidida Xoossa Siiqo"]},{"type":"hebrew_subtitle","content":["Godaa aylley, Dawiti zammaareta halaqaas xaafida mazmure."]},{"type":"verse","number":1,"content":["Iita asi ba wozanan iitabaa qopees;",{"text":"I ba wozanan Xoossas yayyenna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"I bana daro nashshiya gisho;","poem":1},{"text":"ba nagaraa be7anaw woyko ixanaw danda7enna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iya doonan geneynne wordoy kumis;","poem":1},{"text":"Cincatethinne lo77oba ooso aggis.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ba hiixan zin7idi gene qopees;","poem":1},{"text":"bana lo77o gidonna ogen kaalethees;","poem":2},{"lineBreak":true},{"text":"iitabaa ixenna.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Godaw, ne siiqoy salota gakees;","poem":1},{"text":"ne tumatethay shaarape aadhees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne xillotethay dhoqa deretape aadhees;","poem":1},{"text":"ne pirday abba ciimmuwafe ziqa;","poem":2},{"lineBreak":true},{"text":"Godaw, neeni asenne do7a naagasa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Xoossaw, ne siiqoy ay mela al7o!","poem":1},{"text":"Asay ne qefiya garsan qosetidi attees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Enti ne gibiraape midi kalloosona;","poem":1},{"text":"ne keehatetha shaafape uyidi aloosona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"De7o pultoy neepe keyees;","poem":1},{"text":"ne poo7uwan nuuni poo7o be7oos.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nena ereysatas ne siiqoy,","poem":1},{"text":"wozana suuretas ne xillotethay qanxetenna.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Otoranchota tohoy tana yedhofo;","poem":1},{"text":"nagaranchota kushey tana yedethofo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Iita asata kundethaa be7ite;","poem":1},{"text":"enti kundidosona; dendanaw danda7okona.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}