{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":37,"content":[{"type":"heading","content":["Xoossay Ba Asaa Aggenna"]},{"type":"hebrew_subtitle","content":["Dawita Mazmure"]},{"type":"verse","number":1,"content":["Iitaa ootheyisata gaason yilotopa;",{"text":"nagara ootheyisata qanaatopa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Enti maatada eeson melana;","poem":1},{"text":"boncoda shullidi qoqofetana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Godan ammaneta; lo77oba ootha;","poem":1},{"text":"biitta bolla utta; palahin de7a.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Godan ufayta;","poem":1},{"text":"I ne wozanaa amuwa immana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne ogiya hadara Godaas imma;","poem":1},{"text":"iyan ammaneta; I new oothana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I ne xillotethaa wonta xalqeda,","poem":1},{"text":"ne pirdaa seeta gallasa awada poo7isana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Godaa sinthan si77i gada de7a;","poem":1},{"text":"danda7an naaga;","poem":2},{"lineBreak":true},{"text":"Iita asata halchoy poletin be7ada yilotopa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hanqo agga; yilo teqa;","poem":1},{"text":"hessi meton yeggees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iita ootheysati dhoqolletidi dhayana;","poem":1},{"text":"shin Godan ufaysi wotheysati biitta laattana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Iita ootheysati guutha wodepe guye de7okona;","poem":1},{"text":"ne enta koyada demmaka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Shin aadati biitta laattana;","poem":1},{"text":"sarotethan ufaytidi daana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Iita asi lo77o asi dhaysanaw maqetees;","poem":1},{"text":"ba acha enta bolla garcees.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Shin Goday iitata bolla miicees;","poem":1},{"text":"entaw dhayo gallasi yeysa erees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Iita asati manqotanne metootanchota wodhanaw,","poem":1},{"text":"suure hemeteyisata shukanaw,","poem":2},{"lineBreak":true},{"text":"banta mashsha shoddoosona;","poem":2},{"lineBreak":true},{"text":"banta dongiya waaxoosona.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Shin enta mashshay enta wozanan gelana;","poem":1},{"text":"enta dongey meqana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Xillo asas de7iya guuthabay,","poem":1},{"text":"iita asas de7iya darobaape lo77o.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ayis giiko, iitata wolqay meqana;","poem":1},{"text":"shin Goday xillota zempisees.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Suure asata ogiya Goday erees;","poem":1},{"text":"enta laatay merinaw entaba gidana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Iita wode suure asati yeellatokona;","poem":1},{"text":"kosha wode enti kallidi maana.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Shin iita asati hayqana;","poem":1},{"text":"Godaa morketi ciishshada qoqofetana;","poem":2},{"lineBreak":true},{"text":"cuyada ayfepe geemmana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Iita asi tal7idi zaarenna;","poem":1},{"text":"shin xillo asi keehatethan immees.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Godan anjetidaysati biitta laattana;","poem":1},{"text":"shin I baaddidaysati dhayana.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Asa ogey Godaa ufaysiko,","poem":1},{"text":"Goday iya tanguwa kaalethees; minthees.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"I dhubetikoka kundenna;","poem":1},{"text":"Goday iya kushiya oykidi katisees.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Taani paamas; ha77i cimas;","poem":1},{"text":"shin xillo asi yegetin,","poem":2},{"lineBreak":true},{"text":"iya nayti kathi woossishin be7abike.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"I ubba wode keehatethan immees;","poem":1},{"text":"coo tal7ees;","poem":2},{"lineBreak":true},{"text":"iya nayti haratas anjo gidana.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Iitape haaka; lo77o ootha;","poem":1},{"text":"ne adussa laythi daana.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Goday xillo pirda dosees;","poem":1},{"text":"ammaneteyisata I yeggenna.","poem":2},{"text":"Enti merinaw naagetoosona;","poem":1},{"text":"shin iitata kochay dhayana.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Xilloti biitta laattana;","poem":1},{"text":"yan merinaw daana.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Xillo asa doonape cincatethi keyees;","poem":1},{"text":"iya inxarsay xillo odetees.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Xoossa higgey iya wozanan de7ees;","poem":1},{"text":"iya tohoy dhubetenna.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Iita asi xillo asi geeddees;","poem":1},{"text":"iya wodhanaw koyees.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Shin Goday iya kushen aathidi immenna;","poem":1},{"text":"pirdetanaw eqiya wode iya bolla pirdisenna.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Godan ufaysi ootha, iya kiitaa naaga;","poem":1},{"text":"nena biitta laatisidi gitayana;","poem":2},{"lineBreak":true},{"text":"iita asati dhayishin ne be7ana.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Nagaranchoy Libaanose zigada,","poem":1},{"text":"diccidi dhoqu dhoqu gin ta be7as.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Shin ta simmada yan demmabike;","poem":1},{"text":"koyinka bentibeenna.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Borey bayna asi be7a;","poem":1},{"text":"suure asi akeeka;","poem":2},{"lineBreak":true},{"text":"saro asas wursethay lo77o gidana.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Shin nagaranchoti dhayana;","poem":1},{"text":"enta wursethay dhoommana.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Xillota atotethay Godaape yees;","poem":1},{"text":"I meto wode enti naagetidi attiya besse.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Goday xillota maaddees; ashshees;","poem":1},{"text":"enti iyako baqatida gisho,","poem":2},{"lineBreak":true},{"text":"I enta iitatape ashshees; naagees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}