{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":38,"content":[{"type":"heading","content":["Xoossaw Tana Aggofa"]},{"type":"hebrew_subtitle","content":["Dawiti xaafida qofiso mazmure."]},{"type":"verse","number":1,"content":["Abeeti Godaw, ne sheniyan tana seeropa;",{"text":"ne yiluwan tana hanqofa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne donge tooray tana caddis;","poem":1},{"text":"ne kushey tana deexis.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne hanqida gisho ta asatethay qohetis;","poem":1},{"text":"ta nagaraa gaason ta meqethay liiqis.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ta balay tana muukis;","poem":1},{"text":"dendonna gita toohoda tana deexees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ta eeyatethan oothida nagara gisho,","poem":1},{"text":"ta madunthay xinqis.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ta sa7a xeellas; hokas;","poem":1},{"text":"gallas kumethi azzanashe pee7as.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta ashoy xuuggees;","poem":1},{"text":"ta asatethay paxa gidenna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ta daaburas; liiqas;","poem":1},{"text":"ta wozanay dirgiya gisho oolas.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abeeti Godaw, ta wozanaa amo ubbaa eraasa;","poem":1},{"text":"ta ooley neepe geemmibeenna.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta wozanay dirgees;","poem":1},{"text":"ta wolqay hitti gis;","poem":2},{"lineBreak":true},{"text":"ta ayfiya poo7oy dhayis.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ta madunthaa gaason","poem":1},{"text":"ta shoorotinne ta laggeti haakidi eqidosona;","poem":2},{"lineBreak":true},{"text":"ta dabboti taape haakidosona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tana wodhanaw koyeysati","poem":1},{"text":"banta xihiya taw yeggoosona.","poem":2},{"text":"Tana qohanaw koyeysati,","poem":1},{"text":"“Nu nena demmana” yaagidi, mandoosona;","poem":2},{"lineBreak":true},{"text":"gallas kumethi ta bolla tobboosona.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ta tulle asa mela si7ike;","poem":1},{"text":"muume asa mela doona pogike.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tuma haythi si7onna asi,","poem":1},{"text":"inxarsi odidi zaaronna asi gidas.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Godaw, ta nena ufaysan naagayis;","poem":1},{"text":"ta Godaw, Xoossaw ne taw zaaro imma.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Taani, “Ta tohoy dhubetin,","poem":1},{"text":"enti hashshu gaanadanne","poem":2},{"lineBreak":true},{"text":"ta bolla ceeqetanaada oothofa” yaagas.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ta kundana hanayis,","poem":1},{"text":"ta sakoy tana aggonna ixis.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ta nagara paaxayis;","poem":1},{"text":"ta naaquwa gaason azzanayis.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ta morketi gitane wolqaama;","poem":1},{"text":"tana coo ixeysati daro.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Taani lo77oba oothin iita zaareysati,","poem":1},{"text":"ta lo77oba kaalliya gisho taara eqetoosona.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Godaw, tana yeggofa;","poem":1},{"text":"ta Xoossaw, taape haakofa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Tana ashshiya ta Godaw,","poem":1},{"text":"tana maaddanaw ellesa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}