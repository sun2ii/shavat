{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":39,"content":[{"type":"heading","content":["Gita Xoossi-Laafa Asi"]},{"type":"hebrew_subtitle","content":["Dawiti zammaareta halaqa, Edotaames xaafida mazmure."]},{"type":"verse","number":1,"content":["Taani, “Ta inxarsan nagara oothonna mela,",{"text":"ta ogiya naagana.","poem":2},{"text":"Iita asati ta de7iya wode,","poem":1},{"text":"ta doona barana” yaagas.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Shin doona muumeda si77i gas;","poem":1},{"text":"hari attoshin lo77oba odeteysa aggas;","poem":2},{"lineBreak":true},{"text":"shin ta waayey haa daris.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ta wozanay ta gaathan teellis;","poem":1},{"text":"ta qofay tamada eexis;","poem":2},{"lineBreak":true},{"text":"yaatin ta inxarsan haasaya doomas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Godaw, ta de7uwa wursethaanne","poem":1},{"text":"ta daanaw attida gallasaa tana bessa;","poem":2},{"lineBreak":true},{"text":"ta de7oy ay mela qantheko tana erisa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neeni ta laytha takadhada wothadasa;","poem":1},{"text":"Ta laythay ne sinthan baynaba mela;","poem":2},{"lineBreak":true},{"text":"tuma asi ubbay issi shempo mela. Salaha","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tuma asi aadhiya eesho mela;","poem":1},{"text":"I coo daaburees; shalo shiishees;","poem":2},{"lineBreak":true},{"text":"shin ooni go7etaneko erenna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Godaw, ha77i ta naagey oonee?","poem":1},{"text":"Taani nenan ufaysi oothayis.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ta bala ubbaafe tana ashsha;","poem":1},{"text":"eeyatan tana tooshisopa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hessa ubbaa oothiday nena gidiya gisho","poem":1},{"text":"taani muumas; doonaka pogabike.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne xam7a ta bollafe dentha;","poem":1},{"text":"mino ne kushiya gaason ta daaburas.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ase iya nagaraa gisho seerasa;","poem":1},{"text":"iya al7o de7uwa bilada wursaasa;","poem":2},{"lineBreak":true},{"text":"tuma asi ubbay issi shempo mela. Salaha","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Godaw, ta woosa si7a;","poem":1},{"text":"tana maaddanaw ta waasuwa hayza.","poem":2},{"text":"Ta afuthaa be7ada si77i goopa;","poem":1},{"text":"taani ta aawatada bete asinne imathe","poem":2},{"lineBreak":true},{"text":"gidada neera de7ayis.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ta shaaketanapenne baanape sinthe","poem":1},{"text":"taani ufaytana mela tana agga.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}