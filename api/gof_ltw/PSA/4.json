wode","poem":2},{"lineBreak":true},{"text":"hinte wozanaa qorite; si77i giite. Salah","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Godaas like yarsho yarshite;","poem":1},{"text":"iyan ammanetite.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Nuna lo77oba bessanay oonee?”","poem":1},{"text":"yaagidi daroti oychoosona;","poem":2},{"lineBreak":true},{"text":"Abeeti Godaw, ne nuna keeha ayfen xeella.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Daro gistefenne woyne ushshafe","poem":1},{"text":"ne ta wozanan wothida gita ufaysay aadhees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abeeti Godaw, ne xalaali tana saro wothiya gisho,","poem":1},{"text":"taani zin7ada wopu gada dhiskayis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}