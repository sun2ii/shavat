{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":40,"content":[{"type":"heading","content":["Maade Demmanaw Woossiya Woosa"]},{"type":"hebrew_subtitle","content":["Zamaareta halaqaas Dawiti xaafida mazmure."]},{"type":"verse","number":1,"content":["Taani Godaa danda7an naagas;",{"text":"I taako simmidi ta waasuwa si7is.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dhayo ollafe, silimo urqafe tana kessis;","poem":1},{"text":"ta tohuwa zaalla bolla essis;","poem":2},{"lineBreak":true},{"text":"ta hemethaa minthis.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ta doonan ooratha yethi wothis;","poem":1},{"text":"hessika nu Xoossay galatetto yaageysa;","poem":2},{"lineBreak":true},{"text":"daroti be7idi yayyana; Godan ammanetana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Godan ammanetiya,","poem":1},{"text":"otoranchota xeellonnay,","poem":2},{"lineBreak":true},{"text":"wordotara hemetonnay,","poem":2},{"lineBreak":true},{"text":"anjetida asi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Godaw, ta Xoossaw,","poem":1},{"text":"neeni daro malaalsiyaba oothadasa;","poem":2},{"lineBreak":true},{"text":"neera liketey oonika baawa!","poem":2},{"text":"Neeni nuus qopida lo77o qofaa,","poem":1},{"text":"oonika taybanaw danda7onna;","poem":2},{"lineBreak":true},{"text":"Hessi taani odin wuriyaba gidenna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Neeni yarshonne imo koyabaaka;","poem":1},{"text":"shin nena si7ana mela ta haythaa dooyadasa;","poem":2},{"lineBreak":true},{"text":"xuussa yarshonne nagara yarsho koyabaaka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hessa gisho taani, “Xaatha maxaafan","poem":1},{"text":"tabay xaafetidaysada taani yas.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ta Xoossaw, taani ne sheniya oothanaw dosayis;","poem":1},{"text":"ne higgey ta wozanan de7ees” yaagas.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gita shiiqon, ne xillotetha odana;","poem":1},{"text":"Godaw neeni ereysada,","poem":2},{"lineBreak":true},{"text":"taani markateysa aggike.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta ne xillotethaa ta wozanan qosabike;","poem":1},{"text":"ne ammanetethanne ne ashuwa odas.","poem":2},{"text":"Ne siiquwanne ne tumatethaa,","poem":1},{"text":"gita shiiquwan genthabike.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Godaw, ne maarotethaa taape haassofa;","poem":1},{"text":"ne siiqoynne ne tumatethay,","poem":2},{"lineBreak":true},{"text":"tana ubba wode naago.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tayboy bayna iitabay tana teqis;","poem":1},{"text":"ta balay tana goozis;","poem":2},{"lineBreak":true},{"text":"ta xeellanaw danda7ike","poem":2},{"text":"Ta nagaray ta huuphe binaanape daris;","poem":1},{"text":"ta wozanay ta giddon til7is.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Godaw, tana ashshanaw ero ga;","poem":1},{"text":"ta Godaw, tana maaddanaw ellesa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tana wodhanaw koyeysati yeellato, kawuyo;","poem":1},{"text":"Ta qohetetha amotteysati kawuyidi guye simmo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Taako, “Iyaw hashshu, hashshu”","poem":1},{"text":"geysati xoonetidi yeellato.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Shin nena koyiya ubbay,","poem":1},{"text":"nenan ufayto; hashshu go.","poem":2},{"text":"Ne atotetha dosiya ubbay,","poem":1},{"text":"“Goday gita” yaago.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Taani manqonne metootancho;","poem":1},{"text":"shin Goday tabaa qopo!","poem":2},{"text":"Tana maaddey ashshey nena;","poem":1},{"text":"ta Xoossaw, gam7ofa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}