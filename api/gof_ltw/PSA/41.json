{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":41,"content":[{"type":"heading","content":["Hargetiyanne Bizza Asa Woosa"]},{"type":"hebrew_subtitle","content":["Zammaareta Halaqaas Xaafetida Dawita Mazmure."]},{"type":"verse","number":1,"content":["Manquwas qopiya asi anjetidaysa;",{"text":"meto gallas Goday iya ashshees.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Goday iya naagees, de7on wothees;","poem":1},{"text":"biitta bolla Goday iya anjees;","poem":2},{"lineBreak":true},{"text":"Goday iya, iya morketa amuwas aathidi immenna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"I saketidi hiithan de7ishin Goday maaddees;","poem":1},{"text":"hargiyafe iya pathees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taani, “Godaw, ta nena naaqida gisho,","poem":1},{"text":"tana maara;","poem":2},{"lineBreak":true},{"text":"ta hargiyafe tana patha” yaagas.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ta morketi iitabaa ta bolla haasayidi,","poem":1},{"text":"“I awude hayqandee?","poem":2},{"lineBreak":true},{"text":"iya sunthay awude dogetandee?” yaagosona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tana be7anaw yaa oonika wordo odees;","poem":1},{"text":"ba wozanan tana zigiriyabaa shiishees;","poem":2},{"lineBreak":true},{"text":"kare keyidi ta sunthaa iissees.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tana ixiya ubbay issife tana zigiroosona;","poem":1},{"text":"iitabay iya gakees gidi qopoosona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Iya iita hargey oykis;","poem":1},{"text":"I hiza hiixape dendenna” yaagosona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hari attoshin ta ammanetiya laggey,","poem":1},{"text":"taara midaysi taw zoko zaaris.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Shin Godaw tana maara;","poem":1},{"text":"ta entaw kushe zaarana mela,","poem":2},{"lineBreak":true},{"text":"harge hiixape tana dentha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ta morkey tana xoononna gisho,","poem":1},{"text":"ne tanan ufaytanaysa ta erayis.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne tana ta suuretetha gisho katisaasa;","poem":1},{"text":"ne sinthan tana merinaw wothaasa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Goday, Isra7eele Xoossay,","poem":1},{"text":"merinaape merinaa gakanaw galatetto.","poem":2},{"lineBreak":true},"Amin7i! Amin7i!"]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}