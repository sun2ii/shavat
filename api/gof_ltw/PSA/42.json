{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":42,"content":[{"type":"heading","content":["Goodetiya Asa Woosa"]},{"type":"hebrew_subtitle","content":["Qore Nayta Timirte"]},{"type":"hebrew_subtitle","content":["Akeekan xaafida mazmure"]},{"type":"verse","number":1,"content":["Gaari pulto haathi laamoteysada,",{"text":"Xoossaw, ta shempiya nena laamotawusu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“Ta shempiya Xoossaa,","poem":1},{"text":"de7o Xoossaa be7anaw saamotawusu;","poem":2},{"lineBreak":true},{"text":"awude gakada iya som7uwa be7o” yaagawusu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Asay, “Ne Xoossay awun de7ii?”","poem":1},{"text":"giya wode,","poem":2},{"lineBreak":true},{"text":"gallasinne qammi taw afuthi kathi gidis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Taani enta ba7aale bonchanaw shiiqida, daro asaa kaalethada,","poem":1},{"text":"galata yethaninne ililisan xoossa keethi beysa qopiya wode,","poem":2},{"lineBreak":true},{"text":"ta wozanay azzanon meqees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ta shempe, ayis azzanay?","poem":1},{"text":"ayis un7etay?","poem":2},{"text":"Ne Xoossan ufaysi wotha;","poem":1},{"text":"tana ashshiya, ta Xoossaa taani buroo galatana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ta wozanay azzanis;","poem":1},{"text":"hessa gisho taani Yordaanose biittan,","poem":2},{"text":"Armoona dhoqan, Mizaare zuman,","poem":1},{"text":"eqada nena qopana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne soossuwa guunthan ciimmoy ciimmuwa xeegees;","poem":1},{"text":"ne beetaynne ne zuley ta bollara aadhis.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Goday ba siiquwa gallas taw kiittees;","poem":1},{"text":"qamma galata yethay taara de7ees;","poem":2},{"lineBreak":true},{"text":"ta de7o Xoossaa woossana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Xoossaa, ta zaallako,","poem":1},{"text":"“Tana ayis dogadii?","poem":2},{"text":"Ta morketi tana un7ethin,","poem":1},{"text":"yeekashe ayis hemeto” yaagana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta morketi, “Ne Xoossay awun de7ii?”","poem":1},{"text":"yaagidi cayiya wode ta meqethay meqees.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ta shempe ayis azzanay?","poem":1},{"text":"ayis un7etay?","poem":2},{"text":"Xoossan ufaysi wotha;","poem":1},{"text":"tana ashshiya, ta Xoossaa ta buroo galatana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}