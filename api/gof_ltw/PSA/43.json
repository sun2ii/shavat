":[{"text":"Ta shempe ayis azzanay?","poem":1},{"text":"ayis un7etay?","poem":2},{"text":"Xoossan ufaysi wotha;","poem":1},{"text":"tana ashshiya, ta Xoossaa ta buroo galatana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}