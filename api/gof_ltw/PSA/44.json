{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":44,"content":[{"type":"heading","content":["Nuna Maaddanaw Ellesa"]},{"type":"hebrew_subtitle","content":["Qore Nayti Zammare Halaqaas Xaafida Mazmure"]},{"type":"hebrew_subtitle","content":["Akeekan xaafida ginxo"]},{"type":"verse","number":1,"content":[{"text":"Xoossaw, beni wode ne oothidaba nu si7ida;","poem":1},{"text":"nu aawata wode ne oothidaba nuus odidosona.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kawotethata ne kushen goodda kessadasa;","poem":1},{"text":"nu aawata enta biittan tokadasa.","poem":2},{"text":"Hara kawotethata seeradasa;","poem":1},{"text":"shin nu aawata aakisadasa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Enti banta mashshan olidi he biitta laatibookona;","poem":1},{"text":"enti banta minotethan xoonibookona.","poem":2},{"text":"Shin neeni enta dosida gisho,","poem":1},{"text":"enta ne ushacha kushey, ne qeseynne","poem":2},{"lineBreak":true},{"text":"ne som7uwa poo77oy xoonisis.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yayqooba kochaas xoono kiittiya,","poem":1},{"text":"ta kawoynne ta Xoossay nena.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nenan gididi nu morketa xoonana;","poem":1},{"text":"ne sunthan nuna ixeyisata yedhana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taani ta tooran ammanetike;","poem":1},{"text":"ta mashshay tana ashshena.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Shin ne nuna nu morketape ashshaasa;","poem":1},{"text":"nuna ixeyisata neeni kawushaasa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nuuni ubba wode Xoossan ceeqetana;","poem":1},{"text":"ne sunthaa merinaw galatana. Salaha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Shin ha77i nuna aggadasa; kawushadasa;","poem":1},{"text":"nu olanchotara issife olas keyaka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nu morketa sinthafe nuna baqatisadasa;","poem":1},{"text":"nu ixeysati nuna bonqidosona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nuna dorsada shuhas aatha immadasa;","poem":1},{"text":"kawotethata giddon nuna laalladasa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Neeni ne asaa laafa gaten bayzadasa;","poem":1},{"text":"ay wodheka demmabaaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nu shooroti nuna boranaada oothadasa;","poem":1},{"text":"nu heeran de7eysati nuna qilqisanaadanne","poem":2},{"lineBreak":true},{"text":"nu bolla miicanaada oothadasa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nuna kawotethata giddon hayses aggadasa;","poem":1},{"text":"enti banta huuphiya nu bolla","poem":2},{"lineBreak":true},{"text":"qaathana mela oothadasa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Gallas kumethi taani tooshetas;","poem":1},{"text":"ta som7uwa yeelli kammis.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hessi haniday tana cayeysatanne boreyisata gaasoninne,","poem":1},{"text":"ta morketanne tana mandeyisata gaasona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Nuuni nena dogonna de7ishin,","poem":1},{"text":"ne caaquwa menthonna de7ishin,","poem":2},{"lineBreak":true},{"text":"ha ubbay nuna gakis.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nu wozanay nena aggibeenna;","poem":1},{"text":"nu tohoy ne ogiyape kare keybeenna.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Shin neeni nuna mentherethada","poem":1},{"text":"do7a ollan yeggadasa;","poem":2},{"lineBreak":true},{"text":"sakana dhuman kammadasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Nu, Xoossaa sunthaa dogidaba gidiyako,","poem":1},{"text":"hara xoossatako nu kushiya miccidaba gidiyako,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Wozana xuuraa Xoossay eriya gisho,","poem":1},{"text":"I haysa xeellidi demmennee?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Gidoshin, ne gisho ubba gallas hayqoos;","poem":1},{"text":"shukanaw efiya dorsada taybetida.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Godaw, denda, Ayis dhiskay?","poem":1},{"text":"Denda, merinaw nuna aggofa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ne som7uwa nuupe ayis genthay?","poem":1},{"text":"Nu qohuwanne nu un7aa ayis dogay?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Nuuni baanan yegetida;","poem":1},{"text":"nu asatethay biittara oyketis.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Godaw, denda, nuna maadda;","poem":1},{"text":"ne siiquwa gisho gada nuna woza.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}