{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":45,"content":[{"type":"heading","content":["Xoossaa Araatay Merinaasa"]},{"type":"hebrew_subtitle","content":["Qore Nayti “Ciishshe” Geetetiya cuudhethan Zammaareta Halaqaas Xaafida Mazmure"]},{"type":"hebrew_subtitle","content":["Akeekan xaafida siiqo mazmure."]},{"type":"verse","number":1,"content":["Taani ta yethaa kawas sissana;",{"text":"ta wozanay lo77o qofa pultees;","poem":2},{"lineBreak":true},{"text":"ta inxarsay lo77o xaafiya asa bi7ire mela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Asa ubbaafe neeni mala lo7o;","poem":1},{"text":"ne mettershay aadho keehatetha qaalan kumis;","poem":2},{"lineBreak":true},{"text":"Xoossay nena merinaw anjis.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wolqaama kawaw, ne mashshaa danca;","poem":1},{"text":"bonchonne teema ma7a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ne tumatethaa, ne aadatethanne ne xillotetha gisho,","poem":1},{"text":"ne teema ma7ada xoonanaw denda;","poem":2},{"lineBreak":true},{"text":"ne ushacha kushey malaalsiyaba besso.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne toorati qara;","poem":1},{"text":"enti kawa morketa wozanaa caddo;","poem":2},{"lineBreak":true},{"text":"kawotethati ne tohuwa garsan kundo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Xoossaw, ne araatay merinaw de7ees;","poem":1},{"text":"ne kawotethaa xam7ay xillotetha xam7aa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Neeni xillotethi dosada geellatethi ixaasa;","poem":1},{"text":"Hessa gisho, Xoossay, ne Xoossay,","poem":2},{"lineBreak":true},{"text":"ne laggetape aathidi,","poem":2},{"lineBreak":true},{"text":"nena ufaysa zayten tiyis.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Godare uuthan, karbeninne","poem":1},{"text":"burguden walaketida shitton, ne ma7oy puuketis.","poem":2},{"text":"Dangarsa zaalen alleeqetida,","poem":1},{"text":"ne kawo gadhon diixetiya diithay nena ufaysees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kawo keethan de7iya maccasata giddon;","poem":1},{"text":"kawota macca nayti de7oosona.","poem":2},{"text":"Kawiya Ofira worqan alleeqetada,","poem":1},{"text":"neepe ushacha baggan eqasu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ta naatte, si7a; wozanan wotha;","poem":1},{"text":"ne haytha haa zaara;","poem":2},{"lineBreak":true},{"text":"ne deriyanne ne aawa keethaa doga.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kawoy ne malan ufaytis;","poem":1},{"text":"ne godaa gidiya gisho iya boncha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xiroosa asay new woyto ekidi yaana;","poem":1},{"text":"dureti nena aaddashana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kawa na7iya,","poem":1},{"text":"kawo keethan waanna lo77ay!","poem":2},{"lineBreak":true},{"text":"I yaagano ma7oy worqan alleeqetis.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ba alleeqo ma7uwa ma7ada,","poem":1},{"text":"kawako moyzetasu.","poem":2},{"text":"I geela7o laggeti iyo kaallidi,","poem":1},{"text":"iya sinthe ekidi yidosona.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Enti ufaytishe yidi,","poem":1},{"text":"kawo gadho geloosona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kawaw, ne aawata bessaa ne nayti laattana;","poem":1},{"text":"biitta ubban ne enta shuumana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ta ne sunthaa yeleta ubban,","poem":1},{"text":"hassayetanaada oothana.","poem":2},{"lineBreak":true},{"text":"Hessa gisho, asay merinaw nena galatana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":17}