{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":46,"content":[{"type":"heading","content":["Xoossay Nuura De7ees"]},{"type":"hebrew_subtitle","content":["Qore Nayti Zammaareta Halaqaas Xaafida Mazmure"]},{"type":"hebrew_subtitle","content":["“Geela7o nayta yethi” geetetiya cuudhethan yexetida mazmure."]},{"type":"verse","number":1,"content":["Xoossay nu qosetidi attiya,",{"text":"bessenne nu wolqaa.","poem":2},{"text":"Nuna metoy gakiya wode,","poem":1},{"text":"I nuna maaddanaw ubba wode nu matan de7ees.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hessa gisho, biittay qaaxiyakoka,","poem":1},{"text":"dereti abban kundiyakoka,","poem":2},{"lineBreak":true},{"text":"nuuni yayyoko.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abbay guummidi gopontikoka,","poem":1},{"text":"iya wolqaama zuliyan dereti kokoriyakoka,","poem":2},{"lineBreak":true},{"text":"nuuni dagammoko. Salaha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ubbaafe Dhoqa Xoossay de7iya, Xoossaa katamaa,","poem":1},{"text":"geeshsha bessaa, ufaysiya issi shaafi de7ees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xoossay iya giddon de7iya gisho,","poem":1},{"text":"he katamay qaaxenna;","poem":2},{"lineBreak":true},{"text":"wonta guura Xoossay iya maaddana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Derey dagammis; kawotethati qaaxoosona;","poem":1},{"text":"Xoossay ba qaala sissis; biittay til7is.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ubbaafe wolqaama Goday nuura de7ees;","poem":1},{"text":"Yayqooba Xoossay nu qosetidi attiya besse. Salaha","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Haa yiite; Godaa oosuwa xeellite;","poem":1},{"text":"biitta waatidi dhaysidaako be7ite.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"I biitta bolla de7iya olaa ubbaa teqees;","poem":1},{"text":"dongenne toora menthees;","poem":2},{"lineBreak":true},{"text":"gondalliya","poem":2},{"noteId":3},{"text":"taman xuuggees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wopu giite; taani Xoosse gideysa erite;","poem":1},{"text":"taani kawotethata giddon dhoqu dhoqu gaana;","poem":2},{"lineBreak":true},{"text":"biitta bollaka dhoqu dhoqu gaana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ubbaafe Wolqaama Goday nuura de7ees;","poem":1},{"text":"Yayqooba Xoossay nu qosetidi attiya besse. Salaha.","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"Gondalliya: Ibraawetho doonan hare gaare geetetees.","reference":{"chapter":46,"verse":9}}]},"thisChapterLink":"/api/gof_ltw/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}