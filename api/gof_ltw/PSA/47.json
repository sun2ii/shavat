{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":47,"content":[{"type":"heading","content":["Xoossay Sa7a Ubba Godaa"]},{"type":"hebrew_subtitle","content":["Qore Nayta Mazmure"]},{"type":"verse","number":1,"content":["Dere ubbay hinte kushiya baqite;",{"text":"qaala dhoqu oothidi Xoossaa galatite.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ubbaafe dhoqa Goday waani yashshii?","poem":1},{"text":"biitta ubban I gita kawo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dereta nuupe garsara,","poem":1},{"text":"kawotethata nu tohuwape garsan haarisees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I nuus laata biitta dooris;","poem":1},{"text":"I dosiya Yayqoobi","poem":2},{"lineBreak":true},{"text":"he biittan ceeqetees. Salaha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Xoossay ufaysaninne ililsan pude dendis,","poem":1},{"text":"Goday moyze punon ba araatan keyis.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xoossaas zammarit; ee, iyaw zammarit;","poem":1},{"text":"iyaw kawas zammarit; ee, iyaw zammarit.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Xoossay biitta ubbaa kawo gidiya gisho,","poem":1},{"text":"galatan sabbite.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Xoossay ba geeshsha araatan uttis,","poem":1},{"text":"Xoossay kawotethata haarees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kawotethata halaqati,","poem":1},{"text":"Abrahaame Xoossaa asaara shiiqoosona.","poem":2},{"text":"Biittan de7iya wolqaama ubbay Xoossaba","poem":1},{"text":"gidiya gisho I ubbaafe dhoqu dhoqu gis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}