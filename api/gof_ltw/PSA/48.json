{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":48,"content":[{"type":"heading","content":["Xiyooney Nu Xoossa Zuma"]},{"type":"hebrew_subtitle","content":["Qore Nayta Mazmure"]},{"type":"verse","number":1,"content":["Goday gita; nu Xoossaa kataman",{"text":"iya geeshsha zumaa bolla gita galati iyaw bessees.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Biitta ubbaa ufaysi gidida,","poem":1},{"text":"pudeha baggara de7iya Xiyoone derey,","poem":2},{"lineBreak":true},{"text":"dhoqanne lo77o;","poem":2},{"lineBreak":true},{"text":"I gita kawa katama.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Xoossay he gimbiya giddona;","poem":1},{"text":"ika iyaw geshe gideysa erisis.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kawoti banta tooranchotara shiiqidosona;","poem":1},{"text":"Xiyoone olanaw yidosona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iya be7idi dagammidosona;","poem":1},{"text":"guye simmidi baqatidosona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Enti yan de7ishe yashshan kokoridosona;","poem":1},{"text":"iqethi oykida maccasada inxaxidosona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Doloha bagga wolqaama carkon","poem":1},{"text":"meqiya Tarsesa markabeta mela gididosona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nu si7idaysada,","poem":1},{"text":"Ubbaafe Wolqaama Godaa kataman,","poem":2},{"lineBreak":true},{"text":"nu Xoossaa kataman I oothidaba be7ida;","poem":2},{"lineBreak":true},{"text":"Xoossay he katamaa merinaw minthidi naagees. Salaha","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abeeti Xoossaw, ne keethan","poem":1},{"text":"merinaa ne siiquwa qopoos.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abeeti Xoossaw, ne sunthada","poem":1},{"text":"ne galatay sa7aa gaxaa gakis;","poem":2},{"lineBreak":true},{"text":"ne ushacha kushey xillotethan kumidaysa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne pirdaa gaason Xiyoone asay ufayto;","poem":1},{"text":"Yihuda kumethay ufaysan ililo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xiyoone yuushuwan hemetite;","poem":1},{"text":"I dirsa yuuyite; I shakota taybite.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yaa yeletas odana mela","poem":1},{"text":"iya gimbiya akeekite; miixata wochite.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hinte, “Merinaw Xoossay nu Xoossaa;","poem":1},{"text":"I nuna hayqana gakanaw kaalethana” yaagidi odite.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}