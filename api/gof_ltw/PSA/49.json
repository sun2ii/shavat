{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":49,"content":[{"type":"heading","content":["Meto Wodey Yashshenna"]},{"type":"hebrew_subtitle","content":["Qore Nayti Zammaareta Halaqaas Xaafida Mazmure."]},{"type":"verse","number":1,"content":["Asa ubbay haysa si7ite;",{"text":"biitta bolla de7eysato,","poem":2},{"lineBreak":true},{"text":"ubbay haysa hayzite.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dhoqay ziqay,","poem":1},{"text":"durey manqoy si7ite.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ta wozanaa qofay akeeka immees;","poem":1},{"text":"ta doonay cincatetha qaala odetees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ta haythaa leemisoko zaarana;","poem":1},{"text":"diithi diixashe, ta qan7ishiya birshana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Meto gallasay yaa wodenne cimmiya morketi;","poem":1},{"text":"tana teqiya wode ta ayis babbayna?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Banta shaluwan ammaneteysatanne","poem":1},{"text":"banta duretethan ceeqetiya","poem":2},{"lineBreak":true},{"text":"ta morketa ayis babbayna?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ay asika bana wozanaw,","poem":1},{"text":"woyko ba shempuwa gatiya","poem":2},{"lineBreak":true},{"text":"Xoossas qanxanaw danda7enna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Asa shempo gatey daro al7o;","poem":1},{"text":"Ay gate qanxinka gidenna.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"I hayqonnaadanne duufo gelonnaada,","poem":1},{"text":"woyko I hayqonnaada oothanaw gakenna.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Eeyatinne pathonna asati hayqeysada,","poem":1},{"text":"cincati banta shaluwa","poem":2},{"lineBreak":true},{"text":"haratas yeggidi beysa asa ubbay be7ees.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Enti banta biitta bantaba giikoka,","poem":1},{"text":"duufoy merinaw entaw keethe gidana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Asi ay gitatikoka ba gitatethaara kanthenna;","poem":1},{"text":"I do7ada hayqees.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bantarka banta huuphen ammaneteyisata qaadaynne","poem":1},{"text":"enti gidaba tuma giya eeyata wursethay haysa. Salaha","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Shukas giigetida dorsatada,","poem":1},{"text":"hayqoy enta duufo kaalethees.","poem":2},{"text":"Suureti enta duufuwa bollara hemetana;","poem":1},{"text":"enta asatethay duufon wooqana;","poem":2},{"lineBreak":true},{"text":"keethafe keyidi haakidi si7oolen attana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Shin Xoossay ta shempuwa wozana;","poem":1},{"text":"I tana hayqo wolqafe ashshana. Salaha","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Asi duretiya wodenne","poem":1},{"text":"iya bonchoy dariya wode yayyofa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"I hayqiya wode aykoka ekidi beenna;","poem":1},{"text":"iya shaloy iyara issife duufo gelenna.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Asi paxa de7iya wode taw kumis giiko,","poem":1},{"text":"ubbabay iyaw injetida gisho galatetikoka,","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"simmidi poo7o be7onna,","poem":2},{"lineBreak":true},{"text":"ba mayzatan gahetees.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Eratethi bayna duretida asi","poem":1},{"text":"do7ada coo dhayana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":20}