{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":5,"content":[{"type":"heading","content":["Wonta Woosa"]},{"type":"hebrew_subtitle","content":["Zammaareta Halaqaas Xaafetida Dawita Mazmure"]},{"type":"hebrew_subtitle","content":["Suusul7en yexetiya mazmure."]},{"type":"verse","number":1,"content":["Abeeti Godaw, ta qaala si7a;",{"text":"ta ooliya qopa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta kawaw, ta Xoossaw ta waasuwa si7a;","poem":1},{"text":"ta maade koyada woossiya woosaa hayza.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abeeti Godaw, wonta wonta","poem":1},{"text":"ta qaala si7aasa.","poem":2},{"text":"Wonta wonta ta woosa ne sinthe shiishayis;","poem":1},{"text":"ta ne zaaruwa naagayis.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Neeni iitatethan ufaytonna Xoosse;","poem":1},{"text":"iitabay neera deenna.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Otoranchoti ne sinthan eqokona;","poem":1},{"text":"iitabaa oothiya ubbaa ne ixaasa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wordo odeteyisata ne dhaysaasa;","poem":1},{"text":"Goday suuthu gusseysatanne","poem":2},{"lineBreak":true},{"text":"cimmeyisata ixees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Shin ta ne gita maarotethan ne keethaa gelana;","poem":1},{"text":"ne geeshsha bessaako simmada nena bonchon goyinnana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abeeti Godaw, ta morketa gisho gada,","poem":1},{"text":"tana ne xillotethan kaaletha;","poem":2},{"lineBreak":true},{"text":"ne ogiya ta sinthan suurisa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Enta mettershan tumi baawa;","poem":1},{"text":"enta wozanan dhaysoy kumis.","poem":2},{"text":"Enta doonay dooyetida duufo mela;","poem":1},{"text":"enti banta inxarsan cimmoosona.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Enti ne bolla makallida gisho,","poem":1},{"text":"abeeti Xoossaw, enta pirda;","poem":2},{"text":"Enta tobbay enta ekidi boo;","poem":1},{"text":"enta daro nagaraa gisho enta yedetha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Shin neeko baqatidi attida ubbay ufayto;","poem":1},{"text":"enti merinaw ufaysan yexo.","poem":2},{"text":"Ne sunthaa dosiya ubbay nenan ufaytana mela;","poem":1},{"text":"neeni enta merinaw naaga.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abeeti Godaw, neeni xillota anjaasa;","poem":1},{"text":"gondallen ashsheysada ne keehatethan iya ashsha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}