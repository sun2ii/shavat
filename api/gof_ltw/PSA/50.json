{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":50,"content":[{"type":"heading","content":["Xoossay Tuma Daynna"]},{"type":"hebrew_subtitle","content":["Asaafa Mazmure"]},{"type":"verse","number":1,"content":["Wolqaama Goday, Xoossay odees;",{"text":"dolohape wuloha gakanaw biitta ubbaa xeegees.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Medhon polo yegelsi gidida","poem":1},{"text":"Xiyoonepe Xoossay poo7ees.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nu Xoossay yaana; si77i geenna;","poem":1},{"text":"eexiya tamay iya sinthana;","poem":2},{"lineBreak":true},{"text":"wolqaama gotey iya yuushuwana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Xoossay ba asaa pirdiya wode,","poem":1},{"text":"salotanne sa7aa xeegees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Yarshon taara caaqida,","poem":1},{"text":"ta geeshshata taako shiishite” yaagis.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xoossay pirdiya gisho,","poem":1},{"text":"saloti iya xillotethaa awaajosona. Salaha","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Ta asaw, si7ite; ta hintew odayis;","poem":1},{"text":"Isra7eele asaw, ta ne bolla markatana;","poem":2},{"lineBreak":true},{"text":"taani Xoossay, ne Xoossaa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne yarshuwa gishonne","poem":1},{"text":"ne xuussa yarshuwa gisho,","poem":2},{"lineBreak":true},{"text":"nena borike.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ne daraape kormata,","poem":1},{"text":"ne girbiyafe kole ekanaw koyke.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Woran de7iya do7ati ubbay tabaa;","poem":1},{"text":"mukulu zumaa bolla de7iya mehetika taassa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Taani dhoqa deriyan de7iya kafota ubbaa erayis;","poem":1},{"text":"denban de7iya medhetethati tayisata.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tana koshaykoka nena oychike;","poem":1},{"text":"sa7inne sa7an kumidaba ubbay tabaa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Taani kormata ashuwa maynayee?","poem":1},{"text":"woyko deeshata suuthaa uyanayee?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Xoossas galata yarsho imma;","poem":1},{"text":"Ubbaafe dhoqa Xoossaas ne qangetha gatha.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Meto gallas tana xeega;","poem":1},{"text":"ta nena ashshana; neka tana bonchana” yaagees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Shin Xoossay iita asaa haysada yaagees;","poem":1},{"text":"“Ta higgiya ne nabbabanaw new ay maati de7ii?","poem":2},{"lineBreak":true},{"text":"Woyko ta caaquwa ne doonan qoncisanaw new ay maati de7ii?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Neeni ta timirtiya ixadasa;","poem":1},{"text":"ta qaala guye yeggadasa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kaysuwa be7ida wode neeni iyara dabbotadasa;","poem":1},{"text":"laymateyisata maabaran geladasa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ne doona iitabaa odetanaw billa yeddadasa;","poem":1},{"text":"Ne inxarsay wordo haasaya meezetis.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Uttada ne ishaa zigiradasa;","poem":1},{"text":"ne aaye na7aa bolla iitaba odetadasa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ne haysa ubbaa oothiya wode,","poem":1},{"text":"taani si77i gida gisho","poem":2},{"lineBreak":true},{"text":"tana ne mela gada qopadasa.","poem":2},{"lineBreak":true},{"text":"Shin ha77i ta nena hanqana;","poem":2},{"lineBreak":true},{"text":"ne nagaraa ne sinthan taybana.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hinteno, Xoossaa dogeysato, haysa akeekite;","poem":1},{"text":"hessi hanonna ixiko ta hintena mentherethana;","poem":2},{"lineBreak":true},{"text":"he wode hintena ashshanay baawa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Taw galata yarshey tana bonchees;","poem":1},{"text":"ba ogiya suurisida asas","poem":2},{"lineBreak":true},{"text":"taani Xoossaa atotetha bessaana” yaagees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}