{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":51,"content":[{"type":"heading","content":["Taw Geeshsha Wozana Imma"]},{"type":"hebrew_subtitle","content":["Dawiti zammaareta halaqaas xaafida mazmure"]},{"type":"hebrew_subtitle","content":["Dawiti Barsaabera laymatida wode nabiya Naatani iyaw odi simmin Dawiti yexida mazmure."]},{"type":"verse","number":1,"content":["Abeeti Xoossaw, ne merinaa siiquwada tana maara;",{"text":"ne qadheta daruwa mela ta nagaraa qucha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta iitatethaafe tana meecca;","poem":1},{"text":"ta nagaraape tana geeshsha.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taani ta qohuwa erayis;","poem":1},{"text":"ta nagaray ubba wode ta sinthana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taani nena, ne xalaala qohas;","poem":1},{"text":"ne sinthan iitabaa oothas.","poem":2},{"text":"Hessa gisho, ne hanquwan ne like;","poem":1},{"text":"ne pirdanka ne xillo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Heko ta yeletiya wode nagarancho;","poem":1},{"text":"ta aaye ulon buroo attiya,","poem":2},{"lineBreak":true},{"text":"wodepe doomada taani nagarancho.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Neeni asa wozanape tumatethi koyaasa;","poem":1},{"text":"ta gaatha asatethaa cincatethi tamaarsa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hisoophe boncon tana wurxa; ta geeyana;","poem":1},{"text":"tana meecca; ta shachafe aadhada booxana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne tana ufaysinne lo77oba sissa;","poem":1},{"text":"ne mentherethida ta meqethaa zaarada ufaysa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ne som7uwa ta nagaraape hara soo zaara;","poem":1},{"text":"ta bala ubbaa qucha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abeeti Xoossaw, geeshsha wozana tanan medha;","poem":1},{"text":"qaaxonna ayyaana ta giddon ooratha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tana ne sinthafe yeggofa;","poem":1},{"text":"ne Geeshsha Ayyaana taape ekofa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne atotetha ufaysaa taw zaara;","poem":1},{"text":"ta new kiitetana mela tana zempisa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ta he wode higge mentheyisata ne ogiya tamaarsana;","poem":1},{"text":"nagaranchotika neeko simmana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Abeeti Xoossaw, tana ashshiya Xoossaw,","poem":1},{"text":"suuthu gussiya nagarape tana ashsha;","poem":2},{"lineBreak":true},{"text":"he wode ta inxarsay ne xillotetha yexana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Abeeti Godaw, ta doona dooya;","poem":1},{"text":"ta inxarsay ne galataa awaajana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ne yarshon ufaytiyako, ta new yarshanashin,","poem":1},{"text":"ne xuussa yarshon ufaytaka.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Xoossaa yarshoy aada ayyaana;","poem":1},{"text":"Xoossaw, ne meqidanne","poem":2},{"lineBreak":true},{"text":"kawuyida wozanaa kadhaka.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Abeeti Xoossaw, dosan Xiyoones keeha;","poem":1},{"text":"Yerusalaame gimbeta gimba.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"He wode ne xillotetha yarshoninne","poem":1},{"text":"xuussa yarshon ufaytana.","poem":2},{"text":"pollo shiqiaya mehe yarshon ne ufaytana;","poem":1},{"text":"kormati ne yarsho bessan yarishetana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":19}