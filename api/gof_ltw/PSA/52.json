{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":52,"content":[{"type":"heading","content":["Xoossa Siiqoy Merinaasa"]},{"type":"hebrew_subtitle","content":["Dawiti Zammaareta Halaqaas Akeekan xaafida Ginxo"]},{"type":"hebrew_subtitle","content":["Edoome biitta asi gidida Doyqi Saa7olako bidi, “Dawiti Abimeleke soo bis” yaagidi odi simmin, Dawiti xaafida mazmure."]},{"type":"verse","number":1,"content":["Neno, wolqaama uraw, iitatethan ayis otortay?",{"text":"neno Xoossan kadhetidayso ubba wode ayis ceeqetay?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Neno, wordo odeteyso,","poem":1},{"text":"ne harata dhaysanaw maqetaasa;","poem":2},{"lineBreak":true},{"text":"ne inxarsay qara maqla mela.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne lo77o aggada iita dosaasa;","poem":1},{"text":"tuma aggada wordo odetaasa. Salaha","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Neno, wordanchuwaw,","poem":1},{"text":"ne bosha qaala ubbaa dosaasa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xoossay nena merinaw menthana;","poem":1},{"text":"Xoossay nena mentherethananne ne keethaafe dafidi kessana;","poem":2},{"lineBreak":true},{"text":"nena de7on de7eyisata giddofe shoddidi yeggana. Salaha","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xilloti hessa be7idi yayyana;","poem":1},{"text":"enti haysada yaagidi, ne bolla miicana;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Xoossaa baw geshe oothiboonna,","poem":1},{"text":"ba duretethan ammanetida,","poem":2},{"lineBreak":true},{"text":"iita ooson minnida,","poem":2},{"lineBreak":true},{"text":"addiya haysa be7ite” yaagana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Shin taani Xoossaa keethan aaciya shamaho mela;","poem":1},{"text":"iya siiquwan taani merinaw ammanetayis.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ne oothida gisho merinaw ta nena galatana;","poem":1},{"text":"neeni lo77o gidiya gisho ne sunthan ufaysi oothana;","poem":2},{"lineBreak":true},{"text":"geeshshata sinthan ta nena sabbana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}