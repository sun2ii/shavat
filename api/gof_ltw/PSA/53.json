{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":53,"content":[{"type":"heading","content":["Lo77o Oothiya Asi Baawa"]},{"type":"hebrew_subtitle","content":["Dawiti Zammaareta Halaqaas Xaafida Timirte"]},{"type":"hebrew_subtitle","content":["Akeekan xaafetida ginxo"]},{"type":"verse","number":1,"content":["Eeyati banta wozanan, “Xoossi baawa” yaagosona;",{"text":"enta de7oy iitis; enti tunabaa oothosona;","poem":2},{"lineBreak":true},{"text":"lo77oba oothiya asi issoyka baawa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Xoossaa koyiya cinca asi de7iyako be7anaw,","poem":1},{"text":"Goday salope asaa xeellees.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Enti ubbay Xoossaafe haakidosona;","poem":1},{"text":"ubbay issife tunidosona.","poem":2},{"text":"Lo77o oothiya asi deenna;","poem":1},{"text":"hari attoshin issi asika baawa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Asi kathi meysada ta asaa meysati,","poem":1},{"text":"ha iita oothiya asati erokona?","poem":2},{"lineBreak":true},{"text":"enti Xoossaa xeegokona?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Enti dagammi eronna dagama dagammana;","poem":1},{"text":"Xoossay ba asaa morketa meqethaa laallana;","poem":2},{"lineBreak":true},{"text":"Xoossay enta kadhida gisho enti yeellatana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isra7eele atotethay Xiyoonepe yeerenne!","poem":1},{"text":"Xoossay ba asaa di7uwa zaariya wode,","poem":2},{"text":"Yayqooba zareti ufayto;","poem":1},{"text":"Isra7eele asay ufaysan hashshu go.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}