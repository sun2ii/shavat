{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":54,"content":[{"type":"heading","content":["Xoossay Ta Shempuwa Naagees"]},{"type":"hebrew_subtitle","content":["Dawiti Zammaareta Halaqaas Diithan Yexida Akeeka Ginxo"]},{"type":"hebrew_subtitle","content":["Ziifa asati Saa7olako bidi, “Dawiti nu biittan qosetis” yaagidi odin, Dawiti xaafida mazmure"]},{"type":"verse","number":1,"content":["Abeeti Xoossaw, ne sunthan tana ashsha;",{"text":"ne wolqan taw pirda.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abeeti Xoossaw, ta woosa si7a;","poem":1},{"text":"ta doona qaala hayza.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Allaga asati ta bolla dendidosona;","poem":1},{"text":"daganthiya asati tana wodhanaw koyoosona;","poem":2},{"lineBreak":true},{"text":"enti Xoossaa qopokona. Salaha","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Xoossay taw maade;","poem":1},{"text":"Goday taw zempo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abeeti Xoossaw, ta morketa iitatethaa enta bolla zaara;","poem":1},{"text":"ne tumatethaa gisho enta dhaysa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Abeeti Godaw, taani ta dosan new yarshana;","poem":1},{"text":"ne keeha gidiya gisho ne sunthaa galatana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne tana, ta meto ubbaafe ashshadasa;","poem":1},{"text":"ta morketa xoonetethaa ta ayfen be7as.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}