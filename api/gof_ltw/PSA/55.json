{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":55,"content":[{"type":"heading","content":["Ne Toohuwa Xoossa Bolla Yegga"]},{"type":"hebrew_subtitle","content":["Dawiti Zammaareta Halaqaas Diithan Yexida Akeeka Mazmure."]},{"type":"verse","number":1,"content":["Abeeti Xoossaw, ta woosa si7a;",{"text":"ta magannuwa qelli goopa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tana si7a; ta woosaas zaaro imma;","poem":1},{"text":"ta qofay tana waaysin, ta un7etas.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ta morketa girsa si7ada dagammas;","poem":1},{"text":"iitata mandiya gaason kokoras.","poem":2},{"text":"Enti ta bolla meto ehoosona;","poem":1},{"text":"yilon dendidi tana morkoosona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ta wozanay dirgees;","poem":1},{"text":"hayqo hirgay tana wodhees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tana yashshinne kokorsi oykis;","poem":1},{"text":"iita dagami ta bolla wodhis.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Holleda taw qefey de7iyako,","poem":1},{"text":"paallada shempoy de7iya bessi gakanashin.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Taani haakada baanashin;","poem":1},{"text":"bazzon aqanashin. Salaha","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Taani gotepenne carkofe baqatada,","poem":1},{"text":"ta qosetiya bessi demmanashin.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abeeti Godaw, katamaa giddon","poem":1},{"text":"ooshshinne gene be7ida gisho","poem":2},{"lineBreak":true},{"text":"iitata odaa laalla.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Iitati gallasinne qamma","poem":1},{"text":"katamaa gimbe dirsaa yuuyosona;","poem":2},{"lineBreak":true},{"text":"waayeynne metoy katamaa giddon de7ees.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dhayoy iya giddon de7ees;","poem":1},{"text":"naaqoynne cimoy iya dabaabape shaaketenna.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tana cayey ta morkiya gidenna;","poem":1},{"text":"iya gidiyako ta danda7anashin.","poem":2},{"text":"Ta bolla ceeqetey tana ixeysa gidenna;","poem":1},{"text":"iya gidiyako ta iyape qosetanashin.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Shin hessa oothey nena,","poem":1},{"text":"ta laggiya; ta dabbuwanne ta siiquwa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nu issoy issuwara ulo oda odetida;","poem":1},{"text":"Xoossa keethan dabaaban asaara issife simeretida.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Enta wozanan iitatethi de7iya gisho,","poem":1},{"text":"ta morketi qoponna hayqo;","poem":2},{"lineBreak":true},{"text":"enti paxa de7ishe duufo gelo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Shin taani Xoossaa xeegana;","poem":1},{"text":"Goday tana ashshana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wonta, gallasinne omarsi waassana;","poem":1},{"text":"ta metuwa iyaw odana; I tana si7ana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Daroti tana morkikoka,","poem":1},{"text":"I tana toorape ashshees.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Benipe ba araatan uttida Xoossay,","poem":1},{"text":"banta ogiya laammonna gishonne","poem":2},{"lineBreak":true},{"text":"iyaw yayyonna gisho tana si7idi enta kawushana. Salaha","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ta laggey ba dabbota qohis;","poem":1},{"text":"entara caaqida caaquwa menthis.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Iya doonay oysape liiqo;","poem":1},{"text":"shin ba wozanan ola denthees.","poem":2},{"text":"Iya inxarsay zaytepe aadhida shugo;","poem":1},{"text":"shin qanxanaw giigida qara mashsha mela.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ne toohuwa Xoossa bolla yegga;","poem":1},{"text":"I nena katisana.","poem":2},{"text":"Xoossay xilloti,","poem":1},{"text":"dagammana mela oothenna.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Shin Abeeti Xoossaw,","poem":1},{"text":"iita asata wolqaama ollan holana.","poem":2},{"text":"Suuthu gusseysatinne cimmeysati,","poem":1},{"text":"banta laythaafe baggaaka de7okona;","poem":2},{"lineBreak":true},{"text":"shin taani nenan ammanetana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}