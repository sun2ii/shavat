{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":56,"content":[{"type":"heading","content":["Xoossa Bolla Zempa"]},{"type":"hebrew_subtitle","content":["Filisxeeme Asay Geete Kataman Dawita Oykida Wode Dawiti Zammaareta Halaqaas Xaafida Woosa."]},{"type":"hebrew_subtitle","content":["“Haaho bessan wola bolla uttida hollees” geetetiya diitha cuudhethan yexetida woosa."]},{"type":"verse","number":1,"content":["Abeeti Xoossaw, asay tana un7ethiya gishonne",{"text":"ubba wode ta morketi tana yedethiya gisho taw qadheta.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta morketi kumetha gallas tana yedhoosona;","poem":1},{"text":"otoron tana oliya asay daro.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tana yashshiya wode","poem":1},{"text":"ta nenan ammanetayis.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taani Xoossan ammanetayis; yayyike;","poem":1},{"text":"iya qaala galatiya Xoossan ammanetayis;","poem":2},{"lineBreak":true},{"text":"asi tana ay oothanee?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kumetha gallasan ta morketi bala koyoosona;","poem":1},{"text":"tana qohanaw ubba wode tobboosona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Enti ta bolla maqetoosona;","poem":1},{"text":"tana qohanaw geeddosona.","poem":2},{"text":"Ta tango ubba kaalloosona;","poem":1},{"text":"tana wodhanaw koyoosona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Enti ay ogeraka kessi ekana mela oothofa;","poem":1},{"text":"ne hanquwan he kawotethata kawusha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ta waayiya tayba;","poem":1},{"text":"ne ta afuthaa makadasa;","poem":2},{"lineBreak":true},{"text":"enti ne mazgabiyan de7okona?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ta nena xeegiya wode,","poem":1},{"text":"ta morketi guye simmana;","poem":2},{"lineBreak":true},{"text":"Xoossay ta bagga gideysa ta hessan erayis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta iya qaala galatiya Xoossan,","poem":1},{"text":"ta iya qaala galatiya Godan,","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ta he Xoossan ammanetayis; yayyike.","poem":2},{"lineBreak":true},{"text":"asi tana ay oothannee?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abeeti Xoossaw ta new qangidabay de7ees;","poem":1},{"text":"hessa galataa yarsho oothada ta new immana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"De7on de7eyisata bolla poo7iya poo7uwan","poem":1},{"text":"Xoossaa sinthan simeretana mela,","poem":2},{"lineBreak":true},{"text":"ta shempuwa hayqope,","poem":2},{"lineBreak":true},{"text":"ta tohuwa dhubepe ashshadasa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}