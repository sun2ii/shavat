{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":57,"content":[{"type":"heading","content":["Ne Bonchoy Sa7a Ubban Gido"]},{"type":"hebrew_subtitle","content":["Dawiti Saa7olape baqatidi Gongolon Qosetida Wode Zammaareta Halaqaas Xaafida Woosa"]},{"type":"hebrew_subtitle","content":["“Dhaysofa” geetetiya diitha cuudhethan yexetida woosa."]},{"type":"verse","number":1,"content":["Tana maara; abeeti Xoossaw,",{"text":"tana maara; ta neeko baqatayis.","poem":2},{"text":"Dhayoy aadhana gakanaw,","poem":1},{"text":"ne qefiya garsan qosetayis.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taani Ubbaafe dhoqa Xoossako,","poem":1},{"text":"ba qofaatho oothiya Xoossako waassayis.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Xoossay salope maado kiittidi tana ashshana;","poem":1},{"text":"tana yedheyisata kawushana;","poem":2},{"text":"Xoossay ba siiquwanne","poem":1},{"text":"ba ammanetetha taw kiittana. Salaha","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taani ta morketape giddon,","poem":1},{"text":"ase miya gaammotape giddon de7ayis.","poem":2},{"text":"Enta achay tooranne donge toora mela;","poem":1},{"text":"enta inxarsay qara mashsha mela.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abeeti Xoossaw, ne salope aadhada dhoqu dhoqu ga;","poem":1},{"text":"ne bonchoy sa7a ubbaa kammo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Enti ta tohuwas xihe wothidosona;","poem":1},{"text":"taani un7etada hokas.","poem":2},{"text":"Enti ta ogiyan olla bookidosona;","poem":1},{"text":"shin he ollan bantaw kundidosona. Salaha","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta wozanay mino;","poem":1},{"text":"abeeti Xoossaw, ta wozanay mino;","poem":2},{"lineBreak":true},{"text":"taani nena mazmuren sabbana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ta shempe, barka;","poem":1},{"text":"diithinne maasinqoy dendite;","poem":2},{"lineBreak":true},{"text":"taani guura barkana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abeeti Godaw, ta nena asaa giddon galatana;","poem":1},{"text":"kawotethata giddon nena sabbana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne siiqoy salotape dhoqa;","poem":1},{"text":"ne ammanetethay shaarape bolla.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abeeti Xoossaw, ne salope aadhada dhoqu dhoqu ga;","poem":1},{"text":"ne bonchoy sa7a ubbaa kammo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}