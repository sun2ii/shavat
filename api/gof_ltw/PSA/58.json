{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":58,"content":[{"type":"heading","content":["Xoossay Sa7a Ubba Pirdana"]},{"type":"hebrew_subtitle","content":["Dawiti Zammaareta Halaqaas Xaafida Woosa"]},{"type":"hebrew_subtitle","content":["“Dhaysofa” geetetiya diitha cuudhethan yexetida woosa."]},{"type":"verse","number":1,"content":["Deriya haareysato, tuma hinte like odeteetii?",{"text":"Asa ubbaas xillo pirdeetii?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gidenna, hinte wozanan iitabaa halcheeta;","poem":1},{"text":"hinte kushey biitta bolla geellaba oothees.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iita asi aaye ulope doomidi halees;","poem":1},{"text":"yeletida gallasape doomidi,","poem":2},{"lineBreak":true},{"text":"baleesinne wordo odetees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Enti shooshada yiishshara de7oosona;","poem":1},{"text":"enti tulle gopeda si7okona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Biteysi ay cinca gidikoka,","poem":1},{"text":"Gopey iya xeessi si7enna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Abeeti Xoossaw, gaammo achi daaniya enta achaa mentha;","poem":1},{"text":"Godaw enta sakiliya dhuka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Enti gukida haathi gido;","poem":1},{"text":"banta dongiya dukiya wode,","poem":2},{"lineBreak":true},{"text":"donge toora ayfey dhayo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Enti maaydi dhayiya dhaadhe saassoda hano;","poem":1},{"text":"aaye ulope hayqidi wodhiya,","poem":2},{"lineBreak":true},{"text":"awa poo7o be7onna boshada hano.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Enti agunthi gididi daayanape kase,","poem":1},{"text":"enti buroo puuto gididi de7ishin,","poem":2},{"lineBreak":true},{"text":"enta ba hanquwan dhaysana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nagaranchota bolla halo keyiya wode xilloti ufaytana;","poem":1},{"text":"iitata suuthan banta tohuwa meecetana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"He wode asay,","poem":1},{"text":"“Tuma xillotas woytoy de7ees;","poem":2},{"lineBreak":true},{"text":"sa7a bolla pirdiya Xoossi de7ees” yaagana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}