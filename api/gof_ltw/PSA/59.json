{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":59,"content":[{"type":"heading","content":["Xoossaw Tana Ta Morketape Ashsha"]},{"type":"hebrew_subtitle","content":["Dawita wodhanaw iya keetha naagana mela Saa7oli ase kiittin, Dawiti zammaareta halaqaas xaafida woosa"]},{"type":"hebrew_subtitle","content":["“Dhaysofa” geetetiya diitha cuudhethan yexetida woosa."]},{"type":"verse","number":1,"content":["Abeeti ta Xoossaw, ta morketape tana ashsha;",{"text":"ta bolla dendeysatape tana naaga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iita ootheysatape tana ashsha;","poem":1},{"text":"suuthu gussiya asatape tana ashsha.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abeeti Godaw, enti tana wodhanaw","poem":1},{"text":"zugidi naageysa be7a.","poem":2},{"text":"Abeeti Godaw, ta naaquwa gisho","poem":1},{"text":"woyko ta nagaraa gisho","poem":2},{"lineBreak":true},{"text":"gidonashin coo ta bolla tobboosona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ta ay balaka oothonna tana qohanaw giigidosona;","poem":1},{"text":"hessa be7a; tana maaddanaw denda.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abeeti Ubbaafe Wolqaama Xoossaw, Godaw,","poem":1},{"text":"Isra7eele Xoossaw, kawotethata ubbaa pirdanaw barka;","poem":2},{"lineBreak":true},{"text":"iita ootheyisata maaropa. Salaha","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Enti katamaa giddon yuuyishe pee7idi,","poem":1},{"text":"kanatho laawishe simmoosona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Enta doonape keyeysa be7a;","poem":1},{"text":"enta inxarsay mashsha mela;","poem":2},{"lineBreak":true},{"text":"asi entana si7eysa qopokona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Shin abeeti Godaw, ne enta bolla miicaasa;","poem":1},{"text":"kawotethata ubbaa leqisaasa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Xoossaw, ne ta miixaa gidiya gisho,","poem":1},{"text":"ta ne wolqan ammanetayis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta Xoossay ba siiquwan taako yaana;","poem":1},{"text":"ta Xoossay ta morketa xoonetethaa tana bessaana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ta asati dogonna mela ne enta wodhopa.","poem":1},{"text":"Abeeti Godaw, nu gondalliyaw,","poem":2},{"lineBreak":true},{"text":"ne wolqan enta laallanne kawusha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Enta doonape keyiya nagaraa gisho","poem":1},{"text":"enta inxarsaafe pultiya qaala gisho,","poem":2},{"lineBreak":true},{"text":"banta otoruwan oyketo;","poem":2},{"lineBreak":true},{"text":"enta baadethanne worduwa gisho,","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ne hanquwan enta dhaysa;","poem":2},{"lineBreak":true},{"text":"enta kumethi digga.","poem":2},{"text":"Hessan Xoossay Yayqooba zeretha haareysanne","poem":1},{"text":"sa7aa gaxaa gakanaw haareysi eretana. Salaha","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Enti katamaa giddon yuuyishe pee7idi,","poem":1},{"text":"kanatho laawishe simmoosona.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Enti miyaba demmanaw toylatoosona;","poem":1},{"text":"kallona attida laawiya kana gidoosona.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Shin taani ne wolqaa sabbana;","poem":1},{"text":"wonta ne siiquwa yexana.","poem":2},{"text":"Neeni taw ta waayiya gallas,","poem":1},{"text":"ta baqata attiya bessenne miixa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Abeeti taw wolqa gidida Xoossaw,","poem":1},{"text":"ta nena sabbana.","poem":2},{"text":"Ta qosetada attiya bessaynne","poem":1},{"text":"siiquwa tana bessiya Xoossay nena.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}