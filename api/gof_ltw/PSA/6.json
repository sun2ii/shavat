{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":6,"content":[{"type":"heading","content":["Un7a Wode Woosa"]},{"type":"hebrew_subtitle","content":["Zammaareta Halaqaas Xaafetida Dawita Mazmure"]},{"type":"hebrew_subtitle","content":["Hospun shayan yexetiya mazmure"]},{"type":"verse","number":1,"content":["Abeeti Godaw, ne yiluwan tana seeropa;",{"text":"ne sheniyan tana hanqofa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abeeti Godaw, taani daaburancho gidida gisho tana maara;","poem":1},{"text":"abeeti Godaw, ta wozanay argaacida gisho tana mintha.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ta shempiya daro un7etasu;","poem":1},{"text":"tana maaddanaw awude gakanaw gam7ay?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Abeeti Godaw, neeni simmada tana ashsha;","poem":1},{"text":"ne keehatetha daruwan tana kessa eka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hayqida asaa giddofe nena hassayey baawa;","poem":1},{"text":"duufon gididi nena galatey oonee?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taani oolen daaburas;","poem":1},{"text":"qamma kumethi yeekashe ta hiixa irxisas;","poem":2},{"lineBreak":true},{"text":"ta arsa afuthan wooqisas.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta morketa gaason ta ayfey mulcatis;","poem":1},{"text":"taani afuxida gisho demmonna ixis.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Goday ta yeehuwa si7ida gisho,","poem":1},{"text":"hinteno, iita ootheysato taape haakite.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Goday ta waasuwa si7is;","poem":1},{"text":"ta woosa ekis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta morketi ubbay yeellatidosona; dagammidosona;","poem":1},{"text":"qoponna guye simmidi kawuyidosona.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}