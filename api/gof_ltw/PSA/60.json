{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":60,"content":[{"type":"heading","content":["Nu Morketape Nuna Ashsha"]},{"type":"hebrew_subtitle","content":["Masephexoomeninne Soobalan de7ida Araame asaara oletida wodenne Iyo7aabi guye simmidi Maxine zangaaran tammanne nam7u mukulu Edoome asaa wodhida wode Dawiti zammaareta halaqaas xaafida woosa"]},{"type":"hebrew_subtitle","content":["“Ciishsha cuudhethe” geetetiya markatetha woosa."]},{"type":"verse","number":1,"content":["Abeeti Xoossaw, ne nuna aggadasa;",{"text":"nuna mentherthadasa.","poem":2},{"text":"Ne nuna hanqetadasa;","poem":1},{"text":"shin ha77i nuna zaara; mintha essa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne biitta qaathadasanne za7isadasa;","poem":1},{"text":"biittay kokoriya gisho, ne iya za7uwa kuntha.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Neeni ne asaa meto bessadasa;","poem":1},{"text":"nuna gandigarsiya woyne ushshadasa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"New yayyeysati banta morke dongefe","poem":1},{"text":"attana mela malla immadasa. Salaha","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne siiqeysati attana mela,","poem":1},{"text":"ne ushacha kushen","poem":2},{"lineBreak":true},{"text":"nuna ashsha; nuna alla.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xoossay ba geeshsha bessan haysada yaagis;","poem":1},{"text":"“Taani xoonada Seekema biitta shaakana;","poem":2},{"lineBreak":true},{"text":"Sukota zangaara wadhana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Galadi tabaa; Minaaseyka taassa;","poem":1},{"text":"Efreemey ta huuphe ashshiya birata qoobe;","poem":2},{"lineBreak":true},{"text":"Yihudi ta kawota xam7aa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Moo7abey ta meecetiya kere;","poem":1},{"text":"Edoomey tabaa gideysa erisanaw,","poem":2},{"lineBreak":true},{"text":"ta caammaa iya bolla wothayis;","poem":2},{"lineBreak":true},{"text":"taani Filisxeeme xoonada gereerayis” yaagis.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gimbetida katamaako tana oone efanay?","poem":1},{"text":"Edoome gakanaw tana oone kaalethanay?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abeeti Xoossaw, nuna aggiday nena gidikii?","poem":1},{"text":"Abeeti Xoossaw neeni nu olanchotara olas keyaka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Asa maadoy pathonna gisho,","poem":1},{"text":"morketara oletanaw ne nuna maadda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xoossaa wolqan nu morketa xoonana;","poem":1},{"text":"I nu morketa yedhana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":12}