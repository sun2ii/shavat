2}]},{"type":"verse","number":6,"content":[{"text":"Kawa laytha adussa;","poem":1},{"text":"I yeletethaafe yeletethaa gakanaw de7o.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I Xoossaa sinthan merinaw kawoto;","poem":1},{"text":"ne siiquwaninne ne tuman iya naaga.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hessa gisho ta qangetha gallas gallas gathana;","poem":1},{"text":"ne sunthaa ubba wode sabbana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}