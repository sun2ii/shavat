{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":62,"content":[{"type":"heading","content":["Xoossa Xalaalan Ufaysi Wotha"]},{"type":"hebrew_subtitle","content":["Dawiti Zammaareta Halaqa Edotaames Xaafida Mazmure."]},{"type":"verse","number":1,"content":["Xoossaa xalaalan ta shempo demmas;",{"text":"ta atotethay iyape yees.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iya xalaali ta zaallanne ta atotetha;","poem":1},{"text":"I ta qosetiya attiya bessi gidiya gisho dagammike.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Woddana haniya godaanne qaaxiya dirsi daaniya uraa wodhanaw,","poem":1},{"text":"hinte awude gakanaw dendetii?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Enti iya boncho bessaafe denthanaw koyoosona;","poem":1},{"text":"enti wordon ufaytoosona.","poem":2},{"text":"Banta doonan anjoosona;","poem":1},{"text":"shin banta wozanan baaddoosona. Salaha","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ta shempete!","poem":1},{"text":"Xoossaa xalaala si77i gada naaga;","poem":2},{"lineBreak":true},{"text":"ta ufaysay iyape yees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iya xalaali ta zaallanne ta atotetha;","poem":1},{"text":"taani qosetiya bessi gidiya gisho dagammike.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta atotethaynne ta bonchoy Xoossana;","poem":1},{"text":"I ta mino zaallanne ta miixaa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Asaw, ubba wode Xoossan ammanetite;","poem":1},{"text":"I hintew geshe gidiya gisho,","poem":2},{"lineBreak":true},{"text":"hinte qofaa iyaw odite. Salaha","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Asi, issi toho shempiya carko mela;","poem":1},{"text":"gooba asi ubbay maaddonna hada.","poem":2},{"text":"Mizaanen wothin enti carko mela;","poem":1},{"text":"enti issi toho shempiya carkofe kawuyoosona.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bonqen ammanetofite;","poem":1},{"text":"kaysoti shiishidi duretethan otortofite.","poem":2},{"lineBreak":true},{"text":"Hinte duretethay darikoka,","poem":2},{"lineBreak":true},{"text":"hinte wozana iya bolla wothofite.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Xoossay issi toho odis;","poem":1},{"text":"taani nam7u oda si7as;","poem":2},{"lineBreak":true},{"text":"wolqi xoossasa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Merinaa siiqoy Xoossaba;","poem":1},{"text":"Abeeti Godaw, ne asa ubbaas","poem":2},{"lineBreak":true},{"text":"iya oosuwada oosuwada immana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}