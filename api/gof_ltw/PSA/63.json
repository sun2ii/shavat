{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":63,"content":[{"type":"heading","content":["Ta Shempiya Nena Saamotasu"]},{"type":"hebrew_subtitle","content":["Yihuda Mela Biittan De7iya Wode Dawita Mazmure."]},{"type":"verse","number":1,"content":["Abeeti Xoossaw, ne ta Xoossaa;",{"text":"ta wozanay nena laamotees;","poem":2},{"lineBreak":true},{"text":"ta ashoyka nena amottees.","poem":2},{"text":"Haathi dhayidi phalqetida biittada,","poem":1},{"text":"ta asatethay nena saamotees.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta nena geeshsha bessan xeellas;","poem":1},{"text":"ne wolqaanne ne bonchuwa taani be7as.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne siiqoy de7ope lo77iya gisho,","poem":1},{"text":"ta inxarsay nena bonchana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ta de7o laythan nena galatana;","poem":1},{"text":"ne sunthan ta kushiya pude miccana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Asi lo77o kathi midi kalleysada ta nenan kallana.","poem":1},{"text":"Taani ta inxarsan ufaysa yethan nena galatana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taani ta hiixan nena hassayayis;","poem":1},{"text":"qamma kumethan nebaa qopayis;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne tana maaddiya gisho,","poem":1},{"text":"Ta ne qefiya kuyan uttada ufaysan yexana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ta shempiya neera oyketasu;","poem":1},{"text":"ne ushacha kushey tana oykidi naagees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Shin tana wodhanaw koyeysati,","poem":1},{"text":"biitta garsan moogetana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Enti mashshas aadhidi imetana;","poem":1},{"text":"enti suudhumes kaho gidana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Shin kawoy Xoossan ufaytana.","poem":1},{"text":"Xoossaa sunthan caaqiya ubbay iya galatana;","poem":2},{"lineBreak":true},{"text":"shin wordanchota doonay gordetana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}