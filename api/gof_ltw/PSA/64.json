{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":64,"content":[{"type":"heading","content":["Iitatape Tana Ashsha"]},{"type":"hebrew_subtitle","content":["Zammaareta Halaqaas yexetida Dawita Mazmure."]},{"type":"verse","number":1,"content":["Abeeti Xoossaw, ta un7a woosa si7a;",{"text":"ta morketa mandethafe; tana ashsha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nagaranchota maqofenne","poem":1},{"text":"iitata duulataape tana gentha.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Enti banta inxarsaa mashsha mela leefidosona;","poem":1},{"text":"iita qaalata donge toorada mallidi yeddoosona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Enti qosetidi xillo asi banta dongiyan qohoosona;","poem":1},{"text":"akeeki bayna dukoosona; yayyokona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Enti banta iita maquwas","poem":1},{"text":"issoy issuwa minthethoosona.","poem":2},{"text":"Banta xihiya wothana bessa koyoosona;","poem":1},{"text":"enti, “Nuna ooni be7anee?” yaagosona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Enti iitabaa maqetishe,","poem":1},{"text":"“Nuuni lo77o maqo maqetida” yaagosona;","poem":2},{"lineBreak":true},{"text":"Hessi asa wozana qofi ciimmo gideysa bessees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Shin Xoossay enta ba dongiyan dukana;","poem":1},{"text":"enti akeekona madunxana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Enta maquwa I enta bolla zaarana;","poem":1},{"text":"enta be7iya ubbay huuphe qaathana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"He wode asa ubbay Xoossas yayyana;","poem":1},{"text":"iya oosuwa odananne zaari zaari qopana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Xilloti Godan ufayto;","poem":1},{"text":"iyako baqatidi atto;","poem":2},{"lineBreak":true},{"text":"wozana suureti ubbay iya galato.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}