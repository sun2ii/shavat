{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":65,"content":[{"type":"heading","content":["Xoossay Ta Atotetha"]},{"type":"hebrew_subtitle","content":["Zammaareta Halaqaas Yexetida Dawita Mazmure."]},{"type":"verse","number":1,"content":["Abeeti Xoossaw, Xiyoonen new galati bessees;",{"text":"nuuni nu qangetha new gathana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Neeni woosa si7iya gisho,","poem":1},{"text":"asa ubbay neeko yoosona.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nu nagaray nuna muukida wode,","poem":1},{"text":"ne nuus atotethi immadasa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne dooridaysatinne ne dabaaban daana mela","poem":1},{"text":"neeko shiishida asi anjetidaysa.","poem":2},{"text":"Nuuni ne son, ne geeshsha dunkaaniyan","poem":1},{"text":"de7iya lo77oban kalloos.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abeeti nu atotethaw,","poem":1},{"text":"malaalsiya ne xillo oosuwan nuus zaara.","poem":2},{"text":"Sa7aa gaxape gaxaa gakanaw,","poem":1},{"text":"haahon de7iya ubbaas ne ufaysi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Neeni ne wolqan dereta minthadasa;","poem":1},{"text":"ne wolqaa dancadasa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Neeni abba girsaanne beeta guntha si77i oothaasa;","poem":1},{"text":"yarkiya asaa waasuwa irxisaasa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne oothida malaata gisho,","poem":1},{"text":"sa7aa gaxaa gakanaw de7iya asa ubbay new yayyana;","poem":2},{"lineBreak":true},{"text":"dolohape wuloha gakanaw de7iya asa ubbaa ufaysadasa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ne ira immada biitta naagasa; daro dureyasa;","poem":1},{"text":"asaas kathay dolana mela","poem":2},{"text":"Xoossa shaafay haathan kumidaysa;","poem":1},{"text":"hessada oothada ne giigisadasa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Goshshas haathe immaasa;","poem":1},{"text":"biitta shugisada ollaa kunthaasa.","poem":2},{"text":"Ne iran zaarada irxisaasa;","poem":1},{"text":"kathay dolana diccana mela anjaasa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Laytha kalo laythi oothaasa;","poem":1},{"text":"ne aadhiya bessa ubbay kumidi palahana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hentha bessata maatan kunthaasa;","poem":1},{"text":"zumata ufaysi mayzaasa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ne hentha bessata dorsata kunthaasa;","poem":1},{"text":"zangaara biittan kathi kunthaasa;","poem":2},{"lineBreak":true},{"text":"enti ufaysan ililishe yexoosona.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}