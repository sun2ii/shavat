{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":66,"content":[{"type":"heading","content":["Ne Oosoti Malaalisees"]},{"type":"hebrew_subtitle","content":["Zammaareta Halaqaas Yexetiya Saba Mazmure."]},{"type":"verse","number":1,"content":["Biitta ubbay hinte qaala dhoqu oothidi,",{"text":"ufaysan Xoossaa galatite.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Xoossaa sunthaas bonchon yexite;","poem":1},{"text":"boncho galataa iyaw immite.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Xoossaas haysada yaagite;","poem":1},{"text":"“Ne oosoti waanidi malaalsii?","poem":2},{"text":"Ne wolqay darida gisho,","poem":1},{"text":"ne morketi yashshan ne sinthan kokoroosona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Biitta ubbay nena goyinnees;","poem":1},{"text":"nena sabbees;","poem":2},{"lineBreak":true},{"text":"ne sunthaas galatan yexoosona” yaagite. Salaha","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Haayite; Xoossay oothidaba be7ite;","poem":1},{"text":"asaa giddon malaalsiya ooso oothis.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I abba haatha shaakidi,","poem":1},{"text":"kase nu aawati Yordaanose shaafa banta tohon yedhidi mela biittara pinnidosona.","poem":2},{"lineBreak":true},{"text":"Hessan I oothidaban nuuni ufaytida.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I ba wolqan merinaw haarees.","poem":1},{"text":"Kawotethata ba ayfen xeellees;","poem":2},{"lineBreak":true},{"text":"hessa gisho, makalleysati iya bolla dendofo. Salaha","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Asaw, nu Xoossaa galatite;","poem":1},{"text":"hinte iya galatiya galatay si7etto.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"I nuna paxa wothis;","poem":1},{"text":"nu kundonna mela naagis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abeeti Xoossaw ne nuna paacadasa;","poem":1},{"text":"biri taman paacetidi geeyeysada","poem":2},{"lineBreak":true},{"text":"ne nuna geeshshadasa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne nuna xihen gelsadasa;","poem":1},{"text":"nu zokon deexo toho wothadasa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Morketi nu huuphera toggidi aadhanada oothadasa;","poem":1},{"text":"Nu haatha giddoranne tama giddora aadhida;","poem":2},{"lineBreak":true},{"text":"shin ha77i nuna inje bessi ehadasa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ta xuussa yarsho ekada ne keethaa gelana,","poem":1},{"text":"ta qangetha gathana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ta metootida wode ta doonay gida qaala,","poem":1},{"text":"ta inxarsaafe keyida qangetha gathana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ta new modhuwa, xuussa yarsho oothada shiishana.","poem":1},{"lineBreak":true},{"text":"Marazeta sawo tonku giya yarsho oothada shiishana;","poem":1},{"text":"Kormanne koleta new yarshana. Salaha","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hinteno, Xoossas yayyeysato,","poem":1},{"text":"ubbay haa yidi, si7ite;","poem":2},{"lineBreak":true},{"text":"Xoossay taw oothidaba ta hintew odana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ta qaala dhoqu oothada woossas;","poem":1},{"text":"ta inxarsan iya galatas.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Taani wozani erishin nagara genthidaba gidiyako,","poem":1},{"text":"Goday tana si7enna.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Shin Xoossay tuma tana si7is;","poem":1},{"text":"ta oysha zaaris.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Xoossay ta woosa ixiboonna gisho,","poem":1},{"text":"ba merinaa siiquwa","poem":2},{"lineBreak":true},{"text":"tana diggiboonna gisho galatetto.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}