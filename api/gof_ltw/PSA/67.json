em":2}]},{"type":"verse","number":6,"content":[{"text":"Biittay kathi immana;","poem":1},{"text":"Xoossay, nu Xoossay nuna anjis.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Xoossay nuna anjida gisho,","poem":1},{"text":"biitta gaxaa gakanaw de7iya asay iya yayyo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}