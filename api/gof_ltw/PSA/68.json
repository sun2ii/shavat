{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":68,"content":[{"type":"heading","content":["Xoossay Ba Morketa Laallana"]},{"type":"hebrew_subtitle","content":["Zammaareta Halaqaas Yexetida Dawita Mazmure."]},{"type":"verse","number":1,"content":["Xoossay dendo; iya morketi laaleto;",{"text":"Iya ixeysati iya sinthafe baqato.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Cuyay carkora dendidi dhaysiya mela,","poem":1},{"text":"muqaadi taman til7eysada,","poem":2},{"lineBreak":true},{"text":"iitati Xoossaa sinthafe dhayo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Shin xilloti hashshu go;","poem":1},{"text":"Xoossaa sinthan ufayto;","poem":2},{"lineBreak":true},{"text":"ufaysan ililo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Xoossaas yexite; iya sunthaa sabbite;","poem":1},{"text":"shaaran beysas oge kessite;","poem":2},{"lineBreak":true},{"text":"iya sunthay Godaa; iya sinthan ufaytite.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xoossay ba de7iya geeshsha bessan,","poem":1},{"text":"yi7otas aawa; am7etas daynna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xoossay bizzatas soo asi immees;","poem":1},{"text":"qasho keethan de7eyisata birshidi, duretethan wothees;","poem":2},{"lineBreak":true},{"text":"shin makallanchoti qaaqa biittan de7oosona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abeeti Xoossaw, neeni ne asaa kaalethida wode,","poem":1},{"text":"ne entara mela biitta kanthida wode, Salaha","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Siina Xoossaa yuussaninne,","poem":1},{"text":"Isra7eele Xoossaa qoncethan","poem":2},{"lineBreak":true},{"text":"biittay qaaxis; saloy ira immis.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abeeti Xoossaw neeni ira darsada bukisadasa;","poem":1},{"text":"laddida biitta zaarada oorathaasa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne asay yan duussu oykis;","poem":1},{"text":"abeeti Xoossaw, ne keehatethan manqotas","poem":2},{"lineBreak":true},{"text":"koshshiyaba giigisada immadasa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Goday kiittis;","poem":1},{"text":"daro Maccasati he kiitaa markatidosona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kawotinne enta olanchoti","poem":1},{"text":"baqatidi guye simmidosona;","poem":2},{"lineBreak":true},{"text":"son attida maccasati di7o shaaketidosona.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Phooliya worqa qefera de7iya,","poem":1},{"text":"birape medhetida holle misile di77idi demmiya wode","poem":2},{"lineBreak":true},{"text":"hinte dorsa kelen ayis zin7ideti?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ubbaa danda7iya Xoossay kawota laallida wode,","poem":1},{"text":"Xalmoona zumaa bolla shacha bukisis.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Baasane zumaw,","poem":1},{"text":"daro xeeri de7iya Baasane zumaw,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Daro xeerati de7iya zumato,","poem":1},{"text":"Xoossay doorida zumaa","poem":2},{"lineBreak":true},{"text":"hinte ayis qanaatidi xeelleetii?","poem":2},{"lineBreak":true},{"text":"Goday iyan merinaw daana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Xoossaa ola para gaareti","poem":1},{"text":"tammu mukulu toho tammu mukulan taybetees;","poem":2},{"lineBreak":true},{"text":"Goday Siina zumaape ba geeshsha bessaa yis.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Di7etida darota ekidi, dhoqa keyis;","poem":1},{"text":"asaape, hari attoshin makallanchotape imo ekis;","poem":2},{"lineBreak":true},{"text":"Goday Xoossay yan daana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Gallas gallas nu toohuwa tookiya Goday galatetto;","poem":1},{"text":"Xoossay nuna ashsheysa. Salaha","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nu Xoossay nuna ashshiya Xoossaa gidennee?","poem":1},{"text":"Hayqope ashshiya Xoossay iya.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Xoossay tuma ba morketa huuphiya tinchana;","poem":1},{"text":"nagara ogen hemetiya asa,","poem":2},{"lineBreak":true},{"text":"binaanan kametida enta liiphiya menthana.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“Taani hinte morketa","poem":1},{"text":"Baasanepe zaarada ehana;","poem":2},{"lineBreak":true},{"text":"ta enta ciimmo abbafe kessada guye ehana.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hessika, ne morketa suutha ne tohoy yedhana melanne","poem":1},{"text":"ne kanatika morke suuthaafe banta gishuwa laaccana melasa” yaagees Goday.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Abeeti Xoossaw, ne salpey,","poem":1},{"text":"ta Xoossay ta kawoy salpey,","poem":2},{"lineBreak":true},{"text":"Xoossa keethi geliya wode ubbaas bentees.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yexeysati sinthana; diixeysati guyena;","poem":1},{"text":"qassi karaabo baqiya geela7oti giddona.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hinte “Xoossa gita shiiqon galatite;","poem":1},{"text":"hinteno, Isra7eele asaw, Godaa galatite” yaagosona.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"He salpiyan ubbaafe kaalo gidida","poem":1},{"text":"Biniyaame kochay koyro taybetoosona.","poem":2},{"text":"Kaallidi Yihuda halaqati banta cugan de7oosona;","poem":1},{"text":"wursethan Zabloona halaqatinne","poem":2},{"lineBreak":true},{"text":"Niftaaleme halaqati taybetoosona.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Abeeti Xoossaw, ne wolqaa qoncisa;","poem":1},{"text":"kase ne nuus oothidaysada,","poem":2},{"lineBreak":true},{"text":"ne minotetha bessa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Hessa gisho, Yerusalaamen de7iya","poem":1},{"text":"ne keetha kawoti yidi,","poem":2},{"lineBreak":true},{"text":"new imota immana.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Do7ada maqa giddon de7iya Gibxe asata neeni seera;","poem":1},{"text":"boorunne mara wude daaniya kawotethata ne hanqeta.","poem":2},{"text":"Enti gulbatidi, banta bira new immana gakanaw,","poem":1},{"text":"neeni enta seera; oletanaw yeemotiya asata laalla.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kiitetida halaqati Gibxefe yaana;","poem":1},{"text":"Tophey ba kushiya Xoossako miccana.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Hinteno, sa7aa kawotethato,","poem":1},{"text":"Xoossas yexite. Salaha","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Benipe de7iya salotape bollara beyisas;","poem":1},{"text":"ba wolqaama girsan ba guntha sisseysas yexite.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Xoossaa wolqaaba awaajite;","poem":1},{"text":"iya gitatethay Isra7eele bollana;","poem":2},{"lineBreak":true},{"text":"iya wolqayka salona.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Xoossay ba geeshsha asaa bolla malaalsees;","poem":1},{"text":"Isra7eele Xoossay ba asas","poem":2},{"lineBreak":true},{"text":"minotethinne wolqa immees.","poem":2},"Xoossay galatetto."]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/68.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":35}