{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":69,"content":[{"type":"heading","content":["Xoossaw Tana Ashsha"]},{"type":"hebrew_subtitle","content":["Dawita Mazmure"]},{"type":"verse","number":1,"content":["Haathi taw qoodhe gakida gisho,",{"text":"abeeti Xoossaw, tana ashsha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Eqiya bessi bayna ciimmon mitettas;","poem":1},{"text":"ciimmo haatha giddo gelas;","poem":2},{"lineBreak":true},{"text":"haatha zuley ta bollara aadhis.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Maado demmanaw waassashe daaburas;","poem":1},{"text":"ta kottonoy melis.","poem":2},{"text":"Ta Xoossaa xeellishin,","poem":1},{"text":"ta ayfey teljumis.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tana coo ixeysati","poem":1},{"text":"ta huuphe binaanape daro;","poem":2},{"text":"Wordon tana morkeysatinne","poem":1},{"text":"dhaysanaw koyeysati daro;","poem":2},{"lineBreak":true},{"text":"ta kaysotonnaba zaara gidoosona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abeeti Xoossaw, ta eeyatetha ne eraasa;","poem":1},{"text":"ta balay neepe geemmibeenna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Abeeti Ubbaafe Wolqaama Godaw,","poem":1},{"text":"nena ufaysan naageysati","poem":2},{"lineBreak":true},{"text":"ta gaason yeellatopo.","poem":2},{"text":"Abeeti Isra7eele Xoossaw,","poem":1},{"text":"nena minthidi koyeysati","poem":2},{"lineBreak":true},{"text":"ta gaason kawuyofo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta ne gisho cashshe danda7as;","poem":1},{"text":"ta som7oy yeella ma7iday ne gishosa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Taani ta ishatas imathe,","poem":1},{"text":"ta aaye naytas allaga gidas.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Taani ne keethas mishetiya mishay","poem":1},{"text":"tana tamada xuuggees;","poem":2},{"lineBreak":true},{"text":"nena cayiya cashshay ta bolla wodhis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Taani xooman tana kawushida wode,","poem":1},{"text":"tana cayidosona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Taani kayo ma7o ma7ida wode,","poem":1},{"text":"entaw kaassas attas.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Katama pengen utteysatas zigrisas attas;","poem":1},{"text":"mathoteysati tabaa yethi kessidosona.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Shin Godaw, ta nena woossayis;","poem":1},{"text":"abeeti Xoossaw, ne dosiya wode,","poem":2},{"lineBreak":true},{"text":"ne merinaa siiquwan,","poem":2},{"lineBreak":true},{"text":"ne atotethan taw zaaro imma.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Silimon mitettonnaada tana ashsha;","poem":1},{"text":"ta morketape tana ashsha,","poem":2},{"lineBreak":true},{"text":"ciimmo haathan mitetethafe tana ashsha.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Di7o haathay tana muukofo;","poem":1},{"text":"ciimmo haathay tana mittofo;","poem":2},{"lineBreak":true},{"text":"ziqa ollay ba doona ta bolla gordofo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Abeeti Godaw, ne merina siiquwa lo77otethan,","poem":1},{"text":"taw zaaro imma;","poem":2},{"lineBreak":true},{"text":"ne gita maarotan taako simma.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ne aylliyafe ne som7uwa genthofa;","poem":1},{"text":"taani un7an de7iya gisho","poem":2},{"lineBreak":true},{"text":"taw elle zaaro imma.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Taako shiiqa; tana woza;","poem":1},{"text":"ta morketape tana la77a kessa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ta cashshaa, yeellaanne","poem":1},{"text":"kawushatethaa ne eraasa;","poem":2},{"lineBreak":true},{"text":"ta morketa ubbaa ne be7aasa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Cashshay tana hargancho oothis;","poem":1},{"text":"taw qadhetiya asi koyas.","poem":2},{"text":"Shin issi asika demmabike;","poem":1},{"text":"tana minthethiya asi xeellas; shin bentibeenna.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ta kathan ciiye walakidosona;","poem":1},{"text":"ta saamuwas caala ushshi immidosona.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Enta gaytay entaw xihe gido;","poem":1},{"text":"enta yarshoy entaw xihe gido.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Xeellonnaada enta ayfey goozeto;","poem":1},{"text":"enta zokoy kuuno.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ne hanquwa enta bolla tiga;","poem":1},{"text":"suulliya ne sheney enta yedetho.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Enta kambey kaysi gido;","poem":1},{"text":"enta dunkaaniyan de7iya asi dhayo.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ne seeridaysata enti yedethidosona;","poem":1},{"text":"ne madunxisidaysata enti yeessosona.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Enti nagaraa bolla nagara gujana mela aggaaga;","poem":1},{"text":"ne maarotethaafe enta aybika gakofo.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Enti de7o maxaafape qusheto;","poem":1},{"text":"xillo asaara mazgabetofo.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ta waayeninne un7an de7ayis;","poem":1},{"text":"abeeti Xoossaw, tana ashshada,","poem":2},{"lineBreak":true},{"text":"saro bessan wotha.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Taani Xoossaa sunthaa mazmuren galatana;","poem":1},{"text":"galata imon iya gitayana.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Hessi boora yarshofe,","poem":1},{"text":"woyko kacaama korma yarshofe,","poem":2},{"lineBreak":true},{"text":"aadhidi, Godaa ufaysees.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Naaqetidaysati hessa be7ana; ufaytana;","poem":1},{"text":"hinteno, Xoossaa koyeysato,","poem":2},{"lineBreak":true},{"text":"hinte wozanay minetto.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Goday manqota si7ees;","poem":1},{"text":"qasho keethan de7iya ba asaa kadhenna.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Saloy, sa7inne abbay,","poem":1},{"text":"iya giddon de7iya woxi qaaxiya ubbay Godaa galato.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Xoossay Xiyoone ashshana;","poem":1},{"text":"Yihuda katamaa zaaridi keexana;","poem":2},{"lineBreak":true},{"text":"asay yan daananne biittayka entaba gidana.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Iya aylleta nayti he biitta laattana;","poem":1},{"text":"iya sunthaa doseysati yan daana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}