{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":7,"content":[{"type":"heading","content":["Meto Wode Xillo Asa Woosa"]},{"type":"hebrew_subtitle","content":["Biniyaame kocha Kuuzaba Dawiti Godaas yexida mazmure."]},{"type":"verse","number":1,"content":["Abeeti Godaw ta Xoossaw, ta nenan qosetayis;",{"text":"tana yedethiya ubbaafe tana ashsha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Neeni tana ashshonaba gidiyako,","poem":1},{"text":"enti tana gaammoda zaazana;","poem":2},{"lineBreak":true},{"text":"ashshiya asi bayna mentherethanashin.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abeeti Godaw ta Xoossaw,","poem":1},{"text":"ta haysa melaba oothidaba gidiko,","poem":2},{"lineBreak":true},{"text":"taani ase naaqidaba gidiko,","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ta laggetas lo77o gisho iitaa zaaridaba gidiko,","poem":2},{"lineBreak":true},{"text":"gaasoy bayna ta morkiya bonqidaba gidiko,","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ta morkey tana yedethidi oyko;","poem":2},{"lineBreak":true},{"text":"tana sa7an yeggidi yedho;","poem":2},{"lineBreak":true},{"text":"tana baanan gondorsidi kawusho. Salah","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Abeeti Godaw, ne hanquwan dendada,","poem":1},{"text":"eexiya ta morketa hanquwa bolla eqa;","poem":2},{"lineBreak":true},{"text":"ta Xoossaw, ta gisho barka;","poem":2},{"lineBreak":true},{"text":"neeni xillo pirda koyaasa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Asay ne yuushon shiiqo;","poem":1},{"text":"neeni entafe bollara haara.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Goday kawotethata bolla pirdees;","poem":1},{"text":"abeeti Godaw, ta xillotethaadanne","poem":2},{"lineBreak":true},{"text":"ta suuretethaada pirda.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Qofanne wozanaa shaakada eriya xillo Xoossaw,","poem":1},{"text":"iitata geella hanota neeni teqa;","poem":2},{"lineBreak":true},{"text":"shin xilluwa saron naaga.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wozana suureta ashshiya,","poem":1},{"text":"Xoossay taw gondalle.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Xoossay xillo pirdeysa;","poem":1},{"text":"I ubba wode iitata bolla hanqetiya Xoossaa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Iitati banta iitatethaafe simmonna ixiko,","poem":1},{"text":"Xoossay ba mashsha leefes;","poem":2},{"lineBreak":true},{"text":"ba dongiya giigisees.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"I ba wodhiya ola miisheta giigisees;","poem":1},{"text":"laxiya ba donge toora pitees.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iitati qoho qanthatidi,","poem":1},{"text":"gene wodexidi,","poem":2},{"lineBreak":true},{"text":"wordo yeloosona.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hara asas olla bookida asi","poem":1},{"text":"ba bookida ollan baw kundees.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Iya geney iya huuphen simmees.","poem":1},{"text":"Iya geellatethay iya mees.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Iya xillotethaa gisho taani Godaa sabbana;","poem":1},{"text":"Ubbaafe Dhoqa Godaa sunthaas","poem":2},{"lineBreak":true},{"text":"taani galata mazmure yexana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}