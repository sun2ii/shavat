{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":71,"content":[{"type":"heading","content":["Taani Daaburiya Wode Tana Aggofa"]},{"type":"verse","number":1,"content":["Godaw, taani neeko baqatada attiya gisho,",{"text":"awudeka tana yeellayopa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne xillotethan tana naaga;","poem":1},{"text":"ne haytha taako zaara; tana ashsha.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Neeni ta ubba wode geemmada attiya zaalla","poem":1},{"text":"taani geemmada attana mela mino miixaa gida;","poem":2},{"lineBreak":true},{"text":"ee, neeni ta zaallanne ta miixa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ta Xoossaw, iitata kushepenne,","poem":1},{"text":"qadhey bayna asatape tana ashsha.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abeeti Godaw, ta na7atethafe doomada,","poem":1},{"text":"neeni ta ufaysaanne ta ammanetetha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ta yeletida wodepe doomada nenan zempas;","poem":1},{"text":"ta aaye ulope tana kessiday nena;","poem":2},{"lineBreak":true},{"text":"taani ubba wode nena galatana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Neeni ta qosetada attiya bessi gidida gisho,","poem":1},{"text":"ta de7oy daro asaas leemiso gidis.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gallasa ubban ta doonay","poem":1},{"text":"ne galataninne ne bonchuwan kumis.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Taani cimida wode tana yeggofa;","poem":1},{"text":"ta wolqay ixida wode tana aggofa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta morketi ta bolla tobboosona;","poem":1},{"text":"Tana wodhanaw koyeysati ta bolla maqetoosona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Enti, “Xoossay iya aggis; yedethidi oykoos;","poem":1},{"text":"iya ashshanay oonika baawa” yaagosona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xoossaw, taape haakofa","poem":1},{"text":"ta Xoossaw, tana maaddanaw ellesa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tana mooteysati yeellatidi dhayo;","poem":1},{"text":"Tana qohanaw koyeysati,","poem":2},{"lineBreak":true},{"text":"yeellanne kawushe ma7o.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Shin taani ubba wode ufaysan nena naagana;","poem":1},{"text":"zaara zaaradaka nena galatana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ne oothidaba ta taybanaw xoonetikoka,","poem":1},{"text":"ta doonay gallas ubban ne xillotethaanne","poem":2},{"lineBreak":true},{"text":"ne atotethaaba odana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Taani Ubbaa Haariya Godaa wolqan yada;","poem":1},{"text":"ne xalaala xillo gideysa awaajana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Xoossaw, neeni ta na7atethafe doomada tana tamaarsadasa;","poem":1},{"text":"ha77ika ne malaalsiya oosuwa ta odana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Xoossaw ne wolqaanne ne minotethan","poem":1},{"text":"yaa yeleta ubbaas odana gakanaw,","poem":2},{"lineBreak":true},{"text":"taani cimada puulumikoka tana aggofa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Xoossaw, ne xillotethay salo gakis;","poem":1},{"text":"gitaba oothida Xoossi, ne meli oonee?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Neeni ta bolla daro meto ehadasa;","poem":1},{"text":"gidoshin ta de7uwa zaarada ooraxisadasa;","poem":2},{"lineBreak":true},{"text":"neeni tana biitta garsafe kessadasa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Neeni ta bonchuwa darsadasa;","poem":1},{"text":"tana zaarada minthethadasa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ta Xoossaw, ne tumatethaa gisho,","poem":1},{"text":"ta nena diithan galatana.","poem":2},{"text":"Abeeti Isra7eele geeshshaw,","poem":1},{"text":"ta nena maasinqon sabbana.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ta mettershay ufaysan dhoqu oothidi yexees;","poem":1},{"text":"neeni tana ashshida gisho taani nena sabbana.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Tana qohanaw koyeysati yeellatida gishonne","poem":1},{"text":"kawuyida gisho ta inxarsay ne xillo maaduwaba","poem":2},{"lineBreak":true},{"text":"gallas ubban odana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}