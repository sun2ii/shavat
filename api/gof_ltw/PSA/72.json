{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":72,"content":[{"type":"heading","content":["Ufaysan Naagetiya Kawa"]},{"type":"hebrew_subtitle","content":["Solomone Mazmure"]},{"type":"verse","number":1,"content":["Xoossaw, ne suure pirdaa kawas,",{"text":"nu xillotethaa kawa na7aas imma.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"I ne asaas xillotethan pirdana;","poem":1},{"text":"qohetidaysatas suuren daynnatana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dereti duretethi,","poem":1},{"text":"zumati xillotetha ayfe ne asaas ayfo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kawoy qohetidaysata gisho mooteto;","poem":1},{"text":"manqota ashsho; un7etheyisata mentho.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xoossaw, I awadanne ageenada de7o;","poem":1},{"text":"yeletethaafe yeletethaa gakanaw de7o.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kawoy goshshan bukiya ira melanne","poem":1},{"text":"biitta kalsiya puuse ira mela gido.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iya laytha ubban xillo asati daayo;","poem":1},{"text":"ageeni dhayana gakanaw sarotethi daro.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abbaafe abba gakanaw,","poem":1},{"text":"Efraxiisa shaafape sa7aa gaxa gakanaw I haaro.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bazzon de7iya asati iya goyinno;","poem":1},{"text":"iya morketi baana laaco.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tarsesanne yuushoy abban teqetida biittata,","poem":1},{"text":"kawoti iyaw giira giiro;","poem":2},{"lineBreak":true},{"text":"Arabenne Tophe kawoti iyaw imota eho.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kawoti ubbay iyaw gulbato;","poem":1},{"text":"kawotethati ubbay iyaw kiiteto.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Iyako waassiya manqota, qohetidaysatanne","poem":1},{"text":"maadoy baynayisata I ashshana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Manqotasinne daaburanchotas I qadhetees;","poem":1},{"text":"manqota shempuwa hayqope ashshees.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Enta suuthay iya sinthan al7o gidiya gisho,","poem":1},{"text":"I, enta qohopenne iitape wozana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kawoy daro laythi gam7o;","poem":1},{"text":"Arabe biitta worqay iyaw yo.","poem":2},{"text":"Asay iya gisho ubba wode woosso;","poem":1},{"text":"gallas ubban I anjeto.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Biittan kathi palaho;","poem":1},{"text":"dereti kathan kametto.","poem":2},{"text":"Libaanose deriya bolla kathi ayfiyada ayfo;","poem":1},{"text":"denbi maatan kumiyada asay katamaa kumo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kawa sunthay merinaw de7o;","poem":1},{"text":"awada ubba wode xeegetishe gam7o.","poem":2},{"text":"Asa ubbay iya baggara anjetana;","poem":1},{"text":"kawotethati iya “anjetidaysa” yaagana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Malaalisiyaba barka oothiya Goday, Xoossay","poem":1},{"text":"Isra7eele Xoossay galatetto.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Iya boncho sunthay merinaw galatetto;","poem":1},{"text":"iya bonchoy sa7a ubbaa kumo.","poem":2},{"lineBreak":true},"Amin7i! Amin7i!"]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Isseye na7aa Dawita woosay haysan poletis.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}