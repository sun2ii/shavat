{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":73,"content":[{"type":"heading","content":["Xoossay Taw Minotethinne Gisho"]},{"type":"hebrew_subtitle","content":["Asaafa Mazmure"]},{"type":"verse","number":1,"content":["Tuma Xoossay Isra7eeles lo77o;",{"text":"wozana geeshshatas I keeha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Shin ta tohoy dhubetanaw guuthu attis;","poem":1},{"text":"ta tangoy hallixanaw matis.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hessi haniday iita asatinne otoranchoti,","poem":1},{"text":"duretishin taani be7ada qanaatida gishosa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Enta waayey gakonna gisho,","poem":1},{"text":"enta asatethay payyanne mino.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Enti hara asada waayetokona;","poem":1},{"text":"hara asada meton shocetokona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hessa gisho, otoroy entaw qoodhe alleeqo mela;","poem":1},{"text":"buqethi afilada ma7idosona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Enta wozanay iitabaa pultees;","poem":1},{"text":"enta qofay iita halchon kumis.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Enti qelqisoosona; iitabaa haasayoosona;","poem":1},{"text":"banta otoruwan harata un7ethoosona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Banta doona Xoossaa bolla dooyosona;","poem":1},{"text":"banta inxarsaa asa bolla adussosona.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hari attoshin, Xoossaa asay entako simmana;","poem":1},{"text":"enti odiyaba eeson ammanana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Enti, “Xoossi ayko erii?","poem":1},{"text":"Ubbaafe Dhoqa Xoossaas eratethi de7ii?” yaagosona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hiza iitati haysa mela;","poem":1},{"text":"ubba wode injetin de7oosona;","poem":2},{"lineBreak":true},{"text":"enti guji guji duretoosona.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hiza taani ta wozanaa geeshshatethan naagiday,","poem":1},{"text":"xillotethi bessanaw ta kushiya meecetiday mela.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Gallasa kumethi taani meton shocetas;","poem":1},{"text":"wonta wonta seeretas.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Taani iita asatada odetidaako,","poem":1},{"text":"ne asaas ammanetona attanashin.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Taani ha ubbaa eranaw qopiya wode,","poem":1},{"text":"taw deexo gidis.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hessika taani Xoossa keethaa gelana gakanawunne","poem":1},{"text":"iita asata wursetha qaada akeekana gakanaasa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tuma neeni enta hallixiya bessan utisadasa;","poem":1},{"text":"enti kundidi dhayana mela oothaasa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Enti ellesidi dhayidosona;","poem":1},{"text":"dagaman issoy attonna wuridosona.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Amuhoy barkiya wode baleteysada,","poem":1},{"text":"abeeti Godaw, neeni dendiya wode,","poem":2},{"lineBreak":true},{"text":"enti dogetana.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Taani yilotida wodenne","poem":1},{"text":"ta wozanan cametida wode,","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"akeekona eeya asi gidas;","poem":2},{"lineBreak":true},{"text":"ne sinthan mehe gidas.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Shin taani ubba wode neera de7ayis;","poem":1},{"text":"ta ushacha kushiya neeni oykadasa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ne zoriyan tana kaalethaasa;","poem":1},{"text":"wursethan tana bonchon ekaasa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Taw salon neepe attishin, hari ooni de7ii?","poem":1},{"text":"Taani neepe attishin, sa7an haraa amotike.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ta wolqaynne ta wozanay daaburanaw danda7ees;","poem":1},{"text":"shin Xoossay ta wozanaa minotethaanne","poem":2},{"lineBreak":true},{"text":"merinaw tana gakida saamaa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Neepe haakeysati dhayana;","poem":1},{"text":"nena kaddeyisata ubbaa ne wursana.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Shin taw Xoossaako shiiqoy lo77o;","poem":1},{"text":"iya ooso ubbaa taani odana mela,","poem":2},{"lineBreak":true},{"text":"Ubbaa Haariya Godaa qosetidi attiya besse oothas.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}