{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":74,"content":[{"type":"heading","content":["Xoossaw Ne Gisho Mooteta"]},{"type":"hebrew_subtitle","content":["Asaafa Timirte"]},{"type":"hebrew_subtitle","content":["Akeekan xaafida ginxo."]},{"type":"verse","number":1,"content":["Xoossaw neeni nuna ayis merinaw aggadii?",{"text":"Ne qooruwan de7iya ne dorsata bolla","poem":2},{"lineBreak":true},{"text":"ne hanqoy ayis eexidee?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Neeni beni doorida asaa,","poem":1},{"text":"new buzo oothada wozida kochata hassaya;","poem":2},{"lineBreak":true},{"text":"neeni de7ida Xiyoone zuma qopa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Laaletida ne keethaa yada xeella;","poem":1},{"text":"morketi yan de7iyaba ubbaa dhaysidosona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne morketi ne keethan,","poem":1},{"text":"“Nu xoonida” yaagidi gereeridosona.","poem":2},{"lineBreak":true},{"text":"Xoono malaata gidida banta bandira essidosona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Enti mithi qanxanaw wora giddon eqidi,","poem":1},{"text":"banta kalta denthida asata daanosona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Enti kushe hiillan alleeqida oosota ubbaa,","poem":1},{"text":"banta kaltaaninne naariqan mentherethidosona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne keetha taman xuuggidi dhaysidosona;","poem":1},{"text":"ne sunthay xeegetiya bessaa tunisidosona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Banta wozanan, “Nu kumethi dhaysana” yaagidosona;","poem":1},{"text":"biittan de7iya asi Xoosse goyinniya bessata","poem":2},{"lineBreak":true},{"text":"taman xuuggidosona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"He wode malaati nuus imetenna;","poem":1},{"text":"nabeyka deenna.","poem":2},{"text":"Hessi awude gakanaw gam7aneko,","poem":1},{"text":"eriya asi nu giddon baawa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Xoossaw, ne morketi awude gakanaw,","poem":1},{"text":"ne bolla qelqisanee?","poem":2},{"lineBreak":true},{"text":"Enti ne sunthaa merinaw cayanee?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne ushacha kushiya ayis shiisha ekay?","poem":1},{"text":"Ne ushacha kushiya ne afilaa giddofe","poem":2},{"lineBreak":true},{"text":"kessada enta dhaysa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Gidoshin, abeeti Xoossaw,","poem":1},{"text":"neeni benipe ta kawa;","poem":2},{"lineBreak":true},{"text":"ne daro wode ashshadasa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ne gita wolqan abba shaakadasa;","poem":1},{"text":"iya giddon de7iya do7aa huupheta doncadasa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Leewataane geetetiya dawiya huupheta doncada,","poem":1},{"text":"iya ashuwa bazzon de7iya medhetethatas","poem":2},{"lineBreak":true},{"text":"kathi oothada immiday nena.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Neeni pultota dooya yeddadasa;","poem":1},{"text":"ubba wode goggiya shaafata melisadasa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Gallasay nebaa; qammayka nebaa;","poem":1},{"text":"awanne ageena enta bessan wothiday nena.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Biittas zawa wothiday,","poem":1},{"text":"balgonne bone medhiday nena.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Abeeti Godaw, ne morketi nena waati qelqisidaako,","poem":1},{"text":"eeya asati ne sunthaa waati cayidaako hassaya.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ne holliya shempuwa do7aas aathada immofa;","poem":1},{"text":"metootanchota merinaw dogopa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nu biittan de7iya dhuma bessi ubbay","poem":1},{"text":"makallanchotan kumida gisho,","poem":2},{"lineBreak":true},{"text":"ne nuus caaqida caaquwa qopa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Qohetidaysata yeellayopa;","poem":1},{"text":"manqotinne metootanchoti ne sunthaa galato.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Abeeti Xoossaw, denda; mooteta;","poem":1},{"text":"gallas kumethi eeyati nena qelqiseysa hassaya.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ne morketi ne bolla waassiya waasuwanne","poem":1},{"text":"nena ixeysati ceeqetiya ceequwa akeeka.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":23}