,{"text":"qoodhe qaathidi haasayopite’ ” yaagana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bonchoy dolohape woyko wulohape","poem":1},{"text":"woyko mela biittafe yeenna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Shin suure pirdey Xoossaa;","poem":1},{"text":"I issuwa bolla pirdees; hankuwa shatinthees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Xoossaa kushen issi wanci de7ees;","poem":1},{"text":"he wancay Xoossaa hanqo","poem":2},{"lineBreak":true},{"text":"woyne ushshan kumidi uttis.","poem":2},{"text":"I he ushshafe tigin,","poem":1},{"text":"sa7an de7iya iita asati hessa uyana;","poem":2},{"lineBreak":true},{"text":"enti orcuwa ashshona xiiphidi uyana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Shin taani Yayqooba Xoossaaba odana;","poem":1},{"text":"iya merinaw sabbana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"I, iita asata kaciya menthana;","poem":1},{"text":"shin xillota kacey dhoqu dhoqu gaana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}