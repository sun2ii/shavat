{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":76,"content":[{"type":"heading","content":["Xoossa Sinthan Eqanay Oonee?"]},{"type":"hebrew_subtitle","content":["Asaafi Zammaareta Halaqaas Diithan Yexida Mazmure."]},{"type":"verse","number":1,"content":["Xoossay Yihudan eretis;",{"text":"iya sunthay Isra7eelen gita.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iya dunkaaney Saalemana;","poem":1},{"text":"I de7iya bessay Xiyoonena.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yan xongetiya morke dongiya,","poem":1},{"text":"gondalle, mashshenne ola miisheta mentherethis. Salaha","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Abeeti Xoossaw, ne bonchoy ay mela gite!","poem":1},{"text":"Neeni ne morketa xoonada zumaape simmiya wode,","poem":2},{"lineBreak":true},{"text":"ne teemay ay mela yashshi!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gooba tooranchoti bonqetidosona;","poem":1},{"text":"enti wolqaama dhisko dhiskidosona;","poem":2},{"lineBreak":true},{"text":"entafe issoyka ba kushiya denthibeenna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Abeeti Yayqooba Xoossaw, ne seerida wode,","poem":1},{"text":"para asatinne parati kundidi attidosona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Shin abeeti Xoossaw, neeni yashshaasa;","poem":1},{"text":"ne hanqoy suulliya wode,","poem":2},{"lineBreak":true},{"text":"ne sinthan oone eqanay?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Neeni pirdaa salope sissida wode,","poem":1},{"text":"biittay dagaman si77i gis.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neeni biittan qohetida asaa ashshanawunne","poem":1},{"text":"entaw pirdanaw dendiya wode hessi hannis. Salaha","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne ase hanqikoka new boncho gidees;","poem":1},{"text":"Olape attida asati ne ba7aale bonchana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Godaas hinte Xoossaas qangethi gathite;","poem":1},{"text":"hinteno iya matan de7iya kawotethato,","poem":2},{"lineBreak":true},{"text":"yashshiya iyaw imota ehite.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"I halaqata ayyaana kawushshees;","poem":1},{"text":"wolqaama kawotaka daganthees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}