{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":77,"content":[{"type":"heading","content":["Taani Meto Wode Xoosse Koyas"]},{"type":"hebrew_subtitle","content":["Asaafi Zammaareta Halaqa Edotaames Xaafida Mazmure."]},{"type":"verse","number":1,"content":["Taani Xoossaa maggannayis;",{"text":"tana si7a gada iyako waassayis.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta metuwa gallasan Godaa koyas;","poem":1},{"text":"qamma kumethi shempoy bayna ta kushiya miccas;","poem":2},{"lineBreak":true},{"text":"gidoshin, ta shempiya minnanaw danda7abuku.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taani Xoossaba qopiya wode oolayis;","poem":1},{"text":"taani wotha denthida wode ta shempoy daaburees. Salaha","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Qamma kumethi tana dhisko diggada aysadasa;","poem":1},{"text":"ta un7etida gisho odetanaw danda7abike.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Taani aadhida gallasata qopas;","poem":1},{"text":"kase laythata hassayas.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taani qamma gita qofan aqas;","poem":1},{"text":"ta wozanan wotha denthashe,","poem":2},{"lineBreak":true},{"text":"haysada yaagada tana oychas;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Xoossay nuna merinaw aggideyee?","poem":1},{"text":"hizape guye I nuus keeheneyee?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iya siiqoy attideyee?","poem":1},{"text":"I odida qaala merinaw poleneyee?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Xoossay ba maarota dogideyee?","poem":1},{"text":"Ba qadhiya hanqon laammideyee?” yaagada oychas. Salaha","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ubbaafe Dhoqa Xoossaw, tana un7ethiday,","poem":1},{"text":"ne ushacha kushiyan nuna maado aggidaysa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Godaa oosota taani qopana;","poem":1},{"text":"I beni oothida malaalsiya oosota hassayana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne oosota taani zaara zaarada qopana;","poem":1},{"text":"ne wolqaama oosota taani wotha denthana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Abeeti Xoossaw, ne ogey geeshshi;","poem":1},{"text":"ne mela gita Xoossi oonee?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Neeni malaalsiyaba oothiya Xoossaa;","poem":1},{"text":"asaa giddon ne wolqaa qoncisaasa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ne asaa, Yayqoobanne Yoosefa kochaa","poem":1},{"text":"ne qesiyan wozadasa. Salaha","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Abeeti Xoossaw, haathati nena be7idi yayyidosona;","poem":1},{"text":"abba ciimmotika kokoridosona.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Shaarati haathe duge tigidosona;","poem":1},{"text":"daday salon guummis;","poem":2},{"lineBreak":true},{"text":"ne wol7anthay yan han wol7amis.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ne dadaa guunthay uushuwa giddon guummis;","poem":1},{"text":"ne wol7anthay sa7aa poo7isis;","poem":2},{"lineBreak":true},{"text":"biittay qaaxis; kokoris.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Neeni abba giddora hemetaasa;","poem":1},{"text":"ciimmo abba giddora kanthaasa;","poem":2},{"lineBreak":true},{"text":"shin ne tohoy yedhida bessay bentenna.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Muse kushennine Aarona kushen","poem":1},{"text":"ne asaa dorsa wudeda kaalethadasa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}