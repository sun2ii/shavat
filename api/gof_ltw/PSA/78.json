{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":78,"content":[{"type":"heading","content":["Kaalliya Yeletethaas Oda"]},{"type":"hebrew_subtitle","content":["Asaafi Akeekan Xaafida Ginxo"]},{"type":"verse","number":1,"content":["Ta asaw, ta timirtiya si7ite;",{"text":"ta doonape keyiya qaala hayzidi si7ite.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taani ta doona leemison dooyana;","poem":1},{"text":"benipe geemmida xuura qoncisana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nuuni si7idaysanne eridaysa,","poem":1},{"text":"nu aawati nuus odidaysata odana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hessata nuuni enta naytape qosoko;","poem":1},{"text":"Godaas bessiya galataa,","poem":2},{"lineBreak":true},{"text":"iya wolqaanne malaalsiya iya oosuwa,","poem":2},{"lineBreak":true},{"text":"yaana yeletas odana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"I Yayqooba zerethaas kiitaa,","poem":1},{"text":"Isra7eele asaas higgiya immis.","poem":2},{"text":"Kase nu aawati banta nayta","poem":1},{"text":"he higgiya tamaarsana mela kiittis.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kaalliya yeletay hessa erana mela,","poem":1},{"text":"enta naytika banta naytas","poem":2},{"lineBreak":true},{"text":"buroo yeletana naytas erisanaasa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"He wode enti Xoossan ammanetena;","poem":1},{"text":"I oothidaba balokona; iya kiitaa naagana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Enti kase banta aawatada wozana muume yeleta,","poem":1},{"text":"geellanne ammanetona yeleta,","poem":2},{"lineBreak":true},{"text":"Xoossan minnidi eqenna yeleta gidokona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Efreema asay donge dancikoka,","poem":1},{"text":"ola gallas guye simmidosona.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Enti Xoossaa caaquwa naagibookona;","poem":1},{"text":"iya higgiyan hemetonna ixidosona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Enti I oothida oosuwanne","poem":1},{"text":"I bessida malaata dogidosona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"I enta aawata sinthan Gibxe biittan,","poem":1},{"text":"Xo7aane Denban malaata oothis.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Abbaa shaakidi giddora enta pinthis;","poem":1},{"text":"haatha shaakidi yan han godada essis.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"I enta gallas shaaran,","poem":1},{"text":"qamma tama poo7on kaalethis.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"I mela biittan zaalla phalqidi,","poem":1},{"text":"abbada daro haathi enta ushshis.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Zaallafe haathe pultisidi,","poem":1},{"text":"shaafa haathada gogisis.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Shin enti iya bolla nagara gujidi oothidosona;","poem":1},{"text":"Ubbaafe Dhoqa Xoossaa bolla mela biittan makallidosona.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Banta amotida kathaa oychidi,","poem":1},{"text":"Xoossaa erishe paacidosona.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Enti Xoossaa bolla haysada yaagidi haasayidosona;","poem":1},{"text":"“Mela biittan Xoossay nuus kathi giigisanaw danda7ii?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Zaalla shocin pultoy keyidi","poem":1},{"text":"shaafa haathi goggis;","poem":2},{"lineBreak":true},{"text":"shin I nuus kathi immanaw danda7ii?","poem":2},{"lineBreak":true},{"text":"Woyko ba asaas asho immanaw danda7ii?” yaagidosona.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Goday hessa si7ida wode daro hanqetis;","poem":1},{"text":"Yayqooba kochata bolla tami eexis;","poem":2},{"lineBreak":true},{"text":"Isra7eele bolla iya hanqoy daris.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hessika enti Xoossan ammanibookona;","poem":1},{"text":"woyko iya ashuwan ammanetibokona.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Gidoshin, dhoqa saluwa kiittis;","poem":1},{"text":"salo pengiya dooyis.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Enta muzanaw manna bukisis;","poem":1},{"text":"salo kathaa entaw immis.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kiitanchota kathi asay mis;","poem":1},{"text":"Xoossay entaw miyaba darsidi immis.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Doloha carkoy carkana mela oothis;","poem":1},{"text":"ba wolqan dugeha carkuwa denthis.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"I asaas asho biitta kessis;","poem":1},{"text":"paalliya kafota abba gaxa shafeda bukisis.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Enti de7iya bessan,","poem":1},{"text":"dunkaaniya yuushon wodhisis.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Enti amotidaysa entaw immis;","poem":1},{"text":"midi banta ganjiya gathidosona.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Shin enti banta amuwa aathona de7ishin,","poem":1},{"text":"ashoy enta doonan buroo de7ishin,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Xoossaa hanqoy enta bolla wodhis;","poem":1},{"text":"enta giddofe wolqaama asata wodhis;","poem":2},{"lineBreak":true},{"text":"Isra7eelepe na7atethata dhukis.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"He ubbay haninka nagara ooso aggibokona;","poem":1},{"text":"daro malaata oothinka ammanibookona.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Hessa gisho, I enta gallasata hada oothis;","poem":1},{"text":"enta laythata dagaman ongis.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Xoossay entafe baggaa wodhiya wode","poem":1},{"text":"iya koydosona,","poem":2},{"lineBreak":true},{"text":"banta nagaraa paaxidi iyako simmidosona.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Xoossay enta zaalla gideysa,","poem":1},{"text":"Ubbaafe Dhoqa Xoossay enta wozeysa,","poem":2},{"lineBreak":true},{"text":"gideysa hassayidosona.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Shin enti banta inxarsan wordotidosona;","poem":1},{"text":"banta doonan cimmidosona.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Enta wozanay Xoossan minnidi eqenna;","poem":1},{"text":"iya caaquwas ammanetokona.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Shin I enta maaris enta nagaraa atto gis;","poem":1},{"text":"enta dhaysibeenna.","poem":2},{"text":"Daro wode ba hanquwa teqis;","poem":1},{"text":"ba gaduwa kumethi enta bolla yeddibeenna.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Enti hayqiya asho gideysanne","poem":1},{"text":"keyidi simmonna shempo gideysa akeekis.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Enti mela biittan iya bolla aapun toho makallidona!","poem":1},{"text":"Mela biittan iya aapun toho lancisidonaa!","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Enti zaari zaaridi Xoossaa paacidosona;","poem":1},{"text":"Isra7eele Geeshshaa yiloyidosona.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Entana morketa kushepe ashshida gallasaa,","poem":1},{"text":"un7ethiya asaape wozida wolqaa dogidosona.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"I Gibxen oothida malaata,","poem":1},{"text":"Xo7aane Denban oothida","poem":2},{"lineBreak":true},{"text":"malaalsiya oosuwa hassaybookona.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Enta shaafa haathata suuthu laammis;","poem":1},{"text":"hessa gisho, Gibxe asay shaafatape","poem":2},{"lineBreak":true},{"text":"uyanaw danda7ibookona.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Enta waaysiya udunxetanne","poem":1},{"text":"enta biitta dhaysiya shodheta kiittis.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Dolida kathaa duggos,","poem":1},{"text":"enti daaburida ayfiya booles immis.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Enta woyniya shachan,","poem":1},{"text":"enta balasiya carkon dhaysis.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Enta meheta shachan wodhis;","poem":1},{"text":"enta dorsata dadan wursis.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Dhaysiya kiitancho cugara,","poem":1},{"text":"ba suulliya hanquwa, yiluwa, ixuwanne","poem":2},{"lineBreak":true},{"text":"gaduwa enta bolla yeddis.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Ba hanquwas oge giigisis;","poem":1},{"text":"enta dhayos aathidi immis;","poem":2},{"lineBreak":true},{"text":"enta hayqope ashshibeenna.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Gibxe bayra nayta ubbaa shocis;","poem":1},{"text":"Kaama dunkaanen koyro nayta wodhis;","poem":2}]},{"type":"verse","number":52,"content":[{"text":"Shin ba asaa dorsada kessis;","poem":1},{"text":"wudeda mela biittan heemmis.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"I enta saro kaalethida gisho babibookona;","poem":1},{"text":"shin enta morketa abbay mittis.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"I enta ba geeshsha biitta,","poem":1},{"text":"ba ushacha kushen xoonidi oykida zuma bolla ehis.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"I enta sinthafe kawotethata gooddis;","poem":1},{"text":"enta biitta Isra7eele kochatas laata oothidi shaakis;","poem":2},{"lineBreak":true},{"text":"ba asaas enta keethaa immis.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Gidoshin, Ubbaafe Dhoqa Xoossaa bolla makallidosona;","poem":1},{"text":"iya paacidosona; iya higgiya kiitetibookona.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Enti banta aawatada geellatanne","poem":1},{"text":"minnidi eqonna asi gididosona;","poem":2},{"lineBreak":true},{"text":"wobe toorada wora wodhidosona.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Dhoqa goyinno bessatan iya yiloyidosona;","poem":1},{"text":"banta eeqatara iya qanaatisidosona.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Xoossay hessa si7ida wode shenetis;","poem":1},{"text":"Isra7eele ubbaa kadhis.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Seelon I de7iya ba bessaa,","poem":1},{"text":"asaa giddon I de7iya ba dunkaaniya aggis.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"Xoossa wolqaasinne bonchuwas","poem":1},{"text":"malaata gidida Taabotiya","poem":2},{"lineBreak":true},{"text":"morketa kushen aathidi immis.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"I ba asaa bolla shenetis;","poem":1},{"text":"enta mashshas aathidi immis.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Na7atethati ubbay taman meetetidosona;","poem":1},{"text":"geela7oti azina gelonna attidosona.","poem":2}]},{"type":"verse","number":64,"content":[{"text":"Enta kahineti mashshan wuridosona;","poem":1},{"text":"enta macheti yeekonna mela digetidosona.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"Goday dhiskofe barkiya asada dendis;","poem":1},{"text":"woyne ushsha mathoy aadhida asada hanis.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"I ba morketa guye zaaridi shocis;","poem":1},{"text":"enta merinaw yeellayis.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"Yoosefa dunkaaniya kadhis;","poem":1},{"text":"Efreema kochaa dooribeenna.","poem":2}]},{"type":"verse","number":68,"content":[{"text":"Shin Yihuda kochaanne","poem":1},{"text":"I dosiya Xiyoone deriya dooris.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"Ba keethaa saloda dhoqu oothidi keexis;","poem":1},{"text":"sa7ada merinaw essis.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"Ba aylliya Dawita dooridi,","poem":1},{"text":"dorse heemmiya bessaafe ekis.","poem":2}]},{"type":"verse","number":71,"content":[{"text":"Dorse heemmiya bessafe denthidi,","poem":1},{"text":"ba asaa Yayqooba,","poem":2},{"lineBreak":true},{"text":"ba laata Isra7eele henthanaw ehis.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"Dawiti enta suure wozanan heemmis;","poem":1},{"text":"ba cincatethan kaalethis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/78.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/79.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/77.json","previousChapterAudioLinks":{},"numberOfVerses":72}