{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":79,"content":[{"type":"heading","content":["Godaw, Awude Gakanaasee?"]},{"type":"hebrew_subtitle","content":["Asaafa Mazmure"]},{"type":"verse","number":1,"content":["Xoossaw, ayhude gidonna asay,",{"text":"ne biitta bolla dendidosona;","poem":2},{"text":"Ne geeshsha keethaa tunisidosona;","poem":1},{"text":"Yerusalaame laallidosona.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne aylleta aha salo kafotas,","poem":1},{"text":"ne geeshshata ashuwa sa7a do7atas immidosona.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Enta suuthaa Yerusalaame yuushon","poem":1},{"text":"haathada gussidosona;","poem":2},{"lineBreak":true},{"text":"enta aha moogiya asi dhayis.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nu shoorotas nuuni miichas,","poem":1},{"text":"nu heeran de7iya asaas qelqisethas attida.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Godaw, hessi awude gakanaw hananee?","poem":1},{"text":"Neeni nu bolla merinaw hanqetadii?","poem":2},{"lineBreak":true},{"text":"Ne hanqoy tamada eexishe daaneyee?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nena eronna dereta bolla,","poem":1},{"text":"ne sunthaa xeegonna kawotethata bolla","poem":2},{"lineBreak":true},{"text":"ne hanquwa zaara.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hessika enti Yayqooba mida gishonne","poem":1},{"text":"enti de7iya bessaa dhaysida gishosa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nuuni daro metootida gisho,","poem":1},{"text":"nu mayzata iitatethaa nu bolla taybopa;","poem":2},{"lineBreak":true},{"text":"eeson ne maarota nuus kiitta.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abeeti nuna ashshiya Xoossaw,","poem":1},{"text":"ne boncho sunthaa gisho nuna maadda.","poem":2},{"text":"Ne suntha gisho nuna ashsha;","poem":1},{"text":"nu nagaraa atto ga.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dereti, “Enta Xoossay awun de7ii?” ayis gaanee?","poem":1},{"text":"Ne aylleta suuthaa enti gussida gisho;","poem":2},{"lineBreak":true},{"text":"neeni halo keyeysa nu xeellishin,","poem":2},{"lineBreak":true},{"text":"enta giddon qoncisa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Qasho asaa ooley ne sinthe gako;","poem":1},{"text":"hayqo pirdetidaysata","poem":2},{"lineBreak":true},{"text":"ne wolqaa gitatethan ashsha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Godaw, nu shooroti nena toochida gisho,","poem":1},{"text":"laapun kushe halo keyada enta ki7on idintha.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"He wode nuuni ne asay, ne dorsati,","poem":1},{"text":"merinaw nena galatana.","poem":2},{"text":"Yeletethaafe yeletethaa gakanaw,","poem":1},{"text":"ne peeshsha odana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}