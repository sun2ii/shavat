a wode,","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"neeni asaba qopanaw asi aybee?","poem":2},{"lineBreak":true},{"text":"Woyko neeni iya xomoosanaw I aybee?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iya ne neepe guuthara guuthadasa;","poem":1},{"text":"bonchonne gitatetha kallacha","poem":2},{"lineBreak":true},{"text":"iya huuphen wothadasa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne medhida medhetetha ubbaa,","poem":1},{"text":"haarana mela ne iya shuumadasa;","poem":2},{"lineBreak":true},{"text":"ubbaa iya tohuwape garsara wothadasa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dorsatanne meheta,","poem":1},{"text":"wora do7ata ubbaa,","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"salo kafota, abba molotanne","poem":2},{"lineBreak":true},{"text":"haatha garsan qaaxiya ubbaa","poem":2},{"lineBreak":true},{"text":"iyaw haarisadasa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abeeti Godaw nu Xoossaw,","poem":1},{"text":"ne sunthay biitta ubban waanidi bonchetide!","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Galata: Ibraawetho doonan guutha nayta galatan minotethi shiishasa guussu.","reference":{"chapter":8,"verse":2}}]},"thisChapterLink":"/api/gof_ltw/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}