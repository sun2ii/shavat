{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":80,"content":[{"type":"heading","content":["Xoossaw, Nuna Ooratha"]},{"type":"hebrew_subtitle","content":["Asaafi Zammaareta Halaqaas Xaafida Mazmure"]},{"type":"hebrew_subtitle","content":["“Ciishsha cuudhethi” geetetiya markatetha mazmure"]},{"type":"verse","number":1,"content":["Yoosefa dorsa wudeda kaaletheyso,",{"text":"Isra7eele henthanchuwaw nuna si7a.","poem":2},{"text":"Kiruubeta bolla de7iya araatan uttidayso,","poem":1},{"text":"ne poo7uwan qonca.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Efreema, Biniyaamenne Minaase sinthan benta;","poem":1},{"text":"ne wolqaa qaathada nuna ashshanaw haaya.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Xoossaw nuna zaara;","poem":1},{"text":"nu attanaada ne som7uwa nuus poo7isa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ubbaafe Wolqaama Godaw Xoossaw,","poem":1},{"text":"ne asaa woosa bolla awude gakanaw shenetay?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neeni enta yeeho kathada muzadasa;","poem":1},{"text":"afuthu haathada ushshadasa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nu shooroti nu biitta ekanaw","poem":1},{"text":"banta giddon oyaana mela oothadasa;","poem":2},{"lineBreak":true},{"text":"nu morketi nu bolla miicidosona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ubbaafe Wolqaama Xoossaw nuna zaara;","poem":1},{"text":"nu attanaada ne som7uwa nuus poo7isa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gibxefe woyne ehadasa;","poem":1},{"text":"kawotethata yedethada,","poem":2},{"lineBreak":true},{"text":"enta biittan iya tokadasa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neeni biitta qeexadasa;","poem":1},{"text":"I xapho yeddidi, daayidi biitta gakis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dereti iya kuyan,","poem":1},{"text":"Libaanose zigati iya tashiyan kametidosona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ba tasheta Medetiraane Abbaa gakanaw,","poem":1},{"text":"ba xeerata Efraxiisa shaafa gakanaw yeddis.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yaatin, ogera aadhiya ubbay","poem":1},{"text":"iya ayfiya duuthanaada,","poem":2},{"lineBreak":true},{"text":"iya yuushon de7iya gimbiya ayis laalladii?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bazzo gudunthoy iya bolla gupis;","poem":1},{"text":"wora do7ati iya midosona.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ubbaafe Wolqaama Xoossaw nuuko simma;","poem":1},{"text":"salora duge xeellada; ha woyniya naaga.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"I ne ushacha kushey tokida xapho;","poem":1},{"text":"neeni new dichida puute.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ne morketi ne woyniya qanxidosona;","poem":1},{"text":"taman xuuggidosona;","poem":2},{"lineBreak":true},{"text":"enta ne hanquwan dhaysa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ne kushey ne ushachan de7iya asaa,","poem":1},{"text":"neeni new dichida asaa naago.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hiza nuuni guye simmoko;","poem":1},{"text":"Nuna paxa wotha; ne sunthaa galatana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ubbaafe Wolqaama Godaw Xoossaw, nuna zaara;","poem":1},{"text":"nu attanaada ne som7uwa nuus poo7isa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}