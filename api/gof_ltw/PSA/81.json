{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":81,"content":[{"type":"heading","content":["Shaqara Ba7aale Wode Yexiya Saba"]},{"type":"hebrew_subtitle","content":["Zammaareta halaqaas xaafetida Suusul7en yexetiya Asaafa Mazmure"]},{"type":"verse","number":1,"content":["Nuus wolqa gidida Xoossaas ufaysan yexite;",{"text":"Yayqooba Xoossaas ililite.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yethi doomite; karaabo baqite;","poem":1},{"text":"diithaninne maasinqon yexite.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ageeni xeeriya wode,","poem":1},{"text":"qassi dhuma uttiya wode,","poem":2},{"lineBreak":true},{"text":"ba7aale gallasan moyze punnite.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hessi Isra7eele biittan higge;","poem":1},{"text":"Yayqooba Xoossay immida woga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"I Gibxe biitta shocida wode,","poem":1},{"text":"Yoosefa kochaas ha wogaa awaajis.","poem":2},{"lineBreak":true},{"text":"Eronna doonan haysada yaagishin si7as;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"“Hinte hashiya toohope,","poem":1},{"text":"hinte kushiya keeshepe shempisas.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hinte metuwan tana xeegideta; ta hintena ashshas;","poem":1},{"text":"taani dechiya shaara giddofe hintena allas;","poem":2},{"lineBreak":true},{"text":"Mariba pultuwa matan ta hintena paacas.” Salaha","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Ta asaw, ta hintena seereysa si7ite;","poem":1},{"text":"Isra7eele asaw hinte tana si7iko aybee?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hinte giddon allaga xoossi de7opo;","poem":1},{"text":"hara xoosse goyinnofite.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gibxe biittafe hintena kessida,","poem":1},{"text":"taani Godaa hinte Xoossaa;","poem":2},{"text":"Ne doona loythada hakanka;","poem":1},{"text":"taani iyan kunthana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Shin ta asay tana si7ibookona;","poem":1},{"text":"Isra7eeley taw kiitetibeenna.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hessa gisho, enti banta qofaa kaallana mela,","poem":1},{"text":"simmonna enta wozanaas aathada immas.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ta asay tana si7idaako aybe;","poem":1},{"text":"Isra7eeley ta ogiya kaallidaako aybi de7i;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Taani enta morketa eeson xoonanashin;","poem":1},{"text":"enta ixeyisata bolla ta kushiya denthanashin.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Godaa ixeysati iya sinthan hokana;","poem":1},{"text":"enta seeray merinaw gidana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Taani hintena lo77o giste muzana;","poem":1},{"text":"zaallafe keyiya eessan hintena kalsana.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}