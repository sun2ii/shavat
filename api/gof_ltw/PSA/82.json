e":"verse","number":6,"content":[{"text":"Taani, “Hinte xoossata;","poem":1},{"text":"ubbay Ubbaafe Dhoqa Xoossaa nayta.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gidoshin hinte asi hayqeysada hayqana;","poem":1},{"text":"hara halaqati kundeysada kundana” yaagas.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Xoossaw, denda; biitta bolla pirda;","poem":1},{"text":"kawotethati ubbay nebaa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}