{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":83,"content":[{"type":"heading","content":["Xoossaw Si77i Goopa"]},{"type":"hebrew_subtitle","content":["Asaafa Mazmure"]},{"type":"verse","number":1,"content":["Abeeti Xoossaw, si77i goopa;",{"text":"Xoossaw sirphi goopa; muumopa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne morketi ne bolla dendeysa,","poem":1},{"text":"nena ixeysati ne bolla makalleysa be7a.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Enti ne asaa bolla geeman duulatoosona;","poem":1},{"text":"neeni dosiya asaa bolla maqetoosona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Haayite, enta kawotethaa dhaysoos;","poem":1},{"text":"Isra7eele geetetiya sunthay merinaw hassayetonna mela oothoos” yaagosona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Enti issi wozanan gididi maqetoosona;","poem":1},{"text":"ne bolla dendanaw caaqidosona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Enti, Edoomenne Isma7eela asaa,","poem":1},{"text":"Moo7abenne Aggaari kochata;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gebaalanne Amoone asaa,","poem":1},{"text":"Amaaleqa, Filisxeemenne Xiroosa asaa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Asooreti entara gahetidosona;","poem":1},{"text":"Asooreti Looxe asaas wolqaama maado gididosona. Salaha","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neeni, Midiyaame, Sisaaranne Yabina bolla","poem":1},{"text":"Qisoona shaafan oothidaysada enta bolla ootha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Enti Endooran dhayidosona;","poem":1},{"text":"enta ahay denban wooqidi attis.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Enta halaqata Oreebanne Zebada ootha;","poem":1},{"text":"enta haareyisata Zabheelanne Silmanada dhaysa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Enti, “Nuuni Xoossaa asaa laata","poem":1},{"text":"nuus buzo oothana” yaagidosona.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ta Xoossaw, enta baanada laalla;","poem":1},{"text":"carkoy efiya suullada ootha.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tami wora meysada,","poem":1},{"text":"tama lacoy deriya xuuggeysada,","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ne uushuwan enta yedetha;","poem":2},{"lineBreak":true},{"text":"ne gotiyan enta dagantha.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Godaw, asay ne sunthaa koyana mela,","poem":1},{"text":"enta som7uwa yeella mayza.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Enti merinaw yeellato; hirgo;","poem":1},{"text":"kawuyidi dhayo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ne sunthay Godaa gidida ne xalaali,","poem":1},{"text":"Ubbaafe Dhoqa Xoossay,","poem":2},{"lineBreak":true},{"text":"sa7a ubbaa haareysa enti ero.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}