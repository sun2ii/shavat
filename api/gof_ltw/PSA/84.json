{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":84,"content":[{"type":"heading","content":["Xoossa Keethi Bishe Yexia Mazmure"]},{"type":"hebrew_subtitle","content":["Zammaareta halaqaas Qore nayti xaafida Suusul7en yexetiya mazmure"]},{"type":"verse","number":1,"content":["Ubbaafe Wolqaama Godaw,",{"text":"ne de7iya bessay waani lo77i!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taani Godaa keetha dabaaba laamotayis;","poem":1},{"text":"ta kumetha asatethay","poem":2},{"lineBreak":true},{"text":"de7o Xoossaas ufaysan yexees.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ubbaafe Wolqaama Godaw,","poem":1},{"text":"ta kawaw, ta Xoossaw,","poem":2},{"lineBreak":true},{"text":"ne yarsho bessa matan","poem":2},{"lineBreak":true},{"text":"buube kafoy baw de7iya bessi demmasu;","poem":2},{"lineBreak":true},{"text":"holleyka ba nayta wothiya keethe keexasu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne keethan de7eysatinne","poem":1},{"text":"merinaw nena sabbeysati anjetidaysata. Salaha","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nena banta minotethi ootheysati,","poem":1},{"text":"banta wozanaa Xiyoone ogiya bolla,","poem":2},{"lineBreak":true},{"text":"wotheysati anjetidaysata.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Enti yeeho zangaarara aadhiya wode,","poem":1},{"text":"he bessay pultoy keyiya bessi gidis;","poem":2},{"lineBreak":true},{"text":"torche iray bukidi ollaa kunthees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Enti wolqa bolla wolqa guji guji baana;","poem":1},{"text":"issoy issoy Xoossa sinthan Xiyoonen bentana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ubbaafe Wolqaama Godaw Xoossaw,","poem":1},{"text":"ta woosa neeni si7a;","poem":2},{"lineBreak":true},{"text":"Yayqooba Xoossaw hayza. Salaha","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Xoossaw, nu gondalliya be7a;","poem":1},{"text":"ne doorida kawa keeha ayfen xeella.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Taani hara bessan mukulu gallas daanape,","poem":1},{"text":"ne dabaaban issi gallas de7eysi taw lo77o.","poem":2},{"text":"Iitata dunkaaniyan daanape,","poem":1},{"text":"Xoossa keetha penge naagoy taw lo77o.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Godaa Xoossay nuus gondallenne poo7o;","poem":1},{"text":"nuus bonchonne keehatethi immees;","poem":2},{"lineBreak":true},{"text":"suuretethan hemeteyisata lo77oba diggenna.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ubbaafe Wolqaama Godaw,","poem":1},{"text":"nenan ammaneteysati anjetidaysata.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}