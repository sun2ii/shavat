{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":85,"content":[{"type":"heading","content":["Nuna Zaarada Denthetha"]},{"type":"hebrew_subtitle","content":["Zammaareta halaqaas xaafetida Qore nayta mazmure"]},{"type":"verse","number":1,"content":["Godaw, neeni ne biittas keehadasa;",{"text":"Yayqooba kochaa di7ope guye zaaradasa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne asaa naaquwa atto gadasa;","poem":1},{"text":"enta nagaraa ubbaa kammadasa. Salaha","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne yiluwa aggadasa;","poem":1},{"text":"suulliya ne hanquwafe simmadasa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Abeeti nuna ashshiya Xoossaw,","poem":1},{"text":"nuna guye zaara;","poem":2},{"lineBreak":true},{"text":"nu bolla lancidaysa agga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neeni nu bolla merinaw shenetayee?","poem":1},{"text":"Ne hanquwafe simmikiyee?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nuuni nenan ufaytana mela,","poem":1},{"text":"nuna zaarada oorathikiyee?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abeeti Godaw, ne merina siiquwa nuna bessa;","poem":1},{"text":"nuna ashsha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Godaa Xoossay odiyaba taani si7ana;","poem":1},{"text":"enti banta eeya ogiyako simmonna ixiko,","poem":2},{"lineBreak":true},{"text":"I ba geeshsha deriyas sarotethi odees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iya bonchoy nu biittan daana mela,","poem":1},{"text":"Xoossaa yayyeyisata ashshanaw I matan de7ees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Siiqoynne tumatethi gahetidosona;","poem":1},{"text":"Xillotethinne sarotethi idimetidosona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tumatethi sa7aape pude keyees;","poem":1},{"text":"xillotethi salope duge xeellees.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xoossay lo77oba nuus immana;","poem":1},{"text":"nu biittay daro kathi ayfana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Xillotethi Godaa sinthan hemetana;","poem":1},{"text":"iya ogiya giigisana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}