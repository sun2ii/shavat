{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":86,"content":[{"type":"heading","content":["Xoossa Siiqoy Gita"]},{"type":"hebrew_subtitle","content":["Dawita Woosa"]},{"type":"verse","number":1,"content":["Godaw, taani manqonne metootancho gidiya gisho,",{"text":"ta woosa si7ada tana alla.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta new dummatida asi gidiya gisho, tana de7on wotha;","poem":1},{"text":"nenan ammanetiya tana, ne aylliya ashsha;","poem":2},{"lineBreak":true},{"text":"neeni ta Xoossa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Godaw, gallas kumethi ta neeko waassiya gisho,","poem":1},{"text":"taw qadheta.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Godaw, ta shempoy neeko waassiya gisho,","poem":1},{"text":"tana, ne aylliya ufaysa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Godaw, neeni keehanne atto geysa;","poem":1},{"text":"nena xeegiya ubbaas ne siiqoy daro.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Abeeti Godaw, ta woosa si7a;","poem":1},{"text":"ta waasuwa hayza.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne ta woosaas zaaro immiya gisho,","poem":1},{"text":"ta metuwa gallasan ta neeko waassana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Godaw, xoossata giddon ne meli baawa;","poem":1},{"text":"ne oosuwara giney baawa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Godaw, neeni medhida kawotethati yidi,","poem":1},{"text":"ne sinthan gulbatana; ne sunthaa bonchana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Neeni gita; ne malaalsiya ooso oothiya gisho","poem":1},{"text":"Xoossi ne xalaala.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Godaw, ta ne tuman hemetana mela,","poem":1},{"text":"tana ne ogiya tamaarsa.","poem":2},{"text":"Taani ne sunthaas yayyana mela,","poem":1},{"text":"taw issi wozanaa imma.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Godaw ta Xoossaw,","poem":1},{"text":"taani nena ta kumetha wozanan galatana;","poem":2},{"lineBreak":true},{"text":"ne sunthaa merinaw bonchana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ne siiqoy taw daro;","poem":1},{"text":"tana duufope ashshadasa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Xoossaw, otoranchoti ta bolla dendidosona;","poem":1},{"text":"iita asata cugay tana wodhanaw koyees;","poem":2},{"lineBreak":true},{"text":"enti nena wuda gookona.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Shin abeeti Godaw,","poem":1},{"text":"neeni qadhetiyanne maariya Xoosse.","poem":2},{"text":"Neeni hanqetanaw gam7aasa;","poem":1},{"text":"siiqoynne ammanetethi daridaysa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Taako simmada taw qadheta;","poem":1},{"text":"ne aylliyas wolqa imma;","poem":2},{"lineBreak":true},{"text":"ne gadhinde na7aa tana ashsha.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Godaw, ne keehatetha malaata tana bessa;","poem":1},{"text":"ne tana maaddeysanne minthetheysa be7iya wode,","poem":2},{"lineBreak":true},{"text":"ta morketi yeellatana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}