{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":88,"content":[{"type":"heading","content":["Qammanne Gallas Neeko Waassayis"]},{"type":"hebrew_subtitle","content":["Zammaareta Halaqaas Xaafetida Qore Nayta Mazmure"]},{"type":"hebrew_subtitle","content":["Akeekan xaafida ginxo; aaretho mazmure"]},{"type":"hebrew_subtitle","content":["Izra7eela addiya Emaana mazmure"]},{"type":"verse","number":1,"content":["Godaw, tana ashshiya Xoossaw,",{"text":"taani gallas neeko waassayis;","poem":2},{"lineBreak":true},{"text":"qamma ne sinthan yeekayis.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta woosay ne sinthe gako;","poem":1},{"text":"ne haythay ta waasuwa si7o.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ta shempoy meto kallida gisho,","poem":1},{"text":"ta de7oy duufoko matis.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Duufo geliya asaara taybetas;","poem":1},{"text":"wolqi bayna asi gidas.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Taani ahata giddon yegetida asa mela;","poem":1},{"text":"hayqidi duufon zin7ida asa mela.","poem":2},{"text":"Hizape neeni hassayonna asinne","poem":1},{"text":"neepe duuxida asa mela gidas.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Neeni tana ciimmon,","poem":1},{"text":"dhuma ollan yeggadasa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne hanqoy tana deexees;","poem":1},{"text":"ne hanquwa beetay tana muukis. Salaha","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Neeni ta dabbota taape haassadasa;","poem":1},{"text":"enti tana shaatettana mela oothadasa.","poem":2},{"text":"Tana teqidosona;","poem":1},{"text":"kessa ekanaw danda7ike.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Godaw, azzanon ta ayfey teljumis;","poem":1},{"text":"Ubba gallas taani neeko waassayis;","poem":2},{"lineBreak":true},{"text":"ta kushiya neeko miccas.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hayqidaysatas ne malaalsiyaba oothayee?","poem":1},{"text":"Enti dendidi nena galatonayee? Salaha","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Merinaa ne siiqoy duufon,","poem":1},{"text":"ne ammanetethay dhayo bessan odetiyee?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne malaalsiya oosoy dhuman,","poem":1},{"text":"ne xillotethay dogetida biittan eretiyee?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Godaw, ta neeko waassayis;","poem":1},{"text":"wonta wonta ta woosay ne sinthe gakees.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Godaw, ne tana ayis ixay?","poem":1},{"text":"Ne som7uwa taape ayis genthay?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Na7atethafe doomada taani un7etas;","poem":1},{"text":"hayqos matas;","poem":2},{"lineBreak":true},{"text":"ne tana daganthin ufaysi qanxas.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ne suulliya hanqoy ta bolla uushis;","poem":1},{"text":"ne daganthoy tana dhaysis.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Enti gallas kumethi di7oda tana teqidosona;","poem":1},{"text":"issife shiiqidi tana oykidosona.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ta laggetanne","poem":1},{"text":"taw mata asata taape haassadasa;","poem":2},{"lineBreak":true},{"text":"taw dabboy dhuma xalaala.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}