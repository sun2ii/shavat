{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":89,"content":[{"type":"heading","content":["Ammanthiya Xoossas Yexite"]},{"type":"hebrew_subtitle","content":["Izra7eela Addiya Etaana Mazmure"]},{"type":"hebrew_subtitle","content":["Akeekan xaafida ginxo"]},{"type":"verse","number":1,"content":["Godaw, ne siiquwaba taani merinaw yexana;",{"text":"ne ammanetetha yeleta ubbaas awaajana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne siiqoy merinaw eqidaysanne","poem":1},{"text":"tumatethaa neeni salon minthada essidaysa odana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Neeni, “Ta dooridaysara qaala gelas;","poem":1},{"text":"Ta aylliya Dawitas haysada yaagada caaqas;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"‘Taani ne kochaa merinaw kawothana;","poem":1},{"text":"ne araata yeleta ubban minthana’ ” yaagadasa. Salaha","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Godaw, saloti ne malaalsiya oosuwa awaajo;","poem":1},{"text":"geeshshata shiiqoy ne ammanetetha odo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Salon Godaara liketanaw danda7ey oonee?","poem":1},{"text":"Salo medhetethata giddon Godaa meli oonee?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Geeshshata shiiquwan Xoossay yashisees;","poem":1},{"text":"iya yuushuwan de7iya ubbaafe aadhidi daganthees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ubbaafe Wolqaama Godaw Xoossaw,","poem":1},{"text":"ne mela wolqaami oonee?","poem":2},{"lineBreak":true},{"text":"Godaw, neeni ubbaban ammanetaasa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neeni guummiya abba wolqaa kiittasa;","poem":1},{"text":"dendiya zuliya si77i oothaasa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ra7aaba geetetiya do7a mentherethadasa;","poem":1},{"text":"ne morketa ne wolqaama qesiyan laalladasa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Saloynne sa7i nebaa;","poem":1},{"text":"alamiyanne iyan de7iya ubbaa medhiday nena.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Pudehanne dugeha ne medhadasa;","poem":1},{"text":"Taaborenne Armoona zumati,","poem":2},{"lineBreak":true},{"text":"ufaysan ne sunthaa sabboosona.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"New wolqaama qesey de7ees;","poem":1},{"text":"ne kushey mino;","poem":2},{"lineBreak":true},{"text":"ne ushacha kushey dhoqu gis.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Xillotethinne suure pirdi ne araatas baaso;","poem":1},{"text":"siiqoynne tumatethi ne sinthan boosona.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Godaw, ufaysan ilileysatnne","poem":1},{"text":"ne som7uwa poo7uwan hemeteysati anjetidaysata.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ne sunthan gallas kumethi ufaytoosona;","poem":1},{"text":"enti ne xillotethaa dhoqu dhoqu oothosona.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Enti ceeqetiya wolqay nena;","poem":1},{"text":"ne teeman nu kacey dhoqu dhoqu gis.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nu gondalley nu Godaa kushena;","poem":1},{"text":"nu kawoyka Isra7eele geeshshaa kushena.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Beni neeni, ne ammanetida asaas","poem":1},{"text":"qoncethan haysada yaagadasa.","poem":2},{"text":"“Taani issi olanchuwa maaddas;","poem":1},{"text":"asaa giddofe dooretidaysa dhoqu dhoqu oothas.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ta aylliya Dawita demmas;","poem":1},{"text":"ta geeshsha zaytiya tiyada iya kawothas.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ta kushe iyara daana;","poem":1},{"text":"ta qesey iya minthana.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Iya ay morkeyka giirisenna;","poem":1},{"text":"ay iita asika iya haarenna.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Iya morketa ta iya sinthan tincherethana;","poem":1},{"text":"iya ixeyisata shoca yeggana.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ta tumatethaynne ta siiqoy iyara gidana;","poem":1},{"text":"ta sunthan iya kacey dhoqu dhoqu gaana.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Taani iya kawotethaa Medetiraane Abbaa,","poem":1},{"text":"iya zawa shaafata gakanaw aassana.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"I tana, ‘Neeni ta aawa, ta Xoossaa;","poem":1},{"text":"tana ashshiya zaalla’ yaagidi xeegana.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Taani iya bayra na7a oothana;","poem":1},{"text":"sa7an de7iya kawota ubbaafe iya gitayana.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Taani ta siiquwa merinaw iyaw naagana;","poem":1},{"text":"taani iyara caaqida caaquwa minthana.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Taani iya kochaa merinaw minthada essana;","poem":1},{"text":"iya araata saloda gam7isana.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"“Shin iya kochati ta higgiya aggiko,","poem":1},{"text":"enti ta wogaada hemetonna ixiko,","poem":2}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"ta awaajuwa shaariko,","poem":2},{"lineBreak":true},{"text":"ta kiita naagonna ixiko,","poem":2}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"taani enta nagaraa gisho xam7an,","poem":2},{"lineBreak":true},{"text":"enta iitatethaa gisho lisson seerana.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Shin taani ta siiquwa iyape ekike;","poem":1},{"text":"taani iyaw merinaw ammanetana.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Taani entara caaqida caaquwa menthike;","poem":1},{"text":"ta doonape keyida qaala laammike.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Taani issi toho ta geeshshatethan caaqida gisho,","poem":1},{"text":"Dawitas wordotike.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Iya kochay merinaw daana;","poem":1},{"text":"iya araatay ta sinthan awada gam7ana.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Salon ammanetiya marka gidida ageenada,","poem":1},{"text":"iya kawotethay merinaw minnidi daana” yaagadasa. Salaha","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Shin ha77i ne tiyida kawa bolla hanqetadasa;","poem":1},{"text":"iya ixadasa; aggadasa.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Ne aylliyara caaqida caaquwa menthadasa;","poem":1},{"text":"iya kallachaa baanan holada tunisadasa.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Iya katamaa gimbe dirsa laalladasa;","poem":1},{"text":"iya miixaa dhaysadasa.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Ogera aadhiya ubbay iya bonqidosona;","poem":1},{"text":"I ba shoorotas miichas attis.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Iya morketas xoono immadasa,","poem":1},{"text":"enta ubbaa ufaysadasa.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Iya mashshaa xeeraa qalam7adasa;","poem":1},{"text":"iya olan maaddabaaka.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Iya kawota xam7aa iya kushepe ekadasa;","poem":1},{"text":"iya araata biittan holadasa.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Iya yalagatetha wodiya qaamisadasa;","poem":1},{"text":"iya yeella mayzadasa. Salaha","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Godaw, neeni awude gakanaw gam7ay?","poem":1},{"text":"Neeni merinaw geemmanee?","poem":2},{"lineBreak":true},{"text":"Ne hanqoy tamada awude gakanaw eexanee?","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Ta laythay ay mela qantheko qopa;","poem":1},{"text":"asa ubbaa coo mela medhadi!","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Hayqope attanaw danda7iya asi de7ii?","poem":1},{"text":"Duufo gelonna daanaw danda7ey oonee? Salaha","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Godaw, neeni ne tumatethan Dawitas caaqida,","poem":1},{"text":"ne siiqoy awun de7ii?","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Godaw, ne aylley ay mela boretidaako be7a;","poem":1},{"text":"asa ubbaa boriya waata danda7idaako hassaya.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Godaw, ne morketi qelqisidaysa,","poem":1},{"text":"ne tiyida kawa tangon tangon boreysa be7a.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"Goday merinaw galatetto!","poem":1},{"lineBreak":true},"Amin7i! Amin7i!"]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":52}