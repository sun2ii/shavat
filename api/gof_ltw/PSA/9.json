{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":9,"content":[{"type":"heading","content":["Iitata Bolla Yaana Pirda"]},{"type":"hebrew_subtitle","content":["Zammaareta Halaqaas Xaafetida Dawita Mazmure"]},{"type":"hebrew_subtitle","content":["“Na7a hayqon” geetetiya cuudhethan yexetiya mazmure."]},{"type":"verse","number":1,"content":["Abeeti Godaw, ta nena ta kumetha wozanaape galatana;",{"text":"neeni oothida malaalsiya ooso ubbaa odana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taani nenan ufaytana hashshu gaana.","poem":1},{"text":"Ubbaafe Dhoqa Xoossaw,","poem":2},{"lineBreak":true},{"text":"taani ne sunthaas galata mazmure yexana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ta morketi guye simmiya wode,","poem":1},{"text":"ne sinthafe dhubetidi dhayana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne araatan uttada taw xillo pirdaasa;","poem":1},{"text":"ta mootuwa ne xillotethan oykadasa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neeni kawotethata seeradasa;","poem":1},{"text":"iitata dhaysadasa.","poem":2},{"text":"Neeni enta sunthaa merinaw quchadasa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Morketi merinaw dhayidosona;","poem":1},{"text":"enta katamata kumethi laalladasa;","poem":2},{"lineBreak":true},{"text":"enti kumethi dogetidosona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Shin Goday merinaw kawotidi de7ees;","poem":1},{"text":"I ba araata pirdas giigisis.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ha sa7aa xillotethan pirdana;","poem":1},{"text":"dereta suuretethan aysana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Goday un7etidaysatas attiya bessi;","poem":1},{"text":"meto wode gelidi attiya qota.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nena ereysati nenan ammanetosona;","poem":1},{"text":"Godaw, nena koyeyisata yegga aggaka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Xiyoonen kawotida Godaa galatite;","poem":1},{"text":"I oothida oosuwa asa ubbaas odite.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Halo keyiya Xoossay gukida xillo suuthaa dogenna;","poem":1},{"text":"boretidaysata waasuwa qelli geenna.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Abeeti Godaw, taw qadheta;","poem":1},{"text":"ta morketi ta bolla ehiya metuwa be7a;","poem":2},{"lineBreak":true},{"text":"hayqope tana ashsha.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Xiyoone asaa giddon taani eqada,","poem":1},{"text":"ne galataa odana;","poem":2},{"lineBreak":true},{"text":"ne atotethan ufaytana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kawotethati banta bookida ollan","poem":1},{"text":"bantaw kundidosona;","poem":2},{"lineBreak":true},{"text":"enti wothida xihey enta tohuwa oykis.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Goday ba xillo pirdan eretis;","poem":1},{"text":"iita asay banta iita oosuwan oyketidosona. Salah","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Iitati duufo baana;","poem":1},{"text":"Xoossaa dogiya kawotethati ubbay entada hanana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Manqoy ubba wode dogetidi attenna;","poem":1},{"text":"metootanchuwa ufaysay merinaw dhayenna.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Abeeti Godaw denda; asi xoonopo!","poem":1},{"text":"Kawotethati ne sinthan pirdeto.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Abeeti Godaw enta neeni yashisa;","poem":1},{"text":"kawotethati ase gideysa ero. Salaha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}