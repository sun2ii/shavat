{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":90,"content":[{"type":"heading","content":["Merinaw De7iya Xoossa"]},{"type":"hebrew_subtitle","content":["Xoossa asi gidida Muse woosa"]},{"type":"verse","number":1,"content":["Godaw, neeni yeletape yeletaa gakanaw,",{"text":"nuuni de7iya bessi gidadasa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dereti medhetanaape kase,","poem":1},{"text":"sa7i oosetanaape kase,","poem":2},{"lineBreak":true},{"text":"merinaape merinaa gakanaw ne Xoosse.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Neeni, “Asa nayto, guye biittako simmite” yaagada,","poem":1},{"text":"enta medhetida biittako guye zaarasa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mukulu laythi zine aadhida gallasa mela;","poem":1},{"text":"woyko issi qamma giddon issi saate mela.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neeni asaa qoponna di7oda efaasa;","poem":1},{"text":"enti amuho mela;","poem":2},{"lineBreak":true},{"text":"wonta wonta doliya maata mela.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Maati wonta diccidi ciyees;","poem":1},{"text":"omarsiya wode shullidi melees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nuuni ne yiluwan wurida;","poem":1},{"text":"ne hanquwa suulon dagammida.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nu iita oosuwa ne sinthan wothadasa;","poem":1},{"text":"nu geemmida nagaraa ne som7uwa poo7uwan wothadasa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nu gallasa ubbay ne hanquwan aadhis;","poem":1},{"text":"nu laytha oolen wursoos.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nu de7o laythay laapun tamma;","poem":1},{"text":"woyko dariko hospun tamma.","poem":2},{"text":"Hessika metoynne waayey kumidaysa;","poem":1},{"text":"nu laythay eeson wurees; nuka eeson aadhoos.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne hanquwa wolqaa erey oonee?","poem":1},{"text":"ne hanquwa suuloy wolqaama.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nu laytha maara ogen nu go7etana mela,","poem":1},{"text":"nuna cincatethi tamaarsa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Godaw, ne hanqoy awude gakanaasee?","poem":1},{"text":"hayyana ne aylletas qadheta.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nu laytha ubban","poem":1},{"text":"nu ufaytanaadanne yexanaada,","poem":2},{"lineBreak":true},{"text":"wonta wonta ne siiquwa nuna kalsa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ne nuna metoothida gallasata keena,","poem":1},{"text":"nuuni un7etida laythata keena nuna ufaysa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nuus ne aylletas ne oosoy qonco;","poem":1},{"text":"ne bonchoy enta naytas bento.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Godaa nu Xoossaa keehatethay nu bolla gido;","poem":1},{"text":"nu kushe ooso ubba nuus ayfisa;","poem":2},{"lineBreak":true},{"text":"Ee, nu kushe ooso ubbaa ayfisa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}