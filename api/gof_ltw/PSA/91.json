{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":91,"content":[{"type":"heading","content":["Xoossa Naago"]},{"type":"verse","number":1,"content":["Ubbaafe Dhoqa Xoossan naagetidi de7ey,",{"text":"Ubbaafe Wolqaama Xoossaa kuyan aqees.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"I Godaa, “Neeni taw miixanne qosetta attiya bessi,","poem":1},{"text":"neeni tana ammanthiya ta Xoossaa” yaagana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"I nena shankanchota xihepe,","poem":1},{"text":"wodhidi ongiya gadope ashshana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I ba baalletan nena kammana;","poem":1},{"text":"iya qefiya garsan neeni qosetada attana;","poem":2},{"lineBreak":true},{"text":"iya ammanetethay new gondallenne kate.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neeni qamma daganthiyabas,","poem":1},{"text":"woyko gallas xongetiya tooras yayyaka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Neeni dhuman oykiya harge,","poem":1},{"text":"woyko gallasa seetan ongiya gado hirgaka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mukulay ne miyen,","poem":1},{"text":"tammu mukulay ne ushachan kundana;","poem":2},{"lineBreak":true},{"text":"shin nena aybika bochenna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iitati seeretishin,","poem":1},{"text":"neeni ne ayfe xalaalan be7ana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neeni Godaa new qosetada attiya bessi oothida gishonne,","poem":1},{"lineBreak":true},{"text":"Ubbaafe Dhoqa Xoossaa ne de7iya bessi oothida gisho,","poem":1}]},{"type":"verse","number":10,"content":[{"text":"iitabay nena bochenna;","poem":2},{"lineBreak":true},{"text":"gadoy ne keethaako shiiqenna.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne oge ubban nena naagana mela,","poem":1},{"text":"Xoossay ba kiitanchota kiittana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne tohoy shuchan dhubetonna mela,","poem":1},{"text":"kiitanchoti banta kushen nena denthana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Neeni gaammonne shoosha bolla hemetana;","poem":1},{"text":"wodala gaammonne iita shooshaa yedhana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Xoossay,","poem":1},{"text":"“I tana siiqida gisho taani iya ashshana;","poem":2},{"lineBreak":true},{"text":"ta sunthaa eriya gisho taani iya naagana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"I tana xeegiya wode taani iyaw koyana;","poem":1},{"text":"meto wode taani iyara gidana;","poem":2},{"lineBreak":true},{"text":"taani iya ashshananne bonchana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Taani iya laytha adussana;","poem":1},{"text":"ta atotetha iya bessaana” yaagees.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}