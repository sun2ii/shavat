{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":92,"content":[{"type":"heading","content":["Xoossa Oosoy Gita"]},{"type":"hebrew_subtitle","content":["Sambaata gallasa mazmure"]},{"type":"verse","number":1,"content":["Godaa galatoy lo77o;",{"text":"Ubbaafe Dhoqa Xoossaw,","poem":2},{"lineBreak":true},{"text":"ne suntha saboy lo77o.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wonta wonta ne siiquwa odoy,","poem":1},{"text":"qamma ne ammanetetha awaajoy lo77o.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tammu shayan waaxetida diithan","poem":1},{"text":"maasinqo kaa7ishe nena galatoy lo77o.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taani ne oosuwan ufaytida gisho,","poem":1},{"text":"ne kushe oosuwa gisho nena galatayis.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Godaw, ne oosoy ay mela gite!","poem":1},{"text":"Ne qofay ay mela ciimmo!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eeya asi eranaw danda7enna;","poem":1},{"text":"wozani bayna asi akeekanaw danda7enna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iitati maatada diccikoka,","poem":1},{"text":"iita ootheysati daaykoka,","poem":2},{"lineBreak":true},{"text":"enti merinaw dhayana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Shin abeeti Godaw,","poem":1},{"text":"neeni merinaw ubbaafe dhoqa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abeeti Godaw, tuma ne morketi dhayana;","poem":1},{"text":"iita oothiya ubbay piski gaana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta kaciya mentha kaceda dhoqu oothadasa;","poem":1},{"text":"lo77o zayte ta huuphen tiyadasa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ta morketi xoonetishin ta ayfen be7as;","poem":1},{"text":"tana un7etheysati waassishin ta haythan si7as.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xilloti zambada diccana;","poem":1},{"text":"Libaanose zigada daayana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Enti Godaa keethan toketida mitha mela;","poem":1},{"text":"enti nu Xoossaa dabaaban daana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Enti ceeggidika ayfana;","poem":1},{"text":"enti irxanne cil7o gididi daana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Enti, “Goday suure;","poem":1},{"text":"I ta zaalla; iyan iitatethi baawa” yaagana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}