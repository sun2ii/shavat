.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}