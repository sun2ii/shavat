{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":94,"content":[{"type":"heading","content":["Xoossay Ba Asaa Aggenna"]},{"type":"verse","number":1,"content":["Godaw, neeni halo keyiya Xoossi;",{"text":"kushe zaariya Xoossaw, ne bonchuwa bessa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abeeti sa7aa pirdiya Xoossaw denda;","poem":1},{"text":"otoranchotas bessiya seera imma.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Godaw, awude gakanaw gam7ay?","poem":1},{"text":"Iitati awude gakanaw ufaytanee?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iita ootheysati otoro qaala haasayoosona;","poem":1},{"text":"enti coo ceeqetoosona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Godaw, enti ne asaa liiqisoosona;","poem":1},{"text":"enti ne laata naaqoosona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Am7etanne betanchota wodhoosona;","poem":1},{"text":"aawi bayna nayta muucosona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Enti, “Goday nuna be7enna;","poem":1},{"text":"Yayqooba Xoossay akeekenna” yaagosona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hinteno, asaa giddofe eeyato, akeekite!","poem":1},{"text":"hinteno, eeyato hinte cinca gidanay awudee?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Haythe oothida Xoossay si7ennee?","poem":1},{"text":"Ayfe medhida Goday be7ennee?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kawotethata seeriya Xoossay seerennee?","poem":1},{"text":"Ase eratethi tamaarsiya i, erennee?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Goday asa qofi pathonnabaanne","poem":1},{"text":"hada gideysa erees.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abeeti Godaw, neeni seeriya asinne","poem":1},{"text":"ne higgiya tamaarsiya asi anjetidaysa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Iitati kundiya ollay booketana gakanaw,","poem":1},{"text":"meto gallas neeni iya shempisaasa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Xoossay ba asaa yeggenna;","poem":1},{"text":"I ba laata aggenna.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Pirdi simmidi xillotetha bolla eqana;","poem":1},{"text":"wozanaa suureti ubbay xillo pirdaa kaallana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Makallanchota bolla ta gisho dendey oonee?","poem":1},{"text":"Iita ootheysatara ta gisho eqetey oonee?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Goday tana maaddonnaako,","poem":1},{"text":"taani eeson duufo gelada attanashin.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Taani, “Ta tohoy hallixis” gida wode,","poem":1},{"text":"ne siiqoy tana katisis.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ta wozanan un7etethi kumida wode,","poem":1},{"text":"neeni tana wopu oothada ufaysaasa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Higge shaariya geella daynnatara","poem":1},{"text":"geella asara neeni hashetay?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Xillota wodhanaw enti tobboosona;","poem":1},{"text":"suureta bolla hayqo pirdoosona.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Gidoshin Goday ta miixaa;","poem":1},{"text":"ta Xoossay taani qosetada attiya zaalla.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Enta iitatethaa gisho I enta seerana;","poem":1},{"text":"enta nagaraa gisho I enta dhaysana;","poem":2},{"lineBreak":true},{"text":"Goday nu Xoossay enta dhaysana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}