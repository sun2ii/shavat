{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":95,"content":[{"type":"heading","content":["Xoossas Galata Mazmure Yexite"]},{"type":"verse","number":1,"content":["Haayite; ane Godaa sabboos;",{"text":"nuna ashshiya zaallas ufaysan ililoos.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iya sinthe galatara shiiqoos.","poem":1},{"text":"Galata mazmure ufaysan yexoos.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Goday wolqaama Xoosse;","poem":1},{"text":"xoossata ubbaa bolla gita kawo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Biitta ciimmoti iya qaaqan de7oosona;","poem":1},{"text":"deriya xeerati iyabaa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"I medhida gisho abbay iyabaa;","poem":1},{"text":"mela biittaa iya kushey oothis.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Haayite; ane gufannidi iya goyinnoos;","poem":1},{"text":"nuna medhida Godaa sinthan gulbatoos.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I nu Xoossaa;","poem":1},{"text":"nuuni iya qooron de7iya dereta;","poem":2},{"lineBreak":true},{"text":"nuuni I heemmiya iya dorsata.","poem":2},{"lineBreak":true},{"text":"Goday geysa hachi hinte si7iko,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kase hinte mayzati Mariban hanidaysada,","poem":1},{"text":"he gallas Maasan banta wozanaa minthidaysada,","poem":2},{"lineBreak":true},{"text":"hinte, hinte wozanaa minthofite.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Enti ta malaalsiya oosuwa be7idika,","poem":1},{"text":"tana paacidosona; taara eqetidosona.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Taani he yeletaa bolla oytamu laythi shaatettas;","poem":1},{"text":"“Enti ubba wode banta wozanan baliya asata;","poem":2},{"lineBreak":true},{"text":"enti ta ogiya erokona” yaagas.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hessa gisho, “Enti ta shempo bessaa gelokona”","poem":1},{"text":"yaagada ta hanquwan caaqas.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}