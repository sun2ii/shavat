{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":96,"content":[{"type":"heading","content":["Xoossa Geeshshatethan Goyinnite"]},{"type":"verse","number":1,"content":["Godaas ooratha mazmure yexite;",{"text":"sa7an de7iya asa ubbay Godaas yexite.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Godaas yexite; iya suntha sabbite;","poem":1},{"text":"Iya ashuwa gallas gallas odite.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kawotethata giddon iya bonchuwa,","poem":1},{"text":"asa ubbaa giddon iya malaalsiya oosuwa awaajite.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Goday gita gidiya gisho iyaw gita galatii bessees;","poem":1},{"text":"xoossata ubbaafe aadhidi yayetanaw bessees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hara kawotethata xoossati ubbay eeqata;","poem":1},{"text":"shin Goday salota medhida Xoossaa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bonchoynne sabi iya yuushon de7ees;","poem":1},{"text":"minotethinne puulatethi iya keethan de7ees.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Biittan de7iya asa zare ubbay Godaaba odite;","poem":1},{"text":"bonchoynne wolqi Godaaba giite.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Iya sunthaas bessiya bonchuwa Godaas ehite;","poem":1},{"text":"Yarsho ekidi iya dabaaba gelite.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iya geeshshatetha teemuwan Godaa goyinnite;","poem":1},{"text":"biittan de7iya asaw ubbay iya sinthan kokorite.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kawotethata giddon, “Goday kawotis!","poem":1},{"text":"Sa7ay minnidi eqis; qaaxenna;","poem":2},{"lineBreak":true},{"text":"I asaa bolla suure pirdana” yaagite.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Saloti ufayto; sa7ika hashshu go;","poem":1},{"text":"abbaynne iya giddon de7iya ubbay guummo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Goshshaynne iyan de7iya ubbay ufayto!","poem":1},{"text":"Woran de7iya mitha ubbay ufaysan yexo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Goday yaa gisho iya sinthan yexo;","poem":1},{"text":"I sa7a bolla pirdanaw yees.","poem":2},{"text":"I ha sa7aa bolla xillotethan,","poem":1},{"text":"asaa bolla tumatethan pirdana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}