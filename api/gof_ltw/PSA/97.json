{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":97,"content":[{"type":"heading","content":["Xoossay Ubbaa Bolla Godaa"]},{"type":"verse","number":1,"content":["Goday kawotida gisho sa7an de7iya asay ufayto;",{"text":"yuushoy abban teqetida biittati ufayto.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Shaarinne sakana dhumi iya yuushuwan de7ees;","poem":1},{"text":"Xillotethinne tumatethi iya araata baaso.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tami iya sinthara bees;","poem":1},{"text":"iya yuushuwan de7iya morketa xuuggees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iya wol7anthay bitta ubbaa poo7isees;","poem":1},{"text":"biittay hessa be7idi kokorees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dereti Godaa sinthan,","poem":1},{"text":"sa7aa ubbaa Godaa sinthan muqaadada til7idosona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Saloti iya xillotethaa awaajosona;","poem":1},{"text":"asa ubbay iya bonchuwa be7oosona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Eeqata goyinneysatinne","poem":1},{"text":"entan ceeqeteysati ubbay yeellato;","poem":2},{"lineBreak":true},{"text":"eeqati ubbay Godaas gulbato.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abeeti Godaw, Xiyooney","poem":1},{"text":"ne xillo pirdaa si7idi ufaytees;","poem":2},{"lineBreak":true},{"text":"Yihuda macca naytika hashshu goosona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abeeti Godaw, neeni sa7a ubba bolla dhoqa;","poem":1},{"text":"xoossata ubbaafe neeni dhoqu gadasa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Godaa doseysato, iitaa ixite;","poem":1},{"text":"iyan ammaneteyisata shempuwa I naagees;","poem":2},{"lineBreak":true},{"text":"iitata kushepe enta ashshees.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Xillota bolla poo7oy poo7ees;","poem":1},{"text":"wozana suuretas ufaysi de7ees.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hinteno xilloto, Godan ufaytite;","poem":1},{"text":"iya geeshsha sunthaa galatite.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}