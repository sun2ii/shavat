{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":98,"content":[{"type":"heading","content":["Xoossas Ufaysan Ililite"]},{"type":"hebrew_subtitle","content":["Mazmure"]},{"type":"verse","number":1,"content":["Goday malaalsiyaba oothida gisho,",{"text":"iyaw ooratha mazmure yexite.","poem":2},{"lineBreak":true},{"text":"Iya ushacha kushey, iya geeshsha qesey","poem":2},{"lineBreak":true},{"text":"iyaw xoono immis.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Goday ba xoonuwa erisis;","poem":1},{"text":"ba xillotethaa kawotethatas qoncisis.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"I Isra7eele asaa siiqeysanne","poem":1},{"text":"entaw ammaneteysa hassayis.","poem":2},{"text":"Sa7aa gaxaa gakanaw de7iya asa ubbay","poem":1},{"text":"nu Xoossaa atotetha be7idosona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sa7a bolla de7iya asaw,","poem":1},{"text":"Godaas ufaysan yexite;","poem":2},{"lineBreak":true},{"text":"ufaysan ililishe sabbite.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Godaas diithi diixite;","poem":1},{"text":"diithaninne mazmuren Godaa sabbite.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Suusul7enne moyze punnishe,","poem":1},{"text":"ufaysan Godaa nu kawa sinthan yexite.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abbaynne abba giddon kumida ubbay guummo;","poem":1},{"text":"Sa7aynne sa7aa bolla de7iya ubbay yexo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Shaafati banta kushiya baqo;","poem":1},{"text":"zumati issife Godaa sinthan ufaysan yexo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Goday sa7aa bolla pirdanaw yees;","poem":1},{"text":"I ha sa7aa bolla xillotethan","poem":2},{"lineBreak":true},{"text":"asaa bolla suuretethan pirdana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}