{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"PSA","translationId":"gof_ltw","name":"Mazmure Maxaafa","commonName":"Mazmure Maxaafa","title":"Mazmure Maxaafa","order":19,"numberOfChapters":150,"sha256":"73438323ab41ea9f2fc6255dba1048b14f906ae31553f8e416e6d3c547882ede","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gof_ltw/PSA/150.json","totalNumberOfVerses":2458},"chapter":{"number":99,"content":[{"type":"heading","content":["Nu Xoossay Geeshshi"]},{"type":"verse","number":1,"content":["Goday kawotida gisho kawotethati kokoro;",{"text":"araata bolla Kiruubeta giddon uttida gisho;","poem":2},{"lineBreak":true},{"text":"biittay qaaxo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Goday Xiyoonen gita;","poem":1},{"text":"kawotethaa ubbaafe","poem":2},{"lineBreak":true},{"text":"I dhoqu dhoqu gis.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yashshiya iya gita sunthaa ubbay galato;","poem":1},{"text":"I geeshshi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Neeni, wolqaama kawoy suure pirda dosaasa.","poem":1},{"text":"Neeni Yayqooba suuretethan minthadasa.","poem":2},{"lineBreak":true},{"text":"Xillotethi essadasa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Godaa, nu Xoossaa dhoqu dhoqu oothite;","poem":1},{"text":"iya tohoy yedhiya bessan iya goyinnite;","poem":2},{"lineBreak":true},{"text":"I geeshshi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Museynne Aaroni iya kahineta giddofe koyrota;","poem":1},{"text":"Sameeli iya woossidaysatape issuwa.","poem":2},{"lineBreak":true},{"text":"Enti Godaako waassidosona;","poem":2},{"lineBreak":true},{"text":"I enta si7is.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I shaara tuussaa giddora entaw haasayis;","poem":1},{"text":"I immida higgiyanne wogaa naagidosona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abeeti Godaw, nu Xoossaw,","poem":1},{"text":"ne enta woosa si7adasa.","poem":2},{"text":"Ne entana maaradasa;","poem":1},{"text":"gidoshin, enta nagara gisho enta seeradasa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Goday nu Xoossay, geeshshi gidiya gisho,","poem":1},{"text":"iya dhoqu dhoqu oothite;","poem":2},{"lineBreak":true},{"text":"iya geeshsha zumaa bolla iya goyinnite.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}