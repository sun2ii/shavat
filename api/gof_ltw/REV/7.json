{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"REV","translationId":"gof_ltw","name":"Yohaanisa Qoncethi","commonName":"Yohaanisa Qoncethi","title":"Yohaanisa Qoncethi","order":66,"numberOfChapters":22,"sha256":"276437b65de6387f23abf448bbd3514d35b98c821926369351f1e55143ba15ca","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/gof_ltw/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":7,"content":[{"type":"heading","content":["144, 000 Asati Maletidosona"]},{"type":"verse","number":1,"content":["Hessafe guye, oyddu kiitanchoti oyddu sa7aa gaxan eqidaysata be7as. He kiitanchoti sa7a bolla woyko abba bolla woyko ay mitha bolla carkoy oyddu sa7aa gaxape carkonna mela teqidosona."]},{"type":"verse","number":2,"content":["Qassi de7o Xoossaa maatamiya oykida hara kiitanchoy doloha baggafe keyeysa be7as. He kiitanchoy ba qaala dhoqu oothidi, sa7aanne abba qohanaw wolqi imetida oyddu kiitanchota,"]},{"type":"verse","number":3,"content":["xeegidi, “Nuuni Xoossaa aylleta som7on maatamiya wothana gakanaw biitta woyko abba woyko mithaa qohopite” yaagis."]},{"type":"verse","number":4,"content":["Yaatin, taani Xoossaa maatamey som7on wosetidaysata payduwa si7as. Isra7eele mayzata ubbaafe 144000 asaas som7on maatame wothis."]},{"type":"verse","number":5,"content":[{"text":"Yihuda kochaafe tammanne nam7u mukulu,","poem":1},{"lineBreak":true},{"text":"Robeela kochaafe tammanne nam7u mukulu,","poem":1},{"lineBreak":true},{"text":"Gaade kochaafe tammanne nam7u mukulu,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aseera kochaafe tammanne nam7u mukulu,","poem":1},{"lineBreak":true},{"text":"Niftaaleme kochaafe tammanne nam7u mukulu,","poem":1},{"lineBreak":true},{"text":"Minaase kochaafe tammanne nam7u mukulu,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Simoona kochaafe tammanne nam7u mukulu;","poem":1},{"lineBreak":true},{"text":"Leewe kochaafe tammanne nam7u mukulu,","poem":1},{"lineBreak":true},{"text":"Yisakoora kochaafe tammanne nam7u mukulu,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Zabloona kochaafe tammanne nam7u mukulu,","poem":1},{"lineBreak":true},{"text":"Yoosefa kochaafe tammanne nam7u mukulu,","poem":1},{"lineBreak":true},{"text":"Biniyaame kochaafe tammanne nam7u mukulu,","poem":1},"asaa som7on maatame wothis."]},{"type":"heading","content":["Bootha Ma7o Ma7ida Asata"]},{"type":"verse","number":9,"content":["Hessafe guye, koche ubbaafe, kawotetha ubbaafe, yara ubbaafenne dumma dumma doonape zawi bayna daro asaa be7as. He asay bootha ma7o ma7idi, zamba haythi banta kushen oykidi, araata sinthaninne Dorsa sinthan eqidosona."]},{"type":"verse","number":10,"content":["Enti banta qaala dhoqu oothidi, “Atotethay araatan uttida nu Xoossaafenne Dorsaafe yees” yaagidosona."]},{"type":"verse","number":11,"content":["Kiitanchoti ubbay araata, cimatanne oyddu medhetethata yuushuwan eqidosona. Enti araata sinthan gufannidi Xoossaa goyinnidosona."]},{"type":"verse","number":12,"content":[{"text":"“Amin7i!","poem":1},{"text":"Anjoy, bonchoy, cincatethi, galati, sabi","poem":2},{"lineBreak":true},{"text":"wolqi, minotethi meri merinaw nu Xoossaas gido.","poem":2},{"text":"Amin7i!”","poem":1},"yaagidosona."]},{"type":"verse","number":13,"content":["Cimatape issoy taako, “Ha bootha ma7uwa ma7ida asati oonantee? Enti awupe yidona?” yaagidi oychis."]},{"type":"verse","number":14,"content":["Taani zaarada, “Godaw, ne eraasa” yaagas. Ika taako, “Haysati daro waaye waaydi aadhidaysata. Enti banta ma7uwa Dorsa suuthan meeccidi geeshshidosona."]},{"type":"verse","number":15,"content":["Hessa gisho,",{"text":"enti Xoossaa araata sinthan gididi","poem":2},{"lineBreak":true},{"text":"qammanne gallas iya keethan oothosona;","poem":2},{"lineBreak":true},{"text":"araata bolla uttidaysi entaw kuya gidana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hizape guye, enti koshatokona, saamotokona.","poem":1},{"text":"Awi woyko mishi enta meenna.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Araata giddon uttida Dorsay enta heemmana.","poem":1},{"text":"De7o pulto haathaako enta kaalethana.","poem":2},{"text":"Xoossay enta ayfepe afutha ubbaa quchana”","poem":1},"yaagis."]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/REV/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/REV/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/REV/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}