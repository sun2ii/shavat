{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"SNG","translationId":"gof_ltw","name":"Solomone Mazmure Maxaafa","commonName":"Solomone Mazmure Maxaafa","title":"Solomone Mazmure Maxaafa","order":22,"numberOfChapters":8,"sha256":"083aa98d676e998b96b8f83aad8b3f590aadb0f3266c0f1ba0d4f1c8f0169df6","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gof_ltw/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Mazmure ubbaafe aadhiya Solomone mazmurey haysa."]},{"type":"line_break"},{"type":"heading","content":["Geela7iw"]},{"type":"verse","number":2,"content":[{"text":"Ne siiqoy woynepe aadhidi ufaysiya gisho","poem":1},{"text":"tana zaara zaara yeera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne tiyetiya shittoy waanidi sawii!","poem":1},{"text":"Ne sunthay goggiya shitto mela;","poem":2},{"lineBreak":true},{"text":"Geela7oti nena siiqey hessasa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tana neera ekada ba; ane issife woxoos!","poem":1},{"text":"Kawaw, tana ne quruxuwan gelsa.","poem":2},{"lineBreak":true},"Yerusalaame maccasata",{"text":"Nenan nu ufaytoos;","poem":1},{"text":"ne siiquwa woyne ushshafe aathidi nashshoos.","poem":2},{"lineBreak":true},{"text":"Maccasi ubbay nena siiqeysa bessa.","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Geela7iw"]},{"type":"verse","number":5,"content":[{"text":"Hinteno, Yerusalaame maccasato si7ite;","poem":1},{"text":"taani kareethi gidikoka mala lo77o.","poem":2},{"text":"Ta kareethatethay Qedaare dunkaane mela;","poem":1},{"text":"shin ta malay Solomone magarajota mela.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ta malaa kareethiday awa;","poem":1},{"text":"taani kareethi gidida gisho tana boropite.","poem":2},{"text":"Ta ishati, ta aaye nayti taara ooyetidi,","poem":1},{"text":"tana woyne gade naagisidosona;","poem":2},{"lineBreak":true},{"text":"hessa gisho ta woyniya naagabike.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta siiquwaw, ane taw oda;","poem":1},{"text":"ne dorsaa wudiya awun heemmay?","poem":2},{"lineBreak":true},{"text":"Seeta gallas enta awun shempisay?","poem":2},{"text":"Nena demmanaw ne laggeta wudiya kaallada,","poem":1},{"text":"ayis guuluntada biya maccas gido?","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Panthaa"]},{"type":"verse","number":8,"content":[{"text":"Maccasa ubbaafe lo77iyare,","poem":1},{"text":"Bessaa eronna ixiko dorsata geedo kaalla.","poem":2},{"text":"Ne deesha marata henthanchota","poem":1},{"text":"dunkaaniya matan heemma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":["Ta siiqe! Gibxe kawo para gaareta goochiya,",{"text":"parata giddon de7iya magaayeda lo77aasa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne haythan de7iya alleequwara shiiqidi,","poem":1},{"text":"ne shakalay waanidi lo77i!","poem":2},{"lineBreak":true},{"text":"Ne qoodhey al7o shuchan alleeqetis.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nuuni new biran cadetida,","poem":1},{"text":"worqa alleequwa oosisana.","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Geela7iw"]},{"type":"verse","number":12,"content":[{"text":"Kawoy gayta bolla uttidashin,","poem":1},{"text":"ta shittuwa sawoy keethan tonku gis.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ta siiqoy ta dhanthata giddon de7iya,","poem":1},{"text":"xuntetida sawiya karbe daanees.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ta siiqoy, Engaada woyne gaden,","poem":1},{"text":"dolida heena ciishsha mela.","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Panthaa"]},{"type":"verse","number":15,"content":["Ta siiqe, neeni waana lo77ay!",{"text":"Neeni waana lo77ay!","poem":2},{"lineBreak":true},{"text":"Ne ayfeti holle ayfeda lo77oosona.","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Geela7iw"]},{"type":"verse","number":16,"content":[{"text":"Ta siiquwaw, neeni waanna lo77ay!","poem":1},{"text":"Ayba ufaysay;","poem":2},{"lineBreak":true},{"text":"nu arsay cil7o maata mela ufaysees.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nu keethaa tuussay ziga;","poem":1},{"text":"nu kaaray xiiddan oyketis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}