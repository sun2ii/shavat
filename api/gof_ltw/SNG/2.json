{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"SNG","translationId":"gof_ltw","name":"Solomone Mazmure Maxaafa","commonName":"Solomone Mazmure Maxaafa","title":"Solomone Mazmure Maxaafa","order":22,"numberOfChapters":8,"sha256":"083aa98d676e998b96b8f83aad8b3f590aadb0f3266c0f1ba0d4f1c8f0169df6","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gof_ltw/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"heading","content":["Geela7iw"]},{"type":"verse","number":1,"content":[{"text":"Taani Saaronan doliya ciishshanne","poem":1},{"text":"zangaaran doliya suufe ciishsha mela.","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Panthaa"]},{"type":"verse","number":2,"content":[{"text":"Ta siiqiya maccasa giddon be7iya wode,","poem":1},{"text":"aguntha giddon bentiya suufe ciishsha mela.","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Geela7iw"]},{"type":"verse","number":3,"content":[{"text":"Ta siiqoy hara panthata giddon xeelliya wode","poem":1},{"text":"woran de7iya apile mithaa mela.","poem":2},{"text":"Tana daro ufaysin, iya kuyaa giddon uttas;","poem":1},{"text":"iya ayfey min tana mal7ees.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I tana gibira miya keethi gelsis;","poem":1},{"text":"ba siiquwa bandirada ta bolla dhoqu dhoqu oothis.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Taani iya siiquwan oyketada hargida gisho,","poem":2},{"lineBreak":true},{"text":"zabibe ayfe muzidi tana gashtisite;","poem":2},{"lineBreak":true},{"text":"apile muzidi ta wolqaa minthite.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ba haddirsa kushiya tana borkotisis;","poem":1},{"text":"ba ushacha kushiyan tana qoommis.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hinteno, Yerusalaame yalaga maccasaw,","poem":1},{"text":"siiqoy baw dosidi dendana gakanaw,","poem":2},{"lineBreak":true},{"text":"iya hinte barkethonna mela,","poem":2},{"lineBreak":true},{"text":"ta hintena gen7eninne wora woshi7en ammatayis.","poem":2}]},{"type":"verse","number":8,"content":["Ta siiquwa girsay deriya bollara gupishenne,",{"text":"zumaa bollara xongetishe yeysi si7etees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ta siiqoy woshi7e woyko gen7e mari daanees;","poem":1},{"text":"Heko, nu keethaa matan eqis;","poem":2},{"lineBreak":true},{"text":"maskootera soo xeellees;","poem":2},{"lineBreak":true},{"text":"magarajuwa giddora xeellees.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta siiqoy, haysada yaagees;","poem":1},{"text":"“Ta siiqe, denda!","poem":2},{"lineBreak":true},{"text":"Ta yegelsse, haaya, issife ane boos.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Heko, balgoy aadhis;","poem":1},{"text":"irayka eqis.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Biittan ciishshi ciiyis;","poem":1},{"text":"yethi yexiya ageenay gakis;","poem":2},{"lineBreak":true},{"text":"holle yethi nu biittan si7etis.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Balase mithay ayfe doomis;","poem":1},{"text":"woyney ciiyis;","poem":2},{"lineBreak":true},{"text":"ciishsha sawoy biittan tonku gees.","poem":2},{"text":"Ta siiqe, denda; ta yegelsse,","poem":1},{"text":"haaya; ane issife boos.”","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Panthaa"]},{"type":"verse","number":14,"content":[{"text":"Aafo doonan zaalla qophon,","poem":1},{"text":"qosetida holle daaniyare;","poem":2},{"lineBreak":true},{"text":"ane issi toho tana ne som7uwa bessa;","poem":2},{"lineBreak":true},{"text":"ne girsa sissa.","poem":2},{"text":"Ne qaalay tana mal7ees;","poem":1},{"text":"ne som7oy daro lo77ees.","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Yerusalaame Geela7ota"]},{"type":"verse","number":15,"content":[{"text":"Nu woyney ciiyis;","poem":1},{"text":"nu woyne gadiya iissiya workanata,","poem":2},{"lineBreak":true},{"text":"he guutha butaleta xihen oykite.","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Geela7iw"]},{"type":"verse","number":16,"content":[{"text":"Ta siiqoy tabaa; taanika iyabaa;","poem":1},{"text":"ciishshata giddon I ba wudiya heemmees.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sa7i geeyana gakanaw,","poem":1},{"text":"kuyay dhayana gakanaw,","poem":2},{"lineBreak":true},{"text":"ta siiquwaw, gen7eda woyko woshi7e marada,","poem":2},{"lineBreak":true},{"text":"aafotiya deriyara woxashe haa simma.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}