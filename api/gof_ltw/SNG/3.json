{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"SNG","translationId":"gof_ltw","name":"Solomone Mazmure Maxaafa","commonName":"Solomone Mazmure Maxaafa","title":"Solomone Mazmure Maxaafa","order":22,"numberOfChapters":8,"sha256":"083aa98d676e998b96b8f83aad8b3f590aadb0f3266c0f1ba0d4f1c8f0169df6","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gof_ltw/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"heading","content":["Geela7iw"]},{"type":"verse","number":1,"content":[{"text":"Qamma kumethi hiixan zin7ada,","poem":1},{"text":"ta siiquwa demmanaw amottas;","poem":2},{"lineBreak":true},{"text":"minthada koyas; shin demmabike.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Katamaa giddon de7iya dalganne","poem":1},{"text":"xuntha ogeta ubban yuuyas.","poem":2},{"lineBreak":true},{"text":"Ta siiquwa demmanaw koyas;","poem":2},{"lineBreak":true},{"text":"minthada koyas; shin demmanaw danda7abike.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Katamaa yuuyidi naageysati tana demmidosona;","poem":1},{"text":"taani, “Ta siiquwa be7idetii?” yaagada oychas.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Enta aggada aadhida mela ta siiquwa demmas;","poem":1},{"text":"I taape kessi ekonnaada minthada oykas.","poem":2},{"text":"Ta aaye soo efas;","poem":1},{"text":"ta yeletida kifiliya gelsas.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hinteno Yerusalaame macca nayto,","poem":1},{"text":"siiqoy baw dosidi dendana gakanaw,","poem":2},{"lineBreak":true},{"text":"iya hinte barkisonna mela","poem":2},{"lineBreak":true},{"text":"taani hintena gen7eninne woshi7en ammatayis.","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Yerusalaame Geela7ota"]},{"type":"verse","number":6,"content":[{"text":"Zal7ancho ixaanedanne karbeda sawiyara,","poem":1},{"text":"cuya tuussu daaniyara,","poem":2},{"lineBreak":true},{"text":"hanna mela biittafe yaara iya oonee?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Heko, Solomone para gaariya yawusu;","poem":1},{"text":"he para gaariw Isra7eelepe dooretida,","poem":2},{"lineBreak":true},{"text":"usupun tammu wolqaama tooranchoti ajabidosona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Enti ubbay mashsha oythan meezetidosona;","poem":1},{"text":"olanka paacetidosona.","poem":2},{"text":"Qamma gakiya metuwa teqanaw,","poem":1},{"text":"enti mashshe dancidi giigidosona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kawa Solomoney para gaare giddon,","poem":1},{"text":"baw uttiya araata giigisis;","poem":2},{"lineBreak":true},{"text":"iya araatay Libaanosepe yida mithan oosetis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Araata tuussay biran lanxetis;","poem":1},{"text":"zempoy worqan alleeqetis.","poem":2},{"text":"Oydey ocha teera daaniya qacinan kametis;","poem":1},{"text":"gaathay Yerusalaame geela7ota siiqon alleeqetis.","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Geela7iw"]},{"type":"verse","number":11,"content":[{"text":"Hinteno, Xiyoone geela7oto,","poem":1},{"text":"kawa Solomone be7anaw haayite.","poem":2},{"text":"I daro ufaytida iya yaaganuwa gallas","poem":1},{"text":"iya aayiya iya huuphen wothida kallacha wothis.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}