{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"SNG","translationId":"gof_ltw","name":"Solomone Mazmure Maxaafa","commonName":"Solomone Mazmure Maxaafa","title":"Solomone Mazmure Maxaafa","order":22,"numberOfChapters":8,"sha256":"083aa98d676e998b96b8f83aad8b3f590aadb0f3266c0f1ba0d4f1c8f0169df6","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gof_ltw/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"heading","content":["Panthaa"]},{"type":"verse","number":1,"content":["Ta siiqe, neeni waana lo77ay!",{"text":"Neeni waanida yegelsse!","poem":2},{"text":"Ne ayfeti guulunthaa giddora be7iya wode,","poem":1},{"text":"holleda lo77oosona.","poem":2},{"text":"Ne binaanay Galada zumaape","poem":1},{"text":"wodhiya deesha wude daanees.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne achay meedetidi haathan meecetida,","poem":1},{"text":"ubbay mente yeliya,","poem":2},{"lineBreak":true},{"text":"enta giddon awucayey bayna dorsa wude mela.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne mettershay zo7o qacina daanees;","poem":1},{"text":"ne haasaya wode daro ufaysoosona.","poem":2},{"text":"Ne nam7u shakalay guulunthaa giddora xeelliya wode,","poem":1},{"text":"nam7a kessidi phalqida oromaane daanosona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne qoodhey loythi oothida,","poem":1},{"text":"iya bolla olanchota gondalley de7iya,","poem":2},{"lineBreak":true},{"text":"mukulu mino olanchota gondalley kaqetida,","poem":2},{"lineBreak":true},{"text":"Dawita adussa gimbiya daanees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne nam7u dhanthati mente yeletida,","poem":1},{"text":"lo77o ciishshata giddon","poem":2},{"lineBreak":true},{"text":"miya woshi7e marata daanosona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sa7i geeyanaape sinthe,","poem":1},{"text":"dhumay kichanaape sinthe,","poem":2},{"lineBreak":true},{"text":"karbe deriyanne ixaane zuma bada shempana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta siiqe, ne asatethay kumethi lo77o;","poem":1},{"text":"nenan boretiyabay baawa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ta mushurate, Libaanosepe haaya;","poem":1},{"text":"Gaammoy pee7iya, maahey aqiya,","poem":2},{"text":"Amaana zumaape, Sanira liiphepe","poem":1},{"text":"Armoona huuphiyape wodha.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ta siiqe, micho gidida ta mushurate;","poem":1},{"text":"ne ayfiya xeeloynne ne qoodhiya alleeqoy,","poem":2},{"lineBreak":true},{"text":"ta wozanaa ufaysan gooshshis.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ta siiqo micho gidida ta mushurate!","poem":1},{"text":"Ne siiqoy tana waani ufaysi!","poem":2},{"text":"Ne siiqoy woyne ushshafe aadhidi ufaysees;","poem":1},{"text":"ne shittoy ubbaafe aadhidi sawees.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ta mushurate, ne mettershafe ililo eessi xokees;","poem":1},{"text":"Ne doonape eessinne maathi pultees;","poem":2},{"lineBreak":true},{"text":"ne ma7oy Libaanose shittoda sawees.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ta siiqo micho gidida ta mushurate,","poem":1},{"text":"ne yuushoy diretidi naagetiya atakilte bessa mela;","poem":2},{"lineBreak":true},{"text":"ne haratas gordetida, taw dooyetida pulto mela.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Neeni atakilte giddon,","poem":1},{"text":"oromaaney, dooretida atakilte ayfeti,","poem":2},{"lineBreak":true},{"text":"nardoose geetetiya ayfeti de7iya bessa mela.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nardoosey, laadey, sawiya maati, qarafin,","poem":1},{"text":"ixaanada sawiyabati de7oosona.","poem":2},{"text":"Karbey, godare uutha ciishshinne","poem":1},{"text":"dumma dumma qimame atakilteti doloosona.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Neeni atakilte bessa ushshiya pulto mela;","poem":1},{"text":"de7o haathi bentiya olla mela;","poem":2},{"lineBreak":true},{"text":"Libaanose zumaape goggiya shaafa mela.","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Geela7iw"]},{"type":"verse","number":16,"content":[{"text":"Pudeha bagga carkuwaw, denda!","poem":1},{"text":"dugeha bagga carkuwaw, haaya!","poem":2},{"text":"Ta atakiltiya bolla carka!","poem":1},{"text":"iya sawoy tonku go.","poem":2},{"text":"Ta siiqoy ba atakiltiya giddo yo;","poem":1},{"text":"daro mal7iya ayfeta mo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}