{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"SNG","translationId":"gof_ltw","name":"Solomone Mazmure Maxaafa","commonName":"Solomone Mazmure Maxaafa","title":"Solomone Mazmure Maxaafa","order":22,"numberOfChapters":8,"sha256":"083aa98d676e998b96b8f83aad8b3f590aadb0f3266c0f1ba0d4f1c8f0169df6","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gof_ltw/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"heading","content":["Panthaa"]},{"type":"verse","number":1,"content":[{"text":"Ta miche, ta mushurate,","poem":1},{"text":"taani ta atakiltiya giddo gelas.","poem":2},{"text":"Ta karbiyanne ta shitto ciishsha qoras;","poem":1},{"text":"taani eessa uythi mas;","poem":2},{"lineBreak":true},{"text":"ta woyniyanne ta maatha uyas.","poem":2},{"lineBreak":true},"Yerusalaame Geela7ota",{"lineBreak":true},{"text":"Iya laggeto, miite uyite;","poem":1},{"text":"siiqo alana gakanaw uyite.","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Geela7iw"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Taani dhiskas; shin ta wozanay barkis;","poem":1},{"text":"ta siiqoy haysada yaagidi pengiya qonkishin si7as.","poem":2},{"text":"“Ta miche, ta siiqe, ta yegelsse;","poem":1},{"text":"borey bayna ta holle,","poem":2},{"lineBreak":true},{"text":"taw pengiya dooya.","poem":2},{"text":"Ta huuphey akan laakis;","poem":1},{"text":"ta binaanay qamma puusen irxis.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ta ma7uwa qaaras, zaarada ma7oyee?","poem":1},{"text":"Ta tohuwa meecetas, zaarada qitayoyee?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ta siiqoy ibitha xoo7era ba kushiya soo yeddis;","poem":1},{"text":"ta wozanay iya gisho seellees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ta siiquwas dooyanaw dendas;","poem":1},{"text":"pengiya dooyanaw kobiya oykiya wode,","poem":2},{"lineBreak":true},{"text":"ta kushiyape karbey,","poem":2},{"lineBreak":true},{"text":"ta biradhiyafe shittoy xokees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ta siiquwas kariya dooyas, shin I deenna;","poem":1},{"text":"iya qaala si7anaw daro amottas.","poem":2},{"text":"Minthada koyas, shin iya demmabike;","poem":1},{"text":"xeegas, shin taw koybeenna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Katamaa naageysati tana demmidi,","poem":1},{"text":"wadhidosona; madunxisidosona.","poem":2},{"text":"Katamaa dirsaa naageysati,","poem":1},{"text":"ta laxana qaari ekidosona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hinteno, Yerusalaame geela7oto,","poem":1},{"text":"ta siiquwa demmiko,","poem":2},{"lineBreak":true},{"text":"taani iya siiquwan hargidaysa,","poem":2},{"lineBreak":true},{"text":"hadara iyaw odite.","poem":2}]},{"type":"heading","content":["Yerusalaame Geela7ota"]},{"type":"verse","number":9,"content":[{"text":"Neno, maccasa ubbaafe lo77iyara,","poem":1},{"text":"ne laggey haratape waanidi dummatii?","poem":2},{"text":"Neeni nuna hadara gey,","poem":1},{"text":"I haratape aybin dummatii?","poem":2}]},{"type":"heading","content":["Geela7iw"]},{"type":"verse","number":10,"content":[{"text":"Ta siiqoy mala lo77onne ayanta;","poem":1},{"text":"tammu mukulu addeta giddon iya meli baawa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Iya huuphey al7o worqa daanees;","poem":1},{"text":"iya binaanay lo77onne quuro mela kareethi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Iya ayfey shaafa matan eqida,","poem":1},{"text":"maathan meecetida holleta daanees.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Iya shakalay sawiya qimamey toketida madabeda lo77ees;","poem":1},{"text":"iya mettershay karbe shittoy xokiya wora ciishshada lo77ees.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iya qesey al7o shuchan alleeqetida worqa xam7ada lo77ees;","poem":1},{"text":"iya asatethay sanpare al7o shuchan alleeqetida dangarsa zaale mela.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Iya tohoti worqa baason eqida salo shucha tuussi daanosona;","poem":1},{"text":"iya malay zigan alleeqetida Libaanose zuma mela.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Iya doonay eessada mal7ees;","poem":1},{"text":"iya kumetha asatethay lo77ees.","poem":2},{"text":"Hinteno Yerusalaame geela7oto,","poem":1},{"text":"ta siiqoynne ta laggey haysa daannes.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}