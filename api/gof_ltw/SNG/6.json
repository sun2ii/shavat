{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"SNG","translationId":"gof_ltw","name":"Solomone Mazmure Maxaafa","commonName":"Solomone Mazmure Maxaafa","title":"Solomone Mazmure Maxaafa","order":22,"numberOfChapters":8,"sha256":"083aa98d676e998b96b8f83aad8b3f590aadb0f3266c0f1ba0d4f1c8f0169df6","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gof_ltw/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"heading","content":["Yerusalaame Geela7ota"]},{"type":"verse","number":1,"content":[{"text":"Maccasa ubbaafe lo77iyare, ne laggey awu bidee?","poem":1},{"text":"Nu neera koyana mela I bida gina nuus oda.","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Geela7iw"]},{"type":"verse","number":2,"content":[{"text":"Ta siiqoy dorsa wude heemmanaw,","poem":1},{"text":"lo77o ciishsha shiishanaw,","poem":2},{"lineBreak":true},{"text":"shitto maatay de7iya atakiltiya giddo bis.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taani ta siiquwaba; ta siiqoy tabaa;","poem":1},{"text":"I ciishsha giddon wude heemmees.","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Panthaa"]},{"type":"verse","number":4,"content":[{"text":"Ta siiqe, ne Tirsa katameeda lo77aasa;","poem":1},{"text":"Yerusalaameda daro lo77aasa.","poem":2},{"text":"Bandira oykidi salpiya,","poem":1},{"text":"olanchoda yashshaasa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Enti tana un7ethida gisho,","poem":1},{"text":"hayyana ne ayfiya taape dentha.","poem":2},{"text":"Ne binaanay Galada zumaape wodhiya,","poem":1},{"text":"deesha wude daanees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne achay meecetidi keyiya,","poem":1},{"text":"ubbay mente yeliya,","poem":2},{"lineBreak":true},{"text":"enta giddon awucayey bayna dorsa wude mela.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne nam7u shakalay guulunthaa giddora xeelliya wode,","poem":1},{"text":"nam7u kessidi phalqida oromaane daanosona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Usupun tammu macca kawoti,","poem":1},{"text":"hospun tammu laggethoti,","poem":2},{"lineBreak":true},{"text":"tayboy bayna geela7oti de7oosona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Shin borey bayna ta holliya taw dumma;","poem":1},{"text":"iya ba aayes issinno.","poem":2},{"text":"Iyo yelida aayiya ubbaafe aathada iyo dosawusu;","poem":1},{"text":"Geela7oti iyo be7idi, “Hanna anjetidaaro” yaagosona;","poem":2},{"lineBreak":true},{"text":"macca kawotinne laggethoti iyo sabboosona.","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Yerusalaame Geela7ota"]},{"type":"verse","number":10,"content":[{"text":"Hanna wonta xalqeda doliyara,","poem":1},{"text":"ageenada poo7iyara, xalqeda caddiyara,","poem":2},{"lineBreak":true},{"text":"bandira oykidi salpe keyida,","poem":2},{"lineBreak":true},{"text":"olanchoda yashshiyara hanna oonee?","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Panthaa"]},{"type":"verse","number":11,"content":[{"text":"Taani zangaaran toketida mithata be7anaw,","poem":1},{"text":"woyney aacidako oromaaney ayfidaako xeellanaw,","poem":2},{"lineBreak":true},{"text":"duge ocholone gade wodhas.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ta qoponna de7ishin ta amoy tana efidi,","poem":1},{"text":"kawa asaa para gaareta giddon tana utisis.","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Yerusalaame Geela7ota"]},{"type":"verse","number":13,"content":[{"text":"Neno Sulaamape yidaare, haaya; haa simma;","poem":1},{"text":"Nu nena loythidi xeellana mela haa simma.","poem":2},{"lineBreak":true},"Geela7iw",{"text":"Daro asaa sinthan yexiya asada,","poem":1},{"text":"tana ayis xeelleetii?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}