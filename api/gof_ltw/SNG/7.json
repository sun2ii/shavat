{"translation":{"id":"gof_ltw","name":"Geeshsha Maxaafa","website":"https://ebible.org/Scriptures/details.php?id=gofl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofl","licenseNotes":null,"shortName":"LTW","englishName":"Gofa Bible Latin","language":"gof","textDirection":"ltr","sha256":"a152d3ef6312652108cc3aaf4d1c8f68bc1f121d9676ccc2ad756ff887334ea0","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_ltw/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30977,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"SNG","translationId":"gof_ltw","name":"Solomone Mazmure Maxaafa","commonName":"Solomone Mazmure Maxaafa","title":"Solomone Mazmure Maxaafa","order":22,"numberOfChapters":8,"sha256":"083aa98d676e998b96b8f83aad8b3f590aadb0f3266c0f1ba0d4f1c8f0169df6","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_ltw/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/gof_ltw/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"heading","content":["Panthaa"]},{"type":"verse","number":1,"content":[{"text":"Kawo na7ada lo77iyare,","poem":1},{"text":"Laxana caamma aathida ne tohoti waani lo77i!","poem":2},{"text":"Ne sheechey hiillanchoy qoxidi,","poem":1},{"text":"alleeqisida al7o shuchu daanees.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne gul7ay woyney kumida birille daanees;","poem":1},{"text":"ne xeessa yuushoy ciishshan qashetida giste mirqe daanees.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne dhanthati mente yeletida,","poem":1},{"text":"gen7e mari daanosona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne qoodhey dangarsa zaalen","poem":1},{"text":"alleeqetida adussa shako mela.","poem":2},{"text":"Ne ayfey gita Haseboona katama pengiya matan,","poem":1},{"text":"de7iya zeero haatha daanees.","poem":2},{"text":"Ne siidhey Damasqoko zaaridi gimbida,","poem":1},{"text":"Libaanose gimbiya daanees.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne huuphey Qarmeloosa zuma daanees;","poem":1},{"text":"ne binaanay qacina xaathi daanees;","poem":2},{"lineBreak":true},{"text":"ne huuphiya dathay kawa ufaysees.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ta siiqe, ne waanna lo77ay!","poem":1},{"text":"Ne waanida yegelsse!","poem":2},{"lineBreak":true},{"text":"Ne siiqoy tana waani ufaysi!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne geesay zamba daanees;","poem":1},{"text":"ne dhanthay zamba mor77e daanees.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Taani, “Zamba bolla keyana;","poem":1},{"text":"iya ayfiya maxana” yaagas.","poem":2},{"text":"Ne dhanthay woyne mor7e mela;","poem":1},{"text":"ne siidhiyara keya peenoy apileda sawees.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ne doonape keyiya peenoy","poem":1},{"text":"lo77o woyne mela.","poem":2},{"lineBreak":true},"Geela7iw",{"text":"Hiza lo77iya woyne ushshay,","poem":1},{"text":"ne siiqe mettershafenne achafe giddora,","poem":2},{"lineBreak":true},{"text":"lepi gidi goggo.","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Geela7iw"]},{"type":"verse","number":10,"content":[{"text":"Taani ta siiquwaba; ika tana amottees.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ta siiquwaw, haaya;","poem":1},{"text":"katamaape keyidi gaxare boos;","poem":2},{"lineBreak":true},{"text":"nam7ay qamma yan aathana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wonta guura woyne atakiltiya giddo boos;","poem":1},{"text":"woyney ciiyidaako, ayfe aathidako,","poem":2},{"lineBreak":true},{"text":"oromaaney ayfidaako ane be7oos.","poem":2},{"text":"Taani ta siiquwa nena yan bessaana.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Inkoye ayfe sawoynne","poem":1},{"text":"dumma dumma ufaysiya atakilte ayfey","poem":2},{"lineBreak":true},{"text":"nu karen kumis.","poem":2},{"text":"Ta siiquwaw! Ha ayfetape teeridaysanne","poem":1},{"text":"oorathi maxidaysa new wothas.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gof_ltw/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_ltw/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_ltw/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}