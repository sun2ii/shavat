{"translation":{"id":"gof_tbl","name":"ኦራꬃ ጫቁዋ ጎፋꬆ","website":"https://ebible.org/Scriptures/details.php?id=gofENT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofENT","licenseNotes":null,"shortName":"TBL","englishName":"Gofa NT (Ethiopic script)","language":"gof","textDirection":"ltr","sha256":"ddb8ea156f70a76543e0059c6139acad81a0a85ea8373db22cdb8f2a3e9b9f1d","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_tbl/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7931,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"MAT","translationId":"gof_tbl","name":"Maatoosa","commonName":"Maatoosa","title":"ማቶሲ ፃፊዳ ዬሱስ ኪሪስቶሳ ዎንጌላ Maatoosi Xaafida Yesuus Kiristtoosa Wonggelaa","order":40,"numberOfChapters":28,"sha256":"889d009e6aa8b1a637048b9ce317c137b37d0ffde1c27e478806e0889424e7b1","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_tbl/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/gof_tbl/MAT/28.json","totalNumberOfVerses":1068},"chapter":{"number":1,"content":[{"type":"heading","content":["Yesuusa yeletethaa susaa"]},{"type":"verse","number":1,"content":["Hayssafe kaallidi xaafettidayssi Dawite na7a Abrahame na7a gidida Yesuus Kiristtoosa yeletethaa."]},{"type":"verse","number":2,"content":["Abrahamey Yisaaqa yelis;",{"text":"Yisaaqi Yayqooba yelis;","poem":1},{"lineBreak":true},{"text":"Yayqoobi Yihudanne iya ishata yelis;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yihudi Ti7imaarippe Faaresenne Zaara yelis;","poem":1},{"lineBreak":true},{"text":"Faaresi Asroome yelis;","poem":1},{"lineBreak":true},{"text":"Asroomey Raame yelis;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Raamey Aminaadabe yelis;","poem":1},{"lineBreak":true},{"text":"Aminaadabey Na7asoona yelis;","poem":1},{"lineBreak":true},{"text":"Na7asooney Salmoona yelis;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Salmooney Ra7abippe Boo7eza yelis;","poem":1},{"lineBreak":true},{"text":"Boo7ezi Uruutippe Iyobeede yelis;","poem":1},{"lineBreak":true},{"text":"Iyobeedi Isseyye yelis;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Isseyyey kawuwa Dawite yelis;","poem":1},{"lineBreak":true},{"text":"Dawitey Ooriyo machcheefe Solomone yelis;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Solomoney Robi7aama yelis;","poem":1},{"lineBreak":true},{"text":"Robi7aamey Abiya yelis;","poem":1},{"lineBreak":true},{"text":"Abiyey Asaafe yelis;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asaafi Iyosaafexe yelis;","poem":1},{"lineBreak":true},{"text":"Iyosaafixey Iyoraame yelis;","poem":1},{"lineBreak":true},{"text":"Iyoraamey Ooziyane yelis;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ooziyaney Iyo7ataame yelis;","poem":1},{"lineBreak":true},{"text":"Iyo7ataamey Akkaza yelis;","poem":1},{"lineBreak":true},{"text":"Akkazi Hiziqiyasa yelis;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hiziqiyasi Minaase yelis;","poem":1},{"lineBreak":true},{"text":"Minaasey Amoona yelis;","poem":1},{"lineBreak":true},{"text":"Amooni Iyosiyaasa yelis;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Isra7eele asay di7ettidi Baabiloone biittaa bida wode Iyosiyaasi Ikoniyaananne iya ishata yelis.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Baabiloone biitta Isra7eele asay di7ettidi bidaappe guye Ikoniyaani Salatiyaale yelis.","poem":1},{"lineBreak":true},{"text":"Salatiyaaley Zerubaabela yelis;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zerubaabeli Abdiyu yelis;","poem":1},{"lineBreak":true},{"text":"Abdiyuy Eliyaaqeme yelis;","poem":1},{"lineBreak":true},{"text":"Eliyaaqemey Azaara yelis;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Azaari Sadooqe yelis;","poem":1},{"lineBreak":true},{"text":"Sadooqey Akiime yelis;","poem":1},{"lineBreak":true},{"text":"Akiimey Eliyuuda yelis;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Eliyuudi Alaazara yelis;","poem":1},{"lineBreak":true},{"text":"Alaazari Maatane yelis;","poem":1},{"lineBreak":true},{"text":"Maataney Yayqooba yelis;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yayqoobi Yoosefa yelis;","poem":1},{"lineBreak":true},{"text":"Yoosefi Kiristtoosa giya Yesuusa yelida Mayraami azina.","poem":1}]},{"type":"verse","number":17,"content":["Hiza, yeletethay Abrahameppe Dawite gakkanaw tammanne oydda. Dawiteppe bidi Baabiloone di7uwa gakkanaw tammanne oydda. Baabiloone di7uwappe bidi Kiristtoosa gakkanaw tammanne oyddu yeletethi gidees."]},{"type":"heading","content":["Yesuus Kiristtoosa yeletethaa"]},{"type":"verse","number":18,"content":["Yesuus Kiristtoosa yeletethaa taarikey hayssafe kaalleyssa. Iya aaya Mayraama Yoosefas oyshetta de7ashe Yoosefara gahettonna Geeshsha Ayyaanaappe qanthatasu."]},{"type":"verse","number":19,"content":["Yoosefi Xillo asi gidida gisho iyo asan kessanaw koyibeenna. Yaaniya gisho qosan iyo agganaw qoppis."]},{"type":"verse","number":20,"content":["I he qofan de7ishin Xoossaa kiitanchchoy amuhon qonccidi, “Dawite na7aw, Yoosefa, Mayraama qanthatiday Geeshsha Ayyaanaappe gidiya gisho iyo ekkanaw yayyofa” yaagis."]},{"type":"verse","number":21,"content":["Iya adde na7a yelana, I ba deriya entta nagaraappe ashshiya gisho iya sunthaa ne Yesuusa gada xeegana."]},{"type":"verse","number":22,"content":["Goday nabiya Isayaasa doonan,"]},{"type":"verse","number":23,"content":["“Hekko geela7iya qanthatana; adde na7akka yelana; iya sunthay Ammanu7eela geetettana” goyssi polettana mela ha ubbay hanis. Ammanu7eela geyssas birshshethay “Xoossay nuura de7ees” guussu."]},{"type":"verse","number":24,"content":["Yoosefi dhiskkofe barkkidi Godaa kiitanchchoy kiittidayssa mela Mayraamo ba soo efis."]},{"type":"verse","number":25,"content":["Shin ba bayra na7a yelana gakkanaw iyo bochchibeenna;",{"noteId":18},"yelettida na7akka Yesuusa gidi xeegis."]}],"footnotes":[{"noteId":18,"caller":"+","text":"iyo bochchibeenna: Machchira azinara aqeyssada issife aqibookkona guussu.","reference":{"chapter":1,"verse":25}}]},"thisChapterLink":"/api/gof_tbl/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_tbl/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":25}