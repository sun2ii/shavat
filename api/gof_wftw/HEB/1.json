{"translation":{"id":"gof_wftw","name":"Gofa New Testament","website":"https://ebible.org/Scriptures/details.php?id=gofwftw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gofwftw","licenseNotes":null,"shortName":"WFTW","englishName":"Gofa NT","language":"gof","textDirection":"ltr","sha256":"96d22e58bb7ea161c53c7576373d39fc4b28f11c30a7bad6af74b40b86615c92","availableFormats":["json"],"listOfBooksApiLink":"/api/gof_wftw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7931,"languageName":"Gofa","languageEnglishName":"Gofa"},"book":{"id":"HEB","translationId":"gof_wftw","name":"Ibraawe","commonName":"Ibraawe","title":"Ibraawe Asaas Xaafettida Kiitaa","order":58,"numberOfChapters":13,"sha256":"91ec30bd15cfe855b78706f0e66210c782afbaacc1a410a06288773530d2c8e8","firstChapterNumber":1,"firstChapterApiLink":"/api/gof_wftw/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/gof_wftw/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Na7ay kiitanchchotappe bolla"]},{"type":"verse","number":1,"content":["Kase Xoossay, nu aawatas nabeta baggara dumma dumma ogen daro wode odis."]},{"type":"verse","number":2,"content":["Shin ha wurssetha wodiyan ubbaa iya laatisida qassi alamiya iya baggara medhdhida ba Na7aa baggara nuus odis."]},{"type":"verse","number":3,"content":["Na7ay Xoossaa bonchchuwa phoolethaanne kumetha Xoossaa Xoossatethaa ekkidi, ba wolqqaama qaalan ha alamiya katisidi oykkis. Asaa entta nagaraappe geeshshidaappe guye Ubbaafe Bolla Xoossaa ushachcha baggan saluwan uttis."]},{"type":"verse","number":4,"content":["Iyaw imettida sunthay kiitanchchota sunthaafe bolla gideyssada I enttafe bolla."]},{"type":"verse","number":5,"content":["Hiza, Xoossay kiitanchchotappe oodeko,",{"text":"“Neeni ta Na7a;","poem":1},{"text":"ta hachchi new aawa gidas” gidee?","poem":2},"Woykko qassi oodeko,",{"text":"“Taani iyaw aawa gidana;","poem":1},{"text":"ikka taw na7a gidana” gidee?","poem":2}]},{"type":"verse","number":6,"content":["Qassi Xoossay ba bayra Na7a ha alamiya kiittishe,",{"text":"“Xoossaa kiitanchchoti ubbay iyaw goynno”","poem":1},"yaagis."]},{"type":"verse","number":7,"content":["Xoossay kiitanchchotabaa odishe,",{"text":"“Xoossay ba Kiitanchchota carkko,","poem":1},{"text":"ba aylleta tama laco oothees”","poem":2},"yaagees."]},{"type":"verse","number":8,"content":["Shin ba Na7abaa odishe,",{"text":"“Xoossaw, ne kawotethay merinaw de7ees;","poem":1},{"text":"Ne kawotethaa ne xillotethan ayssasa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neeni xillotethi dosadasa; iita ixxadasa.","poem":1},{"text":"Xoossay, ne Goday, nena ne laggetappe aathidi dooris,","poem":2},{"lineBreak":true},{"text":"ufayssa zayte","poem":2},{"noteId":0},{"text":"nena tiyis”","poem":2},"yaagees."]},{"type":"verse","number":10,"content":["Xoossay Zaaridi,",{"text":"“Godaw, koyro neeni sa7a medhdhadasa;","poem":1},{"text":"saloti ne kushe ooso.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hessati ubbay dhayana;","poem":1},{"text":"shin neeni daana.","poem":2},{"lineBreak":true},{"text":"Entti ubbay afilada wurana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Neeni entta salenaada xaaxana;","poem":1},{"text":"qassi entti afilada laamettana.","poem":2},{"text":"Shin neeni ubba wode nena;","poem":1},{"text":"ne laythayka wurenna” yaagees.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Shin Xoossay kiitanchchotappe oodeko,","poem":2},{"text":"“Taani ne morkketa ne tohoy yedhdhiyaso oothana gakkanaw,","poem":1},{"lineBreak":true},{"text":"hayssan taappe ushachcha baggan utta” gidee?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kiitanchchoti ubbay atotethi demmanaw de7iya asata maaddanaw Xoossay kiittida ayyaanata gidokkonaayye?","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"ufayssa zayte: I kawotiya wode asay ufayssan ililidi iya kawotheyssa bessees.","reference":{"chapter":1,"verse":9}}]},"thisChapterLink":"/api/gof_wftw/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gof_wftw/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gof_wftw/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}