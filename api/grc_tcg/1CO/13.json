{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"1CO","translationId":"grc_tcg","name":"ΠΡΟΣ ΚΟΡΙΝΘΙΟΥΣ Α","commonName":"ΠΡΟΣ ΚΟΡΙΝΘΙΟΥΣ Α","title":"ΠΡΟΣ ΚΟΡΙΝΘΙΟΥΣ Α","order":46,"numberOfChapters":16,"sha256":"c26bdda83a0c35542051cebedeb9ea087d3a556bccf562558e767821e7a8e064","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/1CO/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/grc_tcg/1CO/16.json","totalNumberOfVerses":437},"chapter":{"number":13,"content":[{"type":"heading","content":["The Way of Love"]},{"type":"verse","number":1,"content":["Ἐὰν ταῖς γλώσσαις τῶν ἀνθρώπων λαλῶ καὶ τῶν ἀγγέλων, ἀγάπην δὲ μὴ ἔχω, γέγονα χαλκὸς ἠχῶν ἢ κύμβαλον ἀλαλάζον."]},{"type":"verse","number":2,"content":[{"noteId":306},"Καὶ ἐὰν ἔχω προφητείαν, καὶ εἰδῶ τὰ μυστήρια πάντα καὶ πᾶσαν τὴν γνῶσιν,",{"noteId":307},"καὶ ἐὰν ἔχω πᾶσαν τὴν πίστιν, ὥστε ὄρη",{"noteId":308},"μεθιστάνειν, ἀγάπην δὲ μὴ ἔχω,",{"noteId":309},"οὐθέν εἰμι."]},{"type":"verse","number":3,"content":[{"noteId":310},"Καὶ ἐὰν ψωμίσω πάντα τὰ ὑπάρχοντά μου,",{"noteId":311},"καὶ ἐὰν παραδῶ τὸ σῶμά μου ἵνα",{"noteId":312},"καυθήσωμαι, ἀγάπην δὲ μὴ ἔχω, οὐδὲν ὠφελοῦμαι."]},{"type":"verse","number":4,"content":["Ἡ ἀγάπη μακροθυμεῖ, χρηστεύεται· ἡ ἀγάπη οὐ ζηλοῖ·",{"noteId":313},"ἡ ἀγάπη οὐ περπερεύεται, οὐ φυσιοῦται,"]},{"type":"verse","number":5,"content":["οὐκ ἀσχημονεῖ, οὐ ζητεῖ τὰ ἑαυτῆς, οὐ παροξύνεται, οὐ λογίζεται τὸ κακόν,"]},{"type":"verse","number":6,"content":["οὐ χαίρει ἐπὶ τῇ ἀδικίᾳ,",{"noteId":314},"συγχαίρει δὲ τῇ ἀληθείᾳ,"]},{"type":"verse","number":7,"content":["πάντα στέγει, πάντα πιστεύει, πάντα ἐλπίζει, πάντα ὑπομένει."]},{"type":"verse","number":8,"content":["Ἡ ἀγάπη οὐδέποτε",{"noteId":315},"ἐκπίπτει· εἴτε δὲ προφητεῖαι, καταργηθήσονται· εἴτε γλῶσσαι, παύσονται· εἴτε γνῶσις, καταργηθήσεται."]},{"type":"verse","number":9,"content":["Ἐκ μέρους",{"noteId":316},"δὲ",{"noteId":317},"γινώσκομεν, καὶ ἐκ μέρους προφητεύομεν·"]},{"type":"verse","number":10,"content":["ὅταν δὲ ἔλθῃ τὸ τέλειον,",{"noteId":318},"τότε τὸ ἐκ μέρους καταργηθήσεται."]},{"type":"verse","number":11,"content":["Ὅτε ἤμην νήπιος,",{"noteId":319},"ὡς νήπιος ἐλάλουν, ὡς νήπιος ἐφρόνουν, ὡς νήπιος ἐλογιζόμην· ὅτε",{"noteId":320},"δὲ γέγονα ἀνήρ, κατήργηκα τὰ τοῦ νηπίου."]},{"type":"verse","number":12,"content":["Βλέπομεν γὰρ ἄρτι δι᾽ ἐσόπτρου ἐν αἰνίγματι, τότε δὲ πρόσωπον πρὸς πρόσωπον· ἄρτι",{"noteId":321},"γινώσκω ἐκ μέρους, τότε δὲ ἐπιγνώσομαι καθὼς καὶ ἐπεγνώσθην."]},{"type":"verse","number":13,"content":["Νυνὶ δὲ μένει πίστις, ἐλπίς, ἀγάπη, τὰ τρία ταῦτα· μείζων δὲ τούτων ἡ ἀγάπη."]}],"footnotes":[{"noteId":306,"caller":"+","text":"και εαν ¦ καν WH","reference":{"chapter":13,"verse":2}},{"noteId":307,"caller":"+","text":"και εαν ¦ καν WH","reference":{"chapter":13,"verse":2}},{"noteId":308,"caller":"+","text":"μεθιστανειν ¦ μεθισταναι NA SBL TH","reference":{"chapter":13,"verse":2}},{"noteId":309,"caller":"+","text":"ουθεν ¦ ουδεν ANT SCR","reference":{"chapter":13,"verse":2}},{"noteId":310,"caller":"+","text":"και εαν ¦ καν NA TH WH","reference":{"chapter":13,"verse":3}},{"noteId":311,"caller":"+","text":"και εαν ¦ καν WH","reference":{"chapter":13,"verse":3}},{"noteId":312,"caller":"+","text":"καυθησωμαι 𝔐181 45.4% ¦ καυθησομαι 𝔐178 ANT PCK SBL TH 49.7% ¦ καυχησωμαι NA WH 1.5%","reference":{"chapter":13,"verse":3}},{"noteId":313,"caller":"+","text":"η αγαπη 83.2% ¦ — WH 12.9%","reference":{"chapter":13,"verse":4}},{"noteId":314,"caller":"+","text":"συγχαιρει ¦ συνχαιρει TH WH","reference":{"chapter":13,"verse":6}},{"noteId":315,"caller":"+","text":"εκπιπτει ¦ πιπτει CT","reference":{"chapter":13,"verse":8}},{"noteId":316,"caller":"+","text":"δε ¦ γαρ CT TR","reference":{"chapter":13,"verse":9}},{"noteId":317,"caller":"+","text":"γινωσκομεν ¦ γεινωσκομεν TH","reference":{"chapter":13,"verse":9}},{"noteId":318,"caller":"+","text":"τοτε ¦ — CT","reference":{"chapter":13,"verse":10}},{"noteId":319,"caller":"+","text":"ως νηπιος ελαλουν … ελογιζομην ¦ ελαλουν … ελογιζομην ως νηπιος CT","reference":{"chapter":13,"verse":11}},{"noteId":320,"caller":"+","text":"δε ¦ — CT","reference":{"chapter":13,"verse":11}},{"noteId":321,"caller":"+","text":"γινωσκω ¦ γεινωσκω TH","reference":{"chapter":13,"verse":12}}]},"thisChapterLink":"/api/grc_tcg/1CO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/grc_tcg/1CO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/grc_tcg/1CO/12.json","previousChapterAudioLinks":{},"numberOfVerses":13}