{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"1CO","translationId":"grc_tcg","name":"ΠΡΟΣ ΚΟΡΙΝΘΙΟΥΣ Α","commonName":"ΠΡΟΣ ΚΟΡΙΝΘΙΟΥΣ Α","title":"ΠΡΟΣ ΚΟΡΙΝΘΙΟΥΣ Α","order":46,"numberOfChapters":16,"sha256":"c26bdda83a0c35542051cebedeb9ea087d3a556bccf562558e767821e7a8e064","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/1CO/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/grc_tcg/1CO/16.json","totalNumberOfVerses":437},"chapter":{"number":5,"content":[{"type":"heading","content":["Fornication Rebuked"]},{"type":"verse","number":1,"content":["Ὅλως ἀκούεται ἐν ὑμῖν πορνεία, καὶ τοιαύτη πορνεία, ἥτις οὐδὲ ἐν τοῖς ἔθνεσιν",{"noteId":69},"ὀνομάζεται, ὥστε γυναῖκά τινα τοῦ πατρὸς ἔχειν."]},{"type":"verse","number":2,"content":["Καὶ ὑμεῖς πεφυσιωμένοι ἐστέ, καὶ οὐχὶ μᾶλλον ἐπενθήσατε, ἵνα",{"noteId":70},"ἐξαρθῇ ἐκ μέσου ὑμῶν ὁ τὸ ἔργον τοῦτο",{"noteId":71},"ποιήσας."]},{"type":"verse","number":3,"content":["Ἐγὼ μὲν γὰρ",{"noteId":72},"ὡς ἀπὼν τῷ σώματι παρὼν δὲ τῷ πνεύματι, ἤδη κέκρικα ὡς παρών, τὸν οὕτω τοῦτο κατεργασάμενον,"]},{"type":"verse","number":4,"content":["ἐν τῷ ὀνόματι τοῦ Κυρίου ἡμῶν Ἰησοῦ",{"noteId":73},"Χριστοῦ, συναχθέντων ὑμῶν καὶ τοῦ ἐμοῦ πνεύματος, σὺν τῇ δυνάμει τοῦ Κυρίου ἡμῶν Ἰησοῦ",{"noteId":74},"Χριστοῦ,"]},{"type":"verse","number":5,"content":["παραδοῦναι τὸν τοιοῦτον τῷ Σατανᾷ εἰς ὄλεθρον τῆς σαρκός, ἵνα τὸ πνεῦμα σωθῇ ἐν τῇ ἡμέρᾳ τοῦ Κυρίου",{"noteId":75},"Ἰησοῦ."]},{"type":"verse","number":6,"content":["Οὐ καλὸν τὸ καύχημα ὑμῶν. Οὐκ οἴδατε ὅτι μικρὰ ζύμη ὅλον τὸ φύραμα ζυμοῖ;"]},{"type":"verse","number":7,"content":[{"noteId":76},"Ἐκκαθάρατε τὴν παλαιὰν ζύμην, ἵνα ἦτε νέον φύραμα, καθώς ἐστε ἄζυμοι. Καὶ γὰρ τὸ Πάσχα ἡμῶν",{"noteId":77},"ὑπὲρ ἡμῶν",{"noteId":78},"ἐτύθη Χριστός·"]},{"type":"verse","number":8,"content":["ὥστε ἑορτάζωμεν, μὴ ἐν ζύμῃ παλαιᾷ, μηδὲ ἐν ζύμῃ κακίας καὶ πονηρίας, ἀλλ᾽ ἐν ἀζύμοις",{"noteId":79},"εἰλικρινείας καὶ ἀληθείας."]},{"type":"verse","number":9,"content":["Ἔγραψα ὑμῖν ἐν τῇ ἐπιστολῇ μὴ συναναμίγνυσθαι πόρνοις·"]},{"type":"verse","number":10,"content":[{"noteId":80},"καὶ οὐ πάντως τοῖς πόρνοις τοῦ κόσμου τούτου ἢ τοῖς πλεονέκταις,",{"noteId":81},"ἢ ἅρπαξιν, ἢ εἰδωλολάτραις· ἐπεὶ",{"noteId":82},"ὀφείλετε ἄρα ἐκ τοῦ κόσμου ἐξελθεῖν."]},{"type":"verse","number":11,"content":[{"noteId":83},"Νῦν δὲ ἔγραψα ὑμῖν μὴ συναναμίγνυσθαι, ἐάν τις ἀδελφὸς ὀνομαζόμενος ᾖ πόρνος, ἢ πλεονέκτης, ἢ εἰδωλολάτρης, ἢ λοίδορος, ἢ μέθυσος, ἢ ἅρπαξ· τῷ τοιούτῳ μηδὲ συνεσθίειν."]},{"type":"verse","number":12,"content":["Τί γάρ μοι",{"noteId":84},"καὶ τοὺς ἔξω κρίνειν; Οὐχὶ τοὺς ἔσω ὑμεῖς κρίνετε;"]},{"type":"verse","number":13,"content":["Τοὺς δὲ ἔξω ὁ Θεὸς",{"noteId":85},"κρινεῖ.",{"noteId":86},"Καὶ ἐξαρεῖτε τὸν πονηρὸν ἐξ ὑμῶν αὐτῶν."]}],"footnotes":[{"noteId":69,"caller":"+","text":"ονομαζεται 95.5% ¦ — CT 3.3%","reference":{"chapter":5,"verse":1}},{"noteId":70,"caller":"+","text":"εξαρθη ¦ αρθη CT","reference":{"chapter":5,"verse":2}},{"noteId":71,"caller":"+","text":"ποιησας ¦ πραξας NA WH","reference":{"chapter":5,"verse":2}},{"noteId":72,"caller":"+","text":"ως ¦ — CT","reference":{"chapter":5,"verse":3}},{"noteId":73,"caller":"+","text":"χριστου ¦ — NA SBL WH","reference":{"chapter":5,"verse":4}},{"noteId":74,"caller":"+","text":"χριστου ¦ — CT","reference":{"chapter":5,"verse":4}},{"noteId":75,"caller":"+","text":"ιησου ¦ — NA SBL WH","reference":{"chapter":5,"verse":5}},{"noteId":76,"caller":"+","text":"εκκαθαρατε ¦