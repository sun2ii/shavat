{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"1PE","translationId":"grc_tcg","name":"ΠΕΤΡΟΥ Α","commonName":"ΠΕΤΡΟΥ Α","title":"ΠΕΤΡΟΥ Α","order":60,"numberOfChapters":5,"sha256":"7687766d36627959501501200c2265026a7bb69982542c0ec940f39480e32a74","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/1PE/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/grc_tcg/1PE/5.json","totalNumberOfVerses":105},"chapter":{"number":5,"content":[{"type":"heading","content":["Exhortation to Elders"]},{"type":"verse","number":1,"content":["Πρεσβυτέρους",{"noteId":112},"τοὺς ἐν ὑμῖν παρακαλῶ ὁ",{"noteId":113},"συμπρεσβύτερος καὶ μάρτυς τῶν τοῦ Χριστοῦ παθημάτων, ὁ καὶ τῆς μελλούσης ἀποκαλύπτεσθαι δόξης κοινωνός·"]},{"type":"verse","number":2,"content":["ποιμάνατε τὸ ἐν ὑμῖν ποίμνιον τοῦ Θεοῦ,",{"noteId":114},"ἐπισκοποῦντες μὴ ἀναγκαστῶς,",{"noteId":115},"ἀλλ᾽",{"noteId":116},"ἑκουσίως· μηδὲ αἰσχροκερδῶς, ἀλλὰ προθύμως·"]},{"type":"verse","number":3,"content":[{"noteId":117},"μηδ᾽ ὡς κατακυριεύοντες τῶν κλήρων, ἀλλὰ τύποι γινόμενοι τοῦ ποιμνίου."]},{"type":"verse","number":4,"content":["Καὶ φανερωθέντος τοῦ ἀρχιποίμενος, κομιεῖσθε τὸν ἀμαράντινον τῆς δόξης στέφανον."]},{"type":"verse","number":5,"content":["Ὁμοίως, νεώτεροι, ὑποτάγητε πρεσβυτέροις· πάντες δὲ ἀλλήλοις",{"noteId":118},"ὑποτασσόμενοι, τὴν ταπεινοφροσύνην ἐγκομβώσασθε· ὅτι ὁ Θεὸς ὑπερηφάνοις ἀντιτάσσεται, ταπεινοῖς δὲ δίδωσι χάριν."]},{"type":"verse","number":6,"content":["Ταπεινώθητε οὖν ὑπὸ τὴν κραταιὰν χεῖρα τοῦ Θεοῦ, ἵνα ὑμᾶς ὑψώσῃ ἐν καιρῷ,"]},{"type":"verse","number":7,"content":["πᾶσαν τὴν μέριμναν ὑμῶν",{"noteId":119},"ἐπιρρίψαντες ἐπ᾽ αὐτόν, ὅτι αὐτῷ μέλει",{"noteId":120},"περὶ ὑμῶν."]},{"type":"verse","number":8,"content":["Νήψατε,",{"noteId":121},"γρηγορήσατε· ὁ ἀντίδικος ὑμῶν διάβολος, ὡς λέων ὠρυόμενος,",{"noteId":122},"περιπατεῖ ζητῶν",{"noteId":123},"τινα καταπιεῖν·"]},{"type":"verse","number":9,"content":["ᾧ ἀντίστητε στερεοὶ τῇ πίστει, εἰδότες τὰ αὐτὰ τῶν παθημάτων τῇ ἐν",{"noteId":124},"κόσμῳ ὑμῶν ἀδελφότητι ἐπιτελεῖσθαι."]},{"type":"verse","number":10,"content":["Ὁ δὲ Θεὸς πάσης χάριτος, ὁ καλέσας",{"noteId":125},"ὑμᾶς εἰς τὴν αἰώνιον αὐτοῦ δόξαν ἐν Χριστῷ",{"noteId":126},"Ἰησοῦ, ὀλίγον παθόντας αὐτὸς",{"noteId":127},"καταρτίσαι ὑμᾶς, στηρίξει, σθενώσει, θεμελιώσει."]},{"type":"verse","number":11,"content":["Αὐτῷ",{"noteId":128},"ἡ δόξα καὶ τὸ κράτος εἰς τοὺς αἰῶνας",{"noteId":129},"τῶν αἰώνων. Ἀμήν."]},{"type":"heading","content":["Final Greetings"]},{"type":"verse","number":12,"content":["Διὰ Σιλουανοῦ ὑμῖν τοῦ πιστοῦ ἀδελφοῦ, ὡς λογίζομαι, δι᾽ ὀλίγων ἔγραψα, παρακαλῶν καὶ ἐπιμαρτυρῶν ταύτην εἶναι ἀληθῆ χάριν τοῦ Θεοῦ εἰς ἣν",{"noteId":130},"ἑστήκατε."]},{"type":"verse","number":13,"content":["Ἀσπάζεται ὑμᾶς ἡ ἐν Βαβυλῶνι συνεκλεκτή, καὶ Μάρκος ὁ υἱός μου."]},{"type":"verse","number":14,"content":["Ἀσπάσασθε ἀλλήλους ἐν φιλήματι ἀγάπης. Εἰρήνη ὑμῖν πᾶσι τοῖς ἐν Χριστῷ",{"noteId":131},"Ἰησοῦ.",{"noteId":132},"Ἀμήν."]}],"footnotes":[{"noteId":112,"caller":"+","text":"τους ¦ ουν NA27 SBL WH ¦ ουν τους TH","reference":{"chapter":5,"verse":1}},{"noteId":113,"caller":"+","text":"συμπρεσβυτερος ¦ συνπρεσβυτερος TH WH","reference":{"chapter":5,"verse":1}},{"noteId":114,"caller":"+","text":"επισκοπουντες 95% ¦ — WH 0.8%","reference":{"chapter":5,"verse":2}},{"noteId":115,"caller":"+","text":"αλλ ¦ αλλα NA27 SBL TH WH","reference":{"chapter":5,"verse":2}},{"noteId":116,"caller":"+","text":"εκουσιως ¦ ε