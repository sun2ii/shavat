{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"2CO","translationId":"grc_tcg","name":"ΠΡΟΣ ΚΟΡΙΝΘΙΟΥΣ Β","commonName":"ΠΡΟΣ ΚΟΡΙΝΘΙΟΥΣ Β","title":"ΠΡΟΣ ΚΟΡΙΝΘΙΟΥΣ Β","order":47,"numberOfChapters":13,"sha256":"95c14b8dfee7d2367e5bfa22eb252d3a6dee14c9bb77f57f4ced0a7a0bd9b82f","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/2CO/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/grc_tcg/2CO/13.json","totalNumberOfVerses":257},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":["Συνεργοῦντες δὲ καὶ παρακαλοῦμεν μὴ εἰς κενὸν τὴν χάριν τοῦ Θεοῦ δέξασθαι ὑμᾶς—"]},{"type":"verse","number":2,"content":["λέγει γάρ,",{"lineBreak":true},{"text":"Καιρῷ δεκτῷ ἐπήκουσά σου,","poem":1},{"lineBreak":true},{"text":"καὶ ἐν ἡμέρᾳ σωτηρίας ἐβοήθησά σοι·","poem":1},{"lineBreak":true},"ἰδού, νῦν καιρὸς εὐπρόσδεκτος, ἰδού, νῦν ἡμέρα σωτηρίας—"]},{"type":"verse","number":3,"content":["μηδεμίαν ἐν μηδενὶ διδόντες προσκοπήν, ἵνα μὴ μωμηθῇ ἡ διακονία·"]},{"type":"verse","number":4,"content":["ἀλλ᾽ ἐν παντὶ",{"noteId":95},"συνιστῶντες ἑαυτοὺς ὡς Θεοῦ διάκονοι, ἐν ὑπομονῇ πολλῇ, ἐν θλίψεσιν, ἐν ἀνάγκαις, ἐν στενοχωρίαις,"]},{"type":"verse","number":5,"content":["ἐν πληγαῖς, ἐν φυλακαῖς, ἐν ἀκαταστασίαις, ἐν κόποις, ἐν ἀγρυπνίαις, ἐν νηστείαις,"]},{"type":"verse","number":6,"content":["ἐν ἁγνότητι, ἐν γνώσει, ἐν μακροθυμίᾳ, ἐν χρηστότητι, ἐν Πνεύματι Ἁγίῳ, ἐν ἀγάπῃ ἀνυποκρίτῳ,"]},{"type":"verse","number":7,"content":["ἐν λόγῳ ἀληθείας, ἐν δυνάμει Θεοῦ, διὰ τῶν ὅπλων τῆς δικαιοσύνης τῶν δεξιῶν καὶ ἀριστερῶν,"]},{"type":"verse","number":8,"content":["διὰ δόξης καὶ ἀτιμίας, διὰ δυσφημίας καὶ εὐφημίας· ὡς πλάνοι καὶ ἀληθεῖς·"]},{"type":"verse","number":9,"content":["ὡς ἀγνοούμενοι, καὶ ἐπιγινωσκόμενοι· ὡς ἀποθνῄσκοντες, καὶ ἰδού, ζῶμεν· ὡς παιδευόμενοι, καὶ μὴ θανατούμενοι·"]},{"type":"verse","number":10,"content":["ὡς λυπούμενοι, ἀεὶ δὲ χαίροντες· ὡς πτωχοί, πολλοὺς δὲ πλουτίζοντες· ὡς μηδὲν ἔχοντες, καὶ πάντα κατέχοντες."]},{"type":"verse","number":11,"content":["Τὸ στόμα ἡμῶν ἀνέῳγε πρὸς ὑμᾶς, Κορίνθιοι, ἡ καρδία ἡμῶν πεπλάτυνται."]},{"type":"verse","number":12,"content":["Οὐ στενοχωρεῖσθε ἐν ἡμῖν, στενοχωρεῖσθε δὲ ἐν τοῖς σπλάγχνοις ὑμῶν."]},{"type":"verse","number":13,"content":["Τὴν δὲ αὐτὴν ἀντιμισθίαν—ὡς τέκνοις λέγω—πλατύνθητε καὶ ὑμεῖς."]},{"type":"heading","content":["Do Not Be Unequally Yoked"]},{"type":"verse","number":14,"content":["Μὴ",{"noteId":96},"γίνεσθε ἑτεροζυγοῦντες ἀπίστοις· τίς γὰρ μετοχὴ δικαιοσύνῃ καὶ ἀνομίᾳ;",{"noteId":97},"Τίς δὲ κοινωνία φωτὶ πρὸς σκότος;"]},{"type":"verse","number":15,"content":["Τίς δὲ συμφώνησις",{"noteId":98},"Χριστῷ πρὸς",{"noteId":99},"Βελίαρ; Ἢ τίς μερὶς πιστῷ μετὰ ἀπίστου;"]},{"type":"verse","number":16,"content":["Τίς δὲ",{"noteId":100},"συγκατάθεσις ναῷ Θεοῦ μετὰ εἰδώλων;",{"noteId":101},"Ὑμεῖς γὰρ ναὸς Θεοῦ ἐστε ζῶντος, καθὼς εἶπεν ὁ Θεὸς ὅτι",{"lineBreak":true},{"text":"Ἐνοικήσω ἐν αὐτοῖς, καὶ","poem":1},{"noteId":102},{"text":"ἐμπεριπατήσω·","poem":1},{"lineBreak":true},{"text":"καὶ ἔσομαι αὐτῶν Θεός,","poem":1},{"lineBreak":true},{"text":"καὶ αὐτοὶ ἔσονταί","poem":1},{"noteId":103},{"text":"μοι λαός.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Διό,","poem":1},{"noteId":104},{"text":"Ἐξέλθετε ἐκ μέσου αὐτῶν","poem":1},{"lineBreak":true},{"text":"καὶ ἀφορίσθητε, λέγει Κύριος,","poem":1},{"lineBreak":true},{"text":"καὶ ἀκαθάρτου μὴ ἅπτεσθε·","poem":1},{"lineBreak":true},{"text":"κἀγὼ εἰσδέξομαι ὑμᾶς,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"καὶ ἔσομαι ὑμῖν εἰς πατέρα,","poem":1},{"lineBreak":true},{"text":"καὶ ὑμεῖς ἔσεσθέ μοι εἰς υἱοὺς καὶ θυγατέρας,","poem":1},{"lineBreak":true},{"text":"λέγει Κύριος παντοκράτωρ.","poem":1}]}],"footnotes":[{"noteId":95,"caller":"+","text":"συνιστωντες ¦ συνισταντες NA TH ¦ συνιστανοντες SBL WH","reference":{"chapter":6,"verse":4}},{"noteId":96,"caller":"+","text":"γινεσθε ¦ γεινεσθε TH","reference":{"chapter":6,"verse":14}},{"noteId":97,"caller":"+","text":"τις δε ¦ η τις CT","reference":{"chapter":6,"verse":14}},{"noteId":98,"caller":"+","text":"χριστω ¦ χριστου CT","reference":{"chapter":6,"verse":15}},{"noteId":99,"caller":"+","text":"βελιαρ ¦ βελιαλ ANT SCR","reference":{"chapter":6,"verse":15}},{"noteId":100,"caller":"+","text":"συγκαταθεσις ¦ συνκαταθεσις WH","reference":{"chapter":6,"verse":16}},{"noteId":101,"caller":"+","text":"υμεις … εστε ¦ ημεις … εσμεν CT","reference":{"chapter":6,"verse":16}},{"noteId":102,"caller":"+","text":"εμπεριπατησω ¦ ενπεριπατησω WH","reference":{"chapter":6,"verse":16}},{"noteId":103,"caller":"+","text":"μοι ¦ μου CT","reference":{"chapter":6,"verse":16}},{"noteId":104,"caller":"+","text":"εξελθετε ¦ εξελθατε ANT CT","reference":{"chapter":6,"verse":17}}]},"thisChapterLink":"/api/grc_tcg/2CO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/grc_tcg/2CO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/grc_tcg/2CO/5.json","previousChapterAudioLinks":{},"numberOfVerses":18}