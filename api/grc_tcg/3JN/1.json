{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"3JN","translationId":"grc_tcg","name":"ΙΩΑΝΝΟΥ Γ","commonName":"ΙΩΑΝΝΟΥ Γ","title":"ΙΩΑΝΝΟΥ Γ","order":64,"numberOfChapters":1,"sha256":"106e9cb5019ab640db6da34b50d60f786dd2fe2d070b699ee97f2ba2a1180648","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/3JN/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/grc_tcg/3JN/1.json","totalNumberOfVerses":14},"chapter":{"number":1,"content":[{"type":"heading","content":["Greeting"]},{"type":"verse","number":1,"content":["Ὁ πρεσβύτερος Γαΐῳ τῷ ἀγαπητῷ, ὃν ἐγὼ ἀγαπῶ ἐν ἀληθείᾳ."]},{"type":"verse","number":2,"content":["Ἀγαπητέ, περὶ πάντων εὔχομαί σε εὐοδοῦσθαι καὶ ὑγιαίνειν, καθὼς εὐοδοῦταί σου ἡ ψυχή."]},{"type":"verse","number":3,"content":["Ἐχάρην γὰρ λίαν, ἐρχομένων ἀδελφῶν καὶ μαρτυρούντων σου τῇ ἀληθείᾳ, καθὼς σὺ ἐν ἀληθείᾳ περιπατεῖς."]},{"type":"verse","number":4,"content":["Μειζοτέραν τούτων οὐκ ἔχω",{"noteId":0},"χαράν, ἵνα ἀκούω τὰ ἐμὰ τέκνα ἐν",{"noteId":1},"ἀληθείᾳ περιπατοῦντα."]},{"type":"heading","content":["Gaius Commended"]},{"type":"verse","number":5,"content":["Ἀγαπητέ, πιστὸν ποιεῖς ὃ ἐὰν ἐργάσῃ εἰς τοὺς ἀδελφοὺς καὶ",{"noteId":2},"εἰς τοὺς ξένους,"]},{"type":"verse","number":6,"content":["οἳ ἐμαρτύρησάν σου τῇ ἀγάπῃ ἐνώπιον ἐκκλησίας· οὓς καλῶς ποιήσεις προπέμψας ἀξίως τοῦ Θεοῦ."]},{"type":"verse","number":7,"content":["Ὑπὲρ γὰρ τοῦ",{"noteId":3},"ὀνόματος",{"noteId":4},"ἐξῆλθον μηδὲν λαμβάνοντες ἀπὸ τῶν",{"noteId":5},"ἐθνῶν."]},{"type":"verse","number":8,"content":["Ἡμεῖς οὖν ὀφείλομεν",{"noteId":6},"ἀπολαμβάνειν τοὺς τοιούτους, ἵνα συνεργοὶ γινώμεθα τῇ ἀληθείᾳ."]},{"type":"heading","content":["Diotrephes Denounced"]},{"type":"verse","number":9,"content":[{"noteId":7},"Ἔγραψα τῇ ἐκκλησίᾳ· ἀλλ᾽ ὁ φιλοπρωτεύων αὐτῶν Διοτρεφὴς οὐκ ἐπιδέχεται ἡμᾶς."]},{"type":"verse","number":10,"content":["Διὰ τοῦτο, ἐὰν ἔλθω, ὑπομνήσω αὐτοῦ τὰ ἔργα ἃ ποιεῖ, λόγοις πονηροῖς φλυαρῶν ἡμᾶς· καὶ μὴ ἀρκούμενος ἐπὶ τούτοις, οὔτε αὐτὸς ἐπιδέχεται τοὺς ἀδελφούς, καὶ τοὺς βουλομένους κωλύει, καὶ ἐκ τῆς ἐκκλησίας ἐκβάλλει."]},{"type":"heading","content":["Demetrius Commended"]},{"type":"verse","number":11,"content":["Ἀγαπητέ, μὴ μιμοῦ τὸ κακόν, ἀλλὰ τὸ ἀγαθόν. Ὁ ἀγαθοποιῶν ἐκ τοῦ Θεοῦ ἐστιν·",{"noteId":8},"ὁ κακοποιῶν οὐχ ἑώρακε τὸν Θεόν."]},{"type":"verse","number":12,"content":["Δημητρίῳ μεμαρτύρηται ὑπὸ πάντων, καὶ",{"noteId":9},"ὑπ᾽ αὐτῆς τῆς ἀληθείας· καὶ ἡμεῖς δὲ μαρτυροῦμεν, καὶ",{"noteId":10},"οἴδατε ὅτι ἡ μαρτυρία ἡμῶν ἀληθής ἐστι."]},{"type":"heading","content":["Final Greetings"]},{"type":"verse","number":13,"content":["Πολλὰ εἶχον",{"noteId":11},"γράφειν, ἀλλ᾽ οὐ θέλω διὰ μέλανος καὶ καλάμου σοι",{"noteId":12},"γράψαι·"]},{"type":"verse","number":14,"content":["ἐλπίζω δὲ εὐθέως",{"noteId":13},"ἰδεῖν σε, καὶ στόμα πρὸς στόμα λαλήσομεν. Εἰρήνη σοι. Ἀσπάζονταί σε οἱ φίλοι. Ἀσπάζου τοὺς φίλους κατ᾽ ὄνομα."]}],"footnotes":[{"noteId":0,"caller":"+","text":"χαραν ¦ χαριν WH","reference":{"chapter":1,"verse":4}},{"noteId":1,"caller":"+","text":"αληθεια ¦ τη αληθεια NA27 SBL TH WH","reference":{"chapter":1,"verse":4}},{"noteId":2,"caller":"+","text":"εις τους 89.8% ¦ τουτο CT 7.6%","reference":{"chapter":1,"verse":5}},{"noteId":3,"caller":"+","text":"ονοματος ¦ ονοματος αυτου SCR","reference":{"chapter":1,"verse":7}},{"noteId":4,"caller":"+","text":"εξηλθον ¦ εξηλθαν WH","reference":{"chapter":1,"verse":7}},{"noteId":5,"caller":"+","text":"εθνων 88% ¦ εθνικων ANT CT 12%"