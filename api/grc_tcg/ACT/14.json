{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"ACT","translationId":"grc_tcg","name":"ΠΡΑΞΕΙΣ ΑΠΟΣΤΟΛΩΝ","commonName":"ΠΡΑΞΕΙΣ ΑΠΟΣΤΟΛΩΝ","title":"ΠΡΑΞΕΙΣ ΑΠΟΣΤΟΛΩΝ","order":44,"numberOfChapters":28,"sha256":"48e9a8e0b6fb250740e05bcd60c2bf9812f031e81131b85aa63fee38c8ac784c","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/ACT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/grc_tcg/ACT/28.json","totalNumberOfVerses":1004},"chapter":{"number":14,"content":[{"type":"heading","content":["Paul and Barnabas in Iconium"]},{"type":"verse","number":1,"content":["Ἐγένετο δὲ ἐν Ἰκονίῳ, κατὰ τὸ αὐτὸ εἰσελθεῖν αὐτοὺς εἰς τὴν συναγωγὴν τῶν Ἰουδαίων, καὶ λαλῆσαι οὕτως ὥστε πιστεῦσαι Ἰουδαίων τε καὶ Ἑλλήνων πολὺ πλῆθος."]},{"type":"verse","number":2,"content":["Οἱ δὲ",{"noteId":737},"ἀπειθοῦντες Ἰουδαῖοι ἐπήγειραν καὶ ἐκάκωσαν τὰς ψυχὰς τῶν ἐθνῶν κατὰ τῶν ἀδελφῶν."]},{"type":"verse","number":3,"content":["Ἱκανὸν μὲν οὖν χρόνον διέτριψαν παρρησιαζόμενοι ἐπὶ τῷ Κυρίῳ τῷ μαρτυροῦντι",{"noteId":738},"τῷ λόγῳ τῆς χάριτος αὐτοῦ,",{"noteId":739},"διδόντι σημεῖα καὶ τέρατα γίνεσθαι διὰ τῶν χειρῶν αὐτῶν."]},{"type":"verse","number":4,"content":["Ἐσχίσθη δὲ τὸ πλῆθος τῆς πόλεως· καὶ οἱ μὲν ἦσαν σὺν τοῖς Ἰουδαίοις, οἱ δὲ σὺν τοῖς ἀποστόλοις."]},{"type":"verse","number":5,"content":["Ὡς δὲ ἐγένετο ὁρμὴ τῶν ἐθνῶν τε καὶ Ἰουδαίων σὺν τοῖς ἄρχουσιν αὐτῶν, ὑβρίσαι καὶ λιθοβολῆσαι αὐτούς,"]},{"type":"verse","number":6,"content":["συνιδόντες κατέφυγον εἰς τὰς πόλεις τῆς Λυκαονίας, Λύστραν καὶ Δέρβην, καὶ τὴν περίχωρον·"]},{"type":"verse","number":7,"content":["κἀκεῖ",{"noteId":740},"ἦσαν εὐαγγελιζόμενοι."]},{"type":"heading","content":["Paul and Barnabas in Lystra"]},{"type":"verse","number":8,"content":["Καί τις ἀνὴρ",{"noteId":741},"ἐν Λύστροις ἀδύνατος τοῖς ποσὶν ἐκάθητο, χωλὸς ἐκ κοιλίας μητρὸς αὐτοῦ",{"noteId":742},"ὑπάρχων, ὃς οὐδέποτε",{"noteId":743},"περιπεπατήκει."]},{"type":"verse","number":9,"content":["Οὗτος",{"noteId":744},"ἤκουσε τοῦ Παύλου λαλοῦντος· ὃς ἀτενίσας αὐτῷ, καὶ ἰδὼν ὅτι",{"noteId":745},"πίστιν ἔχει τοῦ σωθῆναι,"]},{"type":"verse","number":10,"content":["εἶπε μεγάλῃ",{"noteId":746},"τῇ φωνῇ, Ἀνάστηθι ἐπὶ τοὺς πόδας σου",{"noteId":747},"ὀρθῶς. Καὶ",{"noteId":748},"ἥλλετο καὶ περιεπάτει."]},{"type":"verse","number":11,"content":["Οἱ",{"noteId":749},"δὲ ὄχλοι, ἰδόντες ὃ ἐποίησεν",{"noteId":750},"ὁ Παῦλος, ἐπῆραν τὴν φωνὴν αὐτῶν Λυκαονιστὶ λέγοντες, Οἱ θεοὶ ὁμοιωθέντες ἀνθρώποις κατέβησαν πρὸς ἡμᾶς."]},{"type":"verse","number":12,"content":["Ἐκάλουν τε τὸν",{"noteId":751},"μὲν Βαρνάβαν, Δία· τὸν δὲ Παῦλον, Ἑρμῆν, ἐπειδὴ αὐτὸς ἦν ὁ ἡγούμενος τοῦ λόγου."]},{"type":"verse","number":13,"content":["Ὁ",{"noteId":752},"δὲ ἱερεὺς τοῦ Διὸς τοῦ ὄντος πρὸ τῆς πόλεως",{"noteId":753},"αὐτῶν, ταύρους καὶ στέμματα ἐπὶ τοὺς πυλῶνας ἐνέγκας, σὺν τοῖς ὄχλοις ἤθελε θύειν."]},{"type":"verse","number":14,"content":["Ἀκούσαντες δὲ οἱ ἀπόστολοι Βαρνάβας καὶ Παῦλος, διαρρήξαντες τὰ ἱμάτια",{"noteId":754},"αὐτῶν,",{"noteId":755},"εἰσεπήδησαν εἰς τὸν ὄχλον, κράζοντες"]},{"type":"verse","number":15,"content":["καὶ λέγοντες, Ἄνδρες, τί ταῦτα ποιεῖτε; Καὶ ἡμεῖς ὁμοιοπαθεῖς",{"noteId":756},"ἐσμεν ὑμῖν ἄνθρωποι, εὐαγγελιζόμενοι ὑμᾶς ἀπὸ τούτων τῶν ματαίων ἐπιστρέφειν ἐπὶ",{"noteId":757},"τὸν Θεὸν τὸν ζῶντα, ὃς ἐποίησε τὸν οὐρανὸν καὶ τὴν γῆν καὶ τὴν θάλασσαν καὶ πάντα τὰ ἐν αὐτοῖς·"]},{"type":"verse","number":16,"content":["ὃς ἐν ταῖς παρῳχημέναις γενεαῖς εἴασε πάντα τὰ ἔθνη πορεύεσθαι ταῖς ὁδοῖς αὐτῶν."]},{"type":"verse","number":17,"content":[{"noteId":758},"Καίτοιγε οὐκ ἀμάρτυρον",{"noteId":759},"ἑαυτὸν ἀφῆκεν",{"noteId":760},"ἀγαθοποιῶν, οὐρανόθεν",{"noteId":761},"ὑμῖν",{"noteId":762},"ὑετοὺς διδοὺς καὶ καιροὺς καρποφόρους, ἐμπιπλῶν τροφῆς καὶ εὐφροσύνης τὰς καρδίας",{"noteId":763},"ἡμῶν."]},{"type":"verse","number":18,"content":["Καὶ ταῦτα λέγοντες, μόλις κατέπαυσαν τοὺς ὄχλους τοῦ μὴ θύειν αὐτοῖς."]},{"type":"verse","number":19,"content":[{"noteId":764},"Ἐπῆλθον δὲ ἀπὸ Ἀντιοχείας καὶ Ἰκονίου Ἰουδαῖοι, καὶ πείσαντες τοὺς ὄχλους, καὶ λιθάσαντες τὸν Παῦλον,",{"noteId":765},"ἔσυρον ἔξω τῆς πόλεως,",{"noteId":766},"νομίσαντες αὐτὸν τεθνάναι."]},{"type":"verse","number":20,"content":["Κυκλωσάντων δὲ",{"noteId":767},"αὐτὸν τῶν μαθητῶν, ἀναστὰς εἰσῆλθεν εἰς τὴν πόλιν· καὶ τῇ ἐπαύριον ἐξῆλθε σὺν τῷ Βαρνάβᾳ εἰς Δέρβην."]},{"type":"heading","content":["Paul and Barnabas Return to Antioch in Syria"]},{"type":"verse","number":21,"content":["Εὐαγγελισάμενοί τε τὴν πόλιν ἐκείνην, καὶ μαθητεύσαντες ἱκανούς, ὑπέστρεψαν εἰς",{"noteId":768},"τὴν Λύστραν καὶ",{"noteId":769},"Ἰκόνιον καὶ",{"noteId":770},"Ἀντιόχειαν,"]},{"type":"verse","number":22,"content":["ἐπιστηρίζοντες τὰς ψυχὰς τῶν μαθητῶν, παρακαλοῦντες ἐμμένειν τῇ πίστει, καὶ ὅτι διὰ πολλῶν θλίψεων δεῖ ἡμᾶς εἰσελθεῖν εἰς τὴν βασιλείαν τοῦ Θεοῦ."]},{"type":"verse","number":23,"content":["Χειροτονήσαντες δὲ αὐτοῖς",{"noteId":771},"πρεσβυτέρους κατ᾽ ἐκκλησίαν,",{"noteId":772},"προσευξάμενοι μετὰ νηστειῶν, παρέθεντο αὐτοὺς τῷ Κυρίῳ εἰς ὃν",{"noteId":773},"πεπιστεύκεισαν."]},{"type":"verse","number":24,"content":["Καὶ διελθόντες τὴν Πισιδίαν",{"noteId":774},"ἦλθον εἰς",{"noteId":775},"Παμφυλίαν."]},{"type":"verse","number":25,"content":["Καὶ λαλήσαντες ἐν Πέργῃ τὸν λόγον, κατέβησαν εἰς",{"noteId":776},"Ἀττάλειαν·"]},{"type":"verse","number":26,"content":["κἀκεῖθεν ἀπέπλευσαν εἰς Ἀντιόχειαν, ὅθεν ἦσαν παραδεδομένοι τῇ χάριτι τοῦ Θεοῦ εἰς τὸ ἔργον ὃ ἐπλήρωσαν."]},{"type":"verse","number":27,"content":["Παραγενόμενοι δὲ καὶ συναγαγόντες τὴν ἐκκλησίαν,",{"noteId":777},"ἀνήγγειλαν ὅσα ἐποίησεν ὁ Θεὸς μετ᾽ αὐτῶν, καὶ ὅτι ἤνοιξε τοῖς ἔθνεσι θύραν πίστεως."]},{"type":"verse","number":28,"content":["Διέτριβον δὲ",{"noteId":778},"ἐκεῖ χρόνον οὐκ ὀλίγον σὺν τοῖς μαθηταῖς."]}],"footnotes":[{"noteId":737,"caller":"+","text":"απειθουντες ¦ απειθησαντες CT","reference":{"chapter":14,"verse":2}},{"noteId":738,"caller":"+","text":"τω ¦ επι τω NA","reference":{"chapter":14,"verse":3}},{"noteId":739,"caller":"+","text":"διδοντι ¦ και διδοντι TR","reference":{"chapter":14,"verse":3}},{"noteId":740,"caller":"+","text":"ησαν ευαγγελιζομενοι ¦ ευαγγελιζομενοι ησαν CT","reference":{"chapter":14,"verse":7}},{"noteId":741,"caller":"+","text":"εν λυστροις αδυνατος ¦ αδυνατος εν λυστροις ECM NA SBL WH","reference":{"chapter":14,"verse":8}},{"noteId":742,"caller":"+","text":"υπαρχων ¦ — CT","reference":{"chapter":14,"verse":8}},{"noteId":743,"caller":"+","text":"περιπεπατηκει ¦ περιεπεπατηκει SCR ¦ περιεπατησεν CT","reference":{"chapter":14,"verse":8}},{"noteId":744,"caller":"+","text":"ηκουσε ¦ ηκουε 𝔐pt PCK TR WH","reference":{"chapter":14,"verse":9}},{"noteId":745,"caller":"+","text":"πιστιν εχει ¦ εχει πιστιν CT","reference":{"chapter":14,"verse":9}},{"noteId":746,"caller":"+","text":"τη ¦ — NA SBL TH WH","reference":{"chapter":14,"verse":10}},{"noteId":747,"caller":"+","text":"ορθως ¦ ορθος 𝔐pt ANT CT HF PCK TR","reference":{"chapter":14,"verse":10}},{"noteId":748,"caller":"+","text":"ηλλετο ¦ ηλλατο PCK ¦ ηλατο ANT CT","reference":{"chapter":14,"verse":10}},{"noteId":749,"caller":"+","text":"δε ¦ τε ECM† NA SBL TH WH","reference":{"chapter":14,"verse":11}},{"noteId":750,"caller":"+","text":"ο ¦ — CT","reference":{"chapter":14,"verse":11}},{"noteId":751,"caller":"+","text":"μεν ¦ — CT","reference":{"chapter":14,"verse":12}},{"noteId":752,"caller":"+","text":"δε ¦ τε CT","reference":{"chapter":14,"verse":13}},{"noteId":753,"caller":"+","text":"αυτων ¦ — CT","reference":{"chapter":14,"verse":13}},{"not