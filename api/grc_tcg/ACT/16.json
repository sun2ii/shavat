{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"ACT","translationId":"grc_tcg","name":"ΠΡΑΞΕΙΣ ΑΠΟΣΤΟΛΩΝ","commonName":"ΠΡΑΞΕΙΣ ΑΠΟΣΤΟΛΩΝ","title":"ΠΡΑΞΕΙΣ ΑΠΟΣΤΟΛΩΝ","order":44,"numberOfChapters":28,"sha256":"48e9a8e0b6fb250740e05bcd60c2bf9812f031e81131b85aa63fee38c8ac784c","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/ACT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/grc_tcg/ACT/28.json","totalNumberOfVerses":1004},"chapter":{"number":16,"content":[{"type":"heading","content":["Timothy Joins Paul and Silas"]},{"type":"verse","number":1,"content":["Κατήντησε",{"noteId":836},"δὲ εἰς Δέρβην καὶ",{"noteId":837},"Λύστραν· καὶ ἰδού, μαθητής τις ἦν ἐκεῖ, ὀνόματι Τιμόθεος, υἱὸς γυναικός",{"noteId":838},"τινος Ἰουδαίας πιστῆς, πατρὸς δὲ Ἕλληνος·"]},{"type":"verse","number":2,"content":["ὃς ἐμαρτυρεῖτο ὑπὸ τῶν ἐν Λύστροις καὶ Ἰκονίῳ ἀδελφῶν."]},{"type":"verse","number":3,"content":["Τοῦτον ἠθέλησεν ὁ Παῦλος σὺν αὐτῷ ἐξελθεῖν, καὶ λαβὼν περιέτεμεν αὐτόν, διὰ τοὺς Ἰουδαίους τοὺς ὄντας ἐν τοῖς τόποις ἐκείνοις·",{"noteId":839},"ᾔδεισαν γὰρ ἅπαντες",{"noteId":840},"τὸν πατέρα αὐτοῦ, ὅτι Ἕλλην ὑπῆρχεν."]},{"type":"verse","number":4,"content":["Ὡς δὲ διεπορεύοντο τὰς πόλεις,",{"noteId":841},"παρεδίδουν αὐτοῖς φυλάσσειν τὰ δόγματα τὰ κεκριμένα ὑπὸ τῶν ἀποστόλων καὶ",{"noteId":842},"τῶν πρεσβυτέρων τῶν ἐν",{"noteId":843},"Ἱερουσαλήμ."]},{"type":"verse","number":5,"content":["Αἱ μὲν οὖν ἐκκλησίαι ἐστερεοῦντο τῇ πίστει, καὶ ἐπερίσσευον τῷ ἀριθμῷ καθ᾽ ἡμέραν."]},{"type":"heading","content":["Paul's Vision of the Macedonian Man"]},{"type":"verse","number":6,"content":[{"noteId":844},"Διελθόντες δὲ τὴν Φρυγίαν καὶ",{"noteId":845},"τὴν Γαλατικὴν χώραν, κωλυθέντες ὑπὸ τοῦ Ἁγίου Πνεύματος λαλῆσαι τὸν λόγον ἐν τῇ Ἀσίᾳ,"]},{"type":"verse","number":7,"content":[{"noteId":846},"ἐλθόντες κατὰ τὴν Μυσίαν ἐπείραζον",{"noteId":847},"κατὰ τὴν Βιθυνίαν",{"noteId":848},"πορεύεσθαι· καὶ οὐκ εἴασεν αὐτοὺς τὸ",{"noteId":849},"πνεῦμα·"]},{"type":"verse","number":8,"content":["παρελθόντες δὲ τὴν Μυσίαν κατέβησαν εἰς Τρῳάδα."]},{"type":"verse","number":9,"content":["Καὶ ὅραμα διὰ",{"noteId":850},"τῆς νυκτὸς",{"noteId":851},"ὤφθη τῷ Παύλῳ· ἀνήρ",{"noteId":852},"τις ἦν Μακεδὼν ἑστώς,",{"noteId":853},"παρακαλῶν αὐτὸν καὶ λέγων, Διαβὰς εἰς",{"noteId":854},"Μακεδονίαν, βοήθησον ἡμῖν."]},{"type":"verse","number":10,"content":["Ὡς δὲ τὸ ὅραμα εἶδεν, εὐθέως ἐζητήσαμεν ἐξελθεῖν εἰς",{"noteId":855},"τὴν Μακεδονίαν,",{"noteId":856},"συμβιβάζοντες ὅτι προσκέκληται ἡμᾶς ὁ",{"noteId":857},"Κύριος εὐαγγελίσασθαι αὐτούς."]},{"type":"heading","content":["The Conversion of Lydia"]},{"type":"verse","number":11,"content":["Ἀναχθέντες",{"noteId":858},"οὖν ἀπὸ",{"noteId":859},"τῆς Τρῳάδος, εὐθυδρομήσαμεν εἰς",{"noteId":860},"Σαμοθρᾴκην, τῇ",{"noteId":861},"τε ἐπιούσῃ εἰς",{"noteId":862},"Νεάπολιν,"]},{"type":"verse","number":12,"content":[{"noteId":863},"ἐκεῖθέν τε εἰς Φιλίππους, ἥτις ἐστὶ",{"noteId":864},"πρώτη τῆς μερίδος τῆς Μακεδονίας πόλις,",{"noteId":865},"κολωνεία· ἦμεν δὲ ἐν",{"noteId":866},"αὐτῇ τῇ πόλει διατρίβοντες ἡμέρας τινάς."]},{"type":"verse","number":13,"content":["Τῇ τε ἡμέρᾳ τῶν σαββάτων ἐξήλθομεν ἔξω τῆς",{"noteId":867},"πόλεως παρὰ ποταμόν, οὗ",{"noteId":868},"ἐνομίζετο προσευχὴ εἶναι, καὶ καθίσαντες ἐλαλοῦμεν ταῖς συνελθούσαις γυναιξί."]},{"type":"verse","number":14,"content":["Καί τις γυνὴ ὀνόματι Λυδία, πορφυρόπωλις πόλεως Θυατείρων, σεβομένη τὸν Θεόν, ἤκουεν· ἧς ὁ Κύριος διήνοιξε τὴν καρδίαν, προσέχειν τοῖς λαλουμένοις ὑπὸ",{"noteId":869},"τοῦ Παύλου."]},{"type":"verse","number":15,"content":["Ὡς δὲ",{"noteId":870},"ἐβαπτίσθη, καὶ ὁ οἶκος αὐτῆς, παρεκάλεσε λέγουσα, Εἰ κεκρίκατέ με πιστὴν τῷ Κυρίῳ εἶναι, εἰσελθόντες εἰς τὸν οἶκόν μου,",{"noteId":871},"μείνατε. Καὶ παρεβιάσατο ἡμᾶς."]},{"type":"heading","content":["Paul and Silas Imprisoned in Philippi"]},{"type":"verse","number":16,"content":["Ἐγένετο δὲ πορευομένων ἡμῶν εἰς",{"noteId":872},"προσευχήν, παιδίσκην τινὰ ἔχουσαν πνεῦμα",{"noteId":873},"Πύθωνος",{"noteId":874},"ἀπαντῆσαι ἡμῖν, ἥτις ἐργασίαν πολλὴν παρεῖχε τοῖς κυρίοις αὐτῆς, μαντευομένη."]},{"type":"verse","number":17,"content":["Αὕτη",{"noteId":875},"κατακολουθήσασα τῷ Παύλῳ καὶ",{"noteId":876},"ἡμῖν, ἔκραζε λέγουσα, Οὗτοι οἱ ἄνθρωποι δοῦλοι τοῦ Θεοῦ τοῦ ὑψίστου εἰσίν, οἵτινες καταγγέλλουσιν",{"noteId":877},"ἡμῖν ὁδὸν σωτηρίας."]},{"type":"verse","number":18,"content":["Τοῦτο δὲ ἐποίει ἐπὶ πολλὰς ἡμέρας. Διαπονηθεὶς δὲ",{"noteId":878},"ὁ Παῦλος, καὶ ἐπιστρέψας, τῷ πνεύματι εἶπε, Παραγγέλλω σοι ἐν",{"noteId":879},"τῷ ὀνόματι Ἰησοῦ Χριστοῦ, ἐξελθεῖν ἀπ᾽ αὐτῆς. Καὶ ἐξῆλθεν αὐτῇ τῇ ὥρᾳ."]},{"type":"verse","number":19,"content":["Ἰδόντες δὲ οἱ κύριοι αὐτῆς ὅτι ἐξῆλθεν ἡ ἐλπὶς τῆς ἐργασίας αὐτῶν, ἐπιλαβόμενοι τὸν Παῦλον καὶ τὸν Σίλαν, εἵλκυσαν εἰς τὴν ἀγορὰν ἐπὶ τοὺς ἄρχοντας,"]},{"type":"verse","number":20,"content":["καὶ προσαγαγόντες αὐτοὺς τοῖς στρατηγοῖς",{"noteId":880},"εἶπον, Οὗτοι οἱ ἄνθρωποι ἐκταράσσουσιν ἡμῶν τὴν πόλιν, Ἰουδαῖοι ὑπάρχοντες,"]},{"type":"verse","number":21,"content":["καὶ καταγγέλλουσιν ἔθη ἃ οὐκ ἔξεστιν ἡμῖν παραδέχεσθαι οὐδὲ ποιεῖν, Ῥωμαίοις οὖσι."]},{"type":"verse","number":22,"content":["Καὶ συνεπέστη ὁ ὄχλος κατ᾽ αὐτῶν, καὶ οἱ στρατηγοὶ",{"noteId":881},"περιρρήξαντες αὐτῶν τὰ ἱμάτια ἐκέλευον ῥαβδίζειν."]},{"type":"verse","number":23,"content":["Πολλάς",{"noteId":882},"τε ἐπιθέντες αὐτοῖς πληγὰς ἔβαλον εἰς φυλακήν, παραγγείλαντες τῷ δεσμοφύλακι ἀσφαλῶς τηρεῖν αὐτούς·"]},{"type":"verse","number":24,"content":["ὅς, παραγγελίαν τοιαύτην",{"noteId":883},"εἰληφώς, ἔβαλεν αὐτοὺς εἰς τὴν ἐσωτέραν φυλακήν, καὶ τοὺς πόδας",{"noteId":884},"αὐτῶν ἠσφαλίσατο εἰς τὸ ξύλον."]},{"type":"verse","number":25,"content":["Κατὰ δὲ τὸ μεσονύκτιον Παῦλος καὶ Σίλας προσευχόμενοι ὕμνουν τὸν Θεόν, ἐπηκροῶντο δὲ αὐτῶν οἱ δέσμιοι·"]},{"type":"verse","number":26,"content":["ἄφνω δὲ σεισμὸς ἐγένετο μέγας, ὥστε σαλευθῆναι τὰ θεμέλια τοῦ δεσμωτηρίου·",{"noteId":885},"ἀνεῴχθησάν",{"noteId":886},"τε παραχρῆμα αἱ θύραι πᾶσαι, καὶ πάντων τὰ δεσμὰ ἀνέθη."]},{"type":"verse","number":27,"content":["Ἔξυπνος δὲ γενόμενος ὁ δεσμοφύλαξ, καὶ ἰδὼν ἀνεῳγμένας τὰς θύρας τῆς φυλακῆς, σπασάμενος",{"noteId":887},"μάχαιραν,",{"noteId":888},"ἔμελλεν ἑαυτὸν ἀναιρεῖν, νομίζων ἐκπεφευγέναι τοὺς δεσμίους."]},{"type":"verse","number":28,"content":["Ἐφώνησε δὲ",{"noteId":889},"φωνῇ μεγάλῃ ὁ Παῦλος λέγων, Μηδὲν πράξῃς σεαυτῷ κακόν· ἅπαντες γάρ ἐσμεν ἐνθάδε."]},{"type":"verse","number":29,"content":["Αἰτήσας δὲ φῶτα εἰσεπήδησε, καὶ ἔντρομος γενόμενος προσέπεσε τῷ Παύλῳ καὶ",{"noteId":890},"τῷ Σίλᾳ,"]},{"type":"verse","number":30,"content":["καὶ προαγαγὼν αὐτοὺς ἔξω ἔφη, Κύριοι, τί με δεῖ ποιεῖν ἵνα σωθῶ;"]},{"type":"verse","number":31,"content":["Οἱ δὲ",{"noteId":891},"εἶπον, Πίστευσον ἐπὶ τὸν Κύριον Ἰησοῦν",{"noteId":892},"Χριστόν, καὶ σωθήσῃ σὺ καὶ ὁ οἶκός σου."]},{"type":"verse","number":32,"content":["Καὶ ἐλάλησαν αὐτῷ τὸν λόγον τοῦ",{"noteId":893},"Κυρίου,",{"noteId":894},"καὶ πᾶσι τοῖς ἐν τῇ οἰκίᾳ αὐτοῦ."]},{"type":"verse","number":33,"content":["Καὶ παραλαβὼν αὐτοὺς ἐν ἐκείνῃ τῇ ὥρᾳ τῆς νυκτὸς ἔλουσεν ἀπὸ τῶν πληγῶν, καὶ ἐβαπτίσθη αὐτὸς καὶ οἱ αὐτοῦ",{"noteId":895},"πάντες παραχρῆμα."]},{"type":"verse","number":34,"content":["Ἀναγαγών τε αὐτοὺς εἰς τὸν οἶκον",{"noteId":896},"αὐτοῦ παρέθηκε τράπεζαν, καὶ",{"noteId":897},"ἠγαλλιᾶτο",{"noteId":898},"πανοικὶ πεπιστευκὼς τῷ Θεῷ."]},{"type":"verse","number":35,"content":["Ἡμέρας δὲ γενομένης, ἀπέστειλαν οἱ στρατηγοὶ τοὺς ῥαβδούχους λέγοντες, Ἀπόλυσον τοὺς ἀνθρώπους ἐκείνους."]},{"type":"verse","number":36,"content":["Ἀπήγγειλε δὲ ὁ δεσμοφύλαξ τοὺς λόγους",{"noteId":899},"τούτους πρὸς τὸν Παῦλον ὅτι",{"noteId":900},"Ἀπεστάλκασιν οἱ στρατηγοί, ἵνα ἀπολυθῆτε· νῦν οὖν ἐξελθόντες πορεύεσθε ἐν εἰρήνῃ."]},{"type":"verse","number":37,"content":["Ὁ δὲ Παῦλος ἔφη πρὸς αὐτούς,",{"noteId":901},"Δείραντες ἡμᾶς δημοσίᾳ, ἀκατακρίτους, ἀνθρώπους Ῥωμαίους ὑπάρχοντας,",{"noteId":902},"ἔβαλον εἰς φυλακήν, καὶ νῦν λάθρᾳ ἡμᾶς ἐκβάλλουσιν; Οὐ γάρ·",{"noteId":903},"ἀλλὰ ἐλθόντες αὐτοὶ",{"noteId":904},"ἐξαγαγέτωσαν."]},{"type":"verse","number":38,"content":[{"noteId":905},"Ἀνήγγειλαν δὲ τοῖς στρατηγοῖς οἱ ῥαβδοῦχοι τὰ ῥήματα ταῦτα·",{"noteId":906},"καὶ ἐφοβήθησαν ἀκούσαντες ὅτι Ῥωμαῖοί εἰσι,"]},{"type":"verse","number":39,"content":["καὶ ἐλθόντες παρεκάλεσαν αὐτούς, καὶ ἐξαγαγόντες ἠρώτων",{"noteId":907},"ἐξελθεῖν τῆς πόλεως."]},{"type":"verse","number":40,"content":["Ἐξελθόντες δὲ",{"noteId":908},"ἐκ τῆς φυλακῆς εἰσῆλθον",{"noteId":909},"πρὸς τὴν Λυδίαν· καὶ ἰδόντες",{"noteId":910},"τοὺς ἀδελφούς, παρεκάλεσαν αὐτούς, καὶ",{"noteId":911},"ἐξῆλθον."]}],"footnotes":[{"noteId":836,"caller":"+","text":"δε ¦ δε και CT","reference":{"chapter":16,"verse":1}},{"noteId":837,"caller":"+","text":"λυστραν ¦ εις λυστραν CT","reference":{"chapter":16,"verse":1}},{"noteId":838,"caller":"+","text":"τινος ¦ — CT","reference":{"chapter":16,"verse":1}},{"noteId":839,"caller":"+","text":"ηδεισαν ¦ ηδεσαν PCK","reference":{"chapter":16,"verse":3}},{"noteId":840,"caller":"+","text":"τον πατερα αυτου οτι ελλην ¦ οτι ελλην ο πατηρ αυτου CT","reference":{"chapter":16,"verse":3}},{"noteId":841,"caller":"+","text":"παρεδιδουν ¦ παρεδιδοσαν CT","reference":{"chapter":16,"verse":4}},{"noteId":842,"caller":"+","text":"των ¦ — CT","reference":{"chapter":16,"verse":4}},{"noteId":843,"caller":"+","text":"ιερουσαλημ ¦ ιεροσολυμοις CT","reference":{"chapter":16,"verse":4}},{"noteId":844,"caller":"+","text":"διελθοντες ¦ διηλθον CT","reference":{"chapter":16,"verse":6}},{"noteId":845,"caller":"+","