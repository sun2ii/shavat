{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"ACT","translationId":"grc_tcg","name":"ΠΡΑΞΕΙΣ ΑΠΟΣΤΟΛΩΝ","commonName":"ΠΡΑΞΕΙΣ ΑΠΟΣΤΟΛΩΝ","title":"ΠΡΑΞΕΙΣ ΑΠΟΣΤΟΛΩΝ","order":44,"numberOfChapters":28,"sha256":"48e9a8e0b6fb250740e05bcd60c2bf9812f031e81131b85aa63fee38c8ac784c","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/ACT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/grc_tcg/ACT/28.json","totalNumberOfVerses":1004},"chapter":{"number":24,"content":[{"type":"heading","content":["The Accusation Against Paul"]},{"type":"verse","number":1,"content":["Μετὰ δὲ πέντε ἡμέρας κατέβη ὁ ἀρχιερεὺς Ἀνανίας μετὰ",{"noteId":1271},"τῶν πρεσβυτέρων καὶ ῥήτορος Τερτύλλου τινός, οἵτινες ἐνεφάνισαν τῷ ἡγεμόνι κατὰ τοῦ Παύλου."]},{"type":"verse","number":2,"content":["Κληθέντος δὲ αὐτοῦ, ἤρξατο κατηγορεῖν ὁ Τέρτυλλος λέγων, Πολλῆς εἰρήνης τυγχάνοντες διὰ σοῦ, καὶ",{"noteId":1272},"κατορθωμάτων γινομένων τῷ ἔθνει τούτῳ διὰ τῆς σῆς προνοίας,"]},{"type":"verse","number":3,"content":["πάντῃ τε καὶ πανταχοῦ ἀποδεχόμεθα, κράτιστε Φῆλιξ, μετὰ πάσης εὐχαριστίας."]},{"type":"verse","number":4,"content":["Ἵνα δὲ μὴ ἐπὶ",{"noteId":1273},"πλεῖόν σε",{"noteId":1274},"ἐγκόπτω, παρακαλῶ ἀκοῦσαί σε ἡμῶν συντόμως τῇ σῇ",{"noteId":1275},"ἐπιεικείᾳ."]},{"type":"verse","number":5,"content":["Εὑρόντες γὰρ τὸν ἄνδρα τοῦτον λοιμόν, καὶ",{"noteId":1276},"κινοῦντα",{"noteId":1277},"στάσιν πᾶσι τοῖς Ἰουδαίοις τοῖς κατὰ τὴν οἰκουμένην, πρωτοστάτην τε τῆς τῶν Ναζωραίων αἱρέσεως·"]},{"type":"verse","number":6,"content":["ὃς καὶ τὸ ἱερὸν ἐπείρασε βεβηλῶσαι· ὃν καὶ",{"noteId":1278},"ἐκρατήσαμεν·"]},{"type":"verse","number":8,"content":["παρ᾽ οὗ δυνήσῃ, αὐτὸς ἀνακρίνας, περὶ πάντων τούτων ἐπιγνῶναι ὧν ἡμεῖς κατηγοροῦμεν αὐτοῦ."]},{"type":"verse","number":9,"content":[{"noteId":1279},"Συνεπέθεντο δὲ καὶ οἱ Ἰουδαῖοι, φάσκοντες ταῦτα οὕτως ἔχειν."]},{"type":"heading","content":["Paul's Defense Before Felix"]},{"type":"verse","number":10,"content":["Ἀπεκρίθη",{"noteId":1280},"δὲ ὁ Παῦλος, νεύσαντος αὐτῷ τοῦ ἡγεμόνος λέγειν, Ἐκ πολλῶν ἐτῶν ὄντα σε",{"noteId":1281},"κριτὴν τῷ ἔθνει τούτῳ ἐπιστάμενος,",{"noteId":1282},"εὐθυμότερον τὰ περὶ ἐμαυτοῦ ἀπολογοῦμαι,"]},{"type":"verse","number":11,"content":["δυναμένου σου",{"noteId":1283},"γνῶναι ὅτι οὐ πλείους εἰσί μοι ἡμέραι",{"noteId":1284},"δεκαδύο, ἀφ᾽ ἧς ἀνέβην προσκυνήσων",{"noteId":1285},"ἐν Ἱερουσαλήμ·"]},{"type":"verse","number":12,"content":["καὶ οὔτε ἐν τῷ ἱερῷ εὗρόν με πρός τινα διαλεγόμενον ἢ",{"noteId":1286},"ἐπισύστασιν ποιοῦντα ὄχλου, οὔτε ἐν ταῖς συναγωγαῖς, οὔτε κατὰ τὴν πόλιν."]},{"type":"verse","number":13,"content":[{"noteId":1287},"Οὔτε",{"noteId":1288},"παραστῆσαί με",{"noteId":1289},"δύνανται περὶ ὧν",{"noteId":1290},"νῦν κατηγοροῦσί μου."]},{"type":"verse","number":14,"content":["Ὁμολογῶ δὲ τοῦτό σοι, ὅτι κατὰ τὴν ὁδὸν ἣν λέγουσιν αἵρεσιν, οὕτω λατρεύω τῷ πατρῴῳ Θεῷ, πιστεύων πᾶσι τοῖς κατὰ τὸν νόμον καὶ τοῖς",{"noteId":1291},"προφήταις γεγραμμένοις·"]},{"type":"verse","number":15,"content":["ἐλπίδα ἔχων εἰς τὸν Θεόν, ἣν καὶ αὐτοὶ οὗτοι προσδέχονται, ἀνάστασιν μέλλειν ἔσεσθαι",{"noteId":1292},"νεκρῶν, δικαίων τε καὶ ἀδίκων."]},{"type":"verse","number":16,"content":["Ἐν τούτῳ",{"noteId":1293},"δὲ αὐτὸς ἀσκῶ, ἀπρόσκοπον συνείδησιν",{"noteId":1294},"ἔχων",{"noteId":1295},"πρὸς τὸν Θεὸν καὶ τοὺς ἀνθρώπους διὰ παντός."]},{"type":"verse","number":17,"content":["Δι᾽ ἐτῶν δὲ πλειόνων",{"noteId":1296},"παρεγενόμην ἐλεημοσύνας ποιήσων εἰς τὸ ἔθνος μου καὶ προσφοράς·"]},{"type":"verse","number":18,"content":["ἐν",{"noteId":1297},"οἷς εὗρόν με ἡγνισμένον ἐν τῷ ἱερῷ, οὐ μετὰ ὄχλου οὐδὲ μετὰ θορύβου,",{"noteId":1298},"τινὲς ἀπὸ τῆς Ἀσίας Ἰουδαῖοι·"]},{"type":"verse","number":19,"content":["οὓς",{"noteId":1299},"δεῖ ἐπὶ σοῦ παρεῖναι καὶ κατηγορεῖν εἴ τι ἔχοιεν πρός",{"noteId":1300},"με."]},{"type":"verse","number":20,"content":["Ἢ αὐτοὶ οὗτοι εἰπάτωσαν,",{"noteId":1301},"τί εὗρον",{"noteId":1302},"ἐν ἐμοὶ ἀδίκημα, στάντος μου ἐπὶ τοῦ συνεδρίου,"]},{"type":"verse","number":21,"content":["ἢ περὶ μιᾶς ταύτης φωνῆς, ἧς",{"noteId":1303},"ἔκραξα",{"noteId":1304},"ἑστὼς ἐν αὐτοῖς, ὅτι Περὶ ἀναστάσεως νεκρῶν ἐγὼ κρίνομαι σήμερον",{"noteId":1305},"ὑφ᾽ ὑμῶν."]},{"type":"verse","number":22,"content":[{"noteId":1306},"Ἀκούσας δὲ ταῦτα ὁ Φῆλιξ ἀνεβάλετο αὐτούς, ἀκριβέστερον εἰδὼς τὰ περὶ τῆς ὁδοῦ,",{"noteId":1307},"εἰπών, Ὅταν Λυσίας ὁ χιλίαρχος καταβῇ, διαγνώσομαι τὰ καθ᾽ ὑμᾶς·"]},{"type":"verse","number":23,"content":["διαταξάμενός",{"noteId":1308},"τε τῷ ἑκατοντάρχῃ τηρεῖσθαι",{"noteId":1309},"τὸν Παῦλον, ἔχειν τε ἄνεσιν, καὶ μηδένα κωλύειν τῶν ἰδίων αὐτοῦ ὑπηρετεῖν",{"noteId":1310},"ἢ προσέρχεσθαι αὐτῷ."]},{"type":"heading","content":["Paul Held in Custody"]},{"type":"verse","number":24,"content":["Μετὰ δὲ ἡμέρας τινάς, παραγενόμενος ὁ Φῆλιξ σὺν Δρουσίλλῃ τῇ",{"noteId":1311},"γυναικὶ οὔσῃ Ἰουδαίᾳ, μετεπέμψατο τὸν Παῦλον, καὶ ἤκουσεν αὐτοῦ περὶ τῆς εἰς",{"noteId":1312},"Χριστὸν πίστεως."]},{"type":"verse","number":25,"content":["Διαλεγομένου δὲ αὐτοῦ περὶ δικαιοσύνης καὶ ἐγκρατείας καὶ τοῦ κρίματος τοῦ μέλλοντος",{"noteId":1313},"ἔσεσθαι, ἔμφοβος γενόμενος ὁ Φῆλιξ ἀπεκρίθη, Τὸ νῦν ἔχον πορεύου· καιρὸν δὲ μεταλαβὼν μετακαλέσομαί σε·"]},{"type":"verse","number":26,"content":["ἅμα",{"noteId":1314},"καὶ ἐλπίζων ὅτι χρήματα δοθήσεται αὐτῷ ὑπὸ τοῦ Παύλου,",{"noteId":1315},"ὅπως λύσῃ αὐτόν· διὸ καὶ πυκνότερον",{"noteId":1316},"αὐτὸν μεταπεμπόμενος ὡμίλει αὐτῷ."]},{"type":"verse","number":27,"content":["Διετίας δὲ πληρωθείσης, ἔλαβε διάδοχον ὁ Φῆλιξ Πόρκιον Φῆστον· θέλων",{"noteId":1317},"τε",{"noteId":1318},"χάριτας καταθέσθαι τοῖς Ἰουδαίοις ὁ Φῆλιξ κατέλιπε τὸν Παῦλον δεδεμένον."]}],"footnotes":[{"noteId":1271,"caller":"+","text":"των πρεσβυτερων 83.4% ¦ πρεσβυτερων τινων CT 14.9%","reference":{"chapter":24,"verse":1}},{"noteId":1272,"caller":"+","text":"κατορθωματων ¦ διορθωματων CT","reference":{"chapter":24,"verse":2}},{"noteId":1273,"caller":"+","text":"πλειον ¦ πλεον PCK","reference":{"chapter":24,"verse":4}},{"noteId":1274,"caller":"+","text":"εγκοπτω ¦ ενκοπτω TH WH","reference":{"chapter":24,"verse":4}},{"noteId":1275,"caller":"+","text":"επιεικεια ¦ επιεικια WH","reference":{"chapter":24,"verse":4}},{"noteId":1276,"caller":"+","text":"κινουντα ¦ κεινουντα TH","reference":{"chapter":24,"verse":5}},{"noteId":1277,"caller":"+","text":"στασιν ¦ στασεις CT","reference":{"chapter":24,"verse":5}},{"noteId":1278,"caller":"+","text":"εκρατησαμεν 8παρ 55.3% ¦ εκρατησαμεν και κατα τον ημετερον νομον ηθελησαμεν κριναι (κρινειν ANT TR 1%) 7παρελθων δε λυσιας ο χιλιαρχος μετα πολλης βιας εκ των χειρων ημων απηγαγε 8κελευσας τους κατηγορους αυτου ερχεσθαι επι σε (σου MSS 5.7%) παρ ECM 9.3% {Note: The longer text is found in 43.9% of manuscripts in eighteen different readings. As a whole, the longer reading has the 𝔐pt label. The reading printed in ECM is enclosed with double brackets.}","reference":{"chapter":24,"verse":6}},{"noteId":1279,"caller":"+","text":"συνεπεθεντο ¦ συνεθεντο TR","reference":{"chapter":24,"verse":9}},{"noteId":1280,"caller":"+","text":"δε ¦ τε CT","reference":{"chapter":24,"verse":10}},{"noteId":1281,"caller":"+","text":"κριτην ¦ κριτην δικαιον PCK","reference":{"chapter":24,"verse":10}},{"noteId":1282,"caller":"+","text":"ευθυμοτερον ¦ ευθυμως CT","reference":{"chapter":24,"verse":10}},{"noteId":1283,"caller":"+","text":"γνωναι ¦ επιγνωναι CT","reference":{"chapter":24,"verse":11}},{"noteId":1284,"caller":"+","text":"δεκαδυο ¦ η δεκαδυο TR ¦ δωδεκα CT","reference":{"