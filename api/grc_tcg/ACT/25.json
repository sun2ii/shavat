{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"ACT","translationId":"grc_tcg","name":"ΠΡΑΞΕΙΣ ΑΠΟΣΤΟΛΩΝ","commonName":"ΠΡΑΞΕΙΣ ΑΠΟΣΤΟΛΩΝ","title":"ΠΡΑΞΕΙΣ ΑΠΟΣΤΟΛΩΝ","order":44,"numberOfChapters":28,"sha256":"48e9a8e0b6fb250740e05bcd60c2bf9812f031e81131b85aa63fee38c8ac784c","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/ACT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/grc_tcg/ACT/28.json","totalNumberOfVerses":1004},"chapter":{"number":25,"content":[{"type":"heading","content":["Paul's Trial Before Festus"]},{"type":"verse","number":1,"content":["Φῆστος οὖν ἐπιβὰς τῇ",{"noteId":1319},"ἐπαρχίᾳ, μετὰ τρεῖς ἡμέρας ἀνέβη εἰς Ἱεροσόλυμα ἀπὸ",{"noteId":1320},"Καισαρείας."]},{"type":"verse","number":2,"content":["Ἐνεφάνισαν",{"noteId":1321},"δὲ αὐτῷ",{"noteId":1322},"ὁ ἀρχιερεὺς καὶ οἱ πρῶτοι τῶν Ἰουδαίων κατὰ τοῦ Παύλου, καὶ παρεκάλουν αὐτόν,"]},{"type":"verse","number":3,"content":["αἰτούμενοι χάριν κατ᾽ αὐτοῦ, ὅπως μεταπέμψηται αὐτὸν εἰς Ἱερουσαλήμ, ἐνέδραν ποιοῦντες ἀνελεῖν αὐτὸν κατὰ τὴν ὁδόν."]},{"type":"verse","number":4,"content":["Ὁ μὲν οὖν Φῆστος ἀπεκρίθη, τηρεῖσθαι τὸν Παῦλον",{"noteId":1323},"ἐν Καισαρείᾳ, ἑαυτὸν δὲ μέλλειν ἐν τάχει ἐκπορεύεσθαι."]},{"type":"verse","number":5,"content":["Οἱ οὖν",{"noteId":1324},"δυνατοὶ ἐν ὑμῖν, φησί,",{"noteId":1325},"συγκαταβάντες, εἴ τί ἐστιν",{"noteId":1326},"ἐν τῷ ἀνδρὶ τούτῳ, κατηγορείτωσαν αὐτοῦ."]},{"type":"verse","number":6,"content":["Διατρίψας δὲ ἐν αὐτοῖς ἡμέρας",{"noteId":1327},"πλείους ἢ δέκα, καταβὰς εἰς",{"noteId":1328},"Καισάρειαν, τῇ ἐπαύριον καθίσας ἐπὶ τοῦ βήματος ἐκέλευσε τὸν Παῦλον ἀχθῆναι."]},{"type":"verse","number":7,"content":["Παραγενομένου δὲ αὐτοῦ,",{"noteId":1329},"περιέστησαν οἱ ἀπὸ Ἱεροσολύμων καταβεβηκότες Ἰουδαῖοι, πολλὰ καὶ βαρέα",{"noteId":1330},"αἰτιώματα",{"noteId":1331},"φέροντες κατὰ τοῦ Παύλου, ἃ οὐκ ἴσχυον ἀποδεῖξαι,"]},{"type":"verse","number":8,"content":[{"noteId":1332},"ἀπολογουμένου αὐτοῦ ὅτι Οὔτε εἰς τὸν νόμον τῶν Ἰουδαίων, οὔτε εἰς τὸ ἱερόν, οὔτε εἰς Καίσαρά τι ἥμαρτον."]},{"type":"verse","number":9,"content":["Ὁ Φῆστος δὲ",{"noteId":1333},"τοῖς Ἰουδαίοις θέλων χάριν καταθέσθαι, ἀποκριθεὶς τῷ Παύλῳ εἶπε, Θέλεις εἰς",{"noteId":1334},"Ἱεροσόλυμα ἀναβάς, ἐκεῖ περὶ τούτων",{"noteId":1335},"κρίνεσθαι",{"noteId":1336},"ἐπ᾽ ἐμοῦ;"]},{"type":"verse","number":10,"content":["Εἶπε δὲ ὁ Παῦλος,",{"noteId":1337},"Ἐπὶ τοῦ βήματος Καίσαρος ἑστώς εἰμι, οὗ με δεῖ κρίνεσθαι· Ἰουδαίους οὐδὲν",{"noteId":1338},"ἠδίκησα, ὡς καὶ σὺ κάλλιον ἐπιγινώσκεις."]},{"type":"verse","number":11,"content":["Εἰ μὲν",{"noteId":1339},"γὰρ ἀδικῶ καὶ ἄξιον θανάτου πέπραχά τι, οὐ παραιτοῦμαι τὸ ἀποθανεῖν· εἰ δὲ οὐδέν ἐστιν ὧν οὗτοι κατηγοροῦσί μου, οὐδείς με δύναται αὐτοῖς χαρίσασθαι. Καίσαρα ἐπικαλοῦμαι."]},{"type":"verse","number":12,"content":["Τότε ὁ Φῆστος",{"noteId":1340},"συλλαλήσας μετὰ τοῦ συμβουλίου ἀπεκρίθη, Καίσαρα ἐπικέκλησαι; Ἐπὶ Καίσαρα πορεύσῃ."]},{"type":"heading","content":["Festus Consults King Agrippa"]},{"type":"verse","number":13,"content":["Ἡμερῶν δὲ διαγενομένων τινῶν, Ἀγρίππας ὁ βασιλεὺς καὶ Βερνίκη κατήντησαν εἰς",{"noteId":1341},"Καισάρειαν,",{"noteId":1342},"ἀσπασάμενοι τὸν Φῆστον."]},{"type":"verse","number":14,"content":["Ὡς δὲ πλείους ἡμέρας",{"noteId":1343},"διέτριβεν ἐκεῖ, ὁ Φῆστος τῷ βασιλεῖ ἀνέθετο τὰ κατὰ τὸν Παῦλον, λέγων, Ἀνήρ τίς ἐστι",{"noteId":1344},"καταλελειμμένος ὑπὸ Φήλικος δέσμιος,"]},{"type":"verse","number":15,"content":["περὶ οὗ, γενομένου μου εἰς Ἱεροσόλυμα, ἐνεφάνισαν οἱ ἀρχιερεῖς καὶ οἱ πρεσβύτεροι τῶν Ἰουδαίων, αἰτούμενοι κατ᾽ αὐτοῦ",{"noteId":1345},"δίκην."]},{"type":"verse","number":16,"content":["Πρὸς οὓς ἀπεκρίθην, ὅτι οὐκ ἔστιν ἔθος Ῥωμαίοις χαρίζεσθαί τινα ἄνθρωπον",{"noteId":1346},"εἰς ἀπώλειαν, πρὶν ἢ ὁ κατηγορούμενος κατὰ πρόσωπον ἔχοι τοὺς κατηγόρους, τόπον τε ἀπολογίας λάβοι περὶ τοῦ ἐγκλήματος."]},{"type":"verse","number":17,"content":["Συνελθόντων οὖν",{"noteId":1347},"αὐτῶν ἐνθάδε, ἀναβολὴν μηδεμίαν ποιησάμενος, τῇ ἑξῆς καθίσας ἐπὶ τοῦ βήματος, ἐκέλευσα ἀχθῆναι τὸν ἄνδρα·"]},{"type":"verse","number":18,"content":["περὶ οὗ σταθέντες οἱ κατήγοροι οὐδεμίαν αἰτίαν",{"noteId":1348},"ἐπέφερον ὧν",{"noteId":1349},"ὑπενόουν ἐγώ,"]},{"type":"verse","number":19,"content":["ζητήματα δέ τινα περὶ τῆς ἰδίας δεισιδαιμονίας εἶχον πρὸς αὐτόν, καὶ περί τινος Ἰησοῦ τεθνηκότος, ὃν ἔφασκεν ὁ Παῦλος ζῇν."]},{"type":"verse","number":20,"content":["Ἀπορούμενος δὲ ἐγὼ",{"noteId":1350},"τὴν περὶ",{"noteId":1351},"τούτου ζήτησιν, ἔλεγον, εἰ βούλοιτο πορεύεσθαι εἰς",{"noteId":1352},"Ἱερουσαλήμ, κἀκεῖ κρίνεσθαι περὶ τούτων."]},{"type":"verse","number":21,"content":["Τοῦ δὲ Παύλου ἐπικαλεσαμένου τηρηθῆναι αὐτὸν εἰς τὴν τοῦ Σεβαστοῦ διάγνωσιν, ἐκέλευσα τηρεῖσθαι αὐτόν, ἕως οὗ",{"noteId":1353},"πέμψω αὐτὸν πρὸς Καίσαρα."]},{"type":"verse","number":22,"content":["Ἀγρίππας δὲ πρὸς τὸν Φῆστον",{"noteId":1354},"ἔφη, Ἐβουλόμην καὶ αὐτὸς τοῦ ἀνθρώπου ἀκοῦσαι.",{"noteId":1355},"Ὁ δέ, Αὔριον, φησίν, ἀκούσῃ αὐτοῦ."]},{"type":"heading","content":["Paul Brought Before King Agrippa"]},{"type":"verse","number":23,"content":["Τῇ οὖν ἐπαύριον, ἐλθόντος τοῦ Ἀγρίππα καὶ τῆς Βερνίκης μετὰ πολλῆς φαντασίας, καὶ εἰσελθόντων εἰς τὸ ἀκροατήριον, σύν τε",{"noteId":1356},"τοῖς χιλιάρχοις καὶ ἀνδράσι τοῖς κατ᾽ ἐξοχὴν",{"noteId":1357},"οὖσι τῆς πόλεως, καὶ κελεύσαντος τοῦ Φήστου, ἤχθη ὁ Παῦλος."]},{"type":"verse","number":24,"content":["Καί φησιν ὁ Φῆστος, Ἀγρίππα βασιλεῦ, καὶ πάντες οἱ",{"noteId":1358},"συμπαρόντες ἡμῖν ἄνδρες, θεωρεῖτε τοῦτον περὶ οὗ",{"noteId":1359},"πᾶν τὸ πλῆθος τῶν Ἰουδαίων",{"noteId":1360},"ἐνέτυχόν μοι ἔν τε Ἱεροσολύμοις καὶ ἐνθάδε,",{"noteId":1361},"ἐπιβοῶντες μὴ δεῖν",{"noteId":1362},"ζῇν αὐτὸν μηκέτι."]},{"type":"verse","number":25,"content":["Ἐγὼ δὲ",{"noteId":1363},"καταλαβόμενος μηδὲν ἄξιον",{"noteId":1364},"θανάτου αὐτὸν πεπραχέναι,",{"noteId":1365},"καὶ αὐτοῦ δὲ τούτου ἐπικαλεσαμένου τὸν Σεβαστόν, ἔκρινα πέμπειν",{"noteId":1366},"αὐτόν."]},{"type":"verse","number":26,"content":["Περὶ οὗ ἀσφαλές τι γράψαι τῷ κυρίῳ οὐκ ἔχω. Διὸ προήγαγον αὐτὸν ἐφ᾽ ὑμῶν, καὶ μάλιστα ἐπὶ σοῦ, βασιλεῦ Ἀγρίππα, ὅπως τῆς ἀνακρίσεως γενομένης σχῶ",{"noteId":1367},"τι γράψαι."]},{"type":"verse","number":27,"content":["Ἄλογον γάρ μοι δοκεῖ, πέμποντα δέσμιον, μὴ καὶ τὰς κατ᾽ αὐτοῦ αἰτίας σημᾶναι."]}],"footnotes":[{"noteId":1319,"caller":"+","text":"επαρχια ¦ επαρχεια CT","reference":{"chapter":25,"verse":1}},{"noteId":1320,"caller":"+","text":"καισαρειας ¦ καισαριας WH","reference":{"chapter":25,"verse":1}},{"noteId":1321,"caller":"+","text":"δε ¦ τε CT","reference":{"chapter":25,"verse":2}},{"noteId":1322,"caller":"+","text":"ο αρχιερευς ¦ οι αρχιερεις CT PCK","reference":{"chapter":25,"verse":2}},{"noteId":1323,"caller":"+","text":"εν καισαρεια ¦ εις καισαρειαν ECM NA SBL TH ¦ εις καισαριαν WH","reference":{"chapter":25,"verse":4}},{"noteId":1324,"caller":"+","text":"δυνατοι εν υμιν φησι ¦ εν υμιν φησι δυνατοι CT","reference":{"chapter":25,"verse":5}},{"noteId":1325,"caller":"+","text":"συγκαταβαντες ¦ συνκαταβαντες TH WH","reference":{"chapter":25,"verse":5}},{"noteId":1326,"caller":"+","text":"εν τω ανδρι τουτω 72.6% ¦ εν τω ανδρι τουτω ατοπον MSS 14.2% ¦ εν τω ανδρι ατοπον CT 9.3% ¦ ατοπον εν τω ανδρι τουτω SCR 2.9%","reference":{"chapter":25,"verse":5}},{"noteId":1327,"caller":"+","text":"πλειους ¦ ου πλειους οκτω CT","reference":{"chapter":25,"verse":6}},{"noteId":1328,"caller":"+","text":"καισαρειαν ¦ καισαριαν WH","reference":{"chapter":25,"verse":6}},{"noteId":1329,"caller":"+","text":"περιεστησ