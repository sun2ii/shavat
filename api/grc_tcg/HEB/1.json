{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"HEB","translationId":"grc_tcg","name":"ΠΡΟΣ ΕΒΡΑΙΟΥΣ","commonName":"ΠΡΟΣ ΕΒΡΑΙΟΥΣ","title":"ΠΡΟΣ ΕΒΡΑΙΟΥΣ","order":58,"numberOfChapters":13,"sha256":"e4ca5c2ed1c3a143929af08d49adfd5ee036615fb6799337d5301aab408037f0","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/grc_tcg/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["God Has Spoken Through His Son"]},{"type":"verse","number":1,"content":["Πολυμερῶς καὶ πολυτρόπως πάλαι ὁ Θεὸς λαλήσας τοῖς πατράσιν ἐν τοῖς προφήταις, ἐπ᾽",{"noteId":0},"ἐσχάτου τῶν ἡμερῶν τούτων ἐλάλησεν ἡμῖν ἐν υἱῷ,"]},{"type":"verse","number":2,"content":["ὃν ἔθηκε κληρονόμον πάντων, δι᾽ οὗ καὶ",{"noteId":1},"τοὺς αἰῶνας ἐποίησεν,"]},{"type":"verse","number":3,"content":["ὃς ὢν ἀπαύγασμα τῆς δόξης καὶ χαρακτὴρ τῆς ὑποστάσεως αὐτοῦ, φέρων τε τὰ πάντα τῷ ῥήματι τῆς δυνάμεως",{"noteId":2},"αὐτοῦ, δι᾽ ἑαυτοῦ καθαρισμὸν",{"noteId":3},"ποιησάμενος τῶν ἁμαρτιῶν ἡμῶν, ἐκάθισεν ἐν δεξιᾷ τῆς μεγαλωσύνης ἐν ὑψηλοῖς,"]},{"type":"verse","number":4,"content":["τοσούτῳ κρείττων γενόμενος τῶν ἀγγέλων, ὅσῳ διαφορώτερον παρ᾽ αὐτοὺς κεκληρονόμηκεν ὄνομα."]},{"type":"heading","content":["The Son Is Superior to Angels"]},{"type":"verse","number":5,"content":["Τίνι γὰρ εἶπέ ποτε τῶν ἀγγέλων,",{"lineBreak":true},{"text":"Υἱός μου εἶ σύ,","poem":1},{"lineBreak":true},{"text":"ἐγὼ σήμερον γεγέννηκά σε;","poem":1},{"lineBreak":true},"Καὶ πάλιν,",{"lineBreak":true},{"text":"Ἐγὼ ἔσομαι αὐτῷ εἰς πατέρα,","poem":1},{"lineBreak":true},{"text":"καὶ αὐτὸς ἔσται μοι εἰς υἱόν;","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":["Ὅταν δὲ πάλιν εἰσαγάγῃ τὸν πρωτότοκον εἰς τὴν οἰκουμένην λέγει,",{"lineBreak":true},{"text":"Καὶ προσκυνησάτωσαν αὐτῷ πάντες ἄγγελοι Θεοῦ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":["Καὶ πρὸς μὲν τοὺς ἀγγέλους λέγει,",{"lineBreak":true},{"text":"Ὁ ποιῶν τοὺς ἀγγέλους αὐτοῦ πνεύματα,","poem":1},{"lineBreak":true},{"text":"καὶ τοὺς λειτουργοὺς αὐτοῦ πυρὸς φλόγα·","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":["πρὸς δὲ τὸν υἱόν,",{"lineBreak":true},{"text":"Ὁ θρόνος σου, ὁ Θεός, εἰς τὸν αἰῶνα τοῦ","poem":1},{"noteId":4},{"text":"αἰῶνος·","poem":1},{"lineBreak":true},{"noteId":5},{"text":"ῥάβδος εὐθύτητος ἡ ῥάβδος τῆς βασιλείας","poem":1},{"noteId":6},{"text":"σου.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ἠγάπησας δικαιοσύνην, καὶ ἐμίσησας ἀνομίαν·","poem":1},{"lineBreak":true},{"text":"διὰ τοῦτο ἔχρισέ σε ὁ Θεός, ὁ Θεός σου,","poem":1},{"lineBreak":true},{"text":"ἔλαιον ἀγαλλιάσεως παρὰ τοὺς μετόχους σου.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":["Καί,",{"lineBreak":true},{"text":"Σὺ κατ᾽ ἀρχάς, Κύριε, τὴν γῆν ἐθεμελίωσας,","poem":1},{"lineBreak":true},{"text":"καὶ ἔργα τῶν χειρῶν σού εἰσιν οἱ οὐρανοί·","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"αὐτοὶ ἀπολοῦνται, σὺ δὲ διαμένεις·","poem":1},{"lineBreak":true},{"text":"καὶ πάντες ὡς ἱμάτιον παλαιωθήσονται,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"καὶ ὡσεὶ περιβόλαιον ἑλίξεις","poem":1},{"noteId":7},{"text":"αὐτούς,","poem":1},{"lineBreak":true},{"text":"καὶ ἀλλαγήσονται·","poem":1},{"lineBreak":true},{"text":"σὺ δὲ ὁ αὐτὸς εἶ,","poem":1},{"lineBreak":true},{"text":"καὶ τὰ ἔτη σου οὐκ ἐκλείψουσι.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":["Πρὸς τίνα δὲ τῶν ἀγγέλων εἴρηκέ ποτε,",{"lineBreak":true},{"text":"Κάθου ἐκ δεξιῶν μου,","poem":1},{"lineBreak":true},{"text":"ἕως ἂν θῶ τοὺς ἐχθρούς σου ὑποπόδιον τῶν ποδῶν σου;","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":["Οὐχὶ πάντες εἰσὶ λειτουργικὰ πνεύματα, εἰς διακονίαν ἀποστελλόμενα διὰ τοὺς μέλλοντας κληρονομεῖν σωτηρίαν;"]}],"footnotes":[{"noteId":0,"caller":"+","text":"εσχατου ¦ εσχατων TR","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"τους αιωνας εποιησεν ¦ εποιησε τους αιωνας CT","reference":{"chapter":1,"verse":2}},{"noteId":2,"caller":"+","text":"αὐτοῦ δι᾽ ἑαυτοῦ 89.2% ¦ αὐτοῦ NA TH WH 5.1% ¦ δι᾽ αὑτοῦ SBL 0.3%","reference":{"chapter":1,"verse":3}},{"noteId":3,"caller":"+","text":"ποιησαμενος των αμαρτιων ημων ¦ των αμαρτιων ποιησαμενος CT","reference":{"chapter":1,"verse":3}},{"noteId":4,"caller":"+","text":"αιωνος ¦ αιωνος και CT","reference":{"chapter":1,"verse":8}},{"noteId":5,"caller":"+","text":"ραβδος ευθυτητος η 97.8% ¦ η ραβδος της ευθυτητος CT 1.4%","reference":{"chapter":1,"verse":8}},{"noteId":6,"caller":"+","text":"σου ¦ αυτου WH","reference":{"chapter":1,"verse":8}},{"noteId":7,"caller":"+","text":"αυτους 98.8% ¦ αυτους ως ιματιον NA SBL WH 1.2%","reference":{"chapter":1,"verse":12}}]},"thisChapterLink":"/api/grc_tcg/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/grc_tcg/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/grc_tcg/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}