{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"HEB","translationId":"grc_tcg","name":"ΠΡΟΣ ΕΒΡΑΙΟΥΣ","commonName":"ΠΡΟΣ ΕΒΡΑΙΟΥΣ","title":"ΠΡΟΣ ΕΒΡΑΙΟΥΣ","order":58,"numberOfChapters":13,"sha256":"e4ca5c2ed1c3a143929af08d49adfd5ee036615fb6799337d5301aab408037f0","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/grc_tcg/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":3,"content":[{"type":"heading","content":["Jesus Is Superior to Moses"]},{"type":"verse","number":1,"content":["Ὅθεν, ἀδελφοὶ ἅγιοι, κλήσεως ἐπουρανίου μέτοχοι, κατανοήσατε τὸν ἀπόστολον καὶ ἀρχιερέα τῆς ὁμολογίας ἡμῶν",{"noteId":17},"Ἰησοῦν Χριστόν,"]},{"type":"verse","number":2,"content":["πιστὸν ὄντα τῷ ποιήσαντι αὐτόν, ὡς καὶ",{"noteId":18},"Μωϋσῆς ἐν",{"noteId":19},"ὅλῳ τῷ οἴκῳ αὐτοῦ."]},{"type":"verse","number":3,"content":["Πλείονος γὰρ",{"noteId":20},"δόξης οὗτος παρὰ",{"noteId":21},"Μωϋσῆν ἠξίωται, καθ᾽ ὅσον πλείονα τιμὴν ἔχει τοῦ οἴκου ὁ κατασκευάσας αὐτόν."]},{"type":"verse","number":4,"content":["Πᾶς γὰρ οἶκος κατασκευάζεται ὑπό τινος· ὁ δὲ",{"noteId":22},"τὰ πάντα κατασκευάσας Θεός."]},{"type":"verse","number":5,"content":["Καὶ",{"noteId":23},"Μωϋσῆς μὲν πιστὸς ἐν ὅλῳ τῷ οἴκῳ αὐτοῦ ὡς θεράπων, εἰς μαρτύριον τῶν λαληθησομένων·"]},{"type":"verse","number":6,"content":["Χριστὸς δὲ ὡς υἱὸς ἐπὶ τὸν οἶκον αὐτοῦ·",{"noteId":24},"οὗ οἶκός ἐσμεν ἡμεῖς,",{"noteId":25},"ἐάνπερ τὴν παρρησίαν καὶ τὸ καύχημα τῆς ἐλπίδος",{"noteId":26},"μέχρι τέλους βεβαίαν κατάσχωμεν."]},{"type":"heading","content":["Do Not Harden Your Hearts"]},{"type":"verse","number":7,"content":["Διό, καθὼς λέγει τὸ Πνεῦμα τὸ Ἅγιον,",{"lineBreak":true},{"text":"Σήμερον ἐὰν τῆς φωνῆς αὐτοῦ ἀκούσητε,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"μὴ σκληρύνητε τὰς καρδίας ὑμῶν, ὡς ἐν τῷ παραπικρασμῷ,","poem":1},{"lineBreak":true},{"text":"κατὰ τὴν ἡμέραν τοῦ πειρασμοῦ ἐν τῇ ἐρήμῳ,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"οὗ ἐπείρασάν","poem":1},{"noteId":27},{"text":"με οἱ πατέρες ὑμῶν,","poem":1},{"noteId":28},{"text":"ἐδοκίμασάν με,","poem":1},{"lineBreak":true},{"text":"καὶ εἶδον τὰ ἔργα μου","poem":1},{"noteId":29},{"text":"τεσσαράκοντα ἔτη.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Διὸ προσώχθισα τῇ γενεᾷ","poem":1},{"noteId":30},{"text":"ἐκείνῃ,","poem":1},{"lineBreak":true},{"text":"καὶ εἶπον, Ἀεὶ πλανῶνται τῇ καρδίᾳ·","poem":1},{"lineBreak":true},{"text":"αὐτοὶ δὲ οὐκ ἔγνωσαν τὰς ὁδούς μου·","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ὡς ὤμοσα ἐν τῇ ὀργῇ μου,","poem":1},{"lineBreak":true},{"text":"Εἰ εἰσελεύσονται εἰς τὴν κατάπαυσίν μου.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":["Βλέπετε, ἀδελφοί, μήποτε ἔσται ἔν τινι ὑμῶν καρδία πονηρὰ ἀπιστίας ἐν τῷ ἀποστῆναι ἀπὸ Θεοῦ ζῶντος·"]},{"type":"verse","number":13,"content":["ἀλλὰ παρακαλεῖτε ἑαυτοὺς καθ᾽ ἑκάστην ἡμέραν, ἄχρις οὗ τὸ σήμερον καλεῖται, ἵνα μὴ σκληρυνθῇ",{"noteId":31},"ἐξ ὑμῶν τις ἀπάτῃ τῆς ἁμαρτίας·"]},{"type":"verse","number":14,"content":["μέτοχοι γὰρ",{"noteId":32},"γεγόναμεν τοῦ Χριστοῦ, ἐάνπερ τὴν ἀρχὴν τῆς ὑποστάσεως μέχρι τέλους βεβαίαν κατάσχωμεν·"]},{"type":"verse","number":15,"content":["ἐν τῷ λέγεσθαι,",{"lineBreak":true},{"text":"Σήμερον ἐὰν τῆς φωνῆς αὐτοῦ ἀκούσητε,","poem":1},{"lineBreak":true},{"text":"μὴ σκληρύνητε τὰς καρδίας ὑμῶν, ὡς ἐν τῷ παραπικρασμῷ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"noteId":33},"Τινὲς γὰρ ἀκούσαντες παρεπίκραναν, ἀλλ᾽ οὐ πάντες οἱ ἐξελθόντες ἐξ Αἰγύπτου διὰ",{"noteId":34},"Μωϋσέως."]},{"type":"verse","number":17,"content":["Τίσι δὲ προσώχθισε",{"noteId":35},"τεσσαράκοντα ἔτη; Οὐχὶ τοῖς ἁμαρτήσασιν, ὧν τὰ κῶλα ἔπεσεν ἐν τῇ ἐρήμῳ;"]},{"type":"verse","number":18,"content":["Τίσι δὲ ὤμοσε μὴ εἰσελεύσεσθαι εἰς τὴν κατάπαυσιν αὐτοῦ, εἰ μὴ τοῖς ἀπειθήσασι;"]},{"type":"verse","number":19,"content":["Καὶ βλέπομεν ὅτι οὐκ ἠδυνήθησαν εἰσελθεῖν",{"noteId":36},"δι᾽ ἀπιστίαν."]}],"footnotes":[{"noteId":17,"caller":"+","text":"ιησουν χριστον ¦ χριστον ιησουν TR ¦ ιησουν CT","reference":{"chapter":3,"verse":1}},{"noteId":18,"caller":"+","text":"μωυσης ¦ μωσης TR","reference":{"chapter":3,"verse":2}},{"noteId":19,"caller":"+","text":"ολω ¦ — SBL","reference":{"chapter":3,"verse":2}},{"noteId":20,"caller":"+","text":"δοξης ουτος ¦ ουτος δοξης CT","reference":{"chapter":3,"verse":3}},{"noteId":21,"caller":"+","text":"μωυσην ¦ μωσην TR","reference":{"chapter":3,"verse":3}},{"noteId":22,"caller":"+","text":"τα ¦ — CT","reference":{"chapter":3,"verse":4}},{"noteId":23,"caller":"+","text":"μωυσης ¦ μωσης TR","reference":{"chapter":3,"verse":5}},{"noteId":24,"caller":"+","text":"ου ¦ ος SBL","reference":{"chapter":3,"verse":6}},{"noteId":25,"caller":"+","text":"εανπερ ¦ εαν SBL TH WH","reference":{"chapter":3,"verse":6}},{"noteId":26,"caller":"+","text":"μεχρι τελους βεβαιαν 95.3% ¦ — NA SBL TH 0.8%","reference":{"chapter":3,"verse":6}},{"noteId":27,"caller":"+","text":"με ¦ — CT","reference":{"chapter":3,"verse":9}},{"noteId":28,"caller":"+","text":"εδοκιμασαν με ¦ εν δοκιμασια CT","reference":{"chapter":3,"verse":9}},{"noteId":29,"caller":"+","text":"τεσσαρακοντα ¦ τεσσερακοντα CT","reference":{"chapter":3,"verse":9}},{"noteId":30,"caller":"+","text":"εκεινη ¦ ταυτη CT","reference":{"chapter":3,"verse":10}},{"noteId":31,"c