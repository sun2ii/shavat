{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"HEB","translationId":"grc_tcg","name":"ΠΡΟΣ ΕΒΡΑΙΟΥΣ","commonName":"ΠΡΟΣ ΕΒΡΑΙΟΥΣ","title":"ΠΡΟΣ ΕΒΡΑΙΟΥΣ","order":58,"numberOfChapters":13,"sha256":"e4ca5c2ed1c3a143929af08d49adfd5ee036615fb6799337d5301aab408037f0","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/grc_tcg/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":8,"content":[{"type":"heading","content":["The High Priest of the New Covenant"]},{"type":"verse","number":1,"content":["Κεφάλαιον δὲ ἐπὶ τοῖς λεγομένοις· τοιοῦτον ἔχομεν ἀρχιερέα, ὃς ἐκάθισεν ἐν δεξιᾷ τοῦ θρόνου τῆς μεγαλωσύνης ἐν τοῖς οὐρανοῖς,"]},{"type":"verse","number":2,"content":["τῶν ἁγίων λειτουργός, καὶ τῆς σκηνῆς τῆς ἀληθινῆς, ἣν ἔπηξεν ὁ Κύριος,",{"noteId":81},"καὶ οὐκ ἄνθρωπος·"]},{"type":"verse","number":3,"content":["πᾶς γὰρ ἀρχιερεὺς εἰς τὸ προσφέρειν δῶρά τε καὶ θυσίας καθίσταται· ὅθεν ἀναγκαῖον ἔχειν τι καὶ τοῦτον ὃ",{"noteId":82},"προσενέγκῃ."]},{"type":"verse","number":4,"content":["Εἰ μὲν",{"noteId":83},"γὰρ ἦν ἐπὶ γῆς, οὐδ᾽ ἂν ἦν ἱερεύς, ὄντων",{"noteId":84},"τῶν ἱερέων τῶν προσφερόντων κατὰ",{"noteId":85},"τὸν νόμον τὰ δῶρα,"]},{"type":"verse","number":5,"content":["οἵτινες ὑποδείγματι καὶ σκιᾷ λατρεύουσι τῶν ἐπουρανίων, καθὼς κεχρημάτισται",{"noteId":86},"Μωϋσῆς μέλλων ἐπιτελεῖν τὴν σκηνήν, Ὅρα, γάρ φησι,",{"noteId":87},"ποιήσεις πάντα κατὰ τὸν τύπον τὸν δειχθέντα σοι ἐν τῷ ὄρει."]},{"type":"verse","number":6,"content":[{"noteId":88},"Νυνὶ δὲ διαφορωτέρας",{"noteId":89},"τέτυχε λειτουργίας, ὅσῳ καὶ κρείττονός ἐστι διαθήκης μεσίτης, ἥτις ἐπὶ κρείττοσιν ἐπαγγελίαις νενομοθέτηται."]},{"type":"verse","number":7,"content":["Εἰ γὰρ ἡ πρώτη ἐκείνη ἦν ἄμεμπτος, οὐκ ἂν δευτέρας ἐζητεῖτο τόπος."]},{"type":"verse","number":8,"content":["Μεμφόμενος γὰρ",{"noteId":90},"αὐτοῖς λέγει,",{"lineBreak":true},{"text":"Ἰδού, ἡμέραι ἔρχονται, λέγει Κύριος,","poem":1},{"lineBreak":true},{"text":"καὶ συντελέσω ἐπὶ τὸν οἶκον Ἰσραὴλ","poem":1},{"lineBreak":true},{"text":"καὶ ἐπὶ τὸν οἶκον Ἰούδα διαθήκην καινήν·","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"οὐ κατὰ τὴν διαθήκην ἣν ἐποίησα τοῖς πατράσιν αὐτῶν","poem":1},{"lineBreak":true},{"text":"ἐν ἡμέρᾳ ἐπιλαβομένου μου τῆς χειρὸς αὐτῶν ἐξαγαγεῖν αὐτοὺς ἐκ γῆς Αἰγύπτου·","poem":1},{"lineBreak":true},{"text":"ὅτι αὐτοὶ οὐκ ἐνέμειναν ἐν τῇ διαθήκῃ μου,","poem":1},{"lineBreak":true},{"text":"κἀγὼ ἠμέλησα αὐτῶν, λέγει Κύριος.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ὅτι αὕτη ἡ διαθήκη ἣν διαθήσομαι τῷ οἴκῳ Ἰσραὴλ","poem":1},{"lineBreak":true},{"text":"μετὰ τὰς ἡμέρας ἐκείνας, λέγει Κύριος,","poem":1},{"lineBreak":true},{"text":"διδοὺς νόμους μου εἰς τὴν διάνοιαν αὐτῶν,","poem":1},{"lineBreak":true},{"text":"καὶ ἐπὶ καρδίας αὐτῶν ἐπιγράψω αὐτούς·","poem":1},{"lineBreak":true},{"text":"καὶ ἔσομαι αὐτοῖς εἰς Θεόν,","poem":1},{"lineBreak":true},{"text":"καὶ αὐτοὶ ἔσονταί μοι εἰς λαόν.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Καὶ οὐ μὴ διδάξωσιν ἕκαστος τὸν","poem":1},{"noteId":91},{"text":"πολίτην αὐτοῦ,","poem":1},{"lineBreak":true},{"text":"καὶ ἕκαστος τὸν ἀδελφὸν αὐτοῦ, λέγων, Γνῶθι τὸν Κύριον·","poem":1},{"lineBreak":true},{"text":"ὅτι πάντες εἰδήσουσί με,","poem":1},{"lineBreak":true},{"text":"ἀπὸ μικροῦ","poem":1},{"noteId":92},{"text":"αὐτῶν ἕως μεγάλου αὐτῶν.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ὅτι","poem":1},{"noteId":93},{"text":"ἵλεως ἔσομαι ταῖς ἀδικίαις αὐτῶν,","poem":1},{"lineBreak":true},{"text":"καὶ τῶν ἁμαρτιῶν αὐτῶν","poem":1},{"noteId":94},{"text":"καὶ τῶν ἀνομιῶν αὐτῶν οὐ μὴ μνησθῶ ἔτι.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":["Ἐν τῷ λέγειν, Καινήν, πεπαλαίωκε τὴν πρώτην. Τὸ δὲ παλαιούμενον καὶ γηράσκον, ἐγγὺς ἀφανισμοῦ."]}],"footnotes":[{"noteId":81,"caller":"+","text":"και ¦ — CT","reference":{"chapter":8,"verse":2}},{"noteId":82,"caller":"+","text":"προσενεγκη ¦ προσενεγκοι PCK","reference":{"chapter":8,"verse":3}},{"noteId":83,"caller":"+","text":"γαρ ¦ ουν CT","reference":{"chapter":8,"verse":4}},{"noteId":84,"caller":"+","text":"των ιερεων 90.9% ¦ — CT 4.6%","reference":{"chapter":8,"verse":4}},{"noteId":85,"caller":"+","text":"τον ¦ — CT","reference":{"chapter":8,"verse":4}},{"noteId":86,"caller":"+","text":"μωυσης ¦ μωσης TR","reference":{"chapter":8,"verse":5}},{"noteId":87,"caller":"+","text":"ποιησεις ¦ ποιησης TR","reference":{"chapter":8,"verse":5}},{"noteId":88,"caller":"+","text":"νυνι ¦ νυν WH","reference":{"chapter":8,"verse":6}},{"noteId":89,"caller":"+","text":"τετυχε ¦ τετευχε ANT PCK TH TR","reference":{"chapter":8,"verse":6}},{"noteId":90,"caller":"+","text":"αυτοις ¦ αυτους NA SBL WH","reference":{"chapter":8,"verse":8}},{"noteId":91,"caller":"+","text":"πολιτην ¦ πλησιον PCK TR","reference":{"chapter":8,"verse":11}},{"noteId":92,"caller":"+","text":"αυτων ¦ — CT","reference":{"chapter":8,"verse":11}},{"noteId":93,"caller":"+","text":"ιλεως ¦ ειλεως TH","reference":{"chapter":8,"verse":12}},{"noteId":94,"caller":"+","text":"και των ανομιων αυτων 90.6% ¦ — CT 3.5%","reference":{"chapter":8,"verse":12}}]},"thisChapterLink":"/api/grc_tcg/HEB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/grc_tcg/HEB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/grc_tcg/HEB/7.json","previousChapterAudioLi