{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"JAS","translationId":"grc_tcg","name":"ΙΑΚΩΒΟΥ","commonName":"ΙΑΚΩΒΟΥ","title":"ΙΑΚΩΒΟΥ","order":59,"numberOfChapters":5,"sha256":"35f38b54161ed9bcbd21ea00cd8a3436258ee07a29873c0a12ff8f927ebc8664","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/JAS/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/grc_tcg/JAS/5.json","totalNumberOfVerses":108},"chapter":{"number":4,"content":[{"type":"heading","content":["Friendship with the World"]},{"type":"verse","number":1,"content":["Πόθεν πόλεμοι καὶ",{"noteId":69},"μάχαι ἐν ὑμῖν; Οὐκ ἐντεῦθεν, ἐκ τῶν ἡδονῶν ὑμῶν τῶν στρατευομένων ἐν τοῖς μέλεσιν ὑμῶν;"]},{"type":"verse","number":2,"content":["Ἐπιθυμεῖτε καὶ οὐκ ἔχετε, φονεύετε καὶ ζηλοῦτε καὶ οὐ δύνασθε ἐπιτυχεῖν· μάχεσθε καὶ πολεμεῖτε.",{"noteId":70},"Οὐκ ἔχετε διὰ τὸ μὴ αἰτεῖσθαι ὑμᾶς·"]},{"type":"verse","number":3,"content":["αἰτεῖτε καὶ οὐ λαμβάνετε, διότι κακῶς αἰτεῖσθε, ἵνα ἐν ταῖς ἡδοναῖς ὑμῶν δαπανήσητε."]},{"type":"verse","number":4,"content":[{"noteId":71},"Μοιχοὶ καὶ μοιχαλίδες, οὐκ οἴδατε ὅτι ἡ φιλία τοῦ κόσμου ἔχθρα τοῦ Θεοῦ ἐστιν; Ὃς",{"noteId":72},"ἂν οὖν βουληθῇ φίλος εἶναι τοῦ κόσμου, ἐχθρὸς τοῦ Θεοῦ καθίσταται."]},{"type":"verse","number":5,"content":["Ἢ δοκεῖτε ὅτι κενῶς ἡ γραφὴ λέγει; Πρὸς φθόνον ἐπιποθεῖ τὸ πνεῦμα ὃ",{"noteId":73},"κατῴκησεν ἐν ἡμῖν,"]},{"type":"verse","number":6,"content":["μείζονα δὲ δίδωσι χάριν· διὸ λέγει, Ὁ Θεὸς ὑπερηφάνοις ἀντιτάσσεται, ταπεινοῖς δὲ δίδωσι χάριν."]},{"type":"verse","number":7,"content":["Ὑποτάγητε οὖν τῷ Θεῷ, ἀντίστητε",{"noteId":74},"δὲ τῷ διαβόλῳ, καὶ φεύξεται ἀφ᾽ ὑμῶν."]},{"type":"verse","number":8,"content":["Ἐγγίσατε τῷ Θεῷ, καὶ",{"noteId":75},"ἐγγιεῖ ὑμῖν. Καθαρίσατε χεῖρας, ἁμαρτωλοί, καὶ ἁγνίσατε καρδίας, δίψυχοι."]},{"type":"verse","number":9,"content":["Ταλαιπωρήσατε καὶ πενθήσατε καὶ κλαύσατε· ὁ γέλως ὑμῶν εἰς πένθος",{"noteId":76},"μεταστραφήτω καὶ ἡ χαρὰ εἰς κατήφειαν."]},{"type":"verse","number":10,"content":["Ταπεινώθητε ἐνώπιον",{"noteId":77},"τοῦ Κυρίου, καὶ ὑψώσει ὑμᾶς."]},{"type":"heading","content":["Speaking Evil Against One Another"]},{"type":"verse","number":11,"content":["Μὴ καταλαλεῖτε ἀλλήλων, ἀδελφοί.",{"noteId":78},"Ὁ καταλαλῶν ἀδελφοῦ",{"noteId":79},"καὶ κρίνων τὸν ἀδελφὸν αὐτοῦ, καταλαλεῖ νόμου καὶ κρίνει νόμον· εἰ δὲ νόμον κρίνεις, οὐκ εἶ ποιητὴς νόμου ἀλλὰ κριτής."]},{"type":"verse","number":12,"content":["Εἷς ἐστιν",{"noteId":80},"ὁ νομοθέτης καὶ κριτής, ὁ δυνάμενος σῶσαι καὶ ἀπολέσαι· σὺ",{"noteId":81},"δὲ τίς εἶ",{"noteId":82},"ὃς κρίνεις τὸν",{"noteId":83},"ἕτερον;"]},{"type":"heading","content":["Boasting About Tomorrow"]},{"type":"verse","number":13,"content":["Ἄγε νῦν οἱ λέγοντες, Σήμερον",{"noteId":84},"καὶ αὔριον",{"noteId":85},"πορευσώμεθα εἰς τήνδε τὴν πόλιν καὶ",{"noteId":86},"ποιήσωμεν ἐκεῖ ἐνιαυτὸν",{"noteId":87},"ἕνα καὶ",{"noteId":88},"ἐμπορευσώμεθα καὶ",{"noteId":89},"κερδήσωμεν,"]},{"type":"verse","number":14,"content":["οἵτινες οὐκ ἐπίστασθε",{"noteId":90},"τὸ τῆς αὔριον—ποία",{"noteId":91},"γὰρ ἡ ζωὴ",{"noteId":92},"ὑμῶν; ἀτμὶς γὰρ",{"noteId":93},"ἔσται",{"noteId":94},"ἡ πρὸς ὀλίγον φαινομένη, ἔπειτα",{"noteId":95},"δὲ καὶ ἀφανιζομένη—"]},{"type":"verse","number":15,"content":["ἀντὶ τοῦ λέγειν ὑμᾶς, Ἐὰν ὁ Κύριος",{"noteId":96},"θελήσῃ, καὶ",{"noteId":97},"ζήσωμεν καὶ",{"noteId":98},"ποιήσωμεν τοῦτο ἢ ἐκεῖνο."]},{"type":"verse","number":16,"content":["Νῦν δὲ καυχᾶσθε ἐν ταῖς",{"noteId":99},"ἀλαζονείαις ὑμῶν· πᾶσα καύχησις τοιαύτη πονηρά ἐστιν."]},{"type":"verse","number":17,"content":["Εἰδότι οὖν καλὸν ποιεῖν καὶ μὴ ποιοῦντι, ἁμαρτία αὐτῷ ἐστιν."]}],"footnotes":[{"noteId":69,"caller":"+","text":"μαχαι ¦ ποθεν μαχαι CT","reference":{"chapter":4,"verse":1}},{"noteId":70,"caller":"+","text":"ουκ εχετε 𝔐13 ¦ και ουκ εχετε 𝔐7 ANT ¦ ουκ εχετε δε TR","reference":{"chapter":4,"verse":2}},{"noteId":71,"caller":"+","text":"μοιχοι και 97.8% ¦ — CT 1.8%","reference":{"chapter":4,"verse":4}},{"noteId":72,"caller":"+","text":"αν ουν 𝔐12 ¦ αν 𝔐8 ¦ εαν ουν CT","reference":{"chapter":4,"verse":4}},{"noteId":73,"caller":"+","text":"κατωκησεν ¦ κατωκισεν CT","reference":{"chapter":4,"verse":5}},{"noteId":74,"caller":"+","text":"δε ¦ — ANT PCK TR","reference":{"chapter":4,"verse":7}},{"noteId":75,"caller":"+","text":"εγγιει ¦ εγγισει WH","reference":{"chapter":4,"verse":8}},{"noteId":76,"caller":"+","text":"μεταστραφητω ¦ μετατραπητω ECM† NA SBL WH","reference":{"chapter":4,"verse":9}},{"noteId":77,"caller":"+","text":"του ¦ — NA27 SBL TH WH","reference":{"chapter":4,"verse":10}},{"noteId":78,"caller":"+","text":"ο ¦ ο γαρ PCK","reference":{"chapter":4,"verse":11}},{"noteId":79,"caller":"+","text":"και 83.5% ¦ η CT 15.3%","reference":{"chapter":4,"verse":11}},{"noteId":80,"caller":"+","text":"ο νομοθετης ¦ ο νομοθετης και κριτης ANT CT PCK ¦ νομοθετης και κριτης SBL WH","reference":{"chapter":4,"verse":12}},{"noteId":81,"caller":"+","text":"δε ¦ — TR","reference":{"chapter":4,"verse":12}},{"noteId":82,"caller":"+","text":"ος κρινεις ¦ ο κρινων ECM† NA SBL TH WH","reference":{"chapter":4,"verse":12}},{"noteId":83,"caller":"+","text":"ετερον ¦ πλησιον CT","reference":{"chapter":4,"verse":12}},{"noteId":84,"caller":"+","text":"και ¦ η CT SCR","reference":{"chapter":4,"verse":13}},{"noteId":85,"caller":"+","text":"πορευσωμεθα ¦ πορευσομεθα ANT CT SCR","reference":{"chapter":4,"verse":13}},{"noteId":86,"caller":"+","text":"ποιησωμεν ¦ ποιησομεν ANT CT SCR","reference":{"chapter":4,"verse":1