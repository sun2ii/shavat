{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"JHN","translationId":"grc_tcg","name":"ΚΑΤΑ ΙΩΑΝΝΗΝ","commonName":"ΚΑΤΑ ΙΩΑΝΝΗΝ","title":"ΚΑΤΑ ΙΩΑΝΝΗΝ","order":43,"numberOfChapters":21,"sha256":"ab871de1ac15adf24ffc62ba90479476a04e29997a05471f969216b25f1a8e5b","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/JHN/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/grc_tcg/JHN/21.json","totalNumberOfVerses":879},"chapter":{"number":13,"content":[{"type":"heading","content":["Jesus Washes the Disciples' Feet"]},{"type":"verse","number":1,"content":["Πρὸ δὲ τῆς ἑορτῆς τοῦ Πάσχα, εἰδὼς ὁ Ἰησοῦς ὅτι",{"noteId":721},"ἐλήλυθεν αὐτοῦ ἡ ὥρα ἵνα μεταβῇ ἐκ τοῦ κόσμου τούτου πρὸς τὸν πατέρα, ἀγαπήσας τοὺς ἰδίους τοὺς ἐν τῷ κόσμῳ, εἰς τέλος ἠγάπησεν αὐτούς."]},{"type":"verse","number":2,"content":["Καὶ δείπνου",{"noteId":722},"γενομένου, τοῦ διαβόλου ἤδη βεβληκότος εἰς τὴν καρδίαν",{"noteId":723},"Ἰούδα Σίμωνος Ἰσκαριώτου ἵνα αὐτὸν παραδῷ,"]},{"type":"verse","number":3,"content":["εἰδὼς",{"noteId":724},"ὁ Ἰησοῦς ὅτι πάντα",{"noteId":725},"δέδωκεν αὐτῷ ὁ πατὴρ εἰς τὰς χεῖρας, καὶ ὅτι ἀπὸ Θεοῦ ἐξῆλθε καὶ πρὸς τὸν Θεὸν ὑπάγει,"]},{"type":"verse","number":4,"content":["ἐγείρεται ἐκ τοῦ δείπνου, καὶ τίθησι τὰ ἱμάτια, καὶ λαβὼν λέντιον διέζωσεν ἑαυτόν."]},{"type":"verse","number":5,"content":["Εἶτα βάλλει ὕδωρ εἰς τὸν νιπτῆρα, καὶ ἤρξατο νίπτειν τοὺς πόδας τῶν μαθητῶν, καὶ ἐκμάσσειν τῷ λεντίῳ ᾧ ἦν διεζωσμένος."]},{"type":"verse","number":6,"content":["Ἔρχεται οὖν πρὸς Σίμωνα Πέτρον·",{"noteId":726},"καὶ λέγει αὐτῷ",{"noteId":727},"ἐκεῖνος, Κύριε, σύ μου νίπτεις τοὺς πόδας;"]},{"type":"verse","number":7,"content":["Ἀπεκρίθη Ἰησοῦς καὶ εἶπεν αὐτῷ,",{"text":"Ὃ ἐγὼ ποιῶ, σὺ οὐκ οἶδας ἄρτι, γνώσῃ δὲ μετὰ ταῦτα.","wordsOfJesus":true}]},{"type":"verse","number":8,"content":["Λέγει αὐτῷ Πέτρος, Οὐ μὴ νίψῃς",{"noteId":728},"τοὺς πόδας μου εἰς τὸν αἰῶνα. Ἀπεκρίθη",{"noteId":729},"αὐτῷ ὁ Ἰησοῦς,",{"text":"Ἐὰν μὴ νίψω σε, οὐκ ἔχεις μέρος μετ᾽ ἐμοῦ.","wordsOfJesus":true}]},{"type":"verse","number":9,"content":["Λέγει αὐτῷ Σίμων Πέτρος, Κύριε, μὴ τοὺς πόδας μου μόνον, ἀλλὰ καὶ τὰς χεῖρας καὶ τὴν κεφαλήν."]},{"type":"verse","number":10,"content":["Λέγει αὐτῷ",{"noteId":730},"ὁ Ἰησοῦς,",{"text":"Ὁ λελουμένος","wordsOfJesus":true},{"noteId":731},{"text":"οὐ χρείαν ἔχει","wordsOfJesus":true},{"noteId":732},{"text":"ἢ τοὺς πόδας νίψασθαι, ἀλλ᾽ ἔστι καθαρὸς ὅλος· καὶ ὑμεῖς καθαροί ἐστε, ἀλλ᾽ οὐχὶ πάντες.","wordsOfJesus":true}]},{"type":"verse","number":11,"content":["ᾜδει γὰρ τὸν παραδιδόντα αὐτόν· διὰ τοῦτο",{"noteId":733},"εἶπεν,",{"text":"Οὐχὶ πάντες καθαροί ἐστε.","wordsOfJesus":true}]},{"type":"verse","number":12,"content":["Ὅτε οὖν ἔνιψε τοὺς πόδας αὐτῶν, καὶ ἔλαβε τὰ ἱμάτια αὐτοῦ,",{"noteId":734},"ἀναπεσὼν πάλιν, εἶπεν αὐτοῖς,",{"noteId":735},{"text":"Γινώσκετε τί πεποίηκα ὑμῖν;","wordsOfJesus":true}]},{"type":"verse","number":13,"content":[{"text":"Ὑμεῖς φωνεῖτέ με, Ὁ διδάσκαλος, καὶ Ὁ Κύριος· καὶ καλῶς λέγετε, εἰμὶ γάρ.","wordsOfJesus":true}]},{"type":"verse","number":14,"content":[{"text":"Εἰ οὖν ἐγὼ ἔνιψα ὑμῶν τοὺς πόδας, ὁ Κύριος καὶ ὁ διδάσκαλος, καὶ ὑμεῖς ὀφείλετε ἀλλήλων νίπτειν τοὺς πόδας.","wordsOfJesus":true}]},{"type":"verse","number":15,"content":[{"text":"Ὑπόδειγμα γὰρ","wordsOfJesus":true},{"noteId":736},{"text":"ἔδωκα ὑμῖν, ἵνα καθὼς","wordsOfJesus":true},{"noteId":737},{"text":"ἐγὼ ἐποίησα ὑμῖν, καὶ ὑμεῖς ποιῆτε.","wordsOfJesus":true}]},{"type":"verse","number":16,"content":[{"text":"Ἀμὴν ἀμὴν λέγω ὑμῖν, Οὐκ ἔστι δοῦλος μείζων τοῦ κυρίου αὐτοῦ, οὐδὲ ἀπόστολος μείζων τοῦ πέμψαντος αὐτόν.","wordsOfJesus":true}]},{"type":"verse","number":17,"content":[{"text":"Εἰ ταῦτα οἴδατε, μακάριοί ἐστε ἐὰν ποιῆτε αὐτά.","wordsOfJesus":true}]},{"type":"verse","number":18,"content":[{"text":"Οὐ περὶ πάντων ὑμῶν λέγω· ἐγὼ οἶδα","wordsOfJesus":true},{"noteId":738},{"text":"οὓς ἐξελεξάμην· ἀλλ᾽ ἵνα ἡ γραφὴ πληρωθῇ, Ὁ τρώγων","wordsOfJesus":true},{"noteId":739},{"text":"μετ᾽ ἐμοῦ τὸν ἄρτον ἐπῆρεν ἐπ᾽ ἐμὲ τὴν πτέρναν αὐτοῦ.","wordsOfJesus":true}]},{"type":"verse","number":19,"content":[{"text":"Ἀπ᾽ ἄρτι λέγω ὑμῖν πρὸ τοῦ γενέσθαι, ἵνα,","wordsOfJesus":true},{"noteId":740},{"text":"ὅταν γένηται, πιστεύσητε ὅτι ἐγώ εἰμι.","wordsOfJesus":true}]},{"type":"verse","number":20,"content":[{"text":"Ἀμὴν ἀμὴν λέγω ὑμῖν, Ὁ λαμβάνων","wordsOfJesus":true},{"noteId":741},{"text":"ἐάν τινα πέμψω, ἐμὲ λαμβάνει· ὁ δὲ ἐμὲ λαμβάνων, λαμβάνει τὸν πέμψαντά με.","wordsOfJesus":true}]},{"type":"heading","content":["One of You Will Betray Me"]},{"type":"verse","number":21,"content":["Ταῦτα εἰπὼν",{"noteId":742},"ὁ Ἰησοῦς ἐταράχθη τῷ πνεύματι, καὶ ἐμαρτύρησε καὶ εἶπεν,",{"text":"Ἀμὴν ἀμὴν λέγω ὑμῖν ὅτι εἷς ἐξ ὑμῶν παραδώσει με.","wordsOfJesus":true}]},{"type":"verse","number":22,"content":["Ἔβλεπον",{"noteId":743},"οὖν εἰς ἀλλήλους οἱ μαθηταί, ἀπορούμενοι περὶ τίνος λέγει."]},{"type":"verse","number":23,"content":["Ἦν",{"noteId":744},"δὲ ἀνακείμενος εἷς",{"noteId":745},"τῶν μαθητῶν αὐτοῦ ἐν τῷ κόλπῳ τοῦ Ἰησοῦ, ὃν ἠγάπα ὁ Ἰησοῦς·"]},{"type":"verse","number":24,"content":["νεύει οὖν τούτῳ Σίμων Πέτρος",{"noteId":746},"πυθέσθαι τίς ἂν εἴη περὶ οὗ λέγει."]},{"type":"verse","number":25,"content":[{"noteId":747},"Ἐπιπεσὼν δὲ ἐκεῖνος",{"noteId":748},"οὕτως ἐπὶ τὸ στῆθος τοῦ Ἰησοῦ, λέγει αὐτῷ, Κύριε, τίς ἐστιν;"]},{"type":"verse","number":26,"content":[{"noteId":749},"Ἀποκρίνεται ὁ Ἰησοῦς,",{"text":"Ἐκεῖνός ἐστιν ᾧ ἐγὼ","wordsOfJesus":true},{"noteId":750},{"text":"βάψας τὸ ψωμίον","wordsOfJesus":true},{"noteId":751},{"text":"ἐπιδώσω.","wordsOfJesus":true},"Καὶ",{"noteId":752},"ἐμβάψας τὸ ψωμίον,",{"noteId":753},"δίδωσιν Ἰούδᾳ Σίμωνος",{"noteId":754},"Ἰσκαριώτῃ."]},{"type":"verse","number":27,"content":["Καὶ μετὰ τὸ ψωμίον, τότε εἰσῆλθεν εἰς ἐκεῖνον ὁ Σατανᾶς. Λέγει οὖν αὐτῷ",{"noteId":755},"ὁ Ἰησοῦς,",{"text":"Ὃ ποιεῖς, ποίησον","wordsOfJesus":true},{"noteId":756},{"text":"τάχιον.","wordsOfJesus":true}]},{"type":"verse","number":28,"content":["Τοῦτο δὲ οὐδεὶς ἔγνω τῶν ἀνακειμένων πρὸς τί εἶπεν αὐτῷ."]},{"type":"verse","number":29,"content":["Τινὲς γὰρ ἐδόκουν, ἐπεὶ τὸ γλωσσόκομον εἶχεν",{"noteId":757},"ὁ Ἰούδας, ὅτι λέγει αὐτῷ",{"noteId":758},"ὁ Ἰησοῦς, Ἀγόρασον ὧν χρείαν ἔχομεν εἰς τὴν ἑορτήν· ἢ τοῖς πτωχοῖς ἵνα τι δῷ."]},{"type":"verse","number":30,"content":["Λαβὼν οὖν τὸ ψωμίον ἐκεῖνος,",{"noteId":759},"εὐθέως ἐξῆλθεν· ἦν δὲ νύξ."]},{"type":"heading","content":["A New Commandment"]},{"type":"verse","number":31,"content":[{"noteId":760},"Ὅτε ἐξῆλθε, λέγει",{"noteId":761},"ὁ Ἰησοῦς,",{"text":"Νῦν ἐδοξάσθη ὁ υἱὸς τοῦ ἀνθρώπου, καὶ ὁ Θεὸς ἐδοξάσθη ἐν αὐτῷ.","wordsOfJesus":true}]},{"type":"verse","number":32,"content":[{"noteId":762},{"text":"Εἰ ὁ Θεὸς ἐδοξάσθη ἐν αὐτῷ, καὶ ὁ Θεὸς δοξάσει αὐτὸν ἐν","wordsOfJesus":true},{"noteId":763},{"text":"ἑαυτῷ, καὶ εὐθὺς δοξάσει αὐτόν.","wordsOfJesus":true}]},{"type":"verse","number":33,"content":[{"text":"Τεκνία, ἔτι μικρὸν μεθ᾽ ὑμῶν εἰμι. Ζητήσετέ με, καὶ καθὼς εἶπον τοῖς Ἰουδαίοις ὅτι Ὅπου","wordsOfJesus":true},{"noteId":764},{"text":"ὑπάγω ἐγώ, ὑμεῖς οὐ δύνασθε ἐλθεῖν, καὶ ὑμῖν λέγω ἄρτι.","wordsOfJesus":true}]},{"type":"verse","number":34,"content":[{"text":"Ἐντολὴν καινὴν δίδωμι ὑμῖν, ἵνα ἀγαπᾶτε ἀλλήλους· καθὼς ἠγάπησα ὑμᾶς, ἵνα καὶ ὑμεῖς ἀγαπᾶτε ἀλλήλους.","wordsOfJesus":true}]},{"type":"verse","number":35,"content":[{"text":"Ἐν τούτῳ γνώσονται πάντες ὅτι ἐμοὶ μαθηταί ἐστε, ἐὰν ἀγάπην ἔχητε ἐν ἀλλήλοις.","wordsOfJesus":true}]},{"type":"heading","content":["Jesus Predicts Peter's Denial"]},{"type":"verse","number":36,"content":["Λέγει αὐτῷ Σίμων Πέτρος, Κύριε, ποῦ ὑπάγεις; Ἀπεκρίθη",{"noteId":765},"αὐτῷ",{"noteId":766},"ὁ Ἰησοῦς,",{"text":"Ὅπου","wordsOfJesus":true},{"noteId":767},{"text":"ὑπάγω, οὐ δύνασαί μοι νῦν ἀκολουθῆσαι,","wordsOfJesus":true},{"noteId":768},{"text":"ὕστερον δὲ ἀκολουθήσεις μοι.","wordsOfJesus":true}]},{"type":"verse","number":37,"content":["Λέγει αὐτῷ",{"noteId":769},"Πέτρος, Κύριε, διὰ τί οὐ δύναμαί σοι",{"noteId":770},"ἀκολουθῆσαι ἄρτι; Τὴν ψυχήν μου ὑπὲρ σοῦ θήσω."]},{"type":"verse","number":38,"content":[{"noteId":771},"Ἀπεκρίθη αὐτῷ",{"noteId":772},"ὁ Ἰησοῦς,",{"text":"Τὴν ψυχήν σου ὑπὲρ ἐμοῦ θήσεις; Ἀμὴν ἀμὴν λέγω σοι, οὐ μὴ ἀλέκτωρ","wordsOfJesus":true},{"noteId":773},{"text":"φωνήσῃ ἕως οὗ","wordsOfJesus":true},{"noteId":774},{"text":"ἀπαρνήσῃ με τρίς.","wordsOfJesus":true}]}],"footnotes":[{"noteId":721,"caller":"+","text":"εληλυθεν ¦ ηλθεν CT","reference":{"chapter":13,"verse":1}},{"noteId":722,"caller":"+","text":"γενομενου ¦ γινομενου CT","reference":{"chapter":13,"verse":2}},{"noteId":723,"caller":"+","text":"ιουδα σιμωνος ισκαριωτου ινα αυτον παραδω ¦ ινα παραδοι αυτον ιουδας σιμωνος ισκαριωτου NA SBL ¦ ινα παραδοι αυτον ιουδας σιμωνος ισκαριωτης TH WH","reference":{"chapter":13,"verse":2}},{"noteId":724,"caller":"+","text":"ο ιησους ¦ — CT","reference":{"chapter":13,"verse":3}},{"noteId":725,"caller":"+","text":"δεδωκεν ¦ εδωκεν NA SBL WH","reference":{"chapter":13,"verse":3}},{"noteId":726,"caller":"+","text":"και ¦ — CT","reference":{"chapter":13,"verse":6}},{"noteId":727,"caller":"+","text":"εκεινος ¦ — NA SBL WH","reference":{"chapter":13,"verse":6}},{"noteId":728,"caller":"+","text":"τους ποδας μου ¦ μου τους ποδας CT","reference":{"chapter":13,"verse":8}},{"noteId":729,"caller":"+","text":"αυτω ο ιησους ¦ ιησους αυτω CT","reference":{"chapter":13,"verse":8}},{"noteId":730,"caller":"+","text":"ο ¦ — WH","reference":{"chapter":13,"verse":10}},{"noteId":731,"caller":"+","text":"ου χρειαν εχει ¦ ουκ εχει χρειαν CT","refere