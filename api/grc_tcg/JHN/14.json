{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"JHN","translationId":"grc_tcg","name":"ΚΑΤΑ ΙΩΑΝΝΗΝ","commonName":"ΚΑΤΑ ΙΩΑΝΝΗΝ","title":"ΚΑΤΑ ΙΩΑΝΝΗΝ","order":43,"numberOfChapters":21,"sha256":"ab871de1ac15adf24ffc62ba90479476a04e29997a05471f969216b25f1a8e5b","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/JHN/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/grc_tcg/JHN/21.json","totalNumberOfVerses":879},"chapter":{"number":14,"content":[{"type":"heading","content":["I Am the Way, the Truth, and the Life"]},{"type":"verse","number":1,"content":[{"text":"Μὴ ταρασσέσθω ὑμῶν ἡ καρδία· πιστεύετε εἰς τὸν Θεόν, καὶ εἰς ἐμὲ πιστεύετε.","wordsOfJesus":true}]},{"type":"verse","number":2,"content":[{"text":"Ἐν τῇ οἰκίᾳ τοῦ πατρός μου μοναὶ πολλαί εἰσιν· εἰ δὲ μή, εἶπον ἂν","wordsOfJesus":true},{"noteId":775},{"text":"ὑμῖν· Πορεύομαι ἑτοιμάσαι τόπον ὑμῖν.","wordsOfJesus":true}]},{"type":"verse","number":3,"content":[{"text":"Καὶ ἐὰν πορευθῶ,","wordsOfJesus":true},{"noteId":776},{"text":"ἑτοιμάσω","wordsOfJesus":true},{"noteId":777},{"text":"ὑμῖν τόπον· πάλιν ἔρχομαι καὶ","wordsOfJesus":true},{"noteId":778},{"text":"παραλήψομαι ὑμᾶς πρὸς ἐμαυτόν, ἵνα ὅπου εἰμὶ ἐγώ, καὶ ὑμεῖς ἦτε.","wordsOfJesus":true}]},{"type":"verse","number":4,"content":[{"text":"Καὶ ὅπου ἐγὼ ὑπάγω οἴδατε,","wordsOfJesus":true},{"noteId":779},{"text":"καὶ τὴν ὁδὸν οἴδατε.","wordsOfJesus":true}]},{"type":"verse","number":5,"content":["Λέγει αὐτῷ Θωμᾶς, Κύριε, οὐκ οἴδαμεν ποῦ ὑπάγεις·",{"noteId":780},"καὶ πῶς",{"noteId":781},"δυνάμεθα τὴν ὁδὸν εἰδέναι;"]},{"type":"verse","number":6,"content":["Λέγει αὐτῷ",{"noteId":782},"ὁ Ἰησοῦς,",{"text":"Ἐγώ εἰμι ἡ ὁδὸς καὶ ἡ ἀλήθεια καὶ ἡ ζωή· οὐδεὶς ἔρχεται πρὸς τὸν πατέρα, εἰ μὴ δι᾽ ἐμοῦ.","wordsOfJesus":true}]},{"type":"verse","number":7,"content":[{"text":"Εἰ","wordsOfJesus":true},{"noteId":783},{"text":"ἐγνώκειτέ με, καὶ τὸν πατέρα μου","wordsOfJesus":true},{"noteId":784},{"text":"ἐγνώκειτε ἄν·","wordsOfJesus":true},{"noteId":785},{"text":"καὶ ἀπ᾽ ἄρτι","wordsOfJesus":true},{"noteId":786},{"text":"γινώσκετε αὐτόν, καὶ ἑωράκατε","wordsOfJesus":true},{"noteId":787},{"text":"αὐτόν.","wordsOfJesus":true}]},{"type":"verse","number":8,"content":["Λέγει αὐτῷ Φίλιππος, Κύριε, δεῖξον ἡμῖν τὸν πατέρα, καὶ ἀρκεῖ ἡμῖν."]},{"type":"verse","number":9,"content":["Λέγει αὐτῷ ὁ Ἰησοῦς,",{"noteId":788},{"text":"Τοσοῦτον χρόνον μεθ᾽ ὑμῶν εἰμι, καὶ οὐκ ἔγνωκάς με, Φίλιππε; Ὁ ἑωρακὼς ἐμέ, ἑώρακε τὸν πατέρα·","wordsOfJesus":true},{"noteId":789},{"text":"καὶ πῶς σὺ λέγεις, Δεῖξον ἡμῖν τὸν πατέρα;","wordsOfJesus":true}]},{"type":"verse","number":10,"content":[{"text":"Οὐ πιστεύεις ὅτι ἐγὼ ἐν τῷ πατρί, καὶ ὁ πατὴρ ἐν ἐμοί ἐστι; Τὰ ῥήματα ἃ ἐγὼ","wordsOfJesus":true},{"noteId":790},{"text":"λαλῶ ὑμῖν, ἀπ᾽ ἐμαυτοῦ οὐ λαλῶ· ὁ δὲ πατὴρ","wordsOfJesus":true},{"noteId":791},{"text":"ὁ ἐν ἐμοὶ μένων,","wordsOfJesus":true},{"noteId":792},{"text":"αὐτὸς ποιεῖ τὰ","wordsOfJesus":true},{"noteId":793},{"text":"ἔργα.","wordsOfJesus":true}]},{"type":"verse","number":11,"content":[{"text":"Πιστεύετέ μοι ὅτι ἐγὼ ἐν τῷ πατρί, καὶ ὁ πατὴρ ἐν ἐμοί· εἰ δὲ μή, διὰ τὰ ἔργα αὐτὰ πιστεύετέ","wordsOfJesus":true},{"noteId":794},{"text":"μοι.","wordsOfJesus":true}]},{"type":"verse","number":12,"content":[{"text":"Ἀμὴν ἀμὴν λέγω ὑμῖν, ὁ πιστεύων εἰς ἐμέ, τὰ ἔργα ἃ ἐγὼ ποιῶ κἀκεῖνος ποιήσει, καὶ μείζονα τούτων ποιήσει· ὅτι ἐγὼ πρὸς τὸν πατέρα","wordsOfJesus":true},{"noteId":795},{"text":"μου πορεύομαι.","wordsOfJesus":true}]},{"type":"verse","number":13,"content":[{"text":"Καὶ ὅ τι ἂν αἰτήσητε ἐν τῷ ὀνόματί μου, τοῦτο ποιήσω, ἵνα δοξασθῇ ὁ πατὴρ ἐν τῷ υἱῷ.","wordsOfJesus":true}]},{"type":"verse","number":14,"content":[{"text":"Ἐάν τι αἰτήσητέ","wordsOfJesus":true},{"noteId":796},{"text":"με ἐν τῷ ὀνόματί μου,","wordsOfJesus":true},{"noteId":797},{"text":"ἐγὼ ποιήσω.","wordsOfJesus":true}]},{"type":"heading","content":["Jesus Promises to Send the Holy Spirit"]},{"type":"verse","number":15,"content":[{"text":"Ἐὰν ἀγαπᾶτέ με, τὰς ἐντολὰς τὰς ἐμὰς","wordsOfJesus":true},{"noteId":798},{"text":"τηρήσατε.","wordsOfJesus":true}]},{"type":"verse","number":16,"content":[{"noteId":799},{"text":"Καὶ ἐγὼ ἐρωτήσω τὸν πατέρα, καὶ ἄλλον παράκλητον δώσει ὑμῖν, ἵνα","wordsOfJesus":true},{"noteId":800},{"text":"μένῃ μεθ᾽ ὑμῶν εἰς τὸν αἰῶνα,","wordsOfJesus":true}]},{"type":"verse","number":17,"content":[{"text":"τὸ πνεῦμα τῆς ἀληθείας, ὃ ὁ κόσμος οὐ δύναται λαβεῖν, ὅτι οὐ θεωρεῖ αὐτό, οὐδὲ","wordsOfJesus":true},{"noteId":801},{"text":"γινώσκει","wordsOfJesus":true},{"noteId":802},{"text":"αὐτό. Ὑμεῖς","wordsOfJesus":true},{"noteId":803},{"text":"δὲ","wordsOfJesus":true},{"noteId":804},{"text":"γινώσκετε αὐτό, ὅτι παρ᾽ ὑμῖν μένει, καὶ ἐν ὑμῖν","wordsOfJesus":true},{"noteId":805},{"text":"ἔσται.","wordsOfJesus":true}]},{"type":"verse","number":18,"content":[{"text":"Οὐκ ἀφήσω ὑμᾶς ὀρφανούς· ἔρχομαι πρὸς ὑμᾶς.","wordsOfJesus":true}]},{"type":"verse","number":19,"content":[{"text":"Ἔτι μικρὸν καὶ ὁ κόσμος με οὐκέτι θεωρεῖ, ὑμεῖς δὲ θεωρεῖτέ με· ὅτι ἐγὼ ζῶ, καὶ ὑμεῖς","wordsOfJesus":true},{"noteId":806},{"text":"ζήσεσθε.","wordsOfJesus":true}]},{"type":"verse","number":20,"content":[{"text":"Ἐν ἐκείνῃ τῇ ἡμέρᾳ","wordsOfJesus":true},{"noteId":807},{"text":"γνώσεσθε ὑμεῖς ὅτι ἐγὼ ἐν τῷ πατρί μου, καὶ ὑμεῖς ἐν ἐμοί,","wordsOfJesus":true},{"noteId":808},{"text":"καὶ ἐγὼ ἐν ὑμῖν.","wordsOfJesus":true}]},{"type":"verse","number":21,"content":[{"text":"Ὁ ἔχων τὰς ἐντολάς μου καὶ τηρῶν αὐτάς, ἐκεῖνός ἐστιν ὁ ἀγαπῶν με· ὁ δὲ ἀγαπῶν με, ἀγαπηθήσεται ὑπὸ τοῦ πατρός μου·","wordsOfJesus":true},{"noteId":809},{"text":"καὶ ἐγὼ ἀγαπήσω αὐτόν, καὶ ἐμφανίσω αὐτῷ ἐμαυτόν.","wordsOfJesus":true}]},{"type":"verse","number":22,"content":["Λέγει αὐτῷ Ἰούδας, οὐχ ὁ Ἰσκαριώτης, Κύριε,",{"noteId":810},"καὶ τί γέγονεν ὅτι ἡμῖν μέλλεις ἐμφανίζειν σεαυτόν, καὶ οὐχὶ τῷ κόσμῳ;"]},{"type":"verse","number":23,"content":["Ἀπεκρίθη",{"noteId":811},"Ἰησοῦς καὶ εἶπεν αὐτῷ,",{"text":"Ἐάν τις ἀγαπᾷ με, τὸν λόγον μου τηρήσει, καὶ ὁ πατήρ μου ἀγαπήσει αὐτόν, καὶ πρὸς αὐτὸν ἐλευσόμεθα, καὶ μονὴν παρ᾽ αὐτῷ","wordsOfJesus":true},{"noteId":812},{"text":"ποιήσομεν.","wordsOfJesus":true}]},{"type":"verse","number":24,"content":[{"text":"Ὁ μὴ ἀγαπῶν με, τοὺς λόγους μου οὐ τηρεῖ· καὶ ὁ λόγος ὃν ἀκούετε οὐκ ἔστιν ἐμός, ἀλλὰ τοῦ πέμψαντός με πατρός.","wordsOfJesus":true}]},{"type":"verse","number":25,"content":[{"text":"Ταῦτα λελάληκα ὑμῖν παρ᾽ ὑμῖν μένων.","wordsOfJesus":true}]},{"type":"verse","number":26,"content":[{"text":"Ὁ δὲ παράκλητος, τὸ Πνεῦμα τὸ Ἅγιον, ὃ πέμψει ὁ πατὴρ ἐν τῷ ὀνόματί μου, ἐκεῖνος ὑμᾶς διδάξει πάντα, καὶ ὑπομνήσει ὑμᾶς πάντα ἃ εἶπον","wordsOfJesus":true},{"noteId":813},{"text":"ὑμῖν.","wordsOfJesus":true}]},{"type":"verse","number":27,"content":[{"text":"Εἰρήνην ἀφίημι ὑμῖν, εἰρήνην τὴν ἐμὴν δίδωμι ὑμῖν· οὐ καθὼς ὁ κόσμος δίδωσιν, ἐγὼ δίδωμι ὑμῖν. Μὴ ταρασσέσθω ὑμῶν ἡ καρδία, μηδὲ δειλιάτω.","wordsOfJesus":true}]},{"type":"verse","number":28,"content":[{"text":"Ἠκούσατε ὅτι ἐγὼ εἶπον ὑμῖν, Ὑπάγω καὶ ἔρχομαι πρὸς ὑμᾶς. Εἰ ἠγαπᾶτέ με, ἐχάρητε ἂν ὅτι","wordsOfJesus":true},{"noteId":814},{"text":"εἶπον, Πορεύομαι πρὸς τὸν πατέρα· ὅτι ὁ πατήρ","wordsOfJesus":true},{"noteId":815},{"text":"μου μείζων μού ἐστι.","wordsOfJesus":true}]},{"type":"verse","number":29,"content":[{"text":"Καὶ νῦν εἴρηκα ὑμῖν πρὶν γενέσθαι· ἵνα, ὅταν γένηται, πιστεύσητε.","wordsOfJesus":true}]},{"type":"verse","number":30,"content":[{"text":"Οὐκέτι πολλὰ λαλήσω μεθ᾽ ὑμῶν· ἔρχεται γὰρ ὁ τοῦ","wordsOfJesus":true},{"noteId":816},{"text":"κόσμου ἄρχων, καὶ ἐν ἐμοὶ οὐκ ἔχει οὐδέν·","wordsOfJesus":true}]},{"type":"verse","number":31,"content":[{"text":"ἀλλ᾽ ἵνα γνῷ ὁ κόσμος ὅτι ἀγαπῶ τὸν πατέρα, καὶ καθὼς","wordsOfJesus":true},{"noteId":817},{"text":"ἐνετείλατό μοι ὁ πατήρ, οὕτω ποιῶ. Ἐγείρεσθε, ἄγωμεν ἐντεῦθεν.","wordsOfJesus":true}]}],"footnotes":[{"noteId":775,"caller":"+","text":"υμιν ¦ υμιν οτι CT","reference":{"chapter":14,"verse":2}},{"noteId":776,"caller":"+","text":"ετοιμασω ¦ και ετοιμασω 𝔐pt ANT CT HF PCK TR ¦ ετοιμασαι 𝔐pt","reference":{"chapter":14,"verse":3}},{"noteId":777,"caller":"+","text":"υμιν τοπον ¦ τοπον υμιν CT","reference":{"chapter":14,"verse":3}},{"noteId":778,"caller":"+","text":"παραληψομαι ¦ παραλημψομαι CT","reference":{"chapter":14,"verse":3}},{"noteId":779,"caller":"+","text":"και την οδον οιδατε ¦ την οδον CT","reference":{"chapter":14,"verse":4}},{"noteId":780,"caller":"+","text":"και ¦ — CT","reference":{"chapter":14,"verse":5}},{"noteId":781,"caller":"+","text":"δυναμεθα την οδον ειδεναι ¦ οιδαμεν την οδον WH","reference":{"chapter":14,"verse":5}},{"noteId":782,"caller":"+","text":"ο ¦ — WH","reference":{"chapter":14,"verse":6}},{"noteId":783,"caller":"+","text":"εγνωκειτε ¦ εγνωκατε NA","reference":{"chapter":14,"verse":7}},{"noteId":784,"caller":"+","text":"εγνωκειτε αν ¦ γνωσεσθε NA ¦ αν ηδειτε SBL TH WH","reference":{"chapter":14,"verse":7}},{"noteId":785,"caller":"+","text":"και ¦ — SBL TH WH","reference":{"chapter":14,"verse":7}},{"noteId":786,"caller":"+","text":"γινωσκετε ¦ γεινωσκετε TH","reference":{"chapter":14,"verse":7}},{"noteId":787,"caller":"+","text":"αυτον ¦ — WH","reference":{"chapter":14,"verse":7}},{"noteId":788,"caller":"+","text":"τοσουτον χρονον ¦ τοσουτω χρονω NA SBL","reference":{"chapter":14,"verse":9}},{"noteId":789,"caller":"+","text":"και ¦ — CT","reference":{"chapter":14,"verse":9}},{"noteId":790,"caller":"+","text":"λαλω ¦ λεγω CT","reference":{"chapter":14,"verse":10}},{"noteId":791,"caller":"+","text":"ο ¦