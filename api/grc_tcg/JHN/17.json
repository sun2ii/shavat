{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"JHN","translationId":"grc_tcg","name":"ΚΑΤΑ ΙΩΑΝΝΗΝ","commonName":"ΚΑΤΑ ΙΩΑΝΝΗΝ","title":"ΚΑΤΑ ΙΩΑΝΝΗΝ","order":43,"numberOfChapters":21,"sha256":"ab871de1ac15adf24ffc62ba90479476a04e29997a05471f969216b25f1a8e5b","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/JHN/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/grc_tcg/JHN/21.json","totalNumberOfVerses":879},"chapter":{"number":17,"content":[{"type":"heading","content":["Jesus Prays for His Disciples"]},{"type":"verse","number":1,"content":["Ταῦτα ἐλάλησεν",{"noteId":871},"ὁ Ἰησοῦς, καὶ",{"noteId":872},"ἐπῆρε τοὺς ὀφθαλμοὺς αὐτοῦ εἰς τὸν οὐρανόν,",{"noteId":873},"καὶ εἶπε,",{"text":"Πάτερ, ἐλήλυθεν ἡ ὥρα· δόξασόν σου τὸν υἱόν, ἵνα","wordsOfJesus":true},{"noteId":874},{"text":"καὶ ὁ υἱός σου δοξάσῃ σε·","wordsOfJesus":true}]},{"type":"verse","number":2,"content":[{"text":"καθὼς ἔδωκας αὐτῷ ἐξουσίαν πάσης σαρκός, ἵνα πᾶν ὃ δέδωκας αὐτῷ,","wordsOfJesus":true},{"noteId":875},{"text":"δώσει αὐτοῖς ζωὴν αἰώνιον.","wordsOfJesus":true}]},{"type":"verse","number":3,"content":[{"text":"Αὕτη δέ ἐστιν ἡ αἰώνιος ζωή, ἵνα γινώσκωσί σε τὸν μόνον ἀληθινὸν Θεόν, καὶ ὃν ἀπέστειλας Ἰησοῦν Χριστόν.","wordsOfJesus":true}]},{"type":"verse","number":4,"content":[{"text":"Ἐγώ σε ἐδόξασα ἐπὶ τῆς γῆς· τὸ ἔργον","wordsOfJesus":true},{"noteId":876},{"text":"ἐτελείωσα ὃ δέδωκάς μοι ἵνα ποιήσω.","wordsOfJesus":true}]},{"type":"verse","number":5,"content":[{"text":"Καὶ νῦν δόξασόν με σύ, πάτερ, παρὰ σεαυτῷ τῇ δόξῃ ᾗ εἶχον πρὸ τοῦ τὸν κόσμον εἶναι παρὰ σοί.","wordsOfJesus":true}]},{"type":"verse","number":6,"content":[{"text":"Ἐφανέρωσά σου τὸ ὄνομα τοῖς ἀνθρώποις οὓς","wordsOfJesus":true},{"noteId":877},{"text":"δέδωκάς μοι ἐκ τοῦ κόσμου· σοὶ ἦσαν,","wordsOfJesus":true},{"noteId":878},{"text":"καὶ ἐμοὶ αὐτοὺς","wordsOfJesus":true},{"noteId":879},{"text":"δέδωκας· καὶ τὸν λόγον σου","wordsOfJesus":true},{"noteId":880},{"text":"τετηρήκασι.","wordsOfJesus":true}]},{"type":"verse","number":7,"content":[{"text":"Νῦν ἔγνωκαν ὅτι πάντα ὅσα","wordsOfJesus":true},{"noteId":881},{"text":"δέδωκάς μοι, παρὰ σοῦ","wordsOfJesus":true},{"noteId":882},{"text":"ἐστιν·","wordsOfJesus":true}]},{"type":"verse","number":8,"content":[{"text":"ὅτι τὰ ῥήματα ἃ","wordsOfJesus":true},{"noteId":883},{"text":"δέδωκάς μοι, δέδωκα αὐτοῖς· καὶ αὐτοὶ ἔλαβον, καὶ ἔγνωσαν ἀληθῶς ὅτι παρὰ σοῦ ἐξῆλθον, καὶ ἐπίστευσαν ὅτι σύ με ἀπέστειλας.","wordsOfJesus":true}]},{"type":"verse","number":9,"content":[{"text":"Ἐγὼ περὶ αὐτῶν ἐρωτῶ· οὐ περὶ τοῦ κόσμου ἐρωτῶ, ἀλλὰ περὶ ὧν δέδωκάς μοι, ὅτι σοί εἰσι·","wordsOfJesus":true}]},{"type":"verse","number":10,"content":[{"text":"καὶ τὰ ἐμὰ πάντα σά ἐστι, καὶ τὰ σὰ ἐμά· καὶ δεδόξασμαι ἐν αὐτοῖς.","wordsOfJesus":true}]},{"type":"verse","number":11,"content":[{"text":"Καὶ οὐκέτι εἰμὶ ἐν τῷ κόσμῳ, καὶ","wordsOfJesus":true},{"noteId":884},{"text":"οὗτοι ἐν τῷ κόσμῳ εἰσί,","wordsOfJesus":true},{"noteId":885},{"text":"καὶ ἐγὼ πρὸς σὲ ἔρχομαι. Πάτερ ἅγιε, τήρησον αὐτοὺς ἐν τῷ ὀνόματί σου,","wordsOfJesus":true},{"noteId":886},{"text":"ᾧ δέδωκάς μοι, ἵνα ὦσιν ἕν, καθὼς","wordsOfJesus":true},{"noteId":887},{"text":"ἡμεῖς.","wordsOfJesus":true}]},{"type":"verse","number":12,"content":[{"text":"Ὅτε ἤμην μετ᾽ αὐτῶν","wordsOfJesus":true},{"noteId":888},{"text":"ἐν τῷ κόσμῳ, ἐγὼ ἐτήρουν αὐτοὺς ἐν τῷ ὀνόματί σου·","wordsOfJesus":true},{"noteId":889},{"text":"οὓς δέδωκάς μοι,","wordsOfJesus":true},{"noteId":890},{"text":"ἐφύλαξα, καὶ οὐδεὶς ἐξ αὐτῶν ἀπώλετο, εἰ μὴ ὁ υἱὸς τῆς ἀπωλείας, ἵνα ἡ γραφὴ πληρωθῇ.","wordsOfJesus":true}]},{"type":"verse","number":13,"content":[{"text":"Νῦν δὲ πρὸς σὲ ἔρχομαι, καὶ ταῦτα λαλῶ ἐν τῷ κόσμῳ, ἵνα ἔχωσι τὴν χαρὰν τὴν ἐμὴν πεπληρωμένην ἐν","wordsOfJesus":true},{"noteId":891},{"text":"αὐτοῖς.","wordsOfJesus":true}]},{"type":"verse","number":14,"content":[{"text":"Ἐγὼ δέδωκα αὐτοῖς τὸν λόγον σου, καὶ ὁ κόσμος ἐμίσησεν αὐτούς, ὅτι οὐκ εἰσὶν ἐκ τοῦ κόσμου, καθὼς ἐγὼ οὐκ εἰμὶ ἐκ τοῦ κόσμου.","wordsOfJesus":true}]},{"type":"verse","number":15,"content":[{"text":"Οὐκ ἐρωτῶ ἵνα ἄρῃς αὐτοὺς ἐκ τοῦ κόσμου, ἀλλ᾽ ἵνα τηρήσῃς αὐτοὺς ἐκ τοῦ πονηροῦ.","wordsOfJesus":true}]},{"type":"verse","number":16,"content":[{"text":"Ἐκ τοῦ κόσμου οὐκ εἰσί, καθὼς ἐγὼ","wordsOfJesus":true},{"noteId":892},{"text":"ἐκ τοῦ κόσμου οὐκ εἰμί.","wordsOfJesus":true}]},{"type":"verse","number":17,"content":[{"text":"Ἁγίασον αὐτοὺς ἐν τῇ ἀληθείᾳ","wordsOfJesus":true},{"noteId":893},{"text":"σου· ὁ λόγος ὁ σὸς ἀλήθειά ἐστι.","wordsOfJesus":true}]},{"type":"verse","number":18,"content":[{"text":"Καθὼς ἐμὲ ἀπέστειλας εἰς τὸν κόσμον, κἀγὼ ἀπέστειλα αὐτοὺς εἰς τὸν κόσμον.","wordsOfJesus":true}]},{"type":"verse","number":19,"content":[{"text":"Καὶ ὑπὲρ αὐτῶν ἐγὼ ἁγιάζω ἐμαυτόν, ἵνα","wordsOfJesus":true},{"noteId":894},{"text":"καὶ αὐτοὶ ὦσιν ἡγιασμένοι ἐν ἀληθείᾳ.","wordsOfJesus":true}]},{"type":"verse","number":20,"content":[{"text":"Οὐ περὶ τούτων δὲ ἐρωτῶ μόνον, ἀλλὰ καὶ περὶ τῶν","wordsOfJesus":true},{"noteId":895},{"text":"πιστευόντων διὰ τοῦ λόγου αὐτῶν εἰς ἐμέ·","wordsOfJesus":true}]},{"type":"verse","number":21,"content":[{"text":"ἵνα πάντες ἓν ὦσι· καθὼς σύ,","wordsOfJesus":true},{"noteId":896},{"text":"πάτερ, ἐν ἐμοί, κἀγὼ ἐν σοί, ἵνα καὶ αὐτοὶ ἐν ἡμῖν","wordsOfJesus":true},{"noteId":897},{"text":"ἓν ὦσιν· ἵνα ὁ κόσμος","wordsOfJesus":true},{"noteId":898},{"text":"πιστεύσῃ ὅτι σύ με ἀπέστειλας.","wordsOfJesus":true}]},{"type":"verse","number":22,"content":[{"noteId":899},{"text":"Καὶ ἐγὼ τὴν δόξαν ἣν δέδωκάς μοι, δέδωκα αὐτοῖς, ἵνα ὦσιν ἕν, καθὼς ἡμεῖς ἕν","wordsOfJesus":true},{"noteId":900},{"text":"ἐσμεν.","wordsOfJesus":true}]},{"type":"verse","number":23,"content":[{"text":"Ἐγὼ ἐν αὐτοῖς, καὶ σὺ ἐν ἐμοί, ἵνα ὦσι τετελειωμένοι εἰς ἕν,","wordsOfJesus":true},{"noteId":901},{"text":"καὶ ἵνα γινώσκῃ ὁ κόσμος ὅτι σύ με ἀπέστειλας, καὶ ἠγάπησας αὐτούς, καθὼς ἐμὲ ἠγάπησας.","wordsOfJesus":true}]},{"type":"verse","number":24,"content":[{"noteId":902},{"text":"Πάτερ,","wordsOfJesus":true},{"noteId":903},{"text":"οὓς δέδωκάς μοι, θέλω ἵνα ὅπου εἰμὶ ἐγὼ κἀκεῖνοι ὦσι μετ᾽ ἐμοῦ· ἵνα θεωρῶσι τὴν δόξαν τὴν ἐμὴν ἣν","wordsOfJesus":true},{"noteId":904},{"text":"ἔδωκάς μοι, ὅτι ἠγάπησάς με πρὸ καταβολῆς κόσμου.","wordsOfJesus":true}]},{"type":"verse","number":25,"content":[{"noteId":905},{"text":"Πάτερ δίκαιε, καὶ ὁ κόσμος σε οὐκ ἔγνω, ἐγὼ δέ σε ἔγνων, καὶ οὗτοι ἔγνωσαν ὅτι σύ με ἀπέστειλας·","wordsOfJesus":true}]},{"type":"verse","number":26,"content":[{"text":"καὶ ἐγνώρισα αὐτοῖς τὸ ὄνομά σου, καὶ γνωρίσω· ἵνα ἡ ἀγάπη, ἣν ἠγάπησάς με, ἐν αὐτοῖς ᾖ, κἀγὼ ἐν αὐτοῖς.","wordsOfJesus":true}]}],"footnotes":[{"noteId":871,"caller":"+","text":"ο ιησους ¦ ιησους CT","reference":{"chapter":17,"verse":1}},{"noteId":872,"caller":"+","text":"επηρε ¦ επαρας CT","reference":{"chapter":17,"verse":1}},{"noteId":873,"caller":"+","text":"και ¦ — CT","reference":{"chapter":17,"verse":1}},{"noteId":874,"caller":"+","text":"και ο υιος σου ¦ ο υιος CT","reference":{"chapter":17,"verse":1}},{"noteId":875,"caller":"+","text":"δωσει ¦ δωση NA SBL TR","reference":{"chapter":17,"verse":2}},{"noteId":876,"caller":"+","text":"ετελειωσα ¦ τελειωσας CT","reference":{"chapter":17,"verse":4}},{"noteId":877,"caller":"+","text":"δεδωκας ¦ εδωκας CT","reference":{"chapter":17,"verse":6}},{"noteId":878,"caller":"+","text":"και εμοι ¦ καμοι NA SBL WH","reference":{"chapter":17,"verse":6}},{"noteId":879,"caller":"+","text":"δεδωκας ¦ εδωκας CT","reference":{"chapter":17,"vers