{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"JHN","translationId":"grc_tcg","name":"ΚΑΤΑ ΙΩΑΝΝΗΝ","commonName":"ΚΑΤΑ ΙΩΑΝΝΗΝ","title":"ΚΑΤΑ ΙΩΑΝΝΗΝ","order":43,"numberOfChapters":21,"sha256":"ab871de1ac15adf24ffc62ba90479476a04e29997a05471f969216b25f1a8e5b","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/JHN/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/grc_tcg/JHN/21.json","totalNumberOfVerses":879},"chapter":{"number":21,"content":[{"type":"heading","content":["Jesus Appears to Seven Disciples"]},{"type":"verse","number":1,"content":["Μετὰ ταῦτα ἐφανέρωσεν ἑαυτὸν",{"noteId":1075},"πάλιν",{"noteId":1076},"ὁ Ἰησοῦς τοῖς",{"noteId":1077},"μαθηταῖς ἐπὶ τῆς θαλάσσης τῆς Τιβεριάδος· ἐφανέρωσε δὲ οὕτως."]},{"type":"verse","number":2,"content":["Ἦσαν ὁμοῦ Σίμων Πέτρος, καὶ Θωμᾶς ὁ λεγόμενος Δίδυμος, καὶ Ναθαναὴλ ὁ ἀπὸ Κανᾶ τῆς Γαλιλαίας, καὶ οἱ τοῦ Ζεβεδαίου, καὶ ἄλλοι ἐκ τῶν μαθητῶν αὐτοῦ δύο."]},{"type":"verse","number":3,"content":["Λέγει αὐτοῖς Σίμων Πέτρος, Ὑπάγω ἁλιεύειν. Λέγουσιν αὐτῷ, Ἐρχόμεθα καὶ ἡμεῖς σὺν σοί.",{"noteId":1078},"Ἐξῆλθον καὶ",{"noteId":1079},"ἐνέβησαν εἰς τὸ πλοῖον",{"noteId":1080},"εὐθύς, καὶ ἐν ἐκείνῃ τῇ νυκτὶ ἐπίασαν οὐδέν."]},{"type":"verse","number":4,"content":["Πρωΐας δὲ ἤδη",{"noteId":1081},"γενομένης ἔστη",{"noteId":1082},"ὁ Ἰησοῦς εἰς τὸν αἰγιαλόν· οὐ μέντοι ᾔδεισαν οἱ μαθηταὶ ὅτι Ἰησοῦς ἐστι."]},{"type":"verse","number":5,"content":["Λέγει οὖν αὐτοῖς",{"noteId":1083},"ὁ Ἰησοῦς,",{"text":"Παιδία, μή τι προσφάγιον ἔχετε;","wordsOfJesus":true},"Ἀπεκρίθησαν αὐτῷ, Οὔ."]},{"type":"verse","number":6,"content":["Ὁ δὲ εἶπεν αὐτοῖς,",{"text":"Βάλετε εἰς τὰ δεξιὰ μέρη τοῦ πλοίου τὸ δίκτυον, καὶ εὑρήσετε.","wordsOfJesus":true},"Ἔβαλον οὖν, καὶ οὐκέτι αὐτὸ ἑλκύσαι",{"noteId":1084},"ἴσχυσαν ἀπὸ τοῦ πλήθους τῶν ἰχθύων."]},{"type":"verse","number":7,"content":["Λέγει οὖν ὁ μαθητὴς ἐκεῖνος ὃν ἠγάπα ὁ Ἰησοῦς τῷ Πέτρῳ, Ὁ Κύριός ἐστι. Σίμων οὖν Πέτρος, ἀκούσας ὅτι ὁ Κύριός ἐστι, τὸν ἐπενδύτην διεζώσατο—ἦν γὰρ γυμνός—καὶ ἔβαλεν ἑαυτὸν εἰς τὴν θάλασσαν."]},{"type":"verse","number":8,"content":["Οἱ δὲ ἄλλοι μαθηταὶ τῷ πλοιαρίῳ ἦλθον—οὐ γὰρ ἦσαν μακρὰν ἀπὸ τῆς γῆς,",{"noteId":1085},"ἀλλ᾽ ὡς ἀπὸ πηχῶν διακοσίων—σύροντες τὸ δίκτυον τῶν ἰχθύων."]},{"type":"verse","number":9,"content":["Ὡς οὖν ἀπέβησαν εἰς τὴν γῆν, βλέπουσιν ἀνθρακιὰν κειμένην καὶ ὀψάριον ἐπικείμενον, καὶ ἄρτον."]},{"type":"verse","number":10,"content":["Λέγει αὐτοῖς ὁ Ἰησοῦς,",{"text":"Ἐνέγκατε ἀπὸ τῶν ὀψαρίων ὧν ἐπιάσατε νῦν.","wordsOfJesus":true}]},{"type":"verse","number":11,"content":[{"noteId":1086},"Ἀνέβη Σίμων Πέτρος, καὶ εἵλκυσε τὸ δίκτυον",{"noteId":1087},"ἐπὶ τῆς γῆς, μεστὸν ἰχθύων μεγάλων ἑκατὸν πεντήκοντα τριῶν· καὶ τοσούτων ὄντων, οὐκ ἐσχίσθη τὸ δίκτυον."]},{"type":"verse","number":12,"content":["Λέγει αὐτοῖς ὁ Ἰησοῦς,",{"text":"Δεῦτε ἀριστήσατε.","wordsOfJesus":true},"Οὐδεὶς",{"noteId":1088},"δὲ ἐτόλμα τῶν μαθητῶν ἐξετάσαι αὐτόν, Σὺ τίς εἶ; εἰδότες ὅτι ὁ Κύριός ἐστιν."]},{"type":"verse","number":13,"content":["Ἔρχεται",{"noteId":1089},"οὖν",{"noteId":1090},"ὁ Ἰησοῦς, καὶ λαμβάνει τὸν ἄρτον, καὶ δίδωσιν αὐτοῖς, καὶ τὸ ὀψάριον ὁμοίως."]},{"type":"verse","number":14,"content":["Τοῦτο ἤδη τρίτον ἐφανερώθη",{"noteId":1091},"ὁ Ἰησοῦς τοῖς μαθηταῖς",{"noteId":1092},"αὐτοῦ, ἐγερθεὶς ἐκ νεκρῶν."]},{"type":"heading","content":["Tend My Sheep"]},{"type":"verse","number":15,"content":["Ὅτε οὖν ἠρίστησαν, λέγει τῷ Σίμωνι Πέτρῳ ὁ Ἰησοῦς,",{"text":"Σίμων","wordsOfJesus":true},{"noteId":1093},{"text":"Ἰωνᾶ, ἀγαπᾷς με","wordsOfJesus":true},{"noteId":1094},{"text":"πλεῖον τούτων;","wordsOfJesus":true},"Λέγει αὐτῷ, Ναὶ Κύριε· σὺ οἶδας ὅτι φιλῶ σε. Λέγει αὐτῷ,",{"text":"Βόσκε τὰ ἀρνία μου.","wordsOfJesus":true}]},{"type":"verse","number":16,"content":["Λέγει αὐτῷ πάλιν δεύτερον,",{"text":"Σίμων","wordsOfJesus":true},{"noteId":1095},{"text":"Ἰωνᾶ, ἀγαπᾷς με;","wordsOfJesus":true},"Λέγει αὐτῷ, Ναὶ Κύριε· σὺ οἶδας ὅτι φιλῶ σε. Λέγει αὐτῷ,",{"text":"Ποίμαινε τὰ","wordsOfJesus":true},{"noteId":1096},{"text":"πρόβατά μου.","wordsOfJesus":true}]},{"type":"verse","number":17,"content":["Λέγει αὐτῷ τὸ τρίτον,",{"text":"Σίμων","wordsOfJesus":true},{"noteId":1097},{"text":"Ἰωνᾶ, φιλεῖς με;","wordsOfJesus":true},"Ἐλυπήθη ὁ Πέτρος ὅτι εἶπεν αὐτῷ τὸ τρίτον,",{"text":"Φιλεῖς με;","wordsOfJesus":true},"Καὶ",{"noteId":1098},"εἶπεν αὐτῷ, Κύριε,",{"noteId":1099},"σὺ πάντα οἶδας· σὺ γινώσκεις ὅτι φιλῶ σε. Λέγει αὐτῷ",{"noteId":1100},"ὁ Ἰησοῦς,",{"text":"Βόσκε τὰ","wordsOfJesus":true},{"noteId":1101},{"text":"πρόβατά μου.","wordsOfJesus":true}]},{"type":"verse","number":18,"content":[{"text":"Ἀμὴν ἀμὴν λέγω σοι, ὅτε ἦς νεώτερος, ἐζώννυες σεαυτόν, καὶ περιεπάτεις ὅπου ἤθελες· ὅταν δὲ γηράσῃς, ἐκτενεῖς τὰς χεῖράς σου, καὶ ἄλλος","wordsOfJesus":true},{"noteId":1102},{"text":"σε ζώσει, καὶ οἴσει ὅπου οὐ θέλεις.","wordsOfJesus":true}]},{"type":"verse","number":19,"content":["Τοῦτο δὲ εἶπε, σημαίνων ποίῳ θανάτῳ δοξάσει τὸν Θεόν. Καὶ τοῦτο εἰπὼν λέγει αὐτῷ,",{"text":"Ἀκολούθει μοι.","wordsOfJesus":true}]},{"type":"heading","content":["The Beloved Disciple and His Book"]},{"type":"verse","number":20,"content":["Ἐπιστραφεὶς",{"noteId":1103},"δὲ ὁ Πέτρος βλέπει τὸν μαθητὴν ὃν ἠγάπα ὁ Ἰησοῦς ἀκολουθοῦντα, ὃς καὶ ἀνέπεσεν ἐν τῷ δείπνῳ ἐπὶ τὸ στῆθος αὐτοῦ καὶ εἶπε, Κύριε, τίς ἐστιν ὁ παραδιδούς σε;"]},{"type":"verse","number":21,"content":[{"noteId":1104},"Τοῦτον ἰδὼν ὁ Πέτρος λέγει τῷ Ἰησοῦ, Κύριε, οὗτος δὲ τί;"]},{"type":"verse","number":22,"content":["Λέγει αὐτῷ ὁ Ἰησοῦς,",{"text":"Ἐὰν αὐτὸν θέλω μένειν ἕως ἔρχομαι, τί πρὸς σέ; Σὺ","wordsOfJesus":true},{"noteId":1105},{"text":"ἀκολούθει μοι.","wordsOfJesus":true}]},{"type":"verse","number":23,"content":["Ἐξῆλθεν οὖν",{"noteId":1106},"ὁ λόγος οὗτος εἰς τοὺς ἀδελφούς, ὅτι ὁ μαθητὴς ἐκεῖνος οὐκ ἀποθνῄσκει·",{"noteId":1107},"καὶ οὐκ εἶπεν αὐτῷ ὁ Ἰησοῦς, ὅτι οὐκ ἀποθνῄσκει· ἀλλ᾽,",{"text":"Ἐὰν αὐτὸν θέλω μένειν ἕως ἔρχομαι, τί πρὸς σέ;","wordsOfJesus":true}]},{"type":"verse","number":24,"content":["Οὗτός ἐστιν ὁ μαθητὴς ὁ μαρτυρῶν περὶ τούτων, καὶ",{"noteId":1108},"γράψας ταῦτα· καὶ οἴδαμεν ὅτι ἀληθής",{"noteId":1109},"ἐστιν ἡ μαρτυρία αὐτοῦ."]},{"type":"verse","number":25,"content":["Ἔστι δὲ καὶ ἄλλα πολλὰ",{"noteId":1110},"ὅσα ἐποίησεν ὁ Ἰησοῦς, ἅτινα ἐὰν γράφηται καθ᾽ ἕν,",{"noteId":1111},"οὐδὲ αὐτὸν οἶμαι τὸν κόσμον",{"noteId":1112},"χωρῆσαι τὰ γραφόμενα βιβλία.",{"noteId":1113},"Ἀμήν.",{"noteId":1114}]}],"footnotes":[{"noteId":1075,"caller":"+","text":"παλιν ¦ — PCK","reference":{"chapter":21,"verse":1}},{"noteId":1076,"caller":"+","text":"ο ¦ — WH","reference":{"chapter":21,"verse":1}},{"noteId":1077,"caller":"+","text":"μαθηταις ¦ μαθηταις αυτου 𝔐pt ¦ μαθηταις αυτου εγερθεις εκ νεκρων PCK","reference":{"chapter":21,"verse":1}},{"noteId":1078,"caller":"+","text":"εξηλθον ¦ εξηλθαν WH","reference":{"chapter":21,"verse":3}},{"noteId":1079,"caller":"+","text":"ενεβησαν ¦ ανεβησαν TR","reference":{"chapter":21,"verse":3}},{"noteId":1080,"caller":"+","text":"ευθυς ¦ — CT","reference":{"chapter":21,"verse":3}},{"noteId":1081,"caller":"+","text":"γενομενης ¦ γινομενης WH","reference":{"chapter":21,"verse":4}},{"noteId":1082,"caller":"+","text":"ο ¦ — CT","reference":{"chapter":21,"verse":4}},{"noteId":1083,"caller":"+","text":"ο ¦ — WH","reference":{"chapter":21,"verse":5}},{"noteId":1084,"caller":"+","text":"ισχυσαν ¦ ισχυον CT","reference":{"chapter":21,"verse":6}},{"noteId":1085,"caller":"+","text":"αλλ ¦ αλλα NA27 SBL TH WH","reference":{"chapter":21,"verse":8}},{"noteId":1086,"caller