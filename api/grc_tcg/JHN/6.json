{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"JHN","translationId":"grc_tcg","name":"ΚΑΤΑ ΙΩΑΝΝΗΝ","commonName":"ΚΑΤΑ ΙΩΑΝΝΗΝ","title":"ΚΑΤΑ ΙΩΑΝΝΗΝ","order":43,"numberOfChapters":21,"sha256":"ab871de1ac15adf24ffc62ba90479476a04e29997a05471f969216b25f1a8e5b","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/JHN/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/grc_tcg/JHN/21.json","totalNumberOfVerses":879},"chapter":{"number":6,"content":[{"type":"heading","content":["The Feeding of the Five Thousand"]},{"type":"verse","number":1,"content":["Μετὰ ταῦτα ἀπῆλθεν ὁ Ἰησοῦς πέραν τῆς θαλάσσης τῆς Γαλιλαίας, τῆς Τιβεριάδος."]},{"type":"verse","number":2,"content":[{"noteId":237},"Καὶ ἠκολούθει αὐτῷ ὄχλος πολύς, ὅτι",{"noteId":238},"ἑώρων",{"noteId":239},"αὐτοῦ τὰ σημεῖα ἃ ἐποίει ἐπὶ τῶν ἀσθενούντων."]},{"type":"verse","number":3,"content":["Ἀνῆλθε δὲ εἰς τὸ ὄρος",{"noteId":240},"ὁ Ἰησοῦς, καὶ ἐκεῖ ἐκάθητο μετὰ τῶν μαθητῶν αὐτοῦ."]},{"type":"verse","number":4,"content":["Ἦν δὲ ἐγγὺς τὸ Πάσχα, ἡ ἑορτὴ τῶν Ἰουδαίων."]},{"type":"verse","number":5,"content":["Ἐπάρας οὖν",{"noteId":241},"ὁ Ἰησοῦς τοὺς ὀφθαλμούς, καὶ θεασάμενος ὅτι πολὺς ὄχλος ἔρχεται πρὸς αὐτόν, λέγει πρὸς",{"noteId":242},"τὸν Φίλιππον,",{"text":"Πόθεν","wordsOfJesus":true},{"noteId":243},{"text":"ἀγοράσομεν ἄρτους, ἵνα φάγωσιν οὗτοι;","wordsOfJesus":true}]},{"type":"verse","number":6,"content":["Τοῦτο δὲ ἔλεγε πειράζων αὐτόν· αὐτὸς γὰρ ᾔδει τί",{"noteId":244},"ἔμελλε ποιεῖν."]},{"type":"verse","number":7,"content":["Ἀπεκρίθη",{"noteId":245},"αὐτῷ Φίλιππος, Διακοσίων δηναρίων ἄρτοι οὐκ ἀρκοῦσιν αὐτοῖς, ἵνα ἕκαστος",{"noteId":246},"αὐτῶν βραχύ",{"noteId":247},"τι λάβῃ."]},{"type":"verse","number":8,"content":["Λέγει αὐτῷ εἷς ἐκ τῶν μαθητῶν αὐτοῦ, Ἀνδρέας ὁ ἀδελφὸς Σίμωνος Πέτρου,"]},{"type":"verse","number":9,"content":["Ἔστι παιδάριον",{"noteId":248},"ἓν ὧδε,",{"noteId":249},"ὃ ἔχει πέντε ἄρτους κριθίνους καὶ δύο ὀψάρια· ἀλλὰ ταῦτα τί ἐστιν εἰς τοσούτους;"]},{"type":"verse","number":10,"content":["Εἶπε",{"noteId":250},"δὲ ὁ Ἰησοῦς,",{"text":"Ποιήσατε τοὺς ἀνθρώπους ἀναπεσεῖν.","wordsOfJesus":true},"Ἦν δὲ χόρτος πολὺς ἐν τῷ τόπῳ.",{"noteId":251},"Ἀνέπεσον οὖν οἱ ἄνδρες τὸν ἀριθμὸν",{"noteId":252},"ὡσεὶ πεντακισχίλιοι."]},{"type":"verse","number":11,"content":["Ἔλαβε",{"noteId":253},"δὲ τοὺς ἄρτους ὁ Ἰησοῦς, καὶ εὐχαριστήσας διέδωκε",{"noteId":254},"τοῖς μαθηταῖς, οἱ δὲ μαθηταὶ τοῖς ἀνακειμένοις· ὁμοίως καὶ ἐκ τῶν ὀψαρίων ὅσον ἤθελον."]},{"type":"verse","number":12,"content":["Ὡς δὲ ἐνεπλήσθησαν, λέγει τοῖς μαθηταῖς αὐτοῦ,",{"text":"Συναγάγετε τὰ περισσεύσαντα","wordsOfJesus":true},{"noteId":255},{"text":"κλάσματα, ἵνα μή τι ἀπόληται.","wordsOfJesus":true}]},{"type":"verse","number":13,"content":["Συνήγαγον οὖν, καὶ ἐγέμισαν δώδεκα κοφίνους κλασμάτων ἐκ τῶν πέντε ἄρτων τῶν κριθίνων, ἃ",{"noteId":256},"ἐπερίσσευσε τοῖς βεβρωκόσιν."]},{"type":"verse","number":14,"content":["Οἱ οὖν ἄνθρωποι ἰδόντες",{"noteId":257},"ὃ ἐποίησε σημεῖον ὁ Ἰησοῦς, ἔλεγον ὅτι Οὗτός ἐστιν ἀληθῶς ὁ προφήτης ὁ ἐρχόμενος εἰς τὸν κόσμον."]},{"type":"verse","number":15,"content":["Ἰησοῦς οὖν γνοὺς ὅτι μέλλουσιν ἔρχεσθαι καὶ ἁρπάζειν αὐτόν, ἵνα ποιήσωσιν",{"noteId":258},"αὐτὸν βασιλέα,",{"noteId":259},"ἀνεχώρησεν εἰς τὸ ὄρος αὐτὸς μόνος."]},{"type":"heading","content":["Jesus Walks on Water"]},{"type":"verse","number":16,"content":["Ὡς δὲ ὀψία ἐγένετο, κατέβησαν οἱ μαθηταὶ αὐτοῦ ἐπὶ τὴν θάλασσαν,"]},{"type":"verse","number":17,"content":["καὶ ἐμβάντες εἰς",{"noteId":260},"τὸ πλοῖον, ἤρχοντο πέραν τῆς θαλάσσης εἰς",{"noteId":261},"Καπερναούμ. Καὶ σκοτία ἤδη ἐγεγόνει, καὶ",{"noteId":262},"οὐκ",{"noteId":263},"ἐληλύθει πρὸς αὐτοὺς ὁ Ἰησοῦς."]},{"type":"verse","number":18,"content":["Ἥ τε θάλασσα ἀνέμου μεγάλου πνέοντος",{"noteId":264},"διηγείρετο."]},{"type":"verse","number":19,"content":["Ἐληλακότες οὖν ὡς σταδίους εἴκοσι πέντε ἢ τριάκοντα, θεωροῦσι τὸν Ἰησοῦν περιπατοῦντα ἐπὶ τῆς θαλάσσης, καὶ ἐγγὺς τοῦ πλοίου",{"noteId":265},"γινόμενον· καὶ ἐφοβήθησαν."]},{"type":"verse","number":20,"content":["Ὁ δὲ λέγει αὐτοῖς,",{"text":"Ἐγώ εἰμι· μὴ φοβεῖσθε.","wordsOfJesus":true}]},{"type":"verse","number":21,"content":["Ἤθελον οὖν λαβεῖν αὐτὸν εἰς τὸ πλοῖον· καὶ εὐθέως",{"noteId":266},"τὸ πλοῖον ἐγένετο ἐπὶ τῆς γῆς εἰς ἣν ὑπῆγον."]},{"type":"heading","content":["I Am the Bread of Life"]},{"type":"verse","number":22,"content":["Τῇ ἐπαύριον ὁ ὄχλος ὁ ἑστηκὼς πέραν τῆς θαλάσσης,",{"noteId":267},"ἰδὼν ὅτι πλοιάριον ἄλλο οὐκ ἦν ἐκεῖ εἰ μὴ ἓν",{"noteId":268},"ἐκεῖνο εἰς ὃ ἐνέβησαν οἱ μαθηταὶ αὐτοῦ, καὶ ὅτι οὐ συνεισῆλθε τοῖς μαθηταῖς αὐτοῦ ὁ Ἰησοῦς εἰς τὸ",{"noteId":269},"πλοιάριον, ἀλλὰ μόνοι οἱ μαθηταὶ αὐτοῦ ἀπῆλθον—"]},{"type":"verse","number":23,"content":[{"noteId":270},"ἄλλα δὲ ἦλθε πλοιάρια ἐκ Τιβεριάδος ἐγγὺς τοῦ τόπου ὅπου ἔφαγον τὸν ἄρτον, εὐχαριστήσαντος τοῦ Κυρίου—"]},{"type":"verse","number":24,"content":["ὅτε οὖν εἶδεν ὁ ὄχλος ὅτι Ἰησοῦς οὐκ ἔστιν ἐκεῖ οὐδὲ οἱ μαθηταὶ αὐτοῦ,",{"noteId":271},"ἐνέβησαν αὐτοὶ εἰς τὰ",{"noteId":272},"πλοῖα, καὶ ἦλθον εἰς",{"noteId":273},"Καπερναούμ, ζητοῦντες τὸν Ἰησοῦν."]},{"type":"verse","number":25,"content":["Καὶ εὑρόντες αὐτὸν πέραν τῆς θαλάσσης, εἶπον αὐτῷ,",{"noteId":274},"Ῥαββί, πότε ὧδε γέγονας;"]},{"type":"verse","number":26,"content":["Ἀπεκρίθη αὐτοῖς ὁ Ἰησοῦς καὶ εἶπεν,",{"text":"Ἀμὴν ἀμὴν λέγω ὑμῖν, ζητεῖτέ με, οὐχ ὅτι εἴδετε σημεῖα, ἀλλ᾽ ὅτι ἐφάγετε ἐκ τῶν ἄρτων καὶ ἐχορτάσθητε.","wordsOfJesus":true}]},{"type":"verse","number":27,"content":[{"text":"Ἐργάζεσθε μὴ τὴν βρῶσιν τὴν ἀπολλυμένην, ἀλλὰ τὴν βρῶσιν τὴν μένουσαν εἰς ζωὴν αἰώνιον, ἣν ὁ υἱὸς τοῦ ἀνθρώπου ὑμῖν δώσει· τοῦτον γὰρ ὁ πατὴρ ἐσφράγισεν, ὁ Θεός.","wordsOfJesus":true}]},{"type":"verse","number":28,"content":["Εἶπον οὖν πρὸς αὐτόν, Τί",{"noteId":275},"ποιῶμεν, ἵνα ἐργαζώμεθα τὰ ἔργα τοῦ Θεοῦ;"]},{"type":"verse","number":29,"content":["Ἀπεκρίθη",{"noteId":276},"Ἰησοῦς καὶ εἶπεν αὐτοῖς,",{"text":"Τοῦτό ἐστι τὸ ἔργον τοῦ Θεοῦ, ἵνα","wordsOfJesus":true},{"noteId":277},{"text":"πιστεύσητε εἰς ὃν ἀπέστειλεν ἐκεῖνος.","wordsOfJesus":true}]},{"type":"verse","number":30,"content":["Εἶπον οὖν αὐτῷ, Τί οὖν ποιεῖς σὺ σημεῖον, ἵνα ἴδωμεν καὶ πιστεύσωμέν σοι; Τί ἐργάζῃ;"]},{"type":"verse","number":31,"content":["Οἱ πατέρες ἡμῶν τὸ μάννα ἔφαγον ἐν τῇ ἐρήμῳ, καθώς ἐστι γεγραμμένον, Ἄρτον ἐκ τοῦ οὐρανοῦ ἔδωκεν αὐτοῖς φαγεῖν."]},{"type":"verse","number":32,"content":["Εἶπεν οὖν αὐτοῖς ὁ Ἰησοῦς,",{"text":"Ἀμὴν ἀμὴν λέγω ὑμῖν, οὐ","wordsOfJesus":true},{"noteId":278},{"text":"Μωσῆς","wordsOfJesus":true},{"noteId":279},{"text":"δέδωκεν ὑμῖν τὸν ἄρτον ἐκ τοῦ οὐρανοῦ· ἀλλ᾽ ὁ πατήρ μου δίδωσιν ὑμῖν τὸν ἄρτον ἐκ τοῦ οὐρανοῦ τὸν ἀληθινόν.","wordsOfJesus":true}]},{"type":"verse","number":33,"content":[{"text":"Ὁ γὰρ ἄρτος τοῦ Θεοῦ ἐστιν ὁ καταβαίνων ἐκ τοῦ οὐρανοῦ καὶ ζωὴν διδοὺς τῷ κόσμῳ.","wordsOfJesus":true}]},{"type":"verse","number":34,"content":["Εἶπον οὖν πρὸς αὐτόν, Κύριε, πάντοτε δὸς ἡμῖν τὸν ἄρτον τοῦτον."]},{"type":"verse","number":35,"content":["Εἶπε",{"noteId":280},"δὲ αὐτοῖς ὁ Ἰησοῦς,",{"text":"Ἐγώ εἰμι ὁ ἄρτος τῆς ζωῆς· ὁ ἐρχόμενος πρός","wordsOfJesus":true},{"noteId":281},{"text":"με οὐ μὴ πεινάσῃ· καὶ ὁ πιστεύων εἰς ἐμὲ οὐ μὴ","wordsOfJesus":true},{"noteId":282},{"text":"διψήσῃ πώποτε.","wordsOfJesus":true}]},{"type":"verse","number":36,"content":[{"text":"Ἀλλ᾽ εἶπον ὑμῖν ὅτι καὶ ἑωράκατέ με, καὶ οὐ πιστεύετε.","wordsOfJesus":true}]},{"type":"verse","number":37,"content":[{"text":"Πᾶν ὃ δίδωσί μοι ὁ πατὴρ πρὸς ἐμὲ ἥξει· καὶ τὸν ἐρχόμενον πρός","wordsOfJesus":true},{"noteId":283},{"text":"με οὐ μὴ ἐκβάλω ἔξω.","wordsOfJesus":true}]},{"type":"verse","number":38,"content":[{"text":"Ὅτι καταβέβηκα","wordsOfJesus":true},{"noteId":284},{"text":"ἐκ τοῦ οὐρανοῦ, οὐχ ἵνα ποιῶ τὸ θέλημα τὸ ἐμόν, ἀλλὰ τὸ θέλημα τοῦ πέμψαντός με.","wordsOfJesus":true}]},{"type":"verse","number":39,"content":[{"text":"Τοῦτο δέ ἐστι τὸ θέλημα τοῦ πέμψαντός με","wordsOfJesus":true},{"noteId":285},{"text":"πατρός, ἵνα πᾶν ὃ δέδωκέ μοι, μὴ ἀπολέσω ἐξ αὐτοῦ,","wordsOfJesus":true},{"noteId":286},{"text":"ἀλλὰ ἀναστήσω","wordsOfJesus":true},{"noteId":287},{"text":"αὐτὸ","wordsOfJesus":true},{"noteId":288},{"text":"τῇ ἐσχάτῃ ἡμέρᾳ.","wordsOfJesus":true}]},{"type":"verse","number":40,"content":[{"text":"Τοῦτο","wordsOfJesus":true},{"noteId":289},{"text":"δέ ἐστι τὸ θέλημα τοῦ","wordsOfJesus":true},{"noteId":290},{"text":"πέμψαντός με, ἵνα πᾶς ὁ θεωρῶν τὸν υἱὸν καὶ πιστεύων εἰς αὐτόν, ἔχῃ ζωὴν αἰώνιον, καὶ ἀναστήσω αὐτὸν ἐγὼ","wordsOfJesus":true},{"noteId":291},{"text":"τῇ ἐσχάτῃ ἡμέρᾳ.","wordsOfJesus":true}]},{"type":"verse","number":41,"content":["Ἐγόγγυζον οὖν οἱ Ἰουδαῖοι περὶ αὐτοῦ, ὅτι εἶπεν,",{"text":"Ἐγώ εἰμι ὁ ἄρτος ὁ καταβὰς ἐκ τοῦ οὐρανοῦ.","wordsOfJesus":true}]},{"type":"verse","number":42,"content":["Καὶ ἔλεγον,",{"noteId":292},"Οὐχ οὗτός ἐστιν Ἰησοῦς ὁ υἱὸς Ἰωσήφ, οὗ ἡμεῖς οἴδαμεν τὸν πατέρα καὶ τὴν μητέρα; Πῶς",{"noteId":293},"οὖν λέγει",{"noteId":294},"οὗτος ὅτι",{"text":"Ἐκ τοῦ οὐρανοῦ καταβέβηκα","wordsOfJesus":true},";"]},{"type":"verse","number":43,"content":["Ἀπεκρίθη",{"noteId":295},"οὖν ὁ Ἰησοῦς καὶ εἶπεν αὐτοῖς,",{"text":"Μὴ γογγύζετε μετ᾽ ἀλλήλων.","wordsOfJesus":true}]},{"type":"verse","number":44,"content":[{"text":"Οὐδεὶς δύναται ἐλθεῖν πρός","wordsOfJesus":true},{"noteId":296},{"text":"με, ἐὰν μὴ ὁ πατὴρ ὁ πέμψας με ἑλκύσῃ αὐτόν,","wordsOfJesus":true},{"noteId":297},{"text":"καὶ ἐγὼ ἀναστήσω αὐτὸν","wordsOfJesus":true},{"noteId":298},{"text":"ἐν τῇ ἐσχάτῃ ἡμέρᾳ.","wordsOfJesus":true}]},{"type":"verse","number":45,"content":[{"text":"Ἔστι γεγραμμένον ἐν τοῖς προφήταις, Καὶ ἔσονται πάντες διδακτοὶ","wordsOfJesus":true},{"noteId":299},{"text":"Θεοῦ. Πᾶς","wordsOfJesus":true},{"noteId":300},{"text":"οὖν ὁ","wordsOfJesus":true},{"noteId":301},{"text":"ἀκούων παρὰ τοῦ πατρὸς καὶ μαθών, ἔρχεται πρός","wordsOfJesus":true},{"noteId":302},{"text":"με.","wordsOfJesus":true}]},{"type":"verse","number":46,"content":[{"text":"Οὐχ ὅτι τὸν πατέρα","wordsOfJesus":true},{"noteId":303},{"text":"τις ἑώρακεν, εἰ μὴ ὁ ὢν παρὰ τοῦ Θεοῦ, οὗτος ἑώρακε τὸν πατέρα.","wordsOfJesus":true}]},{"type":"verse","number":47,"content":[{"text":"Ἀμὴν ἀμὴν λέγω ὑμῖν, ὁ πιστεύων","wordsOfJesus":true},{"noteId":304},{"text":"εἰς ἐμέ, ἔχει ζωὴν αἰώνιον.","wordsOfJesus":true}]},{"type":"verse","number":48,"content":[{"text":"Ἐγώ εἰμι ὁ ἄρτος τῆς ζωῆς.","wordsOfJesus":true}]},{"type":"verse","number":49,"content":[{"text":"Οἱ πατέρες ὑμῶν ἔφαγον","wordsOfJesus":true},{"noteId":305},{"text":"τὸ μάννα ἐν τῇ ἐρήμῳ, καὶ ἀπέθανον.","wordsOfJesus":true}]},{"type":"verse","number":50,"content":[{"text":"Οὗτός ἐστιν ὁ ἄρτος ὁ ἐκ τοῦ οὐρανοῦ καταβαίνων, ἵνα τις ἐξ αὐτοῦ φάγῃ καὶ μὴ ἀποθάνῃ.","wordsOfJesus":true}]},{"type":"verse","number":51,"content":[{"text":"Ἐγώ εἰμι ὁ ἄρτος ὁ ζῶν, ὁ ἐκ τοῦ οὐρανοῦ καταβάς· ἐάν τις φάγῃ ἐκ τούτου τοῦ ἄρτου,","wordsOfJesus":true},{"noteId":306},{"text":"ζήσεται εἰς τὸν αἰῶνα. Καὶ ὁ ἄρτος δὲ ὃν ἐγὼ δώσω, ἡ σάρξ μού ἐστιν,","wordsOfJesus":true},{"noteId":307},{"text":"ἣν ἐγὼ δώσω ὑπὲρ τῆς τοῦ κόσμου ζωῆς.","wordsOfJesus":true}]},{"type":"verse","number":52,"content":["Ἐμάχοντο οὖν πρὸς ἀλλήλους οἱ Ἰουδαῖοι λέγοντες, Πῶς δύναται οὗτος ἡμῖν δοῦναι τὴν",{"noteId":308},"σάρκα φαγεῖν;"]},{"type":"verse","number":53,"content":["Εἶπεν οὖν αὐτοῖς ὁ Ἰησοῦς,",{"text":"Ἀμὴν ἀμὴν λέγω ὑμῖν, ἐὰν μὴ φάγητε τὴν σάρκα τοῦ υἱοῦ τοῦ ἀνθρώπου καὶ πίητε αὐτοῦ τὸ αἷμα, οὐκ ἔχετε ζωὴν ἐν ἑαυτοῖς.","wordsOfJesus":true}]},{"type":"verse","number":54,"content":[{"text":"Ὁ τρώγων μου τὴν σάρκα καὶ πίνων μου τὸ αἷμα, ἔχει ζωὴν αἰώνιον,","wordsOfJesus":true},{"noteId":309},{"text":"καὶ ἐγὼ ἀναστήσω αὐτὸν","wordsOfJesus":true},{"noteId":310},{"text":"τῇ ἐσχάτῃ ἡμέρᾳ.","wordsOfJesus":true}]},{"type":"verse","number":55,"content":[{"text":"Ἡ γὰρ σάρξ μου","wordsOfJesus":true},{"noteId":311},{"text":"ἀληθῶς ἐστι βρῶσις, καὶ τὸ αἷμά μου ἀληθῶς ἐστι πόσις.","wordsOfJesus":true}]},{"type":"verse","number":56,"content":[{"text":"Ὁ τρώγων μου τὴν σάρκα καὶ πίνων μου τὸ αἷμα, ἐν ἐμοὶ μένει, κἀγὼ ἐν αὐτῷ.","wordsOfJesus":true}]},{"type":"verse","number":57,"content":[{"text":"Καθὼς ἀπέστειλέ με ὁ ζῶν πατήρ, κἀγὼ ζῶ διὰ τὸν πατέρα· καὶ ὁ τρώγων με, κἀκεῖνος","wordsOfJesus":true},{"noteId":312},{"text":"ζήσεται δι᾽ ἐμέ.","wordsOfJesus":true}]},{"type":"verse","number":58,"content":[{"text":"Οὗτός ἐστιν ὁ ἄρτος ὁ","wordsOfJesus":true},{"noteId":313},{"text":"ἐκ τοῦ οὐρανοῦ καταβάς· οὐ καθὼς ἔφαγον οἱ πατέρες","wordsOfJesus":true},{"noteId":314},{"text":"ὑμῶν","wordsOfJesus":true},{"noteId":315},{"text":"τὸ μάννα, καὶ ἀπέθανον· ὁ τρώγων","wordsOfJesus":true},{"noteId":316},{"text":"τοῦτον τὸν ἄρτον,","wordsOfJesus":true},{"noteId":317},{"text":"ζήσεται εἰς τὸν αἰῶνα.","wordsOfJesus":true}]},{"type":"verse","number":59,"content":["Ταῦτα εἶπεν ἐν συναγωγῇ διδάσκων ἐν",{"noteId":318},"Καπερναούμ."]},{"type":"heading","content":["The Words of Eternal Life"]},{"type":"verse","number":60,"content":["Πολλοὶ οὖν ἀκούσαντες ἐκ τῶν μαθητῶν αὐτοῦ",{"noteId":319},"εἶπον, Σκληρός ἐστιν",{"noteId":320},"οὗτος ὁ λόγος· τίς δύναται αὐτοῦ ἀκούειν;"]},{"type":"verse","number":61,"content":["Εἰδὼς δὲ ὁ Ἰησοῦς ἐν ἑαυτῷ ὅτι γογγύζουσι περὶ τούτου οἱ μαθηταὶ αὐτοῦ, εἶπεν αὐτοῖς,",{"text":"Τοῦτο ὑμᾶς σκανδαλίζει;","wordsOfJesus":true}]},{"type":"verse","number":62,"content":[{"text":"Ἐὰν οὖν θεωρῆτε τὸν υἱὸν τοῦ ἀνθρώπου ἀναβαίνοντα ὅπου ἦν τὸ πρότερον;","wordsOfJesus":true}]},{"type":"verse","number":63,"content":[{"text":"Τὸ πνεῦμά ἐστι τὸ ζῳοποιοῦν, ἡ σὰρξ οὐκ ὠφελεῖ οὐδέν· τὰ ῥήματα ἃ ἐγὼ","wordsOfJesus":true},{"noteId":321},{"text":"λαλῶ ὑμῖν, πνεῦμά ἐστι καὶ ζωή ἐστιν.","wordsOfJesus":true}]},{"type":"verse","number":64,"content":[{"noteId":322},{"text":"Ἀλλ᾽ εἰσὶν ἐξ ὑμῶν τινες οἳ οὐ πιστεύουσιν.","wordsOfJesus":true},"ᾜδει γὰρ ἐξ ἀρχῆς ὁ Ἰησοῦς, τίνες εἰσὶν οἱ μὴ πιστεύοντες, καὶ τίς ἐστιν ὁ παραδώσων αὐτόν."]},{"type":"verse","number":65,"content":["Καὶ ἔλεγε,",{"text":"Διὰ τοῦτο εἴρηκα ὑμῖν ὅτι οὐδεὶς δύναται ἐλθεῖν πρός με, ἐὰν μὴ ᾖ δεδομένον αὐτῷ ἐκ τοῦ πατρός","wordsOfJesus":true},{"noteId":323},{"text":"μου.","wordsOfJesus":true}]},{"type":"verse","number":66,"content":["Ἐκ τούτου πολλοὶ",{"noteId":324},"ἀπῆλθον",{"noteId":325},"τῶν μαθητῶν",{"noteId":326},"αὐτοῦ εἰς τὰ ὀπίσω, καὶ οὐκέτι μετ᾽ αὐτοῦ περιεπάτουν."]},{"type":"verse","number":67,"content":["Εἶπεν οὖν ὁ Ἰησοῦς τοῖς δώδεκα,",{"text":"Μὴ καὶ ὑμεῖς θέλετε ὑπάγειν;","wordsOfJesus":true}]},{"type":"verse","number":68,"content":["Ἀπεκρίθη",{"noteId":327},"οὖν αὐτῷ Σίμων Πέτρος, Κύριε, πρὸς τίνα ἀπελευσόμεθα; Ῥήματα ζωῆς αἰωνίου ἔχεις."]},{"type":"verse","number":69,"content":["Καὶ ἡμεῖς πεπιστεύκαμεν καὶ ἐγνώκαμεν ὅτι σὺ εἶ ὁ",{"noteId":328},"Χριστὸς ὁ υἱὸς τοῦ Θεοῦ",{"noteId":329},"τοῦ ζῶντος."]},{"type":"verse","number":70,"content":["Ἀπεκρίθη αὐτοῖς",{"noteId":330},"ὁ Ἰησοῦς,",{"text":"Οὐκ ἐγὼ ὑμᾶς τοὺς δώδεκα ἐξελεξάμην, καὶ ἐξ ὑμῶν εἷς διάβολός ἐστιν;","wordsOfJesus":true}]},{"type":"verse","number":71,"content":["Ἔλεγε δὲ τὸν Ἰούδαν Σίμωνος",{"noteId":331},"Ἰσκαριώτην· οὗτος γὰρ",{"noteId":332},"ἔμελλεν αὐτὸν παραδιδόναι, εἷς",{"noteId":333},"ὢν ἐκ τῶν δώδεκα."]}],"footnotes":[{"noteId":237,"caller":"+","text":"και ηκολουθει ¦ ηκολουθει δε CT","reference":{"chapter":6,"verse":2}},{"noteId":238,"caller":"+","text":"εωρων 93.5% ¦ εθεωρουν NA SBL WH 2.6%","reference":{"chapter":6,"verse":2}},{"noteId":239,"caller":"+","text":"αυτου ¦ — CT","reference":{"chapter":6,"verse":2}},{"noteId":240,"caller":"+","text":"ο ¦ — CT","reference":{"chapter":6,"verse":3}},{"noteId":241,"caller":"+","text":"ο ιησους τους οφθαλμους ¦ τους οφθαλ