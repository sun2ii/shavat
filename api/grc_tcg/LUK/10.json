{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"LUK","translationId":"grc_tcg","name":"ΚΑΤΑ ΛΟΥΚΑΝ","commonName":"ΚΑΤΑ ΛΟΥΚΑΝ","title":"ΚΑΤΑ ΛΟΥΚΑΝ","order":42,"numberOfChapters":24,"sha256":"b8609ef71fdab51fb2a2ec7abf4402d02f5094e9b75db2d2aa00fac79cfd4207","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/grc_tcg/LUK/24.json","totalNumberOfVerses":1150},"chapter":{"number":10,"content":[{"type":"heading","content":["Jesus Sends Out the Seventy"]},{"type":"verse","number":1,"content":["Μετὰ δὲ ταῦτα ἀνέδειξεν ὁ Κύριος",{"noteId":728},"καὶ ἑτέρους",{"noteId":729},"ἑβδομήκοντα, καὶ ἀπέστειλεν αὐτοὺς ἀνὰ",{"noteId":730},"δύο πρὸ προσώπου αὐτοῦ εἰς πᾶσαν πόλιν καὶ τόπον οὗ",{"noteId":731},"ἔμελλεν αὐτὸς ἔρχεσθαι."]},{"type":"verse","number":2,"content":["Ἔλεγεν",{"noteId":732},"οὖν πρὸς αὐτούς,",{"text":"Ὁ μὲν θερισμὸς πολύς, οἱ δὲ ἐργάται ὀλίγοι· δεήθητε οὖν τοῦ Κυρίου τοῦ θερισμοῦ, ὅπως","wordsOfJesus":true},{"noteId":733},{"text":"ἐκβάλῃ ἐργάτας εἰς τὸν θερισμὸν αὐτοῦ.","wordsOfJesus":true}]},{"type":"verse","number":3,"content":[{"text":"Ὑπάγετε· ἰδού,","wordsOfJesus":true},{"noteId":734},{"text":"ἐγὼ ἀποστέλλω ὑμᾶς ὡς ἄρνας ἐν μέσῳ λύκων.","wordsOfJesus":true}]},{"type":"verse","number":4,"content":[{"text":"Μὴ βαστάζετε","wordsOfJesus":true},{"noteId":735},{"text":"βαλάντιον, μὴ πήραν,","wordsOfJesus":true},{"noteId":736},{"text":"μηδὲ ὑποδήματα· καὶ μηδένα κατὰ τὴν ὁδὸν ἀσπάσησθε.","wordsOfJesus":true}]},{"type":"verse","number":5,"content":[{"text":"Εἰς ἣν δ᾽ ἂν","wordsOfJesus":true},{"noteId":737},{"text":"οἰκίαν εἰσέρχησθε, πρῶτον λέγετε, Εἰρήνη τῷ οἴκῳ τούτῳ.","wordsOfJesus":true}]},{"type":"verse","number":6,"content":[{"text":"Καὶ ἐὰν","wordsOfJesus":true},{"noteId":738},{"text":"ᾖ ἐκεῖ","wordsOfJesus":true},{"noteId":739},{"text":"υἱὸς εἰρήνης,","wordsOfJesus":true},{"noteId":740},{"text":"ἐπαναπαύσεται ἐπ᾽ αὐτὸν ἡ εἰρήνη ὑμῶν· εἰ δὲ μήγε, ἐφ᾽ ὑμᾶς","wordsOfJesus":true},{"noteId":741},{"text":"ἀνακάμψει.","wordsOfJesus":true}]},{"type":"verse","number":7,"content":[{"text":"Ἐν αὐτῇ δὲ τῇ οἰκίᾳ μένετε,","wordsOfJesus":true},{"noteId":742},{"text":"ἐσθίοντες καὶ πίνοντες τὰ παρ᾽ αὐτῶν· ἄξιος γὰρ ὁ ἐργάτης τοῦ μισθοῦ αὐτοῦ","wordsOfJesus":true},{"noteId":743},{"text":"ἐστι. Μὴ μεταβαίνετε ἐξ οἰκίας εἰς οἰκίαν.","wordsOfJesus":true}]},{"type":"verse","number":8,"content":[{"text":"Καὶ εἰς ἣν","wordsOfJesus":true},{"noteId":744},{"text":"ἂν πόλιν εἰσέρχησθε, καὶ δέχωνται ὑμᾶς, ἐσθίετε τὰ παρατιθέμενα ὑμῖν,","wordsOfJesus":true}]},{"type":"verse","number":9,"content":[{"text":"καὶ θεραπεύετε τοὺς ἐν αὐτῇ ἀσθενεῖς, καὶ λέγετε αὐτοῖς, Ἤγγικεν ἐφ᾽ ὑμᾶς ἡ βασιλεία τοῦ Θεοῦ.","wordsOfJesus":true}]},{"type":"verse","number":10,"content":[{"text":"Εἰς ἣν δ᾽ ἂν πόλιν","wordsOfJesus":true},{"noteId":745},{"text":"εἰσέρχησθε, καὶ μὴ δέχωνται ὑμᾶς, ἐξελθόντες εἰς τὰς πλατείας αὐτῆς εἴπατε,","wordsOfJesus":true}]},{"type":"verse","number":11,"content":[{"text":"Καὶ τὸν κονιορτὸν τὸν κολληθέντα ἡμῖν","wordsOfJesus":true},{"noteId":746},{"text":"ἐκ τῆς πόλεως","wordsOfJesus":true},{"noteId":747},{"text":"ὑμῶν ἀπομασσόμεθα ὑμῖν· πλὴν τοῦτο","wordsOfJesus":true},{"noteId":748},{"text":"γινώσκετε, ὅτι ἤγγικεν","wordsOfJesus":true},{"noteId":749},{"text":"ἐφ᾽ ὑμᾶς ἡ βασιλεία τοῦ Θεοῦ.","wordsOfJesus":true}]},{"type":"verse","number":12,"content":[{"noteId":750},{"text":"Λέγω ὑμῖν ὅτι Σοδόμοις ἐν τῇ ἡμέρᾳ ἐκείνῃ ἀνεκτότερον ἔσται, ἢ τῇ πόλει ἐκείνῃ.","wordsOfJesus":true}]},{"type":"heading","content":["Woe to the Unrepentant"]},{"type":"verse","number":13,"content":[{"text":"Οὐαί σοι,","wordsOfJesus":true},{"noteId":751},{"text":"Χοραζίν, οὐαί σοι, Βηθσαϊδά· ὅτι εἰ ἐν Τύρῳ καὶ","wordsOfJesus":true},{"noteId":752},{"text":"Σιδῶνι","wordsOfJesus":true},{"noteId":753},{"text":"ἐγένοντο αἱ δυνάμεις αἱ γενόμεναι ἐν ὑμῖν, πάλαι ἂν ἐν σάκκῳ καὶ σποδῷ","wordsOfJesus":true},{"noteId":754},{"text":"καθήμεναι μετενόησαν.","wordsOfJesus":true}]},{"type":"verse","number":14,"content":[{"text":"Πλὴν Τύρῳ καὶ","wordsOfJesus":true},{"noteId":755},{"text":"Σιδῶνι ἀνεκτότερον ἔσται ἐν τῇ κρίσει, ἢ ὑμῖν.","wordsOfJesus":true}]},{"type":"verse","number":15,"content":[{"text":"Καὶ σύ,","wordsOfJesus":true},{"noteId":756},{"text":"Καπερναούμ,","wordsOfJesus":true},{"noteId":757},{"text":"ἡ ἕως τοῦ οὐρανοῦ ὑψωθεῖσα, ἕως","wordsOfJesus":true},{"noteId":758},{"text":"ᾍδου","wordsOfJesus":true},{"noteId":759},{"text":"καταβιβασθήσῃ.","wordsOfJesus":true}]},{"type":"verse","number":16,"content":[{"text":"Ὁ ἀκούων ὑμῶν ἐμοῦ ἀκούει· καὶ ὁ ἀθετῶν ὑμᾶς ἐμὲ ἀθετεῖ· ὁ δὲ ἐμὲ ἀθετῶν ἀθετεῖ τὸν ἀποστείλαντά με.","wordsOfJesus":true}]},{"type":"heading","content":["The Return of the Seventy"]},{"type":"verse","number":17,"content":["Ὑπέστρεψαν δὲ οἱ",{"noteId":760},"ἑβδομήκοντα μετὰ χαρᾶς, λέγοντες, Κύριε, καὶ τὰ δαιμόνια ὑποτάσσεται ἡμῖν ἐν τῷ ὀνόματί σου."]},{"type":"verse","number":18,"content":["Εἶπε δὲ αὐτοῖς,",{"text":"Ἐθεώρουν τὸν Σατανᾶν ὡς ἀστραπὴν ἐκ τοῦ οὐρανοῦ πεσόντα.","wordsOfJesus":true}]},{"type":"verse","number":19,"content":[{"text":"Ἰδού,","wordsOfJesus":true},{"noteId":761},{"text":"δίδωμι ὑμῖν τὴν ἐξουσίαν τοῦ πατεῖν ἐπάνω ὄφεων καὶ σκορπίων, καὶ ἐπὶ πᾶσαν τὴν δύναμιν τοῦ ἐχθροῦ· καὶ οὐδὲν ὑμᾶς οὐ μὴ","wordsOfJesus":true},{"noteId":762},{"text":"ἀδικήσῃ.","wordsOfJesus":true}]},{"type":"verse","number":20,"content":[{"text":"Πλὴν ἐν τούτῳ μὴ χαίρετε ὅτι τὰ πνεύματα ὑμῖν ὑποτάσσεται· χαίρετε","wordsOfJesus":true},{"noteId":763},{"text":"δὲ ὅτι τὰ ὀνόματα ὑμῶν","wordsOfJesus":true},{"noteId":764},{"text":"ἐγράφη ἐν τοῖς οὐρανοῖς.","wordsOfJesus":true}]},{"type":"heading","content":["Jesus Rejoices in the Spirit"]},{"type":"verse","number":21,"content":["Ἐν αὐτῇ τῇ ὥρᾳ ἠγαλλιάσατο",{"noteId":765},"τῷ πνεύματι ὁ Ἰησοῦς, καὶ εἶπεν,",{"text":"Ἐξομολογοῦμαί σοι, πάτερ, Κύριε τοῦ οὐρανοῦ καὶ τῆς γῆς, ὅτι ἀπέκρυψας ταῦτα ἀπὸ σοφῶν καὶ συνετῶν, καὶ ἀπεκάλυψας αὐτὰ νηπίοις. Ναί, ὁ πατήρ, ὅτι οὕτως","wordsOfJesus":true},{"noteId":766},{"text":"ἐγένετο εὐδοκία ἔμπροσθέν σου.","wordsOfJesus":true}]},{"type":"verse","number":22,"content":[{"noteId":767},"Καὶ στραφεὶς πρὸς τοὺς μαθητὰς εἶπε,",{"text":"Πάντα","wordsOfJesus":true},{"noteId":768},{"text":"μοι παρεδόθη ὑπὸ τοῦ πατρός μου· καὶ οὐδεὶς","wordsOfJesus":true},{"noteId":769},{"text":"γινώσκει τίς ἐστιν ὁ υἱός, εἰ μὴ ὁ πατήρ, καὶ τίς ἐστιν ὁ πατήρ, εἰ μὴ ὁ υἱός, καὶ ᾧ","wordsOfJesus":true},{"noteId":770},{"text":"ἐὰν βούληται ὁ υἱὸς ἀποκαλύψαι.","wordsOfJesus":true}]},{"type":"verse","number":23,"content":["Καὶ στραφεὶς πρὸς τοὺς μαθητὰς κατ᾽ ἰδίαν εἶπε,",{"text":"Μακάριοι οἱ ὀφθαλμοὶ οἱ βλέποντες ἃ βλέπετε.","wordsOfJesus":true}]},{"type":"verse","number":24,"content":[{"text":"Λέγω γὰρ ὑμῖν ὅτι πολλοὶ προφῆται καὶ βασιλεῖς ἠθέλησαν ἰδεῖν ἃ ὑμεῖς βλέπετε, καὶ οὐκ","wordsOfJesus":true},{"noteId":771},{"text":"εἶδον· καὶ ἀκοῦσαι ἃ ἀκούετε, καὶ οὐκ ἤκουσαν.","wordsOfJesus":true}]},{"type":"heading","content":["The Parable of the Good Samaritan"]},{"type":"verse","number":25,"content":["Καὶ ἰδού, νομικός τις ἀνέστη, ἐκπειράζων αὐτόν,",{"noteId":772},"καὶ λέγων, Διδάσκαλε, τί ποιήσας ζωὴν αἰώνιον κληρονομήσω;"]},{"type":"verse","number":26,"content":["Ὁ δὲ εἶπε πρὸς αὐτόν,",{"text":"Ἐν τῷ νόμῳ τί γέγραπται; Πῶς ἀναγινώσκεις;","wordsOfJesus":true}]},{"type":"verse","number":27,"content":["Ὁ δὲ ἀποκριθεὶς εἶπεν, Ἀγαπήσεις Κύριον τὸν Θεόν σου, ἐξ ὅλης",{"noteId":773},"τῆς καρδίας σου, καὶ",{"noteId":774},"ἐξ ὅλης τῆς ψυχῆς σου, καὶ",{"noteId":775},"ἐξ ὅλης τῆς ἰσχύος σου, καὶ",{"noteId":776},"ἐξ ὅλης τῆς διανοίας σου· καὶ τὸν πλησίον σου ὡς",{"noteId":777},"σεαυτόν."]},{"type":"verse","number":28,"content":["Εἶπε δὲ αὐτῷ,",{"text":"Ὀρθῶς ἀπεκρίθης· τοῦτο ποίει, καὶ ζήσῃ.","wordsOfJesus":true}]},{"type":"verse","number":29,"content":["Ὁ δὲ θέλων",{"noteId":778},"δικαιοῦν ἑαυτὸν εἶπε πρὸς τὸν Ἰησοῦν, Καὶ τίς ἐστί μου πλησίον;"]},{"type":"verse","number":30,"content":["Ὑπολαβὼν",{"noteId":779},"δὲ ὁ Ἰησοῦς εἶπεν,",{"text":"Ἄνθρωπός τις κατέβαινεν ἀπὸ Ἱερουσαλὴμ εἰς","wordsOfJesus":true},{"noteId":780},{"text":"Ἰεριχώ, καὶ λῃσταῖς περιέπεσεν, οἳ καὶ ἐκδύσαντες αὐτὸν καὶ πληγὰς ἐπιθέντες ἀπῆλθον, ἀφέντες ἡμιθανῆ","wordsOfJesus":true},{"noteId":781},{"text":"τυγχάνοντα.","wordsOfJesus":true}]},{"type":"verse","number":31,"content":[{"text":"Κατὰ συγκυρίαν δὲ ἱερεύς τις κατέβαινεν ἐν τῇ ὁδῷ ἐκείνῃ· καὶ ἰδὼν αὐτὸν ἀντιπαρῆλθεν.","wordsOfJesus":true}]},{"type":"verse","number":32,"content":[{"text":"Ὁμοίως δὲ καὶ","wordsOfJesus":true},{"noteId":782},{"text":"Λευΐτης","wordsOfJesus":true},{"noteId":783},{"text":"γενόμενος κατὰ τὸν τόπον ἐλθὼν καὶ ἰδὼν ἀντιπαρῆλθε.","wordsOfJesus":true}]},{"type":"verse","number":33,"content":[{"noteId":784},{"text":"Σαμαρείτης δέ τις ὁδεύων ἦλθε κατ᾽ αὐτόν, καὶ ἰδὼν","wordsOfJesus":true},{"noteId":785},{"text":"αὐτὸν ἐσπλαγχνίσθη,","wordsOfJesus":true}]},{"type":"verse","number":34,"content":[{"text":"καὶ προσελθὼν κατέδησε τὰ τραύματα αὐτοῦ, ἐπιχέων ἔλαιον καὶ οἶνον· ἐπιβιβάσας δὲ αὐτὸν ἐπὶ τὸ ἴδιον κτῆνος, ἤγαγεν αὐτὸν εἰς πανδοχεῖον, καὶ ἐπεμελήθη αὐτοῦ.","wordsOfJesus":true}]},{"type":"verse","number":35,"content":[{"text":"Καὶ ἐπὶ τὴν αὔριον","wordsOfJesus":true},{"noteId":786},{"text":"ἐξελθών, ἐκβαλὼν","wordsOfJesus":true},{"noteId":787},{"text":"δύο δηνάρια ἔδωκε τῷ πανδοχεῖ, καὶ εἶπεν","wordsOfJesus":true},{"noteId":788},{"text":"αὐτῷ, Ἐπιμελήθητι αὐτοῦ· καὶ ὅ τι ἂν προσδαπανήσῃς, ἐγὼ ἐν τῷ ἐπανέρχεσθαί με ἀποδώσω σοι.","wordsOfJesus":true}]},{"type":"verse","number":36,"content":[{"text":"Τίς","wordsOfJesus":true},{"noteId":789},{"text":"οὖν τούτων τῶν τριῶν","wordsOfJesus":true},{"noteId":790},{"text":"πλησίον δοκεῖ σοι γεγονέναι τοῦ ἐμπεσόντος εἰς τοὺς λῃστάς;","wordsOfJesus":true}]},{"type":"verse","number":37,"content":["Ὁ δὲ εἶπεν, Ὁ ποιήσας τὸ ἔλεος μετ᾽ αὐτοῦ. Εἶπεν",{"noteId":791},"οὖν αὐτῷ ὁ Ἰησοῦς,",{"text":"Πορεύου, καὶ σὺ ποίει ὁμοίως.","wordsOfJesus":true}]},{"type":"heading","content":["Jesus Visits Martha and Mary"]},{"type":"verse","number":38,"content":[{"noteId":792},"Ἐγένετο δὲ ἐν τῷ πορεύεσθαι αὐτούς,",{"noteId":793},"καὶ αὐτὸς εἰσῆλθεν εἰς κώμην τινά· γυνὴ δέ τις ὀνόματι Μάρθα ὑπεδέξατο αὐτὸν",{"noteId":794},"εἰς τὸν οἶκον αὐτῆς."]},{"type":"verse","number":39,"content":["Καὶ τῇδε ἦν ἀδελφὴ καλουμένη",{"noteId":795},"Μαρία,",{"noteId":796},"ἣ καὶ",{"noteId":797},"παρακαθίσασα παρὰ τοὺς πόδας τοῦ",{"noteId":798},"Ἰησοῦ ἤκουε",{"noteId":799},"τὸν λόγον αὐτοῦ."]},{"type":"verse","number":40,"content":["Ἡ δὲ Μάρθα περιεσπᾶτο περὶ πολλὴν διακονίαν· ἐπιστᾶσα δὲ εἶπε, Κύριε, οὐ μέλει σοι ὅτι ἡ ἀδελφή μου μόνην με",{"noteId":800},"κατέλειπε διακονεῖν;",{"noteId":801},"Εἰπὲ οὖν αὐτῇ ἵνα μοι συναντιλάβηται."]},{"type":"verse","number":41,"content":["Ἀποκριθεὶς δὲ",{"noteId":802},"εἶπεν αὐτῇ ὁ Ἰησοῦς,",{"text":"Μάρθα, Μάρθα, μεριμνᾷς καὶ","wordsOfJesus":true},{"noteId":803},{"text":"τυρβάζῃ περὶ πολλά·","wordsOfJesus":true}]},{"type":"verse","number":42,"content":[{"noteId":804},{"text":"ἑνὸς δέ ἐστι χρεία·","wordsOfJesus":true},{"noteId":805},{"text":"Μαρία","wordsOfJesus":true},{"noteId":806},{"text":"δὲ τὴν ἀγαθὴν μερίδα ἐξελέξατο, ἥτις οὐκ ἀφαιρεθήσεται","wordsOfJesus":true},{"noteId":807},{"text":"ἀπ᾽ αὐτῆς.","wordsOfJesus":true}]}],"footnotes":[{"noteId":728,"caller":"+","text":"και ¦ — NA TH WH","reference":{"chapter":10,"verse":1}},{"noteId":729,"caller":"+","text":"εβδομηκοντα ¦ εβδομηκοντα δυο NA SBL WH","reference":{"chapter":10,"verse":1}},{"noteId":730,"caller":"+","text":"δυο ¦ δυο 