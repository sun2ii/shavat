{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"LUK","translationId":"grc_tcg","name":"ΚΑΤΑ ΛΟΥΚΑΝ","commonName":"ΚΑΤΑ ΛΟΥΚΑΝ","title":"ΚΑΤΑ ΛΟΥΚΑΝ","order":42,"numberOfChapters":24,"sha256":"b8609ef71fdab51fb2a2ec7abf4402d02f5094e9b75db2d2aa00fac79cfd4207","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/grc_tcg/LUK/24.json","totalNumberOfVerses":1150},"chapter":{"number":11,"content":[{"type":"heading","content":["Instruction About Prayer"]},{"type":"verse","number":1,"content":["Καὶ ἐγένετο ἐν τῷ εἶναι αὐτὸν ἐν τόπῳ τινὶ προσευχόμενον, ὡς ἐπαύσατο, εἶπέ τις τῶν μαθητῶν αὐτοῦ πρὸς αὐτόν, Κύριε, δίδαξον ἡμᾶς προσεύχεσθαι, καθὼς καὶ",{"noteId":808},"Ἰωάννης ἐδίδαξε τοὺς μαθητὰς αὐτοῦ."]},{"type":"verse","number":2,"content":["Εἶπε δὲ αὐτοῖς,",{"text":"Ὅταν προσεύχησθε, λέγετε,","wordsOfJesus":true},{"lineBreak":true},{"text":"Πάτερ","wordsOfJesus":true,"poem":1},{"noteId":809},{"text":"ἡμῶν ὁ ἐν τοῖς οὐρανοῖς,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"ἁγιασθήτω τὸ ὄνομά σου.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"noteId":810},{"text":"Ἐλθέτω ἡ βασιλεία σου.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"noteId":811},{"text":"Γενηθήτω τὸ θέλημά σου,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"ὡς ἐν οὐρανῷ, καὶ ἐπὶ τῆς γῆς.","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Τὸν ἄρτον ἡμῶν τὸν ἐπιούσιον δίδου ἡμῖν τὸ καθ᾽ ἡμέραν.","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Καὶ ἄφες ἡμῖν τὰς ἁμαρτίας ἡμῶν,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"καὶ γὰρ αὐτοὶ","wordsOfJesus":true,"poem":1},{"noteId":812},{"text":"ἀφίεμεν παντὶ","wordsOfJesus":true,"poem":1},{"noteId":813},{"text":"ὀφείλοντι ἡμῖν.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Καὶ μὴ εἰσενέγκῃς ἡμᾶς εἰς πειρασμόν,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"noteId":814},{"text":"ἀλλὰ ῥῦσαι ἡμᾶς ἀπὸ τοῦ πονηροῦ.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":["Καὶ εἶπε πρὸς αὐτούς,",{"text":"Τίς ἐξ ὑμῶν ἕξει φίλον, καὶ πορεύσεται πρὸς αὐτὸν μεσονυκτίου, καὶ","wordsOfJesus":true},{"noteId":815},{"text":"εἴπῃ αὐτῷ, Φίλε, χρῆσόν μοι τρεῖς ἄρτους,","wordsOfJesus":true}]},{"type":"verse","number":6,"content":[{"text":"ἐπειδὴ","wordsOfJesus":true},{"noteId":816},{"text":"φίλος παρεγένετο ἐξ ὁδοῦ πρός με, καὶ οὐκ ἔχω ὃ παραθήσω αὐτῷ·","wordsOfJesus":true}]},{"type":"verse","number":7,"content":[{"text":"κἀκεῖνος ἔσωθεν ἀποκριθεὶς εἴπῃ, Μή μοι κόπους πάρεχε· ἤδη ἡ θύρα κέκλεισται, καὶ τὰ παιδία μου μετ᾽ ἐμοῦ εἰς τὴν κοίτην εἰσίν· οὐ δύναμαι ἀναστὰς δοῦναί σοι.","wordsOfJesus":true}]},{"type":"verse","number":8,"content":[{"text":"Λέγω ὑμῖν, εἰ καὶ οὐ δώσει αὐτῷ ἀναστάς, διὰ τὸ εἶναι","wordsOfJesus":true},{"noteId":817},{"text":"αὐτοῦ φίλον, διά γε τὴν","wordsOfJesus":true},{"noteId":818},{"text":"ἀναίδειαν αὐτοῦ ἐγερθεὶς δώσει αὐτῷ","wordsOfJesus":true},{"noteId":819},{"text":"ὅσον χρῄζει.","wordsOfJesus":true}]},{"type":"verse","number":9,"content":[{"text":"Κἀγὼ ὑμῖν λέγω, αἰτεῖτε, καὶ δοθήσεται ὑμῖν· ζητεῖτε, καὶ εὑρήσετε· κρούετε, καὶ ἀνοιγήσεται ὑμῖν.","wordsOfJesus":true}]},{"type":"verse","number":10,"content":[{"text":"Πᾶς γὰρ ὁ αἰτῶν λαμβάνει· καὶ ὁ ζητῶν εὑρίσκει· καὶ τῷ κρούοντι","wordsOfJesus":true},{"noteId":820},{"text":"ἀνοιγήσεται.","wordsOfJesus":true}]},{"type":"verse","number":11,"content":[{"text":"Τίνα δὲ","wordsOfJesus":true},{"noteId":821},{"text":"ὑμῶν τὸν πατέρα αἰτήσει ὁ υἱὸς","wordsOfJesus":true},{"noteId":822},{"text":"ἄρτον, μὴ λίθον ἐπιδώσει αὐτῷ; Ἢ καὶ ἰχθύν, μὴ ἀντὶ ἰχθύος ὄφιν","wordsOfJesus":true},{"noteId":823},{"text":"ἐπιδώσει αὐτῷ;","wordsOfJesus":true}]},{"type":"verse","number":12,"content":[{"text":"Ἢ καὶ","wordsOfJesus":true},{"noteId":824},{"text":"ἐὰν αἰτήσῃ ᾠόν,","wordsOfJesus":true},{"noteId":825},{"text":"μὴ ἐπιδώσει αὐτῷ σκορπίον;","wordsOfJesus":true}]},{"type":"verse","number":13,"content":[{"text":"Εἰ οὖν ὑμεῖς","wordsOfJesus":true},{"noteId":826},{"text":"πονηροὶ ὑπάρχοντες οἴδατε","wordsOfJesus":true},{"noteId":827},{"text":"δόματα ἀγαθὰ διδόναι τοῖς τέκνοις ὑμῶν, πόσῳ μᾶλλον ὁ πατὴρ ὁ ἐξ οὐρανοῦ δώσει Πνεῦμα","wordsOfJesus":true},{"noteId":828},{"text":"Ἅγιον τοῖς αἰτοῦσιν αὐτόν;","wordsOfJesus":true}]},{"type":"heading","content":["Jesus and Beelzebul"]},{"type":"verse","number":14,"content":["Καὶ ἦν ἐκβάλλων δαιμόνιον,",{"noteId":829},"καὶ αὐτὸ ἦν κωφόν. Ἐγένετο δέ, τοῦ δαιμονίου ἐξελθόντος, ἐλάλησεν ὁ κωφός· καὶ",{"noteId":830},"ἐθαύμασαν οἱ ὄχλοι."]},{"type":"verse","number":15,"content":["Τινὲς δὲ ἐξ αὐτῶν",{"noteId":831},"εἶπον, Ἐν",{"noteId":832},"Βεελζεβοὺλ",{"noteId":833},"ἄρχοντι τῶν δαιμονίων ἐκβάλλει τὰ δαιμόνια."]},{"type":"verse","number":16,"content":["Ἕτεροι δὲ πειράζοντες σημεῖον",{"noteId":834},"παρ᾽ αὐτοῦ ἐζήτουν ἐξ οὐρανοῦ."]},{"type":"verse","number":17,"content":["Αὐτὸς δὲ εἰδὼς αὐτῶν τὰ διανοήματα εἶπεν αὐτοῖς,",{"text":"Πᾶσα βασιλεία ἐφ᾽ ἑαυτὴν διαμερισθεῖσα ἐρημοῦται· καὶ οἶκος ἐπὶ οἶκον, πίπτει.","wordsOfJesus":true}]},{"type":"verse","number":18,"content":[{"text":"Εἰ δὲ καὶ ὁ Σατανᾶς ἐφ᾽ ἑαυτὸν διεμερίσθη, πῶς σταθήσεται ἡ βασιλεία αὐτοῦ; Ὅτι λέγετε ἐν","wordsOfJesus":true},{"noteId":835},{"text":"Βεελζεβοὺλ","wordsOfJesus":true},{"noteId":836},{"text":"ἐκβάλλειν με τὰ δαιμόνια.","wordsOfJesus":true}]},{"type":"verse","number":19,"content":[{"text":"Εἰ δὲ ἐγὼ ἐν","wordsOfJesus":true},{"noteId":837},{"text":"Βεελζεβοὺλ ἐκβάλλω τὰ δαιμόνια, οἱ υἱοὶ ὑμῶν ἐν τίνι","wordsOfJesus":true},{"noteId":838},{"text":"ἐκβάλλουσι; Διὰ τοῦτο","wordsOfJesus":true},{"noteId":839},{"text":"κριταὶ ὑμῶν αὐτοὶ ἔσονται.","wordsOfJesus":true}]},{"type":"verse","number":20,"content":[{"text":"Εἰ δὲ ἐν δακτύλῳ Θεοῦ","wordsOfJesus":true},{"noteId":840},{"text":"ἐκβάλλω τὰ δαιμόνια, ἄρα ἔφθασεν ἐφ᾽ ὑμᾶς ἡ βασιλεία τοῦ Θεοῦ.","wordsOfJesus":true}]},{"type":"verse","number":21,"content":[{"text":"Ὅταν ὁ ἰσχυρὸς καθωπλισμένος φυλάσσῃ τὴν ἑαυτοῦ αὐλήν, ἐν εἰρήνῃ ἐστὶ τὰ ὑπάρχοντα αὐτοῦ·","wordsOfJesus":true}]},{"type":"verse","number":22,"content":[{"text":"ἐπὰν δὲ","wordsOfJesus":true},{"noteId":841},{"text":"ὁ ἰσχυρότερος αὐτοῦ ἐπελθὼν νικήσῃ αὐτόν, τὴν πανοπλίαν αὐτοῦ αἴρει ἐφ᾽ ᾗ ἐπεποίθει, καὶ τὰ σκῦλα αὐτοῦ διαδίδωσιν.","wordsOfJesus":true}]},{"type":"verse","number":23,"content":[{"text":"Ὁ μὴ ὢν μετ᾽ ἐμοῦ κατ᾽ ἐμοῦ ἐστι· καὶ ὁ μὴ συνάγων μετ᾽ ἐμοῦ σκορπίζει.","wordsOfJesus":true}]},{"type":"heading","content":["An Unclean Spirit Returns"]},{"type":"verse","number":24,"content":[{"text":"Ὅταν τὸ ἀκάθαρτον πνεῦμα ἐξέλθῃ ἀπὸ τοῦ ἀνθρώπου, διέρχεται δι᾽ ἀνύδρων τόπων, ζητοῦν ἀνάπαυσιν· καὶ μὴ εὑρίσκον","wordsOfJesus":true},{"noteId":842},{"text":"λέγει, Ὑποστρέψω εἰς τὸν οἶκόν μου ὅθεν ἐξῆλθον.","wordsOfJesus":true}]},{"type":"verse","number":25,"content":[{"text":"Καὶ ἐλθὸν εὑρίσκει","wordsOfJesus":true},{"noteId":843},{"text":"σεσαρωμένον καὶ κεκοσμημένον.","wordsOfJesus":true}]},{"type":"verse","number":26,"content":[{"text":"Τότε πορεύεται καὶ παραλαμβάνει","wordsOfJesus":true},{"noteId":844},{"text":"ἑπτὰ ἕτερα πνεύματα πονηρότερα ἑαυτοῦ, καὶ","wordsOfJesus":true},{"noteId":845},{"text":"ἐλθόντα κατοικεῖ ἐκεῖ· καὶ","wordsOfJesus":true},{"noteId":846},{"text":"γίνεται τὰ ἔσχατα τοῦ ἀνθρώπου ἐκείνου χείρονα τῶν πρώτων.","wordsOfJesus":true}]},{"type":"heading","content":["True Blessedness"]},{"type":"verse","number":27,"content":["Ἐγένετο δὲ ἐν τῷ λέγειν αὐτὸν ταῦτα, ἐπάρασά τις",{"noteId":847},"γυνὴ φωνὴν ἐκ τοῦ ὄχλου εἶπεν αὐτῷ, Μακαρία ἡ κοιλία ἡ βαστάσασά σε, καὶ μαστοὶ οὓς ἐθήλασας."]},{"type":"verse","number":28,"content":["Αὐτὸς δὲ εἶπε,",{"noteId":848},{"text":"Μενοῦνγε μακάριοι οἱ ἀκούοντες τὸν λόγον τοῦ Θεοῦ καὶ φυλάσσοντες","wordsOfJesus":true},{"noteId":849},{"text":"αὐτόν.","wordsOfJesus":true}]},{"type":"heading","content":["The Sign of Jonah"]},{"type":"verse","number":29,"content":["Τῶν δὲ ὄχλων ἐπαθροιζομένων ἤρξατο λέγειν,",{"text":"Ἡ γενεὰ αὕτη","wordsOfJesus":true},{"noteId":850},{"text":"πονηρά ἐστι· σημεῖον","wordsOfJesus":true},{"noteId":851},{"text":"ἐπιζητεῖ, καὶ σημεῖον οὐ δοθήσεται αὐτῇ, εἰ μὴ τὸ σημεῖον Ἰωνᾶ","wordsOfJesus":true},{"noteId":852},{"text":"τοῦ προφήτου.","wordsOfJesus":true}]},{"type":"verse","number":30,"content":[{"text":"Καθὼς γὰρ ἐγένετο","wordsOfJesus":true},{"noteId":853},{"text":"Ἰωνᾶς","wordsOfJesus":true},{"noteId":854},{"text":"σημεῖον τοῖς Νινευΐταις, οὕτως ἔσται καὶ ὁ υἱὸς τοῦ ἀνθρώπου τῇ γενεᾷ","wordsOfJesus":true},{"noteId":855},{"text":"ταύτῃ.","wordsOfJesus":true}]},{"type":"verse","number":31,"content":[{"text":"Βασίλισσα νότου ἐγερθήσεται ἐν τῇ κρίσει μετὰ τῶν ἀνδρῶν τῆς γενεᾶς ταύτης, καὶ κατακρινεῖ αὐτούς· ὅτι ἦλθεν ἐκ τῶν περάτων τῆς γῆς ἀκοῦσαι τὴν σοφίαν","wordsOfJesus":true},{"noteId":856},{"text":"Σολομῶνος, καὶ ἰδού, πλεῖον","wordsOfJesus":true},{"noteId":857},{"text":"Σολομῶνος ὧδε.","wordsOfJesus":true}]},{"type":"verse","number":32,"content":[{"text":"Ἄνδρες","wordsOfJesus":true},{"noteId":858},{"text":"Νινευῒ ἀναστήσονται ἐν τῇ κρίσει μετὰ τῆς γενεᾶς ταύτης καὶ κατακρινοῦσιν αὐτήν· ὅτι μετενόησαν εἰς τὸ κήρυγμα Ἰωνᾶ, καὶ ἰδού, πλεῖον Ἰωνᾶ ὧδε.","wordsOfJesus":true}]},{"type":"heading","content":["The Lamp of the Body"]},{"type":"verse","number":33,"content":[{"text":"Οὐδεὶς","wordsOfJesus":true},{"noteId":859},{"text":"δὲ λύχνον ἅψας εἰς","wordsOfJesus":true},{"noteId":860},{"text":"κρύπτην τίθησιν,","wordsOfJesus":true},{"noteId":861},{"text":"οὐδὲ ὑπὸ τὸν μόδιον, ἀλλ᾽ ἐπὶ τὴν λυχνίαν, ἵνα οἱ εἰσπορευόμενοι τὸ","wordsOfJesus":true},{"noteId":862},{"text":"φέγγος βλέπωσιν.","wordsOfJesus":true}]},{"type":"verse","number":34,"content":[{"text":"Ὁ λύχνος τοῦ σώματός ἐστιν ὁ","wordsOfJesus":true},{"noteId":863},{"text":"ὀφθαλμός· ὅταν","wordsOfJesus":true},{"noteId":864},{"text":"οὖν ὁ ὀφθαλμός σου ἁπλοῦς ᾖ,","wordsOfJesus":true},{"noteId":865},{"text":"καὶ ὅλον τὸ σῶμά σου","wordsOfJesus":true},{"noteId":866},{"text":"φωτεινόν ἐστιν· ἐπὰν δὲ πονηρὸς ᾖ, καὶ τὸ σῶμά σου","wordsOfJesus":true},{"noteId":867},{"text":"σκοτεινόν.","wordsOfJesus":true}]},{"type":"verse","number":35,"content":[{"text":"Σκόπει οὖν μὴ τὸ φῶς τὸ ἐν σοὶ σκότος ἐστίν.","wordsOfJesus":true}]},{"type":"verse","number":36,"content":[{"text":"Εἰ οὖν τὸ σῶμά σου ὅλον","wordsOfJesus":true},{"noteId":868},{"text":"φωτεινόν, μὴ ἔχον","wordsOfJesus":true},{"noteId":869},{"text":"τι μέρος","wordsOfJesus":true},{"noteId":870},{"text":"σκοτεινόν, ἔσται","wordsOfJesus":true},{"noteId":871},{"text":"φωτεινὸν ὅλον, ὡς ὅταν ὁ λύχνος τῇ ἀστραπῇ φωτίζῃ σε.","wordsOfJesus":true}]},{"type":"heading","content":["Woe to the Pharisees and Lawyers"]},{"type":"verse","number":37,"content":["Ἐν δὲ τῷ",{"noteId":872},"λαλῆσαι,",{"noteId":873},"ἠρώτα αὐτὸν Φαρισαῖός",{"noteId":874},"τις ὅπως ἀριστήσῃ παρ᾽ αὐτῷ· εἰσελθὼν δὲ ἀνέπεσεν."]},{"type":"verse","number":38,"content":["Ὁ δὲ Φαρισαῖος ἰδὼν ἐθαύμασεν ὅτι οὐ πρῶτον ἐβαπτίσθη πρὸ τοῦ ἀρίστου."]},{"type":"verse","number":39,"content":["Εἶπε δὲ ὁ Κύριος πρὸς αὐτόν,",{"text":"Νῦν ὑμεῖς οἱ Φαρισαῖοι τὸ ἔξωθεν τοῦ ποτηρίου καὶ τοῦ πίνακος καθαρίζετε, τὸ δὲ ἔσωθεν ὑμῶν γέμει ἁρπαγῆς καὶ πονηρίας.","wordsOfJesus":true}]},{"type":"verse","number":40,"content":[{"text":"Ἄφρονες, οὐχ ὁ ποιήσας τὸ ἔξωθεν καὶ τὸ ἔσωθεν ἐποίησε;","wordsOfJesus":true}]},{"type":"verse","number":41,"content":[{"text":"Πλὴν τὰ ἐνόντα δότε ἐλεημοσύνην· καὶ ἰδού,","wordsOfJesus":true},{"noteId":875},{"text":"πάντα καθαρὰ ὑμῖν","wordsOfJesus":true},{"noteId":876},{"text":"ἐστιν.","wordsOfJesus":true}]},{"type":"verse","number":42,"content":[{"noteId":877},{"text":"Ἀλλ᾽ οὐαὶ ὑμῖν τοῖς Φαρισαίοις, ὅτι ἀποδεκατοῦτε τὸ ἡδύοσμον καὶ τὸ πήγανον καὶ πᾶν λάχανον, καὶ παρέρχεσθε τὴν κρίσιν καὶ τὴν ἀγάπην τοῦ Θεοῦ·","wordsOfJesus":true},{"noteId":878},{"text":"ταῦτα ἔδει ποιῆσαι, κἀκεῖνα μὴ","wordsOfJesus":true},{"noteId":879},{"text":"ἀφιέναι.","wordsOfJesus":true}]},{"type":"verse","number":43,"content":[{"text":"Οὐαὶ ὑμῖν τοῖς Φαρισαίοις, ὅτι ἀγαπᾶτε τὴν πρωτοκαθεδρίαν ἐν ταῖς συναγωγαῖς, καὶ τοὺς ἀσπασμοὺς ἐν ταῖς ἀγοραῖς.","wordsOfJesus":true}]},{"type":"verse","number":44,"content":[{"text":"Οὐαὶ ὑμῖν,","wordsOfJesus":true},{"noteId":880},{"text":"γραμματεῖς καὶ Φαρισαῖοι, ὑποκριταί, ὅτι ἐστὲ ὡς τὰ μνημεῖα τὰ ἄδηλα, καὶ οἱ ἄνθρωποι","wordsOfJesus":true},{"noteId":881},{"text":"περιπατοῦντες ἐπάνω οὐκ οἴδασιν.","wordsOfJesus":true}]},{"type":"verse","number":45,"content":["Ἀποκριθεὶς δέ τις τῶν νομικῶν λέγει αὐτῷ, Διδάσκαλε, ταῦτα λέγων καὶ ἡμᾶς ὑβρίζεις."]},{"type":"verse","number":46,"content":["Ὁ δὲ εἶπε,",{"text":"Καὶ ὑμῖν τοῖς νομικοῖς οὐαί, ὅτι φορτίζετε τοὺς ἀνθρώπους φορτία δυσβάστακτα, καὶ αὐτοὶ ἑνὶ τῶν δακτύλων ὑμῶν οὐ προσψαύετε τοῖς φορτίοις.","wordsOfJesus":true}]},{"type":"verse","number":47,"content":[{"text":"Οὐαὶ ὑμῖν, ὅτι οἰκοδομεῖτε τὰ μνημεῖα τῶν προφητῶν, οἱ δὲ πατέρες ὑμῶν ἀπέκτειναν αὐτούς.","wordsOfJesus":true}]},{"type":"verse","number":48,"content":[{"text":"Ἄρα","wordsOfJesus":true},{"noteId":882},{"text":"μαρτυρεῖτε καὶ συνευδοκεῖτε τοῖς ἔργοις τῶν πατέρων ὑμῶν· ὅτι αὐτοὶ μὲν ἀπέκτειναν αὐτούς, ὑμεῖς δὲ οἰκοδομεῖτε","wordsOfJesus":true},{"noteId":883},{"text":"αὐτῶν τὰ μνημεῖα.","wordsOfJesus":true}]},{"type":"verse","number":49,"content":[{"text":"Διὰ τοῦτο καὶ ἡ σοφία τοῦ Θεοῦ εἶπεν, Ἀποστελῶ εἰς αὐτοὺς προφήτας καὶ ἀποστόλους, καὶ ἐξ αὐτῶν ἀποκτενοῦσι καὶ","wordsOfJesus":true},{"noteId":884},{"text":"ἐκδιώξουσιν·","wordsOfJesus":true}]},{"type":"verse","number":50,"content":[{"text":"ἵνα ἐκζητηθῇ τὸ αἷμα πάντων τῶν προφητῶν τὸ","wordsOfJesus":true},{"noteId":885},{"text":"ἐκχυνόμενον ἀπὸ καταβολῆς κόσμου ἀπὸ τῆς γενεᾶς ταύτης,","wordsOfJesus":true}]},{"type":"verse","number":51,"content":[{"text":"ἀπὸ","wordsOfJesus":true},{"noteId":886},{"text":"τοῦ αἵματος Ἄβελ ἕως","wordsOfJesus":true},{"noteId":887},{"text":"τοῦ αἵματος Ζαχαρίου τοῦ ἀπολομένου μεταξὺ τοῦ θυσιαστηρίου καὶ τοῦ οἴκου. Ναί, λέγω ὑμῖν, ἐκζητηθήσεται ἀπὸ τῆς γενεᾶς ταύτης.","wordsOfJesus":true}]},{"type":"verse","number":52,"content":[{"text":"Οὐαὶ ὑμῖν τοῖς νομικοῖς, ὅτι ἤρατε τὴν κλεῖδα τῆς γνώσεως· αὐτοὶ οὐκ","wordsOfJesus":true},{"noteId":888},{"text":"εἰσήλθετε, καὶ τοὺς εἰσερχομένους ἐκωλύσατε.","wordsOfJesus":true}]},{"type":"verse","number":53,"content":[{"noteId":889},"Λέγοντος δὲ αὐτοῦ",{"noteId":890},"ταῦτα πρὸς αὐτούς, ἤρξαντο οἱ γραμματεῖς καὶ οἱ Φαρισαῖοι δεινῶς",{"noteId":891},"ἐνέχειν, καὶ ἀποστοματίζειν αὐτὸν περὶ πλειόνων,"]},{"type":"verse","number":54,"content":["ἐνεδρεύοντες αὐτόν,",{"noteId":892},"ζητοῦντες θηρεῦσαί τι ἐκ τοῦ στόματος αὐτοῦ,",{"noteId":893},"ἵνα κατηγορήσωσιν αὐτοῦ."]}],"footnotes":[{"noteId":808,"caller":"+","text":"ιωαννης ¦ ιωανης WH","reference":{"chapter":11,"verse":1}},{"noteId":809,"caller":"+","text":"ημων ο εν τοις ουρανοις ¦ — CT","reference":{"chapter":11,"verse":2}},{"noteId":810,"caller":"+","text":"ελθετω ¦ ελθατω WH","reference":{"chapter":11,"verse":2}},{"noteId":811,"caller":"+","text":"γενηθητω το θελημα σου ως εν ουρανω και επι της γης ¦ — CT","reference":{"chapter":11,"verse":2}},{"noteId":812,"caller":"+","text":"αφιεμεν ¦ αφιομεν CT","reference":{"chapter":11,"verse":4}},{"noteId":813,"caller":"+","text":"οφειλοντι ¦ τω οφειλοντι ANT","reference":{"chapter":11,"verse":4}},{"noteId":814,"caller":"+","text":"αλλα ρυσαι ημας απο του πονηρου ¦ — CT","reference":{"chapter":11,"verse":4}},{"noteId":815,"caller":"+","text":"ειπη ¦ ερει ANT","reference"