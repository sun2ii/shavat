{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"LUK","translationId":"grc_tcg","name":"ΚΑΤΑ ΛΟΥΚΑΝ","commonName":"ΚΑΤΑ ΛΟΥΚΑΝ","title":"ΚΑΤΑ ΛΟΥΚΑΝ","order":42,"numberOfChapters":24,"sha256":"b8609ef71fdab51fb2a2ec7abf4402d02f5094e9b75db2d2aa00fac79cfd4207","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/grc_tcg/LUK/24.json","totalNumberOfVerses":1150},"chapter":{"number":17,"content":[{"type":"heading","content":["Temptations to Sin"]},{"type":"verse","number":1,"content":[{"noteId":1155},"Εἶπε",{"noteId":1156},"δὲ πρὸς τοὺς",{"noteId":1157},"μαθητάς,",{"text":"Ἀνένδεκτόν ἐστι τοῦ","wordsOfJesus":true},{"noteId":1158},{"text":"μὴ ἐλθεῖν τὰ σκάνδαλα·","wordsOfJesus":true},{"noteId":1159},{"text":"οὐαὶ δὲ δι᾽ οὗ ἔρχεται.","wordsOfJesus":true}]},{"type":"verse","number":2,"content":[{"text":"Λυσιτελεῖ αὐτῷ εἰ","wordsOfJesus":true},{"noteId":1160},{"text":"μύλος ὀνικὸς περίκειται περὶ τὸν τράχηλον αὐτοῦ, καὶ ἔρριπται εἰς τὴν θάλασσαν, ἢ ἵνα σκανδαλίσῃ","wordsOfJesus":true},{"noteId":1161},{"text":"ἕνα τῶν μικρῶν τούτων.","wordsOfJesus":true}]},{"type":"verse","number":3,"content":[{"text":"Προσέχετε ἑαυτοῖς. Ἐὰν","wordsOfJesus":true},{"noteId":1162},{"text":"δὲ ἁμάρτῃ","wordsOfJesus":true},{"noteId":1163},{"text":"εἰς σὲ ὁ ἀδελφός σου, ἐπιτίμησον αὐτῷ· καὶ ἐὰν μετανοήσῃ, ἄφες αὐτῷ.","wordsOfJesus":true}]},{"type":"verse","number":4,"content":[{"text":"Καὶ ἐὰν ἑπτάκις τῆς ἡμέρας","wordsOfJesus":true},{"noteId":1164},{"text":"ἁμάρτῃ εἰς σέ, καὶ ἑπτάκις","wordsOfJesus":true},{"noteId":1165},{"text":"τῆς ἡμέρας","wordsOfJesus":true},{"noteId":1166},{"text":"ἐπιστρέψῃ, λέγων, Μετανοῶ, ἀφήσεις αὐτῷ.","wordsOfJesus":true}]},{"type":"heading","content":["Increase Our Faith"]},{"type":"verse","number":5,"content":["Καὶ",{"noteId":1167},"εἶπον οἱ ἀπόστολοι τῷ Κυρίῳ, Πρόσθες ἡμῖν πίστιν."]},{"type":"verse","number":6,"content":["Εἶπε δὲ ὁ Κύριος,",{"text":"Εἰ","wordsOfJesus":true},{"noteId":1168},{"text":"ἔχετε πίστιν ὡς κόκκον σινάπεως, ἐλέγετε ἂν τῇ συκαμίνῳ","wordsOfJesus":true},{"noteId":1169},{"text":"ταύτῃ, Ἐκριζώθητι, καὶ φυτεύθητι ἐν τῇ θαλάσσῃ· καὶ ὑπήκουσεν ἂν ὑμῖν.","wordsOfJesus":true}]},{"type":"heading","content":["We Are Unworthy Servants"]},{"type":"verse","number":7,"content":[{"text":"Τίς δὲ ἐξ ὑμῶν δοῦλον ἔχων ἀροτριῶντα ἢ ποιμαίνοντα, ὃς εἰσελθόντι ἐκ τοῦ ἀγροῦ","wordsOfJesus":true},{"noteId":1170},{"text":"ἐρεῖ εὐθέως, Παρελθὼν","wordsOfJesus":true},{"noteId":1171},{"text":"ἀνάπεσε·","wordsOfJesus":true}]},{"type":"verse","number":8,"content":[{"text":"ἀλλ᾽ οὐχὶ ἐρεῖ αὐτῷ, Ἑτοίμασον τί δειπνήσω, καὶ περιζωσάμενος διακόνει μοι, ἕως φάγω καὶ πίω· καὶ μετὰ ταῦτα φάγεσαι καὶ πίεσαι σύ;","wordsOfJesus":true}]},{"type":"verse","number":9,"content":[{"text":"Μὴ","wordsOfJesus":true},{"noteId":1172},{"text":"χάριν ἔχει τῷ δούλῳ","wordsOfJesus":true},{"noteId":1173},{"text":"ἐκείνῳ ὅτι ἐποίησε τὰ διαταχθέντα;","wordsOfJesus":true},{"noteId":1174},{"text":"Οὐ δοκῶ.","wordsOfJesus":true}]},{"type":"verse","number":10,"content":[{"text":"Οὕτω καὶ ὑμεῖς, ὅταν ποιήσητε πάντα τὰ διαταχθέντα ὑμῖν, λέγετε ὅτι Δοῦλοι ἀχρεῖοί ἐσμεν·","wordsOfJesus":true},{"noteId":1175},{"text":"ὅτι ὃ","wordsOfJesus":true},{"noteId":1176},{"text":"ὀφείλομεν ποιῆσαι πεποιήκαμεν.","wordsOfJesus":true}]},{"type":"heading","content":["Jesus Cleanses Ten Lepers"]},{"type":"verse","number":11,"content":["Καὶ ἐγένετο ἐν τῷ πορεύεσθαι",{"noteId":1177},"αὐτὸν εἰς Ἱερουσαλήμ, καὶ αὐτὸς διήρχετο διὰ",{"noteId":1178},"μέσου",{"noteId":1179},"Σαμαρείας καὶ Γαλιλαίας."]},{"type":"verse","number":12,"content":["Καὶ εἰσερχομένου αὐτοῦ εἴς τινα κώμην, ἀπήντησαν",{"noteId":1180},"αὐτῷ δέκα λεπροὶ ἄνδρες, οἳ",{"noteId":1181},"ἔστησαν πόρρωθεν·"]},{"type":"verse","number":13,"content":["καὶ αὐτοὶ ἦραν φωνήν, λέγοντες, Ἰησοῦ, ἐπιστάτα, ἐλέησον ἡμᾶς."]},{"type":"verse","number":14,"content":["Καὶ ἰδὼν εἶπεν αὐτοῖς,",{"text":"Πορευθέντες ἐπιδείξατε ἑαυτοὺς τοῖς ἱερεῦσι.","wordsOfJesus":true},"Καὶ ἐγένετο ἐν τῷ ὑπάγειν αὐτούς, ἐκαθαρίσθησαν."]},{"type":"verse","number":15,"content":["Εἷς δὲ ἐξ αὐτῶν, ἰδὼν ὅτι ἰάθη, ὑπέστρεψε, μετὰ φωνῆς μεγάλης δοξάζων τὸν Θεόν·"]},{"type":"verse","number":16,"content":["καὶ ἔπεσεν ἐπὶ πρόσωπον παρὰ τοὺς πόδας αὐτοῦ, εὐχαριστῶν αὐτῷ· καὶ αὐτὸς ἦν",{"noteId":1182},"Σαμαρείτης."]},{"type":"verse","number":17,"content":["Ἀποκριθεὶς δὲ ὁ Ἰησοῦς εἶπεν,",{"noteId":1183},{"text":"Οὐχὶ οἱ δέκα ἐκαθαρίσθησαν; Οἱ δὲ ἐννέα ποῦ;","wordsOfJesus":true}]},{"type":"verse","number":18,"content":[{"text":"Οὐχ εὑρέθησαν ὑποστρέψαντες δοῦναι δόξαν τῷ Θεῷ, εἰ μὴ ὁ ἀλλογενὴς οὗτος;","wordsOfJesus":true}]},{"type":"verse","number":19,"content":["Καὶ εἶπεν αὐτῷ,",{"text":"Ἀναστὰς πορεύου· ἡ πίστις σου σέσωκέ σε.","wordsOfJesus":true}]},{"type":"heading","content":["The Coming of the Kingdom"]},{"type":"verse","number":20,"content":["Ἐπερωτηθεὶς δὲ ὑπὸ τῶν Φαρισαίων, πότε ἔρχεται ἡ βασιλεία τοῦ Θεοῦ, ἀπεκρίθη αὐτοῖς καὶ εἶπεν,",{"text":"Οὐκ ἔρχεται ἡ βασιλεία τοῦ Θεοῦ μετὰ παρατηρήσεως·","wordsOfJesus":true}]},{"type":"verse","number":21,"content":[{"text":"οὐδὲ ἐροῦσιν, Ἰδοὺ ὧδε, ἤ,","wordsOfJesus":true},{"noteId":1184},{"text":"Ἰδοὺ ἐκεῖ. Ἰδοὺ γάρ, ἡ βασιλεία τοῦ Θεοῦ ἐντὸς ὑμῶν ἐστιν.","wordsOfJesus":true}]},{"type":"verse","number":22,"content":["Εἶπε δὲ πρὸς τοὺς μαθητάς,",{"text":"Ἐλεύσονται ἡμέραι ὅτε ἐπιθυμήσετε μίαν τῶν ἡμερῶν τοῦ υἱοῦ τοῦ ἀνθρώπου ἰδεῖν, καὶ οὐκ ὄψεσθε.","wordsOfJesus":true}]},{"type":"verse","number":23,"content":[{"text":"Καὶ ἐροῦσιν ὑμῖν, Ἰδοὺ","wordsOfJesus":true},{"noteId":1185},{"text":"ὧδε, ἤ, Ἰδοὺ ἐκεῖ· μὴ ἀπέλθητε, μηδὲ διώξητε.","wordsOfJesus":true}]},{"type":"verse","number":24,"content":[{"text":"Ὥσπερ γὰρ ἡ ἀστραπὴ","wordsOfJesus":true},{"noteId":1186},{"text":"ἡ ἀστράπτουσα ἐκ τῆς","wordsOfJesus":true},{"noteId":1187},{"text":"ὑπ᾽ οὐρανὸν εἰς τὴν ὑπ᾽ οὐρανὸν λάμπει, οὕτως ἔσται","wordsOfJesus":true},{"noteId":1188},{"text":"ὁ υἱὸς τοῦ ἀνθρώπου","wordsOfJesus":true},{"noteId":1189},{"text":"ἐν τῇ ἡμέρᾳ αὐτοῦ.","wordsOfJesus":true}]},{"type":"verse","number":25,"content":[{"text":"Πρῶτον δὲ δεῖ αὐτὸν πολλὰ παθεῖν καὶ ἀποδοκιμασθῆναι ἀπὸ τῆς γενεᾶς ταύτης.","wordsOfJesus":true}]},{"type":"verse","number":26,"content":[{"text":"Καὶ καθὼς ἐγένετο ἐν ταῖς ἡμέραις","wordsOfJesus":true},{"noteId":1190},{"text":"Νῶε, οὕτως ἔσται καὶ ἐν ταῖς ἡμέραις τοῦ υἱοῦ τοῦ ἀνθρώπου.","wordsOfJesus":true}]},{"type":"verse","number":27,"content":[{"text":"Ἤσθιον, ἔπινον, ἐγάμουν,","wordsOfJesus":true},{"noteId":1191},{"text":"ἐξεγαμίζοντο, ἄχρι ἧς ἡμέρας εἰσῆλθε Νῶε εἰς τὴν κιβωτόν, καὶ ἦλθεν ὁ κατακλυσμός, καὶ ἀπώλεσεν","wordsOfJesus":true},{"noteId":1192},{"text":"ἅπαντας.","wordsOfJesus":true}]},{"type":"verse","number":28,"content":[{"text":"Ὁμοίως","wordsOfJesus":true},{"noteId":1193},{"text":"καὶ ὡς ἐγένετο ἐν ταῖς ἡμέραις Λώτ· ἤσθιον, ἔπινον, ἠγόραζον, ἐπώλουν, ἐφύτευον, ᾠκοδόμουν·","wordsOfJesus":true}]},{"type":"verse","number":29,"content":[{"text":"ᾗ δὲ ἡμέρᾳ ἐξῆλθε Λὼτ ἀπὸ Σοδόμων, ἔβρεξε πῦρ καὶ θεῖον ἀπ᾽ οὐρανοῦ, καὶ ἀπώλεσεν","wordsOfJesus":true},{"noteId":1194},{"text":"ἅπαντας·","wordsOfJesus":true}]},{"type":"verse","number":30,"content":[{"text":"κατὰ","wordsOfJesus":true},{"noteId":1195},{"text":"ταῦτα ἔσται ᾗ ἡμέρᾳ ὁ υἱὸς τοῦ ἀνθρώπου ἀποκαλύπτεται.","wordsOfJesus":true}]},{"type":"verse","number":31,"content":[{"text":"Ἐν ἐκείνῃ τῇ ἡμέρᾳ, ὃς ἔσται ἐπὶ τοῦ δώματος, καὶ τὰ σκεύη αὐτοῦ ἐν τῇ οἰκίᾳ, μὴ καταβάτω ἆραι αὐτά· καὶ ὁ ἐν","wordsOfJesus":true},{"noteId":1196},{"text":"τῷ ἀγρῷ ὁμοίως μὴ ἐπιστρεψάτω εἰς τὰ ὀπίσω.","wordsOfJesus":true}]},{"type":"verse","number":32,"content":[{"text":"Μνημονεύετε τῆς γυναικὸς Λώτ.","wordsOfJesus":true}]},{"type":"verse","number":33,"content":[{"text":"Ὃς ἐὰν ζητήσῃ τὴν ψυχὴν αὐτοῦ","wordsOfJesus":true},{"noteId":1197},{"text":"σῶσαι ἀπολέσει αὐτήν·","wordsOfJesus":true},{"noteId":1198},{"text":"καὶ ὃς ἐὰν","wordsOfJesus":true},{"noteId":1199},{"text":"ἀπολέσῃ","wordsOfJesus":true},{"noteId":1200},{"text":"αὐτὴν ζῳογονήσει αὐτήν.","wordsOfJesus":true}]},{"type":"verse","number":34,"content":[{"text":"Λέγω ὑμῖν, ταύτῃ τῇ νυκτὶ","wordsOfJesus":true},{"noteId":1201},{"text":"ἔσονται δύο ἐπὶ","wordsOfJesus":true},{"noteId":1202},{"text":"κλίνης μιᾶς·","wordsOfJesus":true},{"noteId":1203},{"text":"εἷς","wordsOfJesus":true},{"noteId":1204},{"text":"παραληφθήσεται, καὶ ὁ ἕτερος ἀφεθήσεται.","wordsOfJesus":true}]},{"type":"verse","number":35,"content":[{"noteId":1205},{"text":"Δύο ἔσονται ἀλήθουσαι ἐπὶ τὸ αὐτό·","wordsOfJesus":true},{"noteId":1206},{"text":"μία","wordsOfJesus":true},{"noteId":1207},{"text":"παραληφθήσεται,","wordsOfJesus":true},{"noteId":1208},{"text":"καὶ ἡ ἑτέρα","wordsOfJesus":true},{"noteId":1209},{"text":"ἀφεθήσεται.","wordsOfJesus":true}]},{"type":"verse","number":37,"content":["Καὶ ἀποκριθέντες λέγουσιν αὐτῷ, Ποῦ, Κύριε; Ὁ δὲ εἶπεν αὐτοῖς,",{"text":"Ὅπου τὸ σῶμα, ἐκεῖ","wordsOfJesus":true},{"noteId":1210},{"text":"συναχθήσονται οἱ ἀετοί.","wordsOfJesus":true}]}],"footnotes":[{"noteId":1155,"caller":"+","text":"ειπε ¦ ελεγε ANT","reference":{"chapter":17,"verse":1}},{"noteId":1156,"caller":"+","text":"δε ¦ δε και ANT","reference":{"chapter":17,"verse":1}},{"noteId":1157,"caller":"+","text":"μαθητας ¦ μαθητας αυτου ANT CT","reference":{"chapter":17,"verse":1}},{"noteId":1158,"caller":"+","text":"μη ελθειν τα σκανδαλα ¦ τα σκανδαλα μη ελθειν CT","reference":{"chapter":17,"verse":1}},{"noteId":1159,"caller":"+","text":"ουαι δε ¦ πλην ουαι