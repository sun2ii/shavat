{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"LUK","translationId":"grc_tcg","name":"ΚΑΤΑ ΛΟΥΚΑΝ","commonName":"ΚΑΤΑ ΛΟΥΚΑΝ","title":"ΚΑΤΑ ΛΟΥΚΑΝ","order":42,"numberOfChapters":24,"sha256":"b8609ef71fdab51fb2a2ec7abf4402d02f5094e9b75db2d2aa00fac79cfd4207","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/grc_tcg/LUK/24.json","totalNumberOfVerses":1150},"chapter":{"number":18,"content":[{"type":"heading","content":["The Parable of the Widow and the Unrighteous Judge"]},{"type":"verse","number":1,"content":["Ἔλεγε δὲ",{"noteId":1211},"καὶ παραβολὴν αὐτοῖς πρὸς τὸ δεῖν πάντοτε",{"noteId":1212},"προσεύχεσθαι, καὶ μὴ",{"noteId":1213},"ἐκκακεῖν,"]},{"type":"verse","number":2,"content":["λέγων,",{"text":"Κριτής τις ἦν ἔν τινι πόλει, τὸν Θεὸν μὴ φοβούμενος, καὶ ἄνθρωπον μὴ ἐντρεπόμενος·","wordsOfJesus":true}]},{"type":"verse","number":3,"content":[{"text":"χήρα δὲ ἦν ἐν τῇ πόλει ἐκείνῃ, καὶ ἤρχετο πρὸς αὐτόν, λέγουσα, Ἐκδίκησόν με ἀπὸ τοῦ ἀντιδίκου μου.","wordsOfJesus":true}]},{"type":"verse","number":4,"content":[{"text":"Καὶ οὐκ","wordsOfJesus":true},{"noteId":1214},{"text":"ἠθέλησεν ἐπὶ χρόνον· μετὰ","wordsOfJesus":true},{"noteId":1215},{"text":"δὲ ταῦτα εἶπεν ἐν ἑαυτῷ, Εἰ καὶ τὸν Θεὸν οὐ φοβοῦμαι,","wordsOfJesus":true},{"noteId":1216},{"text":"καὶ ἄνθρωπον οὐκ ἐντρέπομαι·","wordsOfJesus":true}]},{"type":"verse","number":5,"content":[{"text":"διά γε τὸ παρέχειν μοι κόπον τὴν χήραν ταύτην, ἐκδικήσω αὐτήν, ἵνα μὴ εἰς τέλος ἐρχομένη","wordsOfJesus":true},{"noteId":1217},{"text":"ὑποπιάζῃ με.","wordsOfJesus":true}]},{"type":"verse","number":6,"content":["Εἶπε δὲ ὁ Κύριος,",{"text":"Ἀκούσατε τί ὁ κριτὴς τῆς ἀδικίας λέγει.","wordsOfJesus":true}]},{"type":"verse","number":7,"content":[{"text":"Ὁ δὲ Θεὸς οὐ μὴ","wordsOfJesus":true},{"noteId":1218},{"text":"ποιήσῃ τὴν ἐκδίκησιν τῶν ἐκλεκτῶν αὐτοῦ τῶν βοώντων","wordsOfJesus":true},{"noteId":1219},{"text":"πρὸς αὐτὸν ἡμέρας καὶ νυκτός, καὶ","wordsOfJesus":true},{"noteId":1220},{"text":"μακροθυμῶν ἐπ᾽ αὐτοῖς;","wordsOfJesus":true}]},{"type":"verse","number":8,"content":[{"text":"Λέγω ὑμῖν ὅτι ποιήσει τὴν ἐκδίκησιν αὐτῶν ἐν τάχει. Πλὴν ὁ υἱὸς τοῦ ἀνθρώπου ἐλθὼν ἆρα εὑρήσει τὴν πίστιν ἐπὶ τῆς γῆς;","wordsOfJesus":true}]},{"type":"heading","content":["The Parable of the Pharisee and the Tax Collector"]},{"type":"verse","number":9,"content":["Εἶπε",{"noteId":1221},"δὲ πρός τινας τοὺς πεποιθότας ἐφ᾽ ἑαυτοῖς ὅτι εἰσὶ δίκαιοι, καὶ",{"noteId":1222},"ἐξουθενοῦντας τοὺς λοιπούς, τὴν παραβολὴν ταύτην·"]},{"type":"verse","number":10,"content":[{"text":"Ἄνθρωποι δύο ἀνέβησαν εἰς τὸ ἱερὸν προσεύξασθαι·","wordsOfJesus":true},{"noteId":1223},{"text":"ὁ εἷς Φαρισαῖος, καὶ ὁ ἕτερος τελώνης.","wordsOfJesus":true}]},{"type":"verse","number":11,"content":[{"text":"Ὁ Φαρισαῖος σταθεὶς","wordsOfJesus":true},{"noteId":1224},{"text":"πρὸς ἑαυτὸν ταῦτα προσηύχετο, Ὁ Θεός, εὐχαριστῶ σοι ὅτι οὐκ εἰμὶ ὥσπερ οἱ λοιποὶ τῶν ἀνθρώπων, ἅρπαγες, ἄδικοι, μοιχοί, ἢ καὶ ὡς οὗτος ὁ τελώνης.","wordsOfJesus":true}]},{"type":"verse","number":12,"content":[{"text":"Νηστεύω δὶς τοῦ σαββάτου,","wordsOfJesus":true},{"noteId":1225},{"text":"ἀποδεκατῶ πάντα ὅσα κτῶμαι.","wordsOfJesus":true}]},{"type":"verse","number":13,"content":[{"noteId":1226},{"text":"Καὶ ὁ τελώνης μακρόθεν ἑστὼς οὐκ ἤθελεν οὐδὲ τοὺς ὀφθαλμοὺς","wordsOfJesus":true},{"noteId":1227},{"text":"εἰς τὸν οὐρανὸν ἐπᾶραι, ἀλλ᾽ ἔτυπτεν","wordsOfJesus":true},{"noteId":1228},{"text":"εἰς τὸ στῆθος","wordsOfJesus":true},{"noteId":1229},{"text":"αὐτοῦ, λέγων, Ὁ Θεός,","wordsOfJesus":true},{"noteId":1230},{"text":"ἱλάσθητί μοι τῷ ἁμαρτωλῷ.","wordsOfJesus":true}]},{"type":"verse","number":14,"content":[{"text":"Λέγω ὑμῖν, κατέβη οὗτος δεδικαιωμένος εἰς τὸν οἶκον αὐτοῦ","wordsOfJesus":true},{"noteId":1231},{"text":"ἢ γὰρ ἐκεῖνος· ὅτι πᾶς ὁ ὑψῶν ἑαυτὸν ταπεινωθήσεται, ὁ δὲ ταπεινῶν ἑαυτὸν ὑψωθήσεται.","wordsOfJesus":true}]},{"type":"heading","content":["Let the Little Children Come to Me"]},{"type":"verse","number":15,"content":["Προσέφερον δὲ αὐτῷ καὶ τὰ βρέφη, ἵνα αὐτῶν ἅπτηται·",{"noteId":1232},"ἰδόντες δὲ οἱ μαθηταὶ",{"noteId":1233},"ἐπετίμησαν αὐτοῖς."]},{"type":"verse","number":16,"content":["Ὁ δὲ Ἰησοῦς",{"noteId":1234},"προσκαλεσάμενος αὐτὰ εἶπεν,",{"text":"Ἄφετε τὰ παιδία ἔρχεσθαι πρός με, καὶ μὴ κωλύετε αὐτά· τῶν γὰρ τοιούτων ἐστὶν ἡ βασιλεία τοῦ Θεοῦ.","wordsOfJesus":true}]},{"type":"verse","number":17,"content":[{"text":"Ἀμὴν λέγω ὑμῖν, ὃς","wordsOfJesus":true},{"noteId":1235},{"text":"ἐὰν μὴ δέξηται τὴν βασιλείαν τοῦ Θεοῦ ὡς παιδίον, οὐ μὴ εἰσέλθῃ εἰς αὐτήν.","wordsOfJesus":true}]},{"type":"heading","content":["The Rich Young Ruler"]},{"type":"verse","number":18,"content":["Καὶ ἐπηρώτησέ τις αὐτὸν ἄρχων, λέγων, Διδάσκαλε ἀγαθέ, τί ποιήσας ζωὴν αἰώνιον κληρονομήσω;"]},{"type":"verse","number":19,"content":["Εἶπε δὲ αὐτῷ ὁ Ἰησοῦς,",{"text":"Τί με λέγεις ἀγαθόν; Οὐδεὶς ἀγαθός, εἰ μὴ εἷς, ὁ Θεός.","wordsOfJesus":true}]},{"type":"verse","number":20,"content":[{"text":"Τὰς ἐντολὰς οἶδας, Μὴ μοιχεύσῃς, μὴ φονεύσῃς, μὴ κλέψῃς, μὴ ψευδομαρτυρήσῃς, τίμα τὸν πατέρα σου καὶ τὴν μητέρα","wordsOfJesus":true},{"noteId":1236},{"text":"σου.","wordsOfJesus":true}]},{"type":"verse","number":21,"content":["Ὁ δὲ εἶπε, Ταῦτα πάντα",{"noteId":1237},"ἐφυλαξάμην ἐκ νεότητός",{"noteId":1238},"μου."]},{"type":"verse","number":22,"content":["Ἀκούσας δὲ",{"noteId":1239},"ταῦτα ὁ Ἰησοῦς εἶπεν αὐτῷ,",{"text":"Ἔτι ἕν σοι λείπει· πάντα ὅσα ἔχεις πώλησον, καὶ διάδος πτωχοῖς, καὶ ἕξεις θησαυρὸν ἐν","wordsOfJesus":true},{"noteId":1240},{"text":"οὐρανῷ· καὶ δεῦρο, ἀκολούθει μοι.","wordsOfJesus":true}]},{"type":"verse","number":23,"content":["Ὁ δὲ ἀκούσας ταῦτα περίλυπος",{"noteId":1241},"ἐγένετο· ἦν γὰρ πλούσιος σφόδρα."]},{"type":"verse","number":24,"content":["Ἰδὼν δὲ αὐτὸν ὁ Ἰησοῦς",{"noteId":1242},"περίλυπον γενόμενον εἶπε,",{"text":"Πῶς δυσκόλως οἱ τὰ χρήματα ἔχοντες","wordsOfJesus":true},{"noteId":1243},{"text":"εἰσελεύσονται εἰς τὴν βασιλείαν τοῦ Θεοῦ.","wordsOfJesus":true}]},{"type":"verse","number":25,"content":[{"text":"Εὐκοπώτερον γάρ ἐστι κάμηλον διὰ","wordsOfJesus":true},{"noteId":1244},{"text":"τρυμαλιᾶς ῥαφίδος εἰσελθεῖν, ἢ πλούσιον εἰς τὴν βασιλείαν τοῦ Θεοῦ εἰσελθεῖν.","wordsOfJesus":true}]},{"type":"verse","number":26,"content":[{"noteId":1245},"Εἶπον δὲ οἱ ἀκούσαντες, Καὶ τίς δύναται σωθῆναι;"]},{"type":"verse","number":27,"content":["Ὁ δὲ εἶπε,",{"text":"Τὰ ἀδύνατα παρὰ ἀνθρώποις δυνατά","wordsOfJesus":true},{"noteId":1246},{"text":"ἐστι παρὰ τῷ Θεῷ.","wordsOfJesus":true}]},{"type":"verse","number":28,"content":["Εἶπε δὲ",{"noteId":1247},"Πέτρος, Ἰδού, ἡμεῖς",{"noteId":1248},"ἀφήκαμεν πάντα καὶ ἠκολουθήσαμέν σοι."]},{"type":"verse","number":29,"content":["Ὁ δὲ εἶπεν αὐτοῖς,",{"text":"Ἀμὴν λέγω ὑμῖν ὅτι οὐδείς ἐστιν ὃς ἀφῆκεν οἰκίαν, ἢ","wordsOfJesus":true},{"noteId":1249},{"text":"γονεῖς, ἢ ἀδελφούς, ἢ γυναῖκα, ἢ τέκνα,","wordsOfJesus":true},{"noteId":1250},{"text":"ἕνεκεν τῆς βασιλείας τοῦ Θεοῦ,","wordsOfJesus":true}]},{"type":"verse","number":30,"content":[{"text":"ὃς","wordsOfJesus":true},{"noteId":1251},{"text":"οὐ μὴ","wordsOfJesus":true},{"noteId":1252},{"text":"ἀπολάβῃ πολλαπλασίονα ἐν τῷ καιρῷ τούτῳ, καὶ ἐν τῷ αἰῶνι τῷ ἐρχομένῳ ζωὴν αἰώνιον.","wordsOfJesus":true}]},{"type":"heading","content":["Jesus Predicts His Death and Resurrection a Third Time"]},{"type":"verse","number":31,"content":["Παραλαβὼν δὲ τοὺς δώδεκα, εἶπε πρὸς αὐτούς,",{"text":"Ἰδού, ἀναβαίνομεν εἰς","wordsOfJesus":true},{"noteId":1253},{"text":"Ἱεροσόλυμα, καὶ","wordsOfJesus":true},{"noteId":1254},{"text":"τελεσθήσεται πάντα τὰ γεγραμμένα διὰ τῶν προφητῶν τῷ υἱῷ τοῦ ἀνθρώπου.","wordsOfJesus":true}]},{"type":"verse","number":32,"content":[{"text":"Παραδοθήσεται γὰρ τοῖς ἔθνεσι, καὶ ἐμπαιχθήσεται, καὶ ὑβρισθήσεται, καὶ ἐμπτυσθήσεται,","wordsOfJesus":true}]},{"type":"verse","number":33,"content":[{"text":"καὶ μαστιγώσαντες ἀποκτενοῦσιν αὐτόν· καὶ τῇ ἡμέρᾳ τῇ τρίτῃ ἀναστήσεται.","wordsOfJesus":true}]},{"type":"verse","number":34,"content":["Καὶ αὐτοὶ οὐδὲν τούτων συνῆκαν, καὶ ἦν τὸ ῥῆμα τοῦτο κεκρυμμένον ἀπ᾽ αὐτῶν, καὶ οὐκ",{"noteId":1255},"ἐγίνωσκον τὰ λεγόμενα."]},{"type":"heading","content":["Jesus Heals a Blind Man"]},{"type":"verse","number":35,"content":["Ἐγένετο δὲ ἐν τῷ ἐγγίζειν αὐτὸν εἰς",{"noteId":1256},"Ἰεριχώ, τυφλός τις ἐκάθητο παρὰ τὴν ὁδὸν",{"noteId":1257},"προσαιτῶν·"]},{"type":"verse","number":36,"content":["ἀκούσας δὲ ὄχλου διαπορευομένου, ἐπυνθάνετο τί εἴη",{"noteId":1258},"τοῦτο."]},{"type":"verse","number":37,"content":["Ἀπήγγειλαν δὲ αὐτῷ ὅτι Ἰησοῦς ὁ Ναζωραῖος παρέρχεται."]},{"type":"verse","number":38,"content":["Καὶ ἐβόησε, λέγων, Ἰησοῦ, υἱὲ",{"noteId":1259},"Δαυίδ, ἐλέησόν με."]},{"type":"verse","number":39,"content":["Καὶ οἱ προάγοντες ἐπετίμων αὐτῷ ἵνα",{"noteId":1260},"σιωπήσῃ· αὐτὸς δὲ πολλῷ μᾶλλον ἔκραζεν, Υἱὲ",{"noteId":1261},"Δαυίδ, ἐλέησόν με."]},{"type":"verse","number":40,"content":["Σταθεὶς δὲ",{"noteId":1262},"ὁ Ἰησοῦς ἐκέλευσεν αὐτὸν ἀχθῆναι πρὸς αὐτόν· ἐγγίσαντος δὲ αὐτοῦ ἐπηρώτησεν αὐτόν,"]},{"type":"verse","number":41,"content":[{"noteId":1263},"λέγων,",{"text":"Τί σοι θέλεις ποιήσω;","wordsOfJesus":true},"Ὁ δὲ εἶπε, Κύριε, ἵνα ἀναβλέψω."]},{"type":"verse","number":42,"content":["Καὶ ὁ Ἰησοῦς εἶπεν αὐτῷ,",{"text":"Ἀνάβλεψον· ἡ πίστις σου σέσωκέ σε.","wordsOfJesus":true}]},{"type":"verse","number":43,"content":["Καὶ παραχρῆμα ἀνέβλεψε, καὶ ἠκολούθει αὐτῷ, δοξάζων τὸν Θεόν· καὶ πᾶς ὁ λαὸς ἰδὼν ἔδωκεν αἶνον τῷ Θεῷ."]}],"footnotes":[{"no