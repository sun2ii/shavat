{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"LUK","translationId":"grc_tcg","name":"ΚΑΤΑ ΛΟΥΚΑΝ","commonName":"ΚΑΤΑ ΛΟΥΚΑΝ","title":"ΚΑΤΑ ΛΟΥΚΑΝ","order":42,"numberOfChapters":24,"sha256":"b8609ef71fdab51fb2a2ec7abf4402d02f5094e9b75db2d2aa00fac79cfd4207","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/grc_tcg/LUK/24.json","totalNumberOfVerses":1150},"chapter":{"number":19,"content":[{"type":"heading","content":["Jesus Visits Zacchaeus"]},{"type":"verse","number":1,"content":["Καὶ εἰσελθὼν διήρχετο τὴν",{"noteId":1264},"Ἰεριχώ."]},{"type":"verse","number":2,"content":["Καὶ ἰδού, ἀνὴρ ὀνόματι καλούμενος Ζακχαῖος, καὶ αὐτὸς ἦν ἀρχιτελώνης, καὶ",{"noteId":1265},"οὗτος ἦν πλούσιος."]},{"type":"verse","number":3,"content":["Καὶ ἐζήτει ἰδεῖν τὸν Ἰησοῦν τίς ἐστι, καὶ οὐκ ἠδύνατο ἀπὸ τοῦ ὄχλου, ὅτι τῇ ἡλικίᾳ μικρὸς ἦν."]},{"type":"verse","number":4,"content":["Καὶ προδραμὼν",{"noteId":1266},"ἔμπροσθεν ἀνέβη ἐπὶ",{"noteId":1267},"συκομωραίαν ἵνα ἴδῃ αὐτόν· ὅτι",{"noteId":1268},"ἐκείνης",{"noteId":1269},"ἔμελλε διέρχεσθαι."]},{"type":"verse","number":5,"content":["Καὶ ὡς ἦλθεν ἐπὶ τὸν τόπον, ἀναβλέψας ὁ Ἰησοῦς",{"noteId":1270},"εἶδεν αὐτόν, καὶ εἶπε πρὸς αὐτόν,",{"text":"Ζακχαῖε, σπεύσας κατάβηθι· σήμερον γὰρ ἐν τῷ οἴκῳ σου δεῖ με μεῖναι.","wordsOfJesus":true}]},{"type":"verse","number":6,"content":["Καὶ σπεύσας κατέβη, καὶ ὑπεδέξατο αὐτὸν χαίρων."]},{"type":"verse","number":7,"content":["Καὶ ἰδόντες",{"noteId":1271},"πάντες διεγόγγυζον, λέγοντες ὅτι Παρὰ ἁμαρτωλῷ ἀνδρὶ εἰσῆλθε καταλῦσαι."]},{"type":"verse","number":8,"content":["Σταθεὶς δὲ Ζακχαῖος εἶπε πρὸς τὸν Κύριον, Ἰδού, τὰ",{"noteId":1272},"ἡμίση τῶν ὑπαρχόντων μου, Κύριε,",{"noteId":1273},"δίδωμι τοῖς πτωχοῖς· καὶ εἴ τινός τι ἐσυκοφάντησα, ἀποδίδωμι τετραπλοῦν."]},{"type":"verse","number":9,"content":["Εἶπε δὲ πρὸς αὐτὸν ὁ Ἰησοῦς ὅτι",{"text":"Σήμερον σωτηρία τῷ οἴκῳ τούτῳ ἐγένετο, καθότι καὶ αὐτὸς υἱὸς Ἀβραάμ ἐστιν.","wordsOfJesus":true}]},{"type":"verse","number":10,"content":[{"text":"Ἦλθε γὰρ ὁ υἱὸς τοῦ ἀνθρώπου ζητῆσαι καὶ σῶσαι τὸ ἀπολωλός.","wordsOfJesus":true}]},{"type":"heading","content":["The Parable of the Ten Minas"]},{"type":"verse","number":11,"content":["Ἀκουόντων δὲ αὐτῶν ταῦτα, προσθεὶς εἶπε παραβολήν, διὰ τὸ ἐγγὺς",{"noteId":1274},"αὐτὸν εἶναι Ἱερουσαλήμ, καὶ δοκεῖν αὐτοὺς ὅτι παραχρῆμα μέλλει ἡ βασιλεία τοῦ Θεοῦ ἀναφαίνεσθαι."]},{"type":"verse","number":12,"content":["Εἶπεν οὖν,",{"text":"Ἄνθρωπός τις εὐγενὴς ἐπορεύθη εἰς χώραν μακράν, λαβεῖν ἑαυτῷ βασιλείαν, καὶ ὑποστρέψαι.","wordsOfJesus":true}]},{"type":"verse","number":13,"content":[{"text":"Καλέσας δὲ δέκα δούλους ἑαυτοῦ, ἔδωκεν αὐτοῖς δέκα μνᾶς, καὶ εἶπε πρὸς αὐτούς,","wordsOfJesus":true},{"noteId":1275},{"text":"Πραγματεύσασθε","wordsOfJesus":true},{"noteId":1276},{"text":"ἕως ἔρχομαι.","wordsOfJesus":true}]},{"type":"verse","number":14,"content":[{"text":"Οἱ δὲ","wordsOfJesus":true},{"noteId":1277},{"text":"πολῖται αὐτοῦ","wordsOfJesus":true},{"noteId":1278},{"text":"ἐμίσουν αὐτόν, καὶ ἀπέστειλαν πρεσβείαν ὀπίσω αὐτοῦ, λέγοντες, Οὐ θέλομεν τοῦτον βασιλεῦσαι ἐφ᾽ ἡμᾶς.","wordsOfJesus":true}]},{"type":"verse","number":15,"content":[{"text":"Καὶ ἐγένετο ἐν τῷ ἐπανελθεῖν αὐτὸν λαβόντα τὴν βασιλείαν,","wordsOfJesus":true},{"noteId":1279},{"text":"καὶ εἶπε φωνηθῆναι αὐτῷ τοὺς δούλους τούτους, οἷς","wordsOfJesus":true},{"noteId":1280},{"text":"ἔδωκε τὸ ἀργύριον, ἵνα","wordsOfJesus":true},{"noteId":1281},{"text":"γνῷ","wordsOfJesus":true},{"noteId":1282},{"text":"τίς τί διεπραγματεύσατο.","wordsOfJesus":true}]},{"type":"verse","number":16,"content":[{"text":"Παρεγένετο δὲ ὁ πρῶτος, λέγων, Κύριε, ἡ μνᾶ σου","wordsOfJesus":true},{"noteId":1283},{"text":"προσειργάσατο δέκα μνᾶς.","wordsOfJesus":true}]},{"type":"verse","number":17,"content":[{"text":"Καὶ εἶπεν αὐτῷ,","wordsOfJesus":true},{"noteId":1284},{"text":"Εὖ, ἀγαθὲ δοῦλε· ὅτι ἐν ἐλαχίστῳ πιστὸς ἐγένου, ἴσθι ἐξουσίαν ἔχων ἐπάνω δέκα πόλεων.","wordsOfJesus":true}]},{"type":"verse","number":18,"content":[{"text":"Καὶ ἦλθεν ὁ δεύτερος, λέγων,","wordsOfJesus":true},{"noteId":1285},{"text":"Κύριε, ἡ μνᾶ σου ἐποίησε πέντε μνᾶς.","wordsOfJesus":true}]},{"type":"verse","number":19,"content":[{"text":"Εἶπε δὲ καὶ τούτῳ, Καὶ σὺ","wordsOfJesus":true},{"noteId":1286},{"text":"γίνου ἐπάνω πέντε πόλεων.","wordsOfJesus":true}]},{"type":"verse","number":20,"content":[{"text":"Καὶ","wordsOfJesus":true},{"noteId":1287},{"text":"ἕτερος ἦλθε, λέγων, Κύριε, ἰδού, ἡ μνᾶ σου, ἣν εἶχον ἀποκειμένην ἐν σουδαρίῳ·","wordsOfJesus":true}]},{"type":"verse","number":21,"content":[{"text":"ἐφοβούμην γάρ σε, ὅτι ἄνθρωπος αὐστηρὸς εἶ· αἴρεις ὃ οὐκ ἔθηκας, καὶ θερίζεις ὃ οὐκ","wordsOfJesus":true},{"noteId":1288},{"text":"ἔσπειρας.","wordsOfJesus":true}]},{"type":"verse","number":22,"content":[{"text":"Λέγει","wordsOfJesus":true},{"noteId":1289},{"text":"δὲ αὐτῷ, Ἐκ τοῦ στόματός σου κρινῶ σε, πονηρὲ δοῦλε. ᾜδεις ὅτι","wordsOfJesus":true},{"noteId":1290},{"text":"ἐγὼ ἄνθρωπος αὐστηρός εἰμι, αἴρων ὃ οὐκ ἔθηκα, καὶ θερίζων ὃ οὐκ","wordsOfJesus":true},{"noteId":1291},{"text":"ἔσπειρα·","wordsOfJesus":true}]},{"type":"verse","number":23,"content":[{"text":"καὶ διὰ τί οὐκ ἔδωκας","wordsOfJesus":true},{"noteId":1292},{"text":"τὸ ἀργύριόν μου ἐπὶ","wordsOfJesus":true},{"noteId":1293},{"text":"τράπεζαν,","wordsOfJesus":true},{"noteId":1294},{"text":"καὶ ἐγὼ ἐλθὼν σὺν τόκῳ ἂν","wordsOfJesus":true},{"noteId":1295},{"text":"ἔπραξα αὐτό;","wordsOfJesus":true}]},{"type":"verse","number":24,"content":[{"text":"Καὶ τοῖς παρεστῶσιν εἶπεν, Ἄρατε ἀπ᾽ αὐτοῦ τὴν μνᾶν, καὶ δότε τῷ τὰς δέκα μνᾶς ἔχοντι.","wordsOfJesus":true}]},{"type":"verse","number":25,"content":[{"text":"Καὶ","wordsOfJesus":true},{"noteId":1296},{"text":"εἶπον αὐτῷ, Κύριε, ἔχει δέκα μνᾶς.","wordsOfJesus":true}]},{"type":"verse","number":26,"content":[{"text":"Λέγω","wordsOfJesus":true},{"noteId":1297},{"text":"γὰρ ὑμῖν ὅτι παντὶ τῷ ἔχοντι δοθήσεται· ἀπὸ δὲ τοῦ μὴ ἔχοντος, καὶ ὃ ἔχει ἀρθήσεται","wordsOfJesus":true},{"noteId":1298},{"text":"ἀπ᾽ αὐτοῦ.","wordsOfJesus":true}]},{"type":"verse","number":27,"content":[{"text":"Πλὴν τοὺς ἐχθρούς μου","wordsOfJesus":true},{"noteId":1299},{"text":"ἐκείνους, τοὺς μὴ θελήσαντάς με βασιλεῦσαι ἐπ᾽ αὐτούς, ἀγάγετε ὧδε, καὶ","wordsOfJesus":true},{"noteId":1300},{"text":"κατασφάξατε ἔμπροσθέν μου.","wordsOfJesus":true}]},{"type":"heading","content":["The Triumphal Entry"]},{"type":"verse","number":28,"content":["Καὶ εἰπὼν ταῦτα, ἐπορεύετο ἔμπροσθεν, ἀναβαίνων εἰς Ἱεροσόλυμα."]},{"type":"verse","number":29,"content":["Καὶ ἐγένετο ὡς ἤγγισεν εἰς",{"noteId":1301},"Βηθσφαγὴ καὶ",{"noteId":1302},"Βηθανίαν πρὸς τὸ ὄρος τὸ καλούμενον Ἐλαιῶν, ἀπέστειλε δύο τῶν μαθητῶν",{"noteId":1303},"αὐτοῦ,"]},{"type":"verse","number":30,"content":[{"noteId":1304},"εἰπών,",{"text":"Ὑπάγετε εἰς τὴν κατέναντι κώμην· ἐν ᾗ εἰσπορευόμενοι εὑρήσετε πῶλον δεδεμένον, ἐφ᾽ ὃν οὐδεὶς πώποτε ἀνθρώπων","wordsOfJesus":true},{"noteId":1305},{"text":"ἐκάθισε· λύσαντες αὐτὸν ἀγάγετε.","wordsOfJesus":true}]},{"type":"verse","number":31,"content":[{"text":"Καὶ ἐάν τις ὑμᾶς ἐρωτᾷ, Διὰ τί λύετε; οὕτως ἐρεῖτε","wordsOfJesus":true},{"noteId":1306},{"text":"αὐτῷ ὅτι Ὁ Κύριος αὐτοῦ χρείαν ἔχει.","wordsOfJesus":true}]},{"type":"verse","number":32,"content":["Ἀπελθόντες δὲ οἱ ἀπεσταλμένοι εὗρον καθὼς εἶπεν",{"noteId":1307},"αὐτοῖς."]},{"type":"verse","number":33,"content":["Λυόντων δὲ αὐτῶν τὸν πῶλον,",{"noteId":1308},"εἶπον οἱ κύριοι αὐτοῦ πρὸς αὐτούς, Τί λύετε τὸν πῶλον;"]},{"type":"verse","number":34,"content":["Οἱ δὲ",{"noteId":1309},"εἶπον, Ὁ Κύριος αὐτοῦ χρείαν ἔχει."]},{"type":"verse","number":35,"content":["Καὶ ἤγαγον αὐτὸν πρὸς τὸν Ἰησοῦν· καὶ",{"noteId":1310},"ἐπιρρίψαντες",{"noteId":1311},"ἑαυτῶν τὰ ἱμάτια ἐπὶ τὸν πῶλον, ἐπεβίβασαν τὸν Ἰησοῦν."]},{"type":"verse","number":36,"content":["Πορευομένου δὲ αὐτοῦ, ὑπεστρώννυον τὰ ἱμάτια",{"noteId":1312},"αὐτῶν ἐν τῇ ὁδῷ."]},{"type":"verse","number":37,"content":["Ἐγγίζοντος δὲ αὐτοῦ ἤδη πρὸς τῇ καταβάσει τοῦ ὄρους τῶν Ἐλαιῶν,",{"noteId":1313},"ἤρξαντο ἅπαν τὸ πλῆθος τῶν μαθητῶν χαίροντες αἰνεῖν τὸν Θεὸν φωνῇ μεγάλῃ περὶ πασῶν ὧν εἶδον δυνάμεων,"]},{"type":"verse","number":38,"content":["λέγοντες,",{"lineBreak":true},{"text":"Εὐλογημένος ὁ ἐρχόμενος","poem":1},{"lineBreak":true},{"noteId":1314},{"text":"βασιλεὺς ἐν ὀνόματι Κυρίου·","poem":1},{"lineBreak":true},{"noteId":1315},{"text":"εἰρήνη ἐν οὐρανῷ,","poem":1},{"lineBreak":true},{"text":"καὶ δόξα ἐν ὑψίστοις.","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":["Καί τινες τῶν Φαρισαίων ἀπὸ τοῦ ὄχλου",{"noteId":1316},"εἶπον πρὸς αὐτόν, Διδάσκαλε, ἐπιτίμησον τοῖς μαθηταῖς σου."]},{"type":"verse","number":40,"content":["Καὶ ἀποκριθεὶς εἶπεν",{"noteId":1317},"αὐτοῖς,",{"text":"Λέγω ὑμῖν","wordsOfJesus":true},{"noteId":1318},{"text":"ὅτι ἐὰν οὗτοι","wordsOfJesus":true},{"noteId":1319},{"text":"σιωπήσωσιν, οἱ λίθοι","wordsOfJesus":true},{"noteId":1320},{"text":"κεκράξονται.","wordsOfJesus":true}]},{"type":"heading","content":["Jesus Weeps over Jerusalem"]},{"type":"verse","number":41,"content":["Καὶ ὡς ἤγγισεν, ἰδὼν τὴν πόλιν, ἔκλαυσεν ἐπ᾽",{"noteId":1321},"αὐτῇ,"]},{"type":"verse","number":42,"content":["λέγων ὅτι",{"text":"Εἰ ἔγνως","wordsOfJesus":true},{"noteId":1322},{"text":"καὶ σύ, καί γε ἐν τῇ ἡμέρᾳ σου ταύτῃ, τὰ πρὸς εἰρήνην","wordsOfJesus":true},{"noteId":1323},{"text":"σου· νῦν δὲ ἐκρύβη ἀπὸ ὀφθαλμῶν σου.","wordsOfJesus":true}]},{"type":"verse","number":43,"content":[{"text":"Ὅτι ἥξουσιν ἡμέραι ἐπὶ σέ, καὶ","wordsOfJesus":true},{"noteId":1324},{"text":"περιβαλοῦσιν οἱ ἐχθροί σου χάρακά σοι, καὶ περικυκλώσουσί σε, καὶ συνέξουσί σε πάντοθεν,","wordsOfJesus":true}]},{"type":"verse","number":44,"content":[{"text":"καὶ ἐδαφιοῦσί σε καὶ τὰ τέκνα σου ἐν σοί, καὶ οὐκ ἀφήσουσιν","wordsOfJesus":true},{"noteId":1325},{"text":"ἐν σοὶ λίθον ἐπὶ λίθῳ· ἀνθ᾽ ὧν οὐκ ἔγνως τὸν καιρὸν τῆς ἐπισκοπῆς σου.","wordsOfJesus":true}]},{"type":"heading","content":["Jesus Cleanses the Temple Courts"]},{"type":"verse","number":45,"content":["Καὶ εἰσελθὼν εἰς τὸ ἱερόν, ἤρξατο ἐκβάλλειν τοὺς πωλοῦντας",{"noteId":1326},"ἐν αὐτῷ καὶ ἀγοράζοντας,"]},{"type":"verse","number":46,"content":["λέγων αὐτοῖς,",{"noteId":1327},"Γέγραπται,",{"noteId":1328},{"text":"Ὁ οἶκός μου οἶκος προσευχῆς ἐστιν· ὑμεῖς δὲ αὐτὸν ἐποιήσατε σπήλαιον λῃστῶν.","wordsOfJesus":true}]},{"type":"verse","number":47,"content":["Καὶ ἦν διδάσκων τὸ καθ᾽ ἡμέραν ἐν τῷ ἱερῷ· οἱ δὲ ἀρχιερεῖς καὶ οἱ γραμματεῖς ἐζήτουν αὐτὸν ἀπολέσαι, καὶ οἱ πρῶτοι τοῦ λαοῦ·"]},{"type":"verse","number":48,"content":["καὶ οὐχ",{"noteId":1329},"εὕρισκον τὸ τί",{"noteId":1330},"ποιήσωσιν, ὁ λαὸς γὰρ ἅπας",{"noteId":1331},"ἐξεκρέματο αὐτοῦ ἀκούων."]}],"footnotes":[{"noteId":1264,"caller":"+","text":"ιεριχω ¦ ιερειχω TH WH","reference":{"chapter":19,"verse":1}},{"noteId":1265,"caller":"+","text":"ουτος ην ¦ αυτος CT","reference":{"chapter":19,"verse":2}},{"noteId":1266,"caller":"+","text":"εμπροσθεν ¦ εις το εμπροσθεν CT","reference":{"chapter":19,"verse":4}},{"noteId":1267,"caller":"+","text":"συκομωραιαν ¦ συκομοραιαν PCK ¦ συκομορεαν ANT CT","reference":{"chapter":19,"verse":4}},{"noteId":1268,"caller":"+","text":"εκεινης ¦ δι εκεινης 𝔐pt TR","reference":{"chapter":19,"verse":4}},{"noteId":1269,"caller":"+","text":"εμελλε ¦ ημελλε ANT CT PCK TR","reference":{"chapter":19,"verse":4}},{"noteId":1270,"caller":"+","text":"ειδεν αυτον και ¦ — CT","reference":{"chapter":19,"verse":5}},{"noteId":1271,"caller":"+","text":"παντες ¦ απαντες TR","ref