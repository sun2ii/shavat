{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"LUK","translationId":"grc_tcg","name":"ΚΑΤΑ ΛΟΥΚΑΝ","commonName":"ΚΑΤΑ ΛΟΥΚΑΝ","title":"ΚΑΤΑ ΛΟΥΚΑΝ","order":42,"numberOfChapters":24,"sha256":"b8609ef71fdab51fb2a2ec7abf4402d02f5094e9b75db2d2aa00fac79cfd4207","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/grc_tcg/LUK/24.json","totalNumberOfVerses":1150},"chapter":{"number":2,"content":[{"type":"heading","content":["The Birth of Jesus"]},{"type":"verse","number":1,"content":["Ἐγένετο δὲ ἐν ταῖς ἡμέραις ἐκείναις, ἐξῆλθε δόγμα παρὰ Καίσαρος Αὐγούστου, ἀπογράφεσθαι πᾶσαν τὴν οἰκουμένην."]},{"type":"verse","number":2,"content":["Αὕτη",{"noteId":69},"ἡ ἀπογραφὴ πρώτη ἐγένετο ἡγεμονεύοντος τῆς Συρίας Κυρηνίου."]},{"type":"verse","number":3,"content":["Καὶ ἐπορεύοντο πάντες ἀπογράφεσθαι, ἕκαστος εἰς τὴν",{"noteId":70},"ἰδίαν πόλιν."]},{"type":"verse","number":4,"content":["Ἀνέβη δὲ καὶ Ἰωσὴφ ἀπὸ τῆς Γαλιλαίας, ἐκ πόλεως",{"noteId":71},"Ναζαρέτ, εἰς τὴν Ἰουδαίαν, εἰς πόλιν",{"noteId":72},"Δαυίδ, ἥτις καλεῖται Βηθλέεμ, διὰ τὸ εἶναι αὐτὸν ἐξ οἴκου καὶ πατριᾶς",{"noteId":73},"Δαυίδ,"]},{"type":"verse","number":5,"content":["ἀπογράψασθαι σὺν Μαριὰμ τῇ",{"noteId":74},"μεμνηστευμένῃ αὐτῷ γυναικί, οὔσῃ",{"noteId":75},"ἐγκύῳ."]},{"type":"verse","number":6,"content":["Ἐγένετο δὲ ἐν τῷ εἶναι αὐτοὺς ἐκεῖ, ἐπλήσθησαν αἱ ἡμέραι τοῦ τεκεῖν αὐτήν."]},{"type":"verse","number":7,"content":["Καὶ ἔτεκε τὸν υἱὸν αὐτῆς τὸν πρωτότοκον, καὶ ἐσπαργάνωσεν αὐτόν, καὶ ἀνέκλινεν αὐτὸν ἐν",{"noteId":76},"τῇ φάτνῃ, διότι οὐκ ἦν αὐτοῖς τόπος ἐν τῷ καταλύματι."]},{"type":"heading","content":["Angels Announce Jesus' Birth to Shepherds"]},{"type":"verse","number":8,"content":["Καὶ ποιμένες ἦσαν ἐν τῇ χώρᾳ τῇ αὐτῇ ἀγραυλοῦντες καὶ φυλάσσοντες φυλακὰς τῆς νυκτὸς ἐπὶ τὴν ποίμνην αὐτῶν."]},{"type":"verse","number":9,"content":["Καὶ",{"noteId":77},"ἰδού, ἄγγελος Κυρίου ἐπέστη αὐτοῖς, καὶ δόξα Κυρίου περιέλαμψεν αὐτούς· καὶ ἐφοβήθησαν φόβον μέγαν."]},{"type":"verse","number":10,"content":["Καὶ εἶπεν αὐτοῖς ὁ ἄγγελος, Μὴ φοβεῖσθε· ἰδοὺ γάρ, εὐαγγελίζομαι ὑμῖν χαρὰν μεγάλην, ἥτις ἔσται παντὶ τῷ λαῷ·"]},{"type":"verse","number":11,"content":["ὅτι ἐτέχθη ὑμῖν σήμερον σωτήρ, ὅς ἐστι Χριστὸς Κύριος, ἐν πόλει",{"noteId":78},"Δαυίδ."]},{"type":"verse","number":12,"content":["Καὶ τοῦτο ὑμῖν",{"noteId":79},"τὸ σημεῖον· εὑρήσετε βρέφος ἐσπαργανωμένον,",{"noteId":80},"κείμενον ἐν",{"noteId":81},"φάτνῃ."]},{"type":"verse","number":13,"content":["Καὶ",{"noteId":82},"ἐξαίφνης ἐγένετο σὺν τῷ ἀγγέλῳ πλῆθος στρατιᾶς οὐρανίου, αἰνούντων τὸν Θεόν, καὶ λεγόντων,"]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Δόξα ἐν ὑψίστοις Θεῷ,","poem":1},{"lineBreak":true},{"text":"καὶ ἐπὶ γῆς εἰρήνη·","poem":1},{"lineBreak":true},{"text":"ἐν ἀνθρώποις","poem":1},{"noteId":83},{"text":"εὐδοκία.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":["Καὶ ἐγένετο, ὡς ἀπῆλθον ἀπ᾽ αὐτῶν εἰς τὸν οὐρανὸν οἱ ἄγγελοι,",{"noteId":84},"καὶ οἱ ἄνθρωποι οἱ ποιμένες",{"noteId":85},"εἶπον πρὸς ἀλλήλους, Διέλθωμεν δὴ ἕως Βηθλέεμ, καὶ ἴδωμεν τὸ ῥῆμα τοῦτο τὸ γεγονός, ὃ ὁ Κύριος ἐγνώρισεν ἡμῖν."]},{"type":"verse","number":16,"content":["Καὶ",{"noteId":86},"ἦλθον σπεύσαντες, καὶ",{"noteId":87},"ἀνεῦρον τήν τε Μαριὰμ καὶ τὸν Ἰωσήφ, καὶ τὸ βρέφος κείμενον ἐν τῇ φάτνῃ."]},{"type":"verse","number":17,"content":["Ἰδόντες δὲ",{"noteId":88},"διεγνώρισαν περὶ τοῦ ῥήματος τοῦ λαληθέντος αὐτοῖς περὶ τοῦ παιδίου τούτου."]},{"type":"verse","number":18,"content":["Καὶ πάντες οἱ ἀκούσαντες ἐθαύμασαν περὶ τῶν λαληθέντων ὑπὸ τῶν ποιμένων πρὸς αὐτούς."]},{"type":"verse","number":19,"content":["Ἡ δὲ",{"noteId":89},"Μαριὰμ πάντα συνετήρει τὰ ῥήματα ταῦτα,",{"noteId":90},"συμβάλλουσα ἐν τῇ καρδίᾳ αὐτῆς."]},{"type":"verse","number":20,"content":["Καὶ",{"noteId":91},"ὑπέστρεψαν οἱ ποιμένες, δοξάζοντες καὶ αἰνοῦντες τὸν Θεὸν ἐπὶ πᾶσιν οἷς ἤκουσαν καὶ εἶδον, καθὼς ἐλαλήθη πρὸς αὐτούς."]},{"type":"verse","number":21,"content":["Καὶ ὅτε ἐπλήσθησαν",{"noteId":92},"ἡμέραι ὀκτὼ τοῦ περιτεμεῖν",{"noteId":93},"αὐτόν, καὶ ἐκλήθη τὸ ὄνομα αὐτοῦ Ἰησοῦς, τὸ κληθὲν ὑπὸ τοῦ ἀγγέλου πρὸ τοῦ",{"noteId":94},"συλληφθῆναι αὐτὸν ἐν τῇ κοιλίᾳ."]},{"type":"heading","content":["Jesus Presented at the Temple"]},{"type":"verse","number":22,"content":["Καὶ ὅτε ἐπλήσθησαν αἱ ἡμέραι τοῦ καθαρισμοῦ",{"noteId":95},"αὐτῶν κατὰ τὸν νόμον",{"noteId":96},"Μωσέως, ἀνήγαγον αὐτὸν εἰς Ἱεροσόλυμα, παραστῆσαι τῷ Κυρίῳ—"]},{"type":"verse","number":23,"content":["καθὼς γέγραπται ἐν νόμῳ Κυρίου ὅτι Πᾶν ἄρσεν διανοῖγον μήτραν ἅγιον τῷ Κυρίῳ κληθήσεται—"]},{"type":"verse","number":24,"content":["καὶ τοῦ δοῦναι θυσίαν κατὰ τὸ εἰρημένον ἐν",{"noteId":97},"νόμῳ Κυρίου, Ζεῦγος τρυγόνων ἢ δύο",{"noteId":98},"νεοσσοὺς περιστερῶν."]},{"type":"verse","number":25,"content":["Καὶ ἰδού,",{"noteId":99},"ἦν ἄνθρωπος ἐν",{"noteId":100},"Ἱερουσαλήμ, ᾧ ὄνομα",{"noteId":101},"Συμεών, καὶ ὁ ἄνθρωπος οὗτος δίκαιος καὶ εὐλαβής, προσδεχόμενος παράκλησιν τοῦ Ἰσραήλ, καὶ Πνεῦμα",{"noteId":102},"ἦν Ἅγιον ἐπ᾽ αὐτόν."]},{"type":"verse","number":26,"content":["Καὶ ἦν αὐτῷ κεχρηματισμένον ὑπὸ τοῦ Πνεύματος τοῦ Ἁγίου, μὴ ἰδεῖν θάνατον πρὶν",{"noteId":103},"ἢ ἴδῃ τὸν Χριστὸν Κυρίου."]},{"type":"verse","number":27,"content":["Καὶ ἦλθεν ἐν τῷ πνεύματι εἰς τὸ ἱερόν· καὶ ἐν τῷ εἰσαγαγεῖν τοὺς γονεῖς τὸ παιδίον Ἰησοῦν, τοῦ ποιῆσαι αὐτοὺς κατὰ τὸ εἰθισμένον τοῦ νόμου περὶ αὐτοῦ,"]},{"type":"verse","number":28,"content":["καὶ αὐτὸς ἐδέξατο",{"noteId":104},"αὐτὸ εἰς τὰς ἀγκάλας",{"noteId":105},"αὐτοῦ, καὶ εὐλόγησε τὸν Θεόν, καὶ εἶπε,"]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Νῦν ἀπολύεις τὸν δοῦλόν σου, δέσποτα,","poem":1},{"lineBreak":true},{"text":"κατὰ τὸ ῥῆμά σου, ἐν εἰρήνῃ·","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"ὅτι εἶδον οἱ ὀφθαλμοί μου τὸ σωτήριόν σου,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"ὃ ἡτοίμασας κατὰ πρόσωπον πάντων τῶν λαῶν·","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"φῶς εἰς ἀποκάλυψιν ἐθνῶν,","poem":1},{"lineBreak":true},{"text":"καὶ δόξαν λαοῦ σου Ἰσραήλ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":["Καὶ ἦν",{"noteId":106},"Ἰωσὴφ καὶ ἡ μήτηρ αὐτοῦ θαυμάζοντες ἐπὶ τοῖς λαλουμένοις περὶ αὐτοῦ."]},{"type":"verse","number":34,"content":["Καὶ εὐλόγησεν αὐτοὺς",{"noteId":107},"Συμεών, καὶ εἶπε πρὸς Μαριὰμ τὴν μητέρα αὐτοῦ, Ἰδού, οὗτος κεῖται εἰς πτῶσιν καὶ ἀνάστασιν πολλῶν ἐν τῷ Ἰσραήλ, καὶ εἰς σημεῖον ἀντιλεγόμενον·"]},{"type":"verse","number":35,"content":["καὶ σοῦ",{"noteId":108},"δὲ αὐτῆς τὴν ψυχὴν διελεύσεται ῥομφαία· ὅπως ἂν ἀποκαλυφθῶσιν ἐκ πολλῶν καρδιῶν διαλογισμοί."]},{"type":"verse","number":36,"content":["Καὶ ἦν Ἅννα προφῆτις, θυγάτηρ Φανουήλ, ἐκ φυλῆς Ἀσήρ—αὕτη προβεβηκυῖα ἐν ἡμέραις πολλαῖς, ζήσασα",{"noteId":109},"ἔτη μετὰ ἀνδρὸς ἑπτὰ ἀπὸ τῆς",{"noteId":110},"παρθενίας αὐτῆς,"]},{"type":"verse","number":37,"content":["καὶ",{"noteId":111},"αὕτη χήρα",{"noteId":112},"ὡς ἐτῶν ὀγδοήκοντα τεσσάρων—ἣ οὐκ ἀφίστατο",{"noteId":113},"ἀπὸ τοῦ ἱεροῦ, νηστείαις καὶ δεήσεσι λατρεύουσα νύκτα καὶ ἡμέραν."]},{"type":"verse","number":38,"content":["Καὶ",{"noteId":114},"αὕτη αὐτῇ τῇ ὥρᾳ ἐπιστᾶσα ἀνθωμολογεῖτο τῷ",{"noteId":115},"Κυρίῳ, καὶ ἐλάλει περὶ αὐτοῦ πᾶσι τοῖς προσδεχομένοις λύτρωσιν",{"noteId":116},"ἐν Ἱερουσαλήμ."]},{"type":"heading","content":["The Return to Nazareth"]},{"type":"verse","number":39,"content":["Καὶ ὡς ἐτέλεσαν",{"noteId":117},"ἅπαντα τὰ κατὰ τὸν νόμον Κυρίου,",{"noteId":118},"ὑπέστρεψαν εἰς τὴν Γαλιλαίαν, εἰς",{"noteId":119},"τὴν πόλιν",{"noteId":120},"ἑαυτῶν",{"noteId":121},"Ναζαρέτ."]},{"type":"verse","number":40,"content":["Τὸ δὲ παιδίον ηὔξανε, καὶ ἐκραταιοῦτο",{"noteId":122},"πνεύματι, πληρούμενον",{"noteId":123},"σοφίας· καὶ χάρις Θεοῦ ἦν ἐπ᾽",{"noteId":124},"αὐτό."]},{"type":"heading","content":["The Boy Jesus at the Temple"]},{"type":"verse","number":41,"content":["Καὶ ἐπορεύοντο οἱ γονεῖς αὐτοῦ κατ᾽ ἔτος εἰς Ἱερουσαλὴμ τῇ ἑορτῇ τοῦ Πάσχα."]},{"type":"verse","number":42,"content":["Καὶ ὅτε ἐγένετο ἐτῶν δώδεκα,",{"noteId":125},"ἀναβάντων αὐτῶν",{"noteId":126},"εἰς Ἱεροσόλυμα κατὰ τὸ ἔθος τῆς ἑορτῆς,"]},{"type":"verse","number":43,"content":["καὶ τελειωσάντων τὰς ἡμέρας, ἐν τῷ ὑποστρέφειν αὐτούς, ὑπέμεινεν Ἰησοῦς ὁ παῖς ἐν Ἱερουσαλήμ· καὶ οὐκ",{"noteId":127},"ἔγνω Ἰωσὴφ καὶ ἡ μήτηρ αὐτοῦ·"]},{"type":"verse","number":44,"content":["νομίσαντες δὲ αὐτὸν",{"noteId":128},"ἐν τῇ συνοδίᾳ εἶναι, ἦλθον ἡμέρας ὁδόν, καὶ ἀνεζήτουν αὐτὸν ἐν τοῖς",{"noteId":129},"συγγενέσι καὶ",{"noteId":130},"ἐν τοῖς γνωστοῖς·"]},{"type":"verse","number":45,"content":["καὶ μὴ εὑρόντες",{"noteId":131},"αὐτόν, ὑπέστρεψαν εἰς Ἱερουσαλήμ,",{"noteId":132},"ζητοῦντες αὐτόν."]},{"type":"verse","number":46,"content":["Καὶ ἐγένετο,",{"noteId":133},"μεθ᾽ ἡμέρας τρεῖς εὗρον αὐτὸν ἐν τῷ ἱερῷ, καθεζόμενον ἐν μέσῳ τῶν διδασκάλων, καὶ ἀκούοντα αὐτῶν, καὶ ἐπερωτῶντα αὐτούς."]},{"type":"verse","number":47,"content":["Ἐξίσταντο δὲ πάντες οἱ ἀκούοντες αὐτοῦ ἐπὶ τῇ συνέσει καὶ ταῖς ἀποκρίσεσιν αὐτοῦ."]},{"type":"verse","number":48,"content":["Καὶ ἰδόντες αὐτὸν ἐξεπλάγησαν· καὶ",{"noteId":134},"πρὸς αὐτὸν ἡ μήτηρ αὐτοῦ εἶπε, Τέκνον, τί ἐποίησας ἡμῖν οὕτως; Ἰδού, ὁ πατήρ σου",{"noteId":135},"κἀγὼ ὀδυνώμενοι",{"noteId":136},"ἐζητοῦμέν σε."]},{"type":"verse","number":49,"content":["Καὶ εἶπε πρὸς αὐτούς,",{"text":"Τί ὅτι ἐζητεῖτέ με; Οὐκ ᾔδειτε ὅτι ἐν τοῖς τοῦ πατρός μου δεῖ εἶναί με;","wordsOfJesus":true}]},{"type":"verse","number":50,"content":["Καὶ αὐτοὶ οὐ συνῆκαν τὸ ῥῆμα ὃ ἐλάλησεν αὐτοῖς."]},{"type":"verse","number":51,"content":["Καὶ κατέβη μετ᾽ αὐτῶν, καὶ ἦλθεν εἰς",{"noteId":137},"Ναζαρέτ· καὶ ἦν ὑποτασσόμενος αὐτοῖς. Καὶ ἡ μήτηρ αὐτοῦ διετήρει πάντα τὰ ῥήματα",{"noteId":138},"ταῦτα ἐν τῇ καρδίᾳ αὐτῆς."]},{"type":"verse","number":52,"content":["Καὶ Ἰησοῦς προέκοπτε",{"noteId":139},"σοφίᾳ καὶ ἡλικίᾳ, καὶ χάριτι παρὰ Θεῷ καὶ ἀνθρώποις."]}],"footnotes":[{"noteId":69,"caller":"+","text":"η ¦ — CT","reference":{"chapter":2,"verse":2}},{"noteId":70,"caller":"+","text":"ιδιαν ¦ εαυτου CT","reference":{"chapter":2,"verse":3}},{"noteId":71,"caller":"+","text":"ναζαρετ ¦ ναζαρεθ NA SBL SCR","reference":{"chapter":2,"verse":4}},{"noteId":72,"caller":"+","text":"δαυιδ ¦ δαβιδ HF TR ¦ δαυειδ TH WH","reference":{"chapter":2,"verse":4}},{"noteId":73,"caller":"+","text":"δαυιδ ¦ δαβιδ HF TR ¦ δαυειδ TH WH","reference":{"chapter":2,"verse":4}},{"noteId":74,"caller":"+","text":"μεμνηστευμενη αυτω γυναικι ¦ εμνηστευμενη αυτω CT","reference":{"chapter":2,"verse":5}},{"noteId":75,"caller":"+","text":"εγκυω ¦ ενκυω TH WH","reference":{"chapter":2,"verse":5}},{"noteId":76,"caller":"+","text":"τη ¦ — CT","reference":{"chapter":2,"verse":7}},{"noteId":77,"caller":"+","text":"ιδου ¦ — CT","reference":{"chapter":2,"verse":9}},{"noteId":78,"caller":"+","text":"δαυιδ ¦ δαβιδ HF TR ¦ δαυειδ TH WH","reference":{"chapter":2,"verse":11}},{"noteId":79,"caller":"+","text":"το ¦ — WH","reference":{"chapter":2,"verse":12}},{"noteId":80,"caller":"+","text":"κειμενον ¦ και κειμενον CT","reference":{"chapter":2,"verse":12}},{"noteId":81,"caller":"+","text":"φατνη ¦ τη φατνη TR","reference":{"chapter":2,"verse":12}},{"noteId":82,"caller":"+","text":"εξαιφνης ¦ εξεφνης WH","reference":{"chapter":2,"verse":13}},{"noteId":83,"caller":"+","text":"ευδοκια 98.8% ¦ ευδοκιας CT 0.4%","reference":{"chapter":2,"verse":14}},{"noteId":84,"caller":"+","text":"και οι ανθρωποι 97% ¦ — CT