{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"LUK","translationId":"grc_tcg","name":"ΚΑΤΑ ΛΟΥΚΑΝ","commonName":"ΚΑΤΑ ΛΟΥΚΑΝ","title":"ΚΑΤΑ ΛΟΥΚΑΝ","order":42,"numberOfChapters":24,"sha256":"b8609ef71fdab51fb2a2ec7abf4402d02f5094e9b75db2d2aa00fac79cfd4207","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/grc_tcg/LUK/24.json","totalNumberOfVerses":1150},"chapter":{"number":20,"content":[{"type":"heading","content":["The Authority of Jesus Questioned"]},{"type":"verse","number":1,"content":["Καὶ ἐγένετο ἐν μιᾷ τῶν ἡμερῶν",{"noteId":1332},"ἐκείνων, διδάσκοντος αὐτοῦ τὸν λαὸν ἐν τῷ ἱερῷ καὶ εὐαγγελιζομένου, ἐπέστησαν οἱ",{"noteId":1333},"ἱερεῖς καὶ οἱ γραμματεῖς σὺν τοῖς πρεσβυτέροις,"]},{"type":"verse","number":2,"content":["καὶ",{"noteId":1334},"εἶπον πρὸς αὐτόν, λέγοντες, Εἰπὲ ἡμῖν, ἐν ποίᾳ ἐξουσίᾳ ταῦτα ποιεῖς, ἢ τίς ἐστιν ὁ δούς σοι τὴν ἐξουσίαν ταύτην;"]},{"type":"verse","number":3,"content":["Ἀποκριθεὶς δὲ εἶπε πρὸς αὐτούς,",{"text":"Ἐρωτήσω ὑμᾶς κἀγὼ","wordsOfJesus":true},{"noteId":1335},{"text":"ἕνα λόγον, καὶ εἴπατέ μοι·","wordsOfJesus":true}]},{"type":"verse","number":4,"content":[{"text":"Τὸ βάπτισμα","wordsOfJesus":true},{"noteId":1336},{"text":"Ἰωάννου ἐξ οὐρανοῦ ἦν, ἢ ἐξ ἀνθρώπων;","wordsOfJesus":true}]},{"type":"verse","number":5,"content":["Οἱ δὲ συνελογίσαντο πρὸς ἑαυτούς, λέγοντες ὅτι Ἐὰν εἴπωμεν, Ἐξ οὐρανοῦ, ἐρεῖ, Διὰ",{"noteId":1337},"τί οὐκ ἐπιστεύσατε αὐτῷ;"]},{"type":"verse","number":6,"content":["Ἐὰν δὲ εἴπωμεν, Ἐξ ἀνθρώπων,",{"noteId":1338},"πᾶς ὁ λαὸς καταλιθάσει ἡμᾶς· πεπεισμένος γάρ ἐστιν",{"noteId":1339},"Ἰωάννην προφήτην εἶναι."]},{"type":"verse","number":7,"content":["Καὶ ἀπεκρίθησαν μὴ εἰδέναι πόθεν."]},{"type":"verse","number":8,"content":["Καὶ ὁ Ἰησοῦς εἶπεν αὐτοῖς,",{"text":"Οὐδὲ ἐγὼ λέγω ὑμῖν ἐν ποίᾳ ἐξουσίᾳ ταῦτα ποιῶ.","wordsOfJesus":true}]},{"type":"heading","content":["The Parable of the Vineyard Owner"]},{"type":"verse","number":9,"content":["Ἤρξατο δὲ πρὸς τὸν λαὸν λέγειν τὴν παραβολὴν ταύτην·",{"noteId":1340},{"text":"Ἄνθρωπος ἐφύτευσεν ἀμπελῶνα, καὶ","wordsOfJesus":true},{"noteId":1341},{"text":"ἐξέδοτο αὐτὸν γεωργοῖς, καὶ ἀπεδήμησε χρόνους ἱκανούς·","wordsOfJesus":true}]},{"type":"verse","number":10,"content":[{"text":"καὶ","wordsOfJesus":true},{"noteId":1342},{"text":"ἐν καιρῷ ἀπέστειλε πρὸς τοὺς γεωργοὺς δοῦλον, ἵνα ἀπὸ τοῦ καρποῦ τοῦ ἀμπελῶνος","wordsOfJesus":true},{"noteId":1343},{"text":"δῶσιν αὐτῷ. Οἱ δὲ γεωργοὶ","wordsOfJesus":true},{"noteId":1344},{"text":"δείραντες αὐτὸν ἐξαπέστειλαν κενόν.","wordsOfJesus":true}]},{"type":"verse","number":11,"content":[{"text":"Καὶ προσέθετο","wordsOfJesus":true},{"noteId":1345},{"text":"πέμψαι ἕτερον δοῦλον· οἱ δὲ κἀκεῖνον","wordsOfJesus":true},{"noteId":1346},{"text":"δείραντες καὶ ἀτιμάσαντες ἐξαπέστειλαν κενόν.","wordsOfJesus":true}]},{"type":"verse","number":12,"content":[{"text":"Καὶ προσέθετο","wordsOfJesus":true},{"noteId":1347},{"text":"πέμψαι τρίτον· οἱ δὲ καὶ τοῦτον τραυματίσαντες ἐξέβαλον.","wordsOfJesus":true}]},{"type":"verse","number":13,"content":[{"text":"Εἶπε δὲ ὁ κύριος τοῦ ἀμπελῶνος, Τί ποιήσω; Πέμψω τὸν υἱόν μου τὸν ἀγαπητόν· ἴσως τοῦτον","wordsOfJesus":true},{"noteId":1348},{"text":"ἰδόντες ἐντραπήσονται.","wordsOfJesus":true}]},{"type":"verse","number":14,"content":[{"text":"Ἰδόντες δὲ αὐτὸν οἱ γεωργοὶ διελογίζοντο πρὸς","wordsOfJesus":true},{"noteId":1349},{"text":"ἑαυτούς, λέγοντες, Οὗτός ἐστιν ὁ κληρονόμος·","wordsOfJesus":true},{"noteId":1350},{"text":"δεῦτε, ἀποκτείνωμεν αὐτόν, ἵνα ἡμῶν γένηται ἡ κληρονομία.","wordsOfJesus":true}]},{"type":"verse","number":15,"content":[{"text":"Καὶ ἐκβαλόντες","wordsOfJesus":true},{"noteId":1351},{"text":"αὐτὸν ἔξω τοῦ ἀμπελῶνος, ἀπέκτειναν. Τί οὖν ποιήσει αὐτοῖς ὁ κύριος τοῦ ἀμπελῶνος;","wordsOfJesus":true}]},{"type":"verse","number":16,"content":[{"text":"Ἐλεύσεται καὶ ἀπολέσει τοὺς γεωργοὺς τούτους, καὶ δώσει τὸν ἀμπελῶνα ἄλλοις.","wordsOfJesus":true},"Ἀκούσαντες δὲ",{"noteId":1352},"εἶπον, Μὴ γένοιτο."]},{"type":"verse","number":17,"content":["Ὁ δὲ ἐμβλέψας αὐτοῖς εἶπε,",{"text":"Τί οὖν ἐστι τὸ γεγραμμένον τοῦτο,","wordsOfJesus":true},{"lineBreak":true},{"text":"Λίθον ὃν ἀπεδοκίμασαν οἱ οἰκοδομοῦντες,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"οὗτος ἐγενήθη εἰς κεφαλὴν γωνίας;","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Πᾶς ὁ πεσὼν ἐπ᾽ ἐκεῖνον τὸν λίθον συνθλασθήσεται· ἐφ᾽ ὃν δ᾽ ἂν πέσῃ, λικμήσει αὐτόν.","wordsOfJesus":true}]},{"type":"verse","number":19,"content":["Καὶ ἐζήτησαν οἱ",{"noteId":1353},"ἀρχιερεῖς καὶ οἱ γραμματεῖς ἐπιβαλεῖν ἐπ᾽ αὐτὸν τὰς χεῖρας ἐν αὐτῇ τῇ ὥρᾳ, καὶ",{"noteId":1354},"ἐφοβήθησαν· ἔγνωσαν γὰρ ὅτι πρὸς αὐτοὺς",{"noteId":1355},"τὴν παραβολὴν ταύτην εἶπε."]},{"type":"heading","content":["The Question About Paying Taxes to Caesar"]},{"type":"verse","number":20,"content":["Καὶ παρατηρήσαντες ἀπέστειλαν",{"noteId":1356},"ἐγκαθέτους, ὑποκρινομένους ἑαυτοὺς δικαίους εἶναι, ἵνα ἐπιλάβωνται αὐτοῦ λόγου,",{"noteId":1357},"εἰς τὸ παραδοῦναι αὐτὸν τῇ ἀρχῇ καὶ τῇ ἐξουσίᾳ τοῦ ἡγεμόνος."]},{"type":"verse","number":21,"content":["Καὶ ἐπηρώτησαν αὐτόν, λέγοντες, Διδάσκαλε, οἴδαμεν ὅτι ὀρθῶς λέγεις καὶ διδάσκεις· καὶ οὐ λαμβάνεις πρόσωπον, ἀλλ᾽ ἐπ᾽ ἀληθείας τὴν ὁδὸν τοῦ Θεοῦ διδάσκεις."]},{"type":"verse","number":22,"content":["Ἔξεστιν",{"noteId":1358},"ἡμῖν Καίσαρι φόρον δοῦναι, ἢ οὔ;"]},{"type":"verse","number":23,"content":["Κατανοήσας δὲ αὐτῶν τὴν πανουργίαν, εἶπε πρὸς αὐτούς,",{"noteId":1359},{"text":"Τί με πειράζετε;","wordsOfJesus":true}]},{"type":"verse","number":24,"content":[{"noteId":1360},{"text":"Ἐπιδείξατέ μοι δηνάριον· τίνος ἔχει εἰκόνα καὶ ἐπιγραφήν;","wordsOfJesus":true},{"noteId":1361},"Ἀποκριθέντες δὲ",{"noteId":1362},"εἶπον, Καίσαρος."]},{"type":"verse","number":25,"content":["Ὁ δὲ εἶπεν",{"noteId":1363},"αὐτοῖς,",{"noteId":1364},{"text":"Ἀπόδοτε τοίνυν τὰ Καίσαρος Καίσαρι, καὶ τὰ τοῦ Θεοῦ τῷ Θεῷ.","wordsOfJesus":true}]},{"type":"verse","number":26,"content":["Καὶ οὐκ ἴσχυσαν ἐπιλαβέσθαι",{"noteId":1365},"αὐτοῦ ῥήματος ἐναντίον τοῦ λαοῦ· καὶ θαυμάσαντες ἐπὶ τῇ ἀποκρίσει αὐτοῦ, ἐσίγησαν."]},{"type":"heading","content":["The Sadducees Ask About the Resurrection"]},{"type":"verse","number":27,"content":["Προσελθόντες δέ τινες τῶν Σαδδουκαίων, οἱ",{"noteId":1366},"ἀντιλέγοντες",{"noteId":1367},"ἀνάστασιν μὴ εἶναι, ἐπηρώτησαν αὐτόν,"]},{"type":"verse","number":28,"content":["λέγοντες, Διδάσκαλε,",{"noteId":1368},"Μωσῆς ἔγραψεν ἡμῖν, Ἐάν τινος ἀδελφὸς ἀποθάνῃ ἔχων γυναῖκα, καὶ οὗτος ἄτεκνος",{"noteId":1369},"ἀποθάνῃ, ἵνα",{"noteId":1370},"λάβῃ ὁ ἀδελφὸς αὐτοῦ τὴν γυναῖκα, καὶ ἐξαναστήσῃ σπέρμα τῷ ἀδελφῷ αὐτοῦ."]},{"type":"verse","number":29,"content":["Ἑπτὰ οὖν ἀδελφοὶ ἦσαν· καὶ ὁ πρῶτος λαβὼν γυναῖκα, ἀπέθανεν ἄτεκνος·"]},{"type":"verse","number":30,"content":["καὶ",{"noteId":1371},"ἔλαβεν ὁ δεύτερος τὴν γυναῖκα, καὶ οὗτος ἀπέθανεν ἄτεκνος."]},{"type":"verse","number":31,"content":["Καὶ ὁ τρίτος ἔλαβεν αὐτὴν",{"noteId":1372},"ὡσαύτως. Ὡσαύτως δὲ καὶ οἱ ἑπτά·",{"noteId":1373},"οὐ κατέλιπον τέκνα, καὶ ἀπέθανον."]},{"type":"verse","number":32,"content":["Ὕστερον",{"noteId":1374},"δὲ πάντων ἀπέθανε καὶ ἡ γυνή."]},{"type":"verse","number":33,"content":[{"noteId":1375},"Ἐν τῇ οὖν ἀναστάσει, τίνος αὐτῶν",{"noteId":1376},"γίνεται γυνή; Οἱ γὰρ ἑπτὰ ἔσχον αὐτὴν γυναῖκα."]},{"type":"verse","number":34,"content":["Καὶ",{"noteId":1377},"ἀποκριθεὶς εἶπεν αὐτοῖς ὁ Ἰησοῦς,",{"text":"Οἱ υἱοὶ τοῦ αἰῶνος τούτου γαμοῦσι καὶ","wordsOfJesus":true},{"noteId":1378},{"text":"ἐκγαμίσκονται·","wordsOfJesus":true}]},{"type":"verse","number":35,"content":[{"text":"οἱ δὲ καταξιωθέντες τοῦ αἰῶνος ἐκείνου τυχεῖν καὶ τῆς ἀναστάσεως τῆς ἐκ νεκρῶν οὔτε γαμοῦσιν οὔτε","wordsOfJesus":true},{"noteId":1379},{"text":"ἐκγαμίζονται·","wordsOfJesus":true}]},{"type":"verse","number":36,"content":[{"noteId":1380},{"text":"οὔτε γὰρ ἀποθανεῖν ἔτι δύνανται· ἰσάγγελοι γάρ εἰσι, καὶ υἱοί εἰσι","wordsOfJesus":true},{"noteId":1381},{"text":"τοῦ Θεοῦ, τῆς ἀναστάσεως υἱοὶ ὄντες.","wordsOfJesus":true}]},{"type":"verse","number":37,"content":[{"text":"Ὅτι δὲ ἐγείρονται οἱ νεκροί, καὶ","wordsOfJesus":true},{"noteId":1382},{"text":"Μωσῆς ἐμήνυσεν ἐπὶ τῆς βάτου, ὡς λέγει, Κύριον τὸν Θεὸν Ἀβραὰμ καὶ","wordsOfJesus":true},{"noteId":1383},{"text":"τὸν Θεὸν Ἰσαὰκ καὶ","wordsOfJesus":true},{"noteId":1384},{"text":"τὸν Θεὸν Ἰακώβ.","wordsOfJesus":true}]},{"type":"verse","number":38,"content":[{"text":"Θεὸς δὲ οὐκ ἔστι νεκρῶν, ἀλλὰ ζώντων· πάντες γὰρ αὐτῷ ζῶσιν.","wordsOfJesus":true}]},{"type":"verse","number":39,"content":["Ἀποκριθέντες δέ τινες τῶν γραμματέων",{"noteId":1385},"εἶπον, Διδάσκαλε, καλῶς εἶπας."]},{"type":"verse","number":40,"content":["Οὐκέτι",{"noteId":1386},"δὲ ἐτόλμων ἐπερωτᾷν αὐτὸν οὐδέν."]},{"type":"heading","content":["Whose Son Is the Christ?"]},{"type":"verse","number":41,"content":["Εἶπε δὲ πρὸς αὐτούς,",{"text":"Πῶς λέγουσι τὸν Χριστὸν","wordsOfJesus":true},{"noteId":1387},{"text":"υἱὸν Δαυὶδ εἶναι;","wordsOfJesus":true}]},{"type":"verse","number":42,"content":[{"noteId":1388},{"text":"Καὶ αὐτὸς","wordsOfJesus":true},{"noteId":1389},{"text":"Δαυὶδ λέγει ἐν βίβλῳ","wordsOfJesus":true},{"noteId":1390},{"text":"ψαλμῶν,","wordsOfJesus":true},{"lineBreak":true},{"text":"Εἶπεν","wordsOfJesus":true,"poem":1},{"noteId":1391},{"text":"ὁ Κύριος τῷ Κυρίῳ μου,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Κάθου ἐκ δεξιῶν μου,","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"ἕως ἂν θῶ τοὺς ἐχθρούς σου ὑποπόδιον τῶν ποδῶν σου.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"noteId":1392},{"text":"Δαυὶδ οὖν","wordsOfJesus":true},{"noteId":1393},{"text":"Κύριον αὐτὸν καλεῖ, καὶ πῶς","wordsOfJesus":true},{"noteId":1394},{"text":"υἱὸς αὐτοῦ ἐστιν;","wordsOfJesus":true}]},{"type":"heading","content":["Beware of the Scribes"]},{"type":"verse","number":45,"content":["Ἀκούοντος δὲ παντὸς τοῦ λαοῦ, εἶπε τοῖς μαθηταῖς",{"noteId":1395},"αὐτοῦ,"]},{"type":"verse","number":46,"content":[{"text":"Προσέχετε ἀπὸ τῶν γραμματέων τῶν θελόντων περιπατεῖν ἐν στολαῖς, καὶ φιλούντων ἀσπασμοὺς ἐν ταῖς ἀγοραῖς, καὶ πρωτοκαθεδρίας ἐν ταῖς συναγωγαῖς, καὶ πρωτοκλισίας ἐν τοῖς δείπνοις·","wordsOfJesus":true}]},{"type":"verse","number":47,"content":[{"text":"οἳ κατεσθίουσι τὰς οἰκίας τῶν χηρῶν, καὶ προφάσει μακρὰ προσεύχονται. Οὗτοι","wordsOfJesus":true},{"noteId":1396},{"text":"λήψονται περισσότερον κρίμα.","wordsOfJesus":true}]}],"footnotes":[{"noteId":1332,"caller":"+","text":"εκεινων ¦ — CT","reference":{"chapter":20,"verse":1}},{"noteId":1333,"caller":"+","text":"ιερεις ¦ αρχιερεις CT TR","reference":{"chapter":20,"verse":1}},{"noteId":1334,"caller":"+","text":"ειπον προς αυτον λεγοντες ειπε ¦ ειπαν λεγοντες προς αυτον ειπον CT","reference":{"chapter":20,"verse":2}},{"noteId":1335,"caller":"+","text":"ενα ¦ — CT","reference":{"chapter":20,"verse":3}},{"noteId":1336,"caller":"+","text":"ιωαννου ¦ ιωανου WH","reference":{"chapter":20,"verse":4}},{"noteId":1337,"caller":"+","text":"τι ¦ τι ουν ANT TR","reference":{"chapter":20,"verse":5}},{"noteId":1338,"caller":"+","text":"πας ο λαος ¦ ο λαος απας CT","reference":{"chapter":20,"verse":6}},{"noteId":1339,"caller":"+","text":"ιωαννην ¦ ιωανην WH","reference":{"chapter":20,"verse":6}},{"noteId":1340,"caller":"+","text":"ανθρωπος ¦ ανθρωπος τις ANT NA TR","reference":{"chapter":20,"verse":9}},{"noteId":1341,"caller":"+"