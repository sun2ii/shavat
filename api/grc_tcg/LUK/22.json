{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"LUK","translationId":"grc_tcg","name":"ΚΑΤΑ ΛΟΥΚΑΝ","commonName":"ΚΑΤΑ ΛΟΥΚΑΝ","title":"ΚΑΤΑ ΛΟΥΚΑΝ","order":42,"numberOfChapters":24,"sha256":"b8609ef71fdab51fb2a2ec7abf4402d02f5094e9b75db2d2aa00fac79cfd4207","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/grc_tcg/LUK/24.json","totalNumberOfVerses":1150},"chapter":{"number":22,"content":[{"type":"heading","content":["The Plot to Kill Jesus"]},{"type":"verse","number":1,"content":["Ἤγγιζε δὲ ἡ ἑορτὴ τῶν ἀζύμων, ἡ λεγομένη Πάσχα."]},{"type":"verse","number":2,"content":["Καὶ ἐζήτουν οἱ ἀρχιερεῖς καὶ οἱ γραμματεῖς τὸ πῶς ἀνέλωσιν αὐτόν· ἐφοβοῦντο γὰρ τὸν λαόν."]},{"type":"verse","number":3,"content":["Εἰσῆλθε δὲ",{"noteId":1449},"Σατανᾶς εἰς Ἰούδαν τὸν",{"noteId":1450},"ἐπικαλούμενον Ἰσκαριώτην, ὄντα ἐκ τοῦ ἀριθμοῦ τῶν δώδεκα."]},{"type":"verse","number":4,"content":["Καὶ ἀπελθὼν συνελάλησε τοῖς ἀρχιερεῦσι καὶ",{"noteId":1451},"στρατηγοῖς τὸ πῶς",{"noteId":1452},"αὐτὸν παραδῷ αὐτοῖς."]},{"type":"verse","number":5,"content":["Καὶ ἐχάρησαν, καὶ συνέθεντο αὐτῷ",{"noteId":1453},"ἀργύριον δοῦναι."]},{"type":"verse","number":6,"content":["Καὶ ἐξωμολόγησε καὶ ἐζήτει εὐκαιρίαν τοῦ παραδοῦναι αὐτὸν",{"noteId":1454},"αὐτοῖς ἄτερ ὄχλου."]},{"type":"heading","content":["The Preparation of the Passover"]},{"type":"verse","number":7,"content":["Ἦλθε δὲ ἡ ἡμέρα τῶν ἀζύμων,",{"noteId":1455},"ἐν ᾗ ἔδει θύεσθαι τὸ Πάσχα."]},{"type":"verse","number":8,"content":["Καὶ ἀπέστειλε Πέτρον καὶ",{"noteId":1456},"Ἰωάννην, εἰπών,",{"text":"Πορευθέντες ἑτοιμάσατε ἡμῖν τὸ Πάσχα, ἵνα φάγωμεν.","wordsOfJesus":true}]},{"type":"verse","number":9,"content":["Οἱ δὲ",{"noteId":1457},"εἶπον αὐτῷ, Ποῦ θέλεις",{"noteId":1458},"ἑτοιμάσομεν;"]},{"type":"verse","number":10,"content":["Ὁ δὲ εἶπεν αὐτοῖς,",{"text":"Ἰδού, εἰσελθόντων ὑμῶν εἰς τὴν πόλιν, συναντήσει ὑμῖν ἄνθρωπος κεράμιον ὕδατος βαστάζων· ἀκολουθήσατε αὐτῷ εἰς τὴν οἰκίαν","wordsOfJesus":true},{"noteId":1459},{"text":"οὗ εἰσπορεύεται.","wordsOfJesus":true}]},{"type":"verse","number":11,"content":[{"text":"Καὶ ἐρεῖτε τῷ οἰκοδεσπότῃ τῆς οἰκίας, Λέγει σοι ὁ διδάσκαλος, Ποῦ ἐστι τὸ κατάλυμα, ὅπου τὸ Πάσχα μετὰ τῶν μαθητῶν μου φάγω;","wordsOfJesus":true}]},{"type":"verse","number":12,"content":[{"text":"Κἀκεῖνος ὑμῖν δείξει","wordsOfJesus":true},{"noteId":1460},{"text":"ἀνώγεον μέγα ἐστρωμένον· ἐκεῖ ἑτοιμάσατε.","wordsOfJesus":true}]},{"type":"verse","number":13,"content":["Ἀπελθόντες δὲ εὗρον καθὼς",{"noteId":1461},"εἴρηκεν αὐτοῖς, καὶ ἡτοίμασαν τὸ Πάσχα."]},{"type":"heading","content":["The Institution of the Lord's Supper"]},{"type":"verse","number":14,"content":["Καὶ ὅτε ἐγένετο ἡ ὥρα, ἀνέπεσε, καὶ οἱ",{"noteId":1462},"δώδεκα ἀπόστολοι σὺν αὐτῷ."]},{"type":"verse","number":15,"content":["Καὶ εἶπε πρὸς αὐτούς,",{"text":"Ἐπιθυμίᾳ ἐπεθύμησα τοῦτο τὸ Πάσχα φαγεῖν μεθ᾽ ὑμῶν πρὸ τοῦ με παθεῖν·","wordsOfJesus":true}]},{"type":"verse","number":16,"content":[{"text":"λέγω γὰρ ὑμῖν ὅτι","wordsOfJesus":true},{"noteId":1463},{"text":"οὐκέτι οὐ μὴ φάγω","wordsOfJesus":true},{"noteId":1464},{"text":"ἐξ αὐτοῦ, ἕως ὅτου πληρωθῇ ἐν τῇ βασιλείᾳ τοῦ Θεοῦ.","wordsOfJesus":true}]},{"type":"verse","number":17,"content":["Καὶ δεξάμενος",{"noteId":1465},"ποτήριον, εὐχαριστήσας εἶπε,",{"text":"Λάβετε τοῦτο, καὶ διαμερίσατε","wordsOfJesus":true},{"noteId":1466},{"text":"ἑαυτοῖς·","wordsOfJesus":true}]},{"type":"verse","number":18,"content":[{"text":"λέγω γὰρ ὑμῖν","wordsOfJesus":true},{"noteId":1467},{"text":"ὅτι οὐ μὴ πίω ἀπὸ","wordsOfJesus":true},{"noteId":1468},{"text":"τοῦ","wordsOfJesus":true},{"noteId":1469},{"text":"γενήματος τῆς ἀμπέλου, ἕως","wordsOfJesus":true},{"noteId":1470},{"text":"ὅτου ἡ βασιλεία τοῦ Θεοῦ ἔλθῃ.","wordsOfJesus":true}]},{"type":"verse","number":19,"content":["Καὶ λαβὼν ἄρτον, εὐχαριστήσας ἔκλασε καὶ ἔδωκεν αὐτοῖς, λέγων,",{"text":"Τοῦτό ἐστι τὸ σῶμά μου τὸ ὑπὲρ ὑμῶν διδόμενον· τοῦτο ποιεῖτε εἰς τὴν ἐμὴν ἀνάμνησιν.","wordsOfJesus":true}]},{"type":"verse","number":20,"content":[{"noteId":1471},"Ὡσαύτως καὶ τὸ ποτήριον μετὰ τὸ δειπνῆσαι, λέγων,",{"text":"Τοῦτο τὸ ποτήριον ἡ καινὴ διαθήκη ἐν τῷ αἵματί μου, τὸ ὑπὲρ ὑμῶν","wordsOfJesus":true},{"noteId":1472},{"text":"ἐκχυνόμενον.","wordsOfJesus":true}]},{"type":"verse","number":21,"content":[{"text":"Πλὴν ἰδού, ἡ χεὶρ τοῦ παραδιδόντος με μετ᾽ ἐμοῦ ἐπὶ τῆς τραπέζης.","wordsOfJesus":true}]},{"type":"verse","number":22,"content":[{"noteId":1473},{"text":"Καὶ ὁ μὲν υἱὸς τοῦ ἀνθρώπου","wordsOfJesus":true},{"noteId":1474},{"text":"πορεύεται κατὰ τὸ ὡρισμένον· πλὴν οὐαὶ τῷ ἀνθρώπῳ ἐκείνῳ δι᾽ οὗ παραδίδοται.","wordsOfJesus":true}]},{"type":"verse","number":23,"content":["Καὶ αὐτοὶ ἤρξαντο",{"noteId":1475},"συζητεῖν πρὸς ἑαυτοὺς τὸ τίς ἄρα εἴη ἐξ αὐτῶν ὁ τοῦτο μέλλων πράσσειν."]},{"type":"heading","content":["The Dispute About Greatness"]},{"type":"verse","number":24,"content":["Ἐγένετο δὲ καὶ",{"noteId":1476},"φιλονεικία ἐν αὐτοῖς τὸ τίς αὐτῶν δοκεῖ εἶναι μείζων."]},{"type":"verse","number":25,"content":["Ὁ δὲ εἶπεν αὐτοῖς,",{"text":"Οἱ βασιλεῖς τῶν ἐθνῶν κυριεύουσιν αὐτῶν, καὶ οἱ ἐξουσιάζοντες αὐτῶν εὐεργέται καλοῦνται.","wordsOfJesus":true}]},{"type":"verse","number":26,"content":[{"text":"Ὑμεῖς δὲ οὐχ οὕτως· ἀλλ᾽ ὁ μείζων ἐν ὑμῖν","wordsOfJesus":true},{"noteId":1477},{"text":"γενέσθω ὡς ὁ νεώτερος· καὶ ὁ ἡγούμενος ὡς ὁ διακονῶν.","wordsOfJesus":true}]},{"type":"verse","number":27,"content":[{"text":"Τίς γὰρ μείζων, ὁ ἀνακείμενος ἢ ὁ διακονῶν;","wordsOfJesus":true},{"noteId":1478},{"text":"Οὐχὶ ὁ ἀνακείμενος; Ἐγὼ δέ","wordsOfJesus":true},{"noteId":1479},{"text":"εἰμι ἐν μέσῳ ὑμῶν ὡς ὁ διακονῶν.","wordsOfJesus":true}]},{"type":"verse","number":28,"content":[{"text":"Ὑμεῖς δέ ἐστε οἱ διαμεμενηκότες μετ᾽ ἐμοῦ ἐν τοῖς πειρασμοῖς μου·","wordsOfJesus":true}]},{"type":"verse","number":29,"content":[{"text":"κἀγὼ διατίθεμαι ὑμῖν, καθὼς διέθετό μοι ὁ πατήρ μου, βασιλείαν,","wordsOfJesus":true}]},{"type":"verse","number":30,"content":[{"text":"ἵνα","wordsOfJesus":true},{"noteId":1480},{"text":"ἐσθίητε καὶ πίνητε ἐπὶ τῆς τραπέζης","wordsOfJesus":true},{"noteId":1481},{"text":"μου καὶ","wordsOfJesus":true},{"noteId":1482},{"text":"καθίσεσθε ἐπὶ θρόνων,","wordsOfJesus":true},{"noteId":1483},{"text":"κρίνοντες τὰς δώδεκα φυλὰς τοῦ Ἰσραήλ.","wordsOfJesus":true}]},{"type":"heading","content":["Jesus Predicts Peter's Denial"]},{"type":"verse","number":31,"content":[{"noteId":1484},"Εἶπε δὲ ὁ Κύριος,",{"text":"Σίμων, Σίμων, ἰδού, ὁ Σατανᾶς ἐξῃτήσατο ὑμᾶς, τοῦ","wordsOfJesus":true},{"noteId":1485},{"text":"σινιάσαι ὡς τὸν σῖτον·","wordsOfJesus":true}]},{"type":"verse","number":32,"content":[{"text":"ἐγὼ δὲ ἐδεήθην περὶ σοῦ, ἵνα μὴ","wordsOfJesus":true},{"noteId":1486},{"text":"ἐκλίπῃ ἡ πίστις σου· καὶ σύ ποτε ἐπιστρέψας","wordsOfJesus":true},{"noteId":1487},{"text":"στήριξον τοὺς ἀδελφούς σου.","wordsOfJesus":true}]},{"type":"verse","number":33,"content":["Ὁ δὲ εἶπεν αὐτῷ, Κύριε, μετὰ σοῦ ἕτοιμός εἰμι καὶ εἰς φυλακὴν καὶ εἰς θάνατον πορεύεσθαι."]},{"type":"verse","number":34,"content":["Ὁ δὲ εἶπε,",{"text":"Λέγω σοι, Πέτρε, οὐ","wordsOfJesus":true},{"noteId":1488},{"text":"μὴ φωνήσῃ σήμερον ἀλέκτωρ,","wordsOfJesus":true},{"noteId":1489},{"text":"πρὶν ἢ τρὶς","wordsOfJesus":true},{"noteId":1490},{"text":"ἀπαρνήσῃ μὴ εἰδέναι με.","wordsOfJesus":true}]},{"type":"heading","content":["Moneybag, Knapsack, and Sword"]},{"type":"verse","number":35,"content":["Καὶ εἶπεν αὐτοῖς,",{"text":"Ὅτε ἀπέστειλα ὑμᾶς ἄτερ","wordsOfJesus":true},{"noteId":1491},{"text":"βαλαντίου καὶ πήρας καὶ ὑποδημάτων, μή τινος","wordsOfJesus":true},{"noteId":1492},{"text":"ὑστερήσατε;","wordsOfJesus":true},"Οἱ δὲ",{"noteId":1493},"εἶπον,",{"noteId":1494},"Οὐθενός."]},{"type":"verse","number":36,"content":["Εἶπεν",{"noteId":1495},"οὖν αὐτοῖς,",{"text":"Ἀλλὰ νῦν ὁ ἔχων","wordsOfJesus":true},{"noteId":1496},{"text":"βαλάντιον ἀράτω, ὁμοίως καὶ πήραν· καὶ ὁ μὴ ἔχων,","wordsOfJesus":true},{"noteId":1497},{"text":"πωλήσει τὸ ἱμάτιον αὐτοῦ, καὶ","wordsOfJesus":true},{"noteId":1498},{"text":"ἀγοράσει μάχαιραν.","wordsOfJesus":true}]},{"type":"verse","number":37,"content":[{"text":"Λέγω γὰρ ὑμῖν ὅτι","wordsOfJesus":true},{"noteId":1499},{"text":"ἔτι τοῦτο τὸ γεγραμμένον δεῖ τελεσθῆναι ἐν ἐμοί, τὸ Καὶ μετὰ ἀνόμων ἐλογίσθη· καὶ γὰρ","wordsOfJesus":true},{"noteId":1500},{"text":"τὰ περὶ ἐμοῦ τέλος ἔχει.","wordsOfJesus":true}]},{"type":"verse","number":38,"content":["Οἱ δὲ",{"noteId":1501},"εἶπον, Κύριε, ἰδού, μάχαιραι ὧδε δύο. Ὁ δὲ εἶπεν αὐτοῖς,",{"text":"Ἱκανόν ἐστι.","wordsOfJesus":true}]},{"type":"heading","content":["Jesus Prays on the Mount of Olives"]},{"type":"verse","number":39,"content":["Καὶ ἐξελθὼν ἐπορεύθη κατὰ τὸ ἔθος εἰς τὸ ὄρος τῶν Ἐλαιῶν· ἠκολούθησαν δὲ αὐτῷ καὶ οἱ μαθηταὶ",{"noteId":1502},"αὐτοῦ."]},{"type":"verse","number":40,"content":["Γενόμενος δὲ ἐπὶ τοῦ τόπου, εἶπεν αὐτοῖς,",{"text":"Προσεύχεσθε μὴ εἰσελθεῖν εἰς πειρασμόν.","wordsOfJesus":true}]},{"type":"verse","number":41,"content":["Καὶ αὐτὸς ἀπεσπάσθη ἀπ᾽ αὐτῶν ὡσεὶ λίθου βολήν, καὶ θεὶς τὰ γόνατα προσηύχετο,"]},{"type":"verse","number":42,"content":["λέγων,",{"text":"Πάτερ, εἰ βούλει","wordsOfJesus":true},{"noteId":1503},{"text":"παρενεγκεῖν","wordsOfJesus":true},{"noteId":1504},{"text":"τὸ ποτήριον τοῦτο ἀπ᾽ ἐμοῦ· πλὴν μὴ τὸ θέλημά μου, ἀλλὰ τὸ σὸν","wordsOfJesus":true},{"noteId":1505},{"text":"γενέσθω.","wordsOfJesus":true}]},{"type":"verse","number":43,"content":[{"noteId":1506},"Ὤφθη δὲ αὐτῷ ἄγγελος",{"noteId":1507},"ἀπ᾽ οὐρανοῦ ἐνισχύων αὐτόν."]},{"type":"verse","number":44,"content":["Καὶ γενόμενος ἐν ἀγωνίᾳ, ἐκτενέστερον προσηύχετο.",{"noteId":1508},"Ἐγένετο δὲ ὁ ἱδρὼς αὐτοῦ ὡσεὶ θρόμβοι αἵματος καταβαίνοντες ἐπὶ τὴν γῆν."]},{"type":"verse","number":45,"content":["Καὶ ἀναστὰς ἀπὸ τῆς προσευχῆς, ἐλθὼν πρὸς τοὺς",{"noteId":1509},"μαθητὰς εὗρεν",{"noteId":1510},"αὐτοὺς κοιμωμένους ἀπὸ τῆς λύπης,"]},{"type":"verse","number":46,"content":["καὶ εἶπεν αὐτοῖς,",{"text":"Τί καθεύδετε; Ἀναστάντες προσεύχεσθε, ἵνα μὴ εἰσέλθητε εἰς πειρασμόν.","wordsOfJesus":true}]},{"type":"heading","content":["Jesus Arrested"]},{"type":"verse","number":47,"content":["Ἔτι",{"noteId":1511},"δὲ αὐτοῦ λαλοῦντος, ἰδού, ὄχλος καὶ ὁ λεγόμενος Ἰούδας, εἷς τῶν δώδεκα,",{"noteId":1512},"προήρχετο",{"noteId":1513},"αὐτούς, καὶ ἤγγισε τῷ Ἰησοῦ φιλῆσαι",{"noteId":1514},"αὐτόν."]},{"type":"verse","number":48,"content":[{"noteId":1515},"Ὁ δὲ Ἰησοῦς εἶπεν αὐτῷ,",{"text":"Ἰούδα, φιλήματι τὸν υἱὸν τοῦ ἀνθρώπου παραδίδως;","wordsOfJesus":true}]},{"type":"verse","number":49,"content":["Ἰδόντες δὲ οἱ περὶ αὐτὸν τὸ ἐσόμενον",{"noteId":1516},"εἶπον αὐτῷ, Κύριε, εἰ πατάξομεν ἐν",{"noteId":1517},"μαχαίρᾳ;"]},{"type":"verse","number":50,"content":["Καὶ ἐπάταξεν εἷς τις ἐξ αὐτῶν",{"noteId":1518},"τὸν δοῦλον τοῦ ἀρχιερέως, καὶ ἀφεῖλεν",{"noteId":1519},"αὐτοῦ τὸ οὖς τὸ δεξιόν."]},{"type":"verse","number":51,"content":["Ἀποκριθεὶς δὲ ὁ Ἰησοῦς εἶπεν,",{"text":"Ἐᾶτε ἕως τούτου.","wordsOfJesus":true},"Καὶ ἁψάμενος τοῦ ὠτίου",{"noteId":1520},"αὐτοῦ, ἰάσατο αὐτόν."]},{"type":"verse","number":52,"content":["Εἶπε δὲ",{"noteId":1521},"ὁ Ἰησοῦς πρὸς τοὺς παραγενομένους",{"noteId":1522},"ἐπ᾽ αὐτὸν ἀρχιερεῖς καὶ στρατηγοὺς τοῦ ἱεροῦ καὶ πρεσβυτέρους,",{"text":"Ὡς ἐπὶ λῃστὴν","wordsOfJesus":true},{"noteId":1523},{"text":"ἐξεληλύθατε μετὰ μαχαιρῶν καὶ ξύλων;","wordsOfJesus":true}]},{"type":"verse","number":53,"content":[{"text":"Καθ᾽ ἡμέραν ὄντος μου μεθ᾽ ὑμῶν ἐν τῷ ἱερῷ, οὐκ ἐξετείνατε τὰς χεῖρας ἐπ᾽ ἐμέ.","wordsOfJesus":true},{"noteId":1524},{"text":"Ἀλλ᾽ αὕτη","wordsOfJesus":true},{"noteId":1525},{"text":"ὑμῶν ἐστιν ἡ ὥρα, καὶ ἡ ἐξουσία τοῦ σκότους.","wordsOfJesus":true}]},{"type":"heading","content":["Peter Denies Jesus"]},{"type":"verse","number":54,"content":["Συλλαβόντες δὲ αὐτὸν ἤγαγον, καὶ εἰσήγαγον",{"noteId":1526},"αὐτὸν εἰς",{"noteId":1527},"τὸν οἶκον τοῦ ἀρχιερέως· ὁ δὲ Πέτρος ἠκολούθει μακρόθεν."]},{"type":"verse","number":55,"content":[{"noteId":1528},"Ἁψάντων δὲ",{"noteId":1529},"πῦρ ἐν μέσῳ τῆς αὐλῆς, καὶ",{"noteId":1530},"συγκαθισάντων",{"noteId":1531},"αὐτῶν, ἐκάθητο ὁ Πέτρος",{"noteId":1532},"ἐν μέσῳ αὐτῶν."]},{"type":"verse","number":56,"content":["Ἰδοῦσα δὲ αὐτὸν παιδίσκη τις καθήμενον πρὸς τὸ φῶς, καὶ ἀτενίσασα αὐτῷ, εἶπε, Καὶ οὗτος σὺν αὐτῷ ἦν."]},{"type":"verse","number":57,"content":["Ὁ δὲ ἠρνήσατο",{"noteId":1533},"αὐτόν, λέγων,",{"noteId":1534},"Γύναι, οὐκ οἶδα αὐτόν."]},{"type":"verse","number":58,"content":["Καὶ μετὰ βραχὺ ἕτερος ἰδὼν αὐτὸν ἔφη, Καὶ σὺ ἐξ αὐτῶν εἶ. Ὁ δὲ Πέτρος",{"noteId":1535},"εἶπεν, Ἄνθρωπε, οὐκ εἰμί."]},{"type":"verse","number":59,"content":["Καὶ διαστάσης ὡσεὶ ὥρας μιᾶς, ἄλλος τις διϊσχυρίζετο, λέγων, Ἐπ᾽ ἀληθείας καὶ οὗτος μετ᾽ αὐτοῦ ἦν· καὶ γὰρ Γαλιλαῖός ἐστιν."]},{"type":"verse","number":60,"content":["Εἶπε δὲ ὁ Πέτρος, Ἄνθρωπε, οὐκ οἶδα ὃ λέγεις. Καὶ παραχρῆμα, ἔτι λαλοῦντος αὐτοῦ, ἐφώνησεν",{"noteId":1536},"ἀλέκτωρ."]},{"type":"verse","number":61,"content":["Καὶ στραφεὶς ὁ Κύριος ἐνέβλεψε τῷ Πέτρῳ. Καὶ ὑπεμνήσθη ὁ Πέτρος τοῦ",{"noteId":1537},"λόγου τοῦ Κυρίου, ὡς εἶπεν αὐτῷ ὅτι",{"text":"Πρὶν ἀλέκτορα","wordsOfJesus":true},{"noteId":1538},{"text":"φωνῆσαι, ἀπαρνήσῃ με τρίς.","wordsOfJesus":true}]},{"type":"verse","number":62,"content":["Καὶ ἐξελθὼν ἔξω",{"noteId":1539},"ὁ Πέτρος ἔκλαυσε πικρῶς."]},{"type":"heading","content":["Jesus Is Mocked and Beaten"]},{"type":"verse","number":63,"content":["Καὶ οἱ ἄνδρες οἱ συνέχοντες",{"noteId":1540},"τὸν Ἰησοῦν ἐνέπαιζον αὐτῷ,",{"noteId":1541},"δέροντες."]},{"type":"verse","number":64,"content":["Καὶ περικαλύψαντες αὐτόν,",{"noteId":1542},"ἔτυπτον αὐτοῦ τὸ πρόσωπον, καὶ ἐπηρώτων αὐτόν, λέγοντες, Προφήτευσον. Τίς ἐστιν ὁ παίσας σε;"]},{"type":"verse","number":65,"content":["Καὶ ἕτερα πολλὰ βλασφημοῦντες ἔλεγον εἰς αὐτόν."]},{"type":"heading","content":["Jesus Faces the Sanhedrin"]},{"type":"verse","number":66,"content":["Καὶ ὡς ἐγένετο ἡμέρα, συνήχθη τὸ πρεσβυτέριον τοῦ λαοῦ, ἀρχιερεῖς",{"noteId":1543},"καὶ γραμματεῖς, καὶ",{"noteId":1544},"ἀνήγαγον αὐτὸν εἰς τὸ συνέδριον",{"noteId":1545},"αὐτῶν, λέγοντες,"]},{"type":"verse","number":67,"content":["Εἰ σὺ εἶ ὁ Χριστός,",{"noteId":1546},"εἰπὲ ἡμῖν. Εἶπε δὲ αὐτοῖς,",{"text":"Ἐὰν ὑμῖν εἴπω, οὐ μὴ πιστεύσητε·","wordsOfJesus":true}]},{"type":"verse","number":68,"content":[{"text":"ἐὰν δὲ","wordsOfJesus":true},{"noteId":1547},{"text":"καὶ ἐρωτήσω, οὐ μὴ ἀποκριθῆτέ","wordsOfJesus":true},{"noteId":1548},{"text":"μοι, ἢ ἀπολύσητε.","wordsOfJesus":true}]},{"type":"verse","number":69,"content":[{"text":"Ἀπὸ τοῦ","wordsOfJesus":true},{"noteId":1549},{"text":"νῦν ἔσται ὁ υἱὸς τοῦ ἀνθρώπου καθήμενος ἐκ δεξιῶν τῆς δυνάμεως τοῦ Θεοῦ.","wordsOfJesus":true}]},{"type":"verse","number":70,"content":[{"noteId":1550},"Εἶπον δὲ πάντες, Σὺ οὖν εἶ ὁ υἱὸς τοῦ Θεοῦ; Ὁ δὲ πρὸς αὐτοὺς ἔφη,",{"text":"Ὑμεῖς λέγετε ὅτι ἐγώ εἰμι.","wordsOfJesus":true}]},{"type":"verse","number":71,"content":["Οἱ δὲ",{"noteId":1551},"εἶπον, Τί ἔτι",{"noteId":1552},"χρείαν ἔχομεν μαρτυρίας; Αὐτοὶ γὰρ ἠκούσαμεν ἀπὸ τοῦ στόματος αὐτοῦ."]}],"footnotes":[{"noteId":1449,"caller":"+","text":"σατανας ¦ ο σατανας ANT PCK TR","reference":{"chapter":22,"verse":3}},{"noteId":1450,"caller":"+","text":"επικαλουμενον ¦ καλουμενον CT","reference":{"chapter":22,"verse":3}},{"noteId":1451,"caller":"+","text":"στρατηγοις ¦ τοις στρατηγοις TR ¦ γραμματευσιν και στρατηγοις ANT","reference":{"chapter":22,"verse":4}},{"noteId":1452,"caller":"+","text":"αυτον παραδω αυτοις ¦ αυτοις παραδω αυτον CT","reference":{"chapter":22,"verse":4}},{"noteId":1453,"caller":"+","text":"αργυριον ¦ αργυρ