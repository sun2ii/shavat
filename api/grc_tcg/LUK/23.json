{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"LUK","translationId":"grc_tcg","name":"ΚΑΤΑ ΛΟΥΚΑΝ","commonName":"ΚΑΤΑ ΛΟΥΚΑΝ","title":"ΚΑΤΑ ΛΟΥΚΑΝ","order":42,"numberOfChapters":24,"sha256":"b8609ef71fdab51fb2a2ec7abf4402d02f5094e9b75db2d2aa00fac79cfd4207","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/grc_tcg/LUK/24.json","totalNumberOfVerses":1150},"chapter":{"number":23,"content":[{"type":"heading","content":["Jesus Brought Before Pilate"]},{"type":"verse","number":1,"content":["Καὶ ἀναστὰν ἅπαν τὸ πλῆθος αὐτῶν,",{"noteId":1553},"ἤγαγον αὐτὸν ἐπὶ τὸν",{"noteId":1554},"Πιλάτον."]},{"type":"verse","number":2,"content":["Ἤρξαντο δὲ κατηγορεῖν αὐτοῦ, λέγοντες, Τοῦτον",{"noteId":1555},"εὕρομεν διαστρέφοντα τὸ",{"noteId":1556},"ἔθνος, καὶ κωλύοντα",{"noteId":1557},"Καίσαρι φόρους διδόναι,",{"noteId":1558},"λέγοντα",{"noteId":1559},"ἑαυτὸν Χριστὸν βασιλέα εἶναι."]},{"type":"verse","number":3,"content":["Ὁ δὲ",{"noteId":1560},"Πιλάτος",{"noteId":1561},"ἐπηρώτησεν αὐτόν, λέγων, Σὺ εἶ ὁ βασιλεὺς τῶν Ἰουδαίων; Ὁ δὲ ἀποκριθεὶς αὐτῷ ἔφη,",{"text":"Σὺ λέγεις.","wordsOfJesus":true}]},{"type":"verse","number":4,"content":["Ὁ δὲ",{"noteId":1562},"Πιλάτος εἶπε πρὸς τοὺς ἀρχιερεῖς καὶ τοὺς",{"noteId":1563},"ὄχλους, Οὐδὲν εὑρίσκω αἴτιον ἐν τῷ ἀνθρώπῳ τούτῳ."]},{"type":"verse","number":5,"content":["Οἱ δὲ ἐπίσχυον, λέγοντες ὅτι Ἀνασείει τὸν λαόν, διδάσκων καθ᾽ ὅλης τῆς Ἰουδαίας,",{"noteId":1564},"ἀρξάμενος ἀπὸ τῆς Γαλιλαίας ἕως ὧδε."]},{"type":"heading","content":["Jesus Brought Before Herod"]},{"type":"verse","number":6,"content":[{"noteId":1565},"Πιλάτος δὲ ἀκούσας",{"noteId":1566},"Γαλιλαίαν ἐπηρώτησεν εἰ ὁ ἄνθρωπος Γαλιλαῖός ἐστι."]},{"type":"verse","number":7,"content":["Καὶ ἐπιγνοὺς ὅτι ἐκ τῆς ἐξουσίας Ἡρῴδου ἐστίν, ἀνέπεμψεν αὐτὸν πρὸς",{"noteId":1567},"Ἡρῴδην, ὄντα καὶ αὐτὸν ἐν Ἱεροσολύμοις ἐν ταύταις ταῖς ἡμέραις."]},{"type":"verse","number":8,"content":["Ὁ δὲ Ἡρῴδης ἰδὼν τὸν Ἰησοῦν ἐχάρη",{"noteId":1568},"λίαν· ἦν γὰρ",{"noteId":1569},"θέλων ἐξ ἱκανοῦ ἰδεῖν αὐτόν, διὰ τὸ",{"noteId":1570},"ἀκούειν",{"noteId":1571},"πολλὰ περὶ αὐτοῦ· καὶ ἤλπιζέ τι σημεῖον ἰδεῖν ὑπ᾽ αὐτοῦ",{"noteId":1572},"γινόμενον."]},{"type":"verse","number":9,"content":["Ἐπηρώτα δὲ αὐτὸν ἐν λόγοις ἱκανοῖς· αὐτὸς δὲ οὐδὲν ἀπεκρίνατο αὐτῷ."]},{"type":"verse","number":10,"content":[{"noteId":1573},"Εἱστήκεισαν δὲ οἱ",{"noteId":1574},"ἀρχιερεῖς καὶ οἱ γραμματεῖς, εὐτόνως κατηγοροῦντες αὐτοῦ."]},{"type":"verse","number":11,"content":["Ἐξουθενήσας δὲ αὐτὸν",{"noteId":1575},"ὁ Ἡρῴδης σὺν τοῖς στρατεύμασιν αὐτοῦ, καὶ ἐμπαίξας, περιβαλὼν",{"noteId":1576},"αὐτὸν ἐσθῆτα λαμπράν, ἀνέπεμψεν αὐτὸν τῷ",{"noteId":1577},"Πιλάτῳ."]},{"type":"verse","number":12,"content":["Ἐγένοντο δὲ φίλοι ὅ τε",{"noteId":1578},"Πιλάτος καὶ ὁ Ἡρῴδης ἐν αὐτῇ τῇ ἡμέρᾳ μετ᾽ ἀλλήλων· προϋπῆρχον γὰρ ἐν ἔχθρᾳ ὄντες πρὸς",{"noteId":1579},"ἑαυτούς."]},{"type":"heading","content":["The Crowd Calls For Jesus' Crucifixion"]},{"type":"verse","number":13,"content":[{"noteId":1580},"Πιλάτος δὲ",{"noteId":1581},"συγκαλεσάμενος τοὺς ἀρχιερεῖς καὶ τοὺς ἄρχοντας καὶ τὸν λαόν,"]},{"type":"verse","number":14,"content":["εἶπε πρὸς αὐτούς, Προσηνέγκατέ μοι τὸν ἄνθρωπον τοῦτον, ὡς ἀποστρέφοντα τὸν λαόν· καὶ ἰδού, ἐγὼ ἐνώπιον ὑμῶν ἀνακρίνας",{"noteId":1582},"οὐδὲν εὗρον ἐν τῷ ἀνθρώπῳ τούτῳ αἴτιον ὧν κατηγορεῖτε κατ᾽ αὐτοῦ·"]},{"type":"verse","number":15,"content":["ἀλλ᾽ οὐδὲ Ἡρῴδης·",{"noteId":1583},"ἀνέπεμψα γὰρ ὑμᾶς πρὸς αὐτόν, καὶ ἰδού, οὐδὲν ἄξιον θανάτου ἐστὶ πεπραγμένον αὐτῷ."]},{"type":"verse","number":16,"content":["Παιδεύσας οὖν αὐτὸν ἀπολύσω."]},{"type":"verse","number":17,"content":[{"noteId":1584},"Ἀνάγκην δὲ εἶχεν ἀπολύειν αὐτοῖς κατὰ ἑορτὴν ἕνα."]},{"type":"verse","number":18,"content":[{"noteId":1585},"Ἀνέκραξαν δὲ",{"noteId":1586},"παμπληθεί, λέγοντες, Αἶρε τοῦτον, ἀπόλυσον δὲ ἡμῖν",{"noteId":1587},"Βαραββᾶν·"]},{"type":"verse","number":19,"content":["ὅστις ἦν διὰ στάσιν τινὰ γενομένην ἐν τῇ πόλει καὶ φόνον",{"noteId":1588},"βεβλημένος εἰς φυλακήν."]},{"type":"verse","number":20,"content":["Πάλιν",{"noteId":1589},"οὖν ὁ",{"noteId":1590},"Πιλάτος",{"noteId":1591},"προσεφώνησε, θέλων ἀπολῦσαι τὸν Ἰησοῦν."]},{"type":"verse","number":21,"content":["Οἱ δὲ ἐπεφώνουν, λέγοντες,",{"noteId":1592},"Σταύρωσον, σταύρωσον αὐτόν."]},{"type":"verse","number":22,"content":["Ὁ δὲ τρίτον εἶπε πρὸς αὐτούς, Τί γὰρ κακὸν ἐποίησεν οὗτος; Οὐδὲν",{"noteId":1593},"αἴτιον θανάτου εὗρον ἐν αὐτῷ· παιδεύσας οὖν αὐτὸν ἀπολύσω."]},{"type":"verse","number":23,"content":["Οἱ δὲ ἐπέκειντο φωναῖς μεγάλαις, αἰτούμενοι αὐτὸν σταυρωθῆναι· καὶ κατίσχυον αἱ φωναὶ αὐτῶν",{"noteId":1594},"καὶ τῶν ἀρχιερέων."]},{"type":"verse","number":24,"content":[{"noteId":1595},"Ὁ δὲ",{"noteId":1596},"Πιλάτος",{"noteId":1597},"ἐπέκρινε γενέσθαι τὸ αἴτημα αὐτῶν."]},{"type":"verse","number":25,"content":["Ἀπέλυσε",{"noteId":1598},"δὲ τὸν διὰ στάσιν καὶ φόνον βεβλημένον εἰς",{"noteId":1599},"τὴν φυλακήν, ὃν ᾐτοῦντο· τὸν δὲ Ἰησοῦν παρέδωκε τῷ θελήματι αὐτῶν."]},{"type":"heading","content":["The Crucifixion"]},{"type":"verse","number":26,"content":["Καὶ ὡς ἀπήγαγον αὐτόν, ἐπιλαβόμενοι",{"noteId":1600},"Σίμωνός τινος Κυρηναίου ἐρχομένου ἀπ᾽ ἀγροῦ, ἐπέθηκαν αὐτῷ τὸν σταυρόν, φέρειν",{"noteId":1601},"ὄπισθεν τοῦ Ἰησοῦ."]},{"type":"verse","number":27,"content":["Ἠκολούθει δὲ αὐτῷ πολὺ πλῆθος τοῦ λαοῦ, καὶ γυναικῶν αἳ",{"noteId":1602},"καὶ ἐκόπτοντο καὶ ἐθρήνουν αὐτόν."]},{"type":"verse","number":28,"content":["Στραφεὶς δὲ πρὸς αὐτὰς",{"noteId":1603},"ὁ Ἰησοῦς εἶπε,",{"text":"Θυγατέρες Ἱερουσαλήμ, μὴ κλαίετε ἐπ᾽ ἐμέ, πλὴν ἐφ᾽ ἑαυτὰς κλαίετε καὶ ἐπὶ τὰ τέκνα ὑμῶν.","wordsOfJesus":true}]},{"type":"verse","number":29,"content":[{"text":"Ὅτι ἰδού, ἔρχονται ἡμέραι ἐν αἷς ἐροῦσι, Μακάριαι αἱ στεῖραι, καὶ","wordsOfJesus":true},{"noteId":1604},{"text":"κοιλίαι αἳ οὐκ ἐγέννησαν, καὶ μαστοὶ οἳ οὐκ","wordsOfJesus":true},{"noteId":1605},{"text":"ἐθήλασαν.","wordsOfJesus":true}]},{"type":"verse","number":30,"content":[{"text":"Τότε ἄρξονται λέγειν τοῖς ὄρεσι,","wordsOfJesus":true},{"noteId":1606},{"text":"Πέσετε ἐφ᾽ ἡμᾶς· καὶ τοῖς βουνοῖς, Καλύψατε ἡμᾶς.","wordsOfJesus":true}]},{"type":"verse","number":31,"content":[{"text":"Ὅτι εἰ ἐν","wordsOfJesus":true},{"noteId":1607},{"text":"τῷ ὑγρῷ ξύλῳ ταῦτα ποιοῦσιν, ἐν τῷ ξηρῷ τί γένηται;","wordsOfJesus":true}]},{"type":"verse","number":32,"content":["Ἤγοντο δὲ καὶ ἕτεροι",{"noteId":1608},"δύο κακοῦργοι σὺν αὐτῷ ἀναιρεθῆναι."]},{"type":"verse","number":33,"content":["Καὶ ὅτε",{"noteId":1609},"ἀπῆλθον ἐπὶ τὸν τόπον τὸν καλούμενον Κρανίον, ἐκεῖ ἐσταύρωσαν αὐτόν, καὶ τοὺς κακούργους, ὃν μὲν ἐκ δεξιῶν, ὃν δὲ ἐξ ἀριστερῶν."]},{"type":"verse","number":34,"content":[{"noteId":1610},"Ὁ δὲ Ἰησοῦς ἔλεγε,",{"text":"Πάτερ, ἄφες αὐτοῖς· οὐ γὰρ οἴδασι τί ποιοῦσι.","wordsOfJesus":true},"Διαμεριζόμενοι δὲ τὰ ἱμάτια αὐτοῦ,",{"noteId":1611},"ἔβαλον",{"noteId":1612},"κλῆρον."]},{"type":"verse","number":35,"content":["Καὶ",{"noteId":1613},"εἱστήκει ὁ λαὸς θεωρῶν. Ἐξεμυκτήριζον δὲ καὶ οἱ ἄρχοντες",{"noteId":1614},"σὺν αὐτοῖς, λέγοντες, Ἄλλους ἔσωσε, σωσάτω ἑαυτόν, εἰ οὗτός ἐστιν ὁ Χριστός,",{"noteId":1615},"ὁ τοῦ Θεοῦ ἐκλεκτός."]},{"type":"verse","number":36,"content":[{"noteId":1616},"Ἐνέπαιζον δὲ αὐτῷ καὶ οἱ στρατιῶται, προσερχόμενοι",{"noteId":1617},"καὶ ὄξος προσφέροντες αὐτῷ,"]},{"type":"verse","number":37,"content":["καὶ λέγοντες, Εἰ σὺ εἶ ὁ βασιλεὺς τῶν Ἰουδαίων, σῶσον σεαυτόν."]},{"type":"verse","number":38,"content":["Ἦν δὲ καὶ ἐπιγραφὴ",{"noteId":1618},"γεγραμμένη ἐπ᾽ αὐτῷ γράμμασιν Ἑλληνικοῖς καὶ Ῥωμαϊκοῖς καὶ Ἑβραϊκοῖς, Οὗτός ἐστιν ὁ βασιλεὺς τῶν",{"noteId":1619},"Ἰουδαίων."]},{"type":"verse","number":39,"content":["Εἷς δὲ τῶν κρεμασθέντων κακούργων ἐβλασφήμει αὐτόν,",{"noteId":1620},"λέγων,",{"noteId":1621},"Εἰ σὺ εἶ ὁ Χριστός, σῶσον σεαυτὸν καὶ ἡμᾶς."]},{"type":"verse","number":40,"content":["Ἀποκριθεὶς δὲ ὁ ἕτερος",{"noteId":1622},"ἐπετίμα αὐτῷ, λέγων, Οὐδὲ φοβῇ σὺ τὸν Θεόν, ὅτι ἐν τῷ αὐτῷ κρίματι εἶ;"]},{"type":"verse","number":41,"content":["Καὶ ἡμεῖς μὲν δικαίως, ἄξια γὰρ ὧν ἐπράξαμεν ἀπολαμβάνομεν· οὗτος δὲ οὐδὲν ἄτοπον ἔπραξε."]},{"type":"verse","number":42,"content":["Καὶ ἔλεγε",{"noteId":1623},"τῷ Ἰησοῦ, Μνήσθητί μου, Κύριε, ὅταν ἔλθῃς",{"noteId":1624},"ἐν τῇ βασιλείᾳ σου."]},{"type":"verse","number":43,"content":["Καὶ εἶπεν αὐτῷ",{"noteId":1625},"ὁ Ἰησοῦς,",{"text":"Ἀμὴν","wordsOfJesus":true},{"noteId":1626},{"text":"λέγω σοι, σήμερον μετ᾽ ἐμοῦ ἔσῃ ἐν τῷ παραδείσῳ.","wordsOfJesus":true}]},{"type":"heading","content":["The Death of Jesus"]},{"type":"verse","number":44,"content":[{"noteId":1627},"Ἦν δὲ ὡσεὶ ὥρα ἕκτη, καὶ σκότος ἐγένετο ἐφ᾽ ὅλην τὴν γῆν ἕως ὥρας",{"noteId":1628},"ἐνάτης."]},{"type":"verse","number":45,"content":[{"noteId":1629},"Καὶ ἐσκοτίσθη ὁ ἥλιος,",{"noteId":1630},"καὶ ἐσχίσθη τὸ καταπέτασμα τοῦ ναοῦ μέσον."]},{"type":"verse","number":46,"content":["Καὶ φωνήσας φωνῇ μεγάλῃ ὁ Ἰησοῦς εἶπε,",{"text":"Πάτερ, εἰς χεῖράς σου","wordsOfJesus":true},{"noteId":1631},{"text":"παραθήσομαι τὸ πνεῦμά μου·","wordsOfJesus":true},{"noteId":1632},"καὶ ταῦτα εἰπὼν ἐξέπνευσεν."]},{"type":"verse","number":47,"content":["Ἰδὼν δὲ ὁ",{"noteId":1633},"ἑκατόνταρχος τὸ γενόμενον,",{"noteId":1634},"ἐδόξασε τὸν Θεόν, λέγων, Ὄντως ὁ ἄνθρωπος οὗτος δίκαιος ἦν."]},{"type":"verse","number":48,"content":["Καὶ πάντες οἱ",{"noteId":1635},"συμπαραγενόμενοι ὄχλοι ἐπὶ τὴν θεωρίαν ταύτην,",{"noteId":1636},"θεωροῦντες τὰ γενόμενα, τύπτοντες",{"noteId":1637},"ἑαυτῶν τὰ στήθη ὑπέστρεφον."]},{"type":"verse","number":49,"content":["Εἱστήκεισαν δὲ πάντες οἱ γνωστοὶ",{"noteId":1638},"αὐτοῦ",{"noteId":1639},"μακρόθεν, καὶ γυναῖκες αἱ",{"noteId":1640},"συνακολουθήσασαι αὐτῷ ἀπὸ τῆς Γαλιλαίας, ὁρῶσαι ταῦτα."]},{"type":"heading","content":["The Burial of Jesus"]},{"type":"verse","number":50,"content":["Καὶ ἰδού, ἀνὴρ ὀνόματι Ἰωσήφ, βουλευτὴς ὑπάρχων,",{"noteId":1641},"ἀνὴρ ἀγαθὸς καὶ δίκαιος—"]},{"type":"verse","number":51,"content":["οὗτος οὐκ ἦν",{"noteId":1642},"συγκατατεθειμένος τῇ βουλῇ καὶ τῇ πράξει αὐτῶν—ἀπὸ Ἀριμαθαίας πόλεως τῶν Ἰουδαίων, ὃς",{"noteId":1643},"καὶ προσεδέχετο καὶ αὐτὸς τὴν βασιλείαν τοῦ Θεοῦ·"]},{"type":"verse","number":52,"content":["οὗτος προσελθὼν τῷ",{"noteId":1644},"Πιλάτῳ ᾐτήσατο τὸ σῶμα τοῦ Ἰησοῦ."]},{"type":"verse","number":53,"content":["Καὶ καθελὼν",{"noteId":1645},"αὐτὸ ἐνετύλιξεν αὐτὸ σινδόνι, καὶ ἔθηκεν",{"noteId":1646},"αὐτὸ ἐν μνήματι λαξευτῷ, οὗ οὐκ ἦν",{"noteId":1647},"οὐδέπω οὐδεὶς κείμενος."]},{"type":"verse","number":54,"content":["Καὶ ἡμέρα ἦν",{"noteId":1648},"Παρασκευή, σάββατον ἐπέφωσκε."]},{"type":"verse","number":55,"content":["Κατακολουθήσασαι δὲ",{"noteId":1649},"γυναῖκες, αἵτινες ἦσαν συνεληλυθυῖαι",{"noteId":1650},"αὐτῷ ἐκ τῆς Γαλιλαίας, ἐθεάσαντο τὸ μνημεῖον, καὶ ὡς ἐτέθη τὸ σῶμα αὐτοῦ."]},{"type":"verse","number":56,"content":["Ὑποστρέψασαι δὲ ἡτοίμασαν ἀρώματα καὶ μύρα. Καὶ τὸ μὲν σάββατον ἡσύχασαν κατὰ τὴν ἐντολήν."]}],"footnotes":[{"noteId":1553,"caller":"+","text":"ηγαγον ¦ ηγαγεν TR","reference":{"chapter":23,"verse":1}},{"noteId":1554,"caller":"+","text":"πιλατον ¦ πειλατον TH WH","reference":{"chapter":23,"verse":1}},{"noteId":1555,"caller":"+","text":"ευρομεν ¦ ευραμεν CT","reference":{"chapter":23,"verse":2}},{"noteId":1556,"caller":"+","text":"εθνος ¦ εθνος ημων CT","reference":{"chapter":23,"verse":2}},{"noteId":1557,"caller":"+","text":"καισαρι φορους ¦ φορους καισαρι CT","reference":{"chapter":23,"verse":2}},{"noteId":1558,"caller":"+","text":"λεγοντα ¦ και λεγοντα CT","reference":{"chapter":23,"verse":2}},{"noteId":15