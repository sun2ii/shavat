{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"LUK","translationId":"grc_tcg","name":"ΚΑΤΑ ΛΟΥΚΑΝ","commonName":"ΚΑΤΑ ΛΟΥΚΑΝ","title":"ΚΑΤΑ ΛΟΥΚΑΝ","order":42,"numberOfChapters":24,"sha256":"b8609ef71fdab51fb2a2ec7abf4402d02f5094e9b75db2d2aa00fac79cfd4207","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/grc_tcg/LUK/24.json","totalNumberOfVerses":1150},"chapter":{"number":3,"content":[{"type":"heading","content":["The Preaching of John the Baptist"]},{"type":"verse","number":1,"content":["Ἐν ἔτει δὲ πεντεκαιδεκάτῳ τῆς ἡγεμονίας Τιβερίου Καίσαρος, ἡγεμονεύοντος Ποντίου",{"noteId":140},"Πιλάτου τῆς Ἰουδαίας, καὶ",{"noteId":141},"τετραρχοῦντος τῆς Γαλιλαίας Ἡρῴδου, Φιλίππου δὲ τοῦ ἀδελφοῦ αὐτοῦ",{"noteId":142},"τετραρχοῦντος τῆς Ἰτουραίας καὶ Τραχωνίτιδος χώρας, καὶ Λυσανίου τῆς",{"noteId":143},"Ἀβιληνῆς",{"noteId":144},"τετραρχοῦντος,"]},{"type":"verse","number":2,"content":[{"noteId":145},"ἐπὶ",{"noteId":146},"ἀρχιερέως Ἄννα καὶ Καϊάφα, ἐγένετο ῥῆμα Θεοῦ ἐπὶ",{"noteId":147},"Ἰωάννην τὸν",{"noteId":148},"Ζαχαρίου υἱὸν ἐν τῇ ἐρήμῳ."]},{"type":"verse","number":3,"content":["Καὶ ἦλθεν εἰς πᾶσαν",{"noteId":149},"τὴν περίχωρον τοῦ Ἰορδάνου, κηρύσσων βάπτισμα μετανοίας εἰς ἄφεσιν ἁμαρτιῶν·"]},{"type":"verse","number":4,"content":["ὡς γέγραπται ἐν βίβλῳ λόγων Ἠσαΐου τοῦ προφήτου,",{"noteId":150},"λέγοντος,",{"lineBreak":true},{"text":"Φωνὴ βοῶντος ἐν τῇ ἐρήμῳ,","poem":1},{"lineBreak":true},{"text":"Ἑτοιμάσατε τὴν ὁδὸν Κυρίου·","poem":1},{"lineBreak":true},{"text":"εὐθείας ποιεῖτε τὰς τρίβους αὐτοῦ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Πᾶσα φάραγξ πληρωθήσεται,","poem":1},{"lineBreak":true},{"text":"καὶ πᾶν ὄρος καὶ βουνὸς ταπεινωθήσεται·","poem":1},{"lineBreak":true},{"text":"καὶ ἔσται τὰ σκολιὰ εἰς","poem":1},{"noteId":151},{"text":"εὐθεῖαν,","poem":1},{"lineBreak":true},{"text":"καὶ αἱ τραχεῖαι εἰς ὁδοὺς λείας·","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"καὶ ὄψεται πᾶσα σὰρξ τὸ σωτήριον τοῦ Θεοῦ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":["Ἔλεγεν οὖν τοῖς ἐκπορευομένοις ὄχλοις βαπτισθῆναι ὑπ᾽ αὐτοῦ, Γεννήματα ἐχιδνῶν, τίς ὑπέδειξεν ὑμῖν φυγεῖν ἀπὸ τῆς μελλούσης ὀργῆς;"]},{"type":"verse","number":8,"content":["Ποιήσατε οὖν καρποὺς ἀξίους τῆς μετανοίας· καὶ μὴ ἄρξησθε λέγειν ἐν ἑαυτοῖς, Πατέρα ἔχομεν τὸν Ἀβραάμ· λέγω γὰρ ὑμῖν ὅτι δύναται ὁ Θεὸς ἐκ τῶν λίθων τούτων ἐγεῖραι τέκνα τῷ Ἀβραάμ."]},{"type":"verse","number":9,"content":["Ἤδη δὲ καὶ ἡ ἀξίνη πρὸς τὴν ῥίζαν τῶν δένδρων κεῖται· πᾶν οὖν δένδρον μὴ ποιοῦν καρπὸν καλὸν ἐκκόπτεται καὶ εἰς πῦρ βάλλεται."]},{"type":"verse","number":10,"content":["Καὶ ἐπηρώτων αὐτὸν οἱ ὄχλοι λέγοντες, Τί οὖν",{"noteId":152},"ποιήσομεν;"]},{"type":"verse","number":11,"content":["Ἀποκριθεὶς δὲ",{"noteId":153},"λέγει αὐτοῖς, Ὁ ἔχων δύο χιτῶνας μεταδότω τῷ μὴ ἔχοντι· καὶ ὁ ἔχων βρώματα ὁμοίως ποιείτω."]},{"type":"verse","number":12,"content":["Ἦλθον δὲ καὶ τελῶναι",{"noteId":154},"βαπτισθῆναι, καὶ",{"noteId":155},"εἶπον πρὸς αὐτόν, Διδάσκαλε, τί",{"noteId":156},"ποιήσομεν;"]},{"type":"verse","number":13,"content":["Ὁ δὲ εἶπε πρὸς αὐτούς, Μηδὲν πλέον παρὰ τὸ διατεταγμένον ὑμῖν πράσσετε."]},{"type":"verse","number":14,"content":["Ἐπηρώτων δὲ αὐτὸν καὶ στρατευόμενοι, λέγοντες,",{"noteId":157},"Καὶ ἡμεῖς τί ποιήσομεν; Καὶ εἶπε",{"noteId":158},"πρὸς αὐτούς, Μηδένα",{"noteId":159},"διασείσητε, μηδὲ συκοφαντήσητε· καὶ ἀρκεῖσθε τοῖς ὀψωνίοις ὑμῶν."]},{"type":"verse","number":15,"content":["Προσδοκῶντος δὲ τοῦ λαοῦ, καὶ διαλογιζομένων πάντων ἐν ταῖς καρδίαις αὐτῶν περὶ τοῦ",{"noteId":160},"Ἰωάννου, μήποτε αὐτὸς εἴη ὁ Χριστός,"]},{"type":"verse","number":16,"content":["ἀπεκρίνατο",{"noteId":161},"ὁ Ἰωάννης, ἅπασι λέγων, Ἐγὼ μὲν ὕδατι βαπτίζω ὑμᾶς· ἔρχεται δὲ ὁ ἰσχυρότερός μου, οὗ οὐκ εἰμὶ ἱκανὸς λῦσαι τὸν ἱμάντα τῶν ὑποδημάτων αὐτοῦ· αὐτὸς ὑμᾶς βαπτίσει ἐν Πνεύματι Ἁγίῳ καὶ πυρί·"]},{"type":"verse","number":17,"content":["οὗ τὸ πτύον ἐν τῇ χειρὶ αὐτοῦ,",{"noteId":162},"καὶ διακαθαριεῖ τὴν ἅλωνα αὐτοῦ, καὶ συνάξει τὸν σῖτον εἰς τὴν ἀποθήκην αὐτοῦ, τὸ δὲ ἄχυρον κατακαύσει πυρὶ ἀσβέστῳ."]},{"type":"verse","number":18,"content":["Πολλὰ μὲν οὖν καὶ ἕτερα παρακαλῶν εὐηγγελίζετο",{"noteId":163},"τὸν λαόν·"]},{"type":"verse","number":19,"content":["ὁ δὲ Ἡρῴδης ὁ",{"noteId":164},"τετράρχης, ἐλεγχόμενος ὑπ᾽ αὐτοῦ περὶ Ἡρῳδιάδος τῆς γυναικὸς",{"noteId":165},"τοῦ ἀδελφοῦ αὐτοῦ, καὶ περὶ πάντων ὧν ἐποίησε πονηρῶν ὁ Ἡρῴδης,"]},{"type":"verse","number":20,"content":["προσέθηκε καὶ τοῦτο ἐπὶ πᾶσι,",{"noteId":166},"καὶ κατέκλεισε τὸν",{"noteId":167},"Ἰωάννην ἐν",{"noteId":168},"τῇ φυλακῇ."]},{"type":"heading","content":["The Baptism of Jesus"]},{"type":"verse","number":21,"content":["Ἐγένετο δὲ ἐν τῷ βαπτισθῆναι ἅπαντα τὸν λαόν, καὶ Ἰησοῦ βαπτισθέντος καὶ προσευχομένου, ἀνεῳχθῆναι τὸν οὐρανόν,"]},{"type":"verse","number":22,"content":["καὶ καταβῆναι τὸ Πνεῦμα τὸ Ἅγιον σωματικῷ εἴδει",{"noteId":169},"ὡσεὶ περιστερὰν ἐπ᾽ αὐτόν, καὶ φωνὴν ἐξ οὐρανοῦ γενέσθαι,",{"noteId":170},"λέγουσαν, Σὺ εἶ ὁ υἱός μου ὁ ἀγαπητός, ἐν σοὶ",{"noteId":171},"εὐδόκησα."]},{"type":"heading","content":["The Genealogy of Jesus"]},{"type":"verse","number":23,"content":["Καὶ αὐτὸς ἦν",{"noteId":172},"ὁ Ἰησοῦς",{"noteId":173},"ὡσεὶ ἐτῶν τριάκοντα ἀρχόμενος, ὢν—",{"noteId":174},"ὡς ἐνομίζετο—υἱὸς Ἰωσήφ, τοῦ",{"noteId":175},"Ἡλί,"]},{"type":"verse","number":24,"content":["τοῦ",{"noteId":176},"Ματθάτ, τοῦ",{"noteId":177},"Λευΐ, τοῦ",{"noteId":178},"Μελχί, τοῦ",{"noteId":179},"Ἰαννά, τοῦ Ἰωσήφ,"]},{"type":"verse","number":25,"content":["τοῦ Ματταθίου, τοῦ Ἀμώς, τοῦ Ναούμ, τοῦ",{"noteId":180},"Ἐσλί, τοῦ Ναγγαί,"]},{"type":"verse","number":26,"content":["τοῦ Μαάθ, τοῦ Ματταθίου, τοῦ",{"noteId":181},"Σεμεΐ, τοῦ",{"noteId":182},"Ἰωσήφ, τοῦ",{"noteId":183},"Ἰούδα,"]},{"type":"verse","number":27,"content":["τοῦ",{"noteId":184},"Ἰωανάν, τοῦ Ῥησά, τοῦ Ζοροβάβελ, τοῦ Σαλαθιήλ, τοῦ",{"noteId":185},"Νηρί,"]},{"type":"verse","number":28,"content":["τοῦ",{"noteId":186},"Μελχί, τοῦ",{"noteId":187},"Ἀδδί, τοῦ Κωσάμ, τοῦ",{"noteId":188},"Ἐλμωδάμ, τοῦ Ἤρ,"]},{"type":"verse","number":29,"content":["τοῦ",{"noteId":189},"Ἰωσή, τοῦ Ἐλιέζερ, τοῦ",{"noteId":190},"Ἰωρείμ, τοῦ",{"noteId":191},"Ματθάτ, τοῦ",{"noteId":192},"Λευΐ,"]},{"type":"verse","number":30,"content":["τοῦ",{"noteId":193},"Συμεών, τοῦ Ἰούδα, τοῦ Ἰωσήφ, τοῦ",{"noteId":194},"Ἰωνάν, τοῦ",{"noteId":195},"Ἐλιακείμ,"]},{"type":"verse","number":31,"content":["τοῦ Μελεᾶ, τοῦ",{"noteId":196},"Μαϊνάν, τοῦ Ματταθά, τοῦ",{"noteId":197},"Ναθάν, τοῦ",{"noteId":198},"Δαυίδ,"]},{"type":"verse","number":32,"content":["τοῦ Ἰεσσαί, τοῦ",{"noteId":199},"Ὠβήδ, τοῦ",{"noteId":200},"Βοόζ, τοῦ",{"noteId":201},"Σαλμών, τοῦ Ναασσών,"]},{"type":"verse","number":33,"content":["τοῦ",{"noteId":202},"Ἀμιναδάβ, τοῦ",{"noteId":203},"Ἀράμ, τοῦ",{"noteId":204},"Ἑσρώμ, τοῦ Φαρές, τοῦ Ἰούδα,"]},{"type":"verse","number":34,"content":["τοῦ Ἰακώβ, τοῦ Ἰσαάκ, τοῦ Ἀβραάμ, τοῦ",{"noteId":205},"Θάρα, τοῦ Ναχώρ,"]},{"type":"verse","number":35,"content":["τοῦ",{"noteId":206},"Σερούχ, τοῦ",{"noteId":207},"Ῥαγαῦ, τοῦ",{"noteId":208},"Φάλεγ, τοῦ Ἑβέρ, τοῦ Σαλά,"]},{"type":"verse","number":36,"content":["τοῦ",{"noteId":209},"Καϊνάν, τοῦ Ἀρφαξάδ, τοῦ Σήμ, τοῦ Νῶε, τοῦ Λάμεχ,"]},{"type":"verse","number":37,"content":["τοῦ Μαθουσάλα, τοῦ Ἐνώχ, τοῦ",{"noteId":210},"Ἰαρέδ, τοῦ Μαλελεήλ, τοῦ",{"noteId":211},"Καϊνάν,"]},{"type":"verse","number":38,"content":["τοῦ Ἐνώς, 