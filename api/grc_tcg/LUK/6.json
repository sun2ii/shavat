{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"LUK","translationId":"grc_tcg","name":"ΚΑΤΑ ΛΟΥΚΑΝ","commonName":"ΚΑΤΑ ΛΟΥΚΑΝ","title":"ΚΑΤΑ ΛΟΥΚΑΝ","order":42,"numberOfChapters":24,"sha256":"b8609ef71fdab51fb2a2ec7abf4402d02f5094e9b75db2d2aa00fac79cfd4207","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/grc_tcg/LUK/24.json","totalNumberOfVerses":1150},"chapter":{"number":6,"content":[{"type":"heading","content":["Jesus Is Lord of the Sabbath"]},{"type":"verse","number":1,"content":["Ἐγένετο δὲ ἐν σαββάτῳ",{"noteId":339},"δευτεροπρώτῳ διαπορεύεσθαι αὐτὸν διὰ",{"noteId":340},"τῶν σπορίμων· καὶ ἔτιλλον οἱ μαθηταὶ αὐτοῦ",{"noteId":341},"τοὺς στάχυας, καὶ ἤσθιον, ψώχοντες ταῖς χερσί."]},{"type":"verse","number":2,"content":["Τινὲς δὲ τῶν Φαρισαίων",{"noteId":342},"εἶπον",{"noteId":343},"αὐτοῖς, Τί ποιεῖτε ὃ οὐκ ἔξεστι",{"noteId":344},"ποιεῖν ἐν τοῖς σάββασι;"]},{"type":"verse","number":3,"content":["Καὶ ἀποκριθεὶς πρὸς αὐτοὺς εἶπεν ὁ Ἰησοῦς,",{"text":"Οὐδὲ τοῦτο ἀνέγνωτε, ὃ ἐποίησε","wordsOfJesus":true},{"noteId":345},{"text":"Δαυίδ,","wordsOfJesus":true},{"noteId":346},{"text":"ὁπότε ἐπείνασεν αὐτὸς καὶ οἱ μετ᾽ αὐτοῦ","wordsOfJesus":true},{"noteId":347},{"text":"ὄντες;","wordsOfJesus":true}]},{"type":"verse","number":4,"content":[{"text":"Ὡς εἰσῆλθεν εἰς τὸν οἶκον τοῦ Θεοῦ, καὶ τοὺς ἄρτους τῆς προθέσεως","wordsOfJesus":true},{"noteId":348},{"text":"ἔλαβε, καὶ ἔφαγε, καὶ ἔδωκε","wordsOfJesus":true},{"noteId":349},{"text":"καὶ τοῖς μετ᾽ αὐτοῦ, οὓς οὐκ ἔξεστι φαγεῖν εἰ μὴ μόνους τοὺς ἱερεῖς;","wordsOfJesus":true}]},{"type":"verse","number":5,"content":["Καὶ ἔλεγεν αὐτοῖς",{"noteId":350},"ὅτι",{"text":"Κύριός ἐστιν","wordsOfJesus":true},{"noteId":351},{"text":"ὁ υἱὸς τοῦ ἀνθρώπου καὶ τοῦ σαββάτου.","wordsOfJesus":true}]},{"type":"heading","content":["Jesus Heals a Man with a Withered Hand"]},{"type":"verse","number":6,"content":["Ἐγένετο δὲ",{"noteId":352},"καὶ ἐν ἑτέρῳ σαββάτῳ εἰσελθεῖν αὐτὸν εἰς τὴν συναγωγὴν καὶ διδάσκειν· καὶ ἦν",{"noteId":353},"ἐκεῖ ἄνθρωπος, καὶ ἡ χεὶρ αὐτοῦ ἡ δεξιὰ ἦν ξηρά."]},{"type":"verse","number":7,"content":[{"noteId":354},"Παρετήρουν",{"noteId":355},"δὲ οἱ γραμματεῖς καὶ οἱ Φαρισαῖοι, εἰ",{"noteId":356},"ἐν τῷ σαββάτῳ",{"noteId":357},"θεραπεύσει· ἵνα εὕρωσι",{"noteId":358},"κατηγορίαν αὐτοῦ."]},{"type":"verse","number":8,"content":["Αὐτὸς δὲ ᾔδει τοὺς διαλογισμοὺς αὐτῶν,",{"noteId":359},"καὶ εἶπε τῷ",{"noteId":360},"ἀνθρώπῳ τῷ ξηρὰν ἔχοντι τὴν χεῖρα,",{"noteId":361},{"text":"Ἔγειραι, καὶ στῆθι εἰς τὸ μέσον.","wordsOfJesus":true},{"noteId":362},"Ὁ δὲ ἀναστὰς ἔστη."]},{"type":"verse","number":9,"content":["Εἶπεν",{"noteId":363},"οὖν ὁ Ἰησοῦς πρὸς αὐτούς,",{"noteId":364},{"text":"Ἐπερωτήσω ὑμᾶς","wordsOfJesus":true},{"noteId":365},{"text":"τι, Ἔξεστι","wordsOfJesus":true},{"noteId":366},{"text":"τοῖς σάββασιν ἀγαθοποιῆσαι ἢ κακοποιῆσαι; Ψυχὴν σῶσαι ἢ","wordsOfJesus":true},{"noteId":367},{"text":"ἀποκτεῖναι;","wordsOfJesus":true}]},{"type":"verse","number":10,"content":["Καὶ περιβλεψάμενος πάντας αὐτούς, εἶπεν",{"noteId":368},"αὐτῷ,",{"text":"Ἔκτεινον τὴν χεῖρά σου.","wordsOfJesus":true},"Ὁ δὲ",{"noteId":369},"ἐποίησε καὶ",{"noteId":370},"ἀποκατεστάθη ἡ χεὶρ αὐτοῦ",{"noteId":371},"ὑγιὴς ὡς ἡ ἄλλη."]},{"type":"verse","number":11,"content":["Αὐτοὶ δὲ ἐπλήσθησαν ἀνοίας· καὶ διελάλουν πρὸς ἀλλήλους, τί ἂν",{"noteId":372},"ποιήσειαν τῷ Ἰησοῦ."]},{"type":"heading","content":["The Twelve Apostles"]},{"type":"verse","number":12,"content":["Ἐγένετο δὲ ἐν ταῖς ἡμέραις ταύταις",{"noteId":373},"ἐξῆλθεν εἰς τὸ ὄρος προσεύξασθαι· καὶ ἦν διανυκτερεύων ἐν τῇ προσευχῇ τοῦ Θεοῦ."]},{"type":"verse","number":13,"content":["Καὶ ὅτε ἐγένετο ἡμέρα, προσεφώνησε τοὺς μαθητὰς αὐτοῦ· καὶ ἐκλεξάμενος ἀπ᾽ αὐτῶν δώδεκα, οὓς καὶ ἀποστόλους ὠνόμασε,"]},{"type":"verse","number":14,"content":["Σίμωνα ὃν καὶ ὠνόμασε Πέτρον, καὶ Ἀνδρέαν τὸν ἀδελφὸν αὐτοῦ,",{"noteId":374},"Ἰάκωβον καὶ",{"noteId":375},"Ἰωάννην,",{"noteId":376},"Φίλιππον καὶ Βαρθολομαῖον,"]},{"type":"verse","number":15,"content":[{"noteId":377},"Ματθαῖον καὶ Θωμᾶν,",{"noteId":378},"Ἰάκωβον",{"noteId":379},"τὸν τοῦ Ἁλφαίου, καὶ Σίμωνα τὸν καλούμενον Ζηλωτήν,"]},{"type":"verse","number":16,"content":[{"noteId":380},"Ἰούδαν Ἰακώβου, καὶ Ἰούδαν",{"noteId":381},"Ἰσκαριώτην, ὃς",{"noteId":382},"καὶ ἐγένετο προδότης."]},{"type":"heading","content":["Jesus Ministers to Great Crowds"]},{"type":"verse","number":17,"content":["Καὶ καταβὰς μετ᾽ αὐτῶν, ἔστη ἐπὶ τόπου πεδινοῦ, καὶ",{"noteId":383},"ὄχλος μαθητῶν αὐτοῦ, καὶ πλῆθος πολὺ τοῦ λαοῦ ἀπὸ πάσης τῆς Ἰουδαίας καὶ Ἱερουσαλήμ, καὶ τῆς παραλίου Τύρου καὶ",{"noteId":384},"Σιδῶνος, οἳ",{"noteId":385},"ἦλθον ἀκοῦσαι αὐτοῦ, καὶ ἰαθῆναι ἀπὸ τῶν νόσων αὐτῶν·"]},{"type":"verse","number":18,"content":["καὶ οἱ",{"noteId":386},"ὀχλούμενοι",{"noteId":387},"ὑπὸ πνευμάτων ἀκαθάρτων,",{"noteId":388},"καὶ ἐθεραπεύοντο."]},{"type":"verse","number":19,"content":["Καὶ πᾶς ὁ ὄχλος",{"noteId":389},"ἐζήτει ἅπτεσθαι αὐτοῦ· ὅτι δύναμις παρ᾽ αὐτοῦ ἐξήρχετο καὶ ἰᾶτο πάντας."]},{"type":"heading","content":["The Beatitudes"]},{"type":"verse","number":20,"content":["Καὶ αὐτὸς ἐπάρας τοὺς ὀφθαλμοὺς αὐτοῦ εἰς τοὺς μαθητὰς αὐτοῦ ἔλεγε,",{"lineBreak":true},{"text":"Μακάριοι οἱ πτωχοί,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"ὅτι ὑμετέρα ἐστὶν ἡ βασιλεία τοῦ Θεοῦ.","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Μακάριοι οἱ πεινῶντες νῦν,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"ὅτι χορτασθήσεσθε.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Μακάριοι οἱ κλαίοντες νῦν,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"ὅτι γελάσετε.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Μακάριοί ἐστε, ὅταν","wordsOfJesus":true},{"noteId":390},{"text":"μισήσωσιν ὑμᾶς οἱ ἄνθρωποι, καὶ ὅταν ἀφορίσωσιν ὑμᾶς, καὶ ὀνειδίσωσι, καὶ ἐκβάλωσι τὸ ὄνομα ὑμῶν ὡς πονηρόν, ἕνεκα τοῦ υἱοῦ τοῦ ἀνθρώπου.","wordsOfJesus":true}]},{"type":"verse","number":23,"content":[{"noteId":391},{"text":"Χάρητε ἐν ἐκείνῃ τῇ ἡμέρᾳ καὶ σκιρτήσατε· ἰδοὺ γάρ, ὁ μισθὸς ὑμῶν πολὺς ἐν τῷ οὐρανῷ· κατὰ","wordsOfJesus":true},{"noteId":392},{"text":"ταῦτα γὰρ ἐποίουν τοῖς προφήταις οἱ πατέρες αὐτῶν.","wordsOfJesus":true}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Πλὴν οὐαὶ ὑμῖν τοῖς πλουσίοις,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"ὅτι ἀπέχετε τὴν παράκλησιν ὑμῶν.","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Οὐαὶ ὑμῖν, οἱ","wordsOfJesus":true,"poem":1},{"noteId":393},{"text":"ἐμπεπλησμένοι,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"ὅτι πεινάσετε.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Οὐαὶ","wordsOfJesus":true,"poem":1},{"noteId":394},{"text":"ὑμῖν, οἱ γελῶντες νῦν,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"ὅτι πενθήσετε καὶ κλαύσετε.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"noteId":395},{"text":"Οὐαὶ ὅταν","wordsOfJesus":true},{"noteId":396},{"text":"καλῶς ὑμᾶς εἴπωσιν","wordsOfJesus":true},{"noteId":397},{"text":"οἱ ἄνθρωποι· κατὰ","wordsOfJesus":true},{"noteId":398},{"text":"ταῦτα γὰρ ἐποίουν τοῖς ψευδοπροφήταις οἱ πατέρες αὐτῶν.","wordsOfJesus":true}]},{"type":"heading","content":["Love for Enemies"]},{"type":"verse","number":27,"content":[{"noteId":399},{"text":"Ἀλλ᾽ ὑμῖν λέγω τοῖς ἀκούουσιν, Ἀγαπᾶτε τοὺς ἐχθροὺς ὑμῶν, καλῶς ποιεῖτε τοῖς","wordsOfJesus":true},{"noteId":400},{"text":"μισοῦσιν ὑμᾶς,","wordsOfJesus":true}]},{"type":"verse","number":28,"content":[{"text":"εὐλογεῖτε τοὺς καταρωμένους","wordsOfJesus":true},{"noteId":401},{"text":"ὑμῖν,","wordsOfJesus":true},{"noteId":402},{"text":"προσεύχεσθε","wordsOfJesus":true},{"noteId":403},{"text":"ὑπὲρ τῶν ἐπηρεαζόντων ὑμᾶς.","wordsOfJesus":true}]},{"type":"verse","number":29,"content":[{"text":"Τῷ τύπτοντί σε ἐπὶ τὴν σιαγόνα, πάρεχε καὶ τὴν ἄλλην· καὶ ἀπὸ τοῦ αἴροντός σου τὸ ἱμάτιον, καὶ τὸν χιτῶνα μὴ κωλύσῃς.","wordsOfJesus":true}]},{"type":"verse","number":30,"content":[{"text":"Παντὶ","wordsOfJesus":true},{"noteId":404},{"text":"δὲ τῷ αἰτοῦντί σε δίδου· καὶ ἀπὸ τοῦ αἴροντος τὰ σὰ μὴ ἀπαίτει.","wordsOfJesus":true}]},{"type":"verse","number":31,"content":[{"text":"Καὶ καθὼς θέλετε ἵνα ποιῶσιν ὑμῖν οἱ ἄνθρωποι,","wordsOfJesus":true},{"noteId":405},{"text":"καὶ ὑμεῖς ποιεῖτε αὐτοῖς ὁμοίως.","wordsOfJesus":true}]},{"type":"verse","number":32,"content":[{"text":"Καὶ εἰ ἀγαπᾶτε τοὺς ἀγαπῶντας ὑμᾶς, ποία ὑμῖν χάρις ἐστί; Καὶ γὰρ οἱ ἁμαρτωλοὶ τοὺς ἀγαπῶντας αὐτοὺς ἀγαπῶσι.","wordsOfJesus":true}]},{"type":"verse","number":33,"content":[{"noteId":406},{"text":"Καὶ ἐὰν ἀγαθοποιῆτε τοὺς ἀγαθοποιοῦντας ὑμᾶς, ποία ὑμῖν χάρις ἐστί; Καὶ","wordsOfJesus":true},{"noteId":407},{"text":"γὰρ οἱ ἁμαρτωλοὶ τὸ αὐτὸ ποιοῦσι.","wordsOfJesus":true}]},{"type":"verse","number":34,"content":[{"text":"Καὶ ἐὰν","wordsOfJesus":true},{"noteId":408},{"text":"δανείζητε παρ᾽ ὧν","wordsOfJesus":true},{"noteId":409},{"text":"ἐλπίζετε","wordsOfJesus":true},{"noteId":410},{"text":"ἀπολαβεῖν, ποία ὑμῖν χάρις ἐστί; Καὶ","wordsOfJesus":true},{"noteId":411},{"text":"γὰρ","wordsOfJesus":true},{"noteId":412},{"text":"ἁμαρτωλοὶ ἁμαρτωλοῖς","wordsOfJesus":true},{"noteId":413},{"text":"δανείζουσιν, ἵνα ἀπολάβωσι τὰ ἴσα.","wordsOfJesus":true}]},{"type":"verse","number":35,"content":[{"text":"Πλὴν ἀγαπᾶτε τοὺς ἐχθροὺς ὑμῶν, καὶ ἀγαθοποιεῖτε, καὶ","wordsOfJesus":true},{"noteId":414},{"text":"δανείζετε, μηδὲν ἀπελπίζοντες· καὶ ἔσται ὁ μισθὸς ὑμῶν πολύς, καὶ ἔσεσθε υἱοὶ","wordsOfJesus":true},{"noteId":415},{"text":"ὑψίστου· ὅτι αὐτὸς χρηστός ἐστιν ἐπὶ τοὺς ἀχαρίστους καὶ πονηρούς.","wordsOfJesus":true}]},{"type":"verse","number":36,"content":[{"noteId":416},{"text":"Γίνεσθε","wordsOfJesus":true},{"noteId":417},{"text":"οὖν","wordsOfJesus":true},{"noteId":418},{"text":"οἰκτίρμονες, καθὼς","wordsOfJesus":true},{"noteId":419},{"text":"καὶ ὁ πατὴρ ὑμῶν","wordsOfJesus":true},{"noteId":420},{"text":"οἰκτίρμων ἐστί.","wordsOfJesus":true}]},{"type":"heading","content":["Judging Others"]},{"type":"verse","number":37,"content":[{"noteId":421},{"text":"Καὶ μὴ κρίνετε, καὶ οὐ μὴ κριθῆτε.","wordsOfJesus":true},{"noteId":422},{"text":"Μὴ καταδικάζετε, καὶ οὐ μὴ καταδικασθῆτε· ἀπολύετε, καὶ ἀπολυθήσεσθε·","wordsOfJesus":true}]},{"type":"verse","number":38,"content":[{"text":"δίδοτε, καὶ δοθήσεται ὑμῖν· μέτρον καλόν, πεπιεσμένον","wordsOfJesus":true},{"noteId":423},{"text":"καὶ σεσαλευμένον","wordsOfJesus":true},{"noteId":424},{"text":"καὶ","wordsOfJesus":true},{"noteId":425},{"text":"ὑπερεκχυνόμενον δώσουσιν εἰς τὸν κόλπον ὑμῶν.","wordsOfJesus":true},{"noteId":426},{"text":"Τῷ γὰρ αὐτῷ μέτρῳ ᾧ μετρεῖτε ἀντιμετρηθήσεται ὑμῖν.","wordsOfJesus":true}]},{"type":"verse","number":39,"content":["Εἶπε",{"noteId":427},"δὲ παραβολὴν αὐτοῖς,",{"text":"Μήτι δύναται τυφλὸς τυφλὸν ὁδηγεῖν; Οὐχὶ ἀμφότεροι εἰς βόθυνον","wordsOfJesus":true},{"noteId":428},{"text":"πεσοῦνται;","wordsOfJesus":true}]},{"type":"verse","number":40,"content":[{"text":"Οὐκ ἔστι μαθητὴς ὑπὲρ τὸν διδάσκαλον","wordsOfJesus":true},{"noteId":429},{"text":"αὐτοῦ· κατηρτισμένος δὲ πᾶς ἔσται ὡς ὁ διδάσκαλος αὐτοῦ.","wordsOfJesus":true}]},{"type":"verse","number":41,"content":[{"text":"Τί δὲ βλέπεις τὸ κάρφος τὸ ἐν τῷ ὀφθαλμῷ τοῦ ἀδελφοῦ σου, τὴν δὲ δοκὸν τὴν ἐν τῷ ἰδίῳ ὀφθαλμῷ οὐ κατανοεῖς;","wordsOfJesus":true}]},{"type":"verse","number":42,"content":[{"noteId":430},{"text":"Ἢ πῶς δύνασαι λέγειν τῷ ἀδελφῷ σου, Ἀδελφέ, ἄφες ἐκβάλω τὸ κάρφος τὸ ἐν τῷ ὀφθαλμῷ σου, αὐτὸς τὴν ἐν τῷ ὀφθαλμῷ σου δοκὸν οὐ βλέπων; Ὑποκριτά, ἔκβαλε πρῶτον τὴν δοκὸν ἐκ τοῦ ὀφθαλμοῦ σου, καὶ τότε διαβλέψεις","wordsOfJesus":true},{"noteId":431},{"text":"ἐκβαλεῖν τὸ κάρφος τὸ ἐν τῷ ὀφθαλμῷ τοῦ ἀδελφοῦ σου.","wordsOfJesus":true}]},{"type":"heading","content":["A Tree Is Known by Its Fruit"]},{"type":"verse","number":43,"content":[{"text":"Οὐ γάρ ἐστι δένδρον καλὸν ποιοῦν καρπὸν σαπρόν·","wordsOfJesus":true},{"noteId":432},{"text":"οὐδὲ δένδρον σαπρὸν ποιοῦν καρπὸν καλόν.","wordsOfJesus":true}]},{"type":"verse","number":44,"content":[{"text":"Ἕκαστον γὰρ δένδρον ἐκ τοῦ ἰδίου καρποῦ","wordsOfJesus":true},{"noteId":433},{"text":"γινώσκεται. Οὐ γὰρ ἐξ ἀκανθῶν συλλέγουσι σῦκα, οὐδὲ ἐκ βάτου","wordsOfJesus":true},{"noteId":434},{"text":"τρυγῶσι σταφυλήν.","wordsOfJesus":true}]},{"type":"verse","number":45,"content":[{"text":"Ὁ ἀγαθὸς ἄνθρωπος ἐκ τοῦ ἀγαθοῦ θησαυροῦ τῆς καρδίας","wordsOfJesus":true},{"noteId":435},{"text":"αὐτοῦ προφέρει τὸ ἀγαθόν, καὶ ὁ πονηρὸς","wordsOfJesus":true},{"noteId":436},{"text":"ἄνθρωπος ἐκ τοῦ πονηροῦ","wordsOfJesus":true},{"noteId":437},{"text":"θησαυροῦ τῆς καρδίας αὐτοῦ προφέρει τὸ πονηρόν· ἐκ γὰρ","wordsOfJesus":true},{"noteId":438},{"text":"τοῦ περισσεύματος τῆς καρδίας λαλεῖ τὸ στόμα αὐτοῦ.","wordsOfJesus":true}]},{"type":"heading","content":["The Two Foundations"]},{"type":"verse","number":46,"content":[{"text":"Τί δέ με καλεῖτε, Κύριε, Κύριε, καὶ οὐ ποιεῖτε ἃ λέγω;","wordsOfJesus":true}]},{"type":"verse","number":47,"content":[{"text":"Πᾶς ὁ ἐρχόμενος πρός με καὶ ἀκούων μου τῶν λόγων καὶ ποιῶν αὐτούς, ὑποδείξω ὑμῖν τίνι ἐστὶν ὅμοιος·","wordsOfJesus":true}]},{"type":"verse","number":48,"content":[{"text":"ὅμοιός ἐστιν ἀνθρώπῳ οἰκοδομοῦντι οἰκίαν,","wordsOfJesus":true},{"noteId":439},{"text":"ὃς ἔσκαψε καὶ ἐβάθυνε, καὶ ἔθηκε θεμέλιον ἐπὶ τὴν πέτραν·","wordsOfJesus":true},{"noteId":440},{"text":"πλημμύρας δὲ γενομένης,","wordsOfJesus":true},{"noteId":441},{"text":"προσέρρηξεν ὁ ποταμὸς τῇ οἰκίᾳ ἐκείνῃ, καὶ οὐκ ἴσχυσε σαλεῦσαι αὐτήν·","wordsOfJesus":true},{"noteId":442},{"text":"τεθεμελίωτο γὰρ ἐπὶ τὴν πέτραν.","wordsOfJesus":true}]},{"type":"verse","number":49,"content":[{"text":"Ὁ δὲ ἀκούσας καὶ μὴ ποιήσας ὅμοιός ἐστιν ἀνθρώπῳ οἰκοδομήσαντι","wordsOfJesus":true},{"noteId":443},{"text":"οἰκίαν ἐπὶ τὴν γῆν χωρὶς θεμελίου· ᾗ","wordsOfJesus":true},{"noteId":444},{"text":"προσέρρηξεν ὁ ποταμός, καὶ","wordsOfJesus":true},{"noteId":445},{"text":"εὐθέως","wordsOfJesus":true},{"noteId":446},{"text":"ἔπεσε, καὶ ἐγένετο τὸ ῥῆγμα τῆς οἰκίας ἐκείνης μέγα.","wordsOfJesus":true}]}],"footnotes":[{"noteId":339,"caller":"+","text":"δευτεροπρωτω 91.1% ¦ δευτερω πρωτω MSS 5.7% ¦ — CT 1.6%","reference":{"chapter":6,"verse":1}},{"noteId":340,"caller":"+","text":"των ¦ — CT","reference":{"chapter":6,"verse":1}},{"noteId":341,"caller":"+","text":"τους σταχυας και ησθιον ¦ και ησθιον τους σταχυας CT","reference":{"chapter":6,"verse":1}},{"noteId":342,"caller":"+","text":"ειπον ¦ ειπαν NA SBL WH","reference":{"chapter":6,"verse":2}},{"noteId":343,"caller":"+","text":"αυτοις ¦ — CT","reference":{"chapter":6,"verse":2}},{"noteId":344,"caller":"+","text":"ποιειν εν ¦ — CT","reference":{"chapter":6,"verse":2}},{"noteId":345,"caller":"+","text":"δαυιδ ¦ δαβιδ HF TR ¦ δαυειδ TH WH","reference":{"chapter":6,"verse":3}},{"noteId":346,"caller":"+","text":"οποτε ¦ οτε NA TH WH","reference":{"chapter":6,"verse":3}},{"noteId":347,"caller":"+","text":"οντες ¦ — TH WH","reference":{"chapter":6,"verse":3}},{"noteId":348,"caller":"+","text":"ελαβε και ¦ λαβων CT","reference":{"chapter":6,"verse":4}},{"noteId":349,"caller":"+","text":"και ¦ — CT","reference":{"chapter":6,"verse":4}},{"noteId":350,"caller":"+","text":"οτι ¦ — CT","reference":{"chapter":6,"verse":5}},{"noteId":351,"caller":"+","text":"ο υιος του ανθρωπου και του σαββατου ¦ του σαββατου ο υιος του ανθρωπου CT","reference":{"chapt