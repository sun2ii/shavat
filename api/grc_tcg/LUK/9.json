{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"LUK","translationId":"grc_tcg","name":"ΚΑΤΑ ΛΟΥΚΑΝ","commonName":"ΚΑΤΑ ΛΟΥΚΑΝ","title":"ΚΑΤΑ ΛΟΥΚΑΝ","order":42,"numberOfChapters":24,"sha256":"b8609ef71fdab51fb2a2ec7abf4402d02f5094e9b75db2d2aa00fac79cfd4207","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/grc_tcg/LUK/24.json","totalNumberOfVerses":1150},"chapter":{"number":9,"content":[{"type":"heading","content":["Jesus Sends Out the Twelve Apostles"]},{"type":"verse","number":1,"content":[{"noteId":611},"Συγκαλεσάμενος δὲ τοὺς",{"noteId":612},"δώδεκα, ἔδωκεν αὐτοῖς δύναμιν καὶ ἐξουσίαν ἐπὶ πάντα τὰ δαιμόνια, καὶ νόσους θεραπεύειν."]},{"type":"verse","number":2,"content":["Καὶ ἀπέστειλεν αὐτοὺς κηρύσσειν τὴν βασιλείαν τοῦ Θεοῦ, καὶ ἰᾶσθαι",{"noteId":613},"τοὺς ἀσθενοῦντας."]},{"type":"verse","number":3,"content":["Καὶ εἶπε πρὸς αὐτούς,",{"text":"Μηδὲν αἴρετε εἰς τὴν ὁδόν· μήτε","wordsOfJesus":true},{"noteId":614},{"text":"ῥάβδους, μήτε πήραν, μήτε ἄρτον, μήτε ἀργύριον, μήτε","wordsOfJesus":true},{"noteId":615},{"text":"ἀνὰ δύο χιτῶνας ἔχειν.","wordsOfJesus":true}]},{"type":"verse","number":4,"content":[{"text":"Καὶ εἰς ἣν","wordsOfJesus":true},{"noteId":616},{"text":"ἂν οἰκίαν εἰσέλθητε, ἐκεῖ μένετε, καὶ ἐκεῖθεν ἐξέρχεσθε.","wordsOfJesus":true}]},{"type":"verse","number":5,"content":[{"text":"Καὶ ὅσοι","wordsOfJesus":true},{"noteId":617},{"text":"ἐὰν μὴ","wordsOfJesus":true},{"noteId":618},{"text":"δέξωνται ὑμᾶς, ἐξερχόμενοι ἀπὸ τῆς πόλεως ἐκείνης","wordsOfJesus":true},{"noteId":619},{"text":"καὶ τὸν κονιορτὸν ἀπὸ τῶν ποδῶν ὑμῶν","wordsOfJesus":true},{"noteId":620},{"text":"ἀποτινάξατε εἰς μαρτύριον ἐπ᾽ αὐτούς.","wordsOfJesus":true}]},{"type":"verse","number":6,"content":["Ἐξερχόμενοι δὲ διήρχοντο κατὰ τὰς κώμας, εὐαγγελιζόμενοι καὶ θεραπεύοντες πανταχοῦ."]},{"type":"heading","content":["Herod is Perplexed About Jesus"]},{"type":"verse","number":7,"content":["Ἤκουσε δὲ Ἡρῴδης ὁ",{"noteId":621},"τετράρχης τὰ",{"noteId":622},"γινόμενα",{"noteId":623},"ὑπ᾽ αὐτοῦ πάντα· καὶ διηπόρει, διὰ τὸ λέγεσθαι ὑπό τινων ὅτι",{"noteId":624},"Ἰωάννης",{"noteId":625},"ἐγήγερται ἐκ",{"noteId":626},"νεκρῶν·"]},{"type":"verse","number":8,"content":["ὑπό τινων δὲ ὅτι",{"noteId":627},"Ἠλίας ἐφάνη· ἄλλων δὲ ὅτι Προφήτης",{"noteId":628},"εἷς τῶν ἀρχαίων ἀνέστη."]},{"type":"verse","number":9,"content":[{"noteId":629},"Καὶ εἶπεν",{"noteId":630},"Ἡρῴδης,",{"noteId":631},"Ἰωάννην ἐγὼ ἀπεκεφάλισα· τίς δέ ἐστιν οὗτος, περὶ οὗ",{"noteId":632},"ἐγὼ ἀκούω τοιαῦτα; Καὶ ἐζήτει ἰδεῖν αὐτόν."]},{"type":"heading","content":["The Feeding of the Five Thousand"]},{"type":"verse","number":10,"content":["Καὶ ὑποστρέψαντες οἱ ἀπόστολοι διηγήσαντο αὐτῷ ὅσα ἐποίησαν. Καὶ παραλαβὼν αὐτούς, ὑπεχώρησε κατ᾽ ἰδίαν εἰς",{"noteId":633},"τόπον ἔρημον πόλεως καλουμένης",{"noteId":634},"Βηθσαϊδάν."]},{"type":"verse","number":11,"content":["Οἱ δὲ ὄχλοι γνόντες ἠκολούθησαν αὐτῷ· καὶ",{"noteId":635},"δεξάμενος αὐτούς, ἐλάλει αὐτοῖς περὶ τῆς βασιλείας τοῦ Θεοῦ, καὶ τοὺς χρείαν ἔχοντας θεραπείας",{"noteId":636},"ἰᾶτο."]},{"type":"verse","number":12,"content":["Ἡ δὲ ἡμέρα ἤρξατο",{"noteId":637},"κλίνειν· προσελθόντες δὲ οἱ δώδεκα",{"noteId":638},"εἶπον αὐτῷ, Ἀπόλυσον τὸν ὄχλον, ἵνα",{"noteId":639},"ἀπελθόντες εἰς τὰς κύκλῳ κώμας καὶ",{"noteId":640},"τοὺς ἀγροὺς καταλύσωσι, καὶ εὕρωσιν ἐπισιτισμόν· ὅτι ὧδε ἐν ἐρήμῳ τόπῳ ἐσμέν."]},{"type":"verse","number":13,"content":["Εἶπε δὲ πρὸς αὐτούς,",{"text":"Δότε αὐτοῖς","wordsOfJesus":true},{"noteId":641},{"text":"ὑμεῖς φαγεῖν.","wordsOfJesus":true},"Οἱ δὲ",{"noteId":642},"εἶπον, Οὐκ εἰσὶν ἡμῖν πλεῖον ἢ",{"noteId":643},"πέντε ἄρτοι καὶ",{"noteId":644},"ἰχθύες δύο, εἰ μήτι πορευθέντες ἡμεῖς",{"noteId":645},"ἀγοράσωμεν εἰς πάντα τὸν λαὸν τοῦτον βρώματα."]},{"type":"verse","number":14,"content":["Ἦσαν γὰρ ὡσεὶ ἄνδρες",{"noteId":646},"πεντακισχίλιοι. Εἶπε δὲ πρὸς τοὺς μαθητὰς αὐτοῦ,",{"text":"Κατακλίνατε αὐτοὺς κλισίας","wordsOfJesus":true},{"noteId":647},{"text":"ἀνὰ πεντήκοντα.","wordsOfJesus":true}]},{"type":"verse","number":15,"content":["Καὶ ἐποίησαν οὕτω, καὶ",{"noteId":648},"ἀνέκλιναν ἅπαντας."]},{"type":"verse","number":16,"content":["Λαβὼν δὲ τοὺς πέντε ἄρτους καὶ τοὺς δύο ἰχθύας, ἀναβλέψας εἰς τὸν οὐρανόν, εὐλόγησεν αὐτούς, καὶ κατέκλασε, καὶ ἐδίδου τοῖς μαθηταῖς",{"noteId":649},"παρατιθέναι τῷ ὄχλῳ."]},{"type":"verse","number":17,"content":["Καὶ ἔφαγον καὶ ἐχορτάσθησαν πάντες· καὶ ἤρθη τὸ περισσεῦσαν αὐτοῖς κλασμάτων, κόφινοι δώδεκα."]},{"type":"heading","content":["Peter Declares That Jesus Is the Christ"]},{"type":"verse","number":18,"content":["Καὶ ἐγένετο ἐν τῷ εἶναι αὐτὸν προσευχόμενον καταμόνας, συνῆσαν αὐτῷ οἱ μαθηταί· καὶ ἐπηρώτησεν αὐτούς, λέγων,",{"text":"Τίνα με","wordsOfJesus":true},{"noteId":650},{"text":"λέγουσιν οἱ ὄχλοι εἶναι;","wordsOfJesus":true}]},{"type":"verse","number":19,"content":["Οἱ δὲ ἀποκριθέντες",{"noteId":651},"εἶπον,",{"noteId":652},"Ἰωάννην τὸν βαπτιστήν· ἄλλοι δὲ",{"noteId":653},"Ἠλίαν· ἄλλοι δὲ ὅτι Προφήτης τις τῶν ἀρχαίων ἀνέστη."]},{"type":"verse","number":20,"content":["Εἶπε δὲ αὐτοῖς,",{"text":"Ὑμεῖς δὲ τίνα με λέγετε εἶναι;","wordsOfJesus":true},{"noteId":654},"Ἀποκριθεὶς δὲ ὁ Πέτρος εἶπε, Τὸν Χριστὸν τοῦ Θεοῦ."]},{"type":"heading","content":["Jesus Predicts His Death and Resurrection"]},{"type":"verse","number":21,"content":["Ὁ δὲ ἐπιτιμήσας αὐτοῖς παρήγγειλε μηδενὶ",{"noteId":655},"εἰπεῖν τοῦτο,"]},{"type":"verse","number":22,"content":["εἰπὼν ὅτι",{"text":"Δεῖ τὸν υἱὸν τοῦ ἀνθρώπου πολλὰ παθεῖν, καὶ ἀποδοκιμασθῆναι ἀπὸ τῶν πρεσβυτέρων καὶ ἀρχιερέων καὶ γραμματέων, καὶ ἀποκτανθῆναι, καὶ τῇ τρίτῃ ἡμέρᾳ","wordsOfJesus":true},{"noteId":656},{"text":"ἀναστῆναι.","wordsOfJesus":true}]},{"type":"verse","number":23,"content":["Ἔλεγε δὲ πρὸς πάντας,",{"text":"Εἴ τις θέλει ὀπίσω μου","wordsOfJesus":true},{"noteId":657},{"text":"ἐλθεῖν,","wordsOfJesus":true},{"noteId":658},{"text":"ἀπαρνησάσθω ἑαυτόν, καὶ ἀράτω τὸν σταυρὸν","wordsOfJesus":true},{"noteId":659},{"text":"αὐτοῦ, καὶ ἀκολουθείτω μοι.","wordsOfJesus":true}]},{"type":"verse","number":24,"content":[{"text":"Ὃς γὰρ","wordsOfJesus":true},{"noteId":660},{"text":"ἐὰν θέλῃ τὴν ψυχὴν αὐτοῦ σῶσαι, ἀπολέσει αὐτήν· ὃς δ᾽ ἂν ἀπολέσῃ τὴν ψυχὴν αὐτοῦ ἕνεκεν ἐμοῦ, οὗτος σώσει αὐτήν.","wordsOfJesus":true}]},{"type":"verse","number":25,"content":[{"text":"Τί γὰρ ὠφελεῖται ἄνθρωπος, κερδήσας τὸν κόσμον ὅλον, ἑαυτὸν δὲ ἀπολέσας ἢ ζημιωθείς;","wordsOfJesus":true}]},{"type":"verse","number":26,"content":[{"text":"Ὃς γὰρ","wordsOfJesus":true},{"noteId":661},{"text":"ἂν ἐπαισχυνθῇ με καὶ τοὺς ἐμοὺς λόγους, τοῦτον ὁ υἱὸς τοῦ ἀνθρώπου ἐπαισχυνθήσεται, ὅταν ἔλθῃ ἐν τῇ δόξῃ αὐτοῦ καὶ τοῦ πατρὸς καὶ τῶν ἁγίων ἀγγέλων.","wordsOfJesus":true}]},{"type":"verse","number":27,"content":[{"text":"Λέγω δὲ ὑμῖν ἀληθῶς, εἰσί τινες τῶν","wordsOfJesus":true},{"noteId":662},{"text":"ὧδε","wordsOfJesus":true},{"noteId":663},{"text":"ἑστώτων, οἳ οὐ μὴ","wordsOfJesus":true},{"noteId":664},{"text":"γεύσωνται θανάτου, ἕως ἂν ἴδωσι τὴν βασιλείαν τοῦ Θεοῦ.","wordsOfJesus":true}]},{"type":"heading","content":["The Transfiguration"]},{"type":"verse","number":28,"content":["Ἐγένετο δὲ μετὰ τοὺς λόγους τούτους ὡσεὶ ἡμέραι ὀκτώ,",{"noteId":665},"καὶ παραλαβὼν",{"noteId":666},"Πέτρον καὶ",{"noteId":667},"Ἰωάννην καὶ Ἰάκωβον, ἀνέβη εἰς τὸ ὄρος προσεύξασθαι."]},{"type":"verse","number":29,"content":["Καὶ ἐγένετο, ἐν τῷ προσεύχεσθαι αὐτόν, τὸ εἶδος τοῦ προσώπου αὐτοῦ ἕτερον, καὶ ὁ ἱματισμὸς αὐτοῦ λευκὸς ἐξαστράπτων."]},{"type":"verse","number":30,"content":["Καὶ ἰδού, ἄνδρες δύο συνελάλουν αὐτῷ, οἵτινες ἦσαν",{"noteId":668},"Μωσῆς καὶ",{"noteId":669},"Ἠλίας,"]},{"type":"verse","number":31,"content":["οἳ ὀφθέντες ἐν δόξῃ ἔλεγον τὴν ἔξοδον αὐτοῦ ἣν",{"noteId":670},"ἔμελλε πληροῦν ἐν Ἱερουσαλήμ."]},{"type":"verse","number":32,"content":["Ὁ δὲ Πέτρος καὶ οἱ σὺν αὐτῷ ἦσαν βεβαρημένοι ὕπνῳ· διαγρηγορήσαντες δὲ",{"noteId":671},"εἶδον τὴν δόξαν αὐτοῦ, καὶ τοὺς δύο ἄνδρας τοὺς συνεστῶτας αὐτῷ."]},{"type":"verse","number":33,"content":["Καὶ ἐγένετο, ἐν τῷ διαχωρίζεσθαι αὐτοὺς ἀπ᾽ αὐτοῦ, εἶπε",{"noteId":672},"Πέτρος πρὸς τὸν Ἰησοῦν, Ἐπιστάτα, καλόν ἐστιν ἡμᾶς ὧδε εἶναι· καὶ ποιήσωμεν σκηνὰς τρεῖς, μίαν σοί, καὶ",{"noteId":673},"μίαν Μωσῇ, καὶ μίαν",{"noteId":674},"Ἠλίᾳ· μὴ εἰδὼς ὃ λέγει."]},{"type":"verse","number":34,"content":["Ταῦτα δὲ αὐτοῦ λέγοντος, ἐγένετο νεφέλη καὶ",{"noteId":675},"ἐπεσκίασεν αὐτούς· ἐφοβήθησαν δὲ ἐν τῷ",{"noteId":676},"ἐκείνους εἰσελθεῖν εἰς τὴν νεφέλην."]},{"type":"verse","number":35,"content":["Καὶ φωνὴ ἐγένετο ἐκ τῆς νεφέλης, λέγουσα, Οὗτός ἐστιν ὁ υἱός μου ὁ",{"noteId":677},"ἀγαπητός· αὐτοῦ ἀκούετε."]},{"type":"verse","number":36,"content":["Καὶ ἐν τῷ γενέσθαι τὴν φωνήν, εὑρέθη",{"noteId":678},"ὁ Ἰησοῦς μόνος. Καὶ αὐτοὶ ἐσίγησαν, καὶ οὐδενὶ ἀπήγγειλαν ἐν ἐκείναις ταῖς ἡμέραις οὐδὲν ὧν",{"noteId":679},"ἑωράκασιν."]},{"type":"heading","content":["Jesus Heals a Boy with an Unclean Spirit"]},{"type":"verse","number":37,"content":["Ἐγένετο δὲ",{"noteId":680},"ἐν τῇ ἑξῆς ἡμέρᾳ, κατελθόντων αὐτῶν ἀπὸ τοῦ ὄρους, συνήντησεν αὐτῷ ὄχλος πολύς."]},{"type":"verse","number":38,"content":["Καὶ ἰδού, ἀνὴρ ἀπὸ τοῦ ὄχλου",{"noteId":681},"ἀνεβόησε, λέγων, Διδάσκαλε, δέομαί σου,",{"noteId":682},"ἐπίβλεψαι ἐπὶ τὸν υἱόν μου, ὅτι μονογενής",{"noteId":683},"ἐστί μοι·"]},{"type":"verse","number":39,"content":["καὶ ἰδού, πνεῦμα λαμβάνει αὐτόν, καὶ",{"noteId":684},"ἐξαίφνης κράζει, καὶ σπαράσσει αὐτὸν μετὰ ἀφροῦ, καὶ",{"noteId":685},"μόγις ἀποχωρεῖ ἀπ᾽ αὐτοῦ, συντρῖβον αὐτόν."]},{"type":"verse","number":40,"content":["Καὶ ἐδεήθην τῶν μαθητῶν σου ἵνα",{"noteId":686},"ἐκβάλωσιν αὐτό, καὶ οὐκ ἠδυνήθησαν."]},{"type":"verse","number":41,"content":["Ἀποκριθεὶς δὲ ὁ Ἰησοῦς εἶπεν,",{"text":"Ὦ γενεὰ ἄπιστος καὶ διεστραμμένη, ἕως πότε ἔσομαι πρὸς ὑμᾶς, καὶ ἀνέξομαι ὑμῶν; Προσάγαγε","wordsOfJesus":true},{"noteId":687},{"text":"τὸν υἱόν σου ὧδε.","wordsOfJesus":true}]},{"type":"verse","number":42,"content":["Ἔτι δὲ προσερχομένου αὐτοῦ, ἔρρηξεν αὐτὸν τὸ δαιμόνιον καὶ συνεσπάραξεν· ἐπετίμησε δὲ ὁ Ἰησοῦς τῷ πνεύματι τῷ ἀκαθάρτῳ, καὶ ἰάσατο τὸν παῖδα, καὶ ἀπέδωκεν αὐτὸν τῷ πατρὶ αὐτοῦ."]},{"type":"verse","number":43,"content":["Ἐξεπλήσσοντο δὲ πάντες ἐπὶ τῇ μεγαλειότητι τοῦ Θεοῦ. Jesus Predicts His Death a Second Time Πάντων δὲ θαυμαζόντων ἐπὶ πᾶσιν οἷς",{"noteId":688},"ἐποίησεν ὁ Ἰησοῦς, εἶπε πρὸς τοὺς μαθητὰς αὐτοῦ,"]},{"type":"verse","number":44,"content":[{"text":"Θέσθε ὑμεῖς εἰς τὰ ὦτα ὑμῶν τοὺς λόγους τούτους· ὁ γὰρ υἱὸς τοῦ ἀνθρώπου μέλλει παραδίδοσθαι εἰς χεῖρας ἀνθρώπων.","wordsOfJesus":true}]},{"type":"verse","number":45,"content":["Οἱ δὲ ἠγνόουν τὸ ῥῆμα τοῦτο, καὶ ἦν παρακεκαλυμμένον ἀπ᾽ αὐτῶν, ἵνα μὴ αἴσθωνται αὐτό· καὶ ἐφοβοῦντο ἐρωτῆσαι αὐτὸν περὶ τοῦ ῥήματος τούτου."]},{"type":"heading","content":["True Greatness"]},{"type":"verse","number":46,"content":["Εἰσῆλθε δὲ διαλογισμὸς ἐν αὐτοῖς, τὸ τίς ἂν εἴη μείζων αὐτῶν."]},{"type":"verse","number":47,"content":["Ὁ δὲ Ἰησοῦς",{"noteId":689},"ἰδὼν τὸν διαλογισμὸν τῆς καρδίας αὐτῶν, ἐπιλαβόμενος",{"noteId":690},"παιδίου, ἔστησεν αὐτὸ παρ᾽ ἑαυτῷ,"]},{"type":"verse","number":48,"content":["καὶ εἶπεν αὐτοῖς,",{"text":"Ὃς","wordsOfJesus":true},{"noteId":691},{"text":"ἐὰν δέξηται τοῦτο τὸ παιδίον ἐπὶ τῷ ὀνόματί μου ἐμὲ δέχεται· καὶ ὃς","wordsOfJesus":true},{"noteId":692},{"text":"ἐὰν ἐμὲ δέξηται δέχεται τὸν ἀποστείλαντά με· ὁ γὰρ","wordsOfJesus":true},{"noteId":693},{"text":"μικρότερος ἐν πᾶσιν","wordsOfJesus":true},{"noteId":694},{"text":"ὑμῖν ὑπάρχων οὗτος","wordsOfJesus":true},{"noteId":695},{"text":"ἔσται μέγας.","wordsOfJesus":true}]},{"type":"heading","content":["Whoever Is Not Against Us Is for Us"]},{"type":"verse","number":49,"content":["Ἀποκριθεὶς δὲ",{"noteId":696},"ὁ",{"noteId":697},"Ἰωάννης εἶπεν, Ἐπιστάτα,",{"noteId":698},"εἴδομέν τινα",{"noteId":699},"ἐπὶ τῷ ὀνόματί σου ἐκβάλλοντα",{"noteId":700},"δαιμόνια· καὶ",{"noteId":701},"ἐκωλύσαμεν αὐτόν, ὅτι οὐκ ἀκολουθεῖ μεθ᾽ ἡμῶν."]},{"type":"verse","number":50,"content":[{"noteId":702},"Καὶ εἶπε πρὸς αὐτὸν",{"noteId":703},"ὁ Ἰησοῦς,",{"text":"Μὴ","wordsOfJesus":true},{"noteId":704},{"text":"κωλύετε· ὃς γὰρ οὐκ ἔστι καθ᾽","wordsOfJesus":true},{"noteId":705},{"text":"ἡμῶν ὑπὲρ ἡμῶν ἐστιν.","wordsOfJesus":true}]},{"type":"heading","content":["A Samaritan Village Refuses to Receive Jesus"]},{"type":"verse","number":51,"content":["Ἐγένετο δὲ ἐν τῷ συμπληροῦσθαι τὰς ἡμέρας τῆς",{"noteId":706},"ἀναλήψεως αὐτοῦ, καὶ αὐτὸς",{"noteId":707},"τὸ πρόσωπον αὐτοῦ ἐστήριξε τοῦ πορεύεσθαι εἰς Ἱερουσαλήμ,"]},{"type":"verse","number":52,"content":["καὶ ἀπέστειλεν ἀγγέλους πρὸ προσώπου",{"noteId":708},"αὐτοῦ· καὶ πορευθέντες εἰσῆλθον εἰς κώμην",{"noteId":709},"Σαμαρειτῶν,",{"noteId":710},"ὥστε ἑτοιμάσαι αὐτῷ."]},{"type":"verse","number":53,"content":["Καὶ οὐκ ἐδέξαντο αὐτόν, ὅτι τὸ πρόσωπον αὐτοῦ ἦν πορευόμενον εἰς Ἱερουσαλήμ."]},{"type":"verse","number":54,"content":["Ἰδόντες δὲ οἱ μαθηταὶ",{"noteId":711},"αὐτοῦ Ἰάκωβος καὶ",{"noteId":712},"Ἰωάννης",{"noteId":713},"εἶπον, Κύριε, θέλεις εἴπωμεν πῦρ καταβῆναι ἀπὸ",{"noteId":714},"τοῦ οὐρανοῦ, καὶ ἀναλῶσαι αὐτούς,",{"noteId":715},"ὡς καὶ Ἠλίας ἐποίησε;"]},{"type":"verse","number":55,"content":["Στραφεὶς δὲ ἐπετίμησεν αὐτοῖς,",{"noteId":716},"καὶ εἶπεν,",{"text":"Οὐκ οἴδατε οἵου πνεύματός ἐστε ὑμεῖς·","wordsOfJesus":true}]},{"type":"verse","number":56,"content":[{"noteId":717},{"text":"ὁ γὰρ υἱὸς τοῦ ἀνθρώπου οὐκ ἦλθε ψυχὰς ἀνθρώπων ἀπολέσαι, ἀλλὰ σῶσαι.","wordsOfJesus":true},"Καὶ ἐπορεύθησαν εἰς ἑτέραν κώμην."]},{"type":"heading","content":["Would-Be Followers of Jesus"]},{"type":"verse","number":57,"content":[{"noteId":718},"Ἐγένετο δὲ πορευομένων αὐτῶν ἐν τῇ ὁδῷ, εἶπέ τις πρὸς αὐτόν, Ἀκολουθήσω σοι ὅπου",{"noteId":719},"ἂν ἀπέρχῃ,",{"noteId":720},"Κύριε."]},{"type":"verse","number":58,"content":["Καὶ εἶπεν αὐτῷ ὁ Ἰησοῦς,",{"text":"Αἱ ἀλώπεκες φωλεοὺς ἔχουσι, καὶ τὰ πετεινὰ τοῦ οὐρανοῦ κατασκηνώσεις· ὁ δὲ υἱὸς τοῦ ἀνθρώπου οὐκ ἔχει ποῦ τὴν κεφαλὴν","wordsOfJesus":true},{"noteId":721},{"text":"κλίνῃ.","wordsOfJesus":true}]},{"type":"verse","number":59,"content":["Εἶπε δὲ πρὸς ἕτερον,",{"text":"Ἀκολούθει μοι.","wordsOfJesus":true},"Ὁ δὲ εἶπε,",{"noteId":722},"Κύριε, ἐπίτρεψόν μοι",{"noteId":723},"ἀπελθόντι πρῶτον θάψαι τὸν πατέρα μου."]},{"type":"verse","number":60,"content":["Εἶπε δὲ αὐτῷ",{"noteId":724},"ὁ Ἰησοῦς,",{"text":"Ἄφες τοὺς νεκροὺς θάψαι τοὺς ἑαυτῶν νεκρούς· σὺ δὲ ἀπελθὼν διάγγελλε τὴν βασιλείαν τοῦ Θεοῦ.","wordsOfJesus":true}]},{"type":"verse","number":61,"content":["Εἶπε δὲ καὶ ἕτερος, Ἀκολουθήσω σοι, Κύριε· πρῶτον δὲ ἐπίτρεψόν μοι ἀποτάξασθαι τοῖς εἰς τὸν οἶκόν μου."]},{"type":"verse","number":62,"content":["Εἶπε δὲ",{"noteId":725},"ὁ Ἰησοῦς πρὸς αὐτόν,",{"text":"Οὐδείς, ἐπιβαλὼν τὴν χεῖρα","wordsOfJesus":true},{"noteId":726},{"text":"αὐτοῦ ἐπ᾽ ἄροτρον, καὶ βλέπων εἰς τὰ ὀπίσω, εὔθετός ἐστιν","wordsOfJesus":true},{"noteId":727},{"text":"εἰς τὴν βασιλείαν τοῦ Θεοῦ.","wordsOfJesus":true}]}],"footnotes":[{"noteId":611,"caller":"+","text":"συγκαλεσαμενος ¦ συνκαλεσαμενος WH","reference":{"chapter":9,"verse":1}},{"noteId":612,"caller":"+","text":"δωδεκα ¦ δωδεκα μαθητας αυτου ANT TR","reference":{"chapter":9,"verse":1}},{"noteId":613,"caller":"+","text":"τους ασθενουντας 97.3% ¦ τους ασθενεις NA SBL TH 1.3% ¦ — WH 0.1%","reference":{"chapter":9,"verse":2}},{"noteId":614,"caller":"+","text":"ραβδους ¦ ραβδον CT","reference":{"chapter":9,"verse":3}},{"noteId":615,"caller":"+","text":"ανα 98.9% ¦ — TH WH 1%","reference":{"chapter":9,"verse":3}},{"noteId":616,"caller":"+","text":"αν ¦ — PCK","reference":{"chapter":9,"ver