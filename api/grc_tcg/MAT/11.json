{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"MAT","translationId":"grc_tcg","name":"ΚΑΤΑ ΜΑΤΘΑΙΟΝ","commonName":"ΚΑΤΑ ΜΑΤΘΑΙΟΝ","title":"ΚΑΤΑ ΜΑΤΘΑΙΟΝ","order":40,"numberOfChapters":28,"sha256":"06335047c4ec4dda0ae309f507da1a2504247956d21582d96f042e020e037a3c","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/grc_tcg/MAT/28.json","totalNumberOfVerses":1071},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":["Καὶ ἐγένετο ὅτε ἐτέλεσεν ὁ Ἰησοῦς διατάσσων τοῖς δώδεκα μαθηταῖς αὐτοῦ, μετέβη ἐκεῖθεν τοῦ διδάσκειν καὶ κηρύσσειν ἐν ταῖς πόλεσιν αὐτῶν."]},{"type":"heading","content":["Messengers from John the Baptist"]},{"type":"verse","number":2,"content":["Ὁ δὲ",{"noteId":299},"Ἰωάννης ἀκούσας ἐν τῷ δεσμωτηρίῳ τὰ ἔργα τοῦ Χριστοῦ, πέμψας",{"noteId":300},"δύο τῶν μαθητῶν αὐτοῦ,"]},{"type":"verse","number":3,"content":["εἶπεν αὐτῷ, Σὺ εἶ ὁ ἐρχόμενος, ἢ ἕτερον προσδοκῶμεν;"]},{"type":"verse","number":4,"content":["Καὶ ἀποκριθεὶς ὁ Ἰησοῦς εἶπεν αὐτοῖς,",{"text":"Πορευθέντες ἀπαγγείλατε","wordsOfJesus":true},{"noteId":301},{"text":"Ἰωάννῃ ἃ ἀκούετε καὶ βλέπετε·","wordsOfJesus":true}]},{"type":"verse","number":5,"content":[{"text":"τυφλοὶ ἀναβλέπουσι, καὶ χωλοὶ περιπατοῦσι, λεπροὶ καθαρίζονται, καὶ κωφοὶ ἀκούουσι,","wordsOfJesus":true},{"noteId":302},{"text":"νεκροὶ ἐγείρονται, καὶ πτωχοὶ εὐαγγελίζονται·","wordsOfJesus":true}]},{"type":"verse","number":6,"content":[{"text":"καὶ μακάριός ἐστιν, ὃς","wordsOfJesus":true},{"noteId":303},{"text":"ἐὰν μὴ σκανδαλισθῇ ἐν ἐμοί.","wordsOfJesus":true}]},{"type":"verse","number":7,"content":["Τούτων δὲ πορευομένων, ἤρξατο ὁ Ἰησοῦς λέγειν τοῖς ὄχλοις περὶ",{"noteId":304},"Ἰωάννου,",{"text":"Τί","wordsOfJesus":true},{"noteId":305},{"text":"ἐξήλθετε εἰς τὴν ἔρημον θεάσασθαι; Κάλαμον ὑπὸ ἀνέμου σαλευόμενον;","wordsOfJesus":true}]},{"type":"verse","number":8,"content":[{"text":"Ἀλλὰ τί","wordsOfJesus":true},{"noteId":306},{"text":"ἐξήλθετε ἰδεῖν; Ἄνθρωπον ἐν μαλακοῖς","wordsOfJesus":true},{"noteId":307},{"text":"ἱματίοις ἠμφιεσμένον; Ἰδού, οἱ τὰ μαλακὰ φοροῦντες ἐν τοῖς οἴκοις τῶν","wordsOfJesus":true},{"noteId":308},{"text":"βασιλείων","wordsOfJesus":true},{"noteId":309},{"text":"εἰσίν.","wordsOfJesus":true}]},{"type":"verse","number":9,"content":[{"text":"Ἀλλὰ τί","wordsOfJesus":true},{"noteId":310},{"text":"ἐξήλθετε","wordsOfJesus":true},{"noteId":311},{"text":"ἰδεῖν; Προφήτην; Ναί, λέγω ὑμῖν, καὶ περισσότερον προφήτου.","wordsOfJesus":true}]},{"type":"verse","number":10,"content":[{"text":"Οὗτος","wordsOfJesus":true},{"noteId":312},{"text":"γάρ ἐστι περὶ οὗ γέγραπται,","wordsOfJesus":true},{"lineBreak":true},{"text":"Ἰδού, ἐγὼ ἀποστέλλω τὸν ἄγγελόν μου πρὸ προσώπου σου,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"ὃς κατασκευάσει τὴν ὁδόν σου ἔμπροσθέν σου.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ἀμὴν λέγω ὑμῖν, οὐκ ἐγήγερται ἐν γεννητοῖς γυναικῶν μείζων","wordsOfJesus":true},{"noteId":313},{"text":"Ἰωάννου τοῦ βαπτιστοῦ· ὁ δὲ μικρότερος ἐν τῇ βασιλείᾳ τῶν οὐρανῶν μείζων αὐτοῦ ἐστιν.","wordsOfJesus":true}]},{"type":"verse","number":12,"content":[{"text":"Ἀπὸ δὲ τῶν ἡμερῶν","wordsOfJesus":true},{"noteId":314},{"text":"Ἰωάννου τοῦ βαπτιστοῦ ἕως ἄρτι ἡ βασιλεία τῶν οὐρανῶν βιάζεται, καὶ βιασταὶ ἁρπάζουσιν αὐτήν.","wordsOfJesus":true}]},{"type":"verse","number":13,"content":[{"text":"Πάντες γὰρ οἱ προφῆται καὶ ὁ νόμος ἕως","wordsOfJesus":true},{"noteId":315},{"text":"Ἰωάννου","wordsOfJesus":true},{"noteId":316},{"text":"προεφήτευσαν·","wordsOfJesus":true}]},{"type":"verse","number":14,"content":[{"text":"καὶ εἰ θέλετε δέξασθαι, αὐτός ἐστιν","wordsOfJesus":true},{"noteId":317},{"text":"Ἠλίας ὁ μέλλων ἔρχεσθαι.","wordsOfJesus":true}]},{"type":"verse","number":15,"content":[{"text":"Ὁ ἔχων ὦτα","wordsOfJesus":true},{"noteId":318},{"text":"ἀκούειν ἀκουέτω.","wordsOfJesus":true}]},{"type":"verse","number":16,"content":[{"text":"Τίνι δὲ ὁμοιώσω τὴν γενεὰν ταύτην; Ὁμοία ἐστὶ","wordsOfJesus":true},{"noteId":319},{"text":"παιδίοις","wordsOfJesus":true},{"noteId":320},{"text":"ἐν ἀγοραῖς καθημένοις,","wordsOfJesus":true},{"noteId":321},{"text":"καὶ προσφωνοῦσι τοῖς","wordsOfJesus":true},{"noteId":322},{"text":"ἑταίροις αὐτῶν,","wordsOfJesus":true}]},{"type":"verse","number":17,"content":[{"noteId":323},{"text":"καὶ λέγουσιν,","wordsOfJesus":true},{"lineBreak":true},{"text":"Ηὐλήσαμεν ὑμῖν, καὶ οὐκ ὠρχήσασθε·","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"ἐθρηνήσαμεν","wordsOfJesus":true,"poem":1},{"noteId":324},{"text":"ὑμῖν, καὶ οὐκ ἐκόψασθε.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ἦλθε γὰρ","wordsOfJesus":true},{"noteId":325},{"text":"Ἰωάννης μήτε ἐσθίων μήτε πίνων, καὶ λέγουσι, Δαιμόνιον ἔχει.","wordsOfJesus":true}]},{"type":"verse","number":19,"content":[{"text":"Ἦλθεν ὁ υἱὸς τοῦ ἀνθρώπου ἐσθίων καὶ πίνων, καὶ λέγουσιν, Ἰδού, ἄνθρωπος φάγος καὶ οἰνοπότης, τελωνῶν φίλος καὶ ἁμαρτωλῶν. Καὶ ἐδικαιώθη ἡ σοφία ἀπὸ τῶν","wordsOfJesus":true},{"noteId":326},{"text":"τέκνων αὐτῆς.","wordsOfJesus":true}]},{"type":"heading","content":["Woe to the Unrepentant"]},{"type":"verse","number":20,"content":["Τότε",{"noteId":327},"ἤρξατο ὀνειδίζειν τὰς πόλεις ἐν αἷς ἐγένοντο αἱ πλεῖσται δυνάμεις αὐτοῦ, ὅτι οὐ μετενόησαν."]},{"type":"verse","number":21,"content":[{"text":"Οὐαί σοι,","wordsOfJesus":true},{"noteId":328},{"text":"Χοραζίν, οὐαί σοι,","wordsOfJesus":true},{"noteId":329},{"text":"Βηθσαϊδά, ὅτι εἰ ἐν Τύρῳ καὶ Σιδῶνι","wordsOfJesus":true},{"noteId":330},{"text":"ἐγένοντο αἱ δυνάμεις αἱ γενόμεναι ἐν ὑμῖν, πάλαι ἂν ἐν σάκκῳ καὶ","wordsOfJesus":true},{"noteId":331},{"text":"σποδῷ μετενόησαν.","wordsOfJesus":true}]},{"type":"verse","number":22,"content":[{"text":"Πλὴν λέγω ὑμῖν, Τύρῳ καὶ Σιδῶνι ἀνεκτότερον ἔσται ἐν ἡμέρᾳ κρίσεως, ἢ ὑμῖν.","wordsOfJesus":true}]},{"type":"verse","number":23,"content":[{"text":"Καὶ σύ,","wordsOfJesus":true},{"noteId":332},{"text":"Καπερναούμ,","wordsOfJesus":true},{"noteId":333},{"text":"ἡ ἕως τοῦ οὐρανοῦ ὑψωθεῖσα, ἕως ᾍδου","wordsOfJesus":true},{"noteId":334},{"text":"καταβιβασθήσῃ· ὅτι εἰ ἐν Σοδόμοις","wordsOfJesus":true},{"noteId":335},{"text":"ἐγένοντο αἱ δυνάμεις αἱ γενόμεναι ἐν σοί,","wordsOfJesus":true},{"noteId":336},{"text":"ἔμειναν ἂν μέχρι τῆς σήμερον.","wordsOfJesus":true}]},{"type":"verse","number":24,"content":[{"text":"Πλὴν λέγω ὑμῖν ὅτι γῇ Σοδόμων ἀνεκτότερον ἔσται ἐν ἡμέρᾳ κρίσεως, ἢ σοί.","wordsOfJesus":true}]},{"type":"heading","content":["Come to Me, and I Will Give You Rest"]},{"type":"verse","number":25,"content":["Ἐν ἐκείνῳ τῷ καιρῷ ἀποκριθεὶς ὁ Ἰησοῦς εἶπεν,",{"text":"Ἐξομολογοῦμαί σοι, πάτερ, Κύριε τοῦ οὐρανοῦ καὶ τῆς γῆς, ὅτι","wordsOfJesus":true},{"noteId":337},{"text":"ἀπέκρυψας ταῦτα ἀπὸ σοφῶν καὶ συνετῶν, καὶ ἀπεκάλυψας αὐτὰ νηπίοις.","wordsOfJesus":true}]},{"type":"verse","number":26,"content":[{"text":"Ναί, ὁ πατήρ, ὅτι οὕτως","wordsOfJesus":true},{"noteId":338},{"text":"ἐγένετο εὐδοκία ἔμπροσθέν σου.","wordsOfJesus":true}]},{"type":"verse","number":27,"content":[{"text":"Πάντα μοι παρεδόθη ὑπὸ τοῦ πατρός μου· καὶ οὐδεὶς ἐπιγινώσκει τὸν υἱόν, εἰ μὴ ὁ πατήρ· οὐδὲ τὸν πατέρα τις ἐπιγινώσκει, εἰ μὴ ὁ υἱός, καὶ ᾧ ἐὰν βούληται ὁ υἱὸς ἀποκαλύψαι.","wordsOfJesus":true}]},{"type":"verse","number":28,"content":[{"text":"Δεῦτε πρός με πάντες οἱ κοπιῶντες καὶ πεφορτισμένοι, κἀγὼ ἀναπαύσω ὑμᾶς.","wordsOfJesus":true}]},{"type":"verse","number":29,"content":[{"text":"Ἄρατε τὸν ζυγόν μου ἐφ᾽ ὑμᾶς καὶ μάθετε ἀπ᾽ ἐμοῦ, ὅτι","wordsOfJesus":true},{"noteId":339},{"text":"πρᾷός εἰμι καὶ ταπεινὸς τῇ καρδίᾳ· καὶ εὑρήσετε ἀνάπαυσιν ταῖς ψυχαῖς ὑμῶν.","wordsOfJesus":true}]},{"type":"verse","number":30,"content":[{"text":"Ὁ γὰρ ζυγός μου χρηστός, καὶ τὸ φορτίον μου ἐλαφρόν ἐστιν.","wordsOfJesus":true}]}],"footnotes":[{"noteId":299,"caller":"+","text":"ιωαννης ¦ ιωανης WH","reference":{"chapter":11,"verse":2}},{"noteId":300,"caller":"+","text":"δυο ¦ δια CT","reference":{"chapter":11,"verse":2}},{"noteId":301,"caller":"+","text":"ιωαννη ¦ ιωανει WH","reference":{"chapter":11,"verse":4}},{"noteId":302,"caller":"+","text":"νεκροι 94.7% ¦ και νεκροι CT 3.5%","reference":{"chapter":11,"verse":5}},{"noteId":303,"caller":"+","text":"εαν ¦ αν WH","reference":{"chapter":11,"verse":6}},{"noteId":304,"caller":"+","text":"ιωαννου ¦ ιωανου WH","reference":{"chapter":11,"verse":7}},{"noteId":305,"caller":"+","text":"εξηλθετε ¦ εξηλθατε CT","reference":{"chapter":11,"verse":7}},{"noteId":306,"caller":"+","text":"εξηλθετε ¦ εξηλθατε CT","reference":{"chapter":11,"verse":8}},{"noteId":307,"caller":"+","text":"ιματιοις ¦ — CT","reference":{"chapter":11,"verse":8}},{"noteId":308,"caller":"+","text":"βασιλειων 62.6% ¦ βασιλεων 𝔐pt ANT CT TR 36.9%","reference":{"chapter":11,"verse":8}},{"noteId":309,"caller":"+","text":"εισιν ¦ — WH","reference":{"chapter":11,"verse":8}},{"noteId":310,"caller":"+","text":"εξηλθετε ¦ εξηλθατε CT","reference":{"chapter":11,"verse":9}},{"noteId":311,"caller":"+","text":"ιδειν προφητην ¦ προφητην ιδειν SBL WH","reference":{"chapter":11,"verse":9}},{"noteId":312,"caller":"+","text":"γαρ ¦ — CT","reference":{"chapter":11,"verse":10}},{"noteId":313,"caller":"+","text":"ιωαννου ¦ ιωανου WH","reference":{"chapter":11,"verse":11}},{"noteId":314,"caller":"+","text":"ιωαννου ¦ ιωανου WH","reference":{"chapter":11,"verse":12}},{"noteId":315,"caller":"+","text":"ιωαννου ¦ ιωα