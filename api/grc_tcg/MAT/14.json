{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"MAT","translationId":"grc_tcg","name":"ΚΑΤΑ ΜΑΤΘΑΙΟΝ","commonName":"ΚΑΤΑ ΜΑΤΘΑΙΟΝ","title":"ΚΑΤΑ ΜΑΤΘΑΙΟΝ","order":40,"numberOfChapters":28,"sha256":"06335047c4ec4dda0ae309f507da1a2504247956d21582d96f042e020e037a3c","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/grc_tcg/MAT/28.json","totalNumberOfVerses":1071},"chapter":{"number":14,"content":[{"type":"heading","content":["The Death of John the Baptist"]},{"type":"verse","number":1,"content":["Ἐν ἐκείνῳ τῷ καιρῷ ἤκουσεν Ἡρῴδης ὁ",{"noteId":462},"τετράρχης τὴν ἀκοὴν Ἰησοῦ,"]},{"type":"verse","number":2,"content":["καὶ εἶπε τοῖς παισὶν αὐτοῦ, Οὗτός ἐστιν",{"noteId":463},"Ἰωάννης ὁ βαπτιστής· αὐτὸς ἠγέρθη ἀπὸ τῶν νεκρῶν, καὶ διὰ τοῦτο αἱ δυνάμεις ἐνεργοῦσιν ἐν αὐτῷ."]},{"type":"verse","number":3,"content":["Ὁ γὰρ Ἡρῴδης κρατήσας τὸν",{"noteId":464},"Ἰωάννην ἔδησεν",{"noteId":465},"αὐτὸν καὶ",{"noteId":466},"ἔθετο ἐν φυλακῇ, διὰ Ἡρῳδιάδα τὴν γυναῖκα Φιλίππου τοῦ ἀδελφοῦ αὐτοῦ."]},{"type":"verse","number":4,"content":["Ἔλεγε γὰρ",{"noteId":467},"αὐτῷ ὁ Ἰωάννης, Οὐκ ἔξεστί σοι ἔχειν αὐτήν."]},{"type":"verse","number":5,"content":["Καὶ θέλων αὐτὸν ἀποκτεῖναι,",{"noteId":468},"ἐφοβήθη τὸν ὄχλον, ὅτι ὡς προφήτην αὐτὸν εἶχον."]},{"type":"verse","number":6,"content":[{"noteId":469},"Γενεσίων δὲ ἀγομένων τοῦ Ἡρῴδου, ὠρχήσατο ἡ θυγάτηρ τῆς Ἡρῳδιάδος ἐν τῷ μέσῳ, καὶ ἤρεσε τῷ Ἡρῴδῃ·"]},{"type":"verse","number":7,"content":["ὅθεν",{"noteId":470},"μεθ᾽ ὅρκου ὡμολόγησεν αὐτῇ δοῦναι ὃ ἐὰν αἰτήσηται."]},{"type":"verse","number":8,"content":["Ἡ δέ, προβιβασθεῖσα ὑπὸ τῆς μητρὸς αὐτῆς, Δός μοι, φησίν, ὧδε ἐπὶ πίνακι τὴν κεφαλὴν",{"noteId":471},"Ἰωάννου τοῦ βαπτιστοῦ."]},{"type":"verse","number":9,"content":["Καὶ",{"noteId":472},"ἐλυπήθη ὁ βασιλεύς, διὰ δὲ τοὺς ὅρκους καὶ τοὺς συνανακειμένους ἐκέλευσε δοθῆναι·"]},{"type":"verse","number":10,"content":["καὶ πέμψας ἀπεκεφάλισε",{"noteId":473},"τὸν Ἰωάννην ἐν τῇ φυλακῇ."]},{"type":"verse","number":11,"content":["Καὶ ἠνέχθη ἡ κεφαλὴ αὐτοῦ ἐπὶ πίνακι, καὶ ἐδόθη τῷ κορασίῳ· καὶ ἤνεγκε τῇ μητρὶ αὐτῆς."]},{"type":"verse","number":12,"content":["Καὶ προσελθόντες οἱ μαθηταὶ αὐτοῦ ἦραν τὸ",{"noteId":474},"σῶμα, καὶ ἔθαψαν",{"noteId":475},"αὐτό· καὶ ἐλθόντες ἀπήγγειλαν τῷ Ἰησοῦ."]},{"type":"heading","content":["The Feeding of the Five Thousand"]},{"type":"verse","number":13,"content":[{"noteId":476},"Καὶ ἀκούσας ὁ Ἰησοῦς ἀνεχώρησεν ἐκεῖθεν ἐν πλοίῳ εἰς ἔρημον τόπον κατ᾽ ἰδίαν· καὶ ἀκούσαντες οἱ ὄχλοι ἠκολούθησαν αὐτῷ πεζῇ ἀπὸ τῶν πόλεων."]},{"type":"verse","number":14,"content":["Καὶ ἐξελθὼν",{"noteId":477},"ὁ Ἰησοῦς εἶδε πολὺν ὄχλον, καὶ ἐσπλαγχνίσθη ἐπ᾽",{"noteId":478},"αὐτοῖς, καὶ ἐθεράπευσε τοὺς ἀρρώστους αὐτῶν."]},{"type":"verse","number":15,"content":["Ὀψίας δὲ γενομένης,",{"noteId":479},"προσῆλθον αὐτῷ οἱ μαθηταὶ",{"noteId":480},"αὐτοῦ, λέγοντες, Ἔρημός ἐστιν ὁ τόπος, καὶ ἡ ὥρα ἤδη παρῆλθεν· ἀπόλυσον τοὺς ὄχλους, ἵνα ἀπελθόντες εἰς τὰς κώμας ἀγοράσωσιν ἑαυτοῖς βρώματα."]},{"type":"verse","number":16,"content":["Ὁ δὲ Ἰησοῦς εἶπεν αὐτοῖς,",{"text":"Οὐ χρείαν ἔχουσιν ἀπελθεῖν· δότε αὐτοῖς ὑμεῖς φαγεῖν.","wordsOfJesus":true}]},{"type":"verse","number":17,"content":["Οἱ δὲ λέγουσιν αὐτῷ, Οὐκ ἔχομεν ὧδε εἰ μὴ πέντε ἄρτους καὶ δύο ἰχθύας."]},{"type":"verse","number":18,"content":["Ὁ δὲ εἶπε,",{"text":"Φέρετέ μοι","wordsOfJesus":true},{"noteId":481},{"text":"αὐτοὺς ὧδε.","wordsOfJesus":true}]},{"type":"verse","number":19,"content":["Καὶ κελεύσας τοὺς ὄχλους ἀνακλιθῆναι ἐπὶ",{"noteId":482},"τοὺς χόρτους,",{"noteId":483},"λαβὼν τοὺς πέντε ἄρτους καὶ τοὺς δύο ἰχθύας, ἀναβλέψας εἰς τὸν οὐρανόν, εὐλόγησε, καὶ κλάσας ἔδωκε τοῖς μαθηταῖς τοὺς ἄρτους, οἱ δὲ μαθηταὶ τοῖς ὄχλοις."]},{"type":"verse","number":20,"content":["Καὶ ἔφαγον πάντες, καὶ ἐχορτάσθησαν· καὶ ἦραν τὸ περισσεῦον τῶν κλασμάτων, δώδεκα κοφίνους πλήρεις."]},{"type":"verse","number":21,"content":["Οἱ δὲ ἐσθίοντες ἦσαν ἄνδρες ὡσεὶ πεντακισχίλιοι, χωρὶς γυναικῶν καὶ παιδίων."]},{"type":"heading","content":["Jesus Walks on Water"]},{"type":"verse","number":22,"content":["Καὶ εὐθέως ἠνάγκασεν",{"noteId":484},"ὁ Ἰησοῦς τοὺς",{"noteId":485},"μαθητὰς ἐμβῆναι εἰς",{"noteId":486},"τὸ πλοῖον, καὶ προάγειν αὐτὸν εἰς τὸ πέραν, ἕως οὗ ἀπολύσῃ τοὺς ὄχλους."]},{"type":"verse","number":23,"content":["Καὶ ἀπολύσας τοὺς ὄχλους, ἀνέβη εἰς τὸ ὄρος κατ᾽ ἰδίαν προσεύξασθαι· ὀψίας δὲ γενομένης, μόνος ἦν ἐκεῖ."]},{"type":"verse","number":24,"content":["Τὸ δὲ πλοῖον ἤδη",{"noteId":487},"μέσον τῆς θαλάσσης ἦν, βασανιζόμενον ὑπὸ τῶν κυμάτων· ἦν γὰρ ἐναντίος ὁ ἄνεμος."]},{"type":"verse","number":25,"content":["Τετάρτῃ δὲ φυλακῇ τῆς νυκτὸς",{"noteId":488},"ἀπῆλθε πρὸς αὐτοὺς",{"noteId":489},"ὁ Ἰησοῦς, περιπατῶν ἐπὶ",{"noteId":490},"τῆς θαλάσσης."]},{"type":"verse","number":26,"content":[{"noteId":491},"Καὶ ἰδόντες αὐτὸν οἱ μαθηταὶ ἐπὶ",{"noteId":492},"τὴν θάλασσαν περιπατοῦντα ἐταράχθησαν, λέγοντες ὅτι Φάντασμά ἐστι· καὶ ἀπὸ τοῦ φόβου ἔκραξαν."]},{"type":"verse","number":27,"content":[{"noteId":493},"Εὐθέως δὲ ἐλάλησεν",{"noteId":494},"αὐτοῖς ὁ Ἰησοῦς, λέγων,",{"text":"Θαρσεῖτε· ἐγώ εἰμι· μὴ φοβεῖσθε.","wordsOfJesus":true}]},{"type":"verse","number":28,"content":["Ἀποκριθεὶς δὲ",{"noteId":495},"αὐτῷ ὁ Πέτρος εἶπε, Κύριε, εἰ σὺ εἶ, κέλευσόν με",{"noteId":496},"πρός σε ἐλθεῖν ἐπὶ τὰ ὕδατα."]},{"type":"verse","number":29,"content":["Ὁ δὲ εἶπεν,",{"text":"Ἐλθέ.","wordsOfJesus":true},"Καὶ καταβὰς ἀπὸ τοῦ πλοίου",{"noteId":497},"ὁ Πέτρος περιεπάτησεν ἐπὶ τὰ ὕδατα,",{"noteId":498},"ἐλθεῖν πρὸς τὸν Ἰησοῦν."]},{"type":"verse","number":30,"content":["Βλέπων δὲ τὸν ἄνεμον",{"noteId":499},"ἰσχυρὸν ἐφοβήθη· καὶ ἀρξάμενος καταποντίζεσθαι ἔκραξε, λέγων, Κύριε, σῶσόν με."]},{"type":"verse","number":31,"content":[{"noteId":500},"Εὐθέως δὲ ὁ Ἰησοῦς ἐκτείνας τὴν χεῖρα ἐπελάβετο αὐτοῦ, καὶ λέγει αὐτῷ,",{"text":"Ὀλιγόπιστε, εἰς τί ἐδίστασας;","wordsOfJesus":true}]},{"type":"verse","number":32,"content":["Καὶ",{"noteId":501},"ἐμβάντων αὐτῶν εἰς τὸ πλοῖον, ἐκόπασεν ὁ ἄνεμος·"]},{"type":"verse","number":33,"content":["οἱ δὲ ἐν τῷ πλοίῳ",{"noteId":502},"ἐλθόντες προσεκύνησαν αὐτῷ, λέγοντες, Ἀληθῶς Θεοῦ υἱὸς εἶ."]},{"type":"heading","content":["Jesus Heals the Sick in Gennesaret"]},{"type":"verse","number":34,"content":["Καὶ διαπεράσαντες",{"noteId":503},"ἦλθον",{"noteId":504},"εἰς τὴν γῆν",{"noteId":505},"Γεννησαρέτ."]},{"type":"verse","number":35,"content":["Καὶ ἐπιγνόντες αὐτὸν οἱ ἄνδρες τοῦ τόπου ἐκείνου ἀπέστειλαν εἰς ὅλην τὴν περίχωρον ἐκείνην, καὶ προσήνεγκαν αὐτῷ πάντας τοὺς κακῶς ἔχοντας·"]},{"type":"verse","number":36,"content":["καὶ παρεκάλουν αὐτόν, ἵνα",{"noteId":506},"μόνον ἅψωνται τοῦ κρασπέδου τοῦ ἱματίου αὐτοῦ· καὶ ὅσοι ἥψαντο διεσώθησαν."]}],"footnotes":[{"noteId":462,"caller":"+","text":"τετραρχης ¦ τετρααρχης NA SBL WH","reference":{"chapter":14,"verse":1}},{"noteId":463,"caller":"+","text":"ιωαννης ¦ ιωανης WH","reference":{"chapter":14,"verse":2}},{"noteId":464,"caller":"+","text":"ιωαννην ¦ ιωανην WH","reference":{"chapter":14,"verse":3}},{"noteId":465,"caller":"+","text":"αυτον ¦ — WH","reference":{"chapter":14,"verse":3}},{"noteId":466,"caller":"+","text":"εθετο εν φυλακη ¦ εν φυλακη απεθετο NA SBL WH ¦ εν τη φυλακη απεθετο TH","reference":{"chapter":14,"verse":3}},{"noteId":467,"caller":"+","text":"αυτω ο ιωαννης ¦ ο ιωαννης αυτω NA ¦ ο ιωανης αυτω WH","reference":{"chapter":14,"verse":4}},{"noteId":468,"caller":"+","text":"εφοβηθη ¦ εφοβειτο PCK","reference":{"chapter":14,"verse":