{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"MAT","translationId":"grc_tcg","name":"ΚΑΤΑ ΜΑΤΘΑΙΟΝ","commonName":"ΚΑΤΑ ΜΑΤΘΑΙΟΝ","title":"ΚΑΤΑ ΜΑΤΘΑΙΟΝ","order":40,"numberOfChapters":28,"sha256":"06335047c4ec4dda0ae309f507da1a2504247956d21582d96f042e020e037a3c","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/grc_tcg/MAT/28.json","totalNumberOfVerses":1071},"chapter":{"number":19,"content":[{"type":"heading","content":["Questions About Divorce"]},{"type":"verse","number":1,"content":["Καὶ ἐγένετο ὅτε ἐτέλεσεν ὁ Ἰησοῦς τοὺς λόγους τούτους, μετῆρεν ἀπὸ τῆς Γαλιλαίας, καὶ ἦλθεν εἰς τὰ ὅρια τῆς Ἰουδαίας πέραν τοῦ Ἰορδάνου."]},{"type":"verse","number":2,"content":["Καὶ ἠκολούθησαν αὐτῷ ὄχλοι πολλοί, καὶ ἐθεράπευσεν αὐτοὺς ἐκεῖ."]},{"type":"verse","number":3,"content":["Καὶ",{"noteId":670},"προσῆλθον αὐτῷ",{"noteId":671},"οἱ Φαρισαῖοι πειράζοντες αὐτόν, καὶ λέγοντες",{"noteId":672},"αὐτῷ, Εἰ ἔξεστιν",{"noteId":673},"ἀνθρώπῳ ἀπολῦσαι τὴν γυναῖκα αὐτοῦ κατὰ πᾶσαν αἰτίαν;"]},{"type":"verse","number":4,"content":["Ὁ δὲ ἀποκριθεὶς εἶπεν",{"noteId":674},"αὐτοῖς,",{"text":"Οὐκ ἀνέγνωτε ὅτι ὁ","wordsOfJesus":true},{"noteId":675},{"text":"ποιήσας ἀπ᾽ ἀρχῆς ἄρσεν καὶ θῆλυ ἐποίησεν αὐτούς,","wordsOfJesus":true}]},{"type":"verse","number":5,"content":[{"text":"καὶ εἶπεν,","wordsOfJesus":true},{"noteId":676},{"text":"Ἕνεκεν τούτου καταλείψει ἄνθρωπος τὸν","wordsOfJesus":true},{"noteId":677},{"text":"πατέρα καὶ τὴν μητέρα, καὶ","wordsOfJesus":true},{"noteId":678},{"text":"προσκολληθήσεται","wordsOfJesus":true},{"noteId":679},{"text":"τῇ γυναικὶ αὐτοῦ, καὶ ἔσονται οἱ δύο εἰς σάρκα μίαν;","wordsOfJesus":true}]},{"type":"verse","number":6,"content":[{"text":"Ὥστε οὐκέτι εἰσὶ δύο, ἀλλὰ σὰρξ μία. Ὃ οὖν ὁ Θεὸς συνέζευξεν, ἄνθρωπος μὴ χωριζέτω.","wordsOfJesus":true}]},{"type":"verse","number":7,"content":["Λέγουσιν αὐτῷ, Τί οὖν",{"noteId":680},"Μωσῆς ἐνετείλατο δοῦναι βιβλίον ἀποστασίου, καὶ ἀπολῦσαι",{"noteId":681},"αὐτήν;"]},{"type":"verse","number":8,"content":["Λέγει αὐτοῖς ὅτι",{"noteId":682},{"text":"Μωσῆς πρὸς τὴν σκληροκαρδίαν ὑμῶν ἐπέτρεψεν ὑμῖν ἀπολῦσαι τὰς γυναῖκας ὑμῶν· ἀπ᾽ ἀρχῆς δὲ οὐ γέγονεν οὕτω.","wordsOfJesus":true}]},{"type":"verse","number":9,"content":[{"text":"Λέγω δὲ ὑμῖν","wordsOfJesus":true},{"noteId":683},{"text":"ὅτι ὃς ἂν ἀπολύσῃ τὴν γυναῖκα αὐτοῦ,","wordsOfJesus":true},{"noteId":684},{"text":"μὴ ἐπὶ πορνείᾳ, καὶ γαμήσῃ ἄλλην, μοιχᾶται·","wordsOfJesus":true},{"noteId":685},{"text":"καὶ ὁ ἀπολελυμένην γαμήσας μοιχᾶται.","wordsOfJesus":true}]},{"type":"verse","number":10,"content":["Λέγουσιν αὐτῷ οἱ μαθηταὶ",{"noteId":686},"αὐτοῦ, Εἰ οὕτως ἐστὶν ἡ αἰτία τοῦ ἀνθρώπου μετὰ τῆς γυναικός, οὐ συμφέρει γαμῆσαι."]},{"type":"verse","number":11,"content":["Ὁ δὲ εἶπεν αὐτοῖς,",{"text":"Οὐ πάντες χωροῦσι τὸν λόγον","wordsOfJesus":true},{"noteId":687},{"text":"τοῦτον, ἀλλ᾽ οἷς δέδοται.","wordsOfJesus":true}]},{"type":"verse","number":12,"content":[{"text":"Εἰσὶ γὰρ εὐνοῦχοι, οἵτινες ἐκ κοιλίας μητρὸς ἐγεννήθησαν οὕτω· καί εἰσιν εὐνοῦχοι, οἵτινες εὐνουχίσθησαν ὑπὸ τῶν ἀνθρώπων· καί εἰσιν εὐνοῦχοι, οἵτινες εὐνούχισαν ἑαυτοὺς διὰ τὴν βασιλείαν τῶν οὐρανῶν. Ὁ δυνάμενος χωρεῖν χωρείτω.","wordsOfJesus":true}]},{"type":"heading","content":["Let the Little Children Come to Me"]},{"type":"verse","number":13,"content":["Τότε",{"noteId":688},"προσηνέχθη αὐτῷ παιδία, ἵνα",{"noteId":689},"τὰς χεῖρας ἐπιθῇ αὐτοῖς, καὶ προσεύξηται· οἱ δὲ μαθηταὶ ἐπετίμησαν αὐτοῖς."]},{"type":"verse","number":14,"content":["Ὁ δὲ Ἰησοῦς εἶπεν,",{"text":"Ἄφετε τὰ παιδία, καὶ μὴ κωλύετε αὐτὰ ἐλθεῖν πρός με· τῶν γὰρ τοιούτων ἐστὶν ἡ βασιλεία τῶν οὐρανῶν.","wordsOfJesus":true}]},{"type":"verse","number":15,"content":["Καὶ ἐπιθεὶς",{"noteId":690},"αὐτοῖς τὰς χεῖρας, ἐπορεύθη ἐκεῖθεν."]},{"type":"heading","content":["The Rich Young Ruler"]},{"type":"verse","number":16,"content":["Καὶ ἰδού,",{"noteId":691},"εἷς προσελθὼν",{"noteId":692},"εἶπεν αὐτῷ, Διδάσκαλε",{"noteId":693},"ἀγαθέ, τί ἀγαθὸν ποιήσω, ἵνα",{"noteId":694},"ἔχω ζωὴν αἰώνιον;"]},{"type":"verse","number":17,"content":["Ὁ δὲ εἶπεν αὐτῷ,",{"text":"Τί με","wordsOfJesus":true},{"noteId":695},{"text":"λέγεις ἀγαθόν; Οὐδεὶς ἀγαθός, εἰ μὴ εἷς, ὁ Θεός. Εἰ δὲ θέλεις","wordsOfJesus":true},{"noteId":696},{"text":"εἰσελθεῖν εἰς τὴν ζωήν,","wordsOfJesus":true},{"noteId":697},{"text":"τήρησον τὰς ἐντολάς.","wordsOfJesus":true}]},{"type":"verse","number":18,"content":["Λέγει αὐτῷ, Ποίας; Ὁ δὲ Ἰησοῦς",{"noteId":698},"εἶπε,",{"text":"Τὸ Οὐ φονεύσεις· οὐ μοιχεύσεις· οὐ κλέψεις· οὐ ψευδομαρτυρήσεις·","wordsOfJesus":true}]},{"type":"verse","number":19,"content":[{"text":"τίμα τὸν","wordsOfJesus":true},{"noteId":699},{"text":"πατέρα καὶ τὴν μητέρα· καί, ἀγαπήσεις τὸν πλησίον σου ὡς σεαυτόν.","wordsOfJesus":true}]},{"type":"verse","number":20,"content":["Λέγει αὐτῷ ὁ νεανίσκος,",{"noteId":700},"Πάντα ταῦτα",{"noteId":701},"ἐφυλαξάμην ἐκ νεότητός μου· τί ἔτι ὑστερῶ;"]},{"type":"verse","number":21,"content":["Ἔφη αὐτῷ ὁ Ἰησοῦς,",{"text":"Εἰ θέλεις τέλειος εἶναι, ὕπαγε, πώλησόν σου τὰ ὑπάρχοντα καὶ δὸς","wordsOfJesus":true},{"noteId":702},{"text":"πτωχοῖς, καὶ ἕξεις θησαυρὸν ἐν","wordsOfJesus":true},{"noteId":703},{"text":"οὐρανῷ· καὶ δεῦρο, ἀκολούθει μοι.","wordsOfJesus":true}]},{"type":"verse","number":22,"content":["Ἀκούσας δὲ ὁ νεανίσκος τὸν",{"noteId":704},"λόγον ἀπῆλθε λυπούμενος· ἦν γὰρ ἔχων κτήματα πολλά."]},{"type":"verse","number":23,"content":["Ὁ δὲ Ἰησοῦς εἶπε τοῖς μαθηταῖς αὐτοῦ,",{"text":"Ἀμὴν λέγω ὑμῖν ὅτι","wordsOfJesus":true},{"noteId":705},{"text":"δυσκόλως πλούσιος εἰσελεύσεται εἰς τὴν βασιλείαν τῶν οὐρανῶν.","wordsOfJesus":true}]},{"type":"verse","number":24,"content":[{"text":"Πάλιν δὲ λέγω ὑμῖν, εὐκοπώτερόν ἐστι κάμηλον διὰ","wordsOfJesus":true},{"noteId":706},{"text":"τρυπήματος ῥαφίδος","wordsOfJesus":true},{"noteId":707},{"text":"διελθεῖν, ἢ πλούσιον","wordsOfJesus":true},{"noteId":708},{"text":"εἰς τὴν βασιλείαν τοῦ Θεοῦ εἰσελθεῖν.","wordsOfJesus":true}]},{"type":"verse","number":25,"content":["Ἀκούσαντες δὲ οἱ μαθηταὶ",{"noteId":709},"αὐτοῦ ἐξεπλήσσοντο σφόδρα, λέγοντες, Τίς ἄρα δύναται σωθῆναι;"]},{"type":"verse","number":26,"content":["Ἐμβλέψας δὲ ὁ Ἰησοῦς εἶπεν αὐτοῖς,",{"text":"Παρὰ ἀνθρώποις τοῦτο ἀδύνατόν ἐστι, παρὰ δὲ Θεῷ πάντα","wordsOfJesus":true},{"noteId":710},{"text":"δυνατά.","wordsOfJesus":true}]},{"type":"verse","number":27,"content":["Τότε ἀποκριθεὶς ὁ Πέτρος εἶπεν αὐτῷ, Ἰδού, ἡμεῖς ἀφήκαμεν πάντα καὶ ἠκολουθήσαμέν σοι· τί ἄρα ἔσται ἡμῖν;"]},{"type":"verse","number":28,"content":["Ὁ δὲ Ἰησοῦς εἶπεν αὐτοῖς,",{"text":"Ἀμὴν λέγω ὑμῖν ὅτι ὑμεῖς οἱ ἀκολουθήσαντές μοι, ἐν τῇ","wordsOfJesus":true},{"noteId":711},{"text":"παλιγγενεσίᾳ ὅταν καθίσῃ ὁ υἱὸς τοῦ ἀνθρώπου ἐπὶ θρόνου δόξης αὐτοῦ,","wordsOfJesus":true},{"noteId":712},{"text":"καθίσεσθε καὶ ὑμεῖς ἐπὶ δώδεκα θρόνους, κρίνοντες τὰς δώδεκα φυλὰς τοῦ Ἰσραήλ.","wordsOfJesus":true}]},{"type":"verse","number":29,"content":[{"text":"Καὶ πᾶς","wordsOfJesus":true},{"noteId":713},{"text":"ὃς ἀφῆκεν οἰκίας, ἢ ἀδελφούς, ἢ ἀδελφάς, ἢ πατέρα, ἢ μητέρα,","wordsOfJesus":true},{"noteId":714},{"text":"ἢ γυναῖκα, ἢ τέκνα, ἢ ἀγρούς, ἕνεκεν τοῦ","wordsOfJesus":true},{"noteId":715},{"text":"ὀνόματός μου,","wordsOfJesus":true},{"noteId":716},{"text":"ἑκατονταπλασίονα","wordsOfJesus":true},{"noteId":717},{"text":"λήψεται, καὶ ζωὴν αἰώνιον κληρονομήσει.","wordsOfJesus":true}]},{"type":"verse","number":30,"content":[{"text":"Πολλοὶ δὲ ἔσονται πρῶτοι ἔσχατοι, καὶ ἔσχατοι πρῶτοι.","wordsOfJesus":true}]}],"footnotes":[{"noteId":670,"caller":"+","text":"προσηλθον ¦ προσηλθαν WH","reference":{"chapter":19,"verse":3}},{"noteId":671,"caller":"+","text":"οι ¦ — CT","reference":{"chapter":19,"verse":3}},{"noteId":672,"caller":"+","text":"αυτω ¦ — CT","reference":{"chapter":19,"verse":3}},{"noteId":673,"caller":"+","text":"ανθρωπω ¦ — WH","reference":{"chapter":19,"verse":3}},{"noteId":674,"caller":"+","text":"αυτοις ¦ — CT","reference":{"chapter":19,"verse":4}},{"noteId":675,"caller":"+","text":"ποιησας ¦ κτισας CT","reference":{"chapter":19,"verse":4}},{"noteId":676,"caller":"+","text":"ενεκεν ¦ ενεκα CT","reference":{"chapter":19,"verse":5}},{"noteId":677,"caller":"+","text":"πατερα ¦ πατερα αυτου 𝔐pt ANT PCK","reference":{"chapter":19,"verse":5}},{"noteId":678,"caller":"+","text":"προσκολληθησεται ¦ κολληθησεται 𝔐pt ANT CT","reference":{"chapter":19,"verse":5}},{"noteId":679,"caller":"+","text":"τη γυναικι ¦ προς την γυναικα PCK","reference":{"chapter":19,"verse":5}},{"noteId":680,"caller":"+","text":"μωσης ¦ μωυσης CT","reference":{"chapter":19,"verse":7}},{"noteId":681,"caller":"+","text":"αυτην ¦ — WH","reference":{"chapter":19,"verse":7}},{"noteId":682,"caller":"+","text":"μωσης ¦ μωυσης CT","reference":{"chapter":19,"verse":8}},{"noteId":683,"caller":"+","text":"οτι ¦ — TH","reference":{"chapter":19,"verse":9}},{"noteId":684,"caller":"+","text":"μη ¦ ει μη TR","reference":{"chapter":19,"verse":9}},{"noteId":685,"caller":"+","text":"και ο απολελυμενην γαμησας μοιχαται ¦ — NA WH","reference":{"chapter":19,"verse":9}},{"noteId":686,"caller":"+","text":"αυτου ¦ — SBL WH","reference":{"chapter":19,"verse":10}},{"noteId":687,"caller":"+","text":"τουτον ¦ — WH","reference":{"chapter":19,"verse":11}},{"noteId":688,"caller":"+","text":"προσηνεχθη ¦ προσηνεχθησαν CT","reference":{"chapter":19,"verse":13}},{"noteId":689,"caller":"+","text":"τας χειρας επιθη αυτοις ¦ επιθη αυτοις τας χειρας ANT","reference":{"chapter":19,"verse":13}},{"noteId"