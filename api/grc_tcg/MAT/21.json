{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"MAT","translationId":"grc_tcg","name":"ΚΑΤΑ ΜΑΤΘΑΙΟΝ","commonName":"ΚΑΤΑ ΜΑΤΘΑΙΟΝ","title":"ΚΑΤΑ ΜΑΤΘΑΙΟΝ","order":40,"numberOfChapters":28,"sha256":"06335047c4ec4dda0ae309f507da1a2504247956d21582d96f042e020e037a3c","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/grc_tcg/MAT/28.json","totalNumberOfVerses":1071},"chapter":{"number":21,"content":[{"type":"heading","content":["The Triumphal Entry"]},{"type":"verse","number":1,"content":["Καὶ ὅτε ἤγγισαν εἰς Ἱεροσόλυμα, καὶ ἦλθον εἰς",{"noteId":768},"Βηθσφαγὴ",{"noteId":769},"πρὸς τὸ ὄρος τῶν Ἐλαιῶν, τότε",{"noteId":770},"ὁ Ἰησοῦς ἀπέστειλε δύο μαθητάς,"]},{"type":"verse","number":2,"content":["λέγων αὐτοῖς,",{"noteId":771},{"text":"Πορεύθητε εἰς τὴν κώμην τὴν","wordsOfJesus":true},{"noteId":772},{"text":"ἀπέναντι ὑμῶν, καὶ","wordsOfJesus":true},{"noteId":773},{"text":"εὐθέως εὑρήσετε ὄνον δεδεμένην, καὶ πῶλον μετ᾽ αὐτῆς· λύσαντες ἀγάγετέ μοι.","wordsOfJesus":true}]},{"type":"verse","number":3,"content":[{"text":"Καὶ ἐάν τις ὑμῖν εἴπῃ τι, ἐρεῖτε ὅτι Ὁ Κύριος αὐτῶν χρείαν ἔχει·","wordsOfJesus":true},{"noteId":774},{"text":"εὐθέως δὲ","wordsOfJesus":true},{"noteId":775},{"text":"ἀποστέλλει αὐτούς.","wordsOfJesus":true}]},{"type":"verse","number":4,"content":["Τοῦτο δὲ",{"noteId":776},"ὅλον γέγονεν, ἵνα πληρωθῇ τὸ ῥηθὲν διὰ τοῦ προφήτου, λέγοντος,"]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Εἴπατε τῇ θυγατρὶ Σιών,","poem":1},{"lineBreak":true},{"text":"Ἰδού, ὁ βασιλεύς σου ἔρχεταί σοι,","poem":1},{"lineBreak":true},{"text":"πραῢς καὶ ἐπιβεβηκὼς ἐπὶ ὄνον","poem":1},{"lineBreak":true},{"text":"καὶ","poem":1},{"noteId":777},{"text":"πῶλον υἱὸν ὑποζυγίου.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":["Πορευθέντες δὲ οἱ μαθηταί, καὶ ποιήσαντες καθὼς",{"noteId":778},"προσέταξεν αὐτοῖς ὁ Ἰησοῦς,"]},{"type":"verse","number":7,"content":["ἤγαγον τὴν ὄνον καὶ τὸν πῶλον· καὶ ἐπέθηκαν",{"noteId":779},"ἐπάνω αὐτῶν τὰ ἱμάτια",{"noteId":780},"αὐτῶν, καὶ",{"noteId":781},"ἐπεκάθισεν ἐπάνω αὐτῶν."]},{"type":"verse","number":8,"content":["Ὁ δὲ πλεῖστος ὄχλος ἔστρωσαν",{"noteId":782},"ἑαυτῶν τὰ ἱμάτια ἐν τῇ ὁδῷ· ἄλλοι δὲ ἔκοπτον κλάδους ἀπὸ τῶν δένδρων, καὶ ἐστρώννυον ἐν τῇ ὁδῷ."]},{"type":"verse","number":9,"content":["Οἱ δὲ ὄχλοι οἱ",{"noteId":783},"προάγοντες καὶ οἱ ἀκολουθοῦντες ἔκραζον, λέγοντες,",{"lineBreak":true},{"text":"Ὡσαννὰ τῷ υἱῷ","poem":1},{"noteId":784},{"text":"Δαυίδ·","poem":1},{"lineBreak":true},{"text":"εὐλογημένος ὁ ἐρχόμενος ἐν ὀνόματι Κυρίου.","poem":1},{"lineBreak":true},{"text":"Ὡσαννὰ ἐν τοῖς ὑψίστοις.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":["Καὶ εἰσελθόντος αὐτοῦ εἰς Ἱεροσόλυμα, ἐσείσθη πᾶσα ἡ πόλις, λέγουσα, Τίς ἐστιν οὗτος;"]},{"type":"verse","number":11,"content":["Οἱ δὲ ὄχλοι ἔλεγον, Οὗτός ἐστιν",{"noteId":785},"Ἰησοῦς ὁ προφήτης, ὁ ἀπὸ",{"noteId":786},"Ναζαρὲτ τῆς Γαλιλαίας."]},{"type":"heading","content":["Jesus Cleanses the Temple Courts"]},{"type":"verse","number":12,"content":["Καὶ εἰσῆλθεν",{"noteId":787},"ὁ Ἰησοῦς εἰς τὸ ἱερὸν",{"noteId":788},"τοῦ Θεοῦ, καὶ ἐξέβαλε πάντας τοὺς πωλοῦντας καὶ ἀγοράζοντας ἐν τῷ ἱερῷ, καὶ τὰς τραπέζας τῶν κολλυβιστῶν κατέστρεψε, καὶ τὰς καθέδρας τῶν πωλούντων τὰς περιστεράς."]},{"type":"verse","number":13,"content":["Καὶ λέγει αὐτοῖς,",{"text":"Γέγραπται, Ὁ οἶκός μου οἶκος προσευχῆς κληθήσεται· ὑμεῖς δὲ αὐτὸν","wordsOfJesus":true},{"noteId":789},{"text":"ἐποιήσατε σπήλαιον λῃστῶν.","wordsOfJesus":true}]},{"type":"verse","number":14,"content":["Καὶ προσῆλθον αὐτῷ",{"noteId":790},"χωλοὶ καὶ τυφλοὶ ἐν τῷ ἱερῷ· καὶ ἐθεράπευσεν αὐτούς."]},{"type":"verse","number":15,"content":["Ἰδόντες δὲ οἱ ἀρχιερεῖς καὶ οἱ γραμματεῖς τὰ θαυμάσια ἃ ἐποίησε, καὶ τοὺς παῖδας",{"noteId":791},"κράζοντας ἐν τῷ ἱερῷ, καὶ λέγοντας, Ὡσαννὰ τῷ υἱῷ",{"noteId":792},"Δαυίδ, ἠγανάκτησαν,"]},{"type":"verse","number":16,"content":["καὶ",{"noteId":793},"εἶπον αὐτῷ, Ἀκούεις τί οὗτοι λέγουσιν; Ὁ δὲ Ἰησοῦς λέγει αὐτοῖς,",{"text":"Ναί· οὐδέποτε ἀνέγνωτε ὅτι","wordsOfJesus":true},{"lineBreak":true},{"text":"Ἐκ στόματος νηπίων καὶ θηλαζόντων","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"κατηρτίσω αἶνον;","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":["Καὶ καταλιπὼν αὐτοὺς ἐξῆλθεν ἔξω τῆς πόλεως εἰς Βηθανίαν, καὶ ηὐλίσθη ἐκεῖ."]},{"type":"heading","content":["Jesus Curses the Fig Tree"]},{"type":"verse","number":18,"content":[{"noteId":794},"Πρωΐας δὲ",{"noteId":795},"ἐπανάγων εἰς τὴν πόλιν, ἐπείνασε."]},{"type":"verse","number":19,"content":["Καὶ ἰδὼν συκῆν μίαν ἐπὶ τῆς ὁδοῦ, ἦλθεν ἐπ᾽ αὐτήν, καὶ οὐδὲν εὗρεν ἐν αὐτῇ εἰ μὴ φύλλα μόνον· καὶ λέγει αὐτῇ,",{"noteId":796},{"text":"Μηκέτι ἐκ σοῦ καρπὸς γένηται εἰς τὸν αἰῶνα.","wordsOfJesus":true},"Καὶ ἐξηράνθη παραχρῆμα ἡ συκῆ."]},{"type":"verse","number":20,"content":["Καὶ ἰδόντες οἱ μαθηταὶ ἐθαύμασαν, λέγοντες, Πῶς παραχρῆμα ἐξηράνθη ἡ συκῆ;"]},{"type":"verse","number":21,"content":["Ἀποκριθεὶς δὲ ὁ Ἰησοῦς εἶπεν αὐτοῖς,",{"text":"Ἀμὴν λέγω ὑμῖν, ἐὰν ἔχητε πίστιν, καὶ μὴ διακριθῆτε, οὐ μόνον τὸ τῆς συκῆς ποιήσετε, ἀλλὰ κἂν τῷ ὄρει τούτῳ εἴπητε, Ἄρθητι, καὶ βλήθητι εἰς τὴν θάλασσαν, γενήσεται.","wordsOfJesus":true}]},{"type":"verse","number":22,"content":[{"text":"Καὶ πάντα ὅσα","wordsOfJesus":true},{"noteId":797},{"text":"ἐὰν αἰτήσητε ἐν τῇ προσευχῇ, πιστεύοντες,","wordsOfJesus":true},{"noteId":798},{"text":"λήψεσθε.","wordsOfJesus":true}]},{"type":"heading","content":["The Authority of Jesus Questioned"]},{"type":"verse","number":23,"content":["Καὶ",{"noteId":799},"ἐλθόντι αὐτῷ εἰς τὸ ἱερόν,",{"noteId":800},"προσῆλθον αὐτῷ διδάσκοντι οἱ ἀρχιερεῖς καὶ οἱ πρεσβύτεροι τοῦ λαοῦ, λέγοντες, Ἐν ποίᾳ ἐξουσίᾳ ταῦτα ποιεῖς; Καὶ τίς σοι ἔδωκε τὴν ἐξουσίαν ταύτην;"]},{"type":"verse","number":24,"content":["Ἀποκριθεὶς δὲ ὁ Ἰησοῦς εἶπεν αὐτοῖς,",{"text":"Ἐρωτήσω ὑμᾶς κἀγὼ λόγον ἕνα, ὃν ἐὰν εἴπητέ μοι, κἀγὼ ὑμῖν ἐρῶ ἐν ποίᾳ ἐξουσίᾳ ταῦτα ποιῶ.","wordsOfJesus":true}]},{"type":"verse","number":25,"content":[{"text":"Τὸ βάπτισμα","wordsOfJesus":true},{"noteId":801},{"text":"Ἰωάννου πόθεν ἦν; Ἐξ οὐρανοῦ ἢ ἐξ ἀνθρώπων;","wordsOfJesus":true},"Οἱ δὲ διελογίζοντο",{"noteId":802},"παρ᾽ ἑαυτοῖς, λέγοντες, Ἐὰν εἴπωμεν, Ἐξ οὐρανοῦ, ἐρεῖ ἡμῖν, Διὰ τί οὖν οὐκ ἐπιστεύσατε αὐτῷ;"]},{"type":"verse","number":26,"content":["Ἐὰν δὲ εἴπωμεν, Ἐξ ἀνθρώπων, φοβούμεθα τὸν ὄχλον· πάντες γὰρ",{"noteId":803},"ἔχουσι τὸν Ἰωάννην ὡς προφήτην."]},{"type":"verse","number":27,"content":["Καὶ ἀποκριθέντες τῷ Ἰησοῦ",{"noteId":804},"εἶπον, Οὐκ οἴδαμεν. Ἔφη αὐτοῖς καὶ αὐτός,",{"text":"Οὐδὲ ἐγὼ λέγω ὑμῖν ἐν ποίᾳ ἐξουσίᾳ ταῦτα ποιῶ.","wordsOfJesus":true}]},{"type":"heading","content":["The Parable of the Two Sons"]},{"type":"verse","number":28,"content":[{"text":"Τί δὲ ὑμῖν δοκεῖ;","wordsOfJesus":true},{"noteId":805},{"text":"Ἄνθρωπος εἶχε τέκνα δύο,","wordsOfJesus":true},{"noteId":806},{"text":"καὶ προσελθὼν τῷ πρώτῳ εἶπε, Τέκνον, ὕπαγε, σήμερον ἐργάζου ἐν τῷ ἀμπελῶνί","wordsOfJesus":true},{"noteId":807},{"text":"μου.","wordsOfJesus":true}]},{"type":"verse","number":29,"content":[{"text":"Ὁ δὲ ἀποκριθεὶς εἶπεν,","wordsOfJesus":true},{"noteId":808},{"text":"Οὐ θέλω· ὕστερον δὲ μεταμεληθείς, ἀπῆλθε.","wordsOfJesus":true}]},{"type":"verse","number":30,"content":[{"noteId":809},{"text":"Καὶ προσελθὼν τῷ","wordsOfJesus":true},{"noteId":810},{"text":"δευτέρῳ εἶπεν ὡσαύτως. Ὁ δὲ ἀποκριθεὶς εἶπεν,","wordsOfJesus":true},{"noteId":811},{"text":"Ἐγώ, κύριε· καὶ οὐκ ἀπῆλθε.","wordsOfJesus":true}]},{"type":"verse","number":31,"content":[{"text":"Τίς ἐκ τῶν δύο ἐποίησε τὸ θέλημα τοῦ πατρός;","wordsOfJesus":true},"Λέγουσιν",{"noteId":812},"αὐτῷ, Ὁ",{"noteId":813},"πρῶτος. Λέγει αὐτοῖς ὁ Ἰησοῦς,",{"text":"Ἀμὴν λέγω ὑμῖν ὅτι οἱ τελῶναι καὶ αἱ πόρναι προάγουσιν ὑμᾶς εἰς τὴν βασιλείαν τοῦ Θεοῦ.","wordsOfJesus":true}]},{"type":"verse","number":32,"content":[{"text":"Ἦλθε γὰρ","wordsOfJesus":true},{"noteId":814},{"text":"πρὸς ὑμᾶς Ἰωάννης ἐν ὁδῷ δικαιοσύνης, καὶ οὐκ ἐπιστεύσατε αὐτῷ· οἱ δὲ τελῶναι καὶ αἱ πόρναι ἐπίστευσαν αὐτῷ· ὑμεῖς δὲ ἰδόντες","wordsOfJesus":true},{"noteId":815},{"text":"οὐ μετεμελήθητε ὕστερον τοῦ πιστεῦσαι αὐτῷ.","wordsOfJesus":true}]},{"type":"heading","content":["The Parable of the Vineyard Owner"]},{"type":"verse","number":33,"content":[{"text":"Ἄλλην παραβολὴν ἀκούσατε. Ἄνθρωπός","wordsOfJesus":true},{"noteId":816},{"text":"τις ἦν οἰκοδεσπότης, ὅστις ἐφύτευσεν ἀμπελῶνα, καὶ φραγμὸν αὐτῷ περιέθηκε, καὶ ὤρυξεν ἐν αὐτῷ ληνόν, καὶ ᾠκοδόμησε πύργον, καὶ","wordsOfJesus":true},{"noteId":817},{"text":"ἐξέδοτο αὐτὸν γεωργοῖς, καὶ ἀπεδήμησεν.","wordsOfJesus":true}]},{"type":"verse","number":34,"content":[{"text":"Ὅτε δὲ ἤγγισεν ὁ καιρὸς τῶν καρπῶν, ἀπέστειλε τοὺς δούλους αὐτοῦ πρὸς τοὺς γεωργούς, λαβεῖν τοὺς καρποὺς αὐτοῦ.","wordsOfJesus":true}]},{"type":"verse","number":35,"content":[{"text":"Καὶ λαβόντες οἱ γεωργοὶ τοὺς δούλους αὐτοῦ, ὃν μὲν","wordsOfJesus":true},{"noteId":818},{"text":"ἔδειραν, ὃν δὲ ἀπέκτειναν, ὃν δὲ ἐλιθοβόλησαν.","wordsOfJesus":true}]},{"type":"verse","number":36,"content":[{"text":"Πάλιν ἀπέστειλεν ἄλλους δούλους πλείονας τῶν πρώτων· καὶ ἐποίησαν αὐτοῖς ὡσαύτως.","wordsOfJesus":true}]},{"type":"verse","number":37,"content":[{"text":"Ὕστερον δὲ ἀπέστειλε πρὸς αὐτοὺς τὸν υἱὸν αὐτοῦ, λέγων, Ἐντραπήσονται τὸν υἱόν μου.","wordsOfJesus":true}]},{"type":"verse","number":38,"content":[{"text":"Οἱ δὲ γεωργοὶ ἰδόντες τὸν υἱὸν εἶπον ἐν ἑαυτοῖς, Οὗτός ἐστιν ὁ κληρονόμος· δεῦτε, ἀποκτείνωμεν αὐτόν, καὶ","wordsOfJesus":true},{"noteId":819},{"text":"κατάσχωμεν τὴν κληρονομίαν αὐτοῦ.","wordsOfJesus":true}]},{"type":"verse","number":39,"content":[{"text":"Καὶ λαβόντες αὐτὸν ἐξέβαλον ἔξω τοῦ ἀμπελῶνος καὶ ἀπέκτειναν.","wordsOfJesus":true}]},{"type":"verse","number":40,"content":[{"text":"Ὅταν οὖν ἔλθῃ ὁ κύριος τοῦ ἀμπελῶνος, τί ποιήσει τοῖς γεωργοῖς ἐκείνοις;","wordsOfJesus":true}]},{"type":"verse","number":41,"content":["Λέγουσιν αὐτῷ, Κακοὺς κακῶς ἀπολέσει αὐτούς, καὶ τὸν ἀμπελῶνα",{"noteId":820},"ἐκδώσεται ἄλλοις γεωργοῖς, οἵτινες ἀποδώσουσιν αὐτῷ τοὺς καρποὺς ἐν τοῖς καιροῖς αὐτῶν."]},{"type":"verse","number":42,"content":["Λέγει αὐτοῖς ὁ Ἰησοῦς,",{"text":"Οὐδέποτε ἀνέγνωτε ἐν ταῖς γραφαῖς,","wordsOfJesus":true},{"lineBreak":true},{"text":"Λίθον ὃν ἀπεδοκίμασαν οἱ οἰκοδομοῦντες,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"οὗτος ἐγενήθη εἰς κεφαλὴν γωνίας·","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"παρὰ Κυρίου ἐγένετο αὕτη,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"καὶ ἔστι θαυμαστὴ ἐν ὀφθαλμοῖς ἡμῶν;","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Διὰ τοῦτο λέγω ὑμῖν ὅτι ἀρθήσεται ἀφ᾽ ὑμῶν ἡ βασιλεία τοῦ Θεοῦ, καὶ δοθήσεται ἔθνει ποιοῦντι τοὺς καρποὺς αὐτῆς.","wordsOfJesus":true}]},{"type":"verse","number":44,"content":[{"text":"Καὶ ὁ πεσὼν ἐπὶ τὸν λίθον τοῦτον συνθλασθήσεται· ἐφ᾽ ὃν δ᾽ ἂν πέσῃ, λικμήσει αὐτόν.","wordsOfJesus":true}]},{"type":"verse","number":45,"content":["Καὶ ἀκούσαντες οἱ ἀρχιερεῖς καὶ οἱ Φαρισαῖοι τὰς παραβολὰς αὐτοῦ ἔγνωσαν ὅτι περὶ αὐτῶν λέγει."]},{"type":"verse","number":46,"content":["Καὶ ζητοῦντες αὐτὸν κρατῆσαι, ἐφοβήθησαν τοὺς ὄχλους,",{"noteId":821},"ἐπειδὴ ὡς προφήτην αὐτὸν εἶχον."]}],"footnotes":[{"noteId":768,"caller":"+","text":"βηθσφαγη ¦ βηθφαγη 𝔐pt CT TR","reference":{"chapter":21,"verse":1}},{"noteId":769,"caller":"+","text":"προς ¦ εις NA SBL WH","reference":{"chapt