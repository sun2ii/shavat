{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"MAT","translationId":"grc_tcg","name":"ΚΑΤΑ ΜΑΤΘΑΙΟΝ","commonName":"ΚΑΤΑ ΜΑΤΘΑΙΟΝ","title":"ΚΑΤΑ ΜΑΤΘΑΙΟΝ","order":40,"numberOfChapters":28,"sha256":"06335047c4ec4dda0ae309f507da1a2504247956d21582d96f042e020e037a3c","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/grc_tcg/MAT/28.json","totalNumberOfVerses":1071},"chapter":{"number":27,"content":[{"type":"heading","content":["Jesus Handed Over to Pontius Pilate"]},{"type":"verse","number":1,"content":["Πρωΐας δὲ γενομένης, συμβούλιον ἔλαβον πάντες οἱ ἀρχιερεῖς καὶ οἱ πρεσβύτεροι",{"noteId":1083},"τοῦ λαοῦ κατὰ τοῦ Ἰησοῦ, ὥστε θανατῶσαι αὐτόν·"]},{"type":"verse","number":2,"content":["καὶ δήσαντες αὐτὸν ἀπήγαγον καὶ παρέδωκαν",{"noteId":1084},"αὐτὸν",{"noteId":1085},"Ποντίῳ Πιλάτῳ τῷ ἡγεμόνι."]},{"type":"heading","content":["Judas Hangs Himself"]},{"type":"verse","number":3,"content":["Τότε ἰδὼν Ἰούδας ὁ",{"noteId":1086},"παραδιδοὺς αὐτὸν ὅτι κατεκρίθη, μεταμεληθεὶς",{"noteId":1087},"ἀπέστρεψε τὰ τριάκοντα ἀργύρια τοῖς ἀρχιερεῦσι καὶ",{"noteId":1088},"τοῖς πρεσβυτέροις,"]},{"type":"verse","number":4,"content":["λέγων, Ἥμαρτον παραδοὺς αἷμα",{"noteId":1089},"ἀθῷον. Οἱ δὲ",{"noteId":1090},"εἶπον, Τί πρὸς ἡμᾶς; Σὺ",{"noteId":1091},"ὄψει."]},{"type":"verse","number":5,"content":["Καὶ ῥίψας τὰ ἀργύρια",{"noteId":1092},"ἐν τῷ ναῷ, ἀνεχώρησε· καὶ ἀπελθὼν ἀπήγξατο."]},{"type":"verse","number":6,"content":["Οἱ δὲ ἀρχιερεῖς λαβόντες τὰ ἀργύρια",{"noteId":1093},"εἶπον, Οὐκ ἔξεστι βαλεῖν αὐτὰ εἰς τὸν κορβανᾶν, ἐπεὶ τιμὴ αἵματός ἐστι."]},{"type":"verse","number":7,"content":["Συμβούλιον δὲ λαβόντες ἠγόρασαν ἐξ αὐτῶν τὸν ἀγρὸν τοῦ κεραμέως, εἰς ταφὴν τοῖς ξένοις."]},{"type":"verse","number":8,"content":["Διὸ ἐκλήθη ὁ ἀγρὸς ἐκεῖνος Ἀγρὸς Αἵματος, ἕως τῆς σήμερον."]},{"type":"verse","number":9,"content":["Τότε ἐπληρώθη τὸ ῥηθὲν διὰ Ἰερεμίου τοῦ προφήτου, λέγοντος, Καὶ ἔλαβον τὰ τριάκοντα ἀργύρια, τὴν τιμὴν τοῦ τετιμημένου, ὃν ἐτιμήσαντο ἀπὸ υἱῶν Ἰσραήλ·"]},{"type":"verse","number":10,"content":["καὶ ἔδωκαν αὐτὰ εἰς τὸν ἀγρὸν τοῦ κεραμέως, καθὰ συνέταξέ μοι Κύριος."]},{"type":"heading","content":["Jesus Faces Pilate"]},{"type":"verse","number":11,"content":["Ὁ δὲ Ἰησοῦς",{"noteId":1094},"ἔστη ἔμπροσθεν τοῦ ἡγεμόνος· καὶ ἐπηρώτησεν αὐτὸν ὁ ἡγεμών, λέγων, Σὺ εἶ ὁ βασιλεὺς τῶν Ἰουδαίων; Ὁ δὲ Ἰησοῦς ἔφη",{"noteId":1095},"αὐτῷ,",{"text":"Σὺ λέγεις.","wordsOfJesus":true}]},{"type":"verse","number":12,"content":["Καὶ ἐν τῷ κατηγορεῖσθαι αὐτὸν ὑπὸ τῶν ἀρχιερέων καὶ",{"noteId":1096},"τῶν πρεσβυτέρων, οὐδὲν ἀπεκρίνατο."]},{"type":"verse","number":13,"content":["Τότε λέγει αὐτῷ ὁ",{"noteId":1097},"Πιλάτος, Οὐκ ἀκούεις πόσα σου καταμαρτυροῦσι;"]},{"type":"verse","number":14,"content":["Καὶ οὐκ ἀπεκρίθη αὐτῷ πρὸς οὐδὲ ἓν ῥῆμα, ὥστε θαυμάζειν τὸν ἡγεμόνα λίαν."]},{"type":"heading","content":["The Crowd Calls For Jesus' Crucifixion"]},{"type":"verse","number":15,"content":["Κατὰ δὲ ἑορτὴν εἰώθει ὁ ἡγεμὼν ἀπολύειν ἕνα τῷ ὄχλῳ δέσμιον, ὃν ἤθελον."]},{"type":"verse","number":16,"content":["Εἶχον δὲ τότε δέσμιον ἐπίσημον, λεγόμενον",{"noteId":1098},"Βαραββᾶν."]},{"type":"verse","number":17,"content":["Συνηγμένων οὖν αὐτῶν, εἶπεν αὐτοῖς ὁ",{"noteId":1099},"Πιλάτος, Τίνα θέλετε ἀπολύσω ὑμῖν;",{"noteId":1100},"Βαραββᾶν, ἢ Ἰησοῦν τὸν λεγόμενον Χριστόν;"]},{"type":"verse","number":18,"content":["ᾜδει γὰρ ὅτι διὰ φθόνον παρέδωκαν αὐτόν."]},{"type":"verse","number":19,"content":["Καθημένου δὲ αὐτοῦ ἐπὶ τοῦ βήματος, ἀπέστειλε πρὸς αὐτὸν ἡ γυνὴ αὐτοῦ, λέγουσα, Μηδέν σοι καὶ τῷ δικαίῳ ἐκείνῳ· πολλὰ γὰρ ἔπαθον σήμερον κατ᾽ ὄναρ δι᾽ αὐτόν."]},{"type":"verse","number":20,"content":["Οἱ δὲ ἀρχιερεῖς καὶ οἱ πρεσβύτεροι ἔπεισαν τοὺς ὄχλους ἵνα αἰτήσωνται τὸν Βαραββᾶν, τὸν δὲ Ἰησοῦν ἀπολέσωσιν."]},{"type":"verse","number":21,"content":["Ἀποκριθεὶς δὲ ὁ ἡγεμὼν εἶπεν αὐτοῖς, Τίνα θέλετε ἀπὸ τῶν δύο ἀπολύσω ὑμῖν; Οἱ δὲ",{"noteId":1101},"εἶπον,",{"noteId":1102},"Βαραββᾶν."]},{"type":"verse","number":22,"content":["Λέγει αὐτοῖς ὁ",{"noteId":1103},"Πιλάτος, Τί οὖν ποιήσω Ἰησοῦν τὸν λεγόμενον Χριστόν; Λέγουσιν",{"noteId":1104},"αὐτῷ πάντες, Σταυρωθήτω."]},{"type":"verse","number":23,"content":["Ὁ δὲ",{"noteId":1105},"ἡγεμὼν ἔφη, Τί γὰρ κακὸν ἐποίησεν; Οἱ δὲ περισσῶς ἔκραζον, λέγοντες, Σταυρωθήτω."]},{"type":"verse","number":24,"content":["Ἰδὼν δὲ ὁ",{"noteId":1106},"Πιλάτος ὅτι οὐδὲν ὠφελεῖ, ἀλλὰ μᾶλλον θόρυβος γίνεται, λαβὼν ὕδωρ, ἀπενίψατο τὰς χεῖρας",{"noteId":1107},"ἀπέναντι τοῦ ὄχλου, λέγων, Ἀθῷός εἰμι ἀπὸ τοῦ αἵματος",{"noteId":1108},"τοῦ δικαίου τούτου· ὑμεῖς ὄψεσθε."]},{"type":"verse","number":25,"content":["Καὶ ἀποκριθεὶς πᾶς ὁ λαὸς εἶπε, Τὸ αἷμα αὐτοῦ ἐφ᾽ ἡμᾶς καὶ ἐπὶ τὰ τέκνα ἡμῶν."]},{"type":"verse","number":26,"content":["Τότε ἀπέλυσεν αὐτοῖς τὸν Βαραββᾶν· τὸν δὲ Ἰησοῦν φραγελλώσας παρέδωκεν ἵνα σταυρωθῇ."]},{"type":"heading","content":["The Soldiers Mock Jesus"]},{"type":"verse","number":27,"content":["Τότε οἱ στρατιῶται τοῦ ἡγεμόνος, παραλαβόντες τὸν Ἰησοῦν εἰς τὸ πραιτώριον, συνήγαγον ἐπ᾽ αὐτὸν ὅλην τὴν σπεῖραν·"]},{"type":"verse","number":28,"content":["καὶ ἐκδύσαντες αὐτόν,",{"noteId":1109},"περιέθηκαν αὐτῷ χλαμύδα κοκκίνην."]},{"type":"verse","number":29,"content":["Καὶ πλέξαντες στέφανον ἐξ ἀκανθῶν, ἐπέθηκαν ἐπὶ",{"noteId":1110},"τὴν κεφαλὴν αὐτοῦ, καὶ κάλαμον",{"noteId":1111},"ἐπὶ τὴν δεξιὰν αὐτοῦ· καὶ γονυπετήσαντες ἔμπροσθεν αὐτοῦ",{"noteId":1112},"ἐνέπαιζον αὐτῷ, λέγοντες, Χαῖρε,",{"noteId":1113},"ὁ βασιλεὺς τῶν Ἰουδαίων·"]},{"type":"verse","number":30,"content":["καὶ ἐμπτύσαντες εἰς αὐτόν, ἔλαβον τὸν κάλαμον, καὶ ἔτυπτον εἰς τὴν κεφαλὴν αὐτοῦ."]},{"type":"verse","number":31,"content":["Καὶ ὅτε ἐνέπαιξαν αὐτῷ, ἐξέδυσαν αὐτὸν τὴν χλαμύδα, καὶ ἐνέδυσαν αὐτὸν τὰ ἱμάτια αὐτοῦ, καὶ ἀπήγαγον αὐτὸν εἰς τὸ σταυρῶσαι."]},{"type":"heading","content":["The Crucifixion"]},{"type":"verse","number":32,"content":["Ἐξερχόμενοι δὲ εὗρον ἄνθρωπον Κυρηναῖον, ὀνόματι Σίμωνα· τοῦτον ἠγγάρευσαν ἵνα ἄρῃ τὸν σταυρὸν αὐτοῦ."]},{"type":"verse","number":33,"content":["Καὶ ἐλθόντες εἰς τόπον λεγόμενον Γολγοθᾶ,",{"noteId":1114},"ὅ ἐστι",{"noteId":1115},"λεγόμενος Κρανίου Τόπος,"]},{"type":"verse","number":34,"content":["ἔδωκαν αὐτῷ πιεῖν",{"noteId":1116},"ὄξος μετὰ χολῆς μεμιγμένον· καὶ γευσάμενος οὐκ",{"noteId":1117},"ἤθελε πιεῖν."]},{"type":"verse","number":35,"content":["Σταυρώσαντες δὲ αὐτόν, διεμερίσαντο τὰ ἱμάτια αὐτοῦ,",{"noteId":1118},"βάλλοντες",{"noteId":1119},"κλῆρον."]},{"type":"verse","number":36,"content":["Καὶ καθήμενοι ἐτήρουν αὐτὸν ἐκεῖ."]},{"type":"verse","number":37,"content":["Καὶ ἐπέθηκαν ἐπάνω τῆς κεφαλῆς αὐτοῦ τὴν αἰτίαν αὐτοῦ γεγραμμένην, Οὗτός ἐστιν Ἰησοῦς ὁ βασιλεὺς τῶν Ἰουδαίων."]},{"type":"verse","number":38,"content":["Τότε σταυροῦνται σὺν αὐτῷ δύο λῃσταί, εἷς ἐκ δεξιῶν καὶ εἷς ἐξ εὐωνύμων."]},{"type":"verse","number":39,"content":["Οἱ δὲ παραπορευόμενοι ἐβλασφήμουν αὐτόν,",{"noteId":1120},"κινοῦντες τὰς κεφαλὰς αὐτῶν,"]},{"type":"verse","number":40,"content":["καὶ λέγοντες, Ὁ καταλύων τὸν ναὸν καὶ ἐν τρισὶν ἡμέραις οἰκοδομῶν, σῶσον σεαυτόν· εἰ υἱὸς εἶ τοῦ Θεοῦ,",{"noteId":1121},"κατάβηθι ἀπὸ τοῦ σταυροῦ."]},{"type":"verse","number":41,"content":["Ὁμοίως",{"noteId":1122},"δὲ καὶ οἱ ἀρχιερεῖς ἐμπαίζοντες μετὰ τῶν γραμματέων καὶ πρεσβυτέρων",{"noteId":1123},"καὶ Φαρισαίων ἔλεγον,"]},{"type":"verse","number":42,"content":["Ἄλλους ἔσωσεν, ἑαυτὸν οὐ δύναται σῶσαι.",{"noteId":1124},"Εἰ βασιλεὺς Ἰσραήλ ἐστι, καταβάτω νῦν ἀπὸ τοῦ σταυροῦ, καὶ",{"noteId":1125},"πιστεύσομεν",{"noteId":1126},"ἐπ᾽ αὐτῷ."]},{"type":"verse","number":43,"content":["Πέποιθεν ἐπὶ τὸν Θεόν· ῥυσάσθω νῦν",{"noteId":1127},"αὐτόν, εἰ θέλει αὐτόν. Εἶπε γὰρ ὅτι Θεοῦ εἰμι υἱός."]},{"type":"verse","number":44,"content":["Τὸ δ᾽ αὐτὸ καὶ οἱ λῃσταὶ οἱ",{"noteId":1128},"συσταυρωθέντες",{"noteId":1129},"αὐτῷ ὠνείδιζον",{"noteId":1130},"αὐτόν."]},{"type":"heading","content":["The Death of Jesus"]},{"type":"verse","number":45,"content":["Ἀπὸ δὲ ἕκτης ὥρας σκότος ἐγένετο ἐπὶ πᾶσαν τὴν γῆν ἕως ὥρας",{"noteId":1131},"ἐνάτης."]},{"type":"verse","number":46,"content":["Περὶ δὲ τὴν",{"noteId":1132},"ἐνάτην ὥραν",{"noteId":1133},"ἀνεβόησεν ὁ Ἰησοῦς φωνῇ μεγάλῃ, λέγων,",{"noteId":1134},{"text":"Ἠλί, Ἠλί,","wordsOfJesus":true},{"noteId":1135},{"text":"λιμὰ","wordsOfJesus":true},{"noteId":1136},{"text":"σαβαχθανί;","wordsOfJesus":true},"Τοῦτ᾽ ἔστι,",{"text":"Θεέ μου, Θεέ μου, ἵνα τί με ἐγκατέλιπες;","wordsOfJesus":true}]},{"type":"verse","number":47,"content":["Τινὲς δὲ τῶν ἐκεῖ",{"noteId":1137},"ἑστώτων ἀκούσαντες ἔλεγον ὅτι",{"noteId":1138},"Ἠλίαν φωνεῖ οὗτος."]},{"type":"verse","number":48,"content":["Καὶ εὐθέως δραμὼν εἷς ἐξ αὐτῶν, καὶ λαβὼν σπόγγον, πλήσας τε ὄξους, καὶ περιθεὶς καλάμῳ, ἐπότιζεν αὐτόν."]},{"type":"verse","number":49,"content":["Οἱ δὲ λοιποὶ",{"noteId":1139},"ἔλεγον, Ἄφες, ἴδωμεν εἰ ἔρχεται",{"noteId":1140},"Ἠλίας σώσων",{"noteId":1141},"αὐτόν."]},{"type":"verse","number":50,"content":["Ὁ δὲ Ἰησοῦς πάλιν κράξας φωνῇ μεγάλῃ ἀφῆκε τὸ πνεῦμα."]},{"type":"verse","number":51,"content":["Καὶ ἰδού, τὸ καταπέτασμα τοῦ ναοῦ ἐσχίσθη",{"noteId":1142},"εἰς δύο ἀπὸ ἄνωθεν ἕως κάτω· καὶ ἡ γῆ ἐσείσθη· καὶ αἱ πέτραι ἐσχίσθησαν·"]},{"type":"verse","number":52,"content":["καὶ τὰ μνημεῖα ἀνεῴχθησαν· καὶ πολλὰ σώματα τῶν κεκοιμημένων ἁγίων",{"noteId":1143},"ἠγέρθη·"]},{"type":"verse","number":53,"content":["καὶ ἐξελθόντες ἐκ τῶν μνημείων μετὰ τὴν ἔγερσιν αὐτοῦ εἰσῆλθον εἰς τὴν ἁγίαν πόλιν, καὶ ἐνεφανίσθησαν πολλοῖς."]},{"type":"verse","number":54,"content":["Ὁ δὲ ἑκατόνταρχος καὶ οἱ μετ᾽ αὐτοῦ τηροῦντες τὸν Ἰησοῦν, ἰδόντες τὸν σεισμὸν καὶ τὰ",{"noteId":1144},"γενόμενα, ἐφοβήθησαν σφόδρα, λέγοντες, Ἀληθῶς Θεοῦ υἱὸς ἦν οὗτος."]},{"type":"verse","number":55,"content":["Ἦσαν δὲ ἐκεῖ",{"noteId":1145},"γυναῖκες πολλαὶ ἀπὸ μακρόθεν θεωροῦσαι, αἵτινες ἠκολούθησαν τῷ Ἰησοῦ ἀπὸ τῆς Γαλιλαίας, διακονοῦσαι αὐτῷ,"]},{"type":"verse","number":56,"content":["ἐν αἷς ἦν Μαρία ἡ Μαγδαληνή, καὶ Μαρία ἡ τοῦ Ἰακώβου καὶ",{"noteId":1146},"Ἰωσῆ μήτηρ, καὶ ἡ μήτηρ τῶν υἱῶν Ζεβεδαίου."]},{"type":"heading","content":["The Burial of Jesus"]},{"type":"verse","number":57,"content":["Ὀψίας δὲ γενομένης, ἦλθεν ἄνθρωπος πλούσιος ἀπὸ Ἀριμαθαίας, τοὔνομα Ἰωσήφ, ὃς καὶ αὐτὸς",{"noteId":1147},"ἐμαθήτευσε τῷ Ἰησοῦ·"]},{"type":"verse","number":58,"content":["οὗτος προσελθὼν τῷ",{"noteId":1148},"Πιλάτῳ, ᾐτήσατο τὸ σῶμα τοῦ Ἰησοῦ. Τότε ὁ",{"noteId":1149},"Πιλάτος ἐκέλευσεν ἀποδοθῆναι",{"noteId":1150},"τὸ σῶμα."]},{"type":"verse","number":59,"content":["Καὶ λαβὼν τὸ σῶμα ὁ Ἰωσὴφ ἐνετύλιξεν αὐτὸ",{"noteId":1151},"σινδόνι καθαρᾷ,"]},{"type":"verse","number":60,"content":["καὶ ἔθηκεν αὐτὸ ἐν τῷ καινῷ αὐτοῦ μνημείῳ, ὃ ἐλατόμησεν ἐν τῇ πέτρᾳ· καὶ προσκυλίσας λίθον μέγαν τῇ θύρᾳ τοῦ μνημείου, ἀπῆλθεν."]},{"type":"verse","number":61,"content":["Ἦν δὲ ἐκεῖ",{"noteId":1152},"Μαρία ἡ Μαγδαληνή, καὶ ἡ ἄλλη Μαρία, καθήμεναι ἀπέναντι τοῦ τάφου."]},{"type":"heading","content":["The Guard at the Tomb"]},{"type":"verse","number":62,"content":["Τῇ δὲ ἐπαύριον, ἥτις ἐστὶ μετὰ τὴν Παρασκευήν, συνήχθησαν οἱ ἀρχιερεῖς καὶ οἱ Φαρισαῖοι πρὸς",{"noteId":1153},"Πιλάτον,"]},{"type":"verse","number":63,"content":["λέγοντες, Κύριε, ἐμνήσθημεν ὅτι ἐκεῖνος ὁ πλάνος εἶπεν ἔτι ζῶν, Μετὰ τρεῖς ἡμέρας ἐγείρομαι."]},{"type":"verse","number":64,"content":["Κέλευσον οὖν ἀσφαλισθῆναι τὸν τάφον ἕως τῆς τρίτης ἡμέρας· μήποτε ἐλθόντες οἱ μαθηταὶ",{"noteId":1154},"αὐτοῦ",{"noteId":1155},"νυκτὸς κλέψωσιν αὐτόν, καὶ εἴπωσι τῷ",{"noteId":1156},"λαῷ, Ἠγέρθη ἀπὸ τῶν νεκρῶν· καὶ ἔσται ἡ ἐσχάτη πλάνη χείρων τῆς πρώτης."]},{"type":"verse","number":65,"content":["Ἔφη",{"noteId":1157},"δὲ αὐτοῖς ὁ",{"noteId":1158},"Πιλάτος, Ἔχετε κουστωδίαν· ὑπάγετε, ἀσφαλίσασθε ὡς οἴδατε."]},{"type":"verse","number":66,"content":["Οἱ δὲ πορευθέντες ἠσφαλίσαντο τὸν τάφον, σφραγίσαντες τὸν λίθον, μετὰ τῆς κουστωδίας."]}],"footnotes":[{"noteId":1083,"caller":"+","text":"του λαου ¦ — PCK","reference":{"chapter":27,"verse":1}},{"noteId":1084,"caller":"+","text":"αυτον ¦ — CT","reference":{"chapter":27,"verse":2}},{"noteId":1085,"caller":"+","text":"ποντιω πιλατω ¦ πιλατω NA SBL ¦ πειλατω TH WH","reference":{"chapter":27,"verse":2}},{"noteId":1086,"caller":"+","text":"παραδιδους ¦ παραδους TH WH","reference":{"chapter":27,"verse":3}},{"noteId":1087,"caller":"+","text":"απεστρεψε ¦ εστρεψε CT","reference":{"chapter":27,"verse":3}},{"noteId":1088,"caller":"+","text":"τοις ¦ — CT","reference":{"chapter":27,"verse":3}},{"noteId":1089,"caller":"+","text":"αθωον ¦ δικαιον WH","reference":{"chapter":27,"verse":4}},{"noteId":1090,"caller":"+","text":"ειπον ¦ ειπαν NA SBL WH","reference":{"chapter":27,"verse":4}},{"noteId":1091,"caller":"+","text":"οψει ¦ οψη CT","reference":{"chapter":27,"verse":4}},{"noteId":1092,"caller":"+","text":"εν τω ναω 98.3% ¦ εις τον ναον CT 1.3%","reference":{"chapter":27,"verse":5}},{"noteId":1093,"caller":"+","text":"ειπον ¦ ειπαν NA SBL WH","reference":{"chapter":27,"verse":6}},{"noteId":1094,"caller":"+","text":"εστη ¦ εσταθη CT","reference":{"chapter":27,"verse":11}},{"noteId":1095,"caller":"+","text":"αυτω ¦ — NA SBL WH","reference":{"chapter":27,"verse":11}},{"noteId":1096,"caller":"+","text":"των ¦ — CT PCK","reference":{"chapter":27,"verse":12}},{"noteId":1097,"caller":"+","text":"πιλατος ¦ πειλατος TH WH","reference":{"chapter":27,"verse":13}},{"noteId":1098,"caller":"+","text":"βαραββαν ¦ ιησουν βαραββαν NA SBL","reference":{"chapter":27,"verse":16}},{"noteId":1099,"caller":"+","text":"πιλατος ¦ πειλατος TH WH","reference":{"chapter":27,"verse":17}},{"noteId":1100,"caller":"+","text":