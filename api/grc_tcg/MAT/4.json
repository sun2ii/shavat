{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"MAT","translationId":"grc_tcg","name":"ΚΑΤΑ ΜΑΤΘΑΙΟΝ","commonName":"ΚΑΤΑ ΜΑΤΘΑΙΟΝ","title":"ΚΑΤΑ ΜΑΤΘΑΙΟΝ","order":40,"numberOfChapters":28,"sha256":"06335047c4ec4dda0ae309f507da1a2504247956d21582d96f042e020e037a3c","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/grc_tcg/MAT/28.json","totalNumberOfVerses":1071},"chapter":{"number":4,"content":[{"type":"heading","content":["The Temptation of Jesus"]},{"type":"verse","number":1,"content":["Τότε ὁ Ἰησοῦς ἀνήχθη εἰς τὴν ἔρημον ὑπὸ τοῦ πνεύματος, πειρασθῆναι ὑπὸ τοῦ διαβόλου."]},{"type":"verse","number":2,"content":["Καὶ νηστεύσας ἡμέρας",{"noteId":61},"τεσσαράκοντα καὶ νύκτας",{"noteId":62},"τεσσαράκοντα, ὕστερον ἐπείνασε."]},{"type":"verse","number":3,"content":["Καὶ προσελθὼν",{"noteId":63},"αὐτῷ ὁ πειράζων εἶπεν, Εἰ υἱὸς εἶ τοῦ Θεοῦ,",{"noteId":64},"εἰπὲ ἵνα οἱ λίθοι οὗτοι ἄρτοι γένωνται."]},{"type":"verse","number":4,"content":["Ὁ δὲ ἀποκριθεὶς εἶπε,",{"text":"Γέγραπται,","wordsOfJesus":true},{"lineBreak":true},{"text":"Οὐκ ἐπ᾽ ἄρτῳ μόνῳ ζήσεται","wordsOfJesus":true,"poem":1},{"noteId":65},{"text":"ἄνθρωπος,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"ἀλλ᾽ ἐπὶ παντὶ ῥήματι ἐκπορευομένῳ διὰ στόματος Θεοῦ.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":["Τότε παραλαμβάνει αὐτὸν ὁ διάβολος εἰς τὴν ἁγίαν πόλιν, καὶ",{"noteId":66},"ἵστησιν αὐτὸν ἐπὶ τὸ πτερύγιον τοῦ ἱεροῦ,"]},{"type":"verse","number":6,"content":["καὶ λέγει αὐτῷ, Εἰ υἱὸς εἶ τοῦ Θεοῦ, βάλε σεαυτὸν κάτω· γέγραπται γὰρ ὅτι",{"lineBreak":true},{"text":"Τοῖς ἀγγέλοις αὐτοῦ ἐντελεῖται περὶ σοῦ·","poem":1},{"lineBreak":true},"καί,",{"lineBreak":true},{"text":"Ἐπὶ χειρῶν ἀροῦσί σε,","poem":1},{"lineBreak":true},{"text":"μήποτε προσκόψῃς πρὸς λίθον τὸν πόδα σου.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":["Ἔφη αὐτῷ ὁ Ἰησοῦς,",{"text":"Πάλιν γέγραπται, Οὐκ ἐκπειράσεις Κύριον τὸν Θεόν σου.","wordsOfJesus":true}]},{"type":"verse","number":8,"content":["Πάλιν παραλαμβάνει αὐτὸν ὁ διάβολος εἰς ὄρος ὑψηλὸν λίαν, καὶ δείκνυσιν αὐτῷ πάσας τὰς βασιλείας τοῦ κόσμου καὶ τὴν δόξαν αὐτῶν,"]},{"type":"verse","number":9,"content":["καὶ",{"noteId":67},"λέγει αὐτῷ, Ταῦτα",{"noteId":68},"πάντα σοι δώσω, ἐὰν πεσὼν προσκυνήσῃς μοι."]},{"type":"verse","number":10,"content":["Τότε λέγει αὐτῷ ὁ Ἰησοῦς,",{"text":"Ὕπαγε","wordsOfJesus":true},{"noteId":69},{"text":"ὀπίσω μου, Σατανᾶ· γέγραπται γάρ,","wordsOfJesus":true},{"lineBreak":true},{"text":"Κύριον τὸν Θεόν σου προσκυνήσεις,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"καὶ αὐτῷ μόνῳ λατρεύσεις.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":["Τότε ἀφίησιν αὐτὸν ὁ διάβολος· καὶ ἰδού, ἄγγελοι προσῆλθον καὶ διηκόνουν αὐτῷ."]},{"type":"heading","content":["Jesus Begins His Ministry"]},{"type":"verse","number":12,"content":["Ἀκούσας δὲ",{"noteId":70},"ὁ Ἰησοῦς ὅτι",{"noteId":71},"Ἰωάννης παρεδόθη, ἀνεχώρησεν εἰς τὴν Γαλιλαίαν·"]},{"type":"verse","number":13,"content":["καὶ καταλιπὼν τὴν",{"noteId":72},"Ναζαρέτ, ἐλθὼν κατῴκησεν εἰς",{"noteId":73},"Καπερναοὺμ τὴν παραθαλασσίαν, ἐν ὁρίοις Ζαβουλὼν καὶ",{"noteId":74},"Νεφθαλείμ·"]},{"type":"verse","number":14,"content":["ἵνα πληρωθῇ τὸ ῥηθὲν διὰ Ἠσαΐου τοῦ προφήτου, λέγοντος,"]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Γῆ Ζαβουλὼν καὶ γῆ","poem":1},{"noteId":75},{"text":"Νεφθαλείμ,","poem":1},{"lineBreak":true},{"text":"ὁδὸν θαλάσσης, πέραν τοῦ Ἰορδάνου, Γαλιλαία τῶν ἐθνῶν,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ὁ λαὸς ὁ καθήμενος ἐν","poem":1},{"noteId":76},{"text":"σκότει","poem":1},{"lineBreak":true},{"noteId":77},{"text":"εἶδε φῶς μέγα,","poem":1},{"lineBreak":true},{"text":"καὶ τοῖς καθημένοις ἐν χώρᾳ καὶ σκιᾷ θανάτου,","poem":1},{"lineBreak":true},{"text":"φῶς ἀνέτειλεν αὐτοῖς.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":["Ἀπὸ τότε ἤρξατο ὁ Ἰησοῦς κηρύσσειν καὶ λέγειν,",{"text":"Μετανοεῖτε· ἤγγικε γὰρ ἡ βασιλεία τῶν οὐρανῶν.","wordsOfJesus":true}]},{"type":"heading","content":["Jesus Calls His First Disciples"]},{"type":"verse","number":18,"content":["Περιπατῶν",{"noteId":78},"δὲ παρὰ τὴν θάλασσαν τῆς Γαλιλαίας εἶδε δύο ἀδελφούς, Σίμωνα τὸν λεγόμενον Πέτρον, καὶ Ἀνδρέαν τὸν ἀδελφὸν αὐτοῦ, βάλλοντας ἀμφίβληστρον εἰς τὴν θάλασσαν· ἦσαν γὰρ",{"noteId":79},"ἁλιεῖς."]},{"type":"verse","number":19,"content":["Καὶ λέγει αὐτοῖς,",{"text":"Δεῦτε ὀπίσω μου, καὶ ποιήσω ὑμᾶς","wordsOfJesus":true},{"noteId":80},{"text":"ἁλιεῖς ἀνθρώπων.","wordsOfJesus":true}]},{"type":"verse","number":20,"content":["Οἱ δὲ εὐθέως ἀφέντες τὰ δίκτυα ἠκολούθησαν αὐτῷ."]},{"type":"verse","number":21,"content":["Καὶ προβὰς ἐκεῖθεν, εἶδεν ἄλλους δύο ἀδελφούς, Ἰάκωβον τὸν τοῦ Ζεβεδαίου καὶ",{"noteId":81},"Ἰωάννην τὸν ἀδελφὸν αὐτοῦ, ἐν τῷ πλοίῳ μετὰ Ζεβεδαίου τοῦ πατρὸς αὐτῶν, καταρτίζοντας τὰ δίκτυα αὐτῶν· καὶ ἐκάλεσεν αὐτούς."]},{"type":"verse","number":22,"content":["Οἱ δὲ εὐθέως ἀφέντες τὸ πλοῖον καὶ τὸν πατέρα αὐτῶν ἠκολούθησαν αὐτῷ."]},{"type":"heading","content":["Jesus Ministers to Great Crowds"]},{"type":"verse","number":23,"content":["Καὶ περιῆγεν",{"noteId":82},"ὅλην τὴν Γαλιλαίαν ὁ Ἰησοῦς, διδάσκων ἐν ταῖς συναγωγαῖς αὐτῶν, καὶ κηρύσσων τὸ εὐαγγέλιον τῆς βασιλείας, καὶ θεραπεύων πᾶσαν νόσον καὶ πᾶσαν μαλακίαν ἐν τῷ λαῷ."]},{"type":"verse","number":24,"content":["Καὶ ἀπῆλθεν ἡ ἀκοὴ αὐτοῦ εἰς ὅλην τὴν Συρίαν· καὶ προσήνεγκαν αὐτῷ πάντας τοὺς κακῶς ἔχοντας, ποικίλαις νόσοις καὶ βασάνοις συνεχομένους,",{"noteId":83},"καὶ δαιμονιζομένους, καὶ σεληνιαζομένους, καὶ παραλυτικούς· καὶ ἐθεράπευσεν αὐτούς."]},{"type":"verse","number":25,"content":["Καὶ ἠκολούθησαν αὐτῷ ὄχλοι πολλοὶ ἀπὸ τῆς Γαλιλαίας καὶ Δεκαπόλεως καὶ Ἱεροσολύμων καὶ Ἰουδαίας καὶ πέραν τοῦ Ἰορδάνου."]}],"footnotes":[{"noteId":61,"caller":"+","text":"τεσσαρακοντα ¦ τεσσερακοντα CT","reference":{"chapter":4,"verse":2}},{"noteId":62,"caller":"+","text":"τεσσαρακοντα ¦ τεσσερακοντα CT","reference":{"chapter":4,"verse":2}},{"noteId":63,"caller":"+","text":"αυτω ο πειραζων ειπεν ¦ ο πειραζων ειπεν αυτω CT","reference":{"chapter":4,"verse":3}},{"noteId":64,"caller":"+","text":"ειπε ¦ ειπον WH","reference":{"chapter":4,"verse":3}},{"noteId":65,"caller":"+","text":"ανθρωπος ¦ ο ανθρωπος CT","reference":{"chapter":4,"verse":4}},{"noteId":66,"caller":"+","text":"ιστησιν ¦ εστησεν CT","reference":{"chapter":4,"verse":5}},{"noteId":67,"caller":"+","text":"λεγει ¦ ειπεν CT","reference":{"chapter":4,"verse":9}},{"noteId":68,"caller":"+","text":"παντα σοι ¦ σοι παντα CT","reference":{"chapter":4,"verse":9}},{"noteId":69,"caller":"+","text":"οπισω μου 87.6% ¦ — CT TR 11.7%","reference":{"chapter":4,"verse":10}},{"noteId":70,"caller":"+","text":"ο ιησους ¦ — CT","reference":{"chapter":4,"verse":12}},{"noteId":71,"caller":"+","text":"ιωαννης ¦ ιωανης WH","reference":{"chapter":4,"verse":12}},{"noteId":72,"caller":"+","text":"ναζαρετ ¦ ναζαρεθ SCR ¦ ναζαρα CT","reference":{"chapter":4,"verse":13}},{"noteId":73,"caller":"+","text":"καπερναουμ ¦ καφαρναουμ CT","reference":{"chapter":4,"verse":13}},{"noteId":74,"caller":"+","text":"νεφθαλειμ ¦ νεφθαλιμ NA SBL","reference":{"chapter":4,"verse":13}},{"noteId":75,"caller":"+","text":"νεφθαλειμ ¦ νεφθαλιμ NA SBL","reference":{"chapter":4,"verse":15}},{"noteId":76,"caller":"+","text":"σκοτει ¦ σκο