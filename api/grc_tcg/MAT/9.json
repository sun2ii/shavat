{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"MAT","translationId":"grc_tcg","name":"ΚΑΤΑ ΜΑΤΘΑΙΟΝ","commonName":"ΚΑΤΑ ΜΑΤΘΑΙΟΝ","title":"ΚΑΤΑ ΜΑΤΘΑΙΟΝ","order":40,"numberOfChapters":28,"sha256":"06335047c4ec4dda0ae309f507da1a2504247956d21582d96f042e020e037a3c","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/grc_tcg/MAT/28.json","totalNumberOfVerses":1071},"chapter":{"number":9,"content":[{"type":"heading","content":["Jesus Heals a Paralytic"]},{"type":"verse","number":1,"content":["Καὶ ἐμβὰς εἰς",{"noteId":212},"τὸ πλοῖον διεπέρασε καὶ ἦλθεν εἰς τὴν ἰδίαν πόλιν."]},{"type":"verse","number":2,"content":["Καὶ ἰδού, προσέφερον αὐτῷ παραλυτικὸν ἐπὶ",{"noteId":213},"κλίνης βεβλημένον· καὶ ἰδὼν ὁ Ἰησοῦς τὴν πίστιν αὐτῶν εἶπε τῷ παραλυτικῷ,",{"text":"Θάρσει, τέκνον·","wordsOfJesus":true},{"noteId":214},{"text":"ἀφέωνταί","wordsOfJesus":true},{"noteId":215},{"text":"σοι αἱ ἁμαρτίαι σου.","wordsOfJesus":true}]},{"type":"verse","number":3,"content":["Καὶ ἰδού, τινὲς τῶν γραμματέων",{"noteId":216},"εἶπον ἐν ἑαυτοῖς, Οὗτος βλασφημεῖ."]},{"type":"verse","number":4,"content":["Καὶ",{"noteId":217},"ἰδὼν ὁ Ἰησοῦς τὰς ἐνθυμήσεις αὐτῶν εἶπεν,",{"text":"Ἵνα τί","wordsOfJesus":true},{"noteId":218},{"text":"ὑμεῖς ἐνθυμεῖσθε πονηρὰ ἐν ταῖς καρδίαις ὑμῶν;","wordsOfJesus":true}]},{"type":"verse","number":5,"content":[{"text":"Τί γάρ ἐστιν εὐκοπώτερον, εἰπεῖν,","wordsOfJesus":true},{"noteId":219},{"text":"Ἀφέωνταί","wordsOfJesus":true},{"noteId":220},{"text":"σου αἱ ἁμαρτίαι· ἢ εἰπεῖν,","wordsOfJesus":true},{"noteId":221},{"text":"Ἔγειραι καὶ περιπάτει;","wordsOfJesus":true}]},{"type":"verse","number":6,"content":[{"text":"Ἵνα δὲ εἰδῆτε, ὅτι ἐξουσίαν ἔχει ὁ υἱὸς τοῦ ἀνθρώπου ἐπὶ τῆς γῆς ἀφιέναι ἁμαρτίας","wordsOfJesus":true},"—τότε λέγει τῷ παραλυτικῷ—",{"noteId":222},{"text":"Ἐγερθεὶς ἆρόν σου τὴν","wordsOfJesus":true},{"noteId":223},{"text":"κλίνην, καὶ ὕπαγε εἰς τὸν οἶκόν σου.","wordsOfJesus":true}]},{"type":"verse","number":7,"content":["Καὶ ἐγερθεὶς ἀπῆλθεν εἰς τὸν οἶκον αὐτοῦ."]},{"type":"verse","number":8,"content":["Ἰδόντες δὲ οἱ ὄχλοι",{"noteId":224},"ἐθαύμασαν, καὶ ἐδόξασαν τὸν Θεόν, τὸν δόντα ἐξουσίαν τοιαύτην τοῖς ἀνθρώποις."]},{"type":"heading","content":["Jesus Calls Matthew"]},{"type":"verse","number":9,"content":["Καὶ παράγων ὁ Ἰησοῦς ἐκεῖθεν εἶδεν ἄνθρωπον καθήμενον ἐπὶ τὸ τελώνιον,",{"noteId":225},"Ματθαῖον λεγόμενον, καὶ λέγει αὐτῷ,",{"text":"Ἀκολούθει μοι.","wordsOfJesus":true},"Καὶ ἀναστὰς ἠκολούθησεν αὐτῷ."]},{"type":"verse","number":10,"content":["Καὶ ἐγένετο αὐτοῦ ἀνακειμένου ἐν τῇ οἰκίᾳ, καὶ ἰδού, πολλοὶ τελῶναι καὶ ἁμαρτωλοὶ ἐλθόντες συνανέκειντο τῷ Ἰησοῦ καὶ τοῖς μαθηταῖς αὐτοῦ."]},{"type":"verse","number":11,"content":["Καὶ ἰδόντες οἱ Φαρισαῖοι",{"noteId":226},"εἶπον τοῖς μαθηταῖς αὐτοῦ, Διὰ τί μετὰ τῶν τελωνῶν καὶ ἁμαρτωλῶν",{"noteId":227},"ἐσθίει ὁ διδάσκαλος ὑμῶν;"]},{"type":"verse","number":12,"content":["Ὁ δὲ",{"noteId":228},"Ἰησοῦς ἀκούσας εἶπεν",{"noteId":229},"αὐτοῖς,",{"text":"Οὐ χρείαν ἔχουσιν οἱ ἰσχύοντες ἰατροῦ,","wordsOfJesus":true},{"noteId":230},{"text":"ἀλλ᾽ οἱ κακῶς ἔχοντες.","wordsOfJesus":true}]},{"type":"verse","number":13,"content":[{"text":"Πορευθέντες δὲ μάθετε τί ἐστιν,","wordsOfJesus":true},{"noteId":231},{"text":"Ἔλεον θέλω, καὶ οὐ θυσίαν· οὐ γὰρ ἦλθον καλέσαι δικαίους,","wordsOfJesus":true},{"noteId":232},{"text":"ἀλλὰ ἁμαρτωλοὺς","wordsOfJesus":true},{"noteId":233},{"text":"εἰς μετάνοιαν.","wordsOfJesus":true}]},{"type":"heading","content":["A Question About Fasting"]},{"type":"verse","number":14,"content":["Τότε προσέρχονται αὐτῷ οἱ μαθηταὶ",{"noteId":234},"Ἰωάννου, λέγοντες, Διὰ τί ἡμεῖς καὶ οἱ Φαρισαῖοι νηστεύομεν",{"noteId":235},"πολλά, οἱ δὲ μαθηταί σου οὐ νηστεύουσι;"]},{"type":"verse","number":15,"content":["Καὶ εἶπεν αὐτοῖς ὁ Ἰησοῦς,",{"text":"Μὴ δύνανται οἱ υἱοὶ τοῦ νυμφῶνος πενθεῖν, ἐφ᾽","wordsOfJesus":true},{"noteId":236},{"text":"ὅσον μετ᾽ αὐτῶν ἐστιν ὁ νυμφίος; Ἐλεύσονται δὲ ἡμέραι ὅταν ἀπαρθῇ ἀπ᾽ αὐτῶν ὁ νυμφίος, καὶ τότε νηστεύσουσιν.","wordsOfJesus":true}]},{"type":"verse","number":16,"content":[{"text":"Οὐδεὶς δὲ ἐπιβάλλει ἐπίβλημα ῥάκους ἀγνάφου ἐπὶ ἱματίῳ παλαιῷ· αἴρει γὰρ τὸ πλήρωμα αὐτοῦ ἀπὸ τοῦ ἱματίου, καὶ χεῖρον σχίσμα γίνεται.","wordsOfJesus":true}]},{"type":"verse","number":17,"content":[{"text":"Οὐδὲ βάλλουσιν οἶνον νέον εἰς ἀσκοὺς παλαιούς· εἰ δὲ μήγε, ῥήγνυνται οἱ ἀσκοί, καὶ ὁ οἶνος ἐκχεῖται, καὶ οἱ ἀσκοὶ","wordsOfJesus":true},{"noteId":237},{"text":"ἀπολοῦνται· ἀλλὰ","wordsOfJesus":true},{"noteId":238},{"text":"βάλλουσιν οἶνον νέον εἰς ἀσκοὺς καινούς, καὶ","wordsOfJesus":true},{"noteId":239},{"text":"ἀμφότεροι συντηροῦνται.","wordsOfJesus":true}]},{"type":"heading","content":["A Girl Restored to Life and a Woman Healed"]},{"type":"verse","number":18,"content":["Ταῦτα αὐτοῦ λαλοῦντος αὐτοῖς, ἰδού, ἄρχων",{"noteId":240},"εἷς",{"noteId":241},"ἐλθὼν προσεκύνει αὐτῷ, λέγων ὅτι Ἡ θυγάτηρ μου ἄρτι ἐτελεύτησεν·",{"noteId":242},"ἀλλὰ ἐλθὼν ἐπίθες τὴν χεῖρά σου ἐπ᾽ αὐτήν, καὶ ζήσεται."]},{"type":"verse","number":19,"content":["Καὶ ἐγερθεὶς ὁ Ἰησοῦς",{"noteId":243},"ἠκολούθησεν αὐτῷ καὶ οἱ μαθηταὶ αὐτοῦ."]},{"type":"verse","number":20,"content":["Καὶ ἰδού, γυνὴ αἱμορροοῦσα δώδεκα ἔτη, προσελθοῦσα ὄπισθεν, ἥψατο τοῦ κρασπέδου τοῦ ἱματίου αὐτοῦ."]},{"type":"verse","number":21,"content":["Ἔλεγε γὰρ ἐν ἑαυτῇ, Ἐὰν μόνον ἅψωμαι τοῦ ἱματίου αὐτοῦ, σωθήσομαι."]},{"type":"verse","number":22,"content":["Ὁ δὲ Ἰησοῦς",{"noteId":244},"ἐπιστραφεὶς καὶ ἰδὼν αὐτὴν εἶπε,",{"text":"Θάρσει, θύγατερ· ἡ πίστις σου σέσωκέ σε.","wordsOfJesus":true},"Καὶ ἐσώθη ἡ γυνὴ ἀπὸ τῆς ὥρας ἐκείνης."]},{"type":"verse","number":23,"content":["Καὶ ἐλθὼν ὁ Ἰησοῦς εἰς τὴν οἰκίαν τοῦ ἄρχοντος, καὶ ἰδὼν τοὺς αὐλητὰς καὶ τὸν ὄχλον θορυβούμενον,"]},{"type":"verse","number":24,"content":[{"noteId":245},"λέγει αὐτοῖς,",{"text":"Ἀναχωρεῖτε· οὐ γὰρ ἀπέθανε τὸ κοράσιον, ἀλλὰ καθεύδει.","wordsOfJesus":true},"Καὶ κατεγέλων αὐτοῦ."]},{"type":"verse","number":25,"content":["Ὅτε δὲ ἐξεβλήθη ὁ ὄχλος, εἰσελθὼν ἐκράτησε τῆς χειρὸς αὐτῆς, καὶ ἠγέρθη τὸ κοράσιον."]},{"type":"verse","number":26,"content":["Καὶ ἐξῆλθεν ἡ φήμη αὕτη εἰς ὅλην τὴν γῆν ἐκείνην."]},{"type":"heading","content":["Jesus Heals Two Blind Men"]},{"type":"verse","number":27,"content":["Καὶ παράγοντι ἐκεῖθεν τῷ Ἰησοῦ, ἠκολούθησαν",{"noteId":246},"αὐτῷ δύο τυφλοί, κράζοντες καὶ λέγοντες, Ἐλέησον ἡμᾶς,",{"noteId":247},"υἱὲ",{"noteId":248},"Δαυίδ."]},{"type":"verse","number":28,"content":["Ἐλθόντι δὲ εἰς τὴν οἰκίαν,",{"noteId":249},"προσῆλθον αὐτῷ οἱ τυφλοί, καὶ λέγει αὐτοῖς",{"noteId":250},"ὁ Ἰησοῦς,",{"text":"Πιστεύετε ὅτι δύναμαι τοῦτο ποιῆσαι;","wordsOfJesus":true},"Λέγουσιν αὐτῷ, Ναί, Κύριε."]},{"type":"verse","number":29,"content":["Τότε ἥψατο τῶν ὀφθαλμῶν αὐτῶν, λέγων,",{"text":"Κατὰ τὴν πίστιν ὑμῶν γενηθήτω ὑμῖν.","wordsOfJesus":true}]},{"type":"verse","number":30,"content":["Καὶ",{"noteId":251},"ἀνεῴχθησαν αὐτῶν οἱ ὀφθαλμοί· καὶ",{"noteId":252},"ἐνεβριμήσατο αὐτοῖς ὁ Ἰησοῦς, λέγων,",{"text":"Ὁρᾶτε μηδεὶς γινωσκέτω.","wordsOfJesus":true}]},{"type":"verse","number":31,"content":["Οἱ δὲ ἐξελθόντες διεφήμισαν αὐτὸν ἐν ὅλῃ τῇ γῇ ἐκείνῃ."]},{"type":"heading","content":["Jesus Heals a Mute Man"]},{"type":"verse","number":32,"content":["Αὐτῶν δὲ ἐξερχομένων, ἰδού, προσήνεγκαν αὐτῷ",{"noteId":253},"ἄνθρωπον κωφὸν δαιμονιζόμενον."]},{"type":"verse","number":33,"content":["Καὶ ἐκβληθέντος τοῦ δαιμονίου, ἐλάλησεν ὁ κωφός· καὶ ἐθαύμασαν οἱ ὄχλοι,",{"noteId":254},"λέγοντες, Οὐδέποτε ἐφάνη οὕτως ἐν τῷ Ἰσραήλ."]},{"type":"verse","number":34,"content":["Οἱ δὲ Φαρισαῖοι ἔλεγον, Ἐν τῷ ἄρχοντι τῶν δαιμονίων ἐκβάλλει τὰ δαιμόνια."]},{"type":"heading","content":["The Compassion of Jesus"]},{"type":"verse","number":35,"content":["Καὶ περιῆγεν ὁ Ἰησοῦς τὰς πόλεις πάσας καὶ τὰς κώμας, διδάσκων ἐν ταῖς συναγωγαῖς αὐτῶν, καὶ κηρύσσων τὸ εὐαγγέλιον τῆς βασιλείας, καὶ θεραπεύων πᾶσαν νόσον καὶ πᾶσαν μαλακίαν",{"noteId":255},"ἐν τῷ λαῷ."]},{"type":"verse","number":36,"content":["Ἰδὼν δὲ τοὺς ὄχλους, ἐσπλαγχνίσθη περὶ αὐτῶν, ὅτι ἦσαν",{"noteId":256},"ἐσκυλμένοι καὶ",{"noteId":257},"ἐρριμμένοι",{"noteId":258},"ὡσεὶ πρόβατα μὴ ἔχοντα ποιμένα."]},{"type":"verse","number":37,"content":["Τότε λέγει τοῖς μαθηταῖς αὐτοῦ,",{"text":"Ὁ μὲν θερισμὸς πολύς, οἱ δὲ ἐργάται ὀλίγοι·","wordsOfJesus":true}]},{"type":"verse","number":38,"content":[{"text":"δεήθητε οὖν τοῦ Κυρίου τοῦ θερισμοῦ, ὅπως ἐκβάλῃ ἐργάτας εἰς τὸν θερισμὸν αὐτοῦ.","wordsOfJesus":true}]}],"footnotes":[{"noteId":212,"caller":"+","text":"το ¦ — ANT CT","reference":{"chapter":9,"verse":1}},{"noteId":213,"caller":"+","text":"κλινης ¦ κλεινης TH","reference":{"chapter":9,"verse":2}},{"noteId":214,"caller":"+","text":"αφεωνται ¦ αφιενται CT","reference":{"chapter":9,"verse":2}},{"noteId":215,"caller":"+","text":"σοι αι αμαρτιαι σου ¦ σου αι αμαρτιαι CT","reference":{"chapter":9,"verse":2}},{"noteId":216,"caller":"+","text":"ειπον ¦ ειπαν NA SBL WH","reference":{"chapter":9,"verse":3}},{"noteId":217,"caller":"+","text":"ιδων 64% ¦ ειδως 𝔐pt PCK SBL TH WH 32.7%","reference":{"chapter":9,"verse":4}},{"noteId":218,"caller":"+","text":"υμεις ¦ — CT","reference":{"chapter":9,"verse":4}},{"noteId":219,"caller":"+","text":"αφεωνται ¦ αφιενται CT","reference":{"chapter":9,"verse":5}},{"noteId":220,"caller":"+","text":"σου ¦ σοι 𝔐pt TR","reference":{"chapter":9,"verse":5}},{"noteId":221,"caller":"+","text":"εγειραι ¦ εγειρε ANT CT","reference":{"chapter":9,"verse":5}},{"noteId":222,"caller":"+","text":"εγ