{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"MRK","translationId":"grc_tcg","name":"ΚΑΤΑ ΜΑΡΚΟΝ","commonName":"ΚΑΤΑ ΜΑΡΚΟΝ","title":"ΚΑΤΑ ΜΑΡΚΟΝ","order":41,"numberOfChapters":16,"sha256":"458ddb37b7c88bd21fa977538125daa8129b125491fad25357901af5ebb1abc8","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/MRK/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/grc_tcg/MRK/16.json","totalNumberOfVerses":678},"chapter":{"number":1,"content":[{"type":"heading","content":["The Preaching of John the Baptist"]},{"type":"verse","number":1,"content":["Ἀρχὴ τοῦ εὐαγγελίου Ἰησοῦ Χριστοῦ,",{"noteId":0},"υἱοῦ τοῦ Θεοῦ."]},{"type":"verse","number":2,"content":[{"noteId":1},"Ὡς γέγραπται ἐν",{"noteId":2},"τοῖς προφήταις,",{"lineBreak":true},{"text":"Ἰδού,","poem":1},{"noteId":3},{"text":"ἐγὼ ἀποστέλλω τὸν ἄγγελόν μου πρὸ προσώπου σου,","poem":1},{"lineBreak":true},{"text":"ὃς κατασκευάσει τὴν ὁδόν σου","poem":1},{"noteId":4},{"text":"ἔμπροσθέν σου.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Φωνὴ βοῶντος ἐν τῇ ἐρήμῳ,","poem":1},{"lineBreak":true},{"text":"Ἑτοιμάσατε τὴν ὁδὸν Κυρίου·","poem":1},{"lineBreak":true},{"text":"εὐθείας ποιεῖτε τὰς τρίβους αὐτοῦ,","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":["ἐγένετο",{"noteId":5},"Ἰωάννης",{"noteId":6},"βαπτίζων ἐν τῇ ἐρήμῳ, καὶ κηρύσσων βάπτισμα μετανοίας εἰς ἄφεσιν ἁμαρτιῶν."]},{"type":"verse","number":5,"content":["Καὶ ἐξεπορεύετο πρὸς αὐτὸν πᾶσα ἡ Ἰουδαία χώρα, καὶ οἱ",{"noteId":7},"Ἱεροσολυμῖται,",{"noteId":8},"καὶ ἐβαπτίζοντο πάντες",{"noteId":9},"ἐν τῷ Ἰορδάνῃ ποταμῷ ὑπ᾽ αὐτοῦ, ἐξομολογούμενοι τὰς ἁμαρτίας αὐτῶν."]},{"type":"verse","number":6,"content":[{"noteId":10},"Ἦν δὲ",{"noteId":11},"ὁ",{"noteId":12},"Ἰωάννης ἐνδεδυμένος τρίχας καμήλου, καὶ ζώνην δερματίνην περὶ τὴν ὀσφὺν αὐτοῦ, καὶ",{"noteId":13},"ἐσθίων ἀκρίδας καὶ μέλι ἄγριον."]},{"type":"verse","number":7,"content":["Καὶ ἐκήρυσσε, λέγων, Ἔρχεται ὁ ἰσχυρότερός μου ὀπίσω μου, οὗ οὐκ εἰμὶ ἱκανὸς κύψας λῦσαι τὸν ἱμάντα τῶν ὑποδημάτων αὐτοῦ."]},{"type":"verse","number":8,"content":["Ἐγὼ",{"noteId":14},"μὲν ἐβάπτισα ὑμᾶς",{"noteId":15},"ἐν ὕδατι· αὐτὸς δὲ βαπτίσει ὑμᾶς",{"noteId":16},"ἐν Πνεύματι Ἁγίῳ."]},{"type":"heading","content":["The Baptism of Jesus"]},{"type":"verse","number":9,"content":["Καὶ ἐγένετο ἐν ἐκείναις ταῖς ἡμέραις, ἦλθεν",{"noteId":17},"Ἰησοῦς ἀπὸ",{"noteId":18},"Ναζαρὲτ τῆς Γαλιλαίας, καὶ ἐβαπτίσθη",{"noteId":19},"ὑπὸ Ἰωάννου εἰς τὸν Ἰορδάνην."]},{"type":"verse","number":10,"content":["Καὶ",{"noteId":20},"εὐθέως ἀναβαίνων",{"noteId":21},"ἀπὸ τοῦ ὕδατος, εἶδε σχιζομένους τοὺς οὐρανούς, καὶ τὸ πνεῦμα",{"noteId":22},"ὡσεὶ περιστερὰν καταβαῖνον",{"noteId":23},"ἐπ᾽ αὐτόν·"]},{"type":"verse","number":11,"content":["καὶ φωνὴ ἐγένετο ἐκ τῶν οὐρανῶν, Σὺ εἶ ὁ υἱός μου ὁ ἀγαπητός, ἐν",{"noteId":24},"ᾧ",{"noteId":25},"εὐδόκησα."]},{"type":"heading","content":["The Temptation of Jesus"]},{"type":"verse","number":12,"content":["Καὶ",{"noteId":26},"εὐθὺς τὸ πνεῦμα αὐτὸν ἐκβάλλει εἰς τὴν ἔρημον."]},{"type":"verse","number":13,"content":["Καὶ ἦν",{"noteId":27},"ἐκεῖ ἐν τῇ ἐρήμῳ",{"noteId":28},"ἡμέρας τεσσαράκοντα πειραζόμενος ὑπὸ τοῦ Σατανᾶ, καὶ ἦν μετὰ τῶν θηρίων, καὶ οἱ ἄγγελοι διηκόνουν αὐτῷ."]},{"type":"heading","content":["Jesus Begins His Ministry"]},{"type":"verse","number":14,"content":[{"noteId":29},"Μετὰ δὲ τὸ παραδοθῆναι",{"noteId":30},"τὸν",{"noteId":31},"Ἰωάννην, ἦλθεν ὁ Ἰησοῦς εἰς τὴν Γαλιλαίαν, κηρύσσων τὸ εὐαγγέλιον",{"noteId":32},"τῆς βασιλείας τοῦ Θεοῦ,"]},{"type":"verse","number":15,"content":["καὶ λέγων ὅτι",{"text":"Πεπλήρωται ὁ καιρός, καὶ ἤγγικεν ἡ βασιλεία τοῦ Θεοῦ· μετανοεῖτε, καὶ πιστεύετε ἐν τῷ εὐαγγελίῳ.","wordsOfJesus":true}]},{"type":"heading","content":["Jesus Calls His First Disciples"]},{"type":"verse","number":16,"content":[{"noteId":33},"Περιπατῶν δὲ παρὰ τὴν θάλασσαν τῆς Γαλιλαίας εἶδε Σίμωνα καὶ Ἀνδρέαν τὸν ἀδελφὸν",{"noteId":34},"αὐτοῦ τοῦ Σίμωνος",{"noteId":35},"βάλλοντας ἀμφίβληστρον ἐν τῇ θαλάσσῃ· ἦσαν γὰρ",{"noteId":36},"ἁλιεῖς."]},{"type":"verse","number":17,"content":["Καὶ εἶπεν αὐτοῖς ὁ Ἰησοῦς,",{"text":"Δεῦτε ὀπίσω μου, καὶ ποιήσω ὑμᾶς γενέσθαι","wordsOfJesus":true},{"noteId":37},{"text":"ἁλιεῖς ἀνθρώπων.","wordsOfJesus":true}]},{"type":"verse","number":18,"content":["Καὶ",{"noteId":38},"εὐθέως ἀφέντες τὰ δίκτυα",{"noteId":39},"αὐτῶν, ἠκολούθησαν αὐτῷ."]},{"type":"verse","number":19,"content":["Καὶ προβὰς",{"noteId":40},"ἐκεῖθεν ὀλίγον, εἶδεν Ἰάκωβον τὸν τοῦ Ζεβεδαίου, καὶ",{"noteId":41},"Ἰωάννην τὸν ἀδελφὸν αὐτοῦ, καὶ αὐτοὺς ἐν τῷ πλοίῳ καταρτίζοντας τὰ δίκτυα."]},{"type":"verse","number":20,"content":["Καὶ",{"noteId":42},"εὐθέως ἐκάλεσεν αὐτούς· καὶ ἀφέντες τὸν πατέρα αὐτῶν Ζεβεδαῖον ἐν τῷ πλοίῳ μετὰ τῶν μισθωτῶν ἀπῆλθον ὀπίσω αὐτοῦ."]},{"type":"heading","content":["Jesus Casts Out an Unclean Spirit"]},{"type":"verse","number":21,"content":["Καὶ εἰσπορεύονται εἰς",{"noteId":43},"Καπερναούμ· καὶ",{"noteId":44},"εὐθέως τοῖς σάββασιν",{"noteId":45},"εἰσελθὼν",{"noteId":46},"εἰς τὴν συναγωγήν, ἐδίδασκε."]},{"type":"verse","number":22,"content":["Καὶ ἐξεπλήσσοντο ἐπὶ τῇ διδαχῇ αὐτοῦ· ἦν γὰρ διδάσκων αὐτοὺς ὡς ἐξουσίαν ἔχων, καὶ οὐχ ὡς οἱ γραμματεῖς."]},{"type":"verse","number":23,"content":[{"noteId":47},"Καὶ ἦν ἐν τῇ συναγωγῇ αὐτῶν ἄνθρωπος ἐν πνεύματι ἀκαθάρτῳ, καὶ ἀνέκραξε,"]},{"type":"verse","number":24,"content":["λέγων,",{"noteId":48},"Ἔα, τί ἡμῖν καὶ σοί, Ἰησοῦ Ναζαρηνέ; Ἦλθες ἀπολέσαι ἡμᾶς; Οἶδά σε τίς εἶ, ὁ ἅγιος τοῦ Θεοῦ."]},{"type":"verse","number":25,"content":["Καὶ ἐπετίμησεν αὐτῷ ὁ Ἰησοῦς, λέγων,",{"text":"Φιμώθητι, καὶ ἔξελθε ἐξ αὐτοῦ.","wordsOfJesus":true}]},{"type":"verse","number":26,"content":["Καὶ σπαράξαν αὐτὸν τὸ πνεῦμα τὸ ἀκάθαρτον καὶ",{"noteId":49},"κράξαν φωνῇ μεγάλῃ, ἐξῆλθεν ἐξ αὐτοῦ."]},{"type":"verse","number":27,"content":["Καὶ ἐθαμβήθησαν",{"noteId":50},"πάντες, ὥστε",{"noteId":51},"συζητεῖν",{"noteId":52},"πρὸς ἑαυτούς, λέγοντας, Τί ἐστι τοῦτο;",{"noteId":53},"Τίς ἡ διδαχὴ ἡ καινὴ αὕτη, ὅτι κατ᾽ ἐξουσίαν καὶ τοῖς πνεύμασι τοῖς ἀκαθάρτοις ἐπιτάσσει, καὶ ὑπακούουσιν αὐτῷ;"]},{"type":"verse","number":28,"content":[{"noteId":54},"Ἐξῆλθε δὲ ἡ ἀκοὴ αὐτοῦ",{"noteId":55},"εὐθὺς εἰς ὅλην τὴν περίχωρον τῆς Γαλιλαίας."]},{"type":"heading","content":["Jesus Heals Many"]},{"type":"verse","number":29,"content":["Καὶ",{"noteId":56},"εὐθέως ἐκ τῆς συναγωγῆς",{"noteId":57},"ἐξελθόντες, ἦλθον εἰς τὴν οἰκίαν Σίμωνος καὶ Ἀνδρέου, μετὰ Ἰακώβου καὶ",{"noteId":58},"Ἰωάννου."]},{"type":"verse","number":30,"content":["Ἡ δὲ πενθερὰ",{"noteId":59},"Σίμωνος κατέκειτο πυρέσσουσα, καὶ",{"noteId":60},"εὐθέως λέγουσιν αὐτῷ περὶ αὐτῆς·"]},{"type":"verse","number":31,"content":["καὶ προσελθὼν ἤγειρεν αὐτήν, κρατήσας τῆς χειρὸς",{"noteId":61},"αὐτῆς· καὶ ἀφῆκεν αὐτὴν ὁ πυρετὸς",{"noteId":62},"εὐθέως, καὶ διηκόνει αὐτοῖς."]},{"type":"verse","number":32,"content":["Ὀψίας δὲ γενομένης, ὅτε",{"noteId":63},"ἔδυ ὁ ἥλιος, ἔφερον πρὸς αὐτὸν πάντας τοὺς κακῶς ἔχοντας καὶ τοὺς δαιμονιζομένους·"]},{"type":"verse","number":33,"content":["καὶ",{"noteId":64},"ἡ πόλις ὅλη ἐπισυνηγμένη ἦν πρὸς τὴν θύραν."]},{"type":"verse","number":34,"content":["Καὶ ἐθεράπευσε πολλοὺς κακῶς ἔχοντας ποικίλαις νόσοις, καὶ δαιμόνια πολλὰ ἐξέβαλε, καὶ οὐκ ἤφιε λαλεῖν τὰ δαιμόνια, ὅτι ᾔδεισαν",{"noteId":65},"αὐτόν."]},{"type":"heading","content":["Jesus Preaches in Galilee"]},{"type":"verse","number":35,"content":["Καὶ πρωῒ",{"noteId":66},"ἔννυχον λίαν ἀναστὰς ἐξῆλθε, καὶ ἀπῆλθεν εἰς ἔρημον τόπον, κἀκεῖ προσηύχετο."]},{"type":"verse","number":36,"content":["Καὶ",{"noteId":67},"κατεδίωξαν αὐτὸν",{"noteId":68},"ὁ Σίμων καὶ οἱ μετ᾽ αὐτοῦ·"]},{"type":"verse","number":37,"content":["καὶ",{"noteId":69},"εὑρόντες αὐτὸν λέγουσιν αὐτῷ ὅτι Πάντες",{"noteId":70},"σε ζητοῦσι."]},{"type":"verse","number":38,"content":["Καὶ λέγει αὐτοῖς,",{"noteId":71},{"text":"Ἄγωμεν εἰς τὰς ἐχομένας κωμοπόλεις, ἵνα","wordsOfJesus":true},{"noteId":72},{"text":"καὶ ἐκεῖ κηρύξω· εἰς τοῦτο γὰρ","wordsOfJesus":true},{"noteId":73},{"text":"ἐξελήλυθα.","wordsOfJesus":true}]},{"type":"verse","number":39,"content":["Καὶ",{"noteId":74},"ἦν κηρύσσων",{"noteId":75},"ἐν ταῖς συναγωγαῖς αὐτῶν εἰς ὅλην τὴν Γαλιλαίαν, καὶ τὰ δαιμόνια ἐκβάλλων."]},{"type":"heading","content":["Jesus Cleanses a Man with Leprosy"]},{"type":"verse","number":40,"content":["Καὶ ἔρχεται πρὸς αὐτὸν λεπρός, παρακαλῶν αὐτὸν καὶ γονυπετῶν",{"noteId":76},"αὐτόν,",{"noteId":77},"καὶ λέγων αὐτῷ ὅτι Ἐὰν θέλῃς, δύνασαί με καθαρίσαι."]},{"type":"verse","number":41,"content":[{"noteId":78},"Ὁ δὲ Ἰησοῦς",{"noteId":79},"σπλαγχνισθείς, ἐκτείνας τὴν χεῖρα,",{"noteId":80},"ἥψατο αὐτοῦ, καὶ λέγει αὐτῷ,",{"text":"Θέλω, καθαρίσθητι.","wordsOfJesus":true}]},{"type":"verse","number":42,"content":["Καὶ",{"noteId":81},"εἰπόντος αὐτοῦ",{"noteId":82},"εὐθέως ἀπῆλθεν ἀπ᾽ αὐτοῦ ἡ λέπρα, καὶ",{"noteId":83},"ἐκαθαρίσθη."]},{"type":"verse","number":43,"content":["Καὶ ἐμβριμησάμενος αὐτῷ,",{"noteId":84},"εὐθέως ἐξέβαλεν αὐτόν,"]},{"type":"verse","number":44,"content":["καὶ λέγει αὐτῷ,",{"text":"Ὅρα μηδενὶ μηδὲν εἴπῃς·","wordsOfJesus":true},{"noteId":85},{"text":"ἀλλ᾽ ὕπαγε, σεαυτὸν δεῖξον τῷ ἱερεῖ, καὶ","wordsOfJesus":true},{"noteId":86},{"text":"προσένεγκε περὶ τοῦ καθαρισμοῦ σου ἃ προσέταξε","wordsOfJesus":true},{"noteId":87},{"text":"Μωσῆς, εἰς μαρτύριον αὐτοῖς.","wordsOfJesus":true}]},{"type":"verse","number":45,"content":["Ὁ δὲ ἐξελθὼν ἤρξατο κηρύσσειν πολλὰ καὶ διαφημίζειν τὸν λόγον, ὥστε μηκέτι αὐτὸν δύνασθαι φανερῶς εἰς πόλιν εἰσελθεῖν,",{"noteId":88},"ἀλλ᾽ ἔξω",{"noteI