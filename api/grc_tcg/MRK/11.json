{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"MRK","translationId":"grc_tcg","name":"ΚΑΤΑ ΜΑΡΚΟΝ","commonName":"ΚΑΤΑ ΜΑΡΚΟΝ","title":"ΚΑΤΑ ΜΑΡΚΟΝ","order":41,"numberOfChapters":16,"sha256":"458ddb37b7c88bd21fa977538125daa8129b125491fad25357901af5ebb1abc8","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/MRK/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/grc_tcg/MRK/16.json","totalNumberOfVerses":678},"chapter":{"number":11,"content":[{"type":"heading","content":["The Triumphal Entry"]},{"type":"verse","number":1,"content":["Καὶ ὅτε ἐγγίζουσιν εἰς",{"noteId":805},"Ἱερουσαλήμ, εἰς",{"noteId":806},"Βηθσφαγὴ καὶ Βηθανίαν, πρὸς τὸ ὄρος τῶν Ἐλαιῶν, ἀποστέλλει δύο τῶν μαθητῶν αὐτοῦ,"]},{"type":"verse","number":2,"content":["καὶ λέγει αὐτοῖς,",{"text":"Ὑπάγετε εἰς τὴν κώμην τὴν κατέναντι ὑμῶν· καὶ","wordsOfJesus":true},{"noteId":807},{"text":"εὐθέως εἰσπορευόμενοι εἰς αὐτὴν εὑρήσετε πῶλον δεδεμένον, ἐφ᾽ ὃν οὐδεὶς","wordsOfJesus":true},{"noteId":808},{"text":"ἀνθρώπων κεκάθικε·","wordsOfJesus":true},{"noteId":809},{"text":"λύσαντες αὐτὸν ἀγάγετε.","wordsOfJesus":true}]},{"type":"verse","number":3,"content":[{"text":"Καὶ ἐάν τις ὑμῖν εἴπῃ, Τί ποιεῖτε τοῦτο; εἴπατε","wordsOfJesus":true},{"noteId":810},{"text":"ὅτι Ὁ Κύριος αὐτοῦ χρείαν ἔχει· καὶ","wordsOfJesus":true},{"noteId":811},{"text":"εὐθέως αὐτὸν","wordsOfJesus":true},{"noteId":812},{"text":"ἀποστέλλει ὧδε.","wordsOfJesus":true}]},{"type":"verse","number":4,"content":[{"noteId":813},"Ἀπῆλθον δὲ καὶ εὗρον",{"noteId":814},"πῶλον δεδεμένον πρὸς",{"noteId":815},"τὴν θύραν ἔξω ἐπὶ τοῦ ἀμφόδου, καὶ λύουσιν αὐτόν."]},{"type":"verse","number":5,"content":["Καί τινες τῶν ἐκεῖ",{"noteId":816},"ἑστηκότων ἔλεγον αὐτοῖς, Τί ποιεῖτε λύοντες τὸν πῶλον;"]},{"type":"verse","number":6,"content":["Οἱ δὲ",{"noteId":817},"εἶπον αὐτοῖς καθὼς",{"noteId":818},"ἐνετείλατο ὁ Ἰησοῦς· καὶ ἀφῆκαν αὐτούς."]},{"type":"verse","number":7,"content":["Καὶ",{"noteId":819},"ἤγαγον τὸν πῶλον πρὸς τὸν Ἰησοῦν· καὶ",{"noteId":820},"ἐπέβαλον αὐτῷ τὰ ἱμάτια αὐτῶν, καὶ ἐκάθισεν ἐπ᾽",{"noteId":821},"αὐτῷ."]},{"type":"verse","number":8,"content":[{"noteId":822},"Πολλοὶ δὲ τὰ ἱμάτια αὐτῶν ἔστρωσαν εἰς τὴν ὁδόν· ἄλλοι δὲ",{"noteId":823},"στοιβάδας",{"noteId":824},"ἔκοπτον ἐκ τῶν δένδρων, καὶ ἐστρώννυον εἰς τὴν ὁδόν."]},{"type":"verse","number":9,"content":["Καὶ οἱ προάγοντες καὶ οἱ ἀκολουθοῦντες ἔκραζον,",{"noteId":825},"λέγοντες,",{"lineBreak":true},{"text":"Ὡσαννά·","poem":1},{"lineBreak":true},{"text":"εὐλογημένος ὁ ἐρχόμενος ἐν ὀνόματι Κυρίου.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Εὐλογημένη ἡ ἐρχομένη βασιλεία","poem":1},{"noteId":826},{"text":"ἐν ὀνόματι Κυρίου τοῦ πατρὸς ἡμῶν","poem":1},{"noteId":827},{"text":"Δαυίδ.","poem":1},{"lineBreak":true},{"text":"Ὡσαννὰ ἐν τοῖς ὑψίστοις.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":["Καὶ εἰσῆλθεν εἰς Ἱεροσόλυμα",{"noteId":828},"ὁ Ἰησοῦς, καὶ εἰς τὸ ἱερόν· καὶ περιβλεψάμενος πάντα,",{"noteId":829},"ὀψίας ἤδη οὔσης τῆς ὥρας, ἐξῆλθεν εἰς Βηθανίαν μετὰ τῶν δώδεκα."]},{"type":"heading","content":["Jesus Curses the Fig Tree"]},{"type":"verse","number":12,"content":["Καὶ τῇ ἐπαύριον ἐξελθόντων αὐτῶν ἀπὸ Βηθανίας, ἐπείνασε."]},{"type":"verse","number":13,"content":["Καὶ ἰδὼν συκῆν",{"noteId":830},"μακρόθεν, ἔχουσαν φύλλα, ἦλθεν εἰ ἄρα",{"noteId":831},"εὑρήσει τι ἐν αὐτῇ· καὶ ἐλθὼν ἐπ᾽ αὐτήν, οὐδὲν εὗρεν εἰ μὴ φύλλα·",{"noteId":832},"οὐ γὰρ ἦν καιρὸς σύκων."]},{"type":"verse","number":14,"content":["Καὶ ἀποκριθεὶς",{"noteId":833},"ὁ Ἰησοῦς εἶπεν αὐτῇ,",{"text":"Μηκέτι","wordsOfJesus":true},{"noteId":834},{"text":"ἐκ σοῦ εἰς τὸν αἰῶνα μηδεὶς καρπὸν","wordsOfJesus":true},{"noteId":835},{"text":"φάγοι.","wordsOfJesus":true},"Καὶ ἤκουον οἱ μαθηταὶ αὐτοῦ."]},{"type":"heading","content":["Jesus Cleanses the Temple Courts"]},{"type":"verse","number":15,"content":["Καὶ",{"noteId":836},"ἔρχονται εἰς Ἱεροσόλυμα· καὶ εἰσελθὼν",{"noteId":837},"ὁ Ἰησοῦς εἰς τὸ ἱερὸν ἤρξατο ἐκβάλλειν τοὺς πωλοῦντας καὶ",{"noteId":838},"ἀγοράζοντας ἐν τῷ ἱερῷ· καὶ τὰς τραπέζας τῶν κολλυβιστῶν, καὶ τὰς καθέδρας τῶν πωλούντων τὰς περιστερὰς κατέστρεψε·"]},{"type":"verse","number":16,"content":["καὶ οὐκ ἤφιεν ἵνα τις διενέγκῃ σκεῦος διὰ τοῦ ἱεροῦ."]},{"type":"verse","number":17,"content":["Καὶ ἐδίδασκε,",{"noteId":839},"λέγων",{"noteId":840},"αὐτοῖς,",{"text":"Οὐ γέγραπται ὅτι Ὁ οἶκός μου οἶκος προσευχῆς κληθήσεται πᾶσι τοῖς ἔθνεσιν; Ὑμεῖς δὲ","wordsOfJesus":true},{"noteId":841},{"text":"ἐποιήσατε αὐτὸν σπήλαιον λῃστῶν.","wordsOfJesus":true}]},{"type":"verse","number":18,"content":["Καὶ ἤκουσαν οἱ",{"noteId":842},"γραμματεῖς καὶ οἱ ἀρχιερεῖς, καὶ ἐζήτουν πῶς αὐτὸν",{"noteId":843},"ἀπολέσωσιν· ἐφοβοῦντο γὰρ αὐτόν,",{"noteId":844},"ὅτι πᾶς ὁ ὄχλος ἐξεπλήσσετο ἐπὶ τῇ διδαχῇ αὐτοῦ."]},{"type":"verse","number":19,"content":["Καὶ",{"noteId":845},"ὅτε ὀψὲ ἐγένετο,",{"noteId":846},"ἐξεπορεύετο ἔξω τῆς πόλεως."]},{"type":"heading","content":["The Withered Fig Tree"]},{"type":"verse","number":20,"content":["Καὶ",{"noteId":847},"πρωῒ παραπορευόμενοι, εἶδον τὴν συκῆν ἐξηραμμένην ἐκ ῥιζῶν."]},{"type":"verse","number":21,"content":["Καὶ ἀναμνησθεὶς ὁ Πέτρος λέγει αὐτῷ,",{"noteId":848},"Ῥαββί, ἴδε, ἡ συκῆ ἣν κατηράσω ἐξήρανται."]},{"type":"verse","number":22,"content":["Καὶ ἀποκριθεὶς",{"noteId":849},"ὁ Ἰησοῦς λέγει αὐτοῖς,",{"text":"Ἔχετε πίστιν Θεοῦ.","wordsOfJesus":true}]},{"type":"verse","number":23,"content":[{"text":"Ἀμὴν","wordsOfJesus":true},{"noteId":850},{"text":"γὰρ λέγω ὑμῖν ὅτι ὃς ἂν εἴπῃ τῷ ὄρει τούτῳ, Ἄρθητι, καὶ βλήθητι εἰς τὴν θάλασσαν, καὶ μὴ διακριθῇ ἐν τῇ καρδίᾳ αὐτοῦ, ἀλλὰ","wordsOfJesus":true},{"noteId":851},{"text":"πιστεύσῃ ὅτι ἃ λέγει γίνεται· ἔσται αὐτῷ ὃ ἐὰν εἴπῃ.","wordsOfJesus":true}]},{"type":"verse","number":24,"content":[{"text":"Διὰ τοῦτο λέγω ὑμῖν, Πάντα ὅσα","wordsOfJesus":true},{"noteId":852},{"text":"ἂν προσευχόμενοι αἰτῆσθε, πιστεύετε ὅτι","wordsOfJesus":true},{"noteId":853},{"text":"λαμβάνετε, καὶ ἔσται ὑμῖν.","wordsOfJesus":true}]},{"type":"verse","number":25,"content":[{"text":"Καὶ ὅταν","wordsOfJesus":true},{"noteId":854},{"text":"στήκητε προσευχόμενοι, ἀφίετε εἴ τι ἔχετε κατά τινος· ἵνα καὶ ὁ πατὴρ ὑμῶν ὁ ἐν τοῖς οὐρανοῖς ἀφῇ ὑμῖν τὰ παραπτώματα ὑμῶν.","wordsOfJesus":true}]},{"type":"verse","number":26,"content":[{"noteId":855},{"text":"Εἰ δὲ ὑμεῖς οὐκ ἀφίετε, οὐδὲ ὁ πατὴρ ὑμῶν ὁ ἐν τοῖς οὐρανοῖς ἀφήσει τὰ παραπτώματα ὑμῶν.","wordsOfJesus":true}]},{"type":"heading","content":["The Authority of Jesus Questioned"]},{"type":"verse","number":27,"content":["Καὶ ἔρχονται πάλιν εἰς Ἱεροσόλυμα· καὶ ἐν τῷ ἱερῷ περιπατοῦντος αὐτοῦ, ἔρχονται πρὸς αὐτὸν οἱ ἀρχιερεῖς καὶ οἱ γραμματεῖς καὶ οἱ πρεσβύτεροι,"]},{"type":"verse","number":28,"content":["καὶ",{"noteId":856},"λέγουσιν αὐτῷ, Ἐν ποίᾳ ἐξουσίᾳ ταῦτα ποιεῖς;",{"noteId":857},"Καὶ τίς σοι",{"noteId":858},"τὴν ἐξουσίαν ταύτην ἔδωκεν ἵνα ταῦτα ποιῇς;"]},{"type":"verse","number":29,"content":["Ὁ δὲ Ἰησοῦς",{"noteId":859},"ἀποκριθεὶς εἶπεν αὐτοῖς,",{"text":"Ἐπερωτήσω ὑμᾶς","wordsOfJesus":true},{"noteId":860},{"text":"καὶ ἐγὼ ἕνα λόγον, καὶ ἀποκρίθητέ μοι, καὶ ἐρῶ ὑμῖν ἐν ποίᾳ ἐξουσίᾳ ταῦτα ποιῶ.","wordsOfJesus":true}]},{"type":"verse","number":30,"content":[{"text":"Τὸ βάπτισμα","wordsOfJesus":true},{"noteId":861},{"text":"Ἰωάννου ἐξ οὐρανοῦ ἦν, ἢ ἐξ ἀνθρώπων;","wordsOfJesus":true},{"noteId":862},{"text":"Ἀποκρίθητέ μοι.","wordsOfJesus":true}]},{"type":"verse","number":31,"content":["Καὶ",{"noteId":863},"ἐλογίζοντο πρὸς ἑαυτούς, λέγοντες,",{"noteId":864},"Ἐὰν εἴπωμεν, Ἐξ οὐρανοῦ, ἐρεῖ, Διὰ τί οὖν οὐκ ἐπιστεύσατε αὐτῷ;"]},{"type":"verse","number":32,"content":[{"noteId":865},"Ἀλλ᾽ εἴπωμεν, Ἐξ ἀνθρώπων, ἐφοβοῦντο τὸν",{"noteId":866},"λαόν· ἅπαντες γὰρ εἶχον τὸν",{"noteId":867},"Ἰωάννην,",{"noteId":868},"ὅτι ὄντως προφήτης ἦν."]},{"type":"verse","number":33,"content":["Καὶ ἀποκριθέντες",{"noteId":869},"λέγουσι τῷ Ἰησοῦ, Οὐκ οἴδαμεν. Καὶ ὁ Ἰησοῦς",{"noteId":870},"ἀποκριθεὶς λέγει αὐτοῖς,",{"text":"Οὐδὲ ἐγὼ λέγω ὑμῖν ἐν ποίᾳ ἐξουσίᾳ ταῦτα ποιῶ.","wordsOfJesus":true}]}],"footnotes":[{"noteId":805,"caller":"+","text":"ιερουσαλημ ¦ ιεροσολυμα CT","reference":{"chapter":11,"verse":1}},{"noteId":806,"caller":"+","text":"βηθσφαγη ¦ βηθφαγη 𝔐pt CT TR","reference":{"chapter":11,"verse":1}},{"noteId":807,"caller":"+","text":"ευθεως ¦ ευθυς CT","reference":{"chapter":11,"verse":2}},{"noteId":808,"caller":"+","text":"ανθρωπων κεκαθικε ¦ ουπω ανθρωπων εκαθισε CT","reference":{"chapter":11,"verse":2}},{"noteId":809,"caller":"+","text":"λυσαντες αυτον αγαγετε ¦ λυσατε αυτον και φερετε CT","reference":{"chapter":11,"verse":2}},{"noteId":810,"caller":"+","text":"οτι ¦ — NA WH","reference":{"chapter":11,"verse":3}},{"noteId":811,"caller":"+","text":"ευθεως ¦ ευθυς CT","reference":{"chapter":11,"verse":3}},{"noteId":812,"caller":"+","text":"αποστελλει ¦ αποστελει TR ¦ αποστελλει παλιν ANT ECM† NA SBL TH WH","reference":{"chapter":11,"verse":3}},{"noteId":813,"caller":"+","text":"απηλθον δε ¦ και απηλθον CT","reference":{"chapter":11,"verse":4}},{"noteId":814,"caller":"+","text":"πωλον ¦ τον πωλον 𝔐pt ANT PCK TR","reference":{"chapter":11,"verse":4}},{"noteId":815,"caller":"+","text":"την ¦ — CT","reference":{"chapter":11,"verse":4}},{"noteId":816,"caller":"+","text":"εστηκοτων ¦ εστωτων PCK","reference":{"chapter":11,"verse":5}},{"noteId":817,"caller":"+","text":"ειπον ¦ ειπαν ECM NA SBL WH","reference":{"chapter":11,"verse":6}},{"noteId":818,"caller":"+","text":"ενετειλατο ¦ ειπεν CT","reference":{"chapter":11,"vers