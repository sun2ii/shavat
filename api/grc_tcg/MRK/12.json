{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"MRK","translationId":"grc_tcg","name":"ΚΑΤΑ ΜΑΡΚΟΝ","commonName":"ΚΑΤΑ ΜΑΡΚΟΝ","title":"ΚΑΤΑ ΜΑΡΚΟΝ","order":41,"numberOfChapters":16,"sha256":"458ddb37b7c88bd21fa977538125daa8129b125491fad25357901af5ebb1abc8","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/MRK/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/grc_tcg/MRK/16.json","totalNumberOfVerses":678},"chapter":{"number":12,"content":[{"type":"heading","content":["The Parable of the Vineyard Owner"]},{"type":"verse","number":1,"content":["Καὶ ἤρξατο αὐτοῖς ἐν παραβολαῖς",{"noteId":871},"λέγειν,",{"text":"Ἀμπελῶνα","wordsOfJesus":true},{"noteId":872},{"text":"ἐφύτευσεν ἄνθρωπος, καὶ περιέθηκε φραγμόν, καὶ ὤρυξεν ὑπολήνιον, καὶ ᾠκοδόμησε πύργον, καὶ","wordsOfJesus":true},{"noteId":873},{"text":"ἐξέδοτο αὐτὸν γεωργοῖς, καὶ ἀπεδήμησε.","wordsOfJesus":true}]},{"type":"verse","number":2,"content":[{"text":"Καὶ ἀπέστειλε πρὸς τοὺς γεωργοὺς τῷ καιρῷ δοῦλον, ἵνα παρὰ τῶν γεωργῶν λάβῃ ἀπὸ","wordsOfJesus":true},{"noteId":874},{"text":"τοῦ καρποῦ τοῦ ἀμπελῶνος.","wordsOfJesus":true}]},{"type":"verse","number":3,"content":[{"noteId":875},{"text":"Οἱ δὲ λαβόντες αὐτὸν","wordsOfJesus":true},{"noteId":876},{"text":"ἔδειραν, καὶ ἀπέστειλαν κενόν.","wordsOfJesus":true}]},{"type":"verse","number":4,"content":[{"text":"Καὶ πάλιν ἀπέστειλε πρὸς αὐτοὺς ἄλλον δοῦλον· κἀκεῖνον","wordsOfJesus":true},{"noteId":877},{"text":"λιθοβολήσαντες","wordsOfJesus":true},{"noteId":878},{"text":"ἐκεφαλαίωσαν, καὶ","wordsOfJesus":true},{"noteId":879},{"text":"ἀπέστειλαν ἠτιμωμένον.","wordsOfJesus":true}]},{"type":"verse","number":5,"content":[{"text":"Καὶ","wordsOfJesus":true},{"noteId":880},{"text":"πάλιν ἄλλον ἀπέστειλε· κἀκεῖνον ἀπέκτειναν· καὶ πολλοὺς ἄλλους,","wordsOfJesus":true},{"noteId":881},{"text":"τοὺς μὲν","wordsOfJesus":true},{"noteId":882},{"text":"δέροντες,","wordsOfJesus":true},{"noteId":883},{"text":"τοὺς δὲ","wordsOfJesus":true},{"noteId":884},{"text":"ἀποκτένοντες.","wordsOfJesus":true}]},{"type":"verse","number":6,"content":[{"text":"Ἔτι","wordsOfJesus":true},{"noteId":885},{"text":"οὖν ἕνα","wordsOfJesus":true},{"noteId":886},{"text":"υἱὸν ἔχων ἀγαπητὸν","wordsOfJesus":true},{"noteId":887},{"text":"αὐτοῦ, ἀπέστειλε","wordsOfJesus":true},{"noteId":888},{"text":"καὶ αὐτὸν","wordsOfJesus":true},{"noteId":889},{"text":"πρὸς αὐτοὺς ἔσχατον, λέγων ὅτι Ἐντραπήσονται τὸν υἱόν μου.","wordsOfJesus":true}]},{"type":"verse","number":7,"content":[{"text":"Ἐκεῖνοι δὲ οἱ","wordsOfJesus":true},{"noteId":890},{"text":"γεωργοὶ","wordsOfJesus":true},{"noteId":891},{"text":"εἶπον πρὸς ἑαυτοὺς ὅτι Οὗτός ἐστιν ὁ κληρονόμος· δεῦτε, ἀποκτείνωμεν αὐτόν, καὶ ἡμῶν ἔσται ἡ κληρονομία.","wordsOfJesus":true}]},{"type":"verse","number":8,"content":[{"text":"Καὶ λαβόντες","wordsOfJesus":true},{"noteId":892},{"text":"αὐτὸν ἀπέκτειναν, καὶ","wordsOfJesus":true},{"noteId":893},{"text":"ἐξέβαλον ἔξω τοῦ ἀμπελῶνος.","wordsOfJesus":true}]},{"type":"verse","number":9,"content":[{"text":"Τί","wordsOfJesus":true},{"noteId":894},{"text":"οὖν ποιήσει ὁ κύριος τοῦ ἀμπελῶνος; Ἐλεύσεται καὶ ἀπολέσει τοὺς","wordsOfJesus":true},{"noteId":895},{"text":"γεωργούς, καὶ δώσει τὸν ἀμπελῶνα ἄλλοις.","wordsOfJesus":true}]},{"type":"verse","number":10,"content":[{"text":"Οὐδὲ τὴν γραφὴν ταύτην ἀνέγνωτε,","wordsOfJesus":true},{"lineBreak":true},{"text":"Λίθον ὃν ἀπεδοκίμασαν οἱ οἰκοδομοῦντες,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"οὗτος ἐγενήθη εἰς κεφαλὴν γωνίας·","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"παρὰ Κυρίου ἐγένετο αὕτη,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"καὶ ἔστι θαυμαστὴ ἐν ὀφθαλμοῖς ἡμῶν;","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":["Καὶ ἐζήτουν αὐτὸν κρατῆσαι, καὶ ἐφοβήθησαν τὸν ὄχλον· ἔγνωσαν γὰρ ὅτι πρὸς αὐτοὺς τὴν παραβολὴν εἶπε· καὶ ἀφέντες αὐτὸν",{"noteId":896},"ἀπῆλθον."]},{"type":"heading","content":["The Question About Paying Taxes to Caesar"]},{"type":"verse","number":13,"content":["Καὶ ἀποστέλλουσι πρὸς αὐτόν τινας τῶν Φαρισαίων καὶ τῶν Ἡρῳδιανῶν, ἵνα αὐτὸν ἀγρεύσωσι λόγῳ."]},{"type":"verse","number":14,"content":[{"noteId":897},"Οἱ δὲ ἐλθόντες λέγουσιν αὐτῷ, Διδάσκαλε, οἴδαμεν ὅτι ἀληθὴς εἶ, καὶ οὐ μέλει σοι περὶ οὐδενός· οὐ γὰρ βλέπεις εἰς πρόσωπον ἀνθρώπων, ἀλλ᾽ ἐπ᾽ ἀληθείας τὴν ὁδὸν τοῦ Θεοῦ διδάσκεις.",{"noteId":898},"Ἔξεστι",{"noteId":899},"κῆνσον Καίσαρι δοῦναι, ἢ οὔ;"]},{"type":"verse","number":15,"content":["Δῶμεν, ἢ μὴ δῶμεν; Ὁ δὲ εἰδὼς αὐτῶν τὴν ὑπόκρισιν εἶπεν αὐτοῖς,",{"text":"Τί με πειράζετε; Φέρετέ μοι δηνάριον, ἵνα ἴδω.","wordsOfJesus":true}]},{"type":"verse","number":16,"content":["Οἱ δὲ ἤνεγκαν. Καὶ λέγει αὐτοῖς,",{"text":"Τίνος ἡ εἰκὼν αὕτη καὶ ἡ ἐπιγραφή;","wordsOfJesus":true},"Οἱ δὲ",{"noteId":900},"εἶπον",{"noteId":901},"αὐτῷ, Καίσαρος."]},{"type":"verse","number":17,"content":[{"noteId":902},"Καὶ ἀποκριθεὶς ὁ Ἰησοῦς εἶπεν",{"noteId":903},"αὐτοῖς,",{"noteId":904},{"text":"Ἀπόδοτε τὰ Καίσαρος Καίσαρι, καὶ τὰ τοῦ Θεοῦ τῷ Θεῷ.","wordsOfJesus":true},"Καὶ",{"noteId":905},"ἐθαύμασαν ἐπ᾽ αὐτῷ."]},{"type":"heading","content":["The Sadducees Ask About the Resurrection"]},{"type":"verse","number":18,"content":["Καὶ ἔρχονται Σαδδουκαῖοι πρὸς αὐτόν, οἵτινες λέγουσιν ἀνάστασιν μὴ εἶναι· καὶ",{"noteId":906},"ἐπηρώτησαν αὐτόν, λέγοντες,"]},{"type":"verse","number":19,"content":["Διδάσκαλε,",{"noteId":907},"Μωσῆς ἔγραψεν ἡμῖν ὅτι Ἐάν τινος ἀδελφὸς ἀποθάνῃ, καὶ καταλίπῃ γυναῖκα, καὶ",{"noteId":908},"τέκνα μὴ ἀφῇ, ἵνα λάβῃ ὁ ἀδελφὸς αὐτοῦ τὴν γυναῖκα",{"noteId":909},"αὐτοῦ, καὶ ἐξαναστήσῃ σπέρμα τῷ ἀδελφῷ αὐτοῦ."]},{"type":"verse","number":20,"content":[{"noteId":910},"Ἑπτὰ ἀδελφοὶ ἦσαν· καὶ ὁ πρῶτος ἔλαβε γυναῖκα, καὶ ἀποθνῄσκων οὐκ ἀφῆκε σπέρμα·"]},{"type":"verse","number":21,"content":["καὶ ὁ δεύτερος ἔλαβεν αὐτήν, καὶ ἀπέθανε,",{"noteId":911},"καὶ οὐδὲ αὐτὸς ἀφῆκε σπέρμα· καὶ ὁ τρίτος ὡσαύτως."]},{"type":"verse","number":22,"content":["Καὶ",{"noteId":912},"ἔλαβον αὐτὴν οἱ ἑπτά, καὶ οὐκ ἀφῆκαν σπέρμα.",{"noteId":913},"Ἐσχάτη πάντων",{"noteId":914},"ἀπέθανε καὶ ἡ γυνή."]},{"type":"verse","number":23,"content":["Ἐν τῇ",{"noteId":915},"ἀναστάσει, ὅταν ἀναστῶσι, τίνος αὐτῶν ἔσται γυνή; Οἱ γὰρ ἑπτὰ ἔσχον αὐτὴν γυναῖκα."]},{"type":"verse","number":24,"content":[{"noteId":916},"Καὶ ἀποκριθεὶς ὁ Ἰησοῦς εἶπεν αὐτοῖς,",{"text":"Οὐ διὰ τοῦτο πλανᾶσθε, μὴ εἰδότες τὰς γραφάς, μηδὲ τὴν δύναμιν τοῦ Θεοῦ;","wordsOfJesus":true}]},{"type":"verse","number":25,"content":[{"text":"Ὅταν γὰρ ἐκ νεκρῶν ἀναστῶσιν, οὔτε γαμοῦσιν, οὔτε","wordsOfJesus":true},{"noteId":917},{"text":"γαμίσκονται, ἀλλ᾽ εἰσὶν ὡς ἄγγελοι","wordsOfJesus":true},{"noteId":918},{"text":"οἱ ἐν τοῖς οὐρανοῖς.","wordsOfJesus":true}]},{"type":"verse","number":26,"content":[{"text":"Περὶ δὲ τῶν νεκρῶν, ὅτι ἐγείρονται, οὐκ ἀνέγνωτε ἐν τῇ βίβλῳ","wordsOfJesus":true},{"noteId":919},{"text":"Μωσέως, ἐπὶ","wordsOfJesus":true},{"noteId":920},{"text":"τοῦ βάτου,","wordsOfJesus":true},{"noteId":921},{"text":"ὡς εἶπεν αὐτῷ ὁ Θεός, λέγων, Ἐγὼ ὁ Θεὸς Ἀβραάμ, καὶ","wordsOfJesus":true},{"noteId":922},{"text":"ὁ Θεὸς Ἰσαάκ, καὶ","wordsOfJesus":true},{"noteId":923},{"text":"ὁ Θεὸς Ἰακώβ;","wordsOfJesus":true}]},{"type":"verse","number":27,"content":[{"text":"Οὐκ ἔστιν","wordsOfJesus":true},{"noteId":924},{"text":"ὁ Θεὸς νεκρῶν, ἀλλὰ","wordsOfJesus":true},{"noteId":925},{"text":"Θεὸς ζώντων·","wordsOfJesus":true},{"noteId":926},{"text":"ὑμεῖς οὖν πολὺ πλανᾶσθε.","wordsOfJesus":true}]},{"type":"heading","content":["The Most Important Commandment"]},{"type":"verse","number":28,"content":["Καὶ προσελθὼν εἷς τῶν γραμματέων, ἀκούσας αὐτῶν",{"noteId":927},"συζητούντων,",{"noteId":928},"εἰδὼς ὅτι καλῶς",{"noteId":929},"αὐτοῖς ἀπεκρίθη, ἐπηρώτησεν αὐτόν, Ποία ἐστὶ",{"noteId":930},"πρώτη πάντων ἐντολή;"]},{"type":"verse","number":29,"content":[{"noteId":931},"Ὁ δὲ Ἰησοῦς ἀπεκρίθη αὐτῷ ὅτι",{"text":"Πρώτη","wordsOfJesus":true},{"noteId":932},{"text":"πάντων τῶν ἐντολῶν, Ἄκουε, Ἰσραήλ· Κύριος ὁ Θεὸς","wordsOfJesus":true},{"noteId":933},{"text":"ἡμῶν, Κύριος εἷς ἐστι·","wordsOfJesus":true}]},{"type":"verse","number":30,"content":[{"text":"καὶ ἀγαπήσεις Κύριον τὸν Θεόν σου ἐξ ὅλης","wordsOfJesus":true},{"noteId":934},{"text":"τῆς καρδίας σου, καὶ ἐξ ὅλης τῆς ψυχῆς σου, καὶ ἐξ ὅλης τῆς διανοίας σου, καὶ ἐξ ὅλης τῆς ἰσχύος σου.","wordsOfJesus":true},{"noteId":935},{"text":"Αὕτη πρώτη ἐντολή.","wordsOfJesus":true}]},{"type":"verse","number":31,"content":[{"noteId":936},{"text":"Καὶ δευτέρα ὁμοία αὕτη, Ἀγαπήσεις τὸν πλησίον σου ὡς","wordsOfJesus":true},{"noteId":937},{"text":"σεαυτόν. Μείζων τούτων ἄλλη ἐντολὴ οὐκ ἔστι.","wordsOfJesus":true}]},{"type":"verse","number":32,"content":[{"noteId":938},"Καὶ εἶπεν αὐτῷ ὁ γραμματεύς, Καλῶς, διδάσκαλε, ἐπ᾽ ἀληθείας",{"noteId":939},"εἶπας ὅτι εἷς",{"noteId":940},"ἐστι, καὶ οὐκ ἔστιν ἄλλος πλὴν αὐτοῦ·"]},{"type":"verse","number":33,"content":["καὶ τὸ ἀγαπᾷν αὐτὸν ἐξ ὅλης",{"noteId":941},"τῆς καρδίας, καὶ ἐξ ὅλης τῆς συνέσεως,",{"noteId":942},"καὶ ἐξ ὅλης τῆς ψυχῆς, καὶ ἐξ ὅλης τῆς ἰσχύος, καὶ τὸ ἀγαπᾷν τὸν πλησίον ὡς ἑαυτόν,",{"noteId":943},"πλεῖόν ἐστι πάντων τῶν ὁλοκαυτωμάτων καὶ",{"noteId":944},"θυσιῶν."]},{"type":"verse","number":34,"content":["Καὶ ὁ Ἰησοῦς ἰδὼν",{"noteId":945},"αὐτὸν ὅτι νουνεχῶς ἀπεκρίθη, εἶπεν αὐτῷ,",{"text":"Οὐ μακρὰν εἶ ἀπὸ τῆς βασιλείας τοῦ Θεοῦ.","wordsOfJesus":true},"Καὶ οὐδεὶς οὐκέτι ἐτόλμα αὐτὸν ἐπερωτῆσαι."]},{"type":"heading","content":["Whose Son Is the Christ?"]},{"type":"verse","number":35,"content":["Καὶ ἀποκριθεὶς ὁ Ἰησοῦς ἔλεγε, διδάσκων ἐν τῷ ἱερῷ,",{"text":"Πῶς λέγουσιν οἱ γραμματεῖς ὅτι ὁ Χριστὸς υἱός","wordsOfJesus":true},{"noteId":946},{"text":"ἐστι Δαυίδ;","wordsOfJesus":true}]},{"type":"verse","number":36,"content":[{"text":"Αὐτὸς","wordsOfJesus":true},{"noteId":947},{"text":"γὰρ","wordsOfJesus":true},{"noteId":948},{"text":"Δαυὶδ εἶπεν ἐν","wordsOfJesus":true},{"noteId":949},{"text":"Πνεύματι Ἁγίῳ,","wordsOfJesus":true},{"lineBreak":true},{"noteId":950},{"text":"Λέγει","wordsOfJesus":true,"poem":1},{"noteId":951},{"text":"ὁ Κύριος τῷ Κυρίῳ μου,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Κάθου ἐκ δεξιῶν μου,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"ἕως ἂν θῶ τοὺς ἐχθρούς σου","wordsOfJesus":true,"poem":1},{"noteId":952},{"text":"ὑποπόδιον τῶν ποδῶν σου.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Αὐτὸς","wordsOfJesus":true},{"noteId":953},{"text":"οὖν","wordsOfJesus":true},{"noteId":954},{"text":"Δαυὶδ λέγει αὐτὸν Κύριον· καὶ πόθεν","wordsOfJesus":true},{"noteId":955},{"text":"υἱὸς αὐτοῦ ἐστι;","wordsOfJesus":true},"Καὶ ὁ πολὺς ὄχλος ἤκουεν αὐτοῦ ἡδέως."]},{"type":"heading","content":["Beware of the Scribes"]},{"type":"verse","number":38,"content":["Καὶ",{"noteId":956},"ἔλεγεν αὐτοῖς ἐν τῇ διδαχῇ αὐτοῦ,",{"text":"Βλέπετε ἀπὸ τῶν γραμματέων, τῶν θελόντων ἐν στολαῖς περιπατεῖν, καὶ ἀσπασμοὺς ἐν ταῖς ἀγοραῖς,","wordsOfJesus":true}]},{"type":"verse","number":39,"content":[{"text":"καὶ πρωτοκαθεδρίας ἐν ταῖς συναγωγαῖς, καὶ πρωτοκλισίας ἐν τοῖς δείπνοις·","wordsOfJesus":true}]},{"type":"verse","number":40,"content":[{"text":"οἱ","wordsOfJesus":true},{"noteId":957},{"text":"κατεσθίοντες τὰς οἰκίας τῶν χηρῶν, καὶ προφάσει μακρὰ προσευχόμενοι· οὗτοι","wordsOfJesus":true},{"noteId":958},{"text":"λήψονται περισσότερον κρίμα.","wordsOfJesus":true}]},{"type":"heading","content":["The Widow's Offering"]},{"type":"v