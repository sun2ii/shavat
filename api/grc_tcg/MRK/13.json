{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"MRK","translationId":"grc_tcg","name":"ΚΑΤΑ ΜΑΡΚΟΝ","commonName":"ΚΑΤΑ ΜΑΡΚΟΝ","title":"ΚΑΤΑ ΜΑΡΚΟΝ","order":41,"numberOfChapters":16,"sha256":"458ddb37b7c88bd21fa977538125daa8129b125491fad25357901af5ebb1abc8","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/MRK/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/grc_tcg/MRK/16.json","totalNumberOfVerses":678},"chapter":{"number":13,"content":[{"type":"heading","content":["Jesus Predicts the Destruction of the Temple"]},{"type":"verse","number":1,"content":["Καὶ ἐκπορευομένου αὐτοῦ ἐκ τοῦ ἱεροῦ, λέγει αὐτῷ εἷς τῶν μαθητῶν αὐτοῦ, Διδάσκαλε, ἴδε, ποταποὶ λίθοι καὶ ποταπαὶ οἰκοδομαί."]},{"type":"verse","number":2,"content":["Καὶ",{"noteId":965},"ὁ Ἰησοῦς ἀποκριθεὶς εἶπεν αὐτῷ,",{"text":"Βλέπεις ταύτας τὰς μεγάλας οἰκοδομάς; Οὐ μὴ","wordsOfJesus":true},{"noteId":966},{"text":"ἀφεθῇ λίθος ἐπὶ","wordsOfJesus":true},{"noteId":967},{"text":"λίθῳ, ὃς οὐ μὴ καταλυθῇ.","wordsOfJesus":true}]},{"type":"heading","content":["Signs of the End of the Age"]},{"type":"verse","number":3,"content":["Καὶ καθημένου αὐτοῦ εἰς τὸ ὄρος τῶν Ἐλαιῶν κατέναντι τοῦ ἱεροῦ,",{"noteId":968},"ἐπηρώτων αὐτὸν κατ᾽ ἰδίαν Πέτρος καὶ Ἰάκωβος καὶ",{"noteId":969},"Ἰωάννης καὶ Ἀνδρέας,"]},{"type":"verse","number":4,"content":[{"noteId":970},"Εἰπὲ ἡμῖν, πότε ταῦτα ἔσται; Καὶ τί τὸ σημεῖον ὅταν μέλλῃ",{"noteId":971},"πάντα ταῦτα συντελεῖσθαι;"]},{"type":"verse","number":5,"content":["Ὁ δὲ Ἰησοῦς",{"noteId":972},"ἀποκριθεὶς αὐτοῖς ἤρξατο λέγειν,",{"text":"Βλέπετε μή τις ὑμᾶς πλανήσῃ.","wordsOfJesus":true}]},{"type":"verse","number":6,"content":[{"text":"Πολλοὶ","wordsOfJesus":true},{"noteId":973},{"text":"γὰρ ἐλεύσονται ἐπὶ τῷ ὀνόματί μου, λέγοντες ὅτι Ἐγώ εἰμι· καὶ πολλοὺς πλανήσουσιν.","wordsOfJesus":true}]},{"type":"verse","number":7,"content":[{"text":"Ὅταν δὲ ἀκούσητε πολέμους καὶ ἀκοὰς πολέμων, μὴ θροεῖσθε· δεῖ","wordsOfJesus":true},{"noteId":974},{"text":"γὰρ γενέσθαι, ἀλλ᾽ οὔπω τὸ τέλος.","wordsOfJesus":true}]},{"type":"verse","number":8,"content":[{"text":"Ἐγερθήσεται γὰρ ἔθνος","wordsOfJesus":true},{"noteId":975},{"text":"ἐπὶ ἔθνος, καὶ βασιλεία ἐπὶ βασιλείαν·","wordsOfJesus":true},{"noteId":976},{"text":"καὶ ἔσονται σεισμοὶ κατὰ τόπους,","wordsOfJesus":true},{"noteId":977},{"text":"καὶ ἔσονται","wordsOfJesus":true},{"noteId":978},{"text":"λιμοὶ καὶ ταραχαί·","wordsOfJesus":true},{"noteId":979},{"text":"ἀρχαὶ ὠδίνων ταῦτα.","wordsOfJesus":true}]},{"type":"verse","number":9,"content":[{"text":"Βλέπετε δὲ ὑμεῖς ἑαυτούς· παραδώσουσι","wordsOfJesus":true},{"noteId":980},{"text":"γὰρ ὑμᾶς εἰς συνέδρια, καὶ","wordsOfJesus":true},{"noteId":981},{"text":"εἰς συναγωγὰς δαρήσεσθε, καὶ ἐπὶ ἡγεμόνων καὶ βασιλέων","wordsOfJesus":true},{"noteId":982},{"text":"σταθήσεσθε ἕνεκεν ἐμοῦ, εἰς μαρτύριον αὐτοῖς.","wordsOfJesus":true}]},{"type":"verse","number":10,"content":[{"text":"Καὶ εἰς πάντα τὰ ἔθνη","wordsOfJesus":true},{"noteId":983},{"text":"δεῖ πρῶτον κηρυχθῆναι τὸ εὐαγγέλιον.","wordsOfJesus":true}]},{"type":"verse","number":11,"content":[{"noteId":984},{"text":"Ὅταν δὲ","wordsOfJesus":true},{"noteId":985},{"text":"ἀγάγωσιν ὑμᾶς παραδιδόντες, μὴ προμεριμνᾶτε τί","wordsOfJesus":true},{"noteId":986},{"text":"λαλήσητε,","wordsOfJesus":true},{"noteId":987},{"text":"μηδὲ μελετᾶτε· ἀλλ᾽ ὃ ἐὰν δοθῇ ὑμῖν ἐν ἐκείνῃ τῇ ὥρᾳ, τοῦτο λαλεῖτε· οὐ γάρ","wordsOfJesus":true},{"noteId":988},{"text":"ἐστε ὑμεῖς οἱ λαλοῦντες, ἀλλὰ τὸ Πνεῦμα τὸ Ἅγιον.","wordsOfJesus":true}]},{"type":"verse","number":12,"content":[{"noteId":989},{"text":"Παραδώσει δὲ ἀδελφὸς ἀδελφὸν εἰς θάνατον, καὶ πατὴρ τέκνον· καὶ ἐπαναστήσονται τέκνα ἐπὶ γονεῖς, καὶ θανατώσουσιν αὐτούς.","wordsOfJesus":true}]},{"type":"verse","number":13,"content":[{"text":"Καὶ ἔσεσθε","wordsOfJesus":true},{"noteId":990},{"text":"μισούμενοι ὑπὸ πάντων διὰ τὸ ὄνομά μου· ὁ δὲ ὑπομείνας εἰς τέλος, οὗτος σωθήσεται.","wordsOfJesus":true}]},{"type":"heading","content":["The Great Tribulation"]},{"type":"verse","number":14,"content":[{"text":"Ὅταν δὲ ἴδητε τὸ βδέλυγμα τῆς ἐρημώσεως,","wordsOfJesus":true},{"noteId":991},{"text":"τὸ ῥηθὲν ὑπὸ Δανιὴλ τοῦ προφήτου,","wordsOfJesus":true},{"noteId":992},{"text":"ἑστὼς ὅπου οὐ δεῖ","wordsOfJesus":true},"—ὁ ἀναγινώσκων νοείτω—",{"text":"τότε οἱ ἐν τῇ Ἰουδαίᾳ φευγέτωσαν εἰς τὰ ὄρη·","wordsOfJesus":true}]},{"type":"verse","number":15,"content":[{"text":"ὁ","wordsOfJesus":true},{"noteId":993},{"text":"δὲ ἐπὶ τοῦ δώματος μὴ καταβάτω","wordsOfJesus":true},{"noteId":994},{"text":"εἰς τὴν οἰκίαν, μηδὲ","wordsOfJesus":true},{"noteId":995},{"text":"εἰσελθέτω","wordsOfJesus":true},{"noteId":996},{"text":"ἆραί τι ἐκ τῆς οἰκίας αὐτοῦ·","wordsOfJesus":true}]},{"type":"verse","number":16,"content":[{"text":"καὶ ὁ εἰς τὸν ἀγρὸν","wordsOfJesus":true},{"noteId":997},{"text":"ὢν μὴ ἐπιστρεψάτω εἰς τὰ ὀπίσω, ἆραι τὸ ἱμάτιον αὐτοῦ.","wordsOfJesus":true}]},{"type":"verse","number":17,"content":[{"text":"Οὐαὶ δὲ ταῖς ἐν γαστρὶ ἐχούσαις καὶ ταῖς θηλαζούσαις ἐν ἐκείναις ταῖς ἡμέραις.","wordsOfJesus":true}]},{"type":"verse","number":18,"content":[{"text":"Προσεύχεσθε δὲ ἵνα μὴ γένηται","wordsOfJesus":true},{"noteId":998},{"text":"ἡ φυγὴ ὑμῶν χειμῶνος.","wordsOfJesus":true}]},{"type":"verse","number":19,"content":[{"text":"Ἔσονται γὰρ αἱ ἡμέραι ἐκεῖναι θλίψις, οἵα οὐ γέγονε τοιαύτη ἀπ᾽ ἀρχῆς κτίσεως","wordsOfJesus":true},{"noteId":999},{"text":"ἧς ἔκτισεν ὁ Θεὸς ἕως τοῦ νῦν, καὶ οὐ μὴ γένηται.","wordsOfJesus":true}]},{"type":"verse","number":20,"content":[{"text":"Καὶ εἰ μὴ","wordsOfJesus":true},{"noteId":1000},{"text":"Κύριος ἐκολόβωσε τὰς ἡμέρας, οὐκ ἂν ἐσώθη πᾶσα σάρξ· ἀλλὰ διὰ τοὺς ἐκλεκτούς, οὓς ἐξελέξατο, ἐκολόβωσε τὰς ἡμέρας.","wordsOfJesus":true}]},{"type":"verse","number":21,"content":[{"noteId":1001},{"text":"Τότε ἐάν τις ὑμῖν εἴπῃ,","wordsOfJesus":true},{"noteId":1002},{"text":"Ἰδού, ὧδε ὁ Χριστός,","wordsOfJesus":true},{"noteId":1003},{"text":"ἢ","wordsOfJesus":true},{"noteId":1004},{"text":"Ἰδού, ἐκεῖ, μὴ","wordsOfJesus":true},{"noteId":1005},{"text":"πιστεύετε.","wordsOfJesus":true}]},{"type":"verse","number":22,"content":[{"text":"Ἐγερθήσονται γὰρ ψευδόχριστοι καὶ ψευδοπροφῆται, καὶ δώσουσι σημεῖα καὶ τέρατα, πρὸς τὸ ἀποπλανᾷν, εἰ δυνατόν,","wordsOfJesus":true},{"noteId":1006},{"text":"καὶ τοὺς ἐκλεκτούς.","wordsOfJesus":true}]},{"type":"verse","number":23,"content":[{"text":"Ὑμεῖς δὲ βλέπετε·","wordsOfJesus":true},{"noteId":1007},{"text":"ἰδού, προείρηκα ὑμῖν","wordsOfJesus":true},{"noteId":1008},{"text":"πάντα.","wordsOfJesus":true}]},{"type":"heading","content":["The Coming of the Son of Man"]},{"type":"verse","number":24,"content":[{"noteId":1009},{"text":"Ἀλλ᾽ ἐν ἐκείναις ταῖς ἡμέραις, μετὰ τὴν θλίψιν ἐκείνην, ὁ ἥλιος σκοτισθήσεται, καὶ ἡ σελήνη οὐ δώσει τὸ φέγγος αὐτῆς,","wordsOfJesus":true}]},{"type":"verse","number":25,"content":[{"text":"καὶ οἱ ἀστέρες","wordsOfJesus":true},{"noteId":1010},{"text":"τοῦ οὐρανοῦ ἔσονται ἐκπίπτοντες, καὶ αἱ δυνάμεις αἱ ἐν τοῖς οὐρανοῖς σαλευθήσονται.","wordsOfJesus":true}]},{"type":"verse","number":26,"content":[{"text":"Καὶ τότε ὄψονται τὸν υἱὸν τοῦ ἀνθρώπου ἐρχόμενον ἐν νεφέλαις μετὰ δυνάμεως πολλῆς καὶ δόξης.","wordsOfJesus":true}]},{"type":"verse","number":27,"content":[{"text":"Καὶ τότε ἀποστελεῖ τοὺς ἀγγέλους","wordsOfJesus":true},{"noteId":1011},{"text":"αὐτοῦ, καὶ ἐπισυνάξει τοὺς ἐκλεκτοὺς","wordsOfJesus":true},{"noteId":1012},{"text":"αὐτοῦ ἐκ τῶν τεσσάρων ἀνέμων, ἀπ᾽ ἄκρου","wordsOfJesus":true},{"noteId":1013},{"text":"γῆς ἕως ἄκρου","wordsOfJesus":true},{"noteId":1014},{"text":"οὐρανοῦ.","wordsOfJesus":true}]},{"type":"heading","content":["The Lesson of the Fig Tree"]},{"type":"verse","number":28,"content":[{"text":"Ἀπὸ δὲ τῆς συκῆς μάθετε τὴν παραβολήν· ὅταν","wordsOfJesus":true},{"noteId":1015},{"text":"αὐτῆς ἤδη ὁ κλάδος","wordsOfJesus":true},{"noteId":1016},{"text":"ἁπαλὸς γένηται, καὶ ἐκφύῃ τὰ φύλλα,","wordsOfJesus":true},{"noteId":1017},{"text":"γινώσκετε ὅτι ἐγγὺς τὸ θέρος ἐστίν·","wordsOfJesus":true}]},{"type":"verse","number":29,"content":[{"text":"οὕτω καὶ ὑμεῖς, ὅταν","wordsOfJesus":true},{"noteId":1018},{"text":"ταῦτα ἴδητε","wordsOfJesus":true},{"noteId":1019},{"text":"γινόμενα,","wordsOfJesus":true},{"noteId":1020},{"text":"γινώσκετε ὅτι ἐγγύς ἐστιν ἐπὶ θύραις.","wordsOfJesus":true}]},{"type":"verse","number":30,"content":[{"text":"Ἀμὴν λέγω ὑμῖν ὅτι οὐ μὴ παρέλθῃ ἡ γενεὰ αὕτη, μέχρις οὗ","wordsOfJesus":true},{"noteId":1021},{"text":"πάντα ταῦτα γένηται.","wordsOfJesus":true}]},{"type":"verse","number":31,"content":[{"text":"Ὁ οὐρανὸς καὶ ἡ γῆ","wordsOfJesus":true},{"noteId":1022},{"text":"παρελεύσεται, οἱ δὲ","wordsOfJesus":true},{"noteId":1023},{"text":"λόγοι μου οὐ","wordsOfJesus":true},{"noteId":1024},{"text":"μὴ","wordsOfJesus":true},{"noteId":1025},{"text":"παρέλθωσι.","wordsOfJesus":true}]},{"type":"heading","content":["Keep Watch"]},{"type":"verse","number":32,"content":[{"text":"Περὶ δὲ τῆς ἡμέρας ἐκείνης","wordsOfJesus":true},{"noteId":1026},{"text":"ἢ","wordsOfJesus":true},{"noteId":1027},{"text":"ὥρας οὐδεὶς οἶδεν, οὐδὲ οἱ ἄγγελοι","wordsOfJesus":true},{"noteId":1028},{"text":"οἱ ἐν","wordsOfJesus":true},{"noteId":1029},{"text":"οὐρανῷ, οὐδὲ ὁ υἱός, εἰ μὴ ὁ πατήρ.","wordsOfJesus":true}]},{"type":"verse","number":33,"content":[{"text":"Βλέπετε, ἀγρυπνεῖτε","wordsOfJesus":true},{"noteId":1030},{"text":"καὶ προσεύχεσθε· οὐκ οἴδατε γὰρ πότε ὁ καιρός ἐστιν.","wordsOfJesus":true}]},{"type":"verse","number":34,"content":[{"text":"Ὡς ἄνθρωπος ἀπόδημος ἀφεὶς τὴν οἰκίαν αὐτοῦ, καὶ δοὺς τοῖς δούλοις αὐτοῦ τὴν ἐξουσίαν,","wordsOfJesus":true},{"noteId":1031},{"text":"καὶ ἑκάστῳ τὸ ἔργον αὐτοῦ, καὶ τῷ θυρωρῷ ἐνετείλατο ἵνα γρηγορῇ.","wordsOfJesus":true}]},{"type":"verse","number":35,"content":[{"text":"Γρηγορεῖτε οὖν· οὐκ οἴδατε γὰρ πότε ὁ κύριος τῆς οἰκίας ἔρχεται,","wordsOfJesus":true},{"noteId":1032},{"text":"ὀψέ, ἢ","wordsOfJesus":true},{"noteId":1033},{"text":"μεσονυκτίου, ἢ ἀλεκτοροφωνίας, ἢ πρωΐ·","wordsOfJesus":true}]},{"type":"verse","number":36,"content":[{"text":"μὴ ἐλθὼν","wordsOfJesus":true},{"noteId":1034},{"text":"ἐξαίφνης εὕρῃ ὑμᾶς καθεύδοντας.","wordsOfJesus":true}]},{"type":"verse","number":37,"content":[{"noteId":1035},{"text":"Ἃ δὲ ὑμῖν λέγω πᾶσι λέγω, Γρηγορεῖτε.","wordsOfJesus":true}]}],"footnotes":[{"noteId":965,"caller":"+","text":"ο ιησους αποκριθεις ¦ αποκριθεις ο ιησους PCK ¦ ο ιησους CT","reference":{"chapter":13,"verse":2}},{"noteId":966,"caller":"+","text":"αφεθη 78.4% ¦ αφεθη ωδε ANT CT PCK 21.4%","reference":{"chapter":13,"verse":2}},{"noteId":967,"caller":"+","text":"λιθω ¦ λιθον ANT CT","reference":{"chapter":13,"verse":2}},{"noteId":968,"caller":"+","text":"επηρωτων ¦ επηρωτα CT","reference":{"chapter":13,"verse":3}},{"noteId":969,"caller":"+","text":"ιωαννης ¦ ιωανης WH","reference":{"chapter":13,"verse":3}},{"noteId":970,"caller":"+","text":"ειπε ¦ ειπον CT","reference":{"chapter":13,"verse":4}},{"noteId":971,"caller":"+","text":"παντα ταυτα συντελεισθαι ¦ ταυτα συντελεισθαι παντα CT","reference":{"chapter":13,"verse":4}},{"noteId":972,"caller":"+","text":"αποκριθεις αυτοις ηρξατο λεγειν ¦ αποκριθεις ηρξατο λεγειν αυτοις ANT ¦ ηρξατο λεγειν αυτοις CT","reference":{"chapter":13,"verse":5}},{"noteId":973,"caller":"+","text":"γαρ ¦ — CT","reference":{"chapter":13,"verse":6}},{"noteId":974,"caller":"+","text":"γαρ ¦ — CT","reference":{"chapter":13,"verse":7}},{"noteId":975,"caller":"+","text":"επι ¦ επ CT","reference":{"chapter":13,"verse":8}},{"noteId":976,"caller":"+","text":"και ¦ — CT","referen