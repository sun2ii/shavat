{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"MRK","translationId":"grc_tcg","name":"ΚΑΤΑ ΜΑΡΚΟΝ","commonName":"ΚΑΤΑ ΜΑΡΚΟΝ","title":"ΚΑΤΑ ΜΑΡΚΟΝ","order":41,"numberOfChapters":16,"sha256":"458ddb37b7c88bd21fa977538125daa8129b125491fad25357901af5ebb1abc8","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/MRK/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/grc_tcg/MRK/16.json","totalNumberOfVerses":678},"chapter":{"number":14,"content":[{"type":"heading","content":["The Plot to Kill Jesus"]},{"type":"verse","number":1,"content":["Ἦν δὲ τὸ Πάσχα καὶ τὰ ἄζυμα μετὰ δύο ἡμέρας· καὶ ἐζήτουν οἱ ἀρχιερεῖς καὶ οἱ γραμματεῖς πῶς αὐτὸν ἐν δόλῳ κρατήσαντες ἀποκτείνωσιν."]},{"type":"verse","number":2,"content":["Ἔλεγον",{"noteId":1036},"δέ, Μὴ ἐν τῇ ἑορτῇ, μήποτε",{"noteId":1037},"θόρυβος ἔσται τοῦ λαοῦ."]},{"type":"heading","content":["Jesus Anointed at Bethany"]},{"type":"verse","number":3,"content":["Καὶ ὄντος αὐτοῦ ἐν Βηθανίᾳ, ἐν τῇ οἰκίᾳ Σίμωνος τοῦ λεπροῦ, κατακειμένου αὐτοῦ, ἦλθε γυνὴ ἔχουσα ἀλάβαστρον μύρου νάρδου πιστικῆς πολυτελοῦς·",{"noteId":1038},"καὶ συντρίψασα",{"noteId":1039},"τὸ ἀλάβαστρον, κατέχεεν αὐτοῦ",{"noteId":1040},"κατὰ τῆς κεφαλῆς."]},{"type":"verse","number":4,"content":["Ἦσαν δέ τινες ἀγανακτοῦντες πρὸς ἑαυτούς,",{"noteId":1041},"καὶ λέγοντες, Εἰς τί ἡ ἀπώλεια αὕτη τοῦ μύρου γέγονεν;"]},{"type":"verse","number":5,"content":["Ἠδύνατο γὰρ",{"noteId":1042},"τοῦτο πραθῆναι ἐπάνω",{"noteId":1043},"τριακοσίων δηναρίων, καὶ δοθῆναι τοῖς πτωχοῖς. Καὶ ἐνεβριμῶντο αὐτῇ."]},{"type":"verse","number":6,"content":["Ὁ δὲ Ἰησοῦς εἶπεν,",{"text":"Ἄφετε αὐτήν· τί αὐτῇ κόπους παρέχετε; Καλὸν ἔργον","wordsOfJesus":true},{"noteId":1044},{"text":"εἰργάσατο","wordsOfJesus":true},{"noteId":1045},{"text":"ἐν ἐμοί.","wordsOfJesus":true}]},{"type":"verse","number":7,"content":[{"text":"Πάντοτε γὰρ τοὺς πτωχοὺς ἔχετε μεθ᾽ ἑαυτῶν, καὶ ὅταν θέλητε δύνασθε","wordsOfJesus":true},{"noteId":1046},{"text":"αὐτοὺς","wordsOfJesus":true},{"noteId":1047},{"text":"εὖ ποιῆσαι· ἐμὲ δὲ οὐ πάντοτε ἔχετε.","wordsOfJesus":true}]},{"type":"verse","number":8,"content":[{"text":"Ὃ","wordsOfJesus":true},{"noteId":1048},{"text":"ἔσχεν","wordsOfJesus":true},{"noteId":1049},{"text":"αὕτη ἐποίησε· προέλαβε μυρίσαι","wordsOfJesus":true},{"noteId":1050},{"text":"μου τὸ σῶμα εἰς τὸν ἐνταφιασμόν.","wordsOfJesus":true}]},{"type":"verse","number":9,"content":[{"noteId":1051},{"text":"Ἀμὴν λέγω ὑμῖν, ὅπου","wordsOfJesus":true},{"noteId":1052},{"text":"ἐὰν κηρυχθῇ τὸ εὐαγγέλιον","wordsOfJesus":true},{"noteId":1053},{"text":"τοῦτο εἰς ὅλον τὸν κόσμον, καὶ ὃ ἐποίησεν αὕτη λαληθήσεται εἰς μνημόσυνον αὐτῆς.","wordsOfJesus":true}]},{"type":"heading","content":["Judas Agrees to Betray Jesus"]},{"type":"verse","number":10,"content":["Καὶ",{"noteId":1054},"ὁ Ἰούδας",{"noteId":1055},"ὁ Ἰσκαριώτης, εἷς τῶν δώδεκα, ἀπῆλθε πρὸς τοὺς ἀρχιερεῖς, ἵνα",{"noteId":1056},"παραδῷ αὐτὸν αὐτοῖς."]},{"type":"verse","number":11,"content":["Οἱ δὲ ἀκούσαντες ἐχάρησαν, καὶ ἐπηγγείλαντο αὐτῷ",{"noteId":1057},"ἀργύριον δοῦναι, καὶ ἐζήτει πῶς",{"noteId":1058},"εὐκαίρως αὐτὸν παραδῷ."]},{"type":"heading","content":["The Passover with the Disciples"]},{"type":"verse","number":12,"content":["Καὶ τῇ πρώτῃ ἡμέρᾳ τῶν ἀζύμων, ὅτε τὸ Πάσχα ἔθυον, λέγουσιν αὐτῷ οἱ μαθηταὶ αὐτοῦ, Ποῦ θέλεις ἀπελθόντες",{"noteId":1059},"ἑτοιμάσωμεν ἵνα φάγῃς τὸ Πάσχα;"]},{"type":"verse","number":13,"content":["Καὶ ἀποστέλλει δύο τῶν μαθητῶν αὐτοῦ, καὶ λέγει αὐτοῖς,",{"text":"Ὑπάγετε εἰς τὴν πόλιν, καὶ ἀπαντήσει ὑμῖν ἄνθρωπος κεράμιον ὕδατος βαστάζων· ἀκολουθήσατε αὐτῷ,","wordsOfJesus":true}]},{"type":"verse","number":14,"content":[{"text":"καὶ ὅπου ἐὰν εἰσέλθῃ, εἴπατε τῷ οἰκοδεσπότῃ ὅτι Ὁ διδάσκαλος λέγει, Ποῦ ἐστι τὸ","wordsOfJesus":true},{"noteId":1060},{"text":"κατάλυμα, ὅπου τὸ Πάσχα μετὰ τῶν μαθητῶν μου φάγω;","wordsOfJesus":true}]},{"type":"verse","number":15,"content":[{"text":"Καὶ αὐτὸς ὑμῖν δείξει","wordsOfJesus":true},{"noteId":1061},{"text":"ἀνώγεον μέγα ἐστρωμένον ἕτοιμον·","wordsOfJesus":true},{"noteId":1062},{"text":"ἐκεῖ ἑτοιμάσατε ἡμῖν.","wordsOfJesus":true}]},{"type":"verse","number":16,"content":["Καὶ ἐξῆλθον οἱ μαθηταὶ",{"noteId":1063},"αὐτοῦ, καὶ ἦλθον εἰς τὴν πόλιν, καὶ εὗρον καθὼς εἶπεν αὐτοῖς, καὶ ἡτοίμασαν τὸ Πάσχα."]},{"type":"verse","number":17,"content":["Καὶ ὀψίας γενομένης ἔρχεται μετὰ τῶν δώδεκα."]},{"type":"verse","number":18,"content":["Καὶ ἀνακειμένων αὐτῶν καὶ ἐσθιόντων,",{"noteId":1064},"εἶπεν ὁ Ἰησοῦς,",{"text":"Ἀμὴν λέγω ὑμῖν ὅτι εἷς ἐξ ὑμῶν παραδώσει με, ὁ ἐσθίων μετ᾽ ἐμοῦ.","wordsOfJesus":true}]},{"type":"verse","number":19,"content":[{"noteId":1065},"Οἱ δὲ ἤρξαντο λυπεῖσθαι, καὶ λέγειν αὐτῷ εἷς",{"noteId":1066},"καθ᾽ εἷς, Μήτι ἐγώ;",{"noteId":1067},"Καὶ ἄλλος, Μήτι ἐγώ;"]},{"type":"verse","number":20,"content":["Ὁ δὲ",{"noteId":1068},"ἀποκριθεὶς εἶπεν αὐτοῖς,",{"text":"Εἷς","wordsOfJesus":true},{"noteId":1069},{"text":"ἐκ τῶν δώδεκα, ὁ ἐμβαπτόμενος μετ᾽ ἐμοῦ εἰς τὸ","wordsOfJesus":true},{"noteId":1070},{"text":"τρυβλίον.","wordsOfJesus":true}]},{"type":"verse","number":21,"content":[{"noteId":1071},{"text":"Ὁ μὲν υἱὸς τοῦ ἀνθρώπου ὑπάγει, καθὼς γέγραπται περὶ αὐτοῦ· οὐαὶ δὲ τῷ ἀνθρώπῳ ἐκείνῳ δι᾽ οὗ ὁ υἱὸς τοῦ ἀνθρώπου παραδίδοται· καλὸν","wordsOfJesus":true},{"noteId":1072},{"text":"ἦν αὐτῷ εἰ οὐκ ἐγεννήθη ὁ ἄνθρωπος ἐκεῖνος.","wordsOfJesus":true}]},{"type":"heading","content":["The Institution of the Lord's Supper"]},{"type":"verse","number":22,"content":["Καὶ ἐσθιόντων αὐτῶν, λαβὼν",{"noteId":1073},"ὁ Ἰησοῦς ἄρτον,",{"noteId":1074},"εὐλογήσας ἔκλασε καὶ ἔδωκεν αὐτοῖς, καὶ εἶπε,",{"text":"Λάβετε,","wordsOfJesus":true},{"noteId":1075},{"text":"φάγετε· τοῦτό ἐστι τὸ σῶμά μου.","wordsOfJesus":true}]},{"type":"verse","number":23,"content":["Καὶ λαβὼν",{"noteId":1076},"τὸ ποτήριον, εὐχαριστήσας ἔδωκεν αὐτοῖς, καὶ ἔπιον ἐξ αὐτοῦ πάντες."]},{"type":"verse","number":24,"content":["Καὶ εἶπεν αὐτοῖς,",{"text":"Τοῦτό ἐστι τὸ αἷμά μου,","wordsOfJesus":true},{"noteId":1077},{"text":"τὸ τῆς καινῆς διαθήκης, τὸ","wordsOfJesus":true},{"noteId":1078},{"text":"περὶ πολλῶν ἐκχυνόμενον.","wordsOfJesus":true}]},{"type":"verse","number":25,"content":[{"text":"Ἀμὴν λέγω ὑμῖν ὅτι οὐκέτι οὐ μὴ πίω ἐκ τοῦ","wordsOfJesus":true},{"noteId":1079},{"text":"γενήματος τῆς ἀμπέλου, ἕως τῆς ἡμέρας ἐκείνης ὅταν αὐτὸ πίνω καινὸν ἐν τῇ βασιλείᾳ τοῦ Θεοῦ.","wordsOfJesus":true}]},{"type":"verse","number":26,"content":["Καὶ ὑμνήσαντες ἐξῆλθον εἰς τὸ ὄρος τῶν Ἐλαιῶν."]},{"type":"heading","content":["Jesus Predicts Peter's Denial"]},{"type":"verse","number":27,"content":["Καὶ λέγει αὐτοῖς ὁ Ἰησοῦς ὅτι",{"text":"Πάντες σκανδαλισθήσεσθε","wordsOfJesus":true},{"noteId":1080},{"text":"ἐν ἐμοὶ ἐν τῇ νυκτὶ ταύτῃ· ὅτι γέγραπται, Πατάξω τὸν ποιμένα, καὶ","wordsOfJesus":true},{"noteId":1081},{"text":"διασκορπισθήσεται τὰ πρόβατα.","wordsOfJesus":true}]},{"type":"verse","number":28,"content":[{"noteId":1082},{"text":"Ἀλλὰ μετὰ τὸ ἐγερθῆναί με, προάξω ὑμᾶς εἰς τὴν Γαλιλαίαν.","wordsOfJesus":true}]},{"type":"verse","number":29,"content":["Ὁ δὲ Πέτρος ἔφη αὐτῷ,",{"noteId":1083},"Καὶ εἰ πάντες σκανδαλισθήσονται, ἀλλ᾽ οὐκ ἐγώ."]},{"type":"verse","number":30,"content":["Καὶ λέγει αὐτῷ ὁ Ἰησοῦς,",{"text":"Ἀμὴν λέγω σοι ὅτι","wordsOfJesus":true},{"noteId":1084},{"text":"σὺ σήμερον","wordsOfJesus":true},{"noteId":1085},{"text":"ἐν τῇ νυκτὶ ταύτῃ, πρὶν ἢ δὶς ἀλέκτορα φωνῆσαι, τρὶς","wordsOfJesus":true},{"noteId":1086},{"text":"ἀπαρνήσῃ με.","wordsOfJesus":true}]},{"type":"verse","number":31,"content":["Ὁ",{"noteId":1087},"δὲ",{"noteId":1088},"ἐκπερισσοῦ ἔλεγε μᾶλλον, Ἐάν",{"noteId":1089},"με δέῃ συναποθανεῖν σοι, οὐ μή σε",{"noteId":1090},"ἀπαρνήσωμαι. Ὡσαύτως δὲ καὶ πάντες ἔλεγον."]},{"type":"heading","content":["Jesus Prays in the Garden of Gethsemane"]},{"type":"verse","number":32,"content":["Καὶ ἔρχονται εἰς χωρίον οὗ τὸ ὄνομα",{"noteId":1091},"Γεθσημανῆ, καὶ λέγει τοῖς μαθηταῖς αὐτοῦ,",{"text":"Καθίσατε ὧδε, ἕως","wordsOfJesus":true},{"noteId":1092},{"text":"προσεύξωμαι.","wordsOfJesus":true}]},{"type":"verse","number":33,"content":["Καὶ παραλαμβάνει τὸν Πέτρον καὶ",{"noteId":1093},"Ἰάκωβον καὶ",{"noteId":1094},"Ἰωάννην",{"noteId":1095},"μεθ᾽ ἑαυτοῦ, καὶ ἤρξατο ἐκθαμβεῖσθαι καὶ ἀδημονεῖν."]},{"type":"verse","number":34,"content":["Καὶ",{"noteId":1096},"λέγει αὐτοῖς,",{"text":"Περίλυπός ἐστιν ἡ ψυχή μου ἕως θανάτου· μείνατε ὧδε καὶ γρηγορεῖτε.","wordsOfJesus":true}]},{"type":"verse","number":35,"content":["Καὶ",{"noteId":1097},"προσελθὼν μικρόν,",{"noteId":1098},"ἔπεσεν ἐπὶ τῆς γῆς, καὶ προσηύχετο ἵνα, εἰ δυνατόν ἐστι, παρέλθῃ ἀπ᾽ αὐτοῦ ἡ ὥρα."]},{"type":"verse","number":36,"content":["Καὶ ἔλεγεν,",{"text":"Ἀββᾶ, ὁ πατήρ, πάντα δυνατά σοι.","wordsOfJesus":true},{"noteId":1099},{"text":"Παρένεγκε τὸ ποτήριον","wordsOfJesus":true},{"noteId":1100},{"text":"ἀπ᾽ ἐμοῦ τοῦτο· ἀλλ᾽ οὐ τί ἐγὼ θέλω,","wordsOfJesus":true},{"noteId":1101},{"text":"ἀλλὰ τί σύ.","wordsOfJesus":true}]},{"type":"verse","number":37,"content":["Καὶ ἔρχεται καὶ εὑρίσκει αὐτοὺς καθεύδοντας, καὶ λέγει τῷ Πέτρῳ,",{"text":"Σίμων, καθεύδεις; Οὐκ","wordsOfJesus":true},{"noteId":1102},{"text":"ἴσχυσας μίαν ὥραν γρηγορῆσαι;","wordsOfJesus":true}]},{"type":"verse","number":38,"content":[{"text":"Γρηγορεῖτε καὶ προσεύχεσθε, ἵνα μὴ","wordsOfJesus":true},{"noteId":1103},{"text":"εἰσέλθητε εἰς πειρασμόν. Τὸ μὲν πνεῦμα πρόθυμον, ἡ δὲ σὰρξ ἀσθενής.","wordsOfJesus":true}]},{"type":"verse","number":39,"content":["Καὶ πάλιν ἀπελθὼν προσηύξατο, τὸν αὐτὸν λόγον εἰπών."]},{"type":"verse","number":40,"content":["Καὶ",{"noteId":1104},"ὑποστρέψας εὗρεν αὐτοὺς πάλιν καθεύδοντας· ἦσαν γὰρ",{"noteId":1105},"οἱ ὀφθαλμοὶ αὐτῶν",{"noteId":1106},"βεβαρημένοι, καὶ οὐκ ᾔδεισαν τί",{"noteId":1107},"αὐτῷ ἀποκριθῶσι."]},{"type":"verse","number":41,"content":["Καὶ ἔρχεται τὸ τρίτον, καὶ λέγει αὐτοῖς,",{"text":"Καθεύδετε","wordsOfJesus":true},{"noteId":1108},{"text":"λοιπὸν καὶ ἀναπαύεσθε. Ἀπέχει· ἦλθεν ἡ ὥρα. Ἰδού, παραδίδοται ὁ υἱὸς τοῦ ἀνθρώπου εἰς τὰς χεῖρας τῶν ἁμαρτωλῶν.","wordsOfJesus":true}]},{"type":"verse","number":42,"content":[{"text":"Ἐγείρεσθε, ἄγωμεν. Ἰδού, ὁ παραδιδούς με ἤγγικε.","wordsOfJesus":true}]},{"type":"heading","content":["Jesus Arrested"]},{"type":"verse","number":43,"content":["Καὶ",{"noteId":1109},"εὐθέως, ἔτι αὐτοῦ λαλοῦντος,",{"noteId":1110},"παραγίνεται",{"noteId":1111},"Ἰούδας, εἷς",{"noteId":1112},"ὢν τῶν δώδεκα, καὶ μετ᾽ αὐτοῦ ὄχλος",{"noteId":1113},"πολὺς μετὰ μαχαιρῶν καὶ ξύλων,",{"noteId":1114},"παρὰ τῶν ἀρχιερέων καὶ",{"noteId":1115},"τῶν γραμματέων καὶ τῶν πρεσβυτέρων."]},{"type":"verse","number":44,"content":["Δεδώκει δὲ ὁ παραδιδοὺς αὐτὸν σύσσημον αὐτοῖς, λέγων, Ὃν ἂν φιλήσω, αὐτός ἐστι· κρατήσατε αὐτόν, καὶ",{"noteId":1116},"ἀπαγάγετε ἀσφαλῶς."]},{"type":"verse","number":45,"content":["Καὶ ἐλθών,",{"noteId":1117},"εὐθέως προσελθὼν αὐτῷ λέγει",{"noteId":1118},"αὐτῷ,",{"noteId":1119},"Ῥαββί, ῥαββί· καὶ κατεφίλησεν αὐτόν."]},{"type":"verse","number":46,"content":["Οἱ δὲ",{"noteId":1120},"ἐπέβαλον",{"noteId":1121},"ἐπ᾽ αὐτὸν τὰς χεῖρας αὐτῶν, καὶ ἐκράτησαν αὐτόν."]},{"type":"verse","number":47,"content":["Εἷς δέ τις τῶν παρεστηκότων σπασάμενος τὴν μάχαιραν ἔπαισε τὸν δοῦλον τοῦ ἀρχιερέως, καὶ ἀφεῖλεν αὐτοῦ τὸ",{"noteId":1122},"ὠτίον."]},{"type":"verse","number":48,"content":["Καὶ ἀποκριθεὶς ὁ Ἰησοῦς εἶπεν αὐτοῖς,",{"text":"Ὡς ἐπὶ λῃστὴν","wordsOfJesus":true},{"noteId":1123},{"text":"ἐξήλθετε μετὰ μαχαιρῶν καὶ ξύλων συλλαβεῖν με;","wordsOfJesus":true}]},{"type":"verse","number":49,"content":[{"text":"Καθ᾽ ἡμέραν","wordsOfJesus":true},{"noteId":1124},{"text":"ἤμην πρὸς ὑμᾶς ἐν τῷ ἱερῷ διδάσκων, καὶ οὐκ ἐκρατήσατέ με· ἀλλ᾽ ἵνα πληρωθῶσιν αἱ γραφαί.","wordsOfJesus":true}]},{"type":"verse","number":50,"content":["Καὶ ἀφέντες αὐτὸν",{"noteId":1125},"πάντες ἔφυγον."]},{"type":"heading","content":["A Young Man Flees"]},{"type":"verse","number":51,"content":["Καὶ",{"noteId":1126},"εἷς τις νεανίσκος",{"noteId":1127},"ἠκολούθησεν αὐτῷ, περιβεβλημένος σινδόνα ἐπὶ γυμνοῦ. Καὶ κρατοῦσιν αὐτὸν",{"noteId":1128},"οἱ νεανίσκοι·"]},{"type":"verse","number":52,"content":["ὁ δὲ καταλιπὼν τὴν σινδόνα γυμνὸς ἔφυγεν",{"noteId":1129},"ἀπ᾽ αὐτῶν."]},{"type":"heading","content":["Jesus Faces the Sanhedrin"]},{"type":"verse","number":53,"content":["Καὶ ἀπήγαγον τὸν Ἰησοῦν πρὸς τὸν ἀρχιερέα· καὶ συνέρχονται",{"noteId":1130},"αὐτῷ πάντες οἱ ἀρχιερεῖς καὶ οἱ πρεσβύτεροι καὶ οἱ γραμματεῖς."]},{"type":"verse","number":54,"content":["Καὶ ὁ Πέτρος ἀπὸ μακρόθεν ἠκολούθησεν αὐτῷ ἕως ἔσω εἰς τὴν αὐλὴν τοῦ ἀρχιερέως· καὶ ἦν",{"noteId":1131},"συγκαθήμενος μετὰ τῶν ὑπηρετῶν, καὶ θερμαινόμενος πρὸς τὸ φῶς."]},{"type":"verse","number":55,"content":["Οἱ δὲ ἀρχιερεῖς καὶ ὅλον τὸ συνέδριον ἐζήτουν κατὰ τοῦ Ἰησοῦ μαρτυρίαν, εἰς τὸ θανατῶσαι αὐτόν, καὶ οὐχ",{"noteId":1132},"εὕρισκον."]},{"type":"verse","number":56,"content":["Πολλοὶ γὰρ ἐψευδομαρτύρουν κατ᾽ αὐτοῦ, καὶ ἴσαι αἱ μαρτυρίαι οὐκ ἦσαν."]},{"type":"verse","number":57,"content":["Καί τινες ἀναστάντες ἐψευδομαρτύρουν κατ᾽ αὐτοῦ, λέγοντες"]},{"type":"verse","number":58,"content":["ὅτι Ἡμεῖς ἠκούσαμεν αὐτοῦ λέγοντος ὅτι Ἐγὼ καταλύσω τὸν ναὸν τοῦτον τὸν χειροποίητον, καὶ διὰ τριῶν ἡμερῶν ἄλλον ἀχειροποίητον οἰκοδομήσω."]},{"type":"verse","number":59,"content":["Καὶ οὐδὲ οὕτως ἴση ἦν ἡ μαρτυρία αὐτῶν."]},{"type":"verse","number":60,"content":["Καὶ ἀναστὰς ὁ ἀρχιερεὺς εἰς",{"noteId":1133},"μέσον",{"noteId":1134},"ἐπηρώτησε τὸν Ἰησοῦν, λέγων, Οὐκ ἀποκρίνῃ οὐδέν; Τί οὗτοί σου καταμαρτυροῦσιν;"]},{"type":"verse","number":61,"content":["Ὁ δὲ ἐσιώπα, καὶ",{"noteId":1135},"οὐδὲν ἀπεκρίνατο. Πάλιν ὁ ἀρχιερεὺς ἐπηρώτα αὐτόν, καὶ λέγει αὐτῷ, Σὺ εἶ ὁ Χριστός, ὁ υἱὸς τοῦ εὐλογητοῦ;"]},{"type":"verse","number":62,"content":["Ὁ δὲ Ἰησοῦς εἶπεν,",{"text":"Ἐγώ εἰμι. Καὶ ὄψεσθε τὸν υἱὸν τοῦ ἀνθρώπου","wordsOfJesus":true},{"noteId":1136},{"text":"ἐκ δεξιῶν καθήμενον τῆς δυνάμεως, καὶ ἐρχόμενον","wordsOfJesus":true},{"noteId":1137},{"text":"μετὰ τῶν νεφελῶν τοῦ οὐρανοῦ.","wordsOfJesus":true}]},{"type":"verse","number":63,"content":["Ὁ δὲ ἀρχιερεὺς",{"noteId":1138},"διαρρήξας τοὺς χιτῶνας αὐτοῦ λέγει, Τί ἔτι χρείαν ἔχομεν μαρτύρων;"]},{"type":"verse","number":64,"content":[{"noteId":1139},"Ἠκούσατε τῆς βλασφημίας. Τί ὑμῖν φαίνεται; Οἱ δὲ πάντες κατέκριναν αὐτὸν",{"noteId":1140},"εἶναι ἔνοχον θανάτου."]},{"type":"verse","number":65,"content":["Καὶ ἤρξαντό τινες ἐμπτύειν αὐτῷ, καὶ περικαλύπτειν",{"noteId":1141},"τὸ πρόσωπον αὐτοῦ, καὶ κολαφίζειν αὐτόν, καὶ λέγειν αὐτῷ,",{"noteId":1142},"Προφήτευσον. Καὶ οἱ ὑπηρέται ῥαπίσμασιν αὐτὸν",{"noteId":1143},"ἔβαλλον."]},{"type":"heading","content":["Peter Denies Jesus"]},{"type":"verse","number":66,"content":["Καὶ ὄντος τοῦ Πέτρου",{"noteId":1144},"ἐν τῇ αὐλῇ κάτω, ἔρχεται μία τῶν παιδισκῶν τοῦ ἀρχιερέως,"]},{"type":"verse","number":67,"content":["καὶ ἰδοῦσα τὸν Πέτρον θερμαινόμενον, ἐμβλέψασα αὐτῷ λέγει, Καὶ σὺ μετὰ τοῦ",{"noteId":1145},"Ναζαρηνοῦ",{"noteId":1146},"Ἰησοῦ ἦσθα."]},{"type":"verse","number":68,"content":["Ὁ δὲ ἠρνήσατο, λέγων,",{"noteId":1147},"Οὐκ οἶδα,",{"noteId":1148},"οὐδὲ ἐπίσταμαι",{"noteId":1149},"τί σὺ λέγεις. Καὶ ἐξῆλθεν ἔξω εἰς τὸ προαύλιον·",{"noteId":1150},"καὶ ἀλέκτωρ ἐφώνησε."]},{"type":"verse","number":69,"content":["Καὶ ἡ παιδίσκη ἰδοῦσα αὐτὸν",{"noteId":1151},"πάλιν ἤρξατο λέγειν τοῖς",{"noteId":1152},"παρεστηκόσιν ὅτι Οὗτος ἐξ αὐτῶν ἐστιν."]},{"type":"verse","number":70,"content":["Ὁ δὲ πάλιν ἠρνεῖτο. Καὶ μετὰ μικρὸν πάλιν οἱ παρεστῶτες ἔλεγον τῷ Πέτρῳ, Ἀληθῶς ἐξ αὐτῶν εἶ· καὶ γὰρ Γαλιλαῖος εἶ,",{"noteId":1153},"καὶ ἡ λαλιά σου ὁμοιάζει."]},{"type":"verse","number":71,"content":["Ὁ δὲ ἤρξατο ἀναθεματίζειν καὶ",{"noteId":1154},"ὀμνύναι ὅτι Οὐκ οἶδα τὸν ἄνθρωπον τοῦτον ὃν λέγετε."]},{"type":"verse","number":72,"content":[{"noteId":1155},"Καὶ ἐκ δευτέρου ἀλέκτωρ ἐφώνησε. Καὶ ἀνεμνήσθη ὁ Πέτρος",{"noteId":1156},"τὸ ῥῆμα ὃ εἶπεν αὐτῷ ὁ Ἰησοῦς ὅτι",{"text":"Πρὶν ἀλέκτορα","wordsOfJesus":true},{"noteId":1157},{"text":"φωνῆσαι δίς,","wordsOfJesus":true},{"noteId":1158},{"text":"ἀπαρνήσῃ με τρίς.","wordsOfJesus":true},"Καὶ ἐπιβαλὼν ἔκλαιε."]}],"footnotes":[{"noteId":1036,"caller":"+","text":"δε ¦ γαρ CT","reference":{"chapter":14,"verse":2}},{"noteId":1037,"caller":"+","text":"θορυβος εσται ¦ εσται θορυβος CT","reference":{"chapter":14,"verse":2}},{"noteId":1038,"caller":"+","text":"και ¦ — CT","reference":{"chapter":14,"verse":3}},{"noteId":1039,"caller":"+","text":"το ¦ τον 𝔐pt ¦ την CT","reference":{"chapter":14,"verse":3}},{"noteId":1040,"caller":"+","text":"κατα ¦ — CT","reference":{"chapter":14,"verse":3}},{"noteId":1041,"caller":"+","text":"και λεγοντες ¦ λεγοντες ANT ¦ — CT","reference":{"chapter":14,"verse":4}},{"noteId":1042,"caller":"+","text":"τουτο ¦ τουτο το μυρον ANT CT","reference":{"chapter":14,"verse":5}},{"noteId":1043,"caller":"+","text":"τριακοσιων δηναριων ¦ δηναριων τριακοσιων ECM† NA SBL TH WH","reference":{"chapter":14,"verse":5}},{"noteId":1044,"caller":"+","text":"ειργασατο ¦ ηργασατο CT","reference":{"chapter":14,"verse":6}},{"noteId":1045,"caller":"+","text":"εν εμοι ¦ εις εμε TR","reference":{"chapter":14,"verse":6}},{"noteId":1046,"caller":"+","text":"αυτους ¦ αυτοις CT","reference":{"chapter":14,"verse":7}},{"noteId":1047,"caller":"+","text":"ευ ¦ παντοτε ευ WH","reference":{"chapter":14,"verse":7}},{"noteId":1048,"caller":"+","text":"εσχεν ¦ ειχεν TR","reference":{"chapter":14,"verse":8}},{"noteId":1049,"caller":"+","text":"αυτη ¦ — CT","reference":{"chapter":14,"verse":8}},{"noteId":1050,"caller":"+","text":"μου το σωμα ¦ το σωμα μου CT","reference":{"chapter":14,"verse":8}},{"noteId":1051,"caller":"+","text":"αμην ¦ αμην δε 𝔐pt CT HF","reference"