{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"MRK","translationId":"grc_tcg","name":"ΚΑΤΑ ΜΑΡΚΟΝ","commonName":"ΚΑΤΑ ΜΑΡΚΟΝ","title":"ΚΑΤΑ ΜΑΡΚΟΝ","order":41,"numberOfChapters":16,"sha256":"458ddb37b7c88bd21fa977538125daa8129b125491fad25357901af5ebb1abc8","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/MRK/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/grc_tcg/MRK/16.json","totalNumberOfVerses":678},"chapter":{"number":15,"content":[{"type":"heading","content":["Jesus Handed Over to Pontius Pilate"]},{"type":"verse","number":1,"content":["Καὶ",{"noteId":1159},"εὐθέως",{"noteId":1160},"ἐπὶ τὸ πρωῒ συμβούλιον ποιήσαντες οἱ ἀρχιερεῖς μετὰ τῶν πρεσβυτέρων καὶ γραμματέων, καὶ ὅλον τὸ συνέδριον, δήσαντες τὸν Ἰησοῦν ἀπήνεγκαν καὶ παρέδωκαν",{"noteId":1161},"τῷ",{"noteId":1162},"Πιλάτῳ."]},{"type":"verse","number":2,"content":["Καὶ ἐπηρώτησεν αὐτὸν ὁ",{"noteId":1163},"Πιλάτος, Σὺ εἶ ὁ βασιλεὺς τῶν Ἰουδαίων; Ὁ δὲ ἀποκριθεὶς",{"noteId":1164},"εἶπεν αὐτῷ,",{"text":"Σὺ λέγεις.","wordsOfJesus":true}]},{"type":"verse","number":3,"content":["Καὶ κατηγόρουν αὐτοῦ οἱ ἀρχιερεῖς",{"noteId":1165},"πολλά·"]},{"type":"verse","number":4,"content":["ὁ δὲ",{"noteId":1166},"Πιλάτος πάλιν",{"noteId":1167},"ἐπηρώτησεν αὐτόν, λέγων, Οὐκ ἀποκρίνῃ οὐδέν; Ἴδε, πόσα σου",{"noteId":1168},"καταμαρτυροῦσιν."]},{"type":"verse","number":5,"content":["Ὁ δὲ Ἰησοῦς οὐκέτι οὐδὲν ἀπεκρίθη, ὥστε θαυμάζειν τὸν",{"noteId":1169},"Πιλάτον."]},{"type":"heading","content":["The Crowd Calls For Jesus' Crucifixion"]},{"type":"verse","number":6,"content":["Κατὰ δὲ ἑορτὴν ἀπέλυεν αὐτοῖς ἕνα δέσμιον,",{"noteId":1170},"ὅνπερ ᾐτοῦντο."]},{"type":"verse","number":7,"content":["Ἦν δὲ ὁ λεγόμενος Βαραββᾶς μετὰ τῶν",{"noteId":1171},"συστασιαστῶν δεδεμένος, οἵτινες ἐν τῇ στάσει φόνον πεποιήκεισαν."]},{"type":"verse","number":8,"content":["Καὶ",{"noteId":1172},"ἀναβοήσας ὁ ὄχλος ἤρξατο αἰτεῖσθαι καθὼς",{"noteId":1173},"ἀεὶ ἐποίει αὐτοῖς."]},{"type":"verse","number":9,"content":["Ὁ δὲ",{"noteId":1174},"Πιλάτος ἀπεκρίθη αὐτοῖς, λέγων, Θέλετε ἀπολύσω ὑμῖν τὸν βασιλέα τῶν Ἰουδαίων;"]},{"type":"verse","number":10,"content":[{"noteId":1175},"Ἐγίνωσκε γὰρ ὅτι διὰ φθόνον παραδεδώκεισαν αὐτὸν οἱ ἀρχιερεῖς."]},{"type":"verse","number":11,"content":["Οἱ δὲ ἀρχιερεῖς ἀνέσεισαν τὸν ὄχλον ἵνα μᾶλλον τὸν Βαραββᾶν ἀπολύσῃ αὐτοῖς."]},{"type":"verse","number":12,"content":["Ὁ δὲ",{"noteId":1176},"Πιλάτος",{"noteId":1177},"ἀποκριθεὶς πάλιν",{"noteId":1178},"εἶπεν αὐτοῖς, Τί οὖν",{"noteId":1179},"θέλετε ποιήσω ὃν λέγετε",{"noteId":1180},"βασιλέα τῶν Ἰουδαίων;"]},{"type":"verse","number":13,"content":["Οἱ δὲ πάλιν ἔκραξαν, Σταύρωσον αὐτόν."]},{"type":"verse","number":14,"content":["Ὁ δὲ",{"noteId":1181},"Πιλάτος ἔλεγεν αὐτοῖς, Τί γὰρ",{"noteId":1182},"κακὸν ἐποίησεν; Οἱ δὲ",{"noteId":1183},"περισσοτέρως ἔκραξαν, Σταύρωσον αὐτόν."]},{"type":"verse","number":15,"content":["Ὁ δὲ",{"noteId":1184},"Πιλάτος βουλόμενος τῷ ὄχλῳ τὸ ἱκανὸν ποιῆσαι, ἀπέλυσεν αὐτοῖς τὸν Βαραββᾶν· καὶ παρέδωκε τὸν Ἰησοῦν φραγελλώσας ἵνα σταυρωθῇ."]},{"type":"heading","content":["The Soldiers Mock Jesus"]},{"type":"verse","number":16,"content":["Οἱ δὲ στρατιῶται ἀπήγαγον αὐτὸν ἔσω τῆς αὐλῆς, ὅ ἐστι πραιτώριον, καὶ",{"noteId":1185},"συγκαλοῦσιν ὅλην τὴν σπεῖραν."]},{"type":"verse","number":17,"content":["Καὶ",{"noteId":1186},"ἐνδύουσιν αὐτὸν πορφύραν, καὶ περιτιθέασιν αὐτῷ πλέξαντες ἀκάνθινον στέφανον,"]},{"type":"verse","number":18,"content":["καὶ ἤρξαντο ἀσπάζεσθαι",{"noteId":1187},"αὐτόν, Χαῖρε,",{"noteId":1188},"ὁ βασιλεὺς τῶν Ἰουδαίων·"]},{"type":"verse","number":19,"content":["καὶ ἔτυπτον αὐτοῦ τὴν κεφαλὴν καλάμῳ, καὶ ἐνέπτυον αὐτῷ, καὶ τιθέντες τὰ γόνατα προσεκύνουν αὐτῷ."]},{"type":"verse","number":20,"content":["Καὶ ὅτε ἐνέπαιξαν αὐτῷ, ἐξέδυσαν αὐτὸν τὴν πορφύραν, καὶ ἐνέδυσαν αὐτὸν τὰ ἱμάτια",{"noteId":1189},"τὰ ἴδια, καὶ ἐξάγουσιν αὐτὸν ἵνα σταυρώσωσιν αὐτόν."]},{"type":"heading","content":["The Crucifixion"]},{"type":"verse","number":21,"content":["Καὶ ἀγγαρεύουσι παράγοντά τινα Σίμωνα Κυρηναῖον, ἐρχόμενον ἀπ᾽ ἀγροῦ, τὸν πατέρα Ἀλεξάνδρου καὶ Ῥούφου, ἵνα ἄρῃ τὸν σταυρὸν αὐτοῦ."]},{"type":"verse","number":22,"content":["Καὶ φέρουσιν αὐτὸν ἐπὶ",{"noteId":1190},"Γολγοθᾶ τόπον, ὅ ἐστι",{"noteId":1191},"μεθερμηνευόμενον Κρανίου Τόπος."]},{"type":"verse","number":23,"content":["Καὶ ἐδίδουν αὐτῷ",{"noteId":1192},"πιεῖν ἐσμυρνισμένον οἶνον·",{"noteId":1193},"ὁ δὲ οὐκ ἔλαβε."]},{"type":"verse","number":24,"content":["Καὶ",{"noteId":1194},"σταυρώσαντες αὐτόν,",{"noteId":1195},"διαμερίζονται τὰ ἱμάτια αὐτοῦ, βάλλοντες κλῆρον ἐπ᾽ αὐτά, τίς τί ἄρῃ."]},{"type":"verse","number":25,"content":["Ἦν δὲ ὥρα τρίτη, καὶ ἐσταύρωσαν αὐτόν."]},{"type":"verse","number":26,"content":["Καὶ ἦν ἡ ἐπιγραφὴ τῆς αἰτίας αὐτοῦ ἐπιγεγραμμένη, Ὁ βασιλεὺς τῶν Ἰουδαίων."]},{"type":"verse","number":27,"content":["Καὶ σὺν αὐτῷ σταυροῦσι δύο λῃστάς, ἕνα ἐκ δεξιῶν καὶ ἕνα ἐξ εὐωνύμων αὐτοῦ."]},{"type":"verse","number":28,"content":[{"noteId":1196},"Καὶ ἐπληρώθη ἡ γραφὴ ἡ λέγουσα, Καὶ μετὰ ἀνόμων ἐλογίσθη."]},{"type":"verse","number":29,"content":["Καὶ οἱ παραπορευόμενοι ἐβλασφήμουν αὐτόν,",{"noteId":1197},"κινοῦντες τὰς κεφαλὰς αὐτῶν, καὶ λέγοντες, Οὐά, ὁ καταλύων τὸν ναὸν καὶ",{"noteId":1198},"ἐν τρισὶν ἡμέραις οἰκοδομῶν,"]},{"type":"verse","number":30,"content":["σῶσον σεαυτόν,",{"noteId":1199},"καὶ κατάβα ἀπὸ τοῦ σταυροῦ."]},{"type":"verse","number":31,"content":["Ὁμοίως",{"noteId":1200},"καὶ οἱ ἀρχιερεῖς ἐμπαίζοντες πρὸς ἀλλήλους μετὰ τῶν γραμματέων ἔλεγον, Ἄλλους ἔσωσεν, ἑαυτὸν οὐ δύναται σῶσαι."]},{"type":"verse","number":32,"content":["Ὁ Χριστὸς ὁ βασιλεὺς",{"noteId":1201},"τοῦ Ἰσραὴλ καταβάτω νῦν ἀπὸ τοῦ σταυροῦ, ἵνα ἴδωμεν καὶ πιστεύσωμεν",{"noteId":1202},"αὐτῷ. Καὶ οἱ συνεσταυρωμένοι",{"noteId":1203},"αὐτῷ ὠνείδιζον αὐτόν."]},{"type":"heading","content":["The Death of Jesus"]},{"type":"verse","number":33,"content":[{"noteId":1204},"Γενομένης δὲ ὥρας ἕκτης, σκότος ἐγένετο ἐφ᾽ ὅλην τὴν γῆν ἕως ὥρας",{"noteId":1205},"ἐνάτης."]},{"type":"verse","number":34,"content":["Καὶ τῇ",{"noteId":1206},"ὥρᾳ τῇ ἐνάτῃ ἐβόησεν ὁ Ἰησοῦς φωνῇ μεγάλῃ,",{"noteId":1207},"λέγων,",{"text":"Ἐλωΐ, Ἐλωΐ,","wordsOfJesus":true},{"noteId":1208},{"text":"λιμὰ","wordsOfJesus":true},{"noteId":1209},{"text":"σαβαχθανί;","wordsOfJesus":true},"Ὅ ἐστι μεθερμηνευόμενον,",{"text":"Ὁ Θεός","wordsOfJesus":true},{"noteId":1210},{"text":"μου, ὁ Θεός μου, εἰς τί","wordsOfJesus":true},{"noteId":1211},{"text":"με ἐγκατέλιπες;","wordsOfJesus":true}]},{"type":"verse","number":35,"content":["Καί τινες τῶν παρεστηκότων ἀκούσαντες ἔλεγον,",{"noteId":1212},"Ἰδού,",{"noteId":1213},"Ἠλίαν φωνεῖ."]},{"type":"verse","number":36,"content":["Δραμὼν δὲ",{"noteId":1214},"εἷς,",{"noteId":1215},"καὶ γεμίσας σπόγγον ὄξους, περιθείς",{"noteId":1216},"τε καλάμῳ, ἐπότιζεν αὐτόν, λέγων, Ἄφετε, ἴδωμεν εἰ ἔρχεται",{"noteId":1217},"Ἠλίας καθελεῖν αὐτόν."]},{"type":"verse","number":37,"content":["Ὁ δὲ Ἰησοῦς ἀφεὶς φωνὴν μεγάλην ἐξέπνευσε."]},{"type":"verse","number":38,"content":["Καὶ τὸ καταπέτασμα τοῦ ναοῦ ἐσχίσθη εἰς δύο",{"noteId":1218},"ἀπὸ ἄνωθεν ἕως κάτω."]},{"type":"verse","number":39,"content":["Ἰδὼν δὲ ὁ κεντυρίων ὁ παρεστηκὼς ἐξ ἐναντίας αὐτοῦ ὅτι οὕτω",{"noteId":1219},"κράξας ἐξέπνευσεν, εἶπεν, Ἀληθῶς",{"noteId":1220},"ὁ ἄνθρωπος οὗτος υἱὸς",{"noteId":1221},"ἦν Θεοῦ."]},{"type":"verse","number":40,"content":["Ἦσαν δὲ καὶ γυναῖκες ἀπὸ μακρόθεν θεωροῦσαι, ἐν αἷς",{"noteId":1222},"ἦν",{"noteId":1223},"καὶ",{"noteId":1224},"Μαρία ἡ Μαγδαληνή, καὶ Μαρία ἡ",{"noteId":1225},"τοῦ Ἰακώβου τοῦ μικροῦ καὶ",{"noteId":1226},"Ἰωσῆ μήτηρ, καὶ Σαλώμη,"]},{"type":"verse","number":41,"content":[{"noteId":1227},"αἳ καί, ὅτε ἦν ἐν τῇ Γαλιλαίᾳ, ἠκολούθουν αὐτῷ, καὶ διηκόνουν αὐτῷ, καὶ ἄλλαι πολλαὶ αἱ συναναβᾶσαι αὐτῷ εἰς Ἱεροσόλυμα."]},{"type":"heading","content":["The Burial of Jesus"]},{"type":"verse","number":42,"content":["Καὶ ἤδη ὀψίας γενομένης, ἐπεὶ",{"noteId":1228},"ἦν Παρασκευή, ὅ ἐστι",{"noteId":1229},"προσάββατον,"]},{"type":"verse","number":43,"content":[{"noteId":1230},"ἦλθεν Ἰωσὴφ",{"noteId":1231},"ὁ ἀπὸ Ἀριμαθαίας, εὐσχήμων βουλευτής, ὃς καὶ αὐτὸς ἦν προσδεχόμενος τὴν βασιλείαν τοῦ Θεοῦ· τολμήσας εἰσῆλθε πρὸς",{"noteId":1232},"Πιλάτον, καὶ ᾐτήσατο τὸ σῶμα τοῦ Ἰησοῦ."]},{"type":"verse","number":44,"content":["Ὁ δὲ",{"noteId":1233},"Πιλάτος ἐθαύμασεν εἰ ἤδη τέθνηκε· καὶ προσκαλεσάμενος τὸν κεντυρίωνα, ἐπηρώτησεν αὐτὸν εἰ",{"noteId":1234},"πάλαι ἀπέθανε."]},{"type":"verse","number":45,"content":["Καὶ γνοὺς ἀπὸ τοῦ κεντυρίωνος, ἐδωρήσατο τὸ",{"noteId":1235},"σῶμα τῷ Ἰωσήφ."]},{"type":"verse","number":46,"content":["Καὶ ἀγοράσας σινδόνα,",{"noteId":1236},"καὶ καθελὼν αὐτόν, ἐνείλησε τῇ σινδόνι, καὶ",{"noteId":1237},"κατέθηκεν αὐτὸν ἐν",{"noteId":1238},"μνημείῳ, ὃ ἦν λελατομημένον ἐκ πέτρας· καὶ προσεκύλισε λίθον ἐπὶ τὴν θύραν τοῦ μνημείου."]},{"type":"verse","number":47,"content":["Ἡ δὲ Μαρία ἡ Μαγδαληνὴ καὶ Μαρία",{"noteId":1239},"Ἰωσῆ ἐθεώρουν ποῦ",{"noteId":1240},"τίθεται."]}],"footnotes":[{"noteId":1159,"caller":"+","text":"ευθεως ¦ ευθυς CT","reference":{"chapter":15,"verse":1}},{"noteId":1160,"caller":"+","text":"επι το 80% ¦ επι τω MSS 17.3% ¦ — ECM† NA SBL TH WH 1.1%","reference":{"chapter":15,"verse":1}},{"noteId":1161,"caller":"+","text":"τω ¦ — CT","reference":{"chapter":15,"verse":1}},{"noteId":1162,"caller":"+","text":"πιλατω ¦ πειλατω TH WH","reference":{"chapter":15,"verse":1}},{"noteId":1163,"caller":"+","text":"πιλατος ¦ πειλατος TH WH","reference":{"chapter":15,"verse":2}},{"noteId":1164,"caller":"+","text":"ειπεν 