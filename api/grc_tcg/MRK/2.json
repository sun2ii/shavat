{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"MRK","translationId":"grc_tcg","name":"ΚΑΤΑ ΜΑΡΚΟΝ","commonName":"ΚΑΤΑ ΜΑΡΚΟΝ","title":"ΚΑΤΑ ΜΑΡΚΟΝ","order":41,"numberOfChapters":16,"sha256":"458ddb37b7c88bd21fa977538125daa8129b125491fad25357901af5ebb1abc8","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/MRK/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/grc_tcg/MRK/16.json","totalNumberOfVerses":678},"chapter":{"number":2,"content":[{"type":"heading","content":["Jesus Heals a Paralytic"]},{"type":"verse","number":1,"content":["Καὶ",{"noteId":91},"εἰσῆλθε πάλιν εἰς",{"noteId":92},"Καπερναοὺμ δι᾽ ἡμερῶν·",{"noteId":93},"καὶ ἠκούσθη ὅτι",{"noteId":94},"εἰς οἶκόν ἐστι."]},{"type":"verse","number":2,"content":["Καὶ",{"noteId":95},"εὐθέως συνήχθησαν πολλοί, ὥστε μηκέτι χωρεῖν μηδὲ τὰ πρὸς τὴν θύραν· καὶ ἐλάλει αὐτοῖς τὸν λόγον."]},{"type":"verse","number":3,"content":["Καὶ ἔρχονται",{"noteId":96},"πρὸς αὐτόν, παραλυτικὸν φέροντες, αἰρόμενον ὑπὸ τεσσάρων."]},{"type":"verse","number":4,"content":["Καὶ μὴ δυνάμενοι",{"noteId":97},"προσεγγίσαι αὐτῷ διὰ τὸν ὄχλον, ἀπεστέγασαν τὴν στέγην ὅπου ἦν, καὶ ἐξορύξαντες χαλῶσι τὸν",{"noteId":98},"κράββατον",{"noteId":99},"ἐφ᾽ ᾧ ὁ παραλυτικὸς κατέκειτο."]},{"type":"verse","number":5,"content":[{"noteId":100},"Ἰδὼν δὲ ὁ Ἰησοῦς τὴν πίστιν αὐτῶν λέγει τῷ παραλυτικῷ,",{"text":"Τέκνον,","wordsOfJesus":true},{"noteId":101},{"text":"ἀφέωνταί","wordsOfJesus":true},{"noteId":102},{"text":"σοι αἱ ἁμαρτίαι σου.","wordsOfJesus":true}]},{"type":"verse","number":6,"content":["Ἦσαν δέ τινες τῶν γραμματέων ἐκεῖ καθήμενοι, καὶ διαλογιζόμενοι ἐν ταῖς καρδίαις αὐτῶν,"]},{"type":"verse","number":7,"content":["Τί οὗτος οὕτω λαλεῖ",{"noteId":103},"βλασφημίας; Τίς δύναται ἀφιέναι ἁμαρτίας εἰ μὴ εἷς, ὁ Θεός;"]},{"type":"verse","number":8,"content":["Καὶ",{"noteId":104},"εὐθέως ἐπιγνοὺς ὁ Ἰησοῦς τῷ πνεύματι αὐτοῦ ὅτι οὕτως",{"noteId":105},"αὐτοὶ διαλογίζονται ἐν ἑαυτοῖς,",{"noteId":106},"εἶπεν αὐτοῖς,",{"text":"Τί ταῦτα διαλογίζεσθε ἐν ταῖς καρδίαις ὑμῶν;","wordsOfJesus":true}]},{"type":"verse","number":9,"content":[{"text":"Τί ἐστιν εὐκοπώτερον, εἰπεῖν τῷ παραλυτικῷ,","wordsOfJesus":true},{"noteId":107},{"text":"Ἀφέωνταί","wordsOfJesus":true},{"noteId":108},{"text":"σου αἱ ἁμαρτίαι, ἢ εἰπεῖν,","wordsOfJesus":true},{"noteId":109},{"text":"Ἔγειραι, καὶ ἆρόν","wordsOfJesus":true},{"noteId":110},{"text":"σου τὸν κράββατον, καὶ περιπάτει;","wordsOfJesus":true}]},{"type":"verse","number":10,"content":[{"text":"Ἵνα δὲ εἰδῆτε ὅτι ἐξουσίαν ἔχει ὁ υἱὸς τοῦ ἀνθρώπου","wordsOfJesus":true},{"noteId":111},{"text":"ἀφιέναι ἐπὶ τῆς γῆς ἁμαρτίας","wordsOfJesus":true},"—λέγει τῷ παραλυτικῷ—"]},{"type":"verse","number":11,"content":[{"text":"Σοὶ λέγω,","wordsOfJesus":true},{"noteId":112},{"text":"ἔγειραι","wordsOfJesus":true},{"noteId":113},{"text":"καὶ ἆρον τὸν","wordsOfJesus":true},{"noteId":114},{"text":"κράββατόν σου, καὶ ὕπαγε εἰς τὸν οἶκόν σου.","wordsOfJesus":true}]},{"type":"verse","number":12,"content":["Καὶ ἠγέρθη",{"noteId":115},"εὐθέως, καὶ ἄρας τὸν",{"noteId":116},"κράββατον, ἐξῆλθεν",{"noteId":117},"ἐναντίον πάντων· ὥστε ἐξίστασθαι πάντας, καὶ δοξάζειν τὸν Θεόν, λέγοντας ὅτι",{"noteId":118},"Οὐδέποτε οὕτως",{"noteId":119},"εἴδομεν."]},{"type":"heading","content":["Jesus Calls Levi"]},{"type":"verse","number":13,"content":["Καὶ ἐξῆλθε πάλιν παρὰ τὴν θάλασσαν· καὶ πᾶς ὁ ὄχλος ἤρχετο πρὸς αὐτόν, καὶ ἐδίδασκεν αὐτούς."]},{"type":"verse","number":14,"content":["Καὶ παράγων εἶδε",{"noteId":120},"Λευῒ τὸν τοῦ Ἀλφαίου καθήμενον ἐπὶ τὸ τελώνιον, καὶ λέγει αὐτῷ,",{"text":"Ἀκολούθει μοι.","wordsOfJesus":true},"Καὶ ἀναστὰς ἠκολούθησεν αὐτῷ."]},{"type":"verse","number":15,"content":["Καὶ",{"noteId":121},"ἐγένετο ἐν τῷ κατακεῖσθαι αὐτὸν ἐν τῇ οἰκίᾳ αὐτοῦ, καὶ πολλοὶ τελῶναι καὶ ἁμαρτωλοὶ συνανέκειντο τῷ Ἰησοῦ καὶ τοῖς μαθηταῖς αὐτοῦ· ἦσαν γὰρ πολλοί, καὶ",{"noteId":122},"ἠκολούθησαν αὐτῷ."]},{"type":"verse","number":16,"content":["Καὶ οἱ γραμματεῖς",{"noteId":123},"καὶ οἱ Φαρισαῖοι, ἰδόντες",{"noteId":124},"αὐτὸν ἐσθίοντα μετὰ τῶν",{"noteId":125},"τελωνῶν καὶ ἁμαρτωλῶν, ἔλεγον τοῖς μαθηταῖς αὐτοῦ,",{"noteId":126},"Τί ὅτι μετὰ τῶν τελωνῶν καὶ ἁμαρτωλῶν ἐσθίει",{"noteId":127},"καὶ πίνει;"]},{"type":"verse","number":17,"content":["Καὶ ἀκούσας ὁ Ἰησοῦς λέγει",{"noteId":128},"αὐτοῖς,",{"text":"Οὐ χρείαν ἔχουσιν οἱ ἰσχύοντες ἰατροῦ, ἀλλ᾽ οἱ κακῶς ἔχοντες. Οὐκ ἦλθον καλέσαι δικαίους,","wordsOfJesus":true},{"noteId":129},{"text":"ἀλλὰ ἁμαρτωλοὺς","wordsOfJesus":true},{"noteId":130},{"text":"εἰς μετάνοιαν.","wordsOfJesus":true}]},{"type":"heading","content":["A Question About Fasting"]},{"type":"verse","number":18,"content":["Καὶ ἦσαν οἱ μαθηταὶ",{"noteId":131},"Ἰωάννου καὶ οἱ",{"noteId":132},"τῶν Φαρισαίων νηστεύοντες· καὶ ἔρχονται καὶ λέγουσιν αὐτῷ, Διὰ τί οἱ μαθηταὶ",{"noteId":133},"Ἰωάννου καὶ",{"noteId":134},"οἱ τῶν Φαρισαίων νηστεύουσιν, οἱ δὲ σοὶ μαθηταὶ οὐ νηστεύουσι;"]},{"type":"verse","number":19,"content":["Καὶ εἶπεν αὐτοῖς ὁ Ἰησοῦς,",{"text":"Μὴ δύνανται οἱ υἱοὶ τοῦ νυμφῶνος, ἐν ᾧ ὁ νυμφίος μετ᾽ αὐτῶν ἐστι, νηστεύειν; Ὅσον χρόνον","wordsOfJesus":true},{"noteId":135},{"text":"μεθ᾽ ἑαυτῶν ἔχουσι τὸν νυμφίον, οὐ δύνανται νηστεύειν·","wordsOfJesus":true}]},{"type":"verse","number":20,"content":[{"text":"ἐλεύσονται δὲ ἡμέραι ὅταν ἀπαρθῇ ἀπ᾽ αὐτῶν ὁ νυμφίος, καὶ τότε νηστεύσουσιν ἐν","wordsOfJesus":true},{"noteId":136},{"text":"ἐκείναις ταῖς ἡμέραις.","wordsOfJesus":true}]},{"type":"verse","number":21,"content":[{"noteId":137},{"text":"Καὶ οὐδεὶς ἐπίβλημα ῥάκους ἀγνάφου","wordsOfJesus":true},{"noteId":138},{"text":"ἐπιρράπτει ἐπὶ","wordsOfJesus":true},{"noteId":139},{"text":"ἱματίῳ παλαιῷ· εἰ δὲ","wordsOfJesus":true},{"noteId":140},{"text":"μή, αἴρει τὸ πλήρωμα","wordsOfJesus":true},{"noteId":141},{"text":"αὐτοῦ τὸ καινὸν τοῦ παλαιοῦ, καὶ χεῖρον σχίσμα","wordsOfJesus":true},{"noteId":142},{"text":"γίνεται.","wordsOfJesus":true}]},{"type":"verse","number":22,"content":[{"text":"Καὶ οὐδεὶς βάλλει οἶνον νέον εἰς ἀσκοὺς παλαιούς· εἰ δὲ μή,","wordsOfJesus":true},{"noteId":143},{"text":"ῥήσσει ὁ οἶνος","wordsOfJesus":true},{"noteId":144},{"text":"ὁ νέος τοὺς ἀσκούς, καὶ ὁ οἶνος","wordsOfJesus":true},{"noteId":145},{"text":"ἐκχεῖται καὶ οἱ ἀσκοὶ ἀπολοῦνται·","wordsOfJesus":true},{"noteId":146},{"text":"ἀλλὰ οἶνον νέον εἰς ἀσκοὺς καινοὺς","wordsOfJesus":true},{"noteId":147},{"text":"βλητέον.","wordsOfJesus":true}]},{"type":"heading","content":["Jesus Is Lord of the Sabbath"]},{"type":"verse","number":23,"content":["Καὶ ἐγένετο",{"noteId":148},"παραπορεύεσθαι αὐτὸν ἐν τοῖς σάββασι διὰ τῶν σπορίμων, καὶ",{"noteId":149},"ἤρξαντο οἱ μαθηταὶ αὐτοῦ ὁδὸν ποιεῖν τίλλοντες τοὺς στάχυας."]},{"type":"verse","number":24,"content":["Καὶ οἱ Φαρισαῖοι ἔλεγον αὐτῷ, Ἴδε, τί ποιοῦσιν",{"noteId":150},"ἐν τοῖς σάββασιν ὃ οὐκ ἔξεστι;"]},{"type":"verse","number":25,"content":["Καὶ",{"noteId":151},"αὐτὸς ἔλεγεν αὐτοῖς,",{"text":"Οὐδέποτε ἀνέγνωτε τί ἐποίησε","wordsOfJesus":true},{"noteId":152},{"text":"Δαυίδ, ὅτε χρείαν ἔσχε καὶ ἐπείνασεν αὐτὸς καὶ οἱ μετ᾽ αὐτοῦ;","wordsOfJesus":true}]},{"type":"verse","number":26,"content":[{"text":"Πῶς εἰσῆλθεν εἰς τὸν οἶκον τοῦ Θεοῦ ἐπὶ Ἀβιάθαρ","wordsOfJesus":true},{"noteId":153},{"text":"ἀρχιερέως, καὶ τοὺς ἄρτους τῆς προθέσεως ἔφαγεν, οὓς οὐκ ἔξεστι φαγεῖν εἰ μὴ","wordsOfJesus":true},{"noteId":154},{"text":"τοῖς ἱερεῦσι, καὶ ἔδωκε καὶ τοῖς σὺν αὐτῷ οὖσι;","wordsOfJesus":true}]},{"type":"verse","number":27,"content":["Καὶ ἔλεγεν αὐτοῖς,",{"text":"Τὸ σάββατον διὰ τὸν ἄνθρωπον ἐγένετο,","wordsOfJesus":true},{"noteId":155},{"text":"οὐχ ὁ ἄνθρωπος διὰ τὸ σάββατον·","wordsOfJesus":true}]},{"type":"verse","number":28,"content":[{"text":"ὥστε Κύριός ἐστιν ὁ υἱὸς τοῦ ἀνθρώπου καὶ τοῦ σαββάτου.","wordsOfJesus":true}]}],"footnotes":[{"noteId":91,"caller":"+","text":"εισηλθε παλιν ¦ παλιν εισηλθεν TR ¦ εισελθων παλιν CT","reference":{"chapter":2,"verse":1}},{"noteId":92,"caller":"+","text":"καπερναουμ ¦ καφαρναουμ CT","reference":{"chapter":2,"verse":1}},{"noteId":93,"caller":"+","text":"και ¦ — CT","reference":{"chapter":2,"verse":1}},{"noteId":94,"caller":"+","text":"εις οικον 98.5% ¦ εν οικω CT 1%","reference":{"chapter":2,"verse":1}},{"noteId":95,"caller":"+","text":"ευθεως ¦ — CT","reference":{"chapter":2,"verse":2}},{"noteId":96,"caller":"+","text":"προς αυτον παραλυτικον φεροντες ¦ φεροντες προς αυτον παραλυτικον ECM† NA SBL WH","reference":{"chapter":2,"verse":3}},{"noteId":97,"caller":"+","text":"προσεγγισαι ¦ προσενεγκαι CT","reference":{"chapter":2,"verse":4}},{"noteId":98,"caller":"+","text":"κραββατον ¦ κραβαττον 𝔐pt ANT CT","reference":{"chapter":2,"verse":4}},{"noteId":99,"caller":"+","text":"εφ ω ¦ οπου ECM† NA SBL TH WH","reference":{"chapter":2,"verse":4}},{"noteId":100,"caller":"+","text":"ιδων δε ¦ και ιδων CT","reference":{"chapter":2,"verse":5}},{"noteId":101,"caller":"+","text":"αφεωνται ¦ αφιενται ECM NA SBL WH","reference":{"chapter":2,"verse":5}},{"noteId":102,"caller":"+","text":"σοι αι αμαρτιαι σου ¦ σου αι αμαρτιαι CT","reference":{"chapter":2,"verse":5}},{"noteId":103,"caller":"+","text":"βλασφημιας ¦ βλασφημει CT","reference":{"chapter":2,"verse":7}},{"noteId":104,"caller":"+","text":"ευθεως ¦ ευθυς CT","reference":{"chapter":2,"verse":8}},{"noteId":105,"caller":"+","text":"αυτοι ¦ — CT TR","reference":{"chapter":2,"verse":8}},{"noteId":106,"caller":"+","text":"ειπεν ¦ λεγει CT","reference":{"chapter":2,"verse":8}},{"noteId":107,"caller":"+","text":"αφεωνται ¦ αφιενται ECM NA SBL WH","reference":{"chapter":2,"verse":9