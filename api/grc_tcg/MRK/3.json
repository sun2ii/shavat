{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"MRK","translationId":"grc_tcg","name":"ΚΑΤΑ ΜΑΡΚΟΝ","commonName":"ΚΑΤΑ ΜΑΡΚΟΝ","title":"ΚΑΤΑ ΜΑΡΚΟΝ","order":41,"numberOfChapters":16,"sha256":"458ddb37b7c88bd21fa977538125daa8129b125491fad25357901af5ebb1abc8","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/MRK/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/grc_tcg/MRK/16.json","totalNumberOfVerses":678},"chapter":{"number":3,"content":[{"type":"heading","content":["Jesus Heals a Man with a Withered Hand"]},{"type":"verse","number":1,"content":["Καὶ εἰσῆλθε πάλιν εἰς",{"noteId":156},"τὴν συναγωγήν, καὶ ἦν ἐκεῖ ἄνθρωπος ἐξηραμμένην ἔχων τὴν χεῖρα."]},{"type":"verse","number":2,"content":["Καὶ παρετήρουν αὐτὸν εἰ τοῖς σάββασι θεραπεύσει αὐτόν, ἵνα κατηγορήσωσιν αὐτοῦ."]},{"type":"verse","number":3,"content":["Καὶ λέγει τῷ ἀνθρώπῳ τῷ",{"noteId":157},"ἐξηραμμένην ἔχοντι τὴν χεῖρα,",{"noteId":158},{"text":"Ἔγειραι εἰς τὸ μέσον.","wordsOfJesus":true}]},{"type":"verse","number":4,"content":["Καὶ λέγει αὐτοῖς,",{"text":"Ἔξεστι τοῖς σάββασιν","wordsOfJesus":true},{"noteId":159},{"text":"ἀγαθοποιῆσαι ἢ κακοποιῆσαι; Ψυχὴν σῶσαι ἢ ἀποκτεῖναι;","wordsOfJesus":true},"Οἱ δὲ ἐσιώπων."]},{"type":"verse","number":5,"content":["Καὶ περιβλεψάμενος αὐτοὺς μετ᾽ ὀργῆς,",{"noteId":160},"συλλυπούμενος ἐπὶ τῇ πωρώσει τῆς καρδίας αὐτῶν, λέγει τῷ ἀνθρώπῳ,",{"text":"Ἔκτεινον τὴν χεῖρά","wordsOfJesus":true},{"noteId":161},{"text":"σου.","wordsOfJesus":true},"Καὶ ἐξέτεινε, καὶ",{"noteId":162},"ἀποκατεστάθη ἡ χεὶρ αὐτοῦ",{"noteId":163},"ὑγιὴς ὡς ἡ ἄλλη."]},{"type":"verse","number":6,"content":["Καὶ ἐξελθόντες οἱ Φαρισαῖοι",{"noteId":164},"εὐθέως μετὰ τῶν Ἡρῳδιανῶν συμβούλιον",{"noteId":165},"ἐποίουν κατ᾽ αὐτοῦ, ὅπως αὐτὸν ἀπολέσωσι."]},{"type":"heading","content":["A Great Multitude Follows Jesus"]},{"type":"verse","number":7,"content":["Καὶ ὁ Ἰησοῦς",{"noteId":166},"ἀνεχώρησε μετὰ τῶν μαθητῶν αὐτοῦ πρὸς τὴν θάλασσαν· καὶ πολὺ πλῆθος ἀπὸ τῆς Γαλιλαίας",{"noteId":167},"ἠκολούθησαν αὐτῷ, καὶ ἀπὸ τῆς Ἰουδαίας,"]},{"type":"verse","number":8,"content":["καὶ ἀπὸ Ἱεροσολύμων, καὶ ἀπὸ τῆς Ἰδουμαίας, καὶ πέραν τοῦ Ἰορδάνου, καὶ",{"noteId":168},"οἱ περὶ Τύρον καὶ Σιδῶνα, πλῆθος πολύ,",{"noteId":169},"ἀκούσαντες ὅσα",{"noteId":170},"ἐποίει,",{"noteId":171},"ἦλθον πρὸς αὐτόν."]},{"type":"verse","number":9,"content":["Καὶ εἶπε τοῖς μαθηταῖς αὐτοῦ ἵνα πλοιάριον προσκαρτερῇ αὐτῷ διὰ τὸν ὄχλον, ἵνα μὴ θλίβωσιν αὐτόν."]},{"type":"verse","number":10,"content":["Πολλοὺς γὰρ ἐθεράπευσεν, ὥστε ἐπιπίπτειν αὐτῷ, ἵνα αὐτοῦ ἅψωνται, ὅσοι εἶχον μάστιγας."]},{"type":"verse","number":11,"content":["Καὶ τὰ πνεύματα τὰ ἀκάθαρτα, ὅταν αὐτὸν",{"noteId":172},"ἐθεώρει, προσέπιπτεν αὐτῷ, καὶ ἔκραζε,",{"noteId":173},"λέγοντα ὅτι Σὺ εἶ ὁ υἱὸς τοῦ Θεοῦ."]},{"type":"verse","number":12,"content":["Καὶ πολλὰ ἐπετίμα αὐτοῖς ἵνα μὴ",{"noteId":174},"φανερὸν αὐτὸν ποιήσωσι."]},{"type":"heading","content":["The Twelve Apostles"]},{"type":"verse","number":13,"content":["Καὶ ἀναβαίνει εἰς τὸ ὄρος, καὶ προσκαλεῖται οὓς ἤθελεν αὐτός· καὶ ἀπῆλθον πρὸς αὐτόν."]},{"type":"verse","number":14,"content":["Καὶ ἐποίησε",{"noteId":175},"δώδεκα, ἵνα ὦσι μετ᾽ αὐτοῦ, καὶ ἵνα ἀποστέλλῃ αὐτοὺς κηρύσσειν,"]},{"type":"verse","number":15,"content":["καὶ ἔχειν ἐξουσίαν",{"noteId":176},"θεραπεύειν τὰς νόσους, καὶ ἐκβάλλειν τὰ δαιμόνια·"]},{"type":"verse","number":16,"content":[{"noteId":177},"καὶ ἐπέθηκε",{"noteId":178},"τῷ Σίμωνι ὄνομα Πέτρον·"]},{"type":"verse","number":17,"content":["καὶ Ἰάκωβον τὸν τοῦ Ζεβεδαίου, καὶ",{"noteId":179},"Ἰωάννην τὸν ἀδελφὸν τοῦ Ἰακώβου· καὶ ἐπέθηκεν αὐτοῖς",{"noteId":180},"ὀνόματα",{"noteId":181},"Βοανεργές, ὅ ἐστιν, Υἱοὶ Βροντῆς·"]},{"type":"verse","number":18,"content":["καὶ Ἀνδρέαν, καὶ Φίλιππον, καὶ Βαρθολομαῖον, καὶ",{"noteId":182},"Ματθαῖον, καὶ Θωμᾶν, καὶ Ἰάκωβον τὸν τοῦ Ἀλφαίου, καὶ Θαδδαῖον, καὶ Σίμωνα τὸν",{"noteId":183},"Κανανίτην,"]},{"type":"verse","number":19,"content":["καὶ Ἰούδαν",{"noteId":184},"Ἰσκαριώτην, ὃς καὶ παρέδωκεν αὐτόν. Jesus and Beelzebul Καὶ",{"noteId":185},"ἔρχονται εἰς οἶκον·"]},{"type":"verse","number":20,"content":["καὶ συνέρχεται πάλιν",{"noteId":186},"ὄχλος, ὥστε μὴ δύνασθαι αὐτοὺς",{"noteId":187},"μήτε ἄρτον φαγεῖν."]},{"type":"verse","number":21,"content":["Καὶ ἀκούσαντες οἱ παρ᾽ αὐτοῦ ἐξῆλθον κρατῆσαι αὐτόν· ἔλεγον γὰρ ὅτι Ἐξέστη."]},{"type":"verse","number":22,"content":["Καὶ οἱ γραμματεῖς οἱ ἀπὸ Ἱεροσολύμων καταβάντες ἔλεγον ὅτι",{"noteId":188},"Βεελζεβοὺλ ἔχει, καὶ ὅτι Ἐν τῷ ἄρχοντι τῶν δαιμονίων ἐκβάλλει τὰ δαιμόνια."]},{"type":"verse","number":23,"content":["Καὶ προσκαλεσάμενος αὐτούς, ἐν παραβολαῖς ἔλεγεν αὐτοῖς,",{"text":"Πῶς δύναται Σατανᾶς Σατανᾶν ἐκβάλλειν;","wordsOfJesus":true}]},{"type":"verse","number":24,"content":[{"text":"Καὶ ἐὰν βασιλεία ἐφ᾽ ἑαυτὴν μερισθῇ, οὐ δύναται σταθῆναι ἡ βασιλεία ἐκείνη.","wordsOfJesus":true}]},{"type":"verse","number":25,"content":[{"text":"Καὶ ἐὰν οἰκία ἐφ᾽ ἑαυτὴν μερισθῇ, οὐ","wordsOfJesus":true},{"noteId":189},{"text":"δύναται","wordsOfJesus":true},{"noteId":190},{"text":"σταθῆναι ἡ οἰκία ἐκείνη.","wordsOfJesus":true}]},{"type":"verse","number":26,"content":[{"text":"Καὶ εἰ ὁ Σατανᾶς ἀνέστη ἐφ᾽ ἑαυτὸν καὶ","wordsOfJesus":true},{"noteId":191},{"text":"μεμέρισται, οὐ δύναται","wordsOfJesus":true},{"noteId":192},{"text":"σταθῆναι, ἀλλὰ τέλος ἔχει.","wordsOfJesus":true}]},{"type":"verse","number":27,"content":[{"noteId":193},{"text":"Οὐδεὶς δύναται","wordsOfJesus":true},{"noteId":194},{"text":"τὰ σκεύη τοῦ ἰσχυροῦ, εἰσελθὼν εἰς τὴν οἰκίαν αὐτοῦ, διαρπάσαι, ἐὰν μὴ πρῶτον τὸν ἰσχυρὸν δήσῃ, καὶ τότε τὴν οἰκίαν αὐτοῦ","wordsOfJesus":true},{"noteId":195},{"text":"διαρπάσῃ.","wordsOfJesus":true}]},{"type":"verse","number":28,"content":[{"text":"Ἀμὴν λέγω ὑμῖν ὅτι πάντα ἀφεθήσεται","wordsOfJesus":true},{"noteId":196},{"text":"τὰ ἁμαρτήματα τοῖς υἱοῖς τῶν ἀνθρώπων, καὶ","wordsOfJesus":true},{"noteId":197},{"text":"βλασφημίαι ὅσας ἂν βλασφημήσωσιν·","wordsOfJesus":true}]},{"type":"verse","number":29,"content":[{"text":"ὃς δ᾽ ἂν βλασφημήσῃ εἰς τὸ Πνεῦμα τὸ Ἅγιον, οὐκ ἔχει ἄφεσιν εἰς τὸν αἰῶνα,","wordsOfJesus":true},{"noteId":198},{"text":"ἀλλ᾽ ἔνοχός ἐστιν αἰωνίου","wordsOfJesus":true},{"noteId":199},{"text":"κρίσεως.","wordsOfJesus":true}]},{"type":"verse","number":30,"content":["Ὅτι ἔλεγον, Πνεῦμα ἀκάθαρτον ἔχει."]},{"type":"heading","content":["Jesus' Mother and Brothers"]},{"type":"verse","number":31,"content":[{"noteId":200},"Ἔρχονται οὖν",{"noteId":201},"οἱ ἀδελφοὶ καὶ ἡ μήτηρ αὐτοῦ, καὶ ἔξω",{"noteId":202},"ἑστῶτες ἀπέστειλαν πρὸς αὐτόν,",{"noteId":203},"φωνοῦντες αὐτόν."]},{"type":"verse","number":32,"content":["Καὶ ἐκάθητο",{"noteId":204},"ὄχλος περὶ αὐτόν·",{"noteId":205},"εἶπον δὲ αὐτῷ, Ἰδού, ἡ μήτηρ σου καὶ οἱ ἀδελφοί σου",{"noteId":206},"καὶ αἱ ἀδελφαί σου ἔξω ζητοῦσί σε."]},{"type":"verse","number":33,"content":["Καὶ",{"noteId":207},"ἀπεκρίθη αὐτοῖς λέγων,",{"text":"Τίς ἐστιν ἡ μήτηρ μου","wordsOfJesus":true},{"noteId":208},{"text":"ἢ οἱ ἀδελφοί","wordsOfJesus":true},{"noteId":209},{"text":"μου;","wordsOfJesus":true}]},{"type":"verse","number":34,"content":["Καὶ περιβλεψάμενος",{"noteId":210},"κύκλῳ τοὺς περὶ αὐτὸν καθημένους, λέγει,",{"noteId":211},{"text":"Ἴδε, ἡ μήτηρ μου καὶ οἱ ἀδελφοί μου.","wordsOfJesus":true}]},{"type":"verse","number":35,"content":[{"text":"Ὃς","wordsOfJesus":true},{"noteId":212},{"text":"γὰρ ἂν ποιήσῃ τὸ θέλημα τοῦ Θεοῦ, οὗτος ἀδελφός μου καὶ ἀδελφή","wordsOfJesus":true},{"noteId":213},{"text":"μου καὶ","wordsOfJesus":true},{"not