{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"MRK","translationId":"grc_tcg","name":"ΚΑΤΑ ΜΑΡΚΟΝ","commonName":"ΚΑΤΑ ΜΑΡΚΟΝ","title":"ΚΑΤΑ ΜΑΡΚΟΝ","order":41,"numberOfChapters":16,"sha256":"458ddb37b7c88bd21fa977538125daa8129b125491fad25357901af5ebb1abc8","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/MRK/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/grc_tcg/MRK/16.json","totalNumberOfVerses":678},"chapter":{"number":4,"content":[{"type":"heading","content":["The Parable of the Sower"]},{"type":"verse","number":1,"content":["Καὶ πάλιν ἤρξατο διδάσκειν παρὰ τὴν θάλασσαν. Καὶ",{"noteId":215},"συνήχθη πρὸς αὐτὸν ὄχλος",{"noteId":216},"πολύς, ὥστε αὐτὸν",{"noteId":217},"ἐμβάντα εἰς τὸ πλοῖον καθῆσθαι ἐν τῇ θαλάσσῃ· καὶ πᾶς ὁ ὄχλος πρὸς τὴν θάλασσαν ἐπὶ τῆς γῆς",{"noteId":218},"ἦν."]},{"type":"verse","number":2,"content":["Καὶ ἐδίδασκεν αὐτοὺς ἐν παραβολαῖς πολλά, καὶ ἔλεγεν αὐτοῖς ἐν τῇ διδαχῇ αὐτοῦ,"]},{"type":"verse","number":3,"content":[{"text":"Ἀκούετε· ἰδού, ἐξῆλθεν ὁ σπείρων","wordsOfJesus":true},{"noteId":219},{"text":"τοῦ σπεῖραι.","wordsOfJesus":true}]},{"type":"verse","number":4,"content":[{"text":"Καὶ ἐγένετο ἐν τῷ σπείρειν, ὃ μὲν ἔπεσε","wordsOfJesus":true},{"noteId":220},{"text":"παρὰ τὴν ὁδόν, καὶ","wordsOfJesus":true},{"noteId":221},{"text":"ἦλθε τὰ","wordsOfJesus":true},{"noteId":222},{"text":"πετεινὰ καὶ κατέφαγεν αὐτό.","wordsOfJesus":true}]},{"type":"verse","number":5,"content":[{"noteId":223},{"text":"Ἄλλο δὲ ἔπεσεν ἐπὶ τὸ πετρῶδες,","wordsOfJesus":true},{"noteId":224},{"text":"ὅπου οὐκ εἶχε γῆν πολλήν· καὶ","wordsOfJesus":true},{"noteId":225},{"text":"εὐθέως ἐξανέτειλε, διὰ τὸ μὴ ἔχειν βάθος γῆς·","wordsOfJesus":true}]},{"type":"verse","number":6,"content":[{"noteId":226},{"text":"ἡλίου δὲ ἀνατείλαντος ἐκαυματίσθη, καὶ διὰ τὸ μὴ ἔχειν ῥίζαν ἐξηράνθη.","wordsOfJesus":true}]},{"type":"verse","number":7,"content":[{"text":"Καὶ ἄλλο ἔπεσεν εἰς τὰς ἀκάνθας, καὶ ἀνέβησαν αἱ ἄκανθαι, καὶ συνέπνιξαν αὐτό, καὶ καρπὸν οὐκ ἔδωκε.","wordsOfJesus":true}]},{"type":"verse","number":8,"content":[{"text":"Καὶ","wordsOfJesus":true},{"noteId":227},{"text":"ἄλλο ἔπεσεν εἰς τὴν γῆν τὴν καλήν· καὶ ἐδίδου καρπὸν ἀναβαίνοντα καὶ","wordsOfJesus":true},{"noteId":228},{"text":"αὐξάνοντα, καὶ ἔφερεν","wordsOfJesus":true},{"noteId":229},{"text":"ἐν τριάκοντα, καὶ ἐν ἑξήκοντα, καὶ ἐν ἑκατόν.","wordsOfJesus":true}]},{"type":"verse","number":9,"content":["Καὶ",{"noteId":230},"ἔλεγεν,",{"noteId":231},{"text":"Ὁ ἔχων ὦτα ἀκούειν ἀκουέτω.","wordsOfJesus":true}]},{"type":"heading","content":["The Purpose of Speaking in Parables"]},{"type":"verse","number":10,"content":[{"noteId":232},"Ὅτε δὲ ἐγένετο καταμόνας,",{"noteId":233},"ἠρώτησαν αὐτὸν οἱ περὶ αὐτὸν σὺν τοῖς δώδεκα",{"noteId":234},"τὴν παραβολήν."]},{"type":"verse","number":11,"content":["Καὶ ἔλεγεν αὐτοῖς,",{"text":"Ὑμῖν","wordsOfJesus":true},{"noteId":235},{"text":"δέδοται γνῶναι τὸ μυστήριον τῆς βασιλείας τοῦ Θεοῦ· ἐκείνοις δὲ τοῖς ἔξω, ἐν παραβολαῖς τὰ πάντα","wordsOfJesus":true},{"noteId":236},{"text":"γίνεται·","wordsOfJesus":true}]},{"type":"verse","number":12,"content":[{"text":"ἵνα","wordsOfJesus":true},{"lineBreak":true},{"text":"βλέποντες βλέπωσι, καὶ μὴ ἴδωσι·","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"καὶ ἀκούοντες ἀκούωσι, καὶ μὴ συνιῶσι·","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"μήποτε ἐπιστρέψωσι, καὶ ἀφεθῇ αὐτοῖς","wordsOfJesus":true,"poem":1},{"noteId":237},{"text":"τὰ ἁμαρτήματα.","wordsOfJesus":true,"poem":1}]},{"type":"heading","content":["The Parable of the Sower Explained"]},{"type":"verse","number":13,"content":["Καὶ λέγει αὐτοῖς,",{"text":"Οὐκ οἴδατε τὴν παραβολὴν ταύτην; Καὶ πῶς πάσας τὰς παραβολὰς γνώσεσθε;","wordsOfJesus":true}]},{"type":"verse","number":14,"content":[{"text":"Ὁ σπείρων τὸν λόγον σπείρει.","wordsOfJesus":true}]},{"type":"verse","number":15,"content":[{"text":"Οὗτοι δέ εἰσιν οἱ παρὰ τὴν ὁδόν, ὅπου σπείρεται ὁ λόγος, καὶ ὅταν ἀκούσωσιν,","wordsOfJesus":true},{"noteId":238},{"text":"εὐθέως ἔρχεται ὁ Σατανᾶς καὶ αἴρει τὸν λόγον τὸν ἐσπαρμένον","wordsOfJesus":true},{"noteId":239},{"text":"ἐν ταῖς καρδίαις αὐτῶν.","wordsOfJesus":true}]},{"type":"verse","number":16,"content":[{"text":"Καὶ οὗτοί","wordsOfJesus":true},{"noteId":240},{"text":"εἰσιν ὁμοίως οἱ ἐπὶ τὰ πετρώδη σπειρόμενοι, οἵ, ὅταν ἀκούσωσι τὸν λόγον,","wordsOfJesus":true},{"noteId":241},{"text":"εὐθέως μετὰ χαρᾶς λαμβάνουσιν αὐτόν,","wordsOfJesus":true}]},{"type":"verse","number":17,"content":[{"text":"καὶ οὐκ ἔχουσι ῥίζαν ἐν ἑαυτοῖς, ἀλλὰ πρόσκαιροί εἰσιν· εἶτα γενομένης θλίψεως ἢ διωγμοῦ διὰ τὸν λόγον,","wordsOfJesus":true},{"noteId":242},{"text":"εὐθέως σκανδαλίζονται.","wordsOfJesus":true}]},{"type":"verse","number":18,"content":[{"text":"Καὶ","wordsOfJesus":true},{"noteId":243},{"text":"οὗτοί εἰσιν οἱ εἰς τὰς ἀκάνθας σπειρόμενοι,","wordsOfJesus":true},{"noteId":244},{"text":"οἱ τὸν λόγον","wordsOfJesus":true},{"noteId":245},{"text":"ἀκούοντες,","wordsOfJesus":true}]},{"type":"verse","number":19,"content":[{"text":"καὶ αἱ μέριμναι τοῦ αἰῶνος","wordsOfJesus":true},{"noteId":246},{"text":"τούτου, καὶ ἡ ἀπάτη τοῦ πλούτου, καὶ αἱ περὶ τὰ λοιπὰ ἐπιθυμίαι εἰσπορευόμεναι","wordsOfJesus":true},{"noteId":247},{"text":"συμπνίγουσι τὸν λόγον, καὶ ἄκαρπος","wordsOfJesus":true},{"noteId":248},{"text":"γίνεται.","wordsOfJesus":true}]},{"type":"verse","number":20,"content":[{"text":"Καὶ","wordsOfJesus":true},{"noteId":249},{"text":"οὗτοί εἰσιν οἱ ἐπὶ τὴν γῆν τὴν καλὴν σπαρέντες, οἵτινες ἀκούουσι τὸν λόγον, καὶ παραδέχονται, καὶ καρποφοροῦσιν,","wordsOfJesus":true},{"noteId":250},{"text":"ἐν τριάκοντα, καὶ ἐν ἑξήκοντα, καὶ ἐν ἑκατόν.","wordsOfJesus":true}]},{"type":"heading","content":["A Lamp Under a Basket"]},{"type":"verse","number":21,"content":["Καὶ ἔλεγεν αὐτοῖς,",{"noteId":251},{"text":"Μήτι","wordsOfJesus":true},{"noteId":252},{"text":"ὁ λύχνος ἔρχεται ἵνα ὑπὸ τὸν μόδιον τεθῇ ἢ ὑπὸ τὴν","wordsOfJesus":true},{"noteId":253},{"text":"κλίνην; Οὐχ ἵνα ἐπὶ τὴν λυχνίαν","wordsOfJesus":true},{"noteId":254},{"text":"ἐπιτεθῇ;","wordsOfJesus":true}]},{"type":"verse","number":22,"content":[{"text":"Οὐ γάρ ἐστί","wordsOfJesus":true},{"noteId":255},{"text":"τι κρυπτόν,","wordsOfJesus":true},{"noteId":256},{"text":"ὃ","wordsOfJesus":true},{"noteId":257},{"text":"ἐὰν","wordsOfJesus":true},{"noteId":258},{"text":"μὴ φανερωθῇ· οὐδὲ ἐγένετο ἀπόκρυφον, ἀλλ᾽ ἵνα","wordsOfJesus":true},{"noteId":259},{"text":"εἰς φανερὸν ἔλθῃ.","wordsOfJesus":true}]},{"type":"verse","number":23,"content":[{"text":"Εἴ τις ἔχει ὦτα ἀκούειν ἀκουέτω.","wordsOfJesus":true}]},{"type":"verse","number":24,"content":["Καὶ ἔλεγεν αὐτοῖς,",{"text":"Βλέπετε τί ἀκούετε. Ἐν ᾧ μέτρῳ μετρεῖτε","wordsOfJesus":true},{"noteId":260},{"text":"μετρηθήσεται ὑμῖν,","wordsOfJesus":true},{"noteId":261},{"text":"καὶ προστεθήσεται ὑμῖν τοῖς ἀκούουσιν.","wordsOfJesus":true}]},{"type":"verse","number":25,"content":[{"text":"Ὃς γὰρ","wordsOfJesus":true},{"noteId":262},{"text":"ἂν ἔχῃ, δοθήσεται αὐτῷ· καὶ ὃς οὐκ ἔχει, καὶ ὃ ἔχει ἀρθήσεται ἀπ᾽ αὐτοῦ.","wordsOfJesus":true}]},{"type":"heading","content":["The Parable of the Growing Seed"]},{"type":"verse","number":26,"content":["Καὶ ἔλεγεν,",{"text":"Οὕτως ἐστὶν ἡ βασιλεία τοῦ Θεοῦ, ὡς","wordsOfJesus":true},{"noteId":263},{"text":"ἐὰν ἄνθρωπος βάλῃ τὸν σπόρον ἐπὶ τῆς γῆς,","wordsOfJesus":true}]},{"type":"verse","number":27,"content":[{"text":"καὶ καθεύδῃ καὶ ἐγείρηται νύκτα καὶ ἡμέραν, καὶ ὁ σπόρος","wordsOfJesus":true},{"noteId":264},{"text":"βλαστάνῃ καὶ μηκύνηται ὡς οὐκ οἶδεν αὐτός.","wordsOfJesus":true}]},{"type":"verse","number":28,"content":[{"text":"Αὐτομάτη","wordsOfJesus":true},{"noteId":265},{"text":"γὰρ ἡ γῆ καρποφορεῖ, πρῶτον χόρτον,","wordsOfJesus":true},{"noteId":266},{"text":"εἶτα στάχυν, εἶτα","wordsOfJesus":true},{"noteId":267},{"text":"πλήρη σῖτον ἐν τῷ στάχυϊ.","wordsOfJesus":true}]},{"type":"verse","number":29,"content":[{"text":"Ὅταν δὲ","wordsOfJesus":true},{"noteId":268},{"text":"παραδῷ ὁ καρπός,","wordsOfJesus":true},{"noteId":269},{"text":"εὐθέως ἀποστέλλει τὸ δρέπανον, ὅτι παρέστηκεν ὁ θερισμός.","wordsOfJesus":true}]},{"type":"heading","content":["The Parable of the Mustard Seed"]},{"type":"verse","number":30,"content":["Καὶ ἔλεγε,",{"noteId":270},{"text":"Τίνι","wordsOfJesus":true},{"noteId":271},{"text":"ὁμοιώσωμεν τὴν βασιλείαν τοῦ Θεοῦ; Ἢ ἐν","wordsOfJesus":true},{"noteId":272},{"text":"ποίᾳ παραβολῇ παραβάλωμεν αὐτήν;","wordsOfJesus":true}]},{"type":"verse","number":31,"content":[{"text":"Ὡς","wordsOfJesus":true},{"noteId":273},{"text":"κόκκον σινάπεως, ὅς, ὅταν σπαρῇ ἐπὶ τῆς γῆς,","wordsOfJesus":true},{"noteId":274},{"text":"μικρότερος πάντων τῶν σπερμάτων ἐστὶ τῶν ἐπὶ τῆς γῆς·","wordsOfJesus":true}]},{"type":"verse","number":32,"content":[{"text":"καὶ ὅταν σπαρῇ, ἀναβαίνει, καὶ","wordsOfJesus":true},{"noteId":275},{"text":"γίνεται","wordsOfJesus":true},{"noteId":276},{"text":"πάντων τῶν λαχάνων μείζων, καὶ ποιεῖ κλάδους μεγάλους, ὥστε δύνασθαι ὑπὸ τὴν σκιὰν αὐτοῦ τὰ πετεινὰ τοῦ οὐρανοῦ","wordsOfJesus":true},{"noteId":277},{"text":"κατασκηνοῦν.","wordsOfJesus":true}]},{"type":"heading","content":["The Use of Parables"]},{"type":"verse","number":33,"content":["Καὶ τοιαύταις παραβολαῖς πολλαῖς ἐλάλει αὐτοῖς τὸν λόγον, καθὼς",{"noteId":278},"ἐδύναντο ἀκούειν·"]},{"type":"verse","number":34,"content":["χωρὶς δὲ παραβολῆς οὐκ ἐλάλει",{"noteId":279},"αὐτοῖς·",{"noteId":280},"κατ᾽ ἰδίαν δὲ τοῖς",{"noteId":281},"μαθηταῖς αὐτοῦ ἐπέλυε πάντα."]},{"type":"heading","content":["Jesus Calms a Storm"]},{"type":"verse","number":35,"content":["Καὶ λέγει αὐτοῖς ἐν ἐκείνῃ τῇ ἡμέρᾳ, ὀψίας γενομένης,",{"text":"Διέλθωμεν εἰς τὸ πέραν.","wordsOfJesus":true}]},{"type":"verse","number":36,"content":["Καὶ ἀφέντες τὸν ὄχλον, παραλαμβάνουσιν αὐτὸν ὡς ἦν ἐν τῷ πλοίῳ. Καὶ ἄλλα",{"noteId":282},"δὲ",{"noteId":283},"πλοιάρια ἦν μετ᾽ αὐτοῦ."]},{"type":"verse","number":37,"content":["Καὶ",{"noteId":284},"γίνεται λαῖλαψ",{"noteId":285},"ἀνέμου μεγάλη·",{"noteId":286},"τὰ δὲ κύματα",{"noteId":287},"ἐπέβαλλεν εἰς τὸ πλοῖον, ὥστε",{"noteId":288},"αὐτὸ ἤδη γεμίζεσθαι."]},{"type":"verse","number":38,"content":["Καὶ",{"noteId":289},"ἦν αὐτὸς",{"noteId":290},"ἐπὶ τῇ πρύμνῃ ἐπὶ τὸ προσκεφάλαιον καθεύδων· καὶ",{"noteId":291},"διεγείρουσιν αὐτόν, καὶ λέγουσιν αὐτῷ, Διδάσκαλε, οὐ μέλει σοι ὅτι ἀπολλύμεθα;"]},{"type":"verse","number":39,"content":["Καὶ διεγερθεὶς ἐπετίμησε τῷ ἀνέμῳ, καὶ εἶπε τῇ θαλάσσῃ,",{"text":"Σιώπα, πεφίμωσο.","wordsOfJesus":true},"Καὶ ἐκόπασεν ὁ ἄνεμος, καὶ ἐγένετο γαλήνη μεγάλη."]},{"type":"verse","number":40,"content":["Καὶ εἶπεν αὐτοῖς,",{"text":"Τί δειλοί ἐστε","wordsOfJesus":true},{"noteId":292},{"text":"οὕτω;","wordsOfJesus":true},{"noteId":293},{"text":"Πῶς οὐκ ἔχετε πίστιν;","wordsOfJesus":true}]},{"type":"verse","number":41,"content":["Καὶ ἐφοβήθησαν φόβον μέγαν, καὶ ἔλεγον πρὸς ἀλλήλους, Τίς ἄρα οὗτός ἐστιν, ὅτι καὶ ὁ ἄνεμος καὶ ἡ θάλασσα",{"noteId":294},"ὑπακούουσιν αὐτῷ;"]}],"footnotes":[{"noteId":215,"caller":"+","text":"συνηχθη ¦ συναγεται CT","reference":{"chapter":4,"verse":1}},{"noteId":216,"caller":"+","text":"πολυς ¦ πλειστος CT","reference":{"chapter":4,"verse":1}},{"noteId":217,"caller":"+","text":"εμβαντα εις το πλοιον ¦ εις πλοιον εμβαντα CT","reference":{"chapter":4,"verse":1}},{"noteId":218,"caller":"+","text":"ην ¦ ησαν ANT CT","reference":{"chapter":4,"verse":1}},{"noteId":219,"caller":"+","text":"του ¦ — ECM† NA SBL TH WH","reference":{"chapter":4,"verse":3}},{"noteId":220,"caller":"+","text":"παρα ¦ επι ANT","r