{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"MRK","translationId":"grc_tcg","name":"ΚΑΤΑ ΜΑΡΚΟΝ","commonName":"ΚΑΤΑ ΜΑΡΚΟΝ","title":"ΚΑΤΑ ΜΑΡΚΟΝ","order":41,"numberOfChapters":16,"sha256":"458ddb37b7c88bd21fa977538125daa8129b125491fad25357901af5ebb1abc8","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/MRK/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/grc_tcg/MRK/16.json","totalNumberOfVerses":678},"chapter":{"number":5,"content":[{"type":"heading","content":["Jesus Heals a Demon-Possessed Man"]},{"type":"verse","number":1,"content":["Καὶ ἦλθον εἰς τὸ πέραν τῆς θαλάσσης, εἰς τὴν χώραν τῶν",{"noteId":295},"Γαδαρηνῶν."]},{"type":"verse","number":2,"content":["Καὶ",{"noteId":296},"ἐξελθόντι αὐτῷ ἐκ τοῦ πλοίου,",{"noteId":297},"εὐθέως",{"noteId":298},"ἀπήντησεν αὐτῷ ἐκ τῶν μνημείων ἄνθρωπος ἐν πνεύματι ἀκαθάρτῳ,"]},{"type":"verse","number":3,"content":["ὃς τὴν",{"noteId":299},"κατοίκησιν εἶχεν ἐν τοῖς",{"noteId":300},"μνήμασι· καὶ",{"noteId":301},"οὔτε ἁλύσεσιν οὐδεὶς",{"noteId":302},"ἐδύνατο αὐτὸν δῆσαι,"]},{"type":"verse","number":4,"content":["διὰ τὸ αὐτὸν πολλάκις πέδαις καὶ ἁλύσεσι δεδέσθαι, καὶ διεσπᾶσθαι ὑπ᾽ αὐτοῦ τὰς ἁλύσεις, καὶ τὰς πέδας συντετρίφθαι· καὶ οὐδεὶς",{"noteId":303},"αὐτὸν ἴσχυε δαμάσαι·"]},{"type":"verse","number":5,"content":["καὶ διὰ παντός, νυκτὸς καὶ ἡμέρας, ἐν τοῖς",{"noteId":304},"ὄρεσι καὶ ἐν τοῖς μνήμασιν ἦν κράζων καὶ κατακόπτων ἑαυτὸν λίθοις."]},{"type":"verse","number":6,"content":[{"noteId":305},"Ἰδὼν δὲ τὸν Ἰησοῦν ἀπὸ μακρόθεν, ἔδραμε καὶ προσεκύνησεν",{"noteId":306},"αὐτῷ,"]},{"type":"verse","number":7,"content":["καὶ κράξας φωνῇ μεγάλῃ",{"noteId":307},"εἶπε, Τί ἐμοὶ καὶ σοί, Ἰησοῦ, υἱὲ τοῦ Θεοῦ τοῦ ὑψίστου; Ὁρκίζω σε τὸν Θεόν, μή με βασανίσῃς."]},{"type":"verse","number":8,"content":["Ἔλεγε γὰρ αὐτῷ,",{"text":"Ἔξελθε, τὸ πνεῦμα τὸ ἀκάθαρτον, ἐκ τοῦ ἀνθρώπου.","wordsOfJesus":true}]},{"type":"verse","number":9,"content":["Καὶ ἐπηρώτα αὐτόν,",{"text":"Τί","wordsOfJesus":true},{"noteId":308},{"text":"σοι ὄνομα;","wordsOfJesus":true},"Καὶ",{"noteId":309},"ἀπεκρίθη, λέγων,",{"noteId":310},"Λεγεὼν ὄνομά μοι, ὅτι πολλοί ἐσμεν."]},{"type":"verse","number":10,"content":["Καὶ παρεκάλει αὐτὸν πολλὰ ἵνα μὴ",{"noteId":311},"αὐτοὺς ἀποστείλῃ ἔξω τῆς χώρας."]},{"type":"verse","number":11,"content":["Ἦν δὲ ἐκεῖ",{"noteId":312},"πρὸς τῷ ὄρει ἀγέλη χοίρων μεγάλη βοσκομένη·"]},{"type":"verse","number":12,"content":["καὶ παρεκάλεσαν αὐτὸν",{"noteId":313},"πάντες οἱ δαίμονες, λέγοντες, Πέμψον ἡμᾶς εἰς τοὺς χοίρους, ἵνα εἰς αὐτοὺς εἰσέλθωμεν."]},{"type":"verse","number":13,"content":["Καὶ ἐπέτρεψεν αὐτοῖς",{"noteId":314},"εὐθέως ὁ Ἰησοῦς. Καὶ ἐξελθόντα τὰ πνεύματα τὰ ἀκάθαρτα εἰσῆλθον εἰς τοὺς χοίρους· καὶ ὥρμησεν ἡ ἀγέλη κατὰ τοῦ κρημνοῦ εἰς τὴν θάλασσαν·",{"noteId":315},"ἦσαν δὲ ὡς",{"noteId":316},"δισχίλιοι· καὶ ἐπνίγοντο ἐν τῇ θαλάσσῃ."]},{"type":"verse","number":14,"content":[{"noteId":317},"Οἱ δὲ βόσκοντες",{"noteId":318},"τοὺς χοίρους ἔφυγον, καὶ",{"noteId":319},"ἀνήγγειλαν εἰς τὴν πόλιν καὶ εἰς τοὺς ἀγρούς. Καὶ",{"noteId":320},"ἐξῆλθον ἰδεῖν τί ἐστι τὸ γεγονός·"]},{"type":"verse","number":15,"content":["καὶ ἔρχονται πρὸς τὸν Ἰησοῦν, καὶ θεωροῦσι τὸν δαιμονιζόμενον καθήμενον",{"noteId":321},"καὶ ἱματισμένον καὶ σωφρονοῦντα, τὸν ἐσχηκότα τὸν",{"noteId":322},"Λεγεῶνα· καὶ ἐφοβήθησαν."]},{"type":"verse","number":16,"content":[{"noteId":323},"Διηγήσαντο δὲ αὐτοῖς οἱ ἰδόντες πῶς ἐγένετο τῷ δαιμονιζομένῳ, καὶ περὶ τῶν χοίρων."]},{"type":"verse","number":17,"content":["Καὶ ἤρξαντο παρακαλεῖν αὐτὸν ἀπελθεῖν ἀπὸ τῶν ὁρίων αὐτῶν."]},{"type":"verse","number":18,"content":["Καὶ",{"noteId":324},"ἐμβάντος αὐτοῦ εἰς τὸ πλοῖον, παρεκάλει αὐτὸν ὁ δαιμονισθείς, ἵνα",{"noteId":325},"ᾖ μετ᾽ αὐτοῦ."]},{"type":"verse","number":19,"content":[{"noteId":326},"Ὁ δὲ Ἰησοῦς οὐκ ἀφῆκεν αὐτόν, ἀλλὰ λέγει αὐτῷ,",{"text":"Ὕπαγε εἰς τὸν οἶκόν σου πρὸς τοὺς σούς, καὶ","wordsOfJesus":true},{"noteId":327},{"text":"ἀνάγγειλον αὐτοῖς ὅσα","wordsOfJesus":true},{"noteId":328},{"text":"σοι ὁ Κύριος","wordsOfJesus":true},{"noteId":329},{"text":"πεποίηκε, καὶ ἠλέησέ σε.","wordsOfJesus":true}]},{"type":"verse","number":20,"content":["Καὶ ἀπῆλθε καὶ ἤρξατο κηρύσσειν ἐν τῇ Δεκαπόλει ὅσα ἐποίησεν αὐτῷ ὁ Ἰησοῦς· καὶ πάντες ἐθαύμαζον."]},{"type":"heading","content":["A Girl Restored to Life and a Woman Healed"]},{"type":"verse","number":21,"content":["Καὶ διαπεράσαντος τοῦ Ἰησοῦ ἐν τῷ πλοίῳ πάλιν εἰς τὸ πέραν, συνήχθη ὄχλος πολὺς ἐπ᾽ αὐτόν, καὶ ἦν παρὰ τὴν θάλασσαν."]},{"type":"verse","number":22,"content":["Καὶ",{"noteId":330},"ἰδού, ἔρχεται εἷς τῶν ἀρχισυναγώγων, ὀνόματι",{"noteId":331},"Ἰάειρος, καὶ ἰδὼν αὐτόν, πίπτει πρὸς τοὺς πόδας αὐτοῦ,"]},{"type":"verse","number":23,"content":["καὶ",{"noteId":332},"παρεκάλει αὐτὸν πολλά, λέγων ὅτι Τὸ θυγάτριόν μου ἐσχάτως ἔχει· ἵνα ἐλθὼν ἐπιθῇς",{"noteId":333},"αὐτῇ τὰς χεῖρας,",{"noteId":334},"ὅπως σωθῇ καὶ",{"noteId":335},"ζήσεται."]},{"type":"verse","number":24,"content":["Καὶ ἀπῆλθε μετ᾽ αὐτοῦ· καὶ ἠκολούθει αὐτῷ ὄχλος πολύς, καὶ συνέθλιβον αὐτόν."]},{"type":"verse","number":25,"content":["Καὶ γυνή",{"noteId":336},"τις οὖσα ἐν ῥύσει αἵματος",{"noteId":337},"ἔτη δώδεκα,"]},{"type":"verse","number":26,"content":["καὶ πολλὰ παθοῦσα ὑπὸ πολλῶν ἰατρῶν, καὶ δαπανήσασα τὰ παρ᾽",{"noteId":338},"αὐτῆς πάντα, καὶ μηδὲν ὠφεληθεῖσα, ἀλλὰ μᾶλλον εἰς τὸ χεῖρον ἐλθοῦσα,"]},{"type":"verse","number":27,"content":["ἀκούσασα",{"noteId":339},"περὶ τοῦ Ἰησοῦ, ἐλθοῦσα ἐν τῷ ὄχλῳ ὄπισθεν, ἥψατο τοῦ ἱματίου αὐτοῦ·"]},{"type":"verse","number":28,"content":["ἔλεγε",{"noteId":340},"γὰρ ὅτι",{"noteId":341},"Κἂν τῶν ἱματίων αὐτοῦ ἅψωμαι, σωθήσομαι."]},{"type":"verse","number":29,"content":["Καὶ",{"noteId":342},"εὐθέως ἐξηράνθη ἡ πηγὴ τοῦ αἵματος αὐτῆς, καὶ ἔγνω τῷ σώματι ὅτι ἴαται ἀπὸ τῆς μάστιγος."]},{"type":"verse","number":30,"content":["Καὶ",{"noteId":343},"εὐθέως ὁ Ἰησοῦς ἐπιγνοὺς ἐν ἑαυτῷ τὴν ἐξ αὐτοῦ δύναμιν ἐξελθοῦσαν, ἐπιστραφεὶς ἐν τῷ ὄχλῳ, ἔλεγε,",{"text":"Τίς μου ἥψατο τῶν ἱματίων;","wordsOfJesus":true}]},{"type":"verse","number":31,"content":["Καὶ ἔλεγον αὐτῷ οἱ μαθηταὶ αὐτοῦ, Βλέπεις τὸν ὄχλον συνθλίβοντά σε, καὶ λέγεις,",{"text":"Τίς μου ἥψατο;","wordsOfJesus":true}]},{"type":"verse","number":32,"content":["Καὶ περιεβλέπετο ἰδεῖν τὴν τοῦτο ποιήσασαν."]},{"type":"verse","number":33,"content":["Ἡ δὲ γυνὴ φοβηθεῖσα καὶ τρέμουσα, εἰδυῖα ὃ γέγονεν",{"noteId":344},"ἐπ᾽ αὐτῇ, ἦλθε καὶ προσέπεσεν αὐτῷ, καὶ εἶπεν αὐτῷ πᾶσαν τὴν ἀλήθειαν."]},{"type":"verse","number":34,"content":["Ὁ δὲ εἶπεν αὐτῇ,",{"noteId":345},{"text":"Θύγατερ, ἡ πίστις σου σέσωκέ σε· ὕπαγε εἰς εἰρήνην, καὶ ἴσθι ὑγιὴς ἀπὸ τῆς μάστιγός σου.","wordsOfJesus":true}]},{"type":"verse","number":35,"content":["Ἔτι αὐτοῦ λαλοῦντος, ἔρχονται ἀπὸ τοῦ ἀρχισυναγώγου, λέγοντες ὅτι Ἡ θυγάτηρ σου ἀπέθανε· τί ἔτι σκύλλεις τὸν διδάσκαλον;"]},{"type":"verse","number":36,"content":["Ὁ δὲ Ἰησοῦς",{"noteId":346},"εὐθέως ἀκούσας τὸν λόγον λαλούμενον λέγει τῷ ἀρχισυναγώγῳ,",{"text":"Μὴ φοβοῦ· μόνον πίστευε.","wordsOfJesus":true}]},{"type":"verse","number":37,"content":["Καὶ οὐκ ἀφῆκεν",{"noteId":347},"οὐδένα αὐτῷ συνακολουθῆσαι, εἰ μὴ",{"noteId":348},"Πέτρον καὶ Ἰάκωβον καὶ",{"noteId":349},"Ἰωάννην τὸν ἀδελφὸν Ἰακώβου."]},{"type":"verse","number":38,"content":["Καὶ",{"noteId":350},"ἔρχεται εἰς τὸν οἶκον τοῦ ἀρχισυναγώγου, καὶ θεωρεῖ θόρυβον,",{"noteId":351},"κλαίοντας καὶ ἀλαλάζοντας πολλά."]},{"type":"verse","number":39,"content":["Καὶ εἰσελθὼν λέγει αὐτοῖς,",{"text":"Τί θορυβεῖσθε καὶ κλαίετε; Τὸ παιδίον οὐκ ἀπέθανεν, ἀλλὰ καθεύδει.","wordsOfJesus":true}]},{"type":"verse","number":40,"content":["Καὶ κατεγέλων αὐτοῦ.",{"noteId":352},"Ὁ δέ, ἐκβαλὼν",{"noteId":353},"πάντας, παραλαμβάνει τὸν πατέρα τοῦ παιδίου καὶ τὴν μητέρα καὶ τοὺς μετ᾽ αὐτοῦ, καὶ εἰσπορεύεται ὅπου ἦν τὸ παιδίον",{"noteId":354},"ἀνακείμενον."]},{"type":"verse","number":41,"content":["Καὶ κρατήσας τῆς χειρὸς τοῦ παιδίου, λέγει αὐτῇ,",{"noteId":355},{"text":"Ταλιθά, κοῦμι·","wordsOfJesus":true},"ὅ ἐστι μεθερμηνευόμενον,",{"text":"Τὸ κοράσιον, σοὶ λέγω,","wordsOfJesus":true},{"noteId":356},{"text":"ἔγειραι.","wordsOfJesus":true}]},{"type":"verse","number":42,"content":["Καὶ",{"noteId":357},"εὐθέως ἀνέστη τὸ κοράσιον καὶ περιεπάτει, ἦν γὰρ ἐτῶν δώδεκα· καὶ",{"noteId":358},"ἐξέστησαν ἐκστάσει μεγάλῃ."]},{"type":"verse","number":43,"content":["Καὶ διεστείλατο αὐτοῖς πολλὰ ἵνα μηδεὶς",{"noteId":359},"γνῷ τοῦτο· καὶ εἶπε δοθῆναι αὐτῇ φαγεῖν."]}],"footnotes":[{"noteId":295,"caller":"+","text":"γαδαρηνων 95% ¦ γεργεσηνων ANT 4% ¦ γερασηνων CT 0.3%","reference":{"chapter":5,"verse":1}},{"noteId":296,"caller":"+","text":"εξελθοντι αυτω ¦ εξελθοντος αυτου ANT CT","reference":{"chapter":5,"verse":2}},{"noteId":297,"caller":"+","text":"ευθεως ¦ ευθυς CT","reference":{"chapter":5,"verse":2}},{"noteId":298,"caller":"+","text":"απηντησεν ¦ υπηντησεν ECM† NA SBL TH WH","reference":{"chapter":5,"verse":2}},{"noteId":299,"caller":"+","text":"κατοικησιν ¦ οικησιν PCK","reference":{"chapter":5,"verse":3}},{"noteId":300,"caller":"+","text":"μνημασι ¦ μνημειοις TR","reference":{"chapter":5,"verse":3}},{"noteId":301,"caller":"+","text":"ουτε αλυσεσιν ¦ ουδε αλυσει ουκετι CT","reference":{"chapter":5,"verse":3}},{"noteId":302,"caller":"+","text":"εδυνατο ¦ ηδυνατο ANT PCK TR","reference":{"chapter":5,"verse":3}},{"noteId":303,"caller":"+","text":"αυτον ισχυε ¦ αυτον ισχυσε PCK ¦ ισχυεν αυτον ANT CT","reference":{"chapter":5,"verse":4}},{"noteId":304,"caller":"+","text":"ορεσι και εν τοις μνημασιν ¦ μνημασι και εν τοις ορεσιν ANT CT PCK","reference":{