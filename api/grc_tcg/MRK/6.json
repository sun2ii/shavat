{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"MRK","translationId":"grc_tcg","name":"ΚΑΤΑ ΜΑΡΚΟΝ","commonName":"ΚΑΤΑ ΜΑΡΚΟΝ","title":"ΚΑΤΑ ΜΑΡΚΟΝ","order":41,"numberOfChapters":16,"sha256":"458ddb37b7c88bd21fa977538125daa8129b125491fad25357901af5ebb1abc8","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/MRK/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/grc_tcg/MRK/16.json","totalNumberOfVerses":678},"chapter":{"number":6,"content":[{"type":"heading","content":["Jesus Rejected at Nazareth"]},{"type":"verse","number":1,"content":["Καὶ ἐξῆλθεν ἐκεῖθεν, καὶ",{"noteId":360},"ἦλθεν εἰς τὴν πατρίδα",{"noteId":361},"αὐτοῦ· καὶ ἀκολουθοῦσιν αὐτῷ οἱ μαθηταὶ αὐτοῦ."]},{"type":"verse","number":2,"content":["Καὶ γενομένου σαββάτου, ἤρξατο",{"noteId":362},"ἐν τῇ συναγωγῇ διδάσκειν· καὶ",{"noteId":363},"πολλοὶ ἀκούοντες ἐξεπλήσσοντο, λέγοντες, Πόθεν τούτῳ ταῦτα; Καὶ τίς ἡ σοφία ἡ δοθεῖσα",{"noteId":364},"αὐτῷ,",{"noteId":365},"καὶ",{"noteId":366},"δυνάμεις τοιαῦται διὰ τῶν χειρῶν αὐτοῦ",{"noteId":367},"γίνονται;"]},{"type":"verse","number":3,"content":["Οὐχ οὗτός ἐστιν ὁ τέκτων, ὁ υἱὸς",{"noteId":368},"Μαρίας,",{"noteId":369},"ἀδελφὸς δὲ Ἰακώβου καὶ",{"noteId":370},"Ἰωσῆ καὶ Ἰούδα καὶ Σίμωνος; Καὶ οὐκ εἰσὶν αἱ ἀδελφαὶ αὐτοῦ ὧδε πρὸς ἡμᾶς; Καὶ ἐσκανδαλίζοντο ἐν αὐτῷ."]},{"type":"verse","number":4,"content":[{"noteId":371},"Ἔλεγε δὲ αὐτοῖς ὁ Ἰησοῦς ὅτι",{"text":"Οὐκ ἔστι προφήτης ἄτιμος, εἰ μὴ ἐν τῇ πατρίδι αὐτοῦ, καὶ ἐν τοῖς","wordsOfJesus":true},{"noteId":372},{"text":"συγγενέσι καὶ ἐν τῇ οἰκίᾳ αὐτοῦ.","wordsOfJesus":true}]},{"type":"verse","number":5,"content":["Καὶ οὐκ",{"noteId":373},"ἠδύνατο ἐκεῖ",{"noteId":374},"οὐδεμίαν δύναμιν ποιῆσαι, εἰ μὴ ὀλίγοις ἀρρώστοις ἐπιθεὶς τὰς χεῖρας, ἐθεράπευσε."]},{"type":"verse","number":6,"content":["Καὶ",{"noteId":375},"ἐθαύμαζε διὰ τὴν ἀπιστίαν αὐτῶν. Jesus Sends Out the Twelve Apostles Καὶ περιῆγε τὰς κώμας κύκλῳ διδάσκων."]},{"type":"verse","number":7,"content":["Καὶ προσκαλεῖται τοὺς δώδεκα, καὶ ἤρξατο αὐτοὺς ἀποστέλλειν δύο δύο, καὶ ἐδίδου αὐτοῖς ἐξουσίαν τῶν πνευμάτων τῶν ἀκαθάρτων."]},{"type":"verse","number":8,"content":["Καὶ παρήγγειλεν αὐτοῖς ἵνα μηδὲν αἴρωσιν εἰς ὁδόν, εἰ μὴ ῥάβδον μόνον· μὴ",{"noteId":376},"πήραν, μὴ ἄρτον, μὴ εἰς τὴν ζώνην χαλκόν·"]},{"type":"verse","number":9,"content":[{"noteId":377},"ἀλλ᾽ ὑποδεδεμένους σανδάλια· καὶ μὴ",{"noteId":378},"ἐνδύσησθε δύο χιτῶνας."]},{"type":"verse","number":10,"content":["Καὶ ἔλεγεν αὐτοῖς,",{"text":"Ὅπου ἐὰν εἰσέλθητε εἰς οἰκίαν, ἐκεῖ μένετε ἕως ἂν ἐξέλθητε ἐκεῖθεν.","wordsOfJesus":true}]},{"type":"verse","number":11,"content":[{"text":"Καὶ","wordsOfJesus":true},{"noteId":379},{"text":"ὅσοι ἂν μὴ δέξωνται ὑμᾶς, μηδὲ ἀκούσωσιν ὑμῶν, ἐκπορευόμενοι ἐκεῖθεν, ἐκτινάξατε τὸν χοῦν τὸν ὑποκάτω τῶν ποδῶν ὑμῶν εἰς μαρτύριον αὐτοῖς.","wordsOfJesus":true},{"noteId":380},{"text":"Ἀμὴν λέγω ὑμῖν, ἀνεκτότερον ἔσται Σοδόμοις ἢ Γομόρροις ἐν ἡμέρᾳ κρίσεως, ἢ τῇ πόλει ἐκείνῃ.","wordsOfJesus":true}]},{"type":"verse","number":12,"content":["Καὶ ἐξελθόντες",{"noteId":381},"ἐκήρυσσον ἵνα",{"noteId":382},"μετανοήσωσι·"]},{"type":"verse","number":13,"content":["καὶ δαιμόνια πολλὰ ἐξέβαλλον, καὶ ἤλειφον ἐλαίῳ πολλοὺς ἀρρώστους καὶ ἐθεράπευον."]},{"type":"heading","content":["The Death of John the Baptist"]},{"type":"verse","number":14,"content":["Καὶ ἤκουσεν ὁ βασιλεὺς Ἡρῴδης, φανερὸν γὰρ ἐγένετο τὸ ὄνομα αὐτοῦ, καὶ",{"noteId":383},"ἔλεγεν ὅτι",{"noteId":384},"Ἰωάννης ὁ βαπτίζων",{"noteId":385},"ἐκ νεκρῶν ἠγέρθη, καὶ διὰ τοῦτο ἐνεργοῦσιν αἱ δυνάμεις ἐν αὐτῷ."]},{"type":"verse","number":15,"content":[{"noteId":386},"Ἄλλοι ἔλεγον ὅτι",{"noteId":387},"Ἠλίας ἐστίν· ἄλλοι δὲ ἔλεγον ὅτι Προφήτης",{"noteId":388},"ἐστίν, ὡς εἷς τῶν προφητῶν."]},{"type":"verse","number":16,"content":["Ἀκούσας δὲ",{"noteId":389},"Ἡρῴδης",{"noteId":390},"εἶπεν",{"noteId":391},"ὅτι Ὃν ἐγὼ ἀπεκεφάλισα",{"noteId":392},"Ἰωάννην, οὗτός ἐστιν· αὐτὸς ἠγέρθη",{"noteId":393},"ἐκ νεκρῶν."]},{"type":"verse","number":17,"content":["Αὐτὸς γὰρ ὁ Ἡρῴδης ἀποστείλας ἐκράτησε τὸν",{"noteId":394},"Ἰωάννην, καὶ ἔδησεν αὐτὸν ἐν",{"noteId":395},"φυλακῇ, διὰ Ἡρῳδιάδα τὴν γυναῖκα Φιλίππου τοῦ ἀδελφοῦ αὐτοῦ, ὅτι αὐτὴν ἐγάμησεν."]},{"type":"verse","number":18,"content":["Ἔλεγε γὰρ ὁ",{"noteId":396},"Ἰωάννης τῷ Ἡρῴδῃ ὅτι Οὐκ ἔξεστί σοι ἔχειν τὴν γυναῖκα τοῦ ἀδελφοῦ σου."]},{"type":"verse","number":19,"content":["Ἡ δὲ Ἡρῳδιὰς ἐνεῖχεν αὐτῷ, καὶ ἤθελεν αὐτὸν ἀποκτεῖναι· καὶ οὐκ ἠδύνατο·"]},{"type":"verse","number":20,"content":["ὁ γὰρ Ἡρῴδης ἐφοβεῖτο τὸν",{"noteId":397},"Ἰωάννην, εἰδὼς αὐτὸν ἄνδρα δίκαιον καὶ ἅγιον, καὶ συνετήρει αὐτόν· καὶ",{"noteId":398},"ἀκούσας αὐτοῦ, πολλὰ",{"noteId":399},"ἐποίει, καὶ ἡδέως αὐτοῦ ἤκουε."]},{"type":"verse","number":21,"content":["Καὶ γενομένης ἡμέρας εὐκαίρου, ὅτε Ἡρῴδης τοῖς γενεσίοις αὐτοῦ δεῖπνον",{"noteId":400},"ἐποίει τοῖς μεγιστᾶσιν αὐτοῦ καὶ τοῖς",{"noteId":401},"χιλιάρχοις καὶ τοῖς πρώτοις τῆς Γαλιλαίας,"]},{"type":"verse","number":22,"content":["καὶ εἰσελθούσης τῆς θυγατρὸς",{"noteId":402},"αὐτῆς τῆς Ἡρῳδιάδος καὶ ὀρχησαμένης,",{"noteId":403},"καὶ ἀρεσάσης τῷ Ἡρῴδῃ καὶ τοῖς συνανακειμένοις,",{"noteId":404},"εἶπεν ὁ βασιλεὺς τῷ κορασίῳ, Αἴτησόν με ὃ ἐὰν θέλῃς, καὶ δώσω σοί·"]},{"type":"verse","number":23,"content":["καὶ ὤμοσεν",{"noteId":405},"αὐτῇ",{"noteId":406},"ὅτι Ὃ ἐάν με αἰτήσῃς, δώσω σοί, ἕως ἡμίσους τῆς βασιλείας μου."]},{"type":"verse","number":24,"content":[{"noteId":407},"Ἡ δὲ ἐξελθοῦσα εἶπε τῇ μητρὶ αὐτῆς, Τί",{"noteId":408},"αἰτήσομαι; Ἡ δὲ εἶπε, Τὴν κεφαλὴν",{"noteId":409},"Ἰωάννου τοῦ",{"noteId":410},"βαπτιστοῦ."]},{"type":"verse","number":25,"content":["Καὶ εἰσελθοῦσα",{"noteId":411},"εὐθέως μετὰ σπουδῆς πρὸς τὸν βασιλέα, ᾐτήσατο, λέγουσα, Θέλω ἵνα",{"noteId":412},"μοι δῷς ἐξαυτῆς ἐπὶ πίνακι τὴν κεφαλὴν",{"noteId":413},"Ἰωάννου τοῦ βαπτιστοῦ."]},{"type":"verse","number":26,"content":["Καὶ περίλυπος γενόμενος ὁ βασιλεύς, διὰ τοὺς ὅρκους καὶ τοὺς",{"noteId":414},"συνανακειμένους οὐκ ἠθέλησεν",{"noteId":415},"αὐτὴν ἀθετῆσαι."]},{"type":"verse","number":27,"content":["Καὶ",{"noteId":416},"εὐθέως ἀποστείλας ὁ βασιλεὺς",{"noteId":417},"σπεκουλάτορα ἐπέταξεν",{"noteId":418},"ἐνεχθῆναι τὴν κεφαλὴν αὐτοῦ."]},{"type":"verse","number":28,"content":[{"noteId":419},"Ὁ δὲ ἀπελθὼν ἀπεκεφάλισεν αὐτὸν ἐν τῇ φυλακῇ, καὶ ἤνεγκε τὴν κεφαλὴν αὐτοῦ ἐπὶ πίνακι, καὶ ἔδωκεν αὐτὴν τῷ κορασίῳ· καὶ τὸ κοράσιον ἔδωκεν αὐτὴν τῇ μητρὶ αὐτῆς."]},{"type":"verse","number":29,"content":["Καὶ ἀκούσαντες οἱ μαθηταὶ αὐτοῦ",{"noteId":420},"ἦλθον, καὶ ἦραν τὸ πτῶμα αὐτοῦ, καὶ ἔθηκαν αὐτὸ ἐν μνημείῳ."]},{"type":"heading","content":["The Feeding of the Five Thousand"]},{"type":"verse","number":30,"content":["Καὶ συνάγονται οἱ ἀπόστολοι πρὸς τὸν Ἰησοῦν, καὶ ἀπήγγειλαν αὐτῷ πάντα,",{"noteId":421},"καὶ ὅσα ἐποίησαν καὶ ὅσα ἐδίδαξαν."]},{"type":"verse","number":31,"content":["Καὶ",{"noteId":422},"εἶπεν αὐτοῖς,",{"text":"Δεῦτε ὑμεῖς αὐτοὶ κατ᾽ ἰδίαν εἰς ἔρημον τόπον, καὶ","wordsOfJesus":true},{"noteId":423},{"text":"ἀναπαύεσθε ὀλίγον.","wordsOfJesus":true},"Ἦσαν γὰρ οἱ ἐρχόμενοι καὶ οἱ ὑπάγοντες πολλοί, καὶ οὐδὲ φαγεῖν",{"noteId":424},"εὐκαίρουν."]},{"type":"verse","number":32,"content":["Καὶ ἀπῆλθον",{"noteId":425},"εἰς ἔρημον τόπον τῷ πλοίῳ κατ᾽ ἰδίαν."]},{"type":"verse","number":33,"content":["Καὶ",{"noteId":426},"εἶδον αὐτοὺς",{"noteId":427},"ὑπάγοντας καὶ",{"noteId":428},"ἐπέγνωσαν",{"noteId":429},"αὐτὸν πολλοί, καὶ πεζῇ ἀπὸ πασῶν τῶν πόλεων συνέδραμον ἐκεῖ, καὶ προῆλθον αὐτούς,",{"noteId":430},"καὶ συνῆλθον πρὸς αὐτόν."]},{"type":"verse","number":34,"content":["Καὶ ἐξελθὼν",{"noteId":431},"εἶδεν ὁ Ἰησοῦς πολὺν ὄχλον, καὶ ἐσπλαγχνίσθη ἐπ᾽",{"noteId":432},"αὐτοῖς, ὅτι ἦσαν ὡς πρόβατα μὴ ἔχοντα ποιμένα· καὶ ἤρξατο διδάσκειν αὐτοὺς πολλά."]},{"type":"verse","number":35,"content":["Καὶ ἤδη ὥρας πολλῆς γενομένης, προσελθόντες αὐτῷ οἱ μαθηταὶ αὐτοῦ",{"noteId":433},"λέγουσιν ὅτι Ἔρημός ἐστιν ὁ τόπος, καὶ ἤδη ὥρα πολλή·"]},{"type":"verse","number":36,"content":["ἀπόλυσον αὐτούς, ἵνα ἀπελθόντες εἰς τοὺς κύκλῳ ἀγροὺς καὶ κώμας ἀγοράσωσιν ἑαυτοῖς",{"noteId":434},"ἄρτους. Τί γὰρ φάγωσιν οὐκ ἔχουσιν."]},{"type":"verse","number":37,"content":["Ὁ δὲ ἀποκριθεὶς εἶπεν αὐτοῖς,",{"text":"Δότε αὐτοῖς ὑμεῖς φαγεῖν.","wordsOfJesus":true},"Καὶ λέγουσιν αὐτῷ, Ἀπελθόντες ἀγοράσωμεν",{"noteId":435},"δηναρίων διακοσίων ἄρτους, καὶ",{"noteId":436},"δῶμεν αὐτοῖς φαγεῖν;"]},{"type":"verse","number":38,"content":["Ὁ δὲ λέγει αὐτοῖς,",{"text":"Πόσους","wordsOfJesus":true},{"noteId":437},{"text":"ἄρτους ἔχετε; Ὑπάγετε","wordsOfJesus":true},{"noteId":438},{"text":"καὶ ἴδετε.","wordsOfJesus":true},"Καὶ γνόντες λέγουσι, Πέντε, καὶ δύο ἰχθύας."]},{"type":"verse","number":39,"content":["Καὶ ἐπέταξεν αὐτοῖς",{"noteId":439},"ἀνακλῖναι πάντας συμπόσια συμπόσια ἐπὶ τῷ χλωρῷ χόρτῳ."]},{"type":"verse","number":40,"content":["Καὶ",{"noteId":440},"ἀνέπεσον πρασιαὶ πρασιαί,",{"noteId":441},"ἀνὰ ἑκατὸν καὶ ἀνὰ πεντήκοντα."]},{"type":"verse","number":41,"content":["Καὶ λαβὼν τοὺς πέντε ἄρτους καὶ τοὺς δύο ἰχθύας, ἀναβλέψας εἰς τὸν οὐρανόν, εὐλόγησε, καὶ κατέκλασε τοὺς ἄρτους, καὶ ἐδίδου τοῖς μαθηταῖς",{"noteId":442},"αὐτοῦ ἵνα",{"noteId":443},"παραθῶσιν αὐτοῖς· καὶ τοὺς δύο ἰχθύας ἐμέρισε πᾶσι."]},{"type":"verse","number":42,"content":["Καὶ ἔφαγον πάντες, καὶ ἐχορτάσθησαν·"]},{"type":"verse","number":43,"content":["καὶ ἦραν",{"noteId":444},"κλασμάτων δώδεκα",{"noteId":445},"κοφίνους πλήρεις, καὶ ἀπὸ τῶν ἰχθύων."]},{"type":"verse","number":44,"content":["Καὶ ἦσαν οἱ φαγόντες τοὺς ἄρτους",{"noteId":446},"πεντακισχίλιοι ἄνδρες."]},{"type":"heading","content":["Jesus Walks on Water"]},{"type":"verse","number":45,"content":["Καὶ",{"noteId":447},"εὐθέως ἠνάγκασε τοὺς μαθητὰς αὐτοῦ ἐμβῆναι εἰς τὸ πλοῖον, καὶ προάγειν εἰς τὸ πέραν πρὸς",{"noteId":448},"Βηθσαϊδάν, ἕως αὐτὸς",{"noteId":449},"ἀπολύσῃ τὸν ὄχλον."]},{"type":"verse","number":46,"content":["Καὶ ἀποταξάμενος αὐτοῖς, ἀπῆλθεν εἰς τὸ ὄρος προσεύξασθαι."]},{"type":"verse","number":47,"content":["Καὶ ὀψίας γενομένης, ἦν τὸ πλοῖον ἐν μέσῳ τῆς θαλάσσης, καὶ αὐτὸς μόνος ἐπὶ τῆς γῆς."]},{"type":"verse","number":48,"content":["Καὶ",{"noteId":450},"εἶδεν αὐτοὺς βασανιζομένους ἐν τῷ ἐλαύνειν, ἦν γὰρ ὁ ἄνεμος ἐναντίος αὐτοῖς,",{"noteId":451},"καὶ περὶ τετάρτην φυλακὴν τῆς νυκτὸς ἔρχεται πρὸς αὐτούς, περιπατῶν ἐπὶ τῆς θαλάσσης· καὶ ἤθελε παρελθεῖν αὐτούς."]},{"type":"verse","number":49,"content":["Οἱ δέ, ἰδόντες αὐτὸν",{"noteId":452},"περιπατοῦντα ἐπὶ τῆς θαλάσσης, ἔδοξαν",{"noteId":453},"φάντασμα εἶναι, καὶ ἀνέκραξαν·"]},{"type":"verse","number":50,"content":["πάντες γὰρ αὐτὸν",{"noteId":454},"εἶδον, καὶ ἐταράχθησαν.",{"noteId":455},"Καὶ",{"noteId":456},"εὐθέως ἐλάλησε μετ᾽ αὐτῶν, καὶ λέγει αὐτοῖς,",{"text":"Θαρσεῖτε· ἐγώ εἰμι, μὴ φοβεῖσθε.","wordsOfJesus":true}]},{"type":"verse","number":51,"content":["Καὶ ἀνέβη",{"noteId":457},"πρὸς αὐτοὺς εἰς τὸ πλοῖον, καὶ ἐκόπασεν ὁ ἄνεμος· καὶ λίαν",{"noteId":458},"ἐκπερισσοῦ ἐν ἑαυτοῖς ἐξίσταντο,",{"noteId":459},"καὶ ἐθαύμαζον."]},{"type":"verse","number":52,"content":["Οὐ γὰρ συνῆκαν ἐπὶ τοῖς ἄρτοις·",{"noteId":460},"ἦν γὰρ",{"noteId":461},"αὐτῶν ἡ καρδία πεπωρωμένη."]},{"type":"heading","content":["Jesus Heals the Sick in Gennesaret"]},{"type":"verse","number":53,"content":["Καὶ διαπεράσαντες",{"noteId":462},"ἦλθον ἐπὶ τὴν γῆν",{"noteId":463},"Γεννησαρέτ, καὶ προσωρμίσθησαν."]},{"type":"verse","number":54,"content":["Καὶ ἐξελθόντων αὐτῶν ἐκ τοῦ πλοίου,",{"noteId":464},"εὐθέως ἐπιγνόντες αὐτόν,"]},{"type":"verse","number":55,"content":[{"noteId":465},"περιδραμόντες ὅλην τὴν",{"noteId":466},"περίχωρον ἐκείνην,",{"noteId":467},"ἤρξαντο ἐπὶ τοῖς",{"noteId":468},"κραββάτοις τοὺς κακῶς ἔχοντας περιφέρειν, ὅπου ἤκουον ὅτι",{"noteId":469},"ἐκεῖ ἐστι."]},{"type":"verse","number":56,"content":["Καὶ ὅπου ἂν εἰσεπορεύετο εἰς κώμας ἢ",{"noteId":470},"πόλεις ἢ ἀγρούς, ἐν ταῖς ἀγοραῖς",{"noteId":471},"ἐτίθουν τοὺς ἀσθενοῦντας, καὶ παρεκάλουν αὐτὸν ἵνα κἂν τοῦ κρασπέδου τοῦ ἱματίου αὐτοῦ ἅψωνται· καὶ ὅσοι ἂν",{"noteId":472},"ἥπτοντο αὐτοῦ ἐσῴζοντο."]}],"footnotes":[{"noteId":360,"caller":"+","text":"ηλθεν ¦ ερχεται CT","reference":{"chapter":6,"verse":1}},{"noteId":361,"caller":"+","text":"αυτου ¦ εαυτου ANT","reference":{"chapter":6,"verse":1}},{"noteId":362,"caller":"+","text":"εν τη συναγωγη διδασκειν ¦ διδασκειν εν τη συναγωγη ECM† NA SBL WH","reference":{"chapter":6,"verse":2}},{"noteId":363,"caller":"+","text":"πολλοι 98.8% ¦ οι πολλοι ECM† SBL WH 0.9%","reference":{"chapter":6,"verse":2}},{"noteId":364,"caller":"+","text":"αυτω ¦ τουτω CT","reference":{"chapter":6,"verse":2}},{"noteId":365,"caller":"+","text":"και ¦ οτι και TR","reference":{"chapter":6,"verse":2}},{"noteId":366,"caller":"+","text":"δυναμεις ¦ αι δυναμεις CT","reference":{"chapter":6,"verse":2}},{"noteId":367,"caller":"+","text":"γινονται ¦ γινομεναι ECM NA SBL WH ¦ γεινονται TH","reference":{"chapter":6,"verse":2}},{"noteId":368,"caller":"+","text":"μαριας ¦ της μαριας ANT CT","reference":{"chapter":6,"verse":3}},{"noteId":369,"caller":"+","text":"αδελφος δε ¦ και αδελφος CT","reference":{"chapter":6,"verse":3}},{"noteId":370,"caller":"+","text":"ιωση 97.4% ¦ ιωσητος CT 1.2%","reference":{"chapter":6,"verse":3}},{"noteId":371,"caller":"+","text":"ελεγε δε ¦ και ελεγεν CT","reference":{"chapter":6,"verse":4}},{"noteId":372,"caller":"+","text":"συγγενεσι ¦ συγγενευσιν αυτου CT","reference":{"chapter":6,"verse":4}},{"noteId":373,"caller":"+","text":"ηδυνατο ¦ εδυνατο CT","reference":{"chapter":6,"verse":5}},{"noteId":374,"caller":"+","text":"ουδεμιαν δυναμιν ποιησαι ¦ ποιησαι ουδεμιαν δυναμιν ECM NA SBL WH","reference":{"chapter":6,"verse