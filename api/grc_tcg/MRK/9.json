{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"MRK","translationId":"grc_tcg","name":"ΚΑΤΑ ΜΑΡΚΟΝ","commonName":"ΚΑΤΑ ΜΑΡΚΟΝ","title":"ΚΑΤΑ ΜΑΡΚΟΝ","order":41,"numberOfChapters":16,"sha256":"458ddb37b7c88bd21fa977538125daa8129b125491fad25357901af5ebb1abc8","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/MRK/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/grc_tcg/MRK/16.json","totalNumberOfVerses":678},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":["Καὶ ἔλεγεν αὐτοῖς,",{"text":"Ἀμὴν λέγω ὑμῖν ὅτι εἰσί τινες","wordsOfJesus":true},{"noteId":610},{"text":"τῶν ὧδε ἑστηκότων, οἵτινες οὐ μὴ γεύσωνται θανάτου, ἕως ἂν ἴδωσι τὴν βασιλείαν τοῦ Θεοῦ ἐληλυθυῖαν ἐν δυνάμει.","wordsOfJesus":true}]},{"type":"heading","content":["The Transfiguration"]},{"type":"verse","number":2,"content":["Καὶ",{"noteId":611},"μεθ᾽ ἡμέρας ἓξ παραλαμβάνει ὁ Ἰησοῦς τὸν Πέτρον καὶ τὸν Ἰάκωβον καὶ",{"noteId":612},"Ἰωάννην, καὶ ἀναφέρει αὐτοὺς εἰς ὄρος ὑψηλὸν κατ᾽ ἰδίαν μόνους. Καὶ μετεμορφώθη ἔμπροσθεν αὐτῶν,"]},{"type":"verse","number":3,"content":["καὶ τὰ ἱμάτια αὐτοῦ",{"noteId":613},"ἐγένοντο στίλβοντα, λευκὰ λίαν",{"noteId":614},"ὡς χιών, οἷα",{"noteId":615},"γναφεὺς ἐπὶ τῆς γῆς οὐ δύναται",{"noteId":616},"λευκᾶναι."]},{"type":"verse","number":4,"content":["Καὶ ὤφθη αὐτοῖς",{"noteId":617},"Ἠλίας σὺν",{"noteId":618},"Μωσῇ, καὶ ἦσαν",{"noteId":619},"συλλαλοῦντες τῷ Ἰησοῦ."]},{"type":"verse","number":5,"content":["Καὶ ἀποκριθεὶς ὁ Πέτρος λέγει τῷ Ἰησοῦ,",{"noteId":620},"Ῥαββί, καλόν ἐστιν ἡμᾶς ὧδε εἶναι· καὶ ποιήσωμεν",{"noteId":621},"σκηνὰς τρεῖς, σοὶ μίαν, καὶ",{"noteId":622},"Μωσῇ μίαν, καὶ",{"noteId":623},"Ἠλίᾳ μίαν."]},{"type":"verse","number":6,"content":["Οὐ γὰρ ᾔδει τί",{"noteId":624},"λαλήσει·",{"noteId":625},"ἦσαν γὰρ ἔκφοβοι."]},{"type":"verse","number":7,"content":["Καὶ ἐγένετο νεφέλη ἐπισκιάζουσα αὐτοῖς· καὶ",{"noteId":626},"ἦλθε φωνὴ ἐκ τῆς",{"noteId":627},"νεφέλης, Οὗτός ἐστιν ὁ υἱός μου ὁ ἀγαπητός·",{"noteId":628},"αὐτοῦ ἀκούετε."]},{"type":"verse","number":8,"content":["Καὶ ἐξάπινα περιβλεψάμενοι, οὐκέτι οὐδένα εἶδον,",{"noteId":629},"ἀλλὰ τὸν Ἰησοῦν μόνον μεθ᾽ ἑαυτῶν."]},{"type":"verse","number":9,"content":[{"noteId":630},"Καταβαινόντων δὲ αὐτῶν",{"noteId":631},"ἀπὸ τοῦ ὄρους, διεστείλατο αὐτοῖς ἵνα μηδενὶ",{"noteId":632},"διηγήσωνται ἃ εἶδον, εἰ μὴ ὅταν ὁ υἱὸς τοῦ ἀνθρώπου ἐκ νεκρῶν ἀναστῇ."]},{"type":"verse","number":10,"content":["Καὶ τὸν λόγον ἐκράτησαν πρὸς ἑαυτούς,",{"noteId":633},"συζητοῦντες τί ἐστι τὸ ἐκ νεκρῶν ἀναστῆναι."]},{"type":"verse","number":11,"content":["Καὶ ἐπηρώτων αὐτόν, λέγοντες ὅτι Λέγουσιν οἱ γραμματεῖς ὅτι",{"noteId":634},"Ἠλίαν δεῖ ἐλθεῖν πρῶτον;"]},{"type":"verse","number":12,"content":["Ὁ δὲ",{"noteId":635},"ἀποκριθείς, εἶπεν αὐτοῖς,",{"noteId":636},{"text":"Ἠλίας μὲν ἐλθὼν πρῶτον,","wordsOfJesus":true},{"noteId":637},{"text":"ἀποκαθιστᾷ πάντα· καὶ πῶς γέγραπται ἐπὶ τὸν υἱὸν τοῦ ἀνθρώπου, ἵνα πολλὰ πάθῃ καὶ","wordsOfJesus":true},{"noteId":638},{"text":"ἐξουδενωθῇ.","wordsOfJesus":true}]},{"type":"verse","number":13,"content":[{"text":"Ἀλλὰ λέγω ὑμῖν ὅτι καὶ","wordsOfJesus":true},{"noteId":639},{"text":"Ἠλίας ἐλήλυθε, καὶ ἐποίησαν αὐτῷ ὅσα","wordsOfJesus":true},{"noteId":640},{"text":"ἠθέλησαν, καθὼς γέγραπται ἐπ᾽ αὐτόν.","wordsOfJesus":true}]},{"type":"heading","content":["Jesus Heals a Boy with an Unclean Spirit"]},{"type":"verse","number":14,"content":["Καὶ",{"noteId":641},"ἐλθὼν πρὸς τοὺς μαθητάς, εἶδεν ὄχλον πολὺν περὶ αὐτούς, καὶ γραμματεῖς",{"noteId":642},"συζητοῦντας",{"noteId":643},"αὐτοῖς."]},{"type":"verse","number":15,"content":["Καὶ",{"noteId":644},"εὐθέως πᾶς ὁ ὄχλος",{"noteId":645},"ἰδὼν αὐτὸν ἐξεθαμβήθη, καὶ προστρέχοντες ἠσπάζοντο αὐτόν."]},{"type":"verse","number":16,"content":["Καὶ ἐπηρώτησε",{"noteId":646},"τοὺς γραμματεῖς,",{"text":"Τί","wordsOfJesus":true},{"noteId":647},{"text":"συζητεῖτε πρὸς","wordsOfJesus":true},{"noteId":648},{"text":"αὐτούς;","wordsOfJesus":true}]},{"type":"verse","number":17,"content":["Καὶ",{"noteId":649},"ἀποκριθεὶς εἷς ἐκ τοῦ ὄχλου εἶπε, Διδάσκαλε, ἤνεγκα τὸν υἱόν μου πρός σε, ἔχοντα πνεῦμα ἄλαλον."]},{"type":"verse","number":18,"content":["Καὶ ὅπου",{"noteId":650},"ἂν αὐτὸν καταλάβῃ, ῥήσσει αὐτόν· καὶ ἀφρίζει, καὶ τρίζει τοὺς ὀδόντας",{"noteId":651},"αὐτοῦ, καὶ ξηραίνεται· καὶ",{"noteId":652},"εἶπον τοῖς μαθηταῖς σου ἵνα αὐτὸ ἐκβάλωσι, καὶ οὐκ ἴσχυσαν."]},{"type":"verse","number":19,"content":["Ὁ δὲ ἀποκριθεὶς",{"noteId":653},"αὐτῷ λέγει,",{"text":"Ὦ γενεὰ ἄπιστος, ἕως πότε πρὸς ὑμᾶς ἔσομαι; Ἕως πότε ἀνέξομαι ὑμῶν; Φέρετε αὐτὸν πρός με.","wordsOfJesus":true}]},{"type":"verse","number":20,"content":["Καὶ ἤνεγκαν αὐτὸν πρὸς αὐτόν· καὶ",{"noteId":654},"ἰδὼν αὐτόν,",{"noteId":655},"εὐθέως τὸ πνεῦμα",{"noteId":656},"ἐσπάραξεν αὐτόν· καὶ πεσὼν ἐπὶ τῆς γῆς, ἐκυλίετο ἀφρίζων."]},{"type":"verse","number":21,"content":["Καὶ ἐπηρώτησε τὸν πατέρα αὐτοῦ,",{"text":"Πόσος χρόνος ἐστίν,","wordsOfJesus":true},{"noteId":657},{"text":"ὡς τοῦτο γέγονεν αὐτῷ;","wordsOfJesus":true},"Ὁ δὲ εἶπε,",{"noteId":658},"Παιδιόθεν."]},{"type":"verse","number":22,"content":["Καὶ πολλάκις",{"noteId":659},"αὐτὸν καὶ εἰς τὸ πῦρ ἔβαλε καὶ εἰς ὕδατα, ἵνα ἀπολέσῃ αὐτόν· ἀλλ᾽ εἴ τι",{"noteId":660},"δύνασαι, βοήθησον ἡμῖν, σπλαγχνισθεὶς ἐφ᾽ ἡμᾶς."]},{"type":"verse","number":23,"content":["Ὁ δὲ Ἰησοῦς εἶπεν αὐτῷ,",{"text":"Τὸ εἰ","wordsOfJesus":true},{"noteId":661},{"text":"δύνασαι πιστεῦσαι, πάντα δυνατὰ τῷ πιστεύοντι.","wordsOfJesus":true}]},{"type":"verse","number":24,"content":[{"noteId":662},"Καὶ",{"noteId":663},"εὐθέως κράξας ὁ πατὴρ τοῦ παιδίου,",{"noteId":664},"μετὰ δακρύων ἔλεγε, Πιστεύω,",{"noteId":665},"Κύριε, βοήθει μου τῇ ἀπιστίᾳ."]},{"type":"verse","number":25,"content":["Ἰδὼν δὲ ὁ Ἰησοῦς ὅτι ἐπισυντρέχει",{"noteId":666},"ὄχλος, ἐπετίμησε τῷ πνεύματι τῷ ἀκαθάρτῳ, λέγων αὐτῷ,",{"text":"Τὸ","wordsOfJesus":true},{"noteId":667},{"text":"πνεῦμα τὸ ἄλαλον καὶ κωφόν, ἐγώ","wordsOfJesus":true},{"noteId":668},{"text":"σοι ἐπιτάσσω, ἔξελθε ἐξ αὐτοῦ, καὶ μηκέτι εἰσέλθῃς εἰς αὐτόν.","wordsOfJesus":true}]},{"type":"verse","number":26,"content":["Καὶ",{"noteId":669},"κράξαν, καὶ πολλὰ σπαράξαν",{"noteId":670},"αὐτόν, ἐξῆλθε· καὶ ἐγένετο ὡσεὶ νεκρός, ὥστε",{"noteId":671},"πολλοὺς λέγειν ὅτι ἀπέθανεν."]},{"type":"verse","number":27,"content":["Ὁ δὲ Ἰησοῦς κρατήσας",{"noteId":672},"αὐτὸν τῆς χειρός, ἤγειρεν αὐτόν· καὶ ἀνέστη."]},{"type":"verse","number":28,"content":["Καὶ",{"noteId":673},"εἰσελθόντα αὐτὸν εἰς οἶκον, οἱ μαθηταὶ αὐτοῦ",{"noteId":674},"ἐπηρώτων αὐτὸν κατ᾽ ἰδίαν ὅτι Ἡμεῖς οὐκ ἠδυνήθημεν ἐκβαλεῖν αὐτό;"]},{"type":"verse","number":29,"content":["Καὶ εἶπεν αὐτοῖς,",{"text":"Τοῦτο τὸ γένος ἐν οὐδενὶ δύναται ἐξελθεῖν, εἰ μὴ ἐν προσευχῇ","wordsOfJesus":true},{"noteId":675},{"text":"καὶ νηστείᾳ.","wordsOfJesus":true}]},{"type":"heading","content":["Jesus Predicts His Death and Resurrection a Second Time"]},{"type":"verse","number":30,"content":[{"noteId":676},"Καὶ ἐκεῖθεν ἐξελθόντες",{"noteId":677},"παρεπορεύοντο διὰ τῆς Γαλιλαίας· καὶ οὐκ ἤθελεν ἵνα τις",{"noteId":678},"γνῷ."]},{"type":"verse","number":31,"content":["Ἐδίδασκε γὰρ τοὺς μαθητὰς αὐτοῦ, καὶ ἔλεγεν αὐτοῖς ὅτι",{"text":"Ὁ υἱὸς τοῦ ἀνθρώπου παραδίδοται εἰς χεῖρας ἀνθρώπων, καὶ ἀποκτενοῦσιν αὐτόν· καὶ ἀποκτανθείς,","wordsOfJesus":true},{"noteId":679},{"text":"τῇ τρίτῃ ἡμέρᾳ ἀναστήσεται.","wordsOfJesus":true}]},{"type":"verse","number":32,"content":["Οἱ δὲ ἠγνόουν τὸ ῥῆμα, καὶ ἐφοβοῦντο αὐτὸν ἐπερωτῆσαι."]},{"type":"heading","content":["True Greatness"]},{"type":"verse","number":33,"content":["Καὶ",{"noteId":680},"ἦλθεν εἰς",{"noteId":681},"Καπερναούμ· καὶ ἐν τῇ οἰκίᾳ γενόμενος ἐπηρώτα αὐτούς,",{"text":"Τί ἐν τῇ ὁδῷ","wordsOfJesus":true},{"noteId":682},{"text":"πρὸς ἑαυτοὺς διελογίζεσθε;","wordsOfJesus":true}]},{"type":"verse","number":34,"content":["Οἱ δὲ ἐσιώπων· πρὸς ἀλλήλους γὰρ διελέχθησαν ἐν τῇ ὁδῷ, τίς μείζων."]},{"type":"verse","number":35,"content":["Καὶ καθίσας ἐφώνησε τοὺς δώδεκα, καὶ λέγει αὐτοῖς,",{"text":"Εἴ τις θέλει πρῶτος εἶναι, ἔσται πάντων ἔσχατος, καὶ πάντων διάκονος.","wordsOfJesus":true}]},{"type":"verse","number":36,"content":["Καὶ λαβὼν παιδίον, ἔστησεν αὐτὸ ἐν μέσῳ αὐτῶν· καὶ ἐναγκαλισάμενος αὐτό, εἶπεν αὐτοῖς·"]},{"type":"verse","number":37,"content":[{"text":"Ὃς","wordsOfJesus":true},{"noteId":683},{"text":"ἐὰν ἓν τῶν τοιούτων παιδίων δέξηται ἐπὶ τῷ ὀνόματί μου, ἐμὲ δέχεται· καὶ ὃς","wordsOfJesus":true},{"noteId":684},{"text":"ἐὰν ἐμὲ","wordsOfJesus":true},{"noteId":685},{"text":"δέξηται, οὐκ ἐμὲ δέχεται, ἀλλὰ τὸν ἀποστείλαντά με.","wordsOfJesus":true}]},{"type":"heading","content":["Whoever Is Not Against You Is for You"]},{"type":"verse","number":38,"content":[{"noteId":686},"Ἀπεκρίθη",{"noteId":687},"δὲ αὐτῷ",{"noteId":688},"Ἰωάννης,",{"noteId":689},"λέγων, Διδάσκαλε,",{"noteId":690},"εἴδομέν τινα",{"noteId":691},"τῷ ὀνόματί σου ἐκβάλλοντα δαιμόνια,",{"noteId":692},"ὃς οὐκ ἀκολουθεῖ ἡμῖν· καὶ ἐκωλύσαμεν αὐτόν, ὅτι οὐκ ἀκολουθεῖ ἡμῖν."]},{"type":"verse","number":39,"content":["Ὁ δὲ Ἰησοῦς εἶπε,",{"text":"Μὴ κωλύετε αὐτόν· οὐδεὶς γάρ ἐστιν ὃς ποιήσει δύναμιν ἐπὶ τῷ ὀνόματί μου, καὶ δυνήσεται ταχὺ κακολογῆσαί με.","wordsOfJesus":true}]},{"type":"verse","number":40,"content":[{"text":"Ὃς γὰρ οὐκ ἔστι καθ᾽","wordsOfJesus":true},{"noteId":693},{"text":"ὑμῶν ὑπὲρ ὑμῶν ἐστιν.","wordsOfJesus":true}]},{"type":"verse","number":41,"content":[{"text":"Ὃς γὰρ ἂν ποτίσῃ ὑμᾶς ποτήριον ὕδατος ἐν","wordsOfJesus":true},{"noteId":694},{"text":"ὀνόματί μου, ὅτι Χριστοῦ ἐστε, ἀμὴν λέγω","wordsOfJesus":true},{"noteId":695},{"text":"ὑμῖν, οὐ μὴ ἀπολέσῃ τὸν μισθὸν αὐτοῦ.","wordsOfJesus":true}]},{"type":"heading","content":["Temptations to Sin"]},{"type":"verse","number":42,"content":[{"text":"Καὶ ὃς","wordsOfJesus":true},{"noteId":696},{"text":"ἐὰν σκανδαλίσῃ ἕνα τῶν","wordsOfJesus":true},{"noteId":697},{"text":"μικρῶν τῶν πιστευόντων","wordsOfJesus":true},{"noteId":698},{"text":"εἰς ἐμέ, καλόν ἐστιν αὐτῷ μᾶλλον εἰ περίκειται","wordsOfJesus":true},{"noteId":699},{"text":"λίθος μυλικὸς περὶ τὸν τράχηλον αὐτοῦ, καὶ βέβληται εἰς τὴν θάλασσαν.","wordsOfJesus":true}]},{"type":"verse","number":43,"content":[{"text":"Καὶ ἐὰν","wordsOfJesus":true},{"noteId":700},{"text":"σκανδαλίζῃ σε ἡ χείρ σου, ἀπόκοψον αὐτήν· καλόν","wordsOfJesus":true},{"noteId":701},{"text":"σοί ἐστι κυλλὸν","wordsOfJesus":true},{"noteId":702},{"text":"εἰς τὴν ζωὴν εἰσελθεῖν, ἢ τὰς δύο χεῖρας ἔχοντα ἀπελθεῖν εἰς τὴν γέενναν, εἰς τὸ πῦρ τὸ ἄσβεστον,","wordsOfJesus":true}]},{"type":"verse","number":44,"content":[{"noteId":703},{"text":"ὅπου ὁ σκώληξ αὐτῶν οὐ τελευτᾷ, καὶ τὸ πῦρ οὐ σβέννυται.","wordsOfJesus":true}]},{"type":"verse","number":45,"content":[{"text":"Καὶ ἐὰν ὁ πούς σου σκανδαλίζῃ σε, ἀπόκοψον αὐτόν· καλόν","wordsOfJesus":true},{"noteId":704},{"text":"ἐστί σοι εἰσελθεῖν εἰς τὴν ζωὴν χωλόν, ἢ τοὺς δύο πόδας ἔχοντα βληθῆναι εἰς τὴν γέενναν,","wordsOfJesus":true},{"noteId":705},{"text":"εἰς τὸ πῦρ τὸ ἄσβεστον,","wordsOfJesus":true}]},{"type":"verse","number":46,"content":[{"text":"ὅπου ὁ σκώληξ αὐτῶν οὐ τελευτᾷ, καὶ τὸ πῦρ οὐ σβέννυται.","wordsOfJesus":true}]},{"type":"verse","number":47,"content":[{"text":"Καὶ ἐὰν ὁ ὀφθαλμός σου σκανδαλίζῃ σε, ἔκβαλε αὐτόν· καλόν","wordsOfJesus":true},{"noteId":706},{"text":"σοί ἐστι μονόφθαλμον εἰσελθεῖν εἰς τὴν βασιλείαν τοῦ Θεοῦ, ἢ","wordsOfJesus":true},{"noteId":707},{"text":"δύο ὀφθαλμοὺς ἔχοντα","wordsOfJesus":true},{"noteId":708},{"text":"βληθῆναι εἰς","wordsOfJesus":true},{"noteId":709},{"text":"τὴν γέενναν","wordsOfJesus":true},{"noteId":710},{"text":"τοῦ πυρός,","wordsO