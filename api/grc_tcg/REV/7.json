{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"REV","translationId":"grc_tcg","name":"ΑΠΟΚΑΛΥΨΙΣ ΙΩΑΝΝΟΥ","commonName":"ΑΠΟΚΑΛΥΨΙΣ ΙΩΑΝΝΟΥ","title":"ΑΠΟΚΑΛΥΨΙΣ ΙΩΑΝΝΟΥ","order":66,"numberOfChapters":22,"sha256":"b8cde07744883305d1c3df17767c68ef381fa56db096bff775036b9086270dbc","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/grc_tcg/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":7,"content":[{"type":"heading","content":["The Sealing of the 144,000"]},{"type":"verse","number":1,"content":[{"noteId":300},"Καὶ μετὰ",{"noteId":301},"τοῦτο εἶδον τέσσαρας ἀγγέλους ἑστῶτας ἐπὶ τὰς τέσσαρας γωνίας τῆς γῆς, κρατοῦντας τοὺς τέσσαρας ἀνέμους τῆς γῆς, ἵνα μὴ πνέῃ ἄνεμος ἐπὶ τῆς γῆς μήτε ἐπὶ τῆς θαλάσσης μήτε ἐπί",{"noteId":302},"τι δένδρον."]},{"type":"verse","number":2,"content":["Καὶ εἶδον ἄλλον ἄγγελον",{"noteId":303},"ἀναβαίνοντα ἀπὸ ἀνατολῆς ἡλίου, ἔχοντα σφραγῖδα Θεοῦ ζῶντος. Καὶ ἔκραξε φωνῇ μεγάλῃ τοῖς τέσσαρσιν ἀγγέλοις, οἷς ἐδόθη αὐτοῖς ἀδικῆσαι τὴν γῆν καὶ τὴν θάλασσαν,"]},{"type":"verse","number":3,"content":["λέγων, Μὴ ἀδικήσητε τὴν γῆν μήτε τὴν θάλασσαν μήτε τὰ δένδρα,",{"noteId":304},"ἄχρις οὗ",{"noteId":305},"σφραγίσωμεν τοὺς δούλους τοῦ Θεοῦ ἡμῶν ἐπὶ τῶν μετώπων αὐτῶν."]},{"type":"verse","number":4,"content":["Καὶ ἤκουσα τὸν ἀριθμὸν τῶν ἐσφραγισμένων,",{"noteId":306},"ἑκατὸν καὶ τεσσαράκοντα τέσσαρες χιλιάδες,",{"noteId":307},"ἐσφραγισμένων ἐκ πάσης φυλῆς υἱῶν Ἰσραήλ·"]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ἐκ φυλῆς Ἰούδα","poem":1},{"noteId":308},{"text":"δώδεκα χιλιάδες","poem":1},{"noteId":309},{"text":"ἐσφραγισμέναι,","poem":1},{"lineBreak":true},{"text":"ἐκ φυλῆς","poem":1},{"noteId":310},{"text":"Ῥουβὶμ","poem":1},{"noteId":311},{"text":"δώδεκα","poem":1},{"noteId":312},{"text":"χιλιάδες,","poem":1},{"lineBreak":true},{"text":"ἐκ φυλῆς Γὰδ","poem":1},{"noteId":313},{"text":"δώδεκα","poem":1},{"noteId":314},{"text":"χιλιάδες,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ἐκ φυλῆς Ἀσὴρ","poem":1},{"noteId":315},{"text":"δώδεκα","poem":1},{"noteId":316},{"text":"χιλιάδες,","poem":1},{"lineBreak":true},{"text":"ἐκ φυλῆς","poem":1},{"noteId":317},{"text":"Νεφθαλεὶμ","poem":1},{"noteId":318},{"text":"δώδεκα","poem":1},{"noteId":319},{"text":"χιλιάδες,","poem":1},{"lineBreak":true},{"text":"ἐκ φυλῆς Μανασσῆ","poem":1},{"noteId":320},{"text":"δώδεκα","poem":1},{"noteId":321},{"text":"χιλιάδες,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ἐκ φυλῆς Συμεὼν","poem":1},{"noteId":322},{"text":"δώδεκα","poem":1},{"noteId":323},{"text":"χιλιάδες,","poem":1},{"lineBreak":true},{"text":"ἐκ φυλῆς","poem":1},{"noteId":324},{"text":"Λευῒ","poem":1},{"noteId":325},{"text":"δώδεκα","poem":1},{"noteId":326},{"text":"χιλιάδες,","poem":1},{"lineBreak":true},{"text":"ἐκ φυλῆς","poem":1},{"noteId":327},{"text":"Ἰσαχὰρ","poem":1},{"noteId":328},{"text":"δώδεκα","poem":1},{"noteId":329},{"text":"χιλιάδες,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ἐκ φυλῆς Ζαβουλὼν","poem":1},{"noteId":330},{"text":"δώδεκα","poem":1},{"noteId":331},{"text":"χιλιάδες,","poem":1},{"lineBreak":true},{"text":"ἐκ φυλῆς Ἰωσὴφ","poem":1},{"noteId":332},{"text":"δώδεκα","poem":1},{"noteId":333},{"text":"χιλιάδες,","poem":1},{"lineBreak":true},{"text":"ἐκ φυλῆς","poem":1},{"noteId":334},{"text":"Βενιαμὶν","poem":1},{"noteId":335},{"text":"δώδεκα χιλιάδες","poem":1},{"noteId":336},{"text":"ἐσφραγισμέναι.","poem":1}]},{"type":"heading","content":["Praise from the Great Multitude"]},{"type":"verse","number":9,"content":["Μετὰ ταῦτα",{"noteId":337},"εἶδον, καὶ ἰδού, ὄχλος πολύς, ὃν",{"noteId":338},"ἀριθμῆσαι οὐδεὶς",{"noteId":339},"ἐδύνατο, ἐκ παντὸς ἔθνους καὶ φυλῶν καὶ λαῶν καὶ γλωσσῶν,",{"noteId":340},"ἑστῶτας ἐνώπιον τοῦ θρόνου καὶ ἐνώπιον τοῦ ἀρνίου, περιβεβλημένους στολὰς λευκάς, καὶ",{"noteId":341},"φοίνικας ἐν ταῖς χερσὶν αὐτῶν."]},{"type":"verse","number":10,"content":["Καὶ",{"noteId":342},"κράζουσι φωνῇ μεγάλῃ, λέγοντες, Ἡ",{"noteId":343},"σωτηρία τῷ Θεῷ ἡμῶν τῷ καθημένῳ ἐπὶ τῷ θρόνῳ, καὶ τῷ ἀρνίῳ."]},{"type":"verse","number":11,"content":["Καὶ πάντες οἱ ἄγγελοι",{"noteId":344},"εἱστήκεισαν κύκλῳ τοῦ θρόνου καὶ τῶν πρεσβυτέρων καὶ τῶν τεσσάρων ζῴων, καὶ",{"noteId":345},"ἔπεσον ἐνώπιον τοῦ θρόνου",{"noteId":346},"αὐτοῦ ἐπὶ",{"noteId":347},"τὰ πρόσωπα αὐτῶν καὶ προσεκύνησαν τῷ Θεῷ,"]},{"type":"verse","number":12,"content":["λέγοντες,",{"lineBreak":true},{"text":"Ἀμήν· ἡ εὐλογία καὶ ἡ δόξα καὶ ἡ σοφία","poem":1},{"lineBreak":true},{"text":"καὶ ἡ εὐχαριστία καὶ ἡ τιμὴ","poem":1},{"lineBreak":true},{"text":"καὶ ἡ δύναμις καὶ ἡ ἰσχὺς","poem":1},{"lineBreak":true},{"text":"τῷ Θεῷ ἡμῶν εἰς τοὺς αἰῶνας τῶν αἰώνων. Ἀμήν.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":["Καὶ ἀπεκρίθη εἷς ἐκ τῶν πρεσβυτέρων, λέγων μοι, Οὗτοι οἱ περιβεβλημένοι τὰς στολὰς τὰς λευκάς, τίνες εἰσὶ καὶ πόθεν ἦλθον;"]},{"type":"verse","number":14,"content":["Καὶ",{"noteId":348},"εἶπον αὐτῷ, Κύριέ",{"noteId":349},"μου, σὺ οἶδας. Καὶ εἶπέ μοι, Οὗτοί εἰσιν οἱ ἐρχόμενοι ἐκ τῆς θλίψεως τῆς μεγάλης, καὶ",{"noteId":350},"ἔπλυναν τὰς στολὰς αὐτῶν καὶ",{"noteId":351},"ἐλεύκαναν ἐν τῷ αἵματι τοῦ ἀρνίου."]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Διὰ τοῦτό εἰσιν ἐνώπιον τοῦ θρόνου τοῦ Θεοῦ,","poem":1},{"lineBreak":true},{"text":"καὶ λατρεύουσιν αὐτῷ ἡμέρας καὶ νυκτὸς ἐν τῷ ναῷ αὐτοῦ,","poem":1},{"lineBreak":true},{"text":"καὶ ὁ καθήμενος ἐπὶ","poem":1},{"noteId":352},{"text":"τῷ θρόνῳ σκηνώσει ἐπ᾽ αὐτούς.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Οὐ πεινάσουσιν ἔτι οὐδὲ διψήσουσιν","poem":1},{"noteId":353},{"text":"ἔτι,","poem":1},{"lineBreak":true},{"noteId":354},{"text":"οὐδ᾽ οὐ μὴ πέσῃ ἐπ᾽ αὐτοὺς ὁ ἥλιος οὐδὲ πᾶν καῦμα·","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ὅτι τὸ ἀρνίον τὸ ἀνὰ μέσον τοῦ θρόνου","poem":1},{"noteId":355},{"text":"ποιμαίνει αὐτούς,","poem":1},{"lineBreak":true},{"text":"καὶ","poem":1},{"noteId":356},{"text":"ὁδηγεῖ αὐτοὺς ἐπὶ","poem":1},{"noteId":357},{"text":"ζωῆς πηγὰς ὑδάτων,","poem":1},{"lineBreak":true},{"text":"καὶ ἐξαλείψει ὁ Θεὸς πᾶν δάκρυον","poem":1},{"noteId":358},{"text":"ἐκ τῶν ὀφθαλμῶν αὐτῶν.","poem":1}]}],"footnotes":[{"noteId":300,"caller":"+","text":"και 𝔐A,C,K [94.4%] ¦ — NA SBL TH WH [5.6%]","reference":{"chapter":7,"verse":1}},{"noteId":301,"caller":"+","text":"τουτο 𝔐C,K [66.5%] ¦ ταυτα 𝔐A TR [33%]","reference":{"chapter":7,"verse":1}},{"noteId":302,"caller":"+","text":"τι 𝔐K [54.2%] ¦ παν 𝔐A,C ANT ECM† NA PCK SBL TH TR WH [42.1%]","reference":{"chapter":7,"verse":1}},{"noteId":303,"caller":"+","text":"αναβαινοντα 𝔐A,C,K [97.2%] ¦ αναβαντα ST [2.8%]","reference":{"chapter":7,"verse":2}},{"noteId":304,"caller":"+","text":"αχρις ου 𝔐A(13),C,K [75.6%] ¦ αχρι 𝔐A(19) CT [14.3%] ¦ αχρις αν 𝔐A(14) [9.2%]","reference":{"chapter":7,"verse":3}},{"noteId":305,"caller":"+","text":"σφραγισωμεν 𝔐A,C,K [84.7%] ¦ σφραγισομεν MSS [13.8%] ¦ σφραγιζωμεν ST [0%] {Note: ECM does not collate spelling differences for this variant unit. Consequently, these spelling differences are calculated only from Hoskier's collation.}","reference":{"chapter":7,"verse":3}},{"noteId":306,"caller":"+","text":"εκατον και τεσσαρακοντα τεσσαρες 𝔐C,K(27) [33%] ¦ ρμδ΄ 𝔐A(23),K(19) ECM TR [25.1%] ¦ εκατον τεσσαρακοντα τεσσαρες 𝔐A(12)