{"translation":{"id":"grc_tcg","name":"Η Καινή Διαθήκη","website":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=grctcgnt","licenseNotes":null,"shortName":"TCG","englishName":"Text-Critical Greek NT","language":"grc","textDirection":"ltr","sha256":"15ef954ac63fa8bc7e2c4b9d5d65ac1e30c5d8246e6e8444b5ca570c480fa7bc","availableFormats":["json"],"listOfBooksApiLink":"/api/grc_tcg/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Ancient Greek","languageEnglishName":"Ancient Greek"},"book":{"id":"ROM","translationId":"grc_tcg","name":"ΠΡΟΣ ΡΩΜΑΙΟΥΣ","commonName":"ΠΡΟΣ ΡΩΜΑΙΟΥΣ","title":"ΠΡΟΣ ΡΩΜΑΙΟΥΣ","order":45,"numberOfChapters":16,"sha256":"00e2738e081ff70bab7ec4841885cd589d07746d1a9e8af73481e091b02ccda2","firstChapterNumber":1,"firstChapterApiLink":"/api/grc_tcg/ROM/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/grc_tcg/ROM/16.json","totalNumberOfVerses":433},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":["Τί οὖν τὸ περισσὸν τοῦ Ἰουδαίου, ἢ τίς ἡ",{"noteId":34},"ὠφέλεια τῆς περιτομῆς;"]},{"type":"verse","number":2,"content":["Πολὺ κατὰ πάντα τρόπον· πρῶτον μὲν γὰρ ὅτι ἐπιστεύθησαν τὰ λόγια τοῦ Θεοῦ."]},{"type":"verse","number":3,"content":["Τί γὰρ εἰ ἠπίστησάν τινες; Μὴ ἡ ἀπιστία αὐτῶν τὴν πίστιν τοῦ Θεοῦ καταργήσει;"]},{"type":"verse","number":4,"content":["Μὴ γένοιτο·",{"noteId":35},"γινέσθω δὲ ὁ Θεὸς ἀληθής, πᾶς δὲ ἄνθρωπος ψεύστης,",{"noteId":36},"καθὼς γέγραπται,",{"lineBreak":true},{"text":"Ὅπως ἂν δικαιωθῇς ἐν τοῖς λόγοις σου,","poem":1},{"lineBreak":true},{"text":"καὶ","poem":1},{"noteId":37},{"text":"νικήσῃς ἐν τῷ κρίνεσθαί σε.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":["Εἰ δὲ ἡ ἀδικία ἡμῶν Θεοῦ δικαιοσύνην συνίστησι, τί ἐροῦμεν; Μὴ ἄδικος ὁ Θεὸς ὁ ἐπιφέρων τὴν ὀργήν;—κατὰ ἄνθρωπον λέγω—"]},{"type":"verse","number":6,"content":["Μὴ γένοιτο· ἐπεὶ πῶς κρινεῖ ὁ Θεὸς τὸν κόσμον;"]},{"type":"verse","number":7,"content":["Εἰ",{"noteId":38},"γὰρ ἡ ἀλήθεια τοῦ Θεοῦ ἐν τῷ ἐμῷ ψεύσματι ἐπερίσσευσεν εἰς τὴν δόξαν αὐτοῦ, τί ἔτι κἀγὼ ὡς ἁμαρτωλὸς κρίνομαι;"]},{"type":"verse","number":8,"content":["Καὶ μή—καθὼς βλασφημούμεθα, καὶ καθώς φασί τινες ἡμᾶς λέγειν—ὅτι Ποιήσωμεν τὰ κακὰ ἵνα ἔλθῃ τὰ ἀγαθά; Ὧν τὸ κρίμα ἔνδικόν ἐστι."]},{"type":"heading","content":["No One is Righteous"]},{"type":"verse","number":9,"content":["Τί οὖν; Προεχόμεθα; Οὐ πάντως· προῃτιασάμεθα γὰρ Ἰουδαίους τε καὶ Ἕλληνας πάντας ὑφ᾽ ἁμαρτίαν εἶναι,"]},{"type":"verse","number":10,"content":["καθὼς γέγραπται",{"noteId":39},"ὅτι",{"lineBreak":true},{"text":"Οὐκ ἔστι δίκαιος οὐδὲ εἷς·","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"οὐκ ἔστιν","poem":1},{"noteId":40},{"text":"ὁ συνιῶν,","poem":1},{"lineBreak":true},{"text":"οὐκ ἔστιν","poem":1},{"noteId":41},{"text":"ὁ ἐκζητῶν τὸν Θεόν·","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"πάντες","poem":1},{"noteId":42},{"text":"ἐξέκλιναν, ἅμα","poem":1},{"noteId":43},{"text":"ἠχρειώθησαν·","poem":1},{"lineBreak":true},{"text":"οὐκ ἔστι","poem":1},{"noteId":44},{"text":"ποιῶν χρηστότητα,","poem":1},{"lineBreak":true},{"text":"οὐκ ἔστιν ἕως ἑνός·","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"τάφος ἀνεῳγμένος ὁ λάρυγξ αὐτῶν,","poem":1},{"lineBreak":true},{"text":"ταῖς γλώσσαις αὐτῶν ἐδολιοῦσαν·","poem":1},{"lineBreak":true},{"text":"ἰὸς ἀσπίδων ὑπὸ τὰ χείλη αὐτῶν·","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ὧν τὸ στόμα ἀρᾶς καὶ πικρίας γέμει·","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ὀξεῖς οἱ πόδες αὐτῶν ἐκχέαι αἷμα·","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"σύντριμμα καὶ ταλαιπωρία ἐν ταῖς ὁδοῖς αὐτῶν,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"καὶ ὁδὸν εἰρήνης οὐκ ἔγνωσαν·","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"οὐκ ἔστι φόβος Θεοῦ ἀπέναντι τῶν ὀφθαλμῶν αὐτῶν.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":["Οἴδαμεν δὲ ὅτι ὅσα ὁ νόμος λέγει, τοῖς ἐν τῷ νόμῳ λαλεῖ, ἵνα πᾶν στόμα φραγῇ, καὶ ὑπόδικος γένηται πᾶς ὁ κόσμος τῷ Θεῷ·"]},{"type":"verse","number":20,"content":["διότι ἐξ ἔργων νόμου οὐ δικαιωθήσεται πᾶσα σὰρξ ἐνώπιον αὐτοῦ· διὰ γὰρ νόμου ἐπίγνωσις ἁμαρτίας."]},{"type":"heading","content":["Justification by Faith"]},{"type":"verse","number":21,"content":["Νυνὶ δὲ χωρὶς νόμου δικαιοσύνη Θεοῦ πεφανέρωται, μαρτυρουμένη ὑπὸ τοῦ νόμου καὶ τῶν προφητῶν·"]},{"type":"verse","number":22,"content":["δικαιοσύνη δὲ Θεοῦ διὰ πίστεως Ἰησοῦ Χριστοῦ εἰς πάντας",{"noteId":45},"καὶ ἐπὶ πάντας τοὺς πιστεύοντας· οὐ γάρ ἐστι διαστολή·"]},{"type":"verse","number":23,"content":["πάντες γὰρ ἥμαρτον καὶ ὑστεροῦνται τῆς δόξης τοῦ Θεοῦ,"]},{"type":"verse","number":24,"content":["δικαιούμενοι δωρεὰν τῇ αὐτοῦ χάριτι διὰ τῆς ἀπολυτρώσεως τῆς ἐν Χριστῷ Ἰησοῦ·"]},{"type":"verse","number":25,"content":["ὃν προέθετο ὁ Θεὸς ἱλαστήριον, διὰ",{"noteId":46},"τῆς πίστεως, ἐν τῷ αὐτοῦ αἵματι, εἰς ἔνδειξιν τῆς δικαιοσύνης αὐτοῦ, διὰ τὴν πάρεσιν τῶν προγεγονότων ἁμαρτημάτων,"]},{"type":"verse","number":26,"content":["ἐν τῇ ἀνοχῇ τοῦ Θεοῦ· πρὸς",{"noteId":47},"ἔνδειξιν τῆς δικαιοσύνης αὐτοῦ ἐν τῷ νῦν καιρῷ, εἰς τὸ εἶναι αὐτὸν δίκαιον καὶ δικαιοῦντα τὸν ἐκ πίστεως Ἰησοῦ."]},{"type":"verse","number":27,"content":["Ποῦ οὖν ἡ καύχησις; Ἐξεκλείσθη. Διὰ ποίου νόμου; Τῶν ἔργων; Οὐχί, ἀλλὰ διὰ νόμου πίστεως."]},{"type":"verse","number":28,"content":["Λογιζόμεθα",{"noteId":48},"οὖν",{"noteId":49},"πίστει δικαιοῦσθαι ἄνθρωπον, χωρὶς ἔργων νόμου."]},{"type":"verse","number":29,"content":["Ἢ Ἰουδαίων ὁ Θεὸς μόνον; Οὐχὶ",{"noteId":50},"δὲ καὶ ἐθνῶν; Ναὶ καὶ ἐθνῶν·"]},{"type":"verse","number":30,"content":[{"noteId":51},"ἐπείπερ εἷς ὁ Θεός, ὃς δικαιώσει περιτομὴν ἐκ πίστεως, καὶ ἀκροβυστίαν διὰ τῆς πίστεως."]},{"type":"verse","number":31,"content":["Νόμον οὖν καταργοῦμεν διὰ τῆς πίστεως; Μὴ γένοιτο· ἀλλὰ νόμον",{"noteId":52},"ἱστῶμεν."]}],"footnotes":[{"noteId":34,"caller":"+","text":"ωφελεια ¦ ωφελια WH","reference":{"chapter":3,"verse":1}},{"noteId":35,"caller":"+","text":"γινεσθω ¦ γεινεσθω TH","reference":{"chapter":3,"verse":4}},{"noteId":36,"caller":"+","text":"καθως ¦ καθαπερ WH","reference":{"chapter":3,"verse":4}},{"noteId":37,"caller":"+","text":"νικησης ¦ νικησεις 𝔐pt ANT CT","reference":{"chapter":3,"verse":4}},{"noteId":38,"caller":"+","text":"γαρ ¦ δε NA SBL WH","reference":{"chapter":3,"verse":7}},{"noteId":39,"caller":"+","text":"οτι ¦ — 𝔐pt PCK","reference":{"chapter":3,"verse":10}},{"noteId":40,"caller":"+","text":"ο ¦ — WH","reference":{"chapter":3,"verse":11}},{"noteId":41,"caller":"+","text":"ο ¦ — WH","reference":{"chapter":3,"verse":11}},{"noteId":42,"caller":"+","text":"εξεκλιναν ¦ εξεκλειναν TH","reference":{"chapter":3,"verse":12}},{"noteId":43,"caller":"+","text":"ηχρειωθησαν ¦ ηχρεωθησαν CT","reference":{"chapter":3,"verse":12}},{"noteId":44,"caller":"+","text":"ποιων ¦ ο ποιων NA","reference":{"chapter":3,"verse":12}},{"noteId":45,"caller":"+","text":"και επι παντας 92.6% ¦ — CT 6.6%","reference":{"chapter":3,"verse":22}},{"noteId":46,"caller":"+","text":"της ¦ — SBL WH","reference":{"chapter":3,"verse":25}},{"noteId":47,"caller":"+","text":"ενδειξιν ¦ την ενδειξιν CT","reference":{"chapter":3,"verse":26}},{"noteId":48,"caller":"+","text":"ουν ¦ γαρ CT","reference":{"chapter":3,"verse":28}},{"noteId":49,"caller":"+","text":"πιστει δικαιουσθαι ¦ δικαιουσθαι πιστει CT","reference":{"chapter":3,"verse":28}},{"noteId":50,"caller":"+","text":"δε ¦ — CT","reference":{"chapter":3,"verse":29}},{"noteId":51,"caller":"+","text":"επειπερ ¦ ειπερ CT","reference":{"chapter":3,"verse":30}},{"noteId":52,"caller":"+","text":"ιστωμεν ¦ ιστανομεν CT","reference":{"chapter":3,"verse":31}}]},"thisChapterLink":"/api/grc_tcg/ROM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/grc_tcg/ROM/4