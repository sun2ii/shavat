{"translation":{"id":"gub_wbt","name":"Tupàn ze'eg","website":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseNotes":null,"shortName":"WBT","englishName":"Guajajára Bible","language":"gub","textDirection":"ltr","sha256":"3d4a3e2f7a24aced78ab83f61e9c17b701cb6fe81ec074d544d45e4278d1f657","availableFormats":["json"],"listOfBooksApiLink":"/api/gub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30186,"languageName":"Guajajára","languageEnglishName":"Guajajára"},"book":{"id":"JOB","translationId":"gub_wbt","name":"IZO","commonName":"IZO","title":"IZO","order":18,"numberOfChapters":42,"sha256":"da6253dd5c2d6cd2883e8b057a5bda5ef33a1fc417b46c50c1f16c8ffe1cc99c","firstChapterNumber":1,"firstChapterApiLink":"/api/gub_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gub_wbt/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":25,"content":[{"type":"heading","content":["Minaz uze'eg na'iruz haw rupi kury"]},{"type":"heading","content":["Aipo amo teko wiko kateteahy Tupàn huwarupi"]},{"type":"verse","number":1,"content":["Minaz uze'eg putar a'e nehe kury."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Tupàn upuner katu a'e. Tuwe teko ukyze izuwi wà nehe.","poem":1},{"lineBreak":true},{"text":"Omono zeàmàtyry'ym 'ymaw ywak rehe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aipo amo upapar heko haw pe har wà. Tupàn hatainy uhyape katu teko nànàn a'e.","poem":1},{"lineBreak":true},{"text":"Aipo heta amo teko izuwi uzeàmim ma'e wà.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aipo amo upuner ikatu ma'e romo weko haw rehe Tupàn henataromo wà.","poem":1},{"lineBreak":true},{"text":"Aipo amo teko umàno ma'e ràm upuner zepykaw wi uzepyro haw rehe wà.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"— Zahy nuhyape katu kwaw, i'i Tupàn.","poem":1},{"lineBreak":true},{"text":"— Heta ikatu 'ymaw zahytata wanehe, i'i.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma'e za'e putar teko wanupe. Nuzawy kwaw meru wà. Nuzawy kwaw amirikur Tupàn henataromo wà.","poem":1},{"lineBreak":true},{"text":"Màràzàwe tuwe mo uzekaiw wanehe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gub_wbt/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gub_wbt/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gub_wbt/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}