{"translation":{"id":"gub_wbt","name":"Tupàn ze'eg","website":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseNotes":null,"shortName":"WBT","englishName":"Guajajára Bible","language":"gub","textDirection":"ltr","sha256":"3d4a3e2f7a24aced78ab83f61e9c17b701cb6fe81ec074d544d45e4278d1f657","availableFormats":["json"],"listOfBooksApiLink":"/api/gub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30186,"languageName":"Guajajára","languageEnglishName":"Guajajára"},"book":{"id":"PSA","translationId":"gub_wbt","name":"ZEGAR HAW","commonName":"ZEGAR HAW","title":"ZEGAR HAW","order":19,"numberOfChapters":150,"sha256":"331adf296fa97f51cb8c18ebba4d2c377919642575d07029ff3fdfc3292292a1","firstChapterNumber":1,"firstChapterApiLink":"/api/gub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gub_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":1,"content":[{"type":"heading","content":["Turywete haw azeharomo har"]},{"type":"verse","number":1,"content":[{"text":"Hurywete putar","poem":1},{"lineBreak":true},{"text":"Ikatu 'ym ma'e wapureruze'egaw rehe uzekaiw 'ym ma'e a'e wà nehe.","poem":1},{"lineBreak":true},{"text":"Hurywete putar Tupàn iputar 'ymar wazàwe wiko 'ym ma'e a'e wà nehe no.","poem":1},{"lineBreak":true},{"text":"Hurywete putar Tupàn rehe uze'eg urywahyahy ma'e wanehe we oho 'ym ma'e a'e wà nehe no.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tupàn Tuweharupi Wiko Ma'e ze'eg umurywete kar a'e teko a'e wà.","poem":1},{"lineBreak":true},{"text":"Ima'enukwaw a'e ze'eg rehe 'aromo wà, pyhaw wà no.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A'e teko wiko ywyra ài wà. Ma'e'yw yrykaw iwyr rehe har ài wanekon wà.","poem":1},{"lineBreak":true},{"text":"I'a haw 'ar mehe,","poem":1},{"lineBreak":true},{"text":"Huwer nuxinig kwaw.","poem":1},{"lineBreak":true},{"text":"A'e teko hemiapo ikatu upaw rupi wà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ikatu 'ym ma'e nuiko kwaw wazàwe wà.","poem":1},{"lineBreak":true},{"text":"Nuzawy kwaw arozpirer uxinig ma'e ywytu hemiraha wà.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A'e rupi, zepykaw 'ar mehe nehe, Tupàn uzepyk putar ikatu 'ym ma'e iapo har wanehe a'e wà nehe.","poem":1},{"lineBreak":true},{"text":"Upyta putar muite Tupàn heruzar har wanuwi wà nehe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aze teko weruzar katu Tupàn Tuweharupi Wiko Ma'e a'e wà, Tupàn weruze'eg a'e teko a'e wà. Uzapo ikatu ma'e wanupe.","poem":1},{"lineBreak":true},{"text":"Ikatu 'ym ma'e uhem putar iaiw paw pe wà nehe. Oho putar màno haw pe iahykaw rehe wà nehe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gub_wbt/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gub_wbt/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gub_wbt/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}