izywyr katu haw rehe ikatu haw imume'u pà nehe.","poem":1},{"lineBreak":true},{"text":"Pemume'u Tupàn ikatu haw nehe. Pemume'u hemimur kwer ikatu haw izupe nehe no.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tupàn Tuweharupi Wiko Ma'e ikatuahy a'e.","poem":1},{"lineBreak":true},{"text":"Ipuruamutar katu haw nupaw pixik kwaw nehe.","poem":1},{"lineBreak":true},{"text":"Nutyryk pixik kwaw puruwi nehe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gub_wbt/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gub_wbt/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gub_wbt/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}