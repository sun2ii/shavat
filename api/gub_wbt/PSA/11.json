{"translation":{"id":"gub_wbt","name":"Tupàn ze'eg","website":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseNotes":null,"shortName":"WBT","englishName":"Guajajára Bible","language":"gub","textDirection":"ltr","sha256":"3d4a3e2f7a24aced78ab83f61e9c17b701cb6fe81ec074d544d45e4278d1f657","availableFormats":["json"],"listOfBooksApiLink":"/api/gub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30186,"languageName":"Guajajára","languageEnglishName":"Guajajára"},"book":{"id":"PSA","translationId":"gub_wbt","name":"ZEGAR HAW","commonName":"ZEGAR HAW","title":"ZEGAR HAW","order":19,"numberOfChapters":150,"sha256":"331adf296fa97f51cb8c18ebba4d2c377919642575d07029ff3fdfc3292292a1","firstChapterNumber":1,"firstChapterApiLink":"/api/gub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gub_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":11,"content":[{"type":"heading","content":["Tupàn wiko hemonokatu har romo"]},{"type":"hebrew_subtitle","content":["Zegar haw Tawi hemiapo kwer"]},{"type":"verse","number":1,"content":[{"text":"Aiko Tupàn Tuweharupi Wiko Ma'e rehe we ihe,","poem":1},{"lineBreak":true},{"text":"A'e rupi nuzeapo kwaw ikatu 'ym ma'e ihewe nehe.","poem":1},{"lineBreak":true},{"text":"— Ezàn zeàmim wiràmiri ài ywytyr rehe nehe,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ta'e ikatu 'ym ma'e umuàgà'ym uwyrapar a'e wà xe.","poem":1},{"lineBreak":true},{"text":"Ta'e umuàgà'ym u'yw uzeàmimaw pupe wiko mehe a'e wà xe,","poem":1},{"lineBreak":true},{"text":"Awa ikatu ma'e wazywà pà a'e wà xe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Teko ikatu ma'e nupuner kwaw ma'e iapo haw rehe.","poem":1},{"lineBreak":true},{"text":"Ta'e heta ikatu 'ymaw ywy nànàn taw nànàn a'e xe, i'i ru'u ihewe wà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tupàn Tuweharupi Wiko Ma'e wiko wàpuzuhu ikatuahy ma'e pupe.","poem":1},{"lineBreak":true},{"text":"Henaw ywak rehe hin.","poem":1},{"lineBreak":true},{"text":"Wexak teko paw wà.","poem":1},{"lineBreak":true},{"text":"Ukwaw wanemiapo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Amo teko weruzar Tupàn Tuweharupi Wiko Ma'e a'e wà. Tupàn ume'e wanehe a'e. Ume'e ikatu 'ym ma'e wanehe no.","poem":1},{"lineBreak":true},{"text":"Teko upurumuahy ma'e wà, upuruzuka ma'e wà no,","poem":1},{"lineBreak":true},{"text":"Iro tuwe izupe wà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tupàn weityk ma'ezu ukaz ma'e purumuahy ma'e a'e, ikatu 'ym ma'e wanehe a'e. Tàtàpyz weityk wanehe no.","poem":1},{"lineBreak":true},{"text":"Uzepyk wanehe ywytu haku ma'e wamur kar pà wanehe. Ukaz wà.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tupàn Tuweharupi Wiko Ma'e uzapo ikatu ma'e a'e. Uzamutar katu imunar 'ym ma'e hemu'em 'ym ma'e wà.","poem":1},{"lineBreak":true},{"text":"Teko Tupàn heruzar har wiko putar ipyr wà nehe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gub_wbt/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gub_wbt/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gub_wbt/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}