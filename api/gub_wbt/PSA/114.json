{"translation":{"id":"gub_wbt","name":"Tupàn ze'eg","website":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseNotes":null,"shortName":"WBT","englishName":"Guajajára Bible","language":"gub","textDirection":"ltr","sha256":"3d4a3e2f7a24aced78ab83f61e9c17b701cb6fe81ec074d544d45e4278d1f657","availableFormats":["json"],"listOfBooksApiLink":"/api/gub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30186,"languageName":"Guajajára","languageEnglishName":"Guajajára"},"book":{"id":"PSA","translationId":"gub_wbt","name":"ZEGAR HAW","commonName":"ZEGAR HAW","title":"ZEGAR HAW","order":19,"numberOfChapters":150,"sha256":"331adf296fa97f51cb8c18ebba4d2c377919642575d07029ff3fdfc3292292a1","firstChapterNumber":1,"firstChapterApiLink":"/api/gub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gub_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":114,"content":[{"type":"heading","content":["Ezit ywy wi wahem awer"]},{"type":"verse","number":1,"content":[{"text":"Zako izuapyapyr a'e wà, teko Izaew her ma'e a'e wà, uhem Ezit ywy rehe kwehe mehe a'e wà.","poem":1},{"lineBreak":true},{"text":"Nuiko kwaw a'e ywy rehe harete romo wà.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A'e wi uhem mehe Zuta izuapyapyr uzeapo teko Tupàn hemixamixak romo wà.","poem":1},{"lineBreak":true},{"text":"Tupàn wiko Izaew wazar romo a'e 'ar mehe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yryhupiràg nuzuawy kwaw miar hehaite ma'e a'e. Miar uzàn awa hexak mehe.","poem":1},{"lineBreak":true},{"text":"Nezewegatete Yryhupiràg uhem oho Tupàn wi a'e no. Yrykawhu Zotàw her ma'e upytu'u uwyryk ire.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ywytyruhu opoopor àràpuhàràn hawitu ma'e ài wà.","poem":1},{"lineBreak":true},{"text":"Ywytyr opoopor àràpuhàràna'yr ài wà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ma'e uzeapo nemuzàn kar pà a'e, yryhu.","poem":1},{"lineBreak":true},{"text":"Ne Zotàw yrykaw ne, màràzàwe tuwe ne'y upytu'u uwyryk ire.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"O ywytyruhu wà, màràzàwe tuwe pepor àràpuhàràn ài.","poem":1},{"lineBreak":true},{"text":"Ywytyr wà, màràzàwe tuwe pepor àràpuhàràna'yr ài.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Eryryryryz zanezar tur mehe nehe, ywy.","poem":1},{"lineBreak":true},{"text":"Eryryryryz Tupàn Zako izar henataromo nehe,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ta'e uzapo itahu ytyzuzàmaw romo a'e wà xe.","poem":1},{"lineBreak":true},{"text":"Uzapo ita 'yzygwar romo wà no.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gub_wbt/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gub_wbt/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gub_wbt/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}