{"translation":{"id":"gub_wbt","name":"Tupàn ze'eg","website":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseNotes":null,"shortName":"WBT","englishName":"Guajajára Bible","language":"gub","textDirection":"ltr","sha256":"3d4a3e2f7a24aced78ab83f61e9c17b701cb6fe81ec074d544d45e4278d1f657","availableFormats":["json"],"listOfBooksApiLink":"/api/gub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30186,"languageName":"Guajajára","languageEnglishName":"Guajajára"},"book":{"id":"PSA","translationId":"gub_wbt","name":"ZEGAR HAW","commonName":"ZEGAR HAW","title":"ZEGAR HAW","order":19,"numberOfChapters":150,"sha256":"331adf296fa97f51cb8c18ebba4d2c377919642575d07029ff3fdfc3292292a1","firstChapterNumber":1,"firstChapterApiLink":"/api/gub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gub_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":120,"content":[{"type":"heading","content":["Upytywà àwàm henoz taw Tupàn pe"]},{"type":"verse","number":1,"content":[{"text":"Hezemumikahy mehe aze'eg Tupàn Tuweharupi Wiko Ma'e pe ihe, hepytywà àwàm henoz pà ihe.","poem":1},{"lineBreak":true},{"text":"Uwazar heze'eg ihewe a'e.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O Tuweharupi Wiko Ma'e, hemunyryk kar pe","poem":1},{"lineBreak":true},{"text":"Hemu'em ma'e wanuwi nehe, hemu'em tuwe ma'e wanuwi nehe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Pe hemu'em ma'e pe. Ma'e Tupàn uzapo putar peme a'e nehe.","poem":1},{"lineBreak":true},{"text":"Ma'e uzapo putar penehe uzepyk pà nehe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Upyro putar u'yw haime ma'e amo zauxiapekwer wi nehe. Pezywà putar ipupe penehe uzepyk pà nehe.","poem":1},{"lineBreak":true},{"text":"Upyhyk putar tàtàpyzgwer imono pà penehe nehe, penehe uzepyk pà nehe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Peinuromo hereko haw upuraraw kar ma'erahy ihewe","poem":1},{"lineBreak":true},{"text":"Mezek ywy rehe hereko haw ài,","poem":1},{"lineBreak":true},{"text":"Kenar ywy rehe hereko haw ài.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Amumaw kwarahy tetea'u amo teko wainuinuromo ihe.","poem":1},{"lineBreak":true},{"text":"A'e teko na'iakatuwawahy kwaw puruàmàtyry'ym 'ymaw rehe wà.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Zeàmàtyry'ym 'ymaw rehe heze'eg mehe,","poem":1},{"lineBreak":true},{"text":"— Uruputar zeàmàtyry'ymawhu, i'i a'e teko wà.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gub_wbt/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gub_wbt/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gub_wbt/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}