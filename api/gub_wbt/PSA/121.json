{"translation":{"id":"gub_wbt","name":"Tupàn ze'eg","website":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseNotes":null,"shortName":"WBT","englishName":"Guajajára Bible","language":"gub","textDirection":"ltr","sha256":"3d4a3e2f7a24aced78ab83f61e9c17b701cb6fe81ec074d544d45e4278d1f657","availableFormats":["json"],"listOfBooksApiLink":"/api/gub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30186,"languageName":"Guajajára","languageEnglishName":"Guajajára"},"book":{"id":"PSA","translationId":"gub_wbt","name":"ZEGAR HAW","commonName":"ZEGAR HAW","title":"ZEGAR HAW","order":19,"numberOfChapters":150,"sha256":"331adf296fa97f51cb8c18ebba4d2c377919642575d07029ff3fdfc3292292a1","firstChapterNumber":1,"firstChapterApiLink":"/api/gub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gub_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":121,"content":[{"type":"heading","content":["Tupàn wiko zanemonokatu har romo a'e"]},{"type":"verse","number":1,"content":[{"text":"Ame'e ywytyr rehe hepuranu pà.","poem":1},{"lineBreak":true},{"text":"— Ma'e wi ur putar hepytywà àwàm nehe, a'e hezeupe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hepytywà àwàm ur putar Tupàn Tuweharupi Wiko Ma'e wi nehe.","poem":1},{"lineBreak":true},{"text":"Ywak iapo arer romo ywy iapo arer romo hekon a'e.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nanemu'ar kar kwaw a'e nehe.","poem":1},{"lineBreak":true},{"text":"Nerehe uzekaiw ma'e romo hekon a'e. Tuweharupi ume'e iko.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wiko teko Izaew wanehe uzekaiw ma'e romo a'e.","poem":1},{"lineBreak":true},{"text":"Nuker pixik kwaw. Ni nuker wewera'i pixik kwaw a'e.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tupàn Tuweharupi Wiko Ma'e uzekaiw putar nerehe nehe.","poem":1},{"lineBreak":true},{"text":"Tuweharupi neruwake hekon nepyro pà.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"'Ar romo kwarahy nanemuahy kwaw nehe.","poem":1},{"lineBreak":true},{"text":"Pyhaw zahy nanemuahy kwaw nehe no.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tupàn Tuweharupi Wiko Ma'e uzekaiw putar nerehe ikatu 'ym ma'e wi paw nepyro pà a'e nehe.","poem":1},{"lineBreak":true},{"text":"Omonokatu putar nereko haw ikatu 'ymaw wi nehe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Neho mehe uzekaiw putar nerehe nehe.","poem":1},{"lineBreak":true},{"text":"Nezewyr mehe uzekaiw putar nerehe nehe no, ko 'ar rehe nehe, tuweharupi nehe no.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gub_wbt/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gub_wbt/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gub_wbt/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}