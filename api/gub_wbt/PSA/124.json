{"translation":{"id":"gub_wbt","name":"Tupàn ze'eg","website":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseNotes":null,"shortName":"WBT","englishName":"Guajajára Bible","language":"gub","textDirection":"ltr","sha256":"3d4a3e2f7a24aced78ab83f61e9c17b701cb6fe81ec074d544d45e4278d1f657","availableFormats":["json"],"listOfBooksApiLink":"/api/gub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30186,"languageName":"Guajajára","languageEnglishName":"Guajajára"},"book":{"id":"PSA","translationId":"gub_wbt","name":"ZEGAR HAW","commonName":"ZEGAR HAW","title":"ZEGAR HAW","order":19,"numberOfChapters":150,"sha256":"331adf296fa97f51cb8c18ebba4d2c377919642575d07029ff3fdfc3292292a1","firstChapterNumber":1,"firstChapterApiLink":"/api/gub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gub_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":124,"content":[{"type":"heading","content":["Tupàn wiko wemiaihu wapyro har romo a'e"]},{"type":"hebrew_subtitle","content":["Zegar haw Tawi hemiapo kwer"]},{"type":"verse","number":1,"content":[{"text":"Aze mo Tupàn Tuweharupi Wiko Ma'e nuiko iwer zanemyrypar romo,","poem":1},{"lineBreak":true},{"text":"Ma'e uzeapo mo zanewe.","poem":1},{"lineBreak":true},{"text":"Teko Izaew izuapyapyr wà, pewazar heze'eg ihewe nehe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Teko uwazar nezewe wà.","poem":1},{"lineBreak":true},{"text":"— Aze mo Tupàn Tuweharupi Wiko Ma'e nuiko iwer mo zanemyrypar romo,","poem":1},{"lineBreak":true},{"text":"Zaneàmàtyry'ymar zanekutyr wanur mehe,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Zanemukun mo zanereko we mehe wà xe.","poem":1},{"lineBreak":true},{"text":"Wikwahy mehe uzewyr mo zanekutyr wà.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"'Y zanereraha mo muite a'e.","poem":1},{"lineBreak":true},{"text":"Tynehemaw zanepyk mo no.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Zamàno mo 'y uwyrykahy ma'e pupe, i'i teko wà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ximume'u Tupàn Tuweharupi Wiko Ma'e ikatu haw izupe nehe.","poem":1},{"lineBreak":true},{"text":"Nazanemumaw kar kwaw zaneàmàtyry'ymar wanupe a'e mehe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Uzemi'i kar ma'e upyhyk wiràmiri ipyhykaw pupe a'e. Zaiko ipyhykaw wi uhem ma'e kwer ài.","poem":1},{"lineBreak":true},{"text":"Upen ipyhykaw. Nazanepyhyk kwaw a'e.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Zanepytywà haw ur Tupàn Tuweharupi Wiko Ma'e wi.","poem":1},{"lineBreak":true},{"text":"Uzapo ywak a'e. Uzapo ywy no.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gub_wbt/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gub_wbt/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gub_wbt/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}