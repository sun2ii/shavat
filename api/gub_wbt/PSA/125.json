{"translation":{"id":"gub_wbt","name":"Tupàn ze'eg","website":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseNotes":null,"shortName":"WBT","englishName":"Guajajára Bible","language":"gub","textDirection":"ltr","sha256":"3d4a3e2f7a24aced78ab83f61e9c17b701cb6fe81ec074d544d45e4278d1f657","availableFormats":["json"],"listOfBooksApiLink":"/api/gub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30186,"languageName":"Guajajára","languageEnglishName":"Guajajára"},"book":{"id":"PSA","translationId":"gub_wbt","name":"ZEGAR HAW","commonName":"ZEGAR HAW","title":"ZEGAR HAW","order":19,"numberOfChapters":150,"sha256":"331adf296fa97f51cb8c18ebba4d2c377919642575d07029ff3fdfc3292292a1","firstChapterNumber":1,"firstChapterApiLink":"/api/gub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gub_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":125,"content":[{"type":"heading","content":["Tupàn rehe uzeruzar ma'e wiko ikàg ma'e romo a'e wà"]},{"type":"verse","number":1,"content":[{"text":"Tupàn Tuweharupi Wiko Ma'e rehe uzeruzar ma'e","poem":1},{"lineBreak":true},{"text":"Wiko Xiàw ywytyr ài wà.","poem":1},{"lineBreak":true},{"text":"Teko nupuner kwaw Xiàw heitykaw rehe wà.","poem":1},{"lineBreak":true},{"text":"Ikàg tuweharupi a'e.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Heta ywytyruhu Zeruzarez izywyr.","poem":1},{"lineBreak":true},{"text":"Nezewegatete Tupàn Tuweharupi Wiko Ma'e wiko wemiaihu waiwyr a'e,","poem":1},{"lineBreak":true},{"text":"Ko 'ar rehe, tuweharupi nehe no.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Amo 'ar mehe ikatu 'ym ma'e upytu'u putar Tupàn hemiaihu waywy izar romo wiko re wà nehe.","poem":1},{"lineBreak":true},{"text":"Aze mo nupytu'u iwer, a'e mehe mo te ikatu ma'e uzypyrog mo ikatu 'ym ma'e iapo pà wà no.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"O Tupàn Tuweharupi Wiko Ma'e, nekatu ikatu ma'e wanupe nehe,","poem":1},{"lineBreak":true},{"text":"Neremiapo kar heruzar har wanupe nehe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ikatu 'ym ma'e wanehe nezepyk mehe nehe,","poem":1},{"lineBreak":true},{"text":"Ezepyk nerape wi utyryk ma'e kwer wanehe nehe no.","poem":1},{"lineBreak":true},{"text":"Tuwe zeàmàtyry'ym 'ymaw tuz teko Izaew wanehe nehe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gub_wbt/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gub_wbt/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gub_wbt/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}