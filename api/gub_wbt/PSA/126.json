{"translation":{"id":"gub_wbt","name":"Tupàn ze'eg","website":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseNotes":null,"shortName":"WBT","englishName":"Guajajára Bible","language":"gub","textDirection":"ltr","sha256":"3d4a3e2f7a24aced78ab83f61e9c17b701cb6fe81ec074d544d45e4278d1f657","availableFormats":["json"],"listOfBooksApiLink":"/api/gub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30186,"languageName":"Guajajára","languageEnglishName":"Guajajára"},"book":{"id":"PSA","translationId":"gub_wbt","name":"ZEGAR HAW","commonName":"ZEGAR HAW","title":"ZEGAR HAW","order":19,"numberOfChapters":150,"sha256":"331adf296fa97f51cb8c18ebba4d2c377919642575d07029ff3fdfc3292292a1","firstChapterNumber":1,"firstChapterApiLink":"/api/gub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gub_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":126,"content":[{"type":"heading","content":["Tupàn uzapo uhua'u ma'e wemiaihu wanupe"]},{"type":"verse","number":1,"content":[{"text":"Tupàn Tuweharupi Wiko Ma'e zanemuzewyr kar zanereruwà Zeruzarez pe a'e.","poem":1},{"lineBreak":true},{"text":"A'e 'ar mehe uzeapo ma'e kwer nuzawy kwaw zanepuahu haw zanewe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Zapuka tetea'u zanezegar pà zanerurywete haw rupi.","poem":1},{"lineBreak":true},{"text":"Na'e amogwer ywy rehe har uze'eg nezewe wà.","poem":1},{"lineBreak":true},{"text":"— Tupàn Tuweharupi Wiko Ma'e uzapo uhua'u ma'e a'e teko wanupe a'e, i'i wà.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Azeharomoete, Tupàn Tuweharupi Wiko Ma'e uzapo uhua'u ma'e zanewe a'e.","poem":1},{"lineBreak":true},{"text":"A'e rupi zanerurywete zane.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Àmàn neremimugyr kar uwyryk yrykawhu uxinig ma'e rupi a'e.","poem":1},{"lineBreak":true},{"text":"Nezewegatete o Tuweharupi Wiko Ma'e, uremuigo kar pe temi'u hereko har romo ma'e hereko har romo nehe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Teko ma'e tym mehe uzai'o ma'e a'e wà,","poem":1},{"lineBreak":true},{"text":"Hurywete putar ipo'o mehe wà nehe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma'eà'yz itym pyràm heraha har uzai'o ma'e wà,","poem":1},{"lineBreak":true},{"text":"Uzewyr putar uzegar pà urywete romo wà nehe.","poem":1},{"lineBreak":true},{"text":"Werur putar arozràn haryw uzywa rehe wà nehe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gub_wbt/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gub_wbt/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gub_wbt/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}