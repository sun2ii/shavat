{"translation":{"id":"gub_wbt","name":"Tupàn ze'eg","website":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseNotes":null,"shortName":"WBT","englishName":"Guajajára Bible","language":"gub","textDirection":"ltr","sha256":"3d4a3e2f7a24aced78ab83f61e9c17b701cb6fe81ec074d544d45e4278d1f657","availableFormats":["json"],"listOfBooksApiLink":"/api/gub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30186,"languageName":"Guajajára","languageEnglishName":"Guajajára"},"book":{"id":"PSA","translationId":"gub_wbt","name":"ZEGAR HAW","commonName":"ZEGAR HAW","title":"ZEGAR HAW","order":19,"numberOfChapters":150,"sha256":"331adf296fa97f51cb8c18ebba4d2c377919642575d07029ff3fdfc3292292a1","firstChapterNumber":1,"firstChapterApiLink":"/api/gub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gub_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":127,"content":[{"type":"heading","content":["Tupàn omono uze'egatu tàpuz me har wanehe"]},{"type":"verse","number":1,"content":[{"text":"Aze Tupàn Tuweharupi Wiko Ma'e nuzapo kwaw tàpuz,","poem":1},{"lineBreak":true},{"text":"Iapo har uma'ereko e iapo mehe wà.","poem":1},{"lineBreak":true},{"text":"Aze Tuweharupi Wiko Ma'e nuzekaiw kwaw tawhu rehe,","poem":1},{"lineBreak":true},{"text":"Zauxiapekwer ume'e e hehe uzekaiw mehe wà.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aze amo uma'ereko tetea'u wemi'u ràm imono'og pà,","poem":1},{"lineBreak":true},{"text":"Aze upu'àm izi'itahy, aze u'aw wi oho xo pyaze mehe, uma'ereko e a'e.","poem":1},{"lineBreak":true},{"text":"Ta'e Tupàn omono temi'u wemiamutar katu wanupe a'e xe.","poem":1},{"lineBreak":true},{"text":"Te waker mehe Tupàn uzapo ikatu ma'e wemiaihu pe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Zanera'yr a'e wà, wiko Tupàn Tuweharupi Wiko Ma'e hemimur kwer romo a'e wà.","poem":1},{"lineBreak":true},{"text":"Ze'egatu haw romo wanekon wà.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aze ta'yr uzexak kar awa pe ipyahu mehe we wà,","poem":1},{"lineBreak":true},{"text":"A'e ta'yr nuzawy kwaw u'yw zauxiapekwer ipo pe har wà.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hurywete awa agwer u'yw tetea'u wanereko har a'e.","poem":1},{"lineBreak":true},{"text":"Iàmàtyry'ymar nuweityk kwaw wà nehe,","poem":1},{"lineBreak":true},{"text":"Tuwihaw wanenataromo waneko mehe wà nehe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gub_wbt/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gub_wbt/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gub_wbt/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}