{"translation":{"id":"gub_wbt","name":"Tupàn ze'eg","website":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseNotes":null,"shortName":"WBT","englishName":"Guajajára Bible","language":"gub","textDirection":"ltr","sha256":"3d4a3e2f7a24aced78ab83f61e9c17b701cb6fe81ec074d544d45e4278d1f657","availableFormats":["json"],"listOfBooksApiLink":"/api/gub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30186,"languageName":"Guajajára","languageEnglishName":"Guajajára"},"book":{"id":"PSA","translationId":"gub_wbt","name":"ZEGAR HAW","commonName":"ZEGAR HAW","title":"ZEGAR HAW","order":19,"numberOfChapters":150,"sha256":"331adf296fa97f51cb8c18ebba4d2c377919642575d07029ff3fdfc3292292a1","firstChapterNumber":1,"firstChapterApiLink":"/api/gub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gub_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":128,"content":[{"type":"heading","content":["Tupàn umekuzar weruzar har wà"]},{"type":"verse","number":1,"content":[{"text":"Hurywete Tupàn Tuweharupi Wiko Ma'e wi ukyze ma'e a'e,","poem":1},{"lineBreak":true},{"text":"Hemimutar rupi wiko ma'e a'e.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aze ereiko izàwe nehe, neremimono'og ràm uhyk putar newe nehe.","poem":1},{"lineBreak":true},{"text":"Nerurywete putar nehe no.","poem":1},{"lineBreak":true},{"text":"Ikatu ma'e uzeapo putar newe nehe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nereko haw pe neremireko wiko putar uwà 'yw i'a tetea'u ma'e ài newe nehe.","poem":1},{"lineBreak":true},{"text":"Nera'yr nuzawy kwaw uri tyw ipyahu ma'e ywyrapew nemai'u mehe har izywyr wà nehe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tupàn Tuweharupi Wiko Ma'e wi ukyze ma'e","poem":1},{"lineBreak":true},{"text":"Wiko putar nezewe azeharomoete nehe, ze'egatu ipyhyk pà nehe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tuwe Tupàn Tuweharupi Wiko Ma'e Xiàw ywytyr rehe har","poem":1},{"lineBreak":true},{"text":"Umur uze'egatu nerehe nehe.","poem":1},{"lineBreak":true},{"text":"Tuwe ne'ar nànàn erexak Zeruzarez ikàg wera'u haw nehe no.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tuwe erexak neremimino ne wà nehe.","poem":1},{"lineBreak":true},{"text":"Tuwe zeàmàtyry'ym 'ymaw teko Izaew izuapyapyr wanehe tuz a'e nehe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gub_wbt/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gub_wbt/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gub_wbt/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}