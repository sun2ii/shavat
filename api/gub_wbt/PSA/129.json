{"translation":{"id":"gub_wbt","name":"Tupàn ze'eg","website":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseNotes":null,"shortName":"WBT","englishName":"Guajajára Bible","language":"gub","textDirection":"ltr","sha256":"3d4a3e2f7a24aced78ab83f61e9c17b701cb6fe81ec074d544d45e4278d1f657","availableFormats":["json"],"listOfBooksApiLink":"/api/gub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30186,"languageName":"Guajajára","languageEnglishName":"Guajajára"},"book":{"id":"PSA","translationId":"gub_wbt","name":"ZEGAR HAW","commonName":"ZEGAR HAW","title":"ZEGAR HAW","order":19,"numberOfChapters":150,"sha256":"331adf296fa97f51cb8c18ebba4d2c377919642575d07029ff3fdfc3292292a1","firstChapterNumber":1,"firstChapterApiLink":"/api/gub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gub_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":129,"content":[{"type":"heading","content":["Teko ipuruàmàtyry'ym wer Izaew wanehe a'e wà. Nezewe rehe we nuweityk kwaw wà"]},{"type":"verse","number":1,"content":[{"text":"Teko Izaew izuapyapyr wà,","poem":1},{"lineBreak":true},{"text":"Pekwarer mehe arer we peàmàtyry'ymar upuraraw kar ma'erahy peme wà.","poem":1},{"lineBreak":true},{"text":"Pemume'u wanemiapo kwer nehe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nezewe i'i teko wà.","poem":1},{"lineBreak":true},{"text":"— Urekwarer mehe arer we ureàmàtyry'ymar upuraraw kar tuwe ma'erahy urewe wà.","poem":1},{"lineBreak":true},{"text":"Nezewe rehe we na'urereityk kwaw wà.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ywy heruwaruwakaw uzapo perew zàwenugar ywy rehe.","poem":1},{"lineBreak":true},{"text":"Nezewegatete ureàmàtyry'ymar uzapo perew iaiw ma'e urekupe pe wà.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tupàn Tuweharupi Wiko Ma'e ikatu a'e.","poem":1},{"lineBreak":true},{"text":"Zanepyro a'e, zanezar ikatu 'ym ma'e wanuwi a'e, i'i teko wà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tuwe amo weityk Zeruzarez rehe iakatuwawahy 'ymar wà nehe.","poem":1},{"lineBreak":true},{"text":"Tuwe uzàn weityk arer wanuwi wà nehe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tuwe wiko ka'akyr tàpuz 'aromo hezuz ma'e ài wà nehe.","poem":1},{"lineBreak":true},{"text":"Ka'akyr uxinig o'ok 'ym mehe we a'e.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Teko nomono'og kwaw a'e ka'akyr wà.","poem":1},{"lineBreak":true},{"text":"Nuzàpixipixi kwaw wà. Nueraha kwaw wàpuz me wà. Weityk wà.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tuwe teko a'e teko wanuwake ukwaw ma'e nuze'eg kwaw nezewe wà nehe.","poem":1},{"lineBreak":true},{"text":"— Tuwe Tupàn umur uze'egatu penehe nehe.","poem":1},{"lineBreak":true},{"text":"Ure oromono ureze'egatu penehe Tupàn Tuweharupi Wiko Ma'e her rehe ure, tuwe ni'i kwaw wanupe wà nehe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gub_wbt/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gub_wbt/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gub_wbt/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}