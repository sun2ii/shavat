{"translation":{"id":"gub_wbt","name":"Tupàn ze'eg","website":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseNotes":null,"shortName":"WBT","englishName":"Guajajára Bible","language":"gub","textDirection":"ltr","sha256":"3d4a3e2f7a24aced78ab83f61e9c17b701cb6fe81ec074d544d45e4278d1f657","availableFormats":["json"],"listOfBooksApiLink":"/api/gub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30186,"languageName":"Guajajára","languageEnglishName":"Guajajára"},"book":{"id":"PSA","translationId":"gub_wbt","name":"ZEGAR HAW","commonName":"ZEGAR HAW","title":"ZEGAR HAW","order":19,"numberOfChapters":150,"sha256":"331adf296fa97f51cb8c18ebba4d2c377919642575d07029ff3fdfc3292292a1","firstChapterNumber":1,"firstChapterApiLink":"/api/gub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gub_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":13,"content":[{"type":"heading","content":["Zeruzar haw Tupàn puruamutar haw rehe"]},{"type":"hebrew_subtitle","content":["Zegar haw Tawi hemiapo kwer"]},{"type":"verse","number":1,"content":[{"text":"O Tupàn Tuweharupi Wiko Ma'e, nereharaz hewi ne. Màràn mehe nema'enukwaw wi putar herehe nehe.","poem":1},{"lineBreak":true},{"text":"Aipo nanema'enukwaw pixik kwaw herehe nehe.","poem":1},{"lineBreak":true},{"text":"Màràn 'ar eremumaw putar neruwa ihewi ipyk pà nehe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Màràn 'ar amumaw putar ko ma'erahy ipuraraw pà nehe. Hepy'a tynehem hezemumikahy haw pupe, 'aromo, pyhaw.","poem":1},{"lineBreak":true},{"text":"Màràn 'ar amumaw putar nezewe nehe.","poem":1},{"lineBreak":true},{"text":"Heàmàtyry'ymar hemuzàn kar tuweharupi wà. Màràn 'ar amumaw putar nezewe nehe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"O Tupàn Tuweharupi Wiko Ma'e, eme'e herehe kury. Ewazar heze'eg ihewe kury.","poem":1},{"lineBreak":true},{"text":"Emur nekàgaw ihewe nehe. Nezewe mehe namàno kwaw nehe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nezewe mehe heàmàtyry'ymar nahurywete kwaw wà nehe, ta'e na'ar kwaw ihe nehe xe.","poem":1},{"lineBreak":true},{"text":"— Xityk kwez zane, ni'i kwaw wà nehe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Heamutar katu pe ne. Azeruzar heamutar katu haw rehe.","poem":1},{"lineBreak":true},{"text":"Hepy'a hurywete putar nehe, ta'e hepyro putar pe ne nehe xe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Amuzàg putar zegar haw newe nehe, o Tupàn Tuweharupi Wiko Ma'e pe,","poem":1},{"lineBreak":true},{"text":"Ta'e nekatuahy ihewe ne xe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gub_wbt/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gub_wbt/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gub_wbt/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}