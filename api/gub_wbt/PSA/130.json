{"translation":{"id":"gub_wbt","name":"Tupàn ze'eg","website":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseNotes":null,"shortName":"WBT","englishName":"Guajajára Bible","language":"gub","textDirection":"ltr","sha256":"3d4a3e2f7a24aced78ab83f61e9c17b701cb6fe81ec074d544d45e4278d1f657","availableFormats":["json"],"listOfBooksApiLink":"/api/gub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30186,"languageName":"Guajajára","languageEnglishName":"Guajajára"},"book":{"id":"PSA","translationId":"gub_wbt","name":"ZEGAR HAW","commonName":"ZEGAR HAW","title":"ZEGAR HAW","order":19,"numberOfChapters":150,"sha256":"331adf296fa97f51cb8c18ebba4d2c377919642575d07029ff3fdfc3292292a1","firstChapterNumber":1,"firstChapterApiLink":"/api/gub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gub_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":130,"content":[{"type":"heading","content":["Aenoz hepytywà àwàm Tupàn pe ihe"]},{"type":"verse","number":1,"content":[{"text":"O Tupàn Tuweharupi Wiko Ma'e,","poem":1},{"lineBreak":true},{"text":"Ma'erahy iaiw ma'e ipuraraw mehe uruenoz ihe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Herenu pe newe heze'eg mehe wahy haw rupi nehe, o hezar.","poem":1},{"lineBreak":true},{"text":"Herenu pe hepytywà àwàm newe hereminoz nehe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aze eremuapyk ureremiapo kwer ikatu 'ym ma'e pape rehe,","poem":1},{"lineBreak":true},{"text":"Mo upuner nezepyk àwàm wi uhemaw rehe wà nehe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ne eremunàn ureremiapo kwer ikatu 'ym ma'e ne.","poem":1},{"lineBreak":true},{"text":"A'e rupi urukyze newi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Àrogatu hepytywà àwàm iteko Tupàn Tuweharupi Wiko Ma'e henataromo ihe.","poem":1},{"lineBreak":true},{"text":"Azeruzar ize'eg rehe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tawhu rehe uzekaiw ma'e zauxiapekwer wàro iku'emaw wà.","poem":1},{"lineBreak":true},{"text":"Àro wera'u hezar ihe.","poem":1},{"lineBreak":true},{"text":"Wàro kwarahy ihemaw wà. Àro wera'u hezar ihe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Teko Izaew izuapyapyr wà, pezeruzar Tupàn Tuweharupi Wiko Ma'e rehe nehe,","poem":1},{"lineBreak":true},{"text":"Ta'e nupytu'u kwaw teko wamutar katu re a'e xe.","poem":1},{"lineBreak":true},{"text":"Tuweharupi ipurupyro wer purehe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Upyro putar wemiaihu Izaew a'e wà nehe,","poem":1},{"lineBreak":true},{"text":"Wapyro pà wanemiapo kwer ikatu 'ym ma'e wi a'e wà nehe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gub_wbt/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gub_wbt/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gub_wbt/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}