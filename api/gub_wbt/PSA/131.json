{"translation":{"id":"gub_wbt","name":"Tupàn ze'eg","website":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseNotes":null,"shortName":"WBT","englishName":"Guajajára Bible","language":"gub","textDirection":"ltr","sha256":"3d4a3e2f7a24aced78ab83f61e9c17b701cb6fe81ec074d544d45e4278d1f657","availableFormats":["json"],"listOfBooksApiLink":"/api/gub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30186,"languageName":"Guajajára","languageEnglishName":"Guajajára"},"book":{"id":"PSA","translationId":"gub_wbt","name":"ZEGAR HAW","commonName":"ZEGAR HAW","title":"ZEGAR HAW","order":19,"numberOfChapters":150,"sha256":"331adf296fa97f51cb8c18ebba4d2c377919642575d07029ff3fdfc3292292a1","firstChapterNumber":1,"firstChapterApiLink":"/api/gub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gub_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":131,"content":[{"type":"heading","content":["Naiko wera'u kwaw ihe, i'i Tawi Tupàn pe"]},{"type":"hebrew_subtitle","content":["Zegar haw Tawi hemiapo kwer"]},{"type":"verse","number":1,"content":[{"text":"O Tupàn Tuweharupi Wiko Ma'e. — Aiko wera'u amo wanuwi ihe, na'e kwaw.","poem":1},{"lineBreak":true},{"text":"Apytu'u amogwer wanuwi hekàg wera'u haw imume'u re.","poem":1},{"lineBreak":true},{"text":"Naikar kwaw uhua'u ma'e aha iteko kury.","poem":1},{"lineBreak":true},{"text":"Aze ma'e zawaiw katu wera'u ihewe, nazeagaw kwaw iapo pà ihe. Naputar kwaw ma'e kury, aze napuner kwaw a'e ma'e hereko haw rehe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kwarera'i ukamu re upytu'u mehe upyta uker pà uhy izywa rehe.","poem":1},{"lineBreak":true},{"text":"Nezewegatete naherehaite kwaw.","poem":1},{"lineBreak":true},{"text":"Apytu'u nerehe we ihe no.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Teko Izaew izuapyapyr wà, pezeruzar Tupàn Tuweharupi Wiko Ma'e rehe nehe.","poem":1},{"lineBreak":true},{"text":"Ko 'ar rehe, tuweharupi nehe no.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gub_wbt/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gub_wbt/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gub_wbt/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}