{"translation":{"id":"gub_wbt","name":"Tupàn ze'eg","website":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseNotes":null,"shortName":"WBT","englishName":"Guajajára Bible","language":"gub","textDirection":"ltr","sha256":"3d4a3e2f7a24aced78ab83f61e9c17b701cb6fe81ec074d544d45e4278d1f657","availableFormats":["json"],"listOfBooksApiLink":"/api/gub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30186,"languageName":"Guajajára","languageEnglishName":"Guajajára"},"book":{"id":"PSA","translationId":"gub_wbt","name":"ZEGAR HAW","commonName":"ZEGAR HAW","title":"ZEGAR HAW","order":19,"numberOfChapters":150,"sha256":"331adf296fa97f51cb8c18ebba4d2c377919642575d07029ff3fdfc3292292a1","firstChapterNumber":1,"firstChapterApiLink":"/api/gub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gub_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":133,"content":[{"type":"heading","content":["Teko uzeinuinuromo haw ikatu Tupàn pe"]},{"type":"hebrew_subtitle","content":["Zegar haw Tawi hemiapo kwer"]},{"type":"verse","number":1,"content":[{"text":"Aze Tupàn hemiaihu wiko uzeinuinuromo uzeàmàtyry'ym 'ym pà wà nehe,","poem":1},{"lineBreak":true},{"text":"Aze amo wereko amo uwywyr ài wà nehe, ikatuahy putar nezewe haw wanupe nehe.","poem":1},{"lineBreak":true},{"text":"Hurywete putar wà nehe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nezewe waneko haw nuzawy kwaw uri kawer kàpuhàg inuromo har Àràw àkàg rehe izakook pyrer a'e.","poem":1},{"lineBreak":true},{"text":"Uwyryk iamutaw rehe.","poem":1},{"lineBreak":true},{"text":"Ikamirpuku rehe uwyryk no.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nezewe waneko haw nuzawy kwaw zuwiri Eremon ywytyr rehe har.","poem":1},{"lineBreak":true},{"text":"U'ar Xiàw ywytyr nànàn no,","poem":1},{"lineBreak":true},{"text":"Ta'e Tupàn Tuweharupi Wiko Ma'e omono uze'egatu Xiàw ywytyr rehe a'e xe.","poem":1},{"lineBreak":true},{"text":"Umuigo kar putar teko a'e pe tuweharupi wà nehe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gub_wbt/PSA/133.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gub_wbt/PSA/134.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gub_wbt/PSA/132.json","previousChapterAudioLinks":{},"numberOfVerses":3}