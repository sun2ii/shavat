{"translation":{"id":"gub_wbt","name":"Tupàn ze'eg","website":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseNotes":null,"shortName":"WBT","englishName":"Guajajára Bible","language":"gub","textDirection":"ltr","sha256":"3d4a3e2f7a24aced78ab83f61e9c17b701cb6fe81ec074d544d45e4278d1f657","availableFormats":["json"],"listOfBooksApiLink":"/api/gub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30186,"languageName":"Guajajára","languageEnglishName":"Guajajára"},"book":{"id":"PSA","translationId":"gub_wbt","name":"ZEGAR HAW","commonName":"ZEGAR HAW","title":"ZEGAR HAW","order":19,"numberOfChapters":150,"sha256":"331adf296fa97f51cb8c18ebba4d2c377919642575d07029ff3fdfc3292292a1","firstChapterNumber":1,"firstChapterApiLink":"/api/gub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gub_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":142,"content":[{"type":"heading","content":["Uze'eg Tupàn pe upytywà àwàm henoz pà izupe a'e"]},{"type":"hebrew_subtitle","content":["Zegar haw Tawi hemiapo kwer"]},{"type":"verse","number":1,"content":[{"text":"Aze'eg Tupàn Tuweharupi Wiko Ma'e pe hepytywà àwàm henoz pà ihe.","poem":1},{"lineBreak":true},{"text":"— Hepytywà pe nehe, a'eahy izupe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aze wyzài ma'e na'ikatu kwaw ihewe, amume'u izupe.","poem":1},{"lineBreak":true},{"text":"Aze amo ikatu 'ym ma'e uzeapo ihewe, amume'u izupe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aze apytu'u wewera'i hema'ereko haw iapo re,","poem":1},{"lineBreak":true},{"text":"A'e ae ukwaw ikatu ma'e ihewe iapo kar haw a'e.","poem":1},{"lineBreak":true},{"text":"Heàmàtyry'ymar uzapo hepyhyk àwàm","poem":1},{"lineBreak":true},{"text":"Herape rupi wà.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ame'e hezeake.","poem":1},{"lineBreak":true},{"text":"Naexak kwaw hepytywà har.","poem":1},{"lineBreak":true},{"text":"Naheta kwaw hepyro har wà.","poem":1},{"lineBreak":true},{"text":"Naheta kwaw herehe uzekaiw ma'e wà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"O Tupàn Tuweharupi Wiko Ma'e, ahapukaz newe hepytywà àwàm henoz pà ihe.","poem":1},{"lineBreak":true},{"text":"O Tupàn, ereiko herehe uzekaiw ma'e romo ne.","poem":1},{"lineBreak":true},{"text":"Naputar kwaw amo ma'e hereko haw ihe. Xo ne zo uruputar ihe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Herenu pe hepytywà àwàm henoz mehe nehe,","poem":1},{"lineBreak":true},{"text":"Ta'e hemàno àwàm uhem etea'i ihewe xe.","poem":1},{"lineBreak":true},{"text":"Hepyro pe heàmàtyry'ymar wanuwi nehe,","poem":1},{"lineBreak":true},{"text":"Ta'e ikàg wera'u ihewi a'e wà xe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hemunyryk kar pe ma'erahy heremipuraraw wi nehe.","poem":1},{"lineBreak":true},{"text":"Amume'u putar nekatu haw neremiaihu wazemono'og mehe ihe nehe,","poem":1},{"lineBreak":true},{"text":"Ta'e nekatu ihewe tuweharupi ne xe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gub_wbt/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gub_wbt/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gub_wbt/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}