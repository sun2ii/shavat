{"translation":{"id":"gub_wbt","name":"Tupàn ze'eg","website":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseNotes":null,"shortName":"WBT","englishName":"Guajajára Bible","language":"gub","textDirection":"ltr","sha256":"3d4a3e2f7a24aced78ab83f61e9c17b701cb6fe81ec074d544d45e4278d1f657","availableFormats":["json"],"listOfBooksApiLink":"/api/gub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30186,"languageName":"Guajajára","languageEnglishName":"Guajajára"},"book":{"id":"PSA","translationId":"gub_wbt","name":"ZEGAR HAW","commonName":"ZEGAR HAW","title":"ZEGAR HAW","order":19,"numberOfChapters":150,"sha256":"331adf296fa97f51cb8c18ebba4d2c377919642575d07029ff3fdfc3292292a1","firstChapterNumber":1,"firstChapterApiLink":"/api/gub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gub_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":15,"content":[{"type":"heading","content":["Tupàn Hàpuzuhu pupe wiko ma'e"]},{"type":"hebrew_subtitle","content":["Zegar haw Tawi hemiapo kwer"]},{"type":"verse","number":1,"content":[{"text":"O Tupàn Tuweharupi Wiko Ma'e. Mo upuner neràpuzuhu pupe weko haw rehe.","poem":1},{"lineBreak":true},{"text":"Mo upuner ywytyr nerenaw ikatuahy ma'e pe upyta haw rehe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Xo ikatu ma'e romo wiko ma'e zo upuner.","poem":1},{"lineBreak":true},{"text":"Xo ikatu ma'e iapo har zo upuner.","poem":1},{"lineBreak":true},{"text":"Xo ze'eg azeharomoete har imume'u har zo upuner. Xo uze'eg mehe hemu'em 'ym ma'e zo upuner.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nuze'eg zemueteahy kwaw amo wanehe.","poem":1},{"lineBreak":true},{"text":"Nuzapo kar kwaw ikatu 'ym ma'e umyrypar wanupe.","poem":1},{"lineBreak":true},{"text":"Numume'u kwaw temu'emaw uzeake wiko ma'e wanehe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tupàn hemityk kwer na'ikatu kwaw izupe wà.","poem":1},{"lineBreak":true},{"text":"Wereko katu Tupàn Tuweharupi Wiko Ma'e heruzar har wà.","poem":1},{"lineBreak":true},{"text":"Uzapo tuwe ma'e wemimume'u kwer rupi katete. Aze hekuzar katu izupe, nezewe rehe we uzapo a'e.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Omono wemetarer amo pe wemetarer imemyr henoz 'ym pà.","poem":1},{"lineBreak":true},{"text":"Nupyhyk kwaw temetarer teko ikatu ma'e rehe ikatu 'ym ma'e imume'u haw hekuzaromo a'e.","poem":1},{"lineBreak":true},{"text":"Agwer ikatu ma'e iapo har wiko katu putar tuweharupi nehe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gub_wbt/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gub_wbt/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gub_wbt/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}