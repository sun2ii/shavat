{"translation":{"id":"gub_wbt","name":"Tupàn ze'eg","website":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseNotes":null,"shortName":"WBT","englishName":"Guajajára Bible","language":"gub","textDirection":"ltr","sha256":"3d4a3e2f7a24aced78ab83f61e9c17b701cb6fe81ec074d544d45e4278d1f657","availableFormats":["json"],"listOfBooksApiLink":"/api/gub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30186,"languageName":"Guajajára","languageEnglishName":"Guajajára"},"book":{"id":"PSA","translationId":"gub_wbt","name":"ZEGAR HAW","commonName":"ZEGAR HAW","title":"ZEGAR HAW","order":19,"numberOfChapters":150,"sha256":"331adf296fa97f51cb8c18ebba4d2c377919642575d07029ff3fdfc3292292a1","firstChapterNumber":1,"firstChapterApiLink":"/api/gub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gub_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":23,"content":[{"type":"heading","content":["Tupàn wiko àràpuhàràn imono'ogar ài"]},{"type":"hebrew_subtitle","content":["Zegar haw Tawi hemiapo kwer"]},{"type":"verse","number":1,"content":[{"text":"Tupàn Tuweharupi Wiko Ma'e wiko àràpuhàràn imono'ogar ài ihewe a'e.","poem":1},{"lineBreak":true},{"text":"Uhyk putar ma'e ihewe nehe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hemupytu'u kar ka'api'i ikyr ma'e rehe.","poem":1},{"lineBreak":true},{"text":"Hereraha ykotok heta 'ymaw pe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hemukàg kar wiwi a'e,","poem":1},{"lineBreak":true},{"text":"Pe ikatu ma'e rupi hemuata kar pà a'e no,","poem":1},{"lineBreak":true},{"text":"Hemimume'u kwer rupi katete a'e no.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Aze ata ywyàpyznaw tatainy hereko 'ymar rupi nehe, màno haw zàwenugar rupi nehe,","poem":1},{"lineBreak":true},{"text":"Nakyze kwaw ma'e wi ihe nehe,","poem":1},{"lineBreak":true},{"text":"Ta'e ne Tupàn Tuweharupi Wiko Ma'e ereiko herehe we ne xe.","poem":1},{"lineBreak":true},{"text":"Erezekaiw katu herehe. Heho àwàm erexak kar ihewe no.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Erezapo mai'u hawhu ihewe.","poem":1},{"lineBreak":true},{"text":"Heàmàtyry'ymar upuner herexakaw rehe a'e mai'u haw pe wà.","poem":1},{"lineBreak":true},{"text":"Hemuixe kar pe nereminoz imuwete wera'u pyr ài.","poem":1},{"lineBreak":true},{"text":"Eremynehem tuwe hekanek ihewe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Azeharomoete nekatu haw nehe, nepuruamutar haw nehe no,","poem":1},{"lineBreak":true},{"text":"Upyta putar heinuinuromo herekuwe mehe nehe. Akwaw herehe we ipyta àwàm ihe.","poem":1},{"lineBreak":true},{"text":"'Ar nànàn herekuwe mehe","poem":1},{"lineBreak":true},{"text":"Aiko putar neràpuz me, o Tupàn Tuweharupi Wiko Ma'e.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gub_wbt/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gub_wbt/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gub_wbt/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}