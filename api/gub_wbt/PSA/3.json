{"translation":{"id":"gub_wbt","name":"Tupàn ze'eg","website":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseNotes":null,"shortName":"WBT","englishName":"Guajajára Bible","language":"gub","textDirection":"ltr","sha256":"3d4a3e2f7a24aced78ab83f61e9c17b701cb6fe81ec074d544d45e4278d1f657","availableFormats":["json"],"listOfBooksApiLink":"/api/gub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30186,"languageName":"Guajajára","languageEnglishName":"Guajajára"},"book":{"id":"PSA","translationId":"gub_wbt","name":"ZEGAR HAW","commonName":"ZEGAR HAW","title":"ZEGAR HAW","order":19,"numberOfChapters":150,"sha256":"331adf296fa97f51cb8c18ebba4d2c377919642575d07029ff3fdfc3292292a1","firstChapterNumber":1,"firstChapterApiLink":"/api/gub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gub_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":3,"content":[{"type":"heading","content":["Tupàn pe ze'egaw upytywà haw henoz taw"]},{"type":"hebrew_subtitle","content":["Wa'yr Àmixàràw wi uzàn mehe Tawi uzapo 'aw zegar haw a'e."]},{"type":"verse","number":1,"content":[{"text":"O Tupàn Tuweharupi Wiko Ma'e.","poem":1},{"lineBreak":true},{"text":"Heta tetea'u heàmàtyry'ymar wà. Hekutyr uwak ma'e heta tetea'u wà.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Uze'eg uzeupeupe herehe wà.","poem":1},{"lineBreak":true},{"text":"— Tupàn nupytywà kwaw tuwihawete a'e nehe, i'i nerehe uze'eg pà wà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"U'yw wi purumimaw upyro zauxiapekwer màno haw wi a'e wà. Nezewegatete, ne Tupàn Tuweharupi Wiko Ma'e, hepyro katu 'ymaw wi ne.","poem":1},{"lineBreak":true},{"text":"Ereityk heàmàtyry'ymar ne wà.","poem":1},{"lineBreak":true},{"text":"Hemukàg wi pe ne no.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"— Ezur hepytywà pà nehe, a'e Tupàn Tuweharupi Wiko Ma'e pe.","poem":1},{"lineBreak":true},{"text":"Wenaw wi ywytyr ikatuahy ma'e wemimonokatu kwer wi uwazar heze'eg ihewe a'e.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"A'aw ihe. Aker katu ihe no.","poem":1},{"lineBreak":true},{"text":"Ame'e wi heker ire, ta'e Tuweharupi Wiko Ma'e uzekaiw katu herehe a'e xe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Heta tetea'u heàmàtyry'ymar wà. Nakyze kwaw wanuwi ihe.","poem":1},{"lineBreak":true},{"text":"Umàmàn heywyr herehe ipuruzuka wer pà wà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ezur nehe, Tupàn Tuweharupi Wiko Ma'e. Hepyro nehe, hezar.","poem":1},{"lineBreak":true},{"text":"Ereàmàtyry'ym heàmàtyry'ymar ne wà.","poem":1},{"lineBreak":true},{"text":"Eremuigo kar ikatu 'ym ma'e ikàg 'ym ma'e romo ne wà. Eremumaw wakàgaw no.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ne ereiko waneitykar romo ne.","poem":1},{"lineBreak":true},{"text":"Emono neze'egatu teko neremiaihu wanehe nehe, o Tupàn Tuweharupi Wiko Ma'e.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gub_wbt/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gub_wbt/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gub_wbt/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}