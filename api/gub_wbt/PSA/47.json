{"translation":{"id":"gub_wbt","name":"Tupàn ze'eg","website":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseNotes":null,"shortName":"WBT","englishName":"Guajajára Bible","language":"gub","textDirection":"ltr","sha256":"3d4a3e2f7a24aced78ab83f61e9c17b701cb6fe81ec074d544d45e4278d1f657","availableFormats":["json"],"listOfBooksApiLink":"/api/gub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30186,"languageName":"Guajajára","languageEnglishName":"Guajajára"},"book":{"id":"PSA","translationId":"gub_wbt","name":"ZEGAR HAW","commonName":"ZEGAR HAW","title":"ZEGAR HAW","order":19,"numberOfChapters":150,"sha256":"331adf296fa97f51cb8c18ebba4d2c377919642575d07029ff3fdfc3292292a1","firstChapterNumber":1,"firstChapterApiLink":"/api/gub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gub_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":47,"content":[{"type":"heading","content":["Tupàn wiko ywy nànànar waneruze'egar romo"]},{"type":"hebrew_subtitle","content":["Zegar haw Kora wanemiapo kwer"]},{"type":"verse","number":1,"content":[{"text":"Pezepopetek penurywete romo nehe, teko paw wà.","poem":1},{"lineBreak":true},{"text":"Pemuzàg ikatu haw rehe zegar haw Tupàn pe wahyhaw rupi nehe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tuwe teko ukyze Tupàn Tuweharupi Wiko Ma'e ywate wera'u har wi a'e wà nehe.","poem":1},{"lineBreak":true},{"text":"Wiko tuwihawete uhua'u ma'e romo a'e, ywy nànànar waneruze'egar romo a'e.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tupàn weityk kar teko amo ywy rehe har zanewe a'e wà.","poem":1},{"lineBreak":true},{"text":"Weruze'eg kar teko ywy nànànar zanewe wà no.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wexaexak ywy zanereko haw zanewe a'e.","poem":1},{"lineBreak":true},{"text":"Ikatuahy a'e ywy hemiaihu wanupe,","poem":1},{"lineBreak":true},{"text":"Hemiamutar katu wanupe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tupàn uzeupir oho wenaw pe.","poem":1},{"lineBreak":true},{"text":"Izeupir mehe teko uhapukaz urywete romo wà. Upy uxi'àm oho urywete haw rehe wà no.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pemuzàg zegar haw Tupàn ikatu haw rehe nehe.","poem":1},{"lineBreak":true},{"text":"Pemuzàg zegar haw Zaneruwihawete pe nehe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pemume'u Tupàn ikatu haw pezegar pà nehe,","poem":1},{"lineBreak":true},{"text":"Ta'e wiko teko ywy rehe har paw wanuwihawete romo a'e xe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Wapyk Tupàn wenaw ikatu ma'e rehe a'e.","poem":1},{"lineBreak":true},{"text":"Wiko teko paw wanuwihaw romo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Teko wanuwihaw uzemono'og wà,","poem":1},{"lineBreak":true},{"text":"Àmàrààw izar hemiaihu wainuinuromo wà.","poem":1},{"lineBreak":true},{"text":"Tupàn wiko tuwihawete wakàgaw ywy rehe har paw wazar romo a'e.","poem":1},{"lineBreak":true},{"text":"Wiko ma'e paw teko paw wazar romo no.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gub_wbt/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gub_wbt/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gub_wbt/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}