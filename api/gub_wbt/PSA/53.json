{"translation":{"id":"gub_wbt","name":"Tupàn ze'eg","website":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseNotes":null,"shortName":"WBT","englishName":"Guajajára Bible","language":"gub","textDirection":"ltr","sha256":"3d4a3e2f7a24aced78ab83f61e9c17b701cb6fe81ec074d544d45e4278d1f657","availableFormats":["json"],"listOfBooksApiLink":"/api/gub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30186,"languageName":"Guajajára","languageEnglishName":"Guajajára"},"book":{"id":"PSA","translationId":"gub_wbt","name":"ZEGAR HAW","commonName":"ZEGAR HAW","title":"ZEGAR HAW","order":19,"numberOfChapters":150,"sha256":"331adf296fa97f51cb8c18ebba4d2c377919642575d07029ff3fdfc3292292a1","firstChapterNumber":1,"firstChapterApiLink":"/api/gub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gub_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":53,"content":[{"type":"heading","content":["Iaiw haw, zepyro haw no"]},{"type":"hebrew_subtitle","content":["Zegar haw Tawi hemiapo kwer"]},{"type":"verse","number":1,"content":[{"text":"Nezewe uze'eg iranaiw ma'e uzeupe a'e wà.","poem":1},{"lineBreak":true},{"text":"— Na'ikàg kwaw Tupàn, i'i wà.","poem":1},{"lineBreak":true},{"text":"Upaw rupi uzeapo ipihe ma'e iapo har romo wà.","poem":1},{"lineBreak":true},{"text":"Uzapo iaiw ma'e oho waiko wà.","poem":1},{"lineBreak":true},{"text":"Naheta kwaw ni pitài ikatu ma'e iapo har wà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ywak rehe wapyk mehe Tupàn ume'e teko paw wanehe.","poem":1},{"lineBreak":true},{"text":"Wekar amo ikatu ma'e iko.","poem":1},{"lineBreak":true},{"text":"— Aipo heta amo hemuwete katu har, i'i uzeupe uzehe upuranu pà.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Upaw rupi upytu'u hehe uzeruzar ire wà.","poem":1},{"lineBreak":true},{"text":"Wakatu 'ymaw paw uzuawyawygatu wà.","poem":1},{"lineBreak":true},{"text":"Naheta kwaw ni pitài ikatu ma'e iapo har wà.","poem":1},{"lineBreak":true},{"text":"Azeharomoete naheta pixik kwaw wà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tupàn upuranu purehe a'e.","poem":1},{"lineBreak":true},{"text":"— Aipo a'e teko ikatu 'ym ma'e nukwaw kwaw ma'e wà.","poem":1},{"lineBreak":true},{"text":"Tuweharupi imunar heremiaihu wama'e rehe wà.","poem":1},{"lineBreak":true},{"text":"Nuze'eg kwaw ihewe wà no, i'i Tupàn.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Uryryryryz putar ukyze pà a'e wà nehe.","poem":1},{"lineBreak":true},{"text":"Nuryryryryz pixik kwaw nezewe a'e 'ym mehe wà,","poem":1},{"lineBreak":true},{"text":"Ta'e Tupàn umuhàmuhàz wàmàtyry'ymar wàkàgwer a'e wà xe.","poem":1},{"lineBreak":true},{"text":"Weityk wà.","poem":1},{"lineBreak":true},{"text":"A'e rupi Izaew ipurumuzàmuzàg weityk putar upaw rupi katete wà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tuwe Tupàn uputar Izaew wapyro àwàm Zeruzarez wi ur ma'e ràm a'e nehe.","poem":1},{"lineBreak":true},{"text":"Zako izuapyapyr hurywete putar wà nehe,","poem":1},{"lineBreak":true},{"text":"Ta'e Tupàn umukatu putar waneko haw a'e nehe xe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gub_wbt/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gub_wbt/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gub_wbt/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}