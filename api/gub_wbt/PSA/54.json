{"translation":{"id":"gub_wbt","name":"Tupàn ze'eg","website":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseNotes":null,"shortName":"WBT","englishName":"Guajajára Bible","language":"gub","textDirection":"ltr","sha256":"3d4a3e2f7a24aced78ab83f61e9c17b701cb6fe81ec074d544d45e4278d1f657","availableFormats":["json"],"listOfBooksApiLink":"/api/gub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30186,"languageName":"Guajajára","languageEnglishName":"Guajajára"},"book":{"id":"PSA","translationId":"gub_wbt","name":"ZEGAR HAW","commonName":"ZEGAR HAW","title":"ZEGAR HAW","order":19,"numberOfChapters":150,"sha256":"331adf296fa97f51cb8c18ebba4d2c377919642575d07029ff3fdfc3292292a1","firstChapterNumber":1,"firstChapterApiLink":"/api/gub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gub_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":54,"content":[{"type":"heading","content":["Tupàn pe upytywà haw henoz taw"]},{"type":"hebrew_subtitle","content":["Zegar haw Tawi hemiapo kwer"]},{"type":"verse","number":1,"content":[{"text":"O Tupàn, hepyro pe nekàgaw pupe nehe.","poem":1},{"lineBreak":true},{"text":"Hemunyryk kar pe katu 'ymaw wi nekàgaw pupe nehe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Einu, o Tupàn, newe heze'egaw nehe.","poem":1},{"lineBreak":true},{"text":"Ezeapyaka katu heze'eg rehe nehe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ta'e amo wanuwi wiko wera'u ma'e uhem wà waiko heàmàtyry'ym pà a'e wà xe.","poem":1},{"lineBreak":true},{"text":"Ipuruzukaiw ma'e ipuruzuka wer herehe wà.","poem":1},{"lineBreak":true},{"text":"A'e teko nuzekaiw kwaw Tupàn rehe wà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Akwaw Tupàn hepytywà har romo heko haw ihe.","poem":1},{"lineBreak":true},{"text":"Heàmàtyry'ymar waneitykar romo heko haw akwaw no.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tuwe Tupàn umuzewyr kar heàmàtyry'ymar wakatu 'ymaw a'e nehe, wakutyr a'e nehe.","poem":1},{"lineBreak":true},{"text":"Tupàn nutyryk kwaw wemiaihu wanuwi.","poem":1},{"lineBreak":true},{"text":"A'e rupi umumaw putar heàmàtyry'ymar a'e wà nehe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"O Tupàn Tuweharupi Wiko Ma'e. Azuka kar putar ma'ea'yr neruwa rupi ihe wà nehe, ta'e heporomono wer wanehe newe ihe xe.","poem":1},{"lineBreak":true},{"text":"Amume'u putar nekatu haw nehe, ta'e nekatuahy ne xe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Erezo'ok ma'erahy heremipuraraw paw ihewi.","poem":1},{"lineBreak":true},{"text":"Aexak heàmàtyry'ymar waneityk awer no.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gub_wbt/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gub_wbt/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gub_wbt/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}