{"translation":{"id":"gub_wbt","name":"Tupàn ze'eg","website":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseNotes":null,"shortName":"WBT","englishName":"Guajajára Bible","language":"gub","textDirection":"ltr","sha256":"3d4a3e2f7a24aced78ab83f61e9c17b701cb6fe81ec074d544d45e4278d1f657","availableFormats":["json"],"listOfBooksApiLink":"/api/gub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30186,"languageName":"Guajajára","languageEnglishName":"Guajajára"},"book":{"id":"PSA","translationId":"gub_wbt","name":"ZEGAR HAW","commonName":"ZEGAR HAW","title":"ZEGAR HAW","order":19,"numberOfChapters":150,"sha256":"331adf296fa97f51cb8c18ebba4d2c377919642575d07029ff3fdfc3292292a1","firstChapterNumber":1,"firstChapterApiLink":"/api/gub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gub_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":61,"content":[{"type":"heading","content":["Ikàgaw Tupàn rehe we"]},{"type":"hebrew_subtitle","content":["Zegar haw Tawi hemiapo kwer"]},{"type":"verse","number":1,"content":[{"text":"O Tupàn herenu pe hezai'oahy mehe nehe.","poem":1},{"lineBreak":true},{"text":"Einu newe heze'egaw nehe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aiko muite hereko haw wi iaiw haw inuromo ihe.","poem":1},{"lineBreak":true},{"text":"Aenoz hepytywà àwàm iteko ihe.","poem":1},{"lineBreak":true},{"text":"Hereraha pe amo hemim àwàm me nehe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ta'e ereiko herehe uzekaiw ma'e romo ne xe.","poem":1},{"lineBreak":true},{"text":"Ereiko hepyro har ikàg ma'e heàmàtyry'ymar wanuwi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tuwe aiko neràpuzuhu pupe he'ar nànàn nehe.","poem":1},{"lineBreak":true},{"text":"Nezewe mehe erezekaiw katu putar herehe nehe, wiràmiri upepo iwy pe umemyr wanehe izekaiw haw ài nehe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"O Tupàn, erenu heremiapo ràm heremimume'u kwer.","poem":1},{"lineBreak":true},{"text":"Eremono neze'egatu nereruzar har newi ukyze ma'e wanehe. Agwer ma'e eremur herehe no.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Eremumaw kar kwarahy tetea'u tuwihawete pe nehe.","poem":1},{"lineBreak":true},{"text":"Tuwe umumaw kwarahy tetea'u wiko pà nehe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"O Tupàn, tuwe eremono neze'egatu hehe tuweharupi tuwihawete romo heko mehe nehe.","poem":1},{"lineBreak":true},{"text":"Ezekaiw katu hehe nepuruamutar haw inuromo nehe, teko wanuwi netyryk 'ymaw inuromo nehe no.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nezewe mehe amuzàg putar nekatu haw rehe zegar haw tuweharupi ihe nehe.","poem":1},{"lineBreak":true},{"text":"Tuweharupi amono putar ma'e newe heremimume'u kwer rupi katete ihe nehe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gub_wbt/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gub_wbt/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gub_wbt/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}