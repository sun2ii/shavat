nemuwete har paw hurywete wà nehe.","poem":1},{"lineBreak":true},{"text":"Tuwe hurywete katu wà nehe.","poem":1},{"lineBreak":true},{"text":"Tuwe nepurupytywà haw iamutar katu har uze'eg nezewe tuweharupi wà nehe.","poem":1},{"lineBreak":true},{"text":"— Uhua'u tuwe Tupàn a'e, tuwe i'i wà nehe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Aiko hemetarer 'ym ma'e romo ihe. Naheta kwaw ma'e ihewe, o Tupàn.","poem":1},{"lineBreak":true},{"text":"Ereiko hepytywà har romo.","poem":1},{"lineBreak":true},{"text":"Hepyro har romo ereiko.","poem":1},{"lineBreak":true},{"text":"Neàrew zo hepytywà mehe nehe, o Tupàn Tuweharupi Wiko Ma'e.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gub_wbt/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gub_wbt/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gub_wbt/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}