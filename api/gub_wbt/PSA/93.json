{"translation":{"id":"gub_wbt","name":"Tupàn ze'eg","website":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gubBl","licenseNotes":null,"shortName":"WBT","englishName":"Guajajára Bible","language":"gub","textDirection":"ltr","sha256":"3d4a3e2f7a24aced78ab83f61e9c17b701cb6fe81ec074d544d45e4278d1f657","availableFormats":["json"],"listOfBooksApiLink":"/api/gub_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30186,"languageName":"Guajajára","languageEnglishName":"Guajajára"},"book":{"id":"PSA","translationId":"gub_wbt","name":"ZEGAR HAW","commonName":"ZEGAR HAW","title":"ZEGAR HAW","order":19,"numberOfChapters":150,"sha256":"331adf296fa97f51cb8c18ebba4d2c377919642575d07029ff3fdfc3292292a1","firstChapterNumber":1,"firstChapterApiLink":"/api/gub_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gub_wbt/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":93,"content":[{"type":"heading","content":["Tupàn wiko paw rupi ma'e waneruze'egar romo"]},{"type":"verse","number":1,"content":[{"text":"Tupàn Tuweharupi Wiko Ma'e wiko tuwihawete romo a'e. Umunehew ukàgaw kamirpuku ài.","poem":1},{"lineBreak":true},{"text":"Ipuner haw upyk uzar no.","poem":1},{"lineBreak":true},{"text":"Umuàtà ywy henaw rehe izypy mehe.","poem":1},{"lineBreak":true},{"text":"Ni amo nupuner kwaw imunyryk kar haw rehe henaw wi wà nehe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O hezar, 'ar izypy mehe arer henataromo ereiko tuwe tuwihawete romo. Izypy mehe ereiko.","poem":1},{"lineBreak":true},{"text":"Tuweharupi ereiko putar nehe no.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"O Tupàn Tuweharupi Wiko Ma'e, yryhu ohoete ma'e uze'eg iko.","poem":1},{"lineBreak":true},{"text":"Ykotok okororoahy a'e.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tupàn Tuweharupi Wiko Ma'e upureruze'eg iko ywak rehe upuner haw rupi.","poem":1},{"lineBreak":true},{"text":"Ikàgaw uhua'u wera'u yryhu ipuruzukaiw ma'e wi a'e.","poem":1},{"lineBreak":true},{"text":"Upuner wera'u ykotok yryhu rehe har wanuwi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"O Tupàn Tuweharupi Wiko Ma'e, ikatuahy neze'eg.","poem":1},{"lineBreak":true},{"text":"A'e rupi teko upuner hehe uzeruzar haw rehe wà. Eremonokatu neràpuzuhu. Ikatuahy putar tuweharupi nehe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/gub_wbt/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gub_wbt/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gub_wbt/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}