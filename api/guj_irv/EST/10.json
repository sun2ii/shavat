{"translation":{"id":"guj_irv","name":"ઇન્ડિયન રીવાઇઝ્ડ વર્ઝન ગુજરાતી - 2019","website":"https://ebible.org/Scriptures/details.php?id=guj2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=guj2017","licenseNotes":null,"shortName":"IRV","englishName":"Gujarati Indian Revised Version Bible","language":"guj","textDirection":"ltr","sha256":"7d7d4b6cb83226342f549d26490dab4e5df5183bf8b98b248c827e39064d0a34","availableFormats":["json"],"listOfBooksApiLink":"/api/guj_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"ગુજરાતી","languageEnglishName":"Gujarati"},"book":{"id":"EST","translationId":"guj_irv","name":"એસ્તેર","commonName":"એસ્તેર","title":"એસ્તેર","order":17,"numberOfChapters":10,"sha256":"e2eebb5fe7691d9be235316e07cee024e1b5f7331f0bbbdfc5a90afc8ed8c788","firstChapterNumber":1,"firstChapterApiLink":"/api/guj_irv/EST/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/guj_irv/EST/10.json","totalNumberOfVerses":167},"chapter":{"number":10,"content":[{"type":"heading","content":["અહાશ્વેરોશ અને મોર્દખાયની મહાનતા"]},{"type":"verse","number":1,"content":["અહાશ્વેરોશ રાજાએ દેશ ઉપર તથા સમુદ્રના ટાપુઓ ઉપર કર નાખ્યો."]},{"type":"verse","number":2,"content":["તેના પરાક્રમના તથા તેના સાર્મથ્યનાં સર્વ કૃત્યો તથા જે ઉચ્ચ પદવીએ રાજાએ મોર્દખાયને સ્થાન આપ્યું હતું, તેની સંપૂર્ણ માહિતી ઇરાનના તથા માદાયના રાજાઓનાં કાળવૃત્તાંતોના પુસ્તકમાં લખેલી છે."]},{"type":"verse","number":3,"content":["કેમ કે યહૂદી મોર્દખાય અહાશ્વેરોશ રાજાથી બીજા દરજ્જાનો તથા યહૂદીઓમાં મહાન પુરુષ ગણાતો હતો. તે પોતાના દેશબંધુઓનો માનીતો હતો, કારણ કે તે પોતાના લોકોનું હિત જાળવતો હતો. અને તેઓ વધારે સફળ થાય માટે યત્ન કરતો હતો."]}],"footnotes":[]},"thisChapterLink":"/api/guj_irv/EST/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/guj_irv/JOB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/guj_irv/EST/9.json","previousChapterAudioLinks":{},"numberOfVerses":3}