{"translation":{"id":"guj_irv","name":"ઇન્ડિયન રીવાઇઝ્ડ વર્ઝન ગુજરાતી - 2019","website":"https://ebible.org/Scriptures/details.php?id=guj2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=guj2017","licenseNotes":null,"shortName":"IRV","englishName":"Gujarati Indian Revised Version Bible","language":"guj","textDirection":"ltr","sha256":"7d7d4b6cb83226342f549d26490dab4e5df5183bf8b98b248c827e39064d0a34","availableFormats":["json"],"listOfBooksApiLink":"/api/guj_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"ગુજરાતી","languageEnglishName":"Gujarati"},"book":{"id":"JOB","translationId":"guj_irv","name":"અયૂબ","commonName":"અયૂબ","title":"અયૂબ","order":18,"numberOfChapters":42,"sha256":"381246b2c3ffe675d5fe40b34c2934ad9fb086e6f1cac79ac6c78e6c81384353","firstChapterNumber":1,"firstChapterApiLink":"/api/guj_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/guj_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":25,"content":[{"type":"heading","content":["બિલ્દાદ"]},{"type":"verse","number":1,"content":["પછી બિલ્દાદ શૂહીએ ઉત્તર આપ્યો અને કહ્યું,"]},{"type":"verse","number":2,"content":[{"text":"“સત્તા અને ભય તેમની પાસે છે;","poem":1},{"lineBreak":true},{"text":"તે પોતાના ઉચ્ચ સ્થાનોમાં શાંતિ કરે છે.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"શું તેમના સૈન્યોની કંઈ ગણતરી છે?","poem":1},{"lineBreak":true},{"text":"અને કોના ઉપર તેમનું અજવાળું નથી પ્રકાશતું?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ઈશ્વરની સમક્ષ મનુષ્ય કેવી રીતે ન્યાયી ઠરે?","poem":1},{"lineBreak":true},{"text":"અને સ્ત્રીજન્ય કેવી રીતે પવિત્ર હોઈ શકે?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"જુઓ, તેમની દૃષ્ટિમાં ચંદ્ર પણ નિસ્તેજ છે;","poem":1},{"lineBreak":true},{"text":"અને તારાઓ પણ નિર્મળ નથી.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"તો પછી મનુષ્ય જે કીડા જેવો છે,","poem":1},{"lineBreak":true},{"text":"અને મનુષ્યપુત્ર","poem":1},{"noteId":13},{"text":"જે કીડો જ છે, તે કેવી રીતે પવિત્ર હોઈ શકે!”","poem":1}]}],"footnotes":[{"noteId":13,"caller":"+","text":"માનવ જાત","reference":{"chapter":25,"verse":6}}]},"thisChapterLink":"/api/guj_irv/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/guj_irv/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/guj_irv/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}