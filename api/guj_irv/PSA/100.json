{"translation":{"id":"guj_irv","name":"ઇન્ડિયન રીવાઇઝ્ડ વર્ઝન ગુજરાતી - 2019","website":"https://ebible.org/Scriptures/details.php?id=guj2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=guj2017","licenseNotes":null,"shortName":"IRV","englishName":"Gujarati Indian Revised Version Bible","language":"guj","textDirection":"ltr","sha256":"7d7d4b6cb83226342f549d26490dab4e5df5183bf8b98b248c827e39064d0a34","availableFormats":["json"],"listOfBooksApiLink":"/api/guj_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"ગુજરાતી","languageEnglishName":"Gujarati"},"book":{"id":"PSA","translationId":"guj_irv","name":"ગીતશાસ્ત્ર","commonName":"ગીતશાસ્ત્ર","title":"ગીતશાસ્ત્ર","order":19,"numberOfChapters":150,"sha256":"a0bb256b9ea5b0d3077f9e52cb556ef8c84d7656e9e729260b0bfa227ef11f57","firstChapterNumber":1,"firstChapterApiLink":"/api/guj_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/guj_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":100,"content":[{"type":"heading","content":["સ્તુતિગાન"]},{"type":"hebrew_subtitle","content":["આભારસ્તુતિનું ગીત."]},{"type":"verse","number":1,"content":[{"text":"હે પૃથ્વીના લોકો, યહોવાહની સમક્ષ ગાઓ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"આનંદથી યહોવાહની સેવા કરો;","poem":1},{"lineBreak":true},{"text":"ગાતાં ગાતાં તેમની આગળ આવો.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"જાણો કે યહોવાહ તે જ ઈશ્વર છે;","poem":1},{"lineBreak":true},{"text":"તેમણે આપણને ઉત્પન્ન કર્યા છે અને આપણે તેમના જ છીએ.","poem":1},{"lineBreak":true},{"text":"આપણે તેમના લોક અને તેમના ચારાનાં ઘેટાં છીએ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"આભારસ્તુતિ સાથે તેમના દ્વારમાં પ્રવેશો","poem":1},{"lineBreak":true},{"text":"અને સ્તવન કરતાં તેમના આંગણામાં આવો.","poem":1},{"lineBreak":true},{"text":"આભાર માનીને તેમના નામની પ્રશંસા કરો.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"કારણ કે યહોવાહ ઉત્તમ છે; તેમની કૃપા સર્વકાળ","poem":1},{"lineBreak":true},{"text":"અને તેમનું ન્યાયીપણું પેઢી દરપેઢી ટકી રહે છે.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/guj_irv/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/guj_irv/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/guj_irv/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}