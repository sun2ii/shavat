{"translation":{"id":"guj_irv","name":"ઇન્ડિયન રીવાઇઝ્ડ વર્ઝન ગુજરાતી - 2019","website":"https://ebible.org/Scriptures/details.php?id=guj2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=guj2017","licenseNotes":null,"shortName":"IRV","englishName":"Gujarati Indian Revised Version Bible","language":"guj","textDirection":"ltr","sha256":"7d7d4b6cb83226342f549d26490dab4e5df5183bf8b98b248c827e39064d0a34","availableFormats":["json"],"listOfBooksApiLink":"/api/guj_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"ગુજરાતી","languageEnglishName":"Gujarati"},"book":{"id":"PSA","translationId":"guj_irv","name":"ગીતશાસ્ત્ર","commonName":"ગીતશાસ્ત્ર","title":"ગીતશાસ્ત્ર","order":19,"numberOfChapters":150,"sha256":"a0bb256b9ea5b0d3077f9e52cb556ef8c84d7656e9e729260b0bfa227ef11f57","firstChapterNumber":1,"firstChapterApiLink":"/api/guj_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/guj_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"heading","content":["રાજાની પ્રતિજ્ઞા"]},{"type":"hebrew_subtitle","content":["દાઉદનું ગીત."]},{"type":"verse","number":1,"content":[{"text":"કૃપા તથા ન્યાય વિષે હું ગાયન કરીશ;","poem":1},{"lineBreak":true},{"text":"હે યહોવાહ, હું તમારી સ્તુતિ કરીશ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"હું સીધા માર્ગમાં ચાલીશ.","poem":1},{"lineBreak":true},{"text":"તમે મારી પાસે ક્યારે આવશો?","poem":1},{"lineBreak":true},{"text":"હું ખરા અંતઃકરણથી મારા ઘરમાં વર્તીશ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"હું કંઈ ખોટું કાર્ય મારી દ્રષ્ટિમાં રાખીશ નહિ;","poem":1},{"lineBreak":true},{"text":"પીછેહઠ કરનારાનાં કામથી હું કંટાળું છું;","poem":1},{"lineBreak":true},{"text":"તેમની કંઈ અસર મને થશે નહિ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"અનુચિત લોકોને હું મારાથી દૂર રાખીશ;","poem":1},{"lineBreak":true},{"text":"હું કોઈ દુષ્ટની ઓળખાણ રાખીશ નહિ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"જે કોઈ પોતાના પાડોશીની છાની ચાડી કરે છે તેનો હું નાશ કરીશ.","poem":1},{"lineBreak":true},{"text":"જેની દ્રષ્ટિ અભિમાની અને જેનું હૃદય ગર્વિષ્ઠ છે તેનું હું સહન કરીશ નહિ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"દેશમાંના વિશ્વાસુઓ મારી પાસે વાસો કરે તે માટે હું તેઓ પર રહેમ નજર રાખીશ.","poem":1},{"lineBreak":true},{"text":"જે કોઈ સીધા માર્ગમાં ચાલે છે તે મારી સેવા કરશે.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"કપટી લોકો મારા ઘરમાં રહી શકશે નહિ;","poem":1},{"lineBreak":true},{"text":"જૂઠું બોલનારા કોઈ મારી આંખ આગળ રહેશે નહિ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"આ દેશમાં રહેતા દુષ્ટ લોકોનો હું દરરોજ નાશ કરીશ;","poem":1},{"lineBreak":true},{"text":"સર્વ દુષ્ટ કરનારાઓને યહોવાહના નગરમાંથી કાપી નાખીશ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/guj_irv/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/guj_irv/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/guj_irv/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}