{"translation":{"id":"guj_irv","name":"ઇન્ડિયન રીવાઇઝ્ડ વર્ઝન ગુજરાતી - 2019","website":"https://ebible.org/Scriptures/details.php?id=guj2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=guj2017","licenseNotes":null,"shortName":"IRV","englishName":"Gujarati Indian Revised Version Bible","language":"guj","textDirection":"ltr","sha256":"7d7d4b6cb83226342f549d26490dab4e5df5183bf8b98b248c827e39064d0a34","availableFormats":["json"],"listOfBooksApiLink":"/api/guj_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"ગુજરાતી","languageEnglishName":"Gujarati"},"book":{"id":"PSA","translationId":"guj_irv","name":"ગીતશાસ્ત્ર","commonName":"ગીતશાસ્ત્ર","title":"ગીતશાસ્ત્ર","order":19,"numberOfChapters":150,"sha256":"a0bb256b9ea5b0d3077f9e52cb556ef8c84d7656e9e729260b0bfa227ef11f57","firstChapterNumber":1,"firstChapterApiLink":"/api/guj_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/guj_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"heading","content":["સંકટમાં સહાય"]},{"type":"hebrew_subtitle","content":["ચઢવાનું ગીત."]},{"type":"verse","number":1,"content":[{"text":"મારા સંકટમાં મેં યહોવાહને પોકાર કર્યો","poem":1},{"lineBreak":true},{"text":"અને તેમણે મને ઉત્તર આપ્યો.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"હે યહોવાહ, જેઓ પોતાના હોઠોથી જૂઠું બોલે છે","poem":1},{"lineBreak":true},{"text":"અને તેમની જીભથી છેતરે છે, તેઓથી તમે મારા આત્માને બચાવો.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"હે કપટી જીભ, તને તો તે શું કરશે?","poem":1},{"lineBreak":true},{"text":"અને તારા તે શા હાલ કરશે?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"તને યોદ્ધાઓ","poem":1},{"noteId":111},{"text":"તીક્ષ્ણ બાણોથી વીંધશે,","poem":1},{"lineBreak":true},{"text":"અને ધગધગતા કોલસાથી તને દઝાડાશે.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"મને અફસોસ છે કે હું મેશેખમાં","poem":1},{"noteId":112},{"text":"રહું છું;","poem":1},{"lineBreak":true},{"text":"અગાઉ હું કેદારના તંબુઓ મધ્યે રહેતો હતો.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"જે શાંતિ પર દ્વેષ રાખે છે","poem":1},{"lineBreak":true},{"text":"તેની સાથે રહીને હવે તો હું ધરાઈ ગયો છું.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"હું શાંતિ ચાહું છું,","poem":1},{"lineBreak":true},{"text":"પણ જ્યારે હું બોલું છું, ત્યારે તેઓ લડાઈ કરવા માગે છે.","poem":1}]}],"footnotes":[{"noteId":111,"caller":"+","text":"મજબૂત માણસ","reference":{"chapter":120,"verse":4}},{"noteId":112,"caller":"+","text":"કાળો સમુદ્ર અને કેસ્પિયન સમુદ્ર વચ્ચેનું ક્ષેત્ર","reference":{"chapter":120,"verse":5}}]},"thisChapterLink":"/api/guj_irv/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/guj_irv/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/guj_irv/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}