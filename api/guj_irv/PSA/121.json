{"translation":{"id":"guj_irv","name":"ઇન્ડિયન રીવાઇઝ્ડ વર્ઝન ગુજરાતી - 2019","website":"https://ebible.org/Scriptures/details.php?id=guj2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=guj2017","licenseNotes":null,"shortName":"IRV","englishName":"Gujarati Indian Revised Version Bible","language":"guj","textDirection":"ltr","sha256":"7d7d4b6cb83226342f549d26490dab4e5df5183bf8b98b248c827e39064d0a34","availableFormats":["json"],"listOfBooksApiLink":"/api/guj_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"ગુજરાતી","languageEnglishName":"Gujarati"},"book":{"id":"PSA","translationId":"guj_irv","name":"ગીતશાસ્ત્ર","commonName":"ગીતશાસ્ત્ર","title":"ગીતશાસ્ત્ર","order":19,"numberOfChapters":150,"sha256":"a0bb256b9ea5b0d3077f9e52cb556ef8c84d7656e9e729260b0bfa227ef11f57","firstChapterNumber":1,"firstChapterApiLink":"/api/guj_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/guj_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":121,"content":[{"type":"heading","content":["પ્રભુજીનાં રખવાળાં"]},{"type":"hebrew_subtitle","content":["ચઢવાનું ગીત."]},{"type":"verse","number":1,"content":[{"text":"હું પર્વતો તરફ મારી આંખો ઊંચી કરીશ.","poem":1},{"lineBreak":true},{"text":"મને ક્યાંથી સહાય મળે?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"જે યહોવાહે આકાશ તથા પૃથ્વી ઉત્પન્ન કર્યાં છે,","poem":1},{"lineBreak":true},{"text":"તેમની તરફથી મને સહાય મળે છે.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"તે તારા પગને ડગવા દેશે નહિ;","poem":1},{"lineBreak":true},{"text":"જે તારું રક્ષણ કરે છે તે ઊંઘશે નહિ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"જુઓ, ઇઝરાયલના જે રક્ષક છે","poem":1},{"lineBreak":true},{"text":"તે કદી ઊંઘતા નથી અને નિદ્રાવશ થતા નથી.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"યહોવાહ તારા રક્ષક છે;","poem":1},{"lineBreak":true},{"text":"યહોવાહ તારા જમણે હાથે તને છાયા કરશે.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"દિવસે સૂર્ય કે રાત્રે ચંદ્ર","poem":1},{"lineBreak":true},{"text":"તને નુકસાન પહોંચાડશે નહિ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"સર્વ દુઃખથી યહોવાહ તારું રક્ષણ કરશે;","poem":1},{"lineBreak":true},{"text":"તે તારા આત્માની સંભાળ રાખશે.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"હમણાંથી તે સર્વકાળ માટે","poem":1},{"lineBreak":true},{"text":"તારા સર્વ કાર્યોમાં યહોવાહ તારું રક્ષણ કરશે.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/guj_irv/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/guj_irv/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/guj_irv/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}