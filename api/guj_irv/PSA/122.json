{"translation":{"id":"guj_irv","name":"ઇન્ડિયન રીવાઇઝ્ડ વર્ઝન ગુજરાતી - 2019","website":"https://ebible.org/Scriptures/details.php?id=guj2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=guj2017","licenseNotes":null,"shortName":"IRV","englishName":"Gujarati Indian Revised Version Bible","language":"guj","textDirection":"ltr","sha256":"7d7d4b6cb83226342f549d26490dab4e5df5183bf8b98b248c827e39064d0a34","availableFormats":["json"],"listOfBooksApiLink":"/api/guj_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"ગુજરાતી","languageEnglishName":"Gujarati"},"book":{"id":"PSA","translationId":"guj_irv","name":"ગીતશાસ્ત્ર","commonName":"ગીતશાસ્ત્ર","title":"ગીતશાસ્ત્ર","order":19,"numberOfChapters":150,"sha256":"a0bb256b9ea5b0d3077f9e52cb556ef8c84d7656e9e729260b0bfa227ef11f57","firstChapterNumber":1,"firstChapterApiLink":"/api/guj_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/guj_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"heading","content":["યરુશાલેમનું મહિમાગીત"]},{"type":"hebrew_subtitle","content":["ચઢવાનું ગીત; દાઉદનું."]},{"type":"verse","number":1,"content":[{"text":"જ્યારે તેઓએ","poem":1},{"noteId":113},{"text":"મને કહ્યું કે,","poem":1},{"lineBreak":true},{"text":"“ચાલો આપણે યહોવાહના ઘરમાં જઈએ,” ત્યારે હું આનંદ પામ્યો.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"હે યરુશાલેમ, તારા દ્વારોમાં","poem":1},{"lineBreak":true},{"text":"અમે ઊભા રહ્યા હતા.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"યરુશાલેમ તો હારબંધ ઇમારતોવાળા","poem":1},{"lineBreak":true},{"text":"નગરના જેવું બાંધેલું છે.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ત્યાં કુળો ચઢે છે, યહોવાહનાં કુળો,","poem":1},{"lineBreak":true},{"text":"ઇઝરાયલને સાક્ષીરૂપ થવાને અર્થે,","poem":1},{"lineBreak":true},{"text":"યહોવાહના નામનો આભાર માનવાને માટે કુળો ચઢે છે.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"કેમ કે ત્યાં ઇનસાફનાં રાજ્યાસનો","poem":1},{"lineBreak":true},{"text":"દાઉદના કુટુંબના રાજ્યાસનો સ્થાપવામાં આવેલાં છે.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"યરુશાલેમની શાંતિને માટે પ્રાર્થના કરો!","poem":1},{"lineBreak":true},{"text":"જેઓ તને ચાહે છે તેને શાંતિ મળો.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"તારા કોટની અંદર શાંતિ","poem":1},{"lineBreak":true},{"text":"અને તારા મહેલોની અંદર કુશળતા થાઓ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"મારા ભાઈઓ તથા મારા મિત્રોની ખાતર","poem":1},{"lineBreak":true},{"text":"હવે હું બોલીશ, “તારામાં શાંતિ થાઓ.”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"આપણા ઈશ્વર યહોવાહના ઘરને અર્થે","poem":1},{"lineBreak":true},{"text":"હું તેની ઉત્તમતાને","poem":1},{"noteId":114},{"text":"લીધે પ્રાર્થના કરીશ.","poem":1}]}],"footnotes":[{"noteId":113,"caller":"+","text":"મિત્રો","reference":{"chapter":122,"verse":1}},{"noteId":114,"caller":"+","text":"કલ્યાણ","reference":{"chapter":122,"verse":9}}]},"thisChapterLink":"/api/guj_irv/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/guj_irv/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/guj_irv/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}