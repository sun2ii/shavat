{"translation":{"id":"guj_irv","name":"ઇન્ડિયન રીવાઇઝ્ડ વર્ઝન ગુજરાતી - 2019","website":"https://ebible.org/Scriptures/details.php?id=guj2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=guj2017","licenseNotes":null,"shortName":"IRV","englishName":"Gujarati Indian Revised Version Bible","language":"guj","textDirection":"ltr","sha256":"7d7d4b6cb83226342f549d26490dab4e5df5183bf8b98b248c827e39064d0a34","availableFormats":["json"],"listOfBooksApiLink":"/api/guj_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"ગુજરાતી","languageEnglishName":"Gujarati"},"book":{"id":"PSA","translationId":"guj_irv","name":"ગીતશાસ્ત્ર","commonName":"ગીતશાસ્ત્ર","title":"ગીતશાસ્ત્ર","order":19,"numberOfChapters":150,"sha256":"a0bb256b9ea5b0d3077f9e52cb556ef8c84d7656e9e729260b0bfa227ef11f57","firstChapterNumber":1,"firstChapterApiLink":"/api/guj_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/guj_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":125,"content":[{"type":"heading","content":["પ્રભુના શરણમાં સલામતી"]},{"type":"hebrew_subtitle","content":["ચઢવાનું ગીત."]},{"type":"verse","number":1,"content":[{"text":"જેઓ યહોવાહમાં ભરોસો રાખે છે","poem":1},{"lineBreak":true},{"text":"તેઓ સિયોન પર્વત જેવા અચળ છે, જે કદી ખસનાર નથી, પણ સદાકાળ ટકી રહે છે.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"જેમ યરુશાલેમની આસપાસ પર્વતો આવેલા છે,","poem":1},{"lineBreak":true},{"text":"તેમ આ સમયથી તે સર્વકાળ માટે","poem":1},{"lineBreak":true},{"text":"યહોવાહ પોતાના લોકોની આસપાસ છે.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"દુષ્ટતાનો રાજદંડ ન્યાયીઓના હિસ્સા પર ટકશે નહિ.","poem":1},{"lineBreak":true},{"text":"નહિ તો, ન્યાયીઓ અન્યાય કરવા લલચાય.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"હે યહોવાહ, જેઓ સારા છે","poem":1},{"lineBreak":true},{"text":"અને જેઓનાં હૃદય યથાર્થ છે, તેમનું ભલું કરો.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"પણ જેઓ પોતે આડેઅવળે માર્ગે વળે છે,","poem":1},{"lineBreak":true},{"text":"તેઓને યહોવાહ દુષ્ટોની સાથે લઈ જશે.","poem":1},{"lineBreak":true},{"text":"ઇઝરાયલ પર શાંતિ થાઓ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/guj_irv/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/guj_irv/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/guj_irv/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}