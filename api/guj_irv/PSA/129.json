{"translation":{"id":"guj_irv","name":"ઇન્ડિયન રીવાઇઝ્ડ વર્ઝન ગુજરાતી - 2019","website":"https://ebible.org/Scriptures/details.php?id=guj2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=guj2017","licenseNotes":null,"shortName":"IRV","englishName":"Gujarati Indian Revised Version Bible","language":"guj","textDirection":"ltr","sha256":"7d7d4b6cb83226342f549d26490dab4e5df5183bf8b98b248c827e39064d0a34","availableFormats":["json"],"listOfBooksApiLink":"/api/guj_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"ગુજરાતી","languageEnglishName":"Gujarati"},"book":{"id":"PSA","translationId":"guj_irv","name":"ગીતશાસ્ત્ર","commonName":"ગીતશાસ્ત્ર","title":"ગીતશાસ્ત્ર","order":19,"numberOfChapters":150,"sha256":"a0bb256b9ea5b0d3077f9e52cb556ef8c84d7656e9e729260b0bfa227ef11f57","firstChapterNumber":1,"firstChapterApiLink":"/api/guj_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/guj_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"heading","content":["પ્રભુએ સંભાળેલી ઇઝરાયલ પ્રજા"]},{"type":"hebrew_subtitle","content":["ચઢવાનું ગીત."]},{"type":"verse","number":1,"content":[{"text":"ઇઝરાયલ કહો કે,","poem":1},{"lineBreak":true},{"text":"“તેઓએ મારી યુવાવસ્થાથી મને બહુ દુઃખ આપ્યું છે.”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“મારી યુવાવસ્થાથી તેઓએ મને બહુ જ દુઃખ આપ્યું છે,","poem":1},{"lineBreak":true},{"text":"તેમ છતાં તેઓ મને હરાવી શક્યા નહિ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"મારી પીઠ પર હળ ખેડનારાઓએ હળ ચલાવ્યું છે;","poem":1},{"lineBreak":true},{"text":"તેઓએ લાંબા અને ઊંડા કાપા પાડ્યા છે.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"યહોવાહ ન્યાયી છે;","poem":1},{"lineBreak":true},{"text":"દુષ્ટોએ બાંધેલાં બંધનો તેમણે તોડ્યાં છે","poem":1},{"noteId":118},{"text":".”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"સિયોનને ધિક્કારનારા બધા","poem":1},{"lineBreak":true},{"text":"અપમાનિત થાઓ અને પાછા ફરો.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"તેઓ ધાબા પરના ઘાસના જેવા થાઓ","poem":1},{"lineBreak":true},{"text":"કે તે ઊગે તે પહેલાં કરમાઈ જાય,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"જેથી કાપનાર પોતાનો હાથ","poem":1},{"lineBreak":true},{"text":"અને પૂળા બાંધનાર પોતાની બાથ ભરી શકતો નથી.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"તેઓની પાસેથી જનારા એવું કહેતા નથી કે,","poem":1},{"lineBreak":true},{"text":"“યહોવાહનો આશીર્વાદ તમારા પર હો;","poem":1},{"lineBreak":true},{"text":"યહોવાહના નામે અમે તમને આશીર્વાદ આપીએ છીએ.”","poem":1}]}],"footnotes":[{"noteId":118,"caller":"+","text":"યહોવાહ દુષ્ટોના બંધનોથી બચાવે છે","reference":{"chapter":129,"verse":4}}]},"thisChapterLink":"/api/guj_irv/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/guj_irv/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/guj_irv/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}