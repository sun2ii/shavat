{"translation":{"id":"guj_irv","name":"ઇન્ડિયન રીવાઇઝ્ડ વર્ઝન ગુજરાતી - 2019","website":"https://ebible.org/Scriptures/details.php?id=guj2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=guj2017","licenseNotes":null,"shortName":"IRV","englishName":"Gujarati Indian Revised Version Bible","language":"guj","textDirection":"ltr","sha256":"7d7d4b6cb83226342f549d26490dab4e5df5183bf8b98b248c827e39064d0a34","availableFormats":["json"],"listOfBooksApiLink":"/api/guj_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"ગુજરાતી","languageEnglishName":"Gujarati"},"book":{"id":"PSA","translationId":"guj_irv","name":"ગીતશાસ્ત્ર","commonName":"ગીતશાસ્ત્ર","title":"ગીતશાસ્ત્ર","order":19,"numberOfChapters":150,"sha256":"a0bb256b9ea5b0d3077f9e52cb556ef8c84d7656e9e729260b0bfa227ef11f57","firstChapterNumber":1,"firstChapterApiLink":"/api/guj_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/guj_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"heading","content":["ઇઝરાયલ ઈશ્વરની સ્તુતિ કરે"]},{"type":"verse","number":1,"content":[{"text":"યહોવાહની સ્તુતિ કરો.","poem":1},{"lineBreak":true},{"text":"તેમની સમક્ષ નવું ગીત ગાઓ;","poem":1},{"lineBreak":true},{"text":"સંતોની સભામાં તેમની સ્તુતિ કરો.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ઇઝરાયલ પોતાના સર્જનહારથી આનંદ પામે;","poem":1},{"lineBreak":true},{"text":"સિયોનના લોકો પોતાના રાજાને લીધે આનંદ મનાવો.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"તેઓ તેના નામની સ્તુતિ નૃત્યસહિત કરો;","poem":1},{"lineBreak":true},{"text":"ખંજરી તથા વીણાથી તેમનાં સ્તોત્ર ગાઓ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"કારણ કે યહોવાહ પોતાના લોકોથી આનંદ માને છે;","poem":1},{"lineBreak":true},{"text":"તે નમ્રજનોને ઉદ્ધારથી સુશોભિત કરે છે.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"સંતો વિજયમાં","poem":1},{"noteId":127},{"text":"હરખાઓ;","poem":1},{"lineBreak":true},{"text":"પોતાની પથારીમાં પણ તમે આનંદનાં ગીતો ગાઓ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"તેઓના મુખમાંથી ઈશ્વરની ઉત્તમ સ્તુતિ ગવાઓ","poem":1},{"lineBreak":true},{"text":"અને તેઓના હાથમાં બેધારી તલવાર રહો.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"તેઓ વિદેશીઓને બદલો વાળે","poem":1},{"lineBreak":true},{"text":"અને લોકોને શિક્ષા પહોંચાડે.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"તેઓ પોતાના રાજાઓને સાંકળોથી","poem":1},{"lineBreak":true},{"text":"અને તેઓના હાકેમોને લોખંડની બેડીઓથી બાંધે.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"લખેલો ચુકાદો તેમના પર બજાવે.","poem":1},{"lineBreak":true},{"text":"એવું મન તેમના બધા સંતોને છે.","poem":1},{"lineBreak":true},{"text":"યહોવાહની સ્તુતિ કરો.","poem":1}]}],"footnotes":[{"noteId":127,"caller":"+","text":"મહિમામાં","reference":{"chapter":149,"verse":5}}]},"thisChapterLink":"/api/guj_irv/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/guj_irv/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/guj_irv/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}