{"translation":{"id":"guj_irv","name":"ઇન્ડિયન રીવાઇઝ્ડ વર્ઝન ગુજરાતી - 2019","website":"https://ebible.org/Scriptures/details.php?id=guj2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=guj2017","licenseNotes":null,"shortName":"IRV","englishName":"Gujarati Indian Revised Version Bible","language":"guj","textDirection":"ltr","sha256":"7d7d4b6cb83226342f549d26490dab4e5df5183bf8b98b248c827e39064d0a34","availableFormats":["json"],"listOfBooksApiLink":"/api/guj_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"ગુજરાતી","languageEnglishName":"Gujarati"},"book":{"id":"PSA","translationId":"guj_irv","name":"ગીતશાસ્ત્ર","commonName":"ગીતશાસ્ત્ર","title":"ગીતશાસ્ત્ર","order":19,"numberOfChapters":150,"sha256":"a0bb256b9ea5b0d3077f9e52cb556ef8c84d7656e9e729260b0bfa227ef11f57","firstChapterNumber":1,"firstChapterApiLink":"/api/guj_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/guj_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"heading","content":["સહાય માટે સવારની પ્રાર્થના"]},{"type":"hebrew_subtitle","content":["પોતાના દીકરા આબ્શાલોમથી નાસી જતી વખતનું દાઉદનું ગીત."]},{"type":"verse","number":1,"content":[{"text":"હે યહોવાહ, મારા વેરીઓ કેટલા બધા વધી ગયા છે!","poem":1},{"lineBreak":true},{"text":"મારી સામે હુમલો કરનારા ઘણા છે.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ઘણા મારા વિષે કહે છે,","poem":1},{"lineBreak":true},{"text":"“ઈશ્વર તરફથી તેને કોઈ મદદ મળશે નહિ.” સેલાહ","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"પણ હે યહોવાહ તમે મારી આસપાસ ઢાલરૂપ છો,","poem":1},{"lineBreak":true},{"text":"તમે મારું ગૌરવ તથા મારું માથું ઊંચું કરનાર છો.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"હું મારી વાણીથી યહોવાહને વિનંતી કરું છું","poem":1},{"lineBreak":true},{"text":"અને તે પોતાના પવિત્ર પર્વત પરથી મને ઉત્તર આપે છે. સેલાહ","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"હું સૂઈને ઊંઘી ગયો;","poem":1},{"lineBreak":true},{"text":"હું જાગ્યો, કેમ કે યહોવાહ મારું રક્ષણ કરે છે.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"જે હજારો લોકોએ મને ઘેરી લીધો છે","poem":1},{"lineBreak":true},{"text":"તેઓથી હું બીશ નહિ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"હે યહોવાહ, ઊઠો! મારા ઈશ્વર, મારો બચાવ કરો!","poem":1},{"lineBreak":true},{"text":"કેમ કે તમે મારા સર્વ શત્રુઓનાં જડબાં પર પ્રહાર કર્યો છે;","poem":1},{"lineBreak":true},{"text":"તમે દુષ્ટોના દાંત ભાંગી નાખ્યા છે.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"વિજય","poem":1},{"noteId":1},{"text":"યહોવાહ પાસેથી મળે છે.","poem":1},{"lineBreak":true},{"text":"તમારા લોકો પર તમારો આશીર્વાદ આવો. સેલાહ.","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"ઉદ્ધાર","reference":{"chapter":3,"verse":8}}]},"thisChapterLink":"/api/guj_irv/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/guj_irv/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/guj_irv/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}