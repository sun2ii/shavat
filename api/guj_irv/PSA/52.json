{"translation":{"id":"guj_irv","name":"ઇન્ડિયન રીવાઇઝ્ડ વર્ઝન ગુજરાતી - 2019","website":"https://ebible.org/Scriptures/details.php?id=guj2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=guj2017","licenseNotes":null,"shortName":"IRV","englishName":"Gujarati Indian Revised Version Bible","language":"guj","textDirection":"ltr","sha256":"7d7d4b6cb83226342f549d26490dab4e5df5183bf8b98b248c827e39064d0a34","availableFormats":["json"],"listOfBooksApiLink":"/api/guj_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"ગુજરાતી","languageEnglishName":"Gujarati"},"book":{"id":"PSA","translationId":"guj_irv","name":"ગીતશાસ્ત્ર","commonName":"ગીતશાસ્ત્ર","title":"ગીતશાસ્ત્ર","order":19,"numberOfChapters":150,"sha256":"a0bb256b9ea5b0d3077f9e52cb556ef8c84d7656e9e729260b0bfa227ef11f57","firstChapterNumber":1,"firstChapterApiLink":"/api/guj_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/guj_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":52,"content":[{"type":"heading","content":["ઈશ્વરનું ન્યાયશાસન અને કૃપા"]},{"type":"hebrew_subtitle","content":["મુખ્ય ગવૈયાને માટે દાઉદનું માસ્કીલ:દોએગ અદોમીએ આવીને શાઉલને ખબર આપી કે, દાઉદ અહીમેલેખને ત્યાં આવ્યો છે, તે વખતનું."]},{"type":"verse","number":1,"content":[{"text":"ઓ શક્તિશાળી માણસ, તું તારાં દુષ્ટ કાર્યો","poem":1},{"noteId":37},{"text":"વિષે શા માટે અભિમાન કરે છે?","poem":1},{"lineBreak":true},{"text":"ઈશ્વરની કૃપા સર્વકાળ ટકે છે.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"તારી જીભ દુષ્ટ યોજનાઓ કરે છે","poem":1},{"lineBreak":true},{"text":"અણીદાર અસ્ત્રાની જેમ તે છેતરે છે.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"તું ભલાઈ કરતાં વધારે દુષ્ટતા ચાહે છે","poem":1},{"lineBreak":true},{"text":"અને ન્યાયીપણું બોલવા કરતાં જૂઠું બોલવું તને વધારે ગમે છે.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"અરે કપટી જીભ,","poem":1},{"lineBreak":true},{"text":"તું સર્વ વિનાશકારી વાતો ચાહે છે.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ઈશ્વર સદાને માટે તારો નાશ કરશે;","poem":1},{"lineBreak":true},{"text":"તે તને પકડીને તારા તંબુમાંથી ખેંચી કાઢશે","poem":1},{"lineBreak":true},{"text":"અને પૃથ્વીમાંથી તે તને ઉખેડી નાખશે. સેલાહ","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"વળી ન્યાયીઓ પણ તે જોશે અને ગભરાશે;","poem":1},{"lineBreak":true},{"text":"તેઓ હસીને તેને કહેશે કે,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"“જુઓ, એ આ માણસ છે કે જેણે ઈશ્વરને પોતાનો આશ્રય ન કર્યો,","poem":1},{"lineBreak":true},{"text":"પણ પોતાના ઘણા ધન પર ભરોસો રાખીને","poem":1},{"lineBreak":true},{"text":"પોતાનાં દુષ્કર્મોને વળગી રહ્યો","poem":1},{"noteId":38},{"text":".”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"પણ હું તો ઈશ્વરના ઘરના લીલા જૈતૂનવૃક્ષ જેવો છું;","poem":1},{"lineBreak":true},{"text":"હું ઈશ્વરની કૃપા પર સદાકાળ ભરોસો રાખું છું.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"હે ઈશ્વર, તમે જે કર્યું છે, તે માટે હું તમારી આભારસ્તુતિ સદા કરીશ.","poem":1},{"lineBreak":true},{"text":"હું તમારા નામ પર આશા રાખું છું, કેમ કે તમારું નામ ઉત્તમ છે અને હું તે તમારાં સંતોની સમક્ષ પ્રગટ કરીશ.","poem":1}]}],"footnotes":[{"noteId":37,"caller":"+","text":"ભલા માણસો પ્રત્યે કરેલા દુષ્ટ કાર્યો","reference":{"chapter":52,"verse":1}},{"noteId":38,"caller":"+","text":"તે દુષ્ટ કાર્યોમાં વધી ગયો","reference":{"chapter":52,"verse":7}}]},"thisChapterLink":"/api/guj_irv/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/guj_irv/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/guj_irv/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}