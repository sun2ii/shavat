{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"EST","translationId":"gun_wbt","name":"Ester","commonName":"Ester","title":"Ester rekokue oĩa","order":17,"numberOfChapters":10,"sha256":"a11eb439dc976449a6832e022b7e1729ee814948042fd249f9f892e81e0a43ae","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/EST/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/gun_wbt/EST/10.json","totalNumberOfVerses":167},"chapter":{"number":10,"content":[{"type":"heading","content":["Mordecai yvatevea re ijayvua"]},{"type":"verse","number":1,"content":["Ha'e nunga oikopa ma rire huvixa Assuero ojapo ha'e va'e yvy ha'e ye'ẽ rembe rupi ikuai va'e ha'e javi ixupe opaga aguã."]},{"type":"verse","number":2,"content":["Ha'e gui oĩve rei tema huvixa Assuero rekokue regua. Ha'e rami avi opo'akaa rupi mba'emo ovareve va'e ojapo va'ekue, ha'e Mordecai omboyvateveague ha'e javi noĩ 'rã teve kuaxia Média ha'e Pérsia pygua huvixa kuery rekokue oĩa re?"]},{"type":"verse","number":3,"content":["Mba'eta judeu Mordecai ma huvixa Assuero rembiguai yvateve va'e oiko. Judeu kuery voi omboete vaipa, hetarã kuery ha'e javi omboetepa okuapy, mba'eta ha'e kuery pe mba'emo porã ojapoa rupi anho oiko, ha'e kuery ikuai porã aguã re onhea'ã oikovy guive."]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/EST/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/JOB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink