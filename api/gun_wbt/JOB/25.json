{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"JOB","translationId":"gun_wbt","name":"Jó","commonName":"Jó","title":"Jó rekokue oĩa","order":18,"numberOfChapters":42,"sha256":"bd250c0d2b1a93118edfc932447a729aadaf197ff4d5cd44949247a2554d726b","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/gun_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":25,"content":[{"type":"heading","content":["Nhanderuete renonde avave rei nonhemboeko porã kuaaia rami Bildade ijayvuague"]},{"type":"verse","number":1,"content":["Ha'e ramo Sua pygua Bildade ombovai:"]},{"type":"verse","number":2,"content":[{"text":"— Ha'e rami avi Nhanderuete pegua anho oĩ opena ha'e ipo'aka aguã.","poem":1},{"text":"Ha'e ma ojapo yva yvatevea rupi voi ikuai porãa aguã rami.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Guembiguai xondaro kuery ma ndajaipapapa kuaai 'rã.","poem":1},{"text":"Ixuguigua hexakãa ojope 'rã ha'e javi áry.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ha'e rami rã mba'exa tu avakue onhemboeko porã 'rã Nhanderuete renonde?","poem":1},{"text":"Mba'exa tu kunha gui itui'i va'ekue oiko 'rã iky'a e'ỹ va'e?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ma'ẽ, ha'e oexa rã jaxy eteve voi naendyi","poem":1},{"text":"ha'e jaxy-tata ikuai va'e iky'a e'ỹ va'e ndoikoi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ha'e gui avakue katuve ma taxo rami rive 'rã yvyĩgueve'i.","poem":1},{"text":"Avakue ra'y kuery ma taxo ramigua meme ae ikuai — he'i.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}