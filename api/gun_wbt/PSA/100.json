{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":100,"content":[{"type":"verse","number":1,"content":[{"text":"Yvy jave re pendekuai va'e,","poem":1},{"text":"peroporaei Senhor pevy'aa rupi!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pevy'aa rupi pendekuai Senhor pe ete.","poem":1},{"text":"Henonde pejexa uka pejuvy peporaei reve.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Peikuaa pota pova'e re: Senhor ma Nhanderuete oiko.","poem":1},{"text":"Ha'e ae nhanemoingo rire ixupegua meme jaiko.","poem":2},{"lineBreak":true},{"text":"Nhande kuery ma ixupegua ae,","poem":2},{"lineBreak":true},{"text":"hymba kuery vexa'i openaa va'e.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ixupegua rokẽ rupi peike perovy'aa rupi,","poem":1},{"text":"hoka py peike mboraei reve.","poem":2},{"lineBreak":true},{"text":"Perovy'a, peroporaei hery rupi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mba'eta Senhor ma porayvu va'e.","poem":1},{"text":"Nhanemboaxya rupi oiko 'rã raka'e rã peve,","poem":2},{"lineBreak":true},{"text":"ojeroviapy 'rã oiko ikuai jevy-jevy va'e peve.","poem":2},"Huvixave opena porã va'e reko re ijayvua",{"text":"Mboraeirã Davi ombopara va'ekue.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}