{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"verse","number":1,"content":[{"text":"Senhor aipoe'i xeruvixa pe:","poem":1},{"text":"“Eguapy ke aiporu kuaa regua re,","poem":2},{"lineBreak":true},{"text":"nderovaigua kuery ndepy guýry amoĩ peve”, he'i.","poem":2},{"noteId":79}]},{"type":"verse","number":2,"content":[{"text":"Sião tetã gui Senhor omboaxa 'rã po pygua ndepo'aka aguã.","poem":1},{"text":"Ha'e vy aipoe'i 'rã: “Ndepo'aka ke nderovaigua kuery re”, he'i 'rã.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ha'e gui ma ndepo'akaa ára","poem":1},{"text":"ndevygua kuery ojexa ukapa 'rã ndere ouxea'i rami.","poem":2},{"lineBreak":true},{"text":"Ndevygua kunumigue ma iky'a e'ỹ va'e py onhemonde reve 'rã ikuai,","poem":2},{"lineBreak":true},{"text":"aje'ive'i yxapy ojekuaa va'e rami.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Senhor ouraague ndoguerovai 'rã:","poem":1},{"text":"“Ndee ma sacerdote reĩ raka'e rã peve guarã,","poem":2},{"lineBreak":true},{"text":"Melquisedeque reko rami ndereko va'e vy”, he'i rire.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Senhor reiporu kuaa regua re oĩ va'e ma","poem":1},{"text":"ipoxya ára omou'ũmba 'rã huvixave kuery.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ombopaga 'rã yvy regua kuery,","poem":1},{"text":"omonyẽ 'rã te'õgue anho.","poem":2},{"lineBreak":true},{"text":"Nhoakã omou'ũmba 'rã yvy jave re.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Oikoa rupi yxyry oĩ va'e gui oy'u 'rã oiny,","poem":1},{"text":"ha'e gui oakã omopu'ã ju 'rã ovy.","poem":2}]}],"footnotes":[{"noteId":79,"caller":"+","text":"Apy “Xeruvixa” he'ia ma Cristo re ae ijayvu vy. Ha'e gui “Eguapy ke aiporu kuaa regua re” he'ia ma Nhanderuete ojee rami avi ombopo'aka aguã re ijayvu vy (Mateus 22.41-26; Marcos 12.36, Lucas 20.42-42, Atos 2.32-36; 1 Coríntios 15.24-28; Efésios 1.20; Colossenses 3.1; Hebreus 1.13, 8.1, 10.11-13).","reference":{"chapter":110,"verse":1}}]},"thisChapterLink":"/api/gun_wbt/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}