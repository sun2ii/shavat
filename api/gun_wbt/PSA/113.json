{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"heading","content":["Senhor jaroporaei aguã regua"]},{"type":"verse","number":1,"content":[{"text":"Aleluia!","poem":1},{"text":"Senhor rembiguai pendekuai va'e, peporaei ke,","poem":2},{"lineBreak":true},{"text":"peroporaei Senhor rery.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta'ima'endu'a porãa Senhor rery re,","poem":1},{"text":"aỹ ha'e raka'e rã peve!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kuaray oẽa guive oikea peve","poem":1},{"text":"togueroporaeia Senhor rery!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Senhor ma yvate ete va'e, yvy jave regua áryve,","poem":1},{"text":"hexakãa voi yva áryve oo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mava'e nda'u Senhor Nhanderuete reve joo rami heko va'e?","poem":1},{"text":"Henda openaaty ma yvatea py oĩ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ojero'a 'rã guive oexa aguã","poem":1},{"text":"yva ha'e yvy re mba'emo oiko va'e.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Omopu'ã ju 'rã imo'amy yvy ku'i py omombo pyre,","poem":1},{"text":"yty gui oipe'a 'rã iporiaukue'i,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"huvixa kuery yvýry ju omboguapy imoiny aguã,","poem":1},{"text":"tá, omoĩ 'rã ojeupegua ruvixa kuery reve guarã.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ojapo 'rã kunha imemby e'ỹ va'ekue omemby kuery reve oiko aguã rami.","poem":1},{"text":"Ha'e ramo ovy'a 'rã, kyrĩgue xy oiko vy.","poem":2},{"lineBreak":true},{"text":"Aleluia!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}