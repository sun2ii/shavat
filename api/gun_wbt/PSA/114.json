{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"heading","content":["Egito yvy gui oẽmba jave guare re ima'endu'aague"]},{"type":"verse","number":1,"content":[{"text":"Israel kuery Egito yvy gui oẽ jave,","poem":1},{"text":"Jacó ramymino kuery ayvu mboae py ijayvu va'e ikuaia gui oẽmba jave ma","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Judá kuery gui Nhanderuete ojapo guenda iky'a e'ỹ va'erã,","poem":1},{"text":"ojapo Israel kuery ojeupe guarã ete.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ha'e nunga ye'ẽ oexa vy ojava ovy,","poem":1},{"text":"Jordão yakã voi guakykue katy oxyry raka'e.","poem":2},{"noteId":80}]},{"type":"verse","number":4,"content":[{"text":"Yvyty ikuai va'e opopa vexa ava rami,","poem":1},{"text":"yvy'ã'i voi vexa'i ra'y rami opopa okuapy.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ye'ẽ, mba'e tu oĩ ha'e rami rejava aguã?","poem":1},{"text":"Ha'vy ndee Jordão, mba'e re tu nderakykue katy rejevy?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Peẽ yvyty, mba'e re tu pepopa ri vexa ava rami?","poem":1},{"text":"Ha'vy peẽ yvy'ã, mba'e re tu vexa'i ra'y rami pepo?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndee yvy, eryryi ke Senhor Jacó Ruete renonde.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mba'eta itaty gui ojapo yy ruparã,","poem":1},{"text":"itaova ratã gui ojapo raka'e yvu.","poem":2}]}],"footnotes":[{"noteId":80,"caller":"+","text":"Ye'ẽ Pytã ojavaague ma Êxodo 14 py omombe'u, ha'e rã Jordão yakã guakykue katy ojevyague ma Josué 3 py.","reference":{"chapter":114,"verse":3}}]},"thisChapterLink":"/api/gun_wbt/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}