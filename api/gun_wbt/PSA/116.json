{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":116,"content":[{"type":"heading","content":["Oporai vy Nhanderuete oguerovy'aague"]},{"type":"verse","number":1,"content":[{"text":"Xee ma ayvu Senhor,","poem":1},{"text":"mba'eta ajerure ramo oendu xeayvua.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Xea katy ojero'a vy ojapyxaka rire","poem":1},{"text":"ixupe ajapukai 'rã aikovea ja.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Manoa regua nhuã xemboty va'ekue,","poem":1},{"text":"jexavaia yvykua vaikue guigua xere ipo'aka va'ekue.","poem":2},{"lineBreak":true},{"text":"Ha'e ramo aiko axya ha'e ndavy'aia py ha'a karamboae.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ha'e rami vy ajapukai Senhor rery rupi:","poem":1},{"text":"“ Senhor, eraa jepe ke xerekove!” ha'e va'ekue.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Senhor ma porayvu ha'e heko porã va'e,","poem":1},{"text":"Nhanderuete ma nhanemboaxya rupi oiko va'e.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Senhor ma hi'arandu e'ỹ'i va'e kuery re opena porã va'e.","poem":1},{"text":"Ha'e rami vy ha'a ajupya py xerexa vy xereraa jepe karamboae.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Xenhe'ẽ, ejevy ju ke repytu'u aguã py,","poem":1},{"text":"mba'eta xevy Senhor mba'emo porã ome'ẽ oata aguã rami e'ỹ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ha'e rami vy xenhe'ẽ oepy amano taa gui.","poem":1},{"text":"Oepy xerexa xerexaya gui,","poem":2},{"lineBreak":true},{"text":"xepy guive oepy onhepyxangaa gui.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ha'e ramo Senhor renonde aiko 'rã","poem":1},{"text":"okuave va'e yvy re.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hexe ajerovia va'eri xejeupe xeayvu vy","poem":1},{"text":"“Ajexavai ete rima aikovy”, ha'e va'ekue.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Xepy'a eta rei vy","poem":1},{"text":"“Avakue ikuai va'e ma ijapu va'e meme”, ha'e va'ekue.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Senhor opa mba'e py xevy ojapo porãague re","poem":1},{"text":"mba'e nda'u ame'ẽ 'rã ixupe?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Xereraa jepeague arovy'a vy aupi 'rã karo,","poem":1},{"noteId":81},{"text":"ha'e Senhor rery rupi aroporai 'rã.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Senhor pe ajapopa 'rã anhemboayvuague","poem":1},{"text":"ixupegua kuery ha'e javi oexaa py.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hepy ete va'e Senhor oexa 'rã","poem":1},{"text":"ojeupegua iky'a e'ỹ va'e kuery omano rã.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Senhor, xee ma nerembiguai ete aiko,","poem":1},{"text":"nerembiguai pi'a guive aiko.","poem":2},{"lineBreak":true},{"text":"Remondopa ma xejokuaague.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ha'e ramo ndevy ame'ẽ 'rã roguerovy'aa,","poem":1},{"text":"ha'e Senhor rery rupi aroporai 'rã.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Senhor pe ajapopa 'rã anhemboayvuague,","poem":1},{"text":"ixupegua kuery ha'e javi ikuaia py,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Senhor pegua roka","poem":1},{"text":"Jerusalém mbyte py ae.","poem":2},{"lineBreak":true},{"text":"Aleluia!","poem":2}]}],"footnotes":[{"noteId":81,"caller":"+","text":"Apy ijayvu judeu kuery gueko rami vy Nhanderuete pe mba'emo ome'ẽ aguã re. Tembi'u ha'e vinho oupi 'rã ixupe, ha'e gui oguerovy'aa rupi ho'u 'rã (Salmo 22.23-26; Levítico 7.11-16).","reference":{"chapter":116,"verse":13}}]},"thisChapterLink":"/api/gun_wbt/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}