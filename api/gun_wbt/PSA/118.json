{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":118,"content":[{"type":"heading","content":["Nhandereraa jepea jarovy'a aguã regua"]},{"type":"verse","number":1,"content":[{"text":"Perovy'a ke Senhor, porayvu va'e ramo.","poem":1},{"text":"Mba'eta nhomboaxya opa va'erã e'ỹ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Israel kuery aipo te'i:","poem":1},{"text":"“Tá, nhomboaxya opa va'erã e'ỹ.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Arão ramymino kuery aipo te'i:","poem":1},{"text":"“Tá, nhomboaxya opa va'erã e'ỹ.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Senhor renonde ojererokyjea rupi ikuai va'e ha'e javi aipo te'i:","poem":1},{"text":"“Tá, nhomboaxya opa va'erã e'ỹ.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ha'e gui xee ma ajexavaia py ajapukai Senhor pe.","poem":1},{"text":"Ha'e ramo Senhor oendu vy xerepy karamboae.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xereve Senhor oiko ramo xee ndakyjei 'rã.","poem":1},{"text":"Mba'e tu avakue ojapo 'rã xere?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Senhor xereve oiko xepytyvõarã.","poem":1},{"text":"Ha'e nunga rupi aexa 'rã xere ija'e e'ỹ va'e kuery re aipotaa ojeupity ramo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Avakue re jajerovia 'rãgue py","poem":1},{"text":"ha'eveve Senhor re nhanhemi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Huvixa kuery re jajerovia 'rãgue py","poem":1},{"text":"ha'eveve Senhor re nhanhemi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ha'e javi regua xembojere rei okuapy,","poem":1},{"text":"teĩ Senhor rery rupi amomba.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jova-jovai gui xejokopa,","poem":1},{"text":"teĩ Senhor rery rupi amomba.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Eiru rami ete xeao'i okuapy,","poem":1},{"text":"teĩ tata py juu okaia rami okaipa.","poem":2},{"lineBreak":true},{"text":"Senhor rery rupi amomba.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Opoxya rupi xemoanha ratã heravy xereity aguã,","poem":1},{"text":"teĩ Senhor xepytyvõ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Senhor ma xemombaraetea oiko, aroporaei va'e guive,","poem":1},{"text":"xereraa jepe rire.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Heko porã va'e rekoa rupi onhendu","poem":1},{"text":"heraa jepeare oguerovy'a va'e:","poem":2},{"lineBreak":true},{"text":"“ Senhor opo'akaa rupi ojapo mba'emo porã!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Senhor opo oupi vy","poem":1},{"text":"mba'emo porã ojapo” he'i va'e.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Xee ma namanovei 'rã.","poem":1},{"text":"Ha'e rami 'rãgue py aikove 'rã,","poem":2},{"lineBreak":true},{"text":"Senhor ojapo va'ekue amombe'upa aguã.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Senhor xembopaga ete,","poem":1},{"text":"teĩ manoa pe naxemboaxai guive.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Peipe'a ke xevy teko porã rokẽ,","poem":1},{"text":"ha'e va'e rupi aike vy Senhor aroporaei aguã.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ha'e va'e ae ma Senhor rokẽ,","poem":1},{"text":"ha'e va'e rupi heko porã va'e anho 'rã oike.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Xee rogueroporaei 'rã,","poem":1},{"text":"xepytyvõ vy xereraa jepe rire.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Oo apoa kuery ita omombo va'ekue ma","poem":1},{"text":"yvatevea py opyta iporãvea pyguarã.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ha'e nunga ma Senhor ae ojapo,","poem":1},{"text":"ha'e jaexa rã iporã ete va'e.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kova'e ára ma Senhor omoingo va'ekue.","poem":1},{"text":"Ha'e ramo javy'a ha'e jarovy'a 'rã.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Senhor, orereraa jepe ke, rojerure!","poem":1},{"text":"Oremoingo porã ke, Senhor!","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ima'endu'a porãmby toiko Senhor rery rupi ou va'e!","poem":1},{"text":"Senhor pegua opy peẽ kuery ha'e javi peike va'e rogueroayvu porã.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Senhor ma Nhanderuete ha'e nhanemoexakãa.","poem":1},{"text":"Ngaru oiko aguã py pembojegua mba'emo rogue py,","poem":2},{"lineBreak":true},{"text":"altar apy peve.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ndee ma Xeruete, xee rogueroporaei 'rã.","poem":1},{"text":"Ndee Xeruete, xee aikuaa uka 'rã ndeyvatea.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Perovy'a ke Senhor, porayvu va'e ramo.","poem":1},{"text":"Mba'eta nhomboaxya opa va'erã e'ỹ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}