{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"verse","number":1,"content":[{"text":"Ajexavaia py ajapukai Senhor pe.","poem":1},{"text":"Ha'e ramo oendu xeayvu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Senhor, xereraa jepe ke apu rupi ijayvu va'e gui,","poem":1},{"text":"nhombotavypaa rupi ijayvu va'e kuery gui.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nhombotavypaa rupi ndeayvu va'e,","poem":1},{"text":"mba'e 'rã tu ndereko rekovia ome'ẽa,","poem":2},{"lineBreak":true},{"text":"mba'e 'rã tu ndevy guarã omboua?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nembopagaa 'rã ipy'a guaxuve va'e ru'y hakua va'e py,","poem":1},{"text":"tapyĩ hexakã va'e zimbro guigua py guive.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xevy pe nda'evei ete yvy mboae regua Meseque,","poem":1},{"text":"Quedar pygua kuery rekoa rupi aikoa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yma ete ma ha'e py aiko,","poem":1},{"text":"peteĩ rami nda'ikuaixei va'e kuery mbyte.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Xee ma peteĩ rami orekuai aguã re xeayvu teĩ","poem":1},{"text":"ha'e kuery ma joe opu'ã aguã re anho onhea'ã okuapy.","poem":2},"Nhandere Nhanderuete onhangarekoa re ijayvua",{"text":"Oguataa rupi ikuai va'e oporaei aguã.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}