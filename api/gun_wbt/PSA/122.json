{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"verse","number":1,"content":[{"text":"Xevy pe “Jaje'oi ke Senhor pegua oo py”","poem":1},{"text":"'ea rã aendu vy avy'a ete.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndee Jerusalém tetã,","poem":1},{"text":"orepy ovaẽ ma nerokẽ py.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jerusalém ma tetã peteĩ henda'i py ojapo pyre.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ha'e katy oje'oi 'rã Senhor pegua kuery ha'e javi regua,","poem":1},{"text":"Senhor rery oguerovy'a aguã","poem":2},{"lineBreak":true},{"text":"Israel kuery oje'oi aguã va'e.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ha'e py ma ikuai ha'evea rami oikuaa pota va'e renda,","poem":1},{"text":"Davi ramymino kuery openaaty ikuai.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pejerure ke Jerusalém oĩ porã aguã.","poem":1},{"text":"Ndererovy'a va'e kuery ta'ikuai porã avi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndekora mbyte ikuai va'e ta'ikuai porã,","poem":1},{"text":"huvixave ro pygua kuery voi topytu'u porã.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Xeryvy kuery, xeirũ kuery re ama'ẽ vy","poem":1},{"text":"Jerusalém tetã re ajerure:","poem":2},{"lineBreak":true},{"text":"“Toĩ ha'e py ikuai porã aguã”, ha'e.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Senhor Nhanderuete pegua oo re ama'ẽ vy","poem":1},{"text":"anhea'ã 'rã aikovy oĩ porã aguã.","poem":2},"Nhanderuete oipytyvõ aguã ojerureague",{"text":"Oguataa rupi ikuai va'e oporaei aguã.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}