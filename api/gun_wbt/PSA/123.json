{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":123,"content":[{"type":"verse","number":1,"content":[{"text":"Xee ama'ẽ ne'amba re reiko va'ea katy.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tembiguai herekoa po gui mba'emo oarõ va'e,","poem":1},{"text":"tembiguai kunha mba'e herekoa po re oma'ẽ va'e rami","poem":2},{"lineBreak":true},{"text":"ore kuery voi roma'ẽ ndea katy","poem":2},{"lineBreak":true},{"text":"oremboaxy peve, Senhor Oreruete.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Senhor, endu ke oremboaxya, oremboaxy ke,","poem":1},{"text":"mba'eta orere ija'e e'ỹ va'e anho ikuai.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Orenhe'ẽ py roendu ha'e kuery ae oipotaa rami orembojaru reia anho,","poem":1},{"text":"ojejou porã rei va'e kuery orere nda'ija'eia roendu.","poem":2},"Nhanderuete nhanderepya ha'e nhandereraa jepea re ijayvua",{"text":"Oguataa rupi ikuai va'e oporaei aguã Davi ombopara va'ekue.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}