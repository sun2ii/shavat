:1},{"text":"guyra mbo'aa nhuã gui oo jepea rami.","poem":2},{"lineBreak":true},{"text":"Nhuã omondo ramo jaa jepe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Senhor yva ha'e yvy apoare rery rupi","poem":1},{"text":"jajapukai ramo ou nhanepytyvõarã.","poem":2},"Jajeroviaa re nhaĩ atã aguã regua",{"text":"Oguataa rupi ikuai va'e oporaei aguã.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}