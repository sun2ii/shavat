{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":125,"content":[{"type":"verse","number":1,"content":[{"text":"Senhor re ojerovia va'e ma Sião yvyty rami ikuai.","poem":1},{"text":"Ha'e va'e ma nomyĩ 'rã, oĩ atã 'rã raka'e rã peve guarã.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jerusalém tetã yvýry rupi yvyty ikuai va'e rami","poem":1},{"text":"Senhor opena 'rã ojeupegua kuery yvýry,","poem":2},{"lineBreak":true},{"text":"aỹ guive raka'e rã peve.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Heko porã va'e kuery re","poem":1},{"text":"heko vai va'e nda'ipo'aka riaei 'rã,","poem":2},{"lineBreak":true},{"text":"heko porã va'e opo py ojapo vai e'ỹ aguã.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Senhor, emoingo porã ke heko porã va'e,","poem":1},{"text":"anhetẽ rupi ipy'a va'e kuery.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ha'e rã tape karẽ rupi opia va'e ma","poem":1},{"text":"Senhor ombopaga 'rã heko vai va'e kuery reve.","poem":2},{"text":"Israel kuery re toĩ ikuai porã aguã.","poem":1},"Ojae'o va'e ombopy'a porãa jevy aguã regua",{"text":"Oguataa rupi ikuai va'e oporaei aguã.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}