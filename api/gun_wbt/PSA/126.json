{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"verse","number":1,"content":[{"text":"Senhor Sião tetã py nhanemoingo porã ju ramo","poem":1},{"text":"oexa ra'u va'e rami nhandekuai va'ekue.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ha'e jave py nhanderory,","poem":1},{"text":"javy'aa rupi nhandeayvu guive.","poem":2},{"lineBreak":true},{"text":"Ha'e ramo amboae regua kuery joupe-upe aipoe'i:","poem":2},{"lineBreak":true},{"text":"“Ha'e kuery pe Senhor ojapo porã ete”, he'i okuapy.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Anhetẽ Senhor nhanemoingo porã va'ekue.","poem":1},{"text":"Ha'e nunga rupi ae javy'a.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Senhor, peteĩgue ju ke oremoingo porã,","poem":1},{"text":"Neguebe rupi yy oxyry va'e rami.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hexay reve mba'emo ra'yĩgue onhotỹ va'ekue ma","poem":1},{"text":"ovy'a reve ju 'rã omono'õ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ojae'o reve onhotỹ ovy va'ekue ma","poem":1},{"text":"ovy'a vaipa reve 'rã ojevy ouvy,","poem":2},{"lineBreak":true},{"text":"mba'emo aju jokuaa ogueru vy.","poem":2},"Nhanderuete gui iporã va'e ha'e javi oua re ijayvua",{"text":"Oguataa rupi ikuai va'e Salomão ombopara va'ekue.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}