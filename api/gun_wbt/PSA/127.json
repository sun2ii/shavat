{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"verse","number":1,"content":[{"text":"Senhor ae oorã ojapo e'ỹ ramo","poem":1},{"text":"ijapoa kuery omba'eapoa mba'everã ndovarei 'rã.","poem":2},{"lineBreak":true},{"text":"Tetã re Senhor nonhangarekoi ri ramo","poem":2},{"lineBreak":true},{"text":"harõa kuery onhangarekoa mba'everã ndovarei 'rã.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nda'eve ranhei ko'ẽ e'ỹ mbove nhapu'ãa,","poem":1},{"text":"ndajake voia, neĩ jajexavaia rupi mbojape jajoua.","poem":2},{"lineBreak":true},{"text":"Mba'eta hembiayvu kuery okepa okuapy reve voi","poem":2},{"lineBreak":true},{"text":"ha'e kuery pe ome'ẽ 'rã mba'emo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nhandera'y kuery ma Senhor ome'ẽ va'ekue meme,","poem":1},{"text":"guyru'i gui oiko'i va'e ma nhandevy guarã ome'ẽ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nhanekunumi jave nhandera'y kuery jareko va'e ma","poem":1},{"text":"opo py xondaro hu'y oguereko va'e rami.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ovy'a ete 'rã avakue hyru py oguereko reta va'e.","poem":1},{"text":"Tetã rokẽ py ngovaigua kuery reve jogueroayvu","poem":2},{"lineBreak":true},{"text":"teĩ nda'ipo'aka e'ỹi 'rã.","poem":2},"Nhanderuete renonde jajererokyjea rupi vy javy'a aguã regua",{"text":"Oguataa rupi ikuai va'e oporaei aguã.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}