{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":128,"content":[{"type":"verse","number":1,"content":[{"text":"Ovy'a ete 'rã Senhor renonde ojererokyjea rupi ikuai va'e,","poem":1},{"text":"ixuguigua tape rupi ikuai vy.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Remba'eapoa rupi rejou 'rã re'u va'erã.","poem":1},{"text":"Revy'a ete 'rã, ha'e opa mba'e oiko porã 'rã ndevy.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndero py ma ndera'yxy uva hi'a reta va'e rami 'rã oiko,","poem":1},{"text":"ha'e ndera'y kuery ma oliveira rembypy pyau'i rami meme 'rã ikuai mesa yvýry oguapya py.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ha'e rami Senhor renonde ojererokyjea rupi ikuai va'e ma omoingo porã 'rã.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Senhor tanemoingo porã Sião tetã gui,","poem":1},{"text":"reikove reve rexa aguã","poem":2},{"lineBreak":true},{"text":"Jerusalém tetã py omoingo porã rã.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Rexa 'rã neramymino kuery.","poem":1},{"text":"Israel kuery re toĩ ikuai porã aguã.","poem":2},"Ogueraa jepeague re ima'endu'aa",{"text":"Oguataa rupi ikuai va'e oporaei aguã.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}