{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"verse","number":1,"content":[{"text":"Xekunumi guive mbovykue rei e'ỹ xembojexavaia —","poem":1},{"text":"Israel kuery aipo te'i —","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Xekunumi guive xembojexavaia okuapy","poem":1},{"text":"teĩ xere nda'ipo'akaai.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Xekupe rupi xekaraĩmbaa ma,","poem":1},{"text":"yvy karaĩa py rami xemboperepa vy.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ha'e rami teĩ Senhor heko porã va'e vy","poem":1},{"text":"ojayapa heko vai va'e xejokuaague.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sião tetã re opu'ã va'e ha'e javi","poem":1},{"text":"toxĩmba, tojavapa guive.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Oo áry mba'emo rogue henhoĩ vy","poem":1},{"text":"ipoty e'ỹ re ipirupa va'e rami avi tokanhymba.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ha'e nunga mba'everã ndovarei ramo","poem":1},{"text":"avave rei opo py nomono'õai,","poem":2},{"lineBreak":true},{"text":"neĩ ojyva áry ndojokuaai heruvy guive.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ha'e kuerya rupi oaxa va'e kuery aipo te'i eme:","poem":1},{"text":"“ Senhor topena porã pendere!","poem":2},{"lineBreak":true},{"text":"Senhor rery rupi ore rogueroayvu porã!” te'i eme.","poem":2},"Yy typyvea gui ojapukaia ague",{"text":"Oguataa rupi ikuai va'e oporaei aguã.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}