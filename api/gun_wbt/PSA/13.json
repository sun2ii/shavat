{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"heading","content":["Ojeroviaa rupi ojerurea ague"]},{"type":"hebrew_subtitle","content":["Jogueroporaei va'e pe Davi ombopara va'ekue."]},{"type":"verse","number":1,"content":[{"text":"Senhor, raka'e peve 'rã tu nderexarai xegui?","poem":1},{"text":"Raka'e peve 'rã tu xevy pe nderejexa ukavei?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Raka'e peve 'rã tu nda'evei riae xepy'a py?","poem":1},{"text":"Mba'eta ko'ẽ nhavõ xepy'a py aendu ndavy'aia.","poem":2},{"lineBreak":true},{"text":"Raka'e peve 'rã tu xerovaigua xere opu'ã rei?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Senhor Xeruete, eikuaa pota ke xere, xembovai guive!","poem":1},{"text":"Xemboexa pyxo, manoa py ake e'ỹ aguã,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"xerovaigua kuery “Xepo'aka ma hexe” he'i e'ỹ aguã,","poem":1},{"text":"ha'e xerovaigua kuery xekangy ramo oexa vy ovy'a rei e'ỹ aguã.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ha'e rã xee ma ajerovia ndere xemboaxya rupi xerereko aguã.","poem":1},{"text":"Xepy'a py arovy'a xereraa jepea.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Aporaei 'rã Senhor pe,","poem":1},{"text":"opa mba'e py xemoingo porã rire.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}