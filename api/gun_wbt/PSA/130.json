{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"verse","number":1,"content":[{"text":"Senhor, yy typyve etea gui ajapukai ndevy.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Senhor, endu ke ajapukaia!","poem":1},{"text":"Ndevy pe ajerurea re ejapyxaka pota ke.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Senhor, rojejavyague re reikuaa pota va'e rire","poem":1},{"text":"mava'e 'rãgue tu oo jepe?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ha'e rami avi ndere oĩ oreperdoa aguã,","poem":1},{"text":"nerenonde rojererokyjea rupi roiko aguã.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xee ma arõ aikovy Senhor,","poem":1},{"text":"xenhe'ẽ py arõ ijayvuague rupi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tetã rarõa kuery ko'ẽ aguã re ojapuraa gui","poem":1},{"text":"xenhe'ẽ py Senhor arõve.","poem":2},{"noteId":83},{"text":"Harõa kuery ko'ẽ aguã re ojapuraa gui","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Israel kuery toarõve Senhor.","poem":1},{"text":"Mba'eta Senhor re oĩ nhomboaxy aguã,","poem":2},{"lineBreak":true},{"text":"opa mba'e gui joepy aguã guive.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ha'e ae ma ogueraa jepe 'rã Israel kuery","poem":1},{"text":"heko vai ha'e javi gui.","poem":2},"Nhanderuete re vy japytu'u aguã regua",{"text":"Oguataa rupi ikuai va'e oporaei aguã Davi ombopara va'ekue.","descriptive":true}]}],"footnotes":[{"noteId":83,"caller":"+","text":"Ha'e va'e jave py pytũ mbukukue re tetã rarõa kuery opyta 'rã ikora áry, ngovaigua kuery ovaẽ rã oexa aguã.","reference":{"chapter":130,"verse":6}}]},"thisChapterLink":"/api/gun_wbt/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}