{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":131,"content":[{"type":"verse","number":1,"content":[{"text":"Senhor, xepy'a py xee ajejou porã rei va'e'ỹ.","poem":1},{"text":"Ama'ẽa py nanhemboyvatei guive,","poem":2},{"lineBreak":true},{"text":"mba'emo tuvixa va'e re nda'eveia rupi e'ỹ aiko.","poem":2},{"lineBreak":true},{"text":"Mba'eta mba'emo iporãve ete va'e ma xevy guarã e'ỹ ae.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ha'e rami 'rãgue py akyrirĩ vy apytu'u 'rã xepy'a py.","poem":1},{"text":"Kyrĩ'i va'e nokambuvei va'e oxy jyva áry oĩ rive'i va'e rami ae avi","poem":2},{"lineBreak":true},{"text":"xekuraxõ voi oĩ xepy'a py.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Israel kuery, pearõ ke Senhor,","poem":1},{"text":"aỹ guive raka'e rã peve.","poem":2},"Ymave ijayvua ague",{"text":"Oguataa rupi ikuai va'e oporaei aguã.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}