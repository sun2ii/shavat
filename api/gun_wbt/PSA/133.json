{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":133,"content":[{"type":"verse","number":1,"content":[{"text":"Joegua kuery peteĩ rami ikuaia ma","poem":1},{"text":"ha'eve 'rã, iporã ete guive.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ha'e rami ikuaia ma azeite hepyve va'e","poem":1},{"text":"sacerdote Arão akã re onhoẽ ramo","poem":2},{"lineBreak":true},{"text":"hendyva re oxyry ovy vy","poem":2},{"lineBreak":true},{"text":"ijao aju'y peve ovaẽ va'e rami.","poem":2},{"noteId":87}]},{"type":"verse","number":3,"content":[{"text":"Ha'e rami ikuaia ma Hermom yvyty gui yxapy ou va'e","poem":1},{"text":"Sião yvyty ombo'yxapypa va'e rami.","poem":2},{"noteId":88},{"lineBreak":true},{"text":"Mba'eta ha'e py Senhor ombou nhomoingo porãarã,","poem":2},{"lineBreak":true},{"text":"ha'e tekove raka'e rã peve guarã.","poem":2},"Ka'aru'i jave oporaeia aguã oenoĩa ague",{"text":"Oguataa rupi ikuai va'e oporaei aguã.","descriptive":true}]}],"footnotes":[{"noteId":87,"caller":"+","text":"Sacerdote-rã Arão omoĩa vy inhakã re omoĩ raka'e azeite (Êxodo 29.1-9), Nhanderuete ojeupegua kuery omoingo porã aguã kuaa ukaarã (Êxodo 29.43-46).","reference":{"chapter":133,"verse":2}},{"noteId":88,"caller":"+","text":"Yxapy py Nhanderuete omoingo porã 'rã ha'e kuery onhotỹ va'ekue (Gênesis 27.28).","reference":{"chapter":133,"verse":3}}]},"thisChapterLink":"/api/gun_wbt/PSA/133.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/134.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/132.json","previousChapterAudioLinks":{},"numberOfVerses":3}