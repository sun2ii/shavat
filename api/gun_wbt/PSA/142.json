{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"verse","number":1,"content":[{"text":"Senhor pe ajapukai, xeayvu ainy.","poem":1},{"text":"Ajapukai vy xepytyvõ aguã re ajerure.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ixupe amombe'upa ndavy'aia,","poem":1},{"text":"henonde amombe'upa ajexavaia.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Xee nanhanimavei ma aikovy ramo","poem":1},{"text":"ndee reikuaa 'rã aikoa ha'e javi.","poem":2},{"text":"Tape aguata aguã rupi xerovaigua kuery omoĩ 'rã nhuã.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ema'ẽ na aiporu kuaa regua re, ha'e exa pota,","poem":1},{"text":"mba'eta avave rei ndoikoi xerexa kuaa va'e.","poem":2},{"lineBreak":true},{"text":"Jipoi anhemi aguã,","poem":2},{"lineBreak":true},{"text":"xere avave rei noma'ẽ potai guive.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Senhor, ndevy pe ae ajapukai.","poem":1},{"text":"Ha'e vy aipoa'e: “Ndee ae anhemiaty.","poem":2},{"lineBreak":true},{"text":"Xevy guarã ndee anho reiko ko yvy re aikoa py.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Endu ke ajapukaia,","poem":1},{"text":"xekangy vaipa ete ramo.","poem":2},{"lineBreak":true},{"text":"Xereraa jepe xerakykue monha va'e kuery gui,","poem":2},{"lineBreak":true},{"text":"xegui ha'e kuery imbaraeteve ramo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Enoẽ xerekovea nhuã gui,","poem":1},{"text":"nderery rupi arovy'a aguã.","poem":2},{"lineBreak":true},{"text":"Heko porã va'e kuery oupa 'rã xeyvýry,","poem":2},{"lineBreak":true},{"text":"xevy pe ha'e rami rejapo porã rire.","poem":2},"Ogueraa jepe aguã ojerureague",{"text":"Mboraeirã Davi ombopara va'ekue.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}