{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":143,"content":[{"type":"verse","number":1,"content":[{"text":"Senhor, endu ke anhembo'ea.","poem":1},{"text":"Ejapyxaka ajerurea re.","poem":2},{"lineBreak":true},{"text":"Xembovai ke, ojeroviapy ha'e heko porã va'e reiko vy.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nerembiguai aiko ramo xemboayvu eme,","poem":1},{"text":"mba'eta nerenonde heko porã ete va'e ndoikoi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ha'e gui xerovaigua kuery ma xerakykue monha,","poem":1},{"text":"yvy rupi xereity vy xere opyrõmba.","poem":2},{"lineBreak":true},{"text":"Xemoĩ pytũa py,","poem":2},{"lineBreak":true},{"text":"yma ete ma omano va'ekue rami.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ha'e nunga rupi xenhe'ẽ nonhanimavei,","poem":1},{"text":"xepy'a eta rei ma guive.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xema'endu'a teĩ yma guare re.","poem":1},{"text":"Aikuaa pota aikovy nerembiapokue ha'e javi re,","poem":2},{"lineBreak":true},{"text":"xema'endu'a ndepo py rejapo va'ekue re.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ha'e nunga rupi xepo aupi ndevy.","poem":1},{"text":"Xenhe'ẽ nda'evei ndere, yvy ipiru reia rami.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Senhor, xembovai voi ke,","poem":1},{"text":"mba'eta xenhe'ẽ py nanhanimavei ma.","poem":2},{"lineBreak":true},{"text":"Ejexa uka e'ỹ eme xevy,","poem":2},{"lineBreak":true},{"text":"omanogue rupa py oguejy va'e rami apyta e'ỹ aguã.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndere ajerovia ramo","poem":1},{"text":"aje'ive reve taendu ndegui xemboaxya.","poem":2},{"lineBreak":true},{"text":"Ndere xenhe'ẽ aroma'endu'a ramo","poem":2},{"lineBreak":true},{"text":"exa uka tape aguata aguã va'e.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Senhor, xereraa jepe ke xerovaigua kuery gui,","poem":1},{"text":"mba'eta ndee ma anhemiaty.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Xembo'e ke ndee reipotaa rupi aiko aguã,","poem":1},{"text":"mba'eta ndee ae Xeruete.","poem":2},{"lineBreak":true},{"text":"Nenhe'ẽ Porã taxerereko","poem":2},{"lineBreak":true},{"text":"yvy joja porãa rupi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Senhor, nderery re vy xemoingove.","poem":1},{"text":"Ha'evea rami rejoguerekoa rupi","poem":2},{"lineBreak":true},{"text":"eipe'a xenhe'ẽ ojexavaia gui.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xemboaxya rupi emokanhymba xerovaigua kuery.","poem":1},{"text":"Emomba ke xenhe'ẽ mbojexavaia kuery ha'e javi,","poem":2},{"lineBreak":true},{"text":"nerembiguai aiko ramo.","poem":2},"Nhanderuete oepy rire oguerovy'aa ague",{"text":"Mboraeirã Davi ombopara va'ekue.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}