{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"heading","content":["Nhanderuete re ojerovia va'e kuery ogueroporaei aguã regua"]},{"type":"verse","number":1,"content":[{"text":"Aleluia!","poem":1},{"text":"Pemonhendu Senhor pe mboraei pyau!","poem":2},{"lineBreak":true},{"text":"Peroporaei ixupegua kuery iky'a e'ỹ va'e ijatya py.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Israel kuery toguerovy'a imoingoare.","poem":1},{"text":"Sião pygua kuery toguerovy'a nguvixave.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Peroporaei hery mimby pemonhe'ẽ reve.","poem":1},{"text":"Ixupe peporaei salmos, pandeiro ha'e mba'epu ixã reta va'e pembojoguy vy.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mba'eta Senhor oguerovy'a ojeupegua kuery.","poem":1},{"text":"Yvyĩgue'i re omoĩ oo jepe aguã.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ixupegua kuery iky'a e'ỹ va'e toguerovy'a hexakãa.","poem":1},{"text":"Ovy'aa rupi toporaei ngupa py.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ha'e kuery juru py toĩ Nhanderuete pe oporaei atã aguã,","poem":1},{"text":"ha'e ipo py ma toĩ kyxe haimbe jovai va'e,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"yvy regua kuery ikuaia rupi nhombopaga aguã,","poem":1},{"text":"amboae regua ombopaga aguã,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"huvixave kuery corrente py oipokua aguã,","poem":1},{"text":"ha'e yvatekueve ferro guigua py","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ha'e kuery ombopaga aguã ayvu ombopara pyre rami vy,","poem":1},{"text":"ixupegua kuery iky'a e'ỹ va'e ha'e javi omboetea aguã.","poem":2},{"lineBreak":true},{"text":"Aleluia!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}