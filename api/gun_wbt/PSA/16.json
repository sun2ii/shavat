{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":16,"content":[{"type":"heading","content":["Nhanderuete pegua iky'a e'ỹ va'e reko re ijayvua"]},{"type":"hebrew_subtitle","content":["Davi oporaeiague."]},{"type":"verse","number":1,"content":[{"text":"Xeruete, epena porã ke xere,","poem":1},{"text":"ndere anhemi rire.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Senhor pe aipoa'e: “Ndee ma xe-Senhor.","poem":1},{"text":"Iporãve va'e xee ndarekoi ndee e'ỹ vy.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ha'e gui ndevygua iky'a e'ỹ va'e yvy re ikuai va'e ma","poem":1},{"text":"xee arovy'a vy ha'e kuery pe ‘Yvatekueve’ ha'e.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ha'e rã amboae tuueterã re Senhor omboekovia va'e kuery ma ikuai axy 'rã.","poem":1},{"text":"Ha'e kuery ruete pe xee name'ẽi 'rã tuguy revegua,","poem":2},{"lineBreak":true},{"text":"neĩ ndaxeayvui 'rã hery rupi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Senhor anho oiko mba'emo xevygua me'ẽa, xekaro pygua me'ẽa guive.","poem":1},{"text":"Ndee anho remoĩ xerenonderã.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ha'e ramo xevygua ma ha'eve va'e,","poem":1},{"text":"xevy guarã ma iporã va'e meme.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Aroayvu porã 'rã Senhor xemo'arandua,","poem":1},{"text":"pyávy voi xemongeta xepy'a re.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Xema'endu'a riae Senhor xereve oikoa re.","poem":1},{"text":"Xeyvýry oĩ ramo ndaxereityai 'rã.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ha'e rã xekuraxõ py avy'a,","poem":1},{"text":"xenhe'ẽ ovy'a,","poem":2},{"lineBreak":true},{"text":"xerete avi opytu'u porã 'rã.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mba'eta xerekovea nderejai 'rã manoa py,","poem":1},{"text":"Ndevygua iky'a e'ỹ va'e nderejai 'rã ivaipa aguã py.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Xevy rexa uka 'rã tape tekove katy oo va'e.","poem":1},{"text":"Nerenonde oĩ avy'a ete aguã,","poem":2},{"lineBreak":true},{"text":"ndeyvýry oĩ xembovy'a va'e raka'e rã peve guarã.","poem":2},{"noteId":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"Kova'e ayvu rupi Pedro ijayvu Jesus rekokue omombe'u vy (Atos 2.22-36), ha'e gui Paulo ju ijayvu (Atos 13.32-37; 1 Coríntios 15.4).","reference":{"chapter":16,"verse":11}}]},"thisChapterLink":"/api/gun_wbt/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}