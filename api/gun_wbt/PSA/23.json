{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"heading","content":["“Xere Senhor opena” he'ia"]},{"type":"hebrew_subtitle","content":["Mboraeirã Davi ombopara va'ekue."]},{"type":"verse","number":1,"content":[{"text":"Senhor ma vexa'i mongarua rami xere opena va'e oiko.","poem":1},{"noteId":8},{"text":"Ha'e ramo xevy pe ndoatai 'rã mba'eve rei.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Xemombytu'u 'rã inony nhuũndy porã py rami.","poem":1},{"text":"Xereraa 'rã yy iky'a e'ỹ va'e py.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Omombaraete kuerei 'rã xenhe'ẽ.","poem":1},{"text":"Tape teko porã rupi 'rã xerereko,","poem":2},{"lineBreak":true},{"text":"guery omboete ukaa rupi vy.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yvyugua manoa guy pytũ reia rupi aiko teĩ","poem":1},{"text":"ndakyjei 'rã mba'eve rei gui,","poem":2},{"lineBreak":true},{"text":"xereve ndee reiko ramo.","poem":2},{"lineBreak":true},{"text":"Ndepo pygua ha'e ndepopoka ma xembopy'a guaxu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Rereko katu akaru aguã","poem":1},{"noteId":9},{"text":"xerovaigua kuery oexaa py.","poem":2},{"lineBreak":true},{"text":"Xeakã re renhoẽ 'rã azeite.","poem":2},{"lineBreak":true},{"text":"Xekaro remonyẽ 'rã onheẽmba rei peve.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Anhetẽ xereve oĩ 'rã ndeporayvua ha'e xemboaxya ára nhavõ, aikovea pukukue re.","poem":1},{"text":"Ha'e gui Senhor ro py aiko 'rã raka'e rã peve.","poem":2}]}],"footnotes":[{"noteId":8,"caller":"+","text":"Apy ma vexa'i mongarua re ombojoja, Nhanderuete nhandere openaa re ijayvu vy (Apocalipse 7.15-17).","reference":{"chapter":23,"verse":1}},{"noteId":9,"caller":"+","text":"Apy ma hoo va'e nhomovaẽ porã va'e re ombojoja. Ha'e va'e jave py hoo va'e ipoua kuery omovaẽ porã vy azeite onhoẽ'i vy oikyty 'rã inhakã re (Lucas 7.46).","reference":{"chapter":23,"verse":5}}]},"thisChapterLink":"/api/gun_wbt/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}