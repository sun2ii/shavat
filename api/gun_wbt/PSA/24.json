{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":24,"content":[{"type":"heading","content":["Huvixave hexakãmba va'e ou aguã re ijayvua"]},{"type":"hebrew_subtitle","content":["Mboraeirã Davi ombopara va'ekue."]},{"type":"verse","number":1,"content":[{"text":"Senhor mba'e ae itui yvy ha'e opa mba'e hexe ikuai va'e,","poem":1},{"text":"yvy regua kuery ha'e javi guive.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mba'eta ha'e onhono raka'e ye'ẽ áry rupi,","poem":1},{"text":"yy oxyry va'e áry omombyta.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Marã ramigua tu ha'eve Senhor pegua yvyty re oẽ aguã?","poem":1},{"text":"Marã ramigua nda'u ha'eve henda iky'a e'ỹ va'e py oiko aguã?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Opo py ojejavy e'ỹ va'e, ipy'a ky'a e'ỹ va'e,","poem":1},{"text":"tuuete ramigua ovare e'ỹ va'e re onhe'ẽ nogueroma'endu'ai va'e,","poem":2},{"lineBreak":true},{"text":"neĩ ndoura rivei va'e.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ha'e va'e kuery re ma ou 'rã Senhor omoingo porãa,","poem":1},{"text":"ha'e ramo Nhanderuete heraa jepea po gui ojopy 'rã teko porã.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ha'e rami ikuai ixupe ojapukai va'e kuery,","poem":1},{"text":"Jacó Ruete oekaa rupi ikuai va'e.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Peipe'a ke okẽ ikuai va'e,","poem":1},{"text":"peipe'apave okẽ guaxu marã e'ỹ,","poem":2},{"lineBreak":true},{"text":"Huvixave hexakãmba va'e oike aguã.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mava'e tu Huvixave hexakãmba va'e?","poem":1},{"text":"Senhor imbaraete ha'e ipo'akapa va'e,","poem":2},{"lineBreak":true},{"text":"Senhor joe opu'ãa rupi ipo'aka va'e.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Peipe'a ke okẽ ikuai va'e,","poem":1},{"text":"peipe'apave okẽ guaxu marã e'ỹ,","poem":2},{"lineBreak":true},{"text":"Huvixave hexakãmba va'e oike aguã.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mava'e tu Huvixave hexakãmba va'e?","poem":1},{"text":"Senhor ixondaro reta va'e,","poem":2},{"lineBreak":true},{"text":"ha'e ae Huvixave hexakãmba va'e.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}