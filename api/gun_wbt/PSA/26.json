{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"heading","content":["Heko porã va'e ojapukaia"]},{"type":"hebrew_subtitle","content":["Mboraeirã Davi ombopara va'ekue."]},{"type":"verse","number":1,"content":[{"text":"Senhor, xemboeko porã ke,","poem":1},{"text":"anhetẽ rupi anho aiko","poem":2},{"lineBreak":true},{"text":"ha'e Senhor re ajeroviaa gui ndajepe'ai rire.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Senhor, eikuaa pota ke aikoa re ha'e xekuaa.","poem":1},{"text":"Exa pota xepy'aa ha'e anhembopy'aa re.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mba'eta ndeporayvua re xema'endu'a riae aikovy,","poem":1},{"text":"ndeguigua anhetẽ va'e rupi aiko.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndaguapyi guive avakue nhombotavypa rei va'e reve,","poem":1},{"text":"joayvu merami rive va'e kuery reve nanhemoirũi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Opa marã rei ikuai va'e xee ndajou porãi,","poem":1},{"text":"ha'e heko vai va'e kuery reve ndaguapyi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ajepoei ajejavy e'ỹa aikuaa uka vy.","poem":1},{"text":"Ha'e rami vy Senhor, aiko ndevygua altar yvýry,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"aporaei atã aguã ndevy,","poem":1},{"text":"nerembiapo porãa amombe'upa aguã.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Senhor, xee ma ayvu ndevygua oo,","poem":1},{"text":"nerexakã oĩaty.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Eipe'a eme xerekove heko vai va'e kuery reve,","poem":1},{"text":"xerekove eipe'a eme jouguy moẽa kuery reve.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ha'e kuery po ma jojukaague re iky'a,","poem":1},{"text":"oiporu kuaa regua re ma teko vai repyrã rive oguereko.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ha'e rã xee ma xereko porãa rupi aiko.","poem":1},{"text":"Xerepy ke xemboaxy vy.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xepy oĩ atã yvy joja reia py.","poem":1},{"text":"Ha'e rami vy heta va'e kuery oendua py xema'endu'a porã 'rã Senhor re.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}