{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Senhor, heta pojava va'e ty'y xerovaigua kuery ikuai!","poem":1},{"text":"Aipapapa aguã rami e'ỹ xere opu'ã va'e.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Heta ete xevy aipoe'i okuapy va'e:","poem":1},{"text":"“Nhanderuete tu ndogueraa jepei 'rã rima.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ha'e rami teĩ Senhor, ndee ma mba'emo vai jokoa reiko xevy.","poem":1},{"text":"Ndee ae roguerovy'a, ha'e rã xeakã remopu'ã kuerei 'rã.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Xeayvu atã reve ajapukai Senhor pe.","poem":1},{"text":"Ha'e rã yvyty iky'a e'ỹ va'e áry gui xembovai.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Anheno vyve ake vyvoi 'rã,","poem":1},{"text":"avy ju 'rã guive, xere Senhor opena ramo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xee ma ndakyjei 'rã mbovy e'ỹ","poem":1},{"text":"jovaive-ive re xere opu'ã va'e gui.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Senhor, epu'ã ke.","poem":1},{"text":"Xerepy ke, Xeruete.","poem":2},{"lineBreak":true},{"text":"Xerovaigua kuery ha'e javi reunga 'rã haĩnhykã,","poem":2},{"lineBreak":true},{"text":"remopẽmba 'rã heko vai va'e kuery raĩ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mba'eta Senhor gui ou 'rã jaa jepe aguã.","poem":1},{"text":"Tove ndevygua kuery re toĩ remoingo porãa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}