{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"heading","content":["Henda iky'a e'ỹ va'e py ooxea rami ijayvua ague"]},{"type":"verse","number":1,"content":[{"text":"Xeruete, xemboeko porã ke","poem":1},{"text":"xere opu'ã va'e kuery gui.","poem":2},{"lineBreak":true},{"text":"Xereraa jepe avakue nhombotavy ha'e ijapu va'e gui.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mba'eta Xeruete, ndere ae anhemi.","poem":1},{"text":"Mba'e re tu naxepytyvõi?","poem":2},{"lineBreak":true},{"text":"Mba'e re tu ajexavai aikovy xerovaigua kuery xeavyky rei rã?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Emboguejy nerexakã ha'e anhetẽ va'e,","poem":1},{"text":"xereraa aguã ndevygua yvyty iky'a e'ỹ va'e áry","poem":2},{"lineBreak":true},{"text":"nembojeroviaaty oĩ va'e py.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ha'e ramo aa aguã Xeruete pegua altar oĩa py,","poem":1},{"text":"Xeruete arovy'a va'e renonde.","poem":2},{"lineBreak":true},{"text":"Xeruete, rogueroporaei 'rã mba'epu ixã reta va'e amonhendu reve.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xenhe'ẽ, mba'e re tu ndeporiau ri?","poem":1},{"text":"Mba'e re tu nda'evei rei reĩ xepy'apy py?","poem":2},{"lineBreak":true},{"text":"Earõ Nhanderuete, mba'eta aroporaei nho 'rã.","poem":2},{"lineBreak":true},{"text":"Ha'e ma Xeruete xepytyvõa oiko.","poem":2},"Nhanderuete pe ojepy ukaa ague",{"text":"Jogueroporaei va'e pe Coré ra'y kuery nhombo'e aguã ombopara va'ekue.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}