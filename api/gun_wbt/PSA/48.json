{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":48,"content":[{"type":"verse","number":1,"content":[{"text":"Yvate ete va'e ma Senhor oiko,","poem":1},{"text":"ha'evea rami jaroporaei","poem":2},{"lineBreak":true},{"text":"Nhanderuete pegua tetã py.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ixupegua yvyty iky'a e'ỹ va'e ma yvate ete,","poem":1},{"text":"yvy jave re oguerovy'aa va'e.","poem":2},{"lineBreak":true},{"text":"Sião yvyty oĩ kuaray puku-a yke katy,","poem":2},{"lineBreak":true},{"text":"huvixave retã oĩa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tetã py oo ikorapa va'e rupi","poem":1},{"text":"Nhanderuete ojekuaa uka nhanhemi aguã yvate va'e rami.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ha'e nunga rupi huvixa kuery nhomoirũmba jogueruvy va'ekue","poem":1},{"text":"okanhymba.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tetã oexa vyve onhemondyipa.","poem":1},{"text":"Okyjepa vy onhamba.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ha'e py ngyje rive ipo'aka ha'e kuery re,","poem":1},{"text":"oendu guive haxy imemby ta va'e rami.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yvytu kuaray oua katy gui ou va'e py","poem":1},{"text":"rembovaipa Társis gui kanoã ou va'ekue.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Omombe'ua rã nhaenduague rami","poem":1},{"text":"jaexa Senhor ixondaro reta va'e pegua tetã py oiko va'e,","poem":2},{"lineBreak":true},{"text":"Nhanderuete pegua tetã py ae.","poem":2},{"lineBreak":true},{"text":"Nhanderuete omoĩ atã 'rã raka'e rã peve.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Oreruete, renhomboaxya re orema'endu'a","poem":1},{"text":"ndevygua templo mbyte roĩa py.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Oreruete, nderery oikuaa pavẽ 'rã.","poem":1},{"text":"Ha'e rami vy ndevy oporaei rã yvy apy peve 'rã onhendu.","poem":2},{"lineBreak":true},{"text":"Ndepo py ha'evea rami rejoguereko.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tovy'aa Sião yvyty re,","poem":1},{"text":"Judá rajy kuery avi tovy'a ne'arandua re.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Peguata ke Sião rupi,","poem":1},{"text":"ha'e javi rupi pejere.","poem":2},{"lineBreak":true},{"text":"Peipapa torre ikuai va'e.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Peikuaa pota porã ikora yvatea re,","poem":1},{"text":"ha'e pexa pota oo ikorapa va'e ikuai va'e re,","poem":2},{"lineBreak":true},{"text":"raka'e rã ikuai va'erã pe pemombe'u kuaa aguã:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“Ha'e rami oiko Nhanderuete","poem":1},{"text":"raka'e rã peve guarã.","poem":2},{"lineBreak":true},{"text":"Nhanderereko 'rã nhamano peve.”","poem":2},"Avakue okanhymba aguã re ijayvua",{"text":"Jogueroporaei va'e pe Coré ra'y kuery ombopara va'ekue.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}