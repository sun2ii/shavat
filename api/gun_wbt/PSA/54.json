{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"verse","number":1,"content":[{"text":"Xeruete, xereraa jepe ke nderery rupi,","poem":1},{"text":"xemboeko porã guive ndepo'akaa rupi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Xeruete, endu ke anhembo'e ramo,","poem":1},{"text":"ejapyxaka ayvu xejuru gui oẽ va'e re.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mba'eta xere opu'ã okuapy porojojai va'e kuery,","poem":1},{"text":"jojuka va'ety kuery xejukaxe okuapy.","poem":2},{"lineBreak":true},{"text":"Ha'e kuery ma Nhanderuete re ima'endu'aa rupi nda'ikuai.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ha'e rã xee ma Nhanderuete oiko xepytyvõarã.","poem":1},{"text":"Senhor oiko xemoingovearã.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ombopaga 'rã heko vai va'e xemoingo axyague re.","poem":1},{"text":"Ojeroviapy reikoa rupi remomba 'rã.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndevy ame'ẽxea'i py ame'ẽ 'rã ome'ẽmby.","poem":1},{"text":"Senhor, aporaei 'rã nderery rupi iporã ramo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mba'eta xereraa jepe ajexavaia ha'e javi gui.","poem":1},{"text":"Ha'e ramo aexaa py xerovaigua kuery okanhymba.","poem":2},"Joapo vai va'e kuery omombaa aguã re ojerurea ague",{"text":"Jogueroporaei va'e pe nhombo'e aguã Davi ombopara va'ekue mbaraka py ombojoguy aguã.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}