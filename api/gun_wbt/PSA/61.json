{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"verse","number":1,"content":[{"text":"Xeruete, endu ke ajapukaia.","poem":1},{"text":"Eikuaa pota anhembo'e ramo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yvy apy gui ajapukai ndevy,","poem":1},{"text":"xepy'apy py ajexavai vy.","poem":2},{"lineBreak":true},{"text":"Xereraa ke itaova xegui yvateve va'e áry.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mba'eta ndee ma anhemiaty,","poem":1},{"text":"xerovaigua kuery gui torre imbaraete va'e reiko.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taiko riae nembojeroviaaty rupi raka'e rã peve.","poem":1},{"text":"Ndepepo guýry xee anhemi va'e.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mba'eta Xeruete, ndee rendu anhemboayvu rã.","poem":1},{"text":"Ha'e rami vy xevy pe reme'ẽ iporã va'e,","poem":2},{"lineBreak":true},{"text":"nderery oendu vy ojererokyje va'e kuery reve.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Remoĩve 'rã huvixave ára.","poem":1},{"text":"Hi'ára ipukuve ete 'rã aỹgua ha'e raka'e rãgua ikuaia peve.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Toĩ riae Nhanderuete renonde.","poem":1},{"text":"Ndereko porãa ha'e ndeporayvua rupi vy toikove riae.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ha'e rami rã nderery rupi aporaei 'rã raka'e rã peve,","poem":1},{"text":"anhemboayvuague ajapo aguã ko'ẽ nhavõ.","poem":2},"Jajerovia aguã regua",{"text":"Jogueroporaei va'e Jedutum oporaeia rami oporaei aguã Davi ombopara va'ekue.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}