{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"verse","number":1,"content":[{"text":"Xeruete, xereraa jepe ke.","poem":1},{"text":"Ejapura ke Senhor, xerepy aguã.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tove xerekove oipe'axe va'e toxĩmba,","poem":1},{"text":"oxĩmbaa anho toendu.","poem":2},{"lineBreak":true},{"text":"Ajexavaia re ovy'a rei va'e kuery","poem":2},{"lineBreak":true},{"text":"oxĩmba reve tojevypa guakykue katy.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tove ovy'a rei va'e xevy “Ha'evea rami! Ha'evea rami!”","poem":1},{"text":"he'i va'e kuery toguevipa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ha'e rã ndereka va'e kuery ha'e javi ma tandererovy'a oporaei reve.","poem":1},{"text":"Rejogueraa jepea oguerovy'a va'e","poem":2},{"lineBreak":true},{"text":"“Nhanderuete ima'endu'a porãmby toiko!” te'i riae okuapy.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ha'e gui xee ma iporiaukue'i, ojexavai rei va'e aiko.","poem":1},{"text":"Xeruete, ejapura xerepy aguã.","poem":2},{"lineBreak":true},{"text":"Ndee ma xepytyvõa ha'e xerepyarã.","poem":2},{"lineBreak":true},{"text":"Senhor, ndeare eme ke!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}