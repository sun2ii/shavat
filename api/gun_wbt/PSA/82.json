{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"verse","number":1,"content":[{"text":"Nhanderuete renonde ijapy okuapy ojeupegua kuery.","poem":1},{"text":"Ha'e ramo tuuete kuery mbyte omboayvu oiny.","poem":2},{"noteId":53}]},{"type":"verse","number":2,"content":[{"text":"“Raka'e peve 'rã tu ha'eve'ỹa rami peikuaa pota joe?","poem":1},{"text":"Heko vai va'ea katy jepi ri ty peiko.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ha'evea rami ete 'rãgue peikuaa pota yvyĩgue'i ha'e tyre'ỹ re.","poem":1},{"text":"Pepena porã ke ojexavai va'e ha'e oipytyvõ pyrã e'ỹ kuery re.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Peipytyvõ yvyĩgue'i ha'e iporiaukue'i,","poem":1},{"text":"peraa jepe heko vai va'e po gui.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ha'e kuery ma mba'eve ndoikuaai,","poem":1},{"text":"neĩ ndoikuaa potai va'e,","poem":2},{"lineBreak":true},{"text":"pytũ reia rupi ikuai.","poem":2},{"lineBreak":true},{"text":"Ha'e ramo yvy yta omyĩmba.","poem":2},{"noteId":54}]},{"type":"verse","number":6,"content":[{"text":"Xee aipoa'e va'ekue: “Peẽ kuery ma tuuete,","poem":1},{"text":"Yvate ete va'e ra'y kuery pendekuai”, ha'e va'ekue.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ha'e rami teĩ avakue rami rive 'rã pemano,","poem":1},{"text":"pendekovea opa 'rã huvixa kuery mboae rami.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Oreruete, epu'ã ke, eikuaa pota yvy regua kuery re.","poem":1},{"text":"Mba'eta yvy regua ma ndevy guarã meme.","poem":2},"Nhanderuete nhombopaga aguã re ojerurea ague",{"text":"Mboraeirã Asafe ombopara va'ekue.","descriptive":true}]}],"footnotes":[{"noteId":53,"caller":"+","text":"“Tuuete kuery” he'ia ma joguerekoarã omoĩ mbyre re ijayvu vy (João 10.34-36).","reference":{"chapter":82,"verse":1}},{"noteId":54,"caller":"+","text":"“Yvy yta” he'ia ma ha'evea rami joguerekoa re ijayvu vy (Salmo 11.3, 75.3).","reference":{"chapter":82,"verse":5}}]},"thisChapterLink":"/api/gun_wbt/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}