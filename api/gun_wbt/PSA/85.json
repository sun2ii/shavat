{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":85,"content":[{"type":"verse","number":1,"content":[{"text":"Senhor, remoingo porã va'ekue ndeyvy,","poem":1},{"text":"Jacó kuery guive remoingo porã ju.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndevygua kuery ojejavyague remboguepa va'ekue,","poem":1},{"text":"heko vaiague rejao'ipa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndepoxya nderexa ukai orevy,","poem":1},{"text":"ndepoxya rupi e'ỹ orerereko va'ekue.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Oreruete orereraa jepea, peteĩgue ju ke oremoingo porã,","poem":1},{"text":"oregui eipe'a ju ndepoxya.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tyrã ndepoxy riae 'rã teve orevy?","poem":1},{"text":"Raka'e rã peve 'rã nda'u ndepoxy?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Noremoingo porãve jevyi 'rã ri ty'y,","poem":1},{"text":"ndevygua kuery ndererovy'a aguã?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Senhor, exa uka ndeporayvua orevy,","poem":1},{"text":"ejapo roo jepe aguã rami.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ajapyxaka 'rã Senhor ijayvua re,","poem":1},{"text":"mba'eta ijayvu ojeupegua iky'a e'ỹ va'e kuery omoingo porã aguã re,","poem":2},{"lineBreak":true},{"text":"o'arandu e'ỹa py ho'a ve'ỹ aguã.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ou ma oiny henonde ojererokyjea rupi ikuai va'ea py, ogueraa jepe aguã,","poem":1},{"text":"nhandeyvy re hexakãa ojekuaa aguã.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mborayvu nhomoirũ anhetẽ va'e reve,","poem":1},{"text":"teko porã ha'e jaiko porãa oje'a jova pyte va'e rami.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yvy gui henhoĩ 'rã anhetẽ va'e,","poem":1},{"text":"ha'e teko porã oma'ẽ 'rã yva gui.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Senhor ome'ẽ 'rã iporã va'e,","poem":1},{"text":"ha'e nhandeyvy re oiko 'rã mba'emo'a.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Teko porã oo 'rã henonde,","poem":1},{"text":"oguereko katu aguã haperã oo aguã.","poem":2},"Ojerure ha'e ojerovia etea",{"text":"Davi onhembo'eague.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}