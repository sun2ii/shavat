{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"verse","number":1,"content":[{"text":"Yvyty iky'a e'ỹ va'e áry Senhor Sião","poem":1},{"noteId":59},{"text":"tetã omoĩ atã rire","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"oayvu hokẽ ikuai va'e voi.","poem":1},{"text":"Jacó kuery rekoa ikuai va'e ha'e javi gui oayvuve.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndevy Nhanderuete pegua tetã, ayvu iporã ete va'e 'ea:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"“Xekuaa va'e kuery rekoa regua ma","poem":1},{"text":"Egito ha'e Babilônia.","poem":2},{"lineBreak":true},{"text":"Oĩ avi 'rã Filístia, Tiro ha'e Etiópia,","poem":2},{"lineBreak":true},{"text":"ha'e py ae itui'i rire.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mba'eta Sião tetã pe aipo'ea 'rã:","poem":1},{"text":"“Kova'e ha'e peva'e voi ha'e pygua ae.","poem":2},{"lineBreak":true},{"text":"Yvate ete va'e omoĩ atã 'rã.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Senhor yvy regua rery ombopara vy aipoe'i 'rã:","poem":1},{"text":"“Kova'e ma ha'e pygua ae.”","poem":2},{"noteId":60}]},{"type":"verse","number":7,"content":[{"text":"Oporaei va'e kuery ha'e javi opo-opo reve aipoe'i 'rã:","poem":1},{"text":"“Ndere anho oĩ xemoingo porãa ha'e javi.”","poem":2},"Ojexavai va'e ndovy'aia rupi ijayvuague",{"text":"Jogueroporaei va'e pe mboraeirã Coré ra'y kuery nhombo'e aguã ombopara va'ekue mbaraka py ombojoguy aguã, Ezra ramymino Hemã oporaei va'ekue.","descriptive":true}]}],"footnotes":[{"noteId":59,"caller":"+","text":"Sião ma Jerusalém tetã rery mboae.","reference":{"chapter":87,"verse":1}},{"noteId":60,"caller":"+","text":"“Ha'e py itui'i” he'ia ma ojeupegua kuery re ijayvu vy, Jerusalém pygua ae pe rami, mombyry itui'i va'ekue teĩ.","reference":{"chapter":87,"verse":6}}]},"thisChapterLink":"/api/gun_wbt/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}