{"translation":{"id":"gun_wbt","name":"Nhanderuete ayvu iky'a e'ỹ va'e","website":"https://ebible.org/Scriptures/details.php?id=gun","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gun","licenseNotes":null,"shortName":"WBT","englishName":"Mbyá Guaraní NT","language":"gun","textDirection":"ltr","sha256":"29f410418ae15cd64e771ea8858bda0c5728d4a0effbcb82fe2a25f3f8153178","availableFormats":["json"],"listOfBooksApiLink":"/api/gun_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Mbyá Guaraní","languageEnglishName":"Mbyá Guaraní"},"book":{"id":"PSA","translationId":"gun_wbt","name":"Salmos","commonName":"Salmos","title":"Salmos Israel kuery oporaeiaty","order":19,"numberOfChapters":150,"sha256":"14d35bce085dfaca226f8f515963f0ab46497f0d559df0d1585593a6d6db3cb1","firstChapterNumber":1,"firstChapterApiLink":"/api/gun_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/gun_wbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"heading","content":["Nhanderuete ipo'akaa ha'e yvatea re ijayvua"]},{"type":"verse","number":1,"content":[{"text":"Senhor ma huvixave oĩ.","poem":1},{"text":"Hexe oĩ yvatea,","poem":2},{"lineBreak":true},{"text":"Ku'axã rami Senhor ojee omoĩ opo'akaa.","poem":2},{"lineBreak":true},{"text":"Omoĩ atã yvy omyĩ e'ỹ aguã rami.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jypy'i guive repenaa oĩ atã,","poem":1},{"text":"jypy'i ete guive reiko.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Senhor, yakã ikuai va'e opu'ã okuapy,","poem":1},{"text":"yakã opu'ã vy hevovo,","poem":2},{"lineBreak":true},{"text":"yakã hyapu rei teĩ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ha'e rã Senhor yvate oĩ va'e ma","poem":1},{"text":"yy tuvixa va'e revovo gui ipo'akapave,","poem":2},{"lineBreak":true},{"text":"ye'ẽ py yai vaikue opu'ã-pu'ã va'e po'akaa gui voi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndeayvuague ma oaxa rive va'erã e'ỹ.","poem":1},{"text":"Senhor, nderopy ma iky'a e'ỹ va'e anho 'rã oĩ","poem":2},{"lineBreak":true},{"text":"raka'e rã peve guarã.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/gun_wbt/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gun_wbt/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gun_wbt/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}