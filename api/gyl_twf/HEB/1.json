{"translation":{"id":"gyl_twf","name":"ክለ ጫቃ","website":"https://ebible.org/Scriptures/details.php?id=gyl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gyl","licenseNotes":null,"shortName":"TWF","englishName":"Goyil NT","language":"gyl","textDirection":"ltr","sha256":"9109a1a336cda38524c9067543d69fff0f715ef070d9bd38a6e32ef7df3ea981","availableFormats":["json"],"listOfBooksApiLink":"/api/gyl_twf/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Gayil","languageEnglishName":"Gayil"},"book":{"id":"HEB","translationId":"gyl_twf","name":"ዕብራውያን","commonName":"ዕብራውያን","title":"ዕብራውያን ኤድንከስካንታ ኦይትምሳን ክታ","order":58,"numberOfChapters":13,"sha256":"e14fb62c46b68d3875ed6bf07f5bdc6ebaa82f51b461cbf06fdb399b30dbf72a","firstChapterNumber":1,"firstChapterApiLink":"/api/gyl_twf/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/gyl_twf/HEB/13.json","totalNumberOfVerses":301},"chapter":{"number":1,"content":[{"type":"heading","content":["ሳብ ይንታ ይንቺንጎካ ኬዜ"]},{"type":"verse","number":1,"content":["ሳብ ኤና እሪ ስለናር Ꮊክ Ꮊክ ጎግካ፥ ሳብዘንካ ኤሰርሶ ኬዝድባብከስጎካ ዎንታ ባቤንከስካንታ በድᎺይካ ኬዝድ Ꮊቄ፥"]},{"type":"verse","number":2,"content":["ታ ማቼ ኮ በእንታ ስለናር ሙዳ ሪን ክታ ይንቺንጎካ ከኬን ተይድንግንዳ ይስስባብጎካ ዎካንታ ኬዜ፥ ፍጫ ሙደንመረ ክት ፍዛንዳ ክትኬ።"]},{"type":"verse","number":3,"content":["ኖ ሳብታ ቦንቼንም ሮጵስሶ ሰችዝድባቤ፥ ኖይንታ እዘንካ ሳብካ ክክን ኖ ገታ የኬ። ይንታ ዎልቃ ቃለንካ ፍጫ ሙደን ዳቅስሶ ኖ የቴ፥ ኤድንከስመረ ከታ ጎመናርንካ ይ ጭልሳንደታ ቡሪ ጭላር አንድር ሳብንታ ምዝዘን ዶቅቴ።"]},{"type":"heading","content":["ሳብ ይንቺና ክታይንችንከዘንካ አንድር ስግና"]},{"type":"verse","number":4,"content":["ክትካንታ ዎድምሳንዳ ላምና ክታይንችንታ ላምንዘንካ ስግ ማቻንከካ ሳብታ ይንቺና ክታይንችንዘንካ አንድር ስግዬ።"]},{"type":"verse","number":5,"content":[{"text":"ሳብ ቦድሶ ክታይንችንታ ዎክያርንካ፥","poem":1},{"lineBreak":true},{"text":"“የና እስታ ይንቼዬ፥ ታካ የስም አእትቴ”","poem":1},{"lineBreak":true},{"text":"አነረ","poem":1},{"lineBreak":true},{"text":"“እታ ክታ ባቤና ማድቴ፥ ኖየረ እስታ ይንቺ ማተረ”","poem":1},{"lineBreak":true},{"text":"ጋይሳንዳ Ꮊየንካንተረ ካዬ።","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ሳብ ይንታ ዳነዝ ይንቺንም ኮ ፍጫሙደንካንታ ኦይቻንደትካ","poem":1},{"lineBreak":true},{"text":"“ሳብታ ክታይንችንከስ ሙደና ክትካንታ ጎስታጋካ” ጋይቴ።","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ይንታ ክታይንችንጎካ","poem":1},{"lineBreak":true},{"text":"“ክታይንችንከስም አያን፥","poem":1},{"text":"ሳብታ ፍክስንባብከስመረ ኖሄታ ሎግንችንግንዳ ማዝድቴ” ጋይዴ","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ይንታ ይንቺንጎካ ማቼ፥","poem":1},{"lineBreak":true},{"text":"“ሳብዮ! የስታ ዶቅንት ጎንገና ስለንክንደታ ዶቅተሬ፥","poem":1},{"text":"የስታ ባንችምንመረ ዶፈንካ ገችዝዳዬ፥","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ጭለትችንም ሶልምሳዬ፥ ዳቀልስን ቦሳዬ፥","poem":1},{"lineBreak":true},{"text":"ኮጎካ ሳብ የስታ ሳብና የስም እጄ፥","poem":1},{"text":"የስታ ላኮይትንከዘንከረ ስግስሶ ጉርም እምድን ሳየርድንደትካ የስም ሳይሴ” ጋይዴ።","poem":2}]},{"type":"verse","number":10,"content":["ኮትኮግንደረ",{"text":"“ጮይስዮ! የና እሪምሳዮ ፍጨንም ፍዘዬ፥","poem":1},{"text":"ጭለንከሰረ የስታ አንንካ ፍዛዬ፥","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ከታ ሙዳ ካይደኬ፥","poem":1},{"lineBreak":true},{"text":"የና ማቼ ዶቅተራዬ፥","poem":1},{"lineBreak":true},{"text":"ከታ ሙዳ አፍላ ግንዳ ገሰርደኬ።","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ዳኬንግንዳ ቁርተራዬ፥","poem":1},{"lineBreak":true},{"text":"ከተረ ገሳ አፍለን ክለካ ኦከርድንግንዳ ኦክምደኬ።","poem":1},{"text":"የና ማቼ ሙዳᎺይካ የነተዬ፥","poem":2},{"lineBreak":true},{"text":"የስታ ስለንተረ በእንታ ካዬ” ጋይዴ።","poem":2}]},{"type":"verse","number":13,"content":["ሳብ ይንታ ክታይንችንታ ዎክያርንካ፥",{"text":"“የስታ ይምኤንባብከስም የስታ ገችንታ ኤረንታ ጎያር ማስተርን የለልታ","poem":1},{"text":"እስታ ምዝንዘን ዶእካ” ጋይሳንዳ Ꮊይካንተረ ካዬ።","poem":2}]},{"type":"verse","number":14,"content":["ይና፥ ክታይንችና ሙዳ አቅድባብ ኤድንከስካንታ ከት ፍክሳባብ ኦይትምድባብከስ ሳብታ ፍግዝድባብ አያንንከሰኬ።"]}],"footnotes":[]},"thisChapterLink":"/api/gyl_twf/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/gyl_twf/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/gyl_twf/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}