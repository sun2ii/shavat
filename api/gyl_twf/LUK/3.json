{"translation":{"id":"gyl_twf","name":"ክለ ጫቃ","website":"https://ebible.org/Scriptures/details.php?id=gyl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=gyl","licenseNotes":null,"shortName":"TWF","englishName":"Goyil NT","language":"gyl","textDirection":"ltr","sha256":"9109a1a336cda38524c9067543d69fff0f715ef070d9bd38a6e32ef7df3ea981","availableFormats":["json"],"listOfBooksApiLink":"/api/gyl_twf/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7953,"languageName":"Gayil","languageEnglishName":"Gayil"},"book":{"id":"LUK","translationId":"gyl_twf","name":"ሉቃስ","commonName":"ሉቃስ","title":"ሉቃስ ጻፍሳንዳ ዎንታ ጮይስን የሱስ ክርስቶሰታ ክላ ኬዛ","order":42,"numberOfChapters":24,"sha256":"1c79130439f1ba86e2f4f181bd8098d8d4c9609fb7337a6b0617f6b375b2c97f","firstChapterNumber":1,"firstChapterApiLink":"/api/gyl_twf/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/gyl_twf/LUK/24.json","totalNumberOfVerses":1150},"chapter":{"number":3,"content":[{"type":"heading","content":["ስእስንባብ ዮሀንሰታ ሳባክና"]},{"type":"verse","number":1,"content":["ሮመታ ባንችን ጢባሮስ ባንችምሳንደት ታመከ ዶንቅስ ስለናር፥ ጰንጠና ጵላጦስ ይሁዳ ፍጨን ገችዝድባብ Ꮊቄ፥ ሄሮድስ ማቸ ገሊላ ፍጨን ቆልድባብ Ꮊቄ፥ ኮትኮግንደረ ክታ እስመን ፍልጶሰረ እጡራሰተከ ጥራኮንዶስ ፍጨን ኦይችምስ ዱት ቆልስባብ፥ ልሳኖሰረ አብለነ ፍጨን ኦይችምስ ዱት ቆልስባብከስ Ꮊቀኬ"]},{"type":"verse","number":2,"content":["ሀነከ ቀያፈካ ቀሰንከስም ገችዝድባብ ማትሰኮ ከትዶቅድንካ፥ ሳብ ይንታ ቃለንም ዘካርያሰታ ይንች ዮሀንሳካንታ ኤድ ካየንካርያር ኬዜ።"]},{"type":"verse","number":3,"content":["ኖየረ “የንታ ጎመንታ ነገትቸን የ Ꮊፍተርንግንዳ ጎማ ፍክስን ዎይስሰቶ ስኤርከቴ” ጋይሶ ዎርሰንካንታ ኬዘሮ ዮርዳኖስ ሎቀንታ ላማር ዶቅድን ካሪ ሙደናር ኦንግዜ።"]},{"type":"verse","number":4,"content":["ኮነረ ማቻንዳ ሳብዘንካ ኤሰርሶ ኬዝባብ ኢሳስታ ቤር ማጻፍናር፥",{"text":"“ኤድ ካየናር ኩንጋይሶ ፍብድን ኤታ ኡፍስ","poem":1},{"text":"‘ጮይስታ ጎግን ግክስከቴ!","poem":2},{"lineBreak":true},{"text":"Ꮊጭሰረ ሉልስከቴ!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ቦደና ሙዳ ጮጫ!","poem":1},{"lineBreak":true},{"text":"ገቸንኬ ደንካ ሙዳ ይርክን ጋያ!","poem":1},{"text":"ዎብ ጎግና ኡራ!","poem":2},{"lineBreak":true},{"text":"ቦርችምሳ ገርደነረ ኡርስማ!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኤድ ይንች ሙደና ሳብታ አቅስንም ሰዳ!’ ” ኩን ጋይምሶ ጻፍምሳንግንዴ።","poem":1}]},{"type":"verse","number":7,"content":["ዮሀንሰረ ክታ አንያር ስእርካንታ Ꮊዳን ኤድንከዝደር “የታ ጉን ፉይንታ ይንችንከሶ! Ꮊድን ሳብታ ዋጭንዘንካ የ ሱርድንግንዳ Ꮊይ የም ዞርሳሬ?"]},{"type":"verse","number":8,"content":["ይና የንታ ጎማ ፍክስን ዎይስዝድን ፍክስንም ፍክስከቴ ዳት፥ የንታ ቡዳር አብረሀም ዎንታ ባበና ዶቅዴ ጋይሰቶ Ꮊይ ጋይርመቴ። ሳብ ኬና ሰይንንከሳርንካ አብራሀምካንታ ይንች አምስስካንታ ማድንደትም የካንታ ኬዝድቴ።"]},{"type":"verse","number":9,"content":["ታ ዎራ Ꮊቀን ፋግድንዳ ካልተና Ꮊቀንከስታ ጎያር ዶቅቴ። ይና ኡርማ አፍ ኡዝዳክን Ꮊቃ ሙደና ፋክምሶ ኖሀር ኦይትምዴ” ኩን ጋይድ Ꮊቄ።"]},{"type":"verse","number":10,"content":["ዎርሰነረ “ይና፥ Ꮊሮንት ይቴ?” ጋየረኮ አይሶ ዮሀንሰም ኦይሰኬ።"]},{"type":"verse","number":11,"content":["ዮሀንሰረ፥ “ቃስተን አፍላ ዶቅድባብ Ꮊረነረ ካየንባብካንታ እማ፥ እችም ዶቅድባበረ ኮትግንዳ ይያጋካ” ጋይሶ ከትካንታ ማስሴ።"]},{"type":"verse","number":12,"content":["ቃረጭን ተችዝድባብከሰረ ስእርካንታ ክደር Ꮊድሰኮ “ኤስስንባቦ! ዎታ Ꮊሮንት ይቴ?” ከታ ጋይሰኬ።"]},{"type":"verse","number":13,"content":["ኖየረ፥ ህግንካ የም “ክተርሳንዘንካ ስግስሶ ቃረጭን Ꮊይ ተችሰቴ” ከትም ጋይሴ።"]},{"type":"verse","number":14,"content":["ዳምንባብከሰረ Ꮊድሰኮ፥ “ዎታ Ꮊሮንት ይቴ?” ጋይሶ ኦይሰኬ። ኖየረ፥ “Ꮊየንዘንከረ ብረም ጩበካ Ꮊይ ቡረቴ፥ ኤድመረ ማልትካ Ꮊይ ካሰሰተ፥ የንታ ፍክስንካንታ ናከርድንዳ የም ማዴ” ከትም ጋይሴ።"]},{"type":"verse","number":15,"content":["ዎርሰና ጉርምካ ካርሰዘን ከት ዶቅድንካ፥ “ኖኮና ክርስቶስ ዳቶ?” ጋየረኮ ሙደና ይንታ ቡዳር ዮሀንስጎካ ገቅር የጀኬ።"]},{"type":"verse","number":16,"content":["ዮሀንሰረ ሙደንከስካንታ፥ “እታ የም ሎቀካ ስእዝድቴ፥ ኬዛርንካ ማቼ እዘንካ ስገድባብ Ꮊዴ፥ እተረ ክታ ጫመንታ ዞክነንም ቡልካንታ ማታይባብቴ፥ ኖየረ አያን ጭልንኬ ኖሄካ የም ስእዝዴ።"]},{"type":"verse","number":17,"content":["ቆይደንም ቦድሶ ኡርስካንተኬ ዘርግንመረ ቡለናር ኦይትካንታ ጋልደጵና ክታ አንያሬ፥ ምሰንመረ ድግዳክን ኖሄንካ አችዝዴ” ኩን ከትካንታ ጋይሴ።"]},{"type":"verse","number":18,"content":["ዮሀንሰረ በድ ጎግካ አብንከስካንታ ዞረካ ዎርሰንም ኤግዝሰሮ ክላ ኬዘን ኬዜ።"]},{"type":"verse","number":19,"content":["ኬዛር ማቼ ዮሀንስ፥ ገሊላ ፍጨንም ቆልድባብ ሄሮድስ ይንታ እስመንታ ኬነንም ክት እንቻንጎከ አብ በድ ዳቅል ር ክት ይሳንካንታ ዋጬ።"]},{"type":"verse","number":20,"content":["ሄሮድስ ዳቅልንዘን ዳቅልን ጉጀካ ዮሀንሰም ዞክና ኤሄናር አርችሴ።"]},{"type":"heading","content":["የሱሰታ አጥርንኬ ስእርንካ"]},{"type":"verse","number":21,"content":["ዎርሳ ሙደና ስኤርሳን ቡር የሱሰረ ስኤርሴ፥ ክት ምክሰሮ ዶቅድንካ ጭላ ፎችምሴ፥"]},{"type":"verse","number":22,"content":["አያን ጭልና ዎለም ካምሶ ክታዘን Ꮊንቸርሴ፥ ጭላርንከሬ፥ “እ ሶልምድን እስታ ይንችና የናዬ፥ የስካ እም ጉርምዝዴ” ጋይድን ኡፍስ Ꮊዴ።"]},{"type":"verse","number":23,"content":["የሱስ ፍክስን ክት የድንካ ስለና ክታ ቦንደከ ታማ ማድንዳ Ꮊቄ፥ ዎርሰንከስካንታ የሱስ ዮሴፈታ ይንች ካምድ Ꮊቄ። ኖየረ ኤልታ ይንች፥"]},{"type":"verse","number":24,"content":[{"text":"ማትታ ይንች፥","poem":1},{"lineBreak":true},{"text":"ለዊታ ይንች፥","poem":1},{"lineBreak":true},{"text":"ምልከታ ይንች፥","poem":1},{"lineBreak":true},{"text":"ዮነታ ይንች፥","poem":1},{"lineBreak":true},{"text":"ዮሰፈታ ይንች፥","poem":1}]},{"type":"verse","number":25,"content":[{"text":"ማታትታ ይንች፥","poem":2},{"text":"አሞጸታ ይንች፥","poem":1},{"lineBreak":true},{"text":"ናሆመታ ይንች፥","poem":1},{"lineBreak":true},{"text":"ኤስልታ ይንች፥","poem":1},{"lineBreak":true},{"text":"ናገታ ይንች፥","poem":1}]},{"type":"verse","number":26,"content":[{"text":"ማአትታ ይንች፥","poem":2},{"text":"ማታትታ ይንች፥","poem":1},{"lineBreak":true},{"text":"ሰመይታ ይንች፥","poem":1},{"lineBreak":true},{"text":"ዮሰፈታ ይንች፥","poem":1},{"lineBreak":true},{"text":"ዮደታ ይንች፥","poem":1}]},{"type":"verse","number":27,"content":[{"text":"ዮናነታ ይንች፥","poem":2},{"text":"ረሰታ ይንች፥","poem":1},{"lineBreak":true},{"text":"ዘሩባበልታ ይንች፥","poem":1},{"lineBreak":true},{"text":"ሰላትያልታ ይንች፥","poem":1},{"lineBreak":true},{"text":"ነርታ ይንች፥","poem":1}]},{"type":"verse","number":28,"content":[{"text":"ምልክታ ይንች፥","poem":2},{"text":"Ꮊድታ ይንች፥","poem":1},{"lineBreak":true},{"text":"ዮሳስታ ይንች፥","poem":1},{"lineBreak":true},{"text":"ቆሳምታ ይንች፥","poem":1},{"lineBreak":true},{"text":"ኤልሞዳመታ ይንች፥","poem":1},{"lineBreak":true},{"text":"ኤርታ ይንች፥","poem":1}]},{"type":"verse","number":29,"content":[{"text":"ዮሰእታ ይንች፥","poem":2},{"text":"ኤልኤዛርታ ይንች፥","poem":1},{"lineBreak":true},{"text":"ዮራመታ ይንች፥","poem":1},{"lineBreak":true},{"text":"ማጣተታ ይንች፥","poem":1},{"lineBreak":true},{"text":"ለዊታ ይንች፥","poem":1}]},{"type":"verse","number":30,"content":[{"text":"ስምኦነታ ይንች፥","poem":2},{"text":"ይሁደታ ይንች፥","poem":1},{"lineBreak":true},{"text":"ዮሰፈታ ይንች፥","poem":1},{"lineBreak":true},{"text":"ዮናንታ ይንች፥","poem":1},{"lineBreak":true},{"text":"ኤልያቀምታ ይንች፥","poem":1}