{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"ECC","translationId":"hat_bsa","name":"Eklezyas","commonName":"Eklezyas","title":"EKLEZYAS YO","order":21,"numberOfChapters":12,"sha256":"a96c0ab78e483374918654f6169213226109a2204f8b7567f8941fe964a78623","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/hat_bsa/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"Voye pen ou sou sifas dlo,","poem":1},{"lineBreak":true},{"text":"e apre anpil jou, ou va twouve l.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Divize byen ou fè sèt, oswa uit menm;","poem":1},{"lineBreak":true},{"text":"paske ou pa janm konnen ki malè k ap rive sou latè.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Si nwaj yo plen, yo vide lapli sou latè;","poem":1},{"lineBreak":true},{"text":"epi si yon bwa tonbe vè sid, oswa vè nò,","poem":1},{"lineBreak":true},{"text":"kote li tonbe a, se la l ap kouche.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sila ke veye van an p ap simen;","poem":1},{"lineBreak":true},{"text":"ni sila ki veye syèl la p ap rekòlte.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Menm jan ke ou pa konnen chemen van an,","poem":1},{"lineBreak":true},{"text":"ni jan zo yo vin fòme nan vant a fanm ansent lan,","poem":1},{"lineBreak":true},{"text":"se konsa ou pa konnen zèv Bondye","poem":1},{"lineBreak":true},{"text":"ki fè tout bagay la.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Simen semans ou nan maten an;","poem":1},{"lineBreak":true},{"text":"ni pa gaspiye tan nan aswè.","poem":1},{"lineBreak":true},{"text":"Paske ou pa janm konnen si se nan maten","poem":1},{"lineBreak":true},{"text":"oswa nan aswè semans lan ap reyisi;","poem":1},{"lineBreak":true},{"text":"ni si se pa tou de k ap bon.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Limyè a byen bèl,","poem":1},{"lineBreak":true},{"text":"e li bon pou zye wè solèy la.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Anverite, si yon nonm ta viv anpil ane,","poem":1},{"lineBreak":true},{"text":"kite li rejwi li nan yo tout;","poem":1},{"lineBreak":true},{"text":"men pa kite l bliye jou tenèb yo, paske yo va anpil.","poem":1},{"lineBreak":true},{"text":"Tout sa ki gen pou vini se vanite.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Rejwi jennonm, pandan jenès ou,","poem":1},{"lineBreak":true},{"text":"e kite kè ou rete kontan","poem":1},{"lineBreak":true},{"text":"pandan ane de laj jenès ou yo.","poem":1},{"lineBreak":true},{"text":"Swiv sa ki atire kè ou ak dezi a zye ou,","poem":1},{"lineBreak":true},{"text":"men konnen byen ke Bondye","poem":1},{"lineBreak":true},{"text":"va rele ou nan jijman pou tout bagay sa yo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pou sa, retire gwo doulè ak mechanste","poem":1},{"lineBreak":true},{"text":"pou l pa nan kè ou,","poem":1},{"lineBreak":true},{"text":"e fè mal rete lwen chè ou;","poem":1},{"lineBreak":true},{"text":"paske jenès ak ane jenès yo va disparèt vit.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/ECC/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/ECC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/ECC/10.json","previousChapterAudioLinks":{},"numberOfVerses":10}