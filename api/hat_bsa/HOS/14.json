{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"HOS","translationId":"hat_bsa","name":"Osée","commonName":"Osée","title":"OSÉE","order":28,"numberOfChapters":14,"sha256":"f818a49278006f41a0f6cd3615cb29627cc0eb3da7d486c33628d5318ce5bc3b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/hat_bsa/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Retounen, O Israël, kote SENYÈ, Bondye ou a.","poem":1},{"lineBreak":true},{"text":"Paske ou te glise tonbe akoz inikite ou.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pran avèk ou menm pawòl yo,","poem":1},{"lineBreak":true},{"text":"pou retounen kote SENYÈ a.","poem":1},{"lineBreak":true},{"text":"Di Li: “Retire tout inikite nou yo,","poem":1},{"lineBreak":true},{"text":"e resevwa nou ak gras Ou,","poem":1},{"lineBreak":true},{"text":"pou nou ka bay ofrann bèf yo kon ve a lèv nou.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Assyrie p ap sove nou.","poem":1},{"lineBreak":true},{"text":"Nou p ap monte sou cheval;","poem":1},{"lineBreak":true},{"text":"ni nou p ap di ankò a","poem":1},{"lineBreak":true},{"text":"zèv men nou yo: “Ou se dye nou.”","poem":1},{"lineBreak":true},{"text":"Paske nan Ou, òfelen an twouve mizerikòd.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Mwen va geri enfidelite yo;","poem":1},{"lineBreak":true},{"text":"Mwen va renmen yo an abondans,","poem":1},{"lineBreak":true},{"text":"paske kòlè Mwen fin vire lwen yo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mwen va tankou Lawouze pou Israël;","poem":1},{"lineBreak":true},{"text":"li va fleri kon flè lis,","poem":1},{"lineBreak":true},{"text":"e li va anrasine tankou pye sèd a Liban yo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Boujon li yo va vin pete,","poem":1},{"lineBreak":true},{"text":"e bèlte li va tankou pye doliv etranje a.","poem":1},{"lineBreak":true},{"text":"Li va santi bon kon bèl odè Liban an.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Moun yo va rete nan lonbraj li.","poem":1},{"lineBreak":true},{"text":"Yo va reprann fòs tankou sereyal ki jwenn lapli;","poem":1},{"lineBreak":true},{"text":"yo va fleri tankou pye rezen.","poem":1},{"lineBreak":true},{"text":"Y ap fè bon odè tankou diven Liban an.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O Éphraïm! Kisa M gen pou fè ankò ak zidòl?","poem":1},{"lineBreak":true},{"text":"Se Mwen menm ki okipe l;","poem":1},{"lineBreak":true},{"text":"Mwen tankou yon pye siprè byen vèt;","poem":1},{"lineBreak":true},{"text":"nan Mwen, tout fwi ou sòti.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nenpòt moun ki saj, kite li konprann bagay sa yo;","poem":1},{"lineBreak":true},{"text":"Sila ki pridan an, kite li konnen yo.","poem":1},{"lineBreak":true},{"text":"Paske, chemen a SENYÈ yo dwat,","poem":1},{"lineBreak":true},{"text":"e moun ladwati a va mache ladan yo;","poem":1},{"lineBreak":true},{"text":"men transgresè yo va glise tonbe nan yo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":9}