{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"HOS","translationId":"hat_bsa","name":"Osée","commonName":"Osée","title":"OSÉE","order":28,"numberOfChapters":14,"sha256":"f818a49278006f41a0f6cd3615cb29627cc0eb3da7d486c33628d5318ce5bc3b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/hat_bsa/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":["Vini, annou retounen kote SENYÈ a;",{"text":"paske li te chire nou,","poem":1},{"lineBreak":true},{"text":"men Li va geri nou.","poem":1},{"lineBreak":true},{"text":"Li te blese nou,","poem":1},{"lineBreak":true},{"text":"men Li va panse nou.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Li va fè nou vin refè apre de jou;","poem":1},{"lineBreak":true},{"text":"Nan twazyèm jou a Li va fè nou leve.","poem":1},{"lineBreak":true},{"text":"Konsa, nou va viv devan Li.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Annou rekonèt SENYÈ a;","poem":1},{"lineBreak":true},{"text":"annou refize lage pou nou ka konnen SENYÈ a.","poem":1},{"lineBreak":true},{"text":"Aparans Li asire tankou solèy","poem":1},{"lineBreak":true},{"text":"k ap leve granmmaten.","poem":1},{"lineBreak":true},{"text":"Konsa, Li va vini sou nou tankou lapli,","poem":1},{"lineBreak":true},{"text":"tankou lapli prentan k ap wouze latè.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kisa pou M fè ak ou, O Éphraïm?","poem":1},{"lineBreak":true},{"text":"Kisa pou M fè ak ou, O Juda?","poem":1},{"lineBreak":true},{"text":"Paske fidelite ou tankou nwaj nan maten,","poem":1},{"lineBreak":true},{"text":"tankou farinay ki disparèt bonè.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Akoz sa, Mwen te taye yo an mòso ak pwofèt yo;","poem":1},{"lineBreak":true},{"text":"Mwen te touye yo ak pawòl bouch Mwen.","poem":1},{"lineBreak":true},{"text":"Jijman Ou yo se tankou loray k ap tire.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Paske, Mwen pito mizerikòd olye sakrifis,","poem":1},{"lineBreak":true},{"text":"epi konesans Bondye a plis ke ofrann brile.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Men yo menm, tankou Adam te kase transgresyon akò a.","poem":1},{"lineBreak":true},{"text":"La, yo pa t fidèl anvè Mwen.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Galaad se yon vil ki plen ak malfektè,","poem":1},{"lineBreak":true},{"text":"plen ak tach san.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Epi tankou bandi k ap tann yon moun;","poem":1},{"lineBreak":true},{"text":"konsa, yon twoup prèt asasine moun","poem":1},{"lineBreak":true},{"text":"sou wout pou rive Sichem nan.","poem":1},{"lineBreak":true},{"text":"Se gwo krim y ap fè.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nan lakay Israël, Mwen te wè yon move bagay.","poem":1},{"lineBreak":true},{"text":"Gen pwostitisyon nan Éphraïm.","poem":1},{"lineBreak":true},{"text":"Israël souye pwòp tèt li.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ou menm tou, O Juda!","poem":1},{"lineBreak":true},{"text":"Gen yon rekòlt ki deja apwente pou ou menm,","poem":1},{"lineBreak":true},{"text":"lè Mwen retabli byennèt pèp Mwen an.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}