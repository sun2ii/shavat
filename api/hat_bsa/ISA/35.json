{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"ISA","translationId":"hat_bsa","name":"Ésaïe","commonName":"Ésaïe","title":"ÉSAÏE","order":23,"numberOfChapters":66,"sha256":"d1a5242e3bff34cd3cf93bac6681c4687bad5d283be7b74b41baa80155d6c849","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hat_bsa/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":[{"text":"Savann nan ak dezè a va kontan.","poem":1},{"lineBreak":true},{"text":"Tè dezole a va rejwi e flèri, tankou yon woz.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Li va fleri anpil, rejwi ak kè kontan,","poem":1},{"lineBreak":true},{"text":"e fè yon kri lajwa.","poem":1},{"lineBreak":true},{"text":"Glwa Liban an va bay a li menm;","poem":1},{"lineBreak":true},{"text":"majeste a Carmen ak Saron an.","poem":1},{"lineBreak":true},{"text":"Yo va wè glwa SENYÈ a, majeste a Bondye nou an.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ankouraje men ki pedi fòs,","poem":1},{"lineBreak":true},{"text":"e ranfòse jenou ki fèb la.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pale a sila ki gen kè twouble yo,","poem":1},{"lineBreak":true},{"text":"“Pran kouraj!","poem":1},{"lineBreak":true},{"text":"Pa pè!","poem":1},{"lineBreak":true},{"text":"Gade byen, Bondye nou an va vini ak vanjans.","poem":1},{"lineBreak":true},{"text":"Rekonpans Li an va rive.","poem":1},{"lineBreak":true},{"text":"Li va vini, e Li va sove nou.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Konsa, zye avèg yo va louvri,","poem":1},{"lineBreak":true},{"text":"e zòrèy a soud yo debouche.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Moun bwate yo va vòltije tankou sèf,","poem":1},{"lineBreak":true},{"text":"e lang bèbè a va rele ak gwo jwa.","poem":1},{"lineBreak":true},{"text":"Paske dlo va pete nan tè sèch yo,","poem":1},{"lineBreak":true},{"text":"ak vwa dlo yo nan dezè a.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Peyi deseche a va vin tounen yon letan,","poem":1},{"lineBreak":true},{"text":"e tè swaf kòn sous k ap pete dlo.","poem":1},{"lineBreak":true},{"text":"Nan landwa chen mawon yo,","poem":1},{"lineBreak":true},{"text":"nan kote yo poze a , va gen zèb ak wozo ak jon.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yon gran chemen va la, yon gran ri.","poem":1},{"lineBreak":true},{"text":"Li va rele Chemen Sen an.","poem":1},{"lineBreak":true},{"text":"Sila ki pa pwòp p ap vwayaje sou li,","poem":1},{"lineBreak":true},{"text":"men li va sèvi pou sila ki mache nan Chemen an.","poem":1},{"lineBreak":true},{"text":"Moun mechan ak enpridan an pa p mache la.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nanpwen lyon k ap la,","poem":1},{"lineBreak":true},{"text":"ni p ap gen bèt sovaj k ap mache sou li.","poem":1},{"lineBreak":true},{"text":"Yo p ap twouve la.","poem":1},{"lineBreak":true},{"text":"Men rachte yo va mache la.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Rachte a SENYÈ yo va retounen.","poem":1},{"lineBreak":true},{"text":"Ya vini ak gwo kri lajwa lantre nan Sion;","poem":1},{"lineBreak":true},{"text":"lajwa ki p ap janm fini ap sou tèt yo.","poem":1},{"lineBreak":true},{"text":"Yo va twouve kè kontan ak lajwa;","poem":1},{"lineBreak":true},{"text":"tristès ak soupi va sove ale.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}