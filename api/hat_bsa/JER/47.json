{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"JER","translationId":"hat_bsa","name":"Jérémie","commonName":"Jérémie","title":"Liv JÉRÉMIE","order":24,"numberOfChapters":52,"sha256":"fb4a1ad5a5db104d189aa15d2de776185f3fa9de9737c1c800d98cb274379094","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/hat_bsa/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":47,"content":[{"type":"verse","number":1,"content":["Sa ki te vini kon pawòl SENYÈ a de Jérémie, pwofèt la, konsènan Filisten yo, avan Farawon te fin bat peyi Gaza."]},{"type":"verse","number":2,"content":["Konsa pale SENYÈ a:",{"text":"“Gade byen, dlo yo ap leve soti nan nò","poem":1},{"lineBreak":true},{"text":"e l ap vin fè yon gwo fòs inondasyon dlo k ap debòde","poem":1},{"lineBreak":true},{"text":"jis li vin kouvri latè ak tout kapasite l,","poem":1},{"lineBreak":true},{"text":"menm vil a sila ki rete ladann.","poem":1},{"lineBreak":true},{"text":"Mesye yo va kriye fò,","poem":1},{"lineBreak":true},{"text":"e tout moun ladann va rele anmwey.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Akoz bri zago cheval li k ap kouri rèd,","poem":1},{"lineBreak":true},{"text":"zen a cha li yo, ak gwonde a wou yo,","poem":1},{"lineBreak":true},{"text":"papa yo pa p retounen pran pitit yo,","poem":1},{"lineBreak":true},{"text":"men men yo va lage nèt ak sezisman.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Akoz jou k ap vini pou detwi tout Filisten yo,","poem":1},{"lineBreak":true},{"text":"pou koupe retire nèt de Tyr ak Sidon tout soutyen ki rete yo;","poem":1},{"lineBreak":true},{"text":"paske SENYÈ a ap detwi Filisten yo,","poem":1},{"lineBreak":true},{"text":"retay a kot Caphtor a.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gaza vin chòv;","poem":1},{"lineBreak":true},{"text":"Askalon te fin detwi nèt.","poem":1},{"lineBreak":true},{"text":"O retay vale yo!","poem":1},{"lineBreak":true},{"text":"Pandan konbyen de tan","poem":1},{"lineBreak":true},{"text":"nou va blese pwòp chè nou?","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“‘Ah nepe SENYÈ a!","poem":1},{"lineBreak":true},{"text":"Pandan konbyen de tan","poem":1},{"lineBreak":true},{"text":"ou va refize vin kalm?","poem":1},{"lineBreak":true},{"text":"Ralanti, rantre nan fouwo a;","poem":1},{"lineBreak":true},{"text":"repoze e rete trankil.’","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Kòman li ka kalm, lè SENYÈ a bay li lòd?","poem":1},{"lineBreak":true},{"text":"Kont Ashkalon, kont kot lanmè a;","poem":1},{"lineBreak":true},{"text":"Se la, Li te ranje pou l te fèt.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}