{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"JOB","translationId":"hat_bsa","name":"Job","commonName":"Job","title":"JOB","order":18,"numberOfChapters":42,"sha256":"522a7ddd3a585c79965c2b5be9aa15fc570e511d3b2a614daefe863fed469e96","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hat_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":["“Lespri m fin kase.",{"text":"Jou m yo etenn;","poem":1},{"lineBreak":true},{"text":"tonbo a pare pou mwen.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Anverite mokè yo avè m,","poem":1},{"lineBreak":true},{"text":"e zye m fikse sou pwovokasyon yo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Depoze la koulye a, yon sekirite.","poem":1},{"lineBreak":true},{"text":"Kanpe kon garanti mwen, ak Ou menm.","poem":1},{"lineBreak":true},{"text":"Se kilès ki kab antann avè m?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Paske Ou te anpeche kè yo konprann;","poem":1},{"lineBreak":true},{"text":"pou sa, ou pa p egzalte yo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sila ki enfòme kont zanmi li yo pou piyaj la,","poem":1},{"lineBreak":true},{"text":"menm zye pitit li yo va vin gate.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Men Li te fè m vin tounen yon vye pwovèb pou pèp la.","poem":1},{"lineBreak":true},{"text":"Konsa, yo vin krache sou figi m.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Anplis, zye m vin pa wè klè akoz doulè m,","poem":1},{"lineBreak":true},{"text":"e tout nanm mwen tankou lonbraj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Moun ladwati va byen twouble ak sa,","poem":1},{"lineBreak":true},{"text":"e linosan an va leve li menm kont enkwayan yo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Malgre, moun dwat la va kenbe chemen li","poem":1},{"lineBreak":true},{"text":"e sila ki gen men pwòp yo va vin pi fò e pi fò.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Men nou tout, retounen;","poem":1},{"lineBreak":true},{"text":"malgre mwen pa twouve yon nonm saj pami nou.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Jou pa m yo fin pase, plan mwen yo vin chire nèt,","poem":1},{"lineBreak":true},{"text":"menm dezi a kè mwen yo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yo fè lannwit mwen vin sanble lajounen.","poem":1},{"lineBreak":true},{"text":"Yo di ‘limyè a toupre’ lè tout se fènwa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Si mwen chache Sejou mò yo kon lakay mwen,","poem":1},{"lineBreak":true},{"text":"si mwen fè kabann mwen nan tenèb la;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Si mwen kriye a fòs tonbo a:","poem":1},{"lineBreak":true},{"text":"‘Se ou ki papa m’; epi a vè a:","poem":1},{"lineBreak":true},{"text":"“Ou se manman m ak sè m’;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Alò, koulye a, se kibò espwa mwen ye?","poem":1},{"lineBreak":true},{"text":"Epi se kilès k ap okipe espwa m?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Èske espwa m va desann avèk mwen","poem":1},{"lineBreak":true},{"text":"nan Sejou Lanmò yo?","poem":1},{"lineBreak":true},{"text":"Èske se ansanm n ap desann nan pousyè a?”","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}