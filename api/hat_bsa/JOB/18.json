{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"JOB","translationId":"hat_bsa","name":"Job","commonName":"Job","title":"JOB","order":18,"numberOfChapters":42,"sha256":"522a7ddd3a585c79965c2b5be9aa15fc570e511d3b2a614daefe863fed469e96","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hat_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":["Epi Bildad, Shuach la te reponn:"]},{"type":"verse","number":2,"content":[{"text":"“Pou jiskilè ou va chase pawòl?","poem":1},{"lineBreak":true},{"text":"Montre bon sans ou pou nou kab pale.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Poukisa nou gade tankou bèt,","poem":1},{"lineBreak":true},{"text":"tankou sòt nan zye ou?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"O ou menm ki chire pwòp kò ou menm nan kòlè ou,","poem":1},{"lineBreak":true},{"text":"èske se pou lakoz ou menm ke tè a ta abandone,","poem":1},{"lineBreak":true},{"text":"oswa wòch la deplase nan plas li?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Anverite, limyè a mechan an va etenn,","poem":1},{"lineBreak":true},{"text":"e flanm dife li pap bay limyè.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Limyè nan tant li an vin fènwa,","poem":1},{"lineBreak":true},{"text":"e lanp li etenn sou li.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gran pa dyanm li yo vin kout,","poem":1},{"lineBreak":true},{"text":"e pwòp manèv li a vin desann li.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Paske li tonbe nan pèlen an akoz pwòp pye li","poem":1},{"lineBreak":true},{"text":"e li mache sou file a.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yon pèlen pran l pa talon,","poem":1},{"lineBreak":true},{"text":"e yon filè vin fèmen sou li.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yon pyèj kache pou li nan tè a,","poem":1},{"lineBreak":true},{"text":"e yon zatrap sou chemen li.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Patou laperèz fè l sezi e kouri dèyè l","poem":1},{"lineBreak":true},{"text":"nan chak pa ke li fè.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fòs li vin epwize e gwo dega parèt akote li.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kò li devore pa maladi;","poem":1},{"lineBreak":true},{"text":"premye ne lanmò a devore manm kò li yo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Li fin chire soti nan sekirite tant li an","poem":1},{"lineBreak":true},{"text":"e yo pran l pou l parèt devan wa laperèz la.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Anyen pa rete nan tant li ki pou li;","poem":1},{"lineBreak":true},{"text":"souf gaye toupatou sou abitasyon li.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Rasin li vin sèch anba li,","poem":1},{"lineBreak":true},{"text":"e branch li fin koupe pa anwo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Memwa li fin disparèt sou tè a","poem":1},{"lineBreak":true},{"text":"men li pa gen non nan okenn lòt peyi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Li bourade pouse lwen limyè a pou rive nan tenèb,","poem":1},{"lineBreak":true},{"text":"e chase jis deyò mond kote moun rete a.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Li pa gen ni desandan ni posterite pami pèp li a,","poem":1},{"lineBreak":true},{"text":"ni okenn moun ki rete kote li te demere.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Sila nan lwès yo vin revòlte de desten li","poem":1},{"lineBreak":true},{"text":"e sila nan lès yo vin sezi ak laperèz.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Anverite, se konsa abitasyon a mechan yo ye a.","poem":1},{"lineBreak":true},{"text":"Sa se plas a sila ki pa konnen Bondye a.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}