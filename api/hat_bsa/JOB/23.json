{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"JOB","translationId":"hat_bsa","name":"Job","commonName":"Job","title":"JOB","order":18,"numberOfChapters":42,"sha256":"522a7ddd3a585c79965c2b5be9aa15fc570e511d3b2a614daefe863fed469e96","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hat_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":["Alò, Job te reponn:"]},{"type":"verse","number":2,"content":[{"text":"Menm jodi a, plent mwen yo se rebelyon.","poem":1},{"lineBreak":true},{"text":"Men Li rete lou malgre tout plent mwen yo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"O ke m ta kab konnen kibò mwen ta kab twouve Li,","poem":1},{"lineBreak":true},{"text":"pou m ta kab pwoche chèz Li a!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mwen ta prezante ka m nan devan L,","poem":1},{"lineBreak":true},{"text":"e plen bouch mwen ak diskou yo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mwen ta vin aprann pawòl ke Li ta reponn yo","poem":1},{"lineBreak":true},{"text":"e apèsi sa Li ta di m.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Èske Li ta sèvi gran fòs Li pou goumen ak mwen?","poem":1},{"lineBreak":true},{"text":"Non, anverite, Li ta koute mwen.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"La, moun ladwati yo ta rezone avè L;","poem":1},{"lineBreak":true},{"text":"epi mwen ta delivre jis pou tout tan de Jij mwen an.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Men gade, mwen fè avan, men Li pa la,","poem":1},{"lineBreak":true},{"text":"e mwen fè bak, men mwen pa kab twouve Li.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lè L aji agoch, mwen pa kab wè Li.","poem":1},{"lineBreak":true},{"text":"Li vire adwat, mwen pa wè L.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Men Li konnen chemen ke m pran an.","poem":1},{"lineBreak":true},{"text":"Li fè m pase a leprèv, e mwen va sòti tankou lo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Pye m te kenbe fèm a pa Li.","poem":1},{"lineBreak":true},{"text":"Mwen te kenbe chemen Li an, e mwen pa t vire akote.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mwen pa t kite kòmand a lèv Li yo.","poem":1},{"lineBreak":true},{"text":"Mwen te kenbe pawòl a bouch Li","poem":1},{"lineBreak":true},{"text":"kon pi presye pase manje ki fè m gen fòs la.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Men pa gen lòt tankou Li;","poem":1},{"lineBreak":true},{"text":"se kilès ki kab kanpe kont Li?","poem":1},{"lineBreak":true},{"text":"Sa ke nanm Li pito, se sa ke Li fè.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Paske li acheve sa ki deziye pou mwen an.","poem":1},{"lineBreak":true},{"text":"Se anpil dekrè konsa ki rete avè L.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Pou sa, mwen deranje nèt nan prezans Li.","poem":1},{"lineBreak":true},{"text":"Lè m kalkile, Li fè m pè anpil.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Se Bondye ki fè kè m sote.","poem":1},{"lineBreak":true},{"text":"Se Toupwisan an ki deranje m konsa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Akoz mwen pat koupe retire nèt avan fenwà a,","poem":1},{"lineBreak":true},{"text":"ni Li pat kouvri gwo tenèb la devan figi m.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}