{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"JOB","translationId":"hat_bsa","name":"Job","commonName":"Job","title":"JOB","order":18,"numberOfChapters":42,"sha256":"522a7ddd3a585c79965c2b5be9aa15fc570e511d3b2a614daefe863fed469e96","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hat_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":["Alò, Bildad, Shouachyen an te reponn:"]},{"type":"verse","number":2,"content":[{"text":"Tout pouvwa ak lakrent apatyen a Sila","poem":1},{"lineBreak":true},{"text":"ki etabli lapè nan wotè Li yo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Èske fòs kantite sòlda Li yo kab kontwole?","poem":1},{"lineBreak":true},{"text":"Epi sou kilès ke limyè Li pa leve?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Konsa, se kijan yon nonm kapab dwat devan Bondye?","poem":1},{"lineBreak":true},{"text":"Oswa, kijan sila ki te fèt de fanm nan kapab vin pwòp?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nan zye pa Li, menm lalin pa klè, ni zetwal yo pa pwòp,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Konbyen, anmwens lòm, yon vè,","poem":1},{"lineBreak":true},{"text":"ak fis la a lòm nan, vè a menm nan!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}