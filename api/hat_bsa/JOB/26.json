{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"JOB","translationId":"hat_bsa","name":"Job","commonName":"Job","title":"JOB","order":18,"numberOfChapters":42,"sha256":"522a7ddd3a585c79965c2b5be9aa15fc570e511d3b2a614daefe863fed469e96","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hat_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":["Epi Job te reponn:"]},{"type":"verse","number":2,"content":[{"text":"Kèl kalite èd ou ye pou fèb yo!","poem":1},{"lineBreak":true},{"text":"Kèl sekou ou te bay a bra ki te san fòs la!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kèl konsèy ou te bay a sila ki san sajès la!","poem":1},{"lineBreak":true},{"text":"Kèl kalite bèl eklèsisman ou te bay an abondans!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Se a kilès ou t ap eksprime pawòl sa yo menm?","poem":1},{"lineBreak":true},{"text":"Epi se lespri a kilès ki te enspire ou menm?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lespri mò yo tranble anba dlo yo","poem":1},{"lineBreak":true},{"text":"avèk tout sila ki rete ladann yo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sejou Lanmò An se toutouni devan Bondye.","poem":1},{"lineBreak":true},{"text":"Labim nan pa gen kouvèti.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Li lonje rale zetwal nò a sou espas vid.","poem":1},{"lineBreak":true},{"text":"Li fè mond lan pandye san anyen pap kenbe l.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Li vlope dlo yo nan nwaj Li yo,","poem":1},{"lineBreak":true},{"text":"e nwaj la pa pete anba fòs yo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Li fè kache figi gwo lalin nan","poem":1},{"lineBreak":true},{"text":"e gaye nwaj Li sou li.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Li te trase yon lizyè sou sifas dlo yo,","poem":1},{"lineBreak":true},{"text":"ak pou limit tenèb la ak limyè a.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Pilye syèl yo tanmen tranble,","poem":1},{"lineBreak":true},{"text":"e yo etone lè L repwòche yo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ak pwisans Li, li kalme lanmè a,","poem":1},{"lineBreak":true},{"text":"e ak bon konprann Li, li te brize Rahab.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ak souf Li, li dekore syèl yo.","poem":1},{"lineBreak":true},{"text":"Se men L ki te frennen sèpan ki t ap sove ale a.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Gade byen, sa se yon ti kras bagay de tout chemen L yo.","poem":1},{"lineBreak":true},{"text":"Epi a la ti kras souf pawòl nou konn tande de Li!","poem":1},{"lineBreak":true},{"text":"Men tonnè pwisans Li an!","poem":1},{"lineBreak":true},{"text":"Se kilès ki kab konprann li?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}