{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"JOB","translationId":"hat_bsa","name":"Job","commonName":"Job","title":"JOB","order":18,"numberOfChapters":42,"sha256":"522a7ddd3a585c79965c2b5be9aa15fc570e511d3b2a614daefe863fed469e96","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hat_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":["Anverite, gen yon min pou ajan",{"text":"e yon plas pou rafine lò.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fè retire nan pousyè a","poem":1},{"lineBreak":true},{"text":"e kwiv la fonn soti nan wòch la.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lòm fè tenèb la pati,","poem":1},{"lineBreak":true},{"text":"e rive jis nan dènye limit lan.","poem":1},{"lineBreak":true},{"text":"Li chache twouve wòch kap kache a,","poem":1},{"lineBreak":true},{"text":"ak nan pwofon fènwa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Li fouye yon twou fon byen lwen kote moun rete,","poem":1},{"lineBreak":true},{"text":"kote ki bliye nèt pa pye moun.","poem":1},{"lineBreak":true},{"text":"Konsa, yo pandye, yo balanse byen lwen limanite.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pou tè a, depi nan li, manje sòti,","poem":1},{"lineBreak":true},{"text":"men anba, li boulvèse tankou dife.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wòch li se sous a pyè safi yo.","poem":1},{"lineBreak":true},{"text":"Epi nan pousyè li, genyen lò.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chemen li pa rekonèt pa koukou,","poem":1},{"lineBreak":true},{"text":"ni zye grigri pa janm wè l.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bèt pi fewòs yo pa mache la,","poem":1},{"lineBreak":true},{"text":"ni lyon pa pase sou li.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Li mete men li sou wòch silèks la.","poem":1},{"lineBreak":true},{"text":"Li chavire mòn yo soti nan baz yo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Li kreve kanal ki pase nan wòch yo,","poem":1},{"lineBreak":true},{"text":"e zye li wè tout sa ki presye.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Li bouche flèv yo pou dlo pa koule","poem":1},{"lineBreak":true},{"text":"e sa ki kache yo, li fè yo parèt nan limyè.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Men se kibò yo twouve sajès?","poem":1},{"lineBreak":true},{"text":"Epi kibò yo jwenn sajès la?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Lòm pa konnen valè li,","poem":1},{"lineBreak":true},{"text":"ni valè li pa kab twouve nan peyi","poem":1},{"lineBreak":true},{"text":"moun vivan yo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Labim nan di: “Li pa nan mwen”.","poem":1},{"lineBreak":true},{"text":"Lanmè a di: ‘Li pa bò kote m’.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Lò pi pa egal ak valè l,","poem":1},{"lineBreak":true},{"text":"ni ajan pa kab peze kon pri li.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Valè li pa kab konpare ak lò Ophir,","poem":1},{"lineBreak":true},{"text":"oswa oniks presye, oswa safì.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ni lò ni vit pa egal avè l,","poem":1},{"lineBreak":true},{"text":"ni li pa kab fè echanj pou bagay ki fèt an lò fen.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Koray ak kristal, bliye sa nèt.","poem":1},{"lineBreak":true},{"text":"Posede sajès se pi wo ke pèl.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Topaz a Éthiopie a pa kab konpare avè l;","poem":1},{"lineBreak":true},{"text":"ni li pa kab valorize an lò pi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"E byen, se kibò sajès la sòti?","poem":1},{"lineBreak":true},{"text":"Epi kibò anplasman bon konprann nan ye?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Konsa, li kache a zye de tout èt vivan yo","poem":1},{"lineBreak":true},{"text":"e kache menm a zwazo syèl yo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Labim nan ak lanmò a pale:","poem":1},{"lineBreak":true},{"text":"‘Ak zòrèy nou, nou konn tande rapò bagay sa a.’","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Bondye konprann chemen li","poem":1},{"lineBreak":true},{"text":"e Li konnen plas li.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“Paske Li chache jis rive nan dènye pwent latè","poem":1},{"lineBreak":true},{"text":"e wè tout bagay anba syèl yo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Lè L te bay pwa a van an","poem":1},{"lineBreak":true},{"text":"e te divize dlo yo pa mezi,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Lè L te etabli yon limit pou lapli","poem":1},{"lineBreak":true},{"text":"e yon chemen pou kout eklè,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Li te wè l e Li te deklare li.","poem":1},{"lineBreak":true},{"text":"Li te etabli li e anplis, Li te konprann bout li.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Konsa, a lòm Li te di:","poem":1},{"lineBreak":true},{"text":"‘Gade byen, lakrent Senyè a, se sa ki sajès;","poem":1},{"lineBreak":true},{"text":"epi kite mal, se sa ki bon konprann.’”","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/JOB/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/JOB/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/JOB/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}