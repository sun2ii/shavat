{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"JOB","translationId":"hat_bsa","name":"Job","commonName":"Job","title":"JOB","order":18,"numberOfChapters":42,"sha256":"522a7ddd3a585c79965c2b5be9aa15fc570e511d3b2a614daefe863fed469e96","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hat_bsa/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":["Konsa, Élihu te kontinye. Li te di:"]},{"type":"verse","number":2,"content":[{"text":"“Èske ou sipoze ke ou ge dwa sa a?","poem":1},{"lineBreak":true},{"text":"Èske ou ap di ‘Ladwati pa m nan depase sa k nan Bondye a?’","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Paske ou mande: ‘Ki avantaj sa ye pou ou?","poem":1},{"lineBreak":true},{"text":"Ki pwofi m ap jwenn ki plis pase si m te fè peche?’","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mwen va reponn ou,","poem":1},{"lineBreak":true},{"text":"menm ak zanmi ou yo tou.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gade nan syèl yo pou wè;","poem":1},{"lineBreak":true},{"text":"epi gade byen nan nwaj yo.","poem":1},{"lineBreak":true},{"text":"Yo pi wo pase ou.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Si ou te peche, kisa ou akonpli kont Li?","poem":1},{"lineBreak":true},{"text":"Epi si transgresyon ou yo anpil, kisa ou fè Li?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Si ou jis, kisa ou ba Li, oswa kisa Li ta jwenn nan men ou?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mechanste ou ka donmaje yon nonm tankou ou menm,","poem":1},{"lineBreak":true},{"text":"e ladwati ou gen benefis pou yon fis a lòm.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Akoz fòs kantite opresyon yo, yo kriye fò.","poem":1},{"lineBreak":true},{"text":"Yo kriye pou sekou akoz bra a pwisan an.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Men pèsòn pa di: ‘Kote Bondye, Kreyatè mwen an,","poem":1},{"lineBreak":true},{"text":"ki bay chan kè kontan yo pandan nwit lan,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ki enstwi nou plis pase bèt latè yo,","poem":1},{"lineBreak":true},{"text":"pou fè nou vin pi saj pase zwazo nan syèl yo?’","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"La, yo kriye fò, men nanpwen repons","poem":1},{"lineBreak":true},{"text":"akoz ògèy moun mechan yo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Anverite, Bondye p ap koute yon kri ki vid,","poem":1},{"lineBreak":true},{"text":"ni Toupwisan an p ap okipe l.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Konbyen anmwens, lè ou di ou pa wè Li.","poem":1},{"lineBreak":true},{"text":"Ka a pase devan L, e fòk se Li ou tann!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Men koulye a, akoz Li pa t fè vizit nan kòlè Li,","poem":1},{"lineBreak":true},{"text":"ni Li pa t apresye awogans,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"pou sa, Job ouvri bouch li an ven;","poem":1},{"lineBreak":true},{"text":"li ogmante pawòl li yo san konesans.”","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}