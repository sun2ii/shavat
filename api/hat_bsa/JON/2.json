{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"JON","translationId":"hat_bsa","name":"Jonas","commonName":"Jonas","title":"JONAS","order":32,"numberOfChapters":4,"sha256":"6ff8ded45915a78d5839d450978692b71daea695a256873e21d95f3f93c7a420","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/hat_bsa/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Konsa, Jonas te priye a SENYÈ Bondye li a depi nan vant pwason an."]},{"type":"verse","number":2,"content":["Li te di:",{"text":"“Mwen te rele nan detrès mwen bay SENYÈ a,","poem":1},{"lineBreak":true},{"text":"e Li te reponn mwen.","poem":1},{"lineBreak":true},{"text":"Mwen te kriye pou sekou","poem":1},{"lineBreak":true},{"text":"depi nan pwofondè sejou mò yo.","poem":1},{"lineBreak":true},{"text":"Ou te tande vwa mwen.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ou te jete mwen nan gwo pwofondè a,","poem":1},{"lineBreak":true},{"text":"nan kè lanmè yo,","poem":1},{"lineBreak":true},{"text":"e gwo kouran dlo a te vale mwen.","poem":1},{"lineBreak":true},{"text":"Gwo lam lanmè ou yo ak gwo vag lanmè","poem":1},{"lineBreak":true},{"text":"ou yo te pase sou mwen.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Konsa, mwen te di: ‘Mwen te vin chase lwen fas ou.","poem":1},{"lineBreak":true},{"text":"Malgre sa, mwen va gade ankò vè tanp sen Ou an.’","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dlo te antoure mwen","poem":1},{"lineBreak":true},{"text":"jiskaske m rive nan pwen lanmò.","poem":1},{"lineBreak":true},{"text":"Gwo pwofondè a te vale mwen;","poem":1},{"lineBreak":true},{"text":"zèb lanmè yo te vlope tèt mwen.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mwen te desann jis rive nan baz mòn yo.","poem":1},{"lineBreak":true},{"text":"Latè ak bawo li yo te antoure mwen pou tout tan,","poem":1},{"lineBreak":true},{"text":"men Ou te leve lavi m monte soti nan fòs la,","poem":1},{"lineBreak":true},{"text":"O SENYÈ Bondye mwen an!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Pandan mwen t ap vin endispoze nèt,","poem":1},{"lineBreak":true},{"text":"Mwen te sonje SENYÈ a","poem":1},{"lineBreak":true},{"text":"e lapriyè mwen te rive kote Ou nan tanp sen Ou an.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sila ki konsidere zidòl san valè yo","poem":1},{"lineBreak":true},{"text":"abandone tout sous mizerikòd,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Men mwen va fè sakrifis a Ou menm","poem":1},{"lineBreak":true},{"text":"ak vwa aksyon de gras la.","poem":1},{"lineBreak":true},{"text":"Sa ke mwen te sèmante a, se li mwen va akonpli.","poem":1},{"lineBreak":true},{"text":"Sali a sòti nan SENYÈ a.”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Epi SENYÈ a te kòmande pwason an","poem":1},{"lineBreak":true},{"text":"e li te vomi Jonas sou tè sèch la.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}