{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"LAM","translationId":"hat_bsa","name":"Lamantasyon Yo","commonName":"Lamantasyon Yo","title":"LAMANTASYON YO","order":25,"numberOfChapters":5,"sha256":"52b60bbfbffeb19465473c076d78cf43d1832a858d307db45184dd07e95a3c26","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/hat_bsa/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":["Sonje, O SENYÈ, sa ki te rive nou an.",{"text":"Gade pou wè repwòch nou.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Eritaj nou te bay kon don a etranje yo,","poem":1},{"lineBreak":true},{"text":"kay nou yo a moun nou pa konnen.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nou te devni òfelen san papa.","poem":1},{"lineBreak":true},{"text":"Manman nou yo tankou vèv.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nou oblije achte dlo pou nou bwè.","poem":1},{"lineBreak":true},{"text":"Bwa nou se pou vann, yo vann nou li.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sila k ap kouri dèyè nou yo rive sou kou nou.","poem":1},{"lineBreak":true},{"text":"Nou vin bouke nèt.","poem":1},{"lineBreak":true},{"text":"Nanpwen repo pou nou.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nou te vin soumèt devan Egypte ak Assyrie","poem":1},{"lineBreak":true},{"text":"pou nou jwenn ase pen.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Papa zansèt nou yo te peche,","poem":1},{"lineBreak":true},{"text":"men yo pa la ankò;","poem":1},{"lineBreak":true},{"text":"se nou menm ki te pote inikite pa yo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Se esklav yo k ap domine sou nou;","poem":1},{"lineBreak":true},{"text":"nanpwen moun ki pou delivre nou nan men yo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nou riske lavi nou pou jwenn pen","poem":1},{"lineBreak":true},{"text":"akoz nepe nan dezè a.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Po nou vin kwit tankou yon fou,","poem":1},{"lineBreak":true},{"text":"akoz gwo chalè grangou a.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yo te ravaje tout fanm Sion yo;","poem":1},{"lineBreak":true},{"text":"vyèj lavil a Juda yo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Prens yo te pann pa men yo;","poem":1},{"lineBreak":true},{"text":"ansyen yo te vin pa respekte.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Jennonm yo te fòse travay devan moulen an","poem":1},{"lineBreak":true},{"text":"e timoun yo te kilbite anba gwo chaj bwa yo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ansyen yo ale kite pòtay la;","poem":1},{"lineBreak":true},{"text":"jennonm yo ale kite mizik yo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Jwa nan kè nou vin sispann;","poem":1},{"lineBreak":true},{"text":"danse vin ranplase pa fè dèy.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kouwòn nan soti sou tèt nou;","poem":1},{"lineBreak":true},{"text":"malè a nou menm, paske nou te peche!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Akoz sa, kè nou febli;","poem":1},{"lineBreak":true},{"text":"akoz bagay sa yo, zye nou pa wè klè.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Akoz Mòn Sion ki kouche dezole nèt,","poem":1},{"lineBreak":true},{"text":"rena yo fè patwouj ladann.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ou menm, O SENYÈ, Ou renye jis pou tout tan;","poem":1},{"lineBreak":true},{"text":"twòn Ou se de jenerasyon an jenerasyon.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Poukisa Ou bliye nou jis pou tout tan?","poem":1},{"lineBreak":true},{"text":"Poukisa Ou abandone nou jis rive tout tan sa a?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Restore nou a Ou menm O SENYÈ,","poem":1},{"lineBreak":true},{"text":"pou nou ka vin restore.","poem":1},{"lineBreak":true},{"text":"Fè jou nou yo vin jan yo te ye nan tan pase yo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Men Ou deja fin rejte nou nèt.","poem":1},{"lineBreak":true},{"text":"Ou rete byen fache nèt ak nou.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}