{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PRO","translationId":"hat_bsa","name":"Pwovèb","commonName":"Pwovèb","title":"PWOVÈB YO","order":20,"numberOfChapters":31,"sha256":"876807e66255c3035ddd75e8bd8b51b036c874e970e7fc6999fb8994751036de","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hat_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Fis mwen an, si ou resevwa pawòl mwen yo,","poem":1},{"lineBreak":true},{"text":"e gade kòmandman mwen yo nan kè ou,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"e fè zòrèy ou atantif a sajès;","poem":1},{"lineBreak":true},{"text":"e enkline zòrèy ou vè bon konprann,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"wi, si ou leve vwa w pou sajès;","poem":1},{"lineBreak":true},{"text":"e leve vwa ou vè bon konprann;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"si ou chache li kon ajan,","poem":1},{"lineBreak":true},{"text":"e fè rechèch dèyè li kon trezò ki kache;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"nan lè sa a, ou va dekouvri lakrent SENYÈ a,","poem":1},{"lineBreak":true},{"text":"e dekouvri konesans Bondye a.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Paske, SENYÈ a bay sajès.","poem":1},{"lineBreak":true},{"text":"Nan bouch Li, soti konesans ak bon konprann.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Li mete sajès nan depo pou moun dwat la.","poem":1},{"lineBreak":true},{"text":"Li se boukliye pou sila ki mache ak entegrite yo,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ka p veye chemen lajistis yo,","poem":1},{"lineBreak":true},{"text":"e pwoteje chemen a fidèl Li yo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Konsa, ou va dekouvri ladwati ak jistis,","poem":1},{"lineBreak":true},{"text":"e menm egalite avèk tout bon chemen yo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Paske, sajès va antre nan kè ou,","poem":1},{"lineBreak":true},{"text":"e konesans va fè ou alèz jis rive nan nanm ou.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bon konprann va pwoteje ou,","poem":1},{"lineBreak":true},{"text":"konesans va veye sou ou,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"pou pwoteje ou kont chemen mal la,","poem":1},{"lineBreak":true},{"text":"kont lòm ki pale bagay pèvès yo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kont sila ki kite chemen ladwati yo","poem":1},{"lineBreak":true},{"text":"pou mache nan chemen fènwa yo;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ki pran plezi nan fè sa ki mal","poem":1},{"lineBreak":true},{"text":"e rejwi nan mechanste mal la.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Chemen a sila ki vin kwochi yo","poem":1},{"lineBreak":true},{"text":"e ki vin gaye kò yo nan tout sa yo fè.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Pou delivre ou soti nan men fanm etranje a,","poem":1},{"lineBreak":true},{"text":"soti nan men fanm adiltè ki flate ak pawòl li;","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ki kite konpanyen jenès li a,","poem":1},{"lineBreak":true},{"text":"e ki bliye akò a Bondye li;","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"paske lakay li mennen a lanmò","poem":1},{"lineBreak":true},{"text":"e tras a pla pye li yo rive kote mò yo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Pèsòn ki ale kote li menm, pa retounen ankò,","poem":1},{"lineBreak":true},{"text":"ni yo pa jwenn pa lavi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Akoz sa a, ou va mache nan chemen a sila ki bon yo,","poem":1},{"lineBreak":true},{"text":"e swiv tras a moun ladwati yo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Paske moun dwat yo va viv nan peyi a,","poem":1},{"lineBreak":true},{"text":"e sila ki san tò yo va rete ladann;","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"men mechan yo va koupe retire nèt de peyi a,","poem":1},{"lineBreak":true},{"text":"e moun trèt yo va dechouke de li.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}