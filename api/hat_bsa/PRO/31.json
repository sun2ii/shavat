{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PRO","translationId":"hat_bsa","name":"Pwovèb","commonName":"Pwovèb","title":"PWOVÈB YO","order":20,"numberOfChapters":31,"sha256":"876807e66255c3035ddd75e8bd8b51b036c874e970e7fc6999fb8994751036de","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hat_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":["Pawòl a wa Lemuel yo; pwofesi ke manman li te ansegne li a:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“O fis mwen an!","poem":1},{"lineBreak":true},{"text":"O fis a vant mwen an!","poem":1},{"lineBreak":true},{"text":"O fis a ve mwen yo!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pa bay fòs ou a fanm,","poem":1},{"lineBreak":true},{"text":"ni wout ou a sila ki konn detwi wa yo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Se pa pou wa yo, O Lemuel,","poem":1},{"lineBreak":true},{"text":"se pa pou wa yo bwè diven, ni pou chèf yo ta bwè diven,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Paske y ap bwè epi vin bliye dekrè ki te fèt la,","poem":1},{"lineBreak":true},{"text":"e tòde dwa a sila ki aflije yo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bay bwason fò a sila k ap peri a,","poem":1},{"lineBreak":true},{"text":"ak diven a sila ki gen lavi anmè a.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kite li bwè pou bliye mizè li","poem":1},{"lineBreak":true},{"text":"e pa sonje pwoblèm li ankò.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ouvri bouch ou pou bèbè a;","poem":1},{"lineBreak":true},{"text":"pou dwa yo a tout sila ki san sekou.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ouvri bouch ou, fè jijman ak dwati,","poem":1},{"lineBreak":true},{"text":"e defann dwa a aflije yo ak endijan an.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yon madanm ki ekselan, se kilès ki ka twouve li?","poem":1},{"lineBreak":true},{"text":"Paske valè li depase bijou.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kè a mari li mete konfyans nan li","poem":1},{"lineBreak":true},{"text":"e li p ap manke reyisi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Li fè l sa ki bon e pa sa ki mal","poem":1},{"lineBreak":true},{"text":"pandan tout jou lavi li.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Li chache lèn ak len e travay avèk men l ak kè kontan.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Li tankou bato komès;","poem":1},{"lineBreak":true},{"text":"li mennen manje li soti byen lwen.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Anplis, li leve pandan li toujou fènwa pou","poem":1},{"lineBreak":true},{"text":"bay manje a tout lakay li,","poem":1},{"lineBreak":true},{"text":"ak yon pòsyon pou sèvant li yo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Li konsidere yon chan e achte li.","poem":1},{"lineBreak":true},{"text":"Ak benefis travay li, li plante yon chan rezen.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Li mare senti l ak gwo fòs","poem":1},{"lineBreak":true},{"text":"pou fè bra li vin fò.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Li santi ke siksè li bon;","poem":1},{"lineBreak":true},{"text":"lanp li pa janm etenn lannwit.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Li lonje men l vè aparèy tise a","poem":1},{"lineBreak":true},{"text":"e men l kenbe l.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Li lonje men l vè pòv yo","poem":1},{"lineBreak":true},{"text":"avèk sila ki gen bezwen an.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Lakay li pa fè krent pou lanèj,","poem":1},{"lineBreak":true},{"text":"paske tout lakay abiye an wouj.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Li fè kouvèti pou tèt li;","poem":1},{"lineBreak":true},{"text":"tout vètman li se twal fen blan ak mov.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mari li byen rekonèt nan pòtay lavil yo,","poem":1},{"lineBreak":true},{"text":"lè l chita pami ansyen a peyi yo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Li fè vètman an len pou vann yo,","poem":1},{"lineBreak":true},{"text":"e founi sentiwon a tout komèsan yo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Fòs ak respè se abiman li","poem":1},{"lineBreak":true},{"text":"e li souri a lavni.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Li ouvri bouch li avèk sajès","poem":1},{"lineBreak":true},{"text":"e enstriksyon ladousè sou lang li.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Li gade byen tout afè lakay li","poem":1},{"lineBreak":true},{"text":"e li pa manje pen laparès.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Pitit li yo leve e beni li;","poem":1},{"lineBreak":true},{"text":"mari li tou ba li gwo lwanj pou di l:","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"“Anpil fi te fè byen bon;","poem":1},{"lineBreak":true},{"text":"men ou pi bon anpil pase yo tout.”","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Chàm konn twonpe e bèlte konn vanite;","poem":1},{"lineBreak":true},{"text":"men se fanm nan ki krent SENYÈ a","poem":1},{"lineBreak":true},{"text":"k ap resevwa lwanj.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ba li sa ke men l te pwodwi,","poem":1},{"lineBreak":true},{"text":"epi kite zèv li yo fè lwanj li nan pòtay yo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":31}