{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PRO","translationId":"hat_bsa","name":"Pwovèb","commonName":"Pwovèb","title":"PWOVÈB YO","order":20,"numberOfChapters":31,"sha256":"876807e66255c3035ddd75e8bd8b51b036c874e970e7fc6999fb8994751036de","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hat_bsa/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":[{"text":"Sajès bati kay li a;","poem":1},{"lineBreak":true},{"text":"li taye sèt gwo pilye li yo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Li te prepare manje li,","poem":1},{"lineBreak":true},{"text":"li te mele diven li; anplis, li fin ranje tab li.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Li voye demwazèl li yo deyò,","poem":1},{"lineBreak":true},{"text":"li rele soti nan anlè wotè pwent vil yo:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"“Pou sila ki ensanse a, kite li antre isit la!”","poem":1},{"lineBreak":true},{"text":"Pou sila ki manke bon konprann nan, li di:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"“Vin manje manje mwen an,","poem":1},{"lineBreak":true},{"text":"e bwè diven ke m te melanje a.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kite foli ou pou ou ka viv;","poem":1},{"lineBreak":true},{"text":"epi avanse nan chemen bon konprann nan.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sila ki korije yon mokè resevwa dezonè pou pwòp tèt li,","poem":1},{"lineBreak":true},{"text":"e sila ki repwoche yon nonm mechan","poem":1},{"lineBreak":true},{"text":"va resevwa ofans sou tèt li.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pa repwoche yon mokè, sinon li va rayi ou;","poem":1},{"lineBreak":true},{"text":"repwoche yon nonm saj e li va renmen ou.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bay konsèy a yon nonm saj e li va vin pi saj,","poem":1},{"lineBreak":true},{"text":"enstwi yon nonm dwat e li va ogmante konesans li.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lakrent SENYÈ a se kòmansman a sajès","poem":1},{"lineBreak":true},{"text":"e konesans a Sila Ki Sen an se bon konprann.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Paske pa mwen, jou ou yo va miltipliye,","poem":1},{"lineBreak":true},{"text":"e ane yo ap ogmante sou lavi ou.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Si ou saj, ou saj pou pwòp tèt ou;","poem":1},{"lineBreak":true},{"text":"e si ou moke, ou pote sa a pou kont ou.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Fanm sòt pale byen fò ak gwo vwa;","poem":1},{"lineBreak":true},{"text":"li bèt, e li pa konnen anyen.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Li chita devan pòtay lakay li,","poem":1},{"lineBreak":true},{"text":"sou yon chèz akote wo plas vil yo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Li rele sila ki pase yo,","poem":1},{"lineBreak":true},{"text":"ki ap fè chemen yo dwat yo:","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Sila ki pa konnen anyen an,","poem":1},{"lineBreak":true},{"text":"kite li antre isit la.","poem":1},{"lineBreak":true},{"text":"Pou sila ki manke konprann nan, li di:","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"“Dlo yo vòlè dous","poem":1},{"lineBreak":true},{"text":"e pen ki manje an sekrè byen agreyab.”","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Men mesye a pa konnen ke se la mò yo ye a.","poem":1},{"lineBreak":true},{"text":"Vizitè li yo la.","poem":1},{"lineBreak":true},{"text":"Yo nan fon Sejou mò yo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}