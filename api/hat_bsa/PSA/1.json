yo p ap kanpe nan chèz jijman an,","poem":1},{"lineBreak":true},{"text":"ni pechè yo nan asanble ak moun dwat yo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Paske SENYÈ a konnen chemen","poem":1},{"lineBreak":true},{"text":"a sila ki dwat yo,","poem":1},{"lineBreak":true},{"text":"men chemen a mechan yo va disparèt.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}