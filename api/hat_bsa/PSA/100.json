,"poem":1},{"lineBreak":true},{"text":"Lanmou dous li a dire jis pou tout tan,","poem":1},{"lineBreak":true},{"text":"e fidelite Li a tout jenerasyon yo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}