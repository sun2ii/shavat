{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["Yon Sòm David"]},{"type":"verse","number":1,"content":[{"text":"Mwen va chante de lanmou dous avèk jistis.","poem":1},{"lineBreak":true},{"text":"A Ou menm, O SENYÈ, mwen va chante lwanj.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mwen va prete atansyon a chemen san repwòch la.","poem":1},{"lineBreak":true},{"text":"Kilè Ou va vini kote mwen?","poem":1},{"lineBreak":true},{"text":"Mwen va mache anndan lakay mwen ak entegrite nan kè m.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mwen p ap mete okenn vye bagay devan zye m.","poem":1},{"lineBreak":true},{"text":"Mwen rayi zèv a sila ki chite yo.","poem":1},{"lineBreak":true},{"text":"Sa p ap tache men l sou mwen.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yon kè ki pèvès va oblije kite prezans mwen.","poem":1},{"lineBreak":true},{"text":"Mwen p ap aksepte konnen okenn mal.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nenpòt moun ki bay vwazen li kout lang an sekrè,","poem":1},{"lineBreak":true},{"text":"li menm, mwen va detwi.","poem":1},{"lineBreak":true},{"text":"Nenpòt moun ak rega awogan oswa ògèy, mwen p ap sipòte li.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Zye m va sou fidèl a peyi a pou yo kab rete avè m.","poem":1},{"lineBreak":true},{"text":"Sila ki mache nan chemen san fot la, se li menm","poem":1},{"lineBreak":true},{"text":"ki va sèvitè mwen.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sila ki pratike manti p ap rete lakay mwen.","poem":1},{"lineBreak":true},{"text":"Sila ki bay manti p ap kenbe pozisyon li devan m.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chak maten mwen va detwi tout mechan nan peyi yo,","poem":1},{"lineBreak":true},{"text":"Pou m kab koupe retire nan vil SENYÈ a, tout moun ki fè inikite yo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}