{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":108,"content":[{"type":"hebrew_subtitle","content":["Yon chan. Yon Sòm David"]},{"type":"verse","number":1,"content":[{"text":"Kè m fèm, O Bondye; mwen va chante.","poem":1},{"lineBreak":true},{"text":"Mwen va chante lwanj ou, menm avèk tout nanm mwen.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fè leve ap avèk lir!","poem":1},{"lineBreak":true},{"text":"Mwen va fè leve solèy la!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mwen va bay remèsiman a Ou menm, O SENYÈ, pami pèp yo.","poem":1},{"lineBreak":true},{"text":"Mwen va chante lwanj a Ou pami nasyon yo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Paske lanmou dous Ou a gran pase syèl yo,","poem":1},{"lineBreak":true},{"text":"e verite Ou rive jis nan syèl yo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Leve wo, O Bondye, anwo syèl yo ak glwa Ou anwo tout tè a.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pou sila ke Ou tèlman renmen an, kapab delivre.","poem":1},{"lineBreak":true},{"text":"Sove avèk men dwat Ou e reponn mwen!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bondye te pale nan sentete Li a: “Mwen va leve wo,","poem":1},{"lineBreak":true},{"text":"Mwen va divize Sichem, e mezire tout vale Succoth la.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Galaad se pou Mwen. Manassé se pa M.","poem":1},{"lineBreak":true},{"text":"Ephraïm se kas sou tèt Mwen.","poem":1},{"lineBreak":true},{"text":"Juda se baton wayal Mwen.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Moab se basen lesiv Mwen.","poem":1},{"lineBreak":true},{"text":"Sou Edom, Mwen va jete soulye M.","poem":1},{"lineBreak":true},{"text":"Sou Philistie, Mwen va rele byen fò.”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Se kilès ki va mennen M antre nan vil fòtifye a?","poem":1},{"lineBreak":true},{"text":"Kilès ki va mennen M Edom?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Se pa ke Ou, Ou menm, O Bondye, te rejte nou an?","poem":1},{"lineBreak":true},{"text":"Èske Ou p ap sòti avèk lame nou yo, O Bondye?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"O bannou sekou kont advèsè a,","poem":1},{"lineBreak":true},{"text":"paske delivrans a lòm se anven.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Avèk Bondye, nou va fè zèv vanyan.","poem":1},{"lineBreak":true},{"text":"Se Li menm ki va foule advèsè nou yo anba pye L.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}