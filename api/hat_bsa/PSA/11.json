{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la; yon sòm David"]},{"type":"verse","number":1,"content":[{"text":"Se nan SENYÈ a ke m kache.","poem":1},{"lineBreak":true},{"text":"Kijan ou kapab di a nanm mwen:","poem":1},{"lineBreak":true},{"text":"“Sove ale kon yon zwazo nan mòn ou;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Paske, gade byen, mechan yo koube banza,","poem":1},{"lineBreak":true},{"text":"Yo fè flèch yo parèt sou kòd la,","poem":1},{"lineBreak":true},{"text":"pou tire nan fènwa sou sila ak kè ki dwat yo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Si fondasyon yo vin detwi,","poem":1},{"lineBreak":true},{"text":"se kisa moun dwat yo kab fè?”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"SENYÈ a nan sen tanp Li an.","poem":1},{"lineBreak":true},{"text":"SENYÈ a sou twon Li nan syèl la.","poem":1},{"lineBreak":true},{"text":"Zye Li veye.","poem":1},{"lineBreak":true},{"text":"Pòpyè zye Li sonde fis a lòm yo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"SENYÈ a sonde sila ki jis yo avèk sila ki mechan yo;","poem":1},{"lineBreak":true},{"text":"men sila ki renmen vyolans, Li rayi nan kè L.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sou mechan yo, Li va voye chabon cho tankou lapli;","poem":1},{"lineBreak":true},{"text":"dife avèk souf avèk chabon brile va mele nan bwason yo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Paske Bondye dwat.","poem":1},{"lineBreak":true},{"text":"Li renmen ladwati.","poem":1},{"lineBreak":true},{"text":"Sila ki kanpe dwat yo va wè figi Li.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}