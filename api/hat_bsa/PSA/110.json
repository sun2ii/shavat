{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["Yon Sòm David"]},{"type":"verse","number":1,"content":[{"text":"SENYÈ a di a Senyè mwen an: “Chita bò kote men dwat Mwen","poem":1},{"lineBreak":true},{"text":"Jiskaske Mwen fè ènmi Ou yo vin yon machpye pou Ou.”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"SENYÈ a va lonje baton wayal Ou a soti nan Sion e di:","poem":1},{"lineBreak":true},{"text":"“Se pou ou renye nan mitan ènmi Ou yo”.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pèp Ou a va sèvi ak bòn volonte nan jou pouvwa Ou yo.","poem":1},{"lineBreak":true},{"text":"Yo parèt an sentete, soti nan zantray maten an;","poem":1},{"lineBreak":true},{"text":"ak jennes Ou, tankou lawouzaj gran maten an.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"SENYÈ a fin sèmante. Li p ap chanje panse L:","poem":1},{"lineBreak":true},{"text":"“Ou se yon prèt jis pou tout tan selon lòd Melchisédek.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"SENYÈ a sou men dwat ou.","poem":1},{"lineBreak":true},{"text":"Li va kraze wa yo nan jou kòlè Li a.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Li va jije pami nasyon yo.","poem":1},{"lineBreak":true},{"text":"Li fè gwo pil kadav yo,","poem":1},{"lineBreak":true},{"text":"Li va brize tèt a chèf tout latè a.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Li va bwè nan flèv pandan L an wout;","poem":1},{"lineBreak":true},{"text":"konsa, Li va leve tèt Li wo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}