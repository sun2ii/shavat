{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"Louwe SENYÈ a!","poem":1},{"lineBreak":true},{"text":"Mwen va bay lwanj a SENYÈ a ak tout kè m,","poem":1},{"lineBreak":true},{"text":"Ansanm ak moun ladwati yo ak nan asanble a.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gran se zèv a SENYÈ yo!","poem":1},{"lineBreak":true},{"text":"Yo etidye pa tout moun ki pran plezi nan yo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ranpli ak bèlte avèk majeste se zèv Li yo.","poem":1},{"lineBreak":true},{"text":"Ladwati Li dire jis pou tout tan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Li te fè mèvèy Li yo pou nou sonje nèt.","poem":1},{"lineBreak":true},{"text":"SENYÈ a ranpli ak gras avèk mizerikòd.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Li te bay manje a sila ki gen lakrent Li yo.","poem":1},{"lineBreak":true},{"text":"Li va sonje akò Li a jis pou tout tan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Li te fè pèp Li wè pouvwa a a zèv Li yo,","poem":1},{"lineBreak":true},{"text":"lè L te bay yo nasyon yo kòn eritaj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Zèv men Li yo se verite avèk jistis.","poem":1},{"lineBreak":true},{"text":"Tout prensip Li yo vrè.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yo va andire jis pou tout tan.","poem":1},{"lineBreak":true},{"text":"Yo fèt nan verite avèk ladwati.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Li te voye delivrans a pèp Li a.","poem":1},{"lineBreak":true},{"text":"Li te òdone akò Li a jis pou tout tan.","poem":1},{"lineBreak":true},{"text":"Sen e mèvèye, se non Li.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lakrent SENYÈ a se kòmansman sajès.","poem":1},{"lineBreak":true},{"text":"Tout sila ki fè kòmandman Li yo gen bon konprann.","poem":1},{"lineBreak":true},{"text":"Lwanj Li dire jis pou tout tan!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}