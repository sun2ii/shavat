{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"Louwe SENYÈ a!","poem":1},{"lineBreak":true},{"text":"A la beni nonm ki krent SENYÈ a beni!","poem":1},{"lineBreak":true},{"text":"Sila ki pran gwo plezi nan kòmandman Li yo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Desandan li yo va pwisan sou latè.","poem":1},{"lineBreak":true},{"text":"Jenerasyon ladwati a va beni.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Anpil byen ak gwo richès rete lakay li.","poem":1},{"lineBreak":true},{"text":"Ladwati li dire pou tout tan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Limyè vin leve nan tenèb pou moun ladwati a;","poem":1},{"lineBreak":true},{"text":"Li plen gras ak mizerikòd, ak jistis.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"L ale byen pou nonm nan ki gen mizerikòd e ki prete;","poem":1},{"lineBreak":true},{"text":"Li va prezève koz li a nan jijman an.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Paske li p ap janm ebranle.","poem":1},{"lineBreak":true},{"text":"Moun dwat la va sonje jis pou tout tan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Li p ap krent move nouvèl.","poem":1},{"lineBreak":true},{"text":"Kè Li fèm ak konfyans nan SENYÈ a.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kè li kanpe janm.","poem":1},{"lineBreak":true},{"text":"Li pa pè anyen, jiskaske denyè moman an lè","poem":1},{"lineBreak":true},{"text":"li gade ak kè kontan advèsè li yo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Li te bay ak jenewozite a pòv yo.","poem":1},{"lineBreak":true},{"text":"Ladwati li dire jis pou tout tan.","poem":1},{"lineBreak":true},{"text":"Kòn li va egzalte nan lonè.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mechan an va wè l e l ap vekse nèt.","poem":1},{"lineBreak":true},{"text":"Li va manje dan l e vin fonn pou l disparèt.","poem":1},{"lineBreak":true},{"text":"Dezi a mechan an va peri.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}