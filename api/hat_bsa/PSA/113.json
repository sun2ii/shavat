{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Louwe SENYÈ a!","poem":1},{"lineBreak":true},{"text":"Louwe, O sèvitè a SENYÈ yo,","poem":1},{"lineBreak":true},{"text":"Louwe non SENYÈ a.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Beni se non SENYÈ a,","poem":1},{"lineBreak":true},{"text":"soti nan tan sa a e jis pou tout tan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Depi solèy leve jiskaske li kouche,","poem":1},{"lineBreak":true},{"text":"non SENYÈ a dwe louwe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"SENYÈ a wo, anwo tout nasyon yo!","poem":1},{"lineBreak":true},{"text":"Glwa Li pi wo syèl yo!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Se kilès ki tankou SENYÈ a, Bondye nou an,","poem":1},{"lineBreak":true},{"text":"Ki sou twòn Li anwo a,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ki abese tèt Li pou gade tout bagay","poem":1},{"lineBreak":true},{"text":"ki nan syèl yo ak sou latè yo?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Li fè malere a leve sòti nan pousyè a","poem":1},{"lineBreak":true},{"text":"e leve endijan an sòti nan pil sann nan,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"pou fè yo chita avèk prens yo.","poem":1},{"lineBreak":true},{"text":"Menm avèk prens a pèp Li yo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Li fè fanm steril la vin rete nan kay","poem":1},{"lineBreak":true},{"text":"kon yon manman pitit ak kè kontan.","poem":1},{"lineBreak":true},{"text":"Louwe SENYÈ a!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}