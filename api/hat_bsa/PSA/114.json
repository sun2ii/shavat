{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"Lè Israël te sòti an Égypte,","poem":1},{"lineBreak":true},{"text":"lakay Jacob soti de yon pèp lang etranje,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Juda te vin sanktiyè Li a,","poem":1},{"lineBreak":true},{"text":"Israël, wayòm Li.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lanmè a te gade e te sove ale.","poem":1},{"lineBreak":true},{"text":"Jourdain an te vire fè bak.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mòn yo te sote tankou belye,","poem":1},{"lineBreak":true},{"text":"kolin yo tankou ti mouton.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sa k pase ou menm, O lanmè, ke ou te sove ale konsa?","poem":1},{"lineBreak":true},{"text":"O Jourdain an, ke Ou te vire fè bak konsa?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"O mòn yo, ke ou sote tankou belye konsa?","poem":1},{"lineBreak":true},{"text":"O kolin yo, tankou ti mouton konsa?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pran tranble, O latè, devan SENYÈ a,","poem":1},{"lineBreak":true},{"text":"Devan Bondye a Jacob la,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ki te fè wòch la devni yon ma dlo,","poem":1},{"lineBreak":true},{"text":"wòch silèks la yon sous k ap koule.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}