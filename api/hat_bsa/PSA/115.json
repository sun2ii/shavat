{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":115,"content":[{"type":"verse","number":1,"content":[{"text":"Pa pou nou, O SENYÈ, pa pou nou,","poem":1},{"lineBreak":true},{"text":"men pou Non Ou glwa bay,","poem":1},{"lineBreak":true},{"text":"akoz lanmou dous Ou, akoz verite Ou.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Poukisa nasyon yo ta di:","poem":1},{"lineBreak":true},{"text":"“Kote Bondye yo a ye koulye a?”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Men Bondye nou an nan syèl yo.","poem":1},{"lineBreak":true},{"text":"Li fè sa Li pito.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Zidòl yo se ajan ak lò, zèv men a lòm.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yo gen bouch, men yo pa kab pale.","poem":1},{"lineBreak":true},{"text":"Yo gen zye, men yo pa kab wè.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yo gen zòrèy, men yo pa kab tande.","poem":1},{"lineBreak":true},{"text":"Yo gen nen, men yo pa kab santi anyen.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yo gen men, men yo pa kab manyen.","poem":1},{"lineBreak":true},{"text":"Yo gen pye, men yo pa kab mache.","poem":1},{"lineBreak":true},{"text":"Nanpwen okenn bri ki sòti nan gòj yo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sila ki mete konfyans nan yo va tankou yo.","poem":1},{"lineBreak":true},{"text":"Wi, tankou tout moun ki fè yo konfyans yo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O Israël, mete konfyans ou nan SENYÈ a!","poem":1},{"lineBreak":true},{"text":"Se Li menm ki sekou ak boukliye yo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"O lakay Aaron, mete konfyans ou nan SENYÈ a;","poem":1},{"lineBreak":true},{"text":"Se Li menm ki sekou ak boukliye yo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nou menm ki gen lakrent SENYÈ a,","poem":1},{"lineBreak":true},{"text":"mete konfyans nou nan SENYÈ a.","poem":1},{"lineBreak":true},{"text":"Se Li menm ki sekou yo ak boukliye yo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"SENYÈ a te toujou sonje nou.","poem":1},{"lineBreak":true},{"text":"Li va beni nou.","poem":1},{"lineBreak":true},{"text":"Li va beni lakay Israël la.","poem":1},{"lineBreak":true},{"text":"Li va beni lakay Aaron an.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Li va beni sila ki krent SENYÈ yo,","poem":1},{"lineBreak":true},{"text":"piti kon gran.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ke SENYÈ a kab fè nou grandi plis,","poem":1},{"lineBreak":true},{"text":"nou menm ak pitit nou yo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ke nou ta vin beni pa SENYÈ a,","poem":1},{"lineBreak":true},{"text":"Kreyatè syèl la ak tè a.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Syèl yo se Syèl SENYÈ a,","poem":1},{"lineBreak":true},{"text":"Men latè, Li te bay li a fis a lòm yo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mò yo pa louwe SENYÈ a,","poem":1},{"lineBreak":true},{"text":"ni sila ki desann antre nan silans yo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Men nou va beni SENYÈ a,","poem":1},{"lineBreak":true},{"text":"soti nan moman sa a e rive jis pou tout tan.","poem":1},{"lineBreak":true},{"text":"Louwe SENYÈ la!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}