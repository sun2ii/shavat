{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":116,"content":[{"type":"verse","number":1,"content":[{"text":"Mwen renmen SENYÈ a, paske Li tande vwa m,","poem":1},{"lineBreak":true},{"text":"avèk siplikasyon mwen yo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Akoz Li te panche zòrèy Li bò kote m,","poem":1},{"lineBreak":true},{"text":"pou sa, mwen va rele non Li pandan tout tan ke m viv.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kòd lanmò yo te antoure m,","poem":1},{"lineBreak":true},{"text":"e laperèz fòs lanmò te vini sou mwen.","poem":1},{"lineBreak":true},{"text":"Mwen te jwenn twoub ak gwo tristès.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alò, mwen te rele non SENYÈ a.","poem":1},{"lineBreak":true},{"text":"O SENYÈ, mwen sipliye Ou, sove lavi mwen!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ranpli ak gras ak ladwati, se SENYÈ a.","poem":1},{"lineBreak":true},{"text":"Wi, Bondye nou an plen ak mizerikòd.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"SENYÈ a toujou pwoteje moun senp yo.","poem":1},{"lineBreak":true},{"text":"Mwen te abese mwen nèt e Li te sove mwen.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Reprann repo ou, O nanm mwen, paske","poem":1},{"lineBreak":true},{"text":"Bondye te aji nan bonte Li avèk ou.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Paske Ou te delivre nanm mwen devan lanmò,","poem":1},{"lineBreak":true},{"text":"zye m pou m pa kriye, pye m pou m pa glise tonbe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mwen va mache devan SENYÈ a nan","poem":1},{"lineBreak":true},{"text":"peyi moun vivan an.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mwen te kwè, pou sa mwen te di: “Mwen te vrèman aflije.”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mwen te di nan mitan gwo twoub mwen yo:","poem":1},{"lineBreak":true},{"text":"“Tout moun se mantè”.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kisa mwen kapab bay a SENYÈ a","poem":1},{"lineBreak":true},{"text":"Pou tout bonte Li anvè mwen?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mwen va leve wo koup sali a,","poem":1},{"lineBreak":true},{"text":"e rele non SENYÈ a.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mwen va peye tout ve mwen yo anvè SENYÈ a.","poem":1},{"lineBreak":true},{"text":"Wi, nan prezans tout pèp Li a!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Byen chè nan zye SENYÈ a, se lanmò a fidèl Li yo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"O SENYÈ, anverite, mwen se sèvitè Ou.","poem":1},{"lineBreak":true},{"text":"Mwen se sèvitè Ou, fis a sèvant Ou an.","poem":1},{"lineBreak":true},{"text":"Ou fin lache kòd mwen yo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"A Ou menm, mwen va ofri yon sakrifis remèsiman,","poem":1},{"lineBreak":true},{"text":"e va rele sou non SENYÈ a.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mwen va peye ve mwen yo a SENYÈ a.","poem":1},{"lineBreak":true},{"text":"Wi, kite l fèt nan prezans a tout pèp Li a!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nan lakou lakay SENYÈ a, nan mitan nou menm,","poem":1},{"lineBreak":true},{"text":"O Jérusalem, Louwe SENYÈ a!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}