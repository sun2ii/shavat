{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la; sou yon gita uit kòd"]},{"type":"hebrew_subtitle","content":["Yon sòm David."]},{"type":"verse","number":1,"content":[{"text":"Sekou, SENYÈ, paske moun ladwati yo sispann egziste,","poem":1},{"lineBreak":true},{"text":"Paske fidèl yo vin disparèt pami fis a lòm yo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yo pale sa ki fo a youn lòt.","poem":1},{"lineBreak":true},{"text":"Lèv flatè yo ak kè doub yo pale.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ke SENYÈ a vin koupe tout lèv flatè yo,","poem":1},{"lineBreak":true},{"text":"ak lang ki pale gwo bagay yo;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ki te di: “Avèk lang nou, nou va reyisi.","poem":1},{"lineBreak":true},{"text":"Lèv nou se pou nou.","poem":1},{"lineBreak":true},{"text":"Se kilès ki kab mèt sou nou?”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"“Akoz dega a aflije yo, akoz kri a malere yo,","poem":1},{"lineBreak":true},{"text":"koulye a, Mwen va leve”, pale SENYÈ a;","poem":1},{"lineBreak":true},{"text":"“Mwen va mete li ansekirite de sila ki maltrete l la.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pawòl a SENYÈ a se pawòl ki san tach;","poem":1},{"lineBreak":true},{"text":"tankou ajan ki teste nan founo,","poem":1},{"lineBreak":true},{"text":"rafine nan tè sèt fwa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ou menm, O SENYÈ, va pwoteje yo.","poem":1},{"lineBreak":true},{"text":"Ou va prezève yo soti nan","poem":1},{"lineBreak":true},{"text":"jenerasyon sila a jis pou tout tan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mechan yo pwomennen toupatou tout kote","poem":1},{"lineBreak":true},{"text":"lè bagay ki lèd vin leve wo","poem":1},{"lineBreak":true},{"text":"pami fis a lòm yo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}