{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"hebrew_subtitle","content":["Yon chanson pou monte vè tanp lan"]},{"type":"verse","number":1,"content":[{"text":"Nan gran twoub mwen an, mwen te kriye a SENYÈ a.","poem":1},{"lineBreak":true},{"text":"Li te reponn mwen.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Delivre nanm mwen, O SENYÈ, de lèv k ap bay desepsyon,","poem":1},{"lineBreak":true},{"text":"de lang ki plen manti yo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kisa pou W ta resevwa, e kisa pou m ta fè ou, O lang mansonjè?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Flèch pwent file a gèrye yo, avèk chabon pye gayak tou limen.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Malè a mwen, paske mwen demere nan tant a Méschec,","poem":1},{"lineBreak":true},{"text":"Paske mwen rete pami tant a Kédar yo!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nanm mwen gen demè li avèk sila ki","poem":1},{"lineBreak":true},{"text":"rayi lapè yo pandan twòp tan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mwen vle lapè, men lè m pale, se lagè yo pito.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}