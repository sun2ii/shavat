{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":121,"content":[{"type":"hebrew_subtitle","content":["Yon Sòm pou monte vè tanp lan"]},{"type":"verse","number":1,"content":[{"text":"Mwen leve zye m vè mòn yo.","poem":1},{"lineBreak":true},{"text":"Se kibò sekou mwen va sòti?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sekou m sòti nan SENYÈ a,","poem":1},{"lineBreak":true},{"text":"ki te fè syèl la ak tè a.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Li p ap kite pye ou chape.","poem":1},{"lineBreak":true},{"text":"Sila ki kenbe ou a p ap kabicha, ni dòmi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gade byen, Sila ki kenbe Israël p ap kabicha, ni Li p ap dòmi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"SENYÈ a se gadyen ou.","poem":1},{"lineBreak":true},{"text":"SENYÈ a se lonbraj a men dwat ou.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Solèy p ap frape ou lajounen,","poem":1},{"lineBreak":true},{"text":"ni lalin pandan lannwit.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"SENYÈ a va pwoteje ou de tout mal.","poem":1},{"lineBreak":true},{"text":"Li va kenbe nanm ou.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Li va pwoteje ou lè ou sòti ak lè ou antre,","poem":1},{"lineBreak":true},{"text":"depi nan moman sa a e jis rive pou tout tan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}