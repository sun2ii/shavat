pou lapè Jérusalem.","poem":1},{"lineBreak":true},{"text":"Sila ki renmen ou yo va pwospere.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ke lapè kapab anndan miray ou yo, e pwosperite nan palè ou yo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pou koz a frè m yo ak zanmi mwen yo, m ap di koulye a,","poem":1},{"lineBreak":true},{"text":"“Ke lapè anndan ou”.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pou koz a kay SENYÈ a, Bondye nou an, mwen va chache byen ou.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}