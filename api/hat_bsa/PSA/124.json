{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":124,"content":[{"type":"hebrew_subtitle","content":["Yon Sòm pou monte vè tanp lan. Yon Sòm David."]},{"type":"verse","number":1,"content":[{"text":"Si se pa t SENYÈ a ki te pou nou,","poem":1},{"lineBreak":true},{"text":"kite Israël di koulye a,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Si se pa t SENYÈ a ki te pou nou,","poem":1},{"lineBreak":true},{"text":"lè lezòm te leve kont nou yo,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Alò, yo t ap gen tan fin vale nou tou vivan,","poem":1},{"lineBreak":true},{"text":"lè kòlè yo te limen kont nou an.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nan lè sa a, dlo yo t ap fin anglouti nou nèt.","poem":1},{"lineBreak":true},{"text":"Kouran dlo yo ta fin pase sou nanm nou.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nan lè sa a, dlo anraje yo t ap fin pase sou nanm nou.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Beni se SENYÈ a, ki pa t livre nou pou chire nan dan yo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nanm nou gen tan fin chape tankou yon zwazo","poem":1},{"lineBreak":true},{"text":"ki sòti nan pèlen a moun k ap fè lachas yo.","poem":1},{"lineBreak":true},{"text":"Pèlen an fin kase e nou chape.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sekou nou se nan non SENYÈ a, ki te","poem":1},{"lineBreak":true},{"text":"fè syèl la ak tè a.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}