{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":125,"content":[{"type":"hebrew_subtitle","content":["Yon chan pou monte vè tanp lan."]},{"type":"verse","number":1,"content":[{"text":"Sila ki mete konfyans yo nan SENYÈ a tankou Mòn Sion,","poem":1},{"lineBreak":true},{"text":"ki pa kab deplase, men ki dire jis pou tout tan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kon mòn antoure Jérusalem yo,","poem":1},{"lineBreak":true},{"text":"se konsa SENYÈ a antoure pèp Li a","poem":1},{"lineBreak":true},{"text":"depi moman sa a, e jis rive pou tout tan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Paske baton wayal plen mechanste p ap poze sou peyi a moun ladwati yo,","poem":1},{"lineBreak":true},{"text":"jis pou moun dwat yo pa leve men yo pou fè mal.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fè byen, SENYÈ, a sila ki bon yo, ak sila ki dwat nan kè yo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Men pou sila ki vire akote pou chemen kwochi pa yo,","poem":1},{"lineBreak":true},{"text":"SENYÈ a va mennen yo sòti avèk","poem":1},{"lineBreak":true},{"text":"sila ki fè inikite yo.","poem":1},{"lineBreak":true},{"text":"Ke lapè rete sou Israël.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}