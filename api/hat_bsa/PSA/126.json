{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"hebrew_subtitle","content":["Yon chan pou monte vè tanp lan"]},{"type":"verse","number":1,"content":[{"text":"Lè SENYÈ a te fè mennen tounen kaptif Sion yo,","poem":1},{"lineBreak":true},{"text":"nou te tankou sila ki fè rèv yo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nan lè sa a, bouch nou te plen","poem":1},{"lineBreak":true},{"text":"ak ri lajwa e lang nou avèk kri lajwa.","poem":1},{"lineBreak":true},{"text":"Konsa, yo te di pami nasyon yo:","poem":1},{"lineBreak":true},{"text":"“SENYÈ a te fè gwo bagay pou yo.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"SENYÈ a te fè gwo bagay yo pou nou.","poem":1},{"lineBreak":true},{"text":"Nou kontan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fè retounen kaptif nou yo, O SENYÈ,","poem":1},{"lineBreak":true},{"text":"kon rivyè nan dezè a.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sila ki simen ak dlo nan zye yo","poem":1},{"lineBreak":true},{"text":"Va rekòlte avèk gwo kri lajwa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sila ki soti ap kriye akoz chàj makout semans lan.","poem":1},{"lineBreak":true},{"text":"Men l ap retounen ankò ak kri lajwa,","poem":1},{"lineBreak":true},{"text":"akoz chàj pakèt rekòlt l ap pote a.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}