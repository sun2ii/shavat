rue},{"text":"Se konsa pitit a jèn yo ye.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A la beni se nonm ke veso l plen ak yo.","poem":1},{"lineBreak":true},{"text":"Yo p ap wont lè yo pale ak lènmi yo nan pòtay la.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}