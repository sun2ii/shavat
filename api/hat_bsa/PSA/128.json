{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":128,"content":[{"type":"hebrew_subtitle","content":["Yon chan pou monte vè tanp lan."]},{"type":"verse","number":1,"content":[{"text":"A la beni se tout sila ki gen lakrent SENYÈ yo,","poem":1},{"lineBreak":true},{"text":"ki mache nan chemen Li yo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lè ou manje nan fwi a men ou yo,","poem":1},{"lineBreak":true},{"text":"ou va kontan e sa va ale byen pou ou.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Madanm ou ap tankou yon chan rezen","poem":1},{"lineBreak":true},{"text":"ki bay anpil rezen lakay ou.","poem":1},{"lineBreak":true},{"text":"Pitit ou yo va tankou plan bwa doliv ki antoure tab ou.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gade byen, paske se konsa nonm ki krent SENYÈ a va beni.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ke SENYÈ a beni ou depi nan Sion;","poem":1},{"lineBreak":true},{"text":"ke ou wè pwosperite Jérusalem nan pandan tout jou lavi ou yo!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wi, pou ou ka wè pitit a pitit ou yo!","poem":1},{"lineBreak":true},{"text":"Ke lapè rete sou Israël!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}