{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"hebrew_subtitle","content":["Yon chan pou monte vè tanp lan."]},{"type":"verse","number":1,"content":[{"text":"“Anpil fwa, yo te pèsekite mwen soti nan jenès mwen.","poem":1},{"lineBreak":true},{"text":"Kite Israël di koulye a:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“Anpil fwa, yo te pèsekite mwen soti nan jenès mwen,","poem":1},{"lineBreak":true},{"text":"men yo pa janm reyisi kont mwen.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Labourè yo te laboure chan yo sou do m.","poem":1},{"lineBreak":true},{"text":"Yo fè tranch tè yo vin pi long.”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"SENYÈ a dwat.","poem":1},{"lineBreak":true},{"text":"Kòd a mechan yo, Li te koupe yo fè bout.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ke tout sila ki rayi Sion yo vin wont!","poem":1},{"lineBreak":true},{"text":"Ke yo retounen fè bak menm.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kite yo vin tankou zèb sou kay la;","poem":1},{"lineBreak":true},{"text":"zèb ki fennen avan li grandi,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"jis moun rekòlt la p ap kapab plen men l,","poem":1},{"lineBreak":true},{"text":"oubyen sila ki mare pote pake a,","poem":1},{"lineBreak":true},{"text":"pa p ka plen lestomak li.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ni sila ki pase yo, p ap di:","poem":1},{"lineBreak":true},{"text":"“Ke benediksyon SENYÈ a rete avèk ou.","poem":1},{"lineBreak":true},{"text":"Nou beni ou nan non SENYÈ a.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}