{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la; yon sòm David"]},{"type":"verse","number":1,"content":[{"text":"Jiskilè SENYÈ?","poem":1},{"lineBreak":true},{"text":"Èske Ou ap bliye mwen jis pou tout tan?","poem":1},{"lineBreak":true},{"text":"Pou konbyen de tan, Ou va kache figi Ou de mwen?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pou konbyen de tan mwen va oblije","poem":1},{"lineBreak":true},{"text":"depann sou pwòp konsèy tèt mwen,","poem":1},{"lineBreak":true},{"text":"ak tristès nan kè m tout lajounen?","poem":1},{"lineBreak":true},{"text":"Jiskilè lènmi m va vin leve wo sou mwen?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Okipe m, e reponn mwen, O SENYÈ, Bondye mwen;","poem":1},{"lineBreak":true},{"text":"Fè zye m wè, pou m pa mouri;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"pou lènmi mwen an pa di: “Mwen fin genyen l,”","poem":1},{"lineBreak":true},{"text":"epi advèsè mwen yo rejwi lè m pran chòk.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Men mwen va mete konfyans mwen nan lanmou dous Ou a;","poem":1},{"lineBreak":true},{"text":"Kè m va rejwi nan delivrans ou","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mwen va chante a SENYÈ a,","poem":1},{"lineBreak":true},{"text":"paske Li te aji ak bon kè avè m.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}