{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["Yon chan pou monte vè tanp lan."]},{"type":"verse","number":1,"content":[{"text":"Soti nan pwofondè abim nan, mwen te kriye a Ou menm, O SENYÈ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"SENYÈ, koute vwa mwen!","poem":1},{"lineBreak":true},{"text":"Kite zòrèy Ou rete atantif a vwa siplikasyon mwen yo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Si Ou menm, SENYÈ, ta sonje inikite yo,","poem":1},{"lineBreak":true},{"text":"O SENYÈ, se kilès ki ta kab kanpe?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Men avèk Ou menm, gen padon,","poem":1},{"lineBreak":true},{"text":"pou moun ta gen reverans Ou.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mwen tann SENYÈ a.","poem":1},{"lineBreak":true},{"text":"Nanm mwen ap tann e nan pawòl Li,","poem":1},{"lineBreak":true},{"text":"mwen mete espwa m.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nanm mwen ap tann SENYÈ a plis","poem":1},{"lineBreak":true},{"text":"pase gadyen k ap tann maten rive a.","poem":1},{"lineBreak":true},{"text":"Anverite, plis pase gadyen k ap tann maten rive a.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"O Israël, mete espwa nan SENYÈ a.","poem":1},{"lineBreak":true},{"text":"Paske kote SENYÈ a ye, gen mizerikòd.","poem":1},{"lineBreak":true},{"text":"Avèk Li, gen redanmsyon an abondans.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Li va fè redanmsyon Israël de tout inikite Li yo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}