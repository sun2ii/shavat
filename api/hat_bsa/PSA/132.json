{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":132,"content":[{"type":"hebrew_subtitle","content":["Yon chan pou monte vè tanp lan."]},{"type":"verse","number":1,"content":[{"text":"Sonje, SENYÈ, pou koz David, ak tout soufrans li an,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"jan li te sèmante a SENYÈ a,","poem":1},{"lineBreak":true},{"text":"e te fè ve a Toupwisan a Jacob la:","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Anverite, mwen p ap antre lakay mwen,","poem":1},{"lineBreak":true},{"text":"ni kouche sou kabann mwen;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"mwen p ap kite zye m dòmi,","poem":1},{"lineBreak":true},{"text":"ni pòpyè zye m fèmen,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"jiskaske m jwenn yon kote pou SENYÈ a,","poem":1},{"lineBreak":true},{"text":"yon abitasyon pou Toupwisan a Jacob la.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Men koute, nou te tande koze sa a nan Éphrata,","poem":1},{"lineBreak":true},{"text":"nou te twouve l nan plèn Jaar a.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Annou antre nan abitasyon Li a.","poem":1},{"lineBreak":true},{"text":"Annou fè adorasyon kote machpye twòn Li an ye a.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Leve, O SENYÈ, vini nan plas repo Ou a,","poem":1},{"lineBreak":true},{"text":"Ou menm avèk lach fòs Ou.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kite prèt Ou yo abiye nan ladwati, e","poem":1},{"lineBreak":true},{"text":"kite fidèl Ou yo chante ak lajwa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pou koz David, sèvitè Ou a, pa vire fas kont onksyone Ou a.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"SENYÈ a te sèmante a David anverite.","poem":1},{"lineBreak":true},{"text":"Sou sila Li p ap fè bak:","poem":1},{"lineBreak":true},{"text":"“Nan fwi a kò Ou, mwen va etabli sou twòn Ou.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Si fis ou yo kenbe akò Mwen ak","poem":1},{"lineBreak":true},{"text":"temwayaj ke Mwen va enstwi yo,","poem":1},{"lineBreak":true},{"text":"fis pa yo tou va chita sou twòn Ou an jis pou tout tan.”","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Paske SENYÈ a te chwazi Sion.","poem":1},{"lineBreak":true},{"text":"Li te vle l pou abitasyon Li.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"“Sa se plas repo Mwen, jis pou tout tan.","poem":1},{"lineBreak":true},{"text":"Isit la Mwen va rete, paske Mwen te vle sa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mwen va beni pwovizyon li ak abondans.","poem":1},{"lineBreak":true},{"text":"Mwen va satisfè malere li yo ak pen.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Anplis, Mwen va abiye prèt li yo ak Sali,","poem":1},{"lineBreak":true},{"text":"e fidèl li yo va chante byen fò ak lajwa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"La Mwen va koze kòn a David la boujonnen pou l parèt.","poem":1},{"lineBreak":true},{"text":"Mwen te prepare yon lanp pou onksyone pa M nan.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Lènmi li yo, Mwen va abiye yo ak wont.","poem":1},{"lineBreak":true},{"text":"Men sou li menm, kouwòn li an va briye.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}