{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"Bò rivyè a Babylone yo, se la nou te chita.","poem":1},{"lineBreak":true},{"text":"Nou te kriye, lè nou te sonje Sion.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sou pye sikrèn nan mitan li an, nou te pandye ap nou yo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Paske la, ravisè nou yo te mande nou chante pou yo,","poem":1},{"lineBreak":true},{"text":"e bouwo nou yo ak gwo kè kontan, t ap di:","poem":1},{"lineBreak":true},{"text":"“Chante pou nou youn nan chanson Sion yo.”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kijan pou nou ta chante chan SENYÈ a nan yon peyi etranje?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Si mwen ta bliye ou, O Jérusalem, kite men","poem":1},{"lineBreak":true},{"text":"dwat mwen bliye kapasite li.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ke lang mwen kole rèd anlè bouch mwen,","poem":1},{"lineBreak":true},{"text":"Si m pa ta sonje ou, si m pa ta leve Jérusalem wo,","poem":1},{"lineBreak":true},{"text":"pi wo ke pi gwo plezi m yo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sonje, O SENYÈ, kont fis a Édom yo, jou a Jérusalem nan,","poem":1},{"lineBreak":true},{"text":"ke yo te di: “Raze l nèt!","poem":1},{"lineBreak":true},{"text":"Raze l jis rive nan fondasyon li.”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O fi a Babylone nan, Ou menm ki te devaste nou an,","poem":1},{"lineBreak":true},{"text":"A la beni sila ki rekonpanse ou ak menm","poem":1},{"lineBreak":true},{"text":"rekonpans ke ou te rekonpanse nou an va beni!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A la beni sila ki sezi pitit ou yo,","poem":1},{"lineBreak":true},{"text":"e ki kraze yo nan wòch la va beni!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}