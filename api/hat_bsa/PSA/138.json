{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":138,"content":[{"type":"hebrew_subtitle","content":["Yon Sòm David"]},{"type":"verse","number":1,"content":[{"text":"Mwen va bay Ou remèsiman avèk tout kè m.","poem":1},{"lineBreak":true},{"text":"Mwen va chante lwanj a Ou devan lòt dye yo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mwen va pwostène mwen vè sen tanp Ou a,","poem":1},{"lineBreak":true},{"text":"e bay remèsiman a non Ou pou lanmou dous Ou ak verite Ou a;","poem":1},{"lineBreak":true},{"text":"Paske Ou te bay glwa a Non ak Pawòl Ou plis ke tout bagay.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nan jou ke m te rele Ou a, Ou te reponn mwen.","poem":1},{"lineBreak":true},{"text":"Ou te fè m plen ak kouraj ak fòs nan nanm mwen.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tout wa sou latè yo va ba Ou remèsiman, O SENYÈ,","poem":1},{"lineBreak":true},{"text":"lè yo fin tande pawòl a bouch Ou.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wi, yo va chante sou chemen SENYÈ a,","poem":1},{"lineBreak":true},{"text":"paske gran se glwa SENYÈ a.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Paske malgre SENYÈ a egzalte,","poem":1},{"lineBreak":true},{"text":"Li toujou okipe sila ki ba yo.","poem":1},{"lineBreak":true},{"text":"Men moun ki ògeye yo,","poem":1},{"lineBreak":true},{"text":"Li rekonèt yo de lwen.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Malgre mwen mache nan mitan gwo twoub,","poem":1},{"lineBreak":true},{"text":"Ou va fè m reprann mwen.","poem":1},{"lineBreak":true},{"text":"Ou va lonje fè parèt men Ou kont kòlè ènmi m yo.","poem":1},{"lineBreak":true},{"text":"Men dwat Ou va sove mwen.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"SENYÈ a va akonpli sa ki konsène mwen an.","poem":1},{"lineBreak":true},{"text":"Lanmou dous Ou a, O SENYÈ, se pou tout tan.","poem":1},{"lineBreak":true},{"text":"Pa abandone zèv men Ou yo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}