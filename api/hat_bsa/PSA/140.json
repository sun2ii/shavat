{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":140,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la; Yon Sòm David"]},{"type":"verse","number":1,"content":[{"text":"Delivre m, O SENYÈ, de moun mechan yo.","poem":1},{"lineBreak":true},{"text":"Delivre m de moun vyolan yo:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ka p fè manèv mechan nan kè yo.","poem":1},{"lineBreak":true},{"text":"Tout tan, y ap fè pwovokasyon pou fè lagè.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yo file lang yo tankou koulèv.","poem":1},{"lineBreak":true},{"text":"Pwazon a sèpan mòtèl la anba lèv yo. Tan","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kenbe m, O SENYÈ, de men moun mechan yo.","poem":1},{"lineBreak":true},{"text":"Pwoteje m de moun vyolan ki te fè plan pou pye m yo ta tonbe yo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ògeye yo fin ranje yon pèlen pou mwen.","poem":1},{"lineBreak":true},{"text":"Avèk kòd, yo te ouvri yon pèlen bò wout la.","poem":1},{"lineBreak":true},{"text":"Yo fin plase yon pyèj pou mwen. Tan","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mwen te di a SENYÈ a: “Se Ou ki Bondye mwen.”","poem":1},{"lineBreak":true},{"text":"Bay zòrèy, O SENYÈ, a vwa a siplikasyon mwen yo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"O BONDYE Senyè a, fòs a sali mwen an,","poem":1},{"lineBreak":true},{"text":"Ou te kouvri tèt mwen nan jou batay la.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pa akonpli, O SENYÈ, dezi a mechan an.","poem":1},{"lineBreak":true},{"text":"Pa pèmèt manèv mechan li yo, pou l pa vin leve wo. Tan","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Epi pou chèf an tèt a sila ki antoure mwen yo,","poem":1},{"lineBreak":true},{"text":"pou malveyans a pwòp lèv yo kapab vin kouvri yo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kite chabon tou limen vin tonbe sou yo.","poem":1},{"lineBreak":true},{"text":"Kite yo jete nan dife,","poem":1},{"lineBreak":true},{"text":"nan fòs fon kote yo p ap kab leve sòti.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sila ki bay kout lang yo pap vin etabli sou latè.","poem":1},{"lineBreak":true},{"text":"Mal la va kouri vit dèyè moun vyolans lan.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mwen konnen ke SENYÈ a va bay soutyen a aflije yo,","poem":1},{"lineBreak":true},{"text":"e fè jistis pou malere a.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Anverite, moun dwat yo va bay remèsiman a non Ou.","poem":1},{"lineBreak":true},{"text":"Epi moun dwat yo va abite nan prezans Ou.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}