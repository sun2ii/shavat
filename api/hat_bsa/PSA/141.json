{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":141,"content":[{"type":"hebrew_subtitle","content":["Yon Sòm David"]},{"type":"verse","number":1,"content":[{"text":"O SENYÈ, mwen rele non Ou.","poem":1},{"lineBreak":true},{"text":"Fè vit! Vin kote m!","poem":1},{"lineBreak":true},{"text":"Prete zòrèy Ou a vwa mwen lè m rele Ou!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ke lapriyè mwen kapab konte kon lansan devan Ou;","poem":1},{"lineBreak":true},{"text":"lè m leve men m, kon sakrifis ofrann aswè a.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Plase yon gadyen sou bouch mwen, O SENYÈ.","poem":1},{"lineBreak":true},{"text":"Veye dri sou pòt lèv mwen yo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pa mennen kè m vè okenn mal,","poem":1},{"lineBreak":true},{"text":"pou pratike zèv mechan yo, avèk moun ki fè inikite yo.","poem":1},{"lineBreak":true},{"text":"Ni pa kite mwen manje manje ki fèt pa yo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kite moun ladwati yo frape mwen.","poem":1},{"lineBreak":true},{"text":"Konsa, li dous.","poem":1},{"lineBreak":true},{"text":"Kite li korije mwen.","poem":1},{"lineBreak":true},{"text":"L ap tankou lwil ki koule sou tèt la.","poem":1},{"lineBreak":true},{"text":"Pa kite tèt mwen refize li,","poem":1},{"lineBreak":true},{"text":"paske lapriyè mwen toujou kont zak mechan yo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Jij pa yo fin jete a tè bò kote wòch yo.","poem":1},{"lineBreak":true},{"text":"Yo va tande pawòl mwen yo, paske yo byen pale.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tankou lè yon moun laboure pou fann tè a,","poem":1},{"lineBreak":true},{"text":"se konsa zo nou yo fin gaye nan bouch sejou mò a.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Paske zye mwen se sou Ou, O BONDYE, Senyè a.","poem":1},{"lineBreak":true},{"text":"Nan Ou, mwen kache.","poem":1},{"lineBreak":true},{"text":"Pa kite nanm mwen san pwotèj.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sove m de dan pyèj ke yo te prepare pou mwen yo,","poem":1},{"lineBreak":true},{"text":"avèk pèlen a sila ki fè inikite yo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kite mechan yo tonbe nan pwòp filè yo,","poem":1},{"lineBreak":true},{"text":"pandan mwen pase akote.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}