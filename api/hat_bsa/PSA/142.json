{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["Yon Sòm Refleksyon pa David lè l te nan kav la. Yon lapriyè"]},{"type":"verse","number":1,"content":[{"text":"Mwen kriye fò avèk vwa mwen vè SENYÈ a.","poem":1},{"lineBreak":true},{"text":"Ak vwa m, mwen fè siplikasyon a SENYÈ a pou m mande L mizerikòd.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mwen vide plent mwen yo devan L.","poem":1},{"lineBreak":true},{"text":"Mwen deklare pwoblèm mwen yo devan L.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lè lespri m te fin bat anndan m,","poem":1},{"lineBreak":true},{"text":"Ou te konnen chemen mwen.","poem":1},{"lineBreak":true},{"text":"Nan wout kote m mache a, yo te sere yon pyèj pou mwen.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gade adwat pou wè. Nanpwen moun ki veye pou mwen.","poem":1},{"lineBreak":true},{"text":"Nanpwen moun ki pou fè m chape.","poem":1},{"lineBreak":true},{"text":"Nanpwen moun ki pou pran swen m.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mwen te kriye a Ou menm, O SENYÈ.","poem":1},{"lineBreak":true},{"text":"Mwen te di “Se Ou menm ki sekou mwen,","poem":1},{"lineBreak":true},{"text":"pòsyon mwen nan peyi moun vivan yo.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"“Prete atansyon a kri mwen yo, paske mwen vin desann ba nèt.","poem":1},{"lineBreak":true},{"text":"Delivre mwen nan men pèsekitè mwen yo,","poem":1},{"lineBreak":true},{"text":"paske yo twò fò pou mwen.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mennen nanm mwen sòti nan prizon,","poem":1},{"lineBreak":true},{"text":"pou m kab bay remèsiman a non Ou.","poem":1},{"lineBreak":true},{"text":"Moun ladwati mwen yo va antoure mwen,","poem":1},{"lineBreak":true},{"text":"paske Ou va aji nan bonte Ou anvè mwen.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}