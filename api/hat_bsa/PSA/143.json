{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":143,"content":[{"type":"hebrew_subtitle","content":["Yon Sòm David"]},{"type":"verse","number":1,"content":[{"text":"Tande lapriyè mwen, O SENYÈ.","poem":1},{"lineBreak":true},{"text":"Prete zòrèy Ou a siplikasyon mwen yo.","poem":1},{"lineBreak":true},{"text":"Nan fidelite Ou, reponn mwen, ak ladwati Ou!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Konsa, pa antre nan jijman avèk sèvitè Ou a,","poem":1},{"lineBreak":true},{"text":"paske nan zye Ou, nanpwen moun vivan ki jis.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Paske lènmi an te pèsekite nanm mwen.","poem":1},{"lineBreak":true},{"text":"Li fin kraze lavi m jis rive atè.","poem":1},{"lineBreak":true},{"text":"Li te fè m rete kote fènwa, tankou sila ki mouri lontan yo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pou sa, lespri m kraze nèt anndan m.","poem":1},{"lineBreak":true},{"text":"Kè m nan gwo twoub anndan m.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mwen sonje ansyen jou yo.","poem":1},{"lineBreak":true},{"text":"Mwen reflechi tout tan sou tout sa Ou te fè.","poem":1},{"lineBreak":true},{"text":"Mwen panse sou zèv men Ou yo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mwen lonje men m vè Ou menm.","poem":1},{"lineBreak":true},{"text":"Nanm mwen fè gwo anvi pou Ou, kon yon peyi deseche.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Reponn mwen vit, O SENYÈ, lespri m vin febli;","poem":1},{"lineBreak":true},{"text":"Pa kache figi Ou sou mwen, oswa mwen va vini kon sila ki desann nan fòs yo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kite mwen tande lanmou dous Ou a nan granmmaten,","poem":1},{"lineBreak":true},{"text":"paske mwen mete konfyans mwen nan Ou.","poem":1},{"lineBreak":true},{"text":"Enstwi mwen nan chemen ke m ta dwe mache a,","poem":1},{"lineBreak":true},{"text":"paske se a Ou ke mwen leve nanm mwen.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Delivre mwen, O SENYÈ, de lènmi mwen yo.","poem":1},{"lineBreak":true},{"text":"Mwen kache nan Ou.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Enstwi mwen pou fè volonte Ou,","poem":1},{"lineBreak":true},{"text":"paske se Ou menm ki Bondye mwen.","poem":1},{"lineBreak":true},{"text":"Lespri Ou bon.","poem":1},{"lineBreak":true},{"text":"Kondwi mwen sou tèren ladwati a.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Pou koz a non Ou, O SENYÈ, fè m reprann fòs mwen.","poem":1},{"lineBreak":true},{"text":"Nan ladwati Ou, mennen nanm mwen sòti nan gwo twoub la.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Epi nan lanmou dous Ou a, fè lennmi m yo koupe retire nèt.","poem":1},{"lineBreak":true},{"text":"Detwi tout sila ki aflije nanm mwen yo,","poem":1},{"lineBreak":true},{"text":"paske mwen se sèvitè Ou.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}