{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":145,"content":[{"type":"hebrew_subtitle","content":["Yon chan lwanj pa David"]},{"type":"verse","number":1,"content":[{"text":"Mwen va leve Ou wo,","poem":1},{"lineBreak":true},{"text":"O Bondye mwen, O Wa a.","poem":1},{"lineBreak":true},{"text":"Mwen va beni non Ou pou tout tan e pou tout tan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chak jou, mwen va beni Ou e mwen","poem":1},{"lineBreak":true},{"text":"va louwe non Ou pou tout tan e pou tout tan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gran se SENYÈ a, dign de lwanj.","poem":1},{"lineBreak":true},{"text":"Grandè Li pa kab fin sonde menm.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yon jenerasyon va louwe zèv Ou yo jis rive nan yon lòt.","poem":1},{"lineBreak":true},{"text":"Yo va pwoklame zèv pwisan Ou yo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sou bèlte e glwa a majeste Ou","poem":1},{"lineBreak":true},{"text":"avèk zèv mèvèy Ou yo,","poem":1},{"lineBreak":true},{"text":"mwen va reflechi tout tan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lezòm va pale sou pouvwa a zèv mèvèy Ou yo","poem":1},{"lineBreak":true},{"text":"e mwen va pale jan Ou gran.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yo va pouse pale ak enpasyans sou memwa a bonte Ou.","poem":1},{"lineBreak":true},{"text":"Yo va rele fò ak lajwa de ladwati Ou.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"SENYÈ a plen gras avèk mizerikòd,","poem":1},{"lineBreak":true},{"text":"lan nan kòlè e gran nan lanmou dous Li a.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"SENYÈ a bon pou tout moun e gras Li","poem":1},{"lineBreak":true},{"text":"lonje rive sou tout zèv Li yo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tout zèv Ou yo va di Ou:","poem":1},{"lineBreak":true},{"text":"“Mèsi O SENYÈ,”","poem":1},{"lineBreak":true},{"text":"e fidèl Ou yo va beni Ou.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yo va pale glwa a wayòm Ou an, e","poem":1},{"lineBreak":true},{"text":"pale sou zafè pouvwa Ou yo;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Pou fè rekonèt a fis a lòm yo,","poem":1},{"lineBreak":true},{"text":"zèv pwisan Ou yo avèk glwa ak","poem":1},{"lineBreak":true},{"text":"majeste a wayòm Ou an.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wayòm Ou an se yon wayòm etènèl","poem":1},{"lineBreak":true},{"text":"e règn Ou an dire pou tout jenerasyon yo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"SENYÈ a bay soutyen a tout moun ki tonbe.","poem":1},{"lineBreak":true},{"text":"Li leve wo tout sila ki vin pwostène yo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Zye a tout moun genyen espwa sou Ou.","poem":1},{"lineBreak":true},{"text":"Ou bay yo manje yo nan lè yo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ou ouvri men Ou pou satisfè dezi","poem":1},{"lineBreak":true},{"text":"a tout sila k ap viv yo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Senyè a dwat nan tout chemen Li yo, e","poem":1},{"lineBreak":true},{"text":"ranpli ak bonte nan tout zèv Li yo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"SENYÈ a toupre tout sila ki rele Li yo,","poem":1},{"lineBreak":true},{"text":"tout sila ki rele li ak verite yo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Li va ranpli dezi a sila ki gen lakrent Li yo.","poem":1},{"lineBreak":true},{"text":"Anplis Li va tande kri yo e Li va sove yo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"SENYÈ a kenbe tout sila ki renmen Li yo,","poem":1},{"lineBreak":true},{"text":"men mechan yo, Li va detwi","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Bouch mwen va pale lwanj SENYÈ a,","poem":1},{"lineBreak":true},{"text":"e tout chè va beni sen non Li an jis pou","poem":1},{"lineBreak":true},{"text":"tout tan e pou tout tan.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}