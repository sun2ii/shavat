{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"Beni SENYÈ a!","poem":1},{"lineBreak":true},{"text":"Beni SENYÈ a, O nanm mwen!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mwen va beni SENYÈ a pandan mwen ap viv.","poem":1},{"lineBreak":true},{"text":"Mwen va chante lwanj a Bondye pa mwen an","poem":1},{"lineBreak":true},{"text":"pandan mwen sou latè a.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pa mete konfyans nan prens yo.","poem":1},{"lineBreak":true},{"text":"Nan lòm mòtèl, nan sila nanpwen Sali a.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lespri li pa rete; li retounen nan tè a.","poem":1},{"lineBreak":true},{"text":"Nan menm jou sa a, panse li yo vin peri.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A la beni sila ki gen sekou nan Bondye Jacob la beni,","poem":1},{"lineBreak":true},{"text":"sila ki mete espwa li nan SENYÈ a, Bondye li a,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ki te fè syèl la avèk tè a,","poem":1},{"lineBreak":true},{"text":"lanmè ak tout sa ki ladann.","poem":1},{"lineBreak":true},{"text":"Ki fidèl jis pou tout tan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ki egzekite jistis pou oprime yo.","poem":1},{"lineBreak":true},{"text":"Ki bay manje a moun grangou yo.","poem":1},{"lineBreak":true},{"text":"SENYÈ a mete prizonye yo an libète.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"SENYÈ a ouvri zye a avèg yo.","poem":1},{"lineBreak":true},{"text":"SENYÈ a leve sila ki vin pwostène yo.","poem":1},{"lineBreak":true},{"text":"SENYÈ a renmen moun ladwati yo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"SENYÈ a pwoteje etranje yo.","poem":1},{"lineBreak":true},{"text":"Li bay soutyen a òfelen an ak vèv la,","poem":1},{"lineBreak":true},{"text":"men Li jennen wout mechan an.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"SENYÈ a va renye jis pou tout tan,","poem":1},{"lineBreak":true},{"text":"Bondye pa Ou a, O Sion, jis pou tout jenerasyon yo.","poem":1},{"lineBreak":true},{"text":"Louwe SENYÈ a!","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}