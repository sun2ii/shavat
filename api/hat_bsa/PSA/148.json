{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"Louwe SENYÈ a!","poem":1},{"lineBreak":true},{"text":"Louwe SENYÈ a soti nan syèl yo!","poem":1},{"lineBreak":true},{"text":"Louwe Li kote ki wo yo!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Louwe Li, tout zanj Li yo.","poem":1},{"lineBreak":true},{"text":"Louwe Li tout lame Li yo!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Louwe Li, solèy ak lalin nan.","poem":1},{"lineBreak":true},{"text":"Louwe Li, tout zetwal ki limen yo!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Louwe Li, pi wo syèl yo,","poem":1},{"lineBreak":true},{"text":"ak dlo ki anwo syèl yo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kite yo louwe non SENYÈ a,","poem":1},{"lineBreak":true},{"text":"paske Li te pase lòd, e sa te fèt.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Anplis, Li te etabli yo jis pou tout tan.","poem":1},{"lineBreak":true},{"text":"Li te pase yon dekrè ki p ap janm disparèt.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Louwe SENYÈ a soti sou latè,","poem":1},{"lineBreak":true},{"text":"gwo bèt voras lanmè a ak tout fon an.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dife ak lagrèl, lanèj ak nwaj,","poem":1},{"lineBreak":true},{"text":"van tanpèt ki akonpli pawòl Li yo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mòn yo ak tout kolin yo,","poem":1},{"lineBreak":true},{"text":"pye fwi yo ak tout pye sèd yo,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bèt sovaj yo ak tout bèt chan yo,","poem":1},{"lineBreak":true},{"text":"sa ki trennen atè ak bèt ki vole yo,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"wa latè yo ak tout pèp yo,","poem":1},{"lineBreak":true},{"text":"prens yo ak tout jij latè yo,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ni jennonm, ni vyèj,","poem":1},{"lineBreak":true},{"text":"granmoun ak timoun.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kite yo louwe non SENYÈ a,","poem":1},{"lineBreak":true},{"text":"paske se sèl non Li ki leve wo.","poem":1},{"lineBreak":true},{"text":"Glwa Li pi wo tè a ak syèl la.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Li te leve yon kòn pou pèp Li a,","poem":1},{"lineBreak":true},{"text":"Lwanj pou tout fidèl Li yo,","poem":1},{"lineBreak":true},{"text":"menm pou fis Israël yo, yon pèp toupre Li.","poem":1},{"lineBreak":true},{"text":"Louwe SENYÈ a.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}