ak":true},{"text":"e li pa chanje menm;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Li pa vèse bay lajan li avèk enterè,","poem":1},{"lineBreak":true},{"text":"ni li pa aksepte yon kado anba tab kont inosan an.","poem":1},{"lineBreak":true},{"text":"Sila ki fè bagay sa yo p ap janm ebranle.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}