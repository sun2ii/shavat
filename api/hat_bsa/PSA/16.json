{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":16,"content":[{"type":"hebrew_subtitle","content":["Yon Sòm David"]},{"type":"verse","number":1,"content":[{"text":"Pwoteje m O Bondye, paske mwen kache nan Ou.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mwen te di a SENYÈ, Ou se Senyè mwen.","poem":1},{"lineBreak":true},{"text":"Mwen pa gen anyen ki bon sof ke Ou menm.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Selon sen sou latè yo, se moun manyifik yo ye;","poem":1},{"lineBreak":true},{"text":"sou yo menm mwen pran tout plezi m yo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Doulè a sila ki te fè donn a yon lòt dye va vin ogmante;","poem":1},{"lineBreak":true},{"text":"Mwen p ap vin vide ofrann bwason san pa yo,","poem":1},{"lineBreak":true},{"text":"ni non yo p ap sòti sou lèv mwen.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"SENYÈ a se pòsyon eritaj mwen ak tas mwen;","poem":1},{"lineBreak":true},{"text":"Se Ou menm ki bay soutyen a pati pa m nan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lizyè yo vin tonbe nan kote ki tèlman bèl pou mwen.","poem":1},{"lineBreak":true},{"text":"Anverite, eritaj mwen bèl pou mwen.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mwen va beni SENYÈ a ki te ban m konsèy la.","poem":1},{"lineBreak":true},{"text":"Anverite, panse mwen toujou vin enstwi mwen pandan lannwit.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mwen te mete SENYÈ a devan zye m tout tan.","poem":1},{"lineBreak":true},{"text":"Akoz Li se men dwat mwen, mwen p ap ebranle menm.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pou sa, kè m kontan e glwa mwen fè rejwisans.","poem":1},{"lineBreak":true},{"text":"Anplis, chè m va toujou pwoteje.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Paske Ou p ap abandone nanm mwen","poem":1},{"lineBreak":true},{"text":"nan sejou mò yo;","poem":1},{"lineBreak":true},{"text":"ni Ou p ap pèmèt Sila Ki Sen Ou an vin tonbe an pouriti.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ou va fè m rekonèt chemen lavi a.","poem":1},{"lineBreak":true},{"text":"Nan prezans Ou, se lajwa ki an abondans nèt.","poem":1},{"lineBreak":true},{"text":"Nan men dwat Ou, se plezi ki dire jis pou tout tan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}