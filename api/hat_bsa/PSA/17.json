{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":17,"content":[{"type":"hebrew_subtitle","content":["Yon Priyè a David"]},{"type":"verse","number":1,"content":[{"text":"Koute yon koz ki jis, O SENYÈ e okipe kri mwen.","poem":1},{"lineBreak":true},{"text":"Prete zòrèy a lapriyè mwen,","poem":1},{"lineBreak":true},{"text":"ki pa sòti nan lèv k ap twonpe moun.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kite pawòl mwen parèt akoz prezans Ou;","poem":1},{"lineBreak":true},{"text":"Kite zye Ou gade avèk jistis.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ou te teste kè m.","poem":1},{"lineBreak":true},{"text":"Ou te vizite mwen pandan lannwit.","poem":1},{"lineBreak":true},{"text":"Ou te sonde mwen e Ou pa t jwenn anyen.","poem":1},{"lineBreak":true},{"text":"Mwen te fè desizyon eksprè pou bouch mwen pa fè tò.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alò, pou zèv a lòm yo, selon pawòl a lèv Ou yo,","poem":1},{"lineBreak":true},{"text":"Mwen te evite chemen a vyolan yo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pye mwen yo te kenbe fèm nan chemen pa W la.","poem":1},{"lineBreak":true},{"text":"Pye mwen pat janm glise.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mwen te rele Ou, paske Ou va reponn mwen, O Bondye.","poem":1},{"lineBreak":true},{"text":"Enkline zòrèy W bò kote m.","poem":1},{"lineBreak":true},{"text":"Tande pawòl mwen yo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kon mèvèy Ou yo, montre m lanmou dous Ou a,","poem":1},{"lineBreak":true},{"text":"O Sovè a sila ki kache nan men dwat Ou yo, kont sila ki leve kont yo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kenbe m tankou de zye nan tèt Ou.","poem":1},{"lineBreak":true},{"text":"Kache mwen anba lonbraj a zèl Ou,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"kont mechan ki depouye m yo,","poem":1},{"lineBreak":true},{"text":"lènmi mòtèl mwen yo ki antoure m.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yo fin fèmen kè rèd yo.","poem":1},{"lineBreak":true},{"text":"Avèk bouch yo, yo pale awogans.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Koulye a, yo fin antoure nou pandan n ap mache.","poem":1},{"lineBreak":true},{"text":"Yo fikse zye yo sou nou pou jete nou atè.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Se tankou yon lyon ki anvi devore,","poem":1},{"lineBreak":true},{"text":"tankou yon jenn lyon k ap kache","poem":1},{"lineBreak":true},{"text":"nan fènwa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Leve, O SENYÈ, konfwonte li e bese li;","poem":1},{"lineBreak":true},{"text":"Delivre nanm mwen de mechan yo avèk nepe Ou,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Depi nan men mesye yo avèk men Ou, O SENYÈ,","poem":1},{"lineBreak":true},{"text":"depi nan men lòm de mond sa yo,","poem":1},{"lineBreak":true},{"text":"k ap resevwa pòsyon pa yo nan vi sa a.","poem":1},{"lineBreak":true},{"text":"Men Ou menm plen vant a sila Ou renmen yo.","poem":1},{"lineBreak":true},{"text":"Fis ou yo gen kont,","poem":1},{"lineBreak":true},{"text":"e yo mete an rezèv pou pitit pa yo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Pou mwen menm, mwen va wè figi Ou nan ladwati a;","poem":1},{"lineBreak":true},{"text":"mwen va satisfè avèk vizaj Ou","poem":1},{"lineBreak":true},{"text":"lè m ouvri zye m.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}