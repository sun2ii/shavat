{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":19,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la; yon sòm David"]},{"type":"verse","number":1,"content":[{"text":"Syèl yo ap pale glwa Bondye a.","poem":1},{"lineBreak":true},{"text":"Jan yo tèlman gran deklare zèv men Li yo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Jou apre jou, l ap pale san rete;","poem":1},{"lineBreak":true},{"text":"Nwit apre nwit, li revele konesans.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nanpwen langaj, ni pa gen pawòl","poem":1},{"lineBreak":true},{"text":"kote nou pa tande vwa yo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sepandan, eko yo retanti sou tout latè,","poem":1},{"lineBreak":true},{"text":"ak sa yo pale jis nan ekstremite latè a.","poem":1},{"lineBreak":true},{"text":"Nan mitan yo, Li te plase yon tant pou solèy la,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ki tankou yon jennonm ki fenk marye","poem":1},{"lineBreak":true},{"text":"k ap sòti nan chanm li.","poem":1},{"lineBreak":true},{"text":"Li rejwi kon yon nonm fò k ap fè kous.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Li leve soti nan yon pwent syèl,","poem":1},{"lineBreak":true},{"text":"pou fè wonn li rive jis nan lòt pwent lan.","poem":1},{"lineBreak":true},{"text":"Anyen pa chape devan chalè li.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lalwa SENYÈ a pafè","poem":1},{"lineBreak":true},{"text":"Li rekonfòte nanm.","poem":1},{"lineBreak":true},{"text":"Temwayaj SENYÈ a vrè,","poem":1},{"lineBreak":true},{"text":"k ap fè saj yo senp.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Prensip a SENYÈ yo dwat,","poem":1},{"lineBreak":true},{"text":"ki fè kè rejwi.","poem":1},{"lineBreak":true},{"text":"Kòmandman SENYÈ a san tach.","poem":1},{"lineBreak":true},{"text":"Li fè zye yo limen.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lakrent SENYÈ a pi;","poem":1},{"lineBreak":true},{"text":"Li dire jis pou tout tan.","poem":1},{"lineBreak":true},{"text":"Jijman yo SENYÈ a vrè;","poem":1},{"lineBreak":true},{"text":"Yo jis san manke.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yo pi chè pase lò, wi, pase anpil lò fen.","poem":1},{"lineBreak":true},{"text":"Yo pi dous pase myèl, pase siwo a","poem":1},{"lineBreak":true},{"text":"ki tonbe nan gato myèl la.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Anplis, se pa yo menm ke sèvitè Ou a","poem":1},{"lineBreak":true},{"text":"resevwa avètisman pou fè atansyon.","poem":1},{"lineBreak":true},{"text":"Pou sila ki kenbe yo, gen gran rekonpans.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Se kilès ki kab rekonèt fot li?","poem":1},{"lineBreak":true},{"text":"Padone mwen pou fot ke m pa konnen yo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Anplis, pwoteje sèvitè ou a kont peche ògèy yo.","poem":1},{"lineBreak":true},{"text":"Pa kite yo vin domine m.","poem":1},{"lineBreak":true},{"text":"Konsa, mwen kab rete san fot,","poem":1},{"lineBreak":true},{"text":"epi va inosan a gran peche.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kite pawòl bouch mwen a avèk","poem":1},{"lineBreak":true},{"text":"refleksyon kè m","poem":1},{"lineBreak":true},{"text":"vin akseptab devan zye Ou,","poem":1},{"lineBreak":true},{"text":"O SENYÈ, wòch mwen, ak sovè mwen an.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}