{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Poukisa nasyon yo ap boulvèse konsa,","poem":1},{"lineBreak":true},{"text":"e pèp yo fòmante yon vye bagay?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wa latè yo pran pòz yo e chèf yo","poem":1},{"lineBreak":true},{"text":"pran konsèy ansanm kont SENYÈ a,","poem":1},{"lineBreak":true},{"text":"e kont onksyone pa Li a:","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"“Annou chire chenn sa yo,","poem":1},{"lineBreak":true},{"text":"e jete kòd ki mare nou yo!”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sila ki chita nan syèl la ri;","poem":1},{"lineBreak":true},{"text":"SENYÈ a ap moke yo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Anplis, Li va pale avèk yo nan kòlè Li.","poem":1},{"lineBreak":true},{"text":"Li va fè yo sezi nan kòlè Li.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Men pou Mwen menm,","poem":1},{"lineBreak":true},{"text":"Mwen fin plase Wa Mwen an sou Sion,","poem":1},{"lineBreak":true},{"text":"mòn sen Mwen an.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Anverite, Mwen va pale selon deklarasyon SENYÈ a;","poem":1},{"lineBreak":true},{"text":"SENYÈ a te di Mwen: “Ou se Fis Mwen.","poem":1},{"lineBreak":true},{"text":"Se jodi a, Mwen te fè Ou.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mande Mwen, e Mwen va bay Ou","poem":1},{"lineBreak":true},{"text":"nasyon yo kon eritaj,","poem":1},{"lineBreak":true},{"text":"jis rive nan dènye pwent latè","poem":1},{"lineBreak":true},{"text":"kon posesyon pa Ou.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ou va kase yo avèk yon baton fè,","poem":1},{"lineBreak":true},{"text":"Ou va kraze yo tankou veso kanari.”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Konsa, O wa yo, sèvi ak sajès.","poem":1},{"lineBreak":true},{"text":"Fè atansyon, O jij sou latè yo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Adore SENYÈ a avèk gran respè e","poem":1},{"lineBreak":true},{"text":"rejwi avèk tranbleman.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fè omaj a Fis la, pou L pa vin fache,","poem":1},{"lineBreak":true},{"text":"epi ou ta mouri nan chemen an.","poem":1},{"lineBreak":true},{"text":"Paske gwo chalè Li kab limen ase vit.","poem":1},{"lineBreak":true},{"text":"A la beni se tout sila ki kache nan Li.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}