{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la; Yon sòm David"]},{"type":"verse","number":1,"content":[{"text":"Ke SENYÈ a kapab reponn ou nan jou gran twoub la!","poem":1},{"lineBreak":true},{"text":"Ke non Bondye Jacob la kapab","poem":1},{"lineBreak":true},{"text":"kenbe ou ansekirite an wo!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ke Li kapab voye bay ou èd soti nan","poem":1},{"lineBreak":true},{"text":"sanktiyè a,","poem":1},{"lineBreak":true},{"text":"epi bay ou soutyen soti nan Sion.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ke Li kapab sonje tout ofrann sereyal ou yo,","poem":1},{"lineBreak":true},{"text":"ke Li twouve tout ofrann brile ou yo byen akseptab!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ke Li kapab bay ou dezi a kè ou,","poem":1},{"lineBreak":true},{"text":"e akonpli tout plan ou yo!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nou va chante avèk jwa akoz viktwa ou.","poem":1},{"lineBreak":true},{"text":"Nan non Bondye nou an, nou va monte drapo nou yo.","poem":1},{"lineBreak":true},{"text":"Ke SENYÈ a kapab akonpli tout priyè ou yo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Alò, mwen konnen ke SENYÈ a","poem":1},{"lineBreak":true},{"text":"va delivre moun onksyone pa Li a.","poem":1},{"lineBreak":true},{"text":"Li va reponn li soti nan syèl sen Li an,","poem":1},{"lineBreak":true},{"text":"avèk delivrans pwisan men dwat Li a.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Genyen kèk ki fè konfyans nan cha yo, e kèk nan cheval yo,","poem":1},{"lineBreak":true},{"text":"Men nou va fè konfyans nan non SENYÈ a, Bondye nou an.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yo te pliye e yo te tonbe,","poem":1},{"lineBreak":true},{"text":"men nou te leve e nou te kanpe dwat.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Delivre nou O SENYÈ!","poem":1},{"lineBreak":true},{"text":"Ke Wa a kapab reponn nou nan jou ke nou rele Non Li an.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}