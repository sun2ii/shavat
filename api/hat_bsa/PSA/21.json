{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":21,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la; Yon sòm David"]},{"type":"verse","number":1,"content":[{"text":"O SENYÈ, nan fòs Ou, Wa a va fè kè kontan.","poem":1},{"lineBreak":true},{"text":"Nan delivrans Ou, ki gran rejwisans li va gen!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ou te bay li dezi a kè li,","poem":1},{"lineBreak":true},{"text":"ni Ou pa t refize demand a lèv li yo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Paske Ou te vin rankontre Li avèk","poem":1},{"lineBreak":true},{"text":"benediksyon de tout bon bagay.","poem":1},{"lineBreak":true},{"text":"Ou te mete yon kouwòn sou tèt li.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Li te mande Ou lavi e Ou te bay li.","poem":1},{"lineBreak":true},{"text":"Yon vi ki long ak jou k ap dire","poem":1},{"lineBreak":true},{"text":"jis pou tout tan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Glwa li gran nan sali pa Ou.","poem":1},{"lineBreak":true},{"text":"Onè ak majeste Ou te mete sou li.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Paske Ou te fè li beni pase tout moun, jis pou tout tan;","poem":1},{"lineBreak":true},{"text":"Ou te fè li plen ak lajwa avèk kè kontan nan prezans Ou.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Paske wa a mete konfyans li nan SENYÈ a.","poem":1},{"lineBreak":true},{"text":"Epi akoz lanmou dous a Pi Wo a,","poem":1},{"lineBreak":true},{"text":"Li p ap ebranle menm.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Men ou va dekouvri tout lènmi ou yo.","poem":1},{"lineBreak":true},{"text":"Men dwat ou va jwenn sila ki rayi ou yo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ou va fè yo tankou yon founo k ap brile nan tan kòlè ou.","poem":1},{"lineBreak":true},{"text":"SENYÈ a va vale yo nèt nan kòlè Li,","poem":1},{"lineBreak":true},{"text":"epi dife va devore yo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ou va detwi posterite pa yo soti sou latè,","poem":1},{"lineBreak":true},{"text":"epi desandan yo ap disparèt pami fis a lòm yo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Malgre yo te anvizaje mal kont Ou,","poem":1},{"lineBreak":true},{"text":"e te fòme yon konplo,","poem":1},{"lineBreak":true},{"text":"yo p ap reyisi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Paske Ou va fè yo vire do yo.","poem":1},{"lineBreak":true},{"text":"Ou va pwente banza sou figi yo","poem":1},{"lineBreak":true},{"text":"ak bon kontwòl.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ke Ou leve wo, O SENYÈ,","poem":1},{"lineBreak":true},{"text":"ak tout fòs Ou!","poem":1},{"lineBreak":true},{"text":"Nou va chante e bay lwanj a pwisans Ou.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}