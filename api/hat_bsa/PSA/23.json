{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"hebrew_subtitle","content":["Yon sòm David"]},{"type":"verse","number":1,"content":[{"text":"Bondye se bèje mwen;","poem":1},{"lineBreak":true},{"text":"mwen p ap janm manke anyen.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Li fè m kouche nan patiraj vèt yo.","poem":1},{"lineBreak":true},{"text":"Li mennen m akote dlo pezib yo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Li restore nanm mwen.","poem":1},{"lineBreak":true},{"text":"Li gide mwen nan chemen ladwati yo,","poem":1},{"lineBreak":true},{"text":"akoz non sen Li an.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Malgre mwen ta mache nan vale","poem":1},{"lineBreak":true},{"text":"lonbraj lanmò a,","poem":1},{"lineBreak":true},{"text":"mwen p ap pè okenn mal, paske Ou avè m.","poem":1},{"lineBreak":true},{"text":"Baton Ou avèk kwòk Ou fè m gen konfyans.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ou ranje yon tab devan mwen","poem":1},{"lineBreak":true},{"text":"nan prezans lènmi mwen yo.","poem":1},{"lineBreak":true},{"text":"Ou onksyone tèt mwen avèk lwil.","poem":1},{"lineBreak":true},{"text":"Tas mwen fin debòde nèt.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Anverite, bonte Ou avèk lanmou dous Ou","poem":1},{"lineBreak":true},{"text":"va swiv mwen pou tout jou lavi mwen yo,","poem":1},{"lineBreak":true},{"text":"E mwen va viv lakay","poem":1},{"lineBreak":true},{"text":"SENYÈ a jis pou tout tan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}