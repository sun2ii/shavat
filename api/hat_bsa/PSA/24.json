nan SENYÈ a,","poem":1},{"lineBreak":true},{"text":"ak ladwati soti nan Bondye delivrans li an.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sa se jenerasyon a sila k ap chache Li yo,","poem":1},{"lineBreak":true},{"text":"ka p chache figi Ou—menm Jacob. Tan","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Leve wo lento ou yo, o pòtay yo!","poem":1},{"lineBreak":true},{"text":"Leve wo, o pòt ansyen yo!","poem":1},{"lineBreak":true},{"text":"Pou Wa glwa la kapab antre!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Se kilès ki Wa a glwa a?","poem":1},{"lineBreak":true},{"text":"SENYÈ fò e pwisan an,","poem":1},{"lineBreak":true},{"text":"SENYÈ a pwisan nan batay la.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Leve wo lento ou yo, O Pòtay yo!","poem":1},{"lineBreak":true},{"text":"Leve wo, O pòt ansyen yo!","poem":1},{"lineBreak":true},{"text":"Pou Wa glwa la kapab antre!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Se kilès ki Wa glwa a?","poem":1},{"lineBreak":true},{"text":"SENYÈ dèzame yo!","poem":1},{"lineBreak":true},{"text":"Se Li menm ki Wa glwa a. Tan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}