{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":25,"content":[{"type":"hebrew_subtitle","content":["Yon sòm David"]},{"type":"verse","number":1,"content":[{"text":"A Ou menm, O SENYÈ, mwen leve nanm mwen.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O Bondye mwen, nan Ou, mwen mete konfyans mwen.","poem":1},{"lineBreak":true},{"text":"Pa kite mwen vin wont;","poem":1},{"lineBreak":true},{"text":"pa kite lènmi m yo fè fèt sou mwen.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Anverite, nanpwen nan sila ki tann Ou yo ki va wont;","poem":1},{"lineBreak":true},{"text":"sila ki fè konplo kont Ou san koz yo, va wont.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Fè m konnen pa Ou yo, O SENYÈ;","poem":1},{"lineBreak":true},{"text":"enstwi m nan chemen Ou yo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mennen mwen nan verite Ou e enstwi mwen,","poem":1},{"lineBreak":true},{"text":"Paske se Ou menm ki Bondye delivrans mwen;","poem":1},{"lineBreak":true},{"text":"se Ou m ap tann tout lajounen.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sonje, O SENYÈ, mizerikòd Ou ak lanmou dous Ou a,","poem":1},{"lineBreak":true},{"text":"Paske se yo ki la depi tan ale nèt.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pa sonje peche jenès mwen yo, ni transgresyon mwen yo.","poem":1},{"lineBreak":true},{"text":"Selon lanmou dous Ou, sonje mwen,","poem":1},{"lineBreak":true},{"text":"Pou koz a bonte Ou, O SENYÈ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bon e plen ladwati, se SENYÈ a;","poem":1},{"lineBreak":true},{"text":"pou sa, Li enstwi pechè yo nan chemen an.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Li dirije enb yo nan jistis, e","poem":1},{"lineBreak":true},{"text":"Li va enstwi enb yo nan chemen Li.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tout chemen Bondye se nan","poem":1},{"lineBreak":true},{"text":"lanmou dous avèk verite","poem":1},{"lineBreak":true},{"text":"pou sila ki kenbe akò Li yo ak","poem":1},{"lineBreak":true},{"text":"temwayaj Li yo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Pou koz a non Ou, O SENYÈ,","poem":1},{"lineBreak":true},{"text":"padone inikite mwen, paske li anpil.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kilès nonm nan ki gen krent SENYÈ a?","poem":1},{"lineBreak":true},{"text":"Li va enstwi li nan chemen li ta dwe chwazi a.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nanm li va viv alèz.","poem":1},{"lineBreak":true},{"text":"Desandan li yo va resevwa eritaj peyi a.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Lamitye SENYÈ a se pou sila ki","poem":1},{"lineBreak":true},{"text":"gen lakrent Li yo.","poem":1},{"lineBreak":true},{"text":"Li va fè yo konnen akò Li.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Zye m toujou vè SENYÈ a,","poem":1},{"lineBreak":true},{"text":"paske Li va retire pye mwen nan pèlen an.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Vire vè mwen e fè m gras,","poem":1},{"lineBreak":true},{"text":"paske mwen abandone e aflije.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Twoub a kè m yo vin plis.","poem":1},{"lineBreak":true},{"text":"Mennen m sòti nan gwo detrès sa a.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Gade sou afliksyon mwen avèk twoub mwen yo,","poem":1},{"lineBreak":true},{"text":"e padone tout peche mwen yo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Gade sou tout lènmi mwen yo, paske yo anpil.","poem":1},{"lineBreak":true},{"text":"Epi yo rayi mwen avèk yon rayisman ki vyolan.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Gade nanm mwen e delivre mwen.","poem":1},{"lineBreak":true},{"text":"Pa kite m vin wont, paske mwen","poem":1},{"lineBreak":true},{"text":"pran refij nan Ou menm.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Kite entegrite avèk ladwati pwoteje mwen,","poem":1},{"lineBreak":true},{"text":"paske se Ou m ap tann.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Delivre Israël, O Bondye, sou","poem":1},{"lineBreak":true},{"text":"tout twoub li yo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}