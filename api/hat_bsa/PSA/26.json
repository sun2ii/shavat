{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"hebrew_subtitle","content":["Yon sòm David"]},{"type":"verse","number":1,"content":[{"text":"Fè m jistis, O SENYÈ, paske mwen te mache nan entegrite mwen.","poem":1},{"lineBreak":true},{"text":"Mwen te mete konfyans mwen nan SENYÈ a san varye.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chache anndan m, O SENYÈ, e pase mwen a leprèv.","poem":1},{"lineBreak":true},{"text":"Sonde panse mwen avèk kè m.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Paske lanmou dous Ou a devan zye m.","poem":1},{"lineBreak":true},{"text":"Mwen te mache nan verite Ou.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mwen pa chita avèk mesye k ap twonpe moun yo.","poem":1},{"lineBreak":true},{"text":"Ni mwen pa pale avèk sila k ap pran poz yo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mwen rayi asanble malfektè yo, e","poem":1},{"lineBreak":true},{"text":"mwen pa chita avèk mechan yo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mwen va lave men m nan inosans, e","poem":1},{"lineBreak":true},{"text":"mwen va antoure lotèl Ou, O SENYÈ,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"pou m kapab pwoklame avèk vwa remèsiman a,","poem":1},{"lineBreak":true},{"text":"e deklare tout mèvèy Ou yo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O SENYÈ, Mwen renmen abitasyon lakay Ou,","poem":1},{"lineBreak":true},{"text":"avèk kote ke glwa Ou rete a.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pa retire nanm mwen ansanm avèk pechè yo,","poem":1},{"lineBreak":true},{"text":"ni lavi m avèk mesye ki vèse san yo,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"nan men a sila ki gen manèv mechan yo,","poem":1},{"lineBreak":true},{"text":"ki nan mechanste pote kado vèse anba tab yo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Men pou mwen, mwen va mache nan entegrite mwen.","poem":1},{"lineBreak":true},{"text":"Delivre mwen e fè m gras.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Pye m kanpe sou yon plas byen plat.","poem":1},{"lineBreak":true},{"text":"Nan asanble a, mwen va beni SENYÈ a.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}