{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":27,"content":[{"type":"hebrew_subtitle","content":["Yon sòm David"]},{"type":"verse","number":1,"content":[{"text":"SENYÈ a se limyè mwen e sali mwen.","poem":1},{"lineBreak":true},{"text":"Se kilès pou m ta pè? SENYÈ a se","poem":1},{"lineBreak":true},{"text":"defans lavi mwen.","poem":1},{"lineBreak":true},{"text":"Se kilès k ap fè m gen laperèz?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lè malfektè yo te rive sou mwen","poem":1},{"lineBreak":true},{"text":"pou yo ta devore chè m,","poem":1},{"lineBreak":true},{"text":"advèsè mwen yo ak lènmi m yo","poem":1},{"lineBreak":true},{"text":"te chape tonbe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Malgre yon lame ta fè kan kont mwen, kè m p ap pè.","poem":1},{"lineBreak":true},{"text":"Malgre lagè leve kont mwen,","poem":1},{"lineBreak":true},{"text":"malgre sa, m ap gen konfyans.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yon sèl bagay ke m te mande a SENYÈ a;","poem":1},{"lineBreak":true},{"text":"se li mwen va chache:","poem":1},{"lineBreak":true},{"text":"pou m ta kab rete lakay SENYÈ a","poem":1},{"lineBreak":true},{"text":"tout jou lavi m yo,","poem":1},{"lineBreak":true},{"text":"pou m kab gade bèlte SENYÈ a, e","poem":1},{"lineBreak":true},{"text":"reflechi jis nan fon kè m nan tanp Li an.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Paske nan jou twoub la,","poem":1},{"lineBreak":true},{"text":"Li va kache mwen nan tabènak Li.","poem":1},{"lineBreak":true},{"text":"Nan plas sekrè kote tant Li an ye a,","poem":1},{"lineBreak":true},{"text":"se la Li va fè m kache.","poem":1},{"lineBreak":true},{"text":"Li va leve mwen sou yon wòch.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Epi koulye a, tèt mwen va vin leve wo","poem":1},{"lineBreak":true},{"text":"sou lènmi m ki antoure m yo.","poem":1},{"lineBreak":true},{"text":"Konsa, mwen va ofri nan tant Li sakrifis avèk gwo kri lajwa.","poem":1},{"lineBreak":true},{"text":"Mwen va chante, wi, mwen va chante lwanj a SENYÈ a.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tande, O SENYÈ, lè m kriye avèk vwa m.","poem":1},{"lineBreak":true},{"text":"Fè m gras e reponn mwen.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lè Ou te di m: “Chache wè figi Mwen”,","poem":1},{"lineBreak":true},{"text":"kè m te di Ou: “Figi Ou menm, O SENYÈ,","poem":1},{"lineBreak":true},{"text":"se li mwen va chache.”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pa kache figi Ou de mwen.","poem":1},{"lineBreak":true},{"text":"Pa detounen sèvitè Ou a pa deyò nan kòlè Ou.","poem":1},{"lineBreak":true},{"text":"Se Ou ki konn sekou mwen.","poem":1},{"lineBreak":true},{"text":"Pa abandone mwen, ni kite m sèl,","poem":1},{"lineBreak":true},{"text":"O Bondye delivrans mwen an.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Paske papa m ak manman m te abandone mwen,","poem":1},{"lineBreak":true},{"text":"Men SENYÈ a va ranmase mwen.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Enstwi mwen nan chemen Ou, O SENYÈ.","poem":1},{"lineBreak":true},{"text":"Mennen m nan yon wout ki a nivo, akoz lènmi mwen yo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Pa livre mwen de dezi lènmi mwen yo,","poem":1},{"lineBreak":true},{"text":"paske fo temwen yo vin leve kont mwen,","poem":1},{"lineBreak":true},{"text":"sila k ap respire vyolans yo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mwen toujou gen konfyans sa a:","poem":1},{"lineBreak":true},{"text":"ke m va wè bonte SENYÈ a nan peyi a vivan yo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tann SENYÈ a.","poem":1},{"lineBreak":true},{"text":"Kenbe fòs Ou e kite kè Ou pran kouraj.","poem":1},{"lineBreak":true},{"text":"Wi, tann SENYÈ a.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}