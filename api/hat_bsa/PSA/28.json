{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":28,"content":[{"type":"hebrew_subtitle","content":["Yon sòm David"]},{"type":"verse","number":1,"content":[{"text":"A Ou menm, O SENYÈ, mwen rele!","poem":1},{"lineBreak":true},{"text":"Wòch mwen an, pa vin soud devan m,","poem":1},{"lineBreak":true},{"text":"paske si Ou rete silan devan mwen,","poem":1},{"lineBreak":true},{"text":"mwen va devni kon sila ki desann nan twou fòs la nèt.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tande vwa a siplikasyon mwen yo","poem":1},{"lineBreak":true},{"text":"lè m kriye a Ou menm pou sekou,","poem":1},{"lineBreak":true},{"text":"lè m leve men m vè sanktiyè sen Ou an.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pa rale m sòti avèk mechan yo,","poem":1},{"lineBreak":true},{"text":"avèk sila ki fè inikite yo, ki pale lapè avèk vwazen yo,","poem":1},{"lineBreak":true},{"text":"pandan mechanste nan kè yo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rekonpanse yo selon zèv yo ak selon mechanste yo abitye fè yo.","poem":1},{"lineBreak":true},{"text":"Rekonpanse yo selon zèv men yo.","poem":1},{"lineBreak":true},{"text":"Remèt yo tout rekonpans pa yo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Akoz yo pa okipe zèv a SENYÈ yo,","poem":1},{"lineBreak":true},{"text":"ni travay men Li yo.","poem":1},{"lineBreak":true},{"text":"Pou sa, Li va chire yo desann, e Li p ap fè yo remonte.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Beni se SENYÈ a,","poem":1},{"lineBreak":true},{"text":"akoz Li te tande vwa a siplikasyon mwen yo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"SENYÈ a se fòs mwen ak boukliye mwen.","poem":1},{"lineBreak":true},{"text":"Kè m mete konfyans nan Li, e mwen","poem":1},{"lineBreak":true},{"text":"jwenn sekou.","poem":1},{"lineBreak":true},{"text":"Pou sa, kè m leve wo nèt.","poem":1},{"lineBreak":true},{"text":"Avèk chanson mwen, mwen va di Li mèsi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"SENYÈ a se fòs yo.","poem":1},{"lineBreak":true},{"text":"Li se yon defans pou sove onksyone Li yo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sove pèp Ou a, e beni eritaj pa Ou a.","poem":1},{"lineBreak":true},{"text":"Devni bèje yo tou,","poem":1},{"lineBreak":true},{"text":"e bay yo soutyen jis pou tout tan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}