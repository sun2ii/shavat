{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":29,"content":[{"type":"hebrew_subtitle","content":["Yon sòm David"]},{"type":"verse","number":1,"content":[{"text":"Bay a SENYÈ a, O Fis a moun pwisan yo,","poem":1},{"lineBreak":true},{"text":"bay a SENYÈ a, glwa avèk gwo fòs.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bay a SENYÈ a, glwa ke non Li merite a.","poem":1},{"lineBreak":true},{"text":"Adore SENYÈ a avèk tout sa ki sen.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Vwa SENYÈ a sou dlo yo.","poem":1},{"lineBreak":true},{"text":"Bondye glwa la fè tonnè gwonde, eklate.","poem":1},{"lineBreak":true},{"text":"SENYÈ a sou anpil dlo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Vwa SENYÈ a gen gwo fòs.","poem":1},{"lineBreak":true},{"text":"Vwa SENYÈ a ranpli ak majeste.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Vwa SENYÈ a fann bwa sèd yo.","poem":1},{"lineBreak":true},{"text":"Wi, SENYÈ a fann an mòso bwa sèd Liban yo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Li fè Liban sote. Li ponpe tankou yon ti bèf, e","poem":1},{"lineBreak":true},{"text":"Sirion tankou yon jèn bèf mawon.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Vwa SENYÈ a koupe fè flanm dife.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Vwa SENYÈ a souke savann nan.","poem":1},{"lineBreak":true},{"text":"Vwa SENYÈ a souke savann Kadès la.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Vwa SENYÈ a fè bich la fè pitit.","poem":1},{"lineBreak":true},{"text":"Li fè forè a vin toutouni.","poem":1},{"lineBreak":true},{"text":"Nan tanp Li a, tout moun ki la yo rele: “Glwa”!","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"SENYÈ a te chita kon Wa nan gran inondasyon an.","poem":1},{"lineBreak":true},{"text":"Wi, SENYÈ a chita kon Wa jis pou tout tan.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"SENYÈ a va bay fòs a pèp Li a.","poem":1},{"lineBreak":true},{"text":"SENYÈ a va beni pèp li a avèk lapè.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}