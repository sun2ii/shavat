{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["Yon Sòm a David lè l te sove ale devan Absalom, fis li a"]},{"type":"verse","number":1,"content":[{"text":"O SENYÈ, gade kijan lènmi mwen","poem":1},{"lineBreak":true},{"text":"yo ap miltipliye;","poem":1},{"lineBreak":true},{"text":"Anpil moun leve kont mwen.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Anpil moun pale de nanm mwen,","poem":1},{"lineBreak":true},{"text":"“Nanpwen delivrans pou li nan Bondye.” Tan","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Men Ou menm, O SENYÈ, se yon pwotèj ki antoure mwen,","poem":1},{"lineBreak":true},{"text":"glwa mwen, ak Sila ki fè tèt mwen leve a.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mwen t ap kriye a SENYÈ a ak vwa mwen;","poem":1},{"lineBreak":true},{"text":"Li te reponn mwen soti nan mòn sen Li an Tan","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mwen te kouche e dòmi;","poem":1},{"lineBreak":true},{"text":"mwen te leve, paske se SENYÈ a ki ban m fòs.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mwen p ap pè menm dè milye de moun","poem":1},{"lineBreak":true},{"text":"ki ta pran pozisyon kont mwen de tout kote.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Leve, O SENYÈ!","poem":1},{"lineBreak":true},{"text":"Sove mwen, O Bondye mwen!","poem":1},{"lineBreak":true},{"text":"Paske Ou te souflete tout lènmi mwen yo.","poem":1},{"lineBreak":true},{"text":"Ou te kraze dan a mechan yo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Delivrans se nan SENYÈ a.","poem":1},{"lineBreak":true},{"text":"Ke benediksyon Ou toujou poze sou pèp Ou a.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}