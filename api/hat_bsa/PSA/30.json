{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":30,"content":[{"type":"hebrew_subtitle","content":["Yon Sòm; yon chan nan Dedikasyon Kay La; Yon Sòm David"]},{"type":"verse","number":1,"content":[{"text":"Mwen va leve Ou wo, O SENYÈ, paske Ou te leve mwen.","poem":1},{"lineBreak":true},{"text":"Ou pa t kite lènmi m yo rejwi sou mwen.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O SENYÈ, Bondye mwen an, mwen te kriye a Ou menm,","poem":1},{"lineBreak":true},{"text":"e Ou te geri mwen.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"O SENYÈ, Ou te fè nanm mwen monte kite sejou lanmò yo.","poem":1},{"lineBreak":true},{"text":"Ou te kenbe m vivan, pou m pa t desann nan gwo fòs la.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chante lwanj a SENYÈ a, nou menm ki fidèl Li yo.","poem":1},{"lineBreak":true},{"text":"Bay remèsiman a sen non Li.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Paske kòlè Li se sèlman pou yon moman,","poem":1},{"lineBreak":true},{"text":"men Bonte Li se pou tout tan.","poem":1},{"lineBreak":true},{"text":"Kriye a kapab dire pou nwit lan,","poem":1},{"lineBreak":true},{"text":"men kri lajwa a vin parèt nan maten.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Alò, pou mwen, mwen te di nan bon tan mwen,","poem":1},{"lineBreak":true},{"text":"“Mwen p ap janm ebranle.”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"O SENYÈ, pa gras Ou, Ou te fè mòn mwen an kanpe fèm.","poem":1},{"lineBreak":true},{"text":"Lè Ou te kache figi Ou, mwen te dekouraje nèt.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A Ou menm, SENYÈ, mwen te rele.","poem":1},{"lineBreak":true},{"text":"A SENYÈ mwen an, mwen te fè siplikasyon mwen yo:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"“Ki benefis ki genyen nan san mwen","poem":1},{"lineBreak":true},{"text":"si mwen desann nan gwo fòs la?","poem":1},{"lineBreak":true},{"text":"Èske pousyè a kab louwe Ou?","poem":1},{"lineBreak":true},{"text":"Èske li va deklare fidelite Ou?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tande, O SENYÈ e fè m gras.","poem":1},{"lineBreak":true},{"text":"O SENYÈ, ban m soutyen.”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ou te chanje doulè mwen, e","poem":1},{"lineBreak":true},{"text":"sa te fè m vin danse ak lajwa;","poem":1},{"lineBreak":true},{"text":"Ou te demare rad twal sak mwen an,","poem":1},{"lineBreak":true},{"text":"e te mare senti m avèk kè kontan.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Konsa, pou kè m kab chante lwanj Ou, e pa rete an silans.","poem":1},{"lineBreak":true},{"text":"O SENYÈ, Bondye mwen an, mwen va","poem":1},{"lineBreak":true},{"text":"bay Ou glwa pou tout tan, nèt.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}