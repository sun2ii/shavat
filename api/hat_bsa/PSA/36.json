{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":36,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la; Yon Sòm David, sèvitè SENYÈ a"]},{"type":"verse","number":1,"content":[{"text":"Se Peche ki pale nan fon kè a lòm ki san Bondye.","poem":1},{"lineBreak":true},{"text":"Nanpwen krent Bondye devan zye l.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Jan li kontan ak pwòp tèt li,","poem":1},{"lineBreak":true},{"text":"li pa janm wè pwop peche pa l la.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pawòl a bouch li se mechanste avèk manti.","poem":1},{"lineBreak":true},{"text":"Li fè yon chemen ki pa bon.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sou kabann li, li fè plan mechan;","poem":1},{"lineBreak":true},{"text":"Li antre nan yon wout ki p ap sòti byen;","poem":1},{"lineBreak":true},{"text":"Li pa rayi mal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lanmou dous Ou, O SENYÈ, rive jis nan syèl yo,","poem":1},{"lineBreak":true},{"text":"fidelite Ou nan syèl la.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ladwati Ou se tankou mòn Bondye yo,","poem":1},{"lineBreak":true},{"text":"ejijman Ou yo tankou yon gran pwofondè.","poem":1},{"lineBreak":true},{"text":"O SENYÈ, Ou prezève ni lòm, ni bèt.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lanmou dous Ou chè, O Bondye!","poem":1},{"lineBreak":true},{"text":"Pitit a lòm yo pran azil anba lonbraj zèl Ou.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yo bwè jiskaske yo vin plen an abondans lakay Ou.","poem":1},{"lineBreak":true},{"text":"Konsa,Ou bay yo bwè nan rivyè plezi Ou yo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Paske avèk Ou, se fontèn dlo lavi a.","poem":1},{"lineBreak":true},{"text":"Nan limyè pa Ou a, nou wè limyè.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"O bay toujou lanmou dous Ou a pou sila ki konnen Ou yo,","poem":1},{"lineBreak":true},{"text":"ak ladwati Ou pou sila ki dwat nan kè yo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Pa kite pye ògèy vini sou mwen,","poem":1},{"lineBreak":true},{"text":"ni pa kite men a mechan yo chase mwen ale.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Se la sila k ap fè inikite yo gen tan fin tonbe.","poem":1},{"lineBreak":true},{"text":"Yo te peze desann ak fòs, e yo p ap kab leve ankò.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}