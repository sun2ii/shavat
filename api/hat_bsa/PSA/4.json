{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la; sou enstriman ak fil yo; yon sòm David"]},{"type":"verse","number":1,"content":[{"text":"Reponn mwen lè m rele Ou, O Bondye ladwati mwen;","poem":1},{"lineBreak":true},{"text":"Ou te fè m pran souf nan gran twoub mwen an.","poem":1},{"lineBreak":true},{"text":"Fè m gras e tande lapriyè mwen.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O fis a lòm yo, jiskilè laglwa Mwen va devni yon repwòch?","poem":1},{"lineBreak":true},{"text":"Jiskilè ou va renmen sa ki san valè","poem":1},{"lineBreak":true},{"text":"e tante twonpe moun? Tan","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Men konnen ke SENYÈ a te mete nonm Bondye a apa pou Li menm.","poem":1},{"lineBreak":true},{"text":"SENYÈ a tande lè m fè apèl Li.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tranble, men pa fè peche.","poem":1},{"lineBreak":true},{"text":"Reflechi nan kè ou sou kabann ou, e rete kalm. Tan","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ofri sakrifis ladwati yo.","poem":1},{"lineBreak":true},{"text":"Mete konfyans nan SENYÈ a.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Anpil ap di: “Kilès ki kab montre nou yon bagay ki bon?”","poem":1},{"lineBreak":true},{"text":"SENYÈ, leve wo limyè a vizaj Ou devan nou!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ou te mete lajwa nan kè m plis pase","poem":1},{"lineBreak":true},{"text":"lè gwo rekòlt sereyal mi ak diven nèf vin parèt.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Anpè, mwen va kouche pou dòmi,","poem":1},{"lineBreak":true},{"text":"paske Ou sèl, SENYÈ, fè m viv ansekirite.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}