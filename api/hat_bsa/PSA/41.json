{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":41,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la; Yon Sòm David"]},{"type":"verse","number":1,"content":[{"text":"A la beni sila ki konsidere ka malere a beni!","poem":1},{"lineBreak":true},{"text":"SENYÈ a va delivre li nan jou twoub li.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"SENYÈ a va pwoteje li e fè l viv.","poem":1},{"lineBreak":true},{"text":"Li va rele beni sou latè a.","poem":1},{"lineBreak":true},{"text":"Ni li p ap livre a volonte lènmi li yo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"SENYÈ a va bay li soutyen lè l malad sou kabann nan.","poem":1},{"lineBreak":true},{"text":"Nan maladi li, li va restore li a lasante.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Konsa, pou mwen, mwen te di: “O SENYÈ, fè m gras.","poem":1},{"lineBreak":true},{"text":"Geri nanm mwen paske mwen te peche kont Ou.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lènmi m yo pale mal kont mwen:","poem":1},{"lineBreak":true},{"text":"“Kilè l ap mouri pou non li disparèt?”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Si li vin wè m, li bay manti.","poem":1},{"lineBreak":true},{"text":"Kè li ranmase mechanste pou kont li.","poem":1},{"lineBreak":true},{"text":"Lè l sòti deyò, li pale sa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tout sila ki rayi mwen yo","poem":1},{"lineBreak":true},{"text":"soufle ti pawòl nan zòrèy youn lòt.","poem":1},{"lineBreak":true},{"text":"Kont mwen, yo fè plan pou","poem":1},{"lineBreak":true},{"text":"donmaje mwen epi yo di:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"“Yon bagay mechan gen tan pran l,","poem":1},{"lineBreak":true},{"text":"pou lè l kouche, pou l pa leve ankò.”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Menm zanmi ki te pre m nan,","poem":1},{"lineBreak":true},{"text":"nan sila mwen te mete konfyans la,","poem":1},{"lineBreak":true},{"text":"li ki te manje pen mwen,","poem":1},{"lineBreak":true},{"text":"te leve talon li kont mwen.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Men Ou menm, O SENYÈ, fè m gras e fè m leve","poem":1},{"lineBreak":true},{"text":"pou m kab bay yo rekonpans yo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Se konsa mwen konnen ke Ou pran plezi nan mwen.","poem":1},{"lineBreak":true},{"text":"Akoz lènmi mwen an pa kriye viktwa sou mwen.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Pou mwen menm, Ou soutni mwen nan entegrite m,","poem":1},{"lineBreak":true},{"text":"epi Ou mete mwen nan prezans Ou","poem":1},{"lineBreak":true},{"text":"jis pou tout tan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Beni se SENYÈ a, Bondye Israël la,","poem":1},{"lineBreak":true},{"text":"soti pou tout tan, jis rive pou tout tan.","poem":1},{"lineBreak":true},{"text":"Amen e amen.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}