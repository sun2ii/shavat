{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Deklare m inosan, O Bondye mwen!","poem":1},{"lineBreak":true},{"text":"Plede ka mwen kont yon nasyon enfidèl.","poem":1},{"lineBreak":true},{"text":"O delivre mwen soti nan men","poem":1},{"lineBreak":true},{"text":"a lezòm mantè e enjis yo!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Paske Ou se Bondye fòs mwen an.","poem":1},{"lineBreak":true},{"text":"Poukisa Ou rejte m?","poem":1},{"lineBreak":true},{"text":"Poukisa mwen fè dèy akoz opresyon a lènmi an?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Voye limyè Ou deyò avèk verite Ou;","poem":1},{"lineBreak":true},{"text":"kite yo mennen mwen.","poem":1},{"lineBreak":true},{"text":"Kite yo mennen m nan mòn sen Ou an ak kote Ou abite yo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Konsa, mwen va ale vè lotèl Bondye a,","poem":1},{"lineBreak":true},{"text":"Bondye lajwa m ki depase limit lan.","poem":1},{"lineBreak":true},{"text":"Konsa, sou gita a, mwen va bay Ou lwanj,","poem":1},{"lineBreak":true},{"text":"O Bondye, Bondye mwen an.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Poukisa ou nan dezespwa, O nanm mwen?","poem":1},{"lineBreak":true},{"text":"E poukisa ou twouble anndan m?","poem":1},{"lineBreak":true},{"text":"Mete espwa ou nan Bondye!","poem":1},{"lineBreak":true},{"text":"Paske m ap louwe Li ankò:","poem":1},{"lineBreak":true},{"text":"O sove m, soutyen mwen an,","poem":1},{"lineBreak":true},{"text":"ak Bondye m.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}