{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":46,"content":[{"type":"hebrew_subtitle","content":["Yon Sòm a fis a Koré yo, selon Alamot; Yon chanson"]},{"type":"verse","number":1,"content":[{"text":"Bondye se pwotèj nou ak fòs nou,","poem":1},{"lineBreak":true},{"text":"yon sekou ki toujou la nan tan twoub la.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pou sa, nou p ap pè anyen, malgre latè","poem":1},{"lineBreak":true},{"text":"ta chanje e malgre mòn yo","poem":1},{"lineBreak":true},{"text":"ta chape antre nan fon lanmè.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Malgre dlo li yo ta fè laraj e kimen,","poem":1},{"lineBreak":true},{"text":"malgre mòn yo souke nan anfle ak ògèy yo. Tan","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Genyen yon rivyè ak flèv li yo","poem":1},{"lineBreak":true},{"text":"ki fè kè vil Bondye a kontan;","poem":1},{"lineBreak":true},{"text":"lye sen a kote Pi Wo a demere a.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bondye nan mitan li. Li p ap deplase menm.","poem":1},{"lineBreak":true},{"text":"Bondye va ede li vin parèt nan maten.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nasyon yo te fè gwo boulvèsman.","poem":1},{"lineBreak":true},{"text":"Wayòm yo te souke.","poem":1},{"lineBreak":true},{"text":"Li te leve vwa l e latè te fonn.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"SENYÈ dèzame yo avèk nou.","poem":1},{"lineBreak":true},{"text":"Bondye Jacob la se sitadèl nou.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Vini, gade byen zèv a SENYÈ yo","poem":1},{"lineBreak":true},{"text":"ki gwo dega Li fè nan tout latè.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Li fè lagè yo sispann jis rive nan ekstremite latè.","poem":1},{"lineBreak":true},{"text":"Li kase banza a, e koupe lans lan an de bout.","poem":1},{"lineBreak":true},{"text":"Li brile cha yo avèk dife.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"“Kanpe la e konnen ke se Mwen menm ki Bondye.","poem":1},{"lineBreak":true},{"text":"Mwen va leve wo pami nasyon yo.","poem":1},{"lineBreak":true},{"text":"Mwen va leve wo sou tè a.”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"SENYÈ dèzame yo avèk nou.","poem":1},{"lineBreak":true},{"text":"Bondye Jacob la se sitadèl nou. Tan","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}