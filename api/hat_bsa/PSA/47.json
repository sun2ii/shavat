{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la; Yo Sòm pa fis Koré yo."]},{"type":"verse","number":1,"content":[{"text":"O bat men nou ansanm, tout pèp yo.","poem":1},{"lineBreak":true},{"text":"Rele fò a Bondye avèk yon vwa plen viktwa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Paske SENYÈ Pi Wo a merite lakrent.","poem":1},{"lineBreak":true},{"text":"Li se Gran Wa a sou tout latè a.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Li fè soumèt pèp yo anba nou,","poem":1},{"lineBreak":true},{"text":"ak nasyon yo anba pye nou.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pou nou menm, Li chwazi eritaj nou,","poem":1},{"lineBreak":true},{"text":"glwa la a Jacob, ke Li renmen an. Tan","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bondye te monte avèk yon gwo rèl,","poem":1},{"lineBreak":true},{"text":"SENYÈ a avèk son twonpèt la.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chante lwanj Bondye a, chante lwanj yo!","poem":1},{"lineBreak":true},{"text":"Chante lwanj Wa nou an, chante lwanj yo!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Paske Bondye se Wa a tout tè a.","poem":1},{"lineBreak":true},{"text":"Chante lwanj yo avèk yon chan byen bèl.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bondye regne sou nasyon yo.","poem":1},{"lineBreak":true},{"text":"Bondye chita sou twòn wayal Li a.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Prens a pèp yo rasanble yo ansanm,","poem":1},{"lineBreak":true},{"text":"pèp a Bondye Abraham nan.","poem":1},{"lineBreak":true},{"text":"Paske tout boukliye sou latè yo se pou Bondye.","poem":1},{"lineBreak":true},{"text":"Li leve byen wo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}