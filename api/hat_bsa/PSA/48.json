{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":48,"content":[{"type":"hebrew_subtitle","content":["Yon Chan; yon Sòm fis a Koré yo."]},{"type":"verse","number":1,"content":[{"text":"Gran se Bondye e gran se lwanj Li merite a,","poem":1},{"lineBreak":true},{"text":"nan Jérusalem, vil Bondye nou an, mòn sen pa Li a.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bèl nan wotè li, jwa tout latè a,","poem":1},{"lineBreak":true},{"text":"se Mòn Sion nan pati nò a,","poem":1},{"lineBreak":true},{"text":"Vil gran Wa a.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bondye te parèt nan sitadèl li yo.","poem":1},{"lineBreak":true},{"text":"La, Li te fè tèt Li rekonèt kon yon refij.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Men gade, wa yo te rasanble yo.","poem":1},{"lineBreak":true},{"text":"Yo pase akote vil la ansanm.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yo te wè li, e yo te etone.","poem":1},{"lineBreak":true},{"text":"Yo te sezi nèt, yo te kouri nan laperèz.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"La, yo pèdi ekilib yo nèt.","poem":1},{"lineBreak":true},{"text":"Doulè ak sezisman te pran yo tankou fanm k ap akouche.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Avèk van lès la, Ou te kraze bato Tarsis yo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Jan nou konn tande a, se konsa nou vin wè,","poem":1},{"lineBreak":true},{"text":"nan vil SENYÈ dèzame yo,","poem":1},{"lineBreak":true},{"text":"nan vil Bondye pa nou an.","poem":1},{"lineBreak":true},{"text":"Bondye va etabli li nèt, jis pou tout tan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nou te reflechi sou lanmou dous","poem":1},{"lineBreak":true},{"text":"Ou a, O Bondye, nan mitan tanp Ou a.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Jan non Ou ye a, O Bondye,","poem":1},{"lineBreak":true},{"text":"Se konsa Lwanj Ou ye, jis rive nan dènye pwent tè a;","poem":1},{"lineBreak":true},{"text":"Men dwat Ou plen ladwati.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kite Mòn Sion fè kè kontan!","poem":1},{"lineBreak":true},{"text":"Kite fi a Juda yo rejwi akoz jijman Ou yo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mache toupatou nan Sion e antoure li.","poem":1},{"lineBreak":true},{"text":"Konte fò wo li yo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Konsidere ranpa li yo.","poem":1},{"lineBreak":true},{"text":"Antre nan palè li yo, pou ou kab","poem":1},{"lineBreak":true},{"text":"pale jenerasyon k ap vini an.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Paske Bondye se Bondye pa nou an jis pou tout tan.","poem":1},{"lineBreak":true},{"text":"Li va gide nou jiska lanmò.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}