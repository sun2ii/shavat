{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":5,"content":[{"type":"hebrew_subtitle","content":["Pou Direktè koral yo; fèt pou akonpanye ak flit. Yon Sòm David."]},{"type":"verse","number":1,"content":[{"text":"Prete zòrèy Ou a pawòl mwen yo, O SENYÈ.","poem":1},{"lineBreak":true},{"text":"Konsidere refleksyon mwen yo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Koute bri kri sekou mwen yo,","poem":1},{"lineBreak":true},{"text":"Wa mwen e Bondye mwen.","poem":1},{"lineBreak":true},{"text":"Pou Ou menm, mwen ap priye.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nan maten O SENYÈ, Ou va tande vwa mwen.","poem":1},{"lineBreak":true},{"text":"Nan maten mwen va vèse bay Ou lapriyè mwen yo.","poem":1},{"lineBreak":true},{"text":"M aptann, m ap veye.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Paske Ou se pa yon Bondye ki gen plezi nan mechanste.","poem":1},{"lineBreak":true},{"text":"Nanpwen mal ki rete avèk Ou.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sila ki plen ògèy p ap kab kanpe devan zye Ou.","poem":1},{"lineBreak":true},{"text":"Ou rayi tout sila ki fè inikite yo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ou detwi sila ki pale sa ki fo yo.","poem":1},{"lineBreak":true},{"text":"SENYÈ a rayi yon nonm ki vèse san,","poem":1},{"lineBreak":true},{"text":"ki twonpe moun.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Men pou mwen, pa gran lanmou","poem":1},{"lineBreak":true},{"text":"dous Ou a mwen va antre lakay Ou.","poem":1},{"lineBreak":true},{"text":"Nan tanp sen Ou an mwen va pwostène","poem":1},{"lineBreak":true},{"text":"mwen nèt an adorasyon.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O SENYÈ, mennen m nan ladwati Ou akoz lènmi mwen yo.","poem":1},{"lineBreak":true},{"text":"Fè chemen Ou dwat devan mwen.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nanpwen anyen stab nan pawòl pa yo.","poem":1},{"lineBreak":true},{"text":"Anndan yo se pouriti menm.","poem":1},{"lineBreak":true},{"text":"Gòj yo se yon tonm ki louvri.","poem":1},{"lineBreak":true},{"text":"Yo fè flatè ak lang yo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kenbe yo koupab, O Bondye.","poem":1},{"lineBreak":true},{"text":"Selon pwòp manèv pa yo, kite yo tonbe!","poem":1},{"lineBreak":true},{"text":"Nan fòs kantite peche yo pouse yo deyò, paske se rebèl yo ye kont Ou.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Men kite tout sila ki pran refij nan Ou yo, fè kè kontan.","poem":1},{"lineBreak":true},{"text":"Kite yo toujou chante ak kè kontan,","poem":1},{"lineBreak":true},{"text":"akoz Ou fè abri pou yo.","poem":1},{"lineBreak":true},{"text":"Kite sila ki renmen non Ou yo kapab","poem":1},{"lineBreak":true},{"text":"fè kè kontan nan Ou.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Paske se Ou menm ki beni nonm ki dwat la, O SENYÈ,","poem":1},{"lineBreak":true},{"text":"Ou ki antoure li avèk gras Ou,","poem":1},{"lineBreak":true},{"text":"tankou yon boukliye.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}