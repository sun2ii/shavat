{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":52,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la. Yon Sòm David, lè Doeg, Edomit lan te vin di Saül “David gen tan rive lakay Achimélic.”"]},{"type":"verse","number":1,"content":[{"text":"Poukisa ou ògeye nan mechanste ou, O lòm pwisan?","poem":1},{"lineBreak":true},{"text":"Lanmou dous Bondye a dire tout lajounen.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lang ou envante destriksyon,","poem":1},{"lineBreak":true},{"text":"tankou yon razwa ki file, plen desepsyon.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ou renmen mechanste plis pase sa ki bon.","poem":1},{"lineBreak":true},{"text":"Fo bagay plis pase pale verite a.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ou renmen tout pawòl ki devore,","poem":1},{"lineBreak":true},{"text":"yon lang mantè.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Men Bondye va kase fè ou desann nèt;","poem":1},{"lineBreak":true},{"text":"Li va kenbe ou byen vit e chire fè ou","poem":1},{"lineBreak":true},{"text":"sòti nan tant ou an,","poem":1},{"lineBreak":true},{"text":"Epi dechouke fè ou sòti nan peyi vivan yo. Tan","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Moun dwat yo va wè, va gen lakrent;","poem":1},{"lineBreak":true},{"text":"yo va ri sou li epi di:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"“Gade byen, men nonm ki refize pran refij nan Bondye a,","poem":1},{"lineBreak":true},{"text":"men ki te mete konfyans nan abondans richès li yo.","poem":1},{"lineBreak":true},{"text":"Li te ranfòse tèt li ak mechanste.”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Men pou mwen menm, mwen tankou yon pye doliv vèt lakay Bondye.","poem":1},{"lineBreak":true},{"text":"Mwen mete konfyans mwen nan lanmou dous Bondye a","poem":1},{"lineBreak":true},{"text":"pou tout tan e pou tout tan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mwen va bay Ou remèsiman pou tout tan, paske Ou te fè sa.","poem":1},{"lineBreak":true},{"text":"Mwen va mete espwa nan non Ou,","poem":1},{"lineBreak":true},{"text":"paske sa bon nan prezans a fidèl Ou yo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}