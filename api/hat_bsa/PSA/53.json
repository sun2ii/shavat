{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":53,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la; selon mizik Mahalath"]},{"type":"hebrew_subtitle","content":["Yon refleksyon pa David"]},{"type":"verse","number":1,"content":[{"text":"Moun fou a di nan kè li: “Nanpwen Bondye”.","poem":1},{"lineBreak":true},{"text":"Yo konwonpi!","poem":1},{"lineBreak":true},{"text":"Yo fè zak enjis ki abominab.","poem":1},{"lineBreak":true},{"text":"Nanpwen ki fè sa ki bon.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bondye te gade anba soti nan syèl la sou fis a lòm yo,","poem":1},{"lineBreak":true},{"text":"pou wè si genyen youn ki gen bon konprann, ka p chache Bondye.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yo tout te vire akote.","poem":1},{"lineBreak":true},{"text":"Ansanm yo vin konwonpi.","poem":1},{"lineBreak":true},{"text":"Nanpwen nan yo ki fè byen, pa menm youn.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Èske malfektè a mechanste sila yo pa gen okenn konesans,","poem":1},{"lineBreak":true},{"text":"ka p manje pèp Mwen an konsi se pen yo manje,","poem":1},{"lineBreak":true},{"text":"epi ki pa rele Bondye?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"La, yo te nan gwo laperèz kote pa te gen laperèz,","poem":1},{"lineBreak":true},{"text":"paske Bondye te gaye zo a sila ki fè kan kont ou yo.","poem":1},{"lineBreak":true},{"text":"Ou te fè yo vin wont, akoz Bondye te rejte yo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"O ke delivrans Israël ta parèt sòti Sion!","poem":1},{"lineBreak":true},{"text":"Lè Bondye restore pèp kaptif Li a,","poem":1},{"lineBreak":true},{"text":"kite Jacob rejwi, kite Israël fè kè kontan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}