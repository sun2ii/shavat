{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la; sou enstriman ak kòd yo. Yon sòm"]},{"type":"hebrew_subtitle","content":["a David, lè Zifyen yo te vin di Saül: “Èske David pa kache pami nou?”"]},{"type":"verse","number":1,"content":[{"text":"Sove mwen, O Bondye, ak non Ou","poem":1},{"lineBreak":true},{"text":"e fè vanjans mwen ak pouvwa Ou.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Koute lapriyè mwen, O Bondye.","poem":1},{"lineBreak":true},{"text":"Prete zòrèy a pawòl a bouch mwen.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Paske etranje yo fin leve kont mwen.","poem":1},{"lineBreak":true},{"text":"Moun vyolans yo te chache lavi mwen.","poem":1},{"lineBreak":true},{"text":"Yo pa t mete Bondye devan yo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gade byen, Bondye se èd mwen.","poem":1},{"lineBreak":true},{"text":"SENYÈ a se soutyen a nanm mwen.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Li va rekonpanse mal a lènmi mwen yo.","poem":1},{"lineBreak":true},{"text":"Detwi yo nan fidelite Ou.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Avèk bòn volonte, mwen va fè sakrifis a Ou.","poem":1},{"lineBreak":true},{"text":"Mwen va bay remèsiman a non Ou, O SENYÈ, paske li bon.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Paske Li te delivre mwen nan tout twoub.","poem":1},{"lineBreak":true},{"text":"Konsa, zye mwen te wè ak kè kontan, defèt lènmi m yo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}