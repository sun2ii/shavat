{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":56,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la. Yon powèm David lè Filisten yo te sezi li Gath."]},{"type":"hebrew_subtitle","content":["Chante pa melodi “Toutrèl San Chanson Nan Peyi Lwen An”"]},{"type":"verse","number":1,"content":[{"text":"Fè m gras, O Bondye, paske lòm fin foule m anba pye;","poem":1},{"lineBreak":true},{"text":"Nan goumen tout lajounen, li vin oprime mwen.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lènmi m yo vle vale m tout lajounen.","poem":1},{"lineBreak":true},{"text":"Yo anpil! Tout sila ki goumen ak ògèy kont mwen yo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lè mwen pè, mwen va mete konfyans nan Ou.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nan Bondye, mwen fè lwanj pawòl Li!","poem":1},{"lineBreak":true},{"text":"Nan Bondye, mwen te mete konfyans mwen.","poem":1},{"lineBreak":true},{"text":"Mwen p ap pè.","poem":1},{"lineBreak":true},{"text":"Kisa lòm ka fè m?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tout lajounen, yo tòde pawòl mwen yo.","poem":1},{"lineBreak":true},{"text":"Tout panse yo kont mwen se pou mal.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yo atake, yo kache, yo veye pa mwen yo.","poem":1},{"lineBreak":true},{"text":"Y ap tann pou rache lavi m.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Akoz mechanste sa a, jete yo deyò.","poem":1},{"lineBreak":true},{"text":"Nan kòlè Ou, fè desann moun sa yo, O Bondye!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ou te byen konte tout egare mwen fè.","poem":1},{"lineBreak":true},{"text":"Mete tout gout dlo ki sòti nan zye m yo nan boutèy Ou.","poem":1},{"lineBreak":true},{"text":"Èske yo tout pa ekri nan liv Ou a?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Konsa, lènmi mwen yo va vire fè bak nan jou ke m rele a.","poem":1},{"lineBreak":true},{"text":"Men sa m byen konnen: Bondye pou mwen.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nan Bondye, ma louwe pawòl li.","poem":1},{"lineBreak":true},{"text":"Nan SENYÈ a, ma louwe pawòl li.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nan Bondye, mwen te mete konfyans mwen.","poem":1},{"lineBreak":true},{"text":"Mwen p ap pè. Kisa lòm ka fè m?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ve Ou yo mare sou mwen, O Bondye.","poem":1},{"lineBreak":true},{"text":"Mwen va rann ofrann remèsiman a Ou menm.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Paske Ou te delivre nanm mwen soti nan lanmò.","poem":1},{"lineBreak":true},{"text":"Ou te anpeche pye mwen glise tonbe,","poem":1},{"lineBreak":true},{"text":"pou m ta kab mache devan Bondye","poem":1},{"lineBreak":true},{"text":"nan limyè a moun vivan yo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}