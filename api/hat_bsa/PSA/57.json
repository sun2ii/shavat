{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":57,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la; jwe a son Al-tashheth"]},{"type":"hebrew_subtitle","content":["Yon Mikhtam David, lè l te sove ale devan Saül nan kav la"]},{"type":"verse","number":1,"content":[{"text":"Fè m gras, SENYÈ, O Bondye, fè m gras,","poem":1},{"lineBreak":true},{"text":"paske nanm mwen kache nan Ou.","poem":1},{"lineBreak":true},{"text":"Wi, nan lonbraj a zèl Ou, mwen va kache,","poem":1},{"lineBreak":true},{"text":"jiskaske destriksyon an fin pase.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mwen va kriye a Bondye Pi Wo a,","poem":1},{"lineBreak":true},{"text":"a Bondye ki acheve tout sa m mande an.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Li va voye sòti nan syèl la pou sove mwen.","poem":1},{"lineBreak":true},{"text":"Li fè repwòch a sila ki foule mwen an. Tan","poem":1},{"lineBreak":true},{"text":"Bondye va voye fè rive lanmou dous Li ak verite Li.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nanm mwen rete pami lyon yo.","poem":1},{"lineBreak":true},{"text":"Mwen oblije kouche pami sila k ap respire dife yo.","poem":1},{"lineBreak":true},{"text":"Fis a lòm yo menm ak dan kon frenn file,","poem":1},{"lineBreak":true},{"text":"epi lang yo kon yon epe file.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Leve anwo syèl yo, O Bondye;","poem":1},{"lineBreak":true},{"text":"Kite glwa Ou vin pi wo sou tout latè!","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yo te prepare yon gwo filè pou pa mwen yo;","poem":1},{"lineBreak":true},{"text":"Nanm mwen koube ba.","poem":1},{"lineBreak":true},{"text":"Yo te fouye yon fòs devan m.","poem":1},{"lineBreak":true},{"text":"Yo te tonbe nan mitan li. Tan","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kè m kanpe fèm, O Bondye,","poem":1},{"lineBreak":true},{"text":"kè m fèm.","poem":1},{"lineBreak":true},{"text":"Mwen va chante, wi mwen va chante lwanj!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Leve, glwa mwen! Leve ap avèk gita!","poem":1},{"lineBreak":true},{"text":"Mwen va fè maten vin leve.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mwen va bay Ou remèsiman, O SENYÈ, pami pèp yo.","poem":1},{"lineBreak":true},{"text":"Mwen va chante lwanj ou pami nasyon yo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Paske lanmou dous Ou a gran jis rive nan syèl yo,","poem":1},{"lineBreak":true},{"text":"epi verite Ou jis rive nan nwaj yo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Leve anwo syèl yo, O Bondye.","poem":1},{"lineBreak":true},{"text":"Ke Glwa Ou kapab vin pi wo ke tout latè.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}