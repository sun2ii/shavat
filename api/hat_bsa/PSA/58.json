{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":58,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la; Nan melodi la “Pa Detwi”. Yon Sòm David"]},{"type":"verse","number":1,"content":[{"text":"Vrèman, èske nou pale ladwati, O lòt dye yo?","poem":1},{"lineBreak":true},{"text":"Èske nou jije san fòt, O fis a lòm yo?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Non, nan kè, nou fòmante inikite.","poem":1},{"lineBreak":true},{"text":"Sou latè, nou peze balans pou separe","poem":1},{"lineBreak":true},{"text":"bay vyolans ak men nou.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mechan yo pèvès depi nan vant.","poem":1},{"lineBreak":true},{"text":"Sila ki bay manti yo fè move wout depi nesans yo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yo gen pwazon tankou pwazon sèpan.","poem":1},{"lineBreak":true},{"text":"Kon vipè soud ki bouche zòrèy li,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"pou li pa tande vwa a sila k ap chame li yo,","poem":1},{"lineBreak":true},{"text":"malgre se yon majisyen abil k ap fè wanga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"O Bondye, kraze dan nan bouch yo!","poem":1},{"lineBreak":true},{"text":"Kase gwo dan a jenn lyon an, O SENYÈ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kite yo koule disparèt tankou dlo k ap kouri sou tè.","poem":1},{"lineBreak":true},{"text":"Lè flèch li yo parèt, kite yo fèt tankou shaf san tèt.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kite yo tankou kalmason ki fonn,","poem":1},{"lineBreak":true},{"text":"ki vin disparèt pandan l ap mache,","poem":1},{"lineBreak":true},{"text":"tankou avòtman a yon fanm ki p ap janm wè solèy la.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Avan chodyè ou yo kab santi dife pikan yo,","poem":1},{"lineBreak":true},{"text":"Li va bale yo fè yo disparèt nan van toubiyon;","poem":1},{"lineBreak":true},{"text":"vèt ak sila kap brile yo, ansanm.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Moun ladwati a va rejwi lè l wè vanjans lan.","poem":1},{"lineBreak":true},{"text":"Li va lave pye li nan san a mechan yo,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"pou moun yo di: “Anverite, gen yon rekonpans pou moun ladwati yo.","poem":1},{"lineBreak":true},{"text":"Anverite, genyen yon Bondye k ap jije latè!”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}