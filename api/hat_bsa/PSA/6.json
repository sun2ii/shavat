{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":6,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la; avèk enstriman ak fil yo sou yon gita uit kòd."]},{"type":"hebrew_subtitle","content":["Yon sòm David."]},{"type":"verse","number":1,"content":[{"text":"O SENYÈ, pa repwoche mwen nan kòlè Ou,","poem":1},{"lineBreak":true},{"text":"ni ba m chatiman nan fachez Ou.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fè m gras, O SENYÈ, paske mwen","poem":1},{"lineBreak":true},{"text":"chagren anpil.","poem":1},{"lineBreak":true},{"text":"Geri mwen, O SENYÈ, paske zo m yo rele anmwey,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"epi nanm mwen fè gwo chagren.","poem":1},{"lineBreak":true},{"text":"Men Ou, O SENYÈ,—jiskilè?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Retounen, O SENYÈ, fè nanm mwen chape.","poem":1},{"lineBreak":true},{"text":"Sove mwen akoz lanmou dous Ou a.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Paske mò yo pa rele non Ou.","poem":1},{"lineBreak":true},{"text":"Nan andwa kote mò yo ye a,","poem":1},{"lineBreak":true},{"text":"se kilès k ap bay Ou remèsiman?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mwen bouke ak plent ki sòti anndan m.","poem":1},{"lineBreak":true},{"text":"Chak nwit, kabann mwen vin naje ak dlo.","poem":1},{"lineBreak":true},{"text":"Dlo ki sòt nan zye m yo fin gate kabann nan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Zye m pouri nèt ak gwo doulè.","poem":1},{"lineBreak":true},{"text":"Yo vin vye nèt akoz tout advèsè mwen yo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sòti sou mwen, nou tout ki fè mechanste yo,","poem":1},{"lineBreak":true},{"text":"paske SENYÈ a te tande gwo kri mwen.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"SENYÈ a te tande demand priyè mwen.","poem":1},{"lineBreak":true},{"text":"SENYÈ a te resevwa lapriyè mwen.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tout lènmi mwen yo va wont e deranje nèt.","poem":1},{"lineBreak":true},{"text":"Yo va vire fè bak sibitman.","poem":1},{"lineBreak":true},{"text":"Yo va vin wont anpil.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}