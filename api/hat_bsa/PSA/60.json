{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":60,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la; selon melodi “Lis Akò La”."]},{"type":"hebrew_subtitle","content":["Yon powèm David, pou enstwi; lè l te lite avèk Aram-Naharaim e avèk Aram-Zobah; epi, Joab te retounen e te frape douz-mil Edomit nan Vale Sèl la."]},{"type":"verse","number":1,"content":[{"text":"O Bondye, Ou te rejte nou.","poem":1},{"lineBreak":true},{"text":"Ou te kraze nou.","poem":1},{"lineBreak":true},{"text":"Ou te fache.","poem":1},{"lineBreak":true},{"text":"O restore nou ankò.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ou te fè latè tranble.","poem":1},{"lineBreak":true},{"text":"Ou te fann li pou l ouvri.","poem":1},{"lineBreak":true},{"text":"Geri brèch li yo, paske l ap sekwe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ou te fè pèp Ou a wè anpil bagay di.","poem":1},{"lineBreak":true},{"text":"Ou te bay nou diven pou bwè ki fè nou toudi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ou te bay yon drapo pou sila ki gen lakrent Ou yo,","poem":1},{"lineBreak":true},{"text":"pou fè l byen parèt akoz verite a. Tan","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Pou byeneme Ou yo kab delivre,","poem":1},{"lineBreak":true},{"text":"Sove avèk men dwat Ou e reponn nou!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bondye te pale nan sentete Li:","poem":1},{"lineBreak":true},{"text":"“Mwen va triyonfe!","poem":1},{"lineBreak":true},{"text":"Mwen va divize Sichem","poem":1},{"lineBreak":true},{"text":"e tire yon lin nan vale Succoth la.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Galaad se pou Mwen e Manassé se pa M.","poem":1},{"lineBreak":true},{"text":"Anplis, Éphraïm se kas sou tèt Mwen.","poem":1},{"lineBreak":true},{"text":"Juda se baton wayal Mwen an.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Moab se basen lave Mwen.","poem":1},{"lineBreak":true},{"text":"Sou Edom, Mwen va jete soulye Mwen.","poem":1},{"lineBreak":true},{"text":"Mwen rele viktwa sou peye Filisten yo.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kilès k ap fè m rive nan vil fòterès la?","poem":1},{"lineBreak":true},{"text":"Kilès k ap mennen mwen antre Edom?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Èske Ou menm, SENYÈ a, pa t rejte nou?","poem":1},{"lineBreak":true},{"text":"Epi èske Ou p ap sòti avèk lame nou yo, O Bondye?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"O bannou sekou kont advèsè a,","poem":1},{"lineBreak":true},{"text":"paske delivrans pa lòm se an ven.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nan Bondye, nou va fè bèl bagay yo ak gwo kouraj.","poem":1},{"lineBreak":true},{"text":"Se Li menm ki va foule lènmi nou yo anba pye.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":12}