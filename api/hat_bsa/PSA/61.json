{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la; sou yon enstriman a kòd; Yon Sòm David"]},{"type":"verse","number":1,"content":[{"text":"Koute kri mwen, O Bondye.","poem":1},{"lineBreak":true},{"text":"Prete atansyon a lapriyè mwen.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Soti nan dènye pwent latè,","poem":1},{"lineBreak":true},{"text":"mwen rele Ou lè kè m fèb;","poem":1},{"lineBreak":true},{"text":"Mennen mwen sou wòch","poem":1},{"lineBreak":true},{"text":"ki pi wo pase m nan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Paske Ou te yon refij pou mwen,","poem":1},{"lineBreak":true},{"text":"yon fò ki wo,","poem":1},{"lineBreak":true},{"text":"yon gran fòs kont lènmi yo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kite mwen rete nan tant Ou an jis pou tout tan.","poem":1},{"lineBreak":true},{"text":"Kite mwen pran refij anba zèl Ou. Tan","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Paske Ou te koute ve mwen yo, O Bondye.","poem":1},{"lineBreak":true},{"text":"Ou te ban mwen eritaj a sila ki gen krent non Ou yo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ou va fè lavi a wa a byen long.","poem":1},{"lineBreak":true},{"text":"Ane li yo va tankou anpil jenerasyon.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Li va abite devan SENYÈ a jis pou tout tan.","poem":1},{"lineBreak":true},{"text":"Senyè, bay li lanmou dous avèk verite pou li kapab andire.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Konsa, mwen va chante lwanj Ou jis pou tout tan.","poem":1},{"lineBreak":true},{"text":"Konsa, m kapab peye ve mwen yo jou apre jou.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}