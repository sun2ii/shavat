{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":62,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la; selon Jeduthun; Yon Sòm David"]},{"type":"verse","number":1,"content":[{"text":"Nanm mwen ap poze sèl nan Bondye.","poem":1},{"lineBreak":true},{"text":"Sali m se nan Li.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Se Li sèl ki wòch mwen, sali mwen, ak sitadèl mwen.","poem":1},{"lineBreak":true},{"text":"Menm gwo sò pa p boulvèse m.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pou jiskilè, nou va atake yon nonm?","poem":1},{"lineBreak":true},{"text":"Alò, èske nou ta touye li, nou tout,","poem":1},{"lineBreak":true},{"text":"tankou yon miray k ap panche?","poem":1},{"lineBreak":true},{"text":"Tankou yon kloti k ap kraze?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yo plen entansyòn pou pouse li soti nan wo pozisyon li.","poem":1},{"lineBreak":true},{"text":"Yo pran plezi nan tout sa ki fo.","poem":1},{"lineBreak":true},{"text":"Yo beni avèk bouch yo, men anndan yo bay madichon.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nanm mwen tann an silans sèlman Bondye.","poem":1},{"lineBreak":true},{"text":"Paske espwa mwen se nan Li.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Li se sèl ki wòch mwen, sali mwen, ak sitadèl mwen.","poem":1},{"lineBreak":true},{"text":"Mwen p ap ebranle menm.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sali mwen an, avèk glwa mwen rete nan Bondye.","poem":1},{"lineBreak":true},{"text":"Wòch fòs mwen an, ak kote pou m kache, se nan Bondye.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mete konfyans nan Li tout tan, O pèp la.","poem":1},{"lineBreak":true},{"text":"Vide kè nou devan Li.","poem":1},{"lineBreak":true},{"text":"Bondye se yon refij pou nou.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Moun nan pozisyon ba yo se se sèl yon souf nan van.","poem":1},{"lineBreak":true},{"text":"Moun ki plase wo yo se manti.","poem":1},{"lineBreak":true},{"text":"Nan pèz balans yo, se monte, yap monte.","poem":1},{"lineBreak":true},{"text":"Ansanm menm, yo pi fay ke yon souf.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pa mete konfyans nan peze kou moun desann.","poem":1},{"lineBreak":true},{"text":"Ni pa mete fo espwa nan vòlè.","poem":1},{"lineBreak":true},{"text":"Si richès nou ogmante, pa mete kè nou sou yo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yon fwa, Bondye te pale.","poem":1},{"lineBreak":true},{"text":"De fwa, mwen gen tan tande sa:","poem":1},{"lineBreak":true},{"text":"Ke pouvwa, se pou Bondye.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Epi anplis, lanmou dous se pou Ou, O Senyè.","poem":1},{"lineBreak":true},{"text":"Paske Ou bay rekonpans a lòm selon","poem":1},{"lineBreak":true},{"text":"zèv li yo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}