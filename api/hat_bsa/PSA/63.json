{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"hebrew_subtitle","content":["Yon Sòm David, lè l te nan dezè Juda a."]},{"type":"verse","number":1,"content":[{"text":"O Bondye, Ou se Bondye mwen.","poem":1},{"lineBreak":true},{"text":"Mwen va chache Ou ak tout kè m.","poem":1},{"lineBreak":true},{"text":"Nanm mwen swaf pou Ou.","poem":1},{"lineBreak":true},{"text":"Chè m anvi Ou nan yon peyi epwize e sèch kote nanpwen dlo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Konsa, mwen te wè Ou nan sanktiyè a,","poem":1},{"lineBreak":true},{"text":"ak pouvwa Ou, ak laglwa Ou.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Akoz lanmou dous Ou pi bon pase lavi,","poem":1},{"lineBreak":true},{"text":"lèv mwen va louwe Ou.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pou sa, mwen va beni Ou tout tan ke m viv.","poem":1},{"lineBreak":true},{"text":"Mwen va leve men m nan non Ou.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nanm mwen satisfè konsi avèk ma zo ak grès,","poem":1},{"lineBreak":true},{"text":"e bouch mwen ap ofri lwanj","poem":1},{"lineBreak":true},{"text":"avèk lèv ranpli de jwa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lè m sonje Ou sou kabann mwen,","poem":1},{"lineBreak":true},{"text":"mwen medite sou Ou nan vèy de nwi la.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Paske Ou te konn sekou mwen.","poem":1},{"lineBreak":true},{"text":"Nan lonbraj a zèl Ou, mwen chante ak jwa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nanm mwen kole ak Ou.","poem":1},{"lineBreak":true},{"text":"Men dwat Ou fè m kenbe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Men sila ki chache lavi mwen pou detwi li yo,","poem":1},{"lineBreak":true},{"text":"va desann jis nan fon latè.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yo va livre a pouvwa nepe.","poem":1},{"lineBreak":true},{"text":"Yo va tounen manje pou rena mawon.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Men Wa a va rejwi nan Bondye.","poem":1},{"lineBreak":true},{"text":"Tout moun ki sèmante pa Li menm yo, va twouve glwa.","poem":1},{"lineBreak":true},{"text":"Paske bouch a sila ki bay manti yo, va fèmen.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}