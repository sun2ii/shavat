{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":64,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la. Yon Sòm David."]},{"type":"verse","number":1,"content":[{"text":"Tande vwa m, O Bondye nan plent mwen an.","poem":1},{"lineBreak":true},{"text":"Konsève lavi m kont laperèz lènmi an.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pwoteje m kont konsèy sekrè a malfektè yo,","poem":1},{"lineBreak":true},{"text":"kont boulvèsman a sila ki fè mechanste yo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ki te file lang yo tankou nepe.","poem":1},{"lineBreak":true},{"text":"Yo te pwente flèch pawòl anmè yo,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"pou tire an kachèt sou sila ki inosan yo.","poem":1},{"lineBreak":true},{"text":"Sibitman yo tire sou li, san lakrent.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yo kenbe fèm a pwòp desen mechan yo.","poem":1},{"lineBreak":true},{"text":"Yo pale sou pyèj ke y ap fòme an sekrè yo.","poem":1},{"lineBreak":true},{"text":"Yo di: “Se kilès ki kab wè yo?”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yo fè manèv pou enjistis e di:","poem":1},{"lineBreak":true},{"text":"“Nou prè pou yon konplo byen fòme”.","poem":1},{"lineBreak":true},{"text":"Paske panse lenteryè a moun se byen fon.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Men Bondye va tire sou yo avèk yon flèch.","poem":1},{"lineBreak":true},{"text":"Sibitman, yo va blese.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Konsa, yo va chape tonbe.","poem":1},{"lineBreak":true},{"text":"Pwòp lang pa yo va kont yo.","poem":1},{"lineBreak":true},{"text":"Tout moun ki wè yo va souke tèt yo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nan moman sa a, tout moun va krent.","poem":1},{"lineBreak":true},{"text":"Konsa, yo va deklare zèv Bondye yo.","poem":1},{"lineBreak":true},{"text":"Ak sajès yo va konsidere sa Li te fè a.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nonm ladwati a va kontan nan SENYÈ a!","poem":1},{"lineBreak":true},{"text":"Yo va pran refij nan Li,","poem":1},{"lineBreak":true},{"text":"epi tout moun dwat yo va fè kè kontan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}