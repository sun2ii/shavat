{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":65,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la; yon Sòm David. Yon chan."]},{"type":"verse","number":1,"content":[{"text":"Se lwanj k ap tan Ou, O Bondye nan Sion.","poem":1},{"lineBreak":true},{"text":"Ve yo va fèt anvè Ou.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O Ou menm ki tande priyè yo,","poem":1},{"lineBreak":true},{"text":"a Ou menm tout moun vini.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Inikite m t ap kanpe kont mwen;","poem":1},{"lineBreak":true},{"text":"men pou transgresyon nou yo,","poem":1},{"lineBreak":true},{"text":"Ou kouvri yo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A la beni se sila ke Ou chwazi a e mennen toupre,","poem":1},{"lineBreak":true},{"text":"pou l ka rete nan lakou Ou.","poem":1},{"lineBreak":true},{"text":"Nou va satisfè ak tout bagay ki bon lakay Ou,","poem":1},{"lineBreak":true},{"text":"sen tanp Ou a.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Avèk zèv mèvèy e dwat, Ou reponn nou,","poem":1},{"lineBreak":true},{"text":"O Bondye sali nou an.","poem":1},{"lineBreak":true},{"text":"Se Ou menm ki espwa tout pwen latè a,","poem":1},{"lineBreak":true},{"text":"jis rive nan lanmè pi lwen an.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ki etabli mòn yo pa pwisans Ou,","poem":1},{"lineBreak":true},{"text":"Akoz Ou pran zam pwisans Ou.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ou kalme raj vag lanmè yo,","poem":1},{"lineBreak":true},{"text":"Avèk gwo boulvèsman lanm yo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sila ki rete jis nan dènye pwent latè yo","poem":1},{"lineBreak":true},{"text":"kanpe byen etone a mèvèy Ou yo.","poem":1},{"lineBreak":true},{"text":"Ou fè maten avèk aswè kriye ak jwa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ou vizite tè a e fè li gen abondans.","poem":1},{"lineBreak":true},{"text":"Ou anrichi li anpil.","poem":1},{"lineBreak":true},{"text":"Flèv Bondye a plen ak dlo.","poem":1},{"lineBreak":true},{"text":"Ou prepare sereyal yo, paske se konsa ou oganizè l.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ou wouze tranch li yo an abondans.","poem":1},{"lineBreak":true},{"text":"Ou fè do li vin poze.","poem":1},{"lineBreak":true},{"text":"Ou fè l vin mou ak lapli an abondans;","poem":1},{"lineBreak":true},{"text":"Ou beni kwasans plant li.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ou te kouwone ane a avèk bonte Ou.","poem":1},{"lineBreak":true},{"text":"Kabwa yo plen pwodwi rekòlt la.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Patiraj nan dezè yo gen abondans,","poem":1},{"lineBreak":true},{"text":"Epi kolin yo mare senti yo ak jwa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Chan yo abiye menm ak bann mouton.","poem":1},{"lineBreak":true},{"text":"Vale yo fin ranpli ak sereyal.","poem":1},{"lineBreak":true},{"text":"Yo rele fò ak lajwa!","poem":1},{"lineBreak":true},{"text":"Konsa, yo chante.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}