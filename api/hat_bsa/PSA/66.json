{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":66,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la; yon chan, yon Sòm"]},{"type":"verse","number":1,"content":[{"text":"Rele fò ak lajwa a Bondye, tout latè a!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chante glwa a non Li!","poem":1},{"lineBreak":true},{"text":"Ranpli lwanj Li ak laglwa!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Di Bondye: “Zèv Ou yo mèvèye”!","poem":1},{"lineBreak":true},{"text":"Akoz grandè a pwisans Ou, menm,","poem":1},{"lineBreak":true},{"text":"lènmi Ou yo va soumèt a Ou.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tout latè va fè adorasyon a Ou menm.","poem":1},{"lineBreak":true},{"text":"Li va chante lwanj Ou.","poem":1},{"lineBreak":true},{"text":"Tout va chante lwanj a non Ou; Tan","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Vini pou wè zèv Bondye yo.","poem":1},{"lineBreak":true},{"text":"Zèv etonnan anvè fis a lòm yo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Li te chanje lanmè a an tè sèch.","poem":1},{"lineBreak":true},{"text":"Yo te pase travèse rivyè apye.","poem":1},{"lineBreak":true},{"text":"La menm, nou te rejwi nan Li!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Li renye ak pwisans pou tout tan.","poem":1},{"lineBreak":true},{"text":"Zye Li veye sou nasyon yo.","poem":1},{"lineBreak":true},{"text":"Pa kite rebèl yo egzalte kont Li.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Beni Bondye nou an, O pèp yo!","poem":1},{"lineBreak":true},{"text":"Fè lwanj Li sone,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ki kenbe nou pami vivan yo,","poem":1},{"lineBreak":true},{"text":"e ki pa kite pye nou glise.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Paske Ou te fè nou pase a leprèv, O Bondye.","poem":1},{"lineBreak":true},{"text":"Ou te rafine nou tankou ajan konn rafine.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ou te rale nou antre nan filè a.","poem":1},{"lineBreak":true},{"text":"Ou te mete yon fado lou sou ren nou.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ou te fè moun monte sou tèt nou.","poem":1},{"lineBreak":true},{"text":"Nou te pase nan dife ak nan dlo,","poem":1},{"lineBreak":true},{"text":"men Ou te fè nou sòti antre yon kote avèk anpil abondans.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mwen va vini lakay Ou avèk Ofrann brile.","poem":1},{"lineBreak":true},{"text":"Mwen va peye Ou ve mwen yo,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ki te sòti nan lèv mwen,","poem":1},{"lineBreak":true},{"text":"ke bouch mwen te pale lè m te nan gwo twoub yo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mwen va ofri a Ou menm yon ofrann brile nan grès a bèt gra yo,","poem":1},{"lineBreak":true},{"text":"avèk lafimen a belye yo.","poem":1},{"lineBreak":true},{"text":"Mwen va fè ofrann a towo yo avèk mal kabrit yo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Vin tande, nou tout ki gen lakrent Bondye","poem":1},{"lineBreak":true},{"text":"e mwen va pale ou tout sa Li te fè pou nanm mwen.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mwen te kriye a Li menm avèk bouch mwen.","poem":1},{"lineBreak":true},{"text":"Ak lang mwen, mwen te leve Li wo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Si mwen gade inikite nan kè m,","poem":1},{"lineBreak":true},{"text":"Senyè a p ap koute mwen.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Men anverite, Bondye te tande.","poem":1},{"lineBreak":true},{"text":"Li te teni kont de vwa a priyè mwen.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Beni se Bondye, ki pa t refize koute","poem":1},{"lineBreak":true},{"text":"lapriyè mwen,","poem":1},{"lineBreak":true},{"text":"ni ki pa t kache lanmou dous Li a sou mwen.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}