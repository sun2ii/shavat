aflije e mwen nan nesesite.","poem":1},{"lineBreak":true},{"text":"Fè vit vin kote mwen, O Bondye!","poem":1},{"lineBreak":true},{"text":"Se Ou menm ki sekou mwen ak delivrans mwen.","poem":1},{"lineBreak":true},{"text":"O SENYÈ, pa mize.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}