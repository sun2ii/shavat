{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":75,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la; pou jwe a melodi “Pa Detwi”"]},{"type":"hebrew_subtitle","content":["Yon Sòm Asaph, yon Chanson"]},{"type":"verse","number":1,"content":[{"text":"Nou bay remèsiman a Ou menm, O Bondye,","poem":1},{"lineBreak":true},{"text":"Nou bay remèsiman, paske Non Ou toupre.","poem":1},{"lineBreak":true},{"text":"Moun yo fè deklarasyon zèv mèvèy Ou yo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Lè Mwen menm fikse yon tan ki apwente,","poem":1},{"lineBreak":true},{"text":"Mwen va jije avèk jistis.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Latè avèk tout sa ki ladann souke.","poem":1},{"lineBreak":true},{"text":"Se Mwen menm ki kenbe pilye li yo.” Tan","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mwen te di a awogan yo: “Pa vin ògeye!”","poem":1},{"lineBreak":true},{"text":"A mechan an: “Pa leve kòn nan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pa leve kòn ou anwo.","poem":1},{"lineBreak":true},{"text":"Pa pale kou rèd avèk ògèy ensolan.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Paske ni sòti nan lès, ni nan lwès,","poem":1},{"lineBreak":true},{"text":"ni bò kote dezè a,","poem":1},{"lineBreak":true},{"text":"kab gen fòs pou leve moun anwo;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Men Bondye se jij la.","poem":1},{"lineBreak":true},{"text":"Li fè yon moun desann,","poem":1},{"lineBreak":true},{"text":"e li leve yon lòt fè l wo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Paske gen yon tas nan men SENYÈ a,","poem":1},{"lineBreak":true},{"text":"e diven an ap kimen.","poem":1},{"lineBreak":true},{"text":"Li byen mele e Bondye vide fè l sòti ladann.","poem":1},{"lineBreak":true},{"text":"Anverite, tout mechan yo oblije bwè l jis rive nan dènye ti gout li.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Men pou mwen, mwen va deklare sa, jis pou tout tan.","poem":1},{"lineBreak":true},{"text":"Mwen va chante lwanj a Bondye Jacob la.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tout kòn a mechan yo, Mwen va koupe fè yo sòti nèt.","poem":1},{"lineBreak":true},{"text":"Men kòn a moun ladwati yo va leve wo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}