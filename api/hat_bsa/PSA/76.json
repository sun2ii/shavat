{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":76,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la; sou enstriman ak kòd"]},{"type":"hebrew_subtitle","content":["Yon Sòm Asaph, yon Chanson"]},{"type":"verse","number":1,"content":[{"text":"Bondye byen rekonèt nan Juda.","poem":1},{"lineBreak":true},{"text":"Non Li gran an Israël.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tabènak Li a nan Salem.","poem":1},{"lineBreak":true},{"text":"Abitasyon Li an osi nan Sion.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"La, Li te kase flèch dife yo,","poem":1},{"lineBreak":true},{"text":"boukliye ak nepe ak zam lagè yo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ou manyifik, pi majeste pase mòn","poem":1},{"lineBreak":true},{"text":"ak bèt lachas yo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sila ak gran kouraj yo te piyaje,","poem":1},{"lineBreak":true},{"text":"yo te fonse tonbe nan dòmi mò a.","poem":1},{"lineBreak":true},{"text":"Okenn nan gèrye yo ka sèvi men yo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nan repwòch Ou, O Bondye Jacob,","poem":1},{"lineBreak":true},{"text":"ni chevalye yo ak cheval la te tonbe nan yon pwofon somèy.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ou menm, Ou merite lakrent.","poem":1},{"lineBreak":true},{"text":"Se kilès ki kab kanpe nan prezans Ou lè Ou fache?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ou te fè jijman tande soti nan syèl la.","poem":1},{"lineBreak":true},{"text":"Latè te krent, e te kanpe rete an plas","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"lè Bondye te leve nan jijman an,","poem":1},{"lineBreak":true},{"text":"pou sove tout enb sou latè yo. Tan","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Paske kòlè a lòm va bay Ou glwa.","poem":1},{"lineBreak":true},{"text":"Se retay kòlè pa W, ki sispann fè mal.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fè ve Ou yo a SENYÈ a, Bondye Ou a e akonpli yo.","poem":1},{"lineBreak":true},{"text":"Kite tout sila ki antoure Li yo","poem":1},{"lineBreak":true},{"text":"mennen don a Sila ki merite lakrent lan.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Li va koupe retire nanm a prens yo.","poem":1},{"lineBreak":true},{"text":"Wa latè yo gen lakrent Li.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}