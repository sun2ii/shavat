{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":81,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la; pou jwe sou Gitia la. Yon Sòm Asaph"]},{"type":"verse","number":1,"content":[{"text":"Chante avèk jwa a Bondye ki se fòs nou!","poem":1},{"lineBreak":true},{"text":"Rele fò ak jwa a Bondye a Jacob la!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Leve yon chan, bat tanbouren an,","poem":1},{"lineBreak":true},{"text":"gita ak son ki dous la ansanm avèk ap la.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sone twonpèt la nan nouvèl lin nan,","poem":1},{"lineBreak":true},{"text":"sou plèn lin nan, nan jou fèt nou an.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Paske se yon règleman Israël,","poem":1},{"lineBreak":true},{"text":"yon òdonans a Bondye Jacob la.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Li te etabli li kon yon temwayaj nan Joseph","poem":1},{"lineBreak":true},{"text":"lè li te ale toupatou nan peyi Égypte la.","poem":1},{"lineBreak":true},{"text":"Mwen te tande yon lang ke M pa t konnen.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mwen te retire fado a sou zepòl li.","poem":1},{"lineBreak":true},{"text":"Men li yo te vin lib panyen an.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ou te rele nan twoub la e Mwen","poem":1},{"lineBreak":true},{"text":"te fè ou sekou.","poem":1},{"lineBreak":true},{"text":"Mwen te reponn Ou nan plas kote tonnè a kache a.","poem":1},{"lineBreak":true},{"text":"Mwen te fè ou pase eprèv nan dlo Meriba yo. Tan","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tande, O pèp Mwen an e Mwen va korije nou.","poem":1},{"lineBreak":true},{"text":"O Israël, si ou ta koute Mwen!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pa kite okenn dye etranje rete pami nou.","poem":1},{"lineBreak":true},{"text":"Ni nou pa pou adore okenn dye etranje.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mwen menm, SENYÈ a, se Bondye nou an,","poem":1},{"lineBreak":true},{"text":"ki te mennen nou sòti nan peyi Égypte la.","poem":1},{"lineBreak":true},{"text":"Ouvri bouch nou byen laj e mwen va ranpli li.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Men pèp Mwen an pa t koute vwa M.","poem":1},{"lineBreak":true},{"text":"Ni Israël pa t obeyi Mwen.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Akoz sa, Mwen te lage yo a kè di yo,","poem":1},{"lineBreak":true},{"text":"pou mache nan pwòp manèv yo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"O ke pèp Mwen an ta koute Mwen,","poem":1},{"lineBreak":true},{"text":"ke Israël ta mache nan vwa Mwen yo!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mwen ta soumèt lènmi yo byen vit","poem":1},{"lineBreak":true},{"text":"e ta vire men m kont advèsè yo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Sila ki rayi SENYÈ yo ta tresayi devan Li menm","poem":1},{"lineBreak":true},{"text":"e pinisyon yo ta pou tout tan.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Men ou menm, Mwen ta nouri ou avèk pi bon kalite ble a.","poem":1},{"lineBreak":true},{"text":"Avèk siwo ki sòti nan wòch, Mwen ta satisfè ou.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}