{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["Yon Sòm Asaph"]},{"type":"verse","number":1,"content":[{"text":"Bondye vin kanpe nan mitan pwòp asanble Li a.","poem":1},{"lineBreak":true},{"text":"Li fè jijman nan mitan dye yo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pou konbyen de tan nou va jije san jistis,","poem":1},{"lineBreak":true},{"text":"e montre favè a mechan yo?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Fè defans fèb yo ak òfelen yo.","poem":1},{"lineBreak":true},{"text":"Fè jistis a aflije ak malere yo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sove fèb yo ak malere yo.","poem":1},{"lineBreak":true},{"text":"Delivre fè yo sòti nan men a mechan yo.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yo pa konnen ni yo pa konprann.","poem":1},{"lineBreak":true},{"text":"Yo mache toupatou nan fènwa.","poem":1},{"lineBreak":true},{"text":"Tout fondasyon tè yo fin souke nèt.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mwen te di: “Se dye ke nou ye,","poem":1},{"lineBreak":true},{"text":"e nou tout se fis a Pi Wo a.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sepandan, nou va mouri tankou moun,","poem":1},{"lineBreak":true},{"text":"e tonbe tankou nenpòt nan prens yo.”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Leve, O Bondye, jije tè a!","poem":1},{"lineBreak":true},{"text":"Paske se Ou ki posede tout nasyon yo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}