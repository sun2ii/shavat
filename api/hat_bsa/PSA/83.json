{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":83,"content":[{"type":"hebrew_subtitle","content":["Yon Chan. Yon Sòm Asaph"]},{"type":"verse","number":1,"content":[{"text":"O Bondye, pa rete an silans.","poem":1},{"lineBreak":true},{"text":"Pa fè silans, O Bondye.","poem":1},{"lineBreak":true},{"text":"Pa rete trankil.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Paske gade byen, lènmi Ou yo ap fè zen.","poem":1},{"lineBreak":true},{"text":"Sila ki rayi Ou yo leve tèt yo byen wo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yo fè plan malen kont pèp Ou a.","poem":1},{"lineBreak":true},{"text":"Yo fè konplo ansanm kont sila ki se trezò Ou.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yo te di: “Vini, annou disparèt yo nèt kon nasyon,","poem":1},{"lineBreak":true},{"text":"pou non Israël la pa sonje ankò menm.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Paske yo te fè konplo ansanm ak yon sèl panse.","poem":1},{"lineBreak":true},{"text":"Kont Ou menm, yo fè yon akò.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tant a Édom avèk Izmayelit yo, Moab ak Agarenyen yo,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Guebal, Ammon, Amalek, Filisten yo avèk pèp Tyr yo;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Anplis, Asiryen yo te vin jwenn ansanm avèk yo,","poem":1},{"lineBreak":true},{"text":"yo te prete lamen a pitit a Lot yo. Tan","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aji avèk yo tankou Madian,","poem":1},{"lineBreak":true},{"text":"tankou avèk Sisera ak Jabin nan ravin Kison an!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ki te fin detwi nan En-Dor,","poem":1},{"lineBreak":true},{"text":"ki te vin tankou fimye sou latè.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fè tout chèf yo tankou Oreb avèk Zeeb","poem":1},{"lineBreak":true},{"text":"e tout prens yo tankou Zébach avèk Tsalmunna,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ki te di: “Annou vin posede patiraj Bondye yo pou kont nou.”","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"O Bondye mwen, fè yo tankou pousyè toubiyon!","poem":1},{"lineBreak":true},{"text":"Tankou pay devan van!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tankou dife ki brile forè a, ak flanm ki","poem":1},{"lineBreak":true},{"text":"limen nan tout mòn nan pou yo brile nèt.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Konsa, kouri dèyè yo avèk tanpèt Ou","poem":1},{"lineBreak":true},{"text":"e teworize yo ak gwo siklòn Ou.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Plen figi yo ak gwo wont,","poem":1},{"lineBreak":true},{"text":"pou yo kab chache non pa Ou, O SENYÈ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kite yo vin wont e dekouraje jis pou tout tan.","poem":1},{"lineBreak":true},{"text":"Wi, kite yo imilye e peri,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"pou yo kapab konnen ke se Ou menm sèl","poem":1},{"lineBreak":true},{"text":"ki pote non “Bondye”, Pi Wo sou tout tè a.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}