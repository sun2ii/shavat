{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":84,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la; sou gitia la. Yon Sòm a fis a Koré yo."]},{"type":"verse","number":1,"content":[{"text":"A la abitasyon Ou yo bèl, O SENYÈ dèzame yo!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nanm mwen anvi e menm gen gwo dezi pou lakou SENYÈ a.","poem":1},{"lineBreak":true},{"text":"Kè m ak chè m chante avèk jwa a Bondye vivan an.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Zwazo a osi te twouve yon kay, e","poem":1},{"lineBreak":true},{"text":"iwondèl la yon nich pou li menm,","poem":1},{"lineBreak":true},{"text":"kote li kapab swaye pitit li yo pre lòtel Ou yo,","poem":1},{"lineBreak":true},{"text":"Oh Wa m ak Bondye m.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A la beni sila ki demere nan lakay Ou yo beni!","poem":1},{"lineBreak":true},{"text":"Y ap ba Ou lwanj jis pou tout tan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A la beni nonm ki gen fòs li nan Ou,","poem":1},{"lineBreak":true},{"text":"Nan kè a sila lide fè wout nan gran chemen vè Sion an ye.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lè yo pase nan vale Baca a, yo fè l fè yon sous;","poem":1},{"lineBreak":true},{"text":"Premye lapli a kouvri li avèk benediksyon.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yo sòti nan fòs pou antre nan fòs yo.","poem":1},{"lineBreak":true},{"text":"Yo chak parèt devan Bondye nan Sion.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O SENYÈ dèzame yo, tande lapriyè mwen.","poem":1},{"lineBreak":true},{"text":"Prete zorèy Ou, O Bondye Jacob la! Tan","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gade byen boukliye nou an.","poem":1},{"lineBreak":true},{"text":"Gade sou vizaj onksyone Ou a.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Paske yon sèl jou nan lakou Ou a,","poem":1},{"lineBreak":true},{"text":"pi bon pase mil jou deyò.","poem":1},{"lineBreak":true},{"text":"Pito m te geran pòt lakay Bondye mwen an,","poem":1},{"lineBreak":true},{"text":"pase pou m ta abite nan tant a mechan yo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Paske SENYÈ a, Bondye a, se yon solèy ak yon boukliye.","poem":1},{"lineBreak":true},{"text":"SENYÈ a va bay gras avèk glwa.","poem":1},{"lineBreak":true},{"text":"Li pa refize anyen ki bon a sila ki mache dwat yo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"O SENYÈ dèzame yo!","poem":1},{"lineBreak":true},{"text":"A la moun ki mete konfyans li nan Ou a beni!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}