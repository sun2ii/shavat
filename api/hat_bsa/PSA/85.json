{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":85,"content":[{"type":"hebrew_subtitle","content":["Pou direktè koral la; Yon Sòm a fis a Koré yo"]},{"type":"verse","number":1,"content":[{"text":"O SENYÈ, Ou te montre favè Ou a peyi Ou a.","poem":1},{"lineBreak":true},{"text":"Ou te restore kaptivite a Jacob la.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ou te padone inikite a pèp Ou a.","poem":1},{"lineBreak":true},{"text":"Ou te kouvri tout peche yo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ou te retire tout gran kòlè Ou.","poem":1},{"lineBreak":true},{"text":"Ou te detounen kòlè Ou ki brile a.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Restore nou, O Bondye a sali nou an,","poem":1},{"lineBreak":true},{"text":"e fè endiyasyon Ou anvè nou, sispann.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Èske Ou va fache avèk nou jis pou tout tan?","poem":1},{"lineBreak":true},{"text":"Èske Ou va pwolonje kòlè Ou jis a tout jenerasyon yo?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Èske se pa Ou menm ki pou fè nou reprann ankò?","poem":1},{"lineBreak":true},{"text":"Pou pèp Ou a kapab rejwi nan Ou?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Montre nou lanmou dous Ou a, O SENYÈ.","poem":1},{"lineBreak":true},{"text":"Pèmèt nou resevwa sali Ou a.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mwen va tande sa ke Bondye, SENYÈ a, va di.","poem":1},{"lineBreak":true},{"text":"Paske La p pale lapè a pèp Li a, a fidèl Li yo,","poem":1},{"lineBreak":true},{"text":"men pa kite yo retounen nan foli yo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Anverite, sekou Li toupre a sila ki gen lakrent Li yo,","poem":1},{"lineBreak":true},{"text":"pou laglwa Li kapab rete nan peyi nou an.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lanmou dous avèk verite te vin jwenn ansanm.","poem":1},{"lineBreak":true},{"text":"Ladwati avèk lapè te vin bo youn lòt.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Verite vòltije sòti nan latè, e","poem":1},{"lineBreak":true},{"text":"Ladwati veye depi anwo nan syèl la.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Anverite, SENYÈ a va bay sa ki bon,","poem":1},{"lineBreak":true},{"text":"e peyi nou an va bay rekòlt li.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ladwati va mache devan L.","poem":1},{"lineBreak":true},{"text":"L ap prepare yon gran chemen pou mak pla pye Li yo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}