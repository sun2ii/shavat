{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":86,"content":[{"type":"hebrew_subtitle","content":["Yon priyè a David"]},{"type":"verse","number":1,"content":[{"text":"Prete m zòrèy Ou, O SENYÈ e reponn mwen.","poem":1},{"lineBreak":true},{"text":"Paske mwen aflije e malere.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Konsève nanm mwen, paske mwen se yon nonm fidèl.","poem":1},{"lineBreak":true},{"text":"Ou menm, Bondye mwen an,","poem":1},{"lineBreak":true},{"text":"sove sèvitè Ou ki mete konfyans nan Ou a.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Montre m gras Ou, O SENYÈ, paske","poem":1},{"lineBreak":true},{"text":"se a Ou menm mwen kriye tout lajounen.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fè nanm a sèvitè Ou a kontan,","poem":1},{"lineBreak":true},{"text":"paske a Ou menm, SENYÈ, mwen leve nanm mwen.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Paske Ou menm, Senyè a,","poem":1},{"lineBreak":true},{"text":"Ou plen bonte e Ou prèt pou padone,","poem":1},{"lineBreak":true},{"text":"ranpli avèk lanmou dous, pou tout sila","poem":1},{"lineBreak":true},{"text":"ki rele sou non Ou yo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Prete zòrèy Ou, O SENYÈ, a lapriyè mwen.","poem":1},{"lineBreak":true},{"text":"Prete atansyon a vwa siplikasyon mwen yo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nan jou twoub mwen an, mwen va rele Ou,","poem":1},{"lineBreak":true},{"text":"paske Ou va reponn mwen.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nanpwen tankou Ou pami dye yo, O Senyè,","poem":1},{"lineBreak":true},{"text":"ni nanpwen zèv tankou pa Ou yo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tout nasyon ke Ou te fè yo, va vini pou","poem":1},{"lineBreak":true},{"text":"adore devan Ou, O Senyè,","poem":1},{"lineBreak":true},{"text":"e yo va bay non Ou glwa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Paske Ou gran e fè zèv ki mèvèye.","poem":1},{"lineBreak":true},{"text":"Se Ou sèl ki Bondye.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Montre m chemen Ou an, O SENYÈ.","poem":1},{"lineBreak":true},{"text":"Mwen va mache nan verite Ou.","poem":1},{"lineBreak":true},{"text":"Fè kè m dispoze pou krent non Ou.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mwen va ba Ou remèsiman,","poem":1},{"lineBreak":true},{"text":"O SENYÈ, Bondye mwen an, avèk tout kè m.","poem":1},{"lineBreak":true},{"text":"Mwen va bay glwa a non Ou jis pou tout tan.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Paske lanmou dous Ou anvè mwen gran,","poem":1},{"lineBreak":true},{"text":"e Ou te delivre nanm mwen soti nan fon sejou lanmò yo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"O Bondye, mesye awogan yo te leve kont mwen,","poem":1},{"lineBreak":true},{"text":"yon bann mesye vyolan ap chache lavi mwen.","poem":1},{"lineBreak":true},{"text":"Yo pa mete Ou devan yo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Men Ou menm, O SENYÈ,","poem":1},{"lineBreak":true},{"text":"Ou se yon Bondye ki plen ak gras avèk mizerikòd,","poem":1},{"lineBreak":true},{"text":"lan nan kòlè e plen avèk lanmou dous ak verite.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Vire vè mwen e fè m gras.","poem":1},{"lineBreak":true},{"text":"O dispoze fòs Ou a sèvitè Ou a,","poem":1},{"lineBreak":true},{"text":"e fè sekou a fis a sèvant Ou a.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Montre m yon sign bonte Ou,","poem":1},{"lineBreak":true},{"text":"pou sila ki rayi mwen yo kapab wè l e vin wont.","poem":1},{"lineBreak":true},{"text":"Paske Ou menm, O SENYÈ, te fè m sekou, e te konsole mwen.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}