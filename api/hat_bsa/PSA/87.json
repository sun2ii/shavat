{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"hebrew_subtitle","content":["Yon Sòm a fis a Koré yo; Yon Chan"]},{"type":"verse","number":1,"content":[{"text":"Fondasyon Li nan mòn sen yo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"SENYÈ a renmen pòtay Sion yo","poem":1},{"lineBreak":true},{"text":"plis pase tout lòt abitasyon a Jacob yo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yo pale sou gran mèvèy ou,","poem":1},{"lineBreak":true},{"text":"O gran vil Bondye. Tan","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mwen va mete Rahab avèk Babylone","poem":1},{"lineBreak":true},{"text":"pami sila ki rekonèt Mwen yo.","poem":1},{"lineBreak":true},{"text":"Men vwala, Philistie, Tyr, avèk Éthiopie:","poem":1},{"lineBreak":true},{"text":"“Tèl moun te fèt la”.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Men selon Sion, li va pale,","poem":1},{"lineBreak":true},{"text":"“Sa a ak sila a fèt ladann.”","poem":1},{"lineBreak":true},{"text":"Pi Wo a, Li menm, va etabli Sion.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"SENYÈ a va konte lè Li anrejistre","poem":1},{"lineBreak":true},{"text":"tout pèp yo: “Sa a te fèt la”. Tan","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Epi sila ki chante ansanm avèk sila ki jwe flit yo va di:","poem":1},{"lineBreak":true},{"text":"“Tout sous bwote yo, se nan ou”.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}