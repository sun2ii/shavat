{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":91,"content":[{"type":"verse","number":1,"content":[{"text":"Sila ki rete nan abri Pi Wo a va poze nan lonbraj Toupwisan an.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mwen va di a SENYÈ a:","poem":1},{"lineBreak":true},{"text":"“Se Li ki sitadèl mwen an, ak Bondye mwen an.","poem":1},{"lineBreak":true},{"text":"Se nan Li mwen mete konfyans!”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Paske se Li menm ki delivre ou soti nan pèlen a chasè a,","poem":1},{"lineBreak":true},{"text":"ak ravaj gwo maladi yo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Li va kouvri ou ak plim Li yo.","poem":1},{"lineBreak":true},{"text":"Anba zèl Li, ou kapab chache pwotèj.","poem":1},{"lineBreak":true},{"text":"Fidelite Li se yon boukliye ak yon ranpa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ou p ap pè laperèz lannwit, ni flèch k ap vole lajounen,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ni gwo maladi ki swiv nan fènwa,","poem":1},{"lineBreak":true},{"text":"ni destriksyon ki devaste a midi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yon milye kapab tonbe bò kote dwat ou,","poem":1},{"lineBreak":true},{"text":"ak di mil sou men agoch ou,","poem":1},{"lineBreak":true},{"text":"men sa p ap pwoche ou.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ou va sèlman gade avèk zye ou pou","poem":1},{"lineBreak":true},{"text":"wè rekonpans a mechan yo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Paske ou te fè SENYÈ a, vin sekou ou,","poem":1},{"lineBreak":true},{"text":"menm Pi Wo a, kote pou ou rete.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nanpwen mal k ap rive ou,","poem":1},{"lineBreak":true},{"text":"Ni okenn toumant k ap pwoche tant ou.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Paske Li va bay zanj Li yo lòd konsènan ou menm,","poem":1},{"lineBreak":true},{"text":"pou veye ou nan tout chemen ou yo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yo va leve ou byen wo nan men yo,","poem":1},{"lineBreak":true},{"text":"pou ou pa frape pye ou kont wòch.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ou va pile sou lyon an ak koulèv la.","poem":1},{"lineBreak":true},{"text":"Jenn lyon an avèk sèpan an, ou va foule yo nèt.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Paske li te renmen M konsa,","poem":1},{"lineBreak":true},{"text":"pou sa, Mwen va delivre li.","poem":1},{"lineBreak":true},{"text":"Mwen va mete li byen solid an wo,","poem":1},{"lineBreak":true},{"text":"akoz li te rekonèt non Mwen.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Li va fè apèl non Mwen e Mwen va reponn li.","poem":1},{"lineBreak":true},{"text":"Mwen va avèk Li nan tan twoub la.","poem":1},{"lineBreak":true},{"text":"Mwen va delivre li e bay li lonè.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mwen va satisfè li avèk yon lavi ki long,","poem":1},{"lineBreak":true},{"text":"e kite li wè sali mwen.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}