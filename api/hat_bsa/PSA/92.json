{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":92,"content":[{"type":"hebrew_subtitle","content":["Yon Sòm. Yon chan pou jou Saba a"]},{"type":"verse","number":1,"content":[{"text":"Li bon pou bay lwanj a SENYÈ a,","poem":1},{"lineBreak":true},{"text":"pou chante lwanj a non Ou, O Pi Wo a,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"pou deklare lanmou dous Ou nan maten","poem":1},{"lineBreak":true},{"text":"avèk fidelite Ou nan lannwit,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"avèk lenstriman a kòd e avèk ap,","poem":1},{"lineBreak":true},{"text":"avèk mizik ki retanti sou lir.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Paske Ou menm, O SENYÈ, te fè m kontan avèk sa Ou te fè a.","poem":1},{"lineBreak":true},{"text":"Mwen va chante chan viktwa a akoz zèv men Ou yo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A la zèv Ou yo gran, O SENYÈ!","poem":1},{"lineBreak":true},{"text":"Panse Ou yo byen pwofon.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yon nonm ensanse pa gen konesans,","poem":1},{"lineBreak":true},{"text":"ni yon nonm bèt pa konprann sa:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ke lè mechan yo te pouse tankou zèb la,","poem":1},{"lineBreak":true},{"text":"e tout sa ki fè inikite t ap byen reyisi yo,","poem":1},{"lineBreak":true},{"text":"se te pou yo ta kapab detwi jis pou tout tan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Men Ou menm O SENYÈ, Ou an wo jis pou tout tan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Paske gade byen, lènmi Ou yo, O SENYÈ,","poem":1},{"lineBreak":true},{"text":"paske gade byen, lènmi Ou yo va peri.","poem":1},{"lineBreak":true},{"text":"Tout moun ki fè inikite yo va gaye nèt.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Men Ou te fè kòn mwen an leve wo tankou bèf mawon.","poem":1},{"lineBreak":true},{"text":"Mwen te onksyone avèk lwil nèf.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Epi zye mwen vin gade avèk kè kontan","poem":1},{"lineBreak":true},{"text":"malfektè ki leve kont mwen yo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Moun dwat la va fleri tankou palmis.","poem":1},{"lineBreak":true},{"text":"Li va grandi tankou pye sèd nan Liban.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Plante lakay SENYÈ a, yo va fleri tankou palmis.","poem":1},{"lineBreak":true},{"text":"Yo va fleri nan lakou kay Bondye nou an.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yo va bay fwi toujou lè yo vin vye.","poem":1},{"lineBreak":true},{"text":"Yo va plen ak dlo bwa vèt.","poem":1},{"lineBreak":true},{"text":"Y ap rete vèt nèt.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Konsa, yo deklare ke SENYÈ a toujou dwat.","poem":1},{"lineBreak":true},{"text":"Li se wòch mwen,","poem":1},{"lineBreak":true},{"text":"e nanpwen anyen ki pa dwat nan Li.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}