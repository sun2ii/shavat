{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"O vini, annou chante a SENYÈ a!","poem":1},{"lineBreak":true},{"text":"Annou rele fò avèk jwa a wòch ki sove nou an;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Annou vini devan prezans Li avèk remèsiman,","poem":1},{"lineBreak":true},{"text":"Annou rele fò a Li menm avèk sòm.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Paske SENYÈ a se yon gran Bondye, e","poem":1},{"lineBreak":true},{"text":"yon gran wa pi wo ke tout dye yo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nan men Sila pwofondè latè yo ye a.","poem":1},{"lineBreak":true},{"text":"Pwent mòn yo osi se pou Li.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lanmè a se pou Li, paske se te Li menm ki te fè l.","poem":1},{"lineBreak":true},{"text":"Ak men L, Li te fòme tè sèch la.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Vini, annou fè adorasyon, e annou pwostène.","poem":1},{"lineBreak":true},{"text":"Annou mete ajenou devan SENYÈ ki te fè nou an.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Paske se Li menm ki Bondye nou an.","poem":1},{"lineBreak":true},{"text":"Nou se moun patiraj Li ak mouton men Li yo.","poem":1},{"lineBreak":true},{"text":"Jodi a, si nou ta vle tande vwa L,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"pa fè kè nou vin di tankou nan Meriba,","poem":1},{"lineBreak":true},{"text":"tankou nan jou a Massa nan dezè yo,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"“lè papa zansèt nou yo te pase M a leprèv.","poem":1},{"lineBreak":true},{"text":"Yo te tante Mwen, malgre yo te deja wè zèv Mwen yo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pandan karantan, Mwen te rayi jenerasyon sila a e te di:","poem":1},{"lineBreak":true},{"text":"“Yo se yon pèp ki egare nan kè yo.","poem":1},{"lineBreak":true},{"text":"Yo pa rekonèt chemen Mwen yo.”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Akoz sa, Mwen te sèmante nan kòlè Mwen,","poem":1},{"lineBreak":true},{"text":"“Anverite, yo p ap antre nan repo Mwen an.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}