{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":96,"content":[{"type":"verse","number":1,"content":[{"text":"Chante a SENYÈ a yon chan tounèf!","poem":1},{"lineBreak":true},{"text":"Chante a SENYÈ a tout latè a.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chante a SENYÈ a!","poem":1},{"lineBreak":true},{"text":"Beni non Li!","poem":1},{"lineBreak":true},{"text":"Pwoklame bòn nouvèl Sali a Li de jou an jou.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pale glwa Li pami nasyon yo,","poem":1},{"lineBreak":true},{"text":"zèv mèvèy Li yo pami tout pèp yo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Paske gran se SENYÈ a!","poem":1},{"lineBreak":true},{"text":"Li merite gran lwanj.","poem":1},{"lineBreak":true},{"text":"Fòk Li resevwa krentif nou pi wo ke tout dye yo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Paske tout dye a pèp yo se zidòl,","poem":1},{"lineBreak":true},{"text":"men SENYÈ a te fè syèl yo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tout bèlte ak majeste devan L.","poem":1},{"lineBreak":true},{"text":"Pwisans ak bèlte rete nan sanktiyè Li a.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bay a SENYÈ a, O fanmi a pèp yo,","poem":1},{"lineBreak":true},{"text":"bay a SENYÈ a glwa ak pwisans.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bay a SENYÈ a glwa a non Li.","poem":1},{"lineBreak":true},{"text":"Pote yon ofrann e antre nan lakou Li yo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Adore SENYÈ a nan abiman ki sen.","poem":1},{"lineBreak":true},{"text":"Tranble devan L, tout latè a.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pale pami nasyon yo, “SENYÈ a renye.”","poem":1},{"lineBreak":true},{"text":"Anverite, mond lan etabli byen solid.","poem":1},{"lineBreak":true},{"text":"Li p ap ebranle menm.","poem":1},{"lineBreak":true},{"text":"SENYÈ a va jije pèp yo avèk jistis.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kite syèl yo vin kontan e kite latè rejwi.","poem":1},{"lineBreak":true},{"text":"Kite lanmè a fè gwo bri ansanm ak tout sa ki ladann.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kite chan yo leve fè kè kontan, ak tout sa ki ladann yo.","poem":1},{"lineBreak":true},{"text":"Epi tout bwa nan forè yo va chante ak jwa","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"devan SENYÈ a, paske La p vini.","poem":1},{"lineBreak":true},{"text":"Paske La p vini pou jije latè. Li va jije mond lan","poem":1},{"lineBreak":true},{"text":"avèk ladwati e pèp yo ak fidelite Li.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}