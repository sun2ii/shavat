{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":97,"content":[{"type":"verse","number":1,"content":[{"text":"SENYÈ a renye, kite latè rejwi!","poem":1},{"lineBreak":true},{"text":"Kite tout lil yo fè kè kontan!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nwaj ak fènwa pwofon ap antoure Li.","poem":1},{"lineBreak":true},{"text":"Ladwati avèk jistis se fondasyon twòn Li an.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Se dife ki ale devan L pou brile tout","poem":1},{"lineBreak":true},{"text":"advèsè Li yo toupatou.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Loray Li yo klere tout mond lan.","poem":1},{"lineBreak":true},{"text":"Latè wè e li tranble.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mòn yo fonn tankou lasi devan prezans SENYÈ a,","poem":1},{"lineBreak":true},{"text":"devan prezans SENYÈ tout latè a.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Syèl yo deklare ladwati Li e tout pèp yo te wè glwa Li.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kite tout sila ki sèvi limaj taye yo vin wont,","poem":1},{"lineBreak":true},{"text":"ki vin ògeye sou zafè zidòl yo.","poem":1},{"lineBreak":true},{"text":"Adore Li, tout dye yo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sion te tande sa e te rejwi.","poem":1},{"lineBreak":true},{"text":"Fi a Sion yo te rejwi akoz jijman Ou, O SENYÈ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Paske Ou menm se SENYÈ Pi Wo a sou tout latè.","poem":1},{"lineBreak":true},{"text":"Ou leve pi wo anpil pase tout dye yo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nou menm ki renmen SENYÈ a, rayi mal la!","poem":1},{"lineBreak":true},{"text":"Li pwoteje nanm a fidèl Li yo.","poem":1},{"lineBreak":true},{"text":"Li delivre yo nan men a mechan yo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Se limyè ki simen kon semans pou moun ladwati yo,","poem":1},{"lineBreak":true},{"text":"ak kè kontan pou sila ak kè ki dwat yo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fè kè kontan nan SENYÈ a, nou menm ki moun dwat yo e","poem":1},{"lineBreak":true},{"text":"bay remèsiman a non sen Li an.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}