{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"hebrew_subtitle","content":["Yon Sòm"]},{"type":"verse","number":1,"content":[{"text":"O chante a SENYÈ a yon chan tounèf, paske Li te fè anpil bèl mèvèy.","poem":1},{"lineBreak":true},{"text":"Men dwat Li ak bra sen Li yo te vin genyen viktwa pou Li.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"SENYÈ a te fè sali Li rekonèt.","poem":1},{"lineBreak":true},{"text":"Li te devwale ladwati Li pou tout nasyon yo wè.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Li te sonje lanmou dous Li a avèk fidelite Li pou lakay Israël.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rele fò ak jwa a SENYÈ a, tout latè!","poem":1},{"lineBreak":true},{"text":"Eklate ak chanson, wi chante lwanj Li yo!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chante lwanj a SENYÈ a avèk ap,","poem":1},{"lineBreak":true},{"text":"avèk ap ak vwa melodi a.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Avèk twonpèt ak son a kòn.","poem":1},{"lineBreak":true},{"text":"Rele fò devan Wa a, SENYÈ a.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kite lanmè a fè gwo bri ak tout sa ki ladann,","poem":1},{"lineBreak":true},{"text":"Lemonn ak tout sa ki rete ladann yo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kite larivyè yo bat men yo.","poem":1},{"lineBreak":true},{"text":"Kite mòn yo chante ansanm ak jwa","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"devan SENYÈ a,","poem":1},{"lineBreak":true},{"text":"paske l ap vini pou jije latè.","poem":1},{"lineBreak":true},{"text":"Li va jije lemonn ak ladwati Li","poem":1},{"lineBreak":true},{"text":"E pèp yo avèk jistis.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}