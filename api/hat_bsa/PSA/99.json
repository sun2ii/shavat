{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"PSA","translationId":"hat_bsa","name":"Sòm Yo","commonName":"Sòm Yo","title":"SÒM YO","order":19,"numberOfChapters":150,"sha256":"3156cd0929a9197057d84dd75781f34c4e4fb4d7ca59e2f0817482b4bbdf7f0b","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hat_bsa/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"SENYÈ a renye! Kite pèp yo pran tranble.","poem":1},{"lineBreak":true},{"text":"Li plase twòn Li an anwo cheriben yo.","poem":1},{"lineBreak":true},{"text":"Kite latè pran tranble!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"SENYÈ a gran nan Sion.","poem":1},{"lineBreak":true},{"text":"Li leve wo anwo tout pèp yo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kite yo louwe non Ou ki gran e mèvèye;","poem":1},{"lineBreak":true},{"text":"Se sen ke Li ye.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Pwisans a Wa a renmen lajistis.","poem":1},{"lineBreak":true},{"text":"Ou te etabli ekite.","poem":1},{"lineBreak":true},{"text":"Ou te fè jistis ak ladwati Ou vin rive nan Jacob.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Leve wo SENYÈ, Bondye nou an!","poem":1},{"lineBreak":true},{"text":"Adore nan machpye twòn Li an.","poem":1},{"lineBreak":true},{"text":"Se sen ke Li ye.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Moïse avèk Aaron te pami prèt Li yo e","poem":1},{"lineBreak":true},{"text":"Samuel te pami sila ki te rele non Li yo.","poem":1},{"lineBreak":true},{"text":"Yo te rele non SENYÈ a e Li te reponn yo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Li te pale ak yo nan pilye nwaj la.","poem":1},{"lineBreak":true},{"text":"Yo te kenbe temwayaj Li yo,","poem":1},{"lineBreak":true},{"text":"avèk règleman ke Li te bay yo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O SENYÈ, Bondye nou an, Ou te reponn yo.","poem":1},{"lineBreak":true},{"text":"Ou te pou yo yon Bondye ki padone,","poem":1},{"lineBreak":true},{"text":"men Ou te pran vanjans sou zak mechan yo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Egzalte SENYÈ, Bondye nou an!","poem":1},{"lineBreak":true},{"text":"Adore nan mon sen Li an,","poem":1},{"lineBreak":true},{"text":"paske sen se SENYÈ a, Bondye nou an!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}