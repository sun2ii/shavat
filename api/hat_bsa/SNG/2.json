{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"SNG","translationId":"hat_bsa","name":"Kantik A Kantik Yo","commonName":"Kantik A Kantik Yo","title":"KANTIK A KANTIK YO","order":22,"numberOfChapters":8,"sha256":"8f2351479946d1689f0960eeda4b2fe1d5212e5904a4e37ef932dd677dbfdd46","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/hat_bsa/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Mwen se flè Woz Saron an,",{"text":"flè Lis a vale yo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Tankou yon flè lis pami pikan yo,","poem":1},{"lineBreak":true},{"text":"se konsa cheri mwen an ye","poem":1},{"lineBreak":true},{"text":"pami tout jenn fi yo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tankou yon pye pòm pami bwa nan forè,","poem":1},{"lineBreak":true},{"text":"se konsa cheri mwen an ye pami jennonm yo.","poem":1},{"lineBreak":true},{"text":"Nan lonbraj li mwen te pran gwo plezi pou m te chita;","poem":1},{"lineBreak":true},{"text":"konsa fwi li te dous nan gou m.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Li te mennen m nan gwo sal bankè li,","poem":1},{"lineBreak":true},{"text":"e drapo li monte sou mwen an se lanmou.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ban m fòs ak gato rezen,","poem":1},{"lineBreak":true},{"text":"rafrechi m ak pòm,","poem":1},{"lineBreak":true},{"text":"akoz mwen malad ak lanmou.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kite men goch li rete anba tèt mwen","poem":1},{"lineBreak":true},{"text":"ak men dwat li pou l anbrase m.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"M ap avèti nou, O fi a Jérusalem yo,","poem":1},{"lineBreak":true},{"text":"nan non antilòp ak bich mawon an,","poem":1},{"lineBreak":true},{"text":"pou nou pa fè lanmou m leve,","poem":1},{"lineBreak":true},{"text":"ni ouvri zye li jiskaske se plezi li.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Koute! Men cheri mwen an!","poem":1},{"lineBreak":true},{"text":"Men l ap vini!","poem":1},{"lineBreak":true},{"text":"L ap monte sou mòn yo,","poem":1},{"lineBreak":true},{"text":"epi vòltije sou kolin yo!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Cheri mwen an tankou yon antilòp,","poem":1},{"lineBreak":true},{"text":"oswa yon jenn sèf.","poem":1},{"lineBreak":true},{"text":"Gade byen, li kanpe dèyè mi kay nou an;","poem":1},{"lineBreak":true},{"text":"l ap gade nan fenèt yo, l ap gade nan jalouzi a.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Cheri mwen an te reponn mwen","poem":1},{"lineBreak":true},{"text":"e te di m: “Leve vini cheri mwen an,","poem":1},{"lineBreak":true},{"text":"pi bèl mwen an.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Paske gade, sezon fredi a fin pase,","poem":1},{"lineBreak":true},{"text":"lapli fin pati nèt.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Flè yo deja parèt nan peyi a;","poem":1},{"lineBreak":true},{"text":"tan an chante a fin rive!","poem":1},{"lineBreak":true},{"text":"Vwa toutrèl la ap koute deja nan peyi a.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Fwi pye fig etranje a fin mi,","poem":1},{"lineBreak":true},{"text":"e chan rezen yo bay odè pafen.","poem":1},{"lineBreak":true},{"text":"Leve vini, annou pati!”","poem":1}]},{"type":"verse","number":14,"content":[{"text":"O toutrèl nan fant wòch mwen an,","poem":1},{"lineBreak":true},{"text":"nan kote sekrè chemen ki monte apik,","poem":1},{"lineBreak":true},{"text":"kite mwen wè figi ou, kite mwen tande vwa ou!","poem":1},{"lineBreak":true},{"text":"Paske vwa ou dous e fòm ou bèl nèt.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kenbe rena yo pou nou,","poem":1},{"lineBreak":true},{"text":"ti rena k ap detwi chan rezen yo,","poem":1},{"lineBreak":true},{"text":"paske chan nou yo ap fè flè.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Cheri mwen an se pa m,","poem":1},{"lineBreak":true},{"text":"e mwen se pa l.","poem":1},{"lineBreak":true},{"text":"Li fè patiraj twoupo li pami flè lis yo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Jiskaske joune a vin fè fre","poem":1},{"lineBreak":true},{"text":"lè lonbraj yo kouri ale;","poem":1},{"lineBreak":true},{"text":"vire, cheri mwen an,","poem":1},{"lineBreak":true},{"text":"fè tankou antilòp la, oswa jenn sèf sou mòn Bether a.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}