{"translation":{"id":"hat_bsa","name":"Bib Sen An","website":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hatbsa","licenseNotes":null,"shortName":"BSA","englishName":"Haitian Creole Bible 2023","language":"hat","textDirection":"ltr","sha256":"9767d70c82efa7b93da89c4bd570ed8c1ee7bffa61aa2d8ac8c8fb27d1e65fa3","availableFormats":["json"],"listOfBooksApiLink":"/api/hat_bsa/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Haitian Creole","languageEnglishName":"Haitian Creole"},"book":{"id":"SNG","translationId":"hat_bsa","name":"Kantik A Kantik Yo","commonName":"Kantik A Kantik Yo","title":"KANTIK A KANTIK YO","order":22,"numberOfChapters":8,"sha256":"8f2351479946d1689f0960eeda4b2fe1d5212e5904a4e37ef932dd677dbfdd46","firstChapterNumber":1,"firstChapterApiLink":"/api/hat_bsa/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/hat_bsa/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":["A la bèl pye ou bèl nan sandal yo, o pitit a nòb yo!",{"text":"O fi a prens lan!","poem":1},{"lineBreak":true},{"text":"Koub kwis ou tankou bijou, zèv a yon vrè atis.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lonbrit ou kon yon tas won ki pa janm manke diven mele;","poem":1},{"lineBreak":true},{"text":"vant ou se yon bèl pakèt ble ankadre ak flè lis;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"De tete ou se de jenn pòtre a yon antilòp,","poem":1},{"lineBreak":true},{"text":"jimo a yon antilòp.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kou ou se yon kou ivwa,","poem":1},{"lineBreak":true},{"text":"zye ou tankou sous dlo nan Hesbon yo","poem":1},{"lineBreak":true},{"text":"akote pòtay a Bath-Rabbim nan.","poem":1},{"lineBreak":true},{"text":"Nen ou tankou tou Liban ki gade vè Damas la.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tèt ou kouwone ou tankou Mòn Carmel","poem":1},{"lineBreak":true},{"text":"e très cheve tèt ou tankou fisèl mov.","poem":1},{"lineBreak":true},{"text":"Wa a kaptire pa très ou yo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A la ou bèl e a la ou mèvèye,","poem":1},{"lineBreak":true},{"text":"ak tout bèlte ou yo!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lè ou kanpe se tankou yon pye palmis","poem":1},{"lineBreak":true},{"text":"e tete ou se grap li yo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mwen te di: “Mwen va monte pye palmis lan,","poem":1},{"lineBreak":true},{"text":"mwen va kenbe tij fwi li yo.”","poem":1},{"lineBreak":true},{"text":"O ke tete ou yo kapab tankou grap","poem":1},{"lineBreak":true},{"text":"ki pann sou chan rezen nan","poem":1},{"lineBreak":true},{"text":"e bon odè a souf ou tankou pòm,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Epi bouch ou tankou meyè diven an, ki desann byen swa pou cheri mwen an,","poem":1},{"lineBreak":true},{"text":"e koule dousman nan lèv a sila","poem":1},{"lineBreak":true},{"text":"ki tonbe nan dòmi yo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mwen pou cheri mwen an","poem":1},{"lineBreak":true},{"text":"e dezi li se pou mwen.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Vini, cheri mwen an!","poem":1},{"lineBreak":true},{"text":"Annou pati ale nan chan yo","poem":1},{"lineBreak":true},{"text":"e fè lojman nan ti vil yo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Annou leve bonè pou rive nan chan rezen yo;","poem":1},{"lineBreak":true},{"text":"annou gade pou wè si chan rezen an","poem":1},{"lineBreak":true},{"text":"gen tan boujonnen e flè li yo fin ouvri.","poem":1},{"lineBreak":true},{"text":"Se la, m ap bay ou lanmou mwen an.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mandragò yo fin bay bèl odè;","poem":1},{"lineBreak":true},{"text":"epi sou tout pòt nou yo se tout meyè fwi yo,","poem":1},{"lineBreak":true},{"text":"ni nèf ni ansyen,","poem":1},{"lineBreak":true},{"text":"ki te konsève pou ou, lanmou mwen an.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hat_bsa/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_bsa/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_bsa/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}