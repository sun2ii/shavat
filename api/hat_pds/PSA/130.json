[]},"thisChapterLink":"/api/hat_pds/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hat_pds/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hat_pds/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}