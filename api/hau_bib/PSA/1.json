{"translation":{"id":"hau_bib","name":"Biblica® Buɗaɗɗen Littafi Mai Tsarki, Sabon Rai Don Kowa™","website":"https://ebible.org/Scriptures/details.php?id=hausa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hausa","licenseNotes":null,"shortName":"BIB","englishName":"Hausa Contemporary Bible","language":"hau","textDirection":"ltr","sha256":"c2ada3e8c0e614c336e649825fda5e2d44fa0d148d2a19de6b76d5e8eb7dd816","availableFormats":["json"],"listOfBooksApiLink":"/api/hau_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31087,"languageName":"Hausa","languageEnglishName":"Hausa"},"book":{"id":"PSA","translationId":"hau_bib","name":"Zabura","commonName":"Zabura","title":"Zabura","order":19,"numberOfChapters":150,"sha256":"3305cedf5350f741272c6666397410271bbc2bcb3c7178fb884fdcde9d26b5a3","firstChapterNumber":1,"firstChapterApiLink":"/api/hau_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hau_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Mai farin ciki ne mutumin","poem":1},{"text":"da ba ya aiki da shawarar mugaye","poem":2},{"text":"ko yă yi abin da masu zunubi suke yi","poem":1},{"text":"ko yă zauna tare da masu yin ba’a.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amma yana jin daɗin bin dokar Ubangiji,","poem":1},{"text":"kuma yana ta nazarinta dare da rana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yana kama da itacen da aka shuka kusa da maɓulɓulan ruwa,","poem":1},{"text":"wanda yake ba da amfani a daidai lokaci","poem":2},{"text":"wanda kuma ganyensa ba sa bushewa.","poem":1},{"text":"Duk abin da yake yi, yakan yi nasara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ba haka yake da mugaye ba!","poem":1},{"text":"Su kamar yayi ne","poem":2},{"lineBreak":true},{"text":"da iska take kwashewa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Saboda haka mugaye ba za su iya tsayawa a shari’a ba,","poem":1},{"text":"balle a sami masu zunubi a taron adalai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Gama Ubangiji yana lura da yadda adalai suke yin abubuwa,","poem":1},{"text":"amma ayyukan mugaye za su kai su ga hallaka.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hau_bib/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hau_bib/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hau_bib/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}