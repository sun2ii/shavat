{"translation":{"id":"hau_bib","name":"Biblica® Buɗaɗɗen Littafi Mai Tsarki, Sabon Rai Don Kowa™","website":"https://ebible.org/Scriptures/details.php?id=hausa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hausa","licenseNotes":null,"shortName":"BIB","englishName":"Hausa Contemporary Bible","language":"hau","textDirection":"ltr","sha256":"c2ada3e8c0e614c336e649825fda5e2d44fa0d148d2a19de6b76d5e8eb7dd816","availableFormats":["json"],"listOfBooksApiLink":"/api/hau_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31087,"languageName":"Hausa","languageEnglishName":"Hausa"},"book":{"id":"PSA","translationId":"hau_bib","name":"Zabura","commonName":"Zabura","title":"Zabura","order":19,"numberOfChapters":150,"sha256":"3305cedf5350f741272c6666397410271bbc2bcb3c7178fb884fdcde9d26b5a3","firstChapterNumber":1,"firstChapterApiLink":"/api/hau_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hau_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"Yabi Ubangiji.","poem":1},{"noteId":67},{"lineBreak":true},{"text":"Zan ɗaukaka Ubangiji da dukan zuciyata","poem":1},{"text":"a cikin majalisar masu aikata gaskiya da kuma a cikin taro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ayyukan Ubangiji da girma suke;","poem":1},{"text":"dukan waɗanda suke farin ciki da su suna tunaninsu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ayyukansa masu ɗaukaka da kuma daraja ne,","poem":1},{"text":"adalcinsa kuma zai dawwama har abada.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ya sa a tuna da abubuwa masu banmamaki nasa;","poem":1},{"text":"Ubangiji mai alheri ne mai tausayi kuma.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yana ba da abinci ga waɗanda suke tsoronsa;","poem":1},{"text":"yakan tuna da alkawarinsa har abada.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ya nuna wa mutanensa ikon ayyukansa,","poem":1},{"text":"yana ba su ƙasashen waɗansu al’ummai.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ayyukan hannuwansa masu aminci ne da kuma gaskiya;","poem":1},{"text":"dukan farillansa abin dogara ne.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tsayayyu ne har abada abadin,","poem":1},{"text":"ana yinsu cikin aminci da kuma gaskiya.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yana ba da ceto ga mutanensa;","poem":1},{"text":"ya kafa alkawarinsa har abada,","poem":2},{"lineBreak":true},{"text":"tsarki da banrazana ne sunansa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tsoron Ubangiji ne mafarin hikima;","poem":1},{"text":"dukan waɗanda suke bin farillansa suna da ganewa mai kyau.","poem":2},{"lineBreak":true},{"text":"Gare shi ne madawwamin yabo.","poem":2}]}],"footnotes":[{"noteId":67,"caller":"+","text":"Da Ibraniyanci Hallelu Ya","reference":{"chapter":111,"verse":1}}]},"thisChapterLink":"/api/hau_bib/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hau_bib/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hau_bib/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}