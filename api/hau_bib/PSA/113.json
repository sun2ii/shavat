"type":"verse","number":7,"content":[{"text":"Yakan tā da matalauta daga ƙura","poem":1},{"text":"yakan ɗaga mabukata daga tarin toka;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ya zaunar da su tare da sarakuna,","poem":1},{"text":"tare da sarakunan mutanensu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yakan zaunar da matar da ba haihuwa a gidanta","poem":1},{"text":"ta zama kamar mahaifiyar ’ya’ya mai farin ciki.","poem":2},{"lineBreak":true},{"text":"Yabi Ubangiji.","poem":1}]}],"footnotes":[{"noteId":71,"caller":"+","text":"Da Ibraniyanci Hallelu Ya, haka ma a aya 9.","reference":{"chapter":113,"verse":1}}]},"thisChapterLink":"/api/hau_bib/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hau_bib/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hau_bib/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}