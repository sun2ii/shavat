"text":"Ki yi rawar jiki, ya duniya, a gaban Ubangiji,","poem":1},{"text":"a gaban Allah na Yaƙub,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"wanda ya juye dutse ya zama tafki,","poem":1},{"text":"dutse mai ƙarfi zuwa maɓulɓulan ruwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hau_bib/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hau_bib/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hau_bib/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}