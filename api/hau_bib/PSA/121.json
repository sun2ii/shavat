re.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ubangiji zai kiyaye ka daga dukan masifa,","poem":1},{"text":"zai tsare ranka;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ubangiji zai kiyaye shigarka da fitarka","poem":1},{"text":"yanzu da har abada kuma.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hau_bib/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hau_bib/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hau_bib/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}