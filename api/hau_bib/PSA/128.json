ushalima,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"bari kuma ka rayu ka ga ’ya’ya ’ya’yanka.","poem":1},{"text":"Salama tă kasance tare da Isra’ila.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hau_bib/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hau_bib/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hau_bib/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}