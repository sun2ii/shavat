"text":"Amma na dogara a kan ƙaunarka marar ƙarewa;","poem":1},{"text":"zuciyata tana farin ciki a cikin cetonka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Zan rera ga Ubangiji","poem":1},{"text":"gama ya yi mini alheri.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hau_bib/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hau_bib/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hau_bib/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}