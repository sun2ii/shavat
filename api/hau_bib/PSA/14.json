{"translation":{"id":"hau_bib","name":"Biblica® Buɗaɗɗen Littafi Mai Tsarki, Sabon Rai Don Kowa™","website":"https://ebible.org/Scriptures/details.php?id=hausa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hausa","licenseNotes":null,"shortName":"BIB","englishName":"Hausa Contemporary Bible","language":"hau","textDirection":"ltr","sha256":"c2ada3e8c0e614c336e649825fda5e2d44fa0d148d2a19de6b76d5e8eb7dd816","availableFormats":["json"],"listOfBooksApiLink":"/api/hau_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31087,"languageName":"Hausa","languageEnglishName":"Hausa"},"book":{"id":"PSA","translationId":"hau_bib","name":"Zabura","commonName":"Zabura","title":"Zabura","order":19,"numberOfChapters":150,"sha256":"3305cedf5350f741272c6666397410271bbc2bcb3c7178fb884fdcde9d26b5a3","firstChapterNumber":1,"firstChapterApiLink":"/api/hau_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hau_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"hebrew_subtitle","content":["Don mai bi da kaɗe-kaɗe. Ta Dawuda."]},{"type":"verse","number":1,"content":[{"text":"Wawaye sukan ce a ransu,","poem":1},{"text":"“Ba Allah.”","poem":2},{"text":"Sun lalace, ayyukansu kuwa mugaye ne;","poem":1},{"text":"babu wani da yake yi abu mai kyau.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ubangiji ya duba daga sama","poem":1},{"text":"a kan ’yan adam","poem":2},{"text":"don yă ga ko akwai wani da ya gane,","poem":1},{"text":"wani wanda yake neman Allah.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Duka sun kauce, duka gaba ɗaya sun zama lalatattu;","poem":1},{"text":"babu ɗaya wanda yake yin abu mai kyau,","poem":2},{"lineBreak":true},{"text":"ba ko ɗaya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Masu aikata mugunta za su taɓa koyo.","poem":1},{"lineBreak":true},{"text":"Suna cin mutane yadda mutane ke cin gurasa","poem":1},{"text":"kuma waɗanda ba sa kira bisa Ubangiji?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ga su, tsoro ya sha kansu,","poem":1},{"text":"gama Allah yana cikin ƙungiyar adalai.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ku masu mugunta kuna sa ƙoƙarin matalauta yă zama banza,","poem":1},{"text":"amma Ubangiji ne mafakansu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kash, da ceton Isra’ila zai fito daga Sihiyona mana!","poem":1},{"text":"Sa’ad da Ubangiji zai maido da sa’ar mutanensa,","poem":2},{"lineBreak":true},{"text":"bari Yaƙub yă yi farin ciki Isra’ila kuma yă yi murna!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hau_bib/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hau_bib/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hau_bib/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}