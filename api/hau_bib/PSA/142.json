{"translation":{"id":"hau_bib","name":"Biblica® Buɗaɗɗen Littafi Mai Tsarki, Sabon Rai Don Kowa™","website":"https://ebible.org/Scriptures/details.php?id=hausa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hausa","licenseNotes":null,"shortName":"BIB","englishName":"Hausa Contemporary Bible","language":"hau","textDirection":"ltr","sha256":"c2ada3e8c0e614c336e649825fda5e2d44fa0d148d2a19de6b76d5e8eb7dd816","availableFormats":["json"],"listOfBooksApiLink":"/api/hau_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31087,"languageName":"Hausa","languageEnglishName":"Hausa"},"book":{"id":"PSA","translationId":"hau_bib","name":"Zabura","commonName":"Zabura","title":"Zabura","order":19,"numberOfChapters":150,"sha256":"3305cedf5350f741272c6666397410271bbc2bcb3c7178fb884fdcde9d26b5a3","firstChapterNumber":1,"firstChapterApiLink":"/api/hau_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hau_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["Maskil ne",{"noteId":79},"ta Dawuda. Sa’ad da yake cikin kogo. Addu’a ce."]},{"type":"verse","number":1,"content":[{"text":"Na yi kuka mai ƙarfi ga Ubangiji;","poem":1},{"text":"na tā da muryata ga Ubangiji neman jinƙai.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Na kawo gunagunina a gabansa;","poem":1},{"text":"a gabansa na faɗa wahalata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Sa’ad da ƙarfina ya kāre a cikina,","poem":1},{"text":"kai ne wanda ya san hanyata.","poem":2},{"text":"A hanyar da nake tafiya","poem":1},{"text":"mutane sun kafa mini tarko.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Duba ta damata ka gani;","poem":1},{"text":"babu wanda ya kula da ni.","poem":2},{"text":"Ba ni da mafaka;","poem":1},{"text":"babu wanda ya kula da raina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Na yi kuka gare ka, ya Ubangiji;","poem":1},{"text":"Na ce, “Kai ne mafakata,","poem":2},{"lineBreak":true},{"text":"rabona a ƙasar masu rai.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ka saurari kukata,","poem":1},{"text":"gama ina cikin matsananciyar bukata;","poem":2},{"text":"ka cece ni daga waɗanda suke fafarata,","poem":1},{"text":"gama sun fi ni ƙarfi sosai.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ka ’yantar da ni daga kurkuku,","poem":1},{"text":"don in yabi sunanka.","poem":2},{"text":"Ta haka masu adalci za su taru kewaye da ni","poem":1},{"text":"saboda alherinka gare ni.","poem":2}]}],"footnotes":[{"noteId":79,"caller":"+","text":"Kan maganar, mai yiwuwa kalmar waƙa ce.","reference":{"chapter":142,"verse":0}}]},"thisChapterLink":"/api/hau_bib/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hau_bib/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hau_bib/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}