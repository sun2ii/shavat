{"translation":{"id":"hau_bib","name":"Biblica® Buɗaɗɗen Littafi Mai Tsarki, Sabon Rai Don Kowa™","website":"https://ebible.org/Scriptures/details.php?id=hausa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hausa","licenseNotes":null,"shortName":"BIB","englishName":"Hausa Contemporary Bible","language":"hau","textDirection":"ltr","sha256":"c2ada3e8c0e614c336e649825fda5e2d44fa0d148d2a19de6b76d5e8eb7dd816","availableFormats":["json"],"listOfBooksApiLink":"/api/hau_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31087,"languageName":"Hausa","languageEnglishName":"Hausa"},"book":{"id":"PSA","translationId":"hau_bib","name":"Zabura","commonName":"Zabura","title":"Zabura","order":19,"numberOfChapters":150,"sha256":"3305cedf5350f741272c6666397410271bbc2bcb3c7178fb884fdcde9d26b5a3","firstChapterNumber":1,"firstChapterApiLink":"/api/hau_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hau_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"Yabi Ubangiji.","poem":1},{"noteId":85},{"lineBreak":true},{"text":"Ku rera sabuwar waƙa ga Ubangiji,","poem":1},{"text":"yabonsa a cikin taron tsarkaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bari Isra’ila su yi farin ciki da Mahaliccinsu;","poem":1},{"text":"bari mutanen Sihiyona su yi murna da Sarkinsu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bari su yabi sunansa tare da rawa","poem":1},{"text":"suna kuma yin kiɗi gare shi da ganga da garaya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gama Ubangiji yana jin daɗin mutanensa;","poem":1},{"text":"yakan darjanta masu sauƙinkai da ceto.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bari tsarkaka su yi farin ciki a wannan bangirma","poem":1},{"text":"su kuma rera don farin ciki a kan gadajensu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bari yabon Allah yă kasance a bakunansu","poem":1},{"text":"takobi mai kaifi kuma a hannuwansu,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"don su ɗau fansa a kan al’ummai","poem":1},{"text":"da kuma hukunci a kan mutane,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"don su ɗaura sarakuna da sarƙoƙi,","poem":1},{"text":"manyan garinsu da sarƙoƙin ƙarfe,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"don su yi hukuncin da aka rubuta a kansu.","poem":1},{"text":"Wannan ne ɗaukakar dukan tsarkakansa.","poem":2},{"lineBreak":true},{"text":"Yabi Ubangiji.","poem":1}]}],"footnotes":[{"noteId":85,"caller":"+","text":"Da Ibraniyanci Hallelu Ya; haka ma a aya 9.","reference":{"chapter":149,"verse":1}}]},"thisChapterLink":"/api/hau_bib/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hau_bib/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hau_bib/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}