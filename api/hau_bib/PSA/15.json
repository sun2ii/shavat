","number":5,"content":[{"text":"wanda yake ba da rance ba tare da ruwa ba","poem":1},{"text":"kuma ba ya karɓan cin hanci don yă kā da marar laifi.","poem":2},{"lineBreak":true},{"text":"Shi wanda yake yin waɗannan abubuwa","poem":1},{"text":"ba zai taɓa jijjiguwa ba.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hau_bib/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hau_bib/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hau_bib/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}