{"translation":{"id":"hau_bib","name":"Biblica® Buɗaɗɗen Littafi Mai Tsarki, Sabon Rai Don Kowa™","website":"https://ebible.org/Scriptures/details.php?id=hausa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hausa","licenseNotes":null,"shortName":"BIB","englishName":"Hausa Contemporary Bible","language":"hau","textDirection":"ltr","sha256":"c2ada3e8c0e614c336e649825fda5e2d44fa0d148d2a19de6b76d5e8eb7dd816","availableFormats":["json"],"listOfBooksApiLink":"/api/hau_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31087,"languageName":"Hausa","languageEnglishName":"Hausa"},"book":{"id":"PSA","translationId":"hau_bib","name":"Zabura","commonName":"Zabura","title":"Zabura","order":19,"numberOfChapters":150,"sha256":"3305cedf5350f741272c6666397410271bbc2bcb3c7178fb884fdcde9d26b5a3","firstChapterNumber":1,"firstChapterApiLink":"/api/hau_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hau_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["Don mai bi da kaɗe-kaɗe. Da kayan kiɗi masu tsirkiya. Wani maskil",{"noteId":27},"ta Dawuda. Sa’ad da Zifawa suka tafi wurin Shawulu suka ce, “Ba Dawuda ba ne yake ɓuya a cikinmu?”"]},{"type":"verse","number":1,"content":[{"text":"Ka cece ni, ya Allah ta wurin sunanka;","poem":1},{"text":"ka nuna ni marar laifi ne ta wurin ƙarfinka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ka ji addu’ata, ya Allah;","poem":1},{"text":"ka saurari maganar bakina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Baƙi suna kawo mini hari;","poem":1},{"text":"mutane marasa imani suna neman raina,","poem":2},{"lineBreak":true},{"text":"mutanen da ba sa tsoron Allah. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tabbatacce Allah ne mai taimakona,","poem":1},{"text":"Ubangiji shi ne wanda yake riƙe ni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bari mugunta ta shaƙe masu magana marar kyau a kaina;","poem":1},{"text":"cikin amincinka ka hallaka su.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Zan miƙa hadaya ta yardar rai gare ka;","poem":1},{"text":"zan yabe sunanka, ya Ubangiji, gama yana da kyau.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gama ya cece ni daga dukan wahalolina,","poem":1},{"text":"idanuna kuma sun ga an yi nasara a kan maƙiyana.","poem":2}]}],"footnotes":[{"noteId":27,"caller":"+","text":"Kan magana, mai yiwuwa kalmar waƙa ce.","reference":{"chapter":54,"verse":0}}]},"thisChapterLink":"/api/hau_bib/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hau_bib/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hau_bib/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}