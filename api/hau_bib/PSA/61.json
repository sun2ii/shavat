sunanka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ka ƙara kwanakin ran sarki,","poem":1},{"text":"shekarunsa su kasance a zamanai masu yawa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bari yă yi mulki a gaban Allah har abada;","poem":1},{"text":"ka sa ƙaunarka da amincinka su tsare shi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Sa’an nan zan riƙa rera yabo ga sunanka","poem":1},{"text":"in kuma cika alkawarina kowace rana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hau_bib/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hau_bib/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hau_bib/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}