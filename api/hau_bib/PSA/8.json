{"translation":{"id":"hau_bib","name":"Biblica® Buɗaɗɗen Littafi Mai Tsarki, Sabon Rai Don Kowa™","website":"https://ebible.org/Scriptures/details.php?id=hausa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hausa","licenseNotes":null,"shortName":"BIB","englishName":"Hausa Contemporary Bible","language":"hau","textDirection":"ltr","sha256":"c2ada3e8c0e614c336e649825fda5e2d44fa0d148d2a19de6b76d5e8eb7dd816","availableFormats":["json"],"listOfBooksApiLink":"/api/hau_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31087,"languageName":"Hausa","languageEnglishName":"Hausa"},"book":{"id":"PSA","translationId":"hau_bib","name":"Zabura","commonName":"Zabura","title":"Zabura","order":19,"numberOfChapters":150,"sha256":"3305cedf5350f741272c6666397410271bbc2bcb3c7178fb884fdcde9d26b5a3","firstChapterNumber":1,"firstChapterApiLink":"/api/hau_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hau_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":8,"content":[{"type":"hebrew_subtitle","content":["Don mai bi da kaɗe-kaɗe. Bisa ga gittit.",{"noteId":4},"Zabura ta Dawuda."]},{"type":"verse","number":1,"content":[{"text":"Ya Ubangiji, shugabanmu,","poem":1},{"text":"sunanka da girma take a cikin dukan duniya!","poem":2},{"lineBreak":true},{"text":"Ka kafa ɗaukakarka","poem":1},{"text":"bisa sammai.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Daga leɓunan yara da jarirai","poem":1},{"text":"ka kafa yabo domin su sa abokan gābanka","poem":2},{"lineBreak":true},{"text":"da masu ɗaukan fansa su yi shiru.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sa’ad da na dubi sammai,","poem":1},{"text":"aikin yatsotsinka,","poem":2},{"text":"wata da taurari","poem":1},{"text":"waɗanda ka ajiye a wurarensu,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"wane ne mutum da kake tunawa da shi,","poem":1},{"text":"ɗan mutum da kake lura da shi?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ka yi shi ƙasa kaɗan da Allah","poem":1},{"noteId":5},{"text":"ka yi masa rawani da ɗaukaka da girma.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ka mai da shi mai mulki bisa ayyukan hannuwanka;","poem":1},{"text":"ka sa kome a ƙarƙashin ƙafafunsa,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"dukan shanu da tumaki,","poem":1},{"text":"da kuma namun jeji,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"tsuntsayen sararin sama","poem":1},{"text":"da kifin teku,","poem":2},{"lineBreak":true},{"text":"da dukan abin da yake yawo a ƙarƙashin ruwan teku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ya Ubangiji, shugabanmu,","poem":1},{"text":"sunanka da girma take a cikin dukan duniya!","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Kan magana, mai yiwuwa wata kalmar kiɗi ce.","reference":{"chapter":8,"verse":0}},{"noteId":5,"caller":"+","text":"Ko kuwa da rayayyun sama","reference":{"chapter":8,"verse":5}}]},"thisChapterLink":"/api/hau_bib/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hau_bib/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hau_bib/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}