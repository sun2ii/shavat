{"translation":{"id":"hau_bib","name":"Biblica® Buɗaɗɗen Littafi Mai Tsarki, Sabon Rai Don Kowa™","website":"https://ebible.org/Scriptures/details.php?id=hausa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hausa","licenseNotes":null,"shortName":"BIB","englishName":"Hausa Contemporary Bible","language":"hau","textDirection":"ltr","sha256":"c2ada3e8c0e614c336e649825fda5e2d44fa0d148d2a19de6b76d5e8eb7dd816","availableFormats":["json"],"listOfBooksApiLink":"/api/hau_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31087,"languageName":"Hausa","languageEnglishName":"Hausa"},"book":{"id":"PSA","translationId":"hau_bib","name":"Zabura","commonName":"Zabura","title":"Zabura","order":19,"numberOfChapters":150,"sha256":"3305cedf5350f741272c6666397410271bbc2bcb3c7178fb884fdcde9d26b5a3","firstChapterNumber":1,"firstChapterApiLink":"/api/hau_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hau_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["Zabura ta Asaf."]},{"type":"verse","number":1,"content":[{"text":"Allah yana shugabanta cikin babban taro;","poem":1},{"text":"yakan zartar da hukunci a cikin “alloli”.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Har yaushe za ku kāre marasa adalci","poem":1},{"text":"ku kuma goyi bayan mugaye? Sela","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ku tsare mutuncin marasa ƙarfi da marayu;","poem":1},{"text":"ku kāre hakkin matalauta da waɗanda ake danniya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ku ceci marasa ƙarfi da masu bukata;","poem":1},{"text":"ku kuɓutar da su daga hannun mugaye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Ba su san kome ba, ba su fahimci kome ba.","poem":1},{"text":"Suna yawo cikin duhu;","poem":2},{"lineBreak":true},{"text":"an girgiza dukan tussan duniya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Na ce, ‘Ku “alloli” ne;","poem":1},{"text":"dukanku ’ya’yan Mafi Ɗaukaka’ ne.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Amma za ku mutu kamar mutum kurum;","poem":1},{"text":"za ku fāɗi kamar duk wani mai mulki.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ka tashi, ya Allah, ka shari’anta duniya,","poem":1},{"text":"gama dukan al’ummai gādonka ne.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hau_bib/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hau_bib/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hau_bib/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}