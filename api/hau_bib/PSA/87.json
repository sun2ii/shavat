{"translation":{"id":"hau_bib","name":"Biblica® Buɗaɗɗen Littafi Mai Tsarki, Sabon Rai Don Kowa™","website":"https://ebible.org/Scriptures/details.php?id=hausa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hausa","licenseNotes":null,"shortName":"BIB","englishName":"Hausa Contemporary Bible","language":"hau","textDirection":"ltr","sha256":"c2ada3e8c0e614c336e649825fda5e2d44fa0d148d2a19de6b76d5e8eb7dd816","availableFormats":["json"],"listOfBooksApiLink":"/api/hau_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1190,"totalNumberOfVerses":31087,"languageName":"Hausa","languageEnglishName":"Hausa"},"book":{"id":"PSA","translationId":"hau_bib","name":"Zabura","commonName":"Zabura","title":"Zabura","order":19,"numberOfChapters":150,"sha256":"3305cedf5350f741272c6666397410271bbc2bcb3c7178fb884fdcde9d26b5a3","firstChapterNumber":1,"firstChapterApiLink":"/api/hau_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hau_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"hebrew_subtitle","content":["Na ’ya’yan Kora maza. Zabura ce. Waƙa ce."]},{"type":"verse","number":1,"content":[{"text":"Ya kafa harsashinsa a kan dutse mai tsarki.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ubangiji yana ƙaunar ƙofofin Sihiyona","poem":1},{"text":"fiye da dukan wuraren zaman Yaƙub.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ana faɗin abubuwa masu ɗaukaka game da ke","poem":1},{"text":"Ya birnin Allah, Sela","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Zan lissafta Rahab","poem":1},{"text":"a cikin waɗanda suka san ni,","poem":2},{"text":"Filistiya ita ma, da Taya, tare da Kush,","poem":1},{"text":"zan kuma ce, ‘An haifi wannan a Sihiyona.’ ”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tabbatacce, game da Sihiyona za a ce,","poem":1},{"text":"“Wannan da wancan an haifa a cikinta,","poem":2},{"lineBreak":true},{"text":"Mafi Ɗaukaka kansa zai kafa ta.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ubangiji zai rubuta a littafin sunayen mutanensa,","poem":1},{"text":"“An haifi wannan a Sihiyona.” Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yayinda suke kaɗe-kaɗe za su rera,","poem":1},{"text":"“Dukan maɓulɓulaina suna cikinki.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hau_bib/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hau_bib/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hau_bib/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}