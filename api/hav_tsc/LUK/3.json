{"translation":{"id":"hav_tsc","name":"Nouveau Testament Havu","website":"https://ebible.org/Scriptures/details.php?id=hav","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hav","licenseNotes":null,"shortName":"TSC","englishName":"Havu NT","language":"hav","textDirection":"ltr","sha256":"8f708eadc3efbdcb4024761542db2835b876c6c052dc45bcb2e99c5f7fcea482","availableFormats":["json"],"listOfBooksApiLink":"/api/hav_tsc/books.json","numberOfBooks":2,"totalNumberOfChapters":52,"totalNumberOfVerses":2155,"languageName":"Havu","languageEnglishName":"Havu"},"book":{"id":"LUK","translationId":"hav_tsc","name":"LUUKA","commonName":"LUUKA","title":"oMwazi Mwinja gwa Yeesu Krisitu nk'oku LUUKA aguyandikaga","order":42,"numberOfChapters":24,"sha256":"408d3c571c88245f94a0b52d3fb04cdc55cfab29467c30f996a0c2bfd7c77598","firstChapterNumber":1,"firstChapterApiLink":"/api/hav_tsc/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/hav_tsc/LUK/24.json","totalNumberOfVerses":1150},"chapter":{"number":3,"content":[{"type":"heading","content":["Enyigirizo za Yohaana Mubatiiza"]},{"type":"verse","number":1,"content":["Omu mwaka gw'ekumi na garhaano g'oburhegesi bw'omwami mukulu w'aBarooma Kayizaari Tiberiyo, Ponsiyo Pilaato aliiri mwimangizi w'egihugo ch'eYudeeya. Na Heroode aliiri mwimangizi w'egihugo ch'eGalilaaya na mwene waabo oyirikwa Firipo omu gihugo ch'eItureya na ech'eTarakoniiti. Lisaniya naye aliiri mwimangizi w'egihugo ch'eHabileeni."]},{"type":"verse","number":2,"content":["Hanaasi na Kayaafa bo baliiri bakulu b'abadaahwa. Mwamo mango, echinwa cha Nnamahanga chahikira Yohaana mugala wa Zakariya omu mpinga."]},{"type":"verse","number":3,"content":["Yohaana agera omu bihugo byooshi byalitureene n'olwinji lw'eYorodaani. Aliiri kuyaamagaza ntya: «Muleke ebyaaha byenyu, mubatiizwe yi Nnamahanga ababalira.»"]},{"type":"verse","number":4,"content":["Na ntya byaava byaagera ho eby'omuleebi Isaya ayandikaga omu gitaabu chaage mpu:",{"text":"«Muntu muguma ali ahamagaza omu mpinga:","poem":1},{"lineBreak":true},{"text":"‹Murheganye enjira ya Nnaweerhu.","poem":1},{"lineBreak":true},{"text":"Mumujirire enjira zilambuukire!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ngasi lubanda nji lwayunjuzwa,","poem":1},{"lineBreak":true},{"text":"ngasi musozi na ngasi hirhondo nji byalambuulwa,","poem":1},{"lineBreak":true},{"text":"ngasi rukumba lw'enjira nji lwagonyoolwa.","poem":1},{"lineBreak":true},{"text":"Enjira zibiihire nji zalambuulwa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Na ngasi muntu nj'abona obuchunguke Nnamahanga ahaana.›»","poem":1},{"noteId":5}]},{"type":"heading","content":["Amahano ma Yohaana Mubatiiza"]},{"type":"verse","number":7,"content":["Abantu banene bayinja emwa Yohaana mpu ababatiize. Alema ababwira ntya: «Mwe buuko bw'enjoka, nde wabayigiriize guchilanga oku buhane bwayinjire?"]},{"type":"verse","number":8,"content":["Leero, muleme mwayeerekana kugerera ebijiro binja oku mwalekere ebyaaha byenyu. Murhachibwiraga mpu: ‹Abrahaamu ali shookuluza weerhu.› Kwenge mbabwirire oku Nnamahanga agakoleesa ama mabaale n'okumajira baana ba Abrahaamu!"]},{"type":"verse","number":9,"content":["Embasha ekola eri hoofu guchiira emirhi oku mizi. Nkaasi murhi gurhayeezeze amalehe menja, gwachiibwa n'ogukabulwa omu muliro.»"]},{"type":"heading","content":["Oguhindamuka looshi"]},{"type":"verse","number":10,"content":["Abantu baliiri kumubaza ntya: «Gichi rhujaage rhwajira?»"]},{"type":"verse","number":11,"content":["Abashubiza ntya: «Ogwerhe simiisi ebiri agwasizwe guhaana nguma okw'orhayigwerhe. Ogwerhe ech'okulya naye ajire ntyo.»"]},{"type":"verse","number":12,"content":["Ab'ogufurhiisa amakooli nabo bayinja kubatiizwa. Baabaza Yohaana ntya: «Mwigiriza, bichi rhukwaneene kujira?»"]},{"type":"verse","number":13,"content":["Ashubiza bo ntya: «Murhahoreesaga binene kulusha ebi murhegekerwe guhoreesa.»"]},{"type":"verse","number":14,"content":["Abasoda nabo baamubaza ntya: «Neerhu, bichi rhukwaneene kujira?» Ashubiza bo ntya: «Murhanyagaga omuntu ehyaage changwa gusidaaka omuntu oku bushaabusha. Aliko musimiiswe n'omukamarho gwenyu.»"]},{"type":"heading","content":["Yohaana Mubatiiza abala omwazi g'owayinjire"]},{"type":"verse","number":15,"content":["Olubaga lwaliiri kulingiriza n'obulangaalire, ngasi muguma aliiri gukengeera omu murhima gwage oku nkabaga Yohaana ye Krisitu."]},{"type":"verse","number":16,"content":["Yohaana abwira bo ntya: «Nyoono ndi nababatiiza omu menji; aliko owayinja agwerhe obuhashe kundusha. Ntakwaneene chiro gushwekuula omugozi gw'ebiraato byaage. Yeewe nj'ababatiiza na Muuka-Mutagatiifu, n'omu muliro."]},{"type":"verse","number":17,"content":["Afarhire omu fune zaage engooko y'okuyeera, abiiza echibuga chaage; ahira amahemba olwage lunda n'emyaavu olwage lunda. Nj'agusha amahemba omu nguli yaage, sy'aliko nj'ayoosa emyaavu omu muliro gurhazima chiro n'ehityu.»"]},{"type":"heading","content":["Ogushwekwa kwa Yohaana Mubatiiza"]},{"type":"verse","number":18,"content":["Yohaana ayigiriza olubaga oMwazi Mwinja omu kubaheereza ezindi nyigirizo zinene z'okubaseeza omurhima."]},{"type":"verse","number":19,"content":["Aliko Yohaana akalihira Heroode, wali yimire omu gihugo ch'eGalilaaya, kwenge aliyingiire Herodiya muka mwene waabo, n'okwenge abaaga ey'akolere ebindi bijiro binene bibiihire."]},{"type":"verse","number":20,"content":["Kw'ebyo byooshi, Heroode ayongeera ko echindi chijiro chibi ch'oguhiriisa Yohaana omu munyororo."]},{"type":"heading","content":["Okubatiizwa kwa Yeesu"]},{"type":"verse","number":21,"content":["Abantu booshi babeere bamala kubatiizwa, Yeesu naye abatiizwa. Olo lusiku, oku Yeesu ali gusaliira, empingu yagichinguula,"]},{"type":"verse","number":22,"content":["Muuka-Mutagatiifu amuyandagalira ko omu shusho ly'eguuku. Omulenge gwayunviikana ntya gurhengera empingu: «Oli Mugala waani muzigirwa; nsimiisizwe nawe bweneene.»",{"noteId":6}]},{"type":"heading","content":["Egisisi cha Yeesu"]},{"type":"verse","number":23,"content":["Amango Yeesu arhonderaga kuyigiriza, aligwerhe emyaaka yakagera ku makumyaasharhu. Abantu baliiri kumurhoola nka mwene Yozefu.",{"text":"Yozefu aliiri Mugala wa Heeli,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Heeli aliiri mugala wa Mataati,","poem":1},{"lineBreak":true},{"text":"Mataati aliiri mugala wa Laawi,","poem":1},{"lineBreak":true},{"text":"Laawi aliiri mugala wa Meleki,","poem":1},{"lineBreak":true},{"text":"Meleki aliiri mugala wa Janaayi,","poem":1},{"lineBreak":true},{"text":"Janaayi aliiri mugala wa Yozefu,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Yozefu aliiri mugala wa Matatiyaasi,","poem":1},{"lineBreak":true},{"text":"Matatiyaasi aliiri mugala wa Amoosi,","poem":1},{"lineBreak":true},{"text":"Amoosi aliiri mugala wa Nahuumu,","poem":1},{"lineBreak":true},{"text":"Nahuumu aliiri mugala wa Esuuli,","poem":1},{"lineBreak":true},{"text":"Esuuli aliiri mugala wa Nagaayi,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nagaayi aliiri Mugala wa Maati,","poem":1},{"lineBreak":true},{"text":"Maati aliiri mugala wa Matatiyaasi,","poem":1},{"lineBreak":true},{"text":"Matatiyaasi aliiri mugala wa Semeyini,","poem":1},{"lineBreak":true},{"text":"Semeyini aliiri mugala wa Yezeechi,","poem":1},{"lineBreak":true},{"text":"Yezeechi aliiri mugala wa Yooda,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Yooda aliiri Mugala wa Yohanaani,","poem":1},{"lineBreak":true},{"text":"Yohanaani aliiri mugala wa Reesa,","poem":1},{"lineBreak":true},{"text":"Reesa aliiri mugala wa Zorobabeeli,","poem":1},{"lineBreak":true},{"text":"Zorobabeeli aliiri mugala wa Shalitiyeeri,","poem":1},{"lineBreak":true},{"text":"Shalitiyeeri aliiri mugala wa Neeri,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Neeri aliiri mugala wa Meleechi,","poem":1},{"lineBreak":true},{"text":"Meleechi aliiri mugala wa Aadi,","poem":1},{"lineBreak":true},{"text":"Aadi aliiri mugala wa Gosaame,","poem":1},{"lineBreak":true},{"text":"Gosaame aliiri mugala wa Elimadaame,","poem":1},{"lineBreak":true},{"text":"Elimadaame aliiri mugala wa Ere,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ere aliiri mugala wa Yooshuwa,","poem":1},{"lineBreak":true},{"text":"Yooshuwa aliiri mugala wa Eliyezeeri,","poem":1},{"lineBreak":true},{"text":"Eliyezeeri aliiri mugala wa Yoriime,","poem":1},{"lineBreak":true},{"text":"Yoriime aliiri mugala wa Mataati,","poem":1},{"lineBreak":true},{"text":"Mataati aliiri mugala wa Laawi,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Laawi aliiri mugala wa Simeooni,","poem":1},{"lineBreak":true},{"text":"Simeooni aliiri mugala wa Yuuda,","poem":1},{"lineBreak":true},{"text":"Yuuda aliiri mugala wa Yozefu,","poem":1},{"lineBreak":true},{"text":"Yozefu aliiri mugala wa Yonaami,","poem":1},{"lineBreak":true},{"text":"Yonaami aliiri mugala wa Eliyakiimu,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Eliyakiimu aliiri mugala wa Meleeya,","poem":1},{"lineBreak":true},{"text":"Meleeya aliiri mugala wa Meena,","poem":1},{"lineBreak":true},{"text":"Meena aliiri mugala wa Mattata,","poem":1},{"lineBreak":true},{"text":"Mattata aliiri mugala wa Nataamu,","poem":1},{"lineBreak":true},{"text":"Nataamu aliiri mugala wa Daawudi,","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Daawudi aliiri mugala wa Yeese,","poem":1},{"lineBreak":true},{"text":"Yeese aliiri mugala wa Yobeedi,","poem":1},{"lineBreak":true},{"text":"Yobeedi aliiri mugala wa Boazi,","poem":1},{"lineBreak":true},{"text":"Boazi aliiri mugala wa Saala,","poem":1},{"lineBreak":true},{"text":"Saala aliiri mugala wa Nasooni,","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Nasooni aliiri mugala wa Aminadaabu,","poem":1},{"lineBreak":true},{"text":"Aminadaabu aliiri mugala wa Adimiini,","poem":1},{"lineBreak":true},{"text":"Adimiini aliiri mugala wa Ariini,","poem":1},{"lineBreak":true},{"text":"Ariini aliiri mugala wa Hesiroomi,","poem":1},{"lineBreak":true},{"text":"Hesiroomi aliiri mugala wa Pereesi,","poem":1},{"lineBreak":true},{"text":"Pereesi aliiri mugala wa Yuuda,","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Yuuda aliiri mugala wa Yakobo,","poem":1},{"lineBreak":true},{"text":"Yakobo aliiri mugala wa Isaka,","poem":1},{"lineBreak":true},{"text":"Isaka aliiri mugala wa Abrahaamu,","poem":1},{"lineBreak":true},{"text":"Abrahaamu aliiri mugala wa Teera,","poem":1},{"lineBreak":true},{"text":"Teera aliiri mugala wa Nahoori,","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Nahoori aliiri mugala wa Seruugi,","poem":1},{"lineBreak":true},{"text":"Seruugi aliiri mugala wa Reehu,","poem":1},{"lineBreak":true},{"text":"Reehu aliiri mugala wa Peleegi,","poem":1},{"lineBreak":true},{"text":"Peleegi aliiri mugala wa Hebeeri,","poem":1},{"lineBreak":true},{"text":"Hebeeri aliiri mugala wa Sheela,","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Sheela aliiri mugala wa Kenaani,","poem":1},{"lineBreak":true},{"text":"Kenaani aliiri mugala wa Arapakasaadi,","poem":1},{"lineBreak":true},{"text":"Arapakasaadi aliiri mugala wa Seemu,","poem":1},{"lineBreak":true},{"text":"Seemu aliiri mugala wa Noowa,","poem":1},{"lineBreak":true},{"text":"Noowa aliiri mugala wa Lameeki,","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Lameeki aliiri mugala wa Matusaleemi,","poem":1},{"lineBreak":true},{"text":"Matusaleemi aliiri mugala wa Henooka,","poem":1},{"lineBreak":true},{"text":"Henooka aliiri mugala wa Yereedi,","poem":1},{"lineBreak":true},{"text":"Yereedi aliiri mugala wa Malaleeli,","poem":1},{"lineBreak":true},{"text":"Malaleeli aliiri mugala wa Kenaani,","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Kenaani aliiri mugala wa Enoosi,","poem":1},{"lineBreak":true},{"text":"Enoosi aliiri mugala wa Seeti,","poem":1},{"lineBreak":true},{"text":"Seeti aliiri mugala wa Adaamu,","poem":1},{"lineBreak":true},{"text":"Adaamu aliiri mugala wa Nnamahanga.","poem":1}]}],"footnotes":[{"noteId":5,"caller":"+","text":"3.6 Osome Isaya 40.3-5luyandikirwe omu mandiko ma miira m'ekigiriki.","reference":{"chapter":3,"verse":6}},{"noteId":6,"caller":"+","text":"3.22 Osome Nanga 2.7; Isaya 42.1.","reference":{"chapter":3,"verse":22}}]},"thisChapterLink":"/api/hav_tsc/LUK/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hav_tsc/LUK/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hav_tsc/LUK/2.json","previousChapterAudioLinks":{},"numberOfVerses":38}