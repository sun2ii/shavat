{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"EST","translationId":"haw_868","name":"Esetera","commonName":"Esetera","title":"Esetera","order":17,"numberOfChapters":10,"sha256":"2d51a988ad80e0825340a88fa58c2464e2dba4f0cc2ec5e7b591d2625aaeaae4","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/EST/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/haw_868/EST/10.json","totalNumberOfVerses":167},"chapter":{"number":10,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"A UHAU aku la o Ahasuero i ka aina, a i na mokupuni hoi o ka moana.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A o na mea a kona mana a me kona ikaika i hana'i, a me ka hai ana i ke kiekie o Moredekai, kahi i hookiekie ai ke alii ia ia, aole anei ia i kakauia iloko o ka buke oihana a na'lii o Media a me Peresia?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"No ka mea, o Moredekai, o ka Iudaio, oia ka mea pili koke i ke alii, ia Ahasuero, a kiekie no hoi ia iwaena o na Iudaio, a ua makemakeia e ka lehulehu o kona poe hoahanau; a imi ia i mea e waiwai ai kona lahuikanaka, e olelo lokomaikai ana i kona poe hanauna a pau.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/EST/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/JOB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/EST/9.json","previousChapterAudioLinks":{},"numberOfVerses":3}