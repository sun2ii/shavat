{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"JOB","translationId":"haw_868","name":"Ioba","commonName":"Ioba","title":"Ioba","order":18,"numberOfChapters":42,"sha256":"d93714dc6f0da3759c787ea2105dcb73ef19a8febd2a3c2a6de039899349b1c4","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/haw_868/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":25,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"A LAILA olelo aku la o Biledada, no Suha, i aku la,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ia ia no ke alii ana a me ka makaulia, A hana no ia i ke kuikahi ma kona mau wahi kiekie.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ua heluia anei kona mau poe koa? A maluna owai la i puka ole mai ai kona malamalama?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A pehea la e hoaponoia'i ke kanaka imua o ke Akua? A pehea la e maemae ai ka mea i hanauia e ka wahine?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E nana i ka mahina, aole ia e aiai; A o na hoku aole e maemae imua o kona maka:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pehea la hoi ke kanaka, he enuhe; A me ke keiki a ke kanaka, he ilo?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}