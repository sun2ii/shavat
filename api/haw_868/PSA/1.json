{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"heading","content":["KA BUKE"]},{"type":"verse","number":1,"content":[{"text":"POMAIKAI ke kanaka i hele ole ma ke aoia o ka poe aia. I ku ole hoi ma ka aoao o ka poe hewa, I noho ole hoi ma ka noho o ka poe haakei.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aka, ma ke kanawai o Iehova kona olioli; A ma kona kanawai oia i manao ai i ke ao a me ka po.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"E like no ia me ka laau i kanuia ma na kahawai, I hoohua mai i kona hua i kona manawa; A o kona lau hoi aole e mae; A o kona mea e hana'i e pono ana no ia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Aole hoi e like me neia ka poe aia; Aka, ua like ia me ka opala i puehu i ka makani.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nolaila, aole e ku ana ka poe aia ma ka hookolokolo ana, Aole hoi ka poe hewa iloko o ka ka poe pono anaina.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"No ka mea, ua ike mai la o Iehova i ka aoao o ka poe maikai; Aka hoi, o ka aoao o ka poe hewa, e make ana no ia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}