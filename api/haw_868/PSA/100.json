{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":100,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"E HOOHO olioli oukou, ia Iehova, e na aina a pau.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"E malama ia Iehova me ka kauoli: E hele aku imua ona me ka oli ana.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"E ike hoi oukou, o Iehova, oia no ke Akua, Nana kakou i hana, aole na kakou iho: O kona poe kanaka hoi kakou, A me na hipa ana i hanai ai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"E komo oukou iloko o kona ipuka me ka mililani, A iloko hoi o kona kahua me ka halelu; E mililani aku ia ia, a e hoomaikai aku hoi i kona inoa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"No ka mea, ua maikai o Iehova; Ua mau loa kona lokomaikai, A me kona oiaio hoi i na hanauna a pau.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}