{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"OLELO mai la o Iehova i kuu Haku, E noho mai oe ma ko'u lima akau, A hoolilo iho ai au i kou poe enemi I keehana wawae nou.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"E hoouna mai no o Iehova i ke kookoo o kou ikaika, mai Ziona mai; E noho aupuni hoi oe mawaena o kou poe enemi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"E ae oluolu mai no kou poe kanaka ke hiki ka la o kou ikaika, Me ka mea nani hoano, Mai ka opu mai o ka wanaao, Ia oe ka hau o kou poe opiopio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ua hoohiki mai la o Iehova, aole hoi oia e luli ae, He kahuna mau loa no oe, mamuli o ke ano o Melekizedeka.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma kou lima akau ka Haku, E paopao ai i na'lii i kona la e huhu ai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nana no e hoopai iwaena o ko na aina e, A e hoopiha i na wahi i na kupapau; A nana no e paopao i na poo maluna o na aina he nui loa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma ke ala no oia e inu ai i ka muliwai; Nolaila, e hookiekie oia i ke poo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}