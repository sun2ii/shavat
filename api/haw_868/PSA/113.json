{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"E HALELU aku ia Iehova: E halelu, e na kauwa a Iehova, E halelu aku oukou i ka inoa o Iehova.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"E hoomaikaiia ka inoa o Iehova, Mai keia wa aku a i ka manawa pau ole.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mai ka puka ana a ka la, a hiki i kona komo ana, E haleluia ka inoa o Iehova.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ua kiekie o Iehova, maluna o ko na aina a pau, A me kona hanohano hoi maluna o ka lani.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Owai la ka i like me Iehova, ko kakou Akua? Ka mea hookiekie i kona wahi nobo ai;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ka mea hoohaahaa, e ike i ka lani, A i ka honua no hoi:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ka mea i hapai i ka mea ilihune, mai ka lepo mai, A hookiekie hoi i ka mea pilikia, mai ke kiona aku;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I hoonoho ai oia ia ia me na'lii, Me na'lii hoi o kona poe kanaka.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A hoonoho hoi oia i ka wahine pa ma ka hale, I makuwahine, e lealea ana i na keiki ana. E halelu aku oukou ia Iehova.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}