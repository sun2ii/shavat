{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"KA hale o Iakoha hoi, mai waena aku o na kanaka olelo e;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O Iuda no kona keenakapu, A o Iseraela kona aupuni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ike mai la ke kai, a holo aku la; A huli hope o Ioredane.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lelele ae la na mauna e like me na hipakane, A me na puu hoi e like me na keikihipa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Heaha kau, e ke kai, i holo aku ai oe? E Ioredane hoi, i hoohuliia'i oe ihope?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E na mauna, i lelele ai oukou e like me na hipakane? A me na puu hoi e like me na keikihipa?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"E naueue oe, e ka honua, imua o ka Haku, Imua hoi o ke Akua o Iakoha.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ka mea i hoolilo i ka pohaku, i wai lana, A me ka pohaku paea, i punawai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}