{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"I LOKO o ko'u pilikia, kahea aku la au ia Iehova, A hoolohe mai la oia ia'u.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"E Iehova, e hoopakele mai oe i ko'u uhane i na lehelehe wahahee, A me ke elelo hoopunipuni.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Heaha ka mea e haawiia'ku ai ia oe, A e hoopili hou ia mai ai ia oe, E ke elelo hoopunipuni?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Na pua oi o ka mea ikaika, A me na lanahu rotema.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Auwe hoi au'i ko'u noho malihini ana ma Meseka, I ko'u noho ana hoi ma na halelewa o Kedera!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ua noho loihi ko'u uhane, Me ka mea i inaina mai i ka maluhia.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma ka maluhia no wau; a ia'u e olelo aku ai, Ma ke kaua no lakou la.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}