{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":121,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"E LEHA aku au i ko'u mau maka i na mauna, Mailaila mai ko'u kokua e hiki mai ai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mai Iehova mai ko'u kokua, Nana no i hana i ka lani, a me ka honua.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aole ia e haawi i kou wawae i ke kulanalana; O ka mea malama ia oe, aole ia e maluhiluhi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aia hoi, o ka mea malama i ka Iseraela, Aole ia e maluhiluhi, aole ia e hiamoe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"O Iehova no kou kiai; O Iehova no kou malu, ma kou lima akau.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aole e hahau mai ka la ia oe i ke ao, Aole hoi o ka mahina i ka po.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E malama mai no o Iehova ia oe i ka ino a pau; Nana no e malama i kou uhane.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"E kiai no o Iehova i kou puka ana iwaho a me kou komo ana iloko, Mai keia wa a ka manawa pau ole.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}