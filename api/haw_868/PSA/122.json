{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"O LIOLI aku la au, ia lakou i olelo mai ai ia'u, E hele kakou iloko o ka hale o Iehova.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"E ku no ko kakou mau wawae, Maloko o kou mau pukapa, e Ierusalema.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ua hoonohonohoia o Ierusalema, E like me ke kulanakauhale i kapiliia.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pii aku no na ohana malaila, Na ohana hoi o Iehova, me kana i kauoha ai i ka Iseraela, E hoolea aku i ka inoa o Iehova.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"No ka mea, ua hoonohoia malaila na nohoalii no ka hoopono, Na nohoalii no ka ohana a Davida.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"E noi aku oukou i maluhia o Ierusalema; E pomaikai auanei ka poe e aloha aku ia oe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I noho ka maluhia iloko o kou mau pa, A me ka pomaikai iloko o kou halealii.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"No ko'u poe hoahanau, a no ko'u poe makamaka, E olelo aku no wau, ano la, i maluhia maloko ou.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"No ka hale o Iehova, o ko kakou Akua, E imi aku no wau, i ka pono nou.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}