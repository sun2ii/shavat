{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":123,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"I A oe no wau e leha aku nei i ko'u mau maka, E ka mea e noho la ma ka lani.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aia hoi, e like me na maka o na kauwakane, I ka lima o ko lakou haku, E like hoi me na maka o ke kauwawahine, I ka lima o kona haku wahine; Pela no ko kakou maka ia Iehova i ko kakou Akua, A aloha mai oia ia makou.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"E aloha mai oe ia makou, o Iehova, E aloha mai oe ia makou; No ka mea, ua ana loa makou i ka hoowahawahaia.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ua ana loa ko makou uhane i ka hoomaewaewa ana o ka poe hookano, A me ka hoowahawaha ana o ka poe hookiekie.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}