{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":124,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"I NA aole i noho pu o Iehova me kakou, Wahi a ka Iseraela,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ina aole i noho pu o Iehova me kakou, I ka wa i ala ku e mai ai na kanaka ia kakou,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ina ua moni koke mai lakou ia kakou, I ka wela ana o ko lakou huhu ia kakou.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ina ua poipu hoi na wai maluna o kakou, A ua hiki mai ka waikahe maluna o ko kakou uhane:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ina ua kahe no hoi ka waiholomoku maluna o ko kakou uhane.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"E hoomaikaiia o Iehova, Ka mea haawi ole ia kakou i waiwai pio i ko lakou niho.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ua hoopakeleia no ko kakou uhane, Me he manu la, mai ka hei ana aku i ka poe lawaiamanu; Ua moku ka upena a ua hoopakeleia kakou.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aia no ko kakou kokua, maloko o ka inoa o Iehova, Ka mea nana i hana ka lani me ka honua.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}