{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":125,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"O KA poe hilinai aku ia Iehova, E like no lakou me ka mauna o Ziona, Aole ia e naue, e noho mau loa no.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ua puni o Ierusalema i na mauna, Pela o Iehova e hoopuni ai i kona poe kanaka, Mai keia wa aku, a i ka manawa pau ole.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aole e waihoia ke kookoo o ka poe hewa, Ma ka puu o ka poe pono; O kau aku ka poe pono i ko lakou lima ma ka hewa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"E hana maikai mai oe, e Iehova, i ka poe maikai, A i ka poe hoi i pololei ma ko lakou naau.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"O ka poe kapae ma ko lakou ala keekee, E alakai pu aku no o Iehova ia lakou me ka poe hana lapuwale; A he malu no maluna o ka Iseraela.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}