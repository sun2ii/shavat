{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"I NA aole o Iehova e kukulu i ka hale, Hooikaika make hewa ka poe nana e kukulu: Ina aole o Iehova e malama i ke kulanakauhale, Make hewa ka makaala ana o ka poe malama.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"He mea wale ia oukou ke ala i kakahiaka nui Mahope o ka hoomaha ana, E ai i ka ai o ka hookaumahaia; No ka mea, pela oia e hoomoe ai i kona poe aloha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Aia hoi! o na keiki, he hooilina lakou no Iehova mai; A o ka hua o ka opu, he uku no ia.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"E like me na pua ma ka lima o ke kanaka ikaika, Pela no na keiki a ka poe opiopio.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pomaikai ke kanaka ke piha kana aapua ia lakou; Aole lakou e hilahila, No ka mea, e olelo no lakou i na enemi ma ka puka pa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}