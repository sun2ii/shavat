{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":128,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"POMAIKAI ka poe a pau i makau aku ia Iehova, A hele hoi ma kona mau alanui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"E ai no oe i ka waiwai o kou mau lima, He pomaikai no kou, a he pono no hoi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"E like no kau wahine me na kumuwaina hua nui, Ma na aoao o kou hale; E like no hoi kau mau keiki me na laau oliva, E ku puni ana i kou papaaina.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aia hoi! pela e hoopomaikaiia mai ai ke kanaka, Nana e makau aku ia Iehova.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"E hoomaikai mai o Iehova ia oe mai Ziona mai; A e ike no oe i ka pono o Ierusalema, I na la a pau o kou ola ana.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E ike no hoi oe i na keiki o kau poe keiki, A me ka maluhia maluna o ka Iseraela.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}