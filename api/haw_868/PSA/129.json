{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"U A hoopilikia pinepine mai lakou ia'u, Mai ko'u wa opiopio mai, wahi a ka Iseraela;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ua hoopilikia pinepine mai lakou ia'u, mai ko'u wa opiopio mai; Aole nae lakou i lanakila mai maluna o'u.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma ko'u kua i kahakaha ai ka poe kahakaha; A hana lakou i ko lakou kaha a loihi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ua pono no o Iehova; Ua oki mai oia i na kaula o ka poe hewa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"E hoohilahilaia a e hoihoi hope ia mai, Ka poe a pau e inaina mai ia Ziona.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E like auanei lakou, me ka mauu maluna o na hale, Mae wale, ia mamua o ka liko ana.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aole e piha ka lima o ka mea i oki iho, Aole hoi ka umauma o ka mea hoopua i na pua.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aole hoi e olelo mai ka poe e hele ae, Maluna o oukou auanei ka hoomaikai ana o Iehova: Ke hoomaikai aku nei makou ia oukou ma ka inoa o Iehova.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}