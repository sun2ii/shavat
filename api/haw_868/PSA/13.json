{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"PEHEA la ka loihi o kou hoopoina ana mai ia'u, e Iehova? I ka manawa pau ole anei? Pehea la ka loihi o kou hoonalo ana i kou maka ia'u?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pehea la hoi ka loihi o ko'u kaukau ana iloko o ko'u uhane, Me ke kaniuhu iloko o ko'u naau i kela la a i keia la? Pehea la hoi ka loihi o ka hookiekie ana o ko'u enemi maluna o'u?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"E manao mai, e Iehova, e ko'u Akua, e hoolohe mai ia'u, E hoomalamalama i ko'u mau maka, o hiamoe au i ka make;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"O olelo mai paha kuu enemi, Ua lanakila au maluna ona; A hauoli no hoi ka poe i hana ino mai ia'u, ke haalulu au.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Aka hoi, ua hilinai aku au i kou aloha; E hauoli no hoi ko'u naau i kou ola.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E oli aku no au ia Iehova, No kona lokomaikai ana mai nei ia'u.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}