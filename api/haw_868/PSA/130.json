{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"MAILOKO o na wahi hohonu, ua kahea aku au i oe, e Iehova.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"E ka Haku e, e hoolohe mai oe i ko'u leo; E haliu mai kou pepeiao i ka leo o ko'u nonoi ana.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ina ma ka hala oe e haka pono mai ai, e Iehova, E ka Haku, owai la ka mea e ku.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aka, ma ou la ke kala ana o ka hala, I makauia'ku ai oe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ke kakali nei au, ke kakali nei ko'u uhane ia Iehova, A ke hoolana nei au ma kana olelo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ua oi aku ke kakali ana o ko'u uhane i ka Haku, Mamua o ko ka poe kiai kakali ana i ke ao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E kakali o ka Iseraela ia Iehova, no ka mea, Me Iehova no ka lokomaikai, a me ia no hoi ka hoolapanai nui wale.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nana no e hoolapanai i ka Iseraela, Mailoko aku o ko lakou hewa a pau.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}