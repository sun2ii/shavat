{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":131,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"E IEHOVA, aole i hookiekie ko'u naau, Aole hookano ko'u mau maka; Aole au i hele mamuli o ua mea nunui, A me na mea hakalia ia'u.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A i ole ia, ua hoona wau ia'u iho, a ua hoomalielie au i ko'u uhane, E like me ke keiki i ukuhiia e kona makuwahine; Ua like no ko'u uhane me ke keiki i ukuhiia.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"E hoolana o ka Iseraela ma Iehova, Mai keia wa aku. a i ke ao pau ole.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}