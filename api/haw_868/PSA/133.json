{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":133,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"A IA hoi, nani ka maikai a me ka oluolu, O ka noho lokahi pu ana o na hoahanau!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ua like ia me ka poni maikai ma ke poo, Ka mea i kahe ilalo ma ka umiumi, Ma ka umiumi hoi o Aarona, A hiki hoi ilalo i na kihi o kona mau aahu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ua like ia me ka hau o Heremona, Ka mea i haule mai maluna o na mauna o Ziona; No ka mea, malaila no i kauoha mai ai o Iehova i ka hoomaikaiia, I ke ola hoi, a hiki i ka manawa pau ole.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/133.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PSA/134.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/PSA/132.json","previousChapterAudioLinks":{},"numberOfVerses":3}