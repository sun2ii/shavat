{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":15,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"E IEHOVA, owai ka mea o noho iloko o kou halelewa? Owai hoi ka mea e noho ma kou mauna hoano?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O ka mea i hele ma ka pololei a i hana ma ka pono; A i olelo hoi ma ka oiaio iloko o kona naau:","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aole i aki me kona alelo, aole hoi i hana hewa i kona hoapili, Aole hoi i lawe i ka mea e hoinoia'i kona hoalauna.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A imua o kona maka i hoowahawahaia'i ke kanaka ino; Aka, ua mahalo no oia i ka poe e makau ia Iehova; A hoohiki no kona pono iho aole nae i lole hou ae:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aole i ho aku i kana moni no ka uku hoopanee; Aole hoi i lawe i ke kipe i hewa'i ka mea pono. O ka mea i hana ia mau mea, aole loa oia e kulanalana.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}