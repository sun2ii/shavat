{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":150,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"E HALELU aku oukou ia Iehova: E halelu aku i ke Akua, ma kona wahi hoano; E halelu aku ia ia, ma ke aouli o kona hanohano.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"E halelu aku ia ia, no kana mau hana mana; E halelu aku ia ia, e like me ka manomano o kona nui;","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"E halelu aku ia ia, me ke kani ana o ka pu; E halelu aku ia ia, me ka Violaumi a me ka Lira;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"E halelu aku ia ia, me ka pahukani, a me ka haa ana; E halelu aku ia ia, me ka pahu kaula, a me ka ohe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E halelu aku ia ia, me na kimebala kani nui; E halelu aku ia ia, me na kimebala kani kiekie.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E halelu aku ia Iehova, na mea hanu a pau; E halelu aku oukou ia Iehova.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}