{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"O IEHOVA ko'u Kahuhipa; Aole o'u mea e nele ai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nana no wau i hoomoe iho ma na aina uliuli: Ua alakai oia ia'u ma kapa wai lana malie.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ke hoala mai nei oia i ko'u uhane: Ke alakai nei no oia ia'u ma na ala maikai no kona inoa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Oiaio, ina e hele au ma ke awawa malu o ka make, Aole au e weliweli i ka poina: no ka mea, o oe pu kekahi me au; O kou mana, a me kou kookoo, o ko'u mau mea ia e oluolu ai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ke hoomakaukau mai nei oe i ka papaaina na'u ma ke alo o ko'u mau enemi: Ua kahinu mai oe i kuu poo me ka aila; Ua piha a hu ko'u kiaha.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Oiaio, e hahai mau ana ia'u ka pono a me ke aloha i na la a pau o ko'u ola ana; A maloko o ka hale o Iehova owau e noho mau loa aku ai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}