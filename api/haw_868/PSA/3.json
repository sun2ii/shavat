{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"E IEHOVA, ua mahuahua ae nei ko'u poe enemi; Ua nui no hoi ka poe i ku e mai ia'u.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lehulehu na mea i olelo mai no ko'u uhane, Aole ona kokua iloko o ke Akua. Sila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Aka, o oe, e Iehova, ka paku no'u; O ko'u nani, ka mea nana kuu poo e hapai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ua kahea aku wau ia Iehova me ka'u leo; Ua hoolohe mai no ia ia'u ma kona mauna hoano. Sila.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ua moe iho la au ilalo a hiamoe; Ua ala ae la hoi, no ko Iehova malama ana mai ia'u.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aole au e makau aku i na umi tausani o kanaka, O ka poe e ku e mai ia'u a puni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"E ku mai oe, e Iehova, e hoola mai ia'u, e kuu Akua; Ua pepehi oe i ko'u poe enemi a pau ma ke a; Ua uhai oe i na niho o ka poe aia.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"No Iehova ke ola; O kou hoomaikai ana maluna iho o kou poe ohua. Sila.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}