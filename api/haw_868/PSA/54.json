{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"E KE Akua, e hoola mai oe ia'u ma kou inoa; A e hoopono mai ia'u ma kou ikaika.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"E ke Akua, e hoolohe mai i ka'u pule; E haliu mai i ka pepeiao i na olelo a kuu waha:","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"No ka mea, ua ku e mai ia'u na kanaka e, A ke imi nei i kuu uhane na mea hooluhihewa; Aole lakou i hoonoho i ke Akua i mua o ko lakou alo. Sila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Eia hoi, o ke Akua ko'u kokua; O ka Haku oia pu me ka poe kokua i ko'u uhane.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E uku auanei oia i ka ino maluna o ka poe ku e ia'u; E oki iho oe ia lakou i kou oiaio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"E mohai oluolu aku au nou; E hoelea aku au ia oe, e Iehova, no ka mea, he pono ia.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"No ka mea, ua hoopakele oia ia'u i ka popilikia a pau; A ua nana ae nei ko'u maka i ko'u poe enemi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}