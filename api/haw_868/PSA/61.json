{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"E HOOLOHE mai, e ke Akua, i ko'u kahea ana; E maliu pono mai i ka'u pule.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mai ka welau o ka honua e kahea aku ai au ia oe, I ka paumako o ko'u naau; E alakai oe ia'u i ka pohaku kiekie maluna o'u.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"No ka mea, ua lilo mai oe i paku no'u; He halekaua paa imua o ka enemi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"E noho wau maloko o kou halelewa a mau loa: E kanaho au ma ka hoomalu ana o kou mau eheu. Sila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"No ka mea, ua lohe oe, e ke Akua, i ka'u mau mea i hoohiki ai: Ua haawi mai hoi oe ia'u i ka hooilina o ka poe weliweli i kou inoa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E hooloihi no oe i na la o ke alii: A i kona mau makahiki ia hanauna aku ia hanauna aku.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E noho ia imua o ke Akua a mau loa; E hoomakaukau mai oe i ke aloha a me ka oiaio, e ola'i ia.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pela, e himeni mau loa aku au i kou inoa, E hooko aku i kela la i keia la i ka'u mau mea i berita ai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}