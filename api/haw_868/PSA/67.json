{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"E ALOHA mai ke Akua ia makou, A e hoomaikai mai hoi ia makou; A e hoomalamalama mai kona maka ia makou; Sila.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I ikeia kou aoao ma ka honua, A me kou hoola ana ma na lahuikanaka a pau.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"E hoolea aku na kanaka ia oe, e ke Akua; E pau hoi na kanaka i ka hoolea aku ia oe,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"E hauoli na lahuikanaka, a e oli no ka olioli: No ka mea e hooponopono oe i na kanaka ma ka pololei, A ma ka honua e alakai ai oe ia lakou. Sila.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E hoolea aku na kanaka ia oe, e ke Akua; E pau na kanaka i ka hoolea aku ia oe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Alaila e haawi mai ka honua i kona hua; A e hoomaikai mai ke Akua ko kakou Akua ia kakou.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E hoomaikai mai ke Akua ia kakou; A e makau aku ia ia na welelau a pau o ka honua.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}