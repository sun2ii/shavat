{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"I OLA au, e ke Akua, E wikiwiki mai, e Iehova, e kokua mai ia'u.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"E hoohilahilaia, e hoohokaia hoi ka poe e imi ana i ko'u uhane: E hoohuliia ihope, a hoka ka poe makemake i ka hewa no'u.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"E hoihoiia ihope i uku no ko lakou hilahila, Ka poe i olelo mai, Aia la! Aia la!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Aka, e olioli a e hauoli hoi ka poe a pau i imi aku ia oe: A e olelo mau ka poe a pau i makemake i kou ola, E hoonuiia ke Akua.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aka, ua ilihune au a ua nele hoi; E holo koke mai ia'u, e ke Akua: O oe no ko'u Kokua a me ko'u Hoola; E Iehova, mai hookaulua aku oe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}