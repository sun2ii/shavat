{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"A IA no kona mau kumu ma na mauna hoano.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ua oi aku ka makemake o Iehova i na pukapa o Ziona, Mamua o na wahi noho ai a pau o ka Iakoba.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ua oleloia mai na mea nani nou, E ke kulanakauhale o ke Akua Sila.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I ka poe ike mai ia'u, e kamailio aku au no Rahaba, a me Babulona: Aia o Pilisetia, a me Turo, a me Aitiopa, Oia ka i hanauia malaila.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E oleloia mai no hoi no Ziona, Ua hanauia kela kanaka keia kanaka maloko ona; A na ka Mea kiekie e hookumu paa ia wahi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ia Iehova e kakau ai i na kanaka, E hoike mai no oia, Ua hanauia oia nei malaila. Sila.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"O ka poe mele, a me ka poe hookiokio, Aia la iloko ou, kou mau punawai a pau.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}