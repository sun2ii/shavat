{"translation":{"id":"haw_868","name":"Baibala Hemolele","website":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseUrl":"https://ebible.org/Scriptures/details.php?id=haw1868","licenseNotes":null,"shortName":"868","englishName":"Hawaiian Bible 1868","language":"haw","textDirection":"ltr","sha256":"7beea3fd69e9fde03f2c32433b54b3059a0e4fbd6b83e271470f0e8cd22100bd","availableFormats":["json"],"listOfBooksApiLink":"/api/haw_868/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"ʻŌlelo Hawaiʻi","languageEnglishName":"Hawaiian"},"book":{"id":"PSA","translationId":"haw_868","name":"Halelu","commonName":"Halelu","title":"Halelu","order":19,"numberOfChapters":150,"sha256":"2c23a2f2bb9527da77171c17218f4f560b1aa44b4f258bad929d705f4a1fa23c","firstChapterNumber":1,"firstChapterApiLink":"/api/haw_868/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/haw_868/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"KE noho aupuni nei o Iehova, Ua kahikoia oia i ka hanohano; Ua kahikoia o Iehova i ka ikaika, Ua kakoo no oia ia ia iho: Ua hookumu paa loa ia ke ao nei, Aole ia e hoonaueueia.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ua hookumu paa ia kou nohoalii mai kahiko mai, Mai ka mau loa mai a ka mau loa aku no oe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ua hookiekie na ale, e Iehova, Ua hookiekie na ale i ko lakou leo, Ua kookiekie na ale i ka halulu ana.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Maluna o ka leo o na wai he nui loa, Maluna hoi o ke poi ana mai o na nalu o ke kai, Aia no o Iehova maluna o kahi kiekie loa aku.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"He oiaio maoli kau mau kauoha; Ku pono i kou hale ka mea i hoanoia, E Iehova, a mau loa aku no.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/haw_868/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/haw_868/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/haw_868/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}