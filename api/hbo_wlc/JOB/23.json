֭דַע דֶּ֣רֶךְ עִמָּדִ֑י בְּ֝חָנַ֗נִי כַּזָּהָ֥ב אֵצֵֽא׃"]},{"type":"verse","number":11,"content":["בַּ֭אֲשֻׁרוֹ אָחֲזָ֣ה רַגְלִ֑י דַּרְכּ֖וֹ שָׁמַ֣רְתִּי וְלֹא־אָֽט׃"]},{"type":"verse","number":12,"content":["מִצְוַ֣ת שְׂ֭פָתָיו וְלֹ֣א אָמִ֑ישׁ מֵ֝חֻקִּ֗י צָפַ֥נְתִּי אִמְרֵי־פִֽיו׃"]},{"type":"verse","number":13,"content":["וְה֣וּא בְ֭אֶחָד וּמִ֣י יְשִׁיבֶ֑נּוּ וְנַפְשׁ֖וֹ אִוְּתָ֣ה וַיָּֽעַשׂ׃"]},{"type":"verse","number":14,"content":["כִּ֭י יַשְׁלִ֣ים חֻקִּ֑י וְכָהֵ֖נָּה רַבּ֣וֹת עִמּֽוֹ׃"]},{"type":"verse","number":15,"content":["עַל־כֵּ֭ן מִפָּנָ֣יו אֶבָּהֵ֑ל אֶ֝תְבּוֹנֵ֗ן וְאֶפְחַ֥ד מִמֶּֽנּוּ׃"]},{"type":"verse","number":16,"content":["וְ֭אֵל הֵרַ֣ךְ לִבִּ֑י וְ֝שַׁדַּ֗י הִבְהִילָֽנִי׃"]},{"type":"verse","number":17,"content":["כִּֽי־לֹ֣א נִ֭צְמַתִּי מִפְּנֵי־חֹ֑שֶׁךְ וּ֝מִפָּנַ֗י כִּסָּה־אֹֽפֶל ׃"]}],"footnotes":[]},"thisChapterLink":"/api/hbo_wlc/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hbo_wlc/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hbo_wlc/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}