type":"verse","number":10,"content":["מוֹאָ֤ב ׀ סִ֬יר רַחְצִ֗י עַל־אֱ֭דוֹם אַשְׁלִ֣יךְ נַעֲלִ֑י עֲלֵֽי־פְ֝לֶ֗שֶׁת אֶתְרוֹעָֽע׃"]},{"type":"verse","number":11,"content":["מִ֣י יֹ֭בִלֵנִי עִ֣יר מִבְצָ֑ר מִ֖י נָחַ֣נִי עַד־אֱדֽוֹם׃"]},{"type":"verse","number":12,"content":["הֲלֹֽא־אֱלֹהִ֥ים זְנַחְתָּ֑נוּ וְֽלֹא־תֵצֵ֥א אֱ֝לֹהִ֗ים בְּצִבְאֹתֵֽינוּ׃"]},{"type":"verse","number":13,"content":["הָֽבָה־לָּ֣נוּ עֶזְרָ֣ת מִצָּ֑ר וְ֝שָׁ֗וְא תְּשׁוּעַ֥ת אָדָֽם׃"]},{"type":"verse","number":14,"content":["בֵּֽאלֹהִ֥ים נַעֲשֶׂה־חָ֑יִל וְ֝ה֗וּא יָב֥וּס צָרֵֽינוּ׃"]}],"footnotes":[]},"thisChapterLink":"/api/hbo_wlc/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hbo_wlc/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hbo_wlc/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":14}