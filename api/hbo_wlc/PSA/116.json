"]},{"type":"verse","number":10,"content":["הֶ֭אֱמַנְתִּי כִּ֣י אֲדַבֵּ֑ר אֲ֝נִ֗י עָנִ֥יתִי מְאֹֽד׃"]},{"type":"verse","number":11,"content":["אֲ֭נִי אָמַ֣רְתִּי בְחָפְזִ֑י כָּֽל־הָאָדָ֥ם כֹּזֵֽב׃"]},{"type":"verse","number":12,"content":["מָֽה־אָשִׁ֥יב לַיהוָ֑ה כָּֽל־תַּגְמוּל֥וֹהִי עָלָֽי׃"]},{"type":"verse","number":13,"content":["כּוֹס־יְשׁוּע֥וֹת אֶשָּׂ֑א וּבְשֵׁ֖ם יְהוָ֣ה אֶקְרָֽא׃"]},{"type":"verse","number":14,"content":["נְ֭דָרַי לַיהוָ֣ה אֲשַׁלֵּ֑ם נֶגְדָה־נָּ֝֗א לְכָל־עַמּֽוֹ׃"]},{"type":"verse","number":15,"content":["יָ֭קָר בְּעֵינֵ֣י יְהוָ֑ה הַ֝מָּ֗וְתָה לַחֲסִידָֽיו׃"]},{"type":"verse","number":16,"content":["אָֽנָּ֣ה יְהוָה֮ כִּֽי־אֲנִ֪י עַ֫בְדֶּ֥ךָ אֲֽנִי־עַ֭בְדְּךָ בֶּן־אֲמָתֶ֑ךָ פִּ֝תַּ֗חְתָּ לְמוֹסֵרָֽי׃"]},{"type":"verse","number":17,"content":["לְֽךָ־אֶ֭זְבַּח זֶ֣בַח תּוֹדָ֑ה וּבְשֵׁ֖ם יְהוָ֣ה אֶקְרָֽא׃"]},{"type":"verse","number":18,"content":["נְ֭דָרַי לַיהוָ֣ה אֲשַׁלֵּ֑ם נֶגְדָה־נָּ֝֗א לְכָל־עַמּֽוֹ׃"]},{"type":"verse","number":19,"content":["בְּחַצְר֤וֹת ׀ בֵּ֤ית יְהוָ֗ה בְּֽת֘וֹכֵ֤כִי יְֽרוּשָׁלִָ֗ם הַֽלְלוּ־יָֽהּ ׃"]}],"footnotes":[]},"thisChapterLink":"/api/hbo_wlc/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hbo_wlc/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hbo_wlc/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}