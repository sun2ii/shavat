":9,"content":["יְהוָ֤ה ׀ שֹׁ֘מֵ֤ר אֶת־גֵּרִ֗ים יָת֣וֹם וְאַלְמָנָ֣ה יְעוֹדֵ֑ד וְדֶ֖רֶךְ רְשָׁעִ֣ים יְעַוֵּֽת׃"]},{"type":"verse","number":10,"content":["יִמְלֹ֤ךְ יְהוָ֨ה ׀ לְעוֹלָ֗ם אֱלֹהַ֣יִךְ צִ֭יּוֹן לְדֹ֥ר וָדֹ֗ר הַֽלְלוּ־יָֽהּ׃"]}],"footnotes":[]},"thisChapterLink":"/api/hbo_wlc/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hbo_wlc/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hbo_wlc/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}