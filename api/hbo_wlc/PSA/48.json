ָה׃"]},{"type":"verse","number":10,"content":["דִּמִּ֣ינוּ אֱלֹהִ֣ים חַסְדֶּ֑ךָ בְּ֝קֶ֗רֶב הֵיכָלֶֽךָ׃"]},{"type":"verse","number":11,"content":["כְּשִׁמְךָ֤ אֱלֹהִ֗ים כֵּ֣ן תְּ֭הִלָּתְךָ עַל־קַצְוֵי־אֶ֑רֶץ צֶ֝֗דֶק מָלְאָ֥ה יְמִינֶֽךָ׃"]},{"type":"verse","number":12,"content":["יִשְׂמַ֤ח ׀ הַר־צִיּ֗וֹן תָּ֭גֵלְנָה בְּנ֣וֹת יְהוּדָ֑ה לְ֝מַ֗עַן מִשְׁפָּטֶֽיךָ׃"]},{"type":"verse","number":13,"content":["סֹ֣בּוּ צִ֭יּוֹן וְהַקִּיפ֑וּהָ סִ֝פְר֗וּ מִגְדָּלֶֽיהָ׃"]},{"type":"verse","number":14,"content":["שִׁ֤יתוּ לִבְּכֶ֨ם ׀ לְֽחֵילָ֗ה פַּסְּג֥וּ אַרְמְנוֹתֶ֑יהָ לְמַ֥עַן תְּ֝סַפְּר֗וּ לְד֣וֹר אַחֲרֽוֹן׃"]},{"type":"verse","number":15,"content":["כִּ֤י זֶ֨ה ׀ אֱלֹהִ֣ים אֱ֭לֹהֵינוּ עוֹלָ֣ם וָעֶ֑ד ה֖וּא יְנַהֲגֵ֣נוּ עַל־מֽוּת׃"]}],"footnotes":[]},"thisChapterLink":"/api/hbo_wlc/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hbo_wlc/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hbo_wlc/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":15}