{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"1CH","translationId":"hch_wb2","name":"1 Kemɨtiuyɨ","commonName":"1 Kemɨtiuyɨ","title":"Mexɨakame Xapayari Kemɨtiuyɨ","order":13,"numberOfChapters":29,"sha256":"d8157882b82f40aa5ae00dc2e42195daf9998b6176a38449cb467d6296d1cf94","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/hch_wb2/1CH/29.json","totalNumberOfVerses":939},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":["Kakaɨyari tɨratuya kakuniyari kani'atɨarieni Rawiri hakewa 'ixuriki kiyari meta'aitakai. Muwa mekaneitateni hikɨ mawari taiyariyari mekaniuwewieni meta memɨyuxewinikɨ mawariyari Kakaɨyari hɨxie."]},{"type":"verse","number":2,"content":["'Arike mawari heutipareku, Rawiri Yawé kaniutawawirieni teɨteri 'aixɨa mɨwayurienikɨ"]},{"type":"verse","number":3,"content":["meta 'ixaheritsixi yuxexuime 'ukitsi meta 'ukari paa kaniwaruta'ɨitɨani meta takɨ takari tsuirayari, meta kaxie patsaruyari tsuirayari."]},{"type":"verse","number":4,"content":["Hikɨ Rawiri hipame rewitsixi Yawé tɨratuya kakuniyari kaniwaruhɨritɨani hetsiena mieme memɨte'uximayakakɨ, pamɨpariyutsi memipitɨakakɨ meta witsimemutiyuanenikɨ Yawé hepaɨtsita, 'Ixaheri kakaɨyarieya."]},{"type":"verse","number":5,"content":["Memanayexeiyarie mepɨhɨkɨtɨkai: 'Atsahapi mexɨakame pɨhɨkɨtɨkai: Tsakariyaxi, hutarieka mieme pɨhɨkɨtɨkai: manatari mepɨhɨkɨtɨkai Kekiyeri, Tsemiramuti, Kehieri, Matatiyaxi, 'Eriyáwi, Wenahiyaxi, 'Uweri-'Erumi meta Keyeri, mɨkɨ 'arɨpakɨ teyuitɨwamete mepɨhɨkɨtɨkai meta kanaritekɨ. 'Atsahapi tepɨa mutitirirɨka pɨyuitɨwametɨkai."]},{"type":"verse","number":6,"content":["Mawari wewiwamete Wenahiyaxi meta Kahatsieri matɨa kuxineta meputihɨtsiwakai Yawé tɨratuya kakuniyari hɨxie."]},{"type":"heading","content":["Rawiri nɨawarieya"]},{"type":"verse","number":7,"content":["Mɨkɨ tukaritsie, matɨari pɨyɨanekai Rawiri kwikari mɨyetɨa 'Atsahapi meta 'iwamama wahetsɨa 'ikɨ nɨawari Yawé hetsiemieme."]},{"type":"verse","number":8,"content":[{"text":"«'Aixɨa xekenaitɨkani Yawé hetsiemieme, kemɨtimariwe xekenekuxatani,","poem":1},{"text":"xekenekuxatani kemɨtiuyuri teɨteri watsata.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Xekeneutikwikani, nɨawari hetsiena mieme.","poem":1},{"text":"xekenekuxatani mariwemekɨ kemɨtiuyuri.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Xekeneyutemamawieka mɨmariwe mɨpatsie xemexeiyakɨ.","poem":1},{"text":"xekeneyutemamawieka yurikɨ Yawé xemɨkuwautɨwe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yawé hetsɨa xekeneyu'awietani mɨtɨrukaɨyekɨ,","poem":1},{"text":"yaxeketenahɨaweni yuheyemekɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xekenaye'eriwani mariwemekɨ kemɨtiuyuri,","poem":1},{"text":"'inɨari kemɨtiuwewi meta 'aitsika ke'aneneme mɨyetɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"»'Ixaheri nuiwarimama, Yawé ti'uximayatsiriwame","poem":1},{"text":"Kakuwu niwemama, Yawé mɨxe'anayexei:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yawé takakaɨyari pɨhɨkɨ,","poem":1},{"text":"naitsarie kwiepa katini'aitani kemɨtiheitserie.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mɨkɨ yutɨratɨ yuhemekɨ kana'eriwani,","poem":1},{"text":"xeimiriyari nuiwariyari wahamatɨa yuniuki kaniyetɨani.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"'Apɨrahami matɨa tɨratu kemɨtiuwewi,","poem":1},{"text":"meta 'Itsahaki matɨa kemɨtiuyuhɨritɨa,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kakuwu yakatiniutahɨawe, 'aitsika kaneyeitɨirieni,","poem":1},{"text":"'ixaheritsixi wahetsiemieme tɨratu yuheyemekɨ mieme kanayeitɨani:","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“'Ekɨ Kanani kwieyari nekamaniyetuiriemɨkɨ,","poem":1},{"text":"piinitɨarika 'ahetsiemieme mɨhɨkɨtɨni hepaɨ”.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kepauka 'akuxi temɨkatamɨirekai,","poem":1},{"text":"tewatari tekanihɨmetɨkaitɨni yakɨ teyupaɨmetɨ mɨkɨ kwieyaritsie,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"kepauka hipame kwieyaritetsie xemu'uwakai","poem":1},{"text":"meta kepauka hipame te'aitamete wahetsɨa xemu'uwakai,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kakaɨyari pɨkatiupitɨa waɨriyarika temɨteta'aitɨarienikɨ,","poem":1},{"text":"te'aitamete kaniwarutatieni 'iya wanaki'erietɨ:","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“Neteɨterima nemɨwaranayexei xepɨkawa'uximatɨaka.","poem":1},{"text":"Neniukamete xepɨkatewakwinitɨaka”.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"»Yunaitɨ teɨteri kwiepa memɨtama Yawé mekenɨawani.","poem":1},{"text":"Meke'ikuxatani tukari mɨyehane kemɨtiyuwikweitsitɨwa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nuiwarite watsata xekenekuxatani witsikemɨ'ane,","poem":1},{"text":"meta mariwemekɨ kemɨtiyuriene xekenekuxatani yunaime teɨteri watsata.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yawé matsi kanimariweni,","poem":1},{"text":"hetsiena pɨtinake witsimɨtikɨhɨawarɨwani,","poem":2},{"lineBreak":true},{"text":"matsi waɨkawa makaxiwatɨ keyuri hipatɨ kakaɨyarixi.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Tixaɨtɨ mepɨkatehɨkɨ teɨteri wakakaɨyarixi,","poem":1},{"text":"matsi Yawé muyuawi kaniutawewieni,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Xawatɨriya meta kemɨtimariwe hɨxiena kanixuaweni,","poem":1},{"text":"temawierika kanixuaweni meta tɨrɨkariya tukieya muyepatsieta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"»Yawé xeketeneyetuiri, yunaitɨ teɨteri,","poem":1},{"text":"Yawé yaxeketeneutahɨawi witsikemɨ'ane meta kemɨtitɨrɨkaɨye.","poem":2}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Yawé yaxeketeneutahɨawi witsikemɨ'ane mɨmariwekɨ,","poem":2},{"text":"hɨxiena xekeneu'axɨa 'imikieri xete'epinirietɨ,","poem":1},{"text":"Yawé xekenayexeiyani tukieya witsimɨ'aneta.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Yunaitɨ teɨteri kwiepa memɨtama meke'eyemakaxeni.","poem":1},{"text":"Mɨkɨ kwie 'apuyeye, mɨkɨta pɨkakuyuani.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Muyuawi keyutemawieka meta kwie ke'utanaweni.","poem":1},{"text":"nuiwarite mɨpaɨ meke'utiyuani: “Yawé pɨti'aitame”.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"»Haramara ke'utayuaneni meta yunaitɨ mana memɨteye'uwa.","poem":1},{"text":"'Ɨtsi keyutemawieka meta tita mana memɨtexɨawe.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Kɨyexi hɨritsie mieme ke'utikwikani temawierikakɨ Yawé hɨxie,","poem":1},{"text":"mɨkɨ 'ukanamieni kwiepa tita'aitake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"»'Aixɨa xeketenahɨaweni Yawé mɨkɨ 'aixɨa mɨtiuka'iyarikɨ,","poem":1},{"text":"meta naki'eriyaya mɨwaɨkawa hawaikɨ pɨkaheu'axe.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Mɨpaɨ xeketenahɨaweni: “Ketaneutawikweitsitɨa, Kakaɨyari, tawikweitsitɨwame pemɨhɨkɨ.","poem":1},{"lineBreak":true},{"text":"Ketaneukuxeɨri ketaneɨxɨna Kakaɨyari memɨka'ayexeiya watsata temɨka'u'uwanikɨ,","poem":1},{"lineBreak":true},{"text":"temɨmatsinɨawanikɨ kepemɨtimariwe,","poem":1},{"text":"temɨyutemamawiekakɨ tematsinɨawatɨ”.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Yawé 'aixɨa kerahɨawarɨwani, 'Ixaheri Kakaɨyarieya,","poem":1},{"text":"yuheyemekɨ meta kaheu'akamekɨ».","poem":2},"Hikɨ yunaitɨ teɨteri mɨpaɨ mekaniutiyuani: «Mɨpaɨ ketiɨyɨni», hikɨ 'aixɨa mekaniutiyuani Yawé hepaɨtsita."]},{"type":"line_break"},{"type":"verse","number":37,"content":["Rawiri Yawé tɨratuya kakuniyari 'Atsahapi kaniuhɨritɨani meta 'iwamama, memɨte'uximayakakɨ hetsiena mieme, yamemɨteyuriekakɨ kemɨreuyewekai tukarikɨ."]},{"type":"verse","number":38,"content":["'Uweri-'Erumi kitenie tihɨwemekɨ kaniutahɨawe meta 'iwamama haika tewiyari heimana 'atahaika memɨyupaɨmekai, metatsiere 'Uweri-'Erumi Kerutuni nu'aya meta Kutsa."]},{"type":"verse","number":39,"content":["Mawari wewiwame Tsaruki meta 'iwamama mawari wewiwamete kaniwaruhɨritɨani Yawé tukieya Kawahuni hɨriyaritsie paitɨ makawekai,"]},{"type":"verse","number":40,"content":["mana mawari taiyariyari yamemɨtehewewiekakɨ Yawé hetsiemieme, ximeri meta taikai Yawé 'aitsikaya kemainekai 'ixaheritsixi memɨyetuiriyarie."]},{"type":"verse","number":41,"content":["Hipameta kaniwaranayexeiya, Hemani meta Kerutuni meta hipame, Yawé hetsiemieme memutikwikanikɨ: «Naki'eriyaya hawaikɨ pɨkaheu'axe»."]},{"type":"verse","number":42,"content":["Hemani meta Kerutuni matɨa kuxinetate mepexeiyakai, tepɨa mutitiraurɨka meta hipame, Kakaɨyari nɨawarieya hamatɨa memɨte'ukayuitɨwanikɨ. Kerutuni niwemama kitenie mepɨtehɨwemetetɨkai."]},{"type":"verse","number":43,"content":["Hikɨ 'arike yunaitɨ mekaneutayeixɨani yukie, meta Rawiri yutɨɨriyama wahetsɨa kanakunuani meta Kakaɨyari kaniutawawirieni 'aixɨa muwayurienikɨ niwemama."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/1CH/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/1CH/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/1CH/15.json","previousChapterAudioLinks":{},"numberOfVerses":43}