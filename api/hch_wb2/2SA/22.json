{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"2SA","translationId":"hch_wb2","name":"2 Tsamuheri","commonName":"2 Tsamuheri","title":"Hutarieka mieme xapayari Tsamuheri","order":10,"numberOfChapters":24,"sha256":"938cffbc323a03b08818694d3f14ee6ece35ea7501615ea297deb2ab9d9e55ed","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/hch_wb2/2SA/24.json","totalNumberOfVerses":694},"chapter":{"number":22,"content":[{"type":"heading","content":["Rawiri nɨawarieya"]},{"type":"verse","number":1,"content":["Rawiri 'ikɨ kwikari Yawé hetsiemieme kaniutawewieni kepauka Yawé Tsahuri hepaɨtsita kayuwatɨ mipitɨa meta yunaime memeye'unie wahepaɨtsita kepauka mitawikweitsitɨa."]},{"type":"verse","number":2,"content":["Mɨpaɨ kaniutayɨni:",{"text":"«'Ekɨ Yawé ne'ai pekanihɨkɨtɨni, netsi'awiwietame pepɨhɨkɨ,","poem":1},{"text":"meta netsiwikweitsitɨwame pepɨhɨkɨ,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"nekakaɨyari, tete kanihɨkɨtɨni mɨwa nemuyuti'awiwieta.","poem":2},{"text":"Nehetsie nunuwame pɨhɨkɨ, tɨrɨkariya nehetsie nunuwame,","poem":1},{"text":"nemɨwayuti'awiwieta meutitewa pepɨhɨkɨ.","poem":2},{"text":"Mɨkɨ neheima munua kanihɨkɨtɨni meta netsiwikweitsitɨwame.","poem":1},{"text":"'Ekɨ pepɨnetsi'utawikweitsitɨa hipatɨ menetsimietɨwekaku.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yawé nekanahɨaweni, mɨkɨ 'aixɨa pɨ'ane hetsiena mieme 'aixɨa maineni,","poem":1},{"text":"hikɨ 'ana memɨnetsi'aye'unie watsata nepɨtawikweitsitɨarieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"»Ne nepɨmɨximekai, hamewari hepaɨ ti'anetɨ neheima pɨyeuriwekai,","poem":1},{"text":"haa puwayene pɨnetsihehautsitɨa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mɨɨya kaunarieya teɨkiyata pɨnetsiheukahanakai,","poem":1},{"text":"mɨɨya winiyarieyatsie nepɨnehɨa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Waɨkawa ne'uximatɨarietɨ Yawé nekaniutahiwieni,","poem":1},{"text":"nekakaɨyari neputahɨawixɨ mɨnetsiparewienikɨ,","poem":2},{"text":"mɨkɨ yutukita paitɨ kaneniu'enieni,","poem":1},{"text":"nehiwari nakatana paitɨ kaneye'ani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"»Hikɨ kwie kaniutayuani, kaniuyuanekaitɨni,","poem":1},{"text":"meta muyuawi mutuikatɨka kaniwatayuaxɨani,","poem":2},{"lineBreak":true},{"text":"mekaniwatayuani Kakaɨyari haxɨayakɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yutsurita kɨtsi pakanenetɨwakai,","poem":1},{"text":"meta yuteta tai mɨtiyuxɨxɨtsitɨwa puwayenenetɨwakai,","poem":2},{"lineBreak":true},{"text":"tɨ tatɨkaitɨ kanitaxɨrɨwekaitɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"»Muyuawi 'anutayepieka, kaniwakayani,","poem":1},{"text":"haiwitɨri mɨyɨyɨwitsie 'awetɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yuteɨtametsie 'anutiyerɨka, muyuawitsie kanayeyani,","poem":1},{"text":"'anayatsie 'ayerɨka 'ekatsie kaneyani","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yɨriyakɨ meta haiwitɨri wiyeri 'ayemanemekɨ kaneuyukunani,","poem":1},{"text":"'ixuriki kiiyari hepaɨ 'aneme yuheima kaniutawewieni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hɨxiena tɨrɨkaɨyemekɨ waɨkawa 'akuxawatɨkaku","poem":1},{"text":"tɨ tatɨkaitɨ kanitakɨkakaitɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"»Muyuawitsie Yawé tɨranarieya kaniuyu'eniɨriɨkɨre,","poem":1},{"text":"yemekɨ Kakaɨyari 'Amutewi niukieya kanewayuku'eiya.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kaniwarutamɨni yu'ɨrɨkɨ meta merɨkariyakɨ,","poem":1},{"text":"kaniwareutaxɨriexɨani meta kaniwarutaweiya.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yawé kaniwarutatieni","poem":1},{"text":"meta ha'atɨ muta'iwekaikɨ,","poem":2},{"text":"haramara hetɨa mieme kwie pahekɨarixɨ,","poem":1},{"text":"meta kwie tsutɨmeyari hekɨa kaniyuhayewa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"»'Amautitewatsie 'amamá pepakatseraxɨ,","poem":1},{"text":"nemamatsie pepɨkawierixɨ meta haramara 'ameukatewatsie pekanenatihana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Memɨnetsi'aye'unie memɨmamariwawe watsata pɨnetsi'utawikweitsitɨa,","poem":1},{"text":"'iya memɨnetsixani'eriekai","poem":2},{"lineBreak":true},{"text":"meta memɨtɨrɨkawikai kenemɨkatitɨrɨkaɨyekai ne.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kepauka nemɨkayɨwekaitsie,","poem":1},{"text":"'ana mekanenanukunake menetsimienike,","poem":2},{"lineBreak":true},{"text":"peru Yawé matsi pɨnetsi'uparewi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Pɨnetsi'utawikweitsitɨa.","poem":1},{"text":"'Aixɨa pɨnetsi'uyuri yutemawietɨ netsinaki'erietɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"»Yawé pɨnerakapitɨa heitseriemekɨ yanemɨtiyurienekaikɨ,","poem":1},{"text":"ne'iwarika pɨnetiyetuiri tixaɨtɨ 'axanemɨkatiuyurikɨ,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yawé 'aitsikateya ne'enietɨ nemumiekɨ,","poem":1},{"text":"ne hatsuaku 'axanepɨkatiyuriwe,","poem":2},{"lineBreak":true},{"text":"meta nekakaɨyari nepɨkaku'eiriwetɨma.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ne naime nepa'eriwa kemɨti'aita,","poem":1},{"text":"ne nepɨka'iku'eiriwe 'aitsikateya.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Hɨxiena ne'uyeikatɨ nepɨka'ikwamanawe,","poem":1},{"text":"meta nepɨkanewaɨriyari 'axanemɨtiyurienikɨ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yawé pɨnerakapitɨa heitseriemekɨ yanemɨtiyurienekaikɨ,","poem":1},{"text":"ne'iwarika pɨnetiyetuiri 'aixɨa 'anemekɨ nemuyeikakaikɨ hɨxiena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"»'Ekɨ yapekatinikamieni kemɨ'ane yamɨtikamie hetsiemieme,","poem":1},{"text":"heitserie yapepɨtiyuriene heitserie 'aixɨa memɨteyurie wahetsie,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"yuri pepɨtiwa'eririe kemɨ'ane yuri memɨmate'eririe,","poem":1},{"text":"'ekɨ matsi pepɨtimate mɨtiyukananaima hetsiemieme.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Tixaɨtɨ memɨkatehayuyeitɨa memɨtehayu'iwani pepɨwapitɨa,","poem":1},{"text":"kepauka kwi pemɨwaxeiya memɨyuti'ɨre tixaɨtɨ pepɨkatiwarayeitɨwa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Yawé, 'ekɨ nekɨxeme pekanihɨkɨtɨni,","poem":1},{"text":"Yawé, 'ekɨ neyɨriya hekɨariya pepayeitɨwa.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Penetsitɨrɨkariyakaku nekaniyɨweni memɨnetsi'aye'unie nemɨwatakwini,","poem":1},{"text":"nekakaɨyari nehamatɨa pe'uyeikakaku kuraru 'amanutitewatsie nekaneukamakiweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"»Kakaɨyari huyeya matsi yemekɨ 'aixɨa kani'aneni,","poem":1},{"text":"Yawé niukieya tixaɨtɨ pɨkareuyewetse.","poem":2},{"lineBreak":true},{"text":"Kakaɨyari rahetsie tinunuwame pɨhɨkɨ kemɨ'ane hetsɨana memuyu'awieta.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"¿Kamɨtsɨ kemɨ'ane Kakaɨyari pɨhɨkɨ? Yawé xeikɨa kanihɨkɨtɨni.","poem":1},{"text":"¿Kemɨ'ane 'ai hepaɨ pɨ'ane? Takakaɨyari xeikɨa mɨpaɨ kani'aneni.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Mɨkɨ kanihɨkɨtɨni kemɨ'ane tɨrɨkariya mɨnetsipitɨa,","poem":1},{"text":"meta nehuye mɨheitseriya,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"mɨkɨ pɨnetsipitɨa maxa hepaɨ nemɨranautsawenikɨ,","poem":1},{"text":"meta hɨri 'amutitɨtɨtsie kanenipitɨaka nemɨkahekawautsenikɨ,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"nemamatetsie kanetini'ɨkitɨaka nemauyutamiewenikɨ,","poem":1},{"text":"meta pepɨneti'ɨkitɨa wurunitse tupiyari nemɨkemakakɨ.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"'Ekɨ pepɨnetsiheukunarɨma penetsiwikweitsitɨatɨ,","poem":1},{"text":"'aixɨa petiuka'iyarikaku nehetsiemieme 'aixɨa 'anemekɨ nepɨyeyani.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Nehuye 'ari 'aixɨa pepɨyuri,","poem":1},{"text":"ne'ɨkate pekaniutitseiriya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"»Memɨnetsi'aye'unie nekaniwaranukuweiya meta nekaniwarukwini,","poem":1},{"text":"nepɨkawarehayewaxɨ kepaukake yunaime nemɨwarekwi.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Yunaimeri nepuwarekwi. Tawariri mepɨka'anuku'uni.","poem":1},{"text":"Nehɨxie mekaniukaxɨrieni.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"'Ekɨ tɨrɨkariya pekaneniupitɨani kepauka nemuyutamitsie,","poem":1},{"text":"memɨnetsi'aye'unie pekaniwarupitɨani nehetɨa memɨkaxɨrienikɨ.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Memɨnetsi'aye'unie yu'ɨtɨa memɨyehukɨ pekaniwarupitɨani,","poem":1},{"text":"mɨpaɨ 'ayumieme memɨkanetsinaki'eriekai nekatiniwara'iwa.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Parewiya mekaniwaukaitɨni, peru nixewitɨ wahetsie pɨka'utanua.","poem":1},{"text":"Yawé mekanihiwiekaitɨnita, matsi mɨkɨ pɨkawaruta'ei.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"'Etsimepepeme nepɨwarayeitɨa. Kwie tumuanariyari hepaɨ mepɨteyuxexeiyakai.","poem":1},{"text":"Haxu huyeta mɨtika hepaɨ nepɨwarutiketsi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"»Pepɨnetsi'uparewi teɨteri memɨnetsi'aye'uniekai wahetsɨa,","poem":1},{"text":"hipame nuiwarite tiwa'aitɨwame pepɨnetsi'ayeitɨa,","poem":2},{"lineBreak":true},{"text":"teɨteri nemɨkawamatekai menete'uximayatsirietɨ mepakɨ.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Teewa mepɨkiekatari, peru ne mariweme mepɨnetsi'ayeitɨwa,","poem":1},{"text":"kepauka nemɨtiwa'aitɨa yamekatenikahuni.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Mɨkɨ 'ateewa kiekatari menetsixeiyatɨ mekanenimakaxeni,","poem":1},{"text":"meta memamatɨ memuwayu'awietatsie mekaniwayekɨkani.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Yawé kanayeyurini. Ne'ai hepaɨtsita 'aixɨa keraniuwani.","poem":1},{"text":"Kakaɨyari netsiwikweitsitɨwame 'aixɨa ketikuxaxatsiwani.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Mɨkɨ Kakaɨyari pɨtiwarakapitɨwa 'axakememɨnetsi'uyuri,","poem":1},{"text":"mɨkɨ teɨteri nehetɨa puwa'atɨwa nemɨtiwa'aitɨakakɨ.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"'Ekɨ neheima pepunua memɨnetsi'aye'unie wahepaɨtsita,","poem":1},{"text":"'ekɨ 'aixɨa pepɨnetipitɨa memɨnetsi'aye'unie wahepaɨtsita,","poem":2},{"lineBreak":true},{"text":"pekaneniwikweitsitɨaka teɨteri memɨnetsihaukuwaxɨa wahepaɨtsita.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Yawé, 'ayumieme ne 'aixɨa nepaine 'ahepaɨtsita nuiwarite watsata,","poem":1},{"text":"meta nɨawari 'ahetsiemieme neputikwika kepemɨtitewakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"»Yawé, ti'aitamekɨ pemɨnetsi'anayexei pepɨnetsi'upitɨa waɨkawamekɨ nemɨrayu'iwanikɨ,","poem":1},{"text":"ne Rawiri pemɨnetsi'anayexei meta nenuiwarima","poem":2},{"lineBreak":true},{"text":"keniwaruxeitsitɨa waɨkawamekɨ kepemɨtiwanaki'erie yuheyemekɨ».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/2SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":51}