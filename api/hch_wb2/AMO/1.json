{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"AMO","translationId":"hch_wb2","name":"'Amuxi","commonName":"'Amuxi","title":"'Amuxi","order":30,"numberOfChapters":9,"sha256":"d3a7fd376dde915446c5897216262c8f85f9f31bb9cc6171e467942dcbcf09e4","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/hch_wb2/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["'Ikɨ 'Amuxi kaniniukieyatɨni. Mɨkɨ muxatsi wahɨweme pɨhɨkɨtɨkai Tekuha paitɨ. Mɨpaɨ katiniuniere 'ixaheritsixi teɨteriyari wahepaɨtsita. 'Ana 'Utsiyaxi pɨti'aitametɨkai Kura kwieyaritsie, meta Keruwuhani Kuhatsi nu'aya 'Ixaheri kwieyaritsie pɨti'aitametɨkai. Yakatinikuxatakaitɨni huta wiyari heuyewekakaku 'akuxi kepauka kwie mutayua."]},{"type":"verse","number":2,"content":["'Amuxi mɨpaɨ kaniutayɨni:",{"text":"«Yawé kaniuyutahaxɨatɨwani Tsiyunitsie 'uyeikatɨ,","poem":1},{"text":"Kerutsareme paitɨ hiwarieya pe'enierie.","poem":2},{"text":"Muxatsi wa'ɨxa kaniutiyɨnare,","poem":1},{"text":"meta Kaximeru hɨriyaritsie naitɨ katiniukuwaukeni».","poem":2}]},{"type":"heading","content":["Kiekari hurawa mukumane hepaɨtsita"]},{"type":"verse","number":3,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«Ramatsiku kiekatari waɨkawa 'axamepɨte'uyuri,","poem":1},{"text":"'ayumieme ne nepɨkareiyehɨwirieni.","poem":2},{"text":"Karaha kwieyari memakupɨnaxɨkɨ,","poem":1},{"text":"tepɨa 'uwamekɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Ayumieme tai nepanunɨ'ani Katsaheri paratsiyuyata,","poem":1},{"text":"Weni-'Arari kuraruya 'aixɨa mɨ'ane mɨtaxɨtsitɨanikɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ramatsiku kiekatari wa'ituparitsie meukuwe nepeumura,","poem":1},{"text":"mayeweritsie 'Aweni mɨti'aitame nekanika'unamɨkɨ,","poem":2},{"lineBreak":true},{"text":"meta Weti-'Ereni mieme 'itsɨ makwe'e.","poem":2},{"text":"Tsiriya kiekatari waɨriyarika mepanuhapanieni","poem":1},{"text":"'ateewa Kixi paitɨ»,","poem":2},"Yawé mɨpaɨ kanaineni."]},{"type":"verse","number":6,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«Kahatsa kiekatari waɨkawa 'axamepɨte'uyuri,","poem":1},{"text":"'ayumieme ne nepɨkatiwareuyehɨwirieni.","poem":2},{"text":"Xei nuiwariyari yunaime memɨwarehapakɨ,","poem":1},{"text":"'Erumi kiekatari wahetsɨa mewatuanike,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'ayumieme tai nepanunɨ'ani Kahatsa kiekatari watetsariyatsie,","poem":1},{"text":"kuraruya mɨtaxɨtsitɨanikɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"'Atsiruri kiekariyaritsie mɨti'aita nepɨka'una,","poem":1},{"text":"meta 'Atsikaruni 'itsɨ makwe'e nepɨka'una.","poem":2},{"text":"'Ekuruni kiekatari nepɨwatihutsuni nemamakɨ,","poem":1},{"text":"meta piritsiteutsixi yunaitɨ mepukumaweriyarieni»,","poem":2},"Yawé naimekɨmɨyɨwe mɨpaɨ kanaineni."]},{"type":"verse","number":9,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«Tiru kiekatari waɨkawa 'axamepɨte'uyuri","poem":1},{"text":"'ayumieme, ne nepɨkatiwareuyehɨwirieni:","poem":2},{"text":"Yunaime kiekarite teɨteri memehapanie meha'atɨkaime 'Erumi xemutuirikɨ,","poem":1},{"text":"mepɨkahaye'eri tsepa yu'iwama wahamatɨa kememɨte'uxatakai.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Ayumieme tai nepanunɨ'ani Tiru kiekatari watetsariyatsie,","poem":1},{"text":"kuraru 'aixɨa mɨ'ane mɨtaxɨtsitɨanikɨ».","poem":2}]},{"type":"verse","number":11,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«'Erumi kiekatari waɨkawa 'axamepɨte'uyuri,","poem":1},{"text":"'ayumieme ne nepɨkatiwareuyehɨwirieni,","poem":2},{"text":"mepɨwareutaweiyaxɨa yu'iwama mewakwikutɨ 'ixiparakɨ,","poem":1},{"text":"mepɨka'uyupitɨa memɨte'uyukanenimayakakɨ,","poem":2},{"text":"'amepɨteheuterixɨ meha'atɨ","poem":1},{"text":"'amepɨtitekai meha'atɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"'Ayumieme tai nepanunɨ'ani Temani kiekatari wahetsie,","poem":1},{"text":"Wutsira kiekatari wakuraru 'aixɨa mɨ'ane mɨtaxɨtsitɨanikɨ».","poem":2}]},{"type":"verse","number":13,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«'Amunitsixi waɨkawa 'axamemɨte'uyuri,","poem":1},{"text":"'ayumieme ne nepɨkatiwareuyehɨwirieni.","poem":2},{"text":"Karikɨ yukwie 'amemɨtayeuriyakɨ,","poem":1},{"text":"Karaha kiekatari 'ukarawetsixi memayehukatɨkatei","poem":2},{"lineBreak":true},{"text":"wahukatsie 'ixiparakɨ mepɨwareuxitexɨa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Ayumieme tai nepɨtaiya Xawaha kuraruyaritsie,","poem":1},{"text":"wakuraru 'aixɨa mɨ'ane mɨtaxɨtsitɨanikɨ,","poem":2},{"text":"'ana meputihiwani meyukwitɨwetɨ,","poem":1},{"text":"teɨka putatɨrarɨkani nepi'enieni.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tiwa'aitɨwame 'ateewa paitɨ panuhanieni,","poem":1},{"text":"meta 'iparewiwamete yunaitɨ»,","poem":2},"Yawé mɨpaɨ kanaineni."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/AMO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/AMO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}