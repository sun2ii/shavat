{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"AMO","translationId":"hch_wb2","name":"'Amuxi","commonName":"'Amuxi","title":"'Amuxi","order":30,"numberOfChapters":9,"sha256":"d3a7fd376dde915446c5897216262c8f85f9f31bb9cc6171e467942dcbcf09e4","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/hch_wb2/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«Muhawi ke'axamɨtiuyuri waɨkawa katiniuyurieni,","poem":1},{"text":"'ayumieme nepɨkareiyehɨwirieni:","poem":2},{"text":"'Erumi kwieyaritsie ti'aitame 'umeteya memutitaiyaxɨkɨ,","poem":1},{"text":"naxi memeyeitɨakɨ,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"tai nekananunɨ'amɨkɨ Muhawi hetsie","poem":1},{"text":"Keriuti kiekariyari 'aixɨa mɨ'ane mɨtaxɨtsitɨanikɨ,","poem":2},{"text":"'ana Muhawi kanimɨmɨkɨ waɨkawa tɨranariyatsata","poem":1},{"text":"meta me'utihiwakaku yukukuyamete meta kuxineta hayuanekaku.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ti'aitame wahetsɨa mieme nekanikumaweriyamɨkɨ,","poem":1},{"text":"meta yunaitɨ memiparewie nepɨwakwini»,","poem":2},"Yawé mɨpaɨ kanaineni."]},{"type":"verse","number":4,"content":["Yawé mɨpaɨ paine:",{"text":"«Kura ke'axamɨtiuyuri waɨkawa katiniuyurieni,","poem":1},{"text":"'ayumieme nepɨkareiyehɨwirieni:","poem":2},{"text":"Mɨkɨ yu'itarikatsie metewitɨ mepeuyexɨri,","poem":1},{"text":"kememɨte'uyuri watutsima,","poem":2},{"text":"mepiku'eiri Yawé 'aitsikaya","poem":1},{"text":"mepɨkaheye'atɨa kemɨtiu'aitaxɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Ayumieme tai nepanunɨ'ani Kura hetsie,","poem":1},{"text":"Kerutsareme kuraruya 'aixɨa mɨ'ane mɨtaxɨtsitɨanikɨ».","poem":2}]},{"type":"heading","content":["'Ixaheritsie ke'axamemɨte'anuyekɨne"]},{"type":"verse","number":6,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«'Ixaheritsixi waɨkawa 'axakememɨte'uyurikɨ,","poem":1},{"text":"'ayumieme, nepɨkatiwareuyehɨwirieni.","poem":2},{"text":"Teɨteri 'aixɨa memɨte'u'iyari mepɨwatua tuminikɨ,","poem":1},{"text":"tixaɨtɨ memɨkatehexeiya, kakai xeiparitsikɨ mepɨtepata.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Haweri memɨyɨa wamu'utsie mepa'uwe","poem":1},{"text":"kwie tumuanariyari memɨhɨkɨtɨni hepaɨ,","poem":2},{"lineBreak":true},{"text":"meta memɨteheuyehɨwa wahuye mepɨyeitɨa.","poem":2},{"text":"Paapaya meta nu'aya xeime xeikɨa 'ukaratsi hamatɨa mepukahipite,","poem":1},{"text":"mɨpaɨ meteyurietɨ kenemɨtipatsie nekapatsiekame mepɨnetsi'ayeitɨwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tsepa kemɨ'ane mawari taiyame 'aurie","poem":1},{"text":"mepahipite, 'ixuriki tixaɨtɨ mɨkarexeiya miku'eiri mɨtiupataxɨ mɨkɨ hetsie mekanahipiteni,","poem":2},{"text":"meta winukɨ hipame mewarutiwiyaka memɨte'akapitɨariekɨ","poem":1},{"text":"Kakaɨyari tukita kɨmana mekani'ieka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"»Mɨya mekateniyurieka, tsepanetɨ wahetsiemieme","poem":1},{"text":"'amuxeutsixi nemɨtiwaruka'unaxɨ,","poem":2},{"text":"wa'ikwaxi nekaniukawani wapaitɨ","poem":1},{"text":"meta wananari nekanatekixɨani wahetɨa,","poem":2},{"text":"tsepanetɨ 'amemutɨkai kariuxa hepaɨ","poem":1},{"text":"meta tsepa memɨtɨrɨkawikai xiu hepaɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"»Ne 'Ekipitu nekanixe'ayewitɨni,","poem":1},{"text":"meta nekaniwaruwitɨximekaitɨni huta tewiyari wiyari makumawetsie,","poem":2},{"text":"'amuxeutsixi wakwiepa nemɨye'anikɨ xehetsiemieme.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Meta nekaniwarunetɨani Kakaɨyari niukametemama xeniwema watsata","poem":1},{"text":"metatsiere 'aitsika memuyuhɨritɨa temari watsata.","poem":2},{"lineBreak":true},{"text":"¿'Ixaheritsixi 'aku, mɨpaɨ katiɨyɨ?","poem":2},"Yawé mɨpaɨ kanaineni."]},{"type":"verse","number":12,"content":[{"text":"Peru xeme winu xepɨwaranu'itɨaxɨa 'aitsika memuyɨhɨritɨa","poem":1},{"text":"meta Kakaɨyari niukametemama xepɨkawarupitɨa nehetsiemieme memɨtehekɨatanikɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"»'Aixɨa kani'aneni, hikɨri ne 'ari nekanixetipɨnarɨmeni,","poem":1},{"text":"kemɨtiyupɨna kaxeta tɨriku 'atɨtɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hikɨ xewitɨ muyuta'una pɨkayɨweni kwinimieme mɨranautsawe,","poem":1},{"text":"meta mɨtɨrɨkaɨye tɨrɨkariyaya hawaikɨ pɨkarenake,","poem":2},{"lineBreak":true},{"text":"meta kwinimieme mɨreuyutamieme yutukari pɨkatawikweitsitɨani.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Ɨrɨkɨ kwinimieme mɨreutamɨiwe pɨkayuta'una,","poem":1},{"text":"meta kwinimieme mɨranautsawe pɨkatawikweni,","poem":2},{"lineBreak":true},{"text":"meta kawayutsie meutayerɨwe pɨkayuta'una.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"'Iya tukaritsie matsi tixaɨtɨ karapitɨ kaniyuta'unamɨkɨ,","poem":1},{"text":"tsepanetɨ kuya kwinimieme mɨreuyutamiewe»,","poem":2},"Yawé mɨpaɨ kanaineni."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/AMO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/AMO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}