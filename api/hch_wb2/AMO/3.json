{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"AMO","translationId":"hch_wb2","name":"'Amuxi","commonName":"'Amuxi","title":"'Amuxi","order":30,"numberOfChapters":9,"sha256":"d3a7fd376dde915446c5897216262c8f85f9f31bb9cc6171e467942dcbcf09e4","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/hch_wb2/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":3,"content":[{"type":"heading","content":["Kakaɨyari niukameya 'Amuxi kemutayɨ"]},{"type":"verse","number":1,"content":["Xekeneu'eni 'ixaheritsixi, 'ikɨ Yawé niukieya kemaine xehepaɨtsita, yunaime nuiwari hetsiemieme 'Ekipitu nemɨwarayewitɨ:"]},{"type":"verse","number":2,"content":[{"text":"«Xeme xeikɨa nekanixe'anayexeiya","poem":1},{"text":"yunaime kwiepa memɨtama watsata.","poem":2},{"text":"'Ayumieme, nekatinixe'akapitɨamɨkɨ","poem":1},{"text":"naimekɨ ke'axaxemɨte'uyuri».","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Pɨkayɨwe yuhutatɨ muhunikɨ","poem":1},{"text":"yamekatexatawawetɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Maye yeuta pɨkahayuhaxɨatɨwa","poem":1},{"text":"xɨka tixaɨtɨ katikwaka.","poem":2},{"text":"Maye nunutsi pɨkaha'a yuterɨta","poem":1},{"text":"xɨka tixaɨtɨ katikwaka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wiki winiyaritsie pɨka'uyewiere xɨka","poem":1},{"text":"mana katiuyewieka.","poem":2},{"text":"Winiyari pɨkakuyuane xɨka","poem":1},{"text":"tixaɨtɨ katiwieriweni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kuxineta kiekaritsie kaniutahɨtsieriwani","poem":1},{"text":"kiekatari mɨpaɨ memɨteyu'ɨwiyanikɨ.","poem":2},{"text":"Kiekaritsie yɨkɨ pɨkatiyɨni","poem":1},{"text":"xɨka Yawé mɨpaɨ kahaineni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yurikɨ, Yawé naimekɨmɨyɨwe yɨkɨ pɨkatiyurieni","poem":1},{"text":"yuniukamete katiwataxatɨawetɨ","poem":2},{"lineBreak":true},{"text":"kemɨtiyurieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Maye xɨka heyutahaxɨatɨani,","poem":1},{"text":"¿kemɨ'ane pɨkatimani?","poem":2},{"text":"Xɨka Yawé naimekɨmɨyɨwe haniukani,","poem":1},{"text":"¿kemɨ'ane niukameyatɨtɨ pɨkatitaxata?","poem":2}]},{"type":"heading","content":["'Ixaheri kemɨti'uximatɨarieni"]},{"type":"verse","number":9,"content":[{"text":"'Ikɨ xeketenekuxatani kiekari 'aixɨa mɨrekukurarutɨiyarie 'Atsiruri","poem":1},{"text":"meta kiekari 'aixɨa mɨ'anene 'Ekipitu mieme:","poem":2},{"text":"«Tsamariya hɨriyaritetsie xekeneuyukuxeɨri","poem":1},{"text":"meke'uneniere kememɨtemama,","poem":2},{"lineBreak":true},{"text":"nanaimarika kemɨtixuawe mana».","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Yukii 'aixɨa mɨ'aneneta memɨtehɨniya","poem":1},{"text":"'inawari meta memɨtewanawairie hipame waɨriyarika","poem":2},{"lineBreak":true},{"text":"mɨkɨ mepɨka'imate tita heitserie muyeikani mɨranɨyɨne»,","poem":2},"Yawé mɨpaɨ kanaineni."]},{"type":"verse","number":11,"content":["'Ayumieme, Yawé naimekɨmɨyɨwe mɨpaɨ kanaineni:",{"text":"«Xewitɨ mɨmetsi'aye'unie 'akiekari kanika'unamɨkɨ,","poem":1},{"text":"kepemɨtitɨrɨkaɨye kamena'iwamɨkɨ","poem":2},{"lineBreak":true},{"text":"meta 'apiinite kametininawairiemɨkɨ».","poem":2}]},{"type":"verse","number":12,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«Muxatsi wahɨweme maye kemɨtikunawairiwa","poem":1},{"text":"heiwa hutame 'ɨkate ya naka 'etsiyeume,","poem":2},{"text":"mɨpaɨ mekatenitawikweitsitɨariekuni 'ixaheritsixi,","poem":1},{"text":"Tsamariyatsie kiekatari","poem":2},{"lineBreak":true},{"text":"yu'utá 'etsikinayaritsie xeikɨa meta Ramatsikutsie».","poem":2}]},{"type":"verse","number":13,"content":["Yawé naimekɨmɨyɨwe mɨpaɨ kanaineni, Kakaɨyari Naimekɨmɨtɨrɨkaɨye: «'Ikɨ xeketeneu'eni xeketenekuxatani Kakuwu tɨɨriyamama wahepaɨtsita."]},{"type":"verse","number":14,"content":[{"text":"»Kepauka nemɨrekapitɨani 'Ixaheri 'axamɨtiuyurikɨ,","poem":1},{"text":"nekanika'unamɨkɨ mɨratimawatɨre Weteri,","poem":2},{"text":"mɨratimawatɨre 'awateya kanakainixɨamɨkɨ,","poem":1},{"text":"kwiepa kanikaxɨrimɨkɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nekaneti'unamɨkɨ kii muhaɨtɨnitsie mieme","poem":1},{"text":"meta witarita mieme.","poem":2},{"text":"Kanati'unixɨamɨkɨ kii maripirikɨ witsimɨreukuwewiyatɨka","poem":1},{"text":"meta waɨkawa kii witsimɨ'anene kanika'unixɨamɨkɨ»,","poem":2},"Yawé mɨpaɨ kanaineni."]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}