{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"AMO","translationId":"hch_wb2","name":"'Amuxi","commonName":"'Amuxi","title":"'Amuxi","order":30,"numberOfChapters":9,"sha256":"d3a7fd376dde915446c5897216262c8f85f9f31bb9cc6171e467942dcbcf09e4","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/hch_wb2/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"'Ikɨ niuki xeme xekeneu'eni, wakaitsixi Watsani miemete,","poem":1},{"text":"Tsamariya hɨriyaritsie xemu'uwa,","poem":2},{"text":"haweri memɨ'anene xemɨwananaima","poem":1},{"text":"meta tixaɨtɨ memɨkatehexeiya,","poem":2},{"text":"yɨkɨnama mɨpaɨ xemɨtewakɨhɨawe:","poem":1},{"text":"«Xeketatenahapaniri tepanu'ieni».","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yawé naimekɨmɨyɨwe mɨpaɨ kanaineni kemɨtipatsiekɨ:","poem":1},{"text":"«Tukari kanaye'amɨkɨ xeme xenuiwaritsie, 'imatɨrieka mieme","poem":2},{"lineBreak":true},{"text":"kananuhaniemɨkɨ tepɨa 'utakeitsitɨarietɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kuraru haxawakaku xekananetɨariekuni yu'utɨa xeheu'utɨ,","poem":1},{"text":"Heximuni hɨriyaritsie xekanitiyunitɨariekuni","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"»Xekenehu Weteri mana 'axaxeketeneyurieka.","poem":1},{"text":"Kirikari xekenehu manata yaxeikɨa 'axaxeketeneyurieka,","poem":2},{"text":"ximeri xeketenemawatɨweni,","poem":1},{"text":"meta hairieka tukaritsie tamamata hetsiemieme xeime xekeneyetuayani.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Paa mukuxanariyarie xekenetitaiyani pamɨpariyutsi mawariyari mɨhɨkɨtɨnikɨ","poem":1},{"text":"meta hipame xeketeniwarutaxatɨa mawari memɨyetuanikɨ kememɨteyuwaɨriya.","poem":2},{"text":"Yaxeketeneuyuri yunaitɨ 'ixaheritsixi yamemɨtehetimanikɨ,","poem":1},{"text":"mɨkɨ xeme mɨxenakekɨ","poem":2},"—Yawé naimekɨmɨyɨwe mɨpaɨ kanaineni—."]},{"type":"heading","content":["'Ixaheritsixi kememɨkateyuwaɨriya"]},{"type":"verse","number":6,"content":[{"text":"»Ne haaka nekaniutixuawitɨani naitsarie xekiekaritetsie,","poem":1},{"text":"paa memɨkakwakakɨ yanepɨtiuyuri xemukutetɨkatsie.","poem":2},{"lineBreak":true},{"text":"Mɨyatɨtɨ, xeme nehetsɨa xepɨka'u'axɨa","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"»Ne yanepɨtiuyuri mɨkakawiyekɨ","poem":1},{"text":"kepauka meuyewekai 'akuxi haika metseri mɨtika'itsanatɨtsie.","poem":2},{"text":"Xeime kiekariyaritsie pukawiyexɨ,","poem":1},{"text":"xaɨtsieta hawaikɨ,","poem":2},{"text":"xeime 'etsarita xeikɨa pukawiyexɨ,","poem":1},{"text":"xaɨtsie pɨka'ukawiyexɨ, 'ayumieme pɨtiutiwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hau'erietɨ mekaneu'uwakaitɨni tsepa kemɨ'ane kiekaritsie teɨteri haa mekuwautɨwetɨ,","poem":1},{"text":"peru yaxeikɨa mepɨteheuharikukai.","poem":2},{"lineBreak":true},{"text":"Mɨyatɨtɨ, xeme nehetsɨa xepɨka'u'axɨa","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"»Wa'etsaripa 'utsikari wahekɨ nepɨwaru'uximatɨa meta mɨtitiwanikɨ,","poem":1},{"text":"'utsikari naime mepɨteheukuxɨxɨa waharawerita meta kaxie memɨwa'etsatsie,","poem":2},{"text":"wapiní meta wahuriwu.","poem":1},{"text":"Mɨyatɨtɨ, xeme nehetsɨa xepɨka'u'axɨa","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"»Waɨkawa 'uximatɨarika nepenɨ'a","poem":1},{"text":"'Ekipitu hepaɨ.","poem":2},{"text":"Temari 'aixɨa memɨ'anene 'ixiparakɨ nepɨwarukwi,","poem":1},{"text":"wakawayutsixi yunaitɨ meputiwiyarie.","poem":2},{"text":"Yanepɨtiuyuri yutsurita memi'ɨkwekɨ","poem":1},{"text":"mɨkite wa'ɨakariyari.","poem":2},{"lineBreak":true},{"text":"Mɨyatɨtɨ, xeme xepɨkanetsihaye'eri","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"»Ne nepɨxe'uka'unaxɨ","poem":1},{"text":"Tsuruma meta Kumuxa hepaɨ,","poem":2},{"text":"tɨɨyari xeikɨa xepuyuhayewaxɨ tai mihayewaxɨ hepaɨ.","poem":1},{"text":"Mɨyatɨtɨ, xeme xepɨkanetsi'aye'eri","poem":2},"―Yawé mɨpaɨ kanaineni―."]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"»'Ixaheri, 'ayumieme hikɨta nepɨmetika'enitsitɨani,","poem":1},{"text":"yanemɨtiyurienikɨ,","poem":2},{"lineBreak":true},{"text":"'Ixaheri, keneyukuha'aritɨwani, 'akakaɨyari pemanunakekɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ne nekanihɨkɨtɨni hɨri nemɨtiwewiwa,","poem":1},{"text":"meta 'eka nemunenetɨwa,","poem":2},{"lineBreak":true},{"text":"ne nekanihɨkɨtɨni tewi kemɨtiyurieni nemihekɨata,","poem":2},{"text":"meta hekɨariya yɨriya nemunenetɨwa,","poem":1},{"text":"meta kwie heima nemuyeika:","poem":2},{"lineBreak":true},{"text":"Yawé Kakaɨyari Naimekɨmɨtɨrɨkaɨye nekatinitewaka.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/AMO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/AMO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/AMO/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}