{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"AMO","translationId":"hch_wb2","name":"'Amuxi","commonName":"'Amuxi","title":"'Amuxi","order":30,"numberOfChapters":9,"sha256":"d3a7fd376dde915446c5897216262c8f85f9f31bb9cc6171e467942dcbcf09e4","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/hch_wb2/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"heading","content":["Mari'itɨarika meta heiwerika"]},{"type":"verse","number":1,"content":[{"text":"'Ikɨ niuki xekeneu'eni, 'ixaheritsixi teɨteriyari,","poem":1},{"text":"'ikɨ heiwerika kwikariyari 'ahetsiemieme neminɨawa:","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«'Ari 'Ixaheri 'uka 'ɨimari kanatiweni,","poem":1},{"text":"tawariri pɨka'anukukeni,","poem":2},{"text":"yukwiepa kaniukani,","poem":1},{"text":"pumaweni kemɨ'ane menukuhana».","poem":2}]},{"type":"verse","number":3,"content":["Yawé naimekɨmɨyɨwe mɨpaɨ 'Ixaheri kwieyari katinahɨaweni:",{"text":"«'Iya kiekari kuyaxa mɨwewienekai xeimiriyari warawitɨtɨ kuyaxi","poem":1},{"text":"mɨkɨ xeitsienituyari warexeiyatɨ xeikɨa payani,","poem":2},{"text":"meta xeitsienituyari kuyaxi warawitɨtɨ muyumienekai","poem":1},{"text":"tamamata xeikɨa warexeiyatɨ kanayeimɨkɨ».","poem":2}]},{"type":"verse","number":4,"content":["Yawé mɨpaɨ 'Ixaheri kwieyari katinahɨaweni:",{"text":"«Xekeneneutiwawa hikɨ 'ana xe'ayeyuyuritɨ xepakɨne.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Peru Weteri xepɨkaheta'axeni,","poem":2},{"text":"meta Kirikari xepɨkahekɨkani,","poem":1},{"text":"meta Weritsewa xepɨka'uyekɨkani,","poem":2},{"text":"mɨkɨ Kirikari kananuhaniemɨkɨ 'ateewa paitɨ,","poem":1},{"text":"meta Weteri, nitixaɨtɨ pɨkarayeitɨarieni».","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yawé xekeneutiwawa xe'ayeyuyuritɨ xemakɨnekɨ,","poem":1},{"text":"kapa mɨkɨ tai hepaɨ 'anetɨ 'ukawenikɨ,","poem":2},{"lineBreak":true},{"text":"Kutse nuiwarimama wahetsie,","poem":2},{"text":"tai Weteri kaniutataiyaweni","poem":1},{"text":"nixewitɨ pɨka'itɨwe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Xeme tita mɨtiheitserie ratsiwime xepɨtehayeitɨwa","poem":1},{"text":"meta 'aixɨa mɨti'ane kwiepa xepehɨpa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yawé Tsimanixi meta Terɨka puwarutiwewi,","poem":1},{"text":"yɨriya xawatɨriya payeitɨwa","poem":2},{"lineBreak":true},{"text":"meta tukari tɨkari payeitɨwa.","poem":2},{"text":"Mɨkɨ haa haramaratsie mieme putahɨawe","poem":1},{"text":"'ana kwie pukahatuiya.","poem":2},{"lineBreak":true},{"text":"Mɨkɨ Yawé katinitewaka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mɨkɨ, naime 'aixɨa mɨrekukurarutɨiyarie nitixaɨtɨ pɨkarayeitɨwa","poem":1},{"text":"meta kii mɨmamariwawe 'u'unime payeitɨwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Xeme xepi'uxiwe'erie tita mɨtiheitserie hetsie munua 'itsɨkate wahɨxie","poem":1},{"text":"meta xepixani'erie kemɨ'ane yurikɨ mɨtikuxata.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Haweri memɨ'anene xemɨwaketsitɨwekɨ","poem":1},{"text":"meta waɨkawa 'anamanemekɨ xemɨtewawawirie 'ikukɨ meteyutuakaku,","poem":2},{"text":"'ayumieme xeme yutetexi kiiyarita xepɨka'ayeyaxe xemitiwewi,","poem":1},{"text":"meta winu xepɨka'anu'ieni yukaxietsie mieme xemika'e.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne nepɨtimate kepaɨmeme xemɨte'apine,","poem":1},{"text":"pɨmɨireri ke'axaxemɨte'uyuri.","poem":2},{"lineBreak":true},{"text":"Xeme xepɨwananaima heitseriemekɨ yamemɨtekahu, waɨriyarika xepɨtewawawirie","poem":1},{"text":"meta 'itsɨkate wahɨxie mɨreuyehɨwa xepekahɨpa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Ayumieme mɨya mɨ'anekɨ mɨtimaiwe kayuwatɨ pɨta puyeika,","poem":1},{"text":"'ikɨ tukari 'aixɨa mɨka'anenekɨri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"'Aixɨa mɨti'ane xeketenekuwawa 'axamɨti'ane xepɨkatewautɨweni, hikɨ 'ana xepu'uwani,","poem":1},{"text":"mɨpaɨ xe'anenekaku Yawé Kakaɨyari Naimekɨmɨtɨrɨkaɨye xehamatɨa puyeikani,","poem":2},{"lineBreak":true},{"text":"xeme kexemaitɨka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"'Axamɨti'ane xeketenexani'erieka matsi 'aixɨa mɨti'ane xeketenenaki'erieka.","poem":1},{"text":"Tita mɨtiheitserie keti'aitani memati'iwawiyarɨwatsie,","poem":2},{"text":"mɨpaɨ heiwatɨ Yawé, Kakaɨyari Naimekɨmɨtɨrɨkaɨye,","poem":1},{"text":"Kutse nuiwarimama memuyuhayewatɨwe warutinenimayata.","poem":2}]},{"type":"verse","number":16,"content":["'Ayumieme Yawé naimekɨmɨyɨwe, Kakaɨyari Naimekɨmɨtɨrɨkaɨye mɨpaɨ kanaineni:",{"text":"«Naitsarie teɨteri memayukuxexeɨriwatsie kani'enieriemɨkɨ hiwerika,","poem":1},{"text":"meta naitsarie kayetetsie 'uximatɨarika hiwariyari puxuaweni.","poem":2},{"text":"Memɨte'uximayatatɨwe yu'etsita mepɨta'inierieni memɨyuhiweriekakɨ,","poem":1},{"text":"meta waɨkawa memeutatsuawawe mepɨta'inierieni memɨtitsuanikɨ memɨwahiweritɨanikɨ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Pɨ'enierieni tsuari naitsarie kaxie haraweriyaritetsie","poem":1},{"text":"kepauka ne mana 'ahetsɨa nemunuani»,","poem":2},"Yawé mɨpaɨ kanaineni."]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Xɨa'ui xeme, kekuta tekanitakwewieka,","poem":1},{"text":"xemaitɨka Yawé munuanikɨ.","poem":2},{"text":"'Ana kuhekɨareke xepɨka'erieka","poem":1},{"text":"matsi yɨriya kaninuamɨkɨ 'axa'anemekɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mɨpaɨ katiniyɨmɨkɨ xewitɨ maye 'umakarɨmetɨ","poem":1},{"text":"matsi hutse pɨta mitakwani hepaɨ,","poem":2},{"text":"yatɨni xewitɨ nuame yukie","poem":1},{"text":"yukitenie mɨrawiyakekai","poem":2},{"lineBreak":true},{"text":"kuu hetsie mumei mikei hepaɨ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yawé munuanitsie pɨkakuhekɨare matsi pɨkɨyɨre.","poem":1},{"text":"Yurikɨ temawierika pɨkaxuaweni matsi pɨta nutuixiya puxuaweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«Ne nepi'uxiwe'erie 'ixɨarari kexemɨte'ayexeiya,","poem":1},{"text":"nepɨkanaki'a tsepa patsiekamekɨ xemɨyukuxexeɨriwa nehetsiemieme.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Tsepa xemɨnetsi'atɨiriwa mawari taiyariyari meta hatsi mawariyari,","poem":1},{"text":"ne nepɨka'itanaki'erieni,","poem":2},{"text":"meta nepɨkaxe'enieni","poem":1},{"text":"tsepa tsikeru xemɨnetsi'utimawiri 'aixɨa temɨteyuxeiyanikɨ mawariyari.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"'Akwikari pepɨkanetsi'enitsitɨaka,","poem":1},{"text":"'akanari yuariyaya nepɨkaheu'enimɨkɨ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Matsi pɨta 'aixɨa mɨti'ane kexuaweni,","poem":1},{"text":"mɨtiheitserie ke'uhaneni haixa mɨka'ukawauke hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"»Teɨteri 'ixaheritsixi, mawari xepɨkanetsi'uwewiri meta 'imikieri,","poem":1},{"text":"makumawetsie xe'uhutɨ huta tewiyari wiyari.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hikɨ xeme xekanititɨkuni Tsikuti 'ɨkiyari ti'aitame xemɨte'iterɨwa,","poem":1},{"text":"metatsiere Kiyuni,","poem":2},{"text":"xurawetsixi wa'ɨkiyari","poem":1},{"text":"xemetɨtɨ xemɨwarutiwewi.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Hikɨ nekanixe'anunɨ'amɨkɨ xemanuhapanienikɨ Ramatsiku yeta paitɨ»,","poem":1},{"text":"Yawé mɨpaɨ kanaineni, Kakaɨyari Naimekɨmɨtɨrɨkaɨye mɨtitewa.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}