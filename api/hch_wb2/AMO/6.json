{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"AMO","translationId":"hch_wb2","name":"'Amuxi","commonName":"'Amuxi","title":"'Amuxi","order":30,"numberOfChapters":9,"sha256":"d3a7fd376dde915446c5897216262c8f85f9f31bb9cc6171e467942dcbcf09e4","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/hch_wb2/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Xɨa'ui xeme Kerutsareme xemɨtama kayuwatɨ xemexeiya,","poem":1},{"text":"xɨa'ui meta xeme Tsamariya hɨriyaritsie xemɨtama 'aixɨa 'iyari xemu'uwa.","poem":2},{"text":"Xɨa'ui xeme xemɨmamariwawe 'ikɨ kwieyaritsie xemu'uwa,","poem":1},{"text":"teɨteri 'ixaheritsixi memɨxe'ayexeiya xeikɨa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Karine xekenehu, xekenexeiya,","poem":1},{"text":"manata Kamati mɨmariwe hetsie xekenehu,","poem":2},{"lineBreak":true},{"text":"metatsiere Kahati xekenehu piritsiteutsixi wakiekaritsie.","poem":2},{"text":"¿Kamɨtsɨ xeme matsi waɨkawa xetemamariwawe keyuri mɨkɨ te'aitamete,","poem":1},{"text":"matsi xekwieyari 'atiyewa?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Xeme mɨpaɨ xepɨtemate 'uximatɨarika tukariyari xe'uku'eirieme xepuyu'erie,","poem":1},{"text":"matsi te'aitamete memɨxekwinikɨ hurawa xekaniuhuni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Xeme hupume witsimɨ'anenetsie xemahipite 'eripanite 'awateyakɨ ra'utɨkaime,","poem":1},{"text":"xe'uheitɨ xepaka'iyuniwa,","poem":2},{"text":"muxatsi 'aixɨa memɨ'anene xemɨwakwa'a","poem":1},{"text":"meta tsikerutsixi memɨwaiyatɨarietɨka,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Rawiri hepaɨ xeikɨa,","poem":1},{"text":"kwikari xepɨ'aita kaitsa hayuanekaku,","poem":2},{"lineBreak":true},{"text":"meta xepinetɨa tiyuitɨwamete yukɨ 'aneneme,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"winu xepɨye'e watsu 'amɨneneta","poem":1},{"text":"meta witsimu'ɨa xepɨyutiwiriwa 'aixɨa mɨ'ane,","poem":2},{"lineBreak":true},{"text":"xekayu'iyaritɨatɨ Kutse kemɨtika'unarieni,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"xeme meri xe'anuyetetɨ xekananuhapaniekuni,","poem":1},{"text":"mɨpaɨ katineutiparimɨkɨ 'ikwai memuxuawitɨa 'atsimekateyurietɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yawé naimekɨmɨyɨwe mɨpaɨ kaniutayɨni yɨhɨritɨatɨ,","poem":1},{"text":"Yawé Kakaɨyari Naimekɨmɨtɨrɨkaɨye mɨpaɨ kanaineni:","poem":2},{"lineBreak":true},{"text":"«'Ixaheritsixi kememɨteyuti'ɨre nepɨxani'erie,","poem":1},{"text":"waparatsiyu nepu'uxiwe'erie,","poem":2},{"text":"'ayumieme wakiekari nepɨyetuani mɨwaraye'unie hetsɨa,","poem":1},{"text":"meta naime mana mɨtiyepine».","poem":2}]},{"type":"verse","number":9,"content":["Mɨpaɨ katiniyɨmɨkɨ xɨka xeikiiyarita tamamata teɨteri meyuhayewa, mɨkɨ yunaitɨ mekanikwikuni."]},{"type":"verse","number":10,"content":["Kepauka memɨ'axɨani mɨkite mewaku'ɨtɨwetɨ mewatitaiyake, xewitɨ mɨpaɨ katinitahɨawimɨkɨ yu'iwa: «¿Xewitɨ 'akuxi 'ahamatɨa tiuyeika?» 'Iya mɨpaɨ katinita'eiyamɨkɨ: «Hawaikɨ». Hikɨta mɨpaɨ katinitahɨawimɨkɨ: «Kayuwatɨ». Yawé kemɨtitewa tepɨka'ikuxatani»."]},{"type":"verse","number":11,"content":[{"text":"Neuxei, Yawé katini'aitani","poem":1},{"text":"mɨta'unarienikɨ kii 'amɨpa 'etsipepetɨ kanitaxɨriexɨamɨkɨ","poem":2},{"lineBreak":true},{"text":"meta kii 'etsimupepe kanika'unamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"¿Kamɨtsɨ kawayutsixi 'aitsie mete'utinanautsa yatɨni","poem":1},{"text":"'ayeparitsie tuurutsixi metekwietsana?","poem":2},{"text":"Peru xeme 'aixɨa mɨti'ane 'uaye mumɨya xepayeitɨa,","poem":1},{"text":"meta tita mɨtiheitserie 'ikwaxi hatsiwime xepayeitɨa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Xeme xepɨyutemamawie Ru-Rewaxi kiekariyari xema'iwaxɨkɨ,","poem":1},{"text":"mɨpaɨ xeputiyuane: «¿Tatɨrɨkariyakɨ tepɨte'uyuri","poem":2},{"lineBreak":true},{"text":"Kaxinahini tema'iwaxɨ?»","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«'Ayumieme, 'ixaheritsixi","poem":1},{"text":"xehetsɨa xeime nepanunɨ'ani","poem":2},{"text":"mɨmatita'aitɨanikɨ waɨriyarika Rewu-Kamati xeyeta,","poem":1},{"text":"meta 'Arawa 'akiyari manuyeka xehetɨapai ye'atɨkaime»,","poem":2},"Yawé mɨpaɨ kanaineni, Kakaɨyari Naimekɨmɨtɨrɨkaɨye."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/AMO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/AMO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/AMO/5.json","previousChapterAudioLinks":{},"numberOfVerses":14}