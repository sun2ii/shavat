{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"AMO","translationId":"hch_wb2","name":"'Amuxi","commonName":"'Amuxi","title":"'Amuxi","order":30,"numberOfChapters":9,"sha256":"d3a7fd376dde915446c5897216262c8f85f9f31bb9cc6171e467942dcbcf09e4","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/hch_wb2/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":8,"content":[{"type":"heading","content":["Naurieka kemɨtiunierixɨ meta mari'itɨarika"]},{"type":"verse","number":1,"content":["Yawé naimekɨmɨyɨwe kaneniuxeitsitɨanita xeitsikɨiwitiyari 'ikwaxi kwakwaxime,"]},{"type":"verse","number":2,"content":["hikɨ mɨpaɨ kanetiniuta'iwawiya: ―¿'Amuxi, tita petixeiya? Ne mɨpaɨ nekatinita'eiya: ―Xei tsikɨiwitiyari 'ikwaxi kwakwaxime. Hikɨ Yawé mɨpaɨ kanetiniutahɨawe: ―'Ari kanaye'ani 'Ixaheri makaweni 'ikwaxi mukwaxi makaweni hepaɨ, tawariri nepɨkareiyehɨwirieni."]},{"type":"verse","number":3,"content":["»Yawé naimekɨmɨyɨwe mɨpaɨ kanaineni: ―'Iya tukaritsie, kwikari paratsiyuta mieme hiwerika kwikariyari kanayeimɨkɨ. Yuwaɨkawatɨ mepɨkwini naitsarie mɨkite mepeutiheni. 'Ayumieme kayuwatɨ»."]},{"type":"verse","number":4,"content":[{"text":"'Ikɨ xekeneu'eni, xeme memɨteheuyehɨwa xemɨwatiketsina","poem":1},{"text":"meta haweri memɨ'anene xemɨwakuya 'ena kwiepa.","poem":2}]},{"type":"verse","number":5,"content":["Xeme mɨpaɨ xekaniutiyuaneni:",{"text":"«¿Kepaukari payeika metseri mɨhekwa 'ixɨarariyari","poem":1},{"text":"'iku 'uriyari temutuanikɨ,","poem":2},{"text":"yatɨni, kepaukari 'uxipiya tukari paye'ani","poem":1},{"text":"tɨriku temutuanikɨ?»","poem":2},"Xeme xepiwautɨwe",{"text":"'inɨari 'etsipeme xemeyeitɨanikɨ","poem":1},{"text":"meta matsi 'amɨraye'akakɨ,","poem":2},{"text":"tepɨa ti'inɨnɨatame tinawayame xemayeitɨakɨ","poem":1}]},{"type":"verse","number":6,"content":[{"text":"meta tɨriku meuyewexime xemutuakɨ,","poem":2},{"text":"xepɨwanane teɨteri haweri memɨyɨa,","poem":1},{"text":"meta memɨteheuyehɨwa, kakai xeiparitsikɨ xepɨtewapatsirie.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yawé kaniyuhɨritɨani Kakuwu kemɨtiyuta'ɨrixɨkɨ: «Ne nepɨkaratɨmaiya kexemɨte'uyuri.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"»'Ikɨ naimekɨ kwie kaniwatayuamɨkɨ.","poem":1},{"text":"Mana kiekatari mekanitinutuixiekuni.","poem":2},{"text":"Kwie kanitiyeimɨkɨ Niru hayari hepaɨ,","poem":1},{"text":"kaniwatayuamɨkɨ meta kanikayeimɨkɨ,","poem":2},{"lineBreak":true},{"text":"'Ekipitu hatɨayari hepaɨ.","poem":2}]},{"type":"verse","number":9,"content":["»Yawé naimekɨmɨyɨwe mɨpaɨ kanaineni: 'Iya tukaritsie,",{"text":"»tuka tau nepanukayunitɨani,","poem":1},{"text":"meta naitsarie kwiepa kanikuyɨrimɨkɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Memɨte'ayexeiya wa'ixɨarari hiwerika payani,","poem":1},{"text":"meta wanɨawari hiwerika kwikariyari nekanayeitɨamɨkɨ.","poem":2},{"text":"Nutuixiya kamixayari nekaniwaranakatɨtɨamɨkɨ","poem":1},{"text":"meta wakɨpate nekanikaximɨkɨ.","poem":2},{"text":"Kemɨtiyuhiwerieka raniwe muyuxewi tiumɨyu mɨpaɨ mekatenitsuakuni,","poem":1},{"text":"'imatɨrieka ratsiwitɨ pɨrayani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"»Yawé naimekɨmɨyɨwe mɨpaɨ kanaineni: Tukari kanaye'amɨkɨ,","poem":1},{"text":"kepauka 'ikɨ kwieyaritsie haakaxa nemanɨ'ani,","poem":2},{"text":"matsi paa haakaxayari pɨka'ayani meta hariya,","poem":1},{"text":"Yawé niukieya mepɨ'eniekuni matsi","poem":2},{"lineBreak":true},{"text":"pukumawere mɨkɨ haakaxayari pɨtixuawere.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Teɨteri mepeu'uwani xeime haramaratsie xeimetsieta,","poem":1},{"text":"mepeu'uwani xeikɨa tayeta meta tau manatineika hepatsie,","poem":2},{"text":"Yawé niukieya mekuwautɨwetɨ,","poem":1},{"text":"peru mepɨka'itaxeiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"»Mɨkɨ tukaritsie hariyakɨ mepɨ'amɨxɨani","poem":1},{"text":"'ukari witsimemɨte'ɨimarixi meta temari memɨtɨrɨkawi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Meta mepatixɨrieni yuheyemekɨ","poem":1},{"text":"'iya Tsamariya kakaɨyariximama wahetsɨa memɨyuhɨritɨa,","poem":2},{"text":"meta mɨpaɨ me'utiyuatɨ: “Rani kakaɨyariximama, me'ayeneniereme memɨwa'erie.","poem":1},{"text":"Meta Weritsewa kakaɨyariximama pemɨwarayexeiya”».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/AMO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/AMO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/AMO/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}