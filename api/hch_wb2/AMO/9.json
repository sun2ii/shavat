{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"AMO","translationId":"hch_wb2","name":"'Amuxi","commonName":"'Amuxi","title":"'Amuxi","order":30,"numberOfChapters":9,"sha256":"d3a7fd376dde915446c5897216262c8f85f9f31bb9cc6171e467942dcbcf09e4","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/hch_wb2/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":9,"content":[{"type":"heading","content":["'Auxɨwirieka kemɨtiunierixɨ"]},{"type":"verse","number":1,"content":["Hikɨ Ti'aitame nekaniuxeiya mawari taiyame 'aurie 'uweme, mɨkɨ mɨpaɨ kaniutayɨni:",{"text":"«Keneutihutsuna memanutakɨkatsie mituikatɨka","poem":1},{"text":"muwatayuanikɨ,","poem":2},{"text":"wahetsie mɨkaxɨrienikɨ 'etsipepetɨ.","poem":1},{"text":"Kemɨ'ane memuyuhayewa 'ixiparakɨ nekaniwakwimɨkɨ.","poem":2},{"text":"Xewitɨ pɨkayuta'una,","poem":1},{"text":"nixewitɨ 'ayenieretɨ pɨkayuhayewa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tsepa mɨki teukiyata 'upaitɨ memɨyuti'awietaxɨ,","poem":1},{"text":"muwa nepɨwaratihapani.","poem":2},{"text":"Tsepa muyuawitsie paitɨ memanutikɨ,","poem":1},{"text":"manata nepɨwarakaxɨrieni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tsepa Kaximeru hɨriyaritsie memuyuti'awietaxɨ,","poem":1},{"text":"mana nepɨwatiwauni nepɨwatiwiya.","poem":2},{"text":"Tsepa menetsimakatɨ haramara tetɨatapai memɨyuti'awietaxɨ,","poem":1},{"text":"mana kuu nepɨta'aitɨani mɨwatikenikɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tsepa mɨwaraye'unie mɨwarehapa xeikɨa,","poem":1},{"text":"mana nepɨtita'aita 'ixiparakɨ memɨkwi'iwakɨ.","poem":2},{"text":"'Axanewayurienike meta 'aixɨa nemɨkawayuriekakɨ,","poem":1},{"text":"nepɨwaxeiyani».","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yawé naimekɨmɨyɨwe, Naimekɨmɨtɨrɨkaɨye,","poem":1},{"text":"kwie kanikumaɨwani, mɨkɨ kaneukupenikeni.","poem":2},{"text":"Kanitiyeikani meta kanikayeikani kwie","poem":1},{"text":"Niru hayari hepaɨ, 'Ekipitu muyeka,","poem":2},{"lineBreak":true},{"text":"meta mana memɨteye'uwa meyuhiwerietɨ mekanakɨkani.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kakaɨyari yuparatsiyu kaniutawewieni muyuawitsie","poem":1},{"text":"meta kwiepa tsutɨmeyari kaniutsutɨani,","poem":2},{"text":"haa haramaratsie mieme kaniutahɨaweni","poem":1},{"text":"hikɨ kanitayeuriwani kwiepa:","poem":2},{"lineBreak":true},{"text":"Yawé katinitewaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Yawé mɨpaɨ kanaineni:","poem":1},{"lineBreak":true},{"text":"'Ixaheritsixi, ¿tamɨ xeme","poem":1},{"text":"nehetsiemieme 'etiupetsixi wahepaɨ xekate'ane?","poem":2},{"text":"¿Tamɨ 'ixaheritsixi 'Ekipitu nekatiwarayewitɨ,","poem":1},{"text":"Kɨretatsie piritsiteutsixi wakwiepa,","poem":2},{"lineBreak":true},{"text":"meta Kixi tsiriyutsixi wakwiepa nekatiwarayewitɨ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"'Ayumieme Yawé naimekɨmɨyɨwe","poem":1},{"text":"'ena kwiepa 'axakemɨtiyɨane kanitaniereni.","poem":2},{"text":"Nekaniwarakumaweriyamɨkɨ kwiepa Kakuwu nuiwarimama,","poem":1},{"text":"tsepa yunaime nekawaruyuri,»","poem":2},"Yawé mɨpaɨ kanaineni."]},{"type":"verse","number":9,"content":[{"text":"Nekatinita'aitamɨkɨ 'ixaheritsixi memɨtikatsienikɨ","poem":1},{"text":"yunaime nuiwarite watsata,","poem":2},{"text":"xiekari manuyekatsieni hepaɨ tikatsemetsie,","poem":1},{"text":"xewitɨ tete kapitɨarietɨ kwiepa mɨkaweni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Ixiparakɨ mekanikwi'iwakuni","poem":1},{"text":"yunaitɨ 'axamemɨteyurie neteɨterima,","poem":2},{"text":"yunaitɨ mɨpaɨ memutiyuane:","poem":1},{"text":"“Tame mɨkɨ 'uximatɨarika tahetsie pɨkanuani","poem":2},{"lineBreak":true},{"text":"hatsuaku tɨma tahetsie pɨkaye'ani”.","poem":2}]},{"type":"heading","content":["'Ixaheri kemɨtihekwatɨarieni"]},{"type":"verse","number":11,"content":[{"text":"»Mɨkɨ tukaritsie nekanenukuketɨamɨkɨ","poem":1},{"text":"Rawiri kiiya matiwe.","poem":2},{"text":"Kemɨtiukatsitsini 'aixɨa nekaniyurimɨkɨ,","poem":1},{"text":"mɨti'u'uni 'aixɨa nekatinitiyurimɨkɨ","poem":2},{"lineBreak":true},{"text":"'aixɨa nekatinitiyurimɨkɨ meripaitɨ kemɨti'anenekai,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"mɨkɨ wapiini katinayeimɨkɨ 'Erumi mɨtiyuhayewa","poem":1},{"text":"meta hipame nuiwarite memɨnetsimate,»","poem":2},"Yawé mɨpaɨ kanaineni, mɨpaɨ katiniyurimɨkɨ."]},{"type":"verse","number":13,"content":["»Yawé mɨpaɨ kanaineni: Tukari kanamieni,",{"text":"kemɨ'ane mukwietsanane mɨ'itsanane kananuku'aximɨkɨ","poem":1},{"text":"meta kaxie mɨketsinane, mɨ'ene panuku'axe.","poem":2},{"text":"Naitɨ hɨritetsie winu makaka paneikatɨkani,","poem":1},{"text":"naitsarie mayeweweritsie puhapaneni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Aixɨa nekaniwayurimɨkɨ neteɨterima 'ixaheritsixi, tawarita nekaniwa'atɨamɨkɨ","poem":1},{"text":"mɨkɨ kiekarite mu'u'uni 'aixɨa mekanitiyuriekuni","poem":2},{"lineBreak":true},{"text":"mana mekanikutekuni.","poem":2},{"text":"Kaxie mekanika'ekuni meta winuyari mekani'iekakuni,","poem":1},{"text":"yuharaweri mepexeiyani meta mana mɨtiukaxuxuawereni mepɨtekwaka.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Ixaheri yukwietsie nepɨka'iteɨta,","poem":1},{"text":"para hatsuakuri mɨkahahunarienikɨ yukwieyaritsie nemiyetuiritsie»,","poem":2},{"lineBreak":true},"Yawé 'akakaɨyari mɨpaɨ kanaineni."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/AMO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/OBA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/AMO/8.json","previousChapterAudioLinks":{},"numberOfVerses":15}