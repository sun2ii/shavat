{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"DEU","translationId":"hch_wb2","name":"Hutarieka 'inɨari","commonName":"Hutarieka 'inɨari","title":"Hutarieka 'inɨari memupitɨarie","order":5,"numberOfChapters":34,"sha256":"a81e21129513d8723ac1e7ae7419e0ad0e4e9fa41e5e1ce15b1b562587d53d64","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/hch_wb2/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":32,"content":[{"type":"verse","number":1,"content":[{"text":"«Muyuawi keneu'ena kenemɨtayɨni,","poem":1},{"text":"kwie keneu'ena netetamiemekɨ kenemɨtayɨni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wiyeri hepaɨ ke'ukaxɨrieni ne'ɨkitɨarika 'aixɨa manuyɨne,","poem":1},{"text":"neniukikɨ ke'ukuhawire haɨtsi ximeri mieme hepaɨ,","poem":2},{"text":"'ɨxa mɨhehekwa waɨkawa kemɨtihatuiyarɨwa,","poem":1},{"text":"wiyeri waɨkawa kemɨtikaxɨrɨwe hepaɨ tupiriya mɨyɨyɨritsie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yawé hetsiemieme nepɨtaniuni nepitahɨawe.","poem":1},{"text":"'Aixɨa xekeneutiyuaneni Kakaɨyari mɨmariwekɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mɨkɨ tete kanikɨtɨni, 'uximayatsikaya pɨheitserie,","poem":1},{"text":"naitɨ huyeya 'aixɨa pɨ'anene.","poem":2},{"text":"Kakaɨyari yapɨtikamie, 'axapɨkatiyuriene.","poem":1},{"text":"Mɨkɨ heitserie pexeiya meta 'aixɨa pɨtiuka'iyari.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kemɨxetinake xepɨte'uyuri hetsiena mieme,","poem":1},{"text":"xemɨyutewiwiyanikɨ, xemeri xepɨkaniwemama,","poem":2},{"lineBreak":true},{"text":"nuiwari xemeutuni xepɨhɨkɨ 'axaxemɨte'u'iyari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"»¿'Ikɨkɨ Yawé xete'akapitɨwa,","poem":1},{"text":"teɨteri xemɨka'u'iyari?","poem":2},{"text":"Mɨkɨ kani'apaapatɨni, kameniunetɨani,","poem":1},{"text":"mɨkɨ pɨmatsi'utawewi, mɨmatsi'ukaye kanihɨkɨtɨni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Meripaitɨ mieme tukari xekena'eriwani,","poem":1},{"text":"meripaitɨ kexemuyɨ xekena'eriwani.","poem":2},{"text":"'Apaapa keneuta'iwawiya yamɨmatitahɨawekɨ,","poem":1},{"text":"meta 'ukirawetsixi mekemate'utaxatɨani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kepauka 'Amutewi nuiwarite wapiini mɨtiwayetuiri,","poem":1},{"text":"kepauka teɨteri kwiepa memɨtama mɨwareutanɨ'axɨa yuxexuime,","poem":2},{"text":"mɨkɨ teɨteri yukwie mehexeiyame pɨwarayeitɨa,","poem":1},{"text":"kememɨyupapaɨmekai yemekɨ 'Ixaheri niwemama.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Xemetsɨ Yawé kanixe'anayexeiya teɨterimama xemɨhɨkɨtɨnikɨ,","poem":1},{"text":"Kakuwu hetsiena mieme kanihɨkɨtɨni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Xeme pɨxe'ukaxei kwie makumawetsie,","poem":1},{"text":"yuxaɨtame xepu'uwakai.","poem":2},{"text":"Pɨxe'utinenimayataxɨ pɨxe'uta'ɨwiyaxɨ,","poem":1},{"text":"pɨxe'ɨwikai yuhɨxite hepaɨ,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"kwixɨ kaikame hepaɨ kemɨtiwakweriwayurie yuniwema yu'ituatsie,","poem":1},{"text":"wakuxexeɨriwatɨ,","poem":2},{"text":"yu'anatekɨ waranukanatɨ,","poem":1},{"text":"yu'anatsie warayatsatɨ kemɨtikuyeika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"»Yawé xeikɨa pɨxe'uwitɨximekai,","poem":1},{"text":"xewitɨ tawarita kakaɨyari yukɨ'anetɨ hamatɨana pɨka'umiekai.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hɨritsie pɨxe'uwitɨximekai","poem":1},{"text":"meta pɨxemikwakai 'ikwaxi yeuta mɨtixɨawekɨ.","poem":2},{"text":"Xiete pɨwamikwakai meta hatseiti,","poem":1},{"text":"tete mɨtse'itsie henetɨaka,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"wakaitsixi wakuneriyari kaniwaru'itɨani meta kapɨratsixi waretsi mepanu'i,","poem":1},{"text":"tsipuri meta muxatsi memɨwaiyatɨka,","poem":2},{"text":"tuurutsixi memɨwaiyatɨka wawaiyari Watsani miemete,","poem":1},{"text":"tɨriku takari mɨkɨkɨre,","poem":2},{"lineBreak":true},{"text":"kaxie winuyari mɨxure mepanu'i.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"»Ketsuruni putawaiyataxɨ meta pɨtiuyeketsi,","poem":1},{"text":"'ikwaikɨ xeikɨa putahuxai.","poem":2},{"lineBreak":true},{"text":"Putawaiyataxɨ putatɨrɨkaxɨa.","poem":2},{"text":"Kakaɨyari puku'eiri","poem":1},{"text":"tukari mipitɨa,","poem":2},{"lineBreak":true},{"text":"tete putixani'eri mitawikweitsitɨa,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Pɨwaruyehekaxɨ kakaɨyarixi hipame memɨwarayexeiyakaikɨ,","poem":1},{"text":"mepiyehaxɨatɨa yukakaɨyarixi memɨxani'eriwa wahekɨ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kakaɨyarixi 'axamemɨ'anene mepɨtewarutimawiri,","poem":1},{"text":"Kakaɨyari memɨkahɨkɨ,","poem":2},{"lineBreak":true},{"text":"kakaɨyarixi memɨkawamatekai,","poem":2},{"lineBreak":true},{"text":"kakaɨyarixi 'arikeke memune,","poem":2},{"lineBreak":true},{"text":"kakaɨyarixi wa'ukiyarima memɨkawarayexeiyakai.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tete mɨtse'i mepuku'eiri mɨwarutawewi.","poem":1},{"text":"Kakaɨyari mepatɨmai tukari mɨwarupitɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"»Mɨpaɨ tinieretɨ, Yawé pɨwarexɨri","poem":1},{"text":"niwemama 'ukitsi 'ukari memiyehaxɨatɨakɨ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hikɨ mɨpaɨ kaniutayɨni: “Nepɨwawarixiwiya,","poem":1},{"text":"tsipara kemeteheutere,","poem":2},{"text":"teɨteri 'axamemɨte'u'iyari mepɨhɨkɨ,","poem":1},{"text":"tɨɨri yamemɨkatekahu mepɨhɨkɨ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mepɨnetsi'uyehaxɨatɨa kemɨ'ane yuri mɨkakakaɨyarikɨ,","poem":1},{"text":"nepuyeha'a hipame kakaɨyarixi memɨwarayexeiyakaikɨ.","poem":2},{"text":"Neta yaxeikɨa nepɨwayurieni nepɨwayehaxɨatɨani kemɨ'ane memɨkaneteɨterima wahekɨ,","poem":1},{"text":"nepɨwayehaxɨatɨani teɨteri 'axamemɨte'u'iyari wahekɨ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nehaxɨa tai hepaɨ kaniutani,","poem":1},{"text":"naime mɨtititaiya mɨki teukiyapa.","poem":2},{"text":"Kwie pɨtaxɨtɨani meta naime mana mɨti'etsie,","poem":1},{"text":"meta hɨri nanari naime pɨtitaiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"»”Waɨkawa 'uximatɨarika nepɨtixuawitɨani wahetsie,","poem":1},{"text":"ne'ɨrɨ wahetsie nepɨtixɨtɨani.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Haaka nepanunɨ'ani muwatixɨtɨanikɨ,","poem":1},{"text":"kwiniya waɨkawa nepɨnetɨani mɨɨyakame.","poem":2},{"text":"Yeutari 'ɨrawetsixi,","poem":1},{"text":"meta kuterixi 'uaye memexeiya yutawikɨ memɨteku'uwa kwiepa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"'Ixiparakɨ mepɨkwi'iwa 'aniwema huye manuyehapanetsie,","poem":1},{"text":"yukie xekutetɨ xepɨmamaka.","poem":2},{"text":"Temari 'ɨimarixi mepɨkwini,","poem":1},{"text":"memɨtsitsewe meta'ukirawetsixi.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mɨpaɨ nepɨtiunehɨawixi: ‘Yunaime nepɨwataxɨriexɨani,","poem":1},{"text":"kwiepa nepɨwarakuyeitɨani memɨkaha'eriwanikɨ’.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Peru neputima 'axakemɨtiyurimɨkɨkaikɨ mɨnetsi'aye'unie,","poem":1},{"text":"neputima neneɨkixiwi kaheti'enatɨyanikɨ","poem":2},{"text":"meta mɨpaɨ tiu'erienikɨ: ‘Tame tekatenayu'iwa,","poem":1},{"text":"Yawé tixaɨtɨ 'atsipɨkatiuyuri.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"»Xeme nuiwari 'ixaheritsixi 'atsixemɨkatemate xepɨhɨkɨ,","poem":1},{"text":"xepɨkaheitimaitɨkɨka.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Xɨka xeme xemɨtemaiwawe xehɨkɨtɨnike hikɨ 'ipaɨ xeteyuhɨaweke,","poem":1},{"text":"xɨka mɨpaɨ xetehetimanike kexemɨ'itɨarienikɨ.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Tewi pɨkayɨwe yuxaɨta xeimiriyari mɨwara'iwa","poem":1},{"text":"xɨka teteya ka'ituanike.","poem":2},{"text":"Yuhutatɨ tamamata miriyari memɨwataweiyakɨ mepɨkayɨwawe","poem":1},{"text":"xɨka Yawé kawayetuanike.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Watete tatete hepaɨ pɨka'ane.","poem":1},{"text":"Memɨtatsi'aye'unie mɨpaɨ mepɨtemate.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Wakaxie Tsuruma yɨrariyari kanihɨkɨtɨni,","poem":1},{"text":"Kumuxa kwieyaritsie mɨti'u.","poem":2},{"text":"Wakaxie takari 'uaye mɨmɨyakɨ pɨhɨpɨne,","poem":1},{"text":"takari 'amɨranukate, tsiwiriya pɨhɨkɨ.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Wawinu kuuterixi 'uaye memexeiya hepaɨ pɨ'ane,","poem":1},{"text":"pɨtiyuhairiya kuu rakeyu mɨmɨya hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"»“Yakatinaye'amɨkɨ ne nekatinimaika yanekatiniyurimɨkɨ","poem":1},{"text":"'aixɨa nekatini'uta ne hakewa nemɨre'utatsie.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Neta yaxeikɨa 'anemekɨ nepɨtiwarakapitɨani.","poem":1},{"text":"Kepauka tukari yamɨraye'ani, mepekaxɨrieni.","poem":2},{"text":"Tukari pehurari","poem":1},{"text":"mexɨiwa paye'axime kememɨtekwine”.","poem":2}]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"»Yawé yuteɨterima wahetsie pɨtanuani","poem":1},{"text":"kepauka mɨwaxeiya mekatɨrɨkawime,","poem":2},{"text":"memɨte'i'uximayatsirie pɨwatinenimayata,","poem":1},{"text":"kepaukari waɨriyarika te'uximayatamete meta memɨxɨxɨni memumawenitsie.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Mɨpaɨ pɨtiwatahɨawe: “¿Hakewatamɨ xekakaɨyarixi,","poem":1},{"text":"tete kɨmana xemuyuti'awietaxɨ?","poem":2}]},{"type":"verse","number":38,"content":[{"text":"¿Hakewatamɨri xekakaɨyarixi","poem":1},{"text":"mawari yaxemɨtewawewiriekai waiyariyari xemutikwai","poem":2},{"lineBreak":true},{"text":"wawinu meta wahatseiti xemanu'i?","poem":2},{"text":"Mɨkɨ xehetsie meke'utanuani.","poem":1},{"text":"Mekexe'uparewieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"»”Hikɨ xekeneunenieri ne xeikɨa nepɨhɨkɨ","poem":1},{"text":"Kakaɨyari nemɨyuxewi,","poem":2},{"text":"xewitɨ tawarita 'apɨka'uyeika kakaɨyaritɨtɨ,","poem":1},{"text":"ne mɨɨya nepɨrapitɨani meta tukari nepɨrayetuirieni,","poem":2},{"lineBreak":true},{"text":"nepɨrakwinituani meta 'aixɨa nepɨrayurieni xewitɨ pɨkayɨwe mɨnetsitanewienikɨ netɨrɨkariyatsie.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Nemamate nepanukuhapana muyuawitsie nepeititsera mɨpaɨ nepɨtayɨni:","poem":1},{"text":"Ne 'anemuyeika nemɨhɨkɨ yuheyemekɨ,","poem":2}]},{"type":"verse","number":41,"content":[{"text":"kepauka ne'ixipara mɨxawatɨ nematamɨa","poem":1},{"text":"tukari 'aye'aku nepenukukwei,","poem":2},{"text":"nemɨtiwarakapitɨanikɨ memɨnetsi'aye'unie meta memɨnetsiheka wahepaɨtsita","poem":1},{"text":"kemɨtiheitserie.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Ne'ɨrɨ pɨtitarɨweni xuriyakɨ,","poem":1},{"text":"ne'ixipara pɨtiwaɨripieni wai kwatɨ:","poem":2},{"text":"memɨte'ukwinitɨarie memanutaxɨriya waxuriya,","poem":1},{"text":"kuyaxi memɨtewa'aitɨa memɨnetsi'aye'unie wamɨ'ute”.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"»Nuiwarite xekeneyutemamawieka Kakaɨyari teɨterimama wahamatɨa,","poem":1},{"text":"mɨkɨ yaxeikɨa pɨtiwarakapitɨani te'uximatamete waxuriya memutayeurikɨ.","poem":2},{"text":"Hikɨ Kakaɨyari yaxeikɨa pɨtiwarakapitɨani memɨxe'aye'unie wahekɨ","poem":1},{"text":"pɨwa'itieni naime wakiekari meta wakwie».","poem":2}]},{"type":"verse","number":44,"content":["Kutsuhexi Nuni nu'aya, Muitsexi hamatɨa teɨteri wahɨxie kwikari niukiyari putaterɨwaxɨ."]},{"type":"verse","number":45,"content":["Kepauka menunɨ yunaime 'ixaheritsixi mɨpaɨ pɨtiwarutahɨawixɨ:"]},{"type":"verse","number":46,"content":["«Xekena'eriwani yemekɨ 'ikɨ tukaritsie kenemɨtixe'utahɨawixi, yuniwema mɨpaɨ xeketeniwarutaxatɨa 'ikɨ 'aitsika niukiyaritsie heitseriemekɨ yamemɨtekahunikɨ."]},{"type":"verse","number":47,"content":["'Ikɨ niuki yapɨkayɨneme xehetsiemieme mɨkɨtsie xetewiyatɨ tukari xepexeiya, mɨkɨtsie xetewiyatɨ mɨixa xepɨyurieni kwiepa xekwie mayanitsie Kurutani 'anutaɨye»."]},{"type":"heading","content":["Muitsexi kemɨtiutahɨawarie kemɨtimɨnikekai"]},{"type":"verse","number":48,"content":["Mɨkɨ tukaritsie Yawé Muitsexi mɨpaɨ katiniutahɨawe:"]},{"type":"verse","number":49,"content":["«'Awarini hɨriyaritsie kenemie, mana Newu hɨriyari pekaneixeiyamɨkɨ, Muhawi kwieyaritsie, Keriku 'aurie mukuma, meta Kanani kwieyaritsie, mɨkɨ 'ixaheritsixi nekaniwayetuiriemɨkɨ."]},{"type":"verse","number":50,"content":["Mɨkɨ hɨri pemanutiyanitsie pekanimɨmɨkɨ, 'ateɨterima wahetsɨa pekaniyemieni, yaxeikɨa 'a'iwa 'Aruni kemɨtiumɨ meta mɨkɨ kemɨretɨa yuteɨterima wahetsɨa Huxi hɨriyatsie."]},{"type":"verse","number":51,"content":["'Ikɨ mɨpaɨ katinaye'amɨkɨ yunaime 'ixaheritsixi wahɨxie, xeme yuhutatɨ 'axaxemɨte'uyurikɨ Meriwa Kare haa mayematsie, Tsini makuwakitsie nepatsiekame xepɨkanetsi'ayeitɨa."]},{"type":"verse","number":52,"content":["'Ayumieme pepɨkata'ani kwiepa 'ixaheritsixi nemɨwayetuirienitsie, 'ateewa paitɨ xeikɨa pekanixeiyamɨkɨ»."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/DEU/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/DEU/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/DEU/31.json","previousChapterAudioLinks":{},"numberOfVerses":52}