{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"DEU","translationId":"hch_wb2","name":"Hutarieka 'inɨari","commonName":"Hutarieka 'inɨari","title":"Hutarieka 'inɨari memupitɨarie","order":5,"numberOfChapters":34,"sha256":"a81e21129513d8723ac1e7ae7419e0ad0e4e9fa41e5e1ce15b1b562587d53d64","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/hch_wb2/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":33,"content":[{"type":"heading","content":["Muitsexi nuiwarite 'aixɨa kemɨwaruyuri"]},{"type":"verse","number":1,"content":["Muitsexi 'akuxi kamɨwetɨ, Kakaɨyari ti'uximayatsiriwame, 'ixaheritsixi 'aixɨa kaniwaruyurieni:"]},{"type":"verse","number":2,"content":[{"text":"«Yawé Tsinahi heyeyaka kaninuani:","poem":1},{"text":"Yuteɨterima wahetsie punua, tau 'ɨrɨya hepaɨ 'anetɨ Tsehixi kwieyaritsie,","poem":2},{"text":"puhekɨarixɨ Parani hɨriyaritsie paitɨ,","poem":1},{"text":"meta kaninuani Meriwa-Karetsi","poem":2},{"lineBreak":true},{"text":"yutserie tau 'ɨrɨya hexeiyatɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Ekɨ pepɨhɨkɨ 'ateɨterima pemɨwanaki'erie,","poem":1},{"text":"yunaitɨ memɨpatsietɨka 'amamatsie mepɨte'ane.","poem":2},{"text":"'Ayumieme mekameniuweiyani,","poem":1},{"text":"'ɨxatsi 'ahetsɨa mieme mekaniukaxexeiyani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Aitsika Muitsexi mɨtatsi'uhɨritɨa kanihɨkɨtɨni,","poem":1},{"text":"Kakuwu teɨterimama tiwapiini.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yawé ti'aitame Ketsuruni wahetsie pɨhɨkɨtɨkai,","poem":1},{"text":"kepauka teɨteri memanuyetei memuyukuxeɨri,","poem":2},{"lineBreak":true},{"text":"meta yunaitɨ nuiwarite 'ixaheritsixi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"»Xuweni ke'ayeniereni, ke'uyeikani,","poem":1},{"text":"teɨterimama mepɨkayu'inɨatsinɨaka».","poem":2}]},{"type":"verse","number":7,"content":["Mɨpaɨta Kura hetsiemieme kaniutayɨni:",{"text":"«Yawé, Kura hiwarieya keneu'eni,","poem":1},{"text":"'ateɨterima keniwa'atɨa.","poem":2},{"text":"Kura puyumiene yutɨrɨkariyakɨ.","poem":1},{"text":"Keneuparewi memeye'unie wahepaɨtsita».","poem":2}]},{"type":"verse","number":8,"content":["Rewi hetsiemiemeta mɨpaɨ putayɨ:",{"text":"«'Urimi meta tumimi, 'apiini mɨtihɨkɨ,","poem":1},{"text":"pepiyetuiri tewi kemɨ'ane 'ahetsie mɨtiwiya.","poem":2},{"text":"Matsaha mɨrakutewatsie pepita'inɨataxɨ,","poem":1},{"text":"Meriwa hayaritsie mɨkɨ hamatɨa pemuyutami.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mɨpaɨ putayɨ yupaapa meta yumaama wahetsiemieme:","poem":1},{"text":"“Tixaɨtɨ pɨkatiwarayeitɨaka”.","poem":2},{"text":"Yu'iwama pɨkawaretima,","poem":1},{"text":"meta yaxeikɨa yuniwema pɨkawaretima,","poem":2},{"text":"peru 'aniuki pu'eni","poem":1},{"text":"'atɨratutsie yapɨtikatɨa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'A'aitsika Kakuwu puta'ɨkitɨa,","poem":1},{"text":"meta 'a'inɨari niukiyari 'ixaheri.","poem":2},{"text":"Mawari taiyametsie pumatiyetuiri,","poem":1},{"text":"'ɨkwa witsimu'ɨa meta mawari mɨtaiyarietɨka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yawé, 'aixɨa keniwayurieka kememɨteyurie","poem":1},{"text":"ketiniwanaki'eririeka tiwamayɨitari.","poem":2},{"text":"Memɨwaraye'unie watɨrɨkariya keneuka'una,","poem":1},{"text":"tawariri memɨkawakwitɨwenikɨ memɨwaraye'unie».","poem":2}]},{"type":"verse","number":12,"content":["Mɨpaɨta Wenikamini hetsiemieme putayɨ:",{"text":"«Yawé mɨnaki'erie, hamatɨana 'aixɨa 'anemekɨ ke'uyeikani,","poem":1},{"text":"mɨkɨ mi'ɨwiyakɨ tukarikɨ","poem":2},{"lineBreak":true},{"text":"meta kayuwatɨ hetsiena pu'uxipie».","poem":2}]},{"type":"verse","number":13,"content":["Kutse hetsiemieme mɨpaɨta putayɨ:",{"text":"«Yawé 'akwie 'aixɨa keyurieka","poem":1},{"text":"haɨtsi muyuawitsie makaneikakɨ","poem":2},{"lineBreak":true},{"text":"meta haa kwieta matineikatɨkakɨ,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'aixɨa ti'aneneme ketiuka'itsanani mukawiwiyetsie,","poem":1},{"text":"meta 'aixɨa ti'aneneme 'ikwaxi xeimetseritsie timieme,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'aixɨa ti'aneneme hɨritsie timieme","poem":1},{"text":"meta hɨri 'amanutitɨtɨtsie miemekɨ yuheyemekɨ 'aixɨa ke'itɨarieka,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"'aixɨa mɨti'anene kwiepa mɨtixuawekɨ,","poem":1},{"text":"meta ke'iparewieka 'ɨtsi mɨta'a hetsie mɨkiekame.","poem":2},{"text":"'Ikɨ naitɨ Kutse hetsie ketiunake,","poem":1},{"text":"yu'iwama watsata manayexeiyarie 'aixɨa mɨtiyurienikɨ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kutse pɨmariwe tuuru mexɨakame hepaɨ,","poem":1},{"text":"pɨtɨrɨkaɨye tuuru yeutanaka hepaɨ.","poem":2},{"text":"Yu'awatekɨ pɨwatakwini nuiwarite hipame,","poem":1},{"text":"pɨwakuxeɨrieni kwie manunieretsie paitɨ.","poem":2},{"text":"Mɨpaɨ mepɨtetɨrɨkawi Manatsexi kuyaximama,","poem":1},{"text":"meta 'Epɨrahini kuyaximama memuyuwaɨkawa».","poem":2}]},{"type":"verse","number":18,"content":["Tsawuruni hetsiemieme mɨpaɨta kaniutayɨni:",{"text":"«'Ekɨ, Tsawuruni, pepɨ'atemawie pekuyeikatɨ xeikɨa,","poem":1},{"text":"'ekɨta, 'Itsakaxi, 'a'ixuriki kiiyarita xeikɨa pepayeka.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hipame teɨteri mepɨwata'inieni hɨritsie memuhukɨ,","poem":1},{"text":"mana mawari memewewienikɨ 'aixɨa memɨteyuriekɨ.","poem":2},{"text":"Mepɨyutemamawieka haramaratsie tita waɨkawa mɨtixuawekɨ","poem":1},{"text":"meta mɨraye'axe xiekarita mɨti'awietsiekɨ».","poem":2}]},{"type":"verse","number":20,"content":["Kahari hetsiemiemeta mɨpaɨ kaniutayɨni:",{"text":"«'Aixɨa ke'itɨarieka kemɨ'ane Kahari kwieya 'amɨtayeuriya.","poem":1},{"text":"Kahari mana puyeika maye hepaɨ,","poem":2},{"lineBreak":true},{"text":"mamate wayetsanatɨ meta mu'ute.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kwie 'aixɨa mɨ'ane panayexei yuhetsiemieme,","poem":1},{"text":"puyuti'utsiri mɨkɨ kwie manuyehaitɨa mɨhɨkɨtɨkaikɨ,","poem":2},{"text":"Kepauka teɨteri memanuyetei memɨyukuxeɨri,","poem":1},{"text":"mɨkɨ yapɨtikatɨa Yawé kemɨtinake,","poem":2},{"lineBreak":true},{"text":"yaxeikɨa kemɨtiwarutahɨawekai yuteɨterima».","poem":2}]},{"type":"verse","number":22,"content":["Rani hetsiemiemeta mɨpaɨ kaniutayɨni:",{"text":"«Rani maye nunutsi puhɨkɨ,","poem":1},{"text":"Watsani paitɨ mutsunane».","poem":2}]},{"type":"verse","number":23,"content":["Nepɨtahari hetsiemiemeta mɨpaɨ kaniutayɨni:",{"text":"«Nepɨtahari Yawé kemɨtiparewie panayuhayewa","poem":1},{"text":"Yawé 'aixɨa miyuriekɨ, 'aixɨa pɨ'itɨarie waɨkawa,","poem":2},{"text":"mɨra'aita pɨwere haramaratsie 'uye'atɨkaitɨ","poem":1},{"text":"meta makuwakitsie paitɨ».","poem":2}]},{"type":"verse","number":24,"content":["'Atsexi hetsiemiemeta mɨpaɨ kaniutayɨni:",{"text":"«'Atsexi matsi waɨkawa 'aixɨa pɨ'itɨarie yu'iwama watsata,","poem":1},{"text":"'iwamama yunaitɨ meke'inaki'erieka,","poem":2},{"lineBreak":true},{"text":"meta yu'ɨkatetsie huriwa hatseitiyarikɨ waɨkawa kewiriyarietɨkani.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"'A'ituparite warita mauku'uwe tepɨa meta wurunitse tepɨayari pɨhɨkɨtɨni,","poem":1},{"text":"'apekereutere 'ape'uyeikatɨ petɨrɨkaɨyetɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"»Xewitɨ pumawe Ketsuruni Kakaɨyarieya hepaɨ 'aixɨa tiuka'iyaritɨ,","poem":1},{"text":"xeparewienike muyuawitsie pakaneika,","poem":2},{"lineBreak":true},{"text":"haitsata, waɨkawa mariwetɨ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kakaɨyari yuheyemekɨ 'amuyeika 'ahetsie pununuwame,","poem":1},{"text":"yuheyemekɨ pɨmatsi'atu'u.","poem":2},{"text":"Memɨmatsi'aye'unie 'ahɨxie pɨwataweiya.","poem":1},{"text":"Pɨmatsita'aitɨani pemɨwareuyehɨanikɨ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"'Ixaheri, tixaɨtɨkɨ pepɨkareuyukweriwayurieka,","poem":1},{"text":"'Axekeneu'uwani hipatɨ mekaxe'aye'uniekakɨ, Kakuwu nuiwarimama.","poem":2},{"text":"Xekwie waɨkawa tɨriku pexeiya meta kaxie winuyari,","poem":1},{"text":"muyuawi xeheima muyema haa puxuawitɨa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"'Ixaheritsixi, xekeneyutemamawieka yutukarikɨ.","poem":1},{"text":"¿Tawari kemɨ'ane 'aku xehepaɨ,","poem":2},{"lineBreak":true},{"text":"mepɨwikweitsitɨarie Yawé hetsie?","poem":2},{"text":"Mɨkɨ 'ahetsie nunuwame pɨhɨkɨ meta metsiparewiwame,","poem":1},{"text":"mɨkɨ xe'ixipara pɨhɨkɨ kɨmana xemɨtehayu'iwa.","poem":2},{"text":"Memɨxekwitɨwe xehɨxie mepɨtitunuma'uni,","poem":1},{"text":"wawari, hetsiena xema'uwe pakɨne».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}