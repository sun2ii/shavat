{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ECC","translationId":"hch_wb2","name":"Ti'ɨkitame","commonName":"Ti'ɨkitame","title":"Ti'ɨkitame","order":21,"numberOfChapters":12,"sha256":"7601f83c1d0f691c18df25a0734279b250005e1292efb09c70f3ecd4823e1302","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/hch_wb2/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":1,"content":[{"type":"heading","content":["Ti'ɨkitame"]},{"type":"verse","number":1,"content":["'Ikɨ kanihɨkɨtɨni ti'ɨkitame niukieya, Rawiri nu'aya, Kerutsareme mɨti'aitametɨkai."]},{"type":"verse","number":2,"content":[{"text":"Mɨpaɨ kanaineni ti'ɨkitame:","poem":1},{"text":"—Tita tixaɨtɨ temɨte'erie,","poem":2},{"text":"tixaɨtɨ pɨkatihɨkɨ,","poem":1},{"text":"naitɨ tixaɨtɨ pɨkatihɨkɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"¿Ketita ra'iwa tewi,","poem":1},{"text":"waɨkawa tiyurienetɨ 'ikɨ tukaritsie timieme?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hipatɨ mepɨtakukuwe, hipatɨta mepɨtinunuiwa,","poem":1},{"text":"matsi kwie yaxeikɨa kani'aneni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tau panatineika meta pakayuyuipike,","poem":1},{"text":"mɨkɨ yumexɨitɨatɨ yuhuyeripa","poem":2},{"lineBreak":true},{"text":"tawarita yu'ɨtɨma manatinenikɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tatsutɨa kaniu'ekani,","poem":1},{"text":"tatsierieta hekututuketɨ,","poem":2},{"text":"tawarita hekwamekɨ muku'ekakɨ yu'utɨma","poem":1},{"text":"katihayewatɨ kaniu'ekani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Aki 'amɨpapa haa muhapane haramaratsie peukayuyuipike,","poem":1},{"text":"peru hatsuaku haramara pɨkatahɨne.","poem":2},{"text":"Tawarita yu'utɨma kani'atɨwani,","poem":1},{"text":"mɨkɨ muhapanenikɨ 'axeikɨa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Waɨkawa pɨkwaniwe nemɨtitaxatakɨ","poem":1},{"text":"matsi waɨkawa kemɨtiyɨwe mɨtiutaxatakɨ.","poem":2},{"text":"Naka matsi waɨkawa mɨpaɨ katineu'enamɨkɨni,","poem":1},{"text":"Meta hɨxite pɨka'uxiwe mɨtanierenikɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Meripaitɨ kemɨtiuyɨ","poem":1},{"text":"mɨpaɨta katiniyɨmɨkɨ:","poem":2},{"text":"ketita meripaitɨ mɨtiutiwewiya","poem":1},{"text":"naitɨri katinihekɨaka,","poem":2},{"lineBreak":true},{"text":"tawari tihekwatɨ pɨtiumawe 'ena muyuawitɨa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Xewitɨ pɨyɨwe mɨpaɨ mutayɨni:","poem":1},{"text":"«Neuxei 'ikɨ kanihekwanike».","poem":2},{"text":"Matsi meripaitɨ katinixuawekaitɨni yuheyemekɨ,","poem":1},{"text":"tame 'akuxi tekatinunuiwawawekaku.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tame hikɨ hipame tepɨkawara'eriwa kememɨte'uyuri,","poem":1},{"text":"ta'utɨmata memɨtinunuiwa 'atsimepɨkatehetimani ketemɨteyurie hikɨ.","poem":2}]},{"type":"heading","content":["Matɨari mieme 'ɨkitɨarika"]},{"type":"verse","number":12,"content":["Ne, Ti'ɨkitame, Kerutsareme nepɨti'aitametɨkai 'Ixaheritsixi watsata."]},{"type":"verse","number":13,"content":["Nepɨnewaɨri yanemɨretimanikɨ kemɨti'anekɨ 'ena kwiepa, mɨpaɨ nepɨretima Kakaɨyari 'uximayatsika pɨtatsi'uku'eiriri waɨkawa haheteme tame yatemɨtekakɨnekɨ hetsiena."]},{"type":"verse","number":14,"content":["Naime mɨpaɨ nepɨretima ketemɨteyurie 'ena kwiepa, pɨkatiyupata 'eka muweiyani hepaɨ kani'aneni."]},{"type":"verse","number":15,"content":[{"text":"Titunime mutaxeurariya pɨkayɨwe,","poem":1},{"text":"meta pɨkayɨwe miti'inɨatakɨ kepaɨmetɨ meuyewetse.","poem":2}]},{"type":"verse","number":16,"content":["Merikɨte nepɨneti'iyaritɨa: «Waɨkawa nepeukawe meta nepɨtimaiwe keyuri meripaitɨ te'aitamete Kerutsaremetsie, ne naimekɨ nepɨyɨwe nemɨtitiwaunikɨ netimaiwetɨ waɨkawamekɨ meta neheitimaitɨyeikatɨ."]},{"type":"verse","number":17,"content":["Ne yemekɨ nepɨneyetua netimaiwetɨ nemayanikɨ, nekanimaikata mɨkayɨkɨhɨawe meta mɨka'uka'iyari, matsi mɨkɨ 'eka manuku'axe hepaɨ kani'aneni."]},{"type":"verse","number":18,"content":["Matsi puyuri,",{"text":"»kepauka waɨkawa memɨtemaiwawe matsi waɨkawa kanixuaweni 'uximatɨarika,","poem":1},{"text":"kepauka waɨkawa memɨtemate waɨkawa mepɨte'ukakukuine».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ECC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ECC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/31.json","previousChapterAudioLinks":{},"numberOfVerses":18}