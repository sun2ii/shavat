{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ECC","translationId":"hch_wb2","name":"Ti'ɨkitame","commonName":"Ti'ɨkitame","title":"Ti'ɨkitame","order":21,"numberOfChapters":12,"sha256":"7601f83c1d0f691c18df25a0734279b250005e1292efb09c70f3ecd4823e1302","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/hch_wb2/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":10,"content":[{"type":"heading","content":["Mɨtimaiwekɨ 'ɨxatsiyari"]},{"type":"verse","number":1,"content":[{"text":"Xaipɨtsi memɨkwikwi'i 'axamekaniu'ɨatɨkani,","poem":1},{"text":"tita witsimɨtiu'ɨa katinanuyeitɨwani.","poem":2},{"text":"Mɨpaɨ katinimatsiɨkɨni xɨka 'etsiwa mɨkayɨkɨhɨawe pe'ayani,","poem":1},{"text":"pɨkayɨwe muyutaxewire mɨtimaiwenikɨ meta 'aixɨa mɨtixeiyariekakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mɨtimaiwe katinikuwauneni tita 'aixɨa mɨti'ane yu'iyaritsie,","poem":1},{"text":"matsi 'atsimɨkatimate katinikuwauneni 'axamɨti'ane.","poem":2}]},{"type":"verse","number":3,"content":["Meta huye'utɨa kemɨtimie 'atsimɨkatimate waɨkawa katineiyehɨaka mɨretimanikɨ, 'anari yunaitɨ mɨpaɨ mekatenetimaikuni kename 'atsikatimate."]},{"type":"verse","number":4,"content":["Xɨka ti'aitame 'uyeha'ani 'ahepaɨtsita, pepɨka'iku'e'eiriwani ketitakɨ pemɨtihɨritɨarie. Petiukanewietɨ waɨkawa 'axapemɨtiuyurikɨ kani'ayumiemetɨni."]},{"type":"verse","number":5,"content":["Xewitɨ kanixuaweni tita 'axamɨti'ane, te'aitamete meheuyexɨrɨwetɨ kememɨteyurie hepaɨ tiyuxexeiyatɨ:"]},{"type":"verse","number":6,"content":["'atsimɨkatimate matsi waɨkawa katinihɨritɨarieka timamariwawemekɨ, peru memɨyɨwawe matsi 'etsiwa xeikɨa mekatenihɨritɨarieka."]},{"type":"verse","number":7,"content":["Nekaniwaxeiyanita waɨriyarika te'uximayatamete kawayutsixi wahetsie mekaniuteni te'aitamete wahepaɨ, teɨterita tewa'aitɨwamete yu'ɨkama mekaniku'uwani waɨriyarika te'uximayatamete wahepaɨ."]},{"type":"verse","number":8,"content":[{"text":"Putsu xɨka 'utawewieni,","poem":1},{"text":"muwa kaneukawemɨkɨ.","poem":2},{"text":"Kemɨ'ane 'ixumeri hixɨata 'akame mɨta'una,","poem":1},{"text":"kuu kanikeimɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Xɨka tetexi pe'utitara,","poem":1},{"text":"mɨkɨ tetexi kametinikwinitɨamɨkɨ.","poem":2},{"text":"Kemɨ'ane kɨye mawiteni,","poem":1},{"text":"mɨkɨ kɨyexikɨ katiniyukwinitɨaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Hatsa xɨka ka'ataxikaunini,","poem":1},{"text":"meta xɨka ka'etamɨani,","poem":2},{"lineBreak":true},{"text":"matsi karima katinewitekemɨkɨ.","poem":2},{"text":"Xɨka petimaimɨkɨni ketine'uximayaka 'aixɨa 'anekamekɨ,","poem":1},{"text":"petimaitɨ meta 'aixɨa peti'a'ɨwiyatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Xɨka kuu tiuyukeni meri 'akuxi kwikarikɨ kakewaiyariewetɨ,","poem":1},{"text":"tixaɨtɨ pɨkara'iwa 'ikewaiyame.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kepauka mɨtimaiwe mɨtiwakuxaxatɨwa, teɨteri 'aixɨa 'anemekɨ mekani'enieka,","poem":1},{"text":"matsi kepaukata 'atsimɨkatimate mɨtikuxata, mɨkɨ xeikɨa kaniwaka'unani,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Matɨari mieme niukieya tixaɨtɨ pɨkatihɨkɨ,","poem":1},{"text":"'imatɨrieka 'aixɨa pɨkatinɨni 'atsimɨkatimatekɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Matsi xewitɨ pɨkayɨwe yamɨtayɨnikɨ.","poem":2},{"lineBreak":true},{"text":"Xewitɨ pɨkatimate kemɨtiyɨni,","poem":1},{"text":"meta 'arikeke kemɨyɨni,","poem":2},{"lineBreak":true},{"text":"xewitɨ pɨkayuwe yamɨtayɨnikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mɨka'uka'iyari kemɨti'uximaya yakɨ xeikɨa katiniyu'uxitɨaka,","poem":1},{"text":"meta kiekari huyeyari 'utɨma pɨkahemarie.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Xɨa'ui kiekari ti'aitame mɨkatseɨye mɨra'aitatsie, meta tewa'aitɨwamete","poem":1},{"text":"ximeri paitɨ mekanayatsarɨwani memɨtekwanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Matsi witsikatinikɨhɨawarɨwani kemɨ'ane kiekaritsie ti'aitame 'aixɨa mɨti'uximaya,","poem":1},{"text":"meta te'aitamete kepauka memɨtekwa'a mauyewetsetsie,","poem":2},{"lineBreak":true},{"text":"waɨkawa memɨtitɨrɨkaxɨanikɨ memɨtarɨwekakɨ pɨkatixaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Mɨyu'ɨraxie kiiya heima mieme kananuka'unikeni,","poem":1},{"text":"mɨkatikumaɨwa kiiya kaniuhayeweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Paa kwatɨ kaniutanawemɨkɨ,","poem":1},{"text":"winu'ietɨ kaniyutemawiekamɨkɨ,","poem":2},{"lineBreak":true},{"text":"tuminita mitixɨtɨanikɨ kani'ayumiemetɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ti'aitame 'axapepɨkatikumamateni meta 'axapepɨkatiku'eriyani,","poem":1},{"text":"meta mɨxiku 'awie 'axapepɨkarahɨaweni,","poem":2},{"text":"wikixi muyuawitsie miemete mekaniyɨwaweni niuki memenɨtɨkirienikɨ.","poem":1},{"text":"Mekaniu'anani mekaniyɨwaweni memɨte'itaxatɨanikɨ.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ECC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ECC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ECC/9.json","previousChapterAudioLinks":{},"numberOfVerses":20}