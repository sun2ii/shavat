{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ECC","translationId":"hch_wb2","name":"Ti'ɨkitame","commonName":"Ti'ɨkitame","title":"Ti'ɨkitame","order":21,"numberOfChapters":12,"sha256":"7601f83c1d0f691c18df25a0734279b250005e1292efb09c70f3ecd4823e1302","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/hch_wb2/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"Hata keneukahɨwa 'apaa,","poem":1},{"text":"yapaɨmexɨa tukari 'anukayayu 'ana keta pekanitaxeiyamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Me'atahutame yatɨni me'atahaikame","poem":1},{"text":"ketiniwarumikwa tita pemɨrexeiya,","poem":2},{"text":"'atsipemɨkatimatekɨ tita 'uximatɨarikayari","poem":1},{"text":"'umɨramie 'ena kwiepa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Haiwitɨri kepauka mayemanenitsie,","poem":1},{"text":"kwiepa wiyeri kanikaxɨriemɨkɨ.","poem":2},{"lineBreak":true},{"text":"Kɨye xɨka tatsutɨa hataweni,","poem":1},{"text":"yatɨni tayeta,","poem":2},{"lineBreak":true},{"text":"hakewa meutaweni mana kaniyuhayewamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kemɨ'ane 'eka xeikɨa mɨtaxeiya, pɨka'uka'etsa,","poem":1},{"text":"kemɨ'aneta haiwitɨri xeikɨa mɨtaxeiya mɨkɨta pɨka'uka'itsana.","poem":2}]},{"type":"verse","number":5,"content":["Mɨpaɨ 'atsipemɨkatimatekɨ 'eka kemɨreumie, meta kehepaɨ memɨtekununuiwa tɨɨri yumamama wahukatsie, yaxeikɨata Kakaɨyari 'uximayatsikaya pepɨka'enie naime mɨtiutiwewi."]},{"type":"verse","number":6,"content":["Ximeri paitɨ 'a'imɨari keneuka'etsa, taikaita 'uxipiya pepɨkahexeiyani, matsi 'atsipepɨkatimate ke'anetɨ 'etsiyari 'aixɨa mɨtiyɨni, xɨka 'iya yatɨni 'ikɨ, yamatsi naitɨ 'aixɨa 'anenetɨ pɨrayani."]},{"type":"verse","number":7,"content":["Hekɨariya witsikani'aneni, 'aixɨata kani'aneni tau hekɨariyayari xeiyatɨ 'amuyeikani."]},{"type":"verse","number":8,"content":["Xɨka tewi matsi mɨixa wiyari 'a'uyeikani hetsiena yutemawietɨ, matsi tukari tekeha'eriwani 'uximatɨarika mɨtixuaweretsie waɨkawa katiniyɨmɨkɨ, meta tita 'umɨramie 'ana yakɨ xeikɨa pɨkarayani."]},{"type":"heading","content":["Matsi'utawewi kena'eriwani"]},{"type":"verse","number":9,"content":["Hikɨ kene'atemawieka mexi petemaikɨ, 'a'iyari keneupitɨa mɨyutemawiekakɨ. Kemɨtiku'eriwa keneyeweiyani meta 'ahɨxitekɨ kepemɨtiuyukahiwe'erie, matsi kena'eriwani Kakaɨyari mɨkɨ naimekɨ kamenita'iwawiyamɨkɨ."]},{"type":"verse","number":10,"content":["'A'iyaritsie haxɨa pepɨkapitɨaka, 'ahetsie tita 'axamɨti'ane ketinayeweiya, matsi temaikɨ yu'erietɨ meta temaikɨyari yakɨxeikɨa kanihɨkɨtɨni."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ECC/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ECC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ECC/10.json","previousChapterAudioLinks":{},"numberOfVerses":10}