{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ECC","translationId":"hch_wb2","name":"Ti'ɨkitame","commonName":"Ti'ɨkitame","title":"Ti'ɨkitame","order":21,"numberOfChapters":12,"sha256":"7601f83c1d0f691c18df25a0734279b250005e1292efb09c70f3ecd4823e1302","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/hch_wb2/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Kemɨ'ane matsi'utawewi kena'eriwani,","poem":1},{"text":"hikɨri pemɨtemaikɨ,","poem":2},{"text":"mexinetɨ tukari 'axamɨ'ane ka'aye'awe,","poem":1},{"text":"kepauka mɨpaɨ pemɨtayɨni:","poem":2},{"lineBreak":true},{"text":"«Pɨkanetsinakeri 'anemuyeikanikɨ mɨixa wiyari»,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"matsi'utawewi kena'eriwani mexinetɨ mehekɨariwie","poem":1},{"text":"tau meta hekɨariya xuawe,","poem":2},{"text":"metseri meta xurawetsixi mehekɨariwie,","poem":1},{"text":"meta mexi haiwitɨri 'anuku'eke kepauka wiyeri mɨtitahayewatsie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tukari Kanaye'amɨkɨ kepauka kii hɨwemete memɨtiyɨyɨaka marikakɨ,","poem":1},{"text":"mekananakatutsirikuni yukukuyamete,","poem":2},{"text":"'anari mekatenihayewakuni tɨxɨmete memɨkayumɨirenikɨ,","poem":1},{"text":"'anarita mepɨkaneniereni, 'itupari 'etsi mayeyeutsie memaneniere.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Katinaunarirɨmemɨkɨ kitenie kaye 'utɨa mieme,","poem":1},{"text":"'anari kananukanuaximemɨkɨ murina yuariyaya,","poem":2},{"text":"wikixi yukwikari mekananukuhanikuni,","poem":1},{"text":"matsi wakwikari pɨtɨkini puka'enierieka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Marika Kanitixuawerimɨkɨ hɨrite 'amanutitɨtɨtsie,","poem":1},{"text":"'anarita huyeta kaniumariwemɨkɨ.","poem":2},{"text":"'Arimenitɨra meta 'ana kanitixutuimɨkɨ,","poem":1},{"text":"'utsikari mekani'axɨakuni yumɨiretɨ,","poem":2},{"lineBreak":true},{"text":"mekanikakɨmikuni 'anari tixaɨtɨ tiyunaki'erietɨ pɨka'ayani,","poem":2},{"text":"tewi kaniyemieni kiekari 'emɨtiteriwetsie,","poem":1},{"text":"kaye'utɨa mekaniyexɨrietɨwekuni, meyuhiwerietɨ 'akaxari mexeiyatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kena'eriwani kemɨ'ane matsi'utawewi,","poem":1},{"text":"mexi katatsaniwe pɨrata hɨiyameyari,","poem":2},{"lineBreak":true},{"text":"meta mexi katatariwe huru xariyari,","poem":2},{"text":"meta xari haa manakaxɨrɨwetsie katitawaxɨawe,","poem":1},{"text":"tsikɨrɨrɨiya katitarixɨawawe putsuta mɨiretɨ ka'ayeiwe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Anari kwiepa tumuanari kanayeimɨkɨ,","poem":1},{"text":"meripaitɨ mɨ'anekai hepaɨ,","poem":2},{"text":"'iyari kanakunuamɨkɨ Kakaɨyari hetsɨa,","poem":1},{"text":"mɨkɨ mana meiyenɨ'akɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ti'ɨkitame mɨpaɨ nekanaineni:","poem":1},{"text":"'ikɨ tukari tixaɨtɨ pɨkarexeiya,","poem":2},{"lineBreak":true},{"text":"naitɨ 'axakatini'aneni.","poem":2}]},{"type":"heading","content":["Niuki 'imatɨarieka mieme"]},{"type":"verse","number":9,"content":["Matsi waɨkawa timaiwetɨ, ti'ɨkitame teɨteri katiniwarutaxatɨani naime ketita mɨretima. Mɨkɨ naime katineutixeiyaxɨani yumarima, mɨireme temaiwawemete kememɨte'u'ɨxatsita waxapa kanayeitɨani."]},{"type":"verse","number":10,"content":["Tsiepɨre hipame niukite kaniutaxeiya 'aixɨa 'anuyɨtɨkaime, mɨkɨta kaniti'utɨani yumarima yuri mainekɨ."]},{"type":"verse","number":11,"content":["Memɨtemaiwawe waniuki tiyutseweme hepaɨ kani'aneneni. Kɨrapuxite 'aixɨa mɨretsunini hepaɨ mekatenikuxatani, xewitɨ xeikɨa tixaxatame tiwakuxaxatɨwakaku."]},{"type":"verse","number":12,"content":["Ne matsi mɨkɨ hepaɨtsita nematsihaye'eritɨwa 'ekɨ neniwe nematsinaki'erie, waɨkawa xapate xɨka'utiwewieni pɨkayɨnɨrinɨa, meta xɨka pe'ititerɨwa pekaniti'uximɨkɨ waɨkawa."]},{"type":"verse","number":13,"content":["'Imatɨarieka 'ikɨ niuki naitɨ kaniu'enierieni. Kakaɨyari matsi kenayemakaxeni, yaketinekamieni 'aitsikayatsie, 'ikɨ naitɨ tewi hetsie kanimiemetɨni."]},{"type":"verse","number":14,"content":["'Uximayatsika matsi, 'axamɨ'anene meta 'aixɨamɨ'ane meta 'awie ketemɨteyurie Kakaɨyari naime kanita'iwaumɨkɨ."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ECC/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/SNG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ECC/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}