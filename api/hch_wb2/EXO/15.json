{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"EXO","translationId":"hch_wb2","name":"Memeyekɨ","commonName":"Memeyekɨ","title":"Memeyekɨ","order":2,"numberOfChapters":40,"sha256":"7f4f3b9557cd84f07e47c3dd30e54b3e18818f5206c53e306a67f67f12cd2f79","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/hch_wb2/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":15,"content":[{"type":"heading","content":["Muitsexi kemɨtitanɨawaxɨ"]},{"type":"verse","number":1,"content":["Hikɨ Muitsexi meta 'ixaheritsixi xeime kwikari mekaniutakwika Yawé hetsiemieme, mɨpaɨ kananuyɨneni:",{"text":"Yawé nepɨtanɨawa, mariwemekɨ mɨrayu'iwaxɨkɨ","poem":1},{"text":"haramaratsie pɨwareukaxɨri kawayutsixi meta teɨteri memutekai.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yawé pɨnetɨrɨkariya meta pɨnekwikari,","poem":1},{"text":"mɨkɨ pɨnetsiwikweitsitɨwame.","poem":2},{"text":"Mɨkɨ pɨnekakaɨyari, nepinɨawani,","poem":1},{"text":"mɨkɨ nepaapa Kakaɨyarieya pɨhɨkɨ, 'ayumieme 'aixɨa nepaineni hetsiena mieme.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yawé kuya meuyutamiewe kanihɨkɨtɨni,","poem":1},{"text":"Yawé katinitewaka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yawé haramaratsie kaniwareukaxɨrieni,","poem":1},{"text":"Parahuni kaxetatemama meta kuyaximama.","poem":2},{"text":"Te'uximayatamete 'ekipitutari 'aixɨa memɨtekahu paratsiyuta","poem":1},{"text":"mekaniukayunixɨani Haramara Mɨxeta hetsie.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Haramara 'amatiyewatsie mekaniukayunixɨani,","poem":1},{"text":"meukatewatsiepaitɨ tetexi hepaɨ mekaniukayunixɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yawé, 'atɨrɨkariya pepuhekɨataxɨ mariwemekɨ,","poem":1},{"text":"Yawé, memɨtatsi'aye'uniekai pepɨwarutitsanaxɨa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mariwemekɨ pepɨtiuyuri","poem":1},{"text":"pepɨwaruka'unaxɨ 'aneneɨkixiwima,","poem":2},{"text":"waɨkawamekɨ pepuyeha'a,","poem":1},{"text":"xatsi hepaɨ xeikɨa mepɨte'utai.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Xei 'iiyayarikɨ pepɨtiuyuri,","poem":1},{"text":"haa manutayepierekɨ,","poem":2},{"text":"hamewari kayuwatɨ pɨtiu'ui 'ixumeri hepaɨ pɨtiyuxexeiyakai,","poem":1},{"text":"haa pɨkakuyuatɨkatei tetɨata paitɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Taneɨkixiwima mɨpaɨ meputiyuanekai:","poem":1},{"text":"«Hikɨmɨ tepɨwaruweiyani,","poem":2},{"text":"nepɨwaranuku'axe.","poem":1},{"text":"Tinaime tepɨtewarenawairieni wapiini, waɨkawa temɨtehexeyanikɨ.","poem":2},{"text":"Ta'ixipara tepɨwatihapaxɨani","poem":1},{"text":"tamamakɨ tepɨwarekwini».","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Peru 'ekɨ xeimieme pewaruhɨtsieku haramara pɨwareukakwai,","poem":1},{"text":"mepukayunixɨa tepɨa mahete hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yawé, xewitɨ pumawe kakaɨyarixi watsata 'ahepaɨ 'anetɨ.","poem":1},{"text":"Xewitɨ pumawe 'ahepaɨ timariwetɨ meta 'ahepaɨ tipatsietɨ.","poem":2},{"text":"'Ekɨ, mariweme pemɨtiyuriwe,","poem":1},{"text":"'ekɨ yemekɨ pepɨtatsihɨxiyatsitɨa 'atɨrɨkariyakɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kepauka 'ekɨ 'atserie pemutatseraxɨ,","poem":1},{"text":"kwie pɨwareukakwai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Waɨkawamekɨ pewanaki'erietɨ pepɨwaruwitɨxime 'ateɨterima pemɨwarutawikweitsitɨa,","poem":1},{"text":"'atɨrɨkariyakɨ pepɨwaruwitɨxime 'akiekari makupatsie.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Naitsarie kwiepa nuiwarite mepɨtimamani me'enaname,","poem":1},{"text":"kepauka memɨtehetimani piritsiteutsixi mepetinututuixieni.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Erumi kiekatari wa'ukiyarima waɨkawa mepɨtimamani,","poem":1},{"text":"waɨkawa meputiyɨyɨakatɨkani 'itsɨkate Muhawi kiekatari.","poem":2},{"text":"Meta Kanani kiekatari meputiweranaxɨa,","poem":1}]},{"type":"verse","number":16,"content":[{"text":"mɨkɨtsɨ wahetsie pɨtinakeni marika.","poem":2},{"text":"Yawé, kepemɨtitɨrɨkaɨyekɨ,","poem":1},{"text":"mekaniuwawetɨ mepakɨne tetexi wahepaɨ","poem":2},{"text":"kepaukake 'ateɨterima memanuyekɨne,","poem":1},{"text":"teɨteri 'ahetsiemieme pemɨwarutinanai.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"'Ekɨ pepɨwareutawitɨni, pepɨwaka'iteɨta,","poem":1},{"text":"'iya hɨritsie kemɨ'ane 'ahetsɨamɨmieme,","poem":2},{"text":"Yawé, 'ekɨ hakewa pemeyeika,","poem":1},{"text":"hakewa 'ekɨ, Yawé, 'atuki pemeyutawewiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Yawé katini'aitakamɨkɨ yuheyeme, tukarikɨ.","poem":1}]},{"type":"heading","content":["Miriyami kwikarieya"]},{"type":"verse","number":19,"content":["Kepauka Parahuni kawayutsiximama meta kaxetamama teɨteri me'utetɨ haramaratsie memanukɨnekekai, Yawé yakatiniuyurieni haa waheima muyeurienikɨ. 'Ixaheritsixi mekayu'iyaritɨatɨ mepanukɨ kwie wakimetsie."]},{"type":"verse","number":20,"content":["Merikɨtsɨ Miriyami Kakaɨyari niukameya, 'Aruni taruya, kaitsawiwame kaniuti'ɨni, hipatɨta 'ukari mekaniweiyakaitɨni yukaitsakɨ mete'ukayuitɨwatɨ meta mete'ukaye'atɨ."]},{"type":"verse","number":21,"content":["Miriyami mɨpaɨ katiniukwikakaitɨni:",{"text":"Yawé xekenenɨawani, mɨkɨ mariwemekɨ mɨrayu'iwaxɨkɨ,","poem":1},{"text":"kawayutsixi wahetsie memutei","poem":2},{"text":"meta kawayutsixi haramaratsie pɨwareukaxɨri.","poem":1}]},{"type":"heading","content":["Haa matsiwi Maraha meta Herimi"]},{"type":"verse","number":22,"content":["Merikɨtsɨ Muitsexi kaniwaruta'aitɨani 'ixaheritsixi Haramara Mɨxeta hetsie memayekɨnekɨ meta makumawetsie memɨtayunekɨ Tsuhuxi kwieyaritsie. 'Ixaheritsixi mana mekaniuhukaitɨni haika tukari makumawetsie haa mekataxeiyawawetɨ."]},{"type":"verse","number":23,"content":["Hikɨ mekaniuta'axɨani Maraha mɨrakutewatsie, mana mɨpaɨ katinakutewakaitɨni mana haa hatsiwitɨ muxuawekaikɨ, mana mepɨkatenewiekairi meheuharikutɨ."]},{"type":"verse","number":24,"content":["Merikɨte mɨkɨ mekaniutiniukixietɨkɨne Muitsexi hepaɨtsita, mɨpaɨ mete'iku'iwawiyatɨ: «¿Ketita tetetihareni?»"]},{"type":"verse","number":25,"content":["Muitsexi Yawé kaniutawawirieni, mɨkɨ pixeitsitɨa kɨye yatewime, mɨkɨ Muitsexi hapa kaneikahɨani, yapauka haa 'aixɨa ha'anetɨ kanayani. Mana Yawé kaniwaruta'inɨata, kaniwarupitɨani 'inɨari niukiyari kememɨtekahuni."]},{"type":"verse","number":26,"content":["Mɨpaɨ katiniwarutahɨawe: «Netsɨ Yawé xekakaɨyari nekanihɨkɨtɨni. Xɨka neniuki xe'enietɨ yaxetekahuni heitseriemekɨ, xɨka 'inɨari niukiyaritsie yaxetekahuni kemɨreuyewetse meta ne'aitsikatsie, ne hatsuaku kwiniya nepɨkahanɨ'ani xehetsie, 'ekipitutsie kenemɨtiuyuri. Netsɨ Yawé nekanihɨkɨtɨni, hatsuaku kwiniya xehetsie pɨkatinake»."]},{"type":"verse","number":27,"content":["'Arikeke 'ixaheritsixi mekaneta'axɨani, 'Erimi mɨrakutewatsie, hakewa tamamata heimana huta haixayari mexuawekai meta haika tewiyari heimana tamamata takɨ mati'u, mana mekaniyuhayewa, haa mayema 'aurie."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}