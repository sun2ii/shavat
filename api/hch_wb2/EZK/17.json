{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"EZK","translationId":"hch_wb2","name":"'Etsekieri","commonName":"'Etsekieri","title":"'Etsekieri","order":26,"numberOfChapters":48,"sha256":"61219584d89753a04d6c0908e0bfab2026597cc2812fb9a8d7712f463e318a20","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/hch_wb2/EZK/48.json","totalNumberOfVerses":1272},"chapter":{"number":17,"content":[{"type":"heading","content":["Kaxie nanari meta kwixɨ"]},{"type":"verse","number":1,"content":["Yawé yuniukitsie mɨpaɨ kanetiniutaxatɨani:"]},{"type":"verse","number":2,"content":["«Tewi pemunu'aya: 'Ikɨ niuki keniwarutaxatɨa 'ixaheritsixi teɨteriyari, keniwarutaxatɨa 'ikɨ 'ɨxatsi niukiyari."]},{"type":"verse","number":3,"content":["Mɨpaɨ ketiniwaraye'eritɨa kename ne Yawé nehaine:",{"text":"»Riwanu kaninuani Kwixɨ 'anetɨ,","poem":1},{"text":"'a'anateyeyeutɨ, waɨkawa heuhuxatɨ, witsiheu'anetɨ.","poem":2},{"text":"Kariuxa yekɨrita kaniuyeyerɨni,","poem":1}]},{"type":"verse","number":4,"content":[{"text":"kanekatutseni yɨrariyari 'amutewitsie.","poem":2},{"text":"Xeime kwieyaritsie kaneitɨni tetuayamete wahetsɨa,","poem":1},{"text":"kiekari mɨratuiyatsie kanikayeni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hikɨ mɨkɨ kwieyaritsie 'imɨari kaniyetɨkɨ,","poem":1},{"text":"kanika'eni kwie 'aixɨa mɨraku'anetsie.","poem":2},{"text":"Kanika'eni hapuri kɨyeyari kemɨrayu'etsa,","poem":1},{"text":"waɨkawa haa 'uhanekaku 'aurie.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Imɨari kaniutineni,","poem":1},{"text":"kaxie nanari 'apatɨ kanayani, yakɨ hawetɨ,","poem":2},{"text":"kwixɨ hetsie paitɨ kaneuti'ani mamateya,","poem":1},{"text":"yunanakɨ waɨkawa katiniukawiya.","poem":2},{"text":"Mɨpaɨ katinayani kaxie nanari,","poem":1},{"text":"waɨkawa yɨratɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Peru xewitɨ 'apuyeikakaita kwixɨ 'anetɨ,","poem":1},{"text":"'a'anateyeyeutɨ, waɨkawa heuhuxatɨ.","poem":2},{"text":"Tawarita kaxie yunanarikɨ katiniukawiya,","poem":1},{"text":"manapaita xawari kaniukanetɨani,","poem":2},{"text":"haa waɨkawa mɨharekakɨ","poem":1},{"text":"kemɨkatiharekai.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mana puka'etsiekai kwie 'aixɨa mɨ'anetsie","poem":1},{"text":"waɨkawa haa 'uhanekaku 'auriena,","poem":2},{"text":"mɨyɨranikɨ meta 'ikwaxi muxuawitɨakakɨ,","poem":1},{"text":"kaxie nanari witsi'anetɨ mayanikɨ.","poem":2}]},{"type":"verse","number":9,"content":["»Mɨpaɨ ketiniwaraye'eritɨa: Yawé mɨpaɨ kanaineni:",{"text":"»Mɨkɨ kaxie pɨkakaxuawere.","poem":1},{"text":"Kwixɨ nanarimakame pahuna.","poem":2},{"text":"'Ikwaxi pɨka'inɨni,","poem":1},{"text":"kaxie nanayari pɨtayɨnare.","poem":2},{"text":"Huu, yɨrariyari pɨtiwani.","poem":1},{"text":"Pɨkaheuyeweka mamá tɨrɨkaɨyetɨ meta teɨteri meyumɨiretɨ","poem":2},{"lineBreak":true},{"text":"memehunakɨ naime.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tsepa xaɨtsie mukayerie pɨkatawere.","poem":1},{"text":"'Eka tau manatineika mayeneika","poem":2},{"lineBreak":true},{"text":"pitawatsiɨxa xɨka 'i'axe.","poem":2},{"text":"Yurikɨ kanitawamɨkɨ","poem":1},{"text":"hakewa mekayerie».","poem":2}]},{"type":"verse","number":11,"content":["Yawé yuniukitsie mɨpaɨ kanetiniutaxatɨani:"]},{"type":"verse","number":12,"content":["«Keniwaruta'iwawiya 'ikɨ teɨteri memɨ'iyaritsetse'i kehepaɨtɨtɨ 'ikɨ naitɨ manuyɨne. Mɨpaɨ ketiniwaraye'eritɨa, ti'aitame Wawiruniya kiekame Kerutsareme punua, yukwieyaritsiepai Kura kwieyaritsie ti'aitame pehanie meta 'iparewiwamete."]},{"type":"verse","number":13,"content":["Hikɨ xeime panayexei memanuyetei waniwe, waɨriyarika wapitɨatɨ yapɨtiwarutahɨawixɨ tɨratutsie yamemɨtekakɨnekɨ meyuhɨritɨatɨ. Ti'aitame mɨpaɨ katiniwarewitɨni memanuyetei yukwieyaritsie paitɨ."]},{"type":"verse","number":14,"content":["Mɨya pɨwaruyuri waɨkawa Kura kwieyaritsie kiekatari mekatɨrɨkaɨyeme mɨwarayeitɨanikɨ. Mɨpaɨ pɨtiwarutahɨawixɨ mariweme memɨka'ayuyeitɨwanikɨ, waɨriyarika pɨwapitɨakai memeye'atɨanikɨ tɨratu."]},{"type":"verse","number":15,"content":["Hikɨ mɨkɨ ti'aitame Wawiruniya kiekame 'aye'unietɨ patɨa, pɨwarenɨ'a texaxatamete 'Ekipitutsie memiparewienikɨ, kawayutsixi wahekɨ meta kuyaxi yuwaɨkawamekɨ. ¿Kemɨ'ane mɨyamɨtiuyuri tiyuta'una 'aku? ¿Tiyɨwe tɨratu kahaye'atɨame mutawikweni?"]},{"type":"verse","number":16,"content":["Hawaikɨtsitɨ, matsi kanimieriemɨkɨ Wawiruniya, ti'aitame kemɨ'ane mitahɨawixɨ kwieyatsie, kemɨ'ane tɨratu hamatɨa muwewi hetsɨa, tɨratu miwewitsitɨa mɨkaheye'atɨiri hetsɨa. Ne Yawé naimekɨmɨyɨwe mɨpaɨ nekanaineni."]},{"type":"verse","number":17,"content":["Parahuni yukuyaxima yunaime wahamatɨa memiparewieni pɨkayɨwe, tsepa tetsariya 'imɨmɨiyari memutawewi meta tsepa tuxiyu memutiwewi waɨkawa teɨteri memɨwakwinikɨ."]},{"type":"verse","number":18,"content":["Kura kwieyaritsie ti'aitame nu'aya, tɨratu pɨkahaye'atɨa. Hikɨ mɨyamɨtiuyurikɨ naime yɨhɨritɨaka pɨkayuta'una."]},{"type":"verse","number":19,"content":["»'Ayumieme, Yawé naimekɨmɨyɨwe mɨpaɨ kanaineni: “Yurikɨ mɨpaɨ nekanaineni nekɨmana nepi'uximatɨani kemɨtiyɨhɨritɨakai netɨratutsie yamɨkatiuyurikɨ."]},{"type":"verse","number":20,"content":["Newiniyari hɨxiena nepuwɨtɨani, mana kaniwierimɨkɨ. Wawiruniya nekanenuhanimɨkɨ, mana kanitaxanetsiemɨkɨ yamɨkatikatɨakɨ."]},{"type":"verse","number":21,"content":["Kuyaximama 'aixɨa memɨ'anene mepɨkwi'iwa 'ixiparakɨ, kemɨ'aneta memuyuhayewa naitsarie nuiwaritetsie nepɨwataxɨriexɨani. 'Ana mɨpaɨ mepɨtehetimani kename ne, Yawé mɨpaɨ nehaine."]},{"type":"verse","number":22,"content":["»”Yawé naimekɨmɨyɨwe mɨpaɨ kanaineni:",{"text":"»”Kariuxa kɨtsita yɨrariyari ne nekaniwatimuramɨkɨ,","poem":1},{"text":"kemɨ'ane 'amutewinitsie nekanewatimuramɨkɨ,","poem":2},{"lineBreak":true},{"text":"nekanikayemɨkɨ xeime hɨri 'a'utewimetsie.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"'Ixaheri hɨriyaritsie nekanika'iteɨtamɨkɨ,","poem":1},{"text":"'amanutitewatsie,","poem":2},{"text":"mana mɨtayɨrakɨ meta 'ikwaxi mɨkaxuawitɨanikɨ,","poem":1},{"text":"kariuxa witsi'anetɨ mayanikɨ.","poem":2},{"text":"Yunaitɨ wikixi hetsiena mekaniyuti'ituatɨakuni,","poem":1},{"text":"'etɨriyayatɨa xeikɨa mekaniu'uwakuni.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yunaitɨ kɨyexi yeuta mieme","poem":1},{"text":"mɨpaɨ mepɨtehetimani kename ne Yawé nehɨkɨ.","poem":2},{"text":"Kemɨ'ane kɨye mɨmariweni nepewiteke,","poem":1},{"text":"kemɨ'ane 'etsimutewini nepitaweriya,","poem":2},{"text":"Kemɨ'ane kɨye mɨyɨra nepitawatsiɨxa,","poem":1},{"text":"kemɨ'aneta mɨwaki, mɨtaxutunikɨ yanepɨtiyurie.","poem":2},{"text":"Ne, Yawé, mɨpaɨ neputayɨ,","poem":1},{"text":"nepeye'atɨani”».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/EZK/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/EZK/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/EZK/16.json","previousChapterAudioLinks":{},"numberOfVerses":24}