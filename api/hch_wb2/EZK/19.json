{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"EZK","translationId":"hch_wb2","name":"'Etsekieri","commonName":"'Etsekieri","title":"'Etsekieri","order":26,"numberOfChapters":48,"sha256":"61219584d89753a04d6c0908e0bfab2026597cc2812fb9a8d7712f463e318a20","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/hch_wb2/EZK/48.json","totalNumberOfVerses":1272},"chapter":{"number":19,"content":[{"type":"heading","content":["Hiwerika 'Ixaheri kwieyaritsie memanuyetei wahetsiemieme"]},{"type":"verse","number":1,"content":["»'Ikɨ hiwerika 'Ixaheri kwieyaritsie memanuyetei keniwarutaxatɨa:"]},{"type":"verse","number":2,"content":[{"text":"»“Mayetsi wahixɨapa,","poem":1},{"text":"'amaama maye 'ukaratsi pɨhɨkɨtɨkai.","poem":2},{"text":"Mayetsi 'etsi mepepeme watsata pukatei,","poem":1},{"text":"yuniwema pɨwatsitsitɨakai.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mɨkɨ xeime putaweriyaxɨ,","poem":1},{"text":"mɨkɨ maye mayu'eriya patɨa","poem":2},{"text":"pɨretima kemɨtiuhupa mɨtiwiyakɨ tita mɨtitakwani","poem":1},{"text":"meta teɨteri wakwaiwetɨ patɨa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nuiwarite mepitamari,","poem":1},{"text":"mepiwiniyaxɨ putsuta 'uyewakikaku,","poem":2},{"lineBreak":true},{"text":"mepeiha 'Ekipitu me'iwiwitɨatɨ tepɨakɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kepauka maamaya maye 'ukaratsi,","poem":1},{"text":"yuniwe takwewietɨ muyutatexi,","poem":2},{"text":"xeimeta kananayexeiya,","poem":1},{"text":"kwinie rayu'eriyame matsi kanayeitɨani.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kepauka 'ikɨ maye mutatɨrɨkaxɨa,","poem":1},{"text":"mayetsi wahamatɨa kaniuyeikakaitɨni 'uyuta'ɨretɨ.","poem":2},{"text":"Pɨretima kemɨtiuhupa mɨtiwiyakɨ tita mɨtitakwani,","poem":1},{"text":"meta teɨteri wakwa'atɨ kanayani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Paratsiyute puka'unaxɨa,","poem":1},{"text":"kiekarite kiɨripa payeitɨwakai,","poem":2},{"text":"pɨwamariutakai yutsuarikɨ","poem":1},{"text":"yunaime kwiepa kiekatari.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hipatɨ nuiwarite 'auriena kiekatari","poem":1},{"text":"mekaniyuti'uitɨani me'imienike.","poem":2},{"text":"Mekaniwiniya,","poem":1},{"text":"putsuta kaneukaweni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tepɨakɨ hɨatɨ meta tepɨa kiiyarita 'ayewetɨ,","poem":1},{"text":"kanehanieni ti'aitame Wawiruniya kiekame hetsɨa.","poem":2},{"text":"Tepɨata 'ayewetɨ kanehanieni,","poem":1},{"text":"tsuarieya mɨkahayu'eniɨriɨkɨnikɨ","poem":2},{"lineBreak":true},{"text":"'Ixaheri hɨriyaritsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"»”Kaxie haraweriyari mayema wahixɨapa,","poem":1},{"text":"kaxie nanari 'amaama pɨhɨkɨtɨkai","poem":2},{"lineBreak":true},{"text":"haa manuyehane 'aurie 'etsietɨ:","poem":2},{"text":"waɨkawa 'ukaxuxuaweretɨ meta waɨkawa yɨratɨ,","poem":1},{"text":"haa waɨkawa muxuawekaikɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mamateya waɨkawa putiwawerixɨ,","poem":1},{"text":"pɨyɨwekai te'aitamete wa'itsɨ mayanikɨ.","poem":2},{"text":"Waɨkawa putawerixɨ hipame pɨwara'iwakai","poem":1},{"text":"yukɨtsimeyarikɨ.","poem":2},{"text":"'Ateewa paitɨ puyuxeiyanɨakai 'amutewikaikɨ","poem":1},{"text":"meta waɨkawa mɨyɨrakaikɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Peru kanahunarieni haxɨakɨ,","poem":1},{"text":"kwiepa kanatihɨiyani.","poem":2},{"text":"'Eka tau manatineika mieme pitiwatsiɨxaxɨ,","poem":1},{"text":"teɨteri 'ikwaxi meukatekai mepukamuraxɨ.","poem":2},{"text":"Putiwa mamateya 'amɨpapa,","poem":1},{"text":"meta taikɨ putixɨtsitɨarie.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hikɨri makumawetsie puyuhayewaxɨ,","poem":1},{"text":"kwie mɨwakitsie 'etsietɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Xeime mamayatsie tai kananeni,","poem":1},{"text":"mɨkɨ tai 'ikwaxiyari kaniutixɨtsitɨani.","poem":2},{"text":"Nitixaɨtɨ pɨkatiyuhayewaxɨ mamateya 'amɨpapa,","poem":1},{"text":"'aixɨa mɨ'anenekai te'aitamete wa'itsɨ mɨtiwewierekekai”.","poem":2},"'Ikɨ hiwerika kwikariyari kanihɨkɨtɨni, kehepaɨ manuyɨne mɨpaɨ xeikɨa ketinɨawarieka»."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}