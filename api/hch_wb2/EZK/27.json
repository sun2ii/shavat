{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"EZK","translationId":"hch_wb2","name":"'Etsekieri","commonName":"'Etsekieri","title":"'Etsekieri","order":26,"numberOfChapters":48,"sha256":"61219584d89753a04d6c0908e0bfab2026597cc2812fb9a8d7712f463e318a20","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/hch_wb2/EZK/48.json","totalNumberOfVerses":1272},"chapter":{"number":27,"content":[{"type":"heading","content":["Hiwerika Tiru matihɨiyakɨ"]},{"type":"verse","number":1,"content":["Yawé mɨpaɨ kanetiniutahɨawe:"]},{"type":"verse","number":2,"content":["«Tewi pemunu'aya, 'ikɨ hiwerika kwikariyari Tiru hetsiemieme keneutakwika,"]},{"type":"verse","number":3,"content":["kiekari haramara tetsita memukuma mɨti'uximaya yumɨireme kiekarite wahamatɨa meta tewanarixi haramara tetsita mukumane. »Yawé naimekɨmɨyɨwe mɨpaɨ kanaineni:",{"text":"»“'Ekɨ, Tiru kiekariyari,","poem":1},{"text":"witsipeti'axexeiyame pepɨ'a'erie meta 'aixɨa pe'anekame.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Haramaratsie mariwemekɨ pepɨti'aita,","poem":1},{"text":"tewewiwamete 'aixɨa ti'anenekame mepɨte'utiwewi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Huku mexayari Tsenixi hɨriyaritsie miemekɨ","poem":1},{"text":"mepɨte'utiwewi.","poem":2},{"text":"Meta kariuxa Riwanu miemekɨ","poem":1},{"text":"kɨye 'apame hixɨapa nawiya heima mieme meputawewi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xiu Watsani miemekɨ","poem":1},{"text":"tiwekemete meputiwewi,","poem":2},{"text":"meta tsipɨrexi kɨyeyarikɨ Tsipɨre miemekɨ","poem":1},{"text":"'aheima muyema meputawewi,","poem":2},{"text":"meta witsipuka'itɨarie","poem":1},{"text":"witsimɨrekemakakɨ 'eripanite 'awateyakɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Rinu 'ixurikiyari 'Ekipitu mieme mɨtixutɨkakɨ","poem":1},{"text":"'eka kwekwewiwame meputiwewi,","poem":2},{"lineBreak":true},{"text":"mɨkɨkɨ 'apatera pepayeitɨa.","poem":2},{"text":"Haramara tetsita 'Eritsaha kwieyaritsie mieme,","poem":1},{"text":"'ixuriki mɨyɨtsikimaɨye meta mɨxeta pɨ'atɨarie 'akiitsie meuwɨre.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tiru 'aku, tewekemete Tsiruni mepanexɨa meta 'Axiwari.","poem":1},{"text":"Wapaitɨ mepatitekai yemekɨ memɨmatsi'unɨ'axime,","poem":2},{"lineBreak":true},{"text":"teɨteri memɨte'akumate haramaratsie timiemekɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kɨyekɨ 'aixɨa memɨteheutawewiwawe Kewari kiekatari","poem":1},{"text":"'aixɨa mepiyuri hakewa meumurikai kanuwa 'amɨpa.","poem":2},{"text":"Haramaratsie kanuwa 'amɨpapatsie hauwemete yumɨiretɨ","poem":1},{"text":"tita pemɨtituakai mepɨtetuakai.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Teɨteri Peritsiya kiekatari, Ririyatari meta Puti kiekatari","poem":1},{"text":"'akuyaxi wahamatɨa mepaye'ukai.","poem":2},{"text":"'Aixɨa mepɨmatsi'ukuyuri yuhetsie nunuwamekɨ meta kuya xupureruyakɨ,","poem":1},{"text":"mɨkɨ mepihekɨatakai kepemɨtimariwekai.","poem":2}]},{"type":"verse","number":11,"content":["»”'Axiwari kiekatari, meta 'akuyaxima wahamatɨa, mepi'ɨwiyakai 'akuraru 'awarita maka, meta Kamari kiekatari 'atuxiyute mepɨtahɨkai. 'Akuraru 'utɨma yuhetsie nunuwame mepukuwɨwɨtɨwakai, witsi'anekame mematsihayeitɨatɨ."]},{"type":"verse","number":12,"content":["Pɨtimɨirekai kepemɨrexeiyakai Taritsi 'ahamatɨa ti'uximayakaku. Pemɨtituiriekaikɨ mɨkɨ pɨmatsixatɨakai pɨrata, tepɨa, 'etsitaniyu meta tepɨa mahete."]},{"type":"verse","number":13,"content":["Metatsiere Kɨretsiya, Tuwari meta Metseki 'ahamatɨa mepɨte'uximayakai, pemɨtiwatuiriekaikɨ mepɨmatsixatɨakai te'uximayatamete meta purunitsekɨ mɨtiwewiyatɨka."]},{"type":"verse","number":14,"content":["Teɨteri Weti-Tukaxima mepɨmatepitɨakai kawayutsixi te'uximayatametekɨ, kawayutsixi yeixamete meta muratsixi."]},{"type":"verse","number":15,"content":["Xuraxi",{"noteId":0},"kiekatarita yaxeikɨa 'ahamatɨa mepɨte'uximayakai. Yuwaɨkawa pepɨtiwatuiriekai kwie haramaratsie mɨyemane wahamatɨa, mɨkɨ mepɨmetepitɨakai kɨye mayeyɨyɨwikɨ meta 'eripanite tameteyakɨ."]},{"type":"verse","number":16,"content":["Waɨkawa piinite pemɨrexeiyakaikɨ, Tsiriya pɨmatinanairiekaita, pɨmatipatsiriekai tupatsiyukɨ, 'ixurikite muyuyuawikɨ, 'ixurikite tixutɨkaimekɨ rinu 'aixɨa mɨ'ane meta tetexi witsimɨ'anenekɨ."]},{"type":"verse","number":17,"content":["Kura meta 'Ixaheri mepɨmatetuiriekai tɨriku Miniti miemekɨ, paa witsimɨ'anene, hatseiti meta waritsamu."]},{"type":"verse","number":18,"content":["Waɨkawa piinitɨarika pemɨrexeiyakai, waɨkawa pemɨxikutɨkai, Ramatsiku tsiere pɨmatinanairiekai. Winu Keriwuni mieme meta Tsakaxi mieme muxa huxarieyakɨ mepɨmatekupitɨwakai."]},{"type":"verse","number":19,"content":["Mematepatsirietɨ 'apiinitekɨ Rani nuiwarimama meta kɨriyekutsixi mepɨte'atɨwakai, 'Utsari mieme tepɨa 'aixɨa mɨ'ane, kanera meta 'uwá witsimu'ɨatɨka."]},{"type":"verse","number":20,"content":["Rerani kiekatari mepɨmatsituiriekai xira yeixame."]},{"type":"verse","number":21,"content":["'Ahetsɨa memɨtenanetɨwe mepɨhɨkɨtɨkai 'Arawiya meta yunaitɨ te'aitamete Tseraxi miemete, mɨkɨ mepɨmatepitɨakai muxatsi yakɨ memɨpapakɨ, muxatsi 'ukitsikɨ meta tsipuri wahekɨ."]},{"type":"verse","number":22,"content":["Meta 'ahetsɨa mepɨtenanetɨwekai yunaitɨ tetuayamete, Tsawa miemete meta Xakama. Mɨkɨ mepɨmatepitɨakai hurukɨ, tetexi witsimɨ'anenekɨ meta witsimu'ɨatɨka 'aixɨa mɨ'anenekɨ."]},{"type":"verse","number":23,"content":["Meta Karani, Kane, Hereni meta tetuayamete Tsawa kiekatari, 'Atsiriya meta Kirimari 'ahetsɨa mepɨtenanetɨwekai."]},{"type":"verse","number":24,"content":["Waɨkawa pemɨrexeiyanikɨ mepɨmatsituiriekai 'ixuriki witsi'anenekame, matate mɨyɨtsikimawi, tixuiyatɨkaime, tiwiparietɨkaime yɨkɨ'anenemekɨ meta kaunarite 'aixɨa reukukakaunime."]},{"type":"verse","number":25,"content":["Kanuwate 'amɨpapa Taritsi miemete 'apiinite mepɨte'anutuayakai.",{"text":"»”Piinitɨarika mɨraye'atɨka tihɨpɨneme peratɨtɨ,","poem":1},{"text":"haramara 'amatiyewatsie pepɨyanekai.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"'Awekemete haramara 'ameutatewatsie mepɨmatsihetɨ,","poem":1},{"text":"haramara 'amatiyewatsie 'eka tau manatineika mieme pɨmatsi'utamuraxɨ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kepauka pemɨkayune","poem":1},{"text":"pɨtikayunixɨani haramara 'ameukatewatsie,","poem":2},{"text":"mɨmatixikutɨriyakai pemɨtituakai meta pemɨtiwewiekai,","poem":1},{"text":"'ahetsie mematitei meta memɨmatsi'unɨ'axime,","poem":2},{"text":"kemɨ'ane 'akanuwa 'amɨpa 'aixɨa memɨtiyuruwa meta kemɨ'ane memɨmatetuiriekai,","poem":1},{"text":"'akuyaxima metatsiere yunaitɨ matsiparewiwamete.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Memɨmatsi'unɨ'axime me'utihiwakaku","poem":1},{"text":"haramara tetsita memɨtama mepɨtimamani.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Yunaitɨ kanuwa 'amɨpapa wekemete mepɨwaku'eirieni,","poem":1},{"text":"haramaratsie kɨkamete meta tenɨ'awamete kwiepa mepɨ'axɨani.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"'Ahetsiemieme mepɨtihiwa","poem":1},{"text":"mepɨtitsuani yemekɨ meyuhiwerietɨ,","poem":2},{"text":"naxi yumu'utsie mepeuyutiwiwiriexɨani,","poem":1},{"text":"meta hetsiena mepɨtikurupe.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"'Ekɨ ya'ane pewiwiekaku yumu'utsie mepuyukaxini,","poem":1},{"text":"hiwerika kamixayari mepanakatɨxɨani.","poem":2},{"text":"'Ahetsiemieme mepɨtitsuani meyuhiwerietɨ,","poem":1},{"text":"'aixɨa 'iyari meka'u'uwatɨ.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Hiwerika kwikariyari mepitikwika,","poem":1},{"text":"yemekɨ kwinimieme mɨtinutuixiwetsie mɨpaɨ mepɨtiyuani:","poem":2},{"text":"‘Nixewitɨ haramara hixɨapa pumawekai","poem":1},{"text":"Tiru hepaɨ 'anetɨ’.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Kepauka mɨti'atɨariwakai 'apiinite","poem":1},{"text":"nuiwarite yumɨiretɨ mepɨtekunanakekai.","poem":2},{"text":"Waɨkawa pemɨrexeiyakaikɨ meta piinitɨarikakɨ,","poem":1},{"text":"pepɨwaxikutɨriyakai te'aitamete kwiepa memɨtama.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Peru hikɨ haramara pɨmatsi'utamuraxɨ,","poem":1},{"text":"haramara 'ameukatewatsie pepɨyeka.","poem":2},{"text":"'Apiinite meta kemɨ'ane pemɨtiwa'aitɨakai","poem":1},{"text":"'ahamatɨa mepukayunixɨa.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"'Ahetsiemieme mepɨmama","poem":1},{"text":"yunaitɨ haramara tetsita kiekatari,","poem":2},{"text":"te'aitamete marikakɨ mepuyɨyɨakatɨka,","poem":1},{"text":"wahɨxie pɨmatsiɨkɨ kememɨtemama.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Waɨkawa mekanimamaka","poem":1},{"text":"hipatɨ kwieyaritsie tenawemete,","poem":2},{"text":"'a'imatɨrieka tukari kanaye'ani,","poem":1},{"text":"tawariri pepɨkanuani”».","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Hepɨrayukɨ paine Rerani.","reference":{"chapter":27,"verse":15}}]},"thisChapterLink":"/api/hch_wb2/EZK/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/EZK/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/EZK/26.json","previousChapterAudioLinks":{},"numberOfVerses":36}