{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"EZK","translationId":"hch_wb2","name":"'Etsekieri","commonName":"'Etsekieri","title":"'Etsekieri","order":26,"numberOfChapters":48,"sha256":"61219584d89753a04d6c0908e0bfab2026597cc2812fb9a8d7712f463e318a20","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/hch_wb2/EZK/48.json","totalNumberOfVerses":1272},"chapter":{"number":28,"content":[{"type":"heading","content":["Niuki Tirutsie ti'aitame hetsiemieme"]},{"type":"verse","number":1,"content":["Yawé mɨpaɨ kanetiniutahɨawe:"]},{"type":"verse","number":2,"content":["«Tewi pemunu'aya, mɨpaɨ ketinayehɨtɨa ti'aitame Tiru kiekame, Yawé naimekɨmɨyɨwe mɨpaɨ kanaineni:",{"text":"»“'Ataɨta pe'uyuta'ɨreka mɨpaɨ peputayɨ:","poem":1},{"text":"‘Ne kakaɨyari nepɨhɨkɨ.","poem":2},{"text":"Haramara 'amatiyewatsie nepɨyeyeika,","poem":1},{"text":"kakaɨyarixi wa'uwenitsie ne'akaitɨ’.","poem":2},{"text":"Peru neuxei 'ekɨ pepɨkakakaɨyari,","poem":1},{"text":"tsepa mɨpaɨ pemɨti'amate.","poem":2},{"lineBreak":true},{"text":"'Ekɨ tewi pemɨmɨwe xeikɨa pekanihɨkɨtɨni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"¿Kamɨtsɨ Tanieri reuyeta petimaiwe?","poem":1},{"text":"¿Kamɨtsɨ naime tita mɨti'awie petimate?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Ekɨ kepemɨtimaiwekɨ meta kepemɨtimatekɨ","poem":1},{"text":"'axikutɨriya pepɨtiukuxeɨri,","poem":2},{"text":"'akakuni pemexeiyatsie pepeikayatsaxɨ","poem":1},{"text":"waɨkawa huru meta pɨrata.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwinimieme pemɨreyutaharerutawekɨ,","poem":1},{"text":"'ayumieme waɨkawa xiku pepa'ayeitɨa.","poem":2},{"text":"Waɨkawa pemɨrexeiyakɨ","poem":1},{"text":"kwinimieme petiuyu'ɨretɨ pepatɨa.","poem":2}]},{"type":"verse","number":6,"content":["'Ayumieme, Yawé naimekɨmɨyɨwe mɨpaɨ kanaineni:",{"text":"»”Metsɨ xeniu kakaɨyari","poem":1},{"text":"hepaɨ petimaiwetɨ pekanayuyeitɨwani,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"yanepɨtiyurieni memɨ'axɨanikɨ 'ateewa kiekatari 'ahetsɨa,","poem":1},{"text":"kwinimieme memɨtehayu'eririya:","poem":2},{"text":"'ixiparate mekaniwatihapakuni","poem":1},{"text":"'aixɨa ti'aneme witsikepemɨrexeiya meta kepemɨtimaiwe hepaɨtsita mieme,","poem":2},{"lineBreak":true},{"text":"mɨkɨ kepemɨtimariwe 'axamekaniyurikuni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Putsuta mekamenikayunitɨakuni,","poem":1},{"text":"haramara 'amatiyewatsie petikwinetɨ pekanimɨmɨkɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hikɨ, metsimemiwamete wahɨxie,","poem":1},{"text":"¿petiyɨwe mɨpaɨ pemɨtayɨni: Ne nepɨkakaɨyari?","poem":2},{"text":"Matsi metsimemiwamete wahɨxie,","poem":1},{"text":"kakaɨyari pepɨkahɨkɨtɨni matsi tewi mɨmɨwe pekanihɨkɨtɨkamɨkɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Teewatari mekametenikwinitɨakuni,","poem":1},{"text":"mekamenimiekuni xitekiya 'inɨariyari memɨkahexeiya,","poem":2},{"lineBreak":true},{"text":"ne mɨpaɨ nemainekɨ.","poem":2},"Yawé naimekɨmɨyɨwe mɨpaɨ kanaineni”»."]},{"type":"line_break"},{"type":"verse","number":11,"content":["Yawé mɨpaɨ kanetiniutahɨawe:"]},{"type":"verse","number":12,"content":["«Tewi pemunu'aya, Tiru kiekariyaritsie ti'aitame hetsiemieme hiwerika kwikariyari keneutakwika, meta mɨpaɨ ketinayehɨtɨa, Yawé naimekɨmɨyɨwe mɨpaɨ kanaineni:",{"text":"»“Witsipepɨtiyuxexeiyakai,","poem":1},{"text":"waɨkawa petimaiwetɨ meta 'aixɨa petiyuxexeiyatɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Ereni pepuyeikakai, Kakaɨyari harawerita,","poem":1},{"text":"witsiperekuniɨtɨ tetexi witsimɨ'anenekɨ:","poem":2},{"text":"Xuwi, kɨritsuritu, kare,","poem":1},{"text":"tupatsiyu, kuxinarina, katsipe,","poem":2},{"lineBreak":true},{"text":"tsapiru, kɨranate meta 'etsimerarita.","poem":2},{"text":"'Akuka meta 'akamixatetsie mɨranukuhe huru pɨwiriyarietɨkatei,","poem":1},{"text":"wewiyatɨkaitɨ 'ahetsiemieme","poem":2},{"lineBreak":true},{"text":"kepauka paitɨ pemutawewiyatsie.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Pepanayexeiyarie, Kakaɨyari teɨtameya ti'ɨwiyamekɨ,","poem":1},{"text":"ne mɨpaɨ nemainekaikɨ.","poem":2},{"text":"Kakaɨyari hɨrieya mɨpatsietsie pepukatei,","poem":1},{"text":"tetexi tatɨkaimetsie pepuyeyeikakai.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kepauka pemutawewiya","poem":1},{"text":"'aixɨa pepɨtiuyeikakai,","poem":2},{"lineBreak":true},{"text":"'atsita 'axamɨti'ane 'ahetsie mɨtiutixuawerixɨtsieke.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Waɨkawa perexeiyatɨ pematɨakɨ,","poem":1},{"text":"'axapetiuka'iyaritɨ pepatɨa, 'ana 'axapepɨtiuyuri.","poem":2},{"text":"'Ayumieme nepɨmatsihayewei Kakaɨyari hɨrieyatsie,","poem":1},{"text":"tixaɨtɨ mɨkatipatsie hepaɨ.","poem":2},{"text":"'Ekɨ, Kakaɨyari 'ɨwiyame tihɨweme,","poem":1},{"text":"tetexi mɨtatɨkatsie nekamenakumaweriyamɨkɨ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Witsipemɨtitemaikɨkaikɨ","poem":1},{"text":"pepu'ata'ɨrixɨ.","poem":2},{"text":"Pemɨxawatɨriyatɨkaikɨ","poem":1},{"text":"petimaiwetɨ pepɨkahatɨa.","poem":2},{"text":"'Ayumieme kwiepa nepɨmatsiheukahɨa,","poem":1},{"text":"meta te'aitamete wahɨxie","poem":2},{"lineBreak":true},{"text":"tewiyarika nepɨmatsihayeitɨa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"'Atukite mɨpatsietɨkatei kapatsietɨkaime pepayeitɨa,","poem":1},{"text":"'axamɨti'ane waɨkawa pemexeiyakɨ,","poem":2},{"lineBreak":true},{"text":"'axa'anemekɨ pemɨtituakaikɨ.","poem":2},{"text":"'Ayumieme 'ahetsie nepenayetua tai","poem":1},{"text":"mɨmatsitaxɨtsitɨanikɨ.","poem":2},{"text":"Yunaitɨ memɨmatsixeiya wahɨxie,","poem":1},{"text":"kwiepa nepɨmatsi'ukahɨa meta naxi nepɨmatsihayeitɨa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mematsixeiyatɨ, mepɨmama","poem":1},{"text":"yunaitɨ nuiwarite memɨmatsimate.","poem":2},{"text":"'Imatɨrieka tukaritsie 'axape'anetɨ pepe'ayeitɨa,","poem":1},{"text":"tawariri 'apepɨka'uyeikani”».","poem":2}]},{"type":"heading","content":["Niuki Tsiruni hetsiemieme"]},{"type":"verse","number":20,"content":["Yawé mɨpaɨ kanetiniutaxatɨani:"]},{"type":"verse","number":21,"content":["«Tewi pemunu'aya, Tsiruni hɨxiena keneutakeka, hepaɨtsitana ketineutaxata."]},{"type":"verse","number":22,"content":["Mɨpaɨ ketinayemari'itɨa, Yawé naimekɨmɨyɨwe mɨpaɨ kanaineni:",{"text":"»“'Ena nepuwe Tsiruni nematsitaxanetake,","poem":1},{"text":"meta 'aixɨa nemɨtitahɨawarienikɨ 'ahetsiemieme.","poem":2},{"text":"Kepauka 'ahetsie nemi'atɨani 'uximatɨarika heitserie mexeiya,","poem":1},{"text":"'ahetsie kenemɨtipatsie nematsiɨkɨme nepaneyeitɨani,","poem":2},{"lineBreak":true},{"text":"'ana mɨpaɨ pɨtimatsiɨkɨre kename ne, Yawé nehɨkɨ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"'Ahetsiemieme kwiniya nepanɨ'ani,","poem":1},{"text":"'akaye 'utɨma xuriya puhaneni,","poem":2},{"text":"'ixipara tiyurieyu,","poem":1},{"text":"memɨwitekietɨka 'akaye 'utɨma mepɨkaxɨrieni,","poem":2},{"lineBreak":true},{"text":"'ana mɨpaɨ mepɨtehetimani kename ne, Yawé nehɨkɨ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"'Ixaheritsixi tawariri mepɨka'uximatɨarieka","poem":1},{"text":"wa'aurie kiekatari 'aixɨa mekatewaxeiyakaku,","poem":2},{"text":"kɨye manuyemɨtsɨkɨ 'anatseiwatɨ kemɨtiyukukuine hepaɨ,","poem":1},{"text":"meta xuyakɨ hepaɨ,","poem":2},{"lineBreak":true},{"text":"'ana mɨpaɨ mepɨtehetimani kename ne, Yawé nehɨkɨ”.","poem":2}]},{"type":"verse","number":25,"content":["»Yawé naimekɨmɨyɨwe mɨpaɨ kanaineni: “Kepauka nemɨwakuxeɨrieni 'ixaheritsixi 'ateewa memutetɨka hipame nuiwarite wahetsɨa, kenemɨtipatsie nuiwarite wahɨxie matsiɨkɨme nepaneyeitɨani. Hikɨ 'ana 'Ixaheri yukwieyaritsie pukani, neti'uximayatsiriwame Kakuwu nemɨyetuiritsie."]},{"type":"verse","number":26,"content":["Mana 'aixɨa 'iyari mepu'uwani, mepuyutikitɨani, kaxie mepɨka'eni, netsɨ nekaniwa'uximatɨamɨkɨ kemɨ'ane 'Ixaheri kiekariyari memɨxani'erie. 'Ana mɨpaɨ mepɨtehetimani kename ne, Yawé wakakaɨyari nehɨkɨ”»."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/EZK/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/EZK/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/EZK/27.json","previousChapterAudioLinks":{},"numberOfVerses":26}