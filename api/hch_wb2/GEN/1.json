ext":"mexɨakame tukari kanayani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kakaɨyari mɨpaɨ kaniutayɨni:","poem":1},{"text":"«'Amakuyewa ke'uneni haa hixɨapa","poem":2},{"lineBreak":true},{"text":"ke'ipata haa taheima mieme meta kwiepa mieme».","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mɨpaɨ katiniuyɨni. Kakaɨyari 'amakuyewa kaniutawewieni,","poem":1},{"text":"mipataxɨanikɨ haa, tahetɨa mɨtamakakɨ,","poem":2},{"lineBreak":true},{"text":"taheimata muyemakakɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"'Amakuyewa, Kakaɨyari «muyuawi» katiniuterɨwa.","poem":1},{"text":"Hikɨ kaniukuyɨre, ximerita kanayani,","poem":2},{"lineBreak":true},{"text":"Hutarieka tukari kanayani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Hikɨ Kakaɨyari mɨpaɨ kaniutayɨni: «Haa muyuawitɨa mɨtama","poem":1},{"text":"ke'uyukuxeɨrieni 'axeikɨa,","poem":2},{"lineBreak":true},{"text":"'uwakitɨ ke'ayani».","poem":2},{"text":"Kemutayɨ mɨpaɨ pɨtiɨyɨ.","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Muwaki «kwie» Kakaɨyari katiniterɨwa,","poem":1},{"text":"haa muyukuxeɨri «haramara» katiniterɨwa.","poem":2},{"text":"'Ixeiyatɨ Kakaɨyari «'Aixɨa pɨ'ane», kaniutayɨni.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hikɨta Kakaɨyari mɨpaɨ kaniutayɨni: «Ketiutineni kwiepa,","poem":1},{"text":"ke'utineni tupiriyate yuhatsiyarite hexeiyatɨ,","poem":2},{"text":"'iteɨrite yutakari kehexeiyatɨkani meta yuhatsiyarite.","poem":1},{"text":"Naitɨ xexuitɨ kemɨtiupitɨarie».","poem":2},{"text":"Mɨpaɨ katiniuyɨni.","poem":1}]},{"type":"verse","number":12,"content":[{"text":"'Ana katiniutineni naitɨ,","poem":1},{"text":"tupiriyate yuhatsiyari hexeiyatɨ,","poem":2},{"text":"kɨyexi yu'ikwaxi yuhatsiyari hexeiyatɨ kanayani,","poem":1},{"text":"naitɨ kemɨtiupitɨarie.","poem":2},{"lineBreak":true},{"text":"Kakaɨyari mɨkɨ 'aixɨa katiniuxeiya.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hikɨ kaniukuyɨre, ximerita kanayani,","poem":1},{"text":"hairieka tukari kanayani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kakaɨyari mɨpaɨta kaniutayɨni:","poem":1},{"text":"«Meke'utixuawere muyuawitsie hekɨariwiwamete,","poem":2},{"lineBreak":true},{"text":"meke'ipata tukari tɨkari,","poem":2},{"text":"mɨkɨ 'inɨari meke'akɨne","poem":1},{"text":"taxarita, witarita, 'ahurakaku, xexerixa, tukari meta wiyari,","poem":2},{"lineBreak":true},{"text":"'inɨariyari meke'akɨne.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Muyuawitsie meke'utimerɨkani,","poem":1},{"text":"kwiepata memɨhekɨariwiekakɨ».","poem":2},{"text":"Mɨpaɨ katiniuyɨni.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Kakaɨyari hutame mamariwaweme hekɨariwiwamete kaniutiwewieni,","poem":1},{"text":"xeime 'anekame tau tukarikɨ mieme,","poem":2},{"text":"xeimeta yakɨ tixawatɨme metseri tɨkarikɨ mieme,","poem":1},{"text":"meta xurawetsixi tɨkarikɨ miemete.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kakaɨyari hekɨariwiwamete muyuawitsie katiniwarukayatsa","poem":1},{"text":"memɨhekɨariwiekakɨ kwiepa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Pɨwarutiwewi mɨme matsi waɨkawa memɨmamariwawenikɨ tukarikɨ tɨkarikɨ,","poem":1},{"text":"hekɨariya memɨpatanikɨ.","poem":2},{"text":"Hikɨ Kakaɨyari «'Aixɨa pɨ'ane», kaniutayɨni.","poem":1}]},{"type":"verse","number":19,"content":[{"text":"Hikɨ kaniukɨyɨre, ximerita kanayani.","poem":2},{"lineBreak":true},{"text":"Naurieka tukari kanayani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mɨpaɨ kaniutayɨni Kakaɨyari: «Yumɨiretɨ haapa meketeye'uwani,","poem":1},{"text":"meketeheɨwɨtɨkani wikixi kwie heima","poem":2},{"lineBreak":true},{"text":"muyuawi kemɨyewa».","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hikɨ Kakaɨyari katiniwarutiwewieni yunaime metemamariwaweme haramaratsie miemete,","poem":1},{"text":"meta yunaime memɨte'ayeneniere 'etsimepepetɨ memɨkuyuatɨka memɨyuxiɨtɨa haata paitɨ,","poem":2},{"text":"meta yunaime memɨte'awɨwawe,","poem":1},{"text":"yuxexuime kemɨtiwarupitɨa.","poem":2},{"text":"Hikɨ Kakaɨyari 'aixɨa katiniwaruxeiya.","poem":1}]},{"type":"verse","number":22,"content":[{"text":"'Aixɨa kaniwaruyurieni mɨpaɨ 'utaitɨ:","poem":2},{"text":"«Xekeneyuxiɨtɨaka xekeneyumɨiriyani,","poem":1},{"text":"xekenehɨneni haapa haramaratsie.","poem":2},{"lineBreak":true},{"text":"Wikixi meta xekeneyɨmɨiriyani kwiepa».","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hikɨ kaniukuyɨre, ximerita kanayani,","poem":1},{"text":"'auxɨwirieka tukari kanayani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Kakaɨyari mɨpaɨ kaniutayɨni: «Xekeneyɨmɨiriyani kwiepa yunaitɨ xemayeyuyurini,","poem":1},{"text":"yunaitɨ memɨteyutewatsinɨa, yeutari meta,","poem":2},{"lineBreak":true},{"text":"yuhukama memuku'uwa kwiepa, yunaime kememɨteheupaɨme».","poem":2},{"text":"Mɨpaɨ pɨtiuyɨ.","poem":1}]},{"type":"verse","number":25,"content":[{"text":"Kakaɨyari yunaime katiniwarunetɨani memɨteyutewatsinɨa,","poem":1},{"text":"yeutari, yunaime yuhukama memɨteku'uwa,","poem":2},{"lineBreak":true},{"text":"yunaime kemɨtiwarupitɨa.","poem":2},{"text":"Kakaɨyari mɨpaɨ kaniutayɨni: «'Aixɨa pɨ'ane».","poem":1}]},{"type":"verse","number":26,"content":[{"text":"Mɨpaɨta kaniutayɨni: «Tewi tepɨtawewieni","poem":2},{"lineBreak":true},{"text":"tahepaɨ tiyuxexeiyame tahepaɨ tiyɨkɨhɨaweme.","poem":2},{"text":"Pɨtiwata'aitɨani ketsɨte haramaratsie miemete,","poem":1},{"text":"wikixi meta muyuawitsie miemete,","poem":2},{"text":"yunaime memɨteyutewatsinɨa,","poem":1},{"text":"yeutari,","poem":2},{"noteId":2},{"text":"yunaime memɨka'ukɨniwawe","poem":1},{"text":"yuhukama memuku'uwa kwiepa».","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kakaɨyari tewi kaniutawewieni yuhepaɨ 'anekame,","poem":1},{"text":"pitawewi 'inɨarieya mayanikɨ yuhepaɨ 'anekame.","poem":2},{"text":"'Uki meta 'uka pɨwarutiwewi.","poem":1}]},{"type":"verse","number":28,"content":[{"text":"'Aixɨa kaniwaruyurieni mɨpaɨ 'utaitɨ:","poem":2},{"text":"«Xekeneyuxiɨtɨaka xekeneyɨmɨiriyani,","poem":1},{"text":"kwiepa xekenehɨneni xeketene'aitani.","poem":2},{"text":"Xepɨhɨritɨarieni ketsɨte haramaratsie miemete, wikixi yunaime muyuawitsie miemete,","poem":1},{"text":"yunaime memɨka'ukɨniwawe yuhukama memuku'uwa kwiepa».","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Mɨpaɨta katiniwarutahɨawe: «Ne nepɨxeyetuiri kwiepa mieme 'iteɨrite,","poem":1},{"text":"naime 'iteɨrite yuhatsiyari hexeiyakame,","poem":2},{"text":"naime 'iteɨrite yutakari yuhatsiyari hexeiyakame.","poem":1},{"text":"Mɨkɨ naitɨ xe'ikwai pɨrayani.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Tupiriya nepɨxeyetuirieni, xe'ikwai mayanikɨ,","poem":1},{"text":"yunaitɨ yeutari kwiepa memɨtexuawe,","poem":2},{"lineBreak":true},{"text":"yunaitɨ wikixi muyuawitsie miemete","poem":2},{"text":"yunaitɨ memeumaketɨka kwiepa».","poem":1},{"text":"Kemutayɨ mɨpaɨ pɨtiuyɨ.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kakaɨyari naime katiniuxeiya tita mɨtiutiwewi.","poem":1},{"text":"«'Aixɨa pɨ'ane», kaniutayɨni.","poem":2},{"text":"Hikɨ kaniukuyɨre, ximerita kanayani,","poem":1},{"text":"'ataxewirieka tukari kanayani.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":0,"caller":"+","text":"'iyari. Ya 'eka.","reference":{"chapter":1,"verse":2}},{"noteId":1,"caller":"+","text":"tukari. Huriyutsixi wahetsiemieme, xeitukari putsutɨarie 'akayuneku tau, 'atsita 'uxa'arieka 'epauka.","reference":{"chapter":1,"verse":5}},{"noteId":2,"caller":"+","text":"yeutari(tsiriyatari waniuki), naitsarie kwiepa(hepɨrayutsixi waniuki).","reference":{"chapter":1,"verse":26}}]},"thisChapterLink":"/api/hch_wb2/GEN/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/GEN/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previo