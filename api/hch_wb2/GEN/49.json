{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"GEN","translationId":"hch_wb2","name":"Tsutɨarika","commonName":"Tsutɨarika","title":"Tsutɨarika","order":1,"numberOfChapters":50,"sha256":"45b258b8ebc154dd913b41032efc6803cb1d180cd18e65066b03694080f32a6b","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/hch_wb2/GEN/50.json","totalNumberOfVerses":1532},"chapter":{"number":49,"content":[{"type":"heading","content":["Kakuwu yuniwema kemɨtiwarutahɨawixɨ"]},{"type":"verse","number":1,"content":["Merikɨtsɨ Kakuwu yuniwema kaniwarutakwewieni, mɨpaɨ katiniwarutahɨawe: «Xekeneuyukuxeɨri nepɨtixetaxatɨani kemɨtiyɨni xehetsie."]},{"type":"verse","number":2,"content":[{"text":"»Neniwema: 'Ahurawa xekenakɨni,","poem":1},{"text":"xekeneneu'eni kenemɨtixetahɨawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"»'Ekɨ meri Xuweni pemɨnematɨari,","poem":1},{"text":"'akɨmana meri pɨmatsiɨkɨkai kenemɨtitɨrɨkaɨyekai tɨɨri nemɨwarexeiyanikɨ.","poem":2},{"text":"'Ekɨ matsi heitserie pepexeiya,","poem":1},{"text":"'Ekɨ matsi pepɨtɨrɨkaɨye.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Perutsɨ 'ekɨ mexɨakame pepɨkahɨkɨtɨniri:","poem":1},{"text":"'Axapemɨnetsi'uyurikɨ.","poem":2},{"text":"Ne'ɨya matɨa pemukahuikɨ neti'uximayatsiriwame,","poem":1},{"text":"'ayumieme hamewari mɨkayunɨtɨarinɨa hepaɨ pepɨ'aneni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"»Tsimehuni matɨa Rewi yawixi memayu'eririya wahepaɨ mekani'aneneni,","poem":1},{"text":"yu'ixiparakɨ mepɨteyumemiwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne wahetsɨa nepɨkaheu'ixɨaramɨkɨ.","poem":1},{"text":"Kapa 'axatiyuruwame hepaɨ netiuxeiyarienikɨ.","poem":2},{"text":"Yuhaxɨakɨ teɨteri mepɨwarukwi,","poem":1},{"text":"mewaikatɨwetɨ tuurutsixi mepɨwarutixite wa'ɨkatetsie.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wahaxɨa 'axake'itɨarieka kememɨteyumemiwa,","poem":1},{"text":"yuhaxɨakɨ pɨwanake hiwerika memɨwapitɨakakɨ hipame.","poem":2},{"text":"Ne nepɨwatanɨ'axɨani nekwiepa,","poem":1},{"text":"nepɨwataxɨriexɨani 'Ixaheri kwieyaritsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"»'Ekɨ Kura, 'a'iwama 'aixɨa meputiyuaneni 'ahetsiemieme.","poem":1},{"text":"Memɨmatsi'aye'unie pepɨwara'iwani,","poem":2},{"lineBreak":true},{"text":"'ahɨxie mepɨtitunuma'uni 'a'iwamatɨtɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neniwe Kura, maye temaikɨ hepaɨ pepɨ'ane,","poem":1},{"text":"maxa muwiyarie mɨkwa'a hepaɨ.","poem":2},{"text":"Maye 'amɨpa hepaɨ, pe'itakwaka pehakunuaka pemanuhuputsie pekaniyuhayewa.","poem":1},{"text":"Maye 'uka hepaɨ, xewitɨ pɨkayɨwe mɨmatsi'uximatɨanikɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kura xewitɨ pɨka'inawairieni ti'aitame 'itsɨya, nuiwarimama yuheyemekɨ mepɨteta'aita.","poem":1},{"lineBreak":true},{"text":"Kepaukake munuani yurikɨ ti'aitame,","poem":1},{"text":"'aixɨa mɨtiuka'iyari meuyewetse hɨxiena yamemɨtekahunikɨ kwiepa memɨtama.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kura kaxie waɨkawa pexeiya.","poem":1},{"text":"'Ayumieme yupuxu pakuwiwa kaxie kɨyeyaritsie,","poem":2},{"lineBreak":true},{"text":"meta puxu nunutsi pikwa'a kaxie xawariyari.","poem":2},{"text":"Yu'ixurikite pɨti'ekwa kaxie winuyaritsie,","poem":1},{"text":"yɨ'ɨkarite kaxie takari hayariyaritsie piti'ekwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kaxie winuyari waɨkawa pexeiya, 'ayumieme hɨxiteya pɨyɨyɨwi.","poem":1},{"text":"Retsi kemɨtituxa, matsi waɨkawa putuxa tameteya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"»Tsawuruni haramara tetsita kiekame kanayeimɨkɨ,","poem":1},{"text":"nawiyatsixi mɨwa'axe 'aixɨa mɨtiuye'ane kanayeimɨkɨ,","poem":2},{"lineBreak":true},{"text":"Tsiruni paitɨ kwieya kaniye'atɨkaimɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"»'Itsakaxi puxu hepaɨ pɨranuweri,","poem":1},{"text":"peru naitsata heuti'ikatɨkaitɨ 'apuka.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kepauka mixei yukuraru 'aixɨa tiuye'anekame,","poem":1},{"text":"kwiepa 'aixɨa raku'anekame mɨka'uxipienikɨ,","poem":2},{"text":"puyuwaɨri 'ika matɨkɨnikɨ,","poem":1},{"text":"ti'uximayatame payuyeitɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"»Rani 'itsɨkame hepaɨ pɨtiyurieni yuteɨterima wahetsiemieme","poem":1},{"text":"'Ixaheri nuiwaritemama watsata.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Rani pɨtɨrɨkaɨyeni, kuu mɨtiyumemiwa hepaɨ huyeta mɨkaka,","poem":1},{"text":"kepauka kawayu 'ɨkayatsie mɨtakeni,","poem":2},{"lineBreak":true},{"text":"manaka yuwarima peukaweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"»Yawé 'aku 'awikweitsitɨarika nepɨtakwewie.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"»Kahari, tenawayamete memanitamiekuni,","poem":1},{"text":"matsi mɨkɨ wawarita kanakuyeimɨkɨ kaniwakwimɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"»'Ekɨta 'Atsexi, 'ikwai 'aixɨa ra'anekame pepɨtikwa'a,","poem":1},{"text":"'aixɨa ra'anekame petiukawewiwatɨ pepɨtiwamikwani kwiepa te'aitamete.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"»Nepɨtahari, maxa 'uka yuxaɨta muyeikani hepaɨ pɨ'aneni,","poem":1},{"text":"maxatsi tɨɨrixi witsimemɨ'anene yumaama wahepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"»Kutse, hatetsita 'iteɨritsiekame hepaɨ pɨ'ane,","poem":1},{"text":"waɨkawa mɨyɨra,","poem":2},{"lineBreak":true},{"text":"mamateya kurarutsie manutimake hepaɨ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kuyaxi tupi memu'ɨ mekanitamɨni,","poem":1},{"text":"mekaheinenimayatɨ me'ihekatɨ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Perutsɨ Kutse yutupi heitserie pakwe'e,","poem":1},{"text":"mamateya pɨka'akatutuke.","poem":2},{"text":"Pamɨpariyutsi Kakuwu kakaɨyarieya pemɨtɨrɨkaɨye,","poem":1},{"text":"pemɨtatsi'ɨwiyame 'ixaheritsixi,","poem":2},{"lineBreak":true},{"text":"tete mɨtse'i hepaɨ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Neuxei Kutse:","poem":1},{"text":"Pamɨpariyutsi 'apaapa Kakaɨyarieya mɨmatsiparewie.","poem":2},{"lineBreak":true},{"text":"Pamɨpariyutsi Kakaɨyari Naimekɨmɨtɨrɨkaɨye,","poem":2},{"lineBreak":true},{"text":"'aixɨa mɨmatsiyurie.","poem":2},{"text":"Ke 'aixɨa mɨmatsiyurie taheima miemekɨ wiyerikɨta,","poem":1},{"text":"matsipitɨatɨ meta 'emeukatewatsie miemekɨ haixakɨ,","poem":2},{"lineBreak":true},{"text":"niwekate tɨɨri kememɨtewarayexexeiya kememɨtewatsitsitɨa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Matsi 'aixɨa pɨti'anene tita 'apaapa nehɨkɨtɨtɨ nematiyetuirie,","poem":1},{"text":"hɨri ke 'aixɨa mɨtipitɨarie meripaitɨ mieme reutiyetana,","poem":2},{"lineBreak":true},{"text":"matsi waɨkawa 'aixɨa peke'itɨarieka.","poem":2},{"text":"Hikɨ 'aixɨa kenemɨmatsiyurie pɨ'ahetsiemieme Kutse,","poem":1},{"text":"'a'iwama watsata pepanayexeiyarie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"»Wenikamini, 'ɨrawe mayu'eriya hepaɨ pɨ'ane,","poem":1},{"text":"ximeri tikwatɨ tita mɨtiumi,","poem":2},{"lineBreak":true},{"text":"taikaita hipame pɨtiwamikwa tita mɨtiutatexi».","poem":2}]},{"type":"verse","number":28,"content":["Mɨpaɨ katiniwarutahɨawe 'Ixaheri yuniwema, tamamata heimana huta nuiwariyari, yuxexuime 'aixɨa kaniwaruyurieni, yuhetsie memeixeiyanikɨ."]},{"type":"heading","content":["'Imatɨrieka Kakuwu yuniwema kemɨtiwarutahɨawixɨ"]},{"type":"verse","number":29,"content":["'Imatɨrieka Kakuwu mɨpaɨ katiniwarutahɨawe yuniwema: «'Ariri nekanimɨximeni, kepauka nemɨmɨni. Nepaapama memuyehetsie xekeneneutateka, terɨta 'Epuruni Heti tewiyari mɨkwieyatɨkaitsie."]},{"type":"verse","number":30,"content":["Terɨ Makipera nekanixatani Mamɨre hɨxie mɨti'ane, Kanani kwieyaritsie 'Apɨrahami minanai, 'Epuruni Heti tewiyari kaniunanairieni, yunaitɨ tɨɨriyamama muwa memeutatuariwanikɨ."]},{"type":"verse","number":31,"content":["Muwa mekanayeheni 'Apɨrahami, 'ɨyaya Tsara, 'Itsahaki, 'ɨyaya Xeweka, muwa tsiere Reya neneutateni."]},{"type":"verse","number":32,"content":["Mɨkɨ kwie terɨ kaniunanaiyani, Heti teɨteriyari meri katiniwapiinitɨkaitɨni»."]},{"type":"verse","number":33,"content":["Kepauka mɨtiutahayewaxɨ Kakuwu yuniwema tiwakuxaxatɨwatɨ, 'ukahuka 'imatɨrieka kaniuka'ietɨyani kaniumɨni. Kaneyani yu'ukiyarima wahetsɨa."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}