{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"HAB","translationId":"hch_wb2","name":"'Awakuxi","commonName":"'Awakuxi","title":"'Awakuxi","order":35,"numberOfChapters":3,"sha256":"a08b4d4eebac65788b9f3b37d2117bee64e841ac4d1d7076f2a0f9920a73a563","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/hch_wb2/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["'Ikɨ kemɨtiyɨni niukiyari kanihɨkɨtɨni 'Awakuxi Kakaɨyari niukameya kemɨtiunieritɨarie."]},{"type":"heading","content":["'Awakuxi Kakaɨyari kemɨtiutahɨawixɨ"]},{"type":"verse","number":2,"content":[{"text":"Yawé, ne'utahiwatɨ parewiya nepɨmatsiwawirie,","poem":1},{"text":"peru 'ekɨ pepɨkanetsi'enie,","poem":2},{"text":"¿Kepaukakeri pepɨnetsihanu'enieni?","poem":1},{"text":"Waɨkawamekɨ nepɨmatsiwawiriekai mukumawerekɨ ketemɨtenanaimarie, peru 'ekɨ 'atsipepɨkara'eriwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"¿Titayari penetixeiyatsitɨa hipatɨ kememɨtenanaimarie?","poem":1},{"text":"¿Titayari netiwaxeiyani hipatɨ kememɨtehiweritɨarie?","poem":2},{"text":"Naitsarie nepɨtixeiya kememɨteyuka'una meta kememɨteyunanaima,","poem":1},{"text":"kememɨteyukwitɨwe meta kememɨte'ayuye'unie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nixewitɨ 'a'aitsika hetsie yapɨkatikamie","poem":1},{"text":"meta nixewitɨ kemɨtiheitserie yapɨkatikamie yu'iwa hetsɨa.","poem":2},{"text":"'Axamemɨte'u'iyari kemɨtiheitserie memɨte'u'uwa mekaniwananaimaka,","poem":1},{"text":"meta 'itsɨkame kemɨtiheitserie yapɨka'utaine.","poem":2}]},{"type":"heading","content":["Yawé kemɨtiuta'a"]},{"type":"verse","number":5,"content":[{"text":"«Xekeniwaruxeiya nuiwarite.","poem":1},{"text":"Kwixekeniwaruxeiya meta xemamatɨ xekeneuyuhayewa.","poem":2},{"text":"'Ikɨ tukariyaritetsie yanepɨtiyurixime tixaɨtɨ yaxemɨkateha'eriwa","poem":1},{"text":"tsepa xewitɨ mɨpaɨ mɨtixe'uxatɨa yuri xepɨkate'erieka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Karireutsixi nekaniwayuitɨamɨkɨ,","poem":1},{"text":"mɨkɨ teɨteri memayu'eririya memɨhɨkɨ meta memɨtɨrɨkawi,","poem":2},{"text":"naitsarie kwiepa memuku'uwa","poem":1},{"text":"hipame wakwie yuhetsiemieme meyeitɨakutɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mɨkɨ teɨteri mepɨmamariwawe meta mepɨmakaxiwa,","poem":1},{"text":"yu'inɨari niukiyaritsie xeikɨa yamekatenikahuni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wakawayutsixi tɨwexi wareuyeta mepayɨwawe,","poem":1},{"text":"'ɨrawetsixi tɨkakɨta miemete wareuyeta mepɨte'u'iyari.","poem":2},{"text":"Kawayutsixi wahetsie me'utetɨ yumɨiretɨ meputinanautsa,","poem":1},{"text":"memutei 'atewapaitɨ mepaneika.","poem":2},{"lineBreak":true},{"text":"Wirɨkɨxi kememɨte'uxɨrɨwe memɨtetakwanitsie mɨpaɨ mekateniyumateni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mekani'axɨakuni naime meteye'unarɨmetɨ,","poem":1},{"text":"memɨyehunitsie marika puxuaweni,","poem":2},{"lineBreak":true},{"text":"memɨwaranutaxɨrɨwa xiekari mɨranukutuiwa hepaɨ mekateniwaruxexeɨriwani.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Te'aitamete mekaniwatewiyatsitɨaka,","poem":1},{"text":"kuwexinaruritsixi mekaniwananaimaka,","poem":2},{"text":"mekaniutinaweni kiekari yukuraru 'amatitetewa memexeiyatɨka wahepaɨtsita,","poem":1},{"text":"xiekari 'imɨmɨiyari mekaniutiwewiwani, hikɨ kiekaritsie mekaneutahakeni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Eka naime mɨtiye'unatɨyeika hepaɨ mekani'aneni,","poem":1},{"text":"peru waɨkawa 'axamekateniuyurieni, yutɨrɨkariyatɨme yukakaɨyari memayeitɨakɨ».","poem":2}]},{"type":"heading","content":["Hutarieka 'Awakuxi Kakaɨyari kemɨtiutahɨawixɨ"]},{"type":"verse","number":12,"content":[{"text":"'Ekɨ, Yawé, yuheyemekɨ 'apekaniuyeikani.","poem":1},{"text":"'Ekɨ, nekakaɨyari pemɨpatsie, hatsuakutɨma pemɨkamɨwe pekanihɨkɨtɨni.","poem":2},{"text":"'Ekɨ, Yawé, kemɨtiheitserie memɨteyurienikɨ pepɨwa'atɨani,","poem":1},{"text":"'ekɨ, ne'ai, pekaniwa'atɨamɨkɨ memɨtatsi'ayemari'itɨanikɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Ahɨxite yemekɨ pɨ'itiyatɨka 'axamɨti'ane pepɨkareuxeiyawe,","poem":1},{"text":"pepɨkayɨwe pemɨwaxeiyani hipatɨ menanaimariekaku.","poem":2},{"text":"¿Titayari kamɨtsɨ 'axamemɨte'u'iyari 'atsipekatiwayuriwe?","poem":1},{"text":"¿Titayari kayuwatɨ petiuma","poem":2},{"lineBreak":true},{"text":"mexi 'axamemɨte'u'iyari 'aixɨa memɨte'u'uwa mewakwa'a?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Teɨteri tsapari haramaratsie memɨye'uwa pepɨwarayeitɨa,","poem":1},{"text":"kwiepa yuhukama memɨteku'uwa memɨkatehekakutsiyari pepɨwarayeitɨa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wawiruniya yukwaitsɨkɨ yunaime kaniwaranatihapanani,","poem":1},{"text":"yuwipitekɨ yunaime kaniwakuyuruwani,","poem":2},{"text":"yu'ataxayakɨ kaniwaranatitutuweni,","poem":1},{"text":"mɨpaɨ meteyurietɨ mekaniyutemamawieka.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"'Ayumieme wawiruniyutsixi yu'ixiparate yukakaɨyari mekanayeitɨwani,","poem":1},{"text":"meta mekaniwarayexeiyani.","poem":2},{"text":"'Ixiparate waparewiekaku","poem":1},{"text":"waɨkawa xikutsixi mekanayexɨrieni.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"¿Kamɨtsɨ petiwapitɨaka yuheyemekɨ mɨpaɨ memɨteyurieka?","poem":1},{"text":"¿Yuheyemekɨ metehayu'iwani hipame wakiekaritsie metahaketɨ mewakwitɨ mekawanenimayatɨ?","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/HAB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/HAB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/NAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":17}