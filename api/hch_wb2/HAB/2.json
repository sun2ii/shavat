{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"HAB","translationId":"hch_wb2","name":"'Awakuxi","commonName":"'Awakuxi","title":"'Awakuxi","order":35,"numberOfChapters":3,"sha256":"a08b4d4eebac65788b9f3b37d2117bee64e841ac4d1d7076f2a0f9920a73a563","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/hch_wb2/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Netanieretɨ nekaniyuhayewamɨkɨ,","poem":1},{"text":"wapaitɨ nenieremetsie ne'akakaitɨ,","poem":2},{"text":"nepɨta'ikwewani kemɨnetitahɨawe,","poem":1},{"text":"kemɨnetita'eiya mɨyanemɨtitahɨawixɨkɨ.","poem":2}]},{"type":"heading","content":["Yawé kemɨtiuta'a"]},{"type":"verse","number":2,"content":["Hikɨ Yawé mɨpaɨ kanetiniuta'eiya:",{"text":"«Kepemɨtiunierixɨ ketinaka'utɨa,","poem":1},{"text":"yuhekɨakamekɨ haxu 'etsitsutsuimetsie","poem":2},{"lineBreak":true},{"text":"para xeiya mekaterɨwa mɨyɨwenikɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Karikɨ kepemɨtiunierixɨ yakatiniyɨmɨkɨ yemekɨ kepauka tukaritsie yamɨtiyɨnikekai,","poem":1},{"text":"tukari kaniyemieni maye'anikɨ, mɨkɨ tukari pɨkahayewarieni mɨka'aye'anikɨ.","poem":2},{"text":"Tsepanetɨ 'amɨreɨtewini yakatiyɨwetɨ, keneta'ikwewani,","poem":1},{"text":"mɨkɨ tukari kanaye'amɨkɨ kahauyewekamekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"»Memuyuti'ɨre 'iyari heitseriekame mepɨkahexeiya,","poem":1},{"text":"peru kemɨtiheitserie 'amuyeika yuri mɨti'eriekɨ payeyurini.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Matsi, xikutɨriya pɨtiyu'itaiya,","poem":1},{"text":"'ayumieme memuyuti'ɨre 'amepɨkateheutere.","poem":2},{"text":"Yukɨipitsie 'emepanatiyeyeure, mɨki teukiya hepaɨ,","poem":1},{"text":"meta mepɨkahuxaiwawe mɨki yɨwikame hepaɨ.","poem":2},{"text":"Yu'aurie yunaime nuiwarite mekaniwarukuxexeɨriwani","poem":1},{"text":"meta yunaime teɨteri mekaniwarehapanani.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Peru mɨkɨ hatsuakutɨni tixaɨtɨ mepɨkatehayeitɨarieni.","poem":1},{"text":"Nuiwarite mepɨwatinanaimani hikɨ 'ikɨ kwikari wahetsiemieme mepɨtakwika:","poem":2},{"lineBreak":true},{"text":"»Xɨa'ui waɨkawa rexeiyatɨ mayuyeitɨa hipame tiwapiinitekɨ,","poem":1},{"text":"meta piinitɨarika waɨkawa mɨtiukuxeɨri 'itarikakɨ.","poem":2},{"lineBreak":true},{"text":"¿Kepaukakeri pɨtihayewa mɨyatiyurienetɨ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yapauka mekananuku'uikuni memɨmetehapinirie.","poem":1},{"text":"Memetsi'aye'unietɨ mekanakɨnikuni tinaime mekameteninawairiekuni tita pemɨrexeiya,","poem":2},{"lineBreak":true},{"text":"mexi 'ekɨ pe'uyɨyɨakani pekatɨrɨkaɨyetɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nuiwarite mekaniyumɨireni pemɨtiwarunawatsiri,","poem":1},{"text":"keyupaɨmetɨ teɨteri memɨyutawikweitsitɨani mɨkɨta mepɨmetenawatsirieni,","poem":2},{"text":"mɨmɨirekɨ xuriya pemutayeuri,","poem":1},{"text":"meta 'ikɨ kwie hetsie waɨkawamekɨ pemɨtiunanaimakɨ,","poem":2},{"lineBreak":true},{"text":"meta 'ikɨ kiekari hetsie meta mana kiekatari pemɨwarunanaimakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"»Xɨa'ui kemɨ'ane yukiita mɨtihɨniya kwamanarikakɨ rana'iwaka","poem":1},{"text":"yuniwema watawikweitsitɨanike","poem":2},{"lineBreak":true},{"text":"wahetsie mɨkatinakenikɨ 'axamɨti'ane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"»Kepemɨtiu'eri 'akie kiekatari pepɨwarutewiyatsitɨa xeikɨa:","poem":1},{"text":"yumɨireme nuiwarite pepɨwareuyehɨa,","poem":2},{"lineBreak":true},{"text":"peru 'ekɨtɨtɨ pepɨ'ayuri.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Ayumieme tetexitɨtɨ kuraru 'amatayewa hetsiemiemete mepahiwatɨka,","poem":1},{"text":"meta kii pikaxiyaritetsie puwa'eiya wahiwari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"»Xɨa'ui kemɨ'ane kiekari mutawewiwa hipame wakwitɨ","poem":1},{"text":"meta kemɨ'ane kiekari mukama hipame wananaimatɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yawé Naimekɨmɨtɨrɨkaɨye mɨpaɨ kanaineni,","poem":1},{"text":"teɨteri tai hetsiemieme mekete'uximayaka","poem":2},{"lineBreak":true},{"text":"meta nuiwarite yakɨ xeikɨa meketeyu'uxitɨaka.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Haa haramara kemɨranukanama hepaɨ,","poem":1},{"text":"mɨpaɨta kwie hetsie mekateniyɨkuni","poem":2},{"lineBreak":true},{"text":"teɨteri Yawé tɨrɨkariyaya memaitɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"»Xɨa'ui 'ekɨ, 'a'iwa pemutitawaitɨwa.","poem":1},{"text":"Xɨa'ui 'ekɨ, winukɨ pemititawaitɨwa","poem":2},{"lineBreak":true},{"text":"waiyarieya maweme pexeiyamɨtɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mɨkɨkɨ pepɨtewiyatsitɨarieni pɨta, hawaikɨ witsipepɨkatixeiyarieni.","poem":1},{"text":"Kamɨtsɨ 'ekɨta kenanu'i, pemɨwaxeitsitɨanikɨ xitekiya 'inɨariyari kepemɨkarexeiya.","poem":2},{"text":"Yawé yutekɨxi yutseriekɨ mehana 'ahetsie ke'itiyeurieni,","poem":1},{"text":"meta witsikepemɨtixeiyariekai hetsiemieme, tewiyarika kematsi'upitɨani.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Riwanu hepaɨtsita kepemɨtiunanaima mɨkɨta kematsi'utapɨna.","poem":1},{"text":"Tewaxi kepemɨtiwareuyehɨa mɨpaɨta peketiuka'unarieni.","poem":2},{"text":"Karikɨ kanimɨireni xuriya pemitayeuri,","poem":1},{"text":"meta pɨwaɨkawa 'ikɨ kwie hepaɨtsita kepemɨtiunanaima,","poem":2},{"lineBreak":true},{"text":"meta 'ikɨ kiekari hetsie meta teɨterimama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"»¿Tita tiyunaki'erie kakaɨyari mɨwewiya,","poem":1},{"text":"kemɨ'ane mitawewi tewi kɨyekɨ tiwewiwame xɨka hɨkɨtɨni?","poem":2},{"text":"¿Tita tiyunaki'erie kakaɨyari mukwaxiyarie,","poem":1},{"text":"'itarika xeikɨa mɨti'ɨkita?","poem":2},{"text":"Tiwewiwame kakaɨyarixi mɨwawewie mekaniuwaweme","poem":1},{"text":"mɨkɨ xeikɨa yuri katini'erieka yuwewiyatsie.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Xɨa'ui kemɨ'ane kɨye mɨpaɨ mɨtikɨhɨawe: “Kenanutanieri”,","poem":1},{"text":"meta tete mɨkaniuwe: “Kenanukukexi”.","poem":2},{"text":"Tsepanetɨ huru meta pɨrata memɨkawiriyarietɨka,","poem":1},{"text":"tixaɨtɨ memɨxete'uta'ɨkitɨani mepɨkayɨwawe,","poem":2},{"lineBreak":true},{"text":"memɨkahayeyuyurikɨ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Peru, Yawé yutuki muyepatsieta kanayekani,","poem":1},{"text":"naitsarie kwiepa mɨtiuyehane hɨxiena kayuwatɨ meke'umaka».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/HAB/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/HAB/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/HAB/1.json","previousChapterAudioLinks":{},"numberOfVerses":20}