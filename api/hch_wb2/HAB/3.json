{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"HAB","translationId":"hch_wb2","name":"'Awakuxi","commonName":"'Awakuxi","title":"'Awakuxi","order":35,"numberOfChapters":3,"sha256":"a08b4d4eebac65788b9f3b37d2117bee64e841ac4d1d7076f2a0f9920a73a563","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/hch_wb2/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["'Awakuxi kemɨtiyutanenewi"]},{"type":"verse","number":1,"content":["'Awakuxi Kakaɨyari niukameya nenewierieya. Mɨpaɨ katiniukwikarieni."]},{"type":"verse","number":2,"content":[{"text":"Yawé, ke'aixɨa pemɨtikuxaxatsiwa nekatinimarieka,","poem":1},{"text":"tita pemɨtiutiwewi, Yawé, mɨkɨkɨ nepɨma.","poem":2},{"text":"Hikɨta yaketineuyuri hekwamekɨ tame te'u'uwakaku,","poem":1},{"text":"hikɨta tahetsiemieme yaketineuyuri temixeiyakɨ,","poem":2},{"lineBreak":true},{"text":"'ahaxɨatsie, kepemɨti'akanenimaya kena'eriwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kakaɨyari Temani mɨrayetewatsie kanayemieni,","poem":1},{"text":"Parani hɨriyaritsie Mɨpatsie kanakamieni.","poem":2},"Tepɨ'uxipieni",{"text":"Xawatɨriyayakɨ muyuawitsie naitɨ puxawatɨ","poem":1},{"text":"meta kwiepa naitsarie 'aixɨa pɨrahɨawarɨwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Xawatɨriyaya merɨkariya hepaɨ pɨtiyuxexeiya,","poem":1},{"text":"mamateyatsie mimierɨkari kaneuneikatɨkani,","poem":2},{"lineBreak":true},{"text":"mɨkɨ warita tɨrɨkariyaya kaniyu'awietani.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwiniya mɨyatɨ hɨxiena kananuyekani,","poem":1},{"text":"tai kaniweiyani 'utɨmana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kepauka muwakeka, kwie kaniutimamaweni,","poem":1},{"text":"kepauka mɨtaneniere, nuiwarite mekaniutiyɨyɨakani.","poem":2},{"text":"Meripaitɨ mieme hɨrite kanikapenikeni","poem":1},{"text":"meta yemurite meripaitɨ miemete kanati'unikeni,","poem":2},{"lineBreak":true},{"text":"matsi Kakaɨyari huyeteya yuheyemekɨ 'atsipɨkayɨwe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nekaniwaxeiyani meyuhiweriekame Kutsani mɨrakutewa memɨkutei,","poem":1},{"text":"meta Mariyani memɨkutei mekaniuyɨyɨakatɨkani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"¿Petiha'akai, Yawé, kepauka pemiwa hatɨate?","poem":1},{"text":"¿Petiha'akai haa mɨtɨrɨkawi hepaɨtsita?","poem":2},{"text":"¿Waɨkawa petiha'akai haramara hepaɨtsita","poem":1},{"text":"'ayumieme 'akawayutsixi wahetsie peranutiya,","poem":2},{"lineBreak":true},{"text":"meta 'akaxetate kuyaxa miemete memɨtehayu'iwa wahetsie?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Atupi 'ari pepuhekɨataxɨ,","poem":1},{"text":"'ɨrɨ peputahɨniyaxɨ 'i'uitɨwameta. Tepɨ'uxipieni","poem":2},{"text":"Kwie hetsie hatɨate pekaniukatuani,","poem":1}]},{"type":"verse","number":10,"content":[{"text":"hɨrite mematsixeiyatɨ mekaniutimamani.","poem":2},{"text":"Waɨkawa wiyeri 'ekamatɨ kaniukaxɨrieni,","poem":1},{"text":"meta hamewari 'amatiyewatsie mieme kaniuyutihaxɨatɨwani, hamewariyari 'anenetɨ muyuawitsie paitɨ kaneutimemeni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tau meta metseri matɨa muyuawitsie kanewa'uweni,","poem":1},{"text":"'a'ɨrɨte kwinie mayɨwawe xawatɨriyayakɨ,","poem":2},{"lineBreak":true},{"text":"'apitsika 'amɨtewi xawatɨriyayakɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Peha'atɨ, naitsarie kwiepa pekaniuyeikani,","poem":1},{"text":"waɨkawa peha'atɨ, nuiwarite pekaniwatipɨnani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Pekanayeyani 'ateɨterima pewaxɨnake,","poem":1},{"text":"pekanayeyani pemenayexei 'ahetsiemieme petawikweitsitɨanike.","poem":2},{"text":"Ti'aitame pekaniutapɨna 'axateyuruwamete wanuiwari mɨhɨkɨtɨkai,","poem":1},{"text":"maweme pekaniuhayewa 'ɨkateyatsie katsutɨme mu'uyatsie 'u'akame. Tepɨ'uxipieni","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Apitsika 'amɨtewikɨ kuyaximama wamu'ute pekananutixɨriexɨani,","poem":1},{"text":"meha'atɨ mekatanitaxɨriexɨakukaitɨni,","poem":2},{"text":"meyutemamawietɨ tahetsie kwinie netɨ mekaniukeni,","poem":1},{"text":"mɨkayuhɨawexɨa kemɨ'itɨariwa hepaɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Haramara pekaniutaketsini 'akawayutsixi wahekɨ,","poem":1},{"text":"pewatayuitɨwatɨ haa mɨmariwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kepauka 'ikɨ nemɨtiu'eni, netaɨta nekaniutimani,","poem":1},{"text":"niukieyakɨ, netenite kaniutiyɨyɨaka,","poem":2},{"text":"ne'umete mutikwaire hepaɨ nepɨreka'erietɨya,","poem":1},{"text":"meta ne'ɨkate putiweranaxɨa.","poem":2},{"text":"Peru ne netiukanewietɨ nekanita'ikwewani","poem":1},{"text":"kepauka 'uximatɨarika tukari","poem":2},{"lineBreak":true},{"text":"munuani 'iya nuiwari wahetsie hikɨ memɨtatsika'una.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tsepanetɨ xapa mɨka'ukaxutuwe,","poem":1},{"text":"meta tsepa kaxie takari mɨka'ukayaxikeni,","poem":2},{"text":"tsepa huriwu takari mɨkatiukaxuawerixɨ,","poem":1},{"text":"meta kwiepa tsepa 'ikwaxite mɨkatiutixuawerixɨ,","poem":2},{"text":"tsepanetɨ muxatsi kuraruta memuyemaweni,","poem":1},{"text":"meta tsepa kuraruta nixewitɨ tewa mɨkayeyeika,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"tsepanetɨ mɨpaɨ mɨti'ane, ne Yawé hetsie nekaniyutemawiekamɨkɨ,","poem":1},{"text":"nepɨnetemawieka Kakaɨyari hetsie netiwiyatɨ, netsiwikweitsitɨwame.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Yawé naimekɨmɨyɨwe netɨrɨkariya kanihɨkɨtɨni,","poem":1},{"text":"maxa kemayɨwe mɨpaɨ ne'ɨkate katinipitɨaka","poem":2},{"lineBreak":true},{"text":"meta 'ameutitewatsie paitɨ ne'uyeikame kanenayeitɨwani.","poem":2},{"lineBreak":true},"Teyuitɨwamete wa'ukiyari. 'Ikɨ kanaritekɨ ke'utakwikarieni."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}