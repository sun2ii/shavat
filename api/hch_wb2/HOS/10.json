{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"HOS","translationId":"hch_wb2","name":"'Utseyaxi","commonName":"'Utseyaxi","title":"'Utseyaxi","order":28,"numberOfChapters":14,"sha256":"5d20814b36906a41cfbeaaf6b3581b6f95cf84730e831891293dde138b5812f3","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/hch_wb2/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"'Ixaheri Kaxie takari waɨkawa meukatei hepaɨ pɨ'anekai","poem":1},{"text":"putixuxuawerekai witsi'anenetɨ kayunewierinɨatɨ.","poem":2},{"text":"Peru kepauka matsi waɨkawa mutixuxuawerekai,","poem":1},{"text":"matsi waɨkawa mawari taiyamete mepɨtiwewiwakai,","poem":2},{"text":"kepauka wakwiepa waɨkawa mɨtiutixuaweriyakai,","poem":1},{"text":"waɨkawa matsi tetexi patsietɨkaime witsi'anenekame mepɨtiwewiwakai.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Iyarieya pɨharuani,","poem":1},{"text":"peru yɨkɨmana katinayukatuamɨkɨ kemɨtiuyuri.","poem":2},{"text":"Yawé wamawari taiyamete kaniti'unamɨkɨ","poem":1},{"text":"meta naime tetexi mɨpatsietɨka memeyexeiyakai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Heiwatɨ mɨpaɨ me'utiyuani: «Yawé tepɨkahayemakaxe,","poem":1},{"text":"'ayumieme tati'aitɨwame tepɨkahexeiya».","poem":2},{"text":"Peru xɨka teheixeiyanike,","poem":1},{"text":"¿Ketiyurienikekai tahetsiemieme?»","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mekatenikuxatani xeikɨa kememɨteyukuhɨawe,","poem":1},{"text":"yuri hepaɨ me'utiyuatɨ peru yakɨxeikɨa tɨratu mekanikuwewiwani,","poem":2},{"text":"'ayumieme 'axamɨ'ane xeikɨa kanixuaweni watsata","poem":1},{"text":"kanikaxutuweni tupiriya 'axamɨ'anene yeuta mieme hepaɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tsamariyatari waɨkawa mekanimamaka","poem":1},{"text":"tsikeru Weti-'Aweni kakaɨyariyari memayexeiyakɨ.","poem":2},{"text":"Tsikeru teteyari memayexeiya waɨkawa mepɨyutihiwerieni,","poem":1},{"text":"yaxeikɨata mawari wewiwamete memɨwarayexeiya kakaɨyarixi.","poem":2},{"text":"Waɨkawa meyuhiwerietɨ mepɨtihiwa mɨmariwekaikɨ,","poem":1},{"text":"wakakaɨyari xeime kwieyaritsie manutɨkienikɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tsikeru nanutɨkiemɨkɨ 'Atsiriya paitɨ","poem":1},{"text":"'imikieri hepaɨ ti'aitame mɨmariwe mekaniyetuiriekuni.","poem":2},{"text":"'Epɨrahini kaniyutitewiyamɨkɨ,","poem":1},{"text":"'Ixaheri meta kaniyutitewiyamɨkɨ yukakaɨyarixi wahetsiemieme.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tsamariya kiekariyari kanikumawerimɨkɨ meta ti'aitame,","poem":1},{"text":"kɨye 'etsipetɨ mehautsitɨarieni hepaɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Watukite 'etsimupepe kaniti'unariemɨkɨ kwiepa mieme,","poem":1},{"text":"hakewa 'Ixaheri 'axatiyurienetɨ matɨa.","poem":2},{"lineBreak":true},{"text":"Xuya meta tupiriya kanitiwawerimɨkɨ mawari taiyame matiwewiwakaitsie.","poem":2},{"text":"Hikɨ hɨri mɨpaɨ mekatenitahɨawikuni:","poem":1},{"text":"«Xeketananukanama», hɨrite 'etsimɨpepe:","poem":2},{"lineBreak":true},{"text":"«Tahetsie keneukaxɨri mɨtatsikwinikɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«'Ekɨ, 'Ixaheri, 'axapetiyurienetɨ pepumie","poem":1},{"text":"Kiweya paitɨ mɨtiyukatsutɨatsietɨtɨ,","poem":2},{"lineBreak":true},{"text":"pepɨkatihayewa 'axapetiyurienetɨ.","poem":2},{"text":"Kiweya kanitamieriemɨkɨ","poem":1},{"text":"'axamɨtiuka'iyarikɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kepauka ne yanemɨra'eriwa, nepɨtiwakwinitɨani,","poem":1},{"text":"'ana nuiwarite meyukuxeɨrieme mekanitamiekuni,","poem":2},{"lineBreak":true},{"text":"mewaranutaxɨrienike waɨkawari 'axamemɨte'uyurikɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Epɨrahini tsikeru mɨmaxiutɨarie pɨhɨkɨ,","poem":1},{"text":"mɨkɨ pinake tɨriku mu'uneni,","poem":2},{"lineBreak":true},{"text":"peru ne yuku nepɨka'enutitekiri.","poem":2},{"text":"Peru hikɨ 'Epɨrahini yuku nekananutitekiriemɨkɨ,","poem":1},{"text":"Kura kanitakwietsanamɨkɨ,","poem":2},{"lineBreak":true},{"text":"Kakuwu kwie 'aixɨa kaniyurimɨkɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Xekeneuka'etsa yuhetsiemieme kemɨtiheitserie,","poem":1},{"text":"Naki'eriya takariyari xekeneuka'itsana,","poem":2},{"lineBreak":true},{"text":"kwietsanaripa xeketene'uximayaka.","poem":2},{"text":"'Ari tukari paye'ari Yawé xema'eriwanikɨ,","poem":1},{"text":"kepaukake munuani penɨ'ani heitserie mɨtiyupitɨwa wiyeriyari.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Peru xeme 'axamɨti'ane xepuka'e, 'ayumieme mɨkatiheitserie xepɨka'itsana,","poem":1},{"text":"'itarika takariyari xekaniutikwani,","poem":2},{"text":"wakaxetatetsie xemeuwawaɨrekaikɨ","poem":1},{"text":"meta wakuyaxi memɨyumɨirekaikɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kuyaxa payani tɨranari kemɨtiutayuane pɨti'eniɨriɨkɨni,","poem":1},{"text":"kememɨteyuku'awietatɨka naitɨ pɨtiti'unarieni,","poem":2},{"text":"kemɨtiuyuri Tsarimani Weti-'Axiweri kuyaxa matɨatsie,","poem":1},{"text":"kepauka wamamama memutixitekie","poem":2},{"lineBreak":true},{"text":"meta tɨɨri yunaitɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Ikɨ Weteri kiekatari mɨyamekanixe'uyurieni,","poem":1},{"text":"'axaxemɨteyuriekɨ kwinimieme.","poem":2},{"text":"'Ixaheri kwieyaritsie ti'aitame kanimieriemɨkɨ yuheyemekɨ","poem":1},{"text":"'amɨtikataretsie.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}