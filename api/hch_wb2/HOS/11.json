{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"HOS","translationId":"hch_wb2","name":"'Utseyaxi","commonName":"'Utseyaxi","title":"'Utseyaxi","order":28,"numberOfChapters":14,"sha256":"5d20814b36906a41cfbeaaf6b3581b6f95cf84730e831891293dde138b5812f3","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/hch_wb2/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":11,"content":[{"type":"heading","content":["Kakaɨyari kemɨtitanaki'eri 'Ixaheri"]},{"type":"verse","number":1,"content":[{"text":"«Kepauka 'Ixaheri mununutsitɨkai 'anapai nepinaki'eriekai,","poem":1},{"text":"'Ekipitu 'uyeikakaku neniwe nepenayexei.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kepauka matsi waɨkawa nemehɨawekai,","poem":1},{"text":"matsi humapai kaniumiekaitɨni.","poem":2},{"text":"Mawari taiyariyari pɨwamawirienekai memɨkayuri kakaɨyarixi,","poem":1},{"noteId":3},{"text":"'ɨkwa pɨwatairienekai.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne 'Epɨrahini muyeiwenikɨ nepɨtiti'ɨkitɨa,","poem":1},{"text":"ne mamayatsie nemɨkawiekai nepɨhɨkɨ.","poem":2},{"text":"Peru mɨkɨ pɨkanetsihetima","poem":1},{"text":"kename ne 'aixɨa reu'eriekame neheyeitɨwakai kepauka mɨtikuyeni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Ahurawa nepuwaha kaunari witsimɨ'anenekɨ,","poem":1},{"text":"'ahurawa nepuwaha naki'eriya kaunariyarikɨ.","poem":2},{"text":"Kemɨti'uximayakai mɨkɨ yuku nepinawairi,","poem":1},{"text":"ne'inaki'erietɨ 'ahurawa neputɨa nemɨtitaminikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"»'Ekipitu xepɨkahakunuaxɨaniri,","poem":1},{"text":"'Atsiriya pɨta xehetsie pɨtita'aita,","poem":2},{"lineBreak":true},{"text":"nehetsɨa xemɨ'axɨanikɨ xemɨka'uyuwaɨrikɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xekiekaritetsie 'ixipara me'u'ɨtɨ mekani'axɨakuni,","poem":1},{"text":"xekitenie mepɨteheuwitexɨani","poem":2},{"lineBreak":true},{"text":"kememɨteku'eriwakai mepɨkaheye'atɨani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Neteɨterima mepuyuwaɨriya memɨkanetsinaki'eriekakɨ kenemɨtitewa,","poem":1},{"text":"'ayumieme tsepa memɨnetsihahɨawe ne nepɨkawaparewieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"»'Epɨrahini, nepɨkayɨwe nemetsiyetuani.","poem":1},{"text":"'Ixaheri, nepɨkayɨwe nemetsi'uku'eirieni.","poem":2},{"text":"Ne nepɨkayɨwe nemetsiyetuani 'Arimaha kenemɨtiyetua hepaɨ.","poem":1},{"text":"Ne nepɨkayɨwe nemetsi'uku'eirieni Tsewuhini hepaɨ.","poem":2},{"text":"Netaɨta, ne'iyari pɨkarexeiya,","poem":1},{"text":"metatsiere nekwinurite panukuyuane.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Peru ne tawarita nepɨkayeha'ani meta","poem":1},{"text":"'Epɨrahini tawarita nepɨkaka'una.","poem":2},{"text":"'Ahamatɨa tewi pɨka'uyeika,","poem":1},{"text":"ne mana nemuyeikakɨ, Kakaɨyari nemɨpatsie,","poem":2},{"lineBreak":true},{"text":"'ayumieme kiekari nepɨkatamieni».","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yawé maye hepaɨ puyutahaxɨatɨani,","poem":1},{"text":"mɨkɨta mepenukuweiya.","poem":2},{"text":"Kepauka Yawé haxɨaya meme'enieni,","poem":1},{"text":"niwemama tau makayuyuipiketsie hepa mepatinexɨani memamatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«'Ekipitu paitɨ mepanexɨani, wikixi wahepaɨ me'uyu'unarɨmetɨ.","poem":1},{"text":"'Atsiriya paitɨ mepanexɨani kukuruxi wahepaɨ memamatɨ,","poem":2},{"lineBreak":true},{"text":"ne wakiita nekaniwareuta'ɨnaxɨamɨkɨ","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"heading","content":["'Ixaheri ke'axamɨtiuyuri"]},{"type":"verse","number":12,"content":[{"text":"»'Epɨrahini pɨneti'itaiyane,","poem":1},{"text":"'Ixaheri mɨra'aita 'itarikakɨ xeikɨa niuki pɨxɨatɨa,","poem":2},{"text":"Kura kuyeikame pɨhɨkɨ, Kakaɨyari hetsɨa 'ateewa paitɨ puyeika.","poem":1},{"text":"Kakaɨyari mɨpatsie yamɨtikamie hetsɨa 'ateewa paitɨ puyeika.","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"Pɨyɨweta mɨtayɨni Wahari kakaɨyarixiyari.","reference":{"chapter":11,"verse":2}}]},"thisChapterLink":"/api/hch_wb2/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}