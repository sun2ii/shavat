{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"HOS","translationId":"hch_wb2","name":"'Utseyaxi","commonName":"'Utseyaxi","title":"'Utseyaxi","order":28,"numberOfChapters":14,"sha256":"5d20814b36906a41cfbeaaf6b3581b6f95cf84730e831891293dde138b5812f3","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/hch_wb2/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"'Epɨrahini 'eka xeikɨa kanikwaka,","poem":1},{"text":"tukarikɨ 'eka mɨxɨka 'utɨa pukuyeika,","poem":2},{"lineBreak":true},{"text":"waɨkawa 'itarika kaniwewieka meta kaniyumieneni.","poem":2},{"text":"'Atsiriya ti'aitame hamatɨa tɨratu mepɨwewietɨwe,","poem":1},{"text":"'Ekipitu ti'aitame hetsɨa hatseiti kaniyetuayani mɨtiyutuaka hepaɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yawé Kura kanixanetani,","poem":1},{"text":"pɨrayukatɨani Kakuwu naime kemuyuri,","poem":2},{"lineBreak":true},{"text":"naime kemɨtiuyuri mɨkɨta mɨpaɨ pɨtipitɨarieni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yumaama hukayatsie paitɨ yekaitɨ yu'iwa putami,","poem":1},{"text":"meta kepauka temaikɨ matɨa Kakaɨyari hamatɨa puyutami.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Niuki tuayame putami pe'iwaxɨ,","poem":1},{"text":"putatsua pitawawiri 'aixɨa miyurienikɨ.","poem":2},{"text":"Weteri pikaxei,","poem":1},{"text":"mana hamatɨana pɨtiutixa,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yawé Kakaɨyari Naimekɨmɨtɨrɨkaɨye hamatɨa pɨtiutixa,","poem":1},{"text":"Yawé mɨtitewa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Peru 'ekɨ kenenua 'akakaɨyari hetsɨa,","poem":1},{"text":"peti'akanaki'erietɨ kemɨtiheitserie ketineyurieneni,","poem":2},{"lineBreak":true},{"text":"hetsiena yuri peti'erietɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kanani ti'inɨnɨatameya 'aixɨa pɨka'anene,","poem":1},{"text":"pinake hipame mɨtiwanawatsirieneni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"'Epɨrahini mɨpaɨ putaine yuta'ɨretɨ.","poem":1},{"text":"«Waɨkawa nepɨrexeiya,","poem":2},{"lineBreak":true},{"text":"waɨkawa ne'ukatewame pɨnetsi'ayeitɨa.","poem":2},{"text":"Naime nemɨrana'iwaxɨtsie xɨka xete'utixeiya","poem":1},{"text":"mana xepɨkatekaxeiya 'axamɨti'ane».","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«Ne Yawé nekanihɨkɨtɨni 'akakaɨyari","poem":1},{"text":"'Ekipitu pe'uyeikakaku paitɨ,","poem":2},{"text":"nekamanakunuitɨamɨkɨ 'ixuriki kiiyarita pekanayekaimɨkɨ,","poem":1},{"text":"kepauka makumawetsie temutakaxei hepaɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne Kakaɨyari niukametemama nepɨtiwarutaxatɨa,","poem":1},{"text":"mamariwaweme 'inɨari nepɨtixe'uxeitsitɨa,","poem":2},{"lineBreak":true},{"text":"ne ne'utainekaku 'ɨxatsikɨ mepɨtexekuxaxatɨwakai».","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Karaha kiekatari 'axamekateniu'iyarini,","poem":1},{"text":"Kanahekɨakari tixaɨ pɨkarayani.","poem":2},{"text":"Kirikari paitɨ tuurutsixi mepɨwaretimawa,","poem":1},{"text":"'ayumieme mɨrayutimawatɨre tetexi kanitaxɨriexɨamɨkɨ,","poem":2},{"lineBreak":true},{"text":"'ɨtsita paitɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kakuwu kaniuyuta'una 'Arami hɨriyaritsie,","poem":1},{"text":"'Ixaheri katiniuta'uximayata muxatsi wahɨiyarikɨ","poem":2},{"lineBreak":true},{"text":"yu'ɨya 'iwanetɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Ixaheri 'Ekipitu mayewitɨkienikɨ meta mita'ɨwiyakɨ,","poem":1},{"text":"Yawé yuniukame kanenɨ'ani.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Peru 'Epɨrahini Yawé kaniuyehaxɨatɨani,","poem":1},{"text":"'ayumieme Kakaɨyari waɨkawa kaniwarutixani'erieni.","poem":2},{"text":"Hikɨ Yawé pɨrekapitɨani ke'axamɨtiuyuri,","poem":1},{"text":"kemɨtiuka'iyari mɨpaɨ katinanuyeyeimɨkɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}