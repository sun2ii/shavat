{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"HOS","translationId":"hch_wb2","name":"'Utseyaxi","commonName":"'Utseyaxi","title":"'Utseyaxi","order":28,"numberOfChapters":14,"sha256":"5d20814b36906a41cfbeaaf6b3581b6f95cf84730e831891293dde138b5812f3","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/hch_wb2/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":13,"content":[{"type":"heading","content":["Yawé 'Ixaheri hetsiemieme kemɨtiuyeha'a"]},{"type":"verse","number":1,"content":[{"text":"'Epɨrahini pɨmariwekai 'ixaheritsixi wahɨxie.","poem":1},{"text":"Kepauka mɨtikuxatakai teɨteri mepɨmamakai me'i'enietɨ.","poem":2},{"text":"Peru mɨkɨ Wahari hayexeiyatɨ patɨa,","poem":1},{"text":"'ayumieme 'axamɨti'anekɨ kaniumɨni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hikɨ yaxeikɨa 'axapɨtiyuriene,","poem":1},{"text":"mɨkɨ katiniyuwewirieka kemɨtiyukɨhɨawe,","poem":2},{"text":"kakaɨyarixi pɨratakɨ pɨtiwawewie, kakaɨyarixi memɨkwaniyarietɨka,","poem":1},{"text":"mamakɨ memɨwewiyatɨka.","poem":2},{"text":"Wahepaɨtsita meputiyuane:","poem":1},{"text":"«Teɨteri mepɨtewamawirie","poem":2},{"lineBreak":true},{"text":"meta mepɨwati'itsewe tsikerutsixi wahepaɨ me'aneneme».","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Ayumieme hai ximeri mieme hepaɨ me'anenetɨ mepakɨne,","poem":1},{"text":"haɨtsi ximeri paitɨ manuku'eke hepaɨ,","poem":2},{"text":"xatsi 'eka mei'enitsitɨwa hepaɨ,","poem":1},{"text":"kɨtsi huxunuta matineika hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«Peru ne Yawé 'akakaɨyari nekanihɨkɨtɨni,","poem":1},{"text":"'Ekipitu paitɨ pe'uyeikakaku.","poem":2},{"text":"'Ayumieme tawarita xeime Kakaɨyari pepɨkahetimani ne xeikɨa,","poem":1},{"text":"nixeime 'awikweitsitɨwame pepɨkakaxeiya ne xeikɨa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne nepɨyɨanekai makumawetsie nemɨmatsihetima,","poem":1},{"text":"mɨkahakawiwiye makuwakitsie.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne nepɨtixe'umi xeme xeputihuxai,","poem":1},{"text":"peru xehuxatɨ xepuyuti'ɨrixɨ","poem":2},{"lineBreak":true},{"text":"meta xepɨnetsihatɨmai.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Ayumieme ne wakɨmana maye nepayani,","poem":1},{"text":"nepɨwatihupieni huye tetsita, hatɨwe hepaɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nepɨwatakwini meta watawitsie nepɨwareuxutsixɨani","poem":1},{"text":"hutse yuniwema wakwerietɨ mɨtiyuyuruwa hepaɨ.","poem":2},{"text":"Maye hepaɨ nepɨtiwakwani.","poem":1},{"text":"Yeutanaka 'ɨtsita mɨtiyutsana hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"»'Ixaheri nepɨmatsika'una,","poem":1},{"text":"kemɨ'ane mɨmatsiparewie pemaye'uniekɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"¿Hakewa ti'a'aitɨwame,","poem":1},{"text":"para naime 'akiekarite mɨtawikweitsitɨanikɨ?","poem":2},{"text":"¿Hakewa 'a'itsɨkate pemɨwaruta'iwau:","poem":1},{"text":"“Ti'aitame meta 'itsɨkate keneneyetuiri”?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Neha'atɨ ti'aitame nemetsi yetuiri,","poem":1},{"text":"neha'atɨ nemetsi'unawairi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ke'axamɨtiuyuri 'Epɨrahini kaniuti'utsieni,","poem":1},{"text":"naitɨ paka'utɨarie ke'axamɨtiuyuri.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Ukaratsi tiniwerɨmetɨ kukuiniyaya paye'axime,","poem":1},{"text":"peru mɨkɨ nunutsi pɨkayɨkɨhɨawe:","poem":2},{"text":"kepauka maye'ani manuyeyanikɨ,","poem":1},{"text":"'aixɨa pɨkatikuyeixa mɨpaɨ kani'aneni 'Ixaheri mɨkayuwaɨriyakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"»¿Netixetawikweitsitɨani mɨkite wateukiyapa?","poem":1},{"text":"¿Ne mɨkite watsata netixe'ayehapani?","poem":2},{"text":"¿Kewari mɨya, kemɨtiyuruwa?","poem":1},{"text":"¿Kewari mɨki teukiyapa, kepemɨtiyuka'una?","poem":2},{"lineBreak":true},{"text":"Xekenahuni, ne nepɨkaxetinenimayata».","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Tsepa 'Epɨrahini rexeiyatɨ matɨa yu'iwama watsata,","poem":1},{"text":"Yawé 'ekaya kaninuamɨkɨ,","poem":2},{"text":"'eka mɨxɨka makumawetsie mieme,","poem":1},{"text":"hamuhapane meta haixate kanikawaxɨamɨkɨ.","poem":2},{"text":"Tita memɨteheuxeiya katinika'unariemɨkɨ,","poem":1},{"text":"naime tita witsiti'anenekame memɨtehexeiyakai katinikumawerimɨkɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Teɨteri Tsamariya kiekatari yuhetsie mekatenahɨakuni,","poem":1},{"text":"yukakaɨyari me'aye'unietɨ mepakɨ.","poem":2},{"text":"'Ixiparatekɨ mekanikwi'iwakuni,","poem":1},{"text":"tɨɨri mekanititetseweiyakuni kwiepa,","poem":2},{"lineBreak":true},{"text":"memayehukatɨka yuhukatsie mekaneuxitekiexɨakuni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/HOS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/HOS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/HOS/12.json","previousChapterAudioLinks":{},"numberOfVerses":16}