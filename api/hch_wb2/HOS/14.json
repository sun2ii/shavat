{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"HOS","translationId":"hch_wb2","name":"'Utseyaxi","commonName":"'Utseyaxi","title":"'Utseyaxi","order":28,"numberOfChapters":14,"sha256":"5d20814b36906a41cfbeaaf6b3581b6f95cf84730e831891293dde138b5812f3","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/hch_wb2/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"heading","content":["'Ixaheri ta'aurie kemɨrawenikekai para mɨreuyehɨwiyarienikɨ"]},{"type":"verse","number":1,"content":[{"text":"'Ixaheri, kenenua Yawé 'akakaɨyari hetsɨa.","poem":1},{"text":"Ke'axapemɨtiyuriene mɨkɨ pɨmatsihekahɨpa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Aixɨa ketineu'ahɨawi kepemɨtayɨni,","poem":1},{"text":"Yawé hetsɨa kenenua mɨpaɨ ketineutahɨawi:","poem":2},{"text":"«Ketatineuyehɨwirieka ke'axaketemɨte'uyuri,","poem":1},{"text":"'aixɨa 'anemekɨ ketaneutanaki'eri","poem":2},{"text":"mawari hepaɨ,","poem":1},{"text":"tepɨmatetaxatɨani.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Atsiriya pɨkatatsitawikweitsitɨani,","poem":1},{"text":"kawayutsixi kuyaxa miemete wahetsie tepɨka'anutiyaxe.","poem":2},{"text":"Tawariri tepɨka'itaterɨwani “'ekɨ takakaɨyari pepɨhɨkɨ”","poem":1},{"text":"tixaɨtɨ tamamakɨ tiwewiyakame tepɨkate'ayexeiya,","poem":2},{"lineBreak":true},{"text":"'ahetsie nutui pikaxeiya kepemɨti'akanenimaya».","poem":2}]},{"type":"heading","content":["Kakaɨyari kemɨtiwaruta'ei"]},{"type":"verse","number":4,"content":[{"text":"«Ne ke'axamemɨte'uyuri 'aixɨa nepɨwayurieni","poem":1},{"text":"nepɨwanaki'erieka 'aixɨa 'anemekɨ,","poem":2},{"lineBreak":true},{"text":"kenemɨtiha'akai wahetsiemieme nepɨtiuhayewaxɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne wiyeri hepaɨ nepɨ'aneni 'Ixaheri hetsiemieme,","poem":1},{"text":"yanepɨtiyurieni mɨkaxutunikɨ texuxuri tuturiyari hatetsita mieme hepaɨ.","poem":2},{"lineBreak":true},{"text":"Nanayari tetɨata paitɨ ratiwiwiyame nepayeitɨani Riwanu kɨyeyari hepaɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yɨrariyari waɨkawa pɨtiwawere,","poem":1},{"text":"huriwu kemɨtimamariwawe mɨpaɨ pɨtipapare","poem":2},{"lineBreak":true},{"text":"meta witsimu'ɨa kariuxa Riwanu mieme hepaɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne'etɨritɨa mepuyutikiitɨani,","poem":1},{"text":"mepɨtiwawere tɨriku hepaɨ.","poem":2},{"text":"Mepɨkayɨyɨrani kaxie hepaɨ,","poem":1},{"text":"mepukuxaxatsiwani winu Riwanu mieme hepaɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Neuxei 'Epɨrahini, kakaɨyarixi wa'ɨkiyari tixaɨtɨ pɨkatihɨkɨ.","poem":1},{"text":"Ne nemetsiku'eiya nekanihɨkɨtɨni meta nemetsi'ɨwiya.","poem":2},{"text":"Huku kɨyeyari yamɨtitsiɨraɨye nekanihɨkɨtɨni,","poem":1},{"text":"kepemɨtiutixuxuawere ne nekatiniyurieneni».","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kemɨ'ane mɨtimaiwe kaneitimaitɨyeikani,","poem":1},{"text":"kemɨ'ane waɨkawa mɨtiuyemate.","poem":2},{"text":"Kaniyuritɨni Yawé huyeya kanixeuraɨyeni,","poem":1},{"text":"mɨkɨ 'utɨma mekaniuhuni heitserie memexeiya,","poem":2},{"lineBreak":true},{"text":"peru kemɨ'ane 'axamemɨteyurie mekanetiketamɨrikeni meteyukahiwe'erietɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":9}