{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"HOS","translationId":"hch_wb2","name":"'Utseyaxi","commonName":"'Utseyaxi","title":"'Utseyaxi","order":28,"numberOfChapters":14,"sha256":"5d20814b36906a41cfbeaaf6b3581b6f95cf84730e831891293dde138b5812f3","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/hch_wb2/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["»Kepauka memɨ'axɨani xe'iwama 'ukitsi mɨpaɨ xeketeniwaruterɨwa: Hami, taniukikɨ manuyɨne “Mepɨneteɨterimari”. Meta 'ukari Xuhama, taniukikɨ manuyɨne “Nepitinenimayatari”."]},{"type":"heading","content":["'Ixaheritsixi kememɨtekwinitɨariekai meta kememɨte'utinenimayatsie"]},{"type":"verse","number":2,"content":[{"text":"»Peru hikɨ yumaama hetsie xeketeneuhɨpani,","poem":1},{"text":"mɨkɨri hikɨ pɨkane'ɨya neta nepɨkakɨnaya.","poem":2},{"text":"Yuhɨxie mayuyewirie witsimɨtixeiyariekakɨ ke'ayuye'itieni 'axamɨtiuka'iyarikɨ,","poem":1},{"text":"meta yutawie kemɨratikuka ketiuhayewa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ya mɨpaɨ pɨkatiuyuri, ne naime nekatininawairiemɨkɨ,","poem":1},{"text":"ke'anetɨ mutinuiwaxɨ mɨpaɨ 'anekame nekanihayewamɨkɨ.","poem":2},{"text":"Makuwakitsie nekanihɨamɨkɨ.","poem":1},{"text":"Kwiepa tixaɨtɨ mɨkaraxuawe nenihayewamɨkɨ, yeharimɨnetɨ kanimɨmɨkɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Niwemama nepɨkawatinenimayata,","poem":1},{"lineBreak":true},{"text":"'axamɨtiyuriene hetsie memɨmiemetekɨ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wamaama tuminikɨ muyuwitɨnɨa kanihɨkɨtɨni,","poem":1},{"text":"Mɨwarutiniwexɨ ka'uyukatewiyatɨ.","poem":2},{"text":"Mɨpaɨ kaniutayɨni: “Netuxexerima wahamatɨa nepukuyeikani,","poem":1},{"text":"memɨnetemikwa memɨnetsiharitɨa,","poem":2},{"lineBreak":true},{"text":"muxa huxarieya, rinu 'ixurikiyari, nehatseiti meta tita nemɨranuye'e”.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Ayumieme ne huyetana nepɨranutanani xuyakɨ,","poem":1},{"text":"muwa xeikɨa nepiyenaka huye mɨkataxeiyakɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Waɨkawa tiuka'eniwatɨ yutuxexerima pɨwakuwauneni,","poem":1},{"text":"kawataxeiyame mɨpaɨ pɨtayɨni:","poem":2},{"text":"“Nekɨna matɨari nemitiwitɨ hetsɨa nepɨnuanikeyu,","poem":1},{"text":"matsi meripaitɨ 'aixɨa nepɨtixeiyariekai keyuri hikɨ”.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mɨkɨ mɨpaɨ pɨkaretimaiwe kename ne nehɨkɨ nemɨtimikwa,","poem":1},{"lineBreak":true},{"text":"kaxie winuyari mɨhekwa meta hatseiti nemɨtiyetuirie.","poem":1},{"text":"Ne waɨkawa nepɨtimɨiririe pɨrata meta huru,","poem":2},{"text":"¿ketiuyuri kɨmana? Memɨkayuri kakaɨyarixi pɨwarutiwewi.","poem":1},{"noteId":0}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"»'Ayumieme kepauka tukarieya maye'ani","poem":1},{"lineBreak":true},{"text":"ne tɨriku nepinawairieni kaxie winuyari mɨhekwa.","poem":1},{"text":"Muxa kaheuhuxakame nepɨhayewa meta rinu 'ixurikiyari kahexeiyame","poem":2},{"text":"nemɨtiyetuiriekai mawekaku kɨmana meuyukunakakɨ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nepitewiyatsitɨani mɨirikɨa","poem":1},{"lineBreak":true},{"text":"tuxexerimama me'ixeiyakaku,","poem":1},{"text":"nixewitɨ pɨkayɨweni hetsiena mutanuani.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Naitɨ mana pɨtiuye'atɨyani 'ixɨarari temawierikayari kemɨtiwewiekai.","poem":1},{"lineBreak":true},{"text":"Meta kemɨtikuyeikakai metseri xikɨraɨyekaku,","poem":1},{"text":"meta kepauka muka'uxipiwekai meta 'ixɨarari kemɨtiutiwewiwakai xeiwiyari 'aye'axekaku.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kaxie haraweriyari kemɨrexeiyakai meta piní,","poem":1},{"text":"kename mɨkɨ tuxexerimama mete'iyetuiriekai.","poem":2},{"text":"Maku'ɨtsiya nepayeitɨani,","poem":1},{"text":"yeuta memɨte'u'uwa mekanitikwaikuni xeikɨa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nepɨtikwinitɨani mɨkɨ tukaritsie","poem":1},{"text":"hipame kakaɨyarixi mɨtiwarutimawiriwakaikɨ,","poem":2},{"text":"kepauka witsitiyukukemaritɨwatɨ nakɨtsatekɨ meta kukakɨ","poem":1},{"text":"ne kanetsiha'eriwatɨ, yutuxexerima wa'utɨma xeikɨa peyeikakai","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"»'Ayumieme hikɨ nekatini'irɨwiyamɨkɨ:","poem":1},{"text":"makumawetsie nekanenuwitɨmɨkɨ","poem":2},{"lineBreak":true},{"text":"mana witsi'anekamekɨ nekaneitahɨawimɨkɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Ana nekaniyetɨiriemɨkɨ kaxie haraweriyari,","poem":1},{"lineBreak":true},{"text":"mayeweritsie waɨkawa Kemɨtiuka'eniwakai","poem":1},{"text":"'aixɨa 'aneme nepayeitɨani memanukɨka Mɨnetsitakwewiekɨ.","poem":2},{"text":"Mana pɨnetsita'eiya temaikɨyari hepaɨ,","poem":1},{"text":"kepauka 'Ekipitu mayetɨatsie hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"»Yawé mɨpaɨ kanaineni: Kepauka maye'ani tukari","poem":1},{"text":"mɨpaɨ pepɨkanetiuterɨwani: “neti'aitɨwame”,","poem":2},{"lineBreak":true},{"text":"matsi pɨta: “nepɨmatsinaki'erie nekɨna”.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ne nepɨmeratɨmaiyatsitɨani tawarita pemɨkawakuxatanikɨ memɨkayuri kakaɨyarixi,","poem":1},{"text":"hatsuakuri pemɨkawatahɨawe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mɨkɨ tukaritsie tɨratu nepɨwewieni","poem":1},{"text":"Yeutari wahamatɨa,","poem":2},{"text":"muyuawitsie memɨte'uwɨtɨkɨka wahamatɨa","poem":1},{"text":"kwiepa memɨteku'ɨretɨwe wahamatɨa.","poem":2},{"text":"Kiekari mukumanetsie tupi nepɨwanawairieni, 'ixipara, kuyaxi meta","poem":1},{"text":"para 'aixɨa 'anemekɨ xemu'uwanikɨ yunaitɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ne ne'ɨya nematsi'ayeitɨani yuheyemekɨ,","poem":1},{"text":"nematsi'awitɨkɨni heitseriemekɨ 'aixɨa 'iyari,","poem":2},{"lineBreak":true},{"text":"teyunaki'erietɨ teteheuyuyehɨwirietɨ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Pepɨnetsihetimani heitseriemekɨ kenemɨtiuka'iyari hatsuaku nepɨkamatsiku'eirieni,","poem":1},{"text":"hikɨ 'ana Yawé pekanetimaimɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"»Yawé mɨpaɨ kanaineni: Mɨkɨ tukaritsie ne yanepɨtikamieni,","poem":1},{"lineBreak":true},{"text":"ne muyuawitsie paitɨ nepɨxeku'eiyani,","poem":1},{"text":"meta muyuawi kwie pɨ'enieka,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kwieta 'imɨari pɨxuaweriyani,","poem":1},{"text":"kaxie winuyari mɨhekwa huriwa hatseitiyari meta,","poem":2},{"lineBreak":true},{"text":"mɨkɨkɨ mekaniwata'eiyakuni Ketsireri.","poem":2},{"noteId":1}]},{"type":"verse","number":23,"content":[{"text":"Ne nehetsiemieme kwiepa nepɨwaka'eni.","poem":1},{"text":"“Nepɨka'itinenimayatari” mɨkɨ wahetsiemieme nepɨwatinenimayata.","poem":2},{"text":"“Mepɨkaneteɨterimari” nepɨtiwaterɨwa, “Mepɨneteɨterimari”,","poem":1},{"text":"mɨkɨta mɨpaɨ mepɨtiyuani, “Pɨtakakaɨyari”».","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Pɨyɨwe mɨtayɨni Wahari kakaɨyarixiyari puwarutiwewi.","reference":{"chapter":2,"verse":8}},{"noteId":1,"caller":"+","text":"Ketsireritaniukikɨ paine Kakaɨyari puka'etsa.","reference":{"chapter":2,"verse":22}}]},"thisChapterLink":"/api/hch_wb2/HOS/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/HOS/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/HOS/1.json","previousChapterAudioLinks":{},"numberOfVerses":23}