{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"HOS","translationId":"hch_wb2","name":"'Utseyaxi","commonName":"'Utseyaxi","title":"'Utseyaxi","order":28,"numberOfChapters":14,"sha256":"5d20814b36906a41cfbeaaf6b3581b6f95cf84730e831891293dde138b5812f3","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/hch_wb2/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":4,"content":[{"type":"heading","content":["'Ixaheritsixi kememɨte'ayuye'unie"]},{"type":"verse","number":1,"content":[{"text":"Xekeneu'enana 'ixaheritsixi,","poem":1},{"text":"Yawé niukieya xekeneu'eni,","poem":2},{"text":"'ari Yawé yuxanetsika kanitsutɨamɨkɨ","poem":1},{"text":"mɨkɨ mana kiekatari wahetsie:","poem":2},{"lineBreak":true},{"text":"«Neteɨterima wahetsie pumawe 'aixɨa mɨti'ane meta naki'eriya mepɨkahexeiya,","poem":1},{"text":"meta Kakaɨyari mepɨkamate.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Matsi mepɨtexuaweriya 'axamɨti'ane meta 'itarika.","poem":1},{"text":"Waɨkawa mepɨtenawatɨwe, hipame wahamatɨa mepɨhitɨwe, mepɨteyumemiwa.","poem":2},{"lineBreak":true},{"text":"Xewitɨ xɨka tiuyumieni mɨkɨta xewitɨ pimieni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hikɨ 'ayumieme kwiepa pukuwani pɨkatitixuawere,","poem":1},{"text":"'anari yunaitɨ mepukwini teɨteri.","poem":2},{"text":"Yunaitɨ mepɨtekwini yeuta memɨte'u'uwa,","poem":1},{"text":"memɨte'awɨwawe meta haramaratsie memɨteye'uwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"»Xewitɨ yu'iwa pɨkaxanetani meta pɨka'itate'ani.","poem":1},{"text":"'Ateɨterima mawari wewiwame meputate'a.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tukarikɨ tɨkarikɨ mepetiketamɨrike,","poem":1},{"text":"Kakaɨyari niukametemama yaxeikɨata 'ahamatɨa mepekaxɨrɨwe,","poem":2},{"text":"'amaamari pɨka'uyeikani,","poem":1}]},{"type":"verse","number":6,"content":[{"text":"neteɨterima mepuka'unarie","poem":2},{"lineBreak":true},{"text":"'atsimekatehetimaika mepɨkwixime.","poem":2},{"lineBreak":true},{"text":"»Metsɨ pepɨka'itanaki'eri tita yuri mɨraine,","poem":1},{"text":"neta nepɨkametsinaki'erie mawari wewiwame pemɨhɨkɨtɨni.","poem":2},{"text":"Kakaɨyari niukieya pematɨmaiyaxɨkɨ,","poem":1},{"text":"netatsiere 'aniwema nekaniwaratɨmaiyamɨkɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kepauka mawari wewiwamete memɨyutimɨirixɨ,","poem":1},{"text":"matsi waɨkawa 'axamepɨteyuriekai nehetsɨa,","poem":2},{"text":"kemɨtimariwekai mekanipata","poem":1},{"text":"mepɨtewinɨarieni yuhetsiemieme.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mɨkɨ teɨteri 'axamɨti'ane mawariyari mawari wewiwamete pɨtiwa'ikwai,","poem":1},{"text":"'ayumieme mawari wewiwamete mepɨyutemamawie teɨteri 'axamemɨteyuriekɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mawari wewiwamete meta teɨteri yaxeikɨa mepɨ'anene.","poem":1},{"lineBreak":true},{"text":"'Ayumieme yanepɨtiwatawawirieni kememɨte'u'uximayataxɨ","poem":1},{"text":"meta yuxexuime yanepɨtiwapitɨani kememɨte'uyuriexɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"»Tsepa memɨte'utikwa'a peru mepauhakakwikuni,","poem":1},{"text":"tsepa tɨɨri yuwaɨkawa memɨwarayexeiyaku, peru hatsuaku mepɨkawarayexeiya,","poem":2},{"text":"Yawé memuku'eirikɨ","poem":1},{"text":"para memɨyuyetuanikɨ,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"hipame 'ukarawetsixi wahamatɨa me'ietɨwetɨ,","poem":2},{"lineBreak":true},{"text":"kaxie winuyari pɨwareuyexɨrɨwa wa'eriwametsie.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Neteɨterima kɨye kakaɨyariyari xeikɨa mepayexeiya,","poem":1},{"text":"mɨkɨ kuta kɨye tiwaku'eiya,","poem":2},{"text":"mepɨkayumaiwawe hipame 'ukarawetsixi wahamatɨa mehitɨwetɨ xeikɨa mepauyexɨrie,","poem":1},{"text":"yukakaɨyari mepuku'eiri mɨyameyɨatɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hɨrite 'amutitɨtɨtsie meta yemuritetsie","poem":1},{"text":"mana mawari taiyariyari mepɨtiwewiwa meta 'imikieri,","poem":2},{"text":"tuaxa kɨyeyaritɨa meta haramu meta xiutɨa.","poem":1},{"text":"'Ayumieme waniwema tuminikɨ memuyuwitɨnɨa mepɨhɨkɨ","poem":2},{"text":"meta wamu'e'ema hipame mepɨwakumaɨwa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Peru nepɨkawaranutaxɨrieni","poem":1},{"text":"hipame yumɨireme wahamatɨa memɨhitɨwekɨ,","poem":2},{"text":"wakɨnamata tuminikɨ","poem":1},{"text":"memuyuwitɨnɨa wahamatɨa memukahipitekɨ,","poem":2},{"text":"metatsiere 'ukitsi 'ukari mawari wewiwamete tukita wahamatɨa 'ixɨarari mepɨwewie.","poem":1},{"lineBreak":true},{"text":"'Ayumieme 'ikɨ teɨteri mɨpaɨ mepɨteka'unarieni","poem":1},{"text":"memɨka'u'enanakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"»Xɨka 'ekɨ, 'Ixaheri, mɨpaɨ peyɨaneni,","poem":1},{"text":"Kura hetsie pepɨkarahɨpani.","poem":2},{"lineBreak":true},{"text":"»Kirikari xepɨkaheuhuni Weti-'Aweni","poem":1},{"noteId":2},{"text":"tukita xepɨkaheutahakeni,","poem":1},{"text":"mɨpaɨ xepɨkahaitɨkani xeyɨhɨritɨatɨ: “Yawé 'apuyeika”.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"'Ixaheri tsikeru mɨma hepaɨ pɨ'ane.","poem":1},{"text":"Ketsɨ Yawé tiwaru'ɨwiya","poem":2},{"lineBreak":true},{"text":"yeuta 'a'uyeukaku, muxatsi wahepaɨ pɨka'ane.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"'Epɨrahini memɨkayuri kakaɨyarixi pɨwarutinɨi,","poem":1},{"text":"tsepatsɨ wahamatɨa mɨtiuyuhayewaxɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kepaukari winu memɨkahexeiya,","poem":1},{"lineBreak":true},{"text":"hipame wahamatɨa mepukahipite,","poem":1},{"text":"metatsiere te'aitamete pɨwanake 'axamɨti'ane.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"'Ayumieme haikɨri mɨtɨrɨkaɨye pɨwataxɨriexɨani,","poem":1},{"text":"mepɨyutitetewiya hipame kakaɨyarixi memɨwarayexeiyakaikɨ.","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"Weti-'Awenimanɨyɨne 'Axamɨti'ane kiita.","reference":{"chapter":4,"verse":15}}]},"thisChapterLink":"/api/hch_wb2/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}