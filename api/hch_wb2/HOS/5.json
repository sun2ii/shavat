{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"HOS","translationId":"hch_wb2","name":"'Utseyaxi","commonName":"'Utseyaxi","title":"'Utseyaxi","order":28,"numberOfChapters":14,"sha256":"5d20814b36906a41cfbeaaf6b3581b6f95cf84730e831891293dde138b5812f3","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/hch_wb2/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":5,"content":[{"type":"heading","content":["'Ixaheritsixi kememɨtekwinitɨarieni"]},{"type":"verse","number":1,"content":[{"text":"»'Ikɨ niuki xekeneu'eni xeme mawari wewiwamete.","poem":1},{"text":"Xekeneu'enana 'ixaheritsixi.","poem":2},{"text":"Xekene'enanaka ti'aitame nuiwarimama.","poem":1},{"text":"Xehetsie pɨmieme kexemɨte'anutaxɨriyani.","poem":2},{"text":"Mitsipa kiekariyaritsie xeme xekateni'irɨwiyarieka,","poem":1},{"text":"Tawuxi hɨriyaritsie winiyari 'amɨtewi xekaniutawieka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tsitihini mɨrakutewatsie putsu muwatixawa xekaniutawewieni.","poem":1},{"text":"'Ayumieme ne netinixekwinitɨaka 'aixɨa nexeyurietɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne 'Epɨrahini nekanimateni,","poem":1},{"text":"meta 'Ixaheri nepɨkahatɨmaiyawe.","poem":2},{"text":"Peru 'Epɨrahini tuminikɨ kaniyumayɨinɨaka,","poem":1},{"text":"meta 'ixaheritsixi meka'itiyatɨ mepayuyeitɨwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"»'Axakememɨteyurie pɨkawapitɨa","poem":1},{"text":"Kakaɨyari hetsɨa memɨ'axɨani,","poem":2},{"text":"mepɨkayumaiwawe 'axamemɨteyuriekɨ hipame wa'ɨitama memɨwakumaɨwakɨ","poem":1},{"text":"mepɨkayɨwawe Yawé memetimanikɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Ixaheri 'uyuta'ɨretɨ 'uxa'atɨniwarie yuhetsie pɨrahɨani.","poem":1},{"text":"'Ixaheri meta 'Epɨrahini ke'axamemɨte'uyuri yukɨmana mepekaxɨrieni,","poem":2},{"lineBreak":true},{"text":"Kura meta wahamatɨa kanekawemɨkɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yumuxatsima meta yuwakaitsixi metewara'arietɨ,","poem":1},{"text":"Yawé mekanitiwaukuni,","poem":2},{"text":"peru mepɨka'itaxeiya","poem":1},{"text":"mɨkɨ mɨwaruku'eirikɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yawé xekaniuku'eirieni,","poem":1},{"text":"yumɨiretɨ tɨɨri mekaniutinunuiwa hipame waniwema.","poem":2},{"lineBreak":true},{"text":"Hikɨ 'ayumieme xekanika'unariekuni meta naitɨ xekwie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"»Kuxineta xekenetahɨtsi Kiweya kiekariyaritsie,","poem":1},{"text":"Xamatsie paitɨ 'awa kehetahɨtsieni,","poem":2},{"text":"Weti-'Aweni meta xekenetihiwa xemɨyutakwinikɨ, mɨpaɨ mete'uhiwatɨ:","poem":1},{"text":"“Wenikamini, kene'a'ɨwiyani 'awarita”.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kepauka memɨtekwinitɨarieni,","poem":1},{"text":"'Epɨrahini yuxaɨta puyuhayewa.","poem":2},{"text":"'Ixaheri nuiwaritemama watsata","poem":1},{"text":"yanepɨtiwatahɨawe kemɨtiwayurieni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Itsɨkate te'aitamete Kura kwieyaritsie miemete","poem":1},{"text":"kwie memɨnawatɨwe wahepaɨ mepɨ'anene.","poem":2},{"text":"Wahetsie nehaxɨa nepɨtatuani","poem":1},{"text":"haa nemɨwayenetɨani hepaɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Epɨrahini 'axapɨtixeiyarie,","poem":1},{"text":"memeye'unie xeikɨa mepitsaipɨna,","poem":2},{"lineBreak":true},{"text":"memɨkayuri kakaɨyarixi mɨwaruweiyakɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"'Epɨrahini tepaxi wahepaɨ nekaniwakwimɨkɨ,","poem":1},{"text":"kɨye mɨkɨmie Kura teɨterimama mepɨhɨkɨtɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"»Kepauka 'Epɨrahini yukwiniya muxei,","poem":1},{"text":"Kura katinetimani haiyayatsie,","poem":2},{"text":"'Epɨrahini kaneyani 'Atsiriyatsie","poem":1},{"text":"mana parewiya kaniutawauni ti'aitame mɨmariwe hetsɨa.","poem":2},{"text":"Peru ti'aitame mana kiekame pɨkayɨwekai menayehɨanikɨ,","poem":1},{"text":"meta haiyaya mu'uayemani.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ne maye nepayani 'Epɨrahini hetsiemieme,","poem":1},{"text":"maye nunutsita Kura hetsiemieme.","poem":2},{"text":"Ne nekɨmana nekaniwatitsanamɨkɨ,","poem":1},{"text":"meta nekaniyemieni,","poem":2},{"text":"nemiwiyaxɨ ne'atɨtɨ,","poem":1},{"text":"nixewitɨ pɨkayɨweni mɨnetsi'unawairieni.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Ana nepakunuani nemɨra'aitatsie,","poem":1},{"text":"kepaukake mɨpaɨ memɨtehetimani kename 'axamete'uyuri.","poem":2},{"text":"Mepitiwauni kehepaɨ meyɨakaku nemɨwatanaki'erieni,","poem":1},{"text":"me'u'uxetɨ mepɨnetsitiwauni meyuwaɨriyatɨ».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}