{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"HOS","translationId":"hch_wb2","name":"'Utseyaxi","commonName":"'Utseyaxi","title":"'Utseyaxi","order":28,"numberOfChapters":14,"sha256":"5d20814b36906a41cfbeaaf6b3581b6f95cf84730e831891293dde138b5812f3","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/hch_wb2/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"heading","content":["'Ixaheritsixi me'uyu'enieka ta'aurie mekanaxɨrieni"]},{"type":"verse","number":1,"content":[{"text":"Mɨpaɨ mekaniutiyuani: Hikɨmɨtɨka Yawé hetsɨa tepɨ'axɨani.","poem":1},{"text":"Tsepa mɨkɨ mɨtatsi'utitsanaxɨ, peru 'aixɨa teteheu'eriekameta pɨtatsi'ayeitɨanita,","poem":2},{"lineBreak":true},{"text":"mɨkɨ pɨtatiukwinitɨa peru pɨtatsiti'uayemani.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Huta tukari 'anukayayu tukari pɨtatsi pitɨani,","poem":1},{"text":"hairieka tukari pɨtatsi 'anuku'uitɨani,","poem":2},{"lineBreak":true},{"text":"'ana mɨpaɨ hamatɨana tepu'uwani.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Ana Yawé tepetimani,","poem":1},{"text":"kemɨtiku'eriwa 'utɨmana tepuhuni.","poem":2},{"text":"Yurikɨ tau manatineika hepaɨ,","poem":1},{"text":"tahamatɨa matsiɨkɨtɨ payuyeitɨani,","poem":2},{"text":"tahamatɨa punuani wiyeri xexerixa mieme hepaɨ,","poem":1},{"text":"wiyeri witarita mieme hepaɨ kwie mukuhawiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«¿'Epɨrahini 'ahetsɨa kenetiyurieni?","poem":1},{"text":"¿Kura meta kenetiyurieni 'ahetsɨa?","poem":2},{"text":"Xenaki'eriya hai ximeri mieme hepaɨ pɨ'ane,","poem":1},{"text":"haɨtsi hepaɨ yapauka mɨtipaparike.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Ayumieme nepɨxeheutaxɨriexɨa Kakaɨyari niukametemama newanɨ'akaku,","poem":1},{"text":"nepɨxe'utiwa neniukikɨ.","poem":2},{"lineBreak":true},{"text":"Kenemɨtixetaxaneta mimierɨkari hepaɨ pɨxeyurieni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne naki'eriya nepɨxewawirie, mawarika pɨkatixaɨ,","poem":1},{"text":"matsi Kakaɨyari pɨta xekene'enieka mawari taiyariyari pɨkatixaɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Xeme 'Arani hepaɨ xepɨte'uyuri:","poem":1},{"text":"tɨratu ketemɨte'uwewi yaxepɨkatekakɨ,","poem":2},{"lineBreak":true},{"text":"xepɨnetsi'uku'eiri.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Karaha kiekariyari 'axamemɨte'u'iyari pɨwakiekari,","poem":1},{"text":"yu'ɨkatekɨ xeikɨa xuriya mepɨtayeuriwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mawari wewiwamete mepɨyuxeɨrie","poem":1},{"text":"Tsikeni huyeri'utɨa 'awie metanenieretɨ,","poem":2},{"text":"tenawayamete wahepaɨ","poem":1},{"text":"mekaniwakwika mana memuyekɨka metewawawirietɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Ixaheri mɨra'aitatsie","poem":1},{"text":"'axati'aneme nepɨtixeiya.","poem":2},{"text":"Mana 'Epɨrahini tuminikɨri puyumayɨinɨa","poem":1},{"text":"meta 'Ixaheri ka'itiyatɨ payuyeitɨwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"»'Ekɨtatsiere Kura,","poem":1},{"text":"'axamɨti'anekɨ pepɨka'itsana.","poem":2},{"lineBreak":true},{"text":"»Kepauka ne neteɨterima wahetsie 'aixɨa nemɨtiyurieni,","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}