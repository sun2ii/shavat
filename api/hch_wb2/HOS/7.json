{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"HOS","translationId":"hch_wb2","name":"'Utseyaxi","commonName":"'Utseyaxi","title":"'Utseyaxi","order":28,"numberOfChapters":14,"sha256":"5d20814b36906a41cfbeaaf6b3581b6f95cf84730e831891293dde138b5812f3","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/hch_wb2/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"ne kepauka 'Ixaheri nemu'uayema,","poem":2},{"text":"'Epɨrahini meta Tsamariya ke'axamemɨteyuriekai waɨkawa","poem":1},{"text":"mɨkɨ naitɨ pɨtihekɨare.","poem":2},{"text":"Mɨkɨ mepɨtewa'itaiyakai,","poem":1},{"text":"kepauka mɨtinawarienekaitsie kiita,","poem":2},{"lineBreak":true},{"text":"yumɨiretɨ kaye'utɨma mepɨtenawatɨwe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mɨpaɨ mepɨkateku'eriwani","poem":1},{"text":"ne naime nekatinimaika 'axakememɨte'u'iyari.","poem":2},{"text":"Ke'axamemɨteyurie mɨkɨ pɨwakunama,","poem":1},{"text":"ne naime nepɨtimate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"»'Axamemɨteyuriekɨ ti'aitame mepɨtemawieritɨa,","poem":1},{"text":"meta yaxeikɨa 'itsɨkate memɨtewa'itaiyakɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Huxunu muwatita'a hepaɨ mepɨ'anene","poem":1},{"text":"taitsie kɨyexi manunetɨani pɨkaheuyewetse","poem":2},{"text":"kepauka paa wewiwame harina mɨhawiya","poem":1},{"text":"kepauka 'aixɨa mɨyɨnike.","poem":2},{"lineBreak":true},{"text":"Yunaitɨ mɨpaɨ mepɨ'anene kayu'ɨitama wahamatɨa memɨhitɨwe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ti'aitame 'ixɨarari matiwewiwatsie 'itsɨkate","poem":1},{"text":"winukɨ mepɨtitarɨwewe,","poem":2},{"text":"ti'aitame pɨreuyehɨpa kemɨtimariwe","poem":1},{"text":"tɨratu wewietɨ yunaime meminanaima wahamatɨa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Huxunu hepaɨ putiutatawe wa'iyari,","poem":1},{"text":"'axamɨti'ane ti'eriyakɨ.","poem":2},{"text":"Tɨkarikɨ wahaxɨa peukukutsu,","poem":1},{"text":"ximerita panutaneniere.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yunaitɨ mɨkɨ huxunu mɨtixɨka hepaɨ mepɨtexɨxɨka,","poem":1},{"text":"wahetsɨa memɨte'aita mepɨwatakukuya.","poem":2},{"text":"Yunaime te'aitamete mepɨwaranakaxɨrɨwa,","poem":1},{"text":"peru xewitɨ mɨkɨ pɨkanetsikuwaune nemiparewienikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"»'Epɨrahini yumɨireme nuiwarite pɨwanɨ'ɨ,","poem":1},{"text":"papa tapaxeikɨa mɨwakwani hepaɨ pɨ'ane.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nuiwarite kiekatari tɨrɨkariyaya mepɨkɨme,","poem":1},{"text":"perutsɨ mɨkɨ 'atsipɨkatiyumate.","poem":2},{"text":"Kɨpateya putituxarixɨ,","poem":1},{"text":"peru mɨkɨ 'atsipɨkatimate.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mariwemekɨ 'Ixaheri pɨtihekɨata yuhepaɨtsita,","poem":1},{"text":"peru mɨkɨ Yawé yukakaɨyari hetsɨa pɨkanuawe.","poem":2},{"lineBreak":true},{"text":"Mɨyaranuyemietɨ, pɨka'ikuwaune tɨma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"»'Epɨrahini kukuru mautuxa","poem":1},{"text":"mɨkatiyu'aitɨarinɨa meta mɨkatimaiwe hepaɨ pɨ'ane,","poem":2},{"text":"heiwa parewiya puta'iwawa 'Ekipitu kwieyaritsie,","poem":1},{"text":"heiwata 'Atsiriyatsie.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Peru kepauka mɨpaɨ memɨteyurieni","poem":1},{"text":"yapauka newipi waheima nepuwiwieni,","poem":2},{"text":"wikixi wahepaɨ nepɨtiwaxɨrieni,","poem":1},{"text":"'atahutamexɨa matsi nepɨwaranutaxɨrieni 'axamemɨte'uyurikɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Xɨa'ui nepaine memɨnetsi'uku'eiri wahetsiemieme.","poem":1},{"text":"Meke'uka'unarieni nehɨxie memɨnetsi'aye'uniekai.","poem":2},{"text":"Ne yemekɨ nepɨwaranayexeiyawe,","poem":1},{"text":"peru mɨkɨ hatsuaku yuri mehaitɨkaitɨ mepɨkanetsihahɨaweni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yu'iyarikɨ mepɨkanetsihahɨawe,","poem":1},{"text":"yu'utatsie xeikɨa mekaheitɨ meputitsuana.","poem":2},{"text":"Yu'iku mekuwaunike meta yuwinu 'axa'anekɨa mekanekɨkani","poem":1},{"text":"nehepaɨtsita meheuniutɨ menakɨkani.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ne'aixɨa nepɨtiwaru'ɨkitɨa meta wamamate neputitɨrɨkariyaxɨ,","poem":1},{"text":"peru mɨkɨ 'axa xeikɨa mepɨteku'eriwakai nehepaɨtsita.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kakaɨyari 'Amutewi hetsɨa mepɨka'axɨaku,","poem":1},{"text":"tupi tiyu'irɨwiyame hepaɨ mepɨ'anene.","poem":2},{"text":"Peru wa'itsɨkate 'ixiparakɨ mepɨka'unarieni","poem":1},{"text":"waniuki 'axamanuyɨnekɨ,","poem":2},{"text":"meta 'Ekipitu kiekatari","poem":1},{"text":"mepuwatinanaimani.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/HOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/HOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}