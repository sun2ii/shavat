{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"HOS","translationId":"hch_wb2","name":"'Utseyaxi","commonName":"'Utseyaxi","title":"'Utseyaxi","order":28,"numberOfChapters":14,"sha256":"5d20814b36906a41cfbeaaf6b3581b6f95cf84730e831891293dde138b5812f3","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/hch_wb2/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"heading","content":["'Eka xekeneuka'etsa meta haikɨri 'amɨpa xepɨka'itsana"]},{"type":"verse","number":1,"content":[{"text":"»Kuxineta keneutahɨtsiri 'inɨari mayanikɨ.","poem":1},{"text":"Kwixɨ hepaɨ 'akanamieni mɨkɨ waneɨkixiwi Yawé teɨterimama wahetsɨa.","poem":2},{"text":"Tɨratu ketemɨte'uwewi mɨkɨtsie yamepɨkatekakɨ","poem":1},{"text":"meta ne'inɨari niukiyari mɨkɨ mepuku'eiri,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"hikɨta mɨyamenetekɨhɨawe:","poem":1},{"text":"“'Ixaheri Kakaɨyarieya tepɨmatsimate”.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Peru 'Ixaheri 'aixɨa mɨti'ane pɨkatinaki'erie,","poem":1},{"text":"'ayumieme xewitɨ waneɨkixiwi pɨwaranukuweiya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yɨkɨmana mepɨwaranuka'uitɨwa te'aitamete ne yanekahainekaku,","poem":1},{"text":"hipame 'itsɨkate mepɨwaranuka'uitɨwa nemɨkawamate.","poem":2},{"text":"Pɨratakɨ meta hurukɨ yukakaɨyarixi memɨwatiwewiwa","poem":1},{"text":"para mɨkɨkɨ memuyuka'unakɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tsamariya kiekatari tsikeru","poem":1},{"text":"kakaɨyariyari xemayexeiya xekeneuku'eiri.","poem":2},{"text":"Xehetsiemieme ne nepuyeha'a.","poem":1},{"text":"'Atsitake kepauka xeyu'itietɨ xemakɨne.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Neuxei keneu'ena 'Ixaheri: Mɨkɨ tsikeru Kakaɨyari pɨkahɨkɨ,","poem":1},{"text":"mɨkɨ tewi pɨwewiyaya.","poem":2},{"text":"Mɨkɨ tsikeru Tsamariya mieme","poem":1},{"text":"kanitatarariemɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"»'Eka xepuka'e,","poem":1},{"text":"haikɨri 'amɨpa xepɨka'itsana.","poem":2},{"text":"Tɨriku kɨyeyari yumɨayeyari pɨkahexeiya","poem":1},{"text":"tɨriku pɨkatixuawere.","poem":2},{"text":"Xɨka 'utixuawere,","poem":1},{"text":"teewatari kɨkamete mepitikwani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Metsɨ 'Ixaheri kananukaxɨwieni,","poem":1},{"text":"hikɨri 'etsiwa xeikɨa nuiwarite mepɨmetsinaki'erie.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Ixaheritsixi mekanekɨne 'Atsiriya paitɨ,","poem":1},{"text":"mekaniuyupata puxuri yeutari memɨkaheu'enana wahepaɨ,","poem":2},{"lineBreak":true},{"text":"meta 'Epɨrahini yutuxexerima katiniwayetuiriwakaitɨni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tsepa nuiwarite watsata naitsarie mɨwananene,","poem":1},{"text":"ne mana neniwakuxeɨrimɨkɨ,","poem":2},{"text":"'ana mekatenita'aitɨariekuni","poem":1},{"text":"xewitɨ ti'aitame waɨkawa mariwemekɨ katiniwata'aitɨamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"»'Epɨrahini waɨkawa mawarite taiyame kaniutiwewieni,","poem":1},{"text":"para 'axamɨti'anekɨ memɨteheuyehɨwiyariekakɨ,","poem":2},{"text":"peru mɨkɨ mawarite taiyame","poem":1},{"text":"'axamemɨteyuriekakɨ pɨta patɨa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne nepeka'utɨawe ne'aitsika waɨkawamexɨa,","poem":1},{"text":"peru mɨkɨ memɨka'imateni hepaɨ mepɨte'ixeiya.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mepɨnetemawirie mawari taiyariyarikɨ meta 'imikierite, waiyari mekwatɨ,","poem":1},{"text":"ne mɨkɨ pɨkanetsinake.","poem":2},{"text":"Hikɨ ne ke'axamemɨteyurie naime nepɨkaratɨmaiya,","poem":1},{"text":"ke'axamemɨte'uyurikɨ mɨkɨkɨ nepɨwaranutaxɨrieni,","poem":2},{"lineBreak":true},{"text":"mekanakunuaxɨakuni 'Ekipitu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Ixaheri kemɨ'ane mitawewi patɨmai, meta yɨkɨmana paratsiyute puyutiwewiri,","poem":1},{"text":"meta Kura kiekaritetsie waɨkawa kuraru 'amatitetewa kanawewietɨyani,","poem":2},{"text":"peru ne wakiekarite 'aixɨa mɨreukunatɨkatsie","poem":1},{"text":"tai nepaukaxɨriexɨani mɨwatixɨtsitɨanikɨ».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}