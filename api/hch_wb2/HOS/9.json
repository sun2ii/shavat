{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"HOS","translationId":"hch_wb2","name":"'Utseyaxi","commonName":"'Utseyaxi","title":"'Utseyaxi","order":28,"numberOfChapters":14,"sha256":"5d20814b36906a41cfbeaaf6b3581b6f95cf84730e831891293dde138b5812f3","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/hch_wb2/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"heading","content":["'Ixaheri 'uximatɨarika kemɨtipitɨarieni"]},{"type":"verse","number":1,"content":[{"text":"Merikɨte 'Ixaheri, pepɨka'atemawieka,","poem":1},{"text":"'ixɨarari pepɨkawewieka nuiwarite wahepaɨ.","poem":2},{"text":"'Axapekatiniuyurieni:","poem":1},{"text":"'Akakaɨyari pekaniuku'eirieni.","poem":2},{"text":"Tɨriku tuminiyari kepaɨmeme pemukaxexeiya kakaɨyarixi pepuwayetuiriwa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tɨriku meta kaxie takari pɨkatixuawere,","poem":1},{"text":"ni winu mɨhekwa pumaweni 'aixɨa ha'anetɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yawé kwieyatsie xepɨka'u'uwaniri,","poem":1},{"text":"'Epɨrahini 'Ekipitu kanakunuamɨkɨ","poem":2},{"lineBreak":true},{"text":"meta 'Atsiriya timieme mɨkati'itiya pepɨtitikwani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tawariri Yawé winu xepɨkayetuirieni,","poem":1},{"text":"mɨkɨri pɨka'inakeni xemawarika.","poem":2},{"text":"Mɨkɨ paa pɨkaxetanaki'eririeni, 'ayumieme xepɨtitsuani,","poem":1},{"text":"kemɨ'ane memitikwani mɨkɨ meka'itiyatɨ mepakɨne.","poem":2},{"text":"Haaka nunuitɨwame xeikɨa pɨhɨkɨ,","poem":1},{"text":"peru Yawé yutukita pɨka'inaki'erie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¿Kexeteyurieni 'ixɨarari matineikatsie,","poem":1},{"text":"yatɨni Yawé hetsiemieme waɨkawa kɨkamete xemuyukuxexeɨriwatsie?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tsepa xemuyuta'unaxɨ xemɨka'unarienitsie,","poem":1},{"text":"'ekipitutari mepɨxetiwiya, Menipitsi kiekariyaritsie mepɨxekateuku.","poem":2},{"text":"Witsimɨti'anene xemɨtehexeiya pɨratakɨ, mɨtiwewiyatɨka tupiriyatsata pɨtiyuhayewa,","poem":1},{"text":"xexamaru xuya penukanani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Uximatɨarika tukariyari paye'ari,","poem":1},{"text":"meta tukari paye'a memɨte'ayukatuanikɨ.","poem":2},{"lineBreak":true},{"text":"'Ixaheri mɨpaɨ ketinemaika","poem":2},{"text":"'Ariri pɨwaɨkawa 'axakepemɨtiuyuri,","poem":1},{"text":"mɨixari pepɨkaheu'ena,","poem":2},{"text":"Kakaɨyari niukameya mɨka'uka'iyari xeikɨa pepɨxata,","poem":1},{"text":"tewi Kakaɨyari 'iyarieya mɨkahexeiya pɨkaheyuta'eriwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kakaɨyari meta niukameya,","poem":1},{"text":"'Epɨrahini mɨtaniere kanihɨkɨtɨni,","poem":2},{"text":"peru naitsarie huyeta pepiwiniyane,","poem":1},{"text":"pepitixani'eri Kakaɨyari kiitana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kemɨkatiheitserie xeteyurietɨ 'ari xepakɨ,","poem":1},{"text":"Kiweya mɨtiuyɨ hepaɨ,","poem":2},{"text":"Peru Kakaɨyari pɨkaratɨmaiya waɨkawa kexemɨte'uyuri","poem":1},{"text":"'uximatɨarika pɨxepitɨani 'axaxemɨte'uyurikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mɨpaɨ kanaineni Yawé: «Kepauka 'Ixaheri nemutaxei,","poem":1},{"text":"makumawetsie kaxie takari nemutaxeiya hepaɨ nepuyɨ,","poem":2},{"text":"kepauka 'atutsima nemɨwaruxei meripai miemete,","poem":1},{"text":"xapa takari yɨyɨrime nemuxeiya hepaɨ nepuyɨ.","poem":2},{"text":"Peru mɨkɨ mepekɨ Wahari-Pehuxi kakaɨyariyari hetsɨa,","poem":1},{"text":"mepɨnetsi'uku'eiri, tewiyarikatsie mepuyuyetua,","poem":2},{"text":"'anari wahepaɨ 'axame'anenetɨ mepakɨ","poem":1},{"text":"menaki'eriwatɨ hepaɨna.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Epɨrahini kemɨrexeiyakai 'aixɨa ti'anekame, mɨkɨri kanitawimɨkɨ wiki hepaɨ kanayeyeimɨkɨ,","poem":1},{"text":"'anari 'aniwema mepɨkatinunuiwa meta 'ukari mepɨkatihukataxɨani.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tsepa tɨɨri memɨwaxeiya hipame mewawereme,","poem":1},{"text":"ne nepɨwarakuyeitɨani 'ena kwiepa.","poem":2},{"lineBreak":true},{"text":"Xɨa'ui kepauka mɨkɨ memɨxeku'eirieni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Epɨrahini mɨpaɨ nepɨtixeiya, Tiru kwieyari hepaɨ witsimɨraku'anetsie mɨye'etsieka hepaɨ.","poem":1},{"text":"Peru 'Epɨrahini pɨwayetuaya yuniwema memɨkwi'iwakɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Neuxei Yawé, ¿Ketita petiwayetuirieni?","poem":1},{"text":"'Uka 'anuye'ikwitɨwame meta tsitsi ka'ayemaneme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«Kirikari mepikatsutɨa 'axameteyurietɨ,","poem":1},{"text":"mana nepikatsutɨa newa'uxiwe'erietɨ.","poem":2},{"text":"'Axameteyuriekaku,","poem":1},{"text":"nekiita nepɨwaranuyexɨrieni.","poem":2},{"text":"Ne nepɨkawatanaki'erieniri,","poem":1},{"text":"yunaitɨ wa'itsɨkate 'axamemɨteyuriekɨ meteyukahiwe'erietɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"'Epɨrahini kaniutayɨnare:","poem":1},{"text":"nanari kaniutiwani takari pɨka'ukayaxixɨ.","poem":2},{"text":"Tsepa mutiutihukataxɨ,","poem":1},{"text":"nekanenuyemiemɨkɨ nunutsi tsepa witsimɨ'ane».","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Xemɨkahenu'enikɨ, 'ayumieme ne Kakaɨyari pɨkaxetanaki'erieni,","poem":1},{"text":"kɨkamete xepakɨne nuiwarite watsata.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}