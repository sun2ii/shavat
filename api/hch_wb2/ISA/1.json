{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Kemɨtiunierixɨ Kitsariyaxi 'Amuxi nu'aya Kura nuiwariyari hepaɨtsita meta Kerutsareme, 'Utsiyaxi, Kutani, 'Akatsi meta 'Etsekiyaxi, Kura kwieyaritsie te'aitamete mete'aitakaku."]},{"type":"heading","content":["Kura, nuiwari mɨkaheu'ena"]},{"type":"verse","number":2,"content":[{"text":"Muyuawi, xekeneu'enana. Kwie, meta keneu'ena.","poem":1},{"text":"Yawé mɨpaɨ kanaineni:","poem":2},{"text":"«Ne tɨɨri nekaniwarutiwaweriya 'ameyumateme nekaniwarayeitɨani,","poem":1},{"text":"peru mɨkɨ menetsi'aye'unietɨ mekanakɨne.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tuuru kwietsaname yukutsiyari kanimateni","poem":1},{"text":"meta puxu kanemarieka hakewa kutsiyarieya mɨreitimikwa,","poem":2},{"text":"peru 'ixaheritsixi mɨpaɨ mepɨkatemate,","poem":1},{"text":"neteɨterima mepɨkaheu'enana».","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Xɨa'ui nuiwari 'axateyuruwamete,","poem":1},{"text":"teɨteri xehetsie mɨrahɨiwa,","poem":2},{"text":"'axateyuruwamete nuiwariyari,","poem":1},{"text":"tɨɨri heitseriemekɨ yaxemɨkateyurie.","poem":2},{"text":"Yawé xekaniuku'eirieni.","poem":1},{"text":"Mɨpatsie 'Ixaheri hetsiemieme tixaɨtɨ tihɨkɨtɨme xepɨka'ayeitɨa.","poem":2},{"lineBreak":true},{"text":"Yu'ɨtɨma xekanekɨne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¿Ketitayari tawarita xetetiweiwani?","poem":1},{"text":"¿Ketitayari xete'iyeweiyani xe'eye'unietɨ?","poem":2},{"text":"Naitɨri'amu'u kaniweiyaka,","poem":1},{"text":"naitɨri 'a'iyari katinikuyeni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xeketatetsie tsutɨtɨ xeyekɨrita paitɨ ye'atɨ","poem":1},{"text":"naitsarie xepɨteheukukuye:","poem":2},{"text":"mɨkɨ naimetsie xepeukuweiyatɨka, xepeukuyuyuawi,","poem":1},{"text":"meta haiya hayepietɨkaime xepexeiya,","poem":2},{"text":"nixewitɨ pɨkaxeti'uayemawe meta pɨkaxe'anakɨhɨaxɨawe,","poem":1},{"text":"nixewitɨ hatseitikɨ pɨkaxeka'uayemawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Xekwieyaritsie kanakumaweni,","poem":1},{"text":"kiekariteya tai harakunayari kanihɨkɨtɨkani,","poem":2},{"text":"metanenierekakutɨtɨ","poem":1},{"text":"kɨkamete wa'etsarita timieme mekateniukaxɨrɨwani,","poem":2},{"text":"wakwie kanakumaweni,","poem":1},{"text":"'ateewa kiekatari memɨwaruka'una hepaɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tsiyuni witsimɨti'ɨimari","poem":1},{"text":"xamaru 'ewiweme harawerita mieme hepaɨ kaniuyɨni,","poem":2},{"text":"pinixi ma'etsietsie 'etɨpiweme hepaɨ kaniuyɨni,","poem":1},{"text":"kiekari manutinamieka hepaɨ kani'aneni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Xɨka Yawé Naimekɨmɨtɨrɨkaɨye","poem":1},{"text":"hipame kawaruhayewake me'ayeneniereme,","poem":2},{"text":"hikɨ xɨari Tsuruma hepaɨ pɨraku'anenike,","poem":1},{"text":"meta xɨari Kumuxa hepaɨ tepauyewenike.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yawé niukieya xekeneu'eni,","poem":1},{"text":"xeme Tsuruma hetsie xemɨte'aita.","poem":2},{"text":"Xekeneu'eni takakaɨyari 'ɨkitɨarikaya,","poem":1},{"text":"Kumuxa kiekatari.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yawé mɨpaɨ kanaineni:","poem":1},{"text":"«Tixaɨtɨ pɨkatihɨkɨ waɨkawa memɨnetemawirie.","poem":2},{"text":"Muxatsi 'ukitsi wamawari taiyarikakɨ 'ari nepɨwaɨripieri","poem":1},{"text":"meta tewaxi memɨwaiyatɨka wawiyayarikɨ,","poem":2},{"text":"tuurutsixi, muxatsi meta tsipuri","poem":1},{"text":"waxuriya pɨkanetsinake.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"¿Titayari nehɨxie xete'axe?","poem":1},{"text":"¿Kemɨ'ane pɨxe'uta'aitɨa tewaxi","poem":2},{"lineBreak":true},{"text":"xemɨwa'atɨwanikɨ netuki takwa memɨte'akuketsinanikɨ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Xepɨkanetsi'atɨiriwaniri mawari tixaɨtɨ mɨkatihɨkɨ,","poem":1},{"text":"'ɨkwa witsimu'ɨa nekanixani'erieka.","poem":2},{"text":"Metsa manatiwenitsie, 'uxipiya tukari, mɨrayutixexeɨritɨretsie,","poem":1},{"text":"nepɨkayɨweri nemɨtinewieka yakɨ xeikɨa kememɨnete'ayexeiya.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Metsa 'ixɨarariyari meta wa'ixɨarari naime ne nepɨxani'erie,","poem":1},{"text":"xekaneniuti'ikatɨani","poem":2},{"lineBreak":true},{"text":"netinewietɨri nepu'uxe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kepauka teikɨ xemememe,","poem":1},{"text":"ne nepɨkaxexeiyaniri,","poem":2},{"text":"tsepanetɨ yunenewieri xemɨmɨiriya,","poem":1},{"text":"ne nepɨka'i'enieni,","poem":2},{"lineBreak":true},{"text":"yumamatetsie naitɨ xemeuxuxurekɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Xekeneuyuhauxixɨa, xekeneuyu'itiexɨa.","poem":1},{"text":"Nehɨxieri 'axaxepɨkateyurieka.","poem":2},{"text":"'Axaxeteyurietɨ xeketeneuhayewa.","poem":1}]},{"type":"verse","number":17,"content":[{"text":"'Aixɨa mɨti'ane pɨta xeketenemaika.","poem":2},{"text":"Mɨtiheitserie xekeneutiwawa, mɨtiuyukananaima xekeneutati'a.","poem":1},{"text":"Nutui hetsiemieme xekeneutaniu meta wiura hetsie xekenenuaka».","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Yawé mɨpaɨ kanaineni:","poem":1},{"text":"«Xekenakɨni, 'aixɨa tepɨtayurieni 'ahekɨakamekɨ,","poem":2},{"text":"¿'Axakexemɨteyuriekɨ xuriya muweka hepaɨ ti'ane?","poem":1},{"text":"'Ɨwi hepaɨ tituxatɨ kanayeimɨkɨ.","poem":2},{"text":"¿'Axakexemɨteyuriekɨ tixeta mɨyɨtsikimaɨyeni hepaɨ?","poem":1},{"text":"Muxa huxarieya mutuxa hepaɨ kaniyɨmɨkɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Xɨka xeme xeyuwaɨriyani yaxemɨtekakɨnekɨ,","poem":1},{"text":"kwiepa timieme 'aixɨa mɨti'anene xekatenikwakakuni.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Xɨka xekayuwaɨriyani meta 'akuxi xeheye'unieka.","poem":1},{"text":"'Ixiparakɨ xekanikwi'iwakuni».","poem":2},"Yawé mɨpaɨ kaniutayuni."]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kiekari pemɨkawatayuanekai hikɨri xeime hamatɨa tuminikɨ pepukahupu.","poem":1},{"text":"Meripaitɨ 'aixɨa ti'aneme waɨkawa pepɨrexeiyakai.","poem":2},{"text":"Mɨtiheitserie hetsiena puyuhayewakai,","poem":1},{"text":"hikɨ matsi teyumiekate xeikɨa mepuyuhayewatɨwe.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"'Apɨrata temɨxikitɨ kanayani,","poem":1},{"text":"'akaxie winuyari 'aixɨa ma'ane, haa kanayani.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Te'aitamete 'ahetsɨa miemete mepunetsi'aye'unie,","poem":1},{"text":"tenawayamete mepuwa'iwama,","poem":2},{"text":"yunaitɨ 'itarikakɨ metekuxatatɨ memɨtepitɨariekakɨ mepɨnaki'erie","poem":1},{"text":"tixaɨtɨ xeikɨa mepɨte'iwaku.","poem":2},{"text":"Nutui hetsiemieme mepɨkahaniutɨka,","poem":1},{"text":"meta wiura hetsiemieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"'Ayumieme Ti'aitame mɨpaɨ kanaineni,","poem":1},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye, mɨtɨrɨkaɨye 'Ixaheri hetsiemieme:","poem":2},{"text":"«Kenemɨtiha'akɨ yanepɨtiyurieni memɨnetsi'aye'unie wahetsie,","poem":1},{"text":"nekatiniwarakapitɨamɨkɨ mɨkɨ kememɨnetsi'uyuri.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Tawarita netɨrɨkariya xehetsie nepɨtatuani,","poem":1},{"text":"temɨxikiyari xapunikɨ nepuku'itieni","poem":2},{"lineBreak":true},{"text":"meta naime nekanakuyeitɨamɨkɨ titakɨ pemɨkati'itiyakaikɨ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"'A'itsɨkate 'aixɨa nekaniwatiyurimɨkɨ matɨari hepaɨ,","poem":1},{"text":"meta 'a'ɨxatsitɨwamete matɨari hepaɨ.","poem":2},{"text":"Hikɨ 'ana “Kiekari heitserie mexeiya” pekatinitewakamɨkɨ,","poem":1},{"text":"“Kiekari mɨkawatayuitɨariwa”».","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Tsiyuni pɨnanaiyani mɨtawikweitsitɨarienikɨ tika'eniexɨame,","poem":1},{"text":"meta tita mɨtiheitseriekɨ, kemɨ'ane mɨtihayewa 'axatiyurienetɨ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Peru kemɨ'ane memɨkayuwaɨriya meta 'axamemɨteyurie mekanikumaweriyariekuni,","poem":1},{"text":"meta mekanikwikuni kemɨ'ane Yawé memuku'eirieni.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Xekanititewiyakuni xiu kɨyeyari kwinimieme xemɨtenaki'erie,","poem":1},{"text":"tuturite muwa'iteɨtsietsie memenayexei wahetsiemieme tewiyarika katinayeimɨkɨ.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Xiu kɨyeyari xawariyari muwawaki hepaɨ kanitiyɨmɨkɨ,","poem":1},{"text":"haraweri tuturi mɨwa'etsietsie mɨka'ukahatuiyarɨwa hepaɨ.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Tewi mɨtɨrɨkaɨye mɨaxa hepaɨ kaniyɨmɨkɨ,","poem":1},{"text":"meta 'uximayatsikaya tai tsipɨrikiyari hepaɨ,","poem":2},{"text":"'axeikɨa hutatɨ kanititaimɨkɨ,","poem":1},{"text":"xewitɨ pumaweni mitɨnikɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}