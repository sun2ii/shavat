{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Xɨa'ui kemɨ'ane 'aitsika 'axa'aneneme memɨtiwewiwa","poem":1},{"text":"te'utɨwamete me'eka'utɨwatɨ mewananaimatɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tixaɨ memɨkatehexeiya wahetsie heitserie kememɨtehexeiya memukunama,","poem":1},{"text":"meta kemɨtiheitserie memɨkawapitɨa neteɨterima memɨte'uka'eniwa.","poem":2},{"text":"Wiuraxi wa'ikwai mepɨtewanawairie","poem":1},{"text":"meta nutuite mepɨwanawatɨwe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"¿Kemeteyurieni kepauka memɨta'iwawiyarienitsie,","poem":1},{"text":"kepauka 'ateewa paitɨ wiyeri tɨrɨkaɨyetɨ muwayanitsie?","poem":2},{"text":"¿Kemɨ'ane mepanukuwauni xɨka parewiya meheuyehɨaka?","poem":1},{"text":"¿Hakewa yupiinite waɨkawa memɨtehexeiya mepɨteheti'uta?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tawariri yɨkɨ memɨte'uyurieni mepɨkayɨwaweni","poem":1},{"text":"tixaɨtɨ memɨkatehɨkɨ mekanayuyeitɨakuni xeikɨa memanuhapanieni wahamatɨa","poem":2},{"lineBreak":true},{"text":"yatɨni mekanikwikuni hipatɨ memɨkwi'iwa wahamatɨa.","poem":2},{"lineBreak":true},{"text":"Tsepanetɨ 'ikɨ naitɨ mɨyamɨtiɨyɨ,","poem":1},{"text":"Kakaɨyari haxɨaya pukaheunuawe,","poem":2},{"lineBreak":true},{"text":"matsi 'akuxi yumamá kanitatseratɨkani.","poem":2}]},{"type":"heading","content":["Kakaɨyari 'Atsiriya kemɨtiukwinitɨa"]},{"type":"verse","number":5,"content":[{"text":"«Xɨa'ui 'Atsiriya, nehaxɨa kɨyeyari.","poem":1},{"text":"Nehaxɨa 'iwaɨyɨyari wamamatsie katini'aneni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nekanitanɨ'amɨkɨ xeinuiwariyaritsie 'axamemɨteyurie wahetsɨa,","poem":1},{"text":"nekanitanɨ'amɨkɨ teɨteri memɨnetsihaxɨatɨa wehetsɨa,","poem":2},{"text":"memɨtewanawatsirienikɨ meta tita waɨkawa memɨtehexeiya,","poem":1},{"text":"meta memuwatiketsinikɨ haxu kaye 'utɨa mɨtikani hepaɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Matsi 'Atsiriya mɨpaɨ pɨkatiyɨkɨhɨawekai yamɨtiyurienikɨ 'ikɨ hepaɨtsita,","poem":1},{"text":"meta tsikere pɨka'iti'eriexɨa.","poem":2},{"text":"Xeikɨatɨ pɨtiutiwau mɨtiyuka'unakɨ","poem":1},{"text":"meta yɨmɨireme nuiwarite muwarakumaweriyakɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mɨpaɨ xeikɨa 'utaitɨ: “Yunaitɨ memanuyetei nehetsɨa miemete te'aitamete mekanihɨkɨtɨni.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Karinu Karikemitsi hepaɨ kani'aneni.","poem":2},{"text":"Kamati 'Axipari hepaɨ kani'aneni,","poem":1},{"text":"meta Tsamariya Ramatsiku hepaɨ kani'aneni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kehepaɨ netɨrɨkariyakɨ nemɨtiwara'iwaxɨ","poem":1},{"text":"hipame te'aitamete kakaɨyarixi yuwaɨkawame mewarexeiyakame,","poem":2},{"text":"wakakaɨyarixi 'ɨkiyari meyumɨireme","poem":1},{"text":"keyuri Kerutsareme meta Tsamariya kiekatari,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tsamariya kenemuyuri meta kakaɨyariximama,","poem":1},{"text":"mɨpaɨta Kerutsareme nekaniyurimɨkɨ meta kakaɨyariximama”».","poem":2}]},{"type":"verse","number":12,"content":["Kepauka Yawé mɨtitahayewa Tsiyuni hɨriyaritsie kemɨtiyurienikɨ meta Kerutsareme hetsie, mɨkɨ mɨpaɨ kanitayɨmɨkɨ: «'Atsiriyatsie Ti'aitame nekatinikwinitɨamɨkɨ 'iyarieya kwinimieme mɨtiyuta'ɨrekɨ, meta kwinimieme mɨtiyukatawe'eriekɨ hɨxiteya»."]},{"type":"verse","number":13,"content":["Mɨpaɨtsɨ kaniutaineni:",{"text":"«'Ikɨ netɨrɨkariyakɨ nekatiniuyurieni,","poem":1},{"text":"kenemɨtimaiwe nekatiniuyurieni,","poem":2},{"lineBreak":true},{"text":"netsɨ kwinimieme nekatineuta'eriweni.","poem":2},{"text":"Hipame teɨteri wakwie manuka'atɨkatsie nekaniupataxɨani,","poem":1},{"text":"kwinimieme mɨraye'atɨka memɨtehexeiyakai nekatiniwarunawairieni,","poem":2},{"text":"kwinimieme mɨreuyutamiewe hepaɨ ne'anetɨ","poem":1},{"text":"tewa'aitɨwamete nekaniwaruka'una.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Xewitɨ 'itua hetsie meukamemeni hepaɨ,","poem":1},{"text":"teɨteri tita memɨteheuxeiyakai nehetsie timieme pɨratɨa,","poem":2},{"text":"tawári 'uku'eiriwaku xewitɨ menatitɨkɨ hepaɨ,","poem":1},{"text":"naime kwie nepiini nepayeitɨa,","poem":2},{"text":"xewitɨ tɨma pɨka'utawerikixɨ","poem":1},{"text":"nitɨma yuyekarau pɨka'anutayepi mɨtatsuanikɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"¿Kamɨtsɨ tiyɨwe hatsa yɨweme muyuxatani","poem":1},{"text":"keyuri mikumaɨwa,","poem":2},{"lineBreak":true},{"text":"yatɨni tixitekeme yɨweme muyuxatani keyuri kemɨ'ane mikumaɨwa?","poem":2},{"text":"'Itsɨ mɨyɨweni hepaɨ mikuhananenikɨ","poem":1},{"text":"kemɨ'ane mekwe'e,","poem":2},{"text":"yatɨni kɨye mɨkaxani mɨyɨweni hepaɨ menukukwenikɨ","poem":1},{"text":"waɨkawa matsi haheteme keyuri mexa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"'Ayumieme Ti'aitame kanenunɨ'amɨkɨ","poem":1},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye,","poem":2},{"text":"kwiniya mɨyakame panunɨ'ani","poem":1},{"text":"kuyaximama memɨtɨrɨkawi wahetsie.","poem":2},{"text":"Mamariwaweme mɨwarayeitɨaniyari, matsi pɨta kanatinaimɨkɨ wahetsiemieme,","poem":1},{"text":"tai nerɨkwariyari mɨtiyukukuine hepaɨ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"'Ixaheri hekɨariyari tai kanayeimɨkɨ,","poem":1},{"text":"wahetsie Mɨpatsie nerɨkwari kanayeimɨkɨ.","poem":2},{"text":"Xeitukaritsie xuyayari kanititaiyamɨkɨ,","poem":1},{"text":"meta wa'ɨtsite kanitixɨtsitɨamɨkɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Katinika'unamɨkɨ naime hakewa meuye'atɨka","poem":1},{"text":"muhukuya witsikemɨtiyuxexeiya meta harawerieya mukumane,","poem":2},{"lineBreak":true},{"text":"mɨtikukuyeni hepaɨ kwaiyatɨkaime kanihayewamɨkɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"'Etsiwa xeikɨa kɨyexi hɨritsie kaniyuhayewakɨmɨ","poem":1},{"text":"nunutsitɨtɨ kaniyɨwemɨkɨ miti'inɨatakɨ.","poem":2}]},{"type":"heading","content":["'Ixaheri nuiwarimama memuyuhayewaxɨ"]},{"type":"verse","number":20,"content":[{"text":"'Iya tukaritsie 'ixaheri nuiwarimama memuyuhayewaxɨ","poem":1},{"text":"meta Kakuwu kie kiekatari memukuwikwei","poem":2},{"text":"tawariri hetsiena mepɨkatewiya","poem":1},{"text":"kemɨ'ane tiwakwinitɨatɨ mɨwarukwi,","poem":2},{"text":"matsi yurikɨ waparewiwame","poem":1},{"text":"Yawé, Mɨpatsie 'Ixaheri hetsiemieme, kanihɨkɨtɨkamɨkɨ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Memuyuhayewaxɨ mekani'axɨakuni,","poem":1},{"text":"Kakuwu nuiwarieya memuyuhayewaxɨ mekani'axɨakuni Kakaɨyari Mɨtɨrɨkaɨye hetsɨa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"'Ixaheri,","poem":1},{"text":"tsepanetɨ 'ateɨterima xiekari haramara tetsita mɨtika hepaɨ memɨyupaɨme,","poem":2},{"lineBreak":true},{"text":"memuyuhayewaxɨ xeikɨa mekani'axɨakuni.","poem":2},{"text":"'Ari yakatiniutaniukieni memɨka'unarienikɨ,","poem":1},{"text":"heitseriemekɨ katiniyɨmɨkɨ yuheyemekɨ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Karikɨ Ti'aitame, Yawé Naimekɨmɨtɨrɨkaɨye,","poem":1},{"text":"yakatinaye'atɨamɨkɨ mika'unakɨ kemutayɨ","poem":2},{"lineBreak":true},{"text":"mɨkɨ nuiwari.","poem":2}]},{"type":"verse","number":24,"content":["'Ayumieme, Ti'aitame mɨpaɨ paine, Yawé Naimekɨmɨtɨrɨkaɨye:",{"text":"«Neteɨterima, Tsiyuni xemɨtama,","poem":1},{"text":"'Atsiriya pepɨkamakaka.","poem":2},{"text":"Tsepanetɨ yu'itsɨkɨ mɨmatsi'uwa","poem":1},{"text":"meta tsepa kɨye 'iwaɨyɨpame manukukwei,","poem":2},{"lineBreak":true},{"text":"'Ekipitu mɨtiuyuri hepaɨ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"'Ena mɨtiyehane yapaɨmexɨa tukari 'anukayayu","poem":1},{"text":"neha'atɨ 'ahepaɨtsita nepɨtihayewa,","poem":2},{"lineBreak":true},{"text":"meta nehaxɨa memɨmetsi'aye'unie kaniwaka'unamɨkɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Yawé Naimekɨmɨtɨrɨkaɨye","poem":1},{"text":"kawayatsixi wawayamekɨ kaniwatiwamɨkɨ,","poem":2},{"text":"Mariyani kemɨtiuka'unaxɨ hepaɨ","poem":1},{"text":"'Urewi 'aiyaritsie.","poem":2},{"text":"Haramara hetsie yu'itsɨ kaneutatseramɨkɨ,","poem":1},{"text":"'Ekipitu kemɨtiuyuri.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"'Iya tukaritsie","poem":1},{"text":"mɨkɨ 'ika 'anaiparitsie pemetɨkɨ pekaninawairiemɨkɨ","poem":2},{"text":"meta waɨkawa pemɨtawaiyatakɨ","poem":1},{"text":"yuku 'akwipitɨa pemateka kananumurimɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"'Ayati paitɨ kaninuamɨkɨ rayuye'uniekame,","poem":1},{"text":"Mikuruni kaniuyeyeimɨkɨ,","poem":2},{"lineBreak":true},{"text":"meta yupiinite Mikimatsi katiniku'eirimɨkɨ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Mayekuni 'uyaka, mɨpaɨ kanaineni:","poem":1},{"text":"«Kehewa tekananukutsikuni».","poem":2},{"text":"Xama kaniuyɨyɨakani marikakɨ,","poem":1},{"text":"meta Kiweya kiekatari, Tsahuri kiekarieya mepuyuta'unaxɨ.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Karini niweya witsipemɨti'ɨimari, karima keneutahiwa.","poem":1},{"text":"Rahitsi, keneu'ena.","poem":2},{"lineBreak":true},{"text":"Xɨa'ui 'Anatuti.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Marimena kaniuyuta'una,","poem":1},{"text":"Kewini kiekatari hakewa memeyuti'awieta mekaniwautɨweni.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Hikɨtɨtɨ Nuwi mekaniwa'uikuni,","poem":1},{"text":"yumamá kanitakatsimɨkɨ hɨri hepaɨtsita","poem":2},{"lineBreak":true},{"text":"Tsiyuni niweya witsimɨti'ɨimari kiekariyaritsie,","poem":2},{"lineBreak":true},{"text":"Kerutsareme hɨriyaritsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Xekeneuxeiya. Ti'aitame, Yawé Naimekɨmɨtɨrɨkaɨye,","poem":1},{"text":"kɨyexi pɨtimura yemekɨ waɨkawa tɨrɨkaɨyemekɨ.","poem":2},{"text":"Kɨyexi 'amɨtɨtɨ kanawitekiexɨamɨkɨ,","poem":1},{"text":"matsi waɨkawa 'amutɨtɨ kanatixɨriwani.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Hatsakɨ 'ɨtsi 'amayetsuye kanayewitewani,","poem":1},{"text":"meta Riwanu witsimɨtiyuxexeiyakai puwakapenixɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/9.json","previousChapterAudioLinks":{},"numberOfVerses":34}