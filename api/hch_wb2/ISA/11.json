{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":11,"content":[{"type":"heading","content":["'Itsahi yɨrariyari"]},{"type":"verse","number":1,"content":[{"text":"'Itsahi kutsunuyaritsie xewitɨ yɨrari kananemɨkɨ,","poem":1},{"text":"mɨkɨ yɨrari nanaritsie kananemɨkɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yawé 'Iyarieya mɨkɨ hetsie kanika'uxipiemɨkɨ:","poem":1},{"text":"'iyari mɨtimaiwenikɨ meta meti'enatɨyeikanikɨ,","poem":2},{"lineBreak":true},{"text":"'iyari 'ɨxatsi mexeiya meta tɨrɨkariya,","poem":2},{"lineBreak":true},{"text":"'iyari waɨkawa mɨrakumate meta Yawé mayemakaxe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mɨkɨ puyutemawieka Yawé 'ayemakatɨ,","poem":1},{"text":"kemɨtinierekɨ mɨkɨkɨ pɨkawaxanetani,","poem":2},{"lineBreak":true},{"text":"meta yapɨkatiyurieni kemɨti'enakɨ,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"matsi heitseriemekɨ 'aixɨa pɨtiyurieni memɨnanaimarie wahetsiemieme,","poem":1},{"text":"meta 'aixɨa pɨtiyurieni","poem":2},{"lineBreak":true},{"text":"tixaɨtɨ memɨkatehexeiya wahetsiemieme 'ena kwiepa.","poem":2},{"text":"Kwie pɨka'una kɨye 'iwaɨyɨpame yuteta miemekɨ,","poem":1},{"text":"'axatiyuruwame yu'iiyakɨ pumieni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tita mɨtiheitserie hɨiyame yunaiparie manakateika pɨhɨkɨtɨni","poem":1},{"text":"meta yuri mɨraine hɨiyame manakuteika pɨhɨkɨtɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yawi muxa hamatɨa 'apuyeikani,","poem":1},{"text":"tɨwe tsipu 'etsimupe hamatɨa pukuhuneni,","poem":2},{"text":"meta tsikeru temaikɨ meta maye temaikɨ yuhamatɨa mepuku'uwani,","poem":1},{"text":"nunutsi 'etsiyumaitɨ pɨwaku'arieneni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wakaxi hutse 'ukaratsi hamatɨa pɨtitikwani,","poem":1},{"text":"waniwema yuhamatɨa mepukuhitɨweni,","poem":2},{"lineBreak":true},{"text":"meta maye tuuru hepaɨ 'ɨxa pɨtikwani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nunutsi mɨtsitsewe kuu 'amumu'uyewa 'uaye mumɨya mexeiya","poem":1},{"text":"muwayekie 'aurie pɨtiwaika,","poem":2},{"text":"meta nunutsi yutsitsi muku'eiritsitɨarieke","poem":1},{"text":"kuu 'ituayatsie peukameni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Xewitɨ pumaweni 'axamɨwayurienikɨ meta mɨtiwakwinitɨanikɨ","poem":1},{"text":"nehɨri naitɨ mɨpatsie hetsie,","poem":2},{"text":"kwie kanitahɨnimɨkɨ","poem":1},{"text":"Yawé memaitɨ memakɨne mɨ'ayumiemekɨ","poem":2},{"lineBreak":true},{"text":"haramara hakɨ kemɨranatiyeuriwe hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"'Iya tukaritsie 'Itsahi nanarieya panukukeni","poem":1},{"text":"teɨteri wa'inɨari hepaɨ,","poem":2},{"text":"mɨkɨ hepa nuiwarite mepɨtinautsa,","poem":1},{"text":"meta witsi'anetɨ payani hakewa mɨkɨ metayerɨni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Iya tukaritsie Yawé tawarita yumamá kaneutatseramɨkɨ","poem":1},{"text":"yuteɨterimama memuyuhayewatɨwe muwakuxeɨrienikɨ,","poem":2},{"text":"'Atsiriyatsie memuyuhayewaxɨ,","poem":1},{"text":"'Ekipitu, Paturutsi meta Kutsi,","poem":2},{"text":"'Erami, Tsinaxi meta Kamati,","poem":1},{"text":"meta haramara hatetsitayari 'ametetewatsie.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Patera panuwieni nuiwarite wahetsiemieme,","poem":1},{"text":"'ixaheritsixi memutaweiyarie puwaxeɨrieni,","poem":2},{"text":"naitsarie kwiepa","poem":1},{"text":"Kura nuiwarimama memeutaweiyariexɨa puwakuxeɨrieni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Epɨrahini 'ɨtetsarikaya pukumawere,","poem":1},{"text":"Kura memaye'unie mepukumaweriyarieni,","poem":2},{"text":"'Epɨrahini Kura tawariri pɨkatitikwatsirieni,","poem":1},{"text":"Kura 'Epɨrahini tawariri waɨriyarika pitɨatɨ pɨkatita'aitɨani.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yunaitɨ tau makayuyuipike hepatsie mepeutayune,","poem":1},{"text":"piritsiteutsixi wakwie mukɨatsie mepɨwatakwini,","poem":2},{"text":"yunaitɨ tau manatineika kiekatari mepɨtewanawatsirieni,","poem":1},{"text":"'Erumi meta Muhawi wahetsie mepɨteta'aita,","poem":2},{"lineBreak":true},{"text":"metatsiere 'amunitsixi mekateniwata'aitɨakuni.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yawé 'Ekipitu haramarayari kanikawatsiɨxamɨkɨ,","poem":1},{"text":"yumamá haa 'Eupɨrate hetsie kaneutatseramɨkɨ,","poem":2},{"lineBreak":true},{"text":"meta 'eka xɨkame kanikuwiwimɨkɨ,","poem":2},{"text":"'atahutame 'akiyari kaniuyetuamɨkɨ","poem":1},{"text":"mana memɨkɨnekɨ yukakaitsie me'u'utɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Teɨterimama memuyuhayewaxɨ wahetsiemieme,","poem":1},{"text":"'Atsiriya memuyuhayewaxɨ wahetsiemieme,","poem":2},{"text":"huye kanitixuawerimɨkɨ, kemɨtiɨyɨ hepaɨ 'ixaheritsixi wahetsiemieme","poem":1},{"text":"'Ekipitu kepauka memayekɨtsie.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/10.json","previousChapterAudioLinks":{},"numberOfVerses":16}