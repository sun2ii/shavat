{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["Kwikari nɨawariyari"]},{"type":"verse","number":1,"content":["'Iya tukaritsie 'ekɨ mɨpaɨ pepɨtayɨni:",{"text":"«Yawé, ne nepɨmetsinɨawani","poem":1},{"text":"tsepanetɨ meripaitɨ nehepaɨtsita pemɨtiuyeha'akai.","poem":2},{"text":"Peha'atɨ pepɨtiuhayewaxɨ,","poem":1},{"text":"meta pekaneniɨnɨtɨaniri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kakaɨyari netsiwikweitsitɨwame kanihɨkɨtɨni.","poem":1},{"text":"Hetsiena yuri nepɨti'erieka meta nepɨkaheumaka.","poem":2},{"text":"Yawé netɨrɨkariya kanihɨkɨtɨni,","poem":1},{"text":"Yawé nekwikari pɨhɨkɨ,","poem":2},{"lineBreak":true},{"text":"mɨkɨ netsiwikweitsitɨwame kanihɨkɨtɨni».","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Xeme xeyutemamawietɨ haa xepuwatihanɨni","poem":1},{"text":"wikweitsitɨarika hayaritsie.","poem":2}]},{"type":"verse","number":4,"content":["'Iya tukaritsie mɨpaɨ pɨtitaniukieni:",{"text":"«Yawé xekenenɨawani, xekenahɨaweni,","poem":1},{"text":"kemɨtiuyuri xekenekuxatani teɨteri watsata,","poem":2},{"lineBreak":true},{"text":"xekenekuxatani kemɨtimariwe kemɨtitewakɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yawé hetsiemieme nɨawari xekeneutikwikani,","poem":1},{"text":"mariwemekɨ mɨtiyuriene,","poem":2},{"text":"'ikɨ mɨpaɨ ketiutaxatsieni","poem":1},{"text":"kwiepa naitsarie.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Keneutakwikani meta keneutahiwani temawierikakɨ,","poem":1},{"text":"Tsiyuni kiekatari,","poem":2},{"text":"pumariwe yurikɨ, 'ahamatɨa 'uyeikatɨ,","poem":1},{"text":"Mɨpatsie 'Ixaheri hetsiemieme».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}