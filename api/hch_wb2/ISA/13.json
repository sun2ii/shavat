{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":13,"content":[{"type":"heading","content":["Niuki Wawiruniya hepaɨtsita mieme"]},{"type":"verse","number":1,"content":["Niuki Wawiruniya hepaɨtsita Kitsariyaxi 'Amuxi nu'aya kemɨtiuhekɨatsitɨiyarie:"]},{"type":"verse","number":2,"content":[{"text":"Xeime hɨri metsekame hetsie patera xekeneuyuitɨwani,","poem":1},{"text":"kuyaxi xekeniwarutahɨawi xe'utihiwatɨ,","poem":2},{"text":"yumamakɨ xekeniwaru 'inɨaritɨa","poem":1},{"text":"'itupari meuwietsie memɨxikutsixi wakitenie memeutahaxɨanikɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Memɨpatsie nehetsɨa miemete nekatiniwaruta'aitɨaniri,","poem":1},{"text":"nekuyaxima nekaniwaruta'inieni,","poem":2},{"text":"memuyutemamawie nemɨrayu'iwakɨ,","poem":1},{"text":"memɨnetsiparewienikɨ 'iya nemɨtiwakwinitɨanikɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Neuxei xekeneu'enana. Hɨritsie meyuwaɨkawatɨ wayuariya pa'eniɨriɨkɨ,","poem":1},{"text":"yuwaɨkawatɨ wa'atɨ muwa mepɨtehahu.","poem":2},{"text":"Neuxei xekeneu'enana. Yuwaɨkawatɨ te'aitamete wayuarika pa'eniɨriɨkɨ,","poem":1},{"text":"nuiwarite memuyukuxeɨri.","poem":2},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye kaniwakuha'aritɨamɨkɨ","poem":1},{"text":"kuyaxi memuyukwiyutsie.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Ateewa kwieyaritsie mekaneyekɨne,","poem":1},{"text":"kwie manuye'atɨkatsie paitɨ.","poem":2},{"text":"Yawé yuhaxɨakɨ yuha'aritɨatɨ 'ukanamieni","poem":1},{"text":"naime kwie mɨka'unakɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xekeneutitsuanani, Yawé munuanikɨ kanehuraniri.","poem":1},{"text":"Naimekɨmɨtɨrɨkaɨye hetsie yeyaka kaniwareuyehɨamɨkɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Ayumieme mamate naitɨ kanitiweranareni,","poem":1},{"text":"teɨteri yunaitɨ mekayuwaɨriyatɨ mekaniyukuhayeikawani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yunaitɨ mekanimamaka,","poem":1},{"text":"kukuiniya meta hiwerika kaniwawiyani:","poem":2},{"text":"kukuiniyakɨ mekaniyu'uimɨratɨweni,","poem":1},{"text":"memɨniwetuweni hepaɨ.","poem":2},{"text":"Me'akamamatɨ, yuxexuitɨ mekananuyutaxexeiyani,","poem":1},{"text":"yuhɨxie me'ayexetatɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neuxei. Yawé 'ari tukarieya kanaya'aximeni","poem":1},{"text":"―tukari 'axamɨ'ane, haxɨa tukariyari―,","poem":2},{"text":"kwie 'akumaweme kanayeitɨamɨkɨ","poem":1},{"text":"meta 'axateyuruwamete kaniwarakumaweriyamɨkɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Xurawetsixi meta taheima temiemete","poem":1},{"text":"mehekɨariewietɨ mekatenihayewakuni,","poem":2},{"text":"tau 'anatineximetɨ kaniyɨrimɨkɨ","poem":1},{"text":"meta metseri pɨkahekɨariwieni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kwiepa memɨtama 'axakememɨteyuriekɨ nepɨtiwakwinitɨani,","poem":1},{"text":"meta 'axateyuruwamete 'axamemɨteyuriekɨ.","poem":2},{"text":"Memɨteyukananaima kememɨte'uyuti'ɨre nekaneutiparitɨamɨkɨ","poem":1},{"text":"memamariwaweme memuyuxata memuyuti'ɨre tixaɨtɨ nepɨkatiwarayeitɨani.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Teɨteri yakɨ meyupaɨmeme nekaniwarayeitɨamɨkɨ keyuri huru 'aixɨa mɨ'ane,","poem":1},{"text":"teɨteri memɨkwiwawe yakɨ mepɨyupaɨmeni huru matsi 'apɨpaɨmeni 'Upixi mieme.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Ayumieme yanepɨtiyurieni muyuawi mɨtayuanikɨ","poem":1},{"text":"meta kwie hakewa meuyema mɨtayuanikɨ,","poem":2},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye haxɨayakɨ","poem":1},{"text":"kepauka mɨyeha'ani tukariyaritsie.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Maxa 'ɨimari yeutanaka muweiyarieka hepaɨ,","poem":1},{"text":"muxatsi memɨkatehekakutsiyari hepaɨ,","poem":2},{"text":"yukie yuxexuitɨ mekani'axɨakuni,","poem":1},{"text":"yuxexuitɨ yukwietsie mekaniyuta'unaxɨakuni.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kemɨ'ane mɨwiyarieni mɨkɨ kananuyetsekiemɨkɨ,","poem":1},{"text":"kemɨ'ane manutahɨiyani 'ixiparakɨ kanemieriemɨkɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Menenierekaku,","poem":1},{"text":"waniwema mekanititetseweiyakuni,","poem":2},{"text":"wakiita katininawariemɨkɨ","poem":1},{"text":"meta wa'ɨitama wahamatɨa waɨriyarika mewapitɨatɨ mekanikahikuni.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Neuxei. Ne merutsixi nekaniwata'inimɨkɨ mɨkɨ wahepaɨtsita,","poem":1},{"text":"teɨteri pɨrata memɨkaheuyehɨwa","poem":2},{"lineBreak":true},{"text":"meta hurukɨ memɨkayutemamawiekai.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yutupikɨ temari mekaniwaranuyemɨixɨakuni,","poem":1},{"text":"nunutsi hukatsie mɨyeka mepɨkatinenimayata","poem":2},{"lineBreak":true},{"text":"meta tɨɨri mepɨkawatinenimayata.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wawiruniya, witsimɨtiyuxexeiya te'aitamete wahetsiemieme,","poem":1},{"text":"karireutsixi memiheiwe'erie meta memuyuta'ɨrenikɨ mɨ'ayumieme,","poem":2},{"text":"Tsuruma meta Kumuxa wahepaɨ katinanuyeyeimɨkɨ","poem":1},{"text":"kepauka mɨkɨ Kakaɨyari mɨwaruka'unaxɨ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Tawariri teɨteri mana mepɨkayutikitɨani,","poem":1},{"text":"meta 'uxa'atɨni mana pɨkatikuyaxitɨ.","poem":2},{"text":"Harawe tewiyari mukatewa tɨma mana yu'ixuriki kiiyari pɨkatawewieni,","poem":1},{"text":"nimana tɨma muxatsi wahɨweme yumuxatsi pɨkawaka'uxipitɨani.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mana teyukwa'amete makumawetsie kiekatari mekanika'uxipikuni,","poem":1},{"text":"wakiita mikɨrixi mepɨtahɨne.","poem":2},{"text":"Mana 'aruxi 'amemɨnene wakie payani","poem":1},{"text":"meta tsipuri yeutari mana mepɨtitsuna.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Wakiita 'aixɨa mɨ'aneneta tsɨikɨri yeutari mepɨtitsuani,","poem":1},{"text":"meta waparatsiyu witsimɨ'aneneta yawixi memayu'eririya mepɨtitsuani.","poem":2},{"text":"Mɨkɨ huraya kanaye'aximeni,","poem":1},{"text":"mɨkɨ tukarieya 'apɨkareutere.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/12.json","previousChapterAudioLinks":{},"numberOfVerses":22}