{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":["Yurikɨ, Yawé Kakuwu kanitinenimayatamɨkɨ, hekwamekɨta 'Ixaheri kananayexeiyamɨkɨ. Wakwietsie kaniwa'atɨamɨkɨ. Kɨkamete mekaniwatinɨikuni, Kakuwu nuiwarimama wahamatɨa mekaniyutinɨikuni."]},{"type":"verse","number":2,"content":["Teɨteri yukwietsie mepɨwatanaki'erieni meta wakiekaritsie paitɨ mepuwatuayu. 'Ixaheritsixi teyu'uximayatsiriwamete 'ukitsi meta 'ukarawetsixi Yawé kwieyatsie mepɨwarayeitɨani, memɨwaraye'uniekai mekaniwaranutaxɨriekuni meta mekateniwata'aitɨakuni kemɨ'ane memɨtewa'aitɨakai."]},{"type":"verse","number":3,"content":["Kepauka Yawé kexemɨte'uka'eniwakaikɨ mɨxeka'uxipitɨani, kexemute'u'uximatɨarie meta waɨriyarika xepitɨarietɨ xemɨte'aitɨariekaitsie,"]},{"type":"verse","number":4,"content":["'ikɨ xatsika xepɨtaxata ti'aitame Wawiruniya hetsiemieme:",{"text":"Neuxei kereutiparixɨ waɨriyarika mɨtati'aitɨakai,","poem":1},{"text":"meta haxɨaya kereutiparixɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yawé 'axateyuruwamete wakɨye kananumura,","poem":1},{"text":"memɨmamariwawe wa'itsɨ pakamuraxɨ","poem":2}]},{"type":"verse","number":6,"content":[{"text":"haxɨakɨ meta yatiwaruwayatɨ","poem":1},{"text":"teɨteri pɨtiwakwinitɨakai,","poem":2},{"text":"haxɨa mɨkapariwekɨ","poem":1},{"text":"nuiwarite mɨtiwa'aitɨakai meta puwaruweiyakai.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kwie naitɨ 'aixɨa 'iyari kani'uxipieka,","poem":1},{"text":"meta temawierikakɨ mekaniutihiwani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Metsɨ huku meta kariuxa Riwanu mieme","poem":1},{"text":"'ɨaritɨ mekaniutinaweni 'ahepaɨtsita, mɨpaɨ mekaniutiyuaneni:","poem":2},{"text":"«Kepauka pematihɨiyatsie paitɨ,","poem":1},{"text":"tawariri xewitɨ pɨkatatsihawitexɨawe».","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hutipaitɨ meukatewatsie, 'ahekɨ,","poem":1},{"text":"teukiyapa putayɨyɨaka","poem":2},{"lineBreak":true},{"text":"matsi'anunakeke,","poem":2},{"text":"'ahekɨ mɨyapemuyɨkɨ mɨkite mepanutaneniere,","poem":1},{"text":"kemɨ'ane kwiepa memanuyetekai.","poem":2},{"text":"Yapɨtiyurie yunaitɨ nuiwaritetsie te'aitamete","poem":1},{"text":"yu'uwenitsie memanuku'unikɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mɨkɨ yunaitɨ mekaniti'akuni mɨpaɨ mekametenikɨhɨaweni:","poem":1},{"text":"«'Ekɨta pekaniutaweranaxɨani.","poem":2},{"lineBreak":true},{"text":"'Ekɨtsɨari ta'iwa pekanihɨkɨtɨni».","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Ekɨ kepemɨtiyuta'ɨrekai teukiyapa kaneukahɨiyani,","poem":1},{"text":"'a'aripa yuariyaya yunɨkame.","poem":2},{"text":"Kwitsiteri watsata pekanikutsuni,","poem":1},{"text":"meta harekuxi mekamaninɨkani.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kekuta pe'ɨyɨka muyuawitsie pepanakahɨiya,","poem":1},{"text":"xurawe tuxakɨta mieme.","poem":2},{"text":"'Ekɨ, nuiwarite pemɨtiwa'aitɨakai,","poem":1},{"text":"kwiepa pekaniukaweni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'A'iyaritsie mɨpaɨ peputainekai:","poem":1},{"text":"«Muyuawitsie paitɨ nepanutiyani.","poem":2},{"text":"Ne'uweni mana paitɨ nepɨtakeni","poem":1},{"text":"Kakaɨyari xurawetsiximama waheima.","poem":2},{"text":"Tayeta mutiniere paitɨ nepɨtita'aita,","poem":1},{"text":"kakaɨyarixi wahɨritsie paitɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nekananutiyeimɨkɨ haiwitɨri yekɨrita paitɨ 'emeutitewatsie,","poem":1},{"text":"'Amutewi hepaɨ nekani'anekamɨkɨ».","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Peru neuxei teukiyapa pepeukahɨiya,","poem":1},{"text":"putsu 'emeukatewatsie.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kemɨ'ane memɨmatsixeiya, kwi mepɨmatsikuxexeiya,","poem":1},{"text":"meta kepemɨranuyeyanikɨ mɨpaɨ meputiyuane:","poem":2},{"text":"«¿Kamɨtsɨ 'ikɨ kwie mutayuitɨwakai tihɨkɨ","poem":1},{"text":"meta te'aitamete muwamariutakai,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"kwie naime 'akumaweme mayeitɨwakai,","poem":1},{"text":"wakiekarite mɨti'unakai","poem":2},{"lineBreak":true},{"text":"meta memanutaxɨriya hatsuaku mɨkawatatuayakai?»","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yunaitɨ nuiwarite tewa'aitɨwamete","poem":1},{"text":"'aixɨa 'anemekɨ mepu'uxipie,","poem":2},{"lineBreak":true},{"text":"yuteukiyapa yuxexuitɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Matsi 'ekɨ teukiya kameniuhayani","poem":1},{"text":"kɨye kutsunuyari mutaxainixɨ hepaɨ.","poem":2},{"text":"Kemɨ'ane 'ixiparakɨ memukwi'iwaxɨ,","poem":1},{"text":"kemɨ'ane teukiyapa tetɨata memeukakɨ,","poem":2},{"text":"mɨkɨri naime mepɨmatsi'anukana.","poem":1},{"text":"Mɨki ketsinariekame hepaɨ pekani'aneni.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Te'aitamete wahamatɨa teukiya pehexeiyatɨ pepɨka'ayani,","poem":1},{"text":"'akwie pemuka'unaxɨkɨ","poem":2},{"lineBreak":true},{"text":"meta 'ateɨterima pemɨwarukwikɨ.","poem":2},{"lineBreak":true},{"text":"Tawariri pɨkataxatsieni","poem":1},{"text":"'axateyuruwamete wanuiwari.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Wapaapama 'axamemɨte'uyurikɨ,","poem":1},{"text":"xekeneukuha'arita niwemama hakewa memekwi'iwakɨ.","poem":2},{"text":"Mepɨka'anuku'uweni kwie wahetsie mɨtinakenikɨ","poem":1},{"text":"meta kiekaritekɨ kwiepa mepɨkahakɨnɨtsani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Ne mɨkɨ wahepaɨtsita nekananukukemɨkɨ","poem":1},"―Yawé mɨpaɨ kanaineni―.",{"text":"Ne Wawiruniya nepɨka'una","poem":1},{"text":"kemɨtitewakɨ meta nuiwarieya,","poem":2},{"lineBreak":true},{"text":"tsutumeyari meta 'imatɨreme","poem":2},{"lineBreak":true},{"text":"―Yawé mɨpaɨ kanaineni Naimekɨmɨtɨrɨkaɨye―.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Naikatsi 'ɨtsita kiekatari wakie nepayeitɨani,","poem":1},{"text":"haa mayema,","poem":2},{"text":"meta tiyu'uname matsikɨiyarikɨ nepeku'itieni»,","poem":1},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye mɨpaɨ kanaineni.","poem":2}]},{"type":"heading","content":["Niuki 'Atsiriya hepaɨtsita mieme"]},{"type":"verse","number":24,"content":[{"text":"Yawé Naimekɨmɨtɨrɨkaɨye kaniyuhɨritɨani:","poem":1},{"text":"«Yemekɨ kenemɨtiku'eriwa, mɨpaɨ katinaye'amɨkɨ,","poem":2},{"lineBreak":true},{"text":"kehepaɨ nemɨtiyurienikekai, mɨpaɨ katiniyɨmɨkɨ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"'Atsiriya 'ena nekwiepa nekanika'unamɨkɨ,","poem":1},{"text":"nehɨritetsie nekanitiketsixɨamɨkɨ.","poem":2},{"text":"Neteɨterima mɨkɨ yuku hetsɨana mieme me'anuyetetɨ mekatenihayewakuni,","poem":1},{"text":"'ari wanaiparietsie mɨkɨ 'ika pɨkahahetere».","poem":2}]},{"type":"verse","number":26,"content":[{"text":"'Ipaɨ nekatiniyurimɨkɨni","poem":1},{"text":"naime kwie hetsie,","poem":2},{"text":"'ikɨ kanihɨkɨtɨni nemamá nemeutatsera","poem":1},{"text":"nuiwarite yunaime wahetsie.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Xɨkari mɨpaɨ tiɨyɨhɨawe Yawé Naimekɨmɨtɨrɨkaɨye,","poem":1},{"text":"¿kemɨ'ane pɨyɨwe mita'imaiyakɨ?","poem":2},{"text":"Xɨkari mɨkɨ yumamá hautatserani,","poem":1},{"text":"¿kemɨ'ane pɨyɨwe muwaketɨanikɨ?","poem":2}]},{"type":"heading","content":["Niuki piritsiteutsixi wahepaɨtsita mieme"]},{"type":"verse","number":28,"content":["'Ikɨ niuki Kitsariyaxi hetsie kaninuani kepauka ti'aitame 'Akatsi mumɨ mɨkɨ wiyaritsie:"]},{"type":"verse","number":29,"content":[{"text":"Piritsiteutsixi yunaitɨ xeme,","poem":1},{"text":"xepɨkayutemamawieka kename 'akamurixɨ","poem":2},{"lineBreak":true},{"text":"'itsɨ kɨmana pemɨtiweiwakai,","poem":2},{"text":"matsi kuu xewitɨ kanayenemɨkɨ","poem":1},{"text":"kuu nanayaritsie,","poem":2},{"lineBreak":true},{"text":"mɨkɨ nuiwarieya kuu hawiwetɨ kanayeimɨkɨ.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Kemɨ'ane memɨnanaimarie muxatsi wahepaɨ mepɨtetikwani,","poem":1},{"text":"memɨteheuyehɨwa 'aixɨa 'anemekɨ mepɨka'uxipieni.","poem":2},{"text":"Matsi wananayari haakakɨ nepɨmieni,","poem":1},{"text":"memuyuhayewa nekaniwaka'unamɨkɨ.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Keneutatsuakani meta keneutahiwani, kiekari 'ituparieya.","poem":1},{"text":"Keneuyɨyɨakani marikakɨ, naitɨ Piritsiteu kwieyari.","poem":2},{"text":"Matsi tayeta kuyaxi kɨtsi haiyari hepaɨ meteyuxexeiyatɨ 'umekanayehuni,","poem":1},{"text":"meta nixewitɨ pɨkahanayeyeika yu'utuma kememɨtehewetɨka.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"¿Ke'aneme niuki tepɨwayetuirieni tupiritsixi mɨkɨ nuiwaritsie miemete?","poem":1},{"text":"Kename Yawé Tsiyuni 'a'utake,","poem":2},{"text":"mana memuyuti'awietakɨ","poem":1},{"text":"teɨterimama memɨte'ukakukuine.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/13.json","previousChapterAudioLinks":{},"numberOfVerses":32}