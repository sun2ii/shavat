{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":15,"content":[{"type":"heading","content":["Niuki Muhawi hepaɨtsita mieme"]},{"type":"verse","number":1,"content":["Niuki Muhawi hepaɨtsita mieme:",{"text":"'Axi kiekariyari Muhawi kwieyaritsie mukuma, kaniuka'unarieni,","poem":1},{"text":"xeitɨkariyaritsie kaneutipariyarieni.","poem":2},{"text":"Kixi kiekariyari Muhawi kwieyaritsie mukuma, kaniuka'unarieni,","poem":1},{"text":"xeitɨkariyaritsie kaneutipariyarieni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Riwuni kiekatari tukita mekaneutahakeni,","poem":1},{"text":"kakakaɨyarixi memɨte'atimawiyarɨwatsie, memɨtitsuanikɨ.","poem":2},{"text":"Muhawi kaniutatsuakani","poem":1},{"text":"Newu hetsiemieme meta Merewa.","poem":2},{"text":"Yunaitɨ yumu'utsie mekanimu'uxirietɨkani,","poem":1},{"text":"meta yɨmɨxiya naime mekanataxitɨkani.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yunaitɨ, mekaniutitsuanani,","poem":1},{"text":"kaye 'utɨma mekaniu'uwani, hiwerika kamixayari me'anakatɨtɨkaitɨ.","poem":2},{"lineBreak":true},{"text":"Kii heima mekaniutitsuanani meta teɨteri memayukuxexeɨriwatsie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hetsiwuni meta 'Eraré karima mekaniutihiwani,","poem":1},{"text":"Yahatsa mɨrakutewatsie paitɨ kana'eniɨriɨkɨni wahiwari.","poem":2},{"text":"'Ayumieme memɨkamama muhawitsixi mekaniutihiwani,","poem":1},{"text":"peru mekaniutiyɨyɨakani marikakɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne 'iyari Muhawi hetsiemieme kaniutahiwani,","poem":1},{"text":"memuyu'unatɨwe Tsuhaxi paitɨ mekanekɨkani,","poem":2},{"lineBreak":true},{"text":"meta 'Ekɨrati-Tseritsiya paitɨ.","poem":2},{"text":"Ruhiti paitɨ mekananutikɨkani me'utitsuatɨ,","poem":1},{"text":"'uximatɨarikatsata, mekaniutihiwani me'u'uxetɨri","poem":2},{"lineBreak":true},{"text":"Kurunahini huyeyari 'utɨma.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Haa kanakawaxɨani Nimirini mieme,","poem":1},{"text":"tupiriya kaniutiyɨnare.","poem":2},{"text":"'Ɨtsiri kaniumaweni,","poem":1},{"text":"tiyɨratɨ tixaɨtɨ pɨkatiyuhayewaxɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Ayumieme mekatenetɨni,","poem":1},{"text":"Hapuri 'akiyari manuyeka matsi huma paitɨ,","poem":2},{"lineBreak":true},{"text":"waɨkawa piinitɨarika memɨte'ukuxeɨriekai.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Me'u'uxetɨ memutihiwa","poem":1},{"text":"Muhawi kwieyari manuye'atɨkatsie paitɨ kaniumieni.","poem":2},{"text":"'Ekɨrahini paitɨ watsuari kaniye'axeni,","poem":1},{"text":"metatsiere Wexi-'Erini kaniye'axeni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Rimuni hayaritsie xuriyakɨ pɨhɨpɨne,","poem":1},{"text":"matsi tawarita kwiniya nekanikawiwimɨkɨ:","poem":2},{"text":"xeime maye nepanɨnɨ'ani muhawitsixi memuyuta'unaxɨa wahetsiemieme","poem":1},{"text":"meta kemɨ'ane 'akuxi kwiepa memu'uwani wahetsiemieme.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}