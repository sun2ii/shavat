{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"Muxatsi xekenanɨ'airi 'ikɨ kwieyaritsie mɨti'aita hetsɨa,","poem":1},{"text":"Tseratsie meyekɨneme makumawetsie 'utɨa,","poem":2},{"lineBreak":true},{"text":"meta Tsiyuni niweya hɨriyaritsie paitɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Ukarawetsixi muhawitsixi,","poem":1},{"text":"'Axinuni mayekunitsie,","poem":2},{"text":"wikixi memutamariutsieni hepaɨ mepɨteyuxexeiya,","poem":1},{"text":"memamatɨ yu'itua memuku'e'eiriwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«Ketaneuta'ɨxatsitɨa,","poem":1},{"text":"yaketineɨyɨhɨawi.","poem":2},{"text":"Tuka yemekɨ muhekɨakatsie,","poem":1},{"text":"'a'etɨriya kenetawerani tɨkarikɨ hepaɨ.","poem":2},{"text":"Memuyuta'unaxɨa keniwaruti'awieta,","poem":1},{"text":"memuyu'awieta pepɨkawaruku'e'eiriwani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Muhawitsixi memuyuta'unaxɨa keniwarupitɨa","poem":1},{"text":"'ahetsie memuyuti'awietakɨ.","poem":2},{"lineBreak":true},{"text":"Keniwakweriwayurieka tiyuka'uname hepaɨtsita».","poem":2},{"lineBreak":true},{"text":"Kepauka kememɨtekwinitɨariekai meutipare,","poem":1},{"text":"meta kememɨteka'unarienikekaikɨ mana mɨtiu'anitsie,","poem":2},{"lineBreak":true},{"text":"kwiepa mɨtatsi'aye'unie kanikumawerimɨkɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Heitseriemekɨ 'uweni 'apuweni,","poem":1},{"text":"xewitɨ Rawiri nuiwarieyatɨtɨ","poem":2},{"lineBreak":true},{"text":"mana katinita'aitamɨkɨ 'aixɨa 'anemekɨ:","poem":2},{"text":"'itsɨkame mɨ'ɨtetsa heitserie mɨtikuxatani kanayeimɨkɨ","poem":1},{"text":"meta 'inaketɨ 'aixɨa mɨtiyurieneni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mɨpaɨ tekatenimaika Muhawi","poem":1},{"text":"yemekɨ kaniyuta'ɨreni,","poem":2},{"text":"tepɨtemate kemɨtiuyukatawe'erie,","poem":1},{"text":"kemɨtiuyutamariwekata meta kemɨtiyukananaima,","poem":2},{"lineBreak":true},{"text":"ke'axamɨtiuxaxata kayu'enietɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Ayumieme meputitsuana Muhawitsixi,","poem":1},{"text":"mɨkɨ yunaitɨ Muhawi hetsiemieme meputitsuana.","poem":2},{"text":"Xekeneutitsuanani, xekeneyuhiwerieka,","poem":1},{"text":"kaxie patsaruyari tsuirayari Kixi-Karetseti miemekɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hetsiwuni mɨraka'etsitɨretsie katiniutiyɨnare,","poem":1},{"text":"yaxeikɨata Tsiwima mieme kaxie haraweriyari.","poem":2},{"text":"Nuiwarite tewa'aitɨwamete","poem":1},{"text":"kaxie 'aixɨa mɨ'anenekai mekaniutiketsini,","poem":2},{"text":"Katsexi paitɨ mɨye'axekai","poem":1},{"text":"meta makumawetsie paitɨ mɨye'akai.","poem":2},{"text":"Nanarieya 'ateewa pɨta'atɨkatei","poem":1},{"text":"haramaratsie paitɨ pɨye'akai.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Ayumieme neputatsuaka, Katsexi kemɨtiutatsuaka hepaɨ,","poem":1},{"text":"kaxie Tsiwima miemekɨ.","poem":2},{"text":"Xemeta, Hetsiwuni kiekariyari meta 'Eraré,","poem":1},{"text":"ne'ukaikɨ nepɨxetihawiya.","poem":2},{"text":"Temawierika hiwariyari pepeunuitɨa","poem":1},{"text":"'a'ikwaxi witsitikwakwaxime meta kepemɨtika'inɨwekai hetsiemieme.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Harawerita pumaweri temawierika.","poem":1},{"lineBreak":true},{"text":"Nixewitɨ kaxie harawerita pɨkaheyekwika meta pɨkahahiwa,","poem":1},{"text":"nixewitɨ kaxie pɨkaketsinane muwatiketsinarɨwatsie,","poem":2},{"lineBreak":true},{"text":"ne hiwari kaxie tsata mieme nekaneutiparitɨani.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Ayumieme netaɨta neputayɨyɨaka Muhawi hetsiemieme,","poem":1},{"text":"'aripatsie manutiwɨ hepaɨ puyɨne,","poem":2},{"lineBreak":true},{"text":"naitɨ ne'iyari puyuane Kixi-Karetseti hetsiemieme.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tsepa muhawi kiekatari kakaɨyarixi memɨte'atimawiyarɨwa memɨteheutahake,","poem":1},{"text":"tixaɨtɨ mepɨkatekaxeiya matsi xeikɨa mepɨti'uxe,","poem":2},{"text":"kepauka yutukita memuyunenewiyu,","poem":1},{"text":"tsepa kememɨyɨa yakɨ xeikɨa mepɨyɨaka.","poem":2}]},{"type":"verse","number":13,"content":["'Ikɨ Yawé kaniniukieyatɨni meripaitɨ kemutayɨ Muhawi hepaɨtsita mieme."]},{"type":"verse","number":14,"content":["Hikɨ matsi Yawé mɨpaɨ kanaineni: «Haika wiyari ka'anuyeyeiwekaku, ti'uximayatame kemɨtiu'inɨnɨata hepaɨ ti'inɨaritɨ, 'ana kemɨtimariwe Muhawi meta teɨterimama memɨyumɨire mepɨnanaimarieni, yayupaɨmetɨ xeikɨa mepuyuhayewa meta memɨwerarani mekaniyuhayewakuni»."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/15.json","previousChapterAudioLinks":{},"numberOfVerses":14}