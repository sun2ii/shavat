{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":17,"content":[{"type":"heading","content":["Niuki Ramatsiku hepaɨtsita mieme"]},{"type":"verse","number":1,"content":["Niuki Ramatsiku hepaɨtsita mieme:",{"text":"«Ramatsiku xekeneuxeiya.","poem":1},{"text":"Kiekariri pɨkahɨkɨtɨni.","poem":2},{"lineBreak":true},{"text":"'Unitɨ kwinie netɨ kanikemɨkɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kiekarite 'Aruhexi mieme","poem":1},{"text":"kaniku'eiriwamɨkɨ,","poem":2},{"text":"'ɨ'ɨxayatɨ kanayeimɨkɨ mana muxatsi","poem":1},{"text":"mekatenitikwaikuni nixewitɨ kawamariutakaku.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Epɨrahini kiekari mɨtɨrɨkaɨye kaneuyehɨamɨkɨ,","poem":1},{"text":"Ramatsiku ti'aitame kahexeiyatɨ kaniyuhayewamɨkɨ.","poem":2},{"text":"'Arami memuyukuhayewaxɨ meta tita memɨtehexeiyakai","poem":1},{"text":"mɨkɨ 'ixaheritsixi waniwema wahetsiemieme katinayeimɨkɨ","poem":2},"―mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye―."]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"»'Iya tukaritsie","poem":1},{"text":"Kakuwu kemɨtimariwekai kanitaweranaxɨamɨkɨ","poem":2},{"lineBreak":true},{"text":"meta kemɨtiwaiyakai kanitawamɨkɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tɨriku 'itsaname hepaɨ kani'anekamɨkɨ,","poem":1},{"text":"yumamakɨ tɨriku 'uriyari pɨka'itsana,","poem":2},{"text":"kepauka 'uriyari manukutɨkieni","poem":1},{"text":"Xepahini mayeweritsie hepaɨ pɨtiyɨni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Peru hipatɨ puyuhayewa,","poem":1},{"text":"kepauka huriwu manuyekatsiwa hepaɨ,","poem":2},{"text":"hutatɨ yatɨni haikatɨ takari puyukuhayeikawa","poem":1},{"text":"xawaritetsie meutitetewatsie,","poem":2},{"text":"heiwatɨ naukatɨ yatɨni 'auxɨwitɨ","poem":1},{"text":"naime xawarite kɨyeyaritetsie».","poem":2},"Yawé mɨpaɨ kanaineni, 'Ixaheri Kakaɨyarieya."]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"'Iya tukaritsie","poem":1},{"text":"tewi, kemɨ'ane mitawewi pɨtiwauni,","poem":2},{"lineBreak":true},{"text":"Mɨpatsie 'Ixaheri hetsiemieme kwi pɨxeiya.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kakaɨyarixi memɨte'atimawiyarɨwari pɨkaxeiya","poem":1},{"text":"mitiwewiekai,","poem":2},{"text":"meta kakaɨyarixi 'Atserá 'ɨkiyarite pɨka'anakuxeiya,","poem":1},{"text":"meta hakewa 'ɨkwa matitaiyakaitsie","poem":2},{"lineBreak":true},{"text":"mɨtiutiwewiekai.","poem":2}]},{"type":"verse","number":9,"content":["'Iya tukaritsie kiekarite mɨtɨrɨkawi, muku'eiriwaxɨ 'ixaheritsixi ya'aneme meheutiwiwiexɨaku, kiekarite muku'eiriwaxɨ hepaɨ tiyuxexeiyatɨ kanayeimɨkɨ 'uhukuyatɨ meta 'u'ɨtsiyatɨ mayeika hepaɨ. Naitɨ 'akumawetɨ kanayeimɨkɨ."]},{"type":"verse","number":10,"content":[{"text":"'Akakaɨyari metsiwikweitsitɨwame pematɨmaikɨ,","poem":1},{"text":"'ai mɨmatsitseiriya pemɨkahaye'erikɨ.","poem":2},{"text":"'Ayumieme, tsepanetɨ 'iteɨri 'aixɨa 'aneme pemuka'iteɨtaxɨ","poem":1},{"text":"meta tsepa kaxie 'ateewa mieme pemukayatsaxɨ,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"tsepanetɨ tsipemɨtikuweriya 'apemɨtika'iteɨtaxɨtsie paitɨ,","poem":1},{"text":"meta tsepanetɨ 'uxa'arieka pemitixutuitsitɨa,","poem":2},{"text":"kukuiniya tukariyaritsie meta kwiniya mɨkayu'uayemarinɨa tukariyaritsie,","poem":1},{"text":"tixaɨtɨ pɨkatikaxuawere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Xɨa'ui yumɨiretɨ nuiwarite wayuarika.","poem":1},{"text":"Haramara kemɨtiutapauwarɨka mɨpaɨ meputaine.","poem":2},{"text":"Xɨa'ui teɨteri wahiwari.","poem":1},{"text":"Wayuarika haa 'ateewa meukaxɨrɨweni hepaɨ meputaine.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tsepanetɨ mɨkɨ teɨteri memutihiwa haa 'ateewa meukaxɨrɨweni hepaɨ tiyu'eniɨriɨkɨmekɨ,","poem":1},{"text":"kepauka mɨkɨ mɨwarutate'a mepuyuta'una,","poem":2},{"text":"'ekakɨ mepu'enitsitɨariexime","poem":1},{"text":"xatsi hɨritetsie mieme hepaɨ,","poem":2},{"lineBreak":true},{"text":"meta 'eka tɨrɨkaɨyetɨ kwauni mu'enitsitɨaximeni hepaɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kutaikaireyu, mekaniutimariutsiwani.","poem":1},{"text":"Kakatariwekaku 'akuxi, mepukumamawere.","poem":2},{"text":"Mɨpaɨta mepɨte'anuyekɨne kemɨ'ane memɨtatsitaweiya,","poem":1},{"text":"mɨpaɨta ti'anetɨ wahetsie 'upɨramie kemɨ'ane takie memɨtenawatɨwe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/16.json","previousChapterAudioLinks":{},"numberOfVerses":14}