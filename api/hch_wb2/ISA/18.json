{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":18,"content":[{"type":"heading","content":["Niuki 'Etihupiya hepaɨtsita mieme"]},{"type":"verse","number":1,"content":[{"text":"Xɨa'ui kwie waɨkawa 'utsikari memutitsiwarɨkatsie","poem":1},{"text":"Kutsi hatɨayarite manuyehetsie matsi humapaitɨ,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Niru hayari 'utɨma","poem":1},{"text":"tupiritsixi pɨwarayenɨ'awa haka kanuwayaritsie.","poem":2},{"lineBreak":true},{"text":"Xekeneuhuni, tupiritsixi kwinimieme xemayɨwawe,","poem":1},{"text":"xeime kwieyaritsie teɨteri kwinie me'utɨtɨ memaxuawetsie meta yuwaiyaritsie meheumerɨkawitɨ,","poem":2},{"text":"mɨkɨ nuiwari naitsarie kiekaritsie mɨmakaxiwa,","poem":1},{"text":"mɨkɨ nuiwari mɨtɨrɨkaɨye mɨtiyu'aitɨwa,","poem":2},{"lineBreak":true},{"text":"mɨkɨ kiekari haa 'anuyehapanekaku mukuma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kepauka hɨritsie","poem":1},{"text":"'inɨari manukuhanieni meta kuxineta metayuani,","poem":2},{"text":"xekeneyɨ'ɨwiya, kwiepa xemɨtama,","poem":1},{"text":"xekeneu'enana, 'ikɨ kwietsie kiekatari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mɨpaɨ Yawé kanetiniutahɨawe:","poem":1},{"text":"«Muyuawitsie paitɨ kayuwatɨ nehexeiyatɨ nekanakanierekamɨkɨ,","poem":2},{"text":"tau xawatɨriyaya hepaɨ,","poem":1},{"text":"haɨtsi hai kemɨranutinenetɨwa hepaɨ 'uxɨkakaku kepauka mɨtiuka'inɨiwatsie».","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Katika'inɨiyawekaku 'akuxi,","poem":1},{"text":"kepauka tuturi mɨkawiwieni meta kaxie takari mutikwakwaxe,","poem":2},{"text":"'ana yɨrariyari kanikawitekiemɨkɨ","poem":1},{"text":"meta xawari nanari naitɨ kanewatihunariexɨamɨkɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mɨkɨ naitɨ kaniku'eiriwamɨkɨ,","poem":1},{"text":"wirɨkɨxi hɨritsie kiekatari","poem":2},{"lineBreak":true},{"text":"meta yeutari teyukwa'amete wahetsiemieme katinayeimɨkɨ,","poem":2},{"text":"witaritata","poem":1},{"text":"kwixɨri wa'ikwai katinayeimɨkɨ,","poem":2},{"text":"muhaɨtɨnitsieta,","poem":1},{"text":"yunaitɨ yeutari teyukwa'amete.","poem":2}]},{"type":"verse","number":7,"content":["'Iya tukaritsie mɨkɨ teɨteri 'amemutɨtɨ meta yuwaiyaritsie memeumerɨkawi, teɨteri mɨkɨ naitsarie memɨmakaxiwa, mɨkɨ nuiwari memɨtɨrɨkaɨye memɨteyu'aitɨwa, wakiekari haa 'anuyehapanekaku mɨyema, Yawé Naimekɨmɨtɨrɨkaɨye mawari mekaniwewiriekuni. Tsiyuni hɨriyaritsie mekanenutɨkiriekuni hakewa mekiena kemɨtitewakɨ Yawé Naimekɨmɨtɨrɨkaɨye."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/17.json","previousChapterAudioLinks":{},"numberOfVerses":7}