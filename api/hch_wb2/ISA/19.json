{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":19,"content":[{"type":"heading","content":["Niuki 'Ekipitu hepaɨtsita mieme"]},{"type":"verse","number":1,"content":["Niuki 'Ekipitu hepaɨtsita mieme:",{"text":"Yawé xekeneuxeiya.","poem":1},{"text":"'Ekipitu kaniye'aka hai kwinimieme 'ayɨweme hetsie 'akaitɨ.","poem":2},{"text":"'Ekipitu miemete kakaɨyarixi","poem":1},{"text":"me'ixeiyatɨ mekaniutiyɨyɨakani,","poem":2},{"text":"'ekipitutari wa'iyari","poem":1},{"text":"kanitiweranareni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«Yanekatiniyurimɨkɨ 'ekipitutari memayuye'uniekakɨ,","poem":1},{"text":"yu'iwamatɨ mepuyutakwini,","poem":2},{"text":"yuhamikumatɨ mepuyutakwini,","poem":1},{"text":"kiekarite mepuyutakwini,","poem":2},{"lineBreak":true},{"text":"te'aitamete mepuyutakwini.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Ekipitutari mekayuwaɨriyatɨ mepakɨne","poem":1},{"text":"meta yukakaɨyarixi mekaniwatahɨawikuni:","poem":2},{"text":"meta mɨkite wa'iyarite,","poem":1},{"text":"teyukewaiyamete meta mɨkite wahamatɨa memɨtekuxata meta memɨtehetimamateke,","poem":2},{"lineBreak":true},{"text":"ne matsi kememɨteku'eriwa nepɨkawapitɨani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nepɨwapitɨani 'axamete'u'iyaritɨ memɨtewata'uximayatsitɨanikɨ,","poem":1},{"text":"ti'aitame 'axatiuka'iyaritɨ katiniwata'aitɨamɨkɨ»,","poem":2},{"text":"Ti'aitame mɨpaɨ kanaineni,","poem":1},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Niru hayari pakawani,","poem":1},{"text":"xiekari xeikɨa wakitɨ pahekɨare.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Haa muhapanekaitsie 'axapɨraye'ɨatɨkani,","poem":1},{"text":"meta 'Ekipitu 'akiyarite pakawaxɨani,","poem":2},{"lineBreak":true},{"text":"yemekɨ 'uwakitɨ puyuhayewa.","poem":2},{"lineBreak":true},{"text":"'Uwá meta haka hatetsita mieme kanitiyɨnarimɨkɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Niru hatetsitayaritsie,","poem":1},{"text":"haa hakewa meye'akai,","poem":2},{"lineBreak":true},{"text":"naitɨ pɨkaretsiɨraɨyeniri.","poem":2},{"text":"Niru 'aurie naitɨ mɨti'etsiekai","poem":1},{"text":"'akumawetɨ puyuhayewa, pɨtikumawere.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yunaitɨ ketsɨteweiyamete mepɨtitsuani mepuyutihiwerieni,","poem":1},{"text":"Niru hetsie kemɨ'ane kwaitsɨ memeukawiwiwa,","poem":2},{"lineBreak":true},{"text":"wipi memɨwiwietɨwe mekani'amɨxɨakuni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Me'iyɨrietɨ mekanakɨnikuni memɨte'uximaya rinu 'aixɨa meyurietɨ,","poem":1},{"text":"kememɨteta'ikwewa rinukɨ 'itsamete mekateneuyehɨakuni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mepɨ'iyɨrienita 'ixuriki memɨwewie,","poem":1},{"text":"yunaitɨ te'uximayatamete mekaniyutihɨawikuni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tsuhani kiekatari memanuyetei 'atsimemɨkatemate mepɨhɨkɨ,","poem":1},{"text":"'ɨxatsitamete waɨkawa memɨtemaiwawe","poem":2},{"lineBreak":true},{"text":"Parahuni mepɨ'ɨxatsitɨa tixaɨtɨ 'atsimekatemaitɨ.","poem":2},{"text":"¿Titayari mɨpaɨ xete'ikɨhɨawe:","poem":1},{"text":"«Ne xewitɨ memɨtemaiwawe nekanihɨkɨtɨni,","poem":2},{"lineBreak":true},{"text":"te'aitamete meripaitɨ miemete memɨnete'uta'ɨkitɨa»?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"¿Kwinimieme pemɨtimaiwekai hakewa peyuhayewaxɨ?","poem":1},{"text":"Peketiuxeitsitɨarieni meta peketiutaxatɨarieni","poem":2},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye","poem":1},{"text":"'Ekipitu hepaɨtsita kemɨtiyurimɨkɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tsuhani kiekatari memanuyetei 'atsimemɨkatemate mepakɨ,","poem":1},{"text":"Menipitsi kiekatari memanuyetei mepɨte'u'irɨwiyarie.","poem":2},{"text":"Teɨteri watetexi memɨhɨkɨtɨkai tsikurita mieme","poem":1},{"text":"'Ekipitu mepeuyehɨa kemɨtimiekai.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yawé wahetsie pupitɨa","poem":1},{"text":"'iyari 'iyɨriwame.","poem":2},{"text":"'Ekipitu naimekɨ kemɨtiyuriene","poem":1},{"text":"kemɨtimiekai mekaneiyehɨani.","poem":2},{"text":"Tawekame mutahewa hepaɨ,","poem":1},{"text":"'Ekipitu kanitakitsarietɨyeikani.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Ekipitu hetsie 'aixɨa mutiuyurieni pɨkayɨwe,","poem":1},{"text":"tsepa mu'uya mɨhɨkɨ yatɨni kwaxieya, yatɨni takɨ yatɨni haka.","poem":2}]},{"type":"verse","number":16,"content":["'Iya tukaritsie 'ekipitutari 'ukari wahepaɨ mepɨteyuxexeiyani. Meputiyɨyɨakani marikakɨ kepauka Yawé Naimekɨmɨtɨrɨkaɨye yumamá manukuhana 'iyuitɨwatɨ yukuha'aritɨwatɨ mɨtiwakwinitɨanikɨ."]},{"type":"verse","number":17,"content":["Kura kwieyari 'ekipitutari mepimakaxeni. Yawé Naimekɨmɨtɨrɨkaɨye kemɨtiyurimɨkɨ wahepaɨtsita mieme, Kura kwieyari xɨka haterɨwarɨwani kemɨ'ane memi'enieni me'enaname waɨkawa meputimamaweni."]},{"type":"verse","number":18,"content":["'Iya tukaritsie 'Ekipitu kwieyaritsie 'auxɨwitɨ kiekari pukumare kananitari waniukikɨ me'utiniutɨ, Yawé Naimekɨmɨtɨrɨkaɨye hetsie memɨtewiyanikɨ yamepɨtiyuani. Mɨkɨ xewitɨ Tau Kiekariyari pɨtitewaka."]},{"type":"verse","number":19,"content":["'Iya tukaritsie Yawé hetsiemieme mawari taiyame xewitɨ 'Ekipitu kwieyari hixɨapa pɨtakeni, metatsiere kwieyari manuye'atɨkatsie tete pɨtakerieni Yawé hetsiemieme."]},{"type":"verse","number":20,"content":["Mɨkɨ 'inɨari pɨhɨkɨtɨni 'Ekipitutsie ma'eriwanikɨ Yawé Naimekɨmɨtɨrɨkaɨye. Kepauka mɨkɨ Yawé memɨtahɨawe waɨriyarika memɨtewa'aitɨa wahepaɨtsita, mɨkɨ wawikweitsitɨwame kaniwaranɨ'airiemɨkɨ meta wahetsie nunuwame kaniwaxɨnamɨkɨ."]},{"type":"verse","number":21,"content":["'Ayumieme Yawé 'ekipitutari wahetsie matsiɨkɨme kanayuyeitɨamɨkɨ, 'iya tukaritsie mɨkɨ Yawé mekanetimaikuni: mawari me'iwewirietɨ mekaneyexeiyakakuni hatsite mekateniyetuiriwakuni, Yawé hetsiemieme yamekateniyɨhɨritɨakuni meta mekateneye'atɨiriekuni."]},{"type":"verse","number":22,"content":["Yawé 'ekipitutari katiniwakwinitɨamɨkɨ, tiwakwinitɨametɨtɨ kaniwa'uayemamɨkɨ. Mɨkɨ Yawé hetsɨa mekani'axɨakuni, mɨkɨ kaniwa'enimɨkɨ kememɨte'ikɨhɨaweni meta 'aixɨa meteheu'eriekame puwarayeitɨani."]},{"type":"verse","number":23,"content":["'Iya tukaritsie huye pɨtixuawere 'Ekipitu yehanetɨ 'Atsiriya ye'atɨ. 'Atsiriya kiekatari 'Ekipitu mepɨyehu meta 'Ekipitu kiekatarita 'Atsiriya mepɨyehu, yuxexuitɨ mɨkɨ meyunɨtɨ Kakaɨyari mepayexeiyani."]},{"type":"verse","number":24,"content":["'Iya tukaritsie 'Ixaheri puhɨkɨtɨni, 'Ekipitu meta 'Atsiriya meyunɨtɨ, kwiepa memɨtama 'aixɨa mepɨ'itɨarieni wakɨmana."]},{"type":"verse","number":25,"content":["Yawé Naimekɨmɨtɨrɨkaɨye 'aixɨa kaniwayurimɨkɨ, mɨpaɨ 'utaitɨ: «'Aixɨa kani'itɨarieka 'Ekipitu neteɨterima meta 'Atsiriya nemɨwarutawewi, metatsiere 'Ixaheri neteɨterima nemɨwaranayexei memɨhɨkɨ»."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/18.json","previousChapterAudioLinks":{},"numberOfVerses":25}