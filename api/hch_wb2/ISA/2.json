{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":2,"content":[{"type":"heading","content":["Yawé hɨrieya"]},{"type":"verse","number":1,"content":["Kitsariyaxi kemɨtiunieritɨarie 'Amuxi nu'aya Kura hetsiemieme meta Kerutsareme:"]},{"type":"verse","number":2,"content":[{"text":"'Imatɨrieka tukaritsie,","poem":1},{"text":"hɨri Yawé kiiya manuwe pɨkawatayuitɨarieni","poem":2},{"lineBreak":true},{"text":"matsi 'a'utewitɨ kanayeimɨkɨ,","poem":2},{"text":"hɨrite naime kana'iwamɨkɨ,","poem":1},{"text":"hetsɨana yunaitɨ nuiwarite mekani'axɨakuni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Teɨteri meyumɨiretɨ mekani'axɨakuni, meta mɨpaɨ mekanitiyuakuni:","poem":1},{"text":"«Xekenakɨni, Yawé hɨrieyatsie tepanutikɨne,","poem":2},{"lineBreak":true},{"text":"Kakuwu Kakaɨyarieya kie,","poem":2},{"text":"yuhuye mɨtatsiheta'ɨkitɨanikɨ","poem":1},{"text":"meta huyetana xeikɨa temuhunikɨ».","poem":2},{"text":"Karikɨ Tsiyunitsie xeikɨa 'ɨkitɨarika kanayenexɨamɨkɨ,","poem":1},{"text":"meta Kerutsaremetsie Yawé niukieya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mɨkɨ nuiwarite watsata kaniwataxanetamɨkɨ","poem":1},{"text":"meta mɨkɨ yuwaɨkawame wa'itsɨkame kanihɨkɨtɨkamɨkɨ.","poem":2},{"text":"Yu'ixipara hararu mepayeitɨaxɨani","poem":1},{"text":"meta yupitsika 'ɨxa xikame mekanayeitɨaxɨakuni.","poem":2},{"text":"Nuiwariteri 'ixiparakɨ mepɨkayutakwini,","poem":1},{"text":"tawariri mepɨkayuti'ɨkitɨani kuyaxa miemekɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kakuwu kiekarieya, niwa kenaye'a,","poem":1},{"text":"Yawé hekɨariyayatsie tepuhuni.","poem":2}]},{"type":"heading","content":["Yawé tukarieya"]},{"type":"verse","number":6,"content":[{"text":"'Ateɨterima pepɨwaruku'eiri,","poem":1},{"text":"Kakuwu nuiwarimama,","poem":2},{"text":"tau manatineika kiekatari muyuawitsie miemekɨ memɨteyɨ'ɨkitɨa wayeiyarikɨ memɨhɨpɨnekɨ,","poem":1},{"text":"meta memɨtehetimamateke piritsiteutsixi kememɨtewarexeiya wahepaɨ,","poem":2},{"lineBreak":true},{"text":"meta tɨratu mepuyuwewirie 'ateewa kiekatari wahamatɨa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wakwietsie huru meta pɨrata pɨhɨne,","poem":1},{"text":"mɨraye'atɨka memɨteheuxeiya pɨkati'inɨari.","poem":2},{"text":"Wakwietsie kawayutsixi kwinimieme mepɨte'ane,","poem":1},{"text":"meta wakaxetate kuyaxa mieme pɨkati'inɨari.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wakwietsie kakaɨyarixi memɨwewiyatɨka mepɨhɨne,","poem":1},{"text":"teɨteri yuwewiya hɨxie mepukatunuma'uwe,","poem":2},{"lineBreak":true},{"text":"yumamakɨ ketitamemɨte'utiwewi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tewi tixaɨtɨ pɨkarayeitɨariwa,","poem":1},{"text":"tewi pɨkayɨwe 'atsimɨtiuyurieni.","poem":2},{"lineBreak":true},{"text":"Pɨkayɨweri pemɨtiwareuyehɨwirieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"'Aitá keneutahaki,","poem":1},{"text":"kwauni tsata keneuyuti'awieta","poem":2},{"text":"Yawé pe'ayemakatɨ","poem":1},{"text":"meta witsikemɨ'anekɨ mariwetɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kwinimieme mɨtiyuta'ɨre hɨxiteya tixaɨtɨ pɨkarayeitɨarieni","poem":1},{"text":"teɨteri kememɨteyuti'ɨre kanititunariexɨariemɨkɨ.","poem":2},{"text":"'Iya tukaritsie Yawé xeikɨa 'aixɨa katinikuxaxatsiwamɨkɨ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yawé Naimekɨmɨtɨrɨkaɨye xeime tukaritsie kanayenemɨkɨ","poem":1},{"text":"yunaitɨ memuyuti'ɨre meta mamariwaweme memayuyeitɨwa wahepaɨtsita,","poem":2},{"lineBreak":true},{"text":"yunaime memuyuti'ukita wahepaɨtsita, tixaɨtɨ mekatehɨkɨtɨme mɨwarayeitɨanikɨ,","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"kariuxa Riwanutsie mieme, muyuti'ɨre meta kwinimieme mutɨtɨ hepaɨtsita,","poem":2},{"lineBreak":true},{"text":"meta naime xiu Watsanitsie mieme hepaɨtsita,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"hɨri naime 'amutɨtɨtsie mieme hepaɨtsita,","poem":2},{"lineBreak":true},{"text":"meta yemurite 'amutɨtɨ hepaɨtsita,","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"tuxiyu kwinimieme mutɨtɨ naime hepaɨtsita,","poem":2},{"lineBreak":true},{"text":"kuraru mɨtɨrɨkawi hepaɨtsita,","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"yunaime kanuwate 'amupapa Taritsi mɨye'axe wahepaɨtsita,","poem":2},{"lineBreak":true},{"text":"meta yunaime kanuwate 'amupapa witsimɨ'anene wahepaɨtsita.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tewi kwinimieme mɨtiyuta'ɨre kanititunariexɨamɨkɨ,","poem":1},{"text":"teɨteri kememɨteyuti'ɨre tixaɨtɨ pɨkarayeitɨarieni.","poem":2},{"text":"'Iya tukaritsie Yawé xeikɨa 'aixɨa katinikuxaxatsiwamɨkɨ,","poem":1}]},{"type":"verse","number":18,"content":[{"text":"meta yuri memɨkakakaɨyarixi yuheyemekɨ mepukumaweriyarieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Teɨteri terɨta mekaneutahaxɨakuni,","poem":1},{"text":"meta kwiepa makutsitsinitsie,","poem":2},{"text":"Yawé me'ayemakatɨ","poem":1},{"text":"meta witsikemɨ'anekɨ mariwetɨ,","poem":2},{"text":"kepauka mɨkɨ manukukenitsie","poem":1},{"text":"kwie tayuitɨanike.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"'Iya tukaritsie tewi","poem":1},{"text":"yukakaɨyarixi hurukɨ memɨwewiyatɨka meta pɨratakɨ,","poem":2},{"text":"mɨkɨ mɨwarutiwewiekai muwarayexeiyanikɨ,","poem":1},{"text":"teuxari meta 'atsixi memuyekietsie puwareutaxɨrieni.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Tetexi terɨyarita kaneutahamɨkɨ","poem":1},{"text":"meta 'ai mukatatarita,","poem":2},{"text":"Yawé me'ayemakatɨ","poem":1},{"text":"meta witsikemɨ'anekɨ mariwetɨ,","poem":2},{"text":"kepauka mɨkɨ manukukeni","poem":1},{"text":"kwie mɨwatayuitɨanikɨ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Tewitsie yuri xete'erietɨ xeketeneuhayewa,","poem":1},{"text":"mɨkɨ 'etsiwa xeikɨa katinaye'aka.","poem":2},{"lineBreak":true},{"text":"Tukarieya xeihɨtsieriyari kanihɨkɨtɨni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}