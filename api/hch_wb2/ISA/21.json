{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":21,"content":[{"type":"heading","content":["Niuki Wawiruniya hepaɨtsita mieme"]},{"type":"verse","number":1,"content":["Niuki makumawe haramara 'aurie mukuma hepaɨtsita:",{"text":"Nekexi muyekɨka haikɨri mɨtɨrɨkaɨye hepaɨ,","poem":1},{"text":"kwie makumawetsie xewitɨ kanayeneximeni mariwetɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mariweme nepɨtiuxeiyatsitɨarie","poem":1},{"text":"nepɨtiuhekɨatsitɨiyarie:","poem":2},{"text":"mɨtiyukwamana pɨtiyukananaimaka,","poem":1},{"text":"tiyu'uname pɨtiyuka'unani.","poem":2},{"text":"'Erami keneyumieneni. Meriya kiekatari xeiya xekeneyukwitɨweni.","poem":1},{"text":"Naime hiwerika nepautiparitɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"'Ayumieme newaiyari puyɨyɨaka kukuiniyakɨ,","poem":1},{"text":"'etsipemekɨ kukuiniyakɨ nepɨtiuka'eniwa,","poem":2},{"lineBreak":true},{"text":"niweyame hepaɨ,","poem":2},{"text":"ketitanemɨti'eniekɨ, nepɨtiuka'eniwa,","poem":1},{"text":"ketita nemɨtixeiyakɨ, nemakame pɨnetsi'ayeitɨa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nepɨkaheneta'eriwa,","poem":1},{"text":"nemariutsietɨ xeikɨa nepɨyɨyɨaka,","poem":2},{"text":"taikai kwinimieme mɨnetinakekai","poem":1},{"text":"hikɨri nepimakaxe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mɨkɨ mexate mana mepuku'uitɨa,","poem":1},{"text":"'itari mekanikuwerani,","poem":2},{"lineBreak":true},{"text":"mepɨtekwa'a meta mepɨte'ie.","poem":2},{"text":"Xemanuyetei, 'axekeneti'uka.","poem":1},{"text":"Xekenanuku'uti, yuheima nunuwame xekeneutiwiyama.","poem":2}]},{"type":"verse","number":6,"content":["Yawé mɨpaɨ kanetiniutahɨawe:",{"text":"«Kenemie, xeime tihɨweme keneuketsa,","poem":1},{"text":"mɨtikuxatanikɨ naime kemɨtiniereni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kepauka kaxetate yukukuyamete kawayutsixi mehenawɨtɨakame mɨwaxeiyani,","poem":1},{"text":"yatɨni teɨteri puxuri wahetsie me'utekame yatɨni kameyutsixi wahetsie,","poem":2},{"text":"ke'uniere yukɨ'ɨwiyatɨ,","poem":1},{"text":"waɨkawamekɨ yukɨ'ɨwiyatɨ».","poem":2}]},{"type":"verse","number":8,"content":["Tihɨweme kaniutahiwa:",{"text":"«Ti'aitame, tukari manukayeika,","poem":1},{"text":"tuxiyutsie ne'akawetɨ nepɨkatihayewa,","poem":2},{"text":"tɨkarikɨ mana nepukatariyarɨwa","poem":1},{"text":"kenemɨtihɨritɨarie netita'ɨwiyatɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mana xewitɨ tewi kanamieni","poem":1},{"text":"kaxetatsie kawayutsixi me'ehanatɨ.","poem":2},{"text":"'Ikɨ kaniniukieyatɨni:","poem":1},{"text":"“'Ari Wawiruniya kanatiweni, kanatiweni.","poem":2},{"text":"Naitɨ kakaɨyariximama wa'ɨkiya","poem":1},{"text":"kwiepa katinanukuheni”».","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Neteɨterima, tɨriku mu'urie hepaɨ mɨ'ane,","poem":1},{"text":"ne nekamatinaxaxatɨwani kenemɨtiu'enaxɨ","poem":2},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye hetsiemieme,","poem":1},{"text":"'Ixaheri Kakaɨyarieya.","poem":2}]},{"type":"heading","content":["Niuki 'Erumi hepaɨtsita mieme"]},{"type":"verse","number":11,"content":["Niuki Rumaha hepaɨtsita mieme:",{"text":"Xewitɨ Tsehixi kwieyaritsie paitɨ pɨnetsihehiwie:","poem":1},{"text":"«Tihɨweme, ¿'ɨyɨwitɨ 'akuxi kereutere?","poem":2},{"lineBreak":true},{"text":"Ti'ɨwiyame, ¿mɨkahekɨarekɨ kereutere?»","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tihɨweme mɨpaɨ kaniutayɨni:","poem":1},{"text":"«'Ari kanikahekɨarirɨmeniri, peru yaxeikɨata tɨkari 'ukanamieni.","poem":2},{"text":"Xɨka xeheu'iwaukuni, xekeneku'iwawani,","poem":1},{"text":"xɨka tawari xehayenexɨakuni xekenayenexɨa».","poem":2}]},{"type":"heading","content":["Niuki 'Arawiya hepaɨtsita mieme"]},{"type":"verse","number":13,"content":["Niuki 'Arawiya hepaɨtsita mieme:",{"text":"Kɨkamete Rerani kiekatari,","poem":1},{"text":"makumawetsie 'akɨ'ɨtsiyakaku xemukutei:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"mɨyeharimɨne xekenanunaki","poem":1},{"text":"haa xekeneuharitɨa.","poem":2},{"text":"Temaha kwieyaritsie kiekatari,","poem":1},{"text":"yu'unamete 'ikwai xeketeniwarumikwa,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"mɨkɨ 'ixipara memakatɨ mekaniyu'unarɨmeni,","poem":1},{"text":"'ixipara mɨhekɨa,","poem":2},{"text":"tupi karima mayuhapatɨka","poem":1},{"text":"meta mɨrayukwitɨnetsie.","poem":2}]},{"type":"verse","number":16,"content":["Yawé mɨpaɨ kanetiniutahɨawe: «Xeiwiyari ka'anuyeyeiwekaku, ti'uximayatame mɨtiu'inɨnɨata hepaɨ ti'inɨatsieme, Tseraxi kemɨtimariwekai naitɨ kaneutiparimɨkɨ."]},{"type":"verse","number":17,"content":["Temɨmɨmete 'etsiyupaɨmetɨ mekaniyuhayewakuni, Tseraxi kiekatari yukukuyamete, mana memutawikwei». Yawé mɨpaɨ kaniutayɨni, 'Ixaheri Kakaɨyarieya."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}