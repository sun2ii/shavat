{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":22,"content":[{"type":"heading","content":["Niuki Kerutsareme hepaɨtsita mieme"]},{"type":"verse","number":1,"content":["Niuki mayeweri hepaɨtsita mieme kenemɨtiuxeiyatsitɨarie:",{"text":"Hikɨta kepeyɨane,","poem":1},{"text":"kii heima paitɨ pepanutitɨa,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kiekari waɨkawamekɨ 'axamɨretainetsie,","poem":1},{"text":"mepɨkayu'enie meta mepɨ'ietɨwe.","poem":2},{"text":"'Ateɨterima nixewitɨ 'ixiparakɨ pɨka'umierie","poem":1},{"text":"meta mepɨkahekwi'iwaxɨ mɨrayukwitɨnetsie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Meyunaitɨ 'ahetsɨa memanuyetei mepuyuta'unaxɨ meyunɨtɨ,","poem":1},{"text":"matsi mekaniutiwiyarieni","poem":2},{"lineBreak":true},{"text":"tupi mekahapaxɨawawetɨ 'akuxi.","poem":2},{"text":"Yunaitɨ pemuwaranutaxɨrie mekaniutiwiyarieni","poem":1},{"text":"mexi'akuxi meyuta'unarɨmekai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"'Ayumieme mɨpaɨ neputayɨ: «Nexaɨtame xekeneneuhayewa,","poem":1},{"text":"nekanitatsuamɨkɨ netiuka'eniwatɨ.","poem":2},{"text":"Waɨriyarika xepɨkanetsikunɨtɨwani:","poem":1},{"text":"Nekiekari niweya kaniuka'unarieni».","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ti'aitame, Yawé Naimekɨmɨtɨrɨkaɨye,","poem":1},{"text":"yakaniutayɨni xeitukari marika mɨtixuawerekɨ,","poem":2},{"text":"xeitukaritsie tixaɨtɨ temɨkate'ayeitɨarienikɨ meta temeuyuyexɨriekakɨ","poem":1},{"text":"mayeweri nemuxeiyatsitɨarietsie,","poem":2},{"text":"xeitukaritsie kuraru mɨka'unarienikɨ","poem":1},{"text":"meta hɨritetsie temekahiwanikɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kaxetate yukukuyame hetsie me'utetɨ,","poem":1},{"text":"'Erami yu'ɨrɨ kaniuti'ɨni,","poem":2},{"lineBreak":true},{"text":"Kixi yuheima nunuwame kaniwaruxeiyatsitɨani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kaxetate yukukuyame pɨhɨpɨne","poem":1},{"text":"mayeweri manayexeiyarietsie,","poem":2},{"lineBreak":true},{"text":"'akitenie me'utetɨ mepuyutsaipɨna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kura kwieyari mɨyɨkɨhɨani pɨkayɨwe.","poem":1},{"lineBreak":true},{"text":"Mɨkɨ tukaritsie xeme xepɨyu'ɨwiyaxɨ","poem":1},{"text":"Paratsiyuta makukariuxaya kuyaxa timieme mɨtiyepikai.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Xepunenierixɨ Rawiri kiekariena","poem":1},{"text":"waɨkawamexɨa meutahani pɨyɨwekai,","poem":2},{"text":"haputsu kiekari hetɨamiemetsie","poem":1},{"text":"haa xeputi'utaxɨ,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kii Kerutsareme mieme xeputi'inɨataxɨ","poem":1},{"text":"hipame xeputi'unaxɨ kuraru 'aixɨa xemuyurienikɨ,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"huta kuraruyari tsata xeime haputsu xeputawewi","poem":1},{"text":"haa mukamarekɨ haputsu meripaitɨ mieme taɨta,","poem":2},{"text":"peru xepɨkayu'ɨwiyaxɨ kemɨ'ane mɨtiyurienekai,","poem":1},{"text":"meta kemɨ'aneri meripaitɨ mɨpaɨ mutayɨkai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"'Iya tukaritsie Ti'aitame,","poem":1},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye,","poem":2},{"text":"pɨxe'utahɨawixɨ xemutitsuananikɨ xeyuhiwerietɨ,","poem":1},{"text":"yumu'utsie xemuyukaxinikɨ meta xemuyutihiwerienikɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Peru neuxei, temawierika puxuawe.","poem":1},{"text":"Wakaitsixi mepɨmawarie, muxatsi mepɨtakwikwiwa,","poem":2},{"lineBreak":true},{"text":"wai pukwaiya meta winu pɨ'iya.","poem":2},{"lineBreak":true},{"text":"«Tepɨtekwaka tepɨ'ietɨweni,","poem":1},{"text":"'uxa'a temɨkwinikɨri».","poem":2}]},{"type":"verse","number":14,"content":["Yawé Naimekɨmɨtɨrɨkaɨye mɨpaɨ kanetiniu'enitsitɨiya: «'Ikɨ 'axakememɨte'uyurikɨ hatsuaku nepɨkatiwareuyehɨwirieni kepaukake memukwini. Ne nekanaineni Ti'aitame, Yawé Naimekɨnemɨtɨrɨkaɨye»."]},{"type":"line_break"},{"type":"verse","number":15,"content":["Ti'aitame mɨpaɨ kanaineni, Yawé Naimekɨmɨtɨrɨkaɨye: «Kenemie Tsewina hetsɨa, paratsiyu mɨhɨritɨarie, mɨpaɨ ketinetahɨawi:"]},{"type":"verse","number":16,"content":[{"text":"»“¿'Ena kepetiyuriene?","poem":1},{"text":"¿Kemɨ'ane heitserie pɨmatsi'upitɨa","poem":2},{"lineBreak":true},{"text":"'uwa teukiya pemɨti'inekɨ?","poem":2},{"text":"¿Titayari meutitewatsie 'a'uxipiweme petiwewiene,","poem":1},{"text":"ketitayari 'aitsie perewaye'ine?","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"»”Neuxei tewi pemɨtɨrɨkaɨye","poem":1},{"text":"Yawé 'ari kameniwiyarɨmeni","poem":2},{"lineBreak":true},{"text":"metsihehɨanike metsinanaimatɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Perúta hepaɨ kametinikurupamɨkɨ,","poem":1},{"text":"meta kwie 'ahakuyeumetsie kameneutahɨamɨkɨ.","poem":2},{"text":"Mana pekanemɨmɨkɨ, manari kaniyuhayewamɨkɨ","poem":1},{"text":"'akaxetate witsimɨ'anenekai kuyaxa miemete.","poem":2},{"lineBreak":true},{"text":"Mati'aitɨwame kiita pekanitewiyatsitɨariemɨkɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nekamenanakahɨamɨkɨ kepemɨtihɨritɨarietsie,","poem":1},{"text":"meta pemɨra'uximayatsie pekananayehɨiyamɨkɨ”.","poem":2}]},{"type":"verse","number":20,"content":["»'Iya tukaritsie neti'uximayatsiriwame 'Eriyakini Kirikiyaxi nu'aya nekanitahɨawimɨkɨ."]},{"type":"verse","number":21,"content":["'Akamixa 'amɨtewi nepenakatɨtɨani, 'ahɨiyamekɨ nepenahɨani, kepemɨti'aitakai mɨpaɨ nepɨtihɨritɨani. Kerutsareme kiekatari wapaapa hepaɨ 'anetɨ payani meta Kura nuiwariyari wahetsiemieme."]},{"type":"verse","number":22,"content":["Rawiri kiiya yawiyari naiparieyatsie nepayatsa, mɨkɨ tita mɨreuyepieni nixewitɨ mɨreunani pɨkayɨweni meta tita mɨkɨ mɨreunani nixewitɨ pɨkayɨweni mɨreuyepieni."]},{"type":"verse","number":23,"content":["Kutsunu hepaɨ kwiepa 'a'uweme nekanikatsunamɨkɨ, meta 'uweni 'aixɨa mɨtixeiyarie hepaɨ pɨ'aneni paapaya xiɨyarimama wahetsiemieme."]},{"type":"verse","number":24,"content":["Mɨkɨ hetsie pɨtiyeyani naitɨ 'aixɨa mɨti'ane waniwematsie: nuiwarimama neta wayɨrari, ye'ɨ 'etsimupe hetsie, tekɨxite hetsie meta ye'ɨrɨte hetsie."]},{"type":"line_break"},{"type":"verse","number":25,"content":["»'Iya tukaritsie ―Yawé mɨpaɨ kanaineni Naimekɨmɨtɨrɨkaɨye― kɨtsunu kanakainimɨkɨ makuweritsie muwe, kanahunariemɨkɨ nanari'ɨaritɨ kanatiwemɨkɨ, naime kemɨre'ikakai ratɨtɨ». Yawé mɨpaɨ kanaineni."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/21.json","previousChapterAudioLinks":{},"numberOfVerses":25}