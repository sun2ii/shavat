{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":23,"content":[{"type":"heading","content":["Niuki Tiru hepaɨtsita mieme"]},{"type":"verse","number":1,"content":["Niuki Tiru hepaɨtsita mieme:",{"text":"Xekeneutitsuanani, kanuwate Taritsi miemete,","poem":1},{"text":"xekii meti'unariekɨ meta haramara tetsita xemuwa'axetsie.","poem":2},{"text":"Tsipɨre kwieyaritsie paitɨ","poem":1},{"text":"mana paitɨ me'u'uwatɨ mekateniutamarieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kayuwatɨ xekeneumaka, haramara tetsita kiekatari,","poem":1},{"text":"Tsiruni kiekatari tetuayamete,","poem":2},{"lineBreak":true},{"text":"kanuwa nɨ'awamete waɨkawa metehexeiyame xemɨwarayeitɨa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Haa mɨmamariwawetsie","poem":1},{"text":"Tsikuxi hatsiyari kananetɨarieni,","poem":2},{"text":"Tiru kiekariyari waɨkawa mɨratuiya patɨa nuiwarite wahetsiemieme,","poem":1},{"text":"Niru hatetsitayaritsie mutiuka'etsiwakai mɨkɨkɨ waɨkawa mepɨte'ana'iwakai.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tsiruni, keneyutewiyani, haramaratsie pemɨtiwiya,","poem":1},{"text":"haramara mɨpaɨ kaniutayɨni:","poem":2},{"text":"«Kemɨtiyukukuine niwenetɨ nepɨkatimate meta nepɨkaheyeniweya,","poem":1},{"text":"tɨɨri nepɨkawareyewaweriya meta 'ukari nepɨkawareuta'ɨxatsitɨawe».","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kepauka 'Ekipitu niuki mɨye'ani,","poem":1},{"text":"Tiru hepaɨtsita metemarietɨ mekaniyutihiwerikuni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Taritsi xekeneuyekɨni,","poem":1},{"text":"haramara tetsita kiekatari, xekeneutitsuanani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"¿'Ikɨ xekiekari muyutemawie tihɨkɨ,","poem":1},{"text":"kiekari meripaitɨ mieme,","poem":2},{"text":"teɨterimama memeiwitɨ","poem":1},{"text":"'ateewa paitɨ mekuyaxeke?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"¿Kemɨ'ane mɨyaputayɨ Tiru hepaɨtsita,","poem":1},{"text":"kiekari piinite raye'atɨkaime mɨtitiwewiwakai,","poem":2},{"text":"tetuayametemama memanuyetei mepɨhɨkɨtɨkai,","poem":1},{"text":"meta wahamatɨa memɨte'uximaya naitsarie kwiepa mepɨmatiwakai?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yawé Naimekɨmɨtɨrɨkaɨye hepaɨtsitana mɨpaɨ kaniutayɨkaitɨni","poem":1},{"text":"kemɨ'ane kwinimieme mɨtiyuta'ɨre mɨka'unakɨ","poem":2},{"lineBreak":true},{"text":"meta yunaime teɨteri memeuka'u kwiepa tixaɨtɨ mɨkatiwarayeitɨanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Taritsi niweya,","poem":1},{"text":"Niru hepaɨ 'akwie keneuka'etsa,","poem":2},{"lineBreak":true},{"text":"'ari 'akanuwa muwaye'axekaitsie kaniukumaweni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yawé haramaratsie yumamá kaneutatsera,","poem":1},{"text":"meta te'aitamete kaniwarutiyɨyɨakitsitɨani,","poem":2},{"lineBreak":true},{"text":"meta katiniuta'aita Kanani kiekariyari 'aixɨa mɨ'ane mɨka'unarienikɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mɨkɨ mɨpaɨ kaniutayɨni:","poem":1},{"text":"«'Ɨimari waɨriyarika 'ahamatɨa mɨtiukahitɨxɨ, Tsiruni niweya:","poem":2},{"lineBreak":true},{"text":"tawarita peyutemawietɨ pepɨkahayani.","poem":2},{"lineBreak":true},{"text":"»Kenanukukeka, Tsipɨre paitɨ 'anutaɨye kenanuye'a,","poem":1},{"text":"peru yaxeikɨa mana 'aixɨa 'anemekɨ pepɨkatayerɨni».","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Karireutsixi wakwie keneuxeiya.","poem":1},{"text":"Mɨkɨ teɨteriyari mekaniumaweniri.","poem":2},{"text":"'Atsiriya makumawetsie yeutari","poem":1},{"text":"memayu'awieta wakie pɨta kanayeitɨani.","poem":2},{"text":"Makeme me'utawewieka wakurarutsie mekaneukatsunaxɨani,","poem":1},{"text":"wakii 'aixɨa mɨ'anenekai mekaniuti'una,","poem":2},{"lineBreak":true},{"text":"naime 'u'unime mekaniuhayewa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kanuwate Taritsi mieme, xekeneutitsuanani,","poem":1},{"text":"xekiekari 'aixɨa mɨ'ane muka'unariekɨ.","poem":2}]},{"type":"verse","number":15,"content":["'Iya tukaritsie Tiru kanatɨmaiyariemɨkɨ haika tewiyari heimana tamamata wiyari, ti'aitame kemɨreutetere 'ayenieretɨ. Peru mɨkɨ wiyari tixɨyu, kemanɨyɨne 'uka tuminikɨ muyuwitɨnɨa kwikariyari mɨpaɨ katiniyurimɨkɨ Tiru kiekariyari:"]},{"type":"verse","number":16,"content":[{"text":"«'Ekɨ, 'uka tuminikɨ pemuyuwitɨnɨa,","poem":1},{"text":"'aripa keneutikweka kiekari warita kenaye'a,","poem":2},{"text":"yemekɨ kepemɨtiyɨwe ketineukayuitɨa,","poem":1},{"text":"meta waɨkawa kwikari keneutikwika,","poem":2},{"lineBreak":true},{"text":"'uxa'atɨniwarie pemuku'eriwanikɨ».","poem":2}]},{"type":"verse","number":17,"content":["Haika tewiyari heimana tamamata wiyari 'anuyeyayu, Yawé Tiru panukuketɨani, mɨkɨ tawarita puyutuani, tuminikɨ muyumayɨinɨa payuyeitɨani yunaime te'aitamete wahamatɨa."]},{"type":"verse","number":18,"content":["Peru ketipaɨmeme mɨtiyetua meta kepaɨmeme mana'i'iwani Yawé hetsɨa mieme tipatsietɨ pɨrayeikani, pɨkati'utɨni meta pɨkatixeɨriyaka xeikɨa. Tita mɨrana'iwarieka Yawé hetsiemieme memɨte'uximaya wahetsiemieme pɨrayeikani, memɨteyumikwanikɨ 'anayuhayewamekɨ meta 'ixuriki witsimɨ'anenekɨ memuyukemaritɨakakɨ."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}