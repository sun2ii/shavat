{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":24,"content":[{"type":"heading","content":["Kwiepa ke'aixɨa mɨtiyɨni"]},{"type":"verse","number":1,"content":[{"text":"Neuxei, Yawé kwiepa puwaka'una meta puwarakumaweriya,","poem":1},{"text":"puwa'uximatɨa yunaime, meta mana kiekatari puwataweweiya.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yaxeikɨata mepɨte'anuyekɨne","poem":1},{"text":"mawari wewiwame meta teɨteri,","poem":2},{"lineBreak":true},{"text":"'uki ti'aitame meta ti'uximayatame,","poem":2},{"lineBreak":true},{"text":"'ukaratsi ti'aitame meta 'ukaratsi ti'uximayatame,","poem":2},{"lineBreak":true},{"text":"tituayame meta tinaweme,","poem":2},{"lineBreak":true},{"text":"tumini tiyuniniɨtɨwame meta yuniɨrɨweme,","poem":2},{"lineBreak":true},{"text":"mɨrapiniyarie meta mɨrapine.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwie naitɨ kanakumaweriyarieni,","poem":1},{"text":"yuheyemekɨ mekanakumaweriyarieni,","poem":2},{"lineBreak":true},{"text":"Yawé mɨpaɨ mutayɨkɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kwie kaniwakini kaniyɨnani,","poem":1},{"text":"'iteɨrite kaniyɨyɨnani meta kanitakukuweni,","poem":2},{"lineBreak":true},{"text":"kwiepa memɨmamariwawekai mekaniweraranini.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwie puyutsewixima,","poem":1},{"text":"mana kiekatari memiketsinakɨ,","poem":2},{"text":"yamemɨkatekakɨkɨ 'inɨari niukiyaritsie,","poem":1},{"text":"'inɨari niukiyari memɨkahanu'enikɨ,","poem":2},{"lineBreak":true},{"text":"'aitsikate memeutitsanaxɨakɨ,","poem":2},{"lineBreak":true},{"text":"tɨratu yuheyemekɨ mumieme mekaneutitsanaxɨani.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Ayumieme kwie 'axa'itɨrietɨ kanitaxɨximeni,","poem":1},{"text":"mana kiekatari wahetsie mɨrahɨiwakɨ.","poem":2},{"text":"'Ayumieme tai kaniwaxɨtsitɨaka,","poem":1},{"text":"yayupaɨmetɨ xeikɨa mekaniyuhayewatɨweni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Winu mɨhekwa kaniukawani, meta kaxie kaniutayɨnare,","poem":1},{"text":"naitɨ 'iyarite muyutemamawiekai meripaitɨ kaniyuhiwerietɨkani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tepu 'utiyuatɨri katiniuhayewa,","poem":1},{"text":"temawierika 'ixɨarariyariri kaniukumawere,","poem":2},{"lineBreak":true},{"text":"'aripa hayuatɨ katiniutahayewa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwikamete me'utikwitɨ winuri mepɨka'ie,","poem":1},{"text":"tarɨwekarixi wahetsiemieme winu patsiwiri.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kiekari muyuxamurie 'unitɨ kaniyuhayewa,","poem":1},{"text":"naitɨ kitenie pɨtiukaname.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tsuari puxuawe kaye'utɨma winu mumawekɨ,","poem":1},{"text":"naitɨ temawierika pukumawerixɨ,","poem":2},{"lineBreak":true},{"text":"naitɨ temawierika kaniukumaweriyarieni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kiekari naitɨ kani'u'unini,","poem":1},{"text":"'itupariyari 'etsiyeyeutɨ kaneutimaneni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mɨpaɨ kwie hixɨapa katiniyɨmɨkɨ","poem":1},{"text":"nuiwarite wahetsie,","poem":2},{"text":"kepauka huriwu takariyari mɨka'inɨiwatsie karima kuweiwatɨ hepaɨ,","poem":1},{"text":"kepauka muyuhayewaxɨ mutiwawiwa hepaɨ","poem":2},{"lineBreak":true},{"text":"matɨari mɨka'inɨiwatsie 'anuyeyayu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Muyuhayewaxɨ paniuka meta kanahiwani temawierikakɨ,","poem":1},{"text":"tau makayuyuipiketsie pahiwa Yawé mɨmariwe hahɨawetɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Ayumieme, tau manatineikatsie, Yawé 'aixɨa xeketenekuxatani,","poem":1},{"text":"Yawé kemɨtitewa, 'Ixaheri Kakaɨyarieya,","poem":2},{"lineBreak":true},{"text":"haramara tetsita mɨtiuyehanetsie mɨpaɨ xekenaitɨkani.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kwie manu'axetsie paitɨ kwikarieya tekani'enieka:","poem":1},{"text":"«'Aixɨa mɨtiuka'iyari 'aixɨa ketikuxaxatsiwani».","poem":2},{"text":"Ne matsi mɨpaɨ nepaine: «Ne xɨa'ui.","poem":1},{"text":"Kukuinari nehetsie pɨye'a».","poem":2},{"text":"Kemɨ'ane memɨteyukananaima mepɨteyukananaima,","poem":1},{"text":"'axamemɨte'u'iyari yamekateniyurieka kememɨteyurienikɨ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Marika, mɨki teukiya meta winiyari","poem":1},{"text":"mepɨxe'aye'unie, kwiepa xemɨtama.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kemɨ'ane muyuta'una mɨkɨ hiwari makatɨ","poem":1},{"text":"putsu 'emeukatewata kaneukawemɨkɨ,","poem":2},{"text":"kemɨ'ane meukatewata muwatiyani","poem":1},{"text":"winiyaritsie kaniyɨhɨamɨkɨ,","poem":2},{"text":"katineuyepiekari muyuawitsie kitenie 'etsimayeyeutsie neniereme,","poem":1},{"text":"meta kwie tsutɨmeyari kaniwatayuaneniri.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kwie kaniutaxɨkeni, pɨkayuwiyamɨkɨ,","poem":1},{"text":"kwie pukatsinetɨyeika, pukatarike,","poem":2},{"lineBreak":true},{"text":"kwie putayuane yemekɨ waɨkawa putayuane.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kwie pɨkitsariene tawekame hepaɨ,","poem":1},{"text":"kɨyexi kiiyari hepaɨ kaniwatayuaneni.","poem":2},{"text":"Waɨkawa pahete hetsiena 'axamɨti'ane mɨrexeiyakɨ,","poem":1},{"text":"kanatiwemɨkɨ tawarita mɨka'anukukenikɨ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"'Iya tukaritsie Yawé katiniwakwinitɨamɨkɨ","poem":1},{"text":"muyuawitsie tɨrɨkariya memexeiya","poem":2},{"lineBreak":true},{"text":"meta kwiepa te'aitamete.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Xeime putsuta mekaneukaxɨriyakuni,","poem":1},{"text":"pɨretsutsixi wahepaɨ katsariyanata memaye'u,","poem":2},{"lineBreak":true},{"text":"'arike mɨixa tukari 'anukayayu mekatenikwinitɨariekuni.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Metseri kaniyɨrimɨkɨ","poem":1},{"text":"tau kaniyutitewiyamɨkɨ,","poem":2},{"text":"'ana Tsiyuni hɨriyaritsie,","poem":1},{"text":"Kerutsareme hetsie,","poem":2},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye katinita'aitamɨkɨ,","poem":1},{"text":"mana miemete 'ukirawetsixi mepixeiyani mariweme.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}