{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":25,"content":[{"type":"heading","content":["Yawé hetsiemieme kwikari nɨawari"]},{"type":"verse","number":1,"content":[{"text":"Yawé, 'ekɨ pepɨnekakaɨyari,","poem":1},{"text":"'aixɨa nepaineni kepemɨtitewakɨ meta nepɨmetsinɨawani","poem":2},{"lineBreak":true},{"text":"mariweme pemɨtiyurienekɨ.","poem":2},{"text":"Meripaitɨ kepemɨtiyɨhɨawixɨ","poem":1},{"text":"mɨpaɨ pepɨtiyuriene heitseriemekɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kiekari, 'uniyari kwiniemieme netɨ 'uweme pepayeitɨa,","poem":1},{"text":"kiekari 'aixɨa mɨreukukurarutɨarie pepanuti'unaxɨ.","poem":2},{"text":"'Ari 'ateewa kiekatari waparatsiyu kiekari pɨkahɨkɨ,","poem":1},{"text":"tawariri pɨka'anukuketɨarieni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Ayumieme teɨteri metɨrɨkawitɨ 'aixɨa mepɨmatehahɨawe,","poem":1},{"text":"nuiwarite 'axamemɨte'u'iyari wakiekari pɨmatsi'ayemakaxe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Ekɨtsɨ pemɨhɨkɨkɨ,","poem":1},{"text":"kepauka memu'uximatɨariekatsie,","poem":2},{"text":"tixaɨtɨ memɨkate'eriwa wa'inɨari,","poem":1},{"text":"mɨreuyehɨwa hetsie nunuwame,","poem":2},{"text":"wiyeri mɨtɨrɨkaɨye hepaɨtsita 'ewiweme hetsiemieme,","poem":1},{"text":"'etɨriya xɨri hepaɨtsita mieme,","poem":2},{"text":"Matsi, 'axamemɨte'u'iyari wahɨtsierikayari","poem":1},{"text":"wiyeri mɨtɨrɨkaɨye hepaɨ kani'aneni kuraru mɨtse'i maye'unie,","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"xɨri makumawetsie mieme hepaɨ kani'aneni.","poem":2},{"text":"'Ekɨ teewatari wayuariya kayuwatɨ pepɨkupitɨwa,","poem":1},{"text":"xɨri haiwitɨri kemɨtixeriya hepaɨ,","poem":2},{"lineBreak":true},{"text":"meta pepenukayunitɨa 'axamemɨte'u'iyari wakwikari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yawé Naimekɨmɨtɨrɨkaɨye, 'ikɨ hɨriyaritsie","poem":1},{"text":"katinikuha'aritɨamɨkɨ yunaime teɨteri wahetsiemieme","poem":2},{"lineBreak":true},{"text":"'ikwai 'ixɨarariyari witsiti'aneneme ranapikame,","poem":2},{"lineBreak":true},{"text":"winu xeiwiyari mexeiya 'ixɨarariyari,","poem":2},{"lineBreak":true},{"text":"'ikwaite 'aixɨa ti'anenekame meta winu 'aixɨa mɨ'ane xeiwiyari mexeiya.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Ikɨ hɨriyaritsie kaneikutsanamɨkɨ","poem":1},{"text":"'ixuriki teɨteri yunaime muwareukunama,","poem":2},{"lineBreak":true},{"text":"meta matakɨ nuiwarite yunaime muwakanama.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mɨki mɨɨya kanikumaweriyamɨkɨ yuheyemekɨ,","poem":1},{"text":"Yawé naimekɨmɨyɨwe yunaime teɨteri kaniwara'ukaipiexɨamɨkɨ,","poem":2},{"text":"meta naitsarie kwiepa","poem":1},{"text":"teɨterimama memɨkananaimariekakɨri katinikumaweriyamɨkɨ.","poem":2},"Yawé yɨkɨmana mɨpaɨ kanaineni."]},{"type":"verse","number":9,"content":["'Iya tukaritsie mɨpaɨ pɨtitaniukieni:",{"text":"«Huu, 'ikɨ pɨtakakaɨyari,","poem":1},{"text":"hetsiena yuri tepɨte'erieka, mɨkɨ pɨtatsi'utawikweitsitɨa.","poem":2},{"text":"'Ikɨ pɨhɨkɨ Yawé, hetsiena yuri temɨte'erie,","poem":1},{"text":"tepɨtatemamawieka tepuyutemamawieka wikweitsitɨarikayatsie».","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yawé tɨrɨkariyaya 'ikɨ hɨritsie puyuhayewa,","poem":1},{"text":"peru Muhawi makumatsie pɨtaketsinarieni,","poem":2},{"lineBreak":true},{"text":"'ɨxa mɨtiketsinarɨwa hepaɨ muwatiketsinaruwatsie.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mana yumamá pɨtatseraxɨani,","poem":1},{"text":"tewi hauweme hepaɨ.","poem":2},{"text":"Peru Yawé kememɨteyuti'ɨre kaniwanawairiemɨkɨ,","poem":1},{"text":"meta ke'axamɨtiyurimɨkɨ yumamatekɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kanika'unamɨkɨ, kanetihɨamɨkɨ meta kaniwatayuitɨamɨkɨ","poem":1},{"text":"'akuraru 'amatitewa meta 'aixɨa mɨ'anene,","poem":2},{"lineBreak":true},{"text":"kepaukake tumuanari mayani 'anake kanihayewamɨkɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/24.json","previousChapterAudioLinks":{},"numberOfVerses":12}