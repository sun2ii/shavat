{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":26,"content":[{"type":"heading","content":["Mɨrayu'iwaxɨ kwikarieya"]},{"type":"verse","number":1,"content":["'Iya tukaritsie 'ikɨ kwikari pɨtakwikarieni Kura kwieyaritsie:",{"text":"«Kiekari tepexeiya tɨrɨkaɨyeme.","poem":1},{"text":"Kuraru 'amatayewa hepaɨ, tahetsie nunuwame hepaɨ,","poem":2},{"lineBreak":true},{"text":"Kakaɨyari yuwikweitsitɨarika pɨyetua.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Itupari xekeneuyepi, meutahanikɨ","poem":1},{"text":"nuiwari 'aixɨa mɨtiuka'iyari heitseriemekɨ yamɨtikamie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Aixɨa 'anemekɨ 'amuyeika","poem":1},{"text":"pepipitɨani kayuwatɨ hexeiyatɨ 'amuyeikanikɨ,","poem":2},{"lineBreak":true},{"text":"'ahetsie yuri mɨti'eriekɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yawé hetsie yuri xeketene'erieka yuheyemekɨ,","poem":1},{"text":"Yawé 'ai mɨhɨkɨkɨ yuheyemekɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mɨkɨ memeuka'u pɨwaratixɨrɨwa","poem":1},{"text":"meta puwaka'una kiekari muyuta'ɨre:","poem":2},{"text":"pika'una kwiepa petihɨpa,","poem":1},{"text":"kanetihɨpani tumuanaripa heutenime kanayeitɨwani.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Memɨkatɨrɨkawi meta memɨnanaimarie","poem":1},{"text":"mekaniwatiketsinani yuketakɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Heitserie mexeiya huyeya makuweri kanihɨkɨtɨni.","poem":1},{"text":"'Ekɨ, heitseriemekɨ 'apemuyeika, huyeya 'akuwerime kenayeitɨirieka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yawé, huu, 'ahetsie tepɨta'ikwewa,","poem":1},{"text":"petati'ɨkitɨakaku yatepɨtehetimamateke mɨpaɨ temɨte'u'uwanikɨ,","poem":2},{"text":"kepemɨtitewa meta pemɨkahatɨtɨmaiyarɨwa","poem":1},{"text":"mɨkɨ pɨhɨkɨ temeiyehɨwa tatukaritsie.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tɨkarikɨ naime ne'iyarikɨ nepɨmatsi heuyehɨwa,","poem":1},{"text":"ximeri ne'iyari pɨmatsi'utiwawa.","poem":2},{"text":"Kepauka 'aixɨa pemɨtiyuriene kwiepa,","poem":1},{"text":"kwiepa memɨtama mepɨtehetimamateke tita mɨtiheitserie.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tsepa 'axamɨtiuka'iyari mɨnenimayatsie,","poem":1},{"text":"pɨkaretimamateke tita mɨtiheitserie,","poem":2},{"text":"'aixɨa mɨti'ane mɨraxuawetsie 'axapɨtiyuriene pɨta,","poem":1},{"text":"Yawé kemɨtimariwe pɨka'imate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yawé, 'amamá pepanukuhana,","poem":1},{"text":"peru mɨkɨ mepɨka'ixeiya.","poem":2},{"text":"'Ateɨterima wahetsiemieme kepemɨti'ɨtetsa meke'ixeiya, 'ana meke'uyutitetewiya,","poem":1},{"text":"taikɨ meke'utixɨtsitɨarieni","poem":2},{"lineBreak":true},{"text":"memɨmetsi'aye'unie muwahetsiemieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yawé, 'ekɨ kayuwatɨ pepɨxuawitɨa tahetsiemieme,","poem":1},{"text":"'ekɨtsɨ pekanihɨkɨtɨni yapemɨtiyuriene naime ta'uximayatsikakɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yawé, takakaɨyari,","poem":1},{"text":"hipatɨ te'aitamete meripaitɨ mepɨtate'uta'aitɨa,","poem":2},{"lineBreak":true},{"text":"peru 'ahetsiemieme xeikɨa 'aixɨa tepaitɨka.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Ari mepukwi, tawariri mepɨka'anutaneniere,","poem":1},{"text":"'etɨri mepɨhɨkɨri, tawarita mepɨka'anuku'uni.","poem":2},{"text":"'Ekɨ 'uximatɨarika pepɨwarupitɨa meta pepɨwaruka'unaxɨ,","poem":1},{"text":"yapepɨtiuyuri memɨkaha'eriwanikɨri.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yawé, 'ekɨ nuiwari mariweme pepayeitɨa,","poem":1},{"text":"mariweme pepa'ayeitɨa meta witsipe'anetɨ pepe'ayeitɨa,","poem":2},{"lineBreak":true},{"text":"kwie hakewa meuye'atɨkatei tawarita 'apepitayeuritaxɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yawé, 'uximatɨarikatsata mepɨmatsi'utiwau,","poem":1},{"text":"nenewierikɨ 'etsiwa xeikɨa me'eniɨriɨkɨtɨ","poem":2},{"lineBreak":true},{"text":"kepauka 'ekɨ pemɨtiwaruka'enitsitɨatsie.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yawé, tame 'ahɨxie tepu'axɨa","poem":1},{"text":"kepauka 'uka mayehuka hepaɨ te'utiyuatɨ","poem":2},{"text":"mutahiwa yu'ɨimɨranetɨ kukuiniyakɨ","poem":1},{"text":"kepauka mɨtiniwerɨmenitsie.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tekaneyexeiya, tekaniyuti'ɨimɨra,","poem":1},{"text":"peru 'eka xeikɨa tekanayexeiya.","poem":2},{"text":"Kwiepa wikweitsitɨarika tepɨka'atɨa,","poem":1},{"text":"meta kwiepa memɨtama mepɨka'utinunuiwaxɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Peru 'ahetsie metewiyatɨ memukwi mepanutaneniere,","poem":1},{"text":"wa'umete tukari hexeiyatɨ payani.","poem":2},{"text":"Xekenanutanenieri xekeneutihiwani temawierikakɨ,","poem":1},{"text":"tumuanaripa xemɨkiekatari.","poem":2},{"text":"Haɨtsi 'ahetsɨa mieme, haɨtsi ximeri mieme hepaɨ kani'aneni,","poem":1},{"text":"kwie meta yumɨkite puwayetuani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Neteɨterima nehetsɨa miemete, yukiita xekeneutahaxɨa","poem":1},{"text":"xeheutahaxɨame xeketeneunama,","poem":2},{"text":"yaxeketeneuteri xeyu'awietatɨ,","poem":1},{"text":"haxɨa hanuyeyayuke.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Xekenayeneniereni,","poem":1},{"text":"Yawé yukiita kaniwayeyeimɨkɨ","poem":2},{"text":"'axamemɨteyurie tiwakwinitɨanike","poem":1},{"text":"kwiepa memɨtama.","poem":2},{"text":"Kwie xuriya mutayeuriya kanihekɨatamɨkɨ,","poem":1},{"text":"xuriya mana memutayeuri pɨkawa'awietaniri.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}