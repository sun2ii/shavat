{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":27,"content":[{"type":"heading","content":["'Ixaheri kemɨtiuxɨnarie"]},{"type":"verse","number":1,"content":[{"text":"'Iya tukaritsie Yawé kuu Rewiyatahini mɨtitewa katinikwinitɨamɨkɨ,","poem":1},{"text":"kwinimieme mɨrayu'unawe,","poem":2},{"lineBreak":true},{"text":"kwinimieme mɨrakwinɨriwawe.","poem":2},{"text":"Yu'ixiparakɨ mɨtiyumemiwakɨ, mɨmariwekɨ meta mɨtɨrɨkaɨyekɨ,","poem":1},{"text":"kuu mɨmariwe kanimiemɨkɨ haramaratsie mɨyeyeika.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"«'Iya tukaritsie kaxie nanari haraweriyari","poem":1},{"text":"manayexeiyarie xekenenɨawani:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne, Yawé, 'ihɨweme nekanihɨkɨtɨni,","poem":1},{"text":"tukarikɨ nekaxie nanayari yanekatinihatuiyani.","poem":2},{"text":"Tukarikɨ tɨkarikɨ yanekatini'ɨwiyani","poem":1},{"text":"nitixaɨtɨ 'axamɨkatiyurienikɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nepɨkaha'a.","poem":1},{"text":"Xɨka 'ɨtsi meta xuya hexeiyani,","poem":2},{"text":"ne nekanitamieweni","poem":1},{"text":"meta naime nekaniutitaiyaweni,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"xɨka mɨkɨ nemi'awietanikɨ yara'eriwanike","poem":1},{"text":"nehamatɨa kayuwatɨ hexeiyatɨ 'ayuyeitɨani,","poem":2},{"lineBreak":true},{"text":"huu, nehamatɨa kayuwatɨ hexeiyame ke'ayuyeitɨaka».","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tukari kanaye'amɨkɨ kepauka Kakuwu nanarieya manexɨani,","poem":1},{"text":"kepauka 'Ixaheri mɨtayɨra meta mɨkaxutuni,","poem":2},{"lineBreak":true},{"text":"kwiepa yu'ikwaxikɨ kanakɨnɨmɨkɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yawé pɨka'ikuwaxɨa","poem":1},{"text":"kemɨ'ane memikuwayakai muwarukuwaxɨa hepaɨ.","poem":2},{"text":"Pɨkawarukwi memɨteyumemiwa","poem":1},{"text":"mutiwarukwi hepaɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kaniyuritɨni hetsiena kuyaxa kaniutixuawitɨani,","poem":1},{"text":"kaneyeweiya yu'iiyakɨ","poem":2},{"lineBreak":true},{"text":"'eka 'iiyayari tau manatineika miemekɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mɨpaɨ Kakuwu 'axakemɨtiuyurikɨ pɨti'itiyarieni,","poem":1},{"text":"mɨpaɨ xeikɨa katiniyɨmɨkɨ","poem":2},{"lineBreak":true},{"text":"'axakemɨtiuyuri mɨreuyehɨwiyarienikɨ:","poem":2},{"text":"tetexi kakaɨyarixi memɨte'atimawiyarɨwa naitɨ tumuanari kehayani,","poem":1},{"text":"tetexi mu'uniwe mɨtɨxieka hepaɨ,","poem":2},{"text":"meta 'Atserá 'ɨkiyaya 'a'uwetɨ pɨkakuhayeikarɨwani","poem":1},{"text":"meta mawari taiyame 'ɨkwa witsimu'ɨa nixewitɨ tɨma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kiekari 'aixɨa mɨreukukurarutɨarie panuka'unarie,","poem":1},{"text":"mɨka'akukiepaya pɨhɨkɨ,","poem":2},{"lineBreak":true},{"text":"makumawe muku'eiriwaxɨ hepaɨ.","poem":2},{"text":"Muwa tsikeru kaneuta'ariwani,","poem":1},{"text":"mana katiniutikwa'ani meta tupiriyate katinikwaka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kepauka mɨtiwauke, kɨyexiyari kanitimurikeni,","poem":1},{"text":"hikɨ 'ukarawetsixi mekani'axeni kɨmana me'atinainike.","poem":2},{"text":"'Ikɨ teɨteri memɨkayɨkɨhɨawe mekanihɨkɨtɨni,","poem":1},{"text":"'ayumieme muwarutawewi pɨkawanenimaya,","poem":2},{"lineBreak":true},{"text":"nitɨma pɨkawanenimaya kemɨ'ane mɨwarutawewi.","poem":2}]},{"type":"verse","number":12,"content":["'Iya tukaritsie Yawé tɨriku pɨtiketsini 'Eupɨrate hayari manuye'anetsie paitɨ 'itsutɨame 'Ekipitu hayari manuyekatsie paitɨ ye'atɨkaime, xeme 'ixaheritsixi yuxexuitɨ xepeu'itsanariexɨani xemukuxeɨriyanikɨ."]},{"type":"verse","number":13,"content":["'Iya tukaritsie kuxineta mariwetɨ kanitahɨtsieriemɨkɨ. Kemɨ'ane 'Atsiriya memehapanie meta kemɨ'ane 'Ekipitu memanutaxɨriya mekani'axɨakuni Yawé memayexeiyanikɨ hɨri mɨpatsietsie Kerutsareme."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/26.json","previousChapterAudioLinks":{},"numberOfVerses":13}