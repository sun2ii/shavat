{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":28,"content":[{"type":"heading","content":["Xɨa'ui 'Epɨrahini"]},{"type":"verse","number":1,"content":[{"text":"Xɨa'ui memuyuti'ɨre wakuruna 'Epɨrahini kiekatari memɨtarɨwe,","poem":1},{"text":"tutu mɨyɨna witsikemɨtiyuxexeiyakai,","poem":2},{"text":"hɨri 'ayewerikaku 'aixɨa raye'anekaku muwe.","poem":1},{"text":"Xɨa'ui winukɨ mematixɨri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Neuxei, Ti'aitame xeime kanexeiyani","poem":1},{"text":"tɨrɨkaɨyeme meta mariweme:","poem":2},{"text":"Mɨkɨ kwiepa katinahɨamɨkɨ rananaimatɨ,","poem":1},{"text":"tee mukaxɨrieni hepaɨ,","poem":2},{"lineBreak":true},{"text":"'eka mɨtiyuka'una hepaɨ,","poem":2},{"lineBreak":true},{"text":"wiyeri mɨhaikɨrima hepaɨ,","poem":2},{"lineBreak":true},{"text":"haa muwayeneni hepaɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Epɨrahini memɨtarɨwe wakuruna kɨmana memuyuti'ɨre,","poem":1},{"text":"kanitaketsinariemɨkɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mɨkɨ tutu mɨyɨna witsikemɨtiyuxexeiyakai,","poem":1},{"text":"hɨri 'ayewerikaku 'aixɨa raye'anekaku mɨyewe,","poem":2},{"text":"mexɨakame xapa mukwaxi kanayeimɨkɨ katika'inɨiyawekaku 'akuxi:","poem":1},{"text":"xewitɨ 'ixeiyame yapauka 'eka'inɨme,","poem":2},{"lineBreak":true},{"text":"kanitakwaimɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"'Iya tukaritsie Yawé Naimekɨmɨtɨrɨkaɨye","poem":1},{"text":"kuruna witsimɨtiyuxexeiya kanihɨkɨtɨkamɨkɨ,","poem":2},{"text":"patsaruxi mutixawatɨre","poem":1},{"text":"keyupaɨmetɨ memuyuhayewa mehe'eriwatɨ wahetsiemieme.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mɨkɨ 'iyari pupitɨani heitseriemekɨ yamɨtiyurienenikɨ","poem":1},{"text":"kemɨ'ane mɨtita'aita,","poem":2},{"text":"meta kuyaxi pɨwapitɨani memuyuwaɨriyanikɨ","poem":1},{"text":"kiekaritsie mɨranutahakitɨretsie memɨtetahɨkakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Metatsiere mawari wewiwamete meta Kakaɨyari niukametemama,","poem":1},{"text":"kaxie winuyarikɨ mepeukeitsarietɨweni,","poem":2},{"lineBreak":true},{"text":"mepeukeitsarietɨwe winu waɨkawa mɨtɨrɨkaɨyekɨ","poem":2},{"text":"winukɨ mepɨkaheta'eriwawe,","poem":1},{"text":"winukɨ mepetiketamɨrike.","poem":2},{"text":"Kepauka Kakaɨyari mɨtiwaxeitsitɨa mɨpaɨ mepɨkatekuxata,","poem":1},{"text":"kepauka yamemaitɨka, meputirukuwa xeikɨa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Puyuri, naitɨ wamexate pɨhayarimatɨka,","poem":1},{"text":"hawaikɨ tɨma pɨkahanaka'itiyarie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«¿Kemetemate kemɨ'ane mepɨteha'ɨkitɨa?","poem":1},{"text":"¿Kemɨ'ane niuki mepɨtehakuxaxatɨwa?","poem":2},{"text":"¿Tɨɨri metate'erie hekwamekɨke temutsitsinawaiyarie,","poem":1},{"text":"hekwamekɨke tatsitsi temuku'eiri?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"¿Tɨɨri mɨixamexɨa mɨpaɨ memutiyuane:","poem":1},{"text":"“a-b-c-d-e, a-e-i-o-u,","poem":2},{"lineBreak":true},{"text":"'etsiwa 'ena, 'etsiwa huma”?»","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Matsitsɨ 'aixɨa kani'aneni, Kakaɨyari 'ikɨ yuteɨterima kaniwatahɨawimɨkɨ","poem":1},{"text":"wayuriyatɨ yɨkɨ niuki 'anuyɨnemekɨ meka'i'eniekamekɨ,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"mɨkɨ teɨteri mɨpaɨ mɨtiwarutahɨawekai:","poem":1},{"text":"«'Ena 'uxipiya maxuawe kanihɨkɨtɨni,","poem":2},{"lineBreak":true},{"text":"kemɨ'ane mu'uxe ke'uka'uxipieni»,","poem":2},{"text":"metatsiere mɨpaɨ mɨtiwarutahɨawixɨ:","poem":1},{"text":"«'Ena 'uxipiya tukari kanihɨkɨtɨni».","poem":2},{"lineBreak":true},{"text":"Matsi mepɨka'i'eni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Ayumieme Yawé niukieya","poem":1},{"text":"wahetsiemieme kanayeimɨkɨta:","poem":2},{"lineBreak":true},{"text":"«a-b-c-d-e, a-e-i-o-u,","poem":2},{"lineBreak":true},{"text":"'etsiwa 'ena, 'etsiwa humapaitɨ».","poem":2},{"text":"Kepauka memɨyekɨne yukutama pɨta me'uhutɨ,","poem":1},{"text":"memɨtekwinekɨ, winiyaritsie memeyuxɨrienikɨ meta putsuta memeukaxɨrienikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"'Ayumieme, teɨteri xemɨte'aita xeyuti'ɨretɨ","poem":1},{"text":"'ikɨ kiekariyaritsie Kerutsareme,","poem":2},{"lineBreak":true},{"text":"Yawé niukieya xekeneu'eni:","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Xeme mɨpaɨ xemutiyuane: «Tɨratu tepuwewi mɨki hamatɨa,","poem":1},{"text":"mɨki teukiyapa hamatɨa tɨratu tepuwewi.","poem":2},{"text":"Kepauka 'uximatɨarika munuani,","poem":1},{"text":"pɨkayɨwe mɨkatatsi'axekɨ,","poem":2},{"text":"tame tita mɨti'itarika tahetsie nunuwame temayeitɨakɨ","poem":1},{"text":"meta tita kwamanarika mɨtihɨkɨ tatsi'awiwietame».","poem":2}]},{"type":"verse","number":16,"content":["'Ayumieme Yawé naimekɨmɨyɨwe mɨpaɨ paine:",{"text":"«Ne Tsiyunitsie tete nepayeni 'inɨatsiekame,","poem":1},{"text":"tete 'uta'etsikiname witsi'aneme tenaritsie miemetɨme,","poem":2},{"lineBreak":true},{"text":"kemɨ'ane hetsiena mɨtiwiyani 'aixɨa 'iyari puyeikani.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tita 'aixɨa mɨti'ane ti'inɨnɨatame hepaɨ 'aneme 'anepɨtakeni,","poem":1},{"text":"meta mɨtiheitserie hetsiemieme, tepɨa mahete hiru manawie.","poem":2},{"text":"Tee, xehetsie nunuwame 'itarikakɨ mɨhɨkɨ kaneuyehɨamɨkɨ,","poem":1},{"text":"meta haa hakewa xemeyu'awieta kanikayunitɨamɨkɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Pɨhayewarieni tɨratu xemuwewi mɨki hamatɨa,","poem":1},{"text":"'atsikapɨtiyɨni tsepa mɨki teukiya hamatɨa xemɨte'utaxa.","poem":2},{"text":"Kepauka 'uximatɨarika tiyumemiwame 'umamie,","poem":1},{"text":"mɨkɨ kanixetipɨnamɨkɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kepauka manuyeyeikani, pɨxehehapanani,","poem":1},{"text":"ximeri yapɨranuyeyeikani, tukarikɨ meta tɨkarikɨ».","poem":2},{"lineBreak":true},{"text":"Kepauka xemeitimani 'ikɨ niuki","poem":1},{"text":"yemekɨ xekanitimamakuni.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"'Utá 'etsipɨtɨtɨ hetsiena muta'ɨtserita pɨkayɨwe,","poem":1},{"text":"'ixuriki 'etsipɨyewa kɨmana muyuta'eima pɨkayɨwe.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kaniyuritɨni, Yawé kananukukemɨkɨ Peratsini hɨriyaritsie hepaɨ,","poem":1},{"text":"Kemɨtiukuyua Kawahuni mayeweritsie hepaɨ,","poem":2},{"text":"yu'uximayatsika 'aye'atɨanike xewitɨ mɨka'imaiwe,","poem":1},{"text":"yu'aitɨarika maye'atɨanikɨ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"'Ayumieme hikɨ, xeketeneuhayewa xeteyukananaimatɨ,","poem":1},{"text":"kapa matsi kwinimieme tepɨa kaunariyarikɨ xeyutihɨani,","poem":2},{"text":"Ti'aitame mɨpaɨ mɨnetiutaxatɨakɨ,","poem":1},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye,","poem":2},{"text":"'ikɨ kexemɨteheuyehɨiyani hepaɨtsita","poem":1},{"text":"kemɨtiuxatsie 'ikɨ kwieyari naime hepaɨtsita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Xekeneu'enana, neniuki xekeneu'eni,","poem":1},{"text":"kayuwatɨ xekeneu'enana, neniuki xekeneu'eni:","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kepauka ti'uximayatame mukwietsanane ka'enike,","poem":1},{"text":"¿ka'uxipietɨ tiyuriene?","poem":2},{"text":"¿Tukarikɨ kwietsananetɨ meta rakuxexeɨriwatɨ raka'iyuniwa?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Kepauka kwie 'aixɨa makuyurieni,","poem":1},{"text":"'imɨari witsima'ane meta kuminutsi kanika'emɨkɨ.","poem":2},{"text":"Tɨriku kaniuka'etsani xuruku tiwewieme,","poem":1},{"text":"tsewara hakewa maka'etsiwatsie,","poem":2},{"lineBreak":true},{"text":"meta manunenieretsie 'iku kanika'emɨkɨ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kakaɨyari kanihɨkɨtɨni kemɨ'ane mɨtikuxaxatɨwa","poem":1},{"text":"mɨti'ɨkitɨa kehepaɨ mɨtiyurienikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"'Imɨari witsima'ane manuxɨtetɨkakɨ pɨkakaweiwa,","poem":1},{"text":"meta kuminutsi hetsie kaxeta 'ɨkaya pɨka'uyeyeika,","poem":2},{"text":"matsi witsimu'ɨa tuturiyari kɨye 'etsipemekɨ kaniweiwani,","poem":1},{"text":"meta kuminutsi kɨye 'apamekɨ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"'Uriyari kanitiketsinarɨwani, peru waɨkawa pɨkaketsinarɨwa,","poem":1},{"text":"meta ka'uxipietɨ pɨtiketsinarɨwa.","poem":2},{"text":"Hetsiena kaxeta 'ɨkaya kaniuyehanietɨyeikani,","poem":1},{"text":"peru kawayutsixi mepɨka'itɨxiwawe.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"'Ikɨtsiere Yawé Naimekɨmɨtɨrɨkaɨye hetsie katinayeneikani,","poem":1},{"text":"kanimariweni yu'ɨxatsikɨ","poem":2},{"lineBreak":true},{"text":"meta waɨkawa katinimaika.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/27.json","previousChapterAudioLinks":{},"numberOfVerses":29}