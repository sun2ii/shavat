{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":29,"content":[{"type":"heading","content":["Xɨa'ui Rawiri kiekariena"]},{"type":"verse","number":1,"content":[{"text":"Xɨa'ui, 'Ariheri, 'Ariheri,","poem":1},{"text":"kiekari hakewa Rawiri metayatsie.","poem":2},{"text":"Tawarita xeiwiyari xekenanutiyetsa meta tawarita xeiwiyari,","poem":1},{"text":"'ixɨarari tukariyari yakereuyuweiyani.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Peru 'Ariheri hetsɨa nekaninuamɨkɨ nemɨtika'enitsitɨanikɨ,","poem":1},{"text":"tsuari kanitixuawerimɨkɨ meta hiwerika,","poem":2},{"lineBreak":true},{"text":"nehetsiemieme tɨɨ yayatsame pɨhɨkɨtɨni mawari matitaiyarɨwatsie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'A'aurie nekanitayerɨmɨkɨ nemetsitamienieke,","poem":1},{"text":"kɨyexikɨ nekamanakurarutɨiyatɨyeimɨkɨ,","poem":2},{"lineBreak":true},{"text":"'akurarutsie temeukatsunaxɨani tekanitiwewiekuni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nitixaɨtɨ pekatihɨkɨtɨtɨ, kwiepa pe'ukaitɨ pekanitahiwamɨkɨ,","poem":1},{"text":"tumuanaripa 'aniuki waɨriyarika xeikɨa kani'eniɨriɨkɨkamɨkɨ.","poem":2},{"text":"'Aniuki kwieta kanatinemɨkɨ","poem":1},{"text":"tiyumariutame niukieya hepaɨ,","poem":2},{"text":"'aniuki tumuanari tsatapaitɨ,","poem":1},{"text":"waɨriyarika kaniyu'eniɨriɨkɨkamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Peru memɨyumɨire memɨmetsi'aye'unie","poem":1},{"text":"kwie waɨkawa mutumuani mekanakɨnikuni,","poem":2},{"text":"meta yumɨiretɨ memɨkateyukanenimaya","poem":1},{"text":"kuxari mekanakɨnikuni 'eka mei'enitsitɨwa.","poem":2},{"text":"Yapauka, kwitɨwa,","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Yawé Naimekɨmɨtɨrɨkaɨye 'ahetsɨa kaninuamɨkɨ,","poem":2},{"text":"mimierɨkarikɨ kaninuamɨkɨ, kwie watayuitɨwatɨ,","poem":1},{"text":"meta waɨkawa tɨranari xuawitɨatɨ,","poem":2},{"text":"kaninuamɨkɨ haikɨri 'amɨpa mɨtɨrɨkɨye 'ayu'eriyame hamatɨa","poem":1},{"text":"meta tai tiyutaiyame hamatɨa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Memɨyɨmɨire nuiwarite","poem":1},{"text":"'Ariheri memɨmietɨwe,","poem":2},{"text":"yunaitɨ kemɨ'ane memimietɨwe","poem":1},{"text":"meta titatsie mɨtiyutɨrɨkariya,","poem":2},{"text":"kemɨ'ane memenutinama,","poem":1},{"text":"heinɨtsi hepaɨ mekaniyɨkuni,","poem":2},{"lineBreak":true},{"text":"heiwa yɨwikɨta mɨtiuniere hepaɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Haakamɨkame rekwatɨ mɨtiyuheinɨtsa hepaɨ,","poem":1},{"text":"peru manutanieretsie reuhaakamɨkɨni,","poem":2},{"text":"harimɨkame heharetɨ mɨtiyuheinɨtsa hepaɨ,","poem":1},{"text":"matsi manutanieretsie ranatiwakini.","poem":2},{"text":"Nuiwarite mɨpaɨ mekaniyɨkuni yunaitɨ memɨyuwaɨkawa","poem":1},{"text":"Tsiyuni hɨriyari memɨmietɨwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"'Atsixekatemaitɨ xekenakɨni, xemamatɨ xekaniuwawetɨ xekeneti'uti,","poem":1},{"text":"xekaheunenieretɨ xekenakɨni, tixaɨtɨ tɨma xekatexeiyatɨ,","poem":2},{"text":"xekenetarɨweka, peru winukɨ hawaikɨ,","poem":1},{"text":"xekenekeitsarietɨweni, peru winukɨ hawaikɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yawé xehetsie kanikawiwieni","poem":1},{"text":"'iyari waɨkawa xemeukutsukɨ,","poem":2},{"text":"Kakaɨyari niukametemama mekaneniereme puwarayeitɨa,","poem":1},{"text":"Kakaɨyari hetsie timiemekɨ memɨtaneniere wahɨxie pɨwareutinaxɨa.","poem":2}]},{"type":"verse","number":11,"content":["Xehetsiemieme, naitɨ 'ikɨ kexemɨteneniere xekanixeiyani xeikɨa nawi kwikwiekametsie 'anukanakame. Xɨka mɨkɨ mukwikwiya xeime xeyetuirieni mɨreutaterɨwawe, mɨpaɨ xɨka xete'itahɨawe: «Pamɨpariyutsi xɨa'ui, 'ikɨ kenakaterɨwa», mɨkɨ mɨpaɨ kanitayɨmɨkɨ: «Nepɨkayɨwe, kananukanaka»."]},{"type":"verse","number":12,"content":["Xɨka xeimeta mɨkɨ mukwikwiya xeyetuirieni mɨkatiterɨwawe, xɨka mɨpaɨ xete'itahɨawe: «Pamɨpariyutsi xɨa, 'ikɨ kenakaterɨwa», mɨkɨ mɨpaɨ kanitayɨmɨkɨ: «Matsi nepɨkatiterɨwawe»."]},{"type":"line_break"},{"type":"verse","number":13,"content":["Ti'aitame mɨpaɨ kanaineni:",{"text":"«'Ikɨ teɨteri mepɨnetsinɨawa yutenikɨ","poem":1},{"text":"meta 'aixɨa mepɨnetehahɨawe,","poem":2},{"lineBreak":true},{"text":"peru wa'iyari 'ateewa puyeika.","poem":2},{"text":"Memɨnetsihayexeiya 'aitsikakɨ xeikɨa mekaniyɨaka","poem":1},{"text":"teɨteri yametewa'aitɨakaku.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Ayumieme, tawarita 'ikɨ teɨteri nekaniwahɨxiyatsitɨamɨkɨ","poem":1},{"text":"mariwemekɨ netiyurienetɨ,","poem":2},{"text":"temaiwawemete kememɨtemaiwawe mekaneiyehɨakuni","poem":1},{"text":"kememɨteheutamaiwawekai metematetɨri mepɨka'akɨne».","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Xɨa'ui kemɨ'ane, kememɨteyuriku me'awietakutɨ,","poem":1},{"text":"Yawé hɨxie memuyu'awieta meukatetewatsie,","poem":2},{"text":"'axamepɨteyurie yɨwikɨta, meta mɨpaɨ mepɨteku'eriwa:","poem":1},{"text":"«¿Kemɨ'ane kuta pɨtatsixeiya? ¿Kemɨ'ane pɨtatsimate?»","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Keri titayari mɨya meteyɨa.","poem":1},{"text":"¿Kamɨtsɨ 'iwewame haxu hamatɨa yaxeikɨa mete'anene?","poem":2},{"text":"¿Kamɨtsɨ mutawewiya kemɨ'ane mitawewi mɨpaɨ titahɨawe:","poem":1},{"text":"«Mɨkɨ pɨkanetsi'utawewi»?","poem":2},{"text":"¿Kamɨtsɨ xari yu'iwewame mɨpaɨ tiutahɨawiwe:","poem":1},{"text":"«Mɨkɨ 'atsipɨkatimate»?","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Riwanu kwitɨwa","poem":1},{"text":"kwie 'aixɨa mɨ'ane mɨraku'etsitɨre kanayeimɨkɨ,","poem":2},{"lineBreak":true},{"text":"meta mɨraku'etsitɨrekaitsie makukariuxaya kanayeimɨkɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"'Iya tukaritsie memɨkaheu'enana mepɨyɨwaweni","poem":1},{"text":"nawi kwikwiyaritsie terɨwarika mayemie memɨ'enienikɨ,","poem":2},{"text":"meta memɨkaheuneniere wahɨxite pɨneniereni","poem":1},{"text":"muyɨwitsie meta 'etɨriyaritsie me'u'uwatɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tixaɨtɨ memɨkateheuxeiya meyutemamawietɨ Yawé hetsiemieme mekanakɨnikuni,","poem":1},{"text":"yemekɨ waɨkawa memɨteheuyehɨwa mekaniyukatemamawikuni Mɨpatsie 'Ixaheri hetsiemieme.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Memɨteyukananaima mepɨka'u'uwaniri,","poem":1},{"text":"memɨteyukatawe'erie mekanikumawerikuni,","poem":2},{"text":"Meta yunaitɨ kemɨ'ane memɨkakutsu 'axameteyurietɨ","poem":1},{"text":"mekaneuyehɨiyakuni.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kemɨ'ane niukikɨ xeime hetsie mɨtiɨhɨpa,","poem":1},{"text":"kemɨ'ane tixanetɨariwame memɨwiniya,","poem":2},{"lineBreak":true},{"text":"meta 'itarikakɨ 'aixɨa mɨtiuyeika memɨnanaima.","poem":2}]},{"type":"verse","number":22,"content":["'Ayumieme, Yawé, 'Apɨrahami hetsie nunuwame, mɨpaɨ katiniwarahɨaweni Kakuwu nuiwarimama:",{"text":"«Kakuwu pɨkayutewiyaniri,","poem":1},{"text":"meta yuhɨxie pɨka'ayexetare.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kepauka mɨkɨ yuniwema muwaxeiya,","poem":1},{"text":"meta neti'uximayakame mɨkɨ watsata,","poem":2},{"text":"mɨkɨ yunaitɨ nepatsiekame mepayeitɨaka kenemɨtitewa,","poem":1},{"text":"patsiekame mepayeitɨaka Kakuwu hetsie Mɨpatsie,","poem":2},{"lineBreak":true},{"text":"meta 'Ixaheri Kakaɨyarieya mepayemakaxeni.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kemɨ'ane 'iyari heuyexɨriekame memexeiyakai yamepɨtehetimani,","poem":1},{"text":"meta 'axamemɨteniniukikai yamepɨtetanaki'erieni memɨta'ɨxatsitɨarienikɨ».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/28.json","previousChapterAudioLinks":{},"numberOfVerses":24}