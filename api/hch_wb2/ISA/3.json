{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":3,"content":[{"type":"heading","content":["Ke'aixɨa mɨtiyɨni Kerutsareme meta Kura kwieyaritsie"]},{"type":"verse","number":1,"content":[{"text":"Tsiparatsɨ xekeneu'enana.","poem":1},{"text":"Ti'aitame, Yawé Naimekɨmɨtɨrɨkaɨye,","poem":2},{"text":"Kerutsareme meta Kura pɨtinawairieni,","poem":1},{"text":"naime parewiya meta naime titakɨ memɨteyumikwakai:","poem":2},{"lineBreak":true},{"text":"naime 'ikwai memɨteheuyehɨakai,","poem":2},{"lineBreak":true},{"text":"meta naime haa kememɨteheuyehɨakai.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mɨkɨ mɨka'utimamawe meta kwinimieme mɨreuyutamiewe pakumaweriya,","poem":1},{"text":"'itsɨkame meta Kakaɨyari niukameya,","poem":2},{"lineBreak":true},{"text":"muyuawitsie miemekɨ mɨtiyɨ'ɨkitɨa meta 'ukiratsi,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"kuyaxi wa'ukiyari meta mariwemekɨ ti'uximayatame,","poem":2},{"lineBreak":true},{"text":"'ɨxatsitame, meta kwinimieme mɨreutawewiwe","poem":2},{"lineBreak":true},{"text":"meta 'utakwitɨ tixaɨtɨmexi mɨtiwawiwiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Memanuyetei temari pɨta nepɨwarayeitɨani,","poem":1},{"text":"meta tɨɨri te'aitamete nepuwarayeitɨani.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yuxexuitɨ hipame wahamatɨa mepuyuti'uximatɨani:","poem":1},{"text":"yuhepaɨ 'ukitsi mepuyu'uximatɨaka,","poem":2},{"lineBreak":true},{"text":"yu'aurie kiekatari,","poem":2},{"lineBreak":true},{"text":"temaikɨ, 'ukiratsi hamatɨa,","poem":2},{"lineBreak":true},{"text":"tewi tixaɨtɨ mɨkatihɨkɨ, waɨkawa mɨtiyunaki'erie hamatɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Hikɨ xewitɨ tewi yu'iwa kaniwiyamɨkɨ","poem":1},{"text":"yupaapa kie, mɨpaɨ katinitahɨawimɨkɨ:","poem":2},{"text":"«'Ekɨ pemanuyeyerɨni pepɨhɨkɨtɨni, 'ekɨ tuwaxa 'amɨyewa pemexeiyakɨ,","poem":1},{"text":"'ikɨ kiekari naitɨ mu'unitsie 'aixɨa ketineuyuri».","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Matsi mɨkɨ mɨpaɨ katinita'eiyamɨkɨ:","poem":1},{"text":"«Ne tiyu'uayemawame nepɨkahɨkɨ,","poem":2},{"text":"nekie paa pɨkaxɨawe meta tuwaxa 'amɨyewa nepɨkahexeiya,","poem":1},{"text":"teɨteri nemɨtiwata'aitɨanikɨ pepɨkanetsi'anuyeyetsani».","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kerutsareme kaniwatayuakeni,","poem":1},{"text":"Kura kanika'unikeni,","poem":2},{"text":"mɨya mepɨte'anuyehu","poem":1},{"text":"Yawé kemɨkatinake memutiyuanekɨ meta mɨpaɨ memɨte'u'uwakɨ:","poem":2},{"lineBreak":true},{"text":"me'ixani'erietɨ mɨkɨ mariwetɨ witsikemɨtiyuxexeiya.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kememɨteyurie yuhɨxie paitɨ mepumatsiɨkɨ","poem":1},{"text":"meta ke'axamemɨteyuriekɨ mekaniyutemamawieka Tsurumatari wahepaɨ,","poem":2},{"lineBreak":true},{"text":"kememɨteyurie naime mepɨtewaxeitsitɨa.","poem":2},{"text":"Xɨa'ui mɨkɨ wahetsiemieme,","poem":1},{"text":"yɨkɨmana 'axa'anekɨa memeuyukaxɨrɨwakɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Heitseriemekɨ yamɨtikamie mɨpaɨ xeketeneutahɨawi kename 'aixɨa 'anemekɨ yeyani,","poem":1},{"text":"kemɨtiuyurikɨ kaniyutemawiekamɨkɨ 'ikwaxi xeiyatɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Xɨa'ui 'axamɨtiuka'iyari, matsi 'aixɨa 'anemekɨ pɨkayeyani.","poem":1},{"text":"Ti'uximayatɨ kemɨtiuyuri yakatinipitɨariemɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Xɨa'ui neteɨterima, waɨriyarika memɨtewa'aitɨa tɨɨri mepɨhɨkɨ","poem":1},{"text":"meta 'ukarawetsixi mepɨte'aitamete.","poem":2},{"text":"Xɨa'ui neteɨterima, memɨxe'uwitɨxime mepɨxeheuyexɨrie,","poem":1},{"text":"huyeta yeuta mepeukuyuyuipike.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yawé puyukuha'aritɨwa wahetsie mɨrahɨanikɨ,","poem":1},{"text":"'apuwe yuteɨterima wataxanetake.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yawé 'iwaurika kaniwewimɨkɨ","poem":1},{"text":"'ukirawetsixi wahepaɨtsita meta yuteɨterima wahɨxie memanuyetei:","poem":2},{"text":"«Xeme kaxie xekaniukaxɨtɨani,","poem":1},{"text":"tixaɨtɨ mɨkarexeiya tipiiniteya xekiita katineyepika.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"¿Titakɨ heitserie xetehexeiyatɨ neteɨterima xetewananaima","poem":1},{"text":"tixaɨtɨ memɨkatehexeiya waheima xete'uyehu?»,","poem":2},{"text":"mɨpaɨ kanaineni Ti'aitame,","poem":1},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Yawé mɨpaɨ kanaineni:","poem":1},{"text":"«Tsiyuni niwemama 'ukari kwinimieme mekateniyuti'ɨreni","poem":2},{"text":"yɨkɨipi mehutseratɨkaitɨ mekaniku'uwani,","poem":1},{"text":"xeime kwamanamɨtɨ kemɨtiuneniere meta kememɨte'ɨkɨka mepuyumatsiɨkɨ,","poem":2},{"lineBreak":true},{"text":"yu'ɨkatetsie memɨteheutapietɨka mete'utiyuitɨwatɨ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"'Ayumieme Yawé nerɨitsitekɨ kaniwakanɨmɨkɨ","poem":1},{"text":"Tsiyuni niwemama 'ukari wamu'utsie,","poem":2},{"lineBreak":true},{"text":"Yawé yemekɨ memu'umetsekame kaniwahayewamɨkɨ».","poem":2}]},{"type":"verse","number":18,"content":["'Iya tukaritsie, Ti'aitame naime pɨtikɨxɨnaxɨani tita memɨteheukapine: kakaitsie tepɨa mɨkamanetɨka, kɨpatetsinamete, tɨpunite,"]},{"type":"verse","number":19,"content":["nakɨtsate, matsɨwate, 'ixurikite kɨmana memanuyukunarɨma,"]},{"type":"verse","number":20,"content":["tuwaxate, tepɨa kaunariyari 'ɨkatetsie mieme, hɨiyamete, witsimɨtiu'ɨatɨka, mɨrakatɨriketɨka,"]},{"type":"verse","number":21,"content":["hanira, mɨxikɨrawi tsuritsiemieme,"]},{"type":"verse","number":22,"content":["kamixate witsimɨti'anene, matate, kamixa witsimɨnene, kɨtsɨurite 'etsimɨnene,"]},{"type":"verse","number":23,"content":["xikɨrite, 'ixurikite 'aixɨa mɨ'anene, mukuretsi meta xikurite."]},{"type":"verse","number":24,"content":[{"text":"Witsimɨtiu'ɨakai katinitikuri'ɨakaxɨamɨkɨ,","poem":1},{"text":"hɨiyame kaunari pɨhɨkɨtɨni,","poem":2},{"lineBreak":true},{"text":"mepɨkahunixɨani witsimemɨteyutsikeniyari,","poem":2},{"lineBreak":true},{"text":"hiwerika kamixayari mepanakatɨni witsimɨ'anene memanakatɨkɨniyari,","poem":2},{"lineBreak":true},{"text":"mepuyutetewiyani witsimemuyukuyuruwaniyari.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"'Ateɨterima 'ixiparakɨ mepɨkwi'iwa,","poem":1},{"text":"meta memɨka'ukamama 'ahetsɨa miemete meyukwitɨwetɨ mepukwi'iwa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kiekari 'itupariyari putitsuanani meta hiwerika kamixayari panakatɨni,","poem":1},{"text":"yuxaɨta kiekari nutuixietɨ, kwiepa pɨtayerɨni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}