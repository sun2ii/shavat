{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":30,"content":[{"type":"heading","content":["'Ekipitu hetsie memɨtewiya wahetsiemieme"]},{"type":"verse","number":1,"content":["Yawé mɨpaɨ kaniutayɨni:",{"text":"«Xɨa'ui tɨɨri memɨkaheu'enana","poem":1},{"text":"kememɨteyurienikɨ memɨtekuxata nehetsɨa mɨkatimiemekɨ,","poem":2},{"text":"ne'iyari kemɨkatinake memɨtekuxata,","poem":1},{"text":"'axamɨti'ane waɨkawa memukuxeɨrie,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"mekanetsi 'uta'iwawiyatɨ 'Ekipitu memeukakɨka,","poem":1},{"text":"Parahuni hetsɨa memekɨka wahetsie munuakakɨ,","poem":2},{"lineBreak":true},{"text":"meta 'Ekipitu 'etɨriyayatɨa memuyu'awieta.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Parahuni xehetsie munua xetewiyarika payani.","poem":1},{"text":"'Ekipitu hetɨa xemɨ'etɨpie, tixaɨtɨ xetehɨkɨtɨme pɨkaxe'ayeitɨani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tsepa Tsuhani xemɨwarexeiya paratsiyuta te'uximayatamete,","poem":1},{"text":"yatɨni tsepa Kanetsi paitɨ xenɨ'arima memɨte'u'axɨa,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"yunaitɨ mepɨtewiyatsitɨarieni,","poem":1},{"text":"mɨkɨ teɨteri tixaɨtɨ memɨkateyunaki'erie ya'aneme meheutiwiwiexɨaku,","poem":2},{"text":"nitixaɨtɨkɨ memɨkatewaparewie meta memɨkawareuyehɨwa,","poem":1},{"text":"tewiyarika xeikɨa meta 'atsimepɨkatematé kememɨteyurienikɨ».","poem":2}]},{"type":"verse","number":6,"content":["'Ikɨ kanihɨkɨtɨni kenemutayɨ tewaxi wahepaɨtsita Nekexi makumawetsie memuyekɨka:",{"text":"Kwiepa kweriwa'anekɨa 'uximatɨarika tsata,","poem":1},{"text":"mayetsi mexuawekaku,","poem":2},{"lineBreak":true},{"text":"kuuterixi mexuawekaku meta kuuterixi memawɨwawe,","poem":2},{"text":"mɨkɨ mekatenetɨni puxuri wahetsie","poem":1},{"text":"nuiwari tixaɨtɨkɨ memɨkateyunaki'erie mana tita waɨkawa memɨtehexeiyakai,","poem":2},{"lineBreak":true},{"text":"tita waɨkawa mɨraye'atɨka memɨtehexeiyakai kameyutsixi wahetsie mekatene'ikata.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Ekipitu parewiyaya nitixaɨtɨ pɨkatihɨkɨ,","poem":1},{"text":"'ayumieme mɨpaɨ nepɨtiterɨwa: «Xahawi, mɨkakuyuane».","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kamɨtsɨ, mɨkɨ wahɨxie kenemie,","poem":1},{"text":"meta mexatsie ketina'utɨa.","poem":2},{"text":"Nawi kwikwiekametsie kenaka'utɨa,","poem":1},{"text":"'uxa'atɨni warie","poem":2},{"lineBreak":true},{"text":"yamɨre'ukakɨ kemɨtiɨyɨ yuheyemekɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Ikɨ teɨteri memɨkaheu'enana memɨhɨkɨkɨ 'ayumieme,","poem":1},{"text":"tɨɨri memɨteyukwamana mekanihɨkɨtɨni,","poem":2},{"text":"tɨɨri Yawé 'ɨnɨari niukiyari memɨka'eniku.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Memɨtaneniere Kakaɨyari hetsie timiemekɨ,","poem":1},{"text":"mɨpaɨ mekateniwakɨhɨaweni:","poem":2},{"lineBreak":true},{"text":"«Kexemɨtetanenierekɨ xeketeneuhayewa»,","poem":2},{"text":"meta Kakaɨyari niukametemama mɨpaɨ mekateniwakɨhɨaweni:","poem":1},{"text":"«Tawariri tita yuri mɨraine xepɨkatatekuxaxatɨwani.","poem":2},{"text":"Witsimɨranuyɨtɨka pɨta xeketatenekuxaxatɨwani,","poem":1},{"text":"xeketenekuxatani witsiketemɨteku'eriwa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Huye xekeneuku'eiri,","poem":1},{"text":"mɨkɨ huye xekeneuhayewa,","poem":2},{"text":"xeketaneuhayewa Mɨpatsie 'Ixaheri hetsiemieme","poem":1},{"text":"kemɨtatsiyurieneni».","poem":2}]},{"type":"verse","number":12,"content":["Mɨpaɨ kanaineni 'Ixaheri hetsie Mɨpatsie:",{"text":"«Xeme 'ikɨ niuki xepɨkahanu'eni,","poem":1},{"text":"'uximatɨarikatsie pɨta yuri xepɨte'uta'eri meta 'axamɨti'anetsie,","poem":2},{"lineBreak":true},{"text":"mɨkɨtsie pɨta xepuyutɨrɨkariya.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Ayumieme 'axakexemɨte'uyuri xehɨxie pɨtakeni","poem":1},{"text":"kuraru 'amatitewa hepaɨ meta 'ukatsitsinitɨ,","poem":2},{"lineBreak":true},{"text":"hatiweximetɨ:","poem":2},{"lineBreak":true},{"text":"hikɨ, yapauka, kanatiwemɨkɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Axakexemɨye'uyuri 'etsipepetɨ kanayeimɨkɨ,","poem":1},{"text":"'etsipepetɨ, xari mutatare hepaɨ:","poem":2},{"lineBreak":true},{"text":"nixewitɨ tɨma 'etsiyeutɨ tiyunaki'erietɨ pɨkayuhayewa,","poem":2},{"lineBreak":true},{"text":"kɨmana tɨɨ taipa manayetɨkɨ pɨkayɨweni","poem":2},{"lineBreak":true},{"text":"meta putsuta haa muwatihana».","poem":2}]},{"type":"verse","number":15,"content":["'Ayumieme mɨpaɨ kanaineni Yawé naimekɨmɨyɨwe, 'Ixaheri hetsie Mɨpatsie:",{"text":"«Xɨka xete'uhayewa meta kayuwatɨ xehexeiyatɨ xe'akɨne, xekanitawikweitsitɨariekuni,","poem":1},{"text":"'aixɨa 'iyari xe'u'uwatɨ meta yuri xete'erietɨ xekanitɨrɨkariyariekuni,","poem":2},{"lineBreak":true},{"text":"peru xeme mɨpaɨ xemɨtehetimani xepɨkayuwaɨriya.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Xepɨkayɨne mɨpaɨ xeputiyuane: “Tekaniyuta'unakuni kawayutsixi wahetsie te'utetɨ”.","poem":1},{"text":"'Ayumieme, mɨpaɨ xekateniyuta'unakuni.","poem":2},{"text":"Mɨpaɨ xekaniutiyuaneni: “Kawayutsixi memanautsawawetsie tekananutiyaxikuni”.","poem":1},{"text":"'Ayumieme, kwinimieme mehayɨwawetɨ mepayenexɨani memɨwaraye'unie.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yuxewitɨ xekwinekaku,","poem":1},{"text":"xeimiriyari xeme xekaniyuta'unakuni,","poem":2},{"text":"yu'auxɨwitɨ mexekwitɨwekaku,","poem":1},{"text":"xeme yunaitɨ xekaniyuta'unakuni.","poem":2},{"text":"Xekaniku'eiriwakuni","poem":1},{"text":"hɨritsie kɨye patera manuyewiwierekai hepaɨ","poem":2},{"lineBreak":true},{"text":"yemuritsie patera 'inɨari hepaɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"'Ayumieme Yawé kanixekwewieka, mɨxeparewienikɨ,","poem":1},{"text":"'ayumieme kanixehahɨaweni kemɨtixenenimaya xemeitimanikɨ.","poem":2},{"text":"Yawé Kakaɨyari heitserie mɨtiyurienekɨ.","poem":1},{"text":"'Aixɨa meke'itɨarieka kemɨ'ane hetsiena timieme memɨtetakwewie.","poem":2}]},{"type":"verse","number":19,"content":["Teɨteri Tsiyunitari, Kerutsareme xemɨtama, tawariri xepɨkatitsuani. Kakaɨyari mɨtiyukanenimaya pɨxetinenimayata kepauka xemitahiwieni parewiya xeku'iwawatɨ. Yapauka kepauka mɨxe'enieni, pɨxeta'eiya."]},{"type":"verse","number":20,"content":["Tsepa ti'aitame paa mɨxe'umi xemaye'uniwanikɨ meta haa xemu'uximatɨariekakɨ, xeti'ɨkitɨwame tawariri pɨkayuti'awieta, yuhɨxitekɨ xepixeiya."]},{"type":"verse","number":21,"content":["Tsepa tatserieta pemeukuyunixɨ yatsepa ta'utata, 'anakata mɨpaɨ pepɨti'ena niuki mɨpaɨ matikɨhɨaweme: «'Ikɨ mɨkɨ huye kanihɨkɨtɨni, keneuweiyani»."]},{"type":"verse","number":22,"content":["Hikɨ memɨkakakaɨyarixi pemɨwarexeiya mekapatsiekame pekaniwarayeitɨamɨkɨ pɨratakɨ meta hurukɨ memɨkawiriyarietɨka, pekaniwarexɨrimɨkɨ tixaɨtɨ mɨkati'itiyaka hepaɨ, mɨpaɨ pekatiniwatahɨawimɨkɨ: «Xekenanuyekɨni»."]},{"type":"verse","number":23,"content":["Yawé wiyeri pɨxehanɨ'airieni 'imɨari xemɨka'eni hetsiemieme, meta 'ikwaxi waɨkawa mɨtitixuawere witsipa'aneni. 'Iya tukaritsie xetewama 'ɨxa 'eyeyeumetsie mepɨtetikwani."]},{"type":"verse","number":24,"content":["Tuurutsixi meta puxuri memɨte'uximaya 'aixɨa 'aneneme mume 'etsime mekanitikwaikuni, nakitsaraɨkɨ meta parakɨ teikɨ mewiwiya."]},{"type":"verse","number":25,"content":["'Imieri tukariyari maye'anitsie, kepauka tuxiyu makainariexɨani, 'ana 'akitsie haa 'uhapanetɨ kanayeimɨkɨ meta haixa kanitixuawerimɨkɨ naitsarie hɨritsie 'amutɨtɨtsie."]},{"type":"verse","number":26,"content":["Kepauka Yawé yuteɨterima wa'umete manaku'eimaxɨanitsie meta muwa'uayemanitsie mɨtiwarukwinitɨakai, 'ana metsa tau hepaɨ tixawatɨtɨ kanayeimɨkɨ, meta tau xawatɨriyaya 'atahutamexɨa tawarita xawatɨtɨ kanayeimɨkɨ, tau 'axeikɨa 'atahutatɨ mɨkɨxeni hepaɨ."]},{"type":"verse","number":27,"content":[{"text":"Neuxei. Yawé kemɨtitewa 'ateewa kanamieni,","poem":1},{"text":"haxɨakɨ tatɨ waɨkawa kɨtsi 'anawietɨ,","poem":2},{"text":"tenieyatsie pɨhɨpɨne haxɨa,","poem":1},{"text":"nenieya tai mɨtiyuxɨtsitɨwa hepaɨ pɨ'ane.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"'Iyaya haa manatiyeurieni hepaɨ kani'aneni","poem":1},{"text":"takɨipitɨa paitɨ pɨye'axe,","poem":2},{"text":"nuiwarite kaniwaranuyekatsimɨkɨ","poem":1},{"text":"katsemetsie wareuyehɨanike.","poem":2},{"text":"Teɨteri wateta kaniwarutakeitsitɨani","poem":1},{"text":"pirenu yeuta memeukuyunekɨ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Xeme xeputikwikani patsiekamekɨ memuyukuxexeɨriwa tɨkariyaritsie hepaɨ,","poem":1},{"text":"xe'iyarite puyutemamawieka,","poem":2},{"text":"kepauka xewitɨ manutiyani pirikɨxa 'uhɨtsieximetɨ hepaɨ","poem":1},{"text":"Yawé hɨrieyatsie,","poem":2},{"lineBreak":true},{"text":"'Ixaheri 'Aiya hetsie.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Yawé katani'enitɨamɨkɨ yuniuki mɨmariwe,","poem":1},{"text":"yutɨrɨkariya tahɨxie kanikatetɨamɨkɨ:","poem":2},{"text":"haxɨaya mutarɨrɨrɨka meta taiya mɨtiyuxɨxɨtsitɨwa,","poem":1},{"text":"haa tsata, 'eka tsata meta tee tsata.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Yawé niukieya 'Atsiriya kanitimuraxɨamɨkɨ,","poem":1},{"text":"yu'itsɨkɨ kaniwamɨkɨ.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Xei'iwaɨyɨyarikɨ Yawé hetsiena kemɨranutatetɨwa","poem":1},{"text":"yukɨye 'iwaɨyɨpame mɨtiyukwinitɨwakɨ","poem":2},{"text":"tepu meta haripa hayuanekaku katiniyurimɨkɨ,","poem":1},{"text":"yumamá 'uyuitɨwatɨ, kaniwatakwimɨkɨ.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Tupeti meripaitɨri kaniyukuha'aritɨani,","poem":1},{"text":"ti'aitame hetsiemieme kanihɨkɨtɨni.","poem":2},{"text":"Teeka kaniwati'inierieni heukatewatɨ 'awatiyeutɨ,","poem":1},{"text":"waɨkawa tai meta kɨyexi hexeiyame,","poem":2},{"text":"Yawé 'ihɨtsieyu kanitaimɨkɨ,","poem":1},{"text":"tai hayari hatɨa muhaneni hepaɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}