{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":31,"content":[{"type":"heading","content":["Xɨa'ui kemɨ'ane 'Ekipitu hetsie memɨtewiya"]},{"type":"verse","number":1,"content":[{"text":"Xɨa'ui kemɨ'ane 'Ekipitu memekɨka parewiya mekuwautɨwetɨ,","poem":1},{"text":"meta kemɨ'ane kawayutsixi wahetsie memuyukuparewie,","poem":2},{"text":"kemɨ'ane kaxetate kuyaxa miemetetsie memuyukuparewie","poem":1},{"text":"meta memanutiyaxike wahetsie,","poem":2},{"text":"peru Mɨpatsie 'Ixaheri hetsiemieme memɨkaha'eriwa,","poem":1},{"text":"meta Yawé memɨkakuwautɨwe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yawé, matsi mɨtimaiwe kanihɨkɨtɨni,","poem":1},{"text":"kwiniya kani'atɨamɨkɨ,","poem":2},{"lineBreak":true},{"text":"meta kemɨtayɨni yakatinikamieni.","poem":2},{"text":"'Axamemɨte'u'iyari kaniwa'uximatɨamɨkɨ,","poem":1},{"text":"meta kemɨ'ane memɨwaparewie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Ekipitutari, matsi, mepɨteɨteri, mepɨkakakaɨyarixi,","poem":1},{"text":"wakawayutsixi mepɨwaite, 'iyarite mepɨkahɨkɨ.","poem":2},{"text":"Kepauka Yawé mɨtiwakwinitɨani,","poem":1},{"text":"kemɨ'ane parewiya mɨyetua kanekawemɨkɨ,","poem":2},{"text":"meta kemɨ'ane memuparewiya kanatiwemɨkɨ.","poem":1},{"text":"Yunaitɨ mekanikwikuni.","poem":2}]},{"type":"verse","number":4,"content":["Mɨpaɨtsɨ Yawé kanetinahɨaweni:",{"text":"«Maye muyutahaxɨatɨwa yu'ikwai hetsie nuatɨ,","poem":1},{"text":"kepauka hepaɨtsitana memuyukuxeɨrieni","poem":2},{"lineBreak":true},{"text":"yunaitɨ muxatsi wahɨwemete,","poem":2},{"text":"maye temaikɨ hepaɨ","poem":1},{"text":"wahiwarikɨ mɨka'utimamawe","poem":2},{"lineBreak":true},{"text":"meta kayuwatɨ mɨkatiukieka wayuarikakɨ,","poem":2},{"text":"mɨpaɨta Yawé Naimekɨmɨtɨrɨkaɨye","poem":1},{"text":"katininuamɨkɨ watakwinike,","poem":2},{"lineBreak":true},{"text":"Tsiyuni hɨriyaritsie, 'amanutitewitsie.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Memawɨwawe yu'itua kememɨte'ɨwiya,","poem":1},{"text":"mɨpaɨta Yawé Naimekɨmɨtɨrɨkaɨye","poem":2},{"lineBreak":true},{"text":"Kerutsareme pɨtita'ɨwiya,","poem":2},{"text":"pi'awietani meta piparewieka,","poem":1},{"text":"hetsiena punuaka meta pitawikweitsitɨwani».","poem":2}]},{"type":"verse","number":6,"content":["Xeme 'ixaheritsixi, xekeneu'axɨa 'iya hetsɨa kemɨ'ane xe'aye'unietɨ xemakɨ waɨkawamekɨ."]},{"type":"verse","number":7,"content":["Karikɨ 'iya tukaritsie xeme yuxexuitɨ xepɨwarexɨrieni yukakaɨyarixi memɨwewiyatɨka pɨratakɨ meta hurukɨ mɨkɨ xemamate 'axamɨtiyuruwame mɨwarutiwewiekaikɨ."]},{"type":"verse","number":8,"content":[{"text":"«'Atsiriya 'ixiparakɨ kanimieriemɨkɨ, peru tewi pɨka'imieni,","poem":1},{"text":"'ixipara kanikumaweriyamɨkɨ, peru tewi 'ixiparaya pɨkatixaɨ.","poem":2},{"text":"Kaniyuta'unamɨkɨ 'ixipara makatɨ,","poem":1},{"text":"meta temarimama mekatenita'aitɨariekuni waɨriyarika mepitɨarietɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Marikakɨ memɨwayuti'awiwieta kanita'unimɨkɨ,","poem":1},{"text":"memanuyetei yupatera mekaniku'eirikuni».","poem":2},{"text":"Yawé mɨpaɨ kanaineni,","poem":1},{"text":"yutai Tsiyunitsie mexeiya,","poem":2},{"lineBreak":true},{"text":"meta yuhuxunu Kerutsaremetsie mexeiya.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/30.json","previousChapterAudioLinks":{},"numberOfVerses":9}