{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":32,"content":[{"type":"heading","content":["Ti'aitame 'aixɨa tiuka'iyaritɨ"]},{"type":"verse","number":1,"content":[{"text":"Neuxei, xewitɨ ti'aitame heitseriemekɨ katinita'aitamɨkɨ","poem":1},{"text":"meta kuwexinaruritsixi 'aixɨa 'anemekɨ mekatenita'uximayatakuni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yuxexuitɨ mɨkɨ 'eka hepaɨtsita memuyu'awietani hepaɨ mekani'anekuni,","poem":1},{"text":"wiyeri mɨ'ekama mɨkawakema,","poem":2},{"text":"haa 'akite 'utɨma muhapaneni hepaɨ makumawetsie,","poem":1},{"text":"'ai 'etɨriyari mekanihɨkɨtɨkakuni makumawetsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kemɨ'ane memeuneniereni 'aixɨa mepɨteneniereni,","poem":1},{"text":"memeu'enana mepuku'enakareni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mekaheitimaitɨkɨkatɨ memutiniuka mepeitimaitɨkɨkani meta mepeti'enatɨkɨkani,","poem":1},{"text":"memɨnenurietɨka 'aixɨa mepɨte'uxaxatani.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tewi 'aixɨa mɨtiuka'iyariri pɨkatiuterɨwarɨwani mɨka'uka'iyari","poem":1},{"text":"meta mɨtiuyuka'irɨwiya heitserie pɨkaxeiyarieka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mɨka'uka'iyari tixaɨtɨ mɨkatiyunaki'eriekɨ katinikuxatani,","poem":1},{"text":"'axamɨti'ane xeikɨa katiniku'eriwani,","poem":2},{"text":"'inɨari niukiyaritsie yapɨkatikamie","poem":1},{"text":"meta Yawé hepaɨtsita 'itarikakɨ katinikuxatani,","poem":2},{"text":"meuhaakamɨkɨ heuhakamɨkɨme kanikuhayeikawani,","poem":1},{"text":"meta kemɨ'ane meuharimɨkɨ pɨkakuharitɨwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mɨtiyukwamana katinikuwauneni kemɨtiwakwamanakɨ,","poem":1},{"text":"meta yakatinikuxatani kehepaɨ mɨtiwananaimanikɨ,","poem":2},{"text":"tixaɨtɨ memɨkatehexeiya kaniwaka'unani 'itarikakɨ,","poem":1},{"text":"tsepanetɨ tixaɨtɨ mɨkarexeiya mɨtixanetane.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Matsi, tewi 'aixɨa mɨtiuka'iyari,","poem":1},{"text":"'aixɨa mɨti'anekɨ kaniyɨhɨaweni,","poem":2},{"lineBreak":true},{"text":"meta ke'aixɨa mɨtiyuriene mɨkɨtsie kanimatsiɨkɨni.","poem":2}]},{"type":"heading","content":["'Ukari Kerutsaremetari"]},{"type":"verse","number":9,"content":[{"text":"'Ukarawetsixi nitixaɨtɨkɨ xemɨkateyɨhɨawe,","poem":1},{"text":"xekenanuku'uti meta xekeneneu'eni.","poem":2},{"text":"'Ukari kename 'atsikatixeyurieni xemɨteku'eriwa,","poem":1},{"text":"xekeneneu'eni kenemɨtixetahɨawe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Xeme, 'atsikatixeyurienike xemuyu'erie,","poem":1},{"text":"xeiwiyari 'anuyeyayu matsi xekanitiyɨyɨakakuni marikakɨ,","poem":2},{"text":"karikɨ kaxie pɨkatixuawere,","poem":1},{"text":"pɨkatika'inɨiyani.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Ukarawetsixi xemɨkayu'iyaritɨa, xekenemamaka.","poem":1},{"text":"Xeme, 'aixɨa 'iyari xemu'uwa,","poem":2},{"lineBreak":true},{"text":"xekeneuyɨyɨakatɨkani.","poem":2},{"text":"Xekeneuyutikemaripi, xekeneuyutimaweripi,","poem":1},{"text":"hiwerika kamixayari pɨta xekenanakatɨki.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yutawitsie xekeneuyuhutsunani,","poem":1},{"text":"kwie 'aixɨa mɨ'anene xemaka'etsa hetsiemieme,","poem":2},{"lineBreak":true},{"text":"kaxie 'aixɨa mutiukaxuxuawere hetsiemieme,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"kwie hetsiena neteɨterima memu'uwa hetsiemieme","poem":1},{"text":"xuya xuawekaku meta 'ɨtsi,","poem":2},{"text":"naitsarie kiita hakewa temawierika mexuawe","poem":1},{"text":"meta 'ikɨ kiekari temawierika mexeiya hetsiemieme.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Paratsiyu kaniku'eiriwamɨkɨ","poem":1},{"text":"meta kiekari teɨteri yuwaɨkawa memimatekai,","poem":2},{"text":"yuheyemekɨ terɨ xeikɨa kanakɨnikuni kiekari","poem":1},{"text":"'aixɨa mɨ'anene meta tuxiyute,","poem":2},{"text":"puxuri tiwa'iyari kanayeimɨkɨ,","poem":1},{"text":"'ɨxa mɨtineni muxatsi wahetsiemieme kanayeimɨkɨ,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"kepaukake taheima paitɨ","poem":1},{"text":"'Iyari temakanɨ'airiyarieni tahetsie mɨtinakenikɨ.","poem":2},{"text":"Hikɨ makumawetsie kwie 'aixɨa mɨ'ane mɨraka'etsitɨre kanayeimɨkɨ,","poem":1},{"text":"meta kwie 'aixɨa mɨ'ane mɨraka'etsitɨre 'uhukuyatɨ kanayeimɨkɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tita mɨtiheitserie makumawetsie kaniuyeikamɨkɨ,","poem":1},{"text":"meta kwie 'aixɨa mɨ'ane mɨraka'etsitɨretsie tita mɨtiheitserie mana kaniuyeikamɨkɨ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tita mɨtiheitserie kayuwatɨ mexeiyanikɨ mɨ'ayumieme kanayehɨamɨkɨ,","poem":1},{"text":"'aixɨa 'iyari temu'uwanikɨ 'ikwaxiyari kanayehɨamɨkɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Neteɨterima kayuwatɨ 'umakaku mekaniu'uwakuni,","poem":1},{"text":"kiite 'aixɨa 'anenemeta,","poem":2},{"lineBreak":true},{"text":"witsitiu'anekaku mepu'uxipieka.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tsepanetɨ tee waɨkawa huku mukatuaxixɨ","poem":1},{"text":"meta tsepa kiekari 'akuweritɨ mayeitɨarie,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"'aixɨa xeke'itɨarieka xeme,","poem":1},{"text":"xemuka'etsa haatetsita,","poem":2},{"lineBreak":true},{"text":"meta tuuru puxu hamatɨa xemɨwarutatuaya.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/31.json","previousChapterAudioLinks":{},"numberOfVerses":20}