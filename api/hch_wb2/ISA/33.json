{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":33,"content":[{"type":"heading","content":["Hiwerika meta parewiya"]},{"type":"verse","number":1,"content":[{"text":"Xɨa'ui 'ekɨ, pemɨtiyuka'uname, 'akuxi pemɨkaka'unariewe.","poem":1},{"text":"Xɨa'ui 'ekɨ, pemɨtiyukananaima, 'akuxi pemɨkananaimariewe.","poem":2},{"text":"Kepauka 'ari pemɨtiyuka'una, 'ekɨta pepɨka'unarieni,","poem":1},{"text":"kepauka pemɨtiyunanaimani, 'ekɨta pepɨnanaimarieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yawé, tame ketanenenimayaka,","poem":1},{"text":"'ahetsiemieme temɨta'ikwewakɨ.","poem":2},{"text":"Tsiepɨre ximeri tahetsie nunuwame kenehɨkɨtɨni,","poem":1},{"text":"meta tawikweitsitɨwame kepauka temu'uximatɨarie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Aniuki mutarɨrɨrɨka me'enietɨ, teɨteri mekanitakɨkani,","poem":1},{"text":"kepauka pemanukukiekatsie, nuiwarite kwiepa memɨtama mekanitananautsani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Xepiinite xepɨtenawaiyarietɨwe","poem":1},{"text":"wa'atɨ 'utsikari waxa mepɨtekwa'a mepɨteyurie,","poem":2},{"text":"wahetsɨa mepɨ'axe memɨwaraye'unie","poem":1},{"text":"'utsikari kwinie memɨyenexime wahepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"'Aixɨa pɨrahɨawarɨwa Yawé meutitewatsie muyeika","poem":1},{"text":"Tsiyunitsie 'aixɨa pɨtiyuriene kemɨtiheitserie.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mɨkɨ pɨhɨkɨtɨni 'aixɨa 'iyari pemuyeikanikɨ,","poem":1},{"text":"waɨkawa wikweitsitɨarika pɨmatsimini, meta pemɨtimaiwenikɨ meta pemɨtimaikakɨ,","poem":2},{"lineBreak":true},{"text":"xɨka Yawé pemakaka mɨkɨ waɨkawa mɨraye'axe pɨhɨkɨtɨni 'ahetsiemieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Xekeniwaruxeiya kememɨte'uhiwa kuyaxi memɨka'ukamama kaye 'utɨma,","poem":1},{"text":"nɨ'ariekate kayuwatɨ mumakakɨ memɨtekuxata meputitsuana kwi meyuhiwerietɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Huye yuxaɨtame puyehapane,","poem":1},{"text":"nixewitɨ huyeta pukaheyeika.","poem":2},{"text":"Tɨratu peutitsanariexɨa,","poem":1},{"text":"memunenierixɨ 'aixɨa 'iyari mepɨkaxeiyarie,","poem":2},{"lineBreak":true},{"text":"nixewitɨ 'aixɨa pɨkatixeiyarie.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwie kaniyuheiwerieka meta kaniuwakini,","poem":1},{"text":"Riwanu kaniyutewiyani meta kanitiyɨnareni,","poem":2},{"text":"mayeweri Tsaruni makumawetsie hepaɨ 'anetɨ kanayani,","poem":1},{"text":"Watsani meta Kaximeru kemɨtiutsiɨraɨyekai mɨpaɨri pɨkatiu'ane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yawé mɨpaɨ kanaineni:","poem":1},{"lineBreak":true},{"text":"«Hikɨ nekananukukemɨkɨ.","poem":1},{"text":"Hikɨ 'aixɨa nekatinitahɨawariemɨkɨ,","poem":2},{"lineBreak":true},{"text":"nehetsiemieme 'aixɨa katinitaniukiemɨkɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Xeme kuxarikɨ xepɨtihukata","poem":1},{"text":"meta xatsi xepɨtiniweni,","poem":2},{"text":"peru ne'iiya tai mɨhɨkɨ kanitixɨtsitɨamɨkɨ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Teɨteri naxi mekanayeitɨariekuni,","poem":1},{"text":"xuya mawitekietɨka hepaɨ mekatenitaiyariekuni».","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Xeme, 'ateewa xemu'uwa,","poem":1},{"text":"kenemɨtiuyuri xekeneu'enana,","poem":2},{"text":"meta xeme, hurawa xemutetɨka,","poem":1},{"text":"netɨrɨkariya xekenetimati.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Axateyuruwamete Tsiyuni hetsie mekanimamaka,","poem":1},{"text":"kwie mutayuane 'axateyuruwamete kaniwaranuku'axikeni:","poem":2},{"text":"«¿Kemɨ'ane tame pɨyɨwe","poem":1},{"text":"taipa mɨkiekametɨnikɨ mɨtiyɨxɨtsitɨwatsie?","poem":2},{"text":"¿Kemɨ'ane tame pɨyɨwe","poem":1},{"text":"yuheyemekɨ mukuma nerɨkwari tsata mukiekametɨnikɨ?»","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kemɨ'ane xeikɨa heitserie yamɨtikamie","poem":1},{"text":"meta heitseriekamekɨ mɨtikuxata,","poem":2},{"text":"'axa'anemekɨ tumini mɨkaha'i'iwa,","poem":1},{"text":"meta tumini mɨtanaki'erienikɨ 'aixɨa mɨtiuka'iyari mɨnanaimanikɨ yuhetsie mɨkapitɨa,","poem":2},{"text":"mɨkayuwaɨriya teyumemiwamete muwa'enienikɨ,","poem":1},{"text":"mayukɨpiriya 'axamɨti'ane mɨkatixeiyanikɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mɨkɨ meutitewatsie pɨkiekametɨni,","poem":1},{"text":"yu'awiwietame pexeiyani 'aitsie mɨtɨrɨkaɨyetsie,","poem":2},{"text":"paa pemikieka,","poem":1},{"text":"haa waɨkawa pexeiyani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"'Ahɨxite ti'aitame witsi'anemekɨ pɨxeiya,","poem":1},{"text":"meta kwie xekanixeiyakuni 'ayeukame.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"'Ataɨta mɨpaɨ pepɨti'erieni pematɨ, meta mɨpaɨ pepɨtayɨni:","poem":1},{"text":"«¿Hakewari peyeika wa'inɨnɨatame?","poem":2},{"text":"¿Hakewari peyeika tumini mɨtatsiwawiriekai?","poem":1},{"text":"¿Hakewari peyeika tuxiyutsie timieme mɨraka'utɨwa?»","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tawari mɨkɨ teɨteri memuyuti'ɨre pepɨkawaxeiya,","poem":1},{"text":"mɨkɨ teɨteri waniuki mɨkayu'eniɨriɨkɨ,","poem":2},{"lineBreak":true},{"text":"niuki kayumainɨakame memexeiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Tsiyuni keneuxeiya, ta'ixɨarari kiekariyari,","poem":1},{"text":"'ahɨxite Kerutsareme kanixeiyamɨkɨ,","poem":2},{"text":"kii 'aixɨa mɨrewe, 'ixuriki kiiyari 'aixɨa mɨrekuwe,","poem":1},{"text":"kɨyeyarite mukatsutsuni pɨkahatihunixɨani,","poem":2},{"lineBreak":true},{"text":"kaunariteya pɨkahatekixɨani.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mana Yawé matsiɨkɨme payeitɨani yutɨrɨkariya.","poem":1},{"text":"Haa 'a'atayeyeutɨ maxuawe payani meta 'etsihatayeyeutɨ manuyehapane.","poem":2},{"text":"Kanuwa 'etsimupe muwekiexime mana pɨka'uyeyani,","poem":1},{"text":"meta kanuwa 'amupapa mɨtɨrɨkawi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yawé mɨtatsi'uwitɨxime mɨhɨkɨkɨ,","poem":1},{"text":"Yawé manuyeka kanihɨkɨtɨni.","poem":2},{"text":"Yawé tati'aitɨwame mɨhɨkɨkɨ:","poem":1},{"text":"Mɨkɨ katanitawikweitsitɨamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"'Akaunarite kaniuweranaxɨani:","poem":1},{"text":"Patera manuwie pɨkakuhana","poem":2},{"lineBreak":true},{"text":"'ixuriki heitserie pɨka'anuyewɨ.","poem":2},{"text":"Waɨkawa piinitɨarika memɨte'a'iwaxɨ mekatenetapixɨakuni,","poem":1},{"text":"meta memɨka'ɨkɨniwawe 'ɨaritɨ mekateninawakuni.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nixewitɨ mɨpaɨ pɨkatayɨni: «Nepɨtikuye»,","poem":1},{"text":"mana kiekatari 'axakememɨte'uyurikɨ mepɨteheuyehɨwiyarieni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/32.json","previousChapterAudioLinks":{},"numberOfVerses":24}