{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":34,"content":[{"type":"heading","content":["Niuki nuiwarite wahetsiemieme"]},{"type":"verse","number":1,"content":[{"text":"Nuiwarite, 'ahurawa xekenewakɨni xemɨ'enananikɨ.","poem":1},{"text":"Teɨteri, kayuwatɨ xekeneu'enana.","poem":2},{"text":"Kwie ke'i'enieni, meta naitɨ mana mɨtixuawe,","poem":1},{"text":"kwiepa kemakuyewa, meta tita mɨtixuaweriya.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yawé kaniha'aka yunaime nuiwarite wahamatɨa,","poem":1},{"text":"meta yunaime kuyaxi wahamatɨa.","poem":2},{"text":"Mɨkɨ kaniwaruka'una yunaime","poem":1},{"text":"memɨkwi'iwakɨ kaniwayetuani.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wakaxarite kanexɨriyamɨkɨ,","poem":1},{"text":"wawaiyari 'ukuri'ɨatɨkaitɨ kanitipɨnimɨkɨ,","poem":2},{"lineBreak":true},{"text":"waxuriya hɨrite kanitixɨtɨaximeni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Xurawetsixi muyuawitsie memeukatei mekanitaxɨriexɨakuni,","poem":1},{"text":"meta muyuawi kaniyutakwikwiemɨkɨ xapa hepaɨ,","poem":2},{"text":"yunaitɨ xurawetsixi yuxawatɨriya meneuyehɨakuni,","poem":1},{"text":"kaxie xawari wakitɨ kemɨrakawiwike,","poem":2},{"lineBreak":true},{"text":"meta xapa takari wawakitɨ kemɨtikaxɨrɨwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ne'ixipara muyuawitsie kaniutitaweni,","poem":1},{"text":"'ari 'akanakamieni 'Erumi hetsie tiwakwinitɨanike,","poem":2},{"lineBreak":true},{"text":"mɨkɨ teɨteri 'ari yanepɨtiwarutahɨawixɨ nemɨwareuyehɨanikɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yawé 'ixiparaya kanixuriyamaka,","poem":1},{"text":"tsipuri meta muxatsi waxuriyakɨ,","poem":2},{"text":"kaniwiyamaka,","poem":1},{"text":"muxatsi 'ukitsi wamumé wiyayari xiteyarikɨ.","poem":2},{"text":"Yawé mawarika puwewie Wutsira paitɨ,","poem":1},{"text":"meta puwarukwi 'Erumi kwieyaritsie yumɨireme.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wahamatɨa mekanikwikuni tuurutsixi yeutari wahepaɨ memɨ'anene,","poem":1},{"text":"meta tsikerutsixi metatsiere tuurutsixi.","poem":2},{"text":"Wakwietsie xuriya kanitayeurimɨkɨ,","poem":1},{"text":"wiya tumuanaritsie kanakɨnɨmɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yawé mɨyɨkɨhɨanikɨ kanitukarieyatɨni,","poem":1},{"text":"mɨrayukatuani wiyari kanihɨkɨtɨni","poem":2},{"lineBreak":true},{"text":"Tsiyuni hetsie tanuanike.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Erumi 'akiyaritetsie kwetsɨka muwitsɨani hayari kaniuhapanekamɨkɨ,","poem":1},{"text":"kwauniyari hatsupure mɨta'a kanayeimɨkɨ","poem":2},{"lineBreak":true},{"text":"meta tiyutaiyatɨ kwetsɨka muwitsɨani kanayeimɨkɨ mɨkɨ kwieyari.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tukarikɨ meta tɨkarikɨ pɨkakutɨtɨtseni,","poem":1},{"text":"kɨtsi yapɨretineikani.","poem":2},{"text":"Yuheyemekɨ 'akumawetɨ payani waxiɨyari,","poem":1},{"text":"hatsuaku xewitɨ mana pɨka'uyeyani.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Piwame meta naika 'ɨtsita kiekatari mana mepɨkiekataritɨni","poem":1},{"text":"mana mikɨri meta kwatsa hamatɨa mepuyuti'ituatɨani.","poem":2},{"text":"Kakaɨyari 'Erumi kwieyaritsie pɨtitamɨiriya","poem":1},{"text":"ti'inɨnɨatamekɨ yuxamuriekame payeitɨwa","poem":2},{"lineBreak":true},{"text":"tepɨa mahete hirukɨ mɨwiwiekɨ pɨrakumaweriya.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Memanuyetei mana mepɨka'u'uwani","poem":1},{"text":"meta mana xewitɨ pɨkati'aitani,","poem":2},{"lineBreak":true},{"text":"yunaitɨ mana te'aitamete mekanikumawerikuni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Waparatsiyuta xuya pɨtinexɨani,","poem":1},{"text":"meta wakii 'aixɨa mɨ'aneneta 'ɨtsi pɨtinexɨani.","poem":2},{"text":"Yawixi memayu'eririya wakii payani","poem":1},{"text":"meta 'aruxi 'amemɨnene wa'itua.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Teyukwa'amete makumawetsie miemete mepuyutinɨni tsɨikɨri yeutari wahamatɨa,","poem":1},{"text":"tsipuri yeutari mepuyɨkɨhɨaweni hipame wahamatɨa,","poem":2},{"text":"metatsiere mana mepɨkiekataritɨni memawɨwawe tɨkarikɨ miemete","poem":1},{"text":"mekanikaxeiyakuni yu'uxipiweme.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mana mikɨri puyuta'ituatɨani pɨtitixɨrieni,","poem":1},{"text":"yu'anatetɨa yupixɨxɨitsi puwata'ɨwiya.","poem":2},{"text":"Manatatsiere mepuyukuxeɨrieni wirɨkɨxi,","poem":1},{"text":"meyu'iwamatɨkaitɨ.","poem":2}]},{"type":"verse","number":16,"content":["Yawé xapaya xekenakaxeiya, hikɨ xekenakaterɨwa:",{"text":"Nixewitɨ 'ikɨ yeutanaka pɨkaheuyeweka,","poem":1},{"text":"yunaitɨ yu'iwama mepɨwareuxeiyani.","poem":2},{"text":"Yawé mɨpaɨ katiniu'aita,","poem":1},{"text":"meta 'Iyarieya kaniwakuxeɨrimɨkɨ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mɨkɨ kaniwaranuyexeirieni hakewa memeyuhayewa,","poem":1},{"text":"yumamakɨ kaniwaru'itɨirieni wakwie.","poem":2},{"text":"Mɨkɨ mana yukie mekanayeitɨakuni yuheyemekɨ,","poem":1},{"text":"mana mekaniyuhayewakuni waxiɨyarima yuheyemekɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/33.json","previousChapterAudioLinks":{},"numberOfVerses":17}