{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":35,"content":[{"type":"heading","content":["Memutawikwetsitɨarie watemawierika"]},{"type":"verse","number":1,"content":[{"text":"Makumawe puyukatemawieni meta 'ɨtsi mɨtiwawaki,","poem":1},{"text":"makumawe puyutemawieka","poem":2},{"lineBreak":true},{"text":"meta tuturi hepaɨ pɨtaxutuni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pɨkaxutuni puyutemawieka:","poem":1},{"text":"putahiwani temawierikakɨ.","poem":2},{"text":"Riwanu tsimɨtiyuxexeiya mɨpaɨ pɨtipitɨarieni,","poem":1},{"text":"meta Kaximeru metatsiere Tsaruni 'aixɨa kememɨte'utixuawitɨwakai.","poem":2},{"text":"Mɨkɨ Yawé mariweme mepɨxeiya,","poem":1},{"text":"Kakaɨyari witsi'anetɨ kemɨtimariwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Xekenetseiriyani mamate mɨwerarani,","poem":1},{"text":"tuunute xekenetseiriyani muyɨyɨakatɨka,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"mɨpaɨ xeketeniwarutahɨawi yu'iyaritsie memɨmama:","poem":1},{"text":"«Xekenetɨrɨkawini, xepɨkamamaka","poem":2},{"text":"Xekakaɨyari kaninuamɨkɨ,","poem":1},{"text":"punuani mɨtiwarakapitɨanikɨ,","poem":2},{"text":"tiwapitɨanike kahekɨakamekɨ","poem":1},{"text":"kanixetawikweitsitɨamɨkɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Hikɨ 'ana memɨkaheuneniere wahɨxite heunenieretɨ kanayeimɨkɨ,","poem":1},{"text":"meta memɨkaheu'enana meheu'enanatɨ mekanakɨnikuni,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"mɨka'uyeiwe kanititsunamɨkɨ maxa hepaɨ,","poem":1},{"text":"meta mɨkaniuwe temawierikakɨ kanitahiwamɨkɨ.","poem":2},{"text":"Makumawetsietsɨ haa kanitinexɨamɨkɨ,","poem":1},{"text":"waɨkawa haa kanetinexɨamɨkɨ makuwakitsie.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Xiekari mɨxɨka haa kwekwewiwame kanayeimɨkɨ,","poem":1},{"text":"kwie waɨkawa meuharimɨkɨ hetsiena haixa kanetinexɨamɨkɨ meta hapurarai.","poem":2},{"text":"Hakewa yawixi memayu'eririya memetikukutsukai","poem":1},{"text":"mana haka kɨyexi hatamete kanitinexɨamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mana huye puyehaneni","poem":1},{"text":"“Huye mɨpatsie” katiniterɨwariemɨkɨ.","poem":2},{"text":"Mɨkɨ 'utɨma memɨka'itiyatɨka mepɨka'uyekɨne,","poem":1},{"text":"meta memɨka'u'iyari mana memuyekɨne mepɨkayɨwaweni,","poem":2},{"lineBreak":true},{"text":"huye memuweiya wahetsiemieme xeikɨa kanayeimɨkɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mana maye pɨka'uyeikani,","poem":1},{"text":"meta tiyukwa'ame mɨkɨ 'utɨma pɨkayemie,","poem":2},{"text":"Mɨkɨ 'utɨma nitixaɨtɨ pɨkatitaxeiyarieni.","poem":1},{"text":"Mana mekaniuyekɨnikuni xeikɨa memutawikweitsitɨarie.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yawé hetsɨa mekani'axɨakuni memutawikweitsitɨarie,","poem":1},{"text":"Tsiyuni mekaneutahaxɨakuni temawierika kwikariyari mekwikatɨ,","poem":2},{"lineBreak":true},{"text":"yuheyeme temawierikakɨ mekurunatɨarietɨkaitɨ.","poem":2},{"text":"Temawierika pɨta kaniwaranuku'aximɨkɨ,","poem":1},{"text":"nutuixiya meta hiwerika kaniyemieni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}