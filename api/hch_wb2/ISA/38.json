{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":38,"content":[{"type":"heading","content":["'Etsekiyaxi kwiniyaya"]},{"type":"verse","number":1,"content":["Mɨkɨ tukaritsie 'Etsekiyaxi katiniutakwine waɨkawamekɨ, 'ari kanimɨximekaitɨni. Hikɨ Kakaɨyari niukameya Kitsariyaxi 'Amuxi nu'aya kaneikuxeiya, mɨpaɨ katineitahɨawe: «Yawé mɨpaɨ kanaineni: “'Akie 'aixɨa ketineukuyuri, 'ari pekanimɨmɨkɨ, 'aixɨa pepɨkatika'erieniri”»."]},{"type":"verse","number":2,"content":["'Etsekiyaxi 'ixumeritsie heunieritaka Yawé mɨpaɨ katiniutawawirieni:"]},{"type":"verse","number":3,"content":["«Yawé, kena'eriwani ne 'ahɨxie 'aixɨa nepɨtikatɨa meta ne'iyarikɨ 'aixɨa netinekɨhɨawetɨ, kemɨmatinake yanepɨtiuyuri». Hikɨ 'Etsekiyaxi karima kaniutatsuani."]},{"type":"verse","number":4,"content":["Hikɨ Yawé niukieya Kitsariyaxi hetsie kaninuani mɨpaɨ katinitahɨawe:"]},{"type":"verse","number":5,"content":["«'Etsekiyaxi hetsɨa kenemie mɨpaɨ ketinetahɨawi Yawé mɨpaɨ kanaineni, 'atutsi Rawiri Kakaɨyarieya: “Nekani'enieni 'anenewieri meta 'a'ukai nekaniuxeiya, tawarita 'akuxi tamamata heimana 'auxɨwi wiyari nekamanipitɨaka pemuyeikanikɨ."]},{"type":"verse","number":6,"content":["'Ekɨ meta 'ikɨ kiekari nepɨxetawikweitsitɨani ti'aitame 'Atsiriya kiekame mɨkaxeka'unanikɨ. Ne 'ikɨ kiekaritsie nekanitanuamɨkɨ."]},{"type":"verse","number":7,"content":["'Ikɨ kani'inɨaritɨni nemɨmatsiyetuirieni kenemɨmarahɨawe:"]},{"type":"verse","number":8,"content":["Yanepɨtiyurieni 'Akatsi 'inɨarieyatsie tau 'etɨriyaya tamamata 'inɨariyari pɨkayani yu'utɨma”». Hikɨ mɨpaɨ katiniɨyɨni tamamata 'inɨariyari kanikayani tau 'etɨrieya."]},{"type":"heading","content":["'Etsekiyaxi kemɨraka'utɨa"]},{"type":"verse","number":9,"content":["'Arike 'Etsekiyaxi Kura kwieyaritsie ti'aitame tikuyetɨ 'aixɨa tiuka'erieka mɨpaɨ katinaka'utɨani:"]},{"type":"verse","number":10,"content":[{"text":"«Ne mɨpaɨ neputainekai:","poem":1},{"text":"“'Ari kauka mɨki teukiyata nenikayune,","poem":2},{"lineBreak":true},{"text":"kaukari tukari nekahexeiyatɨ nenayani”.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne mɨpaɨ neputainekai: “Tawariri Yawé nepɨkaxeiya","poem":1},{"text":"memayeneniere memanu'uwatsie,","poem":2},{"text":"tawariri teɨteri nepɨkawaxeiya,","poem":1},{"text":"'ena kwiepa memɨte'u'uwa”.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nekii nekaniuka'uniyarieni, nekaniunawaiyarieni,","poem":1},{"text":"muxatsi wahɨweme 'ixuriki xamaruya hepaɨ.","poem":2},{"text":"'Itsame hepaɨ, netukari nekatiniutakwikwieni,","poem":1},{"text":"maye'itse mɨkɨ kananuyeteke.","poem":2},{"lineBreak":true},{"text":"Yapauka xeitɨkariyaritsie kaneniukumaweriya.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Netinewietɨ nepikwewi kepaukake tau 'ɨrɨya manatine,","poem":1},{"text":"mɨkɨ peru, maye hepaɨ naime ne'umeyarite putimuraxɨ.","poem":2},{"lineBreak":true},{"text":"Yapauka xeitɨkariyaritsie kaneniukumaweriya.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wiki 'itsitame kuyeikame hepaɨ nekatiniutsuani, meta waurai hepaɨ,","poem":1},{"text":"kukuru hepaɨ neputainekai.","poem":2},{"text":"Muyuawitsie nieriyakɨ nehɨxite puti'uxixɨa.","poem":1},{"text":"Nepu'uximatɨarie, Yawé.","poem":2},{"lineBreak":true},{"text":"Kwerietɨ keneneuparewi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"»Neuxei ¿kenehaineni?","poem":1},{"text":"Mɨkɨ mɨpaɨ kanetiniutaxatɨani, meta mɨpaɨ katiniuyurieni.","poem":2},{"text":"Ne'iyaritsie kukuiniyakɨ","poem":1},{"text":"nepɨkakutsu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yawé, teɨteri 'aniukitsie xeikɨa mepɨtewiya,","poem":1},{"text":"yaxeikɨata ne'iyari mana 'aixɨa ti'aneme pɨtiukaxexeiya.","poem":2},{"text":"'Ekɨ 'aixɨa pepɨnetiuka'eritɨa","poem":1},{"text":"tukari pepɨnetsi'upitɨa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mɨpaɨ nepɨtimate, 'aixɨa mɨti'anenikɨ","poem":1},{"text":"'uximatɨarikatsata nepuyetɨa.","poem":2},{"text":"Penetsinaki'erietɨ pepɨkanetsi'upitɨa","poem":1},{"text":"mɨki teukiyata nemɨkayunekɨ,","poem":2},{"lineBreak":true},{"text":"'axakenemɨtiuyuri pepuwarixiwiyaxɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mɨki teukiya 'aixɨa pɨkamarahɨawe,","poem":1},{"text":"mɨki pɨkamatsinɨawa.","poem":2},{"text":"Mɨki teukiyata memeukakɨka","poem":1},{"text":"tixaɨtɨ mepɨkatetakwewie wahetsie kepemɨtiwiyanikɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kemɨ'ane memu'uwa, peru kemɨ'ane xeikɨa memu'uwa,","poem":1},{"text":"mɨkɨ mepɨhɨkɨ memɨmatsinɨawa,","poem":2},{"lineBreak":true},{"text":"hikɨ ne kenemɨmatinɨawa.","poem":2},{"text":"Wapaapama yunaitɨ yuniwema mekateniwataxatɨakuni","poem":1},{"text":"wahetsie kepemɨtiwiyanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"»Yawé pɨnetsitawikweitsitɨani,","poem":1},{"text":"Yawé tukita","poem":2},{"text":"teye'uwatɨ kanaritekɨ tepinɨawani","poem":1},{"text":"naimekɨ ketemɨteheutere».","poem":2}]},{"type":"verse","number":21,"content":["Kitsariyaxi mɨpaɨ painekai: «xapa 'ikwaxiyari witsɨanime xekenekawewi, haiyayatsie xekeneuwiri, mɨkɨkɨ 'aixɨa katinika'erimɨkɨ»."]},{"type":"verse","number":22,"content":["'Etsekiyaxi meta mɨpaɨ katiniuta'iwaukaitɨni: «¿Ke'aneme 'inɨari nepɨyetuiriyarieni Yawé tukita nemanutiyanikɨ?»"]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}