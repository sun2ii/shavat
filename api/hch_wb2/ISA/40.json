{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":40,"content":[{"type":"heading","content":["Nɨtɨarika Kakaɨyari teɨterimama wahetsiemieme"]},{"type":"verse","number":1,"content":[{"text":"Xekenewanɨtɨaka, neteɨterima xekenewanɨtɨaka","poem":1},{"text":"—wakakaɨyari mɨpaɨ kanaineni—.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kerutsareme witsixeketenekɨhɨaweni,","poem":1},{"text":"mɨpaɨ xeketeneutahɨawi","poem":2},{"text":"'ari mekatenaye'atɨani mete'uximayatɨ,","poem":1},{"text":"'axamɨtiuyurikɨ 'ari katiniuyutuani,","poem":2},{"text":"'ari Yawé kaniwaru'uximatɨani","poem":1},{"text":"'axakememɨte'uyurikɨ matsi waɨkawa hepaɨna paɨmemekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Xewitɨ kanahiwani:","poem":1},{"lineBreak":true},{"text":"«Makumawetsie huye xekeneukuha'aritɨa","poem":1},{"text":"Yawé hetsiemieme,","poem":2},{"text":"mu'ayepariyatsie kwie xekeneutihɨniya","poem":1},{"text":"huye 'aixɨa xekeneuyuri takakaɨyari hetsiemieme.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mayeweweritsie kwie ke'utihɨne,","poem":1},{"text":"meta hɨri matitei 'akuweritɨ pɨta kehayani,","poem":2},{"text":"'aki manuyeheitɨkatsie ke'akuparekure","poem":1},{"text":"meta 'aki 'amɨpapa manuyeheitɨkatsie.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hikɨ Yawé yuxawatɨriya kanihekɨatamɨkɨ,","poem":1},{"text":"yunaitɨ kwiepa memɨtama mekanixeiyakuni.","poem":2},"Yawé yɨkɨmana mɨpaɨ kaniutayɨni»."]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Niuki mɨpaɨ kanaineni: «Keneutahiwani».","poem":1},{"text":"Neta mɨpaɨ neraine: «Kehepaɨ netiuhiwani kuta».","poem":2},{"lineBreak":true},{"text":"«Yunaitɨ teɨteri tupiriya hepaɨ mepɨ'anene,","poem":1},{"text":"meta witsikememɨ'anene tuturi yeuta mieme hepaɨ kani'aneni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tupiriya kaniutawaukeni, tuturi kaniutayɨnareni,","poem":1},{"text":"Yawé 'iiyaya wahetsie mɨye'axekɨ.","poem":2},{"lineBreak":true},{"text":"Yurikɨ, teɨteri tupiriya mekanihɨkɨtɨni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tupiriya kanitiwaukeni meta tuturi kanitiyɨnareni,","poem":1},{"text":"matsi takakaɨyari niukieya","poem":2},{"lineBreak":true},{"text":"yuheyemekɨ kanayeniereni».","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tsiyuni, niuki 'aixɨa manɨyɨne xaxatame,","poem":1},{"text":"hɨri 'a'utewime hetsie keneutiye'a.","poem":2},{"text":"Kerutsareme, niuki 'aixɨa manɨyɨne tuayame,","poem":1},{"text":"karima keneutahiwa.","poem":2},{"text":"Keneutahiwa, pepɨkamaka,","poem":1},{"text":"kiekarite Kura kwieyaritsie mukumane mɨpaɨ ketiniwarutahɨawi:","poem":2},{"lineBreak":true},{"text":"«'Ena puyeika xekakaɨyari».","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Neuxei, Yawé naimekɨmɨyɨwe kaniye'aka waɨkawa tɨrɨkaɨyetɨ,","poem":1},{"text":"yutɨrɨkariyakɨ katini'aitani.","poem":2},{"text":"Teɨterimama mekaniweiyani,","poem":1},{"text":"tita mɨra'iwaxɨ hamatɨana kaniumieni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Muxatsi wahɨweme yumuxatsima kemɨtiwa'ɨwiya hepaɨ,","poem":1},{"text":"muxatsi tɨɨrixi kaniwaratɨkɨni,","poem":2},{"text":"yutawie kaniwarutiyatsani,","poem":1},{"text":"meta memɨhehekwa niwetɨka wakweriwayurietɨ kaniwaruwitɨximeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"¿Kemɨ'ane haramara pu'inɨatawe yumama meuwewerikɨ,","poem":1},{"text":"meta kemɨ'ane yu'itɨwametekɨ muyuawi naime pu'inɨatawe?","poem":2},{"text":"¿Kemɨ'ane kwie tumuanariyari kiriwata pu'inɨataxɨ?","poem":1},{"text":"¿Kemɨ'ane hɨri panuyewi ti'inɨnɨatametsie?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"¿Kemɨ'ane Yawé 'iyarieya ketewamɨ'axe pi'inɨataxɨ,","poem":1},{"text":"yatɨni kemɨ'ane 'i'ɨxatsitɨwameya payeiwe?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"¿Yawé kemɨ'ane hetsɨa pɨye'a ta'iwaunike yamɨtiyurienikɨ,","poem":1},{"text":"kemɨ'ane huye mɨheitserie pixeitsitɨa?","poem":2},{"text":"¿Kemɨ'ane mɨtimaiwenikɨ pipitɨa","poem":1},{"text":"yatɨni kemɨ'ane mɨtimaiwenikɨ huyeyari pixeitsitɨa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kakaɨyari hɨxie,","poem":1},{"text":"haa tsuniyari wariteta meukatsuke hepaɨ nuiwarite mepɨ'anene,","poem":2},{"lineBreak":true},{"text":"ti'inɨnɨatame mɨranuyewɨwɨtɨwatsie tumuanari 'etsipetɨ matikani hepaɨ.","poem":2},{"text":"Yawé kwie haa hixɨapa mɨyetei ti'inɨnɨatemetsie kananuyewɨwɨtɨwani","poem":1},{"text":"kwie kwi mɨmiyuanini mɨhɨkɨtɨni hepaɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Riwanu kɨyexiyarikɨ xɨka hatinaini mawari taiyame heuyewetɨ 'akuxi payani,","poem":1},{"text":"meta tewamamakɨ mawari taiyariyari xɨka 'uwewieni mepeuyeweka 'akuxi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yunaitɨ nuiwarite hɨxiena tixaɨtɨ mepɨkatehɨkɨ,","poem":1},{"text":"mepɨkate'aye'atɨka hetsiena mieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"¿Kemɨ'ane Kakaɨyari hepaɨ 'aneme mepayeitɨani?","poem":1},{"text":"¿Kehepaɨ mete'iwewieni?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tiwewiwame kakaɨyaritɨme kanitawewimɨkɨ,","poem":1},{"text":"hurukɨ tiwewiwame huru pikawiriwa","poem":2},{"lineBreak":true},{"text":"meta pɨrata kukayari pitiwewiriwa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kemɨ'ane tixɨatɨ mɨkarexeiya mawari mɨyetuanikɨ","poem":1},{"text":"kɨye kaniutiwawani mɨkapɨniwe,","poem":2},{"text":"meta kwinimieme mɨreutawewiwe kaniutiwawani","poem":1},{"text":"kɨye kakaɨyariyari mɨtawewienikɨ ka'atiwautseme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"¿Kamɨtsɨ xeme mɨpaɨ xekatemaikai?","poem":1},{"text":"¿Mɨpaɨ xekatehetimaiwawekai?","poem":2},{"text":"¿Mɨpaɨ xakate'utahɨawarie matɨari paitɨ?","poem":1},{"text":"¿Mɨpaɨ xekatehetima kwie muyukamatsie paitɨ?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mɨkɨ katini'aitani muyuawi taheima muyema hetsie,","poem":1},{"text":"mana teɨteri memu'uwa 'utsikari wahepaɨ mekateniyuxexeiyani.","poem":2},{"text":"Mɨkɨ muyuawi kaniutawerani 'ixuriki xamaruyari hepaɨ,","poem":1},{"text":"meta 'aixɨa katinikuwerani muwa mayekanikɨ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mɨkɨ memɨtɨrɨkawi kaniwarexɨrɨwani,","poem":1},{"text":"meta 'ena kwiepa memɨte'aita tixaɨtɨ pɨkatiwarayeitɨwa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yu'aweri 'iteɨriyarikɨ mekaniukayatsarieni,","poem":1},{"text":"hikɨke mekaniuka'etsieni,","poem":2},{"lineBreak":true},{"text":"kwiepa wananayari katiniwiyaxɨaximenike,","poem":2},{"text":"kepauka wahepa mɨreutahɨtsiwatsie mɨkɨ mekanitiwaukeni,","poem":1},{"text":"hikɨ 'eka mɨtɨrɨkaɨye xatsi hepaɨ kaniware'enitsitɨwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"«¿Kamɨtsɨ kemɨ'ane hepaɨ kename ne'ane xepɨtiyuani?","poem":1},{"text":"¿Kemɨ'ane nehepaɨ pɨ'ane?», mɨpaɨ kanaineni Mɨpatsie.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Teikɨ xekenenenieri, muyuawi xekeneutixeiya:","poem":1},{"text":"¿Kemɨ'ane mɨkɨ naime pɨtiutawewi?","poem":2},{"text":"Kemɨ'ane xurawetsixi memuyumɨire 'aixɨa mɨtiwakuyayatsa yuxexeime,","poem":1},{"text":"meta mɨwakɨhɨawe waterɨwatɨ yuxexuime.","poem":2},{"text":"Kanimariweni tɨrɨkariyaya, kanitɨrɨkaɨyeni tɨrɨkariyaya,","poem":1},{"text":"tixaɨtɨ wapaitɨ pɨkareuyewetse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"¿Titayari Kakuwu petiniukixie?","poem":1},{"text":"¿Titayari 'Ixaheri peha'atɨ mɨyapetiutaine:","poem":2},{"text":"«Yawé nehuye pɨkaxeiya,","poem":1},{"text":"nekakaɨyari heitserie kenemɨrexeiya pɨka'imate»?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"¿Kamɨtsɨ pekatimate?","poem":1},{"text":"¿Kamɨtsɨ mɨpaɨ pekaretimaiwe?","poem":2},{"text":"Yawé yuheyeme Kakaɨyari kanihɨkɨtɨni,","poem":1},{"text":"naime kwie manu'atɨka mutawewi.","poem":2},{"text":"Mɨkɨ pɨka'uxiwe meta pɨkawaɨripiwe,","poem":1},{"text":"meta kemɨtiuyemate yemekɨ pɨkayumainɨa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Mɨkɨ kemɨ'ane mu'uxe tɨrɨkaɨyeme payeitɨwa,","poem":1},{"text":"meta kemɨ'ane memɨwerarani puwatɨrɨkariyatɨa.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Temari 'akuxi meputi'uxike, meputiwaɨripiwe,","poem":1},{"text":"tɨɨri mehetixɨtemɨriketɨ mepekaxɨrɨwe,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"peru Yawé hetsie kemɨ'ane memɨtewiya","poem":1},{"text":"tɨrɨkariya hekwamekɨ mepukaxexeiya,","poem":2},{"text":"kwixɨri wahepaɨ mepɨtiwɨxɨani:","poem":1},{"text":"mepɨtinautsa mepɨkatiwaɨripieni,","poem":2},{"lineBreak":true},{"text":"mepuhuni mepɨkati'uxe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}