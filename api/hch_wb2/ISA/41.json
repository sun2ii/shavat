{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":41,"content":[{"type":"heading","content":["'Ixaheri kemɨtiuparewiya"]},{"type":"verse","number":1,"content":[{"text":"«'Ateewa haramara tetsita xemɨtitei, nehɨxie kayuwatɨ xekeneumaka.","poem":1},{"text":"Nuiwarite, yutɨrɨkariya xekenehekwariyani.","poem":2},{"text":"'Ahurawa xekenakɨneka xeketenekuxatani,","poem":1},{"text":"tepɨtaxeɨrieka nemɨxetaxanetakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"»¿Kemɨ'ane pita'ini 'iya yuheyemekɨ yamɨrayu'iwa","poem":1},{"text":"tau manatineika kiekame?","poem":2},{"text":"Mɨkɨ yumamatsie nuiwarite kaniwakuhɨweni,","poem":1},{"text":"mɨkɨ hɨxie te'aitamete mekaniyuyetuayani.","poem":2},{"text":"Yu'ixiparakɨ tumuanari kaniwarayeitɨwani,","poem":1},{"text":"yutupikɨ kaniwata'enitsitɨwani xatsi memɨhɨkɨtɨni hepaɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hikɨ 'aixɨa 'iyari kaniwaranukuweweiyani","poem":1},{"text":"mɨkɨ huye 'utɨa hatsuaku mɨka'uyetɨatsie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"¿Kemɨ'ane 'ikɨ pɨtiuyuri? ¿Kemɨ'ane yamɨtiyɨnikɨ yapainekai?","poem":1},{"text":"¿Kemɨ'ane nuiwarite puwarutahɨawixɨ tsutɨa paitɨ?","poem":2},{"text":"Ne, Yawé, mexɨakame nekanihɨkɨtɨni,","poem":1},{"text":"meta mɨkɨtsiere nekanihɨkɨtɨkamɨkɨ 'imatɨrieka tukaritsie».","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Haramara tetsita kiekatari mekanixeiya, mekanimamaka meta","poem":1},{"text":"kwie manuye'atɨkatsie kaniwatayuaneni.","poem":2},{"text":"'Ari 'ahurawa mekanahuni, 'umekanahuniri.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"'Iwamarixi yunaitɨ mekaniyuparewieka,","poem":1},{"text":"yu'iwamatɨ mɨpaɨ mekateniyutahɨaweni: «Kenetɨrɨkaɨyeni».","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mɨreutawewiwe yuwaɨriyame kanayeitɨaka hurukɨ tiwewiwame,","poem":1},{"text":"meta titsunamekɨ mɨtitiweririta","poem":2},{"text":"mɨpaɨ tepɨa hetsie tiwerime mɨrayeitɨwa pɨrahɨawe:","poem":1},{"text":"«'Aixɨa pɨ'ane tepɨa mɨtiwiyatsitɨwani»,","poem":2},{"text":"hikɨ kakaɨyari wewiyakame pukɨrapuxima","poem":1},{"text":"mɨkawatayuanenikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Peru 'ekɨ, 'Ixaheri, neti'uximayatsiriwame,","poem":1},{"text":"'ekɨ Kakuwu, nemɨmatsi'anayexei,","poem":2},{"lineBreak":true},{"text":"'Apɨrahami nehamiku nuiwarieya.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwie manu'axetsie paitɨ nepɨmatsiyewitɨ,","poem":1},{"text":"kwie manuye'atɨkatsie paitɨ nepɨmatsi'utahɨawixɨ,","poem":2},{"text":"mɨpaɨ nekametiniutahɨawe: “'Ekɨ neti'uximayatsiriwame pekanihɨkɨtɨni”.","poem":1},{"text":"Ne nepɨmatsi'anayexei, nepɨkamatsi'utixani'eri.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Ayumieme pepɨkamaka, netsɨ 'ahamatɨa nekaniuyeikani,","poem":1},{"text":"pepɨka'a'uximatɨaka, ne nepɨ'akakaɨyari.","poem":2},{"text":"Nepɨmatsitɨrɨkariyani meta nepɨmatsiparewieka,","poem":1},{"text":"ne nepɨmatsituikani nemamakɨ 'aixɨa mɨtiyuriekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"»Yunaitɨ kemɨ'ane memuyeha'awe 'ahepaɨtsita","poem":1},{"text":"yurikɨ mekanitewiyatsitɨariekuni nitixaɨtɨ mepɨkate'akɨne,","poem":2},{"text":"kemɨ'ane memɨmetsi'aye'unie mepukumawere,","poem":1},{"text":"wa'atɨtɨ mepɨkate'u'uwakai.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tsepa pemɨwarutiwau memɨmetsi'aye'unie,","poem":1},{"text":"pepɨkawataxeiya.","poem":2},{"text":"Kemɨ'ane memɨmatsimietɨwe nitixaɨtɨ mepɨkatehakɨne,","poem":1},{"text":"wa'atɨtɨ mepɨkate'u'uwakai.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Netsɨ Yawé nekanihɨkɨtɨni, 'Akakaɨyari,","poem":1},{"text":"'amamá 'atserie mieme mutuika,","poem":2},{"text":"Ne nekanihɨkɨtɨni mɨpaɨ nemɨmerahɨawe:","poem":1},{"text":"“Pepɨkamaka, ne nepɨmatsiparewieni”.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kakuwu kwitsi, pepɨkamaka, 'Ixaheri 'etsipemɨpe","poem":1},{"text":"―Yawé mɨpaɨ kanaineni―,","poem":2},{"text":"yaxeikɨa netsiere nekamaniparewimɨkɨ,","poem":1},{"text":"Mɨpatsie 'Ixaheri hetsiemieme matsiwikwetsitɨwame kanihɨkɨtɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"»'Ekɨ tipɨname nekamanayeitɨamɨkɨ","poem":1},{"text":"pehekwame meta pe'atamɨariekame, hutakɨa peheutixikakaunime.","poem":2},{"text":"Hɨri pepɨtipɨna, tumuanari pekaneyeitɨamɨkɨ,","poem":1},{"text":"hɨri 'amanutitɨtɨ mɨaxa pepayeitɨani.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Pekaniwarexɨrimɨkɨ, meta 'eka kanenu'enitsitɨamɨkɨ,","poem":1},{"text":"'eka mɨtɨrɨkaɨye kaniwataxɨriexɨamɨkɨ.","poem":2},{"text":"Peru 'ekɨ Yawé hetsie petiwiyatɨ pekaniyutemawiekamɨkɨ,","poem":1},{"text":"'Ixaheri hetsie Mɨpatsie kɨmana pekani'ata'ɨrimɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"»Tixaɨtɨ memɨkatehexeiya meta memɨteheuyehɨwa haa mekanikuwautɨweni,","poem":1},{"text":"matsi mepɨka'itaxeiyawawe,","poem":2},{"lineBreak":true},{"text":"harimɨyakɨ waneni pɨwawaki.","poem":2},{"text":"Peru ne, Yawé, nepɨwata'eiya,","poem":1},{"text":"ne, 'Ixaheri Kakaɨyarieya, nepɨkawaku'eirieni.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Haa nepanetɨaxɨani hɨrite muwawakitsie,","poem":1},{"text":"meta mayeweweritsie haixa nepetinetɨaxɨani.","poem":2},{"text":"Makumawetsie haa xuaweme nepayeitɨani,","poem":1},{"text":"meta makuwakitsie haixa xuaweme nepayeitɨani.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Makumawetsie nekatinikayatsamɨkɨ,","poem":1},{"text":"kariuxa, meki, tsikwai kɨyeyari meta huriwu.","poem":2},{"text":"Kwie muwakitsie huku mɨxexeurawi nekanikayatsamɨkɨ,","poem":1},{"text":"huku yunɨkame metatsiere kwetsi kɨyeyari,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"teɨteri memɨnenierekɨ meta mɨpaɨ memɨtemaikakɨ,","poem":1},{"text":"meta kwi memɨyɨ'ɨwiyakɨ meta mɨpaɨ memɨtehetimamatenikɨ,","poem":2},{"text":"Yawé tɨrɨkariyaya mɨyamɨtiuyurikɨ,","poem":1},{"text":"'Ixaheri Kakaɨyarieya mɨpatsie mɨtiutawewikɨ.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Yawé mɨpaɨ kanaineni:","poem":1},{"lineBreak":true},{"text":"«Yuhetsie xekeneutanua,","poem":1},{"text":"xeketeneuhekɨata naime kexemɨteheima —Kakuwu ti'aitɨwameya mɨpaɨ kanaineni—.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hurawa xekenakɨni meta xeketenekuxatani","poem":1},{"text":"kemɨtiyɨni,","poem":2},{"lineBreak":true},{"text":"meta kemɨtiɨyɨ meripaitɨ,","poem":2},{"text":"mɨpaɨ temɨtemaikakɨ","poem":1},{"text":"kehepaɨ mɨtiyeyɨximekai.","poem":2},{"lineBreak":true},{"text":"Xeketateneutaxatɨa kemɨtiyɨni 'uxa'awarie.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yaxekeneutiyua 'uxawarietɨni kemɨtiyɨni,","poem":1},{"text":"'ana mɨpaɨ tepɨtehetimani kename xeme xekakaɨyarixi.","poem":2},{"text":"Yɨkɨ xeketeneuyuri, 'aixɨa ti'aneme yatɨni 'axati'aneme,","poem":1},{"text":"temɨnenierekɨ meta temɨtimamanikɨ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yurikɨ xeme nitixaɨtɨ xepɨkatehɨkɨ,","poem":1},{"text":"metatsiere tixaɨtɨ yɨkɨ xemɨte'uyurieni xepɨkayɨwawe.","poem":2},{"lineBreak":true},{"text":"Kanixani'eriwani xeikɨa kemɨ'ane mɨxe'anayexei.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"»Tayeta xeime nekaniuta'inieni,","poem":1},{"text":"hikɨ kaninuani ne'itahɨaweku,","poem":2},{"lineBreak":true},{"text":"tau manatineikatsie kanenahɨaweni.","poem":2},{"text":"'Iwewame hepaɨ yɨ'ɨkakɨ haxu katiniɨpɨnani,","poem":1},{"text":"te'aitamete haxu hepaɨ katiniwarupɨnani.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"¿Kemɨ'ane yaputayɨ meripaitɨ,","poem":1},{"text":"yatemɨtemaikakɨ?","poem":2},{"text":"¿Kemɨ'ane meri yaputayɨ,","poem":1},{"text":"mɨpaɨ temɨtiyuanikɨ: “Yurikɨ painekai”?","poem":2},{"text":"Nixewitɨ yapɨka'utayɨ,","poem":1},{"text":"nixewitɨ pɨka'u'enierie niuki kuxatatɨ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ne mexɨakame nekanayani Tsiyuni mɨpaɨ nemɨtiutahɨawixɨ:","poem":1},{"text":"“Neuxei, mekaniu'axɨaniri”.","poem":2},{"text":"Ne Kerutsaremetsie nemeiyenɨ'a nekanihɨkɨtɨni","poem":1},{"text":"tupiri niuki 'aixɨa 'anuyɨneme mukuxata.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Nekananuyeneniereni watsata, nixewitɨtɨma pumawe,","poem":1},{"text":"mana watsata 'ɨxatsitawetɨ,","poem":2},{"lineBreak":true},{"text":"nixewitɨ pɨkanetsiku'eiya nemɨwaku'iwawiyatsie.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Mɨkɨ yunaitɨ te'itawamete mepɨhɨkɨ.","poem":1},{"text":"Kememɨteyurie tixaɨtɨ pɨkatihɨkɨ,","poem":2},{"lineBreak":true},{"text":"wakakaɨyarixi 'eka xeikɨa mepɨhɨkɨ, teyu'uximatɨwamete.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":29}