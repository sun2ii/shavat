{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":42,"content":[{"type":"heading","content":["Yawé ti'uximayatsiriwame"]},{"type":"verse","number":1,"content":[{"text":"»'Ikɨ neti'uximayatsiriwame kanihɨkɨtɨni, nemiparewie,","poem":1},{"text":"nemenayexei, hetsiena mieme nemɨnetemawie,","poem":2},{"text":"ne'iyari hetsiena nekaniupitɨani,","poem":1},{"text":"kemɨtiheitserie nuiwarite watsata yakatiniyurimɨkɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pɨkatahiwa, pɨka'enierieni 'utahiwatɨ,","poem":1},{"text":"kaye 'utɨma pɨkatahiwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Haka mutapɨnarie pɨka'anumura,","poem":1},{"text":"kɨxeme witayari tsepa mɨkwauniya pɨka'ikutɨtsani.","poem":2},{"text":"Kemɨtiheitserie yuheyemekɨ yapɨtiyurieni,","poem":1}]},{"type":"verse","number":4,"content":[{"text":"pɨkatirukuniuni meta pɨkatiwaɨripieni","poem":2},{"text":"kepaukake kemɨtiheitserie mitatse'iriya.","poem":1},{"text":"'Ateewa haramara tetsita kiekatari 'inɨari niukiyarieya mepɨtakwewie».","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kakaɨyari mɨpaɨ kanaineni, Yawé,","poem":1},{"text":"kemɨ'ane muyuawi mutawewi meta mitaweraxɨ,","poem":2},{"text":"kemɨ'ane kwie mukama,","poem":1},{"text":"meta tita mana mɨtixuawe,","poem":2},{"text":"mana kiekatari teɨteri wa'iiya muwapitɨa,","poem":1},{"text":"tukari muwapitɨa mana memu'uwa:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"«Ne, Yawé, heitseriemekɨ nepɨmatsi'anayexei,","poem":1},{"text":"'amamatsie nepɨkawierixɨ.","poem":2},{"text":"Ne nepɨmatsi'utawewi,","poem":1},{"text":"ne tɨratu nepɨmatsi'ayeitɨa teɨteri wahetsiemieme,","poem":2},{"lineBreak":true},{"text":"hekɨariya pemɨhɨkɨtɨnikɨ nuiwarite wahetsiemieme,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"memɨkaheuneniere pemɨwaranutanieritɨanikɨ,","poem":1},{"text":"pɨretsutsixi pemɨwarayehapanikɨ,","poem":2},{"lineBreak":true},{"text":"meta kemɨ'ane yɨriya tsata memu'uwa pemɨwarayehapanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"»Ne Yawé nekanihɨkɨtɨni, mɨpaɨ nekatinitewaka.","poem":1},{"text":"Hipame kenemɨtimariwe nepɨkawapitɨa,","poem":2},{"lineBreak":true},{"text":"meta nenɨawari kakaɨyarixi nepɨkawapitɨa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Meripaitɨtimieme pɨraye'atɨarieri,","poem":1},{"text":"hikɨta hekwame nepɨtikuxata,","poem":2},{"lineBreak":true},{"text":"mɨpaɨ katiyɨwekaku 'akuxi nepɨtikuxata».","poem":2}]},{"type":"heading","content":["Kwikari nɨawari Yawé hetsiemieme"]},{"type":"verse","number":10,"content":[{"text":"Yawé hetsiemieme xeime kwikari hekwame xekeneutakwika,","poem":1},{"text":"xeme, haramaratsie xematineika,","poem":2},{"lineBreak":true},{"text":"meta yunaitɨ mana xemɨye'uwa,","poem":2},{"text":"xekeneutikwikani kwie manu'axe xemɨtitei,","poem":1},{"text":"xeme, 'ateewa haramara tetsita xemɨtitei.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Xeme makumawetsie meta kiekarite mana mukumane xekeneutihiwani,","poem":1},{"text":"meta kiekarite hakewa Tseraxi meyeika.","poem":2},{"text":"Tsera kiekatari temawierikakɨ meke'utikwikani,","poem":1},{"text":"meta meke'utihiwani hɨri 'amanutitɨtɨtsie paitɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yawé mariwemekɨ xekenekuxatani","poem":1},{"text":"kwikarieya xekeneutikwikani 'ateewa paitɨ haramara tetsita.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yawé kanayeyeimɨkɨ kuya yumemiwame hepaɨ,","poem":1},{"text":"tewi yumemiwame hepaɨ 'ɨtetsatɨ.","poem":2},{"text":"Hiwaritsata kaniyutamiemɨkɨ,","poem":1},{"text":"memeye'unie kaniwara'iwamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Mɨixa tukari kayuwatɨ neputamarixɨ,","poem":1},{"text":"nepɨka'utaniuka meta nepɨtinewie.","poem":2},{"text":"Peru hikɨ nepɨtahiwa niweyame hepaɨ,","poem":1},{"text":"nekanitatsuamɨkɨ ne'uta'aiwatɨ kukuiniyakɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hɨrite yemurite nekaniti'unamɨkɨ,","poem":1},{"text":"naime mana mɨtixuawe nekatinitiwatsiɨxamɨkɨ,","poem":2},{"text":"haa manuyehapane nekanikawatsiɨxamɨkɨ,","poem":1},{"text":"meta haa muyemanetsie,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"memɨkaheuneniere nekaniwaranuwitɨmɨkɨ huyeta memɨkahemaririetsie,","poem":1},{"text":"huyeta nepɨwaranuwitɨni xewitɨ mɨkahemarietsie,","poem":2},{"text":"wahetsiemieme yɨriya hekɨariya nepayeitɨani,","poem":1},{"text":"nepakuweririta mɨkahakuweweritsie.","poem":2},{"text":"Mɨpaɨ nekatiniyurimɨkɨ,","poem":1},{"text":"meta nepɨkawaku'eirieni.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Peru kakaɨyarixi wahetsie memɨtewiya mepeuyexɨrieni meta tewiyarika mehexeiyatɨ mepakɨne,","poem":1},{"lineBreak":true},{"text":"kemɨ'ane wewiyakate mɨpaɨ memɨtewakɨhɨawe:","poem":1},{"text":"“Xeme takakaɨyarixi xekanihɨkɨtɨni”.","poem":2}]},{"type":"heading","content":["'Ixaheri mɨkaheuniere meta mɨkaheu'ena"]},{"type":"verse","number":18,"content":[{"text":"»Xemɨkaheu'enana, xekeneu'enana.","poem":1},{"text":"Xemɨkaheuneniere, xekeneɨyɨ'ɨwiya.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"¿Kemɨ'ane matsi waɨkawa pɨkaheuniere keyuri neti'uximayatsiriwame,","poem":1},{"text":"meta kemɨ'ane matsi waɨkawa pɨkaheu'ena keyuri neniuki tuayame?","poem":2},{"text":"¿Kemɨ'ane matsi waɨkawa pɨkaheuniere keyuri nenɨ'ari,","poem":1},{"text":"meta kemɨ'ane matsi waɨkawa pɨkaheuniere keyuri Yawé ti'uximayatsiriwame?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"'Ekɨ pepɨtiuxei waɨkawa,","poem":1},{"text":"peru 'atsipepɨkaretimaiwe,","poem":2},{"text":"pepɨwatixaxawa 'anakata,","poem":1},{"text":"peru nitixaɨtɨ pepɨkati'enie».","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yawé puyukatemawi,","poem":1},{"text":"kemɨtiheitserie tinaki'erietɨ,","poem":2},{"lineBreak":true},{"text":"'aitsikaya mɨmariwenikɨ witsi'anetɨ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Peru 'ikɨ teɨteri mepɨte'unawatsiyarie meta mepɨte'unawaiyarie yupiinite,","poem":1},{"text":"yunaitɨ terɨta meputiwiyarie","poem":2},{"lineBreak":true},{"text":"yatɨni mepanutaxɨriya xaɨtsie paitɨ.","poem":2},{"text":"Mepɨte'unawatsiyarie,","poem":1},{"text":"nixewitɨ wahetsie pɨkanua,","poem":2},{"text":"mepɨte'unawaiyarie yupiinite,","poem":1},{"text":"nixewitɨ wahetsiemieme pɨkahaniuka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"¿Kemɨ'ane xeme 'ikɨ pɨti'enieni,","poem":1},{"text":"'arikeketa kemɨ'ane 'ikɨ pɨtitaxata?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"¿Kemɨ'ane Kakuwu pɨyetua mɨtinawaiyarienikɨ yupiinite","poem":1},{"text":"yatɨni kemɨ'ane 'Ixaheri pɨyetua mɨtinawatsiyarienikɨ?","poem":2},{"text":"Yawé kanihɨkɨtɨni kemɨ'ane","poem":1},{"text":"hetsiena mieme teɨterimama 'axamemɨte'uyuri.","poem":2},{"text":"Huyeya mepɨka'anukuwei","poem":1},{"text":"meta 'aitsikaya mepɨka'anu'eni.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"'Ayumieme Yawé hetsiena","poem":1},{"text":"yuhaxɨa pukawiwi, haxɨa kuyaxa mieme pipitɨa.","poem":2},{"text":"Taikɨ penukana, peru 'atsipɨkaretima,","poem":1},{"text":"pitaxɨtsitɨa, matsi mɨkɨ yakɨ yɨaneme puta'eri.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/41.json","previousChapterAudioLinks":{},"numberOfVerses":25}