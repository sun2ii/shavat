{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":43,"content":[{"type":"heading","content":["Tiyuwikweitsitɨwame muyuxewi 'Ixaheri hetsiemieme"]},{"type":"verse","number":1,"content":[{"text":"Peru hikɨ Yawé mɨpaɨ kanaineni,","poem":1},{"text":"Kakuwu, mɨmatsi'unetɨa,","poem":2},{"lineBreak":true},{"text":"'Ixaheri, mɨmatsi'uta'iwewaxɨ:","poem":2},{"text":"«Pepɨkamaka, ne nekameniutawikweitsitɨani,","poem":1},{"text":"ne nekamenahɨaweni kepemɨtitewakɨ, 'ekɨ nehetsɨa mieme pekanihɨkɨtɨni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kepauka hapa pemuyani,","poem":1},{"text":"ne 'ahamatɨa nekaniumiemɨkɨ,","poem":2},{"text":"kepauka hatuxametsie pemanuyani,","poem":1},{"text":"haa 'aheima pɨka'uyeuriweni,","poem":2},{"text":"kepauka taipa pemumieni,","poem":1},{"text":"pepɨkakwaxe pepɨkatatani,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne Yawé nekanihɨkɨtɨni, 'akakaɨyari,","poem":1},{"text":"Mɨpatsie 'Ixaheri hetsiemieme, matsiwikweitsitɨwame,","poem":2},{"text":"ne 'Ekipitu nekaniyetuani nemɨtinetuanikɨ 'ahetsiemieme nemɨmatsitawikweitsitɨanikɨ,","poem":1},{"text":"Kutsi meta Tsewa mame.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Ekɨ 'ahetsiemiemekɨ teɨteri nekaniwayetuamɨkɨ,","poem":1},{"text":"'atukari hetsiemieme hipame kiekari nekaniwayetuamɨkɨ.","poem":2},{"text":"Ne nemɨmatsinaki'eriekɨ, witsinemɨmatixeiyakɨ meta","poem":1},{"text":"'ekɨ waukawa pepɨraye'axe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Pepɨkamaka, ne 'ahamatɨa nekaniuyeikani,","poem":1},{"text":"tau manatineika hepa meme'uwa 'anuiwarima nekaniwa'atɨamɨkɨ,","poem":2},{"lineBreak":true},{"text":"meta tau makayuyuipike hepa meme'uwa nepɨwa'atɨani nemɨxekuxeɨrienikɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tayeta mieme mɨpaɨ nekatinitahɨawimɨkɨ: “Keniwayetua”","poem":1},{"text":"meta tatsutɨa mieme mɨpaɨ nekatinitahɨawimɨkɨ: “Pepɨkawarukununuitɨwani”.","poem":2},{"text":"Xekeniwa'atɨa neniwema 'ateewa paitɨ memu'uwa","poem":1},{"text":"meta neniwema 'ukari kwie manu'axe memu'uwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yunaime xekeniwa'atɨa kemɨ'ane nehetsiemieme mematerɨwarɨwa,","poem":1},{"text":"kemɨ'ane mɨnetsinɨawanikɨ nemitawewi,","poem":2},{"lineBreak":true},{"text":"kemɨ'ane nemitawewi meta nemita'iwewaxɨ”».","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kiekari mɨkaheuniere xekenayeweiya, tsepa netɨ mɨrekahɨxi,","poem":1},{"text":"kiekari mɨkaheu'ena, tsepa netɨ nakate mexeiya.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Meke'uyukuxeɨrieni yunaitɨ nuiwarite","poem":1},{"text":"meta kiekarite mekeyukuxexeuriwani.","poem":2},{"text":"¿Kemɨ'ane mɨkɨ watsata xewitɨ 'ikɨ niuki putaxataxɨ","poem":1},{"text":"meta kemɨ'ane pɨtatiutaxatɨa meripaitɨ kemɨtiɨyɨ?","poem":2},{"text":"Memunenierixɨ mekewaruxeɨrieni","poem":1},{"text":"mɨmatsiɨkɨrekɨ kename yuri me'utiyuane,","poem":2},{"text":"hipatɨta memɨ'enananikɨ mɨpaɨ memɨtiyuanikɨ:","poem":1},{"text":"«Puyuri».","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yawé mɨpaɨ kanaineni:","poem":1},{"lineBreak":true},{"text":"«Xeme nehetsɨa miemete xekanihɨkɨtɨni xemunenierixɨ,","poem":1},{"text":"nete'uximayatsiriwamete nemɨxe'anayexei,","poem":2},{"text":"xemɨnetsimatenikɨ meta nehetsie yuri xemɨte'eriekakɨ,","poem":1},{"text":"meta mɨpaɨ xemɨtemaikakɨ kename Ne nehɨkɨ.","poem":2},{"text":"Meripaitɨ ne 'akuxi neka'uyeikakaku xewitɨ kakaɨyaritɨtɨ 'apɨka'uyeikakai,","poem":1},{"text":"meta ne'utɨma xewitɨ pɨkatineni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne, Yawé nekanihɨkɨtɨni,","poem":1},{"text":"tawarita xewitɨ tiyuwikweitsitɨwame kaniumaweni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne nekatiniutaxata, nekanixe'utawikweitsitɨani meta neniuki nekaniutaxata.","poem":1},{"text":"Ne nekatiniuyurieni xetsata, hawaikɨ xewitɨ kakaɨyaritɨtɨ mɨpaɨ pɨkatiuyuri».","poem":2},{"text":"Yawé mɨpaɨ kanaineni:","poem":1},{"lineBreak":true},{"text":"«Xeme xemunenierixɨ xekanihɨkɨtɨni,","poem":1},{"text":"neta Kakaɨyari nekanihɨkɨtɨni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Meripaitɨtɨ, Ne nekanihɨkɨtɨni.","poem":1},{"text":"Nixewitɨ nemamatsie muyuxɨna pɨkayɨwe.","poem":2},{"lineBreak":true},{"text":"Kenemɨtiyurieni, nixewitɨ pɨka'itatara».","poem":2}]},{"type":"heading","content":["Kakaɨyari kemɨtiyukanenimaya 'Ixaheri ke'axamɨtiuka'iyari"]},{"type":"verse","number":14,"content":[{"text":"Yawé mɨpaɨ kanaineni,","poem":1},{"text":"xewikweitsitɨwame, Mɨpatsie 'Ixaheri hetsiemieme:","poem":2},{"text":"«Xehetsiemieme teɨteri Wawiruniya nepɨwaranɨnɨ'ani,","poem":1},{"text":"yunaime nepɨwataxɨriexɨani yu'unamete nepuwarayeitɨani.","poem":2},{"text":"Kanuwa 'amupapa hetsie kɨmana memɨyuti'ɨrekaitsie,","poem":1},{"text":"karireutsixi nepɨwara'iwa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ne Yawé nekanihɨkɨtɨni, mɨpatsie,","poem":1},{"text":"tixe'aitɨwame, 'Ixaheri nuiwariyari nemukama».","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Yawé mɨpaɨ kanaineni,","poem":1},{"text":"kemɨ'ane haramaratsie huye mutawewi,","poem":2},{"lineBreak":true},{"text":"'anuyeyɨkɨme mayeitɨa haramara 'uyuanekaku,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"kemɨ'ane kaxetate kuyaxamieme mɨwarayewitɨ meta kawayutsixi,","poem":1},{"text":"kuyaxi meta kuyaxa wewiwamete,","poem":2},{"text":"mɨkɨ 'amemukuhi tawarita memɨka'anuku'unikɨ,","poem":1},{"text":"kɨxeme witayari hepaɨ kaniɨtɨni:","poem":2}]},{"type":"verse","number":18,"content":[{"text":"«Xeketenatɨmaiya meripaitɨ timieme,","poem":1},{"text":"meripaitɨ hepaɨ xepɨkate'u'uwani.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hekwame nekatininetɨamɨkɨ.","poem":1},{"text":"'Ari yakatiniyɨaneni, ¿Kari xepɨkatemate?","poem":2},{"text":"Makumawetsie huye nekaniwewieneni,","poem":1},{"text":"meta nitixaɨtɨ mɨkaranuyeikatsie haixa nekaniwewieneni.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yeuta memɨte'u'uwa mekanenayexeiyani,","poem":1},{"text":"yawixi memayu'eririya meta 'aruxi 'amemɨnene,","poem":2},{"text":"haa makumawetsie nepanenetɨwa,","poem":1},{"text":"meta nitixaɨtɨ mɨkaranuyeika hatuxame nekananuyetu'ani,","poem":2},{"text":"neteɨterima nemɨwaranayexei nemɨwatiharitɨanikɨ,","poem":1}]},{"type":"verse","number":21,"content":[{"text":"neteɨterima nehetsiemieme nemuwarutawewi,","poem":2},{"lineBreak":true},{"text":"memɨnetsinɨawanikɨ naitsarie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"»Peru 'ekɨ Kakuwu, pepɨkanetsihahɨawe,","poem":1},{"text":"'ekɨ 'Ixaheri, peputi'uxixɨ nehetsiemieme.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Muxa pepɨkanetsi'atɨiriewe 'amawari taiyariyari,","poem":1},{"text":"nehetsiemieme yapepɨkatikamie 'amawarikɨ.","poem":2},{"text":"Peru nepɨkamatsi'uximatɨa hatsi mawariyari pemɨwewienikɨ,","poem":1},{"text":"meta 'ɨkwa witsimu'ɨa pemɨtaiyakɨ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Pepɨkanetsinanairiewe 'uwá witsimu'ɨa,","poem":1},{"text":"meta 'amawarite wiyayarikɨ pepɨkanetsihuxaitɨa.","poem":2},{"text":"Matsi, 'ekɨpɨta 'axapepɨneranutahɨawe 'axakepemɨtiuyurikɨ","poem":1},{"text":"meta pepɨnetsiwaɨripitɨa 'axapetiyurienetɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"»Ne matsi nekɨmana nemɨnenaki'eriekɨ","poem":1},{"text":"'aitsikaya pemutitsanaxɨkɨ nekananuyeitɨani,","poem":2},{"lineBreak":true},{"text":"meta tawariri 'axakepemɨtiuyurikɨ nepɨkaha'eriwa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kenenaye'eritɨa kuta. Tepuyutaxaneta,","poem":1},{"text":"yakeneutayɨki xɨka yakɨ xeikɨa petiukwinitɨarieni.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"'Axiɨyari mexɨakame 'axakatiniuyurieni,","poem":1},{"text":"'aniukamete menetsi'aye'unietɨ mekanakɨne.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"'Ayumieme tukita memɨte'uximayakai nitixaɨtɨ nepɨkatiwarayeitɨa,","poem":1},{"text":"Kakuwu nepɨyetua mɨka'unarienikɨ naitɨ,","poem":2},{"lineBreak":true},{"text":"'Ixaheri nepɨyetua mɨtixani'eriwakɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/42.json","previousChapterAudioLinks":{},"numberOfVerses":28}