{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":44,"content":[{"type":"heading","content":["'Ixaheri manayexeiyarie"]},{"type":"verse","number":1,"content":[{"text":"»Peru hikɨ, Kakuwu, neti'uximayatsiriwame,","poem":1},{"text":"'Ixaheri, nemɨmatsi'anayexei, keneu'ena.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yawé mɨpaɨ kanaineni, kemɨ'ane mɨmatsi'unetɨa,","poem":1},{"text":"kemɨ'ane 'amaama hetsie mɨmatsikaye,","poem":2},{"lineBreak":true},{"text":"mɨkɨ pɨmatsiparewimɨkɨ:","poem":2},{"text":"“Kakuwu pepɨkamaka, neti'uximayatsiriwame,","poem":1},{"text":"Ketsuruni, nemenayexei,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"kwie meuharimɨkɨ hakɨ nekanakuhatuiyamɨkɨ,","poem":1},{"text":"kwie mɨwaki, haixa 'akiyari nekaniuyetuaxɨamɨkɨ,","poem":2},{"text":"ne'iyari 'anuiwarima nekaniwapitɨamɨkɨ,","poem":1},{"text":"meta 'aixɨa nekaniwayurimɨkɨ kemɨ'ane memɨtiyɨrarɨme 'anuiwarima,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mayeweritsie tupiriya kemɨranukɨyɨyɨra mɨpaɨ mepɨtetayɨra,","poem":1},{"text":"hapuri 'aki'utɨma mɨnewe hepaɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xewitɨ mɨpaɨ pɨtayɨni: ‘Yawé hetsɨa nepɨmieme’,","poem":1},{"text":"xewitɨta Kakuwu nuiwarieya payuyeitɨwani,","poem":2},{"text":"xewitɨta yumamatsie mɨpaɨ pɨre'utɨaka: ‘Ne Yawé hetsɨa nepɨmieme’,","poem":1},{"text":"meta 'Ixaheri pɨtiyuterɨwani”.","poem":2}]},{"type":"heading","content":["Yawé meta kakaɨyarixi memɨwewiyatɨka"]},{"type":"verse","number":6,"content":[{"text":"»Yawé mɨpaɨ kanaineni, Yawé Naimekɨmɨtɨrɨkaɨye,","poem":1},{"text":"'Ixaheri ti'aitameya meta 'iwikweitsitɨwame:","poem":2},{"text":"“Ne mexɨakame nekanihɨkɨtɨni meta 'imatɨreme netɨhɨkɨ,","poem":1},{"text":"tawarita xewitɨ kakaɨyaritɨtɨ kaniumaweni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"¿Kemɨ'ane nehapaɨ pɨ'ane?","poem":1},{"text":"Yake'utayɨni.","poem":2},{"text":"Yake'utayɨni kemɨratiyɨxime","poem":1},{"text":"kepauka nekiekari meripaitɨtɨ nemukamatsie,","poem":2},{"text":"yake'utayɨni kemɨtiyɨni 'arike,","poem":1},{"text":"kehepaɨ mɨtiyɨni ketikuxatani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Xepɨka'uyɨyɨakatɨkani nixepɨkamamaka.","poem":1},{"text":"¿Xekateha'eriwa nemitahekɨataxɨ meripaitɨ?","poem":2},{"text":"Xeme xemunenierixɨ xekanihɨkɨtɨni.","poem":1},{"text":"¿Tawarita xewitɨ Kakaɨyari tiuyeika?","poem":2},{"text":"Hawaikɨ, tawarita xewitɨ 'Ai pumawe,","poem":1},{"text":"ne xeime tawarita nepɨkamate”».","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kakaɨyarixi memɨwatiwewiwa tixaɨtɨ mepɨkatehɨkɨ,","poem":1},{"text":"wawewiya kwinimieme mɨraye'axe yakɨxeikɨa pɨtihɨkɨ.","poem":2},{"text":"Yutewinɨarika puyuriene,","poem":1},{"text":"kemɨ'ane memixeiya mepɨkatemate mepɨkaneniere.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"¿Kemɨ'ane kakaɨyaritɨme puwewie yatɨni tepɨakɨ pitakwaxiya","poem":1},{"text":"nitixaɨtɨ katiyunaki'eriekame hetsiena mieme?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kemɨ'ane memeyexeiya mɨkɨ mekaniyutewiyatsitɨakuni,","poem":1},{"text":"tewewiwamete teɨteri xeikɨa mepɨhɨkɨ.","poem":2},{"text":"Yunaitɨ mɨkɨ nehetsɨa mekeye'axɨani,","poem":1},{"text":"memamatɨ meta meyutetewiyatɨ yunaitɨ mɨkɨ mekaniyuhayewakuni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tepɨakɨ ti'uximayatame tepɨa kaniutikwekweweni,","poem":1},{"text":"kɨmana tɨɨpa katini'uximayaka,","poem":2},{"text":"titsunamekɨ kakaɨyaritɨme kaniutawewiwani,","poem":1},{"text":"kemɨreutɨrɨkaɨye katiniuta'uximayatani.","poem":2},{"text":"Heuhaakamɨtɨ, 'uxetɨ,","poem":1},{"text":"kaharetɨ, meta 'ari 'anutarɨwewetɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kɨyekɨ ti'uximayatame katiniuti'inɨnɨatani ti'inɨnɨatamekɨ,","poem":1},{"text":"katiniuta'utɨwani kɨyetsie,","poem":2},{"text":"tepɨa 'i'inemekɨ katiniuta'uximayatani,","poem":1},{"text":"meta xikɨraɨyeme kaniutawewiwani.","poem":2},{"text":"Tewi hepaɨ 'aneme kaniutawewiwani,","poem":1},{"text":"tewi mu'uya kaniuta'ɨkeni,","poem":2},{"lineBreak":true},{"text":"tukita mayewenikɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kariuxa mekanawitekeni,","poem":1},{"text":"huku mɨxexeurawi meta tuaxa mekaniutayayatsani,","poem":2},{"text":"mana mekanikuhayeikawani mɨtiwawerekɨ,","poem":1},{"text":"yatɨni huku mekaniukayayatsani wiyeri mitiweriyakɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tewi tikwaxiyamekɨ kaneiyehɨaka,","poem":1},{"text":"yapaɨmemekɨta kaniutikɨxeweni,","poem":2},{"lineBreak":true},{"text":"'atinaime papa kaniuta'ɨariyani.","poem":2},{"text":"Metatsiere kɨmana kakaɨyaritɨme kaniutawewiwani hɨxiena kaniukatunumakekani,","poem":1},{"text":"kakaɨyaritɨme tawewieme hɨxiena kanakatutsitani.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hixɨapa 'akame kɨyexi kanititaiyani,","poem":1},{"text":"mɨkɨkɨ yu'ikwai kaniukawewiwani,","poem":2},{"lineBreak":true},{"text":"mana wai kaniutawarɨkani, mɨkɨkɨ kaniutahuxarɨwani.","poem":2},{"text":"Metatsiere kaniutikɨxeweni, mɨpaɨ 'utaitɨ:","poem":1},{"text":"«'Ari nepɨtaxɨrirɨmeri,","poem":2},{"lineBreak":true},{"text":"tai ne'anutaxeiyatɨ».","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Peru yapaɨmetɨ mɨyuhayewaxɨkɨ, yukakaɨyaritɨme kaniutawewiwani,","poem":1},{"text":"hɨxiena kaniukatunumakekani.","poem":2},{"text":"Waɨkawa 'iwawirietɨ mɨpaɨ tikɨhɨawetɨ:","poem":1},{"text":"«Keneneutawikweitsitɨa, 'ekɨtsɨ nekakaɨyari pekanihɨkɨtɨni».","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"'Atsimepɨkatemate, tixaɨtɨ 'atsimepɨkatehetimaitɨkɨka,","poem":1},{"text":"wahɨxite peukutsiku, mepɨkaneniere,","poem":2},{"lineBreak":true},{"text":"mepɨkatemaiwawe, mepɨkaheiti'enietɨkɨka.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Memɨtemaika meta memɨtemaiwaweni pɨwareuyehɨwa,","poem":1},{"text":"mepɨkayu'iyaritɨa meta mɨpaɨ mɨtayɨni mepɨkayɨwawe:","poem":2},{"text":"«Kɨye hixɨapa 'akamekɨ nepatinai,","poem":1},{"text":"papa nekaniuta'ɨariya tɨɨtsie,","poem":2},{"lineBreak":true},{"text":"wai ne'utawarɨkaka nepitakwai.","poem":2},{"text":"¿Kamɨtsɨ netiyɨwe tixaɨtɨ tixani'eriwame nemayeitɨani kɨyexi mana mɨtihekɨ?","poem":1},{"text":"¿Kɨye yatewime hɨxie netititunumakeni?»","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Naxikɨ mepɨtekwa'a,","poem":1},{"text":"xe'iyari kemɨtiyɨkɨhɨawe xepiweiya pɨtixe'itaiya,","poem":2},{"text":"yɨkɨmana xemuyutawikweitsitɨani xepɨkayɨwawe, meta mɨpaɨ xemutiyuani:","poem":1},{"text":"«'Ikɨ nemɨrexeiya katini'itarikatɨni».","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«Kakuwu kena'eriwani 'ikɨ,","poem":1},{"text":"'ekɨ neti'uximayatsiriwame pekanihɨkɨtɨni, 'Ixaheri.","poem":2},{"text":"Ne nekameniunetɨani, 'ekɨ neti'uximayatsiriwame pekanihɨkɨtɨni,","poem":1},{"text":"'Ixaheri, ne nepɨkametsihatɨmaiya.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"'Aitsika pemutitsanaxɨakɨ neputayeitɨa haiwitɨri ximeri mieme hepaɨ,","poem":1},{"text":"metatsiere ke'axapemɨtiuyuri nepekuyeitɨa haɨtsi hepaɨ.","poem":2},{"lineBreak":true},{"text":"Nehetsɨa kenenua, nekameniutawikweitsitɨani».","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Muyuawi taheima mieme temawierikakɨ xekeneutikwikani,","poem":1},{"text":"Yawé 'ikɨ katiniuyurieni.","poem":2},{"text":"Karima xekeneutihiwani,","poem":1},{"text":"meukatewatsie kwieta.","poem":2},{"text":"Hɨrite xekenekwikani,","poem":1},{"text":"meta muhukuya, naitɨ yukɨyeximatɨ.","poem":2},{"text":"Karikɨ Yawé Kakuwu kaniutawikweitsitɨani,","poem":1},{"text":"Kakaɨyari kemɨtimariwe 'Ixaheri kaniuhekɨatsitɨiya.","poem":2}]},{"type":"heading","content":["Kerutsareme tawari kiepa kemɨratɨa"]},{"type":"verse","number":24,"content":[{"text":"«Yawé mɨpaɨ kanaineni, Metsiwikweitsitɨwame,","poem":1},{"text":"kemɨ'ane 'amaamatsie mɨmetsikaye:","poem":2},{"lineBreak":true},{"text":"»“Ne Yawé nekanihɨkɨtɨni,","poem":1},{"text":"naime mɨtiutiwewi,","poem":2},{"text":"ne nexaɨta muyuawi 'anekaniuyemani","poem":1},{"text":"meta kwie 'anekanikumani.","poem":2},{"lineBreak":true},{"text":"¿Kemɨ'ane 'ana nehamatɨa puyeikakai?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"»”Kakaɨyari niukametemama memɨte'itawa wa'inɨari yanepɨkaraye'atɨwa,","poem":1},{"text":"meta memɨtehetimamateke nepuwatewiyatsitɨa,","poem":2},{"text":"memɨtemaiwawe mekatemaiwaweme nepɨwarayeitɨwa","poem":1},{"text":"meta kememɨtemaiwawekɨ tixaɨtɨ katiyunaki'eriekame nepayeitɨwa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nete'uximayatsiriwamete waniuki nepaye'atɨwa","poem":1},{"text":"meta netupiritsixi waniuki nepaye'atɨwa.","poem":2},{"text":"Ne mɨpaɨ nekanaineni Kerutsareme tawarita kiepa kanayeimɨkɨ,","poem":1},{"text":"kiekarite Kura kwieyaritsie miemete kananukakitsiemɨkɨ,","poem":2},{"lineBreak":true},{"text":"mu'u'uni 'aixɨa kaniti'itɨariemɨkɨ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ne mɨpaɨ nekanaineni haramara mɨmariwe ke'akawani,","poem":1},{"text":"meta haa mana meukayuyune ke'ukawaxɨani.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ne mɨpaɨ nekanaineni Tsiru nemuxatsi wahɨweme kanihɨkɨtɨni,","poem":1},{"text":"kemɨnetinake mɨkɨ yapɨtikayani,","poem":2},{"text":"yapɨtitanaki'erieni Kerutsareme manukakitɨarienikɨ,","poem":1},{"text":"meta tuki tenariyari manukuwewiyanikɨ”».","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/43.json","previousChapterAudioLinks":{},"numberOfVerses":28}