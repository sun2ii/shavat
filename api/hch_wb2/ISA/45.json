{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":45,"content":[{"type":"verse","number":1,"content":[{"text":"Yawé mɨpaɨ Tsiru katinahɨaweni, menayexei,","poem":1},{"text":"kemɨ'ane mamaya tserietanatsie mɨtiwierixɨ","poem":2},{"text":"nuiwarite mɨtiwata'aitɨanikɨ,","poem":1},{"text":"meta te'aitamete watepɨate mɨwanawairienikɨ,","poem":2},{"text":"memanutakɨnetsie kiteniete mɨreuyepiexɨanikɨ,","poem":1},{"text":"meta kiteniete reuyepietɨkaime mɨhayewaxɨanikɨ:","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«'Ahɨxie nepumieni,","poem":1},{"text":"hɨri meutiteitsie nepɨrakuweririta,","poem":2},{"text":"wurunitse 'itupariyarite nepɨtitara,","poem":1},{"text":"meta tepɨa meuku'uwetɨka nepanuxitexɨani.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yɨwita timieme mɨraye'axe nepɨmatipitɨani,","poem":1},{"text":"meta piinitɨarika 'awie mɨti'utsie,","poem":2},{"text":"ne Yawé nemɨhɨkɨ mɨpaɨ pemɨtimaikakɨ,","poem":1},{"text":"'Ixaheri Kakaɨyarieya, kepemɨtitewakɨ mɨmatsihaterɨwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kakuwu neti'uximayatsiriwame hetsiemieme,","poem":1},{"text":"'Ixaheri nemenayexei,","poem":2},{"text":"nepɨmetsihahɨawe kepemɨtitewakɨ,","poem":1},{"text":"meta 'aixɨa pemɨtixeiyariekakɨ mɨpaɨ nepumatiuterɨwaxɨ,","poem":2},{"lineBreak":true},{"text":"tsepa 'ekɨ pemɨkanetsimate.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne Yawé nekanihɨkɨtɨni, tawarita xewitɨ pumawe,","poem":1},{"text":"tawari xewitɨ Kakaɨyaritɨtɨ pumawe.","poem":2},{"text":"Tsepa 'ekɨ pemɨkanetsimate,","poem":1},{"text":"ne nepɨmatsitɨrɨkariyani,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"mɨpaɨ xemɨtemaikakɨ tau manatineika hepatsie meta makayuyuipiketsie","poem":1},{"text":"tawarita xewitɨ Kakaɨyari kaniumaweni.","poem":2},{"lineBreak":true},{"text":"Ne Yawé nekanihɨkɨtɨni, tawarita xewitɨ kaniumaweni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne hekɨariya nekaniunenetɨwani meta yɨriya,","poem":1},{"text":"'aixɨa mɨti'ane nekatini'atɨwani meta 'uximatɨarika,","poem":2},{"lineBreak":true},{"text":"ne, Yawé, naime 'ikɨ nekatiniunenetɨwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"»Wiyeri keneukaxɨrɨwani muyuawi meutitewatsie,","poem":1},{"text":"haiwitɨri, tita mɨtiheitseriekɨ keneukawiwiyeni.","poem":2},{"text":"Kwie huhutakatɨ ke'anutayepierixɨani.","poem":1},{"text":"Wikweitsitɨarika ke'utineni.","poem":2},{"text":"Hamatɨana ke'utawere tita mɨtiheitserie.","poem":1},{"text":"Ne, Yawé, nekaninetɨani».","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Xɨa'ui kemɨ'ane mɨniukixie mitawewi hepaɨtsita.","poem":1},{"text":"Xɨa'ui kemɨ'ane mɨtari","poem":2},{"lineBreak":true},{"text":"mɨtitariwe kwiepa timieme tsata.","poem":2},{"text":"¿Kamɨtsɨ tiyɨwe haxu kemɨ'ane mipɨna mɨpaɨ mɨtiutahɨawe:","poem":1},{"text":"«Kepemɨtiyuriene kene'a'ɨwiya.","poem":2},{"lineBreak":true},{"text":"'Aye'ɨ pɨkahawiwietɨkari.»?","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Xɨa'ui kemɨ'ane yupaapa mɨpaɨ mɨranutahɨawe:","poem":1},{"text":"«Neuxei ketitayari penetiutinuiwitɨa».","poem":2},{"text":"Xɨa'ui yumaama mɨpaɨ mɨranutate'a:","poem":1},{"text":"«Neuxei ketitayari penetiutiniwexɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yawé mɨpaɨ kanaineni,","poem":1},{"text":"Mɨpatsie 'Ixaheri hetsiemieme, mitawewi:","poem":2},{"text":"«Xeme neniwema wahetsiemieme xemɨnetsi'uta'iwawiya 'uxa'atɨni kemɨtiwayurieni pɨkayɨwe,","poem":1},{"text":"yatɨni yaxemɨnetetahɨawekɨ kenemɨtiyurienikɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne kwie nekaniutawewieni,","poem":1},{"text":"hetsiena teɨteri nekaniwarunetɨani.","poem":2},{"text":"Nemamate katiniuyurieni muyuawi 'amuyemanaxɨ,","poem":1},{"text":"meta mana xurawetsixi memuyeyaxekɨ nekaniwaruta'aitɨani.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tsiru hetsiemieme kemɨtiheitseriekɨ nekatiniyurimɨkɨ,","poem":1},{"text":"huyeya heitserie nekaniuyetemɨkɨ.","poem":2},{"text":"Mɨkɨ nekiekari kananukuketɨamɨkɨ,","poem":1},{"text":"meta kemɨ'ane memanutaxɨriya kaniwatixɨnamɨkɨ,","poem":2},{"text":"peru tixaɨtɨ tuminikɨ meta 'axamɨtayɨnikɨ xɨka xewitɨ tumini 'i'ɨitɨaka.","poem":1},{"text":"Ne mɨpaɨ nekanaineni, Yawé Naimekɨnemɨtɨrɨkaɨye».","poem":2}]},{"type":"verse","number":14,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«'Ekipitu mɨtiwewiya meta piinitɨarika Kutsi timieme,","poem":1},{"text":"naitɨ 'apiinite katinayeimɨkɨ,","poem":2},{"text":"tsaweutsixi, teɨteri kwinimieme memɨtɨtɨ,","poem":1},{"text":"'a'utɨa mepuhuni tepɨakɨ mehɨatɨkaitɨ.","poem":2},{"text":"'Ahɨxie mepɨtitunuma'uni,","poem":1},{"text":"waɨkawa memetsiwawirietɨ mɨpaɨ mepɨtiyuani:","poem":2},{"text":"“Yuxewitɨ xeikɨa Kakaɨyari 'apuyeika tawarita xewitɨ pumawe,","poem":1},{"text":"mɨkɨ Kakaɨyari 'ahamatɨa puyeika”».","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"'Ekɨ, Kakaɨyari meta 'Ixaheri wikweitsitɨwame,","poem":1},{"text":"'ekɨ Kakaɨyari pemɨkahekɨa pepɨhɨkɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yunaitɨ kemɨ'ane kakaɨyarixi memɨwawewie","poem":1},{"text":"mepɨtewiyatsitɨarieni meta nitixaɨtɨ mepɨkatehayeitɨarieni,","poem":2},{"lineBreak":true},{"text":"nitixaɨtɨ mekatehɨkɨtɨtɨ mepɨyehu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Peru 'Ixaheri Yawé pitawikweitsitɨani,","poem":1},{"text":"yuheyeme wikweitsitɨarikakɨ,","poem":2},{"text":"tawarita hatsuaku pɨkatewiyatsitɨarieni","poem":1},{"text":"meta tawariri tixaɨtɨ pekatihɨkɨtɨtɨ pepɨka'ayeitɨarieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Karikɨ Yawé mɨpaɨ kanaineni,","poem":1},{"text":"kemɨ'ane muyuawi 'amuyema,","poem":2},{"text":"Kakaɨyari kwie mutawewi,","poem":1},{"text":"minetɨa meta 'amiyeye,","poem":2},{"text":"makumawenikɨ mɨka'itawewi,","poem":1},{"text":"mitawewi mana mɨkiepatɨnikɨ:","poem":2},{"text":"«Ne Yawé nekanihɨkɨtɨni,","poem":1},{"text":"tawarita xewitɨ kaniumaweni.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hawaikɨ 'ikɨ kwieyari mɨyɨwitsie","poem":1},{"text":"'awiekamekɨ nepɨkaxetahɨawiwe.","poem":2},{"text":"Meta Kakuwu nuiwarimama mɨpaɨ nepɨkatiwatahɨawiwe:","poem":1},{"text":"“Xekeneneutiwawa peru xepɨkanetsitaxeiya”.","poem":2},{"text":"Ne, Yawé, nepɨtikuxata tita mɨtiheitserie,","poem":1},{"text":"meta yanepaine tita 'aixɨa mɨti'anekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"»Xekeneuyukuxeɨri xemeyuta'unaxɨa nuiwarite watsata,","poem":1},{"text":"xekeneuyukuxeɨri, xekenakɨni.","poem":2},{"text":"'Atsimemɨkatemate mekanihɨkɨtɨni kemɨ'ane kɨye kakaɨyarixiyari memɨwarɨ'ɨ,","poem":1},{"text":"meta kakaɨyarixi wahɨxie memuyunenewixime memɨkateyuwikweitsitɨwa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yaxekeneutiyua,","poem":1},{"text":"xeketeneutahekɨata.","poem":2},{"text":"¿Kemɨ'ane 'ipaɨ putayɨ meripaitɨ,","poem":1},{"text":"kemɨ'ane yaputayɨ meripaitɨ?","poem":2},{"text":"¿Kamɨtsɨ ne, Yawé, yanekatiutayɨ?","poem":1},{"text":"Tawarita xewitɨ Kakaɨyari kaniumaweni,","poem":2},{"text":"Kakaɨyari heitserie hexeiyatɨ meta tiyuwikweitsitɨwatɨ,","poem":1},{"text":"tawarita xewitɨ kaniumaweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"»Nehetsɨa tawarita xekeneu'axɨa, xemɨtawikweitsitɨarienikɨ,","poem":1},{"text":"yunaitɨ kwie manu'axetsie paitɨ xemu'uwa,","poem":2},{"lineBreak":true},{"text":"karikɨ ne nekanikakaɨyaritɨni, tawarita xewitɨ kaniumaweni.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ne mɨpaɨ yurikɨ nekaniuyuhɨritɨani nehetsiemieme,","poem":1},{"text":"heitseriekamekɨ yanekaniutayɨni","poem":2},{"lineBreak":true},{"text":"niuki nemɨka'ipatakɨ:","poem":2},{"text":"Nehɨxie yunaitɨ mepɨkatunuma'uni,","poem":1},{"text":"nehetsiemieme yamepɨteyuhɨritɨani yunaitɨ teɨteri.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mɨkɨ mɨpaɨ mepɨtiyuani nehetsiemieme: “Yawé hetsie xeikɨa kanixuaweni","poem":1},{"text":"tita mɨtiheitserie meta tɨrɨkariya”».","poem":2},{"text":"Yunaitɨ kemɨ'ane memiyehekaxɨ","poem":1},{"text":"mɨkɨ hɨxie mekaniti'uikuni,","poem":2},{"lineBreak":true},{"text":"mekanitewiyatsitɨariekuni.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Matsi yunaitɨ 'Ixaheri nuiwarimama","poem":1},{"text":"Yawé katinehekɨatamɨkɨ heitserie kememɨtehexeiyakɨ meta 'aixɨa kememɨtexeiyarie.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}