{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":46,"content":[{"type":"heading","content":["Wawiruniya kakaɨyariximama"]},{"type":"verse","number":1,"content":[{"text":"Weri panakatutsi, Newu kwiepa kaniukaweni,","poem":1},{"text":"wakakaɨyarixi tetɨkɨmete wahetsie meputɨkiexime.","poem":2},{"text":"Wa'ɨkiyarite 'ahetetɨ naitsarie pukɨtɨkiene,","poem":1},{"text":"'ika mɨtiyu'uxitɨwa pɨhɨkɨ xeikɨa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mana 'axeikɨa yunaitɨ mekaniyuyetuani meta mekananakatutsireni,","poem":1},{"text":"'ika memukuwikweitsitɨani mepɨkayɨwawe,","poem":2},{"lineBreak":true},{"text":"mɨkɨtɨtɨ memanutaxɨriwatatsie mekanekɨkani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«Kakuwu tɨɨriyamama, xeneneu'eni,","poem":1},{"text":"'Ixaheri niwemama yunaitɨ kexemɨyupaɨme,","poem":2},{"text":"huriepapaitɨ xeyeteme nemɨxe'utitɨkixɨ,","poem":1},{"text":"meta warɨitsie nemɨxe'utiwaweriyaxɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Meta kepauka 'akuxi xemu'ukirawetsixitɨni meta xemumutuxatɨkanitsie,","poem":1},{"text":"ne mɨkɨ yaxeikɨa nekanihɨkɨtɨkamɨkɨ, ne nekanixetuikakamɨkɨ.","poem":2},{"text":"Ne nekaxeniutiwewieni, nepɨxe'ɨwiyani,","poem":1},{"text":"nepɨxeparewieka meta nepɨxewikweitsitɨaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"»¿Kemɨ'ane hamatɨa pepɨnetsi'inɨata,","poem":1},{"text":"kemɨ'ane hepaɨ nepɨ'ane?","poem":2},{"text":"¿Kemɨ'ane hepaɨ nepɨtinexexeiya,","poem":1},{"text":"kemɨ'ane hamatɨa yaxeikɨa tepɨ'anene?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hipatɨ huru yukɨtsiurita mieme mepɨxɨtɨa","poem":1},{"text":"meta pɨrata ti'inɨnɨatametsie mepɨku'inɨnɨata,","poem":2},{"text":"xeimeta tiwewiwame meputa'iniwa kakaɨyaritɨme mɨwatawewirienikɨ,","poem":1},{"text":"mɨkɨ kakaɨyaritɨme hɨxie panakatutsita 'itahɨaweke.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yunaiparitsie me'etetɨ mekanititɨkɨni,","poem":1},{"text":"manuwekaitsie mekanitaketsani, mana puyukuhayeikawa.","poem":2},{"lineBreak":true},{"text":"Mukuyuaxɨani manuwetsie pɨkayɨwe.","poem":2},{"text":"Tsepa waɨkawa memihiwie, pɨkawata'eiya,","poem":1},{"text":"mɨkɨ pɨkayɨwe xe'uximatɨarikatsie mɨxe'utawikweitsitɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"»Xemɨkateheuyu'enie, 'ikɨ xekena'eriwani,","poem":1},{"text":"xekeneutimaixɨa, yumu'utsie xekeneye'ɨnani.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Meripaitɨ timieme xeketenaye'eri,","poem":1},{"text":"ne Kakaɨyari nepɨhɨkɨ, tawarita xewitɨ pumawe,","poem":2},{"lineBreak":true},{"text":"ne Kakaɨyari nepɨhɨkɨ, tawarita xewitɨ nehepaɨ 'anetɨ pumawe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne yanekaniutayɨni tsutɨa paitɨ kepauka tukari maye'ani,","poem":1},{"text":"meripaitɨ nepɨtikuxata, kemɨtiyɨni.","poem":2},{"text":"Ne mɨpaɨ nepaine: Ne kenemaineni yapɨtiyɨni,","poem":1},{"text":"meta kemɨnetinake yanepɨtiyurieni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tau manatineika hepa paitɨ 'uyeikame","poem":1},{"text":"wirɨkɨ wai mukwa'a neputa'iniwa,","poem":2},{"text":"meta kwiepa 'aheteewametsie,","poem":1},{"text":"tewi kemɨ'ane kenemɨtiyurieni mɨraye'atɨani nepɨta'inieni.","poem":2},{"text":"Kenemutayɨ, yanepɨtiyurieni maye'anikɨ,","poem":1},{"text":"kenemɨtiu'iyaritaxɨ, mɨpaɨ nepɨtiyurieni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xeme xekeneneu'eni, xe'iyari mɨtsetse'i,","poem":1},{"text":"tita mɨtiheitserietsie 'ateewa xemu'uwa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tita mɨtiheitserie nehetsɨa mieme pɨkaheteewa,","poem":1},{"text":"newikweitsitɨarika kwitɨwari paye'ani pɨkareutere.","poem":2},{"lineBreak":true},{"text":"'Ari nekani'atɨamɨkɨ.","poem":2},{"text":"Tsiyuni wikweitsitɨarika nekanipitɨamɨkɨ,","poem":1},{"text":"meta 'Ixaheri kenemɨtimariwe nepɨxeitsitɨani.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/45.json","previousChapterAudioLinks":{},"numberOfVerses":13}