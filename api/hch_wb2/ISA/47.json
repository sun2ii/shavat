{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":47,"content":[{"type":"heading","content":["Wawiruniya kemɨtiuka'unixɨ"]},{"type":"verse","number":1,"content":[{"text":"»Kenanakaye'a, tumuanaripa keneutayexi,","poem":1},{"text":"Wawiruniya niweya 'uka 'ɨimari,","poem":2},{"text":"kwiepa keneutayexi, 'uka karireutsixi waniwe,","poem":1},{"text":"'uweni kaniumaweniri.","poem":2},{"text":"Hatsuakuri witsipetiyɨritɨ witsipe'anetɨ","poem":1},{"text":"pepɨkatitahɨawarieni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tete murinayari keneutitu'i, harina keneuyetɨxi,","poem":1},{"text":"'ixuriki 'ahɨxie pemeukuwera keneɨkɨxɨna.","poem":2},{"text":"'A'iwi keneukutuka, 'a'ɨkate keneutimaweriyaka,","poem":1},{"text":"hatɨatetsie kenanuye'a.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kepemɨtimawe kanihekɨarimɨkɨ,","poem":1},{"text":"'atewiyarika pekanihekɨatamɨkɨ.","poem":2},{"text":"Ne nekaninekɨhɨamɨkɨ,","poem":1},{"text":"nixeime nepɨkareuyehɨwirieni».","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tatsiwikweitsitɨwame Mɨpatsie 'Ixaheri hetsiemieme kanihɨkɨtɨni,","poem":1},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye katinitewaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Kayuwatɨ ketineuyexi, 'uka karireutsixi waniwe,","poem":1},{"text":"yɨwita keneutahaki.","poem":2},{"text":"Tawariri hatsuaku “'uka nuiwarite tiwa'aitɨwame”","poem":1},{"text":"pemɨkatiterɨwarienikɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne neteɨterima wahetsiemieme nepɨha'akai,","poem":1},{"text":"'ayumieme mekapatsiekame nepuwarayeitɨa nehetsiemiemete.","poem":2},{"text":"Nepuwayetua 'amamatsie,","poem":1},{"text":"'ekɨta pepɨkawarutinenimayataxɨ.","poem":2},{"text":"'Ukirawetsixi waɨkawa raheteme","poem":1},{"text":"pepɨtiwaruta'aitɨa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mɨpaɨ peputayɨ: “'Uka neheyemekɨ ti'aitame nepɨhɨkɨtɨni”.","poem":1},{"text":"Peru mɨpaɨ pepɨkatimaikai,","poem":2},{"lineBreak":true},{"text":"meta pepɨkaheitimaixɨa kepemɨreutiparekekai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"»Hikɨ 'ikɨ keneu'eni, pemɨtiukahiwe'erie,","poem":1},{"text":"'ekɨ kayuwatɨ pemuyeika, mɨpaɨ pemuti'akɨhɨawe:","poem":2},{"text":"“Ne nekanihɨkɨtɨni, tawarita xewitɨ kaniumaweni.","poem":1},{"text":"Hatsuaku wiura nepɨkahayani meta neniwema nekawarexeiyatɨ nepɨka'ayani”.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yapauka, xeitukaritsie,","poem":1},{"text":"naitɨ mɨkɨ 'ahetsie katinaye'amɨkɨ:","poem":2},{"text":"'aniwema pekaniwareuyehɨamɨkɨ meta wiura pekanayeimɨkɨ,","poem":1},{"text":"mɨkɨ mekamenitimariutakuni,","poem":2},{"lineBreak":true},{"text":"tsepa waɨkawa pemɨti'akewaiya","poem":2},{"lineBreak":true},{"text":"meta kepemɨtiuyemate yɨkɨ pemɨtiyurienikɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Ekɨ 'axapemɨtiyurienetsie pepɨtiwiya,","poem":1},{"text":"mɨpaɨ pekaniutaineni: “Nixewitɨ pɨkanetsixeiya”.","poem":2},{"text":"Kepemɨtimaiwe meta kepemɨtimate pɨmati'itaiya","poem":1},{"text":"kepauka 'axɨata mɨpaɨ pemutaine:","poem":2},{"lineBreak":true},{"text":"“Ne nekanihɨkɨtɨni, tawarita xewitɨ kaniumaweni”.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Peru 'uximatɨarika kaninuamɨkɨ 'ahetsie","poem":1},{"text":"pemuwaranayexɨrieni pepɨkayɨweni kepemɨtiuyematekɨ,","poem":2},{"text":"kwiniya 'ahetsie kaninuamɨkɨ","poem":1},{"text":"'ekɨ pepɨka'itawikweiya.","poem":2},{"text":"'Ahetsie katininuamɨkɨ kepemɨkati'akɨhɨawetsie,","poem":1},{"text":"yapauka 'ahetsie katininuamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"»Merikɨte, keneyeweiyani, peti'akewaiyatɨ","poem":1},{"text":"'ikewari kepaɨmeme pemuyematekɨ,","poem":2},{"lineBreak":true},{"text":"nunutsiyari paitɨ pemiti'ati'ɨkitɨa.","poem":2},{"text":"Heiwatɨ petiunakitsitɨani,","poem":1},{"text":"heiwatɨ pemakaxiwatɨ pe'ayani.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Waɨkawa 'ɨxatsikɨ pepu'uxe.","poem":1},{"text":"Muyuawitsie miemekɨ memɨteyɨ'ɨkitɨa 'ahetsɨa miemete meke'uyukuxeɨrieni,","poem":2},{"text":"xurawetsixi memɨwaxeiya,","poem":1},{"text":"kemɨtiyɨni memɨtekuxata xeimetseri 'anukayeikakaku,","poem":2},{"lineBreak":true},{"text":"mekematsi'utawikweitsitɨani tita 'ahetsie mɨraye'aximekɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Keniwaruxeiya. Mɨaxa hepaɨ mekani'aneni,","poem":1},{"text":"tai kaniwatixɨtsitɨamɨkɨ.","poem":2},{"text":"Yɨkɨmana taipa memuyutawikweitsitɨani mepɨkayɨwawe.","poem":1},{"lineBreak":true},{"text":"'Ena tɨɨ pumawe muyutaxɨriyakɨ,","poem":1},{"text":"meta tai 'auriena mutiyerɨni.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mɨpaɨ mekani'aneneni teyukewaiyamete 'ahetsiemieme","poem":1},{"text":"wahetsɨa pemuta'axekai,","poem":2},{"lineBreak":true},{"text":"wahamatɨa nunutsiyari paitɨ pemuyuharerutakai.","poem":2},{"text":"Mɨkɨ yuxexuitɨ 'axamepɨteyurie,","poem":1},{"text":"xewitɨ pumawe mɨwatawikweitsitɨanikɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}