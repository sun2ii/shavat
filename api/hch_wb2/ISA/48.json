{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":48,"content":[{"type":"heading","content":["'Ixaheri kemɨtitse'i"]},{"type":"verse","number":1,"content":[{"text":"»'Ikɨ xeme xeketeneu'eni,","poem":1},{"text":"Kakuwu tɨɨriyamama,","poem":2},{"text":"Kura nuiwarimama,","poem":1},{"text":"'ixaheritsixi xemɨte'uterɨwarɨwa,","poem":2},{"text":"Yawé hetsiemieme xemɨyuhɨritɨa,","poem":1},{"text":"meta 'Ixaheri Kakaɨyarieya memahɨawe,","poem":2},{"lineBreak":true},{"text":"peru yu'iyarikɨ xemɨkayɨa meta kemɨtiheitseriekɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Xeme mɨpaɨ xemɨteyuterɨwa “kiekari mɨpatsietsie kiekatari,”","poem":1},{"text":"'Ixaheri Kakaɨyarieyatsie yuri xemɨte'erie,","poem":2},{"lineBreak":true},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye mɨtitewa hetsie:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mɨixa panuyemie","poem":1},{"text":"nepɨtiutaxa meripaitɨ kemɨtiɨyɨ.","poem":2},{"text":"Ne nepitahekɨataxɨ,","poem":1},{"text":"netɨtɨ nepɨxe'utaxatɨa.","poem":2},{"text":"Yapauka mɨpaɨ nepɨtiuyuri,","poem":1},{"text":"hikɨ yapɨraye'atɨarie mɨkɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne nemɨtimaikaikɨ 'ekɨ pemɨ'iyari tse'i,","poem":1},{"text":"'akɨipi tepɨa mɨhɨkɨkɨ,","poem":2},{"lineBreak":true},{"text":"meta 'anierika wurunitse mɨhɨkɨkɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Ayumieme ne meripaitɨ mɨkɨ nepɨmatiutaxatɨa,","poem":1},{"text":"nepɨmatiuhekɨatɨa mɨpaɨ 'akuxi katiyɨwekaku,","poem":2},{"text":"mɨpaɨ pemɨkahainenikɨ:","poem":1},{"text":"“Mɨkɨ nekakaɨyari mamakɨ muwewiya katiniuyurieni.","poem":2},{"lineBreak":true},{"text":"Mɨkɨ nekakaɨyarixi memɨxixiyatɨka meta memɨtaiyarietɨka mɨyamekateniuyurieni”.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Naime 'ikɨ hepaɨtsita pepɨtimate,","poem":1},{"text":"¿kamɨtsɨ pekatitaxata?","poem":2},{"lineBreak":true},{"text":"»Hikɨ mɨtiyehane tihehekwame nepɨmatixeitsitɨani,","poem":1},{"text":"tita mɨti'awietɨ meta tita pemɨkatimate.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hikɨke mɨtiutawewiya katinihɨkɨtɨni, meripaitɨ kapɨtimieme,","poem":1},{"text":"meripaitɨ mɨkɨ pepɨkati'eniwekai,","poem":2},{"text":"mɨpaɨ pemɨkahainenikɨ:","poem":1},{"text":"“'Ari ne mɨpaɨ nepɨtimaikai”.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hatsuaku mɨpaɨ pepɨkati'enawekai, meta mɨpaɨ pepɨkatimaikai,","poem":1},{"text":"meripaitɨ pepɨkaheu'enakai.","poem":2},{"text":"Ne nekatinakumaika pemɨtiyukananaima,","poem":1},{"text":"nunutsiyari paitɨtɨ “mɨrayuye'unie” pekatiniuterɨwarɨwani.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kenemɨtitewa nemɨnaki'eriekɨ nehaxɨa nepɨnewie,","poem":1},{"text":"nenɨawarikɨ nepuyupirenutɨa,","poem":2},{"lineBreak":true},{"text":"nemɨkametsikumaweriyakɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Neuxei. Nekameniu'itieni peru hawaikɨ pɨrata hepaɨ,","poem":1},{"text":"nekameniuta'inɨata 'uximatɨarika huxunuyarita.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nehetsiemieme nekameniuyurieni.","poem":1},{"text":"Yanepɨkatinaki'erie nekapatsiekame xemɨnetsi'ayeitɨwanikɨ kenemɨtitewakɨ.","poem":2},{"lineBreak":true},{"text":"Tawarita xeime nepɨkapitɨani witsikenemɨ'anekɨ.","poem":2}]},{"type":"heading","content":["'Ixaheri kemɨtiɨxɨnarie"]},{"type":"verse","number":12,"content":[{"text":"»Kakuwu keneneu'eni,","poem":1},{"text":"'Ixaheri, nemɨmatsi'anayexei:","poem":2},{"text":"Ne Kakaɨyari nepɨhɨkɨ,","poem":1},{"text":"ne mexɨakame nepɨhɨkɨ, meta 'imatɨrieka mieme.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ne'utakɨ kwie 'aixɨa nepuyuri,","poem":1},{"text":"netseriekɨ muyuawi neputaweraxɨ.","poem":2},{"text":"Ne nepuwarutaterɨwaxɨ,","poem":1},{"text":"hikɨ mɨkɨ yunaitɨ mepuhekɨarixɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"»Xekeneuyukuxeɨri xeme yunaitɨ xekeneu'enana:","poem":1},{"text":"¿Kemɨ'ane mɨkɨ xewitɨ pɨtiutaxa 'ikɨ?","poem":2},{"text":"Yawé minaki'erie","poem":1},{"text":"yapɨtiyurieni Wawiruniya hetsie,","poem":2},{"lineBreak":true},{"text":"tɨrɨkariyaya karireutsixi wahetsie pɨtinakeni.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ne xeikɨa mɨpaɨ nekaniutayɨni,","poem":1},{"text":"ne nekanita'inieni.","poem":2},{"text":"Ne nekani'atɨamɨkɨ,","poem":1},{"text":"katinayu'iwamɨkɨ kenemɨtita'aitɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"»Hurawa ne'aurie xekeniwakɨni, 'ikɨ xeketeneu'eni:","poem":1},{"lineBreak":true},{"text":"»Tsutɨa paitɨtɨ, hawaikɨ 'awie nepɨkaretaxa,","poem":1},{"text":"kepaukata mɨpaɨ mɨtiyɨni, ne mana nepuyeikani».","poem":2},{"lineBreak":true},{"text":"Hikɨta Yawé naimekɨmɨyɨwe","poem":1},{"text":"pɨnetsiheyenɨ'a 'Iyari yuhetsɨa miemekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Yawé mɨpaɨ kanaineni,","poem":1},{"text":"Matsiwikweitsitɨwame, Mɨpatsie 'Ixaheri hetsiemieme:","poem":2},{"text":"«Ne Yawé Kakaɨyari nepɨhɨkɨ,","poem":1},{"text":"mɨmati'ɨkitɨa tita 'ahetsiemieme 'aixɨa mɨti'ane,","poem":2},{"lineBreak":true},{"text":"mɨmatsi'uwitɨxime kemɨ'ane huye pemuweiyanitsie.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Xɨka ne'aitsika pe'u'enienike,","poem":1},{"text":"kayuwatɨ pemexeiyakɨ hatɨa hepaɨ pɨ'anenike,","poem":2},{"lineBreak":true},{"text":"heitseriekamekɨ kepemɨtiuyeika haramara hamewariyari muwakɨka hepaɨ pɨ'anenike.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Xiekari hepaɨ 'anuiwarima mepɨyupaɨmenike,","poem":1},{"text":"'aniwema, xiekari 'uriyari hepaɨ,","poem":2},{"text":"kememɨtetewa hatsuaku mepɨka'akuyeitɨarienikekai,","poem":1},{"text":"metatsiere nehɨxie mepɨkahayeitɨarienikekai».","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Wawiruniya kiekariyaritsie xekenayekɨni.","poem":1},{"text":"Karireutsixi watsata xekenayekɨni xemuyuta'unakɨ.","poem":2},{"text":"Mɨpaɨ xeketeneutaxata xe'utihiwatɨ temawierikakɨ,","poem":1},{"text":"meta yunaitɨ meketehetimani.","poem":2},{"text":"'Ikɨ niuki xekeneuta hekɨata kwie manu'axe paitɨ,","poem":1},{"text":"mɨpaɨ xekeneutiyua: «Yawé Kakuwu kaniutawikweitsitɨani tiyu'uximayatsiriwame».","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kepauka makumawetsie muwaruwitɨtɨya,","poem":1},{"text":"mepɨka'uharikwi,","poem":2},{"text":"yapɨtiuyuri 'aitsie manenikɨ haa wahetsiemieme,","poem":1},{"text":"tete kaneutara, haixa mana kananexɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«'Axamɨtiuka'iyari kayuwatɨ pɨkahexeiya»,","poem":1},{"text":"Yawé mɨpaɨ kanaineni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/47.json","previousChapterAudioLinks":{},"numberOfVerses":22}