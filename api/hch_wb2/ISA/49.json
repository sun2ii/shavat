{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":49,"content":[{"type":"heading","content":["Yawé ti'uximayatsiriwame"]},{"type":"verse","number":1,"content":[{"text":"Xekeneneu'eni, haramara tetsita 'ateewa xemeutitei,","poem":1},{"text":"'ikɨ xeketeneu'eni, nuiwarite teewatari:","poem":2},{"text":"Yawé pɨnetsi'anayexei nekatinuiwawekaku 'akuxi,","poem":1},{"text":"nemaamatsie neyekaiku pɨnetsi'utaterɨwaxɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Neteta 'ixipara 'atamɨariekame patike,","poem":1},{"text":"pɨnetsi'uti'awietaxɨ yumamá 'etɨrieyatsie,","poem":2},{"text":"'ɨrɨ hepaɨ witsine'aneme pɨnetsihayeitɨa,","poem":1},{"text":"meta pɨnetsi'uti'awietaxɨ yɨ'ɨrɨ 'uitɨwameta.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mɨpaɨ kanetiniutahɨawe: «'Ixaheri,","poem":1},{"text":"'ekɨ neti'uximayatsiriwame pepɨhɨkɨ,","poem":2},{"lineBreak":true},{"text":"'ahekɨ 'aixɨa nepɨtitahɨawarieni».","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Neta mɨpaɨ neputayɨ: «Yakɨ xeikɨa nepɨti'uximaya,","poem":1},{"text":"neputiwaɨripiri 'atsinekatiyuriwetɨ.","poem":2},{"text":"Peru heitserie kenemɨrexeiya Yawé mamayatsie pɨti'ane,","poem":1},{"text":"tita nemɨra'iwaxɨ nekakaɨyari hetsɨa pɨrekupine».","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Hikɨta Yawé mɨpaɨ kanaineni,","poem":1},{"text":"nemaamatsie mɨnetsikaye,","poem":2},{"lineBreak":true},{"text":"ne ti'uximayatame hetsiena mieme nemayanikɨ,","poem":2},{"text":"Kakuwu nemɨ'atɨanikɨ hetsɨana,","poem":1},{"text":"'ixaheritsixi 'auriena memɨ'axɨanikɨ,","poem":2},{"text":"Yawé hɨxie ne 'aixɨa nemɨtiuka'iyarikɨ,","poem":1},{"text":"Kakaɨyarita nehetsie nunuwame pɨhɨkɨ:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"«Neti'uximayatsiriwame pepɨhɨkɨ,","poem":1},{"text":"meta Kakuwu nuiwarimama pemɨwahekwariya,","poem":2},{"text":"meta 'ixaheritsixi pemɨwa'atɨani,","poem":1},{"text":"kemɨ'ane nemɨwa'ɨwiya,","poem":2},{"text":"hikɨ 'ayumieme nuiwarite wahekɨariwiyame nekamenayeitɨamɨkɨ,","poem":1},{"text":"newikweitsitɨarika kwie manu'axe paitɨ pemɨtaxatakɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mɨpaɨ kanaineni Yawé,","poem":1},{"text":"Tiyuwikweitsitɨwame meta Mɨpatsie 'Ixaheri hetsiemieme,","poem":2},{"text":"mɨnanaimarie nuiwarite memixani'erie mɨpaɨ katinahɨaweni,","poem":1},{"text":"ti'uximayatame kuwexinaruritsixi wahetsiemieme:","poem":2},{"text":"«Te'aitamete mepɨmatsixeiya 'ana 'amepɨti'uni,","poem":1},{"text":"memanuyetei memetsixeiyame 'ana mepakatutsitaxɨani,","poem":2},{"text":"Yawé hekɨ, 'Ixaheri hetsie Mɨpatsie,","poem":1},{"text":"yamɨtikamie meta mɨmetsi'anayexei».","poem":2}]},{"type":"heading","content":["'Ixaheri kemɨrakunuitɨarieni"]},{"type":"verse","number":8,"content":["Mɨpaɨ kanaineni Yawé:",{"text":"«Yemekɨ kepauka yanemɨra'eriwakai 'ana nepɨmetsi'uta'ei,","poem":1},{"text":"kepauka newikweitsitɨarika maye'a 'ana nepɨmetsi'uparewi.","poem":2},{"text":"Hikɨri nekameni'ɨwiyakamɨkɨ,","poem":1},{"text":"meta ne tɨratu nepɨmetsi'ayeitɨa teɨteri wahetsiemieme,","poem":2},{"text":"tawari 'akwieyari 'aixɨa pemukuyurienikɨ,","poem":1},{"text":"meta kwie yuxaɨta mukumane 'aniwema pemɨwaxatɨanikɨ,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"mɨpaɨ pemɨtiwatahɨawekɨ memanutaxɨriya:","poem":1},{"text":"“Xekenewayekɨni”,","poem":2},{"text":"meta yɨwita memu'uwa:","poem":1},{"text":"“Xekanixɨxɨniniri”.","poem":2},{"lineBreak":true},{"text":"»Huye 'aurie xepɨtetikwani","poem":1},{"text":"meta naitsarie hɨri mu'aiyatsie yu'ikwai xepɨkaxeiya.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Xepɨkaheuhaakakwikuni meta xepɨkaheuharikuni,","poem":1},{"text":"tau pɨkaxetiweranariya meta xepɨkaxɨrikwini,","poem":2},{"text":"kemɨ'ane mɨxenenimaya mɨxekuwitɨnenikɨ,","poem":1},{"text":"meta haixa muhapanetsie kanixekuwitɨnemɨkɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Naime nehɨritetsie huye nekanitiwewimɨkɨ,","poem":1},{"text":"meta nehuye 'a'atayeyeume nekanitiwewimɨkɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Neuxei. Mɨkɨ mekani'axɨakuni 'ateewa paitɨ meheyekɨneme,","poem":1},{"text":"hipatɨ tayeta mepakanexɨani, hipatɨta tau makayuyuipiketsie,","poem":2},{"lineBreak":true},{"text":"hipatɨta 'Atsuhani kwieyaritsie mepanexɨani».","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Xeme muyuawi, xekeneutihiwani temawierikakɨ.","poem":1},{"text":"Kwie, keneyutemawieka.","poem":2},{"lineBreak":true},{"text":"Hɨrite, kwikari xekenekwikani.","poem":2},{"text":"Yawé yuteɨterima muwanɨtɨakɨ","poem":1},{"text":"meta tixaɨtɨ memɨkateheuxeiya muwanenimayakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Peru Tsiyuni mɨpaɨ putayɨ: «Yawé pɨnetsi'uku'eiri.","poem":1},{"text":"Ti'aitame pɨnetsihatɨmai».","poem":2}]},{"type":"verse","number":15,"content":[{"text":"«¿Kamɨtsɨ tiyɨwe niwekame yuniwe tsitsitɨwatɨ metɨmaiya,","poem":1},{"text":"meta yuniwe naki'erietɨ miku'eirieni?","poem":2},{"text":"Tsepa mɨkɨ mɨyɨwe metɨmaiya,","poem":1},{"text":"peru ne nepɨkamatsihatɨmaiya.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nemamá meuweweritsie nepɨmatsiha'utɨa,","poem":1},{"text":"'akuraru yuheyemekɨ nepɨkahatɨtɨmaiya.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Memɨmatsi'anukakitɨani mepuyukumexɨitɨani,","poem":1},{"text":"memɨmatsi'uka'unakai mepɨmatsiku'eirieni,","poem":2},{"lineBreak":true},{"text":"meta heyekɨa memɨmatsi'ɨhɨa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Keneutanierixɨa, kenanieretɨye'a,","poem":1},{"text":"yunaitɨ mekaniyukuxeɨriximeni, 'ahepa 'umekanahuni.","poem":2},{"text":"Ne yuri nekaniutaineni ne'ayenieretɨ, —kanaineni Yawé—,","poem":1},{"text":"yunaime mɨkɨ witsipemɨtiyuxexeiyanikɨ pekaniwarayeitɨamɨkɨ,","poem":2},{"lineBreak":true},{"text":"mɨkɨ wahekɨ wikiwame kamixayari pemanakatɨnitsie tetexi mɨraye'axe pemɨreukapine pepɨtihekɨata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"»Tsepa pemuka'unarienike, tsepa yeuta pemuhayewarienike,","poem":1},{"text":"tsepa 'axaɨta pemu'ahayewake,","poem":2},{"text":"hikɨri mepɨkatenakeni 'ateɨterima 'ahetsie,","poem":1},{"text":"'ateewa mepuyuhayewari memɨmetsikwakai.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"'Aniwema meheuyexɨrieme pemɨ'eriekai","poem":1},{"text":"'anakata mɨpaɨ mepɨmeteheukahɨawe:","poem":2},{"text":"“'Ena nehetsiemieme 'etsipakuyewa,","poem":1},{"text":"tawari 'ayeume kwie nepeuyehɨwa mana nemukanikɨ”.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hikɨ mɨpaɨ pepɨti'erieni:","poem":1},{"text":"“¿Kemɨ'ane tɨɨri waɨkawa pɨnetsiyetuiri?","poem":2},{"text":"Ne tɨɨri nepɨkawarexeiyakai, nepɨkaniwewekai,","poem":1},{"text":"nepuka'unariekai, nepehɨiyakai,","poem":2},{"lineBreak":true},{"text":"peru 'ikɨ, ¿kemɨ'ane puwarutiwaweriyaxɨ?","poem":2},{"text":"Nexaɨtame nepunehayewakai,","poem":1},{"text":"peru 'ikɨ, ¿kemetehanexɨa?”»","poem":2}]},{"type":"verse","number":22,"content":["Mɨpaɨ kanaineni Yawé naimekɨmɨyɨwe:",{"text":"«Ne nuiwarite mɨpaɨ nepɨtiwatahɨawe,","poem":1},{"text":"yunaime teɨteri mɨpaɨ nepɨtiwata'aitɨani.","poem":2},{"text":"Mɨkɨ 'aniwema yumamatsie mepɨwara'ɨka,","poem":1},{"text":"meta 'aniwema 'ukari yuwaritsie mepɨwarutɨkɨni.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Te'aitamete yuniwema wahepaɨ mepɨwatiwaweriya,","poem":1},{"text":"meta wa'ɨitama mepɨmatsitiwaweririeni.","poem":2},{"text":"'Ahɨxie mepɨtihɨxima'uni kwiepa,","poem":1},{"text":"kwie mepakutsena pemiketsina.","poem":2},{"text":"'Ana mɨpaɨ pepɨretimani ne Yawé nemɨhɨkɨkɨ,","poem":1},{"text":"mepɨkatewiyatsitɨarieni","poem":2},{"lineBreak":true},{"text":"kemɨ'ane nehetsie yuri memɨte'erie».","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"¿Yukukuyamete piinitɨarika memɨte'a'iwaxɨ mɨtiwarunawairieni tiyɨwe?","poem":1},{"text":"¿Tiyɨwe manutahɨiya manayexɨnekɨ?","poem":2}]},{"type":"verse","number":25,"content":["Peru mɨpaɨ paine Yawé:",{"text":"«Huu, kuya mɨtɨrɨkaɨye xeime tewi manutahɨa pɨnawaiyarieni,","poem":1},{"text":"meta mɨkatiyukanenimaya piinitɨarika mɨra'iwaxɨ pɨtinawaiyarieni,","poem":2},{"text":"kemɨ'ane memɨmatsimietɨwe nekaniwatakwimɨkɨ,","poem":1},{"text":"netɨtɨ nekaniwatawikweitsitɨamɨkɨ 'aniwema.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Yanepɨtiyurieni memɨmatsi'aye'unie yuwaiyari memɨtikwanikɨ,","poem":1},{"text":"meta yuxuriyakɨ memɨtitarɨwenikɨ","poem":2},{"lineBreak":true},{"text":"winu mɨhɨkɨtɨni hepaɨ.","poem":2},{"text":"Hikɨ 'ana yunaitɨ teɨteri mɨpaɨ mepɨtehetimani","poem":1},{"text":"ne, Yawé, 'awikweitsitɨwame nemɨhɨkɨkɨ,","poem":2},{"lineBreak":true},{"text":"ne, Mɨtɨrɨkaɨye Kakuwu hetsiemieme, Nemumatsixɨname nemɨhɨkɨkɨ».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/48.json","previousChapterAudioLinks":{},"numberOfVerses":26}