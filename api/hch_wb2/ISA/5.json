{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":5,"content":[{"type":"heading","content":["Kaxie kwikariyari"]},{"type":"verse","number":1,"content":[{"text":"Nepɨtakwika nehamiku nemɨnaki'erie hetsiemieme","poem":1},{"text":"kaxie haraweriyari nɨawariyari hepaɨtsita.","poem":2},{"text":"Nehamiku kwinimieme nemɨtinaki'erie kaxie haraweri xeime pexeiyakai","poem":1},{"text":"'ukakɨakaku 'aixɨa tiuxuaweriwekaku.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kaniwati'ine, tetexi kananuyexɨrieni","poem":1},{"text":"'aixɨa 'anekɨa kanika'iteɨta.","poem":2},{"text":"Mɨkɨ hixɨapa tuxiyu kaniutakeni","poem":1},{"text":"meta mana matipɨnarɨwani kaniutawewieni.","poem":2},{"text":"Mɨkɨ 'aixɨa 'anenetɨ kaxie mɨtixuawerekɨ pɨta'ikwewakai,","poem":1},{"text":"matsi xeikɨa kaxie hatsinatɨ kaniukaxuawere.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hikɨ Kura teɨteriyari,","poem":1},{"text":"Kerutsareme kiekatari,","poem":2},{"lineBreak":true},{"text":"yaxekeneutiyua kemɨ'ane mɨya'aneme peutiwiwiexɨa nekaxie haraweriyari nutsɨtɨ ne pɨnehetsiemieme.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"¿Tawarita 'akuxi kenetiyurienikekai nekaxie haraweriyari hetsiemieme","poem":1},{"text":"tita reuyewetɨ ratɨa?","poem":2},{"text":"Ne 'aixɨa 'anenetɨ kaxie mɨkayaxekɨ nepɨta'ikwewakai.","poem":1},{"text":"¿Titayari kaxie hatsinatɨ tiukaxuawerixɨ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne nepɨtixetaxatɨani","poem":1},{"text":"kenemɨtiyurieni nekaxie haraweriyari hepaɨtsita:","poem":2},{"text":"Kuraruyari nepa'unatɨyani, kanika'unariemɨkɨ,","poem":1},{"text":"tetsariya 'amɨtɨtɨ nekanika'unamɨkɨ, hetsiena katina'uitɨmɨkɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yuxaɨta nekaniku'eirimɨkɨ,","poem":1},{"text":"pɨkakawitekieni mɨkakayɨrakɨ meta pɨkakakwietsanarieni,","poem":2},{"lineBreak":true},{"text":"mana xuya pɨtinexɨani meta 'ɨtsi.","poem":2},{"text":"Ne hai nepɨtita'aitɨani","poem":1},{"text":"mɨkɨ hetsie mɨka'ukawiwiyenikɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kaxie haraweriyari Yawé Naimekɨmɨtɨrɨkaɨye tipiinieya 'ixaheri teɨteriyari mekanihɨkɨtɨni,","poem":1},{"lineBreak":true},{"text":"Kura teɨteriyari kwiepa mɨraka'etsitɨre manayexeiyarie mekanihɨkɨtɨni.","poem":1},{"lineBreak":true},{"text":"Mɨkɨ 'aixɨa mɨti'ane pɨtitakwewiekai,","poem":1},{"text":"matsi xeikɨa xuriya 'uhaneme pukaxei,","poem":2},{"text":"mɨtiheitserie pɨtitakwewiekai,","poem":1},{"text":"matsi xeikɨa kukuiniya hiwariyari pukaxei.","poem":2}]},{"type":"heading","content":["Memɨteyukananaima wahetsiemieme"]},{"type":"verse","number":8,"content":[{"text":"Xɨa'ui 'iya kemɨ'ane yukii waɨkawa mexeiya","poem":1},{"text":"meta kwie mɨraka'etsitɨre waɨkawa yupiini memɨte'ayeitɨwa","poem":2},{"text":"nixeime tɨma mekahayewirietɨ mana mɨtayerɨnikɨ,","poem":1},{"text":"yuxaɨta xeikɨa 'axeikɨa metitetɨ mepuyukuhayeikawa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yawé Naimekɨmɨtɨrɨkaɨye mɨpaɨ nerahɨaweme nekaniu'enieni:","poem":1},{"text":"«Kiite waɨkawatɨ yuxaɨta kaniyuhayewamɨkɨ,","poem":2},{"lineBreak":true},{"text":"pumaweni kemɨ'ane kiite 'amupapata mayekanikɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kaxie haika hetariyayari xeikɨxauriyari xeikɨa payani,","poem":1},{"text":"meta tamamata merirayari 'imɨari","poem":2},{"lineBreak":true},{"text":"xeimerirayari xeikɨa kanayeimɨkɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Xɨa'ui kemɨ'ane ximeri paitɨ memanuku'uwe","poem":1},{"text":"winu xeikɨa me'iyuka memɨtitaruwenikɨ,","poem":2},{"text":"memukutaikaiyarɨwa","poem":1},{"text":"winukɨ metaruwetɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wa'ixɨararitsie winu puxuawe meta kanarite,","poem":1},{"text":"xawerite, tepu meta pirikɨxa.","poem":2},{"text":"Peru Yawé kemɨtiuyuri mepɨkayɨkɨ'ɨwiya","poem":1},{"text":"meta ketita mɨtiutiwewi yamepɨkatemate.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Ayumieme neteɨterima 'ateewa mepanuhapanieni","poem":1},{"text":"memɨkanetsimatekɨ,","poem":2},{"text":"waɨkawa memeuka'u hetsɨana miemete haakakɨ mekanikwikuni","poem":1},{"text":"meta teɨteri meyumuiretɨ hariyakɨ mekanikwikuni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Ayumieme teukiya yukɨipi waɨkawa panatixawariya,","poem":1},{"text":"ka'inɨarimekɨ yuteni kananutayepiwani.","poem":2},{"text":"Muwa mepeukakɨka waɨkawa memeuka'u meta tixaɨtɨ memɨkatehɨkɨ,","poem":1},{"text":"'ixɨarari yuariyaya meta waikari meta kememutiyɨ naime mete'atɨtɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tewi tixaɨtɨ pɨkarayeitɨarieni,","poem":1},{"text":"teɨteri mekanitihɨxima'uikuni,","poem":2},{"lineBreak":true},{"text":"kwinimieme memɨteyuti'ɨre mekanika'unariekuni.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yawé Naimekɨmɨtɨrɨkaɨye 'aixɨa katinikuxaxatsiwamɨkɨ 'axamɨti'ane mɨtiukwinitɨakɨ,","poem":1},{"text":"Kakaɨyari mɨpatsie matsiɨkɨtɨ kanayuyeitɨamɨkɨ kemɨtiheitserie patsietɨ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Muxatsi mepɨtetikwani yu'ɨxata memɨyɨaka hepaɨ,","poem":1},{"text":"tsipuri mepɨtetikwani xikutsixi mematitekaitsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Xɨa'ui kemɨ'ane 'axamɨti'ane memɨte'uhaxime 'itarika kaunariyarikɨ,","poem":1},{"text":"meta 'axakememɨteyurie memuhaxime kaxeta kaunariyarikɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mɨpaɨ mekaniutiyuaneni: «Kakaɨyari keyumexɨitɨaka,","poem":1},{"text":"kemɨtiyurieni keyukumexuitɨani","poem":2},{"lineBreak":true},{"text":"tame temixeiyakɨ,","poem":2},{"text":"'ahurawa kehayani meta yaketiɨyɨni","poem":1},{"text":"'Ixaheri hetsiemieme Mɨpatsie kemɨtiyurimɨkɨ,","poem":2},{"lineBreak":true},{"text":"mɨpaɨ yatemɨtehetimanikɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Xɨa'ui kemɨ'ane 'axamɨti'ane 'aixɨa ti'anekame mɨtiuterɨwa,","poem":1},{"text":"meta 'aixɨa mɨti'ane 'axati'anekame mayeitɨwa,","poem":2},{"text":"yɨriya hekɨariya memɨxata,","poem":1},{"text":"meta hekɨariya yɨriya memayeitɨwa,","poem":2},{"text":"mɨratsiwi hakakame memɨxata,","poem":1},{"text":"meta makaka hatsiwime memayeitɨwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Xɨa'ui kemɨ'ane waɨkawa metemaiwaweme memuyuxata,","poem":1},{"text":"kwinimieme meteheutamaiwaweme memuyu'erie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Xɨa'ui kemɨ'ane kwinimieme winu memɨteheuta'iwawe,","poem":1},{"text":"memɨkamama timɨireme mete'anuye'etɨ memɨtitaruwenikɨ,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"tumini memanu'ɨwe hetsiena mɨraka memɨteheuyehɨwirienikɨ,","poem":1},{"text":"meta 'atsimɨkatiuyuri heitserie kemɨrexeiyakɨ mepɨkaparewiku.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"'Ayumieme, tai nerɨkwari xatsi kemɨtitixɨxɨtsitɨwa","poem":1},{"text":"meta tai 'ɨxa muwawaki kemɨtititaiya,","poem":2},{"text":"nanarieya mɨtipɨniya,","poem":1},{"text":"meta kwauni hepaɨ tuturiyari katiniti'enimɨkɨ.","poem":2},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye 'inɨari niukiyarieya memɨka'utanaki'erikɨ","poem":1},{"text":"meta 'Ixaheri hetsiemieme Mɨpatsie niukieya memɨnanaimakɨ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"'Ayumieme Yawé haxɨaya kaniutani yuteɨterima wahepaɨtsita,","poem":1},{"text":"hetsiena yumamá kananukuhana meta kaniwani,","poem":2},{"text":"hɨrite kaniwatayuatɨkani,","poem":1},{"text":"mɨkite xatsi hepaɨ mekateniyukuhayeikawani","poem":2},{"lineBreak":true},{"text":"mɨranuyekɨkatɨretsie hixɨapa.","poem":2},{"lineBreak":true},{"text":"Mɨyatɨtɨ haxɨaya pɨkatiuhayewaxɨ,","poem":1},{"text":"yumamate 'akuxi kanitatseratɨkani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Paterakɨ xeime nuiwari teewatanaka kani'iniemɨkɨ,","poem":1},{"text":"kwie manu'axe paitɨ kiekame kanitawikɨiyamɨkɨ,","poem":2},{"lineBreak":true},{"text":"mɨkɨ nuiwari kwitɨwa kaninuamɨkɨ meta mexɨima.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Mɨkɨ nixewitɨ pɨkati'uxe meta pɨkahekaweni,","poem":1},{"text":"pɨkaheukumɨkɨni meta pɨkaheukuni,","poem":2},{"text":"nixewitɨ hɨiyameya pɨkaweranaxɨani","poem":1},{"text":"meta kakaiya kwitaxiyari pɨkahatekixɨani.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Wa'ɨrɨ kwinimieme pɨranuyemɨtsɨ,","poem":1},{"text":"naitɨ watupi payuhapatɨka,","poem":2},{"text":"wakawayutsixi tepɨa memeumanatɨka tete mɨtse'i hepaɨ pɨ'anene,","poem":1},{"text":"meta wakaxetate 'itsikɨriyarita teɨka puwayenenetɨwa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Maye 'ukaratsi mɨtiyuhaxɨatɨwa hepaɨ katiniyu'eniɨriɨkɨni,","poem":1},{"text":"meta mayetsi tɨɨrixi wahepaɨ,","poem":2},{"text":"'utitsinawatɨ yutahaxɨatɨame kaniwiyamɨkɨ tita mɨtitakwani,","poem":1},{"text":"meta kanenuhanimɨkɨ nixewitɨ pɨkayɨwe minawairienikɨ.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"'Iya tukaritsie kaniyutahaxɨatɨamɨkɨ hepaɨtsitana,","poem":1},{"text":"haramara kemɨtiutarɨrɨrɨka hepaɨ.","poem":2},{"text":"Xɨka xewitɨ kwie 'uxeiya,","poem":1},{"text":"'ɨyɨwime hetsiena pɨxeiya meta 'uximatɨariekame,","poem":2},{"lineBreak":true},{"text":"'ana hekɨariya kaniyuti'awietamɨkɨ hai 'amayetsuye warita.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/4.json","previousChapterAudioLinks":{},"numberOfVerses":30}