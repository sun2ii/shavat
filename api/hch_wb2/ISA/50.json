{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":50,"content":[{"type":"heading","content":["'Ixaheri ke'axamɨtiuyuri meta ti'uximayatsiriwame kemɨreu'ena"]},{"type":"verse","number":1,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«Ne xemaama, nepuku'eiri,","poem":1},{"text":"¿Peru hakewa 'eiriya xapayari?","poem":2},{"lineBreak":true},{"text":"¿Yatɨni kemɨ'ane nemɨrapiinirie hetsɨa nepɨxe'utua?","poem":2},{"text":"Xeme xekaniutuiyani 'axaxemɨte'uyurikɨ,","poem":1},{"text":"xeme xekaniutuiyani,","poem":2},{"text":"'axaxemɨteyuriekaikɨ xeme","poem":1},{"text":"xemaama kaniuku'eiriwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"¿Titayari nemunuatsie xeime tɨma nekatiutaxei?","poem":1},{"text":"¿Titayari xewitɨ kanetiuta'ei nemɨxe'utahɨawixɨtsie?","poem":2},{"text":"¿Kamɨtsɨ nekatiyɨwe nemɨxe'utawikweitsitɨanikɨ?","poem":1},{"text":"¿Kamɨtsɨ netɨrɨkariya katiyɨwe mɨxe'uxɨna?","poem":2},{"text":"'Etsiwa ne neyutahaxɨatɨayu haramara kanakawaukeni,","poem":1},{"text":"meta hatɨa makumawe nekanayeitɨwani,","poem":2},{"text":"haa heuyewekakaku tsapari mekanitakukuweni hariyakɨ,","poem":1},{"text":"meta mekanitipɨkeni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Muyuawi yɨriyakɨ nekaniukemaritɨani","poem":1},{"text":"meta naxi nekanikawiriwani muyuhiwerieka hepaɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yawé naimekɨmɨyɨwe pɨnetsi'upitɨa","poem":1},{"text":"nemeutaniuwenikɨ netimaiwetɨ,","poem":2},{"lineBreak":true},{"text":"kemɨ'ane mu'uxe neniukikɨ nemutuikanikɨ.","poem":2},{"text":"Ximeri yakanetinanutahɨtuwani,","poem":1},{"text":"meta nenakata neheu'ename kanenayeitɨaka","poem":2},{"lineBreak":true},{"text":"para nemeu'enanikɨ teyɨ'ɨkitɨwamete wahepaɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yawé naimekɨmɨyɨwe neheu'ename kanenayeitɨani,","poem":1},{"text":"hawaikɨ nepɨkahe'eiyani, meta ne'utɨa nepɨkayeyeika.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Newari nepɨyetua kemɨ'ane memɨnetsikuwayakai wahetsɨa,","poem":1},{"text":"ne'auri nepɨyetua kepauka hipatɨ nemɨxiya memanuyehunakai,","poem":2},{"text":"neyuriyariekaku meta kepauka nemuku'aɨtsikawiyarɨwakai","poem":1},{"text":"nenierika nepɨka'uti'awietaxɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yawé naimekɨmɨyɨwe matsi mɨnetsiparewiekɨ,","poem":1},{"text":"hatsuaku tixaɨtɨ mekanete'ayeitɨatɨri mepɨkahakɨne.","poem":2},{"text":"'Ayumieme nenierika neputseiriyaxɨ tete mɨtse'i hepaɨ,","poem":1},{"text":"mɨpaɨ nepɨtimate hawaikɨ nepɨkatewiyatsitɨarieni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne'aurie hurawa kaniuyeikani kemɨ'ane nehetsie mɨtanuani.","poem":1},{"text":"¿Kemɨ'ane kamɨtsɨ pɨnetsitaniukimani?","poem":2},{"lineBreak":true},{"text":"Kehamieni nehetsɨa.","poem":2},{"text":"¿Kemɨ'ane pɨnetsixaneta?","poem":1},{"text":"Kenetsi'utaxaneta kuta.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yawé naimekɨmɨyɨwe kanihɨkɨtɨni mɨnetsiparewie.","poem":1},{"text":"¿Kemɨ'ane pɨnetsi'anutahɨani?","poem":2},{"text":"Yunaitɨ mɨkɨ mepukumawere,","poem":1},{"text":"'ixuriki mutaxɨ tepaxietɨ hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"¿Kemɨ'ane xeme Yawé payemakaxe","poem":1},{"text":"meta kemɨ'ane xeme tiyu'uximayatsiriwame peu'enie?","poem":2},{"text":"Tsepanetɨ yɨwikɨta mumie,","poem":1},{"text":"'etsiwa tɨma kahekɨariwiyarietɨ,","poem":2},{"text":"Yawé hetsie yuri keti'erieka,","poem":1},{"text":"meta Kakaɨyari hetsie ketiwiyani.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Peru xeme tai xemukutaiya","poem":1},{"text":"meta 'utsi xemuti'ɨwe,","poem":2},{"text":"kɨmana xeyukɨxirietɨ xemuhunikɨ,","poem":1},{"text":"xemitaiyatɨka xehekɨariwiyakaku.","poem":2},{"text":"'Ayumieme nepɨxe'anunɨ'airieni:","poem":1},{"text":"'uximatɨarika waɨkawa, mana xepɨkwini.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/49.json","previousChapterAudioLinks":{},"numberOfVerses":11}