{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":51,"content":[{"type":"heading","content":["Wikweitsitɨarika yuheyemekɨ mieme Tsiyuni hetsiemieme"]},{"type":"verse","number":1,"content":[{"text":"«Xeme, mɨtiheitserie xemɨtekuwautɨwe,","poem":1},{"text":"meta Yawé xemukuwautɨwe, xekeneneu'eni.","poem":2},{"text":"'Ai xekeneuxeiya kemɨ'ane hetsie xemɨyekɨ,","poem":1},{"text":"tetexi mɨxixiyatɨka muwati'inieriwa hetsie pemaye'inierie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Apɨrahami xekeneuxeiya, yupaapa,","poem":1},{"text":"meta Tsara, mɨxe'utiniwexɨ.","poem":2},{"text":"Kepauka ne nemenayexei, puyuxaɨtatɨkai,","poem":1},{"text":"peru ne 'aixɨa nepiyuri, mɨtamɨirekɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yurikɨ, Yawé Tsiyuni kaninɨtɨamɨkɨ,","poem":1},{"text":"mɨti'u'uni naime katininɨtɨamɨkɨ.","poem":2},{"text":"Makumawe 'Ereni kanayeitɨamɨkɨ,","poem":1},{"text":"Yawé yuharaweri pɨtawewieni kwie makuwakitsie.","poem":2},{"text":"Mana temawierika pɨtixuawere,","poem":1},{"text":"pamɨpariyutsi meta kwikari nɨawari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"»Xekeneneu'eni, neteɨterima,","poem":1},{"text":"xekeneneu'eni, nuiwari nehetsɨa mieme:","poem":2},{"text":"nehetsie kaniyeyeimɨkɨ 'ɨkitɨarika,","poem":1},{"text":"meta 'aixɨa mɨti'ane hekɨariya kanihɨkɨtɨkamɨkɨ nuiwarite wahetsiemieme.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Ari kanehurani tita mɨtiheitserie,","poem":1},{"text":"newikweitsitɨarika 'ari 'ukanamieni,","poem":2},{"lineBreak":true},{"text":"netɨrɨkariya 'aixɨa puwayurieni nuiwarite.","poem":2},{"text":"Hatetsita 'ateewa memukutetɨka nehetsie yuri mepɨte'erie,","poem":1},{"text":"netɨrɨkariyatsie mepɨta'ikwewa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Teikɨ muyuawitsie xekeneutinenieri,","poem":1},{"text":"meta kwie xekeneuxeiya:","poem":2},{"text":"muyuawi kɨtsi hepaɨ pukumawere,","poem":1},{"text":"kwie 'ixuriki hepaɨ pɨtaxɨni,","poem":2},{"lineBreak":true},{"text":"meta xaipɨtsi wahepaɨ mana kiekatari meputekwini.","poem":2},{"text":"Peru newikweitsitɨarika yuheyemekɨ puxuaweni,","poem":1},{"text":"peru mɨtiheitserie nehetsɨa mieme hatsuaku pɨkaheuyeweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"»Xekeneneu'eni, xeme tita mɨtiheitserie xemɨtemate,","poem":1},{"text":"teɨteri ne'inɨari niukiyari yu'iyaritsie xemɨye'ɨna:","poem":2},{"text":"Teɨteri 'axametexekɨhɨawekaku xepɨkamamaka,","poem":1},{"text":"meta xepɨka'utiweranareni mexe'anutate'akaku,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kɨpi kaniwatikwaimɨkɨ 'ixuriki mɨtikwa'a hepaɨ,","poem":1},{"text":"kwitsi kaniwatikwaimɨkɨ muxa huxarieya kemɨtikwa'a hepaɨ.","poem":2},{"text":"Peru tita mɨtiheitserie nehetsɨa mieme yuheyemekɨ puxuaweni,","poem":1},{"text":"newikweitsitɨarika, yuheyemekɨ pɨka'uye'atɨkani».","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kenanutanieri, Yawé tɨrɨkariyaya.","poem":1},{"text":"Kenanutanieri, tɨrɨkariya kamixayari kenanakatɨki.","poem":2},{"text":"Kenanutanieri meripaitɨ hepaɨ,","poem":1},{"text":"meripaitɨ memu'uwakai wahepaɨ.","poem":2},{"text":"¿'Ekɨ pekatiuyuri Xahawi pemutaxite,","poem":1},{"text":"meta hapa kiekame pemanuyetse?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"¿'Ekɨ pekatiuyuri haramara pemakawatsiɨxaxɨ,","poem":1},{"text":"haramara 'amatiyewa?","poem":2},{"text":"¿Haramara tetɨata huye pemutawewi","poem":1},{"text":"mana memɨkɨnekɨ pemɨwarutawikweitsitɨa?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yawé kemɨ'ane wahetsiemieme mɨrayukatua mepɨ'axɨani,","poem":1},{"text":"Tsiyuni mepeutahaxɨani me'utikwitɨ,","poem":2},{"lineBreak":true},{"text":"temawierika yuheyeme mieme mepɨpitɨarieni.","poem":2},{"text":"Temawierika waɨkawa mepexeiyani,","poem":1},{"text":"kukuiniya mepɨkahexeiyani meta 'ukai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Ne nekanihɨkɨtɨni kemɨ'ane nemɨwanɨtɨa.","poem":1},{"text":"¿Kemɨ'aneta 'ekɨ pepɨhɨkɨ, teɨteri pemɨwarayemakaxe,","poem":2},{"lineBreak":true},{"text":"memɨkwiwawe, tupiriya mehɨkɨtɨme?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"¿Yawé pepatɨmai, mɨmatsi'utawewi,","poem":1},{"text":"muyuawi mutaweraxɨ meta kwie mukama?","poem":2},{"text":"¿Pematɨ tukarikɨ 'apetiuyeikani","poem":1},{"text":"mɨmatsi'aye'unie haxɨayakɨ","poem":2},{"lineBreak":true},{"text":"muyuwaɨriya mɨraka'unakɨ?","poem":2},{"text":"Peru, ¿hakewa peyuhayewaxɨ mɨkɨ haxɨaya?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kwitɨwa mepɨtixɨnarieni pɨretsutsixi,","poem":1},{"text":"kiita me'aye'utɨ mepɨkakwini,","poem":2},{"lineBreak":true},{"text":"meta paa meheuyehɨatɨ mepɨkahakɨne.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ne Yawé nemɨhɨkɨkɨ 'akakaɨyari,","poem":1},{"text":"ne haramara neputayuitɨwa, hamewarieya putixiuwarɨka,","poem":2},{"lineBreak":true},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye nekatinitewaka.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Neniuki 'ateta nekameniupitɨani","poem":1},{"text":"meta nemamá 'etɨrieyatsie pekaniyeweni,","poem":2},{"text":"muyuawi 'anepuyema meta kwie nepukama,","poem":1},{"text":"meta Tsiyuni mɨpaɨ nepɨrahɨawe: “'Ekɨ nekiekari pepɨhɨkɨ”».","poem":2}]},{"type":"heading","content":["Kakaɨyari haxɨaya tekɨxiyari"]},{"type":"verse","number":17,"content":[{"text":"Kenanutanieri, Kerutsareme, kenanutanieri.","poem":1},{"text":"'Ekɨ kenanukukexi, Yawé mamayatsie","poem":2},{"lineBreak":true},{"text":"haxɨa tekɨxiyari pemanu'i,","poem":2},{"text":"'ekɨ, tekɨxieya naime pemanɨxɨ","poem":1},{"text":"'iya tekɨxi teɨteri muwaratixɨrɨwa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yunaitɨ tɨɨri pemɨwarayexei,","poem":1},{"text":"nixewitɨ mɨkɨ pɨkamatsi'anukuwitɨ,","poem":2},{"text":"tɨɨri pemɨwarutiwaweriyaxɨ,","poem":1},{"text":"nixewitɨ mɨkɨ pɨkamatsi'anukuha.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"'Ikɨ tihutatɨ 'axamɨmetiyurie 'ahetsie katiniu'axɨani:","poem":1},{"text":"pemakumaweriyarienikɨ meta pemɨka'unarienikɨ, haaka meta 'ixipara.","poem":2},{"text":"¿Kemɨ'ane pɨmatsitinenimayata?","poem":1},{"text":"¿Kemɨ'ane pumatsinɨtɨani?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"'Aniwema mekaniukwinitɨma,","poem":1},{"text":"tsipuri yeutari wahepaɨ winiyaritsie,","poem":2},{"lineBreak":true},{"text":"kaye'utɨma 'itsikina mekaniukaxɨrieni.","poem":2},{"text":"Yawé haxɨaya wahetsie katininakeni,","poem":1},{"text":"meta Kakaɨyari kemɨtiwaraye'uxiwe'erie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"'Ayumieme 'ikɨ ketineu'eni, 'ekɨ pemɨyuhiwerie,","poem":1},{"text":"pemɨtawe, winu peka'ietɨ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yawé 'ahetsɨa mumieme 'ipaɨ kanaineni meta 'akakaɨyari,","poem":1},{"text":"'akakaɨyari, maniuka yuteɨterima wahetsiemieme:","poem":2},{"text":"«'Amamatsie nekamaniunawairieni,","poem":1},{"text":"tekɨxi mɨmatsi'anutawaitɨakai.","poem":2},{"text":"Mɨkɨ tekɨxita nehaxɨa muyema,","poem":1},{"text":"hawaikɨ tawarita pepɨka'enu'ieni.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kemɨ'ane memɨmatsi'uximatɨa wamamatsie nepekeni,","poem":1},{"text":"'iya mɨpaɨ memɨmate'utahɨawixɨ wahetsie:","poem":2},{"text":"“Kwiepa keneuhu'i","poem":1},{"text":"'ahetsie temuyekɨnekɨ”.","poem":2},{"text":"Hikɨ kwiepa peheumu'utɨ pekatiniuhuni,","poem":1},{"text":"yunaitɨ kwiepa memɨtama memɨmatsitaketsinikɨ».","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":23}