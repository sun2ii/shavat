{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":52,"content":[{"type":"verse","number":1,"content":[{"text":"Kenanutanieri, Tsiyuni, kenanutanieri.","poem":1},{"text":"Tɨrɨkariya kenanakatɨki.","poem":2},{"text":"Kerutsareme, kiekariyari pemɨpatsie,","poem":1},{"text":"'akamixa witsimɨ'ane kenanakatɨki,","poem":2},{"text":"kemɨ'ane xitekiya 'inɨariyari memɨkahexeiya meta kemɨ'ane memɨka'itiyatɨka,","poem":1},{"text":"'ahetsie tawari mepɨkaheutahaxɨani.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kerutsareme keneuyutakwiepi.","poem":1},{"text":"Kenanukukexi, 'a'uwenitsie kenenua.","poem":2},{"text":"'Akɨipitɨa tepɨa kaunariyari maka kenewaxɨna,","poem":1},{"text":"tsiyuni niweya 'uka pemanutahɨiya.","poem":2}]},{"type":"verse","number":3,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«Xeme nitixaɨtɨkɨ xepɨkate'utuiya,","poem":1},{"text":"'ayumieme tuminikɨ xepɨkaxɨnarieni».","poem":2}]},{"type":"verse","number":4,"content":["Yawé naimekɨmɨyɨwe mɨpaɨ kanaineni:",{"text":"«Meripaitɨ manuyetɨatsie,","poem":1},{"text":"neteɨterima 'Ekipitu mepekɨ mana mepɨtitekai,","poem":2},{"text":"'imatɨrieka 'ikɨ tukaritsie,","poem":1},{"text":"'Atsiriya pɨtiwa'uximayatsitɨa yakɨ xeikɨa».","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yawé mɨpaɨ kanaineni:","poem":1},{"text":"«¿'Ena ne kenetiyuriene?","poem":2},{"text":"Neteɨterima yakɨ mepɨwarehapa,","poem":1},{"text":"tewa'aitɨwamete mepɨwananaima.","poem":2},{"text":"Meta tukarikɨ","poem":1},{"text":"nehetsiemieme 'axameputiyuane.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Ayumieme neteɨterima kenemɨtitewa mepɨnetsihetimani,","poem":1},{"text":"'iya tukaritsie mɨpaɨ mepɨtehetimani","poem":2},{"lineBreak":true},{"text":"ne nemɨhɨkɨkɨ mɨpaɨ nemutaine: “'Ena nepuwe”».","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Witsipɨ'anene 'ɨkateya kemɨ'ane","poem":1},{"text":"niuki 'aixɨa manuyɨne mukuxata hɨritsie,","poem":2},{"text":"kemɨ'ane “kayuwatɨ mumakakɨ” mukuxata,","poem":1},{"text":"kemɨ'ane niuki 'aixɨa manɨyɨne mukuxata,","poem":2},{"text":"kemɨ'ane wikweitsitɨarika mukuxata,","poem":1},{"text":"kemɨ'ane Tsiyuni mɨpaɨ mɨrahɨawe: «'Akakaɨyari pɨti'aita».","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Keneu'ena. Matsihɨwemete meputihiwa,","poem":1},{"text":"yunaitɨ temawierikakɨ meputihiwa,","poem":2},{"text":"yɨhɨxikɨ memixeiyakɨ","poem":1},{"text":"Yawé Tsiyuni kaniye'amɨkɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kerutsareme mu'uni,","poem":1},{"text":"xekenekwikani temawierika kwikariyari.","poem":2},{"text":"Yawé yuteɨterima muwarɨnɨtɨakɨ,","poem":1},{"text":"Kerutsareme mutawikweitsitɨakɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yawé yutɨrɨkariya matsiɨkɨme kanayeitɨamɨkɨ","poem":1},{"text":"yunaime nuiwarite wahɨxie,","poem":2},{"text":"meta yunaitɨ kwie manu'axe kiekatari","poem":1},{"text":"takakaɨyari wikweitsitɨarikaya mepɨxeiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Xeme, Yawé tipiiniteya xemɨte'u'ikata,","poem":1},{"text":"xekenewayekɨni.","poem":2},{"text":"Xeketeneuku'eiri, xekeneuyu'iti.","poem":1},{"text":"Tixaɨtɨ mɨkati'itiya xepɨkatekumaɨwani.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Perutsɨ mexɨima xepɨkawayekɨkani, xepɨkawayenanautsani,","poem":1},{"text":"Yawé pɨxe'uwitɨxime,","poem":2},{"lineBreak":true},{"text":"'Ixaheri Kakaɨyarieya xehetsie pɨtanuani.","poem":2}]},{"type":"heading","content":["Kemɨtiuka'eniwa meta kemɨra'iwa ti'uximayatame"]},{"type":"verse","number":13,"content":[{"text":"Neuxei, neti'uximayatsiriwame pɨra'iwa,","poem":1},{"text":"'aixɨa pɨtitamatiwa, mariweme payeitɨarieni 'aheutitewametsie payerieni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yumɨiretɨ mepɨhɨxiyani me'ixeiyatɨ,","poem":1},{"text":"'axamɨraka'eriekaikɨ,","poem":2},{"lineBreak":true},{"text":"tewi hepaɨ mɨkatiyuxexeiyakaikɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yaxeikɨata, yumɨiretɨ nuiwarite mepɨhɨxiyani,","poem":1},{"text":"hɨxiena te'aitamete memɨtiniuni mepɨkayɨwekaxɨani,","poem":2},{"text":"tita memɨkate'utaxatɨarie memɨtexeiyakɨ,","poem":1},{"text":"meta mepɨtehetimani tita memɨkate'eniwawekai.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}