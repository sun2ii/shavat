{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":[{"text":"¿Kemɨ'ane taniukitsie yuri pɨtiuta'eri,","poem":1},{"text":"kemɨ'ane Yawé tɨrɨkariyaya puxeiyatsitɨarie?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mɨkɨ hɨxie putawerixɨ yɨrari mɨyɨri hepaɨ,","poem":1},{"text":"makuwakitsie tiwiyatɨ.","poem":2},{"text":"Witsipɨka'anekai meta pɨkamariwekai,","poem":1},{"text":"kemɨtiyuxexeiyakai pɨkaheiwa'anekai","poem":2},{"lineBreak":true},{"text":"meta witsipɨkatiyuxexeiyakai pɨkaheiwe'eriwakai.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Teɨteri mepinanaimakai mepɨka'inaki'eriekai,","poem":1},{"text":"pɨtiukakukuinekai, mɨtiuka'eniwanikɨ pɨ'ayumiemetɨkai.","poem":2},{"text":"Nixewitɨ pɨka'ixeiyamɨkɨkai,","poem":1},{"text":"putixani'eriwaxɨ, mariweme tepɨka'eriekai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Peru yurikɨ takwiniya putitɨ,","poem":1},{"text":"kukuiniya tahetsiemieme punewi,","poem":2},{"text":"peru tame tiukwinitɨarieme teputa'eri,","poem":1},{"text":"Kakaɨyari 'enayewaxɨame teputa'eri meta tixaɨtɨ kareyeitɨame.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Matsi mɨkɨ putsekie 'aitsika temutitsanaxɨakɨ,","poem":1},{"text":"temɨxiki payeitɨarie 'axatemɨte'uyurikɨ,","poem":2},{"text":"mɨkɨ hetsie pɨtiunakixɨ mɨtikwinitɨarienikɨ, kemɨraye'akai kayuwatɨ temu'uwanikɨ,","poem":1},{"text":"pamɨpariyutsi mɨtiukwinitɨariekɨ kɨmana 'aixɨa teteheu'erietɨ tepayeitɨarie.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Teyunaitɨ tepeuyexɨriekai, muxatsi wahepaɨ,","poem":1},{"text":"teyuxexuitɨ tepu'uwakai kemɨtatinake,","poem":2},{"text":"peru Yawé hetsiena pɨtiɨhɨa","poem":1},{"text":"naime 'axatemɨte'uyurikɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Pɨtiukwinitɨarie, nitixaɨtɨ pɨkarayeitɨarie,","poem":1},{"text":"peru 'etsiwatɨma pɨka'utaniu,","poem":2},{"text":"muxa nunutsi hepaɨ, pehanie memierienikɨ,","poem":1},{"text":"muxa 'uka mɨxikie hepaɨ, pɨka'utatsua,","poem":2},{"lineBreak":true},{"text":"meta 'etsiwatɨma pɨka'utaniu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hikɨ me'iwiyakari meta me'itaxanetaka, mekanimieni,","poem":1},{"text":"xewitɨ pɨkayuti'iyaritɨa nuiwarieya hepaɨtsita mukumawerekɨ.","poem":2},{"text":"Kanawitekieni 'ena kwiepa teɨteri memanu'uwatsie,","poem":1},{"text":"kaniukuweiyaxɨani teɨteri 'axamemɨte'uyurikɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Pukateukie 'axateyuruwamete watsata,","poem":1},{"text":"meta pumierie 'axateyuruwamete wahamatɨa,","poem":2},{"text":"tsepa hatsuaku 'axamɨkatiuyuri,","poem":1},{"text":"meta nanaimarika tetana mɨka'utixuawerixɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Peru Yawé puyuwaɨri temɨxiki meyeitɨanikɨ meta mɨtika'enitsitɨanikɨ,","poem":1},{"text":"matsi mɨkɨ yutukari 'itiya mawariyari mayeitɨakɨ,","poem":2},{"text":"yunuiwari puwaxeiya, tukari waɨkawa pɨpitɨarieni,","poem":1},{"text":"meta yapɨtiyurieneni Yawé kemɨtinake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Arikeke tikwineme,","poem":1},{"text":"hekɨariya kanixeiyamɨkɨ meta 'iyarieya 'aixɨa kaniyɨmɨkɨ,","poem":2},{"text":"mɨrakumatekɨ","poem":1},{"text":"neti'uximayatsiriwame heitserie mexeiya heitserie kaniwapitɨamɨkɨ yuwaɨkawame,","poem":2},{"lineBreak":true},{"text":"'axamemɨte'uyurikɨ pɨranukɨtɨni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"'Ayumieme, nepipitɨani mariwemekɨ mɨti'aitanikɨ,","poem":1},{"text":"piinitɨarika mɨra'iwaxɨ memɨtɨrɨkawi wahamatɨa pɨtiyetuiriyarieni,","poem":2},{"text":"yutukari mɨyetuakɨ tsepa mumierie,","poem":1},{"text":"'axatiyuruwame payeitɨarie.","poem":2},{"text":"Yumɨiretɨ ke'axamemɨte'uyuri putitɨ,","poem":1},{"text":"'axateyuruwamete wahetsie putanua.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/52.json","previousChapterAudioLinks":{},"numberOfVerses":12}