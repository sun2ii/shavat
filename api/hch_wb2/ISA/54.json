{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":54,"content":[{"type":"heading","content":["Tsiyuni 'arike kemɨtimariweni"]},{"type":"verse","number":1,"content":[{"text":"«'Ekɨ 'ukaratsi hatsuaku pemɨkatiniwewe,","poem":1},{"text":"keneutahiwani temawierikakɨ.","poem":2},{"text":"'Ekɨ, hatsuaku niweyame kukuiniyaya pemɨkamate,","poem":1},{"text":"keneutakwikani meta keneutahiwani temawierikakɨ.","poem":2},{"text":"'Ukaratsi muku'eiriwaxɨ matsi waɨkawa tɨɨri warexeiyatɨ kanayeimɨkɨ,","poem":1},{"text":"mɨwikie kemɨkatiwarexeiya","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"»'Axamaru 'akeneutayeuriya,","poem":1},{"text":"'ixuriki meɨwɨ 'akiita keneɨxɨnaxɨa.","poem":2},{"text":"Hawaikɨ peheuye'atɨkaitɨ pepɨkahayuyeitɨwani.","poem":1},{"text":"'Akaunari 'akeneutitɨriya, 'akɨtsunute kwi keneuka'uitɨa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Karikɨ 'atserieta meta 'a'utata pekanitawerimɨkɨ,","poem":1},{"text":"'anuiwarite hipame nuiwarite waɨkawa mepuwara'iwa,","poem":2},{"lineBreak":true},{"text":"kiekaritetsie hikɨ makumamawe mana mepɨyutikiitɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"»Pepɨkamaka,","poem":1},{"text":"hatsuaku pepɨkatewiyatsitɨarieni.","poem":2},{"text":"Pepɨkayu'iyaritɨaka,","poem":1},{"text":"hatsuaku nitixaɨtɨ petihɨkɨtɨtɨ pepɨkahayeitɨarieni.","poem":2},{"text":"Pemɨ'ɨimaritɨkaitsie mieme tewiyarika pepatɨmaiya,","poem":1},{"text":"meta tawariri pemɨwiuratɨkaitsie 'axapemɨtikɨhɨawarɨwakai pepɨkahaye'erieni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kemɨ'ane mɨmatsi'utawewi mɨkɨ kani'akɨnatɨni,","poem":1},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye katinitewaka.","poem":2},{"text":"Matsiwikweitsitɨwame kanihɨkɨtɨni Mɨpatsie 'Ixaheri hetsiemieme,","poem":1},{"text":"naime kwie Kakaɨyarieya katinitewaka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yawé kamanitahɨawimɨkɨ","poem":1},{"text":"'ukaratsi 'eiriwakame hepaɨ,","poem":2},{"text":"'ukaratsi tiuka'eniwatɨ muyu'iyaritɨa hepaɨ,","poem":1},{"text":"'uka wikiekame 'etsiyumaitɨ mutiwiki hepaɨ","poem":2},{"lineBreak":true},{"text":"mɨtixani'eriwakɨ xeikɨa","poem":2},"―'akakaɨyari mɨpaɨ kanaineni―."]},{"type":"verse","number":7,"content":[{"text":"Nepɨmatsi'uku'eiri yatewimekɨ xeikɨa,","poem":1},{"text":"peru waɨkawamekɨ nematsinenimayatɨ","poem":2},{"lineBreak":true},{"text":"tawarita 'ahetsɨa nepunuani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yatewimekɨ xeikɨa, ne'uyeha'aka,","poem":1},{"text":"nepɨkamatsixeiyamɨkɨkai,","poem":2},{"text":"peru yuheyemekɨ nematsinaki'erietɨ","poem":1},{"text":"nepɨmatsitinenimayata","poem":2},"―Yawé mɨpaɨ kanaineni, Matsiwikweitsitɨwame―."]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"»Kepauka Nuhexi 'amuyeikakai hepaɨ nepaine,","poem":1},{"text":"kepauka nemɨyuhɨritɨa kename haa","poem":2},{"lineBreak":true},{"text":"hatsuaku kwie kakayunitɨanikekai.","poem":2},{"text":"Hikɨ mɨpaɨ nekatiniyuhɨritɨaka tawariri nepɨkamatsiyeheka,","poem":1},{"text":"meta tawariri nepɨkamatsitatieni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tsepa hɨrite muyupataxɨa,","poem":1},{"text":"meta tsepa hɨrite 'etsimɨtɨtɨ mɨtiwatayuatɨka,","poem":2},{"text":"hatsuaku nematsinaki'erietɨ nepukatihayewa,","poem":1},{"text":"meta netɨratu kayuwatɨ 'amuyeikanikɨ mɨ'ayumieme nepɨkatananaimani,","poem":2},{"lineBreak":true},{"text":"—Yawé mɨpaɨ kanaineni, mɨmatsinenimaya—.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"»Neuxei 'ekɨ, kiekari pemuyuhiwerie,","poem":1},{"text":"pemɨmariutsie meta pemɨkanɨtɨarie.","poem":2},{"text":"Yuawitɨ tsiɨraɨyemekɨ nepumatsitakeni,","poem":1},{"text":"meta tetexi yuawimekɨ mukutuxie hekɨ 'atenari nepɨkatsutɨani.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tetexi mɨxetakɨ 'atetsariya nepatiwewiexɨani,","poem":1},{"text":"tetexi mɨxawawatɨkɨ 'a'itupari nepɨtiwewieni,","poem":2},{"lineBreak":true},{"text":"meta tetexi witsimɨ'anenekɨ 'akuraru nepawewietɨyani.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yawé 'aniwema yunaime kaniwata'ɨxatsitɨamɨkɨ,","poem":1},{"text":"yemekɨ 'aixɨa 'anemekɨ mepɨtiteni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mɨtiheitseriekɨ pepɨtseiriyarieni,","poem":1},{"text":"waɨriyarika pepɨkati'aitɨarieka,","poem":2},{"lineBreak":true},{"text":"meta nitixaɨtɨ pepɨkarayemakaka,","poem":2},{"text":"pepɨkamaka,","poem":1},{"text":"meta hatsuaku pepɨkatimani.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Xɨka xewitɨ matsimiemɨkɨni,","poem":1},{"text":"ne nepɨkatiyurieneni,","poem":2},{"text":"kemɨ'ane mumatsitamieni","poem":1},{"text":"'ahɨxie kanikawemɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"»Neuxei, ne tepɨakɨ tiwewiwame nekaniunetɨani,","poem":1},{"text":"tɨɨ 'anutataiyatɨ mɨti'uximaya,","poem":2},{"lineBreak":true},{"text":"tepɨa tiyumemiwame mɨtiwewiwa xexuitɨ kemɨtiyuruwametetɨni.","poem":2},{"text":"Neta nekaninetɨani tiyuka'uname","poem":1},{"text":"muwaruka'unanikɨ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tsepa tepɨa matsimemiwame 'ahetsiemieme mutawewiya yapɨkatiyurieni,","poem":1},{"text":"kemɨ'ane mɨmatsixanetani mɨkɨ tenieyatsie pepuwiere.","poem":2},{"text":"'Ikɨ kanihɨkɨtɨni te'uximayatamete memɨte'ukuhayewiyarie,","poem":1},{"text":"tita mɨtiheitserie nehetsie mɨyetɨa","poem":2},"―Yawé mɨpaɨ kanaineni―."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":17}