{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":55,"content":[{"type":"heading","content":["Memeuhariku kememɨte'inierie"]},{"type":"verse","number":1,"content":[{"text":"»Xekenakɨni haa mayema","poem":1},{"text":"yunaitɨ kemɨ'ane xemeuhariku.","poem":2},{"text":"Xekenakɨni xeketenananaiyu meta xeketenakwaiyu","poem":1},{"text":"kemɨ'ane tumini xemɨka'umana.","poem":2},{"text":"Xekenakɨni, winu xekeneunanai meta retsi","poem":1},{"text":"xekateyutuatɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"¿Titayari tumini xetexɨtɨa paa kahɨkɨtɨmetsie,","poem":1},{"text":"meta yu'iwarika tita mɨkatihuxaiyatsie?","poem":2},{"text":"'Aixɨa xekeneteneu'eni, xekatenitikwaikuni tita 'aixɨa mɨti'ane,","poem":1},{"text":"meta 'aixɨa xekateniku'eriwakuni witsira'aneme xetekwatɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kayuwatɨ xekeneneu'eni, nehetsɨa xekeneu'axɨa,","poem":1},{"text":"xekeneneu'eni, 'axekaniu'uwakuni.","poem":2},{"text":"Xehamatɨa tɨratu nepɨwewieni yuheyemekɨ mieme,","poem":1},{"text":"Rawiri nemɨnaki'eriekɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne nepenukake teɨteri wahetsiemieme munierixɨ mɨhɨkɨtɨnikɨ,","poem":1},{"text":"wa'ukiyari mɨmariwe hepaɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mɨpaɨ pepɨtiyurieni hipame nuiwarite pekaniwata'inimɨkɨ,","poem":1},{"text":"pemɨkawamatekai,","poem":2},{"text":"meta nuiwarite memɨkamatsimatekai","poem":1},{"text":"'ahepa mepɨtinautsa,","poem":2},{"text":"pamɨpariyutsitsɨ Yawé 'akakaɨyari,","poem":1},{"text":"Mɨpatsie 'Ixaheri hetsiemieme,","poem":2},{"lineBreak":true},{"text":"waɨkawa 'aixɨa petixeiyariekame mɨmatsi'ayeitɨa».","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yawé xekeneutiwawa mexi yuwaɨriya xemikaxeiyakɨ,","poem":1},{"text":"xekeneutahɨawi mexi 'ahurawa 'uyeika.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Axatiyuruwame yuhuye ke'uku'eirieni,","poem":1},{"text":"meta 'axamɨtiyuriene 'axatiku'eriwatɨ ketiuhayewa.","poem":2},{"text":"Yawé hetsɨa kenuani, takakaɨyari hetsɨa,","poem":1},{"text":"mɨkɨ puyuwaɨriya mɨreuyehɨwirienikɨ,","poem":2},{"lineBreak":true},{"text":"nenimayatsikaya hetsiena pɨtinake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"«Karikɨ xeme kexemɨteku'eriwa ne mɨpaɨ nepɨkatiku'eriwa,","poem":1},{"lineBreak":true},{"text":"kexemɨte'u'uwa ne mɨpaɨ nepɨkatiuyeika","poem":1},"―Yawé mɨpaɨ kanaineni―."]},{"type":"verse","number":9,"content":[{"text":"Nehuye meta kenemɨtiku'eriwa","poem":1},{"text":"matsi 'apeutitetewa keyuri xehuye meta kexemɨteku'eriwa,","poem":2},{"lineBreak":true},{"text":"matsi waɨkawa peutitewa keyuri muyuawitsie kemeutitewa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wiyeri meta 'ɨwi muyuawitsie","poem":1},{"text":"kemɨrakaneika,","poem":2},{"text":"kwitɨwa pɨka'anutinunuwa kwiepa kakahatuawetɨ,","poem":1},{"text":"mɨtiyɨratɨakakɨ,","poem":2},{"text":"kemɨ'ane muka'etsa 'imɨari mexeiyanikɨ","poem":1},{"text":"meta paa mexeiyanikɨ kemɨ'ane mɨtikwa'a,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"mɨpaɨta pɨ'ane neniuki neteta mayeneika:","poem":1},{"text":"Nehetsɨa pɨkanuani 'atsikatiyuriwetɨ,","poem":2},{"text":"matsi yapɨtiyurieni meri kemɨnetinake,","poem":1},{"text":"pɨraye'atɨani kenemɨtiku'eriwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xeme xepayekɨne xeyutemamawietɨ","poem":1},{"text":"meta xepanuwitɨkieni yuhuyeta kayuwatɨ.","poem":2},{"text":"Xe'uhukaku, hɨri 'etsimɨtɨtɨ meta 'amɨtɨtɨ","poem":1},{"text":"mepɨtihiwa karima meyutemamawietɨ,","poem":2},{"lineBreak":true},{"text":"meta mepɨtetapini yunaitɨ kɨyexi yeuta miemete.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Ɨtsi muxuyatɨka hetsiemieme huku mɨxexeurawi pɨtiwawere,","poem":1},{"text":"kieká hetsiemieme tsikwai kanitixuawerimɨkɨ.","poem":2},{"text":"'Ana Yawé 'aixɨa pɨtitahɨawarieni,","poem":1},{"text":"mɨkɨ 'inɨarieya payani yuheyemekɨ».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}