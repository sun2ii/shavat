{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":56,"content":[{"type":"heading","content":["Wikweitsitɨarika hipame wahetsiemieme"]},{"type":"verse","number":1,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«Tita mɨtiheitserie xeketenexeiyani,","poem":1},{"text":"heitseriemekɨ yaxeketeneu'uwaniri,","poem":2},{"text":"newikweitsitɨarika 'ari kaninuaximeni,","poem":1},{"text":"mɨtiheitserie nehetsɨa mieme matsiɨkɨtɨ kanayeimɨkɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Aixɨa ke'itɨarieka kemɨ'ane mɨpaɨ mɨtiuyeika,","poem":1},{"text":"kemɨ'ane yu'iyarikɨ meye'atɨa,","poem":2},{"text":"kemɨ'ane 'uxipiya tukari ma'eriwa kapatsiekame ka'ayeitɨatɨ,","poem":1},{"text":"kemɨ'ane mɨyɨ'ɨwiya 'axamɨkatiyurienenikɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"'Ateewa kiekame yɨkɨmana","poem":1},{"text":"Yawé hetsie mɨtiwiyanikɨ muyuyetua mɨpaɨ pɨka'utaineni:","poem":2},{"lineBreak":true},{"text":"«Yawé yuteɨterima watsata pɨnetsi'anuyeweiya».","poem":2},{"text":"Meta ti'aitame ti'uximayatsiriwame mɨkaneɨke mɨpaɨ pɨka'utaineni:","poem":1},{"text":"«Kɨye muwaki xeikɨa nepɨhɨkɨ».","poem":2}]},{"type":"verse","number":4,"content":["Karikɨ Yawé mɨpaɨ kanaineni:",{"text":"«Teɨteri te'aitame te'uximayatsiriwamete memɨkaneneɨke","poem":1},{"text":"xawati 'uxipiya tukariyari mema'eriwa,","poem":2},{"text":"yameketeyurieka kemɨnetinake,","poem":1},{"text":"netɨratutsie meketewiyani,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ne yanepɨtiyurieni kememɨtetetewa mema'utsienikɨ","poem":1},{"text":"netukita meta nekiekaritsie,","poem":2},{"lineBreak":true},{"text":"mɨpaɨ matsi 'aixɨa pɨ'ane tɨɨri 'ukitsi 'ukari keyuri mewarexeiyatɨ.","poem":2},{"text":"Meta nepɨwatiterɨwa yuheyemekɨ miemekɨ","poem":1},{"text":"mɨkɨ hatsuaku pɨkahakayeitɨarieni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Ateewa kiekatari Yawé hetsɨa memu'axɨa","poem":1},{"text":"memɨte'i'uximayatsiriekakɨ,","poem":2},{"text":"Yawé memɨnaki'eriekakɨ,","poem":1},{"text":"meta memeyexeiyanikɨ,","poem":2},{"text":"yunaitɨ mɨkɨ 'uxipiya tukari mema'eriwa kapatsiekame meka'ayeitɨatɨ,","poem":1},{"text":"meta netɨratutsie yamemɨtekahu,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"nehɨri mɨpatsietsie nekaniwaranutiwitɨmɨkɨ,","poem":1},{"text":"nenenewieri kiiyarita temawierika waɨkawa nepɨwapitɨani.","poem":2},{"text":"Nepitanaki'erieni mawari taiyariyari meta hipame mawarite","poem":1},{"text":"memitimawani nemawari taiyametsie,","poem":2},{"text":"nekiitsɨ mɨpaɨ katinitewakamɨkɨ","poem":1},{"text":"nenewieri kiyari yunaitɨ teɨteri wahetsiemieme».","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yawé mɨpaɨ kanaineni naimekɨmɨyɨwe,","poem":1},{"text":"kemɨ'ane muwakuxexeɨriwa 'ixaheritsixi memeutaweiyariexɨa:","poem":2},{"text":"«Neteɨterima nepɨwakuxeɨrieni hipame teɨteri meyunɨkame,","poem":1},{"text":"meta 'akuxi hipame nemuwarukuxeɨri».","poem":2}]},{"type":"heading","content":["Kakaɨyari kemɨtiwaxaneta 'axateyuruwamete"]},{"type":"verse","number":9,"content":[{"text":"Yeutari meta teyukwa'amete 'ɨtsita miemete,","poem":1},{"text":"xeyunaitɨ xekenakɨni xeketeniwarutikwa'i.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yunaitɨ 'ixaheritsie memɨtetahɨ mepɨkaheuneniere,","poem":1},{"text":"nixewitɨ mɨkɨ pɨkatimate.","poem":2},{"text":"Yunaitɨ mɨkɨ tsɨikɨri memɨkaniuwawe mepɨhɨkɨ,","poem":1},{"text":"memɨka'utihe'ewa.","poem":2},{"text":"Mepuhe xeikɨa meteheinɨtɨ,","poem":1},{"text":"mukutsuni puwanake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tsɨikɨri kwinie memɨteyukwaiwawie mepɨhɨkɨ,","poem":1},{"text":"hatsuaku mepɨkahuxaiwawe.","poem":2},{"text":"Muxatsi wahɨwemete mekanihɨkɨtɨni 'atsimekateheitimaitɨkɨkatɨ,","poem":1},{"text":"yuxexuitɨ kemɨtiwanake xeikɨa mekaniu'uwani.","poem":2},{"text":"Nitixaɨtɨ mekateha'eriwatɨ,","poem":1},{"text":"yu'iwarikakɨ xeikɨa mepuyumexɨitɨa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"«Xekenakɨni, winu tepanukuwauni,","poem":1},{"text":"winukɨ tepɨtitarɨweni","poem":2},{"lineBreak":true},{"text":"—yunaitɨ mɨpaɨ mepɨte'uhiwa—.","poem":2},{"text":"'Uxa'ata yaxeikɨa hikɨ hepaɨ tepɨtiyɨni,","poem":1},{"text":"peru matsi waɨkawa».","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}