{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":57,"content":[{"type":"verse","number":1,"content":[{"text":"Heitseriemekɨ 'amuyeika kanimɨmɨkɨ, xewitɨ hetsiena mieme pɨkayu'iyaritɨa,","poem":1},{"text":"te'a'uximayatsiriwamete yamemɨtekahu mekanitakukuweni xewitɨ 'atsipɨkaretimamateke,","poem":2},{"lineBreak":true},{"text":"heitseriemekɨ memu'uwa mekanitakukuweni 'axamɨti'anekɨ memɨkatekwinenikɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kemɨ'ane huye mɨheitserie 'utɨa memuhu kayuwatɨ mehexeiyatɨ mepɨtakukuwe,","poem":1},{"text":"'aixɨa 'iyari mepuka'uxipiwe mɨki 'itarieyatsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«Xeme, 'ukaratsi mutiyukewaiya niwemama,","poem":1},{"text":"'uki 'ukaratsi tuminikɨ muyumayɨinɨa mukumaɨwa niwemama,","poem":2},{"lineBreak":true},{"text":"'ahurawa xekenakɨni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"¿Kemɨ'ane xeme xepɨtehayuriya?","poem":1},{"text":"¿Kemɨ'ane hepaɨtsita xepu'uxiwa'a","poem":2},{"lineBreak":true},{"text":"xe'ikuneniwiyatɨ?","poem":2},{"text":"¿Xeme xekatehɨkɨ 'axaxemɨte'u'iyari,","poem":1},{"text":"te'itawamete nuiwariyari xekatehɨkɨ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tuaxatsata, meta kɨyexi mɨ'e'etɨtɨa,","poem":1},{"text":"ketita xemɨtehiwe'eriekɨ xepɨkayupirenutɨa,","poem":2},{"text":"'aki'utɨa meta 'ai mukatataritsie,","poem":1},{"text":"tɨɨri mepɨwamawatɨwe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tetexi ha'ute 'aki'utɨa mieme","poem":1},{"text":"pemɨtiukuhayewiyarie pɨrayani,","poem":2},{"lineBreak":true},{"text":"yurikɨ, mɨkɨ 'ahetsiemieme pɨrayani.","poem":2},{"text":"Mɨkɨ wahetsie hatseiti peputiyeuri,","poem":1},{"text":"hatsi mawariyari pepɨyetua.","poem":2},{"lineBreak":true},{"text":"Mɨkɨ naime mɨyapemɨtiuyurikɨ, ¿'atsinekatitayɨni?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hɨri 'a'utewimetsie manutimɨtsɨtsie,","poem":1},{"text":"mana paitɨ pepuyuka'utatɨa,","poem":2},{"text":"mana paitɨ pekananutiyani","poem":1},{"text":"pemɨtitimawakɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"'A'itupari warita meta muka'utɨkatsie","poem":1},{"text":"pekatina'utɨani memɨkakaɨyarixi wa'ɨkiyakɨ.","poem":2},{"text":"Pekaneniuku'eirieni, pekaniyutikemaripieni,","poem":1},{"text":"'a'utá pemikawitsie pekananutiyani,","poem":2},{"text":"tɨratu pekaniuwewieni teɨteri wahamatɨa","poem":1},{"text":"kemɨ'ane pemeuhiwe'eriekai hamatɨana pemɨkahunikɨ,","poem":2},{"lineBreak":true},{"text":"meta pepixei maweme.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Muruki hetsɨa pepanɨtɨa, huriwa hatseitiyari pepeihaniri,","poem":1},{"text":"witsimu'ɨatɨka 'ahetsiemieme peputimɨiriyaxɨ.","poem":2},{"text":"'Ateewa pepɨwarenɨ'a 'anɨ'arima,","poem":1},{"text":"meta mɨki teukiyata pepuwareukanɨ'a.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Waɨkawa pekuyeikatɨ peputi'uxixɨ,","poem":1},{"text":"peru mɨpaɨ pepɨka'utayɨ: “'Ena xeikɨa nepɨye'ani”.","poem":2},{"text":"Pepuyɨwekaxɨa tɨrɨkariya waɨkawa pepukaxei,","poem":1},{"text":"'ayumieme pepɨka'u'amɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"»¿Kemɨ'ane pɨmatsi'utimariu,","poem":1},{"text":"kemɨ'ane marika pɨmatsi'upitɨa, titayari penetiu'itai?","poem":2},{"text":"Pepɨkanetsihaye'eri,","poem":1},{"text":"nitixaɨtɨ pepɨkanerayeitɨa.","poem":2},{"text":"¿Xɨari pepɨkanetsimakaxe,","poem":1},{"text":"mɨixa 'atsinemɨka'utayɨkɨ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne nepɨmatsitaxaneta 'aixɨa kepemɨtiyuriene peti'uximayatɨ,","poem":1},{"text":"nitixaɨtɨ pɨkarayani 'ahetsiemieme.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kepauka pemutahiwani parewiya pehawawatɨ,","poem":1},{"text":"'akakaɨyarixi mekematsi'utawikweitsitɨani kemɨ'ane yemekɨ pemɨwaranayexei.","poem":2},{"text":"Mɨkɨ yunaime 'eka kaniwaranu'enitsitɨamɨkɨ,","poem":1},{"text":"xeihɨtsieriyarikɨ mekanikumawerikuni.","poem":2},{"text":"Peru kemɨ'ane nehetsie muyu'awieta","poem":1},{"text":"kwie pɨyetuiriyarieni hetsiena mieme mɨhɨkɨtɨnikɨ","poem":2},{"lineBreak":true},{"text":"meta yukwie kanayeitɨamɨkɨ nehɨrɨ mɨpatsie».","poem":2}]},{"type":"heading","content":["Kememɨtenɨtɨarieni"]},{"type":"verse","number":14,"content":["Mɨpaɨ pɨtitaniukieni:",{"text":"«Xekeneutiwewi, xekeneutiwewi, huye xekeneukuha'arita.","poem":1},{"text":"Xeketenanutaxɨriexɨa neteɨterima wahuyeta mɨtiu'utɨka».","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mɨpaɨ mainekɨ 'amutewi meta mumariwe,","poem":1},{"text":"yuheyemekɨ 'amuyeika, mɨpatsie mɨtitewa:","poem":2},{"text":"«Ne meutitewatsie nekanikiekametɨni mɨpatsietsie,","poem":1},{"text":"Peru yaxeikɨata yu'iyaritsie muyuhiwerie meta tixaɨtɨ mɨkarayuyeitɨa hamatɨa nepuyeika,","poem":2},{"text":"nemɨwatɨrɨkariyanikɨ yu'iyaritsie memɨwerarani","poem":1},{"text":"kemɨ'ane yu'iyaritsie memɨyuhiwerie nepɨwatɨrɨkariya.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yuheheyemekɨ nepɨkamatsixanetani,","poem":1},{"text":"meta yuheyemekɨ nepɨkaha'aka,","poem":2},{"text":"xɨka mɨpaɨ 'anenike nehɨxie yunaitɨ","poem":1},{"text":"memɨte'u'uwa nemuwarutiwewi mekaniukwiwaweni.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Neteɨterima memɨteyukahiwe'eriekɨ nepuyeha'a,","poem":1},{"text":"'axamemɨteyuriekaikɨ,","poem":2},{"text":"ne'uyeha'aka nepɨwaru'uximatɨa,","poem":1},{"text":"nepuwaruku'eiri,","poem":2},{"text":"peru matsi mɨkɨ mepenukuwei","poem":1},{"text":"huye 'axamɨ'anene.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wahuye nepɨxeiya, peru ne 'aixɨa meteheu'eriekame nekaniwarayeitɨamɨkɨ,","poem":1},{"text":"'aixɨa 'anemekɨ nepuwaranuwitɨni, yemekɨ nepuwanɨtɨani.","poem":2},{"text":"Meta memutitsuana wahetsiemieme,","poem":1}]},{"type":"verse","number":19,"content":[{"text":"mɨpaɨ mete'ukwikame nekaniwarayeitɨamɨkɨ:","poem":2},{"text":"Kayuwatɨ mepɨpitɨarieni 'ateewa memu'uwa,","poem":1},{"text":"meta 'ahurawa memu'uwa.","poem":2},{"lineBreak":true},{"text":"Ne 'aixɨa meteheu'eriekame nekaniwarayeitɨamɨkɨ ―Yawé mɨpaɨ kanaineni―,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"peru 'axateyuruwamete haramara muyuane hepaɨ mekani'aneneni,","poem":1},{"text":"kayuwatɨ mutamare mɨkayɨwe,","poem":2},{"lineBreak":true},{"text":"hamewarieya haxu mɨ'atɨwa meta tɨniriya.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"'Axateyuruwamete kayuwatɨ memu'uwani mepɨkayɨwawe ―nekakaɨyari mɨpaɨ kanaineni―.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":21}