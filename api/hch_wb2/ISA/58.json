{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":58,"content":[{"type":"heading","content":["Hakiya yuri mɨhɨkɨ"]},{"type":"verse","number":1,"content":[{"text":"»Keneutahiwa karima, pepɨka'utimamaweni.","poem":1},{"text":"Kwi keneutahiwa kuxineta hepaɨ.","poem":2},{"text":"Neteɨterima keniwarutaxaneta memɨnetsi'aye'uniekɨ,","poem":1},{"text":"'axamemɨte'uyurikɨ, Kakuwu nuiwarimama.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tukarikɨ mekaneniwautɨweni,","poem":1},{"text":"nehuye mepɨmaiku,","poem":2},{"text":"wa'atɨtɨ nuiwari","poem":1},{"text":"heitserie memu'u'uwa mepɨtehɨkɨ,","poem":2},{"text":"wa'atɨtɨ ne'inɨari niukiyari","poem":1},{"text":"mepɨkate'uku'eiri.","poem":2},{"text":"Mepɨnetsiwawirie heitseriemekɨ yanemɨtiyurienikɨ wahetsiemieme,","poem":1},{"text":"puwanake nehepa 'ahurawa memakɨne,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"meta mɨpaɨ xepɨnete'anutahɨawe:","poem":1},{"text":"“¿Titayari teteyuhakie, panatsi 'ekɨ yapera'eriwa?","poem":2},{"lineBreak":true},{"text":"¿Titayari teteyuhiwerieka, panatsi 'ekɨ petatsixeiya?”","poem":2},{"lineBreak":true},{"text":"»Peru kepauka xeme xemuyuhakie,","poem":1},{"text":"xepuyuharerutatɨwe xeikɨa meta yuhetsɨa miemete kwinimieme xepɨtewa'uximayatsitɨa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Xeme xeikɨa xepuyuhakie xeyutikwinike meta xeyutitienike,","poem":1},{"text":"xeyutihutsunike.","poem":2},{"text":"Xɨka xenakeni Kakaɨyari mɨxeta'eiyakɨ,","poem":1},{"text":"xekeneyuhakieka, peru hikɨ xemɨyɨa hepaɨ hawaikɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mɨkɨ hakiya ne nemenayexei xeitukari xeikɨa pɨkamieme para tewi mɨtiuka'eniwanikɨ yuwaiyaritsie,","poem":1},{"text":"manakatutsirekɨ xeikɨa haka hatɨa mieme hepaɨ,","poem":2},{"text":"hiwerika kamixayari manakatɨnikɨ","poem":1},{"text":"meta naxi muyukawirienikɨ.","poem":2},{"text":"Xeme mɨkɨ hakiya xepɨte'uterɨwa,","poem":1},{"text":"meta Yawé tukari minake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"»Hakiya nemanayexei,","poem":1},{"text":"nemuwaxɨnakɨ pɨ'ayumieme kemɨkatiheitserietsie tepɨakɨ memɨhɨatɨka,","poem":2},{"lineBreak":true},{"text":"yuku kwitaxiyari nemɨxɨnakɨ,","poem":2},{"text":"kemɨ'ane waɨriyarika memɨte'aitɨarie nemɨwaxɨnakɨ,","poem":1},{"text":"meta tinaimekɨ memɨtehɨatɨka nemɨwaxɨnakɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hakiya kani'ayumiemetɨni meuhakamɨkɨ hamatɨa pemɨtikwanikɨ,","poem":1},{"text":"meta 'aixɨa pemɨtiwakiitɨanikɨ memɨka'ukii,","poem":2},{"text":"mɨkarekakemari pemɨtikemaritɨanikɨ,","poem":1},{"text":"meta kemɨ'ane 'ahepaɨ memɨ'anene hupemɨkawaraxɨrɨwanikɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Xɨka mɨpaɨ petikamieni,","poem":1},{"text":"'ahekɨariya panatineni tau 'ɨrɨya hepaɨ 'anetɨ,","poem":2},{"lineBreak":true},{"text":"'ana yapauka 'aixɨa pekatinika'erimɨkɨ,","poem":2},{"text":"tita mɨtiheitserie 'ahuye kananutayepimɨkɨ,","poem":1},{"text":"meta Yawé xawatɨriyaya kamenanukuweiyamɨkɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Pepitahɨawe, Yawé pɨmatsita'eiya,","poem":1},{"text":"parewiya pepɨtawauni, mɨkɨ mɨpaɨ pɨtayɨni: “'Ena nekaniuweni”.","poem":2},{"lineBreak":true},{"text":"»Xɨka yuku mahete pehehɨani,","poem":1},{"text":"meta xanetsika metatsiere 'axaniuki,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"xɨka memeuhakakwiku pewaparewieka,","poem":1},{"text":"meta kemɨ'ane tiuka'eniwatɨ mɨreuyehɨwa xɨka petikumikwani,","poem":2},{"text":"'ana yɨwipa 'ahekɨariya kanitaimɨkɨ,","poem":1},{"text":"'atɨkari tuka hepaɨ 'anetɨ kanayeimɨkɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yawé yuheyemekɨ kamenikuwitɨnemɨkɨ,","poem":1},{"text":"pɨmatsihuxaitɨaka kwie makuwakitsie,","poem":2},{"lineBreak":true},{"text":"meta 'a'umeyarite kanititɨrɨkariyamɨkɨ.","poem":2},{"text":"Haraweri 'aixɨa mɨtihatuiyarie pekanayeimɨkɨ,","poem":1},{"text":"haixa pekanayeimɨkɨ mɨka'ukawauke.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"'Ateɨterima kiekari meripaitɨ mieme mu'u'uni 'aixɨa mepɨtiyurieni,","poem":1},{"text":"tenari meripaitɨ mieme mepanukuketɨani,","poem":2},{"text":"“kurarute mu'u'uni 'aixɨa mɨtiyuruwa” pepɨtitewaka,","poem":1},{"text":"meta “huye mɨtikɨnetɨne 'aixɨa yuruwame”.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"»Xɨka xawati tukariyari kapatsiekame pe'ayeitɨatɨ petiuhayewa,","poem":1},{"text":"meta pekayuharerutaneni netukari mɨpatsietsie,","poem":2},{"text":"xɨka xawati “tukari witsimɨ'ane” petiuterɨwani,","poem":1},{"text":"meta xɨka Yawé tukarieya mɨpatsie, “mɨmariwe” petiuterɨwani,","poem":2},{"text":"xɨka kapatsiekame pe'ayeitɨatɨ petiuhayewa,","poem":1},{"text":"meta xɨka pe'eyexeiyani pekayuharerutatɨ,","poem":2},{"lineBreak":true},{"text":"meta niuki tixaɨtɨ mɨkatiyunaki'eriekɨ peka'utaniutɨ,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"hikɨ 'ana Yawé hetsie temawierika pekanikaxeiyamɨkɨ,","poem":1},{"text":"hɨritsie pe'uyeikame kawayutsie pe'anakaime nepɨmatsi'ayeitɨani,","poem":2},{"text":"meta peyutemawiekame nepɨmatsi'ayeitɨani","poem":1},{"text":"'apaapa Kakuwu kwie nemɨyetuiritsie».","poem":2},"Yawé yɨkɨmana mɨpaɨ kanaineni."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/57.json","previousChapterAudioLinks":{},"numberOfVerses":14}