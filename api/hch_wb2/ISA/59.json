{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":59,"content":[{"type":"heading","content":["'Axakemɨtiuyurienikɨ, hekɨatsika meta wikweitsitɨarika"]},{"type":"verse","number":1,"content":[{"text":"Yawé tɨrɨkariyaya","poem":1},{"text":"'etsipɨkatewi mɨratawikweitsitɨanikɨ,","poem":2},{"lineBreak":true},{"text":"meta mɨkaheu'ena pɨkahɨkɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Axaxemɨte'uyuri kanihɨkɨtɨni","poem":1},{"text":"xekakaɨyari hetsɨa 'ateewa mɨxeti'uitɨa.","poem":2},{"text":"Mɨkɨ 'axamɨti'ane katiniyurieneni","poem":1},{"text":"nierikaya meukunama mɨkaxe'eniekakɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Xeme yumamatetsie xepeuxuxure,","poem":1},{"text":"meta yu'itɨwametetsie 'axamɨti'anekɨ xepɨteheuwetɨka.","poem":2},{"text":"Xeteni 'itarika pɨtikuxata,","poem":1},{"text":"meta xeneni 'axa'anemekɨ pɨtikuxata.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nixewitɨ pɨkahahiwa tita mɨtiheitserie rawawatɨ,","poem":1},{"text":"nixewitɨ yuri mɨrainekɨ pɨkarataxaneta.","poem":2},{"text":"'Itarikatsie xepɨtewiya,","poem":1},{"text":"yunaitɨ xepɨteyu'itaiyatɨwe.","poem":2},{"text":"'Axamɨti'anekɨ xepɨtihukata","poem":1},{"text":"'axamɨtiuka'iyari xepɨtiniweya xeikɨa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kuterixi watawári xepɨtsiniya","poem":1},{"text":"meta tukatsi wawiniyari xepɨwewie.","poem":2},{"text":"Kemɨ'ane mɨkɨ tawári mutakwani pɨmɨni,","poem":1},{"text":"xɨka xewitɨ mɨkɨ tawári 'utare, kuu kanayenemɨkɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yu'itsari xemiwewie xemenakatɨni pɨkayɨwe,","poem":1},{"text":"tita xemɨtewewiekɨ xemeuyukunani xepɨkayɨwawe.","poem":2},{"text":"Wawewiya, 'axatiyurɨwame wewiyaya xeikɨa katinihɨkɨtɨni,","poem":1},{"text":"wamamate 'axamɨti'ane xeikɨa katininetɨaka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wa'ɨkate kaniyumexɨitɨaka 'axamɨtiyurienikɨ hepaɨtsita,","poem":1},{"text":"mepuyumexɨitɨa 'atsimɨkatiuka'iyari xuririyaya memɨtayeurienikɨ.","poem":2},{"text":"'Axa'aneme xeikɨa 'iyari mekaniwewieka,","poem":1},{"text":"yuhuyeta mekateniu'unani meta ti'u'unime mekatenikuhayeikawani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kayuwatɨ muyeikanikɨ mɨ'ayumieme huyeyari mepɨkamate,","poem":1},{"text":"'aixɨa ti'anetɨ wahuyeta katiniumaweni,","poem":2},{"text":"Huye tutunime mekaniwewietɨweni,","poem":1},{"text":"kemɨ'ane mɨkɨ 'utɨa mumie kayuwatɨ muyeikani pɨkamate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"'Ayumieme tita 'aixɨa mɨti'ane tahetsɨa 'ateewa puyeika,","poem":1},{"text":"meta tita mɨtiheitserie temɨkaheuta'axetsie puyeika.","poem":2},{"text":"Hekɨariya tepɨtakwewiekai, peru naitɨ yɨriya xeikɨa pɨhɨkɨ,","poem":1},{"text":"hekɨaripa te'u'uwatɨtɨ, yɨriya 'a'ayetsuikame tsata tepu'uwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Memɨkaheuneniere wahepaɨ 'ixumeritsie tekumetɨwetɨ tekaniuhuni,","poem":1},{"text":"ta'itsɨkɨ xeikɨa teteheutsetɨwetɨ tekaniu'uwani memɨka'uhɨxi wahepaɨ.","poem":2},{"text":"Tsepa tuka tepekaxɨrɨwe mɨyɨwini hepaɨ,","poem":1},{"text":"tsepanetɨ 'aixɨa temɨteheu'erie, mɨkite wahepaɨ tepɨ'anene.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Teyunaitɨ tame hutseri wahepaɨ teputiyuane,","poem":1},{"text":"kukuruxi memeutuxa wahepaɨ teputiyuane.","poem":2},{"text":"Mɨtiheitserie tepɨtetakwewiekai, peru pɨkanua,","poem":1},{"text":"mɨtatsitixɨna 'akuxi 'ateewa 'apuyeika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"'Ekɨ pepɨtimate waɨkawamekɨ temɨtehayuye'uniekɨ,","poem":1},{"text":"tita 'axatemɨte'uyuri pɨtatsixaneta.","poem":2},{"text":"Temɨtehayuye'unie tahamatɨa 'apuyeika,","poem":1},{"text":"'axatemɨte'uyuri tepɨmate.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Temɨkaheu'enana tepɨhɨkɨ, Yawé tepɨka'anu'eni.","poem":1},{"text":"Takakaɨyari tepuwarixiwiyaxɨ.","poem":2},{"text":"Teɨteri tepuwananaima meta tepɨwakwamana,","poem":1},{"text":"'itarikakɨ tepɨtekuxata ta'iyaritsie mayeneikakɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mɨpaɨ te'anetɨ 'aixɨa mɨti'ane tepɨkuwarixiwiya,","poem":1},{"text":"meta tita mɨtiheitserie 'ateewa puyeika,","poem":2},{"text":"teɨteri memayukuxexeɨriwatsie tita yuri mɨraine mepekahɨpa,","poem":1},{"text":"heitserie yatepɨkateyurie.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yuri mɨraine hawaikɨ pɨkahematsiɨkɨ,","poem":1},{"text":"kemɨ'ane 'axamɨti'ane memuku'e'eiriwa tinaime yupiinite mepɨtekunawaiyarɨwa.","poem":2},{"lineBreak":true},{"text":"Yawé pixei matsi pɨka'inakixɨ","poem":1},{"text":"tita mɨtiheitserie mumawekɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kanixeiyani, kanihɨxiyaka","poem":1},{"text":"mumawekɨ wahetsiemieme haniutɨ.","poem":2},{"text":"'Ayumieme yɨkɨmana kanayenemɨkɨ muwatawikweitsitɨanikɨ,","poem":1},{"text":"mɨtiheitserie hetsɨanamieme kaniwatuikakamɨkɨ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tita mɨtiheitserie yuhetsie nunuwame hepaɨ panutikeni,","poem":1},{"text":"meta yumu'utsie kananuyukanani kuya xupureruya tiyuwikweitsitɨwamekɨ,","poem":2},{"text":"mɨtiwarakapitɨanikɨ kamixayari panakatɨni,","poem":1},{"text":"meta yu'ɨtetsarika matayarikɨ puyuta'eima.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yapɨtiwapitɨani kememɨte'uyuri,","poem":1},{"text":"'ateewa haramara tetsita kiekatari yapɨwayurieni:","poem":2},{"text":"waɨkawa ha'atɨ memeye'unie wahepaɨtsita,","poem":1},{"text":"meta pɨtiwarakapitɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Tau makayuyuipike hepa kiekatari Yawé kemɨtitewakɨ mepɨtimakani,","poem":1},{"text":"meta tau manatineikatsie kiekatari mumariwe mepeu'enieka.","poem":2},{"text":"Karikɨ kaninuamɨkɨ haa tɨrɨkaɨyetɨ muwayeneika hepaɨ,","poem":1},{"text":"Yawé hɨtsierieyakɨ muwayenexɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«Tiyuwikweitsitɨwame Tsiyuni kaninuamɨkɨ,","poem":1},{"text":"yunaime Kakuwu hetsɨa miemete wahetsɨa kaninuamɨkɨ","poem":2},{"lineBreak":true},{"text":"'axamete'u'iyaritɨ mekete'uhayewa.","poem":2},"―Yawé mɨpaɨ kanaineni―."]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Yawé mɨpaɨ kanaineni:","poem":1},{"text":"«'Ikɨ netɨratu kanihɨkɨtɨni xehamatɨa nemiwewie:","poem":2},{"text":"Ne'iyari xehetsie mɨyeka,","poem":1},{"text":"meta neniuki nemɨmatsi'upitɨa pemekaterɨwakɨ 'ape'uyuatɨ,","poem":2},{"text":"hatsuaku pɨkamatsiku'eirieni,","poem":1},{"text":"meta 'aniwema wahetsie meta 'anuiwarima wahetsie,","poem":2},{"lineBreak":true},{"text":"hikɨtɨtɨ meta yuheyemekɨ","poem":2},"―Yawé mɨpaɨ kanaineni―."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/58.json","previousChapterAudioLinks":{},"numberOfVerses":21}