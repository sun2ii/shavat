{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":60,"content":[{"type":"heading","content":["Xawatɨriya Tsiyuni mieme"]},{"type":"verse","number":1,"content":[{"text":"»Kenanukukexi, kenexawatɨni, 'ahekɨariya kaninuaniri.","poem":1},{"text":"Yawé xawatɨriyaya 'ahetsie kaniutitataweni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Neuxei, kwie yɨriya kananukanaka,","poem":1},{"text":"teɨteri wahetsie yɨriya 'amayetsuye kanixuaweni.","poem":2},{"text":"Peru Yawé hekɨariyaya ximeri mieme 'ahetsie kanitaimɨkɨ,","poem":1},{"text":"xawatɨriyaya 'ahetsie matsiɨkɨtɨ payani.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nuiwarite mepuwitɨkieximeni 'axawatɨriya mexeiyatɨ,","poem":1},{"text":"meta te'aitamete, 'ahekɨariya ximeri mieme mexeiyatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"»Teikɨ kenenieri, kenanieretɨye'a:","poem":1},{"text":"yunaitɨ mepuyuxeɨrie meta 'ahetsɨa mepɨ'axe.","poem":2},{"text":"'Aniwema 'ateewa mepaneika,","poem":1},{"text":"'aniwema 'ukari mepɨ'atɨariwa me'ɨtɨkietɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mɨpaɨ petiniereme waɨkawa pepuyukatemawieni,","poem":1},{"text":"'a'iyari puyuaneni, temawierikakɨ,","poem":2},{"text":"mɨraye'atɨka mekamani'atɨiriekuni haramaratsie mieme,","poem":1},{"text":"'ahetsɨa katini'atɨariemɨkɨ nuiwarite tiwapiini mɨraye'atɨka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Ahetsɨa kameyutsixi mewaruhapatɨ yuwaɨkawatɨ mepɨ'axɨani,","poem":1},{"text":"Mariyani meta 'Epa kiekatari.","poem":2},{"text":"Tsawa kiekatari yunaitɨ mekani'axɨakuni,","poem":1},{"text":"huru me'ɨtɨtɨ meta 'ɨkwa witsimu'ɨa,","poem":2},{"lineBreak":true},{"text":"meta Yawé nɨawarieya mekuxatatɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yunaitɨ Tseraxi muxatsimama 'ahetsɨa mepuyukuxeɨrieni,","poem":1},{"text":"meta Newayuti hetsɨa miemete muxatsi 'ukitsi mepɨmeteta'uximayatsirieni,","poem":2},{"text":"mawari witsimu'ɨa hepaɨ nemawari taiyametsie mepanutikɨne,","poem":1},{"text":"Ne witsitiyuxexeiyame nepayeitɨani netuki mɨmariwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"»¿Kemɨ'ane mepɨhɨkɨ hai hepaɨ memanuyekɨka,","poem":1},{"text":"meta kukuruxi memeutuxa wahepaɨ yu'ituatsie memekɨka?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Ateewa kiekatari haramara tetsita, mepɨnetsitakwewie,","poem":1},{"text":"kanuwa 'amupapa Taritsi mieme mexɨakate kani'axɨamɨkɨ,","poem":2},{"text":"'ateewa 'aniwema waratɨme,","poem":1},{"text":"meta wahuru wapɨrata hatɨtɨ,","poem":2},{"text":"Yawé memɨyetuirienikɨ 'akakaɨyari,","poem":1},{"text":"Mɨpatsie 'Ixaheri hetsiemieme,","poem":2},{"lineBreak":true},{"text":"mɨkɨ pemariweme pɨmatsi'ayeitɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"»Tewanarixi 'akuraru mepanukuhana,","poem":1},{"text":"meta tewa'aitɨwamete mepɨmateta'uximayatsirieni.","poem":2},{"text":"Tsepa neha'atɨ nemɨmatiukwinitɨakai,","poem":1},{"text":"kemɨnetinakekɨ nepɨmatsinenimayaka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Akitenie yapɨreuyepietɨkani,","poem":1},{"text":"tukarikɨ meta tɨkarikɨ pɨkareunarɨmiketɨkani,","poem":2},{"text":"'ahetsɨa pɨti'atɨarieni nuiwarite tiwapiinite waɨkawa muraye'atɨka,","poem":1},{"text":"meta 'ahɨxie xuruku mehewetɨkaitɨ mepuku'uni tewa'aitɨwamete mema'iwarie.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kemɨ'ane nuiwari mɨkameti'uximayatsirie, pɨkumawere,","poem":1},{"text":"naitɨ pɨka'unarieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"»Riwanu kemɨtimariwekai mɨpaɨ pepɨyɨni,","poem":1},{"text":"huku 'amutɨtɨ, kwetsi kɨyeyari, meta tsiiná pɨ'atɨarieni,","poem":2},{"text":"witsipemɨrakuyurienikɨ netuki manuwe.","poem":1},{"text":"'Aixɨa nepiyurieni hakewa ne'ɨkate meyuwetɨka.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Ahɨxie mepɨkahɨxima'uni","poem":1},{"text":"kemɨ'ane waɨriyarika memɨxete'aitɨakai waniwema,","poem":2},{"text":"yunaitɨ kemɨ'ane memɨmatsixani'erie","poem":1},{"text":"'a'ɨkatɨa mepɨtihɨxima'uni,","poem":2},{"text":"“Yawé Kiekarieya” mepɨmateterɨwa,","poem":1},{"text":"“Tsiyuni Mɨpatsie 'Ixaheri hetsiemieme”.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"»Tsepa pemuku'eiriwakai meta pemutixani'eriwakai,","poem":1},{"text":"tsepa xewitɨ 'ahuye 'utɨma mɨka'uyeyeikakai,","poem":2},{"text":"yanepɨtiyurieni 'ahetsie yuheyemekɨ pemuyuta'ɨrenikɨ","poem":1},{"text":"meta temawierika yamɨreuyuhanenikɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nuiwarite waretsikɨ pepɨtikwaka,","poem":1},{"text":"te'aitamete memɨtehexeiyakɨ pepɨtsitsitɨarieka.","poem":2},{"text":"Hikɨ 'ana mɨpaɨ pepɨretimani kename, ne Yawé, 'awikweitsitɨwame nehɨkɨ,","poem":1},{"text":"kename ne, nemɨtɨrɨkaɨye Kakuwu hetsiemieme, nemumatsiwikweitsitɨwame nehɨkɨ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wurunitse hetsiemieme huru nepɨmatsi'atɨirieni,","poem":1},{"text":"meta tepɨa hetsiemieme pɨrata nepɨmatsi'atɨirieni.","poem":2},{"text":"Kɨyexi hetsiemieme Wurunitse nepɨmatsi'atɨirieni,","poem":1},{"text":"meta tetexi hetsiemieme, tepɨa nepɨmatsi'atɨirieni.","poem":2},{"text":"Yanepɨtiyurieni kayuwatɨ pemexeiyanikɨ,","poem":1},{"text":"meta tita mɨtiheitserie mɨmatsikuyuitɨwanikɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"'Akwietsie nanaimarika pɨkamariwani,","poem":1},{"text":"meta pepɨkaka'unarieni, metatsiere 'akwie manuye'atɨka pɨka'anuye'unarietɨyani,","poem":2},{"text":"matsi pɨta 'akurarute “Wikweitsitɨarika” pepɨtiterɨwa,","poem":1},{"text":"meta 'a'ituparite “Nɨawari” pepɨtiterɨwa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tau pɨkahɨkɨtɨniri tukarikɨ mɨmatsihekɨariwiyani,","poem":1},{"text":"meta metsa yuhekɨariyakɨ pɨkamatsihekɨariwiyani,","poem":2},{"text":"Yawé pɨta 'ahekɨariya yuheyemekɨ mieme kanihɨkɨtɨkamɨkɨ,","poem":1},{"text":"'akakaɨyari pɨmatsixawatɨriyani.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"'Atau hatsuaku pɨka'akayune,","poem":1},{"text":"meta 'ametseri hatsuaku pɨkatɨni,","poem":2},{"text":"Yawé kanihɨkɨtɨkamɨkɨ 'ahekɨariya yuheyemekɨ mieme,","poem":1},{"text":"meta hiwerika tukariyari kaneutiparimɨkɨ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hikɨ 'ana yunaitɨ 'ateɨterima heitserie mepu'uwani,","poem":1},{"text":"meta yukwietsie mepu'uwani yuheyemekɨ.","poem":2},{"text":"'Iteɨri nemikake mɨyɨra xepɨhɨkɨtɨni,","poem":1},{"text":"newewiya 'aixɨa muyɨ kɨmana nemɨmariwe.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Waɨkawa mɨwerani xeimiriyarikɨ pɨtaxiɨni,","poem":1},{"text":"'etsimutewi nuiwari tɨrɨkaɨyetɨ payani.","poem":2},{"text":"Ne Yawé nekanihɨkɨtɨni,","poem":1},{"text":"kepauka tukari maye'ani yanekatiniyurimɨkɨ, nepɨkatihayewa».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/59.json","previousChapterAudioLinks":{},"numberOfVerses":22}