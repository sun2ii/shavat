{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":61,"content":[{"type":"heading","content":["Kepauka Yawé 'aixɨa mɨtiyurieni"]},{"type":"verse","number":1,"content":[{"text":"Yawé naimekɨmɨyɨwe 'iyarieya nehetsie kaniyekani,","poem":1},{"text":"mɨpaɨ mɨneranayexeikɨ","poem":2},{"lineBreak":true},{"text":"niuki 'aixɨa manɨyɨne nemuwakuxaxatɨwanikɨ tixaɨtɨ memɨkateheuxeiya.","poem":2},{"text":"Pɨnetsiheyenɨ'a yu'iyaritsie memɨte'ukakukuine 'aixɨa meteheu'eriekame nemɨwarayeitɨanikɨ,","poem":1},{"text":"'ateewa memehapanie nemɨwakuxaxatɨwanikɨ,","poem":2},{"lineBreak":true},{"text":"meta kemɨ'ane memanutaxɨriya nemɨwaranayexɨnakɨ,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yawé parewiyaya tukariyari nemɨkuxatanikɨ kemɨraye'anikɨ","poem":1},{"text":"meta takakaɨyari kepauka mɨtiwarakapitɨani tukariyari,","poem":2},{"text":"kemɨ'ane memuyuhiwerie nemɨwanɨtɨanikɨ,","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Tsiyunitari memɨte'uka'eniwa nemɨwatɨrɨkariyanikɨ.","poem":2},{"text":"Pɨnetsiheyenɨ'a kuruna nemɨxe'anutiketsirienikɨ","poem":1},{"text":"naxiri pɨkahɨkɨtɨni,","poem":2},{"text":"temawierika hatseitiyari nemɨxekawirienikɨ","poem":1},{"text":"nutuixiyari pɨkahɨkɨtɨni,","poem":2},{"text":"kamixa 'ixɨararipa mieme nemɨxe'anakatɨtɨanikɨ","poem":1},{"text":"'iyari mɨkayuwaɨriyari pɨkahɨkɨtɨni.","poem":2},{"text":"Tuaxa tita mɨtiheitserie mɨrexeiya xepɨteterɨwarieni,","poem":1},{"text":"Yawé 'iteɨrieya, kɨmana witsitixeiyarietɨ mayuyeitɨanikɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Meripaitɨ mɨtiuka'unarie 'aixɨa xepɨtetiyurieni,","poem":1},{"text":"meripaitɨ mieme kii mu'u'uni xepanuku'uitɨani,","poem":2},{"text":"kiekari mu'u'uni 'aixɨa xepɨtiyurieni,","poem":1},{"text":"meta meripaitɨ kiekatari wakii 'unimeyari mɨti'u'uni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hipatɨ teɨteri xemɨkawamate xemuxatsima","poem":1},{"text":"mepɨwahɨtɨweni,","poem":2},{"text":"xekwietsie meta xekaxie haraweriyaritsie mepɨteta'uximayata","poem":1},{"text":"teɨteri 'ateewa kiekatari.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Peru xeme «Yawé mawari wewiwametemama» xepɨteterɨwarieni,","poem":1},{"text":"mɨpaɨ mepɨxetekɨhɨaweni «takakaɨyari te'uximayatsiriwamete».","poem":2},{"text":"Nuiwarite waɨkawa piinitɨarika kememɨtehexeiyakɨ xepɨtekwaka,","poem":1},{"text":"wapiinite mɨraye'atɨka xetehexeiyatɨ xemuyuti'ɨre.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mɨwatewiyaritɨnikekai,","poem":1},{"text":"neteɨterima mepɨtekumikiwani waɨkawa 'imikieri kememɨteheuyehɨwa,","poem":2},{"text":"memɨnanaimariekanikeyu,","poem":1},{"text":"mepuyutemamawieka yukwiepa me'u'uwatɨ wakwie mayanikekaitsie,","poem":2},{"text":"mɨpaɨ me'anekaku yukwietsie hutame hetsie timiemekɨ mepɨtekuhayewiyarieni,","poem":1},{"text":"meta watemawierika yuheyemekɨ mieme payani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Ne Yawé, tita mɨtiheitserie nepɨtinaki'erie,","poem":1},{"text":"peru nepi'uxiwe'erie 'inawari meta 'axamɨti'ane.","poem":2},{"text":"'Aixɨa nemɨtiuka'iyarikɨ wa'iwarika nepɨtiwamini,","poem":1},{"text":"meta wahamatɨa tɨratu yuheyemekɨ mieme nepɨwewieni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Xiɨyarimama mepetimatiwa nuiwarite watsata,","poem":1},{"text":"meta waniwema, teɨteri watsata.","poem":2},{"text":"Kemɨ'ane memɨwaxeiya, mepɨwaretimani","poem":1},{"text":"kename mɨkɨ nuiwari Yawé 'aixɨa mɨwayurie mehɨkɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yawé hetsiemieme nepɨnetemawie yemekɨ waɨkawa,","poem":1},{"text":"nekakaɨyari hetsie temawierika nepexeiya.","poem":2},{"text":"Mɨkɨ wikweitsitɨarika kamixayari mɨnetsi'anakatɨtɨakɨ","poem":1},{"text":"meta tita mɨtiheitserie matayari pɨnetsiwakuketɨa.","poem":2},{"text":"Neneɨkeme hepaɨ nekani'aneni witsimɨrekemari,","poem":1},{"text":"yatɨni wikiwame hepaɨ nekatinekukani.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kwie kemɨtiyɨrariyawe,","poem":1},{"text":"meta haraweri 'etsiya kemɨtitinenetɨwa,","poem":2},{"text":"mɨpaɨ Yawé naimekɨmɨyɨwe katinitinetɨamɨkɨ","poem":1},{"text":"tita mɨtiheitserie meta nɨawari yunaime nuiwarite wahɨxie.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/60.json","previousChapterAudioLinks":{},"numberOfVerses":11}