{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":62,"content":[{"type":"heading","content":["Hekwamekɨ Tsiyuni kemɨtiterɨwarieni"]},{"type":"verse","number":1,"content":[{"text":"Tsiyuni nemɨnaki'eriekɨ kayuwatɨ nepɨka'umaka,","poem":1},{"text":"Kerutsareme nemɨnaki'eriekɨ nepɨkati'uxe,","poem":2},{"text":"kepauka hetsiena tita mɨtiheitserie mutitataweni tau 'ɨrɨya hepaɨ,","poem":1},{"text":"meta wikweitsitɨarikaya 'utsi kɨxeme mɨta'a hepaɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nuiwarite kwiepa memɨtama tita mɨtiheitserie 'ahetsɨa mieme mepɨxeiya,","poem":1},{"text":"meta yunaitɨ te'aitamete kepemɨtimariwe,","poem":2},{"text":"hekwamekɨ pekanitaterɨwariemɨkɨ,","poem":1},{"text":"Yawé pɨmatsitaterɨwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yawé mamayatsie kuruna hepaɨ pepɨ'aneni pemariwetɨ,","poem":1},{"text":"ti'aitame haremaya hepaɨ pepɨ'aneni 'akakaɨyari mamayatsie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"«'Eiriwakame» pepɨkatiterɨwarieniri,","poem":1},{"text":"meta 'akwie «Makumawe» pɨkatiterɨwarieni,","poem":2},{"text":"matsi «Netemawierika» pepɨtiterɨwarieni,","poem":1},{"text":"'akwie «Ne'ɨya» pɨtitewaka,","poem":2},{"text":"Yawé 'ahetsiemieme puyutemawieka,","poem":1},{"text":"meta 'akwie pɨrekakɨnani.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Temaikɨ 'uka mutiuwitɨkɨ hepaɨ,","poem":1},{"text":"mɨpaɨ kemɨ'ane mɨmatsi'anukakitɨani pumatiwitɨni,","poem":2},{"text":"neneɨkeme mitiwitɨni xeiyatɨ muyutemawie hepaɨ,","poem":1},{"text":"mɨpaɨta 'akakaɨyari pɨtiyutemawieka 'ahetsiemieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kerutsareme, 'akurarutsie tehɨwemete nepɨwaru'uitɨa","poem":1},{"text":"hatsuaku mepɨkatehayewa, tukarikɨ meta tɨkarikɨ yamepɨtehayeneniereni.","poem":2},{"text":"Xeme, Yawé xemahɨawe,","poem":1},{"text":"xepɨka'uxipieka,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"meta yukakaɨyari xepɨka'uxipitɨaka,","poem":1},{"text":"Kerutsareme 'aixɨa yurieyuke,","poem":2},{"lineBreak":true},{"text":"nɨawari hayeitɨarieyuke kwiepa memɨtama wahetsiemieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yawé mɨpaɨ katiniuyɨhɨritɨani,","poem":1},{"text":"yumamá yutserieta miemekɨ meta yɨtɨrɨkariyakɨ:","poem":2},{"text":"«Hatsuaku tawariri memɨmetsi'aye'unie nepɨkawamini","poem":1},{"text":"'a'iku memɨtikwanikɨ,","poem":2},{"text":"meta kaxie winuyari mɨhekwa pemɨtiuta'uximayataxɨ hetsiemieme mepɨka'anu'ieni 'ateewa kiekatari,","poem":1},{"text":"kɨmana 'ekɨ pemɨtiuta'uximayataxɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yawé menɨawatɨ mepitikwani yu'iku","poem":1},{"text":"kemɨ'ane memika'e,","poem":2},{"text":"netuki takwayaritsie winu mepanu'ieni kemɨ'ane","poem":1},{"text":"kaxie harawerita memɨte'uta'uximayataxɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kitenietetsie xekeneutahakeni, xekeneutahakeni.","poem":1},{"text":"Huye xekeneukuha'arita teɨteri wahetsiemieme.","poem":2},{"text":"Huye 'a'atayeume xekeneutawewi.","poem":1},{"text":"Tetexi naime huyeta metetɨka xekenexɨri.","poem":2},{"lineBreak":true},{"text":"Patera xekeneuyuitɨwani teɨteri hipatɨ memixeiyanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mɨpaɨ 'aneme Yawé niuki kaniyetuaka","poem":1},{"text":"kwie manu'axe paitɨ mɨye'anikɨ:","poem":2},{"text":"«Tsiyuni niweya 'uka mɨpaɨ xeketeneutahɨawi:","poem":1},{"text":"“Mana kanamieni Metsiwikweitsitɨwame.","poem":2},{"text":"Yu'imikieri katinapika,","poem":1},{"text":"Tita mɨra'iwaxɨ hamatɨana kaniumieni”».","poem":2}]},{"type":"verse","number":12,"content":[{"text":"«Teɨteri memɨpatsie» mepɨtetetewaka,","poem":1},{"text":"«Yawé muwarutawikweitsitɨa».","poem":2},{"text":"«Kiekari pemɨnaki'eriwa» 'ekɨta pepɨtitewaka,","poem":1},{"text":"«Kiekari hatsuaku mɨkaku'eiriwa».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}