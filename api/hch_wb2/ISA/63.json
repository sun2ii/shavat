{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":63,"content":[{"type":"heading","content":["Yawé mɨyɨkɨhɨani tukariyari meta kepauka Kakaɨyari 'aixɨa mɨwayurieni"]},{"type":"verse","number":1,"content":[{"text":"¿Kemɨ'ane pɨyɨane 'Erumi makamie,","poem":1},{"text":"meta Wutsira makamie, 'ixuriki yɨtsikimaɨyeme 'anakatɨtɨ?","poem":2},{"text":"¿Kemɨ'ane pɨyɨane mɨkɨ witsimɨrekemari,","poem":1},{"text":"yutɨrɨkarima mumie?","poem":2},{"lineBreak":true},{"text":"«Ne nekaniyɨaneni, heitseriemekɨ nemɨtikuxata,","poem":1},{"text":"tɨrɨkariya nemexeiya nemɨratawikweitsitɨanikɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"¿Titayari 'a'iwite tixeta,","poem":1},{"text":"kaxie matiketsinarɨwa te'uximayatamete wahepaɨ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«Ne kaxie nexaɨtame nekaniutiketsini,","poem":1},{"text":"hipatɨ teɨteri mepɨkanetsi'uparewi.","poem":2},{"text":"Nekanitiketsini nehaxɨakɨ,","poem":1},{"text":"nekaniwarutipɨna neha'atɨ.","poem":2},{"text":"Waxuriya ne'ixuriki kaniuwirieni,","poem":1},{"text":"naime nekamixa nekaniutawirieni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Ariri kepauka nemɨnekɨhɨani yanepɨtimate.","poem":1},{"text":"Newikweitsitɨarika wiyari paye'ari.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neuxei, peru pumawekai kemɨ'ane mɨnetsiparewieni,","poem":1},{"text":"nepɨhɨxiya xewitɨ mɨkanetsiparewimɨkɨkɨ.","poem":2},{"text":"Netɨrɨkariya katiniuyurieni nemɨrayu'iwaxɨ,","poem":1},{"text":"nehaxɨatɨtɨ kaneniuparewieni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Neha'atɨ teɨteri kwiepa memɨtama nepɨwarutiketsi,","poem":1},{"text":"nepɨwarutitarɨwaitɨa nehaxɨa tekɨxiyarikɨ,","poem":2},{"lineBreak":true},{"text":"waxuriya kwiepa 'uhaneme nepayeitɨa».","poem":2}]},{"type":"heading","content":["Nɨawari meta nenewieri"]},{"type":"verse","number":7,"content":[{"text":"Yawé naki'eriyaya mɨmariwe nepaye'erieni,","poem":1},{"text":"meta kemɨtiuyuri 'aixɨa pɨ'ane minɨawanikɨ,","poem":2},{"text":"naime kemɨtiuyuri tahetsiemieme,","poem":1},{"text":"kemɨtiuyukanenimaya meta naki'eriyaya mɨmariwekɨ.","poem":2},{"text":"Huu, pɨmɨire 'aixɨa 'anemekɨ kemɨtiuyuri","poem":1},{"text":"'Ixaheri nuiwarimama wahetsiemieme.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mɨpaɨ nepaine: «Yurikɨ neteɨterima mepɨhɨkɨ,","poem":1},{"text":"neniwema hatsuaku memɨkanete'itaiya».","poem":2},{"text":"Mɨpaɨ pɨratɨa wawikweitsitɨwame","poem":1}]},{"type":"verse","number":9,"content":[{"text":"naime kememɨte'uka'eniwakaikɨ.","poem":2},{"text":"Mɨkɨtɨtɨ puwarutawikweitsitɨa,","poem":1},{"text":"xeime pɨkaheyenɨ'a meta nixeime niuki tuayame.","poem":2},{"text":"Yunaki'eriyakɨ meta yunenimayatsikakɨ kaniwarutawikweitsitɨani,","poem":1},{"text":"kaniwaranukutɨkɨ, kaniwaretɨkɨ yumamatetsie","poem":2},{"lineBreak":true},{"text":"meripaitɨ hepaɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Peru mɨkɨ mepɨkahenu'eni,","poem":1},{"text":"meta 'iyarieya mɨpatsie mepu'iyarimɨtɨa.","poem":2},{"text":"'Ayumieme waraye'unietɨ patɨa,","poem":1},{"text":"mɨkɨtɨtɨ pɨwarutakwi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Teɨterimama meripaitɨ mieme mepaye'eri,","poem":1},{"text":"Muitsexi muyeikakaitsie:","poem":2},{"text":"¿Hakewari haramaratsie muwaranawitɨ,","poem":1},{"text":"muxatsi wahɨweme muxatsi mɨtiwaruwitɨkɨ hepaɨ?","poem":2},{"text":"¿Hakewari yu'iyari mɨpatsie","poem":1},{"text":"watsata mɨ'atɨa,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"yamɨtiuyuri yumamá mariwemekɨ","poem":1},{"text":"Muitsexi tserieta mumienikɨ,","poem":2},{"text":"kemɨ'ane haa manutayepi mana muyanikɨ,","poem":1},{"text":"yuheyemekɨ matiwatɨ mayanikɨ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"¿Hakewari haramaratsie muwaranawitɨ,","poem":1},{"text":"makumawetsie yeikame kawayutsie manaka hepaɨ,","poem":2},{"lineBreak":true},{"text":"witsi'anekɨa muwarawitɨ memɨkahekaxɨri?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yawé 'iyarieya puwaruka'uxipitɨa","poem":1},{"text":"tewaxi makuweritsie memɨtekwatɨwe wahepaɨ.","poem":2},{"text":"Mɨpaɨ pepɨtiwaruwitɨ 'ateɨterima,","poem":1},{"text":"waɨkawa pemariwetɨ pemayanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kenakanieri muyuawitsie paitɨ,","poem":1},{"text":"keneutanierixɨa 'akiekari mɨpatsietsie meta witsimɨtiyuxexeiyatsie paitɨ.","poem":2},{"text":"¿Hakewari 'atɨrɨkariya meta 'a'ɨtetsarika?","poem":1},{"text":"pepɨtatsikweririe mɨmɨirekɨ kepemutiyukanenimaya, witsikepemɨtiuka'iyari.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Peru 'ekɨ tapaapa pepɨhɨkɨ,","poem":1},{"text":"tsepa 'Apɨrahami mɨkatatsimate","poem":2},{"lineBreak":true},{"text":"meta tsepa 'Ixaheri mɨkatatsimaiwe,","poem":2},{"text":"'ekɨ, Yawé, tapaapa pepɨhɨkɨ,","poem":1},{"text":"«Tatsiwikweitsitɨwame» yuheyemekɨ pepɨtitewa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"¿Titayari Yawé, petareuyexɨrɨwa 'ahuyeta,","poem":1},{"text":"meta titayari ta'iyari petitseiriya","poem":2},{"lineBreak":true},{"text":"temɨkametsimakaxenikɨ?","poem":2},{"text":"Kenenua te'a'uximayatsiriwamete pemɨwanaki'eriekɨ,","poem":1},{"text":"'anuiwarite 'ahetsɨa miemete yuheyemekɨ memɨhɨkɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"'Ateɨterima yatewimekɨ 'atuki mepexeiyakai,","poem":1},{"text":"peru hikɨ memɨtatsi'aye'unie mepitiketsixɨa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wa'atɨtɨ hatsuaku pepɨkatatiuta'aitɨa tepɨ'ane,","poem":1},{"text":"wa'atɨtɨ hatsuaku kepemɨtitewa temɨkate'uterɨwarieni hepaɨ.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/62.json","previousChapterAudioLinks":{},"numberOfVerses":19}