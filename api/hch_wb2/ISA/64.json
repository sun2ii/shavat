{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":64,"content":[{"type":"verse","number":1,"content":[{"text":"Mɨpaɨ tepɨteha'eriwakaku muyuawi xɨka pewakayepienike muwa pemakanenikɨ,","poem":1},{"text":"Hɨrite 'ahɨxie putiyɨyɨakawe,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"tai kɨyexi kemɨtikutaiya hepaɨ,","poem":1},{"text":"meta haa kemɨtikwaniyawe.","poem":2},{"text":"Mɨpaɨ kepemɨtitewakɨ pepɨtiwaxeitsitɨani memɨmetsi'aye'unie watsata,","poem":1},{"text":"'ahɨxie meti'utɨ nuiwarite meputiyɨyɨakawawe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kepauka pemanakatɨa mariwemekɨ pepɨtiuyuri mɨpaɨ tekateha'eriwakaku,","poem":1},{"text":"'ahɨxie hɨrite putiyɨyɨakaxɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Xewitɨ tawarita, meripaitɨtɨ","poem":1},{"text":"mɨpaɨ pɨkati'enawe,","poem":2},{"text":"meta xewitɨ mɨpaɨ pɨkatinieriwe,","poem":1},{"text":"xeime Kakaɨyari 'ahepaɨ tiyurieneme pɨkaxeiyawe","poem":2},{"lineBreak":true},{"text":"kemɨ'ane hetsiena memɨtewiya wahetsiemieme 'aixɨa tiyurieneme.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Pewaranunakeke pepayeyeika, memuyutemamawie","poem":1},{"text":"heitseriemekɨ yamemɨtekahu meta 'ahuye mema'eriwa.","poem":2},{"text":"Peru pepuyeha'arɨwe xɨka tekaheu'enanaka","poem":1},{"text":"xɨka 'ahuye te'uku'eirieni.","poem":2},{"lineBreak":true},{"text":"¿Kehepaɨ tetetawikweni?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Teyunaitɨ teɨteri temɨka'itiyatɨka tepɨhɨkɨ,","poem":1},{"text":"naitɨ heitseriemekɨ ketemɨteyurie","poem":2},{"lineBreak":true},{"text":"'ixurikite mɨtɨtɨnini hepaɨ pɨ'ane.","poem":2},{"text":"Teyunaitɨ tepɨtiwauke kɨye xawari hepaɨ,","poem":1},{"text":"titakɨ 'axatemɨte'uyuri 'eka hepaɨ pɨtatsi'u'enitsitɨaxime.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nixewitɨ pɨkamatsihahɨawe,","poem":1},{"text":"nixewitɨ pɨkayɨtɨrɨkariya 'ahetsie mɨtiwiyanikɨ.","poem":2},{"text":"Metsɨ pekataniwarixiwiyani","poem":1},{"text":"pekataniyetuani pɨta 'axamɨti'ane mɨtatsikuyuitɨanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Peru tsepa mɨyatɨtɨ, Yawé, 'ekɨ ta'ukiyari pepɨhɨkɨ,","poem":1},{"text":"tame haxu tepɨhɨkɨ, 'ekɨta 'iwewame.","poem":2},{"lineBreak":true},{"text":"Teyunaitɨ tame 'awewiya tepɨhɨkɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Waɨkawa pepɨkaha'aka, Yawé,","poem":1},{"text":"pepɨkaheye'eriwaniri yuheyemekɨ 'axaketemɨte'uyuri.","poem":2},{"text":"Nepɨmatsiwawirie, mɨpaɨ ketinemaika,","poem":1},{"text":"kename tame 'ateɨterima tehɨkɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Akiekarite mɨpatsietɨka puka'unariexɨa,","poem":1},{"text":"metatsiere Tsiyuni makumawe pɨta kanayani,","poem":2},{"lineBreak":true},{"text":"Kerutsareme yuxaɨta kanekumaka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tatuki mɨpatsie meta mɨmariwe,","poem":1},{"text":"hakewa tapaapama memɨmatsihenɨawakai,","poem":2},{"lineBreak":true},{"text":"tai kanitaxɨtsitɨani.","poem":2},{"text":"'U'unitɨ katiniyuhayewa","poem":1},{"text":"naitɨ tita waɨkawa temɨteheuyehɨakai.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"'Ikɨ mɨya mɨtiɨyɨkɨ, Yawé, ¿'atsipekatiyurieni?","poem":1},{"text":"¿Kayuwatɨ petiumaka meta petatikwinitɨatɨ ka'inɨarimekɨ xeikɨa?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/63.json","previousChapterAudioLinks":{},"numberOfVerses":12}