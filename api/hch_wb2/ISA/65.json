{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":65,"content":[{"type":"heading","content":["Ke'aixɨa mɨtiyurieni meta kemɨtiwatawikweitsitɨani"]},{"type":"verse","number":1,"content":[{"text":"«Kemɨ'ane memɨkanetsiku'iwawakai wahetsɨa pɨta nepunehekɨataxɨ,","poem":1},{"text":"kemɨ'ane memɨkanetsikuwautuwekai wahetsɨa yanepɨtiutanaki'eri memɨnetsitaxeiyakɨ.","poem":2},{"text":"'Iya nuiwari memɨkanetsihahɨawekai,","poem":1},{"text":"mɨpaɨ nepɨtitahɨawixɨ: “'Ena nepuwe”.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tukarikɨ nemamá nepaɨtatsera","poem":1},{"text":"'iya teɨteri memɨkanetsi'enie wahetsɨa,","poem":2},{"text":"'axamɨ'ane huyeyari 'utɨma memuhu,","poem":1},{"text":"kememɨteku'eriwa xeikɨa yameteyurietɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mɨkɨ teɨteri mepɨhɨkɨ nehɨxie","poem":1},{"text":"memɨnetsihaxɨatɨa tukarikɨ,","poem":2},{"text":"harawerita mawari mekaniwewietɨweni","poem":1},{"text":"meta 'ɨkwa witsimu'ɨa mekanitaiyatɨweni mawari taiyametetsie,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"mɨkite wateukiyapa putayeixa","poem":1},{"text":"meta yuxaɨtame tɨkarikɨ maku'awietsie pɨkatariyarɨwa kakutɨ,","poem":2},{"text":"tuixu waiyari pukwa'a,","poem":1},{"text":"meta yuxarita wai mɨka'itiya puka'eetsa,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"mɨpaɨta kaniutaineni: “Teewa xekeneu'uwani.","poem":1},{"text":"'Ahurawa nehetsɨa xepɨkahakɨkani.","poem":2},{"text":"Ne yemekɨ nekanipatsieka xehetsiemieme”.","poem":1},{"lineBreak":true},{"text":"'Ikɨ naitɨ pɨkanetinake kɨtsi nemɨ'ɨkweni hepaɨ,","poem":1},{"text":"tai yamɨtita'a tukarikɨ kanihɨkɨtɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"»Nehɨxie yakatinaka'utsieni:","poem":1},{"text":"Ne kayuwatɨ nepɨkatiyerɨni.","poem":2},{"text":"Yanepɨtiwarakapitɨani,","poem":1},{"text":"mekatenikwinikuni yuwaiyaritsie,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"xeme 'axakexemɨte'uyuri hetsiemieme meta","poem":1},{"text":"xepaapama kememɨte'uyuri","poem":2},"―Yawé mɨpaɨ kanaineni―.",{"text":"Mɨkɨta 'ɨkwa witsimu'ɨa mekaniutitaiya hɨritsie,","poem":1},{"text":"meta hɨri 'amanutitɨtɨtsie 'axamepɨnete'utama,","poem":2},{"text":"nekatiniwakwinitɨamɨkɨ wawaiyaritsie","poem":1},{"text":"meripaitɨ 'axamemɨte'uyurikɨ».","poem":2}]},{"type":"verse","number":8,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«Kepauka xewitɨ kaxie takari witsi'aneneme mɨtaxeiya,","poem":1},{"text":"mɨpaɨ putaine: “Nemarima 'aixɨa,","poem":2},{"lineBreak":true},{"text":"'akuxi kanayemaneni hayari”.","poem":2},{"text":"Mɨpaɨta yaxeikɨa nepɨtiyurieni nete'uximayatsiriwamete nemɨwanaki'eriekɨ:","poem":1},{"text":"Yunaime nepɨkawaka'una.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kakuwu hetsie nuiwari nepuwarayenetɨani,","poem":1},{"text":"meta Kura hetsie nepuwarayenetɨani kemɨ'ane 'ikɨ hɨrite wapiini mayani.","poem":2},{"text":"Kemɨ'ane nemuwaranayexeiya tiwapiini payani,","poem":1},{"text":"mana mepɨtiteni nete'uximayatsiriwamete.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Neteɨterima kemɨ'ane memɨnetsikuwautɨwe,","poem":1},{"text":"Tsaruni makuweritsie wamuxatsima mepu'uwani,","poem":2},{"lineBreak":true},{"text":"'Akuhuxi mayeweritsie, wawakaitsixi mepɨye'uwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"»Peru xeme Yawé xemuku'e'eiriwa","poem":1},{"text":"meta nehɨri mɨpatsie xematɨmai,","poem":2},{"text":"kakaɨyarixi waɨkawa mɨrexeiyanikɨ meta 'aixɨa pemɨtiumienikɨ memɨ'ayumiemete","poem":1},{"text":"wahetsiemieme mexa xemukuha'arita meta winu nɨkame xemukatu'a,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"'Ixiparakɨ xemukwi'iwakɨ nepɨxeyetuani,","poem":1},{"text":"yunaitɨ xeme xepakatutsitaxɨani xemanutixitekiexɨanikɨ,","poem":2},{"text":"Nexe'utahɨaweku xemɨkanetsi'uta'eikɨ,","poem":1},{"text":"kepauka nemɨxe'utahɨawixɨ xepɨkanetsi'u'eni.","poem":2},{"text":"Matsi 'axaxepɨte'uyuri pɨta nehɨxie","poem":1},{"text":"tita mɨkanetinake xepɨte'anukuwei».","poem":2}]},{"type":"verse","number":13,"content":["'Ayumieme, mɨpaɨ kanaineni Yawé naimekɨmɨyɨwe:",{"text":"«Nete'uximayatsiriwamete mepɨtekwaka,","poem":1},{"text":"peru xeme xepɨhaakakwini,","poem":2},{"text":"nete'uximayatsiriwamete mepɨhareka,","poem":1},{"text":"peru xeme xepɨharikwini,","poem":2},{"text":"nete'uximayatsiriwamete mepuyutemamawieka,","poem":1},{"text":"peru xeme xepuyutetewiyani.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nete'uximayatsiriwamete meputikwikani","poem":1},{"text":"yu'iyarikɨ meyutemamawietɨ,","poem":2},{"text":"peru xeme xeputihiwani","poem":1},{"text":"yu'iyaritsie xete'uka'eniwatɨ,","poem":2},{"lineBreak":true},{"text":"xeputitsuanani yu'iyaritsie xete'uka'eniwatɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nemɨwaranayexei wahetsie pɨtinake kexemɨtetewa","poem":1},{"text":"'axaxemɨ'itɨarikakɨ.","poem":2},{"text":"Yawé naimekɨmɨyɨwe pɨxekwini,","poem":1},{"text":"peru te'uximayatamete yuhetsɨa miemete yɨkɨ pɨtiwatiterɨwa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tsepa kemɨ'ane xewitɨ 'aixɨa mɨ'itɨariekakɨ mɨkɨ kwieyaritsie xɨka tiutawauni,","poem":1},{"text":"yapɨtiyurieni Kakaɨyari yuri mɨhɨkɨ hetsiemieme,","poem":2},{"text":"meta tsepa kemɨ'ane 'ikɨ kwietsie yamɨtiyɨhɨritɨani,","poem":1},{"text":"yapɨtiyurieni Kakaɨyari yuri mɨhɨkɨ hetsiemieme,","poem":2},{"text":"'Uximatɨarika meripaitɨ mieme mepatɨmairi,","poem":1},{"text":"hikɨ nepɨka'iku'eriwari.","poem":2}]},{"type":"heading","content":["Muyuawi hekwatɨ meta kwie hekwatɨ"]},{"type":"verse","number":17,"content":[{"text":"»Kayuwatɨ xekeneu'enana, 'ari nekaninetɨaximeni","poem":1},{"text":"muyuawi hekwame meta kwie hekwame.","poem":2},{"text":"Tawariri pɨkatitaxatsieni meripaitɨ timieme,","poem":1},{"text":"meta pɨkaha'eriwani.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Matsi xekeneyutemamawieka, yuheyemekɨ xekeneyutemamawieka,","poem":1},{"text":"tita nemɨtinetɨaximekɨ:","poem":2},{"text":"Nepinetɨaxime xeime Kerutsareme yutemawiekame,","poem":1},{"text":"kiekari temawierika waɨkawa hexeiyakame.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nepuyutemawieka Kerutsareme hetsiemieme","poem":1},{"text":"meta nepuyutemawieka neteɨterima wahetsiemieme,","poem":2},{"text":"tawarita mana pɨka'enierieni","poem":1},{"text":"tsuari hiwariyari meta kukuiniya hiwariyari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"»Hatsuakuri mana tɨɨri kwitɨwa metakukuwetɨ","poem":1},{"text":"mepɨkatixuawere,","poem":2},{"lineBreak":true},{"text":"meta 'ukirawetsixi kwitɨwa mepɨkatakukuweni.","poem":2},{"text":"Kemɨ'ane mɨmɨni xeitsienituyari hexeiyatɨ","poem":1},{"text":"temaikɨ hepaɨ 'anetɨ pɨyɨaneni,","poem":2},{"text":"peru kemɨ'ane mana mɨka'utineni","poem":1},{"text":"'axamɨ'itɨarieka hepaɨ 'anetɨ payeitɨarieni.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kii mepɨtiwewieni, muwa mepayetetɨkani,","poem":1},{"text":"kaxie mepɨka'eni meta takarieya mepɨtikwani.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"'Ari kii mepɨkatiwewieni hipatɨ pɨta muwa memeutayaxekɨ,","poem":1},{"text":"meta kaxie xepɨkaka'eni hipatɨ pɨta memitikwanikɨ.","poem":2},{"text":"Matsi neteɨterima watukaritsie","poem":1},{"text":"kɨye tukarieya kemɨ'ane mɨpaɨ kani'anemɨkɨ,","poem":2},{"text":"nemɨwaranayexeiya kememɨteyurieni","poem":1},{"text":"mepɨtekaxeiya mepɨteha'inɨata.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"'Ari yakɨ xeikɨa mepɨkateta'uximayata,","poem":1},{"text":"meta tɨɨri mepɨkawarayexeiya 'axamemɨ'itɨarienikɨ,","poem":2},{"text":"mɨkɨ metatsiere waxiɨyarima","poem":1},{"text":"'ɨimari Yawé 'aixɨa miyurie mekanakɨnikuni.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"'Akuxi mekanetsitahɨawiwekaku,","poem":1},{"text":"ne nepuwata'eiya,","poem":2},{"text":"'akuxi meputiniukani","poem":1},{"text":"peru ne 'ari newa'enieyu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Maye muxa hamatɨa yunaitɨ mepɨtetikwani makutsiɨraɨyetsie,","poem":1},{"text":"maye 'ɨxa pɨtikwani tuuru hepaɨ,","poem":2},{"lineBreak":true},{"text":"meta kuu 'ikwaiya tumuanari pɨhɨkɨtɨni.","poem":2},{"text":"Naitsarie nehɨri mɨpatsietsie","poem":1},{"text":"tiyukwinitɨwatɨ kaniumawekamɨkɨ meta tiuyuka'unatɨ»,","poem":2},"Yawé kanaineni."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/64.json","previousChapterAudioLinks":{},"numberOfVerses":25}