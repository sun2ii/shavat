{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":66,"content":[{"type":"heading","content":["Ke'aixɨa mɨtiyɨni meta ketemɨteta'ikwewani"]},{"type":"verse","number":1,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«Muyuawi ne'uweni kanihɨkɨtɨni,","poem":1},{"text":"kwie meta, hetsiena nemɨnewetɨka kanihɨkɨtɨni.","poem":2},{"text":"Kii xemɨnetsi'utawewirieni pɨkayɨwe.","poem":1},{"text":"Tixaɨtɨ kiiyari xepɨkanete'uxatɨawawe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Netɨrɨkariya katiniuyurieni naime 'ikɨ mɨtiutawewi:","poem":1},{"text":"mɨpaɨ tiɨyɨku 'ayumieme katiniuneni","poem":2},"―Yawé mɨpaɨ kanaineni―.",{"lineBreak":true},{"text":"»Ne nepuwaxeiya tixaɨtɨ memɨkateheuxeiya meta yu'iyaritsie memɨte'uka'eniwa,","poem":1},{"text":"kemɨ'ane neniuki memayemakaxe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Peru kemɨ'ane tuurutsixi memɨwamawatɨwe","poem":1},{"text":"mɨkɨ teɨteri memɨwatakukuya wahepaɨ mepɨ'anene,","poem":2},{"text":"kemɨ'ane muxatsi memɨwamawatɨwe","poem":1},{"text":"mɨkɨ tsɨikɨri wakɨipi memanutimura wahepaɨ mepɨ'anene,","poem":2},{"text":"kemɨ'ane hatsi mawariyari mɨwewie","poem":1},{"text":"mɨkɨ tuixuri waxuriya memɨyetuaya wahepaɨ mepɨ'ane,","poem":2},{"text":"meta kemɨ'aneta 'ɨkwa witsimu'ɨa mukutaiya","poem":1},{"text":"mɨkɨ memɨkakakaɨyarixi memuwarayexeiya wahepaɨ kani'aneni.","poem":2},{"text":"Mɨkɨ yuxaɨta yuhuye mepanayexeiyaxɨa,","poem":1},{"text":"meta mepuyutemawieritɨa mɨxani'eriwakɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Ayumieme ne 'uximatɨarika nekananayexeiyamɨkɨ wahetsiemieme","poem":1},{"text":"tita waɨkawa memɨtemakaxe nekatiniwaranunɨ'airiemɨkɨ.","poem":2},{"text":"Nixewitɨ mɨkanetsi'uta'eikɨ kepauka nemɨwarahɨawekaitsie,","poem":1},{"text":"kepauka nemutaniu, nixewitɨ pɨka'u'enaxɨ.","poem":2},{"text":"Matsi, 'axamepɨte'uyuri nehɨxie","poem":1},{"text":"tita mɨkanetinake mepɨte'anayexei».","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yawé niukieya xekeneu'eni,","poem":1},{"text":"xeme niukieya xemayemakaxe:","poem":2},{"text":"«Mɨpaɨ xe'iwama mekaniutiyuaneni memɨxexani'erie","poem":1},{"text":"meta memɨxehayeweweiya kenemɨtitewakɨ xemɨnetsikuxatakɨ:","poem":2},{"text":"“Yawé mariwetɨ kehayeitɨarieni,","poem":1},{"text":"temawierika xehetsie temɨxeiyakɨ”.","poem":2},{"lineBreak":true},{"text":"Peru mɨkɨ pɨta mepɨtewiyatsitɨarieni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hiwari pa'eniɨriɨkɨ kiekaritsie,","poem":1},{"text":"tukita payeneika hiwari:","poem":2},{"text":"Yawé hiwarieya kanihɨkɨtɨni","poem":1},{"text":"memeye'unie yakatiniwarakapitɨamɨkɨ tita wahetsie mɨtimieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"»Meripaitɨ ka'itakwiniwekaku 'akuxi","poem":1},{"text":"Kerutsareme nunutsi kanayexeiya,","poem":2},{"text":"'akuxi ka'aye'awekaku matiniwenitsie,","poem":1},{"text":"'ukitɨme kaniutiniweni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"¿Kemɨ'ane 'ari mɨpaɨ pɨtiu'enaxɨ?","poem":1},{"text":"¿Kemɨ'ane hepaɨna 'aneme puxei?","poem":2},{"text":"¿Tiyɨwe xewitɨ nuiwari mɨtinuiwa xeitukaritsie?","poem":1},{"text":"¿Xeikiekariyari mutinuiwa tiyɨwe xeitukaritsie?","poem":2},{"text":"Matsi, Tsiyuni yutɨɨriyama kaniwarayexeiya","poem":1},{"text":"'akuxi ka'itakwiniwetɨ waɨkawa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Xɨka ne niweyametsie nereuyepieni,","poem":1},{"text":"nepipitɨani nunutsi mɨtinuiwakɨ","poem":2},"―Yawé mɨpaɨ kanaineni―.",{"text":"Nepɨkareunani niweyametsie,","poem":1},{"text":"karikɨ ne nemɨhɨkɨkɨ memɨtiniweyanikɨ yanemɨtiwakupitɨwa","poem":2},"―'akakaɨyari mɨpaɨ kanaineni―."]},{"type":"verse","number":10,"content":[{"text":"Matsi Kerutsareme hamatɨa xekeneyutemamawieka,","poem":1},{"text":"kemɨ'ane yunaitɨ xeminaki'erie,","poem":2},{"text":"hamatɨana xekeneutitsukwakani temawierikakɨ,","poem":1},{"text":"yunaitɨ kemɨ'ane xemutitsuanakai hamatɨana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Karikɨ xeme xekanititsitsitɨariekuni meta xekanitihuxaitɨariekuni,","poem":1},{"text":"nɨtɨarika xekanikaxeiyakuni tsitsitsie,","poem":2},{"text":"xepɨtihuxani,","poem":1},{"text":"xepuyutemamawieka tsitsi 'amɨnenetsie».","poem":2}]},{"type":"verse","number":12,"content":["Karikɨ Yawé mɨpaɨ kanaineni:",{"text":"«Mɨkɨ kayuwatɨ waɨkawa nepɨpitɨani haa tɨrɨkaɨyetɨ muhane hepaɨ,","poem":1},{"text":"meta kwiepa memɨtama tiwapiini nepɨtipitɨani haa manatiyeuriweni hepaɨ.","poem":2},{"text":"Xeme xepɨtsitsitɨarieka, xepa'ɨiyaka,","poem":1},{"text":"tunutetsie xepukuheni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Niwekame yuniwe kemɨtinɨtɨwa hepaɨ,","poem":1},{"text":"mɨpaɨ ne nepɨtixenɨtɨani,","poem":2},{"lineBreak":true},{"text":"Kerutsaremetsie xekaninɨtɨariekuni».","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kepauka xeme mɨpaɨ xemɨteneniere,","poem":1},{"text":"yu'iyaritsie xepuyutemamawieka,","poem":2},{"lineBreak":true},{"text":"hikɨ mɨkɨ waiyarieya pɨtaxutuni tupiriya hepaɨ,","poem":2},{"text":"Yawé matsiɨkɨme payeitɨani","poem":1},{"text":"yutɨrɨkariya te'i'uximayatsiriwamete watsata,","poem":2},{"lineBreak":true},{"text":"meta yuhaxɨa kemɨ'ane memeye'unie watsata.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yawé 'ukanamieniri tai hetsie yewetɨ.","poem":1},{"text":"Kaxetateya kuyaxa mieme haikɨri mɨtɨrɨkawi pɨhɨkɨ.","poem":2},{"text":"Yuhaxɨa pɨyetuani,","poem":1},{"text":"tai nerɨkwariyarikɨ puyutahaxɨatɨani.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Taikɨ meta 'ixiparakɨ","poem":1},{"text":"Yawé teɨteri yunaime puwataxaneta.","poem":2},{"lineBreak":true},{"text":"Yawé tɨrɨkariyayatsie yumɨiretɨ mepɨkwini.","poem":2}]},{"type":"verse","number":17,"content":["«Wahamatɨa mekanikwikuni kemɨ'ane mepatsiekame memayuyeitɨa meta kemɨ'ane memuyu'itie memeutahaxɨanikɨ harawerita, xeime manuyeka me'uweiyatɨ, meta kemɨ'ane tuixu waiyarieya memɨkwa'a, naikatsi meta hipame mɨtixani'eriwa ―Yawé mɨpaɨ kanaineni―."]},{"type":"verse","number":18,"content":["»Ne, mɨkɨ 'axamemɨteyuriekɨ meta 'axamemɨteku'eriwakɨ, nepɨwaxeɨrimɨkɨ yunaime teɨteri kwiepa memɨtama, nuiwarite meta yɨkɨ 'anenemekɨ niuki memutiniuka mekani'axɨakuni mekanenixeiyakuni kenemɨtimariwe."]},{"type":"verse","number":19,"content":["»'Inɨari nekaniwawewiriemɨkɨ, hipatɨ memɨyuhayewa nuiwarite kwiepa memɨtama wahetsɨa nepɨwaranunɨ'ani: Taritsi kiekariyaritsie, Puri, Riria (mana kiekatari kwinie mepɨteheutamɨiwawekai), Tuwari meta Kɨretsiya, meta haramara tetsita meteewatsie hakewa memɨkanetsihetamariwawe meta kenemɨtimariwe memɨka'ixeiyawawe. Mɨkɨ mekanenitaxatakuni kenemɨtimariwe nuiwarite watsata."]},{"type":"verse","number":20,"content":["Meta naitsarie xe'iwama nuiwarite watsata memutetɨka nehɨri mɨpatsietsie Kerutsareme xepuwa'atɨani, mawari hepaɨ Yawé hetsiemieme, kawayutsixi, kaxetate yukukuyamete, kaxetate titɨkɨmete, muratsixi meta kameyutsixi wahetsie me'utekame xepɨwa'atɨani ―Yawé mɨpaɨ kanaineni—. 'Ixaheritsixi wahepaɨ, watsute 'aixɨa 'anenemeta, hatsi mawariyari Yawé tukita memɨte'atɨwa hepaɨ xekateniwa'atɨakuni."]},{"type":"verse","number":21,"content":["Mɨkɨ wahetsieta hipame nepuwaranayexeiya, mawari wewiwamete memakɨnekɨ meta rewitsixi ―Yawé mɨpaɨ kanaineni―."]},{"type":"line_break"},{"type":"verse","number":22,"content":["»Kemɨreutere ne'ixeiyakaku muyuawi meta kwie mɨhekwa neminetɨani, mɨpaɨta xenuiwarima meta kememɨtetetewa mepɨteheutere ―Yawé mɨpaɨ kanaineni―."]},{"type":"verse","number":23,"content":["Xeimetseriyari 'anukayeikakaku meta xawati xeitsemana miemetsie, yunaitɨ kwiepa memɨtama mepɨ'axɨani nehɨxie memɨkatunuma'unikɨ ―Yawé mɨpaɨ kanaineni―."]},{"type":"verse","number":24,"content":["Hikɨ kepauka memuwayekɨnetsie mepɨwaxeiya wakaxarite kemɨ'ane memɨnetsi'utami.",{"text":"»Kwitsi pɨkamɨni muwakwa'a,","poem":1},{"text":"meta tai pɨkatɨni muwatixɨtsitɨwa:","poem":2},{"lineBreak":true},{"text":"memɨxani'eriwa mepakɨne yunaitɨ kwiepa memɨtama wahɨxie».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JER/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/65.json","previousChapterAudioLinks":{},"numberOfVerses":24}