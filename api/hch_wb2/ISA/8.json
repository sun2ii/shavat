{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":8,"content":[{"type":"heading","content":["'Atsiriya, Yawé kemɨtikuyuitɨa"]},{"type":"verse","number":1,"content":["Yawé mɨpaɨ kanetiniutahɨawe: «Xeime mexa 'a'atayeume keneuti'ɨka, ti'utɨwamekɨ mana ketinaka'utɨa: “Mahexi-Tsarari-Katsiwatsi",{"noteId":2},"hetsie timieme”."]},{"type":"verse","number":2,"content":["Ne nekaniwata'inimɨkɨ hipame 'aixɨa nemɨtiwamate memɨnenierekɨ, mawari wewiwame 'Uriyaxi meta Tsakariyaxi Kewerekiyaxi nu'aya»."]},{"type":"verse","number":3,"content":["Hikɨ 'uka tixaxatame hamatɨa nekaniukahuni, mɨkɨ kaniutihukata, xeime nunutsi kaniutiniweni. Hikɨ Yawé mɨpaɨ kanetiniutahɨawe: «Mahexi-Tsarari-Katsiwatsi ketineuterɨwa."]},{"type":"verse","number":4,"content":["Mɨkɨ nunutsi “nepaapa” “nemaama” 'akuxi mɨtayɨni kayɨwekaku, Ramatsiku waɨkawa kemɨrexeiyakai meta Tsamariya piinitɨarika mɨra'iwakai 'Atsiriyatsie ti'aitame hetsɨa katinanɨtɨkiemɨkɨ»."]},{"type":"verse","number":5,"content":["Yawé tawarita mɨpaɨ kanetiniutahɨawe:"]},{"type":"verse","number":6,"content":[{"text":"«'Ikɨ teɨteri memiku'eirikɨ","poem":1},{"text":"Tsiruhe hayari kayuwatɨ muhane","poem":2},{"text":"Xetsini hetsie pɨta memuyutemamawie","poem":1},{"text":"meta Xemariyaxi nu'ayatsie,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ti'aitame 'ari haa 'Eupɨrate hatɨayari wahetsie kaniwayenetɨamɨkɨ","poem":1},{"text":"haa waɨkawa mɨtɨrɨkaɨye:","poem":2},{"lineBreak":true},{"text":"ti'aitame 'Atsiriya kiekame kaniyɨanemɨkɨ kemɨtimariwe.","poem":2},{"text":"Naime haa manuyehapanekai tihɨniyame kanenatiyeuriexɨamɨkɨ,","poem":1},{"text":"hakewa meta'atɨkatsie panakayeurieni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kura kwieyaritsie paitɨ kaniye'amɨkɨ, kanikayunitɨamɨkɨ,","poem":1},{"text":"kɨipitɨana paitɨ kaniuku'atɨyeimɨkɨ.","poem":2},{"text":"Neuxei 'Emanuheri","poem":1},{"noteId":3},{"text":", yu'anate taweratɨkaitɨ,","poem":1},{"text":"'akwie kemɨyewa kananukanamɨkɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"'Ikɨ xekeneu'eni, nuiwarite,","poem":1},{"text":"yunaitɨ nuiwarite 'ateewa kietari:","poem":2},{"text":"Xekeneutihiwa kuyaxa miemekɨ,","poem":1},{"text":"xekanakawitekiexɨakuni.","poem":2},{"text":"Xekeneuyukuha'aritɨa kuyaxa xemuhukɨ,","poem":1},{"text":"xekanititsanariexɨakuni.","poem":2},{"text":"Xekeneuyukuha'aritɨa kuyaxa xemuhukɨ,","poem":1},{"text":"temɨxiki xepayeitɨarieni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yaxeketeneu'utɨa kexemɨteyurieni,","poem":1},{"text":"matsi kanitayeitɨariemɨkɨ,","poem":2},{"text":"Yaxeketeneuxata,","poem":1},{"text":"matsi mɨkɨ yapɨkatiyɨni,","poem":2},{"lineBreak":true},{"text":"Kakaɨyari tahamatɨa muyeikakɨ.","poem":2}]},{"type":"heading","content":["Kakaɨyari teke'ayemakaka"]},{"type":"verse","number":11,"content":["Yawé karima kaneniutahɨawe mɨpaɨ kanetinayehɨtɨani kename 'ikɨ teɨteri wahuye neka'uweiyani. Mɨpaɨ kanetiniutahɨawe:"]},{"type":"verse","number":12,"content":[{"text":"«Xeme 'ikɨ teɨteri 'iya memaye'unie memɨte'uterɨwa","poem":1},{"text":"xemeta mɨpaɨ mɨkɨ xepɨkate'uterɨwani,","poem":2},{"text":"tita mɨkɨ memɨtemakaxe xeme mɨkɨ xepɨkatemakaxeni,","poem":1},{"text":"meta xemɨmariutsiekakɨ xepɨkayupitɨaka.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yawé Naimekɨmɨtɨrɨkaɨye xeikɨa","poem":1},{"text":"xeme patsiekame xekanayeitɨakakuni,","poem":2},{"text":"mɨkɨ xeikɨa xekanayexeiyakakuni,","poem":1},{"text":"mɨkɨ xeikɨa xekanayemakaxekakuni.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yawé tuki kanihɨkɨtɨkamɨkɨ.","poem":2},{"text":"Matsi tete kanihɨkɨtɨkamɨkɨ hetsiena memɨtiketamɨrike","poem":1},{"text":"'Ixaheritsie nuiwarite memuyuhuta wahetsiemieme,","poem":2},{"lineBreak":true},{"text":"mɨkɨ tete puwarekaxɨrieni.","poem":2},{"text":"Kerutsareme kiekatari wahetsiemieme","poem":1},{"text":"Kaunari kanayeimɨkɨ meta winiyari.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yuwaɨkawatɨ mekanitiketamɨrixɨakuni,","poem":1},{"text":"mekanekaxɨrikuni meta mekanitimurixɨakuni.","poem":2},{"text":"Winiyari mekaniwɨtɨiyariekuni,","poem":1},{"text":"mɨkɨtsie mekaniwɨrikuni».","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kepemɨtiwatahekɨatɨanikɨ mɨ'ayumieme 'aixɨa ketineu'uta,","poem":1},{"text":"keneutseyuma 'inɨari niukiyari memɨnetsi'aweiya watsata.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yawé katiniuhayewa","poem":1},{"text":"Kakuwu kiekarieya xeiyatɨ,","poem":2},{"text":"peru ne hetsiena netiwiyatɨ nepɨta'ikwewani,","poem":1},{"text":"mɨkɨtsie kenemɨtita'ikwewa nekanexeiyani.","poem":2}]},{"type":"verse","number":18,"content":["'Ena xepɨnetsixeiya, neniwemama Yawé mɨnetsiyetuiri wahamatɨa. 'Ixaheritsie 'uxa'atɨni kemɨtiyɨni 'inɨari tepɨhɨkɨ Yawé Naimekɨmɨtɨrɨkaɨye hetsiemieme, Tsiyuni hɨriyaritsie 'amuka."]},{"type":"verse","number":19,"content":["Xɨka xewitɨ mɨpaɨ xerahɨaweni: «Mɨkite wahamatɨa memɨtekuxata meta memɨtehetimamateke wikixi wahepaɨ me'utiyuatɨ wahetsɨa tepɨta'iwauni, ¿tamɨ kareuyewetse teɨteri yukakaɨyarixi memɨwarahɨawenikɨ meta mɨkite, memu'uwa wahetsiemieme?»,"]},{"type":"verse","number":20,"content":["ne mɨpaɨ nekatinixehahɨaweni: «'Inɨari niukiyari meta kepemɨtiwatahekɨatɨanikɨ mɨ'ayumiemetsie xeketenewiyani». Kemɨ'ane mɨkɨtsie tiwiyatɨ mɨtihayewa, 'uxa'atɨni pɨkakahekɨariwiyarieni."]},{"type":"verse","number":21,"content":["Xeme xekaniyeha'akuni kepauka xemu'uximatɨarieka meta xeyehakakwitɨwetɨ kwiepa naitsarie xeku'uwatɨ. 'Ana teikɨ xehenenieretɨ, ti'aitame meta Kakaɨyari wahepaɨtsita 'axaxekanitiyuakuni,"]},{"type":"verse","number":22,"content":["meta kwiepa mekanenieretɨ, 'uximatɨarika xeikɨa mepɨxeiya, yɨriya meta marika 'etɨriya tsata, mewatiyɨwitsie yuheyemekɨ mekaneukaxɨriyakuni."]}],"footnotes":[{"noteId":2,"caller":"+","text":"Hepɨrayukɨ panuyɨne Kwitɨwa piinite mɨraye'atɨka pɨtiunawarie.","reference":{"chapter":8,"verse":1}},{"noteId":3,"caller":"+","text":"Kakaɨyari tahamatɨa muyeika.","reference":{"chapter":8,"verse":8}}]},"thisChapterLink":"/api/hch_wb2/ISA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}