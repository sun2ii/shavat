{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ISA","translationId":"hch_wb2","name":"Kitsariyaxi","commonName":"Kitsariyaxi","title":"Kitsariyaxi","order":23,"numberOfChapters":66,"sha256":"b10c206d4094d6343b9bd86cad4cbc90bd56558da6f39f9f64be17ce97662ddc","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hch_wb2/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":9,"content":[{"type":"heading","content":["Nunutsi tahetsɨa mutinuiwaxɨ"]},{"type":"verse","number":1,"content":["Mɨyatɨtɨ, tawarita 'etɨriya pɨkatixuawere kemɨ'ane mu'uximatɨariekai hetsiemieme. Meripaitɨ Kakaɨyari Tsawuruni kwieyari tixaɨtɨ pɨkarayeitɨa meta Nepɨtahari kwieyari, matsi 'uxa'atɨni Karereya hetsiemieme 'aixɨa katinaniuwamɨkɨ, memɨkahuriyutsixi wakwieyaritsie, haramara huyeyaritsie, Kurutani 'anutaɨye hetsie."]},{"type":"verse","number":2,"content":[{"text":"Teɨteri yuwipa memu'uwakai","poem":1},{"text":"hekɨariya mariweme mekaniuxeiya,","poem":2},{"text":"kemɨ'ane yɨriya 'a'ayetsuime hetsie memu'uwakai","poem":1},{"text":"hekɨariya kaniwaruhekɨariwiya.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Ekɨ nuiwari muwerenikɨ yapepɨtiuyuri,","poem":1},{"text":"waɨkawa temawierika pepɨwarupitɨa.","poem":2},{"text":"Mɨkɨ 'ahɨxie mepuyutemamawie","poem":1},{"text":"kepauka memuka'itsana hepaɨ,","poem":2},{"lineBreak":true},{"text":"kepauka mete'a'iwaka piinitɨarika memɨteyutapitɨwa hepaɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yemekɨ 'ekɨ pepitamuraxɨ,","poem":1},{"text":"Mariyani kemɨra'iwarie hepaɨ,","poem":2},{"text":"wayuku kemɨtiwa'aitɨakai waɨriyarika,","poem":1},{"text":"tepɨa kemɨrahete memanakatekakai,","poem":2},{"lineBreak":true},{"text":"'itsɨ ti'aitame waɨkawamekɨ kemɨtiwara'ikatɨakai.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Naitɨ kakai kuyaxamieme","poem":1},{"text":"'imieritsata manɨkɨ,","poem":2},{"text":"meta kamixate naitɨ xuriya mɨwetɨka","poem":1},{"text":"taipa katineuwiwiyamɨkɨ,","poem":2},{"lineBreak":true},{"text":"nerɨkwari kanitixɨtsitɨamɨkɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Matsi nunutsi tahetsɨa mutinuiwaxɨkɨ,","poem":1},{"text":"'uki xeime tekaniutuitɨarieni,","poem":2},{"text":"tɨrɨkariya naiparieyatsie kanika'uxipimɨkɨ,","poem":1},{"text":"meta 'ipaɨ katiniterɨwariemɨkɨ:","poem":2},{"text":"'Ɨxatsitame, mɨmariwe, Kakaɨyari mɨtɨrɨkaɨye,","poem":1},{"text":"Yuheyemekɨ mɨtapaapa, Ti'aitame kayuwatɨ tiyupitɨwame.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kemɨti'aitanikɨ kanitamɨirimɨkɨ meta kayuwatɨ kemɨtiyupitɨwakɨ,","poem":1},{"text":"meta mɨkɨ pɨka'uye'atɨyani.","poem":2},{"text":"Rawiri 'uwenieyatsie 'akaitɨ katinita'aitamɨkɨ","poem":1},{"text":"meta hakewa mɨre'aitakaitsie,","poem":2},{"text":"'amuwenikɨ meta mituikanikɨ","poem":1},{"text":"heitseriemekɨ meta kemɨreuyewetse","poem":2},{"lineBreak":true},{"text":"hikɨ meta yuheyemekɨ.","poem":2},{"text":"'Ikɨ yakatinaye'atɨamɨkɨ","poem":1},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye 'ɨtetsarikaya.","poem":2}]},{"type":"heading","content":["Yawé kemɨtiuyeha'a 'ixaheritsixi wahepaɨtsita"]},{"type":"verse","number":8,"content":[{"text":"Yawé yuniuki kaneyenɨ'ani,","poem":1},{"text":"Kakuwu hepaɨtsita kaneiyenɨ'ani,","poem":2},{"lineBreak":true},{"text":"'Ixaheri hetsie kaniukaweni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Ikɨ hepaɨtsita yunaitɨ teɨteri mepɨtehetimamateke","poem":1},{"text":"―'Epɨrahini meta Tsamariya kiekatari―,","poem":2},{"text":"yunaitɨ meyuti'ɨretɨ mɨpaɨ memutiyuane","poem":1},{"text":"meta yu'iyaritsie meyɨwaweme meyu'erietɨ:","poem":2}]},{"type":"verse","number":10,"content":[{"text":"«Xɨka xɨnariya 'uka'une,","poem":1},{"text":"tetexi xitekietɨkaimekɨ tekanitawewiekuni,","poem":2},{"text":"xɨka piní pikaxiyari 'anuyexɨrieni,","poem":1},{"text":"kariuxa pikaxiyarikɨ tekanenukahekwatɨakuni».","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Peru Yawé matsi kaniwatɨrɨkariyamɨkɨ","poem":1},{"text":"Xetsini memaye'unie,","poem":2},{"lineBreak":true},{"text":"memeye'unie kaniwarukuyuitɨani.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tsiriyutsixi tau makayuyuipike hepatsie kiekatari,","poem":1},{"text":"meta piritsiteutsixi tau manatineika hepatsie kiekatari","poem":2},{"lineBreak":true},{"text":"'Ixaheri mekaniutakwani xeikwaiyarikɨ.","poem":2},{"lineBreak":true},{"text":"Tsepanetɨ 'ikɨ naitɨ mɨyamɨtiɨyɨ,","poem":1},{"text":"Kakaɨyari haxɨaya pukaheunuawe,","poem":2},{"lineBreak":true},{"text":"matsi 'akuxi yumamá kanitatseratɨkani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Peru teɨteri mɨpaɨ mepɨkatehetimaiwawe","poem":1},{"text":"kemɨ'ane mɨyɨane mɨtiwakwinitɨa,","poem":2},{"lineBreak":true},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye mepɨkatiwauwawe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Ayumieme xeitukaritsie","poem":1},{"text":"Yawé 'Ixaheri mu'uya","poem":2},{"text":"kananutixitemɨkɨ meta kwaxieya,","poem":1},{"text":"takɨ meta haka.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Ukirawetsixi mu'u mekanihɨkɨtɨni","poem":1},{"text":"meta teɨteri waɨkawa memauka'u mepɨhɨkɨ.","poem":2},{"text":"Kakaɨyari niukametemama kwaxi mekanihɨkɨtɨni,","poem":1},{"text":"te'ɨkitamete memɨte'itawa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kemɨ'ane 'ikɨ kiekari memuwitɨxime mepeiyehɨa,","poem":1},{"text":"kemɨ'ane memuwitɨkiexime mepɨ'iyɨrie.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"'Ayumieme Ti'aitame temari 'aixɨari pɨkatiwaxeiya,","poem":1},{"text":"nutuite meta wiuraxi pɨkawatinenimayata,","poem":2},{"text":"mɨkɨ yunaitɨ 'axamemɨteyuruwametekɨ,","poem":1},{"text":"wateni 'axamɨti'anene pɨtikuxata.","poem":2},{"lineBreak":true},{"text":"Tsepanetɨ 'ikɨ naitɨ mɨyamɨtiɨyɨ,","poem":1},{"text":"Kakaɨyari haxɨaya pukaheunuawe,","poem":2},{"lineBreak":true},{"text":"matsi 'akuxi yumamá kanitatseratɨkani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"'Axamɨti'ane tai hepaɨ panutitetere","poem":1},{"text":"'ɨtsi meta xuya mɨtixɨxɨtsitɨwa,","poem":2},{"text":"meta kɨyexi 'amayetsuye mɨtaiyawe","poem":1},{"text":"hikɨ panutiyeika teɨka hepaɨ,","poem":2},{"lineBreak":true},{"text":"kɨtsi 'a'utewime hetsie.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yawé Naimekɨmɨtɨrɨkaɨye haxɨayakɨ","poem":1},{"text":"kwie taikɨ kananutataimɨkɨ.","poem":2},{"text":"Teɨteri mɨtitaiwawe mepakɨne:","poem":1},{"text":"'Ana nixewitɨ yu'iwa pɨkatinenimayata.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hipatɨ tita watserieta mɨtitipika mepɨtetikwani,","poem":1},{"text":"matsi yaxeikɨa mepɨteheuhaakakwikuni,","poem":2},{"text":"hipatɨta tita wa'utata mɨtitipika mepɨtetikwani,","poem":1},{"text":"peru yaxeikɨa mepɨkatihuxani.","poem":2},{"lineBreak":true},{"text":"Yuniwema mekaniwatikwaikuni.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Manatsexi 'Epɨrahini kanitakwaimɨkɨ,","poem":1},{"text":"meta 'Epɨrahini Manatsexi kanitakwaimɨkɨ,","poem":2},{"lineBreak":true},{"text":"mɨkɨ meyunɨtɨ yuhutatɨ Kura mekanitamiekuni.","poem":2},{"lineBreak":true},{"text":"Tsepanetɨ 'ikɨ naitɨ mɨyamɨtiɨyɨ,","poem":1},{"text":"Kakaɨyari haxɨaya pukaheunuawe,","poem":2},{"lineBreak":true},{"text":"matsi 'akuxi yumamá kanitatseratɨkani.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ISA/8.json","previousChapterAudioLinks":{},"numberOfVerses":21}