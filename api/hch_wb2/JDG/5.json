{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JDG","translationId":"hch_wb2","name":"'Itsɨkate","commonName":"'Itsɨkate","title":"'Itsɨkate","order":7,"numberOfChapters":21,"sha256":"e0d62525e7956106b911a82bfc4afa867d2f7ccebde31a9fb82a295339bc052f","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/hch_wb2/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":5,"content":[{"type":"heading","content":["Rewura kwikarieya"]},{"type":"verse","number":1,"content":["Mɨkɨ tukaritsie Rewura meta Waraki 'Awinuhani nu'aya mɨpaɨ mekateniukwika:"]},{"type":"verse","number":2,"content":[{"text":"«Kepauka te'aitamete 'ixaheritsixi memɨte'aita,","poem":1},{"text":"kepauka teɨteri yɨkɨmana memɨyuwaɨriya,","poem":2},{"lineBreak":true},{"text":"Yawé 'aixɨa ke'itɨarieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"»Xekeneu'enana, te'aitamete. Xekene'enanaka xemɨte'aita.","poem":1},{"text":"Ne nepɨtakwika, Yawé nepɨtanɨawa,","poem":2},{"lineBreak":true},{"text":"nepɨtikayuitɨani Yawé hetsiemieme, 'ixaheritsixi wakakaɨyari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"»Yawé, kepauka Tsehixi hetsie pemɨyetɨa,","poem":1},{"lineBreak":true},{"text":"kepauka 'Erumi kwieyaritsie pemuyemiekai,","poem":1},{"text":"kwie putayua,","poem":2},{"lineBreak":true},{"text":"muyuawitsie mepɨwatayua,","poem":2},{"lineBreak":true},{"text":"haiwitɨri haa putayeuri.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hɨrite putiyɨyɨakaxɨ","poem":1},{"text":"Yawé mexeiyatɨ, Kakaɨyari Tsinahi kiekame,","poem":2},{"lineBreak":true},{"text":"Yawé mexeiyatɨ, 'ixaheritsixi wakakaɨyari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"»Kepauka Tsamɨkaxi muyeikakaitsie 'Anati nu'aya,","poem":1},{"text":"kepauka Kaheri muyeikakaitsie,","poem":2},{"lineBreak":true},{"text":"kɨkamete huye mekaniuku'eirieni","poem":2},{"lineBreak":true},{"text":"'axamɨtiu'anetsie mekaneukuyune.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Memeuyutakwiwawekai 'Ixaheri hetsɨa miemete mekaniukumaware,","poem":1},{"text":"mepumawekai, kepaukake ne nemanukuke,","poem":2},{"text":"Ne, Rewura, nepanukuke","poem":1},{"text":"'ixaheritsixi wamaama hepaɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kepauka kakaɨyarixi hipame memɨwaranayexei,","poem":1},{"text":"kuyaxa ninuani kiekari kitenie,","poem":2},{"text":"huta tewiyari miriyari (40.000) 'ixaheritsixi nepɨwaruxei","poem":1},{"text":"pitsika mepɨkahexeiyakai meta kɨmana memɨyukunarɨma tepɨa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Ixaheritsixi memanuyetei wahamatɨa ne'iyari puyeika,","poem":1},{"text":"memɨyuwaɨriya wahamatɨa.","poem":2},{"lineBreak":true},{"text":"Yawé 'aixɨa ke'itɨarieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"»Xeme puxuri memeutuxatsie xemanutiyaxike","poem":1},{"text":"'ixuriki xe'anayeweratɨ xemayaxike,","poem":2},{"text":"xemeta, huyeta xemuhu,","poem":1},{"text":"mɨpaɨ xeketeku'eriwani.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kwikari mayuane tewaxi mematiharewetsie,","poem":1},{"text":"Yawé heitserie kemɨtiuyuri pɨtikuxata,","poem":2},{"lineBreak":true},{"text":"kuyaximama 'ixaheritsixi ke'aixɨa memɨteyurie.","poem":2},{"text":"Hikɨ Yawé kuyaximama","poem":1},{"text":"mekaniu'axɨani kiekari kitenie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"»Rewura, kenanutanieri, kenanutanieri.","poem":1},{"text":"Kenanutanieri, kenanutanieri, kwikari keneutakwika.","poem":2},{"text":"Kenanukukexi, Waraki 'Awinuhani nu'aya,","poem":1},{"text":"'apɨretsutsixi keniwaranuhapani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"»Memutawikwei wa'ukiyarima","poem":1},{"text":"te'aitamete wahetsɨa mekanekɨne,","poem":2},{"text":"Yawé kuyaximama","poem":1},{"text":"nehetsɨa mepu'axɨa kwinimieme memɨteyɨwawe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hipatɨ 'Epɨrahini hetsie mekanayenexɨani","poem":1},{"text":"meta 'Amareki nuiwarieyatsie,","poem":2},{"lineBreak":true},{"text":"Wenikamini xiɨyarimama mepɨwanɨkai 'iya memɨxe'uweiyakai.","poem":2},{"text":"Makixi memakanexɨa kuyaxi memanuyetei,","poem":1},{"text":"Tsawuruni memayenexɨa, 'itsɨ ti'aitame memu'ɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Rewura hamatɨa matɨari te'aitamete mepuhukai 'Itsakaxi xiɨyarimama.","poem":1},{"text":"'Itsakaxi Waraki hamatɨa kaniuyeikakaitɨni,","poem":2},{"lineBreak":true},{"text":"mɨkɨ 'utɨa kaneyani mayeweritsie paitɨ.","poem":2},{"text":"Xuweni kuyaximama mariwemekɨ mete'utaxataka","poem":1},{"text":"yamepɨkatekakɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Matsi pɨta yukie mekanitiyaxe me'atinaitɨ","poem":1},{"text":"muxatsi wahɨwemete wahiwari wawikɨari meta'enietɨ.","poem":2},{"text":"Xuweni nuiwarimama","poem":1},{"text":"niuki mekanixɨatɨakaitɨni.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Karaha Kurutani manuyeka matsi humapaitɨ kaniukateitɨni.","poem":1},{"text":"Rani, ¿titayari nawiyatsixi wahamatɨa tiuyuhayewaxɨ?","poem":2},{"text":"'Atsexi, haramara tetsita kaniuyuhayewa,","poem":1},{"text":"haramara meutawetɨkatsie kaniuyuhayewa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tsawuruni teɨterimama yutukari mepɨyetua","poem":1},{"text":"kepauka memukwi,","poem":2},{"text":"Nepɨtahari kemuyɨ","poem":1},{"text":"hɨritsie meheyukukwika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"»Te'aitamete me'u'axɨaka mekaniuyutakwini haa mayema Mekiru 'aurie,","poem":1},{"text":"Te'aitamete Kanani miemete Tanaki mekaniuyutakwini,","poem":2},{"text":"peru pɨrata mepɨkahetɨ meta kakuni kwinieraye'atɨ mɨrayepine.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Muyuawitsie xurawetsixi mekaniuyutakwini,","poem":1},{"text":"memanuyeteitsie paitɨ me'uyetetɨ Tsitsara mekaniutamieni.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Haa kwinimieme mɨtitɨrɨkaɨye Kitsuni kaniwarehautsitɨani,","poem":1},{"text":"haa xeiya muhane meripaimieme, Kitsuni kwinimieme mɨtitɨrɨkaɨye.","poem":2},{"lineBreak":true},{"text":"Keneumieni, ne'iyari, 'atɨrɨkarima.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Muratsixi wakeya payuane,","poem":1},{"text":"muwa mepanautsaxɨaxime, muwa mepanautsaxɨaxime kawayutsixi memɨtɨrɨkawi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yawé niuki tuayameya mɨpaɨ kaniutayɨni: “Merutsi 'axakeneuyuri 'iya.","poem":1},{"text":"'Axakeniwaruyuri teuterimama waɨkawamekɨ,","poem":2},{"text":"Yawé memɨkahekuparewikɨ,","poem":1},{"text":"Yawé memɨka'uparewikɨ meta hetsɨana miemete memɨkawaruparewikɨ”.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"»Kaheri kehɨkɨtɨni, Hewexi Keni tewiyari 'ɨyaya,","poem":1},{"text":"waɨkawa 'aixɨa mɨ'itɨarie,","poem":2},{"text":"waɨkawa 'aixɨa mɨ'itɨarie xamaruta memeutei.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tsitsara haa 'uta'iwauku, Kaheri retsi kani'itɨani,","poem":1},{"text":"'aixɨa memɨte'u'iyari wawatsuta retsi kwamariekame kani'itɨani.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Yu'utakɨ kɨye kaniutikweni,","poem":1},{"text":"yu'aixɨakɨ tepɨa titsuname tiutikwei.","poem":2},{"text":"Tsitsara mu'uyatsie kaneitsuna,","poem":1},{"text":"kanatana kananeni.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"'Ɨkatɨana kaniukaweni,","poem":1},{"text":"mana 'ukaweka mana kaniuhuni.","poem":2},{"text":"Manuwekai kaniukaweni,","poem":1},{"text":"mana kaniukaweni mɨkitɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"»Tsitsara maamaya kii 'etsimayewatsie kananiere,","poem":1},{"text":"waɨkawa 'iyarixietɨ mɨpaɨ katiniuhiwa:","poem":2},{"text":"“¿Titayari kaxetaya hawaikɨ karamie?","poem":1},{"text":"¿Titayari kaxetate wayuariya kara'eniɨriɨkɨ?”","poem":2}]},{"type":"verse","number":29,"content":[{"text":"'Ukarawetsixi kwinimieme memɨtemaiwawe mɨpaɨ mekaniutiyuani,","poem":1},{"text":"mɨkɨta yaxeikɨa kanaineni:","poem":2}]},{"type":"verse","number":30,"content":[{"text":"“Mekateneyutapitɨwani piinite, tita memɨtewarenawairi:","poem":1},{"text":"yuxexuime yatɨ yuhuhutame 'ukari yuxexuitɨ kuyaxi,","poem":2},{"text":"'ixuriki witsimɨ'anene Tsitsara hetsiemieme,","poem":1},{"text":"xeime 'ixuriki, yatɨ hutame, witsimɨ'anene muxutɨka nekɨipitɨamieme.","poem":2},{"lineBreak":true},{"text":"Naitɨ 'ikɨ 'iya tiwapiinite”.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"»Mɨpaɨ mekete'ukwini yunaitɨ Yawé, memɨmatsi'aye'unie.","poem":1},{"lineBreak":true},{"text":"Peru kemɨ'ane mɨmatsinaki'erie, tau hepaɨ ke'aneni kepauka maneika xawatɨtɨ».","poem":1},"Hikɨ 'ixaheritsixi kayuwatɨ mekanexeiyakaitɨni huta tewiyari wiyari."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}