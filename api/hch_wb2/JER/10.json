{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JER","translationId":"hch_wb2","name":"Keremiyaxi","commonName":"Keremiyaxi","title":"Keremiyaxi","order":24,"numberOfChapters":52,"sha256":"771a2352ddb97ef3895e81db88d089eedf1f7c4caac6b2b7f4b4d6b3602b468f","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/hch_wb2/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":10,"content":[{"type":"heading","content":["Kakaɨyari meta kakaɨyarixi"]},{"type":"verse","number":1,"content":["'Ixaheritsixi teɨteriyari, xekeneu'eni Yawé niukieya."]},{"type":"verse","number":2,"content":["Mɨpaɨ kanaineni:",{"text":"«Xeme xepɨkawa'ɨkeni hipatɨ nuiwarite kememɨteyurie,","poem":1},{"text":"meta xepɨkamamaka 'inɨari muyuawitsie miemekɨ,","poem":2},{"lineBreak":true},{"text":"tsepa hipatɨ nuiwarite memimakaxe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Teɨteri wayeiyari","poem":1},{"text":"tixaɨtɨ pɨkatihɨkɨ.","poem":2},{"text":"Kɨye mepawiteke 'ɨtsita,","poem":1},{"text":"kɨyekɨ mɨti'uximayatawe pititsatsewe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hurukɨ meta pɨratakɨ witsi'aneme mepayeitɨwa,","poem":1},{"text":"kɨrapuxikɨ menikutseiriyani meta titsunamekɨ","poem":2},{"lineBreak":true},{"text":"mɨkawatayuanenikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"»Wakakaɨyarixima mepɨkaniuwawe,","poem":1},{"text":"'ewieri wikixi wamariutame hepaɨ mepɨtematsiɨkɨ","poem":2},{"lineBreak":true},{"text":"xutsi ma'etsietsie muwe hepaɨ.","poem":2},{"text":"Peuyewetse memɨkɨtɨkietɨweni","poem":1},{"text":"memɨka'ɨkɨniwawekɨ.","poem":2},{"text":"Xepɨkawamakarɨka,","poem":1},{"text":"'axamemɨxe'uyurieni mepɨkayɨwawe,","poem":2},{"lineBreak":true},{"text":"metatsiere 'aixɨa memɨxe'uyurieni».","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yawé, xewitɨ pumawe 'ahepaɨ 'anetɨ.","poem":1},{"text":"Pepɨmariwe 'ekɨ,","poem":2},{"lineBreak":true},{"text":"'ekɨ yemekɨ pepɨmariwe meta pepɨtɨrɨkaɨye.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"¿Kemɨ'ane pɨka'itimakani, yunaime nuiwarite Tiwa'aitɨwame?","poem":1},{"text":"'Ekɨ mɨpaɨ pɨreuyewetse 'ahetsiemieme.","poem":2},{"text":"Yunaitɨ memɨtemaiwawe memu'uwa watsata,","poem":1},{"text":"meta yunaitɨ te'aitamete watsata,","poem":2},{"lineBreak":true},{"text":"xewitɨ pumawe 'ahepaɨ 'anetɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yunaitɨ mepɨka'u'iyari 'axamemɨteyurienikɨ xeikɨa pɨwanake,","poem":1},{"text":"kɨyexi kakaɨyarixiyari 'ɨxatsitamete mepɨhɨkɨ wahetsiemieme.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Taritsi paitɨ patɨwa pɨrata 'etsimutsutsui,","poem":1},{"text":"meta 'Upatsi huru patɨwa.","poem":2},{"text":"Memɨkakakaɨyarixi wa'ɨkiyari, mɨtataɨrawi meta mɨxeta memanakatɨtɨka,","poem":1},{"text":"teɨteri tewewiwamete meta tepɨa kwaniyamete","poem":2},{"lineBreak":true},{"text":"mɨkɨ yunaitɨ wawewiya mepɨhɨkɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Peru Yawé xeikɨa yuri Kakaɨyari kanihɨkɨtɨni,","poem":1},{"text":"Kakaɨyari mayeyuri, yuheyemekɨ Ti'aitame.","poem":2},{"text":"Kepauka muyeha'arɨwe, kwie kanewatayuaneni,","poem":1},{"text":"nuiwarite haxɨaya memunewieni mepɨkayɨwawe.","poem":2}]},{"type":"verse","number":11,"content":["«Mɨpaɨ pepɨtiwatahɨawe: “Mɨkɨ kakaɨyarixi muyuawi memɨka'utawewi meta kwie, mekanikumawerikuni 'ena kwiepa meta muyuawi hetɨa”»."]},{"type":"verse","number":12,"content":[{"text":"Kakaɨyari kwie kaniutawewieni yutɨrɨkariyakɨ,","poem":1},{"text":"kemɨtimaiwekɨ kwie 'aixɨa katiniuyeni,","poem":2},{"lineBreak":true},{"text":"muyuawi 'ayeume kanayeitɨani kemɨtimaiwekɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kepauka mɨkɨ mɨtaniuni,","poem":1},{"text":"tɨranarikɨ haa muyuawitsie pakaneika,","poem":2},{"text":"hai kanewa'iniwani","poem":1},{"text":"kwie manuye'atɨka paitɨ.","poem":2},{"text":"Mimierɨkaritsata wiyeri kaneyenɨ'awani,","poem":1},{"text":"meta 'eka muye'ɨnetɨkatsie peiyepiwa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Teɨteri 'atsimemɨkatemate meta memɨte'ukatawe'erie mepɨhɨkɨ,","poem":1},{"text":"kakaɨyarixi wawewiwamete mepuyutetewiya yuwewiyakɨ.","poem":2},{"text":"Tita memɨtewewie pɨti'itarika,","poem":1},{"text":"meta mepɨka'ayeneniere.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tixaɨtɨ mepɨkateyunaki'erie, wawewiya pɨnanaiyɨkɨ xeikɨa,","poem":1},{"text":"kepauka tukari maye'ani memɨtekwinitɨarienitsie, mepɨka'unarieni.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kakaɨyari Kakuwu manayexei nuiwarieya mayanikɨ mɨkɨ wahepaɨ pɨka'ane,","poem":1},{"text":"matsi mɨkɨ naime mɨtiunetɨa kanihɨkɨtɨni,","poem":2},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye katinitewaka,","poem":1},{"text":"meta nuiwarieya 'Ixaheri kanihɨkɨtɨni.","poem":2}]},{"type":"heading","content":["Kememɨteka'unarieni peutihura"]},{"type":"verse","number":17,"content":[{"text":"'Apiinite ketineukuteɨxi kwiepa,","poem":1},{"text":"'ekɨ 'akiekari manutinamie.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Karikɨ mɨpaɨ kanaineni Yawé:","poem":1},{"lineBreak":true},{"text":"«Hikɨrixɨa 'ikɨ kwieyaritsie kiekatari 'ateewa neniwarexɨrimɨkɨ","poem":1},{"text":"texupamekɨ nemɨwarexɨrieni hepaɨ.","poem":2},{"text":"Hura meti'uitɨariekame nekaniwarayeitɨamɨkɨ,","poem":1},{"text":"meta yanekatiniwapitɨamɨkɨ mɨkɨ memɨtiwiyarienikɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Xɨa'ui ne, nepeutimurariexɨa.","poem":1},{"text":"Kenemɨtiukwinitɨarie pɨkayu'uayemarinɨa.","poem":2},{"text":"Peru pɨnekwiniya","poem":1},{"text":"peuyewetse neminewieka.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Naitɨ nexamaru puka'unarie,","poem":1},{"text":"meta naitɨ pɨteteki nekaunarite.","poem":2},{"text":"Neniwema 'ukitsi yunaitɨ mepɨnetsi'uku'eiri,","poem":1},{"text":"mepɨka'u'uwari.","poem":2},{"text":"Xewitɨri pumawe nexamaru mɨtawewieni,","poem":1},{"text":"meta ne'ixuriki kiiyari mɨkawieni.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Muxatsi wahɨwemete 'atsimekatemaitɨ mepakɨ,","poem":1},{"text":"Yawé mepɨka'utiwau,","poem":2},{"text":"'ayumieme kememɨteku'eriwakai yapɨkatiuyɨ,","poem":1},{"text":"wamuxatsi naitsarie mepeutaxɨriexɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Xekeneu'enana. Niuki kani'atɨarieni.","poem":1},{"text":"Tɨranari 'upamie tayeta kiekatari wahetsɨa payeneni,","poem":2},{"text":"Kura kiekariyari tepayani","poem":1},{"text":"yawixi memayu'eririya wakie, kii 'unimeyari kwinienetɨ muwe kanayeimɨkɨ.","poem":2}]},{"type":"heading","content":["Keremiyaxi nenewierieya"]},{"type":"verse","number":23,"content":[{"text":"Yawé, ne nepɨtimate tewi","poem":1},{"text":"yutukari pɨkakutsiyari,","poem":2},{"text":"pɨkapitɨarie yeikame","poem":1},{"text":"kemɨtinake mumieni.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yawé, keneneutaheitseritɨa perutsɨ heitseriemekɨ,","poem":1},{"text":"hawaikɨ 'ahaxɨakɨ, mɨpaɨ pekaneniuka'unaweni.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Hipame nuiwarite wahetsie pɨta 'ahaxɨa keneukanɨ'a,","poem":1},{"text":"memɨkamatsimate wahetsie,","poem":2},{"lineBreak":true},{"text":"meta 'iya memɨkamatsihahɨawe wahetsie.","poem":2},{"text":"Karikɨ Kakuwu mekaniutakwani,","poem":1},{"text":"naime mekanaxɨni,","poem":2},{"lineBreak":true},{"text":"meta kiena makumawe mekanayeitɨani.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JER/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JER/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JER/9.json","previousChapterAudioLinks":{},"numberOfVerses":25}