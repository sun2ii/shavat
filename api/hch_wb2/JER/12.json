{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JER","translationId":"hch_wb2","name":"Keremiyaxi","commonName":"Keremiyaxi","title":"Keremiyaxi","order":24,"numberOfChapters":52,"sha256":"771a2352ddb97ef3895e81db88d089eedf1f7c4caac6b2b7f4b4d6b3602b468f","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/hch_wb2/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":12,"content":[{"type":"heading","content":["Keremiyaxi Kakaɨyari kemɨtiutahɨawixɨ"]},{"type":"verse","number":1,"content":[{"text":"'Ekɨ, Yawé heitseriemekɨ pekatinikuxatani","poem":1},{"text":"kepauka nemɨniukixie 'ahamatɨa.","poem":2},{"text":"Matsi hikɨ nepɨmatitaxatɨanikeyuta","poem":1},{"text":"'etsiwa tita mɨtiheitserie hepaɨtsita.","poem":2},{"text":"¿Titayari 'axamemɨte'u'iyari 'aixɨa mete'itɨarie?","poem":1},{"text":"¿Titayari teyukwamanamete kayuwatɨ mete'u'uwa?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Ekɨ pepɨwaruka'etsa, mɨkɨta mepananayata,","poem":1},{"text":"mepɨtiwawere meta mepukaxuxuawere.","poem":2},{"text":"Yutenikɨ mepɨmatsinɨawa,","poem":1},{"text":"peru wa'iyaritsie pepɨkayeka.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yawé, 'ekɨ ne pepɨnetsimate,","poem":1},{"text":"'ekɨ pepɨnetsixeiya meta pepɨtimate kenemɨtinewaɨriya 'ahetsiemieme.","poem":2},{"text":"Keniwaranuhapani, muxatsi memɨkwi'iwa wahepaɨ,","poem":1},{"text":"keniwaranuyeteɨxi 'iya tukaritsie memɨkwi'iwakɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"¿Kepaukake pɨkawiye 'ena kwiepa,","poem":1},{"text":"kepaukake pɨtitiyɨra tupiriyate?","poem":2},{"text":"Yeutari meta memɨte'awɨwawe mepɨkwi'i","poem":1},{"text":"teɨteri 'axamemɨte'uyurikɨ 'ikɨ kwieyaritsie kiekatari,","poem":2},{"text":"memuyuwaɨriya mɨpaɨ memɨtiyuanikɨ:","poem":1},{"text":"«Kakaɨyari kepauka temeuyeweni pɨkatatsixeiya».","poem":2}]},{"type":"heading","content":["Kakaɨyari kemɨtiuta'a"]},{"type":"verse","number":5,"content":[{"text":"«Xɨka teɨteri memanautsawawe wahamatɨa pe'uti'uxikeni,","poem":1},{"text":"¿Kehepaɨ petiwaruta'iwawe kawayutsixi?","poem":2},{"text":"Xɨka pehekawautseni makuweritsie,","poem":1},{"text":"¿kepeyɨniri Kurutani mu'ɨtsiyatsie?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'A'iwamatɨtɨ, 'axeikɨa nunuiwakate,","poem":1},{"text":"mepɨmetsi'uku'eiri meta 'axameputiyuane 'ahepaɨtsita.","poem":2},{"text":"Tsepa waɨkawa witsimemɨmetekɨhɨawe,","poem":1},{"text":"yuri pepɨkatiwa'eririeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"»Neteɨterima nepuwaruku'eiri,","poem":1},{"text":"tita mɨtinepiinitɨkai nepiku'eiri,","poem":2},{"text":"neteɨterima nemɨwanaki'erie nepuwayetua","poem":1},{"text":"memɨwaraye'unie wahetsɨa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nepiinite nemɨtiwayetuirienikekai nehepaɨtsita","poem":1},{"text":"mayetsi wahepaɨ meputiyuane.","poem":2},{"text":"Mepɨnetsikukewe tɨma,","poem":1},{"text":"'ayumieme nepɨwaxani'erie.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nehetsiemieme neteɨterima","poem":1},{"text":"wiki witsimeu'ane hepaɨ nepɨtiwaxeiyakai","poem":2},{"lineBreak":true},{"text":"memimietɨwe wirɨkɨxi.","poem":2},{"text":"Xekenehu, xekeniwarukuxeɨri yunaime yeutari.","poem":1},{"text":"Xekeniwa'atɨa memitakwanikɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yuwaɨkawatɨ muxatsi wahɨwemete nekaxie haraweriyari mepuka'unaxɨ,","poem":1},{"text":"nekwie naime mepakuketsi,","poem":2},{"text":"neharaweri witsimɨ'anekai","poem":1},{"text":"makumawe mepayeitɨa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Unime mepuhayewaxɨ,","poem":1},{"text":"'akuwakime meta 'akumaweme nehɨxie,","poem":2},{"text":"naitɨ 'ikɨ kwieyari puka'unarie","poem":1},{"text":"nixewitɨ mɨkaheiyehɨwakɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Naitsarie makumawetsie yemurite mɨtiteitsie","poem":1},{"text":"mekaniu'axɨani teyumemiwamete.","poem":2},{"text":"Yawé 'ixiparaya 'ikɨ kwieyari kanika'unamɨkɨ","poem":1},{"text":"naime 'etsiwatɨma yayeume pɨkahayewa,","poem":2},{"lineBreak":true},{"text":"meta nixewitɨ kayuwatɨ pɨkahexeiyani.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tɨriku mepuka'e hikɨ xuya mepuka'itsanaxɨ,","poem":1},{"text":"yakɨ xeikɨa pɨratɨa wa'uxiya.","poem":2},{"text":"Yawé waɨkawa mɨha'akɨ","poem":1},{"text":"mepuyutitetewiya tita memɨte'uka'itsanaxɨkɨ».","poem":2}]},{"type":"verse","number":14,"content":["Yawé mɨpaɨ kanaineni: «Yunaitɨ teɨteri 'auriena kiekatari 'axamemɨte'u'iyari neteɨterima 'ixaheritsixi tita nemɨtiwarumi memɨte'umayɨa, nepuwarahuna wakwiepa, meta Kura xiɨyarimama watsata nekaniwaxɨnamɨkɨ."]},{"type":"verse","number":15,"content":["'Arike newarahuname, nekaniwatinenimayatamɨkɨ, nekaniwa'atɨamɨkɨ yuxexuime wakwietsie nemɨwayetuiritsie."]},{"type":"verse","number":16,"content":["Xɨka yemekɨ meheitimani neteɨterima wahuye, mɨpaɨ kememɨtewaru'ɨkitɨakai neteɨterima Wahari hetsiemieme kememɨteyɨhɨritɨakakɨ, mɨpaɨ xɨka metehetimani kenemɨtitewakɨ xɨka meyuhɨritɨatɨ mɨpaɨ me'utiyuani: “Yawé 'ake'uyeikani yemekɨ”, hikɨ 'ana neteɨterima watsata mekaniyuhayewakuni."]},{"type":"verse","number":17,"content":["Peru kemɨ'ane nuiwari mɨkaheu'enani, yuheyemekɨ nepikumaweriya meta nepɨwaka'una», Yawé mɨpaɨ kanaineni."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JER/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JER/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JER/11.json","previousChapterAudioLinks":{},"numberOfVerses":17}