{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JER","translationId":"hch_wb2","name":"Keremiyaxi","commonName":"Keremiyaxi","title":"Keremiyaxi","order":24,"numberOfChapters":52,"sha256":"771a2352ddb97ef3895e81db88d089eedf1f7c4caac6b2b7f4b4d6b3602b468f","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/hch_wb2/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":13,"content":[{"type":"heading","content":["Rinu hɨiyameyari"]},{"type":"verse","number":1,"content":["Yawé mɨpaɨ kanetiniutahɨawe: «Rinu hɨiyameyari keneu'ananairi kena'ahɨa kɨmana, peru pepɨka'itahawiyani»."]},{"type":"verse","number":2,"content":["Yawé kemɨnetiuta'aitɨakai, hɨiyame nekaniunaneni kɨmana nekanayɨhɨani."]},{"type":"verse","number":3,"content":["Hikɨ Yawé hutarieka mɨpaɨ kanetiniutahɨawe:"]},{"type":"verse","number":4,"content":["«Hɨiyame pemunanai pemenakuteka kenahurietɨ, Perati paitɨ kenemie, mana keneti'awieta 'aita mukataritɨkata»."]},{"type":"verse","number":5,"content":["Hikɨ nekaneyani Perati paitɨ nekaneiti'awieta, Yawé kemɨnerahɨawekai."]},{"type":"verse","number":6,"content":["Mɨixa tukari 'anukayaku, Yawé mɨpaɨ kanetiniutahɨawe: «Perati kenemie hɨiyame kenewaumie nemetsi'uta'aitɨa pemeiti'awietakɨ muwa»."]},{"type":"verse","number":7,"content":["Perati nekaneyani, hakewa hɨiyame nemeti'awietakai nekanewatihurieni, peru 'axani'anekaitɨniri kanipɨnikaitɨni tixaɨtɨkɨ pɨkatiyunaki'eriekairi."]},{"type":"verse","number":8,"content":["Hikɨ Yawé mɨpaɨ tawari kanetiniutahɨawe:"]},{"type":"verse","number":9,"content":["«Mɨpaɨ kanaineni Yawé: “Mɨkɨ kemɨ'ane mɨpaɨ nekatiniwaka'uniriemɨkɨ Kura xiɨyarimama kememɨteyuti'ɨre metatsiere Kerutsareme kiekatari."]},{"type":"verse","number":10,"content":["'Ikɨ teɨteri 'axamemɨte'u'iyari, memɨkayuwaɨriya yamemɨtekakɨnekɨ kenemɨti'aita, yu'iyari mukaheu'ena memuweiya meta hipame kakaɨyarixi memɨwarayexeiya, 'ikɨ hɨiyame tixaɨtɨ mɨkatiyunaki'erie hepaɨ mepɨyɨni."]},{"type":"verse","number":11,"content":["Tewi hɨiyame kemɨranakuteika, mɨpaɨ nepɨtiwareuyehɨakai hurawa 'Ixaheri teɨteriyari meta Kura nuiwarimama —Yawé mɨpaɨ kanaineni— neteɨterima memɨhɨkɨtɨnikɨ meta memɨnetsihekɨatanikɨ, nemariweme meta witsine'anemekɨ nemɨxeiyariekakɨ. Perutsɨ yamepɨkatekakɨ”."]},{"type":"heading","content":["Xarite mɨtatari"]},{"type":"verse","number":12,"content":["»Mɨpaɨtatsiere ketiniwarutahɨawi: “Yawé mɨpaɨ kanaineni, 'Ixaheri Kakaɨyarieya: ‘Naitɨ xarite winukɨ kanitihɨniyariemɨkɨ’. Xɨka mɨkɨ mɨpaɨ memete'utahɨawe: ‘¿Tekate'akumatekuta panatsi naitɨ xarite winukɨ ka'utihɨniyarɨwa?’,"]},{"type":"verse","number":13,"content":["hikɨ 'ana mɨpaɨ pekatiniwata'eiyamɨkɨ, Yawé mɨpaɨ kanaineni: ‘Winukɨ nekaniwatihɨniyamɨkɨ memɨtitarɨwenikɨ yunaime teɨteri 'ena kiekatari: ti'aitame Rawiri 'uwenieyatsie memayaxike, mawari wewiwamete meta yunaime Kerutsaremetari."]},{"type":"verse","number":14,"content":["Yanekatiniwapitɨamɨkɨ memuyutikwinikɨ yunaitɨ, wapaapama meta waniwema 'ukitsi yaxeikɨa. Ne nepɨkawatinenimayata matsi nepɨxeka'una nekaxeheunenimayatɨ’. Yawé mɨpaɨ kanaineni”»."]},{"type":"heading","content":["Mari'itɨarika"]},{"type":"verse","number":15,"content":[{"text":"Xekeneneu'eni, yemekɨ xekeneu'enana.","poem":1},{"text":"Mariweme xepɨkahayuyeitɨwani, Yawé mɨpaɨ kanaineni.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yawé yukakaɨyari 'aixɨa xeketenahɨaweni,","poem":1},{"text":"mexi'akɨxi yɨriya kaheyenɨ'awe","poem":2},{"lineBreak":true},{"text":"meta 'akuxi xeme hɨri mɨ'e'etɨtsie xekahekaxɨriwawe.","poem":2},{"text":"Xeme hekɨariya xepɨtakwewie,","poem":1},{"text":"peru mɨkɨ kanipatamɨkɨ yɨriya 'amayetsuyekɨ,","poem":2},{"lineBreak":true},{"text":"'ɨyuwime kanayeitɨamɨkɨ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Peru xɨka xeme xekahanu'enanani,","poem":1},{"text":"'awie nekanitatsuamɨkɨ","poem":2},{"lineBreak":true},{"text":"xeme xemuyuti'ɨrekɨ,","poem":2},{"text":"nehɨxita 'ukai","poem":1},{"text":"panexɨani hatsiwimekɨ,","poem":2},{"text":"Yawé muxatsimama","poem":1},{"text":"'ateewa memanuhapanienikɨ kayukwieyaritsie.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mɨpaɨ ketineutahɨawi ti'aitame meta ti'aitame maamaya:","poem":1},{"text":"«Tixaɨtɨ xekatehɨkɨtɨme xekenayuyeitɨa, kwiepa xekenetiyaxi,","poem":2},{"text":"yumu'utsieri kuruna xepɨkahana'uitɨaka,","poem":1},{"text":"kuruna witsimɨtixawawatɨ».","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nekexi kiekariyaritsie pɨreuname,","poem":1},{"text":"xewitɨ pumawe mɨreuyepieni.","poem":2},{"text":"Yunaitɨ Kura xiɨyarimama mekanehapanieni,","poem":1},{"text":"yunaitɨ mekananutaxɨriyani yemekɨ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Xekeneutanenieri xekeniwaruxeiya","poem":1},{"text":"tayeta memayehu.","poem":2},{"text":"¿Hakewari muxatsi pemɨhɨritɨarie,","poem":1},{"text":"muxatsi wahetsiemieme pemuyuta'ɨrekai?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"¿Kepetayɨni xɨka Yawé mɨkɨ memanuyetenikɨ waru'uitɨani","poem":1},{"text":"'iya kemɨ'ane 'ekɨ pemɨtiwaruti'ɨkitɨa","poem":2},{"lineBreak":true},{"text":"'iya 'aixɨa pemɨtiwamaikai?","poem":2},{"text":"¿Yemekɨ kamerekwine 'ukaratsi mɨniwene","poem":1},{"text":"kukuiniyaya hepaɨ?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Xɨkata pe'ata'iwawiya:","poem":1},{"text":"«¿Titayari mɨya neranuyemie?»,","poem":2},{"text":"waɨkawa 'axapepɨtiuyuri","poem":1},{"text":"'a'iwi pekaniutatsaniyarieni","poem":2},{"lineBreak":true},{"text":"meta pekaniukumayɨiyani penanaimarietɨ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"¿Kamɨtsɨ 'etiupe tewiyari yunawiyari mupata tiyɨwe,","poem":1},{"text":"yatɨni tiyɨwe tɨwe meupitu muyutayeitɨani?","poem":2},{"text":"Yaxeikɨata xeme 'aixɨa xemɨte'uyurieni xepɨkayɨwawe,","poem":1},{"text":"xepɨ'iyamate 'axaxemɨteyuriekakɨ xeikɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"«'Ɨxa hepaɨ nepɨxetawiwiexɨani","poem":1},{"text":"'eka kemɨrei'enitsitɨwa makumawetsie.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"'Ikɨ mɨyati'anetɨ 'ahetsie katiniunake,","poem":1},{"text":"'ahetsiemieme nemi'inɨatakai","poem":2},"—Yawé mɨpaɨ kanaineni—.",{"text":"Metsɨri pekanenatɨmaiya,","poem":1},{"text":"'itarikatsie pɨta pekatiniuwiya,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"neta 'a'iwi teikɨ nekanitihanimɨkɨ","poem":1},{"text":"'ahɨxie paitɨ nekamaneukunamɨkɨ","poem":2},{"lineBreak":true},{"text":"nekatinihekɨatamɨkɨ 'atewiyarika.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nepɨniere hipame wahamatɨa kepemɨtihune,","poem":1},{"text":"pemutatsuaka yewa hepaɨ,","poem":2},{"text":"peka'akatewiyatɨ hipame pewakumaɨwatɨ,","poem":1},{"text":"meta kemɨtixani'eriwakɨ yapetiyurienetɨ 'ahetsie,","poem":2},{"lineBreak":true},{"text":"yeuta paitɨ meta hɨritetsie.","poem":2},{"text":"Xɨa'ui 'ahetsie, Kerutsareme.","poem":1},{"text":"¿Kepaukake tamɨ pepɨtihayewa peka'itiyatɨ pehɨkɨtɨtɨ?»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JER/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JER/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JER/12.json","previousChapterAudioLinks":{},"numberOfVerses":27}