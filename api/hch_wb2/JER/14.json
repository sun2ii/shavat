{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JER","translationId":"hch_wb2","name":"Keremiyaxi","commonName":"Keremiyaxi","title":"Keremiyaxi","order":24,"numberOfChapters":52,"sha256":"771a2352ddb97ef3895e81db88d089eedf1f7c4caac6b2b7f4b4d6b3602b468f","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/hch_wb2/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":14,"content":[{"type":"heading","content":["Kememɨte'u'iwatsi, haakaxa meta 'ixipara"]},{"type":"verse","number":1,"content":["'Ikɨ Yawé niukieya kanihɨkɨtɨni Keremiyaxi hetsɨa munua, kemɨtikuwanikekai hepaɨtsita:"]},{"type":"verse","number":2,"content":[{"text":"«Kura kaniyuhiwerieka","poem":1},{"text":"kiekariteya kanikwiximeni,","poem":2},{"text":"hiwerika kanixuaweni mɨkɨ kwieyaritsie,","poem":1},{"text":"meta Kerutsaremetari wa'aiwari kana'eniɨriɨkɨni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Memɨxikutsixi yuteɨterima hanɨiyakɨ mekaniwanɨ'aka,","poem":1},{"text":"mɨkɨ putsu matineniere mekanekɨkani,","poem":2},{"lineBreak":true},{"text":"Peru haa mepɨka'ukaxexeiya.","poem":2},{"text":"Meyutetewiyatɨ mehɨxiyatɨ,","poem":1},{"text":"mekanakununuwani xarite 'uyewawakime me'uhapatɨ","poem":2},{"lineBreak":true},{"text":"meta yumu'utsie meheutimetɨkaitɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kwiepa kaniutsinini,","poem":1},{"text":"mɨka'ukawiwiyekɨ 'ikɨ kwieyaritsie.","poem":2},{"text":"Mekaniyutetewiyani memuka'etsa,","poem":1},{"text":"yumu'utsie meheutimetɨkaitɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Maxatsi yeuta","poem":1},{"text":"yuniwema mepɨwaruku'e'eiriwa 'ɨxa mumawekɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Puxuri yeutari hɨri mɨmetsetsie me'u'uwatɨ,","poem":1},{"text":"meta wahɨxite tiwaxɨaximekaku,","poem":2},{"text":"yawixi wahepaɨ mekateniu'iweni hakakɨ","poem":1},{"text":"tupiriyate mumawekɨri».","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tsepa ke'axatemɨte'uyuri tahetsie mɨrahɨpa,","poem":1},{"text":"peru 'ekɨ Yawé, 'aixɨa pemɨramamatiwanikɨ yaketineuyuri,","poem":2},{"text":"waɨkawamekɨ yatepɨkatekahu,","poem":1},{"text":"'ahepaɨtsita 'axatepɨte'uyuri.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"'Ekɨ pekanihɨkɨtɨni, 'ixaheritsixi wawikweitsitɨwame meta memɨmatsitakwewie","poem":1},{"text":"'uximatɨarika xuawekaku,","poem":2},{"text":"¿titayari yeikame hepaɨ petiyɨane 'ikɨ kwieyaritsie,","poem":1},{"text":"'ateewa yeikame hepaɨ yɨwikɨta xeikɨa manuhupu?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"¿Titayari petihɨxiya,","poem":1},{"text":"kuya mɨkayɨwe mɨtiyutawikweitsitɨani hepaɨ?","poem":2},{"text":"Yawé, 'ekɨ tahamatɨa pepuyeika,","poem":1},{"text":"kepemɨtitewa mɨpaɨ tepɨtematiwa,","poem":2},{"lineBreak":true},{"text":"pepɨkatatsi'uku'e'eiriwani.","poem":2}]},{"type":"verse","number":10,"content":["Yawé mɨpaɨ kanaineni 'ikɨ teɨteri wahepaɨtsita:",{"text":"«'Ikɨ teɨteri puwanake memeu'uwanikɨ,","poem":1},{"text":"yɨ'ɨkate mepɨkamaniyatɨa.","poem":2},{"text":"'Ayumieme ne nepɨkawanaki'erie,","poem":1},{"text":"matsi ne nekaniwaraye'eritɨamɨkɨ ke'axamemɨte'uyuri","poem":2},{"lineBreak":true},{"text":"hikɨ nekatiniwakwinitɨamɨkɨ mɨkɨkɨ».","poem":2}]},{"type":"verse","number":11,"content":["Hikɨ Yawé mɨpaɨ kanetiniutahɨawe: «Pepɨkanetsiwawirieka 'ikɨ teɨteri wahetsiemieme 'aixɨa memɨtetenikɨ."]},{"type":"verse","number":12,"content":["Tsepa memuyuhakie, wahiwari nepɨka'enieni, tsepa mawari taiyariyari memɨnetsiwewirie meta hatsite mawariyari nepɨka'itanaki'erieni. Ne nepuwakwini yurikɨ, 'ixiparakɨ, haakakɨ meta kwiniyakɨ»."]},{"type":"verse","number":13,"content":["Peru neta mɨpaɨ nekatinitahɨawe: «Yawé nekakaɨyari. Hipatɨ 'aniukamete mɨpaɨ mepɨtewakɨhɨawe kename 'ixiparakɨ mekatakwi'iwa meta kename mekahaakakwini, matsi kename 'ekɨ kayuwatɨ pewapitɨani mɨixa 'ikɨ kwieyaritsie»."]},{"type":"verse","number":14,"content":["Yawé mɨpaɨ kanetiniuta'eiya: «Kaniyakɨtɨni kememɨtekuxata mɨkɨ Kakaɨyari niukametemama kename nehetsiemieme meyɨa metekuxatatɨ. Ne nepɨkawarutanɨ'a, ne nepɨkatiwata'aitɨawe, meta nepɨkawatahɨawiwe. Tita memɨtexehekɨatɨa kememɨtenieritɨarie 'irɨmari kanihɨkɨtɨni, yakɨ temaiwawemete mepɨhɨkɨ, yakɨ xeikɨa yuhetsiemieme mepɨteku'eriwa."]},{"type":"verse","number":15,"content":["'Ayumieme Yawé mɨpaɨ kanaineni: “Yakɨ Kakaɨyari niukametemama nehetsiemieme memɨtekuxata ne nekawanɨ'akaku, meta mɨpaɨ memutiyuane kename katiyutakwini, haakaxa kahayani 'ikɨ kwieyaritsie, mɨkɨ haakakɨ mekanikwikuni meta 'ixiparakɨ."]},{"type":"verse","number":16,"content":["Meta teɨteri memɨte'utaxatɨarie Kerutsareme kayeyari 'utɨma menixɨrietɨkɨnikuni haakakɨ meta 'ixiparakɨ, pumaweni kemɨ'ane mɨkɨ mɨwakateuku, wa'ɨitama, waniwema 'ukitsi, meta waniwema 'ukari, mɨpaɨ nepɨtiwarakapitɨani ke'axamemɨte'uyurikɨ”."]},{"type":"line_break"},{"type":"verse","number":17,"content":["»'Ekɨ mɨpaɨ pekatiniwaretahɨawimɨkɨ:",{"text":"»“Ne 'ukai ke'uhapaneni","poem":1},{"text":"tukarikɨ meta tɨkarikɨ, nekatihayewatɨ,","poem":2},{"text":"neteɨterima waniwe 'uka 'ɨimari","poem":1},{"text":"pɨtiuka'eniwa waɨkawa,","poem":2},{"lineBreak":true},{"text":"tɨrɨkaɨyemekɨ kaniuweiyani.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Xɨka 'ɨtsita neheyani, teɨteri mekwikwi'ime","poem":1},{"text":"nepɨwaxeiya 'ixiparakɨ memukwi'iwaxɨ,","poem":2},{"text":"xɨka kiekaritsie neheutahani, haakakɨ","poem":1},{"text":"memɨtekukuye nepɨwaxeiya.","poem":2},{"text":"Kakaɨyari niukameya meta mawari wewiwame,","poem":1},{"text":"'ikɨ kwieyaritsie ku'uwamete mekanihɨkɨtɨni 'atsimekatemaitɨ kememɨteyurie”».","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"¿Kamɨtsɨ yemekɨ Kura perehɨari?","poem":1},{"text":"¿Tsiyuni petixani'erie?","poem":2},{"text":"¿Titayari mɨya petatikwinitɨa","poem":1},{"text":"matsi temɨta'uayemaniri tepɨkayɨwawe?","poem":2},{"text":"Tukari kayuwatɨ muma tepɨtakwewiekai,","poem":1},{"text":"peru tixaɨtɨ 'aixɨa mɨti'ane tepɨkate'ukaxei.","poem":2},{"text":"Tukari tepɨtakwewiekai 'aixɨa teteheu'erietɨ temakɨnekɨ,","poem":1},{"text":"peru tahetsie marika xeikɨa kaninuani.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yawé, tame ke'axatemɨte'uyurikɨ tepayukumate,","poem":1},{"text":"meta tapaapama ke'axamemɨte'uyuri,","poem":2},{"lineBreak":true},{"text":"tame 'axatepɨte'uyuri 'ahepaɨtsita.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"'Aixɨa pemɨrahɨawarɨwanikɨ pepɨkatatsihexɨrɨwani,","poem":1},{"text":"'a'uweni mɨmariwe pepɨkananaimaka.","poem":2},{"text":"Kenaye'eri tɨratu kepemɨtiuwewi tahamatɨa.","poem":1},{"text":"Pepɨkaheihɨpani.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"¿Kamɨtsɨ tiyɨwe xewitɨ kakaɨyari wewiyakametɨtɨ","poem":1},{"text":"wiyeri manayenɨ'ani?","poem":2},{"text":"Yawé meta pemɨtakakaɨyari,","poem":1},{"text":"¿tamɨ 'ekɨ pekatihɨkɨ wiyeri pemeyenɨ'awa,","poem":2},{"lineBreak":true},{"text":"muyuawi yuxaɨta pɨkayɨwe?","poem":2},{"text":"Naime 'ekɨ 'ikɨ pepɨtiutawewi,","poem":1},{"text":"'ayumieme tepɨta'ikwewa 'ahetsie.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JER/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JER/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JER/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}