{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JER","translationId":"hch_wb2","name":"Keremiyaxi","commonName":"Keremiyaxi","title":"Keremiyaxi","order":24,"numberOfChapters":52,"sha256":"771a2352ddb97ef3895e81db88d089eedf1f7c4caac6b2b7f4b4d6b3602b468f","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/hch_wb2/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":["Yawé mɨpaɨ kanetiniutahɨawe: «Tsepa Muitsexi meta Tsamuheri nehɨxie memɨteti'ui, ne nepɨkawarutinenimayatawe 'ikɨ teɨteri. Hikɨ keniwaranunɨ'a nehɨxie memɨka'u'uwanikɨ. Mekeheuhuni."]},{"type":"verse","number":2,"content":["Xɨka mɨpaɨ memateha'iwawiyani: “¿Hakewa kuta tepeyehu?”, mɨpaɨ ketiniwarayemari'itɨa mɨpaɨ ne Yawé nemainekɨ:",{"text":"»“Kemɨ'anetsɨ memɨkwinikɨ memɨ'ayumiemete, meke'ukwini,","poem":1},{"lineBreak":true},{"text":"kemɨ'ane 'ixiparakɨ memɨkwinikɨ memɨ'ayumiemete, 'ixiparakɨ meke'ukwini,","poem":1},{"lineBreak":true},{"text":"haakakɨ memɨkwinikɨ memɨ'ayumiemete, haakakɨ meke'ukwini,","poem":1},{"lineBreak":true},{"text":"kemɨ'ane memanuhapanienikɨ memɨ'ayumiemete mekehehapanieni”.","poem":1}]},{"type":"verse","number":3,"content":["»Ne neniwaranunɨ'airiemɨkɨ naukame 'uximatɨarika —Yawé mɨpaɨ kanaineni—: 'ixipara mɨtiyumemiwa, tsɨikɨri memɨwatahapaxɨanikɨ, wirɨkɨxi memɨwatitutsenikɨ meta yeutari naimeri memɨwatikwanikɨ."]},{"type":"verse","number":4,"content":["Te'aitamete yunaitɨ kwiepa memɨtama memɨmamakakɨ nekatiniyurimɨkɨ, Manatsexi 'Etsekiyaxi nu'aya, Kura kwieyaritsie ti'aitame, kemɨtiuyurikɨ Kerutsareme."]},{"type":"verse","number":5,"content":[{"text":"«¿Kemɨ'ane pɨmetsitinenimayata, Kerutsareme?","poem":1},{"text":"¿Kemɨ'ane 'ahetsiemieme pɨtatsuani?","poem":2},{"text":"¿Kemɨ'ane puyuwaɨriya mɨta'iwaunikɨ kepemɨreu'erie?»","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yawé mɨpaɨ kanaineni:","poem":1},{"text":"«'Ekɨ pepɨnetsi'uku'eiri, 'a'utɨa pepetɨa.","poem":2},{"text":"Nemamá 'ahetsie nekanitatseramɨkɨ","poem":1},{"text":"nekamenika'unamɨkɨ,","poem":2},{"lineBreak":true},{"text":"nepu'uxeri nematsinenimayatɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kiekari kitenie","poem":1},{"text":"nekameneuyewiwimɨkɨ nakitsaraɨkɨ.","poem":2},{"text":"'Ekɨ 'aniwema 'ukitsi yunaime nekameninawairiemɨkɨ,","poem":1},{"text":"neteɨterima yunaime nekaniwaka'unamɨkɨ,","poem":2},{"lineBreak":true},{"text":"'axameteyurietɨ memɨkate'uhayewaxɨkɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Xiekari haramara mɨtika reuyeta hepaɨ meyupaɨmeme","poem":1},{"text":"nekaniwarayeitɨamɨkɨ xewiuraxi,","poem":2},{"text":"tuka yemekɨ tiyuka'uname nepanunɨ'ani","poem":1},{"text":"temari wamaamama wahepaɨtsita.","poem":2},{"text":"Yapauka wahetsie nekatinipitɨamɨkɨ","poem":1},{"text":"'uximatɨarika meta hiwerika.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kaniku'amɨweni kemɨ'ane 'atahutame yuniwema 'ukitsi mɨwarayexeiyakai,","poem":1},{"text":"ka'u'iwetɨ payeika.","poem":2},{"text":"Tsepa mutuka pukɨ'iyɨriwa,","poem":1},{"text":"'ukaratsi yutewiyatɨ payeika yemekɨ.","poem":2},{"text":"Kemɨ'ane memɨyuhayewa nepuwayetuani memɨkwi'iwakɨ","poem":1},{"text":"memɨwaraye'unie wahɨxie»,","poem":2},"Yawé mɨpaɨ kanaineni."]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Xɨa'ui nehetsie, nemaama,","poem":1},{"text":"pemɨnetsi'utiniwexɨ","poem":2},{"text":"niuki nemɨxɨatɨakakɨ meta nemɨnemienenikɨ","poem":1},{"text":"naime 'ikɨ kwieyaritsie wahepaɨtsita.","poem":2},{"text":"Ne xeime nepɨkatiniɨtɨawe meta nepɨkanetaniɨwe,","poem":1},{"text":"peru yunaitɨ 'axamepɨnetekumamateke.","poem":2}]},{"type":"verse","number":11,"content":["Yawé mɨpaɨ kaniutayɨni:",{"text":"«Ne yurikɨ nekamenixɨnamɨkɨ 'aixɨa mɨti'anenikɨ,","poem":1},{"text":"yanepɨtiyurieni 'aneɨkixiwi metsitawawirienikɨ pemiparewienikɨ","poem":2},{"lineBreak":true},{"text":"'uximatɨarikatsata kememɨtekwine.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"»¿Kamɨtsɨ tiyɨwe tewi tepɨa makamura,","poem":1},{"text":"tepɨa tayeta mieme meta wurunitse?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Axapemɨtiuyurikɨ nekatiniyetuamɨkɨ","poem":1},{"text":"xepiinite mɨraye'atɨka, tixaɨtɨ nekatiwautɨ,","poem":2},{"text":"tita waɨkawa pemɨrexeiya meta piinite mɨraye'atɨka,","poem":1},{"text":"naime 'ikɨ 'akwietsie.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Aneɨkixiwima pemɨtiwata'uximayatsirienikɨ yanekatiniyurimɨkɨ","poem":1},{"text":"xeime kwieyaritsie pemɨka'imatetsie,","poem":2},{"text":"nehaxɨatsie tai kaniutani xehetsie","poem":1},{"text":"kaneutanerɨkwawani».","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Yawé, 'ekɨ pepɨtimate.","poem":1},{"text":"Kenena'eriwani, kenene'ɨwiyani.","poem":2},{"lineBreak":true},{"text":"Memɨnetsi'uweiya ketiniwarakapitɨa.","poem":2},{"text":"Wahepaɨtsita kepemɨtiukanewiekɨ,","poem":1},{"text":"pepɨkanetsipitɨaka nemɨka'unarienikɨ,","poem":2},{"lineBreak":true},{"text":"'ahetsiemieme neuxei nepɨtiuka'eniwa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kepauka 'aniuki nemukaxexeiyakai,","poem":1},{"text":"ne nepitikwa'akai,","poem":2},{"text":"mɨkɨ pɨnetemawierikatɨkai","poem":1},{"text":"meta ne'iyari pɨtemawierikayatɨkai,","poem":2},{"text":"kepemɨtitewakɨ nehetsie nematsihexeiyakɨ,","poem":1},{"text":"Yawé, Kakaɨyari Naimekɨmɨtɨrɨkaɨye.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ne 'ixɨararitsata memɨ'iyamatɨka nepɨkawatinɨiwe,","poem":1},{"text":"meta wahamatɨa nepɨkanetitemawiwe 'akuxi,","poem":2},{"text":"nexaɨtame nepuyeika, nehamatɨa pemuyeikakɨ","poem":1},{"text":"meta pekaneniuyehaxɨatɨani wahepaɨtsita.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"¿Titayari katihayewawe nekukuiniya?","poem":1},{"text":"¿Titayari katiyu'uayemarinɨa nekukuiniya?","poem":2},{"lineBreak":true},{"text":"¿Titayari katiyumɨkɨ?","poem":2},{"text":"¿Nehetsiemieme yakɨ haa manukatsukwaka","poem":1},{"text":"pepɨhɨkɨtɨni haixa mɨkawani?","poem":2}]},{"type":"verse","number":19,"content":["'Ayumieme Yawé mɨpaɨ kanaineni:",{"text":"«Xɨka petiuhayewa,","poem":1},{"text":"ne nepumatsi'anukuhana 'anata pepɨnetsi'ayexeiyani.","poem":2},{"text":"Xɨka petiuhayewa yakɨ petikuxatatɨ,","poem":1},{"text":"xɨka yurikɨ xeikɨa petikuxatani yemekɨ meuyewetsekɨ,","poem":2},{"lineBreak":true},{"text":"neniukame 'ekɨ pepayani.","poem":2},{"text":"Mɨkɨ 'ahetsɨa meke'u'axɨani,","poem":1},{"text":"peru 'ekɨ wahetsɨa pepɨkaheyeikani.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ne yanekatiniyurimɨkɨ 'ikɨ teɨteri wahetsiemieme","poem":1},{"text":"wurunitse mukawe mɨkaha'iwarie hepaɨ pemɨ'anenikɨ,","poem":2},{"text":"mepɨmatsitamieni,","poem":1},{"text":"peru mepɨkamatsiha'iwa,","poem":2},{"text":"ne 'ahamatɨa nemuyeikakɨ","poem":1},{"text":"nemetsitawikweitsitɨanike meta nemɨmatsixɨnakɨ","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":21,"content":[{"text":"Nepɨmatsixɨna 'axamemɨte'u'iyari wahetsie,","poem":1},{"text":"nepɨmatsitawikweitsitɨani memayu'eririya waxɨtetetsie».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JER/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JER/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JER/14.json","previousChapterAudioLinks":{},"numberOfVerses":21}