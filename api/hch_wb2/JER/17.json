{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JER","translationId":"hch_wb2","name":"Keremiyaxi","commonName":"Keremiyaxi","title":"Keremiyaxi","order":24,"numberOfChapters":52,"sha256":"771a2352ddb97ef3895e81db88d089eedf1f7c4caac6b2b7f4b4d6b3602b468f","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/hch_wb2/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"«Kura ke'axamɨtiuyuri katina'utɨarieni","poem":1},{"text":"tepɨa manuyemɨtsɨkɨ,","poem":2},{"text":"kana'utɨarieni tepɨa 'atsimɨkayɨwekɨ,","poem":1},{"text":"tete mɨxixiya 'iyariyaritsie","poem":2},{"lineBreak":true},{"text":"meta mawari taiyameyate 'awateyatsie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Aixɨa mepɨtehe'eriwa xeniwema 'ukitsi","poem":1},{"text":"xemawari taiyamete kɨyexi mɨ'e'etɨ hetɨa muwetɨka,","poem":2},{"text":"meta 'uka 'Atserá kakaɨyariyari 'ɨkiyari yemuri 'amanutitɨtɨtsie muwetɨka","poem":1}]},{"type":"verse","number":3,"content":[{"text":"meta nehɨritsie mɨhekɨatsie.","poem":2},{"lineBreak":true},{"text":"»Naime tita waɨkawa pemɨrexeiya hipame kuyaxi nekatiniwayetuiriemɨkɨ,","poem":1},{"text":"'apiinite mɨraye'atɨka meta 'atukite 'etsimupepe,","poem":2},{"text":"naime ke'axapemɨtiuyurikɨ","poem":1},{"text":"naime 'akwieyaritsie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Akɨmana pekatineuyehɨamɨkɨ","poem":1},{"text":"tita nemɨmatiumikai.","poem":2},{"text":"Waɨriyarika ti'uximayatame nepɨmatsihayeitɨani memɨmatsi'aye'unie wahetsɨa,","poem":1},{"text":"xeime kwieyaritsie pemɨka'imatetsie,","poem":2},{"text":"nehaxɨa pemutaiyaxɨkɨ,","poem":1},{"text":"mɨkɨri yakatinitakamɨkɨ yuheyemekɨ».","poem":2}]},{"type":"verse","number":5,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«Tewi 'axake'itɨarieka kemɨ'ane tewitsie mɨtiwiya.","poem":1},{"text":"Tewi 'axake'itɨarieka kemɨ'ane yɨtɨrɨkariya hetsie mɨtiwiya","poem":2},{"lineBreak":true},{"text":"meta yu'iyari mukupata Yawé hetsie mɨkatiwiyanikɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Ɨtsi hepaɨ 'anetɨ kanayeimɨkɨ makumawetsie muwe hepaɨ:","poem":1},{"text":"'atsipɨkaretimani kepauka tukari 'aixɨa mɨ'ane munuani.","poem":2},{"text":"Makuwakitsie kaniuwemɨkɨ,","poem":1},{"text":"'una kwieyaritsie, xewitɨ mɨkahanuyeika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"»'Aixɨa ke'itɨarieka tewi Yawé hetsie mɨtiwiya,","poem":1},{"text":"meta yuri mɨti'erie hetsiena.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kɨye muka'iteɨtsie hatetsita hepaɨ 'anetɨ kanayeimɨkɨ,","poem":1},{"text":"nanarieya hapa meukayuyune,","poem":2},{"text":"mɨka'ukama xɨri tsepa munua,","poem":1},{"text":"xawariyari yamɨtitsitsiɨrawi.","poem":2},{"text":"Mɨtiukuwauketsie mɨkayu'iyaritɨa,","poem":1},{"text":"meta mɨkatihayewa 'ikwaxi 'ukaxuaweriyatɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tixaɨtɨ pɨtiumawe 'iyari hepaɨ tiyukwamanatɨ.","poem":1},{"text":"'Aixɨa miyurieni pɨkayɨwe.","poem":2},{"lineBreak":true},{"text":"¿Kemɨ'ane pɨyɨwe meitimanikɨ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Ne Yawé, 'iyari 'awie nepɨxeiya,","poem":1},{"text":"meta kemɨtiku'eriwa nepɨ'inɨata,","poem":2},{"text":"yanemɨtiwapitɨanikɨ yuxexuime kememɨteyurie","poem":1},{"text":"meta yuxexuitɨ kememɨte'ukaxuxuawere».","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kemɨ'ane muyuxikutɨane kemɨtiheitseriekɨ kayɨanetɨ","poem":1},{"text":"mɨkɨ wiki kayutawári mɨtsiniya hepaɨ kani'aneni.","poem":2},{"text":"Yutukari hixɨapa katineuyehɨamɨkɨ,","poem":1},{"text":"'imatɨrieka mɨkɨ ka'uka'iyaritɨ kanayeimɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"'Uweni mɨxawatɨ,","poem":1},{"text":"tsutɨa paitɨ mariweme mayeitɨariwa,","poem":2},{"lineBreak":true},{"text":"muwa tatuki kanihɨkɨtɨni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yawé, 'ekɨ 'ixaheritsixi memɨmatsitakwewie pepɨhɨkɨ,","poem":1},{"text":"kemɨ'ane memɨmatsiku'eirieni mekanitewiyatsitɨariekuni.","poem":2},{"text":"Kemɨ'ane matsihatɨmaiya","poem":1},{"text":"kwiepa mɨra'utsieni hepaɨ 'anetɨ puyuhayewa,","poem":2},{"text":"Yawé muku'eirikɨ,","poem":1},{"text":"haixa mayeyuri mɨhɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Yawé, keneneu'uayema nemanayewenikɨ,","poem":1},{"text":"keneneutawikweitsitɨa, nepɨwikweitsitɨarieka,","poem":2},{"lineBreak":true},{"text":"karikɨ 'ekɨ xeikɨa nekwikari pekanihɨkɨtɨni.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yunaitɨ mɨpaɨ mekateniu'iwawani:","poem":1},{"text":"«¿Hakewa kuta Yawé niukieya?","poem":2},{"lineBreak":true},{"text":"Matsiɨkɨtɨ kehayuyeitɨani».","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Peru ne nepɨkanemexɨitɨa","poem":1},{"text":"nemɨmatsiku'eirienikɨ meta muxatsi wahɨweme 'ahetsiemieme nehɨkɨtɨtɨ netihayewake,","poem":2},{"lineBreak":true},{"text":"meta yanepɨkara'eriwa 'uximatɨarika tukariyari 'umamienikɨ.","poem":2},{"text":"'Ekɨ pepɨtimate kenemutaine,","poem":1},{"text":"'ahɨxietsɨ nekaniutayɨni.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Marika nehetsiemieme pepɨkahɨkɨtɨni,","poem":1},{"text":"'ekɨ netsi'awiwietame pepɨhɨkɨ kepauka 'uximatɨarika muxuawenitsie.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tewiyarika pepɨkanetsipitɨaka,","poem":1},{"text":"mɨkɨ pɨta keniwarutewiyarikatsitɨa.","poem":2},{"text":"Pepɨkanetsimariutani,","poem":1},{"text":"mɨkɨ pɨta keniwamariutani.","poem":2},{"text":"Tukari kwaniweme keniwaranɨ'airi,","poem":1},{"text":"tsepari keniwaruka'una yuheyemekɨ.","poem":2}]},{"type":"heading","content":["Xawati 'uxipiya tukari"]},{"type":"verse","number":19,"content":["Yawé mɨpaɨ kanetiniutahɨawe: «Kenemie kiekari kitenie keneukexi, Kura kwieyaritsie te'aitamete memanutakɨkatsie meta memanayekɨkatsie, metatsiere naime Kerutsareme kitenieyaritetsie,"]},{"type":"verse","number":20,"content":["mɨpaɨ ketiniwarutahɨawi: “Yawé niukieya xekeneu'eni, Kuratsie te'aitamete meta yunaitɨ teɨteri Kura kiekatari metatsiere yunaitɨ Kerutsareme kiekatari 'ikɨ kitenieyaritetsie xemeutahake."]},{"type":"verse","number":21,"content":["Yawé mɨpaɨ kanaineni: ‘Xekeneyukweriwayurieka 'ika xepɨka'utitɨkɨni xawatikɨ meta xepɨkatehanutatɨkɨni 'ena Kerutsareme kitenieyaritetsie."]},{"type":"verse","number":22,"content":["Metatsiere yukiita xepɨkatehewayetɨkɨni xawatikɨ, meta 'etsiwa tɨma xepɨkate'uximayaka. Xekena'eriwani xawati 'uxipiya tukari, kehepaɨ nemɨtiwaru'aitɨa xetutsima."]},{"type":"verse","number":23,"content":["Peru mɨkɨ mepɨkanetsihanu'eni yamepɨkatekakɨ, matsi pɨta mekaheu'enanatɨ mepayuyeitɨa, memɨ'enananikɨ mepɨka'uyuwaɨri meta memɨta'ɨxatsitɨarienikɨ’."]},{"type":"verse","number":24,"content":["»”Yawé mɨpaɨ kanaineni: ‘Xɨka yurikɨ xenetsihanu'enieni, xɨka xawatikɨ 'ika xeka'anutatɨtɨkɨne 'ikɨ kiekari kitenieyaritetsie, matsi xɨka xehe'eriwani 'ikɨ tukari tixaɨtɨkɨ xekate'uximayatɨ,"]},{"type":"verse","number":25,"content":["hikɨ 'ana mekaneutahaxɨakuni 'ikɨ kiekari kitenieyaritetsie te'aitamete meta memanuyetei, Rawiri 'uwenieyatsie mekanayaxikuni. Mɨkɨ mana mekaneutahaxɨakuni kaxetatetsie meta kawayutsixi wahetsie me'utetɨ, Kura teɨteriyari meta Kerutsareme kiekatari mekaniwarateɨtakakuni, hikɨ 'ana 'ikɨ kiekaritsie yuheyeme pɨkiepatɨni."]},{"type":"verse","number":26,"content":["Kura kiekariteyaritsie kiekatari mekani'axɨakuni meta Kerutsareme 'aurie kiekatari, Wenikamini kwieyaritsie kiekatari meta Tsepera kiekatari, mɨhɨriyatsie meta Nekexi kiekatari. Yawé tukita mekani'atɨakuni mawari mɨtataiyarieni, hatsite mawariyari meta 'ɨkwa, metatsiere pamɨpariyutsi mawariyari."]},{"type":"verse","number":27,"content":["Peru xɨka ne'aitsikatsie yaxekatekakɨne xawati xɨka xehatɨmaiya meta xɨka Kerutsareme kitenieyaritetsie 'ika xeteheutahatɨwani xawatikɨ, hikɨ 'ana 'itupariteya nekanitaiyaxɨamɨkɨ, kayutɨnɨakamekɨ meta paratsiyute kanititaimɨkɨ Kerutsareme miemete’ ”»."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JER/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JER/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JER/16.json","previousChapterAudioLinks":{},"numberOfVerses":27}