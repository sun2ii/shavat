{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JER","translationId":"hch_wb2","name":"Keremiyaxi","commonName":"Keremiyaxi","title":"Keremiyaxi","order":24,"numberOfChapters":52,"sha256":"771a2352ddb97ef3895e81db88d089eedf1f7c4caac6b2b7f4b4d6b3602b468f","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/hch_wb2/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":18,"content":[{"type":"heading","content":["'Iwewame niukiyari"]},{"type":"verse","number":1,"content":["'Ikɨ Yawé niukieya kanihɨkɨtɨni Keremiyaxi hetsɨa munua:"]},{"type":"verse","number":2,"content":["«Kenemie hikɨ kwitɨwa 'iwewame kiita, muwa nekametinetaxatɨamɨkɨ»."]},{"type":"verse","number":3,"content":["Hikɨ nekaneyani 'iwewame kiita, nekaneitaxeiya ti'uximayakame tixikɨraɨyemetsie."]},{"type":"verse","number":4,"content":["Hikɨ xari muwewiekai 'axakaniuyɨni mamayatsie, tawarita xeime xari kaniutawewieni, kepaukake 'aixɨa 'aneme mayeitɨani."]},{"type":"verse","number":5,"content":["'Ana Yawé niukieya nehetsɨa kaninuani mɨpaɨ kanetiniutahɨawe:"]},{"type":"verse","number":6,"content":["«Teɨteri 'Ixaheritsixi, ¿kamɨtsɨ nekatiyɨwe xehetsie mɨpaɨ nemɨtiuyurieni 'iwewame kemɨtiuyuri haxukɨ? —Yawé mɨpaɨ kanaineni—. Xeme teɨteri 'ixaheritsixi, haxu 'iwewame yumamatsie kemɨratu'u, mɨpaɨta xeme xepɨ'ane nemamatsie."]},{"type":"verse","number":7,"content":["Mɨpaɨ nemɨtiuxata nepɨyɨwe nemuwarahunakɨ, nemuwaratixɨrienikɨ meta nemuwarakumaweriyakɨ xeime nuiwari yatɨni xewitɨ mɨra'aitatsie,"]},{"type":"verse","number":8,"content":["peru xɨka mɨkɨ nuiwari tiuhayewa 'axatiyurienetɨ, neta nepɨtihayewa kenemɨti'uximatɨanikekai meta kenemɨtiunehɨawekai hepaɨtsitana."]},{"type":"verse","number":9,"content":["Mɨpaɨta neputayɨwe xeime nuiwari nemɨkamanikɨ meta nemikayenikɨ yatɨni xewitɨ mɨra'aitatsie."]},{"type":"verse","number":10,"content":["Peru xɨka nehɨxie mɨkɨ nuiwari 'axatiuyurieni xɨka kanetsiheu'enieka, nekatinihayewamɨkɨ ke'aixɨa nemɨtiu'eriekai hetsiena mieme."]},{"type":"verse","number":11,"content":["Hikɨta ketiniwarutaxatɨa Kura kiekatari meta Kerutsareme, mɨpaɨ ketiniwarayehɨtɨa Yawé mɨpaɨ kanaineni: “Nekaniha'aritɨaka 'uximatɨarika xehetsiemieme nekaniwewieka kehepaɨ nemɨtiyurieni xehepaɨtsita. Huye 'axamɨ'ane xekeneuhayewa, xeketenehɨwa, 'aixɨa xekeneyuyuri pɨta ke'axaxemɨte'u'uwakaikɨ meta ke'axaxemɨteyuriekaikɨ”."]},{"type":"verse","number":12,"content":["Mɨkɨ mɨpaɨ mekanitiyuakuni: “Yakɨ xeikɨa peputaine. Ketemɨteku'eriwa yatepɨteyurieka, meta teyuxexuitɨ 'axatepɨteyurieka ta'iyari 'axamɨ'ane kemɨtatikɨhɨawe”»."]},{"type":"line_break"},{"type":"verse","number":13,"content":["'Ayumieme Yawé mɨpaɨ kanaineni:",{"text":"«Xekeneuta'iwau hipame nuiwarite watsata:","poem":1},{"text":"¿Hakewa xewitɨ mɨpaɨ pɨre'enaxɨ?","poem":2},{"text":"'Ixaheri 'ɨimari","poem":1},{"text":"yemekɨ 'axa'anemekɨ pɨtiuyuri.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"¿Kamɨtsɨ 'ɨwi Riwanu hɨriyaritsie","poem":1},{"text":"'ai 'amanutitɨtɨtsie titipapare?","poem":2},{"text":"¿Kamɨtsɨ haa mɨhaɨtɨ hɨritsie","poem":1},{"text":"makaneika tiukawauke?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Peru neuxei, neteɨterima mepɨnetsihatɨmai,","poem":1},{"text":"hipame kakaɨyarixi tixaɨtɨ memɨkateyunaki'erie 'ɨkwa mepuwatairietɨwe.","poem":2},{"text":"Yuhuyeta mepekaxɨri,","poem":1},{"text":"huye meripaitɨ mieme 'utɨa,","poem":2},{"text":"hipame huyetsie memu'uwanikɨ","poem":1},{"text":"meta muka'uyeyɨkɨtsie.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mɨya meyɨatɨ yukwie yuxaɨtame mekaniuku'eirieni,","poem":1},{"text":"tixaɨtɨ tiyuriyarɨwame menayeitɨani.","poem":2},{"text":"Kemɨ'ane mana muyeyani","poem":1},{"text":"yumu'u kaniyuitɨamɨkɨ matɨ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"'Eka tau manatineika matineika hepaɨ,","poem":1},{"text":"nekanixetaxɨriexɨamɨkɨ mɨxe'aye'unie hɨxie.","poem":2},{"text":"Kepauka xemu'uximatɨariekatsie","poem":1},{"text":"nekanawaritamɨkɨ nepɨkahaniere».","poem":2}]},{"type":"verse","number":18,"content":["Teɨteri mɨpaɨ mekaniutiyuani: «Xekeneuyukuxeɨri tepɨtetixata Keremiyaxi hepaɨtsita. 'Inɨari niukiyari pɨkaheuyeweka mawari wewiwame hetsie, 'ɨxatsi mɨtimaiwe hetsie pɨkaheuyeweka tɨma meta niuki Kakaɨyari niukameya hetsie pɨkaheuyeweka. Niukikɨ tepeye'atɨirieni, tsepa kemaine yatepɨkateyurieni»."]},{"type":"verse","number":19,"content":[{"text":"Yawé, keneneu'eni kwerietɨ.","poem":1},{"text":"Keniwaru'eni kemɨ'ane nehetsie memɨtehahɨpa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"¿Kamɨtsɨ 'aixɨa mɨti'ane 'axamɨ'anekɨ tiyupitɨaritɨre?","poem":1},{"text":"Mɨkɨri putsu mekaniwati'inieni muwa nemeukawenikɨ.","poem":2},{"text":"Ne matsi nematsi'utahɨawixɨ","poem":1},{"text":"wahetsiemieme nemɨtaniunikɨ,","poem":2},{"lineBreak":true},{"text":"'ahaxɨa wahetsie mɨkatinakenikɨ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"'Ayumieme waniwema 'ukitsi keniwayetua haakakɨ memɨkwinikɨ,","poem":1},{"text":"keniwaruku'eiri 'ixiparakɨ memɨkwi'iyanikɨ.","poem":2},{"text":"Wa'ɨitama wiuraxi meke'akɨne meta yuniwema 'ukitsi mekawarexeiyatɨ,","poem":1},{"text":"wakɨnama meke'ukwi'iwa,","poem":2},{"text":"waniwema temari mekehekwi'iwa","poem":1},{"text":"'ixiparakɨ meheyukwitɨwetɨ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hiwari kehewaku'eiyani wakiita paitɨ,","poem":1},{"text":"kepauka 'atsimekateha'eriwakaku pemɨwaranɨ'ani wahetsɨa","poem":2},{"lineBreak":true},{"text":"yɨmɨireme tenawayamete.","poem":2},{"text":"Mekaniuti'ineri muwa nemeukawenikɨ,","poem":1},{"text":"meta winiyari nehɨxie mekaniuwɨtɨaxɨani.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yawé, peru 'ekɨ pepɨrakumate","poem":1},{"text":"naime kememɨteku'eriwa kememɨnetemieni.","poem":2},{"text":"Ke'axamemɨteyurie pepɨkatiwareuyehɨwirieka,","poem":1},{"text":"meta ke'axamemɨte'uyuri pepɨkahekuyeitɨwani 'ahɨxie.","poem":2},{"text":"'Ahɨxie meke'ukaxɨriyani.","poem":1},{"text":"Kepauka wahekɨ pemɨha'a 'ana keniwaraye'atɨiri.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JER/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JER/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JER/17.json","previousChapterAudioLinks":{},"numberOfVerses":23}