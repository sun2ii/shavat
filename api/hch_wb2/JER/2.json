{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JER","translationId":"hch_wb2","name":"Keremiyaxi","commonName":"Keremiyaxi","title":"Keremiyaxi","order":24,"numberOfChapters":52,"sha256":"771a2352ddb97ef3895e81db88d089eedf1f7c4caac6b2b7f4b4d6b3602b468f","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/hch_wb2/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":2,"content":[{"type":"heading","content":["'Ixaheri Kakaɨyari kemɨtiuku'eiri"]},{"type":"verse","number":1,"content":["Yawé niukieya nehetsɨa kaninuani:"]},{"type":"verse","number":2,"content":["«Kenemie Kerutsareme kiekatari mɨpaɨ ketiniwaretaxatɨa Yawé mɨpaɨ kanaineni:",{"text":"»“Nepa'eriwa matɨari 'ɨimariyari kepemɨnetinaki'eriekaitsie,","poem":1},{"text":"'anaki'eriyakɨ kepauka nemetsi hewitɨtsie,","poem":2},{"text":"kepauka makumawetsie pemɨnetsi'uweiyakai,","poem":1},{"text":"'iya kwietsie 'etsiya mumawetsie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Ixaheri pɨpatsiekai Yawé hetsiemieme,","poem":1},{"text":"matɨari mieme 'ikwaxi pɨhɨkɨtɨkai hetsiena mieme,","poem":2},{"text":"kemɨ'ane memitikwa'akai mete'uka'eniwatɨ mepakɨkakai,","poem":1},{"text":"wahetsie 'uximatɨarika pɨ'axekai”»,","poem":2},"Yawé mɨpaɨ kanaineni."]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yawé niukieya xekeneu'eni Kakuwu xiɨyarimama,","poem":1},{"text":"yunaitɨ 'Ixaheri nuiwarima teɨterimama.","poem":2}]},{"type":"verse","number":5,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«¿Ketita 'axati'aneme mete'ukaxei nehetsie xetutsima,","poem":1},{"text":"merikɨte yemekɨ menetsi'uku'eiri?","poem":2},{"text":"Tixaɨtɨ mɨkatiyunaki'erie 'utɨa pɨta mepekɨ,","poem":1},{"text":"'ayumieme tixaɨtɨ mepɨkatehakɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hatsuaku mɨpaɨ mepɨka'utiyua:","poem":1},{"lineBreak":true},{"text":"“¿Hakewari Yawé","poem":1},{"text":"'Ekipitu mɨtatsihayewitɨ,","poem":2},{"text":"makumawetsie mɨtatsi'uwitɨximekai,","poem":1},{"text":"'uwakikaku kweriwa'anekɨa,","poem":2},{"text":"tixaɨtɨ mɨkaraxuawetsie meta 'umariwekaku,","poem":1},{"text":"hakewa xewitɨ muka'anuyeikatsie","poem":2},{"lineBreak":true},{"text":"meta xewitɨ muwa mɨkakietsie?”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne nepɨxe'atɨa kwie 'aixɨa mɨ'anetsie,","poem":1},{"text":"mana 'ikwaxi mɨtixuawe xemɨtekwakakɨ","poem":2},{"lineBreak":true},{"text":"tinaitɨ mana mɨtixuawe.","poem":2},{"text":"Peru xeme xe'u'axɨaka nekwie ka'itiyakame xepayeitɨa,","poem":1},{"text":"xeme kwie nemɨxeyetuiri ne'ixani'eriekame xepayeitɨa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hatsuaku mawari wewiwamete mɨpaɨ mepɨka'utiyua:","poem":1},{"text":"“¿Hakewari Yawé?”","poem":2},{"text":"'Inɨari niukiyari memakumate hatsuaku mepɨkanetsi hetima,","poem":1},{"text":"teɨteri wahetsiemieme memanuyetekai menetsi'aye'unietɨ mepakɨ,","poem":2},{"text":"neniukamete Wahari hetsiemieme pɨta mepɨte'utaxa","poem":1},{"text":"meta kakaɨyarixi tixaɨtɨ memɨkateyunaki'erie pɨta mewaruweiyatɨ mepakɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Ayumieme, hikɨ 'akuxi hekwamekɨ nepɨxetaxaneta,","poem":1},{"text":"metatsiere xeniwema waniwema wahetsie nepɨrahɨani,","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"»Xekenehu Tsipɨre kwieyari haramara hixɨapa mɨyema hatetsitana, meta xekenenenieri mana kereyɨane,","poem":1},{"text":"hipame xekeniwarutanɨ'a Tseraxi paitɨ, mana memenenierekɨ kemɨreyɨane,","poem":2},{"lineBreak":true},{"text":"hikɨ xekeneuyu'ɨwiya xɨka hawaikɨ meripaitɨ mɨpaɨ reyɨni:","poem":2}]},{"type":"verse","number":11,"content":[{"text":"¿Kamɨtsɨ xewitɨ nuiwari tiuyeika hipame kakaɨyarixi waruku'eirieka hipame pɨta wareweiyaka,","poem":1},{"text":"tsepanetɨ mekakakaɨyarixi?","poem":2},{"text":"Neteɨterima mepɨnetsi'uku'eiri, nemɨmariwe wahetsiemieme,","poem":1},{"text":"tixaɨtɨ mɨkatiyunaki'erie hekɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Muyuawi, kenemaka, 'ikɨ mɨya mɨtiɨyɨkɨ.","poem":1},{"text":"Keneutayɨyɨakani meta waɨkawa keneutimamaweni.","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"»Pɨtihuta 'axamɨti'ane","poem":1},{"text":"neteɨterima 'axakememɨte'uyuri:","poem":2},{"text":"Mepɨnetsi'uku'eiri,","poem":1},{"text":"haixa mayeniere muhane nehɨkɨtɨme,","poem":2},{"text":"putsute pɨta haa mukatuariketɨka yɨkɨmana mepuyutiwewiriexɨa,","poem":1},{"text":"putsute mɨtatari haa mɨkareuteteritɨwa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"¿'Ixaheri kuta waɨriyarika ti'uximayatame tihɨkɨ?","poem":1},{"text":"Mɨra'uximayatsietsie pɨka'utinuiwaxɨ.","poem":2},{"lineBreak":true},{"text":"¿Kamɨtsɨ titayari tinawatsiyarie?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mayetsi meputitsua hetsiena mieme,","poem":1},{"text":"mepuyutihaxɨatɨa karima hetsiena mieme.","poem":2},{"text":"Kwieya yuxaɨtame puyuhayewaxɨ,","poem":1},{"text":"kiekariteya naitɨ putitaiyarie,","poem":2},{"lineBreak":true},{"text":"nixewitɨri mana pɨka'uka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"»'Akuxi matsi waɨkawa pemɨtiuka'eniwanikɨ,","poem":1},{"text":"Menipitsi kiekatari meta Tapinetsi kiekatari","poem":2},{"lineBreak":true},{"text":"mekameniukaxini pemu'umetsekame mekamenayeitɨani.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mɨpaɨ pekatinanuyemieni","poem":1},{"text":"'akakaɨyari Yawé pemuku'eirikɨ,","poem":2},{"lineBreak":true},{"text":"mɨmatsi'uwitɨximekai 'ahuyeta.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hikɨta, tixaɨtɨ pepɨkarekaxeiya 'Ekipitu xɨka peheyani","poem":1},{"text":"haa Niru mieme pemanuharenikɨ.","poem":2},{"text":"Tixaɨtɨ pepɨkarekaxeiya 'Atsiriya xɨka peheyani","poem":1},{"text":"haa 'Eupɨrate mieme pemanuharenikɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"'Axakepemɨtiuyuri mɨkɨ 'ahetsie pɨrahɨani,","poem":1},{"text":"heitserie yapemɨkatikatɨakɨ pepe'atimani.","poem":2},{"text":"Keneutimaixɨa ke'axamɨ'ane meta kemɨtiuka'eniexɨani","poem":1},{"text":"xɨka Yawé 'akakaɨyari 'uku'eirieni","poem":2},{"lineBreak":true},{"text":"meta xɨka pekanetsi'ayemakatɨ pe'ayani","poem":2},"—Ti'aitame mɨpaɨ kanaineni, Yawé Naimekɨmɨtɨrɨkaɨye—."]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"»Mɨixa wiyari panuyemie 'ayuku pemanumuraxɨ,","poem":1},{"text":"pemɨhɨakai pepɨ'axɨnaxɨ","poem":2},{"lineBreak":true},{"text":"meta mɨpaɨ peputayɨ: “'Ahetsiemieme nepɨkareu'uximayatamɨkɨ”.","poem":2},{"text":"Naitsarie hɨri 'amanutitɨtɨtsie,","poem":1},{"text":"meta naime kɨyexi mɨ'e'etɨtɨkatɨa,","poem":2},{"lineBreak":true},{"text":"pepɨ'ayetua tuminikɨ pemɨkumayɨiwanikɨ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ne nepumatsi'uka'e hatsi 'aixɨa mɨ'anekɨ,","poem":1},{"text":"kaxie 'aixɨa mɨ'ane nemanayexei hepaɨ.","poem":2},{"text":"¿Titayari petiu'apataxɨ","poem":1},{"text":"kaxie 'axamɨ'ane nemɨka'imate peratɨa?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Tsepa waɨkawa mɨtiyeitɨawekɨ pemɨ'akahauxi,","poem":1},{"text":"meta tsepa waɨkawa xapuni pemɨ'akawiri,","poem":2},{"text":"'akuxi ne, 'axamɨti'ane 'ahetsie nepɨxeiyani","poem":1},"—Yawé mɨpaɨ kanaineni naimekɨmɨyɨwe—."]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"»¿Pepɨkayɨwe mɨpaɨ pemutayɨni:","poem":1},{"text":"“Neka'itiyatɨ nepɨkahayuyeitɨa,","poem":2},{"lineBreak":true},{"text":"meta Wahari kakaɨyarixiyarite newarayexeiyatɨ nepɨka'uyeika”?","poem":2},{"text":"Kenaye'eri kepemɨtiuyuri mayeweritsie.","poem":1},{"text":"Keneu'atimaixɨa kepemɨtiuyuri.","poem":2},{"text":"Kameyu 'ukaratsi manautsawe,","poem":1},{"text":"naitsarie pemukuyeika.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Puxu 'ukaratsi yeutanaka 'ɨtsita xeikɨa pemɨ'iyamate.","poem":1},{"lineBreak":true},{"text":"Kepauka 'ahetsie pemɨreuyehɨwa, 'ekapa pepɨreuti'ɨkwe,","poem":1},{"text":"kepauka pemeu'aweiyanɨaka, xewitɨ matsi'ukunuitɨani pɨkayɨwe.","poem":2},{"text":"Nixewitɨtɨma 'uki pɨkati'uxe matsikuwaunetɨ:","poem":1},{"text":"kepauka 'atukari maye'axe, yapauka pɨmetsi'ukaxeiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"»Peheumamawetɨ pepɨkakuyeikani, petiu'akwinitɨani,","poem":1},{"text":"meta pemanatiwaukenikɨ pepɨkayupitɨaka.","poem":2},{"text":"Peru 'ekɨ mɨpaɨ peputaine: “Hawaikɨ yemekɨ nepɨkayɨwe nemɨtihayewa yanetiyurienetɨ.","poem":1},{"text":"Nepuwanaki'erie hipame kakaɨyarixi, meta mɨkɨ wa'ɨtɨma nepumieni”.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"»'Ixaheritsixi mepuyutitetewiya,","poem":1},{"text":"meta tewa'aitɨwamete, 'itsɨkate","poem":2},{"text":"meta mawari wewiwamete, Kakaɨyari niukametemamata tsiere,","poem":1},{"text":"tinawayame kemɨtiyutewiya kepauka mɨxeiyarieni hepaɨ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kɨye yatewime mɨpaɨ xepɨtekɨhɨawe:","poem":1},{"text":"“'Ekɨ pepɨnepaapa”,","poem":2},{"text":"meta xeime tete mɨpaɨ xepɨtehahɨawe:","poem":1},{"text":"“'Ekɨ pepɨnetsi'utinuiwitɨa”.","poem":2},{"text":"Xepɨnetsi'uwarixiwiyaxɨ,","poem":1},{"text":"xepɨkanetsixeiyaku.","poem":2},{"text":"Peru xehetsie 'uximatɨarika munuanitsie mɨpaɨ xepɨnetekɨhɨawe:","poem":1},{"text":"“Kenanukukexi meta ketaneutawikweitsitɨa”.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kura, ¿hakewari tamɨ kakaɨyarixi pemɨ'atiwewiri?","poem":1},{"text":"Yuwaɨkawame kakaɨyarixi pepɨwarexeiya kiekarite hepaɨ.","poem":2},{"text":"Mɨpaɨ ketiniwarutahɨawi meke'anuku'uni.","poem":1},{"text":"Xɨka 'aku memetsitawikweitsitɨakuni kepauka 'uximatɨarika pemexeiyanitsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"»¿Titayari xenetexaneta?","poem":1},{"text":"Xeme yunaitɨ xenetsi'aye'unietɨ xepakɨ","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"»Yakɨ xeikɨa nepɨtiwakwinitɨa neteɨterima,","poem":1},{"text":"kenemɨtiwaheitseritɨa mepɨka'eniku.","poem":2},{"text":"Maye mɨkatiuyukamariya hepaɨ,","poem":1},{"text":"xe'ixipara puwarutikwai Kakaɨyari niukametemama xehetsɨa miemete.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"»Peru xeme, hikɨ miemete,","poem":1},{"text":"xekeneu'eni Yawé niukieya:","poem":2},{"text":"¿Kamɨtsɨ ne makumawe netihɨkɨ","poem":1},{"text":"yatɨni makumariwe 'Ixaheri hetsiemieme?","poem":2},{"text":"¿Titayari neteɨterima mɨpaɨ mete'utiyuane:","poem":1},{"text":"“Tekanixɨxɨnini, tawari 'ahetsɨa tepɨka'axɨani”?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"¿Kamɨtsɨ tiyɨwe 'uka 'ɨimari yukukate mɨraye'atɨka mɨratɨmaiya,","poem":1},{"text":"yatɨni wikiwame 'iwiyari matɨmaiya?","poem":2},{"text":"Neuxei mɨixa wiyariri kananuyemieni","poem":1},{"text":"neteɨterima memɨnetsihatɨmaitsie.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Keperakumate 'ekɨ","poem":1},{"text":"pemɨwakuwaunikɨ 'ahamatɨa memɨkahini.","poem":2},{"text":"Matsi 'ukarawetsixi 'axamemɨte'u'iyari","poem":1},{"text":"'ahetsie mepɨtehetimamateke.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"'Akamixa xuriyamakame pepanakatɨkɨ,","poem":1},{"text":"teɨteri wahetsie mɨkarahɨiwa waxuriya meta nutuite,","poem":2},{"lineBreak":true},{"text":"hatsuaku pemɨkawarutaxei metenawatɨweme.","poem":2},{"text":"Naime 'ikɨkɨ","poem":1}]},{"type":"verse","number":35,"content":[{"text":"'ahetsie nepɨrahɨani:","poem":1},{"text":"mɨpaɨ pemutainekɨ kename 'axapekatiyuriwe,","poem":2},{"text":"mɨpaɨ pemutainekɨ kename 'atsipekatiyuruwame,","poem":1},{"text":"mɨpaɨ pemutainekɨ meta: “Kakaɨyari pɨkaha'ari nehamatɨa”.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Yapauka pepɨ'akupata hipame wahetsie pɨta petiwiyamɨtɨ.","poem":1},{"text":"Yaxeikɨatsiere 'Ekipitu kameniku'eirimɨkɨ,","poem":2},{"lineBreak":true},{"text":"'Atsiriya kemɨmatiuku'eiri hepaɨ.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Mana pekaniyeyeimɨkɨ 'akatutsitɨa peheukumetɨkaitɨ,","poem":1},{"text":"karikɨ Yawé kaniwarexɨrieni","poem":2},{"text":"kemɨ'ane wahetsie pemɨtiwiyakai,","poem":1},{"text":"wahamatɨa 'aixɨa pepɨkatiyeyani.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JER/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JER/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JER/1.json","previousChapterAudioLinks":{},"numberOfVerses":37}