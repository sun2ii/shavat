{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JER","translationId":"hch_wb2","name":"Keremiyaxi","commonName":"Keremiyaxi","title":"Keremiyaxi","order":24,"numberOfChapters":52,"sha256":"771a2352ddb97ef3895e81db88d089eedf1f7c4caac6b2b7f4b4d6b3602b468f","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/hch_wb2/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":20,"content":[{"type":"heading","content":["Keremiyaxi Patsuxi matɨa"]},{"type":"verse","number":1,"content":["Kepauka mawari wewiwame Patsuxi 'Imexi nu'aya, Yawé tukieya mɨhɨritɨarie mexɨakame mɨhɨkɨtɨkai, mu'enaxɨ Keremiyaxi kemɨtikuxatakai,"]},{"type":"verse","number":2,"content":["'ana katiniuta'aita Keremiyaxi Kakaɨyari niukameya mukuweiyaxɨanikɨ meta Wenikamini kitenieyari 'amautitewatsie kɨyexi hanuyexaxawametsie memeiye'ɨkatsitɨanikɨ, Yawé tukieya manuwe hɨxie."]},{"type":"verse","number":3,"content":["'Uxa'arieka, kepauka Patsuxi kɨyexi mayunexaxawatsie mixɨnaxɨ, Keremiyaxi mɨpaɨ katinitahɨawe: «Yawé Patsuxi pɨkamatiterɨwari, matsi pɨta “Marika naitsarie” pepɨtitewaka."]},{"type":"verse","number":4,"content":["Mɨpaɨtsɨ Yawé kanaineni: “Marika 'ahetsie nekani'atɨamɨkɨ meta 'ahamikuma wahetsie, mɨkɨ memɨwaraye'unie mekaniwakwikuni, 'ekɨtɨtɨ pekaniwaxeiyamɨkɨ. Kura kiekatari yunaime nekaniwayetuamɨkɨ Wawiruniyatsie ti'aitame hetsɨa, Wawiruniya paitɨ mekananuhapaniekuni, yatɨni 'ixiparakɨ pɨxekwini."]},{"type":"verse","number":5,"content":["Metatsiere, memɨxe'aye'unie nekaniwayetuiriemɨkɨ naime tita waɨkawa xemɨteheuxeiya 'ikɨ kiekariyaritsie, naime tita xemɨte'ukaxei xete'uximayatɨ meta waɨkawa mɨraye'atɨka, meta Kura kwieyaritsie te'aitamete tita piinite mɨraye'atɨka memɨtehexeiyakai, memɨtewanawatsirienikɨ meta memɨtehanutɨnikɨ Wawiruniya paitɨ."]},{"type":"verse","number":6,"content":["'Ekɨta Patsuxi pekananuhaniemɨkɨ Wawiruniya paitɨ meta yunaitɨ 'atɨɨriyama. Mana pekanemɨmɨkɨ, mana pekanekateukiemɨkɨ yunaitɨ 'ahamikuma wahamatɨa kemɨ'ane yakɨ xeikɨa pemɨtiwakuxaxatɨwakai”»."]},{"type":"heading","content":["Keremiyaxi kemɨtiuyu'uximatɨa"]},{"type":"verse","number":7,"content":[{"text":"Yawé, pepɨnetsi'ukwamanaxɨ 'aniuki witsi'anemekɨ,","poem":1},{"text":"neta nepɨmatsi'anu'eni.","poem":2},{"text":"'Ekɨ matsi waɨkawa pepɨtɨrɨkaɨyekai,","poem":1},{"text":"pepɨnetsi'a'iwaxɨ.","poem":2},{"text":"Yunaitɨ teɨteri mepɨnetsinanaima,","poem":1},{"text":"yamepɨnete'atse tukarikɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kepauka nemutaniuka, mɨpaɨ nepɨtiuhiwa:","poem":1},{"text":"«Nanaimarika 'ukanamieniri».","poem":2},{"text":"'Ayumieme Yawé niukieyakɨ","poem":1},{"text":"neyuriyarietɨ nepayeika","poem":2},{"lineBreak":true},{"text":"meta nenanaimarietɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Xɨka mɨpaɨ ne'utayɨni: «Tawari nepɨka'enuku'erieni,","poem":1},{"text":"tawariri hetsiena mieme nepɨkatitaxata»,","poem":2},{"text":"hikɨ niukieya netaɨta","poem":1},{"text":"tai hepaɨ 'anetɨ kanayeikani","poem":2},{"lineBreak":true},{"text":"ne'umeyari 'ɨarime kanititaiyani.","poem":2},{"text":"Nepɨtikuwaune nemɨtinewienikɨ,","poem":1},{"text":"peru nepɨkayɨwe netinewienike.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yɨmɨireme nepɨwa'enie menetsinanaimatɨ mɨpaɨ meputiyuane:","poem":1},{"text":"«Naitsarie marika puxuawe».","poem":2},{"text":"Hipatɨta mɨpaɨ mekaniutiyuaneni: «Xekeneutaxaneta.","poem":1},{"text":"Hikɨmɨtɨka tepitaxaneta».","poem":2},{"text":"Nehamikutsixitɨtɨ","poem":1},{"text":"yamekatena'eriwani nemekawenikɨ.","poem":2},{"text":"Meta mɨpaɨ mekaniutiyuaneni: «Tepiwiniya.","poem":1},{"text":"'Anake tekane'iwakuni","poem":2},{"lineBreak":true},{"text":"tekatenekapitɨakuni».","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Peru Yawé nehamatɨa kaniuyeikani","poem":1},{"text":"yumemiwame kwinimieme mɨtiyɨwe hepaɨ,","poem":2},{"text":"'ayumieme memɨnetsi'uweiya","poem":1},{"text":"mekana'iwariekuni mekapɨyɨwekaxɨani,","poem":2},{"lineBreak":true},{"text":"yamepɨkateyurieni mekaniyutitetewiyakuni.","poem":2},{"text":"Ke'axamemɨ'itɨarieni","poem":1},{"text":"hatsuaku pɨkahatɨmaiyarieni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yawé Naimekɨpemɨtɨrɨkaɨye, 'ekɨ","poem":1},{"text":"'aixɨa mɨtiuka'iyari pemɨmate,","poem":2},{"lineBreak":true},{"text":"tewi kemɨtiyu'iyaritɨa kemɨtiku'eriwa pemi'enie,","poem":2},{"text":"keneneuxeitsitɨa kepemɨtiwarakapitɨani,","poem":1},{"text":"'ahetsɨari nekaniwayetuani kememɨnetsiyurie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yawé xekenenɨawani kwikarikɨ.","poem":1},{"text":"Mɨkɨ tixaɨtɨ memɨkateheuxeiya kaniwawikweitsitɨaka","poem":2},{"lineBreak":true},{"text":"'axamemɨte'u'iyari mewaruweiyakaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"'Axake'itɨarieka 'iya tukari nematinuiwaxɨtsie.","poem":1},{"text":"'Axake'itɨarieka 'iya tukari kepauka nemaama mɨnetsi'ayexeitsie.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Axake'itɨarieka 'iya tewi nepaapa mutemawieritɨa","poem":1},{"text":"kepauka mɨpaɨ mɨtitahɨawixɨ: «'Ukitɨme pekanayexeiya».","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yawé kiekarite kemɨtiuka'unaxɨ kawareunenimayatɨ","poem":1},{"text":"mɨpaɨ ke'u'itɨarieni mɨkɨ tewi.","poem":2},{"text":"Hiwarika ximeri ke'enieka","poem":1},{"text":"meta tuka mɨrayukwine hiwariyari.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"¿Ketitayari nemaama yuriepana paitɨ Kakaɨyari","poem":1},{"text":"kanetiupitɨa nemɨmɨnikɨ?","poem":2},{"text":"Mɨpaɨ mɨkɨ neteukiya payanikekai,","poem":1},{"text":"ne 'ana nepɨkatinuiwakekai hetsiena.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"¿Ketitayari nemaama yuriepana neranuyetɨa","poem":1},{"text":"'uximatɨarika xeikɨa nemɨxeiyakɨ meta hiwerika,","poem":2},{"lineBreak":true},{"text":"meta nemɨmɨnikɨ tewiyarika tsata?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JER/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JER/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JER/19.json","previousChapterAudioLinks":{},"numberOfVerses":18}