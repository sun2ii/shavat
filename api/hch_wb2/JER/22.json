{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JER","translationId":"hch_wb2","name":"Keremiyaxi","commonName":"Keremiyaxi","title":"Keremiyaxi","order":24,"numberOfChapters":52,"sha256":"771a2352ddb97ef3895e81db88d089eedf1f7c4caac6b2b7f4b4d6b3602b468f","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/hch_wb2/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":22,"content":[{"type":"heading","content":["Te'aitamete 'axamemɨte'u'iyari wahepaɨtsita"]},{"type":"verse","number":1,"content":["Yawé mɨpaɨ kanaineni: «Kenemie Kura kwieyaritsie ti'aitame kie, muwa 'ikɨ niuki kenetaxata:"]},{"type":"verse","number":2,"content":["“'Ekɨ, Kura kwieyaritsie ti'aitame, Rawiri 'uwenieyatsie pemaka, 'aparewiwamete meta 'ateɨterima, 'ikɨ kitenieyaritsie memeutahake, Yawé niukieya xekeneu'eni."]},{"type":"verse","number":3,"content":["Mɨpaɨ kanaineni Yawé: ‘Yaxeketeneyurieka kemɨtiheitserie meta kehepaɨ 'aixɨa mɨ'ane. Munawarie xekeneɨxɨna minanaima tɨrɨkariyaya mamayatsie. 'Ateewa kiekame 'axaxepɨkayurieka xepɨka'inanaimaka, meta nutui, meta wiura, metatsiere xeime xepɨkakumemiwani 'atsikatiyurieneme 'ikɨ kwieyaritsie."]},{"type":"verse","number":4,"content":["Xɨka yemekɨ 'ikɨ niuki xehaye'atɨani, hikɨ 'ana 'ikɨ paratsiyu kitenie mekaneutahaxɨakuni te'aitamete Rawiri 'uwenieya hetsie memayaxe, kaxetatetsie me'utetɨ meta kawayutsixi wahetsie, yuparewiwamete mewarawitɨtɨ meta yuteɨterima."]},{"type":"verse","number":5,"content":["Peru 'ikɨ niuki xɨka xekahaye'atɨani, ne mɨpaɨ nekanaineni 'ikɨ paratsiyu 'uniyari kwinienetɨ kanikemɨkɨ. Ne Yawé, mɨpaɨ nekanaineni’ ”»."]},{"type":"verse","number":6,"content":["Karikɨ Yawé mɨpaɨ kanaineni 'ikɨ paratsiyu Kura mieme hepaɨtsita:",{"text":"«'Ekɨ nekɨmana, Karaha hepaɨ pekani'aneni","poem":1},{"text":"meta Riwanu wiyeyari hepaɨ,","poem":2},{"text":"peru ne mɨpaɨ nekanaineni makumawe nekamanayeitɨamɨkɨ,","poem":1},{"text":"kiekarite ka'akukiepayatɨkaime.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Ahetsɨa te'unamete nekamaneutanɨ'airiemɨkɨ,","poem":1},{"text":"yu'ɨrɨ me'ɨ'ɨkame yuxexuitɨ,","poem":2},{"text":"'akariuxa memawitexɨanikɨ witsimɨtitemari","poem":1},{"text":"meta taipa mekaneixɨrikuni.","poem":2}]},{"type":"verse","number":8,"content":["»Teɨteri waɨkawamexɨa kiekatari 'ena mekaniuyekɨnikuni, hikɨ mɨpaɨ mekateniyuta'iwawiyakuni: “¿Titayari Yawé 'ikɨ kiekari mumariwe mɨyatiuyuri?”"]},{"type":"verse","number":9,"content":["Mɨpaɨta mekatenita'eiyariekuni: “Yawé yukakaɨyari tɨratuya memuku'eirikɨ, hipame kakaɨyarixi pɨta mewarayexeiyatɨ meta metewa'uximayatsirietɨ memakɨkɨ”»."]},{"type":"verse","number":10,"content":[{"text":"Xepɨka'utitsuanani mumɨ hepaɨtsita,","poem":1},{"text":"meta xepɨkayuhiwerieka hetsiena mieme.","poem":2},{"text":"Xekeneutitsuanani matsi mehanie hetsiemieme,","poem":1},{"text":"hatsuaku mɨkanuani hepaɨtsita","poem":2},{"lineBreak":true},{"text":"meta tawariri yukwie mɨkaxeiyakɨ matinuiwaxɨtsie.","poem":2}]},{"type":"verse","number":11,"content":["Yawé mɨpaɨ kanaineni Tsaruni hetsiemieme Kutsiyaxi nu'aya, Kura kwieyaritsie ti'aitame, yupaapa 'utɨa manukake Kutsiyaxi, mehanie 'ateewa: «Tawari mɨkanuani,"]},{"type":"verse","number":12,"content":["matsi kanemɨmɨkɨ hakewa mehanie. 'Ikɨ kwieyari tawariri pɨkaxeiya."]},{"type":"verse","number":13,"content":[{"text":"»Xɨa'ui nepaine yukii mɨwewiene hepaɨtsita","poem":1},{"text":"meta heimana menawewiwa","poem":2},{"lineBreak":true},{"text":"tiyukananaimatɨ meta heitserie katiyurienetɨ.","poem":2},{"text":"Xɨa'ui nepaine yuhepaɨ tewi waɨriyarika mɨti'aitɨa hetsiemieme","poem":1},{"text":"yakɨxeikɨa mɨti'uximayatsitɨa,","poem":2},{"lineBreak":true},{"text":"mɨti'uximayakɨ mɨkatipitɨa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Xɨa'ui nepaine mɨpaɨ mutaine hetsiemieme: “Kii nekanitawewimɨkɨ waɨkawa mariweme,","poem":1},{"text":"wapaitɨ 'a'uyeyeyeume”.","poem":2},{"text":"'Ituparite 'etsimayeyeutsie neniereme 'aheuyeyeume mepeuyepiexɨa,","poem":1},{"text":"herie kariuxa kɨyeyari kamaneme meta xetamekɨ kawiriyariekame.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"»¿Kamɨtsɨ peti'aitametɨni","poem":1},{"text":"kariuxakɨ waɨkawamekɨ mɨya petiuyurieka?","poem":2},{"text":"'Apaapa pɨkatikwakai xeikɨa pɨkati'iekai xeikɨa,","poem":1},{"text":"matsi heitserie yapɨtiyurienekai meta tita mɨti'aixɨa,","poem":2},{"lineBreak":true},{"text":"'ayumieme 'aixɨa 'iyari puyeikakai.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kemɨ'ane tixaɨtɨ mɨkarexeiya puparewiekai meta kemɨ'ane mɨreuyehɨwa,","poem":1},{"text":"'ayumieme 'aixɨa 'iyari puyeikakai.","poem":2},{"text":"¿Mɨpaɨ kati'ane kemɨ'ane mɨnetsimate?","poem":1},{"text":"—Yawé mɨpaɨ kanaineni—.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"»Peru 'ahɨxite meta 'a'iyari","poem":1},{"text":"'iwarika 'axamɨti'ane xeikɨa pukuwautɨwe,","poem":2},{"text":"mepɨtekuwautɨwe xeikɨa 'atsimemɨkate'u'iyari waxuriya memɨtayeurienikɨ","poem":1},{"text":"meta waɨriyarika memɨte'aitanikɨ meta nanaimarikakɨ».","poem":2}]},{"type":"verse","number":18,"content":["'Ayumieme mɨpaɨ kanaineni Yawé Kura kwieyaritsie ti'aitame hepaɨtsita Kuhatsimi Kutsiyaxi nu'aya:",{"text":"«Xewitɨtɨma hetsiena mieme pɨkatatsuani meta mɨpaɨ pɨkatihiwa:","poem":1},{"text":"“Xɨa'ui ne'iwatɨkai 'uki. Xɨa'ui ne'iwatɨkai 'uka”.","poem":2},{"text":"Xewitɨ pɨkayukahiwerieni hetsiena mieme meta mɨpaɨ pɨkatihiwa:","poem":1},{"text":"“Xɨa'ui, tati'aitɨwametɨkai. Xɨa'ui, mumariwekai”.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Puxu hepaɨ katineteukiemɨkɨ,","poem":1},{"text":"Kananuyehaniemɨkɨ kanehɨiyamɨkɨ,","poem":2},{"lineBreak":true},{"text":"Kerutsareme kitenieyaritetsie 'ateewa paitɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«Riwanu hɨriyaritsie keneutiyaka karima keneutahiwa,","poem":1},{"text":"meta Watsani hetsie.","poem":2},{"text":"'Awarini hetsie paitɨ keneutahiwani,","poem":1},{"text":"yunaitɨ 'atuxexerima memukwi'iwaxɨkɨ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ne nepɨmatsi'utahɨawixɨ kepauka 'aixɨa 'iyari pemuyeikakaitsie,","poem":1},{"text":"peru 'ekɨ mɨpaɨ peputayɨ: “Ne nepɨkamatsi'enieni”.","poem":2},{"text":"'Ɨimariyari paitɨtɨ mɨyapepɨtiuka'iyari:","poem":1},{"text":"hatsuaku pepɨkanetsihanu'eniwe.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yunaime muxatsi wahɨwemete 'eka kaniwaranu'enitsitɨamɨkɨ,","poem":1},{"text":"meta xetuxexerima 'ateewa mekananuhapaniekuni.","poem":2},{"text":"Xeme 'axaxemɨte'uyurikɨ","poem":1},{"text":"hikɨ xepuyutitetewiya tixaɨtɨ xepɨkatehayeitɨarieni.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"'Ekɨ Riwanu tsata pemayeka,","poem":1},{"text":"kariuxatsata 'a'itɨa pemutawewi,","poem":2},{"text":"kepetitsuani kepauka 'akukuiniya munuani,","poem":1},{"text":"niweyame kukuiniyaya hepaɨ».","poem":2}]},{"type":"verse","number":24,"content":["Yawé mɨpaɨ kanaineni: «Ne yurikɨ nemayeyuri mɨpaɨ nekanaineni, tsepa Kekuniyaxi Kuhatsimi nu'aya, Kura kwieyaritsie ti'aitame, nemamá tserieta hanira hepaɨ mɨ'ane, mana nekanenutixɨnamɨkɨ."]},{"type":"verse","number":25,"content":["Ne nekamaniyetuamɨkɨ memɨmatsimieku wahetsɨa meta waɨkawa pemɨwamakaxe wahetsɨa, tatsɨari Nawukurunutsuxi hetsɨa, Wawiruniyatsie ti'aitame, meta wawiruniyutsixi wahetsɨa."]},{"type":"verse","number":26,"content":["'Ekɨ meta 'amaama mɨmatsi'utiniwexɨ xeime kwieyaritsie nekameneutahɨamɨkɨ xemɨkahatinunuiwaxɨtsie, meta mana xekanekwikuni."]},{"type":"verse","number":27,"content":["Hatsuakuri xepɨka'axɨani yukwietsie xeme'eriwanitsie»."]},{"type":"verse","number":28,"content":[{"text":"Kekuniyaxi xari mɨkaheuyehɨiya mɨtari pɨhɨkɨ,","poem":1},{"text":"xewitɨ mɨka'iheiwe'erie.","poem":2},{"text":"¿Titayari xeime kwieyaritsie reutahɨiya mɨkɨ meta yunaitɨ nuiwaritemama,","poem":1},{"text":"xeime kwieyaritsie memɨka'imatetsie?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Kwie, kwie, kwie.","poem":1},{"text":"Yawé niukieya keneu'eni.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Yawé mɨpaɨ kanaineni: «'Ikɨ tewi xekenaka'utɨa","poem":1},{"text":"tewi mɨka'utinuari hepaɨ,","poem":2},{"lineBreak":true},{"text":"tewi 'aixɨa mɨkatiyetɨa hepaɨ.","poem":2},{"text":"Karikɨ nixewitɨ xiɨyarieyatɨtɨ","poem":1},{"text":"Rawiri 'uwenieyatsie pɨkatita'aita,","poem":2},{"lineBreak":true},{"text":"meta hatsuaku pɨkatita'aita Kura kwieyaritsie».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JER/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JER/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JER/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}