{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JER","translationId":"hch_wb2","name":"Keremiyaxi","commonName":"Keremiyaxi","title":"Keremiyaxi","order":24,"numberOfChapters":52,"sha256":"771a2352ddb97ef3895e81db88d089eedf1f7c4caac6b2b7f4b4d6b3602b468f","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/hch_wb2/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":["»'Inɨarikɨ, xewitɨ 'uki yɨ'ɨya kaniuku'eirieni, mɨkɨta 'uka kanihayewa xeime pɨta 'uki tiwitɨnike. ¿Tiyɨwe 'uki matɨari mewitɨkɨkai nuame mitiwitɨnikɨ? Pɨkayɨwe. Mɨpaɨ xɨkatiuyɨni kwie naime ka'itiyakame kanayeitɨamɨkɨ. Mɨpaɨ kani'aneni, 'ekɨri yumɨireme pekaniwarukumayɨani, 'ayumieme pekapɨyɨweri nehetsɨa hutarieka pemunuani —Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":2,"content":[{"text":"»Keneuxeiya 'iya hɨrite mɨmeetse:","poem":1},{"text":"Hakewa 'ahamatɨa pɨkarekahitɨwe.","poem":2},{"text":"Harawe tewiyari makumawetsie 'amuyeika hepaɨ,","poem":1},{"text":"huye tetsita pepɨkayeixakai,","poem":2},{"lineBreak":true},{"text":"'atuxexerima pewakwewietɨ.","poem":2},{"text":"Kwie ka'itiyakame pekanayeitɨani","poem":1},{"text":"memɨka'akɨnama wahamatɨa pehunetɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Ayumieme pɨkawiyemɨkɨ,","poem":1},{"text":"'ayumieme taxarita mieme wiyeri pɨkanua.","poem":2},{"text":"'Ukaratsi tuminikɨ muyuwitɨnɨa hepaɨ pepɨti'akɨhɨawe,","poem":1},{"text":"tewiyarika pepɨkamate.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mɨixa wiyari pɨka'anuyemie mɨpaɨ pemɨnetiumarekai:","poem":1},{"text":"“Nepaapa, 'ɨimariyari pemɨnehamiku,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"¿'aheyemekɨ petiha'a?","poem":1},{"text":"¿Haxɨa peti'utani 'aheyemekɨ?”","poem":2},{"text":"Mexi petikuxatakai,","poem":1},{"text":"kepemɨtiuyɨwekaxɨa 'axapepɨtiuyuri».","poem":2}]},{"type":"heading","content":["'Ixaheri ke'axamɨtiuka'iyari"]},{"type":"verse","number":6,"content":["Kepauka Kutsiyaxi ti'aitametɨkaku Yawé mɨpaɨ kanetiniutahɨawe: «¿Petimate kemɨtiyuriene 'Ixaheri, yamɨkatikamie hɨkɨtɨtɨ? Kaneyani hɨri 'amanutitɨtɨtsie, mana kɨyexi mɨ'e'etɨtɨa tuminikɨ muyumayɨinɨa kanayuyeitɨani."]},{"type":"verse","number":7,"content":["Ne mɨpaɨ nepɨtiku'eriwakai 'arike mɨpaɨ tiyurieme tsenekatɨ tinenuani nehetsɨa. Peru pɨkanua nehetsɨa. Taruya 'ikɨ naime pɨtiuxei, Kura yamɨkatikamie,"]},{"type":"verse","number":8,"content":["yaxeikɨatatsiere punierixɨ kenemɨtiku'eiri 'Ixaheri mɨnetsihehɨa, 'eiriya xapayari kenemɨtitawewiri hipame wahamatɨa mukahuikɨ. Mɨyatɨtɨ taruya, Kura 'axamɨtiuka'iyari, pɨka'utima, yaxeikɨa pɨnetsi'uku'eiri, hipame wahamatɨa hunetɨ kanayani."]},{"type":"verse","number":9,"content":["»'Ixaheri mɨkatiuhayewaxɨkɨ hipame wahamatɨa hunetɨ, kwie ka'itiyakame kanayeitɨani meta kemɨ'ane mɨkayɨkɨna mukumaɨwa kanayuyeitɨani tete meta kɨye kakaɨyarixiyari muwarayexeiyakaikɨ."]},{"type":"verse","number":10,"content":["Tsepanetɨ 'ikɨ naitɨ mɨyamɨtiɨyɨ, taruya Kura 'axamɨtiuka'iyari, pɨkanua nehetsɨa yu'iyarikɨ, kenametɨ nehetsɨanua kaniuyɨni», Yawé mɨpaɨ kanaineni."]},{"type":"verse","number":11,"content":["Yawé mɨpaɨ kanetiniutahɨawe: «Mɨnetsihehɨa 'Ixaheri matsi 'aixɨa pɨtiuka'iyari keyuri Kura 'axamɨtiuka'iyari."]},{"type":"verse","number":12,"content":["Kenemie tayeta 'ikɨ niuki kenetaxata:",{"text":"»“Kenenua, 'Ixaheri pemɨnetsi'uku'eiri.","poem":1},{"text":"Neha'atɨ nepɨkamatsixeiya","poem":2},"—Yawé mɨpaɨ kanaineni—.",{"text":"Haxɨari 'ahetsiemieme nepɨka'utani yuheyemekɨ,","poem":1},{"text":"ne nemɨtiyukanenimayakɨ","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":13,"content":[{"text":"Keneu'atimaixɨa xeikɨa ke'axapemɨtiuyuri,","poem":1},{"text":"meta kename Yawé pe'aye'unietɨ pehatɨa 'akakaɨyari.","poem":2},{"text":"Naime kɨyexi mɨ'e'etɨtɨka hetɨa","poem":1},{"text":"hipame kakaɨyarixi pepɨwarayexeiyakai,","poem":2},{"lineBreak":true},{"text":"meta kepemɨkati'awaɨriya yapemɨtikamienikɨ”».","poem":2}]},{"type":"verse","number":14,"content":["Yawé mɨpaɨ kanaineni: «Nehetsɨa xekeneu'axɨa xemɨnetsi'uku'eiri, karikɨ ne xekɨna nekanihɨkɨtɨni. Yuxexuime xeikiekariyaritsie nepɨwarayewitɨxɨani meta yuhuhutakame xeinuiwaritsie miemete, Tsiyuni paitɨ nepuwa'atɨani."]},{"type":"verse","number":15,"content":["Muxatsi wahɨwemete nepɨwahɨritɨani yamemɨtekahu kemɨnetinake, memɨwa'ɨwiyanikɨ metemaiwawetɨ meta mete'akumaitɨ."]},{"type":"verse","number":16,"content":["»'Iya tukaritsie, kepauka xemuyutimɨire kepauka xemɨyuwaɨkawani 'ikɨ kwieyaritsie, 'ipaɨri pɨkatitaniukieni: “Tɨratu kakuniyari Yawé hetsiemieme”. Xewitɨri pɨkahe'eriwani, hauyewetɨ pɨkahayani meta hekwatɨ pɨkatawewiyani —mɨpaɨ kanaineni Yawé—."]},{"type":"verse","number":17,"content":["»'Iya tukaritsie Kerutsareme pɨtiterɨwarieni: ‘‘Yawé 'uwenieya”. Yunaitɨ nuiwarite mepuyukuxeɨrieni Kerutsareme memeyexeiyanikɨ Yawé kemɨtitewa, meta yu'iyari 'axamɨtiuka'iyari mepɨka'eniekari."]},{"type":"verse","number":18,"content":["»Mɨkɨ tukaritsie Kura nuiwariyari mepuyutinɨni 'Ixaheri xiɨyarimama wahamatɨa, yunaitɨ mekanayekɨnikuni tayeta kwie mukumatsie, mekani'axɨakuni kwie watutsima nemɨwayetuiritsie."]},{"type":"verse","number":19,"content":["»Ne mɨpaɨ nepɨtiunehɨawixɨ:",{"text":"»“Ne neniwe 'uki hepaɨ nemereuxeiyamɨkɨkaku,","poem":1},{"text":"kwie yuheiwe'erinɨakame nepɨmatsiyeturienikeyu,","poem":2},{"lineBreak":true},{"text":"'imikieri yemekɨ witsimɨ'ane 'ikɨ nuiwarite watsata”.","poem":2},{"text":"Ne mɨpaɨ nepɨtiku'eriwakai “Ne'ukiyari” penetimareke nepɨ'eriekai,","poem":1},{"text":"meta hatsuaku penetsi'uweiyatɨ pekatihayewake nepɨ'eriekai.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Peru 'ekɨ, 'Ixaheri tewiyari,","poem":1},{"text":"pepɨkanetsiheu'enie","poem":2},{"lineBreak":true},{"text":"'ukaratsi yɨkɨna 'uku'eirieka xeime manukuwei hepaɨ»,","poem":2},"Yawé mɨpaɨ kanaineni."]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Hiwari payu'eniɨriɨkɨ hɨrite mɨmeetsetsie,","poem":1},{"text":"'Ixaheritsixi wahiwerika hiwariyari,","poem":2},{"text":"'axameteyurietɨ 'amemu'uwakaikɨ,","poem":1},{"text":"Yawé yukakaɨyari mematɨmaikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Xekeneu'axɨa, xemɨnetsi'uku'eiri,","poem":1},{"text":"nepɨxeti'uayemani heitserie xemɨka'u'uwakɨ».","poem":2},{"lineBreak":true},{"text":"«'Ena tepu'uwa, 'ahetsɨa teputi'axe,","poem":1},{"text":"'ekɨ Yawé takakaɨyari pemɨhɨkɨkɨ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yurikɨ hɨritsie ketemɨteyuriekai pɨtikwamanarika,","poem":1},{"text":"meta yemuritsie kemɨtiutatɨrarɨka pɨti'itarika.","poem":2},{"text":"Yurikɨ Yawé takakaɨyari hetsie","poem":1},{"text":"'Ixaheri wikweitsitɨarikaya puxuawe.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kakaɨyarixi kepauka tewarayexeiyatɨ temakɨ","poem":1},{"text":"pɨtiutixɨ piinite tatutsima 'etsiteyumatekaku memɨte'ukaxeiyakai:","poem":2},{"text":"muxatsi meta wakaitsixi,","poem":1},{"text":"tɨɨri 'ukitsi meta 'ukari.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Tatewiyarikatsie tepahini,","poem":1},{"text":"tatewinɨarika ketatsi'anukanani.","poem":2},{"text":"Tame meta tatutsima","poem":1},{"text":"Yawé takakaɨyari hepaɨtsita 'axatepɨte'uyuri.","poem":2},{"text":"Tɨɨriyari paitɨtɨ meta hikɨ 'akuxi,","poem":1},{"text":"yatepɨkatekakɨniwawe Yawé takakaɨyari kemɨtinake».","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JER/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JER/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JER/2.json","previousChapterAudioLinks":{},"numberOfVerses":25}