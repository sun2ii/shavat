{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JER","translationId":"hch_wb2","name":"Keremiyaxi","commonName":"Keremiyaxi","title":"Keremiyaxi","order":24,"numberOfChapters":52,"sha256":"771a2352ddb97ef3895e81db88d089eedf1f7c4caac6b2b7f4b4d6b3602b468f","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/hch_wb2/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":30,"content":[{"type":"heading","content":["'Ixaheri ke'aixɨa mɨ'itɨarieni"]},{"type":"verse","number":1,"content":["Yawé niukieya Keremiyaxi hetsɨa kaninuani:"]},{"type":"verse","number":2,"content":["«Yawé mɨpaɨ kanaineni, 'Ixaheri Kakaɨyarieya: “Xapatsie ketinaka'utɨa naime tita nemɨmatiutaxatɨa”."]},{"type":"verse","number":3,"content":["Yawé mɨpaɨ kanaineni: “Karikɨ tukari kanaye'amɨkɨ, kepauka ne nemɨwarakunuitɨani memehapaniekai neteɨterima 'ixaheritsixi meta Kura teɨteriyari, nekaniwa'atɨamɨkɨ kwie wa'ukiyarima nemɨwayetuiritsie, hikɨ mana mekanitiyaxikuni”», Yawé mɨpaɨ kanaineni."]},{"type":"verse","number":4,"content":["'Ikɨ Yawé niukieya kanihɨkɨtɨni Keremiyaxi kemɨtiutaxatɨa 'Ixaheri meta Kura kwieyari wahepaɨtsita:"]},{"type":"verse","number":5,"content":["«Yawé mɨpaɨ kanaineni:",{"text":"»“Memumariutsie wahiwari tepɨ'enie,","poem":1},{"text":"kayuwatɨ pɨka'uma, matsi marika xeikɨa puxuawe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xekeneuti'iwau xekeneuyu'ɨwiya","poem":1},{"text":"'ukitsi kuta metetiniweya.","poem":2},{"text":"¿Titayaritsɨkamɨ yunaime 'ukitsi netiwaxeiya","poem":1},{"text":"yukwatsapaɨtsie me'akɨwɨkame,","poem":2},{"lineBreak":true},{"text":"'ukarawetsixi memɨtiniwexɨaxime wahepaɨ?","poem":2},{"text":"¿Titayari kwinimieme mete'anakamama","poem":1},{"text":"yunaitɨ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Xɨa'ui. Mɨkɨ tukaritsie pumariwekareni,","poem":1},{"text":"tukari hatsuaku kemɨkatiyɨwe pɨtiyɨni.","poem":2},{"text":"Kakuwu hetsiemieme hiwerika pɨrayani,","poem":1},{"text":"peru mana ya'anekɨa payewikweitsitɨarieni”.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"»Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye: “'Iya tukaritsie,","poem":1},{"text":"yuku nekanitamuramɨkɨ neteɨterima yɨkɨipi heima memetɨkɨ,","poem":2},{"text":"kɨmana memɨwiwietɨka nekanititekimɨkɨ,","poem":1},{"text":"hatsuakuri teewatari tewa'uximayatsiriwamete mepɨkahakɨne.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yawé, yukakaɨyari xeikɨa xepɨte'uximayatsirieka,","poem":1},{"text":"meta Rawiri, tixe'aitɨwame nepayeitɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"»”Pepɨkamaka, Kakuwu, neti'uximayatsiriwame, pepɨka'utimamaweni 'Ixaheri","poem":2},"—Yawé mɨpaɨ kanaineni—.",{"text":"'Ekɨ Kakuwu, nekamenixɨnamɨkɨ mɨkɨ kwie 'ateewa mukuma hetsie,","poem":1},{"text":"meta 'anuiwarima memehapanie neniwa'atɨamɨkɨ.","poem":2},{"text":"'Aixɨa 'iyari pe'uyeikatɨ pekanayeimɨkɨ meta peka'uximatɨarietɨ,","poem":1},{"text":"Hatsuakuri xewitɨ pɨkamatsitimariuta.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Karikɨ ne 'ahamatɨa nekaniuyeikani nemetsitawikweitsitɨanikɨ","poem":1},"—Yawé mɨpaɨ kanaineni—.",{"text":"Yunaime nuiwarite nekaniwaka'unamɨkɨ yuheyemekɨ","poem":1},{"text":"kemɨ'ane wahetsɨa nemetsiheutanɨ'akai.","poem":2},{"text":"Peru 'ekɨ naime nepɨkametsika'una,","poem":1},{"text":"matsi nepumatikwinitɨani kemɨtiheitseriekɨ xeikɨa,","poem":2},{"lineBreak":true},{"text":"peuyewetsetsiere nemumatikwinitɨakakɨ”.","poem":2}]},{"type":"verse","number":12,"content":["»Yawé mɨpaɨ kanaineni:",{"text":"»“Kenemumatikwinitɨa pɨkayu'uayemarinɨa, 'ahaiya 'uayeyari pɨkaxɨawe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Xewitɨ pumawe 'ahetsie mɨtanuanikɨ kepemɨranuyemie,","poem":1},{"text":"ke'axapemɨtiuyurikɨ pumawe 'uayeyari","poem":2},{"lineBreak":true},{"text":"meta 'akwiniyakɨ 'aixɨa pemɨtika'erienikɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yunaitɨ memumatsinaki'eriekai mepumatsi'uku'eiri,","poem":1},{"text":"mepɨkamatsiha'eriwari.","poem":2},{"text":"Waɨkawa 'axapemɨtiuyurikɨ,","poem":1},{"text":"meta mɨmɨirekɨ ke'axapemɨtiuyuri,","poem":2},{"text":"nekamenanayewayani nekamenayemari'itɨwani,","poem":1},{"text":"xewitɨ mɨrayuye'unie kemɨrayurieni hepaɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"¿Ketitayari pera'aiwa 'akukuiniyakɨ,","poem":1},{"text":"panatsi 'akukuiniya yu'uayemarinɨa?","poem":2},{"text":"Ke'axapemɨtiuyuri pɨtimɨire","poem":1},{"text":"meta waɨkawamekɨ 'axapemɨtiuyurikɨ,","poem":2},{"lineBreak":true},{"text":"'ayumieme mɨyanekametinipitɨaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"»”Yunaitɨ kemɨ'ane memɨxetikwani mekanitikwaiyakuni,","poem":1},{"text":"yunaitɨ memɨxe'aye'unie 'ateewa mekananuhapaniekuni.","poem":2},{"text":"Yunaitɨ kemɨ'ane memɨxetenawatsirieni mekateninawatsiyariekuni,","poem":1},{"text":"yunaitɨ kemɨ'ane memɨtexenawairieni mekateninawaiyariekuni.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Peru ne nekamenimanetsikitɨamɨkɨ","poem":1},{"text":"meta kepemɨtiukwinitɨarie nekani'uayemamɨkɨ","poem":2},"—Yawé mɨpaɨ kanaineni—",{"text":"pemehɨiya pemɨtiuterɨwaruwakaikɨ,","poem":1},{"text":"Tsiyuni tixaɨtɨ mɨkarexeiya, xewitɨ mɨkahe'eriwakɨ”.","poem":2}]},{"type":"verse","number":18,"content":["»Yawé mɨpaɨ kanaineni:",{"text":"»“Kakuwu xamaruyata tita mɨtiyepikai nekatinanuitɨamɨkɨ,","poem":1},{"text":"meta xekiite nekanitinenimayatamɨkɨ,","poem":2},{"text":"kiekari kaniyukamamɨkɨ maku'unarie hetsie,","poem":1},{"text":"meta paratsiyu kaniyukakemɨkɨ hakewa mewekai.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Xehetsie kwikari witsi'anɨyɨtɨ kaniyeyeimɨkɨ,","poem":1},{"text":"temawierika hiwariyari.","poem":2},{"text":"Xexiɨyarima nekaniwatamɨiriyamɨkɨ, yu'utɨa xepɨkakakɨne,","poem":1},{"text":"nexenaki'erietɨ nekanayeimɨkɨ, xepɨkatixani'eriwari.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Xeniwema 'ukitsi meripai kememɨ'anekai mɨpaɨ mekani'anekuni,","poem":1},{"text":"nehɨxie xekiekari kanikumakamɨkɨ,","poem":2},{"lineBreak":true},{"text":"peru kemɨ'ane memɨxe'aye'unie nekatiniwakwinitɨamɨkɨ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Xetsata manuyeyerɨni kanayenemɨkɨ,","poem":1},{"text":"mɨkɨ xewitɨ xeti'aitɨwame kanayeimɨkɨ.","poem":2},{"text":"Ne'aurie hurawa 'uyeikame nekanayeitɨamɨkɨ, mɨkɨ nehamatɨa 'uyeikatɨ payani,","poem":1},{"text":"¿kemɨ'ane yutukari puyetuawe nehetsɨa maye'anikɨ?","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":22,"content":[{"text":"Xeme neteɨterima xepɨhɨkɨtɨni,","poem":1},{"text":"neta Xekakaɨyari nepɨhɨkɨtɨni”».","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Yawé 'ekaya","poem":1},{"text":"kanayeyani ha'atɨ,","poem":2},{"text":"'eka waɨkawa tɨrɨkaɨyetɨ haikɨri tiyumemiwatɨ","poem":1},{"text":"kanayenɨ'arieni 'axamemɨte'u'iyari wahetsiemieme.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yawé haxɨaya pɨkatihayewa","poem":1},{"text":"matsi kemutayɨ naitɨ pɨraye'ani","poem":2},{"lineBreak":true},{"text":"'iyarieya kemɨtiyɨkɨhɨawe.","poem":2},{"text":"Naime 'ikɨ hetsie xekatenetimaikuni","poem":1},{"text":"'imatɨrieka tukariyaritsie.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JER/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JER/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JER/29.json","previousChapterAudioLinks":{},"numberOfVerses":24}