{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JER","translationId":"hch_wb2","name":"Keremiyaxi","commonName":"Keremiyaxi","title":"Keremiyaxi","order":24,"numberOfChapters":52,"sha256":"771a2352ddb97ef3895e81db88d089eedf1f7c4caac6b2b7f4b4d6b3602b468f","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/hch_wb2/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":["Yawé mɨpaɨ kanaineni: «'Iya tukaritsie, 'Ixaheri tɨɨriyamama Wakakaɨyari nepɨhɨkɨtɨni mɨkɨta neteɨterima mepɨhɨkɨtɨni»."]},{"type":"verse","number":2,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«Teɨteri memuyuti'awietaxɨ tiyukwitɨnekaku,","poem":1},{"text":"makumawetsie 'aixɨa 'iyari mekateniuyaxe,","poem":2},{"lineBreak":true},{"text":"'Ixaheri kepauka 'uxipiya mukuwaunekaitsie».","poem":2}]},{"type":"verse","number":3,"content":["Mɨixa wiyari panuyemie kepauka Yawé mɨpaɨ mɨnetiutahɨawixɨ:",{"text":"«Hawaikɨ kaheu'akamekɨ nepɨmetsinaki'erie,","poem":1},{"text":"'ayumieme 'aixɨa 'anemekɨ nepɨxe'ɨwiya,","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"'Ɨimari 'ixaheri mieme.","poem":2},{"text":"Hekwamekɨ nekamenanukuketɨamɨkɨ,","poem":1},{"text":"puyuri, tawari petɨrɨkaɨyetɨ pepayani.","poem":2},{"text":"Hekwamekɨ tepu 'etsimɨyeyeu xekaniti'ɨikuni","poem":1},{"text":"temawierikakɨ xekatenikaneikuni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tawari kaxie xekanika'ekuni","poem":1},{"text":"Tsamariya hɨriyaritsie,","poem":2},{"text":"kemɨ'ane memika'eni","poem":1},{"text":"meyutemamawietɨ mepikwaka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tukari kanaye'amɨkɨ kepauka tehɨwemete","poem":1},{"text":"memɨtihiwa 'Epɨrahini hɨriyaritsie:","poem":2},{"text":"“Xekenatihuni, Tsiyuni paitɨ tepanutikɨne,","poem":1},{"text":"Yawé hɨrieyatsie takakaɨyari”».","poem":2}]},{"type":"verse","number":7,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«Xekeneutikwikani xeyutemamawietɨ Kakuwu hetsiemieme,","poem":1},{"text":"temawierikakɨ xekeneutihiwani nuiwarite 'aixɨa memɨ'itɨarie wahetsiemieme.","poem":2},{"text":"Nɨawarika kwi xekeneu'enitsitɨa mɨpaɨ xe'utiyuatɨ:","poem":1},{"text":"“Yawé, 'ateɨterima keniwarutawikweitsitɨa,","poem":2},{"lineBreak":true},{"text":"'Ixaheri hetsie memuyuhayewaxɨ keniwarutawikweitsitɨa”.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne tayeta kiekari mukumatsie nekanixe'ayewitɨmɨkɨ,","poem":1},{"text":"nekanixekuxeɨrimɨkɨ tsepa hakewa paitɨ xeme'uwa.","poem":2},{"lineBreak":true},{"text":"Yumɨiretɨ mekani'axɨakuni.","poem":2},{"text":"Xehamatɨa mekani'axɨakuni memɨkaheuneniere meta memuhurietɨka,","poem":1},{"text":"memayehukatɨka meta memɨniwetɨka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Xe'utitsuatɨ xekani'axɨakuni,","poem":1},{"text":"nexenɨtɨatɨ nekanixe'ayewitɨmɨkɨ.","poem":2},{"text":"Hakewa haa mauyehane mana nekanixe'atɨamɨkɨ","poem":1},{"text":"huyeta 'uwerikaku","poem":2},{"lineBreak":true},{"text":"xemɨkahekaxɨrienikɨ.","poem":2},{"text":"Ne 'Ixaheri paapaya nepɨhɨkɨ,","poem":1},{"text":"neniwe 'Epɨrahini mexɨakame pɨhɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"»Nuiwarite, Yawé niukieya xekeneu'eni,","poem":1},{"text":"meta xekenekuxatani haramara tetsita meteewatsie paitɨ:","poem":2},{"text":"“Kemɨ'ane 'Ixaheritsixi mɨwareutaweiyaxɨa, mɨkɨ kaniwakuxeɨrimɨkɨ,","poem":1},{"text":"muxatsi wahɨweme hepaɨ nekatiniwa'ɨwiyamɨkɨ”.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yawé 'Ixaheritsixi puwarutawikweitsitɨa,","poem":1},{"text":"memɨtɨrɨkawi wahetsɨa kaniwarayewitɨni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mekani'axɨakuni Tsiyuni hɨriyari 'amanutitewitsie paitɨ mekanitakwikakuni,","poem":1},{"text":"Yawé witsimɨtiuka'iyarikɨ mepuyutemamawieka:","poem":2},{"text":"nepɨtixeyetuirieni tɨriku, kaxie winuyari mɨhekwa meta hatseiti,","poem":1},{"text":"muxatsi waniwema meta wakaitsixi.","poem":2},{"text":"'Iteɨri 'aixɨa mɨreukuhatuiyarie hepaɨ xekani'anekuni,","poem":1},{"text":"tawariri xeweraranitɨ xepɨkahakɨne.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hikɨ 'ana 'ɨimarixi temawierikakɨ mepɨtekaneini,","poem":1},{"text":"temari meta 'ukirawetsixi yunaitɨ.","poem":2},{"text":"Wakukuiniya temawierika nekanayeitɨamɨkɨ meta nekaniwanɨtɨamɨkɨ,","poem":1},{"text":"kememɨte'uka'eniwa temawierika nekanayeitɨamɨkɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mawari wewiwamete memɨtekwaka waɨkawa mepɨtehexeiyani,","poem":1},{"text":"meta 'aixɨa mekateniu'uwakuni neteɨterima»,","poem":2},"Yawé mɨpaɨ kanaineni."]},{"type":"verse","number":15,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«Xamatsie paitɨ hiwari pa'eniɨriɨkɨ,","poem":1},{"text":"tsuari meta hiwerika.","poem":2},{"text":"Xakeri kanetaineni, yuniwema 'ukitsi wahekɨ hetatsɨatɨ","poem":1},{"text":"meta mɨkɨ kapɨyɨnɨtɨarinɨa,","poem":2},{"lineBreak":true},{"text":"niwemamari 'ukitsi memɨka'u'uwakɨ».","poem":2}]},{"type":"verse","number":16,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«Ketineuhayewa pe'utatsɨatɨ,","poem":1},{"text":"'a'ukai kena'itiexɨa,","poem":2},{"text":"kepemɨtiuka'eniwakɨ mɨkɨkɨ pepɨrakapitɨarieni:","poem":1},{"text":"'aniwema 'ukitsi kiekari muwaraye'unietsie mekanayekɨnikuni","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":17,"content":[{"text":"Tita pemɨtitakwewie pepɨkahetɨtɨmaiyani:","poem":1},{"text":"'aniwema 'ukitsi yukiekaritsie mekani'axɨakuni","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"»Nekani'enieniri 'Epɨrahini kiekatari wahiwerika:","poem":1},{"text":"“Tepɨtekwinitɨarie tuuru mɨkamaxiu hepaɨ,","poem":2},{"lineBreak":true},{"text":"hikɨ yatepɨteha'eriwa pemɨtatsitimaxiutakɨ.","poem":2},{"text":"Ketane'atɨa, 'aixɨa ketaneuyuri,","poem":1},{"text":"'ekɨtsɨ, takakaɨyari, Yawé pekanihɨkɨtɨni.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tame tepumatsi'uku'eiriekai, peru tepaye'eri,","poem":1},{"text":"mɨpaɨ teteheyutimaika tatawitsie tepeuyuhutsunakai.","poem":2},{"text":"Tepeuyutetewiya tixaɨtɨ tepɨkatehayuyeitɨa","poem":1},{"text":"temariyari ketemɨte'utewinɨarie mɨtimɨirekɨ”.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"»'Epɨrahini tewiyari neniwe 'uki neminaki'erie pɨhɨkɨ.","poem":1},{"text":"'Ikɨ neniwe 'uki kanihɨkɨtɨni waɨkawa neminaki'erie.","poem":2},{"text":"Kepauka nemɨtikwinitɨa,","poem":1},{"text":"nepeye'eriwa ne'inaki'erietɨ.","poem":2},{"text":"Mɨkɨ hetsiemieme waɨkawa nepɨne'iyaritɨa,","poem":1},{"text":"mɨkɨ waɨkawamekɨ nepeunenimaya","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"»'Ahuyeta 'inɨari keneuyewɨtɨaxɨa,","poem":1},{"text":"peha'inɨaritatɨ hakewa pemeuyetɨa,","poem":2},{"lineBreak":true},{"text":"huyeta 'aixɨa ketineyɨ'ɨwiya.","poem":2},{"text":"'Ixaheri 'ɨimari kenenua,","poem":1},{"text":"kenakunua tawari 'akiekaritsie.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"¿Kepaukake pepɨtihayewa pekuyeikatɨ,","poem":1},{"text":"neniwe 'uka yapemɨkatikamie?","poem":2},{"text":"Yawé tihekwame katininetɨamɨkɨ 'ena kwiepa,","poem":1},{"text":"'ukaratsi yukɨna hetsɨa kaninuamɨkɨ».","poem":2}]},{"type":"verse","number":23,"content":["Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye, 'Ixaheri Kakaɨyarieya: «Kepauka ne 'aixɨa pe'itɨariekame nemɨmatsi'ayeitɨani, Kura kwieyaritsie meta kiekariteyaritsie mɨpaɨ mekaniutiyuanekuni:",{"text":"»“Hɨri mɨpatsie, heitserie mexeiya kie:","poem":1},{"text":"Yawé kexe'ɨwiyani”.","poem":2}]},{"type":"verse","number":24,"content":["Mana 'axeikɨa mekanititekuni Kura meta kiekariteyari, yunaitɨ 'etsamete meta muxatsi wahɨwemete."]},{"type":"verse","number":25,"content":["Mɨyeharimɨne nekaniharitɨamɨkɨ meta mɨyehakamɨne nekatinimimɨkɨ»."]},{"type":"verse","number":26,"content":["'Ana nekananutaniere, meta nehɨxite nekananutayepiexɨani. Witsiti'anemeri netiuheinɨka."]},{"type":"verse","number":27,"content":["Yawé mɨpaɨ kanaineni: «Tukari kanaye'amɨkɨ, teɨteri waniwema meta tewaxi waniwema nekaniwaka'emɨkɨ, 'Ixaheri meta Kura kwieyaritsie nekaniwatamɨiriyamɨkɨ."]},{"type":"verse","number":28,"content":["Mɨpaɨ kenemɨtiwata'ɨwiya nemɨwaka'unakɨ meta kenemɨtiwarakumaweriya, 'uximatɨarika newapitɨatɨ, yaxeikɨata nemɨwaranuku'uitɨanikɨ meta nemuwaranukayatsakɨ nepɨyɨwe —Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":29,"content":["'Iya tukaritsie mɨpaɨ pɨkatitaniukieni:",{"text":"»“Wapaapama kaxie takari matsina meputikwai,","poem":1},{"text":"waniwemata 'ukitsi watamete pɨkɨitsietɨka”.","poem":2}]},{"type":"verse","number":30,"content":["'Apɨtata, kemɨ'ane kaxie hatsiname mɨtikwani tameteya kanikɨitsiexɨamɨkɨ, tatsɨaritɨtɨ yuxexuitɨ ke'axamemɨte'uyurikɨ mekanikwikuni»."]},{"type":"verse","number":31,"content":["Yawé mɨpaɨ kanaineni: «Tukari kanaye'amɨkɨ, tɨratu hekwame nemɨwewienitsie 'ixaheri teɨteriyari meta Kura xiɨyarimama wahamatɨa."]},{"type":"verse","number":32,"content":["Tɨratu kenemɨtiuwewi wa'ukiyarima wahamatɨa mɨpaɨ pɨka'aneni, kepauka 'Ekipitu nemɨwarayewitɨ mɨkɨ yamepɨkatekakɨ, tsepa ne wakɨna nemɨhɨkɨtɨkai —Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":33,"content":["»'Ikɨ tɨratu kanihɨkɨtɨni 'iya tukari 'anuyeyayu nemɨwawewirieni 'ixaheri teɨteriyari —Yawé mɨpaɨ kanaineni—: Wa'eriwametsie ne'inɨari niukiyari nepɨwapitɨani meta wa'iyaritsie nekanika'utɨamɨkɨ. Ne wakakaɨyari nekanihɨkɨtɨkamɨkɨ mɨkɨta neteɨterima mepɨhɨkɨtɨni."]},{"type":"verse","number":34,"content":["Pɨkayɨweniri xewitɨ yuhepaɨ tewi mɨti'ɨkitɨakakɨ meta yu'iwa mɨpaɨ haitɨ: “Yawé kenemateni”, karikɨ yunaitɨ, 'etsimemuyumate paitɨ meta 'amemuyumate mekanenetimaikuni —Yawé mɨpaɨ kanaineni—. Ne ke'axamemɨte'uyurikɨ nekatiniwareuyehɨwiriemɨkɨ, hatsuakuri nepɨkahaye'erieni»."]},{"type":"verse","number":35,"content":[{"text":"Yawé mɨpaɨ kanaineni,","poem":1},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye pɨtitewa,","poem":2},{"text":"kemɨ'ane tau mɨtatsiyetuirie tukarikɨ mɨkɨxenikɨ,","poem":1},{"text":"metseri meta xurawetsixi, tɨkarikɨ memɨhekɨariwiekakɨ,","poem":2},{"lineBreak":true},{"text":"meta haramara muwatayuitɨwa hamewarieya mutatɨrarɨkanikɨ:","poem":2}]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"«Xɨka 'ikɨ 'inɨarikɨ mekatehaye'atɨaka","poem":1},"—Yawé mɨpaɨ kanaineni—,",{"text":"hikɨ 'ana 'Ixaheri xiɨyarimama","poem":1},{"text":"tawariri hatsuaku nenuiwarima mepɨkahɨkɨtɨni».","poem":2}]},{"type":"verse","number":37,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«Xɨka muyuawi kemeutitewa yu'inɨatsinɨakake,","poem":1},{"text":"meta kwie tsutɨmeyari yuxeiyanɨakake,","poem":2},{"text":"hikɨ ne 'Ixaheri nuiwarieya nepuwaruku'eirienike","poem":1},{"text":"naimekɨ ke'axamemɨte'uyurikɨ.","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":38,"content":["Yawé mɨpaɨ kanaineni: «Tukari kanaye'amɨkɨ Yawé kiekarieya manukuketɨarienikɨ, tuxiyu Kananeri manuwe tsutɨarietɨ kitenie 'Itsikina mɨtitewatsie paitɨ ye'atɨkaitɨ."]},{"type":"verse","number":39,"content":["Kaunari ti'inɨnɨatame heitserie kanihaniemɨkɨ, mana Karewi hɨriyaritsie paitɨ, Kuha paitɨ kanititunimɨkɨ."]},{"type":"verse","number":40,"content":["Naitɨ mayeweri hakewa mɨkite memeukaxɨriwa meta naxi, naitɨ kwietsanari, Kiruni 'akiyaritsie paitɨ meta kawayutsixi wakitenieyaritsie, mutatsikuri tau manatineika hepatsie, mɨkɨ kanipatsiekamɨkɨ Yawé hetsiemieme. Hatsuakuri kiekari pɨkahahunarieni meta pɨkaka'unarieni»."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JER/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JER/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JER/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}