{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JER","translationId":"hch_wb2","name":"Keremiyaxi","commonName":"Keremiyaxi","title":"Keremiyaxi","order":24,"numberOfChapters":52,"sha256":"771a2352ddb97ef3895e81db88d089eedf1f7c4caac6b2b7f4b4d6b3602b468f","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/hch_wb2/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Yawé mɨpaɨ kanaineni:","poem":1},{"lineBreak":true},{"text":"«'Ixaheri, xɨka penuamɨkɨ nehetsɨa,","poem":1},{"text":"kenenua nehetsɨa.","poem":2},{"text":"Xɨka nehɨxie kakaɨyarixi pewarexɨrieni memɨxani'eriwa","poem":1},{"text":"meta xɨka pekanetsi'uku'eirieni,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"xɨka yurikɨ, 'aixɨa 'anemekɨ meta heitseriemekɨ,","poem":1},{"text":"yape'utayɨni: “Yurikɨ Yawé 'amuyeikakɨ”,","poem":2},{"text":"hikɨ, “hetsiena mieme nuiwarite 'aixɨa me'itɨarietɨ mepakɨne,","poem":1},{"text":"meta me'inɨawatɨ mepakɨne”».","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yawé mɨpaɨ kanaineni","poem":1},{"text":"Kura meta Kerutsareme kiekatari wahetsiemieme:","poem":2},{"text":"«Xekenekwietsanatɨweni hakewa mɨkareka'etsitɨwetsie,","poem":1},{"text":"meta xuyatsata xepɨka'etɨweni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kura kwieyaritsie kiekatari meta Kerutsareme,","poem":1},{"text":"yu'iyaritsie xeketeneu'utɨa tɨratu 'inɨariyarikɨ:","poem":2},{"lineBreak":true},{"text":"xitekiya 'inɨariyari xekeneuyuwewiri Yawé xemayexeiyanikɨ,","poem":2},{"text":"nɨkahɨrixɨa 'axaxemɨte'uyurikɨ","poem":1},{"text":"nehaxɨa 'utani tai hepaɨ","poem":2},{"lineBreak":true},{"text":"kayutɨnɨatɨ xe'utitaiya.","poem":2}]},{"type":"heading","content":["Kura kemɨtika'unarienikekai"]},{"type":"verse","number":5,"content":[{"text":"»'Ikɨ xeketenetaxata Kura kwieyaritsie,","poem":1},{"text":"meta xeketenetaxata Kerutsareme kiekariyaritsie.","poem":2},{"lineBreak":true},{"text":"'Awa xekeneutahɨtsi naitsarie 'ikɨ kwieyaritsie.","poem":2},{"text":"Kwi mɨpaɨ xeketeneuhiwa:","poem":1},{"text":"“Xekeneuyukuxeɨri meta tekaneutahaxɨakuni","poem":2},{"lineBreak":true},{"text":"kiekarite yukuraru 'ahatitetewame mexeiyatɨkata”.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tsiyuni xekeneutamawiya paterakɨ memuyuta'unakɨ,","poem":1},{"text":"hakewa xemeyuti'awieta xekeneutiwawa, kayuwatɨ xepɨkate'uka.","poem":2},{"text":"Ne xeyetatsie nekanekanetɨamɨkɨ","poem":1},{"text":"'uximatɨarika meta tiyu'uname mariweme.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Maye yuterɨta kanewayeyaniri,","poem":1},{"text":"xewitɨ nuiwarite 'uname kanayeyaniri,","poem":2},{"text":"yukie kanayeyaniri","poem":1},{"text":"'akwie 'akumaweme mɨhayewakɨ,","poem":2},{"text":"'akiekarite 'u'unitɨ kaniyuhayewamɨkɨ","poem":1},{"text":"meta yemekɨ kiɨripa kanayeimɨkɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"'Ayumieme, hiwerika kamixayari xekenanakatɨxɨa,","poem":1},{"text":"xekeneutitsuanani xeyu'iyaritɨatɨ,","poem":2},{"text":"karikɨ Yawé haxɨaya mɨtiyukwaxiya","poem":1},{"text":"'akuxi tahetsie pɨkahayeyeiwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"»'Iya tukaritsie ti'aitame peuyuyehɨani","poem":1},{"text":"meta teɨteri wahetsiemieme memanuyetei mepeuyuyexɨrieni,","poem":2},{"text":"mawari wewiwamete waɨkawa mepɨtimamani","poem":1},{"lineBreak":true},{"text":"meta Kakaɨyari niukametetemama mepɨkatexatawaweni»,","poem":1},"Yawé mɨpaɨ kanaineni."]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ne mɨpaɨ nekaniutayɨni: «Neuxei, Yawé nekakaɨyari,","poem":1},{"text":"pepɨwakwamanane 'ikɨ teɨteri meta Kerutsaremetari.","poem":2},{"text":"Mɨpaɨ peputayɨ: “Kayuwatɨ mepexeiyani”,","poem":1},{"text":"peru xɨari 'ixipara wakɨipitɨa peuwe».","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"'Iya tukaritsie mɨpaɨ mepɨtetahɨawarieni","poem":1},{"text":"'ikɨ teɨteri meta Kerutsaremetari:","poem":2},{"text":"«Hɨrite mɨmeetse makumawetsie mɨtiteitsie paitɨ","poem":1},{"text":"'eka xɨkatɨ pataneika","poem":2},{"lineBreak":true},{"text":"neteɨterima wakiekari nemɨnaki'erie makuma hepa 'erietɨ.","poem":2},{"text":"Mɨkɨ 'eka tihename pɨkahɨkɨ","poem":1},{"text":"meta tɨriku hename pɨkahɨkɨ,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"'eka nemanɨ'ani mɨpaɨ pɨka'ayumieme","poem":1},{"text":"mɨkɨ matsi waɨkawa pɨtɨrɨkaɨye,","poem":2},{"text":"karikɨ ne yanekanitayɨmɨkɨ","poem":1},{"text":"wahetsie nekatiniɨhɨamɨkɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Xekeneuxeiya hai hepaɨ 'a'ahume.","poem":1},{"text":"Kaxetamama wiyeri mɨtɨrɨkaɨye hepaɨ pɨtiyuxexeiya.","poem":2},{"text":"Kawayutsiximama kwinimieme matsi mepayɨwawe kwixɨtsi kememɨkahayɨwawe.","poem":1},{"text":"Xɨa'ui tame. Tame tepeuyexɨri.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kerutsareme, 'a'iyaritsie keneu'a'iti 'axamɨti'anekɨ,","poem":1},{"text":"pemɨtawikweitsitɨarienikɨ.","poem":2},{"text":"¿Kepaukake pepɨtihayewa","poem":1},{"text":"'iyaritɨarika kemɨmatikuyuitɨwa?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Xewitɨ pahiwa 'uximatɨarika haxaxatatɨ","poem":1},{"text":"Rani kwieyaritsie paitɨ meta 'Epɨrahini hɨriyaritetsie paitɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"«Xekeniwarayehɨtɨa nuiwarite,","poem":1},{"text":"xeketeneutaxata Kerutsareme kiekariyaritsie:","poem":2},{"text":"“'Ateewa kiekatari mepɨ'axɨani memɨtatsi'anutinanikɨ","poem":1},{"text":"kuyaxa hepaɨ mete'uhiwatɨ","poem":2},{"lineBreak":true},{"text":"Kura kiekariteya hepaɨtsita”.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mepaketɨkɨ waritana 'etsiya mɨhɨrieka hepaɨ,","poem":1},{"text":"netsi'aye'unietɨ matɨakɨ","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":18,"content":[{"text":"Kepemɨtiuka'iyari kepemɨtiyuriene","poem":1},{"text":"'ayumieme 'ikɨ mɨya pepɨranuyemie.","poem":2},{"text":"'Ikɨ 'a'uximatɨarika kanihɨkɨtɨni. Kwinimieme pɨratsiwi.","poem":1},{"text":"Pɨmatikwinitɨa 'a'iyaritsie».","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Waɨkawa nepɨnehiwerie, nepɨtiuka'eniwa.","poem":1},{"text":"Kukuiniya pɨnetsi'uta'ɨimura.","poem":2},{"text":"Ne 'iyari puwatayuane. Xɨa'ui ne'iyari.","poem":1},{"text":"Kayuwatɨ nemɨtiuyerɨni nepɨkayɨwe.","poem":2},{"text":"Nepi'enie 'awa metahɨtsieriwa","poem":1},{"text":"meta hiwari mɨrayukwine mieme.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Xɨka tiuyutakwini tawarita pɨtiyutakwini,","poem":1},{"text":"naitɨ 'ikɨ kwieyari pɨka'unariexime.","poem":2},{"text":"Yapauka puka'unarie","poem":1},{"text":"ne'ixuriki kiiyari hakewa nemayekatei.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"¿Kepaukari tamɨ patera kayuwatɨ pɨtamare","poem":1},{"text":"meta 'awa hetahɨtsieriwatɨ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Neteɨterima mepɨka'u'iyari,","poem":1},{"text":"mepɨkanetsimate,","poem":2},{"text":"tɨɨri 'atsimemɨkatemate mepɨhɨkɨ","poem":1},{"text":"memɨkatemaiwawe.","poem":2},{"text":"Kwinimieme mepanayeyɨne 'axamemɨteyurienikɨ,","poem":1},{"text":"'aixɨa memɨteyurienikɨ mepɨkamate».","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Kwiepa nepeukanierixɨ, kwie pɨkamatsiɨkɨkai puyuxamuriekai,","poem":1},{"text":"muyuawitsie nepeutinierixɨ, manatatsiere naitɨ pɨyɨwikai.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Hɨrite nepuxei, puyɨyɨakatɨkatei,","poem":1},{"text":"naitɨ yemurite pɨti'unikekai.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nemunierixɨ, xewitɨ tɨma pɨkayuhayewanekai,","poem":1},{"text":"yunaitɨ wikixi mepeuyuta'unaxɨakai.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nemunierixɨ, kwie 'aixɨa mɨ'ane makumawe pɨhɨkɨtɨkai,","poem":1},{"text":"naitɨ kiekarite 'u'unitɨ puyuhayewanekai,","poem":2},{"text":"Yawé mɨyamɨtiuyuriekaikɨ,","poem":1},{"text":"haxɨaya mɨtiyukwaxiyakɨ.","poem":2}]},{"type":"verse","number":27,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«Naitɨ 'ikɨ kwieyari 'akumawetɨ kanayeimɨkɨ,","poem":1},{"text":"peru naimeta nepɨkaka'una.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"'Ayumieme 'ikɨ kwieyari puyuhiwerieka,","poem":1},{"text":"meta muyuawi meutitewatsie pɨkɨyɨre,","poem":2},{"text":"'ari mɨpaɨ nekaniutayɨni, nepɨkatihayewa,","poem":1},{"text":"'ari mɨpaɨ nepɨtiu'eri, ne'ɨtɨa nepɨkatayani».","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Tupikɨ temɨmɨmete meta kawayutsixi wahetsie memutei wayuariya me'enietɨ","poem":1},{"text":"yunaitɨ kiekatari mepɨtananautsa.","poem":2},{"text":"Hipatɨ 'ɨtsita mepɨtahake,","poem":1},{"text":"hipatɨta 'aitsie mepeutiwɨwɨre.","poem":2},{"text":"Naitɨ kiekari puku'eiriwaxɨ,","poem":1},{"text":"xewitɨ tɨma kiekame pɨka'uyuhayewaxɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"¿Kepetiyurimɨkɨ, kiekari pemuka'unarie?","poem":1},{"text":"¿Titayari 'ixuriki witsimɨtixeta peranakatɨkɨ?","poem":2},"¿Titayari huru pereukapine?",{"text":"¿Titayari 'ahɨxita perayu'utɨwa?","poem":2},{"text":"Yakɨ xeikɨa witsipepɨ'akuyuruwa,","poem":1},{"text":"karikɨ 'atuxexerima mekamenixani'erieka,","poem":2},{"lineBreak":true},{"text":"mepiwautɨwe xeikɨa kememɨmetemienikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":["Hiwari nepɨ'enie, niweyame hiwarieya hepaɨ 'anɨyɨneme,",{"text":"'aiwarika matɨari mɨniweneni 'aiwarikaya hepaɨ 'anɨyɨneme.","poem":2},{"text":"Tsiyuni witsimɨti'ɨimari 'aiwarieya kanihɨkɨtɨni,","poem":1},{"text":"waɨriyarika meka'ietɨyeika,","poem":2},{"text":"yumamá 'utatsetseratɨ mɨpaɨ mutaine:","poem":1},{"text":"«Xɨa'ui ne, nepɨmɨximeri.","poem":2},{"lineBreak":true},{"text":"Teyumiekate 'ari mepɨnetsiwiya».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JER/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JER/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JER/3.json","previousChapterAudioLinks":{},"numberOfVerses":31}