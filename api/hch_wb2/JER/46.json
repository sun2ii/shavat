{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JER","translationId":"hch_wb2","name":"Keremiyaxi","commonName":"Keremiyaxi","title":"Keremiyaxi","order":24,"numberOfChapters":52,"sha256":"771a2352ddb97ef3895e81db88d089eedf1f7c4caac6b2b7f4b4d6b3602b468f","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/hch_wb2/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":46,"content":[{"type":"heading","content":["Niuki 'Ekipitu hetsiemieme"]},{"type":"verse","number":1,"content":["Yawé niukieya Kayaɨyari niukameya Keremiyaxi hetsɨa kaninuani nuiwarite wahetsiemieme."]},{"type":"verse","number":2,"content":["'Ekipitu hetsiemieme, 'ikɨ niuki Parahuni Nekahu mɨtitewa ti'aitame 'Ekipitu kiekame kuyaximama kaniwahetsiemiemetɨni, naurieka wiyari ti'aitakaku Kuhatsimi Kutsiyaxi nu'aya, Kura kwieyaritsie ti'aitame, kana'iwarieni Karikemitsi tiyetewakaku, hatuxame 'Eupɨrate manuyeka 'aurie, ti'aitame Wawiruniya kiekame Nawukurunutsuxi kane'iwa:"]},{"type":"verse","number":3,"content":[{"text":"«Yuheima nunuwame 'amɨyewa meta 'etsimɨyewa xekeneukuha'arita,","poem":1},{"text":"meta xekeneuhuniri xemuyutakwinikɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kawayutsixi xekeniwaranutixiratɨaxɨa,","poem":1},{"text":"xekenanutiyaxi memanautsawawe wahetsie.","poem":2},{"text":"Xekeneuyukuha'aritɨa, yumu'utsie nunuwame xekenanuti'uitɨa.","poem":1},{"text":"Pitsika xekenanuyemɨtsɨtɨaxɨa, tepɨa kamixayari xekenanakatɨxɨa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Peru neuxei, ¿ketɨtɨ nepɨtiniere?","poem":1},{"text":"Kuyaximama mepa'iwarie,","poem":2},{"lineBreak":true},{"text":"memamatɨ yɨ'utɨma mepekɨka.","poem":2},{"text":"Meka'anakunenieretɨ mekaniyuta'unani.","poem":1},{"text":"Naitsarie memɨtama mekanimamaka","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":6,"content":[{"text":"Kemɨ'ane waɨkawa manautsawe pɨkayɨwe muyuta'una","poem":1},{"text":"meta waɨkawa mɨtɨrɨkaɨye pɨkayɨwe muwatawikweiya.","poem":2},{"text":"Tayeta, 'Eupɨrate hatetsitayaritsie","poem":1},{"text":"mekanitakeitsarietɨkɨkani meta mekanatixɨrɨweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"»¿Kemɨ'ane pɨyɨane manatimie Niru hatɨayari hepaɨ?","poem":1},{"text":"haa muwatayuitɨariwa hepaɨ kaniuyɨneni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"'Ekipitu kaniyɨaneni, Niru hatɨayari muwayeneka hepaɨ kanitimieni,","poem":1},{"text":"haa muwatayuitɨariwa hepaɨ kaniuyɨneni.","poem":2},{"text":"'Ekipitu mɨpaɨ kanaineni: “Teikɨ nekanitiyeimɨkɨ, kwie naime nekananukanamɨkɨ,","poem":1},{"text":"kiekarite naime nekanika'unamɨkɨ meta wateɨterima”.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Xekeneuyutakuya, kawayutsixi kwinie xemayɨwawe.","poem":1},{"text":"Kaxetate, karima xekeneyekɨni.","poem":2},{"text":"Meke'uhuni yemekɨ yukukuyamete.","poem":1},{"lineBreak":true},{"text":"Kɨmana memeyukunani meke'uti'ɨni","poem":1},{"text":"kuyaxi Kutsi meta Puti kiekatari.","poem":2},{"text":"Yutupi mekehatseiriyaxɨani","poem":1},{"text":"kuyaxi Ririyatari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"»'Ana tukari","poem":1},{"text":"tati'aitɨwame Yawé Naimekɨmɨtɨrɨkaɨye pɨhetsiemiemetɨni.","poem":2},{"text":"'Ana tukaritsie pɨyɨkɨhɨani,","poem":1},{"text":"memeye'unie katiniwarakapitɨamɨkɨ.","poem":2},{"text":"'Ixipara tiyumienetɨ kanitahuxaimɨkɨ,","poem":1},{"text":"hauharimɨtɨ xuriyakɨ 'aixɨa katinika'erimɨkɨ.","poem":2},{"text":"Tayeta kwieyaritsie,","poem":1},{"text":"'Eupɨrate hatetsitayaritsie,","poem":2},{"text":"tati'aitɨwame, Yawé Naimekɨmɨtɨrɨkaɨye,","poem":1},{"text":"waɨkawa puwakwini mawari hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"»'Uka 'ɨimari 'Ekipitu niweya,","poem":1},{"text":"Karaha kenemie waritsamu kenewaumie.","poem":2},{"text":"Yakɨ xeikɨa 'uayete pepɨtixeɨrie,","poem":1},{"text":"pepɨka'anayeweni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nuiwarite yamepɨtemateri kepemɨra'iwarie,","poem":1},{"text":"'ahiwari naitsarie kwiepa pɨ'enierie.","poem":2},{"text":"Yukɨmana kuyaxi yuhetsie mekaniuyexɨrɨweni,","poem":1},{"text":"hikɨ yunaitɨ kwiepa mekanatixɨrɨweni».","poem":2}]},{"type":"verse","number":13,"content":["'Ikɨ Yawé niukieya kanihɨkɨtɨni, Kakaɨyari niukameya Keremiyaxi hetsɨa munua, kepauka Nawukurunutsuxi Wawiruniyatsie ti'aitame 'Ekipitu tamienike munua:"]},{"type":"verse","number":14,"content":[{"text":"«'Ikɨ xeketeneutaxata 'Ekipitu kwieyaritsie,","poem":1},{"text":"xekeneutaxata Mikiruri kiekariyaritsie, Menipitsi meta Tapinetsi:","poem":2},{"text":"“'Aixɨa xeketeneuyu'uitɨa. Xekeneyukweriwayurieka.","poem":1},{"text":"'Ixipara yu'aurie katinamietɨyeikani”.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"¿Titayari 'akuyaxima metetihɨximawetɨka?","poem":1},{"text":"Mepɨkayɨwawe 'amemɨti'uka,","poem":2},{"lineBreak":true},{"text":"Yawé muwaratixɨrikɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yamekatenekaxɨrɨweni,","poem":1},{"text":"yuhetsie mekaniuyexɨrɨweni.","poem":2},{"text":"Mɨpaɨ mekateniyɨkɨhɨaweni: “Kenanukukexi,","poem":1},{"text":"tekani'axɨakuni tateɨterima wahetsɨa,","poem":2},{"text":"hakewa temetinunuiwaxɨ,","poem":1},{"text":"'ateewa mɨkarayukwinetsie paitɨ”.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mana mɨpaɨ mekateniuhiwani: “Parahuni yuarika xeikɨa kanihɨkɨtɨni.","poem":1},{"text":"Ti'aitame 'Ekipitu kiekame mɨrayu'iwakekaitsie 'ari panuyetɨa”».","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ti'aitame mɨpaɨ kaniutaineni: «Ne nekanayeyurini.","poem":1},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye nekatinitewaka.","poem":2},{"text":"Tawuxi hɨriyari hɨrite naime kemɨtiwara'iwa,","poem":1},{"text":"meta hɨri Kaximeru haramara kemɨra'iwa,","poem":2},{"lineBreak":true},{"text":"mɨpaɨ timariwetɨ 'upamie mɨxe'aye'unie.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"'Ekɨ, 'Ekipitu pemɨkiekame,","poem":1},{"text":"'a'ika keneukuha'aritɨa xeime kwieyaritsie xemanuhapanienikɨ,","poem":2},{"text":"karikɨ Menipitsi mɨrakutewatsie 'akumawetɨ kanayeimɨkɨ,","poem":1},{"text":"kii 'u'unitɨ puku'uni teɨteri mepumaweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"»Tsikeru wakiya xeiwiyari mexeiya 'Ekipitu kanihɨkɨtɨni,","poem":1},{"text":"peru 'umekanahuni hetsɨana meye'axɨanike nakatarixi tayeta miemete.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kuyaxi xaɨtsie kiekatari pareku me'uhutɨ","poem":1},{"text":"tsikerutsixi memeuwiyamatɨka wahepaɨ mepɨtematsiɨkɨ,","poem":2},{"text":"mɨkɨtatsiere mepukununuwa,","poem":1},{"text":"yunaitɨ meyɨnɨtɨ mepuyuta'una meka'uku'uwetɨ,","poem":2},{"text":"watukari maye'akɨ kememɨteka'unarienikekai,","poem":1},{"text":"kepauka memɨtekwinitɨarienikekai.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"'Ekipitu kaniyuta'una kuu hepaɨ 'utaitɨ,","poem":1},{"text":"meye'unie hepana yɨtɨrɨkarima 'amumiekɨ.","poem":2},{"text":"Hurawa hepana mekaniuhuni hatsa me'utɨkɨtɨ,","poem":1},{"text":"kɨ'ewemete wa'atɨ mepɨteyɨa,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"tsepa wa'ɨtsi mɨkahayeyeyɨkɨ,","poem":1},{"text":"naime mekanakuwitekeni —Yawé mɨpaɨ kanaineni—.","poem":2},{"text":"Mepuyumɨire 'utsikari wareuyeta,","poem":1},{"text":"mɨkɨ kɨ'ewemete,","poem":2},{"lineBreak":true},{"text":"nixewitɨ muwaruti'inɨata pɨkayɨwe.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"'Ekipitu witsimɨti'ɨimari kanitewiyarikatsitɨariemɨkɨ","poem":1},{"text":"meta kaniyetuiyamɨkɨ teɨteri tayeta kiekatari wahetsɨa».","poem":2}]},{"type":"verse","number":25,"content":["Yawé Naimekɨmɨtɨrɨkaɨye, 'Ixaheri Kakaɨyarieya mɨpaɨ kanaineni: «'Amuni nekatinikwinitɨamɨkɨ, Tewatsi kiekariyari wakakaɨyari, meta 'Ekipitu, meta wakakaɨyarixima meta mana te'aitamete, meta Parahuni meta yunaime kemɨ'ane hetsiena memɨtewiya."]},{"type":"verse","number":26,"content":["Nekaniwayetuamɨkɨ kemɨ'ane memɨwaraye'unie wahetsɨa, Nawukurunutsuxi hetsɨa, ti'aitame Wawiruniya kiekame, meta teɨterimama wahetsɨa. 'Ariketa 'Ekipitu kiepa kanayeimɨkɨ meripaitɨ hepaɨ —Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":27,"content":[{"text":"»Peru 'ekɨ, Kakuwu neti'uximayatsiriwame, pepɨkamaka,","poem":1},{"text":"pepɨka'utimamaweni, 'Ixaheri.","poem":2},{"text":"'Ateewa pe'uyeikame nekamenitawikweitsitɨamɨkɨ,","poem":1},{"text":"xeime kwieyaritsie pehanuhanieyu.","poem":2},{"text":"Kakuwu kayuwatɨ pehexeiyatɨ pekanayeimɨkɨ,","poem":1},{"text":"'aixɨa 'iyari pe'uyeikatɨ pekanayeimɨkɨ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"'Ekɨ Kakuwu neti'uximayatsiriwame, pepɨkamaka,","poem":1},{"text":"karikɨ ne 'ahamatɨa nekaniuyeikani —Yawé mɨpaɨ kanaineni—.","poem":2},{"text":"»Tsepa yunaime nuiwarite nemuwarutayuniyaxɨ","poem":1},{"text":"kemɨ'ane wahetsɨa nemumatsiheutanɨ'a,","poem":2},{"lineBreak":true},{"text":"'ekɨ matsi nepɨkametsihauyehɨani.","poem":2},{"text":"Kemɨtiheitseriekɨ nepɨmatsita'ɨxatsitɨani","poem":1},{"text":"peru metatsiere nepɨmatikwinitɨani».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JER/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JER/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JER/45.json","previousChapterAudioLinks":{},"numberOfVerses":28}