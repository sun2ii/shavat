{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JER","translationId":"hch_wb2","name":"Keremiyaxi","commonName":"Keremiyaxi","title":"Keremiyaxi","order":24,"numberOfChapters":52,"sha256":"771a2352ddb97ef3895e81db88d089eedf1f7c4caac6b2b7f4b4d6b3602b468f","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/hch_wb2/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":47,"content":[{"type":"heading","content":["Niuki Piritsiteutsixi wahetsiemieme"]},{"type":"verse","number":1,"content":["Parahuni Kahatsa katamiewekaku 'akuxi, Yawé yuniuki Kakaɨyari niukameya Keremiyaxi kaniupitɨani, piritsiteutsixi wahepaɨtsita:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["«Yawé mɨpaɨ kanaineni:",{"text":"»“Neuxei xekeneuxeiya. Haa tayeta mieme","poem":1},{"text":"haa muwayeneika hepaɨ putaine.","poem":2},{"text":"Kwie panukayunitɨwa meta tita mɨrexeiya,","poem":1},{"text":"meta kiekarite metatsiere teɨteri.","poem":2},{"text":"Yunaitɨ teɨteri meputihiwa.","poem":1},{"text":"Meputitsuana teɨteri kwiepa memɨtama.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mewa'enietɨ wakawayutsixi wanautsari","poem":1},{"text":"wakaxetate wayuarika me'enietɨ","poem":2},{"lineBreak":true},{"text":"meta kaxetate waketate me'enietɨ,","poem":2},{"text":"wapaapama yuniwema 'ukitsi mepɨwata'e'eiriwa,","poem":1},{"text":"mepɨkatɨrɨkawi marikakɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tukari kanaye'aniri","poem":1},{"text":"piritsiteutsixi memakumaweriyarienikɨ,","poem":2},{"text":"Tiru meta Tsiruni mɨnawaiyarienikɨ","poem":1},{"text":"kemɨ'ane 'akuxi minɨ'ɨ miparewie.","poem":2},{"text":"Piritsiteutsixi kaniwarakuyuniyamɨkɨ Yawé","poem":1},{"text":"metatsiere yunaime haramara tetsita kiekatari Katuri mɨtitewatsie.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yumu'utsie mekaniyukaxikani Kahatsa kiekatari,","poem":1},{"text":"'Atsikaruni kiekatari mekaniuwawetɨ mekanakɨne.","poem":2},{"text":"Xemeta, muweritsie kiekatari xemuyuhayewatɨwe,","poem":1},{"text":"xepɨkatehayewa xeyutixiteketɨ yuwaiyaritsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"»”'Ai nepaine, Yawé 'ixiparaya hetsiemieme.","poem":1},{"text":"Pepɨkatihayewa peyumienetɨ.","poem":2},{"text":"'Anawita kenakunuari.","poem":1},{"text":"'Ari kenewakexi, kayuwatɨri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"»”¿Ketitayari ti'uxipieka,","poem":1},{"text":"Yawé kanitanɨ'ani","poem":2},{"text":"'Atsikaruni mɨtamienikɨ","poem":1},{"text":"metatsiere haramara tetsita memɨtama?”»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}