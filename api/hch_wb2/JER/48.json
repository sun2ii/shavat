{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JER","translationId":"hch_wb2","name":"Keremiyaxi","commonName":"Keremiyaxi","title":"Keremiyaxi","order":24,"numberOfChapters":52,"sha256":"771a2352ddb97ef3895e81db88d089eedf1f7c4caac6b2b7f4b4d6b3602b468f","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/hch_wb2/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":48,"content":[{"type":"heading","content":["Niuki Muhawi hetsiemieme"]},{"type":"verse","number":1,"content":["Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye, 'Ixaheri kakaɨyarieya, Muhawi hetsiemieme:",{"text":"«Xɨa'ui Newu hetsiemieme, karikɨ kanika'unariemɨkɨ.","poem":1},{"text":"Kiriyatahini kaniwiyariemɨkɨ meta kanitewiyarikatsitɨariemɨkɨ.","poem":2},{"lineBreak":true},{"text":"Kiekarieya kuraruyari 'amatitewa nitixaɨtɨ pɨkarayeitɨarieni kanika'unariemɨkɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Muhawi witsikemɨtixeiyariekai kaniukumawere,","poem":1},{"text":"Hetsiwuni kiekariyaritsie mekatenikuxatani hepaɨtsitana mieme 'axamemiyurienikɨ:","poem":2},{"lineBreak":true},{"text":"“Neuxei, hikɨmɨtɨka 'ikɨ teɨteri tepɨwarakumaweriya”.","poem":2},{"text":"'Ekɨtsiere Marimeni, kayuwatɨ pekanitamarimɨkɨ,","poem":1},{"text":"pekananukuweiyariemɨkɨ 'ixiparakɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tsuari hiwariyari kana'eniɨriɨkɨni Kurunahini kiekariyaritsie mieme:","poem":1},{"text":"memuta'unariekɨ meta memakumaweriyariekɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Muhawi kanika'unariemɨkɨ,","poem":1},{"text":"tɨɨriyamama watsuari 'ari kani'enierieka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ruhiti teikɨmanayaritsie","poem":1},{"text":"mekaniutihuni tsuarikɨ mekatehayewatɨ,","poem":2},{"text":"Kurunahini kɨatsaritayaritsie","poem":1},{"text":"kukuiniya hiwariyari kaniwati'eniɨriɨkɨni,","poem":2},{"lineBreak":true},{"text":"memuka'unariekɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xekeneuyuta'unaxɨa. Kemɨ'ane mɨyɨweni ke'uyutawikweitsitɨani.","poem":1},{"text":"'Ɨtsi makumawetsie mieme xekeneyu'erieka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Awewiyatsie pemɨtiwiyakɨ meta 'apiinitɨarikatsie,","poem":1},{"text":"'ekɨtatsiere pekaniwiyariemɨkɨ.","poem":2},{"text":"'Akakaɨyari Kemuxi mɨtitewa kananutɨkiemɨkɨ xeime kwieyaritsie,","poem":1},{"text":"mara'akatemama meyunaitɨ meta memɨwaparewiekai.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ti'uname 'ukanamieni naime kiekarite ka'unake,","poem":1},{"text":"nixewitɨ kapɨtawikweni.","poem":2},{"text":"Mayeweritsie ka'ayekiepayatɨ kanayeimɨkɨ,","poem":1},{"text":"meta hɨri manaweri kanita'unariemɨkɨ,","poem":2},{"lineBreak":true},{"text":"yemekɨ Yawé kemutayɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tetetsie xeteha'utɨame xekeneutaketsa ma'eriwanikɨ Muhawi hetsiemieme,","poem":1},{"text":"karikɨ 'ari kaniuka'unarieni,","poem":2},{"text":"kiekariteya kanakumaweni,","poem":1},{"text":"nixewitɨ tɨma tewi mana puka'uyeika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"»'Axake'itɨarieka kemɨ'ane yamɨkatikayani","poem":1},{"text":"Yawé 'uximayatsikayatsie.","poem":2},{"text":"'Axake'itɨarieka kemɨ'ane","poem":1},{"text":"xuriya mɨkatayeurieni yu'ixiparakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"»Muhawi kwieyaritsie kayuwatɨ kaniumakaitɨni 'amɨtiuyukamatsietɨtɨ,","poem":1},{"text":"kaxie winuyari mɨkawatayuitɨariwa hepaɨ.","poem":2},{"text":"Hatsuaku mana kiekatari xeime kwieyaritsie mepɨkahehapaniewawe.","poem":1},{"text":"Winu hepaɨ xeime haxu tekɨxiyarita pɨkakatuariewe.","poem":2},{"text":"'Ayumieme 'aixɨa kema'ane pɨkaheuyeiwe,","poem":1},{"text":"meta yaxeikɨa 'aixɨa pu'ɨa».","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yawé mɨpaɨ kanaineni: «Peru tukari kanaye'amɨkɨ","poem":1},{"text":"kepauka teɨteri nemɨwatanɨ'ani Muhawi hetsie,","poem":2},{"text":"yutekɨxite memɨtiyeuriexɨanikɨ,","poem":1},{"text":"meta yuye'ɨrɨte memɨtitaraxɨanikɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hikɨ Muhawi kaniyutitewiyamɨkɨ yukakaɨyari Kemuxi hetsiemieme,","poem":1},{"text":"'ixaheritsixi kememɨteyutitetewiyaxɨ Weteri hetsiemieme,","poem":2},{"lineBreak":true},{"text":"tuki hetsie yemekɨ memɨtewiyakai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"»Xeme mɨpaɨ xepɨte'uyu'ɨrekai:","poem":1},{"text":"“Tame temɨtehayu'iwa tekanihɨkɨtɨni,","poem":2},{"lineBreak":true},{"text":"teɨteri kuyaxata miemekɨ temɨkamama”.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Muhawi kanika'unariemɨkɨ","poem":1},{"text":"meta kiekariteya,","poem":2},{"text":"—mɨpaɨ kanaineni Ti'aitame,","poem":1},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye mɨtitewa—:","poem":2},{"text":"Mana kiekatari temari 'aixɨa memɨ'anene","poem":1},{"text":"mekanikwi'iwakuni.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Muhawi mɨka'unarienitsie kanehuraniri,","poem":1},{"text":"'uximatɨarikaya kanaye'aximeniri.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Xekeneutitsuanani hetsiena mieme yunaitɨ 'auriena kiekatari,","poem":1},{"text":"kemɨ'ane xemimariekai kemɨtimariwekai.","poem":2},{"text":"Mɨpaɨ xekeneutiyuaneni: “'Itsɨ panumurarie","poem":1},{"text":"mɨtɨrɨkaɨyekai meta mumariwekai”.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"»'Ekɨ, Riwuni pemɨkiekame:","poem":1},{"text":"kenanakaye'a 'a'uwenitsie","poem":2},{"lineBreak":true},{"text":"kwiepa makunaraunitsie keneutayexi,","poem":2},{"text":"karikɨ Muhawi 'uname 'ekɨta kamenitamiemɨkɨ","poem":1},{"text":"'akuraru 'amatitetewa kanika'unamɨkɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"'Ekɨ 'Aruhexi kiekariyaritsie pemɨkiekame,","poem":1},{"text":"huye 'utɨa keneutakeka keneutanierixɨa,","poem":2},{"text":"memɨyu'unatɨwe keniwaruta'iwawiya, 'ukitsi meta 'ukarawetsixi:","poem":1},{"text":"“¿Kekuta muwa reyɨ?”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Muhawi tixaɨtɨ pɨkarayeitɨarie,","poem":1},{"text":"kana'iwarieni.","poem":2},{"text":"Xekeneutitsuanani meta xekeneutihiwani.","poem":1},{"text":"'Axinuni hatɨayari 'utɨa xeketeneutaxata","poem":2},{"lineBreak":true},{"text":"kename Muhawi 'uka'unarie.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"'Uximatɨarika kaninuani hɨri makuweritsie paitɨ:","poem":1},{"text":"Huruni, Yahatsa meta Mepati kiekariyaritsie,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Riwuni, Newu meta Weti-Riwɨratahini wahetsie,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Kiriyatahini, Weti-Kamuri meta Weti-Mekuni wahetsie,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Keriuti meta Wutsira wahetsie,","poem":1},{"text":"meta naime kiekarite Muhawi kwieyaritsie miemete,","poem":2},{"lineBreak":true},{"text":"hurawa meta 'ateewa mukumanekai.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Muhawi tɨrɨkariyaya kaniukumawere,","poem":1},{"text":"tɨrɨkariya pɨkahexeiyari","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"»Muhawi xekeneuhayewa matiwenikɨ tawekame hepaɨ,","poem":1},{"text":"Yawé hɨxie mariweme mayuyeitɨakɨ.","poem":2},{"text":"Yuhayaritsie ke'ukaweni,","poem":1},{"text":"'atsieriwame kehayani.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"'Ekɨ Muhawi, neteɨterima 'ixaheritsixi pepuwananaimakai,","poem":1},{"text":"pepɨwakuxatakai pewayuriyatɨ,","poem":2},{"lineBreak":true},{"text":"tenawayamete wahamatɨa pemuwarutaxeiya hepaɨ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Muhawi kwieyaritsie kiekatari,","poem":1},{"text":"yukiekaritetsie xekenayekɨni,","poem":2},{"lineBreak":true},{"text":"'aita xekeneuteni.","poem":2},{"text":"Kukuruxi wahepaɨ xekene'aneni","poem":1},{"text":"'aitekɨa memuyuti'ituatɨwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"»Tekanimaika kemɨtiuyuta'ɨre Muhawi,","poem":1},{"text":"'ɨrikakɨ panutiyeika.","poem":2},{"text":"Waɨkawa pɨtiyukatawe'erie meta puyuta'ɨre.","poem":1},{"text":"Waɨkawa payu'eriya meta mariweme payuyeitɨwa.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ne nekanimaika kemɨtiyuwaɨriya 'axa'utaitɨ,","poem":1},{"text":"peru tsepa kemɨtiyuta'ɨre tixaɨtɨ 'atsipɨkatiyurieni","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":31,"content":[{"text":"'Ayumieme neputatsuaka Muhawi hetsiemieme,","poem":1},{"text":"yunaime teɨterimama wahetsiemieme nepɨnehiwerie,","poem":2},{"lineBreak":true},{"text":"meta neputa'aiwa kiekari Kixi-Keretsi hetsiemieme.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"'Ahetsiemieme neputatsuaka Tsiwima kiekariyari, kaxie haraweriyari hepaɨ pemɨ'ane,","poem":1},{"text":"keyuri Katsexi hetsiemieme,","poem":2},{"text":"'amamate yɨrariyari haramaratsie peuka'axe","poem":1},{"text":"meta Katsexi paitɨ,","poem":2},{"text":"peru kaninuamɨkɨ ti'uname","poem":1},{"text":"'aharawerita hetsie naime katinika'unamɨkɨ.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Kwie 'aixɨa mɨtiu'anetsie Muhawi kwieyaritsie","poem":1},{"text":"kaniukumawere temawierika meta nanai.","poem":2},{"text":"Winu nepukumaweriyaxɨ memiwewiekai,","poem":1},{"text":"meta kaxie ketsinamete memutihiwakai meyutemamawietɨ mepukumawerixɨ,","poem":2},{"lineBreak":true},{"text":"hiwari hikɨ mieme temawierika hiwariyari pɨkahɨkɨri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"»Hetsuwuni 'aiwarieya kana'eniɨriɨkɨni 'Eraré meta Yahatsa paitɨ,","poem":1},{"text":"metatsiere Tsuhaxi paitɨ,","poem":2},{"lineBreak":true},{"text":"meta Kurunahini paitɨ meta 'Ekɨrati-Tseritsiya paitɨ.","poem":2},{"text":"Meta haixate Nimirini mieme","poem":1},{"text":"kaniukawaxɨani.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Teɨteri nekaniwarakumaweriyamɨkɨ Muhawi kiekatari","poem":1},{"text":"mawari memɨwawewirie kakaɨyarixi memɨte'atimawiyarɨwatsie","poem":2},{"lineBreak":true},{"text":"meta yukakaɨyarixi 'ɨkwa memɨwatairie","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"»Ne'iyari pirikɨxa muyuhiwerie hepaɨ putaine,","poem":1},{"text":"ne'iyari patsuaka Muhawi hetsiemieme,","poem":2},{"text":"pirikɨxa hiwerika mukayuitɨwani hepaɨ putaine","poem":1},{"text":"ne'iyari patsuaka Kixi-Keretsi hetsiemieme,","poem":2},{"text":"mɨrakumaweriyariekɨ","poem":1},{"text":"piiniteya ketipaɨmeme mɨtiuxeɨriekai.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Yunaitɨ mepumu'umetse","poem":1},{"text":"meta yunaitɨ mepanuyexirietɨka,","poem":2},{"text":"meta yumamatetsie naitsarie mepeuxitekietɨka,","poem":1},{"text":"metatsiere yunaitɨ hiwerika kamixayari mepanakatɨtɨka.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Naitsarie Muhawi kwieyaritsie kii heima","poem":1},{"text":"meta naitsarie kaye 'utɨma,","poem":2},{"lineBreak":true},{"text":"tsuari xeikɨa kani'enierieka,","poem":2},{"text":"Muhawi nemutataraxɨkɨ","poem":1},{"text":"tekɨxi 'axamɨ'ane mehɨiyani hepaɨ","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":39,"content":[{"text":"Kekuta tiutsanarie.","poem":1},{"text":"Neuxei mɨya mekateniutsuanani.","poem":2},{"text":"Muhawi kanawarini","poem":1},{"text":"tewiyarikakɨ.","poem":2},{"text":"'Auriena kiekatari hetsiena mieme","poem":1},{"text":"mekanimamaka meta mekaniyuriyani».","poem":2}]},{"type":"verse","number":40,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«Neuxei. Muhawi maye'unie kwixɨ hepaɨ katiniwieneni,","poem":1},{"text":"Muhawi heima kaniwieneni.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Kiekariteyatsie katinitahaxɨamɨkɨ,","poem":1},{"text":"meta kiekariteya kuraruyari 'amatitɨtɨ kana'iwarieni.","poem":2},{"text":"'Iya tukaritsie, kuyaxi Muhawi kiekatari wa'iyari","poem":1},{"text":"'uka tiniwerɨmetɨ mɨtiuyɨyɨaka hepaɨ pɨ'aneni.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Muhawi kwieyari kanikumaweriyariemɨkɨri,","poem":1},{"text":"Yawé hɨxie mariweme mayuyeitɨakɨ.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Marika, mɨki teukiya meta winiyari,","poem":1},{"text":"kaniwatakwewieka Muhawi kiekatari","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":44,"content":[{"text":"Kemɨ'ane muyuta'una marikakɨ putsuta kaneukawemɨkɨ,","poem":1},{"text":"kemɨ'aneta putsuta muwatiyani winiyaritsie kaniyɨhɨamɨkɨ,","poem":2},{"text":"karikɨ ne nekani'atɨamɨkɨ Muhawi hetsie","poem":1},{"text":"'uximatɨarika kepauka tukarieya maye'ani","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"»Kiekatari hipatɨ mekaniyuta'unani Hetsiwuni 'etɨriyayatsie paitɨ,","poem":1},{"text":"mekaniuku'uweni mekatɨrɨkawitɨ.","poem":2},{"text":"Hetsiwuni kiekariyaritsie tai payeneika,","poem":1},{"text":"Tsikuni kiekariyaritsieta, tai","poem":2},{"text":"Muhawi kanaya mɨtaxɨtsitɨanikɨ","poem":1},{"text":"meta yunaime teɨteri muwanake hipame wahamatɨa memuyukwitɨwenikɨ meta memuyuti'ɨre wamu'ute.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Xɨa'ui, Muhawi.","poem":1},{"text":"Kemuxi kiekarieya puka'unarie,","poem":2},{"text":"'aniwema temari mepanuhapanieni, meta yaxeikɨa","poem":1},{"text":"'aniwema 'ukitsi mepanuhapanieni xeime kwieyaritsie.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Peru 'arikeketa,","poem":1},{"text":"Muhawi hetsie 'aixɨa 'itɨariekame nekanayeitɨamɨkɨ»,","poem":2},"Yawé mɨpaɨ kanaineni. 'Ena kaniu'aka Muhawi kemɨtikwinitɨarieni."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}