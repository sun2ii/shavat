{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JER","translationId":"hch_wb2","name":"Keremiyaxi","commonName":"Keremiyaxi","title":"Keremiyaxi","order":24,"numberOfChapters":52,"sha256":"771a2352ddb97ef3895e81db88d089eedf1f7c4caac6b2b7f4b4d6b3602b468f","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/hch_wb2/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":49,"content":[{"type":"heading","content":["Niuki 'Amuni hetsiemieme"]},{"type":"verse","number":1,"content":["Yawé mɨpaɨ kanaineni 'amunitsixi wahetsiemieme:",{"text":"«¿Karikuta 'Ixaheri niwemama 'ukitsi mepɨka'u'uwa?","poem":1},{"text":"¿Piiniteya memɨte'anupinikɨ kari pɨkawarexeiya?","poem":2},{"text":"¿Titayari kakaɨyari Muruki Kahari kwieyari yupiini rayeitɨa,","poem":1},{"text":"meta teɨterimamata mɨkɨ kiekariteyaritsie metetitei?»","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yawé mɨpaɨ kanaineni: «Tukari kanaye'amɨkɨ,","poem":1},{"text":"kepauka ne kuyaxi nemɨwa'atɨani me'utihiwame memɨyutakwinikɨ","poem":2},{"lineBreak":true},{"text":"Xawaha kiekariyaritsie 'amunitsixi wahetsɨa,","poem":2},{"text":"kiekarieya 'unitɨ meta ka'akukiepayatɨ kanayeimɨkɨ,","poem":1},{"text":"meta kiekariteya kanititaiyariemɨkɨ.","poem":2},{"text":"Hikɨ 'Ixaheri mɨpaɨ mepɨtewanawairieni yukwie","poem":1},{"text":"meripaitɨ memunawaiyariekai","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"»Keneutatsuakani, Hetsiwuni, karikɨ 'Ahi kiekariyari muka'unariekɨ.","poem":1},{"text":"Xekeneutihiwani Xawaha niwemama 'ukari.","poem":2},{"text":"Hiwerika kamixayari xekenanakatɨtɨkani, xekeneutitsuanani,","poem":1},{"text":"kuraru 'amatitewa taɨta paitɨ xekenewanautsatɨweni,","poem":2},{"text":"Muruki kakaɨyariyari 'ateewa paitɨ kananutɨkiemɨkɨ,","poem":1},{"text":"yunaitɨ mara'akatemama meta waparewiwamete.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Ekɨ pepuyuta'ɨre 'akwie mayeweri hetsiemieme,","poem":1},{"text":"'akwie mayeweri 'aixɨa mɨtiuyuruwa hetsiemieme,","poem":2},{"text":"Neniwe 'uka pemɨnetsi'aye'unie, 'apiinitɨarika mɨraye'atɨkatsie pemɨtiwiya,","poem":1},{"text":"mɨpaɨ pemutaine: “¿Kemɨ'ane pɨnetsitamieni?”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne marika nekananunɨ'amɨkɨ 'ahetsiemieme","poem":1},{"text":"pemɨ'akuweiyanenikɨ naitsarie kwiepa","poem":2},"—Yawé Naimekɨmɨtɨrɨkaɨye mɨpaɨ kanaineni —.",{"text":"Yunaitɨ xekanitaweiyariekuni yuxexuitɨ xekanitayeixɨakuni,","poem":1},{"text":"nixewitɨ pɨkaxekuxeɨrieni xemuyuta'unaxɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"»Peru 'arikeketa,","poem":1},{"text":"'amunitsixi 'aixɨa me'itɨariekame nekaniwarayeitɨamɨkɨ»,","poem":2},"mɨpaɨ kanaineni Yawé."]},{"type":"heading","content":["Niuki 'Erumi hetsiemieme"]},{"type":"verse","number":7,"content":["Yawé mɨpaɨ kanaineni Naimekɨmɨtɨrɨkaɨye 'Erumi hetsiemieme:",{"text":"«Kaniumaweniri memɨtemaiwawe Temani kwieyaritsie.","poem":1},{"text":"Memɨtemaiwawekairi mepɨkatekuxata mete'uyemaitɨ.","poem":2},{"lineBreak":true},{"text":"¿Kamɨtsɨ kemɨtimaiwe tiutsewiximarie?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Rerani kiekatari:","poem":1},{"text":"Xekeneuyuta'una, yu'ɨtɨma xekenehu.","poem":2},{"lineBreak":true},{"text":"Terɨta meutatetewatsie xekeneuyuti'awietaxɨa.","poem":2},{"text":"'Uximatɨarika nekanipitɨamɨkɨ 'Etsahu hetsie,","poem":1},{"text":"kanaye'akari tukarieya mɨrakwinitɨarienitsie.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kaxie 'inɨwemete xɨka 'ahetsɨa me'u'axɨani,","poem":1},{"text":"tsiereta yapaɨmeme kaxie mepɨhayewa.","poem":2},{"text":"Xɨka tɨkarikɨ tenawayamete 'ahetsɨa me'u'axɨani,","poem":1},{"text":"tinaime mepɨkatehanutɨni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Peru ne naime 'Etsahu nekatininawairiemɨkɨ,","poem":1},{"text":"meta hakewa meyuti'awiwieta nekanitaxeiyamɨkɨ, muyuti'awieta pɨkayɨwe.","poem":2},{"text":"Yunaitɨ mekanikwi'iwakuni niwemama, 'iwamama meta yunaitɨ 'auriena kiekatari,","poem":1},{"text":"mekanikumaweriyariekuni meta mepɨka'u'uwaniri.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nutuite 'ahetsɨa miemete keniwaruku'eiri,","poem":1},{"text":"ne watukari nepɨ'ɨwiyani.","poem":2},{"lineBreak":true},{"text":"Meta wiuraxi nehetsie meketewiyani».","poem":2}]},{"type":"verse","number":12,"content":["Yawé mɨpaɨ kanaineni: «Kemɨ'ane wahetsie mɨkarahɨiwa mɨtiukwinitɨarienikɨ tekɨxiyari memanu'i, 'ekɨ matsi 'ahetsie mɨrahɨiwa pepɨkahayewarieni pekatikwinitɨarietɨ. Kaneuyeweka pemɨtikwinitɨarieni, matsita 'ekɨ mɨkɨ tekɨxi pekananu'imɨkɨ»."]},{"type":"verse","number":13,"content":["Yawé mɨpaɨ kanaineni: «Ne nekɨmana mɨpaɨ nekatininehɨritɨaka, Wutsira 'axa'itɨaritɨ kanayeimɨkɨ, teɨteri mekanitimamakuni, tewiyarika kanipitɨariemɨkɨ meta kanakumaweriyariemɨkɨ. Yuheyemekɨ naitɨ kiekariteya 'u'unitɨ kaniyuhayewamɨkɨ»."]},{"type":"verse","number":14,"content":[{"text":"Yawé niukieya nepu'eni.","poem":1},{"text":"Xewitɨ tixaxatame nuiwarite mɨpaɨ pɨtiwakɨhɨawe:","poem":2},{"text":"«Xekeneuyukuxeɨrieka, 'Erumi kiekariyari xekeneutami'a.","poem":1},{"text":"Xekeneuyukuha'aritɨa xemitamienikɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«Kiekari nitixaɨtɨkɨ mɨkatiyunaki'erie nepɨmatsi'ayeitɨani,","poem":1},{"text":"yunaitɨ teɨteri mepɨmatsixani'erieka.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"'Ekɨ 'aita mukatataritsie pemɨkiekame,","poem":1},{"text":"meta hɨri 'amanutitɨtɨtsie:","poem":2},{"text":"pepɨ'akwamanaxɨ hipame pewamariutatɨ","poem":1},{"text":"meta 'a'iyari 'uyuta'ɨrekaku.","poem":2},{"text":"Tsepa 'ateewa paitɨ pemɨyuti'itɨatɨa kwixɨ hepaɨ,","poem":1},{"text":"mana paitɨ nemenanakahɨamɨkɨ","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":17,"content":[{"text":"'Erumi, 'umariwekaremekɨ pekanika'unariemɨkɨ,","poem":1},{"text":"xewitɨ mɨkɨ kiekari 'aurie xɨka 'uyeyani,","poem":2},{"lineBreak":true},{"text":"kanitimamɨkɨ kiekari 'unime xeiyatɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tsuruma, Kumuxa meta kiekarite 'auriena mamanetɨka","poem":1},{"text":"kememɨte'uka'unarie mɨpaɨ pɨtiyɨni,","poem":2},{"text":"nixewitɨ tawari mana","poem":1},{"text":"tewi pɨkayutakitɨani","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"»Kurutani mɨ'ɨtsiyata maye mayeneika","poem":1},{"text":"makutsiɨraɨye 'ɨxapa yapauka mɨ'axe hepaɨ,","poem":2},{"text":"yapauka neniwatimariutamɨkɨ 'erumitsixi,","poem":1},{"text":"wahetsiemieme xeime nekananayexeiyamɨkɨ.","poem":2},{"text":"Tawari Kakaɨyari pumawe nehepaɨ 'anetɨ.","poem":1},{"text":"Xewitɨ mɨnetsita'iwa pɨkayɨwe.","poem":2},{"lineBreak":true},{"text":"Nixewitɨ muxatsi wahɨweme netsi 'aye'unietɨ pɨka'ayeiwe».","poem":2}]},{"type":"verse","number":20,"content":[{"text":"'Ayumieme, xekeneu'eni Yawé kemɨtiyurienikɨ yatikuxatatɨ:","poem":1},{"text":"'Erumi hetsiemieme,","poem":2},{"text":"xekeneu'eni kemɨtiyurieni","poem":1},{"text":"Temani kiekatari wahetsiemieme:","poem":2},{"text":"Waniwema 'etsimemɨtɨtɨ mekananuhapaniekuni","poem":1},{"text":"muxatsi tɨɨrixi wahepaɨ,","poem":2},{"text":"'ayumieme makɨ'ɨxaya wahetsie mumiemetɨkai","poem":1},{"text":"'akumawetɨ kanayeimɨkɨ kaniti'unariemɨkɨ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kwie kaniutayuani","poem":1},{"text":"'Erumi matihɨiyatsie,","poem":2},{"text":"Haramara Mɨxeta hetsie paitɨ","poem":1},{"text":"kanewa'eiyani wahiwari.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mɨrayuye'unie kananutiyani mɨtawienikɨ","poem":1},{"text":"mexɨiwa kaniyutamiemɨkɨ kwixɨ hepaɨ,","poem":2},{"lineBreak":true},{"text":"Wutsira kiekariyaritsie yu'anate kanitaweraxɨamɨkɨ.","poem":2},{"text":"'Iya tukaritsie 'Erumi kiekatari kuyaxi kwinimieme memɨte'ayu'iwa meteniuka'eniwakuni,","poem":1},{"text":"'uka tiniwerɨmetɨ mɨtiuka'eniwa hepaɨ.","poem":2}]},{"type":"heading","content":["Niuki Ramatsiku hetsiemieme"]},{"type":"verse","number":23,"content":["Niuki Ramatsiku hepaɨtsita mieme:",{"text":"«Kamati meta 'Axipari kiekatari waɨkawa mekanimamaka,","poem":1},{"text":"memɨte'utamarikɨri 'axakemɨtiyɨni hepaɨtsita.","poem":2},{"text":"Waɨkawamekɨ mekani'iyarixietɨkani,","poem":1},{"text":"memɨyunɨtɨani mepɨkayɨwawe hamewari kemɨtiuyuane hepaɨ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ramatsiku kiekatari mepɨkayumaiwawe,","poem":1},{"text":"mepuyuta'unakekai, peru marikakɨ mepɨka'uyɨwekaxɨa.","poem":2},{"text":"Hiwerikakɨ meta kukuiniyakɨ mepɨkayɨwawe memayekɨne,","poem":1},{"text":"'ukarawetsixi matɨari memɨtiniwexɨaximeni wahepaɨ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ramatsiku kiekariyari yunaitɨ 'aixɨa memutiyuane 'ahepaɨtsita meta pemɨnetsitemawieritɨa.","poem":1},{"text":"¿Ketitayari 'ateɨterima mekameteku'eiriwawe?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"'Iya tukaritsie temari","poem":1},{"text":"kiekaritsie kaye 'utɨma mekaniuheitɨkaikuni,","poem":2},{"lineBreak":true},{"text":"kuyaximama yunaitɨ mekanikwi'iwakuni","poem":2},"—mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye—."]},{"type":"verse","number":27,"content":[{"text":"Ramatsiku kuraruyari nekanitaiyamɨkɨ,","poem":1},{"text":"meta mɨkɨ Weni-'Arari paratsiyuteya kanitixɨtsitɨamɨkɨ».","poem":2}]},{"type":"heading","content":["Niuki Tseraxi meta Katsuxi wahetsiemieme"]},{"type":"verse","number":28,"content":["Yawé mɨpaɨ kanaineni Tseraxi hetsiemieme meta Katsuxi mɨtiwa'aitɨa wahetsiemieme, Nawukurunutsuxi Wawiruniyatsie ti'aitame muwarutakwikai:",{"text":"«Xekeneuhuni, Tseraxi xekeneutami'a.","poem":1},{"text":"Xekeniwarutayuniya mɨkɨ teɨteri tau manatineika hepa kiekatari.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Wa'ixuriki kiiyarite meta watewama mepɨtenawaiyarieni,","poem":1},{"text":"wanawi 'ɨkariyarite, tinaime wapiinite meta wakameyutsixi.","poem":2},{"text":"Teɨteri mɨpaɨ metenixehiwiekuni:","poem":1},{"text":"“Naitsarie marika puxuawe”.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"»Xekeneuyuta'unaxɨa, Katsuxi kiekatari.","poem":1},{"lineBreak":true},{"text":"'Ari xekeneuyuta'unaxɨa, xekeneuyuti'awieta","poem":1},{"text":"kwieta 'ameukateewata","poem":2},"—Yawé mɨpaɨ kanaineni—.",{"text":"Nawukurunutsuxi, Wawiruniyatsie ti'aitame,","poem":1},{"text":"katinikuxatani xehetsiemieme kemɨxeyurieni,","poem":2},{"lineBreak":true},{"text":"kanitaxewiriyari xehetsiemieme kemɨtiyurieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"»Xekenehu, xekeneutami'a mɨkɨ kiekari kayuwatɨ mɨtima","poem":1},{"text":"tixaɨtɨ 'atsikatiyuriweme muyu'erie,","poem":2},{"text":"kiekari mɨkareka'itupari meta kɨyexi meuku'uwe mɨkahexeiya,","poem":1},{"text":"meta yuxaɨtame 'ateewapaitɨ mukuma","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":32,"content":[{"text":"Wakameyutsixima xepiinite pɨrayani,","poem":1},{"text":"meta wawakaitsixima memɨyumɨire xekaniwanawairiekuni,","poem":2},{"text":"Naitsarie kwiepa nekaniwataxɨriexɨamɨkɨ","poem":1},{"text":"mɨkɨ teɨteri yumu'utsie naime memuyukaxika,","poem":2},{"lineBreak":true},{"text":"tsepa hakewa meme'uwani mepe'uximatɨarieka","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":33,"content":[{"text":"Katsuxi yawixi memayu'eririya wakie kanayeimɨkɨ,","poem":1},{"text":"kakiepatɨri kanayeimɨkɨ yuheyemekɨ.","poem":2},{"text":"Nixewitɨ tewi mana pɨkatayerɨni,","poem":1},{"text":"xewitɨtɨma mana kietɨ pɨka'ayani».","poem":2}]},{"type":"heading","content":["Niuki 'Erami hetsiemieme"]},{"type":"verse","number":34,"content":["Yawé kemutayɨ 'Erami hepaɨtsita mieme, yuniukame Keremiyaxi pɨtiutaxatɨa mɨtitaxatakɨ mexɨakame wiyaritsie Tserekiyaxi ti'aitakaku Kura kwieyaritsie."]},{"type":"line_break"},{"type":"verse","number":35,"content":["Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye:",{"text":"«'Erami tupieya nekanitamuramɨkɨ,","poem":1},{"text":"tita hetsie mɨtiyutɨrɨkariyakai nekanikumaweriyamɨkɨ.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"'Erami kwieyari hetsie kuyaxi naitsarie kiekatari nekaniwa'atɨamɨkɨ","poem":1},{"text":"naitsarie kiekatari nekaniwarawitɨxɨamɨkɨ.","poem":2},{"text":"Naitsarie kiekatari wahetsɨa nekaniwataxɨriexɨamɨkɨ,","poem":1},{"text":"naitsarie kwiepa kemakuyewa","poem":2},{"lineBreak":true},{"text":"mekananuhapaniexɨakuni yayupapaɨmetɨ.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"'Erami kiekatari marika nepɨwapitɨani memɨwaraye'unie wahɨxie,","poem":1},{"text":"memɨwakwiku wahɨxie,","poem":2},{"text":"ne nekaniha'aka wahetsiemieme,","poem":1},{"text":"wahetsie 'uximatɨarika nekani'atɨamɨkɨ","poem":2},"—Yawé mɨpaɨ kanaineni—.",{"text":"Memɨwaraye'unie mepɨwaranukuweiya","poem":1},{"text":"yunaime mewakwimeke mepɨtehayewa.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Ne'uweni 'Erami nepɨtakeni,","poem":1},{"text":"meta ti'aitame mana kiekame nekanika'unamɨkɨ meta 'iparewiwametemama","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"»Peru 'arikeketa","poem":1},{"text":"'Erami 'aixɨa 'itɨariekame nekanayeitɨamɨkɨ»,","poem":2},"Yawé mɨpaɨ kanaineni."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JER/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JER/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JER/48.json","previousChapterAudioLinks":{},"numberOfVerses":39}