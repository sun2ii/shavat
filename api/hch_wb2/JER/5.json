{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JER","translationId":"hch_wb2","name":"Keremiyaxi","commonName":"Keremiyaxi","title":"Keremiyaxi","order":24,"numberOfChapters":52,"sha256":"771a2352ddb97ef3895e81db88d089eedf1f7c4caac6b2b7f4b4d6b3602b468f","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/hch_wb2/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":5,"content":[{"type":"heading","content":["Kerutsareme meta Kura ke'axamemɨteyuriekai"]},{"type":"verse","number":1,"content":[{"text":"«Kerutsareme kayeyaritetsie xekeneutikɨni,","poem":1},{"text":"'anɨkai xekunieretɨwetɨ,","poem":2},{"lineBreak":true},{"text":"teɨteri memayukuxexeɨriwatsie xekeneutinieri.","poem":2},{"text":"Xɨka xeime xehetaxeiya","poem":1},{"text":"heitseriemekɨ yatiyurieneme, tita yuri mɨraine tikuwauneme,","poem":2},{"lineBreak":true},{"text":"ne nepɨreiyehɨwirieni 'ikɨ kiekari.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tsepa mɨpaɨ memɨteyuhɨritɨa: “Yurikɨ Yawé mayeyurikɨ”,","poem":1},{"text":"yakɨ xeikɨa mekateniyuhɨritɨaka».","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yawé, 'ekɨ pepɨtikuwaune 'ateɨterima yamemɨtekahunikɨ.","poem":1},{"text":"Pepɨtiwarukwinitɨa mɨkɨ teɨteri, matsi pɨkawarekwinixɨ,","poem":2},{"lineBreak":true},{"text":"pepɨwarutayuniyaxɨ, matsi mepɨka'uyuwaɨri 'aixɨa memuyuyurienikɨ.","poem":2},{"text":"Yunierika meputseiriyaxɨ 'ai hepaɨ,","poem":1},{"text":"mepɨka'uyuwaɨri memɨtehayewakɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hikɨ mɨpaɨ nepɨtiu'eri: «Mɨpaɨ pɨ'ane hawerimɨ'ane,","poem":1},{"text":"memɨka'u'iyarini wahepaɨ mepɨte'u'uwa,","poem":2},{"text":"memɨka'imatekɨ Yawé huyeya","poem":1},{"text":"meta yukakaɨyari 'aitsikateya.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Memanuyetei wahetsɨa nepumie","poem":1},{"text":"hikɨ nepɨtiwaretaxatɨani,","poem":2},{"text":"mɨkɨ hɨrixɨa mepimate Yawé huyeya","poem":1},{"text":"meta kemɨti'aita wakakaɨyari».","poem":2},{"text":"Peru mɨkɨta yuyuku mepanumuraxɨ","poem":1},{"text":"meta kaunari kɨmana memɨhɨatɨkatei xekananutekixɨani.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Ayumieme maye yeutanaka pɨtiwakwinitɨani","poem":1},{"text":"meta puwatikwani 'ɨrawe makumawetsie kiekame,","poem":2},{"text":"wakiekarite hɨxie tɨwe puhupa wahupietɨ,","poem":1},{"text":"kemɨ'ane muwayeyani pɨtatsanarieni,","poem":2},{"text":"waɨkawa 'axamemɨte'uyurikɨ","poem":1},{"text":"meta mɨiremekɨ yamemɨkatekakɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«¿Titayari nemereuyehɨwirieka?","poem":1},{"text":"'Aniwema mepɨnetsi'uku'eiri,","poem":2},{"lineBreak":true},{"text":"memɨkakakaɨyarixi wahetsɨa mepɨteyuhɨritɨa.","poem":2},{"text":"Kepauka nemɨtiwakupiniriekai tita memɨteheuyehɨakai,","poem":1},{"text":"mɨkɨ memɨkayɨ'ɨitama mepɨwarukumayɨa","poem":2},{"lineBreak":true},{"text":"'ukarawetsixi yuwaɨkawatɨ memɨwakumaɨwa wakiita mepuyukuxexeɨriwakai.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kawayutsixi 'aixɨa memɨtemikie meta waɨkawa memɨtɨrɨkawi wahepaɨ mepɨ'anene,","poem":1},{"text":"yunaitɨ 'ukarawetsixi memɨkawa'ɨitama wahekɨ mekaniutitsuanani».","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yawé mɨpaɨ kanaineni:","poem":1},{"text":"«¿Kareuyewetse mɨkɨkɨ nemɨtiwakwinitɨani?","poem":2},{"text":"¿Kareuyewetse mɨkɨ nuiwari mɨya memɨte'u'iyari nemɨtiwarakapitɨanikɨ mɨkɨ kememɨnetsi'uyuri?","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"»Xuruku 'utɨa xekeneutayeixɨa 'ikɨ kaxie mayematsie,","poem":1},{"text":"xekenayehuna, peru hipame xekeneuhayewa.","poem":2},{"text":"Xekenamuraxɨa yɨrariyarite,","poem":1},{"text":"karikɨ mɨkɨ Yawé hetsɨa pɨkamiemete.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Teɨteri 'Ixaheri hetsiemiemete meta Kura","poem":1},{"lineBreak":true},{"text":"kwinimieme yemekɨ yamepɨkatehu»,","poem":1},"Yawé mɨpaɨ kanaineni."]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mɨkɨ Yawé hepaɨtsita mekateniu'itani,","poem":1},{"text":"mɨpaɨ paitɨ matsi mekaniutiyuaneni: «Kakaɨyari pɨka'uyeika.","poem":2},{"text":"Tahetsie 'axati'anetɨ pɨkatinuani,","poem":1},{"text":"kuyaxa tahetsie pɨkanuani meta haakaxa».","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kakaɨyari niukametemama 'eka hepaɨ mepɨ'anene:","poem":1},{"text":"Yawé niukieya wahetsie pumawe.","poem":2},{"text":"Mɨpaɨ ketiwaruyurieni kememutiyuane.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"'Ayumieme, Yawé mɨpaɨ paine,","poem":1},{"text":"Kakaɨyari Naimekɨmɨtɨrɨkaɨye:","poem":2},{"text":"«Mɨpaɨ memutiyuanekɨ teɨteri,","poem":1},{"text":"neniuki 'atenie tai hepaɨ kani'anemɨkɨ,","poem":2},{"text":"meta 'ikɨ teɨteri, kɨyexi kwinimieme netɨ muwe hepaɨ.","poem":1},{"text":"Mɨkɨ tai kaniwatixɨtsitɨamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"»Teɨteri 'ixaheritsixi,","poem":1},{"text":"xehetsɨa neni'atɨamɨkɨ xeime nuiwari teewatanaka,","poem":2},{"text":"xeime nuiwari mɨtɨrɨkaɨye meta meripaitɨ mɨmieme,","poem":1},{"text":"xeime nuiwari waniuki xemɨkamate,","poem":2},{"text":"waniuki xemɨka'enie","poem":1},"—Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":16,"content":[{"text":"Mɨkɨ yunaitɨ kuyaxi mepɨka'ukamama,","poem":1},{"text":"wa'ɨrɨ mɨki peutiwie.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tita pemɨti'etsa meta 'a'ikwai naime mepɨtekaxɨni,","poem":1},{"text":"'aniwema 'ukitsi meta 'ukari yunaime mepɨwakwini,","poem":2},{"text":"'amuxatsi meta 'awakaitsixi mepɨwakwini,","poem":1},{"text":"'akaxie meta piní mepɨkaxɨni.","poem":2},{"text":"'Akiekarite kuraruyari 'amatitetewa,","poem":1},{"text":"wahetsie pemeuwaɨrekai,","poem":2},{"lineBreak":true},{"text":"naitɨ pɨka'unarieni».","poem":2}]},{"type":"verse","number":18,"content":["Yawé mɨpaɨ kanaineni: «Peru mɨkɨ tukaritsie, 'akuxi yunaime nepɨkaxeka'una."]},{"type":"verse","number":19,"content":["Kepauka mɨpaɨ pemɨtita'iwawiyarieni: “¿Titayari Yawé takakaɨyari mɨya tatiuyuri?”, 'ekɨ mɨpaɨ pekatiniwata'eiyamɨkɨ: “Xeme kexemɨnete'uku'eiri meta yukwietsietɨtɨ hipame kakaɨyarixi xemuwarayexeiyakaikɨ, mɨpaɨta xeime kwieyaritsie hipame teɨteri xepɨtewarayexeiyani”."]},{"type":"verse","number":20,"content":[{"text":"»'Ikɨ Kakuwu xiɨyarimama xeketeniwarutaxatɨa","poem":1},{"text":"meta yaxeikɨa Kura kwieyaritsie:","poem":2}]},{"type":"verse","number":21,"content":[{"text":"'Ikɨ ketineu'eni, kiekari pemɨka'uka'iyari meta pemɨka'awaɨriya yapemɨtikamienikɨ,","poem":1},{"text":"hɨxi pehexeiyatɨ peru pemɨkaheuniere,","poem":2},{"lineBreak":true},{"text":"naka pehexeiyatɨ peru pemɨkaheu'ena».","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yawé mɨpaɨ kanaineni:","poem":1},{"text":"«¿Kamɨtsɨ petiuhayewaxɨ penetsi'ayemakatɨ?","poem":2},{"text":"¿Kareuyewetse pemɨnetsi'ayemakaka?","poem":1},{"lineBreak":true},{"text":"Ne xiekari 'anekanitiyeni haramara mata'atɨka 'inɨarieya mɨhɨkɨtɨnikɨ,","poem":1},{"text":"mana muye'atɨyeikanikɨ yuheyemekɨ.","poem":2},{"text":"Tsepa hamewari mana mɨreutiwaya,","poem":1},{"text":"mana pɨka'anutitsuna,","poem":2},{"text":"tsepa kwinimieme mutaine,","poem":1},{"text":"mɨkɨ 'inɨari heima pɨka'anutiyani.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Peru 'ikɨ teɨteri 'iyari tse'ime mepexeiya kaheu'ename,","poem":1},{"text":"mepɨnetsi'uku'eiri, 'axamete'u'iyaritɨ mepakɨ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mepɨkayu'iyaritɨa tɨma meta mɨpaɨ mepɨka'utiyuane:","poem":1},{"text":"“Yawé tepayemakaxeni, takakaɨyari,","poem":2},{"text":"wiyeri meyenɨ'awa tukarieya 'aye'axekaku,","poem":1},{"text":"wiyeri witaritari mieme meta taxarita mieme,","poem":2},{"text":"meta tsemana temɨ'inɨatatsie pɨtatsi'inɨaritɨa","poem":1},{"text":"mɨkɨ tsemanayaritsie temɨka'itsanakɨ”.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ke'axaxemɨte'uyuri xeme","poem":1},{"text":"naime 'ikɨ pɨtixe'unawairi,","poem":2},{"text":"'axamɨti'ane xemɨtehexeiya pɨxekunamirie","poem":1},{"text":"ke'aixɨa xemɨ'itɨariekakeyu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kanahekɨaka nekiekaritsie mekanixuaweni 'axamemɨte'u'iyari,","poem":1},{"text":"mehupatɨ xeikɨa wikixi wahupiwamete wahepaɨ,","poem":2},{"lineBreak":true},{"text":"winiyari memuwɨwɨtɨwa teɨteri memɨwawiniyakɨ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Wikixi wakiite hepaɨ waɨkawa mehɨpɨnetɨ,","poem":1},{"text":"wakiite 'irɨmarikɨ xeikɨa pɨtihɨpɨne,","poem":2},{"text":"'ayumieme kwinie metehexeiyatɨ mepayuyeitɨa meta mamariwawemete mepakɨ,","poem":1}]},{"type":"verse","number":28,"content":[{"text":"kwinimieme metewaiyatɨkaitɨ meta meyuti'ɨretɨ.","poem":2},{"text":"Ke'axamemɨteyurie hawaikɨ pɨkaheu'axe:","poem":1},{"lineBreak":true},{"text":"nutui hetsiemieme 'aixɨa mepɨkate'akayuruwa,","poem":1},{"text":"'aixɨa 'anemekɨ 'amuyeikanikɨ,","poem":2},{"text":"metatsiere tixaɨtɨ memɨkateheuxeiya","poem":1},{"text":"heitserie kememɨtehexeiyakɨ yamepɨkateyurie».","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Mɨpaɨ kanaineni Yawé:","poem":1},{"text":"«¿Kareuyewetse mɨkɨkɨ nemɨtiwakwinitɨani?","poem":2},{"text":"¿Kareuyewetse mɨkɨ nuiwari mɨya memɨte'u'iyari","poem":1},{"text":"neta nemɨtiwarakapitɨanikɨ mɨkɨ kememɨnetsi'uyuri?","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"»Yemekɨ mariwemekɨ meta mariutsika","poem":1},{"text":"pɨtiutine 'ikɨ kwieyaritsie.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kakaɨyari niukametemama 'itarikakɨ mepɨtekuxata,","poem":1},{"text":"mawari wewiwamete mepɨte'aita kemɨtiwanake,","poem":2},{"lineBreak":true},{"text":"meta neteɨterima mɨpaɨ pɨtiwanake.","poem":2},{"text":"Peru, ¿Kexeteyurieni xeme","poem":1},{"text":"kepauka naitɨ mɨtinɨretsie?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JER/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JER/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JER/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}