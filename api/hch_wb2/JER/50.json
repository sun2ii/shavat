{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JER","translationId":"hch_wb2","name":"Keremiyaxi","commonName":"Keremiyaxi","title":"Keremiyaxi","order":24,"numberOfChapters":52,"sha256":"771a2352ddb97ef3895e81db88d089eedf1f7c4caac6b2b7f4b4d6b3602b468f","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/hch_wb2/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":50,"content":[{"type":"heading","content":["Niuki Wawiruniya hetsiemieme"]},{"type":"verse","number":1,"content":["Yawé yuniukame Keremiyaxi kemɨtiutaxatɨa wawiruniyutsixi wahepaɨtsita meta wakwieyari hepaɨtsita mieme:"]},{"type":"verse","number":2,"content":[{"text":"«Xeketeniwarutaxatɨa yunaime nuiwarite kwiepa memɨtama.","poem":1},{"text":"Xekeneutihiwani xe'ikuxatatɨ, patera xe'anuwietɨ.","poem":2},{"text":"Tixaɨtɨ xepɨkate'anukanaka, matsi mɨpaɨ xekeneutiyuaneni:","poem":1},{"text":"“Wawiruniya kana'iwarieni.","poem":2},{"text":"Weri kaniyutitewiyamɨkɨ.","poem":1},{"text":"Maxiruki kanitimurariexɨamɨkɨ 'etsipepetɨ.","poem":2},{"text":"Kakaɨyarixi memɨwewiyatɨka meta wa'ɨkiyarite","poem":1},{"text":"mekaniutimurarieni tixaɨtɨ mepɨkatehayeitɨarie”.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Xewitɨ nuiwari mimienekɨ tayeta mieme,","poem":1},{"text":"'akumaweme mayeitɨanikɨ kwieya.","poem":2},{"text":"Teɨteri meta tewaxi mekanayekɨnikuni meyu'unarɨmetɨ,","poem":1},{"text":"xewitɨtɨma mana kapɨtayerɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"»'Iya tukaritsie, 'iya wiyaritsie","poem":1},{"text":"'ixaheritsixi meta Kura teɨteriyari","poem":2},{"lineBreak":true},{"text":"mekaniyehuni me'utitsuatɨ Yawé mekuwautɨwetɨ, yukakaɨyari","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":5,"content":[{"text":"Mekanita'iwaukuni Tsiyuni huyeyari kemɨreuyune,","poem":1},{"text":"hikɨ mɨkɨ huye 'utɨa mekaniyehuni.","poem":2},{"text":"Me'axɨame Yawé hetsie yemekɨ mekateniwiyakuni","poem":1},{"text":"tɨratu mekaniwewikuni yuheyemekɨ, hatsuakuri memɨkahetɨmaiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"»Neteɨterima muxatsi xeikuraruyari memeuyexɨri hepaɨ mepɨ'ane,","poem":1},{"text":"wahɨwemete mepɨwarutayutsitɨa,","poem":2},{"lineBreak":true},{"text":"hɨritsie yuxaɨta me'u'uwame mepɨwarayeitɨa.","poem":2},{"text":"Xeime hɨriyaritsie me'u'uwatɨ xeime hɨriyaritsieta mepekɨka,","poem":1},{"text":"yukuraru mehatɨmaiyaka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kemɨ'ane memɨwarukaxexeiya, mepɨwatikwa'a,","poem":1},{"text":"memɨwaraye'unie mɨpaɨ meputiyuane: “Tame tahetsie pɨkarahɨiwa,","poem":2},{"text":"mɨkɨ pɨta Yawé hepaɨtsita 'axamepɨte'uyuri,","poem":1},{"text":"wakuraru mɨheitserie kanihɨkɨtɨni,","poem":2},{"lineBreak":true},{"text":"meripaitɨ xetutsima memitakwewiekai”.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"»Xekeneuyuta'una Wawiruniya xe'u'uwatɨ,","poem":1},{"text":"mɨkɨ kwieyari xekeneuku'eiri.","poem":2},{"text":"Tsipuri 'ukitsi xekenehɨkɨtɨni","poem":1},{"text":"muxatsi memɨwaruwitɨxime.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Karikɨ ne Wawiruniya hepaɨtsita nekaniwaha'aritɨaka","poem":1},{"text":"yumɨireme teɨteri tayeta miemete memuyutaxewirekɨ.","poem":2},{"text":"Mekaniyukuha'aritɨakuni memitamienikɨ,","poem":1},{"text":"tayeta kiekatari mekanika'unakuni.","poem":2},{"text":"'Ɨrɨkɨ kwinimieme mepɨteheutamɨiwawe","poem":1},{"text":"yu'iwarika mete'apitɨ mepakununuwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wawiruniya naime katininawatsiyariemɨkɨ,","poem":1},{"text":"kemɨ'ane memɨte'inawatsirieni mekanitihuxaikuni","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"»Xeme, neteɨterima xemɨtewarunawatsiri,","poem":1},{"text":"xekeneyutemamawieka xekeneutinaweni.","poem":2},{"text":"Tsikerutsixi wahepaɨ xekenetsunatɨweni tupiriya tsata,","poem":1},{"text":"kawayutsixi wahepaɨ xekeneutiyuaneni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Peru xekwieyari","poem":1},{"text":"tixaɨtɨ pɨkarayeitɨarieni,","poem":2},{"lineBreak":true},{"text":"kemɨ'ane tukari mɨxe'upitɨa tewiyarika kanipitɨariemɨkɨ.","poem":2},{"text":"Wawiruniya 'imatɨreme kanayeimɨkɨ,","poem":1},{"text":"makuwaki, makumawe meta maku'ayepariya kanayeimɨkɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yawé hetsiena mieme muyeha'akɨ","poem":1},{"text":"kiepa mana pɨka'ayaniri,","poem":2},{"lineBreak":true},{"text":"matsi yeuta mana kanayeimɨkɨ.","poem":2},{"text":"Kemɨ'ane Wawiruniya 'aurie muyeyani","poem":1},{"text":"kanitimamɨkɨ nieretɨ kemu'itɨariekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"»Wawiruniya warita xekenaketɨkɨni,","poem":1},{"text":"yunaitɨ tupikɨ temɨmɨmete.","poem":2},{"text":"Xekeneutamɨ'i, naime yu'ɨrɨkɨ,","poem":1},{"text":"Yawé hepaɨtsita 'axakatiniuyurieni.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Waritana xekenaketɨkɨneka xekeneutihiwa, mɨpaɨ xe'utiyuatɨ:","poem":1},{"text":"Wawiruniya puyuyetuari.","poem":2},{"text":"Tuxiyuya patixɨri,","poem":1},{"text":"kuraruya pa'unetɨya.","poem":2},{"text":"Hikɨri Yawé katinekapitɨamɨkɨ.","poem":1},{"text":"Xemeta meripaitɨ kemɨxe'uyuri,","poem":2},{"lineBreak":true},{"text":"yaxeikɨata xeme xekeneuyuri.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wawiruniya kwieyaritsie memuka'etsa yunaime xekeniwarukuya,","poem":1},{"text":"meta memɨ'itsanatɨwe.","poem":2},{"text":"'Ixiparakɨ memɨtakwikwiwakɨ 'ayumieme,","poem":1},{"text":"yuxexuitɨ yukiekaritsie mepɨtakɨka,","poem":2},{"lineBreak":true},{"text":"meta yukwieyaritsie mepuyuta'una.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"»'Ixaheritsixi muxatsi xaɨtsie memeukuyunixɨa mepɨhɨkɨ,","poem":1},{"text":"mayetsi mekaniwareutaxɨriexɨani.","poem":2},{"text":"Matɨari 'Atsiriyatsie ti'aitame kaniwarutikwani,","poem":1},{"text":"hutarieka Nawukurunutsuxi, Wawiruniyatsie ti'aitame,","poem":2},{"lineBreak":true},{"text":"naime 'umeteya peutimuraxɨa».","poem":2}]},{"type":"verse","number":18,"content":["'Ayumieme mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye, 'Ixaheri Kakaɨyarieya:",{"text":"«Wawiruniyatsie ti'aitame nekatinikwinitɨamɨkɨ metatsiere kwieya","poem":1},{"text":"'Atsiriya kwieyaritsie ti'aitame kenemɨtiukwinitɨa hepaɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yanepɨtiyurieni 'ixaheritsixi memakunuaxɨanikɨ makɨ'ɨxayatsie","poem":1},{"text":"Kaximeru hɨriyaritsie meta Watsani kwieyaritsie memɨtekwatɨwenikɨ.","poem":2},{"text":"Kememɨteheukwaikukai mepɨtihuxani","poem":1},{"text":"'Epɨrahini meta Karaha hɨriyaritetsie.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"'Iya tukaritsie 'Ixaheri ke'axamɨtiuyuri pɨtiwawiyarieni,","poem":1},{"text":"peru pɨkakaxeiriyarieni.","poem":2},{"text":"'Iya tukaritsie Kura hetsie 'axamɨti'ane pɨtiwawieni,","poem":1},{"text":"peru hetsiena pɨkakaxeiyarieni,","poem":2},{"lineBreak":true},{"text":"karikɨ ne nekatiniwareuyehɨwiriemɨkɨ kemɨ'ane memuyuhayewa","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"»Xekeneutami'a Meratahini kwieyari","poem":1},{"text":"meta Pekuri memɨkiekatari.","poem":2},{"text":"Xekeniwarukuya, xekeniwaruka'una yunaime.","poem":1},{"text":"Xeketenaye'atɨa naime kenemɨti'aita","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":22,"content":[{"text":"Mɨkɨ kwieyaritsie kuyaxa yuariyaya payu'eniɨriɨkɨ","poem":1},{"text":"yemekɨ mariwemekɨ mepekumaweriyarɨwa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ketiumurarie meta keratihɨiya tepɨa titsuname","poem":1},{"text":"kwiepa memɨtama yunaime muwatitsunakai.","poem":2},{"text":"Wawiruniya makumawe kanayani","poem":1},{"text":"yunaime nuiwarite wahixɨapa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Winiyari nekaniuwieni 'ahetsiemieme,","poem":1},{"text":"hikɨ mɨkɨtsie pekaniuwiere ni'atsipekatimaitɨ.","poem":2},{"text":"Pepɨkatiumaritɨarie yapauka pepuwiyarie,","poem":1},{"text":"Yawé pe'aye'unietɨ pematɨakɨ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yawé katineuyepieniri piinite kuyaxa timieme mɨtiuyepinetsie,","poem":1},{"text":"katinewayepini muyutamienikɨ yuhaxɨa maye'atɨanikɨ,","poem":2},{"text":"Yawé naimekɨmɨyɨwe, meta Naimekɨmɨtɨrɨkaɨye,","poem":1},{"text":"mɨkɨ yu'uximayatsika pexeiya 'eye'atɨanike","poem":2},{"lineBreak":true},{"text":"wawiruniyutsixi wakwieyaritsie.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Xekeneutami'a naitsarie kwiepa xemutetɨka.","poem":1},{"text":"Wa'iku muye'ɨnetɨkatsie xeketeneuyepiexɨa.","poem":2},{"text":"Xekeneukuxeɨri 'iku kwauyari hepaɨ,","poem":1},{"text":"xekeniwarukuya yunaime.","poem":2},{"lineBreak":true},{"text":"Xewitɨ tɨma pɨkayukuhayeikawani.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Watsikerutsixi yunaime xekeniwarukuya.","poem":1},{"text":"Hakewa memetikwikwiwa mana xekeniwaranuhapani.","poem":2},{"text":"Xɨa'ui nepaine wahetsiemieme, watukari maye'akɨ,","poem":1},{"text":"kepauka memɨtekwinitɨarienitsie.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Yu'unamete wahiwari pa'eniuriukɨ,","poem":1},{"text":"Wawiruniyatsie memayuye'unaxɨa,","poem":2},{"text":"Tsiyuni mekatenikuxatatɨweni","poem":1},{"text":"Yawé kemɨtiwarakapitɨa, takakaɨyari,","poem":2},{"lineBreak":true},{"text":"tukieya memuka'unaxɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"»Tupikɨ temɨmɨmete xekeniwarukuxeɨri Wawiruniya memɨtamienikɨ,","poem":1},{"text":"yunaime kemɨ'ane memɨteheutamɨiwawe,","poem":2},{"text":"waritana xekenayaxetɨkɨni,","poem":1},{"text":"nixeime xepɨkatayutsitɨwani.","poem":2},{"text":"Kememɨte'uyuri mɨpaɨ xekeniwaruyuri,","poem":1},{"text":"yaxeikɨa xeketeniwarakapitɨa kememɨxe'uyuri.","poem":2},{"text":"Mɨkɨ Yawé muta'iwaxɨkɨ,","poem":1},{"text":"Mɨpatsie 'Ixaheri hetsiemieme.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"'Ayumieme 'iya tukaritsie","poem":1},{"text":"temari mana kiekatari kaye 'utɨma mekanikaxɨrikuni","poem":2},{"lineBreak":true},{"text":"meta yunaitɨ kuyaximama menikwikuni","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"»Nekamenaye'unieka 'ekɨ, kiekari pemɨ'ata'ɨre","poem":1},"—Ti'aitame mɨpaɨ kanaineni, Yawé Naimekɨmɨtɨrɨkaɨye—,",{"text":"'ari 'atukari kanaye'ani,","poem":1},{"text":"kepauka pemɨtikwinitɨarienitsie.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Muyuta'ɨre kanekawitseimɨkɨ, kanekawemɨkɨ,","poem":1},{"text":"pumaweni kemɨ'ane menukuhana.","poem":2},{"text":"Nekanititaiyamɨkɨ naime kiekariteya,","poem":1},{"text":"tai naime katinititaiyamɨkɨ wa'aurie mɨrahane».","poem":2}]},{"type":"verse","number":33,"content":["Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye:",{"text":"«'Ixaheritsixi meta Kura kiekatari memu'uximatɨarie mekanihɨkɨtɨni,","poem":1},{"text":"memɨwaraye'unie mepɨwaranutaxɨri,","poem":2},{"lineBreak":true},{"text":"mepɨkawapitɨa mexɨxɨnitɨ memu'uwanikɨ.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Peru waxɨname kanitɨrɨkaɨyeni,","poem":1},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye katinitewaka.","poem":2},{"text":"Yutɨrɨkariyakɨ wahetsie kanitanuamɨkɨ,","poem":1},{"text":"'aixɨa 'iyari kwiepa memu'uwanikɨ kaniwapitɨamɨkɨ,","poem":2},{"lineBreak":true},{"text":"peru Wawiruniya hetsiemieme, marika kanipitɨamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"»Wawiruniyutsixi mɨɨya pɨwapitɨani.","poem":1},{"text":"Memanuyetei meta memɨtemaiwawe mana kiekatari puwakwini","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":36,"content":[{"text":"Kakaɨyari niukametemama memɨte'itawa puwakwini.","poem":1},{"text":"Meka'u'iyarime pɨwarayeitɨani.","poem":2},{"text":"Wakuyaxima memɨyɨwawe puwakwini.","poem":1},{"text":"Memamakame puwarayeitɨani.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Wakawayutsixima meta wakaxetate meke'ukwi'iwa.","poem":1},{"text":"Yunaitɨ 'inierimama meke'ukwi'iwa.","poem":2},{"lineBreak":true},{"text":"'Ukarawetsixi wahepaɨ meke'utimamani.","poem":2},{"text":"Tita memɨtehexeiyakai mɨraye'atɨka kereuyehɨiyani.","poem":1},{"text":"Mekete'unawatsiyarieni.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Haa mana mieme ke'ukumaweriyarieni.","poem":1},{"text":"Ke'ukawatsiɨxarieni.","poem":2},{"text":"Wawiruniya kakaɨyarixi wa'ɨkiyari kwieyari mɨhɨkɨkɨ,","poem":1},{"text":"kakaɨyarixi 'axamemɨ'anene teɨteri rukutsixi mekaniwarayeitɨwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"»'Ayumieme teyukwa'amete makumawetsie miemete","poem":1},{"text":"tsɨikɨri yeutari wahamatɨa mana mepu'uwani,","poem":2},{"lineBreak":true},{"text":"metatsiere 'aruxi 'amemɨnene wakie kanayeimɨkɨ.","poem":2},{"text":"Tawariri kiepa pɨkahayani,","poem":1},{"text":"'akumawetɨ kanayeimɨkɨ yuheyemekɨ.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Kepauka Tsuruma meta Kumuxa Kakaɨyari mika'unaxɨ hepaɨ raku'anetɨ payani,","poem":1},{"text":"meta kiekarite 'auriena mamanetɨkatei,","poem":2},{"text":"Mana nixewitɨ pɨkayutakiitɨani,","poem":1},{"text":"nixewitɨ tewi mana pɨkatayerɨni","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"»Tayeta kuyaxi mekanayehuni,","poem":1},{"text":"kwie manuye'atɨkatsie paitɨ kiekatari","poem":2},{"lineBreak":true},{"text":"kaniyuha'aritɨaka xewitɨ kiekari mariwetɨ meta te'aitamete meyumɨiretɨ.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"'Umekanahuni tupi me'u'ɨtɨ meta pitsika 'amɨtɨtɨ,","poem":1},{"text":"mɨkɨ 'axamekateniu'iyarini mepɨkate'uyukanenimaya.","poem":2},{"text":"Kawayutsixi wahetsie me'utetɨ mekanahuni,","poem":1},{"text":"wayuarika haramara kemutaine mɨpaɨ katini'eniɨriɨkɨni.","poem":2},{"text":"Kiekari Wawiruniya witsimɨraye'ane, mematsika'unake,","poem":1},{"text":"'ahepa 'umekanahuni xuruku mehewetɨkaitɨ,","poem":2},{"lineBreak":true},{"text":"muyuxewini hepaɨ meteyuxexeiyatɨ.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Ti'aitame Wawiruniya kiekame katiniutamarieniri,","poem":1},{"text":"katɨrɨkaɨyetɨri kanayani,","poem":2},{"text":"hiwerika hexeiyatɨ patɨa,","poem":1},{"text":"meta kukuiniya hexeiyatɨ kanayani hukame mɨtiniwerɨmeni hepaɨ.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Kurutani mɨ'ɨtsiyata maye mayeneika","poem":1},{"text":"makutsiɨraɨye 'ɨxapa yapauka mɨ'axe hepaɨ,","poem":2},{"lineBreak":true},{"text":"'ɨxapa makutsiɨraɨyetsie,","poem":2},{"text":"yapauka neniwatimariutamɨkɨ Wawiruniya kiekatari,","poem":1},{"text":"wahetsiemieme ne xeime nekananayexeiyamɨkɨ.","poem":2},{"text":"Tawari Kakaɨyari pumawe nehepaɨ 'anetɨ.","poem":1},{"text":"Xewitɨ mɨnetsita'iwa pɨkayɨwe.","poem":2},{"lineBreak":true},{"text":"Nixewitɨ muxatsi wahɨweme netsi'aye'unietɨ pɨka'ayeiwe».","poem":2}]},{"type":"verse","number":45,"content":[{"text":"'Ayumieme xekeneu'eni Yawé kemɨtiyurimɨkɨ","poem":1},{"text":"Wawiruniya hepaɨtsita,","poem":2},{"text":"xekeneu'eni kemɨtiyɨkɨhɨawe,","poem":1},{"text":"wawiruniyutsixi wakwieyari hepaɨtsita:","poem":2},{"text":"Mekananayehapanietɨkɨnikuni","poem":1},{"text":"muxatsi 'etsimemupepe,","poem":2},{"text":"mɨkɨ mɨyamemɨte'uyurikɨ,","poem":1},{"text":"memɨtehatikwa'akaitsie 'akumawetɨ kanayeimɨkɨ.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Kwie kanitayuamɨkɨ","poem":1},{"text":"Wawiruniya matiwenitsie mɨka'unarienitsie,","poem":2},{"text":"watsuari kani'enieriekamɨkɨ","poem":1},{"text":"nuiwarite watsata.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JER/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JER/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JER/49.json","previousChapterAudioLinks":{},"numberOfVerses":46}