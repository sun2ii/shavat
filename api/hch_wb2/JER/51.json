{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JER","translationId":"hch_wb2","name":"Keremiyaxi","commonName":"Keremiyaxi","title":"Keremiyaxi","order":24,"numberOfChapters":52,"sha256":"771a2352ddb97ef3895e81db88d089eedf1f7c4caac6b2b7f4b4d6b3602b468f","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/hch_wb2/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":51,"content":[{"type":"verse","number":1,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«'Eka tɨrɨkaɨyeme tiyu'uname nekaninetɨamɨkɨ","poem":1},{"text":"Wawiruniya hetsiemieme meta Rewi Kamahi","poem":2},{"noteId":2},{"text":"kiekatari wahetsiemieme.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wawiruniya hetsiemieme nepuwaranunɨ'ani","poem":1},{"text":"teɨteri teikɨ memeihɨanikɨ,","poem":2},{"text":"tɨriku kemɨtihenarɨwa hepaɨ mɨ'itɨarienikɨ,","poem":1},{"text":"kepaukake 'akumaweme memɨhayewa.","poem":2},{"text":"Kepauka mu'uximatɨarieni","poem":1},{"text":"naitsarie kiekatari mepitamieni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tupikɨ temɨmɨmete xepɨkawapitɨaka memɨtetamɨnikɨ,","poem":1},{"text":"xepɨkawapitɨaka tepɨa kamixayari memanakatɨkɨni.","poem":2},{"text":"Waniwema temari xepɨkawahayewani,","poem":1},{"text":"wakuyaxima yunaime xekeniwarukuya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wawiruniyutsixi yukwieyaritsie mekanikaxɨrikuni,","poem":1},{"text":"kaye'utɨma 'ixiparakɨ mekananuyetsekiexɨakuni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tsepa 'Ixaheritsixi meta Kura kiekatari waɨkawa wahetsie mɨrahɨiwa","poem":1},{"text":"Mɨpatsie 'Ixaheri hetsiemieme hɨxie,","poem":2},{"text":"wakakaɨyari pɨkawaruku'eiri,","poem":1},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"»Wawiruniya xemu'uwa xekeneuyuta'una.","poem":1},{"text":"Ke'uyutawikweitsitɨani kemɨ'ane mɨyɨweni.","poem":2},{"lineBreak":true},{"text":"Kapa mɨkɨ 'axamemɨte'uyurikɨ mana xe'ukwi'iwa wahetsiemieme.","poem":2},{"text":"Karikɨ kanaye'aniri tukari","poem":1},{"text":"kepauka Yawé mɨtiwarakapitɨani,","poem":2},{"lineBreak":true},{"text":"mɨkɨ yapuwayurieni kememɨte'uyurikɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yawé mamayatsie","poem":1},{"text":"Wawiruniya huru tekɨxiyari kanihɨkɨtɨkaitɨni","poem":2},{"lineBreak":true},{"text":"naitsarie kwiepa memɨtama mɨwarutitarɨwaitɨa.","poem":2},{"text":"Nuiwarite mɨkɨta winu mekananu'ieni","poem":1},{"text":"hikɨ meka'u'iyaritɨ mekanayexɨrieni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Peru yapauka Wawiruniya kanatiweni kaneutimurixɨani.","poem":1},{"text":"Xekeneutitsuanani hetsiena mieme.","poem":2},{"text":"Waritsamu xekene'atɨa temi'uayemanikɨ,","poem":1},{"text":"heiwatɨ 'anayeweni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"»“Wawiruniya tepu'uayemakai,","poem":1},{"text":"peru pɨka'anayewe,","poem":2},{"text":"tepiku'eirieni, xekenakunuaxɨa yuxexuitɨ yukwieyaritsie,","poem":1},{"text":"muyuawitsie paitɨ kanematiwani ke'axamɨtiuyuri,","poem":2},{"lineBreak":true},{"text":"hai manuyekate paitɨ kaneuti'aka”.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"»“Yawé pɨtiuhekɨataxɨ heitserie ketemɨtehexeiyakɨ.","poem":1},{"text":"Xekenayeixɨa, Tsiyunitsie tepɨtetaxata","poem":2},{"lineBreak":true},{"text":"Yawé kemɨtiuyuri, takakaɨyari”.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"»Yu'ɨrɨ xekenanuyemɨaxɨa.","poem":1},{"text":"Yuhetsie nunuwame xekeneuti'ɨi.","poem":2},{"text":"Yawé mɨpaɨ pɨtiwaru'iyaritɨa","poem":1},{"text":"Meriya kiekatari te'aitamete","poem":2},{"lineBreak":true},{"text":"Wawiruniya memɨka'unakɨ.","poem":2},{"text":"'Ikɨ kanihɨkɨtɨni Yawé kemɨtiwarakapitɨani,","poem":1},{"text":"kemɨtiyukɨhɨani yutuki hetsiemieme.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kuyaxa paterayari xekenanuwi","poem":1},{"text":"Wawiruniya kuraruyari hetsiemieme.","poem":2},{"text":"Xehɨwemete xekeniwarutɨrɨkariya.","poem":1},{"text":"'Ateewa nenieremete xekeniwaru'uitɨa.","poem":2},{"lineBreak":true},{"text":"'Imieri xekeneukuha'arita.","poem":2},{"text":"Yawé katinaye'atɨamɨkɨ ke'ayumieme mɨtiyurienekai,","poem":1},{"text":"kemɨtiuta'aitakai wawiruniyutsixi wahetsiemieme katinaye'atɨamɨkɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Ekɨ, haa waɨkawa xuawekaku pemɨkiekame","poem":1},{"text":"meta waɨkawa mɨraye'atɨka pemɨrexeiya pemɨxiku,","poem":2},{"text":"'a'imatɨrieka tukaritsie pekaniyɨaneni,","poem":1},{"text":"pe'uyeikatɨ 'ena xeikɨa pekanati'ani.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yawé Naimekɨmɨtɨrɨkaɨye yuhɨritɨatɨ mɨpaɨ kaniutayɨni:","poem":1},{"text":"“Memɨmetsi'aye'unie 'utsikari memɨyumɨire wahepaɨ meyupaɨmeme nepɨwarayeitɨani,","poem":2},{"lineBreak":true},{"text":"'ahetsiemieme meputihiwani memɨmatsiha'iwaxɨkɨ”.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"»Yawé kwie kaniutawewieni yɨtɨrɨkariyakɨ,","poem":1},{"text":"kemɨtimaiwekɨ kwie 'aixɨa katiniuyeni,","poem":2},{"lineBreak":true},{"text":"muyuawi 'ayeume kanayeitɨani kemɨrakumatekɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tɨranarieya heyuayu, wiyeri kanikuyuaneni muyuawitsie,","poem":1},{"text":"kwie manu'atɨka paitɨ","poem":2},{"lineBreak":true},{"text":"hai kanewa'iniwani,","poem":2},{"text":"mimierɨka tsata wiyeri kaneyenɨ'awani,","poem":1},{"text":"meta 'eka muye'ɨnetɨkatsie peiyepiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"»Yunaitɨ teɨteri 'atsimemɨkatemate meta memɨte'ukatawe'erie mepɨhɨkɨ,","poem":1},{"text":"yunaitɨ kakaɨyarixi wawewiwamete mepɨyutetewiya yuwewiyakɨ.","poem":2},{"text":"Wakakaɨyarixi 'itarika memɨhɨkɨkɨ,","poem":1},{"text":"mepɨka'ayeneniere mepɨka'uti'iwe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tixaɨtɨ mepɨkateyunaki'erie, wawewiya pɨnanaiyɨkɨ xeikɨa,","poem":1},{"text":"kepauka tukari maye'ani memɨtekwinitɨarienitsie mepɨka'unarieni.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kakaɨyari Kakuwu manayexei nuiwarieya mayanikɨ mɨkɨ wahepaɨ pɨka'ane,","poem":1},{"text":"mɨkɨ naime mɨtiunetɨa kanihɨkɨtɨni.","poem":2},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye katinitewaka,","poem":1},{"text":"Meta nuiwarieya 'Ixaheri kanihɨkɨtɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"»'Ekɨ nemaxu pepɨhɨkɨ, nemɨyutamemiwatsie mieme,","poem":1},{"text":"'akɨmana nuiwarite meta te'aitamete nepɨwatitsuna.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"'Akɨmana memutei meta kawayutsixi nepɨwatitsuna,","poem":1},{"text":"'akɨmana kaxetate kuyaxa miemete meta memɨwarunɨ'a nepɨwatitsuna.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"'Akɨmana 'ukitsi meta 'ukari nepɨwatitsuna,","poem":1},{"text":"'akɨmana temari meta 'ukirawetsixi nepɨwatitsuna,","poem":2},{"lineBreak":true},{"text":"'akɨmana temari meta 'ɨimarixi nepɨwatitsuna.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"'Akɨmana muxatsi wahɨwemete meta muxatsi nepɨwatitsuna,","poem":1},{"text":"'akɨmana teɨteri 'etsamete meta tuurutsixi kwietsanamete nepɨwatitsuna,","poem":2},{"lineBreak":true},{"text":"'akɨmana memanuyetei meta te'aitamete nepɨwatitsuna.","poem":2}]},{"type":"verse","number":24,"content":["»Peru xeme xehɨxie nekatinekapitɨamɨkɨ Wawiruniya meta yunaime mana kiekatari 'axamemɨte'uyurikɨ Tsiyuni kiekariyaritsie —Yawe mɨpaɨ kanaineni—."]},{"type":"verse","number":25,"content":[{"text":"»Ne nekamenaye'unieka","poem":1},{"text":"hɨri pemɨti'aka'uname,","poem":2},{"lineBreak":true},{"text":"naime kwie pemuka'unaxɨ —Yawé mɨpaɨ kanaineni—.","poem":2},{"text":"Netɨrɨkariyakɨ nekamanimayɨamɨkɨ,","poem":1},{"text":"tekɨa nekamaneukakurupamɨkɨ","poem":2},{"lineBreak":true},{"text":"hɨri mɨta'i nekamanayeitɨamɨkɨ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"'Ahetsɨa mieme tete 'itsikina mieme mayanikɨ pɨkatituiyani,","poem":1},{"text":"meta tete kii tsutɨmeyari mayanikɨ pɨkatituiyani,","poem":2},{"lineBreak":true},{"text":"yuheyemekɨ pe'akumawetɨ pekanayeimɨkɨ","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"»Kuyaxa paterayari xekenanuwi mɨkɨ kwieyaritsie.","poem":1},{"text":"Kuxineta xekeneutahɨtsi nuiwarite watsata.","poem":2},{"text":"Xekeniwaruta'ini memeye'uniekakɨ","poem":1},{"text":"te'aitamete 'Ararati kiekame, Mini kiekame, meta 'Atsikenatsi kiekame.","poem":2},{"text":"Xeime kuyaxi wa'ukiyari xekenanuyeyetsa.","poem":1},{"text":"Kawayutsixi meke'ayekɨne 'utsikari memɨyumɨire wahepaɨ meteyuxexeiyatɨ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Xekeniwaruta'ini nuiwarite memeye'uniekakɨ,","poem":1},{"text":"te'aitamete Meriya kiekatari,","poem":2},{"text":"kuwexinaruritsixi meta teparewiwamete 'ahurawa memuti'u.","poem":1},{"text":"Keyeume kwietsie mɨti'aita xekeniwaruta'ini.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Kwie kanitayuamɨkɨ meta kaniyutakatsimɨkɨ,","poem":1},{"text":"Yawé katinaye'atɨwani kemɨtiyurienikekai Wawiruniya hetsie,","poem":2},{"text":"hakumaweme kanayeitɨamɨkɨ","poem":1},{"text":"nixewitɨ mana pɨkayutakiitɨani.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Mekateniuhayewa kuyaxi Wawiruniya kiekatari meyukwitɨwetɨ,","poem":1},{"text":"mekaniuyuti'awieta kiekari yukuraru 'amatitetewa mexeiyatɨkata.","poem":2},{"text":"Mekatɨrɨkawitɨ mepakɨ,","poem":1},{"text":"'ukarawetsixi wahepaɨ metemamatɨ mekanakɨne.","poem":2},{"text":"Wakii kaniutitaiyarieni","poem":1},{"text":"wakiita mɨreunatɨkatei katineumurariexɨani.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Tixaxatame kanayenautsa xeime tixaxatame 'utɨma,","poem":1},{"text":"xewitɨ tupiri xeime tupiri kananukuweiya,","poem":2},{"text":"Wawiruniyatsie ti'aitame memɨtetaxatɨanikɨ","poem":1},{"text":"kename naime kiekaritsieri mewatahaxɨakairi kuyaxi.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Hapa 'etsimatiyeyeutsie memanukɨkatsie mekaniutetɨkani,","poem":1},{"text":"mayehakayatɨka mekaniutitaiya,","poem":2},{"lineBreak":true},{"text":"hikɨ waɨkawa kuyaxi mekanimamaka».","poem":2}]},{"type":"verse","number":33,"content":["Mɨpaɨtsɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye, 'Ixaheri Kakaɨyarieya:",{"text":"«Wawiruniya kiekariyari witsimɨraku'ane, tɨriku waxayari hepaɨ pɨ'ane,","poem":1},{"text":"ka'itsanarieximetɨ,","poem":2},{"lineBreak":true},{"text":"'ari tukarieya kanaye'ani mɨka'itsanarienikɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"«Nawukurunutsuxi, Wawiruniyatsie ti'aitame,","poem":1},{"text":"kaneniutakwani, kaneniuhɨxiyatsitɨani,","poem":2},{"lineBreak":true},{"text":"xakɨ mayewaki hepaɨ ne'aneme kaneniuhayewa.","poem":2},{"text":"Tiyukwa'ame mɨmariwe haramaratsie muyeyeika hepaɨ kanenanukaxɨni,","poem":1},{"text":"'aixɨa mɨnetiu'inɨataxɨkɨ putahuxai","poem":2},{"lineBreak":true},{"text":"'ariketa mɨnetsi hanatihayanikɨ.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Kerutsareme kiekatari mɨpaɨ mekanaitɨkani:","poem":1},{"text":"“Wawiruniya hetsie ketiunake","poem":2},{"lineBreak":true},{"text":"nanaimarikakɨ ke'axamɨtatsi'uyuri”.","poem":2},{"text":"Mɨpaɨ mekanaitɨkani Tsiyuni kiekatari:","poem":1},{"text":"“Taxuriya ke'utayeurieni","poem":2},{"lineBreak":true},{"text":"wawiruniyutsixi wahetsie”».","poem":2}]},{"type":"verse","number":36,"content":["'Ayumieme, Yawé mɨpaɨ kanaineni:",{"text":"«Kepemɨranuyetɨa 'ahetsie nekanitanuamɨkɨ,","poem":1},{"text":"mɨpaɨ nekatiniwarakapitɨamɨkɨ,","poem":2},{"text":"naime haramaraya nekanikawatsiɨxamɨkɨ,","poem":1},{"text":"meta haixateya nekanikawatsiuxamɨkɨ.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Wawiruniya 'unitɨ kaniyuhayewamɨkɨ,","poem":1},{"text":"yawixi memayu'eririya wakie kanayeimɨkɨ,","poem":2},{"text":"hipatɨ mepumamaka me'ixeiyatɨ 'axamɨtiyuxexeiyakɨ meta tewiwetɨ,","poem":1},{"text":"ka'akukiepayatɨ kanayeimɨkɨ.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Mana kiekatari yunaitɨ mayetsi wahepaɨ mekaniutiyuaneni,","poem":1},{"text":"mayetsi tɨɨrixi wahepaɨ mekateniutsuanani.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Kepauka mɨxɨkanitsie, nekaniwarakaharitɨamɨkɨ,","poem":1},{"text":"nekaniwatitarɨwaitɨamɨkɨ yamemɨtiyɨnikɨ kemɨtiwanake.","poem":2},{"text":"Mɨpaɨ yuheyemekɨ mekaneukutsikuni","poem":1},{"text":"hatsuaku mepɨka'anutaneniere","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":40,"content":[{"text":"Nekaniwaranuhapamɨkɨ memekwi'iwakɨ,","poem":1},{"text":"muxatsi tɨɨrixi memɨhɨkɨtɨni wahepaɨ,","poem":2},{"lineBreak":true},{"text":"muxatsi 'ukitsi yatɨni tsipuri memɨhɨkɨtɨni wahepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"»Kehepaɨ tiuwiyarie Tsetsaki.","poem":1},{"noteId":3},{"text":"Kehepaɨ ra'iwarie,","poem":2},{"lineBreak":true},{"text":"yunaitɨ kwiepa memɨtama hetsiena mieme memɨyuti'ɨrekai.","poem":2},{"text":"Wawiruniya makaxiwatɨ kanayani","poem":1},{"text":"nuiwarite wahetsiemieme.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Haramara Wawiruniya heima kaneutiyeurieni,","poem":1},{"text":"hamewarieya kanenukanani.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Kiekariteya 'akumawetɨ kaniyuhayewaxɨani:","poem":1},{"text":"makuwaki hepaɨ, makumetse hepaɨ.","poem":2},{"text":"Nixewitɨ mana pɨkakie,","poem":1},{"text":"meta nixewitɨ mana pɨka'uyeyeika.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Weri kakaɨyariyari wawiruniya mieme nekatinikwinitɨamɨkɨ,","poem":1},{"text":"tita mɨtiutikwai mihayanikɨ yanekatiniyurimɨkɨ.","poem":2},{"text":"Nuiwariteri hetsɨana tawari mepɨka'axɨani,","poem":1},{"text":"meta Wawiruniya kuraruyari 'a'uwetɨri pɨkahayewarieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"»Neteɨterima, mɨkɨtsie xekenayekɨni xekeneuyuta'una.","poem":1},{"text":"Kemɨ'ane mɨyɨweni ke'uyutawikweitsitɨani nehaxɨa mɨtiyutaiyatsie.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Xepɨkaku'amɨweni, xepɨkamamaka","poem":1},{"text":"kemɨtikuxaxatsiwakɨ 'ikɨ kwieyaritsie.","poem":2},{"text":"Xexuitɨ witari manuyekɨkatsie, yɨkɨ 'anetɨta panuyeyeika niuki,","poem":1},{"text":"nanaimarika mɨkɨ kwieyaritsie pɨtixuawere,","poem":2},{"lineBreak":true},{"text":"meta te'aitamete me'ayuye'unietɨ mepakɨne.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Tukari 'ari kanaye'aximeni","poem":1},{"text":"kepauka nemɨtiwakwinitɨani kakaɨyarixi Wawiruniya miemete.","poem":2},{"text":"Naitɨ mɨkɨ kwieyari kanitewiyatsitɨariemɨkɨ,","poem":1},{"text":"hetsɨana miemete memɨkwi'iwa mana mekanikaxɨrikuni.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Hikɨ muyuawi meta kwie,","poem":1},{"text":"meta yunaitɨ mana memɨte'u'uwa,","poem":2},{"text":"temawierikakɨ menitihiwakuni Wawiruniya hetsiemieme,","poem":1},{"text":"karikɨ tayeta menayenexɨakuni memika'una","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"»Peuyewetse Wawiruniya mɨka'unarienikɨ","poem":1},{"text":"'ixaheritsixi muwarukwikɨ,","poem":2},{"text":"meta naitsarie kwiepa miemete","poem":1},{"text":"Wawiruniya muwarukwikɨ.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Xeme, xemuyuta'unaxɨ xekwi'iwake","poem":1},{"text":"xekeneuyu'unarɨmeni xekatehayewatɨ.","poem":2},{"text":"Yawé xekenahɨaweni 'ateewa paitɨ,","poem":1},{"text":"xepɨkatehayewani Kerutsareme xeheku'eriwatɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"«Tepeuyutetewiyakai 'axatemɨtekɨhɨawarɨwakaikɨ,","poem":1},{"text":"tewiyarikakɨ tepɨhɨpɨnekai,","poem":2},{"text":"teɨteri memɨkata'iwama 'ateewa kiekatari","poem":1},{"text":"Yawé tukieyata memeutahaxɨakɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"«'Ayumieme, tukari 'ukanamieni","poem":1},{"text":"kepauka wakakaɨyarixi nemɨtiwakwinitɨanitsie,","poem":2},{"text":"'ayumieme naitsarie mɨkɨ kwieyaritsie","poem":1},{"text":"memɨte'uka'eniwa meniti'iteikakuni","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":53,"content":[{"text":"Tsepanetɨ Wawiruniya muyuawitsie paitɨ meuti'axe,","poem":1},{"text":"meta tsepa mana paitɨ yukuraru mɨtɨrɨkaɨye mutawewi,","poem":2},{"lineBreak":true},{"text":"ne te'unamete nekaniwaranunɨ'amɨkɨ hetsiena mieme","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"line_break"},{"type":"verse","number":54,"content":[{"text":"»Hiwari pa'eniɨriɨkɨ mariwemekɨ muka'unariekɨ,","poem":1},{"text":"Wawiruniya kwieyari.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Yawé pika'una naime,","poem":1},{"text":"hiwarieya peutiparitɨani.","poem":2},{"text":"Memeye'unie hamewari mɨha'a hepaɨ pɨtiyu'eniɨriɨkɨ,","poem":1},{"text":"wahiwari pɨwa'eiya.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Kaniye'aka Wawiruniya 'uname,","poem":1},{"text":"kuyaximama mekanitiwiyariekuni,","poem":2},{"lineBreak":true},{"text":"watupi kanitimurariemɨkɨ.","poem":2},{"text":"Karikɨ Yawé Kakaɨyari kanihɨkɨtɨni","poem":1},{"text":"yakatiniwarakapitɨwani yuxexuime.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Memanuyetei meta temaiwawemete neniwatitarɨwaitɨamɨkɨ,","poem":1},{"text":"meta kuwexinaruritsixi, teparewiwamete meta kuyaxi,","poem":2},{"text":"hikɨ mekaneukutsikuni yuheyemekɨ,","poem":1},{"text":"hatsuakuri mepɨkahayuhɨtɨani»,","poem":2},{"text":"Ti'aitame mɨpaɨ kanaineni,","poem":1},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye mɨtitewa.","poem":2}]},{"type":"verse","number":58,"content":["Yawé mɨpaɨ kanaineni Naimekɨmɨtɨrɨkaɨye:",{"text":"«Wawiruniya kuraruyarite 'amatayeyeu","poem":1},{"text":"naitɨ kanika'unariemɨkɨ,","poem":2},{"lineBreak":true},{"text":"meta 'itupariteya mumamariwawe pɨtitaiyarieni.","poem":2},{"text":"Teɨteri yakɨ xeikɨa meputi'uxixɨ,","poem":1},{"text":"nuiwarite yakɨ xeikɨa mepɨte'uyu'uxitɨa","poem":2},{"lineBreak":true},{"text":"kɨtsi xeikɨa matɨakɨ hikɨ».","poem":2}]},{"type":"verse","number":59,"content":["'Ikɨ 'aitsika kanihɨkɨtɨni Kakaɨyari niukameya Keremiyaxi Tserahiyaxi mɨhɨritɨa Neriyaxi nu'aya Matsehiyaxi teukarieya, kepauka Tserekiyaxi, Kura kwieyaritsie ti'aitame, hamatɨa metɨa Wawiruniya, naurieka wiyari ti'aitakaku. 'Ana Tserahiyaxi memewitɨkie mɨtiwa'aitɨa pɨhɨkɨtɨkai."]},{"type":"verse","number":60,"content":["Keremiyaxi tinaka'utɨakaitɨni xapatsie kemɨti'uximatɨarienikekai Wawiruniya, naitɨ hepaɨtsitana raxaxatame."]},{"type":"verse","number":61,"content":["Keremiyaxi mɨpaɨ Tserahiyaxi katiniutahɨawe: «Kepauka pemeta'ani Wawiruniya, pepɨkaratɨtɨmaiyani pemɨwarakaterɨwirienikɨ 'ikɨ niuki naime."]},{"type":"verse","number":62,"content":["Hikɨ mɨpaɨ pepetayɨni: “Yawé, 'ekɨ mɨpaɨ pepaine kename 'ikɨ kiekari peka'una, kename hakumaweme pehayeitɨani, nixewitɨ hawaikɨ kareyeikame, tewi meta niyeutanakatɨma”."]},{"type":"verse","number":63,"content":["Kepauka pemekanɨni xapa, tete kenakahɨaka hapa 'Eupɨrate hetsie keneukawiwi."]},{"type":"verse","number":64,"content":["Hikɨta mɨpaɨ ketiniwaretahɨawi: “'Ipaɨ Wawiruniya katinikayunimɨkɨ, tawari pɨka'anukukeniri 'uximatɨarikatsata nemi'atɨirienitsie”».",{"lineBreak":true},"'Ena kanikɨnɨtsirikeni Keremiyaxi niukieya."]}],"footnotes":[{"noteId":2,"caller":"+","text":"Hepɨrayukɨ panuyɨne Memɨnetsi'aye'unie Wa'iyari.","reference":{"chapter":51,"verse":1}},{"noteId":3,"caller":"+","text":"Hepɨrayukɨ panuyɨne 'Awie Wawiruniya hetsiemieme mɨtikuxata.","reference":{"chapter":51,"verse":41}}]},"thisChapterLink":"/api/hch_wb2/JER/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JER/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JER/50.json","previousChapterAudioLinks":{},"numberOfVerses":64}