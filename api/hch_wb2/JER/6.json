{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JER","translationId":"hch_wb2","name":"Keremiyaxi","commonName":"Keremiyaxi","title":"Keremiyaxi","order":24,"numberOfChapters":52,"sha256":"771a2352ddb97ef3895e81db88d089eedf1f7c4caac6b2b7f4b4d6b3602b468f","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/hch_wb2/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":6,"content":[{"type":"heading","content":["Kerutsareme 'imatɨrieka kemɨrayemari'itɨarie"]},{"type":"verse","number":1,"content":[{"text":"»Xekenayekɨni Kerutsareme kiekariyaritsie Wenikamini xiɨyarimama.","poem":1},{"text":"'Awa xekenetahɨtsi Tekuha paitɨ.","poem":2},{"lineBreak":true},{"text":"'Inɨari xekenanuyewi Weti-Hakereni paitɨ.","poem":2},{"text":"'Uximatɨarika mepɨtatsiwewirieni meta mepɨtatsika'una,","poem":1},{"text":"kuyaxi meyumɨiretɨ metɨrɨkaɨyetɨ tayeta 'amepayehu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tsiyuni nekanika'unarɨmeni,","poem":1},{"text":"witsimɨti'ɨimari meta mukweriwa'ane.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tehɨwemete meta yumuxatsima","poem":1},{"noteId":1},{"text":"mewara'arietɨ mepɨ'axɨani hetsɨana:","poem":1},{"text":"'auriena mepayaxetɨkɨne,","poem":2},{"lineBreak":true},{"text":"yuxexuitɨ mepenayexeiyaxɨani hakewa wamuxatsima memɨtehetikwa'anikɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«Xekeneuyukuha'aritɨa mɨkɨ temɨtamienikɨ.","poem":1},{"text":"Tekanitamiekuni tuka haye'ayu.","poem":2},{"text":"Peru, xɨa'ui tame, tukarikɨ pɨkareutere","poem":1},{"text":"meta 'etɨriya 'apɨtewi tɨkarikɨ mieme.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hikɨmɨtɨka, tɨkarikɨ tepɨwatakwini,","poem":1},{"text":"titatsie memɨteyukɨtɨrɨkariya tepɨwaka'unierieni».","poem":2}]},{"type":"verse","number":6,"content":["Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye:",{"text":"«Kɨyexi xekeneutiwiteki","poem":1},{"text":"xekeneutawewi makeme Kerutsareme xemeutahaxɨanikɨ.","poem":2},{"text":"'Ikɨ kiekari peuyewetse mɨtikwinitɨarienikɨ,","poem":1},{"text":"mana nanaimarika xeikɨa muxuawekɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Putsuta haa kemɨrewatineika,","poem":1},{"text":"mɨpaɨta 'axamɨti'ane Kerutsareme pɨtiuhane.","poem":2},{"text":"Hetsiena nanaimarika xeikɨa pɨrayu'eniɨriɨkɨ meta 'imieri,","poem":1},{"text":"mana kwiniya xeikɨa nepɨxeiya meta teɨteri mewitekietɨkaime.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Keneu'apata, Kerutsareme,","poem":1},{"text":"nemɨkamatsi'uku'e'eiriwanikɨ.","poem":2},{"text":"Xɨka mɨpaɨ peka'ɨyɨni, makumawe nepɨmatsihayeitɨani,","poem":1},{"text":"xewitɨ mɨka'anuyeika».","poem":2}]},{"type":"verse","number":9,"content":["Yawé mɨpaɨ kanaineni Naimekɨmɨtɨrɨkaɨye:",{"text":"«Xekeniwarutiwawa 'ixaheritsixi memuyuhayewaxɨ.","poem":1},{"text":"'Aixɨa xeketeniwaruwawa, kaxie 'imatɨrieka mieme xemɨwautɨweni hepaɨ,","poem":2},{"text":"mamateyatsie tawarita xekeneukaxeiya,","poem":1},{"text":"kaxie 'inɨweme mɨtiuka'iyari hepaɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"¿Kemɨ'ane nepɨtahɨawe?","poem":1},{"text":"¿Kemɨ'ane nepayemari'itɨani?","poem":2},{"lineBreak":true},{"text":"¿Kemɨ'ane pɨnetsi'enieni?","poem":2},{"text":"Yunakata mepeukanatɨka","poem":1},{"text":"mepɨkaheti'enatɨkɨka.","poem":2},{"text":"Yawé niukieya 'axamepɨte'enie,","poem":1},{"text":"mepixani'erie memi'enienikɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Peru ne Yawé haxɨayakɨ nepɨhɨne,","poem":1},{"text":"meta nepɨka'inewieri.","poem":2},{"lineBreak":true},{"text":"«'Ahaxɨa tɨɨri kaye 'utuma memɨye'uwa wahetsie keneukawiwi,","poem":1},{"text":"metatsiere temari wahetsie,","poem":2},{"text":"karikɨ mekanitiwiyariekuni memɨneneɨke meta memɨwikie,","poem":1},{"text":"'ukirawetsixi meta kwinimieme memɨte'ukirawetsixi».","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yawé mɨpaɨ kanaineni:","poem":1},{"lineBreak":true},{"text":"«Wakiite, wakwie meta wa'ɨitama","poem":1},{"text":"hipame wahetsiemieme katinayeimɨkɨ,","poem":2},{"text":"karikɨ ne netɨrɨkariya nekananunɨ'amɨkɨ","poem":1},{"text":"'ikɨ kwieyaritsie kiekatari wehetsiemieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"»'Etsimemɨyumate meta memu'ukirawetsixi,","poem":1},{"text":"yunaitɨ mepɨtehiwe'erie tita mɨkatiheitseriekɨ memɨte'iwanikɨ.","poem":2},{"text":"Kakaɨyari niukametemama meta mawari wewiwamete,","poem":1},{"text":"yunaitɨ mepɨte'itawa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Neteɨterima mepɨwa'uayema herie miemekɨ xeikɨa,","poem":1},{"text":"meta mɨpaɨ mepɨtewarahɨawe: “Kayuwatɨ puma, kayuwatɨ puma”,","poem":2},{"lineBreak":true},{"text":"'aixɨtsɨ kayuwatɨ mɨka'umatsie.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"¿Kamɨtsɨ mete'uyutitetewiyaxɨ","poem":1},{"text":"kemɨtixani'eriwakɨ yamete'uyurieka?","poem":2},{"text":"Hawaikɨ, tixaɨtɨkɨ mepɨkateyutitetewiyawawe,","poem":1},{"text":"mepɨka'imate paitɨ tita mɨtitewiyarika.","poem":2},{"text":"'Ayumieme, tsepari kemɨ'ane memɨwarutakwi,","poem":1},{"text":"kepauka 'uximatɨarika wahetsie nemɨkawiwieni, nepɨwaka'una»,","poem":2},"Yawé kanaineni."]},{"type":"verse","number":16,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«Huyeta xekenewa'uti hikɨ xekeneutanierixɨa,","poem":1},{"text":"xekeneuta'iwau huye meripai mieme hepaɨtsita.","poem":2},{"text":"Xekeneuta'iwau huye 'aixɨa mɨ'ane hepaɨtsita,","poem":1},{"text":"hikɨ mɨkɨ xepɨka'uku'e'eiriwani.","poem":2},{"lineBreak":true},{"text":"Mɨpaɨ xepɨte'ikaxeiya 'uxipiya xemuku'eriwa.","poem":2},{"text":"Peru mɨkɨ mɨpaɨ mekaniutiyuani:","poem":1},{"text":"“Hawaikɨ tepɨka'enukuweiya”.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ne kuyaxi tehɨwemete nepuwaru'uitua xehetsiemieme, hikɨ mɨpaɨ neputayɨ:","poem":1},{"text":"“Xekeneta'enanaka 'awa petayuani”.","poem":2},{"text":"Mɨkɨ mɨpaɨ mekaniutiyuani:","poem":1},{"text":"“Tame tepɨkata'enanaka”.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"'Ayumieme, nuiwarite xekeneu'enana.","poem":1},{"text":"Xepɨtehetimani tita neteɨterima wahetsie mɨtinuani.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Neuxei, kwiepa xemɨtama naitsarie xekeneu'enana:","poem":1},{"lineBreak":true},{"text":"'Ikɨ teɨteri wahetsie 'uximatɨarika nepɨ'atɨani,","poem":1},{"text":"ke'axamemɨteyɨkɨhɨawekaikɨ xeikɨa,","poem":2},{"text":"neniuki memɨka'u'enikɨ,","poem":1},{"text":"matsi ne'ɨkitɨarika mepehɨa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"¿Titakɨ nereiyehɨwa 'ikɨ 'ɨkwa Tsawa manetɨarie,","poem":1},{"text":"meta 'ikɨ 'uwá makaka xeime kwieyaritsie 'ateewa paitɨ manetɨarie?","poem":2},{"text":"Wamawari taiyariyari pɨkanetsinake,","poem":1},{"text":"wamawarika pɨkanetsinake».","poem":2}]},{"type":"verse","number":21,"content":["'Ayumieme, Yawé mɨpaɨ kanaineni:",{"text":"«'Ikɨ teɨteri wahuyeta nepɨtiu'uitɨani.","poem":1},{"text":"Wapaapama meta waniwema 'ukitsi mana mepekaxɨrieni,","poem":2},{"lineBreak":true},{"text":"wa'aurie memɨtitei meta hamikutsixi mepɨkwini».","poem":2}]},{"type":"verse","number":22,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«Neuxei. Tayeta kuyaxi mepayehu,","poem":1},{"text":"xewitɨ nuiwari mariwetɨ puyukuha'aritɨwa","poem":2},{"lineBreak":true},{"text":"kwie manu'axetsie paitɨ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Tupi mepu'ɨ meta pitsika,","poem":1},{"text":"mepayu'eririya meta mepɨkateyukanenimaya.","poem":2},{"text":"Wahiwari haramara hepaɨ pɨtiyu'eniɨriɨkɨ,","poem":1},{"text":"meta kawayutsixi wahetsie meputei.","poem":2},{"text":"Tsiyuni niweya witsipemɨti'ɨimari, 'ahetsɨa mepɨta'erie,","poem":1},{"text":"meyuha'aritɨatɨ memɨyutakwinikɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"'Ari tepɨtemarie,","poem":1},{"text":"meta tamamate pɨtiweranare,","poem":2},{"text":"hiwerika pɨtatsikema,","poem":1},{"text":"kemɨtiukakukuine niweyame mɨpaɨ tepɨte'uka'eniwa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"'Akanamieni mɨtatsi'aye'unie 'ixipara hakwetɨ.","poem":1},{"text":"Yeuta xepɨka'ayekɨkani,","poem":2},{"lineBreak":true},{"text":"meta huyeta xepɨkaheu'uwani.","poem":2},{"lineBreak":true},{"text":"Naitsarie marika puxuawe.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hiwerika kamixayari kenanakatɨki, nekiekari,","poem":1},{"text":"naxipa keneutikurupi.","poem":2},{"text":"Hatsiwimekɨ keneutatsuakani,","poem":1},{"text":"'aniwe mexɨakame hetsiemieme kepemuyɨwe hepaɨ xɨka 'umɨni,","poem":2},{"text":"karikɨ pɨkatatimaritɨani","poem":1},{"text":"mɨtatsika'una 'umamie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"«'Ekɨ Keremiyaxi ne nekiekaritsie nepɨmatsi'anukake,","poem":1},{"text":"wa'inɨnɨatamekɨ nekamananayexeiya xɨka 'aixɨa 'aneni meta nenieremekɨ,","poem":2},{"text":"pemɨretimanikɨ meta","poem":1},{"text":"pemitixeiyaxɨanikɨ kememɨte'u'uwa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Yunaitɨ mɨkɨ te'ayuye'uniekate mepɨhɨkɨ,","poem":1},{"text":"'axaniukikɨ xeikɨa memuku'uwa,","poem":2},{"text":"yunaitɨ mɨkɨ wurunitse mepɨhɨkɨ meta tepɨa,","poem":1},{"text":"'axa'anemekɨ memɨwewiya.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"'Eka yɨtɨrɨkariyakɨ tai kananutihɨtsiwani,","poem":1},{"text":"tepɨa purumu tai pikwaniyawe,","poem":2},{"text":"peru 'axamemɨte'u'iyari 'aixɨa mepɨkayuyurinɨa,","poem":1},{"text":"tixaɨtɨ pɨkarayeika tsepa mu'itiya.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"'Ayumieme mɨpaɨ mepɨte'uterɨwarɨwa “Pɨrata manuyewiwiya”:","poem":1},{"text":"Yawé hetsiemieme mekananuyewiwiyani».","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Te'aitamete meta yukuyaximapanuyɨne.","reference":{"chapter":6,"verse":3}}]},"thisChapterLink":"/api/hch_wb2/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JER/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JER/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}