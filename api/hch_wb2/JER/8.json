{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JER","translationId":"hch_wb2","name":"Keremiyaxi","commonName":"Keremiyaxi","title":"Keremiyaxi","order":24,"numberOfChapters":52,"sha256":"771a2352ddb97ef3895e81db88d089eedf1f7c4caac6b2b7f4b4d6b3602b468f","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/hch_wb2/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["»Yawé mɨpaɨ kanaineni: “'Iya tukaritsie te'aitamete wa'umete pɨwatixɨriyani meta Kura kiekatari wahetsiemieme memanuyetekai, meta mawari wewiwamete meta Kakaɨyari niukametemama, metatsiere Kerutsareme kiekatari wa'umete."]},{"type":"verse","number":2,"content":["Tau hɨxie tiheitɨ kanayeimɨkɨ meta metseri hɨxie, meta yunaime xurawetsixi muyuawitsie miemete wahɨxie, mɨkɨ muyuawitsie miemete memɨwanaki'eriekai, memɨwarayexeiyakai memuwaruweiyakai meta memɨwarahɨawekai. Wa'umete pɨkaku'ɨiyani meta pɨkakateukieni, kwitarai hepaɨ kwiepa puyuhayewa."]},{"type":"verse","number":3,"content":["Naitsarie kwiepa hakewa nemɨwareutanɨ'axɨa memutawikwei 'ikɨ nuiwaritsie miemete 'axamemɨte'u'iyari, kemɨ'ane memuyuhayewa memɨkwinikɨ mepuyuwaɨriyani matsi memayeyuyurinikɨ pɨkatixaɨ. Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye”."]},{"type":"heading","content":["'Axamɨti'ane meta 'uximatɨarika"]},{"type":"verse","number":4,"content":["»Peru 'ekɨ mɨpaɨ ketiniwarayehɨtɨa ne Yawé mɨpaɨ nemainekɨ:",{"text":"»“Kepauka teɨteri memekaxɨrɨwe,","poem":1},{"text":"¿kamɨtsɨ mekate'anuku'uwe?","poem":2},{"text":"Kepauka xewitɨ yuhuyeta 'umietɨ meuyeweni,","poem":1},{"text":"¿kamɨtsɨ karanuani yuhuyeta?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"¿Titayari kamɨtsɨ 'ikɨ teɨteri humete'uyunixɨ?","poem":1},{"text":"¿Titayari Kerutsareme 'uyupataka katiyuwaɨriya munuanikɨ tawari?","poem":2},{"text":"'Itarika mepɨkataunie,","poem":1},{"text":"meta mepɨkayuwaɨriya nehetsɨa memɨ'axɨanikɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kwi yemekɨ nepu'enaxɨ,","poem":1},{"text":"nemi'enienikɨ tsikere xeime heitserie tikuxatame,","poem":2},{"text":"peru xewitɨ pɨkatihayewawe ke'axamɨtiuyuri,","poem":1},{"text":"xewitɨ tɨma pɨka'ixeɨmate kename 'axatiyuriene.","poem":2},{"text":"Yunaitɨ yamepɨteyurie kemɨtiwanake,","poem":1},{"text":"kawayutsixi memɨkayuwiyanɨa wahepaɨ kepauka memɨyutakwinitsie.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wikixitɨtɨ muyuawitsie memu'uwa","poem":1},{"text":"mepɨtemate xeiwiyaritsie watukari kemɨraye'axe,","poem":2},{"text":"Kukuru meuyɨwi meta 'itsitame meta waurai","poem":1},{"text":"mepɨtemate kepauka xaɨtsie pɨta memɨyehu.","poem":2},{"text":"Peru neteɨterima mepɨka'imate","poem":1},{"text":"Yawé 'aitsikateya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"»”Mepɨka'uyukatetewiya mɨpaɨ meputiyuane:","poem":1},{"text":"‘Tepɨtemaiwawe, Yawé 'inɨari niukiyari 'ipaɨ paine’,","poem":2},{"text":"matsi te'utɨwamete wa'anɨ","poem":1},{"text":"yɨkɨ katini'utɨani.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Memɨtemaiwawe mepɨtewiyarikatsitɨarieni,","poem":1},{"text":"mepɨtiwiyarieni mepɨteka'eniexɨani.","poem":2},{"text":"Xɨka me'iku'eirieni Yawé niukieya,","poem":1},{"text":"¿ketitakɨ metemaiwawetɨ metehakɨne?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Ayumieme wa'ɨitama hipame 'ukitsi nepɨwayetuirieni,","poem":1},{"text":"meta wakwie hipame pɨta nepɨwayetuirieni.","poem":2},{"text":"Karikɨ 'etsimeyumatetɨ meta 'ameyumatetɨ,","poem":1},{"text":"yunaitɨ mepɨtehiwe'erie mɨkatiwapiini,","poem":2},{"text":"Kakaɨyari niukametemama meta mawari wewiwamete,","poem":1},{"text":"yunaitɨ mekateni'itawani.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Neniwe 'uka witsimɨti'ɨimari mepi'uayema herie miemekɨ xeikɨa,","poem":1},{"text":"meta mɨpaɨ mepɨte'ikɨhɨawe: ‘Kayuwatɨ puma, kayuwatɨ puma’,","poem":2},{"lineBreak":true},{"text":"'aixɨtsɨ kayuwatɨ mɨka'umatsie.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"¿Kamɨtsɨ mete'uyutitetewiyaxɨ","poem":1},{"text":"kemɨtixani'eriwakɨ yamete'uyurieka?","poem":2},{"text":"Hawaikɨ, tixaɨtɨkɨ mepɨkateyutitetewiyawawe,","poem":1},{"text":"mepɨka'imate paitɨ tita mɨtitewiyarika.","poem":2},{"text":"'Ayumieme, mepatixɨrieni kemɨ'ane mematixɨriyani wahamatɨa,","poem":1},{"text":"kepauka 'uximatɨarika wahetsie nemɨkawiwieni","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"»Yawé mɨpaɨ kanaineni:","poem":1},{"text":"“Kepauka kaxie nemeu'inɨimɨkɨ","poem":2},{"text":"tixaɨtɨ nepɨkatiukaxexeiya,","poem":1},{"text":"meta piní hetsie 'ikwaxi pɨkaheukatei,","poem":2},{"lineBreak":true},{"text":"xawariyari pɨyɨyɨna.","poem":2},{"text":"Kamɨtsɨ, hikɨ ne nepɨtixenawairieni","poem":1},{"text":"tita nemɨtixeyetuiri”».","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«¿Keteteyurie 'ena tetitetɨ?","poem":1},{"text":"Hikɨmɨtɨka, teyunaitɨ kiekari kuraruyari 'amatitetewatsie tepɨyehu","poem":2},{"lineBreak":true},{"text":"mana temekwinikɨ.","poem":2},{"text":"Yawé takakaɨyari pɨtatsikwine.","poem":1},{"text":"Haa pɨtatsi'uharitɨa 'uayemakame,","poem":2},{"lineBreak":true},{"text":"'axatemɨte'uyurikɨ hepaɨtsitana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tepɨta'ikwewakai kayuwatɨ temu'uwanikɨ,","poem":1},{"text":"peru 'aixɨa ti'anetɨ pɨkatinua.","poem":2},{"text":"Tekatekukuyetɨ temu'uwanikɨ tepɨta'ikwewakai,","poem":1},{"text":"peru matsi pɨta punua marika.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Rani kiekariyaritsie pa'eniɨriɨkɨ","poem":1},{"text":"kawayutsixi wapuxerikayari,","poem":2},{"text":"meta kepauka memetitsuana,","poem":1},{"text":"naitɨ kwie puwatayuane.","poem":2},{"text":"'Ikɨ kwieyari meka'unake 'umekanahuni,","poem":1},{"text":"meta naime tita mana mɨtixuawe,","poem":2},{"lineBreak":true},{"text":"kiekari meta mana kiekatari».","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«Xekeneunenieri. Kuuterixi xehetsɨa nepɨwareutaxɨrɨwa","poem":1},{"text":"kuuterixi memɨmɨya memɨxetikeni,","poem":2},{"lineBreak":true},{"text":"meta mɨkɨ wahepaɨtsita tiuyemaitɨ xewitɨ pumawe»,","poem":2},"Yawé mɨpaɨ kanaineni."]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Nekukuiniriya pɨkayunɨtɨarinɨa,","poem":1},{"text":"ne'iyari pɨmɨxime.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Neteɨterima waniwe 'uka hiwarieya pa'eniɨriɨkɨ","poem":1},{"text":"'ikɨ kwieyari manuye'atɨkatsie paitɨ:","poem":2},{"text":"«¿Tamɨ Yawé Tsiyuni katitikie?","poem":1},{"text":"¿Tamɨ mana kati'aita?»","poem":2},{"lineBreak":true},{"text":"«Yukakaɨyarixikɨ memɨnetsi'uyehaxɨatɨakɨ,","poem":1},{"text":"kakaɨyarixi tixaɨtɨ memɨkateyunaki'erie meta memɨkawamatekɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«'Itsanari kananutiyani, witari kananuyeyani,","poem":1},{"text":"peru tame 'akuxi tepɨkatawikweitsitɨariewawe».","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Neteɨterima waniwe 'uka mɨtiukwinitɨariekɨ neta nepɨtiukakukuine,","poem":1},{"text":"nepɨnehiwerie, netari nepeuma.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"¿Kamɨtsɨ Karaha tiumaweri waritsamu?","poem":1},{"text":"¿Kamɨtsɨ manari tiumawe tiyu'uayemawame?","poem":2},{"text":"¿Titayari neteɨterima 'aixɨa","poem":1},{"text":"mekateka'eriwawe?","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JER/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JER/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JER/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}