{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JER","translationId":"hch_wb2","name":"Keremiyaxi","commonName":"Keremiyaxi","title":"Keremiyaxi","order":24,"numberOfChapters":52,"sha256":"771a2352ddb97ef3895e81db88d089eedf1f7c4caac6b2b7f4b4d6b3602b468f","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/hch_wb2/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":[{"text":"Nemu'u haixa xɨka hɨkɨtɨnike,","poem":1},{"text":"meta nehɨxite 'ukai haixayari,","poem":2},{"text":"tukarikɨ meta tɨkarikɨ nemutsuanenikɨ,","poem":1},{"text":"neniwe 'uka teɨterimama memukwi'iwaxɨkɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Makumawetsietɨ kii nemɨnexeiyani","poem":1},{"text":"huye tetsita.","poem":2},{"text":"Neteɨterima nepuwaruku'eiriwe,","poem":1},{"text":"'ateewa nepeyeiwe.","poem":2},{"text":"Yunaitɨ mɨkɨ hipame wa'ɨitama memɨwakumaɨwa mepɨhɨkɨ,","poem":1},{"text":"yunaitɨ mepɨnetsi'uku'eiri hipame mepɨwaranukuwei.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"«Waneni 'itarikakɨ pɨtikuxata xeikɨa 'ɨrɨ tupitsie waɨkawamekɨ mɨtiutamɨni hepaɨ,","poem":1},{"text":"'ikɨ kwieyaritsie 'itarika pɨrayu'iwa, tita yuri mɨraine pɨkatixaɨ,","poem":2},{"text":"'axa'anemetsie meyuka'uitɨwatɨ matsi kwinimieme mekateniyurieka ne mepɨkanetsimate","poem":1},"—Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":4,"content":[{"text":"Xekeneyu'ɨwiyani tsepa mɨ'ahamiku,","poem":1},{"text":"yu'iwama yuri xepɨkatewa'eririeka,","poem":2},{"text":"tsepa mɨra'iwa mepɨteyu'itaiya,","poem":1},{"text":"metatsiere hamiku pɨtiuyukananaima.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yunaitɨ mepɨteyu'itaiyatɨwe,","poem":1},{"text":"yurikɨ mepɨkateyukuxaxatɨwa.","poem":2},{"text":"Yuneni mepɨte'uta'ɨkitɨa mɨti'itawanikɨ,","poem":1},{"text":"meta 'axamepɨteyurie kepaukake memɨti'uxe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"»Keremiyaxi, 'ekɨ memɨte'itawa watsata pekaniuyeikani,","poem":1},{"text":"yu'itarikakɨ mepɨkayuwaɨriya memɨnetsihetimanikɨ»,","poem":2},"Yawé mɨpaɨ kanaineni."]},{"type":"verse","number":7,"content":["'Ayumieme, mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye:",{"text":"«Ne 'aixɨa nekanixetiyurimɨkɨ, nekanixeta'inɨatamɨkɨ.","poem":1},{"text":"¿Ketawari netiyurieni neteɨterima wahetsiemieme?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Waneni 'ɨrɨ hepaɨ pɨ'anene pɨmɨya,","poem":1},{"text":"wateni 'itarika xeikɨa pɨmate,","poem":2},{"text":"'aixɨa mepɨtekuxata yuhamikuma wahamatɨa,","poem":1},{"text":"peru yutaɨta mewawiniyatɨwetɨ».","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yawé mɨpaɨ kanaineni:","poem":1},{"text":"«¿Kareuyewetse mɨkɨkɨ ne nemɨtixekwinitɨani?","poem":2},{"text":"¿Kareuyewetse teɨteri mɨpaɨ nemɨtiwarakapitɨanikɨ kememɨte'uyurikɨ?»","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nekanititsuamɨkɨ meta ne'uta'aiwatɨ hɨritsie,","poem":1},{"text":"makuweritsie makumawetsie hiwerika kwikariyari nekaniutakwikamɨkɨ,","poem":2},{"lineBreak":true},{"text":"makumawe mɨhɨkɨkɨ:","poem":2},{"text":"yuxewitɨri mana pɨka'uyeika","poem":1},{"text":"tewaxi watsuari pɨka'enierieri.","poem":2},{"text":"Wikixitɨtɨ metatsiere yeutari,","poem":1},{"text":"yunaitɨ mepɨteheuyuta'unaxɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Kiekari Kerutsareme kii 'unimeyari kwinienetɨ muwe nepayeitɨani,","poem":1},{"text":"yawixi memayu'eririya wakie nepayeitɨani.","poem":2},{"text":"Makumawe nepayeitɨani Kura kiekariteyari,","poem":1},{"text":"teɨteri mana mekatiteme nepayeitɨani».","poem":2}]},{"type":"verse","number":12,"content":["¿Kemɨ'ane kwinimieme pɨtimaiwe 'ikɨ metimaitɨyanikɨ? ¿Kemɨ'ane Yawé pitahɨawixɨ, 'ikɨ naime hepaɨtsita mɨtitaxatakɨ? ¿Titayari 'ikɨ kwieyari tiuka'unarie, yuxaɨta tikuma makumawe hepaɨ xewitɨ mana mɨka'uyeyeikanikɨ?"]},{"type":"verse","number":13,"content":["Yawé mɨpaɨ kanaineni: «Mɨkɨ ne'inɨari niukiyari mepuku'eiri nemɨwayetuiri, mepɨkanetsi'anu'eni meta mɨpaɨ mepɨkate'u'uwakai."]},{"type":"verse","number":14,"content":["Yu'iyari mɨkaheu'ena mepanukuwei, Wahari kakaɨyarixiyarite mepɨwaranukuwei, wa'ukiyarima kememɨtewaru'ɨkitɨa»."]},{"type":"verse","number":15,"content":["'Ayumieme, mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye, 'Ixaheri Kakaɨyarieya: «'Ikɨ teɨteri 'ikwai hatsiwime neniwatimimɨkɨ meta haa 'uayemakame neniwatiharitɨamɨkɨ."]},{"type":"verse","number":16,"content":["Naitsarie nuiwarite watsata nepɨwataxɨriexɨani teɨteri memɨkawamate meta watutsima memɨkawaretima wahetsɨa, nepɨwaranukuweiya 'ixiparakɨ kepaukake yunaime nemɨwakwini»."]},{"type":"line_break"},{"type":"verse","number":17,"content":["Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye:",{"text":"«Kayuwatɨ xekeneu'enana. 'Ukarawetsixi tsuakamete xekeniwarutahɨawi.","poem":1},{"text":"Kwinie memɨteheutatsuawawe meke'u'axɨani.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Xeiya meke'u'axɨani,","poem":1},{"text":"tahetsiemieme meke'utitsuanani.","poem":2},{"text":"Tahɨxita 'ukai kanitihɨnimɨkɨ,","poem":1},{"text":"meta ta'ukai kananakaxɨrimɨkɨ,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tsiyuni paitɨ kana'eniɨriɨkɨni tsuari meta hiwerika:","poem":1},{"text":"“Tepuka'unarie,","poem":2},{"lineBreak":true},{"text":"teputewinɨarie yemekɨ.","poem":2},{"text":"Peuyewetse takwie temuku'eirienikɨ,","poem":1},{"text":"takiite naitɨ mutiuka'unariekɨ”».","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"'Ukarawetsixi, xekeneu'eni Yawé niukieya,","poem":1},{"text":"xenakate ke'i'enieni niuki tetana mieme.","poem":2},{"text":"Yuniwema 'ukari xeketenewa'ɨkitɨaka kwikari hiwerikapa mieme,","poem":1},{"text":"meta hipatɨta mekeyuti'ɨkitɨani 'ikɨ hiwerika kwikariyarikɨ:","poem":2}]},{"type":"verse","number":21,"content":[{"text":"«Mɨɨya 'ituparite 'etsimayeyeutsie nenieremeta kaneutahani,","poem":1},{"text":"taparatsiyuta kaneutahani,","poem":2},{"text":"tɨɨri kaniwarutayuniya kaye'utɨma memu'uwakai,","poem":1},{"text":"meta temari teɨteri memayukuxexeɨriwatsie memu'uwakai.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mɨkite mepeutihe hayekɨa","poem":1},{"text":"kwitarai hepaɨ mɨraka'etsitɨretsie,","poem":2},{"text":"mɨaxa hepaɨ 'ihɨayame 'utɨa mɨyehixime,","poem":1},{"text":"xewitɨ mɨka'iti'ɨwe»,","poem":2},"Yawé mɨpaɨ kanaineni."]},{"type":"verse","number":23,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«Pɨkayuta'ɨreni mɨtimaiwe mɨtimaiwekɨ,","poem":1},{"text":"meta mɨtɨrɨkaɨye yutɨrɨkariyakɨ,","poem":2},{"lineBreak":true},{"text":"meta mɨxiku mɨrexeiyakɨ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Xɨka xewitɨ yuta'ɨrimɨkɨ,","poem":1},{"text":"keyuta'ɨre mɨnetsimatekɨ","poem":2},{"text":"meta mɨpaɨ mɨretimakɨ kename ne Yawé nehɨkɨ,","poem":1},{"text":"nemɨti'uximaya kwiepa naki'eriyakɨ,","poem":2},{"text":"heitseriemekɨ meta 'aixɨa 'anemekɨ,","poem":1},{"text":"netsɨ mɨpaɨ kanetininakeni","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":25,"content":["Yawé mɨpaɨ kanaineni: «Tukari kanaye'amɨkɨ kepauka ne nemɨtiwakwinitɨani kemɨ'ane xeikɨa yuwaiyaritsie xitekiya 'inɨariyari memexeiya:"]},{"type":"verse","number":26,"content":["'Ekipitu nekatinikwinitɨamɨkɨ meta Kura, 'Erumi, 'Amuni, Muhawi, meta yunaime makumawetsie memu'uwa yumu'utsie memuyukaxika. Yunaitɨ nuiwarite xitekiya 'inɨariyari mepɨkahexeiya, peru matsi 'ixaheritsixi xitekiya 'inɨariyari yu'iyaritsie mepɨkahexeiya»."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JER/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JER/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JER/8.json","previousChapterAudioLinks":{},"numberOfVerses":26}