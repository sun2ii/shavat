{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"»Nepuwaɨripieri nepu'uxe ne'ayenieretɨ.","poem":1},{"text":"'Ayumieme nepenatituaya ne'uximatɨarika,","poem":2},{"lineBreak":true},{"text":"ne'iyaritsie 'axamɨti'ane ratsiwime nemɨrexeiya.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kakaɨyari mɨpaɨ nepɨrahɨawe: nehetsie pepɨkatiuhɨpani.","poem":1},{"text":"Tita kuta nehepaɨtsita perayexeiya yakeneutayɨki.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"¿Pemɨnetsinanaimakakɨ 'aixɨa ti'ane","poem":1},{"text":"meta 'amamakɨ pemitawewi pemɨxani'erieka","poem":2},{"text":"mexi 'aixɨa petiwaxeiya","poem":1},{"text":"'axamemɨte'u'iyari kememutekuxata yamemɨteyurienikɨ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tewi mɨmɨwe hepaɨ 'ahɨxite pɨka'anene,","poem":1},{"text":"tewi kemɨtiniere hepaɨ 'ekɨ pepɨkatiniere.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tatukari 'atukari hepaɨ pɨka'ane,","poem":1},{"text":"kepemɨreuteriwe tewi mɨpaɨ pɨkatiteriwe 'a'uyeikatɨ,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"pemɨtiwaunenikɨ titakɨ nehetsie mɨrahɨiwa","poem":1},{"text":"naime nehetsiemieme peku'iwawatɨ 'axakenemɨtiuyurikɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Ekɨ pepɨtimate nehetsie pɨkarahɨiwa,","poem":1},{"text":"'ahetsie nemuyuye'unakɨ nepɨkayɨwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"»'Ekɨ 'amamakɨ pepɨnetsi'utawewi,","poem":1},{"text":"'ekɨ yane'aneme pepɨnetsi'ayeitɨa.","poem":2},{"text":"¿Hikɨta penetikumaweriya","poem":1},{"text":"netukariri mana pe'u'atɨanike?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kena'eriwani 'ekɨ pepɨnetsi'utawewi, haxukɨ.","poem":1},{"text":"¿Hikɨta tumuanari penerayeitɨani?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Ekɨ pekatiniuyurieni retsi hepaɨ pemɨnetsiheyeuri,","poem":1},{"text":"meta pemɨnetsi'utakerɨanariyaxɨ kexiu hepaɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wai meta nawikɨ 'ekɨ pepɨnetsi'utiketɨa,","poem":1},{"text":"pepɨnetsi'utawipaxɨ ne'umete pepaukunaxɨa meta netatayari.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"'Anaki'eriyakɨ heima pepuwewi tukari pepɨnetsi'upitɨa,","poem":1},{"text":"penetsi'ɨwiyatɨ pepɨnetsiyetuiri ne'iiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"»Matsi tixaɨtɨ pepɨti'awietakai,","poem":1},{"text":"meta mɨpaɨ nepɨtimate 'ekɨ yapepɨtimaikai:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Ekɨ pepɨnetsixeiya, xɨka 'axanetiuyurieni","poem":1},{"text":"meta pepɨkanerauyehɨwirieni 'axakenemɨtiyurienitsie.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Xɨa'ui xɨka nehetsie rahɨiyaka,","poem":1},{"text":"Xɨka nehetsie karahɨiyaka nemumatsi'anutaxeiya nepɨkayɨwe.","poem":2},{"text":"Tewiyarikakɨ waɨkawa nepɨhɨne,","poem":1},{"text":"netiku'eriwatɨ kenemɨtiuka'eniwa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Xɨka ne'anukukeni, maye hepaɨ xeikɨa pepɨnetsitahupie","poem":1},{"text":"'etsiwa xeikɨa xɨka ne'ukuyuani 'atɨrɨkariya nepuku'eniwa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nehetsiemieme pepɨwahekɨata hipame hekwamekɨ memɨtetahekɨatakɨ,","poem":1},{"text":"nehetsiemiemeri 'ahaxɨa pepɨtimɨiriyarɨme.","poem":2},{"lineBreak":true},{"text":"'Akuyaxima mepɨnetsimietɨwe yameyupapaɨmetɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"»¿Titari penetiupitɨa nemɨtinuiwakɨ?","poem":1},{"text":"Nemɨniɨmɨkaitɨniri mexi xewitɨ kanetsixeiyawekai.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Matsikutari nemɨkaniuyeikanike,","poem":1},{"text":"nemɨniukateukiekaitɨni nemutinuiwaxɨtsie.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"'Imatɨrieka netukari kemɨti'inɨatsie 'ari kanaye'ani.","poem":1},{"text":"Neyutemawietɨ 'akuxi 'etsiwa 'ena nemuyeikanikɨ kenenepitɨaka","poem":2}]},{"type":"verse","number":21,"content":[{"text":"mexixi nekaheyeiwe nemɨkahanuanitsie,","poem":1},{"text":"kwie 'etsiwa makuhekɨatsie meta 'etɨpiwari hepaɨ mɨ'anetsie,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"kwiepa waɨkawa makɨyɨwitsie,","poem":1},{"text":"kwiepa meta 'etɨriya hepaɨ 'anu'atɨkaikaku meta muyuxamurietsie,","poem":2},{"lineBreak":true},{"text":"hakewa hekɨariya yɨriya hepaɨ me'anetsie».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/9.json","previousChapterAudioLinks":{},"numberOfVerses":22}