{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":11,"content":[{"type":"heading","content":["Tsupaxi matɨari kemutayɨ"]},{"type":"verse","number":1,"content":["Mɨpaɨta kaniutayɨni Tsupaxi Namati kiekame:"]},{"type":"verse","number":2,"content":[{"text":"«¿Tekate'ita'eiya mɨkɨ niuki mɨya mɨpaɨme?","poem":1},{"text":"¿'Ikɨ kwinie mɨtiyuniuwie kamɨtsɨ 'atsikatiyuruwame?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"¿Naitɨ mɨkɨ niuki mɨya mɨpaɨme teka'utiniukame tarayeitɨani?","poem":1},{"text":"Peti'ata'ɨreni xewitɨ tawari kamatsitatieyu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Ekɨ mɨpaɨ peputaine: “Ne heitseriemekɨ 'anepuyeika,","poem":1},{"text":"Kakaɨyari hɨxie ne 'axanepɨkatiyuriwe”.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kenetinakekeyu xɨka Kakaɨyari 'utaniunike,","poem":1},{"text":"'ahepaɨtsita mieme tikuxatatɨ","poem":2}]},{"type":"verse","number":6,"content":[{"text":"mɨmatsitahekɨatɨanikɨ tewi kemɨkatimaiwe,","poem":1},{"text":"mɨkɨ matsi hɨrixɨa 'ayemɨiremekɨ katinimaika.","poem":2},{"text":"Hikɨ 'ana yapepɨretimanikeyu waɨkawa 'axapetiuyuriekutɨtɨ","poem":1},{"text":"Kakaɨyari 'etsiwa xeikɨa mɨmatikwinitɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"»¿Petiyɨwekuta Kakaɨyari ketɨtɨ mɨtiyuriene pemɨretimani,","poem":1},{"text":"yatɨni Naimekɨmɨtɨrɨkaɨye heitserie kemɨrexeiya pemanuku'axe?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"¿Ke petiuyuriwe?","poem":1},{"text":"Muyuawitsie kemeutitewa matsi reuyeta kaneutitewani.","poem":2},{"text":"Kemeukatewa mɨkite memeukaxɨriwatsie matsi reuhetɨa kaneukatewani.","poem":1},{"text":"Hatsuaku mɨkɨ pepɨkaretimani.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwiepa kemakuyewa matsi reuyeta kaniyeuka,","poem":1},{"text":"naitɨ haramara kematayewa matsi reuyeta kanatayeuka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"»Xɨka nuame, metsi'anutahɨani,","poem":1},{"text":"meta metsi'uta'iwawiya kepemɨtiuyurikɨ,","poem":2},{"lineBreak":true},{"text":"¿kepaikɨ pɨyɨwe mita'imaiyakɨ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kakaɨyari pɨwamate teɨteri tewiyarika memɨkahexeiya,","poem":1},{"text":"kepauka 'axamemɨteyurie, mɨkɨ pɨkatiwareuyehɨwirie.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tewi mɨkayɨkɨhɨawe timaiwetɨ payani","poem":1},{"text":"kepauka puxu yeutanakatsie tewi mayenuiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"»Matsi xɨka 'a'iyari pe'iyetuirieni","poem":1},{"text":"meta xɨka 'amamate hetsɨana peheutatsera,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"xɨka ke'axapemɨtiuyurikɨ petiuhayewa","poem":1},{"text":"meta 'akie 'axamɨti'ane peka'upitɨani,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"hikɨ 'ana pekayutewiyatɨ pepayani","poem":1},{"text":"heitseriemekɨ pe'uyeikatɨ meta pekaheumatɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"'Aheyemekɨ pekatinatɨmaiyamɨkɨ kepemɨtiuka'eniwa,","poem":1},{"text":"yatɨni haa manuyetɨa hepaɨ xeikɨa pekatini'erimɨkɨ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"'Ana 'atukari waɨkawa hekɨatɨ payani keyuri tau tukamieme hepaɨ,","poem":1},{"text":"meta yɨriya ximeri mieme hepaɨ pɨyɨni.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"'Aixɨa 'iyari pepuyeikani, 'akuxi muxuawekɨ pemɨta'ikwewanikɨ,","poem":1},{"text":"'ahetsie nunuwame 'apuweni meta pekayu'iyaritɨatɨ pepeukukutsuni.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Pepuka'uxipiweni xeime peka'ayemakatɨ,","poem":1},{"text":"meta yumɨiretɨ mepɨ'axɨani 'ahetsɨa pemɨwaparewienikɨ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Peru 'axamemɨte'u'iyari wahɨxite kanitɨxɨamɨkɨ,","poem":1},{"text":"memɨyuta'una mepɨkayɨwekaxɨani.","poem":2},{"lineBreak":true},{"text":"Tixaɨtɨ mepɨkatetakwewie, memɨkwini tukariyari xeikɨa mepɨtakwewie».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/10.json","previousChapterAudioLinks":{},"numberOfVerses":20}