{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":12,"content":[{"type":"heading","content":["Kuwi naurieka kemutayɨ"]},{"type":"verse","number":1,"content":["Mɨkɨ hepaɨtsita Kuwi mɨpaɨ katinita'eiya:"]},{"type":"verse","number":2,"content":[{"text":"«Xeme xɨari kiekari xemanukuhana xepɨhɨkɨ.","poem":1},{"text":"Kepauka xeme xemɨkwini, timaiwetɨ xewitɨ pumaweni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Neta xehepaɨ nekatinimaiweni,","poem":1},{"text":"xeme xeikɨa waɨkawa xete'uyemaikame xepɨkayu'erieka.","poem":2},{"lineBreak":true},{"text":"Neta mɨkɨ tinaime nekatinakumaika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"»Ne, Kakaɨyari nepɨkɨhɨawekai mɨkɨta pɨnetsiku'eiyakai,","poem":1},{"text":"hikɨri nehamikuma netsi'atsemete memɨhɨkɨtɨnikɨ nepayuyeitɨa,","poem":2},{"lineBreak":true},{"text":"ne 'atsieriwame nepɨhɨkɨ, heitserie nemexeiya nehetsie mɨkarahɨiwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Teɨteri 'aixɨa 'iyari memeutitei mɨpaɨ meputiyuane:","poem":1},{"text":"“Kemɨ'ane mɨtiukwinitɨarie tawari peuyewetse waɨkawa mɨnɨitɨarienikɨ”,","poem":2},{"lineBreak":true},{"text":"“Kemɨ'ane matiwexime, pauyewetse matitaimarieni”.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tenawayamete 'aixɨa 'iyari yukie mepeutitei,","poem":1},{"text":"'aixɨa 'iyari mepu'uwa Kakaɨyari memɨhaxɨatɨa","poem":2},{"lineBreak":true},{"text":"mɨpaɨri mepɨteku'eriwa me'ikemakame meyu'erietɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"»Matsi tewaxi yeutari keniwaruta'iwawiya,","poem":1},{"text":"mɨkɨ mekamenayehɨtɨakuni,","poem":2},{"text":"wikixi memawɨwawe keniwaruta'iwawiya,","poem":1},{"text":"mɨkɨ mepɨmatetaxatɨani,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"kwie matɨa ketineutaxata, mɨkɨ pɨmatita'ɨkitɨani,","poem":1},{"text":"ketsɨte haramaratsie memɨye'uwa wahamatɨa ketineutaxata, mɨkɨ mepɨmatsi'aye'eritɨani.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mɨkɨ yunaitɨ mɨpaɨ mepɨtemate","poem":1},{"text":"Yawé muwarunetɨakɨ yɨtɨrɨkariyakɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Teyunaitɨ temayeyuyuri mɨkɨ tɨrɨkariyayatsie tetewiyatɨ tepɨte'ane,","poem":1},{"text":"meta teyunaime ta'iiya pɨtatsipitɨa temɨtɨrɨkawinikɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Naka niuki kani'enieka 'i'inɨatatɨ kemanɨyɨne","poem":1},{"text":"neni 'ikwai kemɨra'inɨnɨata hepaɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mɨtimaiwenikɨ mɨ'ayumieme 'ukirawetsixi wahetsie kanixuaweni,","poem":1},{"text":"meta mɨixa wiyari 'uyeikatɨ peiti'enietɨyani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"»Kakaɨyari hetsɨa puxuawe mɨtimaiwenikɨ mɨ'ayumieme meta tɨrɨkariya,","poem":1},{"text":"'ɨxatsi meta meiti'enietɨyani mɨkɨ pɨtipiinieya.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tita mɨkɨ mɨtika'una, xewitɨ pɨka'enukuketɨani,","poem":1},{"text":"kemɨ'ane manutahɨani, xewitɨ pɨkayɨwe mɨwayexɨna.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Xɨka mɨkɨ wiyeri kaheyenɨ'ani, pɨtitiwauke,","poem":1},{"text":"xɨka 'i'eirieni tsepa muwiye, naitɨ kwie pukayuyuipike.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tɨrɨkariya hetsɨana kanimiemetɨni meta ke'aixɨa mɨti'aitakɨ,","poem":1},{"text":"memukwamanarie meta memɨteyukwamana kaniwakemaka.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Teɨteri 'ɨxatsitamete puwatewiyatsitɨa mekaheukemaritɨkaime pɨwarayeitɨa","poem":1},{"text":"meta 'itsɨkate mekatemaiwaweme kaniwarayeitɨwani.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Te'aitamete wa'itsɨ pɨwakunawairiwa puwaranakaxɨrɨwa,","poem":1},{"text":"waɨriyarika te'uximayatamete wahepaɨ me'aneneme puwarayeitɨwa hanika meheukaweratɨkaime.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mawari wewiwamete pɨwatewiyatsitɨa meka'ukakaikame pɨwarayeitɨa,","poem":1},{"text":"meta waɨkawa memeuka'u puwaratixɨrɨwa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"'Ɨxatsitamete watenitsie muwiere pɨyɨwe","poem":1},{"text":"meta 'ukirawetsixi mekatemaiwaweme muwarayeitɨani.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Memeu'enieriekai 'aixɨa mekatexeiyariekame puwarayeitɨwa,","poem":1},{"text":"meta memeuka'u titatsie memɨteyukɨtɨrɨkariya puwakunawairiwa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Pɨtikuhekɨata tsepa yɨriya taɨta timieme,","poem":1},{"text":"hekɨaripa pɨti'atɨwa waɨkawa yɨwipa timieme.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nuiwarite memamariwaweme puwarayeitɨwa yatɨni puwaka'una,","poem":1},{"text":"metehexeiyame puwarayeitɨwa yatɨni naitsarie puwataxɨrɨwa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kiekaritsie memanuyetei mekatemaiwaweme puwarayeitɨwa,","poem":1},{"text":"makumawetsie hau'erietɨ meku'uwame puwarayeitɨwa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yɨwipa mekaniu'uwani mete'anawiwiyatɨ,","poem":1},{"text":"meta mepɨtakeitsarietɨkɨka tarɨwekarixi wahepaɨ.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/11.json","previousChapterAudioLinks":{},"numberOfVerses":25}