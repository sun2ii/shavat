{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"»Naime mɨkɨ nehɨxikɨ nekatiniuxeiya,","poem":1},{"text":"nekatiniu'enieni meta nekatinetimaitɨyani.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Neta waɨkawa nekatiniuyemaika xehepaɨ,","poem":1},{"text":"xeme xeikɨa waɨkawa xete'uyemaikame xepuyu'erie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Matsi yemekɨ nepɨtixatamɨkɨ pɨta Naimekɨmɨtɨrɨkaɨye hamatɨa,","poem":1},{"text":"pɨnetsinake nemɨtitixatakɨ Kakaɨyari hamatɨa ketitayari nemɨti'ane.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Xeme matsi netsikwamanamete xekaniyɨaka,","poem":1},{"text":"teyu'uayemawamete tixaɨtɨ memɨkateyunaki'erie xepɨhɨkɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xɨka xetehayewanike xe'utiniutɨ.","poem":1},{"text":"Mɨkɨri mɨpaɨ pɨtimatsiɨkɨnikeyu kename xetemaiwawe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hikɨta ne xepɨnetsi'enieni,","poem":1},{"text":"kwi xekeneu'eni kenemɨtayɨni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"¿Kakaɨyari hepaɨtsita xemɨte'u'itani xeteyuwaɨririya?","poem":1},{"text":"¿Hetsienamieme kwamanarikakɨ xetekuxatatɨ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"¿Xe'iparewiekame xeteyu'erie?","poem":1},{"text":"¿Xemeri hetsiena miemete niukametemama xete'ayuyeitɨwa?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"¿Xɨka mɨkɨ xeheutixeiyaxɨani ketiɨyɨwe?","poem":1},{"text":"¿Xete'ikwamanawawe teɨteri kememɨte'ayukwamana wahepaɨ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kanahekɨaka matsi mɨkɨ pɨta kanixe'utatieweni","poem":1},{"text":"xɨka xeme xete'itawatɨ hetsiena mieme xeyuhekɨatani.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"¿Kamɨtsɨ xekate'itimakawawe xawatɨriyaya?","poem":1},{"text":"¿Xehetsie katiukawewe mariutsikaya?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yakɨ xeikɨa kememɨtekuxatakɨ naxi hepaɨ pɨtiyumatsiɨkɨ,","poem":1},{"text":"yuheima nunuwame haxukɨ muwewiya mɨtariwe hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"»Xeketeneuhayewa xe'utiniutɨ xekeneneupitɨa nemɨtaniunikɨ,","poem":1},{"text":"yaketiuyɨni kenemɨyɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"¿Titayari kwinie 'anekɨa netiyukakeka,","poem":1},{"text":"meta netukari netitatuaka?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tsepa mɨnetiumi. Ne hetsiena nepɨtitakwewie.","poem":1},{"noteId":1},{"text":"Matsi hɨxiena kenemɨtiuyeikakɨ yanepɨtayɨni.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mɨkɨ pɨhɨkɨ mɨnetsitawikweitsitɨani:","poem":1},{"text":"metsɨ xewitɨ Kayaɨyari mɨka'ayexeiya pɨkayɨwe hɨxiena mɨtakeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"»Neniuki xekeneu'eni,","poem":1},{"text":"kenemɨtayɨni xekeneu'enana:","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Neuxei neheima kenemɨtitanuani 'aixɨa nekatiniuyurieniri,","poem":1},{"text":"mɨpaɨ nepɨtimateri nehetsie pɨkarahɨiyani.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"¿Xewitɨ nehetsie mɨrahɨani tiyɨwe?","poem":1},{"text":"Xɨka xewitɨ yɨweni, tawariri nepɨkataniuni kepaukakeri nemɨmɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"»Kakaɨyari, tihutame xeikɨa nemumatiwawirie kenetineupitɨa,","poem":1},{"text":"hikɨ 'ana 'ahɨxie nepɨkaneti'awieta:","poem":2}]},{"type":"verse","number":21,"content":[{"text":"'Ariri pepɨkanetikwinitɨaka","poem":1},{"text":"meta keneneuhayewa penetsimariutatɨ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nemɨnetahekɨatakɨ keneneutahɨawi, nepɨmatsita'eiya,","poem":1},{"text":"yatɨni keneneupitɨa nemɨtaniunikɨ, 'ekɨta keneneuta'eiya.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kepaɨmexɨa 'axanemɨtiuyuri keneuti'inɨata,","poem":1},{"text":"yakenetineuxeitsitɨa 'inɨari kenemɨreutitsanaxɨa meta ke'axanemutayɨkɨ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"¿Ketitayari pekanetixeiyamɨkɨ?","poem":1},{"text":"¿Ketitayari nemɨmatsi'aye'unieka hepaɨ petiyɨane?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"¿Xatsi 'u'enirɨmeme pe'utimariutame petitatemɨxikita?","poem":1},{"text":"¿Kuxari peranukuweiya?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nehetsiemieme pepɨraka'utɨa hatsiwimekɨ,","poem":1},{"text":"temaikɨyari paitɨ ke'axanemɨtiuyurikɨ, mɨkɨkɨ pepɨnetiuka'enitsitɨwa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ne'ɨkatetsie tepɨa karenayarikɨ pepɨnetsi'akuwie,","poem":1},{"text":"kenemɨtiuyeikakɨ pepɨnetsikuxeiyane xeikɨa,","poem":2},{"lineBreak":true},{"text":"neketa xeikɨa pepu'iyeikene kenemɨtikuyeika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"»Nawi winu makatuarike mɨtaxɨxime hepaɨ tewi pɨ'ane,","poem":1},{"text":"kamixa tepaxi memitakwai hepaɨ pɨ'ane.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":1,"caller":"+","text":"Yatɨni: Kenetsi'umieni. Tixaɨtɨri nepɨkatitakwewie.","reference":{"chapter":13,"verse":15}}]},"thisChapterLink":"/api/hch_wb2/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}