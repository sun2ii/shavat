{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"»Tukari 'etsipɨpaɨme, timɨireta 'uximatɨarika,","poem":1},{"text":"tewi 'ukaratsitsie mɨyenuiwaxɨ meixeiya.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tuturite hepaɨ kani'aneni, mɨkɨ mɨtineika kwitɨwata kanitiwaukeni,","poem":1},{"text":"'etɨriya 'akareuteteretɨ kemɨtiyukupata hepaɨ pɨ'ane.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"¿Xeime mɨpaɨ 'aneme hetsieta pereutaniere?","poem":1},{"text":"¿Xeimeta nehepaɨ petiuta'iwawiyawe?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"¿Kemɨ'ane pɨyɨwe mɨkati'itiya ti'itiyakame mɨrayeitɨani?","poem":1},{"text":"xewitɨ pumawe mɨpaɨ mɨtiyurieni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tewi tukarieya 'ari puti'inɨatsie,","poem":1},{"text":"'ekɨ 'ari yapeputayɨ kepaɨmeme metseriyari 'amuyeikani,","poem":2},{"lineBreak":true},{"text":"'inɨariyari 'apepuyete mana manutiyani pɨkayɨwe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Keneuhayewa pe'ixeiyatɨ, keneuhayewa kayuwatɨ 'amuyeikanikɨ,","poem":1},{"text":"yutukaritsie yutitemawieyuke yu'iwarikakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"»Xɨka kɨye hawitekieni,","poem":1},{"text":"pɨyɨwe mayɨraxɨanikɨ","poem":2},{"lineBreak":true},{"text":"meta mayɨraxɨani pɨkatiyɨnare.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Xɨka mɨkɨ nanayarieya 'ukirawetsixi 'akɨne kwiepa","poem":1},{"text":"meta mɨkɨ kɨtsunuyari 'umɨni yukwiepa,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"matsi kepauka haa hetsiena mɨye'ani kanitaxutuimɨkɨ,","poem":1},{"text":"'iteɨri hekwamekɨ muka'iteɨtsie hepaɨ kanikayɨramɨkɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Matsi tewi, pɨmɨwe meta yɨtɨrɨkariya peuyehɨpa,","poem":1},{"text":"yu'iiya 'imatɨrieka mieme panatituaya, hikɨ 'ana pukumamawere.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Haramaratsie haa kemɨranati'eke hepaɨ,","poem":1},{"text":"meta haa 'aki 'amupapatsie kemɨrakawauke hepaɨ,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"mɨpaɨta teɨteri, kepauka kayuwatɨ memɨte'uhipite,","poem":1},{"text":"tawariri mepɨka'anuku'uwe.","poem":2},{"text":"Mexi muyuawi 'atsikayɨweni,","poem":1},{"text":"memukwi mepɨka'anuku'uni","poem":2},{"lineBreak":true},{"text":"meta mepɨka'anutaneniere mekutsutɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"»Xɨka yɨwenike mɨkite wateukiyapa pemɨneniuti'awieta","poem":1},{"text":"kepauka 'ahaxɨa manuyeyanike.","poem":2},{"text":"Tsikere yapaɨmexɨa xɨka penetsi'utipinirienike,","poem":1},{"text":"'ariketa xɨka penetsi haye'erienike.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Xɨka tewi 'umɨni, tawariri 'ayeyuritɨ pɨka'ayani.","poem":1},{"text":"Kenemɨreutere netiuka'eniwatɨ ne'uyeikatɨ","poem":2},{"lineBreak":true},{"text":"nepɨta'ikwewani kepaukake nemɨxɨnarieni.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Ekɨ pepɨnetsitahɨawe, neta nepɨmatsita'eiya,","poem":1},{"text":"pepɨnetsi xeiyamɨkɨni pemɨnetsi'utawewikɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Meta pepi'inɨatamɨkɨni kenemɨtiuyeika,","poem":1},{"text":"matsi ke'axanemɨtiuyurikɨ pepɨkahe'eriwaniri.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kuxitari 'anutawipemeta 'inɨari kenemɨreutitsanaxɨakɨ pepika'uta,","poem":1},{"text":"meta naime ke'axanemɨtuiyuri pepɨnereuyehɨwirieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"»Matsi hɨri kemɨtika'unike yapapaɨmetɨ,","poem":1},{"text":"tetexi kemɨtiyukupata makainiketsie,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"haa 'ayepari kemɨtixɨtɨa","poem":1},{"text":"meta haa mɨtɨrɨkaɨye kwie kemɨretutuwe,","poem":2},{"lineBreak":true},{"text":"mɨpaɨta 'ekɨ tewi ketita mɨtitakwewie pepɨreutiparitɨwa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"'Ekɨ naimekɨ mɨkɨ tewi pepa'iwa, mɨkɨ pukumamawere,","poem":1},{"text":"yɨkɨtiyuxexeiyame pepayeitɨwa, hikɨ 'ana pepeinɨ'awa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Xɨka niwemama 'aixɨa metehahɨawaruwani, mɨkɨ pɨkaremaika,","poem":1},{"text":"xɨka mehenanaimarieka, mɨkɨ 'atsipɨkaretimani.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yuxaɨta xeikɨa kukwiniya pe'enie yuwaiyaritsie,","poem":1},{"text":"yuxaɨta xeikɨa peyuhiwerie».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}