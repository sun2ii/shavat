{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":15,"content":[{"type":"heading","content":["'Eripaxi hutarieka kemutayɨ"]},{"type":"verse","number":1,"content":["Merikɨte 'Eripaxi Temani kiekame Kuwi mɨpaɨ katiniuta'eiya:"]},{"type":"verse","number":2,"content":[{"text":"«Mɨtimaiwe 'atsimɨkatimate hepaɨ pɨkatiyu'eiya","poem":1},{"text":"meta 'ekaniuki pɨkawewie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Meta niukikɨ yakɨ xeikɨa 'utaitɨ pɨkayumiene","poem":1},{"text":"meta niukikɨ tixaɨtɨ mɨkatiyunaki'erietɨkakɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Ekɨ matsi 'ahetsie pekanihayewani Kakaɨyari pe'ayemakatɨ,","poem":1},{"text":"meta waɨkawa peka'eyexeiyatɨ mɨkɨ kemɨtinake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Axamɨti'ane petipitɨakaku 'ateni yakatinihekɨatani,","poem":1},{"text":"yaxeikɨa pepɨtiuxaxata teyukwamanamete wahepaɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Aniukikɨ pekananuyutahɨpani, nekɨma hawaikɨ,","poem":1},{"text":"'Ateni yakatinikuxatani 'ahetsiemieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"»¿'Ekɨmerikuta tewi pemutinuiwaxɨ petihɨkɨ?","poem":1},{"text":"¿'Ekɨmerikuta petiutinuiwaxɨ yemurite kanewekaku?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"¿Petiu'enaxɨ kuta Kakaɨyari waxeɨrietɨ kemɨtiwa'ɨxatsitɨatsie?","poem":1},{"text":"¿'Ekɨxeikɨa kamɨtsɨ petiuyemate?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"¿Kepetimate 'ekɨ tame temɨkate'uyemate?","poem":1},{"text":"¿Kepereti'ena 'ekɨ tame mɨpaɨ tekate'i'eniekaku?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tame tekanimutuxatɨkani meta waɨkawa wiyari tekanexeiyatɨkani,","poem":1},{"text":"tame matsi waɨkawa tekateniuxeiya keyuri 'apaapa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"¿'A'iyaritsie pɨkareuyeyeika tsepa Kakaɨyari matsinɨtɨa","poem":1},{"text":"meta metsikɨhɨawetɨ 'aixɨa 'anemekɨ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"¿Ketitayari haxɨakɨ xeikɨa perayeika?","poem":1},{"text":"¿Ketitayari 'ahɨxitekɨ petiutimerɨka?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"¿Ketitayari Kakaɨyari hɨxie xeikɨa petiha'a","poem":1},{"text":"meta 'aneni pepɨkapirenutɨa pepitatua xeikɨa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"»¿Ketita tihɨkɨ tewi 'aixɨa 'aneme muyu'erieka,","poem":1},{"text":"meta 'uka hetsie yenuiwakatɨtɨ heitserie muyupitɨanikɨ?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Xɨka Kakaɨyari te'i'uximayatsiriwamete memɨpatsie wahetsie yuri kati'erieka,","poem":1},{"text":"meta muyuawi tɨma 'itiyakame pɨka'ayeitɨa,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ketiyɨwe matsi tewi hetsie yuri mɨte'eriekakɨ,","poem":1},{"text":"mɨxani'eriwa 'axatiyurienetɨ meta yu'iyaritsie heuharimɨkɨkaku 'axamɨti'anekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"»Keneneu'eni, kenemɨtayɨni,","poem":1},{"text":"ketita nemɨtiuxei yanepɨtayɨni,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mɨkɨ kanihɨkɨtɨni temaiwawemete memihekɨataxɨ,","poem":1},{"text":"tixaɨtɨ mekate'anukanatɨ yupaapama wahetsie tita memɨtehetima.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mɨkɨxeikɨa kwie mepɨyetuiriyarie,","poem":1},{"text":"xewitɨtɨma teewa kiekame wahixɨata pɨka'uyetɨa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kakaɨyari mɨka'ayexeiya pɨtiuka'eniwani kepaɨmexɨa muyeikani,","poem":1},{"text":"mɨkatiyukanenimaya tukarieya kaniuti'inɨatsiyarieniri.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mariutsika kani'enieka.","poem":1},{"text":"Kepauka kayuwatɨ muma, tenawayamete hetsɨana mekaniye'axeni.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Makɨyɨwitsie xɨka 'uyani pɨkahakunuani pɨtiku'eriwa,","poem":1},{"text":"'ixiparakɨ mumieriemɨkɨkɨ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hau'erietɨ pukuyeika, wirɨkɨxi puwa'ikwai xeikɨa,","poem":1},{"text":"pɨtimate hetsiena maye'aximekɨ yɨriya tukariyari.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"'Aixɨa mɨkatiyuriekɨ meta mɨtiuka'eniwakɨ marika piwewirie,","poem":1},{"text":"yumariutatɨ ti'aitame mitamierieximeni hepaɨ,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kakaɨyari mu'unikɨ heu'u'urawitɨ,","poem":1},{"text":"Naimekɨmɨtɨrɨkaɨye hepaɨtsita mariweme mayuyeitɨakɨ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Yɨkɨipi heitserie 'anukuhanatɨ Kakaɨyari mutamikɨ,","poem":1},{"text":"'atsutsuime 'a'ɨtɨ yuheima nunuwame mɨtɨrɨkawi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"»Tsepa yɨhɨxie mayewaiya wiyakɨ,","poem":1},{"text":"meta mɨranayuhayewa wai manayuhɨayatsie,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"kiɨripa kanetayerɨmɨkɨ,","poem":1},{"text":"kiita hipatɨ memɨkahayeteita,","poem":2},{"lineBreak":true},{"text":"kii matixɨriximeta.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Waɨkawa kemɨrexeiyakaikɨ katiniku'eirimɨkɨ, pɨkareutere tita mɨrexeiya","poem":1},{"text":"kemɨrexeiya kwiepa manukatsie tɨma pɨkatitaxiɨni.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Makɨyɨwitsie 'uyeikatɨ muyuta'unakɨ pɨkayɨwe,","poem":1},{"text":"yɨrarimeyari kanitayɨnarimɨkɨ tai xɨriyarikɨ","poem":2},{"lineBreak":true},{"text":"Kakaɨyari 'iiyaya kanitaxɨtsitɨamɨkɨ.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Mɨkɨ pɨkayukwamanani meta niuki yakɨ mainetsie yuri pɨkati'erieka,","poem":1},{"text":"mɨpaɨ yɨanetɨ tixaɨtɨ pɨkatiukaxeiya.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Meripaitɨ yapɨrakapitɨarieni kahaye'awekaku 'akuxi kemɨtiyurienikekaikɨ,","poem":1},{"text":"meta xawariri pɨkatitsitsiɨraxɨani.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Kaxie nanari takariyari mɨtsitsiɨrawi mɨrauyewe hepaɨ kaniyɨmɨkɨ,","poem":1},{"text":"huriwu mɨkatixuturuwe hepaɨ kaniyɨmɨkɨ.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Kakaɨyari memɨka'ayexeiya wanɨtɨ 'aixɨa mɨti'ane pɨkatiukaxeiya,","poem":1},{"text":"'itarikakɨ tumini memɨ'iwaku","poem":2},{"lineBreak":true},{"text":"wakii taikɨ kanitixɨtsitɨariemɨkɨ.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Tita mɨkatiheitserie yuhetsie mepɨpitɨa meta 'axamɨti'ane mepɨtiniweya,","poem":1},{"text":"wahetsie kwamanarika kanayeneikani memitiniweyani hepaɨ».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":35}