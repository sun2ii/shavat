{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":16,"content":[{"type":"heading","content":["'Auxɨwirieka Kuwi kemutayɨ"]},{"type":"verse","number":1,"content":["Mɨkɨ hepaɨtsita, Kuwi mɨpaɨ kaniutayɨni:"]},{"type":"verse","number":2,"content":[{"text":"«Niuki 'ipaɨ 'anuyɨtɨkaime waɨkawa nepeye'eniwari,","poem":1},{"text":"xeme matsi, xenetsinɨtɨanike xepɨnetsi'uximatɨa pɨta.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"¿Kamɨtsɨ xekatehayewa kayuwatɨ xe'umatɨ?","poem":1},{"text":"¿Ketitakɨ kuta 'axanetixematɨa xemɨnetsiye'eiyarɨmenikɨ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Netatsiere yaxeikɨa nekatinixe'utahɨawiweni","poem":1},{"text":"xɨka xeme nehepaɨ xetekukuyenike.","poem":2},{"text":"Netatsiere xehepaɨtsita kexemɨte'uka'eniwanikɨ witsi'anemekɨ yanepɨtikuxatanike,","poem":1},{"text":"nemu'u ne'uyuitɨwatɨ nexeheunanaimatɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neniukikɨ nekanixe'anutanieritɨawenike,","poem":1},{"text":"nekanixe'ɨnɨtɨanike netenikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"»Xɨka ne'utaniukani, nekukuiniya pɨka'anukanunuwa,","poem":1},{"text":"xɨka neka'utaniuni, yaxeikɨata tsiere pɨkaheunuani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yurikɨ Kakaɨyari pɨnetsi'uka'unaxɨ,","poem":1},{"text":"netɨɨriyama puwarutayuniyaxɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Pɨnetsi 'anutinama xeikɨa, nehepaɨtsita pɨtihekɨata,","poem":1},{"text":"pɨnetsi'utawatsiɨxaxɨ mɨyane'anetɨ nekɨmana xeikɨa katinikuxaxatsiwani nehetsie pɨrahɨiya yakɨxeikɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"»Ha'atɨ Kakaɨyari pɨnetsi'uweiya pɨnetsititsana,","poem":1},{"text":"nehetsiemieme yutamete putixikauteke,","poem":2},{"lineBreak":true},{"text":"mɨnetsi'aye'unie kwi pɨnetsixeiya xeikɨa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Teɨteri nehetsimieme waɨkawamekɨ mepɨnetsinanaima,","poem":1},{"text":"teyuyuriyamete ne'auritapa mepɨnetsihautiwaya,","poem":2},{"lineBreak":true},{"text":"yunaitɨ meyɨnɨtɨ nehepaɨtsita xeikɨa mepeuniuka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kakaɨyari 'axamemɨte'u'iyari wahetsɨa xeikɨa pɨnetsiyetɨa,","poem":1},{"text":"'axamemɨte'u'iyari wahetsɨa pɨnetsi heutahɨa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne 'aixɨa 'iyari nepuyeikakai, mɨkɨ pɨnetsiheutitsanaxɨa,","poem":1},{"text":"nekɨipitɨa 'awiereka pɨnetsiheutimuraxɨa,","poem":2},{"lineBreak":true},{"text":"nehetsie puyuta'iwiri mɨnetsitamienikɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tupikɨ temɨmɨmete hetsɨana miemete mepɨnetsi'anutina.","poem":1},{"text":"Mekate'uyukanenimayatɨ nemumete mekananuyexuni,","poem":2},{"lineBreak":true},{"text":"meta nenema meta netsiɨrika payewiwi kwiepapaitɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Waɨkawa pɨnetiukwinitɨa 'akuxi pɨnetikwinitɨa,","poem":1},{"text":"pɨnetsi'anukuwei yumemiwame mɨhɨkɨtɨni hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"»Newaiyari heiwerika kamixayari pɨhɨkɨ,","poem":1},{"text":"Nekana tumuanaripa peuyune.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Waɨkawa ne'utatsuatɨ nehɨxie nepayexeta,","poem":1},{"text":"tsuarikɨ nepɨwatiyɨyɨwi nehɨxitetɨa,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"matsi nemamakɨ 'axanepɨkatiuyuri nepeu'itiyatɨka,","poem":1},{"text":"kenemɨtiyunenewie pɨheitserie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"»Xɨa'ui kwie, nexuriya pepɨka'anukanarɨmani.","poem":1},{"text":"Nehiwari maununuwanikɨ pepɨka'ipitɨaka.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hikɨtɨtɨ muyuawitsie xewitɨ kanenixeiyani,","poem":1},{"text":"'ahautitewakaku neheima nunuwame kaneyeikani.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nehamiku pɨhɨkɨ nehetsiemieme metaniuni,","poem":1},{"text":"mɨkɨ hɨxie waɨka nekaniyuhiwerieka,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kakaɨyari hɨxie nehetsiemieme mɨtaniunikɨ,","poem":1},{"text":"xewitɨ yuhamikuma wahetsiemieme xeime hɨxie maniuka hepaɨ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yapaɨmexɨa wiyari xeikɨa kananukayeimɨkɨ","poem":1},{"text":"mexixi ne nekaheyeiwe nemɨkahakunuanitsie.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}