{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"»'Ariri nekanewaɨriyatɨ nepayeixime,","poem":1},{"text":"netukari pɨtixɨximeri,","poem":2},{"lineBreak":true},{"text":"nemakateukieni kanenitakwewiekari.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Netsiyuriyamete mepɨnetsi'anutinama,","poem":1},{"text":"nehɨxite pɨtiuka'eniwa netsiyuriyamete newaxeiyatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"»Xɨa'ui Kakaɨyari, nehetsie keneutanua,","poem":1},{"text":"¿Kemɨ'ane tawari pɨyɨwe neheima mɨtanuani?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Ekɨ mekaheta'eriwaweme pepɨwarayeitɨa,","poem":1},{"text":"'ayumieme pepɨkawapitɨani memɨte'ayu'iwakɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kemɨ'ane ti'iwatɨ yuhamikuma wahetsie mɨrahɨani,","poem":1},{"text":"yuniwemata kaniwaxeiyamɨkɨ mekwiximeme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"»Kakaɨyari teɨteri wateta kaneniyetuani memɨnetsikuxatatɨwenikɨ,","poem":1},{"text":"xewitɨtɨma pɨkayu'eirie nehɨxie menetsiku'aɨtsikawiyatɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mɨyanetiuka kukuinetɨ nepɨkahauniereri,","poem":1},{"text":"naitɨri newaiyari 'etɨriya hepaɨ pɨ'ane.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Teɨteri 'aixɨa memɨte'u'uwa xɨka menetsi'uxeiya mepɨkɨhɨxiyawa,","poem":1},{"text":"wahetsie mɨkarahɨiwa mekaniuyeha'arɨweni Kakaɨyari memɨka'ayexeiya wahepaɨtsita,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"tewi heitseriemekɨ yamɨtikamie yuhuyeta xeikɨa kaniumieni","poem":1},{"text":"meta yumamatsie meu'itiyatɨka kanitɨrɨkaɨyeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"»Kamɨtsɨ xeme yunaitɨ xekenakɨni nehepaɨtsita xetekuxatatɨ,","poem":1},{"text":"Xetsata xeimetɨma timaiweme nepɨkakaxeiya.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Netukari kananukayeikani, meta kenemɨtinekɨhɨawekai yapɨkatiɨyɨ","poem":1},{"text":"metatsiere yaxeikɨa ne'iyari tita mɨreuyehɨakai.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"'Ikɨ teɨteri yɨriya hekɨariya mekanayeitɨwani,","poem":1},{"text":"naitɨ kaniɨyɨwini, matsi 'ipaɨ mekaniutiyuaneni:","poem":2},{"lineBreak":true},{"text":"“Kanikuhekɨarirɨmeniri”.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hakewa nemekateukieni mɨkɨxeikɨa xɨka netakwewieka nekii mayanikɨ,","poem":1},{"text":"kamɨtsɨ makɨyɨwitsie xeikɨa neyuka'itɨame nepeukuni,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"mɨtiyɨpɨniyawe “Nepaapa” nepɨtiuterɨwani,","poem":1},{"text":"kwitsiterita “Nemaamama” meta “Ne'iwama 'ukari”.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kamɨtsɨ, ¿tita nemɨtitakwewie hakewa peyuhayewa?","poem":1},{"text":"¿Kepaikɨ nehetsie tita nemɨtitakwewie pɨtixeiya?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"¿Nehamatɨa reukahani mɨkite wakitenietsie paitɨ?","poem":1},{"text":"¿Teyunaitɨ teteheukahaxɨani tumuanaripa paitɨ?»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}