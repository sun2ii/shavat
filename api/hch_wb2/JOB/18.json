{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":18,"content":[{"type":"heading","content":["Hutarieka Wiriha kemutayɨ"]},{"type":"verse","number":1,"content":["Merikɨte Wiriha Tsuha kiekame mɨpaɨ katinita'eiya:"]},{"type":"verse","number":2,"content":[{"text":"«¿Kepaukari peputihayewa waɨkawa petikuxatatɨ?","poem":1},{"text":"'Aixɨa ketine'atimaixɨaka 'anakeri tepɨtetixata.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"¿Ketitayari yeutari memumamariwawe wahepaɨ petatiyuriene?","poem":1},{"text":"¿Temɨka 'u'iyarini hepaɨ petatiku'eriya?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Ahaxɨakɨ 'a'iyari pekanitatsanarɨmeni,","poem":1},{"text":"matsi kwie 'akumawetɨ pɨkayuhayewa 'akɨmana,","poem":2},{"lineBreak":true},{"text":"meta 'ayepari pɨkakuyuaxɨani yuhuyeripa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"»'Axamɨtiuka'iyari kɨxemeya kanitɨmɨkɨ,","poem":1},{"text":"taiya 'amanutitetere tatɨri katinihayewamɨkɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xawatɨriya kiitana kaniyɨrirɨmeni,","poem":1},{"text":"kɨxeme mikɨxiya kanitɨmɨkɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Heutɨrɨkaɨyetɨ kemɨtikuyeikakai pɨkaheuwaɨreri,","poem":1},{"text":"yuhetsiemiemekɨ kemɨtiyukuhɨawe kanetihɨamɨkɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yu'ɨkatekɨ winiyari hetsie kanikakemɨkɨ,","poem":1},{"text":"mɨkɨ winiyarieya 'ihɨatɨ kanayeimɨkɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yuketatetɨa wahɨatɨkaitɨ puyuhayewa,","poem":1},{"text":"yuheyemekɨ hɨatɨ kaniyuhayewamɨkɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Winiyari kwiepa 'awie kumatɨ kanitakwewieka,","poem":1},{"text":"winiyari manumietsie kanikuwereni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tsepa hakewa kanimariutsieka,","poem":1},{"text":"'utɨmana xeikɨa kanikuyeikani.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mɨtika'enitsitɨwa xeikɨa kanikuweiyaneni,","poem":1},{"text":"tita mɨti'uximatɨa pɨka'ipitɨa xeikɨa 'etsiwatɨma.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kwiniya waiyarieya kanitaxɨtɨaximeni,","poem":1},{"text":"mɨki mamateya meta 'ɨkateya kanitikwaiximeni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hakewa 'aixɨa 'anemekɨ mekateitsie 'ateewa paitɨ puyuhayewa,","poem":1},{"text":"hikɨri ti'aitame mɨtiyumariuta hetsɨa kaniumieni.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kiitana tai naime katiniuyetaiyarɨmeniri,","poem":1},{"text":"hatsupure tatɨ kaniuyenɨka muwayekatsie.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kɨtsunu nanayari kaniutiwaniri,","poem":1},{"text":"xawariyari mu'utana miemeri naitɨ kaniutiyɨnare.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kwiepa kanakuyeitɨariemɨkɨ mɨkaku'eriwanikɨ,","poem":1},{"text":"pɨkakuxaxatsiwanitɨma mɨkɨ kwieyaritsie.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hekɨaripa hayehanieme yɨwipa kaneutahɨiyamɨkɨ,","poem":1},{"text":"'ena kwiepa kanayenɨ'arieni.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yuteɨterima watsata tɨma yuniwema meta yu'iwama pɨkawarexeiya,","poem":1},{"text":"hakewa mɨkɨ mekatei xewitɨtɨma hayeyuritɨ pɨkayuhayewa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Tau manatineika hepatsie meta makayuyuipike hepatsie,","poem":1},{"text":"teɨteri mepɨhɨxiyani mɨkɨ kemɨ'itɨarienikɨ","poem":2},{"lineBreak":true},{"text":"'ana waɨkawa mepɨtimamani.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mɨpaɨ kani'aneni 'axamɨtiyuriene kiiya,","poem":1},{"text":"Kakaɨyari mɨkamate manukatsie».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}