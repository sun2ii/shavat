{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":19,"content":[{"type":"heading","content":["'Ataxewirieka Kuwi kemutayɨ"]},{"type":"verse","number":1,"content":["Mɨkɨ hepaɨtsita Kuwi mɨpaɨ kaniutayɨni:"]},{"type":"verse","number":2,"content":[{"text":"«¿Kepaukakeri xepɨnetsihayewa xenetekwinitɨatɨ","poem":1},{"text":"meta yuniukikɨ xenetsi'anukapɨnatɨ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mɨixari yaxepɨnete'utahɨawixɨ.","poem":1},{"text":"Waɨkawamekɨ 'axaxepɨnetsiyurie karixepɨkaheyutetewiya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Xɨka xeniu tiyuritɨni neri xaɨtsie neheukuyune,","poem":1},{"text":"'axakenemɨtiuyuri nehetsie nepɨtiuyuri.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Matsi xɨka xeme 'aixɨa xe'aneneme xeyu'erieka nehepaɨtsita,","poem":1},{"text":"meta xemamariwaweme xeyu'erieka xemaye'axɨanikɨ nehetsɨa kenemɨkatiyɨwekɨ ne,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"mɨpaɨ xeketenemaika Kakaɨyari pɨta pɨnetsiyuriene kemɨ'ane mɨnetikwinitɨa,","poem":1},{"text":"kemɨ'ane winiyarieyatsie nemuyewie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"»Tsepa mɨpaɨ nemɨtiuhiwa: “Nepɨnanaimarie”, xewitɨ pɨkanetsiha'eiya,","poem":1},{"text":"tsepa xekeneneuparewi nemaine, nehetsie pɨkatinuitɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kakaɨyari nehuye panunari, nepɨkayɨwe nemanutayanikɨ,","poem":1},{"text":"nehuye 'uyɨwime kanayeitɨani.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Naime pɨnetiunawairi titakɨ 'aixɨa nemɨtixeiyariekai,","poem":1},{"text":"nemu'utsieri kuruna pɨnetsi'anutihaniri.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Naime pɨnetsiheutiwitexɨa, kɨye hepaɨ,","poem":1},{"text":"pɨnetsi'akumaweriyaxɨ, tita nemɨtitakwewiekai pahunaxɨ nanayaritsie paitɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nehepaɨtsitari kaniuyeha'ani,","poem":1},{"text":"kemɨ'ane mɨkɨ muwaraye'unie kanenayeitɨani.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kuyaximama meyuwaɨkawatɨ 'upɨta mekanahuni,","poem":1},{"text":"yuhuye mekaniuwewiximeni nehetsɨa meye'axɨanike,","poem":2},{"lineBreak":true},{"text":"nemanuka 'aurie mekanikuyaxe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"»Yapɨtiuyuri ne'iwama memɨnetsiku'eirienikɨ,","poem":1},{"text":"meta nehamikuma mepɨnetsihehɨari.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nemarema nemuwamatekai mepeutayeixɨa,","poem":1},{"text":"mepɨnetsihatɨmairi yuheyemekɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nekie memɨ'iwata, meta nete'uximayatsiriwamete memɨkanetsimateni hepaɨ xeikɨa mepɨ'anene,","poem":1},{"text":"kwi mepɨnetsikuxexeiya mɨxeɨmatsiwa hepaɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mɨneti'uximayatsirie nepahɨawe, matsi mɨkɨ pɨkanetsiku'eiya,","poem":1},{"text":"tsepa netɨtɨ nekatihayewatɨ nemiwawirie.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ne'ɨya ne'iiya pɨxani'erie,","poem":1},{"text":"yaxeikɨata ne'iwama 'axamepɨnete'ɨkwe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Matsipaitɨri tɨɨri mepɨkanetsixeiyaku,","poem":1},{"text":"kepauka memɨnetsikuxexeiya, mepɨnetsiyuriya.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yunaitɨ nehamikuma mepɨnetsixani'erie,","poem":1},{"text":"yunaitɨ memɨnetsinaki'eriekai mepɨnetsi'aye'unie.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nenawiyari meta newaiyari ne'umetetsie pukuwewerikeri,","poem":1},{"text":"netiuka'eniwatɨ 'etsiwa nepayeyuri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"»Xekeneneutinenimayata nehamikuma xemɨhɨkɨ,","poem":1},{"text":"xekenenenenimayaka, Kakaɨyari pɨnetsi'anayewaxɨa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"¿Titayari Kakaɨyari hepaɨ xenetekuweiyatɨwe?","poem":1},{"text":"¿Xe'iyaritsie kareuyeyeika ne'ayeniereme xenetekwa'a?","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"»Xɨka neniuki haka'ɨkienike,","poem":1},{"text":"xɨka xapatsie haka'utɨarienike.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Xɨka matsi yuheyemekɨ tetetsie yuhayewake,","poem":1},{"text":"ha'ɨkietɨ tepɨa kwaniyariekametsie ti'utɨwamekɨ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ne nepɨtimate nehetsie nunuwame payeyuri,","poem":1},{"text":"meta 'imatɨrieka panukukeni tumuanaripa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kepaukari newaiyari mɨka'une,","poem":1},{"text":"'akuxi Kakaɨyari nehɨxikɨ nekanexeiyamɨkɨ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ne nekɨmana nepixeiyamɨkɨ,","poem":1},{"text":"ne yanepɨra'eriwakaku nemixeiyakɨ, xewitɨ kamatiwatɨ hawaikɨ.","poem":2},{"lineBreak":true},{"text":"Mɨyanemɨtinekɨhɨawekɨ heiwe'erika pɨnetsitaxɨtɨaxime netaɨta paitɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"»Xeme mɨpaɨ xeputiyuane: “Hikɨmɨ hetsiena tepɨtehahɨani,","poem":1},{"text":"mɨkɨ hetsie 'axamɨti'ane katinixɨaweni”.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Matsi xekeneyɨ'ɨwiyani 'ixipara hepaɨtsita,","poem":1},{"text":"mɨkɨkɨ haxɨaya 'ukanamieni tita 'axatemɨteyurie hepaɨtsita,","poem":2},{"lineBreak":true},{"text":"xemɨtemaikakɨ kename 'itsɨkame 'a'uwe».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}