{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":20,"content":[{"type":"heading","content":["Hutarieka Tsupaxi kemutayɨ"]},{"type":"verse","number":1,"content":["Mɨkɨ hepaɨtsita Tsupaxi Namati kiekame mɨpaɨ kaniutayɨni:"]},{"type":"verse","number":2,"content":[{"text":"«Ne'eriwametsie waɨkawa nemɨnehɨawekɨ yanepɨtayɨni,","poem":1},{"text":"yemekɨ 'aixɨa nepɨkareu'erie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tierika ne'u'enieka yukɨnepɨreka'erietɨya,","poem":1},{"text":"kenemɨtimaiwekɨ pɨnetsikuyuitɨwa nemɨtaniunikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"»'Ekɨ pepɨtimate meripaitɨ,","poem":1},{"text":"kepauka Kakaɨyari tewi mukayetsie kwiepa,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'axamɨtiuka'iyari kemɨtiyutemawie 'apɨkareutere,","poem":1},{"text":"Kakaɨyari mɨka'ayexeiya temawierikaya yakatinimieni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kemɨtiyuta'ɨrekɨ tsepanetɨ muyuawitsie mɨye'axe","poem":1},{"text":"meta tsepa yumu'ukɨ haiwitɨri mukuyuituwa,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"mɨkɨ kanikumawerimɨkɨ yuheyemekɨ, kwitarai hepaɨ,","poem":1},{"text":"memeitima mɨpaɨ mekanitiyuakuni: “¿Ke'ɨyɨ?”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yɨwikɨta mɨtiuheinɨni hepaɨ, tɨkarikɨ mɨtiuxeiyatsitɨarieni hepaɨ,","poem":1},{"text":"yapauka pɨtapare tawariri pɨkataxeiyarieni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Keyupaɨmetɨ memixei tawariri mepɨka'ixeiya,","poem":1},{"text":"meta hakewa mekateitsie hutarieka pɨkanuani.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Niwemamata tixaɨtɨ memɨkatehexeiya mekateniwayetuiriekuni,","poem":1},{"text":"wapaapa tita mɨtiunawakai.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Xe'umete mɨtɨrɨkawi hikɨ xetemaritɨkaku","poem":1},{"text":"'uxa'atɨni warie mɨkɨ hamatɨa xekanika'uxipikuni tumuanaritsata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"»Tsepa yuteta 'axamɨti'ane hakakame memɨ'erie","poem":1},{"text":"meta yuneni hetɨa mi'awieta,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"tsepa mɨkahewayetuaya,","poem":1},{"text":"matsi xɨka 'i'awietani ka'itaunietɨ,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"mɨkɨ paa kwa'ameyatsie yekaitɨ kanatsiɨrimɨkɨ,","poem":1},{"text":"mɨkɨ taɨtana yekaitɨ xaye meixeiya 'uaye mumɨya hepaɨ 'anetɨ kanayeimɨkɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Waɨkawa mɨrexeiyanikɨ kemɨranukaxɨ kanitahayamɨkɨ,","poem":1},{"text":"Kakaɨyari yakatiniyurimɨkɨ yuhuriepa menatihayanikɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kuu meixeiya 'uaye mumɨya kananatiyuinimɨkɨ,","poem":1},{"text":"kuu nenieya mumɨya kanimiemɨkɨ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"'Aki muyehapanetsie pɨkakuyani,","poem":1},{"text":"retsi kuneriyari meta xiete hatɨayari muyehapanetsie,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Pɨkatitikwani tita mɨra'iwaxɨ yu'uximayatsikakɨ,","poem":1},{"text":"pɨkayukatemawieni tita waɨkawa mɨtiukaxeikɨ,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"tixaɨtɨ memɨkatehexeiya mɨtiwarunawairikɨ waɨriyarika wapitɨatɨ tixatɨ mɨkatiwaruhayewikɨ,","poem":1},{"text":"meta kii mɨka'utiwewi kutsiyari mayuyeitɨakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"»Yuhukatsie pɨka'utahɨpɨrike,","poem":1},{"text":"tita mɨtikwaimɨkɨkai pɨkatiutatetexiwakai.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Tita mɨtikwakai pɨkakuhayeikawakai,","poem":1},{"text":"'ayumieme kayuwatɨ kemɨrexeiyakai 'apɨkareutere.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kepauka waɨkawa mɨrexeiya, haweri katiniyurimɨkɨ,","poem":1},{"text":"hetsiena 'axati'anetɨ rahetetɨ katinanutatemɨkɨ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kepauka 'axamɨtiuka'iyari yutaɨta mɨtahɨne,","poem":1},{"text":"Kakaɨyari waɨkawa yuhaxɨa mɨkɨ hetsie kanitatuamɨkɨ,","poem":2},{"lineBreak":true},{"text":"hetsiena mukawiye hepaɨ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Tsepanetɨ muyuta'unaxɨ tepɨakɨ mɨtiwewiyatɨka 'imieriyarikɨ,","poem":1},{"text":"'ɨrɨ wurunitseyarikɨke kanenuyexuimɨkɨ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kepauka nemaya hetsie meta wari'ɨtɨana","poem":1},{"text":"'ɨrɨ mɨtsɨmeyari xehahanake xemuyuta'inɨata,","poem":2},{"text":"xekanitimamakuni tsiɨrika xexeiyatɨ,","poem":1}]},{"type":"verse","number":26,"content":[{"text":"tita waɨkawa mɨraye'atɨkatei mɨrexeiyakai makɨyɨwitsie kaneukaxɨriyamɨkɨ.","poem":2},{"text":"Tai ka'anutihɨtsieriwatɨ kanitaxɨtsitɨamɨkɨ","poem":1},{"text":"meta tinaime kiitana tita mɨreyuhayewa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Taheima muyema muyuawi katinitahekɨatamɨkɨ ke'axamɨtiuyurikɨ,","poem":1},{"text":"kwie meta yapɨtayɨni mitaxanetakɨ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kepauka Kakaɨyari haxɨaya maye'anitsie,","poem":1},{"text":"haa tɨrɨkaɨyetɨ kaniwayenemɨkɨ kiiya kanita'unamɨkɨ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Kakaɨyari mɨpaɨ katinikuha'aritsirieka 'axamɨtiyuriene,","poem":1},{"text":"mɨpaɨ ti'aneme xeikɨa katinenayexeirieni».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}