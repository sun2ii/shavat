{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":21,"content":[{"type":"heading","content":["'Atahutarieka Kuwi kemutayɨ"]},{"type":"verse","number":1,"content":["Mɨkɨ hepaɨtsita Kuwi mɨpaɨ katinita'eiya:"]},{"type":"verse","number":2,"content":[{"text":"«Neniuki yemekɨ xekeneu'eni,","poem":1},{"text":"mɨkɨkɨ nɨtɨarika xekanenipitɨakuni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kayuwatɨ xeketeneteni mexi netikuxata,","poem":1},{"text":"xekenenenanaimaka 'arike netitahayewayuke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"»¿Tewi mɨmɨwe kuta hetsiemieme netikuxata?","poem":1},{"text":"¿Kexeteku'eriwa ketitayari nemɨtinewieka nekatiyɨwe?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xekeneneuxeiya, meta xekenehɨxiyaka,","poem":1},{"text":"yumamakɨ yutenitsie xekeneuwɨka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xɨka mɨpaɨ netiku'eriwani, waɨkawa nepekamatɨyeika,","poem":1},{"text":"netaɨta pɨnetsi'utanɨtsa neheuxerimɨtɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"¿Titayari 'axamemɨte'u'iyari mete'u'uwa,","poem":1},{"text":"'ukirawetsixitɨtɨri meta waɨkawa matsi meteheuxeiyatɨri?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Memakuteitsie mekutekame mekaniwaxeiyakuni","poem":1},{"text":"yuniwema meta yuxiɨyarima.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Aixɨa 'iyari mepu'uwa yukie, meta mepɨkamariutsie,","poem":1},{"text":"Kakaɨyari 'iwaɨyɨya pɨkatiwakwinitɨa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Watúrutsixi yemekɨ 'aixɨa me'aneneme memuwatinuariwa mepɨhɨkɨ,","poem":1},{"text":"wawakaitsixima mepɨtiniweya meta mepɨka'anuye'iwetsiwa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yutɨɨriyama memɨnautsatɨwenikɨ mepɨwapitɨa muxatsi memɨhɨkɨtɨni wahepaɨ,","poem":1},{"text":"tɨɨri tsimemupepe me'utitsukwakatɨ mepuyutemamawie.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xekeneutikwikani teputsie meta kanaritsie kemekɨyɨnekɨ,","poem":1},{"text":"pirikɨxakɨ xeketeneukayuitɨwani kemekɨyɨnekɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Aixɨa tiwayuriekaku mepu'uwa,","poem":1},{"text":"meta yu'iyarikɨ mɨki teukiyapa mepɨ'axe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kakaɨyari mɨpaɨ mekatenikɨhɨaweni: “Kayuwatɨ ketaneuhayewa.","poem":1},{"text":"Kemɨmatinake yatemɨtekahunikɨ tepɨkaheumaiku.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"¿Kemɨ'ane Naimekɨmɨtɨrɨkaɨye pɨhɨkɨ, tame temeyexeiyanikɨ?","poem":1},{"text":"¿Ketita teteha'iwa xɨka xeikɨa tame nenewieri te'iyetuirieka?”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Matsi ke'aixɨa memɨteheuxeiya yɨtɨrɨkariyakɨ mepɨkate'ukaxei.","poem":1},{"text":"'Axamemɨteyurieri wa'ɨxatsi ne nepɨka'enieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"»¿Kepauka 'axamemɨte'u'iyari wakɨxeme pɨtɨxɨa?","poem":1},{"text":"¿Kepauka 'axamɨtiwayurie wahetsie pɨye'axe?","poem":2},{"text":"¿Kepauka Kakaɨyari, yuhaxɨakɨ, pɨtiwakwinitɨa","poem":1}]},{"type":"verse","number":18,"content":[{"text":"'eka 'uwakaxa kemɨre'enitsitɨwa hepaɨ,","poem":2},{"lineBreak":true},{"text":"kuxari 'eka mɨtɨrɨkaɨye mei'enitsitɨwa hepaɨ?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mɨpaɨ xepɨnetetahɨawe kename Kakaɨyari tiuti'utaxɨ yamɨtiwarakapitɨanikɨ","poem":1},{"text":"'axamemɨteyurie waniwema wahetsiemieme.","poem":2},{"text":"Matsi kemɨ'ane 'axamɨtiuyuri kerakapitɨani,","poem":1},{"text":"mɨkɨ yamɨretimanikɨ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"'Axatiyuruwame ketiuka'eniexɨani yuxaɨta muyutatɨmaiyakɨ.","poem":1},{"text":"Naimekɨmɨtɨrɨkaɨye haxɨaya ke'anu'ieni.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"¿Kekutari tiyɨkɨhɨaweni yutɨɨriyama wahetsiemieme mɨwaku'eirieni,","poem":1},{"text":"xɨkari yapaɨmexɨa xeikɨa heuyeweka mukumawerekɨ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"»¿Kemɨ'ane pɨyɨwe Kakaɨyari mɨtiuta'ɨkɨtɨani mɨkɨ mɨtimaiwenikɨ,","poem":1},{"text":"mɨkɨ matsi katihɨkɨ heitseriemekɨ yamɨtayɨni waɨkawa memauka'u wahetsiemieme?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hipatɨ 'akuxi yakɨ meyumatetɨ mekanitakukuweni,","poem":1},{"text":"'aixɨa meteheu'erietɨ meta meka'uximatɨarietɨ,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"wakwatsapaɨ waɨkawa wiyatɨkaikaku,","poem":1},{"text":"wa'umete waɨkawa tɨrɨkawikaku 'akuxi.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Hipatɨ mekanitakukuweni meyuhɨawetɨ,","poem":1},{"text":"'aixɨa mɨti'ane mekateha'inɨatawawetɨ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Tumuanaripa yuxexuitɨ mekanikuhikuni,","poem":1},{"text":"mɨkɨ yunaitɨ kwitsiterixikɨ mekaneunɨtɨkaikuni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"»Nepɨtimate xeme kexemɨteku'eriwa,","poem":1},{"text":"meta yaxetekuxatatɨ kexemɨnetsiyurienikɨ xeikɨa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Yaxeikɨatsiere nekatinimaika mɨpaɨ xekaniyuku'iwawiyani:","poem":1},{"text":"“¿Hakewa waɨkawa meukawe kiiya pewe?","poem":2},{"lineBreak":true},{"text":"¿Hakewa 'axamemɨte'u'iyari wakii peti'u?”","poem":2}]},{"type":"verse","number":29,"content":[{"text":"¿Kɨkamete xekatewata'iwawiyawawe?","poem":1},{"text":"¿Kwi xekatewaku'eniwa kememutiyuanekɨ?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"'Axamɨtiwayurie tukariyaritsie, 'axamɨtiuka'iyari puyutawikweitsitɨwa,","poem":1},{"text":"kepauka haxɨa tukariyari maye'anitsie putawikweitsitɨariwa,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"¿Kemɨ'ane hɨxiena mɨkɨ kemɨtiuka'iyarikɨ yapɨtitahɨawiwe?","poem":1},{"text":"¿Kemɨ'ane mɨrekapitɨani pɨyɨwe mɨkɨ kemɨtiuyurikɨ?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Kepauka mɨkite memakateukiwatsie manukweiyani,","poem":1},{"text":"maka'awietsie heima kanita'ɨwiyariemɨkɨ,","poem":2}]},{"type":"verse","number":33,"content":[{"text":"yɨmɨiretɨ teɨteri mekaniweiyani 'utɨmana,","poem":1},{"text":"meta yumɨiretɨ mekanika'awiwietani teukiyata.","poem":2},{"lineBreak":true},{"text":"Kwieta paitɨ muyeweritsie kani'uxipieka kayuwatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"»¿'Akuxi xenetetakwewie xenetsinɨtɨanike yuniuki mɨkawaɨriyakɨ?","poem":1},{"text":"Kexemɨneteku'eiya naitɨ mɨkɨ pɨti'itarika».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/20.json","previousChapterAudioLinks":{},"numberOfVerses":34}