{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":22,"content":[{"type":"heading","content":["Hairieka 'Eripaxi kemutayɨ"]},{"type":"verse","number":1,"content":["Mɨkɨ hepaɨtsita 'Eripaxi Temani kiekame mɨpaɨ katinita'eiya:"]},{"type":"verse","number":2,"content":[{"text":"«¿Xewitɨ tiyɨwe, waɨkawa timaiwetɨ,","poem":1},{"text":"Kakaɨyari hetsiemieme tixaɨtɨ tiyunaki'erietɨ mayanikɨ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"¿Tixaɨtɨ 'aixɨa ti'aneme tikaxeiya Naimekɨmɨtɨrɨkaɨye,","poem":1},{"text":"tewi heitserie pemexeiya pehɨkɨtɨkaku?","poem":2},{"text":"¿Mɨkɨ tixaɨtɨ rexeiyatɨ rayani","poem":1},{"text":"xɨka 'aixɨa 'anemekɨ pe'uyeikani?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"¿Kamɨtsɨ pemeyemakaxekɨ metiutate'a,","poem":1},{"text":"'ayumieme memataheitseritɨariwatsie meranuwitɨni?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Matsi kaniwaɨkawani 'axakepemɨtiuyuri.","poem":1},{"text":"'Axakepemɨtiuyuri pɨkayu'inɨatsinɨa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'A'iwama pepɨtiwakwetatɨakai,","poem":1},{"text":"meta pekaheiyehɨatɨ wakemarite pepɨwakunawairiwakai,","poem":2},{"lineBreak":true},{"text":"meka'ukemarime pepɨwakuhayeikawakai.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kemɨ'ane meuharimɨkɨkai pepɨkaharitɨakai,","poem":1},{"text":"'ikwai meuyehɨakai pepikweririekai.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tewi waɨkawa meukawe pepa'ayeitɨa meta kwie 'ahetsiemieme pepayeitɨa,","poem":1},{"text":"tewi waɨkawa pemumariwe, mɨkɨtsie 'aixɨa pekatiniuyerɨni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wiuraxi tixaɨtɨ pepɨkatiwakumikwakai,","poem":1},{"text":"meta nutuite naime pepɨtiwakunawairiwakai.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Ayumieme hikɨ winiyari 'a'aurie kanakani,","poem":1},{"text":"meta 'ayumieme pekanimariutsieka,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"yɨriya pekaheuniereme kamenayeitɨaka,","poem":1},{"text":"haa mɨtɨrɨkaɨye kameniukayunitɨwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"»Kakaɨyari matsi muyuawi 'ameutitewatsie kaniuyeikani.","poem":1},{"text":"Xurawetsixi keniwareutixeiya, 'aheutitewakaku memakatei.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Matsi 'ipaɨ pekaniutaineni: “¿Kakaɨyari ketimate?","poem":1},{"text":"¿Kamɨtsɨ tiyɨwe makɨyɨwitsie mɨtatsitaheitseritɨani?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mɨkɨ muyuawi taheima muyema hetsie kaniyeikaneni muyuawi manuye'atɨkatsie ye'axetɨ,","poem":1},{"text":"meta haiwitɨri 'e'ayetsuitɨ kaneitinarɨmani,","poem":2},{"lineBreak":true},{"text":"'ayumieme pɨkatatsixeiya”.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"»¿Meripai mieme yeiya petiyeweiyani","poem":1},{"text":"'axateyuruwamete kememɨte'u'uwakai?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kahaye'awekaku 'akuxi yutukari mekaniutatɨmaiya,","poem":1},{"text":"haa mɨtɨrɨkaɨye watsutɨmeyari kanahautsitɨaxɨani.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kakaɨyari mɨpaɨ mekateniutahɨawe: “Kayuwatɨ ketaneuhayewa.","poem":1},{"text":"¿Kekuta 'ekɨ petatsiyurieni, Naimekɨpemɨtɨrɨkaɨye?”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kakaɨyari katiniuyurieni 'aixɨa mɨti'ane mɨtiuta hɨniyaxɨ wakiita.","poem":1},{"text":"Ne 'axamemɨteyurieri wa'ɨxatsi nepɨka'enieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«Heitseriemekɨ yamemɨtekahu mekaniyutemawieka 'axamemɨte'u'iyari kememɨte'uka'unarɨwa mewaxeiyatɨ,","poem":1},{"text":"wahetsie mɨkarahɨiwa mɨpaɨ mekaniutiyuaneni mewananaimatɨ:","poem":2}]},{"type":"verse","number":20,"content":[{"text":"“Memɨtatsi'aye'unieri mekaniuka'unarieni,","poem":1},{"text":"wapiinite taipa naitɨ katiniutixɨni”.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"»Kakaɨyari hetsɨa 'aixɨa kene'ayuri, kayuwatɨ pehexeiyame kene'ayeitɨa mɨkɨ hamatɨa,","poem":1},{"text":"'ahetsie katinanuamɨkɨ perexeiyatɨ pemayanikɨ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"'Ɨkitsikaya tetana mayeneika keneutanaki'eri,","poem":1},{"text":"'a'iyaritsie niukieya kenaka'ɨki.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Naimekɨmɨtɨrɨkaɨye hetsɨa xɨka penuani","poem":1},{"text":"meta 'axamɨti'ane 'akie xɨka perayeweiya,","poem":2},{"lineBreak":true},{"text":"naimekɨ pekanihekwatɨariemɨkɨ,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"xɨka 'ahuru 'aixɨa mɨ'anene","poem":1},{"noteId":2},{"text":"kwiepa pe'itixɨrieni","poem":1},{"text":"tetexitsata meta 'aita,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Naimekɨmɨtɨrɨkaɨye 'ahuru kanihɨkɨtɨkamɨkɨ 'ahetsiemieme,","poem":1},{"text":"meta mɨkɨ 'apɨrata 'aixɨa mɨ'ane kanihɨkɨtɨkamɨkɨ 'ahetsiemieme.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Naimekɨmɨtɨrɨkaɨye hetsie pepɨ'atemawieka,","poem":1},{"text":"Kakaɨyari hetsɨa pepeutaniereni.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kepauka pemuyunenewie, mɨkɨ kameni'enimɨkɨ,","poem":1},{"text":"'ekɨta kepemɨti'ahɨritɨakɨ pekaneye'atɨiriemɨkɨ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ketita pemɨtitsutɨani yapɨtikɨyɨneni,","poem":1},{"text":"'ahuyeta xawatɨriya pɨhekɨariwieka,","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Memuyuti'ɨre Kakaɨyari tixaɨtɨ pɨkatiwarayeitɨwa,","poem":1},{"text":"tixaɨtɨ memɨkatehayuyeitɨa kaniwaranuku'uitɨwani.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Mɨkɨ wahetsie mɨkarahɨiwa kaniwawikwetsitɨaka,","poem":1},{"text":"'aixɨa pemɨtiuyurikɨ pekanitawikwetsitɨariemɨkɨ».","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"huru 'aixɨa mɨ'anene. Pɨyɨweta mutayɨni huru 'Upixi mieme.","reference":{"chapter":22,"verse":24}}]},"thisChapterLink":"/api/hch_wb2/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}