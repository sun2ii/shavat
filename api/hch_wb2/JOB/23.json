{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":23,"content":[{"type":"heading","content":["'Atahairieka Kuwi kemutayɨ"]},{"type":"verse","number":1,"content":["Mɨkɨ hepaɨtsita Kuwi mɨpaɨ kaniutayɨni:"]},{"type":"verse","number":2,"content":[{"text":"«Netaɨta nepɨha'a yaxeikɨa nemuti'uximatɨariekɨ,","poem":1},{"text":"neputa'aiwa Kakaɨyari mamaya mahete nehetsie tiunakeku.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Xɨa'ui, xɨka ne netimaikake Kakaɨyari hakewa nemekaxeiyakɨ.","poem":1},{"text":"Xɨka neyɨwenike nemeta'anikɨ mɨkɨ hakewa meyeika.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mɨkɨ hɨxie nepitaxanetakeyu ketitayari nemɨti'ane,","poem":1},{"text":"'aixɨa yemekɨ nepɨreixatɨanikeyu mɨyanemɨranuyemiekɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yanepɨretimanikeyu kemɨnereta'eiya,","poem":1},{"text":"meta nepeitimaitɨyanikeyu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"¿Kamɨtsɨ mɨkɨ yutɨrɨkariyakɨ neraye'uniekakeyu?","poem":1},{"text":"Nekatixaɨtsietɨ. Mɨkɨ matsi pɨkanetsitaxanetakeyu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mɨkɨ hɨxie tsepa kemɨ'ane tewi heitserie hexeiyatɨ","poem":1},{"text":"pɨyɨwe yuhetsiemieme yamutayɨnikɨ,","poem":2},{"text":"meta ne nexɨnitɨ nepayeiwe yuheyemekɨ","poem":1},{"text":"ne'itsɨkame hɨxie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"»Xɨka tau manatineika hepatsie neheyani, mana nepɨkaheitaxeiya,","poem":1},{"text":"xɨkata makayuyuipike hepatsie neheyani, manata nepɨkaheixeiya.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tayetatsie xɨka rayexeiyani, nepɨka'ixeiya,","poem":1},{"text":"xɨkata tatsutɨa hepa heyani, ne 'atsinepɨkaretimani.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Matsi mɨkɨ, nehuye naime pakumate,","poem":1},{"text":"xɨka netsi'uta'inɨatake, ne huru 'aixɨa mɨ'ane hepaɨ ne'anetɨ nepayeiwe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Huyeya hetsie xeikɨa ne nepumie,","poem":1},{"text":"huyeya nepuweiya xaɨtsie nekaheukuyuyuikipetɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"'Aitsikateya tetana mayeneika nepɨka'uku'e'eiriwa,","poem":1},{"text":"netaɨta paitɨ yemekɨ","poem":2},{"lineBreak":true},{"text":"nepiti'utaxɨ niukiteya tetana mayenexɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"»Matsi mɨkɨ Ti'aitame kanihɨkɨtɨni,","poem":1},{"text":"¿kemɨ'ane pɨyɨwe kemɨtiyurienekɨ mɨta'imaiya?","poem":2},{"lineBreak":true},{"text":"Mɨkɨ kemɨtiyurimɨkɨ, yapɨtiyuriene.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mɨkɨ yapɨtiyurieni nehetsiemiemekɨ kemɨtiu'eri,","poem":1},{"text":"naime kemɨtiku'eriwa yapɨtiyurieni.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Ayumieme hɨxiena neputimamawe,","poem":1},{"text":"xɨka naime mɨkɨ netiuti'eriexɨani, waɨkawa neputimamawe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kakaɨyari yapɨtiuyuri ne'iyaritsie nemumakakɨ,","poem":1},{"text":"Naimekɨmɨtɨrɨkaɨye pɨnetsimariuta.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tsepanetɨ mɨya nemɨtiuka'eniwa, yɨriya netenie pɨka'uwiere,","poem":1},{"text":"meta yɨriya 'amayetsuye nehɨxie mɨnetsiheukunama.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}