{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"»Xɨka Naimekɨmɨtɨrɨkaɨye hɨxie kemɨtiyɨni naitɨ tihekɨaka,","poem":1},{"text":"¿titayari memimate 'atsimekate'ixeiyawawe heitseriemekɨ kemɨtiyuriene?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hipatɨ mekanixuaweni hakewa wakwie meuka'atɨka 'aixɨa mekate'ixeiyatɨ,","poem":1},{"text":"meta tewaxi 'inawarite mekateniwamitɨweni,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"nutuite wapuxurima mekaniwanawairietɨweni,","poem":1},{"text":"wiuraxi watuurutsixi kwietsanamete mekaniwatanawairiwani memɨtehapitɨkakɨ,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"memɨteheuyehɨwa huyeta mekaniwataweweiyani,","poem":1},{"text":"tixaɨtɨ memɨkateheuxeiya waɨriyarika mekaniwapitɨaka memuyuti'awietakɨ xeikɨa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Puxuri yeutari makumawetsie memu'uwani wahepaɨ,","poem":1},{"text":"tixaɨ memɨkateheuxeiya mekaniyumexɨitɨaka yu'ikwai memɨtehexeiyanikɨ,","poem":2},{"lineBreak":true},{"text":"meta mɨkɨtɨtɨ kwie makumawe yuniwema pɨtiwamikwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kayuwaxata mɨaxa muyukuhayeikawa mekaniteɨxɨtɨweni,","poem":1},{"text":"meta 'axamemɨte'u'iyari waharawerita kaxie mekanititeɨxɨni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yu'ixuriki memɨkahexeiyakɨ, yɨwikɨta meka'ukemaritɨ mekaniukatariyarɨwani,","poem":1},{"text":"mepɨkaheixeiya 'ɨkari xeri hetsiemieme.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wiyeri hɨritsie miemekɨ mepɨtihawire,","poem":1},{"text":"yuhetsie nunuwame memɨkahexeiyakɨ, terɨta mekaneuyuta'unani.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nutui putsitsinawaiyarie yumaamatsie,","poem":1},{"text":"tixaɨtɨ mɨkarexeiya pukuname mɨrapinekɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yu'ixuriki memɨkahexeiyakɨ, meka'ukemaritɨ 'amekaniu'uwani,","poem":1},{"text":"tɨriku me'ɨtɨximetɨtɨ, haakakɨ mekanikwiximeni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hɨriwa takariyari tɨxɨmetsie mepɨpɨna,","poem":1},{"text":"kaxie mekanitiketsinani 'atixawametsie, matsi harimɨyakɨ mekanikwiximeni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kiekaritsie memɨkwixime wahiwari kani'eniɨriɨkɨni,","poem":1},{"text":"memɨwitekietɨka wahiwari parewiya kana'iwawani,","poem":2},{"lineBreak":true},{"text":"matsi Kakaɨyari tɨma 'atsipɨkaretimamate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"»Hipatɨ hekɨariya mepaye'unie,","poem":1},{"text":"mɨpaɨ mepɨkate'u'uwa","poem":2},{"lineBreak":true},{"text":"yuhuye mepɨkahetimaiwawe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kakahekɨariwekaku 'akuxi, tiyumemiwame panukukeka,","poem":1},{"text":"tixaɨtɨ mɨkarexeiya meta mɨreuyehɨwa pukumemiwa,","poem":2},{"lineBreak":true},{"text":"kepaukata mɨkɨyɨre tinawayame kanayuyeitɨwani.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hipame wa'ɨitama muwakumaɨwa hɨxiteya yɨriya kanitakwewieka,","poem":1},{"text":"mɨpaɨ yuhetsiemieme pɨtiyɨkɨhɨawe: “Xewitɨ pɨkanetsixeiya”,","poem":2},{"lineBreak":true},{"text":"yɨhɨxie kaneuyuku'awietani.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yɨwikɨta, tinawayame xeime kiita peuhake,","poem":1},{"text":"matsi tukarikɨ yukiita peuyunama,","poem":2},{"lineBreak":true},{"text":"hekɨariyatsie timiemekɨ tixaɨtɨkɨ pɨkatiyɨkɨhɨawe.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mɨkɨ yunaime wahetsiemieme, hekɨariya yɨriya 'emayetsuye pɨhɨkɨ,","poem":1},{"text":"yɨriya mumariwe pɨta mepɨnaki'erie».","poem":2}]},{"type":"heading","content":["Tsupaxi kemɨranuyeniu"]},{"type":"verse","number":18,"content":[{"text":"«'Axamemɨte'u'iyari kwaimuxari haa heima muyeka hepaɨ mekani'aneneni,","poem":1},{"text":"wakwie 'axakani'itɨarieka,","poem":2},{"lineBreak":true},{"text":"mepɨkateta'uximayatari kaxie harawerita.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Xɨri meta kwie muwaki hepaɨ","poem":1},{"text":"'ɨwi hayari yapauka kemɨti'itse,","poem":2},{"lineBreak":true},{"text":"mɨpaɨta 'axateyuruwamete mɨki teukiyapa mepɨteheukahapawa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wamaamatɨtɨ pɨwaratɨmai,","poem":1},{"text":"kwitsiterixi mepɨwakwa'a,","poem":2},{"text":"xewitɨ tawariri pɨkawaraye'erieni,","poem":1},{"text":"mepawitewa kɨyexi hepaɨ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"'Uka mɨkaniwewe mepɨnanaima, 'uka tɨɨri mɨkawarexeiya,","poem":1},{"text":"hatsuaku wiuraxi wahetsie timieme 'aixɨa mɨti'ane mepɨkatewautɨwe.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Matsi Kakaɨyari, yɨtɨrɨkariyakɨ, waɨkawa memeuka'u puwarehapana,","poem":1},{"text":"kepauka Kakaɨyari manukukeni wahepaɨtsita, xewitɨ 'ayeyuritɨ pɨkayuhayewa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kakaɨyari kaniwapitɨaka 'aixɨa 'iyari memu'uwanikɨ,","poem":1},{"text":"matsi wataxeiyatɨ pɨkatihayewa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yapaɨmexɨa 'aixɨa mepɨtexeiyarieni,","poem":1},{"text":"matsi yapaukata pɨtiukumamawere,","poem":2},{"text":"tixaɨtɨ mepɨkatehayeitɨariwa, tupiriya memakututuwe hepaɨ,","poem":1},{"text":"tɨriku takari kemɨtikaxitewa hepaɨ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"¿Kemɨ'ane neniuki ta'inɨatame kename yakɨ nehaine pɨtayɨni,","poem":1},{"text":"meta kemɨ'ane neniuki tixaɨtɨ pɨkarayeitɨani?»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}