{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":25,"content":[{"type":"heading","content":["Hairieka Wiriha kemutayɨ"]},{"type":"verse","number":1,"content":["Mɨkɨ hepaɨtsita Wirirari Tsuha kiekame mɨpaɨ kaniutayɨni:"]},{"type":"verse","number":2,"content":[{"text":"«Kakaɨyari kanitɨrɨkaɨyeni kanimakaxiwani,","poem":1},{"text":"mɨkɨ yakatini'aitani muyuawi meutitewatsie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"¿Kamɨtsɨ kuyaximama meteyu'inɨatsinɨa?","poem":1},{"text":"¿Kemɨ'ane hetsie hekɨariyaya pɨkaye'axe?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"¿Ketiyɨwe tewi","poem":1},{"text":"kename 'atsikatiyuruwame mɨtayɨnikɨ Kakaɨyari hɨxie?","poem":2},{"text":"¿Tewi ketiyɨwe 'aixɨa 'aneme mayuyeitɨani","poem":1},{"text":"'ukaratsi hetsie yenuiwame?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Metsatɨtɨ Kakaɨyari hɨxie yuhekɨariya pɨkahexeiya,","poem":1},{"text":"meta xurawetsixi mepɨka'itiyatɨka,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"matsi tewi tita tihɨkɨ, kwitsi kanihɨkɨtɨni,","poem":1},{"text":"matsi tewi tixaɨtɨ pɨkatihɨkɨ, hareku mɨkatiyunaki'erie kanihɨkɨtɨni».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}