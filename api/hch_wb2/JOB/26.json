{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":26,"content":[{"type":"heading","content":["Kuwi kemɨranuyeniu"]},{"type":"verse","number":1,"content":["Kuwi mɨpaɨ katinita'eiya:"]},{"type":"verse","number":2,"content":[{"text":"«'Ekɨ hɨrixɨa memɨwerarani xɨaritsɨ pekaniwakuparewiwani.","poem":1},{"text":"'Ekɨ hɨrixɨa memɨkatɨrɨkawi xɨaritsɨ pekaniwawikweitsitɨaweni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Matsi 'ɨxatsi 'aixɨa mɨ'ane 'ekɨ pepɨka'iyetuiriewe 'atsimɨkatimate.","poem":1},{"text":"Meta 'ekɨ kepemɨreitimaitɨyeikakɨ pepɨkatiwahekɨatɨa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"¿Kepaikɨ pumatsi'uparewi mɨyapemɨtayɨnikɨ?","poem":1},{"text":"¿Ke'anetɨ 'iyari matsi'uwiyaku mɨyapeputayɨ?»","poem":2}]},{"type":"heading","content":["Wiriha tikuxatatɨ kemɨrenumɨa"]},{"type":"verse","number":5,"content":[{"text":"«Marikakɨ mekaniutiyɨyɨakani mɨkite,","poem":1},{"text":"haramara hetɨapai memɨtama.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kakaɨyari hɨxie mɨkite wateukiyapa peukahekɨa,","poem":1},{"text":"tiyu'uname miti'awieta pɨkayɨwe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kakaɨyari muyuawi pɨtawera tixaɨtɨtsie katiuyemakame,","poem":1},{"text":"meta kwie tixaɨtɨtsie pukatiuyeyetsa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Haiwitɨritsie haa pɨ'eima,","poem":1},{"text":"matsi hai pɨkatitsanike heteriyakɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Metseri mɨxikɨraɨyenitsie kaneikunarɨmani","poem":1},{"text":"kepauka hai hetsiena muyeweratsie.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ketewa 'atɨ muyuxeiyanɨa haa heima pɨka'inɨaritaxɨa","poem":1},{"text":"hekɨariya meta yɨriya mɨpatanikɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tierikayakɨ mamatɨ,","poem":1},{"text":"muyuawi mutuikatɨka putiyɨyɨaka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xɨka mɨkɨ 'uta'ieni hai muyuawitsie pɨta'enitsitɨwa,","poem":1},{"text":"Kakaɨyari yutɨrɨkariyakɨ haramara kaniutatakeni.","poem":2},{"text":"Kemɨtimaiwekɨ Haxi kaniutaxiteni,","poem":1},{"text":"yutɨrɨkariyakɨ kuu 'amupa haramara kiekame kaniutatsana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Ikɨ matsi 'inɨari xeikɨa kanihɨkɨtɨni kemɨtiuyuriwekɨ,","poem":1},{"text":"'etsiwa xeikɨa ketemɨteku'enakarekɨ.","poem":2},{"lineBreak":true},{"text":"¿Kemɨ'ane meitimaitɨyani pɨyɨwe tɨranarieya mɨtɨrɨkaɨye?»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":13}