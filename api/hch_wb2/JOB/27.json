{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":27,"content":[{"type":"heading","content":["'Atanaurieka Kuwi kemutayɨ"]},{"type":"verse","number":1,"content":["Merikɨtsɨ Kuwi, tawarita kaniutaniuni, mɨpaɨ kaniutayɨni:"]},{"type":"verse","number":2,"content":[{"text":"«Kakaɨyari hetsie nenehɨritɨatɨ, Naimekɨmɨtɨrɨkaɨye,","poem":1},{"text":"kemɨ'ane nehetsiemieme mɨkayuwaɨriya 'aixɨa mɨtiyurienikɨ,","poem":2},{"lineBreak":true},{"text":"kemɨ'ane netukari mɨyatiuka'eniwame mayeitɨa,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"mexi 'akuxi nehetsie tukari xuawe","poem":1},{"text":"meta netsurita Kakaɨyari 'iyaya nehexeiya,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'etsiwa tɨma neteni 'axaranɨyɨneme pɨkatitaxata,","poem":1},{"text":"meta neneni 'itarika pɨkatahekɨata.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hatsuaku nepɨkaxepitɨani kename xeme yurikɨ xetekuxata,","poem":1},{"text":"mexi ne'ayeyuri, kename heitserie nehexeiya nepaineni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne yemekɨ kename nehetsie karahɨiwa neputaineni, nepɨkaxepitɨani.","poem":1},{"text":"Mexi ne'uyeikani, tewiyarika ne'iyaritsie pɨkaxuaweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"»'Axateyuruwamete wahepaɨ memɨnetsi'aye'unie ketiwaruyurieni,","poem":1},{"text":"meta nehepaɨtsita memeuniuka heitseriemekɨ yamemɨkatekahu wahepaɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"¿Kakaɨyari memɨka'ayexeiya kemeteta'ikwewa","poem":1},{"text":"kepauka memɨtakukuwetsie,","poem":2},{"lineBreak":true},{"text":"kepauka watukari Kakaɨyari muwanawairietsie?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"¿Kakaɨyari wahiwari pɨ'enie","poem":1},{"text":"kepauka wahetsie 'uximatɨarika mɨye'axe?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"¿Kamɨtsɨ Naimekɨmɨtɨrɨkaɨye hetsie meteyutemamawie,","poem":1},{"text":"yatɨni yuheyemekɨ Kakaɨyari metehahɨawe?","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"»Ne hikɨ tixaɨtɨ nekatinixehekɨatsitɨiyamɨkɨ Kakaɨyari tɨrɨkariyayatsie mieme.","poem":1},{"text":"Naimekɨmɨtɨrɨkaɨye kemɨtiyuriemɨkɨ nepɨka'enukanani.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xɨka xemetɨtɨ 'ikɨ naime xetexexeiyaniri,","poem":1},{"text":"¿kamɨtsɨ titayari waɨkawa xeteniukixie?»","poem":2}]},{"type":"heading","content":["Tsupaxi hairieka kemutayɨ"]},{"type":"verse","number":13,"content":[{"text":"«'Ikɨ piinitɨarika Kakaɨyari katini'utani","poem":1},{"text":"katiniwayetuiriemɨkɨ 'axamemɨte'u'iyari,","poem":2},{"text":"'ikɨ 'imikieri memɨkateyukanenimaya","poem":1},{"text":"Naimekɨmɨtɨrɨkaɨye katiniwayetuiriemɨkɨ:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tsepa tɨɨri keyupaɨmeme mɨwarexeiyani,","poem":1},{"text":"mepɨkwi'iwa 'ixiparakɨ,","poem":2},{"lineBreak":true},{"text":"meta hatsuaku tɨɨriyamama 'etsimemɨpepe mepɨkatihuxani.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kehateta memɨyuhayewa yaxeikɨa mepɨkateukieni,","poem":1},{"text":"wiuraxi wahetsiemieme mepɨka'utitsuanani.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tsepa waɨkawa pɨrata memukuxeɨri tumuanari hepaɨ,","poem":1},{"text":"meta 'ixurikite yuheima memɨtiyetɨkɨ haxu hepaɨ,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"heitserie mexeiyani pɨhɨkɨtɨni kemɨ'ane mɨkɨ kamixate mɨranakatɨni,","poem":1},{"text":"meta kemɨ'ane hetsiena mɨkarahɨiwa pɨrata pɨwata'ɨitɨani.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kii memɨtiwewiwa kwitsiteri tekɨmemete wahepaɨ pɨ'anene,","poem":1},{"text":"nenieremete waxamaru hepaɨ pɨ'anene.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mepukahipite waɨkawa meteheuxeiyatɨ, matsi 'imatɨrieka:","poem":1},{"text":"kepauka memanutanenieretsie, wapiinite naitɨ pɨtitipaparike.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wahetsie pɨ'axe haa tɨrɨkaɨyetɨ mariwetɨ,","poem":1},{"text":"yɨwikɨta 'eka tɨrɨkaɨyetɨ puwaratixɨrɨwa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"'Eka tau manatineika hepa mieme puware'enitsitɨwa, hikɨ 'ana mepukumamawere,","poem":1},{"text":"kaniwarakuhunani memakuteitsie.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Wahetsie kaniuwautseni kawanenimayatɨ,","poem":1},{"text":"mexi mɨkɨ tɨrɨkariyaya memakatɨ meyuta'unarɨmeni.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yumamate puyuitɨwa wananaimatɨ pɨtiutapine,","poem":1},{"text":"yumaɨxiwarikɨ, memakuteitsie kaniwaranuyenɨ'awani».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}