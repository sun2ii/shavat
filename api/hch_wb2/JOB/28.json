{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":28,"content":[{"type":"heading","content":["Mɨreutamaiwe kwikariyari"]},{"type":"verse","number":1,"content":[{"text":"Minaxi kanixɨaweni pɨrata mana mayeneika,","poem":1},{"text":"meta hakewa huru mekwaxiyarie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tepɨa kwie hetsie kanayeneikani,","poem":1},{"text":"tetetsie kuwɨre kanayekunarɨwani.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Minaxi hetsie ti'uximayatame yɨriya kaneutiparitɨwani:","poem":1},{"text":"tetexi wayemuinatɨ muta'atɨkatsie,","poem":2},{"lineBreak":true},{"text":"tetexi witsimɨ'anene puwaune waɨkawa muyeyɨwitsie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Teewa paitɨ teɨteri memɨkahakuteitsie,","poem":1},{"text":"teɨteri hatsuaku memɨkahanu'uwatsie peuta'ine,","poem":2},{"text":"'ateewa paitɨ teɨteri memɨkahanu'uwatsie,","poem":1},{"text":"kaunari hetsie 'ukuwietɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwiepa 'ikwai pɨtineika,","poem":1},{"text":"matsi kwie taɨta taikɨ mɨtiutiteke hepaɨ ti'anenetɨ katiniyepika.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tetetsie tete waɨkawa mayeyuyuawi payeneika","poem":1},{"text":"meta tumuanaritsie huru peutitei.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kwixɨ 'ateewa 'uyewietɨ yu'ikwai mɨxeiya pumawe muwa hemarietɨ","poem":1},{"text":"meta piwame pɨka'ixeiyawe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Xewitɨ tɨma yeutanaka mana pɨka'uyeyeiwe,","poem":1},{"text":"meta mayetsi manatɨma mepɨka'unieretɨkɨka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Minaxi mɨ'iniene tete mayetse'i pɨtsunane","poem":1},{"text":"meta hɨrite tsutɨmeyari pukuhekɨata.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Ayeparitsietɨtɨ hewayexawame payeitɨa,","poem":1},{"text":"meta yuhɨxitekɨ pɨtiutaxexeiya waɨkawa mɨraye'atɨka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Haa 'apapatɨ muwawɨtɨkatsie pikuwaune,","poem":1},{"text":"meta tita mɨti'awietsiekai pɨtihekɨata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Matsi, ¿hakewa peikaxeiya mɨtimaiwenikɨ mɨ'ayumieme?","poem":1},{"text":"¿Hakewa petikie mɨreutamaiwenikɨ mɨ'ayumieme?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Xewitɨ tɨma tewi 'atsipɨkatimate kemɨraye'axe,","poem":1},{"text":"'ena kwiepa temanu'uwa pɨka'ukaxexeiyarɨwa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Haa 'emeukatewa mɨpaɨ paine: «'Uwa puyemawe».","poem":1},{"text":"Haramarata mɨpaɨ paine: «'Ena pumawe».","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Huru witsimɨ'anekɨ pɨkayunanainɨa,","poem":1},{"text":"meta pɨrata tsepa waɨkawa mahetekɨ pɨkayu'axinɨa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Huru kwi mukwaxiyariekɨ pɨkayunanainɨa,","poem":1},{"noteId":3},{"text":"meta tete mɨyɨwi mayemerɨkawikɨ meta tete yuawimekɨ mutimerɨka waɨkawa mɨraye'axekɨ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Huru meta tete xikɨri manuyehekɨa hepaɨna pɨka'anene,","poem":1},{"text":"meta mɨtiupata pɨkayɨwe hurukɨ mɨtiwewiyatɨkakɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Matsi titayari tetehexaxatani tete mɨxeta meta mɨtsiɨraɨye.","poem":1},{"text":"Mɨtimaiwenikɨ matsi pɨraye'axe keyuri tetexi mayetataɨrawi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tete mayetaxaɨye Kutsi kwieyaritsie mieme hepaɨna pɨka'ane,","poem":1},{"text":"meta pɨkayɨwe huru 'aixɨa mɨ'anekɨ minaneni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"¿Hakewa kamɨtsɨ payeneika mɨtimaiwenikɨ mɨ'ayumieme?","poem":1},{"text":"¿Hakewa petikie mɨreutamaiwenikɨ mɨ'ayumieme?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yunaitɨ memɨte'u'uwa wahɨxie pɨ'awietɨ,","poem":1},{"text":"metatsiere wikixi wahɨxie pɨyu'awieta.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mɨɨya tiyu'uname matɨa mɨpaɨ meputiyuane:","poem":1},{"text":"«'Etsiwa tepɨtemarie hepaɨtsitana miemekɨ».","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kakaɨyari xeikɨa pɨyɨwe hetsɨana mɨye'ani,","poem":1},{"text":"mɨkɨ xeikɨa pɨtimate hakewa mɨkɨ meyeka.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mɨkɨ kwie manu'atɨkatsie paitɨ pɨniere,","poem":1},{"text":"mɨkɨ naime pɨtixeiya muyuawi hetɨa tita mɨtixɨawe.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kepauka mɨkɨ 'eka tɨrɨkariyaya mupitɨakai","poem":1},{"text":"meta kepauka haa mu'inɨataxɨ kematiyeukakɨ,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"kepauka mukawiwiyenikɨ mupitɨa","poem":1},{"text":"meta wiyeri mɨtɨrɨkawi kemɨtiɨkɨkanikɨ,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"hikɨ kemɨtimaiwenikɨ mɨ'ayumieme kaniuxeiya kani'inɨarita mɨraye'axe hepaɨ katinixeiya,","poem":1},{"text":"kanita'inɨata, hikɨ heitixeiyaxɨaka 'aixɨa kaniyurieni.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Hikɨ teɨteri mɨpaɨ katiniwarutahɨawe:","poem":1},{"text":"«Ti'aitame 'ayemakatɨ mɨtimaiwenikɨ kanihɨkɨtɨni.","poem":2},{"lineBreak":true},{"text":"'Axamɨti'ane hepaɨtsita yukweriwayurietɨ: mɨkɨ mɨreutamaiwe pɨhɨkɨtɨni».","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"huru kwi mukwaxiyarie. Pɨyɨweta mutayɨni huru 'Upixi mieme.","reference":{"chapter":28,"verse":16}}]},"thisChapterLink":"/api/hch_wb2/JOB/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}