{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":29,"content":[{"type":"heading","content":["Kuwi yuxaɨta yatiku'eriwatɨ kemutayɨ"]},{"type":"verse","number":1,"content":["Kuwi tawarita mɨpaɨ kaniutayɨni:"]},{"type":"verse","number":2,"content":[{"text":"«Waɨkawa metserite manuyekɨ nepuku'eriwa,","poem":1},{"text":"kepauka Kakaɨyari mɨnetsi'ɨwiyakaitsie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yɨkɨxemekɨ neheima pɨnetsikɨxiyakai,","poem":1},{"text":"makɨyɨwi hekɨariyayatsie nepuyeikakai.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Iya tukari nepa'eriwa, kepauka yakɨ nemɨnemaikaitsie,","poem":1},{"text":"'ana Kakaɨyari nekii 'aixɨa pɨyuriekai yunaki'eriyakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"»Kepauka 'akuxi Naimekɨmɨtɨrɨkaɨye nehamatɨa muyeikakaitsie,","poem":1},{"text":"meta neniwema ne'aurie memɨtiyaxikekaitsie,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"kepauka retsi kuneriyarikɨ neketatetsie nemeyuhauxinakai,","poem":1},{"text":"meta 'ayeparitsie hatseiti hayari paneikakai,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"kepauka nemayeyeikakai kiekari kitenie wa'ɨxatsitɨwame nemɨhɨkɨtɨkai,","poem":1},{"text":"kepauka yuwaɨkawa memayuxeɨrietsie 'ɨparitsie nemayeixakai,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"temari menetsixeiyame hu mepɨkɨkakai,","poem":1},{"text":"'ukirawetsixi meta mepɨti'uwekai,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"memanuyetei metekuxatatɨ mepɨtekuhayeikawakai","poem":1},{"text":"meta yumamakɨ yutenie mepɨwɨwɨrekai.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Memanuyetei 'a'inɨkai metekuxatatɨ mepakɨkakai,","poem":1},{"text":"meta waneni wateta pukuwewerikekai.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kemɨ'ane memɨnetsi'eniwakai netikuxatakaku, 'aixɨa meputiyuanekai nehepaɨtsita,","poem":1},{"text":"kemɨ'ane memɨnetsixexeiyakai, 'aixɨa meputiyuanekai.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tixaɨtɨ mɨkarexeiya xɨka parewiya ha'iwawani nehetsɨa, ne nepiparewiekai,","poem":1},{"text":"yaxeikɨatatsiere nutui, yuparewiwame mɨkahexeiya.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tixaɨtɨ memɨkatetakwewie 'aixɨa mepɨnetekɨhɨawekai,","poem":1},{"text":"nekɨmana temawierikakɨ","poem":2},{"lineBreak":true},{"text":"wiuraxi wa'iyari putihiwakai.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tita mɨtiheitserie kamixayari nepanakatɨkɨkai,","poem":1},{"text":"mɨkɨ nemata nemuwawiwa pɨhɨkɨtɨkai meta nemu'utsie nemayɨhɨaya heitserie nemexeiyanikɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Memɨkaheuneniere wahetsiemieme wahɨxite nepatɨa,","poem":1},{"text":"memɨka'ɨkɨniwawe wahetsiemieme, wa'ɨkate nepatɨa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Memɨteheuyehɨwa wapaapa nepatɨa,","poem":1},{"text":"meta teewatari wahetsie nunuwame nepatɨa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"'Axamemɨte'u'iyari watamete nepanaye'unaxɨa,","poem":1},{"text":"watametetsie paitɨ wa'ikwai nepayeha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"»'Ana mɨpaɨ nepɨtiu'eri: “Nekiita nepɨmɨni,","poem":1},{"text":"netukari kayu'inɨatsinɨatɨ payani xiekari haramara tetsita mɨtika hepaɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nenanayarite hata paitɨ pɨreukawiyaxɨani,","poem":1},{"text":"haɨtsikari tɨkarikɨ mieme nexawaritsie peukayaxe.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mariweme kenemɨrexeiya nehetsie puyuhayewani witsimɨ'anene,","poem":1},{"text":"meta netupi yanepɨrakweka”.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"»Teɨteri mepɨnetsi'eniwakai neniuki metakwewietɨ kayuwatɨ metetetɨ me'enukwewienike,","poem":1},{"text":"kayuwatɨ me'umatɨ ne'ɨxatsi mepuka'ɨnakai.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ne kepauka nemɨtiutaxaxatakai, xewitɨ 'axapɨka'utainekai nehepaɨtsita,","poem":1},{"text":"neniuki wanakata pɨtikunanakekai.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Neniuki mepɨtakwewiekai me'enukwewienike","poem":1},{"text":"xewitɨ wiyeri 'emɨreutetere kemɨtitakwewie hepaɨ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Xɨka ne nehanaweni newaxeiyatɨ, mɨkɨ yuri mepɨkanete'eririekai,","poem":1},{"text":"nehɨxie nemakananekɨ mɨkɨkɨ mepɨyuwaɨriyakai.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Huye ke'aneme memuweiyani nepuwaxeitsitɨakai,","poem":1},{"text":"ne wayeta nepayeixakai,","poem":2},{"text":"wahamatɨa nepuyeikakai ti'aitame yukuyaxima watsata muyeikani hepaɨ,","poem":1},{"text":"kemɨ'ane memɨyuhiwerie wanɨtɨwame hepaɨ netiyumaitɨ.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/28.json","previousChapterAudioLinks":{},"numberOfVerses":25}