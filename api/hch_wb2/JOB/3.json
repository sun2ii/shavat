{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":3,"content":[{"type":"heading","content":["Kuwi matɨari kemutayɨ"]},{"type":"verse","number":1,"content":["Hikɨ mɨyatiɨyɨku, Kuwi pɨkayɨwekairi kaiwatɨ mumaka hikɨ 'axaputayɨ kepauka mutinuiwaxɨ hetsiemieme."]},{"type":"verse","number":2,"content":["Mɨpaɨ kaniutayɨni Kuwi:"]},{"type":"verse","number":3,"content":[{"text":"«Ke'ukumawere tukari kepauka nematinuiwaxɨtsie mieme","poem":1},{"text":"meta tɨkarikɨ mɨpaɨ mɨtiutaniukietsie: “'Ukitɨtɨ kanetinuiwa”.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mɨkɨ tukari yɨriya kehayani,","poem":1},{"text":"Kakaɨyari 'amautitewa muyeika tɨma yapɨkatimaika,","poem":2},{"lineBreak":true},{"text":"xawaturiya hetsiena tɨma pɨkaxuaweni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yɨriya meta 'etɨriya 'amayetsuye","poem":1},{"text":"hetsiena ketinakeni.","poem":2},{"text":"Haiwitɨri yu'etɨrikɨ ke'enukanani,","poem":1},{"text":"yɨriya hekɨariyaya ke'a'iwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Ana tɨkariyaritsie yɨriya 'e'ayetsuitɨ kenuani,","poem":1},{"text":"mɨkɨ tukari wiyaritsie pɨka'inɨatsieka,","poem":2},{"lineBreak":true},{"text":"meta nixeime metseriyaritsie tɨma pɨka'aka'utsieni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Ana tɨkariyaritsie nixewitɨ pɨkatinunuiwani,","poem":1},{"text":"hiwari temawierikayari mɨkɨtsie pɨkaxuaweni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tɨrɨkariya memexeiya 'axame'utiyuatɨ yameke'utiyuani 'axamɨ'itɨarienikɨ,","poem":1},{"text":"Rewiyatahini","poem":2},{"noteId":0},{"text":"haramaratsie mɨyeyeika meke'anutahɨtɨani.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ximeri miemete xurawetsixi meke'ɨyɨre,","poem":1},{"text":"yakɨ xeikɨa hekɨariya tukarikɨ mieme meke'ukwewieni,","poem":2},{"lineBreak":true},{"text":"meta matɨari xawatɨriya manatineika mepɨkaxeiyani.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Matsi nemaama hukayatsie pɨkareuna nemutinuiwaxɨtsie","poem":1},{"text":"meta mɨka'uta'imakɨ 'ikɨ naime 'uximatɨarika nemɨtixeiyakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"»¿Ketitayari nemɨkitɨ nekatiutinuiwaxɨ?","poem":1},{"text":"¿Ketitayari ne'uweka nekatiɨmɨ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"¿Ketitayari nemaama tunuteyatsie netiukutekie,","poem":1},{"text":"meta tsitsitsie nemɨtsitsitɨarienikɨ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ne hikɨ nekahe'uximatɨarietɨ nepe'uxipiekakeyu,","poem":1},{"text":"tinakemekɨ hikɨ nepekutsunikeyu","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'ena kwiepa te'aitamete meta 'ɨxatsitamete wahamatɨa,","poem":1},{"text":"paratsiyute 'amɨtimamariwawe memutiwewi hikɨ mɨreuyewe,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"kuwexinaruritsixi huru waɨkawa memɨyetua watsata","poem":1},{"text":"meta yukiiteta pɨratate memɨte'utihɨniyaxɨakai.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"¿Ketitari nunutsi manuyewe hepaɨ nekatiuteukie,","poem":1},{"text":"mɨkɨ tɨɨri hatsuaku hekɨariya memɨka'uxei wahepaɨ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mana 'axamemɨte'u'iyari mekatenikuhayeikawani ke'axamemɨteyuriekɨ.","poem":1},{"text":"Mana waɨriyarika memɨte'uximayatsitɨarie mekaniuka'uxipiweni.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yaxeikɨata memanutaxɨriya 'uxipiya kayuwatɨ mekanexeiyakakuni,","poem":1},{"text":"mɨtiwa'aitɨwame hiwarieya memɨka'eniekɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mana mekaniyutinɨnɨweni memɨkamamariwawe meta memɨmamariwawe,","poem":1},{"text":"meta ti'uximayatame yukutsiyari hɨxie kanetatuiyamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"»¿Ketitayari Kakaɨyari memɨte'uka'eniwa tiwapitɨa hekɨariya memɨxeiyanikɨ?","poem":1},{"text":"¿Ketitayari tukari tiwapitɨa memɨte'uka'eniwa?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mɨkɨ memɨkwikwi'ini yamepɨteha'eriwakaku matsi mepɨkaheixeiya mɨɨya,","poem":1},{"text":"tsepanetɨ memiwautɨwe waɨkawa, mɨraye'axe mɨ'awietɨ kememɨkatewautɨwe hepaɨ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Waɨkawamekɨ mepuyutemamawiekakeyu,","poem":1},{"text":"me'utinawetɨ mɨkite memakateukiwatsie xɨka me'atɨarienike.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"¿Ketitayari Kakaɨyari tewi tikunamirie","poem":1},{"text":"yamɨkatimate hakewa metɨa?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Paa nekatakwaiwetɨ 'akuxi, ne'aiwarikakɨ nekanayeikani,","poem":1},{"text":"netsuari haa hepaɨ kanitayeuriweni.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ketita matsi waɨkawa nemɨtimakakai, nehetsie katiniunake,","poem":1},{"text":"ketita matsi waɨkawa munetimariutakai, nehetsie yakatiniuyɨni.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"'Uxipiya meta kayuwatɨ nepɨkahexeiya,","poem":1},{"text":"nemaka'uxipienitsie nepɨkataxeiyawe, 'uximatɨarika xeikɨa nehetsie pɨtinake».","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Pɨkamatsiɨkɨ tita mɨtixata, haxi yatɨni ketsɨ 'amupa hepaɨ.","reference":{"chapter":3,"verse":8}}]},"thisChapterLink":"/api/hch_wb2/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}