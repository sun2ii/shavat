{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":[{"text":"»Hikɨ matsi nehepaɨtsita tɨɨritɨtɨ mekaniutinaweni,","poem":1},{"text":"ne mɨkɨ wapaapama nepɨkawaruhɨritɨawe tɨma","poem":2},{"lineBreak":true},{"text":"netsɨikɨrima nemuxatsima wahɨwemete.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"¿Titakɨ tiyunaki'eriekake nehetsiemieme watɨrɨkariya,","poem":1},{"text":"matsi tɨrɨkariya mekahexeiyakaku?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mete'uka'eniwatɨ haakakɨ meta meteheuyehɨatɨ,","poem":1},{"text":"makumawe 'amanutitewatsie paitɨ mepu'uwakai tɨkarikɨ,","poem":2},{"lineBreak":true},{"text":"yeuta kwiepa mɨkahakietatsie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Ɨtsita tupiriyate ratsiwitɨkaime mepɨtekupitɨwekai","poem":1},{"text":"meta matsikɨi nanayari mepɨkwakai.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mepayeweiyariekai kiekaritsie,","poem":1},{"text":"mewahiwietɨ tenanawayamete wahepaɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Ayumieme puwakietɨkai","poem":1},{"text":"'aki 'utɨma haa muwakitsie,","poem":2},{"lineBreak":true},{"text":"'ai mukatataritɨa meta terɨta.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Ɨtsitsata meputihiwakai,","poem":1},{"text":"tupiriyatsata 'axeikɨa mepɨtihipitekai.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Teɨteri 'atsimemɨkatemate mekanihɨkɨtɨni, 'axamemɨtemariwa,","poem":1},{"text":"'ayumieme yukie mepayeweiyarie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"»Hikɨ matsi ne menetsikuxatatɨ xeikɨa kenemɨ'ane mekaneni'ɨkeni.","poem":1},{"text":"Hikɨ netsi'atsemete mekanakɨne.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mepɨnetsi xani'erie, mepɨnetsi'uku'e'eiriwa,","poem":1},{"text":"nehɨxie mepɨnetsihaye'aɨtsikawiya.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hikɨri matsi Kakaɨyari tixaɨtɨ nekatiyunaki'eriekame mɨnetsi'ayeitɨa,","poem":1},{"text":"nehɨxie 'axame'utiyuatɨ mepɨkatehayewa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Netserieta mepɨti'u yunaitɨ teɨteri menetsimietɨwetɨ,","poem":1},{"text":"mepɨnetsiwiniyatɨwe ne'ɨkatsie","poem":2},{"lineBreak":true},{"text":"meta mepiwewie nehetsɨa kememɨte'aye'axɨani.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nehuyeta mepɨte'anuna,","poem":1},{"text":"xewitɨ mɨkanetsiparewiekɨ yamepɨteyurie memɨnetsika'unakɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Amepahu ne'ixumeritsie memeu'inieni hepaɨ,","poem":1},{"text":"kii 'u'unimetsata mepɨnetsimietɨwe mekatehayewatɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Marika nehetsie punua,","poem":1},{"text":"'aixɨa 'anemekɨ kenemɨtixeiyariekai 'eka hepaɨ petɨa,","poem":2},{"lineBreak":true},{"text":"newikweitsitɨarika hai hepaɨ putiutapaparike.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"»Hikɨta netukari nepɨtatɨmaiyarɨme,","poem":1},{"text":"nekukwiniya kwinimieme pɨneti'uximatɨa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yɨwikɨta ne'umete pɨnetsititara,","poem":1},{"text":"kukuiniya nehetsie pɨkaheununuwa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kakaɨyari yutɨrɨkariyakɨ nekamixatsie pɨnetsiwiya,","poem":1},{"text":"pɨnetsikɨxɨipina nekamixa nekɨipitɨa mieme hepaɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Karima haxuta pɨnetsiheukahɨpa,","poem":1},{"text":"meta naxi tumuanari pɨnetsihayeitɨwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"»Kakaɨyari 'aku, 'ekɨ nepɨmatsihahiwiwa, matsi pepɨkanetsiku'eiya,","poem":1},{"text":"ne 'ahɨxie nepɨ'axe, matsi 'ekɨ waɨriyarika pepɨnetsikuxexeiya.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kwinimiemeri pepɨnetinanaima,","poem":1},{"text":"'atɨrɨkariyakɨ pepɨnetsi'anayewaya.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"'Eka hetsie pepɨnetsiheutahɨpa pepɨnetsi'anuku'enitsitɨwa,","poem":1},{"text":"wiyeri mɨtɨrɨkaɨyetsie pepɨnetsi'uyehɨpa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yanepɨtimate teukiyapa kepemɨnereukatuanikɨ,","poem":1},{"text":"hakewa teyunaitɨ 'atemu'uwa temɨtakukuwe metakiekaritsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"»Matsi kemɨ'ane ma'iwarie tawari menukawaxɨani pɨkayɨwe,","poem":1},{"text":"tiuka'eniwatɨ mahiwa parewiya ha'iwawatɨ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ne memɨte'uka'eniwa wahetsiemieme neputatsuaka.","poem":1},{"text":"Tixaɨtɨ memɨkatehexeiya wahetsiemieme nekaninehɨaweni.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kepauka 'aixɨa mɨti'ane nemɨtikwewiekai, 'axamɨti'ane pɨtinua,","poem":1},{"text":"kepauka hekɨariya nemukuwaunekai, yɨriya pɨnua.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nepɨkatihayewa netaɨta neyɨhɨawetɨ,","poem":1},{"text":"nepɨtinewie netiuka'eniwatɨ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Nenehɨawetɨ 'anepuyeika, matsi tau mɨxɨkakɨ hawaikɨ,","poem":1},{"text":"teɨteri wahɨxie neputakeka, parewiya newautɨ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Yawixi memayu'eririya wa'iwa nepatɨa,","poem":1},{"text":"nɨpexitsixi tɨkarikɨ miemete wa'iwa.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Nenawiyari pukatai, meta kanikatsanikeni,","poem":1},{"text":"naitɨ newaiyari pɨta'a hɨiyakɨ.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Nekanari yuariyaya hiwerika pɨhɨkɨ,","poem":1},{"text":"nepirikɨxa yuariyaya nutuixiya pɨhɨkɨ.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/29.json","previousChapterAudioLinks":{},"numberOfVerses":31}