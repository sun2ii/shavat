{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":[{"text":"»Ne nehɨxitekɨ tɨratu nepuwewiekai","poem":1},{"text":"kapa 'uka ne'uxeiyakɨ ne'ihiwe'erietɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"¿Kakaɨyari 'amutewi hetsɨa timieme ketita neranunakekeyu?","poem":1},{"text":"¿Ketita netiyetuiriyarienikeyu Naimekɨmɨtɨrɨkaɨye hetsɨa timieme 'emeutitewatsie?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Axateyuruwamete memɨka'unarienikɨ kaniwahetsiemiemetɨni","poem":1},{"text":"meta 'axamekani'itɨariekuni 'axamemɨte'u'iyari.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"¿Kamɨtsɨ Kakaɨyari kanetixeiya kenemɨtiuyeika","poem":1},{"text":"meta kati'inɨata kenemɨtiumiekɨ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"»Xɨka 'axa'anemekɨ ne'uyeikani,","poem":1},{"text":"yatɨni kwamanarikakɨ xeikɨa neyumexɨitɨaka,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kakaɨyari kenetsi'u'inɨata ti'inɨnɨatame 'aixɨa mɨ'anekɨ,","poem":1},{"text":"hikɨ 'ana yapɨretimani kename 'atsinemɨkatiuyuri nehɨkɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Xɨka kenemɨtiuyeikakɨ ne'uku'eirieni,","poem":1},{"text":"xɨka ne'iyari nehɨxite tita mɨtihiwe'erie 'anukuweiya,","poem":2},{"lineBreak":true},{"text":"yatɨni nemamakɨ mɨirikɨa tewinɨari netihɨniyani,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"mekete'utikwani hipatɨ tita ne nemɨtiuka'e,","poem":1},{"text":"meta naitɨ ne'etsari kereuyehɨiyani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"»Xɨka xeime 'ukaratsikɨ netiu'irɨwiyarieni,","poem":1},{"text":"xɨka nehepaɨ tewi kitenie ne'utihupakaitɨni,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"kamɨtsɨ ne'ɨya xeime 'uki 'ikuya ke'ukatɨxɨ,","poem":1},{"text":"meta hipatɨ 'ukitsi hamatɨana meke'ukahini.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mɨkɨri yemekɨ tewiyarika pɨhɨkɨtɨnikeyu,","poem":1},{"text":"'axamɨti'ane mɨkɨkɨ nemutaxanetsiewekaikɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"'Ɨkwari mɨreuyehɨani hepaɨ pɨtimatsiɨkɨnike.","poem":1},{"text":"Naime mɨrakɨxɨtsitɨa tita nemɨtiuka'e nanayari 'ɨarime hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"»Xɨka neyuta'imani 'aixɨa nemɨtiyurienikɨ","poem":1},{"text":"nete'uximayatsiriwamete 'ukitsi meta 'ukari wahetsiemieme,","poem":2},{"lineBreak":true},{"text":"kepauka memɨnetsi'anati'eiyakaitsie,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"¿keri netayɨni kepauka Kakaɨyari mɨnetsita'iwawiyatsie?","poem":1},{"text":"¿kenehaineni kepauka mɨnetsitakwewienitsie?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mɨkɨ Kakaɨyari nemaamatsie mɨnetsiyeweriyaxɨ","poem":1},{"text":"mɨkɨtatsiere mɨwarutiwewi kanihɨkɨtɨni,","poem":2},{"lineBreak":true},{"text":"tamaamama wahetsie teyetekaku kataniutiwaweriya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"»Hatsuaku nepɨkatiuhayewaxɨ memɨteheuyehɨwa wa'iwaurika ne'enietɨ,","poem":1},{"text":"meta wiuraxi nepɨkawaruhayewaxɨ mekwiximeme,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"hatsuaku paa nexaɨta nepɨka'utakwai,","poem":1},{"text":"meta nutuite nekatiwakweririetɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nemɨtemaikɨtɨkaitsie paitɨ ne wahetsiemieme wapaapa nepɨhɨkɨ,","poem":1},{"text":"nunutsiyari paitɨ wiuraxi nemuwaruwitɨxime nepɨhɨkɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Xɨka xeime ne'uhayewa yu'ixuriki kahexeiyatɨ mɨmɨnikɨ,","poem":1},{"text":"yatɨni xewitɨ mɨreuyehɨwa mɨranakatɨni karexeiyani,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"xɨka mɨkɨ yu'iyarikɨ 'aixɨa kahaineni","poem":1},{"text":"nemuxatsi wahuxarikɨ newarutikemaritɨaku,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"yatɨni xɨka nutuite wahetsiemieme nemama ne'utatsera","poem":1},{"text":"waɨkawa nemɨyɨwekaikɨ heitseriekamekɨ yanemɨtayɨnikɨ 'itsɨkame nehɨkɨtɨtɨ,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"nemamate kehewayexɨnixɨani nenaiparita,","poem":1},{"text":"mɨrewayewiyatɨkatsie kehewayetekixɨani.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yuheyemekɨ ne Kakaɨyari yamɨtiwarakapitɨwakɨ nepɨmakaxe,","poem":1},{"text":"mɨkɨ ti'aitame mumariwe hɨxie nepɨkayɨwe nemɨyɨxɨna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"»¿Kamɨtsɨ tuminitsie xeikɨa netita'ikwewa,","poem":1},{"text":"yatɨni huru 'aixɨa mɨ'ane mɨpaɨ nerehɨawe: “'Ahetsie nepɨtiwiya”?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Piinitɨarika waɨkawa kenemɨrexeiyakai","poem":1},{"text":"hatsuaku mɨkɨkɨ nepɨkaheyuta'ɨrixɨ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Tau xawatɨriyaya mariweme nepɨkahayeitɨwa,","poem":1},{"text":"yatɨni metseri xawatɨriyaya,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"'awietɨma nepɨkawarayexeiya,","poem":1},{"text":"meta 'itsiya netenie mieme nepɨkawarenɨ'airiwa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"'Ikɨ 'axamɨti'anekɨ yaxeikɨata nepɨtaxanetsienikeyu,","poem":1},{"text":"Kakaɨyari muyuawitsie makawe nepuku'eirienikekai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"»Hatsuaku nepɨkayukatemawi mɨnetsi'aye'unie 'atiweku.","poem":1},{"text":"Meta tiuka'eniwakaku.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Hatsuaku neteta 'axanepɨka'utayɨ xeime hetsiemieme","poem":1},{"text":"'axakehe'itɨarieka nehaitɨ.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"¿Kemɨ'ane nekiita pɨka'utahuxai,","poem":1},{"text":"kemɨ'ane nemexatsie mɨrapikai pɨkatiutikwai?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Hatsuaku yeikame nekitenie nepɨkareunamiri,","poem":1},{"text":"hatsuaku nemɨka'imate yɨwikɨta kaye'utɨa pɨkahekatei.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Hatsuaku ke'axanemɨtiuyuri nepɨka'anukana,","poem":1},{"text":"hipatɨ teɨteri wahepaɨ,","poem":2},{"text":"nehetsie mɨkarahɨiwanikɨ nepɨkahanukanakai,","poem":1}]},{"type":"verse","number":34,"content":[{"text":"hipatɨ 'axamenete'utahɨawekɨ.","poem":2},{"text":"Hatsuaku kayuwatɨ nepɨkatiuya meta nekiita nepɨkaheuyunakai","poem":1},{"text":"newamakatɨ ne'iwama memunetsinenixeiyanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"»Matsi yemekɨ yanepɨra'eriwakaku xɨka Kakaɨyari netsi'u'enienike.","poem":1},{"text":"'Ena netseyu nepaumani:","poem":2},{"lineBreak":true},{"text":"Naimekɨmɨtɨrɨkaɨye kenetsi'uta'eiya.","poem":2},{"text":"Xɨka mɨkɨ netsimiemɨkɨni,","poem":1},{"text":"mɨpaɨ mɨkɨ yakeraka'utɨani.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Mɨkɨ xanetsika nenaiparitsie nepikɨtɨneni,","poem":1},{"text":"meta kuruna hepaɨ nekanenamakamɨkɨ.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Hɨxiena nepɨtakeni nemanuyeka nemɨhɨkɨtɨni hepaɨ,","poem":1},{"text":"meta nepɨtitaxatɨani xexuimekɨ kenemɨtiuyeikakaikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"»Xɨka nekwie nehepaɨtsita hahiwani,","poem":1},{"text":"meta naitɨ xurukuyari xɨka 'utitsuanani,","poem":2}]},{"type":"verse","number":39,"content":[{"text":"xɨka xeime 'itsanarieya ne'utikwani nekatipitɨaka,","poem":1},{"text":"yatɨni xɨka wakutsiyarima memɨkayuwaɨriyanikɨ newaru'uximatɨani,","poem":2}]},{"type":"verse","number":40,"content":[{"text":"hikɨ nekwiepa tɨriku hetsiemieme xuya pɨta ke'utinexɨani,","poem":1},{"text":"meta tupiriya tsewara hetsiemieme».","poem":2},"Mɨpaɨ Kuwi 'utayɨka katinanunɨni tikuxatatɨ."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}