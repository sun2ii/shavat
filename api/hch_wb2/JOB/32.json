{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":32,"content":[{"type":"heading","content":["'Erihu kemɨranuyeha titaxatake"]},{"type":"verse","number":1,"content":["Kepauka Kuwi hamikumama memuyuhaika memɨtehetima kename mɨkɨ heitserie mexeiya yu'eriekai, 'anari mepɨka'ita'ei."]},{"type":"verse","number":2,"content":["Matsi 'Erihú Warakeri nu'aya Wutsi kiekame, Xamɨ nuiwarieya hetsie mumiemetɨkai, waɨkawa Kuwi hepaɨtsita kaniuyeha'ani, Kakaɨyari heitserie kahexeiyame mayeitɨakɨ, mɨkɨ pɨta yɨkɨmana heitserie hexeiyame mayuyeitɨakɨ."]},{"type":"verse","number":3,"content":["Yaxeikɨata hamikumama memuyuhaika wahepaɨtsita kaniuyeha'ani memɨka'ɨyɨwekaxɨakɨ Kuwi memɨta'eiyakɨ meta hetsiena memɨte'ɨhɨakɨ."]},{"type":"verse","number":4,"content":["Merikɨte 'Erihú kaniwatakwewiekaitɨni Kuwi 'akuxi katitaxatɨawetɨ, mɨkɨ waɨkawa wiyari memexeiyatɨkateikɨ,"]},{"type":"verse","number":5,"content":["matsi kepauka mɨwaruxei memuyuhaika meka'utiniukame, waɨkawa kaniuyeha'ani."]},{"type":"verse","number":6,"content":["Hikɨ kaniutaniuni 'Erihú Warakeri nu'aya Wutsi kiekame: Matɨari 'Erihu kemutayɨ",{"text":"«Ne yemekɨ nepɨtemaikɨ, xemeta xepu'ukirawetsixi,","poem":1},{"text":"'ayumieme waɨkawa nepumakai","poem":2},{"lineBreak":true},{"text":"kenemɨtiku'eriwa yanemɨtayɨnikɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mɨpaɨ nepɨtiunehɨawixɨ: “'Ukirawetsixi meri meke'utiniuni kememɨte'uyemate,","poem":1},{"text":"'ukirawetsixi meri kememɨtemaiwawe meke'itahekɨata”.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Matsi tewi meitimaitɨyeikanikɨ mupitɨa","poem":1},{"text":"'iyari hetsiena mɨyeka kanihɨkɨtɨni,","poem":2},{"lineBreak":true},{"text":"Naimekɨmɨtɨrɨkaɨye 'iiya 'ipitɨakaku.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Ukirawetsixi xeikɨa memɨtemaiwawe mepɨkahɨkɨ,","poem":1},{"text":"meta 'ayumaitɨ xeikɨa pɨkaretimani tita mɨtiheitserie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"»'Ayumieme waɨkawamekɨ nepɨxewawirie, xemɨnetsi'enienikɨ,","poem":1},{"text":"netatsiere 'etsiwa nepɨrexeiya nemɨtixetaxatɨanikɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mexi xetekuxatakai, kayuwatɨ nepɨtikatei nexekwewietɨ","poem":1},{"text":"meta nexe'enietɨ 'aixɨa kexemɨtekuxatakaikɨ,","poem":2},{"text":"mexixi niuki xewautɨwekai,","poem":1}]},{"type":"verse","number":12,"content":[{"text":"yemekɨ waɨkawamekɨ nepi'eni.","poem":2},{"text":"Matsi 'akuxi xepɨkayɨwawe yaxemɨtehetimanikɨ kename Kuwi yuri ka'utaine,","poem":1},{"text":"xewitɨ pɨka'ita'eiyawe mɨkɨ kemɨtikuxatakɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mɨpaɨ xepɨkahaitɨkani: “Tameri mɨtimaiwenikɨ mɨ'ayumieme tepukaxei,","poem":1},{"text":"Kakaɨyari ke'ita'eiya, matsi teɨteri pɨkatixaɨ”.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kuwi nehepaɨtsita 'atsipɨkahaine,","poem":1},{"text":"meta ne xehepaɨ nepɨkatita'eiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"»Kuwi, 'ahamikuma mepuyuxamurie,","poem":1},{"text":"mepɨkayɨwawe memuti'anikɨ, niuki pɨwareuyehɨwa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"¿Neta kayuwatɨ netiyerɨni,","poem":1},{"text":"mɨkɨ memɨkamatsi'uta'eikɨ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Netatsiere nepɨrexeiya yanemɨtayɨnikɨ,","poem":1},{"text":"meta nematsiɨkɨme nepayeitɨani kenemɨtiuyematekɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Niukikɨ nepɨka'ixɨa,","poem":1},{"text":"'iyari nehetsie mɨyeka waɨriyarika pɨnetsipitɨa nemɨtaniunikɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Winu pɨteyutsie mɨyema hepaɨ nekani'aneni,","poem":1},{"text":"winu nawi kɨxauriyari mɨhekwatsie yematɨ mɨtatsanirɨme hepaɨ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Peuyewetse nemɨtaniuni meta nemɨnenɨtɨanikɨ,","poem":1},{"text":"neteni nepanutayepieni yanemɨtita'anikɨ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ne xeime hetsiemieme nepɨkataniuni,","poem":1},{"text":"meta xeime witsinepɨkatitahɨawe.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ne xeime witsinepɨkareutaxatɨawe,","poem":1},{"text":"xɨka mɨpaɨ netiutiyurieni, kemɨ'ane mɨnetsi'utawewi pɨnetikwinitɨani.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/31.json","previousChapterAudioLinks":{},"numberOfVerses":22}