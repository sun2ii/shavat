{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"»Kuwi, nepɨmatsiwawirie neniuki pemɨ'enienikɨ,","poem":1},{"text":"yemekɨ pemi'enienikɨ naime kenemɨtayɨni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Ariri neteni nekananutayepieximeni,","poem":1},{"text":"nekatinitaxatamɨkɨ nekawaɨripiwetɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Neniuki 'iyari 'aixɨa mɨtiuka'iyaritsie kaniyekɨkani,","poem":1},{"text":"neteni yakatinimaika heitseriemekɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kakaɨyari 'iyarieya pɨnetsi'utawewi,","poem":1},{"text":"Naimekɨmɨtɨrɨkaɨye 'iiyaya tukari pɨnetsi'upitɨa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xɨkapeyɨweni, keneneuta'eiya,","poem":1},{"text":"keneu'akuha'aritɨa, yapemɨneranutahɨawixɨanikɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kakaɨyari hɨxie, 'ekɨ matɨa ne yaxeikɨa tepɨ'anene,","poem":1},{"text":"netatsiere kwiekɨ nekaniwewiyakametɨni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Pepɨka'utimamaweni meta pepɨkanetsimakaka,","poem":1},{"text":"meta nemamá haheteme 'ahetsie pepɨka'erieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"»Matsi wa'atɨ mɨpaɨ nepɨtiu'enaxɨ mɨpaɨ pepainekai","poem":1},{"text":"(ne nepa'eriwa):","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Ne 'axanepɨkatiyuruwame. 'Axamɨti'ane nepɨkarexeiya.","poem":1},{"text":"Nepɨ'itiya meta nehetsie pɨkarahɨiwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Matsi, Kakaɨyari nehetsie waɨkawa pɨtiɨhɨa,","poem":1},{"text":"nemeye'unie pɨnetsi'ayeitɨa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne'ɨkatetsie tepɨa karenakɨ pɨnetsi'ɨhɨa","poem":1},{"text":"meta kenemɨtikuyeika pɨnetsita'ɨwiya”.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"»Matsi keneneupitɨa yanemumatitahɨawekɨ kename yakɨ pe'utaine,","poem":1},{"text":"matsi Kakaɨyari pumariwe keyuri teɨteri.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"¿Titayari hetsiena mieme pere'ahaxɨatɨwa","poem":1},{"text":"kename kamatsiku'eiya pe'utaitɨ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kakaɨyari waɨkawamexɨa yakatatinahɨaweni,","poem":1},{"text":"tsepa temɨka'i'enie.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Heiwa tekutsukaku taheinɨtsita,","poem":1},{"text":"heiwata yɨwikɨta katatinixeiyatsitɨaka,","poem":2},{"text":"kepauka yemekɨ kwi tekutsukaku,","poem":1},{"text":"yatɨni kepauka herie temɨtikukutsu ta'utatsie,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"mɨkɨ tanakata pɨtatsikɨhɨawe","poem":1},{"text":"meta temumamakakɨ pɨtatsihayemari'itɨwa,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"mɨtatsipatakɨ 'axaketemɨteyuriekɨ","poem":1},{"text":"meta temɨtehayewanikɨ teyuta'ɨretɨ,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"mɨki teukiyata temɨkaheukaxɨrienikɨ,","poem":1},{"text":"meta mɨki kitenie temɨkaheutahaxɨanikɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Heiwa Kakaɨyari waɨkawa kukuiniyakɨ pɨraka'enitsitɨiya,","poem":1},{"text":"ra'umete kwinimieme ratikukuinetɨ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"'Ana tawaiyari 'ikwai pɨtixani'erie,","poem":1},{"text":"'ikwai witsimɨ'anenekɨ putahewa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Tawaiyari tepeuyehɨpa kayuhekɨakamekɨ,","poem":1},{"text":"ta'umete muyukuhekɨkɨare muti'inɨata pɨyɨwe.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"'Ana pehurani temakateukienitsie,","poem":1},{"text":"rahetsieri paye'aximeni mumɨnikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"»Matsi xɨka xewitɨ niuki tuayame, xeimiriyari watsata 'ayeneme,","poem":1},{"text":"tewi hetsiemieme xɨka 'utaniuni,","poem":2},{"lineBreak":true},{"text":"xɨka ya'utayɨni kename heitserie hexeiya,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"xɨka 'itinenimayata meta Kakaɨyari xɨka mɨpaɨ tiutawawirieni:","poem":1},{"text":"“Keneutawikweitsitɨa mɨki teukiyata mɨkaheukahɨiwanikɨ,","poem":2},{"lineBreak":true},{"text":"'ari hetsiena mieme nemɨtiyutuani nekanexeiyani”,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"hikɨ 'ana tewi kanitahekwariyariemɨkɨ,","poem":1},{"text":"nunutsiyari kemɨ'anekai hepaɨ 'anetɨ kanayeimɨkɨ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kakaɨyari pɨtahɨawe, mɨkɨta piparewieni,","poem":1},{"text":"hɨxiena pixeiyani hikɨ yutemawietɨ pɨtahiwa,","poem":2},{"lineBreak":true},{"text":"meta 'ana Kakaɨyari 'atsikatiyuruwame payeitɨani.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"'Ana tewi yumɨireme wahɨxie yapɨtayɨni:","poem":1},{"text":"“'Axanepɨtiuyuri, mɨtiheitserie neputsewixima,","poem":2},{"lineBreak":true},{"text":"matsi mɨkɨkɨ yanepɨkarakapitɨarie.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kakaɨyari pɨnetsi'utawikweitsitɨa mɨki teukiyapa nepɨkaheukawe,","poem":1},{"text":"nepayeyuri, hekɨariyatsie 'akuxi nepuyeika”.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"»'Ikɨ naime Kakaɨyari yapɨtiyuriene","poem":1},{"text":"heiwamieme, hutarieka meta hairieka paitɨ,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"mɨtatsitawikwetsitɨanikɨ temɨkakwinikɨ,","poem":1},{"text":"hekɨariya tukaritsie mieme mɨtatsihekɨariwiyanikɨ 'akuxi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"»Kuwi, yemekɨ keneneu'eni,","poem":1},{"text":"kayuwatɨ ketinekani, nepɨtaniuni.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Xɨka perayexeiyani, keneneuta'eiya,","poem":1},{"text":"keneutaniu, ne xatsunikɨ nepɨmatitaxatɨanikeyu.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Yatɨni pepɨkatitaxata, kayuwatɨ keneneu'eni","poem":1},{"text":"ne kemɨtimaiwenikɨ nepɨmatitaxatɨani».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/32.json","previousChapterAudioLinks":{},"numberOfVerses":33}