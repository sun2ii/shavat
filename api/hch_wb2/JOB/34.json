{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":34,"content":[{"type":"heading","content":["Hutarieka 'Erihú kemutayɨ"]},{"type":"verse","number":1,"content":["Metatsiere 'Erihú mɨpaɨ kaniutayɨni:"]},{"type":"verse","number":2,"content":[{"text":"«Xeme temaiwawemete, neniuki xekeneu'eni,","poem":1},{"text":"xeme 'ɨxatsitɨariekate, yemekɨ xekeneneu'eni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Naka 'enakareme niuki puwata'inɨnɨata,","poem":1},{"text":"neni 'ikwai mɨrewata'inɨnɨata hepaɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Teyunaitɨ 'ikɨ mɨyamɨti'ane tepeitimaixɨani,","poem":1},{"text":"yatepɨtiyuani teyunaitɨ tita matsi 'aixɨa mɨti'ane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"»Kuwi mɨpaɨ putaine: “Ne 'axanepɨkatiyuruwame,","poem":1},{"text":"matsi Kakaɨyari nehetsie 'aixɨa mɨtiyurieni pɨkayuwaɨriya.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mɨti'itawa nekani'eriwanitsɨari,","poem":1},{"text":"tsepa tewi heitserie nemexeiya nemɨhɨkɨ,","poem":2},{"text":"'ɨrɨteya 'ari pɨnetsimiexime,","poem":1},{"text":"tsepa 'axanekatiuyuri”.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"¿Hakewa xewitɨ Kuwi hepaɨ 'anetɨ peyeika,","poem":1},{"text":"yunanaimarika haretɨ haa hepaɨ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kaninakeni 'axateyuruwamete muwatemawiekakɨ","poem":1},{"text":"meta 'axamemɨte'u'iyari muwanɨkakɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Meta mɨpaɨ putaine kename tewi tixaɨtɨ kara'iwa","poem":1},{"text":"Kakaɨyari naki'eritɨatɨ xeikɨa xɨka 'uyeikani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"»Teɨteri xemɨtemaiwawe xekeneneu'eni:","poem":1},{"text":"Kakaɨyari 'axamɨtiuyurieni pɨkayɨwe,","poem":2},{"lineBreak":true},{"text":"meta Naimekɨmɨtɨrɨkaɨye kemɨkatiheitseriekɨ yapɨkatiyurieni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kakaɨyari tewi kemɨtiu'uximayataxɨkɨ yapɨrekapitɨwa,","poem":1},{"text":"kemɨreuyewetse hetsiena yapɨtiyuriene.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mɨpaɨ tepɨkateku'eriwani kename Kakaɨyari kemɨkatiheitserie tiyuriene.","poem":1},{"text":"Naimekɨmɨtɨrɨkaɨye heitserie kemɨrexeiya pɨka'anutuna.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"¿Kemɨ'ane kwiepa tɨrɨkariyaya pipitɨa?","poem":1},{"text":"¿Kemɨ'ane penukake kwiepa mɨti'ɨwiyanikɨ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Xɨka mɨpaɨ tiu'erieni kename yu'iyari tatsinawairieni,","poem":1},{"text":"yu'iiya xɨka tatsi'unawairieni kɨmana tukari temexeiyakɨ,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"yunaitɨ teɨteri mekaniukumaweriweni,","poem":1},{"text":"yunaitɨ tumuanari mekanakɨniwaweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"»'Ikɨ ketineu'eni, xɨka yurikɨ petimaiweni,","poem":1},{"text":"yemekɨ keneu'eni kenemɨtayɨni.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"¿Tiyɨwekuta tita mɨtiheitserie tixani'erietɨ mɨtiuta'aita?","poem":1},{"text":"¿Kamɨtsɨ Kakaɨyari heitserie mexeiya mɨtɨrɨkaɨye hetsie perahɨani,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"kemɨ'ane te'aitamete memamariwaweme mɨkawarayeitɨa","poem":1},{"text":"meta memɨtɨrɨkawi yatiwakɨhɨawetɨ 'axakememɨteyuriekɨ?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kakaɨyari te'aitamete mexɨakate xeikɨa waɨkawa pɨkawaparewie,","poem":1},{"text":"meta xikutsixi xeikɨa pɨkawaparewie tixaɨtɨ memɨkateheuxeiya kawanaki'erietɨ.","poem":2},{"lineBreak":true},{"text":"Yunaitɨ matsi mɨkɨ 'iwewarimama mepɨhɨkɨ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yapauka tɨkari hixɨapa menitakukuweni,","poem":1},{"text":"teɨteri mekanitiyɨyɨakani marikakɨ mekanitakukuweni,","poem":2},{"text":"Memɨmamariwawe mekananakaxɨriwani","poem":1},{"text":"teɨteri 'atsimekateyuriekaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"»Kakaɨyari hɨxiteya teɨteri wahuye pɨwaxeirie,","poem":1},{"text":"mɨkɨ yuxexuitɨ kememɨte'u'uwa pɨ'ɨwiya.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Pumawe yɨriya meta 'etɨri 'emayetsuye","poem":1},{"text":"'axateyuruwamete mɨwati'awietakɨ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kakaɨyari mitixeiyaxɨani pɨkaheuyewetse","poem":1},{"text":"kepauka muwata'iwawiyakɨ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Pɨkati'iwauni 'akuxi memɨmamariwawe muwaranakaxɨrienikɨ,","poem":1},{"text":"meta hipame pɨta muwaranuti'uitɨanikɨ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kakaɨyari naime katinaka'utɨwani kememɨteyurie,","poem":1},{"text":"yɨwikɨta kaniwaratixɨrɨwani meta kaniwatiketsinani,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"putiwaruka'enitsitɨwa ke'axamemɨte'uyurikɨ","poem":1},{"text":"yunaime teɨteri wahɨxie,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"me'iweiyatɨ memɨte'uhayewaxɨkɨ","poem":1},{"text":"'aitsikaya memɨka'anuku'erikɨ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Hetsɨana paitɨ memiye'atɨakɨ","poem":1},{"text":"tixaɨtɨ memɨkatehexeiya meta memɨteheuyehiwa wahiwari,","poem":2},{"lineBreak":true},{"text":"hikɨ Kakaɨyari kani'enieni.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"¿Matsi kepaikɨ hetsiena pɨrahɨawe","poem":1},{"text":"xɨka mɨkɨ kayuwatɨ tiuyerɨni?","poem":2},{"text":"¿Kepaikɨ pixeiyawe xɨka yunierika 'awietani?","poem":1},{"text":"Mɨkɨ yunaime teɨteri meta wakiekari waheima pɨkawe,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"'axamemɨte'u'iyari memɨkate'aitanikɨ","poem":1},{"text":"meta teɨterimama waruwiniyakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"»Xɨka 'ipaɨ petitahɨawe:","poem":1},{"text":"“Yurikɨ ne'axanepɨtiuyuri, tawariri 'axanepɨkamatitahɨawe.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Yakenetineuta'ɨkitɨa tita 'akuxi nemɨkatixeiya,","poem":1},{"text":"xɨka 'axanetiuyurieni, tawariri mɨpaɨ nepɨkatiyurieni”.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"¿Kakaɨyari metiupitɨawe,","poem":1},{"text":"'ekɨ kemɨmatinake,","poem":2},{"lineBreak":true},{"text":"tsepa 'ekɨ pemɨka'itanaki'eri?","poem":2},{"text":"Ne nepɨkahɨkɨ yanemɨtayɨni, matsi 'ekɨ pɨta,","poem":1},{"text":"'ayumieme yakeneutayɨki kepemɨtiku'eriwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"»Memɨtemaiwawe yamekenete'utahɨawe","poem":1},{"text":"meta xeme xemeti'enatɨkɨka xemɨnetsi'enie:","poem":2}]},{"type":"verse","number":35,"content":[{"text":"“Kuwi 'atsikatimaitɨ putaine,","poem":1},{"text":"niukieyatsie pumawe meitimaitɨyanikɨ”.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Kuwi keheutixeiyariexɨani,","poem":1},{"text":"'axatiyuruwame hepaɨ kaniutayɨni.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"'Axatiuyuriekatɨtɨ tawari 'akuxi mɨkaheu'ena kanayuyeitɨwani,","poem":1},{"text":"meta 'akuxi tahɨxie kataniyuriyani,","poem":2},{"lineBreak":true},{"text":"metatsiere Kakaɨyari hepaɨtsita waɨkawa 'axakaniutayɨni».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/33.json","previousChapterAudioLinks":{},"numberOfVerses":37}