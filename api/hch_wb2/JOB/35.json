{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":35,"content":[{"type":"heading","content":["Hairieka 'Erihú kemutayɨ"]},{"type":"verse","number":1,"content":["Metatsiere 'Erihú mɨpaɨ kaniutayɨni:"]},{"type":"verse","number":2,"content":[{"text":"«¿Kuwi, heitserie pehexeiyame peti'a'erie kepauka 'ipaɨ pemutaine:","poem":1},{"text":"“Ne matsi heitserie nepexeiya keyuri Kakaɨyari”?,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"meta 'ipaɨ pemɨtita'iwawiyakɨ:","poem":1},{"text":"“¿Titakuta rayani nehetsie xɨka 'axanekatiuyurieni?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Aixɨa kani'aneni, ne nekanixeta'eiyamɨkɨ","poem":1},{"text":"'ekɨ, meta 'ahamikuma.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Muyuawitsie keneutinieri, kwi keneuyu'ɨwiya,","poem":1},{"text":"haiwitɨri meutitewatsie keneutixeiya.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xɨka 'axapetiuyurieni, ¿Kakaɨyari titakɨ 'axapetiyurie?","poem":1},{"text":"Xɨka waɨkawa 'axapetiuyurieni, ¿Titakɨ petikwinitɨa?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Xɨka 'aixɨa petiuyeikani, ¿tita petipitɨa?","poem":1},{"text":"¿Ketita ranupini 'ahetsɨa timieme?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tsepa 'axapemɨtiyuriene yatɨni 'aixɨa pemɨtiyuriene,","poem":1},{"text":"kemɨ'ane yamemɨ'itɨarieni 'ahepaɨ teɨteri wahetsie katininakimɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"»Yunaitɨ teɨteri meputihiwa 'axamɨti'ane waɨkawa manutatekekɨ wahetsie,","poem":1},{"text":"parewiya mepa'iwawa memɨxɨnarienikɨ mɨtɨrɨkaɨye muwananaimakɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Peru xewitɨ mɨpaɨ pɨkahaine: “¿Hakewa Kakaɨyari, mɨnetsi'utawewi,","poem":1},{"text":"tɨkarikɨ tɨrɨkariya hekwame mɨnetsikupitɨwa,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"waɨkawa mɨtati'ɨkitɨa keyuri yeutari memumariwawe,","poem":1},{"text":"waɨkawa tetemaiwaweme mɨtatsi'ayeitɨa keyuri wikixi?”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xɨka Kakaɨyari teɨteri mehahiwatɨkaikaku kawaku'eiyani,","poem":1},{"text":"karikɨ 'axamemɨte'u'iyarikɨ memuyuti'ɨrekɨ kaniyɨaneni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kakaɨyari pɨkawa'enie tixaɨtɨ mɨkatihɨkɨ memuku'iwawakɨ,","poem":1},{"text":"Naimekɨmɨtɨrɨkaɨye pɨkawa'enimɨkɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tsepa kepauka kename peka'ixeiya pemaine,","poem":1},{"text":"kepemɨtiuyuri hɨxiena pɨti'ane, 'ayumieme peuyewetse pemikwewieka.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Ekɨ mɨpaɨ peputaine kename Kakaɨyari kahayu'eriya meta karaka'enitsitɨani,","poem":1},{"text":"meta kename 'atsikaretimamate waɨkawa 'axamɨti'ane hepaɨtsita,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"matsi 'ekɨ Kuwi, 'atsipekatimaitɨ peputaniuka,","poem":1},{"text":"waɨkawa peputaniuka matsi 'atsipepɨkatimate kepemutaine».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}