{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":36,"content":[{"type":"heading","content":["Naurieka 'Erihú kemutayɨ"]},{"type":"verse","number":1,"content":["'Erihú kaniyeweiyakaitɨni mɨpaɨ 'utaitɨ:"]},{"type":"verse","number":2,"content":[{"text":"«Ketinenewieka 'akuxi nepɨmatitaxatɨani","poem":1},{"text":"Kakaɨyari hetsiemieme 'akuxi nepɨtitaxata.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kenemɨtiuyemate 'ateewa peyetɨa,","poem":1},{"text":"yanepɨtayɨni mɨnetsi'utawewi heitseriemekɨ pɨtiyuriene.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yurikɨ nepaine neniuki pɨka'itarika,","poem":1},{"text":"tewi mɨtimaiwe 'ahɨxie pepuketsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"»Kakaɨyari pɨtɨrɨkaɨye, 'atsimɨkatiyuruwame pɨka'anuyehɨpa,","poem":1},{"text":"Kakaɨyari pɨtɨrɨkaɨye, meta naime pɨtimate.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Axamɨtiuka'iyari 'amuyeikanikɨ pɨkapitɨa,","poem":1},{"text":"matsi mu'uximatɨarie heitserie kemɨrexeiyanikɨ pupitɨa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Heitseriemekɨ memu'uwa yuheyemekɨ puwa'ɨwiya,","poem":1},{"text":"te'aitamete wahamatɨa memɨte'aitanikɨ puwapitɨa","poem":2},{"lineBreak":true},{"text":"meta yuheyemekɨ waheima puwaka'uitɨwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Matsi xɨka mehɨatɨkani karenakɨ,","poem":1},{"text":"xɨka me'uximatɨarietɨkani kaunarikɨ memɨhɨatɨkani hepaɨ,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kakaɨyari kexemɨte'uyurikɨ yapɨtayɨni","poem":1},{"text":"meta kexemɨteyuti'ɨrekɨ 'axaxete'uyurieka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yunakatekɨ memɨ'enananikɨ pɨwapitɨa mete'ɨkitɨarietɨ","poem":1},{"text":"meta puwawawirie 'axamemɨteyuriekɨ memuyupatakɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Xɨka mɨkɨ mehenu'enieni meta me'eyexeiyatɨ mehakɨne,","poem":1},{"text":"waɨkawa metehexeiyatɨ mepuyuhayewa kepaɨmexɨa memu'uwani,","poem":2},{"lineBreak":true},{"text":"meta meyutemamawietɨ mepakɨne kememɨteheutere.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Matsi xɨka meka'enu'enieni,","poem":1},{"text":"'atsimekatemaitɨ mɨki kitenie mepeutahaxɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"»Kakaɨyari memɨka'ayexeiya yu'iyaritsie haxɨa mepu'uta,","poem":1},{"text":"parewiya mepɨkaha'iwawa tsepa Kakaɨyari mɨtiwaruka'enitsitɨwa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Ayumieme kwitɨwa temaritɨtɨ mekanitakukuweni,","poem":1},{"text":"'ukitsi yuhamatɨa memukahipite tukita hepaɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kemɨ'ane memɨte'uka'eniwa, Kakaɨyari puwaxɨna mete'uka'eniwakaku,","poem":1},{"text":"meyuhiweriekaku, pɨwanɨtɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"»Kakaɨyari pɨmatsixɨna waɨkawa petiuka'eniwakaku,","poem":1},{"text":"'ahakuyeukaku pɨmatsihɨani,","poem":2},{"lineBreak":true},{"text":"'amexatsie 'ikwaite 'aixɨa mɨti'anene pɨtitahɨniya.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Matsi 'ekɨ Kakaɨyari memɨka'ayexeiya kememɨtepitɨarie mɨpaɨ pepɨtipitɨarieni,","poem":1},{"text":"tita mɨtiheitserie meta kepemɨranutahɨiyani mepumatsi'axe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kene'a'ɨwiyani waɨkawa perexeiyatɨ pemayanikɨ petihiwe'erietɨ,","poem":1},{"text":"tiyukwamaname pepɨkahe'ayeitɨwani.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Waɨkawa kepemɨrexeiya pukamatsiparewieni,","poem":1},{"text":"meta naitɨ 'a'uximayatsika.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yɨriya pepɨkatakwewieka,","poem":1},{"text":"kepauka teɨteri wakiekari mati'utsie matixɨriwa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kene'a'ɨwiyani 'axamɨti'ane hepaɨtsita,","poem":1},{"text":"'ayumieme hikɨ pekatiniuka'eniwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"»Kakaɨyari 'aixɨa katinahɨawarɨwani yutɨrɨkariyakɨ.","poem":1},{"text":"Xewitɨ ti'ɨkitametɨtɨ hepaɨna 'anetɨ pumawe.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"¿Kemɨ'ane pita'iwawiyawe kemɨtiyuriene?","poem":1},{"text":"¿Kemɨ'ane kename heuyewe pɨtitahɨawiwe?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"'Uximayatsikaya hepaɨtsita 'aixɨa pehaitɨ pepɨkaratɨtɨmaiyani,","poem":1},{"text":"nɨawarikɨ hepaɨtsitana 'aixɨa katinaniuwani.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yunaitɨ teɨteri memixeiya mepɨyɨwawe,","poem":1},{"text":"tsepanetɨ 'ateewa paitɨ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kakaɨyari pumariwe tepɨka'imate.","poem":1},{"text":"Pɨkayu'inɨatsinɨa kepaɨmeme wiyari mexeiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"»Mɨkɨ haɨtsi pɨtaxɨrɨwa","poem":1},{"text":"haa 'aki 'utɨma wiyeri hepaɨ muhanekɨ hatɨatsie mɨye'axenikɨ,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"hai wiyeri pɨkaxɨrɨwa,","poem":1},{"text":"teɨteri wahetsie waɨkawa mɨkaxɨrienikɨ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"¿Kemɨ'ane hai 'emutayeyeure petimaitɨyeika,","poem":1},{"text":"meta tɨranari tsatana mayuane?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Kakaɨyari xekeneuxeiya yuxawatɨriya yu'aurie kemɨrexeiya,","poem":1},{"text":"meta mɨkɨkɨ haramara 'upaitɨ pɨhɨniya.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kakaɨyari pɨti'aita nuiwarite wahetsie","poem":1},{"text":"meta 'ikwaite waɨkawame pɨtiwayetuirie.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Mimierika yumamatsie pɨti'ɨwe,","poem":1},{"text":"meta yapɨtita'aitɨwa hakewa mɨrekamɨni.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Tɨranarieya yapaine kename wiyeri tɨrɨkaɨye,","poem":1},{"text":"meta wakaitsixi 'ɨaritɨ mepi'enie kename 'uhamie.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/35.json","previousChapterAudioLinks":{},"numberOfVerses":33}