{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":37,"content":[{"type":"verse","number":1,"content":[{"text":"»'Ari 'ena ne'atimietɨ nepuma, ne'iyari putɨrarɨka,","poem":1},{"text":"wa'atɨri ne'iyari pɨrewatiyeixime.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Keneu'eni, keneu'eni niukieya tɨranarieya,","poem":1},{"text":"yuarikaya tetana mayeneika xekeneu'eni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Muyuawi hetɨa kemakuyewa naitsarie pɨtimimiene,","poem":1},{"text":"merɨkariyaya, kwie manu'atɨkatsie paitɨ pɨye'axe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Utɨmanata kaniumieni niukieya mumariwe tɨranariyari,","poem":1},{"text":"kaniyuku'eiyani meta yumimierɨkari pɨkahayewa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kakaɨyari yuniuki 'utatɨrarɨkame payeitɨwa","poem":1},{"text":"hikɨ 'ana mariweme pɨtiyuriene:","poem":2},{"text":"Kakaɨyari timamariwaweme mɨtiuyurieni pɨyɨwe","poem":1},{"text":"meta tepɨkayɨwawe mɨkɨ temeitimanikɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Ɨwi mɨpaɨ katinikɨhɨaweni: “Kwiepa keneukaxɨri”,","poem":1},{"text":"wiyeri meta: “'Atɨrɨkariya keneuhekɨata”.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yapɨtiyuriene teɨteri yunaitɨ yukiita memeutahaxɨanikɨ,","poem":1},{"text":"yunaitɨ kemɨtiyuriene memetimanikɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yeutari yuhetsie nunuwame mepɨkuwautɨwe,","poem":1},{"text":"meta yuterɨta mepuyukuhayeikawa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Eka tatsutɨa mieme wiyeri mɨtɨrɨkaɨye pu'atɨwa,","poem":1},{"text":"meta 'eka tayeta mieme xeri pɨ'atɨwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kakaɨyari yu'iiyakɨ 'ɨwi pɨtiwewiwa","poem":1},{"text":"'ana haa naitɨ puxexere.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Haiwitɨri haa kaniutitɨtɨwani,","poem":1},{"text":"meta yumimierɨkari mana kaniyenenetɨwani,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"hikɨ mɨkɨ mekaniku'uwani,","poem":1},{"text":"naitsarie kwiepa kemakuyewa,","poem":2},{"lineBreak":true},{"text":"mete'aye'atɨanike Kakaɨyari kemɨtiwaru'aitɨa,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Aixɨa mɨtiuka'iyarikɨ, hai muyukuxeɨrienikɨ yapɨtiyuriene,","poem":1},{"text":"hipame mɨtiwakwinitɨanikɨ yatɨni 'aixɨa muwayurienikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"»Kuwi, yaketinetewini 'akuxi, keneneu'eni,","poem":1},{"text":"Kakaɨyari mariwemekɨ kemɨtiyurie hepaɨtsita keneuyuti'iyaritɨa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"¿Petimate Kakaɨyari haiwitɨri kemɨtikuyuitɨwa,","poem":1},{"text":"meta kemikuyuruwa merɨkariyayakɨ mukuxawatɨrenikɨ?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"¿Petimate kehepaɨ haiwitɨri","poem":1},{"text":"'ateewa mɨtiuyeyeixa,","poem":2},{"lineBreak":true},{"text":"Kakaɨyari mamariwaweme timaiwemekɨ kemɨtiyuriene?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"'Ekɨ, pemɨyexɨrimɨne 'akamixate peranakatɨtɨ","poem":1},{"text":"kepauka mɨxɨkanitsie 'eka tatsutɨa mieme 'i'atɨwakaku,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"¿petiyɨwe pemiparewieni muyuawi 'axemɨtayeuriya,","poem":1},{"text":"'ayetse'ime wurunitse xikɨriyari tepɨayari hepaɨ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"»Ketatineutaxatɨa ketemɨte'ita'eiyakɨ,","poem":1},{"text":"tametsɨ yemekɨ 'atsitemɨkatematekɨ,","poem":2},{"lineBreak":true},{"text":"tepɨkatemate ketemɨtiyuani.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ne nepɨkanewaɨriya nemitawawirienikɨ kename netaniuni.","poem":1},{"text":"¿Kemɨ'ane puyuwaɨriya mɨtaniuni meta mumierieni?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Xewitɨ pɨkayɨwe tau mɨxawatɨ kwi muxeiyakɨ","poem":1},{"text":"kepauka muyuawitsie 'eka haiwitɨri mɨta'enitsitɨaxɨanitsie.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Tixawatɨtɨ taimaɨyetɨ tayeta pɨrayemie,","poem":1},{"text":"Kakaɨyari mana payemie, mariwemetsie yekaitɨ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Naimekɨmɨtɨrɨkaɨye temanunake pɨkayɨwe,","poem":1},{"text":"tɨrɨkariyaya yemekɨ pumariwe.","poem":2},{"text":"Pumamariwawe ke'aixɨa mɨtiyuriene meta kemɨtiheitseriekɨ,","poem":1},{"text":"xeime waɨriyarika pukati'uximayatsitɨa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mɨkɨ kemɨ'ane metemaiwaweme memuyu'erie tixaɨtɨ pɨkatiwarayeitɨa,","poem":1},{"text":"'ayumieme teɨteri mepimakaxe».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/36.json","previousChapterAudioLinks":{},"numberOfVerses":24}