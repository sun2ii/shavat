{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":38,"content":[{"type":"heading","content":["Kakaɨyari Kuwi kemɨtiuta'ei"]},{"type":"verse","number":1,"content":["Yawé Kuwi kaniuta'eiya 'eka waɨkawa tɨrɨkaɨyemetsie. Mɨpaɨ katinitahɨawe:"]},{"type":"verse","number":2,"content":[{"text":"«¿Kemɨ'ane 'ikɨ pɨyɨane, ne'ɨxatsi hepaɨtsita mɨ'iyɨrie,","poem":1},{"text":"'atsikatiyumainɨakamekɨ 'utaniutɨ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kene'akuha'aritɨa pemɨnetsita'eiyakɨ,","poem":1},{"text":"ne nepɨmatsita'iwawiya, 'ekɨta pepɨnetsita'eiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"»¿Hakewa pepeyeikakai kepauka kwie tsutɨmeyari nemutawewitsie?","poem":1},{"text":"Keneneutaxatɨa, xɨka 'aku yemekɨ petiuyemaika.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xɨari pepɨtimate kemɨ'ane miti'inɨataxɨ","poem":1},{"text":"meta kemɨ'ane ti'inɨnɨatamekɨ mi'inɨataxɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"¿Tsutɨmeyari ketita hetsie ratei,","poem":1},{"text":"yatɨni kemɨ'ane tete tsikuritana mieme pukaye","poem":2}]},{"type":"verse","number":7,"content":[{"text":"mexixi me'utikwikakai xurawetsixi ximeri miemete","poem":1},{"text":"meta yunaitɨ niuki tuayamete meyutemamawietɨ me'utihiwakai?","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"»¿Kemɨ'ane haramara muwatinetsie pɨreuna","poem":1},{"text":"kepauka kwie taɨta muwatitekixɨtsie?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"¿Kepauka haiwitɨrikɨ nemitikemaritɨa","poem":1},{"text":"meta kepauka yɨriya 'e'ayetsuimekɨ nemita'eimaxɨ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"¿Kepauka hakewa meye'atɨkanikɨ nemipitɨa","poem":1},{"text":"meta kitenieyatsie mɨreukukeka nemeukutetsie?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"¿Yatɨni kepauka 'ipaɨ nemɨtitahɨawixɨ: “'Ena xeikɨa pepɨye'atɨyeikani,","poem":1},{"text":"'ena 'ahamewari 'amɨnene pɨka'anutitsukwakani”?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"»¿Heiwamiemeri pe'uyeikatɨ ximeri petiuta'aitɨa,","poem":1},{"text":"yatɨni tau 'ɨrɨya hakewa meukakɨxé petitaxatɨa,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"kwie kemɨyewa manuye'atɨkatsie paitɨ mɨye'anikɨ","poem":1},{"text":"meta mɨkɨkɨ yunaime 'axamemɨte'u'iyari muwakuyuitɨanikɨ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kwie puyukupata, haxu tseyu hetɨa hepaɨ,","poem":1},{"text":"'ixuriki witsimɨ'ane mukatutuni hepaɨ 'anetɨ kanayuyeitɨwani.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Axateyuruwamete hekɨaripana mepayeweweiyarɨwa,","poem":1},{"text":"meta watɨrɨkariya mɨyuti'ɨre pɨka'unarɨwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"»¿Haramara haixayari hakewa metineika peremarie,","poem":1},{"text":"meta perekuyeixɨari meukatetewatsie paitɨ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"¿Mɨki kitenie petiuxeiyatsitɨarie?","poem":1},{"text":"¿Waɨkawa muyeyɨwi kitenie petiuxei?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"¿Petimate kwie kemɨyewa?","poem":1},{"text":"Xɨka yurikɨ 'ikɨ naime petimaika, kenetineutaxatɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"»¿Ke'anetɨ huye hekɨaripa mieme pɨhɨkɨ?","poem":1},{"text":"¿Hakewa pɨre'ane yɨriya mexuawe?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"¿Petiyɨwe wakwie manuye'atɨkatsie pemɨwarewitɨni?","poem":1},{"text":"¿Wahuye memakuteitsie mieme kemɨreuyune petimate?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yemekɨ pepɨtimate,","poem":1},{"text":"'anari xɨari peputinuiwakai.","poem":2},{"lineBreak":true},{"text":"Mɨixari wiyari pepuyeika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"»¿Pe'ixeiyake pereutahari","poem":1},{"text":"'ɨwi teeyari muyexeɨrietsie,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"nemi'uta kepauka nemuwa'uximatɨanitsie,","poem":1},{"text":"kuyaxa miemetsie meta mɨtiyutakwitɨtsie?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"¿Ke'anetɨ huye pɨhɨkɨ hakewa xawatɨriya mɨtakɨkatsie,","poem":1},{"text":"yatɨni hakewa 'eka tau manatineikatsie","poem":2},{"lineBreak":true},{"text":"kwiepa mayeneika?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"¿Kemɨ'ane haa peuyepiwa waɨkawa mɨkawiyekɨ,","poem":1},{"text":"meta kemɨ'ane wiyeri mɨtɨrɨkaɨye pupitɨa,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"teɨteri memɨkahakuteitsie mɨkahatuanikɨ,","poem":1},{"text":"meta makumawetsie xewitɨtɨma mɨkahekietsie,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"kwie makuwaki muyunakɨ","poem":1},{"text":"meta mana tupiriya mɨtinenikɨ?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"¿Kamɨtsɨ wiyeri yupaapa rexeiya?","poem":1},{"text":"¿Xewitɨ haɨtsi tiutinuiwitɨa?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"¿Hakewa 'ɨwi peyenunuiwa?","poem":1},{"text":"¿Kemɨ'ane pitinuiwitɨwa tee muyuawitsie mieme?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Haa 'ayepari hepaɨ katiniutse'ireni,","poem":1},{"text":"meta haramara 'amatiyewa kaniuxexereni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"»¿Kamɨtsɨ Tsimanixi memɨwiwietɨka petiwarakɨwɨtɨawe,","poem":1},{"text":"mexɨkatɨni Terɨka kaunariyari pemɨxɨna?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"¿Petiyɨwe muyuawitsie memɨteka'u xurawetsixitɨtɨ ximeripaitɨ pemuwaranetɨani?","poem":1},{"text":"¿Hararu 'Amupa petiuta'aitɨawe kepauka maneikanikɨ meta Hararu yakɨ mupe?","poem":2}]},{"type":"verse","number":33,"content":[{"text":"¿Petimate ke'anenetɨ 'aitsikate muyuawitsie mɨti'aita?","poem":1},{"text":"¿Pemɨtiwata'aitɨanikɨ yunaime 'ena kwiepa petiyɨwe?","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"»¿Petiyɨwe haiwitɨri pemutahiwieni","poem":1},{"text":"'ahetsie wiyeri waɨkawa mɨkaxɨrienikɨ?","poem":2}]},{"type":"verse","number":35,"content":[{"text":"¿'Ekɨ petihɨkɨ mimierɨka pemɨhekɨata?","poem":1},{"text":"¿Kamɨtsɨ mɨpaɨ memeteku'eiya: “'Ena tepɨti'u kepehaineni”?","poem":2}]},{"type":"verse","number":36,"content":[{"text":"¿Kemɨ'ane kuaxu mɨtimaiwenikɨ piyetuiri,","poem":1},{"text":"yatɨni kemɨ'ane wakana 'ukiri meitimaitɨyeikanikɨ pupitɨa?","poem":2}]},{"type":"verse","number":37,"content":[{"text":"¿Kemɨ'ane pɨtimaiwe haiwitɨri puti'inɨatawe?","poem":1},{"text":"¿Kemɨ'ane pɨyɨwe xarite muyuawitsie mieme metiyeuriexɨanikɨ","poem":2}]},{"type":"verse","number":38,"content":[{"text":"kepauka kwie mɨtse'ire","poem":1},{"text":"meta hapukwa mɨnararaninitsie?","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"»¿'Ekɨ mayetsi 'ukari wa'ikwai petixɨ'erie","poem":1},{"text":"meta mayetsi tɨɨrixi petiwahuxaitɨa","poem":2}]},{"type":"verse","number":40,"content":[{"text":"kepauka terɨta memɨyu'awieta","poem":1},{"text":"yatɨni kepauka mehupatɨ 'amemukuhe?","poem":2}]},{"type":"verse","number":41,"content":[{"text":"¿'Ekɨ petihɨkɨ kwatsari pemɨtiwamikwa","poem":1},{"text":"kepauka waniwema memɨteha'iwawa nehetsɨa,","poem":2},{"lineBreak":true},{"text":"meta kepauka memeu'uwa xeikɨa mekatekwatɨ?","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/37.json","previousChapterAudioLinks":{},"numberOfVerses":41}