{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":39,"content":[{"type":"verse","number":1,"content":[{"text":"»¿Petimate kepauka kwaxuri memɨtitawaya?","poem":1},{"text":"¿Maxatsi petiwaxexeiya kepauka memɨtiniweyatsie?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"¿Petimate kepaɨmexɨa metseriyari memukuyuruwa?","poem":1},{"text":"¿Petimate kepauka memɨtiniweya?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kepauka yuniwema muwarayexeiya kananakatutsitani,","poem":1},{"text":"kukuiniyaya mana kaniu'axeni kepauka mɨtiniwenitsie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Niwemama mekanitiwawereni meta yeuta metɨrɨkawitɨ mekanakɨkani,","poem":1},{"text":"hikɨ mehekɨkatɨ mepɨkahanunuwari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"»¿Kemɨ'ane puxu yeutanaka putatua?","poem":1},{"text":"¿Kemɨ'ane kaunarieya puxɨnaxɨ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne kwie makumawe nekaniyetuirieni,","poem":1},{"text":"kiena mayanikɨ mɨkarakuteitɨtsie.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kiekaritsie tiyuariyaya pɨ'atse,","poem":1},{"text":"meta ti'ikatɨwame hiwarieya pɨka'enie.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yemuritsie puyeika yu'ikwai tikuwaunetɨ,","poem":1},{"text":"kwiepa mɨtitsitsiɨrawi tiwaunetɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"»¿'Ekɨ yuri peti'erie kename turu yeutanaka yuwaɨriya matita'uximayatsirienikɨ?","poem":1},{"text":"¿'Akuraruta tɨkarikɨ tiuyuhayewawe?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"¿Petiyɨwe xɨka pe'itamu'uyaritɨani kaunarikɨ xuruku mɨtiwewienikɨ?","poem":1},{"text":"¿'A'ɨtɨma mumieni 'ukwietsanarɨmetɨ tiyɨwe?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"¿'Ekɨ hetsiena petiwiya mɨkɨ waɨkawa mɨtɨrɨkaɨyekɨ?","poem":1},{"text":"¿Waɨkawame kepemɨti'uximaya petipitɨawe mɨkɨ pɨta mɨtita'uximayatakɨ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"¿Yuri peti'erie mɨkɨ 'a'ikú mɨtitɨanikɨ","poem":1},{"text":"meta mikuxeɨrienikɨ hakewa pemeiti'unitsie?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"»'Aru 'amɨnena kaniyutemawieka yu'anate tikatsetɨ,","poem":1},{"text":"matsi 'anateya kuaxu 'amɨnena 'anateya hepaɨ pɨka'anene.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mɨkɨ kwiepa kanititawayani,","poem":1},{"text":"xiekaripata kaniku'e'eiriwani mɨtitsinekɨ,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"tsepanetɨ mitiketsi pɨka'ikweriwayurie,","poem":1},{"text":"yatɨni tsepa memɨmamariwawe yeutari memitiketsi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yuniwema 'aixɨa pɨkatiwaxeiya hetsɨana memɨkamiemetetɨni hepaɨ,","poem":1},{"text":"pɨkayɨhɨawe tsepanetɨ 'uximayatsikaya yakɨxeikɨa mɨratɨa,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kakaɨyari mɨtimaiwenikɨ mɨka'ipitɨakɨ","poem":1},{"text":"meta meitimaitɨyeikanikɨ pɨka'iyetuiri.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Matsi kepauka mutanautsatsie kwinimieme kananayeyɨneni,","poem":1},{"text":"kawayutsixi meta yaxikemete kaniwatawe'erieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"»¿Kawayu tɨrɨkariyaya petiyetuiri?","poem":1},{"text":"¿Kɨipieya petiutakemaritɨa kɨpateya 'atɨtɨmekɨ?","poem":2}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"¿'Ekɨ petihɨkɨ 'utsika hepaɨ pemɨtitsunatsitɨwa,","poem":2},{"lineBreak":true},{"text":"ha'atɨ 'utapuxerɨkatɨ kemɨtiwamariuta?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kawayu yu'utɨa kemɨranuyeketsina, yuhetsie hauyu'ɨtɨ mɨtɨrɨkaɨyekɨ,","poem":1},{"text":"meta makuweritsie kaniutananautsani.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Marika pɨtawe'erie, tixaɨtɨ pɨkareumakaxe,","poem":1},{"text":"pɨka'utimamawe tsepa 'ixiparakɨ mutamierie.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"'Auriena 'ɨrɨ kaniukuyuatɨyeikani,","poem":1},{"text":"kaniutixawatɨreni pitsika 'amɨtɨtɨ meta 'ɨrɨ 'amɨtɨtɨ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Waɨkawa munautsarɨmekɨ kwitɨ kaniuye'axeni,","poem":1},{"text":"kepauka kuxineta mutahɨtsierienitsie muwaketɨani pɨkayɨwe.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kepauka kuxineta metayuani, kanitatsuriximɨkɨ tiyu'iwamɨtɨ,","poem":1},{"text":"mɨreyukwitɨne 'ateewa paitɨ kani'ɨkweni,","poem":2},{"lineBreak":true},{"text":"meta yukukuyamete wahiwari kani'enieka metatsiere kuyaxi tewa'aitɨwamete wahiwari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"»¿'Ekɨ kepemɨtimaiwekɨ piwame mukuwienenikɨ petipitɨa","poem":1},{"text":"meta tatsutɨa paitɨ mɨye'anikɨ 'uwiximetɨ?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"¿Yapehainekaku kwixɨ 'ateewa tiuyewiwiere kuwienetɨ","poem":1},{"text":"meta 'aheutitewakaku yu'itɨa mɨtawewienikɨ?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"'Aitsie kanikieka, muwa kaniyekukutsuni,","poem":1},{"text":"mukatataritsie 'aitsie kaniyu'awietani.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Manapaitɨ tita mɨtitakwani kanitaxeiyani,","poem":1},{"text":"'ateewa paitɨ hɨxiteya katinikuxexeiyani.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Niwemama 'etsimemupepe mekaniyutemamawieka 'imieri xuriyayatsie,","poem":1},{"text":"hakewa timɨkitɨ mɨreka, mana piwame kaniuyekani».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":30}