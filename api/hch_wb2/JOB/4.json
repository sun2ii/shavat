{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":4,"content":[{"type":"heading","content":["'Eripaxi matɨari kemutayɨ"]},{"type":"verse","number":1,"content":["Hikɨ 'Eripaxi Temani kiekame Kuwi mɨpaɨ katiniuta'eiya:"]},{"type":"verse","number":2,"content":[{"text":"«Xɨari pɨkamatsi'unakiwe","poem":1},{"text":"xɨka xewitɨ yɨkɨ matiutahɨawe,","poem":2},{"lineBreak":true},{"text":"ne nepɨkayɨwe nemɨtinewiekakɨ,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Ekɨ yumɨireme teɨteri pepɨwarayehɨtɨwakai","poem":1},{"text":"meta pepɨwaparewiekai 'aixɨa petiwarahɨawetɨ memɨwerarani,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Ekɨ 'aniukikɨ pepɨwaranukuhapanakai memekaxɨrɨwekai","poem":1},{"text":"meta watunute petɨrɨkariyatɨ memanuyewerarani yutunutetsie,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Matsi hikɨ kepemɨtiuka'eniwa pepɨkatinewie,","poem":1},{"text":"waɨkawa yɨkɨ peti'akɨhɨawetɨ pepɨ'akuhayeikawa meta peweranitɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"¿Kari pepɨkayɨwenikeyu Kakaɨyari pe'ayemakatɨ yuri pemɨti'eriekakɨ","poem":1},{"text":"meta kepemɨtiuyeikakɨ kename 'axapekatiyurienetɨ 'apeka'uyeika?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"»Keneutimaixɨa: ¿Kemɨ'ane 'axakatiyurienetɨ pukumawerixɨ?","poem":1},{"text":"¿Kepauka teɨteri 'aixɨa memɨte'u'iyari mepeuyewe?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kenemɨretima mɨpaɨ pɨneti'ɨkitɨa","poem":1},{"text":"kemɨ'ane 'axamɨti'ane mɨtika'eni, mɨkɨ 'uximatɨarika kanika'itsanamɨkɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kakaɨyari 'iiyaya kaniwatakukuyani,","poem":1},{"text":"haxɨaya kaniwarakɨxɨxɨtsitɨwani.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tsepanetɨ maye muyutahaxɨatɨwa meta niwemama kememɨte'i'ɨke,","poem":1},{"text":"naime yutamete mekaniwaye'uniyariexɨakuni,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"maye kanimɨmɨkɨ 'ikwaiya mɨtiumawekɨ,","poem":1},{"text":"meta maye niwemama mekanitayeixɨakuni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"»'Awie niuki nehetsie kaniye'ani,","poem":1},{"text":"yuariyaya 'etsiwa xeikɨa nekaniu'enieni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tɨkarikɨ heinɨtsi nehetsie kaninuani kaneneuyehɨani,","poem":1},{"text":"kepauka teɨteri waɨkawa memeukukutsutsie,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"marika waɨkawa nehexeiyatɨ nekaniyuhayewa,","poem":1},{"text":"naitɨ ne'umete kaniutiyɨyɨakakaitɨni.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nehɨxietsie 'iyari 'ekayari kaneniuyuitɨani,","poem":1},{"text":"meta nekɨpate kaniutitsetseriya.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"'Etɨriya nehɨxie kaniyuhayewa,","poem":1},{"text":"matsi pɨkayuxeiyanɨakai kemɨ'ane mɨhɨkɨtɨkai.","poem":2},{"text":"Kayuwatɨ katiniukeni,","poem":1},{"text":"meta niukieya nekaniu'enieni mɨpaɨ 'utaineme:","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"»“Xewitɨ matsi tewi kaniumaweni heitseriemekɨ yatikamietɨ Kakaɨyari hepaɨ.","poem":1},{"text":"Tewi pɨkayɨwe waɨkawa 'itiyatɨ mayanikɨ kemɨ'ane Mitawewi hepaɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Matsi Kakaɨyari te'i'uximayatsiriwamete wahetsie yuri pɨkati'erie,","poem":1},{"text":"meta niuki tuayamete yuhetsɨa miemete, yakatiniwakɨhɨaweni kememɨkate'enu'eniwa,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"matsiri teɨteri haxukɨ memɨwewiyatɨka kepauka yuri tiwaruta'eriri,","poem":1},{"text":"tumuanarikɨ mekaniwewiyatɨkani, mekanitipɨnarɨwani kakwaniwemekɨ kɨpi tikɨmeme hepaɨ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ximeri mepayeneniere peru taikai mepɨkwikwi'i","poem":1},{"text":"meta yuheyemekɨ mepukumamawere, nixewitɨ tɨma pɨkawaraye'eriwa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Wakaunari kanaxitewani, hikɨ 'ixuriki kiiyari hepaɨ mekaniuka'unikeni.","poem":1},{"text":"Mekanitakukuweni metemaiwawetɨ mekahakɨniwawetɨ”.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}