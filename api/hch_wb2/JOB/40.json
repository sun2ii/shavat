{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":40,"content":[{"type":"verse","number":1,"content":["Yaxeikɨata Yawé Kuwi mɨpaɨ katiniutahuawe:"]},{"type":"verse","number":2,"content":[{"text":"«¿Kemɨ'ane Naimekɨmɨtɨrɨkaɨye mɨniukima tiyɨwe mitaheitseritɨanikɨ?","poem":1},{"text":"Kakaɨyari ke'uta'eiya kemɨ'ane hetsiena mɨtiuhɨpa».","poem":2}]},{"type":"verse","number":3,"content":["Hikɨ Kuwi mɨpaɨ katinita'eiya:"]},{"type":"verse","number":4,"content":[{"text":"«Yanemɨmatita'eiyakɨ nepɨkayɨwe, tixaɨtɨ nepɨkatihɨkɨ,","poem":1},{"text":"Nemamakɨ netenie nepuwiere.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Heiwa yaneputayɨ, tawari yanepɨkatayɨni,","poem":1},{"text":"hutarieka neputaniu, tawariri waɨriyarika nepɨkayupitɨani».","poem":2}]},{"type":"verse","number":6,"content":["Hikɨ Yawé Kuwi mɨpaɨ katiniuta'eiya 'eka tɨrɨkaɨyemetsie. Mɨpaɨ katinitahɨawe:"]},{"type":"verse","number":7,"content":[{"text":"«Kene'akuha'aritɨaka nehetsɨa kenaye'a.","poem":1},{"text":"Ne nekamaniti'iwawiyamɨkɨ, 'ekɨta pekaneniku'eiyamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"»¿Kamɨtsɨ ne heitserie kenemɨrexeiya tixaɨtɨ pekarayeitɨani?","poem":1},{"text":"¿Nehetsie perahɨani 'ekɨ heitserie pehexeiyatɨ pemayanikɨ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"¿'Amamá kuta nemamá hepaɨ titɨrɨkaɨye?","poem":1},{"text":"¿'Aniuki kuta neniuki hepaɨ tiutatɨrarɨka?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Xɨka'aku peyɨweni, keneuyukunama witsi'anemekɨ xawatɨmekɨ,","poem":1},{"text":"kenematsiɨkɨni 'aixɨa petiuka'iyaritɨ meta pemariwetɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Ahaxɨa mɨtiyumemiwa keneutatua,","poem":1},{"text":"memuyuti'ɨre pewaxeiyatɨ tixaɨtɨ mekatehɨmetɨme keniwarayeitɨa,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"memuyuti'ɨre keniwaruxeiya tixaɨtɨ mekatehɨmetɨme keniwarayeitɨa,","poem":1},{"text":"'axamemɨte'u'iyari keniwarutipɨna hakewa tsepa meme'uwa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yunaime tumuanaripa keniwarukateuki,","poem":1},{"text":"keniwaruti'eimaka muwatixawatsie keniwareukaxɨri.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ne, nehetsie yanepɨretimani,","poem":1},{"text":"'amamá tserieta wikweitsitɨarika muxuawekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"»'Eripaniti keneuxeiya, nemitawewi 'ahepaɨ,","poem":1},{"text":"tupiriyakɨ xeikɨa mɨtiyumikwa tuurutsixi kwietsanamete wahepaɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kepaɨmetɨ tɨrɨkariyaya naiparieyatsie puxuawe.","poem":1},{"text":"Tɨrɨkariyaya 'ameukunenere hukayatsie kanixuaweni.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kwaxieya kariuxa kɨyeyari hepaɨ pɨtiuyuane,","poem":1},{"text":"teuriteya tatayari pɨyutsatɨka.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"'Umeteya purunitse tepɨayari hepaɨ pɨtitsetse'i,","poem":1},{"text":"watuteya tepɨa muka'utɨka hepaɨ pɨ'anene.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ketita nemɨtiutiwewi mɨkɨ pumexɨakame,","poem":1},{"text":"ne xeikɨa, Nemitawewi, nepɨyɨwe hetsɨana nemɨye'anikɨ 'ixipara ne'akwetɨ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yemurite 'ikwaxi hetsienamieme katiniutixuawitɨwani,","poem":1},{"text":"mana mekaniutinanautsani yeutari.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Tuturi 'ayeyeutɨ meumanetɨka hapa mɨye'uwa hetɨa me'axetɨ mekaniuka'uxipiweni,","poem":1},{"text":"hakatsata mekaniuyuti'awiwietani haa mayematsie.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Tuturi 'ayeyeutɨ meumanetɨka yu'etɨpiwari kaniwapitɨaka,","poem":1},{"text":"hapuri hatetsita meuta'utɨka kaniti'eimani.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Tsepanetɨ haa muwayenena menutawaya waɨkawa tɨrɨkaɨyetɨ mɨkɨ pɨka'utimamawe,","poem":1},{"text":"kayuwatɨ kanayeyurini tsepanetɨ Kurutani hatuxameyari tsurieyatsie mɨreutawaya.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"¿Kemɨ'ane hɨxiena puyeyeiwe miwiyakɨ?","poem":1},{"text":"¿Kepaikɨ pɨyɨwe tsurieya muwiyakɨ yamɨkatiyurienikɨ?","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":24}