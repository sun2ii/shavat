{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":[{"text":"»¿Haxi","poem":2},{"noteId":4},{"text":"kwaitsɨkɨ pemukwaitsɨpiya petiyɨwe,","poem":2},{"lineBreak":true},{"text":"yatɨni nenieya tihɨayamekɨ pemɨhuani?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"¿Petiyɨwe kaunari mɨtse'ikɨ tsurieyatsie pemenuhɨanikɨ,","poem":1},{"text":"yatɨni 'aurieyatsie 'iwipamekɨ pemanuyexawariya?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"¿'Aixɨa 'anemekɨ metitahuawe","poem":1},{"text":"yatɨni kename pe'inenimayaka tiutaineni?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"¿Kamɨtsɨ tɨratu tiwewieni 'ahamatɨa","poem":1},{"text":"yuheyemekɨ ti'a'uximayatsiriwame mayanikɨ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"¿Mɨkɨ hamatɨa petiutiwaikawe wikixi kepemɨtiwarutiwaika hepaɨ,","poem":1},{"text":"yatɨni pemihɨanikɨ 'aniwema memixeiyanikɨ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"¿Tetuayamete memituanikɨ meteyɨwawe,","poem":1},{"text":"yatɨni 'etsipepeme memɨtixitexɨanikɨ me'ituanike?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"¿Pitsikate nawieya hetsie pemuyehatɨaxɨani petiyɨwe,","poem":1},{"text":"yatɨni 'ɨrɨ mu'uyatsie?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Xɨka hetsiena 'amamakɨ peheutimeni,","poem":1},{"text":"hatsuaku mɨkɨ kemetiutamikɨ pepɨkahatɨmaiya,","poem":2},{"lineBreak":true},{"text":"meta tawari yapemiyurienikɨ pepɨka'awaɨriyari.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yakɨ xeikɨa mɨyapepɨtiku'eriwa pe'iwiyamɨtɨ,","poem":1},{"text":"xɨka 'ixeiyatɨtɨ xeikɨa kaneuyuyehɨamɨkɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Xewitɨ kaniumawe miyehaxɨatɨanikɨ.","poem":1},{"text":"¿Kemɨ'ane kamɨtsɨ pɨyɨwe mitamienikɨ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"¿Kemɨ'ane tixaɨtɨ pɨrexeiya nemɨrekapitɨanikɨ?","poem":1},{"text":"Naitɨ mɨtixuawe muyuawi hetɨa mɨkɨ katininepiinitɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"»Mɨkɨ teuriteya kemɨ'anenekɨ nepɨkayɨwe ne'ikuxatatɨ nemɨtihayewanikɨ,","poem":1},{"text":"kemɨtitɨrɨkaɨyekɨ meta witsikemɨ'anekɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"¿Kepaikɨ pɨyɨwe mitikemaripienikɨ 'ixiparaya minawairienikɨ?","poem":1},{"text":"¿Kepaikɨ paye'awe hetsɨana tepɨa mitakeitsitɨanikɨ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"¿Kepaikɨ puyuwaɨriya menutatetapienikɨ,","poem":1},{"text":"tameteya mɨtsetse'i mɨxeiyakɨ mumamariwawe?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yuwari'ɨtɨa 'etsiyeyeutɨ tepɨa memanetɨkani hepaɨ kani'aneni,","poem":1},{"text":"mɨkɨ naitɨ yuwiyatɨkaitɨ tɨrɨkawitɨ,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"yemekɨ hurawa kani'uka,","poem":1},{"text":"'eka tɨma watsata pɨkaheuyeyeika,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"xexuitɨ kaniyuwiyatɨkani,","poem":1},{"text":"yunaitɨ kaniyuwiyatɨkani, 'ateewa mi'uitɨani pɨkayɨwe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yuhɨtsiyakɨ xawatɨriya kanitanenetsitɨwani,","poem":1},{"text":"hɨxiteya tau 'ɨrɨya ximeri mieme hepaɨ katinimatsiɨkɨni.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tetana tai kanayeneikani,","poem":1},{"text":"tai tsipurikiyari kaniwayeneikani.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yutsurita kɨtsi kaniwakanenetsitɨwani,","poem":1},{"text":"xari haka taiyari hetsie 'uyekaitɨ mukwanani hepaɨ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yu'iiyakɨ tɨxari kanikutaiyani,","poem":1},{"text":"meta tai tetana kanayeneikani.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kɨipieyatsie tɨrɨkariyaya kaniyekani,","poem":1},{"text":"mɨkɨ hɨxie, yunaitɨ teɨteri mepɨkayukuwawaɨriya.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nawiyari tse'itɨ kaniyuwiyani,","poem":1},{"text":"pɨtiwiya yemekɨ pɨkayuyuitɨarinɨa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Tawieya kanitse'ini, 'ayepari hepaɨ,","poem":1},{"text":"tse'itɨ tete tɨxɨme hepaɨ,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kepauka manukukenitsie, memɨtɨrɨkawi mekaniutimamaweni,","poem":1},{"text":"kepauka muyutakatsetsie mekaniuyuta'unani.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Tsepa 'ixipara menuku'axixɨ 'atsipɨka'iyurieni,","poem":1},{"text":"meta 'ɨrɨ pɨkatikwinitɨani,","poem":2},{"lineBreak":true},{"text":"meta pitsika meta 'ɨrɨ 'amɨtɨtɨ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Tepɨa mɨaxa hepaɨ pɨtimate,","poem":1},{"text":"purunitseta kɨye mɨpɨnini hepaɨ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"'Ɨrɨkɨ mitaweiya pɨkayɨwe,","poem":1},{"text":"tete tewɨpametsie mieme xatsi hepaɨ katinixeiyani.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Tete tsunamekɨ xeikɨa kanikutsikɨtɨwani,","poem":1},{"text":"kaniutanaweni pitsika yuariyayakɨ.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Yutawitsie xari tarimeyari kaneuka'uitɨaka","poem":1},{"text":"kwietsanari huyerieya pewewietɨyeika.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"'Ameukatewa watsu tikwaniyameta hepaɨ katinikwaniyani,","poem":1},{"text":"haramara putatake witsimu'ɨa puteyutsie mɨyemaka hepaɨ.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Hamewari tuxame 'utimerɨkame yu'ɨtɨma kaniuhayewarɨmeni,","poem":1},{"text":"'ameukatewa kɨpaya mutuxani hepaɨ pɨtiyuxexeiya.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Mɨkɨ mumariwe tixaɨtɨ mɨkatimakaxe kanihɨkɨtɨni,","poem":1},{"text":"xewitɨ kwiepa kaniumaweni hepaɨna 'anetɨ.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Yunaime memɨtɨrɨkawi tixaɨtɨ memɨkatehɨmetɨni hepaɨ katiniwaxeiyani,","poem":1},{"text":"memuyuti'ɨre yunaime katiniwa'aitɨwametɨni».","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Pɨkamatsiɨkɨ tita mɨtixata, haxi yatɨni ketsɨ 'amupa hepaɨ.","reference":{"chapter":41,"verse":1}}]},"thisChapterLink":"/api/hch_wb2/JOB/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/40.json","previousChapterAudioLinks":{},"numberOfVerses":34}