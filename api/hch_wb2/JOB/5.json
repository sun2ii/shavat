{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"»Parakuta xɨka peyɨweni keneutaniu, matsi ¿kemɨ'ane pɨmatsita'eiya?","poem":1},{"text":"¿Ke'aneme kakaɨyari pepɨtahɨawe?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Memɨkayuwaɨriya memɨteyu'ɨkitɨakakɨ wahaxɨa kaniwakwika,","poem":1},{"text":"memɨkayɨkɨhɨawe wa'ɨtetsarika kaniwakwika.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne mɨkatimaiwe nekanimaika kwitɨwa waɨkawa rexeiyatɨ kanayeikani,","poem":1},{"text":"matsi kiiya yapauka 'axapu'itɨarie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Waniwema teewa me'u'uwatɨ mekawikweitsitɨarietɨ mekaniyuhayewakuni,","poem":1},{"text":"mɨrayutixanetsiwatsie mekaninanaimarieka, xewitɨtɨma wahetsie pɨkatanuani.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wa'itsanari mekanikwaka memɨyehakakwitɨwe,","poem":1},{"text":"xuyatsata me'ikatɨkɨtɨ,","poem":2},{"lineBreak":true},{"text":"tita waɨkawa memɨtehexeiya memɨyeharikwitɨwe mekanihareka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tsepanetɨ 'uximatɨarika kwiepa katineika,","poem":1},{"text":"meta kukuinari mana mɨkahatineika,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"tewi kaniutinuiwa naimekɨ mɨtiuka'eniwanikɨ,","poem":1},{"text":"tai tsipɨrikiyari kemɨtita'eke hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"»Ne xɨka netiuka'eniwanike, Kakaɨyari hetsɨa 'ahurawa nepuyanike,","poem":1},{"text":"hɨxiena naimekɨ nepɨnetahekɨatawe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mɨkɨ mariweme katiniyurieneni keyatemɨkatemate,","poem":1},{"text":"kemɨtiyuriene yutɨrɨkariyakɨ pɨkayu'inɨatsinɨa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mɨkɨ wiyeri kwiepa kaneyenɨ'awani","poem":1},{"text":"meta haa hɨritetsie pɨtixuawitɨani 'ɨtsitsata.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mɨkɨ tixaɨtɨ memɨkatehayuyeitɨa kaniwaranukuhapanani","poem":1},{"text":"meta memuyuheiwerie 'aixɨa puwayurie.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mete'akumaitɨ kememɨteyuriku mɨkɨ yamɨtiyɨnikɨ pɨkatikupitɨwa,","poem":1},{"text":"wa'uximayatsika tixaɨtɨ pɨkatitixuawitɨani.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Memɨte'akumate Kakaɨyari yakatiniwakupitɨwani kememɨteku'eriwakaitsie memuyukaxɨrienikɨ,","poem":1},{"text":"meta 'axamemɨte'u'iyari kememɨte'uxa hepaɨtsita katinanu'unani.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hekɨtatɨtɨ mɨkɨ mekaniyɨrixieka,","poem":1},{"text":"hekɨtatɨtɨ me'u'uwatɨ mekanikumetɨweni mɨyɨwini hepaɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Matsi memɨte'uka'eniwa kaniwawikweitsitɨaka","poem":1},{"text":"memɨtɨrɨkawi mewa'uximatɨakaku","poem":2},{"lineBreak":true},{"text":"meta kememutiyuane 'axamewayurikutɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tixaɨ memɨkatehexeiya kememɨteta'ikwewa mɨpaɨ kani'aneni,","poem":1},{"text":"'axamemɨte'u'iyari watenie kemɨranunamie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"»'Aixɨa kani'itɨarieka tewi, kemɨ'ane Kakaɨyari mɨti'ɨkitɨa.","poem":1},{"text":"Naimekɨmɨtɨrɨkaɨye 'uximatɨarikakɨ meti'ɨkitɨakaku pepɨka'ixani'erieka.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mɨkɨ katinakwinitɨamɨkɨ, matsita katina'uayemamɨkɨ,","poem":1},{"text":"katinakuwaxɨamɨkɨ peruta katineunuitɨiriemɨkɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kamaniparewiemɨkɨ 'ataxewimexɨa pe'uximatɨariekaku,","poem":1},{"text":"meta 'atahutarieka 'axapepɨkaranuyeyani.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kepauka haakaxa muxuaweni, pemɨkamɨnikɨ kamanitawikweitsitɨamɨkɨ,","poem":1},{"text":"kuyaxa kepauka muxuaweni, pemɨkamierienikɨ 'ixiparakɨ 'ahetsie kanitanuamɨkɨ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"'Axapetikɨhɨawarɨwakaku kameni'awietakamɨkɨ,","poem":1},{"text":"meta pepɨkamaka xɨka heiwa haye'ani memɨka'unarienikɨ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kememɨteka'unarieni meta haakaxa hepaɨtsita pekaniutanawemɨkɨ,","poem":1},{"text":"meta 'ɨtsita memɨtexɨawe 'ɨrawetsixi pepɨkawamakaxeni,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"matsi 'ɨtsita tɨratu pekaniwewimɨkɨ tetexi wahamatɨa","poem":1},{"text":"meta 'ɨtsita memɨtexuawe 'ɨrawetsixi kaiwatɨ mehexeiyatɨ 'ahamatɨa mekaniu'uwakuni.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"'Akie pematayerunitsie yapekatinetimaimɨkɨ 'aixɨa kemɨti'ane,","poem":1},{"text":"kepauka 'atewama pemɨwa'inɨatani, nixewitɨtɨma pɨkaheuyewekani.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Tɨɨri yɨwaɨkawame pewarexeiyatɨ pekanayeimɨkɨ,","poem":1},{"text":"meta 'anuiwarima tupiriya 'ɨtsita mieme hepaɨ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Pe'ukiratsitɨtɨri mɨkite memakateukiwa pekani'atɨariemɨkɨ matsi 'aixɨa 'akuxi pereu'erietɨ,","poem":1},{"text":"tɨriku 'aixɨa 'anenekaku ka'inɨiwatɨ kemɨtikuxexeɨriwa hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"»'Ikɨ kaniyuritɨni tekatenetimani.","poem":1},{"text":"'Ayumieme keneu'eni meta 'ahetsie yaketineuyuri».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}