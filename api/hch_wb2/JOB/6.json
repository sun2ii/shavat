{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":6,"content":[{"type":"heading","content":["Kuwi hutarieka kemutayɨ"]},{"type":"verse","number":1,"content":["Hikɨ Kuwi mɨpaɨ katinita'eiya:"]},{"type":"verse","number":2,"content":[{"text":"«Matsi 'aixɨa pɨyunikeyu kenemɨtiukakukuine xɨka","poem":1},{"text":"ti'inɨnɨatametsie 'uti'inɨatsienike meta naitɨ kenemɨti'uximatɨarie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Xɨari haramara xiekari mɨtika kemɨkarahete reuyeta pɨreuhaniwe.","poem":1},{"text":"'Ayumieme hau'erietɨ nemutaniuni hepaɨ xepɨnete'u'eni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Naimekɨmɨtɨrɨkaɨye 'ɨrɨteya kanetinikwinitɨaka,","poem":1},{"text":"ne'iyari mɨkɨ 'uayeya mɨmɨya kani'ukweni.","poem":2},{"lineBreak":true},{"text":"Kakaɨyari marika nehetsie kaneyenɨ'ani.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"¿Puxu yeutanaka xɨka yu'ikwai hexeiyani tiutatsuaka?","poem":1},{"text":"¿Tuuru kepauka yu'ikwai mexeiya tiutamuwa?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"¿'Ikwai ka'unamatɨ hahamuritɨ tiyɨwe mɨkwaiyanikɨ?","poem":1},{"text":"¿Tawári hetsie mɨyeka manuyehekɨa keha'ane?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Matsi yanepɨkara'eriwa neme'inɨatakɨ,","poem":1},{"text":"nepɨtiutakwikwine mɨkɨ 'ikwaikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"»Matsi xɨka Kakaɨyari netsiyetuirienike tita nemɨtiwawirie.","poem":1},{"text":"Kakaɨyari xɨka tita nemɨreuyehɨwa netiyetuirienike.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Xɨka Kakaɨyari naime netsi'utimuraxɨanike,","poem":1},{"text":"xɨka yumama mɨtɨrɨkaɨye nehetsie 'utatuanike, netsi'ukumaweriyake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne mɨyatɨtɨ 'akuxi 'ipaɨ nepɨtinenɨtɨakakeyu,","poem":1},{"text":"tsepanetɨ kenemɨtiuka'eniwakɨ waɨkawa netiukakukuinetɨ:","poem":2},{"lineBreak":true},{"text":"Kakaɨyari Mupatsie niukieya nepɨkahehɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"»Tawari tɨrɨkari pɨkayuhayewane nemɨta'ikwewanikɨ","poem":1},{"text":"meta tixaɨtɨ nepɨkatitakwewi ne'ayeyuritɨ nemuyeikanikɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"¿Tete mayetse'i kuta netihɨkɨ?","poem":1},{"text":"¿Wurunitse waiyariyari kuta nerexeiya?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"¿Kenetiyɨwe nekɨmana nemuyuparewienikɨ,","poem":1},{"text":"naimeri netiunawaiyarieka tita nemɨrexeiyakai?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"»Tsepanetɨ xewitɨ Naimekɨmɨtɨrɨkaɨye 'ayemakatɨ mɨtiuhayewaxɨ,","poem":1},{"text":"hamikuya pɨka'iku'eiri yurikɨ yatiparewietɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Matsi ne'iwama 'aki hayari kemɨtiyukupata hepaɨ mekani'aneneni,","poem":1},{"text":"'uhanetɨ watahautsitɨwatɨ:","poem":2}]},{"type":"verse","number":16,"content":[{"text":"kepauka 'ɨwi mɨkakukenitsie waɨkawa 'akananutinenereni,","poem":1},{"text":"kepauka 'ɨwi mɨtipare 'apatayeyeure,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"matsi 'uhanetɨ katinikuhayeikawani mɨtiuwakinitsie,","poem":1},{"text":"mukɨxɨxɨretsie yuhuyeripa kanakumamawereni.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kɨkamete xaɨtsie pɨta mekaniukɨkani,","poem":1},{"text":"makumawetsie mekanekɨkani, muwa mekanetakukuweni.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kɨkamete Temaha kiekatari haa mekaniuwauximeni,","poem":1},{"text":"yuharerutamete Tsawa kiekatari meta'ikwiewatɨ haa mekaniuwauximeni.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yuri kememɨte'eriekai mekani'u'uxeni,","poem":1},{"text":"kepauka mana memu'axɨa mepu'iyɨri.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yaxeikɨata xeme kaxetiniyurieka:","poem":1},{"text":"xɨka tixaɨtɨ mariweme xete'uxeiya xekaniutimamaweni.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"¿Kemɨ'ane pɨxetiutawawiri tixaɨtɨ xemɨneteminikɨ,","poem":1},{"text":"yatɨni yutuminikɨ xemɨteyutuanikɨ nehetsiemieme?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"¿Kemɨ'ane pɨxetiutawawiri xemɨnetsixɨnakɨ memɨnetsi'aye'unie wahetsɨa,","poem":1},{"lineBreak":true},{"text":"yatɨni memɨkate'uyukanenimaya wahetsɨa xemɨnetsitawikweitsitɨanikɨ?","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"»Kenetineuta'ɨkitɨa, 'anari nepɨkataniuni,","poem":1},{"text":"ketitatsie 'axanetiuyuri keneneuxeitsitɨa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Niuki 'aixɨa manɨyɨne 'axapɨkatiyuyuruwa,","poem":1},{"text":"matsi tixaɨtɨ pɨkatiyunaki'erie 'axakexemutiyuane xeikɨa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"¿Neniukikɨ nehetsie xete'ahɨani,","poem":1},{"text":"'atsixekatemaitɨ xewitɨ mɨwaɨripie hetsie mayeneikakɨ 'eka hepaɨ 'anetɨ?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Xeme matsi xekaniyuwaɨriyani nutui hepaɨtsita xemuyuta'iwakɨ,","poem":1},{"text":"meta yuhamiku xekaniutuawaweni tsepa titakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"»Xekeneneuxeiya nehɨxie,","poem":1},{"text":"¿Nexetiku'itaiyame xenete'erie?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Xekeneutimaixɨa hau'erietɨ xepɨkateyurieka,","poem":1},{"text":"mɨpaɨ xeketenetimati, ne 'axanepɨkatiuka'iyari.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"¿'Axaniuki kuta nehetsie tixɨawe?","poem":1},{"text":"¿kamɨtsɨ neneni katimate tita 'aixɨa mɨti'ane meta 'axamɨti'ane?","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}