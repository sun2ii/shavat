{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"»Teyunaitɨ waɨriyarika tepɨte'uximaya 'ena kwiepa.","poem":1},{"text":"Tukari mɨyehane xeime hetsɨa temɨte'uximayaka hepaɨ pɨtimatsiɨkɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Waɨriyaka ti'uximayatame tukarikɨ taikai mayanikɨ kemɨtitakwewie hepaɨ,","poem":1},{"text":"ti'iwame hepaɨ kemɨtita'ikwewa mɨtipitɨarienikɨ yu'uximayatsikakɨ,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"yakɨxeikɨa waɨkawa metseriyariri nepuyeika mɨpaɨ netiuka'eniwatɨ,","poem":1},{"text":"tɨkarikɨ netiuka'eniwatɨ nepuyeika nehetsie tiunakeku.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne'ukaitɨ mɨpaɨ nepɨtiku'eriwani:","poem":1},{"text":"“¿Kepaukari pɨkahekɨare?”","poem":2},{"text":"Yɨriya hawaikɨ mɨkaheu'aka hepaɨ nepɨtimate,","poem":1},{"text":"ne'itaritsie ta'aurie xeikɨa nekanawautseni kepaukake mɨkahekɨare.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Newaiyaritsie kwitsiterikɨ nepeɨnɨtsa meta nepaukarani,","poem":1},{"text":"nenawiyari kananukutsanikeni meta pɨniya kaniuhaneni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"»Netukari xeiya kaniuhuni tepɨa kemɨrehuiwa reuyeta,","poem":1},{"text":"kata'ikwewatɨ xeikɨa kanaka'iyuniwani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kakaɨyari kenaye'eri, netukari xei'itukariyari kanihɨkɨtɨni,","poem":1},{"text":"hatsuakuri neyutemawietɨ nepɨka'ayani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hikɨ memɨnetsixeiya, matsi 'uxa'a mepɨkanetsixeiyaniri,","poem":1},{"text":"tsepa pemɨnetsixeiyamɨkɨ, matsi nepɨka'uyeikaniri.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Haiwitɨri ta'eketɨ kemɨtiukumamawere hepaɨ,","poem":1},{"text":"mɨkite wateukiyata memeukakɨka tawariri mepɨkawatikɨka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hatsuakuri yukie mepɨka'axe,","poem":1},{"text":"memakuteitsie mekanakumamawereni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"»'Ayumieme nepɨkayɨwe nemɨtinewieni ne'utaniutɨ,","poem":1},{"text":"ne'iyaritsie kenemɨtiuka'eniwakɨ nekaniutaineni,","poem":2},{"lineBreak":true},{"text":"meta mɨyamɨnetiyurie waɨriyarika kanenipitɨaka 'axa'anemekɨ nemɨtaniunikɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"¿Kamɨtsɨ ne haramara netihɨkɨ meta mumariwe maukatewatsie kiekame,","poem":1},{"text":"xemɨnetsitaxeiyanikɨ xeikɨa?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kepauka 'ipaɨ nemɨtiku'eriwa kename ne'itaritsie nenɨtɨarieni","poem":1},{"text":"yatɨni ne'aiwarika heunuani ne'uximatɨarietɨ,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"matsi mana neheinɨtsita pekanenimariutani,","poem":1},{"text":"'axakenemɨtiniere neheinɨtsita waɨkawa pekaneniutimariutani.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yanepɨra'eriwakaku nekɨipitɨa ne'ahuiyame","poem":1},{"text":"nemɨmɨnikɨ, newaiyaritsieri nemɨka'uyeikanikɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nepɨkaheunierimɨkɨri, yuheyemekɨri nemuyeikani yanepɨkara'eriwa.","poem":1},{"text":"Keneneuhayewari, netukariri tixaɨtɨ pɨkatihɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"»¿Tewi ketita tihɨkɨ, waɨkawa meuyewetse pemeyeitɨwa,","poem":1},{"text":"meta hetsiena mieme pemɨ'ahɨawenikɨ,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ximeri paitɨ pepitaxexeiya","poem":1},{"text":"meta tsiere naime hurayaritsie yapemɨti'inɨatanenikɨ?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"'Ariri pepɨkanetsitaxeiyani,","poem":1},{"text":"tsikere 'etsiwa 'aɨrika nemaxɨnikɨ kenenepitɨaka.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Xɨka 'axanetiuyurieni, 'ekɨ 'ahetsie nitixaɨtɨ 'atsipɨkati'ane,","poem":1},{"text":"teɨteri wa'ɨwiyame pehɨkɨtɨtɨ.","poem":2},{"text":"¿Ketitayari nehetsie petituaxane?","poem":1},{"text":"¿Nutsɨ waɨkawa nepɨmatsi'uximatɨa?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"¿Ketitayari 'axakenemɨtiuyuri pekanereuyehɨwirie?","poem":1},{"text":"¿Ketitayari 'axakenemɨtiuyurikɨ pekaratɨmai?","poem":2},{"text":"kwitɨwa matsi, tumuanaritsata nekanihuimɨkɨ,","poem":1},{"text":"pekanenitiwaɨmɨkɨ, matsi nepuka'uyeikaniri».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/6.json","previousChapterAudioLinks":{},"numberOfVerses":21}