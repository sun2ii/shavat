{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":8,"content":[{"type":"heading","content":["Wirirari matɨari kemutayɨ"]},{"type":"verse","number":1,"content":["'Ikɨkɨ Wirirari Tsuha kiekame 'ipaɨ katinita'eiya:"]},{"type":"verse","number":2,"content":[{"text":"«¿Kepaɨmexɨa yape'utaitɨ 'apepuyeikani?","poem":1},{"text":"'aniuki 'eka waɨkawa mɨtɨrɨkaɨye hepaɨ mɨ'anekɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"¿Kamɨtsɨ Kakaɨyari tita mɨtiheitserie 'axatiyurie?","poem":1},{"text":"¿Kamɨtsɨ Naimekɨmɨtɨrɨkaɨye titituna tita mɨtiheitserie?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Xɨka 'aniwema Kakaɨyari hepaɨtsita 'axamete'uyurieni,","poem":1},{"text":"mɨkɨ mɨyakatiniwarakapitɨani 'axakememɨte'uyurikɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Matsi xɨka 'ekɨ Kakaɨyari pe'ayexeiyatɨ pe'ayani,","poem":1},{"text":"Naimekɨmɨtɨrɨkaɨye xɨka pe'utawawirieni mɨmareuyehɨwirienikɨ,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"xɨka pe'itiyaka meta heitseriemekɨ yapetikamieni,","poem":1},{"text":"mɨkɨ 'ahetsie kanitanuamɨkɨ","poem":2},{"lineBreak":true},{"text":"meta hutarieka hakewa pemetayerɨnitsie kamaniyetuiriemɨkɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Matɨari tita pemɨrexeiyakai mɨkɨ 'etsiwa xeikɨa mɨhɨkɨ pɨtihɨkɨtɨkai,","poem":1},{"text":"'uxa'atɨni warie waɨkawa kepemɨrexeiyani hepaɨtsita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"»Meripaitɨ kiekatari keniwaruta'iwawiya,","poem":1},{"text":"keneuti'iwau wapaapama tita memɨte'ukaxei hepaɨtsita.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tame takaike tekaniutinunuiwa, 'atsitepɨkatemate,","poem":1},{"text":"'etɨriya hepaɨ tatukari kani'aneni 'ena temanu'uwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Peru mɨkɨ mepɨmatsitaxatɨani, 'ana yapepɨretimani,","poem":1},{"text":"kememɨtehetima 'ahetsɨa yamepɨtetaxata.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"¿Tiyɨwe papiru 'iteɨriyari haa mɨka'ayemanetsie mɨtawere?","poem":1},{"text":"¿Tiyɨwe mɨtiwawere haka hakewa haa mumawetsie?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tsepanetɨ muxutu meta xewitɨ ka'enuwiteke,","poem":1},{"text":"mɨkɨmeri kanitiwaukeni hipatɨ tupiriya katiwawekaku.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kemɨ'ane Kakaɨyari mematɨmai mɨpaɨ katiniwayurieka,","poem":1},{"text":"mɨpaɨ katineutiparikeni ketita memɨtetakwewie Kakaɨyari memɨka'ayexeiya.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Katɨrɨkaɨyemekɨ mekanita'ikwewani,","poem":1},{"text":"yuri mekateni'erieka tuká winiyarieyatsie.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kepauka mɨkɨ hetsie mɨrawiya pɨkayɨwe mana mɨyɨtɨrɨkariya,","poem":1},{"text":"mepatixɨrieni kepauka mɨkɨ hirutsie memɨte'awiya.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"'Iteɨri waɨkawa yuxawari mexeiya xɨripa muwe hepaɨ mekani'aneneni,","poem":1},{"text":"yumamatekɨ harawerita naitsarie mɨ'etɨriwie:","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tetetsata yunanarikɨ kwi katineukawiwiyani","poem":1},{"text":"kanikuwauneni kwimɨrawiyakɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Peru xɨka manuwetsie hahunarieni,","poem":1},{"text":"hakewa mewekaitsie 'atsipɨkatimatsiɨkɨre.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mɨpaɨ temawierikaya katineutiparikeni,","poem":1},{"text":"meta mana kwiepa hipatɨ pɨtata 'iteɨri kanitineikani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"»Kakaɨyari 'aixɨa mɨtiuka'iyari pɨnaki'erie,","poem":1},{"text":"kemɨ'ane 'axamɨtiyuriene pɨkaparewie.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hekwamekɨ pemutanawenikɨ pɨmatsipitɨani,","poem":1},{"text":"meta pe'atemawietɨ pemutahiwanikɨ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Memɨmatsi'aye'unie mepuyutewiyatsitɨani,","poem":1},{"text":"meta 'axamemɨteyurie wakii pukumaweriya».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}