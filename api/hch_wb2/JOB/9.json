{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOB","translationId":"hch_wb2","name":"Kuwi","commonName":"Kuwi","title":"Kuwi","order":18,"numberOfChapters":42,"sha256":"d3f2db08b29fbac417e96270095bb77b3131312e8ed2f67bbd8f329f0ea7a503","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hch_wb2/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":9,"content":[{"type":"heading","content":["Hairieka Kuwi kemutayɨ"]},{"type":"verse","number":1,"content":["Kuwi mɨpaɨ tiniwaruta'eiya:"]},{"type":"verse","number":2,"content":[{"text":"«Tsepa yemekɨ nemɨtimate kename mɨpaɨ tiɨyɨ,","poem":1},{"text":"pɨkayɨwe tewi mumɨwe Kakaɨyari hɨxie 'aixɨa muyuyurienikɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Xɨka xewitɨ mɨkɨ 'axatihɨawimɨkɨni,","poem":1},{"text":"'iwaurikaya xeimiriyaritsie timieme pɨkayɨwe xeimetɨma muta'eiya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mɨkɨ waɨkawa katinimaiweni tɨrɨkariyaya kanimariweni.","poem":1},{"text":"¿Kemɨ'ane pɨyɨwe 'itamieme 'aixɨa 'iyari mɨyɨxɨna?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hɨri kanikuyuitɨwani mɨkɨ mɨpaɨ katimaikaku,","poem":1},{"text":"meta yuhaxɨakɨ kaniwakupatani xaɨtsie.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mɨkɨ kwie tsutɨmeyari naime kanikuyuitɨwani","poem":1},{"text":"meta 'ikitsaraɨte kwie mutuikatɨka kaniwatayuitɨwani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tau kaniutate'ani, hikɨ 'ɨrɨya kanikɨtɨtɨtseni,","poem":1},{"text":"xurawetsixi waxawatɨriya kaneukunarɨmani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mɨkɨ yuxaɨta muyuawi kaniutawerani,","poem":1},{"text":"meta haramara hamewarieya maunuitɨanikɨ kaniyɨweni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mɨkɨ Hararu meta Terɨka kaniwarunetɨani,","poem":1},{"text":"meta Tsimanixi metatsiere xurawetsixi memɨyuwaɨkawa tatsutɨa memuyetei.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mɨkɨ mamariwaweme witsi'aneneme pɨtiyuriene 'atsikatiyumainɨakame,","poem":1},{"text":"tɨrɨkaɨyemekɨ kemɨtiyuriene pɨkayu'inɨatsinɨa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Xɨka nehɨxie 'uyeyanike, nepɨka'ixeiyakeyu,","poem":1},{"text":"xɨka nehetsɨa hayeyanike, nepɨkayuwe nemixeiyakɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xɨka tixaɨtɨ yupiini rayeitɨani, ¿kepaikɨ pɨyɨwe mita'imaiyakɨ?","poem":1},{"text":"¿Kepaikɨ pɨyɨwe mita'iwawiyakɨ kemɨtiuyurikɨ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kakaɨyari yuhaxɨa pɨkakununuitɨwa,","poem":1},{"text":"Xahawi meta 'iparewiwametemama 'ɨkatɨana mekanikatunuma'uweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"»¿Kamɨtsɨ ne kenetita'eiyakeyu?","poem":1},{"text":"¿Niukikɨ 'axanemɨti'eiyakɨ hakewa nepeitaxeiya?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tsepa 'axanemɨkatiyuruwame, nepɨkayɨwe nehetsie nemɨtanuanikɨ,","poem":1},{"text":"nenimayatsika nemuta'iwauni xeikɨa nepɨyɨwe ne'itsɨkame hɨxie.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tsepa ne'itahɨaweyu mɨkɨ mɨnetsi'uta'ei,","poem":1},{"text":"peru mɨnetsi'enieni nepɨkara'eriwa,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"'Eka naime mɨti'unawekɨ pɨnetsi'umiewe,","poem":1},{"text":"'etsitipemekɨtɨtɨ waɨkawa mɨnetiuka'enitsitɨiya pɨyɨwe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Pɨkanetsi'upitɨawe nemɨta'ienikɨ,","poem":1},{"text":"matsi pɨta, waɨkawa hiwerika pɨnetsi'upitɨawe.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tɨrɨkariyakɨ xɨka ti'aneni, Mɨkɨ matsi kanitɨrɨkaɨyeni.","poem":1},{"text":"Xɨka 'itaxaneta, ¿kemɨ'ane pɨyɨwe mi'atɨanikɨ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Tsepa 'aixɨa 'anemekɨ nemuyeika, neneni kanenanutahɨamɨkɨ,","poem":1},{"text":"tsepa 'atsinemɨka'utaine, nehetsie katinahɨiyamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"»'Aixɨa 'anemekɨ nepuyeika, matsi mɨkɨ tixaɨtɨ pɨkatiyunaki'erie,","poem":1},{"text":"netukari waɨkawa nepɨkanaki'erie.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Tinaitɨ yaxeikɨa katini'aneni, 'ayumieme nekanaineni:","poem":1},{"text":"“'Aixɨa memɨte'u'iyari meta 'axamemɨte'u'iyari yunaime yaxeikɨa katiniwareuyehɨpani”.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Xɨka kwiniya 'utaweni hipame wahetsie yapauka me'ukwini,","poem":1},{"text":"'axamɨkatiyuriene kaninanaimaka tiuka'eniwakaku.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Xɨka xewitɨ kwietsie 'ɨyɨkɨtɨrɨkariyani 'axatiuka'iyaritɨ,","poem":1},{"text":"mɨkɨ 'itsɨkate wahɨxi kanautinarɨmani.","poem":2},{"lineBreak":true},{"text":"¿Kemɨ'ane yapɨtiyurieni? mɨkɨri xɨka yakatiuyurieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"»Nanautsame kemɨkahayɨwe netukari mɨpaɨ kaniyeyɨximeni,","poem":1},{"text":"kaniumieni tixaɨtɨ 'aixɨa mɨti'ane nepɨkaretimaiwe.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kanuwa ha'exanitɨ muhauximeni hepaɨ kani'aneni,","poem":1},{"text":"kwixɨ hepaɨ kanayɨweni kepauka yu'ikwai mɨtitɨximeni hepaɨ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Xɨka 'ipaɨ ne'utayɨni: “Ne'uximatɨarika nepatɨmaiya, 'aixɨa ne'utaitɨ nepayani,","poem":1},{"text":"nepɨnepatari kenemɨraka'erie, ne'utanawetɨ nepayani”,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"kenemɨtiuka'eniwa waɨkawa mɨkɨkɨri nepuma,","poem":1},{"text":"mɨpaɨ nepɨtimate kename heitserie nehexeiyame meka'erie.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"'Ariri nehetsie mɨrahɨiwakɨ,","poem":1},{"text":"¿titayari waɨriyarika netinepitɨaka yakɨxeikɨa?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Tsepa xapunikɨ nemuti'ɨwaxɨ","poem":1},{"text":"naime ne'uyutaxapunimawatɨ meta nemamatsie xapuni mutumuanikɨ,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"haa 'ukuri'ɨatɨ muhanetsie 'ekɨ pekaneneukahɨamɨkɨ,","poem":1},{"text":"hikɨ nekamixatetɨtɨ kanenitixani'erimɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"»Kakaɨyari tewi hepaɨ pɨka'ane,","poem":1},{"text":"teyunaitɨ tahamatɨa 'itsɨkame hɨxie temuti'unikɨ.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Tatsata 'itsɨkame kaniumaweni","poem":1},{"text":"teyuhutame tahetsiemieme yamɨtayɨnikɨ.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Xewitɨ pumawe neheima nunuwame Kakaɨyari 'iwaɨyɨya","poem":1},{"text":"'ateewa mehɨanikɨ nemɨka'imakaxenikɨ kemɨnetimariutakɨ.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Nekaheumatɨ neputaniukanikeyu,","poem":1},{"text":"matsi mɨpaɨ nemɨyɨni nepɨkayɨwe.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOB/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOB/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/8.json","previousChapterAudioLinks":{},"numberOfVerses":35}