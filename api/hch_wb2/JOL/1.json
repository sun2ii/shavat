{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOL","translationId":"hch_wb2","name":"Kuheri","commonName":"Kuheri","title":"Kuheri","order":29,"numberOfChapters":3,"sha256":"ac41c79b4c8df67847ec0ddd75721dbaedd696fe589fafde11430d35c46a784d","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/hch_wb2/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["'Ikɨ Yawé niukieya kanihɨkɨtɨni, Kuheri hetsɨa munua Petuheri nu'aya."]},{"type":"heading","content":["Tekɨmemete kememɨteheuyehɨa"]},{"type":"verse","number":2,"content":[{"text":"Teɨteri 'ukirawetsixi 'ikɨ xekeneu'eni,","poem":1},{"text":"Yemekɨ xekeneu'enana, yunaitɨ teɨteri 'ikɨ kwieyaritsie xemɨtitei.","poem":2},{"text":"¿Heiwamieme 'ipaɨ kapɨtiɨyɨ xeme xe'u'uwakaku","poem":1},{"text":"yatɨni meripaitɨ kiekatari memu'uwakaitsie?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Ikɨkɨ yuniwema xeketeniwarutaxatɨa,","poem":1},{"text":"mɨkɨta yuniwema mepɨtewataxatɨani,","poem":2},{"lineBreak":true},{"text":"yaxeikɨata mɨkɨ xetutsima memɨtewataxatɨanikɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Utsikari 'amemɨnene tita memɨte'utatexi","poem":1},{"text":"'utsikari yakɨmemɨnene naime mekaniutikwani,","poem":2},{"text":"meta 'utsikari yakɨmemɨnene tita memɨte'uhayewaxɨ","poem":1},{"text":"'utsikari 'etsimemɨpepe naime mekateniutikwani,","poem":2},{"text":"'utsikari 'etsimemɨpepe tita memɨte'uhayewakai","poem":1},{"text":"'utsikari kwimemɨpepe mekateniutikwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Xemɨtarɨwe, xekenanutaneniereni xekeneutitsuanani.","poem":1},{"text":"Yemekɨ xekeneuti'aiwani winutsie xemɨyuyetua,","poem":2},{"lineBreak":true},{"text":"matsi kaxie winuyari makaka xekaniunawaiyarieni xemi'iekaikɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xewitɨ kiekari mɨtɨrɨkaɨye memɨkayu'inɨatsinɨa","poem":1},{"text":"mekaniu'axɨani nekwietsie:","poem":2},{"text":"Mɨkɨ mayetsi wahepaɨ mekateniutameni,","poem":1},{"text":"maye 'uka tameteya 'emɨtɨtɨ hepaɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Naime mepɨte'ukakɨmixɨ kaxie xawari,","poem":1},{"text":"piní mepukamuraxɨ.","poem":2},{"text":"Mamateya naime meputimetseriyaxɨ,","poem":1},{"text":"naime mepukakarauxi 'ɨkaya meta xawari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Neteɨterima meputitsuana 'uka 'ɨimari heiwerika 'iwiyari manahɨwa hepaɨ","poem":1},{"text":"mitiwitɨnikekai 'umɨku hetsiemieme.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hatsite mawariyari meta kaxie winuyari mɨtiyeuriwakai,","poem":1},{"text":"mɨkɨri Yawé tukieyata pɨkareyetuiwa.","poem":2},{"text":"Mawari wewiwamete mepuyuheiwerie,","poem":1},{"text":"Yawé hetsiemieme te'uximayatamete.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Naitɨ 'ikwaxi pɨka'ukaxuxuawereri mɨraku'etsitɨretsie,","poem":1},{"text":"naitɨri kwie kaniuwakini,","poem":2},{"text":"hatsiteri naitɨ katineuyeweni,","poem":1},{"text":"kaxie winuyariri mɨhekwa kaniukawani","poem":2},{"lineBreak":true},{"text":"meta hatseiti kaniuxɨniri naitɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Xemetatsiere xeke'utiwani, te'uximayatamete,","poem":1},{"text":"xekeneutitsuanani meta te'etsamete,","poem":2},{"text":"xemɨte'ekai tsewara meta tɨriku xemɨteheuyehɨakɨ,","poem":1},{"lineBreak":true},{"text":"naitɨtsɨari mɨraku'etsitɨre mɨtiuka'etsiwakai katineuyeweni.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kaxie naitɨ kaniutiyɨnare,","poem":1},{"text":"piní kaniutawani,","poem":2},{"text":"'ikwaxi manitsana hepaɨ mɨ'anene kaniutiyɨnare,","poem":1},{"text":"takɨ meta manitsana,","poem":2},{"lineBreak":true},{"text":"naitɨ kɨyexite 'ɨtsita mɨreuka'u.","poem":2},{"text":"Yaxeikɨa teɨteri watemawierika kaniutiyɨnare.","poem":1}]},{"type":"heading","content":["Kememɨte'uta'inierie memɨtehayewanikɨ ke'axamemɨteyurie"]},{"type":"verse","number":13,"content":[{"text":"Xeme mawari wewiwamete, heiwerika kamixayari xekenanakatɨkɨni xe'utitsuatɨ.","poem":1},{"text":"Xekeneyuheiwerieka, mawari taiyame te'uximayatamete.","poem":2},{"text":"'Ena xekenakɨni, xeme Kakaɨyari hetsɨa te'uximayatamete,","poem":1},{"text":"tɨkarikɨ hiwerika kamixayari xekenanakatɨkɨni,","poem":2},{"text":"hatsite mawariyari meta kaxie winuyari mɨka'atɨariwanikɨ","poem":1},{"text":"Kakaɨyari kiitana mɨtiuta'imaritɨxɨkɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Xekeneyuhakieka xeyuyetuatɨ,","poem":1},{"text":"xekenewa'inieka teɨteri memayuxeɨrietsie.","poem":2},{"text":"'Ixaheritsixi teɨteriyari 'ukirawetsixi xekeniwaxeɨrieka","poem":1},{"text":"Yawé xekakaɨyari kiita,","poem":2},{"text":"yunaime teɨteri kiekari mɨtama xekeniwarukuxeɨri,","poem":1},{"text":"meta Yawé xekeneutahɨawi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Xɨa'ui 'iya tukaritsie, Yawé tukarieya maye'aximekɨ.","poem":1},{"text":"Mɨkɨ tukaritsie naime katinika'unamɨkɨ Naimekɨmɨtɨrɨkaɨye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ta'ikwai kataniunawairieni","poem":1},{"text":"tame tenenierekaku,","poem":2},{"text":"te'utinawetɨ meta ketemɨteyutemamawiekai","poem":1},{"text":"takakaɨyari tukieyata mieme.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"'Imɨari kaniutipɨne","poem":1},{"text":"muka'etsiekai.","poem":2},{"text":"'Imɨari muwati'utsiwatsie puyexɨ","poem":1},{"text":"meta naitɨ puti'unixɨ kiiyari","poem":2},{"lineBreak":true},{"text":"mɨtiuka'etsiekai mɨreuyewekɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tewaxi yemekɨ meputitsuana.","poem":1},{"text":"Hau'erietɨ mepeu'uwa wakaitsixi","poem":2},{"text":"hakewatsɨ metehetikwani katiniumaweni,","poem":1},{"text":"yaxeikɨa muxatsi mekateniuka'eniwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"'Ekɨ, Yawé, ne nepɨmetsiwawirie,","poem":1},{"text":"'ɨxatsɨ 'ayeparitsie meuka'ukai taikɨ mutitai,","poem":2},{"lineBreak":true},{"text":"tai 'amanutiteterekɨ naime katiniutitaiya kɨyexite 'ɨtsita mɨreuka'ukai.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Tewaxi yeutari mepɨmetsikuwautɨwe meteheuyehɨatɨ,","poem":1},{"text":"wahaa 'akiitsie naitsarie mukawaxɨakɨ","poem":2},{"lineBreak":true},{"text":"tai 'ɨxa mutitaiyaxɨkɨ 'ayeparitsie.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}