{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOL","translationId":"hch_wb2","name":"Kuheri","commonName":"Kuheri","title":"Kuheri","order":29,"numberOfChapters":3,"sha256":"ac41c79b4c8df67847ec0ddd75721dbaedd696fe589fafde11430d35c46a784d","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/hch_wb2/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"heading","content":["'Utsikari kuyaxiyari"]},{"type":"verse","number":1,"content":[{"text":"Kerutsaremetsie kuxineta xekeneutahɨtsiwani,","poem":1},{"text":"nehɨri mɨpatsie hetsie xekeneutihiwani mɨ'enieriekakɨ.","poem":2},{"text":"Yunaitɨ teɨteri kwiepa xemɨtama xekenemamaka,","poem":1},{"text":"'aritsɨari Yawé tukarieya 'ukanamieni","poem":2},{"lineBreak":true},{"text":"kaniyuritɨni kanehuraniri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yɨriya tukariyari kanaye'amɨkɨ,","poem":1},{"text":"hai tukariyari mɨyɨyɨxawi kanaye'amɨkɨ.","poem":2},{"text":"Hekɨariya kemɨtiyuhekɨa kahekɨarirɨmetɨ kwiepa,","poem":1},{"text":"mɨpaɨ katinimakatsiukɨni kiekari mɨmariwe mɨtɨrɨkaɨye,","poem":2},{"text":"meripaitɨ hatsuaku kemɨkatiɨyɨ,","poem":1},{"text":"nuiwarite 'umemahu wahetsiemiemeri hatsuaku yapɨkatiyɨni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mexiyukukuyamete meka'aye'axɨawawe 'iya tai kaniwatixɨtsitɨwani,","poem":1},{"text":"kepauka mɨpaɨ mɨraye'ani tai pɨtititaiya naime.","poem":2},{"text":"Mexixi kahaye'awe kiekari 'Ereni haraweriyari witsimɨraku'ane hepaɨ pɨtiyuxexeiya,","poem":1},{"text":"kepauka mɨpaɨ mɨtiyɨni yeuta makumawe payani.","poem":2},{"lineBreak":true},{"text":"Tɨrɨkariyaya hepaɨtsita tixaɨtɨ pɨkatitawikweni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kawayutsixi wahepaɨ mepɨteyuxexeiya,","poem":1},{"text":"kawayutsixi meha'atɨ meheuyukwiyuka wahepaɨ mepɨte'unanautsa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kepauka hɨri 'emutɨtɨtsie memeutatsukwaka,","poem":1},{"text":"kaxetatsixi yukukuyamete wayuarika hepaɨ pɨtiyu'eniɨriɨkɨ,","poem":2},{"text":"xatsi taipa taiyarietɨ mutatsipɨarɨka hepaɨ.","poem":1},{"text":"Kuyaxi memɨtɨrɨkawi 'aixɨa memɨteheku'u meyutakwinike mɨpaɨ mepɨteyuhekɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Teɨteri marikakɨ meputiyɨyɨaka,","poem":1},{"text":"yunaitɨ mepunututuixietɨka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mepaye'axɨa memeuyutakwiwawe wahepaɨ,","poem":1},{"text":"wapaitɨ mepeutimake kuyaxi wahepaɨ.","poem":2},{"text":"Yuxexuitɨ mepuhu","poem":1},{"text":"'aixɨa meteheuku'utɨ kememɨteyu'uitɨakai.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yuhetsie mepɨka'uyexɨrɨwe,","poem":1},{"text":"heitserie mepuhu yuxexuitɨ.","poem":2},{"text":"'Ɨrɨtsata mekaniuhuni","poem":1},{"text":"meka'anuyutaxɨrɨwatɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kiekaritsie mekanitahakeni,","poem":1},{"text":"kuraru heima mepeukamake,","poem":2},{"text":"kiitetsie mepɨtimake,","poem":1},{"text":"'etsimeuyeyeutsie mepeuhake tenawayamete wahepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"'Ikɨ kuyaxi wahɨxie kwie naitɨ puyuane","poem":1},{"text":"meta muyuawi pukuyuane,","poem":2},{"text":"tau meta metseri pɨyɨrixɨani,","poem":1},{"text":"meta xurawetsixi mepɨtehayewa mehekɨariwietɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yawé niukieya kanekutɨrarɨkani","poem":1},{"text":"yukuyaxima wahɨxie,","poem":2},{"text":"mepɨkayu'inɨatsinɨa kuyaximama","poem":1},{"text":"mepɨtɨrɨkawi niukieyatsie yamemɨtekahu.","poem":2},{"text":"Yawé tukarieya waɨkawa kanimariweni kanimakaxiwani.","poem":1},{"text":"Xewitɨ pɨkayɨwe mɨtinewirienikɨ.","poem":2}]},{"type":"heading","content":["Kememɨte'uta'imaiyarie memɨtehayewakɨ 'axameteyurietɨ"]},{"type":"verse","number":12,"content":[{"text":"Yawé mɨpaɨ kanaineni: «Merikɨ,","poem":1},{"text":"yunaitɨ yu'iyarikɨ nehetsɨa xekeneu'axɨa,","poem":2},{"lineBreak":true},{"text":"xe'utitsuatɨ, xeyuheiwerietɨ xekatekwatɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yu'iyaritsie xekeneuyukatsanani","poem":1},{"text":"yukamixatsie pɨkatixaɨ.","poem":2},{"text":"Yawé yukakaɨyari hetsɨa xekeneu'axɨa,","poem":1},{"text":"mɨkɨ pɨtiuyukanenimaya pɨkahayu'eriya,","poem":2},{"text":"naki'eriyakɨ pɨhɨne kwitɨwa pɨka'uyeha'arɨwe,","poem":1},{"text":"pɨyuwaɨriya naime mɨreuyehɨwirienikɨ meta pɨkarakwinitɨani.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Heiwatɨ Kakaɨyari 'aixɨa mɨtinixe'uxei kemɨtiku'eriwakai mɨnipataxɨ,","poem":1},{"text":"'aixɨa mɨti'ane mɨtatiniuhayewi.","poem":2},{"text":"'Imikieri hatsite mɨkɨ meta kaxie winuyari mɨtiyeuriwa","poem":1},{"text":"Yawé xekakaɨyari hetsɨa katinimiemetɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kerutsaremetsie kuxineta xekeneutahɨtsiwani,","poem":1},{"text":"xeketeniwarukaxatɨa memɨyuhakienikɨ,","poem":2},{"text":"xekeniwaruta'ini yunaime 'axeikɨa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kiekatari xekeniwarukuxeɨri,","poem":1},{"text":"xekenepatsieka xeyuxeɨrietɨ","poem":2},{"text":"'ukirawetsixi mana kiekatari xekeniwarukuxeɨri,","poem":1},{"text":"'etsimemupepe meta xekeniwarukuxeɨri","poem":2},{"lineBreak":true},{"text":"meta tɨɨri memɨtsitsewetɨka.","poem":2},{"text":"Kewayeyani hekwamekɨ mutineɨkixɨ,","poem":1},{"text":"meta 'uka mɨhekwawikie kewayeyani yukiita.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Xekeneutitsuanani te'uximayatamete mawari wewiwamete Yawé hetsɨa miemete,","poem":1},{"text":"tuki mɨranutahakitɨre hɨxie meta mawari taiyame hɨxie xeti'utɨ,","poem":2},{"text":"mɨpaɨ xe'utiyuatɨ: «Yawé 'ateɨterima ketiniwareuyehɨwirieka.","poem":1},{"text":"Pepɨkatatsiyetuayani 'axatemɨka'itɨarienikɨ","poem":2},{"lineBreak":true},{"text":"kapa nuiwarite tahetsiemieme 'axame'utiyuanikɨ.","poem":2},{"text":"Hipatɨ mɨpaɨ memɨka'utiyuanenikɨ teɨteri:","poem":1},{"text":"“¿Hakewa xekakaɨyari peyeika?”»","poem":2}]},{"type":"heading","content":["Yawé kemɨtiwaruta'ei"]},{"type":"verse","number":18,"content":[{"text":"Merikɨtsɨ Yawé matsiɨkɨme kanayeitɨani kemɨtinaki'eriekai yukwie hetsiemieme,","poem":1},{"text":"katiniwareuyehɨwirieni yuteɨterima.","poem":2}]},{"type":"verse","number":19,"content":["Yawé mɨpaɨ katiniwaruta'eiya:",{"text":"«Neuxei nepɨtixeyetuirieni, hatsite, kaxie winuyari mɨhekwa meta hatseiti,","poem":1},{"text":"waɨkawa nepɨxetihuxaitɨani 'aixɨa xeteyukuhɨaweme nepɨxehayewa.","poem":2},{"text":"Nepɨkaxeyetuani tawari","poem":1},{"text":"hipame kiekarite wahetsɨa xemɨnanaimarienikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"»Nepɨkawapitɨani 'utsikari xeyeta 'amemayehu,","poem":1},{"text":"kwie makumawetsie meta makuwakitsie nepɨwareukɨnɨ'ani:","poem":2},{"text":"Haramara Mɨmɨkitsie nepɨwakayunitɨani wakuyaxi memanuyetei,","poem":1},{"text":"wa'utɨmata memuhu Haramara Meritexaniyatsie.","poem":2},{"text":"Wakaxari pɨtipɨne","poem":1},{"text":"waɨkawa pɨtiukuri'ɨaka».","poem":2},{"text":"Yawé waɨkawa mariwemekɨ katiniyurimɨkɨ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nekiekari pepɨkamaka,","poem":1},{"text":"matsi kene'atemawieka kene'uxipieka,","poem":2},{"text":"matsi Yawé waɨkawa mariweme katiniyuriemɨkɨ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tewaxi xepɨkamamaka 'ɨtsita xemu'uwa,","poem":1},{"text":"'ɨxa mumawekaitsie pɨtixuawere naitɨ pɨtiyɨra,","poem":2},{"text":"'iteɨrite yutakariri mɨtikwaiwa pɨtixuawitɨani,","poem":1},{"text":"piní meta kaxie waɨkawa pɨtixuawere.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Xekeneyutemamawieka Tsiyuni tɨɨriyamama,","poem":1},{"text":"temawierika xekenexeiyani Yawé yukakaɨyari hetsiemieme,","poem":2},{"lineBreak":true},{"text":"kepauka maye'ani wiyeri pukuyuitɨani tukarieyatsie.","poem":2},{"text":"Wiyeri pɨxehanɨ'airieni","poem":1},{"text":"xekaka'ewawekaku meta xeka'itsanayu,","poem":2},{"lineBreak":true},{"text":"meripaitɨ manukatɨatsie kemɨtiyurienekai hepaɨ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mɨrati'uritɨretsie tɨriku waɨkawa pɨtixuawere,","poem":1},{"text":"kaxie mahinarietsie winu mɨhekwa waɨkawa puxuaweni meta hatseiti.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"«Ne nepɨtixekɨhɨwirieni","poem":1},{"text":"kepaɨmexɨa wiyari xemɨteheuyehɨa naime,","poem":2},{"text":"'iya kuyaxi memɨyumɨire tekɨmemete wahekɨ","poem":1},{"text":"kenemɨtiwarenɨ'a xehetsɨa:","poem":2},{"text":"'amemɨnene, meta yakɨmemɨnene,","poem":1},{"text":"'etsimemɨpepe meta kwimemɨpepe.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Xeme waɨkawa xepɨte'utikwa'ani, kexemɨteheukwaikɨ,","poem":1},{"text":"Yawé yukakaɨyari hetsiemieme 'aixɨa xeputiyuaneni,","poem":2},{"text":"xehetsiemieme 'aixɨa kemɨtiyurieni.","poem":1},{"text":"Tawariri hatsuaku neteɨterima nepɨkawatewiyatsitɨani.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Merikɨte 'ana mɨpaɨ mekatenetimaikuni kename ne 'ixaheritsixi wahamatɨa ne'uyeika,","poem":1},{"text":"kename ne Yawé xekakaɨyari nehɨkɨ,","poem":2},{"lineBreak":true},{"text":"xewitɨ tawari 'apɨka'uyeika kakaɨyaritɨtɨ ne'aurie.","poem":2},{"text":"Tawari hatsuaku neteɨterima mepɨkatewiyatsitɨarieni.","poem":1}]},{"type":"heading","content":["Yawé tukarieya"]},{"type":"verse","number":28,"content":[{"text":"»'Arike mɨpaɨ tiyɨyu,","poem":1},{"text":"ne'iyari nepɨtatuani yunaime teɨteri wahetsie.","poem":2},{"text":"Xeme xeniwema 'ukitsi 'ukari mepɨtetaxata,","poem":1},{"text":"'ukirawetsixi mepɨteheinɨni","poem":2},{"lineBreak":true},{"text":"temarita mepɨtexeiyatsitɨarieni.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Mɨkɨ tukaritsie ne'iyari nepɨtatuani","poem":1},{"text":"'ukitsi meta 'ukari te'uximayatamete wahetsie.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Mɨyuawitsie meta kwiepa 'inɨari nepɨtiyurieni:","poem":1},{"text":"xuriya, tai, meta kɨtsi 'e'utɨtɨme.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Tau yɨwitɨ kanayeimɨkɨ","poem":1},{"text":"metserita xuriyapaɨ 'anetɨ kanayeimɨkɨ","poem":2},{"text":"mexi Yawé tukarieya kahaye'aweni,","poem":1},{"text":"kepauka mariwemekɨ mɨtiyurienitsie.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Yunaitɨ Yawé memahɨawe kemɨtimariwe","poem":1},{"text":"yutukari mekanitawikweitsitɨakuni,","poem":2},{"text":"hɨritsie xeikɨa Tsiyuni meta Kerutsaremetsie,","poem":1},{"text":"pɨyɨweni muyuta'una,","poem":2},{"lineBreak":true},{"text":"Yawé kemɨtiwarutahuawekai.","poem":2},{"text":"Memayeneniere wahamatɨa","poem":1},{"text":"xeikɨa mepu'uwani Yawé mɨwaruta'ini.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}