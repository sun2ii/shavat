{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JOL","translationId":"hch_wb2","name":"Kuheri","commonName":"Kuheri","title":"Kuheri","order":29,"numberOfChapters":3,"sha256":"ac41c79b4c8df67847ec0ddd75721dbaedd696fe589fafde11430d35c46a784d","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/hch_wb2/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["Nuiwarite kememɨte'ukwinitɨarie"]},{"type":"verse","number":1,"content":[{"text":"»'Iya tukaritsie, kemɨtika'inɨaritsie maye'anikɨ,","poem":1},{"text":"kepauka ne Kura 'aixɨa nemɨwayurieni meta Kerutsareme newahekwariyatɨ,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"yunaime nuiwarite nekaniwakuxeɨriemɨkɨ","poem":1},{"text":"Kutsapati mayeweritsie nekaniwakanɨ'amɨkɨ.","poem":2},{"text":"Mana nekaneutahamɨkɨ teɨteri nemɨtiwakwinitɨanikɨ","poem":1},{"text":"neteɨterima 'Ixaheritsixi wahetsiemieme,","poem":2},{"text":"'ateewa nuiwarite watsata memɨwareutaweiyaxɨakɨ","poem":1},{"text":"meta nekwie memuyutaxitekiexɨakɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Neteɨterima mepuyuta'iwiri kemɨ'anetsie mɨtinakenikɨ,","poem":1},{"text":"tɨɨri mepuwarupataxɨ 'ukari tuminikɨ memɨyuwitɨnɨa wahekɨ,","poem":2},{"text":"meta memɨtitarɨwenikɨ,","poem":1},{"text":"'ukari tɨɨrixi winukɨ mepuwarutua.","poem":2}]},{"type":"verse","number":4,"content":["»Merikɨte, Tiru meta Tsiruni, meta naitsarie mɨtiuyehane Piritsiteu kwieyari hetsie, ¿ketita kuta xetehayexeiya nehetsiemieme? ¿Xenetekɨhɨwirienike xeteyu'erie? Xɨka mɨpaɨ 'aneni, nematsi kwitɨ yanepɨtiyurieni xehetsie mɨtinakenikɨ kexemɨnetsiyuriku,"]},{"type":"verse","number":5,"content":["xemetsɨ nehuru meta nepɨrata xekaniunawani, yutukita paitɨ xekatenetɨni piinite waɨkawa nemɨreuyehɨwa."]},{"type":"verse","number":6,"content":["Xeme kɨriyekutsixi wahetsɨa neteɨterima xekaniwarutuani Kerutsareme meta Kura memɨtama yukwiepa memɨka'u'uwanikɨ."]},{"type":"verse","number":7,"content":["»Matsi mɨpaɨ xeketenemaika, ne nepuwarayewitɨni tsepa hakewa paitɨ memetuiyakai, ne yanepɨtiyurieni mɨkɨ 'axakexemɨte'uyuri xehetsie mɨtinakenikɨ."]},{"type":"verse","number":8,"content":["Xeniwema 'ukitsi 'ukari Kura kiekariyaritsie nepɨwatuani, mɨkɨta yaxeikɨa tsaweutsixi wahetsɨa mekaniwatuakuni nuiwarite 'ateewa kiekatari wahetsɨa». Yawé mɨpaɨ kaniutayɨni."]},{"type":"verse","number":9,"content":[{"text":"Nuiwarite mɨpaɨ xeketeniwarutaxatɨa:","poem":1},{"text":"Xekeneyuha'aritɨaka xemɨyutakwinikɨ.","poem":2},{"text":"Kuyaxi xekeniwaxeɨrieka.","poem":1},{"text":"Xekeneyuha'aritɨaka yunaitɨ 'ukitsi kuyaxa miemete xemuyutakwinikɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hatsaruni yu'ixipara xekenayeitɨa","poem":1},{"text":"meta huxa tɨriku xikame tepɨa 'amɨtewi xekenayeitɨa.","poem":2},{"text":"Kemɨ'ane meumaka mɨpaɨ ke'utayɨni:","poem":1},{"text":"«Ne nepɨka'ukama».","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Xeiya xekeneyumexɨitɨaka, nuiwarite xemɨtama ta'aurie,","poem":1},{"text":"mana xekeneyuxeɨrieka mayeweritsie.","poem":2},{"lineBreak":true},{"text":"Yawé, keniwaranɨ'a memayu'eririya 'ahetsɨa miemete.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Nuiwarite xekeneyukuxeɨri,","poem":1},{"text":"xekenehu Kutsapati muyeweri paitɨ,","poem":2},{"text":"mana nekananukayerɨmɨkɨ","poem":1},{"text":"teɨteri 'auriena kiekatari nemɨtiwakwinitɨanikɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Keneukaxitekiri,","poem":1},{"text":"tɨriku 'aixɨa mɨ'anene kanihɨkɨtɨni.","poem":2},{"text":"Kaxie xekeneutiketsina,","poem":1},{"text":"matiketsinarɨwatsie pɨhɨpɨne.","poem":2},{"text":"Kaxie xariyariri panakayeuriwe:","poem":1},{"text":"puwaɨkawari 'axakememɨteyurie».","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mekaniyɨmɨireni memɨyɨxeɨrie","poem":1},{"text":"Mayeweri maye'atɨarienitsie.","poem":2},{"text":"'Ari Yawé tukarieya kanehuraniri","poem":1},{"text":"Mayeweri maye'atɨarienitsie.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tau meta metseri kaniyɨrixɨakuni,","poem":1},{"text":"xurawetsixi mepɨkahekɨariwieniri.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yawé puyutahaxɨatɨani Tsiyunitsie paitɨ,","poem":1},{"text":"Kerutsareme paitɨ tɨranarieya kani'enieriemɨkɨ,","poem":2},{"lineBreak":true},{"text":"kwie meta muyuawi kanitayuamɨkɨ.","poem":2},{"text":"Matsi Yawé kemɨ'ane memɨteɨterimama pɨwa'awietani,","poem":1},{"text":"'ixaheritsixi pɨwatɨrɨkariya.","poem":2}]},{"type":"heading","content":["Kakaɨyari yuteɨterima 'aixɨa kemɨwaruyuri"]},{"type":"verse","number":17,"content":[{"text":"«Merikɨtsɨ xeme mɨpaɨ xekatenetimaikuni, ne Yawé xekakaɨyari,","poem":1},{"text":"Tsiyuni nemukakɨ neyemuri mɨpatsietsie.","poem":2},{"text":"Kerutsareme mɨpatsie kanayeimɨkɨ,","poem":1},{"text":"tawari 'ateewa kiekatari waɨriyarika mepɨkawatahaxɨani mexenawairienike.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"»'Iya tukaritsie kaxie winuyari makaka hɨritsie panexɨani,","poem":1},{"text":"yemuritetsie retsi puhapaneni.","poem":2},{"lineBreak":true},{"text":"Haa puwayenexɨani 'akite manuyehapanetsie kura kwieyaritsie.","poem":2},{"text":"Yawé tukieyata haixa pɨtineikani,","poem":1},{"text":"'Akatsiya kɨyeyari pɨhatuiyani mayeweritsie mɨye'u.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"'Ekipitu naime nepɨrakumaweriya,","poem":1},{"text":"'Erumi makumawe nepayeitɨani,","poem":2},{"text":"'axamemɨwaruyurikɨ Kura kwieyaritsie kiekatari,","poem":1},{"text":"wakwiepa waxuriya memutayeurikɨ 'atsimekateyuriekame.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kura kwieyaritsie meta Kerutsaremetsie kiepa payani yuheyemekɨ,","poem":1},{"text":"yunaime nuiwari 'umemahu wahetsiemieme.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"¿Kamɨtsɨ netiwareuyehɨwirieni xuriya memutayeuri?","poem":1},{"text":"Matsi hawaikɨ nepɨkatiwareuyehɨwirieni».","poem":2},{"lineBreak":true},"Yawé Tsiyunitsie 'ukaitɨ kanayeimɨkɨ."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":21}