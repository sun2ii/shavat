{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"JON","translationId":"hch_wb2","name":"Kunatsi","commonName":"Kunatsi","title":"Kunatsi","order":32,"numberOfChapters":4,"sha256":"e5c8bce3f60f9cf7e028c6097b32f74e3ad93094ea673fb3539c6d8fc274053d","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/hch_wb2/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Kunatsi kemɨtiuyunenewi"]},{"type":"verse","number":1,"content":["Hikɨ Kunatsi Yawé yukakaɨyari kaniutahɨawe ketsɨ 'amupa yuriepa paitɨ yekaitɨ."]},{"type":"verse","number":2,"content":["Mɨpaɨ kaniutayɨni:",{"text":"«Waɨkawa neyuhiwerietɨ Yawé neputahiwi,","poem":1},{"text":"hikɨ mɨkɨta pɨnetsi'uta'ei.","poem":2},{"text":"Kepauka 'aritɨtɨri nemɨmɨkikai parewiya nekaniuta'iwauni,","poem":1},{"text":"'ana 'ekɨ nehiwari pepu'eni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Emeukatewatsie pepɨnetsiheukahɨa,","poem":1},{"text":"haramara hixɨapa,","poem":2},{"text":"haa mɨtɨrɨkaɨye pɨnetsikurupanekai,","poem":1},{"text":"naitɨ 'ahamewari neheima puyekɨkakai.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Ana mɨpaɨ nepɨtiu'eri: “'Ahɨxie nemɨka'uyeikanikɨ","poem":1},{"text":"nepayeweiyarie.","poem":2},{"text":"¿Keneyɨanetɨ nepunuani","poem":1},{"text":"tawari nemixeiyanikɨ 'atuki mɨpatsie?”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Naitɨ nepukayunixɨ,","poem":1},{"text":"haramara 'ameukatewa pɨnetsi'anukanakai,","poem":2},{"text":"tupiriya hata mieme nemu'utsie pekutsetsewekai,","poem":1}]},{"type":"verse","number":6,"content":[{"text":"nepukurupirɨmekai hɨri muyu'utɨkatsie hata paitɨ.","poem":2},{"text":"Neheyemekɨ neheyame nepɨne'eriekai,","poem":1},{"text":"nemanuani nepɨkaheyɨwekai.","poem":2},{"text":"Yawé nekakaɨyari, peru 'ekɨ","poem":1},{"text":"netukari peputawikweitsitɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"»Kepauka 'ari nemɨmɨximekai,","poem":1},{"text":"Yawé nepaye'eri,","poem":2},{"text":"hikɨ 'ekɨta nenenewieri pepu'eni,","poem":1},{"text":"'atuki mɨpatsieta paitɨ pepi'eni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"»Tetexi kakaɨyarixiyari memɨwarayexeiya","poem":1},{"text":"'anaki'eriya mepɨku'eiri.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ne matsi, mawarite nepɨmatsiwewirieni,","poem":1},{"text":"meta nɨawari 'ahetsiemieme nepɨyetuani.","poem":2},{"text":"Nepɨraye'atɨani kenemɨmatiutahɨawixɨ.","poem":1},{"text":"'Ekɨ xeikɨa, Yawé, wikweitsitɨarika pemexeiyakɨ».","poem":2}]},{"type":"verse","number":10,"content":["Hikɨ Yawé ketsɨ 'amɨpa katiniuta'aitɨani Kunatsi mɨhayanikɨ hatetsita paitɨ."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}