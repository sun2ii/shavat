{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"LAM","translationId":"hch_wb2","name":"Hiwerika","commonName":"Hiwerika","title":"Hiwerika kwikariyari","order":25,"numberOfChapters":5,"sha256":"189e3bd57feb4cea3bccd7fe00b17b66b01391b22ae30e6d91a101faed00d88b","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/hch_wb2/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Xɨa'ui, yuxaɨta puyuhayewaxɨ,","poem":1},{"text":"kiekari meripaitɨ witsimɨ'anekai teɨteri warexeiyatɨ.","poem":2},{"text":"'Ukaratsi wiura hepaɨ pɨtiyuxexeiya,","poem":1},{"text":"meripaitɨ mumariwekai yunaime nuiwarite watsata.","poem":2},{"text":"Meripaitɨ wamaama mɨhɨkɨtɨkai.","poem":1},{"text":"Hikɨri waɨriyarika ti'uximayatame pɨhɨkɨ wahetsiemieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Tɨkakɨta kwinimieme tiutsuatɨ kaniukatariyarɨwani,","poem":1},{"text":"'ukaiya 'aurieyatsie kaniukakɨkani.","poem":2},{"text":"Nixewitɨtɨma muwanaki'eriekai","poem":1},{"text":"hikɨ pɨkahenɨtɨwa.","poem":2},{"text":"Hamikumama yunaitɨ mekaniku'eirieni,","poem":1},{"text":"me'eye'unietɨ pɨta mekanakɨne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tixaɨtɨ karayeitɨarieka, tepɨa kaunariyarikɨ 'uwiwitɨarieka,","poem":1},{"text":"Kura kanehanieni 'ateewa paitɨ.","poem":2},{"text":"Hipame nuiwarite watsata meyuhayewakɨ,","poem":1},{"text":"hikɨ 'uxipiya pɨkahekaxeiyawe.","poem":2},{"text":"Yunaitɨ memiweiyakai mekanenuku'axe,","poem":1},{"text":"pɨkaheixeiyari kemɨ'ane miparewieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kerutsareme huyeyarite 'utɨma 'umietɨ puhiweriyɨkɨ,","poem":1},{"text":"nixewitɨri patsiekamekɨ 'ixɨararipa memuyukuxexeɨriwatsie pɨkaheta'axe.","poem":2},{"text":"Kiekari kitenieyarite yuxaɨtame puyuhayewaxɨa:","poem":1},{"text":"mawari wewiwamete meputi'aiwa,","poem":2},{"text":"'ukari 'ɨimarixi mekaneu'erietɨweni,","poem":1},{"text":"mɨkɨ yunaitɨ 'atsiwimekɨ mekaniu'uwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Memɨwaraye'uniekai metewa'aitɨatɨ mekanakɨne,","poem":1},{"text":"kayuwatɨ mekaniu'uwani memɨwaraye'unie.","poem":2},{"text":"Yawé kaniwaru'uximatɨani,","poem":1},{"text":"waɨkawa 'axamemɨte'uyurikɨ.","poem":2},{"text":"Waniwema mekanewitɨkieni 'ateewa paitɨ,","poem":1},{"text":"memɨwaraye'unie hau'erietɨ mekaniwaruhapaximekaitɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kerutsareme witsikemɨ'anekai","poem":1},{"text":"naime witsikemɨtiyuxexeiyakai katineuyehɨani.","poem":2},{"text":"Mana memɨte'aitakai maxatsi wahepaɨ mekani'aneni,","poem":1},{"text":"'ɨxa memɨwautɨwe hakewa meheikaxeiya.","poem":2},{"text":"Mekaniyuta'unani mekayɨwawetɨri,","poem":1},{"text":"memɨwaruweiya wahɨxie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Paye'eriwa Kerutsareme,","poem":1},{"text":"kepauka yɨxaɨta nutuixietɨ 'amuyeikakai,","poem":2},{"text":"meripaitɨ waɨkawa kemɨrexeiyakai pɨra'eriwa","poem":1},{"text":"meripaitɨ mɨtipiinieyatɨkai.","poem":2},{"text":"Kepauka memeye'unie hetsɨana memɨye'axɨa,","poem":1},{"text":"nixewitɨ 'ana pɨkanua 'iparewienike.","poem":2},{"text":"Memeye'unie mepixei kepauka matiwe,","poem":1},{"text":"'ana mɨkɨ mepi'atsekai me'inanaimatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kwinimieme 'axapɨtiuyuri Kerutsareme,","poem":1},{"text":"'ayumieme ka'itiyatɨ kanayani.","poem":2},{"text":"Meripaitɨ 'aixɨa memɨte'ixeiyakai hikɨ mepi'uxiwe'erie,","poem":1},{"text":"maweme memɨxeiyakɨ,","poem":2},{"text":"'ayumieme mɨkɨ putatsuaka,","poem":1},{"text":"meta puyutewiya hɨxiena xɨka 'ixeiyamɨkɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kemarieya kaniutatɨnire,","poem":1},{"text":"'atsipɨkareitimaitɨya 'arike hetsiena kemɨtiyɨnikekai.","poem":2},{"text":"Kemɨratiwe pɨkatimaritɨa,","poem":1},{"text":"kaniumawekaitɨni kemɨ'ane 'inɨtɨani.","poem":2},{"text":"«Yawé, keneneuxeiya kenemɨtiuka'eniwa.","poem":1},{"text":"Pɨnetsi'a'iwaxɨ mɨnetsi'aye'unie».","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Meye'unie naime pɨtiyukapiinitɨa","poem":1},{"text":"naime mɨraye'atɨka Kerutsareme mɨrexeiyakai,","poem":2},{"text":"meta mɨkɨ puwaruxei tukita kepauka memeutahaxɨa","poem":1},{"text":"hipatɨ teɨteri Kakaɨyari memɨka'ayexeiya,","poem":2},{"text":"'ekɨ pemɨkawapitɨakai,","poem":1},{"text":"muwa 'ateɨterima memɨwayutixexeɨriwatsie memeutahakeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yunaitɨ teɨterimama mekaniutitsuanani,","poem":1},{"text":"meta mekaniku'uwani 'ikwai meheuwautɨkaitɨ,","poem":2},{"text":"yupiinite mɨraye'atɨkakɨ mekatenipatani 'ikwaikɨ","poem":1},{"text":"memayeyuyurinikɨ 'akuxi.","poem":2},{"text":"«Yawé, neuxei keneu'a'ɨwiya","poem":1},{"text":"kehepaɨ memɨnetenanaima».","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Xeme huyeta xemuyekɨka, xekeneuyu'ɨwiya:","poem":1},{"text":"¿Kamɨtsɨ xekateyu'iyaritua nehetsiemieme?","poem":2},{"text":"¿Hakewa xewitɨ nehepaɨ 'aneme 'uximatɨarika pexeiya,","poem":1},{"text":"Yawé 'uximatɨarika mɨnetsiyetuiri hepaɨ 'anekame?","poem":2},{"text":"Yawé kepauka muyeha'a nehamatɨa,","poem":1},{"text":"'ikɨ 'uximatɨarika kaneyenɨ'ani nehetsiemieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"»Muyuawitsie Yawé tai kaneyenɨ'ani,","poem":1},{"text":"mɨkɨ ne'umeyari 'ɨarime kaniutitaiya.","poem":2},{"text":"Winiyari kaniukeni nehɨxie,","poem":1},{"text":"hikɨ mɨpaɨ kanetiniukunuitɨani.","poem":2},{"text":"Kaneniuku'eirieni yuheyemekɨ,","poem":1},{"text":"tukarikɨ yanekatineumɨmɨkɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"»'Axakenemutiuyuri pahete nehetsie yuku hepaɨ,","poem":1},{"text":"Kakaɨyari katiniuyurieni mɨnetsi'utitɨtɨa.","poem":2},{"text":"Nekɨipitɨa kanenakatɨtɨani,","poem":1},{"text":"'ariri kɨmana nekani'uxeni.","poem":2},{"text":"Kaneniyetuani 'iya teɨteri wahetsɨa","poem":1},{"text":"kemɨ'ane nemɨkawakema nemɨwatanewieni wahetsɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"»Nekiekaritsie Yawé nekuyaxima","poem":1},{"text":"yunaime pɨkawaruparewi,","poem":2},{"text":"hipame pɨta kuyaxi kaniwarukuxeɨrieni memɨnetsitamienikɨ,","poem":1},{"text":"meta netɨɨriyama memɨwarakuxɨtɨanikɨ.","poem":2},{"text":"Yawé kanitapɨna yukiekari minaki'erie 'ɨimari Kura niweya,","poem":1},{"text":"kaxie kemɨtipɨnarɨwa winu mayanikɨ hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"»'Ikɨ naitɨ pɨnetsitsuaritɨa,","poem":1},{"text":"hiwerikakɨ nepɨkaheuniereri.","poem":2},{"text":"Xewitɨ 'ahurawa pɨka'uyeika mɨnetsinɨtɨanikɨ,","poem":1},{"text":"meta mɨnetsituikakɨ.","poem":2},{"text":"Neniwema mekaneutaxɨriexɨani","poem":1},{"text":"mɨtatsi'aye'unie mɨtatsi'a'iwaxɨkɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Tsiyuni pahiwa parewiya ha'iwawatɨ,","poem":1},{"text":"peru pumawe xewitɨ minɨtɨanikɨ.","poem":2},{"text":"Yawé mɨpaɨ tiuta'aitaku","poem":1},{"text":"Kakuwu 'aurie mematetɨkatei hikɨ mepeye'unie,","poem":2},{"text":"hikɨ Kerutsareme kanihɨkɨtɨni","poem":1},{"text":"xatsi xeikɨa meta mɨka'itiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«Yawé heitserie kanexeiyani,","poem":1},{"text":"peru ne 'aitsikateyatsie yanepɨkatikatɨa.","poem":2},{"text":"Xekeneu'enana, xeme hikɨ teɨteri,","poem":1},{"text":"kenemɨtiuka'eniwa xekeneuyu'ɨwiya.","poem":2},{"text":"Mekanehapanieni 'ateewa paitɨ","poem":1},{"text":"nehetsɨa miemete temari meta 'ɨimarixi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"»Meripaitɨ nemɨwanaki'eriekai nekaniwarutahɨawe,","poem":1},{"text":"peru mɨkɨ mekaneniuku'eirieni.","poem":2},{"text":"Mawari wewiwamete meta 'ukirawetsixi nehetsɨa miemete","poem":1},{"text":"yunaitɨ kiekaritsie mekaniukwini,","poem":2},{"text":"'ikwai mekuwautɨwetɨ,","poem":1},{"text":"'akuxi memayeyuyurinikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"»Yawé, keneneuxeiya nepɨtiuka'eniwa.","poem":1},{"text":"'Ari nepi'enie nepɨmɨxime.","poem":2},{"text":"Ne'iyari pɨkayumaiwe,","poem":1},{"text":"kwinimieme nemɨkaheu'enakaikɨ.","poem":2},{"text":"Netɨɨriyama mekaniukwi'iwa takwa,","poem":1},{"text":"'upaitɨta mɨɨya xeikɨa kanixuaweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"»Teɨteri netsuari mekani'enieka,","poem":1},{"text":"xewitɨ kaniumaweni mɨnetsinɨtɨani.","poem":2},{"text":"Yunaitɨ memɨnetsi'aye'unie mekatenimaika kenemɨtiuka'eniwa,","poem":1},{"text":"mekaniyutemamawieka nehetsie kepemɨtiuyurikɨ.","poem":2},{"text":"'Ari kenanɨ'a 'uximatɨarika kepemutayɨ,","poem":1},{"text":"mɨkɨta mɨpaɨ memɨte'uka'eniwanikɨ ne kenemɨtiuka'eniwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"»'Ahetsɨa paitɨ keheye'ani","poem":1},{"text":"tita ke'axamemɨte'uyuri.","poem":2},{"text":"Kepemɨnetiupitɨa 'uximatɨarika ke'axanemɨtiuyurikɨ,","poem":1},{"text":"mɨkɨta mɨpaɨ ketiniwarupitɨa.","poem":2},{"text":"'Ari pɨmɨire kenemɨtiutatsuaka,","poem":1},{"text":"meta ne'iyari 'ari pɨkɨmɨmɨkɨ».","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}