{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"LAM","translationId":"hch_wb2","name":"Hiwerika","commonName":"Hiwerika","title":"Hiwerika kwikariyari","order":25,"numberOfChapters":5,"sha256":"189e3bd57feb4cea3bccd7fe00b17b66b01391b22ae30e6d91a101faed00d88b","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/hch_wb2/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Xɨa'ui, Tsiyuni niweya witsimɨti'ɨimarikai Yawé 'akɨyɨwime kanayeitɨani","poem":1},{"text":"yuhaxɨa kwauniyarikɨ.","poem":2},{"text":"Muyuawitsie paitɨ kwiepa kamenakahɨani, haweri pe'anekame","poem":1},{"text":"kamenayeitɨani kepemɨtimariwekai 'Ixaheri.","poem":2},{"text":"Kepauka mɨmetsi'uka'unaxɨ ha'atɨ katinatɨmaiya","poem":1},{"text":"kemɨti'aitakai 'ena kwiepa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yawé pɨtiuka'unaxɨa katinenimayatɨ","poem":1},{"text":"naime 'ixaheritsixi wakii,","poem":2},{"text":"meta ha'atɨ kanika'una","poem":1},{"text":"Kura witsimɨti'ɨimari hakewa meyutɨrɨkariyakai,","poem":2},{"text":"meta tixaɨtɨ pɨkarayeitɨa","poem":1},{"text":"mana ti'aitame meta 'iparewiwamete kaniwarukwini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yemekɨ Kakaɨyari waɨkawa kaniuyeha'ani,","poem":1},{"text":"naime 'Ixaheri tɨrɨkariyaya kanakuyeitɨani.","poem":2},{"text":"Mɨtatsi'aye'unie kaninuani tahetsɨa,","poem":1},{"text":"hikɨ 'ana Yawé pɨkatatsi'uparewi.","poem":2},{"text":"Kakuwu hetsie tai manutatani hepaɨ 'anetɨ,","poem":1},{"text":"watixɨtsitɨaximetɨ yunaime 'auriena mematetɨka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mɨtatsi'aye'unie hepaɨ, yutupi kaniukuha'aritɨani,","poem":1},{"text":"yutseriekɨ pekwekai.","poem":2},{"text":"Mɨtatsi'aye'unie hepaɨ, kaniwarukwini","poem":1},{"text":"nehetsɨa miemete temuwanaki'erie.","poem":2},{"text":"Yuhaxɨa tai hepaɨ 'aneme kaniukawiwieni","poem":1},{"text":"Tsiyuni witsimɨti'ɨimari 'ixuriki kiiya hetsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yawé mɨtatsi'aye'unie hepaɨ pɨtiyurie:","poem":1},{"text":"'Ixaheri kaniuka'una.","poem":2},{"text":"Naime paratsiyuya kaniuka'una","poem":1},{"text":"meta hakewa meyutɨrɨkariyakai.","poem":2},{"text":"Putimɨiriyaxɨ tahiwerika meta ta'ukai,","poem":1},{"text":"Kura witsimɨraku'ane hetsiemieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Xewitɨ xamaru makumaweriya hepaɨ,","poem":1},{"text":"mɨpaɨ yutuki katiniuka'una.","poem":2},{"text":"Yawé Tsiyuni pɨratɨmaiyatsitɨa","poem":1},{"text":"xawati mɨka'utiwewiwanikɨ meta patsiekamekɨ kememɨteyukuxexeɨriwa 'ixɨarariyari,","poem":2},{"text":"ti'aitame hepaɨtsita puyeha'a","poem":1},{"text":"meta puwaruhayewaxɨ mawari wewiwamete hetsɨana memɨmiemetetɨkai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yawé yumawari taiyame puka'utanaki'eri,","poem":1},{"text":"muyepatsie kaniuku'eirieni.","poem":2},{"text":"Kaniyetuani memɨtatsi'aye'unie wahetsɨa","poem":1},{"text":"kuraru paratsiyu mukunakai.","poem":2},{"text":"Yawé tukita meputihiwa","poem":1},{"text":"'ixɨarari mɨwewiyaka hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yawé puyuwaɨri mika'unakɨ","poem":1},{"text":"kuraru 'amatayewa Tsiyuni witsimɨti'ɨimari warie maka.","poem":2},{"text":"Kɨye 'utikweka kani'inɨata,","poem":1},{"text":"hikɨ kanika'una ka'inenimayatɨ.","poem":2},{"text":"Hiwerika putixuawerixɨ tetsariya 'imɨmɨiyarite mɨranutikɨkatɨre meta kurarute 'amatitetewa wahetsiemieme,","poem":1},{"text":"mɨkɨ naitɨ kaniuka'unarieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"'Ituparite kaneuxɨriexɨani kwiepa kaniyuhayewa,","poem":1},{"text":"kaneimuraxɨani 'ituparite warita mauku'uwe.","poem":2},{"text":"Ti'aitame meta 'iparewiwamete","poem":1},{"text":"mekane'uwani hipame nuiwarite watsata,","poem":2},{"text":"'inɨari niukiyari pɨkakuxaxatsiwari meta Kakaɨyari niukametemama mepɨka'u'uwari,","poem":1},{"text":"Yawé pɨkatiwaxeitsitɨari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tsiyuni witsimɨraku'anekaitsie, mana 'ukirawetsixi","poem":1},{"text":"kwiepa mepeutitei kayuwatɨ xeikɨa,","poem":2},{"text":"yumu'utsie naxi meheutiwiwatɨ","poem":1},{"text":"meta hiwerika kamixayari me'anakatɨtɨkaitɨ.","poem":2},{"text":"Kerutsaremetari 'ɨimarixi","poem":1},{"text":"mekaneutiteni kwiepa me'akatututsitɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Tsuarikɨ nehɨxite pɨtixɨxime,","poem":1},{"text":"'ariri kakwaniwemekɨ nepeɨmɨmɨkɨ.","poem":2},{"text":"Yemekɨ ne'iyarikɨ nepɨkaheuwaɨre","poem":1},{"text":"nekiekari muka'unariekɨ.","poem":2},{"text":"Tɨɨritɨtɨ yakɨ memɨyumate mekanitiweranareni,","poem":1},{"text":"'ikɨ kiekari kayeyarite 'utɨma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tɨɨri yumaamama mɨpaɨ metewaku'iwawiyatɨ:","poem":1},{"text":"«¿Hakewa pexuawe 'ikwai meta winu?»,","poem":2},{"text":"'anari mepatixɨrɨwe kaye'utɨma","poem":1},{"text":"mekwikwi'itɨ memɨte'uhipite hepaɨ,","poem":2},{"text":"meta memɨtsitsewe wamaamama mewareukɨ'ɨkaku","poem":1},{"text":"'imatɨrieka mepuka'ietɨkɨka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"¿Kehepaɨ netayɨni 'ahetsiemieme, Kerutsareme witsipemɨti'ɨimari?","poem":1},{"text":"¿Kemɨ'ane hepaɨ pepɨ'ane?","poem":2},{"text":"¿Ketita 'inɨariyarikɨ nemetitahɨawe nemɨmatsinɨtɨanikɨ,","poem":1},{"text":"kiekari Tsiyuni 'ɨimari?","poem":2},{"text":"Haramara kemeukatewa hepaɨ pɨ'ane 'akwinitɨarika.","poem":1},{"text":"¿Kemɨ'ane 'aku pɨyɨwe mɨmatsi'u'uayemani?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kakaɨyari niukametemama 'ahetsɨa miemete mepɨmate'utaxatɨa","poem":1},{"text":"'itarikakɨ kename kehapaɨ mete'unenierixɨ.","poem":2},{"text":"Mepɨkamatsi'utahekɨataxɨ ke'axapemɨtiyurienekai,","poem":1},{"text":"'ateɨterima kememɨte'anuhapanienikekai mepɨka'itaxataxɨ.","poem":2},{"text":"Niuki memɨmatsikuxaxatɨwakai","poem":1},{"text":"'itarika xeikɨa pɨhɨkɨtɨkai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Keyupaɨmetɨ mana huyeta memuyekɨka","poem":1},{"text":"mematsixeiyatɨ mekameninanaimaka mekateniutapineni.","poem":2},{"text":"'Ahetsiemieme Kerutsareme witsipemɨ'anekai, nanaimarika mepɨwewie,","poem":1},{"text":"meta me'utiwikɨayatɨ mɨpaɨ mepɨte'u'iwawa:","poem":2},{"text":"«¿'Ikɨ xeniu tihɨkɨ kiekari witsimɨ'ane?","poem":1},{"text":"¿'Ikɨ xeniu kiekari waɨkawa temawierika mexeiya tihɨkɨ yunaime muwara'iwa?»","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Yunaitɨ memɨmetsi'aye'unie meputiniuka","poem":1},{"text":"'axametekuxatatɨ 'ahepaɨtsita,","poem":2},{"text":"yutamete me'utixikauteketɨ, mematsinanaimatɨ mɨpaɨ meputiyuane:","poem":1},{"text":"«'Ayeniereme tekaniutakwani.","poem":2},{"text":"Tukari paye'a temikwewiekai,","poem":1},{"text":"hikɨri 'ari tahɨxikɨ tepixei».","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Yawé kaneye'atɨani kemɨtiku'eriwakai,","poem":1},{"text":"kaneye'atɨani yuniuki,","poem":2},{"lineBreak":true},{"text":"meripaitɨ kemutayɨkai.","poem":2},{"text":"Kametsinenimayatɨ kwiepa kamenehɨani,","poem":1},{"text":"katiniupitɨani mɨmatsi'aye'unie mɨmatsitananaimanikɨ,","poem":2},{"lineBreak":true},{"text":"mɨkɨ pɨtata watɨrɨkariya mariweme kanayeitɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Teɨteri wa'iyari","poem":1},{"text":"Yawé mekanihiwieka mete'uka'eniwatɨ.","poem":2},{"text":"Tsiyuni witsipemɨ'ane 'akuraru 'amatitɨtɨ,","poem":1},{"text":"tukarikɨ tɨkarikɨ keneuhayewa","poem":2},{"lineBreak":true},{"text":"tsepa 'a'ukai muhanenikɨ haa hepaɨ.","poem":2},{"text":"Hawaikɨ 'etsiwa pepɨka'uxipieka.","poem":1},{"text":"'A'ukai pepɨkaheununuitɨwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kenanukukeka keneutahiwani tɨkarikɨ,","poem":1},{"text":"kepauka tɨkarikɨ tehɨwemete memitsutɨanitsie.","poem":2},{"text":"Keneu'eiri 'a'iyari 'ukaiya","poem":1},{"text":"mawari kenayeitɨa Yawé hɨxie.","poem":2},{"text":"Keneyunenewieka Kakaɨyari hetsɨa kenewauka teikɨ pehemetɨ","poem":1},{"text":"'atɨɨriyama watukari hetsiemieme,","poem":2},{"text":"haakakɨ memɨkwixime","poem":1},{"text":"kaye'utɨma memeutihe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«Neuxei Yawé, keneu'ati'iyaritɨa:","poem":1},{"text":"¿Kemɨ'aneri mɨpaɨ pepɨtiukwinitɨa meripaitɨ?","poem":2},{"text":"¿Kamɨtsɨ 'ukarawetsixi yuniwema metewatikwani","poem":1},{"text":"yuhetsie memɨwarayexei?","poem":2},{"text":"¿Metekwi'iwa tsɨkamɨ mawari wewiwamete meta 'ahetsiemiemete niukamete","poem":1},{"text":"Yawé 'atuki muyepatsietsie?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"»'Ukirawetsixi meta temari yunaitɨ","poem":1},{"text":"kaye'utɨma tumuanaritsata mekanitiheni,","poem":2},{"text":"temari meta 'ɨimarixi nehetsɨa miemete","poem":1},{"text":"'ixiparakɨ mekaniukwi'iwa.","poem":2},{"text":"Peha'atɨ watukari pekaniwarunawairieni,","poem":1},{"text":"pekaniwarukwini pekawanenimayatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"»'Ixɨararipa pemɨta'inieni hepaɨ,","poem":1},{"text":"kenemɨtika'unarienikɨ naitsarie pekatiniutanɨ'axɨani.","poem":2},{"text":"Kepauka Yawé pemuyeha'a","poem":1},{"text":"nixewitɨ pɨkayɨwekai muyuta'una, meta nixewitɨ pɨka'uyuhayewaxɨ 'ayenieretɨ.","poem":2},{"text":"Kemɨ'ane waɨkawa nemɨwanaki'eriekai meta nemɨtiwaruti'ɨkitɨa,","poem":1},{"text":"mɨkɨ yunaime mɨtatsi'aye'unie kaniwarukwini».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}