{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"LAM","translationId":"hch_wb2","name":"Hiwerika","commonName":"Hiwerika","title":"Hiwerika kwikariyari","order":25,"numberOfChapters":5,"sha256":"189e3bd57feb4cea3bccd7fe00b17b66b01391b22ae30e6d91a101faed00d88b","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/hch_wb2/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Ne nekanihɨkɨtɨni nemɨtiuka'eniexɨa 'uximatɨarikakɨ","poem":1},{"text":"Kakaɨyari 'uyeha'aka yukɨyekɨ pɨnetsi'uwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kaneniupitɨani yɨwipa nemuyeikanikɨ,","poem":1},{"text":"hekɨariyatsie pɨkanetsi'upitɨari.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yakanetini'uximatɨaka,","poem":1},{"text":"heiwatɨma xeitukari pɨka'anukayeika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Newaiyari meta nenawiyaritsie pɨnetsi'utawatsiɨxaxɨ,","poem":1},{"text":"ne'umeyari pakamuraxɨa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Pɨnetsi'ukurarutɨiyaxɨ","poem":1},{"text":"'axamɨti'anekɨ meta nemɨtiuka'eniwanikɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Waɨriyarika kaneninɨ'aka yɨwipa xeikɨari nemuyeikanikɨ,","poem":1},{"text":"meripaitɨri memukwi wahepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"'Ukaneniyenaka, nepɨkayɨwe nemɨyuta'una,","poem":1},{"text":"tepɨa kaunariyarikɨ mahetekɨ kaneniuhɨani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tsepa karima nemutahiwa tsepa parewiya nemɨwawa,","poem":1},{"text":"mɨkɨ nenenewieri pɨka'enimɨkɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nehuyeta tetexi puyatsaxɨ,","poem":1},{"text":"meta nehuye waɨkawa pekutunaxɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kakaɨyari pɨnetsi'awiexeiyane hutse mɨtihupie hepaɨ,","poem":1},{"text":"meta maye hepaɨ pɨnetsihupie.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Huyeta kanenanayehanani mɨnetsititsanaxɨanikɨ,","poem":1},{"text":"haweri ne 'anekame mɨnetsihayewakɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yutupi 'ukuha'aritɨaka,","poem":1},{"text":"kanenimɨneni xeikɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ne'iyaritsie kaneniutamɨni","poem":1},{"text":"yu'ɨrɨtekɨ metɨkɨta miemetekɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ne, 'atsieriwame xeikɨari nekanihɨkɨtɨni yunaime teɨteri wahɨxie,","poem":1},{"text":"tukarikɨ nehɨxie mekaniutikwikani menetsinanaimatɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hatsiwimekɨ xeikɨa kaneniutahɨniya,","poem":1},{"text":"meta kaneniu'itɨani tsiɨrika hepaɨ ratsiwime.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Netsi'uwiyaka kwiepa katiniukatuaxixɨani nekɨmana,","poem":1},{"text":"tumuanari nemɨtikwanikɨ kaneniupitɨani.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Pɨnetsi'unawairi kayuwatɨ kenemɨrexeiyakai,","poem":1},{"text":"'aixɨa 'iyari 'uyeikatɨ kemɨreu'erieka nepɨka'imateri.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hikɨ mɨpaɨ nekaniutaineni: «Netukari pɨtixɨxime,","poem":1},{"text":"meta neta'ikwewatɨ Yawé hetsiemieme».","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kena'eriwani kuyeikame nemɨhɨkɨ netiuka'eniwatɨ,","poem":1},{"text":"ratsiwimekɨ nemɨmɨximekɨ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mɨpaɨ tsiere nepɨtiku'eriwa,","poem":1},{"text":"'ayumieme mɨkɨkɨ nepaunutuixie ne'iyaritsie.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Peru 'akuxi tawarita mɨpaɨ nepɨtiku'eriwa,","poem":1},{"text":"mɨkɨ waɨkawa neta'ikwewame pɨnetsihayeitɨwa:","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Yawé naki'eriyaya mɨmariwe hatsuaku pɨkakumawere,","poem":1},{"text":"meta kemɨtiyukanenimaya hatsuaku pɨkaxɨni.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Xexuime ximeriyaritsie pihekwariya kemɨtiyukanaki'erie,","poem":1},{"text":"pɨmariwe ke'aixɨa mɨtiuka'iyari.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"'Ayumieme 'imatɨrieka, mɨpaɨ neputaine:","poem":1},{"text":"«Yawé xeikɨa kanihɨkɨtɨni tita nemɨrexeiya.","poem":2},{"lineBreak":true},{"text":"'Ayumieme hetsiena xeikɨa netiwiyatɨ nepɨta'ikwewani».","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Yawé 'aixɨa katiniuka'iyarini kemɨ'ane yuri memɨte'erie hetsiena wahetsie,","poem":1},{"text":"meta kemɨ'ane memikuwautɨwe wahetsiemieme.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"'Aixɨa kani'aneni kayuwatɨ 'umatɨ mitakwewieka,","poem":1},{"text":"Yawé mayenenikɨ tatsitawikweitsitɨanike.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"'Aixɨa pɨ'ane xɨka tewi retimani","poem":1},{"text":"yuku mɨtitɨnikɨ temaikɨyari hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Xekeneuhayewa yuxaɨtame xeikɨa muyuhayewanikɨ,","poem":1},{"text":"mɨpaɨtsɨ Yawé katinipitɨani.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Tumuanaripa yɨhɨxima keheuhakeni.","poem":1},{"text":"Heiwatɨ 'akuxi 'uparewiyani.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Tawarita ta'aurie kehaweni tapata yu'auritapa mɨtikwinitɨarienikɨ,","poem":1},{"text":"para mɨpaɨ 'axa'itɨarietɨ muyuhayewanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Yawé katanexɨrieni,","poem":1},{"text":"peru yuheyemekɨ pɨkatatsihexɨrieni.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Waɨkawa temɨte'uka'eniwanikɨ pɨtatsipitɨa, peru pɨtatsitinenimayata,","poem":1},{"text":"naki'eriyaya mɨmariwekɨ.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ti'aitame pɨtatikwinitɨa meta pɨtatsihiweritɨa","poem":1},{"text":"peru mɨpaɨ mɨtinakekɨ pɨkatiyuriene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Kepauka memɨtiketsinarɨwa","poem":1},{"text":"yunaitɨ pɨretsutsixi kwiepa memɨtama,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"kepauka 'Amutewi hɨxie","poem":1},{"text":"tewi heitserie kemɨrexeiya mɨpaɨ mɨkatipitɨarie,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"kepauka heitseriemekɨ mɨkaparewiya,","poem":1},{"text":"¿Yawé tamɨ mɨpaɨ karetimamateke?","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"¿Kemɨ'ane pɨyɨwe tixaɨtɨ hepaɨtsita mɨtiutaxata 'ariketa hekɨatsime mayeitɨani","poem":1},{"text":"Yawé mɨpaɨ kahainekaku?","poem":2}]},{"type":"verse","number":38,"content":[{"text":"¿Tamɨ Kakaɨyari xeikɨa yahainekaku yakatikuyɨne,","poem":1},{"text":"mɨtiutixuxuawere 'axati'anetɨ meta 'aixɨati'anetɨ?","poem":2}]},{"type":"verse","number":39,"content":[{"text":"¿Titayari 'ayeyuritɨ 'axaraineni","poem":1},{"text":"kemɨ'ane 'axatiuyurieyu mɨtiukwinitɨarienitsie?","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Neuxei hikɨmɨ tepɨtatimaixɨani yateteku'eriwatɨ","poem":1},{"text":"hikɨ 'ana tepɨ'axɨani Yawé huyeya 'utɨa.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Tekaninɨawakakuni Kakaɨyari muyuawitsie makawe","poem":1},{"text":"ta'iyarikɨ meta tamamatekɨ.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"'Axatepɨte'uyuri, temɨkaheu'enana tepɨhɨkɨ,","poem":1},{"text":"'ekɨta pepɨka'awaɨriya pemɨtareuyehɨwirienikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Waɨkawa peha'atɨ pekataniuweiyani,","poem":1},{"text":"pekatanikwika pekatatsinenimayatɨ.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Haiwitɨritsata pepɨ'ati'awiwieta","poem":1},{"text":"tanenewieri pemɨka'eniekakɨ.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Tepɨa temɨxikiyari mɨkaheuyewetse hepaɨ,","poem":1},{"text":"pekataneutaxɨriexɨani nuiwarite watsata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"Yunaitɨ memɨtatsi'aye'unie meputiniuka","poem":1},{"text":"tahetsiemieme xeikɨa 'axamepɨtekuxata.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"'Ari tepatixɨriya tete'uka'eniwatɨ temariutsietɨ,","poem":1},{"text":"kepauka takiekari muta'unarie.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Haa muhane hepaɨ pɨyɨne ne'ukai ne'auritsie,","poem":1},{"text":"neteɨterima wakiekari mɨmariwe muka'unariekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"Nehɨxite xɨari pɨkayunixɨani 'ukaikɨ,","poem":1},{"text":"katihayewatɨ meta xewitɨ ka'inɨtɨakaku,","poem":2}]},{"type":"verse","number":50,"content":[{"text":"kepaukake muyuawitsie paitɨ","poem":1},{"text":"Yawé mɨtatsihaye'erieni mɨtatsixeiya.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Pɨnetsihekukukuine yemekɨ ne'iyari taɨta paitɨ,","poem":1},{"text":"newaxeiyatɨ 'ukarawetsixi mete'uka'eniwame nekiekaritsie kiekatari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Memɨnetsi'aye'unie mekaneniuweiyani nitixaɨtɨ mekatehayexeiyatɨ nehamatɨa,","poem":1},{"text":"wiki hepaɨ mekaneniwiniyatɨweni.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Ne'ayeniereme mekaneniteukikuni","poem":1},{"text":"tetexikɨ menetsiheukananike newatiyanikɨ.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"Haa nemu'utsie paitɨri kaniuku'atɨkani,","poem":1},{"text":"'ari mɨpaɨ katinimatsiɨkɨni netukari kaniutixɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":55,"content":[{"text":"Hikɨ meukatewatsie mɨki teukiyata","poem":1},{"text":"nekameniutahɨawe, parewiya Yawé nekameniutawawirieni,","poem":2}]},{"type":"verse","number":56,"content":[{"text":"'ekɨta pepɨnetsi'u'eni kenemɨmatiwawiriekai yemekɨ,","poem":1},{"text":"hawaikɨ pepɨkaheikanaxɨa 'a'enakareme ne kenemutainekai karima.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Ne nepɨmatsi'utahɨawixɨ, hikɨ 'ekɨ nehetsɨa pepunua,","poem":1},{"text":"mɨpaɨ pepɨnetiutahɨawixɨ: «Pepɨkamaka».","poem":2}]},{"type":"line_break"},{"type":"verse","number":58,"content":[{"text":"Yawé, 'ekɨ nehetsie peputanua","poem":1},{"text":"'ana netukari peputawikweitsitɨa.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Yawé, 'ekɨ pepunierixɨ ke'aixɨa nemɨkatixeiyariekai,","poem":1},{"text":"nehetsiemieme kemɨtiheitserie 'aixɨa ketineuyuri.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"'Ekɨ pepuwaruxei kwinimieme kemenete'aye'unietɨ memɨnetsi'uyuri","poem":1},{"text":"meta pepɨtimaikai kememɨteku'eriwakai nehetsiemieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":61,"content":[{"text":"Yawé, 'ekɨ pepɨwaru'eni ke'axamemɨtate'utahɨawixɨ","poem":1},{"text":"meta naime kememɨteku'eriwakai nehetsiemieme,","poem":2}]},{"type":"verse","number":62,"content":[{"text":"'ekɨ pepɨtimate tukarikɨ memɨnetsi'aye'unie","poem":1},{"text":"mepɨnetsikuxata kememɨteyurieni nehetsiemieme.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Keniwaruxeiya. Tsepa kememɨteyurie","poem":1},{"text":"mekaneninanaimaka me'utikwitɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":64,"content":[{"text":"Yawé, yaketiniwarakapitɨa,","poem":1},{"text":"naime kememɨte'uyurikɨ.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"Mekatemaiwaweme keniwarayeitɨa,","poem":1},{"text":"'axamɨti'ane wahetsie ketiunake.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Yawé, keniwaranukuweiya peha'atɨ,","poem":1},{"text":"'ena kwiepa keniwarakumaweriya.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}