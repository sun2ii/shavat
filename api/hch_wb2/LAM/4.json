{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"LAM","translationId":"hch_wb2","name":"Hiwerika","commonName":"Hiwerika","title":"Hiwerika kwikariyari","order":25,"numberOfChapters":5,"sha256":"189e3bd57feb4cea3bccd7fe00b17b66b01391b22ae30e6d91a101faed00d88b","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/hch_wb2/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Huru 'ari pɨka'utixawatɨre.","poem":1},{"text":"Huru 'aixɨamɨ'ane putayɨrixɨ puyutakwitama.","poem":2},{"text":"Tetexi mɨpatsietɨka kwinimieme mɨraye'atɨka tukita timieme kaye'utɨma katineutiteni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Tsiyuni kiekatari,","poem":1},{"text":"meripaitɨ mepɨtehaye'akai huru kemɨraye'axe,","poem":2},{"text":"hikɨri haxu xariteyari hepaɨ mepɨtexeiyarie,","poem":1},{"text":"'iwewame nenikamɨti'ane mitiwewi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yeutari memayu'eririya yutsitsi mepɨyexata","poem":1},{"text":"yuniwema mepɨwatsitsitɨa,","poem":2},{"text":"peru 'ukari Kerutsaremetari mepɨka'u'iyari.","poem":1},{"text":"Yuniwema mepɨwata'e'eiriwa 'aruxi 'amemɨnene makumawetsie memu'uwa wahepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tɨɨri yemekɨ waɨkawamekɨ mepeuhariku,","poem":1},{"text":"waneni 'ari puwawaki.","poem":2},{"text":"Paa tɨɨri mekaniku'iwawani,","poem":1},{"text":"peru neuxei nixewitɨ pɨkawamimɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kemɨ'ane meripaitɨ memɨte'utikwa'akai witsiti'anekame","poem":1},{"text":"hikɨ mekanikwiximeni haakakɨ kaye'utɨma.","poem":2},{"text":"Meripaitɨ witsimemɨte'ukemarikai mɨyɨtsikimaɨyekɨ","poem":1},{"text":"hikɨ xatsitsata mekanikurupetɨweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ke'axamemɨte'uyuri Tsurumatari","poem":1},{"text":"matsi kwinimieme 'axamepɨte'uyuri Kerutsareme kiekatari,","poem":2},{"text":"yapauka kaniuka'unarieni,","poem":1},{"text":"nixewitɨ pɨka'iparewi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kwinimieme matsi mepɨtetuxakai mana te'aitamete 'ɨwi hepaɨ,","poem":1},{"text":"meta retsi hepaɨ,","poem":2},{"text":"wawaiyari yemekɨ pɨtataɨrawikai,","poem":1},{"text":"Tete mɨraye'axe mutimerɨka hepaɨ mepɨteyuxexeiyakai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Peru hikɨ kwinimieme mepɨteheutɨtɨni keyuri yɨxari,","poem":1},{"text":"nixewitɨ pɨkawamate kaye'utɨa.","poem":2},{"text":"Yuwaiyaritsie kwinimieme mekateniwawakini kɨye hepaɨ,","poem":1},{"text":"wa'umeyaritetsie kaniuwerixɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"'Aixɨa mekani'itɨarieka kemɨ'ane memukwi'iwaxɨ 'ixiparakɨ,","poem":1},{"text":"keyuri haakakɨ memukwi.","poem":2},{"text":"Haaka wara'iwakaku mekanitakukuweni,","poem":1},{"text":"karikɨ mɨtiumawekɨ 'ikwaxite 'ɨtsita timieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"'Ukarawetsixi 'aixɨa memɨte'u'iyarikai, yumamá mekaniuhɨniri","poem":1},{"text":"yuniwematɨme mekaniwaruka'etsa.","poem":2},{"text":"Yuniwema wahekɨ mekatenikwakaitɨni,","poem":1},{"text":"kepauka Kerutsareme muka'unarietsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yawé yuhaxɨa kaniutatuani,","poem":1},{"text":"yuhaxɨa mɨtiyukukuine kananayetuani.","poem":2},{"text":"Tsiyuni taikɨ kaniutataiya","poem":1},{"text":"meta kanitaxɨtsitɨani tsutɨmeyari naime.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mɨpaɨ mepɨkateha'eriwakai naitsarie te'aitamete,","poem":1},{"text":"meta yunaitɨ teɨteri naitsarie kiekatari,","poem":2},{"text":"kename Kerutsareme memaye'unie","poem":1},{"text":"kiteniena meheutahaxɨanikekai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Peru mɨpaɨ katiniɨyɨni.","poem":1},{"text":"Kakaɨyari niukametemama 'axamete'uyurieku.","poem":2},{"lineBreak":true},{"text":"Mawari wewiwamete 'axamete'uyurieku.","poem":2},{"text":"Teɨteri 'axamekateyuriekame memɨwarukwikɨ","poem":1},{"text":"kiekaritsie kaye'utɨma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Yumamatetsie meheuxuxuretɨ,","poem":1},{"text":"kaye 'utɨma mekaniu'uwani memɨkaheuneniere wahepaɨ meyɨatɨ.","poem":2},{"text":"Xewitɨtɨma pɨkayuwaɨriya muwamayɨanikɨ","poem":1},{"text":"tsikeretɨma wa'ixurikitsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Teɨteri mɨpaɨ mekateniwaruhiwiwani: «'Ena xepɨka'u'uwani, xemɨka'itiya.","poem":1},{"text":"Xekeneuhuni. Xekeneuhuni. Xepɨkatatsikumaɨwani tame».","poem":2},{"text":"Hipame nuiwarite watsata mɨpaɨ mekatenikɨhɨawarɨwani:","poem":1},{"text":"«Ku'uwamete mekanihɨkɨtɨni, memuyu'unaxɨaxime.","poem":2},{"lineBreak":true},{"text":"Mepɨkayɨwawe 'ena memu'uwani yuheyemekɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Yawé tɨtɨ katiniuyurieni muwareutaxɨriexɨa,","poem":1},{"text":"hikɨri pɨkayu'iyaritɨa wahetsiemieme.","poem":2},{"text":"Mawari wewiwamete mamariwawemete mepɨkaxatsiwa","poem":1},{"text":"meta 'ukirawetsixi mepɨkanenimayatsieri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"'Imatɨrieka, tahɨxite pɨtitɨximeri","poem":1},{"text":"teta'ikwewatɨ yakɨxeikɨa xewitɨ tatsiparewienike te'erietɨ.","poem":2},{"text":"Tuxiyutsie paitɨ tetanenieretɨ tekanita'ikwewani","poem":1},{"text":"hipatɨ teɨteri memɨtatsitawikweitsitɨanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"'Etsiwa temuku'uwatsie tepuhupierie,","poem":1},{"text":"kaye 'utɨma temɨye'uwani pɨkayɨweri.","poem":2},{"text":"Ta'imatɨrieka tukariyari kanehuraniri, 'ariri kanaye'ani,","poem":1},{"text":"tatukari naitɨ pɨ'inɨatsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Memɨtatsi'aye'unie matsi kwinimieme mepayɨwawekai","poem":1},{"text":"keyuri kwixɨtsi muyuawitsie miemete,","poem":2},{"text":"hɨritsie mepɨtatsi'uweiyatɨkɨkakai,","poem":1},{"text":"makumawetsieta mekataniuhupieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Meta kaniuwiyarieni ti'aitame Yawé menayexei,","poem":1},{"text":"mɨkɨ hetsie tetewiyatɨ temu'uwakai.","poem":2},{"text":"Mɨkɨ pɨhɨkɨtɨkai hetsiena mieme mɨpaɨ temutiyuanekai:","poem":1},{"text":"Mɨkɨ 'etɨriyayatɨa te'u'uwatɨ nuiwarite watsata tepu'uwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kene'atemawieka meta keneutanaweni, 'Erumi kiekariyari,","poem":1},{"text":"'Utsi kwieyaritsie, 'uka ti'aitame hepaɨ pemɨtika.","poem":2},{"text":"Peru 'arike 'ikɨ tekɨxita 'ekɨta pepanu'ieni,","poem":1},{"text":"hikɨ 'ana pepɨtitaweni meta pemawetɨ pepayani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Tsiyuni witsipemɨti'ɨimarikai, kanaye'atɨarieni kepemɨtikwinitɨarienikekai,","poem":1},{"text":"Kakaɨyari tawariri xeime kwieyaritsie pɨkamatsi'anɨnɨ'ani.","poem":2},{"text":"Peru 'ekɨ, mɨmariwe 'Erumi kiekariyari, kamani'uximatɨamɨkɨ ke'axapemɨtiuyurikɨ","poem":1},{"text":"meta naime ke'axapemɨtiuyuri katinitahekɨatamɨkɨ.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}