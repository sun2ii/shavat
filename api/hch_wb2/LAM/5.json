{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"LAM","translationId":"hch_wb2","name":"Hiwerika","commonName":"Hiwerika","title":"Hiwerika kwikariyari","order":25,"numberOfChapters":5,"sha256":"189e3bd57feb4cea3bccd7fe00b17b66b01391b22ae30e6d91a101faed00d88b","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/hch_wb2/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Yawé, kenaye'eri kemɨtatiuyuri,","poem":1},{"text":"ketemɨteyutewinɨa kenaye'eri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Takwie hipatɨ tiwapiini pɨratɨa,","poem":1},{"text":"meta takii, 'ateewa kiekatari wapiini katinayani.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tepɨkatehekapaapari, nutuite teputahayewaxɨ,","poem":1},{"text":"tamaamama wiuraxi mepuyuhayewaxɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Haa temɨhare, tekaninaneka xeikɨa,","poem":1},{"text":"kɨyexi, yaxeikɨa tekaninaneka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Memɨtatsi'uweiya takeputsatsie mekana'uweni,","poem":1},{"text":"tepu'u'uxe xeikɨa, temuka'uxipieni tepɨkayɨwawe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tɨratu tekaniuwewieni 'Ekipitu meta 'Atsiriya wahamatɨa,","poem":1},{"text":"mɨpaɨ 'ikwaite temɨtekaxeiyakɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tapaapama 'axameteyurietɨ mekaniukwini,","poem":1},{"text":"tame pɨta tekaniu'uximatɨarieni wahetsiemieme.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hikɨri waɨriyarika te'uximayatamete memɨhɨkɨtɨkai mɨkɨ mekatateni'aitɨaka,","poem":1},{"text":"xewitɨ kaniumaweni mɨtatsixɨnakɨ wahetsɨa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Makumawetsie makukweriwa'anetsie tekaniuyekɨkani,","poem":1},{"text":"tatukari tekanitatuaka ta'ikwai temukaxexeiyanikɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tanawiyari pɨtatsikutaiya huxunu mɨxɨka hepaɨ,","poem":1},{"text":"haakakɨ tekanihɨiyatɨkani.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tsiyuni kiekatari 'ukarawetsixi meta Kura kiekariyaritsie 'ɨimarixi","poem":1},{"text":"waɨriyarika mekaniutimayɨiyani.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ta'ukiyarima memanuyehaitɨtɨakai mekaniukawɨtɨarieni yumamatsie mehɨatɨkaitɨ,","poem":1},{"text":"meta tixaɨtɨ mepɨkatewarayeitɨa 'ukirawetsixi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Taniwema temari 'aixɨa memɨ'anene tɨxɨmete mepɨwarayeitɨa,","poem":1},{"text":"tɨɨri kɨyexi mahete me'ɨtɨtɨ mepekaxɨrɨwekai.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hawaikɨri 'ukirawetsixi","poem":1},{"text":"kiekari kitenie mepɨkatiyaxike,","poem":2},{"lineBreak":true},{"text":"hawaikɨri temari wakwikari tepɨka'enie.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Temawierika pɨkaxɨaweri ta'iyaritsie,","poem":1},{"text":"teye'amete watemawierika nutuixiya pɨta kanayani.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tamu'utsie kuruna tepɨka'anamanari.","poem":1},{"text":"Xɨa'ui tametsɨari: 'axatekateniuyurieni.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ta'iyarite pukwiximeri,","poem":1},{"text":"tahɨxite kanititɨximeni,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Karikɨ Tsiyuni hɨriyaritsie kanakukiɨriyaka,","poem":1},{"text":"mana xeikɨa yeutari mekaniu'uwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Yawé, peru 'ekɨ 'aheyemekɨ pekatini'aitametɨni,","poem":1},{"text":"'a'uweni yuheyemekɨ 'akaniuweni.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"¿Ketitayarikuta 'aheyemekɨ petaratɨtɨmaiya?","poem":1},{"text":"¿Ketitayarikuta mɨixa tukari petatiuku'eiri?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yawé, 'ekɨ ketaneupitɨa 'ahetsɨa temɨ'axɨanikɨ, hikɨ 'ana tame ta'aurie tepaxɨrieni.","poem":1},{"text":"Meripaitɨ ke'aixɨa temɨ'anekai mɨpaɨ ketatineupitɨa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yurikɨ, 'ekɨ pepɨtatsi'uku'eiri","poem":1},{"text":"waɨkawa yemekɨ pepɨha'a tahamatɨa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}