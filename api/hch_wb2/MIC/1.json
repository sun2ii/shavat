{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"MIC","translationId":"hch_wb2","name":"Mikeyaxi","commonName":"Mikeyaxi","title":"Mikeyaxi","order":33,"numberOfChapters":7,"sha256":"777b96dfc9113ed83716b07b5de1954f677be4f7f3070d478a208dd34d84fa6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/hch_wb2/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["'Ikɨ niuki kanihɨkɨtɨni Yawé Mikeyaxi Muretseti kiekame kemɨtiutaxatɨa, kepauka memɨte'aitakaitsie Kutani, 'Akatsi meta 'Etsekiyaxi, Kura kwieyaritsie te'aitamete. 'Ikɨ kanihɨkɨtɨni kemɨtiunieritɨarie mɨkɨ Tsamariya hepaɨtsita meta Kerutsareme hepaɨtsita."]},{"type":"heading","content":["Yawé kemɨtinuani"]},{"type":"verse","number":2,"content":[{"text":"Yunaitɨ teɨteri, xekeneu'enana,","poem":1},{"text":"kwie keneu'ena","poem":2},{"lineBreak":true},{"text":"meta yunaitɨ hetsiena xemɨte'u'uwa.","poem":2},{"text":"Yutuki mɨpatsieta paitɨ","poem":1},{"text":"Ti'aitame, Yawé naimekɨmɨyɨwe,","poem":2},{"lineBreak":true},{"text":"kaninierekamɨkɨ xeme ke'axaxemɨteyurie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Neuxei. Yawé yukiita kanayeyeiximeniri,","poem":1},{"text":"'akanakamieniri meta kaniumieni","poem":2},{"lineBreak":true},{"text":"hɨri 'amanutitɨtɨtsie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hɨri heima makekatsie kanitipenikeni,","poem":1},{"text":"xɨrɨka taikɨ mukwanani hepaɨ,","poem":2},{"text":"kwie mayeweweri hixɨata kanitsanikeni,","poem":1},{"text":"haa mɨtɨrɨkaɨye hixɨata mɨtsana hepaɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Ikɨ naitɨ mɨya katiniyɨmɨkɨ Kakuwu nuiwarimama 'axamemɨte'uyurikɨ,","poem":1},{"text":"'ixaheritsixi teɨteriyari 'axamemɨte'uyurikɨ.","poem":2},{"text":"Tsamariya kanihɨkɨtɨni ya'aneme meutiwiwiexɨa 'Ixaheri 'axamɨtiyurienikɨ.","poem":1},{"text":"Meta Kerutsareme kanihɨkɨtɨni kakaɨyarixi watukite 'etsimupepe mati'ukai hɨri 'amanutitɨtɨtsie Kura kwieyaritsie.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tsamariya 'unimeyari kwinienetɨ 'uweme nepɨhayewa:","poem":1},{"text":"kwietsanaripa payani kaxie maka'iteɨtsieni.","poem":2},{"text":"Tetexiyari mayeweritsie nekaneukaxɨrimɨkɨ,","poem":1},{"text":"meta tenariyari heyekɨa nekanihayewamɨkɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yunaitɨ kakaɨyariximama mekanititarariekuni,","poem":1},{"text":"tuminikɨ memuyumayɨinɨa wa'iwarikakɨ memɨwewiyatɨkakɨ taipa katineuxɨriyamɨkɨ.","poem":2},{"lineBreak":true},{"text":"Ne wakakaɨyarixi yunaime nepɨwatitemɨxikita.","poem":2},{"text":"Naitɨ tita mɨtiyutiwewi tuminikɨ kumayɨiwatɨ me'iwakaikɨ,","poem":1},{"text":"tuminikɨ muyumayɨinɨa mɨtipitɨarieni tawari payani.","poem":2}]},{"type":"heading","content":["Mikeyaxi hiwerikaya"]},{"type":"verse","number":8,"content":[{"text":"'Ayumieme nekanititsuamɨkɨ meta kukuiniyakɨ nekaniutahiwamɨkɨ,","poem":1},{"text":"neheumamawetɨ 'anepuyeikani meta neheumawetɨ.","poem":2},{"text":"Yawi mayu'eriya hepaɨ nekatiniutsuakamɨkɨ,","poem":1},{"text":"'aru 'amɨnena hepaɨ nekatiniutsuakamɨkɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tsamariya kemɨtiukwinitɨarie pɨkayu'uayemarinɨa:","poem":1},{"text":"Kura kwieyaritsie kaniye'ani.","poem":2},{"text":"Neteɨterima wahetsiepai naime kanakɨnɨni,","poem":1},{"text":"Kerutsareme kitenieyaritsie paitɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kahati kiekariyaritsie mɨkɨ xepɨkatehekuxatani,","poem":1},{"text":"yemekɨ xepɨkahetitsuanani,","poem":2},{"text":"xekenetikurupi kukuiniyakɨ","poem":1},{"text":"Weti-Rehapɨra tumuanariyaritsie.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tsahapixi kiekatari,","poem":1},{"text":"xekenayekɨni xemamawetɨ meta tixaɨtɨ xekatehayuyeitɨatɨ.","poem":2},{"text":"Tsanani memɨtama","poem":1},{"text":"mepɨka'uyuwaɨri memɨwayekɨnekɨ.","poem":2},{"text":"Weti-'Etseri kiekariyari kaniuta'aiwani,","poem":1},{"text":"'ari pɨkaxeparewieni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"'Aixɨa ti'aneme metetakwewietɨ mepɨte'ukakukuine,","poem":1},{"text":"Maruti kiekatari,","poem":2},{"text":"Yawé 'axamɨti'ane kaneyenɨ'ani","poem":1},{"text":"Kerutsareme kitenieyaritsie paitɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Rakixi kiekatari,","poem":1},{"text":"kawayutsixi kaxetate xekeniwaranawɨtɨiri.","poem":2},{"text":"Xeme xehetsɨa putsutɨrixɨ Tsiyuni niweya 'axamɨtiyurienikɨ,","poem":1},{"text":"xeme meri xepɨte'utsutɨa ke'axamɨtiyurienekai 'Ixaheri.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Ayumieme, Muretseti-Kahati kiekariyari xekeneutateutɨa.","poem":1},{"lineBreak":true},{"text":"'Akitsiwi kiekariyaritsie kii 'amutɨtɨ","poem":1},{"text":"'Ixaheri kwieyaritsie te'aitamete wawiniyari kanihɨkɨtɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Maretsa kiekatari,","poem":1},{"text":"ne xeime tiyu'uname muwara'iwa nekananunɨ'amɨkɨ xehetsɨa,","poem":2},{"text":"'ixaheritsixi yemekɨ memɨkamama","poem":1},{"text":"'Arurani paitɨ mekani'axɨakuni memuyuti'awietakɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"'Ayumieme 'amɨxiya kenanuyexika meta 'amu'utsie keneuyukametseriya,","poem":1},{"text":"hiwerika keneuwewi 'aniwema pemɨwanaki'erie wahetsiemieme,","poem":2},{"text":"waɨkawa keneuyukametseriya wirɨkɨ kemɨremu'u hepaɨ,","poem":1},{"text":"karikɨ 'aniwema pekaninawaiyariemɨkɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}