{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"MIC","translationId":"hch_wb2","name":"Mikeyaxi","commonName":"Mikeyaxi","title":"Mikeyaxi","order":33,"numberOfChapters":7,"sha256":"777b96dfc9113ed83716b07b5de1954f677be4f7f3070d478a208dd34d84fa6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/hch_wb2/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":2,"content":[{"type":"heading","content":["Kememɨtekwinitɨarieni xikutsixi memɨteyukananaima"]},{"type":"verse","number":1,"content":[{"text":"Xɨa'ui kemɨ'ane xeikɨa memɨyu'iyaritɨa 'axamemɨteyurienikɨ,","poem":1},{"text":"me'uheitɨ 'akuxi ke'axamemɨteyurienikɨ memitiwewiwa.","poem":2},{"text":"'Amɨtikataretsie, mɨpaɨ mepɨte'eye'atɨwa","poem":1},{"text":"mɨkɨ tɨrɨkariya memexeiyakɨ yuhetsie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kwie mɨraka'etsitɨre mehiwe'erietɨ, yupiini mekanayeitɨwani,","poem":1},{"text":"meta kiite, mɨkɨta yukii mekanayeitɨwani.","poem":2},{"text":"Waɨriyarika me'inanaimatɨ 'uki mekateni'aitɨaka meta tɨɨriyamama,","poem":1},{"text":"tewi meta tita mɨrexeiyakai.","poem":2}]},{"type":"verse","number":3,"content":["'Ayumieme, Yawé mɨpaɨ kanaineni:",{"text":"«Hikɨta nepɨta nekanihɨkɨtɨni nemɨne'iyaritɨa","poem":1},{"text":"wahetsie nemi'atɨanikɨ 'axamɨtiwayuriekakɨ,","poem":2},{"lineBreak":true},{"text":"mɨkɨ tsata memayuye'una mepɨkayɨwekaxɨani.","poem":2},{"text":"Mepɨkaku'uwaniri heitserie meheutanenieretɨ meyuti'ɨretɨ,","poem":1},{"text":"maye'akɨri tukari ke'axamemɨ'itɨarienikɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Ana tukaritsie hipatɨ mepɨwananaimaka,","poem":1},{"text":"hikɨ 'ikɨ hiwerika kwikariyari wahetsiemieme pɨtakwikarieni:","poem":2},{"text":"“Tepeuyexɨri.","poem":1},{"text":"Neteɨterima wakwie memaka'etsa mekaniyutaxitekiwani.","poem":2},{"text":"Kehepaɨtɨtɨ menetenawairietɨwe.","poem":1},{"text":"Memɨtatsi'a'iwaxɨ takwie mekaniyetuiriyarɨwani”».","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"'Ayumieme xepɨkaheixeiyani Yawé teɨterimama watsata","poem":1},{"text":"xeime kwie wayetuiriwame.","poem":2}]},{"type":"heading","content":["Kakaɨyari niukametemama memɨkahɨkɨ"]},{"type":"verse","number":6,"content":[{"text":"'Ikɨ Kakaɨyari niukametemama mɨpaɨ mepɨnetekɨhɨawe:","poem":1},{"text":"«'Ari ketineuhayewa petihekɨatatɨ.","poem":2},{"lineBreak":true},{"text":"Pepɨkataraxaxatɨwani kename teka'unarieni».","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kakuwu nuiwarimama mɨpaɨ mekaniutiyuaneni:","poem":1},{"text":"«¿Kamɨtsɨ Yawé tinewatɨ 'ari tiuhayewaxɨ?","poem":2},{"lineBreak":true},{"text":"¿Kamɨtsɨ mɨyatiuka'iyari?","poem":2},{"text":"¿Tamɨ niukieya 'aixɨa katiyuyuruwa?","poem":1},{"text":"¿Tamɨ tame 'aixɨa mɨtiuka'iyari hepaɨ tekate'u'uwa?»","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Takai xeme neteɨterima xepɨhɨkɨtɨkai,","poem":1},{"text":"peru hikɨri xemɨnetsi'aye'unie xepakɨ.","poem":2},{"text":"Hakewa mɨreyukwine memeyekɨka,","poem":1},{"text":"kayuwatɨ me'uhukaku huyeta,","poem":2},{"lineBreak":true},{"text":"wakamixa 'amɨtɨtɨ xepɨtewanawairietɨwe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Neteɨterima 'ukarawetsixi","poem":1},{"text":"wakiita 'aixɨa memɨtemateta xepɨwarayexɨrɨwa,","poem":2},{"text":"meta watɨɨriyama yuheyemekɨ xepɨtewanawairie","poem":1},{"text":"naime tita nemɨtiwayetuiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Xekenanuku'uti. Xekeneuhuni,","poem":1},{"text":"'ikɨ 'ena xema'uxipie pɨkahɨkɨ.","poem":2},{"text":"Tita 'axamɨti'ane xepɨte'utahɨniyaxɨ,","poem":1},{"text":"xepika'unaxɨ naime yemekɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Xɨka xewitɨ tixe'itaiyamɨtɨ,","poem":1},{"text":"xɨka nuani ti'itawatɨ mɨpaɨ tixe'utahɨawe:","poem":2},{"text":"«Ne nepɨtixetahekɨatɨani kaxie winuyari meta kaxie hayari wahepaɨtsita»,","poem":1},{"text":"'ikɨ teɨteri Kakaɨyari niukameya mepayeitɨani.","poem":2}]},{"type":"heading","content":["Kemutayɨ kemɨtiwaxɨnakekai"]},{"type":"verse","number":12,"content":[{"text":"Kakuwu, yurikɨ mɨpaɨ nekanaineni,","poem":1},{"text":"ne yunaime 'ateɨterima nekaniwakuxeɨrimɨkɨ.","poem":2},{"text":"'Ixaheri, yurikɨ mɨpaɨ nekanaineni,","poem":1},{"text":"ne nekaniwakuteɨximɨkɨ memuyuhayewaxɨ.","poem":2},{"text":"Nepuwakuxeɨrieni muxatsi kuraruta memeuta'ɨnarieni hepaɨ,","poem":1},{"text":"muxatsi wahepaɨ, maku'ɨxaya hixɨapa,","poem":2},{"lineBreak":true},{"text":"memɨyuwaɨkawani hepaɨ tɨranari mepɨwewieni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Panuyekani kemɨ'ane muhuyetarɨmeni,","poem":1},{"text":"meta mɨkɨtatsiere huye mepuyuwewirieximeni,","poem":2},{"text":"kitenie mekaniuyekɨnikuni hikɨ mekaniyehuni,","poem":1},{"text":"mexi tiwa'aitɨwame 'umieni 'anuyekaitɨ,","poem":2},{"lineBreak":true},{"text":"mexi Yawé 'anuyekaitɨ 'umieni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/MIC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/MIC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/MIC/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}