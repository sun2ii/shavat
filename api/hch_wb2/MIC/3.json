{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"MIC","translationId":"hch_wb2","name":"Mikeyaxi","commonName":"Mikeyaxi","title":"Mikeyaxi","order":33,"numberOfChapters":7,"sha256":"777b96dfc9113ed83716b07b5de1954f677be4f7f3070d478a208dd34d84fa6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/hch_wb2/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"heading","content":["Kememɨtekwinitɨarieni kuwexinaruritsixi kemɨkatiheitserie memɨte'uximaya"]},{"type":"verse","number":1,"content":["Hikɨ mɨpaɨ nekaniutayɨni:",{"text":"«Xekeneu'enana, Kakuwu nuiwarimama wakuwexinaruritsixi,","poem":1},{"text":"xemɨ'itsɨkate 'ixaheritsixi wahetsiemieme:","poem":2},{"text":"¿Kareuyewetse xeme","poem":1},{"text":"xemimaika tita mɨtiheitserie?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Xeme 'aixɨa mɨti'ane xekateni'uxieka, tita mɨkatiheitserie pɨtata xetenaki'erie,","poem":1},{"text":"neteɨterima me'ayeneniereme wanawiyari xepɨkatsana","poem":2},{"lineBreak":true},{"text":"meta wawaiyari wa'umeyaritsie,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"xeme neteɨterima xepɨwakwa'a,","poem":1},{"text":"wanawiyari xepɨkatsana, wa'umeteyari xepɨtimura,","poem":2},{"text":"'etsipepeme xepɨwatixiteke wai xarita mɨka'etsarieni hepaɨ,","poem":1},{"text":"wai huxunuta mɨ'imaiyani hepaɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"'Uxa'atɨni Yawé mekanitahiwikuni parewiya mehewawiriwatɨ,","poem":1},{"text":"matsi mɨkɨ pɨkawata'eiya,","poem":2},{"text":"wahetsiemieme puyuti'awieta","poem":1},{"text":"'axamemɨte'uyurikɨ.","poem":2}]},{"type":"heading","content":["Kakaɨyari niukametemama memɨte'itawa meta yuri memɨtekuxata"]},{"type":"verse","number":5,"content":[{"text":"'Ipaɨ kanaineni Yawé xehepaɨtsita,","poem":1},{"text":"Kakaɨyari niukametemama neteɨterima xemɨwareuyexɨrɨwa:","poem":2},{"lineBreak":true},{"text":"«Kemɨ'ane 'ikwai memɨxemikwa, kename kayuwatɨ'uma xepɨtewakuxaxatɨwa,","poem":1},{"text":"kemɨ'ane 'ikwai memɨkaxemikwa, kename kuyaxa 'ayani xepɨtewakuxaxatɨwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hikɨ 'ayumieme, mepɨyɨriyarieni tawari tixaɨtɨkɨ mepɨkatexeiyatsitɨarieni,","poem":1},{"text":"mepɨkayɨwekaxɨaniri memɨtetaxata kemɨtiyɨni 'arike».","poem":2},{"lineBreak":true},{"text":"'Ikɨ Kakaɨyari niukametemama wahetsiemieme tau pakayune,","poem":1},{"text":"tukarikɨ wahetsiemieme yɨriya payani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Iyaritsie mieme memɨtaneniere mepɨyutitetewiya,","poem":1},{"text":"kakaɨyarixi memɨwaruta'iwawiya kemɨtiyɨnikɨ tixaɨtɨ mepɨkate'ayeitɨarieni.","poem":2},{"text":"Kakaɨyari wateta pɨreunani,","poem":1},{"text":"mɨkɨ tawari pɨkawata'eiya.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne, matsi, tɨrɨkariyakɨ nekanihɨneni,","poem":1},{"text":"nekanihɨneni Yawé 'iyarieyakɨ,","poem":2},{"lineBreak":true},{"text":"meta nekanihɨneni tita mɨtiheitseriekɨ meta tɨrɨkariyakɨ,","poem":2},{"text":"nekaniyɨweni Kakuwu nuiwarimama nemɨwarutaxatɨani ke'axamemɨtekahu","poem":1},{"text":"nekaniyɨwenita 'ixaheritsixi nemɨwataxatɨani ke'axamemɨte'uyuri.","poem":2}]},{"type":"heading","content":["'Itsɨkame 'axamɨtikamiekɨ, 'ayumieme Tsiyuni puka'unarie"]},{"type":"verse","number":9,"content":[{"text":"Xeme 'ikɨ xekeneu'eni,","poem":1},{"text":"Kakuwu nuiwarimama wakuwexinaruritsixi,","poem":2},{"text":"meta 'itsɨkate 'Ixaheri kwieyaritsie miemete,","poem":1},{"text":"tita mɨtiheitserie xepɨxani'erie meta xepitituna niuki heitserie mɨtikuxata,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kerutsareme meta netuki manuwe","poem":1},{"text":"'imieri meta kemɨkatiheitserie tukarikɨ yapɨtixuawe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wa'itsɨkate metepitɨarietɨ xeikɨa 'aixɨa mepɨteyurie,","poem":1},{"text":"wamawari wewiwamete mepɨwa'ɨxatsitɨa meteyuwiyatɨ,","poem":2},{"lineBreak":true},{"text":"meta wakakaɨyari niukametemama tuminikɨ xeikɨa mekatenikuxatani kemɨtiyɨni,","poem":2},{"text":"'imatɨrieka matsi, Yawé hetsie mekaniyutɨrɨkariyani, mɨpaɨ mekaniutiyuaneni:","poem":1},{"text":"«¿Tamɨ Yawé tahamatɨa katiuyeika?","poem":2},{"lineBreak":true},{"text":"Tame hawaikɨ 'axatepɨka'itɨarieni».","poem":2}]},{"type":"verse","number":12,"content":[{"text":"'Ayumieme, xeme ya'aneme xewiwiekaku","poem":1},{"text":"Tsiyuni kwietsanaripa hepaɨ tiyuxexeiyatɨ kanayeimɨkɨ,","poem":2},{"text":"Kerutsareme 'unimeyari xeikɨa kaniyuhekɨarimɨkɨ,","poem":1},{"text":"meta yemuri tuki manuwekai 'ɨtsita kanayeimɨkɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}