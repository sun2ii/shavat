{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"MIC","translationId":"hch_wb2","name":"Mikeyaxi","commonName":"Mikeyaxi","title":"Mikeyaxi","order":33,"numberOfChapters":7,"sha256":"777b96dfc9113ed83716b07b5de1954f677be4f7f3070d478a208dd34d84fa6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/hch_wb2/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["'Arike Tsiyuni kiekariyari ke'aixɨa mɨtitahɨawarieni"]},{"type":"verse","number":1,"content":[{"text":"'Imatɨrieka tukari 'umahutsie,","poem":1},{"text":"yemuri Yawé tukieya manuwekai","poem":2},{"text":"hɨrite 'amutɨtɨ heima kanakayeriemɨkɨ","poem":1},{"text":"meta mɨkɨ matsi yunaime hɨrite wara'iwatɨ kanayeimɨkɨ.","poem":2},{"text":"Hikɨ teɨteri hepana mekaniukɨnikuni,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"meta nuiwarite yumɨiretɨ hetsɨana mekani'axɨakuni, mɨpaɨ mekanitiyuakuni:","poem":2},{"text":"«Xekenakɨni, tepanutikɨne Yawé yemurieyatsie,","poem":1},{"text":"Kakuwu Kakaɨyarieya tukita.","poem":2},{"text":"Kakaɨyari yukɨmana yu'aitsikate kataneta'ɨkitɨamɨkɨ,","poem":1},{"text":"'ana mɨpaɨ tepɨte'u'uwani».","poem":2},{"text":"Karikɨ Tsiyunitsie kanayeneikani 'ɨkitɨarika,","poem":1},{"text":"Kerutsareme hetsie, Yawé niukieya.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kakaɨyari yɨkɨmana yumɨireme teɨteri wahetsiemieme 'aixɨa katinakayurimɨkɨ,","poem":1},{"text":"meta tita mɨtiheitserie hepaɨtsita pɨtita'uximayata","poem":2},{"lineBreak":true},{"text":"nuiwarite memɨtɨrɨkawi wahetsie meta 'ateewa kiekatari.","poem":2},{"text":"Yu'ixiparate hatsarunite mepayeitɨaxɨani,","poem":1},{"text":"meta yupitsikate 'ɨxa xikame mepayeitɨaxɨani.","poem":2},{"text":"'Ari nuiwarite mepɨkayukwitɨweniri,","poem":1},{"text":"meta tawariri 'imieri kuyaxa mieme mepɨkayuti'ɨkitɨani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yuxexuitɨ kaxie meta piní","poem":1},{"text":"'iteɨriyari hetɨa xepɨtiyaxikeni,","poem":2},{"text":"nixewitɨ 'axamatɨarietɨ pɨka'ayani","poem":1},{"text":"—Yawé Naimekɨmɨtɨrɨkaɨye mɨpaɨ kaniutayɨni—.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Teɨteri yunaitɨ yukakaɨyarixi","poem":1},{"text":"wahetsie metewiyatɨ mekaniuhuni,","poem":2},{"text":"matsi tame Yawé hetsie tetewiyatɨ xeikɨa tekaniuhuni,","poem":1},{"text":"takakaɨyari hetsie tetewiyatɨ,","poem":2},{"lineBreak":true},{"text":"hikɨ 'ena mɨtiyehane meta yuheyemekɨ.","poem":2}]},{"type":"heading","content":["'Arike Tsiyuni kiekariyari kemɨtihekwatɨarieni"]},{"type":"verse","number":6,"content":[{"text":"«Yawé mɨpaɨ kanaineni: 'Iya tukaritsie,","poem":1},{"text":"muxatsi memɨte'utikwinitɨarie nekaniwakuxeɨrimɨkɨ,","poem":2},{"lineBreak":true},{"text":"memeutaxɨriexɨa meta memɨnanaimarie.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Muxatsi memɨwitekietɨka memuyuhayewaxɨ nekaniwarayeitɨamɨkɨ,","poem":1},{"text":"meta 'ateewa memehapanie, xeinuiwariyari metɨrɨkaɨyeme nepɨwarayeitɨani.","poem":2},{"text":"Yawé mɨkɨ wahetsie katini'aitakamɨkɨ Tsiyuni hɨriyaritsie","poem":1},{"text":"hikɨ 'ena mɨtiyehane meta yuheyemekɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"'Ekɨta, Muxatsi Watuxiyu,","poem":1},{"text":"yemuri kuraru 'amatitetewa Tsiyuni kiekariyari:","poem":2},{"text":"'ahetsɨa kaninuamɨkɨ meripai tɨrɨkariya kepemɨrexeiyakai,","poem":1},{"text":"mariwemekɨ kepemɨti'aitakai Kerutsareme kiekariyari».","poem":2}]},{"type":"heading","content":["Kemɨti'uximatɨarieni meta kemɨra'iwa Tsiyuni"]},{"type":"verse","number":9,"content":[{"text":"Hikɨta, ¿ketitayari kwinimieme petiuhiwa?","poem":1},{"text":"¿Kamɨtsɨ ti'aitame pekarexeiya?","poem":2},{"text":"¿Titayari 'ukaratsi niweyame kukuiniyaya meti'axiya?","poem":1},{"text":"¿Kamɨtsɨ matsi'ɨxatsitɨwame tiumɨ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ketineukakukuineni meta keneu'atawawaɨriyani, neniwe 'uka Tsiyuni,","poem":1},{"text":"'ukaratsi mɨtiniwerɨmeni hepaɨ,","poem":2},{"text":"karikɨ hikɨri 'akiekaritsie pekanayeyeimɨkɨ,","poem":1},{"text":"meta yeuta pe'ukaitɨ pekanayeimɨkɨ.","poem":2},{"text":"Wawiruniya pekaniyemieni, matsi mana pe'uyeikatɨ pekanixɨnariemɨkɨ,","poem":1},{"text":"Yawé kamenixɨnamɨkɨ memɨmatsi'aye'unie kememɨmete'aitɨatsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Hikɨri nuiwarite yumɨiretɨ mepɨyukuxeɨri memetsi'aye'unietɨ.","poem":1},{"text":"Mɨpaɨ meputiyuane: «Tsiyuni kapatsietɨ ke'ayeitɨarieni.","poem":2},{"lineBreak":true},{"text":"Tenenieretɨ tepɨyutemamawieka».","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Matsi mɨkɨ Yawé kemɨtiku'eriwa mepɨkatemate,","poem":1},{"text":"meta mepɨkaheitimaitɨkɨka kemɨtiyurimɨkɨ 'arike,","poem":2},{"text":"'atsimepɨkatemate mɨkɨ mɨwarukuxexeɨriwa","poem":1},{"text":"mɨwaka'itsanakɨ waxata hepaɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kenanukukexi, neniwe 'uka Tsiyuni.","poem":1},{"text":"Kene'uneni.","poem":2},{"text":"'A'awate tepɨa nekanayeitɨaxɨamɨkɨ","poem":1},{"text":"meta 'akarutsate wurunitse nekanayeitɨaxɨamɨkɨ,","poem":2},{"text":"yumɨireme teɨteri tumuanari pemɨwarayeitɨanikɨ,","poem":1},{"text":"meta Yawé pekatiniyetuiriemɨkɨ tita memɨte'a'iwaxɨ 'axa'anemekɨ,","poem":2},{"lineBreak":true},{"text":"tita waɨkawa memɨteheuxeiya pekatiniyetuamɨkɨ, Ti'aitame mɨhɨkɨ naitsarie kwiepa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}