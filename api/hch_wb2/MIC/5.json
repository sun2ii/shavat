{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"MIC","translationId":"hch_wb2","name":"Mikeyaxi","commonName":"Mikeyaxi","title":"Mikeyaxi","order":33,"numberOfChapters":7,"sha256":"777b96dfc9113ed83716b07b5de1954f677be4f7f3070d478a208dd34d84fa6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/hch_wb2/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":5,"content":[{"type":"heading","content":["Ti'aitame Rawiri nuiwarieya hepaɨtsita"]},{"type":"verse","number":1,"content":[{"text":"Neniwe 'uka yumemiwame, 'akuyaxima keniwarukuxeɨri,","poem":1},{"text":"takuraruri kananutinamieka.","poem":2},{"text":"'Iwaɨyɨkɨ yu'auritapa peutiweiyani","poem":1},{"text":"'Ixaheri kwieyaritsie ti'aitame.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Matsi 'ekɨ, Wereni 'Epɨrata,","poem":1},{"text":"kiekari 'etsipemɨyewa Kura nuiwarimama watsata,","poem":2},{"lineBreak":true},{"text":"'ahetsie pɨyeyani 'Ixaheritsie mɨtita'aita,","poem":2},{"text":"tsutɨa paitɨ kiekatari puwanuiwari,","poem":1},{"text":"watukari mɨka'inɨari.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Ayumieme Kakaɨyari kaniwayetuamɨkɨ mɨwaraye'unie hetsɨa,","poem":1},{"text":"kepaukake 'ukaratsi mayehuka 'ukitɨme mɨtiniweni,","poem":2},{"text":"hikɨ 'ixaheritsixi memehapaniekai","poem":1},{"text":"yu'iwama 'ixaheritsixi wahetsɨa mepɨ'axɨani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Peru xewitɨ kaninemɨkɨ muxatsi wahepaɨ wahɨweme mayani","poem":1},{"text":"Yawé tɨrɨkariyayakɨ,","poem":2},{"lineBreak":true},{"text":"mɨkɨ kemɨtimariwe 'ipitɨakaku Yawé kakaɨyarieya.","poem":2},{"text":"'Aixɨa 'iyari mepu'uwani, mɨkɨ mɨti'aitanikɨ","poem":1},{"text":"kwie kemɨyewa naimetsie.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mɨkɨ kayuwatɨ temu'uwanikɨ yapɨtiyurieni.","poem":2},{"text":"Xɨka 'Atsiriya nuani takwieyaritsie","poem":1},{"text":"takwieyari ka'unake takiekarite kuraruyari 'amatitetewa,","poem":2},{"text":"tepitamieni yu'atahutame muxatsi wahɨwemete tewarawitɨtɨ,","poem":1},{"text":"meta 'atahaika kuyaxi memanuyetei wahekɨ,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"mɨkɨ 'Atsiriyatsie mepɨtetahɨni 'ixiparakɨ,","poem":1},{"text":"Nimiruri kwieyatsie, nawaxakɨ mepɨteta'aita.","poem":2},{"text":"Xɨka 'Atsiriya takwieyari 'uka'unake,","poem":1},{"text":"xɨka takwieyaritsie watahanike,","poem":2},{"lineBreak":true},{"text":"mɨkɨ pɨtatsitawikweitsitɨani.","poem":2}]},{"type":"heading","content":["Memuyuhayewa"]},{"type":"verse","number":7,"content":[{"text":"Kakuwu nuiwarimama memuyuhayewa,","poem":1},{"text":"teɨteri meyumɨireme watsata,","poem":2},{"text":"haɨtsi Yawé hetsɨa mieme hepaɨ mepɨ'aneni,","poem":1},{"text":"wiyeri 'amayetsuye tupiriya hetsie mɨkaxɨrɨwe hepaɨ,","poem":2},{"text":"teɨteri memɨka'inɨ'a,","poem":1},{"text":"meta tixaɨtɨ mɨkatiwarawawiriwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kakuwu nuiwarimama memuyuhayewa nuiwarite watsata,","poem":1},{"text":"yumɨireme teɨteri watsata,","poem":2},{"text":"maye yeutarite watsata kemɨtiyumate mɨkɨ hepaɨ mepɨ'aneni,","poem":1},{"text":"maye temaikɨ muxatsi watsata kemɨtiyumate hepaɨ,","poem":2},{"text":"kepauka watsata meutahani puwatixutsina meta puwatikwa'a,","poem":1},{"text":"nixewitɨ wahetsie mɨtanuani mɨkayɨwekɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Memɨxe'aye'unie xepɨwatakwini,","poem":1},{"text":"hikɨ yunaime xepɨwakwini memɨxekwitɨwe.","poem":2}]},{"type":"heading","content":["Kememɨte'itiyani kakaɨyarixi memɨkawarayexeiyanikɨ"]},{"type":"verse","number":10,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«Mɨkɨ tukaritsie 'akawayutsixi kuyaxa miemete nekaniwareuyehɨamɨkɨ,","poem":1},{"text":"metatsiere 'akaxetate kuyaxa miemete.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kiekarite 'akwieyaritsie miemete nekanakuxɨtɨamɨkɨ","poem":1},{"text":"metatsiere naime 'akiekarite kuraruyari 'ematitɨtɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kepemɨtiyukewaiya nekaneitipariyamɨkɨ","poem":1},{"text":"meta kakaɨyarixi memuwaruta'iwawiya kemɨtiyɨnikɨ pepɨkawarexeiyaniri.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Akakaɨyarixi nekaniwareutipariyamɨkɨ","poem":1},{"text":"meta 'atetexi memɨpatsietɨka 'amɨti'u,","poem":2},{"text":"tawariri hatsuaku wahɨxie pepɨkatitunumakeni","poem":1},{"text":"'amamakɨ pemɨtiwawewie wahɨxie.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Atserá 'ɨkiyarite nepatihunaxɨani,","poem":1},{"text":"meta 'akiekarite 'unimeyari kwinieneme nekanikemɨkɨ,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"neha'atɨ waɨkawa nekatiniwarakapitɨamɨkɨ","poem":1},{"text":"kemɨ'ane nuiwarite memɨkanetsi'anu'eni».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/MIC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}