{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"MIC","translationId":"hch_wb2","name":"Mikeyaxi","commonName":"Mikeyaxi","title":"Mikeyaxi","order":33,"numberOfChapters":7,"sha256":"777b96dfc9113ed83716b07b5de1954f677be4f7f3070d478a208dd34d84fa6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/hch_wb2/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":6,"content":[{"type":"heading","content":["Kakaɨyari yuteɨterima kemɨtiwaxaneta"]},{"type":"verse","number":1,"content":["Yawé kemutaine xekeneu'eni:",{"text":"«Kenanukukexi, hɨrite wahɨxie 'axanetsika keneyetua,","poem":1},{"text":"yemurite 'aniuki meke'u'enieni».","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yemurite xekeneu'eni, Yawé xanetsikaya,","poem":1},{"text":"kayuwatɨ xekeneu'enana, kwie tsutɨmeyari,","poem":2},{"text":"Yawé kanitsutɨaka yuteɨterima waxanetatɨ,","poem":1},{"text":"kanitsutɨani 'ixaheritsixi wahamatɨa 'aixɨa mɨtiyurienikɨ:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"«Neteɨterima, ¿ne kenexe'uyuri?","poem":1},{"text":"Yaxekeneteneutahɨawi kepauka nepɨxe'umuinaxɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne nekatiniuyurieni 'Ekipitu kwieyaritsie nemɨxe'ayewitɨ,","poem":1},{"text":"nemɨxe'uxɨnaxɨ mɨkɨ kwieyaritsie waɨriyarika xete'aitɨariekaku.","poem":2},{"text":"Ne nekaniwarutanɨ'ani Muitsexi, 'Aruni meta Miriyami,","poem":1},{"text":"memɨxe'uwitɨximenikɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neteɨterima, xekena'eriwani","poem":1},{"text":"Waraki Muhawi kwieyaritsie ti'aitame kemɨtiyurimɨkɨkai,","poem":2},{"lineBreak":true},{"text":"meta Warami Wehuxi nu'aya kemɨtita'ei.","poem":2},{"text":"Xekena'eriwani kexemɨte'ukɨ Tsitini xemɨyekɨ Kirikari paitɨ xemu'axɨa,","poem":1},{"text":"meta mɨpaɨ xeketenemaika Yawé kemɨtixe'utawikweitsitɨa».","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"¿Kehepaɨ neyɨme Yawé hɨxie 'ahurawa nepunuani","poem":1},{"text":"meta kehepaɨ Kakaɨyari Mɨmariwe hɨxie netikatunumakeni?","poem":2},{"text":"¿Netiyɨwe mawari taiyariyarikɨ","poem":1},{"text":"yatɨni tsikeru xeiwiyari mexeiya neyetuatɨ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"¿Yawé tiyukatemawieni miriyaritekɨ muxatsi 'ukitsi wahekɨ,","poem":1},{"text":"yatɨni tamamata miriyari 'akiyarikɨ hatseiti muhapane?","poem":2},{"text":"¿Neniwe mexɨakame netiyetuani,","poem":1},{"text":"nehetsie mɨyetɨa netiyetuani 'axanemɨtiuyurikɨ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yapekatiniutaxatɨarieniri tita 'aixɨa mɨti'ane.","poem":1},{"text":"Pepɨtiutaxatɨarieri tita mɨtitakwewie 'ahetsiemieme Yawé:","poem":2},{"text":"Yapepɨtiyurieneni tita mɨtiheitserie hepaɨtsita,","poem":1},{"text":"pepinaki'erieka nenimayatsika,","poem":2},{"lineBreak":true},{"text":"meta Kakaɨyari hɨxie mariweme pepɨka'ayuyeitɨwani.","poem":2}]},{"type":"heading","content":["Kememɨtekwinitɨarieni 'axamemɨte'uyurikɨ tuminikɨ meta teɨteri wahetsie"]},{"type":"verse","number":9,"content":[{"text":"Nuiwarite meta teɨteri kiekaritsie kiekatari,","poem":1},{"text":"Yawé niukieya xekeneu'eni, pɨxeha'iniwa,","poem":2},{"lineBreak":true},{"text":"xɨka xetemaiwaweni, Yawé xekenemakaxeni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"«'Axaxemɨte'u'iyari.","poem":1},{"text":"¿'Atsinekaraineni tumini xemexeiya 'axa'anemekɨ xeme'iwaxɨ,","poem":2},{"lineBreak":true},{"text":"meta heuyewekamekɨ xemɨteku'inɨnɨata hepaɨtsita?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"¿Kename 'aixɨa 'ane nera'eriwani kirutame mɨtinawaya hepaɨtsita","poem":1},{"text":"meta tepɨa mahete manuyeyaxike 'aixɨa mɨkareuku'inɨatsie?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xikutsixi kiekaritsie kiekatari 'axamepɨte'u'iyari,","poem":1},{"text":"kiekatari mepɨte'itawa,","poem":2},{"lineBreak":true},{"text":"yuteta yuneni mepexeiya ti'itawame.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Ayumieme ne, nekametinikwinitɨamɨkɨ nemetsitiwayatɨ,","poem":1},{"text":"ne nepɨmetsika'una 'axapemɨtiuyurikɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Pepɨtiutikwa'ani, matsi pepɨka'utahuxarɨweni,","poem":1},{"text":"matsi yaxeikɨa pepɨhaakatɨarieka.","poem":2},{"text":"Pemɨtiukaxexeiyani yapɨreuyeikani,","poem":1},{"text":"meta tita 'etsiwa pemɨrexeiyani memɨmatsi'aye'unie nekaniwayetuiriemɨkɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tita pemɨtika'eni mɨkɨ pepɨkaka'itsana,","poem":1},{"text":"huriwu takari tsepa pemutipɨnaxɨ hatseiti pepɨkahexeiyani,","poem":2},{"lineBreak":true},{"text":"meta kaxie winuyari pepɨka'anu'ieni tsepanetɨ takariyari pemutiketsi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"'Ekɨ 'aixɨa 'anemekɨ 'Umiri 'aitsikaya pekaniuweiyani","poem":1},{"text":"meta naime 'Akawi nuiwarimama kememɨteyurie,","poem":2},{"lineBreak":true},{"text":"yapepɨtiuyeika 'ɨxatsieya kemutiyuane.","poem":2},{"text":"'Ayumieme pemɨka'unarienikɨ nekameniyetuamɨkɨ,","poem":1},{"text":"meta 'ateɨterima nekaniwatewinɨamɨkɨ.","poem":2},{"lineBreak":true},{"text":"Teɨteri 'axakemematekɨhɨaweni pepinewieka».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/MIC/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/MIC/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/MIC/5.json","previousChapterAudioLinks":{},"numberOfVerses":16}