{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"MIC","translationId":"hch_wb2","name":"Mikeyaxi","commonName":"Mikeyaxi","title":"Mikeyaxi","order":33,"numberOfChapters":7,"sha256":"777b96dfc9113ed83716b07b5de1954f677be4f7f3070d478a208dd34d84fa6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/hch_wb2/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"heading","content":["Hiwerika matsi kemɨtikuxatakai tixaxatame"]},{"type":"verse","number":1,"content":[{"text":"Xɨa'ui ne.","poem":1},{"lineBreak":true},{"text":"Wiita 'ikwaxi muti'inɨiwatsie 'anutiyaku nepunua,","poem":1},{"text":"pɨkayɨweri kaxie nemɨtiwauni,","poem":2},{"text":"tsikere xeixatsimuyari nepɨkahexeiya nemitikwanikɨ,","poem":1},{"text":"xapa takari yɨrime tɨma nepɨkahexeiya, kɨmana nemɨmɨxime.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Teɨteri Kakaɨyari memayexeiya 'ikɨ kwieyaritsie mekanakuxɨtɨarieniri,","poem":1},{"text":"'ena kwiepa mepumaweri teɨteri 'aixɨa memɨte'u'iyari.","poem":2},{"text":"Yunaitɨ hipame mepɨwakwiku,","poem":1},{"text":"meta yunaitɨ mekaniyuwiniyatɨweni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nixewitɨ pɨkawara'iwa ke'axamemɨteyuriekɨ,","poem":1},{"text":"ti'aitame parewiwametemama meta 'itsɨkate mepiku'iwawa 'awie memɨtepitɨarienikɨ.","poem":2},{"text":"Memɨtɨrɨkawi mekateniku'iwawani xeikɨa,","poem":1},{"text":"meta yunaitɨ mekaniyutemawieritɨaka ketita memɨtehiwe'eriekɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Watsata muyeika 'aixɨa mɨtiuka'iyari kwinimieme matsi katinihɨaka keyuri 'ɨtsi,","poem":1},{"text":"kemɨ'ane heitserie 'amuyeika, matsi kanitunini keyuri xuya.","poem":2},{"text":"Matsi kanaye'aximeniri memɨhɨxiyatɨarienitsie,","poem":1},{"text":"kanehuraniri tukari memɨtekwinitɨarienitsie,","poem":2},{"lineBreak":true},{"text":"kememutiyua memɨtaneniere 'ahetsɨa miemete.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xeime 'ahepaɨ tewi yuri pepɨkati'eririeka,","poem":1},{"text":"'ahamikuma wahetsie pepɨkatiwiyani,","poem":2},{"text":"kene'akweriwayurieka kepemɨtikuxaxatɨwa","poem":1},{"text":"'ahamatɨa mukahupu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nu'ayatɨtɨ yupapa pɨxani'erie,","poem":1},{"text":"'uka yumaama pɨkaheu'enie,","poem":2},{"lineBreak":true},{"text":"meta mu'etsiekame yumu'e paye'unie,","poem":2},{"text":"memɨxe'aye'unie xeme yuxexuitɨ","poem":1},{"text":"xekiitatɨtɨ mepayetetɨka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Matsi ne Yawé hetsie netiwiyatɨ nepɨta'ikwewa,","poem":1},{"text":"nepɨta'ikwewani Kakaɨyari hetsie netsiwikweitsitɨwame.","poem":2},{"lineBreak":true},{"text":"Nekakaɨyari kaneni'eniemɨkɨ.","poem":2}]},{"type":"heading","content":["'Ikwewarika memɨtawikweitsitɨarienikɨ"]},{"type":"verse","number":8,"content":[{"text":"Pemɨnetsi'aye'unie 'aku, 'axakemɨnetiyuriekɨ pepɨkayutemawieka.","poem":1},{"text":"Nepatiwe, matsi nepanukukeni,","poem":2},{"lineBreak":true},{"text":"yɨwipa nepuyeika, matsi Yawé nehekɨariya pɨhɨkɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yawé hepaɨtsita 'axanekatiniuyurieni,","poem":1},{"text":"'ayumieme nepinewieni haxɨaya","poem":2},{"text":"kepaukake 'aixɨa mɨtiyurieni kenemɨtiuyurikɨ","poem":1},{"text":"meta kemɨtiheitserie nehetsiemieme.","poem":2},{"text":"Hikɨ 'ana hekɨaripa pɨnetsi'atɨani","poem":1},{"text":"meta neyutemawietɨ nepayani wikweitsitɨarikayakɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mɨnetsi'aye'unie kepauka mɨniere,","poem":1},{"text":"mɨpaɨ mɨnetikɨhɨawekai: «¿Hakewari 'akakaɨyari?»,","poem":2},{"lineBreak":true},{"text":"waɨkawamekɨ puyutitewiya.","poem":2},{"text":"Nekanixeiyamɨkɨ kemɨtika'unarieni,","poem":1},{"text":"karikɨ haxu huye 'utɨa mieme hepaɨ katiniketsinariemɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kepauka 'akuraru 'amatayewa tawari mawewiyatɨyani","poem":1},{"text":"'ana kanihɨkɨtɨkamɨkɨ 'akwie 'apemɨtayeuriya.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mɨkɨ tukaritsie 'ahetsɨa mepɨ'axɨani teɨteri,","poem":1},{"text":"'Atsiriya metsutɨtɨ meta 'Ekipitu kiekariteyaritsie paitɨ meye'atɨ,","poem":2},{"text":"Niru hatuxameyari manuyeka metsutɨtɨ meta 'Eupɨrate hatuxameyaritsie meye'atɨ,","poem":1},{"text":"haramaratsie metsutɨtɨ meta tapa haramaratsie paitɨ, meta teewanarixi xeime hɨritsietari.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Karikɨ mɨkɨ kwieyarite makumawe kanayeixɨamɨkɨ","poem":1},{"text":"teɨterimama ya'aneme meheutiwiwiexɨaku,","poem":2},{"lineBreak":true},{"text":"'axamemɨteyuriekaikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"'A'itsɨ pe'akwetɨ 'ateɨterima keniwahɨneni,","poem":1},{"text":"muxatsi 'atewama,","poem":2},{"text":"yuxaɨta 'ɨtsita memɨkie,","poem":1},{"text":"'ɨtsi hixɨapa.","poem":2},{"text":"Watsani meta Karaha mu'ɨxayatsie ketiniwarutimikwa","poem":1},{"text":"meripaitɨ hepaɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mariweme ketineuyuri wahɨxie,","poem":1},{"text":"'Ekipitu kwieyaritsie pemɨwarayewitɨtsie hepaɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hipatɨ nuiwarite mekaninenierikuni mariwemekɨ kepemɨtiyurieni,","poem":1},{"text":"hikɨ yutɨrɨkariya mekanititewiyakuni,","poem":2},{"text":"yutenie mekaniuwɨrikuni","poem":1},{"text":"meta memɨkaheu'enana mekanayuyeitɨakuni.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tumuanari mekanikutsenakuni kuuterixi wahepaɨ,","poem":1},{"text":"kwiepa yutawima memɨteku'uwa wahepaɨ.","poem":2},{"text":"Mepɨwayekɨne me'utiyɨyɨakatɨ hakewa memeyu'awietatɨka","poem":1},{"text":"meta, memamatɨ 'ahɨxie,","poem":2},{"lineBreak":true},{"text":"mekaniyuyetuakuni 'ahetsɨa, Yawé meta takakaɨyari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Pumawe Kakaɨyari 'ahepaɨ tiuka'iyaritɨ,","poem":1},{"text":"'axamɨti'ane mɨtareuyehɨwiriwa","poem":2},{"text":"meta tixaɨtɨ mɨkarayeitɨwa ke'axamemɨte'uyuri","poem":1},{"text":"teɨterima memuyuhayewaxɨ.","poem":2},{"text":"'Aheyemekɨ pepɨkaha'a,","poem":1},{"text":"naki'eriya mɨmatsinakekɨ pɨta.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tawari ketaneutinenimayata.","poem":1},{"text":"Ke'axatemɨte'uyuritsie kenakexi,","poem":2},{"lineBreak":true},{"text":"meta naime 'axaketemɨte'uyuri haramara 'amatiyewatsie ketineukaxɨri.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Matsiɨkɨme kenayeitɨa Kakuwu pemɨkaku'eiriwe hatsuaku,","poem":1},{"text":"meta 'Apɨrahami heitserie kepemɨtinaki'erie,","poem":2},{"text":"meripaitɨ tsutɨa paitɨ","poem":1},{"text":"kepemɨti'ahɨritɨa tatutsima wahamatɨa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}