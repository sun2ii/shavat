{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"NAM","translationId":"hch_wb2","name":"Nahumi","commonName":"Nahumi","title":"Nahumi","order":34,"numberOfChapters":3,"sha256":"cd19b635874ab95e10bf25df27a106755246773a4f5c264b08ee22366e616c5c","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/hch_wb2/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Kemɨtiyɨni niukiyari Niniwe hepaɨtsita mieme. 'Ikɨ xapa kanihɨkɨtɨni Nahumi 'Erikutsi kiekame kemɨtiunieritɨarie hepaɨtsita mɨtikuxata."]},{"type":"heading","content":["Yawé kemɨtiuyeha'a Niniwe hepaɨtsita"]},{"type":"verse","number":2,"content":[{"text":"Yawé Kakaɨyari mɨtiuyukakwerie kanihɨkɨtɨni meta mɨyɨkɨhɨpa.","poem":1},{"text":"Yawé mɨyɨkɨhɨpa, Ti'aitame mayu'eriya.","poem":2},{"text":"Yawé pɨtiwarakapitɨwa kemɨ'ane memeye'unie,","poem":1},{"text":"mɨwaraye'unie wahepaɨtsita pɨkayuhaxɨapitɨarinɨa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yawé yapauka muyeha'ani pɨkayɨwe,","poem":1},{"text":"peru tɨrɨkariyaya pɨmariwe.","poem":2},{"lineBreak":true},{"text":"Yawé tiwakwinitɨatɨ xeime tɨma pɨkahayewa.","poem":2},{"text":"'Eka meta wiyeri mɨtɨrɨkawitsata kaniumieni,","poem":1},{"lineBreak":true},{"text":"hai tumuanari kanihɨkɨtɨni ketateya hetɨa mieme.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kepauka mɨkɨ mɨtita'aita haramara kaniukawaukeni,","poem":1},{"text":"meta haa muhapane kaniukawaukeni.","poem":2},{"text":"Watsani meta Kaximeru hɨriyaritsie 'ɨxa 'aixɨa mɨ'anene pɨtiwauke,","poem":1},{"text":"meta kɨyexi 'emɨpapa Riwanu mieme kanitiyɨnareni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kakaɨyari hɨxie hɨrite kaniutiyɨyɨakani,","poem":1},{"text":"meta yemurite kanika'unikeni.","poem":2},{"text":"Metatsiere hɨxiena kwie kaniutayuaneni,","poem":1},{"text":"meta yunaitɨ hetsiena memɨte'u'uwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"¿Kemɨ'ane pɨyɨwe mɨtiunewieni haxɨaya hepaɨtsita?","poem":1},{"text":"¿Kemɨ'ane putawikweiwe haxɨaya mɨtiyukukuinetsie?","poem":2},{"text":"Haxɨaya tai hepaɨ katiniyukukuineni,","poem":1},{"text":"hɨxiena tetexi kanititarikeni.","poem":2}]},{"type":"heading","content":["Niniwe kiekatari memuka'unarie"]},{"type":"verse","number":7,"content":[{"text":"Yawé 'aixɨa katiniuka'iyarini,","poem":1},{"text":"'uximatɨarika muxuawenitsie mɨkɨ tiyu'awietame kanihɨkɨtɨni,","poem":2},{"lineBreak":true},{"text":"meta kemɨ'ane hetsiena memɨtewiya wahetsie nunuwame kanihɨkɨtɨni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Peru Niniwe kanika'unamɨkɨ","poem":1},{"text":"kaniwatihautsitɨamɨkɨ waɨkawa mekaneuyewekuni,","poem":2},{"lineBreak":true},{"text":"tsepa makuyɨwitsie mɨwaraye'unie kaniwaranukuweiyamɨkɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"¿Kemetekuxata Yawé hepaɨtsita?","poem":1},{"text":"Mɨkɨ kememɨte'uxa katiniwamuririemɨkɨ.","poem":2},{"lineBreak":true},{"text":"Xeimieme xeikɨa pɨtiwakwinitɨani.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tupiriya mɨwawaki hepaɨ mekanitixɨtsitɨariekuni,","poem":1},{"text":"xuya mayuyewiya hepaɨ,","poem":2},{"lineBreak":true},{"text":"meta tarɨwekarixi winu 'iiyarikɨ memanutikɨ hepaɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Ekɨ, Niniwe, 'ahetsie pɨyetɨa","poem":1},{"text":"Yawé hepaɨtsita 'axamɨtikuxata,","poem":2},{"lineBreak":true},{"text":"'axa'anemekɨ mɨ'ɨxatsita.","poem":2}]},{"type":"heading","content":["Kakaɨyari teɨterimama kememɨte'utaxatɨarie"]},{"type":"verse","number":12,"content":["Yawé mɨpaɨ kanaineni:",{"text":"«Tsepanetɨ 'atsiriyutsixi memɨmɨire metɨrɨkawitɨ,","poem":1},{"text":"mekanikwi'iwakuni meta mekanikumaweriyariekuni.","poem":2},{"text":"'Ekɨta, Kura tsepa nemɨmatsi'uhiweritɨa,","poem":1},{"text":"tawariri nepɨkamatsihiweritɨani.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yuku pemetɨkɨ nekanitamuramɨkɨ","poem":1},{"text":"kepemɨrakuwie nekamanixɨnamɨkɨ».","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Peru 'ekɨ Niniwe, 'ahepaɨtsita,","poem":1},{"text":"Yawé 'ipaɨ katiniu'aita:","poem":2},{"text":"«Tawari 'anuiwarima mepɨkatixuawere memɨmatsiha'eriwani kepemɨtitewa,","poem":1},{"text":"watukita paitɨ nekaniwatitaramɨkɨ","poem":2},{"lineBreak":true},{"text":"kakaɨyarixi memɨxixiyatɨka meta memɨkwaxiyarietɨka.","poem":2},{"text":"'Ateukiya nenikuha'aritɨamɨkɨ,","poem":1},{"text":"'axapemɨtiuka'iyari pemɨhɨkɨkɨ».","poem":2}]},{"type":"heading","content":["Niuki Niniwe kemɨtiuka'unarie"]},{"type":"verse","number":15,"content":[{"text":"Neuxei. 'Ari hɨritetsie kanakamieni,","poem":1},{"text":"niuki 'aixɨa manuyɨne matɨkɨ kememɨte'ayu'iwaxɨ titaxatake,","poem":2},{"lineBreak":true},{"text":"kemɨ'ane mɨtatitaxatɨani kayuwatɨ temexeiyanikɨ.","poem":2},{"text":"Kura, 'a'ixɨarari kenewewieneniri.","poem":1},{"text":"Kepemutayɨ ketinaye'atɨwani.","poem":2},{"text":"'Axamemɨte'u'iyari tawari 'akwiepa mepɨkaheutahaxɨani,","poem":1},{"text":"'ari mekaniukwi'iwa yunaitɨ yemekɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/NAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/NAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/MIC/7.json","previousChapterAudioLinks":{},"numberOfVerses":15}