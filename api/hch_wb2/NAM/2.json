{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"NAM","translationId":"hch_wb2","name":"Nahumi","commonName":"Nahumi","title":"Nahumi","order":34,"numberOfChapters":3,"sha256":"cd19b635874ab95e10bf25df27a106755246773a4f5c264b08ee22366e616c5c","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/hch_wb2/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["Niniwe kiekariyari kemɨtika'unarieni"]},{"type":"verse","number":1,"content":[{"text":"Niniwe, 'ahepa kanamieni mɨmatsika'una,","poem":1},{"text":"'ayumieme kuyaxi wapaitɨ keniwaranutinɨ'a memɨtanenierenikɨ,","poem":2},{"text":"huye keneta'ɨwiyani, 'akuyaxima keniwaxeɨrieka,","poem":1},{"text":"'ahetsie titakɨ pemɨtitanuani ketineha'aritɨaka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Karikɨ Yawé yakatiniyurimɨkɨ Kakuwu tawari witsimɨtixeiyarienikɨ,","poem":1},{"text":"meta 'Ixaheri witsimɨtixeiyarienikɨ,","poem":2},{"text":"teyu'unamete mekateninawatsirieni,","poem":1},{"text":"'iteɨri mukahurukarieni hepaɨ katinanuyeyani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kuyaximama memɨkamama kɨmana memeuyukunarɨma kanixetani,","poem":1},{"text":"yaxeikɨa kuyaxi mekaneuxetani.","poem":2},{"text":"Wakaxetate tepɨayari kaniutixawatɨreni tai hepaɨ","poem":1},{"text":"mexi meyukuha'aritɨwa meyutakwinike","poem":2},{"lineBreak":true},{"text":"meta kuyaximama yupitsikate teikɨ mekanetsetserani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kaxetate hau'erietɨ kaye'utɨa mekaniye'uwani,","poem":1},{"text":"teɨteri memayukuxexeɨriwatsie mekani'axeni metewakwinitɨatɨ.","poem":2},{"text":"Tai kɨxeme hepaɨ mekateniyuxexeiyatɨkani,","poem":1},{"text":"meta mimierɨkari hepaɨ mekanikɨyɨaka.","poem":2}]},{"type":"heading","content":["Niniwe kemɨtiuka'unarie meta kemɨtiunawatsiyarie"]},{"type":"verse","number":5,"content":[{"text":"Niniwe kiekariyaritsie ti'aitame yukuyaxima 'aixɨa memɨ'anene kaniwaruta'inieni,","poem":1},{"text":"mɨkɨta mexɨitɨarikakɨ mekanekaxɨrɨweni.","poem":2},{"text":"Kuraru 'amatitewatsie meyumexɨitɨatɨ mekani'axeni","poem":1},{"text":"mana memɨte'anutananikɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Peru haa manutaname kaneuyepierixɨani,","poem":1},{"text":"paratsiyu pɨka'unirɨme.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yakatiniu'aitsieniri:","poem":1},{"text":"Niniwetari 'ateewa mekananuhapaniekuni.","poem":2},{"text":"'Ukari tewa'uximayatsiriwamete kukuruxi wahepaɨ mekateniutsuanani,","poem":1},{"text":"meta yutawitsie mekaneuyuhutsunani hiwerikakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Niniwe kiekariyari haa manutaname mɨtari hepaɨ kani'aneni,","poem":1},{"text":"teɨterimama mekanitayuruweni.","poem":2},{"text":"«Xekeneukunuaxɨa» «Xekeneukunuaxɨarikɨ», mekateniuhiwieriwani,","poem":1},{"text":"peru nixewitɨ tɨma pɨka'ukuneniere.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Pɨrata xekenewayetɨki.","poem":1},{"text":"Huru xekenewayetɨki.","poem":2},{"text":"Piinitɨarika mɨraye'atɨka pɨkati'inɨari,","poem":1},{"text":"meta piinite pɨtimɨire witsimɨti'anene mɨraye'atɨka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kiekari katiniunawatsiyarieni, yuxaɨta kaniyuhayewa meta 'unitɨ.","poem":1},{"lineBreak":true},{"text":"Wa'iyari kaniku'amɨwetɨkani,","poem":1},{"text":"watunute niutiyɨyɨakatɨkani,","poem":2},{"text":"wawaiyarite niutiyɨyɨakani,","poem":1},{"text":"yuhɨxie mekanayetukwarawiniri.","poem":2}]},{"type":"heading","content":["'Ɨrawe mɨtiyukwa'a kanimɨmɨkɨ"]},{"type":"verse","number":11,"content":[{"text":"¿Mayetsi waterɨ keranuyetɨa","poem":1},{"text":"meta mayetsi tɨɨrixi waterɨ,","poem":2},{"text":"hakewa maye 'uki, maye 'ukaratsi meta waniwema","poem":1},{"text":"memeyu'awietakai nixewitɨ kawa'uximatɨakakɨ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"¿Maye keranuyetɨa,","poem":1},{"text":"yuniwema wahetsiemieme 'etsitipepeme mɨtititsanakai","poem":2},{"lineBreak":true},{"text":"meta maye 'ukaratsi hetsiemieme yuxɨ'erika kɨipitɨa mawiwierekai,","poem":2},{"text":"yuterɨta yuxɨ'erika mɨtiutahɨniyakai","poem":1},{"text":"meta wai mutahɨniyakai mɨwayuti'awiwietatsie?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"«Peru ne hikɨ nekaninuani nematsi'aye'unietɨ","poem":1},{"text":"—Yawé Mɨtɨrɨkaɨye mɨpaɨ kanaineni—.","poem":2},{"text":"'Akaxetate kuyaxa miemete naxi nekaniwarayeitɨamɨkɨ,","poem":1},{"text":"meta 'ixiparakɨ 'aniwema mayetsi tɨɨrixi nekaniwakwimɨkɨ.","poem":2},{"text":"'Akwieyaritsie kiekatari memɨtenawaya nekaniwakumaweriyamɨkɨ,","poem":1},{"text":"hatsuakuri tawarita 'atupiritsixima waniuki pɨka'enierieni».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}