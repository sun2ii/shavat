{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"NAM","translationId":"hch_wb2","name":"Nahumi","commonName":"Nahumi","title":"Nahumi","order":34,"numberOfChapters":3,"sha256":"cd19b635874ab95e10bf25df27a106755246773a4f5c264b08ee22366e616c5c","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/hch_wb2/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"heading","content":["Niniwe kemɨtika'unarieni"]},{"type":"verse","number":1,"content":[{"text":"Xɨa'ui, kiekari xuriya pemɨtayeuriwa,","poem":1},{"text":"'itarikakɨ pemɨhɨne,","poem":2},{"text":"pemɨkatihayewa 'inawarikɨ,","poem":1},{"text":"meta pemɨkatihayewamɨkɨ pe'amienetɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kaunari 'iwaɨyɨpame yuariyaya kana'eniɨriɨkɨni,","poem":1},{"text":"meta kaxeta 'ɨkateya yuariyari,","poem":2},{"text":"kawayutsixi watɨranari,","poem":1},{"text":"kaxetate wayuariya,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"kawayutsixi wanautsari,","poem":1},{"text":"putimerɨka wa'ixiparate,","poem":2},{"text":"pitsikate putixawatɨre,","poem":1},{"text":"mepɨyumɨire mɨkite,","poem":2},{"text":"kaxarite pukuxeɨrietɨka,","poem":1},{"text":"kaxarite naitsarie kaneutiheni,","poem":2},{"lineBreak":true},{"text":"yunaitɨ wahetsie mekanekaxɨrɨweni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Ikɨ naitɨ mɨyakatiniuyɨni waɨkawamexɨa muyutuakɨ,","poem":1},{"text":"mɨkɨ 'ukaratsi tuminikɨ muyumayɨinɨa witsimɨti'ɨimari,","poem":2},{"lineBreak":true},{"text":"mɨkɨ mɨrakumate kemɨtiwaru'irɨwiya.","poem":2},{"text":"Kiekarite katiniwaru'irɨwiya wahamatɨa 'ukahuputɨ,","poem":1},{"text":"meta nuiwarite wakewaiyatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Ne nematsi'aye'unietɨ 'ena nekaniuweni","poem":1},"—Yawé Naimekɨmɨtɨrɨkaɨye mɨpaɨ kanaineni—.",{"text":"'Ahɨxie paitɨ 'a'iwi nenitihanimɨkɨ,","poem":1},{"text":"nuiwarite memɨmatsixeiyakɨ kepemɨtimawe,","poem":2},{"lineBreak":true},{"text":"meta te'aitamete 'atewiyarika memɨxeiyakɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mɨkati'itiya nekamanikawirimɨkɨ,","poem":1},{"text":"nepɨmatsitewiyatsitɨani teɨteri wahɨxie nepɨmatsihɨani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yunaitɨ memɨmatsixeiya mekaniyuta'unaxɨakuni,","poem":1},{"text":"mɨpaɨ menitiyuakuni: “Niniwe 'ari kaniuka'unarieni.","poem":2},{"text":"¿Kemɨ'ane puyuhiwerieka hetsiena mieme?”","poem":1},{"text":"¿Hakewa nepeikaxeiya kemɨ'ane minɨtɨani?»","poem":2}]},{"type":"heading","content":["Niniwe yuheyemekɨ kemɨtika'unarieni"]},{"type":"verse","number":8,"content":[{"text":"¿Kamɨtsɨ 'ekɨ matsi 'aixɨa peti'ane keyuri Tewatsi,","poem":1},{"text":"kiekari haa hixɨapa mɨyema,","poem":2},{"lineBreak":true},{"text":"Niru hatɨayari manuyehane 'aurie mukuma,","poem":2},{"text":"haramara hetsiena munua mayeitɨa","poem":1},{"text":"meta haa yukuraru mayeitɨa?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kutsi meta 'Ekipitu mepiparewiekai yemekɨ,","poem":1},{"text":"Puti meta Riwiya meminɨ'ɨ mepɨhɨkɨtɨkai.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mɨyatɨtɨ, Tewatsi kiekariyari kanehanieni 'ateewa,","poem":1},{"text":"'ateewa paitɨ kananutahɨiyani.","poem":2},{"text":"Niwemama mekaniutitetseweiyani","poem":1},{"text":"kaye 'itsikinayaritsie.","poem":2},{"text":"Teɨterimama waɨkawa memeuka'u meniyuta'iwirieni,","poem":1},{"text":"meta mekaniwarutihɨani teɨteri wa'ukiyarima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yaxeikɨata 'ekɨ, Niniwe, pekanititawaimɨkɨ,","poem":1},{"text":"peka'uka'iyaritɨ pekanayeimɨkɨ","poem":2},{"text":"Yaxeikɨata 'ekɨ, mɨmatsi'aye'unie pemakatɨ,","poem":1},{"text":"pekanitiwaumɨkɨ hakewa peme'ati'awieta.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"'Akuraru 'amatitewa piní kanihɨkɨtɨni","poem":1},{"text":"mexɨakame mieme takari mɨkwakwaxi:","poem":2},{"text":"xɨka 'utakatsieni,","poem":1},{"text":"kemɨ'ane mitikwani teta kaneukaxɨrɨweni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Neuxei, kepauka memɨwaraye'unie memɨwatakwinitsie","poem":1},{"text":"'akuyaxima 'ukarawetsixi wahepaɨ mekaniyɨaka.","poem":2},{"text":"'Akwieyaritsie mieme 'ituparite heuyepietɨkaitɨ huhutatɨ kaniyuhayewamɨkɨ,","poem":1},{"text":"karikɨ kɨmana mɨreunamirikekai tai kanitixɨtsitɨamɨkɨ.","poem":2}]},{"type":"heading","content":["Yakɨ xeikɨa kemɨtiukuxeɨri"]},{"type":"verse","number":14,"content":[{"text":"Haa waɨkawa keneuxeɨri kuyaxi 'awarita memaketɨkɨnetsie mieme,","poem":1},{"text":"'akuraru 'akenatitɨriya.","poem":2},{"text":"Haxupa kenekakexi, 'a'ɨkakɨ haxu 'aixɨa keneuyuri","poem":1},{"text":"meta xɨnariya keneutiwewi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mana kwitɨ tai kamenitaxɨtsitɨamɨkɨ","poem":1},{"text":"meta 'ixiparakɨ pekanimieriemɨkɨ,","poem":2},{"lineBreak":true},{"text":"mɨmatsi'aye'unie 'utsika mɨtikɨme hepaɨ kametinikwaimɨkɨ.","poem":2},{"text":"Kene'amɨiriyani 'utsikari wahepaɨ","poem":1},{"text":"meta kene'axiɨtɨaka tekɨmemete wahepaɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tetuayamete 'ahetsɨa miemete pepɨwarutimɨiriyaxɨ","poem":1},{"text":"xurawetsixi wareuyeta meyupaɨmeme","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Matsiparewiwamete 'utsikari wahepaɨ mekani'aneni","poem":1},{"text":"meta 'aparatsiyuta te'uximayatamete, 'etsimemɨtepepe memɨka'u'umeyari wahepaɨ,","poem":2},{"lineBreak":true},{"text":"muhaɨtɨnitsie 'ixumeri 'amɨtɨtɨ hetsie menikayaxikeni,","poem":2},{"text":"matsi tau manatinenitsie mekaniyuta'unani,","poem":1},{"text":"xewitɨtɨma pɨkatimate hakewa memeyuti'awietaxɨa wataxeiyake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"'Atsiriyatsie ti'aitame,","poem":1},{"text":"'amuxatsi wahɨwemete karima meneukutsu,","poem":2},{"lineBreak":true},{"text":"'akuyaxima pemɨwaranayexie meneukutsixɨani.","poem":2},{"text":"'Ateɨterima hɨritetsie meneutaxɨriyaxɨani,","poem":1},{"text":"pumawe xewitɨ muwakuxeɨrienikɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kepemɨtiukakukuine 'uayeyari pumawe,","poem":1},{"text":"'ahaiya pɨkayu'uayemarinɨa.","poem":2},{"lineBreak":true},{"text":"Yunaitɨ memɨtehetimani kepemɨranuyetɨakɨ,","poem":1},{"text":"'ixɨarari mekaniwewikuni ke'axapemɨranuyetɨa hepaɨtsita.","poem":2},{"text":"¿Kemɨ'ane nutsɨ puyuhayewaxɨ katiuka'eniexɨaka","poem":1},{"text":"waɨkawamekɨ 'axamɨti'ane hepaɨtsita? Nixewitɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}