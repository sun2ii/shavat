{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"NEH","translationId":"hch_wb2","name":"Nehemiyaxi","commonName":"Nehemiyaxi","title":"Nehemiyaxi","order":16,"numberOfChapters":13,"sha256":"7fb3c7ee54581907466fff392fa909f840777754afa40b1d99b0b85ea7d74af8","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/NEH/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/hch_wb2/NEH/13.json","totalNumberOfVerses":406},"chapter":{"number":9,"content":[{"type":"heading","content":["'Ixaheritsixi kememɨteyetua 'axakememɨte'uyuri"]},{"type":"verse","number":1,"content":["Xeitewiyari heimana nauka tukariyaritsie mɨkɨ metseriyaritsie mekaniuyukuxeɨrieni 'ixaheritsixi meyuhakienike, hiwerika kamixayari mekananakatɨxɨani meta naxi yumu'utsie meneutiwiwiexɨani."]},{"type":"verse","number":2,"content":["Teewatari wahetsɨari me'ayekɨneka meniuyutihekɨata 'axakememɨte'uyuri yumɨireme wahɨxie meta watewarima ke'axamemɨte'uyuri,"]},{"type":"verse","number":3,"content":["hikɨ yamekaniutiyuani yuhetsie mekatenahɨani. Haika hurayari mekaniuyurieni 'inɨari niukiyari meterɨwatɨ Yawé yukakaɨyari hetsɨa mieme, meta haika hurayari mekaniyuhekɨatakaitɨni ke'axamemɨte'uyuri, 'imatɨrieka hɨxiena mekaniukahɨxima'uni."]},{"type":"verse","number":4,"content":["Hikɨ rewitsixi Ketsuha, Wanihi, Karimieri, Tsewaniyaxi, Wuni, Tserewiyaxi, Wahani meta Kenani wapaitɨ mekaneuti'uni karima mekaniuyutanenewieni Yawé Kakaɨyari mehahɨawetɨ."]},{"type":"verse","number":5,"content":["Rewitsixi Ketsuha, Karimieri, Wanihi, Katsawiniyaxi, Tserewiyaxi, Huriyaxi, Tsewaniyaxi meta Petahiyaxi mɨpaɨ mekaniutiyuani karima:",{"text":"«Hikɨmɨtɨka, Yawé hetsiemieme 'aixɨa xekeneutiyua takakaɨyari","poem":1},{"text":"hikɨ mɨtiyehane meta yareuyuhanemekɨ.","poem":2},{"text":"'Aixɨa peke'itɨarieka Tati'aitɨwame.","poem":1},{"text":"Pekenɨawarieka witsikepemɨ'ane kepemɨtitewa,","poem":2},{"lineBreak":true},{"text":"'aixɨa pɨ'ane pemɨnɨawarieka 'aixɨa pemɨ'itɨariekakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"»'Ekɨ xeikɨa Yawé pepɨhɨkɨ.","poem":1},{"text":"'Ekɨ muyuawi peputawewi,","poem":2},{"text":"naime muyuawi kemɨyewa","poem":1},{"text":"xurawetsixi warexeiyakame.","poem":2},{"text":"'Ekɨ tukari pepɨwapitɨa tita pemɨtiutawewi:","poem":1},{"text":"kwie meta haramara","poem":2},{"text":"yunaime mana memɨtexuawe.","poem":1},{"text":"'Ayumieme xurawetsixi muyuawitsie miemete 'ahɨxie mepukahɨxima'uwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"»'Ekɨ, Yawé meta Kakaɨyari,","poem":1},{"text":"'Apɨrami pemanayexei pepɨhɨkɨ.","poem":2},{"text":"'Ekɨ 'Uxi karireutsixi wakwieyaritsie paitɨ pepiyewitɨ,","poem":1},{"text":"'Apɨrahami pepɨtiterɨwaxɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hetsiena pepikaxei 'iyari heitserie yamɨtikamie","poem":1},{"text":"'ayumieme tɨratu hamatɨana pepuwewi.","poem":2},{"text":"Mɨpaɨ pepɨtitahɨawixɨ kename nuiwarimama","poem":1},{"text":"kananeutsixi wakwie pewayetuirienikekai,","poem":2},{"text":"meta 'etitsixi, 'amuxeutsixi meta peretseutsixi,","poem":1},{"text":"kewutseutsixi, keriketseutsixi wakwie.","poem":2},{"text":"Pepɨraye'atɨa kepemutayɨ","poem":1},{"text":"heitseriemekɨ yapemɨtikamie pemɨhɨkɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"»'Ekipitu tatewarima wa'uximatɨarika pepu'eni,","poem":1},{"text":"Haramara Mɨxeta 'aurie kememɨteyuhiweriekai pepuwaru'eni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mariweme pepɨtiuyuri waɨkawamexɨa","poem":1},{"text":"Parahuni hetsɨa, 'iparewiwametemama meta yunaitɨ teɨteri,","poem":2},{"text":"penieretɨ kememɨtewananaimakai","poem":1},{"text":"'ateɨterima kememɨwayuriekai.","poem":2},{"text":"Mɨpaɨ petiuyurieku","poem":1},{"text":"hikɨ pepukuxaxatsiwa naitsarie.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wahɨxie haramara pepanutayepi,","poem":1},{"text":"mepanukɨ 'ayewakikaku.","poem":2},{"text":"Peru memɨwaruweiyakai","poem":1},{"text":"haramara 'ameukatewatsie pepɨwareukaxɨri,","poem":2},{"lineBreak":true},{"text":"tetexi wahepaɨ tetɨata paitɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Haiwitɨri 'a'uwemekɨ pepɨwaruwitɨximekai tukarikɨ,","poem":1},{"text":"tai 'a'uwemekɨ tɨkarikɨ pepɨwaruwitɨximekai:","poem":2},{"lineBreak":true},{"text":"memuhunikɨ wahuye pepɨhekɨariwiekai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"»Tsinahi hɨriyaritsie pepunua,","poem":1},{"text":"muyuawitsie paitɨ pepuwarutahɨawixɨ.","poem":2},{"text":"Ketitamɨtiheitserie pepɨtiwarutaxatɨa meta 'inɨari niukiyari yuri maine,","poem":1},{"text":"'aitsika 'aixɨa mɨ'anene.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Pepɨwarutaxatɨa Xawati tukariyari mɨpatsie,","poem":1},{"text":"Muitsexi ti'a'uximayatsiriwame mɨhɨkɨtɨkaitsie","poem":2},{"lineBreak":true},{"text":"'aitsika 'inɨari niukiyari pepɨwayetuiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"»Meheuhaakakwikukaku paa muyuawitsie miemekɨ pepɨwarutihuxaitɨa,","poem":1},{"text":"meheuharikukaku pepɨwaruharitɨa haa 'aitsie mieme.","poem":2},{"text":"Kwie pepɨwayetuiri","poem":1},{"text":"pemɨwayetuirienikekai pemainekai.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tatewarima ta'ukiyarima mepuyuta'ɨrixɨ,","poem":1},{"text":"yamemɨtekakɨne mepɨka'uyuwaɨri 'a'aitsika hetsie.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mematsi'enienike mepɨkayuwaɨri,","poem":1},{"text":"mariweme kepemɨtiuyuri","poem":2},{"lineBreak":true},{"text":"wahetsiemieme mepɨkahaye'eri.","poem":2},{"text":"Waɨkawa mepɨtsetse'ikai meta mepɨkaheu'enanakai","poem":1},{"text":"'atsita xeime mepanuyeye","poem":2},{"text":"muwarakunuitɨanikɨ 'Ekipitu","poem":1},{"text":"waɨriyarika memɨteha'uximayakaitsie.","poem":2},{"text":"Peru 'ekɨ pepɨkawaruku'eiri","poem":1},{"text":"Kakaɨyari pemɨtareuyehɨwirie pemɨhɨkɨkɨ,","poem":2},{"lineBreak":true},{"text":"pemɨtiuyukakwewimɨkɨ meta pemɨtiuyukanenimaya,","poem":2},{"lineBreak":true},{"text":"haxɨakɨ pekayumexɨitɨatɨ, peru waɨkawa petiuyukanaki'erietɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"»Tsepa tsikeru memutawewi","poem":1},{"text":"tepɨakɨ wewiyakame,","poem":2},{"text":"mɨpaɨ memutiyua: “'Ikɨ kani'akakaɨyaritɨni","poem":1},{"text":"'Ekipitu matsiyewitɨ”,","poem":2},{"text":"tsepa yemekɨ kwinimieme","poem":1},{"text":"'ahɨxie 'axamemɨte'uyuri,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"'ekɨ pepɨkawaruku'eiri makumawetsie","poem":1},{"text":"'ekɨ kwinimieme pemɨtiuyukanenimayakɨ.","poem":2},{"lineBreak":true},{"text":"»Hatsuaku pɨkawaruku'eiri hai 'amuwekai","poem":1},{"text":"tukarikɨ mɨwaruwitɨximekai huyeta,","poem":2},{"text":"meta pɨkatiuhayewaxɨ wahekɨariwiyatɨ tai 'a'uwemekɨ","poem":1},{"text":"tɨkarikɨ mɨwa'inɨaritɨkai kememɨteheuyune.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"»'A'iyari 'aixɨa mɨ'anekɨ memɨtemaiwawenikɨ pepɨwarupitɨa.","poem":1},{"text":"Manana pepɨkawarunawairi me'ikwakaku,","poem":2},{"lineBreak":true},{"text":"haa pepɨwaruharitɨa memɨkaheuharikunikɨ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Huta tewiyari wiyari makumawetsie pepɨtiwamikwakai.","poem":1},{"text":"Tixaɨtɨ reuyewetɨ pɨkaratɨa wahetsiemieme.","poem":2},{"text":"Wakamixate pɨka'utitsanixɨ","poem":1},{"text":"meta wa'ɨkate pɨka'utihai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"»Pepɨwayetuiri te'aitamete meta kiekari,","poem":1},{"text":"yuxexuime kwie pepɨwaruxatɨa.","poem":2},{"text":"Te'aitamete mepɨwara'iwaxɨ 'Uhuki meta Tsikuni,","poem":1},{"text":"memɨte'aitakai Hetsiwuni kwieyaritsie meta Watsani kwieyaritsie.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Waniwema pepɨwarutimɨiriyaxɨ","poem":1},{"text":"xurawetsixi muyuawitsie miemete wahepaɨ,","poem":2},{"text":"kwietsie pepɨwa'atɨa","poem":1},{"text":"watewarima pemɨwaraxaxatɨwakaitsie.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Waniwema mɨkɨ kwieyaritsie mepu'axɨa.","poem":1},{"text":"Wahɨxie pepɨtiwaruta'aitɨa kananeutsixi mana memu'uwakai,","poem":2},{"text":"te'aitamete pepɨwayetuiri meta teɨteri mana kiekatari,","poem":1},{"text":"kemɨtiwanake wahetsie yamemɨteyurienikɨ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kiekarite kuraruyari 'amatitetewa mepɨwara'iwaxɨ meta","poem":1},{"text":"kwie 'aixɨa mɨ'anene,","poem":2},{"text":"kiite yukii mepayeitɨaxɨa piinitɨarika tihɨpɨneme,","poem":1},{"text":"meta putsute muyewawaki, kaxie haraweriyarite meta huriwu,","poem":2},{"lineBreak":true},{"text":"metatsiere waɨkawa 'iteɨrite 'ikwaxi mɨrexeiyatɨka.","poem":2},{"text":"Meteniutikwani meta meniutihuxani metatsiere meniutiwaiyata,","poem":1},{"text":"mepɨteha'inɨataxɨ waɨkawa ke'aixɨa pemɨwaruyuri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"»Peru mekaheu'enanatɨ mepakɨ:","poem":1},{"text":"menetsi'aye'unietɨ mepakɨ,","poem":2},{"lineBreak":true},{"text":"'a'aitsika meputixani'eri,","poem":2},{"text":"'aniukamete 'ahetsɨa miemete mepɨwarukwi","poem":1},{"text":"memɨwa'iniekai memɨ'axɨanikɨ 'ahetsɨa,","poem":2},{"lineBreak":true},{"text":"yemekɨ 'ahɨxie 'axamepɨte'uyuri.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"'Ayumieme memɨwaraye'unie hetsɨa pepɨwayetua,","poem":1},{"text":"mɨkɨta mekaniwaru'uximatɨani.","poem":2},{"text":"'Uximatɨarikatsata memanahiwiwakaitɨni,","poem":1},{"text":"muyuawitsie paitɨ peniwaru'enieni,","poem":2},{"text":"pemɨtiuyukakwewimɨkɨkɨ pekaniwareyenɨ'ani memɨwatawikweitsitɨani","poem":1},{"text":"memɨwaxɨnakɨ memɨwaraye'unie wahetsɨa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Peru kepauka memuxɨnarie,","poem":1},{"text":"yaxeikɨatsiere mepɨteyuriekai,","poem":2},{"text":"'ekɨta pepɨwayetuayakai memɨwaraye'unie wahetsɨa,","poem":1},{"text":"mɨkɨ mekateniwaruta'aitɨwakaitɨni.","poem":2},{"text":"Hekwamekɨ mekameniutahiwiwakaitɨni pemɨwaparewienikɨ,","poem":1},{"text":"hikɨ muyuawitsie paitɨ pekaniwaku'eniwakaitɨni.","poem":2},{"text":"Waɨkawa pemɨwanaki'eriekaikɨ","poem":1},{"text":"mɨixa peniwarutawikweitsitɨani.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Pepɨwaraye'eritɨa 'a'inɨari niukiyaritsie memanuaxɨanikɨ,","poem":1},{"text":"peru mɨkɨ mepuyuta'ɨrixɨ","poem":2},{"lineBreak":true},{"text":"meta 'a'aitsikatsie yamepɨkatekakɨ.","poem":2},{"text":"'Axamepɨte'uyuri 'a'aitsikate hepaɨtsita,","poem":1},{"text":"tukari mɨtiyupitɨwa kemɨ'ane meye'atɨwa.","poem":2},{"text":"Mekaheu'enanatɨ mepɨmatsi'uku'eiri,","poem":1},{"text":"metsetse'itɨ mepayuyeitɨa meta mepɨkayuwaɨri memɨmatsi'enieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"»Mɨixa wiyari pepɨwanewiekai,","poem":1},{"text":"'a'iyarikɨ pepɨwaraye'eritɨwakai","poem":2},{"text":"'aniukamete yame'utiyuanekaku,","poem":1},{"text":"peru mɨkɨ mepɨka'u'enana.","poem":2},{"text":"'Ayumieme pepɨwayetua mɨkɨ","poem":1},{"text":"kwieyaritsie memɨtama wahetsɨa.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Peru 'ekɨ, waɨkawa pemɨtiuyukanenimayakɨ","poem":1},{"text":"pepɨkawarukwi meta pepɨkawaruku'eiri,","poem":2},{"lineBreak":true},{"text":"Kakaɨyari 'aixɨa pemɨtiuka'iyari meta pemɨti'akanenimaya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"»Hikɨta, takakaɨyari,","poem":1},{"text":"Kakaɨyari pemɨmariwe, pemɨmakaxiwa meta pemɨtɨrɨkaɨye,","poem":2},{"lineBreak":true},{"text":"tɨratu pemaye'atɨwa meta yapepɨtikamie,","poem":2},{"text":"'etsiwa tiuyɨme pepɨka'erieka kememɨte'ukwinitɨarie,","poem":1},{"text":"tate'aitɨwamete,","poem":2},{"lineBreak":true},{"text":"kuwexinaruritsixi, mawari wewiwamete meta 'aniukamete,","poem":2},{"text":"ta'ukiyarima meta teyunaitɨ 'ateɨteri,","poem":1},{"text":"te'aitamete 'Atsiriya kiekatari memɨtatsi'a'iwaxɨtsietɨtɨ 'atsita hikɨ.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"'Ekɨ heitserie pepɨtiyurienekai","poem":1},{"lineBreak":true},{"text":"tame kemɨtatiuyuri,","poem":1},{"text":"'ekɨ yapepɨtikatɨa.","poem":2},{"text":"Tame 'apɨta 'axatepɨte'uyuri.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Tate'aitɨwamete meta kuwexinaruritsixi,","poem":1},{"text":"tamawari wewiwamete meta tatewarima,","poem":2},{"text":"'a'inɨari niukiyaritsie yamepɨkatekakɨ","poem":1},{"text":"meta mepɨka'i'eni 'a'aitsikate","poem":2},{"lineBreak":true},{"text":"metatsiere kepemɨtiwaraye'eritɨwakai.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Mɨkɨ, kepauka memɨte'aitakai,","poem":1},{"text":"mepɨka'uyuwaɨri memɨmetsi'ayexeiyani","poem":2},{"lineBreak":true},{"text":"meta mepɨka'uyuwaɨri 'axakememɨteyuriekai memuku'eirienikɨ,","poem":2},{"text":"tsepa waɨkawa petiwarumikutɨtɨ","poem":1},{"text":"meta kwie pewayetuirieku 'ayeukame tiuxuaweriweme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"»'Ayumieme hikɨ waɨriyarika te'uximayatamete tepɨhɨkɨ,","poem":1},{"text":"waɨriyarika te'uximayatamete 'ikɨ kwieyaritsie","poem":2},{"text":"pemɨwayetuiritsie tatewarima","poem":1},{"text":"mana timieme 'ikwaxi memɨtekwakakɨ meta memɨte'ukaxexeiyanikɨ.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Waɨkawa kemɨtiutixuxuawere hikɨ te'aitamete wahetsiemieme katinihɨkɨtɨni","poem":1},{"text":"'axatemɨte'uyurikɨ tahetsie pemɨwarupitɨa.","poem":2},{"text":"Tɨrɨkariya memexeiyakɨ, kemɨtiwanake mepɨtatsiyurie","poem":1},{"text":"tame meta tatewama.","poem":2},{"lineBreak":true},{"text":"Waɨkawa tepu'uximatɨarie.","poem":2}]},{"type":"verse","number":38,"content":["»Naimekɨ mɨkɨkɨ, tame tɨratu tepɨwewieni meta tepɨte'aka'utɨani, kuwexinaruritsixi, rewitsixi meta mawari wewiwamete mepitseyumani»."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/NEH/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/NEH/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/NEH/8.json","previousChapterAudioLinks":{},"numberOfVerses":38}