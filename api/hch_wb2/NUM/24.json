{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"NUM","translationId":"hch_wb2","name":"Kememɨte'uti'inɨatsie","commonName":"Kememɨte'uti'inɨatsie","title":"Kememɨte'uti'inɨatsie","order":4,"numberOfChapters":36,"sha256":"0cbadb41f2f212c619710899846d29a33ed4bffbf471b0f83e2a7675444b4907","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/hch_wb2/NUM/36.json","totalNumberOfVerses":1278},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":["Hikɨ kepaukua Warami mɨpaɨ mɨretima Yawé minakekai 'Ixaheri 'aixɨa muyuriekakɨ, hikɨ pɨkawarukewaiyaxɨ, meripaitɨ hepaɨ, matsi tawarita makumawetsie kaneutaniere."]},{"type":"verse","number":2,"content":["Kepauka Warami meutanierixɨ 'ixaheritsixi kaniwaruxeiya kememɨteheunuiwari mɨpaɨ meteheukuteme, hikɨ Yawé 'iyarieya hetsiena kaninuani,"]},{"type":"verse","number":3,"content":["hikɨ mɨpaɨ kaniutayɨni:",{"text":"«Warami niukieya Wehuxi nu'aya,","poem":1},{"text":"tewi niukieya 'aixɨa mɨti'ane mɨtixeiya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Niukieya mɨ'enie Kakaɨyari kaniniukieyatɨni,","poem":1},{"text":"Naimekɨmɨtɨrɨkaɨye mɨtixeiya,","poem":2},{"lineBreak":true},{"text":"mukakukutsutsie hepaɨ mɨtikuxaxatɨariwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"»Kakuwu, 'axamarute witsipɨ'anene.","poem":1},{"text":"'Ixaheri, witsipɨtiyuxexeiya pemanukatsie.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Aki muyehapane hepaɨ pɨtiyuxexeiya manuyunanake,","poem":1},{"text":"tuturi hatetsita mɨ'iteɨritsie hepaɨ pɨtiyuxexeiya,","poem":2},{"text":"'aruhe 'iteɨriyari Yawé mika'iteɨtaxɨ hepaɨ,","poem":1},{"text":"kariuxa hatetsita mɨti'u hepaɨ pɨ'anene.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Xariteya haa panakayeuriwe,","poem":1},{"text":"'imɨarieya puyutemawie haa waɨkawa mexeiyakɨ.","poem":2},{"text":"Ti'aitame pɨmariwe 'Akaki reuyeta,","poem":1},{"text":"mariwetɨ 'aitsikaya payuyeitɨwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"»Kakaɨyari 'Ekipitu kaniwarayewitɨni","poem":1},{"text":"tuuru tsimaruni mɨtitɨrɨkaɨye hepaɨ.","poem":2},{"text":"'Ixaheri nuiwarite memeye'unie kaniwatikwa'ani,","poem":1},{"text":"wa'umete kanititarani,","poem":2},{"lineBreak":true},{"text":"yu'ɨrɨkɨ kaniwatimɨmɨni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Maye 'uki hepaɨ kanakatutsitani,","poem":1},{"text":"maye 'ukaratsi hepaɨ 'akaniuhupuni:","poem":2},{"lineBreak":true},{"text":"¿kemɨ'ane ka'ukamatɨ piyehaxɨatɨawe?","poem":2},{"text":"'Aixɨa meke'itɨarieka 'aixɨa memɨmatsiyurie.","poem":1},{"text":"'Axameke'itɨarieka 'axamemɨmatsiyurie».","poem":2}]},{"type":"verse","number":10,"content":["Hikɨ Waraki kaniuyeha'ani Warami hepaɨtsita, yumamatetsie heuyɨtɨminatɨ mɨpaɨ katinitahɨawe: —Nekametiniutanɨ'airieni 'axapemɨwayurienikɨ nemɨwaraye'unie, hikɨri hairieka matsi 'aixɨa petiwayurie pɨta."]},{"type":"verse","number":11,"content":["Tsepa hikɨ kenemie 'akie. Ne mɨpaɨ nepɨmarahɨawekai kename nematipitɨanikekai, peru mɨkɨ Yawé pɨkamatiutanaki'eriri."]},{"type":"verse","number":12,"content":["Warami mɨpaɨ katinitahɨawe: —Ne mɨpaɨ nepɨtiwarahɨawekai netsi'iniwamete pemɨwarenɨ'a:"]},{"type":"verse","number":13,"content":["“Tsepa Waraki yuparatsiyu hurukɨ meta pɨratakɨ hɨneme mɨnetiuxatɨa, ne 'aixɨa nepɨkatiuyuriwe meta 'axanepɨkatiuyuriwe, matsi Yawé nekakaɨyari xeikɨa 'aitsikaya kemaine mɨpaɨ nepɨ'aneni. Yawé xeikɨa kemɨneti'aitɨa mɨpaɨ nepɨtiyurieneni”."]},{"type":"verse","number":14,"content":["Hikɨ mexi neka'akunuawe nekie, nepɨmatitaxatɨani 'ikɨ kiekari 'ateɨterima kemɨwayurieni 'uxa'atɨni warie haye'ayu."]},{"type":"heading","content":["Warami naurieka kemɨtiutaxa"]},{"type":"verse","number":15,"content":["Hikɨ Warami mɨpaɨ kaniutayɨni:",{"text":"«Warami niukieya Wehuxi nu'aya,","poem":1},{"text":"tewi 'aixɨa mɨti'ane mɨtixeiya niukieya.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Niukieya mɨ'enie Kakaɨyari kaniniukieyatɨni.","poem":1},{"text":"'Amutewi kemɨtiku'eriwa mɨmate,","poem":2},{"text":"Naimekɨmɨtɨrɨkaɨye mɨtixeiya,","poem":1},{"text":"mukakukutsutsie hepaɨ mɨtikuxaxatɨariwa:","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"»Nekanixeiyani, peru hikɨ 'akuxi hawaikɨ,","poem":1},{"text":"nekanixeiyani, peru 'ahurawa hawaikɨ.","poem":2},{"text":"Kakuwu xuraweya kananatinemɨkɨ,","poem":1},{"text":"xewitɨ ti'aitame 'Ixaheri hetsie kananukukemɨkɨ.","poem":2},{"text":"Muhawi mu'uya kanitapɨnamɨkɨ","poem":1},{"text":"meta Tseti niwemama wamu'ute.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"'Erumi kana'iwariemɨkɨ,","poem":1},{"text":"Tsehixi meye'unie, tipiinieya katinayeimɨkɨ,","poem":2},{"lineBreak":true},{"text":"mexi 'Ixaheri yukuha'aritɨwani, mariwemekɨ mɨtiyurienikɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kakuwu nuiwarieyatsie xewitɨ rayu'iwatɨ kanitinemɨkɨ,","poem":1},{"text":"'Ahixi kiekatari memuyuhayewaxɨ kaniwatayuniyamɨkɨ».","poem":2}]},{"type":"heading","content":["'Imatɨrieka Warami kemɨtiuxa"]},{"type":"verse","number":20,"content":["Warami 'Amareki 'uxeiyaka mɨpaɨ kaniutayɨni:",{"text":"«'Amareki mexɨakame nuiwari kanihɨkɨtɨni,","poem":1},{"text":"peru 'imatɨrieka naitɨ kanika'unariemɨkɨ».","poem":2}]},{"type":"verse","number":21,"content":["Hikɨ Warami kenitsixi waruxeiyaka mɨpaɨ kaniutayɨni:",{"text":"«Tsepa kuraru 'aixɨa 'aneme pemateka","poem":1},{"text":"meta tsepa 'a'itua 'aitsie paitɨ makama,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"'ekɨri Kahini, taipa pekaneyani,","poem":1},{"text":"meta 'Atsiriya kamenanuhanimɨkɨ».","poem":2}]},{"type":"verse","number":23,"content":["Hikɨ Warami mɨpaɨ kaniutayɨni:",{"text":"«Xɨa'ui, ¿kemɨ'anetsɨ kuta pɨtawikweni","poem":1},{"text":"kepauka Kakaɨyari mɨpaɨ mɨtiyurieni?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kanuwate 'amɨpapa kani'axɨakuni Tsipɨre manexɨani,","poem":1},{"text":"'Atsiriya meta 'Ewexi memɨtewakwinitɨanike,","poem":2},{"lineBreak":true},{"text":"mɨkɨ yaxeikɨa mekanika'unariekuni».","poem":2}]},{"type":"verse","number":25,"content":["Mɨpaɨ titaxatɨaka Warami kaneyani yukwiepa paitɨ, yaxeikɨata Waraki yuhuyeta kaneyani."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/NUM/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/NUM/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/NUM/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}