{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"OBA","translationId":"hch_wb2","name":"'Awiriyaxi","commonName":"'Awiriyaxi","title":"'Awiriyaxi","order":31,"numberOfChapters":1,"sha256":"75701c87466bf585e6cad2f84dabb7cdaf80381a40bf982ce55db54c8eb661e8","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/OBA/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/hch_wb2/OBA/1.json","totalNumberOfVerses":21},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["'Awiriyaxi kemɨtiunieritɨarie. 'Erumi kemɨtiuka'unarie 'uyuta'ɨreka ('Awi 1-6 – Ker 49:14-16, 49:9-10) Niuki tepu'eni Yawé hetsɨa mieme, xeime niuki tuayame kaneyenɨ'ani para mɨtiwataxatɨanikɨ naitsarie nuiwarite, mɨpaɨ tiwakɨhɨawetɨ: «Hikɨmɨ, tepayekɨne tekaniwaretakwikuni».",{"lineBreak":true},"Mɨpaɨ kanaineni Yawé naimekɨmɨyɨwe 'Erumi kiekariyaritsie mieme:"]},{"type":"verse","number":2,"content":[{"text":"«Tixaɨtɨ pekatihɨkɨtɨme nekamanayeitɨamɨkɨ nuiwarite watsata,","poem":1},{"text":"waɨkawamekɨ pekani'uxiwe'eriwakamɨkɨ,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"kepemɨtiyuta'ɨre pekaniu'akwamana.","poem":1},{"lineBreak":true},{"text":"'Aita pemɨkiekɨ kwinimieme mutɨtɨtsie,","poem":1},{"text":"'akiita 'ateewa paitɨ pe'akanieretɨ,","poem":2},{"text":"mɨpaɨ pekatini'akuhɨaweni:","poem":1},{"text":"¿Kemɨ'ane 'ena kwiepa pɨnetsi'a'iwa?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Peru tsepanetɨ wapaitɨ pemuwietɨyeika kwixɨ hepaɨ,","poem":1},{"text":"tsepa xurawetsixi watsata paitɨ 'a'itua pemexeiya,","poem":2},{"lineBreak":true},{"text":"mana paitɨ nekamanakahɨamɨkɨ","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":5,"content":[{"text":"Xɨka tenawayamete me'u'axɨani tɨkarikɨ","poem":1},{"text":"mɨkɨ naime mepɨkatenawani,","poem":2},{"text":"naime mepɨkate'anutɨni ketita xeikɨa memɨteheuyehɨwa 'aixɨa mɨti'anene,","poem":1},{"text":"peru 'ekɨri, kehepaɨ petika'unarieni.","poem":2},{"text":"Xɨka 'itsanamete mematsi'utaxeiya,","poem":1},{"text":"mɨkɨ tinaime mepɨkate'anupini.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Peru 'Etsahu kepemɨtiukaxeiyarie,","poem":1},{"text":"tinaime pepɨtiunawatsiyarieri mɨraye'atɨka mɨti'awietsiekai paitɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Memɨmatsiparewie mekamanitaweiyakuni kwie manu'atɨka paitɨ,","poem":1},{"text":"mepɨmate'itaiya mepɨmatsiha'iwa","poem":2},{"lineBreak":true},{"text":"mekamateni'irɨwiyakuni.","poem":2},{"text":"'Ahamatɨa mexatsie memutiyaxikekai","poem":1},{"text":"mɨkɨ mekamanihupiekuni.","poem":2},{"text":"'Erumi 'ari tixaɨtɨ pɨkarexeiya pɨkatimaiwe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"'Iya tukaritsie nepɨwaka'una","poem":1},{"text":"temaiwawemete 'Erumi kwieyaritsie kiekatari,","poem":2},{"lineBreak":true},{"text":"'Etsahu hɨriyaritsie miemete memɨtemaiwawe","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":9,"content":[{"text":"Temani kiekatari, yukukuyamete 'ahetsɨa miemete marikakɨ mekanatixɨrikuni,","poem":1},{"text":"nixewitɨ tewi pɨkayuhayewa","poem":2},{"lineBreak":true},{"text":"'Etsahu yemurieyatsie yunaitɨ mekanikwi'iwakuni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"»'A'iwa Kakuwu kepemɨtiunanaimakɨ,","poem":1},{"text":"pekanitewiyatsitɨariemɨkɨ,","poem":2},{"lineBreak":true},{"text":"meta 'aheyemekɨ pekanikumaweriyariemɨkɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kepauka pemɨyukuxaɨtametaxɨ,","poem":1},{"text":"kepauka 'ateewa kiekatari kuyaximama memɨwarehapa 'ateewa memanutaxɨriyanikɨ,","poem":2},{"text":"kepauka 'ateewa kiekatari Kerutsareme kitenie memeutahaxɨa,","poem":1},{"text":"meta kepauka hetsiena mieme memuyuta'iwaxɨ,","poem":2},{"lineBreak":true},{"text":"'ekɨ 'ana mɨkɨ pekaniwanɨkaitɨni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Pɨkaheuyewekai 'a'iwa hetsiemieme pemutanaweni pe'inanaimatɨ mɨtiuka'eniwakaitsie,","poem":1},{"text":"kepauka waɨkawa mu'uximatɨariekai.","poem":2},{"text":"Pɨkaheuyewekai 'ekɨ pemɨ'atemawieka kepauka","poem":1},{"text":"Kura teɨterimama memakumaweriyarietsie.","poem":2},{"text":"Hawaikɨ pɨkaheuyewekai 'axapemutaineni kepauka 'iya tukaritsie mete'uka'eniwakaku.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Pɨkaheuyewekai pemeutahanikɨ nekiekari kitenie","poem":1},{"text":"kepauka 'iya tukaritsie memɨte'uka'eniwakai.","poem":2},{"text":"Hawaikɨ pɨkaheuyewekai pe'utanawetɨ pemɨwaxeiyanikɨ me'uxiwe'eriwakaku","poem":1},{"text":"meta 'iya tukaritsie mete'uka'eniwakaku.","poem":2},{"text":"Tixaɨtɨ pepɨkatinawanikekai wapiini","poem":1},{"text":"mɨkɨ tukaritsie me'uximatɨariekaku.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Pɨkaheuyewekai 'ekɨ huyeta tsimanuyeyeutsie pemɨwahupieni,","poem":1},{"text":"para memɨyuta'unakai pemɨwakwinikɨ.","poem":2},{"text":"Pɨkaheuyewekai pemɨwayetuani waneneɨkixiwima wahetsɨa","poem":1},{"text":"'iya tukaritsie mete'uka'eniwakaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"»'Ari kanehuraniri Yawé tukarieya meye'atɨanikɨ","poem":1},{"text":"yunaime nuiwarite wahetsiemieme.","poem":2},{"text":"'Erumi, kepemɨtiuyuri, yakatiniyɨmɨkɨ","poem":1},{"text":"'ahetsie katininakeni 'uximatɨarika.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yaxeikɨata 'ixaheritsixi kexemɨte'ukwinixɨ,","poem":1},{"text":"hɨri mɨpatsietsie netekɨxita kexemɨtehanu'i,","poem":2},{"text":"mɨpaɨta yaxeikɨa mekatenenu'ikuni yunaitɨ nuiwarite mukumane mekatehayewatɨ.","poem":1},{"text":"Hikɨ yunaitɨ mehenu'ieme mekanikumawerikuni,","poem":2},{"lineBreak":true},{"text":"hikɨ mɨpaɨ pɨtimatsiɨkɨre kename hatsuaku meka'u'uwakai.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Matsi Tsiyuni hɨriyaritsie wikweitsitɨarika kanitixuawerimɨkɨ, meta kanipatsiekamɨkɨ.","poem":1},{"text":"Kakuwu teɨterimama yupiinitɨarika mepɨtekaxeiya.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kakuwu xiɨyarimama tai kemɨtititaiya mɨpaɨ mekani'anenekuni,","poem":1},{"text":"Kutse hetsɨa miemete, nerɨkwari hepaɨ mepɨ'aneneni,","poem":2},{"text":"peru 'Etsahu xiɨyarimama xatsi hepaɨ mekani'aneneni:","poem":1},{"text":"taikɨ kanitataiyariemɨkɨ,","poem":2},{"text":"mɨpaɨ tiyɨyɨ nixewitɨ 'ayenieretɨ pɨkayuhayewa","poem":1},{"text":"yunaitɨ 'Etsahu hetsɨa miemete».","poem":2},"Yawé yurikɨ mɨpaɨ kaniutayɨni."]},{"type":"heading","content":["Kememɨte'uparewiya Kakaɨyari teɨterimama"]},{"type":"verse","number":19,"content":["Nekexi kiekatari 'Etsahu hɨrieyatsie mekanitiyaxikuni, Tsapexi kiekatarita piritsiteutsixi wakwietsie mekanikuyaxikuni. Meta 'ixaheritsixi 'Epɨrahini meta Tsamariya wakwie kanayeimɨkɨ, Wenikamini xiɨyarimama Karaha kwieyari mekananunakikuni mana memɨtitenikɨ."]},{"type":"verse","number":20,"content":["Memehapanieta, 'ixaheritsixi kuyaxiyari hikɨ kananeutsixi wahamatɨa memu'uwa, Tsareta wakwie kaniye'atɨkaimɨkɨ. Meta Kerutsaremetari, Tseparari memɨtitei, mekaniyuhayewakuni Nekexi kiekariyaritetsie,"]},{"type":"verse","number":21,"content":["memɨtehayu'iwaxɨta mekananutikɨnikuni Tsiyuni hɨriyaritsie paitɨ, 'Etsahu hɨriyaritsie memɨtama memɨtewata'aitɨanikɨ. Meta mana Yawé pɨti'aitametɨni."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/OBA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/JON/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/AMO/9.json","previousChapterAudioLinks":{},"numberOfVerses":21}