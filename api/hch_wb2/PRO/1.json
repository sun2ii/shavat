{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Tsarumuni 'ɨxatsiteya Rawiri nu'aya, 'Ixaheri kwieyaritsie ti'aitame:"]},{"type":"verse","number":2,"content":[{"text":"petimaiwetɨ pemayanikɨ meta 'aixɨa 'anemekɨ pemuyeikanikɨ,","poem":1},{"text":"meta mɨtiuyemate niukieya pemetimaitɨyeikanikɨ,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"mɨtaheitseritɨarienikɨ yamɨtimaikakɨ tita 'aixɨa mɨti'ane tita 'axamɨti'ane,","poem":1},{"text":"heitseriemekɨ yamɨtikamienikɨ hepaɨtsita, heitseriemekɨ 'aixɨa mɨtiyurienenikɨ meta yunaime 'aixɨa mɨtiwaxeiyanikɨ,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'aixɨa 'anemekɨ pɨtiwapitɨa kemɨ'ane 'atsimemɨkatemate, meta temari mete'uyemaitɨ memakɨnekɨ,","poem":1},{"text":"kemɨtiuyurieni hepaɨtsita.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mɨtimaiwe 'ikɨ ke'u'enieni, matsi waɨkawa mɨretimanikɨ,","poem":1},{"text":"matsi heitserie kaneti'enatɨyeimɨkɨ,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"meitimanikɨ tita 'ɨxatsi 'inɨariyari mɨtixata mɨkɨ pɨtimaika,","poem":1},{"text":"temaiwawemete waxatsika mɨkayumainɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yawé 'ayemakatɨ mɨtiuyemaikakɨ kanitsutɨni,","poem":1},{"text":"'atsimemɨkatemate mɨtimaiwenikɨ mɨ'ayumieme mepɨxani'erie meta memɨtaheitseritɨarienikɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Temaikɨ, keneu'eni 'apaapa kemɨmatiku'ɨxatsitɨwa,","poem":1},{"text":"meta 'amaama kemɨmati'ɨkitɨa pepɨkahetɨtɨmaiyani.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mɨpaɨ xɨka yapetikamieni 'amu'utsie witsimɨ'ane pemanakeka hepaɨ pepɨ'aneni,","poem":1},{"text":"meta kuka pematitɨkɨni hepaɨ pepɨ'aneni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Temaikɨ, xɨka 'axateyuruwamete memateku'itaiyani,","poem":1},{"text":"wahamatɨa pepɨkaheyeikani.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Xɨka mɨpaɨ memetehahɨaweni:","poem":1},{"text":"«Kɨmɨ tahamatɨa kenemie.","poem":2},{"text":"Xeime tepuhupieni tsepa 'atsimɨkatiuyuri","poem":1},{"text":"tepeimieni yakɨxeikɨa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tepeitakwani naime 'ayeniereme","poem":1},{"text":"mɨki teukiyata teɨteri kemɨtiwakwa'a hepaɨ,","poem":2},{"text":"yaxeikɨa meukatewatsie meukahɨiya naimitɨ hepaɨ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tetetinawame naime piinitɨarika tetehexeiyatɨ tepakɨne,","poem":1},{"text":"'Ana 'inawari tinaime takiita tekatenitihɨniyakuni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Teyunaitɨ teyutinɨme tepɨtekunawatɨweni,","poem":1},{"text":"tita temɨtenawani teyunaitɨ tahetsiemieme pɨrayeikani».","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Peru neuxei temaikɨ, pepɨkawareu'enieka mɨkɨ.","poem":1},{"text":"'Axamemɨteyurie wahuye keneuku'eiri.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mɨkɨ mepuyuwaɨriya 'axamemɨteyuriekakɨ,","poem":1},{"text":"mekaniyumexɨitɨaka xuriya memɨtayeurienikɨ xeikɨa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Xɨka winiyari 'anutawieni yakɨ xeikɨa pɨrayeika,","poem":1},{"text":"wikixi yunaitɨ me'ixeiyakaku.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Peru mɨkɨ 'axamemɨte'u'iyari yɨkɨmana yutukari mepɨwiniyatɨwe,","poem":1},{"text":"mɨpaɨ mekateniyuka'unakuni.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mɨpaɨ mepɨtetakukuwe kemɨ'ane yuhetsiemieme xeikɨa memutekuwautɨwe,","poem":1},{"text":"mɨpaɨ yutukari mepɨtetatɨmaiya.","poem":2}]},{"type":"heading","content":["Mari'itɨarika mɨtimaiwenikɨ mɨkayuwaɨriya hepaɨtsita"]},{"type":"verse","number":20,"content":[{"text":"Mɨtimaiwenikɨ mɨ'ayumieme 'uka hepaɨ kaye 'utɨa kanahiwani,","poem":1},{"text":"yuwaɨkawatɨ teɨteri memaxuawetsie waɨkawa kanahiwani.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kaye 'itsikinayaritsie waɨkawa mɨranuyekɨkatɨretsie kanahiwani,","poem":1},{"text":"kiekari mɨranutahakitɨretsie yurikɨ katinikuxatani:","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«Xeme temari 'atsixemɨkatehetimaiwawe 'akuxi,","poem":1},{"text":"¿kepaukake xepɨtehayewa mɨyaxeteyurietɨ?","poem":2},{"text":"Xemeta xeteyukatawe'erietɨ xemutiwaweriyarie,","poem":1},{"text":"¿kepaukake xepɨtehayewa xeyutemawietɨ kexemɨte'u'iyarikɨ?","poem":2},{"text":"Xemeta 'atsixemɨkatemate,","poem":1},{"text":"¿kepaukake xepɨtehayewa 'aixɨa mɨti'ane xete'uxiwe'erietɨ?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Xekeneneu'eni kenemɨxerahɨawe,","poem":1},{"text":"ne nepɨnewaɨriya nemɨtixetaxatɨanikɨ 'iyaritsie miemekɨ kenemɨtiyumate netaɨta,","poem":2},{"lineBreak":true},{"text":"yanekatinixepitɨamɨkɨ kenemɨtiku'eriwa yaxemɨtehetimanikɨ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kepauka nemɨxekɨhɨawekaitsie xeme xepɨkanetsi'u'eni,","poem":1},{"text":"kepauka nemɨxe'u'iniwakaitsie nehetsɨa xepɨkahakɨ,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Matsi pɨta naime ne'ɨxatsitɨarika xeputixani'eri,","poem":1},{"text":"meta kenemɨtixeha'imaiyakai xemɨkanetsi'anu'enikɨ,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"'Ayumieme neta 'ana neputanaweni xehetsiemieme,","poem":1},{"text":"kepauka xemɨ'uximatɨariekatsie.","poem":2},{"text":"Ne nepɨhɨkɨtɨni nemutanaweni xehepaɨtsita,","poem":1},{"text":"kepauka marika mɨxe'axenitsie,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"kepauka marika xehetsie munuani 'eka mɨtɨrɨkaɨye hepaɨ","poem":1},{"text":"meta kepauka 'uximatɨarika mɨxe'anuhapani haikɨri kwinimieme mɨtitɨrɨkaɨye hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"»Hikɨ 'ana xekanenitahɨawikuni, peru ne nepɨkaxeta'eiya,","poem":1},{"text":"'ana xepɨnetsitiwauni, peru xepɨkanetsitaxeiya.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Xemɨtemaiwawenikɨ xeputixani'eri","poem":1},{"text":"meta Yawé xe'ayemakatɨ xemɨkahakɨkɨ,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Neniuki ne'ɨxatsi xemɨkahanu'enikɨ,","poem":1},{"text":"kenemɨtixeku'imaiyakai xemɨka'anu'enikɨ,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Tita tewi mɨtiuka'e mɨkɨ katinika'itsanamɨkɨ,","poem":1},{"text":"pɨtitimɨiriya tita yuhetsie mɨtiupitɨa pɨka'ikemakaxɨani,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Kememɨteheuyexɨri meta tita 'atsimemɨkatematekɨ mɨkɨ puwakwini,","poem":1},{"text":"watemawierika tixaɨtɨ mɨkatiyunaki'erie puwareuyehɨani.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Matsi kemɨ'ane mɨnetsi'anu'enieni 'aixɨa 'iyari 'apuyeikani,","poem":1},{"text":"meta tixaɨtɨ pɨkareumakaxeni».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}