{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":["Tsarumuni niukieya kemɨtimaiwekai:",{"text":"Nunutsi mɨtimaiwe yupaapa pɨtemawieritɨa,","poem":1},{"text":"nunutsi mɨkayuwaɨriya teɨteri muwaparewienikɨ yumaama kanihiweritɨaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Tumini 'axa'anemekɨ 'iwariekame nitixaɨtɨkɨ pɨkatiyunaki'erie,","poem":1},{"text":"matsi tewi heitseriemekɨ yamɨtiyuriene pɨkamɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kemɨ'ane heitserie yamɨtiyuriene Yawé pɨka'ihayewa heuhakamɨkɨme,","poem":1},{"text":"peru kemɨ'ane 'axamɨtiyuriene tita mɨreukwaimɨkɨ mɨra'inɨatakɨ pɨka'ipitɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Xɨka pe'a'ɨraxieka tixaɨtɨ pekarexeiyatɨ pepayani,","poem":1},{"text":"xɨka peti'uximayaka waɨkawa perexeiyatɨ pekanayeimɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kemɨ'ane mɨtimaiwe 'itsanaxa katiniuti'utani,","poem":1},{"text":"kemɨ'ane 'itsanaxa mukutsu puyutitewiya 'arike.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tewi heitseriemekɨ yamɨtikamie waɨkawa 'aixɨa kani'itɨarieka,","poem":1},{"text":"'axatiyuruwame witsipɨtikuxata matsi katiniyukananaimaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Heitserie memu'uwakai tewara'eriwatɨ 'aixɨa tepɨ'itɨarie,","poem":1},{"text":"mɨkɨ 'axamemɨte'u'iyarikai kwitɨwa mepatɨmaiyarɨwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kemɨ'ane yu'iyaritsie mɨtimaiwe mɨkɨ yapɨtikamie kemɨti'aitɨarie,","poem":1},{"text":"peru 'axamɨtiyuriene yutemawietɨ meta 'axamɨtiniuki kanika'unariemɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kemɨ'ane heitseriemekɨ 'amuyeika, 'aixɨa 'iyari 'apuyeika,","poem":1},{"text":"'axatiuka'iyaritɨ 'amuyeika teɨteri mepɨtehetimani kemɨtiyuriene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yɨhɨxikɨ yu'iwa putitaxatɨani meta waɨkawa 'uximatɨarika pɨtixuawitɨani,","poem":1},{"text":"'axamɨtiyuriene yutemawietɨ meta 'axamɨtiniuki pɨka'unarieni xeikɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Tewi heitserie 'amuyeika niukieya tukari tiyupitɨwame kanihɨkɨtɨni,","poem":1},{"text":"'axamɨtiuka'iyari witsipɨtiuxaxata peru katiniyukananaimaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"'Uxiwe'erika matsi waɨkawa 'imieri kaninetɨaweni,","poem":1},{"text":"peru naki'eriya naime mɨtareuyehɨwirienikɨ kaniyɨweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mɨtimaiwe teta mɨtimatenikɨ niukiyari payeneika,","poem":1},{"text":"kemɨ'aneta yakɨ xeikɨa mɨtiyuriene kaneuyeweka yuwaritsie mukuweiwanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kemɨ'ane mɨtimaiwe kemɨtimaiwe kani'utani,","poem":1},{"text":"peru 'axamɨtiyuriene yutemawietɨ kemɨtiuxaxata yapauka katinaka'unamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Xiku xikutɨriyaya hetsiena kaninuaka,","poem":1},{"text":"peru tewi tixaɨtɨ mɨkarexeiya hetsiena nitixaɨtɨ pɨkatitanuani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Tewi 'aixɨa mɨtiyuriene tukari kanipitɨariemɨkɨ,","poem":1},{"text":"'axamɨtiuka'iyari 'iwarikaya 'axamɨti'ane katinihɨkɨtɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kemɨ'ane muyuwaɨriya mɨtaheitseritɨarienikɨ tukari kanikaxeiyamɨkɨ,","poem":1},{"text":"kemɨ'ane mɨka'enu'eni mɨkɨ peuyeweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kemɨ'ane 'uxiwe'erika mɨ'awieta mɨkɨ katini'itawani,","poem":1},{"text":"kemɨ'ane mɨkayuwaɨriya muwapariewienikɨ teɨteri hipame wahetsiemieme kananiuweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kemɨ'ane kwinimieme mɨraniuwe, waɨkawa 'axakatinikuyuruwani,","poem":1},{"text":"kemɨ'ane mɨtimaiwe 'atsipɨka'utaine.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Heitseriemekɨ yamɨtikamie niukieya pɨrata mɨ'itiya hepaɨ kani'aneni,","poem":1},{"text":"matsi 'axamɨtiuka'iyari kemɨtiku'eriwa tixaɨtɨkɨ pɨkatiyunaki'erie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Heitserie 'amuyeika niukieya hipame waɨkawa kaniwaparewieka,","poem":1},{"text":"yakɨxeikɨa 'axamemɨteyurie meyutemamawietɨ kememɨteyurie yuwiniyaritsie mekanixɨrɨweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Yawé hetsɨa katinayeneikani waɨkawa mɨrexeiyanikɨ,","poem":1},{"text":"yu'iyaritɨatɨ tixaɨtɨ pɨkara'iwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Mɨkayuwaɨriya teɨteri waparewienike yɨkɨmana puyutemawieritɨa 'axatiyurienetɨ,","poem":1},{"text":"peru mɨtimaiwe puyutemawieritɨa kemɨtiuyematekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"'Axamɨtiuka'iyari ketita mɨtimakaxe, mɨpaɨ yapɨtipitɨarieni,","poem":1},{"text":"tewi heitseriemekɨ 'amuyeika tita mɨreuyehɨwa, mɨkɨ pɨraye'ani hetsienamieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Kepauka wiyeri mumariwe mukuyani pukumawere 'axatiyuruwame,","poem":1},{"text":"peru kemɨ'ane heitseriemekɨ yamɨtikamie yuheyemekɨ pɨtseɨyeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Mɨratsiwi rakwame ratametsie 'axapɨrayurieni meta kɨtsi rahɨxita kemɨtiyukukuine,","poem":1},{"text":"mɨpaɨ kani'aneni mɨyɨ'ɨraxie kemɨ'ane mɨti'aitɨa hepaɨtsita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Kemɨ'ane Yawé mayemakaxe tukari mɨireme kanipitɨariemɨkɨ,","poem":1},{"text":"peru kemɨ'ane 'axamɨtiyuriene tukarieya pɨkamɨire.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Yamemɨtekahu temawierika mekanikaxeiyakuni,","poem":1},{"text":"'axamemɨteyurieta tita memɨtetakwewie pɨkahaye'ani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Yawé huyeyatsie yamemɨtekahu kaniwa'ɨwiyani,","poem":1},{"text":"kaniwaka'unanita 'axamemɨteyurie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Heitserie yamemɨtekahu hatsuaku mepɨkahekaxɨrieni,","poem":1},{"text":"'axamemɨteyurie hatsuaku kwiepa mepɨka'u'uwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Heitserie yamemɨtekahu 'aixɨa 'anemekɨ mepɨtekuxata memɨtemaiwawekɨ,","poem":1},{"text":"peru 'axamemɨteniniuki mepɨkapitɨarie memɨtiniunikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Heitserie 'amemu'uwa witsimepɨte'uniuka,","poem":1},{"text":"peru 'axamemɨteyurie 'axa'anenemekɨ xeikɨa meputiniuka.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/9.json","previousChapterAudioLinks":{},"numberOfVerses":32}