{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"Yawé kaniwa'uxieka memɨteyukwamana,","poem":1},{"text":"peru kemɨ'ane memɨkateyukwamana matsi 'aixɨa katiniwaxeiyani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kemɨ'ane mɨtiyukatawe'erie kaniyutewiyatsitɨamɨkɨ,","poem":1},{"text":"kemɨ'ane mariweme mɨka'ayuyeitɨa, timaiwetɨ payani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Heitserie 'amemu'uwa tita mɨtiheitserie puwaruwitɨxime,","poem":1},{"text":"kemɨ'ane memɨte'itawa wa'itarika puwaka'una.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Xikutɨriya tixaɨtɨ pɨkarayani kepauka 'itsɨkame mɨmariwe hɨxie mɨtaxanetsienitsie,","poem":1},{"text":"peru heitserie 'axɨka'uyeikani mɨkitsata pɨtawikweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Heitseriemekɨ 'amemu'uwa tita mɨtiheitserie puwaruwitɨxime,","poem":1},{"text":"peru 'axamɨti'ane 'axateyuruwamete pɨwarekaxɨrɨwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tita mɨtiheitserie puwawikweitsitɨa heitseriemekɨ yamemɨtekahu,","poem":1},{"text":"peru tita memɨtehiwe'erie 'axateyuruwamete kaniwaranutaxɨrɨwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kepauka 'axatiyuruwame mɨmɨni, pɨmɨnita tita mɨtitakwewiekai,","poem":1},{"text":"meta pɨmɨni kemɨtiku'eriwakai mariwetɨ kemɨrayanikekai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Heitseriemekɨ yamemɨtekahu mepɨwikweitsitɨarie kwaniwemetsata,","poem":1},{"text":"matsi 'axatiyuruwame haweri pɨranuyeyani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"'Axatiyuruwame yutetakɨ yuhepaɨ tewi kanika'unani,","poem":1},{"text":"peru heitseriemekɨ yamemɨtekahu memɨtehakumatekɨ mepuwikwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kepauka heitseriemekɨ muyeika Yawé miparewie, naitɨ kiekari puyutemawie,","poem":1},{"text":"kepauka 'axatiyuruwame mumɨni, waɨkawa temawierika puxuawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Heitseriemekɨ yamemɨtekahu kiekari 'aixɨa mepuyurie,","poem":1},{"text":"peru 'axateyuruwamete yuniukikɨ mepika'una.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yakɨ xeikɨa mɨtiyuriene 'axaputaine yuhepaɨ tewi hepaɨtsita,","poem":1},{"text":"peru kemɨ'ane mɨtimaiwe puyupirenutɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Teɨteri niuki peraixi tinaime mepɨte'axatawawe hipatɨ memɨtemaikakɨ,","poem":1},{"text":"teɨteri 'aixɨa memɨte'u'iyari naime mepɨkatekuxata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ti'aitame xɨka 'aixɨa kati'aitani kiekari kanatiwemɨkɨ,","poem":1},{"text":"'aixɨa mɨtiyɨnikɨ yuwaɨkawatɨ 'ɨxatsitamete mepeuyewetse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kanikweriwa'aneni xeime pemɨka'imate hetsiemieme pemɨre'akatuayanikɨ,","poem":1},{"text":"kemɨ'ane mɨkayuwaɨriya xeime hetsiemieme mɨrayukatuanikɨ 'aixɨa 'iyari kaniuyeikani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"'Ukaratsi 'aixɨa mɨtiuka'iyari 'aixɨa pɨtixeiyarie,","poem":1},{"text":"teɨteri memɨteyukananaima tumini xeikɨa mepɨ'iwaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kemɨ'ane 'aixɨa 'iyarikɨ mɨtiyukanenimaya yɨkɨmana puyuparewie,","poem":1},{"text":"kemɨ'ane 'axamuwayurie hipame mɨkɨta yɨkɨmana 'axapuyuyurie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"'Axatiyuruwame kwamanarikakɨ xeikɨa katina'i'iwani,","poem":1},{"text":"matsi kemɨ'ane heitseriemekɨ yamemɨtekahu wa'iwarika 'aixɨa kani'aneni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kemɨ'ane heitseriemekɨ yamɨtikamie waɨkawa tukari pupitɨarieni,","poem":1},{"text":"kemɨ'ane 'axamɨti'ane mɨranukuwei kwitɨwa pumierieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Yawé puwaxani'erie kemɨ'ane wa'iyari mututuni,","poem":1},{"text":"matsi puyutemawie kemɨ'ane heitseriemekɨ yamemɨtekahu wahetsiemieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"'Axateyuruwamete mepɨkateheuyehɨwiyarieni 'axamemɨte'uyurikɨ,","poem":1},{"text":"peru heitseriekamekɨ yamemɨtekahu mepuyutawikweitsitɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"'Uka witsimɨti'ɨimari matsi kayɨkɨhɨawetɨ mutaniuka,","poem":1},{"text":"huru hanirayari hepaɨ kani'aneni tuixu tsurieyatsie muyewie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Heitseriemekɨ yamemɨtekahu ketita memɨtehiwe'erie 'aixɨa pɨtikuyɨne,","poem":1},{"text":"'axateyuruwamete kememɨteku'eriwa 'axapɨtikuyɨne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Kemɨtiwamikwa waɨkawa yutemawietɨ, mɨkɨ waɨkawa matsi pɨtipitɨarieni,","poem":1},{"text":"matsi hipatɨ kememɨte'apitɨkakɨ xɨka mɨpaɨ mekate'uyutuani matsi kwinimieme haweri me'anenetɨ mepakɨne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Kemɨ'ane tita mɨrexeiyakɨ hipame muwaparewie 'aixɨa pɨ'itɨarie,","poem":1},{"text":"kemɨ'ane hipame muwaparewie mɨkɨta waɨkawa puparewiyani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Kemɨ'ane tɨriku mɨti'awieta yuhetsiemieme mɨkɨ teɨteri 'axameke'utiyuani hepaɨtsitana,","poem":1},{"text":"peru 'aixɨa pɨ'itɨarieni kemɨ'ane 'aixɨa 'iyari mituani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Kemɨ'ane ximeri paitɨ manukukeka 'aixɨa tiyurienike, 'aixɨa ti'aneme pɨtiukaxexeiya,","poem":1},{"text":"kemɨ'ane 'axamɨti'ane mɨtinake, 'axamɨti'ane pɨrenuku'axe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Kemɨ'ane yupiinitɨarikatsie mɨtiwiya kanitayɨnarimɨkɨ,","poem":1},{"text":"matsi heitseriemekɨ yamɨtikamie kɨye mɨyɨra hepaɨ kani'aneni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Kemɨ'ane yukie 'uximatɨarika mɨwiwie tixaɨtɨ 'aixɨa ti'aneme pɨkatikuhayeikawa,","poem":1},{"text":"kemɨ'ane 'axamɨtiyuriene yutemawietɨ xeime mɨtimaiwe ti'uximayatsirietɨ payani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Heitseriemekɨ yamɨtikamie mɨkɨ kɨye tukari tiyupitɨwame hepaɨ kani'aneni.","poem":1},{"text":"Mɨtimaiwe tukari 'aixɨa 'aneme kaniwapitɨaka memeuyexɨrixime.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Heitseriemekɨ yamemɨtekahu 'ena kwiepa yu'iwarika mekanexeiyani,","poem":1},{"text":"matsi waɨkawa yemekɨ mekatenakapitɨariwani 'axateyuruwamete.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/10.json","previousChapterAudioLinks":{},"numberOfVerses":31}