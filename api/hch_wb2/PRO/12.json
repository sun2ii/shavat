{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Kemɨ'ane muyuwaɨriya mɨtita'ɨkitɨarieni puyuwaɨriyata mɨretimanikɨ,","poem":1},{"text":"matsi kemɨ'ane 'ɨkitɨarika mu'uxiwe'erie mɨkɨ pɨka'uka'iyari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Tewi 'aixɨa mɨtiuka'iyari mɨkɨ Yawé piparewie,","poem":1},{"text":"matsi kemɨ'ane 'axamɨtiuka'iyari hetsiena katiniɨhɨpani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Xewitɨ pɨkayɨwe 'axamɨti'ane hetsie tiwiyatɨ 'aixɨa muyukuyurieni,","poem":1},{"text":"matsi heitseriemekɨ yamemɨtekahu wananari 'atsipɨkayɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"'Uka 'inɨari mayuyeitɨwa yɨkɨna pɨtemawieritɨa,","poem":1},{"text":"matsi 'uka tewinɨarika mɨwewie yɨkɨna 'umeteya pɨtixɨtɨaxime.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Teɨteri heitseriemekɨ yamemɨtekahu kememɨteku'eriwa pɨheitserie,","poem":1},{"text":"matsi 'axatiyuruwame 'ɨxatsieyatsie 'itarika xeikɨa puxuawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"'Axateyuruwamete waniuki winiyari mɨmɨɨya pɨhɨkɨ,","poem":1},{"text":"matsi heitseriemekɨ yamemɨtekahu yuniukikɨ hipame mepɨwawikweitsitɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"'Axateyuruwamete mepatixɨrɨwe tawari hatsuaku mepɨka'anuku'uwe,","poem":1},{"text":"matsi heitseriemekɨ yamemɨtekahu waniwema 'amepu'uwani yuheyemekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tewi mɨtimaiwe 'aixɨa pɨtikuxaxatsiwa,","poem":1},{"text":"matsi kemɨ'ane 'aixɨa mɨkatiuka'iyari kanixani'eriwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Matsi 'aixɨa pɨ'ane waɨkawa mɨkarexeiya peru yu'uximayatamete warexeiyatɨ 'amuyeika,","poem":1},{"text":"'aixɨa pɨka'ane kename matiwa 'utaitɨ peru yu'ikwai karexeiyatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tewi heitseriemekɨ yamɨtikamie yapɨtimate yunaime tewaxi wahetsiemieme kememɨte'uka'eniwa,","poem":1},{"text":"matsi 'axatiyuruwame nitixaɨtɨ pɨkatinenimaya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kemɨ'ane yukwietsie mɨti'uximaya mɨkɨ 'anayuhayewame 'ikwai kanexeiyakamɨkɨ,","poem":1},{"text":"kemɨ'ane yakɨxeikɨa mɨti'uximaya yakɨxeikɨa pɨtiyuriene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"'Axateyuruwamete ke'axamemɨteyuriku wawiniyari pɨhɨkɨ xeikɨa,","poem":1},{"text":"matsi heitseriemekɨ yamemɨtekahu wananari 'aixɨa pɨ'itɨarie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kemɨ'ane mɨti'itawa yuniukikɨ pɨyutahɨani,","poem":1},{"text":"matsi heitseriemekɨ yamɨtikamie 'uximatɨarikatsata panukukeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Xewitɨ 'aixɨa kemɨtikuxatakɨ,","poem":1},{"text":"meta yumamakɨ kemɨti'uximayakɨ mɨkɨkɨ pɨtipitɨarieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"'Axamɨtiyuriene yutemawietɨ tsepa kemɨtiyuriene hetsiena mieme 'aixɨa pɨ'ane,","poem":1},{"text":"matsi kemɨ'ane mɨtimaiwe memɨtemaiwawe wa'ɨxatsi pɨta kani'enieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"'Axamɨtiyuriene yutemawietɨ yapauka kaniuyeha'arɨweni,","poem":1},{"text":"matsi mɨtimaiwe katiniukanewieka kepauka 'axamɨtitahɨawarieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kemɨ'ane yurikɨ munierixɨ mɨkɨ heitseriemekɨ katinikuxatani,","poem":1},{"text":"matsi kemɨ'ane mɨka'unierixɨ mɨkɨ 'itarikakɨ pɨtikuxata xeikɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kemɨ'ane 'axamɨtiuxaxata mɨkɨ niukieya 'ixipara hepaɨ pɨtiyuxiteke,","poem":1},{"text":"matsi mɨtimaiwe niukieya pu'uaye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kemɨ'ane yurikɨ mɨtikuxata yuheyemekɨ 'apuyeikani,","poem":1},{"text":"matsi kemɨ'ane mɨti'itawa yatewimekɨ xeikɨa 'apuyeikani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kemɨ'ane 'axamemɨteyurie wa'iyaritsie kwamanarika puxuawe,","poem":1},{"text":"matsi kemɨ'ane 'aixɨa 'iyari temu'uwanikɨ mɨtikuxata mɨkɨ temawierika pexeiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Heitseriemekɨ yamɨtikamie 'axamɨti'ane 'atsipɨka'iyurieni,","poem":1},{"text":"matsi 'axatiyuruwame 'axamɨti'ane pɨrenukanani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Yawé memɨte'itawa puwaxani'erie,","poem":1},{"text":"matsi pɨnaki'a yuri memɨtekuxata wahetsiemieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Tewi mɨtimaiwe yapɨka'utaine tita mɨrakumate,","poem":1},{"text":"matsi memɨkayuwaɨriya teɨteri memuwaparewieni wa'iyari pahiwa tinaime tikuxatanetɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Kemɨ'ane waɨkawa mɨti'uximaya mɨkɨ ti'aitame kanayeitɨariemɨkɨ,","poem":1},{"text":"matsi muyu'ɨraxie waɨriyarika ti'uximayatame payani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"'Uximatɨarikakɨ tewi punutuixie yu'iyaritsie,","poem":1},{"text":"peru niuki 'aixɨa manɨyɨne pitemawieritɨa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Heitseriemekɨ yamɨtikamie yuhepaɨ tewi kaniuwitɨximeni 'aixɨa 'anemekɨ,","poem":1},{"text":"matsi 'axatiyuruwame xɨka huyeya 'anukuweiya pɨreuyehɨani xeikɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Kemɨ'ane mɨyɨ'ɨraxie pɨkayɨwe yu'ikwai mɨtikaxeiya,","poem":1},{"text":"matsi kemɨ'ane mɨti'uximaya waɨkawa 'ikwai pɨrexeiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Heitseriemekɨ yamemɨtekahu wahuye tukari maxuawe peutiyune,","poem":1},{"text":"mɨkɨ huyeta mɨɨya pɨkaxuawe.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/11.json","previousChapterAudioLinks":{},"numberOfVerses":28}