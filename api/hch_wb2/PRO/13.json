{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"Nunutsi mɨtimaiwe yupaapa 'ɨxatsieya kani'enieka,","poem":1},{"text":"matsi mɨtiyukatawe'erie kepauka mɨ'ɨxatsitɨarie pɨka'iku'eniwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kemɨ'ane 'aixɨa 'anemekɨ mɨtikuxata, mɨkɨ 'aixɨa 'anemekɨ pɨtiyumikwa,","poem":1},{"text":"kemɨ'ane 'axamemɨte'u'iyari puwanake hipame memuwananaimanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kemɨ'ane mɨyupirenutɨa yutukari kanikweriwayurieka,","poem":1},{"text":"matsi kemɨ'ane kwinimieme mɨtiyuxatsikawie yukɨmana puyuka'una.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mɨyɨ'ɨraxie pɨreuyehɨwa, peru nitixaɨtɨ pɨkatiukaxexeiya,","poem":1},{"text":"kemɨ'ane mɨti'uximaya naime yu'ikwai pɨrexeiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Heitseriemekɨ yamɨtikamie 'itarika pɨxani'erie,","poem":1},{"text":"'axatiyuruwame tewiyarika pukuwewiene meta 'axamɨramamatiwanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Heitseriemekɨ yamɨtikamie pɨ'ɨwiyarie,","poem":1},{"text":"matsi 'axatiyuruwame 'axamɨti'ane pika'una.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Xewitɨ xiku puyuxata, peru tixaɨtɨ karexeiyatɨ,","poem":1},{"text":"xewitɨ tixaɨtɨ mɨkarexeiya hepaɨ pɨ'ane, peru naime pɨrexeiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Xiku yutuminikɨ xeikɨa yutukari putawikweitsitɨwa,","poem":1},{"text":"matsi tixaɨtɨ mɨkarexeiya xewitɨ pɨkaheye'unie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kemɨ'ane heitseriemekɨ yamemɨtekahu wahekɨariya waɨkawa pɨxawatɨ,","poem":1},{"text":"matsi 'axateyuruwamete kɨxeme mɨtɨtɨki hepaɨ mepɨ'anene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Teɨteri memɨteyukatawe'erie mekaniyukwitɨweni xeikɨa,","poem":1},{"text":"matsi kemɨ'ane 'ɨxatsi memɨ'enie mɨkɨ mekatenimaiwaweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Tumini mexɨiwa mayu'i'iwa yapaukata kanitixɨrɨweni,","poem":1},{"text":"kemɨ'ane tumini meuta'ɨwiyawe, mɨkɨ 'axɨkai xiku kanayeimɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kepemɨtiku'eriwa xɨka yakatiuyunake mɨkɨ 'iyari pɨhiweritɨawe,","poem":1},{"text":"kepemɨtiku'eriwa xɨka yatiuyunake mɨkɨ kɨye tukari tiyupitɨwame hepaɨ pɨ'ane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kemɨ'ane 'ɨxatsi mɨka'anu'enieni pɨkareuyehɨwiyarieni,","poem":1},{"text":"kemɨ'ane 'aitsika kemainetsie yamɨtikayani 'aixɨa 'anemekɨ pɨrakapitɨarieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Memɨtemaiwawe wa'ɨkitɨarika mɨkɨ haa tukari mɨtiyupitɨwa hepaɨ pɨ'ane,","poem":1},{"text":"meta winiyari mɨtiyumemiwatsata pɨtiyuwikweitsitɨwame.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kemɨ'ane 'ɨxatsi 'aixɨa 'aneme mukuxata, mɨkɨ 'aixɨa pɨtikuxaxatsiwa,","poem":1},{"text":"matsi 'axamɨtiuka'iyari huyeya yuheyemekɨ pɨkayupata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mɨtimaiwe puyuwaɨriya 'aixɨa mɨtiyurienikɨ yatimaitɨ tita mɨtiheitserie,","poem":1},{"text":"matsi mɨkayɨwaɨriya mɨwaparewienikɨ kemɨtiyɨkɨhɨawe xeikɨa pɨtiyuriene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Tupiri 'axamɨtiuka'iyari niuki 'axa'aneneme xeikɨa pɨ'atɨwa,","poem":1},{"text":"tupiri 'aixɨa mɨtiuka'iyari 'aixɨa ti'aneneme pɨti'atɨwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kemɨ'ane 'ɨkitɨarika mɨka'anu'enieni tixaɨtɨ karexeiyatɨ payani meta tewiyatsitɨarietɨ,","poem":1},{"text":"matsi kemɨ'ane manu'ena waɨkawa 'aixɨa pɨrahɨawarɨwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kepauka yamɨraye'ani ketemɨteku'eriwa 'ana tepuyutemamawie,","poem":1},{"text":"matsi mɨkayuwaɨriya hetsiemieme pukwaniwe 'axamɨti'ane mɨtihayewakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kemɨ'ane memɨtemaiwawe wahamatɨa 'amuyeika, timaiwetɨ kanayeimɨkɨ wahepaɨ,","poem":1},{"text":"kemɨ'ane memɨkayuwaɨriya wahamatɨa 'amuyeika 'axa'anemɨtsie kaniyukakemɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"'Axatiyuruwame 'axamɨti'ane hetsiena kaniye'axeni,","poem":1},{"text":"matsi heitseriemekɨ yamɨtikamie 'aixɨa mɨti'anekɨ 'apɨrapiniyarieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Tewi 'aixɨa mɨtiuka'iyari yuteukarima piinitɨarika pɨtiwaku'e'eiririwa,","poem":1},{"text":"'axatiyuruwame piinitɨarikaya mɨkɨ heitseriemekɨ yamemɨtekahu wahetsiemieme pɨta katinayeimɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Teɨteri tixaɨtɨ memɨkateheuxeiya memati'etsatsie waɨkawa 'ikwai kanixuaweni,","poem":1},{"text":"matsi naitɨ katineuyewautseni xɨka kemɨtiheitserie mekate'uyurieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Kemɨ'ane yuniwe mɨkati'ɨkitɨa ka'enayewayatɨ mɨkɨ pɨka'inaki'erie,","poem":1},{"text":"matsi xɨka 'ikuwayani ti'ɨkitɨatɨ mɨkɨ yuniwe pɨnaki'erie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Tewi heitseriemekɨ yamɨtikamie pɨtikwa'a kepaukake mɨtahuxani,","poem":1},{"text":"matsi 'axatiyuruwame heuhaakamɨtɨ 'apuyeikani.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/12.json","previousChapterAudioLinks":{},"numberOfVerses":25}