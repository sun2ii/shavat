{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"'Uka mɨtimaiwe yuniwema 'aixɨa mɨti'anekɨ puwaxewiriya,","poem":1},{"text":"matsi 'uka mɨkatimaiwe, yɨkɨmana puwataweiyaxɨani yuniwema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kemɨ'ane 'aixɨa 'anemekɨ mumie Yawé kanayemakaxeni,","poem":1},{"text":"kemɨ'ane Yawé xani'erietɨ mumie mɨkɨ 'axakatiniyurieneni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"'Axamɨtiyuriene yutemawietɨ yuta'ɨretɨ xeikɨa katinikuxatani,","poem":1},{"text":"matsi mɨtimaiwe kemɨtikuxata puyukweriwayurie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hakewa tuurutsixi kwietsanamete mememawe mana 'iku payewawaki,","poem":1},{"text":"tuurutsixi kwietsanamete watɨrɨkariyakɨ 'itsanari putiwawaɨkare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kemɨ'ane munierixɨ mɨkɨ yurikɨ pɨtikuxata 'itsɨkame hɨxie yapɨtayɨni,","poem":1},{"text":"matsi mɨti'itawa 'itsɨkame hɨxie yuri pɨkatikuxata yakɨ xeikɨa putaineni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kemɨ'ane mɨtiyukatawe'erie mɨtimaiwenikɨ mɨ'ayumieme pukuwaune matsi pɨka'ikaxexeiya,","poem":1},{"text":"matsi kemɨ'ane yamɨtimate tita mɨti'aixɨa hetsiena mieme pɨkakwaniwe mɨtimaiwenikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mɨkayuwaɨriya hamatɨa pepɨka'uyeikani,","poem":1},{"text":"hatsuaku mɨkɨ niukieyatsie tixaɨtɨ pepɨkaretimani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mɨtimaiwe yapɨtimate kemɨtiyurieni ke'anemekɨ mumieni,","poem":1},{"text":"matsi mɨkatimaiwe yukɨmana puyukwamana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"'Axamemɨteyurie meyutemamawietɨ kepauka wahetsie mɨrahɨiwa meputinawe meyuku'imawatɨ,","poem":1},{"text":"matsi memɨtemaiwawe Kakaɨyari 'aixɨa pɨtiwaxeiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ta'iyari yapɨtimate ketemɨte'uka'eniwa","poem":1},{"text":"meta xewitɨ pɨkayɨwe xeime temawierikaya mɨhekɨatani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"'Axatiyuruwame kiiya kanika'unariemɨkɨ,","poem":1},{"text":"matsi heitseriemekɨ yamemɨtekahu wakii 'aixɨa pɨ'itɨarie.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tewi mɨpaɨ pɨtimate kename huye muxuawe naitɨ 'aixɨa 'anene,","poem":1},{"text":"matsi mɨkɨ naitɨ huye mɨki teukiyapa kaneukayuyuneni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Xɨka waɨkawa 'utananeni ra'iyaritsie pɨtiyukukuine,","poem":1},{"text":"matsi temawierika kepauka meu'atɨyani tsuari xeikɨa payeika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mɨka'uka'iyari puyutemawie ke'axamɨtiyuriene hepaɨtsita,","poem":1},{"text":"tewi 'aixɨa mɨtiuka'iyari puyutemawie 'aixɨa mɨtiyurienekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Tewi 'atsimɨkatimate kemɨreuyewetse naime yuri pɨrayeitɨwa,","poem":1},{"text":"matsi mɨtimaiwe kaniyɨ'ɨwiyani kemɨtimie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mɨtimaiwe Yawé kanayemakaxeni 'ayumieme kaniyɨ'ɨwiyani 'axamɨti'ane hepaɨtsita,","poem":1},{"text":"matsi mɨkayuwaɨriya puyuta'ɨre meta puyuwaɨriya mɨpaɨ 'utaitɨ nenekaniyɨweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kemɨ'ane mayu'eriya yapauka 'axapɨtiyurieni 'atsikatimaitɨ,","poem":1},{"text":"matsi kemɨ'ane mɨtimaiwe mɨkɨ pɨtiukanewie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"'Atsimemɨkatemate kemɨreuyewetse yamemɨteyurienikɨ wa'imikieri 'axamɨti'anene pɨrayani,","poem":1},{"text":"matsi memɨtemaiwawe mepɨpitɨarie metemaiwawetɨ kemɨreuyewetse memumatsiɨkɨnikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"'Axateyuruwamete 'aixɨa memɨte'u'iyari wahɨxie mekanikatunuma'uikuni,","poem":1},{"text":"'axamemɨte'u'iyari mekanitihɨxima'uikuni heitseriemekɨ yamemɨtekahu wakitenietsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kemɨ'ane tixaɨtɨ mɨkarexeiya hamikumamatɨtɨ mekani'uxiwe'erieka,","poem":1},{"text":"matsi mekaniyumɨireni xiku memɨnaki'erie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"'Axapɨtiyurieneni xɨka yuhepaɨ tewi 'uxieka,","poem":1},{"text":"'aixɨa pɨ'itɨarieka kemɨ'ane tixaɨtɨ memɨkatehexeiya mɨwanenimaya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Kemɨ'ane 'axamemɨteyuriku mepeiyehɨani huye 'aixɨa mɨ'ane,","poem":1},{"text":"matsi naki'eriya meta tita yuri mɨraine mepukaxexeiya kemɨ'ane 'aixɨa memɨteyurie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Naime 'uximayatsikatsie 'ikwaxi puxuawe","poem":1},{"text":"matsi xɨka yakɨxeikɨa tikuxatani tixaɨtɨ karexeiyatɨ payani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Mɨtimaiwe pumatsiɨkɨ yatimaitɨ tita mɨreuyewetse yamɨtiyurienikɨ,","poem":1},{"text":"memɨka'u'iyari mepumatsiɨkɨ kememɨterukutsixikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Kemɨ'ane yurikɨ munierixɨ pɨtikuxata 'itsɨkate wahɨxie hipame wawikweitsitɨatɨ,","poem":1},{"text":"matsi kemɨ'ane ka'uniereka yamɨtikuxata 'atsimɨkatiuyuri kanimierinɨamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Kemɨ'ane Yawé mayemakaxe mɨkɨ yuhetsie nunuwame pexeiya","poem":1},{"text":"meta tɨɨriyamama mepɨ'ɨwiyarieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Kemɨ'ane Yawé mayemakaxe mɨkɨ tukari pupitɨarie 'anayuhayewame,","poem":1},{"text":"meta mɨki winiyariyaritsie kaniutawikweweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ti'aitame teɨteri yuwaɨkawame wahetsie ti'aitatɨ pumariwe,","poem":1},{"text":"ti'aitame kawarexeiyatɨ kemɨ'ane mɨtiwaruta'aitɨani pɨtewiyatsitɨarieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Kemɨ'ane mɨka'ayu'eriya pɨmatsiɨkɨ waɨkawa kemɨtimaiwe,","poem":1},{"text":"matsi yapauka mayu'eriya pɨmatsiɨkɨ ke'axamɨtiyurie yutemawietɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Xɨka yu'iyaritsie 'aixɨa tiyɨkɨhɨaweni 'aixɨa pɨreu'erieka yuwaiyaritsie,","poem":1},{"text":"matsi 'uxiwe'erika naime 'umete pɨtixɨtɨaxime.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Kemɨ'ane tixaɨtɨ mɨkarexeiya mɨnanaima mɨkɨ Kakaɨyari pɨnanaima kemɨ'ane mitawewi,","poem":1},{"text":"matsi tixaɨtɨ mɨkarexeiya mɨnenimaya mɨkɨ Kakaɨyari hepaɨtsita 'aixɨa pɨtiyukɨhɨawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"'Axatiyuruwame kanekawautseni yukɨmana 'axatiyurienetɨ,","poem":1},{"text":"kemɨ'ane heitseriemekɨ yamɨtikamie tsepa mɨmɨxime pɨ'ɨwiyarieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Memɨtemaiwawe yu'iyaritsie kememɨte'uyemate pɨtihɨpɨne,","poem":1},{"text":"matsi memɨkayuwaɨriya 'etsiwatɨma mepɨka'imate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Kepauka teɨteri heitseriemekɨ yamemɨtekahu kiekari mariwetɨ payeika,","poem":1},{"text":"matsi kepauka teɨteri 'axamemɨteyurie naime kiekari mepɨtewiyatsitɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Kemɨ'ane mɨtimaiwe ti'aitame pɨtemawieritɨa yu'uximayatsikakɨ,","poem":1},{"text":"matsi ti'aitame pɨha'a ti'uximayatameya yamɨkatikamiekɨ mitewiyatsitɨakɨ.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/13.json","previousChapterAudioLinks":{},"numberOfVerses":35}