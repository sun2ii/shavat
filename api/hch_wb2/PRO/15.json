{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"Niuki heitserie 'aixɨa manɨyɨne haxɨa pukuxeriya,","poem":1},{"text":"matsi niuki mɨxɨka waɨkawa haxɨa kanayeitɨwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Memɨtemaiwawe metekuxatakaku hipatɨ waɨkawa mepɨtehetimamateke,","poem":1},{"text":"mɨkayuwaɨriya teɨteri muwaparewienikɨ yakɨ xeikɨa katinikuxatani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yawé naitsarie puyeika tanieretɨ,","poem":1},{"text":"waxeiyatɨ 'aixɨa memɨte'u'iyari meta 'axamemɨteyurie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Niuki mɨtiyɨnɨtɨwa mɨkɨ ra'iyaritsie tukari tiyupitɨwame kanihɨkɨtɨni,","poem":1},{"text":"matsi niuki 'axamanɨyɨne 'iyari pɨhiweritɨawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"'Axamɨtiyuriene yutemawietɨ panati'ewa paapaya 'i'ɨxatsitɨakaku,","poem":1},{"text":"katinimaiweni kemɨ'ane mɨyɨ'ɨxatsitɨarinɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Heitseriemekɨ yamɨtikamie kiena 'ikwai panayuhayewa,","poem":1},{"text":"matsi 'axamɨtiuka'iyari kie 'uximatɨarika waɨkawa puxuawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Memɨtemaiwawe metekuxatakaku hipatɨta metemaitɨ mepakɨka,","poem":1},{"text":"memɨkayuwaɨriya hipame memuwaparewienikɨ wa'iyari 'etsiwatɨma mɨpaɨ pɨkatiku'eriwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yawé 'axateyuruwamete wamawari kani'uxiwe'erieka,","poem":1},{"text":"matsi puyutemawie heitseriemekɨ yamemɨtekahu wanenewierikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yawé 'axateyuruwamete wahuye kani'uxiwe'erieka,","poem":1},{"text":"matsi puwanaki'erie kemɨ'ane tita mɨtiheitserie memɨte'uweiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kemɨ'ane huye 'aixɨa mɨ'ane muku'eirieni waɨkawa katinita'ɨkitɨariemɨkɨ 'anayeweiwatɨ,","poem":1},{"text":"matsi kemɨ'ane mitixani'eri mɨkɨ pumierieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yawé naime katinimaika teukiyapa meta meukatewatsie timieme,","poem":1},{"text":"matsi tewi kemɨtiyɨkɨhɨawe yu'iyaritsie mɨkɨ pumate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kemɨ'ane mɨtiyukatawe'erie pɨka'inake mɨta'ɨxatsitɨarienikɨ,","poem":1},{"text":"meta pɨka'inake memɨtemaiwawe mɨwanɨka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"'Iyari xɨka yutemawieka pɨmatsiɨkɨ tahɨxie paitɨ,","poem":1},{"text":"'iyari xɨka tiuka'eniwani yaxeikɨa pɨmatsiɨkɨta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Memɨtemaiwawe mepɨyuwaɨriya matsi waɨkawa memɨte'uyemaikakɨ,","poem":1},{"text":"memɨkayuwaɨriya hipame memuwaparewienikɨ 'axaniuki xeikɨa mepukwa'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Naitɨ tukari 'axapɨ'anene munutuixie hetsiemieme,","poem":1},{"text":"matsi muyutemawie hetsiemieme tukarikɨ 'ixɨarari puxuawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Matsi 'aixɨa pɨ'ane 'etsiwa mɨrexeiyani Yawé 'ayemakatɨ,","poem":1},{"text":"matsi 'aixɨa pɨka'ane waɨkawa mɨrexeiyani tiuka'eniwatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"'Aixɨa pɨ'ane mɨtitsitsiɨrawi xɨka tetekwaka teyunaki'erietɨ,","poem":1},{"text":"'aixɨa pɨka'ane wai xɨka tekwaka teyu'uxiwe'erietɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kemɨ'ane mayu'eriya yapauka payumiewe,","poem":1},{"text":"kemɨ'ane mɨka'ayu'eriya kayuwatɨ puwapitɨa hipame.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Mɨyɨ'ɨraxie huyetana waɨkawa xuya kanixuaweni,","poem":1},{"text":"matsi heitseriemekɨ yamemɨtekahu wahuye 'apatayewa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Temaikɨ mɨtimaiwe yupaapa pɨtemawieritɨa,","poem":1},{"text":"matsi temaikɨ mɨka'uka'iyari yumaama pɨtewiyatsitɨa xeikɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Mɨkatimaiwe puyutemawie yakɨ xeikɨa tiyurienetɨ,","poem":1},{"text":"matsi mɨtimaiwe yuhuye yɨkɨmana pɨheitseritɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Kepauka 'ɨxatsi meuyewetse ketemɨteku'eriwa yapɨkatikɨyɨne,","poem":1},{"text":"kepauka tanaitɨ temuyu'enie teyu'ɨxatsitɨatɨ 'aixɨa pɨtikɨyɨne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Witsipɨ'ane xɨka 'aixɨa 'anemekɨ waku'eiyani,","poem":1},{"text":"meta waɨkawa witsipɨ'ane xɨka 'uta'eiyarieni kepauka meuyewetse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Mɨtimaiwe tukari huyeyari taheima meutiyune 'utɨa pumie,","poem":1},{"text":"mɨki teukiyapa meukahɨiyanikɨ puyutawikweitsitɨwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Yawé memɨyuti'ɨre wakii kaniti'unani,","poem":1},{"text":"matsi wiuraxi wakwie pɨ'ɨwiya kapa me'unawaiyarienikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Yawé kaniwa'uxieka 'axateyuruwamete yakɨ xeikɨa kememɨteku'eriwa,","poem":1},{"text":"matsi pinake niuki mɨheitserie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Kemɨ'ane waɨkawa mɨrexeiyanikɨ mɨtihiwe'erie 'aixɨa pɨka'ane tɨɨriyamama wahetsiemieme,","poem":1},{"text":"matsi tumini mɨka'anu'ɨwe hetsiena mɨraka memɨteheuyehɨwirienikɨ mɨkɨ yuheyemekɨ tukari hexeiyatɨ payani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Heitseriemekɨ yamɨtikamie yapɨtimate yu'iyaritsie kemɨtayɨni,","poem":1},{"text":"matsi 'axamemɨteyurie 'axati'aneme xeikɨa mepɨtekuxata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Yawé 'axateyuruwamete kawa'enietɨ 'ateewa puyeika,","poem":1},{"text":"matsi heitseriemekɨ yamemɨtekahu wanenewieri kani'enieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Kepauka xewitɨ 'aixɨa 'iyari mɨratahɨawe 'ana 'iyari puyutemawieka,","poem":1},{"text":"meta niuki 'aixɨa manɨyɨne tɨrɨkariya pɨtiyupitɨwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Matsi kemɨ'ane 'ɨxatsi mɨ'enie yapɨretimaixime yutukari hetsiemieme,","poem":1},{"text":"'ayumieme memɨtemaiwawe watsata puyeikani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Kemɨ'ane 'ɨxatsi mɨkanaki'erie yɨkɨmana puyunanaimani,","poem":1},{"text":"matsi kemɨ'ane 'ɨxatsi manu'enieni timaiwetɨ payani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Kemɨ'ane Yawé mayemakaxe heitseriemekɨ yapɨtikamie meta pɨtimaiweni,","poem":1},{"text":"kemɨ'ane tixaɨtɨ mɨkarayuyeitɨa 'aixɨa pɨrahɨawarɨwa 'aixɨa mɨtiyurienekɨ.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/14.json","previousChapterAudioLinks":{},"numberOfVerses":33}