{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"Tewi yaputaine kemɨtiyurimɨkɨ,","poem":1},{"text":"matsi Yawé pɨta yapɨtipitɨani kemɨtiyurieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Tewi yapɨtiku'eriwa yuhetsiemieme kemɨtiyurieni kename 'aixɨa ti'ane naitɨ,","poem":1},{"text":"matsi Yawé pimate kehepaɨtɨtɨ mɨtiyuriene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Naime kepemɨtiyurienekɨ Yawé ketineuhɨritɨa,","poem":1},{"text":"kepemɨtiku'eriwa 'ana yapɨtiyɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yawé naime kemɨtiyuriene yatimaitɨ pɨtiyuriene,","poem":1},{"text":"meta 'axatiyuruwame putawewi 'imatɨrieka tukaritsie mutika'eniexɨanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yawé memuyuti'ɨre kaniwa'uxiwe'erieka,","poem":1},{"text":"matsi kaniyuritɨni katinika'eniexɨamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Xeyunaki'erietɨ meta yuri xehaitɨkaitɨ xekateneuyuyehɨwiriekakuni,","poem":1},{"text":"Yawé 'ayemakatɨ xeikɨa pɨyɨwe 'axamɨti'ane mɨnewienikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yawé kepauka tewi 'aixɨa mɨtixeiya hetsienamieme kaniyutemawieka,","poem":1},{"text":"metatsiere memeye'unie 'aixɨa mete'ixeiyakame kaniwarayeitɨaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Matsi 'aixɨa pɨ'ane 'etsiwa mɨrexeiyani heitseriemekɨ yatikamietɨ,","poem":1},{"text":"matsi 'aixɨa pɨka'ane waɨkawa mɨrexeiyani heitseriemekɨ yakatikamietɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tewi yapɨtiku'eriwa kemɨtiyurienikɨ yuhetsiemieme,","poem":1},{"text":"matsi Yawé pɨta heitserie pexeiya mɨpaɨ mɨtiyurienikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ti'aitame Kakaɨyaritsie timieme pɨtikuxata,","poem":1},{"text":"mɨkɨ 'itarikakɨ manutahɨiyanikɨ yapɨkatayɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ti'inɨnɨatamete 'aixɨa mɨ'anene Yawé hetsɨa pumieme,","poem":1},{"text":"naime ti'inɨnɨatamete Kakaɨyari kaninetɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ti'aitame 'axamemɨteyurie kaniwa'uxiwe'erieka,","poem":1},{"text":"karikɨ 'uweni 'aixɨa 'anemekɨ katini'aitametɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ti'aitame kaniyutemawieka mɨkɨ yamemɨtekahu wa'enietɨ,","poem":1},{"text":"kemɨ'ane yurikɨ mɨtikuxata pɨnaki'erie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ti'aitame haxɨaya katiniyumemiwani,","poem":1},{"text":"matsi kemɨ'ane mɨtimaiwe kaniyɨweni minɨtɨanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ti'aitame xɨka 'aixɨa 'anemekɨ ratahɨawe putukari,","poem":1},{"text":"parewiyaya 'imikieri mɨraye'axe hepaɨ kani'aneni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Matsi mɨtimaiwenikɨ mɨ'ayumieme katinaye'aka keyuri huru,","poem":1},{"text":"meta katinaye'aka mɨtiuyemaikakɨ keyuri pɨrata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kemɨ'ane heitseriemekɨ yamɨtikamie huyetana 'axamɨti'ane pɨtiumawe,","poem":1},{"text":"kemɨ'ane yutukari mɨwikweitsitɨamɨkɨ, kaniyɨ'ɨwiyani kemɨtimie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kemɨ'ane mɨtiyukatawe'erie tiyu'uname hetsiena pɨye'ani,","poem":1},{"text":"kemɨ'ane muyuta'ɨre pekaweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"'Aixɨa pɨ'ane xɨka haweri memɨ'anene wahamatɨa tixaɨtɨ katihɨkɨtɨni,","poem":1},{"text":"keyuri memuyuti'ɨre wahamatɨa pemɨxikutɨnikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kemɨ'ane niuki meti'enietɨyeika, 'aixɨa ti'aneme pɨtiukaxexeiya,","poem":1},{"text":"meta 'aixɨa pɨ'itɨarie kemɨ'ane Yawé hetsie mɨtiwiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kemɨ'ane mɨtimaiwe mɨtiuyemate katinitewaka,","poem":1},{"text":"kemɨ'ane witsi'anemekɨ mɨtikuxata 'aixɨa pɨti'enierie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Haa muhane hepaɨ mekani'aneneni kemɨ'ane kememɨteyuriekɨ 'aixɨa memɨtehakumate,","poem":1},{"text":"'axamemɨteyurie meyutemamawietɨ pɨkayɨwe mɨtiwaruti'ɨkitɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Kemɨ'ane 'aixɨa mɨtiyukɨhɨawe kaniyɨweni yuneni mupirenutɨani,","poem":1},{"text":"yunenikɨ kemɨtiyuriene naime katinimaika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Mutiyukanaki'erie niukieya xiete hepaɨ kana'aneni,","poem":1},{"text":"'atukari 'aixɨa kaniyurieka meta 'awaiyaritsie 'aixɨa pekatineu'erieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Teɨteri kememɨteyurie 'aixɨa ti'aneme mepɨte'erie,","poem":1},{"text":"matsi mɨkɨ huye mɨki teukiyapa kaneukayuneni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Kemɨ'ane yehaakamɨnetɨ 'amuyeika haaka waɨriyarika pipitɨa mɨti'uximayakakɨ,","poem":1},{"text":"kemɨtiyehaakamɨnekɨ waɨriyarika pɨti'uximaya mɨtikwanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Mɨka'uka'iyari pɨhɨne 'axamɨti'anekɨ huxunu hepaɨ,","poem":1},{"text":"meta 'axamɨraniuwe tai hepaɨ katiniyutaiyani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Kemɨ'ane 'axamɨtiuka'iyari 'imieri pawiwiwe,","poem":1},{"text":"niukiperai kaniwataxɨrɨwani 'aixɨa memɨteyuku'eriya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Mayu'eriya yuhepaɨ tewi kanikwamanani,","poem":1},{"text":"kani'inieka xeikɨa yuhuyeta 'axakemɨtiyurienetsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Kemɨ'ane yuhɨxikɨ 'inɨari metsiwewirie mɨkɨ 'axametsiyurimɨtɨ pɨyɨane,","poem":1},{"text":"kemɨ'ane mita'atse 'ariri mɨkɨ 'axakatiniuyurieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Mutuxaiya kuruna kanihɨkɨtɨni 'aixɨa kemɨtixeiyariekakɨ,","poem":1},{"text":"'aixɨa 'anemekɨ 'uyeikatɨ kane'iwamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Matsi 'aixɨa pɨ'ane petiukanewietɨ keyuri pera'a'iwamɨtɨ,","poem":1},{"text":"matsi 'ekɨ 'a'iyari kenenɨtɨaweni keyuri kiekarite peka'a'iwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Teɨteri kememɨteyurienikɨ yamepɨtekuwaɨtɨwe,","poem":1},{"text":"matsi Yawé pɨta yapɨtikuyuruwa.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/15.json","previousChapterAudioLinks":{},"numberOfVerses":33}