{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"'Aixɨa pɨ'ane matsi kayuwatɨ temu'uwanikɨ tsepa paa tsetse'ime temukwa'a,","poem":1},{"text":"keyuri temuyukwitɨweni 'ixɨarari tewewietɨwetɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ti'uximayatame mɨtimaiwe yukutsiyari nu'aya mɨkayukatewiya pɨtita'aitɨani,","poem":1},{"text":"hikɨ mɨkɨta pɨtiyetuiriyarieni tita mɨtipiinieyatɨkai yukutsiyari niwemama wahamatɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tai kwinimieme mɨtixɨkakɨ huru meta pɨrata kanikwaxiyarieka huxunuta,","poem":1},{"text":"matsi ta'iyari Yawé pɨta kani'inɨatani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"'Axatiyuruwame yuhepaɨ 'axatiyuruwame kani'enieka,","poem":1},{"text":"mɨti'itawa yuhepaɨ mɨti'itawa kani'enieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kemɨ'ane tixaɨtɨ mɨkarexeiya muyuriya mɨkɨ Kakaɨyari mitawewi kani'uxiwe'erieka,","poem":1},{"text":"kemɨ'ane muyutemawie 'ixeiyatɨ tiuka'eniwame mɨkɨ pɨkareuyehɨwiyarieni pu'uximatɨarieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"'Ukiratsi teukarimama kurunaya mekanihɨkɨtɨni,","poem":1},{"text":"tɨɨri yupaapama wahekɨ mepuyuti'ɨre.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"'Aixɨa pɨka'ane mɨka'uka'iyari 'aixɨa mɨtikuxatani,","poem":1},{"text":"yaxeikɨa 'aixɨa pɨka'ane ti'aitame mɨtiku'itawanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kemɨ'ane tumini mɨwata'ɨitɨwa 'awie yamemɨteyurienikɨ hipatɨ kemɨtinake,","poem":1},{"text":"mɨkɨ 'itsɨ mariweme makwe'e puyu'erie,","poem":2},{"text":"matsi mɨkɨ kemɨtiyuriene naitɨ yapɨtikɨyɨne.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kemɨ'ane mɨreiyehɨwirie 'axamutayɨ mɨkɨ naki'eriya pukaxexeiya,","poem":1},{"text":"kemɨ'ane 'axamɨraniuwe kareiyehɨwirietɨ hamiku pɨkahexeiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kemɨ'ane mɨtimaiwe xeiniukiyarikɨ peu'ena,","poem":1},{"text":"mɨka'uka'iyarita tsepa xeitsienituyarimexɨa muweiya mɨkɨ pɨka'anu'ena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kemɨ'ane mayu'eriya kemɨ'ane mɨtamieni kanikuwauneni,","poem":1},{"text":"peru xeime panɨnɨ'aiyarieni matsi waɨkawa mɨtɨrɨkaɨye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"'Aixɨa pɨ'ane hutse xɨka 'anukunake mayu'eriya yuniwema munawaiyarie,","poem":1},{"text":"keyuri 'atsimɨkatimate xɨka ranukunake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kemɨ'ane 'aixɨa tixeiyarietɨ 'axamɨti'anekɨ mɨtiwarakapitɨwa,","poem":1},{"text":"yuheyemekɨ tɨɨriyamama 'axamepɨ'itɨarieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Xɨka 'imieri 'utsutɨani haa manutanama manuta'una hepaɨ pɨtikɨyɨne,","poem":1},{"text":"matsi 'aixɨa pɨ'ane mɨtihayewani 'axatiyurienetɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Yawé 'ikɨ hutame pu'uxiwe'erie:","poem":1},{"text":"hetsiena mɨrahɨiwa xɨka 'uxɨnarieni 'aixɨa pɨka'ane","poem":2},{"lineBreak":true},{"text":"hetsiena mɨkarahɨiwa pɨta xɨka 'anutahɨiyani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mɨka'uka'iyari xɨka 'atsikatimaika tsepa tumini mexeiya,","poem":1},{"text":"pɨkayɨweni mɨtimaiwenikɨ mɨ'ayumieme mɨnanenikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Hamiku yuheyemekɨ pɨtiuyukanaki'erie,","poem":1},{"text":"kepauka 'uximatɨarika mexeiyanitsie yu'iwa hepaɨ pɨtimaika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Tewi mɨkatimaiwe yapɨtayɨni xeime hetsiemieme mɨrayukatuanikɨ,","poem":1},{"text":"mɨkɨ xeime hetsiemieme rapitɨ payeika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kemɨ'ane minake 'axamɨtiyurienenikɨ mɨkɨ kaninakeni muyutamienikɨ,","poem":1},{"text":"kemɨ'ane kwinimieme mɨraniuwe tenieya manutatsanarienikɨ kanikuwaneni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kemɨ'ane mɨtiyukwamana hatsuaku 'aixɨa 'itɨarietɨ pɨka'ayani,","poem":1},{"text":"kemɨ'ane mɨti'itawa tsiepɨre hetsiena katinahɨiwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kemɨ'ane temaikɨ katiyu'aitɨarinɨakame mexeiya mɨkɨ pɨrahiweritɨaka,","poem":1},{"text":"xɨka mɨpaɨ 'anekame hexeiyani temawierika pɨka'ukaxeiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Waɨkawa yu'iyaritsie xɨka yutemawieka 'uaye hepaɨ kani'aneni,","poem":1},{"text":"kepauka pemɨkayutemawieka 'awaiyaritsieta pepuwerani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"'Axateyuruwamete tumini memɨnaki'erie tixaɨtɨkɨ 'awie yameteyurienike,","poem":1},{"text":"'itsɨkate niuki tutunime xeikɨa mekani'enieka tumini memanɨ'ɨwekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Kemɨ'ane mɨtimaiwenikɨ mɨ'ayumieme mexeiya waɨkawa kaninaki'erieka,","poem":1},{"text":"mɨkayuwaɨriya hipame muwaparewienikɨ 'atsipɨkatimate ketita mɨreuyehɨwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Temaikɨ mɨka'uka'iyari yupaapa xeikɨa pɨhaxɨatɨwame,","poem":1},{"text":"yaxeikɨata yumaama kani'uximatɨaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"'Aixɨa mɨtiuka'iyari xɨka 'anutahɨani 'aixɨa pɨka'ane,","poem":1},{"text":"yaxeikɨata 'aixɨa pɨka'ane 'aixɨa mɨtiuka'iyari xɨka 'ukuwaxɨani heitseriekamekɨ 'amuyeikakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Kemɨ'ane mɨtimaiwe 'etsiwa xeikɨa pɨtikuxata,","poem":1},{"text":"kemɨ'ane mɨtiuyemate mɨkɨ yapauka yuhetsie pɨkatikupitɨwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Matsi 'axamɨtiyuriene yutemawietɨ timaiwetɨ payani xɨka kayuwatɨ tiuyerɨni,","poem":1},{"text":"xɨka tiuhayewa yutetakɨ matsi timatetɨ pɨ'eriwani tsepa 'atsimɨkatimate.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/16.json","previousChapterAudioLinks":{},"numberOfVerses":28}