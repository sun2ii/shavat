{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":[{"text":"Kemɨ'ane yuxaɨtame xeikɨa mayu'eriwa yuhetsiemieme xeikɨa pɨtikuwaune,","poem":1},{"text":"naime 'ɨxatsi 'aixɨa mɨ'ane hepaɨtsita puyeha'arɨwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mɨkayuwaɨriya teɨteri muwaparewienikɨ pɨka'inake meitimaitɨyeikanikɨ,","poem":1},{"text":"pinake xeikɨa 'etsiwa kemɨtiuyemate mɨtikuxatani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"'Axamɨtiuka'iyari 'axapɨraxaxatsiwa xeikɨa,","poem":1},{"text":"tewinɨarikaya xeikɨa hetsiena puxuawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tewi mɨtimaiwe niukieya haramara 'amatiyewa 'emeukatewa hepaɨ kani'aneni,","poem":1},{"text":"meta haa 'aki'utɨa muhane hepaɨ kani'aneni kemɨ'ane mɨtimaiwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"'Aixɨa pɨka'ane xɨka hetsiena mɨrahɨiwa 'uxɨna,","poem":1},{"text":"meta 'aixɨa pɨka'ane xɨka heitserie mexeiya hetsie pɨta rahɨiwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mɨkayuwaɨriya teɨteri muwaparewienikɨ 'axa'anemekɨ xeikɨa putaniuka,","poem":1},{"text":"yutetakɨ xeikɨa 'axaputaine mɨtamierienikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tewi kenametimate mutaine mɨkɨ yuwiniyaritsie puyutahɨani,","poem":1},{"text":"yutenikɨ kemɨtikuxata mɨkɨ yakɨ xeikɨa pɨrayani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"'Axaniuki witsikatini'eniɨriɨkɨni 'aixɨa ma'aneni hepaɨ,","poem":1},{"text":"mɨkɨ rataɨta paitɨ kaniye'axeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kemɨ'ane mɨyɨ'ɨraxie mɨkati'uximaya,","poem":1},{"text":"kaniyutaxewireni xeime mɨraka'una hamatɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yawé kawi 'amutewi hepaɨ kani'aneni,","poem":1},{"text":"hetsɨana mekaniutinanautsani heitseriemekɨ yamemɨtekahu memɨtawikweitsitɨarienikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kiekari mɨtɨrɨkaɨye mukurarutɨarie hepaɨ katinimaika xiku tita waɨkawa mɨrexeiyakɨ,","poem":1},{"text":"meta kuraru 'amatitɨtɨ mɨkayu'unanɨa hetsiena nunuwame kani'erieka kemɨrexeiyakɨ mɨxiku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Muyuta'ɨre yukɨmana kaniyutaxɨtɨamɨkɨ,","poem":1},{"text":"kemɨ'ane tixaɨtɨ mɨkarayuyeitɨa 'aixɨa tixeiyarietɨ kanayeitɨariemɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mɨka'uka'iyari kaniyutewiyatsitɨmɨkɨ,","poem":1},{"text":"xɨka 'aixɨa kati'enawetɨ waruta'eiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Yuwaɨriyatɨ kemɨtiuka'eniwa kananayewemɨkɨ mɨtikuye,","poem":1},{"text":"¿matsi kemɨ'aneta mukayuwaɨriya keranayeweni yuhiwerietɨ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kemɨ'ane mɨtiuyemate yu'iyaritsie katinimaiweni,","poem":1},{"text":"memɨtemaiwawe mɨtiuyemaikakɨ mekanikuwaɨtɨweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"'Imikierikɨ naitsarie kitenietsie katineuyepierikeni,","poem":1},{"text":"meta yaxeikɨa teɨteri memɨmamariwawe yukitenietsie mepɨmeteheuyepirieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"'Itsɨkame hɨxie kemɨ'ane matɨari mieme maniuka kename 'axakatiuyuri 'utaitɨ,","poem":1},{"text":"peru hipatɨta mekani'axɨakuni memunenierixɨ yame'utiyuatɨ kename 'axatiuyuri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kakaɨyari 'imieri mayetɨrɨkaɨye kaneutiparitɨwani,","poem":1},{"text":"'imatɨrieka pɨhekɨare kemɨ'ane heitserie mexeiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Matsi pukwaniwe ta'iwa temɨnɨtɨanikɨ keyuri kiekari naitsata heunatɨkaime,","poem":1},{"text":"kepauka tewi mɨtiyuxaneta tepɨa 'itupari warita mutuika hepaɨ 'aneme kanexeiyani yu'iyaritsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Tewi pɨhɨne tita mɨtikuxatakɨ,","poem":1},{"text":"meta putahuxarɨwa yatikuxatatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Neni tɨrɨkariya kanexeiyani tukari mɨrapitɨanikɨ meta mɨranawairienikɨ,","poem":1},{"text":"'apepɨrapiniyarieni 'atenikɨ kepemutayɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Kemɨ'ane yu'ɨya mukaxei temawierika kanikaxeiyamɨkɨ:","poem":1},{"text":"Yawé 'inaki'erietɨ mɨtiyetuirikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Tixaɨtɨ mɨkarexeiya katiniku'iwawani,","poem":1},{"text":"xikuta kanita'eiyamɨkɨ 'ihekatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Mekanixuaweni hipatɨ hamikutsixi 'axamɨraku'anetsie memumatsi'atɨanikɨ,","poem":1},{"text":"hipatɨta hamikutsixi mekanixuaweni 'aixɨa mete'u'iyaritɨ keyuri 'a'iwa.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}