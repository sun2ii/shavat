{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":[{"text":"Matsi 'aixɨa pɨ'ane tixaɨtɨ karexeiyatɨ peru 'aixɨa tikamietɨ,","poem":1},{"text":"keyuri kayuwaɨriyatɨ teɨteri muwaparewienikɨ meta 'axatiniukitɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"'Aixɨa pɨka'ane pekareutamaiwetɨ xɨka petiutsutɨani,","poem":1},{"text":"kemɨ'ane muyutimexɨitɨani mɨkɨ puyutewinɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tewi mɨka'uka'iyarikɨ 'ayumieme yuhuye peuyehɨpa,","poem":1},{"text":"meta Yawé hetsiemieme puyeha'awe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kemɨ'ane mɨxiku hamikumama mekaniyumɨireni,","poem":1},{"text":"matsi kemɨ'ane tixaɨtɨ mɨkarexeiya hamikuya piku'eiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kemɨ'ane 'uniereme muyuxata tiku'itawatɨ mɨkɨ katinika'enitsitɨariemɨkɨ,","poem":1},{"text":"yaxeikɨata kemɨ'ane mɨti'itawa pɨkareuyehɨwiyarieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Xikutsixi waɨkawa hamikutsixi mekaniwareuxeiyani,","poem":1},{"text":"yunaitɨ teɨteri mekaniwatemawikuni 'etsiwa 'imikierikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kemɨ'ane tixaɨtɨ mɨkarexeiya 'iwamama mekanixani'erieka,","poem":1},{"text":"matsiri hamikumamatɨtɨ mepɨkahenuku'erieni.","poem":2},{"text":"Tsepanetɨ mɨwakuwaune memiparewienikɨ,","poem":1},{"text":"hawaikɨ pɨkawarekaxeiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kemɨ'ane timaitɨ 'amuyeika mɨkɨ yukɨmana yu'iyaritsie kaniyunaki'erieka,","poem":1},{"text":"kemɨ'ane yuhetsie mɨtimaiwe 'aixɨa pɨtiyeyani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kemɨ'ane 'uniereme muyuxata tiku'itawatɨ mɨkɨ katinika'enitsitɨariemɨkɨ,","poem":1},{"text":"kemɨ'aneta mɨti'itawa mɨkɨ kanika'unariemɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mɨkayuwaɨriya hipame muwaparewienikɨ 'aixɨa pɨka'ane witsimɨtiuye'anetsie mayekanikɨ,","poem":1},{"text":"meta 'aixɨa pɨka'ane waɨriyarika mɨti'uximaya te'aitamete memanuyetei mɨtiwata'aitɨanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mɨtimaiwe heitseriemekɨ yakatinikamieni katiniyukanenimayaka,","poem":1},{"text":"matsi witsimɨtiuka'iyari kaninenimayaka kemɨ'ane 'axamiyuri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Maye mahiwa hepaɨ kani'aneni ti'aitame haxɨaya,","poem":1},{"text":"kepauka mɨkɨ muyutemawie 'ɨxa mɨhatuiyarie hepaɨ kani'aneni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Temaikɨ 'axamɨtiuka'iyari yupaapa kanihiweritɨaka,","poem":1},{"text":"'uka muwikie mayu'eriya haa mɨkatsuke hepaɨ yɨkɨna katini'uximatɨaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kii meta tumini rapaapa katinaku'eiririemɨkɨ,","poem":1},{"text":"'uka mɨtimaiwe Yawé 'imikierieya kɨnaya hetsiemieme kanihɨkɨtɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kemɨ'ane mɨyɨ'ɨraxie kwinimieme katinikuneni xeikɨa,","poem":1},{"text":"meta kaniyehaakamɨneni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kemɨ'ane 'inɨari niukiyaritsie yamɨtikamie mɨkɨ yuhetsiemieme kaneye'atɨaka,","poem":1},{"text":"matsi kemɨ'ane mitixani'erieni kanimɨmɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Tixaɨtɨ mɨkarexeiya xɨka tumini pe'umini Yawé pekaniniɨtɨaka.","poem":1},{"text":"Mɨkɨ Yawé pumerakapitɨani 'aixɨa kepemɨtiuyurikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"'Aniwe keneheitseritɨaka mexixi 'akuxi yu'ɨxatsitɨarinɨa,","poem":1},{"text":"matsi pepɨka'iparewieka mɨmɨnikɨ peka'ita'ɨxatsitɨayu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kemɨ'ane mayu'eriya waɨkawa katinika'eniexɨamɨkɨ 'uximatɨarikakɨ,","poem":1},{"text":"kemɨ'ane minɨtɨamɨkɨ matsi waɨkawa piyehaxɨatɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kemɨ'ane 'ɨxatsi mɨ'enie kaniyuwaɨriyani 'aixɨa mɨtitahɨawarienikɨ,","poem":1},{"text":"matsi waɨkawa timaiwetɨ kanayeimɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tewi waɨkawa puyu'iyaritɨa yu'iyaritsie yamɨtiyurienikɨ,","poem":1},{"text":"matsi 'imatɨrieka Yawé kemɨtinake yapɨtiyɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Yunaitɨ teɨteri mekanitakwewieka kemɨ'ane wa'enietɨ muwatanaki'erienikɨ,","poem":1},{"text":"matsi 'aixɨa pɨ'ane tixaɨtɨ mɨkarexeiyani keyuri ti'itawatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Yawé 'ayemakatɨ xɨka 'uyeikani tukari kaniukaxeiyamɨkɨ,","poem":1},{"text":"hamatɨana 'akaniuyeikamɨkɨ 'aixɨa 'iyari meta katiuka'eniwatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Mɨyu'ɨraxie xakɨtsie xeikɨa kaneukamemeni,","poem":1},{"text":"matsi 'akuxi kaneiyehɨaka mɨramikiwanikɨ yuteta paitɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Kemɨ'ane mɨtiyukatawe'erie ke'ukuweiyaxɨani, 'ana 'atsimɨkatimate kemɨreuyewetse yamɨtiyurienikɨ niereme yapɨretimani,","poem":1},{"text":"kemɨ'ane mɨtiuyemate keneutaheitseritɨa 'ana tiuyemaitɨa kanayeimɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Kemɨ'ane yupaapa mɨtinawatsiriwa meta yumaama takwa paitɨ manuyehɨpa,","poem":1},{"text":"mɨkɨ temaikɨ mɨka'uka'iyari meta mɨka'uyukatewiya kanihɨkɨtɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Temaikɨ, xɨka ne'ɨkitsika peka'u'enieni,","poem":1},{"text":"'ɨxatsi 'aixɨa mɨ'ane pekaniku'eirimɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Kemɨ'ane 'uniereme yuxatatɨ mɨtiku'itawa mɨkɨ tita mɨtiheitserie kaninanaimaka,","poem":1},{"text":"'axatiyuruwame teta kanayeneikani tita 'axamɨti'ane xeikɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"'Iwaɨyɨ kaniha'aritsieka mɨtiuyukatawe'erie hetsiemieme,","poem":1},{"text":"mɨkayuwaɨriya teɨteri muwaparewienikɨ kanikuweiyaxɨamɨkɨ.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}