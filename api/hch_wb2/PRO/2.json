{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":2,"content":[{"type":"heading","content":["Mɨtimaiwenikɨ 'aixɨa pɨ'itɨarieka"]},{"type":"verse","number":1,"content":[{"text":"Temaikɨ, xɨka neniuki pe'anu'enieni,","poem":1},{"text":"meta ne'aitsika pe'uti'uta 'ahetsie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Xɨka 'anaka mɨtimaiwenikɨ mɨ'ayumieme 'u'enieni.","poem":1},{"text":"Meta 'a'iyarikɨ pe'ayetuani pemɨrakumaikakɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Xɨka mɨrakumaikakɨ pe'utahɨawe,","poem":1},{"text":"meta pemeitimaitɨyeikanikɨ pe'uta'iwauni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Xɨka pɨrata hepaɨ petikuwauneni,","poem":1},{"text":"tumini mɨ'awietɨ hepaɨ,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"hikɨ yapepɨretimani Yawé kemɨrayemakaxenikɨ","poem":1},{"text":"meta pepikaxeiya Kakaɨyari kemɨtiuyemate.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yawé xeikɨa katiniyupitɨwani mɨtimaiwenikɨ mɨ'ayumieme,","poem":1},{"text":"mɨrakumaikakɨ tatsiere pɨtiyupitɨwa tetana kanayeneikani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mɨkɨ kaniwaparewieka 'aixɨa memɨte'u'iyari.","poem":1},{"text":"Meta kaniwa'ɨwiyani kemɨ'ane heitserie memu'uwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mɨkɨ heitserie yamemɨtekahu wahuye kani'ɨwiyani","poem":1},{"text":"meta 'aixɨa memɨteyurie wahuye.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hikɨ 'ana pekaneitimaimɨkɨ heitseriemekɨ 'apemuyeikanikɨ,","poem":1},{"text":"meta hipame 'aixɨa pemɨtiwaxeiyanikɨ yunaime.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mɨtimaiwenikɨ mɨ'ayumieme 'a'iyaritsie kaninuamɨkɨ,","poem":1},{"text":"meta pemɨtimaikakɨ 'ana 'aixɨa 'iyari 'apepuyeikani pe'atemawietɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Aixɨa pemɨreitimamatekɨ pɨmatsi'ɨwiyani,","poem":1},{"text":"'ahetsie kepemɨtiuyemate pumatsi'awietani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mɨtimaiwenikɨ mɨ'ayumiememe 'axamɨti'anetsie pɨmatsixɨna,","poem":1},{"text":"meta teɨteri 'axamemutiyuane wahetsɨa,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"huye mɨheitserie me'uku'eirieka,","poem":1},{"text":"huye mumariwetsie pɨta memuhunikɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mepuyutemawie 'axameteyurietɨ,","poem":1},{"text":"pɨwanake kepauka teɨteri 'axamemɨteyurietsie.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Huye mututuni memuweiya","poem":1},{"text":"meta huye xaɨtsie meukuyuyune.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Xɨka petimaiweni 'uka mɨwikie hepaɨtsita pepɨ'a'ɨwiyani,","poem":1},{"text":"meta 'uka pemɨka'imate niukieya witsimutaine hepaɨtsita.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mɨkɨ 'uka Kakaɨyari hamatɨa tɨratu kemɨtiuwewi hatɨmaiyaka,","poem":1},{"text":"yɨkɨna kemɨtiuku'eiri 'ɨimariyari mitiwitɨ,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"kemɨ'ane menuweiya mɨkɨ mɨkitewatsata kaniyɨaneni,","poem":1},{"text":"huyeteya yɨwipa xeikɨa kanimiemetetɨni.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kemɨ'ane mɨkɨ 'uka winiyarieyatsie mɨyɨhɨani hatsuakuri pɨkahakunuani,","poem":1},{"text":"tukari huyeyari pɨkakaxeiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"'Ayumieme mɨpaɨ pepɨtiuyeikani huye 'aixɨa mɨ'ane 'utuma,","poem":1},{"text":"meta huye heitserie memu'uwa memiweiya pepuweiyani.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Heitseriemekɨ yamemɨtekahu wahetsie mɨkarahɨiwa,","poem":1},{"text":"kwie wahetsiemieme kanayeimɨkɨ meta yuheyemekɨ mana mekaniu'uwakuni.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kemɨ'ane 'axamemɨteyurie mepakumaweriyarieni,","poem":1},{"text":"yukwie memɨtsewiximakɨ yuheyemekɨ mekanikwi'iwakuni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}