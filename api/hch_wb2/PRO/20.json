{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"Xɨka winu 'anu'ieni ka'uka'iyaritɨ payani,","poem":1},{"text":"yaxeikɨa nawa xɨka 'anu'ieni teɨteri pɨwaxamurieni,","poem":2},{"lineBreak":true},{"text":"xewitɨ 'ietɨ timaiweme hepaɨ pɨkatiku'eriwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ti'aitame kepauka mɨha'a maye muyutahaxɨatɨwa hepaɨ kani'aneni,","poem":1},{"text":"kemɨ'ane miyehaxɨatɨani tukarieya pukweriwa'aneni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kemɨ'ane haxɨa mɨnɨtɨawe 'aixɨa pɨrahɨawarɨwa,","poem":1},{"text":"matsi 'axamɨtiyuriene yutemawietɨ pitsutsutɨwame.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mɨyɨ'ɨraxie kepauka mɨkatakwietsana pɨkaka'eni,","poem":1},{"text":"kepauka 'itsanaxa maye'ani pɨreuyehɨaka peru pɨkarexeiyani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tewi kemɨtiku'eriwa haa 'ameukateewa hepaɨ pɨ'ane,","poem":1},{"text":"matsi kemɨ'ane mɨtimaiwe yapauka peitimaitɨyeika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yumɨiretɨ mɨpaɨ meputiyuane kename 'ahetsie metewiya,","poem":1},{"text":"¿kemɨ'ane pɨyɨwe tewi 'aixɨa mɨtiuka'iyari mɨtaxeiyakɨ yuri mɨti'eririekakɨ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"'Aixɨa katinixeiyarieka kemɨ'ane 'aixɨa 'anemekɨ 'amuyeika,","poem":1},{"text":"Niwemama yupaapa hepaɨ meteyurietɨ 'aixɨa mekani'itɨarieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kepauka ti'aitame yu'uwenitsie 'amayerɨni wataxanetake,","poem":1},{"text":"mɨkɨ 'ana xeinieriyarikɨ tinaime 'axamɨti'ane katinaku'itiwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"¿Kemɨ'ane mɨpaɨ pɨtayɨni:","poem":1},{"text":"«Ne'iyari kani'itiyaka 'axamɨti'ane katiniumaweni»?","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tiwɨwɨtɨwame 'axamɨ'ane meta 'inɨaritsie mɨtiyukwamana:","poem":1},{"text":"mɨkɨ tihutame Yawé pɨtixani'erie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"'Ikɨ temaikɨ kemɨtiyuriene teɨteri yamepɨtemate,","poem":1},{"text":"kemɨtiyuriene yemekɨ xɨka 'aixɨa ti'aneni yatɨ hawaikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tanakatekɨ temeu'enanakɨ meta tahɨxitekɨ temeunenierenikɨ,","poem":1},{"text":"mɨkɨ tihuhutame Yawé katiniutiwewieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Pekunetɨ xeikɨa tixaɨtɨ perexeiyatɨ pepɨka'ayani,","poem":1},{"text":"matsi pɨta peti'uximayatɨ 'ikwai pekanexeiyakamɨkɨ 'anayuhayewame.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tinaweme mɨpaɨ kanaineni: «Tixaɨtɨ pɨkatiyunaki'erie 'utaitɨ»,","poem":1},{"text":"matsi 'arikeketa mɨpaɨ kanainemɨkɨ 'aixɨa pɨ'ane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Huru waɨkawa kanixuaweni meta tetexi witsi'anenetɨ,","poem":1},{"text":"matsi waɨkawa pɨraye'axe timaiweme 'ɨxatsieya kemanɨyɨne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Xɨka xeime hetsiemieme pera'akatuani kemɨ'ane pemɨka'imatetsiemieme,","poem":1},{"text":"tixaɨtɨ pepɨtitawawiyarieni pemɨtiyetuanikɨ 'akamixa 'emutsuye paitɨ pekaneuyehɨamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Tewi mɨti'itawa witsira'anekame pɨtikwa'a xeime tiu'itaiyaka,","poem":1},{"text":"matsi 'imatɨrieka mɨkɨ tewi kanitahɨnimɨkɨ xiekari 'axamɨ'ane tetana meutawiwieni hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kepemɨti'a'ɨwiyanikɨ kene'enieka memɨtemaiwawe wa'ɨxatsika,","poem":1},{"text":"matsi pemɨyɨwekaxɨanikɨ waɨkawa mɨrayukwitɨnetsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kemɨ'ane niukiperai mɨhɨkɨ tinaime pɨraxatawe teɨteri memɨtehetimanikɨ,","poem":1},{"text":"kemɨ'ane waɨkawa memutiniuka wahamatɨa pepɨka'axewiriyani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kemɨ'ane yupaapa yumaama wahepaɨtsita 'axamutaine,","poem":1},{"text":"mɨkɨ kanimɨmɨkɨ yemekɨ yɨwipa kaniyuhayewakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tita pemɨra'iwaxɨ pekati'uximayatɨ,","poem":1},{"text":"'imatɨrieka temawierika pepɨkahexeiyani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Hatsuaku mɨpaɨ pepɨkahaineni: «Yanepɨrekapitɨani mɨkɨ 'axamɨnetsi'uyurikɨ».","poem":1},{"text":"Yawé yuri ketine'eririeka mɨkɨ pumatsiparewieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Yawé tiwɨwɨtɨwame 'axamɨ'anene meta 'inɨaritsie mɨtiyukwamana,","poem":1},{"text":"mɨkɨ tihutame Yawé pɨtixani'erie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Tewi kemɨtimie Yawé kaniwitɨximeni.","poem":1},{"text":"¿Tewi yukɨmana yuhuye keretimani?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Pukweriwa'ane xɨka Yawé hɨxie kename petiyetuani hetsɨana timieme pehaitɨ,","poem":1},{"text":"matsi 'arikeke xɨka yapekatikayani kepemutayɨ 'aixɨa pɨka'ane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ti'aitame mɨtimaiwe tɨriku manuyexɨrɨwa hepaɨ pɨtiyuriene,","poem":1},{"text":"mɨkɨ 'axateyuruwamete murinata hepaɨ kaniwareuyetɨxɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Tewi 'iyarieya Yawé kɨxemeya kanihɨkɨtɨni,","poem":1},{"text":"temɨtemaiwawenikɨ tahetsie ketemɨ'anene meta tataɨta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Nenimayatsika meta tita yuri mɨraine ti'aitame kanitɨrɨkariyani,","poem":1},{"text":"mɨkɨ tiyukanenimayatɨ xeikɨa yu'uwenitsie kanayeixani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Temari witsikememɨteheu'erie mɨkɨ kaniwatɨrɨkariyatɨni,","poem":1},{"text":"meta 'ukirawetsixi yamemɨtekahu mɨkɨ wamutuxaiya mɨixa wiyari memu'uwa kaniwa'inɨaritɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"'Iwaɨyɨ mɨtiyukukuine pu'uaye meta 'aixɨa kamaniyurimɨkɨ,","poem":1},{"text":"xɨka pekuweiwani matsi 'aixɨa pekaniyɨmɨkɨ 'a'iyaritsie.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/19.json","previousChapterAudioLinks":{},"numberOfVerses":30}