{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":[{"text":"Ti'aitame 'iyarieya 'aki'utua haa muhane hepaɨ kani'aneni Yawé yatinɨ'akaku,","poem":1},{"text":"'itanɨ'awakaku mɨkɨ hakewa meinake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yunaitɨ teɨteri 'aixɨa meteyuriekame mekaniyu'erieka,","poem":1},{"text":"matsi Yawé pɨtatsixeiya ta'iyaritsie ketemɨteyuriku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kepauka teɨteri kemɨtiheitserie yamemɨteyurie,","poem":1},{"text":"mɨkɨ Yawé pinake keyuri mawari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kemɨ'ane mɨtiyukatawe'erie yu'iyaritsie meta timaiweme muyu'erie,","poem":1},{"text":"meta 'axateyuruwamete wahepaɨ xɨka tiyurieneni mɨkɨ 'axamɨti'ane pɨtihɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kepauka 'aixɨa mɨtiuyu'iyaritɨani: 'aixɨa pɨtiyɨni,","poem":1},{"text":"kepauka mexɨiwa mɨtiuyurieni: 'axapɨtiyɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"'Itarikakɨ xɨka tiukaxeiya waɨkawa","poem":1},{"text":"pɨtiparike yapauka haiwitɨri hepaɨ peru pɨmɨya winiyari hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Memɨteyukananaima yɨkɨmana mekaniyuka'unakuni,","poem":1},{"text":"memɨkayuwaɨriyakɨ heitseriemekɨ yamemɨteyuriekakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kepauka tewi 'aixɨa mɨkatiuyeika huyeya tunitɨ payani,","poem":1},{"text":"matsi kemɨ'ane heitseriemekɨ 'amuyeika huyeya kanixeuraɨyeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Matsi 'aixɨa kati'ane 'etsi'uyeyeukaku mayekani,","poem":1},{"text":"keyuri kii 'apameta 'uka mayu'eriya hamatɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"'Axatiyuruwame 'axamɨti'anetsie xeikɨa kaniyu'iyaritɨaka,","poem":1},{"text":"hatsuaku 'aixɨa tiyurienetɨ pɨka'ayani yuhepaɨ tewi hetsiemieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kepauka 'axamɨtiuka'iyari mɨtika'enitɨarieni,","poem":1},{"text":"'ana mɨtiyukatawe'erie yapɨretimani,","poem":2},{"text":"kepauka mɨtimaiwe mɨ'ɨxatsitɨarie,","poem":1},{"text":"'ana mɨkatimaiwe yapɨretimani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Heitseriemekɨ yamɨtikamie 'axatiyuruwame kiiya kanixeiyani,","poem":1},{"text":"meta kemɨtika'unarieni kanixeiyani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kemɨ'ane tixaɨtɨ mɨkarexeiya mɨka'enieni ra'iwawakaku,","poem":1},{"text":"mɨkɨtatsiere yaxeikɨa petatsuani 'anari xewitɨ pɨka'ita'eiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"'Awie 'imikieri xɨka pe'utuituarieni haxɨa kaninɨtɨaweni,","poem":1},{"text":"'ana kwitɨwa pekaninɨtɨarieka kepemɨtiha'akai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Tewi heitseriemekɨ yamɨtikamie pinake muyutemawieka kepauka hipatɨ hepaɨna memɨteyurie,","poem":1},{"text":"matsi 'axatiyuruwame kanimaka xeikɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kemɨ'ane mɨtihayewa 'aixɨa tiyurienetɨ yuhuyeta,","poem":1},{"text":"mɨkɨ yapauka mɨkite watsata kaniyuhayewamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kemɨ'ane 'ixɨarari minake tixaɨtɨ karexeiyatɨ payani:","poem":1},{"text":"winu xeikɨa mɨnaki'eriekɨ meta witsimɨtiu'ɨatɨka mɨkɨ hatsuaku waɨkawa rexeiyatɨ pɨkahayani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"'Axamɨtiyuriene 'aixɨa mɨtiyuriene hetsiemieme katinayukatuamɨkɨ,","poem":1},{"text":"tiyumiekame meta tinawayame mepɨtehayukatuani teɨteri 'aixɨa memɨte'u'iyari wahetsiemieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Matsi 'aixɨa pɨ'ane makumawetsie pemukani 'axaɨta,","poem":1},{"text":"matsi 'aixɨa pɨka'ane 'uka mɨha'a meta mayu'eriya hamatɨa pemukanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Timaiweme kiitana waɨkawa witsipɨtiuye'ɨa meta xikutɨriya pɨtihɨne,","poem":1},{"text":"matsi mɨkayuwaɨriya muwaparewienikɨ hipame katinitsewiximaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kemɨ'ane heitseriemekɨ yamɨtikamie meta mɨtiyukanaki'erie,","poem":1},{"text":"mɨkɨ tukari kanikaxeiyamɨkɨ, 'aixɨa ti'aneme pɨtikaxeiya meta 'aixɨa pɨraxaxatsiwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Mɨtimaiwe memɨtɨrɨkawi wakiekaritsie kaniye'amɨkɨ kaniwara'iwamɨkɨ,","poem":1},{"text":"meta wa'ixumeri kananuta'unaxɨamɨkɨ ka'uniweme mɨkɨ memɨ'eriekai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Kemɨ'ane mɨyukweriwayurie kemɨtikuxatakɨ,","poem":1},{"text":"mɨkɨ hatsuaku hipatɨ mepɨka'i'uximatɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Mɨtiyukatawe'erie mɨkɨ puwatewiyatsitɨa hipame meta pɨtiyuyuriya,","poem":1},{"text":"meta kemɨtiyuta'ɨrekɨ xeikɨa hipame 'axapuwayurie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Mɨyu'ɨraxie hiwe'erikakɨ kanimɨmɨkɨ,","poem":1},{"text":"mɨkati'uximayatamɨkɨkɨ,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"tukarikɨ xeikɨa kanaka'iyuniwani tihiwe'erietɨ,","poem":1},{"text":"matsi heitseriemekɨ yamɨtikamie katiniyetuaka 'iyarieya ya'anekaku tixaɨtɨ katiwakweririetɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Yawé 'axateyuruwamete wamawari pɨxani'erie,","poem":1},{"text":"meta tsiere kepauka 'axa'anemekɨ mawari memɨyetua mɨkɨ pɨxani'erie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Kemɨ'ane 'uniereme muyuxata ti'itawatɨ mɨkɨ kanika'unariemɨkɨ,","poem":1},{"text":"matsi kemɨ'ane yuri mɨtikuxata kemɨtiunierixɨ pupitɨarieni yamɨtayɨnikɨ kemɨtiunierixɨ.","poem":2},{"noteId":0}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"'Axamɨtiuka'iyari kemɨtiyuhɨawixɨ kename 'aixɨa 'ane putaine,","poem":1},{"text":"matsi tewi heitseriemekɨ yamɨtikamie kemɨtiuyeikakɨ kaniyuti'eriexɨamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Tewi kemɨtimaiwe Yawé hɨxie tixaɨtɨ pɨkatihɨkɨ,","poem":1},{"text":"meta tiuyemaitɨ, 'ɨxatsitawetɨ tixaɨtɨ pɨkatihɨkɨ kemutaine.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Yukawayu kanikuha'aritɨwani kuyaxa 'imieriyari tukaritsie mieme,","poem":1},{"text":"matsi kemɨ'aneta mɨrayu'iwa Yawé yatipitɨakaku pɨrayu'iwani.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":0,"caller":"+","text":"Yatɨni kemɨ'ane mi'enie pukumaweriyarieni yuheyemekɨ.","reference":{"chapter":21,"verse":28}}]},"thisChapterLink":"/api/hch_wb2/PRO/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/20.json","previousChapterAudioLinks":{},"numberOfVerses":31}