{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":[{"text":"Matsi 'aixɨa pɨ'ane pemumatiwanikɨ 'aixɨa petiuka'iyaritɨ,","poem":1},{"text":"keyuri huru meta pɨrata waɨkawa pehexeiyatɨ xeikɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mɨxiku meta tixaɨtɨ mɨkarexeiya mɨkɨ yaxeikɨa mepɨ'anene,","poem":1},{"text":"mɨkɨ yuhutame Yawé kaniwarutiwewieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kemɨ'ane mɨtimaiwe 'axamɨti'ane katinixeiyani mɨkɨ 'ateewa puyeyeika,","poem":1},{"text":"matsi mɨkatimaiwe mana kaniuyeyeikani 'ayumieme pɨtiuka'eniwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tixaɨtɨ pekare'ayeitɨatɨ Yawé pe'ayemakatɨ mɨpaɨ pekatinipitɨariemɨkɨ,","poem":1},{"text":"waɨkawa pepɨrexeiyani 'aixɨa pepɨrahɨawarɨwani meta tukari pepupitɨarieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"'Axateyuruwamete wahuyeta xuya puxuawe meta winiyari,","poem":1},{"text":"matsi kemɨ'ane yutukari mɨ'ɨwiya mana pɨka'uyeyani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"'Aniwe 'etsimuyumate kenekuxaxatɨwani huye 'aixɨa mɨ'ane,","poem":1},{"text":"kepauka 'ukiratsi mayani hatsuaku pɨka'iku'eirieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tixaɨtɨ mɨkarexeiya xiku katini'uximayatsiriwametɨni,","poem":1},{"text":"waɨriyarika mekateniwa'uximayatsirieka memɨtewarapiniriekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kemɨ'ane 'axa'anekamekɨ muka'etsa mɨkɨ 'axati'aneme katinika'itsanamɨkɨ,","poem":1},{"text":"Yawé ha'atɨ yu'itsɨkɨ kanika'unamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kemɨ'ane mɨtiyukanenimaya mɨkɨta Kakaɨyari 'aixɨa kaniyuriekamɨkɨ,","poem":1},{"text":"tixaɨtɨ memɨkatehexeiya mɨtiwamikwakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Keneuku'eiri kemɨ'ane mɨtiyukatawe'erie 'ana 'imieri pukumawere,","poem":1},{"text":"'ana kayuwatɨ pɨtamare tierika meta tewiyarika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kemɨ'ane yu'iyaritsie mɨti'itiya mɨtinaki'erie mɨkɨ kanipitɨarieka 'aixɨa mɨti'anekɨ mɨtaniunikɨ,","poem":1},{"text":"mɨkɨ ti'aitame kanihamikutani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yawé mɨtimaiwe pɨ'ɨwiya kemɨ'ane waɨkawa mɨtimate,","poem":1},{"text":"matsi kemɨ'aneta mɨti'itawa niukieya kani'uxiwe'erieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Muyu'ɨraxie mɨpaɨ kaniutaineni: «Maye takwa peyeika,","poem":1},{"text":"mana kaye'utɨa netsihetatsana».","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"'Uka hipatɨ memikumaɨwa tenieya mɨkɨ putsu 'emeukatewa hepaɨ kani'aneni,","poem":1},{"text":"mɨkɨta muwa kaneukahɨiyamɨkɨ kemɨ'ane hamatɨana muyutaxewire Yawé 'ihekakaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"'Axamɨtiuyurienikɨ yutemawietɨ temaikɨ hetsie kaniyekani,","poem":1},{"text":"matsi kɨyekɨ kuweiwatɨ ti'ɨkitɨatɨarietɨ 'ana pɨretimani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Xɨka tixaɨtɨ mɨkarexeiya petiunawatsirieni xiku pehayeimɨtɨ,","poem":1},{"text":"xɨka waɨkawa 'imikieri xiku petikumikwani,","poem":2},{"lineBreak":true},{"text":"matsi pɨta 'akɨmana tixaɨtɨ pekarexeiyatɨ pepa'ayeitɨwa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Memɨtemaiwawe waniuki kene'enieka yemekɨ kememutiyuane,","poem":1},{"text":"'a'iyaritsie 'aixɨa ketineu'ahɨawi kenematikɨhɨawe ne'ɨkitɨarikatsie.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Matsi 'aixɨa kani'aneni pemeixeiyani 'ataɨta paitɨ ne'ɨkitsika,","poem":1},{"text":"meta pe'ikuxatatɨ witsi'anemekɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yawé hetsie yuri ketine'eririeka,","poem":1},{"text":"'ekɨ nekamatiniuta'ɨkitɨani 'ikɨ tukaritsie.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ne nematsi'uti'utɨiri xeitewiyari heimana tamamata xatsikayari,","poem":1},{"text":"mana niuki kanayehuni temaiwawemete wa'ɨxatsi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"'Ikɨ niuki yuri maitɨka kametinita'ɨkiatɨamɨkɨ pe'ihiwe'eriekaku,","poem":1},{"text":"kɨmana 'aixɨa pemɨtiwata'eiyakɨ kemɨ'ane memetsita'iwawiya.","poem":2}]},{"type":"heading","content":["Xewi"]},{"type":"verse","number":22,"content":[{"text":"Tixaɨtɨ mɨkarexeiya pepɨkananaimaka, mɨkɨ tixaɨtɨ mɨkarexeiyakɨ,","poem":1},{"text":"meta 'itsɨkate wahetsɨa pepɨkawaxanetani mɨkɨ parewiya mekaneuyehɨaka.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yawé tixaɨtɨ mɨkarexeiya hetsie kanitanuamɨkɨ,","poem":1},{"text":"kemɨ'ane naime mɨtinawairieni mɨkɨta naime pɨtinawaiyarieni.","poem":2}]},{"type":"heading","content":["Huta"]},{"type":"verse","number":24,"content":[{"text":"Teɨteri memɨteyukananaima pepɨkawahamikutaneni,","poem":1},{"text":"meta memayu'eririya wahamatɨa pepɨka'uyeikani,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"nɨka ke'axamemɨteyurikɨ pewaruta'ɨke,","poem":1},{"text":"'ekɨta nɨka winiyaritsie wahepaɨ pe'ahɨani.","poem":2}]},{"type":"heading","content":["Haika"]},{"type":"verse","number":26,"content":[{"text":"Mɨrapine hetsiemieme pepɨkare'akatuayani,","poem":1},{"text":"meta pepɨkarapika xeime hetsiemieme,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"'ekɨ xɨka peka'iyemanani ketitakɨ pemɨrekapitɨani,","poem":1},{"text":"pekaninawaiyariemɨkɨ naime 'ahupume.","poem":2}]},{"type":"heading","content":["Nauka"]},{"type":"verse","number":28,"content":[{"text":"Pepɨka'ikupatani kwie 'inɨariyari meripaitɨ mieme,","poem":1},{"text":"kememɨte'u'inɨaritaxɨ tatutsima meripaitɨ miemetexi.","poem":2}]},{"type":"heading","content":["'Auxɨwi"]},{"type":"verse","number":29,"content":[{"text":"¿Tewi xeime yemekɨ 'aixɨa mɨtiu'uximayata petixexeiya?","poem":1},{"text":"Mɨkɨ te'aitamete wahetsɨa pɨti'uximayaka,","poem":2},{"lineBreak":true},{"text":"teɨteri memɨkamatiwa wahetsɨa pɨkati'uximayaka.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/21.json","previousChapterAudioLinks":{},"numberOfVerses":29}