{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":23,"content":[{"type":"heading","content":["'Ataxewi"]},{"type":"verse","number":1,"content":[{"text":"Kepauka ti'aitame hetsɨa pemɨtikwani,","poem":1},{"text":"kwiyemekɨ keneu'a'ɨwiya ketita 'ahɨxie mɨrapine.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Xɨka kwinimieme peti'akwaiwieka,","poem":1},{"text":"yapauka pepɨkatikwaka.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Ikwaiya witsimɨ'ane pepɨkahiwe'erieka,","poem":1},{"text":"matsi mɨkɨ 'ikwai kwamanarika kanihɨkɨtɨni.","poem":2}]},{"type":"heading","content":["'Atahuta"]},{"type":"verse","number":4,"content":[{"text":"Pepɨkati'a'uxitɨaka xiku pemayanikɨ,","poem":1},{"text":"kwinimieme pepɨkatihiwe'erieka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"¿Kamɨtsɨ pemixeiya petiyɨwe?, matsi pumawe.","poem":1},{"text":"Wa'atɨ wa'anate manexɨani hepaɨ mekani'aneneni,","poem":2},{"lineBreak":true},{"text":"mɨkɨ mekananɨwɨxɨakuni xeikɨa kwixɨri wahepaɨ.","poem":2}]},{"type":"heading","content":["'Atahaika"]},{"type":"verse","number":6,"content":[{"text":"Mexa 'aurie pepɨka'utiyeixani xeime tewi mɨtiukakwerie hamatɨa,","poem":1},{"text":"meta 'ikwaiya witsimɨ'anene pepɨkahiwe'erieka,","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"mɨkɨ kanihɨkɨtɨni 'axatiyukɨhɨawetɨ mumatsi'inie,","poem":2},{"text":"mɨpaɨ kanitayɨmɨkɨ «ketinekwaka ketine'ieka»,","poem":1},{"text":"matsi 'iyarieya yaka'anekaku pumatikɨhɨawe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Naime pekatinanatihayamɨkɨ ketita pemɨtiutikwai,","poem":1},{"text":"'ekɨ kepemɨtitixatɨa tixaɨtɨ pɨkarayani hetsienamieme.","poem":2}]},{"type":"heading","content":["'Atanauka"]},{"type":"verse","number":9,"content":[{"text":"Mɨkayuwaɨriya muwaparewienikɨ hipame pɨkaheuyewetse pemi'ɨxatsitɨaka,","poem":1},{"text":"'anari mɨkɨ matsiyuriyatɨ kanayeimɨkɨ tsepa 'ɨxatsi pemikuxaxatɨwa.","poem":2}]},{"type":"heading","content":["Tamamata"]},{"type":"verse","number":10,"content":[{"text":"Pepɨka'ikupatani kwie 'inɨariyari meripaitɨ miemete kemɨtiu'inɨatsie,","poem":1},{"text":"tɨɨri nutuite wakwie pepɨkawanawairieka,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"matsi waɨkawa kanitɨrɨkaɨyeni wahetsie nunuwame,","poem":1},{"text":"mɨkɨ wahetsie kanitanuamɨkɨ pemɨkawatsewiximanikɨ.","poem":2}]},{"type":"heading","content":["Tamamata heimana xewi"]},{"type":"verse","number":12,"content":[{"text":"'Aixɨa ketineu'ena 'a'iyaritsie meta kepemɨti'ɨkitɨarie,","poem":1},{"text":"'ana pemɨtimaiwenikɨ naime yapepɨretimani.","poem":2}]},{"type":"heading","content":["Tamamata heimana huta"]},{"type":"verse","number":13,"content":[{"text":"Temaikɨ peheitseritɨatɨ pepɨka'ihayewani,","poem":1},{"text":"tsepa pemikuwaxɨa mɨkɨkɨ pɨkamɨni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Matsi yaperehɨawetɨ keneukuwaxɨa,","poem":1},{"text":"mɨkɨ mɨpaɨ katiniyutawikweitsitɨamɨkɨ mɨkite watsata.","poem":2}]},{"type":"heading","content":["Tamamata heimana haika"]},{"type":"verse","number":15,"content":[{"text":"Neuxei temaikɨ xɨka petimaiwetɨ 'a'iyaritsie pe'ayani,","poem":1},{"text":"neta ne'iyaritsie neyutemawietɨ nekanayeimɨkɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yaxeikɨa waɨkawa netaɨta paitɨ nekaninetemawiekamɨkɨ,","poem":1},{"text":"kepauka 'akɨmana 'aixɨa pemɨtikuxata kemɨreuyewetse.","poem":2}]},{"type":"heading","content":["Tamamata heimana nauka"]},{"type":"verse","number":17,"content":[{"text":"'A'iyaritsie pepɨkatihiwe'erieka 'axateyuruwamete waɨkawa kememɨteheuxeiya,","poem":1},{"text":"matsi pɨta Yawé pe'ayemakatɨ meta pe'akwerietɨ yaketinekamieni yuheyemekɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mɨpaɨ peti'atemawietɨ pe'ukiratsitɨtɨ pepɨmɨni,","poem":1},{"text":"titakɨ pemɨtita'ikwewa mɨkɨ hatsuaku pɨkaka'unarieni.","poem":2}]},{"type":"heading","content":["Tamamata heimana 'auxɨwi"]},{"type":"verse","number":19,"content":[{"text":"Temaikɨ, kenene'enieka meta waɨkawa ketinemaiweni,","poem":1},{"text":"'ahuyeta heitseriemekɨ keneumieni 'aixɨa petiyurienetɨ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kwinimieme memɨteyu'iwawie wahamatɨa pepɨka'uyeikani,","poem":1},{"text":"meta kwinimieme memɨteyukwaiwawie wahamatɨa,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"kwinimieme memɨteyu'iwawie meta kwinimieme memɨteyukwaiwawie mɨkɨ tixaɨtɨ mekatehexeiyatɨ mepakɨne,","poem":1},{"text":"memɨyɨ'ɨraraxiekɨ 'ixuriki tsatsanime mepanakatɨxɨani.","poem":2}]},{"type":"heading","content":["Tamamata heimana 'ataxewi"]},{"type":"verse","number":22,"content":[{"text":"Kene'enieka 'apaapa mumatsi'ayexei,","poem":1},{"text":"'amaama pepɨka'uxieka kepauka waɨkawa mɨtseɨyeni yuwaiyaritsie.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Tita mɨtiyuri meta mɨtimaiwenikɨ mɨ'ayumieme 'ahetsie keneupitɨa,","poem":1},{"text":"meta pemɨheitseritɨariekakɨ meta pemeitimaitɨyeikanikɨ,","poem":2},{"lineBreak":true},{"text":"meta pepɨka'itsewiximaka.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Temaikɨ yamɨtikamie yupaapa waɨkawa kanitemawieritɨaka,","poem":1},{"text":"meta kemɨ'ane yuniwe timaiweme mexeiya kaniyutemawieka.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mekeyutemamawieka 'apaapa meta 'amaama,","poem":1},{"text":"mɨkɨ mematsi'utinuiwitɨakɨ.","poem":2}]},{"type":"heading","content":["Tamamata heimana 'atahuta"]},{"type":"verse","number":26,"content":[{"text":"Temaikɨ, yakenetineutahɨawi 'aixɨa peti'akɨhɨawetɨ 'a'iyaritsie pemumienikɨ,","poem":1},{"text":"nehuyeta keneumieni pepɨkaheuyewautseni.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Karikɨ 'uka tuminikɨ mɨyuwitɨnɨa putsu 'emeukatewa kanihɨkɨtɨni,","poem":1},{"text":"meta 'uka mɨka'a'ɨya putsu 'amuwakuyewa kanihɨkɨtɨni.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Mɨkɨ 'uka 'ukitsi muwahupie tinawayame hepaɨ kaniyɨaneni,","poem":1},{"text":"mɨkɨ 'ukitsi yɨ'ɨitama wahetsie memɨkatewiyanikɨ xeikɨa puwakuwaune.","poem":2}]},{"type":"heading","content":["Tamamata heimana 'atahaika"]},{"type":"verse","number":29,"content":[{"text":"¿Kemɨ'ane pɨwahetsiemieme hiwerika?","poem":1},{"text":"¿Kemɨ'ane mepɨte'uka'eniwani?","poem":2},{"lineBreak":true},{"text":"¿Kemɨ'ane pɨwahetsiemieme 'imieri?","poem":2},{"lineBreak":true},{"text":"¿Kemɨ'aneta niukixiya pɨwahetsiemieme?","poem":2},{"lineBreak":true},{"text":"¿Kemɨ'aneta yakɨ xeikɨa mepɨte'uka'eniwani?","poem":2},{"lineBreak":true},{"text":"¿Kemɨ'aneta puwahetsiemieme hɨxite mukuyuyuawi?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Kemɨ'ane puteyu winu mayema mɨka'utatuaya,","poem":1},{"text":"meta kemɨ'ane mɨkatihayewa hehekwame manu'ienikɨ.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Pepɨka'aku'ɨwiyani winu kemɨ'anekɨ,","poem":1},{"text":"meta tekɨxita yematɨ kemɨtiumerɨkakɨ,","poem":2},{"lineBreak":true},{"text":"meta tsepa witsikemukɨ'ɨare,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"karikɨ mɨkɨ kuu mayu'eriya mɨrakeni hepaɨ kani'aneni,","poem":1},{"text":"'imatɨrieka mɨrakenitsie kukuiniyakɨ katinamiemɨkɨ.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"'Ahɨxitekɨ yɨkɨ ti'aneneme pepɨtixeiya,","poem":1},{"text":"'anari 'axapetiyukɨhɨawetɨ pekanayeimɨkɨ.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Haramara hixɨapa muhauxime hepaɨ pepɨti'amaika,","poem":1},{"text":"meta kanuwa nɨ'awame hepaɨ pepɨyɨaneni peheuyuyehɨatɨ.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Mɨpaɨ peputaineni: «Nepeutiweiyaxɨa, matsi pɨkanetsihekwinixɨ,","poem":1},{"text":"Nekaneutiweiyaxɨani, matsi pɨkanetsi'ukukuine.","poem":2},{"text":"Kepauka pemanutaniere mɨpaɨ pepɨti'erieni, tawarita nepikuwauni 'etsiwa nemenu'ienikɨ».","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":35}