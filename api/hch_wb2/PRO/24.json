{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":24,"content":[{"type":"heading","content":["Tamamata heimana 'atanauka"]},{"type":"verse","number":1,"content":[{"text":"'Axateyuruwamete kememɨteyurie meta tita memɨtehexeiya pepɨkatihiwe'erieka,","poem":1},{"text":"meta pemuwanɨkakɨ pepɨkakuwauneni,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"mɨkɨ meteyukananaimatɨ xeikɨa mekaniu'uwani,","poem":1},{"text":"meta hipame 'uximatɨarika memuwapitɨanikɨ xeikɨa mekatenikuxatani.","poem":2}]},{"type":"heading","content":["Xeitewiyari"]},{"type":"verse","number":3,"content":[{"text":"Waɨkawa rakumaitɨ pɨyɨwe kii mutsutɨani,","poem":1},{"text":"kepemɨtiuyematekɨ kii tenarieya peputsutɨani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Aixɨa perakumaitɨ 'akiita pepɨtitahɨniya,","poem":1},{"text":"witsimɨti'anenekɨ meta waɨkawa mɨraye'atɨkakɨ.","poem":2}]},{"type":"heading","content":["Xeitewiyari heimana xewi"]},{"type":"verse","number":5,"content":[{"text":"Tewi mɨtimaiwe waɨkawa kanitɨrɨkaɨyeni,","poem":1},{"text":"meta kemɨ'ane meu'ena matsi waɨkawa tɨrɨkaɨyetɨ payeixime.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kepauka pemɨ'atamieni kaneuyeweka pemɨ'atimaixɨanikɨ,","poem":1},{"text":"meta pemɨra'a'iwanikɨ yumɨireme wa'ɨxatsi keneu'eni.","poem":2}]},{"type":"heading","content":["Xeitewiyari heimana huta"]},{"type":"verse","number":7,"content":[{"text":"Xewitɨ tewi 'axamutiyuriene yutemawietɨ hatsuaku timaiwetɨ pɨka'ayani,","poem":1},{"text":"meta teɨteri wahɨxie 'aixɨa mɨtayɨni pɨkayɨwe.","poem":2}]},{"type":"heading","content":["Xeitewiyari heimana haika"]},{"type":"verse","number":8,"content":[{"text":"Kemɨ'ane 'axatiyurimɨtɨ muyuha'aritɨa,","poem":1},{"text":"mɨkɨ 'axatiyuruwame katiniterɨwariemɨkɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Axamɨtiyuriene yutemawietɨ kemɨtiku'eriwa 'axamɨti'ane kanihɨkɨtɨni,","poem":1},{"text":"teɨteri memɨteyukatawe'erie mekaniwaxani'erieka.","poem":2}]},{"type":"heading","content":["Xeitewiyari heimana nauka"]},{"type":"verse","number":10,"content":[{"text":"Kepauka pemu'uximatɨarietsie pemɨkayuwaɨriya,","poem":1},{"text":"'ekɨ pepumatsiɨkɨ pemɨkatɨrɨkaɨyekɨ.","poem":2}]},{"type":"heading","content":["Xeitewiyari heimana 'auxɨwi"]},{"type":"verse","number":11,"content":[{"text":"Keniwarutawikweitsitɨa kemɨ'ane memɨkwini yuheyemekɨ,","poem":1},{"text":"keniwarukunuitɨa kemɨ'ane memɨte'uka'eniwa mekwiximetɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tsepa mɨpaɨ pemutaine, «Ne 'atsinepɨkatimaikai»,","poem":1},{"text":"Kakaɨyari hɨrixɨa pɨtimaikai 'a'iyari kemɨtiyukɨhɨawekai.","poem":2},{"text":"Meta 'atukari mɨ'ɨwiya yapɨtimate,","poem":1},{"text":"mɨkɨ tewi 'akatinapiniyariemɨkɨ kemɨtiu'uximayataxɨ.","poem":2}]},{"type":"heading","content":["Xeitewiyari heimana 'ataxewi"]},{"type":"verse","number":13,"content":[{"text":"Xiete kenanu'i, 'ekɨ temaikɨ nemɨmatsinaki'erie, mɨkɨ 'aixɨa kana'aneni,","poem":1},{"text":"yemekɨ witsikatinakakani 'anenitsie xietexi waxieteyari.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mɨpaɨta katinakakani xɨka waɨkawa petimaiweni 'a'iyaritsie,","poem":1},{"text":"heitseriemekɨ xɨka yapetikamieni Kakaɨyari pɨmatsiparewieka,","poem":2},{"lineBreak":true},{"text":"tita pemɨtitakwewie mɨkɨ hatsuaku pɨkaka'unarieni.","poem":2}]},{"type":"heading","content":["Xeitewiyari heimana 'atahuta"]},{"type":"verse","number":15,"content":[{"text":"Heitseriemekɨ yamɨtikamie kie pepɨkahupaneni 'axatiyuruwame hepaɨ,","poem":1},{"text":"meta kiitana pepɨkatinanaimaka.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tewi heitseriemekɨ yamɨtikamie tsepa 'atahutamexɨa mekawe,","poem":1},{"text":"mɨkɨ kananukukemɨkɨ,","poem":2},{"text":"matsi 'axateyuruwamete mekanekaxɨrɨweni,","poem":1},{"text":"matsi hatsuaku tawari mepɨka'anuku'uni.","poem":2}]},{"type":"heading","content":["Xeitewiyari heimana 'atahaika"]},{"type":"verse","number":17,"content":[{"text":"Kemɨ'ane metsi'aye'unie kepauka mekawenitsie pepɨka'atemawieka,","poem":1},{"text":"meta pepɨka'atemawieka 'a'iyaritsie mɨkɨ mɨtiuka'eniwakɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yawé mɨkɨ pɨka'inakire 'ekɨ kepemɨtiku'eriwa,","poem":1},{"text":"hikɨ mɨkɨ hepaɨtsita Yawé kemɨtiha'akai pɨtihayewa.","poem":2}]},{"type":"heading","content":["Xeitewiyari heimana 'atanauka"]},{"type":"verse","number":19,"content":[{"text":"'Axateyuruwamete wahepaɨtsita pepɨka'uyeha'arɨweni,","poem":1},{"text":"meta pepɨka'awaɨriyani pemuwa'ɨkenikɨ yamemɨkatekahu,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"matsi 'axatiyuruwame tixaɨtɨ pɨkatitakwewie,","poem":1},{"text":"kemɨ'ane yamɨkatikamie kɨxemeya kanitɨmɨkɨ.","poem":2}]},{"type":"heading","content":["Xeitewiyari heimana tamamata"]},{"type":"verse","number":21,"content":[{"text":"Temaikɨ, Yawé kenayemakaxeni meta yaketinekamieni ti'aitame hetsiemieme,","poem":1},{"text":"Yawé memu'uxie wahamatɨa pepɨka'axewiriyani,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"yapauka xekatenika'eniexɨakuni,","poem":1},{"text":"'atsipɨkatimatsiɨkɨ tita 'umuramie.","poem":2}]},{"type":"verse","number":23,"content":["'Ikɨ kanihɨkɨtɨnita tawarita kememutiyua temaiwawemete:",{"text":"'Aixɨa pɨka'ane hipame xeikɨa waparewietɨ kepauka 'iwaurika muwewienitsie.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"'Axamɨtiuyuri xɨka hetsiena karahɨiyani kename 'atsikatiuyuri,","poem":1},{"text":"'ana yunaitɨ nuiwarite hetsienamieme 'axameputiyuaneni mɨkɨ 'itsɨkame hepaɨtsita meta mekaniti'uxiwe'erikuni.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kemɨ'ane heitseriemekɨ mɨti'aita mɨkɨ 'aixɨa pɨtixeiyarieni,","poem":1},{"text":"'axatiyuruwame hetsie mɨrahɨakɨ 'ayumieme pɨnaki'eriwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Kemɨ'ane 'aixɨa mɨtikuxata yuri mutaine,","poem":1},{"text":"mɨkɨ witsikani'aneni 'itsiya hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"'Awaxa meri keneukuha'arita,","poem":1},{"text":"meta 'aixɨa ketinakuyuri pemaku'etsatsie,","poem":2},{"lineBreak":true},{"text":"mɨpaɨ meri petiyurieme 'arikeketa 'akii pepɨtawewieni.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Peti'itawatɨ 'ahepaɨ tewi hepaɨtsita pepɨkatikuxatani 'itsɨkame hɨxie,","poem":1},{"text":"pepɨkatiku'itawani 'atenikɨ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Mɨpaɨ pepɨkahaineni: «Kemɨnetsi'uyuri mɨkɨ,","poem":1},{"text":"neta yaxeikɨa nekatinekapitɨamɨkɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Mɨyu'ɨraxie mati'etsatsie nekaniuyeyani,","poem":1},{"text":"meta 'atsimɨkatimate kaxie ma'iteɨritsie 'aurie nekaniuyeyani.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Xuya xeikɨa naitsarie kananaye'ukaitɨni,","poem":1},{"text":"meta tupiriya 'etsiya xeikɨa kananukanakaitɨni,","poem":2},{"lineBreak":true},{"text":"tetexi kuraruyari petaxɨriyatɨkatei xeikɨa.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Kenemɨrenierixɨ ne'iyaritsie nepika'ɨnaxɨ,","poem":1},{"text":"netixeiyatɨ mɨpaɨ nepɨretima:","poem":2}]},{"type":"verse","number":33,"content":[{"text":"'etsiwa peheukukutsɨtɨ,","poem":1},{"text":"meta 'etsiwa pe'uka'uxipiwetɨ, meta 'atapa pe'awietɨ,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"tixaɨtɨ pekarexeiyatɨ pepayani tiyumemiwame 'ahetsɨa munuani hepaɨ pɨtiyɨni,","poem":1},{"text":"meta pereuyehɨatɨ tinawayame 'ixipara 'akwetɨ 'ahetsɨa munuani hepaɨ pumatiyurieni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}