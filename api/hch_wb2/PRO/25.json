{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":["'Ikɨta hipatɨ tawari temaiwawemete kememɨte'ɨ'ɨxatsita kanihɨkɨtɨni Tsarumuni meka'utɨa, 'Etsekiyaxi Kura kwieyaritsie ti'aitame, te'utɨwametemama kememɨteheka'ɨkixɨ."]},{"type":"verse","number":2,"content":[{"text":"Kakaɨyari 'aixɨa kerahɨawarɨwani tixaɨtɨ mɨti'awietakɨ,","poem":1},{"text":"matsi witsimepɨ'itɨarie te'aitamete kepauka memikaxexeiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Te'aitamete kememɨteku'eriwa yu'iyaritsie 'atsitepɨkatemate,","poem":1},{"text":"yaxeikɨa tepɨkatemate muyuawi kemeutitewa meta kwieta kemeukatewa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"'Axamɨ'ane pɨrata hetsie keneuka'iti,","poem":1},{"text":"mɨkɨtsie payeneni tepɨakɨ tiwewiwame mɨtitiwewienikɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Axamɨtiyuriene ti'aitame hetsɨa keneupata,","poem":1},{"text":"'ana ti'aitame yu'uweni heitseriemekɨ mɨti'aitanikɨ payeitɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ti'aitame hɨxie mariweme pepɨka'ayuyeitɨwani,","poem":1},{"text":"meta kwinimieme pepɨka'utaineni 'ahetsiemieme.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Matsi pɨta 'aixɨa pɨyɨni ti'aitame xɨka mɨpaɨ metiutahɨawe: «'Ena 'ahurawa kenatiye'a»,","poem":1},{"text":"teɨteri memumariwawe wahɨxie pepɨka'atewiyatsitɨaka.","poem":2},{"lineBreak":true},{"text":"Tita pemɨtiuxei 'ahɨxitekɨ,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"yapauka pepɨkatihekɨatani mɨrewatixanetsiwatsie,","poem":2},{"text":"nɨka 'ahepaɨ tewi,","poem":1},{"text":"yɨkɨ 'utayɨme metsi'utewiyatsitɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"'Ahepaɨ tewi hepaɨtsita 'aixɨa keneu'ayuri ke'axapemutayɨkɨ,","poem":1},{"text":"meta xeime 'awie mɨpaɨ pepɨkarahɨaweni mɨkɨ 'axakemɨtiuyurikɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kapa xewitɨ metsi'u'enieme metsi'utewiyatsitɨani,","poem":1},{"text":"'anari 'aixɨa pepɨkarahɨawarɨwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Huru manitsana pɨrata tsikɨiwitiyaritsie mɨyetei hepaɨ kani'aneni,","poem":1},{"text":"niuki witsimɨ'ane mɨpaɨ kani'aneni xɨka 'aixɨa tiuxatsieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Hanira meta kuka tɨwame hurukɨ muwewiya hepaɨ kani'aneni,","poem":1},{"text":"timaiweme matsi'utatieyu xɨka yemekɨ pe'i'enieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nɨ'ariekame mɨraye'atɨwa 'aixɨa 'anemekɨ kaniwaxeripitɨaka 'ɨwi hepaɨ kepauka muxɨkanitsie,","poem":1},{"text":"yukutsiyari puwaɨririe muyuwaɨriyanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Haiwitɨri meta 'eka wiyeri mɨkakaxɨrɨwa hepaɨ,","poem":1},{"text":"mɨpaɨ tewi kani'aneni kwinimime mutaine yakatikamietɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"'A'inɨkai pe'ikɨhɨawetɨ kemɨ'ane kwiepa mɨti'aita kemɨtiku'eriwa pepipata,","poem":1},{"text":"meta petiu'akanaki'erietɨ petikuxatɨtɨ waɨkawa katinikemaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Xɨka xiete pe'ukaxeiya, kwinimieme pepɨkatikukwa'ani,","poem":1},{"text":"nɨkahɨrixɨa waɨkawa pehenu'ieyu pe'utihayani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"'Ahepaɨ tewi kie yapepɨkatiyaneni,","poem":1},{"text":"kapa 'utiwaɨripieme metsi'utixani'erieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kemɨ'ane 'itsɨkame hɨxie mɨtikuxata ti'itawatɨ yuhepaɨ tewi hepaɨtsita,","poem":1},{"text":"mɨkɨ 'ixipara meta titsuname meta 'ɨrɨ manuyemɨtsɨ hepaɨ kani'aneni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kepauka pemɨ'uximatɨariekatsie xɨka yuri peti'erieka tewi tiyukwamaname hetsie,","poem":1},{"text":"tamé kɨmietɨ kemɨtiyukukuine meta ra'ɨka 'anumuritɨ mɨpaɨ pepɨti'amaika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Xɨka muyuhiwerie hetsiemieme 'utakwika,","poem":1},{"text":"winu matsina haiyatsie meuwirieni hepaɨ kani'aneni,","poem":2},{"lineBreak":true},{"text":"yatɨni mawetɨ muyeikani hepaɨ kani'aneni kepauka muhaɨtɨnitsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Mumatsi'aye'unie xɨka yehaakamɨneni ketineumikwa,","poem":1},{"text":"meta xɨka heuharimɨkɨni keneuharitɨa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mɨpaɨ petiyurienetɨ pekanitewiyatsitɨamɨkɨ ke'axamɨtiuyuri hepaɨtsita,","poem":1},{"text":"'ana Yawé kametiniyetuiriemɨkɨ 'a'iwarika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Tayetatsie 'eka mayeneika wiyeri kani'atɨwani,","poem":1},{"text":"yutenikɨ 'axamemutiyuane teɨteri xeikɨa mekaniwahaxɨatɨaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Matsi 'aixɨa kani'aneni 'etsi'uyeukaku pemayekani,","poem":1},{"text":"keyuri kii 'apameta 'uka mayu'eriya hamatɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Haa haɨtɨme yɨkɨipitsie 'anatiwakitɨ manuhareni hepaɨ,","poem":1},{"text":"kani'aneni niuki 'aixɨa manuyɨne 'ateewa paitɨ mieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Haixa muwaikarie meta haa putsuta mieme mu'uayemarie,","poem":1},{"text":"hepaɨ kaniyɨmɨkɨ tewi heitseriemekɨ 'amuyeika kepauka 'axamɨtiuka'iyari mitaweranariyatsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Pɨkayɨwe waɨkawa xiete mɨkwaka,","poem":1},{"text":"meta 'aixɨa pɨka'ane 'aixɨa pemɨrahɨawarɨwanikɨ pemɨtikuwaɨneni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Kiekari muka'unarie kakurarutɨiyarietɨ,","poem":1},{"text":"tewi yu'iyaritsie mɨpaɨ kani'aneni yukɨmana mɨkatiyu'aitɨawekɨ.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/24.json","previousChapterAudioLinks":{},"numberOfVerses":28}