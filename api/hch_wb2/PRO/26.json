{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":[{"text":"'Ɨwi taxarixa pɨkamieme,","poem":1},{"text":"meta witari 'itsanaxa pɨkamieme,","poem":2},{"lineBreak":true},{"text":"meta 'aixɨa pɨka'ane mɨkayuwaɨriya hipame muwaparewienikɨ hepaɨtsita 'aixɨa mɨraniuwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Wiiki mukuwiene xeikɨa yatɨni 'itsitame yu'itɨa mɨkahexeiya hepaɨ,","poem":1},{"text":"mɨpaɨ kani'aneni tewi 'axamɨ'itɨarienikɨ yamɨtiutawawie matsi hetsiena pɨkaye'ani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kwitaxi kawayutsixi wawayame kanihɨkɨtɨni,","poem":1},{"text":"meta pirenu puxu hetsiemieme kanihɨkɨtɨni,","poem":2},{"lineBreak":true},{"text":"yaxeikɨata mɨkayuwaɨriya hipame muwaparewienikɨ kaneuyeweka mukuweiyaxɨanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"'Axamɨtiyuriene yutemawietɨ kemɨtiuniuka mɨpaɨ pepɨkatiku'eiyani,","poem":1},{"text":"kapa 'ekɨta hepaɨna petiyurienetɨ pe'ayani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tewi mɨkayuwaɨriya muwaparewienikɨ hipame keneuta'eiya kemɨreuyewetse,","poem":1},{"text":"yɨkɨmana waɨkawa timaiweme mɨkayu'eriekakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mɨkayuwaɨriya hipame muwaparewienikɨ nɨ'ari pexɨka'ayeituani,","poem":1},{"text":"yɨ'ɨkatsie yuxiteka mɨtiukakukuineni hepaɨ 'anetɨ payani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tewi mɨkayuwaɨriya hipame muwaparewienikɨ 'ɨxatsieya tixaɨtɨ pɨkatiyunaki'erie,","poem":1},{"text":"mɨka'uyeiwe 'ɨkateya tixaɨtɨ mɨkatiyunaki'erie hepaɨ kani'aneni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mɨkayuwaɨriya hipame muwaparewienikɨ 'aixɨa mɨrahɨaweni tixɨatɨ pɨkatihɨkɨ,","poem":1},{"text":"tete texɨpametsie 'atatɨarietɨ mehɨiyani hepaɨ katinimatsiɨkɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mɨkayuwaɨriya hipame muwaparewienikɨ kemɨtikuxata,","poem":1},{"text":"tawekame xuya mamayatsie mutatseni hepaɨ kani'aneni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tupikɨ timɨmɨme watamɨmɨtɨ mɨtiwakukuinitɨwa yunaime mana memuyekɨka hepaɨ","poem":1},{"text":"kani'aneni kemɨ'ane mɨkayukuhɨawe muta'ini yukie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Tsɨkɨ 'ukunuaka tawarita yuhayari kemɨtiukukwa'a hepaɨ,","poem":1},{"text":"mɨpaɨ kani'aneni mɨkayuwaɨriya teɨteri muwaparewienikɨ yaxeikɨa kemɨtiyuriene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"¿Tewi petimate kemɨ'ane timaiweme muyuxata?","poem":1},{"text":"Tewi mɨkayuwaɨriya muwaparewienikɨ hipame mɨkɨ hetsie matsi katinitakwewiyaka keyuri mɨtiuyemate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Muyu'ɨraxie mɨpaɨ kaniutaineni: «Huyeta tiyukwa'ame kaneyeikani.","poem":1},{"text":"Kaye'utɨma maye kaneyeikani 'akuxɨnitɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"'Itupari kemɨranakuwautse mɨrawiyatɨkatsie,","poem":1},{"text":"yaxeikɨa muyu'ɨraxie mɨpaɨ yu'itaritsie ta'aurie katinawautseni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mɨyu'ɨraxie xakɨtsie xeikɨa kanikameka,","poem":1},{"text":"matsi 'akuxi kaneiyehɨaka mɨramikiwanikɨ yuteta paitɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mɨyu'uraxie kwinimieme timaiweme kaniyuxatani,","poem":1},{"text":"kename 'atahutame temaiwawemete waruta'ɨxatsitɨawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kemɨ'ane mɨrayukwitɨnetsie meuyehake ka'inierietɨ,","poem":1},{"text":"tsɨkɨ nakateyatsie tiwietɨ manukuhana hepaɨ kani'aneni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Xewitɨ heuyuyehɨatɨ mɨtiutatuaxa hepaɨ,","poem":1},{"text":"'ɨrɨ tatɨkaimekɨ watakukuyatɨ,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"mɨpaɨ kani'aneni kemɨ'ane yuhamiku mɨkwamana mɨpaɨ rehɨawetɨ:","poem":1},{"text":"«Netɨ nepɨka'imainekai».","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Tai pɨtɨni xɨka kɨyexi ka'anutanetɨarieni,","poem":1},{"text":"niuki peraixi memɨkahaxuawetsie 'imieri kanikumawerimɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tɨxari tɨɨ kanayeikani, kɨyexikɨ tai kananutatataweni,","poem":1},{"text":"tewi haxɨa mawauwe 'imieri kanitsutsutɨwametɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Niuki perai niukieya yemɨkɨ witsikatini'enierieka,","poem":1},{"text":"wataɨta paitɨ kaniye'axeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Kwitame pɨratakɨ muwewiya haxu xariyari hetsie muyeka,","poem":1},{"text":"tewi mɨpaɨ kani'aneni yu'iyaritsie mɨtihɨniya 'axamɨti'ane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Kemɨ'ane mɨtiyuka'uxiwe'erie yuniukita katini'awietani,","poem":1},{"text":"matsi yutaɨta 'axakatiniyurimɨkɨni.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kepauka witsimetikuxaxatɨwa yuri pepɨkati'eririeka,","poem":1},{"text":"'iyarieyatsie 'axamɨti'ane mɨtihɨnekɨ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Tsepa 'uxiwe'erika muti'awietaxɨ yuhetsie,","poem":1},{"text":"matsi mɨkɨ mɨirikɨa memayuxeɨrietsie katinitahekɨatsiemɨkɨ ke'axamɨtiuyuri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Putsu xɨka 'utawewieni muwa kaneukawemɨkɨ,","poem":1},{"text":"meta tete 'amɨnena xɨka hakaina yuhetsie kanikahɨamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Mɨti'itawa kemɨ'ane 'axamɨtikɨhɨawe mɨkɨ kani'uxiwe'erieka,","poem":1},{"text":"witsimɨtiuxaxata wakwamanatɨ kaniwarekaxɨriemɨkɨ.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/25.json","previousChapterAudioLinks":{},"numberOfVerses":28}