{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":[{"text":"Pepɨka'uyuta'ɨreni 'uxa'a kepemɨtiyurieni hetsiemieme,","poem":1},{"text":"'atsipemɨkatimatekɨ 'uxa'a kemɨtiyɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"'Ekɨ 'akɨmana 'ahetsiemieme 'aixɨa pepɨkahaineni,","poem":1},{"text":"hipatɨ pɨta 'aixɨa mekehaitɨkani 'ahepaɨtsita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tete pahete, xiekari pahete,","poem":1},{"text":"matsi waɨkawa pahete kepauka tewi mɨha'a yutemawietɨ 'axamɨtiyuriene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Haxɨa 'axapɨtiyuruwame meta pɨtiyu'uname,","poem":1},{"text":"yaxeikɨata 'uxiwe'erika xewitɨ pɨka'inewie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"'Aixɨa pɨ'ane xɨka hekɨa heitserie 'utatierieni,","poem":1},{"text":"'aixɨa pɨka'ane mɨnaki'eriwani 'awiexeikɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Waɨkawa matsi pepinaki'erieka 'ahamiku kepauka mumatikwinitɨa,","poem":1},{"text":"keyuri mɨmatsi'aye'unie kepauka mɨmatsi'itseni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kemɨ'ane mɨkaheuhaakamɨkɨ, xiete kanixani'erieka,","poem":1},{"text":"matsi kemɨ'ane meuhaakamɨkɨ, tsepa mɨratsiwi katinakakani hetsienamieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Wiki yu'itɨa kemɨtiuku'e'eiriwa tsepa hakewa,","poem":1},{"text":"yaxeikɨata tewi mɨpaɨ 'ateewa katineyeikani yutɨɨriyama waku'eirieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mixaxi meta witsimɨtiu'ɨatɨka 'iyari kanitemawieritɨwametɨni,","poem":1},{"text":"'ekɨta witsikepemɨtiwaxeiya 'iwatamete mɨkɨta waɨkawa pewaparewiekaku mekaniyuwaɨriyani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Pepɨka'iku'e'eiriwani 'ahamiku meta 'apaapa hamikuya.","poem":1},{"lineBreak":true},{"text":"Xɨka pe'a'uximatɨaka 'a'iwa hetsɨa pepɨkaheumieni.","poem":1},{"lineBreak":true},{"text":"'A'iwa pɨkayɨwe 'ateewa kiekame matsi'uparewieni, 'akie 'ahurawa muka pɨta pɨyɨwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Temaikɨ, nematsinaki'erie xɨka petimaiwetɨ 'ape'uyeikani ne'iyari kaniyutemawieka,","poem":1},{"text":"'ana nekaniyɨwemɨkɨ nemɨwata'eiyakɨ kemɨ'ane memɨnetsi'uxiwe'erie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kemɨ'ane mɨtimaiwe 'axamɨti'ane katinixeiyani mɨkɨ 'ateewa kaniuyeyeikani,","poem":1},{"text":"mɨkatimaiwe matsi mana kaniuyeyeikani 'ayumieme pɨtiuka'eniwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kemɨ'ane yamɨtayɨni ka'imateme hetsiemieme kename rayukatuani yukemari paitɨ kaneuyehɨamɨkɨ,","poem":1},{"text":"kemɨ'ane muyuyetuani 'uka xeime 'ɨyaya hetsiemieme yupiini tinaime mɨrexeiya katininawaiyariemɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Matsi xɨka pe'itawaɨritɨani 'ahamiku karima pe'utahiwatɨ ximeri paitɨ,","poem":1},{"text":"mɨpaɨ pumatitahɨawe: «Ketitayari heu'erietɨ penetiutahiwi».","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Haa mɨkatsuke katihayewatɨ kepauka muwiyenitsie,","poem":1},{"text":"mɨpaɨ kani'aneni 'uka muyumieriwie.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kemɨ'ane 'uka mɨyamɨ'ane mɨkemakaxɨani, 'eka mɨkemakata pɨyɨweni,","poem":1},{"text":"meta pɨyɨwe hatseiti yumamatsie mukwewienikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Tepɨa hepaɨna tepɨakɨ xɨka 'atamɨani kanetaxikaunariyamɨkɨ,","poem":1},{"text":"meta tewi yuhepaɨ teɨteri wahamatɨa katinetimamateni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kemɨ'ane piní 'iteɨriyari mɨ'ɨwiya mɨkɨ takariyari kanikakwaimɨkɨ,","poem":1},{"text":"kemɨ'ane 'aixɨa mɨti'uximaya yukutsiyari hetsɨa, matsi 'aixɨa katinixeiyariekamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Hatsie kemɨtihekɨa kepemɨraka'erie 'ahɨxie,","poem":1},{"text":"meta tewi yu'iyaritsie mɨpaɨ katinimatsiɨkɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Teukiya, mɨɨya meta tita teɨteri memɨtehiwe'erie metexeiyatɨ,","poem":1},{"text":"hatsuaku wa'iyaritsie pɨkareuyeyeika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Taipa pɨrata kani'inɨatsieka,","poem":1},{"text":"huru huxunuta kani'inɨatsieka,","poem":2},{"lineBreak":true},{"text":"tewi kani'inɨatsiekata kepauka hipatɨ 'aixɨa memaitɨka hepaɨtsitana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"'Axamɨtiyuriene yutemawietɨ tsepa meuyetɨxiwa heiwa meta hutarieka,","poem":1},{"text":"tsepa pemitɨxɨni matatsie 'ikú hepaɨ,","poem":2},{"lineBreak":true},{"text":"hawaikɨ pɨkanawaiyarieni kemɨtiyuriene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Keneu'a'ɨwiya pemɨretimanikɨ kemeteheu'erie 'atewama,","poem":1},{"text":"'amuxatsima waɨkawa keniwa'ɨwiyani,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"kepemɨrexeiya waɨkawa mɨkɨ pɨkatiteriwe,","poem":1},{"text":"meta tumini tsepa pemexeiya tixaɨtɨ pɨkatihɨkɨ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kepauka mɨraka'etsitɨretsie 'ɨxa makuwatsienitsie meta matiyɨraxɨanitsie,","poem":1},{"text":"meta hɨritsie paitɨ tupiriyate mukuxeɨriyanitsie,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"muxatsi 'akemari mepɨmatsiyetuirieni,","poem":1},{"text":"kapuratsixita peminanenikɨ hɨritsie 'amakuyewa,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"mana pekaneixeiyakamɨkɨ kapuratsixi waretsiyari 'anayuhayewame,","poem":1},{"text":"kɨmana xemɨteyumikwanikɨ yunaitɨ 'atɨɨriyama,","poem":2},{"lineBreak":true},{"text":"meta yaxeikɨa yunaitɨ mete'uximayatsiriwamete.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/26.json","previousChapterAudioLinks":{},"numberOfVerses":27}