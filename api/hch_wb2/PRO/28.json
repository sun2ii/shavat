{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"'Axatiyuruwame kaniuyu'unarɨmeni tsepa xewitɨ mɨka'iweiya,","poem":1},{"text":"matsi heitseriemekɨ yamɨtikamie kayuwatɨ 'apuyeika maye hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kiekaritsie xɨka 'axatiyɨaneni,","poem":1},{"text":"'itsɨkate mepɨyutimɨmɨire,","poem":2},{"text":"kepauka kuwexinaruri mɨtiuyemate,","poem":1},{"text":"kayuwatɨ putamarike.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kuwexinaruri tixaɨtɨ memɨkatehexeiya muwananaima,","poem":1},{"text":"mɨkɨ wiyeri mɨtɨrɨkaɨye 'ekamatɨ waxa kemɨreuyehɨpa hepaɨ kani'aneni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kemɨ'ane 'inɨari niukiyari memuku'eiri 'aixɨa meputiyuaneni 'axateyuruwamete wahepaɨtsita,","poem":1},{"text":"matsi kemɨ'ane memi'enie mekaniwa'uxiwe'erieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"'Axateyuruwamete tita mɨtiheitserie mepɨkahetimaitɨkɨka,","poem":1},{"text":"matsi kemɨ'ane Yawé memukuwautɨwe mɨkɨ naime mekatenimaika yamemɨtekahukɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"'Aixɨa kani'aneni tixaɨtɨ mɨkarexeiya heitseriemekɨ 'amuyeika,","poem":1},{"text":"matsi 'aixɨa pɨka'ane kepauka xiku 'axa'anemekɨ muyeika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Temaikɨ meti'enatɨyeika yakatinikamieni 'inɨari niukiyaritsie,","poem":1},{"text":"matsi kemɨ'ane waɨkawa memɨtekwa'a wahetsie mɨtiwiya mɨkɨ yupaapa kanitewiyatsitɨaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kemɨ'ane kwinimieme rana'iwamɨtɨ tumini muwaniɨtɨa,","poem":1},{"text":"matsi kemɨ'ane muwanenimaya memɨkatehexeiya hetsie pɨta pɨtinakeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kemɨ'ane 'inɨari niukiyaritsie yamɨkatikamie,","poem":1},{"text":"Kakaɨyari mɨkɨ nenewierieya kani'uxiwe'erieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kemɨ'ane heitseriemekɨ yamemɨtekahu xaɨtsie muwareukuyunitɨani,","poem":1},{"text":"mɨkɨta yukɨmana yuwiniyaritsie kaniyuhɨamɨkɨ,","poem":2},{"lineBreak":true},{"text":"matsi heitseriemekɨ yamemɨtekahu yu'iwarika 'amepɨtehapiniyarieni 'aixɨa mɨti'ane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Xiku timaiweme kaniyu'erieka,","poem":1},{"text":"matsi tewi tixaɨtɨ mɨkarexeiya rakumaitɨ yakatineitimamateni mɨkɨ kemɨtiyuriene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kepauka heitseriemekɨ yamemɨtekahu memɨtehayu'iwa kanimariweni wa'ixɨarari meta watemawierika,","poem":1},{"text":"matsi kepauka yamemɨkatekahu memɨtehayu'iwa yunaitɨ teɨteri mekaniyuti'awiwietani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kemɨ'ane 'axamɨti'ane mɨti'awieta hatsuaku 'aixɨa pukatiyeyani,","poem":1},{"text":"matsi kemɨ'ane muyutahekɨata 'axamɨti'ane mɨtiku'eirieni mɨkɨ katineuyehɨwiyariemɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"'Aixɨa kani'itɨarieka kemɨ'ane Yawé yuheyemekɨ mayemakaxe,","poem":1},{"text":"matsi kemɨ'ane yu'iyari mɨtse'iriya 'axa'anekɨa kaniyuhayewamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Maye mahiwa meta hutse meuhakamɨkɨ hepaɨ,","poem":1},{"text":"kuwexinaruri 'axamɨtiuka'iyari kani'aneni tixaɨtɨ memɨkateheuxeiya muwananaima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kuwexinaruri 'atsimɨkaretimaitɨyeika katininawayani teɨteri wakwamanatɨ,","poem":1},{"text":"matsi kemɨ'ane mɨpaɨ mɨkatiyuriene mɨkɨ mɨixa tukari 'apuyeikani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kemɨ'ane tiyumieme mukuweiyariene,","poem":1},{"text":"kaniyuku'unanemɨkɨ kepaukake mumierieni,","poem":2},{"lineBreak":true},{"text":"xewitɨ tɨma pɨka'iparewieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kemɨ'ane 'aixɨa mɨtixeiyarie heitseriemekɨ yamɨtikamie mɨkɨ kaniyutawikweitsitɨamɨkɨ,","poem":1},{"text":"matsi kemɨ'ane 'axatiyurienetɨ 'amuyeika putsuta kaneukawemɨkɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kemɨ'ane yukwietsie mɨtikumaɨwa waɨkawa 'ikwai katinexeiyakamɨkɨ,","poem":1},{"text":"matsi kemɨ'ane muyukuwie tixaɨtɨ karexeiyatɨ kanayeimɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Tewi heitseriemekɨ yamɨtikamie mɨkɨ waɨkawa 'aixɨa kani'itɨarieka,","poem":1},{"text":"kemɨ'aneta mɨyumexɨitɨa xiku mayanikɨ tikwinitɨarietɨ pɨkahayewarieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"'Aixɨa pɨka'ane hipame xeikɨa teɨteri muwaparewieka hipame yɨkɨ tiwaxeiyatɨ,","poem":1},{"text":"hipatɨ 'axamekateniyurieka paa 'etsipemekɨtɨtɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Kemɨ'ane mɨtiukakwerie xiku mayanikɨ puyumexɨitɨa,","poem":1},{"text":"'atsikatimaitɨ kepauka tixaɨtɨ karexeiyatɨ mayanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"'Imatɨrieka matsi hatsua 'aixɨa pɨtitahɨawarieni,","poem":1},{"text":"kemɨ'ane mɨtiyutaheitseritɨani keyuri witsimutaine wakwamanatɨ xeikɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Kemɨ'ane yupaapa meta yumaama mɨtinawatsiriwa,","poem":1},{"text":"katihayewatɨ kename 'axakatiyuriene,","poem":2},{"lineBreak":true},{"text":"mɨkɨ teɨteri 'axamemɨteyurie kaniwahamikutɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Kemɨ'ane tumini mɨnaki'erie xeikɨa mɨkɨ waɨkawa kaniyumienemɨkɨ,","poem":1},{"text":"matsi Yawé hetsie kemɨ'ane yuri mɨti'erie 'aixɨa kani'itɨariekamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Xɨka tewi yuhetsiemieme yuri tiyu'eririeka mɨkɨ pɨkayuwaɨriya muwaparewienikɨ hipame,","poem":1},{"text":"matsi kemɨ'ane timaiwetɨ yamɨtiyurieni kaniyutawikweitsitɨamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Kemɨ'ane tixaɨtɨ mɨkarexeiya mɨparewie mɨkɨ tixaɨtɨ reuyehɨatɨ pɨkahayani,","poem":1},{"text":"kemɨ'ane miti'uxiwe'erieni parewiya kemɨreuyehɨwa, mɨkɨ 'axakani'itɨariekamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Kepauka yamemɨkatekahu memɨte'ayu'iwa, teɨteri mekaniyuti'awiwietani,","poem":1},{"text":"kepaukata memukumaweriyarieni, 'aixɨa memɨteyurie 'aixɨa mekani'itɨariekuni.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}