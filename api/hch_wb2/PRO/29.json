{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":[{"text":"Kemɨ'ane mɨixa tierikayarikɨ mɨkaheu'ena","poem":1},{"text":"yapauka kanika'unariemɨkɨ kanenimayatsietɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kepauka heitseriemekɨ yamemɨtekahu memɨte'aitani teɨteri mepuyukatemamawieni,","poem":1},{"text":"kepauka 'axateyuruwamete memɨte'aitani teɨteri mepɨte'uka'eniwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kemɨ'ane mɨtimaiwenikɨ muyuwaɨriya, mɨkɨ yupaapa pɨtemawieritɨa,","poem":1},{"text":"kemɨ'ane 'ukari 'axateyuruwamete wahamatɨa muyeika, mɨkɨ yutumini pɨxɨtɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kwiepa ti'aitame xɨka kemɨtiheitserie ti'aitani 'aixɨa pɨti'ane kiekariena,","poem":1},{"text":"kemɨ'ane tuminikɨ memɨtehayukatuayanikɨ xeikɨa muwawawirie kiekari kanika'unani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kemɨ'ane yuhepaɨ tewi witsimɨtikuxaxatɨwa ti'itaiyatɨ,","poem":1},{"text":"winiyari hɨxiena puteika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"'Axatiyuruwame ke'axamɨtiuyurikɨ pekawautse,","poem":1},{"text":"matsi heitseriemekɨ yamɨtikamie yutemawietɨ putakwika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Heitseriekamekɨ 'amuyeika puyu'iyaritɨa kememɨte'uka'eniwa tixaɨtɨ memɨkatehexeiya wahetsiemieme matsi waheima kaninuaka,","poem":1},{"text":"matsi 'axatiyuruwame 'atsipɨkatimate ketita mɨtixatsiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Memɨteyukatawe'erie kiekari mekanixamurieka,","poem":1},{"text":"memɨtemaiwawe matsi waɨkawa kayuwatɨ mekaniwapitɨaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kepauka mɨtimaiwe meta yutemawietɨ 'axamɨtiyuriene hamatɨa memuyutakwini,","poem":1},{"text":"tsepa mutanawe yatɨni muyeha'a mɨkɨkɨ 'aixɨa pɨkatiyɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Memɨteyumemiwa mekaniwa'uxiwe'erieka teɨteri 'aixɨa memɨte'u'iyari,","poem":1},{"text":"meta heitseriemekɨ yamemɨtekahu mekaniwakwika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Tewi mɨkayuwaɨriya hipame muwaparewienikɨ yuhaxɨa pɨkawahana,","poem":1},{"text":"matsi kemɨ'ane mɨtimaiwe katinakumaika kemɨtiuyunɨtɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kwiepa ti'aitame xɨka memɨte'itawa xeikɨa wareu'enieka,","poem":1},{"text":"yunaitɨ te'i'uximayatsiriwamete 'axamekateniu'iyarikakuni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tewi tixaɨtɨ mɨkarexeiya meta mɨtiyukananaima hamatɨa yaxeikɨa mekani'aneneni:","poem":1},{"text":"Yawé mɨkɨ yuhutame kaniwapitɨaka memayenenierenikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kwiepa ti'aitame heitseriekamekɨ xɨka 'aixɨa tikuyuruwani tixaɨtɨ memɨkateheuxeiya wahetsiemieme,","poem":1},{"text":"mɨkɨ meta xiɨyarimama yuheyemekɨ heitserie mekanexeiyakakuni memɨtewata'aitɨanikɨ yuteɨterima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Tewi xɨka ti'ɨkitɨarieka kuweiwatɨ timaiwetɨ kanayeimɨkɨ,","poem":1},{"text":"matsi kemɨ'ane mɨkaheu'ena yumaama kanitewiyatsitɨaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kepauka 'axateyuruwamete memɨyumɨire 'axamɨti'aneta kaniwaɨkawani,","poem":1},{"text":"matsi teɨteri heitseriemekɨ yamemɨtekahu mekaniwaxeiyakuni kememɨte'atixɨriyani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"'Aniwe ketine'ɨkitɨaka, xɨka mɨpaɨ petiuyurieni 'arike 'aixɨa 'iyari pepuyeikani,","poem":1},{"text":"'ana temawierika pepexeiyani 'a'iyaritsie hetsienamieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Hakewa teɨteri 'atsimemɨkatehemate Kakayari kemaine, mekaneuyexɨrɨweni,","poem":1},{"text":"'aixɨa mekani'itɨarieka yamemɨtekahu 'inɨari niukiyaritsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Hawaikɨ niukikɨ xeikɨa pɨkayɨwe ti'uximayatame mɨtiti'ɨkitɨanikɨ,","poem":1},{"text":"tsepa mumetsi'enie yapɨkatikayani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"¿Tewi petimate kemɨ'ane kaheitimaixɨame mutaniuka?","poem":1},{"text":"Tewi mɨkayuwaɨriya muwaparewienikɨ hipame mɨkɨ hetsie matsi katinitakwewiyaka keyuri mɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kemɨ'ane tiyu'uximayatsiriwame mɨkaheitseritɨakai kepauka mɨkɨ mununutsitɨkaitsie,","poem":1},{"text":"'arikeke mɨkɨ yapɨkatikayani kemɨtita'aitɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Tewi mayu'eriya 'imieri xeikɨa kanixuawitɨaka,","poem":1},{"text":"meta kemɨ'ane mayumiewe waɨkawa 'axapɨtiyurie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Kemɨ'ane muyuta'ɨre tixaɨtɨ pɨkarayani,","poem":1},{"text":"matsi kemɨ'ane tixaɨtɨ mɨkarayuyeitɨa matsi mariwetɨ kanayeitɨariemɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Xɨka tenawayamete pewanɨka, 'ekɨ 'akɨmana pekani'a'uxiwe'erieka,","poem":1},{"text":"kepauka memɨtiwiyarienitsie, 'itsɨkame hɨxie 'ahetsie pɨrahɨiyani, 'ekɨ 'atsipepɨkatayɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Pewamakatɨ teɨteri 'akɨmana pepɨ'awiniya,","poem":1},{"text":"kemɨ'ane Yawé hetsie yuri mɨti'erie kaniwikweitsitɨarieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Yumɨiretɨ parewiya ti'aitame hetsɨa mekanikuwautɨweni,","poem":1},{"text":"matsi Yawé xeikɨa kanihɨkɨtɨni teɨteri heitserie muwapitɨani yuxexuime.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Yamemɨtekahu mekaniwa'uxiwe'erieka 'axamemɨteyurie, yaxeikɨata 'axateyuruwamete heitseriekamekɨ 'amemu'uwa mekaniwa'uxiwe'erieka.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/28.json","previousChapterAudioLinks":{},"numberOfVerses":27}