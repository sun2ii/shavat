{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":3,"content":[{"type":"heading","content":["Kehepaɨ mɨ'aneni mɨtimaiwenikɨ mɨ'ayumieme"]},{"type":"verse","number":1,"content":[{"text":"Temaikɨ, pepɨkaratɨtɨmaiyani kenemɨmati'ɨxatsitɨa,","poem":1},{"text":"matsi pɨta, yuheyemekɨ kena'eriwani ne'aitsika.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Karikɨ xɨka mɨpaɨ pe'aneni mɨixa wiyari pekanitihuimɨkɨ","poem":1},{"text":"meta 'aixɨa 'iyari pepuyeikani.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hatsuaku pepɨkaratɨtɨmaiyani peti'akanaki'erietɨ meta yuri petikuxatatɨ:","poem":1},{"text":"'Aheyemekɨ mɨpaɨ ketinekamieni","poem":2},{"lineBreak":true},{"text":"meta 'a'iyaritsie paitɨ kena'utɨaka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mɨpaɨ xɨka petikamieni Kakaɨyari 'aixɨa pɨmatixeiyani,","poem":1},{"text":"meta teɨteri 'aixɨa meputiyuaneni 'ahepaɨtsita.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yawé hetsie ketinewiyani naime 'a'iyarikɨ,","poem":1},{"text":"hawaikɨ kepemɨtimaiwe 'ahetsie pepɨkatiwiyani.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kakaɨyari kena'eriwani naimekɨ kepemɨtiyurienekɨ,","poem":1},{"text":"'ana mɨkɨ 'ahuye pɨheitseritɨaka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kwinimieme perakumaikame pepɨkayuxatani:","poem":1},{"text":"matsi pɨta Yawé kenayemakaxeni meta 'axamɨti'ane hepaɨtsita kene'apatani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mɨpaɨ xɨka petikamieni 'aixɨa pepɨreu'erieka 'awaiyaritsie,","poem":1},{"text":"meta pepɨtɨrɨkaɨyeni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yawé kenayexeiyani tita pemɨrexeiyakɨ,","poem":1},{"text":"meta matɨarimieme 'ikwaxi keneyetuirieka tita pemɨtiukaxexeiya.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mɨpaɨ xɨka petiyurieneni 'akaretatsie tɨriku takariyari panakaxɨrɨweni,","poem":1},{"text":"meta 'akiita kaxie winuyari mɨhekwa pɨxuaweni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Temaikɨ, xɨka Yawé matsi'anayewayani meti'ɨkitɨatɨ pepɨka'i'uxiwe'erieka,","poem":1},{"text":"meta kepauka mɨmatsi'utate'ani pepɨka'uyeha'arɨweni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yawé matsi pɨwaranayewaya tiwa'ɨkitɨatɨ kemɨ'ane mɨwanaki'erie,","poem":1},{"text":"tewi yuniwe 'inaki'erietɨ kemɨti'ɨxatsitɨa hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"'Aixɨa kani'itɨarieka kemɨ'ane mɨtimaiwenikɨ mɨ'ayumieme mukaxei,","poem":1},{"text":"meta kemɨ'ane waɨka mɨtiuyemaikakɨ mutaxei.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kepauka pemɨtimaiwe, matsi waɨkawa pekanipitɨarieka","poem":1},{"text":"keyuri pɨrata meta huru.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kepauka pemɨtimaiwe, matsi waɨkawa pekanipitɨarieka","poem":1},{"text":"keyuri tetexi witsimɨ'anene, pɨtiumawe hepaɨna witsiti'anetɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kepauka pemɨtimaiwe, pepɨxatɨarieni mɨixa wiyari pemexeiyanikɨ,","poem":1},{"text":"meta 'aixɨa pepɨtixeiyarieka meta waɨkawa pepɨrexeiyani.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kepauka pemɨtimaiwe witsi'anemetsie pepumieni,","poem":1},{"text":"naitɨ 'aixɨa katini'anemɨkɨ 'ahetsiemieme.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mɨkɨ kɨye tukari tiyupitɨwame kanihɨkɨtɨni kemɨ'ane memitapa wahetsie,","poem":1},{"text":"'Aixɨa mekani'itɨarieka kemɨ'ane memeixeiya.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yawé kwie kaniutawewieni kemɨtiuyematekɨ,","poem":1},{"text":"muyuawi tatsiere 'akaniuyemani taheima kemɨrakumatekɨ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mɨkɨ yareitimaixɨaku haramara kaniupatsirixɨani meta haa kanetinetɨaxɨani,","poem":1},{"text":"meta haiwitɨritsie wiyeri 'akaneikatɨ kanayani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Temaikɨ, kene'a'ɨwiyani 'aixɨa ti'aneme pemɨranayexeikɨ,","poem":1},{"text":"pepɨkahetɨtɨmaiyani 'ɨxatsi 'aixɨa pemɨtiu'eni.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Xɨka mɨpaɨ petikamieni mɨixa wiyari 'apepuyeikani,","poem":1},{"text":"meta kuka pematitɨkɨni hepaɨ pepɨ'aneni.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hikɨ 'aixɨa 'iyari pepumieni,","poem":1},{"text":"meta hatsuaku pepɨkahekaweni.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kepauka pemɨkahunitsie, tixaɨtɨkɨ pepɨkareumaka,","poem":1},{"text":"hikɨ pekahume 'aixɨa 'iyari pekaneukumɨkɨ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Pepɨkaheumaka xɨka yapauka 'axamɨti'ane tiukuyani,","poem":1},{"text":"meta kepauka 'uximatɨarika 'axateyuruwamete wahetsiemieme munuani pepɨkaheumaka.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Yawé yuheyemekɨ 'ahamatɨa kaniuyeikamɨkɨ,","poem":1},{"text":"meta kameni'ɨwiyakamɨkɨ winiyaritsie kapa pe'uwierekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Pepɨkahe'imaiyani kemɨ'ane parewiya mɨmatsitawawirieni,","poem":1},{"text":"xɨka perexeiyani tita mɨreuyehɨwa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"'Ahepaɨ tewi hatsuaku 'ipaɨ pepɨkarahɨaweni:","poem":1},{"text":"«Nepɨkayɨwe 'arike pepayeneni, 'uxa'ake nepɨmatsiparewieni»,","poem":2},{"lineBreak":true},{"text":"xɨka perexeiyanitɨtɨ hikɨ titakɨ pemɨtiparewieni.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Tita 'axamɨti'ane 'ahepaɨ tewi pepɨkawiwirieka,","poem":1},{"text":"'iya 'aixɨa mɨmatiku'eriya.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"'Imieri pepɨkakuwauneni xeime hetsie,","poem":1},{"text":"xɨka mɨkɨ 'atsikametsi'uyurieni.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Memayu'eririya ketita memɨtehexeiya pepɨkatihiwe'erieka,","poem":1},{"text":"'ekɨ meta memayu'eririya pepɨkawa'ɨkeni.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Yawé kaniwaxani'erieka 'axamemɨte'u'iyari,","poem":1},{"text":"peru kemɨ'ane 'aixɨa memɨte'u'iyari kaniwanaki'erieka.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Yawé 'uximatɨarika kanipitɨaka, kemɨ'ane 'axamɨtiyuriene kie,","poem":1},{"text":"matsi 'aixɨa katiniyurieka kemɨ'ane yamemɨtekahu wakie.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Yawé kaniwananaimaka kemɨ'ane memɨte'uyukatawe'erie,","poem":1},{"text":"peru kemɨ'ane tixaɨtɨ memɨkate'ayuyeitɨa mɨkɨ puwaparewie.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Kemɨ'ane memɨtemaiwawe 'aixɨa mepɨtehamamatiwani,","poem":1},{"text":"matsi kemɨ'ane memɨkayuwaɨriya memɨwaparewienikɨ teɨteri hipame 'aixɨa pɨ'ane 'axamemɨtehamamatiwanikɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}