{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":30,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["'Akuhuxi niukieya kemɨtimaiwekai Kakehe nu'aya Matsaha kiekame. Tixaxatame niukieya. 'Ikɨ tewi mɨpaɨ kaniutayɨni:",{"text":"«Neuxei Kakaɨyari 'aku ne nepu'uxe,","poem":1},{"text":"Kakaɨyari 'aku ne nepu'uxe meta nepɨwerani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"»Ne tewi kwinimieme 'atsinemɨkatimate nepɨhɨkɨ,","poem":1},{"text":"'etsiwa tɨma ne nepɨkatiuyemate tewi kemɨtimaiwe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nemɨtimaiwenikɨ 'akuxi ne nepɨkatanaki'eriwe,","poem":1},{"text":"meta Kakaɨyari mɨpatsie nepɨkamate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"»¿Muyuawitsie kemɨ'ane panutitɨari","poem":1},{"text":"meta kemɨ'ane mana pakane?","poem":2},{"text":"¿Kemɨ'ane 'eka puwiyawe yumamakɨ,","poem":1},{"text":"yatɨni kemɨ'ane haramara pakawimawe?","poem":2},{"text":"¿Kemɨ'ane kwie manuye'atɨkanitsie pu'inɨataxɨ?","poem":1},{"text":"¿Kemɨ'ane yapɨtimate kepemɨtitewa yatɨni 'aniwe kemɨtitewa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"»Kakaɨyari niukieya naitɨ taikɨ puti'inɨatsie,","poem":1},{"text":"Kakaɨyari kaniwaparewieka kemɨ'ane hetsɨana memɨtewautɨwe 'aixɨa memɨ'itɨariekakɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Niukieya pepɨka'anutiyayatsani,","poem":1},{"text":"kapa metsi'utatienikɨ","poem":2},{"lineBreak":true},{"text":"meta peti'itawame matsiɨkɨme 'ahetsie rayeitɨanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"»Tihutame xeikɨa Yawé nepɨmatiwawirie,","poem":1},{"text":"mexixi nekamɨwe yakenetineupitɨa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Keneneparewieka nemɨkati'itawanikɨ,","poem":1},{"text":"tixaɨtɨ nekarexeiyame pepɨkanetsihayeitɨwani meta xiku nemɨka'ayanikɨ,","poem":2},{"lineBreak":true},{"text":"matsi pɨta paa xeitukariyaritsie mieme keneneyetuiriwani.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Waɨkawa xɨka nerexeiyani nepɨmatsihatɨmaiyawe,","poem":1},{"text":"mɨpaɨ ne'utaitɨ: “¿Yawé kemɨ'ane pɨhɨkɨ?”","poem":2},{"text":"Meta xɨka 'etsiwa xeikɨa nerexeiyanike tinawayame nepayeiwe,","poem":1},{"text":"'ekɨ nekakaɨyari 'axapemɨtitahɨawarienikɨ xeikɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"»Ti'uximayatame 'axapepɨkatikɨhɨaweni kutsiyarieya hɨxie,","poem":1},{"text":"nɨka 'axape'itɨarietɨ pemayanikɨ mɨkɨ yametiutahɨawe meta yapetiuka'eniexɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"»Hipatɨ mekanixuaweni yupaapama 'axametewakumamatetɨ,","poem":1},{"text":"meta yumaamama 'aixɨa mekatewarahɨawetɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hipatɨ mekanixuaweni me'itiyakame meyuxatatɨ,","poem":1},{"text":"matsi 'akuxi mepɨkayu'itiewawe kememɨkate'itiyakɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hipatɨta mekanixuaweni waɨkawa meyɨwaweme meyu'erietɨ,","poem":1},{"text":"mɨkɨ yunaitɨ mekaniwaxeiyani mewa'uxietɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hipatɨ tamé 'ixiparayari mekanexeiyani","poem":1},{"text":"meta natsɨkwai nawaxayari,","poem":2},{"text":"kwiepa memuwatikwanikɨ tixaɨtɨ memɨkatehexeiya,","poem":1},{"text":"meta teɨteri memɨteheuyehɨwa 'ena kwiepa memu'uwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"»Xuriya 'itseweme yuhutame yuniwema kaniwarexeiyani,","poem":1},{"text":"mɨpaɨ mekaniutiyuaneni: “Kena, kena”.","poem":2},{"lineBreak":true},{"text":"»Haikatɨ kanixuaweni 'inɨari hatsuaku memɨkahuxaiwawe,","poem":1},{"text":"nauriekata mieme hatsuaku mɨpaɨ pɨka'utaine: “Nepɨwaɨripie”:","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Teukiyapa, meta 'uka mɨkaniwewe,","poem":1},{"text":"meta kwie hakɨ mɨka'utahɨpɨrike,","poem":2},{"lineBreak":true},{"text":"meta tai hatsuaku mɨkakutɨtɨtse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"»Kemɨ'ane yupaapa mɨka'enie,","poem":1},{"text":"meta yumaama mɨkaheu'enie,","poem":2},{"text":"kwatsari mana mayeweritsie memu'uwa hɨxiteya meke'utikwani,","poem":1},{"text":"meta maraikatsixi 'ayeniereme waiyarieya meke'utakwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"»Haikatɨ kanixuaweni 'inɨari mɨnetsihɨxiyatsitɨa,","poem":1},{"text":"matsi naurieka mieme nepɨka'uyɨwekaxɨa nemeitimanikɨ:","poem":2}]},{"type":"verse","number":19,"content":[{"text":"kwixɨ huyerieya kemɨtikuwiene muyuawitsie,","poem":1},{"text":"kuu huyerieya tetetsie kemɨtikuyeika,","poem":2},{"text":"kanuwa 'amɨpa huyerieya haramaratsie mɨyeyeika,","poem":1},{"text":"meta 'uki 'uka 'iyarieya kemɨra'i'iwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"»Mapaɨ katiniyurieka 'uka muwikie memɨkakɨnamama memikumaɨwa:","poem":1},{"text":"tiutikwa'atɨ wayetereuxinatɨ,","poem":2},{"lineBreak":true},{"text":"mɨpaɨ kaniutaineni: “Hawaikɨ matsi 'axanepɨkatiyuriwe”.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"»Mɨkɨ haikatɨ 'inɨari kwie kaniwatayuitɨwani,","poem":1},{"text":"naurieka miemeta yaxeikɨa pɨtiyuriene:","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Waɨriyarika ti'uximayatame ti'aitatɨ mayanikɨ kanaye'aweni,","poem":1},{"text":"tewi 'atsimɨkatimate 'ikwaiya mɨranayuhayewa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"'Uka mɨxani'eriwakai kepauka mɨtiwikieni,","poem":1},{"text":"meta 'uka waɨriyarika ti'uximayatame ti'aitatɨ mayanikɨ yukutsiyari kiita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"»Yunaukatɨ kwiepa 'etsimetepepetɨ mekatenixuaweni,","poem":1},{"text":"matsi waɨkawa metemaiwawetɨ keyuri temaiwawemete:","poem":2}]},{"type":"verse","number":25,"content":[{"text":"tsarɨxi mekatɨrɨkawitɨtɨ,","poem":1},{"text":"yu'ikwaite taxata timieme mekateniuti'utani,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"haitsɨrixita, yeutari 'etsimepepetɨ,","poem":1},{"text":"mɨkɨ yuterɨ mekanexeiyani 'aitsie paitɨ,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"'utsikarita tiyu'aitɨwame memɨkahexeiya,","poem":1},{"text":"matsi yaxeikɨata mɨkɨ mekateniukɨkani kuyaxi wahepaɨ,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"'atakwaixita, mekaniyuwiyanɨaka yumamakɨ,","poem":1},{"text":"matsi mɨkɨta paratsiyuta paitɨ mekaneutahakeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"»Yuhaikatɨta mekanixuaweni 'aixɨa mete'ɨkɨkatɨ,","poem":1},{"text":"matsi naurieka mieme wahepaɨ 'aixɨa pɨtiuyeika:","poem":2}]},{"type":"verse","number":30,"content":[{"text":"maye, 'ɨrawetsixi watsata mɨtɨrɨkaɨye,","poem":1},{"text":"tixaɨtɨ timakatɨ mɨka'ukununuwa,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"wakanata 'uki yu'anatekɨ kanitɨrɨkaɨyeni, tsiputa 'uki yaxeikɨa,","poem":1},{"text":"ti'aitameta yukuyaxima wahamatɨa kanitɨrɨkaɨyeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"»Xɨka yamɨkatikamie hepaɨ petiuyeikani, kwinimieme petiu'ata'ɨretɨ,","poem":1},{"text":"xɨka xewitɨ mɨpaɨ tiku'eriwani, kaneuyeweka yapauka muyutimaixɨanikɨ,","poem":2}]},{"type":"verse","number":33,"content":[{"text":"kwahu hayari xɨka retsita 'ukatuame xɨka 'iwakumuina kexiu kanihekɨarimɨkɨ,","poem":1},{"text":"meta xɨka karima 'ukatsurixike xuriya ratsurita kaniwakanemɨkɨ,","poem":2},{"lineBreak":true},{"text":"meta haxɨa xɨka 'utsutɨani kaniuyutakwixɨakuni».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}