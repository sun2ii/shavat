{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":["Ti'aitame Remuheri niukieya kemɨtimaiwekai. Tixaxatame niukieya, maamaya kemɨtiti'ɨxatsitɨa niukiyari:"]},{"type":"verse","number":2,"content":[{"text":"«¿Temaikɨ 'aku kepetiku'eriwa?","poem":1},{"text":"¿Temaikɨ 'aku, kepetiku'eriwa nemɨmatsi'utiniwexɨ?","poem":2},{"lineBreak":true},{"text":"Neyutanenewieku Yawé 'ekɨ pɨmatsiyetua, ¿kehepaɨ nemati'ɨxatsitɨani?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Atɨrɨkariya pepɨkayetuaka 'ukari wahetsie,","poem":1},{"text":"mɨkɨ te'aitamete paitɨ mekaniwareuyexɨrɨwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"»Remuheri 'aku,","poem":1},{"text":"'aixɨa pɨka'ane te'aitamete kaxie winuyari memɨ'ieka,","poem":2},{"lineBreak":true},{"text":"meta nawa kuwexinaruritsixi memanuye'eni,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"kapa metarɨwetɨ mehetɨmaiya 'inɨari niukiyari kemaine,","poem":1},{"text":"meta tixaɨtɨ memɨkatehexeiya metewarunawairieni heitserie kememɨtehexeiya.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Memukwixime nawa memanu'einikɨ keniwarupitɨa,","poem":1},{"text":"meta kaxie winuyari kemɨ'ane waɨkawa memɨyu'iyaritɨa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Meke 'enu'ieni, memɨtehatɨmaiyakɨ tixaɨtɨ memɨkatehexeiyakɨ,","poem":1},{"text":"tawariri memɨkahe'eriwanikɨ kememɨte'uka'eniwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"»Kenewaparewieka yɨkɨmana memɨkaniuwawe 'itsɨkate wahɨxie,","poem":1},{"text":"kenewanenimayaka wiuraxi meta nutuite.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mɨkɨ wahetsiemieme keneutaniukani 'aixɨa memɨ'itɨarienikɨ,","poem":1},{"text":"memɨkatehexeiya kenewanenimayaka memɨteheuyehɨwa wahetsie kenenuaka».","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Uka 'inɨari mayuyeitɨwa, ¿hakewa peikaxeiya?","poem":1},{"text":"Matsi kwinimieme katinaye'aka keyuri tetexi witsimɨ'anene waɨkawa mɨraye'atɨka,","poem":2},{"lineBreak":true},{"text":"yukie 'uyeikatɨ yapɨtikamie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kɨnaya matsi hetsiena kaneuwaɨreni,","poem":1},{"text":"tixaɨtɨ 'iwarika pɨkareuyehɨwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mɨkɨ naime kemɨtiyuriene 'aixɨa kani'aneni kɨnaya hetsiemieme,","poem":1},{"text":"'axapɨkatiyuriene kepaɨmexɨa tukari hamatɨana muyeikani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kanikuyeikani 'ikunanenetɨ muxa huxarieya meta rinu witsimɨ'ane 'ixurikiyari,","poem":1},{"text":"yumamakɨ tikumaɨwatɨ katini'uximayaka yutemawietɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kanuwa 'amɨpapa yuharerutamete hepaɨ kani'aneni,","poem":1},{"text":"mɨkɨ 'ateewa katinatɨtɨyeikani yu'ikwaite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ximeri paitɨ kananukukekani,","poem":1},{"text":"yuniwema katiniwarutimikwani,","poem":2},{"lineBreak":true},{"text":"meta yuparewiwamete yuhetsɨa miemete katiniwakumikwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kwie xeiyame kemɨraye'aka kaninanaimɨkɨ:","poem":1},{"text":"manata kaxie kanika'iteɨtamɨkɨ me'iwaxɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Yuwaɨriyatɨ katini'uximayaka,","poem":1},{"text":"ximeri meta kwi taikai katiniutahayeikawani ka'uxetɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Mɨkɨ yukɨmana katinimaika kemɨtiyuharerutani,","poem":1},{"text":"yukɨxeme pɨkakutɨtsa tɨkarikɨ yamɨti'uximayakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Xeitapakɨ yumamakɨ kaniwiyakamɨkɨ muxa huxarieya,","poem":1},{"text":"xeimekɨta 'utsikɨikɨ kanikaunakamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Yumamakɨ ti'uximayatɨ tixaɨtɨ memɨkatehexeiya kaniwaparewieka,","poem":1},{"text":"mɨkɨkɨ kaniwatuikani kemɨ'ane memɨteheuyehɨwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tsepa muhaɨtɨ pɨkayu'iyaritɨa yuniwema wahetsiemieme,","poem":1},{"text":"mɨkɨ yunaitɨ 'aixɨa memɨte'ukemarikɨ 'ɨkari memɨwawɨtɨatɨkakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"'Itsiwame yukɨmana mɨkɨ kanitiwipani,","poem":1},{"text":"meta rinu 'ixurikiyari 'aixɨa mɨ'anene kanitiwewiwani menakatɨkɨnikɨ meta mɨyɨtsikimaɨye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Meta kɨnaya 'aixɨa katinimariwani yukiekaritsie,","poem":1},{"text":"mɨkɨ katinihɨritɨarieka 'itsɨkate wahamatɨa hakewa mɨkɨ meme'uwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Rinu kemariyari wewietɨ kanituaka,","poem":1},{"text":"meta hɨiyamete mɨtiwewiyatɨka tetuayamete katiniwatuirieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"'Aixɨa katinamamatiwani meta teɨteri yunaitɨ 'aixɨa mepɨte'ixeiya,","poem":1},{"text":"mɨpaɨ 'anetɨ pɨkama kemɨtiyɨnikɨ 'uxa'atɨni warie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Kepauka mutikuxata, timaiwetɨ katinikuxatani,","poem":1},{"text":"kepauka mɨti'ɨkita, wanaki'erietɨ kaniyɨaneni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Yukie mɨkɨ yakatiniukani tanieretɨ,","poem":1},{"text":"kepauka paa mukwa'a me'iwaxɨkɨ katiniutikwa'ani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Tɨɨriyamama me'anuku'uwetɨ mekanitananakeni,","poem":1},{"text":"kɨnayata yaxeikɨa kaniyutemawieka 'inaki'erietɨ:","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"«Yuwaɨkawatɨ 'ukari 'aixɨa memɨte'u'iyari mekanixuaweni,","poem":1},{"text":"matsi 'ekɨ yunaime pekaniwara'iwani».","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Katiniyukwamanani kemɨ'ane witsimɨtiyuxexeiya xeikɨa meta pɨkareutetere,","poem":1},{"text":"matsi 'uka Yawé mayemakaxe 'aixɨa katinaniuwamɨkɨ hetsiena mieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"'Uka pumatiwani naitsarie kemɨtiukaxuxuawere,","poem":1},{"text":"meta 'uximayatsikayatsie naitɨ mɨtihekɨakɨ 'aixɨa pɨraniuwani.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":31}