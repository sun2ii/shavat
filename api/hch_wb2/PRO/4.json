{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":4,"content":[{"type":"heading","content":["Mɨtimaiwenikɨ mɨ'ayumieme matsi 'aixɨa kani'aneni"]},{"type":"verse","number":1,"content":[{"text":"Temari nemɨxenaki'erie, xekeneneu'eni rapaapa kemɨtiyu'ɨxatsitɨwa hepaɨ,","poem":1},{"text":"xekeneyuwaɨriyani waɨkawa xemɨtemaikakɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne nepɨxeyetuirieni 'ɨxatsi 'aixɨa manɨyɨtɨka,","poem":1},{"text":"'ayumieme ne'ɨkitɨarika xepɨkahatɨtɨmaiyani.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kepauka ne nemununutsitɨkaitsie nepaapa hetsɨa nepukatei,","poem":1},{"text":"meta nemaama nemuyuxewini hepaɨ pɨnetinaki'eriekai,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"nepaapa 'ipaɨ pɨnetiu'ɨxatsitɨa:","poem":1},{"text":"«'A'iyarikɨ keneu'eni 'ikɨ 'ɨxatsitɨarika,","poem":2},{"lineBreak":true},{"text":"yaketinekamieni ne'aitsikatsie, 'ana mɨixa wiyari pepuyeikani.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mɨtimaiwenikɨ mɨ'ayumieme kenekuwawa meta waɨkawa perakumaitɨ pemayanikɨ,","poem":1},{"text":"neniuki pepɨkahatɨtɨmaiyani, meta 'aheyemekɨ kena'eriwani.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mɨtimaiwenikɨ mɨ'ayumieme hatsuaku pepɨka'uku'e'eiriwani.","poem":1},{"text":"Mɨkɨ pɨmatsi 'awietani,","poem":2},{"lineBreak":true},{"text":"kenenaki'erieka mɨkɨta pɨmatsi'ɨwiyani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mɨtimaiwenikɨ mɨ'ayumieme yemekɨ peuyewetse pemɨtimaiwenikɨ 'ahetsie kenexeiyani.","poem":1},{"text":"'Ekɨ pemeitimaitɨyeikanikɨ kenekuwaɨneni keyuri piinitɨarika.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mɨtimaiwenikɨ mɨ'ayumieme waɨkawa keneku'eriwani, mɨkɨ matsi 'aixɨa perahɨawarɨwame kamenayeitɨamɨkɨ,","poem":1},{"text":"kene'awaɨriyani pemɨtimaiwenikɨ 'aixɨa pekatinitamatiwamɨkɨ,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'amu'utsie witsimɨ'ane pehanakekame pumatsi'ayeitɨani,","poem":1},{"text":"kuruna witsi'aneme kameniyetuiriemɨkɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Temaikɨ 'aku, keneu'eni neniuki,","poem":1},{"text":"hikɨ 'ana mɨixa wiyari 'apepuyeikani.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne nepɨmati'ɨkitɨa petimaiwetɨ 'apemuyeikanikɨ,","poem":1},{"text":"nepɨmetsi'uwitɨxime huye mɨheitserie pemuweiyanikɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kepauka mɨkɨ 'utɨa pemumienitsie, hawaikɨ pepɨkahekaweni,","poem":1},{"text":"tsepa pemunautsarɨme, pepɨkahetiketamɨre.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kenemɨmati'ɨkitɨa yuheyemekɨ kena'eriwani,","poem":1},{"text":"'aixɨa ketine'ɨwiyani ne'ɨkitsika mɨkɨ pɨ'atukari.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Axamemɨteyurie wahuye pepɨka'anukuweweiyani,","poem":1},{"text":"'axamemɨteyurie wahuyeta pepɨka'umieni.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mɨkɨ wahuye hepaɨtsita kene'a'ɨwiyani. Mɨkɨ 'utɨa pepɨka'umieni.","poem":1},{"text":"Mana pepɨka'uyeikani, keneuku'eiri.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"'Axateyuruwamete mepɨka'ukakukutsu xɨka 'akuxi 'axakatiyuriweni,","poem":1},{"text":"mepukakukutsu kepaukake xeime memɨka'una.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"'Axamɨti'ane kaniwa'ikwaitɨni,","poem":1},{"text":"meta nanaimarika kaniwawinutɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Heitseriemekɨ yamemɨtekahu wahuye witsipɨ'ane,","poem":1},{"text":"kepauka tau 'ɨrɨya ximeri manatinexɨaxime hepaɨ:","poem":2},{"text":"hekɨariya waɨkawa mɨhekɨariwiexime hepaɨ","poem":1},{"text":"kepaukake hekɨariya 'aixɨa tixawatɨtɨ mayani.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Peru 'axateyuruwamete wahuye mɨpaɨ pɨka'ane,","poem":1},{"text":"yɨriya kwinimieme mɨtiyɨwi hepaɨ pɨ'ane,","poem":2},{"lineBreak":true},{"text":"'atsimepɨkatemate ketitatsie memɨtehekaxɨrɨwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Temaikɨ 'aku, neniuki keneu'eni,","poem":1},{"text":"'a'iyarikɨ keneu'ena.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hawaikɨ neniuki pepɨkaheuyehɨpani,","poem":1},{"text":"'a'iyaritsie yemekɨ keneye'ɨnani.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mɨkɨ kemɨ'ane memikaxexeiya tukari kaniwapitɨaka,","poem":1},{"text":"'Aixɨa pemɨreu'eriekakɨ 'awaiyaritsie meta 'a'iyaritsie kani'ayumiemetɨni.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Matsi 'a'iyari kene'ɨwiyani tinaime piinitɨarika hepaɨtsita,","poem":1},{"text":"mɨkɨ hetsie tukari mayeneikakɨ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"'Atetakɨ keneyu'ɨwiyani 'axapemɨkatikuxatanikɨ,","poem":1},{"text":"kemɨkatiheitserie petikuxatatɨ ketineuhayewa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Heitseriemekɨ pɨta keneutaniereni,","poem":1},{"text":"tita pemɨtixeiya mɨkɨkɨ kene'a'ɨwiyani.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"'Ahuye kene'ɨwiyani kepemɨtimie,","poem":1},{"text":"keneheitseritɨaka naime 'ahuye.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Heitserie keneumieni 'a'utata pepɨkaheukuyuyuipikeni meta 'atserieta.","poem":1},{"text":"'Axamɨti'ane ketineuku'eiri.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}