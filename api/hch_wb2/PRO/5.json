{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":5,"content":[{"type":"heading","content":["Mari'itɨarika kayɨ'ɨya kayɨkɨna hepaɨtsita"]},{"type":"verse","number":1,"content":[{"text":"Temaikɨ, keneneu'eni kenemɨtimaiwe,","poem":1},{"text":"Yemekɨ keneu'ena heitserie kemɨtikamieni,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"merikɨte kepauka pemɨtikuxatanitsie","poem":1},{"text":"petimaiwetɨ ketinekuxatani.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Uka mɨka'a'ɨya tenieyatsie xiete kaniuhaneni,","poem":1},{"text":"nenieya matsi witsiputaine, keyuri huriwa hatseitiyari.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Peru 'imatɨriekake matsi waɨkawa hatsiwitɨ payeika keyuri tsiɨrika,","poem":1},{"text":"meta kwinimieme pɨrataxikaunare keyuri 'ixipara naitsata meutixikakauni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mɨkɨ mɨkite watsata kaniumieni,","poem":1},{"text":"mɨkɨ mɨki teukiyapa kaneyani.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Etsiwa tɨma tukari huyeyari pɨkamate,","poem":1},{"text":"yakɨxeikɨa puyeika 'atsikatimaitɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Neuxei, temaikɨ 'aku, keneneu'eni,","poem":1},{"text":"neniuki pepɨkahatɨtɨmaiyani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mɨkɨ 'uka mɨka'a'ɨya pepɨka'enieka,","poem":1},{"text":"'ahurawa kiteniena tɨma pepɨkaye'axeni,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Atɨrɨkariya peyetuayu kapa petiutakwine,","poem":1},{"text":"kapa 'atukari memayu'eririya wahetsɨa peyetuani,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'atumini waɨriyarika peme'iwaxɨ kapa hipame wahetsiemieme rayanikɨ,","poem":1},{"text":"kapa hipame wakiita tiyuhayewanikɨ titapemɨra'iwaxɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Imatɨarieka tixaɨtɨ pekarexeiyatɨ pepɨtatsuani,","poem":1},{"text":"kepauka haweri pe'anetɨ pemayani tixaɨtɨ pekarexeiyatɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"'Anake mɨpaɨ pekanitayɨmɨkɨ: «Titayari 'ɨxatsi nekatiu'eni kemɨtikuxaxatsiwakai.","poem":1},{"text":"Titayari ne'iyaritsie netitatawe'eri mɨkɨ 'ɨkitɨarika.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nepɨka'i'eni nete'ɨkitɨwamete waniuki,","poem":1},{"text":"hatsuaku nepɨkawaru'eni nete'ɨkitɨwamete.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hikɨri yemekɨ kwinimieme haweri 'anekɨa nekaniyuhayewa,","poem":1},{"text":"yunaime teɨteri wahɨxie».","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Haa 'ahaputsuta mieme xeikɨa kenehareka,","poem":1},{"text":"haa 'ahaixata maneika xeikɨa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"¿'Ahaa kaye'utɨma mɨtayeuriweni metinake","poem":1},{"text":"metatsiere 'ahaa 'ahaixata mieme teɨteri memayukuxexeɨriwatsie mɨtayeuriweni metinake?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mɨkɨ haixa katini'apiinitɨni, 'ekɨ xeikɨa,","poem":1},{"text":"hawaikɨ pɨkayɨwe hipame pemɨwaharitɨaka.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"'Aixɨa ke'itɨarieka 'a'ɨya.","poem":1},{"text":"Kene'atemawieka temaikɨyari pemitiwitɨ hamatɨa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Maxa witsimɨti'ɨimari hepaɨ kani'aneni,","poem":1},{"text":"kapura yeutanaka 'ɨimari hepaɨ kani'aneni mɨtiyukanaki'erie.","poem":2},{"text":"Naki'eriyaya kematsitemawieritɨaka.","poem":1},{"text":"Naki'eriyaya yuheyemekɨ 'ahetsie ketiwiyani.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"¿Temaikɨ 'aku, titayari peti'awaɨriyani 'uka mɨka'a'ɨya hamatɨa?","poem":1},{"text":"¿Titayari xeime 'ɨyaya naki'eriyaya petikuwauneni?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tahuyeta ketemɨteyurie Yawé naime kanixeiyani,","poem":1},{"text":"tahuye naime kanimaika.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"'Axatiyuruwame yɨkɨmana puyuwiniya 'axatiyurienetɨ,","poem":1},{"text":"'axamɨti'ane mɨrexeiya kaunariyari mɨkɨ kanenutahɨaximeni.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mɨpaɨ mekatenitakukuweni memɨkayɨ'ɨxatsitɨarinɨa,","poem":1},{"text":"kanimɨmɨkɨ mɨkaheu'enakɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/4.json","previousChapterAudioLinks":{},"numberOfVerses":23}