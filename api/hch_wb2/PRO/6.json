{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":6,"content":[{"type":"heading","content":["Mari'itɨarika mɨkaheu'ena hepaɨtsita"]},{"type":"verse","number":1,"content":[{"text":"Temaikɨ 'aku, xɨka xewitɨ pemimate matsi'inieka hetsiena mieme pemɨrayukatuanikɨ,","poem":1},{"text":"xɨka pemɨka'imate kename pera'akatuani petitahɨawe,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"xɨka 'aniuki 'anatiyani kename yapetikayani,","poem":1},{"text":"pekaniyutahɨamɨkɨ 'aniukikɨ,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"merikɨte 'ahepaɨ tewi kameniuwiniya.","poem":2},{"text":"Temaikɨ 'aku, xɨka peyuxɨnamɨkɨni, 'ikɨ huye kanihɨkɨtɨni:","poem":1},{"text":"Xeiya kenemie hetsɨana tixaɨtɨ pekarayuyeitɨatɨ,","poem":2},{"lineBreak":true},{"text":"tɨratu kepemɨtiuwewi keneutawawiri pemɨtihayewanikɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pepɨkakutsuni,","poem":1},{"text":"kenayeniereni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Keneu'ata'una maxa mɨtiutananautsa hepaɨ hupierienetɨ,","poem":1},{"text":"meta wiki winiyari mɨtiutawikweiya hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"'Ekɨ pemɨ'a'ɨraxie, paratsɨ tsarɨ keneuxeiya.","poem":1},{"text":"Mana keneye'ɨki kemɨtiyuriene petimaiwetɨ pekanayeimɨkɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mɨkɨ mepɨkaheixeiya kemɨ'ane mɨwanɨ'a,","poem":1},{"text":"meta kemɨ'ane mɨtiwa'aitɨa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mɨkɨ yunaitɨ, witarita mekateniuka'utani,","poem":1},{"text":"'itsanaxa yu'ikwaite mekateniuka'utani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"'Ekɨ pemɨ'a'ɨraxie, ¿kepaɨmexɨa 'akuxi mɨpaɨ pepɨtiuhupuni?","poem":1},{"text":"¿Kepaukake tamɨ pepanutaniere?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Etsiwa peheukukutsutɨ,","poem":1},{"text":"'etsiwa pe'uka'uxipiwetɨ, meta 'atapa pe'awietɨ,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"tinawayame hepaɨ katininuamɨkɨ tixaɨtɨ pekarexeiyatɨ pemayani,","poem":1},{"text":"tewi titakɨ mɨramieni 'akwetɨ 'ahetsɨa munuani hepaɨ katininuamɨkɨ haakaxa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"'Axamɨtiuka'iyari tewi mɨka'uyukatewiya,","poem":1},{"text":"ti'itawatɨ xeikɨa kanikuyeikani tsepa hakewa,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"mɨpaɨ mepɨtekuxata yu'iwama wahamatɨa 'iyari mewewietɨ,","poem":1},{"text":"yu'ɨkatekɨ meta yu'itɨwamekɨ mekaniku'inɨaritani xeikɨa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Axamɨtiyuriene kaniyu'iyaritɨaka 'axamɨti'anekɨ xeikɨa,","poem":1},{"text":"meta kanikuwauneni mɨpaɨ tiyuhaxɨatɨamɨtɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Ayumieme yapauka haweri katiniwakuyuruwani,","poem":1},{"text":"yapauka 'ana kanika'unariemɨkɨ pɨkayɨwekaxɨani yuheima mɨtanuanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"'Ataxewitɨ kanixuaweni teɨteri kememɨteyurie Yawé mi'uxiwe'erie,","poem":1},{"text":"meta xeime matsi mixani'erie:","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"yuhɨxitekɨ kwinie memɨte'uneniere,","poem":2},{"lineBreak":true},{"text":"yunenikɨ memɨte'itawa,","poem":2},{"lineBreak":true},{"text":"yumamatekɨ 'axamɨkatiuka'iyari xuriyaya mɨtayeuriwa,","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"yu'iyaritsie mɨtiha'aritɨa 'axatiyurimɨtɨ,","poem":2},{"lineBreak":true},{"text":"yu'ɨkatekɨ xeikɨa mɨyumexɨitɨa 'axamɨtiyurienenikɨ,","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"kemɨtiunierixɨ ti'itawatɨ mɨtikuxata,","poem":2},{"lineBreak":true},{"text":"meta kemɨ'ane yu'iwama mɨwakwamana memuyukwitɨwenikɨ.","poem":2}]},{"type":"heading","content":["Mari'itɨarika xeime kɨnaya 'ɨyaya hepaɨtsita"]},{"type":"verse","number":20,"content":[{"text":"Neuxei temaikɨ, 'apaapa 'aitsikaya naime kenaye'atɨwani","poem":1},{"text":"meta 'amaama 'ɨkɨtɨarikaya pepɨkahehɨpani.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"'A'iyaritsie kenaka'utɨa,","poem":1},{"text":"kenakatɨkɨni kuka hepaɨ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kepauka pemukuyeika 'apaapa meta 'amaama wa'aitsika pɨmatsi'uwitɨximeni,","poem":1},{"text":"kepauka pemukutsu wahɨritɨarika pɨmatsi'ɨwiyani,","poem":2},{"lineBreak":true},{"text":"meta kepauka pemanutanieretsie, 'ahamatɨa memɨtekuxatani hepaɨ kani'aneni yu'aitsikakɨ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kɨxeme kanihɨkɨtɨni 'aitsika,","poem":1},{"text":"meta 'ɨkitɨarika hekɨariwiwame kanihɨkɨtɨni,","poem":2},{"lineBreak":true},{"text":"'ɨxatsitɨarika tukari huyeyari kanihɨkɨtɨni pemɨkaheuyewenikɨ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mɨkɨ 'ɨxatsi pɨmatsi'ɨwiyani 'iya 'uka hepaɨtsita 'axamɨtiuka'iyari,","poem":1},{"text":"xewitɨ mɨka'a'ɨya, yuniukikɨ mɨtiyuwiniya hepaɨtsita.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"'A'iyaritsie pepɨka'ihiwe'erieka witsimɨti'ɨimarikɨ,","poem":1},{"text":"kene'akweriwayurieka yuhɨxitekɨ metsi'uwiniyakɨ,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"karikɨ 'uka tuminikɨ muyuwitɨnɨa 'atumini xeikɨa kanitixɨtɨamɨkɨ,","poem":1},{"text":"meta xɨka xeime 'ɨyaya peyurieneni kɨnaya 'atukari pumatsinawairieni.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"¿Kepaikɨ pɨyɨwe tɨɨ yutawitsie mayatsa,","poem":1},{"text":"kamixaya kahataiyatɨ?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"¿Kepaikɨ pɨyɨwe matitɨɨyatsie muyeyani,","poem":1},{"text":"kakukwaxiketɨ?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Kamɨtsɨta kemɨ'ane xeime 'ɨyaya mukumayɨani,","poem":1},{"text":"hamatɨana mɨkahuni hetsienatsɨ pɨrahɨiyani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"'Axapɨkatiyuxexeiya xewitɨ tinawanetɨ,","poem":1},{"text":"mɨyehaakamɨnekɨ xeikɨa,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"xɨka 'uwiyarieni, matsi katiniyetuamɨkɨ,","poem":1},{"text":"'atahutamexɨatsie timieme mɨtiunawakɨ,","poem":2},{"lineBreak":true},{"text":"matsi yupiinite naime katininawaiyariemɨkɨ.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Peru matsi kemɨ'ane xeime 'ɨyaya meta kɨnaya mukumaɨwa, pɨkaheitimaitɨyeika,","poem":1},{"text":"kemɨ'ane mɨpaɨ mɨtiuka'iyari yɨkɨmana kaniyukamiemɨkɨ.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Katinikwinitɨariemɨkɨ kanitewiyatsitɨariemɨkɨ,","poem":1},{"text":"meta hatsuaku pɨkaratɨmaiya kemɨtiuyuri.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Meta 'uki kaniha'akamɨkɨ 'ɨyaya munanaimakɨ,","poem":1},{"text":"kepauka 'uki mɨyɨkɨhɨani 'anatukaritsie pɨkareiyehɨwirieni.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"'Uki mɨnanaimarie tixaɨtɨ pɨkatitanaki'erieni,","poem":1},{"text":"tsepa witsiti'aneneme mɨtiyexatɨarie, mɨkɨkɨ pɨkayukatemawieni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}