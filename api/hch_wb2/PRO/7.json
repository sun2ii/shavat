{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":7,"content":[{"type":"heading","content":["Mari'itɨarika xeime 'ɨyaya hepaɨtsita"]},{"type":"verse","number":1,"content":[{"text":"Temaikɨ, ne'ɨkitsikatsie yaketinekamieni,","poem":1},{"text":"meta ne'aitsika keneuti'uta 'a'iyaritsie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yaketinekamieni kenemɨti'aita pe'ayenieretɨ 'apekaniuyeikamɨkɨ,","poem":1},{"text":"ne'ɨkitsika kene'ɨwiyani 'ahɨxi mɨyɨwi kepemɨtikweriwayurie hepaɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'A'itɨwametetsie keneutapietɨkani,","poem":1},{"text":"kenaka'utɨa 'a'iyaritsie paitɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Titakɨ yapemɨtimaiwe mɨkɨ pumatsiparewieni yaxeikɨa 'akuri hepaɨ,","poem":1},{"text":"titakɨ kepemɨtimate mɨkɨ pumatsiparewieni kemɨ'ane pemumate hepaɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mɨkɨ mepɨmatsixɨna 'ukaratsi mɨka'a'ɨya hepaɨtsita,","poem":1},{"text":"meta 'uka mɨwikie hepaɨtsita pepɨ'a'ɨwiyani witsitikuxatakaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Heiwa nekiita ne'ayekaitɨ","poem":1},{"text":"'itupari 'etsimayewatsie neheunieretɨ,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nepɨne'ɨwiyaxɨ temari memɨka'u'iyari wahetsie,","poem":1},{"text":"mɨkɨ temari watsata xeime kwi nepuxei","poem":2},{"lineBreak":true},{"text":"xeime yemekɨ 'atsimɨkatimate.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kayetsie kananuyani, 'etsikina kaniye'ani,","poem":1},{"text":"hikɨ 'anɨari 'umietɨ 'ukaratsi kiiya hepa kaneyani.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hikɨ kanikɨyɨrirɨmekaitɨni.","poem":1},{"text":"'Ari waɨkawa 'ukuyɨrekuri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yapauka 'ukaratsi kanewayeyani 'enukunakeke,","poem":1},{"text":"'uka tuminikɨ muyuwitɨnɨa hepaɨ reyukukemaritɨatɨ,","poem":2},{"lineBreak":true},{"text":"yuhetsie pɨkamatsiɨkɨkai kemɨtiyurienikekai.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"(Mɨkɨ 'uka waɨkawa pɨtikuxata 'utahiwatɨ hipame kawa'enietɨ,","poem":1},{"text":"mɨpaɨ memɨ'anene 'ukarawetsixi yukiita yemekɨ mepɨkahayetei.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kaye'utɨma mepu'uwa meta teɨteri memayuxeɨrietsie,","poem":1},{"text":"meta yamepɨtehupa 'itsikinatsie).","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hikɨ yapauka temaikɨ kananakawiyatɨyani meta kani'itseni,","poem":1},{"text":"metatsiere kayukatewiyakamekɨ mɨpaɨ katinitahɨawe:","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Nekiita 'aixɨa memɨteyuxeiyanikɨ mawariyari nekanexeiyani,","poem":1},{"text":"tɨratu nemuwewiekai nekakaɨyari hamatɨa hikɨri nekatinaye'atɨani.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Ayumieme nepeyetɨa nepɨmatsihekunakixɨ,","poem":1},{"text":"nepɨmatsikuwaunekai, 'ari nepɨmatsi'ukaxei.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ne'utatsie nekaneika'ita","poem":1},{"text":"rinu 'ixurikiyari waɨkawa mɨti'utɨka 'Ekipitu miemekɨ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nemukahuputsie witsimu'ɨa nekaneukawirieni,","poem":1},{"text":"mixaxi witsimu'ɨa, 'aruhe meta kanera.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hikɨmɨ, naki'eriya tekɨxi winuyari naime tepanu'ieni,","poem":1},{"text":"naki'eriyakɨ tepuyutitemamawieni tsepa temukatariyarie.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nekɨna yukie pɨka'uka,","poem":1},{"text":"kanayeyani hikɨ 'ateewa paitɨ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yutumini waɨkawa kane'ɨni,","poem":1},{"text":"kwitɨwa pɨkanuani xeimetseri kaneyurimɨkɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Mɨpaɨ witsitikuxaxatɨwatɨ,","poem":1},{"text":"kanikemakaxɨani.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hikɨ 'ana 'utɨmana kaneyani,","poem":1},{"text":"tuuru huyeta metɨa hemierienike hepaɨ,","poem":2},{"text":"maxa winiyaritsie muyewierixɨ hepaɨ,","poem":1}]},{"type":"verse","number":23,"content":[{"text":"'ɨrɨkɨ mumɨiya yutawitsie,","poem":2},{"text":"wiki winiyaritsie muyewierixɨ hepaɨ,","poem":1},{"text":"'atsikatimaitɨ mana yutukari kanitatɨmaiyamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"'Ayumieme hikɨ temaikɨ, keneneu'eni,","poem":1},{"text":"neniuki yemekɨ keneu'eni.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"'A'iyari xaɨtsie pɨka'uyuyuipikeni 'uka kemɨmetikɨhɨawekɨ,","poem":1},{"text":"mɨkɨ 'ɨxatsieya huyeyari 'utɨa pepɨkaheuyewautseni,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"karikɨ yumɨiretɨ mɨpaɨ mekateniukwini,","poem":1},{"text":"mepuyumɨire kɨmana memukwi.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kiitana mɨki teukiyapa kanihɨkɨtɨni,","poem":1},{"text":"yunaitɨ muwa memɨtahake mepɨtakukuwe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}