{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":8,"content":[{"type":"heading","content":["Kemɨti'inie mɨtimaiwenikɨ mɨ'ayumieme"]},{"type":"verse","number":1,"content":[{"text":"Mɨtimaiwenikɨ mɨ'ayumieme 'uka hepaɨ kani'inieka.","poem":1},{"text":"Mɨtiuyemaikakɨ mɨ'ayumieme waɨkawa kanahiwani.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mɨtimaiwenikɨ mɨ'ayumieme wapaitɨ kanakekani,","poem":1},{"text":"meta huye 'utɨa kaniutakekani teɨteri wahamatɨa tikuxatatɨ, meta huye manuyunanaketsie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kiekari kitenieyaritsie 'utakekatɨ,","poem":1},{"text":"karima kanahiwani mɨpaɨ 'utaitɨ:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"«Xeme teɨteri, nekatinixekɨhɨaweni,","poem":1},{"text":"nekanixehahɨaweni xeyunaime teɨteri.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xeme 'atsixemɨkatemate, xetemaiwawetɨ xekenayuyeitɨa.","poem":1},{"text":"Xeme xemɨkayuwaɨriya xemɨteyɨ'ɨkitɨakakɨ, xeheitimaitɨkɨkatɨ xekenakɨni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xekeneneu'eni, waɨkawa tita mɨreuyewetse nepɨtitaxata,","poem":1},{"text":"nepɨtitaxata kemɨtiheitserie.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne netetakɨ tita mɨtiyuri xeikɨa nepɨtikuxata,","poem":1},{"text":"yaxeikɨa neteni 'itarika kanixani'erieka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Niuki neteta mayeneika naitɨ 'aixɨa pɨ'anene,","poem":1},{"text":"nitixaɨtɨ 'axamɨti'ane pɨkatinɨ'ɨ ninanaimarika.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kanihekɨaka neniuki memɨtemaiwawe wahetsiemieme,","poem":1},{"text":"meta kaniyuritɨni memɨtemate wahepaɨtsita.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne'ɨkitsika pɨta xekeneutanaki'eri pɨrata pɨkatixaɨ,","poem":1},{"text":"kenemɨtimaiwe xekeneutanaki'eri pɨkatixaɨ huru.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mɨtimaiwenikɨ mɨ'ayumieme matsi waɨkawa katinaye'aka keyuri tetexi witsimɨ'anene,","poem":1},{"text":"tsepa tita witsimɨti'ane hepaɨna pɨka'ane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"»Ne, mɨtimaiwenikɨ, nemɨ'ayumieme mɨtiuyematekɨ hamatɨa nekaniuyeikani,","poem":1},{"text":"kepauka yɨkɨnemɨtiyurieni nekanine'iyaritɨaka meri.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kemɨ'ane Yawé mayemakaxe, mɨkɨ 'axamɨti'ane pɨtixani'erie,","poem":1},{"text":"ne muyuta'ɨrenikɨ nekani'uxieka meta nanaimarika,","poem":2},{"lineBreak":true},{"text":"'aixɨa 'anemekɨ mɨka'uyeika meta niuki 'axamanɨyɨtɨka.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Ɨkitɨarika nehetsie kanayeneikani meta tita mɨtiheitserie,","poem":1},{"text":"nehetsie kanayeneikani petimaiwetɨ pemayanikɨ meta pemɨtɨrɨkaɨyenikɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Newaparewiekaku te'aitamete mekateni'aitani","poem":1},{"text":"meta kuwexinaruritsixi 'aitsika 'aixɨa 'aneneme mekanitiwewiwani.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Te'aitamete mexɨakate nekɨmana mepɨteha'aita","poem":1},{"text":"meta 'itsɨkate naitsarie kwiepa nepuwaranuka'uitɨwa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kemɨ'ane memɨnetsinaki'erie, neta nekaniwanaki'erieka,","poem":1},{"text":"kemɨ'ane memɨnetsikuwautɨwe, ne nematsiɨkɨme nepaneyeitɨwa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nehetsɨa waɨkawa mɨrexeiyanikɨ kanixuaweni meta 'aixɨa pemɨramamatiwanikɨ,","poem":1},{"text":"waɨkawa pepɨtiukaxexeiyani meta 'atiteriwemekɨ pepɨrexeiyani.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Pemɨtimaiwenikɨ mɨ'ayumieme yanematipitɨakaku matsi 'ikwaxi 'aixɨa mɨ'ane kanihɨkɨtɨni keyuri huru,","poem":1},{"text":"ne'iwarika matsi 'aixɨa pɨ'ane keyuri pɨrata.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Tita mɨtiheitserie hetsie nekaniumieni,","poem":1},{"text":"'aixɨa mɨti'ane hetsie nekananiukani,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"waɨkawa nepɨtiyetuirie kemɨ'ane mɨnetsinaki'erie,","poem":1},{"text":"meta waɨkawa mɨrexeiyanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"»Yawé pɨnetsi'utawewi mexɨakame wewiyaya nemayanikɨ,","poem":1},{"text":"matsi meripaitɨ timieme 'akuxi hipame katitiwewiwetɨ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ne matsi yemekɨ meripaitɨ nekaniunetɨarieni,","poem":1},{"text":"meripaitɨ kwie 'akuxi kanetɨariewekaku.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kepauka nemunetɨarietsie haramara mumariwe pumawekai,","poem":1},{"text":"meta 'ana haixa pumawekai waɨkawa 'uhanetɨ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nekaniutinuiwa meripaitɨ 'akuxi yemurite kanetɨariewekaku,","poem":1},{"text":"meta hɨri tsutɨmeyari 'umawekaku,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"meripaitɨ mɨkɨ kwie kanetɨariewekaku meta mana witsikemutiu'ane","poem":1},{"text":"metatsiere 'akuxi kwie tumuanariyari mexɨakame kanetɨariewekaku.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ne nepunierixɨ kepauka Kakaɨyari muyuawi 'amuyematsie,","poem":1},{"text":"meta haramara heima ketewa 'atɨ muyuxeiyanɨa muka'inɨaritaxɨtsie,","poem":2},{"lineBreak":true},{"text":"ne 'ana nepɨtanierekai.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kepauka muyuawitsie haiwitɨri muyeye,","poem":1},{"text":"meta haixate tɨrɨkawime metinetɨaxɨa haramara 'ameukatewatsie,","poem":2}]},{"type":"verse","number":29,"content":[{"text":"kepauka haramara mupitɨa hakewa meye'atɨkani,","poem":1},{"text":"meta 'aitsikaya meu'eniekakɨ,","poem":2},{"text":"kepauka kwie tsutɨmeyari mukayatsaxɨtsie,","poem":1}]},{"type":"verse","number":30,"content":[{"text":"ne 'ana nepɨnierekai, 'uximayatsikaya 'aixɨa nepɨyuriekai.","poem":2},{"text":"Tukari mɨyehane ne waɨkawa nepɨnetemawiekai,","poem":1},{"text":"temawierika nepexeiyakai hɨxiena ne'uyeikatɨ,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"kwie mɨkɨ mutawewikɨ nepɨnetemawiekai,","poem":1},{"text":"meta teɨteri memunetɨariekɨ nepɨnetemawiekai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"»Hikɨ 'ayumieme, temari 'aku, xekeneneu'eni:","poem":1},{"text":"'aixɨa mepɨ'itɨarieni kemɨ'ane nehuye 'utɨa memuhuni.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ne'ɨxatsi xekeneu'eni meta xeketenemaiwaweni,","poem":1},{"text":"hawaikɨ xepɨka'itawe'erieka temaiwawemete wa'ɨkitsika.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"'Aixɨa mepɨ'itɨarieni kemɨ'ane memɨnetsi'enie,","poem":1},{"text":"kemɨ'ane nekitenie memutatei tukarikɨ meta'enanatɨ,","poem":2},{"lineBreak":true},{"text":"mɨranutakɨkatɨretsie meta'ikwewatɨ.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Yuri nekanaineni, kemɨ'ane mɨnetsikaxeiya, tukari kanikaxeiyamɨkɨ,","poem":1},{"text":"metatsiere Yawé 'aixɨa kaniyurimɨkɨ.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Kemɨ'ane mɨkanetsitanaki'erieni, mɨkɨ yɨkɨmana kaniyutsewiximamɨkɨ,","poem":1},{"text":"kemɨ'ane mɨnetsitixani'erieni, mɨkɨ mɨɨya pɨta kaninaki'erieka».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}