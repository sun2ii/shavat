{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PRO","translationId":"hch_wb2","name":"Temaiwawemete","commonName":"Temaiwawemete","title":"Temaiwawemete kememɨte'ɨ'ɨxatsita","order":20,"numberOfChapters":31,"sha256":"c39ced8f8af5168495e402741b8042baae3a6237416d3778e990231bc7bffb3a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/hch_wb2/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":9,"content":[{"type":"heading","content":["Mɨtimaiwenikɨ mɨ'ayumieme kemɨti'inie meta mɨkatimaiwe"]},{"type":"verse","number":1,"content":[{"text":"Mɨtimaiwenikɨ mɨ'ayumieme 'uka hepaɨ yukii kaniutawewieni","poem":1},{"text":"meta 'atahutame mituikatɨka kaniutiwewieni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hikɨ 'ixɨarari kaniukuha'aritɨani, kaxie winuyari kaniukawewieni","poem":1},{"text":"meta mexatsie 'aixɨa katiniupini.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kaniwarutanɨ'ani 'ukari mɨtiwa'aitɨa, 'emanutitewatsie","poem":1},{"text":"kiekaritsie mɨpaɨ memɨteheukahiwakɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"«Nehetsɨa xekeneu'axɨa xemɨkatemaiwawe,","poem":1},{"text":"xeme temari peuyewetse xemɨtemaika.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xekenakɨni, nepaa xekena'inɨata","poem":1},{"text":"meta kaxie winuyari nemikawewi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Atsixekatemaitɨ xeketeneuhayewa, hikɨ 'ana xekanayenenierekakuni,","poem":1},{"text":"timaiweme huyeya 'utɨa xekeneuhuni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"»Kemɨ'ane mɨtiyuyuriya mɨta'ɨxatsitɨani mɨkɨ pɨtatierieni xeikɨa,","poem":1},{"text":"kemɨ'ane mɨtiyukatawe'erie mɨtaheitseritɨani mɨkɨ pɨtananaimarieni xeikɨa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mɨtiyukatawe'erie pepɨka'ɨxatsitɨaka kapa metsi'uti'uxiwe'erieni,","poem":1},{"text":"'aixɨa pɨyɨni xɨka mɨtimaiwe pe'uta'ɨxatsitɨani, mɨkɨ hɨrixɨa matsinaki'erietɨ payani.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mɨtimaiwe keneuta'ɨxatsitɨa, hikɨ mɨkɨ waɨkawa timaiwetɨ kanayeimɨkɨ,","poem":1},{"text":"heitserie yamɨtikamie ketineuta'ɨkitɨa, hikɨ mɨkɨ waɨkawa timaitɨ kanayeimɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"»Kemɨ'ane timaiwetɨ meuyeimɨkɨ ke'itsutɨani meri Yawé 'ayemakatɨ,","poem":1},{"text":"xɨka Kakaɨyari Mɨpatsie maika mɨkɨ pɨtimaiweni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nehetsie petiwiyakaku, 'atukari nepɨtimɨiriya,","poem":1},{"text":"nehetsie petiwiyatɨ waɨkawa wiyari pepɨtihuni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xɨka petimaiweni, 'a'iwarika kanihɨkɨtɨni pemɨtimaiwenikɨ,","poem":1},{"text":"xɨka memɨtemaiwawe pewatawe'erieka mɨkɨkɨ 'ekɨ pekatinika'eniexɨamɨkɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"'Uka mɨka'uka'iyari, 'axakatiniuka'iyarini,","poem":1},{"text":"mɨkayɨkɨhɨawe meta pɨkayukatewiya.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yukitenie kanayeyeixani,","poem":1},{"text":"xɨkata kiekaritsie 'uyeikani waɨkawa teɨteri memaxuawetsie kaniyeixarini,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"meta kaniwa'iniwani kɨkamete","poem":1},{"text":"yuhuyeta mɨheitserietsie me'uhukaku.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"«Nehetsɨa xekeneu'axɨa xeme temari","poem":1},{"text":"yakɨ xeikɨa xemɨteyurie.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Haa 'inawariekame matsi yemekɨ witsipa'ane.","poem":1},{"text":"Paa matsi witsikana'aneni xiete hepaɨ xɨka 'itikwani 'awie».","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Perɨ mɨkɨ 'atsimepɨkatemate xɨka kiitana mɨki 'ayekani,","poem":1},{"text":"mɨkɨ 'inierimama 'atsimepɨkatemate xɨka mɨki teukiyata meheukaxɨrɨweni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}