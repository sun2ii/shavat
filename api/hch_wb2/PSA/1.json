{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"'Aixɨa kani'itɨarieka tewi","poem":1},{"text":"kemɨ'ane 'axamemɨte'u'iyari wa'ɨxatsi mɨka'enie,","poem":2},{"lineBreak":true},{"text":"meta 'axamemɨteyurie wahuyeta mɨka'umie","poem":2},{"lineBreak":true},{"text":"meta 'axamemɨteniniuki wahamatɨa mɨkayuxewiriya,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"matsi Yawé 'aitsikayatsie pɨta muyutemawieritɨa,","poem":1},{"text":"miku'eriwa tukarikɨ meta tɨkarikɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mɨkɨ kɨye hepaɨ kani'aneni","poem":1},{"text":"hatetsita muka'iteɨtsie hepaɨ","poem":2},{"text":"kepauka tukarieya maye'axe kaniukaxuxuawereni","poem":1},{"text":"xawariyari hatsuaku pɨkatiyɨnare.","poem":2},{"lineBreak":true},{"text":"Naimekɨ kemɨtiyuriene 'aixɨa pɨtikuyɨne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Peru, 'axamemɨte'u'iyari","poem":1},{"text":"xatsi 'eka miku'enitsitɨane hepaɨ mekani'aneneni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Ayumieme kepauka 'axateyuruwamete memetahɨawarieni mepanutaxɨriyani,","poem":1},{"text":"meta 'aixɨa memɨtekakɨ memayuxeɨrie mana 'axamemɨteyurie mepɨkahepitɨarieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yawé 'aixɨa memɨte'u'iyari wahuye kani'ɨwiyani,","poem":1},{"text":"'axamemɨteyurie matsi wahuye kanitatɨmaiyariemɨkɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}