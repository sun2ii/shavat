{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"¿Yawé, titayari 'ateewa paitɨ petiuyeika?","poem":1},{"text":"¿Titayari kepauka temɨte'uka'eniwatsie petiu'ati'awiwieta?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kwinimieme tiha'atɨ tiyumiekame mɨkayɨhɨawe kaniuweiyani,","poem":1},{"text":"peru hatsuaku yuwiniyaritsie kaniyuhɨamɨkɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Axatiyuruwame tita mɨtihiwe'erie mariweme pɨrayeitɨwa,","poem":1},{"text":"naime mɨtihiwe'erie hepaɨtsita 'aixɨa putaine Yawé xani'erietɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Axatiyuruwame teikɨ peneniere 'uyuta'ɨretɨ,","poem":1},{"text":"'etsiwatɨma Kakaɨyari pɨkaku'eriwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Naitɨ 'uximayatsikayatsie 'aixɨa pɨtikuyɨne,","poem":1},{"text":"peutiteewa meta peteewa hetsiena mieme 'a'aitsika metimanikɨ,","poem":2},{"lineBreak":true},{"text":"pɨwananaima kemɨ'ane mɨwaraye'unie.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mɨpaɨ katiniyukɨhɨaweni: «Nitixaɨtɨ pɨkanerekahɨani.","poem":1},{"text":"Yanetinetemawietɨ 'anepuyeikani. Hatsuaku 'uximatɨarika nepɨkahekaxeiya».","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Axaniuki tetana kanihɨneni,","poem":1},{"text":"'itarika meta tierika,","poem":2},{"lineBreak":true},{"text":"yunenitɨa katini'awietani 'axamɨti'ane meta nanaimarika.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kaniutihupani kiekari 'etsimɨyeyeutsie,","poem":1},{"text":"kaniuyuti'awiwietani mɨwakwinikɨ hipame,","poem":2},{"lineBreak":true},{"text":"kaniwatakukuyani 'atsimemɨkateyurie 'atsimemɨkayɨa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Maye hepaɨ terɨta payehupu","poem":1},{"text":"mɨkayɨhɨawe hupietɨ 'iwiyake,","poem":2},{"lineBreak":true},{"text":"heimana 'uweme yuwiniyaritsie kanihanimɨkɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Waɨkawa mɨtɨrɨkaɨyekɨ","poem":1},{"text":"'imierimama kwiepa menatixɨrɨweni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mɨpaɨ kaniutaineni yuxaɨta: «Kakaɨyari pɨkawara'eriwa teɨteri.","poem":1},{"text":"Yuhɨxie kaneuyukunaka, tixaɨtɨ pɨkatixeiya».","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Xeiya, Yawé.","poem":1},{"text":"Kakaɨyari, ketaneuparewi.","poem":2},{"lineBreak":true},{"text":"Memɨkayuhɨawawe pepɨkawaratɨtɨmaiyani.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Axapɨmatikumamateke 'axatiyuruwame.","poem":1},{"text":"Mɨpaɨ pɨtiku'eriwa kename 'atsipeka'iyurieni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Ekɨ pepɨniere ketemɨte'uximatɨarie meta ketemɨtenanaimarie, 'ekɨ pepɨkaratɨmaiya","poem":1},{"text":"'aixɨa pepɨtiyurieni mɨkɨ hepaɨtsita.","poem":2},{"text":"Mɨyamemɨte'anuyehu matsi 'ahetsie mekaneuwaɨreni,","poem":1},{"text":"'ekɨ pepɨhɨkɨ nutuite waparewiwame.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Axamɨtiuka'iyari tɨrɨkariyaya keneunawairi meta Kakaɨyari mɨka'ayexeiya.","poem":1},{"text":"Ke'axamemɨteyurie yaketiniwarakapitɨa,","poem":2},{"lineBreak":true},{"text":"meta keniwarukumaweriya yunaime.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Yawé ti'aitame kanihɨkɨtɨni yuheyemekɨ,","poem":1},{"text":"matsi 'iya memɨkametsimate mepeuyehɨiyani yukwietsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"'Ekɨ, Yawé, haweri memɨyɨa wanenewieri pepɨ'enie,","poem":1},{"text":"pepɨwatɨrɨkariya meta kememɨmatewawirie pepɨraye'atɨwa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"'Ekɨ nutuite meta memɨte'uka'eniwa wahetsie pepɨnua,","poem":1},{"text":"tewi kwiekɨ mɨwewiya,","poem":2},{"lineBreak":true},{"text":"'axamɨti'ane mɨkati'enenikɨri.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}