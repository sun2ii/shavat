{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Naki'eriya nepɨtakwika meta tita mɨtiheitserie:","poem":1},{"text":"Yawé, nɨawari 'ahetsiemieme nepɨtikwika.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Aixɨa netiyurienetɨ nepumienikeyu huye 'aixɨa mɨ'ane 'utɨma:","poem":1},{"text":"¿Kepauka pepɨnetsiha'iwatamie?","poem":2},{"text":"Nekie 'anepukanikeyu","poem":1},{"text":"'aixɨa netinekɨhɨawetɨ ne'iyaritsie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne nepɨkayuta'iyaritɨani yanemɨtiyurienikɨ","poem":1},{"text":"tixaɨtɨ 'axamɨti'ane hepaɨtsita mieme.","poem":2},{"lineBreak":true},{"text":"Teɨteri kemɨtiheitserie yamemɨkateyurie nepɨwaxani'erie,","poem":1},{"text":"naime nepɨtixani'erie kememɨteyurie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nehetsie naime nekatinehɨamɨkɨ 'axamɨti'ane,","poem":1},{"text":"nehetsie munuani 'axamɨti'ane pɨkayɨweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kemɨ'ane 'awie yu'iwa hepaɨtsita 'axamɨtayɨni,","poem":1},{"text":"yuheyemekɨ ne kayuwatɨ nepipitɨani,","poem":2},{"text":"kemɨ'ane mariweme mayuyeitɨwa meta timaiweme","poem":1},{"text":"nepɨkayɨwe nemɨtinewiriekakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kwi nepɨwaxeiyani 'iya kwiepa memɨtama 'aixɨa memɨte'u'uwa,","poem":1},{"text":"nehamatɨa memu'uwanikɨ,","poem":2},{"text":"nehetsiemieme xeikɨa mepɨte'uximayaka,","poem":1},{"text":"kemɨ'ane wahetsie mɨkarahɨiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Xewitɨ tɨma nekiita pɨka'ayekani,","poem":1},{"text":"kemɨ'ane meteyukananaimatɨ 'amemu'uwa,","poem":2},{"text":"meta pɨkayɨweni nehɨxie muyeikani","poem":1},{"text":"xewitɨ 'itarikakɨ tikuxatatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Xeitukari manukayeikani nepɨkawapitɨaka 'amemu'uwani","poem":1},{"text":"yunaime Kakaɨyari memɨka'ayexeiya kwiepa memɨtama,","poem":2},{"text":"Yawé kiekarieyatsie nepɨwarayeweiya","poem":1},{"text":"yunaime 'axateyuruwamete.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}