{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":102,"content":[{"type":"hebrew_subtitle","content":["Mɨtiuka'eniwa nenewierieya kanihɨkɨtɨni, mɨximetɨ, yutatuatɨ yuhiwerietɨ Yawé kemɨtiutahɨawixɨ."]},{"type":"verse","number":1,"content":[{"text":"Yawé, keneu'eni nenenewieri,","poem":1},{"text":"'ahetsɨa keye'ani ne'iwaurika hiwariyari.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Neuxei kwerietɨ keneneuxeiya","poem":1},{"text":"kepauka nemɨtiuka'eniwa.","poem":2},{"text":"Kwi keneneu'eni,","poem":1},{"text":"yapauka keneneuta'eiya kepauka nemetsihahɨawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Karikɨ kɨtsi hepaɨ netukari kanitiparikeni,","poem":1},{"text":"ne'umete kanenikukwaxiyani tɨɨ hepaɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne'iyari pɨkayɨweri meta 'iteɨri hepaɨ pɨtawaxime,","poem":1},{"text":"metatsiere nepɨkareukwaimɨkɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Waɨkawa karima nemuta'aiwakɨ","poem":1},{"text":"kaniyɨweni ne'umete muti'inɨata.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nekaneunutuixieka nɨpe yuxaɨta makumawetsie muyeika hepaɨ nekatiniyumaika,","poem":1},{"text":"mikɨri hepaɨ nekatiniyumaika kiekari mu'uni tsata muyeika.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nemeukuni nepɨkayɨweri,","poem":1},{"text":"wiki yuxaɨta kii heima makaka hepaɨ nepɨtiyumate.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tsepa kepauka memɨnetsi'aye'unie yuniukikɨ mepɨnetekwinitɨa,","poem":1},{"text":"meta mekaneniutaterɨwani paitɨ kepauka 'axamemɨtiyuani.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Naxi xeikɨa kanine'ikwaitɨni,","poem":1},{"text":"nemɨti'ie hamatɨa ne'ukai nekananuye'eni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Pe'uyeha'aka waɨkawa,","poem":1},{"text":"pepɨnetsi'anukuketɨa 'ariketa 'ateewa pepɨnetsiheukahɨani.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Netukari 'etɨri mɨyukupata hepaɨ pɨ'ane,","poem":1},{"text":"tupiriya hepaɨ nepɨtayɨnarirɨme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yawé, 'ekɨ 'aheyemekɨ pekatini'aitani,","poem":1},{"text":"yuheyemekɨ 'ekɨ 'apekatiniteriweni yunaime nuiwarite watsata.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Pekananukukemɨkɨ meta Tsiyuni pekanitinenimayatamɨkɨ,","poem":1},{"text":"'ari mɨkɨ tukari kanaye'aniri pemitinenimayatatsie.","poem":2},{"lineBreak":true},{"text":"Mɨkɨ tukari kemɨtiu'inɨaritsie kanaye'ani.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Ahetsɨa miemete mate'uximayatsiriwamete mekanixɨamayaka kemɨtiuta'unekai,","poem":1},{"text":"'unimeyari mexeiyatɨ mepinaki'erie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Yawé mekanimakaxekakuni nuiwarite kwiepa memɨtama,","poem":1},{"text":"te'aitamete kwiepa memɨte'aita yunaitɨ mekanimaikakuni kemɨtimariwe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Karikɨ Yawé Tsiyuni tawarita kanihekwatɨamɨkɨ,","poem":1},{"text":"meta kemɨtitɨrɨkaɨye matsiɨkɨtɨ kanayeimɨkɨ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Memɨyuhiwerie wanenewieri pe'enietɨ pekanayeimɨkɨ,","poem":1},{"text":"kememɨmetewawirieka tsiepɨre pepɨraye'atɨwani.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"'Ikɨ keraka'utɨarieni 'iya memɨtinunuiwa wahetsiemieme,","poem":1},{"text":"meta kiekari memɨnetɨarieni Yawé 'aixɨa meketehahɨaweni.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yawé kanakaniere yutuki mɨmariweta 'ayekaitɨ,","poem":1},{"text":"kwiepa naitsarie kanakuniere muyuawitsiepaitɨtɨ,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"'ateewa memehapanie watsuari 'enienike","poem":1},{"text":"meta mɨwaxɨnakɨ 'ari memɨkwi'iwarɨme,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"meta Tsiyunitsie Yawé mukuxaxatsiwanikɨ","poem":1},{"text":"meta Kerutsaremetsie mɨnɨawariekakɨ,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"kepauka yunaitɨ teɨteri meta te'aitamete","poem":1},{"text":"memɨyukuxexeɨriwa Yawé metahɨaweke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"'Ane'umiekaku Kakaɨyari netɨrɨkariya kaniutixɨtɨani,","poem":1},{"text":"netukari 'etsikaniutipaɨmeriya.","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"'Ayumieme mɨpaɨ nekaniutayɨni:","poem":2},{"text":"«Nekakaɨyari, pepɨkanetsihewitɨkɨni, netukari hixɨapa,","poem":1},{"text":"'ekɨ 'aheyeme pepuyeika.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Tsɨtuapai 'ekɨ kwie pekaniunetɨani,","poem":1},{"text":"meta muyuawi kani'awewiyatɨni.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mɨkɨ mekaneuyewekuni, 'ekɨ peru 'apepuyeika.","poem":1},{"text":"Naitɨ mɨkɨ katinitixɨmɨkɨ 'ixuriki hepaɨ.","poem":2},{"text":"Meta kemari hepaɨ pepipataxɨani,","poem":1},{"text":"huma pepeitawiwieni.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"'Ekɨ peru yaxeikɨa mɨkɨ pepɨhɨkɨtɨni,","poem":1},{"text":"meta 'atukari hawaikɨ pɨkaheu'axe.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Mate'uximayatsiriwamete waniwema 'amepu'uwani,","poem":1},{"text":"meta wanuiwarima 'amepu'uwani 'ahɨxie».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}