{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":103,"content":[{"type":"hebrew_subtitle","content":["Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Ne'iyarikɨ Yawé nepɨnɨawani,","poem":1},{"text":"ke'inɨawani naitɨ newaiyari patsietɨ kemɨtitewakɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne'iyarikɨ Yawé nepɨnɨawani,","poem":1},{"text":"meta nepɨkaratɨtɨmaiyani 'aixɨa kemɨtiyuparewiwakɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mɨkɨ pɨmereuyehɨwirie naime 'axakepemɨtiuyuri","poem":1},{"text":"meta kepemɨtiuka'eniwa naime 'aixɨa kameniyurieka,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"mɨkɨ pitawikweitsitɨwa 'atukari mɨkite watsata","poem":1},{"text":"meta metsinaki'erietɨ payeika meta metsinenimayatɨ,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"mɨkɨ waɨkawa pɨmetsiparewie pe'uyeikakaku tita pemɨreuyehɨwa","poem":1},{"text":"meta kwixɨ hepaɨ pɨmetsihekwariya metsitɨrɨkariyatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yawé kemɨtiheitserie yapɨtiyuriene","poem":1},{"text":"meta memɨnanaimarie wahetsie kaninuaka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Muitsexi yuhuye kaniuxeitsitɨani,","poem":1},{"text":"'ixaheritsixi kaniwarutahekɨatɨani yu'uximayatsika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yawé 'aixɨa katiniuka'iyarini meta katiniyukanenimayaka,","poem":1},{"text":"yapauka pɨka'uyeha'arɨwe meta waɨkawa naki'eriya pexeiya.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yapɨkatarate'a tukarikɨ","poem":1},{"text":"meta yuheyeme tatsihekatɨ pɨkahayeika.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ke'axatemɨte'uyuri mɨpaɨ yeme pɨkatatsiyuriene","poem":1},{"text":"meta mɨpaɨ pɨkatarakapitɨwa ke'axatemɨte'uyuri.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kanimariweni naki'eriyaya kemɨ'ane memeyemakaxe wahetsiemieme,","poem":1},{"text":"taheima kemeutitewa hepaɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tita ke'axatemɨte'uyuri mɨkɨ 'ateewa katinewiwieni,","poem":1},{"text":"kemeteewa tau manatineikatsie 'atsita makayuyuipiketsie hepaɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yawé waɨkawa pɨwanenimaya kemɨ'ane memeyemakaxe wahetsiemieme,","poem":1},{"text":"nuariekame yuniwema wahetsiemieme kemɨtiuka'iyari hepaɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ketemɨte'u'iyari mɨkɨ katanimaika,","poem":1},{"text":"katinimaika tame haxu temɨhɨkɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Tewi tupiriya hepaɨ kani'aneni,","poem":1},{"text":"tukarieya pɨtixutuwe tuturi 'ɨtsita mieme hepaɨ:","poem":2}]},{"type":"verse","number":16,"content":[{"text":"kepauka mɨ'ekawarieni,","poem":1},{"text":"pukumamawere huyerieyatɨma pɨkayukuhekɨkɨare.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Peru Yawé naki'eriyaya hawaikɨ pɨkaheu'axe,","poem":1},{"text":"yuheyemekɨ pɨtiwiya kemɨ'ane memeyemakaxe wahetsie,","poem":2},{"text":"waniwema meta mɨkɨ waniwema wahetsie 'aixɨa mɨti'ane puxuawe,","poem":1}]},{"type":"verse","number":18,"content":[{"text":"kemɨ'ane tɨratuya memaye'atɨa wahetsie","poem":2},{"text":"meta meme'eriwa 'aitsikaya","poem":1},{"text":"mɨpaɨ memɨteyuriekakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Yawé muyuawitsie yu'uweni kaniukakeni,","poem":1},{"text":"kemɨti'aita yakatiniyɨaneni yunaime wahetsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Yawé xekenenɨawani, xeme niukieya tuayametemama,","poem":1},{"text":"xemɨtɨrɨkawi niukieya xemaye'atɨa","poem":2},{"lineBreak":true},{"text":"meta kemɨti'aita yaxemɨtekahu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yunaitɨ kuyaximama, Yawé xekenenɨawani,","poem":1},{"text":"te'i'uximayatsiriwamete kemɨtinake yaxemɨtekahu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yawé xekenenɨawani, yunaitɨ keyupaɨmeme mɨxe'utawewi","poem":1},{"text":"naitsarie mɨra'aita xemɨtama.","poem":2},{"lineBreak":true},{"text":"Ne'iyarikɨ Yawé nepɨnɨawani.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}