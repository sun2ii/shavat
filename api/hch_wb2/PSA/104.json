{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":104,"content":[{"type":"verse","number":1,"content":[{"text":"Ne'iyarikɨ Yawé nepɨnɨawani.","poem":1},{"lineBreak":true},{"text":"Yawé nekakaɨyari, 'ekɨ pepɨmariwe,","poem":1},{"text":"witsi'aneme pepanakatɨ ti'aitame kamixaya.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Xawatɨmekɨ pekaneuyukunaka 'ixuriki tuxamekɨ hepaɨ,","poem":1},{"text":"muyuawi peputaweraxɨ 'ixuriki hepaɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Haiwitɨritsie 'akii 'amɨpapa peputiwewi","poem":1},{"text":"meta hai 'akaxeta kuyaxa mieme pepayeitɨwa.","poem":2},{"lineBreak":true},{"text":"'Ekɨ pekananutiyeixani 'eka 'anateyatsie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Eka 'aniuki tuayamete pepɨwarayeitɨwa,","poem":1},{"text":"meta mimierika mepɨmate'uximayatsirie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"'Ekɨ kwie pekaniukamani tsutɨmeyaritsie,","poem":1},{"text":"hikɨ mana hatsuaku pɨkahewatayuani,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"haramarakɨ pepitikemaritɨa,","poem":1},{"text":"meta haa hɨritsie puyuhayewaxɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Peru 'ekɨ pewarutatieku haa mepekɨ,","poem":1},{"text":"'aniuki yuariyaya me'u'enieka meputinautsaxɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hɨritsie mekanitiyune,","poem":1},{"text":"mayeweweritsie kaniu'axɨani,","poem":2},{"lineBreak":true},{"text":"hakewa 'ekɨ pemɨwaretanɨ'a.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hakewa memeuye'atɨkani pepɨwaru'inɨaritɨa memɨka'anuyekɨkanikɨ,","poem":1},{"text":"tawarita hatsuaku kwie naime mepɨka'anukanani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"'Ekɨ pekatiniyurieneni haixa","poem":1},{"text":"haa muhapanenikɨ hɨritsie mayeweweritsie,","poem":2},{"lineBreak":true},{"text":"meta yeuta muxuawenikɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mɨkɨtsie yunaitɨ yeutari meputihareweni,","poem":1},{"text":"muwa puxuri yeutari witsimekatenihareka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Taheima memu'uwa wikixi mekaniyu'ituatɨaka haa 'aurie","poem":1},{"text":"meta mekaniutikwikani kɨyexi xawaritsata.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Taheima 'akie paitɨtɨ hɨrite pepɨhatuiya,","poem":1},{"text":"kwie 'a'uximayatsikakɨ 'aixɨa pɨreu'erie.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tupiriya pepɨyɨratɨa tewaxi wahetsiemieme,","poem":1},{"text":"meta 'iteɨrite teɨteri memika'etsa","poem":2},{"lineBreak":true},{"text":"kwiepa timieme yu'ikwai memɨtehexeiyanikɨ:","poem":2}]},{"type":"verse","number":15,"content":[{"text":"kaxie winuyari 'iyari mɨtemawieritɨawe,","poem":1},{"text":"hatseiti meta yuhɨxie mieme mayemerɨkaɨyenikɨ,","poem":2},{"lineBreak":true},{"text":"meta 'ikwai memayenenierenikɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yawé kɨyexiteya 'aixɨa katinehatuiyarieka,","poem":1},{"text":"kariuxa kɨyeyari Riwanu paitɨ mika'e.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mɨkɨtsie wikixi mepuyu'ituatɨa,","poem":1},{"text":"huku 'amutɨtɨtsie kwaxuri 'amemɨnene mekaniyukitɨaka.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hɨri 'amanutitɨtɨtsie tsipuri yeutari mekaniu'uwani,","poem":1},{"text":"meta 'aita mekaneixeiyani yu'awiwietame haitsɨrixi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"'Ekɨ metsa pekaniutawewieni, mi'inɨatanikɨ xeimetseri hetsiemieme.","poem":1},{"text":"Metatsiere tau, mɨtimate kepauka makayuyuipike.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"'Ekɨ yɨriya pekani'atɨwani, kani'axeni,","poem":1},{"text":"hikɨ mɨkɨ tɨkaritsie yutawima memɨteku'uwa yeutari mekanewayekɨkani.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mayetsi mepuyutihaxɨatɨwa, yu'ikwai meha'iwawatɨ,","poem":1},{"text":"Kakaɨyari mewawirietɨ wa'ikwai mɨwaminikɨ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Peru kepauka tau manatineikatsie mekanitakɨkani mekayuhekɨatakutɨ,","poem":1},{"text":"yuterɨta mekaneutahakeni.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hikɨ teɨteri mekanayekɨkani yu'uximayatsika menɨnike,","poem":1},{"text":"meteta'uximayatake kepaukake mɨkɨyɨre.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Yawé 'aku, pɨtimɨire tita pemɨtiutiwewi.","poem":1},{"text":"Mɨkɨ tinaime pepɨtiutiwewi petimaiwetɨ.","poem":2},{"lineBreak":true},{"text":"Kwiepa kemakuyewa mekanihɨneni pemɨtiwarutiwewi.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mana haramara kaniyemaka, 'a'atayeutɨ hawaikɨ kaheu'atɨ,","poem":1},{"text":"hetsiena memɨtexuawe meteyumɨiretɨ, 'amemɨtepapa meta 'etsimemɨtepepe,","poem":2},{"lineBreak":true},{"text":"kememɨteyupaɨme pɨkayɨwe mɨwaruti'inɨata.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mana kanuwate 'amɨpapa kaniye'uwani meta mana kanikuyuaneni Rewiyatahini mɨmariwe,","poem":1},{"text":"'ekɨ pemitawewi hamatɨana pemɨwaikanenikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Mɨkɨ yunaitɨ mekanita'ikwewani 'ahetsie","poem":1},{"text":"pemɨtiwaminikɨ kepauka memɨtekwa'a.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"'Ekɨ pepɨtiwayetuirie, mɨkɨta mepuka'itsana,","poem":1},{"text":"kepauka 'amamakɨ pemɨtiwamikwa, mɨkɨ waɨkawa metehexeiyatɨ mepakɨka.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Xɨka pewaruhayewa, meputimamawe,","poem":1},{"text":"xɨka wa'iiya pewarunawairieni mepɨtakukuwe meta tumuanari mepakɨka.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Xɨka 'a'iiya pehanɨ'ani, tawarita mepɨtixuawere,","poem":1},{"text":"meta mɨpaɨ kwie naitɨ puyuhekwatɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Yawé kepemɨtimariwe yuheyemekɨ mɨpaɨ peke'aneni,","poem":1},{"text":"Yawé keyutemawieritɨaka tita mɨtiutawewi hetsiemieme.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Mɨkɨ kwie kanixeiyani meta kanitayuitɨwani,","poem":1},{"text":"hɨri kanikumaɨwani meta kɨtsi kaniwatinenetɨwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Yawé nenɨawatɨ nepayani kenemɨreutere,","poem":1},{"text":"nekakaɨyari nɨawarieya neputikwikani mexi 'akuxi ne'ayeniereni.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Keyutemawieka kenemɨtiku'eriwakɨ,","poem":1},{"text":"netsitɨ, nekaniyutemawieka Yawé hetsiemieme.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"'Axateyuruwamete kwiepa meke'akumawere,","poem":1},{"text":"tawariri mepɨka'u'uwani.","poem":2},{"lineBreak":true},{"text":"Ne'iyarikɨ Yawé nepɨmetsinɨawani.","poem":1},{"lineBreak":true},{"text":"Yawé kenɨawarieka.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}