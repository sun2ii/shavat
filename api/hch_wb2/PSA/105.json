{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":105,"content":[{"type":"verse","number":1,"content":[{"text":"Pamɨpariyutsi Yawé xekenepitɨaka, mɨkɨ xekenahɨaweni,","poem":1},{"text":"yunaime nuiwarite wahetsɨa 'uximayatsikaya xekenehekɨatani.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Xekenekwikani, nɨawarieyakɨ xekeneyutemamawieka,","poem":1},{"text":"naime mariweme kemɨtiuyuri mɨkɨ xeketenekuxatani.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yemekɨ xekeneuyuti'ɨreni patsiekamekɨ kemɨtitewakɨ hetsiemieme,","poem":1},{"text":"Yawé memɨkuwautɨwe wa'iyari keyutemamawieka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Ahurawa xekeneɨkɨni Yawé hetsɨa meta tɨrɨkariyaya hetsɨa,","poem":1},{"text":"xepɨkatehayewani xe'ikuwaɨtɨwetɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Xekenaye'eriwani mariwemekɨ kemɨtiuyuri,","poem":1},{"text":"'inɨari kemɨtiuwewi, meta 'aitsika ke'aneneme mɨyetua.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xeme, 'Apɨrahami xiɨyarimama, mɨkɨ Kakaɨyari ti'uximayatsiriwame.","poem":1},{"text":"Xeme, Kakuwu niwemama, Kakaɨyari mɨxe'anayexei.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mɨkɨ Yawé kanihɨkɨtɨni, tame takakaɨyari,","poem":1},{"text":"'ena kwiepa naitsarie 'aitsikaya kanixuaweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mɨkɨ yutɨratu yuheyemekɨ pa'eriwa,","poem":1},{"text":"kemutayɨ yuniukikɨ xeimiriyari nuiwariyari wahetsiemieme.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mɨkɨ kanihɨkɨtɨni tɨratu 'Apɨrahami hamatɨa muwewi,","poem":1},{"text":"'Itsahaki hamatɨa kemɨtiuyuhɨritɨa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kakuwu yakatiniutahɨawe 'aitsika kaneyeitɨirieni,","poem":1},{"text":"'Ixaheritsixi wahetsiemieme tɨratu yuheyeme mieme kanayeitɨani,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"kepauka mɨpaɨ mutayɨ: «Kanani kwieyari nekameniyetuiriemɨkɨ,","poem":1},{"text":"piinitɨarika 'ahetsie mɨtinakenikɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kepauka 'akuxi temɨkayumuirekai,","poem":1},{"text":"teewanarixi tekanihɨkɨtɨkaitɨni yakɨ teyupaɨmetɨ mɨkɨ kwieyatsie,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ku'uwamete mekanihɨkɨtɨkaitɨni tsepa kemɨ'ane kwieyaritsie,","poem":1},{"text":"meta tsepa kemɨ'ane te'aitamete wahetsɨa,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"xeime pɨka'upitɨa waɨriyarika mɨtiwata'aitɨanikɨ,","poem":1},{"text":"matsi wahetsiemieme te'aitamete kaniwarutatieni:","poem":2}]},{"type":"verse","number":15,"content":[{"text":"«Neteɨterima nemuwaranayexei xepɨkawa'uximatɨaka,","poem":1},{"text":"Neniukamete xepɨkatewakwinitɨaka».","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kakaɨyari haakaxa kanayeitɨani mɨkɨ kwieyaritsie","poem":1},{"text":"tɨriku kaneuyehɨani naime.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Peru mɨkɨ wahɨxie xeime kanenɨ'ani:","poem":1},{"text":"Kutse titewakame, waɨriyarika ti'uximayatame hepaɨ kaniutuiyani.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"'Ɨkateyatsie tepɨa mepeiwɨtɨiriexɨa,","poem":1},{"text":"panutahɨiyakai yukɨipitɨa tepɨa patekakai.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kepaukake maye'a kemutayɨ kemɨtiyɨnikekai,","poem":1},{"text":"'ana Yawé niukieya matsiɨkɨtɨ patɨa kename yuritɨkai.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"'Ana ti'aitame katiniuta'aita mɨxɨnarienikɨ,","poem":1},{"text":"teɨteri mɨtiwa'aitɨakai kaniwayeyepieni.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ti'aitame kaneyeitɨani yukie naime hepaɨtsita","poem":1},{"text":"meta tita mɨrexeiyakai katinihɨritɨani,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"kanipitɨani mana kemɨ'ane memɨmexɨakate mɨtiwati'ɨkitɨanikɨ,","poem":1},{"text":"meta kemɨtimaiwekai 'ukirawetsixi mɨtiwakuxaxatɨwanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Hikɨ 'Ixaheri 'Ekipitu paitɨ kaninuani,","poem":1},{"text":"Kakuwu teewatanaka pɨhɨkɨtɨkai Kami kwieyatsie.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yawé yapɨtiuyuri memɨtamɨirekɨ teɨterimama","poem":1},{"text":"yumɨireme pɨwarayeitɨa, memeye'uniekai matsi mepɨkayumɨirekai,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"'ayumieme mepɨwaruyehekaxɨ teɨterimama","poem":1},{"text":"meta te'i'uximayatsiriwamete mewananaimatɨ mepakɨ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hikɨ kaniwarutanɨ'ani Muitsexi","poem":1},{"text":"meta 'Aruni, mɨkɨ muwaranayexei,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"mɨkɨ 'inɨari mepuwewi watsata,","poem":1},{"text":"mariweme mepɨte'uyuri Kami kwieyaritsie.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Yɨriya wahetsɨa kanenɨ'ani, mɨkɨ kwieyaritsie kanakuyɨre,","poem":1},{"text":"peru mɨkɨ niukieya mepɨka'u'eni.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Haa wahetsɨa mieme xuriya payeitɨa","poem":1},{"text":"tsapari meta mekaniukwini.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Naitɨ 'Ekipitu kwieyaritsie temutsi mekaniutaweni,","poem":1},{"text":"te'aitamete wakiita paitɨ mepuxuawekai.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kepauka Kakaɨyari mutaniu, naitsarie mɨkɨ kwieyaritsie meputixuawerixɨ,","poem":1},{"text":"nakatarixi meyumɨiretɨ meta xaipɨtsi memɨteyukewe.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Wiyeri tee wiyeriyari pɨta kanayeitɨani,","poem":1},{"text":"meta mimierɨkari waɨkawa mɨkɨ kwieyaritsie kanenɨ'ani,","poem":2}]},{"type":"verse","number":33,"content":[{"text":"naime kaxie haraweriyari kaniumura meta piní haraweriyari,","poem":1},{"text":"naitsarie mɨkɨ kwieyaritsie kɨyexi katiniumure.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Kakaɨyari kepauka yamutayɨ, mekaniu'axɨani 'utsikari,","poem":1},{"text":"mekayu'inɨatsinɨatɨ.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Tinaime mekateniutikwani tupiriya yɨrariyari xawariyari mɨkɨ kwieyaritsie,","poem":1},{"text":"'etsaripa 'ikwaxi naime mekateneukuxɨxɨani.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Kaniwarukwini yunaime tɨɨri mexɨakate mɨkɨ kwieyaritsie miemete,","poem":1},{"text":"tɨɨri 'aixɨa memɨ'anene mekaniukwini.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"'Ixaheritsixi kaniwarayewitɨni huru me'utɨkɨme meta pɨrata,","poem":1},{"text":"yunaitɨ mɨkɨ xiɨyari xewitɨ tɨma pɨkahekawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"'Ekipitutari mepuyukatemamawi kepauka memayekɨ,","poem":1},{"text":"memɨwamakaxekaikɨ 'ixaheritsixi.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Yawé haiwitɨrikɨ kaniwa'etɨriwiyakaitɨni,","poem":1},{"text":"meta taikɨ yɨwikɨta kaniwahekɨariwiyakaitɨni.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Kepauka 'ikwai memuta'iwau, mɨkɨ xɨ'aurixi kaniwareyenɨ'airieni,","poem":1},{"text":"'ikwai muyuawitsie miemekɨ kaniwarutihuxaitɨani.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"'Ai kaneuyepieni, 'ana haa kananeni","poem":1},{"text":"makumawetsie kaniuhanekaitɨni hatɨa hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":42,"content":[{"text":"Kakaɨyari yutɨratu mɨpatsie pɨkahatɨmai,","poem":1},{"text":"'Apɨrahami mɨti'uximayatsiriwame hamatɨa miwewi.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Yuteɨterima kaniwarayewitɨni, muwaranayexei,","poem":1},{"text":"waɨkawa temawierimakamekɨ meta temawierima me'utihiwame.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Kaniwayetuirieni nuiwarite wakwietɨkai,","poem":1},{"text":"tita mana teɨteri memɨte'uka'etsakai wapiini pɨratɨa,","poem":2}]},{"type":"verse","number":45,"content":[{"text":"para yukakaɨyari 'aitsikaya memayexeiyanikɨ","poem":1},{"text":"meta mɨpaɨ memɨte'u'uwanikɨ kemaitɨka.","poem":2},{"lineBreak":true},{"text":"Yawé kenɨawarieka.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/105.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/106.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/104.json","previousChapterAudioLinks":{},"numberOfVerses":45}