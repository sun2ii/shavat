{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":106,"content":[{"type":"verse","number":1,"content":[{"text":"Yawé kenɨawarieka.","poem":1},{"lineBreak":true},{"text":"Pamɨpariyutsi xekenepitɨaka Yawé,","poem":1},{"text":"mɨkɨ 'aixɨa mɨtiuka'iyarikɨ,","poem":2},{"lineBreak":true},{"text":"naki'eriyaya mɨwaɨkawa hawaikɨ pɨkaheu'axe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Xewitɨ pɨkayɨwe yemekɨ mikuxatanikɨ Yawé mariweme kemɨtiuyuri,","poem":1},{"text":"yatɨni pɨkayɨwe minɨawanikɨ yemekɨ kemɨreuyewetse.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Aixɨa meke'itɨarieka heitserie 'aixɨa memɨteyurie","poem":1},{"text":"meta yuheyemekɨ kemɨtinake memɨteyurie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yawé, kenenaye'eri, kepauka pemɨwatinenimayata 'ateɨterima,","poem":1},{"text":"kenaye'a kepauka tukari pemaye'atɨani wikweitsitɨarika pemɨtixuawitɨani.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Keneneupitɨa 'ateɨterima wahamatɨa nemuyeikani 'aixɨa 'iyari pemɨwapitɨanitsie,","poem":1},{"text":"keneneupitɨa 'ateɨterima memuyutemamawiekatsie neta nemɨnetemawiekakɨ,","poem":2},{"lineBreak":true},{"text":"meta nemɨmetsinɨawanikɨ pemɨwaranayexei wahamatɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"'Axatepɨte'uyuri, yaxeikɨa tapaapama wahepaɨ,","poem":1},{"text":"'axatepɨte'uyuri meta 'axamɨti'ane waɨkawa tepɨte'uyuri.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kepauka tapaapama 'Ekipitu memɨtitekatsie,","poem":1},{"text":"mariwemekɨ kepemɨtiuyuri hetsiena yuri mepɨkate'uta'eri,","poem":2},{"text":"ke'aixɨa pemɨtiuka'iyari 'aheyemekɨ mɨpaɨ mepɨkatehetima","poem":1},{"text":"meta Haramara Mɨxeta tetsita mepuyeha'a.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Peru Kakaɨyari pɨwarutawikweitsitɨa, yuhetsiemieme mariweme mayuyeitɨanikɨ,","poem":1},{"text":"yutɨrɨkariya matsiɨkɨme mayeitɨanikɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Haramara Mɨxeta kaniutatieni, hikɨ mɨkɨ kanakawani,","poem":1},{"text":"mana haramara 'amatiyewatsie kaniwaruwitɨtɨyani","poem":2},{"lineBreak":true},{"text":"makumawetsie memɨkɨne hepaɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kaniwarutawikweitsitɨani memɨwaraye'unie wahepaɨtsita,","poem":1},{"text":"kemɨ'ane memɨwaxani'eriekai wahepaɨtsita.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Memɨwaraye'uniekai haa waheima kaniuyeurieni,","poem":1},{"text":"mɨkɨ xewitɨ tɨma pɨka'utawikwei.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hikɨ 'ana tapaapama niukitsie yuri mepɨte'uta'eri","poem":1},{"text":"meta nɨawari hetsienamieme meputakwikaxɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Peru yapauka mekatenatɨmaiya kemɨtiuyuri","poem":1},{"text":"meta meta'ikwewatɨ mepɨka'akɨ kemɨtiwarahɨawekai.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Makumawetsie kemɨtiwanake meteyurietɨ mepu'uwakai,","poem":1},{"text":"yemekɨ makumawetsie me'u'uwatɨ Kakaɨyari mekaniuta'inɨata.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mɨkɨta tita memɨte'itawawiri katiniwayetuirieni,","poem":1},{"text":"peru kwiniyata kaniwarenɨ'airieni tiyumemiwame.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Makumawetsie metitetɨ Muitsexi mekaniutiniukimatɨkɨne","poem":1},{"text":"meta 'Aruni, mɨpatsiekai Yawé hetsiemieme.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kwie kanewatiyepiere hikɨ 'ana Ratani kaneukakwani,","poem":1},{"text":"meta kaniwareukateuku 'Awirani memaweiyakai.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mɨkɨ mɨyamemɨyupaɨmekai tai kaniwarutixɨtsitɨani,","poem":1},{"text":"mekaniutitani 'axateyuruwamete.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Huré hɨriyaritɨa me'u'axɨaka tsikeru mekaniutawewieni,","poem":1},{"text":"kakaɨyari wewiyakame hɨxie mekaniukatunuma'uni.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kakaɨyari waɨkawa watemawieritɨakaku mepiku'eiri,","poem":1},{"text":"tuuru pɨta 'ɨkiyaya mepanukuwei tupiriya mukwa'a.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kakaɨyari mekanatɨmaiya muwarutawikweitsitɨa","poem":1},{"text":"meta waɨkawa mamariwaweme mɨtiuyuri 'Ekipitu kwieyaritsie:","poem":2}]},{"type":"verse","number":22,"content":[{"text":"mariweme katiniuyurieni Kami kwieyaritsie","poem":1},{"text":"metatsiere Haramara Mɨxeta tetsita.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kakaɨyari mɨpaɨ putayɨ kename wakwinikekai","poem":1},{"text":"peru mɨpaɨ pɨkatiuyuri Muitsexi hetsiemieme menayexei,","poem":2},{"text":"hɨxiena kaniukeni huyetana","poem":1},{"text":"meta pɨka'ipitɨa ha'atɨ mɨwaka'unakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Kwie witsimɨ'ane mepɨka'utanaki'eri,","poem":1},{"text":"Kakaɨyari kemɨtiwakɨhɨawekai yuri mepɨkate'ita'eriri.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yu'ixuriki xamaruyarita me'ayetetɨkaitɨ 'axamekateniutixatatɨkɨne","poem":1},{"text":"meta Yawé mepɨka'anu'eni.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"'Ayumieme, mɨkɨ mɨpaɨ putayɨ wahepaɨtsita,","poem":1},{"text":"makumawetsie kename wakwinikekai,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"waniwemata hipame nuiwarite watsata wakaxɨrienikekai","poem":1},{"text":"meta naitsarie kwiepa wataxɨriexɨanikekai.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Mekaniyuyetuani kakaɨyari Wahari-Pehuxi hetsɨa","poem":1},{"text":"meta kakaɨyarixi memɨka'ayeneniere wamawarika mepɨte'utikwai.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Mɨkɨkɨ Yawé mepuyehaxɨatɨa 'axameteyurietɨ,","poem":1},{"text":"hikɨ wahetsie kaninuani kwiniya.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Peru Pinexi wahetsiemieme 'aixɨa pɨtiuyuri,","poem":1},{"text":"'ana kwiniya paunua wahetsɨa pɨkaye'a.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Mɨkɨ kemɨtiuyuri 'aixɨa mɨtiuka'iyari payeitɨarie","poem":1},{"text":"yuheyemekɨ, hikɨ 'enamɨtiyehane 'aixɨa ketikuxaxatsiwani.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Haa manakaxɨrɨwe Meriwa 'aurie Yawé mekaniuyehaxɨatɨani,","poem":1},{"text":"mɨkɨ mɨyamemɨte'uyurikɨ Muitsexi hetsie pɨrahui.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Waɨkawa me'ihaxɨatɨakaku mɨkɨ kaniutaniuni,","poem":1},{"text":"kahayu'eriwatɨ kemutainekai.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Mepɨkawaruka'unaxɨ hipame teɨteri","poem":1},{"text":"Yawé mɨwaruta'aitakai memɨwakwinikɨ,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"matsi 'axateyuruwamete mekaniwarutinɨni","poem":1},{"text":"wayeiyari mehayexeiyatɨ mekanakɨne.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Mepɨwarayexeiyakai wakakaɨyarixi,","poem":1},{"text":"hikɨ mɨkɨ wawiniyari kanayani.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Yuniwema 'ukitsi meta 'ukari mekaniwamawakaitɨni","poem":1},{"text":"mɨkɨ kakaɨyarixi 'axamemɨ'anene wahetsiemieme.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Mekaniwarukwini 'atsimemɨkateyuriekame,","poem":1},{"text":"yuniwema 'ukitsi meta 'ukari.","poem":2},{"text":"Kepauka kakaɨyarixi Kanani miemete memɨwarutimawiri,","poem":1},{"text":"mɨkɨ waxuriyakɨ mɨkɨ kwie 'axa'itɨarietɨ patɨa.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Mɨkɨ mɨyamɨti'ane meka'itiyakame pɨwarayeitɨa,","poem":1},{"text":"meta mɨkɨkɨ mepuyutsewixima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Yawé waɨkawa puyeha'a yuteɨterima wahetsiemieme,","poem":1},{"text":"hetsɨana memɨmiemetetɨkai waxani'erietɨ patɨa.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"'Ayumieme kaniwayetuani nuiwarite 'axateyuruwamete wahetsɨa,","poem":1},{"text":"hikɨ waɨriyarika metewa'aitɨatɨ mepakɨ memɨwaraye'uniekai.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Memɨwaraye'uniekai mepɨtewaruta'uximayatsitɨa,","poem":1},{"text":"kemɨtiwanake mepɨtewaruta'aitɨa.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Mɨixa Kakaɨyari wahetsie putanua,","poem":1},{"text":"peru mɨkɨ, memɨ'iyamakaikɨ 'axameteyurietɨ,","poem":2},{"lineBreak":true},{"text":"yaxeikɨa 'axameteyurietɨ mepakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"Kepauka Kakaɨyari mɨwaruxei meyuhiweriekame,","poem":1},{"text":"meta kepauka mi'eni wa'aiwari hiwariyari,","poem":2}]},{"type":"verse","number":45,"content":[{"text":"yutɨratu paye'eri wahamatɨa miwewi,","poem":1},{"text":"naki'eriyaya mɨmariwekɨ kaniwarutinenimayata.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Yakatiniuyurieni memɨwaraye'unie wahetsiemieme,","poem":1},{"text":"mɨkɨta memuwatinenimayatakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"Yawé, ketaneutawikweitsitɨa, takakaɨyari pemɨhɨkɨ,","poem":1},{"text":"tawarita ketaneukuxeɨri takwieyaritsie,","poem":2},{"text":"pamɨpariyutsi temɨmetsipitɨakakɨ pepatsietɨ kepemɨtitewa,","poem":1},{"text":"meta teyutemamawietɨ temɨmetsinɨawanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":48,"content":[{"text":"Yawé 'aixɨa kerahɨawarɨwani, 'Ixaheri Kakaɨyarieya,","poem":1},{"text":"yuheyemekɨ meta kaheu'akamekɨ.","poem":2},{"text":"Yunaitɨ teɨteri mɨpaɨ meke'utiyuani: «Mɨpaɨ ketiɨyɨni».","poem":1},{"lineBreak":true},{"text":"Yawé kenɨawarieka.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}