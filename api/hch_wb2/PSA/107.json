{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":107,"content":[{"type":"heading","content":["XAPA 5"]},{"type":"verse","number":1,"content":[{"text":"Yawé pamɨpariyutsi xekenepitɨaka, karikɨ mɨkɨ 'aixɨa katiniuka'iyarini,","poem":1},{"text":"naki'eriyaya yuheyemekɨ katiniteriweni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mɨpaɨ meke'utiyuaneni Yawé mɨwarutawikweitsitɨa,","poem":1},{"text":"mɨwaruxɨnaxɨ mɨwaraye'unie tiwa'aitɨakaku,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Naitsarie kwiepa wara'iniexɨaka mɨwarukuxeɨri,","poem":1},{"text":"tayeta meta tatsutɨa miemete, tatserieta meta ta'utata miemete.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Memeuyexɨriekai makumawetsie meu'uwatɨ,","poem":1},{"text":"huye kiekaritsie haneme mekahexeiyatɨ mekahemaririetɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Meheuharikutɨ meta meheuhakakwikutɨ,","poem":1},{"text":"mepɨkwiximekai.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yawé mekaniutahiwieni me'utitsuatɨ mete'uka'eniwatɨ,","poem":1},{"text":"hikɨ mɨkɨ mete'uka'eniwakaku kaniwaruxɨna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Huye mɨheitserie 'utɨma kaniwarewitɨni,","poem":1},{"text":"'atsita kiekaritsie kaniwaye'atɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yawé naki'eriyaya mɨmariwekɨ, pamɨpariyutsi xekenepitɨaka,","poem":1},{"text":"mariweme mɨtiuyurikɨ teɨteri wahetsiemieme.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kemɨ'ane meuharimɨkɨ mɨkɨ pɨharitɨa,","poem":1},{"text":"meta kemɨ'ane meuhakamɨkɨ 'aixɨa mɨti'anekɨ pitahuxaitɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Meyuhiwerietɨ mehɨatɨkaitɨ,","poem":1},{"text":"'amepu'uwakai waɨkawa makɨyɨwitsie.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kakaɨyari niukieya memɨka'u'enikɨ,","poem":1},{"text":"'Amutewi kemɨtiwa'ɨxatsitɨakai yamemɨkatekakɨkɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"'Uximayatsika mahete kaniwarupitɨani,","poem":1},{"text":"mepekaxɨrɨwekai, xewitɨ pumawekai mɨwaparewienikɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Meyuhiwerietɨ Yawé mekaniutahiwieni,","poem":1},{"text":"hikɨ mɨkɨ kememɨte'uka'eniwakai pɨwarutawikweitsitɨa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yemekɨ yɨriyatsata kaniwarayehapani","poem":1},{"text":"meta kaniwaruxɨna memɨhɨatɨkatei kaneutekixɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Yawé naki'eriyaya mɨmariwekɨ, pamɨpariyutsi xekenepituaka,","poem":1},{"text":"mariweme mɨtiyurienekɨ teɨteri wahetsiemieme.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wurunitse 'itupariyari putitaraxɨ,","poem":1},{"text":"meta tepɨa kɨyeyari 'etsipepetɨ kaneutanexɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mepɨte'ukwinitɨarie memɨka'anu'enanakɨ,","poem":1},{"text":"mepu'uximatɨarie 'axamemɨte'uyurikɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Naitɨ 'ikwaite pɨkawanakekai me'ixeiyatɨ meputihewakai,","poem":1},{"text":"'etsiwatɨkaku mekaniukwikaitɨni.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Meyuhiwerietɨ Yawé mekaniutahiwieni,","poem":1},{"text":"hikɨ mɨkɨ kememɨte'uka'eniwakaikɨ pɨwarutawikweitsitɨa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yuniuki kanenɨ'ani 'aixɨa meteheu'eriekame mɨwarayeitɨanikɨ,","poem":1},{"text":"mɨkɨ mɨpaɨ katiniwarutawikweitsitɨani teukiyapa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Yawé naki'eriyaya mɨmariwekɨ, pamɨpariyutsi xekenepitɨaka,","poem":1},{"text":"mariweme mɨtiyurienekɨ teɨteri wahetsiemieme.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mawari meke'iyetuirieka pamɨpariyutsi me'ipitɨatɨ,","poem":1},{"text":"'uximayatsikaya mekekuxatani me'utihiwatɨ temawierikakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Haramaratsie mepɨkɨnetɨwekai yukanuwate 'amɨpapatsie,","poem":1},{"text":"meyukuharerutatɨwetɨ haramaratsie 'ateewapai mepeta'axekai.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mana haramara meukatewatsie,","poem":1},{"text":"Yawé 'uximayatsikaya mekaniuxeiya meta mariweme kemɨtiuyuri.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kepauka Kakaɨyari mutaniu, 'eka tɨrɨkaɨyetɨ kaniukuyani,","poem":1},{"text":"'ana 'apapatɨ kaniwakɨkakaitɨni hamewari,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"muyuawitsie ye'axetɨ meta meukatewatsie heukakɨkatɨ.","poem":1},{"text":"Kweriwa 'anekɨa, mɨkɨ mekaneuyuyexɨrieni.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Memɨtarɨweka hepaɨ mepekaxɨrɨwekai, mepɨtakeitsarietɨkɨkakai,","poem":1},{"text":"tixaɨtɨ mepɨkateyunaki'eriekai, tsepa memɨtemaiwawe memɨyɨakai.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Waɨkawa meyuhiwerietɨ Yawé mekaniutahiwieni me'utitsuatɨ,","poem":1},{"text":"hikɨ mɨkɨ kememɨte'uka'eniwakaikɨ kaniwarutawikweitsitɨani.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"'Eka mɨtɨrɨkaɨye kaniupata wiyeri 'etsimupepekɨ:","poem":1},{"text":"hamewari 'amɨnene kayuwatɨ kaniutamare.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"'Ana kayuwatɨ mutamarixɨtsie mekaniyukatemamawieni.","poem":1},{"text":"Meta 'ana Kakaɨyari kaniwarewitɨni hakewa memeɨkɨnekai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Yawé naki'eriyaya mɨmariwekɨ, pamɨpariyutsi xekenepitɨaka,","poem":1},{"text":"mariweme mɨtiyurienekɨ teɨteri wahetsiemieme.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Yunaitɨ teɨterimama meyuxeɨrietɨ mariweme mekehayeitɨaka.","poem":1},{"text":"'Ukirawetsixi 'itsɨkate 'aixɨa meke'utiyuaneni hetsiena mieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Haa 'amɨpapa muyehapane makumawe Kakaɨyari payeitɨa,","poem":1},{"text":"haixa mukunenieretsie muwakitsie payeitɨa,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"kwie 'aixɨa mɨtiu'anekai kwie muxiekariya payeitɨa,","poem":1},{"text":"mana kiekatari 'axamemɨte'uyurikɨ.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Makumawetsie haa waɨkawa xuaweme payeitɨa,","poem":1},{"text":"kwie mɨwakitsie haixa xuaweme payeitɨa,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"mana memɨkiekakɨ pɨwa'atɨa memɨyehakakwitɨwe,","poem":1},{"text":"hikɨ mɨkɨ mana kiekari mekaniukamani.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Mekaniuka'eni, kaxie haraweriyari mekaniutiwewieni,","poem":1},{"text":"waɨkawa mekateniukaxeiya.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Kakaɨyari 'aixɨa kaniwaruyurieni, hikɨ mɨkɨ mekaniyutimɨire,","poem":1},{"text":"meta yaxeikɨa watewama kaniwarutimɨiriya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Kepauka mɨkɨ 'etsimemɨyupaɨmeni,","poem":1},{"text":"waɨriyarika mete'uximayatsitɨarietɨ 'axamɨti'anekɨ meta hiwerikakɨ.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Kakaɨyari 'uximatɨarika pɨwakupitɨwa memamariwaweme memayuyeitɨwa,","poem":1},{"text":"meta kaniwarenɨ'awani makumawetsie yeuta.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Peru tixaɨtɨ memɨkateheuxeiya 'aixɨa 'anekɨa kaniwa'atɨwani,","poem":1},{"text":"meta watɨɨriyama tewaxi wahepaɨ katiniwamɨiriyani.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Kepauka 'aixɨa memɨte'u'iyari mɨpaɨ memɨteneniere mepuyukatemamawieni,","poem":1},{"text":"peru yunaitɨ 'axamemɨte'u'iyari kayuwatɨ mepɨtamare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Kemɨ'ane mɨtimaiwe, mɨpaɨ timaitɨ kehayani","poem":1},{"text":"meta 'aixɨa kereitimani Yawé naki'eriyaya mɨmariwe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/107.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/108.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/106.json","previousChapterAudioLinks":{},"numberOfVerses":43}