{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":108,"content":[{"type":"hebrew_subtitle","content":["Kwikari. Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Kakaɨyari, ne'iyari pɨheitserie,","poem":1},{"text":"ne'iyari 'aixɨa pɨ'ane, nɨawari 'ahetsiemieme nepɨtikwika.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Xekenanutanenieri haripa meta xaweri.","poem":1},{"text":"Hekwame tukari nekananutanieritɨamɨkɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yawé, nepɨmetsinɨawani hipame teɨteri watsata,","poem":1},{"text":"'anɨawari neputikwikani hipame nuiwarite watsata.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Anaki'eriyatsɨ kanimariweni muyuawi kana'iwani,","poem":1},{"text":"muyuawitsie paitɨ kaniye'axeni 'aniuki yuri maine.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neuxei Kakaɨyari, 'ekɨ muyuawi pekana'iwani,","poem":1},{"text":"meta 'axawatɨriya naime kwie kananukanaka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ketaneuxɨna 'atɨrɨkariyakɨ, ketaneuta'eiya","poem":1},{"text":"'ateɨterima pemɨwanaki'erie memɨtawikwenikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kakaɨyari mɨpaɨ putayɨ yutukita:","poem":1},{"text":"«Nerayu'iwakamekɨ Tsikeni nepɨtixitexɨani,","poem":2},{"lineBreak":true},{"text":"meta mayeweri Tsukuti nepɨti'inɨata.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Karaha meta Manatsexi, nehetsɨa mekanimiemetɨni,","poem":1},{"text":"'Epɨrahini kuya menaketsa kanihɨkɨtɨni nemu'utsie nunuwame, Kura meta ne'itsɨ kanihɨkɨtɨni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Muhawi hetsie nekaniukamaimawani,","poem":1},{"text":"'Erumi hetsie nekakai nekaneutaxɨrɨwani,","poem":2},{"lineBreak":true},{"text":"Piritsiteu kwieyari hetsie nepetahiwa neyutemawietɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"¿Kemɨ'ane kiekari mukurarutɨarietsie pɨnetsi'anuwitɨni?","poem":1},{"text":"¿Kemɨ'ane 'Erumi huyeyari pɨnetsixeiyatsitɨani?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Ekɨ pekanihɨkɨtɨni, Kakaɨyari, kemɨ'ane pemɨtatsi'uku'eiri.","poem":1},{"text":"Neuxei Kakaɨyari, takuyaxima pepɨkawaparewieri.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ketaneuparewi mɨtatsi'aye'unie hepaɨtsita,","poem":1},{"text":"tewi parewiyaya tixaɨtɨ pɨkatiyunaki'erie.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kakaɨyari tatsiparewiekaku tepɨtehayu'iwa,","poem":1},{"text":"mɨkɨ memɨtatsi'aye'unie pɨwatiketsini.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}