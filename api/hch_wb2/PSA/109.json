{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":109,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Kakaɨyari, ne nepɨmetsinɨawa,","poem":1},{"text":"kayuwatɨ pepɨka'umaka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Neuxei teɨteri memɨkametsimate memɨte'itawa","poem":1},{"text":"nehetsie mepɨtehahɨa menetsi'itatɨ,","poem":2},{"lineBreak":true},{"text":"waniuki mɨtiyukwamanakɨ 'axamepɨnetekuxata,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"yemekɨ kwinimieme meneteheuhekatɨ mepɨnetsixaneta,","poem":1},{"text":"peru yakɨ xeikɨa mepɨtekuxata.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Newanaki'eriekakutɨtɨ 'axamepɨnetekuxata,","poem":1},{"text":"peru ne mɨkɨ nepɨwayetua neyunenewietɨ 'ahetsɨa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tsepa ne 'aixɨa nemɨtiuka'iyari wahetsiemieme mɨkɨ 'axa'anemekɨ mepɨnete'akapitɨwa,","poem":1},{"text":"menetsinaki'eriekakeme, mepɨnetsixani'erie pɨta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Xeime 'axamɨtiuka'iyari keneutanɨ'a hetsiena mɨrahɨanikɨ,","poem":1},{"text":"tserietana kehayerɨni mitaxaneta.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hetsiena kerahɨiyani kepauka mɨtaxanetsieni,","poem":1},{"text":"meta 'itarikayatɨtɨ hetsiena kerahɨani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tukarieya yapauka keneunawairi,","poem":1},{"text":"meta xewitɨ pɨta 'uximayatsikayatsie ke'uyehani.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tɨɨriyamama nutuite meke'akɨne,","poem":1},{"text":"'ɨyaya wiuratɨtɨ ke'uyuhayewa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tɨɨriyamama meheu'uwatɨ xeikɨa meke'akɨne meta meteku'iwautɨwetɨ,","poem":1},{"text":"teteɨxɨmete meke'akɨne kii mu'u'unita.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Memɨte'iniɨtɨakai piiniteya yupiinite meketehayeitɨani,","poem":1},{"text":"teɨteri teewatari tipiiniteya mekete'unawani.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mɨkɨ nutuite xewitɨ pɨkawanenimayaka,","poem":1},{"text":"meta pɨkawanaki'erieka.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mɨkɨ nuiwariyari ke'ukumawere,","poem":1},{"text":"meta nuiwari hekwatɨ 'umamietsie ke'umaweniri.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yawé, kena'eriwani paapaya ke'axamɨtiuyuri,","poem":1},{"text":"meta maamaya kemɨtiuyuri.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yawé yaketiwaxeiyani,","poem":1},{"text":"meta mematɨmaiyarienikɨ 'ena kwiepa yaketiuyurieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"'Aixɨa tiyurienetɨ mɨratɨmaikɨ,","poem":1},{"text":"tixaɨtɨ memɨkatehexeiya, memɨteheuyehɨwa meta yu'iyaritsie memu'uximatɨarie,","poem":2},{"lineBreak":true},{"text":"pɨwarutawei meta pɨwarukwi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Pinakekai xeime 'axamuyurienikɨ,","poem":1},{"text":"hikɨ 'axamɨ'itɨarienikɨ hetsiena ketiunake.","poem":2},{"text":"Mɨka'inakekaikɨ xeime 'aixɨa muyurienikɨ,","poem":1},{"text":"'aixɨa mɨ'itɨarienikɨ hetsiena mieme keheteewani.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"'Axamutayɨkɨ kaniyuta'eima","poem":1},{"text":"yukamixa manakatɨni hepaɨ,","poem":2},{"text":"mɨkɨ waiyarieyatsie ke'anuyeneni haa hepaɨ,","poem":1},{"text":"'umeteya hetsie paitɨ keheye'ani hatseiti hepaɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mɨkɨ 'axamɨti'ane ke'ita'eima 'ixuriki hepaɨ.","poem":1},{"text":"Karima ke'itahɨani hɨiyame hepaɨ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yawé mɨpaɨ ketiwarakapitɨani kemɨ'ane memɨnetsixaneta,","poem":1},{"text":"kemɨ'ane memɨnetsi'ita meta 'axamemɨnetekuxata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Yawé neti'aitɨwame 'aixɨa pemɨtiuka'iyari, 'ekɨ 'ahetsiemiemekɨ","poem":1},{"text":"'aixɨa kenetinexeiyani,","poem":2},{"lineBreak":true},{"text":"keneneuparewi 'anaki'eriya mɨmariwekɨ meta 'aixɨa pemɨtiuka'iyarikɨ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ne tixaɨtɨ nepɨkarexeiya, nepɨreuyehɨwa,","poem":1},{"text":"ne'iyari yemekɨ pu'uximatɨarie pɨtiuka'eniwa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"'Anɨari nepɨtaparirɨme 'etɨri yɨwikɨta mieme hepaɨ","poem":1},{"text":"kɨpi hepaɨ nepɨ'ane 'anateya mɨtsatsani 'ekakɨ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Haakakɨ nepɨkakewe ne'ɨkate pɨwerarani,","poem":1},{"text":"ne'umete kaniyuhekɨkɨaka newaiyaritsie.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Teɨteri kepauka memɨnetsikuxexeiya mepɨnetsinanaima,","poem":1},{"text":"menetsikuxexeiyatɨ, yumu'u meputitsike.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Yawé, nekakaɨyari, keneneuparewi,","poem":1},{"text":"'anaki'eriya mɨmariwekɨ, keneneutawikweitsitɨa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Mɨpaɨ meketehetimani","poem":1},{"text":"'ikɨ 'ekɨ pɨta pemɨnetsiyurienekɨ, Yawé.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Tsepa mɨkɨ 'axamemɨnetsi'uyuri.","poem":1},{"text":"'Ekɨ matsi 'aixɨa keneneuyuri.","poem":2},{"text":"Tsepa memaye'axɨa nehetsɨa, 'ekɨ matsi pepɨwatewiyatsitɨani,","poem":1},{"text":"neta ti'a'uximayatsiriwame nepɨnetemawieka.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Nehetsie memɨtehahɨpa meke'utewiyatsitɨarieni waɨkawa,","poem":1},{"text":"meke'uyutitetewiya yemekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Ne matsi Yawé, pamɨpariyutsi nekamenipitɨakamɨkɨ,","poem":1},{"text":"nekameninɨawakamɨkɨ yumɨireme watsata.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Mɨkɨ haweri memɨyɨa mɨwawikweitsitɨwame,","poem":1},{"text":"hetsiena waɨkawa rahɨiwakaku mierieximekaku.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}