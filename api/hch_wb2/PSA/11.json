{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Yawé hetsie nepɨne'awieta.","poem":1},{"text":"¿Titayari mɨpaɨ xenetehahɨawe:","poem":2},{"lineBreak":true},{"text":"«Keneuyuta'una 'ɨtsita, wikixi wahepaɨ»?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Xekeniwaruxeiya kehepaɨ yutupi memɨtehawɨwɨtɨwa 'axateyuruwamete:","poem":1},{"text":"yutupi kaunariyaritsie mekanika'uitɨwani 'ɨrɨ,","poem":2},{"lineBreak":true},{"text":"'aixɨa memɨte'u'iyari mewatamɨnike","poem":2},{"lineBreak":true},{"text":"'awie paitɨ metitetɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Xɨka tsutɨmeyari 'uka'unarieni,","poem":1},{"text":"¿tewi 'aixɨa mɨtiuka'iyari ketiuyuriwe?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yawé yutuki muyepatsieta kanayekani,","poem":1},{"text":"muyuawitsie Yawé yu'uweni kanexeiyani,","poem":2},{"text":"kayuwatɨ xeikɨa tewi kwikanitaxeiyani,","poem":1},{"text":"kanixeiyani kemɨtiyuriene.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yawé kaniwaxeiyani kememɨteyurie 'aixɨa memɨte'u'iyari meta 'axateyuruwamete,","poem":1},{"text":"kaniwa'uxiwe'erieka kemɨ'ane memɨteyukananaima.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Axamemɨte'u'iyari wahetsie tɨɨ wiyeriyari kananɨ'amɨkɨ","poem":1},{"text":"meta tai kanikawiwimɨkɨ,","poem":2},{"lineBreak":true},{"text":"'eka kwinimieme tixɨkatɨ kaniku'ekamɨkɨ, mɨkɨ wa'iwarika kanayeimɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"'Aixɨa katiniuka'iyarini Yawé, 'aixɨa mɨti'ane katininaki'erieka,","poem":1},{"text":"'ayumieme heitserie memexeiya mepixeiya kemɨraka'erie.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}