{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Yawé mɨpaɨ katiniutahɨawe Neti'aitɨwame:","poem":1},{"text":"«Netserieta kenayexi","poem":2},{"text":"ne nekaniwaka'unamɨkɨ memɨmetsi'aye'unie,","poem":1},{"text":"'ahɨxie nekaniwa'atɨamɨkɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yawé kemetsi'uparewieni pemɨtita'aitakɨ naitsarie","poem":1},{"text":"Kerutsareme pe'ukaitɨ.","poem":2},{"lineBreak":true},{"text":"Mana 'ekɨ ketine'aitani memɨmetsi'aye'unie wahixɨata.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Akuyaxima mepuyuwaɨriyani","poem":1},{"text":"tukaritsie kepauka xemuyutakwini,","poem":2},{"lineBreak":true},{"text":"hɨrite mɨpatsietɨkatsie me'u'uwatɨ.","poem":2},{"text":"Tau 'ɨrɨya manatinexɨanitsie,","poem":1},{"text":"kepauka 'ahetsie mɨtinake hekwamekɨ pɨmatsitɨrɨkariya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yawé yaputayɨ kename yatikayani","poem":1},{"text":"mɨkɨ pɨkatihayewa pɨkatipata:","poem":2},{"text":"«'Ekɨ mawari wewiwame pekanihɨkɨtɨni yuheyemekɨ mieme,","poem":1},{"text":"Merikitsereki hepaɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tati'aitɨwame 'atserieta kanakani,","poem":1},{"text":"te'aitamete kaniwatipɨnamɨkɨ kepauka mɨyeha'ani tukariyaritsie.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nuiwarite yakatiniwarakapitɨamɨkɨ, mɨkite kaniwakuxeɨrimɨkɨ,","poem":1},{"text":"mu'ute kanitipɨnamɨkɨ naitsarie kwiepa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Huyeta 'umietɨ tati'aitɨwame 'akitsie kanitiharimɨkɨ,","poem":1},{"text":"hikɨ mɨpaɨ tawarita kanitatɨrɨkaxɨamɨkɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}