{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"Yawé kenɨawarieka.","poem":1},{"lineBreak":true},{"text":"Yawé nepɨnɨawani naimekɨ ne'iyarikɨ meyumɨireme watsata,","poem":1},{"text":"heitserie memu'uwa meyuxeɨriekaku wahamatɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yawé 'uximayatsikaya kanimamariwaweni","poem":1},{"text":"meta waɨkawa mepuyutemamawie kemɨ'ane mɨkɨkɨ memɨteyɨ'ɨkitɨa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Witsipɨ'anene pɨmamariwawe 'uximayatsikaya,","poem":1},{"text":"kemɨtiheitserie yapɨtiyuriene yuheyemekɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yawé, mariwemekɨ yapɨtiuyuri temiku'eriwanikɨ.","poem":1},{"text":"Yawé, 'aixɨa pɨtiuka'iyari pɨtiyukanenimaya.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kemɨ'ane memeyemakaxe pɨtiwamikwa,","poem":1},{"text":"yutɨratu kemɨtiuwewi yakatine'eriwani.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yuteɨterima yutɨrɨkariya kaniwaruxeiyatsitɨani,","poem":1},{"text":"tiwayetuirieka hipame nuiwarite tiwapiinite.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Uximayatsikateya 'aixɨa pɨ'anene, kemɨtiheitserie pɨtiyuriene,","poem":1},{"text":"naitɨ 'aitsikaya yuri putiyuane, 'aixɨa pɨ'ane hetsiena temɨtewiyanikɨ,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"mɨkɨtsɨ yuheyemekɨ kani'ayumiemetɨni,","poem":1},{"text":"yuri mainetsie katiniwiyani meta mɨheitserietsie.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kakaɨyari yuteɨterima kaniwaruxɨna,","poem":1},{"text":"hikɨ yutɨratu mɨpaɨ katiniuwewieni yuheyemekɨ mieme.","poem":2},{"lineBreak":true},{"text":"Mɨkɨ mɨpatsie meta mɨtɨrɨkaɨye katinitewaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Xɨka xewitɨ timaiwetɨ heuyeimɨkɨni ke'itsutɨani Yawé 'ayemakatɨ,","poem":1},{"text":"kemɨ'ane 'aitsika memaye'atɨa mekanimatsiɨkɨni, heitseriemekɨ yamekateniyurieka.","poem":2},{"lineBreak":true},{"text":"Peuyewetse Kakaɨyari temɨnɨawani yuheyemekɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}