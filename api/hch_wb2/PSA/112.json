{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"Yawé kenɨawarieka.","poem":1},{"lineBreak":true},{"text":"'Aixɨa kani'itɨarieka kemɨ'ane Yawé mayemakaxe","poem":1},{"text":"meta kaniyutemawieka 'aitsikaya 'aye'atɨatɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Heitseriemekɨ yamemɨtekahu waniwema 'ena kwiepa mekatenita'aitakuni,","poem":1},{"text":"meta 'aixɨa mekani'itɨariekakuni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yukie waɨkawa piinite mepɨtehexeiyani,","poem":1},{"text":"meta yuheyemekɨ 'aixɨa mepɨteyurieka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Aixɨa memɨte'u'iyari mekanihekɨariwiyarieka yɨwipa.","poem":1},{"text":"Kakaɨyari 'aixɨa pɨtiuka'iyari, pɨtiyukanenimaya meta heitserie pɨtiyuriene.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Aixɨa pɨ'itɨarie kemɨ'ane mɨtiyuniniɨtɨwa piinite 'aixɨa 'anemekɨ,","poem":1},{"text":"meta 'aixɨa 'anemekɨ yupiinitsie mɨti'uximaya.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Aixɨa mɨtiuka'iyari yuheyemekɨ pukuxaxatsiwani,","poem":1},{"text":"hatsuakutɨma 'axamɨti'ane pɨkare'iwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Pɨkatimani kepauka niuki 'axa'aneme mɨtaxatɨarieni,","poem":1},{"text":"'iyarieya heitserie 'aixɨa pɨtiyɨkɨhɨaweni Yawé hetsie yuri ti'erietɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"'Iyarieya pɨxewini, pɨkaheumaka,","poem":1},{"text":"'ariketa memeye'unie puwaxeiya me'atixɨriekame.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tixaɨtɨ memɨkatehexeiya pɨtiwamikwa tita mɨrexeiya,","poem":1},{"text":"ke'aixɨa mɨtiyuriene yuheyemekɨ katiniyurieneni,","poem":2},{"lineBreak":true},{"text":"kemɨtiyurieneni 'aixɨa 'anemekɨ pɨmatiwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"'Axamɨtiuka'iyari mɨkɨ pɨtixeiya, hikɨ pɨyeha'ani,","poem":1},{"text":"yutame 'utaxikauteketɨ 'atsipɨyɨni.","poem":2},{"lineBreak":true},{"text":"'Axateyuruwamete kememɨteku'eriwa mɨkɨ yapɨkatikɨyɨne.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}