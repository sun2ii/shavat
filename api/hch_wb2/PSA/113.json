{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Yawé kenɨawarieka.","poem":1},{"lineBreak":true},{"text":"Yawé te'uximayatsiriwamete,","poem":1},{"text":"xekenenɨawani Yawé Kakaɨyari.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yawé hepaɨtsita 'aixɨa keraniuwani,","poem":1},{"text":"hikɨ mɨtiyehane meta yuheyemekɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yawé kenɨawarieka,","poem":1},{"text":"tau 'amɨranatinenitsie meta kepaukake makayune.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yawé naitsarie nuiwarite wahetsie katini'aitani,","poem":1},{"text":"muyuawitsie katini'aitani.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xewitɨ Yawé takakaɨyari hepaɨ pɨka'ane,","poem":1},{"text":"'uweni hexeiyatɨ muyuawitsie","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"mɨkɨ mana paitɨ muyuawi meta kwie pɨtaxeiya tixaɨtɨ karayuyeitɨatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mɨkɨ tixaɨtɨ mɨkarexeiya tumuanaripa kanatihanani,","poem":1},{"text":"meta xatsi matiwiwiwatsie patihana mɨreuyehɨwa,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"te'aitamete memɨmamariwawe wa'aurie kaniwarayayatsani,","poem":1},{"text":"teɨterimama tewa'aitɨwamete wa'aurie.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Uka mɨkaniwewe, yukii mexeiyanikɨ kanipitɨaka","poem":1},{"text":"meta tɨɨri mɨwarayexeiyakɨ.","poem":2},{"lineBreak":true},{"text":"Yawé kenɨawarieka.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}