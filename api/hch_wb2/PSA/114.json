{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"Kepauka 'Ixaheri, Kakuwu xiɨyarimama,","poem":1},{"text":"memayekɨ 'Ekipitu kwieyaritsie, hipame teɨteri wakie,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kura Kakaɨyari tukieya kanayani,","poem":1},{"text":"'Ixaheri kwieyari mɨra'aita patɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Haramara 'ixaheritsixi waruxeiyaka huye kananuwewieni memanukɨnekɨ,","poem":1},{"text":"metatsiere hatuxame Kurutani ka'uhanetɨ kanayani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hɨrite 'amɨtɨtɨ muxatsi 'ukitsi wahepaɨ mepɨte'utsunaxɨa","poem":1},{"text":"metatsiere yemurite 'etsimɨpepe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"¿Haramara, kemetiuyuri, titayari peranutayepierixɨ?","poem":1},{"text":"¿'Ekɨta Kurutani, titayari perewake pe'uhanetɨ?","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Xemeta hɨrite 'amɨtɨtɨ meta yemurite 'etsixemɨpepe,","poem":2},{"lineBreak":true},{"text":"¿titayari muxatsi 'ukitsi wahepaɨ xete'utsunaxɨa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Neuxei kwie, Yawé hɨxie keneuyɨyɨakani,","poem":1},{"text":"Kakuwu Kakaɨyarieya hɨxie.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mɨkɨ 'aitsie haa kananetɨani,","poem":1},{"text":"meta tete mayetse'itsie haixa kananetɨaxɨani.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}