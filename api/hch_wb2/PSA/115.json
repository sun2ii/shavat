{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":115,"content":[{"type":"verse","number":1,"content":[{"text":"Yawé, 'aixɨa pɨ'ane 'ekɨ pemɨnɨawarieka,","poem":1},{"text":"'anaki'eriyakɨ meta yuri pemɨtikuxatakɨ,","poem":2},{"lineBreak":true},{"text":"tame matsi heitserie tepɨkahexeiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hipatɨ teɨteri mɨpaɨ meputiyuaneni, metatsinanaimatɨ:","poem":1},{"text":"«¿Hakewa 'aku xekakaɨyari?»","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Takakaɨyari muyuawitsie kaniuyeikani,","poem":1},{"text":"mɨkɨ yakatiniyurieneni kemɨtinake.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Peru mɨkɨ nuiwarite memɨwarayexeiya kakaɨyarixi huru meta pɨrata mekanihɨkɨtɨni,","poem":1},{"text":"teɨteri wawewiya.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Meputeni, peru mepɨkaniuwawe,","poem":1},{"text":"mepuhɨxi, peru mepukaheuneniere,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"mepunaka, peru mepɨkaheu'enana,","poem":1},{"text":"meputsuri, peru mepɨkateheu'ɨkwe,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"mepumama, peru mepɨkatemayɨawawe,","poem":1},{"text":"mepɨ'ɨka, peru mepɨka'ɨkɨniwawe,","poem":2},{"lineBreak":true},{"text":"mepɨkɨipi peru mepɨkayɨwawe memɨtehata'eiyakɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kemɨ'ane memɨwatiwewiwa, mɨkɨ wahepaɨ mepɨ'anene,","poem":1},{"text":"metatsiere yunaitɨ yuri memɨte'erie wahetsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Matsi 'ixaheritsixi, Yawé hetsie yuri xeketene'erieka,","poem":1},{"text":"mɨkɨ kanixeparewiwametɨni meta xehetsie nunuwame kanihɨkɨtɨni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Aruni xiɨyarimama, Yawé hetsie yuri xeketene'erieka,","poem":1},{"text":"mɨkɨ kanixeparewiwametɨni meta xehetsie nunuwame kanihɨkɨtɨni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kemɨ'ane Yawé xemayemakaxe, mɨkɨ hetsie yuri xeketene'erieka,","poem":1},{"text":"mɨkɨ kanixeparewiwametɨni meta xehetsie nunuwame kanihɨkɨtɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yawé pɨkatatsi'atɨmaiya meta 'aixɨa kataniyurieka:","poem":1},{"text":"'ixaheritsixi 'aixɨa kaniwayurieka,","poem":2},{"lineBreak":true},{"text":"meta 'Aruni xiɨyarimama 'aixɨa kaniwayurieka,","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"'aixɨa kaniwayurieka kemɨ'ane Yawé memayemakaxe,","poem":2},{"lineBreak":true},{"text":"'aixɨa kaniwayurieka 'amemɨtɨtɨ meta 'etsimemɨtɨtɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Yawé kewamɨiriyani xetɨɨriyama","poem":1},{"text":"meta xeniwema watɨɨriyama.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yawé hetsɨa timieme 'aixɨa mɨti'ane wahetsie ketinakeni,","poem":1},{"text":"muyuawi mutawewi meta kwie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Muyuawi Yawé katinipiinieyatɨni,","poem":1},{"text":"peru teɨteri kwie kaniwayetuirieni.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Memukwiri mepɨkayɨwawe Yawé memɨnɨawani,","poem":1},{"text":"memukateukiekɨri.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tame tekanihɨkɨtɨni Yawé temɨnɨawa","poem":1},{"text":"hikɨ meta yuheyemekɨ.","poem":2},{"lineBreak":true},{"text":"Yawé kenɨawarieka.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}