{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":116,"content":[{"type":"verse","number":1,"content":[{"text":"Ne Yawé nepɨnaki'erie","poem":1},{"text":"mɨkɨ mɨnetsi'eniekɨ waɨkawamekɨ nehehɨawekaku.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mɨkɨ nenenewieri mɨ'eniekɨ,","poem":1},{"text":"yuheyemekɨ yanepɨrehɨawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mɨki yuwiniyarikɨ pɨnetsihɨakai,","poem":1},{"text":"'uximatɨarika pɨnetsi'umi tɨma,","poem":2},{"lineBreak":true},{"text":"'anari waɨkawa nepɨtiuka'eniexɨa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hikɨ 'ana Yawé waɨkawamekɨ mɨpaɨ nekatiniutahɨawe:","poem":1},{"text":"«Yawé, waɨkawamekɨ nepɨmetsiwawirie, netukari keneutawikweitsitɨa».","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yawé pɨtiyukanenimaya heitserie pɨtiyuriene,","poem":1},{"text":"takakaɨyari naimekɨ witsipɨtiuka'iyari.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Teɨteri yuhetsie memɨkaheutanuawawe Yawé wahetsie kaninuaka,","poem":1},{"text":"ne nepɨkayɨwekairi mɨkɨ pɨnetsi'utawikweitsitɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ne'iyari, kayuwatɨ kenexeiyaniri,","poem":1},{"text":"'ahetsiemieme Yawé 'aixɨa katiniuka'iyarini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"'Ekɨ pepɨnetsi'utawikweitsitɨa nemɨximekaku,","poem":1},{"text":"ne'ukai pepa'itiexɨa,","poem":2},{"lineBreak":true},{"text":"nemekawautsenikɨ pepɨkanetsipitɨa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Ayumieme yuheyemekɨ Yawé hɨxie nepuyeikani,","poem":1},{"text":"mexixi 'ena kwiepa mɨranu'uwatɨka ne'uyeika.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tsepa mɨpaɨ nemɨmatikɨhɨawe: «Waɨkawa nepɨtiuka'eniwa ne'iyaritsie»,","poem":1},{"text":"peru Kakaɨyari hetsie yuri nepɨti'erie.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mɨpaɨ neputayɨ newaɨripietɨ:","poem":1},{"text":"«Yunaitɨ memɨte'itawa mepɨhɨkɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nepɨkayɨwe kenemɨrekapitɨani Yawé,","poem":1},{"text":"waɨkawa 'aixɨa mɨti'ane mɨnetiupitɨakɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nepɨyɨwe xeikɨa pamɨpariyutsi nemɨmetsipitɨaka 'awikweitsitɨarikakɨ,","poem":1},{"text":"meta nemetsinuawatɨ neyunenewietɨ Yawé.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Metatsiere neraye'atɨatɨ xeikɨa Yawé kenemɨrahɨawe","poem":1},{"text":"yunaime teɨterimama wahɨxie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Yawé puyukahiwerɨwa kepauka","poem":1},{"text":"hetsiena yamemɨtekahu memɨtakukuwe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yawé, ne ti'a'uximayatsiriwame nepɨhɨkɨ,","poem":1},{"text":"nemaamata ti'a'uximayatsiriwame pɨhɨkɨtɨkai.","poem":2},{"lineBreak":true},{"text":"Kepauka tepɨa kaunariyarikɨ nemɨhɨakai, 'ekɨ pepeitekixɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kenemɨtiyutemawie mawariyari nepɨmetsiwewirieni","poem":1},{"text":"meta nepɨmetsikuxatani Yawé.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yawé nepɨraye'atɨirieni kenemutayɨ,","poem":1},{"text":"yunaime teɨterimama wahɨxie,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yawé kiita hɨxie takwa,","poem":1},{"text":"Kerutsareme 'ahixɨapa.","poem":2},{"lineBreak":true},{"text":"Yawé kenɨawarieka.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}