{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":118,"content":[{"type":"verse","number":1,"content":[{"text":"Yawé pamɨpariyutsi xekenepitɨaka, mɨkɨ 'aixɨa katiniuka'iyarini,","poem":1},{"text":"kemɨtiuyukanaki'erie yuheyemekɨ kataninaki'erieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"'Ixaheritsixi mɨpaɨ meke'utiyuaneni:","poem":1},{"text":"«Kakaɨyari pɨkatihayewa tatsinaki'erietɨ yuheyemekɨ».","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Aruni xiɨyarimama mɨpaɨ meke'utiyuaneni:","poem":1},{"text":"«Kakaɨyari pɨkatihayewa tatsinaki'erietɨ yuheyemekɨ».","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mɨpaɨ meke'utiyuaneni kemɨ'ane Yawé memayemakaxe:","poem":1},{"text":"«Kakaɨyari pɨkatihayewa tatsinaki'erietɨ yuheyemekɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Waɨkawa netiuka'eniwatɨ Yawé nekaniutahɨawe,","poem":1},{"text":"hikɨ mɨkɨ kaneniuta'eiya 'aixɨa kaneniuyurieni nemɨkatiuka'eniwanikɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yawé nehamatɨa kaniuyeikani, ne nepɨkaheuma,","poem":1},{"text":"¿xewitɨ tewi 'atsimɨnetsi'uyurieni pɨkayɨwe?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yawé nehamatɨa kaniuyeikani, mɨkɨ netsiparewiwame kanihɨkɨtɨni,","poem":1},{"text":"tsiparatsɨ nekaniwaxeiyamɨkɨ kwiepa mekuheime memɨnetsi'aye'unie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Matsi 'aixɨa pɨ'ane Yawé hetsie muyu'awietanikɨ,","poem":1},{"text":"pɨkaheuyewetse tewi hetsie mɨtiwiyani.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Matsi 'aixɨa pɨ'ane Yawé hetsie muyu'awietani,","poem":1},{"text":"'aixɨa pɨka'ane teɨteri memɨmamariwawe wahetsie mɨtiwiyani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yunaitɨ nuiwarite menetsi'aye'unietɨ mekanaketɨkɨne,","poem":1},{"text":"peru Yawé netsi'uparewieku nekaniwara'iwa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Naitsarie nuiwarite mekaneniuhupieni,","poem":1},{"text":"peru Yawé netsi'uparewieku nekaniwara'iwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xietexi wahepaɨ nehetsie mepɨteheukayexɨa,","poem":1},{"text":"peru meputitai kɨximɨari mɨtitatawe hepaɨ.","poem":2},{"lineBreak":true},{"text":"Yawé netsi'uparewieku nekaniwara'iwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Menetsinanaimatɨ mepɨnetsihetaimaxɨ nemekawenikɨ,","poem":1},{"text":"peru Yawé kaneniuparewieni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yawé netɨrɨkariya kanihɨkɨtɨni meta nekwikari,","poem":1},{"text":"mɨkɨ netsiwikweitsitɨwame kanihɨkɨtɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Heitseriemekɨ memu'uwa wakiita","poem":1},{"text":"puxuawe hiwarika temawierikayari metehayu'iwaka:","poem":2},{"text":"«Yawé yutɨrɨkariyakɨ mariweme pɨtiyuriene,","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Yawé tɨrɨkariyaya pɨnɨawarie.","poem":2},{"lineBreak":true},{"text":"Yawé yutɨrɨkariyakɨ mariweme pɨtiyuriene».","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Hawaikɨ nepɨkamɨni, nepayeniereni","poem":1},{"text":"Yawé mariwemekɨ kemɨtiyuriene nemikuxatanikɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yawé pɨnetsi'ukuwaxɨa tiyukukuinemekɨ,","poem":1},{"text":"peru nemɨmɨnikɨ pɨkanetsiyetua.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Xekeneteneuyepiri kitenie hakewa memeutahaketsie 'aixɨa 'anemekɨ memu'uwa,","poem":1},{"text":"ne nemeutahanikɨ pamɨpariyutsi Yawé nemɨpitɨanikɨ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mɨkɨ Yawé kitenieya kanihɨkɨtɨni,","poem":1},{"text":"muwa mekaneutahakeni teɨteri heitserie memexeiya.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Pemɨnetsi'uta'eikɨ pamɨpariyutsi nepɨmetsipitɨani,","poem":1},{"text":"'ekɨ netsiwikweitsitɨwame pemɨhɨkɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Kii wewiwamete tete memutixani'eri,","poem":1},{"text":"matsi mɨkɨ tete 'itsikina mieme kanayani.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mɨkɨkɨ tepɨhɨxiya mariwemekɨ,","poem":1},{"text":"Yawé pɨta matsi katiniuyurieni.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"'Ikɨ tukaritsie Yawé mɨpaɨ katiniuyurieni,","poem":1},{"text":"'aixɨa tepɨteku'eriwani tepuyutemamawieka hetsiena mieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Yawé, wikweitsitɨarika ketaneupitɨa,","poem":1},{"text":"Yawé, temɨtehayu'iwakɨ ketaneupitɨa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"'Aixɨa ke'itɨarieka kemɨ'ane 'umamie Yawé hetsɨa mieme hɨkɨtɨtɨ.","poem":1},{"text":"Yawé kiita paitɨ 'aixɨa tepɨte'ikɨhɨawe.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Yawé kanikakaɨyaritɨni meta katanihekɨariwiyani,","poem":1},{"text":"hikɨmɨ tepɨwatinɨni Kakaɨyari teɨterimama tuturi tepanupini","poem":2},{"lineBreak":true},{"text":"mawari taiyame 'awayatsie paitɨ tepikɨwɨtɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"'Ekɨ pepɨnekakaɨyari, 'ayumieme pamɨpariyutsi nepɨmetsipitɨa,","poem":1},{"text":"'ekɨ pepɨnekakaɨyari, 'ayumieme nepɨmetsinɨawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Yawé pamɨpariyutsi xekenepitɨaka, mɨkɨ 'aixɨa katiniuka'iyarini,","poem":1},{"text":"mɨkɨ yuheyemekɨ kataninaki'erieka.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}