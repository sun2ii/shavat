{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":119,"content":[{"type":"verse","number":1,"content":[{"text":"'Aixɨa mekani'itɨarieka kemɨ'ane huye 'aixɨa mɨ'ane 'utɨa memuhu,","poem":1},{"text":"Yawé 'aitsikaya kemaine mɨpaɨ memɨte'u'uwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Aixɨa mekani'itɨarieka kemɨ'ane 'a'inɨari niukiyari memu'uta","poem":1},{"text":"meta yu'iyarikɨ memikuwautɨwe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hatsuakutɨma 'axamepɨkateheyurie,","poem":1},{"text":"matsi pɨta Kakaɨyari huyeya mepuweiya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Ekɨ 'aitsika pekaniyetuani,","poem":1},{"text":"heitseriemekɨ maye'atɨariwanikɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Waɨkawamekɨ nepɨnewaɨriya nehuye 'aixɨa nemuyurienikɨ,","poem":1},{"text":"nemeye'atɨanikɨ 'a'aitsika.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hatsuaku nepɨkatewiyatsitɨarieni","poem":1},{"text":"kepauka naime 'a'aitsika nemaye'atɨaka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne ne'iyarikɨ nepɨmetsitanɨawa,","poem":1},{"text":"kepauka nemeitimani ke'aixɨa pemɨti'aitakɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"'A'inɨari niukiyari nepaye'atɨani,","poem":1},{"text":"pepɨkanetsi'uku'e'eiriwani naimekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"¿Kehepaɨ 'anetɨ temaikɨ pɨ'itiyaka?","poem":1},{"text":"Yatikamietɨ 'aniuki kemaine.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne naime ne'iyarikɨ nepɨmetsikuwaɨne,","poem":1},{"text":"pepɨkanetsipitɨaka 'a'aitsika nemuku'e'eiriwanikɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne'iyaritsie 'aniuki nepu'uta","poem":1},{"text":"kapa 'ahetsiemieme 'axanetiuyurienikɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yawé, 'aixɨa pemɨrayurieni pepɨhɨkɨ.","poem":1},{"text":"Keneneuta'ɨkitɨa 'a'aitsika nemetimanikɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ne naime 'a'aitsika","poem":1},{"text":"yanekatinikuxatani pemɨtatsi'uta'ɨkitɨa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Waɨkawamekɨ nepɨnetemawie 'aniuki kemaine mɨpaɨ netiuyeikatɨ","poem":1},{"text":"keyuri waɨkawa nerexeiyatɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'A'aitsika nepuku'eriwa,","poem":1},{"text":"meta 'ahuye'utɨa xeikɨa nepɨne'ɨwiya.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"'A'aitsikatsie temawierika nepukaxexeiya,","poem":1},{"text":"hatsuaku nepɨkahetɨmaiya 'aniuki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ne ti'a'uximayatsiriwame 'aixɨa kenetinexeiyani,","poem":1},{"text":"mɨpaɨ nemɨtiuyeikanikɨ meta 'aniukitsie yanemɨtikamienikɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Neheuniereme kenenayeitɨa, nemixeiyakɨ","poem":1},{"text":"'a'ɨkitsikate mɨmamariwawe.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ne kuyeikame nekanihɨkɨtɨni 'ena kwiepa,","poem":1},{"text":"'a'aitsika pepɨkanetsi'awitsirieka.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mɨixa nekɨipitsie pɨrekaka,","poem":1},{"text":"ke'aixɨa pemɨti'aita neheumaimɨtɨ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"'Ekɨ pepɨwarutate'a memuyuti'ɨre,","poem":1},{"text":"'axameke'itɨarieka kemɨ'ane yamemɨkatekahu 'a'aitsikatsie.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"'Ekɨ pepɨkawapitɨaka hipatɨ memɨnetsiyuriyani,","poem":1},{"text":"ne matsi 'a'aitsikatsie yanemɨtikamiekɨ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kemɨ'ane tɨrɨkariya memexeiya nehetsiemieme mepɨtekuxata kememɨnetsiyurienikɨ,","poem":1},{"text":"peru matsi ne ti'a'uximayatsiriwame 'a'aitsika xeikɨa nepuku'eriwa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"'A'aitsika pɨnetsitemawieritɨa,","poem":1},{"text":"meta mɨkɨ netsi'ɨxatsitɨwamete mepɨhɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Kwiepa nekanitihɨximaweni,","poem":1},{"text":"tukari keneneupitɨa 'aniukitsie kepemaine.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kepauka nemɨmetsi'utaxatɨa kenemɨtiyurienikɨ, 'ekɨ pepɨnetsi'uta'ei.","poem":1},{"text":"'A'aitsika keneneuti'ɨkitɨa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Keneneupitɨa 'a'aitsika hepaɨtsita nemɨtimaikakɨ,","poem":1},{"text":"mariwemekɨ kepemɨtiuyuri nemuku'eriwanikɨ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Hiwerikakɨ ne'iyari pɨtaxɨxime:","poem":1},{"text":"ne'iyari ketinemikwani 'aniuki kemainekɨ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Pepɨkanetsipitɨaka huye mututuni nemanukuweweiyanikɨ,","poem":1},{"text":"'aniuki kemaine netimaikame kenenayeitɨaka.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Nepɨnewaɨriya huye mɨheitserie nemuweiyanikɨ,","poem":1},{"text":"meta 'a'aitsika nepanayexei nemiweiyanikɨ.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Yawé, ne 'a'aitsikatsie nepɨtiwiya,","poem":1},{"text":"pepɨkanetsipitɨaka nemɨtewiyatsitɨarienikɨ.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"'A'aitsika huyeyari 'utɨma nekaniunautsarɨmeni,","poem":1},{"text":"'ekɨtsɨ waɨkawa nemɨnekɨhɨawenikɨ pekaneniupitɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Yawé, kenetineuti'ɨkitɨa 'a'aitsika nemuweiyanikɨ,","poem":1},{"text":"hikɨ ne yanekatinikayeimɨkɨ kemaine kenemɨreutere ne'uyeikatɨ.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Nemɨtimaiwenikɨ keneneupitɨa 'a'aitsikatsie yanemɨtiyurienikɨ,","poem":1},{"text":"naime ne'iyarikɨ nekaneye'atɨakamɨkɨ.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"'A'aitsika huyeyari 'utɨma keneneuwitɨximeni,","poem":1},{"text":"mɨkɨtsie temawierika nepukaxexeiya.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ne'iyari 'a'aitsikatsie yɨkɨhɨaweme kenayeitɨa,","poem":1},{"text":"matsi tumini 'iwarikayarikɨ 'axamɨ'anetsie pɨkayɨhɨaweni.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Nitixaɨtɨ mɨkatihɨkɨ hetsie nenekɨ'ɨwiyame pepɨkanetsihayeitɨaka,","poem":1},{"text":"matsi tukari keneneupitɨa 'aniukitsie kepemaine.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"'Aniuki kenaye'atɨa 'ikɨ ti'a'uximayatsiriwame hetsie,","poem":1},{"text":"kepemɨtiyuriene memɨmetsihayemakaxe wahetsie.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"'Uximatɨarika tewiweme kenemɨrexeiya, mɨkɨ hepaɨtsita keneneɨxɨna,","poem":1},{"text":"'ekɨ matsi 'itsɨkame 'aixɨa pemɨtiuka'iyari pepɨhɨkɨ.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Ne 'a'aitsika niukiyari nepɨnaki'erie.","poem":1},{"text":"Tukari keneneupitɨa heitseriemekɨ 'ekɨ kepemɨtiyupitɨwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"Yawé, 'anaki'eriya mɨmariwe kenenanɨ'airi","poem":1},{"text":"meta wikweitsitɨarika 'ahetsɨa miemekɨ kepemutayɨ.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"'Ana nepɨyɨweni nemɨwaruta'eiya 'axamemɨnetekɨhɨawe,","poem":1},{"text":"ne 'aniukitsie nemɨtiwiyakɨ.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Yuri netikuxatame xeikɨa kenenayeitɨaka,","poem":1},{"text":"'a'aitsika hetsie xeikɨa nekanita'ikwewani.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Yuheyemekɨ","poem":1},{"text":"'a'aitsikatsie heitseriemekɨ yanepɨtikamieni.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"'Aixɨa 'anemekɨ nepukuyeikani 'atsinekatiku'eriwatɨ,","poem":1},{"text":"ne 'a'aitsika nemuweiyakɨ.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Ne te'aitamete nepɨtiwataxatɨani 'a'aitsika hepaɨtsita,","poem":1},{"text":"hawaikɨ nepɨkanetitewiya,","poem":2}]},{"type":"verse","number":47,"content":[{"text":"matsi 'a'aitsika nemɨnaki'eriekɨ,","poem":1},{"text":"meta mɨkɨkɨ ne nekaniyutemawieka.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Ne 'a'aitsika nekaninaki'erieka,","poem":1},{"text":"mɨkɨkɨ nekaniyutemawieka,","poem":2},{"lineBreak":true},{"text":"'a'aitsika nemuku'eriwani pɨnetsinake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"Kena'eriwani 'ikɨ ti'a'uximayatsiriwame ke'aneme niuki pemiyetuiri,","poem":1},{"text":"mɨkɨ niukikɨ neta'ikwewame pemɨnetsi'ayeitɨa.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"'Ikɨ netsinɨtɨwame kanihɨkɨtɨni kepauka nemɨtiuka'eniwa:","poem":1},{"text":"'aniukitsie kepemaine tukari kanenipitɨaka.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Memɨyuti'ɨre kwinimieme 'axamepɨnetekɨhɨawe,","poem":1},{"text":"ne peru 'a'aitsika nepɨka'uku'e'eiriwa.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"Yawé, ne 'a'aitsika nepa'eriwa meripaitɨ mieme,","poem":1},{"text":"mɨkɨtsie nɨtɨarika nepukaxexeiya.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"'Axateyuruwamete wahepaɨtsita nepɨha'a,","poem":1},{"text":"'a'aitsika memuku'eirikɨ.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"'A'aitsika nekwikari pɨhɨkɨ,","poem":1},{"text":"'ena yapaɨmexɨa nemanuyeikatsie.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Yawé, yɨwikɨta nepɨmetsihahɨawe kepemɨtitewakɨ,","poem":1},{"text":"nepɨnewaɨriya 'a'ɨkitsika nemaye'atɨanikɨ.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Ne 'a'aitsika memaye'atɨwanikɨ","poem":1},{"text":"nehɨritɨarika kanihɨkɨtɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":57,"content":[{"text":"Yawé, 'ekɨ tita nemɨrexeiya pekanihɨkɨtɨni.","poem":1},{"text":"'Aniuki kemaine nepeye'atɨani, mɨpaɨ nepaine.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Ne'iyarikɨ yemekɨ yanepɨtikamienikeyu kemɨmetinake,","poem":1},{"text":"keneneutinenimayata kepemutayɨ.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"'Ari netukari nepeutimaixɨa,","poem":1},{"text":"mɨpaɨ nepɨtinewaɨriya nemeye'atɨanikɨ 'a'aitsika.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Nepɨnemexɨitɨa, xeiya nepɨrayeitɨwa","poem":1},{"text":"'a'aitsika nemaye'atɨanikɨ.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"Tsepanetɨ 'axamemɨte'u'iyari memɨnetsiwiniyaku,","poem":1},{"text":"ne matsi 'a'aitsika nepɨkahatɨtɨmaiya.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"Tɨkari hixɨapa nepanukukeka pamɨpariyutsi nemetsipitɨanike,","poem":1},{"text":"'a'aitsika heitseriemekɨ mɨtikuxatakɨ.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Kemɨ'ane memɨmetsihayemakaxe nekaniwahamikutɨni,","poem":1},{"text":"meta 'a'aitsikatsie yamemɨtekahu.","poem":2}]},{"type":"verse","number":64,"content":[{"text":"Yawé, 'a'aitsika keneneuti'ɨkitɨa,","poem":1},{"text":"kwiepa waɨkawa puxuawe 'anaki'eriya mɨmariwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":65,"content":[{"text":"Yawé, ti'a'uximayatsiriwame 'aixɨa ketinexeiyani,","poem":1},{"text":"'aniuki kemainekɨ.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Kenenepitɨaka nemɨtimaiwenikɨ meta nemeitimaitɨyeikanikɨ,","poem":1},{"text":"ne 'a'aitsikatsie yuri nekatini'erieka.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"Meripaitɨ mexixi nekatikwiniwekai, 'ateewa nepuyeikakai,","poem":1},{"text":"peru hikɨ 'aniukitsie yanepɨtikamie.","poem":2}]},{"type":"verse","number":68,"content":[{"text":"'Ekɨ 'aixɨa pepɨtiuka'iyari, meta 'aixɨa pepɨtiyuriene,","poem":1},{"text":"'a'aitsikate keneneuti'ɨkitɨa.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"Tsepanetɨ memuyuti'ɨre nehetsiemieme 'axakememutiyuane,","poem":1},{"text":"ne nepeye'atɨwa 'a'aitsika yemekɨ ne'iyarikɨ.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"Mɨkɨ mepɨka'u'iyari yemekɨ,","poem":1},{"text":"peru ne nepuyutemawie 'a'aitsikakɨ.","poem":2}]},{"type":"verse","number":71,"content":[{"text":"'Aixɨa pɨ'ane pemɨnetiukwinitɨa,","poem":1},{"text":"'a'aitsika mɨkɨkɨ nepetima.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"'A'ɨkitsika matsi waɨkawa pɨraye'axe nehetsiemieme,","poem":1},{"text":"keyuri pɨrata meta huru tuminiyari waɨkawatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":73,"content":[{"text":"'Atɨrɨkariyakɨ pepɨnetsi'utawewi, kenemɨ'aneni yapepɨnetiuwewi.","poem":1},{"text":"Nemeitimaitɨyeikanikɨ keneneupitɨa 'a'aitsika nemɨmaikakɨ.","poem":2}]},{"type":"verse","number":74,"content":[{"text":"Kemɨ'ane memɨmetsihayemakaxe kepauka memɨnetsixeiya mekaniyutemamawieka,","poem":1},{"text":"'aniukitsie yuri nemɨti'eriekɨ neta'ikwewatɨ.","poem":2}]},{"type":"verse","number":75,"content":[{"text":"Yawé, ne nepɨtimate 'a'aitsika 'aixɨa pɨ'ane,","poem":1},{"text":"meta pɨheitserie kepemɨnetikuwaya.","poem":2}]},{"type":"verse","number":76,"content":[{"text":"'Anaki'eriya mɨmariwe kehɨkɨtɨni mɨnetsinɨtɨani,","poem":1},{"text":"'ikɨ ti'a'uximayatsiriwame kepemɨtiutahɨawixɨ.","poem":2}]},{"type":"verse","number":77,"content":[{"text":"'Anenimayatsika kenuani tukari kenetsi'upitɨani,","poem":1},{"text":"'a'aitsikatsie nemuyutemawiekɨ.","poem":2}]},{"type":"verse","number":78,"content":[{"text":"Memuyuti'ɨre meke'utewiyatsitɨarieni yakɨ xeikɨa memɨnetsiniukimakɨ,","poem":1},{"text":"ne matsi, 'a'aitsika nepuku'eriwani.","poem":2}]},{"type":"verse","number":79,"content":[{"text":"Kemɨ'ane memɨmetsi'ayemakaxe mekenetsi'utinɨni,","poem":1},{"text":"kemɨ'ane 'a'aitsika memɨmate.","poem":2}]},{"type":"verse","number":80,"content":[{"text":"Ne'iyari heitseriemekɨ keyukɨhɨaweni 'a'aitsikatsie,","poem":1},{"text":"ne nemɨkatewiyatsitɨarienikɨ hatsuaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":81,"content":[{"text":"'Awikweitsitɨarika netakwewietɨ netukari pɨtixɨxime.","poem":1},{"text":"'Aniuki kemaine mɨpaɨ nekatinita'ikwewani.","poem":2}]},{"type":"verse","number":82,"content":[{"text":"Kepemutayɨkɨ neta'ikwewatɨ nepɨkaheuniereri,","poem":1},{"text":"meta mɨpaɨ nekaniutaineni: «¿Kepaukari pepunuani penetsinɨtɨanike?»","poem":2}]},{"type":"verse","number":83,"content":[{"text":"Nawi kɨxauriyari hepaɨ nepɨtiyuxexeiya kɨtsikɨ mɨyɨxaɨye,","poem":1},{"text":"peru 'a'aitsika kemaine nepɨkahatɨmaiya.","poem":2}]},{"type":"verse","number":84,"content":[{"text":"¿Kepaɨmexɨa 'akuxi 'ikɨ ti'a'uximayatsiriwame 'apuyeikani?","poem":1},{"text":"¿Kepauka memɨnetsi'aye'unie pepɨtiwarakapitɨani?","poem":2}]},{"type":"verse","number":85,"content":[{"text":"Putsu mekaniutiwewieni memuyuti'ɨre muwa nemeukawenikɨ,","poem":1},{"text":"'a'aitsika kemaine mɨpaɨ memɨkatekahu.","poem":2}]},{"type":"verse","number":86,"content":[{"text":"Naitɨ 'a'aitsika yuri paine,","poem":1},{"text":"keneneuparewi 'atsinekatiyurienekaku, memɨnetsi'uweiyakɨ menetsi'itatɨ.","poem":2}]},{"type":"verse","number":87,"content":[{"text":"'Etsiwatɨkaku kwiepa mepɨnetsi'ukumaweriyaxɨ nemɨka'uyeikanikɨ,","poem":1},{"text":"peru ne 'a'aitsika nepɨka'uku'e'eiriwa.","poem":2}]},{"type":"verse","number":88,"content":[{"text":"'Anaki'eriya mɨmariwekɨ tukari keneneupitɨa,","poem":1},{"text":"hikɨ 'ana 'a'aitsika nepaye'atɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":89,"content":[{"text":"Yawé, 'aniuki yuheyemekɨ pɨ'ayumieme,","poem":1},{"text":"meta muyuawitsie 'aniuki pɨ'enierie.","poem":2}]},{"type":"verse","number":90,"content":[{"text":"'Ekɨ 'aheyemekɨ yapepɨtikamie,","poem":1},{"text":"kepauka kwie pemutawewi, heitseriemekɨ 'aixɨa pɨyɨ.","poem":2}]},{"type":"verse","number":91,"content":[{"text":"Hikɨ naitɨ pɨtixuawe, kepemɨtiu'aitaxɨ,","poem":1},{"text":"yunaitɨ mematsi'enietɨ yamekateniyurieka.","poem":2}]},{"type":"verse","number":92,"content":[{"text":"Xɨka 'a'aitsika kanetsitemawieritɨakake,","poem":1},{"text":"hiwerikakɨri nekaniumɨnike.","poem":2}]},{"type":"verse","number":93,"content":[{"text":"'A'aitsika hatsuaku nepɨkahatɨmaiya,","poem":1},{"text":"mɨkɨkɨ tukari pemɨnetsi'upitɨakɨ.","poem":2}]},{"type":"verse","number":94,"content":[{"text":"'Ahetsɨa nepɨmieme, keneneutawikweitsitɨa,","poem":1},{"text":"meta 'a'aitsika nemukuwaunekɨ neheye'atɨanike.","poem":2}]},{"type":"verse","number":95,"content":[{"text":"'Axateyuruwamete mepɨnetsihupietɨwe menetsimienike,","poem":1},{"text":"peru ne tawarita 'a'aitsikakɨ nepɨtɨrɨkariyarieni.","poem":2}]},{"type":"verse","number":96,"content":[{"text":"Mɨpaɨ nepɨretima tita mɨtiheitserie 'apu'axe,","poem":1},{"text":"peru 'a'aitsikate hawaikɨ pɨkahau'atɨka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":97,"content":[{"text":"Yemekɨ ne waɨkawa 'a'ɨkitsika nepɨnaki'erie.","poem":1},{"text":"Tukarikɨ mɨkɨ xeikɨa nepuku'eriwa.","poem":2}]},{"type":"verse","number":98,"content":[{"text":"'A'aitsikate waɨkawa netimaiweme pɨnetsi'ayeitɨa keyuri memɨnetsi'aye'unie,","poem":1},{"text":"matsi mɨkɨ yuheyemekɨ nehetsiemieme mɨhɨkɨkɨ.","poem":2}]},{"type":"verse","number":99,"content":[{"text":"Matsi waɨkawa nepɨtimaiwe nete'ɨkitɨwamete nepɨwara'iwa,","poem":1},{"text":"'a'aitsika xeikɨa nemuku'eriwakɨ.","poem":2}]},{"type":"verse","number":100,"content":[{"text":"Ne matsi waɨkawa nepɨtiuyemate keyuri 'ukirawetsixi,","poem":1},{"text":"'a'aitsika kemaine mɨpaɨ nemɨtikamiekɨ.","poem":2}]},{"type":"verse","number":101,"content":[{"text":"Ne huye 'axamɨ'anene nepɨka'uweiya,","poem":1},{"text":"'aniuki nemaye'atɨwanikɨ.","poem":2}]},{"type":"verse","number":102,"content":[{"text":"'A'ɨkitsika nepɨka'uku'e'eiriwa,","poem":1},{"text":"'ekɨ mɨpaɨ pemɨneti'ɨkitɨakɨ.","poem":2}]},{"type":"verse","number":103,"content":[{"text":"'Aniuki nenenitsie witsipɨrakaka.","poem":1},{"text":"Waɨkawa matsi pakaka keyuri xiete kemɨrakaka neteta.","poem":2}]},{"type":"verse","number":104,"content":[{"text":"'A'aitsikatsie netimaiwetɨ nepatɨa,","poem":1},{"text":"'ayumieme naime mɨti'itawa huyeyari nepɨxani'erie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":105,"content":[{"text":"'Aniuki ne'ɨkatsie kɨxeme kanihɨkɨtɨni,","poem":1},{"text":"nehuyeta mɨhekɨariwie.","poem":2}]},{"type":"verse","number":106,"content":[{"text":"Ne tɨratu nepuwewi nekɨmana, meta yanepɨra'eriwa:","poem":1},{"text":"kename 'a'aitsikatsie yanetikayani.","poem":2}]},{"type":"verse","number":107,"content":[{"text":"Yawé, pɨtimɨireri kenemɨtiuka'eniwa,","poem":1},{"text":"tukari keneneupitɨa 'aniuki kemainekɨ.","poem":2}]},{"type":"verse","number":108,"content":[{"text":"Yawé, kenenaki'erieka 'ikɨ temawierika mawariyari neteta mayeneika,","poem":1},{"text":"'a'aitsika keneneuti'ɨkitɨa.","poem":2}]},{"type":"verse","number":109,"content":[{"text":"Netukari kaunari 'etsimɨpe hepaɨ pɨ'ane,","poem":1},{"text":"peru 'a'aitsika nepɨkahatɨtɨmaiya.","poem":2}]},{"type":"verse","number":110,"content":[{"text":"'Axamemɨte'u'iyari mepɨnetsiwiniyatɨwe,","poem":1},{"text":"peru ne 'a'aitsikate nepɨka'uku'e'eiriwa.","poem":2}]},{"type":"verse","number":111,"content":[{"text":"'A'aitsika nehetsiemieme pɨhɨkɨ yuheyemekɨ,","poem":1},{"text":"mɨkɨ ne'iyari mepɨtemawieritɨa.","poem":2}]},{"type":"verse","number":112,"content":[{"text":"Nepɨnewaɨriya ne'iyarikɨ 'a'aitsika nemaye'atɨakakɨ,","poem":1},{"text":"yuheyemekɨ meta kepaɨmexɨa nemɨyurieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":113,"content":[{"text":"Memɨkate'aye'atɨa nepɨwaxani'erie,","poem":1},{"text":"peru 'a'ɨkitsika nepɨnaki'erie.","poem":2}]},{"type":"verse","number":114,"content":[{"text":"'Ekɨ netsi'awiwietame pepɨhɨkɨ meta kɨmana nemuyukunarɨma pepɨhɨkɨ,","poem":1},{"text":"'aniuki kemaine mɨpaɨ nekatinita'ikwewani.","poem":2}]},{"type":"verse","number":115,"content":[{"text":"Xekeneutayeixɨa, 'axaxemɨte'u'iyari,","poem":1},{"text":"ne Kakaɨyari 'aitsikaya nepaye'atɨani.","poem":2}]},{"type":"verse","number":116,"content":[{"text":"Kepemutayɨ keneneparewieka, mɨpaɨ nepɨtiwikweka,","poem":1},{"text":"'ahetsie kenemɨtitakwewie pepɨka'ikupatani.","poem":2}]},{"type":"verse","number":117,"content":[{"text":"Nehetsie kenenuaka, ne mɨpaɨ netiwikwetɨ,","poem":1},{"text":"yuheyemekɨ 'ana 'a'aitsikatsie yanepɨtikamieni.","poem":2}]},{"type":"verse","number":118,"content":[{"text":"'Ekɨ pepɨkawanaki'erie kemɨ'ane 'a'aitsika memuku'eiri,","poem":1},{"text":"'iyaritɨarika kwamanarika memuwewiekɨ xeikɨa.","poem":2}]},{"type":"verse","number":119,"content":[{"text":"Kwiepa memɨtama memɨkametsihetimaiwawe xatsi hepaɨ pekatiniwaxeiyani,","poem":1},{"text":"ne 'ayumieme 'a'aitsika nepɨnaki'erie.","poem":2}]},{"type":"verse","number":120,"content":[{"text":"Marikakɨ 'ahɨxie nepɨyɨyɨaka,","poem":1},{"text":"yaxeikɨata 'a'aitsika ne'ayemakatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":121,"content":[{"text":"Ne heitseriemekɨ yanekatinikamieni kehepaɨ 'aixɨa mɨ'ane,","poem":1},{"text":"pepɨkanetsi'eirieka memɨnetsi'aye'unie memɨnetsi'axekɨ.","poem":2}]},{"type":"verse","number":122,"content":[{"text":"'Ikɨ ti'a'uximayatsiriwame 'aixɨa mɨtikanikɨ yaketineuyuri,","poem":1},{"text":"memuyuti'ɨre mepɨkanetsi'uximatɨaka.","poem":2}]},{"type":"verse","number":123,"content":[{"text":"Nemetsitakwewietɨ pemɨnetsitawikweitsitɨanikɨ nepɨkaheuniere,","poem":1},{"text":"neta'ikwewatɨ pemeye'atɨanikɨ ke'aixɨa pemɨti'aitakɨ.","poem":2}]},{"type":"verse","number":124,"content":[{"text":"Ti'a'uximayatsiriwame hetsie yaketineuyuri waɨkawa kepemɨtiuyukanaki'eriekɨ,","poem":1},{"text":"'a'aitsika keneneuti'ɨkitɨa.","poem":2}]},{"type":"verse","number":125,"content":[{"text":"Ne ti'a'uximayatsiriwame nepɨhɨkɨ: nemɨreutamaiwenikɨ keneneupitɨa,","poem":1},{"text":"'ana 'a'aitsika nekanetimaimɨkɨ.","poem":2}]},{"type":"verse","number":126,"content":[{"text":"Yawé, 'ari tukari paye'a yapemɨtiyurienikɨ,","poem":1},{"text":"matsi 'a'aitsika nixewitɨ pɨka'aye'atɨa.","poem":2}]},{"type":"verse","number":127,"content":[{"text":"Nitixaɨtɨ 'ena kwiepa timieme nepɨkatinaki'erie, matsi 'a'aitsika xeikɨa nepɨnaki'erie,","poem":1},{"text":"huru kenemɨkatinaki'erie, huru 'aixɨa mɨ'itɨarie reuyeta.","poem":2}]},{"type":"verse","number":128,"content":[{"text":"'Ayumieme 'a'aitsikate nepuku'eriwa","poem":1},{"text":"peru kwamanarika nepɨtixani'erie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":129,"content":[{"text":"Naitɨ 'a'aitsikate pɨmamariwawe,","poem":1},{"text":"'ayumieme naime nepaye'atɨa.","poem":2}]},{"type":"verse","number":130,"content":[{"text":"Kepauka 'aniuki mukuxaxatsiwa mɨkɨ katanihekɨariwiyani,","poem":1},{"text":"meta 'atsimɨkatimate kaneitimaitɨyeikani.","poem":2}]},{"type":"verse","number":131,"content":[{"text":"Waɨkawa nehauharimɨtɨ nepikuwaune,","poem":1},{"text":"neteni nepanutayepiwa nehanatiwakitɨ,","poem":2},{"lineBreak":true},{"text":"yemekɨ nemeimaimɨkɨkɨ 'a'aitsika.","poem":2}]},{"type":"verse","number":132,"content":[{"text":"Kenenaye'eri, keneneutinenimayata","poem":1},{"text":"yaxeikɨa kepemɨtiwanenimaya memɨmetsinaki'erie.","poem":2}]},{"type":"verse","number":133,"content":[{"text":"Keneneuwitɨximeni kepemutayɨ 'aniukikɨ,","poem":1},{"text":"pepɨkanetsipitɨaka 'axamɨti'ane mɨnetikuyuitɨwanikɨ.","poem":2}]},{"type":"verse","number":134,"content":[{"text":"Keneneɨxɨna teɨteri kememɨnetenanaimakɨ,","poem":1},{"text":"karikɨ ne nepeye'atɨani 'a'aitsika.","poem":2}]},{"type":"verse","number":135,"content":[{"text":"Nehetsie pematsiɨkɨtɨ kene'ayeitɨa ke'aixɨa pemɨtiuka'iyari,","poem":1},{"text":"'a'aitsika keneneuti'ɨkitɨa.","poem":2}]},{"type":"verse","number":136,"content":[{"text":"Haa hepaɨ ne'ukai pɨtiuhapane,","poem":1},{"text":"'a'aitsika mɨka'aye'atɨariwakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":137,"content":[{"text":"'Ekɨ Yawé, heitseriemekɨ pepɨti'uximaya,","poem":1},{"text":"meta 'a'aitsikate pɨheitserietɨka.","poem":2}]},{"type":"verse","number":138,"content":[{"text":"'A'aitsikate 'aixɨa pɨ'anene kepemɨtiuta'aitaxɨ,","poem":1},{"text":"'aixɨa pɨ'ane hetsiena temɨtewiyanikɨ.","poem":2}]},{"type":"verse","number":139,"content":[{"text":"Ne'ɨtetsatɨ nepɨha'a,","poem":1},{"text":"memɨnetsi'aye'unie 'aniuki memɨka'eniekɨ.","poem":2}]},{"type":"verse","number":140,"content":[{"text":"Kepemutayɨ 'aniukikɨ puta'inɨatsie waɨkawa,","poem":1},{"text":"'ayumieme ne nepinaki'erie.","poem":2}]},{"type":"verse","number":141,"content":[{"text":"Tsepa ne nitixaɨtɨ nemɨkatihɨkɨ meta nemɨxani'eriwa,","poem":1},{"text":"peru ne 'a'aitsika nepɨkahatɨtɨmaiya.","poem":2}]},{"type":"verse","number":142,"content":[{"text":"Heitseriemekɨ kepemɨtiyuriene 'aixɨa peti'aitatɨ yuheyemekɨ,","poem":1},{"text":"'a'aitsika yuri kanaineni.","poem":2}]},{"type":"verse","number":143,"content":[{"text":"'Uximatɨarika meta hiwerika nepexeiya,","poem":1},{"text":"peru 'a'aitsika pɨnetsitemawieritɨa.","poem":2}]},{"type":"verse","number":144,"content":[{"text":"'A'aitsikate yuheyemekɨ heitseriemekɨ pɨtikuxata,","poem":1},{"text":"nereutamaiwetɨ nemuyeikanikɨ keneneupitɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":145,"content":[{"text":"Yemekɨ naime ne'iyarikɨ nekamenahɨaweni, Yawé,","poem":1},{"text":"keneneuta'eiya, 'ana 'a'aitsika nepaye'atɨani.","poem":2}]},{"type":"verse","number":146,"content":[{"text":"Nepɨmetsihahiwiwa: «Keneneutawikweitsitɨa».","poem":1},{"text":"'A'aitsikate nepaye'atɨani.","poem":2}]},{"type":"verse","number":147,"content":[{"text":"Ximeri paitɨ nepanukukeka nemetsitawawirienike parewiya,","poem":1},{"text":"ne 'aniukitsie nepaɨwaɨre neta'ikwewatɨ.","poem":2}]},{"type":"verse","number":148,"content":[{"text":"Tɨkarikɨ nepɨkatikukutsu,","poem":1},{"text":"'aniuki neku'eriwatɨ kepemutayɨ.","poem":2}]},{"type":"verse","number":149,"content":[{"text":"'Anaki'eriya mɨmariwekɨ neniuki keneu'eni,","poem":1},{"text":"Yawé, kepemɨti'aitakɨ tukari keneneupitɨa.","poem":2}]},{"type":"verse","number":150,"content":[{"text":"Memɨnetsi'aye'unie 'axamemɨte'u'iyari 'ahurawa mekaniu'uwaniri,","poem":1},{"text":"peru 'a'aitsika hepaɨtsita 'ateewa mekaniu'uwani.","poem":2}]},{"type":"verse","number":151,"content":[{"text":"Yawé, 'ekɨta 'ahurawa pekaniuyeikani,","poem":1},{"text":"meta naitɨ 'a'aitsikate kemutiyuane kaniyuritɨni.","poem":2}]},{"type":"verse","number":152,"content":[{"text":"Mɨixa nepuyurieri 'a'aitsika nematetɨ,","poem":1},{"text":"peminetɨa yuheyemekɨ mɨ'ayumiemetɨnikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":153,"content":[{"text":"Keneneuxeiya kenemɨtiuka'eniwa, keneneutawikweitsitɨa,","poem":1},{"text":"ne matsi 'a'aitsika kemaine nepɨkahatɨmaiyawe.","poem":2}]},{"type":"verse","number":154,"content":[{"text":"Nehetsie keneutanua, keneneutawikweitsitɨa,","poem":1},{"text":"kepemutayɨkɨ tukari kenenepitɨaka.","poem":2}]},{"type":"verse","number":155,"content":[{"text":"'Axateyuruwamete wahetsiemieme 'apeteewa wikweitsitɨarika,","poem":1},{"text":"mɨkɨ 'a'aitsika memɨkakuwautɨwekɨ.","poem":2}]},{"type":"verse","number":156,"content":[{"text":"Yawé, waɨkawamekɨ pepɨtiyukanenimaya,","poem":1},{"text":"tukari keneneupitɨa kepemɨti'aitakɨ.","poem":2}]},{"type":"verse","number":157,"content":[{"text":"Memɨnetsi'aye'unie mepɨyumɨire meta memɨnetsi'uweiya,","poem":1},{"text":"peru ne 'a'aitsikate nepɨka'uku'e'eiriwa.","poem":2}]},{"type":"verse","number":158,"content":[{"text":"Kepauka memɨteyukwamana nemɨwakuxexeiya nepekahayamɨkatɨyeika,","poem":1},{"text":"'aniuki memɨkahaye'atɨakɨ.","poem":2}]},{"type":"verse","number":159,"content":[{"text":"Yawé, neuxei keneneuxeiya 'a'aitsikate waɨkawa kenemɨtinaki'erie,","poem":1},{"text":"waɨkawa kepemɨtiyukanaki'eriekɨ, tukari keneneupitɨa.","poem":2}]},{"type":"verse","number":160,"content":[{"text":"Naitɨ 'aniuki heitseriemekɨ yurikɨ pɨtikuxata xeikɨa,","poem":1},{"text":"kepemɨti'aita yuheyemekɨ kani'ayumiemetɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":161,"content":[{"text":"Yakɨ xeikɨa mepɨnetsi'uweiya teɨteri memamariwawetɨ,","poem":1},{"text":"matsi 'aniuki xeikɨa nepayemakaxe.","poem":2}]},{"type":"verse","number":162,"content":[{"text":"Ne nepɨnetemawie 'aniukikɨ kepemutayɨ,","poem":1},{"text":"tewi waɨkawa mɨtiukaxei kemɨtiyutemawie hepaɨ.","poem":2}]},{"type":"verse","number":163,"content":[{"text":"Yemekɨ nepixani'erie naime 'itarika,","poem":1},{"text":"matsi waɨkawa 'a'aitsika nepɨnaki'erie.","poem":2}]},{"type":"verse","number":164,"content":[{"text":"Xeitukaritsie 'atahutamexɨa nepɨmetsinɨawani,","poem":1},{"text":"ke'aixɨa pemɨti'aitakɨ.","poem":2}]},{"type":"verse","number":165,"content":[{"text":"Kemɨ'ane 'a'aitsika memɨnaki'erie yemekɨ 'aixɨa 'iyari mekaniu'uwani,","poem":1},{"text":"nitixaɨtɨtsie mepɨkatehekaxɨrɨwe.","poem":2}]},{"type":"verse","number":166,"content":[{"text":"Yawé, ne 'awikweitsitɨarika nepɨtakwewie","poem":1},{"text":"meta yanepɨtiyuriene 'a'aitsikate kemaine.","poem":2}]},{"type":"verse","number":167,"content":[{"text":"Naime ne'iyarikɨ 'a'aitsikate nepaye'atɨa.","poem":1},{"text":"Waɨkawa nepeinaki'erie.","poem":2}]},{"type":"verse","number":168,"content":[{"text":"'A'aitsikate nepeu'enie,","poem":1},{"text":"'ekɨ naime nehuye pemɨmatekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":169,"content":[{"text":"Nehiwerika hiwariyari pekehe'enieni,","poem":1},{"text":"Yawé, nereutamaiweme kenenayeitɨa, 'aniuki kemainekɨ.","poem":2}]},{"type":"verse","number":170,"content":[{"text":"Waɨkawa kenemɨmetiwawirie pekenetsihe'enieni,","poem":1},{"text":"keneneuxɨna, kepemutayɨkɨ.","poem":2}]},{"type":"verse","number":171,"content":[{"text":"Ne nemetsinɨawatɨ nepɨkatihayewani,","poem":1},{"text":"'ekɨtsɨ 'a'aitsikate pekaneni'ɨkitɨaka.","poem":2}]},{"type":"verse","number":172,"content":[{"text":"'Aniuki 'aixɨa manɨyɨne nepitakwika,","poem":1},{"text":"naitɨ 'a'aitsikate heitseriemekɨ mɨtikuxatakɨ.","poem":2}]},{"type":"verse","number":173,"content":[{"text":"'Atɨrɨkariyakɨ keneneuparewi,","poem":1},{"text":"ne 'a'aitsikate nemanayexeikɨ.","poem":2}]},{"type":"verse","number":174,"content":[{"text":"Yawé, ne 'awikweitsitɨarika yemekɨ nepeuyehɨwa.","poem":1},{"text":"'A'aitsikate pɨnetemawierika.","poem":2}]},{"type":"verse","number":175,"content":[{"text":"Tukari 'akuxi keneneupitɨa nemetsinɨawatɨ 'anemuyeikanikɨ,","poem":1},{"text":"kepemɨti'aita kenetsi'uparewieni.","poem":2}]},{"type":"verse","number":176,"content":[{"text":"Muxa meuyewe hepaɨ nekaniuyɨni,","poem":1},{"text":"kenaye'a ti'a'uximayatsiriwame kenawaumie,","poem":2},{"lineBreak":true},{"text":"'a'aitsikate nemɨkahatɨmaiyawekɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/120.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":176}