{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":12,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Kanari 'atahaikatɨ mawɨkɨ ke'utakwikarieni. Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Yawé ketaneutawikweitsitɨa, teɨteri 'aixɨa memɨtekahu mepumaweri,","poem":1},{"text":"mepumaweri 'ena kwiepa teɨteri heitseriemekɨ memu'uwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Meteyu'itaiyatɨwetɨ xeikɨa 'amekaniu'uwani yunaitɨ,","poem":1},{"text":"'aixɨa mete'uxaxatatɨtɨ kwitɨwata 'axamekaniutiyuaneni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yawé, 'ekɨ mɨkɨ teɨteri pepɨwareuyehɨani","poem":1},{"text":"memɨte'itawa meta memɨteyukananaima,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"mɨpaɨ memutiyuane: «Taniukikɨ tekatenayu'iwakuni,","poem":1},{"text":"tanenikɨ xeikɨa tekaneuta'ɨka.","poem":2},{"lineBreak":true},{"text":"Nixewitɨ tame pɨkatatsikema».","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yawé mɨpaɨ kanaineni: «Hikɨ nekananukukemɨkɨ,","poem":1},{"text":"memɨ'uximatɨarie nekaniwatawikweitsitɨamɨkɨ,","poem":2},{"text":"tixaɨtɨ mɨkarexeiya mɨnanaimariekɨ,","poem":1},{"text":"mɨreuyehɨwa mɨtiuka'eniwakɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yawé niukieya kani'itiyaka,","poem":1},{"text":"pɨrata 'aixɨa mɨ'itɨarie hepaɨ pɨ'ane,","poem":2},{"lineBreak":true},{"text":"tepɨa 'aixɨa mɨwati'itɨariwatsie 'atahutamexɨa kanikwaxiyarieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yawé, 'ekɨ pepɨtatsi'ɨwiyani","poem":1},{"text":"'ekɨ yuheyemekɨ tahetsie pepɨnuaka 'ikɨ teɨteri mɨyamemɨtatsiyuriekɨ,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"tsepa 'axamemɨte'u'iyari kwiepa meyuwaɨkatɨ memɨxuawe,","poem":1},{"text":"tsepa 'axamɨti'ane waɨkawa mɨtitamɨirirɨme.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}