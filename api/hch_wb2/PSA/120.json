{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":120,"content":[{"type":"hebrew_subtitle","content":["Ku'uwamete wakwikari."]},{"type":"verse","number":1,"content":[{"text":"Kepauka nemɨtiuka'eniwa Yawé nepahɨawe,","poem":1},{"text":"mɨkɨta pɨnetsiku'eiya.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yawé, keneneutawikweitsitɨa memɨte'itawa menetsi'uweiyakaku","poem":1},{"text":"meta 'iya kwinimieme memɨteheuta'itawawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Xeme xemɨte'itawa,","poem":1},{"text":"Kakaɨyari 'uxa'atɨni","poem":2},{"lineBreak":true},{"text":"waɨkawa xehetsie pɨrahɨani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kuyaxi wa'ɨrɨ kwinimieme mɨranuyemɨtsɨkɨ,","poem":1},{"text":"tɨɨ waɨkawa tatɨkaimekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Xɨa'ui ne, 'ateewa nemuyeika Metseki kwieyaritsie,","poem":1},{"text":"'ena nemuka Tseraxi 'ixuriki kiiyari mati'u.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mɨixari 'ena nepuka","poem":1},{"text":"kayuwatɨ memu'uwani mɨkawanake wahetsɨa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne kaneninakeni kayuwatɨ heitseriemekɨ nemuyeikanikɨ,","poem":1},{"text":"peru xɨka kayuwatɨ kehepaɨ temɨte'u'uwanikɨ netikuxatani,","poem":2},{"lineBreak":true},{"text":"mɨkɨta kuyaxa pɨta mepukuxatani.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}