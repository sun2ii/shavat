text":"meta yaxeikɨa metsa yɨwikɨta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yawé 'ahetsie kaninuakamɨkɨ,","poem":1},{"text":"'atukari kani'ɨwiyakamɨkɨ naime 'axamɨti'ane hepaɨtsita.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yawé 'akie pɨmetsi'ɨwiyani meta 'ahuyeta,","poem":1},{"text":"hikɨtɨtɨ meta yuheyemekɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}