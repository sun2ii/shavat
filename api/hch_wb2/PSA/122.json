{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["Ku'uwamete wakwikari. Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Ne nepuyukatemawiwa kepauka mɨpaɨ nemɨrahɨawarɨwa:","poem":1},{"text":"«Hikɨmɨ Yawé tukieyata tepuhu».","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kerutsareme, 'ari tekaniu'axɨani","poem":1},{"text":"'ena 'akitenie tekaniuti'uka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kerutsareme, kiekari 'aixɨa 'anemekɨ mɨwewiya","poem":1},{"text":"mana yunaitɨ memuyukuxexeɨriwanikɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mana nuiwarite mekani'axeni,","poem":1},{"text":"nuiwarite Yawé hetsɨa miemete,","poem":2},{"text":"Yawé 'aixɨa metetahɨaweke 'aixɨa kemɨtiuka'iyari wahetsiemieme,","poem":1},{"text":"kehepaɨ 'aneme 'Ixaheri 'aitsika mɨyetuiriyariekai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mana kanihɨkɨtɨni 'aixɨa mɨtikɨyɨne 'ixaheritsixi wahetsiemieme,","poem":1},{"text":"Rawiri nuiwarimama waparatsiyu mana kaniuweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kerutsareme hetsiemieme tepuyunenewieka kayuwatɨ mexeiyanikɨ:","poem":1},{"text":"«'Aixɨa 'anemekɨ memu'uwanikɨ kemɨ'ane memɨmetsinaki'erie.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kerutsareme kuraruyarita memɨye'uwa kayuwatɨ mekehexeiyani,","poem":1},{"text":"meta 'aparatsiyuta 'aixɨa me'itɨarietɨ».","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hikɨta, ne'iwama meta nehamikuma wahetsiemieme mɨpaɨ nepaine:","poem":1},{"text":"«'Aixɨa 'anemekɨ meke'u'uwani».","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kerutsareme, 'ahetsɨa muwekɨ Yawé takakaɨyari tukieya","poem":1},{"text":"nepɨtikuwauni 'aixɨa mɨti'ane 'ahetsiemieme.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}