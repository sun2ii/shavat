{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":123,"content":[{"type":"hebrew_subtitle","content":["Ku'uwamete wakwikari."]},{"type":"verse","number":1,"content":[{"text":"Ne 'ahetsɨa xeikɨa nepautiniere,","poem":1},{"text":"muyuawitsie 'a'uweni 'apuwe, mana xeikɨa nepeuti'ikwewa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Waɨriyarika te'uximayatamete kememɨteta'ikwewa","poem":1},{"text":"yukutsiyari niukieyakɨ yumamakɨ warahɨawekaku,","poem":2},{"text":"meta 'ukaratsi waɨriyarika ti'uximayatame kemɨtita'ikwewa,","poem":1},{"text":"mɨti'uximayatsirie 'ɨyaya niukieya yumamakɨ hehɨawekaku,","poem":2},{"text":"mɨpaɨta tame tepɨteta'ikwewa Yawé takakaɨyari hetsie,","poem":1},{"text":"kepaukake mɨkɨ mɨtatsitinenimayata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yawé ketaneutinenimayata, ketaneutinenimayata,","poem":1},{"text":"'ari tepu'u'uxe ketemɨtenanaimarie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mɨixari tepɨte'uka'eniwa teyuriyarietɨ,"