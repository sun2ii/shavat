{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":124,"content":[{"type":"hebrew_subtitle","content":["Ku'uwamete wakwikari. Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"'Ayumieme hikɨ 'ixaheritsixi yaxeikɨa xekeneutiyuaneni:","poem":1},{"text":"—Xɨka Yawé tahetsie ka'utanuanike,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"keteyɨakake xɨka Yawé tahetsie ka'utanuanike","poem":1},{"text":"kepauka yunaitɨ kwiepa memɨtama metatsi'aye'unietɨ memakɨtsie,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"teyunaime te'ayeneniereme mepɨtatsi'anukaxɨxɨanikekai","poem":1},{"text":"kepauka memuyeha'atsie tahepaɨtsita,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"haa tahetsie muwayeneni hepaɨ tepɨyɨnikekai,","poem":1},{"text":"temehauxɨani hepaɨ tepɨyɨnikekai,","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"haa mɨtɨrɨkaɨye hepaɨ teyunaime mepɨtatsiheuyehɨanikekai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yawé hepaɨtsita 'aixɨa keraniuwani, mɨkɨ mɨkawarupitɨakɨ","poem":1},{"text":"yutametekɨ memɨtatsititsanakɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wikixi wahepaɨ, tekateniyutawikweitsitɨani,","poem":1},{"text":"tixɨ'erɨwame winiyarieyatsie,","poem":2},{"text":"winiyari kaniutatsane,","poem":1},{"text":"hikɨ tame takaniuyuta'una.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yawé tatsiparewiwame kanihɨkɨtɨni,","poem":1},{"text":"muyuawi mutawewi meta kwie.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}