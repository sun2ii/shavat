{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":126,"content":[{"type":"hebrew_subtitle","content":["Ku'uwamete wakwikari."]},{"type":"verse","number":1,"content":[{"text":"Kepauka Yawé, memehapaniekai mɨwarupitɨa, Tsiyuni memɨ'axɨanikɨ,","poem":1},{"text":"temɨteheinɨka hepaɨ tepɨtenenierekai.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Ana temawierika tehexeiyatɨ tepakɨ,","poem":1},{"text":"meta tepɨkatehayewakai te'utikwitɨ.","poem":2},{"text":"Hipatɨ nuiwarite mɨpaɨ mekaniutiyuanekaitɨni:","poem":1},{"text":"«Yawé mariwemekɨ wahetsiemieme pɨtiyuriene».","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Huu, Yawé tahetsiemieme mariwemekɨ pɨtiyuriene,","poem":1},{"text":"hikɨ mɨkɨkɨ waɨkawa tepuyutemamawie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yawé, hikɨ keniwa'atɨa ta'iwama memehapanie","poem":1},{"text":"haa 'akitsie kepemɨtiwayenenetɨwa makuwakitsie hepaɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kemɨ'ane yu'ukaikɨ memuka'etsa,","poem":1},{"text":"temawierikakɨ mepɨka'itsana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kemɨ'ane 'utatsuatɨ 'imɨari mɨ'iwiene,","poem":1},{"text":"yutemawietɨ pɨka'itsana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}