{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":127,"content":[{"type":"hebrew_subtitle","content":["Ku'uwamete wakwikari. Tsarumuni nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Xɨka Yawé kii ka'utawewieni,","poem":1},{"text":"yakɨ xeikɨa 'iwewiwamete mekateniyu'uxitɨaka.","poem":2},{"text":"Xɨka Yawé xeime kiekari ka'ɨwiyani,","poem":1},{"text":"tɨkarikɨ tehɨwemete yakɨ xeikɨa mekaniyɨaka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yakɨ xeikɨa ximeri paitɨ xekananuku'uweni,","poem":1},{"text":"meta yakɨ xeikɨa 'arike xekaniukahipiteni,","poem":2},{"text":"meta yakɨ xeikɨa kwinimieme xekateni'uximayaka 'ikwai xemɨte'ukaxexeiyanikɨ.","poem":1},{"text":"Karikɨ Kakaɨyari kutsi kaniwapitɨaka pɨta kemɨ'ane mɨwanaki'erie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tɨɨri 'imikieri mekanihɨkɨtɨni Yawé hetsɨa miemete,","poem":1},{"text":"tɨɨri tahetsie memɨyekɨka ta'iwarika witsimɨ'ane mekanihɨkɨtɨni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kepauka temaikɨ tɨɨri mɨwarayexeiya","poem":1},{"text":"yumemiwame 'ɨrɨ kemɨra'ɨ hepaɨ kani'aneni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Aixɨa xepɨ'itɨarie kemɨ'ane 'ɨrɨ 'uitɨwameta xemihɨniya","poem":1},{"text":"mɨkɨ 'ɨrɨ 'aixɨa mɨ'anenekɨ.","poem":2},{"text":"Mɨkɨkɨ hatsuaku mepɨkatewiyatsitɨarieni memɨwaraye'unie wahɨxie","poem":1},{"text":"kepauka memɨtaxanetsieni yemekɨ 'itsɨkate wahɨxie.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}