{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":129,"content":[{"type":"hebrew_subtitle","content":["Ku'uwamete wakwikari."]},{"type":"verse","number":1,"content":[{"text":"Hikɨta 'ixaheritsixi mɨpaɨ meke'utiyuani:","poem":1},{"text":"—Yumɨiretɨ mepɨnetsi'uhiweritɨa temaikɨyaritsie paitɨtɨ,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"yumɨiretɨ mepɨnetsi'uhiweritɨa temaikɨyaritsie paitɨtɨ,","poem":1},{"text":"peru yemekɨ mepɨkanetsiha'iwawe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Newaritsie hararu mepukahatɨkɨ,","poem":1},{"text":"xuruku meputiwewi heukatetewame.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Peru Yawé, heitseriemekɨ yamɨtikamie,","poem":1},{"text":"kaneniuxɨna 'axateyuruwamete menetsihɨakaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mekeha'iwarieni meke'utewiyatsitɨarieni","poem":1},{"text":"yunaitɨ kemɨ'ane Kerutsareme memaye'unie.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tupiriya kii heima mieme hepaɨ meke'ɨyɨni,","poem":1},{"text":"kataweriwetɨ mɨtiwauke,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"tixitekeme tixaɨtɨ pɨkati'axe","poem":1},{"text":"meta 'ihuruwame tixaɨtɨ pɨkati'axe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wa'aurie memuyekɨka xewitɨ tɨma mɨpaɨ pɨkatiwarahɨaweni:","poem":1},{"text":"«Yawé xeme 'aixɨa kexeyurieka,","poem":2},{"lineBreak":true},{"text":"Yawé tepɨwawirie 'aixɨa mɨxeyuriekakɨ».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}