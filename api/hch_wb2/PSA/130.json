{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["Ku'uwamete wakwikari."]},{"type":"verse","number":1,"content":[{"text":"Yawé, ne yemekɨ 'ekɨ karima nepɨmetsihahɨawe","poem":1},{"text":"waɨkawa netiuka'eniwatɨ kwie 'ameukatewatsie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ti'aitame, neniuki keneu'eni.","poem":1},{"text":"Yemekɨ heitseriemekɨ keneneu'eni waɨkawamekɨ kenemetiwawirie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"'Ekɨ Yawé, xɨka naime ke'axatemɨte'uyurikɨ pekatatsixeiriekake,","poem":1},{"text":"Yawé, ¿kamɨtsɨ kemɨ'ane hetsie pɨkatiuhɨiyawe?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Peru 'ekɨ pepɨtareuyehɨwiriwa,","poem":1},{"text":"'ayumieme peuyewetse temɨmetsi'ayemakaxenikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ne Yawé nepɨtakwewie, ne'iyarikɨ naimekɨ nekanitakwewieka,","poem":1},{"text":"niukieya kemaine mɨpaɨ nepɨtita'ikwewa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne'iyarikɨ naimekɨ Yawé nepɨtakwewie,","poem":1},{"text":"matsi waɨkawa tehɨwemete kememɨkateta'ikwewa ximeri mayanikɨ.","poem":2},{"lineBreak":true},{"text":"Tehɨwemete ximeri kememɨtetakwewie hepaɨ,","poem":1}]},{"type":"verse","number":7,"content":[{"text":"xemeta mɨpaɨ, 'ixaheritsixi, Yawé xeketenetakwewieka.","poem":2},{"text":"Hetsiena waɨkawa naki'eriya muxuawekɨ,","poem":1},{"text":"meta mɨkɨ yurikɨ tatsixɨname mɨhɨkɨkɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mɨkɨ 'ixaheritsixi kaniwaxɨnamɨkɨ","poem":1},{"text":"naime ke'axamemɨte'uyuri hepaɨtsita.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}