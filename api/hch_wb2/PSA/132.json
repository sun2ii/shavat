{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":132,"content":[{"type":"hebrew_subtitle","content":["Ku'uwamete wakwikari."]},{"type":"verse","number":1,"content":[{"text":"Yawé, Rawiri kena'eriwani","poem":1},{"text":"meta kemɨtiuka'eniwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kena'eriwani kemɨtiuyuhɨritɨa Yawé hetsɨa,","poem":1},{"text":"Kakuwu hetsie Mɨtɨrɨkaɨye kemɨtiutahɨawixɨ:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"«Ne nekie nepɨkatayerɨni,","poem":1},{"text":"meta 'etsiwatɨma ne'utatsie nepɨkaka'uxipieni,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"meta nepɨkaheukuni,","poem":1},{"text":"'etsiwatɨma nepɨka'anukɨpe,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"xɨka neka'itaxeiyaweni 'akuxi Yawé hakewa","poem":1},{"text":"tukieya nemetawewieni Mɨtɨrɨkaɨye Kakuwu meyexeiya».","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"'Epɨrata tɨratu kakuniyari teputamari,","poem":1},{"text":"hikɨ tepeitaxei Yakaxi kwieyaritsie:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"«Hikɨmɨ tekanihuni tukitana paitɨ,","poem":1},{"text":"hɨxiena tepekatunuma'uni».","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yawé, kenanukukexi 'atukita kenenua pemuwaka'uxipienitsie,","poem":1},{"text":"'ekɨ meta 'atɨratu kakuniyari mɨtɨrɨkaɨye.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mawari wewiwamete 'aixɨa meke'uyukuyurieni kemɨreuyewetse.","poem":1},{"text":"'Ahetsie memɨtewiya mekemetsinɨawani meyutemamawietɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Rawiri ti'a'uximayatsiriwame pemɨnaki'eriekɨ,","poem":1},{"text":"pepɨka'iku'e'eiriwani pemenayexei.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yawé Rawiri mɨpaɨ katiniuhɨritɨani","poem":1},{"text":"mɨkɨ yapɨtikayani pɨka'ipata:","poem":2},{"text":"«Xeime 'anuiwaritɨme","poem":1},{"text":"'a'uwenitsie nekanayemɨkɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xɨka 'aniwema netɨratu mehaye'atɨani","poem":1},{"text":"meta ne'aitsikate nemɨwata'ɨkitɨani,","poem":2},{"text":"hikɨ mɨkɨ waniwema","poem":1},{"text":"'a'uwenitsie mepayaxe yuheyemekɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yawé, Kerutsareme panayexei,","poem":1},{"text":"mana yukie mayeitɨanikɨ pinakixɨ, mɨpaɨ putayɨ:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"«'Ena netuki nepɨtakeni yuheyemekɨ,","poem":1},{"text":"'ena ne'ukaitɨ nepɨtita'aita, mɨpaɨ mɨnetinakekɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Aixɨa nepɨtiyurieka 'ikwai 'ikɨ kiekaritsie timieme,","poem":1},{"text":"meta tixaɨtɨ memɨkatehexeiya 'ikwai nepɨwamikwani.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mawari wewiwamete wikweitsitɨarikakɨ nekaniwatikemaritɨamɨkɨ,","poem":1},{"text":"meta hetsiena memɨtewiya mekanitanɨawakuni meyutemamawietɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"»Hikɨ tawarita Rawiri tɨrɨkariya nepɨpitɨani,","poem":1},{"text":"meta nemenayexei kɨxemeya nepɨtaiya.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Memeye'unie tewiyarika nepɨwapitɨani,","poem":1},{"text":"peru mɨkɨ matsi kurunaya mariwetɨ payani 'utimerɨkatɨ».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}