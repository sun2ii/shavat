{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":135,"content":[{"type":"verse","number":1,"content":[{"text":"Yawé kenɨawarieka.","poem":1},{"lineBreak":true},{"text":"Yawé xekenenɨawani.","poem":1},{"text":"Yawé te'uximayatsiriwamete, xekenenɨawani.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Xeme Yawé tukita yaxemɨteye'uwa,","poem":1},{"text":"meta takakaɨyari tukieya takwayaritsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yawé xekenenɨawani, karikɨ mɨkɨ 'aixɨa katiniuka'iyarini,","poem":1},{"text":"nɨawari hetsiena mieme xekeneutikwikani, mɨpaɨ katininakeni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yawé Kakuwu panayexei yuhetsiemieme mayeitɨanikɨ,","poem":1},{"text":"'ixaheritsixi teɨterimama memakɨnekɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne mɨpaɨ nepɨtimate Yawé, tati'aitɨwame,","poem":1},{"text":"matsi pumariwe keyuri hipatɨ kakaɨyarixi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yawé naime yapɨtiyuriene kemɨtinake,","poem":1},{"text":"taheima muyuawitsie meta 'ena kwiepa,","poem":2},{"lineBreak":true},{"text":"haramaratsie meta naitsarie meukatetewatsie.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kwie manu'axetsie paitɨ haiwitɨri panuku'enitsitɨwa,","poem":1},{"text":"mimierikari peyenɨ'awa wiyeritsata","poem":2},{"lineBreak":true},{"text":"metatsiere 'eka pewatiyepiwa muye'ɨnetsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"'Ekipitutari waniwema mexɨakate kaniwarukwini,","poem":1},{"text":"teɨteri waniwema meta tewaxi waniwema.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Ekipitu kwieyaritsie,","poem":1},{"text":"Kakaɨyari 'inɨari mamariwaweme kanenɨ'ani","poem":2},{"lineBreak":true},{"text":"Parahuni hetsie meta yunaime te'i'uximayatsiriwamete wahetsie.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yumɨireme nuiwarite kaniwarukwini,","poem":1},{"text":"te'aitamete metɨrɨkawime kaniwarukwini.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tsikuni, 'amuxeutsixi tiwa'aitɨwame,","poem":1},{"text":"ti'aitame 'Uhuki Watsani kwieyaritsie,","poem":2},{"lineBreak":true},{"text":"meta yunaime te'aitamete Kanani memɨtamakai.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mɨkɨ wakwie kaniyetuani,","poem":1},{"text":"'ixaheritsixi wakwie mayanikɨ yuheyemekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yawé, 'ekɨ yuheyemekɨ 'apekaniuyeikani,","poem":1},{"text":"'aheyemekɨ 'aheyemekɨ 'apepuweni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yurikɨ Yawé yuteɨterima wahetsie kanitanuamɨkɨ,","poem":1},{"text":"meta te'i'uximayatsiriwamete kaniwatinenimayatamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Nuiwarite wakakaɨyarixima huru pɨrata mekanihɨkɨtɨni,","poem":1},{"text":"tewi wewiyaya mepɨhɨkɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Meputeni, peru mepɨkaniuwawe,","poem":1},{"text":"mepɨhɨxi, peru mepɨkaheuneniere,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"mepunaka, peru mepɨkaheu'enana,","poem":1},{"text":"nitɨma 'eka mepɨkahexeiya yuteta.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kemɨ'ane memɨwatiwewiwa, mɨkɨ wahepaɨ mepɨ'anene,","poem":1},{"text":"meta yunaitɨ kemɨ'ane wahetsie yuri memɨte'erie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"'Ixaheritsixi, Yawé hetsie 'aixɨa xekenaitɨkani,","poem":1},{"text":"'Aruni xiɨyarimama, Yawé hetsie 'aixɨa xekenaitɨkani,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Rewi nuiwarimama, Yawé hetsie 'aixɨa xekenaitɨkani,","poem":1},{"text":"kemɨ'ane xemeyemakaxe, Yawé hetsie 'aixɨa xekenaitɨkani.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Tsiyuni paitɨ Yawé 'aixɨa xeketenahɨaweni,","poem":1},{"text":"Kerutsaremetsie mɨkie.","poem":2},{"lineBreak":true},{"text":"Yawé kenɨawarieka.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}