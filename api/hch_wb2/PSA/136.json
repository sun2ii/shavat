{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":136,"content":[{"type":"verse","number":1,"content":[{"text":"Yawé pamɨpariyutsi xekenepitɨaka, karikɨ mɨkɨ 'aixɨa katiniuka'iyarini,","poem":1},"mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ."]},{"type":"verse","number":2,"content":[{"text":"Pamɨpariyutsi xekenepitɨaka Kakaɨyari mumariwe kakaɨyarixi kememɨka'anene,","poem":1},"mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ."]},{"type":"verse","number":3,"content":[{"text":"Pamɨpariyutsi xekenepitɨaka te'aitamete Tiwa'aitɨwame,","poem":1},"mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ."]},{"type":"verse","number":4,"content":[{"text":"Mɨkɨ xeikɨa mariweme mɨtiwewiwe,","poem":1},"mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ."]},{"type":"verse","number":5,"content":[{"text":"Timaiwetɨ muyuawi mutawewi,","poem":1},"mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ."]},{"type":"verse","number":6,"content":[{"text":"Kemɨ'ane kwie mutaweraxɨ haramara hetsie,","poem":1},"mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ."]},{"type":"verse","number":7,"content":[{"text":"Kemɨ'ane muyuawitsie memeukatei muwarunetɨa memɨhekɨariwie,","poem":1},"mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ."]},{"type":"verse","number":8,"content":[{"text":"Tau munetɨa mɨhekɨariwiekakɨ tukarikɨ,","poem":1},"mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ."]},{"type":"verse","number":9,"content":[{"text":"Metsa meta xurawetsixi, tɨkarikɨ memɨhekɨariwiekakɨ,","poem":1},"mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ."]},{"type":"verse","number":10,"content":[{"text":"Kemɨ'ane 'ekipitutari waniwema mexɨakate mɨwarukwi,","poem":1},"mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ."]},{"type":"verse","number":11,"content":[{"text":"'Ixaheritsixi 'Ekipitu muwarayewitɨ,","poem":1},"mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ."]},{"type":"verse","number":12,"content":[{"text":"Yumamá mɨtɨrɨkaɨye tatseratɨ,","poem":1},"mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ."]},{"type":"verse","number":13,"content":[{"text":"Kemɨ'ane Haramara Mɨxeta manutayepi,","poem":1},"mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ."]},{"type":"verse","number":14,"content":[{"text":"Hixɨapa muwaruwitɨtɨya 'ixaheritsixi,","poem":1},"mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ."]},{"type":"verse","number":15,"content":[{"text":"Parahuni meta kuyaximama Haramara Mɨxeta hetsie mɨwarukayunitɨa,","poem":1},"mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ."]},{"type":"verse","number":16,"content":[{"text":"Kemɨ'ane makumawetsie yuteɨterima muwaruyewitɨtɨya,","poem":1},"mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ."]},{"type":"verse","number":17,"content":[{"text":"Memamariwaweme te'aitamete mɨwaruka'unaxɨ,","poem":1},"mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ."]},{"type":"verse","number":18,"content":[{"text":"Te'aitamete memɨte'ayu'iwa mɨwarukwi,","poem":1},"mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ."]},{"type":"verse","number":19,"content":[{"text":"Tsikuni, 'amuxeutsixi tiwa'aitɨwame mumi,","poem":1},"mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ."]},{"type":"verse","number":20,"content":[{"text":"Ti'aitame 'Uhuki Watsani kiekame mumi,","poem":1},"mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ."]},{"type":"verse","number":21,"content":[{"text":"Mɨkɨ wakwie yuteɨterima kaniwayetuirieni,","poem":1},"mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ."]},{"type":"verse","number":22,"content":[{"text":"Mɨkɨ 'ixaheritsixi te'i'uximayatsiriwamete mɨtiwarutapitɨa,","poem":1},"mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ."]},{"type":"verse","number":23,"content":[{"text":"Hatsuaku mɨkatatsihatɨtɨmaiya, tsepa haweri temu'itɨarie,","poem":1},"mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ."]},{"type":"verse","number":24,"content":[{"text":"Memɨtatsi'aye'unie wahetsɨa mɨtatsiwikweitsitɨa,","poem":1},"mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ."]},{"type":"verse","number":25,"content":[{"text":"Yunaime memɨte'ayeneniere mɨtiwamikwa,","poem":1},"mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ."]},{"type":"verse","number":26,"content":[{"text":"Kakaɨyari muyuawitsie makawe pamɨpariyutsi xekenepitɨaka.","poem":1},"Mɨkɨ hatsuaku pɨkatatsihayewa tatsinaki'erietɨ."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}