{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"Wawiruniya hatetsitayaritsie tepetiyaxikekai,","poem":1},{"text":"'ana Kerutsareme teha'eriwatɨ tepetitsuanakai.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mɨkɨ Kiekaritsie hapuri kɨyeyari meti'utsie","poem":1},{"text":"mana takanarite tepeɨkɨwɨwɨtɨwakai.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mana kiekatari memɨtatsi'upɨretsutaxɨ,","poem":1},{"text":"mepɨtatsihe'aitɨakai kwikari temetikwikakɨ,","poem":2},{"text":"tate'uximayatsitɨwamete xekeneyutemamawieka mepɨtatehekɨhɨawekai,","poem":1},{"text":"mɨpaɨ mepɨtatehetihɨawekai: «Xekeneutakwika tahetsiemieme xeime kwikari Kerutsareme mieme».","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tame tepɨkayɨwawe kwikari Yawé hetsiemieme","poem":1},{"text":"temutikwikani xeime kwieyaritsie paitɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kerutsareme, Kerutsareme,","poem":1},{"text":"xɨka ne 'uxa'atɨni nemetsihatɨmaiyake,","poem":2},{"lineBreak":true},{"text":"nemamá netserie mieme ke'utawani.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xɨka nekametsiha'eriwatɨ nehayani,","poem":1},{"text":"netemawierikakɨ xɨka nemetsihatɨmaiya,","poem":2},{"lineBreak":true},{"text":"neneni ke'anatixitekieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yawé, 'erumitsixi keniwara'eriwani,","poem":1},{"text":"kepauka Kerutsareme muka'unixɨ.","poem":2},{"text":"Mɨpaɨ mepɨte'uhiwakai: «Naime, naime","poem":1},{"text":"xekeneuka'una tsutɨmeyari 'ɨarime».","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"'Ekɨta Wawiruniya niweya, 'uxa'atɨni pekanika'unariemɨkɨ,","poem":1},{"text":"'aixɨa ke'itɨarieka kemɨ'aneta 'ekɨ","poem":2},{"lineBreak":true},{"text":"mɨmetsika'una kepemɨtatsi'uyuri tame.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Aixɨa ke'itɨarieka kemɨ'ane tɨɨri muwatiwiya","poem":1},{"text":"meta 'aitsie muwatitetsewani.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}