{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":138,"content":[{"type":"hebrew_subtitle","content":["Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Yawé, ne ne'iyarikɨ nepɨmetsinɨawani,","poem":1},{"text":"meta nepɨkwikani nɨawari 'ahetsiemieme kakaɨyarixi wahɨxie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Atuki mɨwayepatsie hepa neheutanieretɨ nepɨkatunumakeni,","poem":1},{"text":"'anaki'eriya mɨmariwekɨ meta 'aixɨa pemɨtikamiekɨ nepɨmetsitanɨawa.","poem":2},{"text":"Naime pemɨtiutawewitsie matsiɨkɨme pemayeitɨakɨ","poem":1},{"text":"kepemɨtimariwe meta 'aniuki pemaye'atɨakɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pepɨnetsi'uta'ei kepauka nemɨmetsihahɨawekai,","poem":1},{"text":"tawarita pepɨnetsi'utɨrɨkariyaxɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Neuxei Yawé, yunaitɨ te'aitamete kwiepa memɨtama","poem":1},{"text":"'aniuki me'enieme mepɨmetsitanɨawa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Temawierika mepexeiyani me'utikwitɨ 'ahuye memarietɨ,","poem":1},{"text":"Yawé, 'atɨrɨkariya mɨmariwekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yawé muyuawitsie kaniuyeikani,","poem":1},{"text":"meta puwaxeiya tixaɨtɨ memɨkateyu'erie,","poem":2},{"lineBreak":true},{"text":"'iyata memɨyuti'ɨre 'ateewa kaniwaxeiyani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tsepanetɨ ne waɨkawa 'uximatɨarikatsie nemuyetɨa,","poem":1},{"text":"'ekɨ tukari pepɨnetsipitɨani,","poem":2},{"text":"memɨnetsi'aye'unie memɨha'atsie 'amamá pepeutatsera,","poem":1},{"text":"'atɨrɨkariyakɨ pepɨnetsitawikweitsitɨani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yawé pɨraye'atɨani kemɨti'erieni nehetsiemieme.","poem":1},{"lineBreak":true},{"text":"Yawé, 'anaki'eriya mɨmariwe pɨkayupata yuheyemekɨ,","poem":1},{"text":"'ekɨ pepɨnetsi'utawewi pepɨkanetsi'uku'e'eiriwani.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}