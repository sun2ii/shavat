{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":139,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Yawé, 'ekɨ pepɨnetsixeiya,","poem":1},{"text":"'ekɨ pepɨnetsimate.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pepɨtimate kepauka 'anemayeixa meta kepauka nemanukukeka,","poem":1},{"text":"Tsepa kemeteewa kenemɨtiyɨkɨhɨawe pepɨtimate.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pepɨtimate kepauka nemukuyeika meta kepauka nemu'uxipie,","poem":1},{"text":"naime pepɨtimate nitixaɨtɨ pepɨkatitɨmaiya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Neniuki 'akuxi neteta kawayenewekaku","poem":1},{"text":"'ekɨ Yawé matsi, pekatinimaikari naime kenemɨtayɨni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Ekɨ naitsarie pepɨnetsi'ɨwiya,","poem":1},{"text":"'amamakɨ pepɨnetsi'anukanama.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kepemɨtimaiwe pɨmariwe yemekɨ,","poem":1},{"text":"ne nepɨkayɨwe nemeitimaitɨyani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"'A'iyari hɨxie nemuyuti'awieta xaɨtsie nepɨkayɨwe.","poem":1},{"text":"Nemuyuta'una xaɨtsie 'ahɨxie nemɨka'uyeikanikɨ nepɨkayɨwe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Muyuawitsie xɨka ne'anutiyanike,","poem":1},{"text":"mana pepeyeika 'ekɨ,","poem":2},{"text":"xɨka meukatewatsie neheukamieni,","poem":1},{"text":"muwatatsiere pepeyeika.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Xɨka neheyani tau manatineikatsie,","poem":1},{"text":"yatɨni haramara manu'axetsie,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"muwapaitɨta 'atɨrɨkariya pɨnetsihekuwitɨneni,","poem":1},{"text":"meta nepayeniereni 'atɨrɨkariyakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Xɨka mɨpaɨ ne'utayɨni: «Yɨriya kenetsi'anukanani,","poem":1},{"text":"hekɨariya nehetsiemieme yɨriya xeikɨa kehayani»,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"'ahetsiemieme yɨriya pɨkayɨriya,","poem":1},{"text":"tɨkarikɨ 'ahetsiemieme tukarikɨ hepaɨ pɨ'ane.","poem":2},{"lineBreak":true},{"text":"'Ahetsiemieme yɨriya meta hekɨariya yaxeikɨa pɨ'anene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"'Ekɨ pepɨtiutawewi naime netaɨta timieme,","poem":1},{"text":"nemaama hetsie pepɨnetsi'ayenuiwitɨa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kepemɨnetiutawewi mariwemekɨ pɨti'ane 'ayumieme nepɨmetsinɨawa.","poem":1},{"text":"'A'uximayatsika pɨnetsihɨxiyatsitɨa,","poem":2},{"lineBreak":true},{"text":"'ikɨ naime hepaɨtsita mɨpaɨ nepɨtimate.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ne'umete pɨwawerekai 'ekɨ pe'ixeiyakaku","poem":1},{"text":"kepauka 'awie nemɨwewiyakaitsie","poem":2},{"text":"kwieta meukatewatsie,","poem":1},{"text":"nemuwipariekaitsie.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Pepɨnetsixeiyakai kepauka tewi hepaɨ nemɨyɨximekai:","poem":1},{"text":"'ana naitɨri 'axapatsie pɨraka'ukai nehetsie timieme,","poem":2},{"text":"netukari kemɨreuterekekai paka'ukairi,","poem":1},{"text":"'akuxi xeitukari tɨma neka'uyeikakaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kakaɨyari, kepemɨtiku'eriwa nehetsiemieme witsipɨ'anene.","poem":1},{"text":"Naitɨ mɨkɨ yɨnɨtɨ yemekɨ pɨwaɨkawa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Xɨka ne'iti'inɨatake,","poem":1},{"text":"xiekari kemɨpaɨme matsi mɨkɨ pɨwaɨkawa.","poem":2},{"text":"Xɨka ne'iti'inɨata ne'i'inɨatatɨ nepeukuwe,","poem":1},{"text":"kepauka nemayɨhɨtɨani ne'aurie 'akuxi 'ekɨ pepukani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kakaɨyari, xɨka 'axateyuruwamete pewarukwinike 'aixɨa pɨ'anenikeyu.","poem":1},{"text":"Teɨteri memɨteyumemiwa nehamatɨa memɨka'u'uwanikɨ yapetiuyurienike,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"mɨkɨ 'ahetsiemieme 'axamemutiyuane","poem":1},{"text":"'itarikakɨ 'ahetsie memɨtehahɨpa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yawé, ne nepɨwaxani'erie kemɨ'ane memɨmetsixani'erie,","poem":1},{"text":"meta nepɨkawareuxeiyamɨkɨ kemɨ'ane memɨkametsinaki'erie.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ne yuheyemekɨ nepɨwareuheka,","poem":1},{"text":"memɨmetsi'aye'unie neta nepɨwaraye'unie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Kakaɨyari, ne'iyari keneuxeiya,","poem":1},{"text":"keneneuta'inɨata kenemɨtiyɨkɨhɨawe.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Keneneuxeiya xɨka huye 'axamɨ'ane 'utɨma ne'umieni,","poem":1},{"text":"matsi pɨta keneneuwitɨximeni tukari mɨkaxɨwe huyeyari 'utɨma.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}