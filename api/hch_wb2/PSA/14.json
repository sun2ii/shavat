{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":14,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"'Atsimɨkatimate yu'iyaritsie mɨpaɨ kaniutaineni:","poem":1},{"text":"«Kakaɨyari pumawe».","poem":2},{"text":"Mɨkɨ mepɨtipɨnirɨme, xani'eriwamekɨ yameteyurietɨ.","poem":1},{"text":"Xewitɨtɨma pɨka'uyeika 'aixɨa tiyurienetɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Muyuawitsie paitɨ Yawé teɨteri kaniwataxeiyani,","poem":1},{"text":"pɨtaniere xewitɨ 'aku kapuyeika","poem":2},{"lineBreak":true},{"text":"timaiwetɨ Kakaɨyari kuwaunetɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yunaitɨ mepeuyexɨri,","poem":1},{"text":"nixewitɨ pɨkayuhayewaxɨ.","poem":2},{"text":"Xewitɨ tɨma 'apɨka'uyeika 'aixɨa tiyurienetɨ,","poem":1},{"text":"nixewitɨ pɨka'uyeikatɨma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"¿Kamɨtsɨ 'atsimekatemate yunaitɨ 'axamemɨteyurie,","poem":1},{"text":"neteɨterima memɨwakwa'a paa memɨhɨkɨtɨni hepaɨ?","poem":2},{"lineBreak":true},{"text":"Hatsuaku Yawé mepɨkahahɨaweni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mana mekaniwamariutani xeikɨa,","poem":1},{"text":"peru Kakaɨyari heitserie memexeiya kaniwaparewieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Xeme tixaɨtɨ memɨkatehexeiya kememɨteyukɨhɨawe xemɨtewakwatsirie,","poem":1},{"text":"peru Yawé wahetsie kaninuaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kakaɨyari mɨpaɨ mɨtina'eriwanike","poem":1},{"text":"Kerutsareme hetsiemieme wikweitsitɨarika mɨnanɨ'ani.","poem":2},{"text":"Kepauka Yawé yuteɨterima mɨwatawikweitsitɨani,","poem":1},{"text":"'ana 'ixaheritsixi yunaitɨ mekaniyukatemamawiekuni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}