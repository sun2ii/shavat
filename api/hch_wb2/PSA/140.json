{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":140,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Neuxei Yawé, 'axateyuruwamete watsata keneneutawikweitsitɨa,","poem":1},{"text":"kenene'ɨwiyani memɨteyukananaima wahepaɨtsita,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"memɨyu'iyaritɨa xeikɨa hipame ke'axamemɨwayurieni","poem":1},{"text":"meta tsepa kepauka kwi memayukwiwawe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yuneni kuu nenieya hepaɨ xeikɨa mepimɨwa,","poem":1},{"text":"kuu 'uayeya mɨmɨya mepexeiya yutenitsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yawé, kenene'ɨwiyani 'axateyuruwamete wahepaɨtsita,","poem":1},{"text":"kenene'ɨwiyani memɨteyumemiwa wahepaɨtsita,","poem":2},{"lineBreak":true},{"text":"mɨkɨ memɨnetsihatihɨaximekɨ xeikɨa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mɨkɨ memɨyuti'ɨre winiyari mepɨnetsi'uketsiri,","poem":1},{"text":"kaunari nehɨxie mepɨtiye,","poem":2},{"lineBreak":true},{"text":"nemekawenikɨ nehɨxie mepɨte'u'una.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ne mɨpaɨ Yawé nepɨrahɨawe: «'Ekɨ pepɨnekakaɨyari.","poem":1},{"text":"Yawé, keneneu'eni kenemetiwawirie waɨkawa».","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yawé Ti'aitame, netsiwikweitsitɨwame pemɨtɨrɨkaɨye,","poem":1},{"text":"kepauka nemɨmierienenitsie pemɨnetsiparewie:","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yawé, pepɨkawapitɨaka 'axateyuruwamete memɨtehayu'iwanikɨ,","poem":1},{"text":"pepɨkawapitɨaka kememɨteku'eriwa mɨpaɨ memɨteyurienikɨ,","poem":2},{"lineBreak":true},{"text":"kapa me'uyuti'ɨrenikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Memɨnetsi'uweiya wahetsie pɨta kenanunɨ'a","poem":1},{"text":"'axamɨti'ane nehetsiemieme memeiyenɨ'akai.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tɨɨ wiyeriyari ke'ukaxɨrieni wahetsie,","poem":1},{"text":"taipa mekeheukaxɨriyani,","poem":2},{"lineBreak":true},{"text":"meta putsu meukatetewata, para hatsuaku tawarita memɨkawatikɨkanikɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Meke'ukumawere 'ena kwiepa","poem":1},{"text":"teɨteri memɨte'itawa,","poem":2},{"text":"'uximatɨarikakɨ mete'uka'eniwatɨ meke'ukwini","poem":1},{"text":"yunaitɨ teɨteri memɨteyukananaima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ne mɨpaɨ nepɨtimate Yawé teɨteri 'aixɨa memɨte'u'uwa meta tixaɨtɨ memɨkatehexeiya puwaparewie,","poem":1},{"text":"meta wahetsie punua heitserie kememɨtehexeiya.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yurikɨ 'aixɨa memɨte'u'uwa mepɨmetsinɨawani","poem":1},{"text":"meta 'ahɨxie mekaniu'uwakuni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}