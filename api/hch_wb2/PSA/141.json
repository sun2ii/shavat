{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":141,"content":[{"type":"hebrew_subtitle","content":["Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Yawé, 'ekɨ nepɨmetsihahɨawe, yapauka kenenanu'eni.","poem":1},{"text":"Kepauka nemɨmetsihahɨawe keneneuta'eiya kenemɨmetiwawirie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Ahetsɨa paitɨ kehenuani nenenewieri","poem":1},{"text":"'ɨkwa mawariyari hepaɨ,","poem":2},{"text":"teikɨ nememe'ekɨ","poem":1},{"text":"mawari taikai mieme hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yawé, netenitsie tihɨweme keneutaketsa, pepɨkanetsipitɨaka 'axanemɨtikuxatanikɨ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pepɨkanetsipitɨaka 'axanemɨtiyukɨhɨawenikɨ,","poem":1},{"text":"meta pepɨkanetsipitɨaka kapa 'axanetiuyurienikɨ,","poem":2},{"text":"pepɨkanetsipitɨaka 'ixɨararipa nemuyeikanikɨ","poem":1},{"text":"'axateyuruwamete wahamatɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"'Aixɨa mɨti'ane kenetsiku'imaiyani,","poem":1},{"text":"naki'eriya kenetsi'utate'ani,","poem":2},{"text":"witsimu'ɨa 'axateyuruwamete wapiini","poem":1},{"text":"nemu'utsie pɨkayuhayewani,","poem":2},{"text":"nemuyunenewiekɨ wahepaɨtsita","poem":1},{"text":"ke'axamemɨteyuriekɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kepauka xe'itsɨkate 'aitsie memakaxɨriyani,","poem":1},{"text":"'ana mɨpaɨ xepɨtehetimani kename ne yurikɨ nehainekai.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mɨpaɨ xepɨtiyuani: «Kwie kemɨtitawiwiwe,","poem":1},{"text":"kepauka hararu hetsiena muye'inetɨyeikatsie,","poem":2},{"text":"mɨpaɨta ta'umete pɨtiutaxɨri","poem":1},{"text":"teukiyapa tetsita».","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yawé Ti'aitame, 'ahetsie ne nepɨtiwiya,","poem":1},{"text":"'ahetsɨa ne nepɨne'awieta, pepɨkanetsipitɨaka nemɨmierienikɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Winiyari nehɨxie muwɨwɨtɨariwakɨ kenene'ɨwiyani,","poem":1},{"text":"'axateyuruwamete menetsiwiniyatɨwekaku.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Axateyuruwamete yuwiniyaritsietɨtɨ meke'uyewɨre,","poem":1},{"text":"neta newikweitsitɨarietɨ neke'ayani.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}