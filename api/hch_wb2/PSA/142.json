{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["Rawiri 'ɨkitsikaya. Kepauka terɨta mayekatetsiemieme. Nenewieri."]},{"type":"verse","number":1,"content":[{"text":"Karima ne'utahiwatɨ, Yawé parewiya nepɨwawirie,","poem":1},{"text":"karima ne'utahiwatɨ, Yawé nepɨwawirie mɨnetsinenimayakakɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mɨkɨ xeikɨa nepɨtihekɨatɨa kenemɨtiuta'aiwa,","poem":1},{"text":"nepɨtikuxaxatɨwa kenemɨtiuka'eniwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kepauka nemɨkayɨwenitsie,","poem":1},{"text":"'ekɨ matsi huye pepɨnetsixeitsitɨa.","poem":2},{"text":"Huye nemiweiya 'utɨma","poem":1},{"text":"hipatɨ winiyari nehetsiemieme mepuwɨwɨtɨwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tsiparatsɨ keneneuxeiya:","poem":1},{"text":"nixewitɨ parewiya pɨkanetsiyetuirie.","poem":2},{"text":"Nepɨkaheixeiya hakewa nemeyuti'awieta,","poem":1},{"text":"xewitɨ pumawe nehepaɨtsita yu'iyaritɨatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yawé, 'ekɨ parewiya nepɨmetsiwawirie,","poem":1},{"text":"'ekɨ ne mɨpaɨ nepɨmerahɨawe: «'Ekɨ hakewa nemeyu'awieta pepɨhɨkɨ,","poem":2},{"lineBreak":true},{"text":"'ena kwiepa tixaɨtɨ nepɨkarexeiya, 'ekɨ xeikɨa nepɨmetsihexeiya».","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kenemɨmetiwawirie keneneu'eni,","poem":1},{"text":"ne hikɨ nekaniweranini,","poem":2},{"text":"keneneutawikweitsitɨa memɨnetsi'uweiya wahepaɨtsita,","poem":1},{"text":"mɨkɨ matsi waɨkawa memɨtɨrɨkawikɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nepanutahɨiya keneniwayexɨna,","poem":1},{"text":"nemetsinɨawatɨ nemayanikɨ.","poem":2},{"text":"'Ana teɨteri 'aixɨa memɨte'u'uwa ne'aurie mekani'axɨakuni","poem":1},{"text":"menenieretɨ 'aixɨa pemɨnetsi'uyurikɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}