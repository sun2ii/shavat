{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":143,"content":[{"type":"hebrew_subtitle","content":["Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Yawé, nenewieri keneu'eni,","poem":1},{"text":"kenemɨmetiwawirie keneneuta'eiya.","poem":2},{"text":"'Aixɨa pemɨtikamiekɨ meta kemɨtiheitseriekɨ pemuyeikakɨ,","poem":1},{"text":"keneneuta'eiya.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Ekɨ meti'uximayatsiriwame pepɨka'utakwekwewiwani pemita'iwawiyakɨ,","poem":1},{"text":"'ahɨxie xewitɨ mɨkayɨwekɨ mɨpaɨ mutayɨnikɨ ne 'atsinepɨkatiyuruwame.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mepɨnetsimieku memɨnetsi'aye'unie:","poem":1},{"text":"kwiepa mepɨnetsi 'ɨhɨa nehɨxima.","poem":2},{"text":"Yɨwita nemuyeikanikɨri waɨriyarika mepɨnetsipitɨa,","poem":1},{"text":"meripaitɨ memukwi wahepaɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kenemɨtinewaɨriyakai pumaweri netɨrɨkariya,","poem":1},{"text":"ne'iyariri pɨka'uyuane nepɨka'i'enie.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nepɨtiku'eriwa meripaitɨ kemɨtiɨyɨ:","poem":1},{"text":"mariweme kepemɨtiuyuri nepuku'eriwa,","poem":2},{"lineBreak":true},{"text":"mɨpaɨ nepɨtimate kepemɨtiuyuri 'amamakɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nemamatekɨ 'ahepa nepeutame'e,","poem":1},{"text":"waɨkawa nemɨmetsiheuyehɨwakɨ, kwie muwaki haa kemɨreuyehɨwa hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yawé, yapauka keneneuta'eiya,","poem":1},{"text":"'ari netukari pɨtixɨxime.","poem":2},{"text":"Pepɨkanetsiwarixiwiyani,","poem":1},{"text":"xɨka mɨpaɨ pe'aneni, mɨwatixawata memeukakɨka wahepaɨ nekaniyɨmɨkɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ximeri mukatataretsie 'anaki'eriyakɨ kenenaye'eritɨwani,","poem":1},{"text":"'ahetsie yuri nemɨti'eriekɨ.","poem":2},{"text":"Huye keneneuxeitsitɨa ke'aneme nemuweiyani,","poem":1},{"text":"'ekɨ xeikɨa ne'iyari nemɨmetsiyetuiriekɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yawé, memɨnetsi'aye'unie wahepaɨtsita keneneɨxɨna,","poem":1},{"text":"'ahetsie xeikɨa nemikuwaunekɨ nemɨyu'awietani.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kemɨmetinake kenetineuta'ɨkitɨa mɨpaɨ nemɨtiyurienenikɨ,","poem":1},{"text":"'ekɨ nekakaɨyari pemɨhɨkɨkɨ.","poem":2},{"text":"'A'iyari 'aixɨa mɨ'ane kenetsi'uwitɨximeni","poem":1},{"text":"'uwerikaku hetsiena temetiketamɨre 'umawekaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yawé, 'ekɨ Kakaɨyari 'aixɨa pemɨtiuka'iyarikɨ, tukari keneneupitɨa,","poem":1},{"text":"heitseriemekɨ pemɨti'uximaya, nemɨtsaipɨnekɨ keneneɨxɨna.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Pemɨtiyukanaki'eriekɨ memɨnetsi'aye'unie keniwarukumaweriya,","poem":1},{"text":"yunaime memɨnetsi'aye'unie keniwarukuya,","poem":2},{"lineBreak":true},{"text":"ne ti'a'uximayatsiriwame nemɨhɨkɨkɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}