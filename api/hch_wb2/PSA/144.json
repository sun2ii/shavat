{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":144,"content":[{"type":"hebrew_subtitle","content":["Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Yawé 'aixɨa ke'itɨarieka, ne'ai mɨhɨkɨkɨ,","poem":1},{"text":"pɨneti'ɨkitɨa kuyaxa timiemekɨ,","poem":2},{"lineBreak":true},{"text":"nemamate pukuha'aritɨwa nemeuyutamiewenikɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mɨkɨ nekakaɨyari kanihɨkɨtɨni mɨtiyukanaki'erie, nehetsie nunuwame,","poem":1},{"text":"mɨmariwe hetsiena nemɨne'awieta, netsixɨname,","poem":2},{"text":"kɨmana nemɨyukunarɨma kanihɨkɨtɨni.","poem":1},{"text":"Mɨkɨ mɨnetsipitɨa kanihɨkɨtɨni neteɨterima nemɨtiwa'aitɨakakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yawé, ¿tita tihɨkɨ tewi pemi'ɨwiyanikɨ?","poem":1},{"text":"¿Tita teɨteri metehɨkɨ pemɨwaku'eriwanikɨ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Teyunaitɨ teɨteri xeimieme muka'ietɨyani hepaɨ tepɨ'anene,","poem":1},{"text":"tatukari 'etɨri hepaɨ pɨ'ane yapauka mukumamawere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yawé, muyuawi taheima muyema kenanutayepieka, muwa kenakayaka,","poem":1},{"text":"hɨrite keneumayɨaxɨa, yaketineuyuri kɨtsi muwatinexɨanikɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Amimierɨkari keneukaxɨri keniwareutaxɨriexɨa,","poem":1},{"text":"'a'ɨrɨkɨ ketineutamɨ'i, meta keniwarutaweiya memɨtatsi'aye'unie.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Muyuawitsie paitɨ 'atɨrɨkariya kenenanakanɨ'airi","poem":1},{"text":"hikɨ keneneutawikweitsitɨa hapa nekayunirɨmekaku,","poem":2},{"lineBreak":true},{"text":"nehetsie keneutanua teɨteri nemɨkawamate memɨnetsi'uweiyakɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kepauka memutiniuka, 'itarika mepɨkuxata,","poem":1},{"text":"yumamá yutserieta mieme mepanukuhapana, yakɨ xeikɨa metekuxatatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kakaɨyari, xeime hekwame kwikari nepɨtakwika 'ahetsiemieme,","poem":1},{"text":"nɨawari 'ahetsiemieme nepɨtikwika kanari tamamata mawɨtsie.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Ekɨ te'aitamete memɨte'ayu'iwanikɨ pepɨwapitɨa,","poem":1},{"text":"Rawiri ti'a'uximayatsiriwame pepɨ'ɨwiya 'ixipara mɨka'imienikɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kenenewikweitsitɨaka,","poem":1},{"text":"hipatɨ teɨteri memɨnetsi'uweiyakɨ nehetsie keneutanua.","poem":2},{"text":"Kepauka memutiniuka, 'itarikakɨ mepɨtekuxata,","poem":1},{"text":"yumamá mepanukuhapana, yakɨ xeikɨa metekuxatatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Taniwema, kepauka temari memakɨne,","poem":1},{"text":"meke'utiwawere kɨyexi waɨkawa mɨ'etɨriwiwawe hepaɨ,","poem":2},{"text":"taniwema 'ukari 'ixumeri kii mutuikatɨka hepaɨ meke'aneneni","poem":1},{"text":"witsimɨreukuwewiyatɨka paratsiyu witsimɨtiyuxexeiyanikɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yaketineuyuri ta'iku temakayayatsatsie ketineutihɨniya","poem":1},{"text":"'ikwai waɨkawa ketiutimɨire.","poem":2},{"text":"Tamuxatsima miriyarite keniwarayeitɨa,","poem":1},{"text":"'atsita mekayu'inɨatsinɨakame keniwarayeitɨa takwieyaritsie.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tatuurutsixi kwietsanamete raheteme memɨtekemakakɨ keniwarupitɨa,","poem":1},{"text":"takiekaritsie 'aixɨa reukukurarutɨariekame kenayeitɨa,","poem":2},{"lineBreak":true},{"text":"meta 'aiwari hiwariyari ke'umaweni takaye'utɨma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kemɨ'ane kiekari mɨpaɨ mɨrexeiya 'aixɨa ke'itɨarieka.","poem":1},{"text":"'Aixɨa mepɨ'itɨarie kemɨ'ane kiekari Yawé yukakaɨyaritɨme memayexeiya.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}