{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":145,"content":[{"type":"hebrew_subtitle","content":["Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Nekakaɨyari meta neti'aitɨwame, nepɨmetsinɨawani,","poem":1},{"text":"'aixɨa nepaineni yuheyemekɨ 'ahetsiemieme.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tukarikɨ 'aixɨa nepaineni 'ahepaɨtsita,","poem":1},{"text":"yuheyemekɨ nepɨmetsinɨawani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yawé kanimariweni, meta kaneuyeweka teminɨawani,","poem":1},{"text":"kemɨtimariwe pɨkayumainɨa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yuxexuitɨ tanuiwariyari mepe'eriwani 'a'uximayatsika,","poem":1},{"text":"mepikuxatani mariwemekɨ kepemɨtiuyuri.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Pepukuxaxatsiwani kepemɨtimariwe kepemɨti'aita,","poem":1},{"text":"neta nepiku'eriwani mariwemekɨ kepemɨtiuyuri.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mɨpaɨ putikuniuwani 'atɨrɨkariya kemɨtiyɨwe,","poem":1},{"text":"ne matsi 'a'uximayatsika mɨmariwe nepukuxatani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Pepukuxaxatsiwani waɨkawa kepemɨtiyukanaki'erie,","poem":1},{"text":"temawierikakɨ te'utihiwatɨ tepɨmetsitakwika pemɨrayu'iwakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yawé 'aixɨa pɨtiuka'iyari pɨtiyukanenimaya,","poem":1},{"text":"pɨkahayu'eriya matsi waɨkawa pɨtiyukanaki'erie.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yawé 'aixɨa pɨtiuka'iyari,","poem":1},{"text":"mɨkɨ kaniwanenimayaka yunaime mɨtiwarutiwewi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yawé, yunaime pemɨtiwarutiwewi mekemetsinɨawani,","poem":1},{"text":"'ateɨterima yamemɨtekahu 'aixɨa mekehaitɨkani 'ahetsiemieme.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Meketekuxatani witsikepemɨti'aita,","poem":1},{"text":"meta mariwemekɨ kepemɨtiuyuri,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"yunaitɨ kwiepa memɨtama memeitimanikɨ mariweme kepemɨtiuyuri","poem":1},{"text":"meta witsipe'anetɨ kepemɨtimariwe metatsiere 'aixɨa 'anemekɨ kepemɨti'aita.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kepemɨti'aitani yuheyemekɨ hawaikɨ pɨkaheu'aka,","poem":1},{"text":"'ekɨ pepɨti'aitani naime wiyaritsie.","poem":2},{"lineBreak":true},{"text":"Yawé yuniuki paye'atɨa,","poem":1},{"text":"meta 'aixɨa pɨtiuka'iyari naime yu'uximayatsikatsie.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yawé mematixɨrie kaniwaranuku'uitɨwani","poem":1},{"text":"meta memu'uximatɨarie kaniwatɨrɨkariyani.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Meteyunaitɨ mepɨmetsixeiya xeikɨa,","poem":1},{"text":"meta'ikwewatɨ pemɨtiwaminikɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Peyuwaɨriyatɨ 'amamá pepanutayepiwa pepɨwahuxaitɨa,","poem":1},{"text":"yunaime memɨte'u'uwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Yawé heitserie pɨti'uximaya kemɨtayɨni pɨraye'atɨwa","poem":1},{"text":"meta naime yapɨtiyuriene yunaki'eriyakɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kemɨ'ane Yawé memahɨawe 'ahurawa wa'aurie kaniuyeikani,","poem":1},{"text":"kemɨ'ane yurikɨ yemekɨ memehɨawe.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Pɨraye'atɨwa kememɨtehehɨawe meteheuyehɨatɨ memeyemakaxe,","poem":1},{"text":"wahiwari 'aiwariyari 'enietɨ yapɨtikamie meta puwawikweitsitɨa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yawé kemɨ'ane meminaki'erie mɨkɨ yunaime pɨwa'ɨwiya,","poem":1},{"text":"peru 'axamemɨte'u'iyari yunaime puwareuyehɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Yawé yuheyemekɨ nepɨmetsinɨawani.","poem":1},{"text":"Yunaitɨ kwiepa memɨtama mepɨmetsinɨawani,","poem":2},{"lineBreak":true},{"text":"hikɨ meta yuheyemekɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}