{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"Yawé kenɨawarieka.","poem":1},{"text":"Ne'iyari, Yawé kenenɨawani.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne Yawé nepɨnɨawani kenemɨreutere,","poem":1},{"text":"mexixi ne'ayeniere, nɨawari Kakaɨyari hetsiemieme neputikwikani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Teɨteri memɨtɨrɨkawi wahetsie xepɨkatewiyani,","poem":1},{"text":"mɨkɨta mepɨkwiwawe xeikɨa, mepɨkayuwawe memɨxetawikweitsitɨanikɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kepauka mɨmɨni tumuanari kanayeimɨkɨ xeikɨa,","poem":1},{"text":"'ana kemɨtiku'eriwakai naitɨ katineuyewemɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"'Aixɨa kani'itɨarieka kemɨ'ane Kakuwu kakaɨyarieya miparewie,","poem":1},{"text":"meta kemɨ'ane Yawé mɨtakwewie yukakaɨyari,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"muyuawi meta kwie mɨtiutiwewi,","poem":1},{"text":"haramara meta yunaitɨ titamexi mana memɨteye'uwa,","poem":2},{"lineBreak":true},{"text":"mɨkɨ matsi yurikɨ xeikɨa katinikuxatani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yawé memɨnanaimarie wahetsie 'aixɨa katiniyurieka,","poem":1},{"text":"memɨyehakakwitɨwe katiniwamikwani","poem":2},{"lineBreak":true},{"text":"meta memanutaxɨriwa kaniwaranayexɨnani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yawé memɨkahauneniere kaniwaranutanieritɨwani,","poem":1},{"text":"Yawé mematixɨri kaniwaranuku'uitɨwani,","poem":2},{"lineBreak":true},{"text":"Yawé kaniwanaki'erieka 'aixɨa memɨte'u'uwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yawé ku'uwamete kaniwa'ɨwiyani,","poem":1},{"text":"nutuite meta wiuraxi kaniwaparewieka,","poem":2},{"lineBreak":true},{"text":"peru 'axateyuruwamete kememɨteku'eriwa kananutunani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kerutsareme 'aku, Yawé keti'aitani yuheyemekɨ.","poem":1},{"text":"'Akakaɨyari keti'aitani yuheyemekɨ.","poem":2},{"lineBreak":true},{"text":"Yawé kenɨawarieka.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}