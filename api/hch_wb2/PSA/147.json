{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":147,"content":[{"type":"verse","number":1,"content":[{"text":"Yawé kenɨawarieka.","poem":1},{"lineBreak":true},{"text":"Yemekɨ 'aixɨa pɨ'ane takakaɨyari hetsiemieme nɨawari temɨkwikani,","poem":1},{"text":"'aixɨa pɨ'ane meta mɨkɨ heitserie pexeiya teminɨawanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yawé Kerutsareme panukuketɨa,","poem":1},{"text":"memehapanie 'ixaheritsixi puwakuxexeɨriwa,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"memɨyuhiwerie 'aixɨa meteheu'eriekame puwarayeitɨwa","poem":1},{"text":"memawitekietɨkatsie puwaranaku'eima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Puwa'inɨata xurawetsixi kememɨyupaɨme","poem":1},{"text":"mɨkɨ yunaime puwaterɨwa yuxexuime.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tati'aitɨwame pɨmariwe, meta tɨrɨkariyaya pɨmɨire,","poem":1},{"text":"kemɨtimaiwe hawaikɨ pɨkaheu'axe,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yawé puwaranuku'uitɨwa tixaɨtɨ memɨkateheuxeiya,","poem":1},{"text":"matsi pɨta 'axateyuruwamete puwaratixɨrɨwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Xekenenɨawani Yawé pamɨpariyutsi xe'ipitɨatɨ,","poem":1},{"text":"xekeneukakanariwiwani kanarikɨ Kakaɨyari nɨawarieya xe'utikwitɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mɨkɨ hai kanikuyuitɨwani,","poem":1},{"text":"kwiepa wiyeri kaneyenɨ'awani","poem":2},{"lineBreak":true},{"text":"meta hɨritsie 'ɨxa pɨweriya.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tewaxi mɨkɨ pɨtiwamikwa","poem":1},{"text":"meta kwatsari tɨɨrixi puwawaweriya pɨtiwamikwa me'utitsuanakaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yawé pɨkayutemawie kawayu tɨrɨkariyayakɨ,","poem":1},{"text":"meta tewi kemɨranautsawekɨ,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"matsi kaninaki'aka kemɨ'ane memeyemakaxe wahetsiemieme,","poem":1},{"text":"kemɨ'ane naki'eriyayatsie memɨtewiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kerutsaremetari, Yawé hepaɨtsita 'aixɨa xekeneutiyuaneni,","poem":1},{"text":"yukakaɨyari xekenenɨawani.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kerutsareme 'itupariyarita meukukeka kanitɨrɨkariyani mɨtse'inikɨ","poem":1},{"text":"meta 'aixɨa kaniwayurieka mana kiekatari.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mɨpaɨ pɨtixepitɨa 'aixɨa xemɨtexeiyariekakɨ","poem":1},{"text":"meta 'ikwai 'aixɨa mɨ'ane kanixemikwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Yuniuki kwiepa peyenɨ'awa,","poem":1},{"text":"naitsarie pɨtakɨka niukieya yumexɨitɨatɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"'Ɨwi pɨkawiwiwa mata mutuxa hepaɨ,","poem":1},{"text":"haɨtsi wiyeri naxi hepaɨ pɨkawiwiwa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tee pɨkaxɨrɨwa tetexi 'etsimɨpepe hepaɨ,","poem":1},{"text":"xewitɨ pɨkayɨwe minewieni haɨtɨriyaya.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Matsi yuniuki kanenɨ'awani mitiparitɨanikɨ,","poem":1},{"text":"mɨkɨ 'eka punenetɨwa mitiparitsitɨanikɨ, meta haa muwayenexɨanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Yuniuki 'ixaheritsixi pɨwahekɨatɨa,","poem":1},{"text":"meta yu'aitsikate yɨ'ɨkitɨarika puwarupitɨa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mɨpaɨ xeime tawarita nuiwari pɨkayuriwe,","poem":1},{"text":"'atsimepɨkatehetimaiwawe mɨkɨ 'aitsikaya hepaɨtsita.","poem":2},{"lineBreak":true},{"text":"Yawé kenɨawarieka.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}