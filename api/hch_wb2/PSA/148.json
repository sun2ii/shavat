{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"Yawé kenɨawarieka.","poem":1},{"lineBreak":true},{"text":"Muyuawitsie paitɨ Yawé xekenenɨawani,","poem":1},{"text":"meutitewatsie xekenenɨawani.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Niuki tuayametemama yunaitɨ, xekenenɨawani,","poem":1},{"text":"kuyaximama yunaitɨ, xekenenɨawani.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tau meta metsa, meke'inɨawani,","poem":1},{"text":"xurawetsixi xemutimerɨkare, xekenenɨawani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Xemeta muyuawi 'amautitewa, xekenenɨawani,","poem":1},{"text":"xemetatsiere haa muyuawitsie xemuyema.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yawé kemɨtimariwe, 'aixɨa ketikuxaxatsiwani,","poem":1},{"text":"mɨkɨ yatiuta'aitaku naitɨ katiniutawewiyani.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Naitɨ yapɨtiuyɨ yuheyemekɨ,","poem":1},{"text":"'aitsika punetɨa mɨkakuyuitɨariwanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yawé xekenenɨawani kwiepa,","poem":1},{"text":"haramara 'amaukatewatsie kiekatari,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"tee meta merɨkariya, 'ɨwi meta haiwitɨri,","poem":1},{"text":"'eka mɨtɨrɨkaɨye meye'atɨwa 'aitsikaya,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"yemurite meta 'amanutitɨtɨ hɨri,","poem":1},{"text":"kariuxa meta 'ikwaxi mɨtikayaxike naitɨ,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"tewaxi meta yeutari,","poem":1},{"text":"memɨtekɨwɨtɨwe meta kuuterixi,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"yunaitɨ nuiwarite meta kwiepa te'aitamete,","poem":1},{"text":"mexɨakate meta kwiepa kuwexinaruritsixi,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"temari meta 'ɨimarixi,","poem":1},{"text":"'ukirawetsixi meta tɨɨri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yawé xekenenɨawani,","poem":1},{"text":"mɨkɨ xeikɨa mɨmariwekɨ,","poem":2},{"text":"kemɨtimariwe kwie pa'iwa meta muyuawi.","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Mɨkɨ yuteɨterima kaniwatɨrɨkariyani.","poem":2},{"lineBreak":true},{"text":"Mɨkɨ xeikɨa mekenɨawani yunaitɨ hetsiena memɨtewiya,","poem":1},{"text":"'ixaheritsixi, 'ahurawa teɨterimama.","poem":2},{"lineBreak":true},{"text":"Yawé kenɨawarieka.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}