{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"Yawé kenɨawarieka.","poem":1},{"lineBreak":true},{"text":"Kwikari hekwame xekenekwikani Yawé hetsiemieme,","poem":1},{"text":"teɨterimama hetsiena memɨtewiya wahamatɨa xekenenɨawani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"'Ixaheritsixi mekeyutemamawieka mɨwarutawewi hetsiemieme,","poem":1},{"text":"Kerutsaremetari xekeneyutemamawieka xeti'aitɨwame hetsiemieme.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Meke'inɨawani mete'ukaketsinatɨ,","poem":1},{"text":"kwikari meke'utikwikani xawerimakame meta tepu 'etsimupekɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yawé muyutemawiekɨ yuteɨterima wahetsiemieme,","poem":1},{"text":"tixaɨtɨ memɨkatehayuyeitɨa memɨtehayu'iwanikɨ puwapitɨa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hetsiena xemɨtewiya xekeneyutemamawieka mɨkɨ xepitɨakaku xemɨtehayu'iwaxɨkɨ,","poem":1},{"text":"tsepa yu'utatsie xemuhe xekeneutihiwani xeyutemamawietɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kakaɨyari nɨawarieya 'ateta kehayeneikani,","poem":1},{"text":"'ixipara pekehakweka naitsata hautixikakaunime,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"para yunaitɨ nuiwarite memɨtehakapitɨarienikɨ ke'axamemɨteyuriekɨ","poem":1},{"text":"meta kiekarite mɨtiwaka'enitsitɨanikɨ,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"para te'aitamete memɨtihɨiyanikɨ,","poem":1},{"text":"tepɨa kaunariyari mɨtse'ikɨ hayehutamekɨ,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"para maye'atɨarienikɨ wahetsie kemɨraka'utsie kememɨte'anuyekɨnekɨ.","poem":1},{"text":"'Ikɨkɨ mɨpaɨ mepɨteyutemamawieka teɨterimama.","poem":2},{"lineBreak":true},{"text":"Yawé kenɨawarieka.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}