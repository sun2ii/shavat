{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":15,"content":[{"type":"hebrew_subtitle","content":["Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Yawé, ¿kemɨ'ane 'atukita payeyerɨwe?","poem":1},{"text":"¿Kemɨ'ane 'ahɨri mɨpatsietsie puyutakiitɨawe?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hetsiena mɨkarahɨiwa xeikɨa kaniyɨweni,","poem":1},{"text":"'aixɨa mɨtiyuriene","poem":2},{"lineBreak":true},{"text":"yu'iyarikɨ yurikɨ mɨtikuxata,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"yuniukikɨ hipame mɨkawarekaxɨrɨwa,","poem":1},{"text":"yu'aurie kiekame 'axamɨkatikuxaxatɨwa,","poem":2},{"lineBreak":true},{"text":"yuhepaɨtewi 'axamɨkayurie,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"kemɨ'ane Kakaɨyari muwa'uxie mɨkawanaki'erie,","poem":1},{"text":"peru mɨwanaki'erie Yawé memayemakaxe,","poem":2},{"text":"mɨraye'atɨwa kemɨtayɨni","poem":1},{"text":"tsepa tiuka'eniwatɨ,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"kemɨ'ane tumini mɨt