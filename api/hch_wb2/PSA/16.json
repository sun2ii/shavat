{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":16,"content":[{"type":"hebrew_subtitle","content":["Rawiri kwikarieya."]},{"type":"verse","number":1,"content":[{"text":"Kakaɨyari kenene'ɨwiyani, 'ahetsie xeikɨa nemɨne'awietakɨ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ne Yawé mɨpaɨ nepɨmarahɨawe: «'Ekɨ pepɨnekakaɨyari.","poem":1},{"text":"Nexaɨta nepɨkayɨwe, 'ahetsie xeikɨa netiwiyatɨ 'aixɨa ti'aneme nepɨrexeiya».","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwiepa miemete memɨpatsie,","poem":1},{"text":"memɨmamariwawe wahetsie nepɨnetemawie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Peru kemɨ'ane kakaɨyarixi memuwarayexeiyani","poem":1},{"text":"waɨkawa mepɨtekwineni.","poem":2},{"text":"Ne hatsuaku newarayexeiyatɨ nepɨka'ayani wakakaɨyarixi meta mawari nepɨkawawewirieni,","poem":1},{"text":"meta kememɨtetetewa nepɨkawakuxatani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"'Ekɨ, Yawé, ne'ikwai pekanihɨkɨtɨni meta tita nemɨti'ie,","poem":1},{"text":"'ekɨ yapekatinimaika kemɨnetiyurieni netukari hepaɨtsita.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Witsimɨraku'anetsie nepɨnehayewaxɨ yarainekaku,","poem":1},{"text":"'imikieri witsiti'anetɨ nehetsie pɨtiunakixɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yawé hepaɨtsita 'aixɨa nepaineni mɨneti'ɨkitɨakɨ,","poem":1},{"text":"tɨkarikɨ pɨnetsihayehɨtɨwa ne'eriwametsie.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne Yawé neheyemekɨ yanepɨranuyeyetsa,","poem":1},{"text":"mɨkɨ netserieta 'utiwekaku, xewitɨ pɨkanetsi'atihɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"'Ayumieme ne'iyaritsie nepuyutemawie,","poem":1},{"text":"netaɨta naitɨ nepuyutemawie,","poem":2},{"lineBreak":true},{"text":"'ayumieme ne'iyarikɨ yuri neti'erietɨ 'anepuyeika.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Ekɨ pepɨkanetsiku'eirieni mɨkite wateukiyapa,","poem":1},{"text":"'ekɨ pepɨkanetsipitɨani nemɨtapɨnekɨ 'aparewiwame yanemɨtikamie.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Pepɨnetsi'uxeitsitɨa huye tukari nemexeiyanikɨ,","poem":1},{"text":"waɨkawa pepɨnetsihetemawieritɨani kepauka 'ahɨxie nemeta'ani,","poem":2},{"lineBreak":true},{"text":"'atserieta meta yuheyemekɨ yanepɨreyutemawieka.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}