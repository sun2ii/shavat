{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":17,"content":[{"type":"hebrew_subtitle","content":["Rawiri nenewierieya."]},{"type":"verse","number":1,"content":[{"text":"Yawé, heitseriekamekɨ kenemetiwawirie keneu'eni,","poem":1},{"text":"nehiwari keneu'eni keneneuparewi,","poem":2},{"text":"nenenewieri kwi keneu'eni,","poem":1},{"text":"ne neti'itawatɨ nepɨka'utaine.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nehetsie nunuwame kenehɨkɨtɨni 'ekɨ,","poem":1},{"text":"'ekɨ pemɨtimatekɨ tita mɨtiheitserie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"'Ekɨ ne'iyari pepɨmate,","poem":1},{"text":"'ekɨ tɨkarikɨ pepɨnetsixeiya,","poem":2},{"text":"tsiparatsɨ keneneuta'inɨata,","poem":1},{"text":"nehetsie 'axamɨ'ane pepɨkakaxeiya.","poem":2},{"lineBreak":true},{"text":"Ne 'axanepɨkatayɨni","poem":1}]},{"type":"verse","number":4,"content":[{"text":"hipatɨ teɨteri kememɨte'uniuka wahepaɨ,","poem":2},{"lineBreak":true},{"text":"netsɨ 'aniuki nekanaye'atɨaka.","poem":2},{"text":"Teɨteri memɨteyukananaima wahuye nepɨka'uweiya","poem":1}]},{"type":"verse","number":5,"content":[{"text":"ne nepɨkawa'ɨke nepɨne'ɨwiya,","poem":2},{"lineBreak":true},{"text":"'ahuye 'etsimatayeyeu 'utɨma nepumie nekahekawautsetɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kakaɨyari 'aku, 'ekɨ xeikɨa nepɨmatsihahiwiwa, 'ekɨ pemɨnetsiku'eiyakɨ,","poem":1},{"text":"'ahurawa keneneu'eni pemi'enienikɨ nenenewieri.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Ekɨ, 'atɨrɨkariyakɨ pemɨwawikweitsitɨawe,","poem":1},{"text":"kemɨ'ane memuyu'unarɨme memɨwaraye'unie mewaruweiyakaku,","poem":2},{"lineBreak":true},{"text":"'inɨari yakenetineuxeitsitɨa waɨkawa kepemɨti'akanaki'erie.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kenene'ɨwiyani 'ahɨxi hixɨapa mɨyeka pemɨti'ɨwiya hepaɨ,","poem":1},{"text":"kenene'awietani, wakana yu'anatɨa yuniwema mɨtiwa'ɨwiya hepaɨ,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"kenene'awietani 'axateyuruwamete memɨnetsimietɨwekɨ,","poem":1},{"text":"memɨnetsi'aye'unie newarita mematetɨkakɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yu'iyaritsie xeikɨa mepɨteheunama,","poem":1},{"text":"'axamekatenikuxatani hipame mewa'iwakutɨ xeikɨa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Ahurawa xeikɨa mekanenita'ɨwiyani kenemɨtiyuriene,","poem":1},{"text":"mekanenihupieka menetsimiekutɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mayetsi memɨtehupa hepaɨ mekani'aneneni,","poem":1},{"text":"mayetsi yuwai memɨtetahupie hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Hikɨmɨ, Yawé, 'ekɨta wahɨxie keneukexi.","poem":1},{"text":"Keniwara'iwa.","poem":2},{"lineBreak":true},{"text":"'A'ixiparakɨ keneneutawikweitsitɨa 'axateyuruwamete memɨnetsi'uweiyakɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yawé, 'atɨrɨkariyakɨ keneneutawikweitsitɨa 'ikɨ teɨteri memɨkwiwawe mepɨnetsi'uweiya,","poem":1},{"text":"yutukari memumikie 'ena kwiepa pɨmieme xeikɨa.","poem":2},{"lineBreak":true},{"text":"Kwinie mɨraye'atɨkakɨ xeikɨa pepɨwarutihɨniyaxɨ,","poem":1},{"text":"waniwema waɨkawa metehexeiyatɨ mepakɨ,","poem":2},{"lineBreak":true},{"text":"wanuiwarima wahetsiemieme paitɨ pɨranayuhayewaxɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Peru ne matsi heitseriekamekɨ 'ahɨxie nepumatsihexeiya.","poem":1},{"text":"'Ahɨxie kepauka nemanutaniere nematsihexeiyatsie mɨkɨkɨri ne'iyari 'aixɨa peyɨni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}