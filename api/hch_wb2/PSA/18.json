{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":18,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Rawiri kwikarieya, Tsahuri heye'uniekaku meta yunaitɨ memeye'uniekai me'ikuweiyatɨwekaku. Yawé Rawiri kemɨtiutawikweitsitɨa. 'Ana mɨpaɨ kaniutayɨni:"]},{"type":"verse","number":1,"content":[{"text":"Yawé, yuheyemekɨ nepɨmatsinaki'erie, 'ekɨ pepɨnetɨrɨkariya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yawé 'ai hepaɨ kani'aneni, mɨnetsikunama, mɨnetsiwikweitsitɨa,","poem":1},{"text":"nekakaɨyari kanihɨkɨtɨni, 'ai 'amutitɨtɨ taɨta mɨnetsi'awieta.","poem":2},{"text":"Nehetsie kaninunuwametɨni, tɨrɨkaɨyemekɨ mɨnetsiwikweitsitɨa,","poem":1},{"text":"mɨkɨ 'ateewa paitɨ pɨnetsi'awieta.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yawé nepahɨawe, meuyewetse mɨnɨawariekakɨ,","poem":1},{"text":"memɨnetsi'aye'unie wahetsɨa pɨnetsihayeha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mɨki winiyariyaritsie nepunexei nehɨatɨ,","poem":1},{"text":"haa kwinimieme mɨtiwakuxikɨriwatsie mekaneneukahɨpani.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kaunarikɨ kaneniutahɨani nemɨkateukienikɨ,","poem":1},{"text":"mɨki winiyariyaritsie nekaniunexeiya.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne'uximatɨarietɨ Yawé nekaniutahɨawe,","poem":1},{"text":"nekakaɨyari nekaniutahiwieni,","poem":2},{"text":"mɨkɨ yutukita paitɨ kaneniu'enieni,","poem":1},{"text":"nehiwari nakatana paitɨ katiniunake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kwie naitɨ kaniutayuani kaniuta'une,","poem":1},{"text":"kaniwatayuaxɨani hɨri tsutɨmeyarite,","poem":2},{"lineBreak":true},{"text":"Kakaɨyari haxɨayakɨ kanewatayuaxɨani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tsuritana kɨtsi kanewakaneikakaitɨni,","poem":1},{"text":"tetanata tai watixɨtsitɨwatɨ,","poem":2},{"lineBreak":true},{"text":"tɨɨ xawawatɨme kaniwayenenetɨwakaitɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Muyuawi hanutayepieka niwakayani,","poem":1},{"text":"hai yɨyɨwimetsie 'akiekatɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Xeime yuteɨtametsie 'akaitɨ, muyuawitsie xuruku kaniutawewieni","poem":1},{"text":"'eka 'anayatsie 'akaitɨ kaneyani.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yɨwita kaneuyuka'awieta,","poem":1},{"text":"hai yɨyɨwimetsata hakɨkɨ","poem":2},{"lineBreak":true},{"text":"naitɨ nanukanakaitɨni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kwinimieme mɨtixawatɨkaikɨ hai niukaxɨrieni,","poem":1},{"text":"tee meta tɨɨ tatɨkaitɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Muyuawitsie, tee meta tɨɨ tatɨkaitɨ kaxɨrɨwekaku,","poem":1},{"text":"Yawé niukieya kanayu'eniɨriɨkɨre tɨranari hepaɨ,","poem":2},{"lineBreak":true},{"text":"'Amutewi niukieya waɨkawa kanayu'eniɨriɨkɨre.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yu'ɨrɨkɨ kaniwarutamɨni, mimierɨkari mɨmamariwawe,","poem":1},{"text":"memɨnetsi'aye'unie kaniwarutaweiya, kaniwarutinautsitɨani.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yawé, pemɨtiuyutatikɨ,","poem":1},{"text":"'ahaxɨa 'iiyarikɨ,","poem":2},{"text":"haramara mayema kananatihekɨare,","poem":1},{"text":"kanahekɨare kwie tsutɨmeyari mituikatɨka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Yumamá 'ameutitewatsie paitɨ kanakatsera,","poem":1},{"text":"nemamatsie kanikawiere kanenewatihana haramara meukatewatsie.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kaneniuxɨna mɨnetsi'aye'unie mɨtɨrɨkaɨye hetsɨa,","poem":1},{"text":"meta memɨnetsixani'eriekai wahetsɨa,","poem":2},{"lineBreak":true},{"text":"matsi mɨkɨ mepɨtɨrɨkawikai ne kenemɨkatitɨrɨkaɨye.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kepauka nemekawe mekaneniutamieni,","poem":1},{"text":"matsi Yawé netsiparewiwame kanayani.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"'Amakuyewatsie kaneni'atɨani,","poem":1},{"text":"kaneniutawikweitsitɨani netsinaki'erietɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Yawé kanetinakapitɨani heitseriekamekɨ kenemɨtiyuriene,","poem":1},{"text":"yakanetiniuta'iwitsitɨani nemamakɨ 'axanemɨkatiuyurikɨ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yawé huyeyatsie xeikɨa nemumiekɨ,","poem":1},{"text":"hawaikɨ 'axanemɨkareyurienekɨ","poem":2},{"lineBreak":true},{"text":"nekakaɨyari nemɨkaku'eiriwekɨ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Titakɨ mɨneranutahɨani naime nepɨtimate,","poem":1},{"text":"'aitsikaya nepɨkahatɨtɨmaiya.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hamatɨana 'aixɨa nepɨtiuyeika","poem":1},{"text":"nepɨkanewaɨriya 'axanemɨtiyurienenikɨ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yawé kanetiniyetuirieni heitseriekamekɨ kenemɨtiuyeika,","poem":1},{"text":"nemamakɨ ke'axanemɨkatiyuriene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"'Ekɨ 'aixɨa pepɨtiuka'iyari kemɨ'ane 'aixɨa mɨtiuka'iyari hamatɨa,","poem":1},{"text":"'aixɨa 'anemekɨ pepɨwanenimaya kemɨ'ane 'aixɨa memɨte'u'uwa,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"kayuwatɨ pepuyeika kemɨ'ane kayuwatɨ muyeika hamatɨa,","poem":1},{"text":"peru kemɨ'ane mutiuyukananaima hamatɨa petimaiwetɨ pepuyeika.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kemɨ'ane tixaɨtɨ memɨkate'ayuyeitɨa pepɨwapitɨa memɨte'ayu'iwanikɨ,","poem":1},{"text":"peru kemɨ'ane memɨte'uyukatawe'erie tixaɨtɨ pepɨkatiwarayeitɨwa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Yawé, 'ekɨ nekɨxeme takame pepɨnetsihayewirie,","poem":1},{"text":"'ekɨ nekakaɨyari, neyɨriya pepɨhekɨariwiya.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"'Ekɨ penetsiparewiekaku hipame kuyaxi nepɨwatakwini,","poem":1},{"text":"nekakaɨyari, hamatɨa kiekari kuraruyarita nemeukahani nepɨyɨwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Kakaɨyari huyeya pɨheitserie,","poem":1},{"text":"Yawé niukieya kani'itiyaka.","poem":2},{"lineBreak":true},{"text":"Kakaɨyari kuya tepɨaya kanihɨkɨtɨni kemɨ'ane mana memuyu'awieta wahetsiemieme.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"¿Kemɨ'ane Kakaɨyari pɨhɨkɨ, Yawé xeikɨa kanihɨkɨtɨni?","poem":1},{"text":"¿Kemɨ'ane tete pɨhɨkɨ, takakaɨyari xeikɨa kanihɨkɨtɨni?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Mɨkɨ netɨrɨkariya kanayeikani","poem":1},{"text":"nehuye mɨheitseritɨa,","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ne'ɨkate maxa 'ɨkateya kanayeitɨwani,","poem":1},{"text":"meta kepauka 'ateewa nemakakanitsie pɨkanetsipitɨa nemanakawenikɨ,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"pɨneti'ɨkitɨa nemeyutamiewenikɨ,","poem":1},{"text":"nemamate pɨtɨrɨrikaya purunitse tupiyari nemahapananikɨ.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"'Ekɨ 'atepɨakɨ pepɨnetsiwikweitsitɨa,","poem":1},{"text":"'atseriekɨ pepɨnetsiwiya,","poem":2},{"lineBreak":true},{"text":"'aixɨa pemɨtiuka'iyarikɨ neputawikwewe.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Huyeta 'aixɨa pɨtiyurie xeiya nemumienikɨ,","poem":1},{"text":"nemɨkahetiketamɨrikenikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Nepɨwaranukuwei memɨnetsi'aye'unie, nepɨwaranuku'axixɨ,","poem":1},{"text":"ne nepɨkahewake yunaime newarakumaweriyakake.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Nepɨwaretipɨnaxɨ. Tawari mepɨkahanuku'ui.","poem":1},{"text":"Nehetɨa mekanekaxɨrieni.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"'Ekɨ tɨrɨkariya pepɨnetsi'upitɨa nemɨnetamienikɨ,","poem":1},{"text":"nehetɨa 'axamemɨte'u'iyari pekaniwati'uitɨani.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Memɨnetsi'aye'unie memɨkaxɨrienikɨ yapekatiniuyurieni,","poem":1},{"text":"neta mɨpaɨ nekatiniwareuyehɨani memɨnetsi'uxiekai.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Parewiya mepuku'iwawakai, xewitɨ mɨwatawikweitsitɨanikɨ pɨka'utine.","poem":1},{"text":"Yawé meputahiwi, matsi mɨkɨ pɨkawaruta'ei.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Nepɨwarutitɨxixɨ. Tumuanari hepaɨ mepɨteyuxexeiyakai 'eka mei'enitsitɨwa.","poem":1},{"text":"Nepɨwarutiketsi haxu hepaɨ huyeta mɨtika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Memɨnetsi 'uximatɨakai wahetsɨa pepɨnetsi 'ɨxɨnaxɨ,","poem":1},{"text":"hikɨ matsi hipame nuiwarite wayeta pepɨnetsikake,","poem":2},{"lineBreak":true},{"text":"hikɨ mepɨnetsi'ayexeiya teɨteri nemɨkawamatekai.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Yapauka menetsi'enietɨ, mepuyuyetuayakai nehetsɨa,","poem":1},{"text":"teewatari mepɨyɨa, mɨyatɨtɨ nehɨxie mepanakatutsire.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Mɨkɨ nemɨkawamate meputimamawe,","poem":1},{"text":"me'utiyɨyɨakatɨ mepɨwayekɨka memuwayu'awietata.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Yawé kaniuyeikani. 'Aixɨa keramamatiwani ne'ai.","poem":1},{"text":"Kenɨawarieka nekakaɨyari netsiwikweitsitɨwame.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Kakaɨyari nehetsiemieme mɨtiwarakapitɨwa memɨnetsi'aye'unie pɨhɨkɨ,","poem":1},{"text":"nuiwarite nehetɨa muwaku'uitɨwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":48,"content":[{"text":"'Ekɨ pepɨnetsiwikweitsitɨa memɨnetsi'aye'unie wahetsɨa,","poem":1},{"text":"memɨnetsi'aye'unie waheima pepɨnetsikake,","poem":2},{"lineBreak":true},{"text":"pepɨnetsiwikweitsitɨa teɨteri 'axamemɨte'u'iyari wahetsɨa.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Yawé, 'ayumieme ne 'aixɨa nepaine 'ahepaɨtsita nuiwarite watsata","poem":1},{"text":"meta nɨawari 'ahetsiemieme neputikwika kepemɨtitewakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":50,"content":[{"text":"Yawé mɨrayu'iwanikɨ pipitɨa ti'aitame menukake,","poem":1},{"text":"menayexei Rawiri meta nuiwarimama","poem":2},{"lineBreak":true},{"text":"pɨkawahayewa yuheyemekɨ wanaki'erietɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/17.json","previousChapterAudioLinks":{},"numberOfVerses":50}