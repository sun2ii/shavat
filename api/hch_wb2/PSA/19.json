{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":19,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari hetsiemieme. Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Muyuawi taheima muyema hetsie pɨmatsiɨkɨ Kakaɨyari kemɨtimariwe,","poem":1},{"text":"mɨkɨkɨ pɨtihekɨata yumamakɨ kemɨtiutawewi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tukari xeime tukari yapɨtikuxaxatɨwa kemɨtiɨyɨ,","poem":1},{"text":"tɨkari xeime tɨkari yapɨrahɨawe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tsepa memɨkatexatawawe,","poem":1},{"text":"tsepa waniuki mɨkayu'eniɨriɨkɨ,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"naitsarie kwiepa kaniwaku'eiyani,","poem":1},{"text":"waniuki kwie manu'axe kaniye'axeni.","poem":2},{"lineBreak":true},{"text":"Kakaɨyari muyuawitsie tau","poem":1},{"text":"kiiya kaniukawewieni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mɨkɨ yukiita kaniwayeyeikani neneɨkeme hepaɨ tiyutemawietɨ,","poem":1},{"text":"waukawa yutemawietɨ yeikame hepaɨ, kaneyeikani yuhuyeta.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Muyuawi panakuyeika xeitaparitsie","poem":1},{"text":"'umietɨta xeitaparitsie pɨta kaneukayuyuipikeni,","poem":2},{"lineBreak":true},{"text":"yunaime waxɨriwiyatɨ xeime kahayewatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yawé tɨratuya 'aixɨa kani'aneni:","poem":1},{"text":"hekwame tukari katiniyupitɨwani.","poem":2},{"text":"Yawé 'aitsikaya hetsie yuri mɨti'erie 'aixɨa kaniyurieka:","poem":1},{"text":"'atsimɨkatimate timaiweme kanayeitɨwani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yawé kemɨti'aita kaniheitserietɨni:","poem":1},{"text":"'iyari kanitemawieritɨaweni.","poem":2},{"text":"Yawé niukieya kanihekɨaka:","poem":1},{"text":"hɨxite hauneniereme kanayeitɨwani.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yawé xɨka temakaxeni 'aixɨa kani'aneni:","poem":1},{"text":"yuheyemekɨ kani'ayumiemetɨni.","poem":2},{"text":"Yawé kemɨranutahɨani kaniyuritɨni:","poem":1},{"text":"naitɨ kemɨtiyuyuruwa kaniheitserietɨni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Matsi huru reuyeta pɨtiyunaki'erinɨa,","poem":1},{"text":"huru 'aixɨa mɨ'ane reuyeta,","poem":2},{"text":"matsi xiete reuyeta pɨrakaka,","poem":1},{"text":"xiete yuxɨrɨkatsie muhane hepaɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kɨmana tewi 'ahetsɨa mieme kanaye'eritɨariwani,","poem":1},{"text":"Kemɨ'ane memeye'atɨwa waɨkawa 'imikieri pepɨtiwakupitɨwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Xewitɨ 'apɨka'uyeika timaitɨ kename 'axatiyuriene.","poem":1},{"text":"Kenetineuyehɨwirieka titakɨ 'atsinemɨkatinemate.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Keneneuxɨna 'axanemɨtiyurienekɨ nemɨtiyukatawe'eriekɨ,","poem":1},{"text":"pepɨkanetsipitɨaka mɨkɨ 'axamɨti'ane mɨnetsikuyuitɨwanikɨ.","poem":2},{"text":"Mɨpaɨ nehetsie pɨkarahɨiwani","poem":1},{"text":"meta nepɨka'imɨiriyani 'axamɨti'ane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"'Ekɨ kenenaki'erieka,","poem":1},{"text":"neniuki meta kenemɨtiku'eriwa,","poem":2},{"lineBreak":true},{"text":"Yawé, ne'ai meta pemɨnetsiwikweitsitɨwame.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}