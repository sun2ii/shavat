{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"¿Titayari nuiwarite mete'uyuti'ɨre,","poem":1},{"text":"meta teɨteri tixaɨtɨ mɨkatiyunaki'erie xeikɨa meteku'eriwa?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Te'aitamete mepeye'unie,","poem":1},{"text":"'itsɨkate Yawé mepɨkaha'eriwa","poem":2},{"lineBreak":true},{"text":"meta kemɨ'ane manayexeiyarie hepaɨtsita.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mɨpaɨ mekaniutiyuaneni: «Tepɨa kaunariyari tepɨtitekixɨani.","poem":1},{"text":"Yuku hetsɨana mieme tepuku'eirieni».","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Muyuawitsie ti'aitame kaniutanaweni,","poem":1},{"text":"Yawé kaniwa'atseni wananaimatɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yuhaxɨakɨ pɨwarayehɨtɨwa,","poem":1},{"text":"Ha'atɨ pɨwarutate'a mɨpaɨ 'utaitɨ:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"«Ti'aitame nekananukakeni","poem":1},{"text":"Tsiyuni nehɨri mɨpatsie hetsie».","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ne Yawé 'aitsikaya nepɨtaxata:","poem":1},{"text":"«'Ekɨ pepɨneniwe», pɨnerahɨawe,","poem":2},{"lineBreak":true},{"text":"«Hikɨri nekamaniutinuiwitɨani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kenetineutawawiri,","poem":1},{"text":"nepɨmatiyetuirieni, nuiwarite nepɨmatsiyetuirieni,","poem":2},{"lineBreak":true},{"text":"'ahetsiemieme pɨrayani naitɨ kwie manuye'atɨka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mana pekatinita'aitamɨkɨ tepɨa 'itsɨyari pe'akwetɨ,","poem":1},{"text":"pekaniwatitaramɨkɨ haxu xariteyari hepaɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Xeme te'aitamete, xekenayeneniereni,","poem":1},{"text":"xekeneyuwaɨriyani xemɨte'ɨkitɨariekakɨ, kwiepa xemɨ'itsɨkate.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yawé xekenayexeiyani xeheyemakatɨ,","poem":1},{"text":"xeyutemamawietɨ xekenenɨawani.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yaxeketenekahuni, kapa 'uyeha'anikɨ","poem":1},{"text":"kapa xe'ukwinikɨ huyeta,","poem":2},{"lineBreak":true},{"text":"mɨkɨ yapauka kaniuyeha'arɨweni.","poem":2},{"lineBreak":true},{"text":"'Aixɨa meke'itɨarieka kemɨ'ane memɨyu'awieta hetsɨana.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}