{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":20,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Yawé, kemetsi'uta'eiya kepauka pemɨ'a'uximatɨa,","poem":1},{"text":"Kakuwu Kakaɨyarieya kemetsi'ɨwiyani.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kemetsi'uparewieni yutukita 'ayekaitɨ,","poem":1},{"text":"Tsiyunitsie paitɨtɨ kemetsi'uparewieni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Amawarika naime keha'eriwani,","poem":1},{"text":"mawari taiyariyari kemetsinaki'eririeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"'A'iyarikɨ tita pemɨreuyehɨwa kemetiyetuirieni,","poem":1},{"text":"kepemɨtiku'eriwa kepemɨtiyurimɨkɨ yaketiuyɨni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tame tepuyutemamawieka kepauka pemɨrayu'iwa,","poem":1},{"text":"takakaɨyari hetsiemieme","poem":2},{"lineBreak":true},{"text":"tapatera teikɨ tenetseraxɨakuni.","poem":2},{"text":"Yawé naime kemetiyetuirieni tita pemɨrewawiriwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Hikɨ mɨpaɨ nepɨtimate Yawé ti'aitame menayexei pɨtawikweitsitɨani,","poem":1},{"text":"pita'eiya muyuawi mɨpatsietsie paitɨ","poem":2},{"lineBreak":true},{"text":"yutɨrɨkariyakɨ memamariwaweme pɨwara'iwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mɨkɨ yukaxetate kuyaxa miemetsie mekaneuwawaɨreni,","poem":1},{"text":"'iyata yukawayutsixi 'amemɨpapa wahetsie mekaneuwawaɨreni,","poem":2},{"text":"peru tameta","poem":1},{"text":"takakaɨyari Yawé hetsie tekaneuwawaɨreni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mɨkɨ mekana'iwarɨwani meta mekanatixɨrɨweni,","poem":1},{"text":"peru tame tepanuku'uwe, 'atepɨti'u.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yawé, keneupitɨa ti'aitame mɨrayu'iwakɨ.","poem":1},{"text":"Kepauka temetsitahɨawe ketaneku'eiyani.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}