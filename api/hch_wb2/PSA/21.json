{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":21,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Ti'aitame puyutemawie 'atɨrɨkariyakɨ, Yawé.","poem":1},{"text":"Waɨkawamekɨ puyutemawie pemiparewiekɨ mɨrayu'iwakɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pepeye'atɨiri tita yu'iyarikɨ mɨreuyehɨakai,","poem":1},{"text":"pepɨkatitikweriri tita mɨra'iwawakai.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pepenukunakixɨ 'aixɨa pe'iyurietɨ waɨkawamekɨ,","poem":1},{"text":"kuruna pepenaketsiri huru 'aixɨa mɨ'anekɨ wewiyakame.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tukari pɨmetsi'utawawiri, 'ekɨ pepiyetuiri:","poem":1},{"text":"tukari waɨkawame meta 'atiteriweme.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Pemiparewikɨ waɨkawa tɨrɨkaɨyetɨ payeitɨarie,","poem":1},{"text":"waɨkawa mariweme pepayeitɨa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hetsiena mieme haixa kemɨtiuneika mɨpaɨ 'aixɨa pepiyurie,","poem":1},{"text":"pemiteɨtakɨ waɨkawa puyutemawie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ti'aitame Yawé hetsie kaneuwaɨreni,","poem":1},{"text":"'Amutewi naki'eriyayatsie,","poem":2},{"lineBreak":true},{"text":"'ayumieme hatsuaku pɨka'atiweni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"'Atɨrɨkariyakɨ kemɨ'ane memɨmetsi'aye'unie yunaime pepɨwatiwiya,","poem":1},{"text":"'atseriekɨ pekaniwa'aximɨkɨ kemɨ'ane memɨmetsi'uxie.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yawé, kepauka 'ekɨ pemuyuhekɨata,","poem":1},{"text":"huxunu mɨtaka hepaɨ me'anekame pekaniwarayeitɨamɨkɨ.","poem":2},{"lineBreak":true},{"text":"Yuhaxɨakɨ Yawé kaniwareuyehɨamɨkɨ,","poem":1},{"text":"tai kaniwatixɨtsitɨamɨkɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yunaime 'ena kwiepa waniwema pepɨwarakuyeitɨani,","poem":1},{"text":"yunaime nuiwarite watsata 'ena memu'uwa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tsepa memiwautɨwe kehepaɨ memɨmetekwinitɨanikɨ","poem":1},{"text":"tsepa memuyukapiniriwa 'ahepaɨtsita,","poem":2},{"lineBreak":true},{"text":"mɨkɨ yamepɨkateyurieni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Peru kepauka 'ekɨ pemɨwata'unieni 'atupikɨ","poem":1},{"text":"mɨkɨ mekanitanautsaxɨakuni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yawé, 'atɨrɨkariya keneuhekɨata,","poem":1},{"text":"tameta nɨawari 'ahetsiemieme tepɨtikwika, waɨkawamekɨ pemɨre'a'iwakɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}