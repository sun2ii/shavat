{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":22,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Kemanɨyɨne «Maxa 'uka muxei kahekɨarirɨmekaku» mɨpaɨ ketiukwikarieni. Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Nekakaɨyari 'aku, nekakaɨyari 'aku,","poem":1},{"text":"¿titayari penetiuku'eiri?","poem":2},{"text":"Teewa pepuwe kepenetiuwikweitsitɨani,","poem":1},{"text":"'ateewa paitɨ neniuki, mɨkaha'eniɨriɨkɨtsie neputatsuaka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nekakaɨyari, tukarikɨ nemetsihahiwiwa 'ekɨta pepɨkanetsiheku'eiya,","poem":1},{"text":"tɨkarikɨta yaxeikɨa nemetikɨhɨawetɨ nepɨka'uxipie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"'Ekɨ matsi pepɨpatsie, 'ekɨ pepɨti'aitame,","poem":1},{"text":"'ekɨ 'ixaheritsixi pepɨwakwikari.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ta'ukiyarima 'ahetsie mepɨtewiyakai,","poem":1},{"text":"'ahetsie yuri mepɨte'eriekai, 'ekɨta pepɨwaruxɨnaxɨ,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"mepɨmetsi'utahiwi, 'ekɨta pepɨwarutawikweitsitɨa,","poem":1},{"text":"'ahetsie mepɨte'uwiyaxɨ, 'ekɨta pepɨkawarexɨri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ne matsi nepɨkatewi, kwitsi nepɨhɨkɨ,","poem":1},{"text":"teɨteri waɨkawa mepɨnetsiyuriya,","poem":2},{"lineBreak":true},{"text":"yunaitɨ teɨteri mepɨnetsixani'erie.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yunaitɨ memɨnetsixeiya, meputinawe,","poem":1},{"text":"mepɨnetsi'utate'a, yumu'u me'utitsiketɨ:","poem":2}]},{"type":"verse","number":8,"content":[{"text":"«'Ikɨ Yawé hetsie yuri katini'erieka,","poem":1},{"text":"kamɨtsɨ Yawé ke'itawikweitsitɨani.","poem":2},{"text":"Metsɨ mɨkɨ hetsie xeikɨa kaniyukɨhɨaweni,","poem":1},{"text":"mɨkɨ matsi ke'ixɨna».","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Matsi 'ekɨ nemaama hetsie pepɨnetsiyenuiwitɨa,","poem":1},{"text":"nemaama hetsie pepɨnetsi'ukute,","poem":2},{"lineBreak":true},{"text":"'ahetsie neyɨkɨhɨaweme pepɨnetsi 'ayeitɨa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nekatinuiwawekaku 'akuxi","poem":1},{"text":"'ekɨ pepɨnetsi'ɨwiyakai,","poem":2},{"text":"nemaama hetsie neyekaiku paitɨ,","poem":1},{"text":"'ekɨ pepɨnekakaɨyari.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hawaikɨ, pepɨkanetsi'uku'e'eiriwani,","poem":1},{"text":"karikɨ 'uximatɨarika 'ahurawa kaniuyeikani,","poem":2},{"lineBreak":true},{"text":"xewitɨ pumawe mɨnetsiparewienikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Memɨnetsi'aye'unie yuwaɨkawatɨ ne'aurie mepa'utɨka,","poem":1},{"text":"mekaniti'uka metɨrɨkawitɨ turutsixi Watsani kiekatari wahepaɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nehetsiemieme meputikwaxawa,","poem":1},{"text":"mayetsi memuyuti haxɨatɨwa hepaɨ wai metatsanake.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Haa hepaɨ netukari pɨtayeuriwe,","poem":1},{"text":"ne 'umete naitɨ pɨxɨxɨni.","poem":2},{"text":"Ne 'iyari xɨrɨka hepaɨ 'anetɨ patɨa,","poem":1},{"text":"netaɨta witsɨanitɨ puhane.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Netɨrɨkariya haxu hepaɨ puwa,","poem":1},{"text":"neneni pukuwewerike.","poem":2},{"lineBreak":true},{"text":"Mɨkite watsata pepɨnetsi'ukateukixɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tsɨikɨri tixaɨtɨ memɨte'anukuweiya hepaɨ mepɨnetsi'anutinama,","poem":1},{"text":"'axateyuruwamete mekaneniuweiyani,","poem":2},{"lineBreak":true},{"text":"nemamatetsie mekaneneukeixɨani meta ne'ɨkatetsie.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Naime ne'umete nemuti'inɨata nepɨyɨwe,","poem":1},{"text":"teɨteri mekani'axeni menetsixeiyake","poem":2},{"lineBreak":true},{"text":"wa'iyari 'aixɨa mɨ'anekɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ne'ixurikite mepɨyutahuritɨa","poem":1},{"text":"meta mekaniyuta'iwa ne'ixɨrikikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Yawé, peru 'ekɨ 'ateewa pepɨkaheyeikani,","poem":1},{"text":"pemɨnetɨrɨkariyakɨ, kwitɨwa kenaye'a pemɨnetsiparewienikɨ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Netukari keneutawikweitsitɨa 'ixiparakɨ ne'umierienikɨ,","poem":1},{"text":"netukari witsimɨ'ane, tsɨikɨri memɨtɨrɨkawi wahetsɨa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mayetsi wateta kenenewayehani,","poem":1},{"text":"tuurutsixi menetsi'utsikɨpakɨ keneneutawikweitsitɨa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ne'iwama nepɨtiwataxatɨani kepemɨtiuka'iyari,","poem":1},{"text":"'ahetsɨa miemete memayuxeɨrie watsata ne'uwetɨ nepɨmetsitanɨawa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yawé xekenenɨawani kemɨ'ane xemeyemakaxe.","poem":1},{"text":"Mariweme xekenayeitɨaka, Kakuwu niwemama.","poem":2},{"lineBreak":true},{"text":"Xekenayexeiyani, 'ixaheri nuiwarimama.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mɨkɨ mɨkatiuyukaxani'eriekɨ meta tixaɨtɨ mɨkarexeiya","poem":1},{"text":"kemɨtiuka'eniwa mɨka'ixeiya xeikɨa,","poem":2},{"text":"hɨxiena pɨkayuti'awiwieta,","poem":1},{"text":"matsi kani'enieka, kepauka mɨkɨ maniuka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"'Ekɨ yapepɨnetikuyuitɨwa kenemɨtiukwika yuwaɨkawame wahɨxie,","poem":1},{"text":"kemɨ'ane memɨmetsi'ayemakaxe wahetsie, nepeye'atɨani kenemutayɨ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Tixaɨtɨ memɨkateheuxeiya mepɨtekwani, mɨkɨ mepɨtihuxani,","poem":1},{"text":"Yawé mepɨtanɨawa kemɨ'ane memikuwautɨwe,","poem":2},{"lineBreak":true},{"text":"wa'iyari ke'ayeyurini yuheyemekɨ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Yawé mekanaye'erikuni, hetsɨana mekani'axɨakuni","poem":1},{"text":"yunaitɨ kwie manuye'atɨkatsie paitɨ memɨtama,","poem":2},{"lineBreak":true},{"text":"hɨxiena mekanikatunuma'uikuni","poem":2},{"lineBreak":true},{"text":"yunaitɨ kwiepa memɨtama wanuiwarima.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Karikɨ Yawé katini'aitametɨni,","poem":1},{"text":"yunaime nuiwarite katiniwa'aitɨaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Yunaitɨ kwiepa waɨkawa memɨtehexeiya mekaniyutitemamawikuni meta hɨxiena mekanikahɨxima'uikuni,","poem":1},{"text":"hɨxiena mekanikatunuma'uikuni yunaitɨ memukwi,","poem":2},{"lineBreak":true},{"text":"yunaitɨ tukari memɨyupitɨani memɨkayɨwawe.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Teɨteri 'imatɨrieka miemete mekaneyexeiyakakuni,","poem":1},{"text":"kemɨ'ane memu'uwani 'uxa'atɨni warie Tati'aitɨwame mekanikuxaxatɨariwakuni.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Teɨteri memɨkatinunuiwawe 'akuxi","poem":1},{"text":"mepɨtetaxatɨarieni Kakaɨyari heitseriekamekɨ kemɨtiuyuri.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}