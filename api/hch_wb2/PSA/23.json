{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":23,"content":[{"type":"hebrew_subtitle","content":["Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Yawé netsihɨweme kanihɨkɨtɨni, tixaɨtɨ nepɨkareuyehɨwa,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"makutsiɨraɨyetsie kaneniuka'uxipitɨwani.","poem":2},{"text":"Haa kayuwatɨ mɨtimatsie kaneni'atɨwani,","poem":1}]},{"type":"verse","number":3,"content":[{"text":"tawarita pɨnetsitɨrɨkariya hekwamekɨ.","poem":2},{"text":"Huye mɨheitserie 'utɨa kaneniuwitɨximeni","poem":1},{"text":"mɨpaɨ mɨkɨ 'aixɨa mɨtikɨhɨawarɨwanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mɨpaɨ tsepa kweriwa'anekɨa nemumie,","poem":1},{"text":"'uyɨwikaku tixaɨtɨ nepɨkareumakaxe,","poem":2},{"lineBreak":true},{"text":"'ekɨ nehamatɨa pemuyeikakɨ,","poem":2},{"text":"muxatsi wahɨweme 'itsɨya pemakwe'ekɨ 'ahetsie nepeuwaɨre.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"'Ekɨ 'ixɨarari pepɨnets