,"poem":1},{"text":"Kakaɨyari 'iwikweitsitɨwame hetsiena mieme heitseriemekɨ yakatiniyuriemɨkɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mɨpaɨ kani'aneni nuiwari kemɨ'ane mɨmetsi'ayexeiya,","poem":1},{"text":"kemɨ'ane memɨmetsikuwaɨtɨwe, Kakuwu Kakaɨyarieya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kitenie xekeneyuyepiexɨa,","poem":1},{"text":"'itupari meripaitɨ xemumiemete xekeneyuyepiexɨa,","poem":2},{"lineBreak":true},{"text":"Ti'aitame witsimɨ'ane kaneutahamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"¿Kemɨ'ane mɨkɨ Ti'aitame witsimɨ'ane pɨhɨkɨ?","poem":1},{"text":"Yawé, mɨtɨrɨkaɨye meta mɨrayu'iwa,","poem":2},{"lineBreak":true},{"text":"Yawé, kwinimieme mɨreuyutamiewe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kitenie xeketeneuyepiexɨa,","poem":1},{"text":"'itupari meripaitɨ xemumiemete xekeneyuyepiexɨa,","poem":2},{"lineBreak":true},{"text":"Ti'aitame witsimɨ'ane kaneutahamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"¿Kemɨ'ane mɨkɨ Ti'aitame witsimɨ'ane pɨhɨkɨ?","poem":1},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye kanihɨkɨtɨni,","poem":2},{"lineBreak":true},{"text":"mɨkɨ Ti'aitame witsimɨ'ane kanihɨkɨtɨni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}