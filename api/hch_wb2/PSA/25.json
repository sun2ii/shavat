{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":25,"content":[{"type":"hebrew_subtitle","content":["Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"'Ekɨ, Yawé, ne'iyari nepɨmetsiyetuirie,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"nekakaɨyari, 'ahetsie yuri nepɨti'erie,","poem":2},{"text":"pepɨkanetsipitɨaka nemɨnanaimariekakɨ,","poem":1},{"text":"memɨnetsi'aye'unie pepɨkawapitɨaka memɨnetsiyuriyanikɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kemɨ'ane 'ahetsɨa mɨreutakwewie","poem":1},{"text":"hatsuaku pɨkatiyutewinɨani,","poem":2},{"text":"kemɨ'ane hipame memuwakwamana","poem":1},{"text":"mɨkɨ mepuyutitetewiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yawé, 'ahuye nemaikame kenenayeitɨa,","poem":1},{"text":"'ahuye kemɨreuyune keneneuxeitsitɨa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yuri pemainekɨ keneneuwitɨximeni meta peneti'ɨkitɨatɨ.","poem":1},{"text":"'Ekɨ nekakaɨyari pepɨhɨkɨ meta netsiwikweitsitɨwame,","poem":2},{"lineBreak":true},{"text":"tukarikɨ 'ahetsie timieme nepɨtitakwewie.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yawé, kenaye'eri kewitsipemɨtiuka'iyari, waɨkawa kepemɨti'akanaki'erie,","poem":1},{"text":"yuheyemekɨ kepemɨnetixeitsitɨa,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'axakenemɨtiuyuri kenatɨmaiya","poem":1},{"text":"'aitsika nemeutitsanaxɨakɨ temaikɨyari.","poem":2},{"text":"Kenenaye'eri kepemɨti'akanaki'eriekɨ,","poem":1},{"text":"'ekɨ Yawé 'aixɨa pemɨtiuka'iyarikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yawé 'aixɨa pɨtiuka'iyari meta kemɨtiheitseriekɨ pɨtiyuriene,","poem":1},{"text":"'Ayumieme 'axateyuruwamete huye pɨwaxeitsitɨa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mɨkɨ tixaɨtɨ memɨkate'ayuyeitɨa 'aixɨa 'anemekɨ kaniwaruwitɨximeni,","poem":1},{"text":"meta yuhuye kaniwa'ɨkitɨaka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Naitɨ Yawé huyeya kaninaki'eriyatɨni meta kaniyuritɨni,","poem":1},{"text":"kemɨ'ane 'aitsika memaye'atɨwa meta tɨratuya.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Aixɨa pemɨtikɨhɨawarɨwanikɨ Yawé,","poem":1},{"text":"Kenetineuyehɨwiri waɨkawa 'axakenemɨtiuyurikɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"¿Kemɨ'ane tewi Yawé payemakaxe?","poem":1},{"text":"Mɨkɨ huyeta 'aixɨa 'anemekɨ kaniyewitɨkiemɨkɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Aixɨa 'anemekɨ kaniuyeikamɨkɨ,","poem":1},{"text":"wanuiwarimata kwie mekaniyetuiriyariekuni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yawé puwanaki'erie kemɨ'ane memeyexeiya,","poem":1},{"text":"meta yutɨratu kaniwahekɨatsitɨiyani.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ne Yawé xeikɨa nepayexeiya,","poem":1},{"text":"mɨkɨ xeikɨa winiyaritsie mɨnetsi'uxɨna mɨyɨwekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nehepa kenatanieri keneneuxeiya, kenenenenimayaka","poem":1},{"text":"nexaɨtame nepuyeika, 'uximatɨarika nehexeiyatɨ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ne'iyaritsie 'uximatɨarika puyumɨiriya,","poem":1},{"text":"mɨyanemɨtiuka'eniwakɨ keneneɨxɨna.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ne'uximatɨarika keneuxeiya meta kenemɨ'uximaya,","poem":1},{"text":"'axakenemɨtiuyuri naime kenanuyeitɨa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Neuxei memɨnetsi'aye'unie mepuyuwaɨkawari,","poem":1},{"text":"'uxiwe'erika mepexeiya nehetsie 'axamenetsiyurikutɨ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kenene'ɨwiyani nemɨkakumemieriwanikɨ, keneneutawikweitsitɨa,","poem":1},{"text":"pepɨkanetsipitɨaka nemɨtinetewinɨakakɨ,","poem":2},{"lineBreak":true},{"text":"'ahetsɨa nekaniyu'awietani.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nehetsie nunuwame kenehɨkɨtɨni, 'aixɨa nemɨtiuka'iyarikɨ meta heitserie nemuyeikakɨ,","poem":1},{"text":"'ahepaɨtsita nemeuta'ikwewakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Kakaɨyari, 'ixaheritsixi keniwarɨxɨna naimekɨ kememɨte'uka'eniwakɨ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}