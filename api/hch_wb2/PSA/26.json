{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":26,"content":[{"type":"hebrew_subtitle","content":["Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Yawé, heitseriemekɨ ketineuyuri nehetsiemieme,","poem":1},{"text":"ne 'aixɨa nepɨtiuyeika,","poem":2},{"lineBreak":true},{"text":"Yawé, 'ahetsie nepɨtiwiya nekahekawaɨtsetɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yawé, keneneutixeiyaxɨa keneneuta'inɨata,","poem":1},{"text":"netaɨta keneneu'iti meta ne'iyaritsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Waɨkawamekɨ kepemɨtiyukanaki'erie yanepɨre'eriwa,","poem":1},{"text":"meta yuri pemainetsie xeikɨa nepuyeika.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne memɨte'itawa nepɨkawatemawie,","poem":1},{"text":"meta kwamanarikakɨ memɨtekuxata wahamatɨa nepɨka'uyeika,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'axamemɨte'u'iyari wahamatɨa nemuyeikani nepɨxani'erie,","poem":1},{"text":"'aixɨa memɨkate'u'iyari wahamatɨa nepɨkayuxewi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Neheu'itiyatɨkaitɨ meta nehetsie karahɨiwakaku,","poem":1},{"text":"Yawé, 'amawari taiyame warita nepayeika,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"karima 'anɨawari ne'utakwitɨ,","poem":1},{"text":"meta naime mamariwawemekɨ kepemɨtiyuriene.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yawé, ne 'atuki waɨkawa nepɨnaki'erie,","poem":1},{"text":"hakewa mematsiɨkɨ witsikepemɨ'anekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kepauka nemɨmɨni,","poem":1},{"text":"'axateyuruwamete meta teyumiekate wahamatɨa pepɨkanetsi'inɨatani,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"teɨteri tumini memumana","poem":1},{"text":"'itarikakɨ me'e'iwaka wahamatɨa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne matsi 'aixɨa nepɨtiuyeika nehetsie pɨkarahɨiwa,","poem":1},{"text":"keneneɨxɨna kenenenenimayaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"'Ena kwiepa 'anepuwe,","poem":1},{"text":"meta yumɨiretɨ meyuxeɨriekaku Yawé hetsiemieme 'aixɨa nekanitayɨmɨkɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}