{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":27,"content":[{"type":"hebrew_subtitle","content":["Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Yawé nehekɨariwiwame kanihɨkɨtɨni meta netsiwikweitsitɨwame,","poem":1},{"text":"¿kemɨ'ane nepumakaxeni?","poem":2},{"text":"Yawé netukari mɨ'ɨwiya kanihɨkɨtɨni,","poem":1},{"text":"¿kemɨ'ane 'aku pɨnetsi'utimariutawe?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kepauka 'axateyuruwamete nehepa memahu","poem":1},{"text":"menetsika'unake,","poem":2},{"text":"kepauka memɨnetsi'aye'unie neneɨkixiwima memɨnetsimietɨwe,","poem":1},{"text":"mɨkɨ pɨta mekanetiwitseweni mekanekaxɨrɨweni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tsepa kuyaxi memɨnetsi'anutina,","poem":1},{"text":"ne'iyari pɨkatimani,","poem":2},{"text":"tsepa nehetsiemieme kuyaxa matɨa,","poem":1},{"text":"nematsi nepɨrawiyani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Xeime xeikɨa Yawé nepɨtiwawirie,","poem":1},{"text":"ne mɨkɨ xeikɨa nepuweiya:","poem":2},{"text":"Yawé kiita nemayekanikɨ","poem":1},{"text":"naime tukarikɨ kenemɨreutere ne'ayeyuritɨ","poem":2},{"text":"nemixeiyanikɨ witsikemɨ'ane Yawé","poem":1},{"text":"meta tukitana nemɨhekwariyarienikɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Metsɨ kepauka 'uximatɨarika tukariyari maye'ani","poem":1},{"text":"mɨkɨ kaneni'awietakamɨkɨ yukiita,","poem":2},{"text":"tukieya nehetsie kaninuakamɨkɨ,","poem":1},{"text":"'ateewa kanenakakemɨkɨ, 'ai heima paitɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nerayu'iwame kanenayeitɨamɨkɨ","poem":1},{"text":"memɨnetsi'aye'unie ne'aurie memahane wahɨxie,","poem":2},{"text":"tukitana kwikari nekanitimawiriemɨkɨ","poem":1},{"text":"meta nɨawari Yawé hetsiemieme nekanitikwikamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nehiwari keneu'eni, Yawé, kepauka nemetsihahɨawe,","poem":1},{"text":"keneneutinenimayata keneneuta'eiya.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne'iyari mɨpaɨ kanetinahɨaweni: «Nierikaya keneutiwawa».","poem":1},{"text":"Neta, Yawé, 'anierika nekaniwauneni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Pepɨkayu'awietaneni nehetsiemieme,","poem":1},{"text":"'ikɨ ti'a'uximayatsiriwame pepɨkahehɨpani pe'ihekatɨ,","poem":2},{"lineBreak":true},{"text":"'ekɨ netsiparewiwame pekanihɨkɨtɨni,","poem":2},{"text":"nexaɨtame pepɨkanetsikuhayeikawani meta pepɨkanetsi'uku'e'eiriwani,","poem":1},{"text":"Kakaɨyari netsiwikweitsitɨwame.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tsepanetɨ nepaapa meta nemaama memɨnete'uku'eiri,","poem":1},{"text":"Yawé pɨnetsitituni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yawé, 'ahuyeta keneneuwitɨximeni,","poem":1},{"text":"huye mɨheitserie 'utɨma keneneuwitɨximeni,","poem":2},{"lineBreak":true},{"text":"hipatɨ memɨnetsihupiekɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Pepɨkanetsiyetuayani memɨnetsi'aye'unie nehetsie memɨye'axɨanikɨ,","poem":1},{"text":"nehepaɨtsita menetsi'itatɨ mekananuku'uni","poem":2},{"lineBreak":true},{"text":"menetsinanaimakutɨ xeikɨa mekanenanutate'ani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Perutsɨ xeimekɨ yanepɨtimate:","poem":1},{"text":"Yawé naki'eriyaya 'akuxi nepɨxeiyani","poem":2},{"lineBreak":true},{"text":"'ena kwiepa memu'uwa wahamatɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Yawé kenetakwewieka,","poem":1},{"text":"kene'awaɨriyani, tɨrɨkariya kenexeiyani,","poem":2},{"lineBreak":true},{"text":"Yawé kenetakwewieka.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}