{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":28,"content":[{"type":"hebrew_subtitle","content":["Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Yawé, ne nepɨmatsihahɨawe, 'ekɨ nehetsie nunuwame pepɨhɨkɨ,","poem":1},{"text":"pemɨka'enani hepaɨ pepɨkayɨaneni,","poem":2},{"text":"xɨka pekanetsi'uta'eiya,","poem":1},{"text":"kanihekɨaka nekanimɨmɨkɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nehiwari kenanu'eni","poem":1},{"text":"kepauka 'ahetsɨa nemɨye'axetsie parewiya neheuyehɨatɨ,","poem":2},{"lineBreak":true},{"text":"kepauka Waɨkawa Muyepatsietsie nemamate nemeutatsetseratsie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pepɨkanetsihehanani 'axamemɨte'u'iyari wahamatɨa,","poem":1},{"text":"'axateyuruwamete wahamatɨa,","poem":2},{"text":"'aixɨa memutekuxata yuhepaɨ teɨteri wahamatɨa,","poem":1},{"text":"peru yu'iyaritsie 'axamɨti'ane metexeɨrietɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yaketiniwarupitɨa kememɨte'uyuri,","poem":1},{"text":"'axakememɨteyuriekaikɨ.","poem":2},{"text":"Kememɨte'u'uximayataxɨ mɨpaɨ ketiniwarupitɨa,","poem":1},{"text":"tita mɨtiwahetsiemieme.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yawé, kemɨtiuyuri mɨpaɨ memɨkateku'eriwakɨ,","poem":1},{"text":"meta tita mɨtiutawewi yutɨrɨkariyakɨ memɨkatematekɨ,","poem":2},{"text":"mɨkɨ kaniwaka'unamɨkɨ,","poem":1},{"text":"tawarita hatsuaku pɨkawaranuku'uitɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yawé witsiketikuxaxatsiwani,","poem":1},{"text":"nehiwari mu'enikɨ waɨkawa ne'iwawiriekaku.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yawé netɨrɨkariya kanihɨkɨtɨni meta nehetsie nunuwame,","poem":1},{"text":"ne'iyari hetsiena katiniwiyani,","poem":2},{"lineBreak":true},{"text":"mɨkɨ kaneniparewieka.","poem":2},{"text":"Ne'iyari kaniutitsukwakani temawierikakɨ,","poem":1},{"text":"ne'utakwitɨ pamɨpariyutsi nekanipitɨamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yawé yuteɨterima muwatɨrɨkariya kanihɨkɨtɨni,","poem":1},{"text":"meta kemɨ'ane pemenayexei pekaniwikweitsitɨaka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Ateɨterima keniwarutawikweitsitɨa, 'aixɨa keniwayurieka 'ahetsɨa miemete,","poem":1},{"text":"keniwaruwitɨximeni yuheyemekɨ muxatsi wahɨweme hepaɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}