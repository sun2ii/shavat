{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":29,"content":[{"type":"hebrew_subtitle","content":["Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"'Aixɨa xeketenahɨaweni Yawé, muyuawitsie xemɨte'i'uximayatsirie,","poem":1},{"text":"'aixɨa xeketenahɨaweni Yawé witsikemɨ'ane, kemɨtitɨrɨkaɨye.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Aixɨa xeketenahɨaweni Yawé witsikemɨ'ane mɨkɨ xeikɨa 'aixɨa mɨtikɨhɨawaruwanikɨ,","poem":1},{"text":"Yawé hɨxie xekenekahɨxima'uti tukitana mariweme xe'ayeitɨatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yawé hiwarieya haa heima kaniuyeikani,","poem":1},{"text":"Kakaɨyari witsimɨ'ane tɨranarieya kanayuaneni,","poem":2},{"lineBreak":true},{"text":"Yawé, haa heima waɨkawa 'uyuanekaku kaniuyeikani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yawé hiwarieya kanayuaneni tɨrɨkaɨyetɨ,","poem":1},{"text":"Yawé hiwarieya kanayuaneni mariwetɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yawé hiwarieya kariuxa kanititarani,","poem":1},{"text":"Yawé kariuxa Riwanu mieme kanititarani,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Riwanu hɨriyari tsikeru hepaɨ katiniutsunatsitɨwani,","poem":1},{"text":"Heximuni hɨriyari tuuru mɨkamaxiu hepaɨ katiniutsunatsitɨwani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yawé hiwarieya tai kanitanenetsitɨwani,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Yawé hiwarieya makumawe kaniutayuitɨwani,","poem":2},{"lineBreak":true},{"text":"Yawé makumawetsie Karetsi kaniutayuitɨwani.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yawé hiwarieya tuaxa kanitikatseni","poem":1},{"text":"meta hɨri metsekame kanikuhayeikawani,","poem":2},{"lineBreak":true},{"text":"tukitana yunaitɨ mɨpaɨ mekateniuhiwani: «'Aixɨa kani'aneni».","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yawé, wiyeritsie yu'uweni kanexeiyani,","poem":1},{"text":"Yawé yuheyemekɨ katini'aitani.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yawé yuteɨterima tɨrɨkariya kaniwapitɨaka,","poem":1},{"text":"Yawé yuteɨterima 'aixɨa kaniwayurieka kayuwatɨ wapitɨatɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}