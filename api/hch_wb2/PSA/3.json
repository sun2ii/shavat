{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["Rawiri nɨawarieya, kepauka muyuta'unaxɨ yuniwe hepaɨtsita 'Awitsaruni."]},{"type":"verse","number":1,"content":[{"text":"Yawé, mepɨyɨmɨire memɨnetsi'aye'unie,","poem":1},{"text":"mepuyuwaɨkawa nehɨxie memu'uwe,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"meteyumɨireta mɨpaɨ memutiyuane:","poem":1},{"text":"«Kakaɨyari pɨka'itawikweitsitɨani».","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Matsi 'ekɨ, Yawé, pepɨnetsiheutinama kuya kɨmana muyukunarɨma pehɨkɨtɨtɨ,","poem":1},{"text":"'ekɨ pepɨnexawatɨriya,","poem":2},{"lineBreak":true},{"text":"'ekɨ nemu'u pepanukunieritɨa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yawé neputahiwiwa kenemuyuane,","poem":1},{"text":"yɨhɨri mɨpatsie hetsie paitɨ pɨnetsiheta'eiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ne nepukahupu, nepeukukutsu nepanutaneniereta,","poem":1},{"text":"Yawé mɨnetsi'ɨwiyakɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mepɨkanetsi 'utimariuta kuyaxi memɨyuwaɨkakawa","poem":1},{"text":"memɨnetsi 'uweiya tsepa hakewa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yawé, xeiya.","poem":1},{"text":"Keneneutawikweitsitɨa, nekakaɨyari.","poem":2},{"text":"Wa'auritapa keniwareutiwaxɨa memɨnetsi'aye'unie.","poem":1},{"text":"'Axamemɨte'u'iyari watamete kenewaye'unaxɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yawé, wikweitsitɨarika pɨti'apiini,","poem":1},{"text":"'aixɨa ketineuyuri 'ateɨterima wahetsɨa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}