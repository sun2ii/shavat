{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":30,"content":[{"type":"hebrew_subtitle","content":["Kwikari yukie mieme. Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Yawé, 'aixɨa nepaineni 'ahetsiemieme, pemɨnetsi'anukuketɨakɨ,","poem":1},{"text":"memɨnetsi'aye'unie pemɨkawarupitɨakɨ memɨnetsi'atsenikɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yawé nekakaɨyari, parewiya nemetsi'utawawiri","poem":1},{"text":"'ekɨta 'aixɨa nereu'eriekame pepɨnetsi'ayeitɨa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yawé, 'ekɨ teukiyapa pepɨnetsihatiha,","poem":1},{"text":"tawarita pepɨnetsi'anutanieritɨa mɨkite watsata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yawé xekenenɨawani, xeme 'aixɨa xemɨte'u'uwa hetsiena mieme,","poem":1},{"text":"kemɨtipatsie xekenenɨawani.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Haxɨaya 'etsiwa xeikɨa katineutetereni,","poem":1},{"text":"peru yuhemekɨ pɨtiuyukanaki'erie.","poem":2},{"text":"Xɨka tɨkarikɨ tsuari xuaweni,","poem":1},{"text":"ximerita temawierika puxuaweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kepauka 'aixɨa nemɨtinemaikai, mɨpaɨ neniutayɨni:","poem":1},{"text":"«Hatsuaku nepɨkahatihɨiyani».","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yawé, 'ekɨ 'aixɨa pemɨtiuka'iyarikɨ,","poem":1},{"text":"'ateewa paitɨ pepɨnetsi'uti'awietaxɨ,","poem":2},{"text":"hikɨta pepuyuti'awietaxɨ,","poem":1},{"text":"neta nehɨxiyatɨ nepuyuhayewaxɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yawé, 'aixɨa pemɨtiuka'iyari, 'ekɨ nemetsihahiwiwa,","poem":1},{"text":"'ekɨ yemekɨ waɨkawa nemetsiwawirie.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"¿Tita pera'iwa xɨka ne ne'umɨni,","poem":1},{"text":"ne xɨka ne'ukateukieni?","poem":2},{"text":"¿Kamɨtsɨ tumuanari metitanɨawa,","poem":1},{"text":"yatɨni 'aniuki yuri maine tikuxataneni?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Neuxei, Yawé, kenenenenimayaka,","poem":1},{"text":"'Ekɨ kenehɨkɨtɨni netsiparewiwame, Yawé.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nehiwerika matsi neiya pepayeitɨa,","poem":1},{"text":"hiwerika kamixayari pepɨnetsi'anutihɨniri,","poem":2},{"lineBreak":true},{"text":"'ixɨararipa miemekɨ pepɨnetsi'utikemaritɨa,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"nemetsitanɨawakɨ, 'ahetsiemieme 'aixɨa nemainenikɨ,","poem":1},{"text":"ne kayuwatɨ nemɨka'umakakɨ.","poem":2},{"lineBreak":true},{"text":"Yawé nekakaɨyari, ne yuheyemekɨ pamɨpariyutsi nepɨmatsipitɨaka.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}