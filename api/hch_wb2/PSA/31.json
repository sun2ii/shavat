{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":31,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Yawé, 'ahetsɨa nepiwaune yu'awiwietame,","poem":1},{"text":"pepɨkanetsipitɨaka nemɨtiyutewinɨakakɨ,","poem":2},{"lineBreak":true},{"text":"heitserie pemexeiyakɨ, keneneuxɨna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kwi yemekɨ keneneu'eni,","poem":1},{"text":"yapauka penetsiparewienike kene'axeni.","poem":2},{"text":"'Ekɨ neterɨ 'amuyeyewa kenehɨkɨtɨni,","poem":1},{"text":"netɨrɨkariya netsiwikweitsitɨwame kenehɨkɨtɨni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Keneneuwitɨximeni, 'ekɨtsɨ nehetsie nunuwame pekanihɨkɨtɨni meta pemɨnetsikurarutɨiya,","poem":1},{"text":"keneneuwitɨximeni mɨkɨkɨ 'ahepaɨtsita 'aixɨa mɨraniuwanikɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Keneneɨxɨna memɨnetsi'aye'unie mepɨnetsi'uwiniyaxɨ,","poem":1},{"text":"'ekɨ nehetsie nunuwame pemɨhɨkɨkɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Amamatsie ne'iyari nepɨyetua,","poem":1},{"text":"Yawé, keneneutawikweitsitɨa, yuri Kakaɨyari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nepɨwaxani'erie kakaɨyarixi memɨwarayexeiya,","poem":1},{"text":"ne 'aku, 'ahetsie nepɨtiwiya, Yawé.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nepɨnetemawie yemekɨ 'anaki'eriyatsie,","poem":1},{"text":"'ekɨ ne'uximatɨarika pemuxeikɨ","poem":2},{"lineBreak":true},{"text":"meta ne'iyari 'uximatɨarikaya pemɨmatekɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Pepɨkanetsiyetua mɨnetsi'aye'unie hetsɨa,","poem":1},{"text":"matsi pɨta xaɨtsie pepɨnetsi'atɨa 'a'akuyeukaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yawé, kenenenenimayaka, nepɨ'uximatɨarie,","poem":1},{"text":"nehɨxite pɨtixɨxime kukuiniyakɨ,","poem":2},{"lineBreak":true},{"text":"meta ne'iyari, metatsiere newaiyari.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tukarikɨ yanepɨtiuka'eniwa,","poem":1},{"text":"wiiyari panuyekɨka tsuarikɨ xeikɨa,","poem":2},{"text":"nutuixiya netɨrɨkariya pɨtixɨtɨaxime,","poem":1},{"text":"ne'umeyari pɨtiweranaxime.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Memɨnetsi'aye'unie wahetsiemieme mɨyane'anekaku,","poem":1},{"text":"'atsieriwame nekanihɨkɨtɨni ne'aurie memutetɨka wahetsiemieme,","poem":2},{"text":"Nehamikuma mekanenimakaka,","poem":1},{"text":"kepauka kiekaritsie nemɨyeyeika mekanitananautsani.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mekanenatɨmaiya, nemumɨni hepaɨ,","poem":1},{"text":"xari mutatarixɨ hepaɨ nekani'aneni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yuwaɨkawatɨ 'axamekatenikuxatani nehetsiemieme:","poem":1},{"text":"«Nekanimaka naitsarie».","poem":2},{"text":"'Axeikɨa metiyaxeka kememɨnetemienikɨ mekateniutaxata,","poem":1},{"text":"mekanenimiekuni mekaniutiyuaneni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Yawé, netsietɨ 'ahetsie nekatiniwiyani,","poem":1},{"text":"mɨpaɨ nekaniutaineni: «'Ekɨ pepɨnekakaɨyari».","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Naitɨ netukari 'ahetsie katini'aneni,","poem":1},{"text":"memɨnetsi'aye'unie meta memɨnetsi'uweiya wahetsɨa keneneuxɨna.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Meti'uximayatsiriwame hetsie keyuhekɨare ke'aixɨa pemɨtiuka'iyari,","poem":1},{"text":"waɨkawa pemɨtiuyukanaki'eriekɨ, keneneutawikweitsitɨa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yawé, pepɨkawapitɨaka memɨnetsitewinɨanikɨ,","poem":1},{"text":"'ekɨ nemetsihahiwiwakɨ pemɨnetsiparewienikɨ.","poem":2},{"text":"Mɨkɨ pɨta mekete'uyutewinɨani 'axateyuruwamete,","poem":1},{"text":"teukiyapa keniwareukaxɨri.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Memɨte'itawa wateni kayuwatɨ keneupitɨa,","poem":1},{"text":"'aixɨa memɨte'u'iyari wahepaɨtsita memeuniukakɨ","poem":2},{"lineBreak":true},{"text":"meyutemamawietɨ, 'axame'utiyuatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Pɨmariwe ke'aixɨa pemɨtiuka'iyari,","poem":1},{"text":"witsipepɨtiwaxeiya kemɨ'ane memɨmatsi'ayemakaxe,","poem":2},{"text":"teɨteri wahɨxie 'aixɨa pepɨwayurie","poem":1},{"text":"kemɨ'ane 'ahetsɨa memuyu'awieta.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"'Ahɨxie me'u'uwakaku pepɨwa'ɨwiya","poem":1},{"text":"teɨteri 'axamemɨwayuriekɨ,","poem":2},{"text":"'Akiita pe'ayekaitɨ pepɨwa'ɨwiya","poem":1},{"text":"'axamemutiyuane wahepaɨtsita.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"'Aixɨa ke'itɨarieka Yawé,","poem":1},{"text":"nehetsiemieme yunaki'eriya mɨmariwe mɨyetuakɨ","poem":2},{"lineBreak":true},{"text":"kepauka kiekari 'anutinamiekaku nemuyeikakaitsie.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kepauka nemɨhɨxiyakaitsie mɨpaɨ neputayɨ:","poem":1},{"text":"«'Ari 'ahɨxie ne'uyeikatɨ nepɨwayehɨiya».","poem":2},{"text":"Peru pepɨnetsi'u'eni 'ekɨ kenemetiwawiriekai","poem":1},{"text":"kepauka parewiya nemetsi'utawawiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Yawé xekenenaki'erieka, yunaitɨ xemei'enie,","poem":1},{"text":"mɨkɨ kaniwa'ɨwiyani kemɨ'ane 'aixɨa mɨtiwamate,","poem":2},{"lineBreak":true},{"text":"kemɨ'aneta memuyuti'ɨre tita mɨtiwahetsiemieme yakatiniwarakapitɨwani.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Xekeneyuwaɨriyani, xekeneyukuha'aritɨa xemɨyɨwawenikɨ,","poem":1},{"text":"yunaitɨ kemɨ'ane Yawé hetsiemieme xemɨtetakwewie.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}