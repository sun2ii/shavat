{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":32,"content":[{"type":"hebrew_subtitle","content":["Rawiri nɨawarieya. Wa'ɨkitsika."]},{"type":"verse","number":1,"content":[{"text":"Keyutemawieka kemɨ'ane","poem":1},{"text":"'inɨari niukiyari heutitsanaxɨaka mɨreuyehɨwiyarie,","poem":2},{"lineBreak":true},{"text":"kemɨ'ane 'axatiuyurieka mu'itiya.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Keyutemawieka 'iya","poem":1},{"text":"kemɨ'ane Yawé 'atsimɨkarehɨawe kename 'axatiyuriene","poem":2},{"lineBreak":true},{"text":"meta 'iyarieyatsie kwamanarika mumawe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kepauka kayuwatɨ nemɨtiuya,","poem":1},{"text":"ne'umeyari kaniutixɨni","poem":2},{"lineBreak":true},{"text":"nemutatsuakakaikɨ tukarikɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Waɨkawa nekaheutɨrɨkaɨyetɨ nekanayani","poem":1},{"text":"taxarita xɨrikɨ ketemɨtetiweranare hepaɨ,","poem":2},{"text":"tukarikɨ tɨkarikɨ pemɨnetikwinitɨakaikɨ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Peru nekaniuyutahekɨata 'ahɨxie ke'axanemɨtiuyuri,","poem":1},{"text":"ke'axanemɨtiuyuri nepɨkamatiuti'awitsiri.","poem":2},{"text":"Mɨpaɨ nekatiniuyuhɨawe: «Nepitaxatɨani Yawé ke'axanemɨtiuyuri»,","poem":1},{"text":"'ekɨta pekanetineuyehɨwirieni naime ke'axanemɨtiuyuri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"'Ayumieme 'ahetsiemieme 'aixɨa memɨteyurie mepɨmatsihahɨawe,","poem":1},{"text":"kepauka memu'uximatɨarie,","poem":2},{"text":"tsepa haa 'amuparixɨ","poem":1},{"text":"mɨkɨ wahetsɨa pɨkaheuti'ani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Ekɨ nehetsie nunuwame pepɨhɨkɨ,","poem":1},{"text":"'ekɨ netsi'ɨwiyame pepɨhɨkɨ kepauka nemɨyekweriwa'itɨariene,","poem":2},{"lineBreak":true},{"text":"'ana kwikari pekanenipitɨamɨkɨ kenemɨrayu'iwaxɨ hetsiemieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yawé mɨpaɨ kanaineni:","poem":1},{"lineBreak":true},{"text":"«Ne petimaikame nekamenayeitɨamɨkɨ,","poem":1},{"text":"huye ke'aneme pemuweiyani ne nekamenixeiyatsitɨamɨkɨ,","poem":2},{"lineBreak":true},{"text":"ne nekamenita'ɨxatsitɨamɨkɨ, meta nekamenita'ɨwiyamɨkɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Muratsixi meta kawayutsixi wahepaɨ pepɨka'aneni,","poem":1},{"text":"memɨkatemaiwawe,","poem":2},{"text":"kepauka pemimaxiutatsie pirenuya 'utakekame xeikɨa kaniyɨweni,","poem":1},{"text":"'ahurawa pemehanakɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"'Axateyuruwamete wa'uximatɨarika tiwaɨkawatɨ pɨtiwatakwewie,","poem":1},{"text":"peru Yawé hetsie memɨtewiya","poem":2},{"lineBreak":true},{"text":"pɨwaranukanama yunaki'eriyakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Xekeneyutemamawieka xeme xehetsie mɨkarahɨiwa,","poem":1},{"text":"xekeneyutemamawieka Yawé hetsie,","poem":2},{"text":"xekeneutikwikani xeme xeyunaitɨ","poem":1},{"text":"xe'iyari mɨ'itiyatɨka.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}