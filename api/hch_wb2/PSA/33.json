{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"Yawé xekenenɨawani yutemawierima xeme xehetsie mɨkarahɨiwa,","poem":1},{"text":"'aixɨa memɨtekahu kaniwahetsiemiemetɨni Yawé hetsiemieme memutikwikanikɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yawé xekenenɨawani kanari hayuanekaku,","poem":1},{"text":"xekeneutikwikani xaweri hayuanekaku.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwikari hekwame hɨxiena xekeneutakwika,","poem":1},{"text":"xeketeneyuitɨaka xeyutemamawietɨ,","poem":2},{"lineBreak":true},{"text":"meta temawierika hiwariyari xekenewewieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yawé niukieya kaniheitserieka","poem":1},{"text":"'aixɨa katini'aneneni naime tita mɨtiutiwewi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yawé 'aixɨa mɨti'ane meta mɨtiheitserie katininaki'erieka,","poem":1},{"text":"naki'eriyaya kwiepa kanakɨnɨka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yawé niukieyakɨ muyuawi kaniuneni,","poem":1},{"text":"'iiyayakɨ xurawetsixi mekaniutixuawere.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mɨkɨ haramaratsie haa panatihanɨwe xarita,","poem":1},{"text":"meta xariteta haramara 'ameukatewa kanikuxexeɨriwani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yunaitɨ kwiepa xemɨtama Yawé xekenayemakaka,","poem":1},{"text":"yunaitɨ teɨteri mana kiekatari xekenayexeiyani,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"mɨkɨ 'utaniuku, naitɨ pɨtiune,","poem":1},{"text":"mɨkɨ tiuta'aitaku, naitɨ 'aixɨa pɨtiuyɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nuiwarite kwiepa memɨtama kememɨteyuriku Yawé pɨkawapitɨa memeye'atɨanikɨ,","poem":1},{"text":"ke'axamemɨteyuriku teɨteri pɨkawapitɨa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Peru Yawé kemɨtiyurimɨkɨ, yapɨtikɨyɨne yuheyemekɨ,","poem":1},{"text":"kemɨtiku'eriwa peye'atɨwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"'Iya nuiwari keyutemawieka Kakaɨyarieya Yawé mɨhɨkɨkɨ,","poem":1},{"text":"yuteɨterima mɨwaranayexei hetsiena mieme memɨhɨkɨtɨnikɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yawé muyuawitsie paitɨ pɨtaniere,","poem":1},{"text":"pɨwaxeiya yunaime teɨteri,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"mɨkɨ pɨwataxeiya yu'uwenitsie paitɨ 'akaitɨ,","poem":1},{"text":"yunaime teɨteri kwiepa memɨtama.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mɨkɨ pɨhɨkɨ yunaime 'iyari mɨwarutiwewiri,","poem":1},{"text":"kememɨteyurie naime pɨtimate.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ti'aitame pɨkayutawikweitsitɨwa tsepanetɨ kuyaxi yuwaɨkawame mɨwarexeiya,","poem":1},{"text":"meta tiyumemiwame kwinimieme mɨtiyɨwe waɨkawa mɨtɨrɨkaɨyekɨ pɨkatawikweni.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tixaɨtɨ pɨkatihɨkɨ kawayutsixi wahetsie teyukwitɨwetɨ temɨte'ayu'iwakɨ,","poem":1},{"text":"tsepa waɨkawa mɨtɨrɨkaɨye pɨkatiyuwikweitsitɨwa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Matsi Yawé pɨwa'ɨwiya memeyemakaxe,","poem":1},{"text":"naki'eriyayatsie memɨtewiya,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"kepauka memɨkwi'iwarɨmeni wahetsie kaninuaka,","poem":1},{"text":"kepauka haakaxa mayeikatsie, pɨkawapitɨa memɨkwinikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Yemekɨ 'aixɨa 'iyari Yawé hetsie tetewiyatɨ tepɨtetakwewie,","poem":1},{"text":"mɨkɨ tatsiparewiwame pɨhɨkɨ meta tahetsie nunuwame.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ta'iyari puyutemawie hetsiena mieme,","poem":1},{"text":"mɨpatsietsie temɨtewiyakɨ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yawé, 'anaki'eriya mɨmariwe, tahamatɨa yaketiuyeikani,","poem":1},{"text":"yemekɨ ketemɨte'itakwewie 'ahetsiemieme.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}