{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":34,"content":[{"type":"hebrew_subtitle","content":["Rawiri nɨawarieya, kepauka mɨtiu'ita mɨka'uka'iyarini hepaɨ 'anetɨ hayuyeitɨaka 'Awimereki hɨxie, wayehɨiyaka kemɨretɨa."]},{"type":"verse","number":1,"content":[{"text":"Yawé hepaɨtsita 'aixɨa neputaineni yuheyemekɨ,","poem":1},{"text":"netenikɨ yanepɨtinɨawani.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne'iyari Yawé pɨnɨawa,","poem":1},{"text":"nitixaɨtɨ memɨkate'ayuyeitɨa me'enaname meyutemawietɨ mepakɨne.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mariweme Yawé xekenayeitɨwani nehamatɨa,","poem":1},{"text":"teyuxewitɨ tepinɨawani kemɨtimariwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yawé nekaniutiwauni, mɨkɨta pɨnetsi'uta'ei,","poem":1},{"text":"waɨkawa nemakaku naime pɨnetiunawairi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yunaitɨ memehɨawe mekaniyutemamawieka mehekɨariwietɨ,","poem":1},{"text":"hatsuaku me'ayukatewiwiyatɨ mepɨkahakɨka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne tixaɨtɨ nekatihɨkɨtɨtɨ Yawé nekaniutahɨawe, mɨkɨ kaneniu'enieni,","poem":1},{"text":"kaneniɨxɨna naime kenemɨtiuka'eniwakai.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yawé niuki tuayameya tihɨweme kaneyenɨ'awani memeyexeiya mɨwa'ɨwiyanikɨ,","poem":1},{"text":"wa'aurie kaniuyeikani waparewienike.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Xeketeneuta'inɨata, xeketenetimati Yawé 'aixɨa kemɨtiuka'iyari,","poem":1},{"text":"xekeneyutemamawieka kemɨ'ane hetsiena xemuyu'awieta.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yawé xekenemakaka, xeme hetsɨana miemete xemɨpatsie,","poem":1},{"text":"neuxei yunaitɨ memeyemakaxe tixaɨtɨ pɨkatiwareuyehɨwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mayetsi tɨɨrixi mepɨtiweranare meta mepeuhaakakwiku,","poem":1},{"text":"peru kemɨ'ane Yawé memukuwautɨwe tixaɨtɨ pɨkatiwareuyehɨwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Xekenakɨni tɨɨri, xekeneneu'eni,","poem":1},{"text":"Yawé kehepaɨ mɨrayemakaxenikɨ nepɨtixeta'ɨkitɨani.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kemɨ'ane tukari meuyehuwa,","poem":1},{"text":"kemɨ'ane tukari witsi'anemetsie meuyeimɨkɨ,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"yuneni ke'upirenutɨani 'axamɨti'ane mɨkatikuxatanikɨ","poem":1},{"text":"meta yutenietsie ke'uwiere 'itarika mɨkatikuxatanikɨ,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'axatiyurienetɨ ketiuhayewa, 'aixɨa pɨta ketiyurieneni,","poem":1},{"text":"kayuwatɨ muyeikanikɨ keyumexɨitɨaka, mɨpaɨ xeikɨa ketiuyeikani.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yawé 'aixɨa memɨteyurie kaniwaxeiyani,","poem":1},{"text":"wanenewieri yapauka kani'enieka,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"'axamemɨteyurie Yawé pɨwaraye'unie,","poem":1},{"text":"kwiepa mɨwarakuyeitɨanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Wahetsie mɨkarahɨiwa Yawé mekanahɨaweni, mɨkɨta kaniwa'enieka,","poem":1},{"text":"kememɨte'uximatɨarie naimekɨ kaniwaparewieka.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kemɨ'ane yu'iyaritsie memɨte'uka'eniwa Yawé wa'aurie 'ahurawa kaniutiweni,","poem":1},{"text":"kemɨ'ane yu'iyaritsie memuyutsaipɨna kaniwarutawikweitsitɨwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Hetsiena mɨkarahɨiwa 'uximatɨarikaya pɨmɨire,","poem":1},{"text":"Yawé matsi naimekɨ kaniwaparewieka,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"'umeteya naime pɨ'ɨwiya,","poem":1},{"text":"nixeimetɨma pɨka'akamuriyarieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"'Axamɨti'ane 'axateyuruwamete pɨwaka'una,","poem":1},{"text":"wahetsie mɨkarahɨiwa memɨwaraye'unie mekananutaxɨriyakuni.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yawé te'i'uximayatsiriwamete wahetsie kaninuaka,","poem":1},{"text":"mepɨka'anutaxɨriyani hetsiena memɨtewiya.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}