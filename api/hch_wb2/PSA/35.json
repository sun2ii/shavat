{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":35,"content":[{"type":"hebrew_subtitle","content":["Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Yawé, nepumieriene, nehetsie keneutanua,","poem":1},{"text":"keniwarutakuya kemɨ'ane memɨnetsimietɨwe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tepɨa kamixayari kenanakatɨtɨ meta tepɨa 'amɨyewa","poem":1},{"text":"kene'akuha'aritɨaka nehetsɨa kenenua pemɨnetsiparewienikɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Apitsika keneutikwe'i meta 'ahatsa,","poem":1},{"text":"memɨnetsi'uweiya wahɨxie keneukexi.","poem":2},{"text":"Mɨpaɨ keneutayɨki:","poem":1},{"text":"«Ne 'awikweitsitɨwame nepɨhɨkɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Meke'uhɨxiyani meke'uyutitetewiya","poem":1},{"text":"kemɨ'ane memɨnetsimieku,","poem":2},{"text":"meke'ukunuaxɨani meyutetewiyatɨ","poem":1},{"text":"'axamemɨnetsiyuriku.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Ɨxa hepaɨ mekehe'enitsitɨarieni,","poem":1},{"text":"niuki tuayame Yawé hetsɨa mieme wakwinekaku,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"wahuyeta ke'uyɨwini meta ke'uharuanini,","poem":1},{"text":"niuki tuayame Yawé hetsɨa mieme waruweiyakaku.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nitixaɨtɨ wahetsiemieme nekarayexeiyakaku memɨnetsi'uwiniyaxɨkɨ,","poem":1},{"text":"nitixaɨtɨ wahetsiemieme nekarayexeiyakaku nehetsiemieme meputi'inixɨ,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"haweri me'anenetɨ 'uxa'atɨniwarie meke'akɨne,","poem":1},{"text":"yuwiniyarita mekeheukaxɨrieni,","poem":2},{"lineBreak":true},{"text":"putsu memitawewita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mɨpaɨ ne'iyari pɨtiyutemawieka Yawé hetsie,","poem":1},{"text":"puyutemawieka mutawikweitsitɨariekɨ,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'ana mɨpaɨ yemekɨ nepɨtayɨni:","poem":1},{"text":"«Xewitɨ pumawe 'ahepaɨ 'anetɨ Yawé.","poem":2},{"text":"'Ekɨ pepɨwawikweitsitɨa haweri memɨyɨa memɨtɨrɨkawi wahetsɨa,","poem":1},{"text":"haweri memɨ'anene meta tixaɨtɨ memɨkateheuxeiya pepɨwawikweitsitɨa","poem":2},{"lineBreak":true},{"text":"memɨtewa'uximayatsitɨa wahetsɨa».","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mete'itawatɨ menetsitaxanetake mepɨ'axe,","poem":1},{"text":"menetsita'iwawiyake tita 'atsinemɨkatimatekɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne newanenimayakaku 'axa'anemekɨ mepɨnete'akapitɨwa,","poem":1},{"text":"mɨkɨkɨ pɨnetsihekukukuine ne'iyaritsie,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"metsɨ kepauka mɨkɨ memɨtekukuyeni","poem":1},{"text":"ne hiwerika kamixayari nepanakatɨkɨkai,","poem":2},{"lineBreak":true},{"text":"nenutuixietɨ nepayeikakai nepɨnetihakiwakai.","poem":2},{"lineBreak":true},{"text":"Ne matsi nepɨnenenewiekai ne pɨta nemɨtikuyenikɨ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ne hiwerika kamixayari nepanakatɨkɨkai,","poem":1},{"text":"nehamiku hetsiemieme hepaɨ, yatɨni ne'iwa hetsiemieme hepaɨ.","poem":2},{"text":"Nenutuixietɨ nepakatutsitakai,","poem":1},{"text":"nemaama hetsiemieme nemutatsuakani hepaɨ ne'anetɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Peru kepauka ne nemekawe, mɨkɨ mepuyukatemamawi,","poem":1},{"text":"mepuyukuxeɨri nehepaɨtsita metekuxatatɨ.","poem":2},{"text":"Teɨteri ne nemɨkawamatekai,","poem":1},{"text":"mekaneniuyeheka nehepaɨtsita meniukixietɨ mekatehayewatɨ mekanakɨne.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Waɨkawa mepɨnetsimariutakai, mepɨnetsinanaimakai,","poem":1},{"text":"nehepaɨtsita yutamete meputixikautekekai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ti'aitame, ¿kepaukake 'ikɨ 'aixɨa pepɨtiyurieni?","poem":1},{"lineBreak":true},{"text":"Netukari keneutawikweitsitɨa, netukari muyuxewi,","poem":1},{"text":"mayetsi mepɨnetsitakwaixime.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ne pamɨpariyutsi nepɨmetsipitɨani yumɨireme wahɨxie,","poem":1},{"text":"yuwaɨkawame wahɨxie nepɨmetsitanɨawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Pepɨkawapitɨaka memɨnetsiyuriyanikɨ,","poem":1},{"text":"memɨnetsi'aye'unie meteyukwamanatɨ.","poem":2},{"text":"Memɨnetsinanaimaka pepɨkawapitɨaka","poem":1},{"text":"'atsinekawayurienekaku.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"'Aixɨa metekuxatatɨ mepɨka'u'uwa,","poem":1},{"text":"matsi 'itarika mepɨwewie","poem":2},{"lineBreak":true},{"text":"'ikɨ kwieyaritsie 'aixɨa memɨte'u'uwa wahepaɨtsita.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Karima meputinawe, meta mɨpaɨ meputiyuane:","poem":1},{"text":"«Neuxeitsɨkuta yaranuyetɨa».","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Yawé, 'ekɨ naime 'ikɨ pepɨtixeiya,","poem":1},{"text":"matsi pepɨkaranukanaka.","poem":2},{"lineBreak":true},{"text":"Ti'aitame, pepɨkanetsi'uku'e'eiriwani.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kenanutanieri, kenanukukexi nekakaɨyari.","poem":1},{"text":"Nehetsiemieme 'aixɨa ketineuyuri Ti'aitame, nehetsie keneutanua.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nehetsiemieme 'aixɨa ketineuyuri heitserie kepemɨrexeiya, Yawé nekakaɨyari,","poem":1},{"text":"memɨnetsinanaimaka pepɨkawapitɨaka.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Pepɨkawapitɨaka mɨpaɨ memɨteku'eriwanikɨ:","poem":1},{"text":"«Mɨpaɨ tepɨteheixeiyakukai».","poem":2},{"text":"Mɨpaɨta memɨtiyuani pepɨkawapitɨaka:","poem":1},{"text":"«Tepenukaxɨ yemekɨ 'ayeniereme».","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Meke'uyutitetewiya meta meke'u'iyɨrieni","poem":1},{"text":"yunaitɨ kemɨ'ane memuyutemamawie nemekawekɨ,","poem":2},{"text":"meke'utixani'eriwa mekeheutewiyarieka","poem":1},{"text":"yunaitɨ kemɨ'ane tixaɨtɨ memɨkanete'erie.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Peru meke'utihiwa temawierikakɨ","poem":1},{"text":"kemɨ'ane memɨnetsiparewie,","poem":2},{"text":"meta mɨpaɨ yuheyemekɨ meke'utiyuaneni: «Yawé 'aixɨa ketikuxaxatsiwani,","poem":1},{"text":"'iparewiwame 'aixɨa mɨtiuyeika minakekɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ne ke'aixɨa pemɨtiuka'iyari nepukuxataneni,","poem":1},{"text":"tukari mɨyehane 'ahetsiemieme kwikari nepukwikani.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}