{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":36,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Rawiri kwikarieya, Yawé parewiwameya."]},{"type":"verse","number":1,"content":[{"text":"'Axatiyuruwame mɨpaɨ kanaineni:","poem":1},{"text":"«Kakaɨyari neka'ayexeiyatɨ ne'iyaritsie paitɨ yanepɨ'ane».","poem":2},{"text":"Kemɨtixeiya Kakaɨyari","poem":1},{"text":"pɨkamakaxe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mɨpaɨ pɨtiku'eriwa kename 'aixɨa tiuka'iyari","poem":1},{"text":"'axamɨti'ane pɨkaxani'erie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yakɨ xeikɨa pɨtikuxata pɨtiyukananaima,","poem":1},{"text":"'aixɨa mɨti'ane kaneuyehɨani","poem":2},{"lineBreak":true},{"text":"meta 'aixɨa mɨtiyurienenikɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yu'utatsie kakaitɨ 'axamɨtiyurienikɨ xeikɨa pɨtiku'eriwa,","poem":1},{"text":"'axamɨ'ane huyeyari pɨkataunie,","poem":2},{"lineBreak":true},{"text":"'axamɨti'ane pɨkatiku'eiriwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yawé, 'anaki'eriya muyuawitsie paitɨ pɨye'axe,","poem":1},{"text":"kepemɨkatiyupata haitsie paitɨ pɨye'axe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kemɨtiheitserie 'ahetsɨa mieme hɨri 'amutɨtɨ hepaɨ pɨ'ane,","poem":1},{"text":"ke'aixɨa pemɨtiyuriene haramara mɨmariwe 'emeukatewa hepaɨ pɨ'ane.","poem":2},{"lineBreak":true},{"text":"Yawé, 'ekɨ pepɨwa'ɨwiya teɨteri meta yeuta memɨte'u'uwa,","poem":1}]},{"type":"verse","number":7,"content":[{"text":"witsipɨ'ane 'anaki'eriya mɨmariwe, Kakaɨyari.","poem":2},{"text":"Yunaitɨ teɨteri mepikaxexeiya memuyu'awietanikɨ","poem":1},{"text":"'a'anate 'etɨriyayatɨa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"'Akie meputihuxarɨwe naitɨ mɨtixuawekɨ,","poem":1},{"text":"'ahaa 'aixɨa ma'ane muwanake pepɨwaharitɨa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Ahetsie tukari mɨtiwiekɨ,","poem":1},{"text":"'Ahekɨariyapa te'u'uwatɨ hekɨariya temuxeiya tepɨyɨwawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kenewanaki'erieka kemɨ'ane memɨmetsimate,","poem":1},{"text":"heitserie memexeiya wahetsiemieme 'aixɨa ketineyurieneni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kwinimieme mɨtiyutamariwekata pɨkanetsitaketsinani,","poem":1},{"text":"Kakaɨyari mɨka'ayexeiya 'axamɨkanetsiyurienikɨ pepɨka'ipitɨaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Xekeniwaruxeiya kememɨtehekaxɨrɨwe 'axateyuruwamete:","poem":1},{"text":"Kepauka memekaxɨrɨwe kwiepa, tawarita memanuku'uni mepɨkayɨwawe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}