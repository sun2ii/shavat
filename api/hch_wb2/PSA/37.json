{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":37,"content":[{"type":"hebrew_subtitle","content":["Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Pepɨka'a'iyaritɨaka Kakayari memɨka'ayexeiya kememɨteyuriekɨ,","poem":1},{"text":"meta pepɨkatihiwe'erieka tita memɨtehexeiya heitseriemekɨ yamemɨkatekahu,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"yapauka mɨtiyɨnarekɨ tupiriya hepaɨ,","poem":1},{"text":"yapauka mepɨtiwauke 'ɨxa mɨtsitsiɨrawi hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"'Ekɨ Yawé hetsie ketinewiyani, 'aixɨa ketineyurieneni,","poem":1},{"text":"kwiepa keneuyeikani meta 'aixɨa ketinekamieni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yawé 'anaki'eriya keneyetuiri,","poem":1},{"text":"mɨkɨ pɨmetiyetuirieni tita pemɨreuyehɨwa 'a'iyarikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yawé 'ahuye kenehɨritɨaka,","poem":1},{"text":"hetsiena ketinewiyani, mɨkɨta yapɨtiyurieni 'ahetsiemieme.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mɨpaɨ kepauka pemɨtaxanetsieni 'aixɨa mɨti'ane 'ahetsie pɨhekɨariwieximeni,","poem":1},{"text":"keheitserie pemɨrexeiya pɨhekɨaka tuka hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kayuwatɨ pekaniukixietɨ keneuyeikani Yawé hɨxie,","poem":1},{"text":"petiuka'eniwatɨ hetsienamieme ketinetakwewieka,","poem":2},{"text":"Pepɨka'ahɨaweni hipatɨ kememɨte'ukaxexeiya wahetsiemieme,","poem":1},{"text":"kememɨteku'eriwa 'axamemɨteyurie wahepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ketineuhayewa peha'atɨ, keneuku'eiri haxɨa,","poem":1},{"text":"pepɨka'utaweranareni, mɨkɨ 'axamɨ'anetsie katiniyu'iniwani.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Karikɨ Kakaɨyari memɨka'ayexeiya mekanakumaweriyariekuni,","poem":1},{"text":"matsi kemɨ'ane Yawé hetsiemieme memɨtetakwewie, kwie mekaniyetuiriyariekuni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"'Apɨkareutereri 'axateyuruwamete memɨka'u'uwanikɨ,","poem":1},{"text":"tsepa 'aheyemekɨ pemɨwarutiwau pepɨkawataxeiya.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Peru kemɨ'ane kayuwatɨ memu'uwa kwie mekanimikiekuni,","poem":1},{"text":"yu'iyarikɨ 'aixɨa mekateniu'uwakuni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"'Axateyuruwamete 'aixɨa memɨte'u'uwa mepɨwaheka,","poem":1},{"text":"yutamete mekaniutixikautekeni wahetsiemieme.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Matsi Yawé kaniutanaweni 'axateyuruwamete wahetsiemieme,","poem":1},{"text":"timaitɨ watukari maye'aximekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"'Axateyuruwamete yu'ixipara mekanewatihapanani, yutupi mekanahapanani,","poem":1},{"text":"tixaɨtɨ mɨkarexeiya meta mɨreuyehɨwa memɨwaratixɨrienikɨ,","poem":2},{"lineBreak":true},{"text":"'aixɨa memɨte'u'uwa memɨwakwinikɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wa'ixiparatɨtɨ wa'iyaritsie kaniuyekemɨkɨ,","poem":1},{"text":"watupi kanitimurixɨamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"'Aixɨa pɨ'ane kemɨ'ane 'aixɨa mɨtiuka'iyari 'etsiwa xeikɨa rexeiyatɨ,","poem":1},{"text":"keyuri 'axateyuruwamete waɨkawa kememɨtehexeiya,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"matsi Kakaɨyari memɨka'ayexeiya watɨrɨkariya kaneutiparitɨariemɨkɨ,","poem":1},{"text":"peru Yawé heitserie memexeiya kaniwaparewimɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Yawé 'aixɨa memɨte'u'uwa watukari kani'ɨwiyani,","poem":1},{"text":"tita memɨteyetuiriyarieni pɨtiwahetsiemiemetɨni yuheyemekɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kepauka 'uximatɨarika tukariyari maye'ani mepɨtekaxeiya,","poem":1},{"text":"haakaxa tukariyaritsie waɨkawa mepɨtehexeiyani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"'Axateyuruwamete, Yawé memaye'unie,","poem":1},{"text":"mekanikumawerikuni kepauka memeuyehɨiyani.","poem":2},{"text":"Mekanikumawerikuni tuturi yeuta mieme hepaɨ,","poem":1},{"text":"kɨtsi kemɨtitaparike mɨpaɨ mekaniyɨkuni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"'Axamemɨte'u'iyari mekaniyuniɨrɨweni, peru mepɨkateyutuarita,","poem":1},{"text":"matsi heitserie memexeiya mepɨteyumikwa 'aixɨa 'anemekɨ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yawé 'aixɨa mɨwayurie, kwie mekaniyetuiriyariekuni,","poem":1},{"text":"peru kemɨ'ane mɨkɨ 'axamɨwayurie mekanikumaweriyariekuni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Yawé tewi kaniheitseritɨaka 'aixɨa 'anemekɨ mumienikɨ,","poem":1},{"text":"kepauka minake kemɨtiuyeikanikɨ,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"tsepa metiwitsei pɨkahekaweni,","poem":1},{"text":"Yawé yumamakɨ miwiyakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ne temaikɨ nepatɨa, hikɨri nepu'ukiratsi,","poem":1},{"text":"peru hatsuaku heitserie memexeiya haweri mɨraku'ane nepɨkawaxeiyawe,","poem":2},{"lineBreak":true},{"text":"meta waniwema paa hawaikɨ mepɨkahewauka.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Yuheyemekɨ meyutemamawietɨ 'aixɨa 'anemekɨ mepɨtewaniɨtɨa,","poem":1},{"text":"waniwema wahekɨ 'aixɨa mepɨ'itɨarie hipatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"'Axapetiyurienetɨ ketineuhayewa, 'aixɨa pɨta ketineyurieneni,","poem":1},{"text":"'ana yuheyemekɨ mana pepuyeikani hakewa pemekani.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Karikɨ Yawé 'aixɨa mɨti'ane katininaki'erieka,","poem":1},{"text":"meta pɨkawanutuita kemɨ'ane yu'iyarikɨ meminaki'erie.","poem":2},{"lineBreak":true},{"text":"Yawé kaniwa'ɨwiyakamɨkɨ yuhemekɨ,","poem":1},{"text":"peru 'axateyuruwamete wanuiwari kaniwarakumaweriyamɨkɨ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Heitserie memexeiya kwie mepɨyetuiriyarieni,","poem":1},{"text":"yuheyemekɨ mana mepu'uwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Heitserie mexeiya kemɨtimaiwe pɨtikuxata,","poem":1},{"text":"niukieya tita mɨtihetserie puweiya.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kakaɨyari 'aitsikaya 'iyarieyatsie kaniyekani,","poem":1},{"text":"hatsuaku mepɨkahekaxɨrɨwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"'Axamemɨte'u'iyari 'aixɨa memɨte'u'iyari,","poem":1},{"text":"mekaniwakuhupiwani mewakwikutɨ.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Peru Yawé pɨkawapitɨani yamemɨwayurienikɨ,","poem":1},{"text":"meta yapɨkaretanaki'erieni memanutaxɨriyanitsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Peru 'ekɨ, Yawé hetsie timieme ketinetakwewieka,","poem":1},{"text":"meta yaketineuyeikani kemɨtinake,","poem":2},{"lineBreak":true},{"text":"mɨkɨ kamenetemawieritɨamɨkɨ kwie pemɨyetuiriyarienikɨ.","poem":2},{"text":"Kepauka 'axateyuruwamete memɨka'unarieni,","poem":1},{"text":"'ekɨ pekaniwaxeiyamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Ne nepixei 'axatiyuruwame mariweme,","poem":1},{"text":"kariuxa hepaɨ ranukaime.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Matsi kaniukumawere,","poem":1},{"text":"nemitiwau nepɨka'itaxeiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Kwi keniwaruxeiyata 'aixɨa memɨtekahu:","poem":1},{"text":"tukari 'upamie kayuwatɨ memɨkuwautɨwe wahetsiemieme.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Peru yunaitɨ 'axateyuruwamete mekanikumaweriyariekuni,","poem":1},{"text":"tukari 'umamie 'axateyuruwamete wahetsiemieme memeuyehɨiyani tukariyari kanihɨkɨtɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Heitserie memexeiya wawikweitsitɨarika Yawé hetsie kanayeneikani,","poem":1},{"text":"mɨkɨ mɨwatɨrɨkariya kanihɨkɨtɨni kepauka memɨte'uka'eniwatsie.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Yawé kaniwaparewieka meta kaniwaxɨnani,","poem":1},{"text":"'axateyuruwamete wahetsie kaniwaxɨnani meta kaniwawikweitsitɨaka,","poem":2},{"lineBreak":true},{"text":"mɨkɨ hetsie mekaneuwawaɨreni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}