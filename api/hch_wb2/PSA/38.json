{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":38,"content":[{"type":"hebrew_subtitle","content":["Rawiri nɨawarieya, mawari hetsiemieme."]},{"type":"verse","number":1,"content":[{"text":"Yawé, kepauka pemɨha'a pepɨkanetsi 'utate'ani,","poem":1},{"text":"peha'atɨ pepɨkanetikwinitɨaka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'A'ɨrɨ nehetsie kaniuye'uniri,","poem":1},{"text":"nehetsie 'atɨrɨkariya kaniukaweni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Naitɨ newaiyari pɨtikuye pemɨha'akɨ nehepaɨtsita","poem":1},{"text":"hawaikɨ tɨma newaiyaritsie 'aixɨa nepɨkareu'erie,","poem":2},{"text":"waɨkawamekɨ 'axanemɨtiuyurikɨ,","poem":1},{"text":"ne'umete mɨyapɨtiuka'eniwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nepɨka'ikemari 'axamɨti'ane,","poem":1},{"text":"mɨkɨ 'ika kwinimieme pɨrahete.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nemɨka'uka'iyarikɨ","poem":1},{"text":"nehaiya kaniyepɨnirɨmeni 'axakaniukɨ'ɨareni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nepu'uxeri, waɨkawamekɨ nepɨnemuina,","poem":1},{"text":"tukarikɨ nenutuixietɨ nepuyeika.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Netaɨta nepɨta'a hɨiyakɨ,","poem":1},{"text":"naitɨ newaiyaritsie tɨma 'aixɨa nepɨkareu'erie.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nepɨwerani, nemehɨiyani hepaɨ nepɨreu'erie,","poem":1},{"text":"ne'iyari puta'aiwa tiuka'eniwatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ti'aitame, nepɨmetsiyetuirie yemekɨ tita nemɨreuyehɨwa,","poem":1},{"text":"'ekɨ 'ahepaɨtsita pɨkati'awietɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kwinimieme pɨtiɨtɨrarɨka ne'iyari,","poem":1},{"text":"nepɨkaheutɨrɨkaɨyeri,","poem":2},{"lineBreak":true},{"text":"'ari nepɨkaniereri.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nehamikuma meta memɨnetsimate nehaiya mekanimakaxeni,","poem":1},{"text":"ne'iwama 'ateewa xeikɨa mekaniu'uwani.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Winiyari mekaniuwɨwɨtɨwani memɨnetsimieku,","poem":1},{"text":"kemɨ'ane 'axa'anekɨa memɨnetsihɨaku mepɨkatehayewa yameteku'eriwatɨ,","poem":2},{"lineBreak":true},{"text":"tukarikɨ nehetsiemieme xeikɨa mepɨtekuxata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Peru ne mɨkaheu'ena nepaneyeitɨwa, nepɨkawa'enie,","poem":1},{"text":"nekaniuweme nepaneyeitɨwa, 'atsinepɨkatiwaku'eiya.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Memɨkaheu'enana wahepaɨ nepɨ'ane","poem":1},{"text":"meta memɨyɨkɨhɨani memɨkayɨwawe wahepaɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yawé, ne nepɨmetsitakwewie,","poem":1},{"text":"'ekɨ neti'aitɨwame, nekakaɨyari, 'ekɨ pepɨyɨaneni nehetsiemieme pemɨwata'eiya.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nepɨmetsiwawirie xeikɨa mepɨkanetsinanaimaka,","poem":1},{"text":"memamariwaweme mepɨka'ayuyeitɨaka kepauka nemekawenitsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"'Ari nekanimɨximeni,","poem":1},{"text":"kukuiniya pɨkanetsihayewa 'etsiwatɨma.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ke'axanemɨtiuyuri nepɨnetahekɨata,","poem":1},{"text":"'axamɨti'ane pɨnetsi'iyarimɨtsitɨa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mepɨyumɨire 'itarikakɨ memɨnetsi'aye'unie,","poem":1},{"text":"yamepɨte'ane memɨnetsi'aye'unie nitixaɨtɨ karanierekaku.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"'Aixɨa nemɨtiyurienekɨ, 'axa'anemekɨ mepɨnete'akapitɨwa,","poem":1},{"text":"'aixɨa mɨti'anekɨ xeikɨa nemɨnewaɨriyakɨ, 'ayumieme mepɨnetsi'aye'unie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Yawé, pepɨkanetsi'uku'e'eiriwani,","poem":1},{"text":"nekakaɨyari, nexaɨtame pepɨkanetsikuhayeikawani.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Neti'aitɨwame netsiwikweitsitɨwame,","poem":1},{"text":"yapauka keneneuparewi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}