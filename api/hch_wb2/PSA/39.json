{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":39,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Kerutuni hetsiemieme. Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Ne mɨpaɨ nepɨtiu'eri:","poem":1},{"lineBreak":true},{"text":"«Teɨteri 'axateyuruwamete wahɨxie nemuyeikakɨ","poem":1},{"text":"nepɨne'ɨwiyani kenemɨtiuyeika,","poem":2},{"lineBreak":true},{"text":"nepɨtinewieka kapa 'axane'utayɨnikɨ,","poem":2},{"lineBreak":true},{"text":"matsi netenie nepuwieka».","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hikɨ kayuwatɨ mana nepuyeikakai, nepɨka'utaniu.","poem":1},{"text":"'Aixɨa mɨti'ane meta nepɨkatikuxatakai.","poem":2},{"text":"Matsi ne'uximatɨarika kanitimiekaitɨni,","poem":1}]},{"type":"verse","number":3,"content":[{"text":"ne'iyari pɨtakai netawitsie.","poem":2},{"text":"Mɨyanetiku'eriwakaku, matsi tai kaniutani","poem":1},{"text":"'ayumieme mɨpaɨ nekaniutayɨni:","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«Yawé, keneneutaxatɨa 'ena kwiepa netukari kereutere,","poem":1},{"text":"kepaɨmexɨa xeikɨa nepuyeikani,","poem":2},{"lineBreak":true},{"text":"keneneutaxatɨa netukari ke'emɨkatiteriwe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Netukari pɨkawaɨkawa pemɨnetsi'upitɨa,","poem":1},{"text":"'akɨmana, kepaɨmeme wiyari nemuyurieni tixaɨtɨ pɨkatihɨkɨ.","poem":2},{"text":"Xeihɨtsiyari xeikɨa pɨhɨkɨ tewi mɨmɨwe.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Tewi tukarieya 'etɨriya hepaɨ xeikɨa kani'aneni meuyewautse.","poem":2},{"text":"Yakɨ xeikɨa pɨyɨaneni piinitɨarika xɨka tixeɨrieka,","poem":1},{"text":"'atsipɨkatimatsiɨkɨ kemɨ'ane mɨranupiini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"»Hikɨta, Ti'aitame, ¿titari netitakwewieka?","poem":1},{"text":"'Ahetsietimieme xeikɨa nepɨtitakwewie.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"'Axanemɨtiuyurikɨ keneneutawikweitsitɨa.","poem":1},{"text":"Pepɨkawapitɨaka 'atsimemɨkatemate memɨnetsiyuriyanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"»Kayuwatɨ nepuyeika, netenie nepuwie,","poem":1},{"text":"'ekɨ pemɨhɨkɨkɨ pɨta mɨyapemɨtiyurie.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Ariri pepɨkanetsitiwayani,","poem":1},{"text":"'a'iwaɨyɨ pɨnetsikumemiwatɨma.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Ekɨ teɨteri pepɨtiwaruka'enitsitɨwa,","poem":1},{"text":"pepɨwatiwaya ke'axamemɨteyurie,","poem":2},{"text":"kwitsi tikɨmeme hepaɨ, pepɨreuyehɨpa tita memɨtehiwe'erie.","poem":1},{"text":"Xeihɨtsiyari xeikɨa kanihɨkɨtɨni tewi mɨmɨwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"»Yawé, nenenewieri keneu'eni,","poem":1},{"text":"nehiwari keneu'eni,","poem":2},{"lineBreak":true},{"text":"ne'utatsuakakaku 'anakata pepɨkaheuyukanarɨmani.","poem":2},{"text":"'Ahɨxie ne pemɨkanetsimate nepɨhɨkɨ,","poem":1},{"text":"yeikame nekanihɨkɨtɨni, netutsima wahepaɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Pepɨkaha'aka, nenetemawiekame kenenayeitɨa","poem":1},{"text":"mexi nekamɨwe meta 'ena ne'uyeika».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}