{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":4,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. 'Ikɨ kanaritekɨ ke'utakwikarieni. Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Keneneuta'eiya kenemerahɨawe,","poem":1},{"text":"'ekɨ nekakaɨyari nehetsie nunuwame pemɨhɨkɨkɨ.","poem":2},{"text":"Kepauka nemɨ'uximatɨarie 'ekɨ pepɨnetsinɨtɨa,","poem":1},{"text":"Nenenewieri keneu'eni kenemaine keneneutinenimayata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Xemeta 'ukirawetsixi xemamariwaweme xemuyu'erie,","poem":1},{"text":"¿kepaukake xepɨtehayewa 'axaxeteyurietɨ 'aixɨa xemɨteyuriekakɨ nehetsiemieme?","poem":2},{"text":"¿Kepaukake xepɨtehayewa memɨkayuri kakaɨyarixi","poem":1},{"text":"xewarayexeiyatɨ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mɨpaɨ xeketenemaika, Yawé kemɨ'ane 'aixɨa mɨtiyuriene kaninaki'erieka.","poem":1},{"text":"Yawé kaneni'enieka kepauka nemehɨawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kepauka xemɨha'a 'axaxepɨkateyurieka,","poem":1},{"text":"xemuhenitsie xekeneyu'iyaritɨaka 'axaxemɨte'uyurikɨ","poem":2},{"lineBreak":true},{"text":"yu'iyaritsie xekeneyumaika.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Aixɨa mɨ'ane mawari xekeneyetuaka","poem":1},{"text":"Yawé hetsie yuri xete'erietɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yuwaɨkawatɨ mɨpaɨ mekaniutiyuaneni:","poem":1},{"text":"«¿Kemɨ'ane 'aixɨa mɨti'ane pɨtatiuxeitsitɨawe?»","poem":2},{"text":"Yawé, pe'atemawietɨ ketaneuxeiya","poem":1},{"text":"matsiɨkɨme kene'ayeitɨa tahetsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"'Ekɨ ne'iyari temawierieka pepupitɨa 'anuyuhayewame,","poem":1},{"text":"tɨriku, winu memeuxeiya wareuyeta katiniyutemawieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Neka'uximatɨarietɨ nekaniukahupuni nekaniukakukutsuni,","poem":1},{"text":"'ekɨtsɨ xeikɨa Yawé, 'aixɨa 'iyari pekanenayenieritɨaka.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}