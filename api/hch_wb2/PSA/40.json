{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":40,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Yawé netakwewietɨ nekanayani nekawaɨripietɨ,","poem":1},{"text":"mɨkɨ pɨnetsi'uxei, nehiwari kaniu'enieni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mɨkɨ teukiyata kanenatihana,","poem":1},{"text":"haxuta paitɨ meta yeuta paitɨ nemɨkawamarietsie,","poem":2},{"text":"tetetsie kanenakeni,","poem":1},{"text":"kwiepa 'aixɨa 'anekɨa kaneniukayeni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwikari hekwame kaneniupitɨani nemitakwikanikɨ,","poem":1},{"text":"nɨawari 'aixɨa haineme takakaɨyari hetsiemieme.","poem":2},{"text":"Mɨpaɨ mete'uneniereka yumɨiretɨ mekaniutimamani,","poem":1},{"text":"Yawé hetsie metewiyatɨ mekanakɨne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"'Aixɨa pɨ'itɨarie tewi Yawé hetsie mɨtiwiya,","poem":1},{"text":"memɨkayuri kakaɨyarixi","poem":2},{"lineBreak":true},{"text":"memɨwarayexeiya wahetsɨa parewiya mɨkaha'iwawa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yawé nekakaɨyari, pɨwaɨkawa","poem":1},{"text":"mamariwaweme kepemɨtiuyuri.","poem":2},{"text":"Pɨkayɨwe temiti'inɨata","poem":1},{"text":"ke'aixɨa pemɨtiuka'iyari tahetsiemieme.","poem":2},{"text":"Xɨka ne'itaxata,","poem":1},{"text":"pɨwaɨkawa matsi kenemɨkarayexatawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"'Ekɨ pɨkametsinake tinaitɨ mawari,","poem":1},{"text":"'ekɨ matsi neheu'ename pepɨnetsi'ayeitɨa,","poem":2},{"text":"'ekɨ pepɨkahe'iwawa mawari taiyarikayari","poem":1},{"text":"meta mawarika 'axamɨtiuyuri hetsiemieme.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Ayumieme mɨpaɨ neputayɨ: «Ne 'ena pepɨnetsihexeiya,","poem":1},{"text":"niuki xapatsie kemaine nehetsiemieme.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nekakaɨyari, pɨnetsinake kemɨmetinake mɨpaɨ nemɨtiyurienenikɨ,","poem":1},{"text":"'a'inɨari niukiyari ne'iyaritsie nepexeiya».","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yuwaɨkawatɨ meyuxeɨriekaku,","poem":1},{"text":"nepɨtiutahekɨataxɨ heitserie kemɨmetinake.","poem":2},{"text":"Yawé, 'ekɨ pepɨtimate, neteni","poem":1},{"text":"yuheyemekɨ nemɨka'anutanamakɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Keheitserie mɨmetinake nepɨka'i'awieta ne'iyaritsie,","poem":1},{"text":"matsi nepikuxatane ke'aixɨa pemɨtikamie meta kepemɨratawikwetsitɨani.","poem":2},{"text":"Yumɨiretɨ meyuxeɨriekaku nepɨka'enukanama,","poem":1},{"text":"'anaki'eriya mɨmariwe meta tita yurikɨ mɨraine.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yawé, kenenenenimayaka,","poem":1},{"text":"'anaki'eriyakɨ kenene'awietani meta yuri pemainekɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Waɨkawa 'axamɨti'anene pɨneranutinama,","poem":1},{"text":"pɨtimɨire nemɨtiuti'inɨata nepɨkayɨwe.","poem":2},{"text":"Pɨnetsi'anuku'axixɨ ke'axanemɨtiuyuri,","poem":1},{"text":"'ari nepɨkaheuniere.","poem":2},{"text":"Nekɨpate reuyeta kanipaɨmeni,","poem":1},{"text":"ne'iyari kaneuyuyehɨpani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yawé, xeiya kenaye'a pemɨnetsixɨnakɨ.","poem":1},{"text":"Yawé, kwitɨwa kenaye'a keneneuparewi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mekeheuyuyexɨrieni meke'uyutitetewiya,","poem":1},{"text":"yunaitɨ kemɨ'ane memɨnetsimieku,","poem":2},{"text":"mekeheuyuta'unaxɨani me'a'iwarieme,","poem":1},{"text":"yunaitɨ kehate memɨtekuwautɨwe 'axamenetsiyurikutɨ,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"kememɨte'a'iwarieni memɨnetsinanaima","poem":1},{"text":"meneniereme meke'utimamani.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kemɨ'ane memɨmetsikuwaɨtɨwe","poem":1},{"text":"meke'uyukatemamawieni 'ahetsie,","poem":2},{"text":"kemɨ'ane 'awikweitsitɨarika memɨnaki'erie, mɨpaɨ yuheyemekɨ meke'utiyuaneni:","poem":1},{"text":"«Pɨmariwe yemekɨ Yawé».","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Neta, tixaɨtɨ nemɨkarexeiya meta nereuyehɨatɨ,","poem":1},{"text":"Ti'aitame kenetsi'uxeiya.","poem":2},{"lineBreak":true},{"text":"'Ekɨ netsiwikweitsitɨwame pepɨhɨkɨ, netsixɨname,","poem":1},{"text":"'apepɨkareutewini, nekakaɨyari 'aku.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}