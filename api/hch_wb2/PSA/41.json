{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":41,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"'Aixɨa pɨ'itɨarie kemɨ'ane memɨwerarani 'aixɨa mɨtiwaxeiya,","poem":1},{"text":"Yawé hetsiena kanitanuamɨkɨ kepauka 'uximatɨarika hetsiena mɨye'ani.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yawé hetsiena kanitanuamɨkɨ, tukari kanipitɨamɨkɨ,","poem":1},{"text":"yutemawiekame kanayeitɨamɨkɨ xeime kwieyaritsie","poem":2},{"lineBreak":true},{"text":"meta memeye'unie yɨkɨ memiyurieni pɨkawapitɨani.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kepauka mɨtitakwine, Yawé kanitatɨrɨkariyamɨkɨ,","poem":1},{"text":"'aixɨa reu'eriekame kanayeitɨamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ne mɨpaɨ neputaine:","poem":1},{"lineBreak":true},{"text":"«Yawé, keneneutinenimayata,","poem":1},{"text":"'aixɨa keneneuyuri, 'ahepaɨtsita 'axanepɨtiuyuri».","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Memɨnetsi'aye'unie 'axa'anekɨa memɨnetsiheukahɨpa, mɨpaɨ meputiyuane nehetsiemieme:","poem":1},{"text":"«¿Kepaukari pɨmɨni?","poem":2},{"lineBreak":true},{"text":"¿Kepaukari tepitatɨmaiya?»","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kepauka memɨnetsi'uyexeiyatɨkɨka heitseriemekɨ mepɨka'uta'axe,","poem":1},{"text":"'uwata memɨyekɨne 'axamenetekuxatatɨ mepakɨka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Memɨnetsi'aye'unie meyukuxeɨrieme nehetsiemieme mepɨte'utixaxata,","poem":1},{"text":"nehetsie mepɨte'ahɨpa. Mɨpaɨ mekaniutiyuaneni:","poem":2}]},{"type":"verse","number":8,"content":[{"text":"«Mɨkɨ yu'utatsie 'akaitɨ hatsuakuri pɨka'anukukeni,","poem":1},{"text":"'axamɨti'ane hetsiena kanikahani».","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nehamiku 'ɨaritɨ yemekɨ hetsiena nemɨtiwiyakai","poem":1},{"text":"kwi nehamatɨa mɨrakwaiwekai,","poem":2},{"lineBreak":true},{"text":"nehepaɨtsitari kaneuniukani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yawé, 'ekɨ matsi, keneneutinenimayata,","poem":1},{"text":"kenenanukuketɨa","poem":2},{"lineBreak":true},{"text":"neta nemɨnekɨhɨanikɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Ana mɨpaɨ nepɨretimani nemɨmetsinaki'atsitɨakɨ:","poem":1},{"text":"xɨka mɨnetsi'aye'unie kanetsi'a'iwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"'Aixɨa nemɨtiuyeikakɨ pepɨnetsituikani,","poem":1},{"text":"'ahɨxie yuheyemekɨ ne'uyeikame pepɨnetsi'ayeitɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"'Aixɨa ketikuxaxatsiwani Yawé, 'Ixaheri Kakaɨyarieya,","poem":1},{"text":"tsepanetɨ xeitsienituyari wiyari manuyekɨka yaxeikɨa ketikuxaxatsiwani.","poem":2},"'Aixɨa pɨ'ane meta 'aixɨa pɨ'ane."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}