{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":42,"content":[{"type":"heading","content":["XAPA 2"]},{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Kure niwemama wa'ɨkitsika."]},{"type":"verse","number":1,"content":[{"text":"Maxa yeutanaka heuharimɨtɨ haa kemɨtikuwaune,","poem":1},{"text":"neta mɨpaɨ nepɨmetikuwaune Kakaɨyari.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nepeuharimɨkɨ Kakaɨyari hetsie timiemekɨ, Kakaɨyari mayeyuri hetsie.","poem":1},{"text":"¿Kepauka Kakaɨyari hɨxie nepɨtakeni?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tukarikɨ tɨkarikɨ tsuarikɨ xeikɨa nepayeniere,","poem":1},{"text":"mɨpaɨ neranutahɨawarɨwatɨ tsepa kepauka:","poem":2},{"lineBreak":true},{"text":"«¿Hakewa tamɨ 'akakaɨyari?»","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mɨpaɨ neti'erieme nepɨtikuhayeikawa ne'utatsuatɨ:","poem":1},{"text":"Ne nepayeyeikakai yumɨireme wahamatɨa,","poem":2},{"lineBreak":true},{"text":"nepɨwarewitɨkɨkai Kakaɨyari tukita.","poem":2},{"text":"Temawierika hiwariyari meta pamɨpariyutsi","poem":1},{"text":"'ixɨarariyari tepatinenetɨwakai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¿Titayari yɨkɨ netinekɨhɨaweni?","poem":1},{"text":"¿Titayari netine'uximatɨaka?","poem":2},{"text":"Kakaɨyari hetsɨa timieme matsi nepɨtitakwewieka","poem":1},{"text":"meta nepinɨawani.","poem":2},{"lineBreak":true},{"text":"Mɨkɨ pɨnetsiwikweitsitɨwame meta pɨnekakaɨyari.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hikɨ yemekɨ nepɨtiuka'eniwa,","poem":1},{"text":"nekakaɨyari, 'ayumieme nemetsiku'eriwa","poem":2},{"text":"Kurutani kwieyaritsie paitɨ,","poem":1},{"text":"Heximuni hɨriyaritsie meutitewatsie paitɨtɨ,","poem":2},{"lineBreak":true},{"text":"Mitsaxi hɨriyaritsie paitɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Xeime terɨtsie puwa'eiya","poem":1},{"text":"haa manukaxɨrɨwe kwinimieme mutainetsie,","poem":2},{"text":"naitɨ 'ahamewari","poem":1},{"text":"nehetsie pɨkaxɨrɨwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"'Ikɨ nenewieri pɨhɨkɨ Kakaɨyari tukari mɨnetsi'upitɨa hetsiemieme:","poem":1},{"text":"tukarikɨ Yawé yunaki'eriya kenetsiheyenɨ'airiwani,","poem":2},{"lineBreak":true},{"text":"tɨkarikɨta kwikarieya nepuku'eriwani.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nekakaɨyari mɨpaɨ nekatinahɨaweni, Ne'ai:","poem":1},{"text":"«¿Titayari peneratɨmai?","poem":2},{"text":"¿Titayari nenehiwerietɨ 'ena netiuyeikani","poem":1},{"text":"nenanaimarietɨ memɨnetsi'aye'unie wahetsiemieme?»","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mɨki ne'umeyarita paitɨ kaniuhakeni","poem":1},{"text":"menetsinanaimakaku memɨnetsi'aye'unie,","poem":2},{"text":"mɨpaɨ neranutahɨawarɨwatɨ nehɨxie tsepa kepauka:","poem":1},{"text":"«¿Hakewa tamɨ 'akakaɨyari?»","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"¿Titayari yɨkɨ netinekɨhɨaweni?","poem":1},{"text":"¿Titayari netine'uximatɨaka?","poem":2},{"text":"Kakaɨyari hetsɨa timieme matsi nepɨtitakwewieka,","poem":1},{"text":"meta nepinɨawani.","poem":2},{"lineBreak":true},{"text":"Mɨkɨ netsiwikweitsitɨwame kanihɨkɨtɨni meta nekakaɨyari.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}