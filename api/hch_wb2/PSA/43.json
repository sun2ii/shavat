{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Kakaɨyari, 'aixɨa ketineuyuri nehetsie.","poem":1},{"text":"Nehetsie keneutanua 'ikɨ nuiwari wahɨxie yuri memɨkate'erie,","poem":2},{"lineBreak":true},{"text":"keneneutawikweitsitɨa teɨteri memɨte'itawa watsata meta 'axamemɨte'u'iyari.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Ekɨ pepɨnekakaɨyari meta nehetsie nunuwame pepɨhɨkɨ:","poem":1},{"text":"¿Titayari pekanera'eriwa?","poem":2},{"text":"¿Titayari netinehiwerieka?","poem":1},{"text":"¿Titayari netiuka'eniwani memɨnetsi'aye'unie wahetsiemieme?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Ahekɨariya kenanɨ'a meta tita yuri pemɨraine,","poem":1},{"text":"mɨkɨ 'ahɨri mɨpatsietsie paitɨ kenetsi'uye'atɨani,","poem":2},{"lineBreak":true},{"text":"mekenetsihewitɨni hakewa paitɨ pemeyeika.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hikɨ nekaninuamɨkɨ 'ahetsiemieme mawari taiyametsie,","poem":1},{"text":"Kakaɨyari hetsɨa temawierika mayeneikakɨ,","poem":2},{"text":"Kakaɨyari, muwa nekakaɨyari 'aku","poem":1},{"text":"kanarikɨ nekamenitanɨawamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¿Titayari yɨkɨ netinekɨhɨaweni?","poem":1},{"text":"¿Titayari netine'uximatɨaka?","poem":2},{"text":"Matsi Kakaɨyari hetsie nepɨtiwiyani,","poem":1},{"text":"meta nepinɨawani.","poem":2},{"lineBreak":true},{"text":"Mɨkɨ pɨnetsiwikweitsitɨwame meta pɨnekakaɨyari.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}