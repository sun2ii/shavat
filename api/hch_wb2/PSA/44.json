{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":44,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Kure niwemama wa'ɨkitsika."]},{"type":"verse","number":1,"content":[{"text":"Kakaɨyari, tepɨte'u'eni 'ahetsie timieme,","poem":1},{"text":"tapaapama mepɨtate'utaxatɨa","poem":2},{"text":"mamariwaweme kepemɨtiuyuri memu'uwakaitsie,","poem":1},{"text":"'iya tukaritsie meripaitɨ:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Atɨrɨkariyakɨ hipame nuiwarite pepɨwarutawei,","poem":1},{"text":"mana pɨta pepɨwa'atɨa tapaapama,","poem":2},{"text":"'iya teɨteri pepɨwarakumaweriyaxɨ,","poem":1},{"text":"tapaapama pepɨwaruparewi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wa'ixipara pɨkatiuyuri kwie mema'iwaxɨ,","poem":1},{"text":"yukɨmana mepɨkate'uyuri memɨte'ayu'iwaxɨ:","poem":2},{"text":"matsi 'atɨrɨkariya pɨtiuyuri, 'amamá 'atserieta mieme pɨtiuyuri,","poem":1},{"text":"'anierika xawatɨriyaya pɨtiuyuri, 'ekɨ pemɨwanaki'eriekaikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"'Ekɨ xeikɨa ti'aitame nehetsiemieme pepɨhɨkɨ meta nekakaɨyari.","poem":1},{"text":"Kakuwu mɨrayu'iwakɨ pepiparewi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Ekɨ petatsiparewiekaku memɨtatsi'aye'unie tepɨwara'iwaxɨ,","poem":1},{"text":"kepemɨtitewa hekɨ tepɨwarutipɨnaxɨ memɨtatsi'aye'uniekai.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne netupi hetsie nepɨkaheuwaɨre,","poem":1},{"text":"ne'ixipara nemɨrayu'iwakɨ pɨkanetsi'uparewiwe,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'ekɨ matsi petatsiparewiekaku memɨtatsi'aye'unie tepɨwara'iwa,","poem":1},{"text":"memɨtatsi'aye'unie meyutetewiyame pepɨwarayeitɨwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Taheyemekɨ tepɨtatemamawieka Kakaɨyari hetsie.","poem":1},{"text":"Yuheyemekɨ tepinɨawani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Peru hikɨ pepɨtatsihexɨri teyutetewiyame pepɨtatsi'ayeitɨa,","poem":1},{"text":"pepɨkatatsiparewieri temuyukwitɨwetsie.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mɨtatsi 'aye'unie hɨxie tema'iwarienikɨ yapepɨtiuyuri,","poem":1},{"text":"mepɨtatsi 'ayewei memɨtatsi 'aye'unie mepɨtate'unawatsiri.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Muxatsi temɨhɨkɨtɨni hepaɨ","poem":1},{"text":"pepɨtatsiyetua temɨtikwaiyanikɨ,","poem":2},{"lineBreak":true},{"text":"mekataneutaxɨriexɨani naitsarie kwiepa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"'Ateɨterima pekaniwarutuani ka'ɨrimekɨ,","poem":1},{"text":"tixaɨtɨ pepɨkaranɨ'ɨi pewarutuaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ta'aurie kiekatari wahɨxie tetewiwekame pepɨtatsi'ayeitɨa,","poem":1},{"text":"nanaimariwamete 'atsieriwamete tekanihɨkɨtɨni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kwiepa memɨtama wananaitɨwamete tekanihɨkɨtɨni,","poem":1},{"text":"yunaitɨ teɨteri memu'uwa mekatani'atseni tame.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Etsiwatɨma nepɨkahayewarie nekananaimarietɨ,","poem":1},{"text":"waɨkawari nepaunetewiya,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"waɨkawa memɨnetsinanaimakɨ menetsi'utahiwiwatɨ,","poem":1},{"text":"mɨnetsi'aye'unie ya'aneme wiwiekaku muyuwaɨriya mɨraka'una.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mɨya tepɨte'anuyehu hikɨ,","poem":1},{"text":"hatsuaku tekametsihatɨmaiyakutɨtɨ","poem":2},{"lineBreak":true},{"text":"meta 'atɨratu teka'uku'eiriekutɨtɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tepɨkametsiku'eiriewawe,","poem":1},{"text":"'ahuye meta tepɨkaku'eiriewawe.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Matsi 'ekɨ yawixi memayu'eriyaya waterɨta pepɨtatsiheukaxɨri,","poem":1},{"text":"waɨkawa mayeyɨwitsie pepɨtatsiheutaxɨri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Xɨka tehetɨmaiyake takakaɨyari,","poem":1},{"text":"xɨka yatɨni hipame kakaɨyarixi wahɨxie te'ukatunuma'unike,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"¿tamɨ Kakaɨyari karetimanikeyu,","poem":1},{"text":"mɨkɨ naime mɨtimate tita temɨte'awieta tahetsie?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"'Ahetsie temɨtewiyakɨ, tepɨtakwikwiwa yuheyemekɨ,","poem":1},{"text":"muxatsi memɨkwaiya wahepaɨ tepɨte'anuyehu memehapawa mehekwi'iwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ti'aitame, 'ari kenanutanieri. ¿Titayari petikutsu?","poem":1},{"text":"Kenanukukexi. Pepɨkatatsihexɨrɨwani 'aheyemekɨ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"¿Titayari tahepa pekatinierimɨkɨ?","poem":1},{"text":"¿Titayari 'atsipekaraine tete'uka'eniwakaku meta tenanaimariekaku?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Tepa'iwarie kwiepa paitɨ tepɨtihe,","poem":1},{"text":"tawaiyari kwiepa paitɨ patixɨrɨwe.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kenanukukexi, kenaye'a ketaneuparewi,","poem":1},{"text":"'anaki'eriyakɨ taheima keneutanua.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}