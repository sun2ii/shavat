{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":45,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. «Tuturi» yuariyaya keneuweiyani. Kure niwemama wa'ɨkitsika. Neɨkiyapa mieme."]},{"type":"verse","number":1,"content":[{"text":"Ne'iyaritsie peyeyuane kwikari hekwatɨ,","poem":1},{"text":"ne'ikuxatakaku kemanuyɨne ti'aitame hɨxie,","poem":2},{"lineBreak":true},{"text":"'utɨwame witsimɨtiu'utɨwa hepaɨ kani'aneni neneni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"'Ekɨ tewi witsipemɨti'axexeiya pekanihɨkɨtɨni,","poem":1},{"text":"witsipekatiniuxaxatani,","poem":2},{"lineBreak":true},{"text":"Kakaɨyari 'aixɨa pɨmatsiyurie yuheyemekɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Witsi'aneme mariwemekɨ,","poem":1},{"text":"yu'ixipara kanakawieka, 'iya mɨrayu'iwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mariwemekɨ, kananutiyeixani rayu'iwake","poem":1},{"text":"tita yuri mɨraine hetsiemieme kaniyumieneni,","poem":2},{"lineBreak":true},{"text":"meta tixaɨtɨ mɨkarayuyeitɨa meta tita mɨtiheitseriekɨ,","poem":2},{"lineBreak":true},{"text":"mariweme ketiyurieneni 'atɨrɨkariya.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'A'ɨrɨ kwinimieme mɨranuyemɨtsɨ ti'aitame memaye'unie","poem":1},{"text":"wa'iyaritsie keheu'uni,","poem":2},{"lineBreak":true},{"text":"meta nuiwarite 'ahetɨa meke'ukaxɨrieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kakaɨyari, 'a'uweni yuheyemekɨ 'apuwe,","poem":1},{"text":"'a'itsɨ pemɨti'aitame hetsiemieme, mɨkɨ 'itsɨ 'aixɨa mɨti'anekɨ mɨti'aita kanihɨkɨtɨni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Ekɨ 'aixɨa mɨti'ane pepɨtinaki'erie, 'axamɨti'aneta pepɨti'uxiwe'erie,","poem":1},{"text":"'ayumieme Kakaɨyari pɨmetsi'anayexei 'ekɨ, 'a'iwama pɨkawaranayexei,","poem":2},{"lineBreak":true},{"text":"'akakaɨyari temawierika hatseitiyari pɨmetsi'ukawiri.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mixaxi 'ɨakariyari, 'aruhe meta kanera,","poem":1},{"text":"mɨpaɨ pu'ɨatɨka 'akemarite,","poem":2},{"text":"paratsiyu witsimɨtiuye'anetsie 'umetekɨ tiwaku'utɨkaimeta pe'ayekaiku,","poem":1},{"text":"pɨmetsitemawieritɨa kanari yuariyaya.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Ukari te'aitamete waniwema witsimemɨ'anene memɨmetsiparewie watsata mekaniye'uwani,","poem":1},{"text":"'atserietata 'uka ti'aitame kanakani","poem":2},{"lineBreak":true},{"text":"huru 'Upixi miemekɨ 'utixawatɨretɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Keneu'ena, 'uka yemekɨ keneu'a'ɨwiya:","poem":1},{"text":"'Akiekari kenatɨmaiya meta 'a'iwama.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ti'aitame witsikepemɨti'ɨimari kamenihiwe'erieka,","poem":1},{"text":"mɨkɨ meti'aitɨwame kanihɨkɨtɨni, hɨxiena kenanakatutsita.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"'Ukari Tiru kiekatari mekani'axɨakuni 'imikieri mete'upitɨ,","poem":1},{"text":"teɨteri mana kiekatari memɨxikutsixi 'aixɨa mepɨmetexeiyani.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Uka witsimɨti'ɨimari 'aixɨa katiniyuxexeiyani,","poem":1},{"text":"yukiita wayemietɨ hurukɨ 'utixawatɨretɨ 'iwieya reuxuiyakaku.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kemari ranakapitɨ 'aixɨa mɨti'anenekɨ reuxuiyatɨ","poem":1},{"text":"kanewitɨwani ti'aitame hɨxie,","poem":2},{"lineBreak":true},{"text":"'ɨtɨmanata 'ɨimarixi me'eweiyatɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Temawierikakɨ mekanewitɨwani","poem":1},{"text":"ti'aitame paratsiyuta paitɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"'Aniwemata yupaapama wa'uwenitsie mekanayaxikuni,","poem":1},{"text":"memanuyetei pekaniwarayeitɨamɨkɨ naitsarie kwiepa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Pemukahatɨmaiyarienikɨ yanepɨtiyurieni","poem":1},{"text":"yuheyemekɨ,","poem":2},{"text":"'ayumieme nuiwarite mepɨmetsitanɨawa,","poem":1},{"text":"yuheyemekɨ yuheyemekɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":17}