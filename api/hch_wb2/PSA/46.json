{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":46,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Kure niwemama wakwikari 'etsi'uyuatɨ mutakwika."]},{"type":"verse","number":1,"content":[{"text":"Kakaɨyari tahetsie nunuwame kanihɨkɨtɨni, hetsiena temɨta'awieta,","poem":1},{"text":"yuheyemekɨ tatsiparewiwame kepauka temu'uximatɨarie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Ayumieme tepɨkaheumamaka,","poem":1},{"text":"tsepa kwiepa kemɨtiyɨane","poem":2},{"lineBreak":true},{"text":"tsepa yemurite haramara hixɨapa mɨtiukayunixɨa,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"tsepa hamewarieya kwinimieme mɨtiutatɨrarɨka,","poem":1},{"text":"ha'akaku hɨxiena tsepa hɨrite mutiyuane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Haa mana kaniuyehaneni Kakaɨyari kiekarieya mɨtemawieritɨa,","poem":1},{"text":"'Amutewi kie makupatsietsie.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mana Kakaɨyari kaniukani, kiekari hatsuaku pɨkahatiweni,","poem":1},{"text":"kepauka mukahekɨkɨaretsie Kakaɨyari kaniwaparewiekamɨkɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nuiwari mukumane mekanimamaka, te'aitamete mekaniuyɨyɨakatɨkani,","poem":1},{"text":"kepauka Kakaɨyari mutaniuka, kwie kanita'unikeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yawé, Naimekɨmɨtɨrɨkaɨye tahamatɨa kaniuyeikani,","poem":1},{"text":"hetsiena temɨta'awieta Kakuwu Kakaɨyarieya kanihɨkɨtɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Xekenakɨni xekeneuxeiya Yawé mamariwaweme pɨtiyuriene,","poem":1},{"text":"mɨkɨ kwiepa makumawenikɨ pɨtiuyuri.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kuyaxa kaneutipariya naitsarie kwiepa.","poem":1},{"lineBreak":true},{"text":"Tupi kaniutimura, pitsika 'amɨtɨtɨ kaniutimura,","poem":1},{"text":"kaxetate kuyaxa mieme taipa kaneuxɨrieni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"«Kayuwatɨ xeketeneteni, mɨpaɨ xeketenetimati ne Kakaɨyari nemɨhɨkɨkɨ.","poem":1},{"text":"Ne 'aixɨa nekatinitahɨawariemɨkɨ nuiwarite watsata.","poem":2},{"lineBreak":true},{"text":"Ne nemariwetɨ nekanayeitɨariemɨkɨ kwiepa».","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yawé Naimekɨmɨtɨrɨkaɨye tahamatɨa kaniuyeikani,","poem":1},{"text":"hetsɨana temɨta'awieta Kakuwu Kakaɨyarieya kanihɨkɨtɨni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}