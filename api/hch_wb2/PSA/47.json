{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Kure niwemama wakwikari."]},{"type":"verse","number":1,"content":[{"text":"Yunaitɨ teɨteri xeketeneutapineni,","poem":1},{"text":"Kakaɨyari xekeneutahiwiwani temawierikakɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yemekɨ pɨtɨrɨkaɨye Yawé 'Amutewi,","poem":1},{"text":"pɨmariwe ti'aitame 'ena kwiepa naitsarie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pɨtatsi'uhɨritɨa nuiwarite temɨwakuyuitɨanikɨ,","poem":1},{"text":"yunaime teɨteri pɨtatsi'uxatɨa,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'imikieri tahetsiemieme pɨranayexei","poem":1},{"text":"Kakuwu muyuta'ɨrixɨ kɨmana pɨhɨkɨ, kemɨ'ane waɨkawa mɨnaki'eriekai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kakaɨyari Yawé yu'uwenitsie kanayerɨni,","poem":1},{"text":"temawierika hiwariyaritsata meta kuxineta yuariyaya.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kakaɨyari xekenenɨawani, xekenekwikani hetsiena mieme,","poem":1},{"text":"xekeneutikwikani nɨawari tati'aitɨwame hetsiemieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kakaɨyari kanihɨkɨtɨni ti'aitame 'ena kwiepa naitsarie,","poem":1},{"text":"'ayumieme, nɨawari xekeneutikwikani mariwemekɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kakaɨyari katini'aitani, naime nuiwarite kwiepa memɨtama wahetsiemieme,","poem":1},{"text":"yu'uweni mɨpatsietsie 'akaitɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Teɨteri wa'ukiyarima mekaniyukuxexeɨriwani,","poem":1},{"text":"'Apɨrahami Kakaɨyarieya teɨterimama wahetsɨa me'itahɨaweke,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"mɨkɨtsɨ Kakaɨyari katinipiinieyatɨni naitsarie kiekari mukumane kwiepa.","poem":1},{"text":"Mɨkɨ mariwemekɨ 'aixɨa katinikuxaxatsiwamɨkɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":10}