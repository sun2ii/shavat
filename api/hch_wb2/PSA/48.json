{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":48,"content":[{"type":"hebrew_subtitle","content":["Nɨawari. Kure niwemama wakwikari."]},{"type":"verse","number":1,"content":[{"text":"Yawé pɨmariwe, minɨawani yemekɨ 'aixɨa pɨ'ane","poem":1},{"text":"takakaɨyari kiekarienatsie.","poem":2},{"text":"Hɨrieya mɨpatsietsie,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"hɨri witsimɨ'ane,","poem":1},{"text":"naitsarie kwiepa watemawierika pɨhɨkɨ.","poem":2},{"text":"Tsiyuni hɨriyari, tayeta katini'aneni,","poem":1},{"text":"Ti'aitame mɨmariwe kiekarieya kanihɨkɨtɨni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tsiyuni muwe tuxiyu 'amutewita,","poem":1},{"text":"Kakaɨyari kaniyuhekɨata tiyu'awiwietame 'aixɨa mɨ'ane kemɨtihɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Te'aitamete mekaniyukuxeɨrieni mekaniyutinɨni,","poem":1},{"text":"yunaitɨ mɨkɨ kiekari me'unietɨ mekanewakɨne,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"peru kepauka memixei kayuwatɨ mekateniu'uni,","poem":1},{"text":"waɨkawa memamatɨ mekaneutayeixɨani.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mana waɨkawa memamatɨ mekanakɨne,","poem":1},{"text":"meta 'ukaratsi mɨtiniwerɨmeni hepaɨ 'anetɨ wahetsie katininuani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Eka kwinimieme mɨtitɨrɨkaɨyekɨ,","poem":1},{"text":"kanuwate 'amɨpapa Taritsi mieme peputimuraxɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yemekɨ kehepaɨ temɨte'u'enanakai","poem":1},{"text":"hikɨ tepunenierixɨ,","poem":2},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye kiekarienatsie,","poem":1},{"text":"meta takakaɨyari kiekarienatsie:","poem":2},{"lineBreak":true},{"text":"Mɨkɨ hatsuaku pɨkaheitiparitɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"'Atukita paitɨ, neuxei Kakaɨyari,","poem":1},{"text":"'anaki'eriya tepuku'eriwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Anɨawari, neuxei Kakaɨyari, meta kepemɨtitewa hepaɨ pɨ'ane,","poem":1},{"text":"kwie manu'axe paitɨ kaniuyeikani,","poem":2},{"lineBreak":true},{"text":"'amamá tserieta miemetsie tita mɨtiheitserie katinihɨneni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Ekɨ 'aixɨa pemɨtiyurienekɨ","poem":1},{"text":"hɨri Tsiyuni kaniyutemawieka,","poem":2},{"lineBreak":true},{"text":"meta Kura kiekariyaritsie mamanetɨka kaniyutemamawieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tsiyuni 'aurie xekenahuni,","poem":1},{"text":"waritana xekenakɨni","poem":2},{"lineBreak":true},{"text":"meta xekeneuti'inɨata tuxiyuya,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"kuraruyari 'aixɨa yemekɨ xeketeneuxeiya,","poem":1},{"text":"xekeneutixeiyaxɨa hakewa memeyuti'awiwieta,","poem":2},{"lineBreak":true},{"text":"mɨpaɨ 'uxa'atɨni warie xemɨtewakuxaxatɨwanikɨ yuniwema meta yuteukarima.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Ikɨ Kakaɨyari takakaɨyari yuheyemekɨ kanihɨkɨtɨni.","poem":1},{"text":"Mɨkɨ yuheyemekɨ kataniuwitɨximemɨkɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}