{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":49,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Kure niwemama wakwikari."]},{"type":"verse","number":1,"content":[{"text":"'Ikɨ xeketeneu'eni, yunaitɨ teɨteri:","poem":1},{"text":"xekeneu'enana, kwiepa xemɨtama naitsarie,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"yunaitɨ xemɨwerarani meta yunaitɨ waɨkawa xemɨmamariwawe,","poem":1},{"text":"yunaitɨ xikutsixi meta tixaɨtɨ xemɨkateheuxeiya.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nepɨtikuxatani timaiwemekɨ,","poem":1},{"text":"ne'iyari timaitɨ pɨtikuxatani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Temaiwawemete waniuki kwi 'ahurawa nepɨ'enieni,","poem":1},{"text":"netiyuitɨatɨ kanarikɨ nepɨxetaxatɨani niuki mɨ'awie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¿Titayari nereumaka kepauka 'uximatɨarika nehetsie munuani?","poem":1},{"text":"¿Titayari nereumaka kepauka memɨnetsi'aye'unie memɨnetsinanaimatsie?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pukaheuyewetse xikutsixi nemuwamakaxenikɨ yupiinitsie memɨtewiya","poem":1},{"text":"meta yupiinitekɨ memuyutimariwekata.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nixewitɨ xeime mutawikweitsitɨani pɨkayɨwe,","poem":1},{"text":"meta pɨkayɨwe Kakaɨyari mɨtiupitɨani xeime tukarieyakɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Xeime tukarieya mutawikweitsitɨani katinaye'aka,","poem":1},{"text":"pumawe ka'inɨaritɨ kemɨraye'axe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Xewitɨtɨma yapɨkatiuyeika,","poem":1},{"text":"hatsuaku kamɨwetɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Meyunaitɨ yaxeikɨa mepɨtetakukuwe,","poem":1},{"text":"memɨtemaiwawe meta memɨkatemaiwawe yaxeikɨa mepɨtakukuwe,","poem":2},{"lineBreak":true},{"text":"wapiinitɨarika hipatɨ wapiini pɨrayeika.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tsepa kwie memeuxeiyakai yuhepaɨ titetewakame,","poem":1},{"text":"teukiyapa wakii yuheyemekɨ pɨhɨkɨtɨni,","poem":2},{"lineBreak":true},{"text":"wakie pɨhɨkɨtɨni yuheyemekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tsepa xiku xewitɨ mayuyeitɨa, peru mɨkɨ 'apɨkareutere,","poem":1},{"text":"yeutari wahepaɨ mepɨtakukuwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mɨpaɨ kani'aneni yuhetsie memɨtewiya wahuye,","poem":1},{"text":"mɨpaɨ mekateneutiparikuni 'iya memuyuti'ɨre.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Muxatsi wahepaɨ, mekane'ariyani teukiyapa,","poem":1},{"text":"muwa kaniware'arieni mɨki.","poem":2},{"text":"Wakaxari kwieta paitɨ kanetipɨnimɨkɨ,","poem":1},{"text":"wakii witsimɨ'anene mati'utsie 'ahetewakaku.","poem":2},{"text":"'Uxa'arieka ximeri teɨteri heitserie memexeiya mekateniwata'aitɨakuni.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Peru Kakaɨyari kanenitawikweitsitɨamɨkɨ teukiyapa","poem":1},{"text":"yuhamatɨa kanenanuwitɨmɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Pepɨkamaka xewitɨ xɨka xiku hayuyeitɨani","poem":1},{"text":"meta xɨka yukii witsi'aneme 'utawewieni,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"mɨkɨ kepauka mɨmɨni tixaɨtɨ pɨkaranupini,","poem":1},{"text":"hamatɨana pɨkatiyehu piiniteya.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tsepa 'a'uyeikatɨ kename 'aixɨa tiuyeika maine,","poem":1},{"text":"tsepa teɨteri 'aixɨa memɨtehehɨawe xiku matɨakɨ,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"yaxeikɨa kanimɨmɨkɨ yupaapama wahepaɨ,","poem":1},{"text":"tawariri hekɨariya pɨkaxeiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Tsepa xiku xewitɨ mayuyeitɨa, peru mɨkɨ 'apɨkareutere,","poem":1},{"text":"yeutari wahepaɨ mepɨtakukuwe xeikɨa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":20}