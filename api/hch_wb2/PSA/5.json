{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":5,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. 'Ikɨ pirikɨxakɨ ke'utakwikarieni. Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Yawé, neniuki keneu'eni,","poem":1},{"text":"kenemɨtiutatsuaka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kenemaine, neti'aitɨwame meta nekakaɨyari kenene'enieka,","poem":1},{"text":"'ekɨ xeikɨa nepɨmatsiwawirie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yawé, ximeri paitɨ pepɨnetsi'enie,","poem":1},{"text":"ximeri paitɨ nepɨmatiwawirie,","poem":2},{"lineBreak":true},{"text":"kepauka pepɨnetsita'eiya nepɨta'ikwewa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"'Ekɨ Kakaɨyari pepɨkahɨkɨ 'axamɨti'anekɨ muyutemawie,","poem":1},{"text":"'ahamatɨa mepɨkayɨwawe memuyuxewiriyani 'axamemɨte'u'iyari.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Ahɨxie memɨti'uni mepɨkayɨwawe mamariwawemete memɨyu'erie,","poem":1},{"text":"pekaniwaxani'erieka 'axamemɨteyurie.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Memɨte'itawa pepɨwaka'una","poem":1},{"text":"Yawé, pepɨwa'uxie teyukwamanamete meta memɨteyumemiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Peru ne, nepɨyɨwe 'akiita","poem":1},{"text":"nemeutahani 'anaki'eriya mɨmariwekɨ,","poem":2},{"text":"'atuki mɨpatsieta nepɨyɨwe","poem":1},{"text":"nemɨkatunumakeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yawé, yuwaɨkawatɨ memɨnetsi'aye'uniekɨ,","poem":1},{"text":"'aixɨa mɨti'anetsie keneneuwitɨximeni,","poem":2},{"lineBreak":true},{"text":"'ahuyeta keneneparewieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kememutiyuane yurikɨ mepɨkatekuxata,","poem":1},{"text":"yutaɨta 'axati'aneme mepɨtehexeiya,","poem":2},{"text":"wateta mɨki teukiyapa pɨhɨkɨ reutenitɨ,","poem":1},{"text":"yunenikɨ mepɨteyu'itaiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Keniwaranutaxɨri, Kakaɨyari,","poem":1},{"text":"kememɨteyukɨhɨawekɨ mɨkɨkɨ mekeheyukaxɨrieni.","poem":2},{"text":"Pepɨkawanaki'erieka yuwaɨkawa memuwarukwikɨ,","poem":1},{"text":"mematsi'aye'unietɨ memakɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Peru 'ahetsɨa memuyu'awieta mekeyutemamawieka,","poem":1},{"text":"meke'utikwikani kwikari 'aixɨa manuyɨtɨka.","poem":2},{"text":"Waɨkawa keniwa'ɨwiyani memuyuwaɨriya,","poem":1},{"text":"yunaitɨ memɨmatsinaki'erie.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"'Ekɨ Yawé 'aixɨa pepɨwayurie yamemɨtekahu,","poem":1},{"text":"kuya muyukunarɨma pehɨkɨtɨtɨ pepɨwareutinama mɨpaɨ mɨmatinakekɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}