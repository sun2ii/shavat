{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":50,"content":[{"type":"hebrew_subtitle","content":["'Atsahapi nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Yawé kananiukani, kakaɨyarixi mɨwakakaɨyari:","poem":1},{"text":"teɨteri kaniwa'inieka tau manatineika metsutɨme tau makayuyuipiketsie paitɨ meye'atɨkaime.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kakaɨyari kaniutimerɨkani Tsiyuni paitɨ,","poem":1},{"text":"kiekari witsimɨ'ane meta 'aixɨa mɨ'anetsie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Takakaɨyari 'ukanamieni, peru kayuwatɨ hexeiyatɨ 'upɨkahamie,","poem":1},{"text":"tai kananuyekani hɨxiena naime tititaiyatɨ,","poem":2},{"lineBreak":true},{"text":"waritana katiniutatɨrarɨkani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yawé muyuawi meta kwie kaniwa'inieka,","poem":1},{"text":"memɨnenierekɨ yuteɨterima mɨwataxanetatsie:","poem":2}]},{"type":"verse","number":5,"content":[{"text":"«Memɨpatsie xekeniwarukuxeɨri,","poem":1},{"text":"nehamatɨa tɨratu memuwewi mawarikɨ».","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Muyuawi 'aixɨa mɨti'ane katinihekɨatani kayuhekɨakamekɨ:","poem":1},{"text":"Kakaɨyari kani'itsɨkametɨni 'aixɨa tiuka'iyaritɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Xekeneu'enana, neteɨterima, nepɨtitaxata,","poem":1},{"text":"'Ixaheri, nepɨmetsitahekɨata:","poem":2},{"lineBreak":true},{"text":"Ne nepɨ'akakaɨyari, ne xeikɨa Kakaɨyari nepɨhɨkɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne nepɨkamatsihate'a mawarika pemɨwewiekɨ","poem":1},{"text":"meta mawari taiyariyari, mɨkɨ yapemɨnetiutimawiriwakɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ne nepɨkawareuyehɨwari tsikerutsixi 'akuraruta miemete,","poem":1},{"text":"meta tsipuri 'ukitsi 'akie miemete,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"yeutari mekateninepiinitɨni,","poem":1},{"text":"metatsiere xeimiriyari hɨriyaritetsie tewaxi yeuta memu'uwa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Memɨte'awɨwawe nepɨwamate,","poem":1},{"text":"yunaitɨ yeuta memɨte'u'uwa nepiini mepɨtehɨkɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xɨka ne neheuhaakamɨkɨni, nepɨkametitaxatɨani,","poem":1},{"text":"metsɨ kwie naitɨ katininepiinitɨni, meta tita mɨrexeiya.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"¿Kamɨtsɨ ne tuurutsixi wawaiyari netikwa'a,","poem":1},{"text":"yatɨni tsipuri 'ukitsi waxuriya neti'ie?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kakaɨyari kenexatɨaka kepemɨti'awaɨriyakɨ,","poem":1},{"text":"'Amutewi hetsɨa kepemɨti'ahɨritɨa ketinaye'atɨa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Keneneutahɨawi kepauka 'uximatɨarika pemexeiya,","poem":1},{"text":"ne nepɨmetsixɨna, 'ekɨta 'aixɨa pepɨnetitahɨawe».","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Peru Kakaɨyari 'axatiyuruwame mɨpaɨ katinahɨaweni:","poem":1},{"lineBreak":true},{"text":"«'Ekɨ heitserie pepɨkahexeiya ne'aitsika pemukuxatanikɨ,","poem":1},{"text":"yatɨni netɨratu pemɨkuxatanikɨ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kenemɨti'aita, pepɨxani'erie,","poem":1},{"text":"neniuki, pepehɨpa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Xɨka tinawayame pe'uxeiya, pepitinɨnɨwe,","poem":1},{"text":"hipame wa'ɨitama memɨwakumaɨwa wahamatɨa pepuyeika.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"'Axamɨti'anekɨ, 'aneni pepɨtatua,","poem":1},{"text":"'aneni puyuwaɨriya mɨtiu'irɨmanikɨ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Pepɨ'iyamate 'a'iwa hetsiemieme pemɨtikuxatanikɨ,","poem":1},{"text":"matsi pepi'uximatɨa yemekɨ 'a'iwa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mɨpaɨ pekatiniyurieneni, neta 'atsinepɨkahaine,","poem":1},{"text":"¿xɨari mɨpaɨ pepɨtiku'eriwa kename ne 'ahepaɨ ne'ane?","poem":2},{"text":"Peru hikɨ ne nekamenitatiemɨkɨ,","poem":1},{"text":"'ahɨxie nemetsi'anutaxeiyatɨ nepɨmetsitaxaneta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"»Xeme Kakaɨyari xematɨmai,","poem":1},{"text":"xekeneutimaixɨa kenemaine,","poem":2},{"text":"xɨkate mɨpaɨ xeka'ɨyɨni, ne nekanixetitsanamɨkɨ,","poem":1},{"text":"nixewitɨ tɨma pɨkaxetawikweitsitɨani.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kemɨ'ane pamɨpariyutsi mɨnetsipitɨa, 'aixɨa mɨnerahɨawe,","poem":1},{"text":"kemɨ'ane yuhuye 'ɨwiyatɨ mumie, newikweitsitɨarika nekanipitɨamɨkɨ».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}