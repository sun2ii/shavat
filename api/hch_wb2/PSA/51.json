{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":51,"content":[{"type":"hebrew_subtitle","content":["Rawiri nɨawarieya, kepauka tixaxatame Natani meikuxei Rawiri Wetitsawe hamatɨa 'axamete'uyurieku."]},{"type":"verse","number":1,"content":[{"text":"Kakaɨyari, kenenenenimayaka,","poem":1},{"text":"mɨmariwekɨ 'anaki'eriya,","poem":2},{"text":"mɨwaɨkawakɨ kepemɨtiuyukanenimaya,","poem":1},{"text":"ke'axanemɨtiuyuri kenetinanuyeitɨiri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Keneneutahauxina naime 'axamɨti'anekɨ","poem":1},{"text":"kenanuyeitɨa nexurikime.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ke'axanemɨtiuyuri nepɨtimate,","poem":1},{"text":"mɨpaɨ xeikɨa nepɨtiku'eriwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Ahepaɨtsita 'axanepɨtiuyuri, 'ahepaɨtsita xeikɨa,","poem":1},{"text":"'ahɨxie 'axanepɨtiuyuri,","poem":2},{"text":"'ayumieme 'ekɨ heitserie pepexeiya,","poem":1},{"text":"ke'aixɨa pemɨtiyuriene, 'aixɨa pɨ'ane.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne mɨpaɨ nepɨtimate nemutinuiwaxɨtsietɨtɨ 'axanepɨtiuka'iyari,","poem":1},{"text":"'axanetiyuruwametɨtɨ nemaama hetsie nepɨyenuiwaxɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne mɨpaɨ nepɨtimate 'ekɨ tita yuri mɨraine pepɨnaki'erie,","poem":1},{"text":"'ekɨ ha'awiekamekɨ pepɨnetiuta'ɨkitɨa nemɨtimaiwenikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"'Aixɨa keneneuyuri hitsupu xawarikɨ penetsikuwayatɨ, 'aixɨa ne'anetɨ nekanayeimɨkɨ,","poem":1},{"text":"keneneuhauxina, witsinetituxatɨ nekanayeimɨkɨ 'ɨwi kemɨkatituxa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Keneneupitɨa temawierika,","poem":1},{"text":"temawierika keneupitɨa 'ikɨ 'umete pemika'unaxɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Ahɨxie tita 'axanemɨtiuyuri kenatɨmaiya","poem":1},{"text":"meta naime 'axamɨti'ane kenanuyeitɨa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kakaɨyari, nehetsie keneunetɨa 'iyari mɨ'itiya,","poem":1},{"text":"'iyari nehetsie mɨyeka keneuhekwatɨa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Pepɨkanetsikupatani 'ahetsɨa nemuyeikanikɨ,","poem":1},{"text":"'a'iyari mɨtiyupata pepɨkanetsikunawairiwani.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"'Awikweitsitɨarika temawierikayari tawarita keneneupitɨa,","poem":1},{"text":"'iyari yatikamietɨ kenetsikuyuitɨwani.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mɨpaɨ ne'anetɨ 'axateyuruwamete 'ahuye nepɨwaxeitsitɨaka,","poem":1},{"text":"'axateyuruwamete 'ahetsɨa mepɨ'axɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Nekakaɨyari, netsiwikweitsitɨwame,","poem":1},{"text":"keneneutawikweitsitɨa xuriya nemɨtayeurikɨ,","poem":2},{"lineBreak":true},{"text":"'ana ne nepɨmetsinɨawani 'aixɨa pemɨtiyurienekɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Neti'aitɨwame, neteni keneupitɨa,","poem":1},{"text":"nemɨmetsinɨawanikɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mawari 'ekɨ pɨkametsinake","poem":1},{"text":"meta mawari taiyariyari,","poem":2},{"lineBreak":true},{"text":"xɨka metsinakenike ne nepɨmetsixatɨakakeyu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mawari mɨmetsinake","poem":1},{"text":"'iyari muyuhiwerie pɨhɨkɨ,","poem":2},{"text":"'ekɨ Kakaɨyari, pepɨka'ixani'erie","poem":1},{"text":"'iyari mɨtiuka'eniwa meta 'axamɨti'ane mɨtiuhayewaxɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kemɨmetinake, Tsiyuni 'aixɨa mɨtiukaxexeiyanikɨ yaketineuyuri,","poem":1},{"text":"Kerutsareme tetsariyaya kuraruyari keneutawewi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hikɨ 'ana mawari 'aixɨa mɨ'anene pɨmetsinakire,","poem":1},{"text":"naitɨ mawari taiyariyari,","poem":2},{"lineBreak":true},{"text":"meta 'amawari taiyametsie mepɨtimawarieni tsikerutsixi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":19}