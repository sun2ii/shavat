{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":52,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwame wa'ukiyari. Kwikari Rawiri 'ɨkitsikaya, kepauka Ruheki 'Erumi tewiyari, Tsahuri mɨpaɨ mɨtiutaxatɨa: «Rawiri 'Akimereki kie kaneyani»."]},{"type":"verse","number":1,"content":[{"text":"¿Titayari 'axamɨti'anetsie pereu'ayetuika, tewi pemɨtɨrɨkaɨye?","poem":1},{"text":"Kakaɨyari naki'eriyaya yuheyemekɨ yakatineuyuhaneni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Aneni, nawaxa mataxikauni hepaɨ pɨ'ane,","poem":1},{"text":"pɨtiyuka'unamɨkɨ meta 'itarika pɨwewie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Aixɨa mɨti'ane pepɨkatinaki'erie, matsi 'axamɨti'ane waɨkawa pepɨnaki'erie,","poem":1},{"text":"tita yuri mɨraine pepɨkanaki'erie, matsi 'itarika pepɨnaki'erie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kwinimieme ti'itawame neni pepexeiya,","poem":1},{"text":"Kwinimieme pɨmetinake 'aniukikɨ hipame pemɨwaratixɨrɨwanikɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Peru neuxei Kakaɨyari pɨmetsika'una yuheyemekɨ,","poem":1},{"text":"'akiita pɨmetsiwayehɨani,","poem":2},{"lineBreak":true},{"text":"'ena kwiepa pɨmetsi'akumaweriya hipatɨ memanu'uwatsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Heitserie memexeiya mɨkɨ mepɨtexeiya, 'ana mepɨtimamani,","poem":1},{"text":"'ana mɨpaɨ mepɨtiyuani me'inanaimatɨ:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"«'Ena tewi xekanixeiyani","poem":1},{"text":"Kakaɨyari hetsɨa mɨkaye'a mɨkɨ hetsiena mɨtanuanikɨ,","poem":2},{"text":"matsi pɨta yupiinitɨarikatsie mɨtiwiyakai,","poem":1},{"text":"'axatiyurienetɨ 'amuyeikakai».","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Peru neuxei ne huriwa mɨtsiɨraɨye hepaɨ nekani'aneni,","poem":1},{"text":"Kakaɨyari kie muxutu,","poem":2},{"text":"Kakaɨyari naki'eriyayatsie nekatiniwiyani","poem":1},{"text":"yuheyemekɨ yareuyuhanemekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Naime tukaritsie ne nekameninɨawakamɨkɨ 'a'uximayatsikakɨ,","poem":1},{"text":"ne 'ahetsie nepɨtiwiyani 'ahetsie memɨtewiya wahɨxie,","poem":2},{"lineBreak":true},{"text":"'ekɨtsɨ 'aixɨa pekatiniuka'iyarini.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}