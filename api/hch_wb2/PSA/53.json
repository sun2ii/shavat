{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":53,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. 'Ikɨ kwikari kanayukwikani hewayenutuixietɨ. Kwikari Rawiri 'ɨkitsikaya."]},{"type":"verse","number":1,"content":[{"text":"Kemɨ'ane 'atsimɨkatimate mɨpaɨ kanaineni yu'iyaritsie:","poem":1},{"text":"«Kakaɨyari kaniumaweni».","poem":2},{"text":"'Axamemɨteyurie mepɨhɨkɨ, naitɨ kememɨteyurie mɨxani'eriwa xeikɨa pɨtihɨkɨ,","poem":1},{"text":"nixewitɨ tɨma 'aixɨa pɨkatiyuriene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kakaɨyari muyuawitsie paitɨ teɨteri kaniwataxeiyani,","poem":1},{"text":"'iwaunetɨ xeime","poem":2},{"lineBreak":true},{"text":"timaiweme meta Kakaɨyari kuwauneme.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Peru yunaitɨ mepeuyexɨri","poem":1},{"text":"'axamepɨte'uyuri yunaitɨ,","poem":2},{"text":"Xewitɨ tɨma 'apɨka'uyeika 'aixɨa tiyurienetɨ,","poem":1},{"text":"pumawe nixewitɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"¿Kamɨtsɨ 'atsimekatemate 'axamemɨteyurie,","poem":1},{"text":"kemɨ'ane neteɨterima memɨwakwa'a paa hepaɨ?","poem":2},{"lineBreak":true},{"text":"Hatsuaku Kakaɨyari mepɨkahahɨawe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mekaniwamariutani xeikɨa,","poem":1},{"text":"kepauka mɨkaheuyewetse memɨmamakakɨ.","poem":2},{"text":"Kemɨ'ane memɨmetsi'aye'uniekai wa'umete Kakaɨyari kaniutaxɨrieni,","poem":1},{"text":"'ekɨ pekaniwatewiyatsitɨamɨkɨ, Kakaɨyari mɨwarayexɨrikɨ xeikɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kakaɨyari mɨpaɨ mɨnainenike Tsiyuni tiyuwikweitsitɨwame","poem":1},{"text":"mɨnanɨ'anike 'ixaheritsixi mɨwatawikweitsitɨanikɨ.","poem":2},{"text":"Kepauka Kakaɨyari yuteɨterima mɨwarakunuitɨanitsie,","poem":1},{"text":"Kakuwu kaniyutemawiekamɨkɨ: 'ixaheritsixi meta yunaitɨ mekaniyutemamawiekakuni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}