{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwate wa'ukiyari. Kanarikɨ ke'utanɨawarieni. Kwikari Rawiri 'ɨkitsikaya, kepauka Tsipi kiekatari Tsahuri mɨpaɨ memɨte'utahɨawixɨ: «Rawiri kaniyu'awietani tahamatɨa»."]},{"type":"verse","number":1,"content":[{"text":"Kakaɨyari, keneneutawikweitsitɨa pemɨtɨrɨkaɨyekɨ,","poem":1},{"text":"nehetsie keneutanua 'ekɨ pemɨyɨwekɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kakaɨyari, nenenewieri keneu'eni,","poem":1},{"text":"kenemutaine keneneu'eni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Neuxei, teɨteri nemɨkawamate mekanenimietɨweni,","poem":1},{"text":"mekanenimiekuni mɨkɨ memɨteyukananaima,","poem":2},{"lineBreak":true},{"text":"mɨkɨ teɨteri 'ekɨ Kakaɨyari mepɨkametsinaki'eriku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Peru Kakaɨyari netsiparewiwame kanihɨkɨtɨni,","poem":1},{"text":"ti'aitame mɨnetsi'ayeyuritɨa kanihɨkɨtɨni,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"mɨkɨ 'axamɨti'ane memɨnetsi'aye'unie wahetsie pɨta katininakimɨkɨ.","poem":1},{"text":"Yawé, ke'aixɨa pemɨtikamiekɨ keniwaruka'una.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kenemɨtiyuwaɨriya mawari nepɨmetsiwewirieni,","poem":1},{"text":"meta nepɨmetsitanɨawa, Yawé ke'aixɨa pemɨtiuka'iyari,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'ekɨtsɨ pekaneniuxɨna naimekɨ kenemɨti'uximatɨariekai,","poem":1},{"text":"ne nekaniuniere memɨnetsi'aye'unie kememɨte'a'iwarie.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}