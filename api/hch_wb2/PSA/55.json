{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":55,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Rawiri 'ɨkitsikaya. 'Ikɨ kanaritekɨ ke'utakwikarieni."]},{"type":"verse","number":1,"content":[{"text":"Kakaɨyari, nenenewieri keneu'eni,","poem":1},{"text":"kenemɨmetiwawirie pepɨkayuti'awiwietani.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kenenanu'eni meta keneneuta'eiya,","poem":1},{"text":"'uximatɨarika nepexeiya. Kwinimieme pɨnetsiyurie,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"mɨnetsi'aye'unie tierikaya","poem":1},{"text":"meta Kakaɨyari memɨka'ayexeiya kememɨte'uyukananaima,","poem":2},{"text":"mɨkɨ netiuka'eniwame mepɨnetsi'ayeitɨwa","poem":1},{"text":"meta kepauka memuyeha'arɨwe mepɨnetsi'anutate'a.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ne'iyari putimamawe netaɨta paitɨ,","poem":1},{"text":"waɨkawa pɨtɨrarɨka nemɨmɨximeni hepaɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nepuyɨyɨaka marikakɨ,","poem":1},{"text":"nepɨmariutsie yemekɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kukuru 'anateya xɨka nehexeiyanike,","poem":1},{"text":"nepanuwienikeyu hakewa nemeka'uxipieni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Ateewa paitɨ nepeyeiwe:","poem":1},{"text":"makumawetsie neheyeikatɨ nepayeiwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Xeiya nepewiwe hakewa nemeneti'awiwietatsie,","poem":1},{"text":"'eka netsihe'enitsitɨanikɨ","poem":2},{"lineBreak":true},{"text":"'eka kwinimieme mɨtitɨrɨkaɨye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ti'aitame, keniwaruka'una, mekayu'eniekame keniwarayeitɨa.","poem":1},{"text":"Kiekaritsie nanaimarika 'imieri xeikɨa nepɨxeiya,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"tukarikɨ meta tɨkarikɨ yukuraru 'utɨa mekanikɨnetɨweni,","poem":1},{"text":"mɨkɨ kuraruta 'axamɨti'ane xeikɨa kanixuaweni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mana 'axamɨti'ane tiyu'uname xeikɨa kanixuaweni,","poem":1},{"text":"mana kaye 'utɨma 'itarika nanaimarika yakatinixuaweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Xɨka mɨnetsi'aye'unie netsi'anutatiexɨani,","poem":1},{"text":"ne nepinewiwe,","poem":2},{"text":"xɨka mɨnetsi'aye'unie netsinanaimaka,","poem":1},{"text":"ne nepɨneti'awietawe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Peru 'ekɨ pepɨyɨane, tewi nehepaɨ pemɨ'ane,","poem":1},{"text":"ne'iwa, yemekɨ nehamiku,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'ahamatɨa nemuyeikakai 'aixɨa 'iyari,","poem":1},{"text":"tanaitɨ Kakaɨyari tukita temeta'axekai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Memɨnetsi'aye'unie wahetsie mɨɨya ke'aye'ani 'atsimekateha'eriwakaku.","poem":1},{"text":"Me'ayenenieretɨ teukiyapa mekeheukaxɨrieni,","poem":2},{"lineBreak":true},{"text":"wahetsietsɨ 'axamɨti'ane kaniyekani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Peru ne Kakaɨyari nekanitahɨawimɨkɨ,","poem":1},{"text":"mɨkɨta Yawé kanenitawikweitsitɨamɨkɨ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ximeri, taikai meta tɨkarikɨ","poem":1},{"text":"nekanehɨaweni ne'uximatɨarietɨ, mɨkɨta kaneni'enieka.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tsepa yuwaɨkawatɨ memɨnetsimietɨwe,","poem":1},{"text":"mɨkɨ netukari kaniutawikweitsitɨwani,","poem":2},{"lineBreak":true},{"text":"kuyaxa nehepaɨtsita mieme wewiyakaku.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kakaɨyari, mɨti'aitame yuheyemekɨ,","poem":1},{"text":"kaneni'enimɨkɨ mɨkɨ kaniwanutuixitɨamɨkɨ.","poem":2},{"text":"Mɨkɨ teɨteri hatsuaku mepɨkayupata,","poem":1},{"text":"Kakaɨyari mepɨkamakaxe.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yumamate teikɨ mepetsetsera yuhamikuma wahepaɨtsita,","poem":1},{"text":"peru mepɨkatehaye'atɨwa kememɨteyutipiniri.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yuteta witsimepɨte'eniuriɨkɨ wiya witsima'ane hepaɨ,","poem":1},{"text":"peru yu'iyaritsie 'imieri xeikɨa mepuku'eriwa.","poem":2},{"text":"Waniuki witsipɨ'ane hatseiti hepaɨ,","poem":1},{"text":"peru 'ixipara mataxikakauni mepɨhɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Yawé ketineyetuiri kepemɨranuyemie,","poem":1},{"text":"mɨkɨ kamenituikakamɨkɨ,","poem":2},{"text":"mɨkɨ pɨka'ipitɨani heitserie mexeiya matiwautsenikɨ,","poem":1},{"text":"yumuinatɨ yuheyemekɨ mɨkayukuhayeikawanikɨ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"'Ekɨ matsi Kakaɨyari, memɨkametsi'ayexeiya pepɨwaratixɨrieni","poem":1},{"text":"teukiyapa pepɨwareukaxɨrieni,","poem":2},{"text":"teɨteri xuriya memɨtayeuri memɨte'itawa,","poem":1},{"text":"mɨkɨ yutukari hixɨapa tɨma mepɨka'utinexɨani.","poem":2},{"text":"Ne matsi, 'ahetsie nepɨtiwiya.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}