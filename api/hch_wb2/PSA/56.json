{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":56,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Kwikarieya xekeneuweiyani «Tuaxatsie kukuru 'ateewa muyeka». Rawiri 'ikɨ nɨawari meka'utɨa, kepauka piritsiteutsixi pɨretsu memeyeitɨa Kahati kiekariyaritsie."]},{"type":"verse","number":1,"content":[{"text":"Kenenenenimayaka, xɨa'ui Kakaɨyari,","poem":1},{"text":"teɨteri mepuxuawe menetsi'uweiyatɨ.","poem":2},{"text":"Tukarikɨ mepɨnetsimietɨwe memɨnetsi'aye'unie,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"tukarikɨ mekaneniuweiyani menetsimiekutɨ,","poem":2},{"lineBreak":true},{"text":"mekaniyumɨireni meyuti'ɨretɨ memɨnetsimietɨwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kepauka nemeuma,","poem":1},{"text":"'ahetsie xeikɨa nepɨtiwiya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kakaɨyari hetsie nepɨtiwiya, niukieya nepɨnɨawa,","poem":1},{"text":"Kakaɨyari hetsie nepɨtiwiya, nepɨkaheuma.","poem":2},{"lineBreak":true},{"text":"Ketitayari kuta tewi netimakaka 'atsimɨkanetsi'uyuriwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tukarikɨ neniuki mekanititunani,","poem":1},{"text":"kememɨnetenanaimani xeikɨa, mɨpaɨ mekateniku'eriwani.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mekanenihupieka xeikɨa,","poem":1},{"text":"kwi mekaniyɨaka menetsimiekutɨ","poem":2},{"lineBreak":true},{"text":"kwi xeikɨa mekanenixeiyani kenemɨtiyuriene.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nekakaɨyari, 'ahaxɨakɨ mɨkɨ teɨteri keniwarunanaima.","poem":1},{"text":"Nitɨma memuyuta'una pepɨkawapitɨaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"'Ekɨ pepi'inɨata kenemɨtiyuku'unane,","poem":1},{"text":"puteyutsie ne'ukai pepɨkatua.","poem":2},{"lineBreak":true},{"text":"¿Kamɨtsɨ pekareye'utɨa?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kepauka ne parewiya nemɨmetsitawawirieni,","poem":1},{"text":"memɨnetsi'aye'unie mekanitanautsaxɨakuni.","poem":2},{"text":"Ne mɨpaɨ nekatinimaika: Kakaɨyari nehamatɨa puyeika.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kakaɨyari hetsie nepɨtiwiya, niukieya nepɨnɨawa,","poem":1},{"text":"Yawé hetsie nepɨtiwiya, niukieyatsie nepɨnetemawie,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kakaɨyari hetsie nepɨtiwiya, ne nepɨkaheuma.","poem":1},{"text":"¿Ketitarikuta tewi netimakaka 'atsimɨkatiuyuriwe?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kakaɨyari, ne 'ahetsiemieme nepɨnetipiniri,","poem":1},{"text":"ne kenemɨtiyutemawie nepumatitimawirieni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Ekɨ Kakaɨyari, nemekawautsetsie pepɨnetsi'ɨxɨnaxɨ,","poem":1},{"text":"teukiyapa pepɨnetsi'ayeha,","poem":2},{"text":"yuheyemekɨ 'ahɨxie nemɨmienikɨ","poem":1},{"text":"tukarikɨ hekɨariyatsie.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}