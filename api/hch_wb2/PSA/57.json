{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":57,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Yuariyaya xekeneuweiyani «Pepɨkawaka'unani». Rawiri 'utɨarikaya, kepauka Rawiri terɨta mayekatei 'uyu'unarɨmetɨ Tsahuri makatɨ."]},{"type":"verse","number":1,"content":[{"text":"Xɨa'ui Kakaɨyari, kenenenenimayaka,","poem":1},{"text":"keneneutinenimayata, ne 'ahetsie nepɨtiwiya.","poem":2},{"text":"'A'anate 'etɨriyayatɨa nepɨneti'awieta,","poem":1},{"text":"naitɨ 'uximatɨarika ranuyeyayuke nepuwayeyani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kakaɨyari 'Amutewi nekanahiwiwani,","poem":1},{"text":"Kakaɨyari kemɨ'ane mɨnetsiparewie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Muyuawitsie paitɨ 'akawetɨ kaneniutawikweitsitɨwani,","poem":1},{"text":"kemɨ'ane memɨnetsi'uweiya menetsimienike kaniwatate'ani.","poem":2},{"lineBreak":true},{"text":"Kakaɨyari yunaki'eriya meta tita yuri mɨraine kanenanɨ'airiemɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"'Ɨrawetsixi teyukwa'amete wahixɨapa nekaniuweni,","poem":1},{"text":"teɨteri me'ayu'eririyatɨ ne'aurie mekanawetɨkani.","poem":2},{"text":"Watamete 'ɨrɨ meta pitsika kanihɨkɨtɨni.","poem":1},{"text":"Waneni, 'ixipara mataxikauni kanihɨkɨtɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Peru 'ekɨ, Kakaɨyari, muyuawi reuyeta peputewi,","poem":1},{"text":"'axawatɨriya kwie naime kehekɨariwiyani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Winiyari nehuyeta mekaniuwieni,","poem":1},{"text":"'ana nekanewaɨriyatɨ nepatɨa.","poem":2},{"text":"Nehuyeta mekanewatixawarita,","poem":1},{"text":"peru mɨkɨ pɨta muwa mepeukaxɨri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kakaɨyari, ne'iyari pɨheitserie,","poem":1},{"text":"ne'iyari puyuwaɨriya.","poem":2},{"lineBreak":true},{"text":"Nɨawari 'ahetsiemieme nepɨtikwika.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne 'iyari, kenanutanieri.","poem":1},{"text":"Kanari meta xaweri xekenanutanenieri.","poem":2},{"lineBreak":true},{"text":"Hekwame tukari tepanutahɨtɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ti'aitame, nepɨmetsinɨawani teɨteri watsata,","poem":1},{"text":"nɨawari 'ahetsiemieme nepɨtikwika nuiwarite wahɨxie.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Anaki'eriya mɨmariwe muyuawitsie paitɨ mɨye'axekɨ,","poem":1},{"text":"Yuri kepemɨtarahɨawe haitsie paitɨ pɨye'axe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"'Ekɨ, Kakaɨyari, muyuawi reuyeta peputewi,","poem":1},{"text":"'axawatɨriya kwie naime kehekɨariwiyani.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}