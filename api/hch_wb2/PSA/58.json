{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":58,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Kwikarieya xekeneuweiyani «Pepɨkawaka'unani». Rawiri 'utɨarikaya."]},{"type":"verse","number":1,"content":[{"text":"¿Kamɨtsɨ xeme 'itsɨkate, 'aixɨa 'anemekɨ xete'aita,","poem":1},{"text":"yemekɨ xetewaheitseritɨa kepauka teɨteri xemɨxanetɨarie?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Matsi pɨta wa'atɨ, yu'iyaritsie kemɨkatiheitserie xeteku'eriwa,","poem":1},{"text":"meta xenanaimarika mɨkɨ kwieyaritsie kanihekɨaka.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Axateyuruwamete 'amɨtitinuiwatsie 'axameteyurietɨ mekanakɨkani,","poem":1},{"text":"kemɨ'ane memɨte'itawa yumaamama wahetsie paitɨ meyetetɨ mekaneuyexɨrɨweni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kuuterixi mɨyakame kememɨtehexeiya hepaɨ 'aneme mepexeiya,","poem":1},{"text":"kuu 'amumu'uyewa hepaɨ kaheu'enatɨ mayuyeitɨwa","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ka'i'enimɨtɨ timaiweme yuitɨarikaya,","poem":1},{"text":"tsepa kepauka mɨti'uximaya waɨkawa tiwareutayuitɨiriewetɨ kuuterixi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kakaɨyari, keniwaranaye'uniri watamete,","poem":1},{"text":"Yawé, mɨkɨ mayetsi watamete 'amɨtɨtɨ keniwaranatihapaniri.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Amamatetsie haa hepaɨ meke'ukakunetɨkɨne,","poem":1},{"text":"kepauka yutupi memahapani wa'ɨrɨ kehakamurixɨani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kɨrɨpu 'aɨrikaya mɨkareutetere hepaɨ meke'ɨyɨni","poem":1},{"text":"nunutsi mɨkitɨ mutinuiwaxɨ hekɨariya mɨka'uxei hepaɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Atsimekatemaitɨ, xuya hepaɨ meke'anutatani,","poem":1},{"text":"'eka keware'enitsitɨani, tsepa memɨyuyuri yatɨni memɨwawaki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Heitserie mexeiya puyukatemawieni kepauka mɨniere petiwarakapitɨwakaku,","poem":1},{"text":"Kakaɨyari mɨka'ayexeiya xuriyayatsie yewetɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hikɨ teɨteri mɨpaɨ mepɨtiyuani:","poem":1},{"text":"«Puyuri heitserie memu'uwa mepɨte'akapitɨariwa yu'iwarikakɨ,","poem":2},{"lineBreak":true},{"text":"puyuri xewitɨ Kakaɨyaritɨtɨ 'apuyeika kwiepa heitserie tiyurienetɨ».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}