{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":59,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Kwikarieya xekeneuweiyani «Pepɨka'ika'unani». Rawiri 'utɨarikaya, kepauka Tsahuri mɨtiuta'ai Rawiri kiiya mɨhɨriekakɨ meta mɨmierienikɨ."]},{"type":"verse","number":1,"content":[{"text":"Xɨa'ui, Kakaɨyari, keneneutawikweitsitɨa memɨnetsi'aye'unie wahetsɨa,","poem":1},{"text":"nehetsie kenenuaka nemɨmierienekɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Axateyuruwamete wahetsɨa keneneutawikweitsitɨa,","poem":1},{"text":"meta memɨteyumemiwa wahetsɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Keniwaruxeiya kememɨnetehupietɨwe.","poem":1},{"text":"Yawé, teɨteri 'axamete'u'iyaritɨ mekanenimiekuni","poem":2},{"lineBreak":true},{"text":"tsepa ne 'axanekatiyuriene.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mekaniyumexɨitɨaka me'aye'axɨanike","poem":1},{"text":"tsepa ne 'axanekawayuriene.","poem":2},{"lineBreak":true},{"text":"Xeiya kenaye'a keneneuparewi.","poem":1},{"text":"Keneneuxeiya hikɨ kenemɨ'ane.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Ekɨ, Yawé, Kakaɨyari pepɨhɨkɨ Naimekɨmɨtɨrɨkaɨye.","poem":1},{"text":"'Ixaheri Kakaɨyarieya pepɨhɨkɨ.","poem":2},{"text":"Xeiya kenanukukeka keniwaru'uximatɨa yunaime nuiwarite,","poem":1},{"text":"pepɨkawanenimayaka mɨkɨ memɨteyukananaima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tɨkarikɨ mekani'axeni,","poem":1},{"text":"tsɨikɨri wahepaɨ mete'uyuhaxɨatɨwatɨ","poem":2},{"lineBreak":true},{"text":"kiekari warita mekaneuhupatɨkani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mekanatakwaimuxatɨkani yutenie,","poem":1},{"text":"'ixipara yuteta mekanatinenetɨwani,","poem":2},{"lineBreak":true},{"text":"mɨpaɨ me'utiyuatɨ: «Kemɨ'ane kuta pɨtatsi'enie».","poem":2}]},{"type":"verse","number":8,"content":[{"text":"'Ekɨ matsi, Yawé, xɨa'ui pepaine wahetsiemieme,","poem":1},{"text":"pepanawe nuiwarite wahetsiemieme.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Ekɨ, netɨrɨkariya pekanihɨkɨtɨni, 'ahetsɨa nepeutaniere,","poem":1},{"text":"'ekɨtsɨ, Kakaɨyari, nehetsie nunuwame pekanihɨkɨtɨni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Ekɨ Kakaɨyari pekanihɨkɨtɨni pemɨnetsinaki'erie,","poem":1},{"text":"pe'anuyekaitɨ pekaniyemieni","poem":2},{"lineBreak":true},{"text":"nehɨxie pemɨwareka'unakɨ memɨnetsi'aye'unie.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Peru pepɨkawarekukukuyani,","poem":1},{"text":"neteɨterima memɨkatehatɨtɨmaiyanikɨ.","poem":2},{"text":"Keniwaranutarɨwaitɨaxɨa kepemɨtitɨrɨkaɨye, haweri keniwaruyuri.","poem":1},{"text":"Tati'aitɨwame, 'ekɨ tahetsie nunuwame pekanihɨkɨtɨni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yutetakɨ 'axamemutiyuanekɨ,","poem":1},{"text":"yuniukikɨ 'axamemɨteyuriekɨ,","poem":2},{"lineBreak":true},{"text":"kememɨteyutimariwekata winiyaritsie meke'ukaxɨrieni.","poem":2},{"text":"Memɨteyukakwatsekɨ 'itarikakɨ memutiniukakɨ,","poem":1}]},{"type":"verse","number":13,"content":[{"text":"keniwarutixɨtsitɨa 'ahaxɨakɨ,","poem":2},{"lineBreak":true},{"text":"yemekɨ keniwarutixɨtsitɨa memɨka'u'uwanikɨ.","poem":2},{"text":"'Ana yumɨiretɨ mɨpaɨ mepɨtehetimani kename 'aku 'ixaheritsixi wahetsie Kakaɨyari ti'aita,","poem":1},{"text":"metatsiere kwie manu'axe paitɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mɨkɨtsɨ tɨkarikɨ mekani'axeni,","poem":1},{"text":"tsɨikɨri wahepaɨ mete'uyuhaxɨatɨwatɨ","poem":2},{"lineBreak":true},{"text":"kiekari warita mekaneuhupatɨkani.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mana mekaniu'uwani tsepa hakewa 'ikwai meheuwautɨkaitɨ,","poem":1},{"text":"xɨka mekahuxaka mekaniutitsuanani.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ne matsi 'atɨrɨkariya nepɨnɨawani,","poem":1},{"text":"ximerita 'anaki'eriya nepɨnɨawani,","poem":2},{"text":"'ekɨ nehetsie nunuwame pemɨhɨkɨkɨ,","poem":1},{"text":"kepauka nemu'uximatɨarie 'ahetsɨa nepɨneti'awiwieta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"'Ekɨ netɨrɨkariya pekanihɨkɨtɨni, nɨawari nepɨtikwika 'ahetsiemieme,","poem":1},{"text":"'ekɨtsɨ, Kakaɨyari, nehetsie nunuwame pekanihɨkɨtɨni.","poem":2},{"lineBreak":true},{"text":"'Ekɨ Kakaɨyari pekanihɨkɨtɨni pemɨnetsinaki'erie.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}