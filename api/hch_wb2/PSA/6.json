{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":6,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. 'Ikɨ kanari 'atahaikatɨ mawɨtsie ke'utakwikarieni. Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Yawé, pepɨkanetsi'utate'ani peha'atɨ,","poem":1},{"text":"pepɨkanetikwinitɨaka 'ahaxɨakɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yawé kenenenenimayaka nepɨmɨximeri,","poem":1},{"text":"Yawé 'aixɨa kenetineuka'eritɨa netaɨta nepeuhaɨtɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne'iyari waɨkawa pɨyumuina,","poem":1},{"text":"¿kepaukake tamɨ Yawé pepɨnetsiparewieni?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yawé, kenenua tukari keneneupitɨa,","poem":1},{"text":"keneneutawikweitsitɨa 'anaki'eriyakɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mɨkitɨ pɨkayɨwe mɨmatsihaye'erienikɨ,","poem":1},{"text":"'ukateukieme, ¿kemɨ'ane pɨmatsitanɨawa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tsuarikɨ nepu'uxeri tɨkarikɨ,","poem":1},{"text":"ne'itari ne'ukaikɨ pɨyuyuna,","poem":2},{"lineBreak":true},{"text":"ne'utá ne'ukaikɨ nepɨhawiya.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nehɨxite pɨkaheuniereri netiukakukuinetɨ,","poem":1},{"text":"pukwixime memɨnetsi'aye'unie ya'ane mewiwiekaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nehamatɨa xepɨka'u'uwani yunaitɨ 'axaxemɨte'u'iyari,","poem":1},{"text":"Yawé nehiwerika kaniu'enieni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yawé pu'enaxɨ kenemɨtitawawiri,","poem":1},{"text":"Nenenewieri Yawé pu'eni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yunaitɨ memɨnetsi'aye'unie mekaniyutitetewiyakuni meta mekani'iyɨriekuni,","poem":1},{"text":"kwitɨwa mepuyuta'una meyutetewiyatɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}