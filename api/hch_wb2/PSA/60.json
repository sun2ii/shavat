{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":60,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Yuariyaya xekeneuweiyani «Tuturi tɨratuyari». Rawiri 'ɨkitɨarikaya, kepauka 'arameutsixi muwarutakwi Metsuputamiya yeta kiekatari meta Tsiriya hixɨapa kiekatari, meta kepauka Kuhawi makunua tawarita tamamata heimana huta miriyari (12.000) 'erumitsixi muwarukwi mayeweri Maye'unaya mɨrayetewatsie."]},{"type":"verse","number":1,"content":[{"text":"Neuxei, Kakaɨyari, 'ekɨ pepɨtatsihexɨri","poem":1},{"text":"'ekɨ pepɨtatsi'utatsanaxɨ,","poem":2},{"text":"pepɨtatsi'uyehekaxɨ,","poem":1},{"text":"hikɨ 'aixɨa ketaneuyuri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kwie pekaniutayuitɨani,","poem":1},{"text":"pekanitatsiniya,","poem":2},{"text":"'aixɨa keneuyuri mukatataritsie,","poem":1},{"text":"karikɨ kaneuku'unikeni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Waɨkawa temɨta'inɨatsienikɨ pepɨtatsi'upitɨa,","poem":1},{"text":"winu pepɨtatsi'u'itɨa mɨtawaiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"'Ahetsie memɨtewiya 'inɨari keniwaruwewiri","poem":1},{"text":"memɨyuta'unakɨ temɨmɨmete wahɨxie.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Atseriekɨ ketaneutawikweitsitɨa, ketaneta'eiya","poem":1},{"text":"'ateɨterima pemɨwanaki'erie memɨtawikwenikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kakaɨyari mɨpaɨ kanaineni yutukita:","poem":1},{"text":"«Tsikeni nepɨtixiteni nerane'iwatɨ,","poem":2},{"lineBreak":true},{"text":"meta mayeweri Tsukuti nepuwati'inɨatsirieni wakwie.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Karaha nehetsɨa mieme kanihɨkɨtɨni, Manatsexi nehetsɨa mieme kanihɨkɨtɨni,","poem":1},{"text":"'Epɨrahini kuya menaketsa kanihɨkɨtɨni nemu'utsie nunuwame,","poem":2},{"lineBreak":true},{"text":"Kura meta ne'itsɨ kanihɨkɨtɨni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Muhawi hetsie nekaniukamaimawani,","poem":1},{"text":"'Erumi hetsie nekakai nekaneutaxɨrɨwani,","poem":2},{"lineBreak":true},{"text":"Piritsiteu kwieyari hetsie nekanahiwani tetehayu'iwaka».","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"¿Kemɨ'ane pɨnetsi'anuwitɨni kiekari mahɨrietsie?","poem":1},{"text":"¿Kemɨ'ane 'Erumi huyeyari pɨnetsixeitsitɨani?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Ekɨ pekanihɨkɨtɨni, Kakaɨyari, kemɨ'ane mɨtatsi'uku'eiri,","poem":1},{"text":"Kakaɨyari, tawariri takuyaxima wahamatɨa pepɨka'ayeyeika.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ketaneuparewi memɨtatsi'aye'unie wahepaɨtsita,","poem":1},{"text":"neuxei tixaɨtɨ pɨkatiyunaki'erie tewi parewiyaya.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kakaɨyari tatsiparewiekaku tepɨtehayu'iwa,","poem":1},{"text":"mɨkɨ memɨtatsi'aye'unie pɨwatiketsini.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":12}