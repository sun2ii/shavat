{"text":"kemɨ'ane memɨmetsi'ayexeiya kepemɨtiwamikwa neta pepɨnetiyetuiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kwiepa ti'aitame waɨkawa tukari wiyari keneupitɨa,","poem":1},{"text":"tukari kaxɨweme keneupitɨa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Keti'aitani 'ahɨxie yuheyemekɨ,","poem":1},{"text":"'anaki'eriya meta 'aniuki yuri maine ke'i'ɨwiyani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mɨpaɨ nepɨtiukwikani 'ahetsiemieme","poem":1},{"text":"meta nepeye'atɨani kenemutayɨ tukari mɨyehane.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}