{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":62,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Kerutuni hetsiemieme. Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Kakaɨyari hetsie xeikɨa ne'iyari puka'uxipiwe,","poem":1},{"text":"mɨkɨ hetsɨa xeikɨa newikweitsitɨarika payeneika.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mɨkɨ xeikɨa ne'ai 'amautitewa pɨhɨkɨ netsiwikweitsitɨwame,","poem":1},{"text":"mɨkɨ nehetsie nunuwame pɨhɨkɨ.","poem":2},{"lineBreak":true},{"text":"Hatsuaku nepɨkahatiweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"¿Kepaukake xeme xeyunaitɨ xepɨtehayewa","poem":1},{"text":"xe'imietɨwetɨ xeime tewi xemetihɨanikɨ?","poem":2},{"text":"'Ixumeri matiwexime hepaɨ kani'aneni,","poem":1},{"text":"kuraru mɨta'unirɨme hepaɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hakewa meka huyeripana xeikɨa","poem":1},{"text":"mana mepiweiyaku.","poem":2},{"text":"'Itarikatsie temawierika mepexeiya:","poem":1},{"text":"'aixɨa mepɨtehatahɨawe yutenikɨ,","poem":2},{"lineBreak":true},{"text":"yu'iyarikɨ 'axametehaku'eriyatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kakaɨyari hetsie xeikɨa ne'iyari puka'uxipiwe,","poem":1},{"text":"mɨkɨ xeikɨa nepɨtakwewie.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mɨkɨ xeikɨa ne'ai 'amautitewa pɨhɨkɨ netsiwikwetsitɨwame,","poem":1},{"text":"mɨkɨ nehetsie nunuwame pɨhɨkɨ","poem":2},{"lineBreak":true},{"text":"hatsuaku nepɨkahatiweni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kakaɨyari netsiwikweitsitɨwame pɨhɨkɨ witsine'aneme pɨnetsi'ayeitɨa,","poem":1},{"text":"'ai 'amautitewa nehetsie nunuwame kanihɨkɨtɨni,","poem":2},{"lineBreak":true},{"text":"hakewa nemeneti'awieta Kakaɨyari hetsɨa katini'aneni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hetsiena yuheyemekɨ xeketenewiyani, teɨteri hetsɨana miemete,","poem":1},{"text":"'a'iyaritsie ketineuyepiri kepauka hɨxiena pemuwe.","poem":2},{"lineBreak":true},{"text":"Kakaɨyari tahetsie nunuwame kanihɨkɨtɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mɨkɨ teɨteri 'eka hepaɨ mekani'aneni, kemɨ'ane tixaɨtɨ memɨkatehayuyeitɨa,","poem":1},{"text":"teɨteri memamariwaweme memayuyeitɨa 'itarika mepɨhɨkɨ,","poem":2},{"text":"yunaime mɨkɨ xɨka waranuyewieni,","poem":1},{"text":"yunaitɨ mɨkɨ mepɨkahahete.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"'Axamɨti'anetsie xepɨkatewiyani","poem":1},{"text":"witsixepɨkateku'eriwani yu'inawarikɨ,","poem":2},{"text":"tsepa xepiinite mɨtiutimɨirixɨ,","poem":1},{"text":"mɨkɨ hetsie yu'iyari xepɨkatewiyatsitɨaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kakaɨyari yurikɨ pɨraxaxata,","poem":1},{"text":"ne hutakɨa nepi'eni:","poem":2},{"text":"'Ekɨ, Kakaɨyari, pepɨtɨrɨkaɨye,","poem":1}]},{"type":"verse","number":12,"content":[{"text":"'ekɨ, Tati'aitɨwame, pepɨti'akanaki'erie waɨkawa,","poem":2},{"text":"'ekɨ yuxexuime yunaime","poem":1},{"text":"yapepɨtiwarakapitɨwa kememɨte'uyurikɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}