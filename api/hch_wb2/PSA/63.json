{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":63,"content":[{"type":"hebrew_subtitle","content":["Rawiri nɨawarieya, kepauka makumawetsie muyeikakai Kura kwieyaritsie."]},{"type":"verse","number":1,"content":[{"text":"Kakaɨyari, 'ekɨ pepɨnekakaɨyari,","poem":1},{"text":"ne yemekɨ nepɨmetsiwaune.","poem":2},{"text":"Ne 'iyari 'akɨmana peuharimɨkɨ,","poem":1},{"text":"yemekɨ nemetsiheuyehɨwa,","poem":2},{"lineBreak":true},{"text":"kwie mɨwaki haa meuyehɨwa hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"'Atukita nemetsihaxeiyawe","poem":1},{"text":"'atɨrɨkariya meta kepemɨtimariwe nepuxei.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Anaki'eriya 'aixɨa matsi pɨ'ane keyuri tukari,","poem":1},{"text":"'Ayumieme ne nepɨmetsinɨawani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Aixɨa nepaineni 'ahepaɨtsita mexi'akuxi ne'uyeika,","poem":1},{"text":"nepɨmetsihahɨaweni teikɨ nehemetɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ne'iyari 'aixɨa pɨtika'erieni","poem":1},{"text":"'ixɨararipa waɨkawa mɨratikwaiwa hepaɨ,","poem":2},{"text":"waɨkawa yemekɨ nenetemawietɨ,","poem":1},{"text":"nepɨmetsinɨawani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ne'utatsie ne'ukaitɨ nepɨmetsiha'eriwa,","poem":1},{"text":"nepɨmetsiku'eriwa tɨkarikɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'A'anate 'etɨriyayatɨa nepɨkwikani,","poem":1},{"text":"'ekɨtsɨ netsiparewiwame pekanihɨkɨtɨni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne'iyari yuheyemekɨ 'ahetsie pɨtiwiya,","poem":1},{"text":"'amamá 'atserieta mieme pɨnetsikuhana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kemɨ'ane memɨnetsimieku mepɨka'unarieni,","poem":1},{"text":"kwieta meukatewatsie mepɨkayune.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Ixiparakɨ mepɨkwi'iwa","poem":1},{"text":"yawixi memayu'eririya mepɨwatikwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ti'aitame Kakaɨyari hetsiemieme puyutemawieka,","poem":1},{"text":"yunaitɨ kemɨ'ane Kakaɨyari memahɨawe mepitanɨawa,","poem":2},{"lineBreak":true},{"text":"peru memɨte'itawa kayuwatɨ mepɨpitɨarieni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}