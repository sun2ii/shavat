{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":64,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Kakaɨyari, neniuki keneu'eni nekukuiniya hepaɨtsita nemaniuka,","poem":1},{"text":"kenene'ɨwiyani memɨnetsi'aye'unie nemɨkawamakaxenikɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Keneneuti'awieta mɨkɨ Kakaɨyari memɨka'ayexeiya memɨnetsi'uweiyakɨ,","poem":1},{"text":"mɨkɨ 'axamemɨte'u'iyari wahɨxie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yuneni mepɨmɨwa 'ixipara hepaɨ,","poem":1},{"text":"meputiniuka niuki 'axa'anɨyɨnemekɨ 'ɨrɨkɨ memɨte'utamɨmɨni hepaɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mehupatɨri, hetsiena mɨkatiuhɨiwa meputamɨmɨ,","poem":1},{"text":"meka'imariyatɨ 'atsimekatehehɨawetɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kakaɨyari memɨka'ayexeiya yunaitɨ yemekɨ kememɨtexata mepɨyuwaɨritɨa,","poem":1},{"text":"mepi'inɨata kehepaɨ winiyari memɨtewieni,","poem":2},{"lineBreak":true},{"text":"'akuxi matsi mɨpaɨ mekaniutiyuaneni: «¿Kemɨ'ane 'aku pixeiya?»","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tita mɨkatiheitserie mepɨteku'eriwa, mɨpaɨ meputiyuane:","poem":1},{"text":"«Yemekɨ 'aixɨa tepɨteku'eriwa».","poem":2},{"text":"Yemekɨ pɨkayumatiwanɨa","poem":1},{"text":"teɨteri wa'iyaritɨarika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Peru Kakaɨyari wa'ɨrɨkɨ pɨwatimɨni,","poem":1},{"text":"'atsimekateha'eriwatɨ mepatixɨrieni mete'uka'eniwatɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yunenikɨ haweri 'anekɨa mepuyutixɨrieni,","poem":1},{"text":"kehate memɨwaxeiya mepɨwata'atse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yunaitɨ teɨteri mepɨtimamani:","poem":1},{"text":"Kakaɨyari kemɨtiuyuri pɨtaxatsieni","poem":2},{"lineBreak":true},{"text":"'uximayatsikaya mepuku'eriwani.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Heitserie memexeiya Yawé hetsie mekeyutemamawieka,","poem":1},{"text":"hetsiena hakewa memeyu'awietani meke'utiwauni,","poem":2},{"lineBreak":true},{"text":"yunaitɨ 'iyari heitseriemekɨ memexeiya meke'inɨawani.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}