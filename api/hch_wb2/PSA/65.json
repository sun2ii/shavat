{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":65,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Rawiri nɨawarieya. Kwikari."]},{"type":"verse","number":1,"content":[{"text":"'Ekɨ, Kakaɨyari 'aku Tsiyuni mieme,","poem":1},{"text":"Nɨawari pɨ'ahetsiemieme.","poem":2},{"text":"'Ekɨ matsi peuyewetse ketemɨteyɨhɨritɨa temɨmete'aye'atɨiriwani,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"'ekɨtsɨ nenewieri pekani'enieka.","poem":2},{"text":"Yunaitɨ teɨteri 'ahetsɨa mepɨye'axe,","poem":1}]},{"type":"verse","number":3,"content":[{"text":"'axamemɨte'u'iyarikɨ.","poem":2},{"text":"'Axaketemɨteyurie mɨkɨ pɨtatsihatixɨrɨwa,","poem":1},{"text":"'ekɨ matsi pepɨtareuyehɨwirie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Aixɨa ke'itɨarieka 'iya kemɨ'ane 'ekɨ pemanayexei,","poem":1},{"text":"'iya kemɨ'ane 'ahetsɨa pemɨ'atɨa 'atakwa mukanikɨ.","poem":2},{"text":"'Akie timieme 'aixɨa mɨti'anekɨ tekehuxaka,","poem":1},{"text":"kepemɨtatiumi 'atuki mɨpatsieta timiemekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"'Ekɨ, Kakaɨyari 'aku tatsiwikweitsitɨwame,","poem":1},{"text":"pepɨtatsiku'eiya mariwemekɨ heitseriemekɨ,","poem":2},{"text":"'ekɨ pepɨtakwewiya naitsarie kwie manu'axe paitɨ","poem":1},{"text":"meta haramara manu'axe paitɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Ekɨ, 'atɨrɨkariyakɨ, hɨri peputiwewi,","poem":1},{"text":"kepemɨtitɨrɨkaɨye pepɨtiuyuri.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Ekɨ matsi haramara ha'akaku pepinɨtɨa,","poem":1},{"text":"hamewarieya kemɨtiuyuanekai,","poem":2},{"lineBreak":true},{"text":"meta teɨteri wahiwari.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yunaitɨ naitsarie kwiepa memɨtama","poem":1},{"text":"mepɨmama mariwemekɨ kepemɨtiyuriene,","poem":2},{"text":"tau manatineika meta makayuyuipike","poem":1},{"text":"'ekɨ kwikari witsi'anɨyɨneme pepɨwapitɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"'Ekɨ peti'ɨwiyatɨ kwiepa pepɨtiweriya,","poem":1},{"text":"waɨkawamekɨ pepɨtiweriya.","poem":2},{"text":"Kakaɨyari 'akiteyatsie haa pɨhɨpɨne,","poem":1},{"text":"tɨriku teɨteri memexeiyanikɨ.","poem":2},{"lineBreak":true},{"text":"Mɨpaɨ kwie 'aixɨa pekaniyurieka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Xuruku hakɨ pepɨhatuiya, haxu pepɨtipeniya pepekuweririta,","poem":1},{"text":"kwie pepɨyumenariya wiyerikɨ","poem":2},{"lineBreak":true},{"text":"meta tita mɨtitineika 'aixɨa pepɨtiyurie.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Ekɨ xeiwitari xeitaxari pepikemaritɨa waɨkawa petixuaweritɨatɨ,","poem":1},{"text":"kaxetate pɨtihɨpɨrike waɨkawa mɨtixuawekɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"'Ɨxa pɨtsitsiɨrawi makuwakitsie mieme,","poem":1},{"text":"yemurite temawierika kamixateyari panakatɨkɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mukuweweritsie tewaxi kiekari hepaɨ mepɨteyuxexeiya,","poem":1},{"text":"mayeweweritsie tɨriku pɨhɨkɨa,","poem":2},{"lineBreak":true},{"text":"meputikwika meputihiwa temawierikakɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}