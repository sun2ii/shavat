{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":66,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Kwikari. Nɨawari."]},{"type":"verse","number":1,"content":[{"text":"Kakaɨyari xekenehiwieka yutemawierima,","poem":1},{"text":"yunaitɨ teɨteri kwiepa xemɨtama.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nɨawari hetsiena mieme xekeneutikwikani,","poem":1},{"text":"Kakaɨyari witsikemɨ'ane kwikari xekenepitɨaka.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kakaɨyari mɨpaɨ xeketeneutahɨawi:","poem":1},{"text":"«Yemekɨ pɨmamariwawe 'a'uximayatsika.","poem":2},{"text":"Pɨmariwe 'atɨrɨkariya","poem":1},{"text":"memɨmetsi'aye'unie 'ahɨxie memamatɨ mepuyuyetua.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yunaitɨ kwiepa memɨtama 'ahɨxie mepukahɨxima'uwe,","poem":1},{"text":"memetsitanɨawake,","poem":2},{"lineBreak":true},{"text":"kwikari 'ahetsiemieme mepɨtikwika».","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Xekenakɨni xeketeneuxeiya Kakaɨyari kemɨtiyurieni,","poem":1},{"text":"tahetsiemieme mariweme kemɨtiuyuri,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Haramara 'akuwakime kanayeitɨani,","poem":1},{"text":"teɨteri me'uhutɨ mana mekaniukɨne.","poem":2},{"lineBreak":true},{"text":"Tepɨyutemamawieka hetsiena.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yutɨrɨkariyakɨ pɨti'aita yuheyemekɨ,","poem":1},{"text":"naitsarie nuiwarite puwaxeiya.","poem":2},{"lineBreak":true},{"text":"'Axamemɨte'u'iyari hetsiena mepɨkate'uhɨpani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yunaitɨ teɨteri, 'aixɨa xeketenekɨhɨaweni takakaɨyari,","poem":1},{"text":"kwikari hetsiena mieme 'eniɨriɨkɨme xekenayeitɨa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mɨkɨ tatukari kani'ɨwiyani,","poem":1},{"text":"pɨtatsi'ɨwiya temɨkahekaxɨrɨwenikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kakaɨyari 'aku, 'ekɨ pepɨtatsi'uta'inɨataxɨ,","poem":1},{"text":"tepɨa pɨrata hepaɨ 'aixɨa pepɨtatsi'utiyuri.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Winiyaritsie pepɨtatsi'ukaxɨri,","poem":1},{"text":"takwatsapaɨ 'ika raheteme pepɨtatsi'utitɨtɨa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kawayutsixi taheima mepuyekɨ, tamu'ute meputitaraxɨ,","poem":1},{"text":"taipa tepuyekɨ meta hapa,","poem":2},{"lineBreak":true},{"text":"matsi 'imatɨrieka 'aixɨa 'anemekɨ tepupitɨarie.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Atukita nepeutahani mawari taiyariyari nepɨmatsipitɨani","poem":1},{"text":"meta kenemutayɨ nepɨraye'atɨani,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"netenikɨ kenematiutahɨawixɨ","poem":1},{"text":"meta kenemutayɨ netiuka'eniwatɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mawari taiyariyari nepɨmetsiwewirieni tewaxi memɨwaiyatɨkakɨ,","poem":1},{"text":"muxatsi 'ukitsi wamawari kɨtsiyari wahamatɨa,","poem":2},{"lineBreak":true},{"text":"tuurutsixi nepɨmetsitimawirieni meta tsipuri 'ukitsi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Xeme xekenakɨni, Kakaɨyari xemɨmakaxe,","poem":1},{"text":"xekeneu'enana, nepɨtixetaxatɨani","poem":2},{"lineBreak":true},{"text":"mɨkɨ kemɨtiuyuri naime nehetsiemieme.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Netenikɨ nekanitahiwieni,","poem":1},{"text":"nenenikɨ nekanitanɨawa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Xɨka ne'iyaritsie 'axamɨti'ane neranukananike,","poem":1},{"text":"Ti'aitame pɨkanetsi'enienikekai,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"peru neuxei Kakaɨyari kaneniu'enieni,","poem":1},{"text":"yakatiniuyurieni kenemɨtitahɨawixɨ netiuka'eniwatɨ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"'Aixɨa ke'itɨarieka Kakaɨyari,","poem":1},{"text":"nenenewieri manu'enikɨ","poem":2},{"lineBreak":true},{"text":"yunaki'eriya mɨkanetsi'utikweririkɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}