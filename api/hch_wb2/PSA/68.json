{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":68,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Rawiri nɨawarieya. Kwikari."]},{"type":"verse","number":1,"content":[{"text":"Kakaɨyari 'akeneutakexi,","poem":1},{"text":"memɨmetsi'aye'unie mekeheutaweiyariexɨani,","poem":2},{"lineBreak":true},{"text":"meke'uyuta'una kemɨ'ane memi'uxie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yunaitɨ meke'ukumawere,","poem":1},{"text":"kɨtsi 'ekatsie mɨtiupaparike hepaɨ,","poem":2},{"text":"Kakaɨyari memɨka'ayexeiya Kakaɨyari hɨxie meke'ukumawere,","poem":1},{"text":"xɨrɨka taipa kemɨtiutakwanike hepaɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Matsi heitserie memexeiya mekeyutemamawieka pɨta,","poem":1},{"text":"Kakaɨyari hɨxie meke'utikwikani yemekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kakaɨyari xekenenɨawani, kemɨtiuka'iyari nɨawariyari,","poem":1},{"text":"xekenehiwieka kemɨ'ane haiwitɨritsie 'akaitɨ mukuyeika,","poem":2},{"text":"hɨxiena xekeneyutemamawieka.","poem":1},{"text":"Yawé katinitewaka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nutuite wa'ukiyari, wiuraxi wahetsie nunuwame","poem":1},{"text":"Kakaɨyari kanihɨkɨtɨni yutuki mupatsieta 'ayekaitɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kakaɨyari kii puwaxatɨa kemɨ'ane memexɨriya","poem":1},{"text":"meta pɨwaxɨna kemɨ'ane memehapanie,","poem":2},{"lineBreak":true},{"text":"kemɨ'ane memɨtehayuye'unie makuwakitsie mepuyuhayewa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kakaɨyari 'aku, kepauka pemayetɨa 'ateɨterima wahɨxie,","poem":1},{"text":"kepauka makumawetsie pemɨwarayewitɨtɨya,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"kwie kaniutayuani,","poem":1},{"text":"meta muyuawitsie waɨkawa wiyeri kanakaneni,","poem":2},{"text":"Kakaɨyari hɨxie, Tsinahi mieme Kakaɨyari.","poem":1},{"text":"Kakaɨyari hɨxie, 'ixaheritsixi wakakaɨyari.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kakaɨyari 'aku, 'ekɨ waɨkawa wiyeri pepeyenɨ'a,","poem":1},{"text":"'aixɨa pepiyuri kwie tahetsiemieme.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Atɨɨriyama kwiepa mepɨtamarixɨ,","poem":1},{"text":"Kakaɨyari 'aku, petiu'akanaki'erietɨ 'aixɨa pepɨtiuyuri tixaɨtɨ mɨkarexeiya hetsiemieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Tati'aitɨwame yuniuki kaniyetuani,","poem":1},{"text":"yumɨiretɨ hikɨ 'ukari mepikuxata:","poem":2}]},{"type":"verse","number":12,"content":[{"text":"«Mekaniuyu'unarɨmeni te'aitamete meta wakuyaxima,","poem":1},{"text":"kiita memɨteheku'eiri,","poem":2},{"lineBreak":true},{"text":"'ukarawetsixi piinite mekateniyutapitɨwani:","poem":2}]},{"type":"verse","number":13,"content":[{"text":"kukuru 'anateya pɨrata mɨkawiriyarietɨka,","poem":1},{"text":"'anɨteya huru mɨxawawatɨ pɨhɨkɨ.","poem":2},{"lineBreak":true},{"text":"'Ekɨ pepeuku muxatsi watsata».","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kepauka Naimekɨmɨtɨrɨkaɨye te'aitamete kwiepa","poem":1},{"text":"memɨtama mɨwarutawei,","poem":2},{"text":"'ɨwi hepaɨ mepɨteyuxexeyakai","poem":1},{"text":"kemɨtika'unike hepaɨ Tsarimuni hɨriyaritsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Watsani hɨriyari, hɨri mɨmamariwawe,","poem":1},{"text":"Watsani hɨriyari, hɨri kwinimieme mutɨtɨ:","poem":2}]},{"type":"verse","number":16,"content":[{"text":"¿Titayari hɨri kwinimieme mɨtɨtɨ kwi mete'ixexeiya me'ɨtetsatɨ,","poem":1},{"text":"mɨkɨ hɨri Kakaɨyari minake mana muyeikanikɨ,","poem":2},{"lineBreak":true},{"text":"hakewa Yawé yuheyemekɨ meyeikani?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kaxetate kuyaxa mieme Kakaɨyari tipiinieya","poem":1},{"text":"xeimiriyaritsixi mekaniyu'inɨatani,","poem":2},{"text":"Tsinahi paitɨ yeyaka Ti'aitame wahamatɨa kaninuani","poem":1},{"text":"yutukita meutahanikɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yawé Kakaɨyari, kepauka 'ekɨ pemanutitɨa taheima,","poem":1},{"text":"pepɨwarewitɨ memanutaxɨriya,","poem":2},{"text":"waɨkawa 'imikieri pepɨrepi teɨteri memɨmeteyetuiri,","poem":1},{"text":"metatsiere memayu'eririya tiwapiini,","poem":2},{"lineBreak":true},{"text":"mana wahamatɨa pemeyutakiitɨanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"'Aixɨa ketikuxaxatsiwani Tati'aitɨwame, takakaɨyari meta tatsiwikweitsitɨwame,","poem":1},{"text":"tukari manukayeika ta'ikakɨ pɨtatsiparewie.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Takakaɨyari, Kakaɨyari tiyuwikweitsitɨwame pɨhɨkɨ,","poem":1},{"text":"Yawé Tati'aitɨwame pɨkatatsipitɨa temɨkwinikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kakaɨyari kemɨ'ane memaye'unie mɨkɨ wamu'u pɨtipɨna,","poem":1},{"text":"wakɨpate witsimɨ'anene 'axameteyurietɨ memu'uwa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ti'aitame mɨpaɨ kanaineni:","poem":1},{"text":"«Watsani nekanixe'akunuitɨamɨkɨ,","poem":2},{"lineBreak":true},{"text":"haramara meukatewatsie nepɨxehatiwitɨni,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"memɨxe'aye'unie waxuriya xe'ɨkatetsie","poem":1},{"text":"ke'utiwiriere,","poem":2},{"text":"mɨkɨta tsɨikɨri me'itsename","poem":1},{"text":"yuhetsie timieme memɨtehexeiyanikɨ».","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Tukita mepuyuhekɨa","poem":1},{"text":"xuruku me'utɨ memetsi'ayexeiyatɨ tati'aitɨwame.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kwikamete mepanuyetei,","poem":1},{"text":"wa'ɨtɨma teyuitɨwamete,","poem":2},{"lineBreak":true},{"text":"wahamatɨa 'ukari memɨte'utikatse.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"'Aixɨa xeketenehekɨatani Kakaɨyari xeɨripa,","poem":1},{"text":"Yawé xekenenɨawani, 'Ixaheri nuiwarimama.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kaniwaruwitɨximeni temaikɨ nuiwari Wenikamini,","poem":1},{"text":"wa'utɨmata yumɨiretɨ te'aitamete Kura nuiwariyaritsie miemete","poem":2},{"lineBreak":true},{"text":"metatsiere te'aitamete Tsawuruni meta Nepɨtahari kiekatari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Kakaɨyari 'aku, 'atɨrɨkariya kenanakanɨ'a,","poem":1},{"text":"Kakaɨyari 'aku, keneuhekɨata 'atɨrɨkariya,","poem":2},{"lineBreak":true},{"text":"tahetsiemieme 'aixɨa pemɨtiuyurikɨ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"'Atuki Kerutsareme muwekɨ","poem":1},{"text":"te'aitamete mepɨmetemini 'aixɨa mɨti'ane.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Keneutati'a mɨkɨ tupiriyatsata muwe mariwetɨ 'axati'anetɨ,","poem":1},{"text":"mɨkɨ memayu'eririya tuurutsixi","poem":2},{"lineBreak":true},{"text":"nuiwarite watsata tsikerutsixi wahepaɨ memɨteyuxexeiya.","poem":2},{"text":"Yaketineuyuri pɨrata tepɨayari mɨmetsiyetuirienikɨ 'utatsuatɨ,","poem":1},{"text":"nuiwarite keniwarutaweiya 'axamemɨte'u'iyari.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"'Ekipitu pɨwaranɨ'ani yuhetsɨa miemete,","poem":1},{"text":"Kutsi Kakaɨyari hetsɨa punuani mɨkɨ ti'aitɨwame mayanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Kwiepa te'aitamete 'aku, Kakaɨyari xekeneutakwikani,","poem":1},{"text":"nɨawari ti'aitame hetsiemieme xekeneutikwikani,","poem":2}]},{"type":"verse","number":33,"content":[{"text":"kemɨ'ane haiwitɨritsie 'akaitɨ mukuyeika,","poem":1},{"text":"muyuawi meripaitɨ mieme hetsie,","poem":2},{"text":"niukieya mɨ'enieriekakɨ yamɨtiyuriene,","poem":1},{"text":"niukieya mutatɨrarɨka.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Xekenemaika Kakaɨyari tɨrɨkariyaya,","poem":1},{"text":"katini'aitani 'ixaheritsixi wahetsie,","poem":2},{"lineBreak":true},{"text":"tɨrɨkariyaya meutitewatsie kanixuaweni.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Kakaɨyari 'aku, 'atukita pepɨmariwe,","poem":1},{"text":"'ixaheritsixi wakakaɨyari tɨrɨkari pɨtiyupitɨwa, yuteɨterima tɨrɨkariya pɨwapitɨa.","poem":2},{"lineBreak":true},{"text":"Kakaɨyari 'aixɨa ketikuxaxatsiwani.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/68.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":35}