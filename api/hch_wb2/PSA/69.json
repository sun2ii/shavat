{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":69,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. «Tuturi» kwikariyari xekeneuweiyani. Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Nekakaɨyari, keneneutawikweitsitɨa,","poem":1},{"text":"nekɨipitɨa paitɨri haa puku'axe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nepɨkayunirɨme putsu meukatewata,","poem":1},{"text":"titatsie nerakeni pumawe.","poem":2},{"text":"'Amutiyewatsie hixɨapa nepuyewie,","poem":1},{"text":"haa muhane pɨnetsi'uhautsitɨaxime.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nepu'uxeri parewiya neha'iwawatɨ,","poem":1},{"text":"nekɨipitsie nepanatiwakiri.","poem":2},{"text":"Nehɨxite pu'u'uxeri,","poem":1},{"text":"Kakaɨyari parewiyaya netakwewietɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nekɨpate kemɨpaɨme reuyeta","poem":1},{"text":"mepɨyupaɨme memɨnetsixani'erie yakɨxeikɨa,","poem":2},{"text":"mepuyumɨire memɨnetsi'aye'unie 'itarikakɨ","poem":1},{"text":"memɨnetsimieku.","poem":2},{"lineBreak":true},{"text":"¿Titakuta netiyetuani nemɨkatiunawa?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kakaɨyari 'aku, 'ekɨ pepɨtimate nemɨkayukɨhɨawekɨ,","poem":1},{"text":"ke'axanemɨtiuyuri nemɨtiuti'awieta nepɨkayɨwe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yawé Tati'aitɨwame, Naimekɨmɨtɨrɨkaɨye,","poem":1},{"text":"mepɨkatewinɨarieka ne 'axanemɨtiuyurikɨ","poem":2},{"lineBreak":true},{"text":"memɨmetsitakwewie,","poem":2},{"text":"'Ixaheri Kakaɨyarieya 'aku,","poem":1},{"text":"mepɨkaha'iwarieka nehetsiemieme","poem":2},{"lineBreak":true},{"text":"kemɨ'ane memɨmetsikuwautɨwe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Ahetsiemieme nepɨtiuka'eniwa ne'utatieriwatɨ,","poem":1},{"text":"nehɨxie nepayenɨtsa tewiyarikɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne'iwama wahetsiemieme nemɨkamatiwani hepaɨ nekani'aneneni,","poem":1},{"text":"'ateewa kiekame nekanihɨkɨtɨni nemaama niwemama wahetsiemieme.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Akii nemukweriekɨ netaɨta nepɨtaxɨtsitɨariexime,","poem":1},{"text":"nehetsie xeikɨa katininakeni","poem":2},{"lineBreak":true},{"text":"memɨmetsi'aye'unie watierika.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kepauka nemutatsuakatsie meta kepauka nemɨnehakietsie,","poem":1},{"text":"nekatininewiekamɨkɨ kememɨnetehahɨaweni,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"kepauka hiwerika kamixayari nemanakatɨkɨtsie,","poem":1},{"text":"'atsieriwame nekanihɨkɨtɨni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kitenie memutayaxike nehepaɨtsita niuki mekanixɨatɨaka,","poem":1},{"text":"memɨtarɨwe 'axa'anemekɨ mekaneniutakwikani.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Peru Yawé, neuxei nepumetiwawirie","poem":1},{"text":"hikɨ 'ekɨ mɨpaɨ mumetinakekɨ.","poem":2},{"text":"Kakaɨyari 'aku, 'anaki'eriya mɨmariwekɨ, keneneuta'eiya,","poem":1},{"text":"'aixɨa pemɨtikamiekɨ, keneneutawikweitsitɨa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kenenewatihani muyehaxuyatsie,","poem":1},{"text":"nemɨkayunekɨ pepɨkanetsipitɨaka.","poem":2},{"text":"Keneneɨxɨna memɨnetsixani'erie wahetsie,","poem":1},{"text":"hata 'ameukatewatsie.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Pepɨkanetsipitɨaka haa mɨnetsihehautsitɨwanikɨ,","poem":1},{"text":"muwatixawa 'emeukatewa mɨnetsiheukakwa'anikɨ pepɨkanetsipitɨaka,","poem":2},{"lineBreak":true},{"text":"meta teukiya neheima muwiwikenikɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yawé, keneneta'eiya 'aixɨa pemɨtiuka'iyari naki'eriya pemexeiyakɨ,","poem":1},{"text":"yemekɨ pemɨti'akanenimayakɨ, nehetsɨa kenenua.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"'Ikɨ meti'uximayatsiriwame pexeiyatɨ pepɨkatikuhayeikawani,","poem":1},{"text":"yapauka keneneta'eiya, nepɨtiuka'eniwa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"'Ahurawa kenayaka, keneneutawikweitsitɨa,","poem":1},{"text":"keneneɨxɨna memɨnetsi'aye'unie watsata.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"'Ekɨ pepɨtimate kememɨnete'ute'a,","poem":1},{"text":"nenetewiyame mepɨnetsi'ayeitɨwa,","poem":2},{"lineBreak":true},{"text":"pepɨtimate kemɨ'ane memɨnetsi'aye'unie.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Watierika ne'iyari kaniutatsana,","poem":1},{"text":"nehetsiemiemeri xɨari pɨkayɨwe 'aixɨa mɨtiyɨni.","poem":2},{"text":"Nenimayatsika neputiwau, nepɨka'ikaxei,","poem":1},{"text":"nɨtɨarika neputiwau, nepɨka'itaxei.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ne'ikwaitsie matsiwi mepɨkaye,","poem":1},{"text":"neheuharimɨkɨkaku matsina mepɨnetsi'uharitɨa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Wawiniyari kehayani wa'ixɨarari,","poem":1},{"text":"memɨte'ukaxexeiya wawiniyari kehayani.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Wahɨxite ke'utiture, memɨkaheunenierenikɨ,","poem":1},{"text":"watɨrɨkariya ke'uxɨni yuheyemekɨ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"'Ahaxɨa wahetsie keneukawiwi,","poem":1},{"text":"'ahaxɨa kewaranuku'axe.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Makumawe ke'ayani memakutei,","poem":1},{"text":"waxamaru ke'uxaxawani.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Yemetsɨ kemɨ'ane pemɨ'uximatɨani kaniuweiyarieka,","poem":1},{"text":"kemɨ'ane pemɨtikwinitɨani kaninanaimarieka mɨtiuka'eniwakɨ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"'Axakemɨtiyuriene keneutinɨitɨa waɨkawa 'axamɨti'ane,","poem":1},{"text":"'awikweitsitɨarikatsie pepɨkawaraye'uitɨaka.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Meke'ayeyeitɨarieni tukari xapayaritsie,","poem":1},{"text":"heitserie memexeiya wahamatɨa mepɨka'aye'uka.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Kakaɨyari 'aku, ne tixaɨtɨ nemɨkarexeiya meta nemɨtiuka'eniwa,","poem":1},{"text":"'awikweitsitɨarika nehetsie kenuaka.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Kwikarikɨ nepinɨawani Kakaɨyari kemɨtitewa,","poem":1},{"text":"pamɨpariyutsikɨ 'aixɨa nepɨrehɨaweni.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Mɨkɨ mawari matsi Yawé pinakire","poem":1},{"text":"keyuri tuuru yatɨni tsikeru","poem":2},{"lineBreak":true},{"text":"ha'awatɨ meta 'anuketatɨ.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Tixaɨtɨ memɨkatehexeiya mɨkɨ metexeiyame mepuyutemamawieka,","poem":1},{"text":"xeme xekeneyuwaɨriyani, Kakaɨyari xemukuwautɨwe.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Karikɨ Yawé kaniwa'enieka kemɨ'ane memɨteheuyehɨwa,","poem":1},{"text":"meta yuteɨterima memehapanie pɨkawarexɨrɨwa.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Meke'inɨawani muyuawi meta kwie,","poem":1},{"text":"haramara meta yunaitɨ mana memɨteye'uwa,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Kakaɨyari Tsiyuni kanitawikweitsitɨamɨkɨ,","poem":1},{"text":"meta Kura kiekariyari kananukuketɨamɨkɨ.","poem":2},{"text":"Mana mekanikumarikuni teɨterimama","poem":1},{"text":"kwie wahetsiemieme kanayeimɨkɨ.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Wahetsiemieme katinayeimɨkɨ te'uximayatame waniwema,","poem":1},{"text":"Ti'aitame memɨnaki'erie mana mekanitiyaxikuni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}