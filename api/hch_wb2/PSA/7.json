{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":7,"content":[{"type":"hebrew_subtitle","content":["Rawiri yuhiwerietɨ Yawé kemɨtiutahɨawixɨ Kutsi Wenikamini tewiyari hepaɨtsita."]},{"type":"verse","number":1,"content":[{"text":"Keneneutawikweitsitɨa, Yawé nekakaɨyari, 'ahetsɨa nemɨneti'awiwietakɨ.","poem":1},{"text":"Nehetsie keneutanua yunaime memɨnetsi'uweiya wahepaɨtsita.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Xɨka mɨpaɨ pekatiuyurieni, mekanenitakwaikuni mayetsi wahepaɨ,","poem":1},{"text":"mekanenitatsanakuni, xewitu nehetsie pɨkatanuani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yawé nekakaɨyari, ¿kekuta netiuyuri?,","poem":1},{"text":"¿ketitakɨ 'axanetiuyuri?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Xɨka nehamiku 'axane'uyurieni,","poem":1},{"text":"xɨka netikuhɨwirieni kemɨ'ane mɨnetikwinitɨa,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"kamɨtsɨ mɨnetsi'aye'unie kenetsi'anukuweiya kenetsi'anuku'axe,","poem":1},{"text":"kwiepa kenetsi'ukahɨani","poem":2},{"lineBreak":true},{"text":"meta tsepari tixaɨtɨ mɨkanerayeitɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yawé, keneuyeha'a,","poem":1},{"text":"memɨnetsi'aye'unie kememɨteha'a wahepaɨtsita.","poem":2},{"text":"Kakaɨyari, 'aixɨa ketineuyuri kenenaye'eri.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"'A'aurie teɨteri mekeyukuxeɨrieni,","poem":1},{"text":"pemɨtita'aitakɨ mɨkɨ watsata 'ameutitewatsie.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"'Ekɨ, Yawé, teɨteri wa'itsɨkame pepɨhɨkɨ.","poem":1},{"lineBreak":true},{"text":"Nehetsieta yaketineuyuri heitseriemekɨ kenemɨtiuyeikakɨ,","poem":1},{"text":"yakenetinakapitɨa kenemɨtiuyurikɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kakaɨyari heitserie pemexeiya, 'ekɨ pemɨtimate wa'iyari kemɨtiku'eriwa,","poem":1},{"text":"ketineukumaweriya 'axateyuruwamete ke'axamemɨteyurie","poem":2},{"lineBreak":true},{"text":"keneparewieka heitserie mexeiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kakaɨyari nehetsie nunuwame pekanihɨkɨtɨni,","poem":1},{"text":"'aixɨa memɨteyukɨhɨawe pekaniwawikweitsitɨaka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kakaɨyari 'itsɨkame 'aixɨa mɨtiuka'iyari kanihɨkɨtɨni,","poem":1},{"text":"Kakaɨyari kaniwahekani 'axamemɨteyurie tukarikɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xɨka 'axamɨtiuka'iyari katiuhayewa,","poem":1},{"text":"Kakaɨyari yu'ixipara kanikuha'aritɨamɨkɨ meta yutupi,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'ari mɨɨya kaniukuha'aritɨani,","poem":1},{"text":"meta 'ɨrɨ tai mexeiya kaniukuha'arita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Xekeneuxeiya 'axamɨtiuka'iyari:","poem":1},{"text":"'Axamɨti'anekɨ kanitihukatamɨkɨ, 'itarika kanitiniwemɨkɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Aheukatewame kaniuti'ine,","poem":1},{"text":"muwata kaneukawemɨkɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ke'axamɨtiyuriene yɨkɨmana katiniyukwinitɨamɨkɨ,","poem":1},{"text":"mu'uyatsie kanikawemɨkɨ kemɨtiukananaima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Yawé nepɨnɨawani 'aixɨa mɨtiuka'iyarikɨ.","poem":1},{"text":"Yawé 'amutewi nepɨtemawieritɨani kwikarikɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}