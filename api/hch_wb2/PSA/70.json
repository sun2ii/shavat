{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Rawiri 'iwaurikaya."]},{"type":"verse","number":1,"content":[{"text":"Kakaɨyari 'aku, xeiya keneneutawikweitsitɨa,","poem":1},{"text":"Yawé, xeiya keneyumexɨitɨatɨ keneneuparewi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kemɨ'ane memɨnetsimieku","poem":1},{"text":"mekeheuyuyexɨrieni meha'iwarieme.","poem":2},{"text":"Mekeyutewiyatsitɨani mekete'uhayewa 'atsimekateyurieme,","poem":1},{"text":"yunaitɨ kemɨ'ane memɨnetsika'unaku.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yu'utɨma mekehekɨne, meyutetewiyatɨ,","poem":1},{"text":"yunaitɨ kemɨ'ane haweri memɨnetsiyurie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Matsi kemɨ'ane memɨmetsikuwautɨwe","poem":1},{"text":"'ahetsie mekeyutemawieka, yemekɨ,","poem":2},{"text":"kemɨ'ane 'awikweitsitɨarika memɨnaki'erie mɨpaɨ meke'utiyuaneni:","poem":1},{"text":"«Kakaɨyari kanimariweni».","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ne tixaɨtɨ nepɨkarexeiya yemekɨ nepɨreuyehɨwa,","poem":1},{"text":"Kakaɨyari 'aku, xeiya kenaye'a.","poem":2},{"text":"'Ekɨ netsiparewiwame pepɨhɨkɨ, netsixɨname,","poem":1},{"text":"Yawé, 'apepɨkareutewini.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}