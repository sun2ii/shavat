{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":71,"content":[{"type":"verse","number":1,"content":[{"text":"Yawé, ne 'ahetsɨa nepɨne'awieta,","poem":1},{"text":"nemɨtewinɨarieka pepɨkanetsipitɨaka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Heitserie pemɨtiyurienekɨ, nehetsie keneutanua keneneɨxɨna,","poem":1},{"text":"keneneu'eni, keneneutawikweitsitɨa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Ekɨ kenehɨkɨtɨni neterɨ muwa nemuyuti'awiwieta,","poem":1},{"text":"muwa xeikɨa yuheyemekɨ nemeta'axeni kenehɨkɨtɨni,","poem":2},{"text":"ketineuta'aita nemɨtawikweitsitɨarienikɨ,","poem":1},{"text":"'ekɨ 'ai nehetsie nunuwame pemɨhɨkɨkɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nekakaɨyari, keneneɨxɨna, 'axateyuruwamete memɨnetsiwiyakɨ,","poem":1},{"text":"'axateyuruwamete meta memɨteyukananaima watɨrɨkariyatsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yawé, 'ekɨ Ti'aitame, nepɨmetsitakwewie,","poem":1},{"text":"temaikɨyari paitɨtɨ 'ahetsie nepɨtiwiya.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Ahetsie xeikɨa nepɨtiwiya nemutinuiwaxɨtsie paitɨtɨ,","poem":1},{"text":"'ukaratsitsie pepɨnetsiyenuiwitɨa.","poem":2},{"lineBreak":true},{"text":"Yuheyemekɨ nepɨmetsinɨawani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yuwaɨkawame wahepaɨtsita, 'inɨari nepɨhɨkɨ,","poem":1},{"text":"matsi 'ekɨ nehetsie nunuwame pepɨhɨkɨ pemɨkawatayuane.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne nepɨmetsinɨawa yemekɨ waɨkawa,","poem":1},{"text":"tukarikɨ kepemɨtimariwekɨ nepɨtikuxata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kepauka 'ukiratsi nemayani pepɨkanetsihehɨpani,","poem":1},{"text":"kepauka nemɨkayɨweni pepɨkanetsi'uku'e'eiriwani.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Metsɨ memɨnetsi'aye'unie nehepaɨtsita mieme mekatenikuxatani,","poem":1},{"text":"kemɨ'ane memɨnetsihupie mekanenikuxatani.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mɨpaɨ mekaniutiyuaneni: «Kakaɨyari kaniku'eirieni.","poem":1},{"text":"Xekenanukuweiya xekenewiya, xewitɨ hetsiena pɨkahetanuani».","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nekakaɨyari, pepɨkanetsi'uku'e'eiriwani,","poem":1},{"text":"Nekakaɨyari, xeiya kenaye'a pemɨnetsiparewienikɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nehetsie memɨte'ahɨpa tixaɨtɨ mekatehɨkɨtɨtɨ meke'ukwini,","poem":1},{"text":"keniwarutewiyatsitɨa","poem":2},{"lineBreak":true},{"text":"kemɨ'ane memɨnetsi'atihɨanikɨ memukuwaɨtɨwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Netsietɨ nemenitakwewieka,","poem":1},{"text":"matsi waɨkawa nemeninɨawani waɨkawa nekaniyutemawieka.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tukarikɨ nepikuxatani","poem":1},{"text":"ke'aixɨa pemɨtiyuriene meta 'awikweitsitɨarika,","poem":2},{"lineBreak":true},{"text":"tsepanetɨ yemekɨ naime nemɨtitaxata nemɨkayɨwe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yawé Ti'aitame, nepitaxata 'a'uximayatsika mɨmamariwawe,","poem":1},{"text":"nepaye'erieni heitserie kepemɨtiyuriene,","poem":2},{"lineBreak":true},{"text":"heitserie xeikɨa kepemɨtiyuriene.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kakaɨyari 'aku, 'ekɨ pepɨnetiuti'ɨkitɨa temaikɨyari paitɨ,","poem":1},{"text":"hikɨ 'akuxi nepikuxata mariweme kepemɨtiyuriene.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kepauka 'ukiratsi nemayani,","poem":1},{"text":"kepauka nemumutuxakari,","poem":2},{"lineBreak":true},{"text":"Kakaɨyari 'aku, pepɨkanetsi'uku'e'eiriwani,","poem":2},{"text":"'umemahu 'atɨrɨkariya newataxatɨayuke,","poem":1},{"text":"memɨkatinunuiwawawe 'akuxi","poem":2},{"text":"kepemɨtiuyuri newataxatɨayuke.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kakaɨyari 'aku, 'ekɨ mariweme pepɨtiuyuri,","poem":1},{"text":"heitserie kepemɨtiyuriene meutitewatsie pɨye'axe.","poem":2},{"lineBreak":true},{"text":"¿Kakaɨyari 'aku, kemɨ'ane 'aku 'ahepaɨ pɨtiuka'iyari?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Waɨwaka 'uximatɨarikatsie pepɨnetsi'atiwitɨxime,","poem":1},{"text":"matsi tawarita tukari pepɨnetsipitɨani,","poem":2},{"text":"kwieta meukatewatsie paitɨ","poem":1},{"text":"tawarita muwa pepɨnetsi'atihana.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Tawarita waɨkawa netɨrɨkaɨyeme pepɨnetsi'ayeitɨani","poem":1},{"text":"'ana pepɨnetsinɨtɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Nekakaɨyari, ke'aixɨa pemɨtikamiekɨ,","poem":1},{"text":"nepɨmetsinɨawani kanaritsie,","poem":2},{"text":"nepɨmetsinɨawani, 'ixaheritsixi wakakaɨyari mɨpatsie,","poem":1},{"text":"xawerikɨ nepɨmetsinɨawani.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kepauka nɨawari 'ahetsiemieme nemɨtikwika","poem":1},{"text":"neputahiwani neyutemawietɨ,","poem":2},{"lineBreak":true},{"text":"'ekɨtsɨ netukari pekaniutawikweitsitɨani.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Tukarikɨ yaxeikɨa nepɨtikuxatani","poem":1},{"text":"keheitserie pemɨtiyuriene,","poem":2},{"text":"karikɨ kemɨ'aneri memɨnetsika'unakukai","poem":1},{"text":"mekaniutewiyatsitɨarieni mekaneuyuyexɨrieni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}