{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":72,"content":[{"type":"hebrew_subtitle","content":["Tsarumuni nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Kakaɨyari 'aku, heitserie hexeiyame kenayeitɨa 'ikɨ ti'aitame,","poem":1},{"text":"meta heitserie kepemɨrexeiya ti'aitame nu'aya mɨpaɨ ketineupitɨa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mɨkɨ 'ateɨterima pɨwataheitseritɨani","poem":1},{"text":"meta heitserie mehexeiyame pɨwarayeitɨani tixaɨtɨ memɨkateheuxeiya 'ahetsɨa miemete.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hɨrite 'aixɨa pɨtiwayatsa 'ateɨterima,","poem":1},{"text":"hɨri 'amanutitɨtɨ heitserie pɨwapitɨani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ti'aitame tixaɨtɨ memɨkateheuxeiya heitserie pɨwapitɨani","poem":1},{"text":"meta yemekɨ memɨteheuyehɨwa pɨwatawikweitsitɨani,","poem":2},{"lineBreak":true},{"text":"mɨkɨ pɨwatipɨna 'axamemɨte'u'iyari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ti'aitame ke'uyeikani keti'aitametɨni xeimiriyari nuiwariyaritsie,","poem":1},{"text":"tau hepaɨ meta metsa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Etsaripa kemɨtiukawiwiye hepaɨ ke'aneni,","poem":1},{"text":"wiyeri kwie mɨtiuhawiya hepaɨ ke'aneni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Uyeikakaku mɨtiheitserie keranayuhayewani,","poem":1},{"text":"waɨkawa ketixuaweni tita memɨteheuyehɨwa,","poem":2},{"lineBreak":true},{"text":"kepaukake metsa makayune.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ti'aitame keti'aitani huta haramarayari tsata","poem":1},{"text":"haa 'Epɨrata manuyeka 'atsita kwie hakewa meu'axe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hɨxiena meke'utihɨxima'uni makumawetsie nuiwarite memɨtitei,","poem":1},{"text":"tumuanari meke'utikwani memeye'unie","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Taritsi kwieyaritsie te'aitamete meketeyutuaka","poem":1},{"text":"meta haramara tetsita 'anutaɨye","poem":2},{"text":"te'aitamete mekete'i'atɨiriwani","poem":1},{"text":"Tsawani meta Tsewa kiekatari.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yunaitɨ te'aitamete hɨxiena meke'ukahɨxima'uni,","poem":1},{"text":"yunaitɨ nuiwarite mekete'i'uximayatsirieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mɨkɨ piparewieni kemɨ'ane parewiya ma'iwawani,","poem":1},{"text":"meta tixaɨtɨ mɨkarexeiya pɨparewieni mɨkarekaparewiwame.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Pɨwatinenimayata tixaɨtɨ memɨkate'ayeitɨarie meta tixaɨtɨ memɨkatehexeiya,","poem":1},{"text":"haweri memɨ'anene watukari pɨtawikweitsitɨani.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Pɨwaxɨna kememɨtenanaimarie,","poem":1},{"text":"mɨtimatekɨ watukari meuyewetsekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ti'aitame ke'uyeikani.","poem":1},{"text":"Huru keyetuiriyarieni Tsawa mieme.","poem":2},{"text":"Ketiyunenewitɨni hetsiena mieme yuheyemekɨ,","poem":1},{"text":"'aixɨa ke'itɨarieka naime tukaritsie.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Naime kwieyaritsie tɨriku kexuaweni,","poem":1},{"text":"hɨritsie paitɨ ke'uwetuarɨkani tɨriku.","poem":2},{"text":"Riwanu hepaɨ 'uriyari ke'utipaɨmere,","poem":1},{"text":"manukuyari tupiriya 'ɨtsita mieme hepaɨ ke'utipaɨmere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kekuxaxatsiwani yuheyemekɨ,","poem":1},{"text":"tau hepaɨ kereutere ku'eriwatɨ.","poem":2},{"text":"Hetsiena mieme nuiwarite 'aixɨa mekeyuyurieka,","poem":1},{"text":"yunaitɨ mɨkɨ 'aixɨa mekete'ikɨhɨaweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Yawé Kakaɨyari 'aixɨa ketikɨhɨawarɨwani,","poem":1},{"text":"'Ixaheri Kakaɨyarieya,","poem":2},{"lineBreak":true},{"text":"muyuxewi xeikɨa mariweme mɨtiyuriene.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"'Aixɨa keraniuwani hetsiena mieme yuheyemekɨ,","poem":1},{"text":"kemɨtimariwe ke'utahekɨatsieni naitsarie.","poem":2},{"lineBreak":true},"'Aixɨa pɨ'ane, 'aixɨa pɨ'ane."]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Rawiri nenewierieya 'Itsahi nu'aya 'enapu'axe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}