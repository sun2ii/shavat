{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":73,"content":[{"type":"heading","content":["XAPA 3"]},{"type":"hebrew_subtitle","content":["'Atsahapi nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Yurikɨ, Kakaɨyari 'aixɨa pɨtiuka'iyari 'Ixaheri hetsɨa,","poem":1},{"text":"'iyari 'aixɨa mɨ'anene memexeiya wahetsɨa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne nekanatiwenitɨma,","poem":1},{"text":"'etsiwatɨkaku nekanekaxikiuna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nepɨwarekahekatɨya newaruxeiyaka","poem":1},{"text":"'axateyuruwamete mete'ukaxexeiyakaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mɨkɨ nitixaɨtɨkɨ mepɨkate'ukakukuine,","poem":1},{"text":"'aixɨa mepɨteheu'erie.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hipatɨtɨma 'axamepɨkatewakumamateke,","poem":1},{"text":"hipame wahepaɨ mepɨkate'uka'eniwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kememɨteyuti'ɨre kuka memakatɨtɨkani hepaɨ mepɨteyuxexeiya","poem":1},{"text":"kememɨtewananaima 'ixurikikɨ kememɨte'anuyuku'eima hepaɨ mepɨ'anene.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Axamɨti'anekɨ mepɨhɨpɨne,","poem":1},{"text":"matsi paitɨ mepɨmatsiɨkɨ ke'axamemɨteyuriku.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mepɨteyukatawe'erie, 'ayehutamekɨ meputiniuka,","poem":1},{"text":"meha'atɨ mepɨteyu'aitɨwa meta mepɨteyute'a.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yuniukikɨ muyuawi hepaɨtsita 'axamepɨtiyuane,","poem":1},{"text":"yuniukikɨ kwiepa mepɨte'aita.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Ayumieme wahetsɨa mepeta'axe teɨteri,","poem":1},{"text":"yuri mepɨtewa'eririe kememutiyuane.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Atsita mɨpaɨ mekaniutiyuani: «¿Kekuta Kakaɨyari retimani?","poem":1},{"text":"¿Kamɨtsɨ 'Amutewi timaiwe?»","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mɨpaɨ mekani'aneni Kakaɨyari memɨka'ayexeiya,","poem":1},{"text":"tixaɨtɨkɨ mekateyu'iyaritɨatɨ, matsi waɨkawa metehexeiyatɨ mepakɨka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yurikɨ, ¿tita tiyunaki'erie","poem":1},{"text":"ne'iyari 'itiyakame nemayeitɨakakɨ,","poem":2},{"lineBreak":true},{"text":"meta nemamate 'atsimɨkatiyuruwanikɨ,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"tukarikɨ netiweiwatɨ,","poem":1},{"text":"meta ximeri netiuka'enitsitɨariwatɨ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Xɨka mɨpaɨ ne'utayɨnike: «Wahepaɨ nepɨtiuniukani»,","poem":1},{"text":"'anuiwarima nepuwakwamanakekai.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kepauka nemɨtimaimɨkɨkai naime,","poem":1},{"text":"'ika nepukaxei neka'iwerime,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kakaɨyari tukieyata neheutahakake,","poem":1},{"text":"muwa nepɨretima 'axateyuruwamete hakewa memeyehu:","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yurikɨ, 'ekɨ huye mɨxikiunitsie pepɨwara'uitɨa,","poem":1},{"text":"pepɨwaranataima memukumawerekɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yapauka mepeuyehɨiyani,","poem":1},{"text":"yemekɨ memariutsietɨ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Xewitɨ tiheinɨtɨ manutaniere hepaɨ,","poem":1},{"text":"mɨpaɨ, kepauka Ti'aitame pemanukukeni,","poem":2},{"lineBreak":true},{"text":"mɨkɨ pepuwaratɨmaiyatsitɨani ke'axamemɨteyumate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ne'iyari puyuhiweriekai","poem":1},{"text":"nepɨkanewaɨriyakai,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"'atsinekatimaitɨ.","poem":1},{"text":"Yeutanaka hepaɨ nepuyɨ 'ahepaɨtsita.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ne matsi yuheyemekɨ 'ahamatɨa nepuyeika,","poem":1},{"text":"'ekɨtsɨ 'atseriekɨ pekaneniwiyani.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"'A'ɨxatsikɨ pepɨnetsi'uwitɨxime,","poem":1},{"text":"'arike matsi witsi'aneme pepɨnetsi'ayeitɨani.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"¿Kemɨ'ane 'aku muyuawitsie nepexeiya metsɨ 'ekɨ xeikɨa?","poem":1},{"text":"Xɨka 'ahamatɨa ne'uyeikani, kwiepa timiemeri nepɨkareuyehɨwa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Tsepa newaiyari mɨtimɨxime meta ne'iyari,","poem":1},{"text":"matsi Kakaɨyari ne'iyari pɨtseiriyani,","poem":2},{"lineBreak":true},{"text":"mɨkɨ nehetsiemieme xeikɨa kanihɨkɨtɨni yuheyemekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Mepɨkwini kemɨ'ane memɨmetsi'uku'eiri,","poem":1},{"text":"'ekɨ pepɨwaka'una 'ahetsie memɨkatewiya.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Matsi 'aixɨa pɨ'ane Kakaɨyari hamatɨa nemuyeikani 'ahurawa.","poem":1},{"text":"Yawé Ti'aitame nehetsie nunuwame","poem":2},{"lineBreak":true},{"text":"nepayeitɨa, naime wewiyaya nemɨtikuxatanikɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}