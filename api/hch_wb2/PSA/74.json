{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":74,"content":[{"type":"hebrew_subtitle","content":["'Atsahapi kwikarieya."]},{"type":"verse","number":1,"content":[{"text":"Kakaɨyari 'aku, ¿titayari","poem":1},{"text":"petatiuku'eiri yuheyemekɨ?","poem":2},{"text":"¿Titayari waɨkawa petiuyeha'a","poem":1},{"text":"'amuxatsima wahepaɨtsita?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Keniwaraye'eri teɨteri","poem":1},{"text":"pemɨwaranayexei meripaitɨ,","poem":2},{"text":"nuiwari pemuwarɨxɨnaxɨ","poem":1},{"text":"'ahetsɨa memumiemetetɨnikɨ.","poem":2},{"text":"Kenaye'eri 'ikɨ Tsiyuni hɨriyari,","poem":1},{"text":"hikɨ pemanukatsie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kenaye'a yuheyemekɨ mɨti'u'uni hepa,","poem":1},{"text":"tuki naime kaniuka'una mɨtatsi'aye'unie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Memɨmetsi'aye'unie 'axeɨripa mekaniuyuhaxɨatɨatɨkɨkani,","poem":1},{"text":"patera mekanika'uitɨwani kename metehayu'iwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kɨ'ewemete wahepaɨ yeuta mekateniyuxexeiyani,","poem":1},{"text":"hatsakɨ kɨyexi mehawiteketɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hatsakɨ meta titsunamekɨ","poem":1},{"text":"mekanitimuraxɨani kɨyexite ti'utɨarietɨkaime.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Atuki mekaniutataiya,","poem":1},{"text":"pemuwayeka kapatsiekame mekanayeitɨani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yu'iyaritsie mɨpaɨ mekaniutiyuani: «Naxi tekaneyeitɨakuni».","poem":1},{"text":"Tinaime mekateniutitaiya hakewa makupatsietɨkateitsie mana kwiepa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tepɨka'ixeiyari tapatera 'ateewa 'uyewiekame,","poem":1},{"text":"Kakaɨyari niukameyari pumawe,","poem":2},{"text":"'etsiwa tɨma tepɨkatemate","poem":1},{"text":"kemɨreutere mɨpaɨ tiyɨanetɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kakaɨyari 'aku, ¿Kepaukake mepɨtehayewa memɨtatsi'aye'unie metatsinanaimatɨ?","poem":1},{"text":"¿Yuheyemekɨ 'axame'utiyuatɨ 'ahepaɨtsita?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"¿Titayari kayuwatɨ petiuma pemɨkayɨweni hepaɨ?","poem":1},{"text":"¿Titayari 'atapa perawie?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kakaɨyari 'aku, 'ekɨ neti'aitɨwame pepɨhɨkɨ meripaitɨtɨ,","poem":1},{"text":"'ena kwiepa 'ekɨ wikweitsitɨarika pepexeiya.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Ekɨ haramara pepukumanaxɨa 'atɨrɨkariyakɨ,","poem":1},{"text":"haramaratsie memɨteye'uwa memɨmamariwawe wamu'ute peputitaraxɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Ekɨ Rewiyatahini mu'uya peputataraxɨ,","poem":1},{"text":"pepɨwarumi makumawetsie memɨte'u'uwa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Ekɨ pepɨtiuyuri haixa pemanetɨaxɨa meta hatɨa,","poem":1},{"text":"haa manuyehapane waɨkawa pepikawatsiɨxaxɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Pɨti'apiini tukari, meta tɨkari,","poem":1},{"text":"'ekɨ metsa mana pepuyeye meta tau,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"kwie hakewa meuye'atɨkani 'ekɨ pepi'inɨaritɨa,","poem":1},{"text":"witarita meta xexerixa pepayeitɨwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Yawé, kena'eriwani mɨmetsi'aye'unie payu'ɨre,","poem":1},{"text":"teɨteri yuri memɨkate'erie 'ahetsiemieme 'axamepaitɨka.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Memayu'eririya wahetsiemieme","poem":1},{"text":"'akukuru mɨtakwaiyanikɨ pepɨka'iyetuayani,","poem":2},{"text":"pepɨkawaratɨtɨmaiyani, hikɨ nihatsuaku,","poem":1},{"text":"tixaɨtɨ memɨkatehexeiya watukari.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kena'eriwani 'atɨratu,","poem":1},{"text":"naitsarie 'ikɨ kwieyaritsie","poem":2},{"lineBreak":true},{"text":"nanaimarika xeikɨa kanixuaweni.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Haweri mɨranuyemie pepɨkapitɨaka mɨnanaimarieka,","poem":1},{"text":"kemetsinɨawani kemɨ'ane mɨreuyehɨwa meta tixaɨtɨ mɨkarexeiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Kakaɨyari 'aku, xeiya tahetsie keneutanua,","poem":1},{"text":"kena'eriwani tukarikɨ 'axakememutiyuane 'ahepaɨtsita memɨka'u'iyari.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Keneu'eni memɨmetsi'aye'unie wahiwari,","poem":1},{"text":"kememutiyuane mekatehayewatɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":23}