{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":75,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Yuariyaya xekeneuweiyani «Pepɨka'ika'unani». 'Atsahapi nɨawarieya. Kwikari."]},{"type":"verse","number":1,"content":[{"text":"Kakaɨyari 'aku, pamɨpariyutsi tepɨmetsipitɨa,","poem":1},{"text":"'aixɨa 'anemekɨ tepɨmetsihahɨawe,","poem":2},{"lineBreak":true},{"text":"yunaitɨ naitsarie 'a'uximayatsika mɨmamariwawe mepukuxata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"'Ekɨ mɨpaɨ pepaine: «Kepauka ne yanemɨra'eriwani,","poem":1},{"text":"'aixɨa mɨ'anekɨ nepɨwaranutaxɨrieni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kepauka kwie mutayuane","poem":1},{"text":"meta teɨterimama yunaitɨ,","poem":2},{"lineBreak":true},{"text":"ne nekanihɨkɨtɨni 'aixɨa nemikuyuruwa».","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«Xepɨka'uyuti'ɨreni», mɨpaɨ nekatiniwarahɨaweni memuyuti'ɨre.","poem":1},{"text":"«Temaiwawemete xepɨka'ayuyeitɨaka», Kakaɨyari memɨka'ayexeiya nekatiniwarahɨaweni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"«Temaiwawemete xepɨkayu'erieka muyuawitsie miemekɨ,","poem":1},{"text":"xepɨka'utiniukani witsi'anemekɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tewi mariwetɨ mayeitɨariwanikɨ tau manatineika pɨkamieme,","poem":1},{"text":"meta makayuyuipiketsie tatsutua,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"matsi Kakaɨyari pɨhɨkɨ 'itsɨkame:","poem":1},{"text":"hipame pɨwahiweritɨa, hipameta 'aixɨa pɨwayurie.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yawé mamayatsie tekɨxi kanaweni winu mukwaimuxa,","poem":1},{"text":"haxɨaya kanihɨkɨni 'uyematɨ meta tiyutsata tinɨtɨ,","poem":2},{"text":"kepauka mɨkɨ mitiyeurieni,","poem":1},{"text":"yunaitɨ kwiepa memɨtama Kakaɨyari memɨka'ayexeiya","poem":2},{"lineBreak":true},{"text":"mekaniti'ikuni kepaukake memiyexɨni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ne 'ikɨ hepaɨtsita nepɨtikuxatani yuheyemekɨ,","poem":1},{"text":"nepinɨawani Kakuwu Kakaɨyarieya.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kwinimieme memɨteyuti'ɨre Kakaɨyari meka'ayexeiyatɨ pekaniwarakumaweriyamɨkɨ,","poem":1},{"text":"meta heitserie memexeiya watɨrɨkariya hetsiemieme 'aixɨa nekanitayɨmɨkɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}