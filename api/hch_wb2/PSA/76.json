{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":76,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Kanaritsie xekeneutikwikani. 'Atsahapi nɨawarieya. Kwikari."]},{"type":"verse","number":1,"content":[{"text":"Kakaɨyari pɨmatiwa Kura kwieyaritsie,","poem":1},{"text":"'Ixaheri kwieyaritsie mariwemekɨ pumatiwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tsareme mɨrakutewatsie tukieya puwe,","poem":1},{"text":"Tsiyuni pɨkiekariena.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mana pitimuraxɨ 'ɨrɨ 'aixɨa mɨ'anene,","poem":1},{"text":"kuya kɨmana muyukunarɨma, 'ixiparate, naime kuyaxa timieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Witsipepɨ'ane,","poem":1},{"text":"'ekɨ matsi pepɨmariwe keyuri hɨri yuheyemekɨ mieme.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Memɨtehayu'iwa hikɨ mepatixɨriwa,","poem":1},{"text":"teukiyapa mepeukaxɨriwa.","poem":2},{"text":"Nixewitɨ mɨkɨ teɨteri yukukuyamete","poem":1},{"text":"yumamate pɨka'anukuhapani mɨwaparewienikɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kakuwu Kakaɨyarieya, kepauka 'ekɨ pemɨwarutiti,","poem":1},{"text":"kawayutsixi meta memanatei meputimama mepɨkayɨwawekai memɨyekɨnekɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Ekɨ, yuheyemekɨ xeikɨa pepɨmakaxiwani.","poem":1},{"text":"¿Kemɨ'ane 'aku pɨmetsiha'iwa","poem":2},{"lineBreak":true},{"text":"kepauka 'ekɨ pemɨyeha'ani?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Muyuawitsie paitɨ pepihekɨataxɨ heitserie kepemɨti'uximaya,","poem":1},{"text":"kwie, matɨ, kayuwatɨ pɨtimakai.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kakaɨyari 'aku, kepauka 'ekɨ pemayetɨa heitserie petiyurienike,","poem":1},{"text":"tixaɨtɨ memɨkatehexeiya kwiepa memɨtama wahetsiemieme pewatawikweitsitɨanike.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tewi haxɨaya nɨawari 'ahetsiemieme payeika,","poem":1},{"text":"Kemɨ'ane memuyukuhayewa meteka'eniexɨame 'ixɨarari mekameniwewiriekuni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yawé yukakaɨyari hetsɨa yaxeketeneuyuhɨritɨa, meta xeketenaye'atɨwani,","poem":1},{"text":"yunaitɨ kwie wa'aurie mukumanetsie","poem":2},{"lineBreak":true},{"text":"mekete'iyetuiriwani Kakaɨyari mɨmakaxiwa,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"kuwexinaruritsixi watɨrɨkariya mɨwakunawairiwa,","poem":1},{"text":"kemɨ'ane kwiepa te'aitamete memayemakaxe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}