{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":77,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Kerutuni hetsiemieme. 'Atsahapi nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Kakaɨyari nepahɨawe ne'iwawirietɨ yemekɨ,","poem":1},{"text":"Kakaɨyari nepahɨawe mɨnetsi'eniekɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kepauka nemu'uximatɨarie, ti'aitame neputiwawa,","poem":1},{"text":"tɨkarikɨ neka'uxetɨ teikɨ nepememe,","poem":2},{"lineBreak":true},{"text":"peru 'akuxi nepɨkanɨtɨariewe ne'iyaritsie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kakaɨyari nepa'eriwa, matsi neputatsuaka,","poem":1},{"text":"hetsiena nepɨnekɨhɨawe, yemekɨ nepeɨmɨmɨkɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pepɨkanetsipitɨa nemɨkutsuni,","poem":1},{"text":"kwinimieme nepɨti'uximatɨarie nepɨkaniuwe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nepɨraye'eriwa meripaitɨ timieme,","poem":1},{"text":"meripaitɨ wiyaritsie kemɨtiuyɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nepa'eriwa kepauka ne'iyari muyutemawiekai.","poem":1},{"text":"Hikɨ matsita 'ipaɨ nepɨtiyɨkɨhɨawe:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"«¿Tarexɨrienitsɨkamɨ ti'aitame yuheyemekɨ?","poem":1},{"text":"¿Tawaritsɨkamɨ ke'aixɨa mɨtiuka'iyari mɨpaɨ katiyɨni?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"¿Kamɨtsɨ naitɨ tiuyɨ naki'eriyaya mɨkaxɨwekai,","poem":1},{"text":"meta naimekɨ kemɨtarahɨawekai yuheyemekɨ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"¿Ratɨmai Kakaɨyari ke'aixɨa mɨtiuka'iyarikai,","poem":1},{"text":"yuhaxɨakɨri katareunenimaya?»","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mɨpaɨ nepɨti'eriwa: «'Ikɨ yemekɨ pɨnetsihekukukuine:","poem":1},{"text":"'Amutewi yɨtɨrɨkariyakɨ pɨkatatsiparewie».","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nepiku'eriwa pɨta Yawé kemɨtiuyuri,","poem":1},{"text":"nepe'eriwa mariweme kemɨtiuyuri meripaitɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nepɨnekɨhɨaweni mariweme kemɨtiuyuri,","poem":1},{"text":"nepikuxatani yutɨrɨkariyakɨ kemɨtiuyuri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kakaɨyari 'aku, naitɨ 'ahuye pɨpatsie kepemɨtiyurienekɨ,","poem":1},{"text":"kakaɨyaritɨtɨta xewitɨ pumawe hepaɨna timariwetɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Ekɨ Kakaɨyari pepɨhɨkɨ mariweme pemɨtiyuriwe,","poem":1},{"text":"'atɨrɨkariya pemɨhekɨata teɨteri wahetsie.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Atɨrɨkariyakɨ 'ateɨterima pepuwarɨxɨnaxɨ,","poem":1},{"text":"Kakuwu nuiwarimama meta Kutse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kakaɨyari 'aku, haa pɨmetsi'utimaka,","poem":1},{"text":"haa mepɨmetsi'uxei hikɨ hamewari mepuwewi,","poem":2},{"lineBreak":true},{"text":"mɨkɨ meta haramara 'ameukatewa putima.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Haiwitɨri wiyeri pukaxɨri,","poem":1},{"text":"muyuawi tɨranarikɨ putayua,","poem":2},{"lineBreak":true},{"text":"muyuawi merɨkariyakɨ putatsanixɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Petayua 'ayuariya haikɨri 'amɨpatsie,","poem":1},{"text":"'amerɨkariya kwie puhekɨariyaxɨ,","poem":2},{"lineBreak":true},{"text":"kwie putayua yuariyakɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Haramaratsie 'ahuye pepanuwewi,","poem":1},{"text":"haa waɨkawa 'apametsie pepɨtɨa,","poem":2},{"lineBreak":true},{"text":"peru 'aketate pɨka'uhekɨarixɨ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Muitsexi 'Aruni wahekɨ,","poem":1},{"text":"'ateɨterima pepɨwarewitɨ muxatsi wahepaɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}