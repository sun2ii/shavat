{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":78,"content":[{"type":"hebrew_subtitle","content":["'Atsahapi 'ɨkitɨarikaya."]},{"type":"verse","number":1,"content":[{"text":"Neteɨterima, ne'ɨkitɨarika xekene'enieka,","poem":1},{"text":"kenemaine xekene'enanaka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne 'ɨxatsikɨ nepɨtitaxata,","poem":1},{"text":"meta meripaitɨ timieme tita 'atsimɨkatimatsiɨkɨkai,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"tita temɨte'u'eni meta tita temɨtemate,","poem":1},{"text":"tapaapama memɨtate'utaxatɨa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tanuiwari tepɨkawati'awitsirieni,","poem":1},{"text":"'umemahu tepɨtewataxatɨani.","poem":2},{"text":"Yawé tɨrɨkariyaya meta mamariwaweme kemɨtiuyuri","poem":1},{"text":"meta witsiti'aneme kemɨtiuyuri.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mɨkɨ 'aitsika putaxa Kakuwu hetsiemieme,","poem":1},{"text":"'aitsika putahekɨataxɨ 'Ixaheri hetsiemieme,","poem":2},{"text":"tatutsima pɨtiwaruta'aitɨa","poem":1},{"text":"yunuiwarima memɨtewata'ɨkitɨanikɨ,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"memimaikakɨ nuiwarite 'umemahu","poem":1},{"text":"meta waniwema memɨtinunuiwa,","poem":2},{"lineBreak":true},{"text":"mɨkɨta yuniwema memɨtewati'ɨkitɨanikɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Ana mɨpaɨ Kakaɨyari hetsie metewiyatɨ memakɨnekɨ","poem":1},{"text":"meta kemɨtiuyuri memɨkahatɨtɨmaiyanikɨ,","poem":2},{"lineBreak":true},{"text":"matsi memeye'atɨwanikɨ 'aitsikateya.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mɨpaɨ yututsima wahepaɨ memɨka'anenikɨ:","poem":1},{"text":"mɨkɨ nuiwari memɨkayukɨhɨawekai,","poem":2},{"text":"memɨka'u'iyarikai,","poem":1},{"text":"mɨkɨ yu'iyarikɨ Kakaɨyari hetsie memɨkatewiyakai.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Epɨrahini nuiwarimama, yu'ɨrɨ me'utɨtɨ","poem":1},{"text":"mepuyuta'unaxɨ kepauka memuyutakwitsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mɨkɨ Kakaɨyari wahamatɨa tɨratu kemɨtiuwewiekai mepɨkaheye'atɨa,","poem":1},{"text":"matsi pɨta mepiku'eiri 'aitsikateya.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mepetɨmai kemɨtiuyuri,","poem":1},{"text":"mariweme wahɨxie kemɨtiuwewi,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"wapaapama wahɨxie mariweme kemɨtiuyuri,","poem":1},{"text":"'Ekipitutsie Tsuhani kwieyaritsie.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Haramara hixɨapa puhuyetaxɨ mana memukɨnekɨ,","poem":1},{"text":"haa pɨti'ukai 'ixumeri hepaɨ peutiheitseriekai.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tukarikɨ haiwitɨri puwaruwitɨximekai,","poem":1},{"text":"tɨkarikɨta taikɨ pɨwahekɨariwiyakai.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Makumawetsie 'ai hixɨapa puxite,","poem":1},{"text":"pɨwaruharitɨa haa kwinimieme tiuhaneme,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"'aitsie haa panetɨa haa 'aki'utɨma mieme hepaɨ,","poem":1},{"text":"haa panetɨa hatɨa mieme hepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Peru tawarita hepaɨtsitana 'axamepɨte'uyuri,","poem":1},{"text":"makumawetsie Kakaɨyari 'Amutewi mepaye'uniekai.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Naimekɨ Kakaɨyari meputa'inɨataxɨ,","poem":1},{"text":"'ikwai mepitawawiri tita memɨteheukwaikukai.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Niuki mepɨxɨatɨakai Kakaɨyari hepaɨtsita, matsi 'akuxi mɨpaɨ meputiyua:","poem":1},{"text":"«¿Kakaɨyari kamɨtsɨ tiyɨwe mexa makumawetsie mutakeni tatiminike?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kepauka tete muwatsie,","poem":1},{"text":"haa kwinie panetɨya tɨrɨkaɨyetɨ,","poem":2},{"text":"perutsɨ ¿'ikwai tatiumiwe tsiere?,","poem":1},{"text":"¿yuteɨterima wai tsɨkamɨ tiwarumiwe?»","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yawé kepauka mɨkɨ mɨtiu'eni, waɨkawa kaniuyeha'ani,","poem":1},{"text":"puyeha'a Kakuwu hepaɨtsita,","poem":2},{"lineBreak":true},{"text":"puyeha'a 'Ixaheri hepaɨtsita.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kakaɨyari hetsie memɨkate'uwikɨ,","poem":1},{"text":"yuri memɨkate'eriekaikɨ kename mɨkɨ watawikweitsitɨani.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Meutitewatsie paitɨ haiwitɨri mɨpaɨ katiniuta'aitɨani,","poem":1},{"text":"hikɨ muyuawitsie katineuyepiere.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Manana mɨkawiyekɨ yatiniuyurieni memɨtekwanikɨ,","poem":1},{"text":"hatsi muyuawitsie mieme kaniwarumini.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yunaitɨ mɨkɨ niukituayamete wa'ikwai mekaniutikwani,","poem":1},{"text":"Kakaɨyari 'ikwai kaniwareyenɨ'airieni kaniwarutihuxaitɨani.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kakaɨyari 'eka tɨrɨkaɨyeme kaniuyuitɨani tau manatineikatsie,","poem":1},{"text":"yutɨrɨkariyakɨ 'eka tatsutɨa mieme kanewatihana.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"'Eka tumuanari kemɨtiukawiwiwa, mɨpaɨ wai katiniukawiwieni,","poem":1},{"text":"wikixi haiwitɨriyari kaniwa'atɨirieni, xiekari hepaɨ mepɨteyuxexeiyakai.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Mematitekai wahixɨapa kaniwarukaxɨrieni","poem":1},{"text":"meta waxamaru 'aurie.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Meteniukwani wa'iyaritsie katineuyeyani,","poem":1},{"text":"Kakaɨyari katiniwaraye'atɨirieni kememutiyua.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Peru waheiwe'erika 'apɨkareuterixɨ:","poem":1},{"text":"'ikwai yuteta 'akuxi mepayeyekai,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"kepauka Kakaɨyari haxɨaya wahetsie munua:","poem":1},{"text":"'ukitsi waɨkawa memɨtɨrɨkawi kaniwarukwini,","poem":2},{"lineBreak":true},{"text":"temari 'ixaheritsixi 'aixɨa memɨ'anene kaniwarukwini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Mɨyamete'anuyekɨnekatɨtɨ,","poem":1},{"text":"yaxeikɨa 'axamekateniyuriekaitɨni","poem":2},{"lineBreak":true},{"text":"yuri mekapɨte'uta'eri mariweme kemɨtiyurienekai.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"'Ayumieme, Kakaɨyari watukari","poem":1},{"text":"'etsitewime kanayeitɨani xei'itukariyari hepaɨ,","poem":2},{"lineBreak":true},{"text":"watukari waɨkawa mematimariutsiwatsie kanitixɨrɨweni.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Kepauka Kakaɨyari muwaku'uximatɨwakai, mɨkɨta 'anake mekanitiwawakaitɨni,","poem":1},{"text":"meyuwaɨriyatɨ tawarita mekani'axekaitɨni hetsɨana.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Mekanaye'eriwakaitɨni kename Kakaɨyari wa'ai hɨkɨ,","poem":1},{"text":"kename Kakaɨyari 'Amutewi wawikweitsitɨwame hɨkɨ.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Peru 'arike yutetakɨ mekanikwamanakaitɨni,","poem":1},{"text":"yunenikɨ mekani'itakaitɨni.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Yu'iyarikɨ Kakaɨyari mepɨka'ayexeiyakai,","poem":1},{"text":"yamepɨkatekakɨ tɨratuya kemainekai.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Hikɨ mɨkɨ puwarutinenimayataxɨ, wakwewietɨ,","poem":1},{"text":"pɨtiwareuyehɨwiri 'axakememɨte'uyuri,","poem":2},{"lineBreak":true},{"text":"pɨkawaruka'unaxɨ.","poem":2},{"text":"Mɨixa pɨka'uyeha'a pɨyunɨtɨakai,","poem":1},{"text":"pɨtinewakai kemɨtiyɨanekai pɨkaha'akai.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Paye'eri kename tixaɨtɨ mekatehɨkɨtɨkai mekwiwawekai,","poem":1},{"text":"'etsiwa xeikɨa yamɨreutetere 'eka hepaɨ tawarita pɨkanuani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Mɨixa me'eye'unietɨ mepakɨ makumawetsie","poem":1},{"text":"mepinutuitaxɨ yemekɨ makuwakitsie.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Kakaɨyari yamepɨte'inɨatatɨwekai,","poem":1},{"text":"Mɨpatsie 'Ixaheri hetsiemieme mepɨhaxɨatɨakai.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Mepɨkaheye'eri kemɨtitɨrɨkaɨyekai,","poem":1},{"text":"kemɨtiwaruwitɨ me'uximatɨariekaku,","poem":2}]},{"type":"verse","number":43,"content":[{"text":"'Ekipitu mariwemekɨ kemɨtiuyuri,","poem":1},{"text":"meta kemɨtiuyuri yutɨrɨkariyakɨ Tsuhani kwieyaritsie,","poem":2}]},{"type":"verse","number":44,"content":[{"text":"kepauka haa 'Ekipitu mieme xuriya mayeitɨa","poem":1},{"text":"mepɨkayɨwawekai memɨtihareni 'aki'utɨma,","poem":2}]},{"type":"verse","number":45,"content":[{"text":"kepauka nakatarixi mɨwarenɨ'a memɨwatikenikɨ,","poem":1},{"text":"meta temutsi memɨwaka'unakɨ,","poem":2}]},{"type":"verse","number":46,"content":[{"text":"kepauka 'utsikari wawaxata mɨwarenɨ'a,","poem":1},{"text":"'utsikari memuyuwaɨkawa wa'etsita memɨte'ukaxɨ,","poem":2}]},{"type":"verse","number":47,"content":[{"text":"kepauka tee wakaxie nanari mutituaxixɨ","poem":1},{"text":"meta xapa 'iteɨriyari 'ɨwi mitiwatsiɨxaxɨ,","poem":2}]},{"type":"verse","number":48,"content":[{"text":"kepauka tee tewaxi mɨwarukwi,","poem":1},{"text":"meta muxatsi mimierɨkarikɨ,","poem":2}]},{"type":"verse","number":49,"content":[{"text":"kepauka wahetsɨa yuhaxɨa meutahɨa,","poem":1},{"text":"ha'atɨ, kawanenimayatɨ, waraye'unietɨ:","poem":2},{"lineBreak":true},{"text":"kuyaxi niuki tuayamete teyu'unamete pɨwarenɨ'a.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Yuhaxɨa kaniutatuani,","poem":1},{"text":"pɨkawarutawikweitsitɨa mɨkitsata,","poem":2},{"lineBreak":true},{"text":"matsi pɨwayetua kwiniya tsata.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Tɨɨri yunaime pɨwarukwi mexɨakate 'Ekipitutsie,","poem":1},{"text":"matɨari miemete Kami memakutekaitsie.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"Yuteɨterima pɨware'ari muxatsi wahepaɨ,","poem":1},{"text":"makumawetsie pɨwarewitɨ, muxatsi wahepaɨ,","poem":2}]},{"type":"verse","number":53,"content":[{"text":"tiwa'ɨkitɨatɨ hetsiena memɨtewiyanikɨ memɨkaheumamakakɨ.","poem":1},{"text":"Peru memɨwaraye'uniekai haramarakɨ kaniwaranukanani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":54,"content":[{"text":"Yuteɨterima kwie mɨpatsietsie kaniwa'atɨani,","poem":1},{"text":"'ikɨ hɨri yutseriekɨ me'iwaxɨ.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"'Ixaheritsixi wahetsiemieme nuiwarite kaniwarayeweiya,","poem":1},{"text":"mɨkɨ kwie yuteɨterima kaniwayetuirieni,","poem":2},{"lineBreak":true},{"text":"memɨwayetekaitsieta 'ixaheritsixi kaniwareutayatsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":56,"content":[{"text":"Peru mɨkɨ Kakaɨyari mekaniuta'inɨata:","poem":1},{"text":"Mɨmariwe me'aye'unietɨ mekanakɨne","poem":2},{"lineBreak":true},{"text":"'aitsikateya mepɨka'anu'eni.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Heitserie mepɨka'u'uwakai 'axamepɨte'u'iyarikai,","poem":1},{"text":"yupaapama wahepaɨ,","poem":2},{"lineBreak":true},{"text":"'axamepɨte'u'iyarikai watupi mututuni hepaɨ mepɨ'anenekai.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Mekaniyehaxɨatɨani tukite 'etsimupepe memutiwewikɨ,","poem":1},{"text":"mamakɨ wewiyakate memuwarayexeiyakaikɨ.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Kakaɨyari retimaika waɨkawa kaniuyeha'ani,","poem":1},{"text":"mɨkɨkɨ 'ixaheritsixi kaniwaruku'eirieni.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Tuki Tsiru muwekai kaniuku'eirieni,","poem":1},{"text":"tukieya manuwekai 'ena kwiepa,","poem":2}]},{"type":"verse","number":61,"content":[{"text":"memɨwaraye'unie kaniwarupitɨani tɨrɨkariyaya witsimɨ'ane memanukwenikɨ.","poem":1}]},{"type":"verse","number":62,"content":[{"lineBreak":true},{"text":"Kwinimieme pɨtiuyeha'a yuteuterima wahetsiemieme,","poem":1},{"text":"hipame 'ixiparakɨ memɨwakwinikɨ kaniwarupitɨani.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Temari taikɨ mekaniukwi'iwa,","poem":1},{"text":"kwikari 'ukari mematiwikiwa wahetsiemieme pukumawerixɨ,","poem":2}]},{"type":"verse","number":64,"content":[{"text":"mawari wewiwamete 'ixiparakɨ mepukwi'iwaxɨ,","poem":1},{"text":"wiuraxi mepɨka'uyɨwekaxɨa wahetsiemieme memuyuhiwerieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":65,"content":[{"text":"Hikɨ 'ana Ti'aitame kananutaniere,","poem":1},{"text":"tiheinɨtɨ xewitɨ manutaniere hepaɨ,","poem":2},{"text":"yumemiwame winukɨ kwinimieme mɨtiuhiwa hepaɨ.","poem":1}]},{"type":"verse","number":66,"content":[{"lineBreak":true},{"text":"Memɨwaraye'uniekai mema'iwarienikɨ yakatiniuyurieni,","poem":1},{"text":"memɨyutitetewiyakɨ yuheyemekɨ yakatiniuyurieni.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"Kutse niwemama kaniwarexɨrieni,","poem":1},{"text":"'Epɨrahini xiɨyarimama pɨkawaranayexei,","poem":2}]},{"type":"verse","number":68,"content":[{"text":"matsi pɨta, Kura nuiwarimama pɨwaranayexei,","poem":1},{"text":"meta Tsiyuni hɨriyari mɨnaki'erie.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"Yutuki kaniutawewieni, heutitewame muyuawi hepaɨ,","poem":1},{"text":"kwie hepaɨ, ke'aixɨa miyuri yuheyemekɨ.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"Rawiri tiyu'uximayatsiriwame kananayexeiya,","poem":1},{"text":"muxatsi mɨwahɨwemetɨkai,","poem":2}]},{"type":"verse","number":71,"content":[{"text":"kaninawairieni muxatsi wa'arɨwame mɨhɨkɨtɨkai,","poem":1},{"text":"Kakuwu hɨwemeya mayanikɨ meta teɨterimama,","poem":2},{"lineBreak":true},{"text":"'ixaheritsixi wahɨweme hetsɨana miemete.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"Rawiri yu'iyarikɨ kaniwarutahɨni,","poem":1},{"text":"timaiwetɨ kaniwaku'arienekaitɨni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/78.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/79.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/77.json","previousChapterAudioLinks":{},"numberOfVerses":72}