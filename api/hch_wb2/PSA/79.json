memahane wahetsiemieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¿Yawé, kepaukake tamɨ?","poem":1},{"text":"¿Kamɨtsɨ 'aheyemekɨ petiha'aka?","poem":2},{"lineBreak":true},{"text":"¿'Ahaxɨa kamɨtsɨ tai hepaɨ tiutataweni?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Keniwaruyeheka 'iya nuiwarite memɨkametsimatekɨ,","poem":1},{"text":"te'aitamete memɨkametsihahɨawekɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Neuxei Kakuwu kaniutakwaiyani,","poem":1},{"text":"meta mɨkɨ kwieyari 'unime mekanayeitɨani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Meripaitɨ ke'axatemɨte'uyuri kenatɨmaiya,","poem":1},{"text":"yapauka ketaneutinenimayata,","poem":2},{"lineBreak":true},{"text":"neuxei tame tekaniyumuinani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Xɨa'ui Kakaɨyari, tatsiwikweitsitɨwame,","poem":1},{"text":"mariweme pemɨtiyuriwe kepemɨtitewakɨ, ketaneuparewi,","poem":2},{"lineBreak":true},{"text":"'aixɨa pemɨtiuka'iyarikɨ, ketaneɨxɨna 'axatemɨte'uyurikɨ ketatineuyehɨwiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Neuxei nuiwarite mɨpaɨ mekanitiyuakuni:","poem":1},{"text":"«¿Tamɨri hakewa wakakaɨyari?»","poem":2},{"text":"Ketaneuxeiyatsitɨa, teɨteri 'ahetsɨa memɨkamiemete","poem":1},{"text":"wahɨxie yaketiniwarakapitɨa, 'ateɨterima waxuriya memutayeurikɨ mɨpaɨ keniwaruyuri 'ekɨta.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Ahetsɨa paitɨ keheye'ani","poem":1},{"text":"memehapanie watsuari,","poem":2},{"text":"'atɨrɨkariyakɨ","poem":1},{"text":"memɨkwi'iwa keniwarutawikweitsitɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ti'aitame, ta'aurie kiekatari","poem":1},{"text":"'atahutamexɨa ketiniwarakapitɨa","poem":2},{"lineBreak":true},{"text":"'axamemutiyuakɨ 'ahepaɨtsita.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tameta, 'ateɨterima meta 'amuxatsima 'akuraruta miemete,","poem":1},{"text":"tepɨmetsinɨawani yuheyemekɨ,","poem":2},{"text":"nuiwarite memanuyekɨka nuiwarite memanuyekɨka","poem":1},{"text":"kwikari 'ahetsiemieme teputikwikani.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}