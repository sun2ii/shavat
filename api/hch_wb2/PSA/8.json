{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":8,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Kemanɨyɨne «Kaxie mɨpɨnarie» hepaɨ mɨpaɨ ketiukwikarieni. Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Yawé, tati'aitɨwame,","poem":1},{"text":"pemɨmariwe naitsarie kwiepa.","poem":2},{"lineBreak":true},{"text":"Muyuawi heima pemɨxawatɨriwie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Memɨmetsi'aye'unie wahepaɨtsita","poem":1},{"text":"pepɨtiuyuri wateta muwayenenikɨ memetsinɨawanikɨ","poem":2},{"text":"tɨɨri 'etsimemutɨtɨ meta memɨtsitsewe,","poem":1},{"text":"memɨmatsi'aye'unie meta memayu'eririya kayuwatɨ pemɨwapitɨanikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kepauka muyuawi nemɨxeiya,","poem":1},{"text":"'amamakɨ pemitawewi,","poem":2},{"text":"metsa meta xurawetsixi mana pemɨwaruyeyatsaxɨ,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"mɨpaɨ nepɨtineku'iwawiya:","poem":1},{"text":"«¿Tewi tita tihɨkɨ, pemiku'eriwanikɨ?","poem":2},{"lineBreak":true},{"text":"¿Teɨteri tita metehɨkɨ, pemɨwa'eniekakɨ?»","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Etsiwatɨkaku 'ahepaɨ 'aneme peputawewi,","poem":1},{"text":"pepenutikurunatɨa 'aixɨa mɨti'anekɨ:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"mɨti'aitanikɨ pepipitɨa naime tita pemɨtiutawewitsie,","poem":1},{"text":"naime pepɨtiyetuiri mɨtiwata'aitɨanikɨ,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"muxatsi, tuurutsixi kwietsanamete,","poem":1},{"text":"yunaime yeutari,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"memɨte'awɨwawe, ketsɨte","poem":1},{"text":"meta yunaime memɨtekuyuatɨka haramaratsie memɨteye'uwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yawé, tati'aitɨwame,","poem":1},{"text":"pepɨmariwe naitsarie kwiepa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}