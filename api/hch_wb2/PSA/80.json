{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":80,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Yuariyaya xekeneuweiyani «Tuturi tɨratuyari». 'Atsahapi nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"'Ixaheri hɨweme,","poem":1},{"text":"'ekɨ kutse pemuwitɨxime muxatsi wahepaɨ,","poem":2},{"lineBreak":true},{"text":"'ekɨ metsiteɨtamete watsata pe'atikaitɨ,","poem":2},{"lineBreak":true},{"text":"ketaneu'eni.","poem":2},{"text":"Keneuxawatɨxɨa","poem":1}]},{"type":"verse","number":2,"content":[{"text":"'Epɨrahini hɨxie,","poem":1},{"text":"Wenikamini meta Manatsexi wahɨxie.","poem":2},{"lineBreak":true},{"text":"Keneuhekɨata 'atɨrɨkariya, kenenua ketaneutawikweitsitɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Xɨa'ui, Kakaɨyari, 'aixɨa ketaneuyuri,","poem":1},{"text":"'aixɨa ketatineuxeiya,","poem":2},{"lineBreak":true},{"text":"ketaneutawikweitsitɨa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"¿Kepaukake tamɨ pepɨtihayewa peha'atɨ Yawé Kakaɨyari","poem":1},{"text":"Naimekɨmɨtɨrɨkaɨye, 'ateɨterima wanenewieri hepaɨtsita?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Ikwai petatsiminike hiwerika pepɨtatsi'upitɨa temiti'ienikɨ,","poem":1},{"text":"memɨte'iekai wahetsiemieme, waɨkawa wa'ukai pepɨwayetuirie memiti'ienikɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ta'aurie kiekatari memɨtatsi'atsenikɨ","poem":1},{"text":"yapepɨtatsi'uyuri,","poem":2},{"text":"memɨtatsi'aye'unie mepɨtatsiyuriya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kakaɨyari Naimekɨmɨtɨrɨkaɨye 'aixɨa ketaneuyuri,","poem":1},{"text":"'aixɨa ketatineuxeiya,","poem":2},{"lineBreak":true},{"text":"ketaneutawikweitsitɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"'Ekipitu paitɨ xeime kaxie pepeyetui,","poem":1},{"text":"memɨka'ateɨterima pewarutaweiyaka, mana pepikaye.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwiepa 'aixɨa pemɨrakuyuritsie,","poem":1},{"text":"mana kanananataxɨani hikɨ kwiepa waɨkawa kaniutaxiɨni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Etɨriyaya hɨritetsie paitɨ pepuye'atɨatɨya,","poem":1},{"text":"kɨtsimeyari yunaime kariuxa 'amutɨtɨ pɨwara'iwakai.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Xawarieya haramaratsie paitɨ kaneuta'axɨani,","poem":1},{"text":"muwatiyɨraxɨa 'Eupɨrata paitɨ kaneuta'ani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"¿Titayari kuraruya petiuka'unaxɨ?","poem":1},{"text":"Yunaitɨ mana memuyekɨka 'iteɨrieya kaxie mekanika'inɨweni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tuixuri yeutari mekanikumaweriyarɨmeni,","poem":1},{"text":"yeutari mekanikwaka.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Xɨa'ui Kakaɨyari, Naimekɨmɨtɨrɨkaɨye tahetsɨa kenenua.","poem":1},{"text":"Muyuawitsie paitɨ kenakanieri","poem":2},{"lineBreak":true},{"text":"'ikɨ kaxie kene'ɨwiyani.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Atseriekɨ nanari pemukaye kanihɨhɨtɨni.","poem":1},{"text":"Mɨkɨ hekwamekɨ matiyɨraxɨ 'ahetsiemieme pɨhɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"'Akaxie nanayari kaniuka'unarieni, taikɨ kaniutataiyarieni,","poem":1},{"text":"'atierikakɨ 'ateɨterima mepɨte'uka'eniwa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Keneuparewi tewi pemanayexei,","poem":1},{"text":"'aniwe 'ahetsiemieme pemitaweriyaxɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tame tepɨkametsiku'eirieni,","poem":1},{"text":"ketananutanieritɨa, 'ana tepɨmetsihahɨaweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Yawé Kakaɨyari Naimekɨmɨtɨrɨkaɨye, 'aixɨa ketaneuyuri,","poem":1},{"text":"'aixɨa ketatineuxeiya,","poem":2},{"lineBreak":true},{"text":"ketaneutawikweitsitɨa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}