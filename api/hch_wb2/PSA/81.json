{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":81,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Yuariyaya xekeneuweiyani «Kaxie mɨpɨnarie» hepaɨ mɨpaɨ ketiukwikarieni. 'Atsahapi nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Xeyutemamawietɨ Kakaɨyari xekenekwikani, mɨtatsitɨrɨkariya,","poem":1},{"text":"Kakuwu Kakaɨyarieya xekenehiwieka xeyutemamawietɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nɨawari hetsiena mieme xekeneyuitɨaka.","poem":1},{"text":"'Ari tepu 'etsimɨpe xekeneutahutsunani,","poem":2},{"lineBreak":true},{"text":"xaweri meta kanari witsimutaine.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Muxa 'uki 'awaya xekeneutahɨtsi metseri manatiwenitsie,","poem":1},{"text":"meta metsa mɨxikɨraɨyenitsie, ta'ixɨarari tukariyaritsie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Ikɨ 'aitsika kanihɨkɨtɨni 'ixaheritsixi wahetsiemieme,","poem":1},{"text":"Kakuwu Kakaɨyarieya 'aitsikaya kanihɨkɨtɨni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tɨratu Kutse hamatɨa kaniuwewieni,","poem":1},{"text":"kepauka memayekɨ 'Ekipitu kwieyaritsie.","poem":2},{"lineBreak":true},{"text":"Niuki nemɨka'i'enie nekaniu'enieni:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"«'Ika nekamaniunawairieni pemetɨkɨkai,","poem":1},{"text":"kiriwa mahete 'ari pekaniunawaiyarieni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Pe'uximatɨarietɨ pemɨnetsi'utahɨawixɨ, nekameniɨxɨna,","poem":1},{"text":"nene'awietatɨ hai mɨmariwetsie nekameniuta'eiya,","poem":2},{"lineBreak":true},{"text":"Meriwa hayaritsie nekameniuta'inɨata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"»Neteɨterima kenemɨtixe'ayehɨtɨwa xekeneneu'eni,","poem":1},{"text":"xɨa'ui 'ixaheritsixi, xɨka xeikɨa xenetsi'u'enienike.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Teewatanaka kakaɨyaritɨme xeime pepɨkahayexeiyani,","poem":1},{"text":"xeime kakaɨyaritɨme yɨkɨ 'aneme hɨxie pepɨkahekatunumaweni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne nepɨhɨkɨ Yawé 'akakaɨyari,","poem":1},{"text":"'Ekipitu nemɨmetsi'ayewitɨ.","poem":2},{"lineBreak":true},{"text":"Kenakwaxaka, ne 'ateta nekatinitahɨniyamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"»Neuxei peru neteɨterima mepɨkanetsi'u'eni,","poem":1},{"text":"'ixaheritsixi yamepɨkatekakɨ kenemainekai.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"'Ayumieme nepɨwaruku'eiri wa'iyari mɨtsetse'ikaikɨ,","poem":1},{"text":"kemɨtiwanake memɨyɨakaikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"»Xɨka neteɨterima xeikɨa menetsi'u'enienike,","poem":1},{"text":"xɨka 'ixaheritsixi nehuyeta me'uhunike,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"yapauka ne memɨwaraye'unie nekaniwara'iwake,","poem":1},{"text":"meta nekaninuanike memɨwaraye'unie wahetsɨa netɨrɨkariyakɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kemɨ'ane Yawé memɨxani'erie hɨxiena mepuyuyetuawawekai,","poem":1},{"text":"meta yuheyemekɨ mekatenikwinitɨarienikekaitɨni.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"'Ekɨta tɨriku 'aixɨa mɨ'anekɨ pekatinimikienikekaitɨni,","poem":1},{"text":"meta xiete 'aitsie miemekɨ».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}