{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["'Atsahapi nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Kakaɨyari puwa'ɨxatsitɨa muyuawitsie mieme tikuxatatɨ,","poem":1},{"text":"pɨwaxaneta kakaɨyarixi wahixɨapa 'uwetɨ kemɨtiwaranutaxɨrienikɨ:","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«¿Kepaukari tamɨ xepɨtehayewa 'axaxeteyurietɨ,","poem":1},{"text":"kepauka 'aixɨa xepɨtiyuani Kakaɨyari memɨka'ayexeiya wahetsiemieme?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nutui hetsie xekenenuaka kemɨranuyemie, meta kemɨ'ane yuhetsie mɨtanuanikɨ mɨkayɨwe,","poem":1},{"text":"tixaɨtɨ mɨkarexeiya meta mɨti'uximayatsitɨarie wahetsiemieme 'aixɨa xeketeneyurieka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mɨkayɨhɨawe meta hawerimɨ'ane xekenewawikweitsitɨaka,","poem":1},{"text":"Kakaɨyari memɨka'ayexeiya metewa'aitɨakaku xekeniwarɨxɨna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"»Mɨkɨ 'atsimepɨkatemate, mɨkɨ mepɨkaheti'enatɨkɨka.","poem":1},{"text":"Yɨwipa mepu'uwa,","poem":2},{"lineBreak":true},{"text":"mɨkɨ putayuane kwie tsutɨa naitɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"»Ne mɨpaɨ nepɨtixekɨhɨawe: “Xeme xepɨmamariwawe,","poem":1},{"text":"yunaitɨ xeme 'Amutewi xepɨniwemama”.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Peru xekanikwikuni tewi mɨmɨwe hepaɨ,","poem":1},{"text":"xekanatixɨrikuni hipatɨ te'aitamete wahepaɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kenanukukexi, Kakaɨyari 'aku, kwiepa tita mɨtiheitserie yaketineuyuri,","poem":1},{"text":"nuiwarite yunaitɨ memɨte'apiinimakɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}