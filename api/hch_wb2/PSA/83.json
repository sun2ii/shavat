{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":83,"content":[{"type":"hebrew_subtitle","content":["Kwikari. 'Atsahapi nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Kakaɨyari 'aku, kayuwatɨ pepɨka'umaka,","poem":1},{"text":"Kakaɨyari 'aku, pemɨkaheu'ena pepɨkahɨkɨtɨni 'atsipekatiyurimɨtɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Keniwaruxeiya memɨmetsi'aye'unie kememɨteyukwiku,","poem":1},{"text":"memɨmetsixani'erie mepɨmetsi'iwaku.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Metemaiwawetɨ 'ateɨterima wahepaɨtsita mepɨtekuxata,","poem":1},{"text":"'axamewayurienike pemɨwanaki'erie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mɨpaɨ mekaniutiyuaneni: «Hikɨmɨtɨka, wanuiwari tepauyehɨani.","poem":1},{"text":"'Ixaheri manɨyɨne pɨkaku'eriwaniri».","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yunaitɨ mekaniyutaxewireni,","poem":1},{"text":"tɨratu mekaniuwewieni 'ahepaɨtsita miemeyari metekuxatatɨ:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Erumi teɨterimama memukutetɨka meta 'Itsimaheri,","poem":1},{"text":"Muhawi kiekatari meta Hakaxi teɨterimama,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kewari, 'Amuni meta 'Amareki wateɨterima,","poem":1},{"text":"Piritsiteu kwieyari hetsie kiekatari meta Tiru kiekatari.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Meta 'Atsiriya kaniwarɨnɨni,","poem":1},{"text":"Ruti nuiwarimama kaniwaparewieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mariyani kepemɨwaruyuri mɨpaɨta mɨkɨ keniwaruyuri,","poem":1},{"text":"kepemɨwaruyuri Tsitsara meta Kawini, Kitsuni 'akiyari manuyekatsie,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"mɨkɨ 'Eniruxi mɨrakutwatsie memukwi","poem":1},{"text":"kwiepa memuyuhayewaxɨ kwitarai hepaɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Urewi meta Tsewi kepemɨwaruyuri","poem":1},{"text":"mɨpaɨta keniwaruyuri memanuyetei mana memɨtama,","poem":2},{"text":"memanuyetei te'aitamete yaxeikɨa keniwaruyuri","poem":1},{"text":"kepemɨwaruyuri hepaɨ Tsewa meta Tsarimuna,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mɨpaɨ memaitɨkatei: «Tapiini tepayeitɨani","poem":1},{"text":"Kakaɨyari kwieya mu'ɨxaya».","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nekakaɨyari, 'ɨtsi haikɨritsie hepaɨ ketiniwaruxikɨriwitsitɨa,","poem":1},{"text":"xatsi 'eka mei'enitsitɨwa hepaɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tai kɨyexite kemɨtitixɨxɨtsitɨwa","poem":1},{"text":"meta tai hɨri kemɨtititaiya hepaɨ,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"mɨpaɨ ketiniwaranukuweiya pewamariutatɨ,","poem":1},{"text":"waɨkawa keniwarutimariuta 'a'ekakɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yawé, keniwarutewiyatsitɨa,","poem":1},{"text":"memɨmetsitiwaunikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Yuheyemekɨ meke'utewiyatsitɨarieni,","poem":1},{"text":"meke'ukwini tixaɨtɨ mekatehayuyeitɨatɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Meketehetimani 'ekɨ Yawé pemɨhɨkɨkɨ,","poem":1},{"text":"mɨpaɨ pemɨtitewa,","poem":2},{"text":"mɨpaɨ meketemaika 'ekɨ xeikɨa 'Amutewi pemɨhɨkɨkɨ","poem":1},{"text":"'ena kwiepa naitsarie.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}