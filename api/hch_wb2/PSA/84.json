{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":84,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Yuariyaya xekeneuweiyani «Kaxie mɨpɨnarie» hepaɨ ketiukwikarieni. Kure niwemama wanɨawari."]},{"type":"verse","number":1,"content":[{"text":"Yawé Naimekɨmɨtɨrɨkaɨye,","poem":1},{"text":"'akiekarite witsipɨ'anene.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nepeiyehɨwa ne'iyarikɨ Yawé takwana,","poem":1},{"text":"'ariri mana neheuyeimɨtɨ nekanimɨximeni.","poem":2},{"text":"Nekanikwikani Kakaɨyari tukari mɨtiyupitɨwa","poem":1},{"text":"ne'iyarikɨ meta naime newaiyarikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yawé Naimekɨmɨtɨrɨkaɨye, neti'aitɨwame meta nekakaɨyari pemɨhɨkɨ,","poem":1},{"text":"wikitɨtɨ 'amawari taiyame 'aurie yukii putaxexeiya,","poem":2},{"text":"metatsiere wiki 'itsitame muwa yu'itua putawewiwa,","poem":1},{"text":"muwa mɨti'itsinienikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"'Aixɨa ke'itɨarieka kemɨ'ane 'akiita mɨkiekame,","poem":1},{"text":"yuheyemekɨtsɨ kameninɨawani.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Aixɨa ke'itɨarieka kemɨ'ane 'ahetsɨa tɨrɨkariya mukaxexeiya,","poem":1},{"text":"'ahuyeta xeikɨa mumienikɨ muyukɨhɨawe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kepauka 'ukaitsata muyeyani","poem":1},{"text":"haixatsata kanayeitɨwani,","poem":2},{"text":"meta wiyeri ximeri mieme","poem":1},{"text":"katiniutiwaweriyani mayeweritsie.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Metsɨ 'ateewa kɨkamete mekaniuhuni, matsi waɨkawa tɨrɨkariya mekanipitɨarieka,","poem":1},{"text":"Tsiyuni mekaniye'axeni Kakaɨyari hɨxie, kakaɨyarixi muwakakaɨyari hetsɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yawé, Kakaɨyari Naimekɨmɨtɨrɨkaɨye, nenenewieri keneu'eni,","poem":1},{"text":"keneneu'eni, Kakuwu Kakaɨyarieya.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kakaɨyari 'aku, tepɨa tahetsie nunuwame,","poem":1},{"text":"pemanayexei keneuxeiya 'aixɨa 'anemekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"'Aixɨa pɨ'ane 'atakwa nemukanikɨ xeitukari,","poem":1},{"text":"pɨkaheuyewetse xeimiriyari takwa nemeyeikani,","poem":2},{"text":"pɨnetsinake Kakaɨyari kiiya kitenie nemɨ'ɨwiyani,","poem":1},{"text":"'aixɨa pɨka'ane Kakaɨyari memɨka'ayexeiya wahetsɨa nemukani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yawé tau hepaɨ kani'aneni meta tepɨa tahetsie nunuwame,","poem":1},{"text":"Kakaɨyari tahetsiemieme witsipɨtikuxata.","poem":2},{"text":"Yawé kaniwareu'enieka heitseriemekɨ memu'uwa","poem":1},{"text":"wahetsie karahɨpatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yawé Naimekɨmɨtɨrɨkaɨye,","poem":1},{"text":"'aixɨa meke'itɨarieka 'ahetsie memɨtewiya.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}