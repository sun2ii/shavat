{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":85,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Kure niwemama wanɨawari."]},{"type":"verse","number":1,"content":[{"text":"Yawé, 'aixɨa pepɨtiuka'iyari 'ikɨ kwie mɨti'apiini hepaɨtsita","poem":1},{"text":"Kakuwu pemuhekwariyaxɨkɨ,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pepɨtiwareuyehɨwiri 'ateɨterima 'axamemɨte'uyurikɨ,","poem":1},{"text":"pepɨrayukatua naime 'axamemɨte'uyurikɨ,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"pepukahaxɨapi,","poem":1},{"text":"pepɨtiuhayewaxɨ 'ahaxɨa pe'utaiyaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tawarita matsi 'aixɨa ketaneuyuri, Kakaɨyari tatsiwikweitsitɨwame,","poem":1},{"text":"ketineuhayewa 'axakepemɨtatiku'eriya.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"¿Kamɨtsɨ petiha'aka 'aheyemekɨ tahepaɨtsita?","poem":1},{"text":"¿Peha'atɨ 'aheyemekɨ perayani?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"¿Tawarita tukari hekwame pekatatiyetuirieni,","poem":1},{"text":"'ateɨterima 'ahetsiemieme memɨyutemawiekakɨ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yawé, ketaneuxeitsitɨa 'anaki'eriya mɨkaxɨwe,","poem":1},{"text":"ketaneyetuiri 'awikweitsitɨarika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nepi'enieni Yawé Kakaɨyari kemaine:","poem":1},{"text":"mɨkɨ yuteɨterima kayuwatɨ memexeiyanikɨ pɨwapitɨani wahetsiemieme meta kemɨ'ane hetsiena mieme 'aixɨa memɨtekahu,","poem":2},{"lineBreak":true},{"text":"tawarita 'atsimemɨkatemate wahepaɨ mepɨkayɨaka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Ahurawa puyeika watawikweitsitɨanike kemɨ'ane memimakaxe,","poem":1},{"text":"kemɨtimariwe mɨmatsiɨkɨnikɨ 'ena kwiepa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Naki'eriya meta tita yuri mɨraine puyukaxeiya,","poem":1},{"text":"kayuwatɨ mɨ'ayumie meta mɨtiheitserie hamatɨa mepuyuti'itseni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Ena kwiepa pɨtineni tita mɨtiyuri,","poem":1},{"text":"muyuawitsieta 'aixɨa mɨti'ane puyuhekɨare.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yawé 'aixɨa pɨtatsiyurieni,","poem":1},{"text":"takwie 'ikwaxi waɨkawa pɨtitixuaweriya.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tita mɨtiheitserie hɨxiena panuyeyerɨni","poem":1},{"text":"mɨkɨ pɨwatahuyetɨani.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}