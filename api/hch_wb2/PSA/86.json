{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":86,"content":[{"type":"hebrew_subtitle","content":["Rawiri nenewierieya."]},{"type":"verse","number":1,"content":[{"text":"Yawé, keneneu'eni keneneuta'eiya,","poem":1},{"text":"haweri nepɨ'ane waɨkawa nepɨreuyehɨwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Netukari kene'ɨwiyani, heitseriemekɨ yanemɨtikamiekɨ 'ahetsiemieme.","poem":1},{"text":"'Ekɨ pepɨnekakaɨyari, 'ahetsie nepɨtiwiya,","poem":2},{"lineBreak":true},{"text":"kenewikweitsitɨaka ti'a'uximayatsiriwame.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ti'aitame, kenenenenimayaka,","poem":1},{"text":"'ekɨ xeikɨa nekamenahiwiwani tukarikɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ti'a'uximayatsiriwame 'iyarieya 'aixɨa keneuyuri,","poem":1},{"text":"karikɨ ti'aitame, 'ekɨ xeikɨa ne'iyari nekameniyetuirieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ti'aitame, 'ekɨ 'aixɨa pekatiniuka'iyarini meta pekanetineuyehɨwiriemɨkɨ,","poem":1},{"text":"pɨmariwe 'anaki'eriya kemɨ'ane memɨmetsihahɨawe wahetsɨa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yawé, nenenewieri keneu'eni,","poem":1},{"text":"ne'iwaurika kenanu'eni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kepauka nemɨ'uximatɨarieka 'ana nekamenahɨaweni,","poem":1},{"text":"'ekɨ pemɨnetsiku'eiyakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yawé, tawarita xewitɨ pumawe kakaɨyarixi watsata 'ahepaɨ tiuka'iyaritɨ,","poem":1},{"text":"pumawe wewiyaya pemɨtiutiwewi hepaɨ ti'anenetɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yunaime nuiwarite pemɨwarutiwewi","poem":1},{"text":"mepɨ'axɨani, 'ahɨxie mepɨkatunuma'uni, Ti'aitame,","poem":2},{"lineBreak":true},{"text":"'ahetsiemieme 'aixɨa mepɨtiyuani.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Ekɨ pemɨmariwekɨ meta mariwemekɨ pemɨtiyurienekɨ,","poem":1},{"text":"'ekɨ xeikɨa pepɨkakaɨyari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yawé, 'ahuyeta nemumienikɨ kenetine'ɨkitɨaka","poem":1},{"text":"nemumienikɨ 'aixɨa netikamietɨ.","poem":2},{"text":"Ne'iyaritsie 'aixɨa netinekɨhɨaweme kenenayeitɨa","poem":1},{"text":"nemɨmetsimakaxenikɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Neti'aitɨwame nekakaɨyari, ne'iyarikɨ nepɨmetsinɨawani,","poem":1},{"text":"yuheyemekɨ 'aixɨa nepɨmerahɨaweni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mɨmariwekɨ 'anaki'eriya nehetsiemieme,","poem":1},{"text":"pepɨnetsi'utawikweitsitɨa mɨki teukiyata neheukaweximekaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kakaɨyari 'aku, teɨteri meyɨwaweme meyuxatatɨ mepɨnetsimietɨwe,","poem":1},{"text":"yuwaɨkawatɨ meyɨnɨtɨ teyumiekate mekanenimiekuni.","poem":2},{"lineBreak":true},{"text":"Teɨteri peka'uyeikame me'erietɨ mekaniyɨaka.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Ekɨ peru, Ti'aitame, Kakaɨyari pepɨtiuyukakwewimɨkɨ petiuyukanenimayatɨ,","poem":1},{"text":"pepɨkahayu'eriya, waɨkawa peti'akanaki'erietɨ meta yuri pehaitɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kenenua nehetsɨa, kenenenenimayaka,","poem":1},{"text":"keneneutatɨrɨkariya ne ti'a'uximayatsiriwame.","poem":2},{"lineBreak":true},{"text":"Ne 'aniwe 'aixɨa nemɨtiuka'iyari keneneutawikweitsitɨa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"'Inɨari keneneuwewiri kepemɨnetinaki'eriekɨ,","poem":1},{"text":"memɨnetsi'aye'unie memixeiyakɨ memɨyutitetewiyakɨ,","poem":2},{"lineBreak":true},{"text":"'ekɨtsɨ Yawé, pemɨnetsi'uparewikɨ meta pemɨnetsi'unɨtɨakɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}