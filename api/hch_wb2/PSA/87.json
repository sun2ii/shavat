{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":87,"content":[{"type":"hebrew_subtitle","content":["Kure niwemama wanɨawari. Kwikariyari."]},{"type":"verse","number":1,"content":[{"text":"Kakaɨyari kiekarieya tsutɨmeyari","poem":1},{"text":"hɨri mɨpatsietsie katini'aneni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yawé Tsiyuni 'itupariyarite memeutahaketsie kaninaki'erieka,","poem":1},{"text":"Kakuwu kiekariteya kemɨkatinaki'erie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Ahetsiemieme, Kakaɨyari kiekarieya,","poem":1},{"text":"witsi'anemekɨ katinikuxaxatsiwani:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"«Kemɨ'ane memɨnetsimate","poem":1},{"text":"nekaniwa'inɨatani Xahawi meta Wawiruniya,","poem":2},{"text":"metatsiere Piritsiteutsixi wakie, meta Tiru, metatsiere Kutsi.","poem":1},{"text":"Mɨpaɨ katinikuxaxatsiwani: “'Ikɨ Tsiyuni kaniutinuiwa”».","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yurikɨ, Tsiyunitsie mɨpaɨ pɨtitaniukieni:","poem":1},{"text":"«'Ikɨ meta 'iya mana mekaniutinunuiwa.","poem":2},{"lineBreak":true},{"text":"Mɨkɨ 'Amutewitɨtɨ kanikamani».","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yawé teɨteri mɨpaɨ katiniwa'utɨamɨkɨ:","poem":1},{"text":"«'Ikɨ Tsiyunitsie kaniutinuiwa».","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mexi 'akuxi me'utikwika meta meteneitɨwe, mɨpaɨ meputiyuane:","poem":1},{"text":"«'Ahetsie naitɨ pɨtihekɨa kenemɨtiunuiwaxɨ».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}