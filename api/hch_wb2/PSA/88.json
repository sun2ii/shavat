{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":88,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. Hemani 'ɨkitsikaya 'etsirahi tewiyari. Tikwikame kwikariyari. Kure niwemama wanɨawari."]},{"type":"verse","number":1,"content":[{"text":"Yawé, Kakaɨyari netsiwikweitsitɨwame,","poem":1},{"text":"tukarikɨ tɨkarikɨ nekanahiwani 'ahɨxie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Ahetsɨa paitɨ nenenewieri keheuye'ani,","poem":1},{"text":"kenemɨmatiwawirie kenene'enieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nepɨhɨne 'uximatɨarikakɨ","poem":1},{"text":"'ari netukari mɨki teukiyapa kaneukaniereni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Ari nekani'inɨatsieka putsuta memeukaxɨriwa wahamatɨa,","poem":1},{"text":"kuya mɨkatɨrɨkaɨye nekanihɨkɨtɨni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Ari yateewa nekaniutekieka, mɨkite watsata,","poem":1},{"text":"mɨki hepaɨ nepɨtinexexeiya kwieta matika hepaɨ,","poem":2},{"text":"'iya kemɨ'ane 'ari pemɨkawara'eriwa,","poem":1},{"text":"memanakaxɨri 'amamatsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Putsu meukatewatsie pekaneneukahɨani,","poem":1},{"text":"waɨkawa muyemariwetsie meukatewatsie.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Ahaxɨa kemɨrahete nehetsie pukawe,","poem":1},{"text":"pekanenehana 'ahamewarikɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Pekaneniunawairieni yunaime nehamikuma","poem":1},{"text":"meta mɨkɨ wahɨxie nexani'eriwame pepɨnetsi'ayeitɨa.","poem":2},{"text":"Nekananutahɨiyaka meta nemuyuxɨna nepɨkayɨwe,","poem":1}]},{"type":"verse","number":9,"content":[{"text":"nehɨxite pɨkaheuneniere hiwerikakɨ.","poem":2},{"lineBreak":true},{"text":"Yawé, ne tukarikɨ nemetsihahɨawe,","poem":1},{"text":"'ahepa nekaneutamemeni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"¿Kamɨtsɨ mɨkite watsata mariweme pemɨtiuyurieni petiyɨwe?","poem":1},{"text":"¿Kamɨtsɨ mɨkite me'anuku'ume pamɨpariyutsi memetsi'upitɨani tiyɨwe?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"¿Kamɨtsɨ mɨkite watsata 'anaki'eriya rekuxaxatsiwa,","poem":1},{"text":"meta ke'aixɨa pemɨtikamie meukatewatsie?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"¿Kamɨtsɨ yɨwipa timatiwa mariweme kepemɨtiyuriene,","poem":1},{"text":"yatɨni heitserie kepemɨrexeiya kwie matɨmaiyarietsie?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yawé, ne waɨkawamekɨ nepɨmetsiwawirie keneneuparewi,","poem":1},{"text":"ximeri nepɨmetsi'utiwawa neyunenewietɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"¿Yawé, titayari peneti'uxiwe'erie?","poem":1},{"text":"¿Titayari pekanetixeiyamɨkɨ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ne nepɨtiuka'eniwa temaikɨyari paitɨtɨ,","poem":1},{"text":"heiwa 'ari nepɨkukweriwayɨne.","poem":2},{"text":"Pekaneneyenɨ'airieni yemekɨ waɨkawa 'uximatɨarika","poem":1},{"text":"'ari tawarita nekapɨyɨwe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"'Ahaxɨa yemekɨ nehetsie kaniukawiwieni,","poem":1},{"text":"'a'iwaɨyɨ kanenitaxɨtɨaximeni.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Haramara hepaɨ ne'aurie mepɨhɨne tukarikɨ,","poem":1},{"text":"mekaneniukurarutɨiya yemekɨ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Pekaneniunawairieni nehamikuma meta waɨkawa nemɨwanaki'erie,","poem":1},{"text":"hikɨ yɨriya hamatɨa xeikɨa tekaniyunaki'erieka.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}