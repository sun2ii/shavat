{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":89,"content":[{"type":"hebrew_subtitle","content":["'Etani 'ɨkitsikaya 'etsirahi tewiyari."]},{"type":"verse","number":1,"content":[{"text":"Yawé 'aku, yuheyeme nepikwikani","poem":1},{"text":"'anaki'eriya mɨmariwe,","poem":2},{"text":"yuheyemekɨ nepikuxatani ke'aixɨa pemɨtikamie.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mɨpaɨ nepaineni 'anaki'eriya heitserie 'amuyeikakɨ,","poem":1},{"text":"yapehaitɨ ke'aixɨa pemɨtikamie muyuawi yamɨtiuyema hetsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mɨpaɨ peputayɨ: «Ne tɨratu nepuwewi nemenayexei hamatɨa,","poem":1},{"text":"Rawiri mɨpaɨ yurikɨ nepɨtiutahɨawixɨ neti'uximayatsiriwame:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“'Anuiwari yunaitɨ te'aitamete nepɨwarayeitɨani,","poem":1},{"text":"meta yanepaine 'a'uweni 'amuwenikɨ yuheyemekɨ”».","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yawé, mariweme kepemɨtiyuriene muyuawi peyexeiya,","poem":1},{"text":"meta ke'aixɨa pemɨtikamie memɨpatsie mepeyexeiya.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"¿Kemɨ'ane muyuawitsie Yawé hepaɨ pɨ'ane?","poem":1},{"text":"¿Kemɨ'ane muyuawitsie 'uyeikatɨ Yawé hepaɨ pɨ'ane?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kakaɨyari waɨkawa pumakaxiwa memɨpatsie memayuxeɨrietsie,","poem":1},{"text":"pɨmariwe yemekɨ 'amemu'uwa 'auriena wahetsiemieme.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Xewitɨ 'ahepaɨ 'anetɨ pumawe Yawé Kakaɨyari Naimekɨpemɨtɨrɨkaɨye,","poem":1},{"text":"tɨrɨkariya pemexeiya meta 'aixɨa pemɨtikamie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"'Ekɨ pepɨti'aita hamewari mɨtɨrɨkaɨyetsie,","poem":1},{"text":"'ekɨ kayuwatɨ pepipitɨa hamewari muyuane.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Xahawi peputapɨnaxɨ mɨki hepaɨ,","poem":1},{"text":"'atɨrɨkariyakɨ pepɨwareutaxɨriexɨa memɨmetsi'aye'unie.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Ahetsie pɨmieme muyuawi, meta pɨti'apiini kwie,","poem":1},{"text":"'ekɨ kwie peputawewi meta naitɨ hetsiena mɨtixuawe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"'Ekɨ tayeta meta tatsutɨa peputiwewi,","poem":1},{"text":"Tawuxi meta Heximuni hɨriyarite mepɨmetsikwika yutemawierima.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Amamatekɨ mariweme pemɨtiuyurieni pepɨyɨwe,","poem":1},{"text":"pepɨtɨrɨkaɨye pepɨrayu'iwa yemekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"'Aixɨa mɨti'ane meta tita mɨtiheitserie mɨkɨ 'a'uweni pɨtsutɨmeyari,","poem":1},{"text":"meta 'aniukamete mepɨhɨkɨ naki'eriya meta yuri mɨraine.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Aixɨa meke'itɨarieka memɨmetsihahiwiwa temawierikakɨ, Yawé,","poem":1},{"text":"meta 'ahekɨariyatsie memuhu,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"kemɨ'ane tukarikɨ 'ahetsiemieme memuyutemamawie","poem":1},{"text":"meta memetsi'ayexeiyatɨ heitserie pemexeiyakɨ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"'Ekɨtsɨ watɨrɨkariya witsipemɨ'ane pekanihɨkɨtɨni wahetsiemieme,","poem":1},{"text":"mɨpaɨ mɨmatinakekɨ waɨkawa tɨrɨkariya pepɨtatsipitɨa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yawé, 'ekɨ tepɨa tahetsie nunuwame pepɨhɨkɨ,","poem":1},{"text":"'ekɨ, 'Ixaheri hetsie pemɨpatsie, petati'aitɨwame pepɨhɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Heiwa 'ekɨ 'ateɨterima pepɨtiwarutaxatɨa heinɨtsi hepaɨ 'anemekɨ,","poem":1},{"text":"mɨpaɨ pepɨtiwarutahɨawixɨ 'ateɨterima yamemɨtekahu:","poem":2},{"text":"«Ne nekaniparewieka xeime waɨkawa meuyutamiewe,","poem":1},{"text":"xeime tewi 'aixɨa nemɨtixeiya hetsiena mieme 'aixɨa nepaine.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Rawiri nekaniutaxeiya, neti'uximayatsiriwame,","poem":1},{"text":"nekanikawirieni ne'atseiti mɨpatsiekɨ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nemamá yuheyemekɨ pituikani,","poem":1},{"text":"netɨrɨkariya pitatɨrɨkariya.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Meye'unie pɨkahe'iwani meta pɨkatita'aitɨani mɨtiyukutuayanikɨ,","poem":1},{"text":"xewitɨ tɨma 'axamɨtiuka'iyari pɨkatita'aitɨani.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kemɨ'ane memitamieni ne nepuwatipɨna,","poem":1},{"text":"kemɨ'ane memitixani'erieni ne nepuwaka'una.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nenaki'eriya ke'aixɨa mɨtikamie hamatɨana puyeikani,","poem":1},{"text":"tɨrɨkariyaya nehetsiemiemekɨ 'aixɨa pɨraniuwani.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ne tɨrɨkariya nekanipitɨamɨkɨ haramaratsie mɨti'aitanikɨ,","poem":1},{"text":"meta haa muyehapanetsie mɨtiwa'aitɨakakɨ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mɨkɨ mɨpaɨ kanetinitahɨawimɨkɨ: “'Ekɨ ne'ukiyari pekanihɨkɨtɨni,","poem":1},{"text":"nekakaɨyari, ne'ai netsiwikweitsitɨwame”.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ne neniwe matɨari mieme heitserie nekanipitɨamɨkɨ,","poem":1},{"text":"mexɨakame kanayeimɨkɨ te'aitamete kwiepa memɨtama wahetsie.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Nenaki'eriya hetsiena mieme yaxeikɨa kani'anekamɨkɨ,","poem":1},{"text":"tɨratu ketemɨtehexeiya mɨkɨmatɨa yaxeikɨa kani'anekamɨkɨ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Nuiwarimama memɨteta'aitakɨ 'aixɨa nekaniwayurimɨkɨ meta 'uwenieya","poem":1},{"text":"yuheyemekɨ, mexi 'akuxi muyuawi 'a'uyemaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"»Peru xɨka niwemama ne'aitsika me'uku'eirieni","poem":1},{"text":"meta kenemaine mɨpaɨ xɨka mekate'u'uwani,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"xɨka me'iku'eirieni ne'aitsika","poem":1},{"text":"meta xɨka mekaheitixeiyaxɨani kenemɨtiu'ai,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"kɨyekɨ nekatiniwakwinitɨamɨkɨ 'axamemɨte'uyurikɨ","poem":1},{"text":"meta nekaniwatiwamɨkɨ yamemɨkatekakɨkɨ.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Tsepa yamemɨkatekakɨ, nepɨkawahayewa newanaki'erietɨ,","poem":1},{"text":"meta kenemɨtiwarutahɨawixɨ pɨkareuyeweka.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Netɨratu 'axanepɨkayurieni,","poem":1},{"text":"kenemutayɨ nepɨkahetɨmaiya.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Xeimieme xeikɨa yanepaine nemɨpatsiekɨ,","poem":1},{"text":"meta Rawiri nepɨkati'itaiya:","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Nuiwarimama yuheyeme nepɨwa'ɨwiyani,","poem":1},{"text":"'uwenieya 'apuweni tau hepaɨ pɨreutere nehɨxie.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Metsa hepaɨ, 'aixɨa mɨtiuka'iyari mɨtaniere muyuawitsie,","poem":1},{"text":"mɨpaɨ 'apuweni yuheyemekɨ».","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"Peru neuxei 'ekɨ pepeihɨa, pemenayexei pepɨka'utanaki'eri,","poem":1},{"text":"pepuyeha'a hamatɨana waɨkawamekɨ.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Pepihayewaxɨ 'atɨratu meti'uximayatsiriwame hamatɨa,","poem":1},{"text":"kwiepa pepihaxime kurunaya.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Kuraruya naime pepa'unatɨya,","poem":1},{"text":"yeuta puyuhayewaxɨ kiiya 'amɨpapa.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Yunaitɨ mana memuyekɨka mepɨte'inawatsirie,","poem":1},{"text":"'auriena kiekatari mepiyuriya.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"'Aixɨa pepaine memeye'unie watɨrɨkariya hepaɨtsita,","poem":1},{"text":"temawierikakɨ pepɨwarutihɨniyaxɨ memeye'unie.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"'Ixiparaya pepatatamɨraxɨ,","poem":1},{"text":"meta pepɨka'iparewi muyumienekaitsie.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Mɨmariwekai mana pepɨti'atɨiri","poem":1},{"text":"'uwenieya kwiepa pe'atihɨaka.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Temaikɨtɨme kwitɨwa 'ukiratsi pepayeitɨa,","poem":1},{"text":"pepitewiyatsitɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"Yawé, ¿kepaukake pepɨtihayewa peyu'awietanetɨ?","poem":1},{"text":"¿Tai hepaɨ tiutatawetɨ 'ahaxɨa yuheyemekɨ?","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Mɨpaɨ ketinemaika netukari 'apɨkatiteriwe.","poem":1},{"text":"'Imatɨrieka, ¿titayari memukwiwawe petiwarutiwewi?","poem":2}]},{"type":"verse","number":48,"content":[{"text":"¿Kemɨ'ane 'apuyeika kamɨnike,","poem":1},{"text":"yatɨni yɨwetɨ muwatiyanikɨ teukiyapa?","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Tati'aitɨwame, ¿hakewari 'anaki'eriya meripai mieme,","poem":1},{"text":"Rawiri kepemɨtiutahɨawixɨ yapetikamietɨ?","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Tati'aitɨwame, kenaye'eri te'a'uximayatsiriwamete kememɨtenanaimarie,","poem":1},{"text":"meta ne'iyaritsie hipame teɨteri watierika kenemɨrexeiya.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Yawé, memɨmetsi'aye'unie mepɨtatsinanaima,","poem":1},{"text":"kemɨtiumie 'axamepɨte'ikɨhɨawe pemenayexei.","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"'Aixɨa ke'itɨarieka Yawé yuheyemekɨ.","poem":1},"'Aixɨa pɨ'ane, 'aixɨa pɨ'ane."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":52}