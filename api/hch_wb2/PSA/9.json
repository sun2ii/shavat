{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":9,"content":[{"type":"hebrew_subtitle","content":["Teyuitɨwamete wa'ukiyari. «Nunutsi kemɨtiumɨ» kemanɨyɨne mɨpaɨ ketiukwikarieni. Rawiri nɨawarieya."]},{"type":"verse","number":1,"content":[{"text":"Yawé, ne'iyarikɨ nepɨmatsitanɨawa,","poem":1},{"text":"mariwemekɨ kepemɨtiyuriene naime netikuxatatɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nepɨnetemawieka 'ahetsie netiwiyatɨ,","poem":1},{"text":"kwikari 'ahetsiemieme nekwikatɨ, 'aku 'Apemutewi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Memɨnetsi'aye'unie mepukununuwa,","poem":1},{"text":"mepekaxɨrɨwe meta mepɨtakukuwe 'ahɨxie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Ekɨ heitserie pemɨnetsi'upitɨakɨ, nehetsie pepunua,","poem":1},{"text":"'ekɨ 'itsɨkame 'aixɨa pemɨtikuyuruwa, 'a'uwenitsie pepaka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kakaɨyari memɨkamate, pepɨwarutati, 'axamemɨte'u'iyari pepɨwaruka'unaxɨ,","poem":1},{"text":"pepɨwarukumaweriyaxɨ yuheyemekɨ xewitɨ mɨkawara'eriwanikɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Uximatɨarika kaheu'akamekɨ memɨtatsi'aye'unie pepɨwarupitɨa,","poem":1},{"text":"wakiekari pepuka'unaxɨ,","poem":2},{"lineBreak":true},{"text":"xewitɨ pɨkawara'eriwari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yawé matsi yuheyemekɨ katini'aitametɨni,","poem":1},{"text":"'aixɨa mɨtiyurienikɨ yu'uwenitsie kanakani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kwiepa memɨtama kaniwataxanetamɨkɨ kemɨtiheitseriekɨ,","poem":1},{"text":"teɨteri katiniwata'aitɨamɨkɨ 'aixɨa 'anemekɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yawé, memɨnanaimarie waparewiwame kanihɨkɨtɨni,","poem":1},{"text":"wahetsie nunuwame kanihɨkɨtɨni kepauka memɨte'uka'eniwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"'Ahetsie yuri mepɨte'erie kemɨ'ane memɨmatsimate,","poem":1},{"text":"'ekɨ, Yawé, pemɨkawaruku'e'eiriwakɨ kemɨ'ane memɨmatsikuwautɨwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yawé kwikarikɨ xekenetemawieritɨaka, Tsiyuni hetsie ti'aitame,","poem":1},{"text":"kemɨtiuyuri nuiwarite watsata xeketenekuxatani.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wahetsie mɨkarahɨiwa wahetsie nunuwame kaniwara'eriwani,","poem":1},{"text":"memɨ'uximatɨarie memehɨawe yapauka kaniwa'enieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yawé, kenenenenimayaka,","poem":1},{"text":"keneneuxeiya kememɨnete'uximatɨa memɨnetsiheka.","poem":2},{"text":"Mɨki teukiyapa kenenatihani,","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Kerutsareme kitenieyaritsie","poem":2},{"lineBreak":true},{"text":"'akwikarikɨ nepɨmatsikuxatani, 'awikweitsitɨarikatsie nemɨnetemawiekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kakaɨyari memɨkamate","poem":1},{"text":"putsu memutiwewita mekaneukaxɨrieni,","poem":2},{"text":"wa'ɨkate kaniutseixɨani","poem":1},{"text":"winiyari yɨkɨmana memuti'awietakaitsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Yawé kanimatiwani 'aixɨa mɨtiuka'iyarikɨ,","poem":1},{"text":"'axamɨtiuka'iyari yuwiniyaritsie kaniyukahɨpani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mɨki teukiyata mekaneukaxɨrɨweni 'axamemɨte'u'iyari,","poem":1},{"text":"meta yunaitɨ Kakaɨyari mematɨtɨmaiya.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Perutsɨ kemɨ'ane mɨreuyehɨwa pɨkahatɨmaiyarieni yuheyemekɨ,","poem":1},{"text":"tita mɨtitakwewie tixaɨtɨ mɨkarexeiya pepɨtiyetuirieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Yawé, yaketineuyuri.","poem":1},{"text":"Tewi mɨrayu'iwanikɨ pepɨka'ipitɨaka,","poem":2},{"lineBreak":true},{"text":"nuiwarite 'ahɨxie memɨti'unikɨ yaketineuyuri.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yawé, marika keniwarupitɨa,","poem":1},{"text":"kename tixaɨtɨ mekatehɨkɨ teɨteri mɨpaɨ meketehetimani.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}