{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":90,"content":[{"type":"heading","content":["XAPA 4"]},{"type":"hebrew_subtitle","content":["Muitsexi nenewierieya, Kakaɨyari nɨ'arieya."]},{"type":"verse","number":1,"content":[{"text":"Ti'aitame, 'ekɨ tatsi'awiwietame pepɨhɨkɨ","poem":1},{"text":"tsepa tanuiwari memanuyekɨka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hɨri katinunuiwawekaku","poem":1},{"text":"meta kwie pekatawewiwekaku,","poem":2},{"text":"meripaitɨtɨ","poem":1},{"text":"metatsiere 'uxa'a warietɨni,","poem":2},{"lineBreak":true},{"text":"'ekɨ Kakaɨyari pepɨhɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"'Ekɨ yapepɨtiyuriene teɨteri tumuanari memakɨkanikɨ,","poem":1},{"text":"kepauka mɨpaɨ pemutaine: «Xemɨkwiwawe, tumuanari xeke'akɨne».","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Xeimiriyari xɨka 'anuyeyani, 'ahetsiemieme, xeitukari hepaɨ pepɨtixeiya,","poem":1},{"text":"tɨkarikɨ yapaɨmexɨa hurayari maye'axeni hepaɨ pepɨtixeiya.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Pepɨwarakumaweriya teɨteri. Heinɨtsika hepaɨ mepɨ'ane.","poem":1},{"text":"Ximeri mepɨtinunuiwa, tupiriya hepaɨ","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ximeri witsi'anetɨ yɨratɨ mɨtineika","poem":1},{"text":"taikaita 'ari pɨyɨna pɨwaki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"'Ahaxɨa yurikɨ pɨtatsikwa'a,","poem":1},{"text":"pemɨha'akɨ pepɨtatsimariuta.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"'Ahɨxie tita 'axatemɨte'uyuri pepɨtixeiya,","poem":1},{"text":"'ahekɨaripa pɨti'ane 'axatemɨte'uyuri ketemɨte'anukanama.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Ahaxɨakɨ tatukari peyeika naitɨ,","poem":1},{"text":"xei'itukariyari pɨreutetere tawiyari ketemɨteheutetere.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hipatɨ haika tewiyari heimana tamamata wiyari mepɨtihipite,","poem":1},{"text":"heiwa tepanuti'axe nauka tewiyari wiyari,","poem":2},{"lineBreak":true},{"text":"xɨka tɨrɨkariya 'akuxi tehexeiyani.","poem":2},{"text":"'Apɨpaɨme mɨkɨ wiyari, mɨyatɨtɨ,","poem":1},{"text":"waɨkawa 'uximayatsika pɨtiuyɨne meta 'uximatɨarika:","poem":2},{"lineBreak":true},{"text":"yapauka kananuyekɨkani, tameta wahamatɨa tekaniuhuni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"¿Kemɨ'ane 'ahaxɨa mɨtɨrɨkaɨye petimaiwe?","poem":1},{"text":"'Ahaxɨa pɨmariwe ketemɨteheumama temetsimakaxetɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ketatineuta'ɨkitɨa tatukari 'aixɨa 'anemekɨ temɨ'inɨatanikɨ,","poem":1},{"text":"ta'iyari mɨtimaiwenikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yawé, ¿kepauka tahetsɨa pepɨnuani?","poem":1},{"text":"Keniwanenimayaka mate'uximayatsiriwamete.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Anaki'eriyakɨ ketanehɨniyani ximeri,","poem":1},{"text":"kepaɨmexɨa tukari temu'uwani teputikwikani teyutemamawietɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kepaɨmexɨa wiyari temɨte'uka'eniwakai petatsihiweritɨatɨ,","poem":1},{"text":"mɨkɨ tukari hikɨ temawierika pɨta kenayeitɨa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yaketatineuxeiyatsitɨa 'a'uximayatsikakɨ,","poem":1},{"text":"witsikepemɨ'anekɨ tanuiwarite wahetsiemieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Tati'aitɨwame takakaɨyari","poem":1},{"text":"ketatsiparewieka.","poem":2},{"text":"'Aixɨa kenaineni ta'uximayatsika hetsiemieme,","poem":1},{"text":"huu, 'aixɨa kenaineni ta'uximayatsika hetsiemieme.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}