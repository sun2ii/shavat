{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":91,"content":[{"type":"verse","number":1,"content":[{"text":"Kemɨ'ane 'Amutewi hetɨa muyu'awieta","poem":1},{"text":"'akaniuyeikamɨkɨ Naimekɨmɨtɨrɨkaɨye 'i'etɨriwiyakaku.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yawé ne mɨpaɨ nepɨrahɨawe:","poem":1},{"text":"«'Ekɨ 'ahetsɨa nemɨne'awieta pepɨhɨkɨ, 'ahetsie nemɨtiwiya,","poem":2},{"lineBreak":true},{"text":"Kakaɨyari kemɨ'ane yuri nemɨti'eririe netsiparewiekaku».","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mɨkɨ xeikɨa metsi'uxɨna pɨyɨwe tiyumemiwame winiyarieyatsie","poem":1},{"text":"meta kwiniya mɨtiyumemiwatsie,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"metsɨ yu'anakɨ kamenanukanakamɨkɨ","poem":1},{"text":"meta 'anateyatɨa muyuti'awieta pɨyɨwe.","poem":2},{"lineBreak":true},{"text":"Yuri kemaine, mɨkɨ 'ahetsie nunuwame payani.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tɨkari mumariwetsie pepɨkaheumaka,","poem":1},{"text":"meta 'ɨrɨkɨ tukarikɨ mɨtimɨiyanekɨ,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"meta kwiniya 'etɨriyapa mɨtatsihupienekɨ","poem":1},{"text":"meta tukarikɨ mɨɨya mɨwaka'unakɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tsepa xeimiriyari 'a'utata mukaxɨri,","poem":1},{"text":"meta tamamata miriyari 'atserieta,","poem":2},{"lineBreak":true},{"text":"peru 'ekɨ pepɨka'atiweni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yurikɨ pekaninierimɨkɨ,","poem":1},{"text":"pekaniwaxeiyamɨkɨ Kakaɨyari memɨka'ayexeiya kepauka memɨte'akapitɨarieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Metsɨari Yawé hetsɨa pekaniyu'awietani,","poem":1},{"text":"meta 'ahetsie nunuwame 'Amutewi kanihɨkɨtɨni,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"nitixaɨtɨ 'uximatɨarika 'ahetsie pɨkatinuani,","poem":1},{"text":"nitixaɨtɨ kwiniya 'akie pɨkatinuani.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mɨkɨtsɨ yuniuki tuayamete kaniwatanɨ'amɨkɨ","poem":1},{"text":"naime 'ahuyeta memetsi'ɨwiyanikɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mɨkɨ yumamatekɨ mekamenanukuhanikuni,","poem":1},{"text":"pemɨkahekawautsenikɨ tetetsie.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mayetsi watsata pepuyeikani,","poem":1},{"text":"'ɨrawetsixi meta kuuterixi pepɨwatiketsini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Ne nepixɨna, mɨkɨ nehamatɨa muyeikakɨ,","poem":1},{"text":"hetsiena nepunuaka, kenemɨtitewa mɨnetsimatekɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mɨkɨ pɨnetsitahɨawe, neta nepita'eiya,","poem":1},{"text":"hamatɨana nepuyeikani kepauka 'uximatɨarika mexeiyani,","poem":2},{"lineBreak":true},{"text":"nekanixɨnamɨkɨ 'aixɨa nekatinitahɨawimɨkɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Waɨkawa wiyari nepipitɨani,","poem":1},{"text":"newikweitsitɨarikatsie nepitemawieritɨani».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}