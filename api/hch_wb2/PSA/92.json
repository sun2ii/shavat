{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":92,"content":[{"type":"hebrew_subtitle","content":["Nɨawari xawatikɨ kwikarɨwame 'uxipiya tukaritsie."]},{"type":"verse","number":1,"content":[{"text":"Yawé, 'aixɨa pɨ'ane pamɨpariyutsi mɨmatsipitɨaka","poem":1},{"text":"meta nɨawari mexeiyani 'ahetsiemieme, 'Amutewi 'aku,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"meta 'anaki'eriya mɨmariwe mukuxatani ximeri,","poem":1},{"text":"metatsiere ke'aixɨa pemɨtikamie tɨkarikɨ,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"kanarite meta xaweri hayuanekaku,","poem":1},{"text":"haripa hayuanekaku ketiutikwikatɨreni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yawé, 'ekɨ temawierikakɨ pepɨnetsihɨniya mariweme pemɨtiyurienekɨ,","poem":1},{"text":"'ayumieme 'aixɨa nepaineni 'atɨrɨkariya 'uximayatsikaya hetsiemieme.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yawé 'aku, waɨkawa pɨmamariwawe 'awewiya,","poem":1},{"text":"meta pɨkayumatiwanɨa kepemɨtiku'eriwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yuri memɨkate'erie 'atsimepɨkatemate,","poem":1},{"text":"'atsimemɨkatemate mepɨkaheitimaitɨkɨka,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kakaɨyari memɨka'ayexeiya tsepa memɨyɨra tupiriya hepaɨ,","poem":1},{"text":"meta tsepa memutixutui,","poem":2},{"text":"yuheyemekɨ mekaneuyehɨiyakuni.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Yawé, 'ekɨ xeikɨa yuheyemekɨ 'aixɨa pekatinahɨawarɨwamɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yawé, yurikɨ mematsi'aye'unie,","poem":1},{"text":"yurikɨ hekɨakamekɨ mekanikwikuni,","poem":2},{"text":"metaxɨrietɨkaitɨ naitsarie","poem":1},{"text":"mekanakɨnikuni 'axateyuruwamete.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tuuru yeutanaka tɨrɨkariyaya pepɨnetsi'upitɨa,","poem":1},{"text":"pepɨnetsi'ukawiri witsimu'ɨa 'aixɨa mɨ'anekɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nehɨxie memɨkaxɨrienikɨ memɨnetsi'aye'unie yapepɨtiuyuri,","poem":1},{"text":"meta ne'enatɨ kepauka memɨkwi'iwarɨmenitsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Takɨ hepaɨ mepɨte'uxutuwe 'aixɨa memɨte'u'iyari,","poem":1},{"text":"kariuxa Riwanu mieme hepaɨ mepɨte'uwawere.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yawé kie me'etsietɨ,","poem":1},{"text":"takakaɨyari takwana mepuxutu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tsepa memu'ukirawetsixi, meputixuxuawereni,","poem":1},{"text":"yuheyemekɨ metɨrɨkawitɨ metsitsiɨrawitɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Meke'ihekɨatani: «Yawé heitserie kanexeiyani,","poem":1},{"text":"mɨkɨ ne'ai kanihɨkɨtɨni, hetsiena 'axamɨti'ane pɨtiumawe».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}