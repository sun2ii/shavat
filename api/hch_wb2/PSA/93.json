{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"Yawé katini'aitani, witsi'aneme 'anakatɨtɨ,","poem":1},{"text":"Yawé mariwemekɨ pɨyutikemaritɨa","poem":2},{"lineBreak":true},{"text":"yɨtɨrɨkariya panakatɨ.","poem":2},{"text":"'Aixɨa 'aneme kwie putawewi,","poem":1},{"text":"hatsuaku pɨkakuyuitɨarieni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Matɨari paitɨ 'uwenieya puyukake,","poem":1},{"text":"meta 'ekɨ matɨari paitɨ yuheyemekɨ pepuyeika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yawé, kepauka waɨkawa haa muwayeneikatɨka","poem":1},{"text":"waɨkawa 'utatɨrarɨkatɨ,","poem":2},{"lineBreak":true},{"text":"kaniuyuaneni hamewarieya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Peru Yawé, muyuawitsie pɨmariwe:","poem":1},{"text":"waɨkawa tɨrɨkaɨyetɨ haa kemuyuane reuyeta,","poem":2},{"lineBreak":true},{"text":"meta haramara hamewarieya kemɨkatitɨrɨkaɨye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yawé, 'aitsikaya hetsie temɨtewiyani 'aixɨa pɨ'ane,","poem":1},{"text":"kiiya mɨpatsiekɨ 'aixɨa pɨ'itɨarie yuheyemekɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}