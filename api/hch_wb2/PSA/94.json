{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":94,"content":[{"type":"verse","number":1,"content":[{"text":"Yawé, Kakaɨyari 'ekɨ tahetsiemieme pemɨtiwarakapitɨwa,","poem":1},{"text":"Kakaɨyari tahetsiemieme pemɨtiwarakapitɨwa, pematsiɨkɨme kene'ayeitɨa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kenanukukexi, 'itsɨkame 'ikɨ kwieyaritsie pemɨti'aita,","poem":1},{"text":"yaketiniwarakapitɨa kwinimieme memɨteyuti'ɨre.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yawé, ¿kepaukake mepɨtehayewa","poem":1},{"text":"Kakaɨyari memɨka'ayexeiya meyutemamawietɨ kememɨteyuriekɨ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yunaitɨ mɨkɨ 'axateyuruwamete mekanihɨkɨtɨni,","poem":1},{"text":"niuki peraixi, meteyukatawe'erietɨ xeikɨa mekaniutiniukani.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yawé, 'ateɨterima mepɨtiketsinarɨwa,","poem":1},{"text":"waɨriyarika mepɨte'aitɨarie pemɨwaranayexei.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wiuraxi mepɨwakuya, meta teewatari,","poem":1},{"text":"metatsiere nutuite.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mɨpaɨ me'utiyuatɨ: «Yawé pɨkaniere,","poem":1},{"text":"Kakuwu Kakaɨyarieya 'atsipɨkatimate».","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"'Ikɨ xekeneuti'eniexɨa, teɨteri 'atsixemɨkatemate,","poem":1},{"text":"¿'atsixemɨkatemate kepaukari xepeiti'enietɨkɨne?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"¿Kamɨtsɨ kati'ena kemɨ'ane nakate mɨtatsihawewiriexɨa,","poem":1},{"text":"meta kamɨtsɨ katiniere kemɨ'ane tahɨxite mutiwewi?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"¿Kamɨtsɨ kataranayewaxɨani kemɨ'ane nuiwarite mɨwaranayewaya","poem":1},{"text":"meta kemɨ'ane 'ena kwiepa mɨ'ɨxatsita?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yawé, teɨteri kememɨteyɨkɨhɨawe kaniwamaika,","poem":1},{"text":"mɨpaɨ katinimaika kename tixaɨtɨ mekatehɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yawé, keyutemawieka kemɨ'ane 'ekɨ pemanayewaya,","poem":1},{"text":"kemɨ'ane 'ekɨ pemɨti'ɨkitɨa 'a'aitsikatsie,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"minewienikɨ kayuwatɨ 'uximatɨarika tukariyari,","poem":1},{"text":"mexi 'akuxi Kakaɨyari mɨka'ayexeiya putsuya wewiyaneni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yawé yuteɨterima pɨkawaku'eirieni,","poem":1},{"text":"mɨwaranayexei pɨkawanutuita.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Xanetsika tita mɨtiheitserietsie katinitaxatamɨkɨ,","poem":1},{"text":"kemɨ'ane 'iyari heitseriekame memexeiyani mɨkɨ mepenukuweiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Xewitɨ pɨkanetsi'uparewi kepauka Kakaɨyari memɨka'ayexeiya memɨnetsi'utamitsie.","poem":1},{"text":"Nixewitɨ nehetsie nuatɨ 'axateyuruwamete pɨkawaraye'uniekai.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Xɨka Yawé kanetsi'uparewienike,","poem":1},{"text":"yapauka nemɨme kayuwatɨ nepɨtihunikekai.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yemekɨ 'aixɨa nekatixatawetɨ: «Nepekaharuarɨka»,","poem":1},{"text":"Yawé, 'anaki'eriya 'upayeikakairi netsiparewienike.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kepauka nehetsie 'iyaritɨarika waɨkawa mɨtixɨawekai,","poem":1},{"text":"'anɨtɨarika ne'iyari pɨhɨniyakai temawierikakɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"'Ekɨ te'aitamete 'axamemɨte'u'iyari pepɨkawahamiku,","poem":1},{"text":"'axa'anemekɨ memɨte'aita,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"'aixɨa memɨte'u'iyari wahetsiemieme niuki 'axa'aneme memɨwewie,","poem":1},{"text":"meta memuwakuya 'atsimemɨkate'u'iyari.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yawé matsi nehetsie nunuwame pɨhɨkɨ,","poem":1},{"text":"Nekakaɨyari kanihɨkɨtɨni, 'ai nemɨne'awitatsie.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mɨkɨ 'axaxemɨte'uyurikɨ pɨtixe'akapitɨani","poem":1},{"text":"meta 'axaxemɨteyuriekɨ pɨxeka'una,","poem":2},{"lineBreak":true},{"text":"Yawé takakaɨyari pɨxekwini.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}