{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"Xekenakɨni, Yawé tepɨtanɨawa teyutemamawietɨ,","poem":1},{"text":"kwi tepehɨaweni 'ai tatsiwikweitsitɨwame.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hɨxiena tepɨye'axeni pamɨpariyutsi te'ipitɨatɨ,","poem":1},{"text":"kwi tepehɨaweni kwikarikɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yawé Kakaɨyari mɨmariwe mɨhɨkɨkɨ,","poem":1},{"text":"Ti'aitame mɨmariwe kakaɨyarixi wahetsiemieme.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mamayatsie pɨti'ane kwieta meukatewa,","poem":1},{"text":"pɨtipiinieya hɨrite 'amanutitɨtɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Haramara pɨtipiinieya, mitawewikɨ,","poem":1},{"text":"yumamakɨ kwie putawewi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Xekenakɨni, hɨxiena tepakatutsitaxɨani,","poem":1},{"text":"tepɨtitunuma'uni","poem":2},{"lineBreak":true},{"text":"Yawé hɨxie mɨtatsi'utawewi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mɨkɨ takakaɨyari mɨhɨkɨkɨ,","poem":1},{"text":"tameta teɨterimama,","poem":2},{"lineBreak":true},{"text":"muxatsimama tekanihɨkɨtɨni mɨtatsihɨ yukuraruta.","poem":2},{"lineBreak":true},{"text":"Xɨka xeme hikɨ niukieya xe'u'enieni,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"yu'iyari xepɨkatseiriyani, Meriwa mɨrakutewatsie kememuyɨ","poem":2},{"lineBreak":true},{"text":"'iya tukaritsie hepaɨ, makumawetsie Matsaha xemu'uwakaitsie,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"kepauka xepaapama memɨnetsi'uta'inɨataxɨ,","poem":1},{"text":"menetsikwamanakutɨ,","poem":2},{"lineBreak":true},{"text":"wahɨxie yanetiyurienekakutɨtɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Huta tewiyari wiyari nepɨha'akai","poem":1},{"text":"mɨkɨ nuiwari hetsiemieme,","poem":2},{"text":"mɨpaɨ nekaniutayɨni: «Mɨkɨ teɨteri xeime pɨta huye mepuweiya,","poem":1},{"text":"nehuye mepɨkamate».","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hikɨ neha'atɨ, mɨpaɨ neputayɨ:","poem":1},{"text":"«Hatsuaku nehetsɨa mepɨkaye'axɨani hakewa nemɨwareka'uxipitɨanikekaitsie».","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}