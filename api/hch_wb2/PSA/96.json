{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":96,"content":[{"type":"verse","number":1,"content":[{"text":"Yawé hetsiemieme xekeneutakwika kwikari hekwame,","poem":1},{"text":"Yawé hetsiemieme xekenekwikani, teɨteri yunaitɨ kwiepa xemɨtama.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yawé hetsiemieme xekenekwikani, xekenenɨawani,","poem":1},{"text":"xekenekuxatani tukarikɨ kemɨrayu'iwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nuiwarite watsata xekenekuxatani witsikemɨ'ane,","poem":1},{"text":"meta mariwemekɨ kemɨtiyuriene xekenekuxatani yunaime teɨteri watsata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kanimariweni Yawé, hetsiena pɨtinakeni witsimɨtikɨhɨawarɨwanikɨ,","poem":1},{"text":"matsi waɨkawa makaxiwatɨ keyuri hipatɨ kakaɨyarixi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yunaitɨ nuiwarite wakakaɨyarixi tixaɨtɨ mepɨkatehɨkɨ,","poem":1},{"text":"matsi Yawé muyuawi kaniutawewieni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Xawatɨriyaya meta kemɨtimariwe niukametemama mekanihɨkɨtɨni,","poem":1},{"text":"witsipɨtiuye'ane meta tɨrɨkariya kanixuaweni tukieya mɨpatsieta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yawé xeketeneyetuiri, yunaitɨ teɨteri,","poem":1},{"text":"Yawé yaxeketeneutahɨawi witsikemɨ'ane meta kemɨtitɨrɨkaɨye.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yawé yaxeketeneutahɨawi witsikemɨ'ane mɨmariwekɨ hetsiena mɨtinakenikɨ,","poem":1},{"text":"xeketenemawirieka meta takwana xekeneutahakeni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yawé hɨxie xekenetitunuma'uweni tukieya mɨmariweta,","poem":1},{"text":"yunaitɨ kwiepa xemɨtama xekenayemakaxeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nuiwarite mɨpaɨ meke'utiyuaneni:","poem":1},{"text":"«Yawé pɨti'aitame».","poem":2},{"text":"Mɨkɨ kwie putawewi,","poem":1},{"text":"hatsuaku pɨkakuyuitɨarieni.","poem":2},{"lineBreak":true},{"text":"Mɨkɨ teɨteri wahetsie pɨti'aita heitseriemekɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Muyuawi meta kwie xekeneyutemamawieka.","poem":1},{"text":"Haramara ke'utayuaneni meta yunaitɨ mana memɨteye'uwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Naitɨ mɨraka'etsitɨre mukumane xeyutemamawietɨ xekeneutikwikani, meta yunaitɨ mana memɨtexuawe.","poem":1},{"text":"Naitsarie kɨyexite hɨritsie meke'utikwikani.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yawé hɨxie xekeneutikwikani, 'ukanamieniri.","poem":1},{"text":"'Ukanamieniri kwiepa 'aixɨa tiyurienike.","poem":2},{"text":"Kwiepa memɨtama kaniwataxanetamɨkɨ kemɨtiheitseriekɨ,","poem":1},{"text":"meta teɨteri wahetsie yuri mainekɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}