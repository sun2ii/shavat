{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":97,"content":[{"type":"verse","number":1,"content":[{"text":"Yawé pɨti'aitame.","poem":1},{"text":"Kwie keyutemawieka.","poem":2},{"lineBreak":true},{"text":"Xekeneyutemamawieka kwie haramaratsie xemɨyetei.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Haiwitɨri 'anenetɨ yɨyɨwitɨ 'auriena kanatetɨkani,","poem":1},{"text":"heitserie katinikuxatani yu'uwenitsie 'akaitɨ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tai hɨxiena 'anuyekaitɨ kaniumieni,","poem":1},{"text":"memeye'unie mɨwatitaiya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mimierikayakɨ kwiepa kanakuhekɨkɨareni,","poem":1},{"text":"'ixeiyatɨ kwie kaniwatayuaneni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yawé hɨxie, kwie naime mukutsiyari,","poem":1},{"text":"hɨrite pɨtixɨrɨwe katira hepaɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Muyuawi pikuxata heitserie kemɨrexeiya,","poem":1},{"text":"yunaitɨ teɨteri mepixeiya kemɨtimariwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Meke'utewiyatsitɨarieni yunaitɨ kakaɨyarixi memɨwarayexeiya,","poem":1},{"text":"kemɨ'ane memɨyuti'ɨre memɨkakakaɨyarixi wahekɨ.","poem":2},{"lineBreak":true},{"text":"Yunaitɨ kakaɨyarixi hɨxiena xekeneukahɨxima'uti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yawé, heitserie kepemɨtiyurienekɨ,","poem":1},{"text":"Tsiyuni mɨkɨ pɨti'enie mɨkɨkɨ puyutemawie,","poem":2},{"lineBreak":true},{"text":"meta Kura kiekariyarite puyutemamawie.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Ekɨ Yawé 'Apemutewi pemɨhɨkɨkɨ,","poem":1},{"text":"kwiepa naitsarie pemɨti'aita.","poem":2},{"lineBreak":true},{"text":"'Ekɨ matsi memɨkakakaɨyarixi wayeta yemekɨ pepɨkawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yawé pɨwanaki'erie kemɨ'ane 'axamɨti'ane memɨxani'erie,","poem":1},{"text":"'aixɨa memɨteyurie mɨkɨ watukari pɨ'ɨwiya,","poem":2},{"lineBreak":true},{"text":"kepauka Kakaɨyari memɨka'ayexeiya memuwa'uximatɨa wahetsie kaninuaka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Heitserie memexeiya hekɨariya wahetsie pɨ'axe,","poem":1},{"text":"meta temawierika pɨ'axe kemɨ'ane yu'iyaritsie 'aixɨa memɨteyɨkɨhɨawe wahetsie.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xekeneyutemamawieka Yawé hetsie, xeme teɨteri heitserie xemexeiya,","poem":1},{"text":"meta 'aixɨa xekenaitɨkani hetsiena mieme kemɨtipatsie.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}