{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":98,"content":[{"type":"hebrew_subtitle","content":["Nɨawari."]},{"type":"verse","number":1,"content":[{"text":"Xekenekwikani Yawé hetsiemieme kwikari hekwame,","poem":1},{"text":"mariweme mɨtiuyurikɨ.","poem":2},{"text":"Yɨtɨrɨkariyakɨ, yumamá patsiekamekɨ,","poem":1},{"text":"mɨwara'iwaxɨkɨ memeye'unie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yawé pitihekɨata kemɨrayu'iwaxɨkɨ,","poem":1},{"text":"pɨtiwahekɨatɨa heitserie kemɨrexeiya nuiwarite wahɨxie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Paye'eri naki'eriya kemɨrexeiya meta ke'aixɨa mɨtikamie,","poem":1},{"text":"'ixaheritsixi teɨteriyari wahetsiemieme,","poem":2},{"text":"yunaitɨ teɨteri kwiepa memɨtama yamepɨtemate","poem":1},{"text":"takakaɨyari wikweitsitɨarikaya hetsiemieme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kwi xekenahɨaweni Yawé xeyutemamawietɨ,","poem":1},{"text":"yunaitɨ kwiepa xemɨtama.","poem":2},{"lineBreak":true},{"text":"Xekeneutikwikani xeyutemamawietɨ kwikari meta nɨawari.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xekeneutikwikani nɨawari Yawé hetsiemieme haripa hayuanekaku,","poem":1},{"text":"kanarikɨ meta kwikari witsihanɨyɨtɨkaime.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kwi xekenahɨaweni Yawé xeyutemamawietɨ, Ti'aitame,","poem":1},{"text":"pirikɨxa hayuanekaku meta kuxineta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Haramara ke'utatɨrarɨkani meta yunaitɨ mana memɨteye'uwa,","poem":1},{"text":"meta kwie, meta mana memɨtama.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"'Aki haa 'amupapa muyehapane mekete'utahutsunani,","poem":1},{"text":"meta hɨrite meke'utikwikani meyutemamawietɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yawé hɨxie xekeneutikwikani,","poem":1},{"text":"'ukanamieniri kwiepa 'aixɨa tiyurienike.","poem":2},{"text":"Kwiepa memɨtama wahetsie 'aixɨa katiniyurimɨkɨ,","poem":1},{"text":"teɨteri wahetsie 'aixɨa 'anemekɨ katinita'aitamɨkɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}