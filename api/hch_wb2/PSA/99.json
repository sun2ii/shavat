{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"PSA","translationId":"hch_wb2","name":"Nɨawari","commonName":"Nɨawari","title":"Kakaɨyari nɨawariyari","order":19,"numberOfChapters":150,"sha256":"301f698f388c228aeb46ec9c50794651f4d3665930a3b70a775b2a2db9b3053a","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hch_wb2/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"Yawé ti'aitame kanihɨkɨtɨni:","poem":1},{"text":"nuiwarite meke'utiyɨyɨakani.","poem":2},{"text":"Mɨkɨ yuteɨtamete watsata yu'uweni kaniukeka:","poem":1},{"text":"kwie ke'utayuaneni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yawé kanimariweni Tsiyuni hetsie,","poem":1},{"text":"meta kanimariweni yunaime teɨteri waheima.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Aixɨa keraniuwani hetsiena mieme mɨmariwekɨ makaxiwatɨ:","poem":1},{"text":"mɨkɨ kanipatsieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ti'aitame pemɨtɨrɨkaɨye, 'aixɨa mɨti'ane pemɨtinaki'erie:","poem":1},{"text":"'ekɨ mɨtiheitserie pepɨtiukaye","poem":2},{"lineBreak":true},{"text":"meta Kakuwu hetsie 'aixɨa pepɨtiyuriene heitseriemekɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yawé hetsiemieme witsixekenaitɨkani mɨtakakaɨyari:","poem":1},{"text":"hetɨana xekenetihɨxima'uweni:","poem":2},{"lineBreak":true},{"text":"mɨkɨ kanipatsieka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Muitsexi 'Aruni hamatɨa, mawari wewiwamete wahamatɨa mepaye'ukai,","poem":1},{"text":"meta Tsamuheri, kemɨ'ane memehɨawekai wahamatɨa.","poem":2},{"text":"Yawé meputahɨawixɨ, mɨkɨta pɨwaruta'ei,","poem":1}]},{"type":"verse","number":7,"content":[{"text":"haiwitɨritsie 'amuwekaitsie paitɨ kaniwarutahɨawe.","poem":2},{"text":"Mekaneye'atɨani 'aitsikateya,","poem":1},{"text":"'inɨari niukiyari mɨwayetuiritsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yawé meta takakaɨyari, 'ekɨ pepɨwaruta'ei,","poem":1},{"text":"'ekɨ wahetsiemieme Kakaɨyari petiwareuyehɨwirietɨ pepatɨa,","poem":2},{"lineBreak":true},{"text":"meta kepauka pemɨwaru'uximatɨa 'axamete'uyurieku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yawé hetsiemieme witsixekenaitɨkani mɨtakakaɨyari:","poem":1},{"text":"xekenayexeiyani tukitana:","poem":2},{"lineBreak":true},{"text":"Kanipatsieka Yawé takakaɨyari.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}