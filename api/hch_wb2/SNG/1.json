{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"SNG","translationId":"hch_wb2","name":"Kwikari","commonName":"Kwikari","title":"Kwikari witsimɨ'ane","order":22,"numberOfChapters":8,"sha256":"bd2bf087210231d526f4b505f65ad8a4769404396ec758d73a68be43b369ff86","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/hch_wb2/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Tsarumuni kwikarieya xapayari."]},{"type":"verse","number":2,"content":[{"text":"Xɨka, penetsi'u'itsenike 'ateni kemɨtiyu'itsewekɨ,","poem":1},{"text":"matsi 'aixɨa pɨ'ane 'anaki'eriya, keyuri winu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Witsimu'ɨata pemɨ'akawiriwa, yemekɨ puwanake,","poem":1},{"text":"'ekɨtɨtɨ pekanihɨkɨtɨni waritsamu witsimu'ɨa.","poem":2},{"lineBreak":true},{"text":"Kauka 'ayumieme 'ɨimarixi memenenaki'erie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kene'amexɨitɨaka, 'ahetsiemieme yemekɨ kenenayeitɨa.","poem":1},{"text":"Kenenanuwitɨki pemuyehuputsie, ti'aitame.","poem":2},"Wahamikuma",{"text":"Tepuyutemamawieka ta'iyarikɨ teyunaitɨ,","poem":1},{"text":"tepiku'eriwani kepemɨti'amaɨwa keyuri winu.","poem":2},{"lineBreak":true},{"text":"Titakɨ mɨmatinaki'erieka panayuhayewa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Uka mɨyɨwi nepɨhɨkɨ, peru witsinepɨti'iɨmari,","poem":1},{"text":"'ukari 'aku Kerutsaremetari,","poem":2},{"text":"nekaniyɨwini Tseraxi teɨteriyari waxamaru hepaɨ,","poem":1},{"text":"witsinekatini'ɨimarika Tsarumuni 'ixuriki kiiyarieya hepaɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Newaiyaritsie xepɨkanetsixeiyani nemɨyɨwikɨ,","poem":1},{"text":"tau nenawiyari mɨyakaniuyurieni.","poem":2},{"text":"Ne'iwama 'ukitsi mekaneniuyeheka,","poem":1},{"text":"kaxie haraweriyari 'ɨwiyariyarikɨ mekaneniuta'aitɨani waɨriyarika,","poem":2},{"lineBreak":true},{"text":"meta nekaxie 'aixɨa nepɨkatiɨ'ɨwiyaxɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kenetineutaxatɨa, 'uki nemɨmatsinaki'erie,","poem":1},{"text":"¿hakewa 'amuxatsima pepɨwaretihɨwe?","poem":2},{"lineBreak":true},{"text":"¿hakewa tuka pepɨwareti'uxipitɨwa?","poem":2},{"text":"¿Ne titayari netikuyeika xeikɨa,","poem":1},{"text":"'ahamikuma wamuxatsima wahamatɨa?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Xɨka 'atsipekatimaika, 'uka witsipemɨti'ɨimari 'ukari watsata pe'uyeikatɨ,","poem":1},{"text":"muxatsi waketate kemɨreuyuyune kenanukuweiya","poem":2},{"text":"meta 'atsipuri tɨɨrixi keniwahɨneni,","poem":1},{"text":"muxatsi wahɨwemete wakii maku'utsie.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Ekɨ meta kepemɨreuyukuniɨtɨa, 'uka nemɨmatsi naki'erie,","poem":1},{"text":"Kawayutsixi nepɨwaraye'eriwa witsimemɨtehekɨniɨtɨarietɨka yumu'uyaritsie","poem":2},{"lineBreak":true},{"text":"Parahuni kaxetaya memuhaxime.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Witsipɨtiyuxexeiya 'a'aurite meta kepemɨti'akutsa'a.","poem":1},{"text":"'Akɨipi witsipɨtiutimerɨka 'akukakɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Anakɨtsa tepɨtiwewieni hurukɨ","poem":1},{"text":"meta pɨratakɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ti'aitame mexi mexatsie 'utika,","poem":1},{"text":"witsimu'ɨa nemɨnetawiri kaniɨkɨ'ɨareni hetsiena.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Uki neminaki'erie, mixaxi witsimu'ɨa purutsata mɨyeka hepaɨ kani'aneni,","poem":1},{"text":"netawitsie kaneukukutsuni neheikukwekaku.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"'Uki neminaki'erie, 'aukwe tuturiyari witsimu'ɨa hepaɨ kani'aneni","poem":1},{"text":"'Enikaritsie kaxie 'iteɨriyari hepaɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kwinimieme pepɨti'ɨimari, 'uka nemɨmatsinaki'erie.","poem":1},{"text":"Witsipepɨ'ane.","poem":2},{"lineBreak":true},{"text":"'Ahɨxite, kukuruxi memɨyuhuta wahepaɨ pɨtiyuxexeiya.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kwinimieme pepɨtitemaikɨ, 'uki nemɨmatsinaki'erie.","poem":1},{"text":"Yemekɨ 'ekɨ pepɨnetsinake.","poem":2},"'Uki mɨnaki'eriwa",{"text":"'Ɨxa mɨtsitsiɨrawi ta'itari kanayeimɨkɨ kepauka temɨyutiwitɨnitsie,","poem":1}]},{"type":"verse","number":17,"content":[{"text":"takii pikaxiyari kariuxa kanihɨkɨtɨni","poem":2},{"lineBreak":true},{"text":"Huku mɨxexeurawi xawarikɨ kananukakitsieka.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}