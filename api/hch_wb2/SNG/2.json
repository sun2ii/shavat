{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"SNG","translationId":"hch_wb2","name":"Kwikari","commonName":"Kwikari","title":"Kwikari witsimɨ'ane","order":22,"numberOfChapters":8,"sha256":"bd2bf087210231d526f4b505f65ad8a4769404396ec758d73a68be43b369ff86","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/hch_wb2/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Ne tuutu Tsarunitsie mayeweri mɨxuawe nekanihɨkɨtɨni,","poem":1},{"text":"xewitɨ tuturi texuxuri mayeweritsie mieme.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Uka neminaki'erie, kepauka hipame 'ukarawetsixi watsata muyeika,","poem":1},{"text":"tuturi texuxuri xuyatsata muwe hepaɨ katiniyuxexeiyani.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Uki neminaki'erie kepauka hipame 'ukitsi watsata muyeika,","poem":1},{"text":"xikɨti","poem":2},{"noteId":0},{"text":"'ɨtsitsata mɨkawe hepaɨ katiniyuxexeiyani.","poem":2},{"text":"Kaneninakeni hetɨana nemɨ'etɨpieka,","poem":1},{"text":"witsikatinakakani takariyari.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kanenewitɨni kiita 'ixɨarari muwatiwewiwatsie,","poem":1},{"text":"muwa yunaki'eriya 'inɨariyari kaniwarepitɨani.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kaxie takari patsaruyarikɨ keneneutatɨrɨkariya,","poem":1},{"text":"manitsanakɨ keneneutahuxaitɨa,","poem":2},{"lineBreak":true},{"text":"nekanimɨximeni naki'eriyakɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mamaya 'utatana miemetsie nemu'u","poem":1},{"text":"mɨniuka'uxipitɨanike,","poem":2},{"lineBreak":true},{"text":"meta yutserieta miemekɨ kwimɨneniukwenike.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne mɨpaɨ nepɨtixewawirie, 'ukarawetsixi Kerutsareme kiekatari,","poem":1},{"text":"maxatsi 'ɨimarixi yeuta memu'uwakɨ,","poem":2},{"text":"'uka neminaki'erie xepɨkahehɨtɨaka xepɨkahei'uximatɨaka","poem":1},{"text":"tsepa kepaukake yukɨmana manutanierixɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"'Uki neminaki'erie hiwarieya.","poem":1},{"text":"Neuxei, 'ena kanamieni,","poem":2},{"text":"'utsunarɨmetɨ hɨritetsie,","poem":1},{"text":"'anutitsukwakatɨ hɨri 'amɨnenetsie.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Uki neminaki'erie maxa hepaɨ katiniyuxexeiyani,","poem":1},{"text":"maxa temaikɨ hepaɨ kani'aneni.","poem":2},{"text":"Paratsɨ xekeneuxeiya, takiiwarie warita kaniutiweni,","poem":1},{"text":"'awienierenetɨ maxawariyarietɨkata,","poem":2},{"lineBreak":true},{"text":"yɨkɨ'ɨwiyatɨ mayexaxawata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"'Uki neminaki'erie mɨpaɨ kanetiniutahɨawe:","poem":1},{"lineBreak":true},{"text":"«Kenanukukexi 'uka nemɨmatsinaki'erie,","poem":1},{"text":"hikɨmɨ kenewaye'a, 'uka witsipemɨti'ɨimari.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Neuxei, kananuyeyaniri xexerixa,","poem":1},{"text":"hamatɨanata kaniutanɨni wiyeri.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yeuta 'ari tuturi kanitineikani,","poem":1},{"text":"kwikari tukariyari kanaye'aniri.","poem":2},{"text":"'Ariri naitsarie kwiepa kani'eniɨriɨkɨni","poem":1},{"text":"kukuruxi memeɨyɨyɨxawi wakwikari.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Ariri piní matɨari mieme takariyari kanixuaweni,","poem":1},{"text":"'Ari kaxie xututɨ witsikaniukɨ'ɨareni.","poem":2},{"text":"Kenanukukexi, 'uka nemɨmatsinaki'erie,","poem":1},{"text":"nehetsɨa kenaye'a, 'uka witsipemɨti'ɨimari».","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nekukuru pemeutuxa, 'ai mukatataritsie","poem":1},{"text":"pemuyu'awieta,","poem":2},{"lineBreak":true},{"text":"meta hɨri 'amɨtiumariwetsie paitɨ,","poem":2},{"text":"kenanieri nepɨmatsixeiya,","poem":1},{"text":"keneutaniu nepumatsi'enieni,","poem":2},{"text":"'aniuki 'aixɨa kanimayaka","poem":1},{"text":"meta witsipekatini'axexeiyani.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kauxaitsi xekeniwarutiwiya,","poem":1},{"text":"mɨkɨ kauxaitsi tɨɨrixi","poem":2},{"text":"takaxie memɨtsewixima,","poem":1},{"text":"takaxie haraweriyari xuturiyari.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"'Uki neminaki'erie nehetsiemieme kanihɨkɨtɨni, neta hetsiena mieme,","poem":1},{"text":"mɨkɨ yumuxatsima kaniwarutihɨweni tuturi texuxuritsata.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tau ka'akayuniwekaku 'akuxi","poem":1},{"text":"meta 'etɨri ka'akumaweriwekaku 'akuxi,","poem":2},{"lineBreak":true},{"text":"nehetsɨa kani'axeni, 'uki neminaki'erie.","poem":2},{"text":"Maxa hepaɨ katiniunanautsani,","poem":1},{"text":"maxa temaikɨ hepaɨ, hɨritsie paitɨ.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":0,"caller":"+","text":"Manzana.","reference":{"chapter":2,"verse":3}}]},"thisChapterLink":"/api/hch_wb2/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}