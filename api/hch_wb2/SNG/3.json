{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"SNG","translationId":"hch_wb2","name":"Kwikari","commonName":"Kwikari","title":"Kwikari witsimɨ'ane","order":22,"numberOfChapters":8,"sha256":"bd2bf087210231d526f4b505f65ad8a4769404396ec758d73a68be43b369ff86","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/hch_wb2/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Tɨkarikɨ, ne'itaritsie ne'ukaitɨ","poem":1},{"text":"'uki neminaki'erie nekaniutiwauni,","poem":2},{"lineBreak":true},{"text":"matsi nepɨka'itaxei.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne 'anukukeme nekaneyeikani kiekaritsie,","poem":1},{"text":"huye mayehapanetsie meta waɨkawa mɨrewatuiyatsie,","poem":2},{"text":"'uki neminaki'erie nekuwaunetɨ.","poem":1},{"text":"Ne'iwaunetɨ nepɨka'itaxeiyawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mekaneniukaxexeyani","poem":1},{"text":"kiekaritsie tehɨwemete.","poem":2},{"text":"Mɨpaɨ netiwara'iwawiya:","poem":1},{"text":"«¿'Uki neminaki'erie hawaikɨ xekatehexeiya?»","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mɨya netiwaru'iwawiyakake nekanikaxeiya","poem":1},{"text":"'uki neminaki'erie.","poem":2},{"text":"Nekanitapa, neka'itatuayatɨ,","poem":1},{"text":"nemaama kie nekaneiwitɨkɨni,","poem":2},{"lineBreak":true},{"text":"kiita paitɨ hakewa nemaama mɨnetsiwatiniwexɨtsie.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne mɨpaɨ nepɨtixewawirie, 'ukarawetsixi Kerutsareme kiekatari,","poem":1},{"text":"maxatsi 'ɨimarixi yeuta memu'uwakɨ,","poem":2},{"text":"'uka neminaki'erie xepɨkahehɨtɨaka xepɨkahei'uximatɨaka","poem":1},{"text":"tsepa kepaukake manutanierixɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"¿Titatihɨkɨ makumawetsie mɨretineika","poem":1},{"text":"kɨtsi 'amuweni hepaɨ tiyuxexeiyatɨ,","poem":2},{"text":"mixaxi meta 'ɨkwa witsimu'ɨa tsata,","poem":1},{"text":"meta waɨkawa witsimu'ɨatɨka nɨtɨ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Neuxei,","poem":1},{"text":"Tsarumuni kaxetaya kaniyɨaneni.","poem":2},{"text":"Haika tewiyari kuyaxi me'eweiyatɨ mana pamie,","poem":1},{"text":"'ixaheritsixi kuyaxiyaritsie memanayexeiyarie kwinimieme yeme memɨteheuyutakwiwawe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yunaitɨ 'ixipara mekanakawɨtɨatɨkani,","poem":1},{"text":"meta mekateniuti'ɨkitɨarieni memeuyutakwiwawenikɨ,","poem":2},{"text":"yunaitɨ yu'ixipara yuhɨiyametsie mekanikawɨtɨatɨkani","poem":1},{"text":"tɨkarikɨ mɨkweriwa'anekɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tsarumuni yukaxeta kaniutawewieni","poem":1},{"text":"kɨye 'aixɨa mɨ'anenekɨ Riwanu mieme.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Matiwetɨka Pɨratakɨ kaniutiwewieni,","poem":1},{"text":"hurukɨta mitseiriyatɨka.","poem":2},{"text":"'Ɨpariyarita kaniutawipa taɨraɨyemekɨ,","poem":1},{"text":"taɨtana mekaniwaku'utɨani me'inaki'erietɨ","poem":2},{"lineBreak":true},{"text":"'ukari Kerutsareme kiekatari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Xekeniwayekɨni 'ukarawetsixi Tsiyunitari.","poem":1},{"text":"Ti'aitame Tsarumuni xekenexeiyani.","poem":2},{"text":"Yumu'utsie kanenamaka Kuruna maamaya menamaniri","poem":1},{"text":"kepauka mutineɨkixɨtsie mieme","poem":2},{"lineBreak":true},{"text":"kepauka 'iyarieya muyutemawiekai.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}