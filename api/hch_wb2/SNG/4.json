{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"SNG","translationId":"hch_wb2","name":"Kwikari","commonName":"Kwikari","title":"Kwikari witsimɨ'ane","order":22,"numberOfChapters":8,"sha256":"bd2bf087210231d526f4b505f65ad8a4769404396ec758d73a68be43b369ff86","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/hch_wb2/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Kwinie yemekɨ pepɨti'ɨimari 'uka nemɨmatsinaki'erie.","poem":1},{"text":"Witsipepɨti'axexeiya.","poem":2},{"text":"'Ahuxite 'ixuriki pemeukuwera warita, kukuruxi memeutuxa mepɨhɨkɨ.","poem":1},{"lineBreak":true},{"text":"'Akɨpate tsipuri xeitewayari memeuyɨyɨwi wahepaɨ pɨtiyuxexeiya","poem":1},{"text":"Karaha hɨriyaritsie memu'uwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Atamete muxatsi hekwamekɨ memutixikieni hepaɨ pɨtiyuxexeiya,","poem":1},{"text":"xike memanatikɨ me'uka'ɨyarieka.","poem":2},{"text":"Yuxexuitɨ mɨkɨ yu'iwama mepuwarexeiya,","poem":1},{"text":"xewitɨ pɨkayuxaɨta.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Ateni hɨiyame mɨxeta hepaɨ pɨtiyuxexeiya,","poem":1},{"text":"'aniuki pɨnetsihehana.","poem":2},{"text":"'A'aurite 'ixuriki pemeukuwera warita,","poem":1},{"text":"xikɨti hixɨata mɨxitekieka hepaɨ pɨtiyuxexeiya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Akɨipi Rawiri tuxiyuya hepaɨ pɨtiyuxexeiya,","poem":1},{"text":"tetexi mɨxitekietɨkakɨ mɨwewiya,","poem":2},{"text":"hetsiena pukuwɨ xeimiriyari kɨmana memɨyukunarɨma,","poem":1},{"text":"kuyaxi memɨyukunarɨma mɨkɨ naitɨ pɨhɨkɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Atsitsi yuhutatɨ maxatsi yeutari wahepaɨ mepɨteyuxexeiya,","poem":1},{"text":"'ɨimari niwemama yuhutame muwarayexei","poem":2},{"lineBreak":true},{"text":"memɨtekwatɨwe tuturi texuxuritsata.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Akuxi kakɨyɨriwekaku,","poem":1},{"text":"'akuxi 'etɨri katipariwekaku,","poem":2},{"text":"nekananutiyeimɨkɨ mixaxi yemuriyaritsie,","poem":1},{"text":"meta 'ɨkwa witsimu'ɨa hɨriyaritsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Naitɨ 'ekɨ witsipepɨ'ane, 'uka nemɨmatsinaki'erie,","poem":1},{"text":"naitɨ 'aixɨa pepɨ'ane.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hikɨmɨ tepanukakɨne Riwanu hɨriyaritsie, 'uka nemɨmatsihɨawene,","poem":1},{"text":"Hikɨmɨ tepanukakɨne Riwanutsie.","poem":2},{"text":"Kenanakaye'a 'Amaná hɨriyari 'amanutitewitsie,","poem":1},{"text":"Tsenixi meta Heximuni yekɨrita.","poem":2},{"text":"Kenanakaye'a hakewa mayetsi meme'uwatsie,","poem":1},{"text":"mɨkɨ hɨritsie hakewa tɨwexi memayu'eririya wakietsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ne'iyari pepɨhɨa,","poem":1},{"text":"ne'iwa 'uka nemetsihahɨawe,","poem":2},{"lineBreak":true},{"text":"xeihɨxiyarikɨtɨtɨ penetsi'uxeiyaku,","poem":2},{"text":"'akuka xeiwiwierikɨ","poem":1},{"text":"ne'iyari pepɨhɨa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kwinie yemekɨ witsipa'ane 'anaki'eriya,","poem":1},{"text":"ne'iwa 'uka nemetsihɨawene.","poem":2},{"text":"Matsi witsipa'ane 'anaki'eriya, winu kemɨkaha'ane,","poem":1},{"text":"meta pemuyutawiriwa witsimu'ɨa","poem":2},{"lineBreak":true},{"text":"tixaɨtɨ kemɨkatiɨ'ɨa hepaɨ pepɨ'ɨa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"'Uka nemetsihahɨawe, 'atenitsie xiete payeneika,","poem":1},{"text":"retsi meta xiete 'anenitɨa pepɨ'awieta.","poem":2},{"text":"Riwanu kemu'ɨa","poem":1},{"text":"mɨpaɨta pɨ'ɨatɨka 'akamixate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Haraweri tuturi muwa'etsie mɨreuname pekanihɨkɨtɨni,","poem":1},{"text":"ne'iwa 'uka nemetsihahɨawe,","poem":2},{"lineBreak":true},{"text":"haraweri tuturi muwa'etsie mɨreuname meta haixa manukaname pekanihɨkɨtɨni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Atsitsi xeiharaweriyari pɨhɨkɨtɨka xikɨti muwa'etsie,","poem":1},{"text":"witsi'anenetɨ 'ikwaxi,","poem":2},{"lineBreak":true},{"text":"tuturiyari naaru meta hatsahaxi,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"naitɨ kɨyexi muwatsuayatɨka witsimu'ɨatɨka,","poem":1},{"text":"naaru meta 'atsapɨrani,","poem":2},{"lineBreak":true},{"text":"karamu meta kanera,","poem":2},{"lineBreak":true},{"text":"mixaxi meta 'aruhe,","poem":2},{"lineBreak":true},{"text":"witsimɨti'anene xeikɨa naitɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Ekɨ haa pekanihɨkɨtɨni harawerita mieme,","poem":1},{"text":"haixa haa mayenierenikɨ mɨ'ayumieme mexeiya pekanihɨkɨtɨni,","poem":2},{"lineBreak":true},{"text":"haa 'akiyari pekanihɨkɨtɨni Riwanu makanena.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kenanutanieri, 'eka tayeta mieme.","poem":1},{"text":"'Eka tatsutɨa mieme, niwa kenaye'a.","poem":2},{"text":"Neharawerita xekeneuka'ekawi,","poem":1},{"text":"witsikemɨtiuye'ɨa xekeneutawiwiexɨa.","poem":2},{"text":"Yuharawerita 'uki neminaki'erie kehamieni","poem":1},{"text":"muwa mieme 'ikwaxi witsima'ane keha'inɨata.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}