{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"SNG","translationId":"hch_wb2","name":"Kwikari","commonName":"Kwikari","title":"Kwikari witsimɨ'ane","order":22,"numberOfChapters":8,"sha256":"bd2bf087210231d526f4b505f65ad8a4769404396ec758d73a68be43b369ff86","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/hch_wb2/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Neharaweritari nekaninuani,","poem":1},{"text":"'uka ne'iwa nemɨmatsi naki'erie,","poem":2},{"text":"muwa nepikaxei mixaxi waritsamu meta,","poem":1},{"text":"muwa xiete kwaiyarikɨ ne'iyari paye'axe.","poem":2},{"text":"Muwa nepikaxexeiya waɨkawa winu meta retsi,","poem":1},{"text":"naitɨ 'ikɨ pɨtinehetsiemieme.","poem":2},"Wahamikuma",{"text":"Hamikutsixi, xeketenekwaka xeketene'ieka,","poem":1},{"text":"xekeneutitarɨwai naki'eriyakɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne nepukutsukai, matsi ne'iyari payenierekai.","poem":1},{"text":"Hikɨ xeime niuki nekaniu'enieni.","poem":2},{"lineBreak":true},{"text":"'Uki neminaki'erie kitenie kanatawekaitɨni.","poem":2},{"lineBreak":true},{"text":"«Ne'iwa 'uka nemɨmatsi naki'erie,","poem":1},{"text":"witsipemɨti'ɨimari nekukuru,","poem":2},{"lineBreak":true},{"text":"keneneupitɨa nemeutahanikɨ.","poem":2},{"text":"Nemu'utsie haɨtsikɨ nepumu'uhawi,","poem":1},{"text":"tɨkarikɨ mieme hawiriya nekɨpatetsie panakaxɨrɨwe».","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nematsi nekaniyutikemaripieni,","poem":1},{"text":"nekapɨyɨwe tawari nemɨranakatɨni.","poem":2},{"text":"Nematsi ne'ɨkatetsie nekaneuyuhauxixɨaniri,","poem":1},{"text":"titayari tawari nereuyukwiemawani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"'Uki neminaki'erie mɨreukukekatsie hewakuxawakaku,","poem":1},{"text":"muwa kaneukumeni,","poem":2},{"lineBreak":true},{"text":"netaɨta nemeiyehɨakaikɨ waɨkawa nepɨnekatemawi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne'anukukeka 'uki nemɨnaki'eirie nekatineuyepirieni,","poem":1},{"text":"mixaxi nemamatetsie kanikakukekaitɨni.","poem":2},{"text":"Ne'itɨwametetsie paitɨ kananuyetsukekaitɨni","poem":1},{"text":"mɨreuyepieriketsie paitɨ kanikaxɨrɨwekaitɨni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kepauka nemɨreiyepiriri 'uki neminaki'erie,","poem":1},{"text":"'ari kaniukumawekaitɨniri.","poem":2},{"text":"Neyakaitɨniri,","poem":1},{"text":"hikɨ 'utɨmana nekaneyani.","poem":2},{"text":"Nekanitiwauni peru nepɨka'itaxei.","poem":1},{"text":"Kepauka nemitahiwi pɨkanetsiheta'ei.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mekaneniutaxeiya tehɨwemete","poem":1},{"text":"kiekaritsie meye'uwatɨ,","poem":2},{"text":"kiekari kuraruyari memɨ'ɨwiya","poem":1},{"text":"mekaneteniukwinitɨani mekaneneutiwaxɨani,","poem":2},{"lineBreak":true},{"text":"nexikuri mekananutihurieni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ne mɨpaɨ nepɨtixewawirie 'ukari Kerutsareme kiekatari,","poem":1},{"text":"xɨka 'uki neminaki'erie hawaikɨ xehekaxeiya,","poem":2},{"lineBreak":true},{"text":"mɨpaɨ xeketenetahɨawi kename netikuye ne'inaki'erietɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Uka kwinie yemekɨ witsipemɨti'ɨimari, ketatineutaxatɨa,","poem":1},{"text":"¿kehepaɨ timatsiɨkɨ 'uki peminaki'erie hipame 'ukitsi watsata?","poem":2},{"text":"¿Kehepaɨ timatsiɨkɨ 'uki peminaki'erie hipame 'ukitsi watsata,","poem":1},{"text":"mɨkɨ pemɨtatsiwawirie?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Uki neminaki'erie kwinie yemekɨ pɨtitemaikɨ, xetamekɨ 'utimerɨkatɨ,","poem":1},{"text":"tsepa tamamata miriyari wahamatɨa muyeika kanimatsiɨkɨni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mu'uya kanihurutɨni xeikɨa,","poem":1},{"text":"kɨpateya 'etsiwa kanitutunini","poem":2},{"lineBreak":true},{"text":"yɨyɨwitɨ kwatsa kemeu'ane hepaɨ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hɨxiteya kukuruxi wahepaɨ kani'aneneni","poem":1},{"text":"'aki'utɨa memɨyetei","poem":2},{"text":"retsikɨ me'ɨwatɨkaitɨ,","poem":1},{"text":"tetexi witsimɨ'anene hepaɨ metehekutetɨ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Auriteya waritsamu 'etsiyari hepaɨ pɨ'anene,","poem":1},{"text":"tupiriya witsimu'ɨatɨka 'etsiyari.","poem":2},{"text":"Teniteya tuturite 'atsutsena kanihɨkɨtɨni","poem":1},{"text":"muwa matineika mixaxi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mamateya huru tepɨayari kanihɨkɨtɨni","poem":1},{"text":"tupatsiyukɨ ti'utɨkaitɨ.","poem":2},{"text":"Hukaya putimerɨka witsimɨtiharuani hepaɨ","poem":1},{"text":"ti'utɨ yuyuawimekɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Teuriteya huta 'ikitsaraɨyari pɨhɨkɨ 'anuyexawawatɨtɨ","poem":1},{"text":"huru mɨhɨkɨakɨ yuwetɨkaitɨ.","poem":2},{"text":"Hɨxiena xɨka 'uyeikani pumariwekare,","poem":1},{"text":"Riwanu muyeikani hepaɨ kariuxa tsata.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tenieya kanakakani,","poem":1},{"text":"mɨkɨ witsikani'aneni 'uki.","poem":2},{"lineBreak":true},{"text":"Mɨpaɨ kani'aneni 'uki neminaki'erie, nehamiku,","poem":1},{"text":"'ukarawetsixi Kerutsareme kiekatari.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}