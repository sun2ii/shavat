{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"SNG","translationId":"hch_wb2","name":"Kwikari","commonName":"Kwikari","title":"Kwikari witsimɨ'ane","order":22,"numberOfChapters":8,"sha256":"bd2bf087210231d526f4b505f65ad8a4769404396ec758d73a68be43b369ff86","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/hch_wb2/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"¿Kekuta reuyunixɨ 'uki peminaki'erie,","poem":1},{"text":"'uka yemekɨ witsipemɨti'ɨimari?","poem":2},{"text":"¿Hakewa kuta petɨa?","poem":1},{"text":"'Ahamatɨa te'uhutɨ tepiwauyu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Uki neminaki'erie kaneyani yuharawerita,","poem":1},{"text":"waritsamu muye'etsietsie,","poem":2},{"text":"muwa mɨtiwaikakɨ,","poem":1},{"text":"tuturi 'atsutsena tipinike.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne 'uki neminaki'erie hetsiemieme nekanihɨkɨtɨni,","poem":1},{"text":"'uki neminaki'erie nehetsieta kanimiemetɨni,","poem":2},{"text":"Mɨkɨ yumuxatsima tuturi 'atsutsena tsata kaniwarutihɨweni.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"'Ekɨ 'uka nemɨmatsinaki'erie, witsipepɨti'ɨimari kiekari Tiritsa hepaɨ,","poem":1},{"text":"witsipe'anetɨ kiekari Kerutsareme hepaɨ,","poem":2},{"lineBreak":true},{"text":"pemɨmariwe xurawetsixi wahepaɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwi pepɨkanetsixeiyaniri,","poem":1},{"text":"nepeɨxɨyarie 'ahɨxite netsixeiyakaku.","poem":2},{"text":"'Akɨpate tsipuri xeitewayari wahepaɨ pɨtiyuxexeiya","poem":1},{"text":"memuyuhayatɨwe Karaha hɨriyaritsie.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Atamete tsipuri 'ukari tɨɨrixi wahepaɨ pɨ'anene","poem":1},{"text":"hekwamekɨ memuti'ɨwaxɨ.","poem":2},{"text":"Yuxexuitɨ mɨkɨ mepuyuhuhuta,","poem":1},{"text":"xewitɨ yuxaɨta pɨka'uyeika.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'A'aurite pemeuyukunama warita","poem":1},{"text":"manitsana hepaɨ pɨtiyuxexeiya.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tsepa haika tewiyari 'ukari te'aitamete wa'ɨitama memakɨne,","poem":1},{"text":"tsepa nauka tewiyari 'ukari memɨhɨkɨ ti'aitame hutarieka 'ɨitamama","poem":2},{"lineBreak":true},{"text":"tsepa mekate'inɨaritɨ 'ukari 'ɨimarixi,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"peru xewitɨ hɨkɨa xeikɨa kanihɨkutɨni nekukuru 'etsimupe witsimɨti'ɨimari,","poem":1},{"text":"'uka kwinie maamaya mɨtinaki'erie,","poem":2},{"lineBreak":true},{"text":"'aixɨa mɨtixeiya mitiniwexɨ.","poem":2},{"text":"Hipatɨ 'ukari kepauka memixeiya 'aixɨa mepɨtehehɨawe,","poem":1},{"text":"'ukari te'aitamete wa'ɨitama witsimemɨ'anene meta","poem":2},{"lineBreak":true},{"text":"hipatɨ 'ukarawetsixi ti'aitame hutarieka 'ɨitamama mekaninɨawani.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"¿Kemɨ'ane 'ikɨ pɨyɨane witsi'anetɨ tau 'ɨrɨya hepaɨ?","poem":1},{"text":"Witsikani'aneni metsa hepaɨ,","poem":2},{"lineBreak":true},{"text":"xawatɨtɨ tau hepaɨ,","poem":2},{"lineBreak":true},{"text":"mariwetɨ xurawetsixi muyuawitsie memeukatei wahepaɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nekaneyani kariu haraweriyari muyema","poem":1},{"text":"nemɨtixeiyakɨ hekwamekɨ mayeweritsie mɨtiyɨyɨra,","poem":2},{"text":"ne'ixeiyamɨtɨ kaxie mɨyɨyɨra,","poem":1},{"text":"meta manitsana kɨyeyariteyari muxutu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"'Atsinekareyutimaiwekaku, netemawierikakɨ kauka kaxetatsie nenekaya,","poem":1},{"text":"takiekaritsie ti'aitame kaxetayatsie.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Keneukunua, 'uka Tsurami kiekame keneukunua,","poem":1},{"text":"keneukunua tahamatɨa keneuyeikani,","poem":2},{"lineBreak":true},{"text":"tepɨmatsiheuxeiyaku.","poem":2},"'Uki mɨnaki'eriwa",{"text":"¿Titayarikuta 'uka Tsunami kiekame xeteheuxeiyaku,","poem":1},{"text":"neiya hutakɨa yu'utɨma mehewetɨkaikaku miemetsie hepaɨ?","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}