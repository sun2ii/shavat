{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"SNG","translationId":"hch_wb2","name":"Kwikari","commonName":"Kwikari","title":"Kwikari witsimɨ'ane","order":22,"numberOfChapters":8,"sha256":"bd2bf087210231d526f4b505f65ad8a4769404396ec758d73a68be43b369ff86","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/hch_wb2/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"'Uka ti'aitame pemunu'aya witsipemɨti'ɨimari,","poem":1},{"text":"witsipɨtiyuxexeiya 'a'ɨkate kakaitsie heutawetɨkaitɨ.","poem":2},{"text":"Witsipemanupe, nakɨtsa hepaɨ pɨ'ane","poem":1},{"text":"'aixɨa reutamaiwetɨ mitiwewiwa hepaɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Axɨtemutsi tekɨxi hepaɨ pɨ'ane","poem":1},{"text":"winu witsi'anetɨ mɨhɨne hepaɨ pɨ'ane.","poem":2},{"text":"'Ahuka tɨriku hɨriyari hepaɨ pɨ'ane","poem":1},{"text":"waritana tuturi 'atsutsena mahane.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Atsitsi maxatsi tɨɨrixi yuhutatɨ wahepaɨ mepɨteyuxexeiya,","poem":1},{"text":"maxa 'ɨimari yuhutame yuniwema muwarayexeiya hepaɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"'Akɨipi tuxiyu mutuxa mɨtse'i kanihɨkɨtɨni,","poem":1},{"lineBreak":true},{"text":"'Ahɨxite huta haixayari pɨhɨkɨ Hetsiwuni mieme,","poem":1},{"text":"Wati-Xawini kitenie 'aurie mɨtineniere.","poem":2},{"text":"'Atsuri Riwanu tuxiyuyari hepaɨ pɨ'ane,","poem":1},{"text":"Ramatsiku meutaniere.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Amu'u waɨkawa pahekɨa Kaximeru hɨriyari kɨtsie mieme hepaɨ.","poem":1},{"text":"Hiru mɨyɨtsikimawi hepaɨ pɨ'anene 'akɨpate,","poem":2},{"lineBreak":true},{"text":"'etsiwa tsiturawime pehewawɨtɨatɨ ti'aitame kwi pɨmatsixeiya 'aumɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yemekɨ kwinie pepɨti'ɨimari, 'uka nemɨmatsinaki'erie,","poem":1},{"text":"'ukaratsi witsipemɨtiuka'iyari pepɨhɨkɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kwinie peputewi takɨ 'amɨtɨtɨ hepaɨ,","poem":1},{"text":"meta 'atsitsi huta takariyarieya pɨhɨkɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne mɨpaɨ nepɨtiuyɨhɨawixɨ: «Nekananutimakimɨkɨ takɨ 'amutewitsie,","poem":1},{"text":"takariyari nepiini netinayeitɨamɨkɨ».","poem":2},{"text":"'Atsitsi kaxie takari hepaɨ ke'aneneni,","poem":1},{"text":"manitsana hepaɨ peke'ɨ'ɨaka,","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"winu witsima'ane hepaɨ keha'aneni 'ateni.","poem":2},"'Uka mɨnaki'eriwa",{"text":"Winu witsima'ane 'uki neminaki'erie hetsɨa keye'ani,","poem":1},{"text":"tenieyatsie ke'utayani meta tameteyatsie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ne 'uki neminaki'erie hetsiemieme nepɨhɨkɨ,","poem":1},{"text":"kanenikuwauneni waɨkawa netsihaunaki'erietɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Niwa kenaye'a, 'uki nemɨmatsinaki'erie,","poem":1},{"text":"yeuta tekaniyehuni,","poem":2},{"lineBreak":true},{"text":"muwa yɨwikɨta tepeka'iyunieni tuturite yeutamieme tsata.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ximeri paitɨ tepeuhu kaxie haraweriyari tsata,","poem":1},{"text":"tepeunieriyu kaxie kareyɨyɨrari,","poem":2},{"text":"Xɨkari tuturiyari hetixutuweni,","poem":1},{"text":"xɨka 'ikwaxi mayehatsiyatɨka hexutukari.","poem":2},{"lineBreak":true},{"text":"Mana nekameneyetuiriemɨkɨ nenaki'eriya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Manirakura witsimu'ɨa kanitawiwiwani,","poem":1},{"text":"meta naitɨ takitenie katinapika","poem":2},{"lineBreak":true},{"text":"'ikwaxi witsimɨ'anene hikɨketimieme","poem":2},{"text":"meta 'aikɨ paitɨ timieme,","poem":1},{"text":"nekametini'utsirieka 'ahetsietimieme 'uki nemɨmatsinaki'erie.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}