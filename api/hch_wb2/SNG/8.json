{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"SNG","translationId":"hch_wb2","name":"Kwikari","commonName":"Kwikari","title":"Kwikari witsimɨ'ane","order":22,"numberOfChapters":8,"sha256":"bd2bf087210231d526f4b505f65ad8a4769404396ec758d73a68be43b369ff86","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/hch_wb2/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"Xɨka ne'iwa pehɨkɨtɨnike,","poem":1},{"text":"nemaama tsitsieyatsie pemutawerixɨ.","poem":2},{"text":"Kepauka nemɨmatsi'anukunake kiekaritsie nepɨmatsiku'itsewenikeyu,","poem":1},{"text":"xewitɨ pɨkayɨwenikeyu kename 'axaneyɨane mɨnerahɨaweni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"'Amamatsie nekawietɨ,","poem":1},{"text":"nemaamakie nepɨmatsi'atɨanikeyu,","poem":2},{"lineBreak":true},{"text":"pemɨnetita'ɨkitɨanikɨ naki'eriya hepaɨtsita.","poem":2},{"text":"Winu nepɨmatsi'anu'itɨanikeyu naitɨ tinɨkame,","poem":1},{"text":"meta 'ikwaxi neharaweritamieme hayari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mɨtiniyɨweniketɨ nemu'u","poem":1},{"text":"'utatana nemɨniuka'uxipitɨani.","poem":2},{"lineBreak":true},{"text":"Mɨtiniyɨweniketɨ yutseriekɨ mɨneniuwiya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne nepɨxewawirie, 'ukarawetsixi Kerutsareme kiekatari,","poem":1},{"text":"xepɨka'ihɨtɨaka meta xepɨka'i'uximatɨaka 'uka neminaki'erie,","poem":2},{"lineBreak":true},{"text":"mɨkɨ yɨkɨmana kepaukake manutaniere.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"¿Kemɨ'ane pɨyɨane makumawetsie matimie","poem":1},{"text":"'uki minaki'erie hetsie rawiyatɨ?","poem":2},"'Uki mɨnaki'eriwa",{"text":"Xikɨti hetɨa nepɨmatsi'anutahɨtɨa,","poem":1},{"text":"mana 'amaamatsie pepɨkaya,","poem":2},{"lineBreak":true},{"text":"meta manatsiere pɨmatsi'utiniwexɨ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kenena'utɨaka 'a'iyaritsie tseyu hepaɨ,","poem":1},{"text":"tepɨa hepaɨ 'amamatsie kenena'utɨaka.","poem":2},{"text":"Waɨkawa pɨtɨrɨkaɨye naki'eriya, mɨki hepaɨ,","poem":1},{"text":"kaniyuritɨni naki'eriya, mɨki teukiya hepaɨ.","poem":2},{"text":"Naki'eriya taiyari","poem":1},{"text":"Kakaɨyari taiyaya hepaɨ kani'aneni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tsepa haa muwaɨkawa pɨkayɨwe mitɨnikɨ,","poem":1},{"text":"meta haa hatɨa mieme mikumaweriya tɨma pɨkayɨwe.","poem":2},{"text":"Xewitɨ xɨka tita naime mɨrexeiya","poem":1},{"text":"tipatamɨkɨni naki'eriyakɨ,","poem":2},{"lineBreak":true},{"text":"'axamɨtikɨhɨawarɨwanikɨ xeikɨa katinikaxeiyamɨkɨ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kwinimieme yemekɨ 'etsipuyumate tataru 'uka","poem":1},{"text":"'akuxi tsitsiteya pɨkahanexɨawawe.","poem":2},{"text":"¿Keteteyurieni xɨka ta'iwa","poem":1},{"text":"'uta'iwaurieni?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Xɨka kiekari kuraruyaritɨnike,","poem":1},{"text":"heimana tepetayatsakeyu pɨrata.","poem":2},{"text":"Xɨkata 'itupari hɨkɨtɨnike,","poem":1},{"text":"heimana tepikamanikeyu kariuxa mexayari.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne kiekari kuraruyari nekanihɨkɨtɨni,","poem":1},{"text":"meta netsitsite huta tuxiyuyari pɨhɨkɨ.","poem":2},{"text":"'Ayumieme kepauka 'uki neminaki'erie mɨnetsikuxexeiyatsie","poem":1},{"text":"kayuwatɨ nemukaxeiya hepaɨ nekatiniyumaika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Tsarumuni kaxie haraweriyari kanexeiyakaitɨni Wahari-Kamuni paitɨ,","poem":1},{"text":"hipame te'uximayatamete kaniwarehɨritɨani.","poem":2},{"text":"Mɨkɨ yuxexuitɨ mekaniyetuiriwakaitɨni 'ikwaxi mekaxuxuawerekai,","poem":1},{"text":"xeimiriyari pɨrata tuminiyari.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tsarumuni xeimiriyari tumini kena'ɨtɨ,","poem":1},{"text":"xemeta te'uximayatamete huta tsienituyari,","poem":2},{"lineBreak":true},{"text":"peru nekaxie haraweriyari nexeikɨa pɨtinepiini.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"'Ekɨ, tuturi muwa'etsietɨkatsie pemɨti'aita,","poem":1},{"text":"'aniuki xeikɨa mekanita'enieka tahamikuma,","poem":2},{"lineBreak":true},{"text":"kenetaniu kuta tepi'enieni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Xeiya keneumietɨ, 'uki nemɨmatsinaki'erie.","poem":1},{"text":"Keneunautsarɨmetɨ maxa hepaɨ, maxa 'etsimupe hepaɨ,","poem":2},{"lineBreak":true},{"text":"hɨritetsie waritsamukɨ muwiriyarietɨkatsie.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}