{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ZEC","translationId":"hch_wb2","name":"Tsakariyaxi","commonName":"Tsakariyaxi","title":"Tsakariyaxi","order":38,"numberOfChapters":14,"sha256":"b435feda26463775357e8f8f2cf72008734db95c45068fa8111fd23d6afb76e1","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/hch_wb2/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":10,"content":[{"type":"heading","content":["Yawé Kura pɨ'ɨwiyani"]},{"type":"verse","number":1,"content":[{"text":"Yawé xekeneutawawiri mɨkawiyekɨ witarita.","poem":1},{"text":"Mɨkɨ kanihɨkɨtɨni hai mɨyɨyɨwi mɨtiwewiwa","poem":2},{"lineBreak":true},{"text":"meta wiyeri meyenɨ'awa.","poem":2},{"text":"Mɨkɨ kanihɨkɨtɨni yunaime teɨteri wahetsiemieme","poem":1},{"text":"kwiepa tupiriyate mɨtiutinenetɨwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kakaɨyarixi memɨwewiyatɨka 'itarikakɨ mepɨtekuxata,","poem":1},{"text":"temaiwawemete 'itarika mepɨteheinɨtsa,","poem":2},{"text":"mepɨtekuxata 'itarikakɨ kememɨtenieritɨarie","poem":1},{"text":"meta kememɨteyɨnɨtɨwa pɨtiyakɨ.","poem":2},{"text":"'Ayumieme xeme xepeuyexɨrie","poem":1},{"text":"muxatsi memɨkatehekakutsiyari wahepaɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nepɨha'a tehɨwemete wahepaɨtsita,","poem":1},{"text":"nepɨwa'uximatɨani mɨkɨ memanuyetei.","poem":2},{"text":"Yurikɨ Yawé Naimekɨmɨtɨrɨkaɨye","poem":1},{"text":"Kura kwieyaritsie kiekatari kaniwa'ɨwiyani, mɨkɨ muxatsimama mekanihɨkɨtɨni,","poem":2},{"text":"'arike yukawayutsixima memɨtɨrɨkawi kaniwarayeitɨamɨkɨ","poem":1},{"text":"kepauka muyutamieni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kura hetsie mepɨyekɨne","poem":1},{"text":"tete 'itsikina mieme meta kɨye 'ixuriki kiyari mukuhanani,","poem":2},{"lineBreak":true},{"text":"tupi kuyaxa mieme meta yumɨiretɨ te'aitamete.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Meyuxewitɨ yunaitɨ memɨte'ayu'iwa mepɨhɨkɨtɨni","poem":1},{"text":"meyukwitɨwetɨ mepɨte'ayu'iwani kaye'utɨma muhaxuyatsie,","poem":2},{"text":"kawayutsixi wahetsie memutei mepɨwaranakaxɨrɨwani,","poem":1},{"text":"Yawé wahamatɨa muyeikanikɨ waparewietɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Ne Kura nuiwarimama tɨrɨkariya nepuwapitɨani","poem":1},{"text":"meta nepɨwatawikweitsitɨani Kutse nuiwarimama.","poem":2},{"text":"Nepɨwarutinenimayataxɨ","poem":1},{"text":"hikɨ 'ayumieme nepuwarakunuitɨani.","poem":2},{"text":"Wa'atɨtɨ hatsuaku nepɨkatiwaruku'eiri nepɨ'aneni,","poem":1},{"text":"Ne Yawé nemɨhɨkɨkɨ wakakaɨyari,","poem":2},{"lineBreak":true},{"text":"nepuwata'eiya.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Epɨrahini kiekatari kuyaxi memɨte'ayu'iwa wahepaɨ mepɨ'aneni,","poem":1},{"text":"wa'iyari puyutemamawieka","poem":2},{"lineBreak":true},{"text":"winu memanu'ieni hepaɨ.","poem":2},{"text":"Waniwema kepauka memɨwaxeiya mekaniyukatemamawikuni,","poem":1},{"text":"wa'iyari puyutemawieka Yawé hetsiemieme.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne nepuwatahɨawe hikɨ nepuwakuxeɨrieni.","poem":1},{"text":"Kepauka nemɨwatawikweitsitɨani netinetuame,","poem":2},{"lineBreak":true},{"text":"meyumɨiretɨ mepakɨne meripai hepaɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tsepa nemɨwareutaxɨriexɨa hipame teɨteri watsata,","poem":1},{"text":"'ateewa paitɨ me'u'uwatɨ mepɨnetsihaye'erieni.","poem":2},{"text":"Tsepa muwa meme'uwakai yuniwema yunaitɨ,","poem":1},{"text":"mekani'axɨakuni yukwietsie.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Ekipitutsie nepɨwarayewitɨni,","poem":1},{"text":"metatsiere 'Atsiriya kwieyaritsie,","poem":2},{"text":"Karaha kwieyaritsie nepɨwa'atɨani meta Riwanu hɨriyaritsie,","poem":1},{"text":"'akuxi hipatɨ hakewa memetiyaxe kwie hauyewetɨ kanayeimɨkɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Haramara kayuwatɨ mɨkatimatsie mepɨkɨne,","poem":1},{"text":"ne peru hamewari kayuwatɨ nepɨpitɨani,","poem":2},{"lineBreak":true},{"text":"meta Niru hatuxameyari 'amatiyewa pakawani.","poem":2},{"text":"'Atsiriya kemɨtiyuta'ɨre nepeitiparitɨani,","poem":1},{"text":"meta 'Ekipitu kemɨti'aita nepikumaweriya.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Netɨtɨ nepɨhɨkɨtɨni nemɨwatɨrɨkariyani,","poem":1},{"text":"hikɨ mɨkɨ mepuhuni nekɨmana»,","poem":2},"mɨpaɨ kanaineni Yawé."]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ZEC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ZEC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ZEC/9.json","previousChapterAudioLinks":{},"numberOfVerses":12}