{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ZEC","translationId":"hch_wb2","name":"Tsakariyaxi","commonName":"Tsakariyaxi","title":"Tsakariyaxi","order":38,"numberOfChapters":14,"sha256":"b435feda26463775357e8f8f2cf72008734db95c45068fa8111fd23d6afb76e1","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/hch_wb2/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":2,"content":[{"type":"heading","content":["Tewi ti'inɨnɨatame mahurie"]},{"type":"verse","number":1,"content":["Kepauka nemanukunierixɨta, xeimeta tewi nekaniuxeiya ti'inɨnɨatame 'ahuriekame."]},{"type":"verse","number":2,"content":["Ne nekanita'iwawiya: «¿Hakewa pepeutɨa?» Mɨkɨ mɨpaɨ kanetiniuta'eiya: «Kerutsareme nekaneu'inɨatamieni. Nepɨtimaimɨkɨ kehatayewa meta kehayetewi»."]},{"type":"verse","number":3,"content":["Niuki tuayame pɨyemieximekairi nehamatɨa mɨtikuxatakai, yapauka xewitɨta niuki tuayame punua hetsɨana."]},{"type":"verse","number":4,"content":["Mɨpaɨ katinitahɨawe: «Yapauka mɨkɨ temaikɨ 'ipaɨ ketineutaxatɨa:",{"text":"»“Kerutsareme kiekariyaritsie waɨkawa teɨteri mepuxuaweni,","poem":1},{"text":"meta tewaxi waɨkawa mepuxuaweni,","poem":2},{"text":"'ayumieme Kerutsareme","poem":1},{"text":"yukuraru kahexeiyatɨ payani.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hikɨ kiekari warita —Yawé mɨpaɨ paine—","poem":1},{"text":"tai kuraruyari nepɨhɨkɨtɨni,","poem":2},{"text":"meta kiekari taɨta","poem":1},{"text":"nepitahɨniya waɨkawa 'aixɨa mɨti'anekɨ”.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"»Xekenayekɨni, xekenayekɨni.","poem":1},{"text":"Xekeneuyuta'una mɨkɨ kiekari tayeta mukumatsie","poem":2},"—Yawé mɨpaɨ kanaineni—.",{"lineBreak":true},{"text":"»Ne nepɨtiuyuri nemɨxeheutaxɨriexɨa","poem":1},{"text":"nauka 'ekayarikɨ mɨyuawitsie miemekɨ","poem":2},"—mɨpaɨ kanaineni Yawé—."]},{"type":"verse","number":7,"content":["»Xeme Tsiyunitari, Wawiruniya xemu'uwa xekenayekɨni mana, xekeneyuta'una»."]},{"type":"verse","number":8,"content":["Karikɨ Yawé Naimekɨmɨtɨrɨkaɨye mɨpaɨ kanaineni, mɨnetsiheyenɨ'a 'iya nuiwarite naime memɨxete'unawairi wahetsɨa:",{"text":"«Kemɨ'ane teɨteri neteɨterima memɨwa'uximatɨa,","poem":1},{"text":"nehɨxita memeumemeni hepaɨ mekaniyɨaka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ne nepɨyeha'ani mɨkɨ teɨteri wahepaɨtsita,","poem":1},{"text":"hikɨ waɨriyarika tewa'uximayatsiriwametetɨtɨ mepɨtewanawatsirieni wapiinite.","poem":2},"»'Ana mɨpaɨ mekatenetimaikuni kename Yawé Naimekɨmɨtɨrɨkaɨye netsiheyenɨ'a."]},{"type":"verse","number":10,"content":[{"text":"»Xekeneutihiwani temawierikakɨ, Tsiyunitari.","poem":1},{"text":"Ne nekaninuamɨkɨ xehamatɨa ne'ukaitɨ nekanayeimɨkɨ","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"»Mɨkɨ tukaritsie,","poem":1},{"text":"yuwaɨkawatɨ nuiwarite Yawé mekanitinɨikuni.","poem":2},{"text":"Mɨkɨ neteɨterima mepakɨne,","poem":1},{"text":"neta watsata nepuyeikani.","poem":2},"»'Ana mɨpaɨ xekatenetimaikuni kename Yawé Naimekɨmɨtɨrɨkaɨye hɨkɨ mɨnetsiheyenɨ'a xehetsɨa."]},{"type":"verse","number":12,"content":["Tawarita Kura kwieyari Yawé yuhetsiemieme payeitɨani, kwieya mɨpatsie, meta tawarita Kerutsareme panayexeiya."]},{"type":"verse","number":13,"content":["Yunaitɨ kwiepa xemɨtama kayuwatɨ xekeneumaka Yawé hɨxie, 'ariri kanayeyani muyuawitsie yukii mupatsieta tahetsɨa nuanike»."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ZEC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ZEC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ZEC/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}