{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ZEC","translationId":"hch_wb2","name":"Tsakariyaxi","commonName":"Tsakariyaxi","title":"Tsakariyaxi","order":38,"numberOfChapters":14,"sha256":"b435feda26463775357e8f8f2cf72008734db95c45068fa8111fd23d6afb76e1","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/hch_wb2/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":3,"content":[{"type":"heading","content":["Mawari wewiwamete tiwa'aitɨwame 'ixurikiteya mɨ'e'ekwi"]},{"type":"verse","number":1,"content":["Hikɨ kaneniuxeiyatsitɨani Kutsuhexi, mawari wewiwamete tiwa'aitɨwame pɨhɨkɨtɨkai, Yawé niuki tuayameya hɨxie 'apuwekai, meta Kauyumarie nepuxei tserietana 'utiweme, 'ixanetamɨtɨ."]},{"type":"verse","number":2,"content":["Niuki tuayame Yawé hetsɨa mieme Kauyumarie mɨpaɨ katiniutahɨawe:",{"text":"«Yawé kemetsi'utatieni,","poem":1},{"text":"Kerutsareme manayexei.","poem":2},{"lineBreak":true},{"text":"Yawé kematsi'utatieni, Kauyumarie.","poem":2},{"text":"'Ikɨ tewi kɨye taxɨximetɨ","poem":1},{"text":"taipa manayehanie hepaɨ kaniuyɨni».","poem":2}]},{"type":"verse","number":3,"content":["Kutsuhexi yukemari tɨtɨnime 'anakatɨtɨ niuki tuayame hɨxie puwekai."]},{"type":"verse","number":4,"content":["Hikɨ mɨpaɨ niuki tuayame katiniwarutahɨawe mana memɨti'ukai, me'iparewikutɨ: «Xekenanutihɨniri kemariteya mɨtɨtɨni». Hikɨ Kutsuhexi mɨpaɨta katiniutahɨawe: «Mɨpaɨ ketinemaika, tita 'axapemɨtiuyuri 'ari nekamatinanuyeitɨirieni, 'ayumieme hikɨri 'ixurikite nekamenanakatɨtɨamɨkɨ witsimɨ'anene»."]},{"type":"verse","number":5,"content":["Hikɨ neta mɨpaɨ nekaniutayɨni: «Mukuretsi xekenanutiketsirita mɨ'itiya». Hikɨ mekanenutiketsirieni mukuretsi mɨ'itiya meta mekanitikemaritɨani, mexi niuki tuayame Yawé hetsɨa mieme mana 'uwekai."]},{"type":"verse","number":6,"content":["Hikɨ niuki tuayame Yawé hetsɨa mieme Kutsuhexi mɨpaɨ katinayehɨtɨani:"]},{"type":"verse","number":7,"content":["«Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye:",{"text":"»“Xɨka ne'aitsikatetsie yapetikamieni,","poem":1},{"text":"meta xɨka mawari wewiwame pehɨkɨtɨtɨ peraye'atɨani,","poem":2},{"text":"hikɨ 'ana netukita pepɨtita'aita","poem":1},{"text":"meta netakwa hepaɨtsita mieme pepɨti'ɨwiyani.","poem":2},{"text":"Ne 'ena tixaɨtɨ nepɨmatihɨritɨani","poem":1},{"text":"'ena memu'uwa 'ikɨ wahamatɨa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"»”Kutsuhexi, keneneu'eni, mawari wewiwamete tiwa'aitɨwame,","poem":1},{"text":"meta 'a'iwama meke'u'enanani,","poem":2},{"text":"'ahɨxie memayaxike,","poem":1},{"text":"xeme xekani'inɨaritɨni kemɨtiyɨni:","poem":2},{"text":"Neti'uximayatsiriwame nekani'atɨaximeni,","poem":1},{"text":"nekani'atɨaximeni Meukuyɨraxɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kutsuhexi, tete keneuxeiya","poem":1},{"text":"'ahɨxie nemitaye.","poem":2},{"text":"Mɨkɨ hetsie hɨxite 'atahutatɨ patei,","poem":1},{"text":"mɨkɨtsie nepɨreu'utɨani.","poem":2},{"text":"Xeitukaritsie kwiepa memɨtama","poem":1},{"text":"ke'axamemɨte'uyuri nepɨtiwaranuyeitɨirieni","poem":2},"—mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye—."]},{"type":"verse","number":10,"content":["»”Mɨkɨ tukaritsie, yuxexuitɨ xekaniwata'iniexɨakuni yu'iwama kaxie hetɨa xemɨtitenikɨ meta piní hetɨa, mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye”»."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ZEC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ZEC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ZEC/2.json","previousChapterAudioLinks":{},"numberOfVerses":10}