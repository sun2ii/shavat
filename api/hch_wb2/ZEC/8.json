{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ZEC","translationId":"hch_wb2","name":"Tsakariyaxi","commonName":"Tsakariyaxi","title":"Tsakariyaxi","order":38,"numberOfChapters":14,"sha256":"b435feda26463775357e8f8f2cf72008734db95c45068fa8111fd23d6afb76e1","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/hch_wb2/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":8,"content":[{"type":"heading","content":["Yawé kemutayɨ Kerutsareme kename 'aixɨa yurieni"]},{"type":"verse","number":1,"content":["Tawarita Yawé Naimekɨmɨtɨrɨkaɨye niukieya nehetsɨa kaninuani. Mɨpaɨ kanetiniutahekɨatɨani:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["«Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye:",{"text":"»“Ne waɨkawa nepɨ'ɨtetsa Tsiyuni hepaɨtsita.","poem":1},{"text":"Waɨkawa yemekɨ nepikwerie","poem":2},{"lineBreak":true},{"text":"hetsiena mieme nepuyeha'arɨwe”.","poem":2}]},{"type":"verse","number":3,"content":["»Mɨpaɨ kanaineni Yawé:",{"text":"»“Nepunuani tawarita Tsiyunitsie,","poem":1},{"text":"meta Kerutsareme ne'ukaitɨ nepayani.","poem":2},{"text":"Hikɨ Kerutsareme pɨmatiwani","poem":1},{"text":"tita Yuri Mɨraine Kiekariyari,","poem":2},{"text":"meta Yawé Naimekɨmɨtɨrɨkaɨye yemurieya","poem":1},{"text":"Yemuri Mɨpatsie pɨtitewaka”.","poem":2}]},{"type":"verse","number":4,"content":["»Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye:",{"text":"»“'Ukirawetsixi meta 'ukaraixi tawarita","poem":1},{"text":"Kerutsareme kayeyari'utɨa metiyaxiketɨ mepakɨne,","poem":2},{"text":"yuxexuitɨ yu'itsɨ me'u'ɨtɨ","poem":1},{"text":"waɨkawa wiyari memexeiyatɨkanikɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tɨɨri 'ukitsi meta 'ukari tawarita mekanitiwaikakuni","poem":1},{"text":"mɨkɨ kiekari kayeyaritetsie”.","poem":2}]},{"type":"verse","number":6,"content":["»Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye:",{"text":"»“Kemɨ'ane 'ana memuyuhayewatɨweni","poem":1},{"text":"'ana tukaritsie kayɨweme mepɨ'erieka mɨpaɨ mɨtiyɨni,","poem":2},{"text":"peru ne nehepaɨtsita pɨtiyɨwe,","poem":1},{"text":"mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye”.","poem":2}]},{"type":"verse","number":7,"content":["»Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye:",{"text":"»“Neteɨterima nepɨwatawikweitsitɨani,","poem":1},{"text":"tau manatineika hepatsie kiekatari wahetsɨa memu'uwa meta makayuyuipike hepatsie.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nepɨwarakunuitɨani","poem":1},{"text":"Kerutsareme pɨta memɨkutenikɨ,","poem":2},{"text":"mɨkɨ neteɨterima mepɨhɨkɨtɨni","poem":1},{"text":"neta wakakaɨyari nepɨhɨkɨtɨni,","poem":2},{"lineBreak":true},{"text":"yurikɨ nepɨtiyurieneni meta heitseriemekɨ”.","poem":2}]},{"type":"verse","number":9,"content":["»Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye:",{"text":"»“Xekeneyuwaɨriyani, xeme,","poem":1},{"text":"'ikɨ tukaritsie xemi'eni","poem":2},{"lineBreak":true},{"text":"Kakaɨyari niukametemama waniuki,","poem":2},{"text":"mexi tenari wewiyane","poem":1},{"text":"tuki hutarieka mieme manukuhanienikɨ","poem":2},{"lineBreak":true},{"text":"Yawé Naimekɨmɨtɨrɨkaɨye hetsiemieme.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Meripaitɨ mɨreukayunetsie","poem":1},{"text":"teɨteri mepɨkatepitɨariekai yu'uximayatsikakɨ","poem":2},{"lineBreak":true},{"text":"meta tewaxi yu'ikwai mepɨkakumikiwakai.","poem":2},{"text":"Hipatɨ memɨxe'aye'uniekaikɨ","poem":1},{"text":"kɨkamete 'aixɨa 'iyari mepɨkaku'uwakai,","poem":2},{"text":"netsɨ yanekatiniwarupitɨani yunaime teɨteri","poem":1},{"text":"yunaitɨ memayuye'uniekakɨ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hikɨri mɨpaɨ nepɨkatiwapitɨani memɨyuhayewaxɨ 'ikɨ teɨteri","poem":1},{"text":"meripaitɨ kenemɨtiwarupitɨa hepaɨ","poem":2},{"lineBreak":true},{"text":"—mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye—.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kayuwatɨ mepexeiyani kepauka mɨtika'etsitɨ,","poem":1},{"text":"meta kaxie yu'ikwaxi putixuaweriyani,","poem":2},{"text":"kwie pɨtiutixuaweriyani tita mɨtika'etsieni","poem":1},{"text":"meta muyuawi yuwiyeri panakanɨ'ani.","poem":2},{"text":"Mɨkɨ naime nepɨtiwapitɨani mɨtiwahetsiemiemetɨnikɨ","poem":1},{"text":"'ikɨ teɨteri memɨyuhayewatɨwe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kura kwieyaritsie kiekatari meta 'Ixaheritsie,","poem":1},{"text":"xepɨkaheumamaka, matsi xekeneyuwaɨririyani.","poem":2},{"text":"Xeme hipame nuiwarite watsata","poem":1},{"text":"'axaxemɨ'itɨarie xepɨhɨkɨtɨkai,","poem":2},{"text":"ne peru nepɨxetawikweitsitɨani,","poem":1},{"text":"hikɨ hipatɨta 'aixɨa mepɨ'itɨarieni xekɨmana”.","poem":2}]},{"type":"verse","number":14,"content":["»Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye:",{"text":"»“Kepauka xetutsima memɨnetsi'uyehaxɨatɨa,","poem":1},{"text":"ne yaneputayɨ nemɨwarakumaweriyakɨ nekawareunenimayatɨ","poem":2},{"lineBreak":true},{"text":"—mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye—.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Peru hikɨta nepɨnewaɨri","poem":1},{"text":"Kerutsareme 'aixɨa nemɨyurienikɨ meta Kura kwieyari.","poem":2},{"lineBreak":true},{"text":"'Ayumieme xepɨkaheumamaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"»”Peuyewetse xeme 'ipaɨ xemɨtekahuni,","poem":1},{"text":"yurikɨ xeketeneyukuxaxatɨwani,","poem":2},{"text":"xekeneyuxanetani 'itsɨkate wahetsɨa","poem":1},{"text":"yurikɨ meta kemɨtiheitserie.","poem":2},{"lineBreak":true},{"text":"Mɨpaɨ xɨka xeteyurieka kayuwatɨ kaniumakamɨkɨ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"'Axamɨti'ane xepɨkatewewieka yu'iwa hepaɨtsita,","poem":1},{"text":"'itarikakɨ xepɨkatekuxatani,","poem":2},{"text":"karikɨ ne mɨkɨ naime nekatini'uxiwe'erieka,","poem":1},{"text":"mɨpaɨ kanaineni Yawé”».","poem":2}]},{"type":"verse","number":18,"content":["Nehetsɨa kaninuani Yawé Naimekɨmɨtɨrɨkaɨye niukieya, mɨpaɨ kanetiniutahɨawe:"]},{"type":"line_break"},{"type":"verse","number":19,"content":["«Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye:",{"text":"»“Kura teɨteriyari wahetsiemieme, hakiya mematinenetɨwakai","poem":1},{"text":"naurieka metseritsie meta 'auxɨwirieka, 'atahutarieka meta tamamata metseriyaritsie,","poem":2},{"text":"hikɨri temawierika mepexeiyani,","poem":1},{"text":"'ixɨarari mepatinenetɨwani.","poem":2},{"lineBreak":true},{"text":"Kamɨtsɨ, xekenenaki'erieka tita yuri mɨraine meta tita kayuwatɨ mɨtiyupitɨwa”.","poem":2}]},{"type":"verse","number":20,"content":["»Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye:",{"text":"»“Mekani'axɨakuni teɨteri,","poem":1},{"text":"waɨkawa kiekari mukumanetsie kiekatari,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"hipame kiekaritsie mekanitikɨnikuni","poem":1},{"text":"mɨpaɨ metewakuxaxatɨwatɨ mana kiekatari:","poem":2},{"text":"Hikɨmɨ tepuhu Yawé hetsɨa tepiwawirieyu 'aixɨa mɨtatsiheyurienikɨ.","poem":1},{"text":"Tepiwauyu Yawé Naimekɨmɨtɨrɨkaɨye.","poem":2},{"lineBreak":true},{"text":"Netatsiere nekaneiwaumieni.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Meta yumɨiretɨ teɨteri metatsiere nuiwarite memɨtɨrɨkawi","poem":1},{"text":"Kerutsareme mekani'axɨakuni","poem":2},{"text":"me'ikuwautɨwetɨ Yawé Naimekɨmɨtɨrɨkaɨye","poem":1},{"text":"meta 'aixɨa mɨwayurienikɨ”.","poem":2}]},{"type":"verse","number":23,"content":["»Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye: “'Iya tukaritsie yuwaɨkawatɨ mepuxuaweni teɨteri, yɨkɨ memɨte'uniuka yunaitɨ, hipatɨ nuiwarite yunaitɨ, hikɨ xeime huriyu tewiyari kamixaya tetsimeyaritsie mekawɨreme mɨpaɨ mekatenitahɨawikuni: Neuxei tepɨmatsi'anuteɨta. Mɨpaɨ tepɨtehetima kename Kakaɨyari xehamatɨa 'uyeika”»."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ZEC/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ZEC/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ZEC/7.json","previousChapterAudioLinks":{},"numberOfVerses":23}