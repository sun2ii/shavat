{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ZEC","translationId":"hch_wb2","name":"Tsakariyaxi","commonName":"Tsakariyaxi","title":"Tsakariyaxi","order":38,"numberOfChapters":14,"sha256":"b435feda26463775357e8f8f2cf72008734db95c45068fa8111fd23d6afb76e1","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/hch_wb2/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":9,"content":[{"type":"heading","content":["Yawé niukieya 'Ixaheri memaye'unie wahepaɨtsita mieme"]},{"type":"verse","number":1,"content":["'Ikɨ, kemɨtiyɨni niukiyari kanihɨkɨtɨni Yawé kemutayɨ, Karɨraki kwieyari hetsiemieme kanihɨkɨtɨni meta Ramatsiku. Yurikɨ Yawé teɨteri kwi kaniwataxeiyani metatsiere yunaime 'Ixaheri nuiwarimama,"]},{"type":"verse","number":2,"content":["meta 'auriena mukuma Kamati kanitaxeiyani, metatsiere Tiru, Tsiruni mame, tsepa mɨkɨ kwinimieme memɨtemaiwawe."]},{"type":"verse","number":3,"content":[{"text":"Tiru kiekatari yukiekari kuraruyari 'e'atitewame meputawewi,","poem":1},{"text":"pɨrata mepukuxeɨri tumuanari mɨhɨkɨtɨni hepaɨ,","poem":2},{"lineBreak":true},{"text":"meta huru haxu kaye 'utɨa mieme mɨhɨkɨtɨni hepaɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Peru Ti'aitame pɨtiwanawairieni wapiinitɨarika,","poem":1},{"text":"haramaratsie kaneikaxɨrimɨkɨ tita mɨtiwaxikutɨriya,","poem":2},{"lineBreak":true},{"text":"meta tai kanitixɨtsitɨamɨkɨ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"'Atsikaruni kiekatari mepixeiya, hikɨ waɨkawa mepɨtimamani,","poem":1},{"text":"Kahatsa kiekatari waɨkawa mepɨteka'eniexɨani,","poem":2},{"text":"meta yaxeikɨa mepɨyɨni 'Ekuruni kiekatari","poem":1},{"text":"kepauka kememɨteta'ikwewakai yamɨkatiyɨni.","poem":2},{"text":"Kahatsa kiekatari ti'aitame mepɨnawaiyarieni,","poem":1},{"text":"meta 'Atsikaruni kiekatari mepakumawere.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Teɨteri memɨka'upapa 'Atsiruri kiekariyaritsie mepɨyutikiitɨani,","poem":1},{"text":"meta ne piritsiteutsixi kememɨteyuti'ɨre nepɨwanawairieni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wateta nepɨwanawairieni wai muxuxure,","poem":1},{"text":"meta 'ikwai mɨka'itiya.","poem":2},{"text":"Meta piritsiteutsixi yayupaɨmetɨ","poem":1},{"text":"mepɨyuhayewa takakaɨyari hetsiemieme,","poem":2},{"text":"Kura kwieyaritsie kuyaxi tewa'aitɨwamete mepakɨne,","poem":1},{"text":"meta 'Ekuruni kiekatari kewutseutsixi wahepaɨ me'anetɨ mepakɨne.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hikɨri ne netuki nepɨta'ɨwiya","poem":1},{"text":"xewitɨ mɨkaheutahakenikɨ meta xewitɨ mɨkahewayeyeikanikɨ.","poem":2},{"text":"Hatsuakuri xewitɨ mɨtatsi'aye'unie pɨkawaka'una neteɨterima,","poem":1},{"text":"karikɨ hikɨri ne nekatinita'ɨwiyani.","poem":2}]},{"type":"heading","content":["Ti'aitame kemɨtinuani Kerutsareme"]},{"type":"verse","number":9,"content":[{"text":"Waɨkawa keneyutemawieka, neniwe 'uka Tsiyuni.","poem":1},{"text":"Keneutahiwani temawierikakɨ, neniwe 'uka Kerutsareme.","poem":2},{"text":"Neuxei, mana pamie 'ahepa meti'aitɨwame,","poem":1},{"text":"heitserie yamɨtikamie, tiyuwikweitsitɨwame meta mariwetɨ mɨkahayuyeitɨwa.","poem":2},{"text":"'Akanamieni puxutsie 'anakaitɨ,","poem":1},{"text":"puxu temaikɨ hetsie, puxu 'ukaratsi nu'ayatsie.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"'Epɨrahini kaxetamama kuyaxa mieme pukumaweriya","poem":1},{"text":"meta kawayutsixi Kerutsareme miemete.","poem":2},{"text":"Tupite kuyaxa miemete pɨtimura,","poem":1},{"text":"hikɨ nuiwarite memɨyuxewinikɨ niukiyari pɨwataxatɨani.","poem":2},{"text":"Pɨtita'aita haramaratsie ka'atɨkaime meta tapa haramaratsie paitɨ ye'atɨkaime,","poem":1},{"text":"'Eupɨrate hatuxameyaritsie tsutɨme","poem":2},{"lineBreak":true},{"text":"'atsita kwie manu'axe paitɨ.","poem":2}]},{"type":"heading","content":["'Ixaheritsixi kememɨtehekwariyarieni"]},{"type":"verse","number":11,"content":[{"text":"'Ekɨta,","poem":1},{"text":"tɨratu nemuwewikɨ nexuriyakɨ 'ahamatɨa","poem":2},{"lineBreak":true},{"text":"nepɨwaxɨna putsu muyewakita memati'u 'ahetsɨa miemete memanutaxɨriya.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Xekenehu yukiekari 'aixɨa mɨrekukurarutuiyarietsie,","poem":1},{"text":"xe'anutaxɨriyatɨ xemɨta'ikwewakai,","poem":2},{"text":"karikɨ hikɨ mɨpaɨ nekanaineni mɨpaɨ xemɨtemaikakɨ","poem":1},{"text":"nekatinixepitɨamɨkɨ hutakɨa tita xemɨteheuyehɨa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kura netupi hepaɨ nekanikuha'aritɨamɨkɨ,","poem":1},{"text":"meta 'Epɨrahini ne'ɨrɨ nekanayeitɨamɨkɨ.","poem":2},{"text":"Tsiyuni, 'aniwema nepɨwayuitɨani,","poem":1},{"text":"Kɨretsiya kiekatari waniwema memɨwatakwinikɨ,","poem":2},{"lineBreak":true},{"text":"yumemiwame 'ixiparaya nepɨmatsihayeitɨani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Yawé matsiɨkɨtɨ payuyeitɨani wahetsie,","poem":1},{"text":"meta 'ɨrɨteya mimierɨkari hepaɨ 'anenetɨ payekɨne.","poem":2},{"text":"Yawé naimekɨmɨyɨwe pitahɨtsieni 'awa,","poem":1},{"text":"hikɨ kanayeyeimɨkɨ 'eka mɨtɨrɨkaɨye tatsutɨa miemetsie yewetɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yawé Naimekɨmɨtɨrɨkaɨye pɨwa'ɨwiyani yuteɨterima,","poem":1},{"text":"mɨkɨ naime mekanititarakuni","poem":2},{"lineBreak":true},{"text":"tetexi kɨmana memɨtituaxienikekai.","poem":2},{"text":"Kwinie mepɨte'uhiwani winukɨ memɨtarɨweka hepaɨ,","poem":1},{"text":"xuriyakɨ mepeu'ɨwatɨkani tekɨxi tukita mieme hepaɨ,","poem":2},{"lineBreak":true},{"text":"meta mawari taiyame 'awateya hepaɨ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"'Iya tukaritsie Yawé Kakaɨyari","poem":1},{"text":"yuteɨterima puwatawikweitsitɨani muxatsi wahepaɨ,","poem":2},{"text":"hikɨ Yawé kwieyatsie","poem":1},{"text":"meputixawatɨreni tetexi witsimɨ'anene kuruna hetsie matei hepaɨ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"'Aixɨa pɨti'aneni meta witsipɨti'aneni naitɨ.","poem":1},{"text":"Tɨriku temari metɨrɨkawime puwarayeitɨani,","poem":2},{"lineBreak":true},{"text":"meta kaxie winuyari mɨhekwa 'ukari 'ɨimarixi puwatemawieritɨani.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ZEC/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ZEC/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ZEC/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}