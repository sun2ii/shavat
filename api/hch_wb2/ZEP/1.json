{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ZEP","translationId":"hch_wb2","name":"Tsupuniyaxi","commonName":"Tsupuniyaxi","title":"Tsupuniyaxi","order":36,"numberOfChapters":3,"sha256":"2b0619702e19249dc3970a1aede0543e85df1614b8a31098e43f574848616ac7","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/hch_wb2/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["'Ikɨ Yawé niukieya kanihɨkɨtɨni, Tsupuniyaxi kemɨtiutahɨawarie Kutsi nu'aya, mɨkɨta Kerariyaxi nu'aya, mɨkɨta 'Amariyaxi nu'aya, mɨkɨta 'Etsekiyaxi nu'aya, kepauka mɨti'aitakai Kutsiyaxi 'Amuni nu'aya, Kura kwieyaritsie:"]},{"type":"heading","content":["Kememɨte'utaxatɨarie kememɨteka'unarieni 'arike"]},{"type":"verse","number":2,"content":[{"text":"«Meteyunaime nepɨtiwareuyehɨani","poem":1},{"text":"kemeteyupaɨmetɨ kwiepa memɨtexuawe","poem":2},"—Yawé mɨpaɨ kanaineni—."]},{"type":"verse","number":3,"content":[{"text":"Teɨteri meta tewaxi nekaniwareuyehɨamɨkɨ,","poem":1},{"text":"meta memɨte'awɨwawe","poem":2},{"lineBreak":true},{"text":"meta haramaratsie memɨteye'uwa,","poem":2},{"lineBreak":true},{"text":"metatsiere kakaɨyarixi memɨwewiyatɨka metatsiere teɨteri 'axamemɨte'u'iyari yaxeikɨa.","poem":2},{"lineBreak":true},{"text":"»Teɨteri nekaniwarakumaweriyamɨkɨ","poem":1},{"text":"'ena kwiepa naitsarie","poem":2},"—mɨpaɨ kanaineni Yawé—."]},{"type":"heading","content":["Kura kemɨtika'unarieni"]},{"type":"verse","number":4,"content":[{"text":"»Kura kwieyaritsie kiekatari nepɨtiwakwinitɨani,","poem":1},{"text":"meta yunaime Kerutsareme kiekatari.","poem":2},{"text":"Wahari huyerieya 'ɨarime naime nepakuyeitɨani,","poem":1},{"text":"meta mawari wewiwamete hetsɨana miemete kememɨtetetewa naime,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"meta kemɨ'ane yukii heima memukatunuma'uwe,","poem":1},{"text":"muyuawitsie miemete xurawetsixi mewarayexeiyatɨ,","poem":2},{"text":"meta kemɨ'ane metitunuma'utɨ,","poem":1},{"text":"kename Yawé me'ayexeiya memutiyuane,","poem":2},{"lineBreak":true},{"text":"kwitɨwata kakaɨyari Muruki yaxeikɨa memɨtehahɨawe,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"meta kemɨ'ane Yawé memuku'e'eiriwa,","poem":1},{"text":"meta memɨka'ikuwautɨwe meta memɨkahe'iwawiya.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kayuwatɨ xekeneumaka Yawé Naimekɨmɨyɨwe hɨxie,","poem":1},{"text":"Yawé mɨtixekwinitɨanitsie pehurari,","poem":2},{"text":"Yawé mawari kaniukuha'aritɨani","poem":1},{"text":"meta yu'inierima kaniwaru'itieniri.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"'Iya tukaritsie Yawé yumɨireme muwakwinitsie","poem":1},{"text":"nepɨtiwakwinitɨani ti'aitame parewiwametemama meta niwemama,","poem":2},{"lineBreak":true},{"text":"meta kemɨ'ane kamixate hipame kwieyaritsie miemete memanakatɨtɨka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Iya tukaritsie nekatiniwakwinitɨamɨkɨ","poem":1},{"text":"kemɨ'ane hipame kakaɨyarixi memɨwarayexeiya,","poem":2},{"text":"meta memɨtehɨniya yukakaɨyarixi watukita piinite,","poem":1},{"text":"'itarikakɨ memɨte'a'iwaxɨ meta hipame mewananaimatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"»Yawé mɨpaɨ kanaineni: 'Iya tukaritsie parewiya hiwariyari pɨ'enierieni,","poem":1},{"text":"kitenie Tsapa mɨtitewatsie paitɨ,","poem":2},{"lineBreak":true},{"text":"'aiwari pɨ'enierieni Kiekari Hutarieka Mieme makumatsie,","poem":2},{"lineBreak":true},{"text":"meta waɨkawa hiwari pa'eniɨriɨkɨni yemuritetsie paitɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"»Xemeta xekeneutitsuanani, tetuayamete memakutei xemɨtama.","poem":1},{"text":"Naitɨ tita xemɨtetua katineuyehɨiyamɨkɨ,","poem":2},{"lineBreak":true},{"text":"xepeuyehɨiyani yunaitɨ kemɨ'ane pɨrata xemexeiyanikɨ xemɨyɨa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"'Iya tukaritsie Kerutsareme nepayekexiya kɨxeme ne'akwetɨ,","poem":1},{"text":"nemɨtiwakwinitɨanikɨ kemɨ'ane yu'iyarikɨ memɨ'uxipie,","poem":2},{"lineBreak":true},{"text":"kaxie winuyari mɨkakuyuitɨariwa meuyewexime hepaɨ memɨ'ane,","poem":2},{"text":"kemɨ'ane mɨpaɨ memutiyuane: “Yawé 'atsipɨkatiyurieni,","poem":1},{"text":"ni'aixɨa pɨkatatsiyurieni ni'axa pɨkatatsiyurieni”.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Xepiinitɨarika memɨxeka'una wa'iwarika pɨrayani,","poem":1},{"text":"xekii yuxaɨta puyuhayewaxɨani:","poem":2},{"text":"“Yukii xepɨtiwewieni,","poem":1},{"text":"peru muwa xepɨka'ayeyaxe,","poem":2},{"text":"kaxie xepɨka'iteɨta,","poem":1},{"text":"peru winuyari xepɨkaha'inɨata”.","poem":2}]},{"type":"heading","content":["Yawé haxɨaya tukariyari"]},{"type":"verse","number":14,"content":[{"text":"»Yawé haxɨaya tukariyari paye'axime,","poem":1},{"text":"kanaye'aximeni yapauka.","poem":2},{"text":"Yawé tukarieyatsie pɨ'enierieni kwinimieme memɨte'uka'eniwa hiwariyari,","poem":1},{"text":"meta kemɨ'ane mɨkama 'ana kanitatsuamɨkɨ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Iya tukaritsie haxɨa tukariyari kanayeimɨkɨ,","poem":1},{"text":"meta 'uximatɨarika meta hiwerika tukariyari,","poem":2},{"text":"xemɨka'unarieni meta xemakumaweriyarieni tukariyari,","poem":1},{"text":"yɨriya tukariyari,","poem":2},{"text":"meta haiwitɨri mɨyɨyɨxawi tukariyari,","poem":1}]},{"type":"verse","number":16,"content":[{"text":"kuxineta meta kuyaxa hiwariyari tukariyari","poem":2},{"text":"kiekarite kuraruyari 'amatitɨtɨ hepaɨtsita mieme,","poem":1},{"text":"meta tuxiyu 'amutɨtɨ hepaɨtsita mieme.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ne nepɨwaranukuweiya teɨteri nekawa'uxipitɨatɨ,","poem":1},{"text":"memɨkaheuneniereni hepaɨ me'anenetɨ mepu'uwani,","poem":2},{"lineBreak":true},{"text":"Yawé hepaɨtsita 'axamemɨte'uyurikɨ.","poem":2},{"text":"Waxuriya nitayeuriyamɨkɨ tumuanari hepaɨ,","poem":1},{"text":"meta wakwinurite kwitarai hepaɨ pɨtiyuxexeiyani.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wahuru meta wapɨrata","poem":1},{"text":"pɨkawatawikweitsitɨani,","poem":2},{"lineBreak":true},{"text":"Yawé haxɨaya tukariyaritsie.","poem":2},{"text":"'Ɨtetsarikaya taiyari","poem":1},{"text":"naime kwie pakuxɨtsitɨani,","poem":2},{"text":"yapauka kaniwarakumaweriyamɨkɨ","poem":1},{"text":"yunaime teɨteri kwiepa memɨtama».","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ZEP/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ZEP/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/HAB/3.json","previousChapterAudioLinks":{},"numberOfVerses":18}