{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ZEP","translationId":"hch_wb2","name":"Tsupuniyaxi","commonName":"Tsupuniyaxi","title":"Tsupuniyaxi","order":36,"numberOfChapters":3,"sha256":"2b0619702e19249dc3970a1aede0543e85df1614b8a31098e43f574848616ac7","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/hch_wb2/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Xekeneyuyetua, tixaɨtɨ xekatehɨmetɨtɨ xekenayuyeitɨa,","poem":1},{"text":"teɨteri xemɨkayukatetewiya,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"yaxeketenekakɨni mexi kahaye'awe kenemutayɨ,","poem":1},{"text":"mexi tukari xemɨkwewiyatsie xemɨtehayewakɨ xatsi yapauka kemɨre'enitsitɨariwa hepaɨ kayɨwe,","poem":2},{"text":"mexi xehetsie kakawewe Yawé haxɨaya mɨta'a,","poem":1},{"text":"mexi xehetsie ka'aye'awe Yawé haxɨaya tukariyari.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yawé xekeneutiwawa, yunaitɨ xeme tixaɨtɨ xemɨkatehayuyeitɨa 'ena kwiepa,","poem":1},{"text":"yaxemɨteyurie 'aitsikateya kemaine.","poem":2},{"text":"Xekeneutiwawa tita mɨtiheitserie meta 'axekeneu'uwani tixaɨtɨ xekatehayuyeitɨatɨ,","poem":1},{"text":"heiwatɨ 'ana xe'uti'awieta,","poem":2},{"lineBreak":true},{"text":"kepauka Yawé haxɨaya tukarieya maye'anitsie.","poem":2}]},{"type":"heading","content":["Piritsiteutsixi kememɨte'utahɨawarie"]},{"type":"verse","number":4,"content":[{"text":"Kahatsa kiekariyari yuxaɨtame kaniyuhayewamɨkɨ,","poem":1},{"text":"meta yaxeikɨa 'Atsikaruni kiekariyari 'unitɨ kaniyuhayewamɨkɨ.","poem":2},{"text":"'Atsiruri kiekatari mekanayeweiyariekuni hekɨta,","poem":1},{"text":"yaxeikɨata 'Ekuruni kiekatari mekanitaweiyariekuni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Xɨa'ui kereteutsixi teɨteriyari","poem":1},{"text":"haramara tetsita memɨtama.","poem":2},{"text":"Yawé niukieya xehepaɨtsita yakanaineni kemɨtixekwinitɨani,","poem":1},{"text":"piritsiteutsixi Kanani kwieyaritsie xemɨtama:","poem":2},{"lineBreak":true},{"text":"«Ne nekanixekwimɨkɨ","poem":1},{"text":"nixeimetɨma mana nepɨkahayewa».","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Haramara tetsita 'uweritɨ 'utsiɨraɨyetɨ kanayeimɨkɨ,","poem":1},{"text":"mɨratihɨriwa meta muxatsi wakuraru makumane.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mana muxatsi mekatenitikwaikuni","poem":1},{"text":"Kura nuiwarimama memɨyuhayewa watewama.","poem":2},{"text":"Taikai meputi'uxipiweni","poem":1},{"text":"'Atsikaruni kiekariyari muku'eiriwaxɨtsie,","poem":2},{"text":"Yawé wakakaɨyari waparewienike mana kaninuamɨkɨ","poem":1},{"text":"'aixɨa wayurienike.","poem":2}]},{"type":"heading","content":["Muhawi meta 'amunitsixi kememɨte'utahɨawarie"]},{"type":"verse","number":8,"content":[{"text":"«Ke'axamemutiyuane muhawitsixi nekaniwa'enieka,","poem":1},{"text":"meta 'amunitsixi wayuriyarika,","poem":2},{"text":"neteɨterima wahepaɨtsita kememɨteheuniuka","poem":1},{"text":"meta wakwie mewanawairietɨwetɨ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yurikɨ mɨpaɨ nekanaineni,","poem":1},{"text":"—Mɨpaɨ kanaineni Yawé Naimekɨmɨtɨrɨkaɨye, 'Ixaheri Kakaɨyarieya—,","poem":2},{"text":"Muhawi Tsuruma kwieyari hepaɨ 'anetɨ kanayeimɨkɨ,","poem":1},{"text":"meta 'amunitsixi Kumuxa kiekariyari hepaɨ mepɨ'itɨarieni:","poem":2},{"text":"witsaxa 'ɨtsiyari xeikɨa payani meta 'una maxuawe,","poem":1},{"text":"yuheyemekɨ 'akumawetɨ payani.","poem":2},{"text":"Neteɨterima memɨyuhayewa wapiini mepɨtewanawairieni,","poem":1},{"text":"meta neteɨterima 'akuxi memu'uwani wakwie yupiini mepayeitɨani».","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"'Ikɨkɨ mekatenakapitɨariekuni memuyuta'ɨrixɨkɨ,","poem":1},{"text":"memɨwarutaniukimakɨ meta memɨwaxani'eriekaikɨ Yawé Naimekɨmɨtɨrɨkaɨye teɨterimama.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mepɨtimamani kepauka Yawé","poem":1},{"text":"yunaime kakaɨyarixi kwiepa memɨtama muwaka'una,","poem":2},{"text":"'ana nuiwarite teewanarixitɨtɨ,","poem":1},{"text":"mekanikatunuma'uikuni nenewieri me'ipitɨanike,","poem":2},{"lineBreak":true},{"text":"yuxexuitɨ yukwieyaritsie paitɨ.","poem":2}]},{"type":"heading","content":["'Etiupetsixi kememɨte'utahɨawarie"]},{"type":"verse","number":12,"content":[{"text":"«Yaxeikɨata xeme, 'etiupetsixi,","poem":1},{"text":"ne'ixiparakɨ xekanikwi'iwakuni».","poem":2}]},{"type":"heading","content":["'Atsiriyutsixi kememɨte'utahɨawarie"]},{"type":"verse","number":13,"content":[{"text":"Yawé yutɨrɨkariya kanitanɨ'amɨkɨ tayeta memukuma wahepa.","poem":1},{"text":"'Atsiriya kiekatari yunaime kaniwarakukwimɨkɨ,","poem":2},{"text":"meta Niniwe 'akumaweme kanayeitɨamɨkɨ,","poem":1},{"text":"xiekaripa makuwaki hepaɨ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kiekari muyuta'ɨre maku'ɨxaya payani muxatsi memɨte'atikwa'ani","poem":1},{"text":"meta hipatɨ tewaxi.","poem":2},{"text":"Mana yukie mepayeitɨani meteyunaitɨ yeutari.","poem":1},{"text":"Nɨpe hamatɨa mikɨri tuxiyu mu'u'uni hetsie mepakayaxikeni.","poem":2},{"text":"Watsuari kii hixɨapa nenieremetsie mepayetsuatɨkani,","poem":1},{"text":"kitenie mɨranutahakitɨretsie pɨranu'u'unini,","poem":2},{"lineBreak":true},{"text":"kariuxa kɨyeyari kii hetsie manuyehe hayekɨa puyehini.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"'Ikɨ kiekari muyutemawiekai kanihɨkɨtɨni,","poem":1},{"text":"yu'iyarikɨ 'aixɨa 'iyari 'amukumakai,","poem":2},{"text":"yukɨmana mɨpaɨ mutainekai:","poem":1},{"text":"«Ne xeikɨa nepɨhɨkɨ, xewitɨ tawari pumawe».","poem":2},{"text":"Matsi neuxei puka'unarie meta","poem":1},{"text":"yeutari wakie patɨa.","poem":2},{"text":"Kehate mana memuyekɨne me'ixeiyame","poem":1},{"text":"mepuyukatemamawieni me'inanaimatɨ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ZEP/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/ZEP/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ZEP/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}