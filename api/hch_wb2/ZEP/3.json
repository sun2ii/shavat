{"translation":{"id":"hch_wb2","name":"KAKAƗYARI NIUKIEYA XAPAYARI WIXARIKAKƗ","website":"https://ebible.org/Scriptures/details.php?id=hch","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hch","licenseNotes":null,"shortName":"WB2","englishName":"Huichol Bible 2020","language":"hch","textDirection":"ltr","sha256":"6467ee06ac817ab1aadcf467efb8a8557ea12011829040111ab4c9e50c6c3fbd","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wb2/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31072,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"ZEP","translationId":"hch_wb2","name":"Tsupuniyaxi","commonName":"Tsupuniyaxi","title":"Tsupuniyaxi","order":36,"numberOfChapters":3,"sha256":"2b0619702e19249dc3970a1aede0543e85df1614b8a31098e43f574848616ac7","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wb2/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/hch_wb2/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"heading","content":["Kerutsareme manutimietsie kemɨtiyɨni"]},{"type":"verse","number":1,"content":[{"text":"Xɨa'ui kiekari hipame pemɨwananaima,","poem":1},{"text":"pemɨkaheu'ena meta tita 'axamɨti'ane pemɨrexeiya.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mɨkayu'ɨxatsitɨarinɨa,","poem":1},{"text":"meta mɨkatiyuxatɨarinɨa.","poem":2},{"text":"Yawé hetsie yuri mɨkati'erie,","poem":1},{"text":"meta yukakaɨyari hetsɨa 'ahurawa mɨka'uyeika.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"'Itsɨkate mana memanuka'u","poem":1},{"text":"mayetsi memɨtehaketɨkɨka wahepaɨ mepɨ'anene,","poem":2},{"text":"wakuwexinaruritsixi 'ɨrawetsixi yɨwikɨta memuku'uwa mekanihɨkɨtɨni","poem":1},{"text":"tita memɨtetakwani tixaɨtɨ mepɨkatekuhayeikawa memɨkakayeikienikɨ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kakaɨyari niukametemama mana kiekatari mepɨte'itawa,","poem":1},{"text":"Kakaɨyari mepuku'eiri.","poem":2},{"text":"Mawari wewiwamete piinite netukita timieme katipatsiekame mepɨte'ayeitɨa,","poem":1},{"text":"meta 'aitsika kemaine yamepɨkatekahu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Matsi Yawé mana muka kemɨtiheitserie yapɨtiyuriene,","poem":1},{"text":"kemɨkatiheitserie pɨkatiyuriene.","poem":2},{"text":"Xexuime tukari mukatataretsie kemɨtiheitserie yapɨtiyuriene,","poem":1},{"text":"meta pɨkatihayewa tukari mɨyehane mukatataretsie,","poem":2},{"lineBreak":true},{"text":"peru 'axatiyuruwame tewiyarika pɨkamate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Nekaniwaruka'una nuiwarite,","poem":1},{"text":"kanakumawere wakuraru meta watuxiyu.","poem":2},{"text":"Nekanihayewa kaye 'utɨa teɨteri 'umaweme,","poem":1},{"text":"nixewitɨ tɨma mɨkɨ 'utɨa pɨka'uyeika.","poem":2},{"text":"Kaniuyuhayewa wakiekarite 'u'unitɨ,","poem":1},{"text":"nixewitɨ pɨkayuhayewaxɨ mana mukanikɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kiekari mɨpaɨ nepɨtiutahɨawixɨ:","poem":1},{"text":"“Yurikɨ pepɨnetsi'ayemakaxeni,","poem":2},{"lineBreak":true},{"text":"kenemɨmetita'ɨxatsitɨani pepeu'enani”.","poem":2},{"text":"Hikɨ 'ayumieme wakiekari pɨkaka'unarienikekai,","poem":1},{"text":"naimekɨ nemɨtita'aitɨakaikɨ.","poem":2},{"text":"Peru mɨyatɨtɨ, meyumexɨitɨatɨ mekanakɨne pɨta","poem":1},{"text":"'axamemɨteyurienikɨ naime hepaɨtsita.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"'Ayumieme xekenenetakwewieka,","poem":1},{"text":"yapauka nepɨrayu'iwa","poem":2},"—Yawé mɨpaɨ kanaineni—,",{"text":"'ari nuiwarite neniwakuxeɨrimɨkɨ,","poem":1},{"text":"meta te'aitamete","poem":2},{"text":"nemɨtiwakwinitɨanikɨ nehaxɨakɨ,","poem":1},{"text":"meta naimekɨ kenemɨreuha'a.","poem":2},{"text":"Ne'ɨtetsarika taiyariyarikɨ,","poem":1},{"text":"naitɨ kwie kanakuxɨtsitɨariemɨkɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"»Teɨteri 'aixɨa me'utiyuaneme nekaniwarayeitɨamɨkɨ,","poem":1},{"text":"para yunaitɨ memɨnetsihahɨawenikɨ Yawé kenemɨtitewa","poem":2},{"lineBreak":true},{"text":"meta memɨnetsi'ayexeiyanikɨ yaxeikɨa meteyukɨhɨawetɨ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kutsi hatɨayari manuyehapane 'anutaɨye me'anexɨame,","poem":1},{"text":"'imikieri mekaneni'atɨiriekuni","poem":2},{"lineBreak":true},{"text":"memɨnetsi'ayexeiya, neteɨterima memeutaxɨriexɨa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mɨkɨ tukaritsie tewiyarika xepɨkapitɨarieniri,","poem":1},{"text":"'ari 'axaxeteyurietɨ nehepaɨtsita xepɨtehayewa.","poem":2},{"text":"Nekaniwarayeweiyamɨkɨ xetsata","poem":1},{"text":"mɨkɨ teɨteri mamariwemete memayuyeitɨwa,","poem":2},{"text":"hikɨ 'ana mepukumawere memɨyuti'ɨre","poem":1},{"text":"nehɨri makupatsietsie.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mekaniyuhayewakuni xeikɨa,","poem":1},{"text":"tixaɨtɨ memɨkatehɨkɨ.","poem":2},{"text":"Mɨkɨ Yawé hetsie memɨtewiya memɨhɨkɨkɨ,","poem":1}]},{"type":"verse","number":13,"content":[{"text":"'etsimeyupaɨmetɨ memɨyuhayewaxɨ 'ixaheritsixi,","poem":2},{"text":"tita 'axamɨti'ane mepɨkateyuriekari,","poem":1},{"text":"'itarikakɨ mepɨkatekuxatani,","poem":2},{"lineBreak":true},{"text":"kwamanarikakɨ mepɨkatekuxatani.","poem":2},{"text":"Mekateniutikwa'akuni meta mekaniuka'uxipiwekuni","poem":1},{"text":"nixewitɨ kawamariutakaku».","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Keneutahiwani, neniwe 'uka Tsiyuni, temawierikakɨ,","poem":1},{"text":"memɨtehayu'iwa wahepaɨ xeketeneuhiwani, 'ixaheritsixi.","poem":2},{"text":"Xekeneutikwikani meta xekeneyutemamawieka yu'iyarikɨ,","poem":1},{"text":"neniwe 'uka Kerutsareme.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yawé pɨkatixekwinitɨaniri,","poem":1},{"text":"kaniwarutaweiya memɨmetsi'aye'unie.","poem":2},{"text":"Yawé, 'Ixaheritsie ti'aitame, xetsata kaniukani:","poem":1},{"text":"hatsuakuri pepɨkaheumaka.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mɨkɨ tukaritsie Kerutsareme mɨpaɨ pɨtitahɨawarieni:","poem":1},{"text":"«Tsiyuni, pepɨkamaka meta pepɨka'utaweranareni,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yawé 'akakaɨyari 'ahamatɨa kaniukani","poem":1},{"text":"mɨkɨ kuya mɨrayu'iwa pɨhɨkɨ.","poem":2},{"text":"Pɨyutemawieka 'ahetsiemieme,","poem":1},{"text":"pɨmetsihekwariyani yunaki'eriyakɨ,","poem":2},{"text":"kaniutakwikamɨkɨ yutemawietɨ 'ahetsiemieme","poem":1}]},{"type":"verse","number":18,"content":[{"text":"'ixɨarari mɨhɨkɨtɨni hepaɨ».","poem":2},{"lineBreak":true},{"text":"«Ne xehetsie nepɨtanuani xemɨkahiweritɨarienikɨri,","poem":1},{"text":"mɨixari kexemɨte'anuyehu xetewiyatsitɨarietɨ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mɨkɨ tukaritsie ne nekaniwaranukuweiyamɨkɨ","poem":1},{"text":"kemɨ'ane waɨriyarika memɨtexe'aitɨa,","poem":2},{"text":"nepɨwatawikweitsitɨani muxatsi memɨ'ɨkamɨmɨri,","poem":1},{"text":"meta nekaniwaranukuwaumɨkɨ memeuyexɨri.","poem":2},{"text":"Xeme xemariwame waɨkawa nepɨxe'ayeitɨani","poem":1},{"text":"'iya nuiwarite watsata hakewa xemetewinɨarie.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mɨkɨ tukaritsie ne nekanixe'atɨamɨkɨ,","poem":1},{"text":"mɨkɨ tukaritsie nepɨxekuxeɨrieni.","poem":2},{"text":"Xeme xemariwame waɨkawa nepɨxe'ayeitɨani","poem":1},{"text":"yunaime teɨteri kwiepa memɨtama watsata","poem":2},{"text":"kepauka nemɨxehakunuitɨani mɨkɨ wahɨxie","poem":1},{"lineBreak":true},{"text":"'ateewa xehehapanieku».","poem":1},"Mɨpaɨ kaniutayɨni Yawé."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wb2/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wb2/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wb2/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}