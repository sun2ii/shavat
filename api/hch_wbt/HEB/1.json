{"translation":{"id":"hch_wbt","name":"Cacaüyari niuquieya xapayari türatu hecuame hepaüsita tatiʼaitüvame tasivicueisitüvame Quesusi Cürisitu miʼatüa","website":"https://ebible.org/Scriptures/details.php?id=hchNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hchNT","licenseNotes":null,"shortName":"WBT","englishName":"Huichol NT","language":"hch","textDirection":"ltr","sha256":"4fc63ae41172b4d120ce27b3cd155b0f8bfa930ea38ae3bf2515f5323dce11ab","availableFormats":["json"],"listOfBooksApiLink":"/api/hch_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7955,"languageName":"Huichol","languageEnglishName":"Huichol"},"book":{"id":"HEB","translationId":"hch_wbt","name":"Hepürayusixi","commonName":"Hepürayusixi","title":"HEPÜRAYUSIXI Que Memüte'u'utüiyari","order":58,"numberOfChapters":13,"sha256":"6a9f50efe87cdc857ab1af89232189dd8fafd4eade3d6b4af617f8ec5a96ae10","firstChapterNumber":1,"firstChapterApiLink":"/api/hch_wbt/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/hch_wbt/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Cacaüyari pütatiutaxatüa nu'aya yaticuxatacacu"]},{"type":"verse","number":1,"content":["Cacaüyari meripai tinivacuxaxatüvacaitüni ta'uquiyarima, texaxatametemama yametecuxatacacu, yuxexuitü que memüte'upitüarie niuqui yücü mü'anene hepaüsita."]},{"type":"verse","number":2,"content":["Hicü tucari taparirümecacu pütatiutaxatüa tame, yaticuxatacacu que mü'ane nu'aya mühücü püta. Mücü yunive caniucayasa hesiena mütinaquenicü naitü. Mücü 'inetüacu meta Cacaüyari caninetüani tita 'amüticuma."]},{"type":"verse","number":3,"content":["Mücüsie que mütixavatü canimasiücüni que mütimarive Cacaüyari, Cacaüyari cani'inüarieyatüni que mütivaiyacü. Naime meta püratücü yuniuqui mütürücaüyecü. Mücü yücümana 'aixüa 'iyurieca tita 'axa temüte'uyuri hepaüsita mütasi'itienicü, 'ana que mü'ane mümarive serieta nayerüni muyuavisie."]},{"type":"heading","content":["Nu'aya püve'eme, niuqui tuayamete taheima miemete hepaüna mecave'emetücacu"]},{"type":"verse","number":4,"content":["Mücü niupitüarieni yemecü mümarivanicü que mü'ane mühücü, peru taheima miemete niuqui tuayamete hepaüna mepücate'upitüarie. Yaxeicüata ve'emetütü nayani, müme hepaüna mecave'emetücacu."]},{"type":"verse","number":5,"content":["Queri Cacaüyari müpaü titahüavive niuqui tuayamete xeime heiva, müpaü ticühüavetü,",{"text":"'Ecü pepünenive,","poem":1},{"lineBreak":true},{"text":"Hicü 'a'uquiyari nepaneyeitüa,","poem":1},"'utaitü. Nusu queri 'utayü,",{"text":"Ne 'uquiyarieya nepayani,","poem":1},{"lineBreak":true},{"text":"Mücü nenive payani,","poem":1},"'utaitü."]},{"type":"verse","number":6,"content":["Masi tucari hepaüsita ticuxatatatü quepaucua cuiepa mi'atüani yumatüari müpaü püta canaineni,",{"text":"Yunaitü Cacaüyarisüa miemete","poem":1},{"lineBreak":true},{"text":"Niuqui tuayamete","poem":1},{"lineBreak":true},{"text":"Meque'ineneviyani,","poem":1},"'utaitü."]},{"type":"verse","number":7,"content":["Quepaucua niuqui tuayamete müvaxata müpaü paine,",{"text":"Yuniuqui tuayamete","poem":1},{"lineBreak":true},{"text":"'Eca nivarayeitüvani,","poem":1},{"lineBreak":true},{"text":"Yutupirisixima meta","poem":1},{"lineBreak":true},{"text":"Tai nerücuari nivarayeitüvani.","poem":1}]},{"type":"verse","number":8,"content":["Yunive püta xatatü müpaü paine,",{"text":"'Ecü Cacaüyari 'a'uveni haque pemüra'aita","poem":1},{"lineBreak":true},{"text":"Yuheyemecü 'apuve,","poem":1},{"lineBreak":true},{"text":"Canixeuraüyeni","poem":1},{"lineBreak":true},{"text":"'A'isü pemacue'e pemüti'aitamecü","poem":1},{"lineBreak":true},{"text":"'Inüari canihücütüni","poem":1},{"lineBreak":true},{"text":"Heiseriemecü que pemüticamie 'ecü.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pepinaqui'erie tita mütiheiserie,","poem":1},{"lineBreak":true},{"text":"Pepi'uxive'erie tita 'aisica mütitisana.","poem":1},{"lineBreak":true},{"text":"Cacaüyari 'acu","poem":1},{"lineBreak":true},{"text":"Que mü'ane mü'acacaüyari","poem":1},{"lineBreak":true},{"text":"Pümasi'anayexei,","poem":1},{"lineBreak":true},{"text":"Temavierica masipitüatü","poem":1},{"lineBreak":true},{"text":"'Inüaritüme","poem":1},{"lineBreak":true},{"text":"'Ahamicuma cavaratahüavetü.","poem":1}]},{"type":"verse","number":10,"content":["Müpaü paineta,",{"text":"'Ecü Ti'aitame sutüapai pepicaque cuie,","poem":1},{"lineBreak":true},{"text":"Muyuavi peputavevie 'amamacü.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mücü pütiyünare","poem":1},{"lineBreak":true},{"text":"'Ecü püta 'apeniuvemücü.","poem":1},{"lineBreak":true},{"text":"'Ixuriquipaü mücü naitü nitaye'irimücü.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Muyuavi pepütatuna 'ücaripaü","poem":1},{"lineBreak":true},{"text":"Camixapaü püpasieni.","poem":1},{"lineBreak":true},{"text":"Masi 'ecü yaxeicüa pe'anetü pepü'ahayeva,","poem":1},{"lineBreak":true},{"text":"'Atucari pücatixüni.","poem":1}]},{"type":"verse","number":13,"content":["Queri hasuacu titahüavive niuqui tuayamete xeime müpaü ticühüavetü,",{"text":"Neserieta mexicuxi quenacani","poem":1},{"lineBreak":true},{"text":"Memümasi'aca'unie nemüva'atüani 'ahetüa.","poem":1}]},{"type":"verse","number":14,"content":["Camüsü niuqui tuayamete yunaitü 'iyarite mecanihümetüni, Cacaüyari memütupirisiximama. Mepütanü'ariva memüvaparevienicü müme vahesie mütinaquirüme memütavicueisitüarienicü."]}],"footnotes":[]},"thisChapterLink":"/api/hch_wbt/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hch_wbt/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hch_wbt/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}