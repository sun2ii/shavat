{"translation":{"id":"heb_lbm","name":"Biblica®‎ ‫הברית החדשה/הדרך זכויות פתוחות","website":"https://ebible.org/Scriptures/details.php?id=heblb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=heblb","licenseNotes":null,"shortName":"LBM","englishName":"Hebrew Living NT","language":"heb","textDirection":"rtl","sha256":"583d15532b9da2bdd1291565432755a088e38c5fd4f675de8236c32581fdc8d1","availableFormats":["json"],"listOfBooksApiLink":"/api/heb_lbm/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7727,"languageName":"עברית","languageEnglishName":"Hebrew"},"book":{"id":"HEB","translationId":"heb_lbm","name":"האיגרת אל־העברים","commonName":"האיגרת אל־העברים","title":"האיגרת אל־העברים","order":58,"numberOfChapters":13,"sha256":"66602312710e51bcdf4c09aba708d7fdd5ee5fbcabce1a83872741d038d34bc0","firstChapterNumber":1,"firstChapterApiLink":"/api/heb_lbm/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/heb_lbm/HEB/13.json","totalNumberOfVerses":300},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["לפני שנים רבות דיבר אלוהים אל אבותינו באמצעות הנביאים בדרכים שונות, וסיפר להם, שלב אחרי שלב, על תוכניותיו."]},{"type":"verse","number":2,"content":["אך עתה, באחרית הימים, דיבר אלינו אלוהים באמצעות בנו, אשר בידו הפקיד את הכול ועל־ידו ברא את העולם ואת כל אשר בו."]},{"type":"verse","number":3,"content":["בן־האלוהים מקרין את זוהר כבוד האלוהים; הוא צלם תכונותיו של אלוהים, ובכוח דברו הוא נושא את העולם כולו. לאחר שהקריב את עצמו למעננו, כדי לטהר אותנו מחטאינו, עלה בן האלוהים למרומים וישב לימין האלוהים."]},{"type":"verse","number":4,"content":["בזאת הוכיח שהוא בעל חשיבות גדולה מכל המלאכים, ואלוהים אישר עובדה זאת כשהעניק לו את השם: ”בן־אלוהים“ – שם שלא הוענק לאף מלאך!"]},{"type":"verse","number":5,"content":["לאיזה מלאך אמר אלוהים אי־פעם:",{"noteId":0},"”בני אתה, אני היום ילדתיך“?, או",{"noteId":1},"”אני אהיה לו לאב והוא יהיה לי לבן“?"]},{"type":"verse","number":6,"content":["כשהציג אלוהים לפני העולם את בנו בכורו, את ישוע המשיח, אמר:",{"noteId":2},"”השתחוו לו כל־מלאכי אלוהים“."]},{"type":"verse","number":7,"content":["ועל המלאכים אלוהים אומר:",{"noteId":3},{"text":"”עושה מלאכיו רוחות,","poem":1},{"text":"משרתיו אש לוהט“.","poem":2}]},{"type":"verse","number":8,"content":["אך לבנו הוא אומר:",{"noteId":4},{"text":"”כסאך, אלוהים, עולם ועד,","poem":1},{"text":"שבט מישר שבט מלכותך.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"אהבת צדק ותשנא רשע,","poem":1},{"text":"על כן משחך אלהים אלהיך","poem":2},{"text":"שמן ששון מחבריך“.","poem":1}]},{"type":"verse","number":10,"content":["גם במקום אחר אנו מוצאים רמז לעליונותו של הבן:",{"noteId":5},{"text":"”אתה, אדוני, לפנים הארץ יסדת,","poem":1},{"text":"ומעשה ידיך שמים.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"המה יאבדו, ואתה תעמד;","poem":1},{"text":"וכולם כבגד יבלו.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"כלבוש תחליפם, ויחלפו.","poem":1},{"text":"ואתה הוא ושנותיך לא יתמו“.","poem":2}]},{"type":"verse","number":13,"content":["האם אמר אלוהים אי־פעם לאחד המלאכים את אשר אמר לבנו:",{"noteId":6},{"text":"”שב לימיני עד אשית ‎ א‎וֹיְבֶיךָ הֲד‎וֹם לרגליך“?","poem":1}]},{"type":"verse","number":14,"content":["לא! כי המלאכים הם רק רוחות שרת, אשר נשלחו לעזור ולהשגיח על העתידים להיוושע."]}],"footnotes":[{"noteId":0,"caller":"+","text":"1‏.5 א 5 תהלים ב 7","reference":{"chapter":1,"verse":5}},{"noteId":1,"caller":"+","text":"1‏.5 א 5 שמ״ב ז 14","reference":{"chapter":1,"verse":5}},{"noteId":2,"caller":"+","text":"1‏.6 א 6 תהלים צז 7","reference":{"chapter":1,"verse":6}},{"noteId":3,"caller":"+","text":"1‏.7 א 7 תהלים קד 4","reference":{"chapter":1,"verse":7}},{"noteId":4,"caller":"+","text":"1‏.8 א 8 תהלים מה 7‏-8","reference":{"chapter":1,"verse":8}},{"noteId":5,"caller":"+","text":"1‏.10 א 10 תהלים קב 26‏-28","reference":{"chapter":1,"verse":10}},{"noteId":6,"caller":"+","text":"1‏.13 א 13 תהלים קי 1","reference":{"chapter":1,"verse":13}}]},"thisChapterLink":"/api/heb_lbm/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/heb_lbm/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/heb_lbm/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}