{"translation":{"id":"heb_lbm","name":"Biblica®‎ ‫הברית החדשה/הדרך זכויות פתוחות","website":"https://ebible.org/Scriptures/details.php?id=heblb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=heblb","licenseNotes":null,"shortName":"LBM","englishName":"Hebrew Living NT","language":"heb","textDirection":"rtl","sha256":"583d15532b9da2bdd1291565432755a088e38c5fd4f675de8236c32581fdc8d1","availableFormats":["json"],"listOfBooksApiLink":"/api/heb_lbm/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7727,"languageName":"עברית","languageEnglishName":"Hebrew"},"book":{"id":"REV","translationId":"heb_lbm","name":"התגלות","commonName":"התגלות","title":"התגלות","order":66,"numberOfChapters":22,"sha256":"d8ffb27c01aead5612e7009c548bcfdeaaf55b0baa24295fae86bc8cb0d7b218","firstChapterNumber":1,"firstChapterApiLink":"/api/heb_lbm/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/heb_lbm/REV/22.json","totalNumberOfVerses":397},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":["אחר כך ראיתי בשמים חזיון מסתורי נוסף: שבעה מלאכים נושאים שבע מגפות. אלה הן המכות האחרונות, כי יחד איתן בא הקץ לזעמו של אלוהים."]},{"type":"verse","number":2,"content":["ראיתי מולי מעין ים זכוכית ואש, ועליו עומדים כל אלה שהתגברו על החיה הרעה, על פסלה, על סימן החותם שלה ועל מספרה. כולם החזיקו בידיהם את כינורות האלוהים,"]},{"type":"verse","number":3,"content":["ושרו את שירת משה עבד אלוהים ואת שירת השה:",{"text":"”גדולים ונפלאים מעשיך,","poem":1},{"text":"ה׳ אלוהי צבאות.","poem":2},{"text":"צדק ואמת דרכיך,","poem":1},{"text":"ה׳ מלך הגויים.","poem":2},{"text":"מי לא ירא מפניך, ה׳?","poem":1},{"text":"ומי לא ייתן כבוד לשמך?","poem":2},{"text":"כי אתה לבדך קדוש.","poem":1},{"text":"כל העמים יבואו וישתחוו לפניך,","poem":2},{"text":"כי נגלו מעשיך הצודקים.“","poem":1}]},{"type":"verse","number":5,"content":["אחרי כן ראיתי את קודש הקודשים בהיכל השמים נפתח לרווחה,"]},{"type":"verse","number":6,"content":["ומתוכו יצאו שבעת המלאכים שנשאו את שבע המכות. הם לבשו גלימות לבנות, צחורות וטהורות, ועל החזה חגרו חגורות זהב."]},{"type":"verse","number":7,"content":["אחת מארבע החיות הגישה לכל אחד מהשבעה קערת זהב מלאה בזעם האלוהים החי לנצח."]},{"type":"verse","number":8,"content":["ההיכל נמלא עשן מגבורתו של אלוהים ומכבודו, ואיש לא יכול היה להיכנס לתוכו עד שסיימו שבעת המלאכים להכות את הארץ בשבע המגפות."]}],"footnotes":[]},"thisChapterLink":"/api/heb_lbm/REV/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/heb_lbm/REV/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/heb_lbm/REV/14.json","previousChapterAudioLinks":{},"numberOfVerses":7}