{"translation":{"id":"heb_mod","name":"תנ ך עברי מודרני","website":"https://ebible.org/Scriptures/details.php?id=heb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=heb","licenseNotes":null,"shortName":"MOD","englishName":"Modern Hebrew Bible","language":"heb","textDirection":"rtl","sha256":"cf543e244a155dddd289ff29f5c481d876a5ef56c696570f44e12c1ce841a3fe","availableFormats":["json"],"listOfBooksApiLink":"/api/heb_mod/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"עברית","languageEnglishName":"Hebrew"},"book":{"id":"1CH","translationId":"heb_mod","name":"1 דִּבְרֵי הַיָּמִים","commonName":"1 דִּבְרֵי הַיָּמִים","title":"1 דִּבְרֵי הַיָּמִים","order":13,"numberOfChapters":29,"sha256":"8217bd93da5e7241790de376c494b77e91c0b1c69a8ed76246ac96c1f6122252","firstChapterNumber":1,"firstChapterApiLink":"/api/heb_mod/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/heb_mod/1CH/29.json","totalNumberOfVerses":942},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":["וישלח חירם מלך צר מלאכים אל דויד ועצי ארזים וחרשי קיר וחרשי עצים לבנות לו בית׃"]},{"type":"verse","number":2,"content":["וידע דויד כי הכינו יהוה למלך על ישראל כי נשאת למעלה מלכותו בעבור עמו ישראל׃"]},{"type":"verse","number":3,"content":["ויקח דויד עוד נשים בירושלם ויולד דויד עוד בנים ובנות׃"]},{"type":"verse","number":4,"content":["ואלה שמות הילודים אשר היו לו בירושלם שמוע ושובב נתן ושלמה׃"]},{"type":"verse","number":5,"content":["ויבחר ואלישוע ואלפלט׃"]},{"type":"verse","number":6,"content":["ונגה ונפג ויפיע׃"]},{"type":"verse","number":7,"content":["ואלישמע ובעלידע ואליפלט׃"]},{"type":"verse","number":8,"content":["וישמעו פלשתים כי נמשח דויד למלך על כל ישראל ויעלו כל פלשתים לבקש את דויד וישמע דויד ויצא לפניהם׃"]},{"type":"verse","number":9,"content":["ופלשתים באו ויפשטו בעמק רפאים׃"]},{"type":"verse","number":10,"content":["וישאל דויד באלהים לאמר האעלה על פלשתיים ונתתם בידי ויאמר לו יהוה עלה ונתתים בידך׃"]},{"type":"verse","number":11,"content":["ויעלו בבעל פרצים ויכם שם דויד ויאמר דויד פרץ האלהים את אויבי בידי כפרץ מים על כן קראו שם המקום ההוא בעל פרצים׃"]},{"type":"verse","number":12,"content":["ויעזבו שם את אלהיהם ויאמר דויד וישרפו באש׃"]},{"type":"verse","number":13,"content":["ויסיפו עוד פלשתים ויפשטו בעמק׃"]},{"type":"verse","number":14,"content":["וישאל עוד דויד באלהים ויאמר לו האלהים לא תעלה אחריהם הסב מעליהם ובאת להם ממול הבכאים׃"]},{"type":"verse","number":15,"content":["ויהי כשמעך את קול הצעדה בראשי הבכאים אז תצא במלחמה כי יצא האלהים לפניך להכות את מחנה פלשתים׃"]},{"type":"verse","number":16,"content":["ויעש דויד כאשר צוהו האלהים ויכו את מחנה פלשתים מגבעון ועד גזרה׃"]},{"type":"verse","number":17,"content":["ויצא שם דויד בכל הארצות ויהוה נתן את פחדו על כל הגוים׃"]}],"footnotes":[]},"thisChapterLink":"/api/heb_mod/1CH/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/heb_mod/1CH/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/heb_mod/1CH/13.json","previousChapterAudioLinks":{},"numberOfVerses":17}