{"translation":{"id":"heb_mod","name":"תנ ך עברי מודרני","website":"https://ebible.org/Scriptures/details.php?id=heb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=heb","licenseNotes":null,"shortName":"MOD","englishName":"Modern Hebrew Bible","language":"heb","textDirection":"rtl","sha256":"cf543e244a155dddd289ff29f5c481d876a5ef56c696570f44e12c1ce841a3fe","availableFormats":["json"],"listOfBooksApiLink":"/api/heb_mod/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"עברית","languageEnglishName":"Hebrew"},"book":{"id":"1JN","translationId":"heb_mod","name":"1 ג'ון","commonName":"1 ג'ון","title":"הָאִגֶּרֶת הָרִאשׁוֹנָה לְיוֹחָנָן הַשָּׁלִיחַ","order":62,"numberOfChapters":5,"sha256":"d7a8f80e1711676597a88d1d7336718620b03ec4ef144342749348c3289f310e","firstChapterNumber":1,"firstChapterApiLink":"/api/heb_mod/1JN/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/heb_mod/1JN/5.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["את אשר היה מראש אשר שמענו ובעינינו ראינו אשר הבטנו ואשר מששו ידינו על דבר החיים׃"]},{"type":"verse","number":2,"content":["והחיים נגלו ונרא ומעידים אנחנו ומודיעים לכם את חיי העולם אשר היו עם האב ונגלו לנו׃"]},{"type":"verse","number":3,"content":["את אשר ראינו ושמענו נודיעה לכם למען תתחברו לנו גם אתם והתחברותנו היא עם האב ועם בנו ישוע המשיח׃"]},{"type":"verse","number":4,"content":["ואת זאת כתבים אנחנו לכם למען תהיה שמחתכם שלמה׃"]},{"type":"verse","number":5,"content":["וזאת היא השמועה אשר שמענו ממנו ונגד לכם כי האלהים אור הוא וכל חשך אין בו׃"]},{"type":"verse","number":6,"content":["אם נאמר כי יש לנו התחברות עמו ונתהלך בחשך הננו כזבים ופעלתנו איננה אמת׃"]},{"type":"verse","number":7,"content":["אך אם באור נלך כאשר הוא באור הנה נתחברנו יחד ודם ישוע המשיח בנו יטהרנו מכל חטא׃"]},{"type":"verse","number":8,"content":["אם נאמר כי אין בנו חטא הננו מתעים את נפשתינו והאמת אין בנו׃"]},{"type":"verse","number":9,"content":["ואם נתודה את חטאתינו נאמן הוא וצדיק לסלח לנו את חטאתינו ולטהרנו מכל עון׃"]},{"type":"verse","number":10,"content":["ואם נאמר כי לא חטאנו לכזב נשימנו ודברו אין בנו׃"]}],"footnotes":[]},"thisChapterLink":"/api/heb_mod/1JN/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/heb_mod/1JN/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/heb_mod/2PE/3.json","previousChapterAudioLinks":{},"numberOfVerses":10}