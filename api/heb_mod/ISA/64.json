"]},{"type":"verse","number":11,"content":["בית קדשנו ותפארתנו אשר הללוך אבתינו היה לשרפת אש וכל מחמדינו היה לחרבה׃"]},{"type":"verse","number":12,"content":["העל אלה תתאפק יהוה תחשה ותעננו עד מאד׃"]}],"footnotes":[]},"thisChapterLink":"/api/heb_mod/ISA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/heb_mod/ISA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/heb_mod/ISA/63.json","previousChapterAudioLinks":{},"numberOfVerses":12}