{"translation":{"id":"heb_wlc","name":"Westminster Leningrad Codex","website":"https://ebible.org/Scriptures/details.php?id=hebwlc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hebwlc","licenseNotes":null,"shortName":"WLC","englishName":"Hebrew OT (WLC)","language":"heb","textDirection":"rtl","sha256":"47386b09adaee610b89c1fccd5e86bf7f383d9cca7ac18d84c79829c2cdd8e9a","availableFormats":["json"],"listOfBooksApiLink":"/api/heb_wlc/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":23213,"languageName":"עברית","languageEnglishName":"Hebrew"},"book":{"id":"JOB","translationId":"heb_wlc","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"6022349f0ea455d2f3227c54fae19e80e015d53a0b59d77d2d122e4ea465dc95","firstChapterNumber":1,"firstChapterApiLink":"/api/heb_wlc/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/heb_wlc/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":["וַיַּ֥עַן אִיּ֗וֹב וַיֹּאמַֽר׃"]},{"type":"verse","number":2,"content":["גַּם־הַ֭יּוֹם מְרִ֣י שִׂחִ֑י יָ֝דִ֗י כָּבְדָ֥ה עַל־אַנְחָתִֽי׃"]},{"type":"verse","number":3,"content":["מִֽי־יִתֵּ֣ן יָ֭דַעְתִּי וְאֶמְצָאֵ֑הוּ אָ֝ב֗וֹא עַד־תְּכוּנָתֽוֹ׃"]},{"type":"verse","number":4,"content":["אֶעֶרְכָ֣ה לְפָנָ֣יו מִשְׁפָּ֑ט וּ֝פִ֗י אֲמַלֵּ֥א תוֹכָחֽוֹת׃"]},{"type":"verse","number":5,"content":["אֵ֭דְעָה מִלִּ֣ים יַעֲנֵ֑נִי וְ֝אָבִ֗ינָה מַה־יֹּ֥אמַר לִֽי׃"]},{"type":"verse","number":6,"content":["הַבְּרָב־כֹּ֭חַ יָרִ֣יב עִמָּדִ֑י לֹ֥א אַךְ־ה֝֗וּא יָשִׂ֥ם בִּֽי׃"]},{"type":"verse","number":7,"content":["שָׁ֗ם יָ֭שָׁר נוֹכָ֣ח עִמּ֑וֹ וַאֲפַלְּטָ֥ה לָ֝נֶ֗צַח מִשֹּׁפְטִֽי׃"]},{"type":"verse","number":8,"content":["הֵ֤ן קֶ֣דֶם אֶהֱלֹ֣ךְ וְאֵינֶ֑נּוּ וְ֝אָח֗וֹר וְֽלֹא־אָבִ֥ין לֽוֹ׃"]},{"type":"verse","number":9,"content":["שְׂמֹ֣אול בַּעֲשֹׂת֣וֹ וְלֹא־אָ֑חַז יַעְטֹ֥ף יָ֝מִ֗ין וְלֹ֣א אֶרְאֶֽה׃"]},{"type":"verse","number":10,"content":["כִּֽי־יָ֭דַע דֶּ֣רֶךְ עִמָּדִ֑י בְּ֝חָנַ֗נִי כַּזָּהָ֥ב אֵצֵֽא׃"]},{"type":"verse","number":11,"content":["בַּ֭אֲשֻׁרוֹ אָחֲזָ֣ה רַגְלִ֑י דַּרְכּ֖וֹ שָׁמַ֣רְתִּי וְלֹא־אָֽט׃"]},{"type":"verse","number":12,"content":["מִצְוַ֣ת שְׂ֭פָתָיו וְלֹ֣א אָמִ֑ישׁ מֵ֝חֻקִּ֗י צָפַ֥נְתִּי אִמְרֵי־פִֽיו׃"]},{"type":"verse","number":13,"content":["וְה֣וּא בְ֭אֶחָד וּמִ֣י יְשִׁיבֶ֑נּוּ וְנַפְשׁ֖וֹ אִוְּתָ֣ה וַיָּֽעַשׂ׃"]},{"type":"verse","number":14,"content":["כִּ֭י יַשְׁלִ֣ים חֻקִּ֑י וְכָהֵ֖נָּה רַבּ֣וֹת עִמּֽוֹ׃"]},{"type":"verse","number":15,"content":["עַל־כֵּ֭ן מִפָּנָ֣יו אֶבָּהֵ֑ל אֶ֝תְבּוֹנֵ֗ן וְאֶפְחַ֥ד מִמֶּֽנּוּ׃"]},{"type":"verse","number":16,"content":["וְ֭אֵל הֵרַ֣ךְ לִבִּ֑י וְ֝שַׁדַּ֗י הִבְהִילָֽנִי׃"]},{"type":"verse","number":17,"content":["כִּֽי־לֹ֣א נִ֭צְמַתִּי מִפְּנֵי־חֹ֑שֶׁךְ וּ֝מִפָּנַ֗י כִּסָּה־אֹֽפֶל׃"]}],"footnotes":[]},"thisChapterLink":"/api/heb_wlc/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/heb_wlc/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/heb_wlc/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}