verse","number":11,"content":["עַמּוּדֵ֣י שָׁמַ֣יִם יְרוֹפָ֑פוּ וְ֝יִתְמְה֗וּ מִגַּעֲרָתֽוֹ׃"]},{"type":"verse","number":12,"content":["בְּ֭כֹחוֹ רָגַ֣ע הַיָּ֑ם ובתובנתו מָ֣חַץ רָֽהַב׃"]},{"type":"verse","number":13,"content":["בְּ֭רוּחוֹ שָׁמַ֣יִם שִׁפְרָ֑ה חֹֽלֲלָ֥ה יָ֝ד֗וֹ נָחָ֥שׁ בָּרִֽיחַ׃"]},{"type":"verse","number":14,"content":["הֶן־אֵ֤לֶּה ׀ קְצ֬וֹת דרכו וּמַה־שֵּׁ֣מֶץ דָּ֭בָר נִשְׁמַע־בּ֑וֹ וְרַ֥עַם גבורתו מִ֣י יִתְבּוֹנָֽן׃ ס"]}],"footnotes":[]},"thisChapterLink":"/api/heb_wlc/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/heb_wlc/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/heb_wlc/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}