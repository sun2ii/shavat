{"translation":{"id":"heb_wlc","name":"Westminster Leningrad Codex","website":"https://ebible.org/Scriptures/details.php?id=hebwlc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hebwlc","licenseNotes":null,"shortName":"WLC","englishName":"Hebrew OT (WLC)","language":"heb","textDirection":"rtl","sha256":"47386b09adaee610b89c1fccd5e86bf7f383d9cca7ac18d84c79829c2cdd8e9a","availableFormats":["json"],"listOfBooksApiLink":"/api/heb_wlc/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":23213,"languageName":"עברית","languageEnglishName":"Hebrew"},"book":{"id":"PSA","translationId":"heb_wlc","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":150,"sha256":"fc0d34418b8d5e2e908e38f913970bb007540c61dc02dae116797983e2ca0b4f","firstChapterNumber":1,"firstChapterApiLink":"/api/heb_wlc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/heb_wlc/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":132,"content":[{"type":"verse","number":1,"content":["שִׁ֗יר הַֽמַּ֫עֲל֥וֹת זְכוֹר־יְהוָ֥ה לְדָוִ֑ד אֵ֝ת כָּל־עֻנּוֹתֽוֹ׃"]},{"type":"verse","number":2,"content":["אֲשֶׁ֣ר נִ֭שְׁבַּע לַיהוָ֑ה נָ֝דַ֗ר לַאֲבִ֥יר יַעֲקֹֽב׃"]},{"type":"verse","number":3,"content":["אִם־אָ֭בֹא בְּאֹ֣הֶל בֵּיתִ֑י אִם־אֶ֝עֱלֶ֗ה עַל־עֶ֥רֶשׂ יְצוּעָֽי׃"]},{"type":"verse","number":4,"content":["אִם־אֶתֵּ֣ן שְׁנַ֣ת לְעֵינָ֑י לְֽעַפְעַפַּ֥י תְּנוּמָֽה׃"]},{"type":"verse","number":5,"content":["עַד־אֶמְצָ֣א מָ֭קוֹם לַיהוָ֑ה מִ֝שְׁכָּנ֗וֹת לַאֲבִ֥יר יַעֲקֹֽב׃"]},{"type":"verse","number":6,"content":["הִנֵּֽה־שְׁמַֽעֲנ֥וּהָ בְאֶפְרָ֑תָה מְ֝צָאנ֗וּהָ בִּשְׂדֵי־יָֽעַר׃"]},{"type":"verse","number":7,"content":["נָב֥וֹאָה לְמִשְׁכְּנוֹתָ֑יו נִ֝שְׁתַּחֲוֶ֗ה לַהֲדֹ֥ם רַגְלָֽיו׃"]},{"type":"verse","number":8,"content":["קוּמָ֣ה יְ֭הוָה לִמְנוּחָתֶ֑ךָ אַ֝תָּ֗ה וַאֲר֥וֹן עֻזֶּֽךָ׃"]},{"type":"verse","number":9,"content":["כֹּהֲנֶ֥יךָ יִלְבְּשׁוּ־צֶ֑דֶק וַחֲסִידֶ֥יךָ יְרַנֵּֽנוּ׃"]},{"type":"verse","number":10,"content":["בַּ֭עֲבוּר דָּוִ֣ד עַבְדֶּ֑ךָ אַל־תָּ֝שֵׁ֗ב פְּנֵ֣י מְשִׁיחֶֽךָ׃"]},{"type":"verse","number":11,"content":["נִשְׁבַּֽע־יְהוָ֨ה ׀ לְדָוִ֡ד אֱמֶת֮ לֹֽא־יָשׁ֪וּב מִ֫מֶּ֥נָּה מִפְּרִ֥י בִטְנְךָ֑ אָ֝שִׁ֗ית לְכִסֵּא־לָֽךְ׃"]},{"type":"verse","number":12,"content":["אִֽם־יִשְׁמְר֬וּ בָנֶ֨יךָ ׀ בְּרִיתִי֮ וְעֵדֹתִ֥י ז֗וֹ אֲלַ֫מְּדֵ֥ם גַּם־בְּנֵיהֶ֥ם עֲדֵי־עַ֑ד יֵ֝שְׁב֗וּ לְכִסֵּא־לָֽךְ׃"]},{"type":"verse","number":13,"content":["כִּֽי־בָחַ֣ר יְהוָ֣ה בְּצִיּ֑וֹן אִ֝וָּ֗הּ לְמוֹשָׁ֥ב לֽוֹ׃"]},{"type":"verse","number":14,"content":["זֹאת־מְנוּחָתִ֥י עֲדֵי־עַ֑ד פֹּֽה־אֵ֝שֵׁ֗ב כִּ֣י אִוִּתִֽיהָ׃"]},{"type":"verse","number":15,"content":["צֵ֭ידָהּ בָּרֵ֣ךְ אֲבָרֵ֑ךְ אֶ֝בְיוֹנֶ֗יהָ אַשְׂבִּ֥יעַֽ לָֽחֶם׃"]},{"type":"verse","number":16,"content":["וְֽ֭כֹהֲנֶיהָ אַלְבִּ֣ישׁ יֶ֑שַׁע וַ֝חֲסִידֶ֗יהָ רַנֵּ֥ן יְרַנֵּֽנוּ׃"]},{"type":"verse","number":17,"content":["שָׁ֤ם אַצְמִ֣יחַ קֶ֣רֶן לְדָוִ֑ד עָרַ֥כְתִּי נֵ֝֗ר לִמְשִׁיחִֽי׃"]},{"type":"verse","number":18,"content":["א֭וֹיְבָיו אַלְבִּ֣ישׁ בֹּ֑שֶׁת וְ֝עָלָ֗יו יָצִ֥יץ נִזְרֽוֹ׃"]}],"footnotes":[]},"thisChapterLink":"/api/heb_wlc/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/heb_wlc/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/heb_wlc/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}