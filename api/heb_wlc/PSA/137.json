ָ֑ךְ אֶת־גְּ֝מוּלֵ֗ךְ שֶׁגָּמַ֥לְתְּ לָֽנוּ׃"]},{"type":"verse","number":9,"content":["אַשְׁרֵ֤י ׀ שֶׁיֹּאחֵ֓ז וְנִפֵּ֬ץ אֶֽת־עֹ֝לָלַ֗יִךְ אֶל־הַסָּֽלַע׃"]}],"footnotes":[]},"thisChapterLink":"/api/heb_wlc/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/heb_wlc/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/heb_wlc/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}