ִ֭י יַכְתִּ֣רוּ צַדִּיקִ֑ים כִּ֖י תִגְמֹ֣ל עָלָֽי׃"]}],"footnotes":[]},"thisChapterLink":"/api/heb_wlc/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/heb_wlc/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/heb_wlc/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":8}