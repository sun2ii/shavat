verse","number":10,"content":["הַֽחַיָּ֥ה וְכָל־בְּהֵמָ֑ה רֶ֝֗מֶשׂ וְצִפּ֥וֹר כָּנָֽף׃"]},{"type":"verse","number":11,"content":["מַלְכֵי־אֶ֭רֶץ וְכָל־לְאֻמִּ֑ים שָׂ֝רִ֗ים וְכָל־שֹׁ֥פְטֵי אָֽרֶץ׃"]},{"type":"verse","number":12,"content":["בַּחוּרִ֥ים וְגַם־בְּתוּל֑וֹת זְ֝קֵנִ֗ים עִם־נְעָרִֽים׃"]},{"type":"verse","number":13,"content":["יְהַלְל֤וּ ׀ אֶת־שֵׁ֬ם יְהוָ֗ה כִּֽי־נִשְׂגָּ֣ב שְׁמ֣וֹ לְבַדּ֑וֹ ה֝וֹד֗וֹ עַל־אֶ֥רֶץ וְשָׁמָֽיִם׃"]},{"type":"verse","number":14,"content":["וַיָּ֤רֶם קֶ֨רֶן ׀ לְעַמּ֡וֹ תְּהִלָּ֤ה לְֽכָל־חֲסִידָ֗יו לִבְנֵ֣י יִ֭שְׂרָאֵל עַֽם־קְרֹב֗וֹ הַֽלְלוּ־יָֽהּ׃"]}],"footnotes":[]},"thisChapterLink":"/api/heb_wlc/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/heb_wlc/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/heb_wlc/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}