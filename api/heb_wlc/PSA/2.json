 יוֹצֵ֣ר תְּנַפְּצֵֽם׃"]},{"type":"verse","number":10,"content":["וְ֭עַתָּה מְלָכִ֣ים הַשְׂכִּ֑ילוּ הִ֝וָּסְר֗וּ שֹׁ֣פְטֵי אָֽרֶץ׃"]},{"type":"verse","number":11,"content":["עִבְד֣וּ אֶת־יְהוָ֣ה בְּיִרְאָ֑ה וְ֝גִ֗ילוּ בִּרְעָדָֽה׃"]},{"type":"verse","number":12,"content":["נַשְּׁקוּ־בַ֡ר פֶּן־יֶאֱנַ֤ף ׀ וְתֹ֬אבְדוּ דֶ֗רֶךְ כִּֽי־יִבְעַ֣ר כִּמְעַ֣ט אַפּ֑וֹ אַ֝שְׁרֵ֗י כָּל־ח֥וֹסֵי בֽוֹ׃"]}],"footnotes":[]},"thisChapterLink":"/api/heb_wlc/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/heb_wlc/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/heb_wlc/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}