":["שְׂא֤וּ שְׁעָרִ֨ים ׀ רָֽאשֵׁיכֶ֗ם וּ֭שְׂאוּ פִּתְחֵ֣י עוֹלָ֑ם וְ֝יָבֹא מֶ֣לֶךְ הַכָּבֽוֹד׃"]},{"type":"verse","number":10,"content":["מִ֤י ה֣וּא זֶה֮ מֶ֤לֶךְ הַכָּ֫ב֥וֹד יְהוָ֥ה צְבָא֑וֹת ה֤וּא מֶ֖לֶךְ הַכָּב֣וֹד סֶֽלָה׃"]}],"footnotes":[]},"thisChapterLink":"/api/heb_wlc/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/heb_wlc/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/heb_wlc/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}