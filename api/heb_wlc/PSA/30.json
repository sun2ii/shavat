,{"type":"verse","number":10,"content":["מַה־בֶּ֥צַע בְּדָמִי֮ בְּרִדְתִּ֪י אֶ֫ל־שָׁ֥חַת הֲיוֹדְךָ֥ עָפָ֑ר הֲיַגִּ֥יד אֲמִתֶּֽךָ׃"]},{"type":"verse","number":11,"content":["שְׁמַע־יְהוָ֥ה וְחָנֵּ֑נִי יְ֝הוָה הֱֽיֵה־עֹזֵ֥ר לִֽי׃"]},{"type":"verse","number":12,"content":["הָפַ֣כְתָּ מִסְפְּדִי֮ לְמָח֪וֹל לִ֥י פִּתַּ֥חְתָּ שַׂקִּ֑י וַֽתְּאַזְּרֵ֥נִי שִׂמְחָֽה׃"]},{"type":"verse","number":13,"content":["לְמַ֤עַן ׀ יְזַמֶּרְךָ֣ כָ֭בוֹד וְלֹ֣א יִדֹּ֑ם יְהוָ֥ה אֱ֝לֹהַ֗י לְעוֹלָ֥ם אוֹדֶֽךָּ׃"]}],"footnotes":[]},"thisChapterLink":"/api/heb_wlc/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/heb_wlc/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/heb_wlc/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":13}