דֶּ֣שֶׁן בֵּיתֶ֑ךָ וְנַ֖חַל עֲדָנֶ֣יךָ תַשְׁקֵֽם׃"]},{"type":"verse","number":10,"content":["כִּֽי־עִ֭מְּךָ מְק֣וֹר חַיִּ֑ים בְּ֝אוֹרְךָ֗ נִרְאֶה־אֽוֹר׃"]},{"type":"verse","number":11,"content":["מְשֹׁ֣ךְ חַ֭סְדְּךָ לְיֹדְעֶ֑יךָ וְ֝צִדְקָֽתְךָ֗ לְיִשְׁרֵי־לֵֽב׃"]},{"type":"verse","number":12,"content":["אַל־תְּ֭בוֹאֵנִי רֶ֣גֶל גַּאֲוָ֑ה וְיַד־רְ֝שָׁעִ֗ים אַל־תְּנִדֵֽנִי׃"]},{"type":"verse","number":13,"content":["שָׁ֣ם נָ֭פְלוּ פֹּ֣עֲלֵי אָ֑וֶן דֹּ֝ח֗וּ וְלֹא־יָ֥כְלוּ קֽוּם׃"]}],"footnotes":[]},"thisChapterLink":"/api/heb_wlc/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/heb_wlc/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/heb_wlc/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":13}