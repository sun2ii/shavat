ִבְטַח בְּרֹ֣ב עָשְׁר֑וֹ יָ֝עֹ֗ז בְּהַוָּתֽוֹ׃"]},{"type":"verse","number":10,"content":["וַאֲנִ֤י ׀ כְּזַ֣יִת רַ֭עֲנָן בְּבֵ֣ית אֱלֹהִ֑ים בָּטַ֥חְתִּי בְחֶֽסֶד־אֱ֝לֹהִ֗ים עוֹלָ֥ם וָעֶֽד׃"]},{"type":"verse","number":11,"content":["אוֹדְךָ֣ לְ֭עוֹלָם כִּ֣י עָשִׂ֑יתָ וַאֲקַוֶּ֖ה שִׁמְךָ֥ כִֽי־ט֝֗וֹב נֶ֣גֶד חֲסִידֶֽיךָ׃"]}],"footnotes":[]},"thisChapterLink":"/api/heb_wlc/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/heb_wlc/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/heb_wlc/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":11}