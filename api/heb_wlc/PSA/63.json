֑יךָ בִּ֝֗י תָּמְכָ֥ה יְמִינֶֽךָ׃"]},{"type":"verse","number":10,"content":["וְהֵ֗מָּה לְ֭שׁוֹאָה יְבַקְשׁ֣וּ נַפְשִׁ֑י יָ֝בֹ֗אוּ בְּֽתַחְתִּיּ֥וֹת הָאָֽרֶץ׃"]},{"type":"verse","number":11,"content":["יַגִּירֻ֥הוּ עַל־יְדֵי־חָ֑רֶב מְנָ֖ת שֻׁעָלִ֣ים יִהְיֽוּ׃"]},{"type":"verse","number":12,"content":["וְהַמֶּלֶךְ֮ יִשְׂמַ֪ח בֵּאלֹ֫הִ֥ים יִ֭תְהַלֵּל כָּל־הַנִּשְׁבָּ֣ע בּ֑וֹ כִּ֥י יִ֝סָּכֵ֗ר פִּ֣י דֽוֹבְרֵי־שָֽׁקֶר׃"]}],"footnotes":[]},"thisChapterLink":"/api/heb_wlc/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/heb_wlc/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/heb_wlc/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":12}