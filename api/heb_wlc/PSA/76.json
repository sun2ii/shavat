t":["בְּקוּם־לַמִּשְׁפָּ֥ט אֱלֹהִ֑ים לְהוֹשִׁ֖יעַ כָּל־עַנְוֵי־אֶ֣רֶץ סֶֽלָה׃"]},{"type":"verse","number":11,"content":["כִּֽי־חֲמַ֣ת אָדָ֣ם תּוֹדֶ֑ךָּ שְׁאֵרִ֖ית חֵמֹ֣ת תַּחְגֹּֽר׃"]},{"type":"verse","number":12,"content":["נִֽדֲר֣וּ וְשַׁלְּמוּ֮ לַיהוָ֪ה אֱֽלֹהֵ֫יכֶ֥ם כָּל־סְבִיבָ֑יו יוֹבִ֥ילוּ שַׁ֝֗י לַמּוֹרָֽא׃"]},{"type":"verse","number":13,"content":["יִ֭בְצֹר ר֣וּחַ נְגִידִ֑ים נ֝וֹרָ֗א לְמַלְכֵי־אָֽרֶץ׃"]}],"footnotes":[]},"thisChapterLink":"/api/heb_wlc/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/heb_wlc/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/heb_wlc/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":13}