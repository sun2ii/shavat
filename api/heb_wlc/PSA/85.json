e","number":10,"content":["אַ֤ךְ ׀ קָר֣וֹב לִירֵאָ֣יו יִשְׁע֑וֹ לִשְׁכֹּ֖ן כָּב֣וֹד בְּאַרְצֵֽנוּ׃"]},{"type":"verse","number":11,"content":["חֶֽסֶד־וֶאֱמֶ֥ת נִפְגָּ֑שׁוּ צֶ֖דֶק וְשָׁל֣וֹם נָשָֽׁקוּ׃"]},{"type":"verse","number":12,"content":["אֱ֭מֶת מֵאֶ֣רֶץ תִּצְמָ֑ח וְ֝צֶ֗דֶק מִשָּׁמַ֥יִם נִשְׁקָֽף׃"]},{"type":"verse","number":13,"content":["גַּם־יְ֭הוָה יִתֵּ֣ן הַטּ֑וֹב וְ֝אַרְצֵ֗נוּ תִּתֵּ֥ן יְבוּלָֽהּ׃"]},{"type":"verse","number":14,"content":["צֶ֭דֶק לְפָנָ֣יו יְהַלֵּ֑ךְ וְיָשֵׂ֖ם לְדֶ֣רֶךְ פְּעָמָֽיו׃"]}],"footnotes":[]},"thisChapterLink":"/api/heb_wlc/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/heb_wlc/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/heb_wlc/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":14}