{"translation":{"id":"heb_wlc","name":"Westminster Leningrad Codex","website":"https://ebible.org/Scriptures/details.php?id=hebwlc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hebwlc","licenseNotes":null,"shortName":"WLC","englishName":"Hebrew OT (WLC)","language":"heb","textDirection":"rtl","sha256":"47386b09adaee610b89c1fccd5e86bf7f383d9cca7ac18d84c79829c2cdd8e9a","availableFormats":["json"],"listOfBooksApiLink":"/api/heb_wlc/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":23213,"languageName":"עברית","languageEnglishName":"Hebrew"},"book":{"id":"PSA","translationId":"heb_wlc","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":150,"sha256":"fc0d34418b8d5e2e908e38f913970bb007540c61dc02dae116797983e2ca0b4f","firstChapterNumber":1,"firstChapterApiLink":"/api/heb_wlc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/heb_wlc/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":91,"content":[{"type":"verse","number":1,"content":["יֹ֭שֵׁב בְּסֵ֣תֶר עֶלְי֑וֹן בְּצֵ֥ל שַׁ֝דַּ֗י יִתְלוֹנָֽן׃"]},{"type":"verse","number":2,"content":["אֹמַ֗ר לַֽ֭יהוָה מַחְסִ֣י וּמְצוּדָתִ֑י אֱ֝לֹהַ֗י אֶבְטַח־בּֽוֹ׃"]},{"type":"verse","number":3,"content":["כִּ֤י ה֣וּא יַ֭צִּֽילְךָ מִפַּ֥ח יָק֗וּשׁ מִדֶּ֥בֶר הַוּֽוֹת׃"]},{"type":"verse","number":4,"content":["בְּאֶבְרָת֨וֹ ׀ יָ֣סֶךְ לָ֭ךְ וְתַֽחַת־כְּנָפָ֣יו תֶּחְסֶ֑ה צִנָּ֖ה וְֽסֹחֵרָ֣ה אֲמִתּֽוֹ׃"]},{"type":"verse","number":5,"content":["לֹא־תִ֭ירָא מִפַּ֣חַד לָ֑יְלָה מֵ֝חֵ֗ץ יָע֥וּף יוֹמָֽם׃"]},{"type":"verse","number":6,"content":["מִ֭דֶּבֶר בָּאֹ֣פֶל יַהֲלֹ֑ךְ מִ֝קֶּ֗טֶב יָשׁ֥וּד צָהֳרָֽיִם׃"]},{"type":"verse","number":7,"content":["יִפֹּ֤ל מִצִּדְּךָ֨ ׀ אֶ֗לֶף וּרְבָבָ֥ה מִימִינֶ֑ךָ אֵ֝לֶ֗יךָ לֹ֣א יִגָּֽשׁ׃"]},{"type":"verse","number":8,"content":["רַ֭ק בְּעֵינֶ֣יךָ תַבִּ֑יט וְשִׁלֻּמַ֖ת רְשָׁעִ֣ים תִּרְאֶֽה׃"]},{"type":"verse","number":9,"content":["כִּֽי־אַתָּ֣ה יְהוָ֣ה מַחְסִ֑י עֶ֝לְי֗וֹן שַׂ֣מְתָּ מְעוֹנֶֽךָ׃"]},{"type":"verse","number":10,"content":["לֹֽא־תְאֻנֶּ֣ה אֵלֶ֣יךָ רָעָ֑ה וְ֝נֶ֗גַע לֹא־יִקְרַ֥ב בְּאָהֳלֶֽךָ׃"]},{"type":"verse","number":11,"content":["כִּ֣י מַ֭לְאָכָיו יְצַוֶּה־לָּ֑ךְ לִ֝שְׁמָרְךָ֗ בְּכָל־דְּרָכֶֽיךָ׃"]},{"type":"verse","number":12,"content":["עַל־כַּפַּ֥יִם יִשָּׂא֑וּנְךָ פֶּן־תִּגֹּ֖ף בָּאֶ֣בֶן רַגְלֶֽךָ׃"]},{"type":"verse","number":13,"content":["עַל־שַׁ֣חַל וָפֶ֣תֶן תִּדְרֹ֑ךְ תִּרְמֹ֖ס כְּפִ֣יר וְתַנִּֽין׃"]},{"type":"verse","number":14,"content":["כִּ֤י בִ֣י חָ֭שַׁק וַאֲפַלְּטֵ֑הוּ אֲ֝שַׂגְּבֵ֗הוּ כִּֽי־יָדַ֥ע שְׁמִֽי׃"]},{"type":"verse","number":15,"content":["יִקְרָאֵ֨נִי ׀ וְֽאֶעֱנֵ֗הוּ עִמּֽוֹ־אָנֹכִ֥י בְצָרָ֑ה אֲ֝חַלְּצֵ֗הוּ וַֽאֲכַבְּדֵֽהוּ׃"]},{"type":"verse","number":16,"content":["אֹ֣רֶךְ יָ֭מִים אַשְׂבִּיעֵ֑הוּ וְ֝אַרְאֵ֗הוּ בִּֽישׁוּעָתִֽי׃"]}],"footnotes":[]},"thisChapterLink":"/api/heb_wlc/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/heb_wlc/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/heb_wlc/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}