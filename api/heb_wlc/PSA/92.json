{"translation":{"id":"heb_wlc","name":"Westminster Leningrad Codex","website":"https://ebible.org/Scriptures/details.php?id=hebwlc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hebwlc","licenseNotes":null,"shortName":"WLC","englishName":"Hebrew OT (WLC)","language":"heb","textDirection":"rtl","sha256":"47386b09adaee610b89c1fccd5e86bf7f383d9cca7ac18d84c79829c2cdd8e9a","availableFormats":["json"],"listOfBooksApiLink":"/api/heb_wlc/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":23213,"languageName":"עברית","languageEnglishName":"Hebrew"},"book":{"id":"PSA","translationId":"heb_wlc","name":"Psalms","commonName":"Psalms","title":"Psalms","order":19,"numberOfChapters":150,"sha256":"fc0d34418b8d5e2e908e38f913970bb007540c61dc02dae116797983e2ca0b4f","firstChapterNumber":1,"firstChapterApiLink":"/api/heb_wlc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/heb_wlc/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":92,"content":[{"type":"verse","number":1,"content":["מִזְמ֥וֹר שִׁ֗יר לְי֣וֹם הַשַּׁבָּֽת׃"]},{"type":"verse","number":2,"content":["ט֗וֹב לְהֹד֥וֹת לַיהוָ֑ה וּלְזַמֵּ֖ר לְשִׁמְךָ֣ עֶלְיֽוֹן׃"]},{"type":"verse","number":3,"content":["לְהַגִּ֣יד בַּבֹּ֣קֶר חַסְֽדֶּ֑ךָ וֶ֝אֱמֽוּנָתְךָ֗ בַּלֵּילֽוֹת׃"]},{"type":"verse","number":4,"content":["עֲֽלֵי־עָ֭שׂוֹר וַעֲלֵי־נָ֑בֶל עֲלֵ֖י הִגָּי֣וֹן בְּכִנּֽוֹר׃"]},{"type":"verse","number":5,"content":["כִּ֤י שִׂמַּחְתַּ֣נִי יְהוָ֣ה בְּפָעֳלֶ֑ךָ בְּֽמַעֲשֵׂ֖י יָדֶ֣יךָ אֲרַנֵּֽן׃"]},{"type":"verse","number":6,"content":["מַה־גָּדְל֣וּ מַעֲשֶׂ֣יךָ יְהוָ֑ה מְ֝אֹ֗ד עָמְק֥וּ מַחְשְׁבֹתֶֽיךָ׃"]},{"type":"verse","number":7,"content":["אִֽישׁ־בַּ֭עַר לֹ֣א יֵדָ֑ע וּ֝כְסִ֗יל לֹא־יָבִ֥ין אֶת־זֹֽאת׃"]},{"type":"verse","number":8,"content":["בִּפְרֹ֤חַ רְשָׁעִ֨ים ׀ כְּמ֥וֹ עֵ֗שֶׂב וַ֭יָּצִיצוּ כָּל־פֹּ֣עֲלֵי אָ֑וֶן לְהִשָּֽׁמְדָ֥ם עֲדֵי־עַֽד׃"]},{"type":"verse","number":9,"content":["וְאַתָּ֥ה מָר֗וֹם לְעֹלָ֥ם יְהוָֽה׃"]},{"type":"verse","number":10,"content":["כִּ֤י הִנֵּ֪ה אֹיְבֶ֡יךָ ׀ יְֽהוָ֗ה כִּֽי־הִנֵּ֣ה אֹיְבֶ֣יךָ יֹאבֵ֑דוּ יִ֝תְפָּרְד֗וּ כָּל־פֹּ֥עֲלֵי אָֽוֶן׃"]},{"type":"verse","number":11,"content":["וַתָּ֣רֶם כִּרְאֵ֣ים קַרְנִ֑י בַּ֝לֹּתִ֗י בְּשֶׁ֣מֶן רַעֲנָֽן׃"]},{"type":"verse","number":12,"content":["וַתַּבֵּ֥ט עֵינִ֗י בְּשׁ֫וּרָ֥י בַּקָּמִ֖ים עָלַ֥י מְרֵעִ֗ים תִּשְׁמַ֥עְנָה אָזְנָֽי׃"]},{"type":"verse","number":13,"content":["צַ֭דִּיק כַּתָּמָ֣ר יִפְרָ֑ח כְּאֶ֖רֶז בַּלְּבָנ֣וֹן יִשְׂגֶּֽה׃"]},{"type":"verse","number":14,"content":["שְׁ֭תוּלִים בְּבֵ֣ית יְהוָ֑ה בְּחַצְר֖וֹת אֱלֹהֵ֣ינוּ יַפְרִֽיחוּ׃"]},{"type":"verse","number":15,"content":["ע֭וֹד יְנוּב֣וּן בְּשֵׂיבָ֑ה דְּשֵׁנִ֖ים וְרַֽעֲנַנִּ֣ים יִהְיֽוּ׃"]},{"type":"verse","number":16,"content":["לְ֭הַגִּיד כִּֽי־יָשָׁ֣ר יְהוָ֑ה צ֝וּרִ֗י וְֽלֹא־עלתה בּֽוֹ׃"]}],"footnotes":[]},"thisChapterLink":"/api/heb_wlc/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/heb_wlc/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/heb_wlc/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":16}