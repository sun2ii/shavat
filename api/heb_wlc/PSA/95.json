י גַּם־רָא֥וּ פָעֳלִֽי׃"]},{"type":"verse","number":10,"content":["אַרְבָּ֘עִ֤ים שָׁנָ֨ה ׀ אָ֘ק֤וּט בְּד֗וֹר וָאֹמַ֗ר עַ֤ם תֹּעֵ֣י לֵבָ֣ב הֵ֑ם וְ֝הֵ֗ם לֹא־יָדְע֥וּ דְרָכָֽי׃"]},{"type":"verse","number":11,"content":["אֲשֶׁר־נִשְׁבַּ֥עְתִּי בְאַפִּ֑י אִם־יְ֝בֹא֗וּן אֶל־מְנוּחָתִֽי׃"]}],"footnotes":[]},"thisChapterLink":"/api/heb_wlc/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/heb_wlc/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/heb_wlc/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}