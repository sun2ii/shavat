nt":["לִֽפְֽנֵי־יְהוָ֗ה כִּ֥י בָא֮ לִשְׁפֹּ֪ט הָ֫אָ֥רֶץ יִשְׁפֹּֽט־תֵּבֵ֥ל בְּצֶ֑דֶק וְ֝עַמִּ֗ים בְּמֵישָׁרִֽים׃"]}],"footnotes":[]},"thisChapterLink":"/api/heb_wlc/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/heb_wlc/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/heb_wlc/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}