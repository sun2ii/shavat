{"translation":{"id":"hil_bib","name":"Biblica® Libre Ang Pulong Sang Dios","website":"https://ebible.org/Scriptures/details.php?id=hil","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hil","licenseNotes":null,"shortName":"BIB","englishName":"Hiligaynon: Biblica® Libre Ang Pulong Sang Dios (Bible) for the Philippines","language":"hil","textDirection":"ltr","sha256":"233a28b58d03cfab3cff229e86d59ff82d50d35717469c7fcfb289eaa862d464","availableFormats":["json"],"listOfBooksApiLink":"/api/hil_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30334,"languageName":"Hiligaynon","languageEnglishName":"Hiligaynon"},"book":{"id":"ISA","translationId":"hil_bib","name":"Isaias","commonName":"Isaias","title":"Isaias","order":23,"numberOfChapters":66,"sha256":"1c868915cbbe9e0f7cf6fee1dda6d99415bcf1791b6e4e28e6ffb6055da545f7","firstChapterNumber":1,"firstChapterApiLink":"/api/hil_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hil_bib/ISA/66.json","totalNumberOfVerses":1278},"chapter":{"number":12,"content":[{"type":"heading","content":["Kanta sa Pagpasalamat"]},{"type":"verse","number":1,"content":["Pag-abot sang sina nga adlaw, magakanta kamo:",{"lineBreak":true},{"text":"“Ginoo, ginadayaw","poem":1},{"noteId":48},{"text":"ko ikaw.","poem":1},{"text":"Naakig ka sa akon,","poem":2},{"text":"pero karon nadula na ang imo kaakig,","poem":1},{"text":"kag ginalipay mo ako.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ikaw, O Dios, amo ang akon manluluwas.","poem":1},{"text":"Magasalig ako sa imo kag indi magkahadlok.","poem":2},{"text":"Ikaw, Ginoo, amo ang nagahatag sa akon sang kusog,","poem":1},{"text":"kag ikaw ang akon ginakanta.","poem":2},{"lineBreak":true},{"text":"Ikaw ang nagluwas sa akon.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":["Subong nga ang mabugnaw nga tubig nagahatag kalipay sa ginauhaw, magakalipay kamo kon luwason na kamo sang Ginoo."]},{"type":"verse","number":4,"content":["Pag-abot sang sina nga adlaw, magakanta kamo:",{"lineBreak":true},{"text":"“Dayawa","poem":1},{"noteId":49},{"text":"ninyo ang Ginoo!","poem":1},{"text":"Simbaha ninyo siya!","poem":2},{"lineBreak":true},{"text":"Isugid sa mga katawhan ang iya mga binuhatan.","poem":2},{"lineBreak":true},{"text":"Ipanugid ninyo nga dalayawon siya.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kantahi ninyo ang Ginoo","poem":1},{"text":"tungod kay makatilingala ang iya mga ginhimo.","poem":2},{"lineBreak":true},{"text":"Ipahibalo ninyo ini sa bilog nga kalibutan.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Maghinugyaw kamo kag magkanta sa kalipay,","poem":1},{"text":"kamo nga katawhan sang Jerusalem.","poem":2},{"noteId":50},{"lineBreak":true},{"text":"Kay gamhanan ang Balaan nga Dios sang Israel nga inyo kaupod.”","poem":2}]}],"footnotes":[{"noteId":48,"caller":"+","text":"ginadayaw: ukon, ginapasalamatan","reference":{"chapter":12,"verse":1}},{"noteId":49,"caller":"+","text":"Dayawa: ukon, Pasalamati","reference":{"chapter":12,"verse":4}},{"noteId":50,"caller":"+","text":"Jerusalem: sa Hebreo, Zion","reference":{"chapter":12,"verse":6}}]},"thisChapterLink":"/api/hil_bib/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hil_bib/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hil_bib/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}