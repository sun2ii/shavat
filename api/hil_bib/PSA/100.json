","number":5,"content":[{"text":"Kay maayo ang Ginoo;","poem":1},{"text":"ang iya gugma wala sing katapusan,","poem":2},{"text":"kag ang iya katutom nagapadayon hasta san-o.","poem":1}]}],"footnotes":[{"noteId":253,"caller":"+","text":"kag iya kita: ukon, kag indi ang aton kaugalingon","reference":{"chapter":100,"verse":3}}]},"thisChapterLink":"/api/hil_bib/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hil_bib/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hil_bib/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}