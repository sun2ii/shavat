{"translation":{"id":"hil_bib","name":"Biblica® Libre Ang Pulong Sang Dios","website":"https://ebible.org/Scriptures/details.php?id=hil","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hil","licenseNotes":null,"shortName":"BIB","englishName":"Hiligaynon: Biblica® Libre Ang Pulong Sang Dios (Bible) for the Philippines","language":"hil","textDirection":"ltr","sha256":"233a28b58d03cfab3cff229e86d59ff82d50d35717469c7fcfb289eaa862d464","availableFormats":["json"],"listOfBooksApiLink":"/api/hil_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30334,"languageName":"Hiligaynon","languageEnglishName":"Hiligaynon"},"book":{"id":"PSA","translationId":"hil_bib","name":"Salmo","commonName":"Salmo","title":"Mga Salmo","order":19,"numberOfChapters":150,"sha256":"3542c42dbc82b8cc636f4c2811aa8f92b07f2602cb4f8bccbf2019b34b83a7a5","firstChapterNumber":1,"firstChapterApiLink":"/api/hil_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hil_bib/PSA/150.json","totalNumberOfVerses":2438},"chapter":{"number":120,"content":[{"type":"heading","content":["Pangamuyo para sa Bulig sang Dios"]},{"type":"hebrew_subtitle","content":["Ang kanta samtang nagapasaka."]},{"type":"verse","number":1,"content":[{"text":"Sa akon kalisod, nagpanawag ako sa Ginoo","poem":1},{"text":"kag ginsabat niya ako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ginoo, luwasa ako sa mga butigon kag mga dayaon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kamo nga mga dayaon, ano ayhan ang isilot sang Dios sa inyo?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Silutan niya kamo sang taliwis nga pana sang soldado kag nagadabadaba nga mga baga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kaluluoy ako kay nagaestar ako upod sa inyo","poem":1},{"text":"nga pareho kalain sa mga pumuluyo sang Meshec kag sang Kedar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dugay na ang akon pag-estar upod sa inyo nga indi gusto sang kalinong.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gusto ko ang kalinong pero kon maghambal gani ako parte sina ang inyo gusto inaway.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hil_bib/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hil_bib/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hil_bib/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}