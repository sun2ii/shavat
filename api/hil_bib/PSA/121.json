{"translation":{"id":"hil_bib","name":"Biblica® Libre Ang Pulong Sang Dios","website":"https://ebible.org/Scriptures/details.php?id=hil","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hil","licenseNotes":null,"shortName":"BIB","englishName":"Hiligaynon: Biblica® Libre Ang Pulong Sang Dios (Bible) for the Philippines","language":"hil","textDirection":"ltr","sha256":"233a28b58d03cfab3cff229e86d59ff82d50d35717469c7fcfb289eaa862d464","availableFormats":["json"],"listOfBooksApiLink":"/api/hil_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30334,"languageName":"Hiligaynon","languageEnglishName":"Hiligaynon"},"book":{"id":"PSA","translationId":"hil_bib","name":"Salmo","commonName":"Salmo","title":"Mga Salmo","order":19,"numberOfChapters":150,"sha256":"3542c42dbc82b8cc636f4c2811aa8f92b07f2602cb4f8bccbf2019b34b83a7a5","firstChapterNumber":1,"firstChapterApiLink":"/api/hil_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hil_bib/PSA/150.json","totalNumberOfVerses":2438},"chapter":{"number":121,"content":[{"type":"heading","content":["Ang Ginoo ang Akon Manugtipig"]},{"type":"hebrew_subtitle","content":["Ang kanta samtang nagapasaka."]},{"type":"verse","number":1,"content":[{"text":"Nagatan-aw ako sa mga bukid;","poem":1},{"text":"diin bala nagahalin ang akon bulig?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ang akon bulig nagahalin sa Ginoo, nga naghimo sang kalangitan kag sang kalibutan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Indi niya pag-itugot nga matumba ka.","poem":1},{"text":"Siya nga nagatipig sa imo, wala nagakatulog.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pamati! Ang manugtipig sang Israel wala nagapatuyo-tuyo ukon nagakatulog.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ang Ginoo nagatipig sa imo;","poem":1},{"text":"ara siya sa imo tupad sa pagprotektar sa imo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ang init sang adlaw indi makahalit sa imo ukon ang siga sang bulan kon gab-i.","poem":1},{"noteId":307}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tipigan ka sang Ginoo sa tanan nga katalagman;","poem":1},{"text":"tipigan niya ang imo kabuhi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ang Ginoo magatipig sa imo subong kag hasta san-o, bisan diin ka makadto.","poem":1},{"noteId":308}]}],"footnotes":[{"noteId":307,"caller":"+","text":"Sang una nga panahon, nahibaluan na sang mga tawo nga ang sobra nga init sang adlaw makahalit, kag nagapati sila nga ang siga sang bulan makahatag sang balatian.","reference":{"chapter":121,"verse":6}},{"noteId":308,"caller":"+","text":"bisan…makadto: ukon, sa imo paglakat kag pagbalik","reference":{"chapter":121,"verse":8}}]},"thisChapterLink":"/api/hil_bib/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hil_bib/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hil_bib/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}