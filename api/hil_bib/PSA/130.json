{"translation":{"id":"hil_bib","name":"Biblica® Libre Ang Pulong Sang Dios","website":"https://ebible.org/Scriptures/details.php?id=hil","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hil","licenseNotes":null,"shortName":"BIB","englishName":"Hiligaynon: Biblica® Libre Ang Pulong Sang Dios (Bible) for the Philippines","language":"hil","textDirection":"ltr","sha256":"233a28b58d03cfab3cff229e86d59ff82d50d35717469c7fcfb289eaa862d464","availableFormats":["json"],"listOfBooksApiLink":"/api/hil_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30334,"languageName":"Hiligaynon","languageEnglishName":"Hiligaynon"},"book":{"id":"PSA","translationId":"hil_bib","name":"Salmo","commonName":"Salmo","title":"Mga Salmo","order":19,"numberOfChapters":150,"sha256":"3542c42dbc82b8cc636f4c2811aa8f92b07f2602cb4f8bccbf2019b34b83a7a5","firstChapterNumber":1,"firstChapterApiLink":"/api/hil_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hil_bib/PSA/150.json","totalNumberOfVerses":2438},"chapter":{"number":130,"content":[{"type":"heading","content":["Pagsalig sa Ginoo sa Tion sang Kalisod"]},{"type":"hebrew_subtitle","content":["Ang kanta samtang nagapasaka."]},{"type":"verse","number":1,"content":[{"text":"Sa puwerte nga kalisod nagapanawag ako sa imo, Ginoo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pamatii ang akon pagpakitluoy sa imo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ginoo, kon ginalista mo ang amon mga sala,","poem":1},{"text":"sin-o bala ang makapabilin sa imo presensya?","poem":2},{"noteId":316}]},{"type":"verse","number":4,"content":[{"text":"Pero ginapatawad mo kami, gani ginatahod ka namon.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nagahulat gid ako sa imo, Ginoo,","poem":1},{"text":"kag nagasalig ako sa imo pulong.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nagahulat ako sa imo, Ginoo, labaw pa sa mga guwardya nga nagahulat sang kaagahon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mga taga-Israel, magsalig kamo sa Ginoo,","poem":1},{"text":"kay mahigugmaon siya kag handa permi nga magluwas.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Siya mismo ang magaluwas sa inyo sa tanan ninyo nga mga sala.","poem":1}]}],"footnotes":[{"noteId":316,"caller":"+","text":"makapabilin sa imo presensya: ukon, makapalagyo sa imo silot","reference":{"chapter":130,"verse":3}}]},"thisChapterLink":"/api/hil_bib/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hil_bib/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hil_bib/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}