{"translation":{"id":"hil_bib","name":"Biblica® Libre Ang Pulong Sang Dios","website":"https://ebible.org/Scriptures/details.php?id=hil","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hil","licenseNotes":null,"shortName":"BIB","englishName":"Hiligaynon: Biblica® Libre Ang Pulong Sang Dios (Bible) for the Philippines","language":"hil","textDirection":"ltr","sha256":"233a28b58d03cfab3cff229e86d59ff82d50d35717469c7fcfb289eaa862d464","availableFormats":["json"],"listOfBooksApiLink":"/api/hil_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30334,"languageName":"Hiligaynon","languageEnglishName":"Hiligaynon"},"book":{"id":"PSA","translationId":"hil_bib","name":"Salmo","commonName":"Salmo","title":"Mga Salmo","order":19,"numberOfChapters":150,"sha256":"3542c42dbc82b8cc636f4c2811aa8f92b07f2602cb4f8bccbf2019b34b83a7a5","firstChapterNumber":1,"firstChapterApiLink":"/api/hil_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hil_bib/PSA/150.json","totalNumberOfVerses":2438},"chapter":{"number":149,"content":[{"type":"heading","content":["Ang Kanta sa Pagdayaw"]},{"type":"verse","number":1,"content":[{"text":"Dayawa ang Ginoo!","poem":1},{"text":"Magkanta kamo sang bag-o nga kanta sa Ginoo.","poem":2},{"text":"Dayawa siya sa pagtililipon sang iya matutom nga katawhan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Magkalipay ang mga taga-Israel tungod sang ila Manunuga.","poem":1},{"text":"Magsinadya ang katawhan sang Zion","poem":2},{"noteId":347},{"text":"tungod sang ila Hari.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Magdayaw sila sa iya nga may pagsinaot;","poem":1},{"text":"kag magtukar sila sang tamborin kag mga arpa sa pagdayaw sa iya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kay nagakalipay ang Ginoo sa iya katawhan;","poem":1},{"text":"ginapadunggan niya sila nga mga kubos paagi sa pagpadaog sa ila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Magkalipay sila nga matutom sa iya tungod sang ila pagdaog;","poem":1},{"text":"magkanta sila sa kalipay bisan sa ila mga hiligdaan.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Magdayaw sila sing mabaskog sa Dios samtang nagauyat sila sang matalom nga mga espada,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"sa pagpanimalos kag pagsilot sa mga katawhan sang mga nasyon,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"sa pagkadena sang ila mga hari kag mga pangulo,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"sa pagsilot sa ila suno sa ginsugo sang Dios.","poem":1},{"text":"Ini para sa kadayawan sang tanan nga iya matutom nga katawhan.","poem":2},{"lineBreak":true},{"text":"Dayawa ang Ginoo!","poem":1}]}],"footnotes":[{"noteId":347,"caller":"+","text":"Zion: ukon, Jerusalem","reference":{"chapter":149,"verse":2}}]},"thisChapterLink":"/api/hil_bib/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hil_bib/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hil_bib/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}