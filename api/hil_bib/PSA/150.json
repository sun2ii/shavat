ontent":[{"text":"Dayawa ninyo siya paagi sa matunog nga mga cymbals.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ang tanan nga nagakabuhi magdayaw sa Ginoo.","poem":1},{"lineBreak":true},{"text":"Dayawa ang Ginoo!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hil_bib/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hil_bib/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hil_bib/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}