{"translation":{"id":"hil_bib","name":"Biblica® Libre Ang Pulong Sang Dios","website":"https://ebible.org/Scriptures/details.php?id=hil","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hil","licenseNotes":null,"shortName":"BIB","englishName":"Hiligaynon: Biblica® Libre Ang Pulong Sang Dios (Bible) for the Philippines","language":"hil","textDirection":"ltr","sha256":"233a28b58d03cfab3cff229e86d59ff82d50d35717469c7fcfb289eaa862d464","availableFormats":["json"],"listOfBooksApiLink":"/api/hil_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30334,"languageName":"Hiligaynon","languageEnglishName":"Hiligaynon"},"book":{"id":"PSA","translationId":"hil_bib","name":"Salmo","commonName":"Salmo","title":"Mga Salmo","order":19,"numberOfChapters":150,"sha256":"3542c42dbc82b8cc636f4c2811aa8f92b07f2602cb4f8bccbf2019b34b83a7a5","firstChapterNumber":1,"firstChapterApiLink":"/api/hil_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hil_bib/PSA/150.json","totalNumberOfVerses":2438},"chapter":{"number":3,"content":[{"type":"heading","content":["Pangamuyo sa Tion sang Katalagman"]},{"type":"hebrew_subtitle","content":["Ang kanta nga ginsulat ni David sang nagpalagyo siya sa iya anak nga si Absalom."]},{"type":"verse","number":1,"content":[{"text":"Ginoo, kadamo sang akon kaaway;","poem":1},{"text":"kadamo sang nagakontra sa akon!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nagasiling pa sila nga indi mo kuno ako pagluwason.","poem":1},{"noteId":4}]},{"type":"verse","number":3,"content":[{"text":"Pero ang matuod, pareho ka sa taming nga nagaprotektar sa akon.","poem":2},{"text":"Ginapadaog mo ako kontra sa akon mga kaaway,","poem":1},{"text":"kag ginapabakod mo ako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nagapanawag ako sa imo, Ginoo,","poem":1},{"text":"kag ginasabat mo ako sa imo balaan","poem":2},{"noteId":5},{"text":"nga bukid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kag tungod kay ginabantayan mo ako,","poem":1},{"text":"makatulog ako kag makamata pa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bisan linibo pa ka kaaway ang nagalibot sa akon,","poem":1},{"text":"indi ako mahadlok.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sige na Ginoo nga akon Dios, luwasa ako!","poem":1},{"text":"Kay sadto gani ginpakahuy-an mo","poem":2},{"noteId":6},{"text":"ang tanan ko nga kaaway nga malain;","poem":2},{"text":"ginkuha mo ang ila ikasarang sa paghalit sa akon.","poem":1},{"noteId":7}]},{"type":"verse","number":8,"content":[{"text":"Ikaw, Ginoo, ang nagaluwas","poem":2},{"lineBreak":true},{"text":"kag nagapakamaayo sa imo katawhan.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Sa Hebreo may sugpon pa nga “sela,” nga indi klaro ang buot silingon. Makita man ini sa bersikulo 4 kag 8.","reference":{"chapter":3,"verse":2}},{"noteId":5,"caller":"+","text":"balaan: ukon, pinili","reference":{"chapter":3,"verse":4}},{"noteId":6,"caller":"+","text":"ginpakahuy-an mo: sa literal, ginhampak mo sa sag-ang","reference":{"chapter":3,"verse":7}},{"noteId":7,"caller":"+","text":"ginkuha…akon: sa literal, ginbingaw mo ang ila mga ngipon","reference":{"chapter":3,"verse":7}}]},"thisChapterLink":"/api/hil_bib/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hil_bib/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hil_bib/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}