{"translation":{"id":"hil_bib","name":"Biblica® Libre Ang Pulong Sang Dios","website":"https://ebible.org/Scriptures/details.php?id=hil","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hil","licenseNotes":null,"shortName":"BIB","englishName":"Hiligaynon: Biblica® Libre Ang Pulong Sang Dios (Bible) for the Philippines","language":"hil","textDirection":"ltr","sha256":"233a28b58d03cfab3cff229e86d59ff82d50d35717469c7fcfb289eaa862d464","availableFormats":["json"],"listOfBooksApiLink":"/api/hil_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30334,"languageName":"Hiligaynon","languageEnglishName":"Hiligaynon"},"book":{"id":"PSA","translationId":"hil_bib","name":"Salmo","commonName":"Salmo","title":"Mga Salmo","order":19,"numberOfChapters":150,"sha256":"3542c42dbc82b8cc636f4c2811aa8f92b07f2602cb4f8bccbf2019b34b83a7a5","firstChapterNumber":1,"firstChapterApiLink":"/api/hil_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hil_bib/PSA/150.json","totalNumberOfVerses":2438},"chapter":{"number":93,"content":[{"type":"heading","content":["Ang Dios Aton Hari"]},{"type":"verse","number":1,"content":[{"text":"Hari ikaw, Ginoo;","poem":1},{"text":"ang imo pagkagamhanan kag pagkahalangdon amo ang imo harianon nga bayo.","poem":2},{"text":"Ginpahamtang mo sing mabakod ang kalibutan kag indi ini mauyog.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hari ka na halin pa sang una,","poem":1},{"text":"kay ara ka na sadto pa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nagadinaguhob ang dagat, Ginoo,","poem":1},{"text":"kag nagalinagumba ang mga balod.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pero mas gamhanan ka, Ginoo nga ara sa langit, sang sa dinaguhob sang dagat;","poem":1},{"text":"mas gamhanan ka sang sa mga balod sini.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ginoo, ang imo mga sugo masaligan gid","poem":1},{"text":"kag ang pagkabalaan amo ang nagapatahom sa imo templo hasta san-o.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hil_bib/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hil_bib/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hil_bib/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}