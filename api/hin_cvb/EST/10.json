{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"EST","translationId":"hin_cvb","name":"एस्तेर","commonName":"एस्तेर","title":"एस्तेर","order":17,"numberOfChapters":10,"sha256":"1c01b626c5914b7e98ea1c6773b24b48cbcd00287653be3fb3a86205681fd3d2","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/EST/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/hin_cvb/EST/10.json","totalNumberOfVerses":167},"chapter":{"number":10,"content":[{"type":"heading","content":["मोरदकय की ख्याति"]},{"type":"verse","number":1,"content":["राजा अहषवेरोष ने समस्त साम्राज्य पर, हां, दूरस्त सागर तट, टापू के क्षेत्रों तक कर लगा दिया."]},{"type":"verse","number":2,"content":["राजा के सभी उल्लेखनीय एवं वैभवशाली उपलब्धियों का विवरण एवं मोरदकय की महानता का पूर्ण वर्णन, जिस उदात्त पद पर राजा ने उसे नियुक्त किया था, उनका उल्लेख मेदिया एवं फारस के राजाओं के इतिहास के ग्रंथ में लिखा है."]},{"type":"verse","number":3,"content":["मात्र राजा अहषवेरोष ही पद में यहूदी मोरदकय से उच्चतर था. वह यहूदियों में अति आदरमान था तथा वह अपने जातियों में प्रिय था. वह सर्वदा प्रजा के लाभ का ही प्रयास करता, तथा समस्त राष्ट्र की भलाई के पक्ष में ही याचना करता था."]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/EST/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/JOB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/EST/9.json","previousChapterAudioLinks":{},"numberOfVerses":3}