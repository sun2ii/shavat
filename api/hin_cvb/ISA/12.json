{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"ISA","translationId":"hin_cvb","name":"यशायाह","commonName":"यशायाह","title":"यशायाह","order":23,"numberOfChapters":66,"sha256":"5bd8136c2568c6e063b45c28b000e88eb431b91850e71ef52fcd246398cf688f","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hin_cvb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["स्तुति के गीत"]},{"type":"verse","number":1,"content":["उस दिन तुम कहोगे:",{"text":"“याहवेह, मैं आपका आभार मानूंगा.","poem":1},{"text":"यद्यपि आप मुझसे क्रोधित थे,","poem":2},{"text":"अब आपका गुस्सा शांत हो गया","poem":1},{"text":"और आपने मुझे शांति दी है.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"परमेश्वर मेरे उद्धारकर्ता हैं;","poem":1},{"text":"मैं भरोसा रखूंगा और न डरूंगा.","poem":2},{"text":"क्योंकि याह, हां याहवेह ही, मेरा बल और मेरा गीत हैं;","poem":1},{"text":"वे मेरे उद्धारकर्ता हो गए हैं.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तुम उद्धार के स्रोतों से","poem":1},{"text":"आनंदपूर्वक जल भरोगे.","poem":2}]},{"type":"verse","number":4,"content":["उस दिन तुम कहोगे:",{"text":"“याहवेह की प्रशंसा करो, उनके नाम की दोहाई दो;","poem":1},{"text":"जनताओं में उनके कामों का प्रचार करो,","poem":2},{"lineBreak":true},{"text":"उन्हें यह याद दिलाओ कि प्रभु का नाम गौरवान्वित है.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"गीतों से याहवेह की स्तुति करो, क्योंकि उन्होंने प्रतापमय काम किए हैं;","poem":1},{"text":"और सारी पृथ्वी पर यह प्रकट हो जाए.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ज़ियोन के लोगों, ऊंचे स्वर से जय जयकार करो,","poem":1},{"text":"क्योंकि इस्राएल के पवित्र परमेश्वर तुम्हारे साथ हैं.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}