{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"ISA","translationId":"hin_cvb","name":"यशायाह","commonName":"यशायाह","title":"यशायाह","order":23,"numberOfChapters":66,"sha256":"5bd8136c2568c6e063b45c28b000e88eb431b91850e71ef52fcd246398cf688f","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hin_cvb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"उस दिन सात स्त्रियां","poem":1},{"text":"एक पुरुष को रोक कर","poem":2},{"text":"कहेंगी, “हम अपने भोजन","poem":1},{"text":"और वस्त्रों की व्यवस्था स्वयं कर लेंगी;","poem":2},{"text":"सिर्फ हमें अपना नाम दे दो.","poem":1},{"text":"और हमारा तिरस्कार दूर कर दो!”","poem":2}]},{"type":"heading","content":["याहवेह की शाखा"]},{"type":"verse","number":2,"content":["उस दिन याहवेह की मनोहरता भूषण और महिमा ठहरेगी और बचे हुओं के लिए भूमि की उपज गर्व और सम्मान का विषय होगी."]},{"type":"verse","number":3,"content":["ज़ियोन के बचे हुए और येरूशलेम में, वे जो बच गए हैं, वे पवित्र कहलाएंगे, जिनका नाम जीवन की पुस्तक में लिखा गया है."]},{"type":"verse","number":4,"content":["जब प्रभु न्याय और भस्म करनेवाली आत्मा के द्वारा ज़ियोन की पुत्रियों की गंदगी धो देंगे और खून से भरे हुए येरूशलेम को दूर कर देंगे."]},{"type":"verse","number":5,"content":["तब याहवेह ज़ियोन पर्वत और सभी लोगों पर दिन के समय धुएं का बादल तथा रात में तेज आग की रोशनी दिखाएगा और इन सबके ऊपर याहवेह का तेज मंडराता रहेगा."]},{"type":"verse","number":6,"content":["दिन की उष्णता, आंधी, पानी और हवा से बचने के लिये आड़ बनकर सुरक्षित रहे."]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/ISA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/ISA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/ISA/3.json","previousChapterAudioLinks":{},"numberOfVerses":6}