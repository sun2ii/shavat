{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"JOB","translationId":"hin_cvb","name":"अय्योब","commonName":"अय्योब","title":"अय्योब","order":18,"numberOfChapters":42,"sha256":"c4302e191ea9e48ed5beb56aad3cf6eb2d01c96597190f8264598d88ad42511b","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hin_cvb/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":25,"content":[{"type":"heading","content":["परमेश्वर की सामर्थ्य का स्तवन"]},{"type":"verse","number":1,"content":["तब बिलदद ने, जो शूही था, अपना मत देना प्रारंभ किया:"]},{"type":"verse","number":2,"content":[{"text":"“प्रभुत्व एवं अतिशय सम्मान के अधिकारी परमेश्वर ही हैं;","poem":1},{"text":"वही सर्वोच्च स्वर्ग में व्यवस्था की स्थापना करते हैं.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"क्या परमेश्वर की सेना गण्य है?","poem":1},{"text":"कौन है, जो उनके प्रकाश से अछूता रह सका है?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तब क्या मनुष्य परमेश्वर के सामने युक्त प्रमाणित हो सकता है?","poem":1},{"text":"अथवा नारी से जन्मे किसी को भी शुद्ध कहा जा सकता है?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"यदि परमेश्वर के सामने चंद्रमा प्रकाशमान नहीं है","poem":1},{"text":"तथा तारों में कोई शुद्धता नहीं है,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तब मनुष्य क्या है, जो मात्र एक कीड़ा है,","poem":1},{"text":"मानव प्राणी, जो मात्र एक केंचुआ ही है!”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}