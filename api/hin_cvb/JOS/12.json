{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"JOS","translationId":"hin_cvb","name":"यहोशू","commonName":"यहोशू","title":"यहोशू","order":6,"numberOfChapters":24,"sha256":"cbb9bfc328f8e446fd129cef8b345e066aa7471bc15b69fcc56d9cf8f40695a0","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/JOS/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/hin_cvb/JOS/24.json","totalNumberOfVerses":656},"chapter":{"number":12,"content":[{"type":"heading","content":["इस्राएल द्वारा पराजित राजा"]},{"type":"verse","number":1,"content":["ये हैं जो राजा यरदन के पूर्व अराबाह में थे, जिनको इस्राएलियों ने मारकर उनकी भूमि ली, इन राज्यों की सीमा आरनोन घाटी से लेकर हरमोन पर्वत तक तथा पूरे यरदन घाटी तक थी:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["सीहोन अमोरियों का राजा था, जिसका मुख्यालय हेशबोन में था. उसका शासन आरनोन घाटी से लेकर अम्मोनियों के देश के यब्बोक नदी तक फैला था. इसमें घाटी के बीच से गिलआद का आधा भाग शामिल था."]},{"type":"verse","number":3,"content":["उसका शासन पूर्व अराबाह प्रदेश जो किन्‍नेरेथ झील",{"noteId":5},"से अराबाह सागर",{"noteId":6},"तक, और पूर्व में बेथ-यशिमोथ तक तथा, दक्षिण में पिसगाह की ढलानों की तराई तक फैला था."]},{"type":"verse","number":4,"content":["ओग बाशान का राजा जो रेफाइम में बचे हुए लोगों में से एक था. वह अश्तारोथ तथा एद्रेइ से शासन करता था."]},{"type":"verse","number":5,"content":["उसके शासन का क्षेत्र हरमोन पर्वत, सलेकाह, गेशूरियों तथा माकाहथियों की सीमा तक पूरा बाशान तथा गिलआद का आधा क्षेत्र था, जो हेशबोन के राजा सीहोन की सीमा तक फैला था."]},{"type":"line_break"},{"type":"verse","number":6,"content":["मोशेह, याहवेह के सेवक तथा इस्राएल वंश ने उन्हें हरा दिया तथा याहवेह के सेवक, मोशेह ने ये क्षेत्र रियूबेन, गाद तथा मनश्शेह के आधे गोत्र को निज भाग में दे दिया."]},{"type":"line_break"},{"type":"verse","number":7,"content":["यरदन के पश्चिम में जो ज़मीन है, वो लबानोन घाटी में, बाल-गाद से लेकर सेईर में हालाक पर्वत तक के देश हैं, जिनके राजाओं को यहोशू एवं इस्राएलियों ने मार दिया था, और यहोशू ने उस भाग को इस्राएली गोत्रों में बाट दिया."]},{"type":"verse","number":8,"content":["इस भाग में पर्वतीय क्षेत्र, तराइयां, अराबाह, ढलानें, निर्जन प्रदेश तथा नेगेव और इस क्षेत्र के मूल निवासी हित्ती, अमोरी, कनानी, परिज्ज़ी, हिव्वी तथा यबूसी:",{"lineBreak":true},"मारे गये राजा ये थे:"]},{"type":"line_break"},{"type":"verse","number":9,"content":["येरीख़ो का राजाएकबेथेल का निकटवर्ती अय का राजाएक"]},{"type":"verse","number":10,"content":["येरूशलेम का राजाएकहेब्रोन का राजाएक"]},{"type":"verse","number":11,"content":["यरमूथ का राजाएकलाकीश का राजाएक"]},{"type":"verse","number":12,"content":["एगलोन का राजाएकगेज़ेर का राजाएक"]},{"type":"verse","number":13,"content":["दबीर का राजाएकगेदेर का राजाएक"]},{"type":"verse","number":14,"content":["होरमाह का राजाएकअराद का राजाएक"]},{"type":"verse","number":15,"content":["लिबनाह का राजाएकअदुल्लाम का राजाएक"]},{"type":"verse","number":16,"content":["मक्‍केदा का राजाएकबेथेल का राजाएक"]},{"type":"verse","number":17,"content":["तप्पूआह का राजाएकहेफेर का राजाएक"]},{"type":"verse","number":18,"content":["अफेक का राजाएकशारोन",{"noteId":7},"का राजाएक"]},{"type":"verse","number":19,"content":["मादोन का राजाएकहाज़ोर का राजाएक"]},{"type":"verse","number":20,"content":["शिमरोन-मरोन का राजाएकअकशाफ का राजाएक"]},{"type":"verse","number":21,"content":["तानख का राजाएकमगिद्दो का राजाएक"]},{"type":"verse","number":22,"content":["केदेश का राजाएककर्मेल के योकनआम का राजाएक"]},{"type":"verse","number":23,"content":["नाफ़ात-दोर में दोर का राजाएकगिलगाल में गोयिम का राजाएक"]},{"type":"verse","number":24,"content":["तथा तिरज़ाह के राजाएक",{"lineBreak":true},"ये पूरे एकतीस राजा थे."]}],"footnotes":[{"noteId":5,"caller":"+","text":"किन्‍नेरेथ झील यानी गलील झील","reference":{"chapter":12,"verse":3}},{"noteId":6,"caller":"+","text":"अराबाह सागर यानी मृत सागर","reference":{"chapter":12,"verse":3}},{"noteId":7,"caller":"+","text":"शारोन या लशारोन","reference":{"chapter":12,"verse":18}}]},"thisChapterLink":"/api/hin_cvb/JOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/JOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/JOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":24}