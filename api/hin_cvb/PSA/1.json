{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"कैसा धन्य है वह पुरुष","poem":1},{"text":"जो दुष्टों की सम्मति का आचरण नहीं करता,","poem":2},{"text":"न पापियों के मार्ग पर खड़ा रहता","poem":1},{"text":"और न ही उपहास करनेवालों की बैठक में बैठता है,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"इसके विपरीत उसका उल्लास याहवेह की व्यवस्था का पालन करने में है,","poem":1},{"text":"उसी का मनन वह दिन-रात करता रहता है.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"वह बहती जलधाराओं के तट पर लगाए गए उस वृक्ष के समान है,","poem":1},{"text":"जो उपयुक्त ऋतु में फल देता है","poem":2},{"text":"जिसकी पत्तियां कभी मुरझाती नहीं.","poem":1},{"text":"ऐसा पुरुष जो कुछ करता है उसमें सफल होता है.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"किंतु दुष्ट ऐसे नहीं होते!","poem":1},{"text":"वे उस भूसे के समान होते हैं,","poem":2},{"lineBreak":true},{"text":"जिसे पवन उड़ा ले जाती है.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तब दुष्ट न्याय में टिक नहीं पाएंगे,","poem":1},{"text":"और न ही पापी धर्मियों के मण्डली में.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"निश्चयतः याहवेह धर्मियों के आचरण को सुख समृद्धि से सम्पन्‍न करते हैं,","poem":1},{"text":"किंतु दुष्टों को उनका आचरण ही नष्ट कर डालेगा.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}