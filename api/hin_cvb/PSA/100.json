{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":100,"content":[{"type":"hebrew_subtitle","content":["एक स्तोत्र. धन्यवाद के लिए गीत"]},{"type":"verse","number":1,"content":[{"text":"याहवेह के स्तवन में समस्त पृथ्वी उच्च स्वर में जयघोष करे.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"याहवेह की आराधना आनंदपूर्वक की जाए;","poem":2},{"lineBreak":true},{"text":"हर्ष गीत गाते हुए उनकी उपस्थिति में प्रवेश किया जाए.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"यह समझ लो कि स्वयं याहवेह ही परमेश्वर हैं.","poem":1},{"text":"हमारी रचना उन्हीं ने की है, स्वयं हमने नहीं; हम पर उन्हीं का स्वामित्व है.","poem":2},{"lineBreak":true},{"text":"हम उनकी प्रजा, उनकी चराई की भेड़ें हैं.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"धन्यवाद के भाव में उनके द्वारों में","poem":1},{"text":"और स्तवन भाव में उनके आंगनों में प्रवेश करो;","poem":2},{"lineBreak":true},{"text":"उनकी महिमा को धन्य कहो.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"याहवेह भले हैं; उनकी करुणा सदा की है;","poem":1},{"text":"उनकी सच्चाई का प्रसरण समस्त पीढ़ियों में होता जाता है.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}