{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["दावीद की रचना. एक स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"मेरे गीत का विषय है आपका करुणा-प्रेम तथा आपका न्याय;","poem":1},{"text":"याहवेह, मैं आपका स्तवन करूंगा.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"निष्कलंक जीवन मेरा लक्ष्य है,","poem":1},{"text":"आप कब मेरे पास आएंगे?","poem":2},{"lineBreak":true},{"text":"अपने आवास में मेरा आचरण","poem":1},{"text":"निष्कलंक रहेगा.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"मैं किसी भी अनुचित वस्तु की","poem":1},{"text":"ओर दृष्टि न उठाऊंगा.","poem":2},{"lineBreak":true},{"text":"मुझे घृणा है भ्रष्टाचारी पुरुषों के आचार-व्यवहार से;","poem":1},{"text":"मैं उनसे कोई संबंध नहीं रखूंगा.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"कुटिल हृदय मुझसे दूर रहेगा;","poem":1},{"text":"बुराई से मेरा कोई संबंध न होगा.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"जो कोई गुप्‍त में अपने पड़ोसी की निंदा करता है,","poem":1},{"text":"मैं उसे नष्ट कर दूंगा;","poem":2},{"text":"जिस किसी की आंखें अहंकार से चढ़ी हुई हैं तथा जिसका हृदय घमंडी है,","poem":1},{"text":"वह मेरे लिए असह्य होगा.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"पृथ्वी पर मेरी दृष्टि उन्हीं पर रहेगी जो विश्वासयोग्य हैं,","poem":1},{"text":"कि वे मेरे साथ निवास कर सकें;","poem":2},{"text":"मेरा सेवक वही होगा,","poem":1},{"text":"जिसका आचरण निष्कलंक है.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"किसी भी झूठों का निवास","poem":1},{"text":"मेरे आवास में न होगा,","poem":2},{"text":"कोई भी झूठ बोलने वाला,","poem":1},{"text":"मेरी उपस्थिति में ठहर न सकेगा.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"प्रति प्रभात मैं अपने राज्य के","poem":1},{"text":"समस्त दुर्जनों को नष्ट करूंगा;","poem":2},{"text":"याहवेह के नगर में से","poem":1},{"text":"मैं हर एक दुष्ट को मिटा दूंगा.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}