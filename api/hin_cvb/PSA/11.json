{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["संगीत निर्देशक के लिये. दावीद की रचना"]},{"type":"verse","number":1,"content":[{"text":"मैंने याहवेह में आश्रय लिया है,","poem":1},{"text":"फिर तुम मुझसे यह क्यों कह रहे हो:","poem":2},{"lineBreak":true},{"text":"“पंछी के समान अपने पर्वत को उड़ जा.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"सावधान! दुष्ट ने अपना धनुष साध लिया है;","poem":1},{"text":"और उसने धनुष पर बाण भी चढ़ा लिया है,","poem":2},{"text":"कि अंधकार में","poem":1},{"text":"सीधे लोगों की हत्या कर दे.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"यदि आधार ही नष्ट हो जाए,","poem":1},{"text":"तो धर्मी के पास कौन सा विकल्प शेष रह जाता है?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"याहवेह अपने पवित्र मंदिर में हैं;","poem":1},{"text":"उनका सिंहासन स्वर्ग में बसा है.","poem":2},{"text":"उनकी दृष्टि सर्वत्र मनुष्यों को देखती है;","poem":1},{"text":"उनकी सूक्ष्मदृष्टि हर एक को परखती रहती है.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"याहवेह की दृष्टि धर्मी एवं दुष्ट दोनों को परखती है,","poem":1},{"text":"याहवेह के आत्मा हिंसा","poem":2},{"lineBreak":true},{"text":"प्रिय पुरुषों से घृणा करते हैं.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"दुष्टों पर वह फन्दों की वृष्टि करेंगे,","poem":1},{"text":"उनके प्याले में उनका अंश होगा अग्नि;","poem":2},{"lineBreak":true},{"text":"गंधक तथा प्रचंड हवा.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"याहवेह युक्त हैं,","poem":1},{"text":"धर्मी ही उन्हें प्रिय हैं;","poem":2},{"lineBreak":true},{"text":"धर्मी जन उनका मुंह देखने पाएंगे.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}