{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["दावीद की रचना. एक स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"याहवेह मेरे प्रभु ने, राजा से कहा:","poem":1},{"lineBreak":true},{"text":"“मेरे दायें पक्ष में विराजमान हो जाओ.","poem":1},{"text":"तुम्हारे शत्रुओं को मैं","poem":2},{"lineBreak":true},{"text":"तुम्हारे चरणों की चौकी बना रहा हूं.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"याहवेह ही ज़ियोन से आपके सामर्थ्यवान राजदंड का विस्तार करेंगे,","poem":1},{"text":"“आपका शासन आपके शत्रुओं के मध्य बसा होगा!”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"आपकी सेना आपकी लड़ाई के समय","poem":1},{"text":"स्वेच्छा से आपका साथ देगी,","poem":2},{"text":"सबेरे के गर्भ से जन्मी हुई ओस के समान","poem":1},{"text":"पवित्रता से सुशोभित होकर","poem":2},{"lineBreak":true},{"text":"आपके पास आएंगे आपके जवान.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"यह याहवेह की शपथ है,","poem":1},{"text":"जो अपने वक्तव्य से दूर नहीं होते:","poem":2},{"text":"“तुम मेलखीज़ेदेक की शृंखला","poem":1},{"text":"में सनातन पुरोहित हो.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"प्रभु आपके दायें पक्ष में तत्पर हैं;","poem":1},{"text":"वह उदास होकर राजाओं को कुचल डालेंगे.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"वह राष्ट्रों पर अपने न्याय का निर्णय घोषित करेंगे,","poem":1},{"text":"मृतकों का ढेर लग जाएगा और संपूर्ण पृथ्वी के न्यायियों की हत्या कर दी जाएगी.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तब महाराज मार्ग के किनारे के झरने से जल का पान करेंगे,","poem":1},{"text":"उनका सिर गर्व से ऊंचा होगा.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}