{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेह का स्तवन हो.","poem":1},{"lineBreak":true},{"text":"मैं संपूर्ण हृदय से याहवेह का स्तवन करूंगा,","poem":1},{"text":"सीधे मनवालों की समिति और सभा में.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"अति उदात्त हैं याहवेह के कृत्य;","poem":1},{"text":"वे उनकी प्रसन्‍नता का कारण हैं, जो इनको मनन करते हैं.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"महिमामय और भव्य हैं याहवेह के ये कृत्य,","poem":1},{"text":"उनकी धार्मिकता सर्वदा है.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"याहवेह ने अपने इन कृत्यों को अविस्मरणीय बना दिया है;","poem":1},{"text":"वह उदार एवं कृपालु हैं.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"अपने श्रद्धालुओं के लिए वह आहार का प्रबंध करते हैं;","poem":1},{"text":"वह अपनी वाचा सदा-सर्वदा स्मरण रखते हैं.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"उन्होंने अपनी प्रजा पर इन कृत्यों की सामर्थ्य प्रकट कर दी,","poem":1},{"text":"जब उन्होंने उन्हें अन्य राष्ट्रों की भूमि प्रदान की.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"उनके द्वारा निष्पन्‍न समस्त कार्य विश्वासयोग्य और न्याय के हैं;","poem":1},{"text":"विश्वासयोग्य हैं उनके सभी उपदेश.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"वे सदा-सर्वदा के लिए अटल हैं,","poem":1},{"text":"कि इनका पालन सच्चाई एवं न्याय में किया जाए.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"याहवेह ने अपनी प्रजा का उद्धार किया;","poem":1},{"text":"उन्होंने अपनी वाचा सदा-सर्वदा के लिए स्थापित कर दी है.","poem":2},{"lineBreak":true},{"text":"उनका नाम सबसे अलग तथा पवित्र और भय-योग्य है.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"याहवेह के प्रति श्रद्धा बुद्धि का मूल है;","poem":1},{"text":"उन सभी में, जो इसे मानते हैं, उत्तम समझ रहते है.","poem":2},{"lineBreak":true},{"text":"याहवेह ही हैं सर्वदा वंदना के योग्य.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}