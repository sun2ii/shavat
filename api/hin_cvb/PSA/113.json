{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेह का स्तवन हो.","poem":1},{"lineBreak":true},{"text":"याहवेह के सेवको, स्तवन करो;","poem":1},{"text":"याहवेह की महिमा का स्तवन करो.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"आज से सदा-सर्वदा","poem":1},{"text":"याहवेह के नाम का स्तवन होता रहे.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"उपयुक्त है कि सूर्योदय से सूर्यास्त के क्षण तक,","poem":1},{"text":"याहवेह के नाम का स्तवन हो.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"याहवेह समस्त राष्ट्रों के ऊपर हैं,","poem":1},{"text":"उनका तेज स्वर्ग से भी महान है.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"और कौन है याहवेह हमारे परमेश्वर के तुल्य,","poem":1},{"text":"जो सर्वोच्च सिंहासन पर विराजमान हैं,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"जिन्हें स्वर्ग एवं पृथ्वी को देखने के लिए","poem":1},{"text":"झुककर दृष्टिपात करना पड़ता है?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"याहवेह ही कंगाल को धूलि से उठाकर बसाते हैं,","poem":1},{"text":"वही दरिद्र को राख के ढेर से उठाकर ऊंचा करते हैं.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"वही उन्हें प्रधानों के साथ लाकर,","poem":1},{"text":"अपनी प्रजा के प्रधानों के साथ विराजमान करते हैं.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"वही बांझ स्त्री को बच्चों की माता का आनंद प्रदान करके","poem":1},{"text":"परिवार में सम्मान प्रदान करते हैं.","poem":2},{"lineBreak":true},{"text":"याहवेह का स्तवन हो.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}