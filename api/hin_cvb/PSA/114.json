{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"जब इस्राएली मिस्र देश से बाहर आए,","poem":1},{"text":"जब याकोब के वंशज विदेशी भाषा-भाषी देश से बाहर आए,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तब यहूदिया उनका पवित्र स्थान","poem":1},{"text":"और इस्राएल प्रदेश उनका शासित राष्ट्र हो गया.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"यह देख समुद्र पलायन कर गया,","poem":1},{"text":"और यरदन नदी विपरीत दिशा में प्रवाहित होने लगी;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"पर्वत मेढ़ों के तथा पहाड़ियां मेमनों के समान,","poem":1},{"text":"छलांग लगाने लगीं.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"समुद्र, यह बताओ, तुमने पलायन क्यों किया?","poem":1},{"text":"और यरदन, तुम्हें उलटा क्यों बहना पड़ा?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"पर्वतो, तुम मेढ़ों के समान तथा पहाड़ियो,","poem":1},{"text":"तुम मेमनों के समान छलांगें क्यों लगाने लगे?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"पृथ्वी, तुम याहवेह की उपस्थिति में थरथराओ,","poem":1},{"text":"याकोब के परमेश्वर की उपस्थिति में,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"जिन्होंने चट्टान को ताल में बदल दिया,","poem":1},{"text":"और उस कठोर पत्थर को जल के सोते में.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}