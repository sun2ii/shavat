{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":12,"content":[{"type":"hebrew_subtitle","content":["संगीत निर्देशक के लिये. शेमिनिथ",{"noteId":4},"पर आधारित. दावीद का एक स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"याहवेह, हमारी रक्षा कीजिए, कोई भक्त अब शेष न रहा;","poem":1},{"text":"मनुष्यों के मध्य से विश्वासयोग्य पुरुष नहीं रहे.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"मनुष्य मनुष्य से झूठी बातें कर रहा है;","poem":1},{"text":"वे चापलूसी करते हुए","poem":2},{"lineBreak":true},{"text":"एक दूसरे का छल करते हैं.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"अच्छा होगा यदि याहवेह चापलूसी होंठों","poem":1},{"text":"तथा घमंडी जीभ को काट डालें.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"वे डींग मारते हुए कहते हैं,","poem":1},{"text":"“शक्ति हमारी जीभ में मगन है;","poem":2},{"lineBreak":true},{"text":"ओंठ हमारे वश में हैं. कौन हो सकता है हमारा स्वामी?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"किंतु अब याहवेह का कहना है, “दुःखितों के प्रति की गई हिंसा के कारण,","poem":1},{"text":"निर्धनों की करुण वाणी के कारण मैं उनके पक्ष में उठ खड़ा होऊंगा.","poem":2},{"lineBreak":true},{"text":"मैं उन्हें वही सुरक्षा प्रदान करूंगा, वे जिसकी कामना कर रहे हैं.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"याहवेह का वचन शुद्ध है,","poem":1},{"text":"उस चांदी-समान हैं,","poem":2},{"lineBreak":true},{"text":"जिसे भट्टी में सात बार तपा कर शुद्ध किया गया है.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"याहवेह, उन्हें अपनी सुरक्षा में बनाए रखेंगे","poem":1},{"text":"उन्हें इस पीढ़ी से सर्वदा सुरक्षा प्रदान करेंगे,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"जब मनुष्यों द्वारा नीचता का आदर किया जाता है,","poem":1},{"text":"तब दुष्ट चारों और अकड़ कर चलते फिरते हैं.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"शीर्षक: शायद संगीत संबंधित एक शब्द","reference":{"chapter":12,"verse":0}}]},"thisChapterLink":"/api/hin_cvb/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}