{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":120,"content":[{"type":"hebrew_subtitle","content":["आराधना के लिए यात्रियों का गीत."]},{"type":"verse","number":1,"content":[{"text":"मैंने अपनी पीड़ा में याहवेह को पुकारा,","poem":1},{"text":"और उन्होंने मेरी सुन ली.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"याहवेह, मेरी रक्षा कीजिए,","poem":1},{"text":"झूठ बोलनेवाले होंठों से,","poem":2},{"lineBreak":true},{"text":"और छली जीभ से!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"तुम्हारे साथ परमेश्वर क्या करेंगे,","poem":1},{"text":"और उसके भी अतिरिक्त और क्या करेंगे,","poem":2},{"lineBreak":true},{"text":"ओ छली जीभ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"वह तुझे योद्धा के तीक्ष्ण बाणों से दंड देंगे,","poem":1},{"text":"वह तुझे वृक्ष की लकड़ी के प्रज्वलित कोयलों से दंड देंगे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"धिक्कार है मुझ पर, जो मैं मेशेख देश में जा निवास करूं,","poem":1},{"text":"जो मैं केदार देश के मण्डपों में जा रहूं!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"बहुत समय मैंने उनके साथ व्यतीत की है,","poem":1},{"text":"जिन्हें शांति से घृणा हैं.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"मैं खड़ा शांति प्रिय पुरुष;","poem":1},{"text":"किंतु जब मैं कुछ कहता हूं, वे युद्ध पर उतारू हो जाते हैं.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}