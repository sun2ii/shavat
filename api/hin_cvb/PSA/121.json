{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":121,"content":[{"type":"hebrew_subtitle","content":["आराधना के लिए यात्रियों का गीत."]},{"type":"verse","number":1,"content":[{"text":"मैं अपनी आंखें पर्वतों की ओर उठाता—","poem":1},{"text":"क्या मेरी सहायता का स्रोत वहां है?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"मेरी सहायता का स्रोत तो याहवेह हैं,","poem":1},{"text":"स्वर्ग और पृथ्वी के कर्ता.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"वह तुम्हारा पैर फिसलने न देंगे;","poem":1},{"text":"वह, जो तुम्हें सुरक्षित रखते हैं, झपकी नहीं लेते.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"निश्चयतः इस्राएल के रक्षक न तो झपकी लेंगे","poem":1},{"text":"और न सो जाएंगे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"याहवेह तुम्हें सुरक्षित रखते हैं—","poem":1},{"text":"तुम्हारे दायें पक्ष में उपस्थित याहवेह तुम्हारी सुरक्षा की छाया हैं;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"न तो दिन के समय सूर्य से तुम्हारी कोई हानि होगी,","poem":1},{"text":"और न रात्रि में चंद्रमा से.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"सभी प्रकार की बुराई से याहवेह तुम्हारी रक्षा करेंगे,","poem":1},{"text":"वह तुम्हारे जीवन की रक्षा करेंगे;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तुम्हारे आने जाने में याहवेह तुम्हें सुरक्षित रखेंगे,","poem":1},{"text":"वर्तमान में और सदा-सर्वदा.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}