{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["आराधना के लिए यात्रियों का गीत. दावीद की रचना."]},{"type":"verse","number":1,"content":[{"text":"जब यात्रियों ने मेरे सामने यह प्रस्ताव रखा,","poem":1},{"text":"“चलो, याहवेह के आवास को चलें,” मैं अत्यंत उल्‍लसित हुआ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"येरूशलेम, हम तुम्हारे द्वार पर","poem":1},{"text":"खड़े हुए हैं.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"येरूशलेम उस नगर के समान निर्मित है,","poem":1},{"text":"जो संगठित रूप में बसा हुआ है.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"यही है वह स्थान, जहां विभिन्‍न कुल,","poem":1},{"text":"याहवेह के कुल,","poem":2},{"text":"याहवेह के नाम के प्रति आभार प्रदर्शित करने के लिए जाया करते हैं","poem":1},{"text":"जैसा कि उन्हें आदेश दिया गया था.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"यहीं न्याय-सिंहासन स्थापित हैं,","poem":1},{"text":"दावीद के वंश के सिंहासन.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"येरूशलेम की शांति के निमित्त यह प्रार्थना की जाए:","poem":1},{"text":"“समृद्ध हों वे, जिन्हें तुझसे प्रेम है.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तुम्हारी प्राचीरों की सीमा के भीतर शांति व्याप्‍त रहे","poem":1},{"text":"तथा तुम्हारे राजमहलों में तुम्हारे लिए सुरक्षा बनी रहें.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"अपने भाइयों और मित्रों के निमित्त मेरी यही कामना है,","poem":1},{"text":"“तुम्हारे मध्य शांति स्थिर रहे.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"याहवेह, हमारे परमेश्वर के भवन के निमित्त,","poem":1},{"text":"मैं तुम्हारी समृद्धि की अभिलाषा करता हूं.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}