{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":124,"content":[{"type":"hebrew_subtitle","content":["आराधना के लिए यात्रियों का गीत. दावीद की रचना."]},{"type":"verse","number":1,"content":[{"text":"यदि हमारे पक्ष में याहवेह न होते—","poem":1},{"text":"इस्राएली राष्ट्र यही कहे—","poem":2}]},{"type":"verse","number":2,"content":[{"text":"यदि हमारे पक्ष में याहवेह न होते","poem":1},{"text":"जब मनुष्यों ने हम पर आक्रमण किया था,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"जब उनका क्रोध हम पर भड़क उठा था","poem":1},{"text":"वे हमें जीवित ही निगल गए होते;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"बाढ़ ने हमें जलमग्न कर दिया होता,","poem":1},{"text":"जल प्रवाह हमें बहा ले गया होता,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"उग्र जल प्रवाह","poem":1},{"text":"हमें दूर बहा ले गया होता.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"स्तवन हो याहवेह का,","poem":1},{"text":"जिन्होंने हमें उनके दांतों से फाड़े जाने से बचा लिया है.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"हम उस पक्षी के समान हैं,","poem":1},{"text":"जो बहेलिए के जाल से बच निकला है;","poem":2},{"text":"वह जाल टूट गया,","poem":1},{"text":"और हम बच निकले.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"हमारी सहायता याहवेह के नाम से है,","poem":1},{"text":"जो स्वर्ग और पृथ्वी के कर्ता हैं.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}