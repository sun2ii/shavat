{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":125,"content":[{"type":"hebrew_subtitle","content":["आराधना के लिए यात्रियों का गीत."]},{"type":"verse","number":1,"content":[{"text":"जिन्होंने याहवेह पर भरोसा किया है, वे ज़ियोन पर्वत समान हैं,","poem":1},{"text":"जिसे हिलाया नहीं जा सकता, जो सदा-सर्वदा स्थायी है.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"जिस प्रकार पर्वतों ने येरूशलेम को घेरा हुआ है,","poem":1},{"text":"उसी प्रकार याहवेह भी अपनी प्रजा को घेरे हुए हैं","poem":2},{"lineBreak":true},{"text":"आज भी और सदा-सर्वदा.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"धर्मियों को आवंटित भूमि पर","poem":1},{"text":"दुष्टों का राजदंड स्थायी न रहेगा,","poem":2},{"text":"कहीं ऐसा न हो कि धर्मियों के हाथ","poem":1},{"text":"बुराई की ओर बढ़ जाएं.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"याहवेह, धर्मियों का कल्याण कीजिए,","poem":1},{"text":"उनका, जिनके हृदय निष्ठ हैं.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"उन्हें, जो दुष्टता के मार्ग की ओर मुड़ जाते हैं,","poem":1},{"text":"याहवेह उन्हें दुष्टों के साथ काट देंगे.","poem":2},{"lineBreak":true},{"text":"इस्राएल राष्ट्र में शांति व्याप्‍त हो.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}