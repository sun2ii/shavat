{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":127,"content":[{"type":"hebrew_subtitle","content":["आराधना के लिए यात्रियों का गीत. शलोमोन की रचना."]},{"type":"verse","number":1,"content":[{"text":"यदि गृह-निर्माण याहवेह द्वारा न किया गया हो तो,","poem":1},{"text":"श्रमिकों का परिश्रम निरर्थक होता है.","poem":2},{"text":"यदि नगर की सुरक्षा याहवेह न करें,","poem":1},{"text":"तो रखवाले द्वारा की गई चौकसी व्यर्थ होती है.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तुम्हारा सुबह जाग उठना","poem":1},{"text":"देर तक जागे रहना,","poem":2},{"text":"संकटपूर्ण श्रम का भोजन करना व्यर्थ है;","poem":1},{"text":"क्योंकि याहवेह द्वारा नींद का अनुदान उनके लिए है, जिनसे वह प्रेम करते हैं.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"संतान याहवेह के दिए हुए निज भाग होते हैं,","poem":1},{"text":"तथा बालक उनका दिया हुआ उपहार.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"युवावस्था में उत्पन्‍न हुई संतान वैसी ही होती है,","poem":1},{"text":"जैसे योद्धा के हाथों में बाण.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"कैसा धन्य होता है वह पुरुष,","poem":1},{"text":"जिसका तरकश इन बाणों से भरा हुआ है!","poem":2},{"text":"नगर द्वार पर शत्रुओं का प्रतिकार करते हुए","poem":1},{"text":"उन्हें लज्जित नहीं होना पड़ेगा.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}