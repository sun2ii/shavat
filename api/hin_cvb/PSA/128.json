{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":128,"content":[{"type":"hebrew_subtitle","content":["आराधना के लिए यात्रियों का गीत."]},{"type":"verse","number":1,"content":[{"text":"वे सभी धन्य हैं, जिनमें याहवेह के प्रति श्रद्धा पायी जाती है,","poem":1},{"text":"जो उनकी नीतियों का आचरण करते हैं.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"जिसके लिए तुम अपने हाथों से श्रम करते रहे हो, तुम्हें उसका प्रतिफल प्राप्‍त होगा;","poem":1},{"text":"तुम धन्य होगे और कल्याण होगा तुम्हारा.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तुम्हारे परिवार में","poem":1},{"text":"तुम्हारी पत्नी फलदायी दाखलता समान होगी;","poem":2},{"text":"तुम्हारी मेज़ के चारों","poem":1},{"text":"ओर तुम्हारी संतान जैतून के अंकुर समान होगी.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"धन्य होता है वह जिसमें याहवेह के","poem":1},{"text":"प्रति श्रद्धा पाई जाती है.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ज़ियोन से याहवेह तुमको तुम्हारे जीवन","poem":1},{"text":"के हर एक दिन आशीषों से भरते रहें,","poem":2},{"lineBreak":true},{"text":"तुम आजीवन येरूशलेम की समृद्धि देखो.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"वस्तुतः, तुम अपनी संतान की भी संतान देखने के लिए जीवित रहो.","poem":1},{"text":"इस्राएल राष्ट्र में शांति स्थिर रहे.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}