{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":129,"content":[{"type":"hebrew_subtitle","content":["आराधना के लिए यात्रियों का गीत."]},{"type":"verse","number":1,"content":[{"text":"“मेरे बचपन से वे मुझ पर घोर अत्याचार करते आए हैं,”","poem":1},{"text":"इस्राएल राष्ट्र यही कहे;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“मेरे बचपन से वे मुझ पर घोर अत्याचार करते आए हैं,","poem":1},{"text":"किंतु वे मुझ पर प्रबल न हो सके हैं.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"हल चलानेवालों ने मेरे पीठ पर हल चलाया है,","poem":1},{"text":"और लम्बी-लम्बी हल रेखाएं खींच दी हैं.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"किंतु याहवेह युक्त है;","poem":1},{"text":"उन्हीं ने मुझे दुष्टों के बंधनों से मुक्त किया है.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"वे सभी, जिन्हें ज़ियोन से बैर है,","poem":1},{"text":"लज्जित हो लौट जाएं.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"उनकी नियति भी वही हो, जो घर की छत पर उग आई घास की होती है,","poem":1},{"text":"वह विकसित होने के पूर्व ही मुरझा जाती है;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"किसी के हाथों में कुछ भी नहीं आता,","poem":1},{"text":"और न उसकी पुलियां बांधी जा सकती हैं.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"आते जाते पुरुष यह कभी न कह पाएं,","poem":1},{"text":"“तुम पर याहवेह की कृपादृष्टि हो;","poem":2},{"lineBreak":true},{"text":"हम याहवेह के नाम में तुम्हारे लिए मंगल कामना करते हैं.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}