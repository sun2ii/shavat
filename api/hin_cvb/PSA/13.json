{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":13,"content":[{"type":"hebrew_subtitle","content":["संगीत निर्देशक के लिये. दावीद का एक स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"कब तक, याहवेह? कब तक आप मुझे भुला रखेंगे, क्या सदा के लिए?","poem":1},{"text":"कब तक आप मुझसे अपना मुख छिपाए रहेंगे?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"कब तक मैं अपने मन को समझाता रहूं?","poem":1},{"text":"कब तक दिन-रात मेरा हृदय वेदना सहता रहेगा?","poem":2},{"lineBreak":true},{"text":"कब तक मेरे शत्रु मुझ पर प्रबल होते रहेंगे?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"याहवेह, मेरे परमेश्वर, मेरी ओर ध्यान दे मुझे उत्तर दीजिए.","poem":1},{"text":"मेरी आंखों को ज्योतिर्मय कीजिए, ऐसा न हो कि मैं मृत्यु की नींद में समा जाऊं,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तब तो निःसंदेह मेरे शत्रु यह घोषणा करेंगे, “हमने उसे नाश कर दिया,”","poem":1},{"text":"ऐसा न हो कि मेरा लड़खड़ाना मेरे विरोधियों के लिए आनंद का विषय बन जाए.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"जहां तक मेरा संबंध है, याहवेह, मुझे आपके करुणा-प्रेम","poem":1},{"noteId":5},{"text":"पर भरोसा है;","poem":1},{"text":"तब मेरा हृदय आपके द्वारा किए उद्धार में मगन होगा.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"मैं याहवेह का भजन गाऊंगा,","poem":1},{"text":"क्योंकि उन्होंने मुझ पर अनेकानेक उपकार किए हैं.","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"करुणा-प्रेम ख़ेसेद इस हिब्री शब्द के अर्थ में अनुग्रह, दया, प्रेम, करुणा ये सब शामिल हैं","reference":{"chapter":13,"verse":5}}]},"thisChapterLink":"/api/hin_cvb/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}