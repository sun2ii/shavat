{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["आराधना के लिए यात्रियों का गीत."]},{"type":"verse","number":1,"content":[{"text":"याहवेह, गहराइयों में से मैं आपको पुकार रहा हूं;","poem":1}]},{"type":"verse","number":2,"content":[{"text":"हे प्रभु, मेरा स्वर सुन लीजिए,","poem":2},{"text":"कृपा के लिए मेरी नम्र विनती की","poem":1},{"text":"ओर आपके कान लगे रहें.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"याहवेह, यदि आप अपराधों का लेखा रखने लगें,","poem":1},{"text":"तो प्रभु, कौन ठहर सकेगा?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"किंतु आप क्षमा शील हैं,","poem":1},{"text":"तब आप श्रद्धा के योग्य हैं.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"मुझे, मेरे प्राणों को, याहवेह की प्रतीक्षा रहती है,","poem":1},{"text":"उनके वचन पर मैंने आशा रखी है.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"मुझे प्रभु की प्रतीक्षा है","poem":1},{"text":"उन रखवालों से भी अधिक, जिन्हें सूर्योदय की प्रतीक्षा रहती है,","poem":2},{"lineBreak":true},{"text":"वस्तुतः उन रखवालों से कहीं अधिक जिन्हें भोर की प्रतीक्षा रहती है.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"इस्राएल, याहवेह पर भरोसा रखो,","poem":1},{"text":"क्योंकि जहां याहवेह हैं वहां करुणा-प्रेम भी है","poem":2},{"lineBreak":true},{"text":"और वही पूरा छुटकारा देनेवाले हैं.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"स्वयं वही इस्राएल को,","poem":1},{"text":"उनके अपराधों को क्षमा करेंगे.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}