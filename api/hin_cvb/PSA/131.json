{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":131,"content":[{"type":"hebrew_subtitle","content":["आराधना के लिए यात्रियों का गीत. दावीद की रचना."]},{"type":"verse","number":1,"content":[{"text":"याहवेह, मेरा हृदय न तो अहंकार से फूल रहा है,","poem":1},{"text":"और न मेरी आंखें घमंड में चढ़ी हुई हैं;","poem":2},{"text":"मेरी रुचि न तो असाधारण उपलब्धियों में है,","poem":1},{"text":"न चमत्कारों में.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"मैंने अपने प्राणों को शांत और चुप कर लिया है,","poem":1},{"text":"जैसे माता की गोद में तृप्‍त शिशु;","poem":2},{"lineBreak":true},{"text":"मेरा प्राण अब ऐसे ही शिशु-समान शांत है.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"इस्राएल, याहवेह पर भरोसा रखो","poem":1},{"text":"इस समय और सदा-सर्वदा.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/