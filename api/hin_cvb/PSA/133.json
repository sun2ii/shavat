{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":133,"content":[{"type":"hebrew_subtitle","content":["आराधना के लिए यात्रियों का गीत. दावीद की रचना."]},{"type":"verse","number":1,"content":[{"text":"कैसी आदर्श और मनोरम है","poem":1},{"text":"वह स्थिति जब भाइयों में परस्पर एकता होती है!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"यह वैसी ही मनोरम स्थिति है, जब सुगंध द्रव्य पुरोहित के सिर पर उंडेला जाता है,","poem":1},{"text":"और बहता हुआ दाढ़ी तक पहुंच जाता है,","poem":2},{"text":"हां, अहरोन की दाढ़ी पर बहता हुआ,","poem":1},{"text":"उसके वस्त्र की छोर तक जा पहुंचता है.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"हरमोन पर्वत की ओस के समान,","poem":1},{"text":"जो ज़ियोन पर्वत पर पड़ती है.","poem":2},{"text":"क्योंकि वही है वह स्थान,","poem":1},{"text":"जहां याहवेह सर्वदा जीवन की आशीष प्रदान करते हैं.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/133.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/134.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/132.json","previousChapterAudioLinks":{},"numberOfVerses":3}