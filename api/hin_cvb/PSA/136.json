{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":136,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेह का धन्यवाद करो, क्योंकि वे भले हैं,","poem":1},"सनातन है उनकी करुणा."]},{"type":"verse","number":2,"content":[{"text":"परम परमेश्वर के प्रति आभार अभिव्यक्त करो.","poem":1},"सनातन है उनकी करुणा."]},{"type":"verse","number":3,"content":[{"text":"उनके प्रति, जो प्रधानों के प्रधान हैं, आभार अभिव्यक्त करो:","poem":1},"सनातन है उनकी करुणा."]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"उनके प्रति, जिनके अतिरिक्त अन्य कोई अद्भुत कार्य कर ही नहीं सकता,","poem":1},"सनातन है उनकी करुणा."]},{"type":"verse","number":5,"content":[{"text":"जिन्होंने अपनी सुबुद्धि से स्वर्ग का निर्माण किया,","poem":1},"सनातन है उनकी करुणा."]},{"type":"verse","number":6,"content":[{"text":"जिन्होंने जल के ऊपर पृथ्वी का विस्तार कर दिया,","poem":1},"सनातन है उनकी करुणा."]},{"type":"verse","number":7,"content":[{"text":"जिन्होंने प्रखर प्रकाश पुंजों की रचना की,","poem":1},"सनातन है उनकी करुणा."]},{"type":"verse","number":8,"content":[{"text":"दिन के प्रभुत्व के लिए सूर्य का,","poem":1},"सनातन है उनकी करुणा."]},{"type":"verse","number":9,"content":[{"text":"रात्रि के लिए चंद्रमा और तारों का;","poem":1},"सनातन है उनकी करुणा."]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"उन्हीं के प्रति, जिन्होंने मिस्र देश के पहलौठों की हत्या की,","poem":1},"सनातन है उनकी करुणा."]},{"type":"verse","number":11,"content":[{"text":"और उनके मध्य से इस्राएल राष्ट्र को बाहर निकाल लिया,","poem":1},"सनातन है उनकी करुणा."]},{"type":"verse","number":12,"content":[{"text":"सशक्त भुजा और ऊंची उठी हुई बांह के द्वारा;","poem":1},"सनातन है उनकी करुणा."]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"उन्हीं के प्रति, जिन्होंने लाल सागर को विभक्त कर दिया था","poem":1},"सनातन है उनकी करुणा."]},{"type":"verse","number":14,"content":[{"text":"और उसके मध्य की भूमि से इस्राएलियों को पार करवा दिया,","poem":1},"सनातन है उनकी करुणा."]},{"type":"verse","number":15,"content":[{"text":"किंतु फ़रोह और उसकी सेना को सागर ही में डुबो दिया;","poem":1},"सनातन है उनकी करुणा."]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"उन्हीं के प्रति, जिन्होंने अपनी प्रजा को बंजर भूमि से पार कराया;","poem":1},"सनातन है उनकी करुणा."]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"जिन्होंने प्रख्यात राजाओं की हत्या की,","poem":1},"सनातन है उनकी करुणा."]},{"type":"verse","number":18,"content":[{"text":"जिन्होंने सशक्त राजाओं का वध कर दिया,","poem":1},"सनातन है उनकी करुणा."]},{"type":"verse","number":19,"content":[{"text":"अमोरियों के राजा सीहोन का,","poem":1},"सनातन है उनकी करुणा."]},{"type":"verse","number":20,"content":[{"text":"बाशान के राजा ओग का,","poem":1},"सनातन है उनकी करुणा."]},{"type":"verse","number":21,"content":[{"text":"तथा उनकी भूमि निज भाग में दे दी,","poem":1},"सनातन है उनकी करुणा."]},{"type":"verse","number":22,"content":[{"text":"अपने सेवक इस्राएल को, निज भाग में दे दी,","poem":1},"सनातन है उनकी करुणा."]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"उन्हीं के प्रति, जिन्होंने हमारी दुर्दशा में हमारी सुधि ली,","poem":1},"सनातन है उनकी करुणा."]},{"type":"verse","number":24,"content":[{"text":"और हमें हमारे शत्रुओं से मुक्त किया,","poem":1},"सनातन है उनकी करुणा."]},{"type":"verse","number":25,"content":[{"text":"जो सब प्राणियों के आहार का प्रबंध करते हैं,","poem":1},"सनातन है उनकी करुणा."]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"स्वर्गिक परमेश्वर के प्रति आभार अभिव्यक्त करो,","poem":1},"सनातन है उनकी करुणा."]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}