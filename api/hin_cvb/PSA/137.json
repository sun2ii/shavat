{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"बाबेल की नदी के तट पर बैठे हुए","poem":1},{"text":"ज़ियोन का स्मरण कर हम रो रहे थे.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"वहां मजनू वृक्षों पर हमने","poem":1},{"text":"अपने वाद्य टांग दिए थे.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"क्योंकि जिन्होंने हमें बंदी बनाया था,","poem":1},{"text":"वे हमारा गायन सुनना चाह रहे थे और जो हमें दुःख दे रहे थे;","poem":2},{"lineBreak":true},{"text":"वे हमसे हर्षगान सुनने की चाह कर रहे थे, “हमें ज़ियोन का कोई गीत सुनाओ!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"प्रवास में हमारे लिए","poem":1},{"text":"याहवेह का स्तवन गान गाना कैसे संभव हो सकता था?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"येरूशलेम, यदि मैं तुम्हें भूल जाऊं,","poem":1},{"text":"तो मेरे दायें हाथ का कौशल जाता रहेगा.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"यदि मैं तुम्हारा स्मरण न करूं,","poem":1},{"text":"यदि मैं येरूशलेम को अपना सर्वोच्च आनंद न मानूं,","poem":2},{"lineBreak":true},{"text":"मेरी जीभ तालू से जा चिपके.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"याहवेह, वह दिन स्मरण कीजिए जब एदोम के वंशज","poem":1},{"text":"येरूशलेम के विरुद्ध एकत्र हो गए थे.","poem":2},{"text":"वे कैसे चिल्ला रहे थे, “ढा दो इसे,","poem":1},{"text":"इसे नींव तक ढा दो!”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"बाबेल की पुत्री, तेरा विनाश तो निश्चित है,","poem":1},{"text":"धन्य होगा वह पुरुष, जो तुझसे उन अत्याचारों का प्रतिशोध लेगा","poem":2},{"lineBreak":true},{"text":"जो तूने हम पर किए.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"धन्य होगा वह पुरुष,","poem":1},{"text":"जो तेरे शिशुओं को उठाकर चट्टान पर पटक देगा.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}