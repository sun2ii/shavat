{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेह का स्तवन हो.","poem":1},{"lineBreak":true},{"text":"आकाशमंडल में याहवेह का स्तवन हो;","poem":1},{"text":"उच्च स्थानों में उनका स्तवन हो.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"उनके समस्त स्वर्गदूत उनका स्तवन करें;","poem":1},{"text":"स्वर्गिक सेनाएं उनका स्तवन करें.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"सूर्य और चंद्रमा उनका स्तवन करें;","poem":1},{"text":"टिमटिमाते समस्त तारे उनका स्तवन करें.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"सर्वोच्च आकाश, उनका स्तवन करे और वह जल भी,","poem":1},{"text":"जो स्वर्ग के ऊपर संचित है.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ये सभी याहवेह की महिमा का स्तवन करें,","poem":1},{"text":"क्योंकि इन सब की रचना, आदेश मात्र से हुई है.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"उन्होंने इन्हें सदा-सर्वदा के लिए स्थापित किया है;","poem":1},{"text":"उन्होंने राजाज्ञा प्रसारित की, जिसको टाला नहीं जा सकता.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"पृथ्वी से याहवेह का स्तवन किया जाए,","poem":1},{"text":"महासागर तथा उनके समस्त विशालकाय प्राणी,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"अग्नि और ओले, हिम और धुंध,","poem":1},{"text":"प्रचंड बवंडर उनका आदेश पालन करते हैं,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"पर्वत और पहाड़ियां,","poem":1},{"text":"फलदायी वृक्ष तथा सभी देवदार,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"वन्य पशु और पालतू पशु,","poem":1},{"text":"रेंगते जंतु और उड़ते पक्षी,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"पृथ्वी के राजा और राज्य के लोग,","poem":1},{"text":"प्रधान और पृथ्वी के समस्त शासक,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"युवक और युवतियां,","poem":1},{"text":"वृद्ध और बालक.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"सभी याहवेह की महिमा का गुणगान करें,","poem":1},{"text":"क्योंकि मात्र उन्हीं की महिमा सर्वोच्च है;","poem":2},{"lineBreak":true},{"text":"उनका ही तेज पृथ्वी और आकाश से महान है.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"अपनी प्रजा के लिए उन्होंने एक सामर्थ्यी राजा का उद्भव किया है,","poem":1},{"text":"जो उनके सभी भक्तों के गुणगान का पात्र हैं,","poem":2},{"lineBreak":true},{"text":"इस्राएली प्रजा के लिए, जो उनकी अत्यंत प्रिय है.","poem":2},{"lineBreak":true},{"text":"याहवेह की स्तुति हो.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}