{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेह का स्तवन हो.","poem":1},{"lineBreak":true},{"text":"याहवेह के लिए एक नया गीत गाओ,","poem":1},{"text":"भक्तों की सभा में उनका स्तवन किया जाए.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"इस्राएल अपने कर्ता में आनंदित हो;","poem":1},{"text":"ज़ियोन की सन्तति अपने राजा में उल्‍लसित हो.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"वे उनकी महिमा में नृत्य के साथ स्तवन करें;","poem":1},{"text":"वे खंजरी और किन्‍नोर की संगत पर संगीत गाया करें.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"क्योंकि याहवेह का आनंद उनकी प्रजा में मगन है;","poem":1},{"text":"वह भोले पुरुष को उद्धार से सुशोभित करते हैं.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"सात्विक उनके पराक्रम में प्रफुल्लित रहें,","poem":1},{"text":"यहां तक कि वे अपने बिछौने पर भी हर्षोल्लास में गाते रहें.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"उनके कण्ठ में परमेश्वर के लिए सर्वोत्कृष्ट वंदना","poem":1},{"text":"तथा उनके हाथों में दोधारी तलवार हो.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"वे अन्य राष्ट्रों पर प्रतिशोध","poem":1},{"text":"तथा उनकी प्रजा पर दंड के लिए तत्पर रहें,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"कि उनके राजा बेड़ियों में बंदी बनाए जाएं","poem":1},{"text":"और उनके अधिकारी लोहे की जंजीरों में,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"कि उनके लिए निर्धारित दंड दिया जाए,","poem":1},{"text":"यह उनके समस्त भक्तों का सम्मान होगा.","poem":2},{"lineBreak":true},{"text":"याहवेह का स्तवन हो.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}