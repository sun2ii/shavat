{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":15,"content":[{"type":"hebrew_subtitle","content":["दावीद का एक स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"याहवेह, कौन आपके तंबू में रह सकेगा?","poem":1},{"text":"कौन आपके पवित्र पर्वत पर निवास कर सकेगा?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"वही, जिसका आचरण निष्कलंक है,","poem":1},{"text":"जो धार्मिकता का आचरण करता है,","poem":2},{"lineBreak":true},{"text":"जो हृदय से सच बोलता है;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"जिसकी जीभ से निंदा के शब्द नहीं निकलते,","poem":1},{"text":"जो न तो अपने पड़ोसी की बुराई करता है,","poem":2},{"lineBreak":true},{"text":"और न अपने किसी मित्र की,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"जिसके लिए याहवेह की दृष्टि में निकम्मा पुरुष घृणित है,","poem":1},{"text":"किंतु याहवेह का भय माननेवाले पुरुष सम्मान्य;","poem":2},{"text":"जो हर मूल्य पर अपनी प्रतिज्ञा पूर्ण करता है,","poem":1},{"text":"चाहे उसकी हानि ही क्यों न हो;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"जो ऋण देकर ब्याज नहीं लेता;","poem":1},{"text":"और निर्दोष के विरुद्ध झूठी गवाही देने के उद्देश्य से घूस नहीं लेता.","poem":2},{"lineBreak":true},{"text":"इस प्रकार के आचरण का पुरुष सदैव स्थिर रहेगा","poem":1},{"text":"वह कभी न डगमगाएगा.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}