{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":150,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेह का स्तवन हो.","poem":1},{"lineBreak":true},{"text":"परमेश्वर का उनके मंदिर में स्तवन हो;","poem":1},{"text":"अत्यंत विशाल आकाश में उनका स्तवन हो.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"उनके अद्भुत कार्यों के लिए उनका स्तवन हो;","poem":1},{"text":"उनके सर्वोत्कृष्ट महानता के योग्य उनका स्तवन हो.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तुरही के साथ उनका स्तवन हो,","poem":1},{"text":"वीणा तथा किन्‍नोर की संगत पर उनका स्तवन हो,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"खंजरी और नृत्य के साथ उनका स्तवन हो,","poem":1},{"text":"तन्तु एवं बांसुरी के साथ उनका स्तवन हो,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"झांझ की ध्वनि की संगत पर उनका स्तवन हो,","poem":1},{"text":"झांझ की उच्च झंकार में उनका स्तवन हो.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"हर एक प्राणी, जिसमें जीवन का श्वास है, याहवेह का स्तवन करे.","poem":1},{"lineBreak":true},{"text":"याहवेह का स्तवन हो!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}