{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":23,"content":[{"type":"hebrew_subtitle","content":["दावीद का एक स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"याहवेह मेरे चरवाहा हैं, मुझे कोई घटी न होगी.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"वह मुझे हरी-हरी चराइयों में विश्रान्ति प्रदान करते हैं,","poem":2},{"text":"वह मुझे शांत स्फूर्ति देनेवाली जलधाराओं के निकट ले जाते हैं.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"वह मेरे प्राण में नवजीवन का संचार करते हैं.","poem":2},{"text":"वह अपनी ही महिमा के निमित्त","poem":1},{"text":"मुझे धर्म के मार्ग पर लिए चलते हैं.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"यद्यपि मैं भयानक अंधकारमय घाटी","poem":1},{"text":"में से होकर आगे बढ़ता हूं,","poem":2},{"text":"तौभी मैं किसी बुराई से भयभीत नहीं होता,","poem":1},{"text":"क्योंकि आप मेरे साथ होते हैं,","poem":2},{"text":"आपकी लाठी और आपकी छड़ी,","poem":1},{"text":"मेरे आश्वासन हैं.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"आप मेरे शत्रुओं के सामने","poem":1},{"text":"मेरे लिए उत्कृष्ट भोजन परोसते हैं.","poem":2},{"text":"आप तेल से मेरे सिर को मला करते हैं;","poem":1},{"text":"मेरा प्याला उमड़ रहा है.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"निश्चयतः कुशल मंगल और करुणा-प्रेम","poem":1},{"noteId":9},{"text":"आजीवन मेरे साथ साथ बने रहेंगे,","poem":2},{"text":"और मैं सदा-सर्वदा याहवेह के आवास में,","poem":1},{"text":"निवास करता रहूंगा.","poem":2}]}],"footnotes":[{"noteId":9,"caller":"+","text":"करुणा-प्रेम मूल में ख़ेसेद इस हिब्री शब्द के अर्थ में अनुग्रह, दया, प्रेम, करुणा ये सब शामिल हैं","reference":{"chapter":23,"verse":6}}]},"thisChapterLink":"/api/hin_cvb/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}