{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":24,"content":[{"type":"hebrew_subtitle","content":["दावीद की रचना. एक स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"पृथ्वी और पृथ्वी में जो कुछ भी है, सभी कुछ याहवेह का ही है.","poem":1},{"text":"संसार और वे सभी, जो इसमें निवास करते हैं, उन्हीं के हैं;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"क्योंकि उन्हीं ने महासागर पर इसकी नींव रखी","poem":1},{"text":"तथा जलप्रवाहों पर इसे स्थिर किया.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"कौन चढ़ सकेगा याहवेह के पर्वत पर?","poem":1},{"text":"कौन खड़ा रह सकेगा उनके पवित्र स्थान में?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"वही, जिसके हाथ निर्मल और हृदय शुद्ध है,","poem":1},{"text":"जो मूर्तियों पर भरोसा नही रखता,","poem":2},{"lineBreak":true},{"text":"जो झूठी शपथ नहीं करता.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"उस पर याहवेह की आशीष स्थायी रहेगी.","poem":1},{"text":"परमेश्वर, उसका छुड़ाने वाला, उसे धर्मी घोषित करेंगे.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"यही है वह पीढ़ी, जो याहवेह की कृपादृष्टि खोजने वाली,","poem":1},{"text":"जो आपके दर्शन की अभिलाषी है, हे याकोब के परमेश्वर!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"प्रवेश द्वारो, ऊंचे करो अपने मस्तक;","poem":1},{"text":"प्राचीन किवाड़ो, ऊंचे हो जाओ,","poem":2},{"lineBreak":true},{"text":"कि महातेजस्वी महाराज प्रवेश कर सकें.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"यह महातेजस्वी राजा हैं कौन?","poem":1},{"text":"याहवेह, तेजी और समर्थ,","poem":2},{"lineBreak":true},{"text":"याहवेह, युद्ध में पराक्रमी.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"प्रवेश द्वारों, ऊंचा करो अपने मस्तक;","poem":1},{"text":"प्राचीन किवाड़ों, ऊंचे हो जाओ,","poem":2},{"lineBreak":true},{"text":"कि महातेजस्वी महाराज प्रवेश कर सकें.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"यह महातेजस्वी राजा कौन है?","poem":1},{"text":"सर्वशक्तिमान याहवेह!","poem":2},{"lineBreak":true},{"text":"वही हैं महातेजस्वी महाराजा.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}