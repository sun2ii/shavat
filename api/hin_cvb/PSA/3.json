{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["दावीद का एक स्तोत्र. जब वह अपने पुत्र अबशालोम से बचकर भाग रहे थे."]},{"type":"verse","number":1,"content":[{"text":"याहवेह! कितने सारे हैं मेरे शत्रु!","poem":1},{"text":"कितने हैं जो मेरे विरोध में उठ खड़े हुए हैं!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"वे मेरे विषय में कहने लगे हैं,","poem":1},{"text":"“परमेश्वर उसे उद्धार प्रदान नहीं करेंगे.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"किंतु, याहवेह, आप सदैव ही जोखिम में मेरी ढाल हैं,","poem":1},{"text":"आप ही हैं मेरी महिमा, आप मेरा मस्तक ऊंचा करते हैं.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"याहवेह! मैंने उच्च स्वर में आपको पुकारा है,","poem":1},{"text":"और आपने अपने पवित्र पर्वत से मुझे उत्तर दिया.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"मैं लेटता और निश्चिंत सो जाता हूं;","poem":1},{"text":"मैं पुनः सकुशल जाग उठता हूं, क्योंकि याहवेह मेरी रक्षा कर रहे थे.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"मुझे उन असंख्य शत्रुओं का कोई भय नहीं","poem":1},{"text":"जिन्होंने मुझे चारों ओर से घेर लिया है.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"उठिए याहवेह!","poem":1},{"text":"मेरे परमेश्वर, आकर मुझे बचाइए!","poem":2},{"text":"निःसंदेह आप मेरे समस्त शत्रुओं के जबड़े पर प्रहार करें;","poem":1},{"text":"आप उन दुष्टों के दांत तोड़ डालें.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"उद्धार तो याहवेह में ही है,","poem":1},{"text":"आपकी प्रजा पर आपकी कृपादृष्टि बनी रहे!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}