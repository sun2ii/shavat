{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"परमेश्वर, मुझे निर्दोष प्रमाणित कीजिए,","poem":1},{"text":"श्रद्धाहीन पीढ़ी के विरुद्ध","poem":2},{"lineBreak":true},{"text":"मेरे पक्ष में निर्णय दीजिए.","poem":2},{"text":"मुझे झूठ बोलने वालों से एवं दुष्ट लोगों","poem":1},{"text":"से मुक्त कीजिए.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"क्योंकि आप वह परमेश्वर हैं, जिनमें मेरा बल है.","poem":1},{"text":"आप मुझे भूल क्यों गए?","poem":2},{"text":"मेरे शत्रुओं द्वारा दी जा रही यातनाओं के कारण,","poem":1},{"text":"मुझे शोकित क्यों होना पड़ रहा है?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"अपनी ज्योति तथा अपना सत्य भेज दीजिए,","poem":1},{"text":"उन्हें ही मेरी अगुवाई करने दीजिए;","poem":2},{"text":"कि मैं आपके पवित्र पर्वत तक पहुंच सकूं,","poem":1},{"text":"जो आपका आवास है.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तब मैं परमेश्वर की वेदी के निकट जा सकूंगा,","poem":1},{"text":"वही परमेश्वर, जो मेरे परमानंद हैं.","poem":2},{"text":"तब परमेश्वर, मेरे परमेश्वर,","poem":1},{"text":"मैं किन्‍नोर की संगत पर आपकी वंदना करूंगा.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"मेरे प्राण, तुम ऐसे खिन्‍न क्यों हो?","poem":1},{"text":"क्यों मेरे हृदय में तुम ऐसे व्याकुल हो गए हो?","poem":2},{"text":"परमेश्वर पर भरोसा रखो,","poem":1},{"text":"क्योंकि यह सब होते हुए भी","poem":2},{"lineBreak":true},{"text":"मैं याहवेह का स्तवन करूंगा.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}