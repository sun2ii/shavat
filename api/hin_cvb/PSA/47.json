{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["संगीत निर्देशक के लिये. कोराह के पुत्रों की रचना. एक स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"समस्त राष्ट्रो, तालियां बजाओ;","poem":1},{"text":"हर्षोल्लास में परमेश्वर का जय जयकार करो.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"याहवेह, सर्वोच्च परमेश्वर भय-योग्य हैं,","poem":1},{"text":"वही समस्त पृथ्वी के ऊपर पराक्रमी राजा हैं.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"उन्हीं ने जनताओं को हमारे अधीन कर दिया है,","poem":1},{"text":"लोग हमारे पैरों के नीचे हो गए हैं.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"उन्हीं ने हमारे लिए निज भाग को निर्धारित किया है,","poem":1},{"text":"यही याकोब का गौरव है, जो उनका प्रिय है.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"जय जयकार की ध्वनि के मध्य से परमेश्वर ऊपर उठाए गए,","poem":1},{"text":"तुरही नाद के मध्य याहवेह ऊपर उठाए गए.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"स्तुति गान में परमेश्वर की वंदना करो, वंदना करो;","poem":1},{"text":"स्तुति गान में हमारे राजाधिराज की वंदना करो, वंदना करो.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"परमेश्वर संपूर्ण पृथ्वी के राजाधिराज हैं;","poem":1},{"text":"उनके सम्मान में एक स्तवन गीत प्रस्तुत करो.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"संपूर्ण राष्ट्रों पर परमेश्वर का शासन है;","poem":1},{"text":"परमेश्वर अपने महान सिंहासन पर विराजमान हैं.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"अब्राहाम के परमेश्वर की प्रजा के रूप में","poem":1},{"text":"जनताओं के अध्यक्ष एकत्र हुए हैं,","poem":2},{"text":"क्योंकि पृथ्वी की ढालों पर परमेश्वर का अधिकार है;","poem":1},{"text":"परमेश्वर अत्यंत ऊंचे हैं.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}