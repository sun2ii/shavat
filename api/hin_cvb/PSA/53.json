{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":53,"content":[{"type":"hebrew_subtitle","content":["संगीत निर्देशक के लिये. माख़लथ",{"noteId":25},"पर आधारित दावीद की मसकील",{"noteId":26},"गीत रचना"]},{"type":"verse","number":1,"content":[{"text":"मूर्ख मन ही मन में कहते हैं,","poem":1},{"text":"“परमेश्वर है ही नहीं.”","poem":2},{"text":"वे सभी भ्रष्‍ट हैं और उनकी जीवनशैली घिनौनी है;","poem":1},{"text":"ऐसा कोई भी नहीं, जो भलाई करता हो.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"स्वर्ग से परमेश्वर","poem":1},{"text":"मनुष्यों पर दृष्टि डालते हैं","poem":2},{"text":"इस आशा में कि कोई तो होगा, जो बुद्धिमान है,","poem":1},{"text":"जो परमेश्वर की खोज करता हो.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"सभी मनुष्य भटक गए हैं, सभी नैतिक रूप से भ्रष्‍ट हो चुके हैं;","poem":1},{"text":"कोई भी सत्कर्म परोपकार नहीं करता,","poem":2},{"lineBreak":true},{"text":"हां, एक भी नहीं.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"मेरी प्रजा के ये भक्षक, ये दुष्ट पुरुष, क्या ऐसे निर्बुद्धि हैं?","poem":1},{"lineBreak":true},{"text":"जो उसे ऐसे खा जाते हैं, जैसे रोटी को;","poem":1},{"text":"क्या उन्हें परमेश्वर की उपासना का कोई ध्यान नहीं?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"जहां भय का कोई कारण ही न था,","poem":1},{"text":"वहां वे अत्यंत भयभीत हो गए.","poem":2},{"text":"परमेश्वर ने उनकी हड्डियों को बिखरा दिया, जो तेरे विरुद्ध छावनी डाले हुए थे;","poem":1},{"text":"तुमने उन्हें लज्जित कर डाला, क्योंकि वे परमेश्वर द्वारा लज्जित किये गये थे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"कैसा उत्तम होता यदि इस्राएल का उद्धार ज़ियोन से प्रगट होता!","poem":1},{"text":"याकोब के लिए वह हर्षोल्लास का अवसर होगा,","poem":2},{"lineBreak":true},{"text":"जब परमेश्वर अपनी प्रजा को दासत्व से लौटा लाएंगे, तब इस्राएल आनंदित हो जाएगा!","poem":2}]}],"footnotes":[{"noteId":25,"caller":"+","text":"शीर्षक: शायद साहित्यिक या संगीत संबंधित एक शब्द","reference":{"chapter":53,"verse":0}},{"noteId":26,"caller":"+","text":"एक संगीत संबंधित शब्द","reference":{"chapter":53,"verse":0}}]},"thisChapterLink":"/api/hin_cvb/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}