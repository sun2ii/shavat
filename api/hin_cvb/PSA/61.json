{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["संगीत निर्देशक के लिये. तार वाद्यों की संगत के साथ. दावीद की रचना"]},{"type":"verse","number":1,"content":[{"text":"परमेश्वर, मेरे चिल्लाने को सुनिए;","poem":1},{"text":"मेरी प्रार्थना पर ध्यान दीजिए.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"मैं पृथ्वी की छोर से आपको पुकार रहा हूं,","poem":1},{"text":"आपको पुकारते-पुकारते मेरा हृदय डूबा जा रहा है;","poem":2},{"lineBreak":true},{"text":"मुझे उस उच्च, अगम्य चट्टान पर खड़ा कीजिए जिसमें मेरी सुरक्षा है.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"शत्रुओं के विरुद्ध मेरे लिए आप एक सुदृढ़ स्तंभ,","poem":1},{"text":"एक आश्रय-स्थल रहे हैं.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"मेरी लालसा है कि मैं आपके आश्रय में चिरकाल निवास करूं","poem":1},{"text":"और आपके पंखों की छाया में मेरी सुरक्षा रहे.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"परमेश्वर, आपने मेरी मन्‍नतें सुनी हैं;","poem":1},{"text":"आपने मुझे वह सब प्रदान किया है, जो आपके श्रद्धालुओं का निज भाग होता है.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"आप राजा को आयुष्मान करेंगे,","poem":1},{"text":"उनकी आयु के वर्ष अनेक पीढ़ियों के तुल्य हो जाएंगे.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"परमेश्वर की उपस्थिति में वह सदा-सर्वदा सिंहासन पर विराजमान रहेंगे;","poem":1},{"text":"उनकी सुरक्षा के निमित्त आप अपने करुणा-प्रेम एवं सत्य को प्रगट करें.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"तब मैं आपकी महिमा का गुणगान करूंगा","poem":1},{"text":"और दिन-प्रतिदिन अपनी मन्‍नतें पूरी करता रहूंगा.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}