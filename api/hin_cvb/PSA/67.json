{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":67,"content":[{"type":"hebrew_subtitle","content":["संगीत निर्देशक के लिये. तार वाद्यों की संगत के साथ. एक स्तोत्र. एक गीत."]},{"type":"verse","number":1,"content":[{"text":"परमेश्वर हम पर अनुग्रह करें, और आशीष दें,","poem":1},{"text":"और उनका मुख हम पर प्रकाशित करते रहें.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"पृथ्वी पर आपकी इच्छा प्रकाशित होती रहे,","poem":1},{"text":"तथा समस्त राष्ट्रों को आपके उद्धार का परिचय प्राप्‍त हो.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"हे परमेश्वर, मनुष्य आपका स्तवन करते रहें;","poem":1},{"text":"सभी मनुष्यों द्वारा आपका स्तवन होता रहे.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"हर एक राष्ट्र उल्‍लसित होकर हर्षोल्लास में गाने लगे,","poem":1},{"text":"क्योंकि आपका न्याय सभी के लिए खरा है","poem":2},{"lineBreak":true},{"text":"और आप पृथ्वी के हर एक राष्ट्र की अगुवाई करते हैं.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"हे परमेश्वर, मनुष्य आपका स्तवन करते रहें;","poem":1},{"text":"सभी मनुष्यों द्वारा आपका स्तवन होता रहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"पृथ्वी ने अपनी उपज प्रदान की है;","poem":1},{"text":"परमेश्वर, हमारे परमेश्वर, हम पर अपनी कृपादृष्टि बनाए रखें.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"परमेश्वर हम पर अपनी कृपादृष्टि बनाए रखेंगे,","poem":1},{"text":"कि पृथ्वी के दूर-दूर तक उनके लिए श्रद्धा प्रसारित हो जाए.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}