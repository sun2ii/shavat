{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["संगीत निर्देशक के लिये. दावीद की रचना. अभ्यर्थना."]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्वर, कृपा कर मुझे उद्धार प्रदान कीजिए;","poem":1},{"text":"याहवेह, तुरंत मेरी सहायता कीजिए.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"वे, जो मेरे प्राणों के प्यासे हैं,","poem":1},{"text":"लज्जित और निराश किए जाएं;","poem":2},{"text":"वे जिनका आनंद मेरी पीड़ा में है,","poem":1},{"text":"पीठ दिखाकर भागें तथा अपमानित किए जाएं.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"वे सभी, जो मेरी स्थिति को देख, “आहा! आहा!” करते हैं!","poem":1},{"text":"लज्जा में अपना मुख छिपा लें.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"किंतु वे सभी, जो आपकी खोज करते हैं","poem":1},{"text":"हर्षोल्लास में मगन हों;","poem":2},{"text":"वे सभी, जिन्हें आपके उद्धार की आकांक्षा है, यही कहें,","poem":1},{"text":"“अति महान हैं परमेश्वर!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"मैं दरिद्र और दुःखी पुरुष हूं;","poem":1},{"text":"परमेश्वर, मेरी सहायता के लिए विलंब न कीजिए.","poem":2},{"text":"आप ही मेरे सहायक और छुड़ानेवाले हैं;","poem":1},{"text":"याहवेह, विलंब न कीजिए.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}