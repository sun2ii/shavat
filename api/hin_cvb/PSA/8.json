{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":8,"content":[{"type":"hebrew_subtitle","content":["संगीत निर्देशक के लिये. गित्तीथ",{"noteId":3},"पर आधारित. दावीद का एक स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"याहवेह, हमारे प्रभु,","poem":1},{"text":"समस्त पृथ्वी पर कितना तेजमय है आपका नाम!","poem":2},{"lineBreak":true},{"text":"स्वर्ग पर आपने","poem":1},{"text":"अपने वैभव को प्रदर्शित किया है.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"आपने अपने शत्रुओं के कारण बालकों एवं शिशुओं","poem":1},{"text":"के मुख से अपना बल बसा लिया,","poem":2},{"lineBreak":true},{"text":"कि आपके विरोधियों तथा शत्रु का अंत हो जाए.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"जब मैं आपकी उंगलियों,","poem":1},{"text":"द्वारा रचा आकाश,","poem":2},{"text":"चंद्रमा और नक्षत्रों को,","poem":1},{"text":"जिन्हें आपने यथास्थान पर स्थापित किया, देखता हूं,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तब मैं विचार करता हूं: मनुष्य है ही क्या, कि आप उसकी ओर ध्यान दें?","poem":1},{"text":"क्या विशेषता है मानव में कि आप उसके विषय में विचार भी करें?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"आपने मनुष्य को सम्मान और वैभव का मुकुट पहनाया,","poem":1},{"text":"क्योंकि आपने उसे स्वर्गदूतों से थोड़ा ही कम बनाया है.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"आपने उसे अपनी सृष्टि का प्रशासक बनाया;","poem":1},{"text":"आपने सभी कुछ उसके अधिकार में दे दिया:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"भेड़-बकरी, गाय-बैल,","poem":1},{"text":"तथा वन्य पशु,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"आकाश के पक्षी,","poem":1},{"text":"एवं समुद्र की मछलियां,","poem":2},{"lineBreak":true},{"text":"तथा समुद्री धाराओं में चलते फिरते सभी जलचर भी.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"याहवेह, हमारे प्रभु,","poem":1},{"text":"समस्त पृथ्वी पर कितना तेजमय है आपका नाम!","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"शीर्षक: शायद संगीत संबंधित एक शब्द","reference":{"chapter":8,"verse":0}}]},"thisChapterLink":"/api/hin_cvb/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}