{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["आसफ का एक स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"स्वर्गिक महासभा में परमेश्वर ने अपना स्थान ग्रहण किया है;","poem":1},{"text":"उन्होंने “देवताओं” के सामने अपना निर्णय सुना दिया है:","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"कब तक तुम अन्यायी को समर्थन करते रहोगे,","poem":1},{"text":"कब तक तुम अन्याय का पक्षपात करते रहोगे?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"दुःखी तथा पितृहीन का पक्ष दृढ़ करो;","poem":1},{"text":"दरिद्रों एवं दुःखितों के अधिकारों की रक्षा करो.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"दुर्बल एवं दीनों को छुड़ा लो;","poem":1},{"text":"दुष्ट के फंदे से उन्हें बचा लो.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“वे कुछ नहीं जानते, वे कुछ नहीं समझते.","poem":1},{"text":"वे अंधकार में आगे बढ़ रहे हैं;","poem":2},{"lineBreak":true},{"text":"पृथ्वी के समस्त आधार डगमगा गए हैं.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“मैंने कहा, ‘तुम “ईश्वर” हो;","poem":1},{"text":"तुम सभी सर्वोच्च परमेश्वर की संतान हो.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"किंतु तुम सभी की मृत्यु दूसरे मनुष्यों सी होगी;","poem":1},{"text":"तुम्हारा पतन भी अन्य शासकों के समान ही होगा.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"परमेश्वर, उठकर पृथ्वी का न्याय कीजिए,","poem":1},{"text":"क्योंकि समस्त राष्ट्रों पर आपका प्रभुत्व है.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}