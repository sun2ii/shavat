{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":87,"content":[{"type":"hebrew_subtitle","content":["कोराह के पुत्रों की रचना. एक स्तोत्र. एक गीत."]},{"type":"verse","number":1,"content":[{"text":"पवित्र पर्वत पर उन्होंने अपनी नींव डाली है;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"याकोब के समस्त आवासों की अपेक्षा,","poem":1},{"text":"याहवेह को ज़ियोन के द्वार कहीं अधिक प्रिय हैं.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"परमेश्वर के नगर,","poem":1},{"text":"तुम्हारे विषय में यशस्वी बातें लिखी गई हैं,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“अपने परिचितों के मध्य मैं","poem":1},{"text":"राहाब","poem":2},{"noteId":47},{"text":"और बाबेल का लेखा करूंगा,","poem":2},{"text":"साथ ही फिलिस्तिया, सोर और कूश","poem":1},{"noteId":48},{"text":"का भी,","poem":1},{"text":"और फिर मैं कहूंगा, ‘यही है वह, जिसकी उत्पत्ति ज़ियोन में हुई है.’ ”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ज़ियोन के विषय में यही घोषणा की जाएगी,","poem":1},{"text":"“इसका भी जन्म ज़ियोन में हुआ और उसका भी,","poem":2},{"lineBreak":true},{"text":"सर्वोच्च परमेश्वर ही ने ज़ियोन को बसाया है.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"याहवेह अपनी प्रजा की गणना करते समय लिखेगा:","poem":1},{"text":"“इसका जन्म ज़ियोन में हुआ था.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"संगीत की संगत पर वे गाएंगे,","poem":1},{"text":"“तुम्हीं में मेरे आनंद का समस्त उगम हैं.”","poem":2}]}],"footnotes":[{"noteId":47,"caller":"+","text":"राहाब मिस्र देश के लिए एक काव्य नाम","reference":{"chapter":87,"verse":4}},{"noteId":48,"caller":"+","text":"कूश यानी इथियोपिया","reference":{"chapter":87,"verse":4}}]},"thisChapterLink":"/api/hin_cvb/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}