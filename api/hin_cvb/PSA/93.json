{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेह, राज्य करते हैं, उन्होंने वैभवशाली परिधान धारण किए हैं;","poem":1},{"text":"याहवेह ने तेज के परिधान धारण किए हैं और वह शक्ति से सुसज्जित हैं;","poem":2},{"lineBreak":true},{"text":"विश्व सुदृढ़ नींव पर स्थापित है, जो अटल है.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"सनातन काल से आपका सिंहासन बसा है;","poem":1},{"text":"स्वयं आप सनातन काल से हैं.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"याहवेह, जल स्तर उठता जा रहा है,","poem":1},{"text":"लहरों की ध्वनि ऊंची होती जा रही है;","poem":2},{"lineBreak":true},{"text":"समुद्र की प्रचंड लहरों का प्रहार उग्र होता जा रहा है.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"विशालकाय लहरों की गर्जन से कहीं अधिक शक्तिशाली,","poem":1},{"text":"उद्वेलित लहरों के प्रहार से कहीं अधिक प्रचंड हैं,","poem":2},{"lineBreak":true},{"text":"महान सर्वशक्तिमान याहवेह.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"अटल हैं आपके अधिनियम;","poem":1},{"text":"पवित्रता, आपके आवास की शोभा;","poem":2},{"lineBreak":true},{"text":"याहवेह, ये सदा-सर्वदा स्थिर रहेंगे.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}