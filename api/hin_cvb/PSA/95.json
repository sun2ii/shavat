{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"चलो, हम याहवेह के स्तवन में आनंदपूर्वक गाएं;","poem":1},{"text":"अपने उद्धार की चट्टान के लिए उच्च स्वर में मनोहारी संगीत प्रस्तुत करें.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"हम धन्यवाद के भाव में उनकी उपस्थिति में आएं","poem":1},{"text":"स्तवन गीतों में हम मनोहारी संगीत प्रस्तुत करें.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"इसलिये कि याहवेह महान परमेश्वर हैं,","poem":1},{"text":"समस्त देवताओं के ऊपर सर्वोच्च राजा हैं.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"पृथ्वी की गहराइयों पर उनका नियंत्रण है,","poem":1},{"text":"पर्वत शिखर भी उनके अधिकार में हैं.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"समुद्र उन्हीं का है, क्योंकि यह उन्हीं की रचना है,","poem":1},{"text":"सूखी भूमि भी उन्हीं की हस्तकृति है.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"आओ, हम नतमस्तक होकर आराधना करें,","poem":1},{"text":"हम याहवेह, हमारे सृजनहार के सामने घुटने टेकें!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"क्योंकि वह हमारे परमेश्वर हैं","poem":1},{"text":"और हम उनके चराई की प्रजा हैं,","poem":2},{"lineBreak":true},{"text":"उनकी अपनी संरक्षित","poem":2},{"noteId":55},{"text":"भेड़ें.","poem":2},{"lineBreak":true},{"text":"यदि आज तुम उनका स्वर सुनते हो,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"“अपने हृदय कठोर न कर लेना. जैसे तुमने मेरिबाह","poem":1},{"noteId":56},{"text":"में किया था,","poem":1},{"text":"जैसे तुमने उस समय बंजर भूमि में मस्साह","poem":2},{"noteId":57},{"text":"नामक स्थान पर किया था,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"जहां तुम्हारे पूर्वजों ने मुझे परखा और मेरे धैर्य की परीक्षा ली थी;","poem":1},{"text":"जबकि वे उस सबके गवाह थे, जो मैंने उनके सामने किया था.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"उस पीढ़ी से मैं चालीस वर्ष उदास रहा;","poem":1},{"text":"मैंने कहा, ‘ये ऐसे लोग हैं जिनके हृदय फिसलते जाते हैं,","poem":2},{"lineBreak":true},{"text":"वे मेरे मार्ग समझ ही न सके हैं.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तब अपने क्रोध में मैंने शपथ ली,","poem":1},{"text":"‘मेरे विश्राम में उनका प्रवेश कभी न होगा.’ ”","poem":2}]}],"footnotes":[{"noteId":55,"caller":"+","text":"मूल भाषा में हाथ की","reference":{"chapter":95,"verse":7}},{"noteId":56,"caller":"+","text":"अर्थ: झगड़ा, निर्ग 17:7देखें","reference":{"chapter":95,"verse":8}},{"noteId":57,"caller":"+","text":"अर्थ: परीक्षा, निर्ग 17:7देखें","reference":{"chapter":95,"verse":8}}]},"thisChapterLink":"/api/hin_cvb/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}