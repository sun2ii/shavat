{"translation":{"id":"hin_cvb","name":"Biblica® हिंदी समकालीन संस्करण-स्वतंत्र उपलब्धि","website":"https://ebible.org/Scriptures/details.php?id=hincv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hincv","licenseNotes":null,"shortName":"CVB","englishName":"Hindi Contemporary Version Bible","language":"hin","textDirection":"ltr","sha256":"cecd6f6cca1c4684ee8e1509128ef3d4769d260fa9d3dbb06d391cf0e22fcabb","availableFormats":["json"],"listOfBooksApiLink":"/api/hin_cvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"हिन्दी","languageEnglishName":"Hindi"},"book":{"id":"PSA","translationId":"hin_cvb","name":"स्तोत्र","commonName":"स्तोत्र","title":"स्तोत्र संहिता","order":19,"numberOfChapters":150,"sha256":"df4546bf5b64b9cf6a8c4b9b1c7c70b6799ca0070b51f408ba269db3db03e1bb","firstChapterNumber":1,"firstChapterApiLink":"/api/hin_cvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hin_cvb/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेह शासक हैं,","poem":1},{"text":"राष्ट्र कांपते रहें;","poem":2},{"text":"उन्होंने अपना आसन करूबों के मध्य स्थापित किया है,","poem":1},{"text":"पृथ्वी कांप जाए.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ज़ियोन में याहवेह तेजस्वी हैं;","poem":1},{"text":"वह समस्त राष्ट्रों के ऊपर बसे हैं.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"उपयुक्त है उनका आपके महान और भय-योग्य नाम की वंदना करना—","poem":1},{"text":"पवित्र हैं वह.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"राजा शक्ति-सम्पन्‍न हैं, वह जो न्याय को प्रिय मानता है,","poem":1},{"text":"उन्होंने इस्राएल में समता की स्थापना की है;","poem":2},{"lineBreak":true},{"text":"जो न्याय संगत और उचित है.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"याहवेह, हमारे परमेश्वर की महिमा की जाए,","poem":1},{"text":"उनके चरणों में गिर आराधना की जाए;","poem":2},{"lineBreak":true},{"text":"वह पवित्र हैं.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"मोशेह और अहरोन उनके पुरोहित थे,","poem":1},{"text":"शमुएल उनके आराधक थे;","poem":2},{"text":"ये सभी याहवेह को पुकारते थे","poem":1},{"text":"और वह उन्हें उत्तर देते थे.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"मेघ-स्तंभ में से याहवेह ने उनसे वार्तालाप किया;","poem":1},{"text":"उन्होंने उनके अधिनियमों तथा उनके द्वारा सौंपे गए आदेशों का पालन किया.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"याहवेह, हमारे परमेश्वर,","poem":1},{"text":"आप उन्हें उत्तर देते थे;","poem":2},{"text":"इस्राएल के लिए आप क्षमा शील परमेश्वर रहे,","poem":1},{"text":"यद्यपि आप उनके अपराधों का दंड देते रहे.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"याहवेह, हमारे परमेश्वर की महिमा को ऊंचा करो,","poem":1},{"text":"उनके पवित्र पर्वत पर उनकी आराधना करो,","poem":2},{"lineBreak":true},{"text":"क्योंकि पवित्र हैं हमारे याहवेह परमेश्वर.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hin_cvb/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hin_cvb/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hin_cvb/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}