{"translation":{"id":"hlt_thb","name":"Tuivang Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=hltthb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hltthb","licenseNotes":null,"shortName":"THB","englishName":"Tuivang Matu Chin Bible","language":"hlt","textDirection":"ltr","sha256":"9286f2ac8efa02a898882ff69da6d2facdd490eaf618f183179d3baceacbe27d","availableFormats":["json"],"listOfBooksApiLink":"/api/hlt_thb/books.json","numberOfBooks":29,"totalNumberOfChapters":441,"totalNumberOfVerses":11333,"languageName":"Matu Chin","languageEnglishName":"Matu Chin"},"book":{"id":"PSA","translationId":"hlt_thb","name":"Saam","commonName":"Saam","title":"Saam","order":19,"numberOfChapters":150,"sha256":"3c685f352c5bc44c310fb8b894a8143a063d5eb2204f28010aba9876b9642424","firstChapterNumber":1,"firstChapterApiLink":"/api/hlt_thb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hlt_thb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"verse","number":1,"content":["Ka khuikha awh Bawipa ce khy nyng saw, anih ing nim hlat law hy."]},{"type":"verse","number":2,"content":["Aw Bawipa, qaai ak kqawn huikhqi ingkaw qaai kqawn na ak nget laikhqi anglakawhkawng ni hul lah."]},{"type":"verse","number":3,"content":["Aw qaai kqawn na ak nget hui lai nang, nang ak khan awh anih ing ikaw a sai kaw, cekcoengawh ikaw ak awm bai?"]},{"type":"verse","number":4,"content":["Kaw ak awmkhqi a la sumkhqi ing nang ce ni toel kawmsaw, imnawt thing mai alh ing ni toel kaw."]},{"type":"verse","number":5,"content":["Kedar awhkaw hi im anglakawh awm nawh, Meshqek awh ak awm ve kai aham khaw map mah hy!"]},{"type":"verse","number":6,"content":["Roepnaak ak sawhnaak thlang anglakawh ka awm ve sang soeih hawh hy."]},{"type":"verse","number":7,"content":["Kai taw qoepnaak ak ngaih thlang na awm nyng; cehlai awi kak kqawn awh, qaal thawh aham ngaih lat uhy."]}],"footnotes":[]},"thisChapterLink":"/api/hlt_thb/PSA/120.json","thisChapter