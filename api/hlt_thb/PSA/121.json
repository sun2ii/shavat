 kaw."]}],"footnotes":[]},"thisChapterLink":"/api/hlt_thb/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hlt_thb/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hlt_thb/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}