,{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mai moale bada danu,","poem":1},{"lineBreak":true},{"text":"ranu guri dekena amo,","poem":1},{"lineBreak":true},{"text":"ranu namona umui inua noho.","poem":1},{"lineBreak":true},{"text":"Unai bamona danu,","poem":1},{"lineBreak":true},{"text":"Dirava ena taudia idia moale bada noho,","poem":1},{"lineBreak":true},{"text":"ia ese idia ia hamauria neganai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bona unai dina dekenai do umui gwau,","poem":1},{"lineBreak":true},{"text":"“Lohiabada do umui hanamoa,","poem":1},{"lineBreak":true},{"text":"bona iena durua abia totona,","poem":1},{"lineBreak":true},{"text":"iena ladana do umui boiboi henia.","poem":1},{"lineBreak":true},{"text":"Bese idauidau taudia dekenai,","poem":1},{"lineBreak":true},{"text":"Lohiabada ena kara namodia do umui hadibaia.","poem":1},{"lineBreak":true},{"text":"Lohiabada ena ladana bada herea,","poem":1},{"lineBreak":true},{"text":"do umui gwauraia hedinarai,","poem":1},{"lineBreak":true},{"text":"tanobada taudia dekenai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lohiabada hanamoa totona,","poem":1},{"lineBreak":true},{"text":"ane do umui abia,","poem":1},{"lineBreak":true},{"text":"badina be ia ese,","poem":1},{"lineBreak":true},{"text":"kara badadia ia karaia vadaeni.","poem":1},{"lineBreak":true},{"text":"Tanobada taudia ibounai dekenai,","poem":1},{"lineBreak":true},{"text":"inai sivarai do umui gwauraia loaloa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Siona dekenai noho taudia e,","poem":1},{"lineBreak":true},{"text":"mai moale danu do umui boiboi,","poem":1},{"lineBreak":true},{"text":"bona ane do umui abia,","poem":1},{"lineBreak":true},{"text":"badina Israela ena Helaga Dirava be bada,","poem":1},{"lineBreak":true},{"text":"bona ia ese iena bese taudia,","poem":1},{"lineBreak":true},{"text":"edia huanai ia noho.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}