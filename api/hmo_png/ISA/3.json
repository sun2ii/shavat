{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"ISA","translationId":"hmo_png","name":"ISAIA","commonName":"ISAIA","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"1897ad63f41729a0c0e7fb1c81caa680cdd8d4c79dc1e285704e45f111ee110d","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hmo_png/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":3,"content":[{"type":"heading","content":["Ierusalema bona Iuda taudia edia kerere davana"]},{"type":"verse","number":1,"content":[{"text":"Kamonai! Lohiabada,","poem":1},{"lineBreak":true},{"text":"Siahu Ibounai Lohiabada ese,","poem":1},{"lineBreak":true},{"text":"harihari Ierusalema bona Iuda dekena amo,","poem":1},{"lineBreak":true},{"text":"edia goada havaraia gaudia do ia kokia.","poem":1},{"lineBreak":true},{"text":"Edia aniani ibounai,","poem":1},{"lineBreak":true},{"text":"bona edia ranu ibounai do ia kokia.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Edia goada taudia, bona tuari taudia,","poem":1},{"lineBreak":true},{"text":"kota biagudia bona peroveta taudia,","poem":1},{"lineBreak":true},{"text":"meamea taudia bona hanua taubadadia,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"tuari taudia 50 edia kapena,","poem":1},{"lineBreak":true},{"text":"bona dagi bada taudia,","poem":1},{"lineBreak":true},{"text":"sisiba namona henia taudia,","poem":1},{"lineBreak":true},{"text":"bona gaukara diba momo taudia,","poem":1},{"lineBreak":true},{"text":"bona meamea gaudia diba momo taudia.","poem":1},{"lineBreak":true},{"text":"Inai taudia ibounai be Lohiabada ese do ia kokia.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lohiabada ese memero sibona do ia abia,","poem":1},{"lineBreak":true},{"text":"Iuda bona Ierusalema edia lohia do ia halaodia.","poem":1},{"lineBreak":true},{"text":"Memero ese taunimanima do idia biagua.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Taunimanima ese ma taunimanima do idia hisihisi henia.","poem":1},{"lineBreak":true},{"text":"Tau ta ese ma tau ta do ia hisihisi henia,","poem":1},{"lineBreak":true},{"text":"bona eregabe tauna ese,","poem":1},{"lineBreak":true},{"text":"tau badana do ia hereva dika henia.","poem":1},{"lineBreak":true},{"text":"Ma lebulebu tauna ese,","poem":1},{"lineBreak":true},{"text":"kara maoromaoro tauna do ia hadikaia gwauraia.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Unai neganai danu tau ta ese,","poem":1},{"lineBreak":true},{"text":"iena tadikakana do ia abia hidi,","poem":1},{"lineBreak":true},{"text":"do ia gwau,","poem":1},{"lineBreak":true},{"text":"“Oi sibona be mai emu dabua,","poem":1},{"lineBreak":true},{"text":"namona be oi ese ai do oi gunalaia,","poem":1},{"lineBreak":true},{"text":"bona inai nega dika lalonai,","poem":1},{"lineBreak":true},{"text":"ai do oi durua.”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"To ia be unai dina dekenai do ia haere, do ia gwau,","poem":1},{"lineBreak":true},{"text":"“Lau ese umui lau durua diba lasi,","poem":1},{"lineBreak":true},{"text":"lau danu be mai egu aniani bona dabua lasi.","poem":1},{"lineBreak":true},{"text":"Emui gunalaia tauna lau do umui halaoa lasi.”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ierusalema bona Iuda do idia moru noho,","poem":1},{"lineBreak":true},{"text":"badina be edia taunimanima ese,","poem":1},{"lineBreak":true},{"text":"edia hereva bona edia kara,","poem":1},{"lineBreak":true},{"text":"dekena amo Lohiabada idia hanamoa lasi.","poem":1},{"lineBreak":true},{"text":"Idia ese Dirava ena vairana dekenai,","poem":1},{"lineBreak":true},{"text":"iena ladana idia hadikaia noho.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Edia kota biagudia ese,","poem":1},{"lineBreak":true},{"text":"idia ura henia taudia sibona idia durua noho,","poem":1},{"lineBreak":true},{"text":"bona idia ese tau haida idia hadikaia kava noho.","poem":1},{"lineBreak":true},{"text":"Inai kara gagevagageva dekena amo,","poem":1},{"lineBreak":true},{"text":"sibodia idia hadikaia noho,","poem":1},{"lineBreak":true},{"text":"bona inai dika be,","poem":1},{"lineBreak":true},{"text":"taunimanima edia vairanai idia karaia noho, hemarai lasi,","poem":1},{"lineBreak":true},{"text":"Sodoma taudia idia karaia bamona.","poem":1},{"lineBreak":true},{"text":"Idia be do idia dika momokani.","poem":1},{"lineBreak":true},{"text":"Edia kerere ese idia do ia hadikaia.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"To kara maoromaoro taudia do oi hamaoroa,","poem":1},{"lineBreak":true},{"text":"idia ese moale do idia davaria,","poem":1},{"lineBreak":true},{"text":"badina idia ese edia kara ena huahua,","poem":1},{"lineBreak":true},{"text":"be do idia ania.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"To kara dika taudia ese,","poem":1},{"lineBreak":true},{"text":"dika momokani do idia davaria.","poem":1},{"lineBreak":true},{"text":"Edia kara dika edia davana do idia abia.","poem":1},{"lineBreak":true},{"text":"Idia ese idia kara dika hegeregerena,","poem":1},{"lineBreak":true},{"text":"be Dirava ese idia dekenai do ia henia.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Egu bese taudia madi,","poem":1},{"lineBreak":true},{"text":"memero ese idia hisihisi henidia noho,","poem":1},{"lineBreak":true},{"text":"bona hahine ese idia biagudia noho.","poem":1},{"lineBreak":true},{"text":"Egu bese taudia e,","poem":1},{"lineBreak":true},{"text":"emui gunalaia taudia ese,","poem":1},{"lineBreak":true},{"text":"umui idia hakaua kerere noho,","poem":1},{"lineBreak":true},{"text":"vadaeni dala maoromaorona dekena amo umui raka siri noho.","poem":1}]},{"type":"heading","content":["Lohiabada ese iena bese taudia ia kota henia noho"]},{"type":"verse","number":13,"content":[{"text":"Lohiabada be kota kamonai totona ia gini hegaegae noho.","poem":1},{"lineBreak":true},{"text":"Ia ese iena bese taudia do ia kota henidia.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Lohiabada ese iena bese taubadadia,","poem":1},{"lineBreak":true},{"text":"bona lohia taudia ia kota henia hamatamaia noho, ia gwau,","poem":1},{"lineBreak":true},{"text":"“Umui ese egu vain uma umui hadikaia ore vadaeni.","poem":1},{"lineBreak":true},{"text":"Emui ruma edia lalonai,","poem":1},{"lineBreak":true},{"text":"ogogami taudia edia kohu,","poem":1},{"lineBreak":true},{"text":"umui dadia gaudia umui atoa vadaeni.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Badina dahaka egu bese taudia umui moia diho noho,","poem":1},{"lineBreak":true},{"text":"bona ogogami taudia umui dagedage henia noho momokani?","poem":1},{"lineBreak":true},{"text":"Lau Lohiabada,","poem":1},{"lineBreak":true},{"text":"Siahu Ibounai Lohiabada ese,","poem":1},{"lineBreak":true},{"text":"umui lau hamaoroa inai:","poem":1},{"lineBreak":true},{"text":"Umui be kerere momokani.”","poem":1}]},{"type":"heading","content":["Lohiabada ese Ierusalema ena hahine taudia ia sisiba henidia"]},{"type":"verse","number":16,"content":[{"text":"Lohiabada ia gwau:","poem":1},{"lineBreak":true},{"text":"“Siona hahine be idia hekokoroku noho,","poem":1},{"lineBreak":true},{"text":"bona idia raka neganai,","poem":1},{"lineBreak":true},{"text":"edia udubaubaudia be ataiai idia atodia noho.","poem":1},{"lineBreak":true},{"text":"Edia matadia be tau ibounai dekenai idia negea lao noho,","poem":1},{"lineBreak":true},{"text":"bona edia aedia dekenai,","poem":1},{"lineBreak":true},{"text":"tareko idia kwatua noho,","poem":1},{"lineBreak":true},{"text":"idia raka neganai,","poem":1},{"lineBreak":true},{"text":"regena do idia karaia totona.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Unai dainai lau Lohiabada ese,","poem":1},{"lineBreak":true},{"text":"unai Siona hahine edia kwaradia dekenai toto do lau atoa.","poem":1},{"lineBreak":true},{"text":"Lau Lohiabada ese edia huina ibounai do lau kokia ore.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Unai dina dekenai Lohiabada ese,","poem":1},{"lineBreak":true},{"text":"unai Ierusalema hahine idia hekokorokulaia gaudia do ia kokia momokani.","poem":1},{"lineBreak":true},{"text":"Edia gana,","poem":1},{"lineBreak":true},{"text":"edia kwara hagegea herahera,","poem":1},{"lineBreak":true},{"text":"edia ageva,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"edia imana herahera gaudia,","poem":1},{"lineBreak":true},{"text":"edia vairana koua dabua,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"edia kwara gaudia,","poem":1},{"lineBreak":true},{"text":"bona muramura mai bonana namo maua maragidia,","poem":1},{"lineBreak":true},{"text":"imana dekenai, bona gaba dekenai idia atoa gaudia,","poem":1},{"lineBreak":true},{"text":"be Lohiabada ese do ia kokia.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ima kwakikwaki rini,","poem":1},{"lineBreak":true},{"text":"bona udubaubau rini danu,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"edia dabua namodia, dabua latadia,","poem":1},{"lineBreak":true},{"text":"kouti, bona moni udaia puse,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"edia dabua severasevera,","poem":1},{"lineBreak":true},{"text":"edia dabua aukadia,","poem":1},{"lineBreak":true},{"text":"kwara kumia dabua, bona edia muko,","poem":1},{"lineBreak":true},{"text":"ibounai be Lohiabada ese do ia abia lao ore.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Mai bonana namo muramura,","poem":1},{"lineBreak":true},{"text":"be bodaga ese iena gabu do ia abia,","poem":1},{"lineBreak":true},{"text":"bona gaba ena dabua namona,","poem":1},{"lineBreak":true},{"text":"be kwanau aukana ese iena gabu do ia abia.","poem":1},{"lineBreak":true},{"text":"Huina namona,","poem":1},{"lineBreak":true},{"text":"be kebere ese iena gabu do ia abia,","poem":1},{"lineBreak":true},{"text":"bona hairai ena gabu dekenai,","poem":1},{"lineBreak":true},{"text":"hemarai do ia noho.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ierusalema hanua e,","poem":1},{"lineBreak":true},{"text":"oiemu tuari taudia be tuari kaia dekena amo do idia mase.","poem":1},{"lineBreak":true},{"text":"Oiemu goada taudia ibounai,","poem":1},{"lineBreak":true},{"text":"be tuari lalonai do idia mase.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Oiemu kohu ibounai do idia abia.","poem":1},{"lineBreak":true},{"text":"Oi be hahine ta bamona do oi noho,","poem":1},{"lineBreak":true},{"text":"iena dabua ibounai idia kokia,","poem":1},{"lineBreak":true},{"text":"bona ia be tano dekenai ia helai kava noho.","poem":1},{"lineBreak":true},{"text":"Oiemu hanua ena magu iduara badana ese inai kara do ia itaia,","poem":1},{"lineBreak":true},{"text":"bona mai ena lalohisihisi danu do ia tai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/ISA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/ISA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}