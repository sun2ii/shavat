{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"JOB","translationId":"hmo_png","name":"IOBU","commonName":"IOBU","title":"IOBU","order":18,"numberOfChapters":42,"sha256":"ea816979df82923218d8902bc41affbb84977938e36ac53c934c8aae5acff2b0","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hmo_png/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":25,"content":[{"type":"heading","content":["Biledada ena hereva ihatoina: Dirava ena vairanai, tau ta ia maoromaoro diba lasi"]},{"type":"verse","number":1,"content":["Vadaeni Biledada, Suhi tauna, ia haere, ia gwau,"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Dirava ena siahu be King siahuna momokani.","poem":1},{"lineBreak":true},{"text":"Ia ese taunimanima ibounai ia hagaria noho.","poem":1},{"lineBreak":true},{"text":"Ia ese iena guba dekenai maino namona ia karaia.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tau ta ese,","poem":1},{"lineBreak":true},{"text":"Dirava ena tuari anerudia ia duahia diba, a?","poem":1},{"lineBreak":true},{"text":"Tau ta ena latanai,","poem":1},{"lineBreak":true},{"text":"be Dirava ena diari ia kamokau lasi, a?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Unai dainai tau ta be,","poem":1},{"lineBreak":true},{"text":"edena bamona Dirava ena vairanai do ia maoromaoro diba, a?","poem":1},{"lineBreak":true},{"text":"Hahine ena bogana dekena amo ia vara tauna,","poem":1},{"lineBreak":true},{"text":"be edena bamona do ia goevagoeva diba?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Badina Dirava ena vairana dekenai,","poem":1},{"lineBreak":true},{"text":"hua be ia diari lasi,","poem":1},{"lineBreak":true},{"text":"bona, hisiu danu be idia goevagoeva lasi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Unai bamona dainai,","poem":1},{"lineBreak":true},{"text":"edena bamona tau ta be Dirava ena vairanai ia goevagoeva diba?","poem":1},{"lineBreak":true},{"text":"Taunimanima be biluga sibona bamona,","poem":1},{"lineBreak":true},{"text":"Dirava ena vairana dekenai.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}