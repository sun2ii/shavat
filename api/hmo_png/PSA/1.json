{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"PSA","translationId":"hmo_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"743d5bb4171bfe8132e5ed8cd9e14b414e474687449102dcce2d363eb51cab6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hmo_png/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":1,"content":[{"type":"heading","content":["Moale korikori"]},{"type":"verse","number":1,"content":[{"text":"Inai bamona taudia be idia moale momokani:","poem":1},{"lineBreak":true},{"text":"Idia ese kara dika taudia edia sisiba,","poem":1},{"lineBreak":true},{"text":"bona edia laloa idia abia dae lasi.","poem":1},{"lineBreak":true},{"text":"Idia ese kerere taudia edia kara bamona idia karaia lasi,","poem":1},{"lineBreak":true},{"text":"Bona Dirava idia ura lasi taudia danu,","poem":1},{"lineBreak":true},{"text":"idia noho hebou lasi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma inai taudia ese,","poem":1},{"lineBreak":true},{"text":"Lohiabada ena Taravatu dekenai idia moale,","poem":1},{"lineBreak":true},{"text":"bona Lohiabada ena Taravatu idia laloa,","poem":1},{"lineBreak":true},{"text":"dina bona hanuaboi ibounai lalonai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma inai taudia be,","poem":1},{"lineBreak":true},{"text":"sinavai badinai idia hadoa audia bamona,","poem":1},{"lineBreak":true},{"text":"edia huahua atoa neganai,","poem":1},{"lineBreak":true},{"text":"idia ese anina idia atoa bada herea.","poem":1},{"lineBreak":true},{"text":"Edia raurau danu do idia kakoro lasi.","poem":1},{"lineBreak":true},{"text":"Edia gaukara ibounai be ena anina ia vara,","poem":1},{"lineBreak":true},{"text":"bona mai edia kwalimu danu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kara dika taudia be unai bamona lasi.","poem":1},{"lineBreak":true},{"text":"Idia be uiti ena momoru bamona.","poem":1},{"lineBreak":true},{"text":"Lai ese idia ia hodaia lao.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kara dika taudia be Dirava ese,","poem":1},{"lineBreak":true},{"text":"Kota Bada lalonai do ia kota henidia.","poem":1},{"lineBreak":true},{"text":"Kerere idia karaia taudia be,","poem":1},{"lineBreak":true},{"text":"Dirava ena taudia danu do idia noho hebou lasi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kara maoromaoro taudia be,","poem":1},{"lineBreak":true},{"text":"Lohiabada ese ia hakaudia bona ia naridia,","poem":1},{"lineBreak":true},{"text":"to kara dika taudia edia dala,","poem":1},{"lineBreak":true},{"text":"ena dokona be mase momokani.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}