{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"PSA","translationId":"hmo_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"743d5bb4171bfe8132e5ed8cd9e14b414e474687449102dcce2d363eb51cab6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hmo_png/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":100,"content":[{"type":"heading","content":["Lohiabada ena ladana abia isi ena ane"]},{"type":"verse","number":1,"content":[{"text":"Tanobada taudia ibounai e,","poem":1},{"lineBreak":true},{"text":"umui ese Lohiabada hanamoa totona ane do umui abia!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lohiabada do umui tomadiho henia,","poem":1},{"lineBreak":true},{"text":"mai emui moale danu.","poem":1},{"lineBreak":true},{"text":"Lohiabada ena vairana dekenai umui mai, mai moale anedia danu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Do umui diba momokani, Lohiabada sibona be Dirava.","poem":1},{"lineBreak":true},{"text":"Ia sibona ese ita ia karaia, bona ita be iena.","poem":1},{"lineBreak":true},{"text":"Ita be iena bese taudia,","poem":1},{"lineBreak":true},{"text":"ita be iena mamoe, ia ubua gaudia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lohiabada ena Dubu Helaga lalonai do ita raka vareai,","poem":1},{"lineBreak":true},{"text":"mai tanikiu danu.","poem":1},{"lineBreak":true},{"text":"Iena Ruma lalonai Lohiabada ena ladana do ita abia isi,","poem":1},{"lineBreak":true},{"text":"Lohiabada do ita tanikiu henia.","poem":1},{"lineBreak":true},{"text":"Iena ladana do ita hanamoa bada,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"badina be Lohiabada ena kara be namo.","poem":1},{"lineBreak":true},{"text":"Iena lalokau bona bogahisihisi,","poem":1},{"lineBreak":true},{"text":"be do idia noho ela bona hanaihanai.","poem":1},{"lineBreak":true},{"text":"Ia ese iena hereva bona iena kara,","poem":1},{"lineBreak":true},{"text":"be do ia haidaua lasi ela bona hanaihanai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}