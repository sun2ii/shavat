{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"PSA","translationId":"hmo_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"743d5bb4171bfe8132e5ed8cd9e14b414e474687449102dcce2d363eb51cab6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hmo_png/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":114,"content":[{"type":"heading","content":["Pasova ena ane"]},{"type":"verse","number":1,"content":[{"text":"Israela taudia be Aigupito idia rakatania.","poem":1},{"lineBreak":true},{"text":"Iakobo ena besena,","poem":1},{"lineBreak":true},{"text":"be gado idau taudia edia tano idia rakatania.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Unai neganai Iuda be Lohiabada ena helaga taudia,","poem":1},{"lineBreak":true},{"text":"bona Israela danu be Lohiabada ena basileia korikori.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Davara Kakakaka ese gau ta ia itaia, vadaeni ia heau!","poem":1},{"lineBreak":true},{"text":"Ioridane Sinavai ese iena ranu ena heau ia hadokoa,","poem":1},{"lineBreak":true},{"text":"ena ranu ia gini noho!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ororo badadia be nanigosi bamona idia roho lao, roho lao noho!","poem":1},{"lineBreak":true},{"text":"Bona ororo maragidia,","poem":1},{"lineBreak":true},{"text":"be mamoe natudia bamona idia roho lao, roho lao noho!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Davara e,","poem":1},{"lineBreak":true},{"text":"dahaka ia vara, vadaeni oi heau?","poem":1},{"lineBreak":true},{"text":"Bona Ioridane Sinavai e,","poem":1},{"lineBreak":true},{"text":"badina dahaka oiemu ranu ena heau oi hadokoa?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ororo badadia e,","poem":1},{"lineBreak":true},{"text":"badina dahaka nanigosi bamona umui roho lao?","poem":1},{"lineBreak":true},{"text":"Ororo maragidia e,","poem":1},{"lineBreak":true},{"text":"badina dahaka mamoe natudia bamona umui roho lao?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tanobada e,","poem":1},{"lineBreak":true},{"text":"Lohiabada ena vairanai do oi heudeheude,","poem":1},{"lineBreak":true},{"text":"Iakobo ena Dirava ena vairanai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ia ese nadi badana be ranu gabuna ia halaoa,","poem":1},{"lineBreak":true},{"text":"bona ia ese ororo ena nadi be ranu ia lohilohi gabuna ia halaoa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}