{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"PSA","translationId":"hmo_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"743d5bb4171bfe8132e5ed8cd9e14b414e474687449102dcce2d363eb51cab6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hmo_png/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":12,"content":[{"type":"heading","content":["Davida ese durua totona Dirava ia noia"]},{"type":"verse","number":1,"content":[{"text":"Lohiabada e, ai dekenai durua oi henia!","poem":1},{"lineBreak":true},{"text":"Badina Dirava lalokau henia tauna,","poem":1},{"lineBreak":true},{"text":"be ta ia noho lasi.","poem":1},{"lineBreak":true},{"text":"Kara maoromaoro mai momokani taudia,","poem":1},{"lineBreak":true},{"text":"be idia boio vadaeni.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Taunimanima ibounai be,","poem":1},{"lineBreak":true},{"text":"idia ta ta dekenai idia hereva koikoi noho.","poem":1},{"lineBreak":true},{"text":"Idia ese hanamoa koikoi,","poem":1},{"lineBreak":true},{"text":"bona laloa rua dekena amo,","poem":1},{"lineBreak":true},{"text":"sibodia ta ta dekenai idia koia noho.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Lohiabada e, hanamoa koikoi taudia,","poem":1},{"lineBreak":true},{"text":"edia hereva do oi hadokoa,","poem":1},{"lineBreak":true},{"text":"bona edia malana dekena amo,","poem":1},{"lineBreak":true},{"text":"hekokoroku hereva idia gwauraia taudia,","poem":1},{"lineBreak":true},{"text":"be do oi koua.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Badina be idia gwau,","poem":1},{"lineBreak":true},{"text":"“Iseda hereva dekena amo do ita kwalimu.","poem":1},{"lineBreak":true},{"text":"Iseda uduna edia hereva,","poem":1},{"lineBreak":true},{"text":"be ita ese ita biagua noho.","poem":1},{"lineBreak":true},{"text":"Daika ese ita ia koua diba?”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"To Lohiabada be ia gwau,","poem":1},{"lineBreak":true},{"text":"“Ogogami taudia be,","poem":1},{"lineBreak":true},{"text":"haida ese idia dagedage henia noho,","poem":1},{"lineBreak":true},{"text":"bona gau lasi taudia,","poem":1},{"lineBreak":true},{"text":"be hisihisi dainai idia tai noho.","poem":1},{"lineBreak":true},{"text":"Unai dainai lau be do lau toreisi,","poem":1},{"lineBreak":true},{"text":"bona idia ura henia mauri namona gabuna,","poem":1},{"lineBreak":true},{"text":"dekenai idia do lau atoa.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lohiabada ena gwauhamata,","poem":1},{"lineBreak":true},{"text":"be ita abidadama henia diba.","poem":1},{"lineBreak":true},{"text":"Iena gwauhamata be momokani,","poem":1},{"lineBreak":true},{"text":"siliva ia momokani bamona,","poem":1},{"lineBreak":true},{"text":"lahi dekena amo,","poem":1},{"lineBreak":true},{"text":"idia hagoevaia nega 7 siliva hegeregerena.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lohiabada e,","poem":1},{"lineBreak":true},{"text":"oi ese ai do oi gimaia bona naria.","poem":1},{"lineBreak":true},{"text":"Dika taudia dekena amo,","poem":1},{"lineBreak":true},{"text":"ai do oi hamauria,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"badina gabu ibounai dekenai,","poem":1},{"lineBreak":true},{"text":"tau dikadia idia loaloa noho,","poem":1},{"lineBreak":true},{"text":"bona idia ese dika rohoroho gaudia,","poem":1},{"lineBreak":true},{"text":"idia matauraia noho.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}