{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"PSA","translationId":"hmo_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"743d5bb4171bfe8132e5ed8cd9e14b414e474687449102dcce2d363eb51cab6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hmo_png/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":120,"content":[{"type":"heading","content":["Idau tano dekenai ia noho tauna ena guriguri"]},{"type":"verse","number":1,"content":[{"text":"Egu lalona ia hisihisi neganai,","poem":1},{"lineBreak":true},{"text":"lau ese Lohiabada dekenai lau tai henia,","poem":1},{"lineBreak":true},{"text":"bona ia ese lau dekenai ia haere henia.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lau gwau,","poem":1},{"lineBreak":true},{"text":"“Lohiabada e,","poem":1},{"lineBreak":true},{"text":"koikoi taudia dekena amo,","poem":1},{"lineBreak":true},{"text":"bona samania koikoi taudia dekena amo lau do oi hamauria.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Koikoi tauna e, Lohiabada ese oi dekenai dahaka do ia karaia?","poem":1},{"lineBreak":true},{"text":"Oiemu kerere davana be edena dala dekenai do ia henia?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ia ese tuari tauna ena diba mai edia matana,","poem":1},{"lineBreak":true},{"text":"dekena amo oi do ia pidia,","poem":1},{"lineBreak":true},{"text":"bona ia ese lahi gidadia,","poem":1},{"lineBreak":true},{"text":"siahu herea gaudia oiemu latanai do ia bubua.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lau be umui dika taudia emui huanai lau noho,","poem":1},{"lineBreak":true},{"text":"bona egu noho be dika,","poem":1},{"lineBreak":true},{"text":"Meseka o Kedara dekenai lau noho ena dika bamona.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Maino idia ura henia lasi taudia edia huanai,","poem":1},{"lineBreak":true},{"text":"be lau noho nega daudau momokani.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lau be maino lau ura,","poem":1},{"lineBreak":true},{"text":"to lau be inai bamona lau hereva neganai,","poem":1},{"lineBreak":true},{"text":"idia be tuari idia ura.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}