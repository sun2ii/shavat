eBreak":true},{"text":"lasi momokani.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lohiabada ese oi do ia gimaia.","poem":1},{"lineBreak":true},{"text":"Ia be oiemu badibadinai ia noho,","poem":1},{"lineBreak":true},{"text":"oi ia naria noho.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dina neganai, dina ena siahu ese oi do ia hagorerea lasi,","poem":1},{"lineBreak":true},{"text":"bona hanuaboi neganai hua ese oi do ia hadikaia lasi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lohiabada ese dika ibounai dekena amo oi ia naria noho.","poem":1},{"lineBreak":true},{"text":"Ia ese oiemu mauri do ia gimaia.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Oiemu ruma oi rakatania neganai,","poem":1},{"lineBreak":true},{"text":"Lohiabada ese oi do ia naria,","poem":1},{"lineBreak":true},{"text":"bona oi giroa mai neganai danu,","poem":1},{"lineBreak":true},{"text":"ia ese oi do ia gimaia,","poem":1},{"lineBreak":true},{"text":"harihari ia lao bona hanaihanai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}