{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"PSA","translationId":"hmo_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"743d5bb4171bfe8132e5ed8cd9e14b414e474687449102dcce2d363eb51cab6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hmo_png/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":122,"content":[{"type":"heading","content":["Ierusalema idia hanamoa ane"]},{"type":"verse","number":1,"content":[{"text":"Lau dekenai idia hereva, idia gwau,","poem":1},{"lineBreak":true},{"text":"“Lohiabada ena Ruma dekenai do ita lao.”","poem":1},{"lineBreak":true},{"text":"Inai bamona idia hereva neganai,","poem":1},{"lineBreak":true},{"text":"lau be mai moale bada danu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Vadaeni harihari ita be Ierusalema dekenai ita noho,","poem":1},{"lineBreak":true},{"text":"Ierusalema ena magu ikoukou edia lalonai ita gini noho.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ierusalema be idia ese idia haginia lou, hanua badana.","poem":1},{"lineBreak":true},{"text":"Iena toana be namo,","poem":1},{"lineBreak":true},{"text":"badina be idia haginia namonamo vadaeni.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Israela ena iduhu taudia ibounai be iniseni idia mai noho.","poem":1},{"lineBreak":true},{"text":"Lohiabada do idia tanikiu henia totona,","poem":1},{"lineBreak":true},{"text":"iena oda hereva gunana hegeregerena.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Inai Ierusalema dekenai be Israela ena king taudia ese,","poem":1},{"lineBreak":true},{"text":"edia bese taudia idia kota henia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ierusalema ena maino totona do umui guriguri.","poem":1},{"lineBreak":true},{"text":"Lau ura Ierusalema idia ura henia taudia,","poem":1},{"lineBreak":true},{"text":"be do idia noho mai maino danu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lau ura maino be Ierusalema ena magu lalonai do ia noho,","poem":1},{"lineBreak":true},{"text":"bona lau ura Ierusalema ena kohoro lalonai,","poem":1},{"lineBreak":true},{"text":"taunimanima ese mauri do idia davaria.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lau ese egu turana bona egu varavara lau laloa noho,","poem":1},{"lineBreak":true},{"text":"bona Ierusalema dekenai lau hereva, lau gwau,","poem":1},{"lineBreak":true},{"text":"“Maino be oiemu lalona dekenai do ia noho be namo.”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lau be Lohiabada, iseda Dirava ena Ruma lau laloa noho.","poem":1},{"lineBreak":true},{"text":"Unai dainai Dirava lau noia noho,","poem":1},{"lineBreak":true},{"text":"ia ese Ierusalema do ia hanamoa bada.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}