{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"PSA","translationId":"hmo_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"743d5bb4171bfe8132e5ed8cd9e14b414e474687449102dcce2d363eb51cab6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hmo_png/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":123,"content":[{"type":"heading","content":["Bogahisihisi totona guriguri ta"]},{"type":"verse","number":1,"content":[{"text":"Lohiabada e, egu matana be oi dekenai lau negea noho.","poem":1},{"lineBreak":true},{"text":"Oi be guba dekenai oi helai noho,","poem":1},{"lineBreak":true},{"text":"guba ena King.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hesiai tauna ese iena biaguna ia abidadama henia noho,","poem":1},{"lineBreak":true},{"text":"bona hesiai kekeni ese,","poem":1},{"lineBreak":true},{"text":"iena biaguna hahine ia abidadama henia noho hegeregerena,","poem":1},{"lineBreak":true},{"text":"ai ese unai bamona oi dekenai do ai abidadama henia noho,","poem":1},{"lineBreak":true},{"text":"ela bona oi ese ai dekenai oi bogahisihisi henia.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lohiabada e, ai dekenai do oi bogahisihisi,","poem":1},{"lineBreak":true},{"text":"badina be taunimanima ese ai idia kirikirilaia bada vadaeni.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nega daudau herea,","poem":1},{"lineBreak":true},{"text":"be noho kava bona mai edia hekwarahi lasi taudia ese,","poem":1},{"lineBreak":true},{"text":"ai idia hevaseha henia,","poem":1},{"lineBreak":true},{"text":"bona hekokoroku taudia be mai dagedage danu,","poem":1},{"lineBreak":true},{"text":"ai dekenai idia hereva dika vadaeni.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}