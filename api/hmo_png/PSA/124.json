{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"PSA","translationId":"hmo_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"743d5bb4171bfe8132e5ed8cd9e14b414e474687449102dcce2d363eb51cab6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hmo_png/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":124,"content":[{"type":"heading","content":["Dirava be iena bese taudia edia Hamauria Tauna"]},{"type":"verse","number":1,"content":[{"text":"Bema Lohiabada ese ita ia durua lasi neganai,","poem":1},{"lineBreak":true},{"text":"ita be edena bamona do ita karaia?","poem":1},{"lineBreak":true},{"text":"Israela taudia ese inai henanadai idia haere henia be namo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ita dekenai idia dagedage taudia ese ita idia tuari henia,","poem":1},{"lineBreak":true},{"text":"bona bema Lohiabada ese ita ia durua lasi neganai,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"unai dagedage taudia ese ita do idia hadikaia ore,","poem":1},{"lineBreak":true},{"text":"idia edia badu mai siahu bada dekena amo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Unai neganai abata ese ita do ia abia lao,","poem":1},{"lineBreak":true},{"text":"bona ranu bada ese ita do ia koua momokani.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hurehure badana ese ita do ia koua,","poem":1},{"lineBreak":true},{"text":"vadaeni ita be do ita mase ore,","poem":1},{"lineBreak":true},{"text":"to inai bamona ia vara lasi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ita ese Lohiabada do ita tanikiu henia be namo,","poem":1},{"lineBreak":true},{"text":"Ia ese ita idia hadikaia gwauraia taudia ia koua.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ita ese idia dekena amo ita heau mauri,","poem":1},{"lineBreak":true},{"text":"manu ese labana tauna ena tarapu dekena amo ia heau mauri bamona.","poem":1},{"lineBreak":true},{"text":"Tarapu ia makohia vadaeni,","poem":1},{"lineBreak":true},{"text":"bona ita heau mauri vadaeni.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lohiabada ese ita ia durua noho.","poem":1},{"lineBreak":true},{"text":"Ia ese guba bona tanobada ia karaia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}