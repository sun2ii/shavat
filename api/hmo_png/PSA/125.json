Dirava ena bese taudia danu ese kara dika do idia karaia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lohiabada e,","poem":1},{"lineBreak":true},{"text":"kara namo taudia do oi hanamoa.","poem":1},{"lineBreak":true},{"text":"Oiemu taravatu idia kamonai henia noho taudia do oi hanamoa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"To oi ese kara dika taudia edia dika davana oi henia neganai,","poem":1},{"lineBreak":true},{"text":"mani emu kara,","poem":1},{"lineBreak":true},{"text":"oiemu dala idia rakatania taudia danu edia dika davana do oi henia.","poem":1},{"lineBreak":true},{"text":"Israela dekenai maino ia noho, be namo!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}