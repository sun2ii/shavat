{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"PSA","translationId":"hmo_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"743d5bb4171bfe8132e5ed8cd9e14b414e474687449102dcce2d363eb51cab6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hmo_png/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":126,"content":[{"type":"heading","content":["Israela taudia ese Dirava idia noia do ia hamauridia"]},{"type":"verse","number":1,"content":[{"text":"Lohiabada ese ita ia abia mai lou Siona dekenai neganai,","poem":1},{"lineBreak":true},{"text":"ita be nihi ita abia noho taudia bamona.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Unai neganai ita kiri bada,","poem":1},{"lineBreak":true},{"text":"bona mai moale bada danu ane ita abia!","poem":1},{"lineBreak":true},{"text":"Bona idau bese taudia ese ita idia herevalaia, idia gwau,","poem":1},{"lineBreak":true},{"text":"“Lohiabada ese kara badadia idia totona ia karaia vadaeni.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Momokani!","poem":1},{"lineBreak":true},{"text":"Ia ese kara badadia momokani ita totona ia karaia.","poem":1},{"lineBreak":true},{"text":"Unai dainai ita be mai moale bada danu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lohiabada e, mani emu kara,","poem":1},{"lineBreak":true},{"text":"ai do oi hakaua lou aiemai tano dekenai.","poem":1},{"lineBreak":true},{"text":"Ai do oi mailaia lou,","poem":1},{"lineBreak":true},{"text":"medu ese sinavai kaukau dekenai ranu ia mailaia lou bamona.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Idia hadohado neganai,","poem":1},{"lineBreak":true},{"text":"madi edia matana ena ranu ia diho taudia,","poem":1},{"lineBreak":true},{"text":"be gabeai mai edia moale danu,","poem":1},{"lineBreak":true},{"text":"anina do idia gogoa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Io, momokani,","poem":1},{"lineBreak":true},{"text":"uhe idia abia lao neganai idia tai noho taudia,","poem":1},{"lineBreak":true},{"text":"be mai moale danu do idia giroa mai,","poem":1},{"lineBreak":true},{"text":"bona anina idia mailaia neganai ane do idia abia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}