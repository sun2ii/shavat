{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"PSA","translationId":"hmo_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"743d5bb4171bfe8132e5ed8cd9e14b414e474687449102dcce2d363eb51cab6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hmo_png/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":128,"content":[{"type":"heading","content":["Lohiabada kamonai henia kara ena davana namona"]},{"type":"verse","number":1,"content":[{"text":"Lohiabada dekenai idia gari noho taudia ibounai be namo,","poem":1},{"lineBreak":true},{"text":"badina iena dala dekenai idia raka noho.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Oiemu gaukara ena davana do oi davaria.","poem":1},{"lineBreak":true},{"text":"Do oi moale, bona oiemu noho do ia namo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Oiemu ruma dekenai oiemu adavana,","poem":1},{"lineBreak":true},{"text":"be vain auna mai ena huahua momo bamona.","poem":1},{"lineBreak":true},{"text":"Oiemu natuna memero be olive au matamatadia bamona,","poem":1},{"lineBreak":true},{"text":"oiemu aniani patana do idia helai hagegea noho.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Momokani, tau ta bema Lohiabada ia kamonai henia neganai,","poem":1},{"lineBreak":true},{"text":"ia ese hanamoa inai bamona do ia davaria.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Siona dekena amo Lohiabada ese oi do ia hanamoa!","poem":1},{"lineBreak":true},{"text":"Bona oiemu mauri dinadia ibounai lalonai, do oi itaia,","poem":1},{"lineBreak":true},{"text":"Ierusalema ena noho be namo herea.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lau ura oiemu mauri dinadia be momo,","poem":1},{"lineBreak":true},{"text":"vadaeni oiemu tubuna do oi itadia!","poem":1},{"lineBreak":true},{"text":"Israela dekenai maino ia noho, be namo!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}