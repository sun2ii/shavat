{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"PSA","translationId":"hmo_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"743d5bb4171bfe8132e5ed8cd9e14b414e474687449102dcce2d363eb51cab6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hmo_png/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":130,"content":[{"type":"heading","content":["Tau ta ese Dirava ia noia, do ia durua"]},{"type":"verse","number":1,"content":[{"text":"Lohiabada e, egu lalona ia metau momokani dainai,","poem":1},{"lineBreak":true},{"text":"oi dekenai lau tai noho!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lohiabada e,","poem":1},{"lineBreak":true},{"text":"egu taitai mani do oi kamonai!","poem":1},{"lineBreak":true},{"text":"Durua totona lau noinoi noho,","poem":1},{"lineBreak":true},{"text":"be mani do oi kamonai!","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bema oi ese aiemai kara dika ibounai oi duahia neganai,","poem":1},{"lineBreak":true},{"text":"daika ese oiemu kota lalonai ia kwalimu diba?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"To oi ese aiemai dika oi gwauatao noho,","poem":1},{"lineBreak":true},{"text":"unai dainai ai ese oi dekenai ai gari henia be namo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lau ura dikadika Lohiabada ese lau do ia durua,","poem":1},{"lineBreak":true},{"text":"bona iena hereva lau abidadama henia noho.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lau ese Lohiabada totona lau naria noho,","poem":1},{"lineBreak":true},{"text":"lau ura bada ia ese lau do ia durua.","poem":1},{"lineBreak":true},{"text":"Bona inai Lohiabada dekenai lau naria kara ese,","poem":1},{"lineBreak":true},{"text":"hanua idia gimaia taudia edia naria kara ia hereaia noho,","poem":1},{"lineBreak":true},{"text":"idia ese daba rere totona idia naria neganai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Israela taudia e,","poem":1},{"lineBreak":true},{"text":"Lohiabada do umui abidadama henia,","poem":1},{"lineBreak":true},{"text":"badina iena lalokau bona bogahisihisi idia noho hanaihanai,","poem":1},{"lineBreak":true},{"text":"bona nega ibounai ia ura taunimanima do ia hamauridia.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lohiabada ese iena bese, Israela taudia,","poem":1},{"lineBreak":true},{"text":"edia kara dika ibounai dekena amo do ia hamauridia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}