":true},{"text":"hari inai negana dekena amo ia lao bona hanaihanai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}