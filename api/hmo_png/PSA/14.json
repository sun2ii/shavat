{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"PSA","translationId":"hmo_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"743d5bb4171bfe8132e5ed8cd9e14b414e474687449102dcce2d363eb51cab6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hmo_png/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":14,"content":[{"type":"heading","content":["Taunimanima edia kara dika"]},{"type":"verse","number":1,"content":[{"text":"Kavakava taudia ese,","poem":1},{"lineBreak":true},{"text":"inai bamona idia laloa, idia gwau,","poem":1},{"lineBreak":true},{"text":"“Dirava be ia noho lasi.”","poem":1},{"lineBreak":true},{"text":"Idia ibounai be dika,","poem":1},{"lineBreak":true},{"text":"kara mirodia idia karaia vadaeni.","poem":1},{"lineBreak":true},{"text":"Kara namo karaia tauna be ta lasi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lohiabada be guba dekena amo,","poem":1},{"lineBreak":true},{"text":"iena matana ia negea,","poem":1},{"lineBreak":true},{"text":"taunimanima edia kara ia itaia.","poem":1},{"lineBreak":true},{"text":"Ia ese aonega taudia ia tahua.","poem":1},{"lineBreak":true},{"text":"Ia dekenai idia tomadiho taudia ia tahua.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"To idia ibounai ese,","poem":1},{"lineBreak":true},{"text":"kara dika idia karaia vadaeni.","poem":1},{"lineBreak":true},{"text":"Idia ibounai be mai edia kerere.","poem":1},{"lineBreak":true},{"text":"Idia ta lasi ese kara namona ia karaia.","poem":1},{"lineBreak":true},{"text":"Lasi bona lasi momokani.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lohiabada ese ia henanadai, ia gwau:","poem":1},{"lineBreak":true},{"text":"“Inai kara dika taudia idia diba lasi, a?","poem":1},{"lineBreak":true},{"text":"Aonega do idia abia diba lasi, a?","poem":1},{"lineBreak":true},{"text":"Idia ese lauegu bese taudia idia ania noho,","poem":1},{"lineBreak":true},{"text":"beredi idia ania bamona.","poem":1},{"lineBreak":true},{"text":"Bona lau dekenai idia guriguri lasi,","poem":1},{"lineBreak":true},{"text":"lasi momokani.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"To gari bada ese idia do ia dogoatao,","poem":1},{"lineBreak":true},{"text":"badina Dirava be,","poem":1},{"lineBreak":true},{"text":"ia dekenai idia kamonai henia taudia danu ia noho.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kara dika taudia ese,","poem":1},{"lineBreak":true},{"text":"manau taudia idia hahemaraia,","poem":1},{"lineBreak":true},{"text":"to Lohiabada ese,","poem":1},{"lineBreak":true},{"text":"unai manau taudia ia naria noho.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Egu noinoi be inai:","poem":1},{"lineBreak":true},{"text":"Lau ura Israela ena hamauria dalana,","poem":1},{"lineBreak":true},{"text":"be Siona dekena amo do ia mai!","poem":1},{"lineBreak":true},{"text":"Lohiabada ese iena bese taudia edia mauri,","poem":1},{"lineBreak":true},{"text":"be do ia hanamoa lou neganai,","poem":1},{"lineBreak":true},{"text":"Israela taudia be do idia moale bada herea.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}