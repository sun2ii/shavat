{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"PSA","translationId":"hmo_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"743d5bb4171bfe8132e5ed8cd9e14b414e474687449102dcce2d363eb51cab6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hmo_png/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":148,"content":[{"type":"heading","content":["Tanobada bona guba dekenai idia noho gaudia ibounai ese Dirava idia hanamoa be namo"]},{"type":"verse","number":1,"content":[{"text":"Lohiabada ena ladana do umui hanamoa!","poem":1},{"lineBreak":true},{"text":"Guba dekenai, ataiai dekenai umui noho taudia ibounai e,","poem":1},{"lineBreak":true},{"text":"Lohiabada do umui hanamoa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lohiabada ena aneru ibounai e,","poem":1},{"lineBreak":true},{"text":"Lohiabada ena ladana do umui abia isi,","poem":1},{"lineBreak":true},{"text":"Lohiabada ena tuari taudia,","poem":1},{"lineBreak":true},{"text":"guba dekenai umui noho,","poem":1},{"lineBreak":true},{"text":"Lohiabada ena ladana do umui abia isi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dina bona hua e,","poem":1},{"lineBreak":true},{"text":"Lohiabada do umui hanamoa.","poem":1},{"lineBreak":true},{"text":"Hisiu mai emui diaridiari e,","poem":1},{"lineBreak":true},{"text":"Lohiabada do umui hanamoa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Guba ataiai momokani,","poem":1},{"lineBreak":true},{"text":"Lohiabada ena ladana do umui abia isi.","poem":1},{"lineBreak":true},{"text":"Guba ena ataiai dekenai ia noho ranu e,","poem":1},{"lineBreak":true},{"text":"Lohiabada ena ladana do umui hanamoa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Inai gaudia ibounai ese Lohiabada ena ladana idia abia isi be namo,","poem":1},{"lineBreak":true},{"text":"badina Lohiabada ese ia oda dainai, idia be idia vara.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lohiabada ena hereva dekena amo,","poem":1},{"lineBreak":true},{"text":"ia ese edia gabu korikori dekenai idia ia atoa,","poem":1},{"lineBreak":true},{"text":"idia noho hanaihanai.","poem":1},{"lineBreak":true},{"text":"Lohiabada ese noho hanaihanai taravatu ia atoa,","poem":1},{"lineBreak":true},{"text":"ta ese ia koua diba lasi gauna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tanobada dekenai noho gaudia ese Lohiabada do idia hanamoa.","poem":1},{"lineBreak":true},{"text":"Davara dekenai idia noho mauri gaudia badadia,","poem":1},{"lineBreak":true},{"text":"dobu momokani gabudia dekenai gaudia ibounai danu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kevaru bona aisi ena medu, sinou bona ori,","poem":1},{"lineBreak":true},{"text":"lai goadadia,","poem":1},{"lineBreak":true},{"text":"iena oda idia kamonai henia gaudia ibounai,","poem":1},{"lineBreak":true},{"text":"ese Lohiabada do idia hanamoa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ororo badadia bona maragidia ibounai,","poem":1},{"lineBreak":true},{"text":"huahua audia bona sida audia ibounai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Uda boroma ibounai,","poem":1},{"lineBreak":true},{"text":"bona boromakau ibounai,","poem":1},{"lineBreak":true},{"text":"gaigai bona huala gaudia,","poem":1},{"lineBreak":true},{"text":"bona ataiai manudia ibounai,","poem":1},{"lineBreak":true},{"text":"Lohiabada ena ladana do umui hanamoa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"King ibounai,","poem":1},{"lineBreak":true},{"text":"bona bese ibounai,","poem":1},{"lineBreak":true},{"text":"king ena natuna taudia,","poem":1},{"lineBreak":true},{"text":"bona lohia taudia idauidau ibounai.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ulato bona uhau,","poem":1},{"lineBreak":true},{"text":"buruka taudia,","poem":1},{"lineBreak":true},{"text":"bona natuna maragidia danu,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"namona be idia ibounai ese,","poem":1},{"lineBreak":true},{"text":"Lohiabada ena ladana do idia hanamoa bada!","poem":1},{"lineBreak":true},{"text":"Iena ladana badana ese,","poem":1},{"lineBreak":true},{"text":"taunimanima ibounai edia ladana badana ia hereaia noho.","poem":1},{"lineBreak":true},{"text":"Iena hairaina be ataiai momokani,","poem":1},{"lineBreak":true},{"text":"ia ese tanobada bona guba ia hereaia noho.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Lohiabada ese Israela taudia ia lalokau henia momokani,","poem":1},{"lineBreak":true},{"text":"vadaeni ia ese idia ia hagoadaia momokani.","poem":1},{"lineBreak":true},{"text":"Unai dainai iena bese taudia ese iena ladana idia abia isi noho.","poem":1},{"lineBreak":true},{"text":"Lohiabada ena ladana do umui hanamoa!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}