{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"PSA","translationId":"hmo_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"743d5bb4171bfe8132e5ed8cd9e14b414e474687449102dcce2d363eb51cab6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hmo_png/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":15,"content":[{"type":"heading","content":["Edena bamona kara be Dirava ese ia ura ita karaia?"]},{"type":"verse","number":1,"content":[{"text":"Lohiabada e,","poem":1},{"lineBreak":true},{"text":"daika be oiemu Dubu Helaga dekenai do ia noho?","poem":1},{"lineBreak":true},{"text":"Edena tauna be Siona,","poem":1},{"lineBreak":true},{"text":"oiemu ororo helagana dekenai,","poem":1},{"lineBreak":true},{"text":"do ia tomadiho diba?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tauna be inai:","poem":1},{"lineBreak":true},{"text":"Ia be nega ibounai Dirava ia kamonai henia.","poem":1},{"lineBreak":true},{"text":"Ia ese kara maoromaoro sibona ia karaia,","poem":1},{"lineBreak":true},{"text":"bona iena kudouna dekena amo,","poem":1},{"lineBreak":true},{"text":"hereva momokani ia gwauraia noho,","poem":1},{"lineBreak":true},{"text":"mai laloa maoromaoro danu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ia ese iena hereva dekenai,","poem":1},{"lineBreak":true},{"text":"haida ia hadikaia lasi,","poem":1},{"lineBreak":true},{"text":"bona iena turana dekenai,","poem":1},{"lineBreak":true},{"text":"hadikaia kara ta ia karaia lasi.","poem":1},{"lineBreak":true},{"text":"Bona iena badibadinai ia noho tauna totona,","poem":1},{"lineBreak":true},{"text":"hadikaia hereva ta ia gwauraia lasi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ia ese, Dirava ese ia negea tauna ia ura lasi,","poem":1},{"lineBreak":true},{"text":"to ia ese,","poem":1},{"lineBreak":true},{"text":"Dirava idia gari henia taudia ia hanamoa noho.","poem":1},{"lineBreak":true},{"text":"Sedira ia ese do ia davaria,","poem":1},{"lineBreak":true},{"text":"iena gwauhamata hereva do ia badinaia,","poem":1},{"lineBreak":true},{"text":"be auka herea,","poem":1},{"lineBreak":true},{"text":"to ia be idau lasi,","poem":1},{"lineBreak":true},{"text":"do ia badinaia noho.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ia ese iena moni ia heniatorehai lasi,","poem":1},{"lineBreak":true},{"text":"atoa kau davana abia totona.","poem":1},{"lineBreak":true},{"text":"Bona kerere lasi tauna hadikaia totona,","poem":1},{"lineBreak":true},{"text":"taunimanima ese moni idia henia gwauraia neganai,","poem":1},{"lineBreak":true},{"text":"unai tau ese unai moni ia abia dae lasi.","poem":1},{"lineBreak":true},{"text":"Unai bamona ia karaia tauna,","poem":1},{"lineBreak":true},{"text":"be do ia gini goada noho,","poem":1},{"lineBreak":true},{"text":"gau ta ese ia do ia hadikaia lasi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}