{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"PSA","translationId":"hmo_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"743d5bb4171bfe8132e5ed8cd9e14b414e474687449102dcce2d363eb51cab6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hmo_png/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":20,"content":[{"type":"heading","content":["King do ia kwalimu totona Davida ese Dirava ia noia"]},{"type":"verse","number":1,"content":[{"text":"Oiemu nega dika bona hisihisi neganai,","poem":1},{"lineBreak":true},{"text":"Lohiabada ese oi dekenai durua do ia henia.","poem":1},{"lineBreak":true},{"text":"Iakobo ena Dirava ese oi do ia gimaia.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Iena helaga gabuna dekena amo,","poem":1},{"lineBreak":true},{"text":"iena durua do ia siaia mai.","poem":1},{"lineBreak":true},{"text":"Siona Ororo dekena amo,","poem":1},{"lineBreak":true},{"text":"goada oi dekenai do ia henia.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Oiemu boubou gaudia ibounai do ia laloa,","poem":1},{"lineBreak":true},{"text":"bona oiemu gabua boubou gaudia,","poem":1},{"lineBreak":true},{"text":"be do ia abia dae.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Oiemu kudouna ena ura,","poem":1},{"lineBreak":true},{"text":"be oi dekenai do ia henia,","poem":1},{"lineBreak":true},{"text":"bona oiemu palani ibounai,","poem":1},{"lineBreak":true},{"text":"edia anina do ia havaraia.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Oiemu kwalimu dainai,","poem":1},{"lineBreak":true},{"text":"ai be mai moale bada danu do ai boiboi,","poem":1},{"lineBreak":true},{"text":"bona Dirava ena ladana dainai,","poem":1},{"lineBreak":true},{"text":"aiemai pepe do ai abia isi.","poem":1},{"lineBreak":true},{"text":"Lohiabada ese oiemu noinoi ibounai,","poem":1},{"lineBreak":true},{"text":"edia anina be oi dekenai do ia havaraia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Harihari lau diba vadaeni,","poem":1},{"lineBreak":true},{"text":"Lohiabada ese ia abia hidi tauna ia durua noho.","poem":1},{"lineBreak":true},{"text":"Iena gabu helagana dekena amo,","poem":1},{"lineBreak":true},{"text":"egu noinoi ia haere henia noho,","poem":1},{"lineBreak":true},{"text":"bona iena siahu badana dekena amo,","poem":1},{"lineBreak":true},{"text":"kwalimu badadia ia henia noho.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Taunimanima haida ese tuari totona,","poem":1},{"lineBreak":true},{"text":"kariota idia abidadama henia noho,","poem":1},{"lineBreak":true},{"text":"ma haida ese hosi idia abidadama henia noho.","poem":1},{"lineBreak":true},{"text":"To ai ese Lohiabada,","poem":1},{"lineBreak":true},{"text":"aiemai Dirava ai abidadama henia noho.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Unai taudia be do idia hekwakwanai,","poem":1},{"lineBreak":true},{"text":"bona do idia moru diho.","poem":1},{"lineBreak":true},{"text":"To ai be do ai toreisi,","poem":1},{"lineBreak":true},{"text":"bona do ai gini goada.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Lohiabada e, king do oi hamauria!","poem":1},{"lineBreak":true},{"text":"Oi dekenai ai boiboi neganai,","poem":1},{"lineBreak":true},{"text":"mani ai dekenai do oi haere henia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}