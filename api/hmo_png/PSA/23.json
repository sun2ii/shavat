{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"PSA","translationId":"hmo_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"743d5bb4171bfe8132e5ed8cd9e14b414e474687449102dcce2d363eb51cab6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hmo_png/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":23,"content":[{"type":"heading","content":["Lohiabada be iseda naria tauna, mamoe naria tauna bamona"]},{"type":"verse","number":1,"content":[{"text":"Lohiabada ese lau ia naria noho,","poem":1},{"lineBreak":true},{"text":"mamoe naria tauna ese,","poem":1},{"lineBreak":true},{"text":"iena mamoe ia naria bamona.","poem":1},{"lineBreak":true},{"text":"Unai dainai gau ta do lau dabu lasi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rei namona gabuna dekenai lau ia hakaua,","poem":1},{"lineBreak":true},{"text":"unuseni lau laga-ani totona.","poem":1},{"lineBreak":true},{"text":"Ranu namona gabuna dekenai danu,","poem":1},{"lineBreak":true},{"text":"ia ese lau ia hakaua noho.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lauegu lauma be ia ese ia hagoadaia lou.","poem":1},{"lineBreak":true},{"text":"Kara maoromaoro daladia dekenai,","poem":1},{"lineBreak":true},{"text":"ia ese lau ia hakaua noho,","poem":1},{"lineBreak":true},{"text":"iena gwauhamata hegeregerena.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Oibe, lau be mase ena dibura koura gabuna,","poem":1},{"lineBreak":true},{"text":"dekenai do lau raka lao,","poem":1},{"lineBreak":true},{"text":"to dika ta dekenai do lau gari lasi,","poem":1},{"lineBreak":true},{"text":"badina be, Lohiabada e,","poem":1},{"lineBreak":true},{"text":"oi be lau danu oi noho.","poem":1},{"lineBreak":true},{"text":"Oiemu mamoe hakaua itotohi,","poem":1},{"lineBreak":true},{"text":"bona oiemu botaia auna ese,","poem":1},{"lineBreak":true},{"text":"lau idia gimaia noho.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lauegu aniani be oi ese oi abia hegaegae noho,","poem":1},{"lineBreak":true},{"text":"lau idia dagedage henia taudia edia vairana dekenai.","poem":1},{"lineBreak":true},{"text":"Oiemu aria dekenai lau oi abia dae,","poem":1},{"lineBreak":true},{"text":"mai mataurai danu.","poem":1},{"lineBreak":true},{"text":"Lauegu kapusi be oi ese oi hahonua noho.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Momokani, oiemu kara namo bona bogahisihisi,","poem":1},{"lineBreak":true},{"text":"be lau dekenai do idia noho,","poem":1},{"lineBreak":true},{"text":"egu mauri dinadia ibounai lalonai.","poem":1},{"lineBreak":true},{"text":"Bona Lohiabada ena Ruma dekenai do lau noho,","poem":1},{"lineBreak":true},{"text":"ela bona hanaihanai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}