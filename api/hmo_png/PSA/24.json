{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"PSA","translationId":"hmo_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"743d5bb4171bfe8132e5ed8cd9e14b414e474687449102dcce2d363eb51cab6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hmo_png/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":24,"content":[{"type":"heading","content":["Dirava be King Badana"]},{"type":"verse","number":1,"content":[{"text":"Tanobada bona ia lalonai noho gaudia ibounai,","poem":1},{"lineBreak":true},{"text":"be Lohiabada ena.","poem":1},{"lineBreak":true},{"text":"Tanobada bona ia lalonai noho taunimanima,","poem":1},{"lineBreak":true},{"text":"ibounai be Lohiabada ena.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Badina be ia sibona ese tanobada ia haginia,","poem":1},{"lineBreak":true},{"text":"tano henunai ia noho ranu dobudia edia latanai.","poem":1},{"lineBreak":true},{"text":"Ia ese tanobada ena badina,","poem":1},{"lineBreak":true},{"text":"be davara ena dobu gabudia dekenai ia atoa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Daika ese Lohiabada ena ororo,","poem":1},{"lineBreak":true},{"text":"dekenai do ia daekau lao?","poem":1},{"lineBreak":true},{"text":"Daika ese iena gabu helagana lalonai do ia gini?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kara goevagoeva,","poem":1},{"lineBreak":true},{"text":"bona laloa goevagoeva taudia sibona ese.","poem":1},{"lineBreak":true},{"text":"Dirava koikoi idia tomadiho henia lasi,","poem":1},{"lineBreak":true},{"text":"bona idia gwauhamata koikoi lasi taudia ese.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lohiabada ese,","poem":1},{"lineBreak":true},{"text":"unai bamona taudia do ia hanamoa bona hamauria,","poem":1},{"lineBreak":true},{"text":"Lohiabada ese idia do ia gwauraia,","poem":1},{"lineBreak":true},{"text":"idia be kerere lasi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Unai bamona taudia ese Dirava idia tahua noho,","poem":1},{"lineBreak":true},{"text":"idia ura Iakobo ena Dirava ena vairanai idia gini.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ikoukou do umui kehoa namonamo,","poem":1},{"lineBreak":true},{"text":"bona idaunegai iduara danu do umui kehoa.","poem":1},{"lineBreak":true},{"text":"Vadaeni King Badana do ia raka vareai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Inai King Badana be daika?","poem":1},{"lineBreak":true},{"text":"Ia be Lohiabada, mai ena goada,","poem":1},{"lineBreak":true},{"text":"bona mai ena siahu danu.","poem":1},{"lineBreak":true},{"text":"Ia be Lohiabada,","poem":1},{"lineBreak":true},{"text":"tuari dekenai ia kwalimu noho.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ikoukou do umui kehoa namonamo,","poem":1},{"lineBreak":true},{"text":"bona idaunegai iduara danu do umui kehoa bada,","poem":1},{"lineBreak":true},{"text":"vadaeni King Badana be do ia raka vareai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Inai King Badana be daika?","poem":1},{"lineBreak":true},{"text":"Siahu Ibounai Lohiabada,","poem":1},{"lineBreak":true},{"text":"ia be King Badana momokani.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}