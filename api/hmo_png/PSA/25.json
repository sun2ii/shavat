m":1},{"lineBreak":true},{"text":"be moru ena hemarai do idia abia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lohiabada e,","poem":1},{"lineBreak":true},{"text":"oiemu kara lau dekenai do oi hadibaia.","poem":1},{"lineBreak":true},{"text":"Oiemu dala lau dekenai do oi hedinaraia.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Oiemu hereva momokani ena dala dekenai,","poem":1},{"lineBreak":true},{"text":"lau do oi hakaua,","poem":1},{"lineBreak":true},{"text":"bona inai hereva momokani,","poem":1},{"lineBreak":true},{"text":"be lau dekenai do oi hadibaia.","poem":1},{"lineBreak":true},{"text":"Badina oi be egu Dirava,","poem":1},{"lineBreak":true},{"text":"oi ese lau oi hamauria noho.","poem":1},{"lineBreak":true},{"text":"Nega ibounai oi dekenai lau abidadama henia noho.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lohiabada e, oiemu bogahisihisi,","poem":1},{"lineBreak":true},{"text":"bona oiemu noho hanaihanai lalokauna,","poem":1},{"lineBreak":true},{"text":"be do oi laloa noho,","poem":1},{"lineBreak":true},{"text":"badina oi ese idaunegai ia mai bona hari,","poem":1},{"lineBreak":true},{"text":"inai kara taunimanima dekenai oi karaia.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lau uhau neganai kara dika lau karaia gaudia,","poem":1},{"lineBreak":true},{"text":"bona egu kerere danu,","poem":1},{"lineBreak":true},{"text":"be mani do oi gwauatao.","poem":1},{"lineBreak":true},{"text":"Lohiabada e,","poem":1},{"lineBreak":true},{"text":"oiemu noho hanaihanai lalokauna dainai,","poem":1},{"lineBreak":true},{"text":"lau dekenai do oi laloa namo,","poem":1},{"lineBreak":true},{"text":"badina oiemu kara be namo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lohiabada be namo bona maoromaoro.","poem":1},{"lineBreak":true},{"text":"Unai dainai ia ese kara dika taudia dekenai,","poem":1},{"lineBreak":true},{"text":"iena dala ia hadibaia noho.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ia ese hekokoroku lasi taudia,","poem":1},{"lineBreak":true},{"text":"be dala maoromaoro dekenai ia hakaudia noho.","poem":1},{"lineBreak":true},{"text":"Ia ese manau taudia dekenai,","poem":1},{"lineBreak":true},{"text":"iena dala ia hadibaia noho.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Iena taravatu bona iena hadibaia hereva,","poem":1},{"lineBreak":true},{"text":"idia badinaia bona kamonai henia taudia,","poem":1},{"lineBreak":true},{"text":"be Lohiabada ese,","poem":1},{"lineBreak":true},{"text":"mai lalokau bona mai momokani danu,","poem":1},{"lineBreak":true},{"text":"do ia hakaudia lao noho.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lohiabada e, oiemu ladana dainai,","poem":1},{"lineBreak":true},{"text":"egu kara dika do oi gwauatao,","poem":1},{"lineBreak":true},{"text":"badina egu kara dika be bada.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Edena tau ese Lohiabada ia gari henia noho?","poem":1},{"lineBreak":true},{"text":"Lohiabada ese unai tau dekenai,","poem":1},{"lineBreak":true},{"text":"iena raka dala maorona do ia hadibaia.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Unai tau ese kohu momo do ia abia,","poem":1},{"lineBreak":true},{"text":"bona iena natuna ese,","poem":1},{"lineBreak":true},{"text":"tano do idia abia, edia tano.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Lohiabada idia gari henia taudia,","poem":1},{"lineBreak":true},{"text":"be Lohiabada ese idia dekenai,","poem":1},{"lineBreak":true},{"text":"iena hunia gaudia ia hadibaia noho.","poem":1},{"lineBreak":true},{"text":"Lohiabada ese danu idia dekenai,","poem":1},{"lineBreak":true},{"text":"iena gwauhamata taravatuna ena anina ia hadibaia noho.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nega ibounai,","poem":1},{"lineBreak":true},{"text":"Lohiabada dekenai egu matana lau negea noho,","poem":1},{"lineBreak":true},{"text":"lau do ia durua totona,","poem":1},{"lineBreak":true},{"text":"bona ia ese mase bona gari gaudia dekena amo,","poem":1},{"lineBreak":true},{"text":"lau ia hamauria noho.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Lohiabada e,","poem":1},{"lineBreak":true},{"text":"lau dekenai do oi laloa,","poem":1},{"lineBreak":true},{"text":"lau dekenai do oi bogahisihisi,","poem":1},{"lineBreak":true},{"text":"badina lau be sibona lau noho,","poem":1},{"lineBreak":true},{"text":"bona lau manoka noho.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Lauegu lalohisihisi do oi hadokoa,","poem":1},{"lineBreak":true},{"text":"bona egu hisihisi dekena amo lau do oi hamauria.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Egu laloa hekwarahi bona egu laloa metau do oi laloa,","poem":1},{"lineBreak":true},{"text":"bona egu kara dika ibounai mani do oi gwauatao.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Do oi laloa,","poem":1},{"lineBreak":true},{"text":"lau idia hadikaia gwauraia taudia,","poem":1},{"lineBreak":true},{"text":"be idia momo herea,","poem":1},{"lineBreak":true},{"text":"bona edia badu be auka herea lau dekenai.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Egu mauri do oi gimaia,","poem":1},{"lineBreak":true},{"text":"bona lau do oi hamauria.","poem":1},{"lineBreak":true},{"text":"Lau do oi durua,","poem":1},{"lineBreak":true},{"text":"vadaeni hemarai do lau davaria lasi,","poem":1},{"lineBreak":true},{"text":"badina egu heau mauri gabuna be oi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Lohiabada e,","poem":1},{"lineBreak":true},{"text":"egu kara momokani bona kara maoromaoro dainai,","poem":1},{"lineBreak":true},{"text":"lau do oi gimaia,","poem":1},{"lineBreak":true},{"text":"badina oi dekenai lau abidadama noho.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Dirava e, edia hisihisi ibounai dekena amo,","poem":1},{"lineBreak":true},{"text":"oiemu bese Israela taudia do oi hamauria.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}