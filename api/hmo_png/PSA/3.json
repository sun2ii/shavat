{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"PSA","translationId":"hmo_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"743d5bb4171bfe8132e5ed8cd9e14b414e474687449102dcce2d363eb51cab6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hmo_png/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":3,"content":[{"type":"heading","content":["Daba guriguri, Davida ena"]},{"type":"verse","number":1,"content":[{"text":"Lohiabada e,","poem":1},{"lineBreak":true},{"text":"lau dekenai idia dagedage taudia be momo herea.","poem":1},{"lineBreak":true},{"text":"Lau dekenai idia tuari henia taudia,","poem":1},{"lineBreak":true},{"text":"be idia momo lao noho.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Idia ese lau idia herevalaia noho.","poem":1},{"lineBreak":true},{"text":"Idia gwau, “Dirava ese ia do ia durua lasi.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"To Lohiabada e,","poem":1},{"lineBreak":true},{"text":"oi ese dika dekena amo lau oi gimaia noho.","poem":1},{"lineBreak":true},{"text":"Oi ese kwalimu lau dekenai oi henia noho.","poem":1},{"lineBreak":true},{"text":"Oi ese egu lalona oi hagoadaia lou.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lohiabada dekenai durua totona lau boiboi noho,","poem":1},{"lineBreak":true},{"text":"bona iena ororo helagana dekena amo,","poem":1},{"lineBreak":true},{"text":"lau dekenai ia haere henia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lau hekure, lau mahuta, bona lau noga lou,","poem":1},{"lineBreak":true},{"text":"bona hanuaboi ena negana ibounai,","poem":1},{"lineBreak":true},{"text":"Lohiabada ese lau ia naria noho.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Taunimanima 1000, 1000 dekenai lau gari lasi.","poem":1},{"lineBreak":true},{"text":"Egu kahana kahana dekena amo,","poem":1},{"lineBreak":true},{"text":"lau dekenai idia tuari henia noho,","poem":1},{"lineBreak":true},{"text":"to lau gari henidia lasi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lohiabada e, lau dekenai do oi mai.","poem":1},{"lineBreak":true},{"text":"Egu Dirava e, lau do oi hamauria.","poem":1},{"lineBreak":true},{"text":"Lau dekenai idia tuari henia taudia,","poem":1},{"lineBreak":true},{"text":"edia dika davana do oi henia.","poem":1},{"lineBreak":true},{"text":"Do idia manoka lao,","poem":1},{"lineBreak":true},{"text":"vadaeni lau do idia hadikaia diba lasi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lohiabada e, oi sibona ese ai oi hamauria diba.","poem":1},{"lineBreak":true},{"text":"Oi ese oiemu bese taudia oi hanamoa noho.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}