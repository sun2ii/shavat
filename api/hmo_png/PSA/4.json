{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"PSA","translationId":"hmo_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"743d5bb4171bfe8132e5ed8cd9e14b414e474687449102dcce2d363eb51cab6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hmo_png/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":4,"content":[{"type":"heading","content":["Adorahi guriguri, Davida ena"]},{"type":"verse","number":1,"content":[{"text":"Egu Dirava e, oiemu kara be maoromaoro.","poem":1},{"lineBreak":true},{"text":"Oi dekenai lau boiboi neganai,","poem":1},{"lineBreak":true},{"text":"lau dekenai oi haere vadaeni.","poem":1},{"lineBreak":true},{"text":"Dika ese lau ia hadikaia vadaeni neganai,","poem":1},{"lineBreak":true},{"text":"oi ese lau oi durua.","poem":1},{"lineBreak":true},{"text":"Hari danu lau dekenai do oi bogahisihisi henia,","poem":1},{"lineBreak":true},{"text":"egu noinoi mani do oi kamonai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Taunimanima e, egu ladana namona,","poem":1},{"lineBreak":true},{"text":"be do umui hadikaia noho ela bona edena negai?","poem":1},{"lineBreak":true},{"text":"Hereva kavakava do umui ura henia,","poem":1},{"lineBreak":true},{"text":"bona hereva koikoi do umui tahua noho,","poem":1},{"lineBreak":true},{"text":"ela bona edena negai?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Do umui laloa,","poem":1},{"lineBreak":true},{"text":"Lohiabada ese kara maoromaoro taudia,","poem":1},{"lineBreak":true},{"text":"be ia abia hidi vadaeni, iena.","poem":1},{"lineBreak":true},{"text":"Bona lau ese lau boiboi henia neganai,","poem":1},{"lineBreak":true},{"text":"ia ese lau dekenai ia kamonai henia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Emui badu ia toreisi neganai,","poem":1},{"lineBreak":true},{"text":"do umui kara dika lasi.","poem":1},{"lineBreak":true},{"text":"Emui mahuta gabunai umui noho neganai,","poem":1},{"lineBreak":true},{"text":"emui lalona do umui tahua,","poem":1},{"lineBreak":true},{"text":"bona badu ena laloa do umui koua.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Boubou maorodia Lohiabada dekenai do umui henia,","poem":1},{"lineBreak":true},{"text":"bona Lohiabada do umui abidadama henia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Taunimanima momo ese inai bamona idia guriguri noho:","poem":1},{"lineBreak":true},{"text":"“Lohiabada e, daika ese ai do ia hanamoa diba?","poem":1},{"lineBreak":true},{"text":"Oiemu vairana ena diari,","poem":1},{"lineBreak":true},{"text":"be mani ai dekenai do oi hedinaraia.”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"To oi ese moale bada,","poem":1},{"lineBreak":true},{"text":"be lau dekenai oi henia vadaeni,","poem":1},{"lineBreak":true},{"text":"bona egu moale ese,","poem":1},{"lineBreak":true},{"text":"uiti bona uaina momo idia davaria taudia,","poem":1},{"lineBreak":true},{"text":"edia moale ia hereaia momokani.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mai egu maino danu,","poem":1},{"lineBreak":true},{"text":"lau hekure bona lau mahuta noho.","poem":1},{"lineBreak":true},{"text":"Lohiabada e, oi sibona ese lau oi naria,","poem":1},{"lineBreak":true},{"text":"bona dika dekena amo lau oi gimaia noho.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}