{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"PSA","translationId":"hmo_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"743d5bb4171bfe8132e5ed8cd9e14b414e474687449102dcce2d363eb51cab6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hmo_png/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":54,"content":[{"type":"heading","content":["Dirava be egu durua Tauna"]},{"type":"verse","number":1,"content":[{"text":"Dirava e, oiemu ladana ena siahu dekena amo,","poem":1},{"lineBreak":true},{"text":"lau do oi hamauria.","poem":1},{"lineBreak":true},{"text":"Oiemu goada dekena amo lau do oi gwauraia maoro.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dirava e, egu noinoi do oi kamonai.","poem":1},{"lineBreak":true},{"text":"Egu uduna ena hereva do oi laloa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hekokoroku taudia ese lau hadikaia totona idia mai noho.","poem":1},{"lineBreak":true},{"text":"Dagedage taudia ese lau alaia dalana idia tahua noho.","poem":1},{"lineBreak":true},{"text":"Idia be Dirava idia laloa lasi taudia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"To Dirava be lauegu durua Tauna.","poem":1},{"lineBreak":true},{"text":"Lohiabada ese egu mauri do ia gimaia.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dirava ese lau idia hadikaia gwauraia taudia do ia hadikaia,","poem":1},{"lineBreak":true},{"text":"vadaeni sibodia edia dika ese idia do ia hadikaia.","poem":1},{"lineBreak":true},{"text":"Oi ese idia do oi alaia ore,","poem":1},{"lineBreak":true},{"text":"badina oi be kara momokani Diravana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lau ese laloa namo boubou gauna,","poem":1},{"lineBreak":true},{"text":"oi dekenai do lau henia.","poem":1},{"lineBreak":true},{"text":"Lohiabada e,","poem":1},{"lineBreak":true},{"text":"oiemu ladana do lau hanamoa, badina oiemu ladana be namo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Badina be oi ese egu hisihisi ibounai dekena amo,","poem":1},{"lineBreak":true},{"text":"lau oi hamauria vadaeni,","poem":1},{"lineBreak":true},{"text":"bona lau idia ura hadikaia taudia be tuari idia lusi neganai,","poem":1},{"lineBreak":true},{"text":"lau ese edia moru do lau itaia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}