{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"PSA","translationId":"hmo_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"743d5bb4171bfe8132e5ed8cd9e14b414e474687449102dcce2d363eb51cab6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hmo_png/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":67,"content":[{"type":"heading","content":["Dirava hanamoa ane ta"]},{"type":"verse","number":1,"content":[{"text":"Dirava e,","poem":1},{"lineBreak":true},{"text":"ai dekenai do oi bogahisihisi,","poem":1},{"lineBreak":true},{"text":"bona oi ese ai do oi hanamoa.","poem":1},{"lineBreak":true},{"text":"Mani ai dekenai do oi laloa,","poem":1},{"lineBreak":true},{"text":"bona ai do oi durua.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Unai dekena amo tanobada taudia ibounai ese,","poem":1},{"lineBreak":true},{"text":"oiemu dala do idia diba,","poem":1},{"lineBreak":true},{"text":"bona oiemu hamauria kara,","poem":1},{"lineBreak":true},{"text":"be bese ibounai taudia danu do idia diba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dirava e,","poem":1},{"lineBreak":true},{"text":"lau ura bese ibounai ese oi do idia hanamoa.","poem":1},{"lineBreak":true},{"text":"Lau ura bese idauidau ese oiemu ladana do idia abia isi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bese idauidau taudia ibounai ese,","poem":1},{"lineBreak":true},{"text":"mai moale danu ane idia abia be namo.","poem":1},{"lineBreak":true},{"text":"Badina be oi ese tanobada taudia oi kota henia noho,","poem":1},{"lineBreak":true},{"text":"mai maoromaoro bona momokani danu,","poem":1},{"lineBreak":true},{"text":"bona bese ibounai be oi ese oi hakaua noho.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dirava e, lau ura bese ibounai ese oi do idia hanamoa,","poem":1},{"lineBreak":true},{"text":"bona oiemu ladana idia abia isi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tano ena anina idia vara namonamo, badina be,","poem":1},{"lineBreak":true},{"text":"Dirava, iseda Dirava ese ita ia hanamoa vadaeni.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Momokani, Dirava ese ita ia hanamoa vadaeni.","poem":1},{"lineBreak":true},{"text":"Tanobada taudia ibounai ese,","poem":1},{"lineBreak":true},{"text":"Dirava do idia matauraia be namo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}