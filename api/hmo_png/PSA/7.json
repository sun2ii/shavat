{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"PSA","translationId":"hmo_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"743d5bb4171bfe8132e5ed8cd9e14b414e474687449102dcce2d363eb51cab6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hmo_png/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":7,"content":[{"type":"heading","content":["Kota maoromaoro totona Davida ia noinoi"]},{"type":"verse","number":1,"content":[{"text":"Lohiabada e, egu Dirava e,","poem":1},{"lineBreak":true},{"text":"lau ese oi dekenai lau abidadama henia noho.","poem":1},{"lineBreak":true},{"text":"Lau idia lulua noho taudia,","poem":1},{"lineBreak":true},{"text":"dekena amo lau do oi veria mauri,","poem":1},{"lineBreak":true},{"text":"lau do oi hamauria,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"idia be laiona bamona,","poem":1},{"lineBreak":true},{"text":"lau do idia darea garina,","poem":1},{"lineBreak":true},{"text":"bona lau be durua tauna lasi dainai,","poem":1},{"lineBreak":true},{"text":"lau do idia darea maragimaragi garina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Lohiabada e, egu Dirava e,","poem":1},{"lineBreak":true},{"text":"bema kerere lasi tauna ta lau hadikaia,","poem":1},{"lineBreak":true},{"text":"bema lauegu imana dekenai kerere ia noho,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"o bema lau ese,","poem":1},{"lineBreak":true},{"text":"egu turana dekenai kara dika lau karaia,","poem":1},{"lineBreak":true},{"text":"o bema lau dekenai ia tuari tauna,","poem":1},{"lineBreak":true},{"text":"be lau ese ia lau hadikaia kava,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"unai neganai,","poem":1},{"lineBreak":true},{"text":"lau idia tuari henia taudia,","poem":1},{"lineBreak":true},{"text":"be do oi koua lasi,","poem":1},{"lineBreak":true},{"text":"vadaeni idia ese lau do idia lulua mai,","poem":1},{"lineBreak":true},{"text":"bona idia ese lau do idia dogoatao.","poem":1},{"lineBreak":true},{"text":"Idia ese lau do idia gwadaia,","poem":1},{"lineBreak":true},{"text":"lau do idia alaia,","poem":1},{"lineBreak":true},{"text":"bona lau be tano dekenai do lau moru,","poem":1},{"lineBreak":true},{"text":"do lau mase momokani.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lohiabada e,","poem":1},{"lineBreak":true},{"text":"mai badu danu do oi toreisi,","poem":1},{"lineBreak":true},{"text":"lau do idia hamasea gwauraia taudia do oi koua!","poem":1},{"lineBreak":true},{"text":"Lau durua totona do oi toreisi!","poem":1},{"lineBreak":true},{"text":"Kota maoromaoro egu latanai do oi gwauraia.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Taunimanima ibounai do oi haboua,","poem":1},{"lineBreak":true},{"text":"idia ese oi do idia hagegea,","poem":1},{"lineBreak":true},{"text":"bona oi ese ataiai dekena amo,","poem":1},{"lineBreak":true},{"text":"do oi kota henidia.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lohiabada e, oi be bese ibounai,","poem":1},{"lineBreak":true},{"text":"bona taunimanima ibounai edia kota biaguna.","poem":1},{"lineBreak":true},{"text":"Lohiabada e,","poem":1},{"lineBreak":true},{"text":"egu kara maoromaoro hegeregerena,","poem":1},{"lineBreak":true},{"text":"lau do oi kota henia.","poem":1},{"lineBreak":true},{"text":"Oi diba vadaeni lau be kerere lasi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Oi be kara maoromaoro Diravana,","poem":1},{"lineBreak":true},{"text":"bona oi ese aiemai laloa,","poem":1},{"lineBreak":true},{"text":"bona aiemai ura oi tahua noho.","poem":1},{"lineBreak":true},{"text":"Kara dika taudia edia dika do oi hadokoa,","poem":1},{"lineBreak":true},{"text":"bona kara maoromaoro taudia dekenai,","poem":1},{"lineBreak":true},{"text":"ahuna namona do oi henia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dirava, Ataiai Momokani ena Dirava,","poem":1},{"lineBreak":true},{"text":"be egu kesi.","poem":1},{"lineBreak":true},{"text":"Ia dekenai idia kamonai henia taudia,","poem":1},{"lineBreak":true},{"text":"be ia ese ia hamauria noho.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dirava be kota biaguna namona,","poem":1},{"lineBreak":true},{"text":"mai ena laloa maoromaoro bona momokani danu.","poem":1},{"lineBreak":true},{"text":"Nega ibounai ia ese,","poem":1},{"lineBreak":true},{"text":"kara dika taudia edia davana ia henia noho.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bema tau ta ese,","poem":1},{"lineBreak":true},{"text":"iena lalona ia giroa lasi neganai,","poem":1},{"lineBreak":true},{"text":"Dirava ese iena tuari kaia do ia segea.","poem":1},{"lineBreak":true},{"text":"Iena peva danu do ia veria,","poem":1},{"lineBreak":true},{"text":"do ia karaia hegaegae noho.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ia ese iena ala-ala gaudia,","poem":1},{"lineBreak":true},{"text":"be iena imana dekenai ia abia hegaegae,","poem":1},{"lineBreak":true},{"text":"bona iena diba be,","poem":1},{"lineBreak":true},{"text":"lahi gaudia ia halaoa vadaeni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Oi itaia,","poem":1},{"lineBreak":true},{"text":"kara dika tauna ese,","poem":1},{"lineBreak":true},{"text":"dika ia havaraia noho.","poem":1},{"lineBreak":true},{"text":"Ia ese dika karaia totona,","poem":1},{"lineBreak":true},{"text":"ia laloa momo noho.","poem":1},{"lineBreak":true},{"text":"Ia ese kerere do ia karaia,","poem":1},{"lineBreak":true},{"text":"ena dala ia laloa guna.","poem":1},{"lineBreak":true},{"text":"Koikoi daladia danu ia havaraia noho.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"To idau taudia abia totona,","poem":1},{"lineBreak":true},{"text":"ia geia vadaeni guri ena lalonai,","poem":1},{"lineBreak":true},{"text":"be unai dika tauna sibona ese do ia moru diho.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Unai dekena amo,","poem":1},{"lineBreak":true},{"text":"unai tau ena dika ese,","poem":1},{"lineBreak":true},{"text":"sibona do ia hadikaia.","poem":1},{"lineBreak":true},{"text":"Sibona ena dagedage ese,","poem":1},{"lineBreak":true},{"text":"unai tau ena kwarana dekenai do ia moru.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Lohiabada ena kara maoromaoro dainai,","poem":1},{"lineBreak":true},{"text":"ia lau tanikiu henia noho.","poem":1},{"lineBreak":true},{"text":"Lohiabada, Ataiai Momokani Dirava,","poem":1},{"lineBreak":true},{"text":"ena ladana lau hanamoa noho inai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}