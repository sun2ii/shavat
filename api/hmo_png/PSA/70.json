{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"PSA","translationId":"hmo_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"743d5bb4171bfe8132e5ed8cd9e14b414e474687449102dcce2d363eb51cab6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hmo_png/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":70,"content":[{"type":"heading","content":["Davida ese durua totona Dirava ia noia"]},{"type":"verse","number":1,"content":[{"text":"Dirava e, mani lau do oi hamauria.","poem":1},{"lineBreak":true},{"text":"Lohiabada e, lau do oi durua haraga.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Egu mauri hadokoa dalana idia tahua noho taudia dekenai,","poem":1},{"lineBreak":true},{"text":"hemarai bona daradara do oi havaraia.","poem":1},{"lineBreak":true},{"text":"Idia ura lau idia hadikaia ore gwauraia taudia,","poem":1},{"lineBreak":true},{"text":"be do oi siaidia lou mai hemarai bada danu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lau idia hereva dika henia noho taudia idia gwau,","poem":1},{"lineBreak":true},{"text":"“Aha, aha,”","poem":1},{"lineBreak":true},{"text":"Unai taudia be do oi halusidia,","poem":1},{"lineBreak":true},{"text":"mai hemarai bada danu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"To oi idia tahua noho taudia ibounai, be do oi durua,","poem":1},{"lineBreak":true},{"text":"vadaeni oi dainai do idia moale bada noho.","poem":1},{"lineBreak":true},{"text":"Bona oi ese mauri oi henidia dainai idia tanikiu noho taudia,","poem":1},{"lineBreak":true},{"text":"do oi durua,","poem":1},{"lineBreak":true},{"text":"vadaeni nega ibounai inai bamona do idia gwau,","poem":1},{"lineBreak":true},{"text":"“Dirava be ia bada momokani!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"To lau be lau ogogami noho,","poem":1},{"lineBreak":true},{"text":"bona mai egu gau ta lasi danu.","poem":1},{"lineBreak":true},{"text":"Dirava e, lau dekenai do oi mai haraga.","poem":1},{"lineBreak":true},{"text":"Oi be lauegu durua Tauna,","poem":1},{"lineBreak":true},{"text":"bona egu hamauria Tauna danu.","poem":1},{"lineBreak":true},{"text":"Lohiabada e, lau durua totona do oi mai haraga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}