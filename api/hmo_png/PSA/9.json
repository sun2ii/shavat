{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"PSA","translationId":"hmo_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"743d5bb4171bfe8132e5ed8cd9e14b414e474687449102dcce2d363eb51cab6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hmo_png/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":9,"content":[{"type":"heading","content":["Lohiabada do ita tanikiu henia, iena kota maoromaoro karadia dainai"]},{"type":"verse","number":1,"content":[{"text":"Lohiabada e, oi do lau hanamoa,","poem":1},{"lineBreak":true},{"text":"mai egu kudouna ibounai danu.","poem":1},{"lineBreak":true},{"text":"Oiemu hoa karadia ibounai,","poem":1},{"lineBreak":true},{"text":"be do lau herevalaia.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mai moale bada danu,","poem":1},{"lineBreak":true},{"text":"oi do lau hanamoa noho.","poem":1},{"lineBreak":true},{"text":"Siahu Ibounai Dirava e,","poem":1},{"lineBreak":true},{"text":"oiemu ladana hanamoa totona,","poem":1},{"lineBreak":true},{"text":"ane do lau abia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Oi be oi hedinarai neganai,","poem":1},{"lineBreak":true},{"text":"lau dekenai idia tuari henia taudia,","poem":1},{"lineBreak":true},{"text":"be idia giroa lou.","poem":1},{"lineBreak":true},{"text":"Idia moru kava,","poem":1},{"lineBreak":true},{"text":"bona oiemu vairana dekenai idia mase.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lohiabada e,","poem":1},{"lineBreak":true},{"text":"oiemu kota hereva ibounai,","poem":1},{"lineBreak":true},{"text":"be maoromaoro bona momokani,","poem":1},{"lineBreak":true},{"text":"bona oi ese egu kara maoromaoro,","poem":1},{"lineBreak":true},{"text":"be oi hamomokania vadaeni.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bese idauidau be,","poem":1},{"lineBreak":true},{"text":"oi ese oi gwau henia vadaeni,","poem":1},{"lineBreak":true},{"text":"bona kara dika taudia be,","poem":1},{"lineBreak":true},{"text":"oi ese oi hadikaia ore vadaeni.","poem":1},{"lineBreak":true},{"text":"Idia edia ladana be,","poem":1},{"lineBreak":true},{"text":"tau ta ese do ia laloa lou lasi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ai dekenai idia tuari henia taudia,","poem":1},{"lineBreak":true},{"text":"be do idia dika, ela bona hanaihanai.","poem":1},{"lineBreak":true},{"text":"Idia boio vadaeni.","poem":1},{"lineBreak":true},{"text":"Oi ese edia hanua ibounai,","poem":1},{"lineBreak":true},{"text":"be oi hadikaia ore vadaeni,","poem":1},{"lineBreak":true},{"text":"bona edia ladana be,","poem":1},{"lineBreak":true},{"text":"taunimanima ese do idia laloa lou lasi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"To Lohiabada ena King siahuna,","poem":1},{"lineBreak":true},{"text":"be do ia noho ela bona hanaihanai.","poem":1},{"lineBreak":true},{"text":"Ia ese iena terona ia haginia vadaeni,","poem":1},{"lineBreak":true},{"text":"kota gaukara do ia naria totona.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ia ese mai maoromaoro bona momokani danu,","poem":1},{"lineBreak":true},{"text":"tanobada do ia kota henia.","poem":1},{"lineBreak":true},{"text":"Bese idauidau ibounai,","poem":1},{"lineBreak":true},{"text":"be Lohiabada ese do ia kota henia,","poem":1},{"lineBreak":true},{"text":"mai ena laloa maoromaoro danu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tau dikadia ese idia dagedage henia taudia,","poem":1},{"lineBreak":true},{"text":"be Lohiabada ese do ia bogahisihisi henia.","poem":1},{"lineBreak":true},{"text":"Ia be edia heau mauri gabuna momokani,","poem":1},{"lineBreak":true},{"text":"dika ia ginidae neganai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lohiabada e,","poem":1},{"lineBreak":true},{"text":"oiemu ladana idia diba taudia ese,","poem":1},{"lineBreak":true},{"text":"oi do idia abidadama henia.","poem":1},{"lineBreak":true},{"text":"Oi dekenai idia mai taudia,","poem":1},{"lineBreak":true},{"text":"be oi ese idia do oi rakatania lasi,","poem":1},{"lineBreak":true},{"text":"lasi momokani.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Lohiabada, Siona dekenai ia noho Dirava,","poem":1},{"lineBreak":true},{"text":"be do umui hanamoa!","poem":1},{"lineBreak":true},{"text":"Iena kara be,","poem":1},{"lineBreak":true},{"text":"bese idauidau edia huanai do umui herevalaia!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Badina be rara ena davana,","poem":1},{"lineBreak":true},{"text":"ia henia noho ena Dirava ese,","poem":1},{"lineBreak":true},{"text":"hisihisi idia abia noho taudia ia laloa.","poem":1},{"lineBreak":true},{"text":"Edia taitai ia laloaboio lasi,","poem":1},{"lineBreak":true},{"text":"bona idia dekenai hisihisi idia henia taudia,","poem":1},{"lineBreak":true},{"text":"edia kerere davana be Dirava ese do ia henia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Lohiabada e,","poem":1},{"lineBreak":true},{"text":"lau dekenai do oi bogahisihisi henia!","poem":1},{"lineBreak":true},{"text":"Lau idia hadikaia noho taudia dekena amo,","poem":1},{"lineBreak":true},{"text":"lau abia hisihisi mani do oi itaia.","poem":1},{"lineBreak":true},{"text":"Lohiabada e,","poem":1},{"lineBreak":true},{"text":"mase dekena amo lau do oi hamauria.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Unai neganai, Ierusalema taudia,","poem":1},{"lineBreak":true},{"text":"edia vairanai do lau gini diba,","poem":1},{"lineBreak":true},{"text":"bona oi ese lau oi hamauria kara ibounai,","poem":1},{"lineBreak":true},{"text":"be idia dekenai do lau hamaorolaia.","poem":1},{"lineBreak":true},{"text":"Oi ese lau oi hamauria dainai,","poem":1},{"lineBreak":true},{"text":"do lau moale bada herea momokani.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Dirava diba lasi taudia ese,","poem":1},{"lineBreak":true},{"text":"guri badana idia geia vadaeni,","poem":1},{"lineBreak":true},{"text":"bona iena lalonai idia moru.","poem":1},{"lineBreak":true},{"text":"Sibodia idia karaia tarapu ese,","poem":1},{"lineBreak":true},{"text":"idia ia abia vadaeni.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Lohiabada ese sibona ena kara,","poem":1},{"lineBreak":true},{"text":"be ia hedinaraia vadaeni,","poem":1},{"lineBreak":true},{"text":"iena kota maoromaoro dekena amo.","poem":1},{"lineBreak":true},{"text":"Kara dika taudia be edia kara ese,","poem":1},{"lineBreak":true},{"text":"idia ia hadikaia noho.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kara dika taudia ibounai,","poem":1},{"lineBreak":true},{"text":"edia dokona be mase.","poem":1},{"lineBreak":true},{"text":"Dirava idia negea taudia ibounai,","poem":1},{"lineBreak":true},{"text":"danu edia dokona be mase.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Gau lasi taudia,","poem":1},{"lineBreak":true},{"text":"be Dirava ese ia laloaboio lasi.","poem":1},{"lineBreak":true},{"text":"Ogogami taudia edia abidadama,","poem":1},{"lineBreak":true},{"text":"be abidadama kava lasi.","poem":1},{"lineBreak":true},{"text":"Edia abidadama ena anina,","poem":1},{"lineBreak":true},{"text":"be do ia boio ore lasi,","poem":1},{"lineBreak":true},{"text":"to gabeai do ia vara.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Lohiabada e, do oi toreisi,","poem":1},{"lineBreak":true},{"text":"taunimanima edia hekokoroku do oi koua!","poem":1},{"lineBreak":true},{"text":"Dirava idia ura henia lasi taudia,","poem":1},{"lineBreak":true},{"text":"be do oi kota henia,","poem":1},{"lineBreak":true},{"text":"bona edia dika davana do oi gwauraia.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Lohiabada e, idia do oi hagaria,","poem":1},{"lineBreak":true},{"text":"bona idia do oi hadibaia,","poem":1},{"lineBreak":true},{"text":"idia be taunimanima sibona.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}