{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"PSA","translationId":"hmo_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"743d5bb4171bfe8132e5ed8cd9e14b414e474687449102dcce2d363eb51cab6a","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hmo_png/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":93,"content":[{"type":"heading","content":["Dirava be King"]},{"type":"verse","number":1,"content":[{"text":"Lohiabada be King.","poem":1},{"lineBreak":true},{"text":"Ia be mai ena ladana bada momokani.","poem":1},{"lineBreak":true},{"text":"Ia be mai ena goada badana.","poem":1},{"lineBreak":true},{"text":"Ia ese inai tanobada ia karaia goada,","poem":1},{"lineBreak":true},{"text":"bona haida ese idia hamarerea diba lasi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lohiabada e,","poem":1},{"lineBreak":true},{"text":"gabu ibounai, taunimanima ibounai, bona gau ibounai,","poem":1},{"lineBreak":true},{"text":"be idia do vara lasi neganai, oi be oi noho.","poem":1},{"lineBreak":true},{"text":"Oi be oi noho hanaihanai,","poem":1},{"lineBreak":true},{"text":"bona oi be do oi King ela bona hanaihanai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Lohiabada e,","poem":1},{"lineBreak":true},{"text":"davara bada ena dobu gabudia ese edia gadodia idia habadaia.","poem":1},{"lineBreak":true},{"text":"Edia gadodia idia habadaia, bona idia boiboi bada noho,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lohiabada e, oi be guba ena King momokani,","poem":1},{"lineBreak":true},{"text":"bona oiemu siahu ese davara bada ena boiboi ia hereaia.","poem":1},{"lineBreak":true},{"text":"Ma oiemu goada ese davara ena hurehure bada ia hereaia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lohiabada e, oiemu taravatu be idia noho hanaihanai.","poem":1},{"lineBreak":true},{"text":"Momokani, oiemu Dubu Helaga be helaga momokani,","poem":1},{"lineBreak":true},{"text":"ela bona hanaihanai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}