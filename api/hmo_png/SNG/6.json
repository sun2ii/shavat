{"translation":{"id":"hmo_png","name":"Buka Helaga","website":"https://ebible.org/Scriptures/details.php?id=hmo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hmo","licenseNotes":null,"shortName":"PNG","englishName":"Hiri Motu Bible","language":"hmo","textDirection":"ltr","sha256":"b5d03fa35683cf4821bb3d665f31172da920641e7b48bd1659b4ccf560b0e58b","availableFormats":["json"],"listOfBooksApiLink":"/api/hmo_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30877,"languageName":"Hiri Motu","languageEnglishName":"Hiri Motu"},"book":{"id":"SNG","translationId":"hmo_png","name":"SOLOMONA ENA ANE","commonName":"SOLOMONA ENA ANE","title":"SOLOMONA ENA ANE","order":22,"numberOfChapters":8,"sha256":"5d35cdd189a5bf0101ca53f14dc04d683445eec24c58c6e8f8469a8e778d8a29","firstChapterNumber":1,"firstChapterApiLink":"/api/hmo_png/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/hmo_png/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"heading","content":["Ierusalema ena hahine taudia idia hereva"]},{"type":"verse","number":1,"content":[{"text":"Hahine namona e,","poem":1},{"lineBreak":true},{"text":"oiemu lalokau tauna be edeseni ia lao?","poem":1},{"lineBreak":true},{"text":"Ia be edena kahana dekenai ia lao,","poem":1},{"lineBreak":true},{"text":"vadaeni ai ese oi danu do ita tahua?","poem":1}]},{"type":"heading","content":["Hahine ia hereva"]},{"type":"verse","number":2,"content":[{"text":"Egu lalokau be iena uma dekenai ia lao,","poem":1},{"lineBreak":true},{"text":"iena muramura avadia uma gabuna.","poem":1},{"lineBreak":true},{"text":"Uma dekenai iena mamoe ia ubua noho,","poem":1},{"lineBreak":true},{"text":"bona sosana palauapalaua ia haboua noho danu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Egu tau be egu lalokau,","poem":1},{"lineBreak":true},{"text":"bona lau be iena lalokau.","poem":1},{"lineBreak":true},{"text":"Ia ese iena mamoe ia ubua noho,","poem":1},{"lineBreak":true},{"text":"sosana palauapalaua edia huanai.","poem":1}]},{"type":"heading","content":["Ane namba 5"]},{"type":"heading","content":["Tau ese ia abia"]},{"type":"verse","number":4,"content":[{"text":"Egu lalokau e, oi be hairai herea,","poem":1},{"lineBreak":true},{"text":"Ierusalema bamona.","poem":1},{"lineBreak":true},{"text":"Oiemu hairaina be bada,","poem":1},{"lineBreak":true},{"text":"Tirisa hanua bamona,","poem":1},{"lineBreak":true},{"text":"oiemu toana be mai garina,","poem":1},{"lineBreak":true},{"text":"tuari orea mai edia pepe edia toana bamona.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Oiemu matana dekenai lau do oi itaia noho lasi,","poem":1},{"lineBreak":true},{"text":"badina oiemu matana ese,","poem":1},{"lineBreak":true},{"text":"lau idia hamanokaia noho.","poem":1},{"lineBreak":true},{"text":"Oiemu huina be nanigosi orea,","poem":1},{"lineBreak":true},{"text":"Gileada Ororo dekena amo mai mavaru danu,","poem":1},{"lineBreak":true},{"text":"idia diho mai noho bamona.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Oiemu isena be mamoe orea,","poem":1},{"lineBreak":true},{"text":"edia huina be huria vadaeni,","poem":1},{"lineBreak":true},{"text":"bona digu gabuna dekena amo,","poem":1},{"lineBreak":true},{"text":"idia daekau mai bamona.","poem":1},{"lineBreak":true},{"text":"Idia ibounai be mai edia natudia, vara hekapa,","poem":1},{"lineBreak":true},{"text":"ta be ia sibona ia noho lasi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Oiemu vairana ena kahana kahana,","poem":1},{"lineBreak":true},{"text":"ena koua dabua murinai,","poem":1},{"lineBreak":true},{"text":"be apolo huahua namona,","poem":1},{"lineBreak":true},{"text":"idia ivaia parara ena toana bamona.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"King ena hahine be sedira ibounai 60.","poem":1},{"lineBreak":true},{"text":"Iena hesiai hahine danu be sedira 80,","poem":1},{"lineBreak":true},{"text":"bona iena kekeni be momo, duahia diba lasi,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"to lau ese oi,","poem":1},{"lineBreak":true},{"text":"tamona sibona lau ura henia.","poem":1},{"lineBreak":true},{"text":"Oi be egu pune manu,","poem":1},{"lineBreak":true},{"text":"egu hahine goeva momokani.","poem":1},{"lineBreak":true},{"text":"Oi be oiemu sinana ena lalokau,","poem":1},{"lineBreak":true},{"text":"oi ia havaraia hahine ena natuna namona momokani.","poem":1},{"lineBreak":true},{"text":"Hahine ibounai ese oi idia itaia noho,","poem":1},{"lineBreak":true},{"text":"bona oi idia hanamoa noho.","poem":1},{"lineBreak":true},{"text":"Lohia edia hahine,","poem":1},{"lineBreak":true},{"text":"bona hesiai hahine ese oi idia itaia,","poem":1},{"lineBreak":true},{"text":"bona oi idia hanamoa bada noho.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Inai be daika,","poem":1},{"lineBreak":true},{"text":"iena toana be daba rere bamona?","poem":1},{"lineBreak":true},{"text":"Mai ena hairaina, hua bamona?","poem":1},{"lineBreak":true},{"text":"Mai ena diaridiari, dina bamona?","poem":1},{"lineBreak":true},{"text":"Iena toana be mai garina,","poem":1},{"lineBreak":true},{"text":"tuari orea mai edia pepe edia toana bamona?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Okari audia edia uma gabuna lalonai lau raka,","poem":1},{"lineBreak":true},{"text":"koura dekenai idia vara avadia do lau itaia.","poem":1},{"lineBreak":true},{"text":"Ma do lau itaia, vain edia raurau,","poem":1},{"lineBreak":true},{"text":"be idia tubu noho o lasi,","poem":1},{"lineBreak":true},{"text":"bona do lau diba, apolo audia dekenai,","poem":1},{"lineBreak":true},{"text":"apolo edia palauapalaua idia hedinaraia o lasi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Lau be lau heudeheude noho,","poem":1},{"lineBreak":true},{"text":"oiemu ura henia lau ura dikadika noho,","poem":1},{"lineBreak":true},{"text":"kariota ia guia tauna ese,","poem":1},{"lineBreak":true},{"text":"tuari ia ura dikadika noho bamona.","poem":1}]},{"type":"heading","content":["Ierusalema hahine taudia idia hereva"]},{"type":"verse","number":13,"content":[{"text":"Sulama hahine e, do oi giroa mai,","poem":1},{"lineBreak":true},{"text":"do oi giroa mai.","poem":1},{"lineBreak":true},{"text":"Ai ura oi mavaru neganai,","poem":1},{"lineBreak":true},{"text":"oi do ai itaia gwauraia.","poem":1},"Hahine ia hereva",{"text":"Badina dahaka lau, Sulama hahine umui ura itaia,","poem":1},{"lineBreak":true},{"text":"tuari orea rua edia huanai ena mavaruna,","poem":1},{"lineBreak":true},{"text":"do lau mavaru neganai?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hmo_png/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hmo_png/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hmo_png/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}