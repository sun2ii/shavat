{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"ISA","translationId":"hne_twf","name":"यसायाह","commonName":"यसायाह","title":"यसायाह के किताब","order":23,"numberOfChapters":66,"sha256":"15711486484493d9a84cc95cca464e5b89017ec8694f02e5e5f4c3ff456075fb","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/hne_twf/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["इस्तुति के गीत"]},{"type":"verse","number":1,"content":["ओ दिन तें कहिबे:",{"text":"“हे यहोवा, मेंह तोर परसंसा करहूं।","poem":1},{"text":"हालाकि तें मोर ऊपर रिस करत रहे,","poem":2},{"text":"पर तोर रिस ह सांत हो गीस","poem":1},{"text":"अऊ तेंह मोला सांति देय हवस।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"खचित परमेसर ह मोर उद्धार अय;","poem":1},{"text":"मेंह भरोसा रखहूं अऊ नइं डरहूं।","poem":2},{"text":"काबरकि यहोवा, यहोवा खुद मोर बल अऊ मोर सुरकछा","poem":1},{"noteId":24},{"text":"अय;","poem":1},{"text":"ओह मोर उद्धारकर्ता हो गे हवय।”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"आनंद समेत तुमन उद्धार के","poem":1},{"text":"कुआंमन ले पानी भरहू।","poem":2}]},{"type":"verse","number":4,"content":["ओ दिन तुमन कहिहू:",{"text":"“यहोवा के परसंसा करव, ओकर नांव के घोसना करव;","poem":1},{"text":"जाति-जाति के मनखेमन के बीच ओकर काममन के परचार करव,","poem":2},{"lineBreak":true},{"text":"अऊ घोसना करव कि ओकर नांव महान अय।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"यहोवा के भजन गावव, काबरकि ओह परतापी काम करे हवय;","poem":1},{"text":"ये बात जम्मो संसार म बतावव।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"हे सियोन के मनखेमन, जोर से चिचियावव अऊ आनंद के मारे गावव,","poem":1},{"text":"काबरकि इसरायल के पबितर परमेसर ह तुम्हर बीच महान अय।”","poem":2}]}],"footnotes":[{"noteId":24,"caller":"+","text":"या गीत","reference":{"chapter":12,"verse":2}}]},"thisChapterLink":"/api/hne_twf/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}