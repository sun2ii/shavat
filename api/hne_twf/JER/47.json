{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"JER","translationId":"hne_twf","name":"यरमियाह","commonName":"यरमियाह","title":"यरमियाह के किताब","order":24,"numberOfChapters":52,"sha256":"959a520d8de6266cb668da5777544fd9794857735b570831e5cbd58a6aace371","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/hne_twf/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":47,"content":[{"type":"heading","content":["पलिस्तीमन के बारे म संदेस"]},{"type":"verse","number":1,"content":["फिरौन",{"noteId":38},"दुवारा गाजा सहर ऊपर हमला करे के पहिली, यरमियाह अगमजानी करा पलिस्तीमन के बारे म यहोवा के ये बचन आईस:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["यहोवा ह ये कहत हे:",{"text":"“देख, उत्तर दिग म पानी ह कइसे बढ़त हे;","poem":1},{"text":"ओह उछरत बोहाय लगही।","poem":2},{"text":"ओह देस अऊ ओमा के जम्मो चीज ला डुबो दीही,","poem":1},{"text":"नगरमन ला अऊ ओमा रहइया जम्मो झन ला डुबो दीही।","poem":2},{"text":"मनखेमन चिचियाहीं;","poem":1},{"text":"देस म रहइया जम्मो झन बिलाप करहीं","poem":2}]},{"type":"verse","number":3,"content":[{"text":"सरपट भागत मजबूत घोड़ामन के खुर के अवाज सुनके,","poem":1},{"text":"बईरी के रथमन के अवाज सुनके","poem":2},{"lineBreak":true},{"text":"अऊ ओमन के चक्का के गड़गड़ाहट के अवाज सुनके।","poem":2},{"text":"दाई-ददामन अपन लइकामन के मदद करे बर नइं मुड़हीं;","poem":1},{"text":"ओमन के हांथमन अपंग हो जाहीं।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"काबरकि जम्मो पलिस्तीमन ला नास करे के","poem":1},{"text":"अऊ ओ जम्मो बांचे मनखे","poem":2},{"text":"जऊन मन सूर अऊ सीदोन सहर के मदद कर सकत रिहिन,","poem":1},{"text":"ओमन ला हटाय के दिन आ गे हवय।","poem":2},{"text":"काबरकि यहोवा ह कपतोर","poem":1},{"noteId":39},{"text":"के समुंदर तीर के","poem":1},{"text":"बांचे पलिस्तीमन ला नास करनेचवाला हे।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"गाजा सहर के मनखेमन सोक म अपन मुड़ मुड़ाहीं;","poem":1},{"text":"अस्कलोन के मनखेमन ला चुप करा दिये जाही।","poem":2},{"text":"हे समतल जगह म बांचे मनखेमन,","poem":1},{"text":"तुमन कब तक अपनआप ला चीरत रहिहू?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“ ‘आह, हे यहोवा के तलवार,","poem":1},{"text":"तेंह कब सांत होबे?","poem":2},{"text":"अपन मियान म लहुंट जा;","poem":1},{"text":"सांत हो अऊ थम जा।’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"पर येह कइसे सांत हो सकथे","poem":1},{"text":"जब यहोवा ह येला हुकूम दे हवय,","poem":2},{"text":"जब ओह अस्कलोन अऊ समुंदर तीर ऊपर","poem":1},{"text":"हमला करे के हुकूम दे हवय?”","poem":2}]}],"footnotes":[{"noteId":38,"caller":"+","text":"या मिसर के राजा","reference":{"chapter":47,"verse":1}},{"noteId":39,"caller":"+","text":"याने कि, क्रेते","reference":{"chapter":47,"verse":4}}]},"thisChapterLink":"/api/hne_twf/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}