{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"JOB","translationId":"hne_twf","name":"अयूब","commonName":"अयूब","title":"अयूब के किताब","order":18,"numberOfChapters":42,"sha256":"fec5b70afc2dcc27084d7e570b029373abb8693fcb7e709364e8bf42fd5d6ca5","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/hne_twf/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":25,"content":[{"type":"heading","content":["बिलदद"]},{"type":"verse","number":1,"content":["तब सूही के रहइया बिलदद ह जबाब दीस:"]},{"type":"verse","number":2,"content":[{"text":"“परभूता अऊ भय के अधिकारी परमेसर ही अय;","poem":1},{"text":"ओह ऊंच स्वरग म सांति स्थापित करथे।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"का ओकर सेनामन के गनती करे जा सकथे?","poem":1},{"text":"अइसे कोन हवय, जेकर ऊपर ओकर अंजोर नइं परय?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तब एक मरनहार मनखे ह परमेसर के आघू म कइसे धरमी हो सकथे?","poem":1},{"text":"माईलोगन ले जनमे मनखे ह कइसे सुध हो सकथे?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"कहूं ओकर नजर म चंदा ह घलो उजला","poem":1},{"text":"अऊ तारामन घलो ओकर नजर म सुध नइं अंय,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"त फेर मरनहार मनखे के का गनती, जऊन ह सिरिप एक गेंगरूआ अय—","poem":1},{"text":"एक मनखे, जऊन ह सिरिप एक कीरा अय!”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hne_twf/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}