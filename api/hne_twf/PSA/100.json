{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":100,"content":[{"type":"hebrew_subtitle","content":["धनबाद अऊ महिमा देय बर एक भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे धरती के जम्मो मनखेमन, यहोवा बर आनंद के मारे चिचियावव।","poem":1}]},{"type":"verse","number":2,"content":[{"text":"खुस होके यहोवा के अराधना करव;","poem":2},{"lineBreak":true},{"text":"आनंद के गीत गावत ओकर आघू म आवव।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ये बात ला जानव कि यहोवा ही परमेसर अय।","poem":1},{"text":"ओही ह हमन ला बनाय हवय, अऊ हमन ओकरेच अन","poem":2},{"noteId":87},{"text":";","poem":2},{"lineBreak":true},{"text":"हमन ओकर मनखे, ओकर चरागन के भेड़ अन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"धनबाद करत ओकर कपाट के भीतर","poem":1},{"text":"अऊ परसंसा करत ओकर अंगना म जावव;","poem":2},{"lineBreak":true},{"text":"ओला धनबाद देवव अऊ ओकर नांव के महिमा करव।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"काबरकि यहोवा ह बने अय अऊ ओकर मया हमेसा बने रहिथे;","poem":1},{"text":"ओकर बिसवासयोग्यता ह जम्मो पीढ़ी म बने रहिथे।","poem":2}]}],"footnotes":[{"noteId":87,"caller":"+","text":"या अपन खुद के नो हन","reference":{"chapter":100,"verse":3}}]},"thisChapterLink":"/api/hne_twf/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}