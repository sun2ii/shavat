{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["दाऊद के एक भजन।"]},{"type":"verse","number":1,"content":[{"text":"मेंह तोर मया अऊ नियाय के गीत गाहूं;","poem":1},{"text":"हे यहोवा, मेंह तोर परसंसा के गीत गाहूं।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"मेंह निरदोस जिनगी जीये बर धियान दूहूं—","poem":1},{"text":"तेंह मोर करा कब आबे?","poem":2},{"lineBreak":true},{"text":"मेंह निरदोस हिरदय से","poem":1},{"text":"अपन घर के मामला म बेवहार करहूं।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"मेंह कोनो दुस्ट काम बर","poem":1},{"text":"मंजूरी नइं दूहूं।","poem":2},{"lineBreak":true},{"text":"मेंह बिसवासहीन मनखेमन के काम ले घिन करथंव;","poem":1},{"text":"अइसन काम ले मोर कोनो लेना-देना नइं होही।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"जिद्दी सुभाव ले मेंह दूर रहिहूं;","poem":1},{"text":"दुस्ट काम ले मोर कोनो लेना-देना नइं होही।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"जऊन कोनो अपन परोसी के पाछू ओकर निन्दा करथे,","poem":1},{"text":"मेंह ओला नास कर दूहूं;","poem":2},{"text":"अहंकार ले भरे आंखीवाले अऊ घमंड ले भरे मनखे ला","poem":1},{"text":"मेंह सहन नइं करहूं।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"मोर आंखी ह देस म बिसवासयोग्य मनखेमन ऊपर लगे रहिही,","poem":1},{"text":"ताकि ओमन मोर संग रहंय;","poem":2},{"text":"जऊन ह निरदोस जिनगी जीथे,","poem":1},{"text":"ओह मोर सेवा करही।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"धोखाधड़ी करइया कोनो भी मनखे","poem":1},{"text":"मोर घर म नइं रहिही;","poem":2},{"text":"जऊन ह लबारी मारथे,","poem":1},{"text":"ओह मोर आघू म ठाढ़ नइं हो सकही।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"हर बिहनियां मेंह देस के","poem":1},{"text":"जम्मो दुस्टमन ला नास कर दूहूं;","poem":2},{"text":"यहोवा के सहर ले","poem":1},{"text":"मेंह हर दुस्ट मनखे ला नास कर दूहूं।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hne_twf/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}