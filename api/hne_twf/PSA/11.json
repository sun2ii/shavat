{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["संगीत के निरदेसक बर दाऊद के एक भजन।"]},{"type":"verse","number":1,"content":[{"text":"मेंह यहोवा करा सरन लेथंव।","poem":1},{"text":"तब तेंह मोला कइसे कह सकत हस:","poem":2},{"lineBreak":true},{"text":"“चिरई के सहीं अपन पहाड़ करा उड़ जा।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"काबरकि देख, दुस्ट मनखेमन अपन धनुस ला साधत हें;","poem":1},{"text":"ओमन तीर ला धनुस के डोरी म रखत हें","poem":2},{"text":"ताकि अंधियार म ले","poem":1},{"text":"सीधवा मनखे ऊपर तीर चलावंय।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"जब नीव ला गिराय जावत हे,","poem":1},{"text":"त फेर धरमी ह का कर सकथे?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"यहोवा ह अपन पबितर मंदिर म हवय;","poem":1},{"text":"यहोवा ह अपन स्वरग के सिंघासन म बिराजे हवय।","poem":2},{"text":"ओह धरती ऊपर हर एक जन ला देखत रहिथे;","poem":1},{"text":"ओकर आंखी ह ओमन ला परखथे।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"यहोवा ह धरमी ला परखथे,","poem":1},{"text":"पर ओह ओ दुस्टमन ले बहुंत घिन करथे,","poem":2},{"lineBreak":true},{"text":"जेमन हिंसा ले मया करथें।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"दुस्ट मनखेमन ऊपर परमेसर ह","poem":1},{"text":"बरत कोइला अऊ बरत गंधक बरसाही;","poem":2},{"lineBreak":true},{"text":"लेसा देवइया हवा ह ओमन के भाग होही।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"काबरकि यहोवा ह धरमी अय,","poem":1},{"text":"ओह नियाय ले मया करथे;","poem":2},{"lineBreak":true},{"text":"धरमी मनखे ह ओकर दरसन करही।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hne_twf/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}