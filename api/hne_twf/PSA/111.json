{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"यहोवा के परसंसा करव।","poem":1},{"noteId":96},{"lineBreak":true},{"text":"मेंह सीधवा मनखेमन के मंडली म अऊ सभा म","poem":1},{"text":"अपन पूरा मन से यहोवा के परसंसा करहूं।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"यहोवा के काममन महान एं;","poem":1},{"text":"जऊन मन ओ काममन ले खुस होथें, ओमन ओ काममन के ऊपर बिचार करथें।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ओकर काममन महिमामय अऊ सानदार अंय,","poem":1},{"text":"अऊ ओकर धरमीपन हमेसा बने रहिथे।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ओह अपन अद्भूत काममन के सुरता कराय हवय;","poem":1},{"text":"यहोवा ह अनुग्रहकारी अऊ दयालु अय।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ओह ओमन ला जेवन देथे, जेमन ओकर भय मानथें;","poem":1},{"text":"ओह अपन करार ला हमेसा सुरता रखथे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ओह दिगर जाति के मनखेमन के भुइयां अपन मनखेमन ला देके","poem":1},{"text":"अपन काम के सक्ति ला देखाय हवय।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ओकर हांथ के काममन बिसवासयोग्य अऊ नियाय के अंय;","poem":1},{"text":"ओकर जम्मो नियममन बिसवासयोग्य अंय।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ओमन सदा-सर्वदा अटल रहिहीं,","poem":1},{"text":"ये कानूनमन बिसवासयोग्यता अऊ ईमानदारी से बनाय गे हवंय।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ओह अपन मनखेमन ला पाप ले छुटकारा दे हवय;","poem":1},{"text":"ओह अपन करार ला हमेसा बर ठहिराय हवय—","poem":2},{"lineBreak":true},{"text":"ओकर नांव पबितर अऊ अद्भूत अय।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"यहोवा के भय मनई बुद्धि के सुरूआत ए;","poem":1},{"text":"ओ जम्मो, जऊन मन ओकर नियममन ला मानथें, ओमन अपन म सही समझ रखथें।","poem":2},{"lineBreak":true},{"text":"ओकर महिमा सदाकाल तक होवत रहय।","poem":2}]}],"footnotes":[{"noteId":96,"caller":"+","text":"इबरानी म हलिलूयाह","reference":{"chapter":111,"verse":1}}]},"thisChapterLink":"/api/hne_twf/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}