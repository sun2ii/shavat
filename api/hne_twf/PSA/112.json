{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"यहोवा के परसंसा करव।","poem":1},{"lineBreak":true},{"text":"धइन अंय ओमन, जऊन मन यहोवा के भय मानथें,","poem":1},{"text":"जऊन मन ओकर हुकूम के पालन करे म बहुंत खुस होथें।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ओमन के लइकामन देस म सक्तिसाली होहीं;","poem":1},{"text":"ईमानदार मनखे के पीढ़ी ला आसीस मिलही।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ओमन के घर म धन अऊ सम्पन्नता होही,","poem":1},{"text":"अऊ ओमन के धरमीपन ह हमेसा बने रहिही।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ईमानदार मनखे बर अंधियार म घलो अंजोर निकलथे,","poem":1},{"text":"ओमन बर घलो, जऊन मन अनुग्रहकारी अऊ दयालु अऊ धरमी अंय।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ओमन के भलई होही, जऊन मन उदार मन के अंय अऊ खुले मन से उधार देथें,","poem":1},{"text":"जऊन मन अपन काम म नियाय के बरताव करथें।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"खचित धरमी ह कभू नइं डगमगाही;","poem":1},{"text":"ओमन ला हमेसा सुरता करे जाही।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ओमन खराप संदेस सुनके भयभीत नइं होहीं;","poem":1},{"text":"यहोवा ऊपर भरोसा रखत ओमन के हिरदय ह इस्थिर रहिथे।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ओमन के हिरदय ह सुरकछित हवय, ओमन ला कोनो किसम के भय नइं होवय;","poem":1},{"text":"आखिरी म ओमन अपन बईरीमन ऊपर बिजयी होके देखहीं।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ओमन गरीबमन ला दिल खोलके दान दे हवंय,","poem":1},{"text":"ओमन के धरमीपन ह सदाकाल तक बने रहिथे;","poem":2},{"lineBreak":true},{"text":"ओमन के सींग ला","poem":2},{"noteId":97},{"text":"आदर म ऊंच करे जाही।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"दुस्टमन येला देखके कुढ़हीं,","poem":1},{"text":"ओमन अपन दांत पीसहीं अऊ बरबाद हो जाहीं;","poem":2},{"lineBreak":true},{"text":"दुस्टमन के लालसा ह पूरा नइं होही।","poem":2}]}],"footnotes":[{"noteId":97,"caller":"+","text":"सींग ह इहां परतिस्ठा या सम्मान के प्रतीक अय","reference":{"chapter":112,"verse":9}}]},"thisChapterLink":"/api/hne_twf/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}