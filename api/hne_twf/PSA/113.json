},{"type":"verse","number":7,"content":[{"text":"ओह गरीब ला धुर्रा ले उठाथे","poem":1},{"text":"अऊ राख के कुढ़ा ले जरूरतमंद ला ऊपर करथे;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ओह ओमन ला हाकिममन के संग,","poem":1},{"text":"अपन मनखेमन के हाकिममन संग बईठाथे।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ओह बांझ माईलोगन ला ओकर घर म अइसे बसाथे,","poem":1},{"text":"जइसे लइकामन के खुसी ले भरे एक दाई ला।","poem":2},{"lineBreak":true},{"text":"यहोवा के परसंसा होवय।","poem":1}]}],"footnotes":[{"noteId":98,"caller":"+","text":"इबरानी म हलिलूयाह","reference":{"chapter":113,"verse":1}}]},"thisChapterLink":"/api/hne_twf/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}