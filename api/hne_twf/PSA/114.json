{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"जब इसरायलीमन मिसर देस ले बाहिर निकलिन,","poem":1},{"text":"जब याकूब के बंसजमन आने भासा के मनखेमन के बीच ले बाहिर आईन,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तब यहूदा ह परमेसर के पबितर-स्थान,","poem":1},{"text":"अऊ इसरायल ह ओकर राज बन गीस।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"समुंदर ह देखके भाग गीस,","poem":1},{"text":"यरदन नदी उल्टा दिग म बहे लगिस;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"पहाड़मन मेढ़ामन सहीं,","poem":1},{"text":"अऊ पहाड़ीमन मेढ़ा-पीलामन सहीं उछले-कूदे लगिन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"हे समुंदर, का होईस कि तेंह भाग गय?","poem":1},{"text":"अऊ हे यरदन, तेंह काबर उल्टा बहे लगय?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"हे पहाड़मन, तुमन काबर मेढ़ामन सहीं,","poem":1},{"text":"अऊ हे पहाड़ीमन, तुमन काबर मेढ़ा-पीलामन सहीं उछले-कूदे लगेव?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"हे धरती, परभू के आघू म,","poem":1},{"text":"याकूब के परमेसर के आघू म कांप,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"जऊन ह चट्टान ला पानी के कुंड,","poem":1},{"text":"अऊ कठोर पथरा ला पानी के सोता म बदल दीस।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hne_twf/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}