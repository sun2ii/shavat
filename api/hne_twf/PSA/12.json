{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"hebrew_subtitle","content":["संगीत के निरदेसक बर। सेमिनित",{"noteId":10},"के मुताबिक दाऊद के एक भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे यहोवा, मदद कर, काबरकि अऊ कोनो वफादार नइं अंय;","poem":1},{"text":"जऊन मन बिसवासयोग्य अंय, ओमन मनखेमन के बीच ले गायब हो गे हवंय।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"हर एक मनखे अपन परोसी ले लबारी मारथे;","poem":1},{"text":"ओमन अपन मुहूं ले चापलूसी करथें","poem":2},{"lineBreak":true},{"text":"पर अपन मन म धोखा के बात रखथें।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"यहोवा ह जम्मो चापलूसी करइया मुहूं","poem":1},{"text":"अऊ हर ओ घमंड करइया जीभ ला बंद कर देवय—","poem":2}]},{"type":"verse","number":4,"content":[{"text":"जेमन कहिथें,","poem":1},{"text":"“हमन अपन जीभ के दुवारा जीत जाबो;","poem":2},{"lineBreak":true},{"text":"हमर खुद के ओंठ ह हमर बचाव करही—हमर मालिक कोन अय?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"यहोवा ह कहिथे, “मेंह अब उठहूं,","poem":1},{"text":"काबरकि गरीब मनखे ला लूटे जाथे अऊ जरूरतमंद ह कलहरथे।","poem":2},{"lineBreak":true},{"text":"मेंह ओमन ला ओ मनखेमन ले बचाहूं, जेमन ओमन ला कलंकित करत हें।”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"यहोवा के बचन म कोनो कमी नइं ए,","poem":1},{"text":"येह भट्ठी म सुध करे गे चांदी के सहीं अय,","poem":2},{"lineBreak":true},{"text":"ये सात बार सुध करे गे सोन के सहीं अय।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"हे यहोवा, तेंह जरूरतमंद ला सही-सलामत रखबे","poem":1},{"text":"अऊ हमन ला हमेसा बर ओ दुस्टमन ले बचाय रखबे,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"जेमन अकड़के चलथें","poem":1},{"text":"जब दुस्टता ला मनखेमन के दुवारा आदर करे जाथे।","poem":2}]}],"footnotes":[{"noteId":10,"caller":"+","text":"संभवतः संगीत के एक सबद","reference":{"chapter":12,"verse":0}}]},"thisChapterLink":"/api/hne_twf/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}