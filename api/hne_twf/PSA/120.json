pe":"verse","number":6,"content":[{"text":"बहुंत समय तक मेंह ओमन के बीच रहेंव,","poem":1},{"text":"जऊन मन सांति बिलकुल पसंद नइं करंय।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"मोला सांति बने लगथे;","poem":1},{"text":"पर जब मेंह गोठियाथंव, त ओमन लड़ई करे चाहथें।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hne_twf/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}