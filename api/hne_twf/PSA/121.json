{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":121,"content":[{"type":"hebrew_subtitle","content":["आरोहन के एक गीत।"]},{"type":"verse","number":1,"content":[{"text":"मेंह अपन आंखी ला पहाड़मन कोति लगाथंव—","poem":1},{"text":"मोर मदद कहां ले आथे?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"मोर मदद ह यहोवा ले आथे,","poem":1},{"text":"जऊन ह अकास अऊ धरती के रचइया ए।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ओह तोर पांव ला फिसले बर नइं दीही—","poem":1},{"text":"जऊन ह तोर रखवारी करथे, ओह नइं ऊंघय;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"वास्तव म, जऊन ह इसरायल के रखवारी करथे,","poem":1},{"text":"ओह न तो ऊंघय अऊ न ही सुतय।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"यहोवा ह तोर रखवारी करथे—","poem":1},{"text":"यहोवा ह तोर जेवनी हांथ कोति बचाव के तोर छइहां ए;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"न तो दिन के समय सूरज ले","poem":1},{"text":"अऊ न ही रथिया के बेरा चंदा ले तोला कोनो हानि होही।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"यहोवा ह तोला जम्मो हानि ले बचाही—","poem":1},{"text":"ओह तोर जिनगी के रखवारी करही;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"यहोवा ह तोर अवई-जवई म","poem":1},{"text":"तोर रकछा अब ले लेके सदाकाल तक करत रहिही।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hne_twf/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}