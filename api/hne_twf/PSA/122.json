{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["आरोहन के एक गीत। दाऊद के गीत।"]},{"type":"verse","number":1,"content":[{"text":"मेंह ओमन के संग आनंद मनाथंव, जऊन मन मोला कहिन,","poem":1},{"text":"“आवव, यहोवा के घर चलबो।”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"हे यरूसलेम, तोर दुवारमन म","poem":1},{"text":"हमन खड़े हवन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"यरूसलेम ला ओ सहर के सहीं बनाय गे हवय,","poem":1},{"text":"जेकर घरमन एक-दूसर ले एक संग जुड़े हवंय।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ओही ह ओ जगह ए, जिहां गोत्र-गोत्र के मनखे—","poem":1},{"text":"यहोवा के गोत्र के मनखे","poem":2},{"text":"यहोवा के नांव के परसंसा करे बर जाथें,","poem":1},{"text":"अऊ ये परसंसा के काम इसरायल ला दिये गय नियम के मुताबिक होथे।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"उहां नियाय बर सिंघासनमन हवंय,","poem":1},{"text":"अऊ ओमन दाऊद के घराना के सिंघासन अंय।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"यरूसलेम के सांति बर पराथना करव:","poem":1},{"text":"“जऊन मन तोर ले मया करथें, ओमन सुरकछित रहंय।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तोर दीवारमन","poem":1},{"noteId":102},{"text":"के भीतर म सांति","poem":1},{"text":"अऊ तोर गढ़मन म सुरकछा बने रहय।”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"अपन परिवार अऊ संगवारीमन के हित म,","poem":1},{"text":"मेंह कहिहूं, “तुमन म सांति रहय।”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"यहोवा, हमर परमेसर के घर के हित म","poem":1},{"text":"मेंह तुम्हर उन्नति के कोसिस म रहिहूं।","poem":2}]}],"footnotes":[{"noteId":102,"caller":"+","text":"या तोर सहर के दीवारमन","reference":{"chapter":122,"verse":7}}]},"thisChapterLink":"/api/hne_twf/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}