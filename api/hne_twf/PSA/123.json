{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":123,"content":[{"type":"hebrew_subtitle","content":["आरोहन के एक गीत।"]},{"type":"verse","number":1,"content":[{"text":"मेंह अपन नजर तोर कोति करथंव,","poem":1},{"text":"तोर कोति, जऊन ह स्वरग म बिराजमान हे।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"जइसे कि दासमन के नजर ह अपन मालिक के हांथ कोति,","poem":1},{"text":"जइसे कि दासी के नजर ह अपन मालकिन के हांथ कोति लगे रहिथे,","poem":2},{"text":"वइसे ही हमर नजर ह यहोवा, हमर परमेसर कोति तब तक लगे रहिथे,","poem":1},{"text":"जब तक कि ओह हमर ऊपर अपन दया नइं देखावय।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"हे यहोवा, हमर ऊपर दया कर, हमर ऊपर दया कर,","poem":1},{"text":"काबरकि हमन बहुंत अपमान सहे हन।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"घमंडी मनखेमन हमर","poem":1},{"text":"बहुंत हंसी उड़ाय हवंय,","poem":2},{"lineBreak":true},{"text":"घमंडी मनखेमन के हमन घोर अपमान सहे हन।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hne_twf/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}