{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":125,"content":[{"type":"hebrew_subtitle","content":["आरोहन के एक गीत।"]},{"type":"verse","number":1,"content":[{"text":"जऊन मन यहोवा ऊपर भरोसा रखथें, ओमन सियोन पहाड़ सहीं अंय,","poem":1},{"text":"जेला हलाय नइं जा सकय पर येह सदा अटल बने रहिथे।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"जइसे कि पहाड़मन यरूसलेम ला चारों कोति ले घेरे हवंय,","poem":1},{"text":"वइसे ही यहोवा ह अपन मनखेमन ला","poem":2},{"lineBreak":true},{"text":"अब अऊ सदाकाल तक घेरे रहिथे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"दुस्टमन के राजदंड ह धरमीमन ला","poem":1},{"text":"दिये गय भुइयां ऊपर हमेसा बने नइं रहिही,","poem":2},{"text":"काबरकि तब धरमीमन","poem":1},{"text":"अपन हांथ दुस्ट काम करे म लगा सकथें।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"हे यहोवा, ओमन के भलई कर, जऊन मन सीधवा मनखे अंय,","poem":1},{"text":"ओमन के भलई कर, जेमन के मन ह ईमानदार अय।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"पर जऊन मन बेईमानी के रसता ला धरथें","poem":1},{"text":"यहोवा ह ओमन ला दुस्टमन के संग निकाल दीही।","poem":2},{"lineBreak":true},{"text":"इसरायल ला सांति मिलय।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hne_twf/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}