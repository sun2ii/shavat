,"content":[{"text":"धइन अय ओ मनखे","poem":1},{"text":"जेकर तरकस ह ओमन ले भरे हवय।","poem":2},{"text":"जब ओमन अदालत म अपन बिरोधीमन के सामना करहीं","poem":1},{"text":"त ओमन ला लज्जित होना नइं पड़ही।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hne_twf/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}