{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":128,"content":[{"type":"hebrew_subtitle","content":["आरोहन के एक गीत।"]},{"type":"verse","number":1,"content":[{"text":"धइन अंय ओ जम्मो, जऊन मन यहोवा के भय मानथें,","poem":1},{"text":"जऊन मन ओकर हुकूम ला मानत चलथें।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तेंह अपन मेहनत के फल खाबे;","poem":1},{"text":"तोला आसीस मिलही अऊ तोर उन्नति होही।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तोर घरवाली ह तोर घर के भीतर","poem":1},{"text":"फल देवइया अंगूर के एक नार सहीं होही;","poem":2},{"text":"तोर लइकामन तोर मेज के चारों कोति","poem":1},{"text":"जैतून रूख के निकले अंकुर सहीं होहीं।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"हव, येह ओ मनखे बर आसीस होही,","poem":1},{"text":"जऊन ह यहोवा के भय मानथे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"यहोवा ह सियोन ले तोला आसीस देवय;","poem":1},{"text":"तेंह अपन जिनगी भर","poem":2},{"lineBreak":true},{"text":"यरूसलेम के उन्नति देखत रह।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"अपन लइकामन के लइकामन ला देखे बर जीयत रह—","poem":1},{"text":"इसरायल ला सांति मिलय।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hne_twf/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}