,{"text":"जऊन ह बढ़े के पहिले अइला जाथे;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"जेला कोनो लुवइया अपन हांथ म नइं धर सकय,","poem":1},{"text":"न ही कोनो ओला अपन हांथ म कुढ़ो सकथे।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"जऊन मन उहां ले होके जाथें, ओमन ये झन कहंय,","poem":1},{"text":"“यहोवा के आसीस तुम्हर ऊपर होवय;","poem":2},{"lineBreak":true},{"text":"हमन तुमन ला यहोवा के नांव म आसीस देवत हन।”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hne_twf/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}