{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"hebrew_subtitle","content":["संगीत के निरदेसक बर दाऊद के एक भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे यहोवा, कब तक? का तेंह मोला हमेसा बर भुला जाबे?","poem":1},{"text":"कब तक तेंह अपन चेहरा ला मोर ले छुपाय रहिबे?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"कब तक मेंह अपन बिचार म फंसे रहिहूं","poem":1},{"text":"अऊ हर दिन अपन मन म दुखी होवत रहिहूं?","poem":2},{"lineBreak":true},{"text":"कब तक मोर बईरी ह मोर ऊपर जय पावत रहिही?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"हे यहोवा मोर परमेसर, मोर कोति देख अऊ जबाब दे,","poem":1},{"text":"मोर आंखी ला देखे के सक्ति दे, नइं तो मेंह मिरतू के नींद म सो जाहूं,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"नइं तो मोर बईरी ह कहिही, “मेंह ओला जीत डारे हंव,”","poem":1},{"text":"अऊ मोर बईरीमन आनंद मनाहीं, जब में गिर जाहूं।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"पर मेंह तोर अब्बड़ मया ऊपर भरोसा रखथंव;","poem":1},{"text":"मोर हिरदय ह तोर उद्धार म आनंद मनाथे।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"मेंह यहोवा के गीत गाहूं,","poem":1},{"text":"काबरकि ओह मोर भलई करे हवय।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hne_twf/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}