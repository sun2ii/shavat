{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["आरोहन के एक गीत।"]},{"type":"verse","number":1,"content":[{"text":"हे यहोवा, मेंह निरासा के गहरई म ले तोला पुकारत हंव;","poem":1}]},{"type":"verse","number":2,"content":[{"text":"हे परभू, मोर अवाज ला सुन।","poem":2},{"text":"तोर कानमन दया के मोर गोहार ला","poem":1},{"text":"धियान देके सुनंय।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"हे यहोवा, यदि तेंह पाप के लेखा-जोखा रखते,","poem":1},{"text":"त हे परभू, कोन ह ठहर सकतिस?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"पर तेंह छेमा करइया अस,","poem":1},{"text":"ताकि हमन आदर सहित तोर सेवा करन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"मेंह यहोवा के बाट जोहथंव, मोर जम्मो चीज ओकर बाट जोहत रहिथे,","poem":1},{"text":"अऊ ओकर बचन ऊपर मेंह अपन आसा रखथंव।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"पहरेदारमन बिहनियां होय के जतेक बाट जोहथें,","poem":1},{"text":"हां, पहरेदारमन बिहनियां होय के जतेक बाट जोहथें,","poem":2},{"lineBreak":true},{"text":"ओकर ले जादा मेंह परभू के बाट जोहथंव।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"हे इसरायल, यहोवा ऊपर अपन आसा रख,","poem":1},{"text":"काबरकि यहोवा म बहुंत मया हवय","poem":2},{"lineBreak":true},{"text":"अऊ ओहीच ह पूरा छुटकारा देथे।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ओह खुद इसरायलीमन ला","poem":1},{"text":"ओमन के जम्मो पाप ले छुटकारा दीही।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hne_twf/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}