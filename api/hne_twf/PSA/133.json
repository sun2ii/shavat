{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":133,"content":[{"type":"hebrew_subtitle","content":["आरोहन के एक गीत। दाऊद के गीत।"]},{"type":"verse","number":1,"content":[{"text":"येह कतेक बने अऊ खुसी के बात होथे","poem":1},{"text":"जब परमेसर के मनखेमन एकता बनाके एक संग रहिथें!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"येह अइसने ए, मानो कीमती तेल ला मुड़ म डाले गीस,","poem":1},{"text":"जऊन ह दाढ़ी तक बहत हे,","poem":2},{"text":"हव, खाल्हे हारून के दाढ़ी म बहत,","poem":1},{"text":"ओकर कपड़ा के कालर तक पहुंच जाथे।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"येह ओकर सहीं ए, मानो हेरमोन के ओस ह","poem":1},{"text":"सियोन पहाड़ ऊपर गिरत हे।","poem":2},{"text":"काबरकि ओह ओ जगह ए, जिहां यहोवा ह","poem":1},{"text":"हमेसा बर अपन आसीस अऊ जिनगी देथे।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hne_twf/PSA/133.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/134.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/132.json","previousChapterAudioLinks":{},"numberOfVerses":3}