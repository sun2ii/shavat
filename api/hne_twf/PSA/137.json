{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"बेबिलोन देस के नदीमन के तीर म हमन बईठेंन","poem":1},{"text":"अऊ सियोन ला सुरता करके रोए लगेंन।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"उहां चिनार रूखमन म","poem":1},{"text":"हमन अपन बीना ला टांग देंन,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"काबरकि जऊन मन हमन ला बंधुवा बनाके ले गे रिहिन,","poem":1},{"text":"ओमन उहां हमन ला गीत गाय बर कहिन,","poem":2},{"text":"हमन ला सतानेवालामन हमन ला आनंद के गीत गाय बर कहिन;","poem":1},{"text":"ओमन कहिन, “हमर बर सियोन के एक गीत गावव!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"एक आने देस म","poem":1},{"text":"हमन यहोवा के गीत कइसे गा सकत हन?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"हे यरूसलेम, यदि मेंह तोला भूल जावंव,","poem":1},{"text":"त मोर जेवनी हांथ अपन योग्यता ला भूल जावय।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"यदि मेंह तोला सुरता नइं करंव,","poem":1},{"text":"यदि मेंह यरूसलेम ला","poem":2},{"text":"अपन सबले बड़े आनंद नइं मानंव,","poem":1},{"text":"त मोर जीभ ह मोर तालू ले चपक जावय।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"हे यहोवा, सुरता कर कि ओ दिन एदोमीमन का करिन,","poem":1},{"text":"जब यरूसलेम ला गिराय गीस।","poem":2},{"text":"ओमन चिचियाके कहिन, “येला फोरके गिरा दव,","poem":1},{"text":"येला येकर नीव ले गिरा दव!”","poem":2},{"noteId":107}]},{"type":"verse","number":8,"content":[{"text":"हे बेटी बेबिलोन, तोर बिनास होवय,","poem":1},{"text":"ओ मनखे ह खुस रहय, जऊन ह ओ अतियाचार के मुताबिक","poem":2},{"lineBreak":true},{"text":"तोर ले बदला लेथे, जेला तेंह हमर ऊपर करे हस।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ओ मनखे ह खुस रहय, जऊन ह तोर लइकामन ला पकड़के","poem":1},{"text":"चट्टान ऊपर पटक देथे।","poem":2}]}],"footnotes":[{"noteId":107,"caller":"+","text":"देखव ओब 10‑14; यहे 25:12‑14; 35:5‑9","reference":{"chapter":137,"verse":7}}]},"thisChapterLink":"/api/hne_twf/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}