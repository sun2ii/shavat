{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":138,"content":[{"type":"hebrew_subtitle","content":["दाऊद के गीत।"]},{"type":"verse","number":1,"content":[{"text":"हे यहोवा, मेंह अपन पूरा मन से तोर परसंसा करहूं;","poem":1},{"text":"देवतामन के आघू म मेंह तोर परसंसा के गीत गाहूं।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तोर बहुंत मया अऊ तोर बिसवासयोग्यता के कारन","poem":1},{"text":"मेंह तोर पबितर मंदिर कोति मुड़ नवाहूं","poem":2},{"lineBreak":true},{"text":"अऊ तोर नांव के परसंसा करहूं,","poem":2},{"text":"काबरकि तेंह अपन पबितर बचन ला","poem":1},{"text":"अऊ अपन महिमा ला सबले ऊपर करे हस।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"जब मेंह तोला पुकारेंव, त तेंह मोर पराथना के उत्तर देय;","poem":1},{"text":"तेंह मोला बहुंत हिम्मत दे हस।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"हे यहोवा, जब धरती के जम्मो राजामन तोर बचन ला सुनंय,","poem":1},{"text":"त ओमन तोर परसंसा करंय।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ओमन यहोवा के बिधिमन के गीत गावंय,","poem":1},{"text":"काबरकि यहोवा के महिमा ह महान ए।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"हालाकि यहोवा के दरजा बहुंत ऊपर हे, पर ओह नम्र मनखेमन ऊपर दया देखाथे;","poem":1},{"text":"हालाकि ओह बहुंत ऊंचहा हे, पर ओह ओमन ला दूरिहा ले देखथे।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"हालाकि मेंह समस्या म ले होके जाथंव,","poem":1},{"text":"पर तेंह मोर जिनगी ला बनाय रखथस।","poem":2},{"text":"तेंह मोर बईरीमन के कोरोध के बिरूध अपन हांथ बढ़ाथस;","poem":1},{"text":"अपन जेवनी हांथ के दुवारा तेंह मोला बचाथस।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"यहोवा ह मोर रकछा करही,","poem":1},{"text":"हे यहोवा, तोर मया ह हमेसा बर बने रहिथे—","poem":2},{"lineBreak":true},{"text":"अपन हांथ के काममन ला झन तियाग दे।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hne_twf/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}