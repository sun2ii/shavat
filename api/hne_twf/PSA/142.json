{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["दाऊद के एक मसकील",{"noteId":108},", जब ओह गुफा म रिहिस। एक पराथना।"]},{"type":"verse","number":1,"content":[{"text":"मेंह यहोवा ला ऊंचहा अवाज म पुकारथंव;","poem":1},{"text":"मेंह यहोवा ला दया करे बर जोर से गोहारथंव।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"मेंह ओकर आघू म अपन सिकायत ला खुलके बताथंव;","poem":1},{"text":"ओकर आघू म मेंह अपन समस्या ला बताथंव।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"जब मोर आतमा ह मोर भीतरे-भीतर बियाकुल होथे,","poem":1},{"text":"तब तेंहीच ह मोर दसा ला देखथस।","poem":2},{"text":"जऊन रसता म मेंह चलथंव, ओ रसता म","poem":1},{"text":"मनखेमन मोर बर फंदा लगाय हवंय।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"देख, मोर जेवनी कोति कोनो नइं एं;","poem":1},{"text":"मोर कोनो चिंता नइं करंय।","poem":2},{"text":"मोर कोनो सरन-स्थान नइं ए;","poem":1},{"text":"कोनो मोर जिनगी ऊपर धियान नइं देवंय।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"हे यहोवा, मेंह तोला पुकारत हंव;","poem":1},{"text":"मेंह कहिथंव, “तेंह मोर सरन-स्थान,","poem":2},{"lineBreak":true},{"text":"अऊ जीयत परानीमन के देस म मोर भाग अस।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"मोर पुकार ला सुन,","poem":1},{"text":"काबरकि मेंह बहुंत जरूरत म हवंव;","poem":2},{"text":"जऊन मन मोर पीछा करथें, ओमन ले मोला बचा,","poem":1},{"text":"काबरकि ओमन मोर ले बहुंत ताकतवर अंय।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"मोला मोर जेल ले छोंड़ा ले,","poem":1},{"text":"ताकि मेंह तोर परसंसा करंव।","poem":2},{"text":"तब मोर ऊपर तोर भलई के कारन","poem":1},{"text":"धरमी मनखेमन मोर चारों कोति जूरहीं।","poem":2}]}],"footnotes":[{"noteId":108,"caller":"+","text":"संभवतः संगीत के एक सबद","reference":{"chapter":142,"verse":0}}]},"thisChapterLink":"/api/hne_twf/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}