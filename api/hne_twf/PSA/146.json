{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"यहोवा के परसंसा करव।","poem":1},{"lineBreak":true},{"text":"हे मोर मन, यहोवा के परसंसा कर।","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"मेंह जिनगी भर यहोवा के परसंसा करहूं,","poem":1},{"text":"जब तक मेंह जीयत रहिहूं, मेंह अपन परमेसर के परसंसा के गीत गाहूं।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"हाकिममन ऊपर भरोसा झन रखव,","poem":1},{"text":"न ही कोनो मनखे ऊपर, जऊन ह कि रकछा नइं कर सकय।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"जब ओमन के परान चले जाथे, त ओमन माटी म मिल जाथें;","poem":1},{"text":"ओहीच दिन ओमन के योजना ह खतम हो जाथे।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"धइन अंय ओमन, जेमन के मददगार याकूब के परमेसर ए,","poem":1},{"text":"जेमन के आसा ह यहोवा ओमन के परमेसर ऊपर रहिथे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ओह अकास अऊ धरती, समुंदर,","poem":1},{"text":"अऊ ओमा के जम्मो चीजमन ला रचे हवय—","poem":2},{"lineBreak":true},{"text":"ओह हमेसा बिसवासयोग्य बने रहिथे।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ओह दुखित-पीड़ितमन के नियाय करथे","poem":1},{"text":"अऊ भूखन मनखेमन ला जेवन देथे।","poem":2},{"text":"यहोवा ह कैदीमन ला छुड़ाथे,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"यहोवा ह अंधरा ला आंखी देथे,","poem":2},{"text":"यहोवा ह ओमन ला ऊपर उठाथे, जऊन मन खाल्हे झुकथें,","poem":1},{"text":"यहोवा ह धरमीमन ले मया करथे।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"यहोवा ह परदेसीमन के रखवारी करथे","poem":1},{"text":"अऊ अनाथ अऊ बिधवामन ला संभालथे,","poem":2},{"lineBreak":true},{"text":"पर ओह दुस्टमन के योजना ला बिगाड़ देथे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"यहोवा ह सदा-सर्वदा राज करथे,","poem":1},{"text":"हे सियोन, तोर परमेसर ह पीढ़ी-पीढ़ी तक राज करथे।","poem":2},{"lineBreak":true},{"text":"यहोवा के परसंसा करव।","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hne_twf/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}