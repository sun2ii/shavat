{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"यहोवा के परसंसा करव।","poem":1},{"noteId":113},{"lineBreak":true},{"text":"यहोवा बर एक नवां गीत गावव,","poem":1},{"text":"ओकर बिसवासयोग्य मनखेमन के सभा म ओकर परसंसा करव।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"इसरायल ह अपन सिरिस्टीकर्ता म आनंदित होवय;","poem":1},{"text":"सियोन के मनखेमन अपन राजा म खुस होवंय।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ओमन नाचत ओकर नांव के परसंसा करंय","poem":1},{"text":"अऊ ओकर बर खंजरी अऊ बीना बजावंय।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"काबरकि यहोवा ह अपन मनखेमन ले खुस रहिथे;","poem":1},{"text":"ओह नम्र मनखेमन ला जीत के मुकुट पहिराथे।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ओकर बिसवासयोग्य मनखेमन ये आदर पाके आनंद मनावंय","poem":1},{"text":"अऊ अपन दसना म आनंद के गीत गावंय।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ओमन के मुहूं ले परमेसर के परसंसा होवय","poem":1},{"text":"अऊ ओमन के हांथ म दूधारी तलवार रहय,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ताकि जाति-जाति के मनखेमन ले ओमन बदला लेवंय","poem":1},{"text":"अऊ मनखेमन ला दंड देवंय,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"अऊ ओमन के राजामन ला बेड़ी म,","poem":1},{"text":"अऊ ओमन के परभावसाली मनखेमन ला लोहा के संकली म बांधंय,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"अऊ ओमन के बिरूध दंड के हुकूम ले जावंय—","poem":1},{"text":"येह ओकर जम्मो बिसवासयोग्य मनखेमन के महिमा ए।","poem":2},{"lineBreak":true},{"text":"यहोवा के परसंसा करव।","poem":1}]}],"footnotes":[{"noteId":113,"caller":"+","text":"इबरानी म हलिलूयाह; पद 9म घलो","reference":{"chapter":149,"verse":1}}]},"thisChapterLink":"/api/hne_twf/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}