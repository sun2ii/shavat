{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":15,"content":[{"type":"hebrew_subtitle","content":["दाऊद के एक भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे यहोवा, तोर पबितर तम्बू म कोन निवास कर सकथे?","poem":1},{"text":"तोर पबितर पहाड़ म कोन रह सकथे?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ओ, जेकर चालचलन ह निरदोस हे,","poem":1},{"text":"जऊन ह धरमी काम करथे,","poem":2},{"lineBreak":true},{"text":"जऊन ह अपन हिरदय ले सच बोलथे;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"जेकर मुहूं ले निन्दा के बात नइं निकलय,","poem":1},{"text":"जऊन ह अपन परोसी के बिरूध कोनो गलत काम नइं करय,","poem":2},{"lineBreak":true},{"text":"अऊ आने मन के निन्दा नइं करय;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"जऊन ह दुस्ट मनखे ला तुछ समझथे","poem":1},{"text":"पर ओमन के आदर करथे, जेमन यहोवा ले डरथें;","poem":2},{"text":"जऊन ह हानि उठाके घलो अपन सपथ ला पूरा करथे,","poem":1},{"text":"अऊ अपन मन ला नइं बदलय;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"जऊन ह बिगर बियाज के गरीब ला अपन पईसा उधार देथे;","poem":1},{"text":"जऊन ह निरदोस मनखे ले घूस नइं लेवय।","poem":2},{"lineBreak":true},{"text":"जऊन ह ये काममन ला करथे,","poem":1},{"text":"ओह कभू नइं डोलय।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hne_twf/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}