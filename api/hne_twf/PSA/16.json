{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":16,"content":[{"type":"hebrew_subtitle","content":["दाऊद के एक मिकताम",{"noteId":11},"।"]},{"type":"verse","number":1,"content":[{"text":"हे मोर परमेसर, मोला सुरकछित रख,","poem":1},{"text":"काबरकि तोर करा मेंह सरन लेवत हंव।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"मेंह यहोवा ले कहिथंव, “तेंह मोर परभू अस;","poem":1},{"text":"तोर छोंड़ मोर करा अऊ कोनो बने चीज नइं ए।”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ओ पबितर मनखे, जऊन मन देस म हवंय, ओमन के बारे मेंह कहिथंव,","poem":1},{"text":"“ओमन उत्तम मनखे अंय, जेमन म मोर जम्मो खुसी हवय।”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ओ मनखे, जऊन मन आने देवतामन के पाछू भागथें, ओमन के दुख बढ़ते ही जाही।","poem":1},{"text":"मेंह अइसन देवतामन ला लहू के अरपन नइं करंव","poem":2},{"lineBreak":true},{"text":"अऊ न ही मोर मुहूं ले ओमन के नांव लेवंव।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"हे यहोवा, सिरिप तेंहीच ह मोर हिस्सा अऊ मोर कटोरा अस;","poem":1},{"text":"तेंह मोर हिस्सा ला सुरकछित रखथस।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"सीमना रेखा ह मोर बर खुसी के जगह म पड़े हवय;","poem":1},{"text":"सही म मोर करा मनभावन बिरासत हवय।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"मेंह यहोवा के परसंसा करहूं, जऊन ह मोला सलाह देथे;","poem":1},{"text":"अऊ त अऊ रथिया के बेरा घलो मोर मन ह मोला सिखोथे।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"मोर आंखी ह हमेसा यहोवा ऊपर लगे रहिथे।","poem":1},{"text":"ओह मोर जेवनी हांथ कोति हवय, मेंह नइं डोलंव।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"एकरसेति मोर मन ह खुस हवय अऊ मोर मुहूं ह आनंद मनाथे;","poem":1},{"text":"मोर देहें घलो चैन से अराम करही।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"काबरकि तेंह मोला मरे मनखेमन के लोक म नइं छोंड़बे,","poem":1},{"text":"अऊ न ही अपन बिसवासयोग्य जन","poem":2},{"noteId":12},{"text":"ला तेंह सड़न देबे।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तेंह मोला जिनगी के रसता देखाथस;","poem":1},{"text":"तेंह अपन आघू म मोला आनंद ले भर देबे,","poem":2},{"lineBreak":true},{"text":"तोर जेवनी हांथ म अनंतकाल के खुसी रहिही।","poem":2}]}],"footnotes":[{"noteId":11,"caller":"+","text":"संभवतः संगीत के एक सबद","reference":{"chapter":16,"verse":0}},{"noteId":12,"caller":"+","text":"या पबितर जन","reference":{"chapter":16,"verse":10}}]},"thisChapterLink":"/api/hne_twf/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}