{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"hebrew_subtitle","content":["संगीत के निरदेसक बर दाऊद के एक भजन।"]},{"type":"verse","number":1,"content":[{"text":"बिपत्ति के बेरा म यहोवा ह तोर बिनती के जबाब देवय;","poem":1},{"text":"याकूब के परमेसर के नांव ह तोला बचावय।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"पबितर-स्थान ले ओह तोर बर मदद पठोवय","poem":1},{"text":"अऊ सियोन ले तोला मदद देवय।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ओह तोर जम्मो बलिदान ला सुरता करय;","poem":1},{"text":"अऊ तोर होम-बलिदान ला स्वीकार करय।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ओह तोर मन के ईछा ला पूरा करय","poem":1},{"text":"अऊ तोर जम्मो योजना ला सफल करय।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"हमन तोर जय के कारन आनंद के मारे चिचियावन","poem":1},{"text":"अऊ अपन परमेसर के नांव के झंडा ला ऊंचा करन।","poem":2},{"lineBreak":true},{"text":"यहोवा ह तोर जम्मो बिनती ला पूरा करय।","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"अब ये बात मेंह जानत हंव:","poem":1},{"text":"यहोवा ह अपन अभिसिक्त जन ला बिजयी बनाथे।","poem":2},{"text":"ओह ओला अपन स्वरगीय पबितर-स्थान ले","poem":1},{"text":"अपन जेवनी हांथ के बिजयी सक्ति के संग जबाब देथे।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"कुछू मनखेमन रथ ऊपर अऊ कुछू मनखेमन घोड़ामन ऊपर भरोसा करथें,","poem":1},{"text":"पर हमन तो यहोवा हमर परमेसर के नांव ऊपर भरोसा करथन।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ओमन ला ओमन के माड़ी म लाय जाथे अऊ ओमन गिरथें,","poem":1},{"text":"पर हमन उठके मजबूती से खड़े रहिथन।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"हे यहोवा, राजा ला बिजयी बना!","poem":1},{"text":"जब हमन पुकारथन, त हमन ला जबाब दे!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hne_twf/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}