{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":24,"content":[{"type":"hebrew_subtitle","content":["दाऊद के एक भजन।"]},{"type":"verse","number":1,"content":[{"text":"धरती अऊ येमा के हर एक चीज यहोवा के अय,","poem":1},{"text":"संसार, अऊ ओ जम्मो जेमन येमा रहिथें;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"काबरकि ओह एकर नीव समुंदरमन के ऊपर रखिस","poem":1},{"text":"अऊ पानी के ऊपर येला इस्थिर करिस।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"यहोवा के पहाड़ ऊपर कोन चढ़ सकत हे?","poem":1},{"text":"ओकर पबितर स्थान म कोन ठाढ़ हो सकत हे?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ओह, जेकर काम सही अऊ हिरदय सुध हवय,","poem":1},{"text":"जऊन ह मूरती ऊपर भरोसा नइं करय","poem":2},{"lineBreak":true},{"text":"या लबरा ईस्वर के सपथ नइं खावय।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ओह यहोवा ले आसीस पाही","poem":1},{"text":"अऊ ओला अपन उद्धार करइया परमेसर ले सुरकछा मिलही।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"अइसने ही होथे ओमन के पीढ़ी, जऊन मन परमेसर के खोज करथें,","poem":1},{"text":"हे याकूब के परमेसर, जऊन मन तोर दरसन के खोज म रहिथें।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"हे दुवारमन, अपन मुड़ ला ऊंचा करव;","poem":1},{"text":"हे पुराना जमाना के कपाटमन, ऊपर उठव,","poem":2},{"lineBreak":true},{"text":"ताकि महिमा के राजा ह भीतर आवय।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ये महिमा के राजा कोन ए?","poem":1},{"text":"यहोवा, जऊन ह बलवान अऊ सक्तिसाली ए,","poem":2},{"lineBreak":true},{"text":"यहोवा, जऊन ह लड़ई म सक्तिसाली ए।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"हे दुवारमन, अपन मुड़ ला ऊंचा करव;","poem":1},{"text":"हे पुराना जमाना के कपाटमन, ऊपर उठव,","poem":2},{"lineBreak":true},{"text":"ताकि महिमा के राजा ह भीतर आवय।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ये महिमा के राजा कोन ए?","poem":1},{"text":"सर्वसक्तिमान यहोवा—","poem":2},{"lineBreak":true},{"text":"ओह महिमा के राजा अय।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hne_twf/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}