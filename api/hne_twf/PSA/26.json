{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"hebrew_subtitle","content":["दाऊद के भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे यहोवा, मोला नियाय दे,","poem":1},{"text":"काबरकि मेंह एक निरदोस जिनगी जीये हवंव;","poem":2},{"text":"मेंह यहोवा ऊपर भरोसा करे हंव","poem":1},{"text":"अऊ नइं डगमगाय हंव।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"हे यहोवा, मोला परख अऊ मोला जांच,","poem":1},{"text":"मोर हिरदय अऊ मोर मन ला जांच ले;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"काबरकि तोर अटूट मया के खियाल मोर मन म हमेसा रहिथे","poem":1},{"text":"अऊ मेंह तोर बिसवासयोग्यता के भरोसा म जीयत हंव।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"मेंह धोखेबाजमन के संग म नइं बईठंव,","poem":1},{"text":"अऊ न ही पाखंडीमन के संगति करंव।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"मेंह गलत काम करइयामन के संगति ले घिन करथंव","poem":1},{"text":"अऊ दुस्टमन के संग नइं बईठंव।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"हे यहोवा, मेंह अपन हांथ ला निरदोस रखथंव,","poem":1},{"text":"अऊ तोर बेदी करा जाथंव,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"अऊ ऊंचहा अवाज म तोर परसंसा करथंव","poem":1},{"text":"अऊ तोर जम्मो अद्भूत काममन ला बताथंव।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"हे यहोवा, मेंह ओ घर ले मया करथंव, जिहां तेंह रहिथस,","poem":1},{"text":"ओ जगह जिहां तोर महिमा रहिथे।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"मोर परान ला पापीमन के संग","poem":1},{"text":"अऊ मोर जिनगी ला खून के पीयासामन के संग झन ले,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"जेमन के हांथमन दुस्टता के उपाय करथें,","poem":1},{"text":"अऊ जेमन के जेवनी हांथ ह घूसखोरी ले भरे हवय।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"मेंह तो निरदोस जिनगी जीथंव;","poem":1},{"text":"मोला छोंड़ा ले अऊ मोर ऊपर दया कर।","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"मेंह समतल भुइयां म ठाढ़े हवंव;","poem":1},{"text":"सभामन म मेंह यहोवा के इस्तुति करहूं।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hne_twf/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}