{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":29,"content":[{"type":"hebrew_subtitle","content":["दाऊद के एक भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे स्वरगीय जीवमन,","poem":1},{"noteId":16},{"text":"यहोवा के बखान करव,","poem":1},{"text":"यहोवा के महिमा अऊ बल के बखान करव।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"यहोवा के नांव के मुताबिक ओकर बखान करव;","poem":1},{"text":"यहोवा के पबितरता के सोभा म ओकर अराधना करव।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"यहोवा के अवाज समुंदर के ऊपर म हवय;","poem":1},{"text":"महिमा के परमेसर ह गरजथे,","poem":2},{"lineBreak":true},{"text":"यहोवा ह समुंदर के भयंकर लहरामन ऊपर गरजथे।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"यहोवा के अवाज ह सक्तिसाली अय;","poem":1},{"text":"यहोवा के अवाज ह सानदार हवय।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"यहोवा के अवाज ह देवदार के रूख ला टोर देथे;","poem":1},{"text":"यहोवा ह लबानोन के देवदार रूखमन ला कुटा-कुटा कर देथे।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ओह लबानोन ला एक बछरू के सहीं","poem":1},{"text":"अऊ सिरयोन","poem":2},{"noteId":17},{"text":"ला जंगली बईला के सहीं उछालथे।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"यहोवा के अवाज ह","poem":1},{"text":"बिजली के चमक के संग चोट करथे।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"यहोवा के अवाज ह बीरान भुइयां ला हला देथे;","poem":1},{"text":"यहोवा ह कादेस के बीरान भुइयां ला घलो हला देथे।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"यहोवा के अवाज ह बांज के रूख ला मुरकेट देथे","poem":1},{"noteId":18},{"text":"अऊ जंगल म पतझड़ हो जाथे।","poem":2},{"text":"अऊ ओकर मंदिर म जम्मो झन चिचियाके कहिथें, “परमेसर के महिमा होवय!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"यहोवा ह बाढ़ के पानी ऊपर बिराजमान होथे;","poem":1},{"text":"यहोवा ह सदाकाल बर राजा के रूप म बिराजमान होथे।","poem":2}]},{"type":"verse","number":11,"content":[{"text":"यहोवा ह अपन मनखेमन ला ताकत देथे;","poem":1},{"text":"यहोवा ह अपन मनखेमन ला सांति के आसीस देथे।","poem":2}]}],"footnotes":[{"noteId":16,"caller":"+","text":"स्वरगीय जीवमन के मतलब स्वरगदूतमन हो सकथे","reference":{"chapter":29,"verse":1}},{"noteId":17,"caller":"+","text":"हेरमोन पहाड़","reference":{"chapter":29,"verse":6}},{"noteId":18,"caller":"+","text":"या यहोवा ह हिरन ले पीला जनमवाथे","reference":{"chapter":29,"verse":9}}]},"thisChapterLink":"/api/hne_twf/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}