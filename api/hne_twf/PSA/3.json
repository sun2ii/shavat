{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["दाऊद के एक भजन। जब ओह अपन बेटा अबसालोम करा ले भागत रिहिस।"]},{"type":"verse","number":1,"content":[{"text":"हे यहोवा, कतेक जादा हवंय मोर बईरीमन!","poem":1},{"text":"कतेक मनखेमन मोर बिरोध म ठाढ़ होवत हें!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"बहुंते झन मोर बारे म कहत हें,","poem":1},{"text":"“परमेसर ह ओला नइं बचाय।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"पर हे यहोवा, तेंह मोर चारों कोति एक ढाल अस,","poem":1},{"text":"तेंह मोर महिमा अस, अऊ तेंह मोर मुड़ ला ऊंचहा करथस।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"मेंह यहोवा ला जोर से पुकारथंव,","poem":1},{"text":"अऊ ओह अपन पबितर पहाड़ ले मोला जबाब देथे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"मेंह लेटथंव अऊ सुत जाथंव;","poem":1},{"text":"मेंह फेर जागथंव, काबरकि यहोवा ह मोला संभालथे।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"मेंह ओ हजारों-हजार मनखेमन ले नइं डरंव,","poem":1},{"text":"जेमन चारों कोति ले मोर ऊपर हमला करथें।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"हे यहोवा, उठ!","poem":1},{"text":"हे मोर परमेसर, मोला बचा!","poem":2},{"text":"मोर जम्मो बईरीमन के जबड़ा म मार;","poem":1},{"text":"अऊ दुस्टमन के दांत ला टोर दे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"छुटकारा यहोवा ही देथे।","poem":1},{"text":"हे यहोवा, तोर आसीस तोर मनखेमन ऊपर होवय।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hne_twf/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}