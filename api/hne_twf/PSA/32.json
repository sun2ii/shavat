{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":32,"content":[{"type":"hebrew_subtitle","content":["दाऊद के एक मसकील",{"noteId":22},"।"]},{"type":"verse","number":1,"content":[{"text":"धइन अय ओ मनखे,","poem":1},{"text":"जेकर अपराध छेमा करे जाथे,","poem":2},{"lineBreak":true},{"text":"जेकर पाप तोपे जाथे।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"धइन अय ओ मनखे,","poem":1},{"text":"जेकर पाप ला यहोवा ह ओकर बिरूध नइं गनय","poem":2},{"lineBreak":true},{"text":"अऊ जेकर आतमा म कोनो कपट के बात नइं ए।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"जब मेंह कलेचुप रहंय,","poem":1},{"text":"त दिन भर कलहरत-कलहरत","poem":2},{"lineBreak":true},{"text":"मोर हाड़ामन बेकार होय लगिन।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"काबरकि रात अऊ दिन","poem":1},{"text":"तोर हांथ ह मोर ऊपर भारी पड़िस;","poem":2},{"text":"अऊ जइसे घाम महिना के घाम म चीजमन सूखा जाथें","poem":1},{"text":"वइसे मोर बल ह कम हो गीस।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"तब मेंह अपन पाप ला तोर आघू म मान लेंव","poem":1},{"text":"अऊ मोर अपराध ला नइं छुपांय।","poem":2},{"text":"मेंह कहेंव, “मेंह यहोवा के आघू म","poem":1},{"text":"अपन पाप ला मान लूहूं।”","poem":2},{"text":"अऊ तेंह मोर पाप के दोस ला","poem":1},{"text":"छेमा करय।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"एकरसेति जम्मो बिसवासयोग्य मनखेमन तोर ले पराथना करंय","poem":1},{"text":"जब तेंह मिल सकत हस;","poem":2},{"text":"खचित संकट रूपी पानी के भयंकर लहरामन","poem":1},{"text":"ओमन करा नइं हबरहीं।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तेंह मोर छुपे के जगह अस;","poem":1},{"text":"तेंह मोला संकट ले बचाबे","poem":2},{"lineBreak":true},{"text":"अऊ छुटकारा के गीत म मोला घेर लेबे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"मेंह तोला निरदेस दूहूं अऊ ओ रसता के बात सिखाहूं, जेमा तोला जाना चाही;","poem":1},{"text":"मेंह तोर ऊपर अपन मया के नजर रखके तोला सलाह दूहूं।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तेंह घोड़ा अऊ खच्चर के सहीं झन बन,","poem":1},{"text":"जेमन करा कोनो समझ नइं रहय","poem":2},{"text":"पर ओमन ला काठी अऊ लगाम ले काबू म करे जाथे","poem":1},{"text":"नइं तो ओमन तुम्हर लकठा म नइं आवंय।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"दुस्टमन के दुख-तकलीफ बहुंत हवय,","poem":1},{"text":"पर यहोवा के अब्बड़ मया ह","poem":2},{"lineBreak":true},{"text":"ओमन ला घेरे रहिथे, जऊन मन ओकर ऊपर भरोसा करथें।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"हे धरमी मनखेमन, यहोवा म आनंद मनावव अऊ खुस रहव;","poem":1},{"text":"अऊ हे मन के जम्मो सीधवा मनखेमन, तुमन गीत गावव।","poem":2}]}],"footnotes":[{"noteId":22,"caller":"+","text":"संभवतः संगीत के एक सबद","reference":{"chapter":32,"verse":0}}]},"thisChapterLink":"/api/hne_twf/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}