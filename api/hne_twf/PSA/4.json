{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"hebrew_subtitle","content":["संगीत के निरदेसक बर। तारवाले बाजामन के संग। दाऊद के एक भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे मोर धरमी परमेसर,","poem":1},{"text":"जब मेंह तोला बलावंव, त तेंह मोला जबाब दे।","poem":2},{"text":"मोला मोर बिपत्ति म सहारा दे;","poem":1},{"text":"मोर ऊपर दया कर अऊ मोर पराथना ला सुन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"हे मनखेमन! तुमन कब तक मोर महिमा के बेजत्ती करत रहिहू?","poem":1},{"text":"तुमन कब तक भरम ले मया करत रहिहू अऊ लबरा देवतामन के खोज म रहिहू?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तुमन जान लव कि यहोवा ह अपन बिसवासयोग्य सेवक ला अपन बर अलग रखे हवय;","poem":1},{"text":"जब मेंह यहोवा ला पुकारथंव, त ओह मोर बात ला सुनथे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"कांपत रहव अऊ","poem":1},{"noteId":1},{"text":"पाप झन करव;","poem":1},{"text":"जब तुमन अपन दसना म रहिथव,","poem":2},{"lineBreak":true},{"text":"त अपन मन ला जांचव अऊ चुप रहव।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"धरमीपन के बलिदान चघावव","poem":1},{"text":"अऊ यहोवा ऊपर भरोसा रखव।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"बहुंते जन पुछत हवंय, “कोन ह हमर उन्नति करही?”","poem":1},{"text":"हे यहोवा, तोर मुख के अंजोर हमर ऊपर चमका।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"जब ओमन के अनाज अऊ नवां अंगूर के मंद बहुंत होथे,","poem":1},{"text":"त तेंह मोर मन ला आनंद ले भर दे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"सांति से मेंह लेटहूं अऊ सुतहूं,","poem":1},{"text":"काबरकि हे यहोवा, तेंहीच ह","poem":2},{"lineBreak":true},{"text":"मोला सुरकछा म रखथस।","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"या गुस्सा होके","reference":{"chapter":4,"verse":4}}]},"thisChapterLink":"/api/hne_twf/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}