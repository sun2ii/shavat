{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"हे मोर परमेसर, मोला निरदोस साबित कर,","poem":1},{"text":"बिसवासघाती जाति के मनखेमन के बिरूध","poem":2},{"lineBreak":true},{"text":"मोर मामला ला देख।","poem":2},{"text":"ओमन ले मोला बचा,","poem":1},{"text":"जऊन मन धोखेबाज अऊ दुस्ट अंय।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तेंह परमेसर अस अऊ मोर मजबूत गढ़ अस।","poem":1},{"text":"तेंह काबर मोला तिरस्कार करे हस?","poem":2},{"text":"बईरी के दुवारा दुख मिले के कारन","poem":1},{"text":"मेंह काबर सोक मनावंव?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"अपन अंजोर अऊ सच्चई ला मोर करा पठो,","poem":1},{"text":"ओमन मोर अगुवई करंय;","poem":2},{"text":"ओमन मोला तोर पबितर पहाड़ करा लानंय,","poem":1},{"text":"ओ जगह म जिहां तेंह रहिथस।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तब मेंह परमेसर के बेदी करा जाहूं,","poem":1},{"text":"ओ परमेसर, जऊन ह मोर आनंद अऊ मोर खुसी अय।","poem":2},{"text":"हे परमेसर, मोर परमेसर,","poem":1},{"text":"मेंह बीना बजा-बजाके तोर इस्तुति करहूं।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"हे मोर मन, तेंह काबर उदास होवत हस?","poem":1},{"text":"मोर भीतरे-भीतर काबर अतेक बियाकुल हस?","poem":2},{"text":"परमेसर ऊपर अपन आसा रख,","poem":1},{"text":"काबरकि मेंह अब भी","poem":2},{"lineBreak":true},{"text":"मोर उद्धारकर्ता अऊ मोर परमेसर के परसंसा करहूं।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hne_twf/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}