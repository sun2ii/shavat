{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":46,"content":[{"type":"hebrew_subtitle","content":["संगीत के निरदेसक बर। कोरह के बेटामन के अलामोत",{"noteId":31},"के मुताबिक एक गीत।"]},{"type":"verse","number":1,"content":[{"text":"परमेसर ह हमर सरन-स्थान अऊ बल अय,","poem":1},{"text":"बिपत के बेरा म ओह मदद करे बर हमेसा तियार रहिथे।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"एकरसेति हमन नइं डरन, चाहे धरती ह पलट जावय","poem":1},{"text":"अऊ पहाड़ ह समुंदर के गरभ म जा गिरय।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"चाहे समुंदर के पानी ह गरजय अऊ ओमा ले फेन निकलय","poem":1},{"text":"अऊ ओकर बड़े लहरामन ले पहाड़मन कांप उठंय।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"एक नदी हवय, जेकर जल-धारामन परमेसर के सहर ला खुस कर देथें,","poem":1},{"text":"ये ओ पबितर स्थान अय, जिहां सर्वोच्च परमेसर ह रहिथे।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"परमेसर ह ओ नगर","poem":1},{"noteId":32},{"text":"म हवय, ओ नगर ह नइं गिरय;","poem":1},{"text":"बड़े बिहनियां परमेसर ह ओकर मदद करही।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"जाति-जाति के मनखेमन के बीच खलबली मचे हवय, कतको राजमन गिर जावत हें;","poem":1},{"text":"ओह अपन अवाज ऊंचा करथे, त धरती ह टघल जाथे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"यहोवा सर्वसक्तिमान ह हमर संग हवय;","poem":1},{"text":"याकूब के परमेसर ह हमर गढ़ अय।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"आवव अऊ यहोवा के काम ला देखव","poem":1},{"text":"कि ओह धरती ला कइसे उजाड़ दे हवय।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ओह धरती के छोर तक","poem":1},{"text":"लड़ई ला रोक देथे।","poem":2},{"text":"ओह धनुस ला टोर देथे अऊ बरछी ला कुटा-कुटा कर देथे;","poem":1},{"text":"ओह ढालमन","poem":2},{"noteId":33},{"text":"ला आगी म जला देथे।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ओह कहिथे, “सांत रहव, अऊ ये बात ला जान लव कि मेंह परमेसर अंव;","poem":1},{"text":"जाति-जाति के मनखेमन के बीच मोर नांव ला ऊंचा करे जाही,","poem":2},{"lineBreak":true},{"text":"धरती म मोर नांव ला ऊंचा करे जाही।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"यहोवा सर्वसक्तिमान ह हमर संग हवय;","poem":1},{"text":"याकूब के परमेसर ह हमर गढ़ अय।","poem":2}]}],"footnotes":[{"noteId":31,"caller":"+","text":"संभवतः संगीत के एक सबद","reference":{"chapter":46,"verse":0}},{"noteId":32,"caller":"+","text":"या यरूसलेम","reference":{"chapter":46,"verse":5}},{"noteId":33,"caller":"+","text":"या रथमन","reference":{"chapter":46,"verse":9}}]},"thisChapterLink":"/api/hne_twf/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}