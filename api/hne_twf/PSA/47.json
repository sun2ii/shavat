{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["संगीत के निरदेसक बर कोरह के बेटामन के एक भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे देस-देस के जम्मो मनखेमन, ताली बजावव;","poem":1},{"text":"आनंद के जय-जयकार के संग परमेसर ला पुकारव।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"काबरकि यहोवा, सर्वोच्च परमेसर ह अद्भूत ए,","poem":1},{"text":"ओह जम्मो धरती ऊपर महाराजा अय।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ओह देस-देस के मनखेमन ला","poem":1},{"text":"हमर अधीन, हमर गोड़ खाल्हे कर दे हवय।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ओह हमर निज भाग ला हमर बर चुनिस,","poem":1},{"text":"जऊन ह ओकर मयारू याकूब के घमंड के कारन अय।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"परमेसर ह आनंद के जय-जयकार के बीच ऊपर गे हवय,","poem":1},{"text":"यहोवा ह तुरही के अवाज के संग ऊपर गे हवय।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"परमेसर के परसंसा के गीत गावव, परसंसा के गीत गावव;","poem":1},{"text":"हमर राजा के परसंसा के गीत गावव, परसंसा के गीत गावव।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"काबरकि परमेसर ह जम्मो धरती के राजा अय;","poem":1},{"text":"ओकर परसंसा के भजन गावव।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"परमेसर ह जाति-जाति के मनखेमन ऊपर राज करथे;","poem":1},{"text":"परमेसर ह अपन पबितर सिंघासन म बिराजे हवय।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"राज-राज के परभावसाली मनखेमन","poem":1},{"text":"अब्राहम के परमेसर के मनखेमन के रूप म जूरथें,","poem":2},{"text":"काबरकि धरती के राजामन","poem":1},{"noteId":34},{"text":"परमेसर के अंय;","poem":1},{"text":"ओला बहुंत ऊपर करे जाथे।","poem":2}]}],"footnotes":[{"noteId":34,"caller":"+","text":"या ढालमन","reference":{"chapter":47,"verse":9}}]},"thisChapterLink":"/api/hne_twf/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}