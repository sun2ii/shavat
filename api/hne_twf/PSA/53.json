{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":53,"content":[{"type":"hebrew_subtitle","content":["संगीत के निरदेसक बर। महलत",{"noteId":38},"के मुताबिक दाऊद के एक मसकील।"]},{"type":"verse","number":1,"content":[{"text":"मुरूख ह अपन मन म कहिथे,","poem":1},{"text":"“परमेसर नइं ए।”","poem":2},{"text":"ओमन बिगड़ गे हवंय, अऊ ओमन के चालचलन ह निकम्मा ए;","poem":1},{"text":"अइसे कोनो नइं ए, जऊन ह भलई करथे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"परमेसर ह स्वरग ले","poem":1},{"text":"जम्मो मानव-जाति ला ये आसा म देखथे","poem":2},{"text":"कि कोनो समझदार हवय कि नइं,","poem":1},{"text":"कोनो परमेसर के खोज करथे कि नइं।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"हर मनखे ह भटक गे हवय, जम्मो झन बिगड़ गे हवंय;","poem":1},{"text":"अइसे कोनो नइं ए, जऊन ह भलई करथे,","poem":2},{"lineBreak":true},{"text":"एको झन घलो नइं।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"का ये जम्मो दुस्ट काम करइयामन कुछू नइं जानंय?","poem":1},{"lineBreak":true},{"text":"ओमन मोर मनखेमन ला अइसे खा जाथें, मानो कि रोटी खावत हें;","poem":1},{"text":"ओमन कभू परमेसर के नांव नइं लेवंय।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"जिहां डरे के कोनो बात नइं रहय,","poem":1},{"text":"उहां ओमन डर के मारे घबरा गे हवंय।","poem":2},{"text":"जऊन मन तोर ऊपर हमला करिन, परमेसर ह ओमन के हाड़ामन ला बिखेर दीस;","poem":1},{"text":"तेंह ओमन ला लज्जित करय, काबरकि परमेसर ह ओमन ला तुछ जानिस।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"बने होतिस कि इसरायल बर उद्धार ह सियोन ले बाहिर आतिस!","poem":1},{"text":"जब परमेसर ह अपन मनखेमन ला पहिले के सहीं कर देथे,","poem":2},{"lineBreak":true},{"text":"त याकूब ह आनंद मनावय अऊ इसरायल ह खुस होवय!","poem":2}]}],"footnotes":[{"noteId":38,"caller":"+","text":"संभवतः संगीत के एक सबद","reference":{"chapter":53,"verse":0}}]},"thisChapterLink":"/api/hne_twf/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}