{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["संगीत के निरदेसक बर। तारवाले बाजामन के संग। दाऊद के एक मसकील",{"noteId":39},"। जब जीपीमन साऊल करा जाके कहिन, “का दाऊद ह हमर बीच म नइं छिपे हे?”"]},{"type":"verse","number":1,"content":[{"text":"हे परमेसर, अपन नांव के दुवारा मोर उद्धार कर;","poem":1},{"text":"अपन सक्ति के दुवारा मोला सही साबित कर।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"हे परमेसर, मोर पराथना ला सुन;","poem":1},{"text":"मोर मुहूं के बात ऊपर धियान दे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"घमंडी बईरीमन मोर ऊपर हमला करत हवंय;","poem":1},{"text":"निरदयी मनखेमन मोला मार डारे के कोसिस करत हवंय—","poem":2},{"lineBreak":true},{"text":"ओ मनखे, जेमन के मन म परमेसर बर कोनो आदर नइं ए।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"खचित परमेसर ह मोर मददगार ए;","poem":1},{"text":"परभू ही मोला संभालथे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ओमन के निन्दा होवय, जऊन मन मोर निन्दा करथें;","poem":1},{"text":"हे परमेसर, अपन बिसवासयोग्यता म ओमन ला नास कर दे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"मेंह तोला एक स्वेच्छा-बलिदान चघाहूं;","poem":1},{"text":"हे यहोवा, मेंह तोर नांव के परसंसा करहूं, काबरकि येह बने ए।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तेंह मोला मोर जम्मो समस्या ले छुटकारा दे हस,","poem":1},{"text":"अऊ मोर आंखी ह मोर बईरीमन ऊपर बिजय ला देखे हवय।","poem":2}]}],"footnotes":[{"noteId":39,"caller":"+","text":"संभवतः संगीत के एक सबद","reference":{"chapter":54,"verse":0}}]},"thisChapterLink":"/api/hne_twf/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}