{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":6,"content":[{"type":"hebrew_subtitle","content":["संगीत के निरदेसक बर। तारवाले बाजामन के संग। सेमिनित",{"noteId":2},"के मुताबिक। दाऊद के एक भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे यहोवा, अपन गुस्सा म मोला झन फटकार","poem":1},{"text":"या अपन कोप म मोर ताड़ना झन कर।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"हे यहोवा मोर ऊपर दया कर, काबरकि मेंह दुरबल हो गे हंव;","poem":1},{"text":"हे यहोवा, मोर बेमारी ला बने कर दे, काबरकि मोर हाड़ामन म पीरा हवय।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"मोर परान ह अब्बड़ पीरा म हवय।","poem":1},{"text":"हे यहोवा, कब तक, कब तक ठहिरे रहिबे?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"हे यहोवा, किंदरके मोला छुड़ा;","poem":1},{"text":"अपन बहुंते मया के कारन मोला बचा।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"मरे मनखेमन के बीच कोनो तोर नांव के परचार नइं करंय।","poem":1},{"text":"कबर ले कोन ह तोर इस्तुति करथे?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"मेंह कराहत-कराहत थक गे हंव।","poem":1},{"lineBreak":true},{"text":"पूरा रथिया रोवत-रोवत मोर दसना ह भीग जाथे","poem":1},{"text":"अऊ मोर आंसू ले मोर पलंग ह भीग जाथे।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"मोर आंखीमन दुख के मारे कमजोर होवत हें;","poem":1},{"text":"मोर जम्मो बईरीमन के कारन ओमन धुंधला गे हवंय।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"हे जम्मो दुस्ट काम करइयामन, मोर ले दूरिहा हटव,","poem":1},{"text":"काबरकि यहोवा ह मोर रोये के अवाज ला सुने हवय।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"यहोवा ह दया बर मोर रोवई ला सुने हवय;","poem":1},{"text":"यहोवा ह मोर पराथना ला गरहन करथे।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"मोर जम्मो बईरीमन लाज अऊ पीरा के मारे घबराहीं;","poem":1},{"text":"ओमन पाछू मुड़हीं अऊ अचानक लज्जित होहीं।","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"संभवतः संगीत के एक सबद","reference":{"chapter":6,"verse":0}}]},"thisChapterLink":"/api/hne_twf/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}