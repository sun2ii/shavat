{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["संगीत निरदेसक बर। तारवाले बाजामन के संग दाऊद के भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे परमेसर, मोर पुकार ला सुन;","poem":1},{"text":"मोर पराथना ला सुन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"धरती के छोर ले मेंह तोला पुकारत हंव,","poem":1},{"text":"तोला पुकारत-पुकारत मोर मन ह दुरबल होवथे;","poem":2},{"lineBreak":true},{"text":"मोला ओ चट्टान ऊपर ले जा, जऊन ह मोर ले ऊंच हे।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"काबरकि तेंह मोर सरन-स्थान ठहिरे हस,","poem":1},{"text":"अऊ बईरीमन के बिरूध एक मजबूत दीवार अस।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"मेंह लालसा करथंव कि तोर डेरा म हमेसा बर रहंव","poem":1},{"text":"अऊ तोर डेनामन के छइहां म सरन लेवंव।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"हे परमेसर, तेंह मोर मन्नतमन ला सुने हस;","poem":1},{"text":"तेंह मोला ओमन के कुल-परंपरा ला दे हस; जऊन मन तोर नांव के भय मानथें।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"राजा के उमर ला बढ़ा,","poem":1},{"text":"पीढ़ी-पीढ़ी तक ओकर उमर ला बढ़ा दे।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"परमेसर के उपस्थिति म ओह हमेसा सिंघासन म बईठय;","poem":1},{"text":"ओकर रकछा म अपन मया अऊ बिसवासयोग्यता ला बनाय रख।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"तब मेंह हमेसा तोर नांव के परसंसा करहूं","poem":1},{"text":"अऊ दिन-प्रतिदिन अपन मन्नतमन ला पूरा करहूं।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hne_twf/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}