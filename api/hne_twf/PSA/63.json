{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"hebrew_subtitle","content":["दाऊद के एक भजन। जब ओह यहूदा के निरजन जगह म रिहिस।"]},{"type":"verse","number":1,"content":[{"text":"हे परमेसर, तेंह मोर परमेसर अस,","poem":1},{"text":"उत्सुक होके मेंह तोला खोजथंव;","poem":2},{"text":"सूखा अऊ झुलसत भुइयां म","poem":1},{"text":"जिहां पानी नइं ए,","poem":2},{"text":"मेंह तोर पीयासा हंव,","poem":1},{"text":"मोर पूरा सरीर तोर संगति के कामना करथे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"मेंह पबितर-स्थान म तोला देखे हवंव","poem":1},{"text":"अऊ तोर सामर्थ अऊ तोर महिमा ला निहारेंव।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"काबरकि तोर मया ह जिनगी ले जादा बने अय,","poem":1},{"text":"मोर मुहूं ह तोर महिमा करही।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"जब तक मेंह जीयत हंव, मेंह तोर परसंसा करहूं,","poem":1},{"text":"अऊ तोर नांव के महिमा म मेंह अपन हांथ उठाहूं।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"मानो बने जेवन ले मेंह पूरा संतुस्ट होहूं,","poem":1},{"text":"अऊ मेंह मोर मुहूं ले गावत तोर परसंसा करहूं।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"अपन दसना म मेंह तोला सुरता करथंव;","poem":1},{"text":"रथिया के बेरा मेंह तोर बारे म सोचथंव।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"काबरकि तेंह मोर मददगार अस,","poem":1},{"text":"मेंह तोर डेना के छइहां म गाथंव।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"मेंह तोर संग लगे रहिथंव;","poem":1},{"text":"तोर जेवनी हांथ ह मोला संभालथे।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"जऊन मन मोला मार डारे चाहथें, ओमन नास हो जाहीं;","poem":1},{"text":"ओमन धरती के गहरई म दब जाहीं।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ओमन तलवार ले मारे जाहीं","poem":1},{"text":"अऊ सियारमन के जेवन बन जाहीं।","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"पर राजा ह परमेसर म आनंद मनाही;","poem":1},{"text":"ओ जम्मो जऊन मन परमेसर के सपथ खाथें, ओमन ओकर महिमा करहीं,","poem":2},{"lineBreak":true},{"text":"जबकि लबरामन के मुहूं ला बंद करे जाही।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hne_twf/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}