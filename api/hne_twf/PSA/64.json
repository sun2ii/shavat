{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":64,"content":[{"type":"hebrew_subtitle","content":["संगीत के निरदेसक बर। दाऊद के एक भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे मोर परमेसर, जब मेंह अपन सिकायत लेके आथंव, त मोर बात ला सुन;","poem":1},{"text":"बईरीमन के धमकी ले मोर जिनगी ला बचा।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"दुस्टमन के सडयंत्र ले, दुस्ट काम करइयामन के","poem":1},{"text":"योजना ले मोला बचा।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ओमन तलवार के सहीं अपन जीभ ला तेज करथें","poem":1},{"text":"अऊ घातक तीर के सहीं करू बचन कहिथें।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ओमन घात लगाके निरदोस ऊपर तीर चलाथें;","poem":1},{"text":"ओमन बिगर डरे, अचानक तीर चलाथें।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ओमन दुस्ट योजना बनाय बर एक-दूसर ला उकसाथें,","poem":1},{"text":"ओमन अपन जाल ला छुपाय के बारे म गोठियाथें;","poem":2},{"lineBreak":true},{"text":"ओमन कहिथें, “कोन ह येला","poem":2},{"noteId":48},{"text":"देखही?”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ओमन अनियाय करे के सडयंत्र रचथें अऊ कहिथें,","poem":1},{"text":"“हमन एकदम सही योजना बनाय हन!”","poem":2},{"lineBreak":true},{"text":"सही म मनखे के मन अऊ हिरदय चालबाज अंय।","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"पर परमेसर ह ओमन ऊपर अपन तीर चलाही;","poem":1},{"text":"ओमन अचानक घात करे जाहीं।","poem":2}]},{"type":"verse","number":8,"content":[{"text":"परमेसर ह ओमन के खुद के जीभ ला ओमन के बिरूध कर दीही","poem":1},{"text":"अऊ ओमन के बिनास कर दीही;","poem":2},{"lineBreak":true},{"text":"जऊन मन ओमन ला देखहीं, ओ जम्मो झन ओमन ला तुछ जानके अपन मुड़ हलाहीं।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"जम्मो मनखेमन डर जाहीं;","poem":1},{"text":"ओमन परमेसर के काम के बखान करहीं","poem":2},{"lineBreak":true},{"text":"अऊ जऊन कुछू ओह करे हवय, ओकर ऊपर बिचार करहीं।","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"धरमी जन ह यहोवा म आनंद मनाही","poem":1},{"text":"अऊ ओकर करा सरन लीही;","poem":2},{"lineBreak":true},{"text":"ओ जम्मो मनखे, जऊन मन हिरदय ले ईमानदार अंय, ओमन ओकर परसंसा करहीं!","poem":2}]}],"footnotes":[{"noteId":48,"caller":"+","text":"या हमन ला","reference":{"chapter":64,"verse":5}}]},"thisChapterLink":"/api/hne_twf/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}