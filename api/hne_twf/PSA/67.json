{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"hebrew_subtitle","content":["संगीत निरदेसक बर। तारवाले बाजा के संग। एक भजन। एक गीत।"]},{"type":"verse","number":1,"content":[{"text":"परमेसर ह हमर ऊपर अनुग्रह करय अऊ हमन ला आसीस देवय","poem":1},{"text":"अऊ अपन मुहूं के अंजोर हमर ऊपर चमकावय—","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ताकि धरती म तोर ईछा,","poem":1},{"text":"अऊ जम्मो जाति म तोर उद्धार के पता चलय।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"हे परमेसर, मनखेमन तोर परसंसा करंय;","poem":1},{"text":"जम्मो मनखेमन तोर परसंसा करंय।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"देस-देस के मनखेमन खुसी मनांय अऊ आनंद के गीत गावंय,","poem":1},{"text":"काबरकि तें मनखेमन ऊपर बिगर पखियपात के सासन करथस","poem":2},{"lineBreak":true},{"text":"अऊ धरती के देस-देस के मनखेमन के अगुवई करथस।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"हे परमेसर, मनखेमन तोर परसंसा करंय;","poem":1},{"text":"जम्मो मनखेमन तोर परसंसा करंय।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"भुइयां ह अपन फसल देथे;","poem":1},{"text":"परमेसर, हमर परमेसर हमन ला आसीस देथे।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"परमेसर हमन ला अऊ आसीस देवय,","poem":1},{"text":"ताकि धरती के जम्मो छोर तक मनखेमन ओकर भय मानंय।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hne_twf/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}