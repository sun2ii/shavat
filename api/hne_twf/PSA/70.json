{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["संगीत के निरदेसक बर। दाऊद के एक बिनती।"]},{"type":"verse","number":1,"content":[{"text":"हे परमेसर, जल्दी करके मोला बचा ले;","poem":1},{"text":"हे यहोवा, मोर मदद करे बर जल्दी आ।","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"जऊन मन मोर परान लेय चाहथें","poem":1},{"text":"ओमन लज्जित होवंय अऊ घबरावंय;","poem":2},{"text":"ओ जम्मो, जऊन मन मोर बिनास के ईछा रखथें","poem":1},{"text":"ओमन कलंकित होके पाछू हटंय।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"जऊन मन मोला ये कहिथें, “अहा! अहा!”","poem":1},{"text":"ओमन लज्जा के मारे वापिस जावंय।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"पर ओ जम्मो, जऊन मन तोर खोज म रहिथें","poem":1},{"text":"ओमन तोर कारन आनंद मनावंय अऊ खुस होवंय;","poem":2},{"text":"जऊन मन तोर उद्धार के मदद चाहथें, ओमन हमेसा कहंय,","poem":1},{"text":"“यहोवा महान ए!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"पर जहां तक मोर बात ए, मेंह गरीब अऊ जरूरतमंद अंव;","poem":1},{"text":"हे परमेसर, मोर करा जल्दी आ।","poem":2},{"text":"तेंह मोर मददगार अऊ मोर छुड़ानेवाला अस;","poem":1},{"text":"हे यहोवा, देरी झन कर।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hne_twf/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}