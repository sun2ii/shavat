{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":8,"content":[{"type":"hebrew_subtitle","content":["संगीत के निरदेसक बर। गित्तीथ",{"noteId":4},"के मुताबिक दाऊद के एक भजन।"]},{"type":"verse","number":1,"content":[{"text":"हे यहोवा, हमर परभू,","poem":1},{"text":"तोर नांव ह जम्मो धरती म का ही परतापी ए!","poem":2},{"lineBreak":true},{"text":"तेंह अपन महिमा","poem":1},{"text":"स्वरग म ठहिराय हस।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"लइका अऊ छोटे लइकामन के दुवारा परसंसा करवाके","poem":1},{"text":"तेंह बईरी अऊ पलटा लेवइयामन ला चुप कराय बर","poem":2},{"lineBreak":true},{"text":"ओमन के बिरूध एक गढ़ बनाय हस।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"जब मेंह अकास ऊपर बिचार करथंव,","poem":1},{"text":"जऊन ह तोर हांथ के काम ए","poem":2},{"text":"चंदा अऊ तारामन,","poem":1},{"text":"जेमन ला तेंह अपन-अपन जगह म रखे हस,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"त मनखे ह का ए कि तेंह ओकर ऊपर धियान देथस,","poem":1},{"text":"मानव-जाति","poem":2},{"noteId":5},{"text":"ह का ए कि तेंह ओकर खियाल रखथस?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"तेंह ओला स्वरगदूतमन","poem":1},{"noteId":6},{"text":"ले थोरकन कम करके बनाय हस","poem":1},{"text":"अऊ ओला महिमा अऊ आदर के मुकुट पहिराय हस।","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तेंह ओला अपन हांथ के काममन के ऊपर राज-करइया बनाय हस;","poem":1},{"text":"तेंह हर एक चीज ला ओकर","poem":2},{"noteId":7},{"text":"गोड़ खाल्हे कर दे हस:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"जम्मो भेड़-बकरी अऊ गाय-बईला,","poem":1},{"text":"अऊ जंगल के पसु,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"अकास के चिरई,","poem":1},{"text":"अऊ समुंदर के मछरी,","poem":2},{"lineBreak":true},{"text":"अऊ ओ जम्मो जीव-जन्तु, जेमन समुंदर के पानी म रहिथें।","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"हे यहोवा हमर परभू,","poem":1},{"text":"तोर नांव ह जम्मो धरती म का ही वैभवसाली अय।","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"संभवतः संगीत के एक सबद","reference":{"chapter":8,"verse":0}},{"noteId":5,"caller":"+","text":"या एक मनखे के बेटा","reference":{"chapter":8,"verse":4}},{"noteId":6,"caller":"+","text":"या परमेसर","reference":{"chapter":8,"verse":5}},{"noteId":7,"caller":"+","text":"या हर चीज ऊपर सासन करइया","reference":{"chapter":8,"verse":6}}]},"thisChapterLink":"/api/hne_twf/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}