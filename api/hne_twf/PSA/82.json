{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["आसाप के एक भजन।"]},{"type":"verse","number":1,"content":[{"text":"परमेसर के सभा म परमेसर ही सभापति होथे;","poem":1},{"text":"ओह “देवतामन” के बीच म नियाय करथे:","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“तुमन कब तक अनियायीमन के बचाव करते रहिहू","poem":1},{"text":"अऊ दुस्टमन के समरथन करत रहिहू?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"दुरबल अऊ अनाथमन के बचाव करव;","poem":1},{"text":"गरीब अऊ दुखीमन के मामला के समरथन करव।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"दुरबल अऊ जरूरतमंद के बचाव करव;","poem":1},{"text":"दुस्टमन के हांथ ले ओमन ला छोंड़ावव।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ ‘देवतामन’ कुछू नइं जानंय, ओमन कुछू नइं समझंय।","poem":1},{"text":"ओमन अंधियार म चलथें-फिरथें;","poem":2},{"lineBreak":true},{"text":"धरती के जम्मो नीवमन हालत हें।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“मेंह कहेंव, ‘तुमन “ईस्वर” अव;","poem":1},{"text":"तुमन जम्मो सर्वोच्च परमेसर के बेटा अव।’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"पर तुमन सिरिप मरनहार मनखे सहीं मरहू;","poem":1},{"text":"तुम्हर गिरई","poem":2},{"noteId":67},{"text":"ह आने सासन करइया सहीं होही।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"हे परमेसर, उठ, धरती के नियाय कर,","poem":1},{"text":"काबरकि जम्मो जाति के मनखेमन तोर भाग एं।","poem":2}]}],"footnotes":[{"noteId":67,"caller":"+","text":"या बिनास","reference":{"chapter":82,"verse":7}}]},"thisChapterLink":"/api/hne_twf/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}