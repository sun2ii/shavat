m":1},{"text":"“येह अऊ ओह ओमा जनमे रिहिन,","poem":2},{"lineBreak":true},{"text":"अऊ सर्वोच्च परमेसर ह खुद ओला स्थापित करही।”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"यहोवा ह मनखेमन के लेखा म लिखही:","poem":1},{"text":"“येह सियोन म जनमे रिहिस।”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"बाजा बजाके ओमन गाहीं,","poem":1},{"text":"“मोर पानी के जम्मो सोतामन तोर म ले निकलथें।”","poem":2}]}],"footnotes":[{"noteId":71,"caller":"+","text":"कविता के भासा म मिसर के नांव","reference":{"chapter":87,"verse":4}},{"noteId":72,"caller":"+","text":"नील के ऊपरी इलाका","reference":{"chapter":87,"verse":4}}]},"thisChapterLink":"/api/hne_twf/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}