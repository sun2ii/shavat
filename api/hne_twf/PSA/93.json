{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"यहोवा ह राज करथे, ओह वैभव के कपड़ा पहिरे हवय;","poem":1},{"text":"यहोवा ह वैभव के कपड़ा पहिरे हवय अऊ ताकत ले भरे हवय;","poem":2},{"lineBreak":true},{"text":"वास्तव म, संसार ला इस्थिर अऊ सुरकछित बनाय गे हवय।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तोर सिंघासन ला अनादिकाल ले स्थापित करे गीस;","poem":1},{"text":"तेंह अनंतकाल ले हस।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"हे यहोवा, समुंदर के पानी उठे हवय,","poem":1},{"text":"समुंदर के अवाज ह उठे हवय,","poem":2},{"lineBreak":true},{"text":"समुंदर के भयंकर लहरामन उठे हवंय।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"पानी के बड़े लहरामन के गरजन ले घलो सक्तिसाली,","poem":1},{"text":"समुंदर के बड़े लहरामन ले घलो सक्तिसाली—","poem":2},{"lineBreak":true},{"text":"ऊंचहा जगह म बिराजमान यहोवा ह सक्तिसाली ए।","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"हे यहोवा, तोर बिधिमन इस्थिर बने रहिथें,","poem":1},{"text":"पबितरता ह तोर घर ला","poem":2},{"lineBreak":true},{"text":"जुग-जुग तक सजाय रहिथे।","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hne_twf/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}