{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"आवव, हमन यहोवा बर आनंद के गीत गावन;","poem":1},{"text":"हमन हमर उद्धार के चट्टान बर जोर से चिचियावन।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"हमन ओकर आघू म धनबाद के संग आवन","poem":1},{"text":"अऊ बाजा बजाके अऊ गीत गाके ओकर बहुंत परसंसा करन।","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"काबरकि यहोवा ह महान परमेसर ए,","poem":1},{"text":"जम्मो देवतामन ऊपर महान राजा ए।","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ओकर हांथ म धरती के गहरई हवय,","poem":1},{"text":"अऊ पहाड़ के चोटीमन ओकर अंय।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"समुंदर ह ओकर अय, काबरकि ओह येला बनाय हवय,","poem":1},{"text":"अऊ ओकर हांथमन सूखा भुइयां ला रचे हवंय।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"आवव, हमन मुड़ नवाके अराधना करन,","poem":1},{"text":"हमन यहोवा हमर सिरजनहार के आघू म माड़ी टेकन;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"काबरकि ओह हमर परमेसर ए","poem":1},{"text":"अऊ हमन ओकर चरागन के मनखे अन,","poem":2},{"lineBreak":true},{"text":"अऊ ओकर देखरेख म रहइया एक झुंड अन।","poem":2},{"lineBreak":true},{"text":"यदि आज तुमन सिरिप ओकर ये अवाज ला सुनत हव,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"“त अपन हिरदय ला कठोर झन करव, जइसे तुम्हर पुरखामन मरीबा","poem":1},{"noteId":82},{"text":"म करे रिहिन,","poem":1},{"text":"जइसे कि तुमन ओ दिन सुन्ना जगह के मस्सा","poem":2},{"noteId":83},{"text":"म करे रहेव,","poem":2},{"noteId":84}]},{"type":"verse","number":9,"content":[{"text":"जिहां ओमन मोला परखिन;","poem":1},{"text":"ओमन मोला जांचिन, हालाकि ओमन मोर काममन ला देखे रिहिन।","poem":2}]},{"type":"verse","number":10,"content":[{"text":"चालीस साल तक मेंह ओ पीढ़ी के मनखेमन ले नराज रहेंव;","poem":1},{"text":"मेंह कहेंव, ‘येमन अइसे मनखे अंय, जेमन के मन ह एती-ओती होथे,","poem":2},{"lineBreak":true},{"text":"अऊ ओमन मोर रसता ला नइं जानंय।’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"एकरसेति मेंह कोरोध म कसम खाके कहेंव,","poem":1},{"text":"‘ओमन ओ ठऊर","poem":2},{"noteId":85},{"text":"म कभू नइं जा सकहीं, जिहां मेंह ओमन ला अराम देवइया रहेंव।’ ”","poem":2}]}],"footnotes":[{"noteId":82,"caller":"+","text":"मरीबा के मतलब होथे झगड़ा","reference":{"chapter":95,"verse":8}},{"noteId":83,"caller":"+","text":"मस्सा के मतलब होथे परखई","reference":{"chapter":95,"verse":8}},{"noteId":84,"caller":"+","text":"देखव निर 17:1‑7; गन 20:1‑13; ब्यव 6:16; 33:8","reference":{"chapter":95,"verse":8}},{"noteId":85,"caller":"+","text":"परतिगियां के देस, कनान देस","reference":{"chapter":95,"verse":11}}]},"thisChapterLink":"/api/hne_twf/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}