{"translation":{"id":"hne_twf","name":"Biblica® सुतंतर समकालीन छत्तीसगढ़ी अनुवाद","website":"https://ebible.org/Scriptures/details.php?id=hne","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hne","licenseNotes":null,"shortName":"TWF","englishName":"Chhattisgarhi Bible","language":"hne","textDirection":"ltr","sha256":"8d8b826b73d5e4ef3c4445f978c725a858bf10eb2f6b5091b2e132e3cd3cf78e","availableFormats":["json"],"listOfBooksApiLink":"/api/hne_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Chhattisgarhi","languageEnglishName":"Chhattisgarhi"},"book":{"id":"PSA","translationId":"hne_twf","name":"भजन-संहिता","commonName":"भजन-संहिता","title":"भजन-संहिता के किताब","order":19,"numberOfChapters":150,"sha256":"e7211636b616d6dc8850718f70c9b20b4d58224a41cf33192d22bc312ae2fd07","firstChapterNumber":1,"firstChapterApiLink":"/api/hne_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hne_twf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"यहोवा ह सासन करथे,","poem":1},{"text":"देस-देस के मनखेमन कांपंय;","poem":2},{"text":"ओह करूबमन के बीच सिंघासन म बिराजमान होथे,","poem":1},{"text":"धरती ह डोलय।","poem":2}]},{"type":"verse","number":2,"content":[{"text":"सियोन म यहोवा ह महान ए;","poem":1},{"text":"ओह जम्मो देसमन के ऊपर उठाय गे हवय।","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ओमन तोर महान अऊ अद्भूत नांव के परसंसा करंय—","poem":1},{"text":"ओह पबितर अय।","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"राजा ह सक्तिसाली हवय, ओह नियाय ले मया करथे—","poem":1},{"text":"तेंह समानता के इस्‍थापना करे हस;","poem":2},{"text":"याकूब","poem":1},{"noteId":86},{"text":"म तेंह ओ करे हस,","poem":1},{"text":"जऊन ह नियाय-संगत अऊ सही अय।","poem":2}]},{"type":"verse","number":5,"content":[{"text":"यहोवा हमर परमेसर के बहुंत परसंसा करव","poem":1},{"text":"अऊ ओकर पांव के चउकी करा अराधना करव;","poem":2},{"lineBreak":true},{"text":"ओह पबितर ए।","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"मूसा अऊ हारून ओकर पुरोहितमन म रिहिन,","poem":1},{"text":"समूएल ह ओमन के बीच म ले रिहिस, जऊन मन ओकर नांव लेवंय;","poem":2},{"text":"ओमन यहोवा ला पुकारंय","poem":1},{"text":"अऊ ओह ओमन ला जबाब देवय।","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ओह ओमन ले बादर के खंभा म ले बात करय;","poem":1},{"text":"ओमन ओकर दिये गय नियम अऊ बिधिमन ला मानंय।","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"यहोवा हमर परमेसर,","poem":1},{"text":"तेंह ओमन ला जबाब देय;","poem":2},{"text":"इसरायल बर तेंह छेमा करइया परमेसर रहय,","poem":1},{"text":"हालाकि तेंह ओमन के गलत काम बर दंड देय।","poem":2}]},{"type":"verse","number":9,"content":[{"text":"परभू हमर परमेसर के बहुंत परसंसा करव","poem":1},{"text":"अऊ ओकर पबितर पहाड़ करा अराधना करव,","poem":2},{"lineBreak":true},{"text":"काबरकि यहोवा हमर परमेसर ह पबितर ए।","poem":2}]}],"footnotes":[{"noteId":86,"caller":"+","text":"या इसरायली समाज","reference":{"chapter":99,"verse":4}}]},"thisChapterLink":"/api/hne_twf/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hne_twf/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hne_twf/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}