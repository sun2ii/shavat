{"translation":{"id":"hrv_bib","name":"Biblica® Open Knjiga O Kristu","website":"https://ebible.org/Scriptures/details.php?id=hrvbib","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hrvbib","licenseNotes":null,"shortName":"BIB","englishName":"Croatian NT (Biblica)","language":"hrv","textDirection":"ltr","sha256":"f0afa0295c5364cb1aa70bfacd8926fdaec61682a896cb344bd45c1e94852727","availableFormats":["json"],"listOfBooksApiLink":"/api/hrv_bib/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7947,"languageName":"hrvatski","languageEnglishName":"Croatian"},"book":{"id":"HEB","translationId":"hrv_bib","name":"Hebrejima","commonName":"Hebrejima","title":"Poslanica Hebrejima","order":58,"numberOfChapters":13,"sha256":"fb9b25e652d639e2380cf60c4db1d68d85019b1c61e902a115b170fb2b79890b","firstChapterNumber":1,"firstChapterApiLink":"/api/hrv_bib/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/hrv_bib/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Isus Krist je Božji Sin"]},{"type":"verse","number":1,"content":["Bog je nekoć više puta i na mnoge načine govorio našim precima kroz proroke."]},{"type":"verse","number":2,"content":["Ali u ove zadnje dane nama je progovorio kroz svojega Sina. Njega, po kojemu je sve stvorio, postavio je za baštinika svega."]},{"type":"verse","number":3,"content":["Sin je odsjaj Božje slave i otisak njegova Bića. On održava svemir snagom svoje silne riječi. Pošto je umro da nas očisti od grijeha, sjeo je na počasno mjesto, zdesna veličanstvenome Bogu u nebu."]},{"type":"heading","content":["Isus je uzvišeniji od anđela"]},{"type":"verse","number":4,"content":["To pokazuje da je Božji Sin mnogo uzvišeniji od anđela, kao što je i ime koje je baštinio uzvišenije od njihovih imena."]},{"type":"verse","number":5,"content":["Jer kome je od anđela ikada rekao:",{"text":"“Ti si moj Sin,","poem":1},{"text":"danas sam ti postao Ocem”","poem":2},{"noteId":0},{"text":",","poem":2},"i još:",{"text":"“Ja ću mu biti Otac,","poem":1},{"text":"a on će meni biti Sin”","poem":2},{"noteId":1},{"text":"?","poem":2}]},{"type":"verse","number":6,"content":["A kada je predstavio svojeg prvorođenca svijetu, Bog je rekao:",{"text":"“Klanjajte mu se, svi anđeli Božji!”","poem":1},{"noteId":2}]},{"type":"verse","number":7,"content":["Za anđele kaže:",{"text":"“On čini svoje anđele vjetrovima","poem":1},{"text":"i sluge poput ognjenih plamenova.”","poem":2},{"noteId":3}]},{"type":"verse","number":8,"content":["Ali za svojega Sina kaže:",{"text":"“Tvoje kraljevstvo, o Bože, traje zauvijek.","poem":1},{"text":"Ti vladaš žezlom pravednosti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ti ljubiš pravednost i mrziš nepravednost.","poem":1},{"text":"Zato te je, Bože, tvoj Bog, pomazao","poem":2},{"text":"uljem radosti više nego ijednoga tvojeg druga.”","poem":1},{"noteId":4}]},{"type":"verse","number":10,"content":["I još:",{"text":"“Gospodine, u početku si postavio temelje zemlji","poem":1},{"text":"i nebesa su djelo tvojih ruku.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Čak će i ona nestati,","poem":1},{"text":"ali ti ostaješ zauvijek.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Smotat ćeš ih poput starog kaputa","poem":1},{"text":"i nestat će kao stara odjeća.","poem":2},{"text":"Ali ti si uvijek isti;","poem":1},{"text":"tvojim godinama nema svršetka.”","poem":2},{"noteId":5}]},{"type":"verse","number":13,"content":["Bog nikada nije nekom anđelu rekao:",{"text":"“Sjedni mi s desne strane","poem":1},{"text":"dok ti ne bacim pod noge tvoje neprijatelje.”","poem":2},{"noteId":6}]},{"type":"verse","number":14,"content":["Jer anđeli su samo poslužnički duhovi koje Bog šalje služiti onima koji će baštiniti spasenje."]}],"footnotes":[{"noteId":0,"caller":"+","text":"Psalam 2:7.","reference":{"chapter":1,"verse":5}},{"noteId":1,"caller":"+","text":"2 Samuelova 7:14.","reference":{"chapter":1,"verse":5}},{"noteId":2,"caller":"+","text":"Ponovljeni zakon 32:43.","reference":{"chapter":1,"verse":6}},{"noteId":3,"caller":"+","text":"Psalam 104:4.","reference":{"chapter":1,"verse":7}},{"noteId":4,"caller":"+","text":"Psalam 45:7-8.","reference":{"chapter":1,"verse":9}},{"noteId":5,"caller":"+","text":"Psalam 102:26-28.","reference":{"chapter":1,"verse":12}},{"noteId":6,"caller":"+","text":"Psalam 110:1.","reference":{"chapter":1,"verse":13}}]},"thisChapterLink":"/api/hrv_bib/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hrv_bib/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hrv_bib/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}