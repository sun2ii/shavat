{"translation":{"id":"hrv_iva","name":"Sveta Biblija","website":"https://ebible.org/Scriptures/details.php?id=hrv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hrv","licenseNotes":null,"shortName":"IVA","englishName":"Croatian Bible","language":"hrv","textDirection":"ltr","sha256":"7fffe0bcaf971a8c24d0bada0d0c2408d18b17257b9666c2c597277fac86f2eb","availableFormats":["json"],"listOfBooksApiLink":"/api/hrv_iva/books.json","numberOfBooks":65,"totalNumberOfChapters":1181,"totalNumberOfVerses":31169,"languageName":"hrvatski","languageEnglishName":"Croatian","numberOfApocryphalBooks":8,"totalNumberOfApocryphalChapters":147,"totalNumberOfApocryphalVerses":4279},"book":{"id":"PSA","translationId":"hrv_iva","name":"Psalmi","commonName":"Psalmi","title":"Psalmi","order":19,"numberOfChapters":150,"sha256":"b7fb7fb2503974942ef8aafddb6a036afc2d9887d8dbe2dfe2fa5347c98a7e54","firstChapterNumber":1,"firstChapterApiLink":"/api/hrv_iva/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hrv_iva/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":["Aleluja! Hvali, dušo moja, Jahvu!"]},{"type":"verse","number":2,"content":["Hvalit ću Jahvu sveg života svojeg. Dok me bude, Bogu svom ću pjevati."]},{"type":"verse","number":3,"content":["Ne uzdajte se u knezove, u čovjeka od kog nema spasenja!"]},{"type":"verse","number":4,"content":["Iziđe li duh iz njega, u zemlju svoju on se vraća i propadaju sve misli njegove."]},{"type":"verse","number":5,"content":["Blago onom kome je pomoćnik Bog Jakovljev, kome je ufanje u Jahvi, Bogu njegovu,"]},{"type":"verse","number":6,"content":["koji stvori nebo i zemlju, more i sve što je u njima; koji ostaje vjeran dovijeka,"]},{"type":"verse","number":7,"content":["potlačenima vraća pravicu, a gladnima kruh daje. Jahve oslobađa sužnje,"]},{"type":"verse","number":8,"content":["Jahve slijepcima oči otvara. Jahve uspravlja prignute, Jahve ljubi pravedne."]},{"type":"verse","number":9,"content":["Jahve štiti tuđince, sirote i udovice podupire, a grešnicima mrsi putove."]},{"type":"verse","number":10,"content":["Jahve će kraljevati dovijeka, tvoj Bog, Sione, od koljena do koljena. Aleluja!"]}],"footnotes":[]},"thisChapterLink":"/api/hrv_iva/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hrv_iva/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hrv_iva/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}