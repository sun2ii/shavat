nt":["Oni posrću i padaju, mi se držimo i stojimo."]},{"type":"verse","number":10,"content":["Jahve, daruj pobjedu kralju, usliši nas u dan kad te zazovemo!"]}],"footnotes":[]},"thisChapterLink":"/api/hrv_iva/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hrv_iva/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hrv_iva/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":10}