: na tvom narodu tvoj je blagoslov!"]}],"footnotes":[]},"thisChapterLink":"/api/hrv_iva/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hrv_iva/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hrv_iva/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":9}