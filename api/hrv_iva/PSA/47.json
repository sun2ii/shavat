:10,"content":["Prvaci se pribiru poganski k narodu Boga Abrahamova. Božji su svi vlastodršci zemlje, nad svima on je uzvišen."]}],"footnotes":[]},"thisChapterLink":"/api/hrv_iva/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hrv_iva/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hrv_iva/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":10}