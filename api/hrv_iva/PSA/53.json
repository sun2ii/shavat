at će Jakov, radovat' se Izrael."]}],"footnotes":[]},"thisChapterLink":"/api/hrv_iva/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hrv_iva/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hrv_iva/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":7}