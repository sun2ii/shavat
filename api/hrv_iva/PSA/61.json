9,"content":["Ovako ću pjevat svagda tvom imenu, dan za danom vršit' zavjete svoje."]}],"footnotes":[]},"thisChapterLink":"/api/hrv_iva/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hrv_iva/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hrv_iva/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":9}