aduju!"]},{"type":"verse","number":9,"content":["Jer Jahve dolazi, dolazi suditi zemlji. Vladat će krugom zemaljskim po pravdi i pucima po pravici."]}],"footnotes":[]},"thisChapterLink":"/api/hrv_iva/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hrv_iva/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hrv_iva/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}