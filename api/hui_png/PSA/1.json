{"translation":{"id":"hui_png","name":"Habo nalolene bi gahenge lo winigo ogo","website":"https://ebible.org/Scriptures/details.php?id=hui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hui","licenseNotes":null,"shortName":"PNG","englishName":"Huli Bible","language":"hui","textDirection":"ltr","sha256":"02c5e9db3581a70a67744f2c067ee92e684a7116861c5dd6e1895b91b5bf8e56","availableFormats":["json"],"listOfBooksApiLink":"/api/hui_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29992,"languageName":"Huli","languageEnglishName":"Huli","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":147,"totalNumberOfApocryphalVerses":4314},"book":{"id":"PSA","translationId":"hui_png","name":"IBA GANA","commonName":"IBA GANA","title":"Iba Gana","order":19,"numberOfChapters":150,"sha256":"557e3ca059125f68ba98d8c0a9d2e5c747ecaba6d3a9d3f8746a76ed4c0cddeb","firstChapterNumber":1,"firstChapterApiLink":"/api/hui_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hui_png/PSA/150.json","totalNumberOfVerses":2448},"chapter":{"number":1,"content":[{"type":"heading","content":["Turu henene holenenaga ogo"]},{"type":"verse","number":1,"content":[{"text":"Mbirali mana ko biaga karume ko bia larago hale halu nabiagabi","poem":1},{"lineBreak":true},{"text":"tigua ko biradagua nabiagabi","poem":1},{"lineBreak":true},{"text":"Ngode Datagaliwabe deni habane nabuleneme mege bialu bedagoria nabiragabi kago","poem":1},{"text":"ibu turu ho ka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ani nabi ibugua Anduane Homogohanda bi ledadagua bulenegoha","poem":1},{"lineBreak":true},{"text":"turu holene ngaria handa walia howa","poem":1},{"text":"mbiraga horombebi daga lalu mitangi biaabo haga ka.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ira iba angeni bu karu anda halu","poem":1},{"text":"lini dolenengi dalu","poem":2},{"lineBreak":true},{"text":"yuniru gau nalagadagua","poem":2},{"text":"ibugua mbirale bigi birago bayale haga bulebira.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ai ko biaga kago ibu ogonibi ndo ka.","poem":1},{"text":"Ibu puyabume abalu hilu yalu piaganego ale ka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ani bidago Ngode Datagaliwabehanda godi larangi","poem":1},{"text":"ko biaga karu tí koore biaga kamigoni lalu","poem":2},{"text":"ibuninaga wali agali karu heba mandagi habe nahedagola","poem":1},{"lineBreak":true},{"text":"ti dabo bagi holebira.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mini tigabiwi karu Anduane Homogohanda ti haru howa mamage haga.","poem":1},{"text":"Ko biaga karume hariga pialu karu homoleneni tagira pole pora.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hui_png/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hui_png/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hui_png/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}