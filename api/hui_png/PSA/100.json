{"translation":{"id":"hui_png","name":"Habo nalolene bi gahenge lo winigo ogo","website":"https://ebible.org/Scriptures/details.php?id=hui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hui","licenseNotes":null,"shortName":"PNG","englishName":"Huli Bible","language":"hui","textDirection":"ltr","sha256":"02c5e9db3581a70a67744f2c067ee92e684a7116861c5dd6e1895b91b5bf8e56","availableFormats":["json"],"listOfBooksApiLink":"/api/hui_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29992,"languageName":"Huli","languageEnglishName":"Huli","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":147,"totalNumberOfApocryphalVerses":4314},"book":{"id":"PSA","translationId":"hui_png","name":"IBA GANA","commonName":"IBA GANA","title":"Iba Gana","order":19,"numberOfChapters":150,"sha256":"557e3ca059125f68ba98d8c0a9d2e5c747ecaba6d3a9d3f8746a76ed4c0cddeb","firstChapterNumber":1,"firstChapterApiLink":"/api/hui_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hui_png/PSA/150.json","totalNumberOfVerses":2448},"chapter":{"number":100,"content":[{"type":"heading","content":["Anduane Homogonaga mini mo yaraga halu iba gana lalu lenego ogo"]},{"type":"verse","number":1,"content":[{"text":"Wali agali dindi bibahendeni paluyu pedamirume","poem":1},{"text":"Anduane Homogohondo turu howa iba gana lo milimu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Turu howa iba gana turubiru lama lama","poem":1},{"text":"ibu mitangi bialu lotu lole ibunaga wanakuini íbu halimu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Anduane Homogo ibu Ngode Datagaliwabeore ka manda bilimu.","poem":1},{"lineBreak":true},{"text":"Ibugua ina wabinigo ina ibunagaore kama.","poem":1},{"lineBreak":true},{"text":"Ibunaga wali agali howa ina ibunaga nogo sibi kamagoni.","poem":1},{"lineBreak":true},{"text":"Anigo ibugua nogo sibi haru hagadagua ina haru haga ka.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ibunaga anda loma bia henegonaga harabani anda ibalu","poem":1},{"text":"ibuhondo ka̱i̱ lalu iba ganaru lama lama anda mali̱ya.","poem":2},{"text":"Ibunaga mini yaraga hama hama anda tamuha anda mali̱ya.","poem":1},{"text":"Ibuhondo ka̱i̱ lalu ibunaga mini mo yaraga hami̱ya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Anduane Homogo ibu bayaore gibi kago ibunaga gubalini holene ngagome","poem":1},{"text":"ina gubalini haho wiaabo kagoni.","poem":2},{"text":"Ibugua ibunaga wali agaliruhondo,","poem":1},{"lineBreak":true},{"text":"Bulebero, lowiniru mbira mo habo nale","poem":1},{"text":"ibu mini bilinahe howa biaiore haga kago","poem":2},{"lineBreak":true},{"text":"ibunaga mini yaraga hami̱ya.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hui_png/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hui_png/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hui_png/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}