{"translation":{"id":"hui_png","name":"Habo nalolene bi gahenge lo winigo ogo","website":"https://ebible.org/Scriptures/details.php?id=hui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hui","licenseNotes":null,"shortName":"PNG","englishName":"Huli Bible","language":"hui","textDirection":"ltr","sha256":"02c5e9db3581a70a67744f2c067ee92e684a7116861c5dd6e1895b91b5bf8e56","availableFormats":["json"],"listOfBooksApiLink":"/api/hui_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29992,"languageName":"Huli","languageEnglishName":"Huli","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":147,"totalNumberOfApocryphalVerses":4314},"book":{"id":"PSA","translationId":"hui_png","name":"IBA GANA","commonName":"IBA GANA","title":"Iba Gana","order":19,"numberOfChapters":150,"sha256":"557e3ca059125f68ba98d8c0a9d2e5c747ecaba6d3a9d3f8746a76ed4c0cddeb","firstChapterNumber":1,"firstChapterApiLink":"/api/hui_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hui_png/PSA/150.json","totalNumberOfVerses":2448},"chapter":{"number":120,"content":[{"type":"heading","content":["Anduane Homogohondo, Biamogo bia, lalu bi lenego ogo"]},{"type":"verse","number":1,"content":[{"text":"I̱ha genda timbuni anda ibiyangi i̱na Anduane Homogo olarugola","poem":1},{"text":"ibugua i̱ biamogo biya.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"I̱na Anduane Homogohondo bi lalu,","poem":1},{"lineBreak":true},{"text":"Anduane Homogo-o agali ke̱ haga karume","poem":1},{"text":"i̱ mo hondo holigo i̱ biamogo bibe, larugoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ke̱ haga bu kamiru tíhondo Anduane Homogohanda agua bulubadabe.","poem":1},{"text":"Tí pani nalimulo aguaore ngulubadabe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ibugua tí aminaga yandarerume nogoba halu","poem":1},{"text":"ira hedope halu tí delolebira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"I̱ tí dege dombeneha kogoni Mesege dindibi Keda dindibi","poem":1},{"text":"wali agali ko biaga karu baba haradagua bidogoni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Agali maru wali agali bu karu baba mandagi habe manga haga karu","poem":1},{"text":"i̱ ti heba mandagi luore haabo haruda.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I̱na mo palia holenenaga bi lalu koria","poem":1},{"text":"tigua wai bule dege manda biaga kagoni ndobe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hui_png/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hui_png/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hui_png/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}