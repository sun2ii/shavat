4,"content":[{"text":"Anduane Homogo-o wali agali bayale í̠naga mana ngeru taluwa bialu haga karu","poem":1},{"text":"tihondo í̠na mana bayale biadai bibe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Í̠na wali agali ko biaga karunaga pani nelo mialu howa","poem":1},{"text":"wali agali maru í̠naga mana ngeru mo wahalu piaga karubi","poem":2},{"lineBreak":true},{"text":"ti bibahende pani nelo miai habe laro.","poem":2},{"lineBreak":true},{"text":"Isaraele wali agaliru tiha mo palia holene wia helo hameledo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/hui_png/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hui_png/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hui_png/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}