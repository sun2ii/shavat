{"translation":{"id":"hui_png","name":"Habo nalolene bi gahenge lo winigo ogo","website":"https://ebible.org/Scriptures/details.php?id=hui","licenseUrl":"https://ebible.org/Scriptures/details.php?id=hui","licenseNotes":null,"shortName":"PNG","englishName":"Huli Bible","language":"hui","textDirection":"ltr","sha256":"02c5e9db3581a70a67744f2c067ee92e684a7116861c5dd6e1895b91b5bf8e56","availableFormats":["json"],"listOfBooksApiLink":"/api/hui_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29992,"languageName":"Huli","languageEnglishName":"Huli","numberOfApocryphalBooks":12,"totalNumberOfApocryphalChapters":147,"totalNumberOfApocryphalVerses":4314},"book":{"id":"PSA","translationId":"hui_png","name":"IBA GANA","commonName":"IBA GANA","title":"Iba Gana","order":19,"numberOfChapters":150,"sha256":"557e3ca059125f68ba98d8c0a9d2e5c747ecaba6d3a9d3f8746a76ed4c0cddeb","firstChapterNumber":1,"firstChapterApiLink":"/api/hui_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/hui_png/PSA/150.json","totalNumberOfVerses":2448},"chapter":{"number":13,"content":[{"type":"heading","content":["Anduane Homogohanda biamogo bilo bi lenego ogo"]},{"type":"verse","number":1,"content":[{"text":"Anduane Homogo-o í̠na i̱ angi mitangi bule kebe.","poem":1},{"lineBreak":true},{"text":"Í̠na i̱ embeda halu yu waore haribe.","poem":1},{"lineBreak":true},{"text":"Í̠naga dengui lone hondoliya","poem":1},{"text":"i̱hondo angi mo walia holeberebe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"I̱ genda yu kogonigo angi mo waholeberebe.","poem":1},{"lineBreak":true},{"text":"I̱ miniha tandaga ngelo koruni","poem":1},{"text":"horombe mbiragabi agiru hondo holeberebe.","poem":2},{"text":"I̱ waitigi karunaga andaneha naholiya","poem":1},{"text":"í̠na i̱ angi biamogo buleberebe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Anduane Homogo i̱naga Ngode Datagaliwabeore-o","poem":1},{"text":"Í̠na i̱ mitangi halu i̱naga bi larogo hale habe.","poem":2},{"text":"I̱ nahomoliya i̱naga de mo ngalalu lone mo hongo habe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I̱ homaruyagua i̱naga waitigime lalu,","poem":1},{"text":"Iname ibu bope harimadagoni, loligo nalelo.","poem":2},{"text":"Tigua i̱ pilarogo hondowa turu holigo nahelo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ani lolebiragoyu í̠na i̱ gubalini holebeda lo manda bialu","poem":1},{"text":"mini mbiraore wu kogoni.","poem":2},{"text":"Í̠na i̱ pele ngiaabo holeberegonaga","poem":1},{"text":"i̱ turu timbuniore ho kogoni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Anduane Homogo í̠na i̱hondo bayale dege biaabo harigonaga","poem":1},{"text":"i̱na í̠naga mini yaraga halu","poem":2},{"lineBreak":true},{"text":"iba gana laga bialu holebero.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/hui_png/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/hui_png/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/hui_png/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}