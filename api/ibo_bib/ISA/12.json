{"translation":{"id":"ibo_bib","name":"Biblica® Baịbụlụ Nsọ nʼIgbo Ndị Ugbu a nke dịrị onye ọbụla ịgụ","website":"https://ebible.org/Scriptures/details.php?id=ibo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ibo","licenseNotes":null,"shortName":"BIB","englishName":"Igbo Bible","language":"ibo","textDirection":"ltr","sha256":"b6b5fe3fa9caaf5651688213656dd8962b5112d5576337256e3ed027863a970b","availableFormats":["json"],"listOfBooksApiLink":"/api/ibo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Igbo","languageEnglishName":"Igbo"},"book":{"id":"ISA","translationId":"ibo_bib","name":"Aịzaya","commonName":"Aịzaya","title":"Aịzaya","order":23,"numberOfChapters":66,"sha256":"4b0b2e82a340570bf99c3d1faab49b58ec359638fcf45da6e63932443e3039c4","firstChapterNumber":1,"firstChapterApiLink":"/api/ibo_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ibo_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["Abụ Otuto"]},{"type":"verse","number":1,"content":["Nʼụbọchị ahụ, ị ga-ekwu sị,",{"text":"“Aga m eto gị Onyenwe anyị.","poem":1},{"text":"Ọ bụ ezie na ị wesara m iwe,","poem":2},{"text":"ma ugbu a, iwe gị adajụọla;","poem":1},{"text":"ị kasịkwara m obi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nʼezie, Chineke bụ onye nzọpụta m;","poem":1},{"text":"aga m atụkwasị ya obi, ụjọ agaghị atụkwa m.","poem":2},{"text":"Onyenwe anyị, Onyenwe anyị ya onwe ya, bụ ike m bụrụkwa abụ m,","poem":1},{"text":"ọ ghọrọla m onye nzọpụta.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ị ga-eji ọṅụ dọrọ mmiri","poem":1},{"text":"site nʼolulu mmiri nke nzọpụta.","poem":2}]},{"type":"verse","number":4,"content":["Nʼụbọchị ahụ, ị ga-ekwukwa sị,",{"text":"“Nyenụ Onyenwe anyị otuto, Kwupụtakwa aha ya","poem":1},{"noteId":33},{"text":";","poem":1},{"text":"meenụ ka amata nʼetiti mba niile ihe niile ọ rụrụ","poem":2},{"noteId":34},{"text":";","poem":2},{"lineBreak":true},{"text":"kwusaanụ na aha ya bu ihe e buliri elu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bụkuonụ Onyenwe anyị abụ, nʼihi na o meela oke ihe dị ebube.","poem":1},{"text":"Meekwanụ ka ụwa niile mara ihe ọ rụrụ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ka ndị niile bi na Zayọn tie mkpu ọṅụ,","poem":1},{"noteId":35},{"text":"bụkwaa abụ.","poem":1},{"text":"Nʼihi na Onye nsọ nke Izrel.","poem":2},{"noteId":36},{"text":"dị ukwuu, e, ọ dị ike nke ukwuu, bụ Onye ahụ na-ebi nʼetiti unu.”","poem":2},{"noteId":37}]}],"footnotes":[{"noteId":33,"caller":"+","text":"1Ih 16:8; Abụ 105:1","reference":{"chapter":12,"verse":4}},{"noteId":34,"caller":"+","text":"Abụ 145:4-6.","reference":{"chapter":12,"verse":4}},{"noteId":35,"caller":"+","text":"Zef 3:14,15","reference":{"chapter":12,"verse":6}},{"noteId":36,"caller":"+","text":"Abụ 89:18","reference":{"chapter":12,"verse":6}},{"noteId":37,"caller":"+","text":"Zef 3:17","reference":{"chapter":12,"verse":6}}]},"thisChapterLink":"/api/ibo_bib/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ibo_bib/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ibo_bib/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}