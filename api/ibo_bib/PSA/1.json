{"translation":{"id":"ibo_bib","name":"Biblica® Baịbụlụ Nsọ nʼIgbo Ndị Ugbu a nke dịrị onye ọbụla ịgụ","website":"https://ebible.org/Scriptures/details.php?id=ibo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ibo","licenseNotes":null,"shortName":"BIB","englishName":"Igbo Bible","language":"ibo","textDirection":"ltr","sha256":"b6b5fe3fa9caaf5651688213656dd8962b5112d5576337256e3ed027863a970b","availableFormats":["json"],"listOfBooksApiLink":"/api/ibo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Igbo","languageEnglishName":"Igbo"},"book":{"id":"PSA","translationId":"ibo_bib","name":"Abụ Ọma","commonName":"Abụ Ọma","title":"Abụ Ọma","order":19,"numberOfChapters":150,"sha256":"f70313af57c66aaa01e3389aa3863535b2678ec4423abeb13f4c7807609b7441","firstChapterNumber":1,"firstChapterApiLink":"/api/ibo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ibo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"heading","content":["Onye ihe na-agara nke ọma"]},{"type":"verse","number":1,"content":[{"text":"Onye ihe na-agara nke ọma ka mmadụ ahụ bụ,","poem":1},{"text":"onye na-adịghị aga ije na ndụmọdụ ndị na-emebi iwu;","poem":2},{"text":"onye na-adịghị eguzokwa nʼụzọ ndị mmehie","poem":1},{"text":"maọbụ soro nʼotu ndị nkwutọ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kama ihe na-atọ ya ụtọ bụ ime ihe niile dị nʼiwu Onyenwe anyị.","poem":1},{"text":"Ọ na-atụgharịkwa uche ya nʼiwu Onyenwe anyị ehihie na abalị,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ọ dị ka osisi a kụrụ nʼakụkụ iyi,","poem":1},{"text":"nke na-amịpụta mkpụrụ ya nʼoge ya,","poem":2},{"text":"nke ahịhịa ya na-adịghị akpọnwụ akpọnwụ.","poem":1},{"text":"Ihe niile ọ na-eme na-agara ya nke ọma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ma ndị ajọ omume adịghị otu a.","poem":1},{"text":"Ha dị ka igbugbo ọka","poem":2},{"lineBreak":true},{"text":"nke oke ifufe na-efesasị.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ya mere, ndị ajọ omume agaghị eguzosi ike nʼụbọchị ikpe;","poem":1},{"text":"ndị mmehie agaghị eguzokwa na nzukọ ndị ezi omume.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nʼihi na Onyenwe anyị na-eche ụzọ ndị ezi omume nche.","poem":1},{"text":"Ma ụzọ ndị ajọ omume ga-eduba ha nʼịla nʼiyi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ibo_bib/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ibo_bib/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ibo_bib/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}