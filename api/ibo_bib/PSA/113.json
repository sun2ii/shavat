","poem":1},{"text":"eluigwe na ụwa anya?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ọ na-esi nʼuzuzu bulie ogbenye elu","poem":1},{"text":"sitekwa nʼebe ikpofu ahịhịa bulie onye nọ na mkpa elu;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ọ na-eme ka ya na ụmụ eze ndị ikom nọkọọ,","poem":1},{"text":"ọ na-eme ka o soro ndị a maara aha ha nʼetiti ụmụ mmadụ nọkọọ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ọ na-eme ka nwanyị aga biri nʼụlọ nke ya","poem":1},{"text":"dịka nne mụrụ ọtụtụ ụmụ ọṅụ juru obi.","poem":2},{"lineBreak":true},{"text":"Toonu Onyenwe anyị.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ibo_bib/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ibo_bib/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ibo_bib/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}