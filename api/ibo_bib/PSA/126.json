{"translation":{"id":"ibo_bib","name":"Biblica® Baịbụlụ Nsọ nʼIgbo Ndị Ugbu a nke dịrị onye ọbụla ịgụ","website":"https://ebible.org/Scriptures/details.php?id=ibo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ibo","licenseNotes":null,"shortName":"BIB","englishName":"Igbo Bible","language":"ibo","textDirection":"ltr","sha256":"b6b5fe3fa9caaf5651688213656dd8962b5112d5576337256e3ed027863a970b","availableFormats":["json"],"listOfBooksApiLink":"/api/ibo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Igbo","languageEnglishName":"Igbo"},"book":{"id":"PSA","translationId":"ibo_bib","name":"Abụ Ọma","commonName":"Abụ Ọma","title":"Abụ Ọma","order":19,"numberOfChapters":150,"sha256":"f70313af57c66aaa01e3389aa3863535b2678ec4423abeb13f4c7807609b7441","firstChapterNumber":1,"firstChapterApiLink":"/api/ibo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ibo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"hebrew_subtitle","content":["Abụ nrigo."]},{"type":"heading","content":["Abụ ekele maka mgbapụta"]},{"type":"verse","number":1,"content":[{"text":"Mgbe Onyenwe anyị kpọghachitere ndị e mere ka ha lọta na Zayọn,","poem":1},{"noteId":121},{"text":"anyị dị ka ndị na-arọ nrọ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ọchị juru anyị ọnụ,","poem":1},{"text":"abụ ọṅụ jukwara anyị ire.","poem":2},{"text":"Mgbe ahụ, e kwukwara ya na mba niile sị,","poem":1},{"text":"“Onyenwe anyị emeerela ha ọtụtụ ihe dị ukwuu.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Onyenwe anyị emeerala anyị ọtụtụ ihe dị ukwuu,","poem":1},{"text":"obi anyị jupụtakwara nʼọṅụ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nyeghachi anyị akụnụba anyị, o Onyenwe anyị,","poem":1},{"text":"dịka mmiri iyi na-asọ nʼala Negev.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndị niile na-eji anya mmiri na-arụ ọrụ ịkụ mkpụrụ","poem":1},{"text":"ga-emesịa jiri abụ ọṅụ wee ihe ubi ahụ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Onye ji ịkwa akwa","poem":1},{"text":"buru mkpụrụ ubi ọ ga-agha na-aga,","poem":2},{"text":"ga-emesịa jiri abụ ọṅụ na-alọghachi azụ,","poem":1},{"text":"mgbe ha bu ukwu ọka ha.","poem":2}]}],"footnotes":[{"noteId":121,"caller":"+","text":"Jer 29:14; Jul 3:1","reference":{"chapter":126,"verse":1}}]},"thisChapterLink":"/api/ibo_bib/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ibo_bib/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ibo_bib/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}