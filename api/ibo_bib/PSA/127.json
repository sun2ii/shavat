{"translation":{"id":"ibo_bib","name":"Biblica® Baịbụlụ Nsọ nʼIgbo Ndị Ugbu a nke dịrị onye ọbụla ịgụ","website":"https://ebible.org/Scriptures/details.php?id=ibo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ibo","licenseNotes":null,"shortName":"BIB","englishName":"Igbo Bible","language":"ibo","textDirection":"ltr","sha256":"b6b5fe3fa9caaf5651688213656dd8962b5112d5576337256e3ed027863a970b","availableFormats":["json"],"listOfBooksApiLink":"/api/ibo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Igbo","languageEnglishName":"Igbo"},"book":{"id":"PSA","translationId":"ibo_bib","name":"Abụ Ọma","commonName":"Abụ Ọma","title":"Abụ Ọma","order":19,"numberOfChapters":150,"sha256":"f70313af57c66aaa01e3389aa3863535b2678ec4423abeb13f4c7807609b7441","firstChapterNumber":1,"firstChapterApiLink":"/api/ibo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ibo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"hebrew_subtitle","content":["Abụ nrigo, nke Solomọn."]},{"type":"heading","content":["Chineke dị mkpa"]},{"type":"verse","number":1,"content":[{"text":"Ọ bụrụ na Onyenwe anyị ewughị ụlọ,","poem":1},{"text":"ndị na-ewu ya na-adọgbu onwe ha nʼọrụ nʼefu.","poem":2},{"text":"Ọ bụrụ na Onyenwe anyị echeghị obodo,","poem":1},{"text":"nʼefu ka ndị nche na-amụ anya.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ọ bụ nʼefu ka ị na-ebili nʼisi ụtụtụ","poem":1},{"text":"na-adọgbu onwe gị nʼọrụ","poem":2},{"text":"ịchọta ihe ị ga-eri ruo nʼabalị,","poem":1},{"text":"nʼihi na ọ na-eme ka ndị niile ọ hụrụ nʼanya hie ụra nʼudo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ụmụntakịrị bụ ihe nketa si nʼaka Onyenwe anyị,","poem":1},{"text":"ụmụntakịrị bụ ụgwọ ọrụ ọ na-enye.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dịka àkụ nʼaka dike nʼagha,","poem":1},{"text":"otu a, ka ụmụ a mụtaara na mgbe okorobịa dị.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Onye a gọziri agọzi ka nwoke ahụ bụ","poem":1},{"text":"onye kpojuru àkụ ndị a nʼakpa àkụ ya.","poem":2},{"text":"Ihere agaghị eme ha mgbe ha na ndị iro","poem":1},{"text":"na-arụrịta ụka nʼama.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ibo_bib/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ibo_bib/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ibo_bib/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}