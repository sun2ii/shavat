{"translation":{"id":"ibo_bib","name":"Biblica® Baịbụlụ Nsọ nʼIgbo Ndị Ugbu a nke dịrị onye ọbụla ịgụ","website":"https://ebible.org/Scriptures/details.php?id=ibo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ibo","licenseNotes":null,"shortName":"BIB","englishName":"Igbo Bible","language":"ibo","textDirection":"ltr","sha256":"b6b5fe3fa9caaf5651688213656dd8962b5112d5576337256e3ed027863a970b","availableFormats":["json"],"listOfBooksApiLink":"/api/ibo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Igbo","languageEnglishName":"Igbo"},"book":{"id":"PSA","translationId":"ibo_bib","name":"Abụ Ọma","commonName":"Abụ Ọma","title":"Abụ Ọma","order":19,"numberOfChapters":150,"sha256":"f70313af57c66aaa01e3389aa3863535b2678ec4423abeb13f4c7807609b7441","firstChapterNumber":1,"firstChapterApiLink":"/api/ibo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ibo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["Abụ nrigo."]},{"type":"heading","content":["Mkpụrụobi na-ele anya Chineke"]},{"type":"verse","number":1,"content":[{"text":"O Onyenwe anyị, ọ bụ site nʼebe dị omimi ka m na-ebeku gị akwa.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Onyenwe anyị, nụrụ olu m.","poem":2},{"text":"Ka ntị gị na-aṅakwa ntị","poem":1},{"text":"nʼolu arịrịọ m, maka amara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"O Onyenwe anyị, a sị na i detuo mmehie niile,","poem":1},{"text":"Onyenwe anyị, onye pụrụ iguzo?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ma ọ bụ nʼaka gị ka mgbaghara mmehie","poem":1},{"noteId":125},{"text":"dị;","poem":1},{"text":"ime ka anyị tụọ gị egwu, ma jeere gị ozi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ana m echere Onyenwe anyị, mkpụrụobi m na-echekwa ya,","poem":1},{"text":"ọ bụ nʼokwu ya ka olileanya m dị.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mkpụrụobi m na-echere Onyenwe anyị","poem":1},{"text":"karịa ndị nche abalị na-echere chị ọbụbọ,","poem":2},{"lineBreak":true},{"text":"e, karịa ndị nche abalị na-echere chị ọbụbọ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ndị Izrel, ka olileanya unu dịrị na Onyenwe anyị,","poem":1},{"text":"nʼihi na ịhụnanya ya na-adịgide adịgide,","poem":2},{"lineBreak":true},{"text":"nʼaka ya ka nzọpụta zuruoke dịkwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ya onwe ya, ga-agbapụta Izrel","poem":1},{"text":"site na mmehie ya niile.","poem":2}]}],"footnotes":[{"noteId":125,"caller":"+","text":"Ọpụ 34:7; Neh 9:17; Dan 9:9","reference":{"chapter":130,"verse":4}}]},"thisChapterLink":"/api/ibo_bib/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ibo_bib/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ibo_bib/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}