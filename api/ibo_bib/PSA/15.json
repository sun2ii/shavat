{"translation":{"id":"ibo_bib","name":"Biblica® Baịbụlụ Nsọ nʼIgbo Ndị Ugbu a nke dịrị onye ọbụla ịgụ","website":"https://ebible.org/Scriptures/details.php?id=ibo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ibo","licenseNotes":null,"shortName":"BIB","englishName":"Igbo Bible","language":"ibo","textDirection":"ltr","sha256":"b6b5fe3fa9caaf5651688213656dd8962b5112d5576337256e3ed027863a970b","availableFormats":["json"],"listOfBooksApiLink":"/api/ibo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Igbo","languageEnglishName":"Igbo"},"book":{"id":"PSA","translationId":"ibo_bib","name":"Abụ Ọma","commonName":"Abụ Ọma","title":"Abụ Ọma","order":19,"numberOfChapters":150,"sha256":"f70313af57c66aaa01e3389aa3863535b2678ec4423abeb13f4c7807609b7441","firstChapterNumber":1,"firstChapterApiLink":"/api/ibo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ibo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":15,"content":[{"type":"hebrew_subtitle","content":["Abụ Ọma Devid."]},{"type":"heading","content":["Onye ga-ebi nʼugwu nsọ Onyenwe anyị?"]},{"type":"verse","number":1,"content":[{"text":"Onyenwe anyị, onye pụrụ ịnọgide nʼụlọnsọ ukwu gị?","poem":1},{"text":"Onye pụrụ ibi nʼugwu nsọ gị?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Onye na-ebi ndụ nke na-enweghị ịta ụta,","poem":1},{"text":"onye na-arụ ọrụ ezi omume,","poem":2},{"lineBreak":true},{"text":"onye na-ekwu eziokwu site nʼobi ya.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Onye jụrụ ikwutọsị ndị ọzọ,","poem":1},{"text":"onye na-adịghị eme onye agbataobi ya ihe ọjọọ,","poem":2},{"lineBreak":true},{"text":"na onye na-adịghị ekwulu mmadụ ibe ya,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"onye na-eleda onye ajọ omume anya,","poem":1},{"text":"ma na-asọpụrụ ndị ahụ na-atụ egwu Onyenwe anyị,","poem":2},{"text":"onye na-adịghị agbanwe nkwa ọbụla o kwere,","poem":1},{"text":"ọ bụladị mgbe nkwa ahụ na-emegide ya,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"onye na-agbazinye mmadụ ego na-anaghị ụma,","poem":1},{"text":"onye na-adịghị a nara ngarị imegide onye aka ya dị ọcha.","poem":2},{"lineBreak":true},{"text":"Onye na-eme ihe ndị a","poem":1},{"text":"agaghị ama jijiji nʼọnọdụ ya, mgbe ọbụla.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ibo_bib/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ibo_bib/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ibo_bib/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}