ke;","poem":1},{"text":"ka mmadụ niile too gị.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mgbe ahụ, ala ga-amịpụta ihe owuwe ubi ya,","poem":1},{"text":"Chineke, onye bụ Chineke anyị, ga-agọzikwa anyị.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Chineke ga-agọzi anyị,","poem":1},{"text":"nsọtụ niile nke ụwa ga-atụ egwu ya.","poem":2}]}],"footnotes":[{"noteId":64,"caller":"+","text":"Ọnụ 6:25","reference":{"chapter":67,"verse":1}}]},"thisChapterLink":"/api/ibo_bib/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ibo_bib/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ibo_bib/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}