{"translation":{"id":"ibo_bib","name":"Biblica® Baịbụlụ Nsọ nʼIgbo Ndị Ugbu a nke dịrị onye ọbụla ịgụ","website":"https://ebible.org/Scriptures/details.php?id=ibo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ibo","licenseNotes":null,"shortName":"BIB","englishName":"Igbo Bible","language":"ibo","textDirection":"ltr","sha256":"b6b5fe3fa9caaf5651688213656dd8962b5112d5576337256e3ed027863a970b","availableFormats":["json"],"listOfBooksApiLink":"/api/ibo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Igbo","languageEnglishName":"Igbo"},"book":{"id":"PSA","translationId":"ibo_bib","name":"Abụ Ọma","commonName":"Abụ Ọma","title":"Abụ Ọma","order":19,"numberOfChapters":150,"sha256":"f70313af57c66aaa01e3389aa3863535b2678ec4423abeb13f4c7807609b7441","firstChapterNumber":1,"firstChapterApiLink":"/api/ibo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ibo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["Abụ Ọma dịrị onyeisi abụ. Nke Devid. Arịrịọ."]},{"type":"heading","content":["Ekpere maka nnapụta"]},{"type":"verse","number":1,"content":[{"text":"O Chineke, gbata ọsọ bịa zọpụta m,","poem":1},{"text":"O Onyenwe anyị, bịa ngwangwa inyere m aka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ka ndị niile na-achọ ịnapụ m ndụ m,","poem":1},{"text":"bụrụ ndị a ga-etinye nʼọnọdụ ihere na ọgbaaghara.","poem":2},{"text":"Ka ndị ọ na-amasị ịhụ ịla nʼiyi m","poem":1},{"text":"laghachi azụ nʼihere.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ka ndị ahụ na-asị m, “Ehee! Ehee!”","poem":1},{"text":"laghachi azụ nʼihi ihere ha.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ma ka ndị niile na-achọ gị","poem":1},{"text":"ṅụrịa ọṅụ, nweekwa obi ụtọ nʼime gị,","poem":2},{"text":"ka ndị ahụ hụrụ nzọpụta gị nʼanya na-ekwu mgbe niile,","poem":1},{"text":"“Onyenwe anyị dị ukwuu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ma mụ onwe m bụ ogbenye na onye nọ na mkpa;","poem":1},{"text":"O Chineke, mee ngwangwa bịakwute m.","poem":2},{"text":"Ị bụ onye inyeaka m na onye mgbapụta m;","poem":1},{"text":"O Onyenwe anyị, anọla ọdụ ịbịa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ibo_bib/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ibo_bib/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ibo_bib/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}