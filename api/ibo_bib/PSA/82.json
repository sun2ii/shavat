{"translation":{"id":"ibo_bib","name":"Biblica® Baịbụlụ Nsọ nʼIgbo Ndị Ugbu a nke dịrị onye ọbụla ịgụ","website":"https://ebible.org/Scriptures/details.php?id=ibo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ibo","licenseNotes":null,"shortName":"BIB","englishName":"Igbo Bible","language":"ibo","textDirection":"ltr","sha256":"b6b5fe3fa9caaf5651688213656dd8962b5112d5576337256e3ed027863a970b","availableFormats":["json"],"listOfBooksApiLink":"/api/ibo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Igbo","languageEnglishName":"Igbo"},"book":{"id":"PSA","translationId":"ibo_bib","name":"Abụ Ọma","commonName":"Abụ Ọma","title":"Abụ Ọma","order":19,"numberOfChapters":150,"sha256":"f70313af57c66aaa01e3389aa3863535b2678ec4423abeb13f4c7807609b7441","firstChapterNumber":1,"firstChapterApiLink":"/api/ibo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ibo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["Abụ Ọma Asaf."]},{"type":"heading","content":["Chineke onye ikpe kachasị ndị ikpe"]},{"type":"verse","number":1,"content":[{"text":"Chineke na-ewere ọnọdụ ịchị isi nʼetiti ọgbakọ dị ukwuu;","poem":1},{"text":"ọ na-ekpebi ikpe nʼetiti chi niile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ruo ole mgbe ka unu ga-anọgide na-ekpe ikpe na-ezighị ezi?","poem":1},{"text":"Ruo ole mgbe ka unu ga na-egosi ndị ajọ omume ihuọma? Sela","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kperenụ ndị na-adịghị ike na ndị na-enweghị nna ikpe ziri ezi;","poem":1},{"text":"hụnụ na ndị ogbenye na ndị a na-emegbu nwetara ihe ruuru ha.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gbapụtanụ ndị na-adịghị ike na ndị nọ na mkpa;","poem":1},{"text":"napụta ha site nʼaka ndị ajọ omume.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ha","poem":1},{"noteId":86},{"text":"amaghị ihe ọbụla, ha aghọtaghị ihe ọbụla.","poem":1},{"text":"Ha na-ejegharị nʼọchịchịrị;","poem":2},{"lineBreak":true},{"text":"ntọala niile nke ụwa na-ama jijiji.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Asịrị m, ‘Unu bụ “chi,”","poem":1},{"text":"unu niile bụ ụmụ ndị ikom nke Onye kachasị ihe niile elu.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ma unu ga-anwụ ọnwụ dịka mmadụ ndị ọzọ;","poem":1},{"text":"unu ga-ada dịka ndị ọchịchị ọzọ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"O Chineke, bilie kpee ụwa ikpe,","poem":1},{"text":"nʼihi na mba niile bụ ihe nketa gị.","poem":2}]}],"footnotes":[{"noteId":86,"caller":"+","text":"Maọbụ, chi ndị a","reference":{"chapter":82,"verse":5}}]},"thisChapterLink":"/api/ibo_bib/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ibo_bib/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ibo_bib/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}