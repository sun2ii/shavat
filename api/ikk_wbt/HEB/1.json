{"translation":{"id":"ikk_wbt","name":"Elu Ọhụn: Ẹkụkwọ-Nsọ (Azụụn Ọhụn rịn'a)","website":"https://ebible.org/Scriptures/details.php?id=ikkNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ikkNT","licenseNotes":null,"shortName":"WBT","englishName":"Ika NT","language":"ikk","textDirection":"ltr","sha256":"5f5a77b3b58677ed924bdcbd749823d4febb963c40f0a76f65647a3f866ae53d","availableFormats":["json"],"listOfBooksApiLink":"/api/ikk_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7958,"languageName":"Ika","languageEnglishName":"Ika"},"book":{"id":"HEB","translationId":"ikk_wbt","name":"Ndị Hibru","commonName":"Ndị Hibru","title":"Ẹhụhụọ-Ozi Wẹ Dejẹnni Ndị Hibru","order":58,"numberOfChapters":13,"sha256":"8d0b90bc5a3c75eda25b915a14f1764941916c16e51f6d442d6507393a1eda0d","firstChapterNumber":1,"firstChapterApiLink":"/api/ikk_wbt/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/ikk_wbt/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Osolobuẹ E Kugụọ Nwan Oku Ghahanị Nwa a"]},{"type":"verse","number":1,"content":["Ogẹn mbụ, Osolobuẹ gi ụzọ rị ichẹn-ichẹn gwasọnmẹ ndị nẹdi ẹnyi wẹ oku ghahanị ndị-amụma."]},{"type":"verse","number":2,"content":["Kanị, ogẹn ịkpazụụnnị, ọ gwaọlẹ ẹnyi oku ghahanị Nwa a. Ịya kẹ Osolobuẹ yechanrịn ihiẹn ile. Ẹka Nwa a nị kẹ Osolobuẹ gha ke ụwa ile lẹ ihiẹn ile rịn'a."]},{"type":"verse","number":3,"content":["Ịya kẹ wẹ gi a hụn kẹ ọghọ Osolobuẹ nọ. Ẹnya hụn n'a a hụngụọ Osolobuẹ",{"noteId":0},". O gi oku ẹ hụ hụn nwọn ikẹn hi-ogbe e kwọndọn ụwa ile. Ogẹn o gi chụgụụ ẹjan wẹ gi a chanchanpụ njọ, ọ nọ nọdị alị azụụn ẹka-nni Osolobuẹ, Onyẹ hụn kachanrịn ihiẹn ile ọghọ e nwọn,"]},{"type":"verse","number":4,"content":["makẹni ịya ka ndị mmọn-ozi, ka wẹ ọhụnma-ọhụnma; nọkẹ kẹ ẹfan (nzere) o nwẹ dọn ka nke wẹ."]},{"type":"heading","content":["Nwa Osolobuẹ Ka Ndị Mmọn-ozi"]},{"type":"verse","number":5,"content":["Ẹghẹẹ; makẹni, elee mmọn-ozi kẹ Osolobuẹ sịtu,",{"text":"“Nwa m kẹ ị wụ;","poem":1},{"lineBreak":true},{"text":"a ghọsịgụọ m tannị n'ị wụ nwa m” mọbụ sịzị,","poem":1},{"lineBreak":true},{"text":"“M k'a wụrụ nẹdi ẹ,","poem":1},{"lineBreak":true},{"text":"ọ wụrụ nwa m.”?","poem":1}]},{"type":"verse","number":6,"content":["Ogẹn Osolobuẹ gidẹ wẹhẹ Nwa-ibuzọ a hụ imẹ ụwa, ọ sị,",{"text":"“Ndị mmọn-ozi Osolobuẹ ile, fe n'ẹ.”","poem":1}]},{"type":"verse","number":7,"content":["Nke ndị mmọn-ozi, ihiẹn Osolobuẹ ku wụ nị",{"text":"“Chuku mẹ ndị mmọn-ozi ẹ e hẹnrin ufere;","poem":1},{"lineBreak":true},{"text":"o mẹ ndị idibo ẹ e hẹnrin ọkụn rị e nwunni.”","poem":1}]},{"type":"verse","number":8,"content":["Kanị, nke Nwa a, ihiẹn Osolobuẹ ku wụ,",{"text":"“Euu, Osolobuẹ!","poem":1},{"lineBreak":true},{"text":"Ukpo ị nọ a kị","poem":1},{"text":"k'a tọ jẹnrin ejẹn;","poem":2},{"text":"ezi-omumẹ wụ ọkpọ ị","poem":1},{"text":"hụn i gi a kị Alị-eze i.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ihiẹn furuni wụ ihiẹn a sụọnị ị;","poem":1},{"lineBreak":true},{"text":"njọ e ze i ize.","poem":1},{"lineBreak":true},{"text":"Ịya haịn Osolobuẹ—Osolobuẹ i—","poem":1},{"text":"gi hukpu i udẹn-ịghọghọ,","poem":2},{"lineBreak":true},{"text":"tumẹ i,","poem":2},{"lineBreak":true},{"text":"ye i ọnọdị","poem":2},{"lineBreak":true},{"text":"hụn kachanrịn nke ibe i.”","poem":2}]},{"type":"verse","number":10,"content":["Osolobuẹ sịzị Nwa a,",{"text":"“Di-nwọnni-ẹnyi,","poem":1},{"lineBreak":true},{"text":"ịyụ ke ụwanị ogẹn mbidọn;","poem":1},{"lineBreak":true},{"text":"ẹka ị mẹmẹ igwere","poem":1},{"text":"lẹ ihiẹn ndị rị n'a.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wẹ k'e wiwi,","poem":1},{"text":"kanị ị k'a rịferi;","poem":2},{"text":"wẹ k'a fafụ rịkẹ ẹkwa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I k'a fụma wẹ rịkẹ ẹkwa, wepụ wẹ;","poem":1},{"text":"gi ọzọ nọkin ẹnya wẹ,","poem":2},{"lineBreak":true},{"text":"kẹ wẹ dọn e yihutọ ẹwuru.","poem":2},{"text":"Kanị, yụ nwẹn egbehutọkọ;","poem":1},{"text":"ndụn ị enwọnkọ ọgụgụ.”","poem":2}]},{"type":"verse","number":13,"content":["Elee mmọn-ozi kẹ Osolobuẹ sịtu,",{"text":"“Nọdị alị ẹka-nni m ebeni,","poem":1},{"text":"d'e ru mgbe m gigụụ ndị iṅẹnrẹn","poem":2},{"lineBreak":true},{"text":"i mẹmẹ n'i ihiẹn i gi a zọma ụkụ”?","poem":2}]},{"type":"verse","number":14,"content":["Kịnị kẹ ndị mmọn-ozi wụdẹ? Ẹlẹ mmọn ndị e jẹn ozi kẹ wẹ wụ; mmọn ndị Osolobuẹ zihẹ d'a rụn ọrụn makẹ ọrịnịmma ndị jẹnkọ d'e nwọn nzụọfụha?"]}],"footnotes":[{"noteId":0,"caller":"+","text":"Jọn 14.9","reference":{"chapter":1,"verse":3}}]},"thisChapterLink":"/api/ikk_wbt/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ikk_wbt/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ikk_wbt/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}