e},{"text":"Lamẹkị wụ nwa Mẹtusẹla,","poem":1},{"lineBreak":true},{"text":"Mẹtusẹla wụ nwa Ẹnọkụ,","poem":1},{"lineBreak":true},{"text":"Ẹnọkụ wụ nwa Jarẹdị,","poem":1},{"lineBreak":true},{"text":"Jarẹdị wụ nwa Mahalalẹlụ,","poem":1},{"lineBreak":true},{"text":"Mahalalẹlụ wụ nwa Kenan","poem":1},{"noteId":2},{"text":",","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Kenan wụ nwa Ẹnọsị,","poem":1},{"lineBreak":true},{"text":"Ẹnọsị wụ nwa Sẹtị,","poem":1},{"lineBreak":true},{"text":"Sẹtị wụ nwa Adam,","poem":1},{"lineBreak":true},{"text":"Adam wụ nwa Osolobuẹ.","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"mọbụ: Kaịnanị (ọnụ-Hibru)","reference":{"chapter":3,"verse":37}}]},"thisChapterLink":"/api/ikk_wbt/LUK/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ikk_wbt/LUK/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ikk_wbt/LUK/2.json","previousChapterAudioLinks":{},"numberOfVerses":38}