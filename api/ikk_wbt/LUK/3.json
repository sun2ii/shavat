{"translation":{"id":"ikk_wbt","name":"Elu Ọhụn: Ẹkụkwọ-Nsọ (Azụụn Ọhụn rịn'a)","website":"https://ebible.org/Scriptures/details.php?id=ikkNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ikkNT","licenseNotes":null,"shortName":"WBT","englishName":"Ika NT","language":"ikk","textDirection":"ltr","sha256":"5f5a77b3b58677ed924bdcbd749823d4febb963c40f0a76f65647a3f866ae53d","availableFormats":["json"],"listOfBooksApiLink":"/api/ikk_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7958,"languageName":"Ika","languageEnglishName":"Ika"},"book":{"id":"LUK","translationId":"ikk_wbt","name":"Luku","commonName":"Luku","title":"Oziọma Jesu Kristi Rịkẹ Kẹ Luku Dọn De Ẹ","order":42,"numberOfChapters":24,"sha256":"f2632845cb46a7350862d85e75d451885b9b10c8b4ce8093238f500404a867de","firstChapterNumber":1,"firstChapterApiLink":"/api/ikk_wbt/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/ikk_wbt/LUK/24.json","totalNumberOfVerses":1151},"chapter":{"number":3,"content":[{"type":"heading","content":["Ozi Jọnụ Hụn E Mẹ Mirin-Chuku Zi"]},{"type":"verse","number":1,"content":["Hụn mẹ ẹ ahụa mmisẹn imẹ ọkịkị eze-kanị w'a kpọ Siza Taịberiasị, ogẹn hụ Pọntus' Paịleti gi wụ Gọvanọ rị a kị Judia—wẹ kebe Izrẹlụ lẹ alị ndị nọkunmẹ n'ẹ ụzọ ẹnọ ogẹn hụ: Hẹrọdụ hụ a kị Galili; Filipu nwẹnẹ ẹ hụ a kị Ituria lẹ Trakọnitisi; Lisanịasị hụ a kị Abilẹni."]},{"type":"verse","number":2,"content":["Anasị lẹ Kayafasị wụ ndị-isi nchụ-ẹjan. Ogẹn hụ kẹ oku Osolobuẹ gi bịanị Jọnụ nwa Zẹkaraya imẹ atụ."]},{"type":"verse","number":3,"content":["'Ya ọ nọ ghagbamachanrịn ẹgbẹrẹ Iyi Jọdanị, a ma ọkwa—a sị wẹ bịa d'e mẹ mirin-Chuku, gi ẹ ghọsị n'e rogharịgụọ wẹ—kẹni Osolobuẹ hụn ụzọ gbagharị wẹ njọ."]},{"type":"verse","number":4,"content":["Ẹrịra kẹ wẹ dọn de ẹ imẹ ẹhụhụọ Azaya onyẹ-amụma, nị,",{"text":"“Olu onyẹ ohu rị a han imẹ atụ,","poem":1},{"lineBreak":true},{"text":"a sị,","poem":1},{"lineBreak":true},{"text":"‘Kwa nị nị Di-nwọnni-ẹnyi ụzọ;","poem":1},{"text":"mẹmẹ ni ụzọ a n'o zinrin.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wẹ jẹnkọ d'e hukin ọdanmgbugbu ile,","poem":1},{"text":"mẹ ugu lẹ oke ile hẹnrinsọnmẹ alị-aradan;","poem":2},{"lineBreak":true},{"text":"wẹ jẹnkọ d'e mẹ ụzọ-ngịrịgọ ile zinpụ,","poem":2},{"lineBreak":true},{"text":"mẹ ụzọ-mkpọke ile riẹnpụ —","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ịhịan ile a hụn nzụọpụha Osolobuẹ!’ ”","poem":1}]},{"type":"verse","number":7,"content":["Ya Jọnụ nọ rị a gwa igunrun ndị hụ rị a bịa d'e kunrunn'ẹ n'o mẹ wẹ mirin-Chuku oku, a sị, “Igunrun ẹjụ-alị! Onyẹ sị ụnụ gba nị iwe lẹ ọnụma Osolobuẹ lalanị ọsọ?!"]},{"type":"verse","number":8,"content":["Mịkwọ nị nwan mkpụrụ hụn jẹnkọ d'a ghọsị nị ụnụ e rogharịgụọ! Aghakwọlẹ ni a sị enwẹn ụnụ, ‘Ebraham wụ nẹdi ẹnyi nụ!’ Makẹni, ezioku kẹ m rị a gwakwọ ụnụ, Osolobuẹ sikọ d'a saẹka gi ọmụma ndịnị mẹmẹsọnmẹ ni Ebraham ụmụ."]},{"type":"verse","number":9,"content":["Anyụn a rịgụọlẹ nwan ukun-osisi, e che: osisi ọwụlẹ mịlẹni mkpụrụ rị mma, e gbutu w'ẹ, tụ a ye imẹ ọkụn.”"]},{"type":"verse","number":10,"content":["Igunrun ndị ahụn hụ a sị a, “Kịnị kẹ ẹnyi sịkọ d'e mẹ nwan?”"]},{"type":"verse","number":11,"content":["Ọ nọ sị wẹ, “Onyẹ ọwụlẹ nwọn ẹwuru ẹbụọ jẹnkọ d'e werịrị ohu ye onyẹ nwọnlẹni; onyẹ ọwụlẹ nwọn ihiẹn-oriri sikọ d'e mẹzikwọ ẹrịra.”"]},{"type":"verse","number":12,"content":["Ndị a na ụgwọ-isi hụn bịazịkwọ d'e mẹ mirin-Chuku nọ jụ a, sị, “Onyẹ-nkuzi, kịnị kẹ ẹnyi jẹnkọ d'e mẹ?”"]},{"type":"verse","number":13,"content":["Ọ nọ sị wẹ, “Anakarịlẹ ni ihiẹn wẹ sị ụnụ na.”"]},{"type":"verse","number":14,"content":["Ndị-agha nọ bịazịkwọ d'a jụ a, sị, “Ẹnyi nwẹn? Kịnị kẹ ẹnyi jẹnkọ d'e mẹ?” Ọ nọ sị wẹ, “Aghazịlẹ ni e gi ẹka-ikẹn a narịn ịhịan ego; ebuokinzilẹ ni ịhịan ọnụ; nị nị ụgwọ-ọrụn ụnụ e jun ụnụ ẹfọ.”"]},{"type":"verse","number":15,"content":["Makẹni wẹ rị a tụkẹnmẹ ẹnya Kraịstị, Onyẹ-nzụọpụha Hụ Osolobuẹ Tumẹ, hụn o kwe nkwa n'o jẹnkọ d'e zihẹ, lẹzị makẹni wẹ rị a jụ enwẹn wẹ kẹ Jọnụ rọ,"]},{"type":"verse","number":16,"content":["Jọnụ nọ sị wẹ, “M gi mirin mmaka e mẹ ụnụ mirin-Chuku, kanị onyẹ kanị m lala: efurudẹni m onyẹ jẹnkọ d'a tọpụ eriri akpụkpọ-ụkụ a! O sikọ d'e gi Mmọn-nsọ lẹ ọkụn mẹ ụnụ mirin-Chuku."]},{"type":"verse","number":17,"content":["O gi ihiẹn o gi a fụchan ọka: o jẹnkọ d'a fụchanchanrịn ọka ile rị ebe ọ nọ a kụkpọ ọka, kpọn akpụrụ a ye ebe o kpọntọ ọka, kpọnkikomẹ ẹfịfịa kpọnye imẹ ọkụn hụn wẹ ghalẹni e tinyụn.”"]},{"type":"verse","number":18,"content":["Jọnụ gizi oku ndụnmọdụn bu ọda rịsọnmẹ ichẹn-ichẹn zi wẹ oziọma."]},{"type":"verse","number":19,"content":["Jọnụ nọ jụgbọ eze wụ Hẹrọdụ makẹni o jẹn d'a lụma Hẹrọdịasị wụ nwunyẹ nwẹnẹ ẹ lẹzi makẹ eje-ihiẹn ndị ọzọ bu ọda Hẹrọdụ mẹ."]},{"type":"verse","number":20,"content":["'Ya Hẹrọdụ nọ mẹdẹ hụn ka njọ ghahanị ikpọkin Jọnụ ye ụlọ-ngan."]},{"type":"heading","content":["E Mẹ Wẹ Jizọsị Mirin-Chuku"]},{"type":"verse","number":21,"content":["Ogẹn wẹ gi rị e mẹ ịhịan ile mirin-Chuku, wẹ nọzị mẹ Jizọsị. E mẹgụụ w'a 'ya, ebe ọ rị e mẹ ekpere, elu-igwee nọ kpupụ,"]},{"type":"verse","number":22,"content":["Mmọn-nsọ nọ gi ụdị nduru hidan, bekwasị a. Olu nọ gha elu-igwee sị, “Ịyụ wụ ezi Nwa m; ihiẹn i a sụọka m.”"]},{"type":"heading","content":["Ndị Mụ Jizọsị"]},{"type":"verse","number":23,"content":["Jizọsị rị ihiẹn rịkẹ nwa ahụa iri-kwasị-ọgụn k'o bidọn ọrụn a. Wẹ weri Jizọsị nọkẹ nwa Josẹfụ.",{"text":"Josẹfụ wụ nwa Heli,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Heli wụ nwa Matitatị,","poem":1},{"lineBreak":true},{"text":"Matitatị wụ nwa Livaị,","poem":1},{"lineBreak":true},{"text":"Livaị wụ nwa Mẹki,","poem":1},{"lineBreak":true},{"text":"Mẹki wụ nwa Janaị,","poem":1},{"lineBreak":true},{"text":"Janaị wụ nwa Josẹfụ,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Josẹfụ wụ nwa Matatịasị,","poem":1},{"lineBreak":true},{"text":"Matatịasị wụ nwa Emọsị,","poem":1},{"lineBreak":true},{"text":"Emọsị wụ nwa Nahum,","poem":1},{"lineBreak":true},{"text":"Nahum wụ nwa Es'li,","poem":1},{"lineBreak":true},{"text":"Es'li wụ nwa Nagaị,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nagaị wụ nwa Maatị,","poem":1},{"lineBreak":true},{"text":"Maatị wụ nwa Matatịasị,","poem":1},{"lineBreak":true},{"text":"Matatịasị wụ nwa Sẹmẹi,","poem":1},{"lineBreak":true},{"text":"Sẹmẹi wụ nwa Josẹkị,","poem":1},{"lineBreak":true},{"text":"Josẹkị wụ nwa Jọda,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Jọda wụ nwa Johananị,","poem":1},{"lineBreak":true},{"text":"Johananị wụ nwa Resa,","poem":1},{"lineBreak":true},{"text":"Resa wụ nwa Zẹrubabẹlụ,","poem":1},{"lineBreak":true},{"text":"Zẹrubabẹlụ wụ nwa Shịatẹlụ,","poem":1},{"lineBreak":true},{"text":"Shịatẹlụ wụ nwa Neri,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Neri wụ nwa Mẹki,","poem":1},{"lineBreak":true},{"text":"Mẹki wụ nwa Adi,","poem":1},{"lineBreak":true},{"text":"Adi wụ nwa Kosam,","poem":1},{"lineBreak":true},{"text":"Kosam wụ nwa Ẹmadam,","poem":1},{"lineBreak":true},{"text":"Ẹmadam wụ nwa Ẹh,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ẹh wụ nwa Joshụa,","poem":1},{"lineBreak":true},{"text":"Joshụa wụ nwa Ẹliẹza,","poem":1},{"lineBreak":true},{"text":"Ẹliẹza wụ nwa Jorim,","poem":1},{"lineBreak":true},{"text":"Jorim wụ nwa Matitatị,","poem":1},{"lineBreak":true},{"text":"Matitatị wụ nwa Livaị,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Livaị wụ nwa Simiọnụ,","poem":1},{"lineBreak":true},{"text":"Simiọnụ wụ nwa Juda,","poem":1},{"lineBreak":true},{"text":"Juda wụ nwa Josẹfụ,","poem":1},{"lineBreak":true},{"text":"Josẹfụ wụ nwa Jonam,","poem":1},{"lineBreak":true},{"text":"Jonam wụ nwa Ẹlịakin,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ẹlịakin wụ nwa Mẹlịa,","poem":1},{"lineBreak":true},{"text":"Mẹlịa wụ nwa Mẹna,","poem":1},{"lin