{"translation":{"id":"ikz_wbt","name":"Ʉbhʉragɨ Ubhuhya Mʉkɨgambʉ chi Ikikiizʉ","website":"https://ebible.org/Scriptures/details.php?id=ikz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ikz","licenseNotes":null,"shortName":"WBT","englishName":"Ikizu NT","language":"ikz","textDirection":"ltr","sha256":"513d4d7c9c763f51d7152cd6d32a1faf9751b79001e0a791533bf41b9e645caa","availableFormats":["json"],"listOfBooksApiLink":"/api/ikz_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7957,"languageName":"Ikizu","languageEnglishName":"Ikizu"},"book":{"id":"HEB","translationId":"ikz_wbt","name":"Abhɨɨbhuraaniya","commonName":"Abhɨɨbhuraaniya","title":"Ɨnyarʉbha kwa Abhɨɨbhuraaniya","order":58,"numberOfChapters":13,"sha256":"d5773929af1605ab8d5da91c10cca731347483d3c085ff7081be038a96a52e8b","firstChapterNumber":1,"firstChapterApiLink":"/api/ikz_wbt/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/ikz_wbt/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Mungu agambirɨ kʉhɨtɨra ku Umwana waazɨ"]},{"type":"verse","number":1,"content":["Ɨkarɨ hayo, Mungu akagamba na bhasʉʉkʉrʉ bhɨɨtʉ manga kaaru na kwa nzɨra nzaru, kʉhɨtɨra kʉbharʉʉtɨrɨri."]},{"type":"verse","number":2,"content":["Nawe zisikʉ za mʉtɨnɨrʉ zɨnʉ, Mungu agambirɨ na niitwɨ kʉhɨtɨra Umwana waazɨ.",{"noteId":0},"Akarobhora Umwana wuyo, agabhɨ ebhegero bhyʉsi, na kʉhɨtɨra kwawɨ Mungu akateema icharʉ."]},{"type":"verse","number":3,"content":["Umwana wuyo arabharya kʉbhʉgʉngʉ bhwa Mungu na areerecha habhwɨrʉ chɨmbu Mungu arɨ. Kʉhɨtɨra ʉbhʉnaja bhwɨ ɨngʼana yaazɨ, aragirya ebhegero bhyʉsi bhɨbhɨhʉ sikʉ zʉʉsi. Na akiihurucha ikimweso chu ukuruusha abhaatʉ ʉbhʉbhɨ, akaja mwisaarʉ, akiikara ʉrʉbhaara rwu ubhuryʉ rwa Mungu."]},{"type":"heading","content":["Yɨɨsu nɨ‑mʉkʉrʉ kʉkɨra bhamaraika"]},{"type":"verse","number":4,"content":["Mungu akakora Umwana waazɨ mʉkʉrʉ kʉkɨra bhamaraika,",{"noteId":1},"chɨmbu iriina rɨnʉ aamʉhɨɨrɨ ni‑kʉrʉ kʉkɨra ga bhamaraika."]},{"type":"verse","number":5,"content":["Na atareeho maraika wʉnʉ Mungu aabhuuriirɨ amangʼana ganʉ aabhuuriirɨ Yɨɨsu,",{"text":"“Awɨ ni‑Mwana waanɨ,","poem":1},{"lineBreak":true},{"text":"reero nɨbhɨɨrɨ Wuusʉ.”","poem":1},{"noteId":2},"Na Mungu ataagambirɨ igʉrʉ wa maraika wʉwʉʉsi,",{"text":"“Inyɨ nɨrabha Wiisɨ","poem":1},{"lineBreak":true},{"text":"neewe arabha Mwana waanɨ.”","poem":1},{"noteId":3}]},{"type":"verse","number":6,"content":["Na hanʉ Mungu aatumirɨ Umwana waazɨ umumwɨmwɨ kʉʉsɨ, akabhuga,",{"text":"“Bhamaraika bhʉʉsi bha Mungu bhasengere Umwana wuyo.”","poem":1},{"noteId":4}]},{"type":"verse","number":7,"content":["Ni igʉrʉ wa bhamaraika abhugirɨ,",{"text":"“Ahaakora bhamaraika bhaazɨ kʉbha ʉmʉkama,","poem":1},{"noteId":5},{"lineBreak":true},{"text":"na abhahocha bhaazɨ kʉbha ɨmɨrɨngɨɨri jo omorero.”","poem":1},{"noteId":6}]},{"type":"verse","number":8,"content":["Nawe igʉrʉ wu Umwana waazɨ akabhuga,",{"text":"“Awɨ Mungu ʉratema kemerano,","poem":1},{"lineBreak":true},{"text":"nʉ ʉbhʉkangati bhwazʉ bhʉrabha bhwe eheene.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Awɨ ʉhaasɨɨga amazʉmu,","poem":1},{"lineBreak":true},{"text":"na ʉhaabhiihirirwa amabhɨ.","poem":1},{"lineBreak":true},{"text":"Necho kiyo Mungu, Mungu waazʉ,","poem":1},{"lineBreak":true},{"text":"akʉhakirɨ amaguta go obhozomerwa,","poem":1},{"lineBreak":true},{"text":"korereke ʉbhɨ mʉkʉrʉ,","poem":1},{"lineBreak":true},{"text":"kʉkɨra abhakɨndichazʉ.”","poem":1},{"noteId":7}]},{"type":"verse","number":10,"content":["Kwikɨ Mungu akabhuga,",{"text":"“Ʉmʉkʉrʉ, awɨ ʉkateema ɨɨsɨ kwɨma kʉbhʉtangɨ,","poem":1},{"lineBreak":true},{"text":"na risaarʉ kʉmabhoko gaazʉ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ebhegero bhiyo bhyʉsi bhɨrasira,","poem":1},{"lineBreak":true},{"text":"bhɨranyara ncha zengebho,","poem":1},{"lineBreak":true},{"text":"nawe awɨ ʉrarama.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Na ʉrabhikunyakunya nche engebho,","poem":1},{"lineBreak":true},{"text":"bhɨragarurwa ncha zengebho.","poem":1},{"lineBreak":true},{"text":"Nawe awɨ ʉrasaaga wuryawurya,","poem":1},{"lineBreak":true},{"text":"ni imyaka jazʉ gɨtaana tɨnɨrʉ.”","poem":1},{"noteId":8}]},{"type":"verse","number":13,"content":["Atareeho maraika wʉwʉʉsi wʉnʉ Mungu aamubhuuriirɨ,",{"text":"“Ikara ʉrʉbhaara rwanɨ rwu ubhuryʉ,","poem":1},{"lineBreak":true},{"text":"kuhika hanʉ nɨkʉtʉʉra abhabhisa bhaazʉ iyaasɨ wa amagʉrʉ gaazʉ.”","poem":1},{"noteId":9}]},{"type":"verse","number":14,"content":["Bhamaraika nɨ‑kɨgʉrʉkɨ? Ne‑zekoro na nɨ‑bhahocha bha Mungu, bharatumwa, bhajɨ kohokerya abhaatʉ bhanʉ bhakʉsabhurwa."]}],"footnotes":[{"noteId":0,"caller":"+","text":"Umwana waazɨ. Kʉmaragɨrɨra bhʉkʉngʼu, rora ringʼana Umwana wa Mungu muKiniibhasa.","reference":{"chapter":1,"verse":2}},{"noteId":1,"caller":"+","text":"Bhamaraika. Kʉmaragɨrɨra bhʉkʉngʼu, rora ringʼana maraika muKiniibhasa.","reference":{"chapter":1,"verse":4}},{"noteId":2,"caller":"+","text":"a Rora Zabhuri 2:7.","reference":{"chapter":1,"verse":5}},{"noteId":3,"caller":"+","text":"b Rora 2 Samwɨri 7:14.","reference":{"chapter":1,"verse":5}},{"noteId":4,"caller":"+","text":"Rora Amahiityʉ gi Imigirʉ 32:43.","reference":{"chapter":1,"verse":6}},{"noteId":5,"caller":"+","text":"a Ʉmʉkama kuKigiriki rene enzobhooro ya ʉmʉkama ne ekoro.","reference":{"chapter":1,"verse":7}},{"noteId":6,"caller":"+","text":"b Rora Zabhuri 104:4.","reference":{"chapter":1,"verse":7}},{"noteId":7,"caller":"+","text":"Rora Zabhuri 45:6‑7.","reference":{"chapter":1,"verse":9}},{"noteId":8,"caller":"+","text":"Rora Zabhuri 102:25‑27.","reference":{"chapter":1,"verse":12}},{"noteId":9,"caller":"+","text":"Rora Zabhuri 110:1.","reference":{"chapter":1,"verse":13}}]},"thisChapterLink":"/api/ikz_wbt/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ikz_wbt/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ikz_wbt/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}