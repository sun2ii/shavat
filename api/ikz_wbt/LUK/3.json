{"translation":{"id":"ikz_wbt","name":"Ʉbhʉragɨ Ubhuhya Mʉkɨgambʉ chi Ikikiizʉ","website":"https://ebible.org/Scriptures/details.php?id=ikz","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ikz","licenseNotes":null,"shortName":"WBT","englishName":"Ikizu NT","language":"ikz","textDirection":"ltr","sha256":"513d4d7c9c763f51d7152cd6d32a1faf9751b79001e0a791533bf41b9e645caa","availableFormats":["json"],"listOfBooksApiLink":"/api/ikz_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7957,"languageName":"Ikizu","languageEnglishName":"Ikizu"},"book":{"id":"LUK","translationId":"ikz_wbt","name":"Ruuka","commonName":"Ruuka","title":"Amangʼana Amazʉmu ga Yɨɨsu Kiriisitʉ chɨmbu gaandikirwɨ na Ruuka","order":42,"numberOfChapters":24,"sha256":"a88bf9b93bcd48c279fd9e26fd2f37ea7a7468d270c37f02eab6b03b1a02cee8","firstChapterNumber":1,"firstChapterApiLink":"/api/ikz_wbt/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/ikz_wbt/LUK/24.json","totalNumberOfVerses":1151},"chapter":{"number":3,"content":[{"type":"heading","content":["Yoohana arakonza ɨnzɨra igʉrʉ wa Yɨɨsu"]},{"type":"verse","number":1,"content":["Gwarɨ umwaka gwi ikumi na kataanʉ, gwʉ ʉbhʉtɨmi bhwʉ ʉmʉtɨmi ʉmʉkʉrʉ Tibhɨriyo. Ʉmʉkʉrʉ wa mucharʉ cha Yudeya aarɨ Pʉntiyʉ Piraato, na wʉnʉ aarɨ aratema mucharʉ cha Gariraaya aarɨ Heroode.",{"noteId":17},"Wʉnʉ aarɨ aratema mucharʉ cha Itureya na cha Tarakoniti aarɨ Firipʉ, umwabhʉ Heroode, na wʉnʉ aarɨ aratema mucharʉ cha Abhirene aarɨ Risania."]},{"type":"verse","number":2,"content":["Ribhaga rɨnʉ Anaasi na Kayaafa bhaarɨ abhakʉrʉ bha abhakuhaani.",{"noteId":18},"Kwibhaga riyo, ɨngʼana ya Mungu ɨkamuhikɨra Yoohana, umwana wa Zaakariya mwitɨrɨgʉ."]},{"type":"verse","number":3,"content":["Yoohana akaja akagenda mucharʉ chʉsi rusizʉ wɨ ɨkɨtaarʉ cha Yorodaani, ɨnʉ ararwazɨra abhaatʉ, bhatigɨ ʉbhʉbhɨ, bhabhatiizwɨ, korereke Mungu abhabheerere."]},{"type":"verse","number":4,"content":["Ɨngʼana yiyo ɨkahikɨra Yoohana, chɨmbu yandikirwɨ nʉ ʉmʉrʉʉtɨrɨri Isaaya mʉkɨtabhʉ chazɨ:",{"text":"“Riraka ryʉ ʉmʉʉtʉ wʉnʉ akʉraganʼya mwitɨrɨgʉ,","poem":1},{"lineBreak":true},{"text":"‘Mokonze ɨnzɨra yʉ Ʉmʉkʉrʉ,","poem":1},{"lineBreak":true},{"text":"mogorore ɨbhɨhɨtʉ bhyazɨ!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Amarʉʉma gʉʉsi gararindwa,","poem":1},{"lineBreak":true},{"text":"ɨbhɨgʉrʉ nɨ ɨhɨgʉrʉ bhɨranyaraganibhwa.","poem":1},{"lineBreak":true},{"text":"Hanʉ hiisisirɨ, haragororwa.","poem":1},{"lineBreak":true},{"text":"Zɨnzɨra zɨmbɨ zɨrakonzwa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Neho abhaatʉ bhʉʉsi bharaarore ubhutuurya bhwa Mungu.’ ”","poem":1},{"noteId":19}]},{"type":"verse","number":7,"content":["Abhaatʉ bhaaru bhakabha bharaaza kwa Yoohana abhabhatiizɨ, nawe akabhabhʉʉrɨra, “Imwɨ urwibhʉrʉ rwe enzoka! Wɨɨwɨ abhabhuuriirɨ mʉratʉra kongʼosa ɨtɨnɨrʉ ya Mungu yɨnʉ ikuuza?"]},{"type":"verse","number":8,"content":["Mokore amangʼana ganʉ gakwerekenʼya kʉbha mutigirɨ ʉbhʉbhɨ! Mutiikangirirya naatu mʉrabhuga, ‘Sʉʉkʉrʉ wɨɨtʉ, nɨ‑Abhurahaamu.’",{"noteId":20},"Nɨrabhabhʉʉrɨra, Mungu aratʉra kuchʉra amabhwɨ ganʉ gabhɨ abhaana bha Abhurahaamu!"]},{"type":"verse","number":9,"content":["Nangʉ ɨtɨnɨrʉ ya Mungu iri igʉrʉ waanyu nchɨ ɨhaazi iri igʉrʉ wa amatina gɨ ɨmɨtɨ. Na bhanʉ bhatakokora amahocha amazʉmu bharatinirwa, chɨmbu ɨmɨtɨ jʉsi gɨnʉ gɨtakwibhʉra imisumʉ ɨmɨzʉmu gɨhaatinwa na kʉtaashwa momorero.”"]},{"type":"verse","number":10,"content":["Neho riribhita rya abhaatʉ rɨkabhuurya Yoohana, “Nangʉ tokorebhwɨ?”"]},{"type":"verse","number":11,"content":["Akabhagarukirya, “Wʉnʉ ana shadi ibhɨrɨ, ahuruchɨ ɨyɨmwɨ kwa wʉnʉ ataanayʉ na wʉnʉ ani ibhyakurya, wʉʉsi amosondere wʉnʉ ataanabhyʉ.”"]},{"type":"verse","number":12,"content":["Kwiribhita riyo bhaareho abharihya bha rigʉʉti,",{"noteId":21},"bhʉʉsi bhakiizɨra Yoohana abhabhatiizɨ. Bhakamubhuurya, “Umwija, na niitwɨ tokorebhwɨ?”"]},{"type":"verse","number":13,"content":["Akabhagarukirya, “Moreegege rigʉʉti, mʉtagega kʉkɨra rɨnʉ mubhuuriirwɨ.”"]},{"type":"verse","number":14,"content":["Bhaareho abhasirikarɨ, bhʉʉsi bhakamubhuurya, “Na niitwɨ, tokorebhwɨ?” Akabhagarukirya, “Mʉtagega bhegero bhya mʉʉtʉ wʉwʉʉsi kwa nguru, hamwɨ komogobha ingʼana korereke mobhone zimpirya! Nawe mwisiriranʼyɨ na amarihi gaanyu.”"]},{"type":"verse","number":15,"content":["Abhaatʉ bhʉʉsi, bhakabha bhariibhuurya mozekoro zaabhʉ igʉrʉ wa Yoohana, kʉ kʉbha bhaarɨ bhariiseega kʉbha, hamwɨ newe Kiriisitʉ."]},{"type":"verse","number":16,"content":["Nawe, akabhabhʉʉrɨra bhʉʉsi, “Inyɨ, nɨrabhabhatiiza na amanzi, nawe araaza inyuma waanɨ, ʉmʉʉtʉ wʉnʉ akʉnkɨra ʉbhʉnaja. Nɨtakwenderwa nʉʉrʉ kʉtazʉra zisiri zi ibhikwɨra bhyazɨ!",{"noteId":22},"Ewe arabhabhatiiza kwe Ekoro Ɨndɨndu, na komorero."]},{"type":"verse","number":17,"content":["Ewe anʉ ʉrʉhʉngʉ mʉmabhoko gaazɨ, korereke aseese ɨnganʉ. Arakumɨngɨra ɨnganʉ mʉkɨtara chazɨ, nawe ʉmʉkʉʉnyʉ, aragwocha momorero gʉnʉ gʉtakurima zee.”"]},{"type":"verse","number":18,"content":["Kʉmangʼana maaru gayo na agandɨ, Yoohana aarɨ arabheerekeererya abhaatʉ bhayo Ɨngʼana Ɨnzʉmu kurwa kwa Mungu."]},{"type":"verse","number":19,"content":["Nawe, hanʉ Yoohana aamʉhaariirɨ ʉmʉtɨmi Heroode, igʉrʉ wo okogega Hɨrʉʉdiya, ʉmʉkari wu umunyi waazɨ, na kʉmabhɨ agandɨ gʉʉsi ganʉ aakʉrirɨ,"]},{"type":"verse","number":20,"content":["Heroode akoongera ʉbhʉbhɨ bhuyo, ko komobhoha Yoohana mokebhoho."]},{"type":"heading","content":["Ʉkʉbhatiizwa kwa Yɨɨsu"]},{"type":"verse","number":21,"content":["Hanʉ Yoohana aarɨ akɨɨrɨ kobhohwa, abhaatʉ bhaaru bhaarɨ bharabhatiizwa neewe, Yɨɨsu wʉʉsi akaaza akabhatiizwa. Hanʉ aarɨ arasabha, risaarʉ rikiigʉka."]},{"type":"verse","number":22,"content":["Ekoro Ɨndɨndu ikiika igʉrʉ waazɨ nchi ikiguuti, na riraka rɨkarwa mwisaarʉ, rɨrabhuga, “Awɨ ni‑Mwana waanɨ ʉmʉsɨɨgwa, nɨzʉmɨrɨɨrwɨ na naawɨ.”"]},{"type":"heading","content":["Ikishoko kɨnʉ Kiriisitʉ aaruurɨ"]},{"type":"verse","number":23,"content":["Hanʉ Yɨɨsu aatangirɨ emeremo jazɨ, aarɨ ni imyaka merongo ɨtatʉ. Abhaatʉ bhaarɨ bharakina ni‑mwana wa Yuusufu."]},{"type":"verse","number":24,"content":[{"text":"Na Yuusufu wuyo, aarɨ mwana wa Hɨri.","poem":1},{"lineBreak":true},{"text":"Na Hɨri, aarɨ mwana wa Matati.","poem":1},{"lineBreak":true},{"text":"Matati, aarɨ mwana wa Raawi.","poem":1},{"lineBreak":true},{"text":"Raawi, aarɨ mwana wa Mɨriki.","poem":1},{"lineBreak":true},{"text":"Mɨriki, aarɨ mwana wa Yana.","poem":1},{"lineBreak":true},{"text":"Yana, aarɨ mwana wa Yuusufu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Yuusufu, aarɨ mwana wa Matatia.","poem":1},{"lineBreak":true},{"text":"Matatia, aarɨ mwana wa Amʉʉsi.","poem":1},{"lineBreak":true},{"text":"Amʉʉsi, aarɨ mwana wa Nahuumu.","poem":1},{"lineBreak":true},{"text":"Nahuumu, aarɨ mwana wa Ɨsiri.","poem":1},{"lineBreak":true},{"text":"Ɨsiri, aarɨ mwana wa Nagayi.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nagayi, aarɨ mwana wa Maati.","poem":1},{"lineBreak":true},{"text":"Maati, aarɨ mwana wa Matatia.","poem":1},{"lineBreak":true},{"text":"Matatia, aarɨ mwana wa Sɨmɨyi.","poem":1},{"lineBreak":true},{"text":"Sɨmɨyi, aarɨ mwana wa Yʉsɨki.","poem":1},{"lineBreak":true},{"text":"Yʉsɨki, aarɨ mwana wa Yoda.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Yoda, aarɨ mwana wa Yoohanani.","poem":1},{"lineBreak":true},{"text":"Yoohanani, aarɨ mwana wa Resa.","poem":1},{"lineBreak":true},{"text":"Resa, aarɨ mwana wa Zɨrubhabhɨɨri.","poem":1},{"lineBreak":true},{"text":"Zɨrubhabhɨɨri, aarɨ mwana wa Sheyaritiyɨri.","poem":1},{"lineBreak":true},{"text":"Sheyaritiyɨri, aarɨ mwana wa Nɨri.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Nɨri, aarɨ mwana wa Mɨriki.","poem":1},{"lineBreak":true},{"text":"Mɨriki, aarɨ mwana wa Adi.","poem":1},{"lineBreak":true},{"text":"Adi, aarɨ mwana wa Kosamu.","poem":1},{"lineBreak":true},{"text":"Kosamu, aarɨ mwana wa Ɨrimadamu.","poem":1},{"lineBreak":true},{"text":"Ɨrimadamu, aarɨ mwana wa Ɨri.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ɨri, aarɨ mwana wa Yʉʉshwa.","poem":1},{"lineBreak":true},{"text":"Yʉʉshwa, aarɨ mwana wa Ɨriyɨɨzɨri.","poem":1},{"lineBreak":true},{"text":"Ɨriyɨɨzɨri, aarɨ mwana wa Yʉrimu.","poem":1},{"lineBreak":true},{"text":"Yʉrimu, aarɨ mwana wa Matati.","poem":1},{"lineBreak":true},{"text":"Matati, aarɨ mwana wa Raawi.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Raawi, aarɨ mwana wa Simiyʉʉni.","poem":1},{"lineBreak":true},{"text":"Simiyʉʉni, aarɨ mwana wa Yuuda.","poem":1},{"lineBreak":true},{"text":"Yuuda, aarɨ mwana wa Yuusufu.","poem":1},{"lineBreak":true},{"text":"Yuusufu, aarɨ mwana wa Yoonamu.","poem":1},{"lineBreak":true},{"text":"Yoonamu, aarɨ mwana wa Ɨriyakimu.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ɨriyakimu, aarɨ mwana wa Mereya.","poem":1},{"lineBreak":true},{"text":"Mereya, aarɨ mwana wa Mena.","poem":1},{"lineBreak":true},{"text":"Mena, aarɨ mwana wa Matata.","poem":1},{"lineBreak":true},{"text":"Matata, aarɨ mwana wa Natani.","poem":1},{"lineBreak":true},{"text":"Natani, aarɨ mwana wa Daudi.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Daudi, aarɨ mwana wa Yeese.","poem":1},{"lineBreak":true},{"text":"Yeese, aarɨ mwana wa Ʉbhɨɨdi.","poem":1},{"lineBreak":true},{"text":"Ʉbhɨɨdi, aarɨ mwana wa Bhoowazi.","poem":1},{"lineBreak":true},{"text":"Bhoowazi, aarɨ mwana wa Sarimʉʉni.","poem":1},{"lineBreak":true},{"text":"Sarimʉʉni, aarɨ mwana wa Nashʉni.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Nashʉni, aarɨ mwana wa Aminadaabhu.","poem":1},{"lineBreak":true},{"text":"Aminadaabhu, aarɨ mwana wa Adimini.","poem":1},{"lineBreak":true},{"text":"Adimini, aarɨ mwana wa Arini.","poem":1},{"lineBreak":true},{"text":"Arini, aarɨ mwana wa Hɨzirʉʉni.","poem":1},{"lineBreak":true},{"text":"Hɨzirʉʉni, aarɨ mwana wa Pɨrɨɨsi.","poem":1},{"lineBreak":true},{"text":"Pɨrɨɨsi, aarɨ mwana wa Yuuda.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Yuuda, aarɨ mwana wa Yaakobho.","poem":1},{"lineBreak":true},{"text":"Yaakobho, aarɨ mwana wa Iisaka.","poem":1},{"lineBreak":true},{"text":"Iisaka, aarɨ mwana wa Abhurahaamu.","poem":1},{"lineBreak":true},{"text":"Abhurahaamu, aarɨ mwana wa Teera.","poem":1},{"lineBreak":true},{"text":"Teera, aarɨ mwana wa Nahʉʉri.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Nahʉʉri, aarɨ mwana wa Sɨrugi.","poem":1},{"lineBreak":true},{"text":"Sɨrugi, aarɨ mwana wa Rɨɨhu.","poem":1},{"lineBreak":true},{"text":"Rɨɨhu, aarɨ mwana wa Pɨrɨɨgi.","poem":1},{"lineBreak":true},{"text":"Pɨrɨɨgi, aarɨ mwana wa Ɨbhɨɨri.","poem":1},{"lineBreak":true},{"text":"Ɨbhɨɨri, aarɨ mwana wa Saara.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Saara, aarɨ mwana wa Kɨnani.","poem":1},{"lineBreak":true},{"text":"Kɨnani, aarɨ mwana wa Arufakisadi.","poem":1},{"lineBreak":true},{"text":"Arufakisadi, aarɨ mwana wa Shɨmu.","poem":1},{"lineBreak":true},{"text":"Shɨmu, aarɨ mwana wa Nuuhu.","poem":1},{"lineBreak":true},{"text":"Nuuhu, aarɨ mwana wa Raamɨki.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Raamɨki, aarɨ mwana wa Mɨtuseera.","poem":1},{"lineBreak":true},{"text":"Mɨtuseera, aarɨ mwana wa Ɨnʉki.","poem":1},{"lineBreak":true},{"text":"Ɨnʉki, aarɨ mwana wa Yarɨɨdi.","poem":1},{"lineBreak":true},{"text":"Yarɨɨdi, aarɨ mwana wa Mahararɨɨri.","poem":1},{"lineBreak":true},{"text":"Mahararɨɨri, aarɨ mwana wa Kɨnani.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Kɨnani, aarɨ mwana wa Ɨnʉshi.","poem":1},{"lineBreak":true},{"text":"Ɨnʉshi, aarɨ mwana wa Sɨɨti.","poem":1},{"lineBreak":true},{"text":"Sɨɨti, aarɨ mwana wa Adaamu.","poem":1},{"lineBreak":true},{"text":"Na Adaamu ewe, aarɨ umwana wa Mungu.","poem":1}]}],"footnotes":[{"noteId":17,"caller":"+","text":"Heroode. Kʉmaragɨrɨra bhʉkʉngʼu, rora ringʼana Heroode Antipaasi muKiniibhasa.","reference":{"chapter":3,"verse":1}},{"noteId":18,"caller":"+","text":"Abhakuhaani. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa.","reference":{"chapter":3,"verse":2}},{"noteId":19,"caller":"+","text":"Rora Isaaya 40:3‑5.","reference":{"chapter":3,"verse":6}},{"noteId":20,"caller":"+","text":"Abhurahaamu. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa.","reference":{"chapter":3,"verse":8}},{"noteId":21,"caller":"+","text":"Abharihya bha rigʉʉti. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa.","reference":{"chapter":3,"verse":12}},{"noteId":22,"caller":"+","text":"Arɨɨbhɨ umugini arasikɨra munyumba, mbʉʉsa wi iyaasɨ bhʉkʉngʼu aarɨ aramuruusha ibhikwɨra na kwoja amagʉrʉ gaazɨ.","reference":{"chapter":3,"verse":16}}]},"thisChapterLink":"/api/ikz_wbt/LUK/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ikz_wbt/LUK/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ikz_wbt/LUK/2.json","previousChapterAudioLinks":{},"numberOfVerses":38}