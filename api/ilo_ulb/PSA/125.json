{"translation":{"id":"ilo_ulb","name":"Ti Biblia","website":"https://ebible.org/Scriptures/details.php?id=iloulb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=iloulb","licenseNotes":null,"shortName":"ULB","englishName":"Ilocano Bible","language":"ilo","textDirection":"ltr","sha256":"4871ae9b2b657c862a7a55817bab081afc7c639fb5762344cd72df300f45ce48","availableFormats":["json"],"listOfBooksApiLink":"/api/ilo_ulb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Iloko","languageEnglishName":"Iloko"},"book":{"id":"PSA","translationId":"ilo_ulb","name":"Dagiti Salmo","commonName":"Dagiti Salmo","title":"Dagiti Salmo","order":19,"numberOfChapters":150,"sha256":"3f3e8856032fa775289131ec8c0f0193383eb0bf0809def4a3954d2c5881e354","firstChapterNumber":1,"firstChapterApiLink":"/api/ilo_ulb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ilo_ulb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":125,"content":[{"type":"verse","number":1,"content":["Dagiti agtaltalek kenni Yahweh ket kasda la iti Bantay Sion, saan a magunggon, agtalinaed iti agnanayon."]},{"type":"verse","number":2,"content":["Kas kadagiti bantay a naipalawlaw iti Jerusalem, kasta met a linawlaw ni Yahweh dagiti tattaona ita ken iti agnanayon."]},{"type":"verse","number":3,"content":["Saan a rumbeng nga agturay ti setro ti kinadangkes iti daga dagiti nalinteg. Amangan no aramiden ti nalinteg iti dakes."]},{"type":"verse","number":4,"content":["O Yahweh, agaramidka iti naimbag kadagiti naimbag ken kadagiti nalinteg ti pusoda."]},{"type":"verse","number":5,"content":["Ngem no kadagiti agbaw-ing nga agturong kadagiti nakillo a dalanda, iyadayunto ida ni Yahweh a kaduada dagiti managdakdakes. Adda koma iti kappia iti Israel."]}],"footnotes":[]},"thisChapterLink":"/api/ilo_ulb/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ilo_ulb/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ilo_ulb/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}