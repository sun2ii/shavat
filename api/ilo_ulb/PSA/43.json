{"translation":{"id":"ilo_ulb","name":"Ti Biblia","website":"https://ebible.org/Scriptures/details.php?id=iloulb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=iloulb","licenseNotes":null,"shortName":"ULB","englishName":"Ilocano Bible","language":"ilo","textDirection":"ltr","sha256":"4871ae9b2b657c862a7a55817bab081afc7c639fb5762344cd72df300f45ce48","availableFormats":["json"],"listOfBooksApiLink":"/api/ilo_ulb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Iloko","languageEnglishName":"Iloko"},"book":{"id":"PSA","translationId":"ilo_ulb","name":"Dagiti Salmo","commonName":"Dagiti Salmo","title":"Dagiti Salmo","order":19,"numberOfChapters":150,"sha256":"3f3e8856032fa775289131ec8c0f0193383eb0bf0809def4a3954d2c5881e354","firstChapterNumber":1,"firstChapterApiLink":"/api/ilo_ulb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ilo_ulb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":["Ukomennak, O Dios, ken ipakaasim ti kalintegak kadagiti saan a nadiosan a nasion;"]},{"type":"verse","number":2,"content":["Ta sika ti Dios ti pigsak; apay nga imbellengnak? Apay nga agdung-awak iti panangparigat dagiti kabusor?"]},{"type":"verse","number":3,"content":["O, ibaonmo ti silawmo ken ti kinapudnom; idalandak koma; ipandak koma iti nasantoan a turodmo ken iti tabernakulom."]},{"type":"verse","number":4,"content":["Ket mapanakto iti altar ti Dios, iti Dios nga aglaplapusanan a rag-ok; ken iti arpa idaydayawkanto, O Dios, a Diosko."]},{"type":"verse","number":5,"content":["Apay a nakadumogka, kararuak? Apay a maringgoranka iti kaunggak? Mangnamnamaka iti Dios; ta agdayawak pay kenkuana, nga isu ti tulong ken Diosko."]}],"footnotes":[]},"thisChapterLink":"/api/ilo_ulb/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ilo_ulb/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ilo_ulb/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}