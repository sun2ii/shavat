{"translation":{"id":"ilo_ulb","name":"Ti Biblia","website":"https://ebible.org/Scriptures/details.php?id=iloulb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=iloulb","licenseNotes":null,"shortName":"ULB","englishName":"Ilocano Bible","language":"ilo","textDirection":"ltr","sha256":"4871ae9b2b657c862a7a55817bab081afc7c639fb5762344cd72df300f45ce48","availableFormats":["json"],"listOfBooksApiLink":"/api/ilo_ulb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"Iloko","languageEnglishName":"Iloko"},"book":{"id":"PSA","translationId":"ilo_ulb","name":"Dagiti Salmo","commonName":"Dagiti Salmo","title":"Dagiti Salmo","order":19,"numberOfChapters":150,"sha256":"3f3e8856032fa775289131ec8c0f0193383eb0bf0809def4a3954d2c5881e354","firstChapterNumber":1,"firstChapterApiLink":"/api/ilo_ulb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ilo_ulb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":["Agar-ari ni Yahweh, nakakagay isuna ti kinadaeg; nakawesan ni Yahweh iti kinabileg; kasla barikes a nakasuot kenkuana iti kinabileg. Sititibker a naipasdek ti lubong; saan a magungon."]},{"type":"verse","number":2,"content":["Naipasdek ti tronom manipud pay idi un-unana a tiempo; agnanayon nga addaka."]},{"type":"verse","number":3,"content":["Agpangato dagiti baybay, O Yahweh, inngatoda dagiti timekda; maburak dagiti dalluyon ket agdaranudorda."]},{"type":"verse","number":4,"content":["Iti rabaw dagiti agdidinnungpar a dalluyon, dagiti nabileg a mangdaddadael iti taaw, nabileg ni Yahweh nga adda iti langit."]},{"type":"verse","number":5,"content":["Mapagtalkan unay dagiti pammaneknekmo; naiyarkus ti kinasanto iti balaymo, O Yahweh, ti agnanayon."]}],"footnotes":[]},"thisChapterLink":"/api/ilo_ulb/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ilo_ulb/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ilo_ulb/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}