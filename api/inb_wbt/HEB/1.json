{"translation":{"id":"inb_wbt","name":"Kaipimi Taita Dius Rimaku","website":"https://ebible.org/Scriptures/details.php?id=inb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=inb","licenseNotes":null,"shortName":"WBT","englishName":"Inga NT","language":"inb","textDirection":"ltr","sha256":"97900b1384f886386ac88f4ea655f4c42422d7921684e847c7c041d4673ba4e1","availableFormats":["json"],"listOfBooksApiLink":"/api/inb_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7940,"languageName":"Inga","languageEnglishName":"Inga"},"book":{"id":"HEB","translationId":"inb_wbt","name":"HEBREOKUNATA","commonName":"HEBREOKUNATA","title":"HEBREOKUNATA KARTA KACHASKAMANDA","order":58,"numberOfChapters":13,"sha256":"938394da316b5d7181cffd9f0225e42caa838f38f2488ffebc56b6c411226c69","firstChapterNumber":1,"firstChapterApiLink":"/api/inb_wbt/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/inb_wbt/HEB/13.json","totalNumberOfVerses":302},"chapter":{"number":1,"content":[{"type":"heading","content":["Taita Dius, paipa wam­brawa nukan­chita willaska­manda"]},{"type":"verse","number":1,"content":["Ñugpataka Taita Dius, nukan­chipa ñugpa­manda taita­kunata ikuti ikuti, sug rig­cha sug rig­cha, Santu Ispi­ri­tu­wa rimag­kuna­wa­mi willa­dur karka."]},{"type":"verse","number":2,"content":["Kai tuku­rii pun­cha­kunaka, pai kikinpa wam­bra­wa­mi nukan­chita rimag­sa­murka. Pai kikinpa wam­bra­wa­mi tukui alpa­kunata rurarka. Pai kikin­pa wam­bra­ta­mi tukui kararka."]},{"type":"verse","number":3,"content":["Pai wam­bra­mi ka Taita Dius­pa iapa suma luarpi paipa pun­cha­wa pun­cha­ia­chig. Taita Dius­sina rig­cha­lla­ta­ta­mi kawa­ri ka. Pai, tukui pudispa, pai kikinpa rimai­lla­wan­ta­mi tukuita suma charí. Pai­lla­ta­ta­mi, nukan­chipa panda­rii­kunata anchu­chii ruraspa, suma luarpi iapa atun Taita Dius­pa alli ladu tia­rig­rirka."]},{"type":"heading","content":["Taita Dius­pa wam­bra, anjil­kuna­manda mas atun kaska­manda"]},{"type":"verse","number":4,"content":["Chasaka, anjil­kuna­manda mas atun­ia­chis­ka­mi tukurka. Paipa suti­pas, pai­kunapa suti­kuna­manda mas atun­mi ka."]},{"type":"verse","number":5,"content":["Ñi mai­kan anjil­ta­pas, Taita Dius mana kasa nirka­chu:",{"text":"Kam, nuka­pa wam­bra­mi kangi.","poem":1},{"lineBreak":true},{"text":"Nukami kuna pun­cha kaug­sai karaiki.","poem":1},"Kasapasmi ñugpa­manda librupi nirka:",{"text":"Nukami paipa Taita kan­ga­pa kani.","poem":1},{"lineBreak":true},{"text":"Pai, nuka­pa wam­bra­mi kan­ga­pa ka.","poem":1}]},{"type":"verse","number":6,"content":["Paipa suglla wam­brata kai alpama kacha­mus­paka, kasa­mi nirka:",{"text":"Nuka­pa tukui anjil­kuna,","poem":1},{"lineBreak":true},{"text":"paita kungu­rispa, ni­puan­gi­chi:","poem":1},{"lineBreak":true},{"text":"“Iapa allimi kangi”.","poem":1}]},{"type":"verse","number":7,"content":["Anjil­kuna­mandaka kasa­mi ni:",{"text":"Paipa anjil­kuna­ta­mi kachá,","poem":1},{"lineBreak":true},{"text":"waira­sina pai ima nis­kata rurag­kuna kan­ga­pa.","poem":1},{"lineBreak":true},{"text":"Pai ima nis­kata sug nina sindi rilampa­sina mana unailla ruragmi kan­kuna.","poem":1}]},{"type":"verse","number":8,"content":["Ikuti kikin Taita Dius­pa wam­bra­taka kasa­mi ni:",{"text":"Kam, Dius­lla­tata kaspa,","poem":1},{"lineBreak":true},{"text":"dil­tudupami mandanga­pa kangi,","poem":1},{"lineBreak":true},{"text":"maituku waranga waranga wata­kuna ialig­pi­pas.","poem":1},{"lineBreak":true},{"text":"Tukui imapipas alli­lla mandag­mi kangi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Alli­kunata­mi kuiar­kangi.","poem":1},{"lineBreak":true},{"text":"Ikuti mana alli­kuna­taka","poem":1},{"lineBreak":true},{"text":"mana munar­kangichu.","poem":1},{"lineBreak":true},{"text":"Chimandami kamba Taita Dius","poem":1},{"lineBreak":true},{"text":"kam Dius­lla­tata kas­kata agllarka.","poem":1},{"lineBreak":true},{"text":"Chi­wanka, kamta kara­mur­kami,","poem":1},{"lineBreak":true},{"text":"kamwa kag­kuna­manda­pas","poem":1},{"lineBreak":true},{"text":"mas alli iuia­chii­wa kan­ga­pa.","poem":1}]},{"type":"verse","number":10,"content":["Kasapasmi paita nirka:",{"text":"Kam Taitikumi kalla­ris­kapi","poem":1},{"lineBreak":true},{"text":"kai alpata rurar­kangi.","poem":1},{"lineBreak":true},{"text":"Kam­lla­tata­mi sug luar­ta­pas rurar­kangi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chi­kunaka, tukuimi puchuka­rin­ga­pa kan­kuna.","poem":1},{"lineBreak":true},{"text":"Ikuti kamka, ima­ura­pas kaug­sa­lla­mi kan­ga­pa kangi.","poem":1},{"lineBreak":true},{"text":"Tukui chi wiñas­ka­kunaka,","poem":1},{"lineBreak":true},{"text":"katanga rukuias­ka­sina­mi tukun­ga­pa kan­kuna.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Katangata pata­rig­sina­mi","poem":1},{"lineBreak":true},{"text":"ruran­ga­pa kangi sitan­ga­pa.","poem":1},{"lineBreak":true},{"text":"Maugka katangata sitaspa,","poem":1},{"lineBreak":true},{"text":"musu katanga chura­chig­sina­mi ruran­ga­pa kangi.","poem":1},{"lineBreak":true},{"text":"Chasa ruras­pa­pas, kam kikin­lla­ta­ta­mi kan­ga­pa kangi.","poem":1},{"lineBreak":true},{"text":"Ñi ima­ura­pas mana wañun­ga­pa kangichu.","poem":1}]},{"type":"verse","number":13,"content":["Ñi mai­kan anjil­ta­pas, Taita Dius mana ima­ura­pas kasa nirka­chu:",{"text":"Nuka­pa alli ladu tia­rii,","poem":1},{"lineBreak":true},{"text":"nuka tukui kamta mana munag­kunata apag­rispa,","poem":1},{"lineBreak":true},{"text":"kamba chaki saru­diru ukuma churan­kama.","poem":1}]},{"type":"verse","number":14,"content":["Tukui anjil­kunaka, ispi­ri­tu­kuna­lla­mi kan­kuna, Taita Dius ima munas­kata rurag­kuna. Pai­kuna kacha­mus­ka­mi kan­kuna, suma luarpi dil­tudupa kis­pi­rig­rin­ga­pa kag­kunata aidag kan­ga­pa."]}],"footnotes":[]},"thisChapterLink":"/api/inb_wbt/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/inb_wbt/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/inb_wbt/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}