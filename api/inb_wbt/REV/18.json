{"translation":{"id":"inb_wbt","name":"Kaipimi Taita Dius Rimaku","website":"https://ebible.org/Scriptures/details.php?id=inb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=inb","licenseNotes":null,"shortName":"WBT","englishName":"Inga NT","language":"inb","textDirection":"ltr","sha256":"97900b1384f886386ac88f4ea655f4c42422d7921684e847c7c041d4673ba4e1","availableFormats":["json"],"listOfBooksApiLink":"/api/inb_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7940,"languageName":"Inga","languageEnglishName":"Inga"},"book":{"id":"REV","translationId":"inb_wbt","name":"APOCALIPSIS","commonName":"APOCALIPSIS","title":"JESUCRISTO, IMA SAN JUANTA KAWACHISKAMANDA","order":66,"numberOfChapters":22,"sha256":"0f0bb2ed2787c9965cc43fd25dfb5241c44a3e93143447c92154267a477107f8","firstChapterNumber":1,"firstChapterApiLink":"/api/inb_wbt/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/inb_wbt/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":18,"content":[{"type":"heading","content":["Babi­lo­nia atun pui­blu justi­siai tukuska­manda"]},{"type":"verse","number":1,"content":["Chi­ura­mandaka sug iapa iacha anjil, suma luar­man­da urai­ku­mukug­ta­mi kawar­kani. Paipa suma pun­cha­ia­chii­waka kai alpa mas pun­cha­mi kawa­rig­sa­murka."]},{"type":"verse","number":2,"content":["Chi anjilka, sin­chi rimai­wa kapa­rirka, kasa nispa:",{"text":"—Babi­lo­nia suti atun pui­bluka ñami urmarka; ñami urmarka.","poem":1},{"lineBreak":true},{"text":"Tukui sug rig­cha sug rig­cha millan­ga­sina kuku waira kaug­sa­dirumi","poem":1},{"lineBreak":true},{"text":"chi atun pui­blu tukug­sa­murka.","poem":1},{"lineBreak":true},{"text":"Chi­lla­pita, tukui millan­ga­sina kuku pisku­kuna kaug­sa­diru­pas­mi tukug­samurka.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Chi pui­blupimi tukui alpa­manda kaug­sag­kunaka,","poem":1},{"lineBreak":true},{"text":"pai­wa binuta machagta upiag­sina ruraspa,","poem":1},{"lineBreak":true},{"text":"tukui jiru pan­da­rii­kunata ruraspa kaug­sar­ka­kuna.","poem":1},{"lineBreak":true},{"text":"Kai alpapi atun mandag­kuna­pas,","poem":1},{"lineBreak":true},{"text":"paiwami iapa pan­da­rii rurar­ka­kuna.","poem":1},{"lineBreak":true},{"text":"Chi pui­blu iapa iukag kas­ka­manda,","poem":1},{"lineBreak":true},{"text":"kai alpapi randispa katuspa purig­kuna­pas,","poem":1},{"lineBreak":true},{"text":"pai iapa ima munaska katui tias­ka­kuna­wa­mi","poem":1},{"lineBreak":true},{"text":"iapa iukag tukuska kar­ka­kuna.","poem":1}]},{"type":"verse","number":4,"content":["Chi­ura­mandaka, sug rimai suma luar­nig­manda uia­ri­warka, kasa nispa:",{"text":"—Nuka agllaska runa­kuna,","poem":1},{"lineBreak":true},{"text":"chi pui­blu­manda llug­sii­chi.","poem":1},{"lineBreak":true},{"text":"Chasaka kam­kuna,","poem":1},{"lineBreak":true},{"text":"chi pui­blu­manda pan­da­rii­kunapi","poem":1},{"lineBreak":true},{"text":"mana urman­kan­gi­chi­chu.","poem":1},{"lineBreak":true},{"text":"Llug­sigpi­kunaka,","poem":1},{"lineBreak":true},{"text":"chi pui­blupi iapa sin­chi llakii­kuna chaian­ga­pa kaskapas","poem":1},{"lineBreak":true},{"text":"mana kam­kunata chaian­ga­chu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chi pui­blu­manda pan­da­rii­kunaka,","poem":1},{"lineBreak":true},{"text":"iapa achkami mirarka.","poem":1},{"lineBreak":true},{"text":"Chi­wanka Taita Diuska,","poem":1},{"lineBreak":true},{"text":"chi pan­da­rii­kunata mana kunga­rin­ga­pa kan­chu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Imasami sug­kunata mana alli­lla rurarka:","poem":1},{"lineBreak":true},{"text":"kam­kuna­pas chasa­lla­ta","poem":1},{"lineBreak":true},{"text":"chaugpi iapa­wa paita kuti­chii­chi.","poem":1},{"lineBreak":true},{"text":"Pai imasa mana alli­lla ruras­kata iskaima randi­chii­chi.","poem":1},{"lineBreak":true},{"text":"Imasami sug­kunata llakii­kuna upia­chig­sina rurarka:","poem":1},{"lineBreak":true},{"text":"chasa­lla­ta paita iskaima mas timbu­ris­kata karai­chi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Imasami iapa iukag tukuspa,","poem":1},{"lineBreak":true},{"text":"sug­kunata unz̈arka:","poem":1},{"lineBreak":true},{"text":"chasa­lla­ta pai­ta­pas unz̈aspa","poem":1},{"lineBreak":true},{"text":"llaki­chispa nana­chii­chi.","poem":1},{"lineBreak":true},{"text":"Paipa iuiai­lla­pi­mi kasa iuiá:","poem":1},{"lineBreak":true},{"text":"“Nukami kani tukui­kunata mandaspa tia­kug.","poem":1},{"lineBreak":true},{"text":"Mana kusaiug warmi­sinaka","poem":1},{"lineBreak":true},{"text":"mana kaug­sa­ku­ni­chu.","poem":1},{"lineBreak":true},{"text":"Ima llakii­kuna­pas manima iukan­ga­pa ka­ni­chu”.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chasa iuia­kug­pi­pas,","poem":1},{"lineBreak":true},{"text":"suglla pun­cha­pi­mi","poem":1},{"lineBreak":true},{"text":"kasa paita samun­ga­pa ka:","poem":1},{"lineBreak":true},{"text":"sinchi llakii,","poem":1},{"lineBreak":true},{"text":"iarkai i wañuipas.","poem":1},{"lineBreak":true},{"text":"Nina­wapasmi","poem":1},{"lineBreak":true},{"text":"rupa­chii tukun­ga­pa ka.","poem":1},{"lineBreak":true},{"text":"Tukui pudig atun Taita Dius kikin­mi","poem":1},{"lineBreak":true},{"text":"chi pui­bluta jus­ti­siag­sa­murka.","poem":1}]},{"type":"verse","number":9,"content":["Kai alpapi atun mandag­kuna, chi pui­blu­wa iapa pan­da­rispa imasa munas­ka­sina iapa iukag tukus­ka­kuna, chi mandag­kunaka, chi pui­blu rupa­kus­kata, nina sindi kusni puiu­ia­kus­kata kawas­paka, iapa atun lla­kii­wa­mi wakaspa kan­ga­pa kan­kuna."]},{"type":"verse","number":10,"content":["Iapa manchai­wa­mi chi lla­kii­kunata karu­manda­lla kawa­na­kun­ga­pa kan­kuna, kasa nispa:",{"text":"—¡Ai, ai, tukui pudig atun pui­blu Babi­lo­nia­mi kar­kangi!","poem":1},{"lineBreak":true},{"text":"Suglla ura­lla­pi­mi","poem":1},{"lineBreak":true},{"text":"dil­tudu­pa llakin­ga­sina","poem":1},{"lineBreak":true},{"text":"jus­ti­siai tukur­kangi.","poem":1}]},{"type":"verse","number":11,"content":["Kai alpapi randispa katuspa purig­kuna­pas­mi chi pui­blu­manda iapa llaki­rispa wakan­ga­pa kan­kuna. Kuna­ura­mandaka, ñi pipas mana tian­ga­pa kan­kuna­chu, pai­kuna ima katun­ga­pa apa­mu­na­kus­kata randin­ga­pa."]},{"type":"verse","number":12,"content":["Kasa­mi apa­dur kar­ka­kuna: kuri, kulki, pirla i sug rig­cha iapa bali uchullita rumi­kuna, sida, pichi, puka i sug rig­cha iapa suma linu­kuna, tukui sug rig­cha sug rig­cha suma asna kaspi­kuna, mar­filta ruras­ka­kuna, iapa bali kas­pi­kuna, brunsi, iru, marmul suti iura rumi,"]},{"type":"verse","number":13,"content":["kanila, miski suma asnai asna­ri­kuna, mira suti i sug rig­cha asna kupal­kuna, suma asna­ia­chi­ri­diru tugtu iaku­kuna, binu, asiti, arina, trigu, apa­ri­chi­diru ani­mal­kuna, ubija­kuna, kaballu­kuna, kaba­llu­kuna aliu­diru augtu­kuna i randispa i katu­diru runa­kuna."]},{"type":"verse","number":14,"content":["Chi pui­bluta nin­ga­pa­mi kan­kuna:",{"text":"—Sacha­kuna­manda iapa miski muiu­kuna","poem":1},{"lineBreak":true},{"text":"chi­tuku muna­dur kar­kangi;","poem":1},{"lineBreak":true},{"text":"chi­kunaka ñami tuku­ri­pur­kangi.","poem":1},{"lineBreak":true},{"text":"Kam sumag­lla alli­chi­rispa chura­ri­diru­kuna,","poem":1},{"lineBreak":true},{"text":"suma mikui mikuspa kun­tin­tu­lla ka­diru,","poem":1},{"lineBreak":true},{"text":"tukui chi­kuna­mi puchu­ka­ri­pur­kangi.","poem":1},{"lineBreak":true},{"text":"Tukui ima iukaska, mana mas kawan­ga­pa kan­gi­chu.","poem":1}]},{"type":"verse","number":15,"content":["Imasami randispa katuspa purir­ka­kuna; chasa­waka, iapa iukag tukur­ka­kuna; chasa pui­bluta kawaspa, iapa manchai­wa­mi lla­kispa, karu­manda­lla kawa­na­kun­ga­pa kan­kuna. Iapa atun lla­kii­wa wakaspa kapa­rin­ga­pa­mi kan­kuna, kasa nispa:"]},{"type":"verse","number":16,"content":[{"text":"—¡Ai, ai, chi­tuku atun pui­blu­mi kar­kangi!","poem":1},{"lineBreak":true},{"text":"Pi­chi, puka i sug rig­cha sug rig­cha","poem":1},{"lineBreak":true},{"text":"iapa suma linsu katanga","poem":1},{"lineBreak":true},{"text":"chura­riska warmi­sina­mi rig­cha­kur­kangi.","poem":1},{"lineBreak":true},{"text":"Kuri, pirla i sug rig­cha sug rig­cha","poem":1},{"lineBreak":true},{"text":"iapa bali uchullita rumi­kuna­wa","poem":1},{"lineBreak":true},{"text":"alli­chi­ris­ka­mi kar­kangi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Chituku iapa iukai­kuna­pas,","poem":1},{"lineBreak":true},{"text":"mana unai­lla­mi tuku­ri­pur­kangi.","poem":1},"Chasa­lla­ta tukui barku­kunata man­dag­kuna, iaku pata pata rig­sispa puri­chig­kuna, barku­kunapi tra­ba­jag­kuna i tukui lamar iakupi chalwaspa purig­kuna, chi tukui­kuna­mi karu­manda­lla kawa­na­kurka."]},{"type":"verse","number":18,"content":["Chi pui­blu rupa­kus­kata, kusni nina sindi puiu­ia­kus­kata kawas­paka, kapa­rir­ka­kuna: —¿Mai­kan pui­blu­sik tia; kam atun pui­blu puchu­ka­ri­kungi: chasa?"]},{"type":"verse","number":19,"content":["Chasa kaparis­paka, dillakii alpa ñutu­chispa, umapi talli­rir­ka­kuna. Iapa atun llakii­wa wakaspa, kasa­pas­mi kapa­rir­ka­kuna:",{"text":"—¡Ai, ai! Kai atun pui­blupi iapa iukai­waka,","poem":1},{"lineBreak":true},{"text":"tukui barku iukag­kuna­pas­mi","poem":1},{"lineBreak":true},{"text":"iapa iukag tukug­samur­kan­chi.","poem":1},{"lineBreak":true},{"text":"Tukui ima iukai tiaska,","poem":1},{"lineBreak":true},{"text":"mana unaillami puchu­ka­rig­samurka.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ikuti kam­kuna Taita Dius­man­da­lla suma kaug­sag­kuna,","poem":1},{"lineBreak":true},{"text":"pai kikin agllaska runa­kuna","poem":1},{"lineBreak":true},{"text":"i Santu Ispi­ri­tu­wa rimag­kunaka,","poem":1},{"lineBreak":true},{"text":"sumag­lla alli iuia­chi­riilla","poem":1},{"lineBreak":true},{"text":"sug luarpi kai­chi,","poem":1},{"lineBreak":true},{"text":"chi pui­blu puchu­ka­ris­ka­manda.","poem":1},{"lineBreak":true},{"text":"Taita Diuska,","poem":1},{"lineBreak":true},{"text":"ñami kam­kuna­manda","poem":1},{"lineBreak":true},{"text":"alli­lla jus­ti­siai rurag­samurka.","poem":1}]},{"type":"verse","number":21,"content":["Chi­ura­mandaka sug iapa iacha anjilka, atun kutan­ga­sina rumita ata­ri­chispa, lamar iakuma sitamurka, kasa nispa:",{"text":"—Kasami Babi­lo­nia atun pui­blupas","poem":1},{"lineBreak":true},{"text":"diulpilla sitai tukun­ga­pa ka.","poem":1},{"lineBreak":true},{"text":"Chi­ura­mandaka, mana mas kawa­rin­ga­pa kan­chu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mana mas, kamba ñambi­kuna­pika,","poem":1},{"lineBreak":true},{"text":"arpa, flaugta i bututu","poem":1},{"lineBreak":true},{"text":"uia­rin­ga­pa kan­kuna­chu.","poem":1},{"lineBreak":true},{"text":"Ñi mai­kan ima rurai­kuna rura­dur­kuna­pas,","poem":1},{"lineBreak":true},{"text":"kamba pui­blupi mana mas kawa­rin­ga­pa kan­kuna­chu.","poem":1},{"lineBreak":true},{"text":"Ñi mai­kan rumipi kutag­kuna­pas","poem":1},{"lineBreak":true},{"text":"mana mas uiarin­ga­pa kan­kuna­chu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ñi ima punchaia­chi­dirupas","poem":1},{"lineBreak":true},{"text":"mana mas punchaia­chin­ga­pa tian­ga­pa kan­chu.","poem":1},{"lineBreak":true},{"text":"Mana mas kasaraipi kusi­ku­chi­na­kui atun pun­cha­sina tian­ga­pa kan­chu.","poem":1},{"lineBreak":true},{"text":"Kam­bagpi randispa katuspa purig­kunaka,","poem":1},{"lineBreak":true},{"text":"kai alpapi iapa pudig­kuna­mi kar­ka­kuna.","poem":1},{"lineBreak":true},{"text":"Kai alpapi kaug­sa­na­kus­kata,","poem":1},{"lineBreak":true},{"text":"tukui­kuna­ta­mi kamba jiru iachai­wa llulla­chig­samur­kangi.","poem":1}]},{"type":"verse","number":24,"content":["Santu Ispi­ri­tu­wa rimag­kuna, Taita Dius­manda­lla suma kaug­sag­kuna i sug­kuna kai alpapi wañu­chii tukus­ka­kuna­pas, tukui chi runa­kunapa iawarpas chi pui­blu­pi­mi kawa­rirka."]}],"footnotes":[]},"thisChapterLink":"/api/inb_wbt/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/inb_wbt/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/inb_wbt/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}