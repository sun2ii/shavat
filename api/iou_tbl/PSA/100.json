{"translation":{"id":"iou_tbl","name":"Tuma-Irumu","website":"https://ebible.org/Scriptures/details.php?id=iou","licenseUrl":"https://ebible.org/Scriptures/details.php?id=iou","licenseNotes":null,"shortName":"TBL","englishName":"Tuma-Irumu Bible","language":"iou","textDirection":"ltr","sha256":"e077618d65074ba485ce0c804b1d00aed8a3938fd24b8b4fcf763d0d9ee4c383","availableFormats":["json"],"listOfBooksApiLink":"/api/iou_tbl/books.json","numberOfBooks":30,"totalNumberOfChapters":464,"totalNumberOfVerses":11538,"languageName":"Tuma-Irumu","languageEnglishName":"Tuma-Irumu"},"book":{"id":"PSA","translationId":"iou_tbl","name":"Sam","commonName":"Sam","title":"Sam Juda nanik täŋo kap buk","order":19,"numberOfChapters":150,"sha256":"6f7a30fb588464fb0e60d1daa2d54f0874f1a7f1f0ae1ada76c431b2de25549e","firstChapterNumber":1,"firstChapterApiLink":"/api/iou_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/iou_tbl/PSA/150.json","totalNumberOfVerses":2392},"chapter":{"number":100,"content":[{"type":"heading","content":["Ämawebe, in äbä Anutu iniŋ orerut!"]},{"type":"verse","number":1,"content":[{"text":"Ämawebe uken-uken nanik, in kuduptagän oretoret gera terak Anutu iniŋoret täkot!","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Täŋpäŋ Anutu täŋo epän bänep pidäm terak täŋpäŋ kap teŋpäŋ iŋamiken kwawak äbut.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ekäni uwä Anutu itak u nadäwut! Keri terak ahäŋkumäŋo unita mäheminin ude itak. Täŋpäkaŋ ninä unitäŋo ämawebeniye.","poem":1},{"text":"Täŋkaŋ ninä yawakiye unita nibäŋ niwat täyak.","poem":4}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Eruk ämawebe, in kap teŋpäŋ iniŋ oretpäŋ Ekäni täŋo yotpärareken äbut! Täŋpäŋ bänep täga man iwetpäŋ wäpi yäpmäŋ akuwut!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Imata, Ekäni uwä tägagämän. Bänep ironi paot-paori nämo. Watä säkgämän pen api it nimiŋ yäpmäŋ ärowek.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/iou_tbl/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/iou_tbl/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/iou_tbl/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}