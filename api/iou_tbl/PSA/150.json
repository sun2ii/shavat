{"translation":{"id":"iou_tbl","name":"Tuma-Irumu","website":"https://ebible.org/Scriptures/details.php?id=iou","licenseUrl":"https://ebible.org/Scriptures/details.php?id=iou","licenseNotes":null,"shortName":"TBL","englishName":"Tuma-Irumu Bible","language":"iou","textDirection":"ltr","sha256":"e077618d65074ba485ce0c804b1d00aed8a3938fd24b8b4fcf763d0d9ee4c383","availableFormats":["json"],"listOfBooksApiLink":"/api/iou_tbl/books.json","numberOfBooks":30,"totalNumberOfChapters":464,"totalNumberOfVerses":11538,"languageName":"Tuma-Irumu","languageEnglishName":"Tuma-Irumu"},"book":{"id":"PSA","translationId":"iou_tbl","name":"Sam","commonName":"Sam","title":"Sam Juda nanik täŋo kap buk","order":19,"numberOfChapters":150,"sha256":"6f7a30fb588464fb0e60d1daa2d54f0874f1a7f1f0ae1ada76c431b2de25549e","firstChapterNumber":1,"firstChapterApiLink":"/api/iou_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/iou_tbl/PSA/150.json","totalNumberOfVerses":2392},"chapter":{"number":150,"content":[{"type":"heading","content":["Kap teŋkaŋ Anutu iniŋ oretna!"]},{"type":"verse","number":1,"content":[{"text":"Anutu wäpi yäpmäŋ akuwut!","poem":1},{"lineBreak":true},{"text":"Kudupi yori gänaŋ wäpi yäpmäŋ akukot. Ba kehäromi pähap ikek kunum gänaŋ itak ununita iniŋ orerut!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Epän taŋi täk täŋkuko unita oraŋ imina! U intäjukun äma pähap, wäpi biŋam ärowani nikek u iniŋ oretna!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Täŋpäŋ womat piäŋpäŋ uterak wäpi yäpmäŋ akuna! Ba gita utpäŋ uterak iniŋ oretna!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Täŋpäŋ wagäm utpäŋ kap teŋpäŋ gukut tokätpäŋ iniŋ oretna! Uhuwep piäŋkaŋ u kotäk terak wäpi yäpmäŋ akuna!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Päräpäräp täŋpäŋ däpäyäk ärena kwäpäŋ Anutu iniŋ oretna! Täŋpäŋ päräpäräp däpäyäk mämä taŋigän täŋpäŋ Anutu kunum gänaŋ unu iniŋ oretna!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kome terak imaka imaka irit kuŋat-kuŋat ikek in kuduptagän Ekäni wäpi yäpmäŋ akuwut!","poem":1},{"lineBreak":true},{"text":"Ekäni wäpi yäpmäŋ akuwut!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/iou_tbl/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/iou_tbl/MAT/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/iou_tbl/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}