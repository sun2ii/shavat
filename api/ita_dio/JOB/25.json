{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"JOB","translationId":"ita_dio","name":"GIOBBE","commonName":"GIOBBE","title":"IL LIBRO DI GIOBBE","order":18,"numberOfChapters":42,"sha256":"39b249db24f5aa36bc64bd48cc166834971bc5cebafb6518fd9c473c1affafc6","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/ita_dio/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":25,"content":[{"type":"heading","content":["Bildad mostra che l'uomo non può giustificarsi dinanzi a Dio"]},{"type":"verse","number":1,"content":["E BILDAD Suhita rispose, e disse:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["La signoria, e lo spavento, è con lui;",{"text":"Egli fa in pace ciò che gli piace ne' suoi cieli altissimi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Le sue schiere si posson esse annoverare?","poem":1},{"lineBreak":true},{"text":"E sopra cui non si leva la sua luce?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma come sarà giusto l'uomo appo Iddio?","poem":1},{"lineBreak":true},{"text":"E come sarà puro colui ch'è nato di donna?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ecco, fino alla luna non sarà pura, e non risplenderà;","poem":1},{"lineBreak":true},{"text":"E le stelle non saranno pure nel suo cospetto.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Quanto meno l'uomo, che è un verme,","poem":1},{"lineBreak":true},{"text":"E il figliuol dell'uomo, che è un vermicello?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}