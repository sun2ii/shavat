{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":1,"content":[{"type":"heading","content":["Felicità dei giusti; castigo degli empi"]},{"type":"verse","number":1,"content":[{"text":"BEATO l'uomo che non è camminato nel consiglio degli empi,","poem":1},{"lineBreak":true},{"text":"E non si è fermato nella via de' peccatori,","poem":1},{"lineBreak":true},{"text":"E non è seduto nella sedia degli schernitori.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Anzi il cui diletto è nella Legge del Signore,","poem":1},{"lineBreak":true},{"text":"E medita in essa giorno e notte.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Egli sarà come un albero piantato presso a ruscelli d'acque,","poem":1},{"lineBreak":true},{"text":"Il quale rende il suo frutto nella sua stagione,","poem":1},{"lineBreak":true},{"text":"E le cui frondi non appassano;","poem":1},{"lineBreak":true},{"text":"E tutto quello ch'egli farà, prospererà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Così non saranno già gli empi;","poem":1},{"lineBreak":true},{"text":"Anzi saranno come pula sospinta dal vento.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Perciò gli empi non istaranno ritti nel giudicio,","poem":1},{"lineBreak":true},{"text":"Nè i peccatori nella raunanza de' giusti.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Perciocchè il Signore conosce la via de' giusti;","poem":1},{"lineBreak":true},{"text":"Ma la via degli empi perirà.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}