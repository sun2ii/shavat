{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":101,"content":[{"type":"heading","content":["Davide promette a Dio di camminare in integrità e di opporsi ai malvagi"]},{"type":"hebrew_subtitle","content":["Salmo di Davide"]},{"type":"verse","number":1,"content":[{"text":"IO canterò un cantico di benignità e di giudicio;","poem":1},{"lineBreak":true},{"text":"Io te lo salmeggerò, o Signore.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Io comporrò una maestrevol canzone intorno alla via intiera.","poem":1},{"lineBreak":true},{"text":"Quando verrai a me?","poem":1},{"lineBreak":true},{"text":"Io camminerò nell'integrità del mio cuore","poem":1},{"lineBreak":true},{"text":"Dentro alla mia casa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Io non mi proporrò davanti agli occhi cosa alcuna scellerata;","poem":1},{"lineBreak":true},{"text":"Io odio i fatti degli sviati;","poem":1},{"lineBreak":true},{"text":"Niuno di essi mi starà appresso.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Il cuor perverso si dipartirà da me;","poem":1},{"lineBreak":true},{"text":"Io non conoscerò il malvagio.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Io sterminerò chi sparlerà in segreto contro al suo prossimo;","poem":1},{"lineBreak":true},{"text":"Io non comporterò l'uomo con gli occhi altieri,","poem":1},{"lineBreak":true},{"text":"E col cuor gonfio.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Io avrò l'occhio sugli uomini leali della terra","poem":1},{"lineBreak":true},{"text":"A ciò che dimorino meco;","poem":1},{"lineBreak":true},{"text":"Chi cammina per la via intiera mi servirà.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chi usa frode nelle sue opere non abiterà dentro alla mia casa;","poem":1},{"lineBreak":true},{"text":"Chi parla menzogne non sarà stabilito davanti agli occhi miei.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ogni mattina io distruggerò tutti gli empi del paese;","poem":1},{"lineBreak":true},{"text":"Per isterminar dalla Città del Signore","poem":1},{"lineBreak":true},{"text":"Tutti gli operatori d'iniquità.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}