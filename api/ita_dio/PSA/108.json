{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":108,"content":[{"type":"heading","content":["Davide loda Iddio per le vittorie concessegli"]},{"type":"hebrew_subtitle","content":["Cantico di Salmo di Davide"]},{"type":"verse","number":1,"content":[{"text":"IL mio cuore è disposto, o Dio,","poem":1},{"lineBreak":true},{"text":"Ed anche la mia gloria; io canterò, e salmeggerò.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Saltero, e cetera, destati;","poem":1},{"lineBreak":true},{"text":"Io mi risveglierò all'alba.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Io ti celebrerò fra i popoli, o Signore,","poem":1},{"lineBreak":true},{"text":"E ti salmeggerò fra le nazioni.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Perciocchè la tua benignità è grande, disopra il cielo;","poem":1},{"lineBreak":true},{"text":"E la tua verità aggiunge infino alle nuvole.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Innalzati, o Dio, sopra i cieli;","poem":1},{"lineBreak":true},{"text":"Ed innalzisi la tua gloria sopra tutta le terra;","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Acciocchè i tuoi diletti sieno liberati;","poem":1},{"lineBreak":true},{"text":"Salvami colla tua destra, e rispondimi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Iddio ha parlato per la sua santità; io trionferò,","poem":1},{"lineBreak":true},{"text":"Io spartirò Sichem, e misurerò la valle di Succot.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mio è Galaad, mio è Manasse;","poem":1},{"lineBreak":true},{"text":"Ed Efraim è la forza del mio capo;","poem":1},{"lineBreak":true},{"text":"Giuda è il mio legislatore;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Moab è la caldaia del mio lavatoio;","poem":1},{"lineBreak":true},{"text":"Io getterò le mie scarpe sopra Edom;","poem":1},{"lineBreak":true},{"text":"Io trionferò della Palestina con voci di allegrezza.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chi mi condurrà nella città della fortezza?","poem":1},{"lineBreak":true},{"text":"Chi mi menerà fino in Edom?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Non sarai desso tu, o Dio, che ci avevi scacciati,","poem":1},{"lineBreak":true},{"text":"E non uscivi più fuori, o Dio, co' nostri eserciti?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dacci aiuto, per uscir di distretta;","poem":1},{"lineBreak":true},{"text":"Perciocchè il soccorso degli uomini è vanità.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Coll'aiuto di Dio noi faremo prodezze;","poem":1},{"lineBreak":true},{"text":"Ed egli calpesterà i nostri nemici.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}