{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":11,"content":[{"type":"heading","content":["Dio salva i suoi, e punisce gli empi"]},{"type":"hebrew_subtitle","content":["Salmo di Davide, dato al Capo de' Musici"]},{"type":"verse","number":1,"content":[{"text":"IO mi confido nel Signore;","poem":1},{"lineBreak":true},{"text":"Come dite voi all'anima mia:","poem":1},{"lineBreak":true},{"text":"Fuggite al vostro monte, come un uccelletto?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Certo, ecco gli empi hanno teso l'arco,","poem":1},{"lineBreak":true},{"text":"Hanno accoccate le lor saette in su la corda,","poem":1},{"lineBreak":true},{"text":"Per tirarle contro a' diritti di cuore, in luogo scuro.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Quando i fondamenti son ruinati,","poem":1},{"lineBreak":true},{"text":"Che ha fatto il giusto?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Il Signore è nel Tempio della sua santità;","poem":1},{"lineBreak":true},{"text":"Il trono del Signore è ne' cieli;","poem":1},{"lineBreak":true},{"text":"I suoi occhi veggono,","poem":1},{"lineBreak":true},{"text":"Le sue palpebre esaminano i figliuoli degli uomini.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Il Signore esamina il giusto, e l'empio;","poem":1},{"lineBreak":true},{"text":"E l'anima sua odia colui che ama la violenza.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Egli farà piovere in su gli empi","poem":1},{"lineBreak":true},{"text":"Brace, e fuoco, e solfo,","poem":1},{"lineBreak":true},{"text":"E vento tempestoso, per la porzione del lor calice.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Perciocchè il Signore è giusto; egli ama la giustizia;","poem":1},{"lineBreak":true},{"text":"La sua faccia riguarda l'uomo diritto.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}