{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":110,"content":[{"type":"heading","content":["Il regno, il sacerdozio e le conquiste del Messia"]},{"type":"hebrew_subtitle","content":["Salmo di Davide"]},{"type":"verse","number":1,"content":[{"text":"IL Signore ha detto al mio Signore;","poem":1},{"lineBreak":true},{"text":"Siedi alla mia destra,","poem":1},{"lineBreak":true},{"text":"Infino a tanto che io abbia posti i tuoi nemici per iscannello de' tuoi piedi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Il Signore manderà fuor di Sion lo scettro della tua potenza,","poem":1},{"lineBreak":true},{"text":"Dicendo: Signoreggia in mezzo de' tuoi nemici.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Il tuo popolo sarà tutto volenteroso,","poem":1},{"lineBreak":true},{"text":"Nel giorno che tu rassegnerai il tuo esercito, nel magnifico santuario;","poem":1},{"lineBreak":true},{"text":"La rugiada della tua gioventù ti sarà prodotta dalla matrice dell'alba.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Il Signore ha giurato, e non si pentirà:","poem":1},{"lineBreak":true},{"text":"Tu sei sacerdote in eterno,","poem":1},{"lineBreak":true},{"text":"Secondo l'ordine di Melchisedec.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Il Signore sarà alla tua destra.","poem":1},{"lineBreak":true},{"text":"Questo mio Signore trafiggerà i re nel giorno della sua ira.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Egli farà giudicio fra le genti, egli empierà ogni cosa di corpi morti;","poem":1},{"lineBreak":true},{"text":"Egli trafiggerà il capo che regna sopra molti paesi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Egli berrà del torrente tra via;","poem":1},{"lineBreak":true},{"text":"E perciò alzerà il capo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}