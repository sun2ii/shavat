{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":111,"content":[{"type":"heading","content":["Dio lodato per le mirabili sue opere"]},{"type":"verse","number":1,"content":[{"text":"ALLELUIA.","poem":1},{"lineBreak":true},{"text":"Io celebrerò il Signore con tutto il cuore,","poem":1},{"lineBreak":true},{"text":"Nel consiglio, e nella raunanza degli uomini diritti.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Grandi son le opere del Signore,","poem":1},{"lineBreak":true},{"text":"Spiegate davanti a tutti quelli che si dilettano in esse.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Le sue opere son gloria e magnificenza;","poem":1},{"lineBreak":true},{"text":"E la sua giustizia dimora in eterno.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Egli ha rendute memorabili le sue maraviglie;","poem":1},{"lineBreak":true},{"text":"Il Signore è grazioso e pietoso.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Egli dà da vivere a quelli che lo temono;","poem":1},{"lineBreak":true},{"text":"Egli si ricorda in eterno del suo patto.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Egli ha dichiarata al suo popolo la potenza delle sue opere,","poem":1},{"lineBreak":true},{"text":"Dandogli l'eredità delle genti.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Le opere delle sue mani son verità e dirittura;","poem":1},{"lineBreak":true},{"text":"Tutti i suoi comandamenti son veraci;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Stabili in sempiterno,","poem":1},{"lineBreak":true},{"text":"Fatti con verità, e con dirittura.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Egli ha mandata la redenzione al suo popolo;","poem":1},{"lineBreak":true},{"text":"Egli ha ordinato il suo patto in eterno;","poem":1},{"lineBreak":true},{"text":"Il suo Nome è santo e tremendo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Il principio della sapienza è il timor del Signore;","poem":1},{"lineBreak":true},{"text":"Ogni uomo che mette in opera i suoi comandamenti, ha buon senno;","poem":1},{"lineBreak":true},{"text":"La sua lode dimora in perpetuo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}