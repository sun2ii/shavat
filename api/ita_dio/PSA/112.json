{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":112,"content":[{"type":"heading","content":["Felicità di chi teme Iddio"]},{"type":"verse","number":1,"content":[{"text":"ALLELUIA,","poem":1},{"lineBreak":true},{"text":"Beato l'uomo che teme il Signore,","poem":1},{"lineBreak":true},{"text":"E si diletta sommamente ne' suoi comandamenti.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"La sua progenie sarà possente in terra;","poem":1},{"lineBreak":true},{"text":"La generazione degli uomini diritti sarà benedetta.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Facoltà e ricchezze son nella sua casa,","poem":1},{"lineBreak":true},{"text":"E la sua giustizia dimora in perpetuo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"La luce si leva nelle tenebre a quelli che son diritti.","poem":1},{"lineBreak":true},{"text":"Un tale uomo è pietoso, misericordioso, e giusto.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"L'uomo da bene dona, e presta;","poem":1},{"lineBreak":true},{"text":"E governa i fatti suoi con dirittura.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Certo egli non sarà giammai smosso;","poem":1},{"lineBreak":true},{"text":"Il giusto sarà in memoria perpetua.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Egli non temerà di mal grido;","poem":1},{"lineBreak":true},{"text":"Il suo cuore è fermo, egli si confida nel Signore.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Il suo cuore è bene appoggiato, egli non avrà paura alcuna,","poem":1},{"lineBreak":true},{"text":"Finchè vegga ne' suoi nemici ciò ch'egli desidera.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Egli ha sparso, egli ha donato a' bisognosi;","poem":1},{"lineBreak":true},{"text":"La sua giustizia dimora in perpetuo,","poem":1},{"lineBreak":true},{"text":"Il suo corno sarà alzato in gloria.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"L'empio lo vedrà, e dispetterà;","poem":1},{"lineBreak":true},{"text":"Egli digrignerà i denti, e si struggerà;","poem":1},{"lineBreak":true},{"text":"Il desiderio degli empi perirà.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}