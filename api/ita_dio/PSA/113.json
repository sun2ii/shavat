{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":113,"content":[{"type":"heading","content":["Dio lodato per la sua grandezza e la sua bontà verso i poveri"]},{"type":"verse","number":1,"content":[{"text":"ALLELUIA.","poem":1},{"lineBreak":true},{"text":"Lodate, servitori del Signore,","poem":1},{"lineBreak":true},{"text":"Lodate il Nome del Signore.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sia benedetto il nome del Signore,","poem":1},{"lineBreak":true},{"text":"Da ora in eterno.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Il nome del Signore è lodato","poem":1},{"lineBreak":true},{"text":"Dal sol levante, infino al ponente.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Il Signore è eccelso sopra tutte le nazioni,","poem":1},{"lineBreak":true},{"text":"La sua gloria è sopra i cieli.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Chi è simile al Signore Iddio nostro,","poem":1},{"lineBreak":true},{"text":"Il quale abita ne' luoghi altissimi?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Che riguarda abbasso","poem":1},{"lineBreak":true},{"text":"In cielo ed in terra;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Che rileva il misero dalla polvere,","poem":1},{"lineBreak":true},{"text":"Ed innalza il povero dallo sterco;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Per farlo sedere co' principi,","poem":1},{"lineBreak":true},{"text":"Co' principi del suo popolo;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Che fa abitare in famiglia la donna sterile,","poem":1},{"lineBreak":true},{"text":"Facendola diventar lieta madre di figliuoli?","poem":1},{"lineBreak":true},{"text":"Alleluia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}