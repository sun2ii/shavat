{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":114,"content":[{"type":"heading","content":["Il Salmista celebra il passo miracoloso del Mar rosso e del Giordano"]},{"type":"verse","number":1,"content":[{"text":"QUANDO Israele uscì di Egitto,","poem":1},{"lineBreak":true},{"text":"E la casa di Giacobbe d'infra il popolo barbaro;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Giuda fu consacrato al Signore,","poem":1},{"lineBreak":true},{"text":"Israele divenne suo dominio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Il mare lo vide, e fuggì;","poem":1},{"lineBreak":true},{"text":"Il Giordano si rivolse a ritroso.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I monti saltarono come montoni,","poem":1},{"lineBreak":true},{"text":"I colli come agnelli.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Che avesti, o mare, che tu fuggisti?","poem":1},{"lineBreak":true},{"text":"E tu, Giordano, che ti rivolgesti a ritroso?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E voi, monti, che saltaste come montoni;","poem":1},{"lineBreak":true},{"text":"E voi, colli, come agnelli?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Trema, o terra, per la presenza del Signore;","poem":1},{"lineBreak":true},{"text":"Per la presenza dell'Iddio di Giacobbe;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Il quale mutò la roccia in guazzo d'acqua,","poem":1},{"lineBreak":true},{"text":"Il macigno in fonte d'acqua.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}