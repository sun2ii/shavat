{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":115,"content":[{"type":"heading","content":["La gloria del Signore e la vanità degli idoli. Esortazione a fidare in Dio solo"]},{"type":"verse","number":1,"content":[{"text":"NON a noi, Signore, non a noi,","poem":1},{"lineBreak":true},{"text":"Anzi al tuo Nome, da' gloria,","poem":1},{"lineBreak":true},{"text":"Per la tua benignità, e verità.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Perchè direbbero le genti:","poem":1},{"lineBreak":true},{"text":"Dove è ora l'Iddio loro?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Or l'Iddio nostro è pur ne' cieli","poem":1},{"lineBreak":true},{"text":"E fa tutto ciò che gli piace.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Gl'idoli di quelle sono oro ed argento;","poem":1},{"lineBreak":true},{"text":"Opera di mani d'uomini;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hanno bocca, e non parlano;","poem":1},{"lineBreak":true},{"text":"Hanno occhi, e non veggono;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hanno orecchie, e non odono;","poem":1},{"lineBreak":true},{"text":"Hanno naso, e non odorano;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hanno mani, e non toccano;","poem":1},{"lineBreak":true},{"text":"Hanno piedi, e non camminano;","poem":1},{"lineBreak":true},{"text":"E non rendono alcun suono dalla lor gola.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Simili ad essi sieno quelli che li fanno;","poem":1},{"lineBreak":true},{"text":"Chiunque si confida in essi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"O Israele, confidati nel Signore;","poem":1},{"lineBreak":true},{"text":"Egli è l'aiuto, e lo scudo di quelli che si confidano in lui.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"O casa d'Aaronne, confidatevi, nel Signore;","poem":1},{"lineBreak":true},{"text":"Egli è l'aiuto, e lo scudo di quelli che si confidano in lui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"O voi che temete il Signore, confidatevi in lui;","poem":1},{"lineBreak":true},{"text":"Egli è l'aiuto, e lo scudo di quelli che si confidano in lui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Il Signore si ricorda di noi; egli ci benedirà;","poem":1},{"lineBreak":true},{"text":"Egli benedirà la casa d'Israele;","poem":1},{"lineBreak":true},{"text":"Egli benedirà la casa d'Aaronne.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Egli benedirà quelli che lo temono,","poem":1},{"lineBreak":true},{"text":"Piccoli e grandi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Il Signore vi accrescerà le sue grazie,","poem":1},{"lineBreak":true},{"text":"A voi, ed a' vostri figliuoli.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Voi siete benedetti dal Signore","poem":1},{"lineBreak":true},{"text":"Che ha fatto il cielo e la terra.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Quant'è al cielo, il cielo è per lo Signore;","poem":1},{"lineBreak":true},{"text":"Ma egli ha data la terra a' figliuoli degli uomini.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"I morti non loderanno già il Signore,","poem":1},{"lineBreak":true},{"text":"Nè alcun di quelli che scendono nel luogo del silenzio.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ma noi benediremo il Signore,","poem":1},{"lineBreak":true},{"text":"Da ora in eterno.","poem":1},{"lineBreak":true},{"text":"Alleluia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}