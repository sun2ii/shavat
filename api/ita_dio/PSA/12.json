{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":12,"content":[{"type":"heading","content":["Menzogne degli uomini; veracità di Dio"]},{"type":"hebrew_subtitle","content":["Salmo di Davide, dato al Capo de' Musici, sopra Seminit"]},{"type":"verse","number":1,"content":[{"text":"SALVA, Signore; perciocchè gli uomini pii son venuti meno,","poem":1},{"lineBreak":true},{"text":"Ed i veraci son mancati fra i figliuoli degli uomini.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ciascuno parla con menzogna col suo prossimo,","poem":1},{"lineBreak":true},{"text":"Con labbra lusinghiere;","poem":1},{"lineBreak":true},{"text":"Parlano con un cuor doppio.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Il Signore ricida tutte le labbra lusinghiere,","poem":1},{"lineBreak":true},{"text":"La lingua che parla altieramente;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Di coloro che dicono: Noi sarem padroni colle nostre lingue;","poem":1},{"lineBreak":true},{"text":"Le nostre labbra sono appo noi;","poem":1},{"lineBreak":true},{"text":"Chi è signore sopra noi?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Per la desolazione de' poveri afflitti, per le strida de' bisognosi,","poem":1},{"lineBreak":true},{"text":"Ora mi leverò, dice il Signore;","poem":1},{"lineBreak":true},{"text":"Io metterò in salvo quelli contro a cui coloro parlano audacemente.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Le parole del Signore son parole pure,","poem":1},{"lineBreak":true},{"text":"Argento affinato nel fornello di terra,","poem":1},{"lineBreak":true},{"text":"Purgato per sette volte.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tu, Signore, guarda coloro;","poem":1},{"lineBreak":true},{"text":"Preservali da questa generazione in perpetuo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gli empi vanno attorno,","poem":1},{"lineBreak":true},{"text":"Quando i più vili d'infra i figliuoli degli uomini sono innalzati.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}