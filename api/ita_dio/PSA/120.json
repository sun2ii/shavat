{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":120,"content":[{"type":"heading","content":["Preghiera per venir liberato dalle frodi e dalle calunnie"]},{"type":"hebrew_subtitle","content":["Cantico di Maalot"]},{"type":"verse","number":1,"content":[{"text":"IO ho gridato al Signore, quando sono stato in distretta,","poem":1},{"lineBreak":true},{"text":"Ed egli mi ha risposto.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O Signore, riscuoti l'anima mia dalle labbra bugiarde,","poem":1},{"lineBreak":true},{"text":"E dalla lingua frodolente.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Che ti darà, e che ti aggiungerà","poem":1},{"lineBreak":true},{"text":"La lingua frodolente?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ella è simile a saette acute, tratte da un uomo prode;","poem":1},{"lineBreak":true},{"text":"Ovvero anche a brace di ginepro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ahimè! che soggiorno in Mesec,","poem":1},{"lineBreak":true},{"text":"E dimoro presso alle tende di Chedar!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"La mia persona è omai assai dimorata","poem":1},{"lineBreak":true},{"text":"Con quelli che odiano la pace.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Io sono uomo di pace; ma, quando ne parlo,","poem":1},{"lineBreak":true},{"text":"Essi gridano alla guerra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}