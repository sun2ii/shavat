{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":122,"content":[{"type":"heading","content":["Preghiera per la pace di Gerusalemme"]},{"type":"hebrew_subtitle","content":["Cantico di Maalot, di Davide"]},{"type":"verse","number":1,"content":[{"text":"IO mi son rallegrato di ciò che mi è stato detto:","poem":1},{"lineBreak":true},{"text":"Andiamo alla Casa del Signore.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O Gerusalemme,","poem":1},{"lineBreak":true},{"text":"I nostri piedi son fermi nelle tue porte.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gerusalemme, che sei edificata","poem":1},{"lineBreak":true},{"text":"Come una città che è ben congiunta insieme.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Là ove salgono le tribù, le tribù del Signore,","poem":1},{"lineBreak":true},{"text":"Alla Testimonianza d'Israele,","poem":1},{"lineBreak":true},{"text":"Per celebrare il Nome del Signore,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Perciocchè quivi son posti i seggi per lo giudicio,","poem":1},{"lineBreak":true},{"text":"I seggi della Casa di Davide.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Richiedete la pace di Gerusalemme;","poem":1},{"lineBreak":true},{"text":"O Gerusalemme, prosperino quelli che ti amano.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pace sia nelle tue fortezze,","poem":1},{"lineBreak":true},{"text":"E tranquillità ne' tuoi palazzi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Per amor de' miei fratelli e de' miei prossimi,","poem":1},{"lineBreak":true},{"text":"Io dirò ora: Pace sia in te.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Per amor della Casa del Signore Iddio nostro,","poem":1},{"lineBreak":true},{"text":"Io procaccerò il tuo bene.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}