{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":124,"content":[{"type":"heading","content":["Dio solo ha liberato il suo popolo"]},{"type":"hebrew_subtitle","content":["Cantico di Maalot, di Davide"]},{"type":"verse","number":1,"content":[{"text":"DICA pure ora Israele:","poem":1},{"lineBreak":true},{"text":"Se non che il Signore fu per noi;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Se non che il Signore fu per noi,","poem":1},{"lineBreak":true},{"text":"Quando gli uomini si levarono contro a noi;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Essi ci avrebbero tranghiottiti tutti vivi,","poem":1},{"lineBreak":true},{"text":"Allora che l'ira loro ardeva contro a noi;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Allora le acque ci avrebbero inondati;","poem":1},{"lineBreak":true},{"text":"Il torrente sarebbe passato sopra l'anima nostra;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Allora le acque gonfiate","poem":1},{"lineBreak":true},{"text":"Sarebbero passate sopra l'anima nostra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Benedetto sia il Signore,","poem":1},{"lineBreak":true},{"text":"Che non ci ha dati in preda a' lor denti.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"L'anima nostra è scampata dal laccio degli uccellatori, come un uccelletto;","poem":1},{"lineBreak":true},{"text":"Il laccio è stato rotto, e noi siamo scampati.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Il nostro aiuto è nel Nome del Signore,","poem":1},{"lineBreak":true},{"text":"Che ha fatto il cielo e la terra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}