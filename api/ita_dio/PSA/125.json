{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":125,"content":[{"type":"heading","content":["Sicurtà di chi fida in Dio"]},{"type":"hebrew_subtitle","content":["Cantico di Maalot"]},{"type":"verse","number":1,"content":[{"text":"QUELLI che si confidano nel Signore,","poem":1},{"lineBreak":true},{"text":"Son come il monte di Sion, il quale non può essere smosso,","poem":1},{"lineBreak":true},{"text":"E che dimora in perpetuo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Come Gerusalemme è intorniata di monti,","poem":1},{"lineBreak":true},{"text":"Così il Signore è intorno al suo popolo,","poem":1},{"lineBreak":true},{"text":"Da ora in eterno.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Perciocchè la verga d'empietà non riposerà in perpetuo","poem":1},{"lineBreak":true},{"text":"Sopra la sorte de' giusti;","poem":1},{"lineBreak":true},{"text":"Acciocchè talora i giusti non mettano le lor mani ad alcuna iniquità.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"O Signore, fa' bene a' buoni,","poem":1},{"lineBreak":true},{"text":"Ed a quelli che son diritti ne' lor cuori.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma, quant'è a quelli che deviano dietro alle loro obliquità,","poem":1},{"lineBreak":true},{"text":"Scaccili il Signore con gli operatori d'iniquità.","poem":1},{"lineBreak":true},{"text":"Pace sia sopra Israele.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}