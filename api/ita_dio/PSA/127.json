{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":127,"content":[{"type":"heading","content":["La sicurezza, la prosperità e la prole vengono da Dio solo"]},{"type":"hebrew_subtitle","content":["Cantico di Maalot, di Salomone"]},{"type":"verse","number":1,"content":[{"text":"SE il Signore non edifica la casa,","poem":1},{"lineBreak":true},{"text":"In vano vi si affaticano gli edificatori;","poem":1},{"lineBreak":true},{"text":"Se il Signore non guarda la città,","poem":1},{"lineBreak":true},{"text":"In vano vegghiano le guardie.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Voi che vi levate la mattina a buon'ora, e tardi vi posate,","poem":1},{"lineBreak":true},{"text":"E mangiate il pane di doglie, in vano il fate;","poem":1},{"lineBreak":true},{"text":"In luogo di ciò, Iddio dà il sonno a colui ch'egli ama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ecco, i figliuoli sono una eredità del Signore;","poem":1},{"lineBreak":true},{"text":"Il frutto del ventre è un premio.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Quali son le saette in mano d'un valent'uomo,","poem":1},{"lineBreak":true},{"text":"Tali sono i figliuoli in giovanezza.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Beato l'uomo che ne ha il suo turcasso pieno;","poem":1},{"lineBreak":true},{"text":"Tali non saranno confusi,","poem":1},{"lineBreak":true},{"text":"Quando parleranno co' lor nemici nella porta.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}