eak":true},{"text":"L'uomo che teme il Signore.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Il Signore ti benedirà di Sion;","poem":1},{"lineBreak":true},{"text":"E tu vedrai il bene di Gerusalemme","poem":1},{"lineBreak":true},{"text":"Tutti i giorni della tua vita;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E vedrai i figliuoli de' tuoi figliuoli.","poem":1},{"lineBreak":true},{"text":"Pace sia sopra Israele.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}