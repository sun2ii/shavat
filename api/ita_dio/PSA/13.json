{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":13,"content":[{"type":"heading","content":["Ricorso a Dio nella più estrema angoscia; giuliva fiducia in lui"]},{"type":"hebrew_subtitle","content":["Salmo di Davide, dato al Capo de' Musici"]},{"type":"verse","number":1,"content":[{"text":"INFINO a quando, o Signore? mi dimenticherai tu in perpetuo?","poem":1},{"lineBreak":true},{"text":"Infino a quando nasconderai la tua faccia da me?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Infino a quando non farò altro tuttodì che consigliar nell'animo,","poem":1},{"lineBreak":true},{"text":"Ed affannarmi nel cuore?","poem":1},{"lineBreak":true},{"text":"Infino a quando s'innalzerà il mio nemico sopra me?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Riguarda, rispondimi, Signore Iddio mio;","poem":1},{"lineBreak":true},{"text":"Illumina gli occhi miei,","poem":1},{"lineBreak":true},{"text":"Che talora io non dorma il sonno della morte;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Che il mio nemico non dica: Io l'ho vinto;","poem":1},{"lineBreak":true},{"text":"E che i miei nemici non festeggino, se io caggio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ora, quant'è a me, io mi confido nella tua benignità;","poem":1},{"lineBreak":true},{"text":"Il mio cuore giubilerà nella tua liberazione;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Io canterò al Signore, perciocchè egli mi avrà fatta la mia retribuzione.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}