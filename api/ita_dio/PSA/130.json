{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":130,"content":[{"type":"heading","content":["Confessione dei peccati. Domanda di perdono"]},{"type":"hebrew_subtitle","content":["Cantico di Maalot"]},{"type":"verse","number":1,"content":[{"text":"SIGNORE, io grido a te di luoghi profondi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Signore, ascolta il mio grido;","poem":1},{"lineBreak":true},{"text":"Sieno le tue orecchie attente","poem":1},{"lineBreak":true},{"text":"Alla voce delle mie supplicazioni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Signore, se tu poni mente alle iniquità,","poem":1},{"lineBreak":true},{"text":"Chi potrà durare, o Signore?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma appo te vi è perdono,","poem":1},{"lineBreak":true},{"text":"Acciocchè tu sii temuto.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Io ho aspettato il Signore; l'anima mia l'ha aspettato,","poem":1},{"lineBreak":true},{"text":"Ed io ho sperato nella sua parola.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"L'anima mia riguarda al Signore,","poem":1},{"lineBreak":true},{"text":"Più che le guardie non riguardano alla mattina,","poem":1},{"lineBreak":true},{"text":"Stando a guardar quando verrà la mattina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Aspetti Israele il Signore;","poem":1},{"lineBreak":true},{"text":"Perciocchè appo il Signore vi è benignità,","poem":1},{"lineBreak":true},{"text":"E molta redenzione.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ed egli riscatterà Israele","poem":1},{"lineBreak":true},{"text":"Di tutte le sue iniquità.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}