{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":137,"content":[{"type":"heading","content":["Lamento d'Israele nella cattività"]},{"type":"verse","number":1,"content":[{"text":"ESSENDO presso alle fiumane di Babilonia,","poem":1},{"lineBreak":true},{"text":"Dove noi sedevamo, ed anche piangevamo,","poem":1},{"lineBreak":true},{"text":"Ricordandoci di Sion,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Noi avevamo appese le nostre cetere","poem":1},{"lineBreak":true},{"text":"A' salci, in mezzo di essa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Benchè quelli che ci avevano menati in cattività","poem":1},{"lineBreak":true},{"text":"Ci richiedessero quivi che cantassimo;","poem":1},{"lineBreak":true},{"text":"E quelli che ci facevano urlar piangendo","poem":1},{"lineBreak":true},{"text":"Ci richiedessero canzoni d'allegrezza, dicendo:","poem":1},{"lineBreak":true},{"text":"Cantateci delle canzoni di Sion;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Come avremmo noi cantate le canzoni del Signore","poem":1},{"lineBreak":true},{"text":"In paese di stranieri?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Se io ti dimentico, o Gerusalemme;","poem":1},{"lineBreak":true},{"text":"Se la mia destra ti dimentica;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Resti attaccata la mia lingua al mio palato,","poem":1},{"lineBreak":true},{"text":"Se io non mi ricordo di te;","poem":1},{"lineBreak":true},{"text":"Se non metto Gerusalemme","poem":1},{"lineBreak":true},{"text":"In capo d'ogni mia allegrezza","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ricordati, Signore, de' figliuoli di Edom,","poem":1},{"lineBreak":true},{"text":"I quali, nella giornata di Gerusalemme,","poem":1},{"lineBreak":true},{"text":"Dicevano: Spianate, spianate,","poem":1},{"lineBreak":true},{"text":"Fino a' fondamenti.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O figliuola di Babilonia, che devi esser distrutta,","poem":1},{"lineBreak":true},{"text":"Beato chi ti farà la retribuzione","poem":1},{"lineBreak":true},{"text":"Del male che tu ci hai fatto!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Beato chi piglierà i tuoi piccoli figliuoli,","poem":1},{"lineBreak":true},{"text":"E li sbatterà al sasso.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}