{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":138,"content":[{"type":"heading","content":["Ringraziamento a Dio per la sua fedeltà. Tutti i re lo loderanno"]},{"type":"hebrew_subtitle","content":["Salmo di Davide"]},{"type":"verse","number":1,"content":[{"text":"IO ti celebrerò con tutto il mio cuore;","poem":1},{"lineBreak":true},{"text":"Io ti salmeggerò davanti agli Angeli.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Io adorerò verso il Tempio della tua santità,","poem":1},{"lineBreak":true},{"text":"E celebrerò il tuo Nome, per la tua benignità, e per la tua verità;","poem":1},{"lineBreak":true},{"text":"Perciocchè tu hai magnificata la tua parola, sopra ogni tua fama.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nel giorno che io ho gridato, tu mi hai risposto;","poem":1},{"lineBreak":true},{"text":"Tu mi hai accresciuto di forze nell'anima mia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tutti i re della terra ti celebreranno, Signore,","poem":1},{"lineBreak":true},{"text":"Quando avranno udite le parole della tua bocca;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E canteranno delle vie del Signore;","poem":1},{"lineBreak":true},{"text":"Conciossiachè grande sia la gloria del Signore.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Perciocchè il Signore è eccelso, e riguarda le cose basse;","poem":1},{"lineBreak":true},{"text":"E conosce da lungi l'altiero.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Se io cammino in mezzo di distretta, tu mi manterrai in vita;","poem":1},{"lineBreak":true},{"text":"Tu stenderai la mano sopra la faccia de' miei nemici,","poem":1},{"lineBreak":true},{"text":"E la tua destra mi salverà.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Il Signore compierà l'opera sua intorno a me;","poem":1},{"lineBreak":true},{"text":"O Signore, la tua benignità è in eterno;","poem":1},{"lineBreak":true},{"text":"Non lasciar le opere delle tue mani.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}