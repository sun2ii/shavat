uno.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tutti questi operatori d'iniquità son essi senza intelletto?","poem":1},{"lineBreak":true},{"text":"Essi mangiano il mio popolo, come se mangiassero del pane,","poem":1},{"lineBreak":true},{"text":"E non invocano il Signore.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Là saranno spaventati di grande spavento;","poem":1},{"lineBreak":true},{"text":"Perciocchè Iddio è colla gente giusta.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fate voi onta al consiglio del povero afflitto,","poem":1},{"lineBreak":true},{"text":"Perciocchè il Signore è la sua confidanza?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Oh! venga pur da Sion la salute d'Israele!","poem":1},{"lineBreak":true},{"text":"Quando il Signore ritrarrà di cattività il suo popolo,","poem":1},{"lineBreak":true},{"text":"Giacobbe festeggerà, Israele si rallegrerà.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}