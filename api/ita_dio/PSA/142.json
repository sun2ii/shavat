{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":142,"content":[{"type":"heading","content":["Preghiera in pericolo estremo"]},{"type":"hebrew_subtitle","content":["Maschil di Davide; orazione ch'egli fece, quando era nella spelonca"]},{"type":"verse","number":1,"content":[{"text":"IO grido colla mia voce al Signore;","poem":1},{"lineBreak":true},{"text":"Io supplico al Signore colla mia voce.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Io spando la mia orazione davanti a lui;","poem":1},{"lineBreak":true},{"text":"Io racconto davanti a lui la mia tribolazione,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mentre lo spirito mio spasima in me.","poem":1},{"lineBreak":true},{"text":"Or tu, Signore, conosci il mio sentiero.","poem":1},{"lineBreak":true},{"text":"Essi mi hanno nascosto un laccio","poem":1},{"lineBreak":true},{"text":"In su la via, per la quale ho da camminare.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Io riguardo a destra, e miro;","poem":1},{"lineBreak":true},{"text":"E non vi è alcuno che mi riconosca;","poem":1},{"lineBreak":true},{"text":"Ogni rifugio è perduto per me;","poem":1},{"lineBreak":true},{"text":"Non vi è alcuno che abbia cura dell'anima mia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"O Signore, io grido a te;","poem":1},{"lineBreak":true},{"text":"Io dico: Tu sei il mio ricetto,","poem":1},{"lineBreak":true},{"text":"La mia parte nella terra de' viventi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Attendi al mio gridare;","poem":1},{"lineBreak":true},{"text":"Perciocchè io son ridotto in molto misero stato;","poem":1},{"lineBreak":true},{"text":"Riscuotimi da quelli che mi perseguitano;","poem":1},{"lineBreak":true},{"text":"Perciocchè son più possenti di me.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tira fuor di carcere l'anima mia,","poem":1},{"lineBreak":true},{"text":"Acciocchè io celebri il tuo Nome;","poem":1},{"lineBreak":true},{"text":"I giusti m'intonieranno,","poem":1},{"lineBreak":true},{"text":"Quando tu mi avrai fatta la mia retribuzione.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}