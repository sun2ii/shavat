{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":146,"content":[{"type":"heading","content":["Fralezza dell'uomo; fedeltà di Dio"]},{"type":"verse","number":1,"content":[{"text":"ALLELUIA.","poem":1},{"lineBreak":true},{"text":"Anima mia, loda il Signore.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Io loderò il Signore, mentre viverò;","poem":1},{"lineBreak":true},{"text":"Io salmeggerò al mio Dio, mentre durerò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Non vi confidate in principi,","poem":1},{"lineBreak":true},{"text":"Nè in alcun figliuol d'uomo, che non ha modo di salvare.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Il suo fiato uscirà, ed egli se ne ritornerà nella sua terra;","poem":1},{"lineBreak":true},{"text":"In quel dì periranno i suoi disegni.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Beato colui che ha l'Iddio di Giacobbe in suo aiuto,","poem":1},{"lineBreak":true},{"text":"La cui speranza è nel Signore Iddio suo","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Il quale ha fatto il cielo e la terra,","poem":1},{"lineBreak":true},{"text":"Il mare, e tutto ciò ch'è in essi;","poem":1},{"lineBreak":true},{"text":"Che osserva la fede in eterno;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Il qual fa ragione agli oppressati;","poem":1},{"lineBreak":true},{"text":"E dà del cibo agli affamati.","poem":1},{"lineBreak":true},{"text":"Il Signore scioglie i prigioni.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Il Signore apre gli occhi a' ciechi;","poem":1},{"lineBreak":true},{"text":"Il Signore rileva quelli che son chinati;","poem":1},{"lineBreak":true},{"text":"Il Signore ama i giusti.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Il Signore guarda i forestieri;","poem":1},{"lineBreak":true},{"text":"Egli solleva l'orfano e la vedova;","poem":1},{"lineBreak":true},{"text":"E sovverte la via degli empi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Il Signore regna in eterno,","poem":1},{"lineBreak":true},{"text":"E il tuo Dio, o Sion, per ogni età.","poem":1},{"lineBreak":true},{"text":"Alleluia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}