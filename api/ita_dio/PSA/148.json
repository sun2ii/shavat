{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":148,"content":[{"type":"heading","content":["L'intero creato lodi il Signore"]},{"type":"verse","number":1,"content":[{"text":"ALLELUIA.","poem":1},{"lineBreak":true},{"text":"Lodate il Signore dal cielo;","poem":1},{"lineBreak":true},{"text":"Lodatelo ne' luoghi altissimi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lodatelo voi, suoi Angeli tutti.","poem":1},{"lineBreak":true},{"text":"Lodatelo voi, suoi eserciti.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lodatelo, sole e luna;","poem":1},{"lineBreak":true},{"text":"Lodatelo voi, stelle lucenti tutte.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lodatelo voi, cieli de' cieli;","poem":1},{"lineBreak":true},{"text":"E voi, acque che siete di sopra al cielo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tutte queste cose lodino il nome del Signore;","poem":1},{"lineBreak":true},{"text":"Perciocchè al suo comandamento furono create.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ed egli le ha stabilite per sempre ed in perpetuo;","poem":1},{"lineBreak":true},{"text":"Egli ne ha fatto uno statuto, il qual non trapasserà giammai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lodate il Signore della terra.","poem":1},{"lineBreak":true},{"text":"Balene, ed abissi tutti;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fuoco, e gragnuola; neve, e vapore,","poem":1},{"lineBreak":true},{"text":"E vento tempestoso ch'eseguisce la sua parola;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Monti, e colli tutti;","poem":1},{"lineBreak":true},{"text":"Alberi fruttiferi, e cedri tutti;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fiere, e bestie domestiche tutte;","poem":1},{"lineBreak":true},{"text":"Rettili, ed uccelli alati;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Re della terra, e popoli tutti;","poem":1},{"lineBreak":true},{"text":"Principi, e rettori della terra tutti;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Giovani, ed anche vergini;","poem":1},{"lineBreak":true},{"text":"Vecchi, e fanciulli;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Lodino il Nome del Signore;","poem":1},{"lineBreak":true},{"text":"Perciocchè il Nome di lui solo è innalzato;","poem":1},{"lineBreak":true},{"text":"La sua maestà è sopra la terra, e sopra il cielo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ed ha alzato un corno al suo popolo,","poem":1},{"lineBreak":true},{"text":"Il che è materia di lode a tutti i suoi santi:","poem":1},{"lineBreak":true},{"text":"A' figliuoli d'Israele, suo popolo prossimo.","poem":1},{"lineBreak":true},{"text":"Alleluia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}