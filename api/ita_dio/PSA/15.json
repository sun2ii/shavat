{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":15,"content":[{"type":"heading","content":["Il vero cittadino del cielo"]},{"type":"hebrew_subtitle","content":["Salmo di Davide"]},{"type":"verse","number":1,"content":[{"text":"O SIGNORE, chi dimorerà nel tuo tabernacolo?","poem":1},{"lineBreak":true},{"text":"Chi abiterà nel monte della tua santità?","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Colui che cammina in integrità, e fa ciò che è giusto,","poem":1},{"lineBreak":true},{"text":"E parla il vero di cuore;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Che non dice male colla sua lingua,","poem":1},{"lineBreak":true},{"text":"E non fa male alcuno al suo compagno,","poem":1},{"lineBreak":true},{"text":"E non leva alcun vituperio contro al suo prossimo;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Appo cui è sprezzato chi deve esser riprovato,","poem":1},{"lineBreak":true},{"text":"E che onora quelli che temono il Signore;","poem":1},{"lineBreak":true},{"text":"E il quale, se ha giurato alcuna cosa,","poem":1},{"lineBreak":true},{"text":"Benchè sia a suo danno, non però la ritratta;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Il quale non dà i suoi danari ad usura.","poem":1},{"lineBreak":true},{"text":"E non prende presenti contro all'innocente.","poem":1},{"lineBreak":true},{"text":"Chi fa queste cose non sarà giammai smosso.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}