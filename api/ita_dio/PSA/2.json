{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":2,"content":[{"type":"heading","content":["Lotte e vittoria del Messia"]},{"type":"verse","number":1,"content":[{"text":"PERCHÈ tumultuano le genti,","poem":1},{"lineBreak":true},{"text":"E mormorano i popoli cose vane?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I re della terra si ritrovano,","poem":1},{"lineBreak":true},{"text":"Ed i principi consigliano insieme,","poem":1},{"lineBreak":true},{"text":"Contro al Signore, e contro al suo Unto;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dicendo: Rompiamo i lor legami,","poem":1},{"lineBreak":true},{"text":"E gettiam via da noi le lor funi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Colui che siede ne' cieline riderà;","poem":1},{"lineBreak":true},{"text":"Il Signore si befferà di loro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Allora parlerà loro nella sua ira,","poem":1},{"lineBreak":true},{"text":"E li renderà smarriti nel suo cruccio acceso;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E dirà: Pur nondimeno ho io consacrato il mio Re","poem":1},{"lineBreak":true},{"text":"Sopra Sion, monte della mia santità.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Io spiegherò il decreto;","poem":1},{"lineBreak":true},{"text":"Il Signore mi ha detto: Tu sei il mio figliuolo;","poem":1},{"lineBreak":true},{"text":"Oggi io t'ho generato.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chiedimi, ed io ti darò per eredità le genti,","poem":1},{"lineBreak":true},{"text":"Ed i confini della terra per tua possessione.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tu le fiaccherai con una verga di ferro;","poem":1},{"lineBreak":true},{"text":"Tu le triterai come un testo di vasellaio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ora dunque, o re, siate savi;","poem":1},{"lineBreak":true},{"text":"Giudici della terra, ricevete correzione.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Servite al Signore con timore,","poem":1},{"lineBreak":true},{"text":"E gioite con tremore.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Baciate il figliuolo, che talora egli non si adiri,","poem":1},{"lineBreak":true},{"text":"E che voi non periate nella vostra via,","poem":1},{"lineBreak":true},{"text":"Quando l'ira sua si sarà pure un poco accesa.","poem":1},{"lineBreak":true},{"text":"Beati tutti coloro che si confidano in lui.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}