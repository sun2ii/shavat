{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":20,"content":[{"type":"heading","content":["Preghiera pel re in guerra"]},{"type":"hebrew_subtitle","content":["Salmo di Davide, dato al Capo de' Musici"]},{"type":"verse","number":1,"content":[{"text":"IL Signore ti risponda nel giorno che tu sarai in distretta;","poem":1},{"lineBreak":true},{"text":"Leviti ad alto in salvo il Nome dell'Iddio di Giacobbe;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Manditi soccorso dal Santuario,","poem":1},{"lineBreak":true},{"text":"E sostengati da Sion;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ricordisi di tutte le tue offerte,","poem":1},{"lineBreak":true},{"text":"E riduca in cenere il tuo olocausto. (Sela.)","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Diati ciò che è secondo il cuor tuo,","poem":1},{"lineBreak":true},{"text":"E adempia ogni tuo consiglio.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Noi canteremo di allegrezza per la tua vittoria,","poem":1},{"lineBreak":true},{"text":"Ed alzeremo bandiere nel Nome dell'Iddio nostro.","poem":1},{"lineBreak":true},{"text":"Il Signore adempia tutte le tue domande.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ora so, che il Signore ha salvato il suo unto;","poem":1},{"lineBreak":true},{"text":"Egli gli risponderà dal cielo della sua santità;","poem":1},{"lineBreak":true},{"text":"La vittoria della sua destra è con gran potenza.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gli uni si fidano in carri, e gli altri in cavalli;","poem":1},{"lineBreak":true},{"text":"Ma noi ricorderemo il Nome del Signore Iddio nostro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Quelli sono andati in giù, e son caduti;","poem":1},{"lineBreak":true},{"text":"Ma noi siamo restati in piè, e ci siam rizzati.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Salva, Signore;","poem":1},{"lineBreak":true},{"text":"Rispondaci il re nel giorno che noi grideremo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}