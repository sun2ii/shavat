{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":23,"content":[{"type":"heading","content":["Felicità e sicurezza di chi ha Dio per suo pastore"]},{"type":"hebrew_subtitle","content":["Salmo di Davide"]},{"type":"verse","number":1,"content":[{"text":"IL Signore è il mio pastore: nulla mi mancherà.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Egli mi fa giacere in paschi erbosi,","poem":1},{"lineBreak":true},{"text":"Mi guida lungo le acque chete.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Egli mi ristora l'anima;","poem":1},{"lineBreak":true},{"text":"Egli mi conduce per sentieri di giustizia,","poem":1},{"lineBreak":true},{"text":"Per amor del suo Nome.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Avvegnachè io camminassi nella valle dell'ombra della morte,","poem":1},{"lineBreak":true},{"text":"Io non temerei male alcuno; perciocchè tu sei meco;","poem":1},{"lineBreak":true},{"text":"La tua bacchetta, e la tua verga mi consolano.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tu apparecchi davanti a me la mensa, al cospetto de' miei nemici;","poem":1},{"lineBreak":true},{"text":"Tu ungi il mio capo con olio; la mia coppa trabocca.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Per certo, beni e benignità mi accompagneranno","poem":1},{"lineBreak":true},{"text":"Tutti i giorni della mia vita;","poem":1},{"lineBreak":true},{"text":"Ed io abiterò nella Casa del Signore","poem":1},{"lineBreak":true},{"text":"Per lunghi giorni.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}