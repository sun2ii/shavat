{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":24,"content":[{"type":"heading","content":["Il dominio universale di Dio. — Chi è degno di salire al santuario di lui? — Il Re di gloria"]},{"type":"hebrew_subtitle","content":["Salmo di Davide"]},{"type":"verse","number":1,"content":[{"text":"AL Signore appartiene la terra, e tutto quello che è in essa;","poem":1},{"lineBreak":true},{"text":"Il mondo, ed i suoi abitanti.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Perciocchè egli l'ha fondata sopra i mari,","poem":1},{"lineBreak":true},{"text":"E l'ha fermata sopra i fiumi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Chi salirà al monte del Signore?","poem":1},{"lineBreak":true},{"text":"E chi starà nel luogo suo santo?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"L' uomo innocente di mani, e puro di cuore;","poem":1},{"lineBreak":true},{"text":"Il qual non eleva l'animo a vanità, e non giura con frode.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Un tale riceverà benedizione dal Signore,","poem":1},{"lineBreak":true},{"text":"E giustizia dall'Iddio della sua salute.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tale è la generazione di quelli che lo ricercano;","poem":1},{"lineBreak":true},{"text":"Tale è Giacobbe che cerca la tua faccia, o Dio. (Sela.)","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"O porte, alzate i vostri capi;","poem":1},{"lineBreak":true},{"text":"E voi, porte eterne, alzatevi;","poem":1},{"lineBreak":true},{"text":"E il Re di gloria entrerà.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chi è questo Re di gloria?","poem":1},{"lineBreak":true},{"text":"Egli è il Signore forte e possente;","poem":1},{"lineBreak":true},{"text":"Il Signore poderoso in battaglia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"O porte, alzate i vostri capi;","poem":1},{"lineBreak":true},{"text":"Alzatevi, o porte eterne;","poem":1},{"lineBreak":true},{"text":"E il Re di gloria entrerà.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Chi è questo Re di gloria?","poem":1},{"lineBreak":true},{"text":"Egli è il Signor degli eserciti;","poem":1},{"lineBreak":true},{"text":"Esso è il Re di gloria. (Sela.)","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}