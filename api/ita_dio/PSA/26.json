{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":26,"content":[{"type":"heading","content":["Davide ricorre a Dio fidando nella propria integrità"]},{"type":"hebrew_subtitle","content":["Salmo di Davide"]},{"type":"verse","number":1,"content":[{"text":"GIUDICIAMI, Signore; perciocchè io son camminato nella mia integrità;","poem":1},{"lineBreak":true},{"text":"E mi son confidato nel Signore; io non sarò smosso.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Provami, Signore, e sperimentami;","poem":1},{"lineBreak":true},{"text":"Metti al cimento le mie reni ed il mio cuore.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Perciocchè io ho davanti agli occhi la tua benignità,","poem":1},{"lineBreak":true},{"text":"E son camminato nella tua verità.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Io non son seduto con uomini bugiardi,","poem":1},{"lineBreak":true},{"text":"E non sono andato co' dissimulati.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Io odio la raunanza de' maligni,","poem":1},{"lineBreak":true},{"text":"E non son seduto con gli empi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Io lavo le mie mani nell'innocenza,","poem":1},{"lineBreak":true},{"text":"E circuisco il tuo Altare, o Signore;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Facendo risonar voce di lode,","poem":1},{"lineBreak":true},{"text":"E raccontando tutte le tue maraviglie.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O Signore, io amo l'abitacolo della tua Casa,","poem":1},{"lineBreak":true},{"text":"E il luogo del tabernacolo della tua gloria.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Non metter l'anima mia in un fascio co' peccatori,","poem":1},{"lineBreak":true},{"text":"Nè la mia vita con gli uomini di sangue;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nelle cui mani è scelleratezza,","poem":1},{"lineBreak":true},{"text":"E la cui destra è piena di presenti.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma io camminerò nella mia integrità;","poem":1},{"lineBreak":true},{"text":"Riscuotimi, ed abbi pietà di me.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Il mio piè sta fermo e ritto in luogo piano.","poem":1},{"lineBreak":true},{"text":"Io benedirò il Signore nelle raunanze.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}