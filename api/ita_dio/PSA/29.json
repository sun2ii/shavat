{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":29,"content":[{"type":"heading","content":["Invito a lodar la maestà di Dio"]},{"type":"hebrew_subtitle","content":["Salmo di Davide"]},{"type":"verse","number":1,"content":[{"text":"DATE al Signore, o figliuoli de' potenti,","poem":1},{"lineBreak":true},{"text":"Date al Signore gloria e forza.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Date al Signore la gloria dovuta al suo Nome;","poem":1},{"lineBreak":true},{"text":"Adorate il Signore nel magnifico santuario.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"La voce del Signore è sopra le acque;","poem":1},{"lineBreak":true},{"text":"L'Iddio di gloria tuona;","poem":1},{"lineBreak":true},{"text":"Il Signore è sopra le grandi acque.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"La voce del Signore è con potenza;","poem":1},{"lineBreak":true},{"text":"La voce del Signore è con magnificenza.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"La voce del Signore rompe i cedri;","poem":1},{"lineBreak":true},{"text":"E il Signore spezza i cedri del Libano;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E li fa saltellar come un vitello;","poem":1},{"lineBreak":true},{"text":"Il Libano stesso, e Sirion, come il figlio d'un liocorno.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"La voce del Signore sparge, a giusa di schegge, fiamme di fuoco.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"La voce del Signore fa tremare il deserto;","poem":1},{"lineBreak":true},{"text":"Il Signore fa tremare il deserto di Cades.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"La voce del Signore fa partorir le cerve,","poem":1},{"lineBreak":true},{"text":"E sfronda le selve;","poem":1},{"lineBreak":true},{"text":"Ma intanto ciascuna predica la sua gloria nel suo Tempio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Il Signore nel diluvio siede;","poem":1},{"lineBreak":true},{"text":"Anzi il Signore siede re in eterno.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Il Signore darà forza al suo popolo;","poem":1},{"lineBreak":true},{"text":"Il Signore benedirà il suo popolo in pace.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}