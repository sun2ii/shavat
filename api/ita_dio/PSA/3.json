{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":3,"content":[{"type":"heading","content":["Fiducia in Dio nell'avversità"]},{"type":"hebrew_subtitle","content":["Salmo di Davide, composto quando egli fuggì per cagione d'Absalom, suo figliuolo"]},{"type":"verse","number":1,"content":[{"text":"O SIGNORE, in quanto gran numero sono i miei nemici!","poem":1},{"lineBreak":true},{"text":"Molti si levano contro a me.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Molti dicono dell'anima mia:","poem":1},{"lineBreak":true},{"text":"Non v'è salute alcuna appo Iddio per lui. (Sela","poem":1},{"noteId":0},{"text":".)","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma, Signore, tu sei uno scudo d'intorno a me;","poem":1},{"lineBreak":true},{"text":"Tu sei la mia gloria, e quel che mi sollevi il capo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Io ho colla mia voce gridato al Signore,","poem":1},{"lineBreak":true},{"text":"Ed egli mi ha risposto dal monte della sua santità. (Sela.)","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Io mi son coricato, e ho dormito;","poem":1},{"lineBreak":true},{"text":"Poi mi son risvegliato; perciocchè il Signore mi sostiene.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Io non temerei di migliaia di popolo,","poem":1},{"lineBreak":true},{"text":"Quando si fossero accampate contro a me d'ogn'intorno.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Levati, Signore; salvami, Dio mio;","poem":1},{"lineBreak":true},{"text":"Perciochè tu hai percossa la mascella di tutti i miei nemici;","poem":1},{"lineBreak":true},{"text":"Tu hai rotti i denti degli empi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Il salvare appartiene al Signore;","poem":1},{"lineBreak":true},{"text":"La tua benedizione è sopra il tuo popolo. (Sela.)","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Sela cioè: pausa .","reference":{"chapter":3,"verse":2}}]},"thisChapterLink":"/api/ita_dio/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}