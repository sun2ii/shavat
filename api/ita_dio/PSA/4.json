{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":4,"content":[{"type":"heading","content":["Preghiera a Dio nella distretta"]},{"type":"hebrew_subtitle","content":["Salmo di Davide, dato al Capo de' Musici, in su Neghinot"]},{"type":"verse","number":1,"content":[{"text":"QUANDO io grido, rispondimi, o Dio della mia giustizia;","poem":1},{"lineBreak":true},{"text":"Quando io sono stato distretto, tu mi hai messo in largo;","poem":1},{"lineBreak":true},{"text":"Abbi pietà di me, ed esaudisci la mia orazione.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"O uomini principali, infino a quando sarà la mia gloria in vituperio?","poem":1},{"lineBreak":true},{"text":"Infino a quando amerete vanità,","poem":1},{"lineBreak":true},{"text":"E andrete dietro a menzogna? (Sela.)","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Or sappiate che il Signore si ha eletto un pietoso;","poem":1},{"lineBreak":true},{"text":"Il Signore mi esaudirà quando io griderò a lui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tremate, e non peccate;","poem":1},{"lineBreak":true},{"text":"Ragionate nel cuor vostro, sopra i vostri letti, e restate. (Sela.)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sacrificate sacrificii di giustizia,","poem":1},{"lineBreak":true},{"text":"E confidatevi nel Signore.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Molti dicono: Chi ci farà veder del bene?","poem":1},{"lineBreak":true},{"text":"O Signore, alza la luce del tuo volto sopra noi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tu mi hai data maggiore allegrezza nel cuore, che non hanno quelli","poem":1},{"lineBreak":true},{"text":"Nel tempo che il lor frumento, e il lor mosto è moltiplicato.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Io mi coricherò in pace, ed in pace ancora dormirò;","poem":1},{"lineBreak":true},{"text":"Perciocchè tu solo, Signore, mi fai abitare sicuramente.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}