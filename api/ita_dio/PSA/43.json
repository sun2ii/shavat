{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":43,"content":[{"type":"heading","content":["Preghiera del Salmista per essere ricondotto nel santuario"]},{"type":"verse","number":1,"content":[{"text":"O DIO, fammi ragione, e dibatti la mia lite;","poem":1},{"lineBreak":true},{"text":"Liberami dalla gente spietata, dall'uomo frodolente ed iniquo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Perciocchè tu sei l'Iddio della mia fortezza; perchè mi hai scacciato?","poem":1},{"lineBreak":true},{"text":"Perchè vo io attorno vestito a bruno,","poem":1},{"lineBreak":true},{"text":"Per l'oppression del nemico?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Manda la tua luce, e la tua verità; giudinmi esse,","poem":1},{"lineBreak":true},{"text":"Ed introducanmi al monte della tua santità, e ne' tuoi tabernacoli.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Allora verrò all'Altare di Dio, all'Iddio dell'allegrezza del mio giubilo;","poem":1},{"lineBreak":true},{"text":"E ti celebrerò colla cetera, o Dio, Dio mio.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Perchè ti abbatti, anima mia? e perchè ti commovi in me?","poem":1},{"lineBreak":true},{"text":"Aspetta Iddio; perciocchè ancora lo celebrerò;","poem":1},{"lineBreak":true},{"text":"Egli è la compiuta salvezza della mia faccia, e il mio Dio.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}