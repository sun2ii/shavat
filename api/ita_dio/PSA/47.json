{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":47,"content":[{"type":"heading","content":["Il trionfo del regno di Dio"]},{"type":"hebrew_subtitle","content":["Salmo, dato al Capo de' Musici, de' figliuoli di Core"]},{"type":"verse","number":1,"content":[{"text":"BATTETEVI a palme, o popoli tutti;","poem":1},{"lineBreak":true},{"text":"Giubilate a Dio con voce di trionfo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Perciocchè il Signore è l'Altissimo, il Tremendo,","poem":1},{"lineBreak":true},{"text":"Gran Re sopra tutta la terra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Egli ridurrà i popoli sotto noi,","poem":1},{"lineBreak":true},{"text":"E la nazioni sotto i nostri piedi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Egli ci ha scelta la nostra eredità,","poem":1},{"lineBreak":true},{"text":"La gloria di Giacobbe, il quale egli ama. (Sela.)","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Iddio è salito con giubilo,","poem":1},{"lineBreak":true},{"text":"Il Signore è salito con suono di trombe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Salmeggiate a Dio, salmeggiate;","poem":1},{"lineBreak":true},{"text":"Salmeggiate al Re nostro, salmeggiate.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Perciocchè Iddio è Re di tutta la terra;","poem":1},{"lineBreak":true},{"text":"Salmeggiate maestrevolmente","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Iddio regna sopra le genti:","poem":1},{"lineBreak":true},{"text":"Iddio siede sopra il trono della sua santità.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I principi de' popoli si son raunati insieme;","poem":1},{"lineBreak":true},{"text":"Il popolo dell'Iddio d'Abrahamo,","poem":1},{"lineBreak":true},{"text":"Perciocchè a Dio appartengono gli scudi della terra;","poem":1},{"lineBreak":true},{"text":"Egli è grandemente esaltato.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}