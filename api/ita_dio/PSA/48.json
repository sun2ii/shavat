{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":48,"content":[{"type":"heading","content":["Bellezza e privilegi di Gerusalemme"]},{"type":"hebrew_subtitle","content":["Cantico di Salmo, de' figliuoli di Core"]},{"type":"verse","number":1,"content":[{"text":"IL Signore è grande, e molto glorioso","poem":1},{"lineBreak":true},{"text":"Nella Città dell'Iddio nostro, nel monte della sua santità.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Il monte di Sion, il fondo verso il Settentrione,","poem":1},{"lineBreak":true},{"text":"La Città del gran Re","poem":1},{"lineBreak":true},{"text":"È in bella contrada, è la gioia di tutta la terra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Iddio è riconosciuto ne' palazzi di essa, per alta fortezza.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Perciocchè ecco, i re si erano adunati,","poem":1},{"lineBreak":true},{"text":"Ed erano tutti insieme passati oltre.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Come prima la videro, furono attoniti,","poem":1},{"lineBreak":true},{"text":"Si smarrirono, si affrettarono a fuggire.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tremore li colse quivi;","poem":1},{"lineBreak":true},{"text":"Doglia, come di donna che partorisce.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Furono rotti come per lo vento orientale","poem":1},{"lineBreak":true},{"text":"Che rompe le navi di Tarsis.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Come avevamo udito, così abbiam veduto,","poem":1},{"lineBreak":true},{"text":"Nella Città del Signor degli eserciti,","poem":1},{"lineBreak":true},{"text":"Nella Città dell'Iddio nostro;","poem":1},{"lineBreak":true},{"text":"Iddio la stabilirà in perpetuo. (Sela.)","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"O Dio, noi abbiamo, chetamente aspettata la tua benignità","poem":1},{"lineBreak":true},{"text":"Dentro al tuo Tempio.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"O Dio, quale è il tuo Nome,","poem":1},{"lineBreak":true},{"text":"Tale è la tua lode, infino all'estremità della terra;","poem":1},{"lineBreak":true},{"text":"La tua destra è piena di giustizia.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Il monte di Sion si rallegrerà,","poem":1},{"lineBreak":true},{"text":"Le figliuole di Giuda festeggeranno, per li tuoi giudicii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Circuite Sion, e andate attorno a lei,","poem":1},{"lineBreak":true},{"text":"Contate le sue torri.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ponete mente alle bastie,","poem":1},{"lineBreak":true},{"text":"Mirate l'altezza de' suoi palazzi;","poem":1},{"lineBreak":true},{"text":"Acciocchè lo raccontiate all'età a venire.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Perciocchè questo Dio è il nostro Dio in sempiterno;","poem":1},{"lineBreak":true},{"text":"Egli ci giuderà infino alla morte.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}