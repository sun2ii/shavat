{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":53,"content":[{"type":"heading","content":["Estrema depravazione di quelli che negano Iddio"]},{"type":"hebrew_subtitle","content":["Maschil di Davide, dato al Capo de' Musici, sopra Mahalat"]},{"type":"verse","number":1,"content":[{"text":"LO stolto ha detto nel suo cuore: Non vi è Dio.","poem":1},{"lineBreak":true},{"text":"Si son corrotti, e resi abbominevoli in perversità;","poem":1},{"lineBreak":true},{"text":"Non vi è niuno che faccia bene.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Iddio ha riguardato dal cielo sopra i figliuoli degli uomini.","poem":1},{"lineBreak":true},{"text":"Per vedere se vi fosse alcuno che avesse intelletto,","poem":1},{"lineBreak":true},{"text":"Che cercasse Iddio.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tutti son corrotti, tutti son divenuti puzzolenti;","poem":1},{"lineBreak":true},{"text":"Non vi è niuno che faccia bene,","poem":1},{"lineBreak":true},{"text":"Non pur uno.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Non hanno essi alcuno intendimento, questi operatori d'iniquità,","poem":1},{"lineBreak":true},{"text":"Che mangiano il mio popolo, come se mangiassero del pane,","poem":1},{"lineBreak":true},{"text":"E non invocano Iddio?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Là saranno spaventati di grande spavento,","poem":1},{"lineBreak":true},{"text":"Ove però non sarà cagion di spavento;","poem":1},{"lineBreak":true},{"text":"Perciocchè il Signore dissipa le ossa di coloro","poem":1},{"lineBreak":true},{"text":"Che si accampano contro a te, o Sion;","poem":1},{"lineBreak":true},{"text":"Tu li hai svergognati; perciocchè Iddio li sdegna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Oh! vengano pur da Sion le salvazioni d'Israele!","poem":1},{"lineBreak":true},{"text":"Quando Iddio trarrà di cattività il suo popolo,","poem":1},{"lineBreak":true},{"text":"Giacobbe festeggerà, Israele si rallegrerà.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}