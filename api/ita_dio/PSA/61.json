{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":61,"content":[{"type":"heading","content":["Davide si rifugia in Dio"]},{"type":"hebrew_subtitle","content":["Salmo di Davide, dato al Capo de' Musici, sopra Neghinot"]},{"type":"verse","number":1,"content":[{"text":"O DIO, ascolta il mio grido;","poem":1},{"lineBreak":true},{"text":"Attendi alla mia orazione.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Io grido a te dall'estremità della terra, mentre il mio cuore spasima;","poem":1},{"lineBreak":true},{"text":"Conducimi in su la rocca, che è troppo alta da salirvi da me.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Perciocchè tu mi sei stato un ricetto,","poem":1},{"lineBreak":true},{"text":"Una torre di fortezza d'innanzi al nemico.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Io dimorerò nel tuo tabernacolo per molti secoli;","poem":1},{"lineBreak":true},{"text":"Io mi riparerò nel nascondimento delle tue ale. (Sela.)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Perciocchè tu, o Dio, hai esauditi i miei voti;","poem":1},{"lineBreak":true},{"text":"Tu mi hai data l'eredità di quelli che temono il tuo Nome.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Aggiungi giorni sopra giorni al re;","poem":1},{"lineBreak":true},{"text":"Sieno gli anni suoi a guisa di molte età.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dimori in perpetuo nel cospetto di Dio;","poem":1},{"lineBreak":true},{"text":"Ordina benignità e verità che lo guardino.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Così salmeggerò il tuo Nome in perpetuo,","poem":1},{"lineBreak":true},{"text":"Per adempiere ogni giorno i miei voti.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}