{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":63,"content":[{"type":"heading","content":["Davide brama la presenza di Dio"]},{"type":"hebrew_subtitle","content":["Salmo di Davide, composto quando egli era nel deserto di Giuda"]},{"type":"verse","number":1,"content":[{"text":"O DIO, tu sei l'Iddio mio, io ti cerco;","poem":1},{"lineBreak":true},{"text":"L'anima mia è assetata di te; la mia carne ti brama","poem":1},{"lineBreak":true},{"text":"In terra arida ed asciutta, senz'acqua.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Così ti ho io mirato nel santuario,","poem":1},{"lineBreak":true},{"text":"Riguardando la tua forza, e la tua gloria.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Perciocchè la tua benignità è cosa buona più che la vita,","poem":1},{"lineBreak":true},{"text":"Le mie labbra ti loderanno.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Così ti benedirò in vita mia;","poem":1},{"lineBreak":true},{"text":"Io alzerò le mie mani nel tuo Nome.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"L'anima mia è saziata come di grasso e di midolla;","poem":1},{"lineBreak":true},{"text":"E la mia bocca ti loderà con labbra giubilanti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Quando io mi ricordo di te sul mio letto.","poem":1},{"lineBreak":true},{"text":"Io medito di te nelle veglie della notte.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Perciocchè tu mi sei stato in aiuto,","poem":1},{"lineBreak":true},{"text":"Io giubilo all'ombra delle tue ale.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"L'anima mia è attaccata dietro a te;","poem":1},{"lineBreak":true},{"text":"La tua destra mi sostiene.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ma quelli che cercano l'anima mia, per disertarla,","poem":1},{"lineBreak":true},{"text":"Entreranno nelle più basse parti della terra.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Saranno atterrati per la spada;","poem":1},{"lineBreak":true},{"text":"Saranno la parte delle volpi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma il re si rallegrerà in Dio;","poem":1},{"lineBreak":true},{"text":"Chiunque giura per lui, si glorierà;","poem":1},{"lineBreak":true},{"text":"Perciocchè la bocca di quelli che parlano falsamente sarà turata.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}