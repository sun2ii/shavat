{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":64,"content":[{"type":"heading","content":["Davide domanda e spera liberazione"]},{"type":"hebrew_subtitle","content":["Salmo di Davide, dato al Capo de' Musici"]},{"type":"verse","number":1,"content":[{"text":"O DIO, ascolta la mia voce, mentre io fo la mia orazione;","poem":1},{"lineBreak":true},{"text":"Guarda la vita mia dallo spavento del nemico.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nascondimi dal consiglio de' maligni,","poem":1},{"lineBreak":true},{"text":"E dalla turba degli operatori d'iniquità;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I quali hanno aguzzata la lor lingua come una spada;","poem":1},{"lineBreak":true},{"text":"E in luogo di saette, hanno tratte parole amare;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Per saettar l'uomo intiero in luoghi nascosti;","poem":1},{"lineBreak":true},{"text":"Di subito improvviso lo saettano, e non hanno timore alcuno.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fermano fra loro pensieri malvagi;","poem":1},{"lineBreak":true},{"text":"Divisano di tender di nascosto lacci,","poem":1},{"lineBreak":true},{"text":"Dicono: Chi li vedrà?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Investigano malizie; ricercano tutto ciò che si può investigare;","poem":1},{"lineBreak":true},{"text":"E quanto può l'interior dell'uomo, ed un cuor cupo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ma Iddio li saetterà;","poem":1},{"lineBreak":true},{"text":"Le lor ferite saranno come di saetta subitanea.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"E le lor lingue saranno traboccate sopra loro;","poem":1},{"lineBreak":true},{"text":"Chiunque li vedrà fuggirà.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"E tutti gli uomini temeranno,","poem":1},{"lineBreak":true},{"text":"E racconteranno l'opera di Dio;","poem":1},{"lineBreak":true},{"text":"E considereranno quello ch'egli avrà fatto.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Il giusto si rallegrerà nel Signore, e spererà in lui;","poem":1},{"lineBreak":true},{"text":"E tutti quelli che son diritti di cuore, si glorieranno.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}