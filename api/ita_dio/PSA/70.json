{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":70,"content":[{"type":"heading","content":["Davide chiede aiuto al Signore"]},{"type":"hebrew_subtitle","content":["Salmo di Davide, da rammemorare; dato al Capo de' Musici"]},{"type":"verse","number":1,"content":[{"text":"O DIO, affrettati a liberarmi;","poem":1},{"lineBreak":true},{"text":"O Signore, affrettati in mio aiuto.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Quelli che cercano l'anima mia sien confusi e svergognati;","poem":1},{"lineBreak":true},{"text":"Quelli che prendono piacere nel mio male voltin le spalle,","poem":1},{"lineBreak":true},{"text":"E sieno svergognati.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Quelli che dicono: Eia, eia!","poem":1},{"lineBreak":true},{"text":"Voltin le spalle, per ricompensa del vituperio che mi fanno.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rallegrinsi, e gioiscano in te","poem":1},{"lineBreak":true},{"text":"Tutti quelli che ti cercano;","poem":1},{"lineBreak":true},{"text":"E quelli che amano la tua salute","poem":1},{"lineBreak":true},{"text":"Dicano del continuo: Magnificato sia Iddio.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ora, quant'è a me, io son povero e bisognoso;","poem":1},{"lineBreak":true},{"text":"O Dio, affrettati a venire a me;","poem":1},{"lineBreak":true},{"text":"Tu sei il mio aiuto, ed il mio liberatore;","poem":1},{"lineBreak":true},{"text":"O Signore, non tardare.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}