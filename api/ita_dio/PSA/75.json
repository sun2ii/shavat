{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":75,"content":[{"type":"heading","content":["Il Salmista loda Iddio e promette di fare osservare la giustizia"]},{"type":"hebrew_subtitle","content":["Salmo di cantico di Asaf, dato al Capo de' Musici, sopra Al-tashet"]},{"type":"verse","number":1,"content":[{"text":"NOI ti celebriamo, noi ti celebriamo, o Dio;","poem":1},{"lineBreak":true},{"text":"Perciocchè il tuo Nome è vicino;","poem":1},{"lineBreak":true},{"text":"L'uomo racconta le tue maraviglie.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Al tempo che avrò fissato,","poem":1},{"lineBreak":true},{"text":"Io giudicherò dirittamente.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Il paese e tutti i suoi abitanti si struggevano;","poem":1},{"lineBreak":true},{"text":"Ma io ho rizzate le sue colonne. (Sela.)","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Io ho detto agl'insensati: Non siate insensati;","poem":1},{"lineBreak":true},{"text":"Ed agli empi: Non alzate il corno;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Non levate il vostro corno ad alto;","poem":1},{"lineBreak":true},{"text":"E non parlate col collo indurato.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Perciocchè nè di Levante, nè di Ponente,","poem":1},{"lineBreak":true},{"text":"Nè dal deserto, viene l'esaltamento.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma Iddio è quel che giudica;","poem":1},{"lineBreak":true},{"text":"Egli abbassa l'uno, ed innalza l'altro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Perciocchè il Signore ha in mano una coppa,","poem":1},{"lineBreak":true},{"text":"Il cui vino è torbido;","poem":1},{"lineBreak":true},{"text":"Ella è piena di mistione, ed egli ne mesce;","poem":1},{"lineBreak":true},{"text":"Certamente tutti gli empi della terra ne succeranno e berranno le fecce.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ora, quant'è a me, io predicherò queste cose in perpetuo,","poem":1},{"lineBreak":true},{"text":"Io salmeggerò all'Iddio di Giacobbe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"E mozzerò tutte le corna degli empi;","poem":1},{"lineBreak":true},{"text":"E farò che le corna de' giusti saranno alzate.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}