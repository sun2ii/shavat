{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":76,"content":[{"type":"heading","content":["Maestà e potenza di Dio"]},{"type":"hebrew_subtitle","content":["Salmo di cantico di Asaf, dato al Capo de' Musici, sopra Neghinot"]},{"type":"verse","number":1,"content":[{"text":"IDDIO è conosciuto in Giuda;","poem":1},{"lineBreak":true},{"text":"Il suo Nome è grande in Israele.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"E il suo tabernacolo è in Salem,","poem":1},{"lineBreak":true},{"text":"E la sua stanza in Sion.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Quivi ha rotte saette,","poem":1},{"lineBreak":true},{"text":"Archi, scudi, e spade, ed arnesi da guerra. (Sela.)","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tu sei illustre, potente,","poem":1},{"lineBreak":true},{"text":"Più che i monti dei predatori.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I magnanimi sono stati spogliati,","poem":1},{"lineBreak":true},{"text":"Hanno dormito il sonno loro;","poem":1},{"lineBreak":true},{"text":"E niuno di quegli uomini prodi ha saputo trovar le sue mani.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"O Dio di Giacobbe,","poem":1},{"lineBreak":true},{"text":"E carri e cavalli sono stati stupefatti per lo tuo sgridare.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tu sei tremendo; tu, dico;","poem":1},{"lineBreak":true},{"text":"E chi durerà davanti a te, dacchè tu ti adiri?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tu bandisti giudicio dal cielo;","poem":1},{"lineBreak":true},{"text":"La terra temette, e stette cheta.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Quando Iddio si levò per far giudicio,","poem":1},{"lineBreak":true},{"text":"Per salvar tutti i mansueti della terra. (Sela.)","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Certamente l'ira degli uomini ti acquista lode;","poem":1},{"lineBreak":true},{"text":"Tu ti cingerai del rimanente dell'ire.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Fate voti al Signore Iddio vostro, e adempieteli;","poem":1},{"lineBreak":true},{"text":"Tutti quelli che sono d'intorno a lui portino doni al Tremendo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Egli vendemmia lo spirito de' principi;","poem":1},{"lineBreak":true},{"text":"Egli è tremendo ai re della terra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}