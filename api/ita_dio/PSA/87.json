{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":87,"content":[{"type":"heading","content":["Dio prende il suo diletto in Sion ed ivi riunirà tutti i popoli"]},{"type":"hebrew_subtitle","content":["Salmo di Cantico de' figliuoli di Core"]},{"type":"verse","number":1,"content":[{"text":"LA fondazione del Signoreè ne' monti santi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Il Signore ama le porte di Sion,","poem":1},{"lineBreak":true},{"text":"Sopra tutte le stanze di Giacobbe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"O Città di Dio,","poem":1},{"lineBreak":true},{"text":"Cose gloriose son dette di te. (Sela.)","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Io mentoverò, dice al Signore, Rahab, e Babilonia,","poem":1},{"lineBreak":true},{"text":"Fra quelli che mi conoscono;","poem":1},{"lineBreak":true},{"text":"Ecco, i Filistei ed i Tiri insieme con gli Etiopi,","poem":1},{"lineBreak":true},{"text":"De' quali si dirà: Costui è nato quivi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E si dirà di Sion: Questi e quegli è nato in essa;","poem":1},{"lineBreak":true},{"text":"E l'Altissimo stesso la stabilirà.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Il Signore, rassegnando i popoli, annovererà coloro,","poem":1},{"lineBreak":true},{"text":"Dicendo: Un tale è nato quivi. (Sela.)","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E cantori, e suonatori,","poem":1},{"lineBreak":true},{"text":"E tutte le mie fonti, saranno in te.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}