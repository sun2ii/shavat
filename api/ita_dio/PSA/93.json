{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":93,"content":[{"type":"heading","content":["Potenza e maestà del regno di Dio"]},{"type":"verse","number":1,"content":[{"text":"IL Signore regna; egli è vestito di maestà;","poem":1},{"lineBreak":true},{"text":"Il Signore è vestito e cinto di forza;","poem":1},{"lineBreak":true},{"text":"Il mondo eziandio è stabilito, e non sarà giammai smosso.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Il tuo trono è fermo da tutta eternità;","poem":1},{"lineBreak":true},{"text":"Tu sei ab eterno.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"I fiumi hanno alzato, o Signore,","poem":1},{"lineBreak":true},{"text":"I fiumi hanno alzato il lor suono;","poem":1},{"lineBreak":true},{"text":"I fiumi hanno alzate le loro onde;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma il Signore, che è disopra,","poem":1},{"lineBreak":true},{"text":"È più potente che il suono delle grandi acque,","poem":1},{"lineBreak":true},{"text":"Che le possenti onde del mare.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Le tue testimonianze son sommamente veraci, o Signore;","poem":1},{"lineBreak":true},{"text":"La santità è bella nella tua Casa in perpetuo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}