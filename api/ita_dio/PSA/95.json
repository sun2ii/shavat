{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":95,"content":[{"type":"heading","content":["Invito a lodare il Signore e ad ascoltare la sua voce"]},{"type":"verse","number":1,"content":[{"text":"VENITE, cantiamo lietamente al Signore;","poem":1},{"lineBreak":true},{"text":"Giubiliamo alla Rocca della nostra salute.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Andiamogli incontro con lodi,","poem":1},{"lineBreak":true},{"text":"Giubiliamogli con salmi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Perciocchè il Signore è Dio grande,","poem":1},{"lineBreak":true},{"text":"E Re grande sopra tutti gl'iddii.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Perciocchè egli tiene in mano le profondità della terra;","poem":1},{"lineBreak":true},{"text":"E le altezze de' monti sono sue.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ed a lui appartiene il mare, perchè egli l'ha fatto;","poem":1},{"lineBreak":true},{"text":"E l'asciutto, perchè le sue mani l'hanno formato.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Venite, adoriamo, ed inchiniamoci;","poem":1},{"lineBreak":true},{"text":"Inginocchiamoci davanti al Signore che ci ha fatti.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Perciocchè egli è il nostro Dio;","poem":1},{"lineBreak":true},{"text":"E noi siamo il popolo del suo pasco,","poem":1},{"lineBreak":true},{"text":"E la greggia della sua condotta.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Oggi, se udite la sua voce,","poem":1},{"lineBreak":true},{"text":"Non indurate il vostro cuore, come in Meriba;","poem":1},{"lineBreak":true},{"text":"Come al giorno di Massa, nel deserto;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ove i padri vostri mi tentarono,","poem":1},{"lineBreak":true},{"text":"Mi provarono, ed anche videro le mie opere.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lo spazio di quarant'anni quella generazione mi fu di noia;","poem":1},{"lineBreak":true},{"text":"Onde io dissi: Costoro sono un popolo sviato di cuore,","poem":1},{"lineBreak":true},{"text":"E non conoscono le mie vie.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Perciò giurai nell'ira mia:","poem":1},{"lineBreak":true},{"text":"Se entrano giammai nel mio riposo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}