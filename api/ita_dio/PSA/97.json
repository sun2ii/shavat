{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":97,"content":[{"type":"heading","content":["Maestà del regno di Dio; gastigo degli empi; esortazione alla pietà ed alla gioia"]},{"type":"verse","number":1,"content":[{"text":"IL Signore regna: gioisca la terra;","poem":1},{"lineBreak":true},{"text":"Rallegrinsi le grandi isole.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nuvola e caligine sono d'intorno a lui;","poem":1},{"lineBreak":true},{"text":"Giustizia e giudicio sono il fermo sostegno del suo trono.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fuoco va davanti a lui,","poem":1},{"lineBreak":true},{"text":"E divampa i suoi nemici d'ogn'intorno.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I suoi folgori alluminano il mondo;","poem":1},{"lineBreak":true},{"text":"La terra l'ha veduto, ed ha tremato.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I monti si struggono come cera per la presenza del Signore,","poem":1},{"lineBreak":true},{"text":"Per la presenza del Signor di tutta la terra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I cieli predicano la sua giustizia,","poem":1},{"lineBreak":true},{"text":"E tutti i popoli veggono la sua gloria.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tutti quelli che servono alle sculture,","poem":1},{"lineBreak":true},{"text":"Che si gloriano negl'idoli, sien confusi, adoratelo, dii tutti.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sion l'ha udito, e se n'è rallegrata;","poem":1},{"lineBreak":true},{"text":"E le figliuole di Giuda hanno festeggiato","poem":1},{"lineBreak":true},{"text":"Per li tuoi giudicii, o Signore.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Perciocchè tu sei il Signore, l'Eccelso sopra tutta la terra;","poem":1},{"lineBreak":true},{"text":"Tu sei grandemente innalzato sopra tutti gl'iddii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Voi che amate il Signore, odiate il male;","poem":1},{"lineBreak":true},{"text":"Egli guarda le anime de' suoi santi;","poem":1},{"lineBreak":true},{"text":"E le riscuote di man degli empi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"La luce è seminata al giusto;","poem":1},{"lineBreak":true},{"text":"E l'allegrezza a quelli che son diritti di cuore.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Rallegratevi, o giusti, nel Signore;","poem":1},{"lineBreak":true},{"text":"E celebrate la memoria della sua santità.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}