{"translation":{"id":"ita_dio","name":"Diodati Bibbia 1885","website":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ita1885","licenseNotes":null,"shortName":"DIO","englishName":"Italian Diodati Bible","language":"ita","textDirection":"ltr","sha256":"f05c7117e8762eab20336c843ce56b6fe5b5e8c4cab3e53402252009b70e6b9b","availableFormats":["json"],"listOfBooksApiLink":"/api/ita_dio/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"italiano","languageEnglishName":"Italian"},"book":{"id":"PSA","translationId":"ita_dio","name":"SALMI","commonName":"SALMI","title":"IL LIBRO DE' SALMI","order":19,"numberOfChapters":150,"sha256":"2823ed2746d6ad163100f93c3bd802994c1e5b28461145bdb5a633976be8d8ea","firstChapterNumber":1,"firstChapterApiLink":"/api/ita_dio/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ita_dio/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":98,"content":[{"type":"heading","content":["Dio lodato per la proclamazione della salute"]},{"type":"hebrew_subtitle","content":["Salmo"]},{"type":"verse","number":1,"content":[{"text":"CANTATE al Signore un nuovo cantico;","poem":1},{"lineBreak":true},{"text":"Perciocchè egli ha fatte maraviglie;","poem":1},{"lineBreak":true},{"text":"La sua destra e il braccio della sua santità gli hanno acquistata salute.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Il Signore ha fatta conoscer la sua salute;","poem":1},{"lineBreak":true},{"text":"Egli ha manifestata la sua giustizia nel cospetto delle genti.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Egli si è ricordato della sua benignità, e della sua verità,","poem":1},{"lineBreak":true},{"text":"Verso la casa d'Israele;","poem":1},{"lineBreak":true},{"text":"Tutte le estremità della terra hanno veduta la salute del nostro Dio.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"O abitanti di tutta la terra,","poem":1},{"lineBreak":true},{"text":"Giubilate al Signore;","poem":1},{"lineBreak":true},{"text":"Risonate, cantate, e salmeggiate.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Salmeggiate al Signore colla cetera.","poem":1},{"lineBreak":true},{"text":"Colla cetera giunta alla voce di canto.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Date voci d'allegrezza con trombe, e suon di corno,","poem":1},{"lineBreak":true},{"text":"Nel cospetto del Re, del Signore.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Rimbombi il mare, e ciò che è in esso;","poem":1},{"lineBreak":true},{"text":"Il mondo, e i suoi abitanti.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Battansi i fiumi a palme;","poem":1},{"lineBreak":true},{"text":"Cantino d'allegrezza tutti i monti.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nel cospetto del Signore; perciocchè egli viene per giudicar la terra;","poem":1},{"lineBreak":true},{"text":"Egli giudicherà il mondo in giustizia,","poem":1},{"lineBreak":true},{"text":"E i popoli in dirittura.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ita_dio/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_dio/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_dio/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}