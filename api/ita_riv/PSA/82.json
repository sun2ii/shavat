a eredità."]}],"footnotes":[]},"thisChapterLink":"/api/ita_riv/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ita_riv/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ita_riv/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}