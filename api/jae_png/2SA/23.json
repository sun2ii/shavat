{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"2SA","translationId":"jae_png","name":"SAMUELNÊ 2","commonName":"SAMUELNÊ 2","title":"Samuelnê Buku Kêtu Luagêcŋa","order":10,"numberOfChapters":16,"sha256":"82eb6ec2ee621be337b8b18618a5e29eb14900ceb2e06366ed3a698791b9a880","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/2SA/1.json","lastChapterNumber":23,"lastChapterApiLink":"/api/jae_png/2SA/23.json","totalNumberOfVerses":411},"chapter":{"number":23,"content":[{"type":"heading","content":["Dawidnê awamu"]},{"type":"verse","number":1,"content":["Biŋ tonec kêtu Dawidnê awamu",{"text":"“Isai latu Dawid kêsôm biŋ.","poem":1},{"lineBreak":true},{"text":"Ŋac taŋ tetoc eŋ sa naŋ, kêsôm biŋ.","poem":1},{"lineBreak":true},{"text":"Jakobnê Anôtô nê ŋac seŋ oso eŋŋa.","poem":1},{"lineBreak":true},{"text":"Ŋac gêga Israelnê wê ŋajamwaga.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“Apômtaunê Ŋalau kêsôm biŋ kêsa aê aoc,","poem":1},{"lineBreak":true},{"text":"ma ênê biŋ gêc aê imbeloc.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Israelnêŋ Anôtô kêsôm biŋ.","poem":1},{"lineBreak":true},{"text":"Israelnêŋ lamu kêsôm biŋ gêdêŋ aê.","poem":1},{"lineBreak":true},{"text":"Ŋac taŋ kêtêc Anôtô","poem":1},{"lineBreak":true},{"text":"ma gêjam gôliŋ ŋamalac ŋaŋêŋgeŋ naŋ,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"kêpô êsêac kêtôm ŋawê bêbêcgeŋŋa,","poem":1},{"lineBreak":true},{"text":"kêtôm oc, taŋ kêpi toŋagêlôm masi naŋ, ma gêgôm gêgwaŋ, taŋ kom gêjac naŋ kêpuc.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aêŋoc gôlôac sêmoa sêwiŋ Anôtô","poem":1},{"lineBreak":true},{"text":"gebe eŋ kêmoatiŋ poac teŋgeŋŋa teŋ gêwiŋ aê ma kêmasaŋ gêŋ samob ŋapep ma ênêc teŋgeŋ,","poem":1},{"lineBreak":true},{"text":"gebe eŋ oc êkêŋ aê gebe jamoa ŋajam","poem":1},{"lineBreak":true},{"text":"ma gêŋ taŋ ŋoc ŋalêlôm têtac gêwiŋ naŋ, eŋ êŋgôm esewec.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mago lau, taŋ sêmoa jaêc Anôtô naŋ, têtôm gêŋ têkwa-têkwa,","poem":1},{"lineBreak":true},{"text":"taŋ tambaliŋ siŋ naŋ, gebe tatôm gebe takôc ŋa lemeŋ atom.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mago ŋac taŋ gebe ejoŋ gêŋ tau sa naŋ,","poem":1},{"lineBreak":true},{"text":"êkôc siŋ to kêm ŋadambê ma ja êniŋ gêŋ tau êmbacnê samucgeŋ.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/jae_png/2SA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/1KI/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/2SA/22.json","previousChapterAudioLinks":{},"numberOfVerses":7}