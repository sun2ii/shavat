{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"ISA","translationId":"jae_png","name":"JESAIA","commonName":"JESAIA","title":"Jesaia","order":23,"numberOfChapters":35,"sha256":"189c1220c4e80cde5b97e522c00ac074b1a0ef05bdd1cbbf83b4ce3b183640d8","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/jae_png/ISA/66.json","totalNumberOfVerses":588},"chapter":{"number":12,"content":[{"type":"heading","content":["Wê tanam daŋgeŋa"]},{"type":"verse","number":1,"content":[{"text":"Êndêŋ bêc tônê aôm oc ôsôm gebe","poem":1},{"lineBreak":true},{"text":"“O Apômtau, aê gabe janam daŋge êndêŋ aôm","poem":1},{"lineBreak":true},{"text":"gebe têmtac ŋandaŋ gêdêŋ aê,","poem":1},{"lineBreak":true},{"text":"mago gôjam têmtac ŋandaŋ tau ôkwi","poem":1},{"lineBreak":true},{"text":"ma gôjac aê têtac tôŋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Alicgac me, Anôtô kêtu ŋoc moasiŋ ŋamôkê,","poem":1},{"lineBreak":true},{"text":"tec gamoa taêc kêpa sugeŋ ma katêc tauc atom,","poem":1},{"lineBreak":true},{"text":"gebe Apômtau Anôtô eŋ kêtu ŋoc ŋaclai to ŋoc wê lambiŋŋa","poem":1},{"lineBreak":true},{"text":"ma kêtu ŋoc kêsiwaga.”","poem":1}]},{"type":"verse","number":3,"content":["Amac oc atê bu aŋga bumata daŋgôŋ mateŋ jaliŋa totêmtac ŋajamgeŋ."]},{"type":"verse","number":4,"content":["Ma êndêŋ bêc tônê amac oc asôm gebe",{"text":"“Anam daŋge êndêŋ Apômtau, awem ênac ênê ŋaê.","poem":1},{"lineBreak":true},{"text":"Asôm ênê gêŋsêga ŋawae êtu tapa aŋga lau samuc nêŋ.","poem":1},{"lineBreak":true},{"text":"Asôm lasê gebe ênê ŋaê towae.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Anam wê lanemŋa êndêŋ Apômtau gebe gêgôm gêŋsêga toŋaclai.","poem":1},{"lineBreak":true},{"text":"Naasôm ŋawae ênam nom ŋagamêŋ samob auc.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"O amac lau Sionŋa, anam lasê ma anam wê toôndugeŋ","poem":1},{"lineBreak":true},{"text":"gebe Israel nêŋ ŋac Dabuŋ eŋ kapôêŋ ma gêmoa amac ŋalêlôm.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/jae_png/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/ISA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}