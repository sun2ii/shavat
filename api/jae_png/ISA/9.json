{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"ISA","translationId":"jae_png","name":"JESAIA","commonName":"JESAIA","title":"Jesaia","order":23,"numberOfChapters":35,"sha256":"189c1220c4e80cde5b97e522c00ac074b1a0ef05bdd1cbbf83b4ce3b183640d8","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/jae_png/ISA/66.json","totalNumberOfVerses":588},"chapter":{"number":9,"content":[{"type":"heading","content":["Têna kêkôc biŋmalô ŋatau ma eŋ kêkôc nê gôliŋ sa"]},{"type":"verse","number":1,"content":[{"text":"Lau taŋ sêŋgôŋ gêsuŋbôm naŋ, sêlic ja kapôêŋ teŋ.","poem":1},{"lineBreak":true},{"text":"Ma ŋawê kêpô êsêac, taŋ sêŋgôŋ gêmac ŋagamêŋ kanucŋa naŋ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aôm kôkêŋ lau têtu taêsam","poem":1},{"lineBreak":true},{"text":"ma gôgôm êsêac têntac ŋajam gêjam sêga.","poem":1},{"lineBreak":true},{"text":"Êsêac sêmoa aôm laŋômnêmŋa toôliŋ kêpigeŋ","poem":1},{"lineBreak":true},{"text":"têtôm lau, taŋ seŋ mo lasê naŋ,","poem":1},{"lineBreak":true},{"text":"ma amboac lau, taŋ sêjac sam ŋacjonêŋ awamata.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gebe gêŋwapac ŋata, taŋ gêsac êsêac naŋ,","poem":1},{"lineBreak":true},{"text":"ma tôc magiŋmŋa to nêŋ ŋac, taŋ kêlêsu êsêac naŋ, nê sêm","poem":1},{"lineBreak":true},{"text":"naŋ aôm kôpôŋ tulu toc tageŋ amboac gêdêŋ Midiannê têm.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gebe siŋwaganêŋ atapa samob","poem":1},{"lineBreak":true},{"text":"to nêŋ ŋakwê siŋŋa, taŋ dec gi auc naŋ,","poem":1},{"lineBreak":true},{"text":"êsa ja ma êniŋ su.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gebe awê teŋ kêkôc ŋapalê teŋ kêtu aêacŋa,","poem":1},{"lineBreak":true},{"text":"kêkêŋ latu teŋ gêdêŋ aêac gêmêŋ.","poem":1},{"lineBreak":true},{"text":"Ŋagôliŋ gêsac eŋ magim ma sêsam eŋ gebe","poem":1},{"lineBreak":true},{"text":"“Mêtêŋam, Laimôkê, Teŋgeŋŋam, Biŋmalôtau.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ênê gôliŋ oc ênam sêga,","poem":1},{"lineBreak":true},{"text":"ma biŋmalô oc ênêc teŋgeŋ","poem":1},{"lineBreak":true},{"text":"aŋga Dawidnê lêpôŋ to nê gamêŋ kiŋŋa.","poem":1},{"lineBreak":true},{"text":"Gebe eŋ oc ênac m ŋagôliŋ tau to êpuc tôŋ","poem":1},{"lineBreak":true},{"text":"ŋa mêtôc gêdêŋ to biŋ gêdêŋ","poem":1},{"lineBreak":true},{"text":"êndêŋ galoc ma endeŋ tôŋgeŋ.","poem":1},{"lineBreak":true},{"text":"Lausiŋ undambêŋa nêŋ Apômtau nê ŋalêlôm kêkac eŋ,","poem":1},{"lineBreak":true},{"text":"tec êŋgôm biŋ tonaŋ êtu tôŋ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/jae_png/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/ISA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/ISA/8.json","previousChapterAudioLinks":{},"numberOfVerses":6}