{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"JOL","translationId":"jae_png","name":"JOEL","commonName":"JOEL","title":"Joel","order":29,"numberOfChapters":3,"sha256":"72826df4c521b272174cd61d484979d074a8abf2582a2faf484255e17c9dcf4f","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/jae_png/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Apômtaunê biŋ gêdêŋ Petuel latu Joel tau tonec."]},{"type":"heading","content":["Taŋiboa kêtu saseŋ gêŋ taniŋŋa"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Amac lau ŋanôac, aŋô biŋ","poem":1},{"lineBreak":true},{"text":"to amac lau gamêŋ tonecŋa, akêŋ taŋem.","poem":1},{"lineBreak":true},{"text":"Amac alic gêŋsêga amboac tec teŋ ŋanô kêsa","poem":1},{"lineBreak":true},{"text":"gêdêŋ amacnêm têm me gêdêŋ abeminêŋ têm me masi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Anac ŋamiŋ êndêŋ nêm gôlôac wakuc sêŋô.","poem":1},{"lineBreak":true},{"text":"Êsêac sênac ŋamiŋ êndêŋ nêŋ wakuc ma elom-elom amboac tonaŋgeŋ êna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Gêŋ taŋ wagô-kêlêŋa dedec gêcŋa naŋ,","poem":1},{"lineBreak":true},{"text":"wagô-sêboaŋŋa mêŋseŋ.","poem":1},{"lineBreak":true},{"text":"Ma gêŋ taŋ wagô-sêboaŋŋa dedec gêcŋa naŋ,","poem":1},{"lineBreak":true},{"text":"wagô-sêlôpŋa mêŋseŋ.","poem":1},{"lineBreak":true},{"text":"Go gêŋ taŋ wagô-sêlôpŋa dedec gêcŋa naŋ,","poem":1},{"lineBreak":true},{"text":"wagô-ŋatêna-kêsaŋa mêŋseŋ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Amac anôm-gêŋ-anaboawaga, matem êlac ma ataŋ lasêmaŋ.","poem":1},{"lineBreak":true},{"text":"Amac anôm-wainwaga samob, apuc taŋiboa sa","poem":1},{"lineBreak":true},{"text":"êtu wain ŋakanaŋa,","poem":1},{"lineBreak":true},{"text":"taŋ sêkac su aŋga awemsuŋ naŋ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gebe lau-m teŋ sêwê sêpi mêŋsêjam aêŋoc gamêŋ auc,","poem":1},{"lineBreak":true},{"text":"lau ŋactêkwa ma taêsam ŋanô lasê.","poem":1},{"lineBreak":true},{"text":"Luŋluŋ kêtôm lewe kapoac nê","poem":1},{"lineBreak":true},{"text":"ma ŋani amboac lewe têna nê.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Êsêac seseŋ aêŋoc wain ŋamôkê su","poem":1},{"lineBreak":true},{"text":"ma sêsap ŋoc jambô tulu.","poem":1},{"lineBreak":true},{"text":"Êsêac selec ŋaôlic su sêbaliŋ siŋ jagêc nom","poem":1},{"lineBreak":true},{"text":"e ŋalaka ŋapom ŋaôma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ataŋ taŋiboa amboac awêtakiŋ, taŋ gêjam abec","poem":1},{"lineBreak":true},{"text":"kêtu nê ŋac, taŋ sê gêdêŋ eŋ naŋŋa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Êsêac sêkêŋ gêŋ taniŋŋa to gêŋ tanômŋa kêtu da","poem":1},{"lineBreak":true},{"text":"aŋga Apômtaunê andu kêtiam atom.","poem":1},{"lineBreak":true},{"text":"Apômtaunê sakiŋwaga, dabuŋwaga tauŋ,","poem":1},{"lineBreak":true},{"text":"sêpuc taŋiboa sa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kôm tau kêtu gasaŋ","poem":1},{"lineBreak":true},{"text":"nom tau kêtaŋ","poem":1},{"lineBreak":true},{"text":"gebe sêjaiŋ kôm ŋanô gêjaŋa,","poem":1},{"lineBreak":true},{"text":"wain ŋanô kêmêliŋ ma niptêkwi kêpa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"O kômwagaac, nêm ŋalêlôm êôc auc","poem":1},{"lineBreak":true},{"text":"ma kômwaga wainŋaac, ataŋmaŋ.","poem":1},{"lineBreak":true},{"text":"Kêtu jaŋgom to polomŋa","poem":1},{"lineBreak":true},{"text":"gebe kôm ŋanô kêtu sec su.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wain ŋamôkê kêmêliŋ","poem":1},{"lineBreak":true},{"text":"ma jambô kêsêlic.","poem":1},{"lineBreak":true},{"text":"Aiŋ to nip ma uc","poem":1},{"lineBreak":true},{"text":"to gêŋkaiŋ samob kêtu masê aŋga sêŋam.","poem":1},{"lineBreak":true},{"text":"Ma têntac ŋajam","poem":1},{"lineBreak":true},{"text":"gêc su aŋga ŋamalacnêŋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"O dabuŋwagaac, asô talu sa ma ataŋ.","poem":1},{"lineBreak":true},{"text":"O sakiŋwaga altarŋa, anam taŋiboa sa.","poem":1},{"lineBreak":true},{"text":"Ŋoc Anôtônê sakiŋwagaac, amêŋ","poem":1},{"lineBreak":true},{"text":"tonêm abecgeŋ","poem":1},{"lineBreak":true},{"text":"gebe sêgamiŋ gêŋ taniŋŋa to gêŋ tanômŋa ma sêkêŋ kêtu da","poem":1},{"lineBreak":true},{"text":"aŋga nêm Anôtônê andu kêtiam atom.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Akêŋ noc anam dabuŋŋa teŋ.","poem":1},{"lineBreak":true},{"text":"Akalem gôlôac sêpi tageŋ.","poem":1},{"lineBreak":true},{"text":"Akac kasêga to gamêŋ ŋatau samob sa sêpi tageŋ","poem":1},{"lineBreak":true},{"text":"dêndêŋ Apômtau, amacnêm Anôtô, nê andu,","poem":1},{"lineBreak":true},{"text":"go awam ênac Apômtau.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ojae, bêcsêga taugoc.","poem":1},{"lineBreak":true},{"text":"Apômtaunê bêc kêdabiŋ ma mêŋgêô lasê","poem":1},{"lineBreak":true},{"text":"amboac gêŋ ŋaclai mêŋkêpoa lasê","poem":1},{"lineBreak":true},{"text":"aŋga Ŋajaŋa Ŋatau nê.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Sêkac gêŋ taniŋŋa su","poem":1},{"lineBreak":true},{"text":"gêdêŋ aêac mateŋanô atom me.","poem":1},{"lineBreak":true},{"text":"Ma têntac ŋajam to ôliŋ kêpi","poem":1},{"lineBreak":true},{"text":"gêwi aêacnêŋ Anôtô nê andu siŋ atom me.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Gêŋ ŋawê kêtu matê aŋga nom ŋalêlôm","poem":1},{"lineBreak":true},{"text":"lêsucm kêpô lêtêŋ","poem":1},{"lineBreak":true},{"text":"ma andu gêŋ ŋanôŋa kêku","poem":1},{"lineBreak":true},{"text":"gebe kôm ŋanô masi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Bôc têtaŋ gêŋ","poem":1},{"lineBreak":true},{"text":"ma bulimakao ŋatoŋ sêmoa jageo","poem":1},{"lineBreak":true},{"text":"ma têtap gêgwaŋ sa atom","poem":1},{"lineBreak":true},{"text":"ma domba totoŋ-totoŋ sêpô lêna tauŋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"O Apômtau, aê aoc gêjac aôm, gebe ja geŋ","poem":1},{"lineBreak":true},{"text":"gêgwaŋ ŋamêdôb aŋga oba","poem":1},{"lineBreak":true},{"text":"ma jawaô kêsêgô","poem":1},{"lineBreak":true},{"text":"gêŋkaiŋ samob aŋga sêŋam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Bôc saleŋŋa aweŋ ec-ecgeŋ têtaŋ gêdêŋ aôm","poem":1},{"lineBreak":true},{"text":"gebe bu kêpa","poem":1},{"lineBreak":true},{"text":"ma ja geŋ","poem":1},{"lineBreak":true},{"text":"gêgwaŋ ŋamêdôb aŋga oba.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/jae_png/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}