{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"JON","translationId":"jae_png","name":"JONA","commonName":"JONA","title":"Jona","order":32,"numberOfChapters":4,"sha256":"fd9a308f433782d3e4658dfc08569c3592bb98157d77db3ed6c19474425ae758","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/jae_png/JON/4.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["Jona gêjam daŋge Apômtau"]},{"type":"verse","number":1,"content":["Ma Apômtau kêkêŋ i kapôêŋ teŋ gebe êndaŋgôŋ Jona. Ma Jona gêmoa i têtaclêlôm geleŋŋa têlêac ma gêbêcauc têlêac."]},{"type":"verse","number":2,"content":["Go Jona keteŋ mec gêdêŋ nê Apômtau Anôtô gêŋgôŋ i têtaclêlôm"]},{"type":"verse","number":3,"content":["ma kêsôm gebe",{"text":"“Aê kapô lêna tau ŋanô ma aoc gêjac Apômtau,","poem":1},{"lineBreak":true},{"text":"tec eŋ kêkêŋ taŋa aê.","poem":1},{"lineBreak":true},{"text":"Aê gamôêc aŋga lamboam ŋalêlôm","poem":1},{"lineBreak":true},{"text":"ma aôm gôê taŋam aê aoc.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aôm kôbaliŋ aê kasêp gwêc ŋagêdimbob gaja,","poem":1},{"lineBreak":true},{"text":"kasêp gwêc ŋaluŋgeŋ,","poem":1},{"lineBreak":true},{"text":"ma ŋasamac gêjam aê auc,","poem":1},{"lineBreak":true},{"text":"aômnêm dembom to ŋakôtôŋ-kôtôŋ samob kêsalê aê auc.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma aê taêc gêjam gebe ‘Aôm kôtiŋ aê su aŋga laŋômnêm,","poem":1},{"lineBreak":true},{"text":"ma oc jaŋgôm amboac ondoc gebe matocanô êpi nêm lôm dabuŋ êtiam.’","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gwêc ŋasamac mêŋgêdêŋ ŋoc koclabeŋ,","poem":1},{"lineBreak":true},{"text":"ŋagêdimbob kêmakop aê auc","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"aŋga lôc ŋanombaŋ tau.","poem":1},{"lineBreak":true},{"text":"Kasêp nom ŋalêlôm gaja","poem":1},{"lineBreak":true},{"text":"ma ŋakatam ŋajaŋa kêsa gêc gedeŋ tôŋgeŋ.","poem":1},{"lineBreak":true},{"text":"Mago aôm, o ŋoc Apômtau Anôtô,","poem":1},{"lineBreak":true},{"text":"gôê aê sa aŋga gêsuŋ ŋakêlêndiŋ gamoa matoc jali.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gêdêŋ taŋ katuc kêpô lêna tau êndu-êndu naŋ,","poem":1},{"lineBreak":true},{"text":"aê taêc gêjam Apômtau,","poem":1},{"lineBreak":true},{"text":"ma ŋoc mec gêdêŋ aôm","poem":1},{"lineBreak":true},{"text":"kêsô nêm lôm dabuŋ gêwac.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Êsêac taŋ sêsap gwam ŋaôma tôŋ naŋ,","poem":1},{"lineBreak":true},{"text":"sêwi nêŋ lamuanô tau siŋ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mago aê nec jakêŋ-da êndêŋ aôm todaŋgegeŋ.","poem":1},{"lineBreak":true},{"text":"ma biŋ, taŋ gajac mata naŋ,","poem":1},{"lineBreak":true},{"text":"gabe jaŋgôm ŋanô êsa.","poem":1},{"lineBreak":true},{"text":"Apômtau eŋ gêjam sa ŋamôkê.”","poem":1},"Ma Apômtau kêjatu i jagêluc Jona kêpi bau gêja."]}],"footnotes":[]},"thisChapterLink":"/api/jae_png/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}