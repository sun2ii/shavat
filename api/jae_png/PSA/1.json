{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":1,"content":[{"type":"heading","content":["BUKU KÊTU ŊAMATAŊA"]},{"type":"heading","content":["Lau gêdêŋ to lau sec"]},{"type":"verse","number":1,"content":[{"text":"Aweŋ êôc ŋac, taŋ êsa nê lêŋ êtôm lau,","poem":1},{"text":"taŋ sêkac tauŋ su aŋga Anôtônê naŋ, nêŋ mêtê atom,","poem":2},{"text":"ma êsa lau sec nêŋ lêŋ","poem":1},{"text":"to êŋgôŋ lau-susuwaga ŋalêlôm atom.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ŋac amboac tonaŋ têtac gêwiŋ Apômtaunê biŋsu","poem":1},{"text":"ma taê gêjam ênê biŋsu ŋam kêtôm bêc to geleŋgeŋ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Eŋ kêtom ka sêsê kêkô butali, taŋ gêjam ŋanô kêtôm ŋanocgeŋ naŋ.","poem":1},{"text":"Ŋalauŋ oc êmêliŋ atom, ma gêŋ samob, taŋ eŋ gêgôm naŋ, oc êtap ŋanô sa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lau taŋ sêkac tauŋ su aŋga Anôtônê naŋ, amboac tonaŋ atom.","poem":1},{"text":"Êsêac têtôm ŋapaôma, taŋ mu kelelo sa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Amboac tonaŋ lau-sêkac-tauŋ-suwaga oc sêkô ŋajaŋa êndêŋ noc mêtôcŋa atom,","poem":1},{"text":"ma lau sec sêkô gôlôac ŋalêlôm atom amboac tonaŋ,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"gebe Apômtau kêjala lau gêdêŋ nêŋ lêŋ.","poem":1},{"text":"mago lau-sêkac-tauŋ-suwaga nêŋ lêŋ oc ênaŋa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/jae_png/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}