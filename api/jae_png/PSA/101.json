{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":101,"content":[{"type":"heading","content":["Kiŋ gêjac mata biŋ"]},{"type":"verse","number":1,"content":[{"text":"Aê gabe jaŋga wê api moasiŋ to biŋgêdêŋ.","poem":1},{"text":"O Apômtau, aê gabe janam wê êndêŋ aômgeŋ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Aê gabe jasa lau laŋôŋnêm sawa nêŋ lêŋ","poem":1},{"text":"Aôm oc ôndêŋ aê ômôêŋ êndêŋ ondoc.","poem":2},{"lineBreak":true},{"text":"Aê gabe jaŋgôŋ ŋoc andulêlôm","poem":1},{"text":"toŋoc ŋalêlôm ŋawageŋ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Aê gabe matoc êndiŋ","poem":1},{"text":"gêŋ eso atom.","poem":2},{"text":"Aê jakêŋ kisa êndêŋ êsêac, taŋ sêkac tauŋ su aŋga Anôtônê.","poem":1},{"text":"Biŋ amboac tonaŋ êtap aê sa atom.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ŋalêlôm keso ênac jaê aê.","poem":1},{"text":"Aê gabe janam kauc gêŋ sec.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Aê gabe janseŋ lau,","poem":1},{"text":"taŋ sêgôliŋ biŋ sacgeŋ kêpi nêŋ lau sackapoa gêdô gêdêŋ tauŋ naŋ.","poem":2},{"text":"Lau teŋbeleŋ aŋgeŋ ma êsêac, taŋ nêŋ ŋalêlôm kêkiaŋ tauboa naŋ,","poem":1},{"text":"galic êsêac keso ŋoc ŋalêlôm.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Matoc gê lau, taŋ sêgôm nêŋ gêŋ ŋaŋêŋgeŋ naŋ,","poem":1},{"text":"gebe sêmoa sêwiŋ aê.","poem":2},{"text":"Lau tolaŋôŋnêm sawa","poem":1},{"text":"oc sênam sakiŋ aê.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ŋac teŋ embe ênam biŋ dansaŋ ŋa lêmageŋ","poem":1},{"text":"oc êŋgôŋ ŋoc andu atom.","poem":2},{"text":"Matoc geso lau,","poem":1},{"text":"taŋ sêsôm biŋ dansaŋ sêmoa naŋ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lau samob, taŋ sêgôm biŋ alôb-alôb naŋ,","poem":1},{"text":"janseŋ êsêac su aŋga gamêŋ tonec êtôm bêcgeŋ.","poem":2},{"text":"Ma lau samob, taŋ sêgôm sec naŋ,","poem":1},{"text":"oc janseŋ êliŋ-êliŋ aŋga Apômtaunê malac.","poem":2},{"noteId":66}]}],"footnotes":[{"noteId":66,"caller":"+","text":"Dawidnê pesalem teŋ.","reference":{"chapter":101,"verse":8}}]},"thisChapterLink":"/api/jae_png/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}