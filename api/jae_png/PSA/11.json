{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":11,"content":[{"type":"heading","content":["Lau gedeŋ nêŋ lamu"]},{"type":"verse","number":1,"content":[{"text":"Apômtau kêtu ŋoc lamu. Ma amboac ondoc asôm gêdêŋ aê gebe","poem":1},{"text":"“Ôêc ôpi lôc ôna amboac moc.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gôlicgac me, dedec-Anôtôwaga sêkac tikoc talam ma sêjô sôb e jadiŋgeŋ,","poem":1},{"text":"sebe sêpô lau-ŋalêlôm-gêdêŋwaga êndêŋ gamêŋ ŋakesec.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Embe senseŋ mêtê ŋanombaŋ, naŋ gedeŋ ŋamalac tôŋ naŋ su","poem":1},{"text":"ŋac gêdêŋ oc êsôm ŋabiŋ amboac ondocgeŋ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Apômtau gêmoa nê lôm dabuŋ ŋalêlôm.","poem":1},{"text":"Ênê lêpôŋ kêkô undambê.","poem":2},{"text":"Eŋ mata geso lau gamêŋ samobŋa","poem":1},{"text":"ma gêlic gêŋ, taŋ êsêac sêgôm naŋ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Apômtau kêsaê ŋac gêdêŋ to ŋac, taŋ gedec eŋ naŋ kêtômgeŋ.","poem":1},{"text":"Ma nê ŋalêlôm kêmoatiŋ tôŋ kêtu ŋac, taŋ gêgôm nê gêŋ togôliŋmê naŋŋa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Eŋ kêkêŋ ja to talao gêjac lau sec amboac kom gêjac","poem":1},{"text":"ma kêsakiŋ mu ŋandaŋ kêtu nêŋ gêŋ êlau êsêacŋa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Apômtau eŋ ŋac gêdêŋ ma têtac gêwiŋ biŋgêdêŋ.","poem":1},{"text":"Lau taŋ sêgôm ŋanô kêsa naŋ, oc sêmoa eŋ laŋônêmŋa.","poem":2},"Dawidnê teŋ."]}],"footnotes":[]},"thisChapterLink":"/api/jae_png/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}