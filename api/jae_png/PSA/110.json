{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":110,"content":[{"type":"heading","content":["Apômtau agêc nê kiŋ, taŋ geŋ oso eŋ naŋ"]},{"type":"verse","number":1,"content":[{"text":"Apômtaunê biŋ gêdêŋ ŋoc Apômtau gebe","poem":1},{"text":"“Mêŋôŋgôŋ aêŋoc anôŋa","poem":2},{"text":"e jakêŋ nêm ŋacjo","poem":1},{"text":"sênêc amkaiŋ ŋalabu acgom.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Apômtau êkêŋ nêm gôliŋ ŋaclai esewec aŋga Sion ma êsa êna êtu tapa.","poem":1},{"text":"Ônam gôliŋ nêm ŋacjo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Êndêŋ bêc, taŋ aôm ônac nêm ŋacjo naŋ,","poem":1},{"text":"nêm lau sêwiŋ aôm sênac ŋawaegeŋ.","poem":2},{"text":"Êtôm nop êpoac bêbêc kanucgeŋ","poem":1},{"text":"aômnêm lau mata sêwac êndêŋ aômnêm lôc dabuŋ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Apômtau kêtôc lêma sa su","poem":1},{"text":"ma oc enseŋ nê biŋ atom gebe","poem":2},{"text":"“Aôm kôtu ŋac dabuŋsêga ômoa teŋgeŋŋa","poem":1},{"text":"kôtôm Melkisedek tau.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Apômtau kêkô aômnêm anôŋa.","poem":1},{"text":"Êndêŋ ênê bêc têtac ŋandaŋŋa oc êku kiŋ samob tulu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eŋ oc êmêtôc tenteŋlatunêŋ biŋ ma êkêŋ nêŋ ŋacmatê sênam gamêŋ auc.","poem":1},{"text":"Eŋ ênac lau môkêŋ êkôc aŋga gaboaŋ tapa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kiŋ oc ênôm bu, taŋ kêpoac gêdêŋ intêna ŋatali naŋ,","poem":1},{"text":"amboac tonaŋ tec êsa môkêapac sageŋ.","poem":2},{"noteId":71}]}],"footnotes":[{"noteId":71,"caller":"+","text":"Dawidnê pesalem teŋ.","reference":{"chapter":110,"verse":7}}]},"thisChapterLink":"/api/jae_png/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}