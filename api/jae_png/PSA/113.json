{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":113,"content":[{"type":"heading","content":["Aweŋ êôc moasiŋ ŋatau Anôtô"]},{"type":"verse","number":1,"content":[{"text":"Aleluja.","poem":1},{"lineBreak":true},{"text":"Apômtaunê sakiŋwaga amac,","poem":1},{"text":"alanem Apômtaunê ŋaê","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Aweŋ êôc Apômtaunê ŋaê","poem":1},{"text":"êndêŋ galoc ma ênêc endeŋ tôŋgeŋ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Aweŋ êôc Apômtaunê ŋaê","poem":1},{"text":"aŋga oc kêpi e êndêŋ oc kêsêp.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Apômtau kêlêlêc tenteŋlatui samob su.","poem":1},{"text":"Ênê ŋawasi keleŋ undambê su.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Asa oc êtôm Apomtau, aêacnêŋ Anôtô,","poem":1},{"text":"taŋ gêŋgôŋ nê lêpôŋ aŋga lôlôc naŋ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ŋac tau naŋ gewec,","poem":1},{"text":"go katuc kêniŋ undambê to nom.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Eŋ kêkam ŋalêlôm sawa aŋga kekop","poem":1},{"text":"ma gêôc ŋac kapô lênaŋa sa aŋga wao.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gebe etoc eŋ êŋgôŋ êwiŋ kasêga,","poem":1},{"text":"êŋgôŋ nabaŋ ênê launêŋ kasêga.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Eŋ kêkêŋ awê kapoac gêwê kaiŋ andu","poem":1},{"text":"ma kêkêŋ eŋ kêkôc ŋapalê e têtac ŋajam kêsa laŋgwageŋ.","poem":2},{"lineBreak":true},{"text":"Aleluja.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/jae_png/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}