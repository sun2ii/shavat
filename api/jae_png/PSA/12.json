{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":12,"content":[{"type":"heading","content":["Mec Apômtau ênam aêac saŋa"]},{"type":"verse","number":1,"content":[{"text":"O Apômtau, ônam aêac sa gebe lau mansaŋ têtaiŋ su","poem":1},{"text":"ma lau wapac maleŋmê e gamêŋ kêta êŋ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sêsôm biŋ geo gelom-gelom tau.","poem":1},{"text":"Ac sêsôm nêŋ biŋ aweŋsuŋ geno-genogeŋ ma nêŋ ŋalêlôm gêja lulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ojae, Apômtau enseŋ gêdôŋôlic samob, taŋ seno-seno biŋgeŋ,","poem":1},{"text":"to aweŋsuŋ, taŋ sêboa tauŋboa naŋ, acgommaŋ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lau tonaŋ tec sêsôm gebe “Tauŋma imbeleŋ kêpuc aêac tôŋ to gêdôŋôlic gêjac aêac sa.","poem":1},{"text":"Asa gebe ênam gôliŋ aêac.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Apômtau kêsôm gebe “Aê gabe japuc tauc jandi êtu lau, taŋ sêkôniŋ êsêac sêŋgôŋ jageo to lau ŋagêbôc seŋ oliŋ tauŋ elêmê naŋŋa.","poem":1},{"text":"Aê gabe janam lau, taŋ sêkêŋ mateŋgeŋ gebe janam êsêac saŋa naŋ sa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Apômtaunê biŋ ŋalô ŋakêŋkêŋ","poem":1},{"text":"kêtôm labi naŋ sêjam e ŋakep masi amboac kwalamwaô.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"O Apômtau, ônam jaom lau ŋasec ma ôpuc aêac tôŋ","poem":1},{"text":"êndêŋ lau tônê êtôm têm samob,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"gebe lau geo oc dêndi sêôŋ to sêmboa tauŋ e sênsiŋ aêac auc,","poem":1},{"text":"gebe sec gêjam sêga aŋga ŋamalacnêŋ.","poem":2},"Dawidnê pesalem."]}],"footnotes":[]},"thisChapterLink":"/api/jae_png/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}