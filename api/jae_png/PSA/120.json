{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":120,"content":[{"type":"heading","content":["Apômtau ênam aê sa aŋga kalomtênanêŋ"]},{"type":"verse","number":1,"content":[{"text":"Aê kapô lêna ma aoc gêjac Apômtau,","poem":1},{"text":"tec eŋ kêkêŋ taŋa aê.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"O Apômtau, ônam aê kêsi aŋga gêdôŋôlic dansaŋ","poem":1},{"text":"ma aŋga imbeleŋ geo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Aôm imbêlam geo,","poem":1},{"text":"Ŋatau oc êkêŋ asageŋ êndêŋ aôm ma êŋgôm aôm amboac ondoc.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Oc êkêŋ siŋwaganê sôb bôjaŋ-bôjaŋ","poem":1},{"text":"ma sôb tojalana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ijoc aêma, tec gaŋgôŋ Mesek,","poem":1},{"text":"tec gaŋgôŋ Kedarnêŋ becobo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Aê gaŋgôŋ gawiŋ lau,","poem":1},{"text":"taŋ sêkêŋ kisa gêdêŋ biŋmalô naŋ kêtômgac.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Aê ŋac biŋmalôŋa, mago êndêŋ taŋ jasôm biŋ wamaŋa naŋ,","poem":1},{"text":"êsêac sêndi êtu siŋŋa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/jae_png/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}