{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":121,"content":[{"type":"heading","content":["Ŋac taŋ gejob Israel ŋaŋêŋ naŋ"]},{"type":"verse","number":1,"content":[{"text":"Aê gaôc matocanô sa kêpi lôc.","poem":1},{"text":"Ŋoc ênam-aê-sawaga mêŋêsa aŋga ondoc.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Apômtau taŋ kêkêŋ undambê to nom naŋ,","poem":1},{"text":"oc ênam aê sa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Eŋ oc êkêŋ amkaiŋ êka selelec atom.","poem":1},{"text":"Ŋac taŋ gejob aôm naŋ, ênac tuluc atom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Biŋŋanô, ŋac-gejob-Israelwaga","poem":1},{"text":"gêjac tuluc to gêc bêc atom.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Apômtau kêtu nêm gejobwaga. Apômtau kêtu nêm ajuŋ,","poem":1},{"text":"taŋ lêmam anôŋa kêsô ŋalabu naŋ,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"gebe oc êpac aôm êndêŋ ocsalô atom,","poem":1},{"text":"ma ajôŋ êpô aôm êndêŋ êmbêc atom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Apômtau ejop aôm êndêŋ gêŋ sec samob,","poem":1},{"text":"eŋ gejob aôm katôm.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Apômtau oc ejop aôm êndêŋ taŋ ôsa ôna ma ôsô ômôêŋ naŋ,","poem":1},{"text":"galoc ma endeŋ tôŋgeŋ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/jae_png/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}