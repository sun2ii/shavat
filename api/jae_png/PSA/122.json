{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":122,"content":[{"type":"heading","content":["Biŋmalô ênêc Jerusalem ŋamec"]},{"type":"verse","number":1,"content":[{"text":"Aê gaŋô lau sêsôm gêdêŋ aê gebe “Tawê dandêŋ Apômtaunê andu tana”","poem":1},{"text":"ma gêgôm aê têtac ŋajamanô.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"O Jerusalem,","poem":1},{"text":"galoc eŋkaiŋ kêka aômnêm sacgêdô tôŋgac.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"O Jerusalem, sêkwê aôm sa kêtiam","poem":1},{"text":"kêtôm malac, taŋ tuŋbôm kêpiŋ auc e ŋajaŋa naŋ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gôlôac to gôlôac sêpi gamêŋ tonaŋ","poem":1},{"text":"Apômtau tau nê gôlôac sêpi-sêpi sêmoa","poem":2},{"text":"êtôm eŋ kêjatu êsêac","poem":1},{"text":"gebe sêlanem Apômtaunê ŋaê.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Aŋga tonaŋ tec tetoc lêpôŋ sêmêtôc biŋŋa kêkô,","poem":1},{"text":"tetoc Dawidnê gôlôacnêŋ lêpôŋ kêkô.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ateŋ mec êtu Jerusalem êtap biŋmalô saŋa.","poem":1},{"text":"Êsêac taŋ têntac gêwiŋ aôm naŋ, sêmoa ŋajamgeŋ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wama ênêc nêm tuŋbôm ŋalêlôm","poem":1},{"text":"ma biŋmalô ênêc nêm andu ŋalêlôm.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Aê gabe jasôm gebe “Biŋmalô êndêŋ aôm”","poem":1},{"text":"êtu ŋoc lasitêwai to ŋoc ŋacŋa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Aê gabe jateŋ moasiŋ êtu aômŋa,","poem":1},{"text":"êtu Apômtau, aêacnêŋ Anôtônê anduŋa.","poem":2},{"noteId":72}]}],"footnotes":[{"noteId":72,"caller":"+","text":"Dawidnê teŋ.","reference":{"chapter":122,"verse":9}}]},"thisChapterLink":"/api/jae_png/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}