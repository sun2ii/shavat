{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":123,"content":[{"type":"heading","content":["Mec Apômtau taê walô aêacŋa"]},{"type":"verse","number":1,"content":[{"text":"Aê jaôc matocanô sa wacêpi aôm.","poem":1},{"text":"Matocanô endec undambê, taŋ gôjam gôliŋ gôŋgôŋ naŋ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Aêac tatôm sakiŋwaga, taŋ mataanô êndêŋ nê ŋatau to sakiŋwagao, taŋ mataanô gêdêŋ nê ŋatauo,","poem":1},{"text":"tec aêac mateŋanô êndêŋ Apômtau, aêacnêŋ Anôtô, e taê walô aêac.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O Apômtau, taêm walô aêac, taêm walô aêacmêŋ.","poem":1},{"text":"Aêac aŋô lau sêbu aêac e kêmasê aêac sa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lau sêkêli tauŋ nêŋ pêlê to teŋbeleŋ aŋgeŋ nêŋ biŋ susu","poem":1},{"text":"kêmasê aêac katuŋ sa kêlêlêc.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/jae_png/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}