{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":124,"content":[{"type":"heading","content":["Anôtô gêjam Israel sa, tec sêlambiŋ eŋ"]},{"type":"verse","number":1,"content":[{"text":"Israel galoc sêsôm acgom gebe","poem":1},{"text":"“Apômtau embe êmoa êwiŋ aêac atom, oc amboac ondoc.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gêdêŋ taŋ ŋamalac dêdi sebe sênac aêac naŋ,","poem":1},{"text":"Apômtau embe êmoa êwiŋ aêac atom,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"oc têndaŋgôŋ aêac su tomateŋ jaligeŋ","poem":1},{"text":"ma senseŋ aêac su êtu nêŋ têntac ŋandaŋ secanôŋa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bu ŋasamac oc epeŋ aêac lênsôŋ","poem":1},{"text":"ma êc aêac su","poem":2}]},{"type":"verse","number":5,"content":[{"text":"e ŋasamac ŋakotoŋ-kotoŋ","poem":1},{"text":"ênsaŋ aêac auc.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Aêac aweŋ êôc Apômtau gebe gêsuŋ aêac dadêŋ ŋacjo luŋluŋ","poem":1},{"text":"jakêkaku aêac popoc atom.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Aêac katuŋ gêwê sa kêtôm moc gêwê dibwaganê lakô sa.","poem":1},{"text":"Lakô tau gêŋgic ma aêac tec tajam samuc.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Apômtau taŋ kêkêŋ undambê to nom naŋ,","poem":1},{"text":"nê ŋaê oc ênam aêac sa.","poem":2},{"noteId":73}]}],"footnotes":[{"noteId":73,"caller":"+","text":"Dawidnê teŋ.","reference":{"chapter":124,"verse":8}}]},"thisChapterLink":"/api/jae_png/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}