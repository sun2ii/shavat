{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":125,"content":[{"type":"heading","content":["Anôtô kêtu nê lau Israel nêŋ lamu"]},{"type":"verse","number":1,"content":[{"text":"Lau taŋ ôliŋ andaŋ Apômtau naŋ, têtôm lôc Sion,","poem":1},{"text":"taŋ oc kôjô-kôjô atom, êkô ŋaŋêŋ endeŋ tôŋgeŋ naŋ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lôc kêgi Jerusalem auc ma Apômtau kêgi nê lau auc kêtôm tonaŋ.","poem":1},{"text":"Gagôm gêdêŋ galoc ma oc endeŋ tôŋgeŋ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lau alôb-alôb sênam gôliŋ lau gêdêŋ nêŋ gamêŋ ŋapaŋ atom.","poem":1},{"text":"Embe sêŋgôm, go lau gêdêŋ tauŋ oc sêŋgôm sec.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"O Apômtau, ômoasiŋ lau ŋajam","poem":1},{"text":"to êsêac, taŋ taŋeŋ wamu aômnêm jatu naŋ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ma êsêac, taŋ seo sic naŋ,","poem":1},{"text":"Apômtau ôtiŋ êsêac su nasêwiŋ lau geowaga.","poem":2},{"lineBreak":true},{"text":"O Israel, biŋmalô êndêŋ aômmaŋ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/jae_png/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}