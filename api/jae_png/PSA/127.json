{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":127,"content":[{"type":"heading","content":["Anôtônê mec tageŋ ênam aêac sa"]},{"type":"verse","number":1,"content":[{"text":"Apômtau embe êkwê andu atom,","poem":1},{"text":"oc lau tauŋ sênam ŋakoleŋ elêmê.","poem":2},{"text":"Apômtau embe ejop malac atom,","poem":1},{"text":"oc keleŋwaga sênam jali êtôm atom.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amac embe andi êndêŋ bêbêc kanucgeŋ","poem":1},{"text":"ma anam kôm e êmbêcauc","poem":2},{"text":"gebe atap gêŋ êôc amac tôŋŋa sa, oc aŋgôm elêmê.","poem":1},{"text":"Ŋam gebe Anôtônê lau têtac gêwiŋ êsêacŋa têtap nêŋ gêŋ sa êndêŋ taŋ sênêc bêc naŋ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Latuŋi têtu Anôtônê moasiŋ gêdêŋ aêac","poem":1},{"text":"ma eŋ gêjam mec aêac ŋa gôlôac tau.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lau matac latuŋi","poem":1},{"text":"têtôm sôb, taŋ kêsêp siŋwaga lêma naŋ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Aê aoc êôc ŋac,","poem":1},{"text":"taŋ kêbic nê sôb tolagic-tolagic naŋ.","poem":2},{"text":"Ŋac tonaŋ embe êmansaŋ nê biŋ êndêŋ nê soŋo-soŋo aŋga malac ŋasacgêdô,","poem":1},{"text":"oc sêŋgôm eŋ maja êsa atom.","poem":2},{"noteId":74}]}],"footnotes":[{"noteId":74,"caller":"+","text":"Salomonê teŋ.","reference":{"chapter":127,"verse":5}}]},"thisChapterLink":"/api/jae_png/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}