number":6,"content":[{"text":"ma ôlic nêm ŋapalênêŋ wakuc.","poem":1},{"text":"O Israel, biŋmalô êndêŋ aômmaŋ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/jae_png/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}