{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":129,"content":[{"type":"heading","content":["Israel sêôc gêŋwapac ma Apômtau gêjam êsêac sa"]},{"type":"verse","number":1,"content":[{"text":"Israel embe êsôm nê biŋ teŋ, oc êsôm, nê biŋ tonec lasê gebe","poem":1},{"text":"“Aê ŋapalêgeŋ ma sêlêsu aê ŋasec.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Biŋŋanô, aê ŋapalêgeŋ ma sêlêsu aê ŋasec,","poem":1},{"text":"mago sêkôniŋ aê tôŋ atom.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lau sakweŋtêna sêsêlê aê dêmôêctêkwa","poem":1},{"text":"e popoc jamuŋ-jamuŋgeŋ,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"mago ŋac gêdêŋ Apômtau gêdim lakô,","poem":1},{"text":"taŋ lau sec sêwa su naŋ gêŋgic.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lau samob, taŋ têtac kêbôli auc kêtu Sionŋa naŋ,","poem":1},{"text":"sênu tauŋ su tomajeŋgeŋ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Oc têtôm gêgwaŋ, taŋ kêkô salôm eŋ, ŋaô naŋ,","poem":1},{"text":"êtu kapôêŋ atom tageŋ ma êmêliŋ sebeŋ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ŋanô masi, tec ŋac teŋ ejoŋ sa atom","poem":1},{"text":"ma teŋ ênac lagic gêŋ tau atomanô.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ma ŋac teŋ, taŋ êsa intêna tonaŋ mêŋêlic gêŋ tau naŋ, oc êmôêc gebe “Apômtaunê moasiŋ êpi amac.","poem":1},{"text":"Aêac ajam mec amac ajam Apômtau laŋô” nec atom.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/jae_png/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}