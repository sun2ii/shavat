aê kêsi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Aê janam wê êndêŋ Apômtau","poem":1},{"text":"gebe eŋ kêmoasiŋ aê ŋanô.","poem":2},"Dawidnê pesalem."]}],"footnotes":[]},"thisChapterLink":"/api/jae_png/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}