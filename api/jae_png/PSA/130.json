{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":130,"content":[{"type":"heading","content":["Mec Apômtau ênam aêac saŋa"]},{"type":"verse","number":1,"content":[{"text":"O Apômtau, aê aoc gêjac aôm aŋga ŋakêlêndiŋ sec.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Apômtau, ôkêŋ taŋam aê aoc.","poem":1},{"text":"Ôê taŋam ŋoc taŋiboa kapôêŋ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O Apômtau, aôm embe ôê sec tôŋ,","poem":1},{"text":"o Apômtau, asa oc êkô aôm laŋômnêm.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mago aôm, tec kôsuc biŋ ôkwi,","poem":1},{"text":"amboac tonaŋ tec têtêc aôm.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Aê gaôn Apômtau. noc katuc gêôŋ eŋ,","poem":1},{"text":"tec kakêŋ matoc nê biŋ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ŋoc katuc gêôŋ Apômtau gêmoa,","poem":1},{"text":"gêgôm kêlêlêc ŋac, taŋ gêdib gamêŋ gebe eleŋŋaŋa naŋ su. Gêgôm kêlêlêc dibwaga tonaŋ su biŋŋanôgoc.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Israel, ôkêŋ matam Apômtau","poem":1},{"text":"gebe Apômtau kêtu têtac gêwiŋ teŋgeŋŋa ŋamôkê ma gêjam lau kêsi gêjac ŋawaegeŋ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ma eŋ oc ênam Israel kêsi","poem":1},{"text":"aŋga nêŋ sec samob.","poem":2},{"noteId":75}]}],"footnotes":[{"noteId":75,"caller":"+","text":"Pesalem dambu tauŋŋa kêtu 6ŋa.","reference":{"chapter":130,"verse":8}}]},"thisChapterLink":"/api/jae_png/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}