{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":14,"content":[{"type":"heading","content":["Ŋamalacnêŋ sec"]},{"type":"verse","number":1,"content":[{"text":"Lau meloc tec nêŋ ŋalêlôm kêsôm gêdêŋ tauŋ gebe “Anôtô teŋ gêmoa atomanô.”","poem":1},{"text":"Êsêac sêgôm gêŋ sec to alôb-alôb ma nêŋ teŋ gêgôm gêŋ ŋajam teŋ atom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Apômtau kêtu kêniŋ ŋamalac latuŋi aŋga undambê","poem":1},{"text":"gebe oc êtap ŋac tokauc teŋ, taŋ kêtêc Anôtô naŋ, sa gêmoa me masi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mago êsêac samob sêkac tauŋ su. Samob têtu secŋageŋ.","poem":1},{"text":"Êsêacnêŋ teŋ gêgôm gêŋ ŋajam teŋ atom, masi samucgeŋ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Lau secwaga samob nêŋ kauc gêbôc me. Êsêac têdaŋgôŋ ŋoc lau amboac seŋ mo","poem":1},{"text":"ma êsêac aweŋ gêjac Apômtau atom.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mago êsêac oc têtakê ŋasec","poem":1},{"text":"gebe Anôtô gêmoa gêwiŋ lau gêdêŋ nêŋ gôlôac.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Amac abe akô biŋ, taŋ ŋac ŋalêlôm sawa kêkêŋ mata naŋ, auc.","poem":1},{"text":"Mago Apômtau tau kêtu ênê lamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ojae, moasiŋ ênam Israel saŋa mêŋêsa aŋga Sion ecmaŋ.","poem":1},{"text":"Êndêŋ taŋ Apômtau êmoasiŋ nê lau êtiam naŋ, Jakob oc êtu samuc ma Israel oc têtac ŋajam êsa.","poem":2},"Dawidnê pesalem."]}],"footnotes":[]},"thisChapterLink":"/api/jae_png/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}