{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":149,"content":[{"type":"heading","content":["Wê lambiŋŋa teŋ"]},{"type":"verse","number":1,"content":[{"text":"Aleluja.","poem":1},{"lineBreak":true},{"text":"Anam wê wakuc êndêŋ Apômtau.","poem":1},{"text":"Aweŋ êôc eŋ aŋga ênê lau mansaŋ ŋalêlôm.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Israel têtu samuc nêŋ ŋac, taŋ kêkêŋ êsêac naŋ.","poem":1},{"text":"Sion latui aweŋ êôc nêŋ kiŋ toôndugeŋ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Êsêac têtê wê sêlanem ênê ŋaê","poem":1},{"text":"sênac oŋ to gêŋ wêŋa êtaŋ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Apômtau têtac gêwiŋ nê lau","poem":1},{"text":"ma kêkêŋ lau palê-palê sêku nêŋ ŋacjo tulu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Anôtônê lau têtu samuc eŋ to sênam lasê to ôliŋ êpi","poem":1},{"text":"sênêc nêŋ mê ma aweŋ êôc eŋ toôndugeŋ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Êsêac sêlambiŋ Anôtô to aweŋ êpigeŋ","poem":1},{"text":"ma sêmêŋgôm siŋ ŋamata makeŋ-makeŋ","poem":2}]},{"type":"verse","number":7,"content":[{"text":"gebe sêkac nêŋ kamocgôc aŋga lau samuc nêŋ","poem":1},{"text":"ma sêkêŋ ŋagêjô êndêŋ tenteŋlatu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sênsô êsêacnêŋ kiŋ ŋa kapoacwalô tôŋ","poem":1},{"text":"ma sênsô nêŋ lau mata tôŋ ŋa kapoacwalô ki","poem":2}]},{"type":"verse","number":9,"content":[{"text":"gebe sêŋgôm biŋ, taŋ Anôtô kêkic wanêcgeŋ naŋ, êtu tôŋ êpi êsêac.","poem":1},{"text":"Biŋ tonaŋ ketoc Anôtônê lau samob sa.","poem":2},{"lineBreak":true},{"text":"Aleluja.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/jae_png/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}