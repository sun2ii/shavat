{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":15,"content":[{"type":"heading","content":["Lau, taŋ sêŋgôŋ Anôtônê lôc dabuŋ naŋ"]},{"type":"verse","number":1,"content":[{"text":"O Apômtau, asa oc êtu ŋacleŋ aômnêm bec.","poem":1},{"text":"Ma asa oc êŋgôŋ aômnêm lôc dabuŋ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ŋac tageŋ, taŋ kêsa nê lêŋ tolaŋônêm sawageŋ ma gêgôm gêŋ gêdêŋ-gêdêŋgeŋ naŋ,","poem":1},{"text":"ma kêsôm biŋŋanô tau, taŋ gêc nê ŋalêlôm naŋ lasê.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ŋac tageŋ, taŋ biŋ gêga kêsa awasuŋ atom naŋ.","poem":1},{"text":"Ŋac taŋ gêgôm gwadê sec to kêsac nê ŋac jabaŋ eŋŋa atom naŋ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ŋac tageŋ, taŋ gêlic lau alôb-alôb amboac gêŋ ŋaôma","poem":1},{"text":"ma etoc lau, taŋ têtêc Anôtô naŋ sa.","poem":2},{"text":"Ŋac tageŋ, taŋ êŋgôm biŋ naŋ kêtôc lêma kêpi naŋ, ŋanô êsa","poem":1},{"text":"ma biŋ tau embe êkêŋ ŋandaŋ êndêŋ eŋ, oc ênam nê ŋalêlôm ôkwi atom.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ŋac tageŋ, taŋ kêkêŋ nê mone gêdêŋ lau ma taê kêka gebe mone êsu ŋalatu kapôêŋŋa atom naŋ,","poem":1},{"text":"ma kêtu palê gêdêŋ biŋ kana-kanaŋa ma kêgôliŋ bam ŋac tobiŋmê atom.","poem":2},{"lineBreak":true},{"text":"Ŋac teŋ embe nê lêŋ amboac tonaŋ,","poem":1},{"text":"oc nê ŋalêlôm ŋawiwic atomanô.","poem":2},"Dawidnê pesalem."]}],"footnotes":[]},"thisChapterLink":"/api/jae_png/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}