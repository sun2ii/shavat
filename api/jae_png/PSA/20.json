{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":20,"content":[{"type":"heading","content":["Mec taku ŋacjo tuluŋa"]},{"type":"verse","number":1,"content":[{"text":"Apômtau êkêŋ taŋa aôm êndêŋ bêc gêŋwapacŋa.","poem":1},{"text":"Jakobnê Anôtô nê ŋaê êtu lautuc aôm.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Eŋ ênam aôm sa aŋga gamêŋ dabuŋ","poem":1},{"text":"to êpuc aôm tôŋ aŋga Sion.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Eŋ taê ênam aômnêm da samob.","poem":1},{"text":"Ma nêm daja ênac eŋ mataanô ŋajam.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Eŋ êkêŋ gêŋ, taŋ nêm ŋalêlôm taê kêka naŋ, ŋanô êsa.","poem":1},{"text":"Eŋ êkêŋ aôm ôŋgôm gêŋ samob, taŋ taêm gajam naŋ, e ônac dabiŋ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Embe ôku nêm ŋacjo tulu, aêac oc ôliŋ api toôndugeŋ, oc andaiŋ obokêam asam aêacma Anôtônê ŋaê.","poem":1},{"text":"Apômtau êkêŋ gêŋ samob, taŋ koteŋ naŋ, ŋanô êsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Galoc tec kajala gebe Apômtau gêjam nê ŋac, taŋ seŋ oso eŋ naŋ sa.","poem":1},{"text":"Eŋ kêkêŋ taŋa eŋ aŋga nê undambê dabuŋ. Nê anôŋa aku ŋacjo tulu toŋaclaigeŋ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lau ônê ŋai-ŋai samob taêŋ kêka nêŋ kareta siŋŋa to hos,","poem":1},{"text":"mago aêac tec taêŋ kêka aêacnêŋ Apômtau Anôtô nê ŋaclai.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Êsêac tê sêku sa sêsêp jasêc,","poem":1},{"text":"mago aêac gacgeŋ bôŋdagi aŋgeŋ akô ŋajaŋa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"O Apômtau, ôkêŋ kiŋ tau êku nê ŋacjo tulu.","poem":1},{"text":"Ôkêŋ taŋam aêacmêŋma môêc.","poem":2},"Dawidnê pesalem teŋ."]}],"footnotes":[]},"thisChapterLink":"/api/jae_png/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}