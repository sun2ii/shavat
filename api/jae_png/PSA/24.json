{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":24,"content":[{"type":"heading","content":["Kiŋ toŋawasi"]},{"type":"verse","number":1,"content":[{"text":"Apômtau kêtu nom to gêŋ samob, taŋ gêjam auc naŋ ŋatau.","poem":1},{"text":"Lau taŋ sêŋgôŋ nom tau e jagêdêŋ ŋamadiŋ naŋ, têtu nê gêŋ amboac tonaŋ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Eŋ kêsuŋ nom tonaŋ sa kêkô gwêc ŋaô","poem":1},{"text":"ma kêkwê e ŋajaŋa sec kêkô bu ŋaô.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Asa oc êpi Anôtônê lôc naêtôm.","poem":1},{"text":"Ma asa oc êtôm gebe êkô ênê gamêŋ dabuŋ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ŋac taŋ lêma ŋawasi ma ŋalêlôm ŋakêŋkêŋ laŋgwageŋ naŋ.","poem":1},{"text":"Ŋac taŋ gêôc tau sa gêdêŋ gêŋdansaŋ atom naŋ, to ŋac taŋ kêtôc lêma kêtu geo teŋŋa atom naŋ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Eŋ oc akôc mec aŋga Apômtaunê.","poem":1},{"text":"Ma Anôtô, taŋ gêjam eŋ kêsi naŋ, oc êwaka eŋ sa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lau taŋ sesom eŋ naŋ, nêŋ lêŋ amboac tonaŋ.","poem":1},{"text":"Êsêac taŋ sesom Jakobnê Anôtô laŋôanô.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"O sacgêdôac, asa laŋômanô sa ma katam laŋgwaanôac, alêc taôm su","poem":1},{"text":"gebe kiŋ toŋawasi êsô êwac.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kiŋ toŋawasi tau asa.","poem":1},{"text":"Apômtau ŋaclai to ŋactêkwa, Apômtau ŋactêkwa, taŋ gêjac siŋ naŋ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"O sacgêdôac, asa laŋômanô sa ma katam laŋgwaanôac, alêc taôm su","poem":1},{"text":"gebe kiŋ toŋawasi êsô êwac.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kiŋ toŋawasi tau asa.","poem":1},{"text":"Lausiŋ undambêŋa nêŋ Apômtau, ŋac tonaŋ kêtu kiŋ toŋawasigoc.","poem":2},{"noteId":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"Dawidnê pesalem teŋ.","reference":{"chapter":24,"verse":10}}]},"thisChapterLink":"/api/jae_png/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}