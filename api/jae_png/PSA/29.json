{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":29,"content":[{"type":"heading","content":["Ôsic to wapap kêwaka Apômtaunê wae sa"]},{"type":"verse","number":1,"content":[{"text":"O lau undambêŋa, awem êôc Apômtau","poem":1},{"text":"ma alanem ênê ŋawasi to ŋaclai.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Awaka Apômtaunê ŋaê ŋawae sa.","poem":1},{"text":"Au taôm togêlôŋ dabuŋ anêc Apômtau laŋônêm.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Êsêac sêŋô Apômtau awa aŋga gwêc.","poem":1},{"text":"Ma ênê awa kêdôŋ tau gêsac gwêc.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Apômtau awa kêtaŋ toŋaclai.","poem":1},{"text":"Apômtau awa ŋadindiŋ kaiŋ teŋ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Apômtau awa, wapap tau, gêjac kaseda.","poem":1},{"text":"Apômtau gêjac kaseda, taŋ kêkô Lebanon naŋ popocgoc.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eŋ gêgôm lôc Lebanon gêboaŋ amboac bôclatu.","poem":1},{"text":"Ma Hermon amboac bulimakao ŋalatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Apômtau awa kêkêŋ jawaô kêbêlaŋ","poem":1},{"text":"sinseŋ-sinseŋ kêsa makeŋ-makeŋ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Apômtau awa kêlêndiŋ gamêŋsawa e kêtênêp lasê.","poem":1},{"text":"Apômtau kêkôjôc gamêŋsawa Kades.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Apômtau awa kêwiwic kamem to giŋ kalaka walôŋa e kêsêlô su.","poem":1},{"text":"Ma samob, taŋ sêŋgôŋ nê andu naŋ, sêôc lambiŋ eŋ gebe ŋataugoc.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Apômtau gêjam gôliŋ gwêc ŋagêdimbob.","poem":1},{"text":"Eŋ gêŋgôŋ nê lêpôŋ kiŋŋa gedeŋ tôŋgeŋ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Apômtau êpuc nê lau tôŋmaŋ.","poem":1},{"text":"Apômtau ênam mec nê lau ŋa biŋmalô.","poem":2},{"noteId":7}]}],"footnotes":[{"noteId":7,"caller":"+","text":"Dawidnê pesalem teŋ.","reference":{"chapter":29,"verse":11}}]},"thisChapterLink":"/api/jae_png/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}