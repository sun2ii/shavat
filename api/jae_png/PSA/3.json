{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":3,"content":[{"type":"heading","content":["Mec bêbêcŋa gebe Anôtô ênam sa"]},{"type":"verse","number":1,"content":[{"text":"Ojae, o Apômtau, lau taŋ sêlêsu aê naŋ, taêsam ŋasecgoc,","poem":1},{"text":"taêsam dêdi sêkô sebe senseŋ aê.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lau taêsam sêsôm kêpi aê gebe","poem":1},{"text":"“Anôtô oc anam eŋ sa teŋ atom.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"O Apômtau, aôm kôtu lautuc gômôê aê aucgoc.","poem":1},{"text":"Aôm kôtu aê waec to kôsa môkêcapac sa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gamôêc Apômtau ŋa aoc kapôêŋ,","poem":1},{"text":"e kêkêŋ taŋa ŋoc taŋi aŋga nê lôc dabuŋ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Aê kasa tauc sic ma gaêc bêc e kaliŋ tauc siŋ.","poem":1},{"text":"Gaêc e matoc jali kêsa gebe Apômtau gêjam aê sa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lausiŋ taŋ topom-topom sêgi aê auc naŋ,","poem":1},{"text":"mago katêc êsêac atom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"O Apômtau, ôndi. O ŋoc Anôtô, ônam aê sa.","poem":1},{"text":"Aôm tonaŋ tec kôtap ŋoc ŋacjo samob kêsêp alianô, ma kôtuc lau, taŋ sêkac tauŋ su aŋga aômnêm naŋ, luŋluŋ kêsêlô.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Apômtau kêtu ênam aêac sa ŋamôkê.","poem":1},{"text":"Ônam mec nêm laumaŋ.","poem":2},"Dawidnê pesalem teŋ. Gêc latu Absalom gêja su, go gêga."]}],"footnotes":[]},"thisChapterLink":"/api/jae_png/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}