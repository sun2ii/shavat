{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":4,"content":[{"type":"heading","content":["Mec êtulaŋa teŋ gebe Anôtô ênam sa"]},{"type":"verse","number":1,"content":[{"text":"O Anôtô, taŋ kômasaŋ ŋoc biŋ jagêdêŋ,","poem":1},{"text":"aê embe jamôêc, naŋ ôkêŋ taŋam aê.","poem":2},{"text":"Aê gamoa togêŋwapac, go aôm kôgaboac aê su.","poem":1},{"text":"Taêm labu aê ma ôkêŋ taŋam ŋoc mec.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"O amac lau tembelem aŋgeŋ,","poem":1},{"text":"abe aŋgôm aê waec êtu meloc e êndêŋ ondoc acgom.","poem":2},{"text":"Amac abe taêm ênam biŋ dansaŋ,","poem":1},{"text":"tec abe asap gêŋ ŋaôma tôŋ e êndêŋ ondocgeŋ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ajalamaŋ gebe Apômtau kêjaliŋ nê ŋac mansaŋ aê sa.","poem":1},{"text":"Embe jamôêc êndêŋ Apômtau, oc êkêŋ taŋa aê.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Embe têmtac ŋandaŋ, naŋ aŋgôm taôm sec atom.","poem":1},{"text":"Taêm ênam biŋ tonaŋ ênêc lêlômgeŋ, amoa nêm gamêŋ ma anam taôm tôŋ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ansuŋ da gêdêŋ","poem":2},{"lineBreak":true},{"text":"ma akêŋ matem Apômtau.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lau taêsam sêsôm gebe","poem":1},{"text":"“Asa oc êmoasiŋ aêac.","poem":2},{"text":"O Apômtau, ôc laŋômanô ŋaja sa","poem":1},{"text":"mêŋêpô aêac.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Aôm kôkêŋ têtac ŋajam kêsêp aêŋoc ŋalêlôm,","poem":1},{"text":"kômoasiŋ aê kêlêlêc êsêac, taŋ sêŋgôŋ gêŋmasê ŋaôgeŋ naŋ su.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Aê jasa tauc sic to janêc bêc tobiŋ malôgeŋ","poem":1},{"text":"gebe aôm taômgeŋ, o Apômtau, kôkêŋ aê gamoa ŋoc ŋajam.","poem":2},"Dawidnê pesalem teŋ."]}],"footnotes":[]},"thisChapterLink":"/api/jae_png/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}