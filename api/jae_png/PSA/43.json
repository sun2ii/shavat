{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":43,"content":[{"type":"hebrew_subtitle","content":["(Gêjac têku pesalem 42)"]},{"type":"heading","content":["Mec Anôtô ênam aêac saŋa"]},{"type":"verse","number":1,"content":[{"text":"O Anôtô, ôwaka ŋoc gêdêŋ sa ma ônam gôliŋ ŋoc biŋ","poem":1},{"text":"êndêŋ lau têntac gêwiŋmê tônê ŋai.","poem":2},{"text":"Ônam aê sa","poem":1},{"text":"aŋga ŋamalac dansaŋ to secwaga nêŋ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Aôm kêtu Anôtô, taŋ gejob aê naŋ,","poem":1},{"text":"amboac ondoc kôtiŋ aê su.","poem":2},{"text":"Amboac ondoc jamoa togêŋwapacgeŋ","poem":1},{"text":"ma soŋo-soŋo kêkôniŋ aê tôŋ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ôsakiŋ nêm ŋawê to nêm biŋ ŋaŋêŋ","poem":1},{"text":"gebe êwê aê.","poem":2},{"text":"Ma ôkêŋ aê jandêŋ nêm lôc dabuŋ,","poem":1},{"text":"to nêm andu, taŋ gôŋgôŋ naŋ jana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Go jandêŋ Anôtônê altar jana.","poem":1},{"text":"Jandêŋ Anôtô, taŋ ôlic kêpi-kêpi eŋŋa naŋ.","poem":2},{"text":"O ŋoc Apômtau Anôtô,","poem":1},{"text":"aê jalambiŋ aôm ŋa gêŋ wêŋageŋ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"O katuc tau, amboac ondoc gômoa ŋoc ŋalêlôm tobiŋ wapac","poem":1},{"text":"ma ôluŋ-ôluŋgeŋ.","poem":2},{"text":"Ôkêŋ matam Anôtô gebe aê janam daŋge êndêŋ eŋ,","poem":1},{"text":"taŋ kêsa aê laŋôc sa to kêtu ŋoc Anôtô naŋ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/jae_png/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}