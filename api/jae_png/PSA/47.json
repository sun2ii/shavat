{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":47,"content":[{"type":"heading","content":["Anôtô kêtu lau nomŋa samob nêŋ kiŋ"]},{"type":"verse","number":1,"content":[{"text":"O tenteŋlatuac, amakop lemem,","poem":1},{"text":"anam lasê Anôtô toôndugeŋ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lôlôc Ŋatau Anôtô eŋ ŋacsiŋsêlêcsêga,","poem":1},{"text":"kiŋ ŋaclai tec gêjam gôliŋ nom samucgeŋ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Eŋ kêkôniŋ tenteŋlatu tôŋ sêsô aêac ŋalabu.","poem":1},{"text":"Ma kêkêŋ aêac tajam gôliŋ lau to-m-to-m.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Eŋ kêjaliŋ aêacnêŋ nomlênsêm sa,","poem":1},{"text":"Jakob, taŋ eŋ têtac gêwiŋ naŋ, nê gêŋ towae.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Anôtô kêpi gêja toôndugeŋ.","poem":1},{"text":"Dauc gêwê Apômtau toaligeŋ kêpi gêja.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Awem êôc Anôtô, awem êôcmaŋ.","poem":1},{"text":"Awêm êôc aêacnêŋ kiŋ, awem êôcmaŋ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gebe Anôtô kêtu nom samucgeŋ ŋakiŋ","poem":1},{"text":"Amboac tonaŋ anam ênê wê totalô ŋajam teŋ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Anôtô kêtu lau samuc nêŋ kiŋ.","poem":1},{"text":"Anôtô kêpôŋ tau sic gêŋgôŋ nê lêpôŋ dabuŋ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tenteŋlatunêŋ kasêga sêkac tauŋ sa","poem":1},{"text":"kêtôm Abrahamnê Anôtô nê lau,","poem":2},{"text":"gebe nom tau ŋagôliŋwaga sêsô Anôtô ŋalabu,","poem":1},{"text":"gebe eŋ kêtu ŋatau towaegac.","poem":2},{"noteId":23}]}],"footnotes":[{"noteId":23,"caller":"+","text":"Lau Kora nêŋ wê teŋ.","reference":{"chapter":47,"verse":9}}]},"thisChapterLink":"/api/jae_png/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}