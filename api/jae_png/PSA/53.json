{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":53,"content":[{"type":"heading","content":["Ŋamalacnêŋ sec"]},{"type":"verse","number":1,"content":[{"text":"Lau meloc tec nêŋ ŋalêlôm kêsôm gêdêŋ tauŋ gebe “Anôtô teŋ gêmoa atomanô.”","poem":1},{"text":"Êsêac sêgôm gêŋ sec to alôb-alôb ma nêŋ teŋ gêgôm gêŋ ŋajam teŋ atom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Apômtau katuc kêniŋ ŋamalac latuŋi aŋga undambê","poem":1},{"text":"gebe êtap ŋac tokauc teŋ, taŋ kêtêc Anôtô naŋ, sa gamoa me masi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mago samob sêkac tauŋ su, samob têtu secŋageŋ.","poem":1},{"text":"Êsêacnêŋ teŋ gêgôm gêŋ ŋajam teŋ atom, masi samucgeŋ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lau secwaga samob nêŋ kauc gêbôc me. Êsêac têdaŋgôŋ ŋoc lau amboac seŋ mo","poem":1},{"text":"ma êsêac aweŋ gêjac Apômtau atom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mago êsêac têtakê ŋasec kêtôm têtakê teŋ gêmuŋ su atomanô","poem":1},{"text":"gebe Anôtô kêsa nêm ŋacjo nêŋ ŋatêkwa saliŋ-saliŋgeŋ.","poem":2},{"text":"Eŋ oc êku êsêac tulu samucgeŋ","poem":1},{"text":"gebe eŋ kêtiŋ êsêac su.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ojae, moasiŋ ênam Israel saŋa mêŋêsa aŋga Sion ecmaŋ.","poem":1},{"text":"Êndêŋ taŋ Apômtau êmoasiŋ nê lau êtiam naŋ, Jakob oc êtu samuc, ma Israel oc têtac ŋajam êsa.","poem":2},{"noteId":29}]}],"footnotes":[{"noteId":29,"caller":"+","text":"Dawidnê pesalem teŋ.","reference":{"chapter":53,"verse":6}}]},"thisChapterLink":"/api/jae_png/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}