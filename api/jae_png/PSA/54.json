{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":54,"content":[{"type":"heading","content":["Anôtô ênam aêac sa êndêŋ nêŋ ŋacjo ŋamec"]},{"type":"verse","number":1,"content":[{"text":"O Anôtô, ôkêŋ nêm ŋaê ênam aê sa","poem":1},{"text":"ma nêm ŋaclai êwaka ŋoc biŋgêdêŋ sa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"O Anôtô, ôkêŋ taŋam ŋoc mec.","poem":1},{"text":"Wê taŋam êndêŋ aocsuŋ ŋabiŋ,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"gebe lau jaba tetoc tauŋ sa gêdêŋ aê ma ŋaclaikoc têtu kêka-kêka sebe senseŋ katuc su.","poem":1},{"text":"Êsêac sêsa Anôtô laŋô sa atom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Aê galicgac, Anôtô kêtu ŋoc gêjam-aê-sawaga.","poem":1},{"text":"Apômtau kêpuc katuc tôŋ ŋajaŋa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sec taŋ aêŋoc ŋacjo sêgôm naŋ, naêpi êsêac tauŋ.","poem":1},{"text":"Onseŋ êsêac su gebe aôm ŋac ŋaŋêŋ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Go aê jansuŋ ŋoc da êndêŋ aôm totêtac ŋajamgeŋ.","poem":1},{"text":"O Apômtau, aê gabe aoc êôc nêm ŋaê gebe gabêjam ŋanô,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"gebe aôm kôjaŋgo aê su aŋga gêŋwapac samob","poem":1},{"text":"ma matocanô galic ŋoc ŋacjo e têtac ŋajam gebe sênaŋagac.","poem":2},{"noteId":30},"Saul sêja ma sêsôm gebe Dawid kêsiŋ tau gêmoa êsêacnêŋ gamêŋ."]}],"footnotes":[{"noteId":30,"caller":"+","text":"Dawidnê pesalem teŋ, gêga gêdêŋ taŋ lau Sipit dêdêŋ","reference":{"chapter":54,"verse":7}}]},"thisChapterLink":"/api/jae_png/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}