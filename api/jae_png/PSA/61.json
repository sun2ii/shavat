{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":61,"content":[{"type":"heading","content":["Mec Anôtô ejop aêacŋa"]},{"type":"verse","number":1,"content":[{"text":"O Anôtô, ôŋô ŋoc taŋi kapôêŋ.","poem":1},{"text":"Ôkeŋ taŋam ŋoc mec.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gaŋgôŋ gêdêŋ nom ŋamadiŋ ma aoc gêjac aôm","poem":1},{"text":"gebe ŋoc ŋalêlôm ŋatutuc ŋasec.","poem":2},{"text":"Poc kapôêŋ tec kêkô, ma aê tauc oc japi jatôm atom.","poem":1},{"text":"Amboac tonaŋ aôm ôkam aê, go japi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gebe aê gaê lamu aômgeŋ.","poem":1},{"text":"Aôm kôtu ŋoc tuŋtêna gêdêŋ ŋacjo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ojae, jaŋgôŋ nêm beclêlôm endeŋ tôŋgeŋmaŋ.","poem":1},{"text":"Jaŋgôŋ nêm magêm ŋalabugeŋmaŋ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gebe aôm Anôtô kôkêŋ taŋam biŋ, taŋ gajac mata naŋ.","poem":1},{"text":"Aôm kôkêŋ aê gawê kaiŋ êsêac, taŋ têtêc aômnêm ŋaê naŋ, nêŋ gêŋlênsêm.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ônac têku kiŋnê bêc wakuc-wakucgeŋ ênêc.","poem":1},{"text":"Ôkêŋ eŋ êmoa tojala-tojala ŋapaŋ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ôkêŋ eŋ êŋgôŋ nê lêpôŋ êŋgôŋ Anôtô laŋônêmŋageŋ.","poem":1},{"text":"Ôkêŋ nêm têmtac gêwiŋ teŋgeŋŋa to biŋ ŋaŋêŋ êkwa eŋ auc.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Amboac tonaŋ aoc êôc nêm ŋaê endeŋ tôŋgeŋ","poem":1},{"text":"ma jaŋgôm biŋ, taŋ gajac mata naŋ, ŋanô êsa êtôm bêcgeŋ.","poem":2},{"noteId":36}]}],"footnotes":[{"noteId":36,"caller":"+","text":"Dawidnê teŋ.","reference":{"chapter":61,"verse":8}}]},"thisChapterLink":"/api/jae_png/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}