{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":70,"content":[{"type":"heading","content":["Mec Anôtô ênam saŋa"]},{"type":"verse","number":1,"content":[{"text":"O Anôtô, mêŋônam aê sa.","poem":1},{"text":"O Apômtau, ônsaic taômgeŋ mêŋôpuc aê tôŋ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Êsêac taŋ dêdib aê sebe senseŋ aê su naŋ,","poem":1},{"text":"ôkêŋ êsêac majeŋ to teŋbeleŋ ŋawapac êsa.","poem":2},{"text":"Ôkêŋ êsêac, taŋ sêkêŋ mateŋ sebe aê jatu sec naŋ,","poem":1},{"text":"sêc tomajeŋgeŋ sêmu sêna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Êsêac taŋ sêgôm “Kec, kec” kêpi aê naŋ,","poem":1},{"text":"ôkêŋ êsêac têtakê tomajeŋgeŋ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ôkêŋ êsêac samob, taŋ sesom aôm naŋ,","poem":1},{"text":"ôliŋ êpi to têntac ŋajam êsa êtu aôm ŋa.","poem":2},{"text":"Ôkêŋ êsêac samob, taŋ taêŋ kêka aômnêm moasiŋ naŋ,","poem":1},{"text":"sêsôm lasê endeŋ tôŋgeŋ gebe “Apômtau ŋac towae.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"O Apômtau, aê tec ŋac palê-palê to ŋac ŋalêlôm sawa.","poem":1},{"text":"O Anôtô, ôlêti sebeŋ ôndêŋ aê ômôêŋ.","poem":2},{"text":"O Apômtau, ônam gamêŋ tôŋ atom","poem":1},{"text":"gebe ŋoc ônam-aê-sa to ôpuc-aê-tôŋwaga aômgoc.","poem":2},{"noteId":45}]}],"footnotes":[{"noteId":45,"caller":"+","text":"Dawidnê pesalem teŋ. Taŋiboa teŋ.","reference":{"chapter":70,"verse":5}}]},"thisChapterLink":"/api/jae_png/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}