{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":82,"content":[{"type":"heading","content":["Anôtô eŋ ŋacgôliŋsêga"]},{"type":"verse","number":1,"content":[{"text":"Anôtô gêmoa nê lau sêkac tauŋ sa ŋaluŋgeŋ.","poem":1},{"text":"Eŋ kêmêtôc biŋ gêŋgôŋ gôliŋwaga sêkac tauŋ sa ŋalêlôm.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“Awi amêtôc kesoŋa siŋmaŋ","poem":1},{"text":"ma akêŋ êwiŋ lau, taŋ sêkac tauŋ su aŋga Anôtônê naŋ, nêŋ biŋ atom.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Amêtôc lau ŋaôma to mosêbu nêŋ biŋ êtu katô","poem":1},{"text":"ma anam lau ŋasec to ŋalêlôm sawa sa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Apuc ŋac sawa to ŋac, taŋ kêpô lêna gêŋ naŋ tôŋ.","poem":1},{"text":"Ajaŋgo eŋ su aŋga lau, taŋ sêkac tauŋ su aŋga Anôtônê naŋ lemeŋ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Êsêac lau meloc to nêŋ kauc masi.","poem":1},{"text":"Amacnêm mêtê kêtu sec samucgeŋ ma biŋgêdêŋ malamê aŋga nom.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Biŋŋanô, aê tauc kasômgac gebe ‘Amac atu anôtôigeŋ","poem":1},{"text":"ma amac samob atu Lôlôc Ŋatau latuigeŋ.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mago oc amac êndu atôm ŋamalac","poem":1},{"text":"ma aku e anaŋa atôm kasêga sêjaŋa.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"O Anôtô, ômôêŋ ma ônam gôliŋ nom samucgeŋ","poem":1},{"text":"ma tenteŋlatu samob têtu aômnêm gêŋ.","poem":2},{"noteId":55}]}],"footnotes":[{"noteId":55,"caller":"+","text":"Asapnê pesalem teŋ.","reference":{"chapter":82,"verse":8}}]},"thisChapterLink":"/api/jae_png/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}