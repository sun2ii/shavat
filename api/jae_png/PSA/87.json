{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":87,"content":[{"type":"heading","content":["Jerusalem ŋalambiŋ"]},{"type":"verse","number":1,"content":[{"text":"Apômtau kêkwê nê malac sa kêkô lôc dabuŋ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Apômtau têtac gêwiŋ Sion ŋasacgêdô","poem":1},{"text":"kêlêlêc gamêŋ ŋagêdô, taŋ Jakobnê lau sêŋgôŋ naŋ su.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O Anôtônê malac, ôkêŋ taŋam biŋ tonec,","poem":1},{"text":"taŋ eŋ kêsôm kêpi aôm naŋ gebe","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Aê kasa Aiguptu to Babilon sa gêwiŋ lau-taŋeŋ-wamu-aêwaga.","poem":1},{"text":"Ma lau Pilistia to Tirus ma Aitiopia nêŋ malacmôkê Jerusalem.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ma sêsôm êpi Sion gebe lau tokaiŋ-tokaiŋ nêŋ malacmôkê","poem":1},{"text":"gebe Lôlôc Ŋatau tau kêpuc tôŋ gebe êkô ŋajaŋa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Apômtau eto tenteŋlatu nêŋ ŋaêmôkê ma êwa êsêac sa gebe","poem":1},{"text":"“Teneŋi sêkôc êsêac aŋga Jerusalem, Jerusalem ŋatau êsêac.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Êsêac sênam wê to têtê gebe","poem":1},{"text":"“Aôm kôtu ma moasiŋ samob ŋamôkê.”","poem":2},{"noteId":60}]}],"footnotes":[{"noteId":60,"caller":"+","text":"Kora latui nêŋ pesalem wêŋa teŋ.","reference":{"chapter":87,"verse":7}}]},"thisChapterLink":"/api/jae_png/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}