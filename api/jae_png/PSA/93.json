{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":93,"content":[{"type":"heading","content":["Anôtô kêtu kiŋ"]},{"type":"verse","number":1,"content":[{"text":"Apômtau kêtu kiŋ. Eŋ kêsô ŋawasi kiŋŋa kêtu nê ŋakwê. Apômtau gêjam gêlôŋ sa ma kajandiŋ ŋaclai kêtu nê ômbiŋkap.","poem":1},{"text":"Ŋac tau gedeŋ nom tôŋ ŋajaŋa gebe wiwic atom.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Aômnêm lêpôŋ kêkô ŋajaŋa kwanaŋgeŋ gêdêŋ andaŋgeŋ ma ŋapaŋ.","poem":1},{"text":"Aôm gômoa gêdêŋ têm kêsa atomgeŋ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"O Apômtau, bu ŋasamac kêsa, ŋasamac kêsa e ŋadindiŋ ŋanô.","poem":1},{"text":"Ŋasamac kêsa e gamêŋ gêôŋ-gêôŋ","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Apômtau lôlôcŋa kêtu ŋatau ŋajaŋa, eŋ kêlêlêc bu ŋasamac kapôêŋ ŋadindiŋ.","poem":1},{"text":"Kêlêlêc gwêc, taŋ kêgasim ŋatêna naŋ su.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Biŋ taŋ aôm gôwa sa naŋ, ŋaŋêŋ to biŋŋanô.","poem":1},{"text":"O Apômtau, ŋamalac tetoc nêm andu sa gebe gamêŋ dabuŋ ma sêŋgôm endeŋ tôŋgeŋ acgommaŋ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/jae_png/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}