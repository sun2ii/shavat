{"translation":{"id":"jae_png","name":"BIBOLO DABUŊ","website":"https://ebible.org/Scriptures/details.php?id=jae","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jae","licenseNotes":null,"shortName":"PNG","englishName":"Yabem Bible","language":"jae","textDirection":"ltr","sha256":"361fd4d477fcacce206c9ef2441eaf71b773bcea44a59fabf62452b6433c45d6","availableFormats":["json"],"listOfBooksApiLink":"/api/jae_png/books.json","numberOfBooks":57,"totalNumberOfChapters":761,"totalNumberOfVerses":18129,"languageName":"Yabem","languageEnglishName":"Yabem"},"book":{"id":"PSA","translationId":"jae_png","name":"PESALEM","commonName":"PESALEM","title":"Pesalem Ŋabuku","order":19,"numberOfChapters":150,"sha256":"4896940293ce67ec6e4839a41d45774068e7738d45fe4edc7d09a6e1be2ed334","firstChapterNumber":1,"firstChapterApiLink":"/api/jae_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/jae_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":98,"content":[{"type":"heading","content":["Anôtô kêtu nom samucgeŋ ŋagôliŋwaga"]},{"type":"verse","number":1,"content":[{"text":"Apuc wê wakuc teŋ sa êndêŋ Apômtau","poem":1},{"text":"gebe eŋ gêgôm gêŋsêga.","poem":2},{"text":"Ênê lêma anôŋa","poem":1},{"text":"to ŋaclai dabuŋ kêku nê ŋacjo tulu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Apômtau kêsôm eŋ kêku ŋacjo tulu ŋawae lasê.","poem":1},{"text":"Eŋ geoc nê biŋgêdêŋ lasê gêdêŋ tenteŋlatu samob.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Eŋ taê gêjam nê têtac gêwiŋ teŋgeŋŋa to biŋ ŋaŋêŋ,","poem":1},{"text":"taŋ gêjac mata gêdêŋ gôlôac Israel naŋ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lau gamêŋ samobŋa awem êôc Apômtau toôndugeŋ.","poem":1},{"text":"Anam lasê to apuc wê lambiŋŋa sa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Aŋgôm gêŋ wêŋa êtaŋ gebe êŋgôm Apômtaunê wae êsa.","poem":1},{"text":"Aŋgôm ŋa gêŋ wêŋa ma apuc wê tau sa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Anac dauc to posauno êtaŋ.","poem":1},{"text":"Awem êôc kiŋ Apômtau toôndugeŋ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gwêc to ŋagêŋ samob, taŋ gelec-gelecgeŋ sêmoa ŋalêlôm naŋ, ŋadindiŋ êsa","poem":1},{"text":"ma lau samob, taŋ sêŋgôŋ nom auc naŋ, amboac tonaŋgeŋ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bu kapôêŋ ŋasamac, amakop lemem.","poem":1},{"text":"Lôc samob sêkêli tauŋ sêpi-sêpigeŋ sêkô Anôtô laŋôgeŋ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sêŋgôm êndêŋ Apômtau gebe eŋ oc mêŋêmêtôc ŋamalac nomŋa nêŋ biŋ.","poem":1},{"text":"Eŋ oc êmêtôc lau samob, taŋ sêŋgôŋ nom auc naŋ, ŋa biŋgêdêŋ ma biŋkatô.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/jae_png/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jae_png/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jae_png/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}