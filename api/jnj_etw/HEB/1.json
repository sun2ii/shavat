{"translation":{"id":"jnj_etw","name":"ጋዶ ቴያ","website":"https://ebible.org/Scriptures/details.php?id=jnje","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jnje","licenseNotes":null,"shortName":"ETW","englishName":"Yemsa NT Ethiopic","language":"jnj","textDirection":"ltr","sha256":"a2c7a249ba74bd3a956af8ffe06def486e57f94f9e4eb6f05928af891fb1f0d9","availableFormats":["json"],"listOfBooksApiLink":"/api/jnj_etw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7924,"languageName":"Yemsa","languageEnglishName":"Yemsa"},"book":{"id":"HEB","translationId":"jnj_etw","name":"እብራዊ","commonName":"እብራዊ","title":"እብራዊኒ ሜያክ ዎስቴ ዎሲያ","order":58,"numberOfChapters":13,"sha256":"72778fb02fc714286973b129ce1e7d8e406165bc9f22c0a6ca70a255b0c8fd8d","firstChapterNumber":1,"firstChapterApiLink":"/api/jnj_etw/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/jnj_etw/HEB/13.json","totalNumberOfVerses":302},"chapter":{"number":1,"content":[{"type":"heading","content":["ሀኦስ ናዉባስኪ ካሞ ማኬ"]},{"type":"verse","number":1,"content":["ሀኦስ ዜሞቲ ነያሲ ሾዎ ኡግናክ፤ ራጁኒ ሜያኪ ካሞ እንኖ አባኒ ሜያክ ሾዎ ካባ ማኬት ፋር።"]},{"type":"verse","number":2,"content":["ስኑንታኖ ሀሽ ኦርፎቲ ነያሲ ዙታምባሴ አሲን ዋራሶኒር ዛግና ናዉባሲኪ ካሞ እኖክ ማኬ። ሀን ዳሶን ደይ ዙታምባሴ አሲን ቴሲናስ ባሪክዋ።"]},{"type":"verse","number":3,"content":["ባር ሀኦሲ ኡልፍናኖን ፓልፓልግሬ ቤሲር። ባር ሃላባሲክ ሀኦስኔን አነ ማእስሬ እሳርዋ። ካምባሲ ሁግናክ ሀን ዳሶን ዙትሬ ቴቤ ኤጲዋ፥ አሱኒ ሜያኖን ደይ ቦርቤሲስን ካይምስንናኔን ኦርፎ ሳማኪ ሁግናባ ፋና ሀኦሲ ሆእታ ዲ።"]},{"type":"verse","number":4,"content":["ባሪክ እምቴ ሱናስ ሀኦሲ ዎስያኒ ሱንታን ደናሎ ስንናማቶ ሀኦሲ ና ሀኦሲ ዎሲያታን አካማኖን ደናሎዋ።"]},{"type":"heading","content":["ሀኦሲ ና ሀኦሲ ዎሲያታን አካማኖን ደናሎ"]},{"type":"verse","number":5,"content":[{"text":"ሀኦሲ ባሪ ዎሲያሲ ጋነያስን፦","poem":1},{"text":"«ነ ናታዋ፤","poem":2},{"lineBreak":true},{"text":"ሀውጙ ኔን ኮኒን»","poem":2},{"lineBreak":true},{"text":"ሄፕሳ ደይ፦ «ታ ባሪክ አባ ስናና፤","poem":2},{"lineBreak":true},{"text":"ባር ደይ ታክ ናታ ስናና»","poem":2},{"lineBreak":true},{"text":"ይናስ ኦንኒንሶ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሀኦስ ኡዛ ናዉባስን፤","poem":1},{"text":"ሀን ዳስታክ ዎሲፋና ካባሲክ፤","poem":2},{"text":"«ሀኦሲ ዎሲያ ዙቴራ፤","poem":1},{"text":"ባሪክ ሳጋዶና» ይፋዋ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ስኑንታኖ ሀኦሲ ዎስያኒ ቾዋሲክ፤","poem":1},{"text":"ደይ፦ «ሀኦስ ዎሲያኒክቶኖን አያናኒክቶ፤","poem":2},{"lineBreak":true},{"text":"ሀኦሲክ ዎስቴሴፌ ባሶትን፤","poem":2},{"lineBreak":true},{"text":"ደይ ጌኒ ውኖኒክቶ ዛጉኒር» ይፋዋ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ስኑንታኖ ናሳ ቾዋክ፤","poem":1},{"text":"«ሀኦሴ፤ ዝግሞኔስ ኮእባ ፎንቶኖን ፎኒር፤","poem":2},{"lineBreak":true},{"text":"ታቶኔስ ደይ ኦኮኒ ሃሮ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኦኮሶን ሹኒት፤ ማንጉሶን ደይ ኦምቴት፤","poem":1},{"text":"ኤስ ባሪ ቦርኣ ዳማ ሀኦኔስ፤","poem":2},{"lineBreak":true},{"text":"ዞሞኔሳታን ደናሎኖን ግራ፤","poem":2},{"lineBreak":true},{"text":"ሙዳክ ኔን ሙድ» ይፋ።","poem":2}]},{"type":"verse","number":10,"content":["ኤሲስማቶ ደይ፦",{"text":"«ዳሚሶ! ነ ዜምማ ዳሶን ቴሲትዋ፤","poem":2},{"lineBreak":true},{"text":"ሳማሲክቶ ደይ ኩሹኔሲ ዎስቶዋ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኤስ ባርኪቶ ዙቴራ ትሹኒር፤","poem":1},{"text":"ስኑንታኖ ነ ፎታር፤","poem":2},{"lineBreak":true},{"text":"ዙታምባሴ ማምኒማቶ ኩርኡና።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ማምኒማቶ ደይ ዛግራ ብሩታ፤","poem":1},{"text":"ባርኪቶ ደይ ማምኒማቶ ስንና ሶልቶና፤","poem":2},{"lineBreak":true},{"text":"ስኑንታኖ ነ ኣጌነ ኣጌነ ስንፋናክ፤","poem":2},{"lineBreak":true},{"text":"ነ ነኔሲክ ኮእባ ኣፋ» ይፋ።","poem":2}]},{"type":"verse","number":13,"content":["ሀኦስ ባሪ ዎስያሲክቶኒ ጋነያስን፦",{"text":"«ጉማኔሳክቶኒን ዎቾኔሲ፤","poem":1},{"text":"ስካሎሲ ዛጉና ካባኔን፤","poem":2},{"lineBreak":true},{"text":"ታ ሆእታ ቴሻስታ ዱዋ»","poem":2},"ይናስ ኦንኒንሶ?"]},{"type":"verse","number":14,"content":["ኤካን ሀኦሲ ዎሲያ ዙቴራ ፋሩኒ አሱኒ ሜያክ ዎስቶናክ ዎስቴራ ያ ሀኦኒ ዎስትኛ ስና አያናኒክቶታኖሶ?"]}],"footnotes":[]},"thisChapterLink":"/api/jnj_etw/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jnj_etw/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jnj_etw/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}