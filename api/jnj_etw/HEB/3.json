{"translation":{"id":"jnj_etw","name":"ጋዶ ቴያ","website":"https://ebible.org/Scriptures/details.php?id=jnje","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jnje","licenseNotes":null,"shortName":"ETW","englishName":"Yemsa NT Ethiopic","language":"jnj","textDirection":"ltr","sha256":"a2c7a249ba74bd3a956af8ffe06def486e57f94f9e4eb6f05928af891fb1f0d9","availableFormats":["json"],"listOfBooksApiLink":"/api/jnj_etw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7924,"languageName":"Yemsa","languageEnglishName":"Yemsa"},"book":{"id":"HEB","translationId":"jnj_etw","name":"እብራዊ","commonName":"እብራዊ","title":"እብራዊኒ ሜያክ ዎስቴ ዎሲያ","order":58,"numberOfChapters":13,"sha256":"72778fb02fc714286973b129ce1e7d8e406165bc9f22c0a6ca70a255b0c8fd8d","firstChapterNumber":1,"firstChapterApiLink":"/api/jnj_etw/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/jnj_etw/HEB/13.json","totalNumberOfVerses":302},"chapter":{"number":3,"content":[{"type":"heading","content":["የሱስ ሙሴኒስታን ደናሎ ስንናማቶ"]},{"type":"verse","number":1,"content":["ኤስ ባሪ ቦርኣ ሳማኪ ቴግቶሶን ሃኦኒር ስና ኮርቶ አይታሳክቶኖ! አማንቶኒሲ ዎሲ ስና ባሪንናዋ ማግኒ ጋኝኜ ሜኒ ጋኛ ስና የሱስኒንና ሳፋሮትዋ።"]},{"type":"verse","number":2,"content":["ሙሴ ሀኦሲ ኬያ ዙታምባሴ አሲስታ አማናምቶ ስንናማቶ የሱስ ደይ ባሪን ታትሲ ሀኦሲክ አማናምቶዋ።"]},{"type":"verse","number":3,"content":["ኬያሶን ኬርእፌ ባር ኬያስታን ደናሎኖን ኡልፍንባ ፋናማቶ የሱስኒክ ደይ ሙሴኒስታን ደናሎኖን ኡልፍና ሾልሲርዋ።"]},{"type":"verse","number":4,"content":["ፉቶሲክ ኬያ እሳርባ እሳርባሲክ ባሮን ኬርአ አሱባ ፌርዋ። ስኑንታኖ ዙታምባሴ አሲን ኬርኣስ ሀኦስዋ።"]},{"type":"verse","number":5,"content":["ሀኔንቲ ማክቶኒ ዉዛሲክ ዛላ ስናናክ ሙሴ ሀኦሲ ኬያ ዙታምባሴ አሲስታ ዎስትኛኒማቶ አማናምቶ ስንነ ፌር።"]},{"type":"verse","number":6,"content":["ስኑንታኖ ክርስቶስ ሀኦሲ ኬሩክ አማናምቶ ስንናስ ናኒማቶ ስንነዋ። ኤስ ኬያስ ደይ እኖዋ። ባሪ ኬያ ስናኒስ አማነፌኒ ዉዛሴዋ ቴቴፌኒ አብዲሴ አሲን ማእስራ ኤጵፋኒነዋ።"]},{"type":"heading","content":["ሀኦኒ አሱኒክ እምቴ ኬኦኒ ኪቶ"]},{"type":"verse","number":7,"content":["ኤስ ባሪ ቦርኣ ኮርቶ አያናስ ማኬፋናሲማቶ፦",{"text":"«ሀሽ ሀውጙ ካምባሶን ኦደፌት ካባሲክ፤","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ዛቦሲክ ፋታንቴፌቲ ካባሲክ፤","poem":1},{"text":"ማጙክ ታይስታ ካብሴቴይሲማቶ፤","poem":2},{"lineBreak":true},{"text":"ንብኒትሶን ኤጴቶ ቤያር ዛጉትታ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኤስ ካባሲክ ዜሞቲ አባንቲሳክቶ ታን ፋታነሴቴ፤","poem":1},{"text":"ደይ ታን ቱእኒሴቴ፤","poem":2},{"text":"አቼቻስር ዎግጋ ዛግና ባሮን ደይ ብየቴ»","poem":1},"ይፋዋ ሀኦስ።"]},{"type":"verse","number":10,"content":[{"text":"«ኤስ ባሪ ቦርኣ ኤስ ኮኒቶስታ ሃሬን፦","poem":1},{"text":"‹ንብቤሲስ ዎንና ዎንና ዳጌቱ ፋፋ፤","poem":2},{"lineBreak":true},{"text":"ኡጉናሶን ደይ ኣነ አርሶቶ› ይጝዋ።»","poem":2}]},{"type":"verse","number":11,"content":["ደይ፦",{"text":"« ‹ታ ባሶክ እማናክ ፋ ቤይሳኒ ድማስታ፤","poem":1},{"text":"እሳንነ ኣፋ ግርሶነ ዉዛ!› ይራ፤","poem":2},{"lineBreak":true},{"text":"ግእናሲክ ቴይጝዋ» ይ።","poem":2}]},{"type":"verse","number":12,"content":["አይታሳክቶኖ! ንቶ ጋነያስን ኦኑ ሀየዋ ሀኦስታን ዎክሱኒ ማጙነዋ አማኖኖይ ንብነ ፎኖይናማቶ ቴትኒትሶን ኦድትዋ።"]},{"type":"verse","number":13,"content":["ኤስ ባሪስታን ደናሎ ንቶስን ቦርኣሲክ ኤሽቴሬ ንባሶን ኤጳ ቶ ቤያር ዛጉኖይናማቶ፦ «ሀሽ ሀውጙ» ይስቴራ ቴግቴ ዎናስ ፋና ካባሲክ ዎንና ዎንና ሜርኮትዋ።"]},{"type":"verse","number":14,"content":["ቴሱስታኪ ፋ አማንቶኒሶን ሀማ ኮእባስታ ካርአና ካባኔን ዛግራ ኤጵፋንነ ክርስቶስኔን አነ ዋራሴርቱ ሲናኒዋ።"]},{"type":"verse","number":15,"content":[{"text":"ኤሲስ ደይ፦","poem":1},{"text":"«ሀሽ ሀውጙ ካምባሶን ኦደፌቲ ካባሲክ፤","poem":2},{"lineBreak":true},{"text":"ኤስ ኑሪፌት ካባሲክ ዛግሴትስነ ፋሮን፤","poem":2},{"lineBreak":true},{"text":"ንብንትሶን ኤጳ ቶ ቤያር ዛጉትታዋ»","poem":2},"ይስቴራ ማክቴናሲማቶዋ።"]},{"type":"verse","number":16,"content":["ኤካ ኤስ ባሶ ካምባሶን ኦደሴቴኔን ኦርፎ ኑሪስ ኦና ኦናንሶ? ኤስ ባሶ ሙሴ ዞንስን ግጵጽኒ ዳስታን ኬሳ ባሶ ዙቴሬቴኖሶ?"]},{"type":"verse","number":17,"content":["ሀኦሶን አቼቻስር ዎግጋ ቱማኖን ግእቶናክ ዛግት ፌሴስ ኦና ኦናንሶ? ኤስ ባሶ ቦርአ ዎስቴ ባሶናዋ ዱግኖቤሲስ ዛቦሲ ጋንደራ ፉእቴና ባሶቴኖሶ?"]},{"type":"verse","number":18,"content":["ደይ ኤስ አጃጃሞ ቤያ ባሶትን ስንና ሻካናነ፦ «ቤይሳናሲክ ኣፋ ግርሶነዉዛ» ይራ ቴይናስ ኦና ኦናንሶ?"]},{"type":"verse","number":19,"content":["ኤሴ ግሩ ችማ ቤየቴስ አማንቶ ቤዮቤሲስታን ካብ ቾዋ ስንባሶንቱ ቢፌኒዋ።"]}],"footnotes":[]},"thisChapterLink":"/api/jnj_etw/HEB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jnj_etw/HEB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jnj_etw/HEB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}