{"translation":{"id":"jnj_etw","name":"ጋዶ ቴያ","website":"https://ebible.org/Scriptures/details.php?id=jnje","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jnje","licenseNotes":null,"shortName":"ETW","englishName":"Yemsa NT Ethiopic","language":"jnj","textDirection":"ltr","sha256":"a2c7a249ba74bd3a956af8ffe06def486e57f94f9e4eb6f05928af891fb1f0d9","availableFormats":["json"],"listOfBooksApiLink":"/api/jnj_etw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7924,"languageName":"Yemsa","languageEnglishName":"Yemsa"},"book":{"id":"HEB","translationId":"jnj_etw","name":"እብራዊ","commonName":"እብራዊ","title":"እብራዊኒ ሜያክ ዎስቴ ዎሲያ","order":58,"numberOfChapters":13,"sha256":"72778fb02fc714286973b129ce1e7d8e406165bc9f22c0a6ca70a255b0c8fd8d","firstChapterNumber":1,"firstChapterApiLink":"/api/jnj_etw/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/jnj_etw/HEB/13.json","totalNumberOfVerses":302},"chapter":{"number":8,"content":[{"type":"heading","content":["የሱስ ጋድዶ ቴያሲ ማግኒ ጋኘ ሜኒ ጋኛ ስንናማቶ"]},{"type":"verse","number":1,"content":["ኤሴ ዎሎኒ ዉዛሲክቶስን አሪክስ ሀኒስዋ፦ ሳማክ ዙታምባሴ አሲስታን ደናሎ ስና ሀኦሲ ዝግሞኒ ሆእታ ቴሻስታ ድ ኤፌቴና ማግኒ ጋኝኜ ሜኒ ጋኛኒ እኖክ ፌርዋ።"]},{"type":"verse","number":2,"content":["ባር ዎስቴት ፌናስ ፉቶኒ ዱርካኒ ስና ሜቅዴሲሲዋ። ኤስ ዱርካኒስ ቶክቴናስ አሱኒ ኩሹክ ስንኖይናሮን ዳሚሲክዋ"]},{"type":"verse","number":3,"content":["ማግኒ ጋኝኜ ሜኒ ጋኛ እሳርባ እሳርባስ ታቴፌናስ ማባነዋ ማአነ አሲን እማናክዋ። ኤስ ባሪ ቦርኣ ኤስ ማግስ ደይ እማና እሳ ዉዝባ ፎናክ ሾልሱዋ።"]},{"type":"verse","number":4,"content":["ቱማሲማቶ ማባሶን እሜፌ ማግኒ ሜያ ፌሴቴር ስንና ቦርአ ባር ሀን ዳስታኪር ስኒ ስንፋናነ ማግ ስናና ካባታዋ።"]},{"type":"verse","number":5,"content":["ሀን ማግኒ ሜያ ዎስቴሴፌ ዱርካኒስ ሳማኪ ፋ ባሪ ቤሶነዋ ይራራነ አሲክ ኮእባዋ። ኤስ ባር ደይ ስንናስ ሙሴ ዱርካኒሶን ዎስቴፌና ካባሲክ ሀኦስ፦ «ኣማስታክ አምማኖን ኔክ ቤሲናስነ ፋሮን ዙታምባሴ ማእስራ ኦዳ ዛጉዋ» ይራ አጃጀናሲማቶዋ።"]},{"type":"verse","number":6,"content":["ስኑንታኖ ሀሽ የሱስ ጋነኒር ደይ እሳር ዛግና ቴያሲ ኩርኡ ቴያስታን ደናሎ ስና አብዲስታ የሬር ስንናማቶ ባሪክ እምቴ ዎስቶስ ደይ አርኪርዋ።"]},{"type":"verse","number":7,"content":["ዜምማቲ ቴያስ ዝናባ ፎንቶ ስንና ቤስቴ ስንፋናነ ሄፕሳኒ ቴያስ ሾልሱና ካባታዋ።"]},{"type":"verse","number":8,"content":["ሀኦስ ዳራባሳታ ዝና ፎባሶን ቤሱክ ኤካ ይፋዋ፦",{"text":"«ኤሴ እስራኤልኒ ዳራስኔንናዋ ዩዳኒ ዳራስኔንና፤","poem":1},{"text":"ጋድዶ ቴያኒ ካማ ግሩና ዎና ዮናዋ»","poem":2},"ይፌዋ ዳሚስ።"]},{"type":"verse","number":9,"content":[{"text":"«ኤስ ቴያስ ደይ ኩሹቤሲሶን ኤጳ ግጵጽኒ ሜኒ ዳስታን፤","poem":1},{"text":"ባሶትን ክስፋና ካባሲክ፤","poem":2},{"lineBreak":true},{"text":"ባሶ አባስኔን አነ ግሪና ቴያስነ ፋርታዋ።","poem":2},{"text":"ባሶ ታ ቴያኒ ካማሲክ ኣነ የሮሶቶ ስንና ቦርአ፤","poem":1},{"text":"ታ ደይ ካሽጝዋ»","poem":2},"ይፌዋ ዳሚስ።"]},{"type":"verse","number":10,"content":[{"text":"«ኤሴ ሀን ዎናስኔን ኦርፎ፤","poem":1},{"text":"እስራኤልኒ ዳራስኔን አነ፤","poem":2},{"lineBreak":true},{"text":"ግሩና ቴያኒ ካማስ ሀኒስዋ፤","poem":2},{"lineBreak":true},{"text":"ይፌዋ ዳሚስ፤","poem":2},{"lineBreak":true},{"text":"ታ ቱማሶን ባሶ፤","poem":2},{"lineBreak":true},{"text":"ካኑስሲ ፎናክ ዛጉና፤","poem":2},{"lineBreak":true},{"text":"ንብቤሲስ ደይ ትቹና፦","poem":2},{"lineBreak":true},{"text":"ታ ደይ ባሶክ ሀኦቤስ ስናና፤","poem":2},{"lineBreak":true},{"text":"ባሶ ደይ ታክ ዳራ ስኖነ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"‹ዳሚስን አሩዋ› ይሬ ዎልኮባስን ስኑን፤","poem":1},{"text":"አይባስን አሱኒር ኦኑ ኣፋ ፎና ዉዛ፤","poem":2},{"lineBreak":true},{"text":"ጋሮሳታን ካብራ ሀምማ፤","poem":2},{"lineBreak":true},{"text":"አርኪሳታ ካርአና ካባኔን፤","poem":2},{"lineBreak":true},{"text":"ዙቴሬ ታን አርሶነ፦","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ማጝሱቤሲሶን ፌሹን ኡና፤","poem":1},{"text":"ቦርቤሲሶን ደይ፤","poem":2},{"lineBreak":true},{"text":"ኣፋ ዎላ ያዳቶና ዉዛ።»","poem":2}]},{"type":"verse","number":13,"content":["ኤሴ፦ «ጋድዶ ቴያኒ ካማ» ይፋና ካባሲክ ስናቲ ቴያኒ ካማሶን ኩርኡ ዛጊዋ ኡዋ። ኤስ ባሪ ቦርኣ ኩርእ ባሬዋ ኩርኡ ዉዛ ዙታምባሴ ትሹና ዎናስ ታእሴዋ።"]}],"footnotes":[]},"thisChapterLink":"/api/jnj_etw/HEB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jnj_etw/HEB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jnj_etw/HEB/7.json","previousChapterAudioLinks":{},"numberOfVerses":13}