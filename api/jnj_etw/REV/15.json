{"translation":{"id":"jnj_etw","name":"ጋዶ ቴያ","website":"https://ebible.org/Scriptures/details.php?id=jnje","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jnje","licenseNotes":null,"shortName":"ETW","englishName":"Yemsa NT Ethiopic","language":"jnj","textDirection":"ltr","sha256":"a2c7a249ba74bd3a956af8ffe06def486e57f94f9e4eb6f05928af891fb1f0d9","availableFormats":["json"],"listOfBooksApiLink":"/api/jnj_etw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7924,"languageName":"Yemsa","languageEnglishName":"Yemsa"},"book":{"id":"REV","translationId":"jnj_etw","name":"ዮሀኒስኒ ራእ","commonName":"ዮሀኒስኒ ራእ","title":"ዮሀኒስኒ ራእ","order":66,"numberOfChapters":22,"sha256":"ec2d11cc8456282665a07613c191bae209894caabd8e93767ee1042d766987a0","firstChapterNumber":1,"firstChapterApiLink":"/api/jnj_etw/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/jnj_etw/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":15,"content":[{"type":"heading","content":["ኮእኒ ቤቶሲክቶኖን ኤጶ ሀኦኒ ዎሲያ"]},{"type":"verse","number":1,"content":["ኦማ አካማ ደይ ዲንቂ ቤሶ ሳማስታክ ቢን፤ ሀኦሲ ግእአ ኮኡናክ ዛጉኒ ኮእኒ ናፉን ቤቶሶን ኤጶ ሀኦኒ ዎሲያ ናፉኖን ቢን።"]},{"type":"verse","number":2,"content":["ኤሴን ኦርፎ ጌያ ዎእቶ ቡርጩቆነ ፋ ባሃሪ ቢን። ኤሲስማቶ ጎኞሶንናዋ ጎኞሲ ሱራኖንና፤ ደይ ሱንባሲ ፋዳኖን ኔቤሬ ሜሬ ባሶትን ቢን፤ ሀኦስ ባሶክ እምና ካማሶን ኤጳት ቡርጩቆነ ፋ ባሃሪሲ ቴሻ የርሴፌር።"]},{"type":"verse","number":3,"content":["ሀኦሲ ዎስትኛ ስና ሙሴኒ ጋማሶንናዋ ፋንቱሳ ጋማኖንና፦",{"text":"«ዙታምባሴ አሲን ችምፋ ዳማ ሀኦሴ!","poem":1},{"text":"ዎስቶኔስ አካማ ደይ ዲንቂዌ፤","poem":2},{"lineBreak":true},{"text":"ዳራኒ ሜኒ ታቶኖ!","poem":2},{"lineBreak":true},{"text":"ኡጉኔስ ልኪ ደይ ፉቶዋ፤","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዳሚሶ! ኔን ድጎኖር፤","poem":1},{"text":"ሱንኔሶን ደይ ኡልፍንሱኖር ኦንሶ?","poem":2},{"lineBreak":true},{"text":"ነ ነቱ ኮርቶዋ፤","poem":2},{"lineBreak":true},{"text":"ፉቶኒ ማጝሱኒ ካርኔስ አምማኖን ኬስሳ ቤስቴና ቦርአ፤","poem":2},{"lineBreak":true},{"text":"ዳራስ ዙቴሬ ዬሬ ኔኪ ስና ሳጋዶሶነዋ»","poem":2},"ይት ጋሜት ፌሴቴር።"]},{"type":"verse","number":5,"content":["ኤሴን ኦርፎ ደይ ቢን፤ ዛልኒ ዱርካኒ ስና ቤቴሜቅደሲስ ደን ሳማክ ጋችቼ።"]},{"type":"verse","number":6,"content":["ናፉን ቤቶሶን ኤጶ ሀኦሲ ናፉን ዎሲያኒክቶ ቤቴሜቅደሲሲን ኬሲ፤ ካይማ ፎሮ ፓልፓሉ ላይሎንኒ ማማ ማዮ። ንቤሲሶን ደይ ዋርቄኒ ታልፋክ ታርኤራ ፌሴቴር።"]},{"type":"verse","number":7,"content":["አቼች ካባሬሬ ዉዛሲክቶስን እሳይስ ሀኦኒ ናፉን ዎሲያሲክቶክ ኮእባኔን ኮእባ ፎንቶኖን ካርአ ፎኒ ሀኦሲ ግእአ ቱምማ ፋና ናፉን ዋርቄኒ ቶፎሶን እሚ።"]},{"type":"verse","number":8,"content":["ቤቴሜቅደሲስ ደይ ሀኦሲ ኡልፍናታንናዋ ሁግናታንና ካብ ቾዋ ቹዋክ ቱሚ። ሀኦሲ ናፉን ዎሲያኒክቶ ኤጴና ናፉን ቤቶሲክቶ ኮኡናኔን ኦኑ ቤቴሜቅደሲሲ ግሩናክ ኣነ ችሜ።"]}],"footnotes":[]},"thisChapterLink":"/api/jnj_etw/REV/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jnj_etw/REV/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jnj_etw/REV/14.json","previousChapterAudioLinks":{},"numberOfVerses":8}