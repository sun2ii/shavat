{"translation":{"id":"jnj_etw","name":"ጋዶ ቴያ","website":"https://ebible.org/Scriptures/details.php?id=jnje","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jnje","licenseNotes":null,"shortName":"ETW","englishName":"Yemsa NT Ethiopic","language":"jnj","textDirection":"ltr","sha256":"a2c7a249ba74bd3a956af8ffe06def486e57f94f9e4eb6f05928af891fb1f0d9","availableFormats":["json"],"listOfBooksApiLink":"/api/jnj_etw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7924,"languageName":"Yemsa","languageEnglishName":"Yemsa"},"book":{"id":"REV","translationId":"jnj_etw","name":"ዮሀኒስኒ ራእ","commonName":"ዮሀኒስኒ ራእ","title":"ዮሀኒስኒ ራእ","order":66,"numberOfChapters":22,"sha256":"ec2d11cc8456282665a07613c191bae209894caabd8e93767ee1042d766987a0","firstChapterNumber":1,"firstChapterApiLink":"/api/jnj_etw/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/jnj_etw/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":5,"content":[{"type":"heading","content":["ማፃፋሴዋ ፋንቱስና"]},{"type":"verse","number":1,"content":["ዝግሞስታ ድ ባሳ ሆእታ ኩሹስሲ ስሩክናዋ ቱካክና ትቾ ናፉን ማታማክ ኩሉፍቶ ብራናኒ ብርቶ ማፃፋ ቢን።"]},{"type":"verse","number":2,"content":["እሳ ሁግናባ ፋና ሀኦሲ ዎሲያ አካማ ካማክ፦ «ማታማሶን ጋቻናክናዋ ብራናኒ ብርቶ ማፃፋሶን ዎዋናክና ሾልሲናስ ኦንሶ?» ይት አዋስፌን ቢን።"]},{"type":"verse","number":3,"content":["ስኑንታኖ ሳማኪ ስኑን ዳስታክ ወደይ ዳስ ስካሎሲክ ብራናኒ ብርቶ ማፃፋሶን ጋቻናክናዋ ሲካሎባሶን ብያናክና ችማር ኦኑ ኣፌ።"]},{"type":"verse","number":4,"content":["ብራናኒ ብርቶ ማፃፋሶን ዎዋናክናዋ ስሩክ ፋ ባሮን ብያናክና ሾልሲናር ቤስቶ ቤይና ቦርአ አካማኖን ዋስን።"]},{"type":"verse","number":5,"content":["ኤስ ካባሲክ ኩርኡኒ ሜያስን እሳር፦ «ዋሱታታዋ፤ ዩዳኒ ዛላስን ስና ዳዊትኒ ኮኒቶሲ ቱዛስን ኬሳ ኤቶስ ሜሬዋ፤ ባር ብራናኒ ብርቶ ማፃፋሶንናዋ ናፉን ማታማሲክቶኖንና ጋቻናክ ችማርዋ» ይ።"]},{"type":"verse","number":6,"content":["ኤሴን ኦርፎ ዝግሞስታናዋ አቼች ካባሬሬ ዉዛሲክቶኒ ጋነያሲ ደይ ኩርኡኒ ሜኒ ጋነያሲ ደይ ሹክቶ ፋንቱነ ፌር የሬፌን ቢን፤ ኤስ ፋንቱስ ናፉን ካላባናዋ ናፉን ኣፍባና ፋር፤ ኤስ ባርኪቶ ዳ ዙታምባሴ አሲስታ ዎስቴራ ሀማ ሀኦኒ ናፉን አያናሲክቶዋ።"]},{"type":"verse","number":7,"content":["ፋንቱስ ዬሬ ዝግሞስታ ድ ባር ሆእታ ኩሹስን ብራናኒ ብርቶ ማፃፋሶን ኤጲ።"]},{"type":"verse","number":8,"content":["ብራናኒ ብርቶ ማፃፋሶን ኤጵፌና ካባሲክ አቼች ካባሬሬ ዉዛሲክቶነዋ ሄፓስሬ አቼቼ ኩርኡኒ ሜና ፋንቱሳ ስና ስንቤሲሲክ ጋንደሴቴ፤ እሳ እሳርቤሲስ ኩሹቤሲስ ካማ ኤጴሬ ፌሴቴር፤ ኤሲስማቶ ኮርቶኒ ሜኒ ሺጶ ስና እጣና ኪቼፋና ዋርቄኒ ክርቅዳሶን ኤጴሬ ፌሴቴር።"]},{"type":"verse","number":9,"content":["ኦራ ጋማክ ኤካ ይት ጋሜሴቴ፦",{"text":"«ሀርንኔሲክ አሲቴሴሪሲክቶስን፤","poem":1},{"text":"ዎሉምቴፋ ኖኖሲክቶስን፤","poem":2},{"lineBreak":true},{"text":"ኬና ኬናስን፥ ዳራ ዳራሳስን፤","poem":2},{"lineBreak":true},{"text":"አሱኒ ሜያኖን ሀኦሲክ ፉሮታክ ነ ሹክቴታ ቦርአ፤","poem":2},{"lineBreak":true},{"text":"ብራናኒ ብርቶ ማፃፋሶን ኤጳታክናዋ፤","poem":2},{"lineBreak":true},{"text":"ማታማሲክቶኖን ጋቻታክና ሾልሲናር ስኒትዋ።","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ሀኦኒስ ታቶኒ ማግኒ ሜያ ስኖነክ ዛግት፤","poem":2},{"lineBreak":true},{"text":"ሀን ዳስታክ ደይ ታትቶሶነ።»","poem":2}]},{"type":"verse","number":11,"content":["ኤስታን ደይ ቢና ዝግሞሴዋ ካባሬሬ ዉዛሴ ደይ ኩርኡኒ ሜኒ ብራቶስታ ሾዎ ሀኦኒ ዎሲኒ ካማ ኦደን፤ ሾዎቤሲስ ደይ አካማ ኩማክናዋ አካማ ምልዮኒክና ፋድቶኒር።"]},{"type":"verse","number":12,"content":["አካማ ካማክ፦",{"text":"«ሹክቴ ፋንቱስ፤","poem":1},{"text":"ሁግና፥ ኦትማ፥ ቴችማ፥ ችማ፤","poem":2},{"lineBreak":true},{"text":"አሪክቶ፥ ኡልፍነዋ ጋላትነ፤","poem":2},{"lineBreak":true},{"text":"ኤጳቶናክ ሾልሱዋ» ይሴቴ።","poem":2}]},{"type":"verse","number":13,"content":["ደን ሳማክናዋ ሀን ዳስታክና፤ ዳሲ ሲካሎስንናዋ ባሪስንና ፋ ቴስቶስ ዙቴራ፦",{"text":"«ዝግሞስታ ድ ባሪክናዋ ፋንቱሲክና","poem":1},{"text":"ጋላታ፥ አሪክቶ፥ ኡልፍነዋ ሁግናነ፤","poem":2},{"text":"ኮእባኔን ኮእባ ፎንቶኖን ስኑን»","poem":1},"ይሴፌን ኦደን።"]},{"type":"verse","number":14,"content":["አቼች ካባሬሬ ዉዛሲክቶ ደይ፦ «ኣሚን!» ይሴቴ። ሄፓስሬ አቼቼ ኩርኡኒ ሜያ ደይ ስንቤሲሲክ ካአነሬ ሳጋደሴቴ።"]}],"footnotes":[]},"thisChapterLink":"/api/jnj_etw/REV/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jnj_etw/REV/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jnj_etw/REV/4.json","previousChapterAudioLinks":{},"numberOfVerses":14}