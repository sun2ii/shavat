{"translation":{"id":"jnj_ltw","name":"Gaddo Teyya","website":"https://ebible.org/Scriptures/details.php?id=jnjl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=jnjl","licenseNotes":null,"shortName":"LTW","englishName":"Yemsa NT Latin","language":"jnj","textDirection":"ltr","sha256":"ac02eb68fbcebf4f6c688751775651991f24780ad44c440671de74482621f9cb","availableFormats":["json"],"listOfBooksApiLink":"/api/jnj_ltw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7924,"languageName":"Yemsa","languageEnglishName":"Yemsa"},"book":{"id":"HEB","translationId":"jnj_ltw","name":"Ibrawi","commonName":"Ibrawi","title":"Ibrawini Meyaki Woste Wosiya","order":58,"numberOfChapters":13,"sha256":"8219e9bb25672426c4a3e4eba7abe3183c97940472efaa5c58c42510733493ae","firstChapterNumber":1,"firstChapterApiLink":"/api/jnj_ltw/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/jnj_ltw/HEB/13.json","totalNumberOfVerses":302},"chapter":{"number":1,"content":[{"type":"heading","content":["Ha'oos Nawubaaski Kamo Make"]},{"type":"verse","number":1,"content":["Ha'oos zeemoti neyaassi showo ugnak; raajjuni meyaki kamo inno abani meyak showo kaba maket faar."]},{"type":"verse","number":2,"content":["Sinuntano hash orfoti neyaassi zuuttambaase asin warasonir zagina nawubaaski kamo innok make. Han daason dey zuuttambaase asin tesinaas barikwa."]},{"type":"verse","number":3,"content":["Bar Ha'oosi ulfinanon palpalgire besir. Bar haalabaasik Ha'oosneen ane mai'sire isarwa. Kaambaasi hugnak han daason zuutire teebbe ephiwa. Asuni meyanon dey boor'besiissin kayimsinanneen orfo samak hugnaba faana Ha'oosi ho'itta di."]},{"type":"verse","number":4,"content":["Barik imte sunaas Ha'oosi wosiyani suntan denalo sinnamato Ha'oosi Naa Ha'oosi wosiyatan akamanon denalowa."]},{"type":"heading","content":["Ha'oosi Naa Ha'oosi Wosiyatan Akamanon Denalo"]},{"type":"verse","number":5,"content":[{"text":"Ha'oos bari wosiyaasi ganeyasin:","poem":1},{"text":"«Ne Naatawa;","poem":2},{"lineBreak":true},{"text":"hawung neen koonin»","poem":2},{"lineBreak":true},{"text":"hepsa dey: «Ta barik aba sinana;","poem":2},{"lineBreak":true},{"text":"bar dey taak Naata sinana»","poem":2},{"lineBreak":true},{"text":"yinaas oonininso?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ha'oos uuzza Nawubaasin","poem":1},{"text":"han daasta wosifana kabaasik;","poem":2},{"lineBreak":true},{"text":"«Ha'oosi wosiya zuuttera;","poem":2},{"lineBreak":true},{"text":"barik sagadona» yifawa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sinuntano Ha'oosi wosiyani chowaasik;","poem":1},{"text":"dey: «Ha'oosi wosiyanikitonon Ayyananikito;","poem":2},{"lineBreak":true},{"text":"Ha'oosik wostesefe baassotin;","poem":2},{"lineBreak":true},{"text":"dey geeni winonikito zagunir» yifawa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sinuntano Naasa chowak;","poem":1},{"text":"«Ha'oose; zigimunees koi'ba foontonon foonir;","poem":2},{"lineBreak":true},{"text":"taatonees dey ookoni haaro.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ookooson shunit; manguuson dey oomtet;","poem":1},{"text":"es bari boor'a Daama Ha'onees;","poem":2},{"lineBreak":true},{"text":"omoneesatan denalonon gira;","poem":2},{"lineBreak":true},{"text":"imfa muudak neen muudi» yifa.","poem":2}]},{"type":"verse","number":10,"content":["Esiisimato dey:",{"text":"«Daamiiso! Ne zeemma daason tesitwa;","poem":2},{"lineBreak":true},{"text":"samaasikito dey kushuneesi wostowa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Es barikito zuuttera tishunir;","poem":1},{"text":"sinuntano ne footar;","poem":2},{"lineBreak":true},{"text":"zuuttambaase maamnimato kur'una.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Maamnimato zagira biruta;","poem":1},{"text":"barikito dey maamnimato sinna sooltona;","poem":2},{"lineBreak":true},{"text":"sinuntano ne aagene aagene sinfanak;","poem":2},{"lineBreak":true},{"text":"ne; neneesik koi'ba aafa» yifa.","poem":2}]},{"type":"verse","number":13,"content":["Ha'oos bari wosiyaasikitoni ganeyasin:",{"text":"«Gumaneesakitonin wochoneesi;","poem":1},{"text":"sikalosi zaguna kabaneen;","poem":2},{"lineBreak":true},{"text":"ta hoi'ta teshaasta duwa»","poem":2},"yinaas oonininso?"]},{"type":"verse","number":14,"content":["Eekan Ha'oosi wosiya zuuttera faruni asuni meyak wostonak wostera ya Ha'oni wostinynya sina Ayyananikitotanoso?"]}],"footnotes":[]},"thisChapterLink":"/api/jnj_ltw/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/jnj_ltw/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/jnj_ltw/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}