rse":19}},{"noteId":101,"caller":"+","text":"1 ಕೊರಿ 2:4:","reference":{"chapter":4,"verse":20}},{"noteId":102,"caller":"+","text":"2 ಕೊರಿ 13:2, 10 ಇತ್ಯಾದಿ.","reference":{"chapter":4,"verse":21}}]},"thisChapterLink":"/api/kan_irv/1CO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_irv/1CO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_irv/1CO/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}