},{"noteId":116,"caller":"+","text":"1 ಯೋಹಾ 2:8; 3:11:","reference":{"chapter":3,"verse":23}},{"noteId":117,"caller":"+","text":"ಯೋಹಾ 6:56; 14:20; 15:4, 5; 17:21:","reference":{"chapter":3,"verse":24}},{"noteId":118,"caller":"+","text":"1 ಯೋಹಾ 4:13; ರೋಮಾ. 8:9:","reference":{"chapter":3,"verse":24}}]},"thisChapterLink":"/api/kan_irv/1JN/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_irv/1JN/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_irv/1JN/2.json","previousChapterAudioLinks":{},"numberOfVerses":24}