{"translation":{"id":"kan_irv","name":"ಇಂಡಿಯನ್ ರಿವೈಜ್ಡ್ ವರ್ಸನ್ (IRV) - ಕನ್ನಡ - 2019","website":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseNotes":null,"shortName":"IRV","englishName":"Kannada Indian Revised Version Bible","language":"kan","textDirection":"ltr","sha256":"82cc741009376c81c4416c230a757b2e30ef49b2e4672f9831adcedfc26b865f","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31031,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"1PE","translationId":"kan_irv","name":"1 ಪೇತ್ರನು","commonName":"1 ಪೇತ್ರನು","title":"1 ಪೇತ್ರನು","order":60,"numberOfChapters":5,"sha256":"39c5e17b858554c5ac0df556482ebd23bdc91d7c39bbfcb9d37ab16c15398e69","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_irv/1PE/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/kan_irv/1PE/5.json","totalNumberOfVerses":103},"chapter":{"number":4,"content":[{"type":"heading","content":["ಪರಿವರ್ತನೆಗೊಂಡ ಜೀವಿತಗಳು"]},{"type":"verse","number":1,"content":[{"noteId":140},"ಕ್ರಿಸ್ತನು ನಮಗೋಸ್ಕರ ತನ್ನ ಶರೀರದಲ್ಲಿ ಬಾಧೆಪಟ್ಟದ್ದರಿಂದ ನೀವು ಸಹ",{"noteId":141},"ಅದೇ ಮನೋಭಾವವುಳ್ಳವರಾಗಿದ್ದು ಬಾಧೆಪಡಲು ಸಿದ್ಧರಾಗಿರಿ. ಏಕೆಂದರೆ",{"noteId":142},"ಶರೀರದಲ್ಲಿ ಬಾಧೆಪಟ್ಟವನು",{"noteId":143},"ಪಾಪ ಮಾಡುವುದನ್ನು ನಿಲ್ಲಿಸಿದವನಾಗಿದ್ದಾನೆ."]},{"type":"verse","number":2,"content":["ಆದ್ದರಿಂದ ಉಳಿದಿರುವ ತನ್ನ ಜೀವಮಾನ ಕಾಲದಲ್ಲಿ",{"noteId":144},"ಇನ್ನೂ ಮನುಷ್ಯರ ಅಭಿಲಾಷೆಗಳ ಪ್ರಕಾರ ಬದುಕದೆ",{"noteId":145},"ದೇವರ ಚಿತ್ತದ ಪ್ರಕಾರ ಬದುಕುವುದಕ್ಕೆ",{"noteId":146},"ಪ್ರಯತ್ನಮಾಡುವನು."]},{"type":"verse","number":3,"content":["ನೀವು ಬಂಡುತನ, ದುರಾಶೆ, ಕುಡುಕತನ, ದುಂದೌತಣ, ಮದ್ಯಪಾನ ಗೋಷ್ಠಿ, ಅಸಹ್ಯವಾದ ವಿಗ್ರಹಾರಾಧನೆ, ಈ ಮೊದಲಾದವುಗಳನ್ನು ನಡಿಸುವುದರಲ್ಲಿಯೂ",{"noteId":147},"ಅನ್ಯಜನರಿಗೆ ಇಷ್ಟವಾದ ದುಷ್ಕೃತ್ಯಗಳನ್ನು ಮಾಡುವುದರಲ್ಲಿಯೂ",{"noteId":148},"ಕಾಲಕಳೆದದ್ದು ಸಾಕು."]},{"type":"verse","number":4,"content":["ಅವರು ಮಾಡುವ ಅಪರಿಮಿತವಾದ",{"noteId":149},"ಪಟಿಂಗತನದಲ್ಲಿ ನೀವು ಸೇರದೆ ಇದ್ದದ್ದಕ್ಕೆ ಅವರು ಆಶ್ಚರ್ಯಪಟ್ಟು",{"noteId":150},"ನಿಮ್ಮನ್ನು ದೂಷಿಸುತ್ತಾರೆ."]},{"type":"verse","number":5,"content":["ಅವರು",{"noteId":151},"ಬದುಕಿರುವವರಿಗೂ ಸತ್ತವರಿಗೂ ನ್ಯಾಯತೀರಿಸುವುದಕ್ಕೆ ಸಿದ್ಧವಾಗಿರುವಾತನಿಗೆ ಉತ್ತರ ಕೊಡಬೇಕು."]},{"type":"verse","number":6,"content":["ಸತ್ತಿರುವವರು ಮನುಷ್ಯ ಜಾತಿಗೆ ಬರುವ ಮರಣವೆಂಬ ತೀರ್ಪನ್ನು ಶರೀರಗಳಲ್ಲಿದ್ದಾಗ ಹೊಂದಿದರು.",{"noteId":152},"ಅವರು ಆತ್ಮ ಸಂಬಂಧವಾಗಿ ದೇವರಂತೆ ಜೀವಿಸಲೆಂದು",{"noteId":153},"ಅವರಿಗೂ ಸುವಾರ್ತೆಯು ತಿಳಿಸಲ್ಪಟ್ಟಿತು."]},{"type":"heading","content":["ದೇವರ ವರಗಳ ಒಳ್ಳೆಯ ನಿರ್ವಾಹಕನು"]},{"type":"verse","number":7,"content":[{"noteId":154},"ಎಲ್ಲವುಗಳ ಅಂತ್ಯವು ಹತ್ತಿರವಾಗಿದೆ. ಆದ್ದರಿಂದ ನೀವು ಜಿತೇಂದ್ರಿಯರಾಗಿಯೂ ಯಾವಾಗಲೂ",{"noteId":155},"ಪ್ರಾರ್ಥನೆಗೆ ಸಿದ್ಧವಾಗಿರುವಂತೆ",{"noteId":156},"ಸ್ವಸ್ಥಚಿತ್ತರಾಗಿಯೂ ಇರಿ."]},{"type":"verse","number":8,"content":["ಮೊಟ್ಟಮೊದಲು ನಿಮ್ಮ ನಿಮ್ಮೊಳಗೆ ಪ್ರಾಮಾಣಿಕವಾದ ಪ್ರೀತಿಯಿರಲಿ.",{"noteId":157},"ಪ್ರೀತಿಯು ಬಹು ಪಾಪಗಳನ್ನು ಮುಚ್ಚುತ್ತದೆ."]},{"type":"verse","number":9,"content":["ಗುಣಗುಟ್ಟದೆ ಒಬ್ಬರಿಗೊಬ್ಬರು",{"noteId":158},"ಅತಿಥಿ ಸತ್ಕಾರ ಮಾಡಿರಿ."]},{"type":"verse","number":10,"content":["ನೀವೆಲ್ಲರು ದೇವರ ವಿವಿಧ ವರಗಳ ವಿಷಯದಲ್ಲಿ",{"noteId":159},"ಒಳ್ಳೆಯ ನಿರ್ವಾಹಕರಾಗಿದ್ದು ಪ್ರತಿಯೊಬ್ಬನು",{"noteId":160},"ತಾನು ಹೊಂದಿದ ಕೃಪಾವರವನ್ನು ಎಲ್ಲರ ಸೇವೆಗಾಗಿ ಉಪಯೋಗಿಸಕೊಳ್ಳಲಿ."]},{"type":"verse","number":11,"content":["ಒಬ್ಬನು ಬೋಧಿಸುವವನಾದರೆ",{"noteId":161},"ದೈವೋಕ್ತಿಗಳನ್ನು ನುಡಿಯುವವನಾಗಿ ಬೋಧಿಸಲಿ. ಒಬ್ಬನು ಸೇವೆ ಮಾಡುವವನಾದರೆ ದೇವರು ಕೊಡುವ ಶಕ್ತಿಗನುಗುಣವಾಗಿ ಮಾಡಲಿ. ಇವೆಲ್ಲವುಗಳಿಂದ ಯೇಸು ಕ್ರಿಸ್ತನ ಮೂಲಕ",{"noteId":162},"ದೇವರಿಗೆ ಸ್ತೋತ್ರ ಉಂಟಾಗುವುದು.",{"noteId":163},"ಯೇಸು ಕ್ರಿಸ್ತನಿಗೆ",{"noteId":164},"ಅಧಿಪತ್ಯವೂ ಮತ್ತು ಘನವೂ ಯುಗಯುಗಾಂತರಗಳಲ್ಲಿಯೂ ಇರುವವು ಆಮೆನ್."]},{"type":"heading","content":["ಕ್ರೈಸ್ತನಾಗಿ ಬಾಧೆಯನ್ನನುಭವಿಸುವುದು"]},{"type":"verse","number":12,"content":["ಪ್ರಿಯರೇ, ನಿಮ್ಮನ್ನು ಪರಿಶೋಧಿಸುವುದಕ್ಕಾಗಿ",{"noteId":165},"ಅಗ್ನಿ ಪರೀಕ್ಷೆ ಬರುವಾಗ ನೀವು ಆಶ್ಚರ್ಯಪಡಬೇಡಿರಿ. ವಿಪರೀತವಾದ ಸಂಗತಿ ಸಂಭವಿಸಿತೆಂದು ಯೋಚಿಸಬೇಡಿರಿ."]},{"type":"verse","number":13,"content":["ಆದರೆ",{"noteId":166},"ನೀವು ಎಷ್ಟರ ಮಟ್ಟಿಗೆ ಕ್ರಿಸ್ತನ ಬಾಧೆಗಳಲ್ಲಿ ಪಾಲುಗಾರರಾಗಿದ್ದೀರೋ ಅಷ್ಟರ ಮಟ್ಟಿಗೆ ಸಂತೋಷಪಡಿರಿ. ಆದ್ದರಿಂದ",{"noteId":167},"ಆತನ ಮಹಿಮೆಯ ಪ್ರತ್ಯಕ್ಷತೆಯಲ್ಲಿಯೂ ನೀವು ಸಂತೋಷಪಟ್ಟು ಉಲ್ಲಾಸಗೊಳ್ಳುವಿರಿ"]},{"type":"verse","number":14,"content":[{"noteId":168},"ನೀವು ಕ್ರಿಸ್ತನ ಹೆಸರಿನ ನಿಮಿತ್ತ ನಿಂದೆಗೆ ಗುರಿಯಾದರೆ ಧನ್ಯರು.",{"noteId":169},"ಮಹಿಮೆಯ ಆತ್ಮನಾಗಿರುವ ದೇವರಾತ್ಮನು ನಿಮ್ಮಲ್ಲಿ ನೆಲೆಗೊಂಡಿದ್ದಾನಲ್ಲಾ."]},{"type":"verse","number":15,"content":[{"noteId":170},"ನಿಮ್ಮಲ್ಲಿ ಯಾವನಾದರು ಕೊಲೆಗಾರನು, ಕಳ್ಳನು, ದುಷ್ಟನು, ಪರರ ಕಾರ್ಯಗಳಲ್ಲಿ",{"noteId":171},"ತಲೆಹಾಕುವವನು ಆಗಿದ್ದು ಶಿಕ್ಷಾಪಾತ್ರನಾಗಬಾರದು."]},{"type":"verse","number":16,"content":["ಆದರೆ",{"noteId":172},"ಕ್ರೈಸ್ತನಾಗಿ ಬಾಧೆಪಟ್ಟರೆ ಅವನು ನಾಚಿಕೆ ಪಡದೆ ಆ ಹೆಸರಿನಿಂದಲೇ ದೇವರನ್ನು ಘನಪಡಿಸಲಿ."]},{"type":"verse","number":17,"content":["ನ್ಯಾಯವಿಚಾರಣೆಯ ಸಮಯ ಬಂದಿದೆ.",{"noteId":173},"ಆ ವಿಚಾರಣೆಯು ದೇವರ ಮನೆಯಲ್ಲಿಯೇ ಪ್ರಾರಂಭವಾಗಿದೆಯಲ್ಲಾ.",{"noteId":174},"ಅದು ನಮ್ಮಲ್ಲಿ ಪ್ರಾರಂಭವಾಗುವುದಾದರೆ, ದೇವರ ಸುವಾರ್ತೆಯನ್ನು ನಂಬಲೊಲ್ಲದವರ ಅಂತ್ಯ ಹೇಗಿರಬಹುದು?"]},{"type":"verse","number":18,"content":[{"noteId":175},"ನೀತಿವಂತನೇ ರಕ್ಷಣೆ ಹೊಂದುವುದು ಕಷ್ಟವಾದರೆ, ಭಕ್ತಿಹೀನನೂ ಮತ್ತು ಪಾಪಿಷ್ಠನೂ ರಕ್ಷಣೆ ಹೊಂದುವುದು ಹೇಗೆ?"]},{"type":"verse","number":19,"content":["ಹೀಗಿರಲಾಗಿ ದೇವರ ಚಿತ್ತಾನುಸಾರ ಬಾಧೆಪಡುವವರು ಒಳ್ಳೆದನ್ನು ಮಾಡುವವರಾಗಿದ್ದು",{"noteId":176},"ತಮ್ಮ ಆತ್ಮಗಳನ್ನು ನಂಬಿಗಸ್ತನಾದ ಸೃಷ್ಟಿ ಕರ್ತನಿಗೆ ಒಪ್ಪಿಸಲಿ."]}],"footnotes":[{"noteId":140,"caller":"+","text":"1 ಪೇತ್ರ. 3:18:","reference":{"chapter":4,"verse":1}},{"noteId":141,"caller":"+","text":"ಫಿಲಿ. 2:5; ಎಫೆ 6:13:","reference":{"chapter":4,"verse":1}},{"noteId":142,"caller":"+","text":"ರೋಮಾ. 6:2,7; ಗಲಾ. 5:24; ಕೊಲೊ 3:3, 5:","reference":{"chapter":4,"verse":1}},{"noteId":143,"caller":"+","text":"2 ಪೇತ್ರ. 2:14","reference":{"chapter":4,"verse":1}},{"noteId":144,"caller":"+","text":"1 ಪೇತ್ರ. 1:14; ತೀತ. 2:12; 1 ಯೋಹಾ 2:16.","reference":{"chapter":4,"verse":2}},{"noteId":145,"caller":"+","text":"ರೋಮಾ. 6:11:","reference":{"chapter":4,"verse":2}},{"noteId":146,"caller":"+","text":"ರೋಮಾ. 6:14; 14:7; 2 ಕೊರಿ 5:15:","reference":{"chapter":4,"verse":2}},{"noteId":147,"caller":"+","text":"ಎಫೆ 4:17-19; 1 ಥೆಸ. 4:5; 1 ಕೊರಿ 12:2:","reference":{"chapter":4,"verse":3}},{"noteId":148,"caller":"+","text":"ಯೆಹೆ. 45:9; ಅ. ಕೃ. 17:30.","reference":{"chapter":4,"verse":3}},{"noteId":149,"caller":"+","text":"ಎಫೆ 5:18:","reference":{"chapter":4,"verse":4}},{"noteId":150,"caller":"+","text":"1 ಪೇತ್ರ. 2:12; 3:16:","reference":{"chapter":4,"verse":4}},{"noteId":151,"caller":"+","text":"ಅ. ಕೃ. 10:42; 2 ಕೊರಿ 5:10; ಯಾಕೋಬ 5:9:","reference":{"chapter":4,"verse":5}},{"noteId":152,"caller":"+","text":"ಅಥವಾ, ಶರೀರವನ್ನು ಬಿಟ್ಟವರಾಗಿ.","reference":{"chapter":4,"verse":6}},{"noteId":153,"caller":"+","text":"1 ಪೇತ್ರ. 3:19:","reference":{"chapter":4,"verse":6}},{"noteId":154,"caller":"+","text":"ಯಾಕೋಬ 5:8:","reference":{"chapter":4,"verse":7}},{"noteId":155,"caller":"+","text":"ಮತ್ತಾ 26:41; ಲೂಕ 21:36:","reference":{"chapter":4,"verse":7}},{"noteId":156,"caller":"+","text":"1 ಪೇತ್ರ. 1:13:","reference":{"chapter":4,"verse":7}},{"noteId":157,"caller":"+","text":"1 ಕೊರಿ 13:5, 6; ಜ್ಞಾ. 10:12; 17:9:","reference":{"chapter":4,"verse":8}},{"noteId":158,"caller":"+","text":"ಇಬ್ರಿ. 13:2; 1 ತಿಮೊ. 3:2; ತೀತ. 1:8:","reference":{"chapter":4,"verse":9}},{"noteId":159,"caller":"+","text":"ಲೂಕ 12:42; 1 ಕೊರಿ 4:1, 2; ತೀತ. 1:7:","reference":{"chapter":4,"verse":10}},{"noteId":160,"caller":"+","text":"ರೋಮಾ. 12:6, 7; 1 ಕೊರಿ 4:7; ಮತ್ತಾ 25:15:","reference":{"chapter":4,"verse":10}},{"noteId":161,"caller":"+","text":"ಅ. ಕೃ. 7:38; ರೋಮಾ. 3:2; ಇಬ್ರಿ. 5:12:","reference":{"chapter":4,"verse":11}},{"noteId":162,"caller":"+","text":"1 ಕೊರಿ 10:31:","reference":{"chapter":4,"verse":11}},{"noteId":163,"caller":"+","text":"ರೋಮಾ. 11:36:","reference":{"chapter":4,"verse":11}},{"noteId":164,"caller":"+","text":"1 ಪೇತ್ರ. 5:11; ಯೂದ. 25; ಪ್ರಕ 1:6; 5:13:","reference":{"chapter":4,"verse":11}},{"noteId":165,"caller":"+","text":"1 ಪೇತ್ರ. 1:7:","reference":{"chapter":4,"verse":12}},{"noteId":166,"caller":"+","text":"ಫಿಲಿ. 3:10, 11; ಅ. ಕೃ. 5:41:","reference":{"chapter":4,"verse":13}},{"noteId":167,"caller":"+","text":"1 ಪೇತ್ರ. 1:5-7; 5:1; ರೋಮಾ. 8:17, 18; ಯೂದ. 24:","reference":{"chapter":4,"verse":13}},{"noteId":168,"caller":"+","text":"ಮತ್ತಾ 5:11; ಯೋಹಾ 15:21; ಇಬ್ರಿ. 11:26:","reference":{"chapter":4,"verse":14}},{"noteId":169,"caller":"+","text":"ಯೆಶಾ 11:2:","reference":{"chapter":4,"verse":14}},{"noteId":170,"caller":"+","text":"1 ಪೇತ್ರ. 2:19, 20; 3:14, 17:","reference":{"chapter":4,"verse":15}},{"noteId":171,"caller":"+","text":"ಅಥವಾ, ನಿಕೃಷ್ಟ ಕಾರ್ಯಗಳನ್ನು ನಡಿಸುವವನು. ತಲೆಹಾಕುವವನು ಎಂಬುದರೊಂದಿಗೆ 1 ಥೆಸ. 4:11; 2 ಥೆಸ. 3:11; 1 ತಿಮೊ. 5:13:","reference":{"chapter":4,"verse":15}},{"noteId":172,"caller":"+","text":"1 ಪೇತ್ರ. 2:19, 20; 3:14, 17; ಅ. ಕೃ. 26:28:","reference":{"chapter":4,"verse":16}},{"noteId":173,"caller":"+","text":"ಯೆರೆ 25:29; ಯೆಹೆ. 9:6; ಆಮೋ. 3:2; ರೋಮಾ. 2:9:","reference":{"chapter":4,"verse":17}},{"noteId":174,"caller":"+","text":"ಲೂಕ 23:31:","reference":{"chapter":4,"verse":17}},{"noteId":175,"caller":"+","text":"ಜ್ಞಾ. 11:31:","reference":{"chapter":4,"verse":18}},{"noteId":176,"caller":"+","text":"ಕೀರ್ತ 31:5; ಲೂಕ 23:46; 2 ತಿಮೊ. 1:12:","reference":{"chapter":4,"verse":19}}]},"thisChapterLink":"/api/kan_irv/1PE/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_irv/1PE/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_irv/1PE/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}