{"translation":{"id":"kan_irv","name":"ಇಂಡಿಯನ್ ರಿವೈಜ್ಡ್ ವರ್ಸನ್ (IRV) - ಕನ್ನಡ - 2019","website":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseNotes":null,"shortName":"IRV","englishName":"Kannada Indian Revised Version Bible","language":"kan","textDirection":"ltr","sha256":"82cc741009376c81c4416c230a757b2e30ef49b2e4672f9831adcedfc26b865f","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31031,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"1PE","translationId":"kan_irv","name":"1 ಪೇತ್ರನು","commonName":"1 ಪೇತ್ರನು","title":"1 ಪೇತ್ರನು","order":60,"numberOfChapters":5,"sha256":"39c5e17b858554c5ac0df556482ebd23bdc91d7c39bbfcb9d37ab16c15398e69","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_irv/1PE/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/kan_irv/1PE/5.json","totalNumberOfVerses":103},"chapter":{"number":5,"content":[{"type":"heading","content":["ದೇವರ ಮಂದೆಯ ಪೋಷಣೆ"]},{"type":"verse","number":1,"content":["ಸಭೆಯ ಹಿರಿಯರೇ,",{"noteId":177},"ಜೊತೆಹಿರಿಯವನಾದ ನಾನು ಕ್ರಿಸ್ತನ ಬಾಧೆಗಳನ್ನು",{"noteId":178},"ಕಣ್ಣಾರೆ ಕಂಡವನೂ, ಇನ್ನು ಮುಂದೆ ಪ್ರತ್ಯಕ್ಷವಾಗುವ ಮಹಿಮೆಯಲ್ಲಿ ಪಾಲುಗಾರನೂ ಆಗಿದ್ದು ನಿಮ್ಮನ್ನು ಪ್ರೋತ್ಸಾಹಿಸಿ ಹೇಳುವುದೇನಂದರೆ,"]},{"type":"verse","number":2,"content":[{"noteId":179},"ನಿಮ್ಮ ಮೇಲ್ವಿಚಾರಣೆಯಲ್ಲಿರುವ ದೇವರ ಮಂದೆಯನ್ನು ಕಾಯಿರಿ.",{"noteId":180},"ಬಲವಂತದಿಂದಲ್ಲ ದೇವರ ಚಿತ್ತಾನುಸಾರ ಇಷ್ಟಪೂರ್ವಕವಾಗಿ,",{"noteId":181},"ನೀಚವಾದ ದ್ರವ್ಯಾಶೆಯಿಂದಲ್ಲ, ಸಿದ್ಧ ಮನಸ್ಸಿನಿಂದಲೇ ಮೇಲ್ವಿಚಾರಣೆ ಮಾಡಿರಿ."]},{"type":"verse","number":3,"content":["ನಿಮ್ಮ ವಶಕ್ಕೆ ಒಪ್ಪಿಸಿಕೊಟ್ಟಿರುವವರ ಮೇಲೆ",{"noteId":182},"ದೊರೆತನಮಾಡುವವರಂತೆ ನಡೆಯದೆ",{"noteId":183},"ಮಂದೆಗೆ ಮಾದರಿಯಾಗಿಯೇ ನಡೆದುಕೊಳ್ಳಿರಿ."]},{"type":"verse","number":4,"content":[{"noteId":184},"ಪ್ರಧಾನ ಕುರುಬನು ಪ್ರತ್ಯಕ್ಷನಾಗುವಾಗ ನೀವು",{"noteId":185},"ಎಂದಿಗೂ ಬಾಡದ ಮಹಿಮೆಯ",{"noteId":186},"ಕಿರೀಟವನ್ನು ಹೊಂದುವಿರಿ."]},{"type":"verse","number":5,"content":["ಯೌವನಸ್ಥರೇ, ಅದೇ ರೀತಿಯಾಗಿ ಹಿರಿಯರಿಗೆ ಅಧೀನರಾಗಿರಿ. ನೀವೆಲ್ಲರೂ",{"noteId":187},"ದೀನಮನಸ್ಸೆಂಬ ವಸ್ತ್ರವನ್ನು ಧರಿಸಿಕೊಂಡು ಒಬ್ಬರಿಗೊಬ್ಬರು ಸೇವೆ ಮಾಡಿರಿ. ಏಕೆಂದರೆ “",{"noteId":188},"ದೇವರು ಅಹಂಕಾರಿಗಳನ್ನು ವಿರೋಧಿಸುತ್ತಾನೆ. ದೀನರಿಗಾದರೋ ಕೃಪೆಯನ್ನು ಅನುಗ್ರಹಿಸುತ್ತಾನೆ.”"]},{"type":"verse","number":6,"content":["ಹೀಗಿರುವುದರಿಂದ ದೇವರ ಬಲವುಳ್ಳ ಹಸ್ತದ ಕೆಳಗೆ ನಿಮ್ಮನ್ನು ತಗ್ಗಿಸಿಕೊಳ್ಳಿರಿ. ಆತನು ತಕ್ಕ ಕಾಲದಲ್ಲಿ ನಿಮ್ಮನ್ನು ಮೇಲಕ್ಕೆ ಎತ್ತುವನು."]},{"type":"verse","number":7,"content":[{"noteId":189},"ನಿಮ್ಮ ಚಿಂತಾಭಾರವನ್ನೆಲ್ಲಾ ಆತನ ಮೇಲೆ ಹಾಕಿರಿ ಆತನು ನಿಮಗೋಸ್ಕರ ಚಿಂತಿಸುತ್ತಾನೆ."]},{"type":"verse","number":8,"content":[{"noteId":190},"ಸ್ವಸ್ಥಚಿತ್ತರಾಗಿರಿ",{"noteId":191},"ಎಚ್ಚರವಾಗಿರಿ.",{"noteId":192},"ನಿಮ್ಮ ವಿರೋಧಿಯಾಗಿರುವ ಸೈತಾನನು",{"noteId":193},"ಘರ್ಜಿಸುವ ಸಿಂಹದೋಪಾದಿಯಲ್ಲಿ ಯಾರನ್ನು ನುಂಗಲಿ ಎಂದು ಹುಡುಕುತ್ತಾ ತಿರುಗಾಡುತ್ತಿದ್ದಾನೆ."]},{"type":"verse","number":9,"content":[{"noteId":194},"ನೀವು ನಂಬಿಕೆಯಲ್ಲಿ ದೃಢವಾಗಿದ್ದು",{"noteId":195},"ಅವನನ್ನು ಎದುರಿಸಿರಿ.",{"noteId":196},"ಲೋಕದಲ್ಲಿರುವ ನಿಮ್ಮ ಸಹೋದರರೂ ಅಂಥ ಬಾಧೆಗಳನ್ನೇ ಅನುಭವಿಸುತ್ತಿದ್ದಾರೆಂಬುದು ನಿಮಗೆ ತಿಳಿದಿದೆ."]},{"type":"verse","number":10,"content":["ಕ್ರಿಸ್ತನಲ್ಲಿ ನಿಮ್ಮನ್ನು ತನ್ನ ನಿತ್ಯ ಮಹಿಮೆಗೆ",{"noteId":197},"ಕರೆದ ಕೃಪಾಪೂರ್ಣನಾದ ದೇವರು ತಾನೇ, ನೀವು",{"noteId":198},"ಸ್ವಲ್ಪ ಕಾಲ ಬಾಧೆಪಟ್ಟ ಮೇಲೆ ನಿಮ್ಮನ್ನು ಯಥಾಸ್ಥಿತಿಗೆ ತಂದು",{"noteId":199},"ಸ್ಥಿರಪಡಿಸಿ ಬಲಪಡಿಸುವನು."]},{"type":"verse","number":11,"content":[{"noteId":200},"ಆತನಿಗೆ ಅಧಿಪತ್ಯವು ಯುಗಯುಗಾಂತರಗಳಲ್ಲಿಯೂ ಇರಲಿ. ಆಮೆನ್."]},{"type":"heading","content":["ಕಡೆ ವಂದನೆಗಳು"]},{"type":"verse","number":12,"content":["ನಿಮ್ಮನ್ನು ಪ್ರೋತ್ಸಾಹಿಸುವುದಕ್ಕೂ ಇದೇ ದೇವರ ನಿಜವಾದ ಕೃಪೆ ಎಂದು ಸಾಕ್ಷಿ ಹೇಳುವುದಕ್ಕೂ ನಾನು",{"noteId":201},"ಸಂಕ್ಷೇಪವಾಗಿ ಬರೆದು, ನಂಬಿಗಸ್ತನಾದ ಸಹೋದರನೆಂದು ನಾನು ಎಣಿಸುವ ಸಿಲ್ವಾನನ ಕೈಯಲ್ಲಿ ಇದನ್ನು ಕಳುಹಿಸಿದ್ದೇನೆ. ಈ ನಿಜವಾದ ಕೃಪೆಯಲ್ಲಿ",{"noteId":202},"ನಿಲ್ಲಿರಿ."]},{"type":"verse","number":13,"content":["ದೇವರು ನಿಮ್ಮೊಂದಿಗೆ ಆರಿಸಿಕೊಂಡಂಥ ಬಾಬಿಲೋನಿನಲ್ಲಿರುವ ಸಭೆಯು ನಿಮಗೆ ವಂದಿಸುತ್ತದೆ. ನನ್ನ ಮಗನಾದ",{"noteId":203},"ಮಾರ್ಕನು ಸಹ ನಿಮ್ಮನ್ನು ವಂದಿಸುತ್ತಾನೆ."]},{"type":"verse","number":14,"content":[{"noteId":204},"ಪ್ರೀತಿಯಿಂದ ಮುದ್ದಿಟ್ಟು ಒಬ್ಬರನೊಬ್ಬರು ವಂದಿಸಿರಿ. ಕ್ರಿಸ್ತನಲ್ಲಿರುವ ನಿಮ್ಮೆಲ್ಲರಿಗೂ",{"noteId":205},"ಸಮಾಧಾನವುಂಟಾಗಲಿ."]}],"footnotes":[{"noteId":177,"caller":"+","text":"2 ಯೋಹಾ 1. 3 ಯೋಹಾ 1.","reference":{"chapter":5,"verse":1}},{"noteId":178,"caller":"+","text":"ಲೂಕ 24:48; ಯೋಹಾ 15:27; ಅ. ಕೃ. 1:8, 22; 2:32; 3:15; 4:33; 5:32; 10:39, 41; 13:31; 1 ಕೊರಿ 15:15:","reference":{"chapter":5,"verse":1}},{"noteId":179,"caller":"+","text":"ಯೋಹಾ 21:16; ಅ. ಕೃ. 20:28; ಪ್ರಕ 7:17:","reference":{"chapter":5,"verse":2}},{"noteId":180,"caller":"+","text":"ಫಿಲೆ. 14:","reference":{"chapter":5,"verse":2}},{"noteId":181,"caller":"+","text":"1 ತಿಮೊ. 3:8; ತೀತ. 1:7:","reference":{"chapter":5,"verse":2}},{"noteId":182,"caller":"+","text":"ಯೆಹೆ. 34:4; ಮತ್ತಾ 20:25; ಮಾರ್ಕ 10:42; 2 ಕೊರಿ 1:24:","reference":{"chapter":5,"verse":3}},{"noteId":183,"caller":"+","text":"ಫಿಲಿ. 3:17; 2 ಥೆಸ. 3:9; 1 ತಿಮೊ. 4:12; ತೀತ. 2:7:","reference":{"chapter":5,"verse":3}},{"noteId":184,"caller":"+","text":"ಇಬ್ರಿ. 13:20:","reference":{"chapter":5,"verse":4}},{"noteId":185,"caller":"+","text":"1 ಪೇತ್ರ. 1:4, 7; 4:13; 5:1, 10:","reference":{"chapter":5,"verse":4}},{"noteId":186,"caller":"+","text":"1 ಕೊರಿ 9:25; ಯಾಕೋಬ 1:12:","reference":{"chapter":5,"verse":4}},{"noteId":187,"caller":"+","text":"ಮತ್ತಾ 20:26, 27; ಯೋಹಾ 13:4, 5, 14:","reference":{"chapter":5,"verse":5}},{"noteId":188,"caller":"+","text":"ಯಾಕೋಬ 4:6, 10:","reference":{"chapter":5,"verse":5}},{"noteId":189,"caller":"+","text":"ಕೀರ್ತ 37:5; 55:22; ಮತ್ತಾ 6:25:","reference":{"chapter":5,"verse":7}},{"noteId":190,"caller":"+","text":"1 ಪೇತ್ರ. 1:13:","reference":{"chapter":5,"verse":8}},{"noteId":191,"caller":"+","text":"ಮತ್ತಾ 24:42; 25:13; 26:41; ಮಾರ್ಕ 14:34-38; ಲೂಕ 12:37; 21:36; ಅ. ಕೃ. 20:31; 1 ಕೊರಿ 16:13; 1 ಥೆಸ. 5:6:","reference":{"chapter":5,"verse":8}},{"noteId":192,"caller":"+","text":"ಲೂಕ 22:31; ಎಫೆ 4:27; 6:11; 2 ಕೊರಿ 2:11; ಪ್ರಕ 12:9, 11. ಯೋಬ. 1:9-12:","reference":{"chapter":5,"verse":8}},{"noteId":193,"caller":"+","text":"ಕೀರ್ತ 22:20:","reference":{"chapter":5,"verse":8}},{"noteId":194,"caller":"+","text":"ಕೊಲೊ 2:5:","reference":{"chapter":5,"verse":9}},{"noteId":195,"caller":"+","text":"ಯಾಕೋಬ 4:7:","reference":{"chapter":5,"verse":9}},{"noteId":196,"caller":"+","text":"ಅ. ಕೃ. 14:22; 1 ಥೆಸ. 3:3; 2 ತಿಮೊ. 3:12:","reference":{"chapter":5,"verse":9}},{"noteId":197,"caller":"+","text":"1 ಕೊರಿ 1:9; 1 ಥೆಸ. 2:12; 1 ತಿಮೊ. 6:12:","reference":{"chapter":5,"verse":10}},{"noteId":198,"caller":"+","text":"1 ಪೇತ್ರ. 1:6:","reference":{"chapter":5,"verse":10}},{"noteId":199,"caller":"+","text":"ಲೂಕ 22:32; ರೋಮಾ. 16:25; 1 ಥೆಸ. 3:2:","reference":{"chapter":5,"verse":10}},{"noteId":200,"caller":"+","text":"1 ಪೇತ್ರ. 4:11:","reference":{"chapter":5,"verse":11}},{"noteId":201,"caller":"+","text":"ಇಬ್ರಿ. 13:22:","reference":{"chapter":5,"verse":12}},{"noteId":202,"caller":"+","text":"1 ಕೊರಿ 15:1:","reference":{"chapter":5,"verse":12}},{"noteId":203,"caller":"+","text":"ಅ. ಕೃ. 12:12:","reference":{"chapter":5,"verse":13}},{"noteId":204,"caller":"+","text":"ರೋಮಾ. 16:16:","reference":{"chapter":5,"verse":14}},{"noteId":205,"caller":"+","text":"ಎಫೆ 6:23:","reference":{"chapter":5,"verse":14}}]},"thisChapterLink":"/api/kan_irv/1PE/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_irv/2PE/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_irv/1PE/4.json","previousChapterAudioLinks":{},"numberOfVerses":14}