{"translation":{"id":"kan_irv","name":"ಇಂಡಿಯನ್ ರಿವೈಜ್ಡ್ ವರ್ಸನ್ (IRV) - ಕನ್ನಡ - 2019","website":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseNotes":null,"shortName":"IRV","englishName":"Kannada Indian Revised Version Bible","language":"kan","textDirection":"ltr","sha256":"82cc741009376c81c4416c230a757b2e30ef49b2e4672f9831adcedfc26b865f","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31031,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"1TH","translationId":"kan_irv","name":"1 ಥೆಸಲೋನಿಕದವರಿಗೆ","commonName":"1 ಥೆಸಲೋನಿಕದವರಿಗೆ","title":"1 ಥೆಸಲೋನಿಕದವರಿಗೆ","order":52,"numberOfChapters":5,"sha256":"2a2b2681d66e88b2615c32012c863d8a9e3ca4c617badcb7784a24c1527b2211","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_irv/1TH/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/kan_irv/1TH/5.json","totalNumberOfVerses":87},"chapter":{"number":4,"content":[{"type":"heading","content":["ದೇವರಿಗೆ ಮೆಚ್ಚಿಕೆಯಾದ ಜೀವನ"]},{"type":"verse","number":1,"content":["ಕಡೆಯದಾಗಿ, ಸಹೋದರರೇ, ನಾವು ಕರ್ತನಾದ ಯೇಸುವಿನ ಮುಖಾಂತರ",{"noteId":77},"ನಿಮಗೆ ಕೊಟ್ಟಿರುವ ಆಜ್ಞೆಗಳನ್ನು ತಿಳಿದಿದ್ದೀರಷ್ಟೆ."]},{"type":"verse","number":2,"content":["ಅದುದರಿಂದ",{"noteId":78},"ನೀವು ಹೇಗೆ ನಡೆದು",{"noteId":79},"ದೇವರನ್ನು ಮೆಚ್ಚಿಸಬೇಕಾಗಿದೆಯೋ ಆ ಆಜ್ಞೆಗಳನ್ನು",{"noteId":80},"ನಮ್ಮಿಂದ ಕಲಿತುಕೊಂಡು ಅದರಂತೆ ನಡೆಯುತ್ತಲೇ ಇದ್ದಿರಿ. ನೀವು ಹಾಗೆಯೇ ಇನ್ನೂ ಹೆಚ್ಚಾಗಿ ನಡೆಯಬೇಕೆಂದು ನಿಮ್ಮನ್ನು ಯೇಸು ಕರ್ತನಲ್ಲಿ ಬೇಡಿಕೊಳ್ಳುತ್ತೇವೆ ಹಾಗೂ ಪ್ರಬೋಧಿಸುತ್ತೇವೆ."]},{"type":"verse","number":3,"content":[{"noteId":81},"ದೇವರ ಚಿತ್ತವೇನಂದರೆ ನೀವು ಶುದ್ಧರಾಗಬೇಕೆಂಬುದೇ.",{"noteId":82},"ಆದ್ದರಿಂದ ಹಾದರಕ್ಕೆ ದೂರವಾಗಿರಬೇಕು."]},{"type":"verse","number":4,"content":[{"noteId":83},"ದೇವರನ್ನರಿಯದ",{"noteId":84},"ಅನ್ಯಜನರಂತೆ",{"noteId":85},"ಕಾಮಾಭಿಲಾಷೆಗಳಿಗೆ ಒಳಗಾಗದೆ, ನಿಮ್ಮಲ್ಲಿ ಪ್ರತಿಯೊಬ್ಬನು ಪವಿತ್ರವಾದ ಮನಸ್ಸಿನಿಂದಲೂ ಘನತೆಯಿಂದಲೂ",{"noteId":86},"ಪತ್ನಿಯನ್ನು ಸಂಪಾದಿಸಿಕೊಳ್ಳಲು ತಿಳಿಯಬೇಕು."]},{"type":"verse","number":6,"content":["ಈ ವಿಷಯದಲ್ಲಿ",{"noteId":87},"ಯಾರೂ ತನ್ನ ಸಹೋದರನನ್ನು ವಂಚಿಸಿ ಕೇಡು ಮಾಡಬಾರದು. ನಾವು ಮೊದಲೇ ತಿಳಿಸಿ, ನಿಮಗೆ ಖಂಡಿತವಾಗಿ ಹೇಳಿದ ಪ್ರಕಾರ ಇವೆಲ್ಲವುಗಳ ವಿಷಯದಲ್ಲಿ",{"noteId":88},"ಕರ್ತನು ಪ್ರತಿಕಾರ ಮಾಡುವವನಾಗಿದ್ದಾನೆ."]},{"type":"verse","number":7,"content":["ದೇವರು ನಮ್ಮನ್ನು ಅಶುದ್ಧತೆಗೆ ಕರೆಯದೆ",{"noteId":89},"ಶುದ್ಧರಾಗಿರುವುದಕ್ಕೆ ಕರೆದನು."]},{"type":"verse","number":8,"content":["ಹೀಗಿರಲು",{"noteId":90},"ಈ ಮಾತನ್ನು ತಿರಸ್ಕರಿಸುವವನು ಮನುಷ್ಯರನ್ನು ಮಾತ್ರವಲ್ಲದೆ, ನಿಮಗೆ",{"noteId":91},"ಪವಿತ್ರಾತ್ಮವರವನ್ನು ದಯಪಾಲಿಸುವ ದೇವರನ್ನೂ ತಿರಸ್ಕರಿಸುವವನಾಗಿದ್ದಾನೆ."]},{"type":"verse","number":9,"content":[{"noteId":92},"ಸಹೋದರ ಸ್ನೇಹದ ವಿಷಯದಲ್ಲಿ",{"noteId":93},"ನಿಮಗೆ ಬರೆಯುವ ಅವಶ್ಯಕತೆಯಿಲ್ಲ,",{"noteId":94},"ಒಬ್ಬರನ್ನೊಬ್ಬರು ಪ್ರೀತಿಸಬೇಕೆಂಬ ಉಪದೇಶವನ್ನು ನೀವೇ ದೇವರಿಂದ ಹೊಂದಿದವರಾಗಿದ್ದೀರಿ."]},{"type":"verse","number":10,"content":[{"noteId":95},"ಮಕೆದೋನ್ಯದಲ್ಲಿ ವಾಸಿಸುವ ಎಲ್ಲ ಸಹೋದರರನ್ನೂ ಪ್ರೀತಿಸುತ್ತಿರುವುದೇನೋ ನಿಜವೇ. ಆದರೂ ಸಹೋದರರೇ,",{"noteId":96},"ನೀವು ಪ್ರೀತಿಯಲ್ಲಿ ಇನ್ನೂ ಹೆಚ್ಚುತ್ತಾ ಬರಬೇಕೆಂದು ನಿಮ್ಮನ್ನು ಉತ್ತೇಜಿಸುತ್ತೇವೆ."]},{"type":"verse","number":11,"content":["ಇದಲ್ಲದೆ ನಾವು ನಿಮಗೆ ಆಜ್ಞೆ ಕೊಟ್ಟಿರುವ ಪ್ರಕಾರ ನೀವು",{"noteId":97},"ಮತ್ತೊಬ್ಬರ ವಿಷಯದಲ್ಲಿ ತಲೆಹಾಕದೆ",{"noteId":98},"ಸುಮ್ಮಗಿದ್ದು,",{"noteId":99},"ಸ್ವಂತ ಕಾರ್ಯಗಳನ್ನೇ ನೋಡಿಕೊಳ್ಳುತ್ತಾ,",{"noteId":100},"ಕೈಯಾರೆ ಕೆಲಸಮಾಡಿ ದುಡಿಯಿರಿ."]},{"type":"verse","number":12,"content":["ಹೀಗಿದ್ದರೆ ನೀವು",{"noteId":101},"ಹೊರಗಿನವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಸಜ್ಜನರಾಗಿರುವುದೇ ಅಲ್ಲದೆ ನಿಮಗೆ ಯಾವುದಕ್ಕೂ ಕೊರತೆಯಿರುವುದಿಲ್ಲ."]},{"type":"heading","content":["ಯೇಸು ಕರ್ತನು ಪುನರಾಗಮನ"]},{"type":"verse","number":13,"content":["ಸಹೋದರರೇ, ನಿದ್ರೆಹೋಗುವವರ ಗತಿ ಏನೆಂದು ನೀವು ತಿಳಿಯದೆ ಇದ್ದು,",{"noteId":102},"ನಿರೀಕ್ಷೆಯಿಲ್ಲದವರಾಗಿರುವ ಇತರರಂತೆ",{"noteId":103},"ದುಃಖಿಸಬಾರದು ಎಂಬುದೇ ನಮ್ಮ ಬಯಕೆ."]},{"type":"verse","number":14,"content":[{"noteId":104},"ಯೇಸು ಸತ್ತು ಜೀವಿತನಾಗಿ ಎದ್ದನೆಂದು ನಾವು ನಂಬುತ್ತೇವೆ ಹಾಗೆಯೇ",{"noteId":105},"ಯೇಸುವಿನಲ್ಲಿದ್ದು ನಿದ್ರೆಹೋದವರನ್ನು ಸಹ ದೇವರು ಆತನೊಡನೆ ಎಬ್ಬಿಸಿ",{"noteId":106},"ಕರೆದುಕೊಂಡು ಬರುವನೆಂದು ನಂಬಬೇಕಲ್ಲವೇ."]},{"type":"verse","number":15,"content":["ನಾವು ಕರ್ತನ ಮಾತಿನ ಆಧಾರದ ಮೇಲೆ ನಿಮಗೆ ಹೇಳುವುದೇನಂದರೆ,",{"noteId":107},"ಕರ್ತನು ಪುನರಾಗಮಿಸುವವರೆಗೆ",{"noteId":108},"ಜೀವದಿಂದುಳಿದಿರುವ ನಾವು ಮರಣ ಹೊಂದಿದವರಿಗಿಂತ ಮುಂದಾಗುವುದಿಲ್ಲ."]},{"type":"verse","number":16,"content":["ಯಾಕೆಂದರೆ ಕರ್ತನು ತಾನೇ ಆಜ್ಞಾಘೋಷದೊಡನೆಯೂ,",{"noteId":109},"ಪ್ರಧಾನದೂತನ ಶಬ್ದದೊಡನೆಯೂ,",{"noteId":110},"ದೇವರ ತುತ್ತೂರಿ ಧ್ವನಿಯೊಡನೆಯೂ",{"noteId":111},"ಆಕಾಶದಿಂದ ಇಳಿದುಬರುವನು.",{"noteId":112},"ಆಗ ಕ್ರಿಸ್ತನಲ್ಲಿ ಸತ್ತವರು ಮೊದಲು ಎದ್ದು ಬರುವರು."]},{"type":"verse","number":17,"content":["ಆ ಮೇಲೆ ಜೀವದಿಂದುಳಿದಿರುವ ನಾವು ಅಂತರಿಕ್ಷದಲ್ಲಿ ಕರ್ತನನ್ನು ಎದುರುಗೊಳ್ಳುವುದಕ್ಕಾಗಿ ಅವರೊಂದಿಗೆ",{"noteId":113},"ಮೇಘಗಳಲ್ಲಿ ಫಕ್ಕನೆ ಒಯ್ಯಲ್ಪಡುವೆವು. ಹೀಗಾಗಿ ನಾವು ಸದಾಕಾಲವೂ",{"noteId":114},"ಕರ್ತನ ಜೊತೆಯಲ್ಲಿರುವೆವು."]},{"type":"verse","number":18,"content":["ಆದಕಾರಣ ಈ ಮಾತುಗಳಿಂದ",{"noteId":115},"ಒಬ್ಬರನ್ನೊಬ್ಬರು ಸಂತೈಸಿಕೊಳ್ಳಿರಿ."]}],"footnotes":[{"noteId":77,"caller":"+","text":"1 ಕೊರಿ 11:2:","reference":{"chapter":4,"verse":1}},{"noteId":78,"caller":"+","text":"ಎಫೆ 4:1:","reference":{"chapter":4,"verse":2}},{"noteId":79,"caller":"+","text":"ಕೊಲೊ 1:10:","reference":{"chapter":4,"verse":2}},{"noteId":80,"caller":"+","text":"ಫಿಲಿ. 4:9:","reference":{"chapter":4,"verse":2}},{"noteId":81,"caller":"+","text":"ರೋಮಾ. 6:19, 22; 1 ಕೊರಿ 1:30; 2 ಥೆಸ. 2:13; 1 ತಿಮೊ. 2:15; ಇಬ್ರಿ. 12:14:","reference":{"chapter":4,"verse":3}},{"noteId":82,"caller":"+","text":"1 ಕೊರಿ 6:18:","reference":{"chapter":4,"verse":3}},{"noteId":83,"caller":"+","text":"-5 ಕೀರ್ತ 79:6; ಗಲಾ. 4:8:","reference":{"chapter":4,"verse":4}},{"noteId":84,"caller":"+","text":"-5 ಎಫೆ 4:17:","reference":{"chapter":4,"verse":4}},{"noteId":85,"caller":"+","text":"-5 ರೋಮಾ. 1:26:","reference":{"chapter":4,"verse":4}},{"noteId":86,"caller":"+","text":"-5 ಅಥವಾ, ಸ್ವಂತ ಘಟವನ್ನು ಸ್ವಾಧೀನದಲ್ಲಿ ಇಟ್ಟುಕೊಂಡಿರಲು.","reference":{"chapter":4,"verse":4}},{"noteId":87,"caller":"+","text":"1 ಕೊರಿ 6:8:","reference":{"chapter":4,"verse":6}},{"noteId":88,"caller":"+","text":"ರೋಮಾ. 13:4; 12:19:","reference":{"chapter":4,"verse":6}},{"noteId":89,"caller":"+","text":"1 ಥೆಸ. 4:3; 1 ಪೇತ್ರ. 1:15:","reference":{"chapter":4,"verse":7}},{"noteId":90,"caller":"+","text":"ಲೂಕ 10:16:","reference":{"chapter":4,"verse":8}},{"noteId":91,"caller":"+","text":"1 ಯೋಹಾ 3:24; 4:13:","reference":{"chapter":4,"verse":8}},{"noteId":92,"caller":"+","text":"ಇಬ್ರಿ. 13:1","reference":{"chapter":4,"verse":9}},{"noteId":93,"caller":"+","text":"1 ಥೆಸ. 5:1:","reference":{"chapter":4,"verse":9}},{"noteId":94,"caller":"+","text":"ಯೋಹಾ 13:34:","reference":{"chapter":4,"verse":9}},{"noteId":95,"caller":"+","text":"1 ಥೆಸ. 1:7:","reference":{"chapter":4,"verse":10}},{"noteId":96,"caller":"+","text":"1 ಥೆಸ. 3:12:","reference":{"chapter":4,"verse":10}},{"noteId":97,"caller":"+","text":"2 ಥೆಸ. 3:11; 1 ಪೇತ್ರ. 4:15:","reference":{"chapter":4,"verse":11}},{"noteId":98,"caller":"+","text":"ಜ್ಞಾ. 17:14:","reference":{"chapter":4,"verse":11}},{"noteId":99,"caller":"+","text":"2 ಥೆಸ. 3:12:","reference":{"chapter":4,"verse":11}},{"noteId":100,"caller":"+","text":"ಅ. ಕೃ. 18:3; ಎಫೆ 4:28:","reference":{"chapter":4,"verse":11}},{"noteId":101,"caller":"+","text":"ಮಾರ್ಕ 4:11; 1 ಕೊರಿ 5:12, 13; ಕೊಲೊ 4:5; 1 ತಿಮೊ. 3:7:","reference":{"chapter":4,"verse":12}},{"noteId":102,"caller":"+","text":"ಎಫೆ 2:12:","reference":{"chapter":4,"verse":13}},{"noteId":103,"caller":"+","text":"ಯಾಜ 19:28; ಧರ್ಮೋ 14:1; 2 ಸಮು 12:20-23; ಮಾರ್ಕ 5:39:","reference":{"chapter":4,"verse":13}},{"noteId":104,"caller":"+","text":"1 ಕೊರಿ 15:13; 2 ಕೊರಿ 4:14; ಪ್ರಕ 1:18:","reference":{"chapter":4,"verse":14}},{"noteId":105,"caller":"+","text":"ಅಥವಾ, ದೇವರು ನಿದ್ರೆ ಹೋದವರನ್ನು ಸಹ ಯೇಸುವಿನ ಮೂಲಕವಾಗಿ ಆತನೊಡನೆ.","reference":{"chapter":4,"verse":14}},{"noteId":106,"caller":"+","text":"1 ಕೊರಿ 15:18:","reference":{"chapter":4,"verse":14}},{"noteId":107,"caller":"+","text":"1 ಥೆಸ. 2:19:","reference":{"chapter":4,"verse":15}},{"noteId":108,"caller":"+","text":"1 ಕೊರಿ 15:51:","reference":{"chapter":4,"verse":15}},{"noteId":109,"caller":"+","text":"ಯೂದ. 9:","reference":{"chapter":4,"verse":16}},{"noteId":110,"caller":"+","text":"ಮತ್ತಾ 24:31; 1 ಕೊರಿ 15:52:","reference":{"chapter":4,"verse":16}},{"noteId":111,"caller":"+","text":"ಮತ್ತಾ 16:27; 2 ಥೆಸ. 1:7:","reference":{"chapter":4,"verse":16}},{"noteId":112,"caller":"+","text":"1 ಕೊರಿ 15:23; 2 ಥೆಸ. 2:1; ಪ್ರಕ 14:13:","reference":{"chapter":4,"verse":16}},{"noteId":113,"caller":"+","text":"ದಾನಿ. 7:13; ಅ. ಕೃ. 1:9:","reference":{"chapter":4,"verse":17}},{"noteId":114,"caller":"+","text":"ಯೋಹಾ 12:26:","reference":{"chapter":4,"verse":17}},{"noteId":115,"caller":"+","text":"1 ಥೆಸ. 5:11:","reference":{"chapter":4,"verse":18}}]},"thisChapterLink":"/api/kan_irv/1TH/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_irv/1TH/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_irv/1TH/3.json","previousChapterAudioLinks":{},"numberOfVerses":17}