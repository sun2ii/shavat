{"translation":{"id":"kan_irv","name":"ಇಂಡಿಯನ್ ರಿವೈಜ್ಡ್ ವರ್ಸನ್ (IRV) - ಕನ್ನಡ - 2019","website":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseNotes":null,"shortName":"IRV","englishName":"Kannada Indian Revised Version Bible","language":"kan","textDirection":"ltr","sha256":"82cc741009376c81c4416c230a757b2e30ef49b2e4672f9831adcedfc26b865f","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31031,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"1TI","translationId":"kan_irv","name":"1 ತಿಮೊಥೆಯನಿಗೆ","commonName":"1 ತಿಮೊಥೆಯನಿಗೆ","title":"1 ತಿಮೊಥೆಯನಿಗೆ","order":54,"numberOfChapters":6,"sha256":"2eabac339216e7540b91b77b45a4c2c9c747364246b40ce47bdf814eabbaf422","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_irv/1TI/1.json","lastChapterNumber":6,"lastChapterApiLink":"/api/kan_irv/1TI/6.json","totalNumberOfVerses":110},"chapter":{"number":3,"content":[{"type":"heading","content":["ಸಭಾಧ್ಯಕ್ಷರೂ ಸಭಾಸೇವಕರೂ ಯೋಗ್ಯರಾಗಿರಬೇಕು"]},{"type":"verse","number":1,"content":[{"noteId":54},"ಸಭಾಧ್ಯಕ್ಷನ ಉದ್ಯೋಗವನ್ನು ಪಡೆದುಕೊಳ್ಳಬೇಕೆಂದಿರುವವನು ಒಳ್ಳೆಯ ಕೆಲಸವನ್ನು ಅಪೇಕ್ಷಿಸುವವನಾಗಿದ್ದಾನೆಂಬ ಮಾತು ನಂಬತಕ್ಕದ್ದಾಗಿದೆ."]},{"type":"verse","number":2,"content":[{"noteId":55},"ಸಭಾಧ್ಯಕ್ಷನು ದೋಷಾರೋಪಣೆಯಿಲ್ಲದವನೂ, ಏಕಪತ್ನಿಯುಳ್ಳವನೂ,",{"noteId":56},"ಶಾಂತನೂ, ಜಿತೇಂದ್ರಿಯನೂ, ಮಾನಸ್ಥನೂ,",{"noteId":57},"ಅತಿಥಿಸತ್ಕಾರಮಾಡುವವನೂ,",{"noteId":58},"ಬೋಧಿಸಲು ಶಕ್ತನಾಗಿರಬೇಕು."]},{"type":"verse","number":3,"content":["ಅವನು ಕುಡಕನು, ಜಗಳವಾಡುವವನೂ ಆಗಿರದೆ,",{"noteId":59},"ಸಾತ್ವಿಕನೂ, ಹೊಡೆದಾಡದವನೂ",{"noteId":60},"ದ್ರವ್ಯಾಶೆಯಿಲ್ಲದವನೂ ಆಗಿರಬೇಕು."]},{"type":"verse","number":4,"content":["ಪೂರ್ಣಗೌರವದಿಂದ ತನ್ನ ಮಕ್ಕಳನ್ನು ಅಧೀನದಲ್ಲಿಟ್ಟುಕೊಂಡು, ಸ್ವಂತ ಮನೆಯವರನ್ನು ಚೆನ್ನಾಗಿ ನಡೆಸುವವನಾಗಿರಬೇಕು."]},{"type":"verse","number":5,"content":[{"noteId":61},"ಸ್ವಂತ ಮನೆಯವರನ್ನು ನಡೆಸುವುದಕ್ಕೆ ತಿಳಿಯದವನು ದೇವರ ಸಭೆಯನ್ನು ಹೇಗೆ ಪರಾಂಬರಿಸುವನು?"]},{"type":"verse","number":6,"content":["ಅವನು ಹೊಸದಾಗಿ ಸಭೆಯಲ್ಲಿ ಸೇರಿದವನಾಗಿರಬಾರದು, ಅಂಥವನಾದರೆ ಉಬ್ಬಿಕೊಂಡು ಸೈತಾನನಿಗೆ ಪ್ರಾಪ್ತವಾದ ಶಿಕ್ಷಾವಿಧಿಗೆ ಒಳಗಾದಾನು."]},{"type":"verse","number":7,"content":["ಇದಲ್ಲದೆ ಅವನು",{"noteId":62},"ಹೊರಗಣವರಿಂದ ಒಳ್ಳೆಯವನೆನ್ನಿಸಿಕೊಂಡಿರಬೇಕು, ಇಲ್ಲದಿದ್ದರೆ ನಿಂದೆಗೆ ಗುರಿಯಾಗುವನು ಮತ್ತು",{"noteId":63},"ಸೈತಾನನ ತಂತ್ರಗಳೊಳಗೆ ಸಿಕ್ಕಿಬಿದ್ದಾನು."]},{"type":"verse","number":8,"content":["ಅದೇ ರೀತಿಯಾಗಿ",{"noteId":64},"ಸಭಾಸೇವಕರು ಗೌರವವುಳ್ಳವರಾಗಿರಬೇಕು. ಅವರು ಎರಡು ಮಾತಿನವರೂ,",{"noteId":65},"ಮದ್ಯಾಸಕ್ತರೂ,",{"noteId":66},"ನೀಚಲಾಭವನ್ನು ಅಪೇಕ್ಷಿಸುವವರೂ ಆಗಿರದೆ,"]},{"type":"verse","number":9,"content":["ನಂಬಿಕೆಯಿಂದ ಪ್ರಕಟವಾಗಿರುವ",{"noteId":67},"ಸತ್ಯಾರ್ಥವನ್ನು ಶುದ್ಧ ಮನಸ್ಸಾಕ್ಷಿಯಿಂದ ಕೈಕೊಳ್ಳುವವರಾಗಿರಬೇಕು."]},{"type":"verse","number":10,"content":["ಇದಲ್ಲದೆ",{"noteId":68},"ಅವರು ಮೊದಲು ಪರೀಕ್ಷಿಸಲ್ಪಡಬೇಕು, ತರುವಾಯ ಅವರ ಮೇಲೆ ಯಾರೂ ತಪ್ಪುಹೊರಿಸದಿದ್ದರೆ ಸಭಾಸೇವಕರ ಉದ್ಯೋಗವನ್ನು ನೆರವೇರಿಸಲಿ."]},{"type":"verse","number":11,"content":["ಹಾಗೆಯೇ",{"noteId":69},"ಸಭಾಸೇವಕಿಯರಾದ ಸ್ತ್ರೀಯರೂ",{"noteId":70},"ಗೌರವವುಳ್ಳವರಾಗಿರಬೇಕು, ಚಾಡಿಹೇಳುವವರಾಗಿರದೆ, ಸ್ವಸ್ಥಬುದ್ಧಿಯುಳ್ಳವರೂ, ಎಲ್ಲಾ ವಿಷಯಗಳಲ್ಲಿ ನಂಬಿಗಸ್ತರಾಗಿಯೂ ಇರಬೇಕು."]},{"type":"verse","number":12,"content":["ಸಭಾಸೇವಕರು ಏಕಪತ್ನಿಯುಳ್ಳವರೂ,",{"noteId":71},"ತಮ್ಮ ಮಕ್ಕಳನ್ನೂ ಮನೆಯವರನ್ನೂ ಚೆನ್ನಾಗಿ ನಡಿಸುವವರೂ ಆಗಿರಬೇಕು."]},{"type":"verse","number":13,"content":[{"noteId":72},"ಸಭಾಸೇವಕರಾಗಿ ಚೆನ್ನಾಗಿ ಕೆಲಸ ಮಾಡಿರುವವರು ತಮಗೆ ಒಳ್ಳೆಯ ಪದವಿಯನ್ನೂ, ಕ್ರಿಸ್ತಯೇಸುವಿನಲ್ಲಿರುವ ನಂಬಿಕೆಯ ಸಂಬಂಧವಾಗಿ ಬಹುಧೈರ್ಯವನ್ನೂ ಸಂಪಾದಿಸಿಕೊಳ್ಳುತ್ತಾರೆ."]},{"type":"heading","content":["ಮಹಾ ರಹಸ್ಯ"]},{"type":"verse","number":14,"content":["ಬೇಗನೆ ನಿನ್ನ ಬಳಿಗೆ ಬರುವೆನೆಂಬ ನಿರೀಕ್ಷೆಯಿಂದಲೇ ನಿನಗೆ ಈ ವಿಷಯಗಳನ್ನು ಬರೆದಿದ್ದೇನೆ."]},{"type":"verse","number":15,"content":["ಆದರೆ ಒಂದು ವೇಳೆ ನಾನು ತಡಮಾಡಿದರೂ,",{"noteId":73},"ದೇವರ ಮನೆಯಲ್ಲಿ ಅಂದರೆ ಜೀವಸ್ವರೂಪನಾದ ದೇವರ ಸಭೆಯಲ್ಲಿ ನಡೆದುಕೊಳ್ಳಬೇಕಾದ ರೀತಿಯು ನಿನಗೆ ತಿಳಿದಿರಬೇಕೆಂದು ಈ ಸಂಗತಿಗಳನ್ನು ಬರೆದಿದ್ದೇನೆ. ಯಾಕೆಂದರೆ ಸಭೆಯು ಸತ್ಯಕ್ಕೆ ಸ್ತಂಭವೂ ಆಧಾರವೂ ಆಗಿದೆ."]},{"type":"verse","number":16,"content":["ದೇವಭಕ್ತಿಗೆ ಆಧಾರವಾಗಿರುವ ಸತ್ಯಾರ್ಥದ ರಹಸ್ಯವು ಗಂಭೀರವಾದದ್ದೆಂಬುದನ್ನು ನಾವೆಲ್ಲರೂ ಒಪ್ಪಿಕೊಳ್ಳುತ್ತೇವೆ, ಅದೇನಂದರೆ,",{"noteId":74},{"text":"ಕ್ರಿಸ್ತನು ಶರೀರಧಾರಿಯಾಗಿ ಪ್ರತ್ಯಕ್ಷನಾದನು,","poem":1},{"text":"ಆತ್ಮಸಂಬಂಧವಾಗಿ ಕ್ರಿಸ್ತನೇ ನೀತಿವಂತನೆಂದು ಪರಿಗಣಿಸಲ್ಪಟ್ಟನು,","poem":2},{"lineBreak":true},{"text":"ದೇವದೂತರಿಗೆ ಕಾಣಿಸಿಕೊಂಡನು,","poem":2},{"noteId":75},{"text":"ಅನ್ಯಜನರ ಮಧ್ಯದಲ್ಲಿ ಸಾರಲ್ಪಟ್ಟನು,","poem":1},{"noteId":76},{"text":"ಲೋಕದಲ್ಲಿ ನಂಬಲ್ಪಟ್ಟನು,","poem":2},{"lineBreak":true},{"noteId":77},{"text":"ಮಹಿಮೆಯೊಂದಿಗೆ ಪರಲೋಕಕ್ಕೆ ಎತ್ತಲ್ಪಟ್ಟನು.","poem":2}]}],"footnotes":[{"noteId":54,"caller":"+","text":"ಅ. ಕೃ 20:28","reference":{"chapter":3,"verse":1}},{"noteId":55,"caller":"+","text":"ತೀತ 1:6-9","reference":{"chapter":3,"verse":2}},{"noteId":56,"caller":"+","text":"ವ. 11","reference":{"chapter":3,"verse":2}},{"noteId":57,"caller":"+","text":"1 ಪೇತ್ರ 4:9","reference":{"chapter":3,"verse":2}},{"noteId":58,"caller":"+","text":"2 ತಿಮೊ 2:24","reference":{"chapter":3,"verse":2}},{"noteId":59,"caller":"+","text":"ತೀತ 3:2","reference":{"chapter":3,"verse":3}},{"noteId":60,"caller":"+","text":"1 ತಿಮೊ 6:10; ಇಬ್ರಿ. 13:5","reference":{"chapter":3,"verse":3}},{"noteId":61,"caller":"+","text":"ವ 12","reference":{"chapter":3,"verse":5}},{"noteId":62,"caller":"+","text":"ಮಾರ್ಕ 4:11; ಕೊಲೊ 4:5","reference":{"chapter":3,"verse":7}},{"noteId":63,"caller":"+","text":"2 ತಿಮೊ 2:26; 1 ತಿಮೊ 6:9","reference":{"chapter":3,"verse":7}},{"noteId":64,"caller":"+","text":"1 ತಿಮೊ 6:9","reference":{"chapter":3,"verse":8}},{"noteId":65,"caller":"+","text":"ತೀತ 2:3; 1 ತಿಮೊ 5:23","reference":{"chapter":3,"verse":8}},{"noteId":66,"caller":"+","text":"ತೀತ 1:7; 1 ಪೇತ್ರ 5:2","reference":{"chapter":3,"verse":8}},{"noteId":67,"caller":"+","text":"1 ತಿಮೊ 1:19","reference":{"chapter":3,"verse":9}},{"noteId":68,"caller":"+","text":"1 ತಿಮೊ 5:22","reference":{"chapter":3,"verse":10}},{"noteId":69,"caller":"+","text":"ಅವರ ಹೆಂಡತಿಯರಾದ","reference":{"chapter":3,"verse":11}},{"noteId":70,"caller":"+","text":"ತೀತ 2:3","reference":{"chapter":3,"verse":11}},{"noteId":71,"caller":"+","text":"1 ತಿಮೊ 3:2,4","reference":{"chapter":3,"verse":12}},{"noteId":72,"caller":"+","text":"ಮತ್ತಾ 25:21","reference":{"chapter":3,"verse":13}},{"noteId":73,"caller":"+","text":"ಎಫೆ 2:21; 2 ತಿಮೊ 2:20; ಇಬ್ರಿ 3:6","reference":{"chapter":3,"verse":15}},{"noteId":74,"caller":"+","text":"ಯೋಹ 1:14; 1 ಪೇತ್ರ 1:20; 1 ಯೋಹಾ 1:2,3,4,5,8","reference":{"chapter":3,"verse":16}},{"noteId":75,"caller":"+","text":"ಗಲಾ 2:2","reference":{"chapter":3,"verse":16}},{"noteId":76,"caller":"+","text":"2 ಥೆಸ 1:10","reference":{"chapter":3,"verse":16}},{"noteId":77,"caller":"+","text":"ಅ. ಕೃ 1:2","reference":{"chapter":3,"verse":16}}]},"thisChapterLink":"/api/kan_irv/1TI/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_irv/1TI/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_irv/1TI/2.json","previousChapterAudioLinks":{},"numberOfVerses":16}