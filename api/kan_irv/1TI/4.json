{"translation":{"id":"kan_irv","name":"ಇಂಡಿಯನ್ ರಿವೈಜ್ಡ್ ವರ್ಸನ್ (IRV) - ಕನ್ನಡ - 2019","website":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseNotes":null,"shortName":"IRV","englishName":"Kannada Indian Revised Version Bible","language":"kan","textDirection":"ltr","sha256":"82cc741009376c81c4416c230a757b2e30ef49b2e4672f9831adcedfc26b865f","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31031,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"1TI","translationId":"kan_irv","name":"1 ತಿಮೊಥೆಯನಿಗೆ","commonName":"1 ತಿಮೊಥೆಯನಿಗೆ","title":"1 ತಿಮೊಥೆಯನಿಗೆ","order":54,"numberOfChapters":6,"sha256":"2eabac339216e7540b91b77b45a4c2c9c747364246b40ce47bdf814eabbaf422","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_irv/1TI/1.json","lastChapterNumber":6,"lastChapterApiLink":"/api/kan_irv/1TI/6.json","totalNumberOfVerses":110},"chapter":{"number":4,"content":[{"type":"heading","content":["ದುರ್ಬೋಧಕರು"]},{"type":"verse","number":1,"content":["ಆದರೂ",{"noteId":78},"ಮುಂಬರುವ ದಿನಗಳಲ್ಲಿ ಕೆಲವರು",{"noteId":79},"ವಂಚಿಸುವ ಆತ್ಮಗಳ ನುಡಿಗಳಿಗೂ, ದೆವ್ವಗಳ ಬೋಧನೆಗಳಿಗೂ ಲಕ್ಷ್ಯಕೊಟ್ಟು ಕ್ರಿಸ್ತ ನಂಬಿಕೆಯಿಂದ ಭ್ರಷ್ಟರಾಗುವರೆಂದು ದೇವರಾತ್ಮನು ಸ್ಪಷ್ಟವಾಗಿ ಹೇಳುತ್ತಿದ್ದಾನೆ."]},{"type":"verse","number":2,"content":[{"noteId":80},"ಕಪಟದಿಂದ ಸುಳ್ಳಾಡುವವರು, ಸ್ವಂತ ಮನಸ್ಸಾಕ್ಷಿಯ ಮೇಲೆ ಬರೆಹಾಕಲ್ಪಟ್ಟವರಾಗಿದ್ದು,"]},{"type":"verse","number":3,"content":["ಅವರು ವಿಶ್ವಾಸಿಗಳಿಗೆ",{"noteId":81},"ಮದುವೆಯಾಗಬಾರದೆಂತಲೂ, ಯಾರು ನಂಬುವವರಾಗಿದ್ದು ಸತ್ಯವನ್ನು ಗ್ರಹಿಸಿದ್ದಾರೋ,",{"noteId":82},"ಅವರು ಕೃತಜ್ಞತಾಸ್ತುತಿಮಾಡಿ, ತಿನ್ನುವುದಕ್ಕೋಸ್ಕರ",{"noteId":83},"ದೇವರು ಉಂಟುಮಾಡಿದ",{"noteId":84},"ಆಹಾರವನ್ನು ತಿನ್ನಬಾರದೆಂತಲೂ ಹೇಳುವರು."]},{"type":"verse","number":4,"content":[{"noteId":85},"ದೇವರು ಉಂಟುಮಾಡಿದ್ದೆಲ್ಲವೂ ಒಳ್ಳೆಯದೇ, ನಾವು ಕೃತಜ್ಞತಾಸ್ತುತಿಮಾಡಿ ತೆಗೆದುಕೊಳ್ಳುವ ಯಾವ ಆಹಾರವನ್ನು",{"noteId":86},"ತಿರಸ್ಕರಿಸಬೇಕಾಗಿಲ್ಲ."]},{"type":"verse","number":5,"content":["ದೇವರ ವಾಕ್ಯದಿಂದಲೂ ಪ್ರಾರ್ಥನೆಯಿಂದಲೂ ಆ ಆಹಾರವು ಪವಿತ್ರವಾಗುತ್ತದಲ್ಲಾ."]},{"type":"verse","number":6,"content":[{"noteId":87},"ಈ ಸಂಗತಿಗಳನ್ನು ಸಹೋದರರಿಗೆ ತಿಳಿಸಿದರೆ, ನೀನು ಅನುಸರಿಸುತ್ತಿರುವ ಕ್ರಿಸ್ತ ನಂಬಿಕೆಯ ಮತ್ತು ಸುಬೋಧನೆಯ ವಾಕ್ಯಗಳಲ್ಲಿ ಅಭ್ಯಾಸಹೊಂದಿದವನಾಗಿ, ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಒಳ್ಳೆಯ ಸೇವಕನಾಗಿರುವಿ."]},{"type":"verse","number":7,"content":["ಅಜ್ಜಿ ಕಥೆಗಳನ್ನೂ",{"noteId":88},"ಪ್ರಾಪಂಚಿಕವಾದ ಆ ಕಥೆಗಳನ್ನೂ ತಳ್ಳಿಬಿಟ್ಟು, ನೀನು ದೇವಭಕ್ತಿಯ ವಿಷಯದಲ್ಲಿ",{"noteId":89},"ಸಾಧನೆಮಾಡಿಕೋ."]},{"type":"verse","number":8,"content":[{"noteId":90},"ದೇಹಸಾಧನೆಯು ಸ್ವಲ್ಪಮಟ್ಟಿಗೆ ಪ್ರಯೋಜನವಾಗಿದೆ,",{"noteId":91},"ಭಕ್ತಿಯಾದರೋ ಎಲ್ಲಾ ವಿಧದಲ್ಲಿ ಪ್ರಯೋಜನವಾದದ್ದು.",{"noteId":92},"ಅದಕ್ಕೆ ಇಹಪರಗಳಲ್ಲಿನ ಜೀವನಕ್ಕೆ ವಾಗ್ದಾನ ಉಂಟು."]},{"type":"verse","number":9,"content":[{"noteId":93},"ಈ ವಾಕ್ಯವು ನಂಬತಕ್ಕದ್ದಾಗಿಯೂ ಸರ್ವಾಂಗೀಕಾರಕ್ಕೆ ಯೋಗ್ಯವಾದದ್ದಾಗಿಯೂ ಇದೆ."]},{"type":"verse","number":10,"content":["ಇದಕ್ಕಾಗಿ ನಾವು ಕಷ್ಟಪಡುತ್ತಿದ್ದೇವೆ, ಪ್ರಯಾಸಪಡುತ್ತಿದ್ದೇವೆ, ಯಾಕೆಂದರೆ",{"noteId":94},"ಎಲ್ಲಾ ಮನುಷ್ಯರಿಗೂ, ವಿಶೇಷವಾಗಿ ನಂಬುವವರಿಗೆ, ರಕ್ಷಕನಾಗಿರುವ ಜೀವವುಳ್ಳ ದೇವರ ಮೇಲೆ ನಾವು ನಿರೀಕ್ಷೆಯನ್ನಿಟ್ಟುಕೊಂಡವರಾಗಿದ್ದೇವೆ."]},{"type":"verse","number":11,"content":[{"noteId":95},"ಈ ಸಂಗತಿಗಳನ್ನು ನೀನು ಆಜ್ಞಾಪಿಸಬೇಕು ಮತ್ತು ಬೋಧಿಸಬೇಕು."]},{"type":"verse","number":12,"content":[{"noteId":96},"ನಿನ್ನ ಯೌವನವನ್ನು ಅಸಡ್ಡೆಮಾಡುವುದಕ್ಕೆ ಯಾರಿಗೂ ಆಸ್ಪದಮಾಡಿಕೊಡದೆ, ನಂಬುವವರಿಗೆ ನಡೆ, ನುಡಿ, ಪ್ರೀತಿ, ನಂಬಿಕೆ, ಶುದ್ಧತ್ವ ಇವುಗಳ ವಿಷಯದಲ್ಲಿ",{"noteId":97},"ನೀನೇ ಮಾದರಿಯಾಗಿರು."]},{"type":"verse","number":13,"content":["ನಾನು ಬರುವ ತನಕ ವೇದವಾಕ್ಯವನ್ನು ಓದಿ ಹೇಳುವುದರಲ್ಲಿಯೂ, ಪ್ರಬೋಧಿಸುವುದರಲ್ಲಿಯೂ, ಉಪದೇಶಿಸುವುದರಲ್ಲಿಯೂ ಆಸಕ್ತನಾಗಿರು."]},{"type":"verse","number":14,"content":[{"noteId":98},"ನಿನ್ನಲ್ಲಿರುವ ಕೃಪಾವರವನ್ನು ಅಲಕ್ಷ್ಯಮಾಡಬೇಡ, ಆ ವರವು",{"noteId":99},"ಸಭೆಯ ಹಿರಿಯರು",{"noteId":100},"ಪ್ರವಾದನೆಯ ಸಹಿತವಾಗಿ ನಿನ್ನ ಮೇಲೆ",{"noteId":101},"ಹಸ್ತಗಳನ್ನಿಟ್ಟಾಗ, ಅದು ನಿನಗೆ ಕೊಡಲ್ಪಟ್ಟಿತಲ್ಲಾ."]},{"type":"verse","number":15,"content":["ಈ ಕಾರ್ಯಗಳನ್ನು ಸಾಧಿಸುತ್ತಾ, ಅವುಗಳಲ್ಲಿ ಮಗ್ನನಾಗಿರು. ಇದರಿಂದ ನಿನ್ನ ಅಭಿವೃದ್ಧಿಯು ಎಲ್ಲರಿಗೂ ಪ್ರಸಿದ್ಧವಾಗುವುದು",{"noteId":102},"."]},{"type":"verse","number":16,"content":[{"noteId":103},"ನಿನ್ನ ವಿಷಯದಲ್ಲಿಯೂ ನಿನ್ನ ಉಪದೇಶದ ವಿಷಯದಲ್ಲಿಯೂ ಎಚ್ಚರಿಕೆಯಾಗಿರು. ನೀನು ಈ ಕಾರ್ಯಗಳಲ್ಲಿ ನಿರತನಾಗಿರು, ಆಗ ನೀನು",{"noteId":104},"ನಿನ್ನನ್ನೂ ಮತ್ತು ನಿನ್ನ ಉಪದೇಶ ಕೇಳುವವರನ್ನೂ ರಕ್ಷಿಸುವಿ."]}],"footnotes":[{"noteId":78,"caller":"+","text":"2 ಥೆಸ. 2:3-9; 2 ತಿಮೊ. 3:1; ಕೊರಿ 11:19","reference":{"chapter":4,"verse":1}},{"noteId":79,"caller":"+","text":"1 ಯೊಹಾ. 4:6","reference":{"chapter":4,"verse":1}},{"noteId":80,"caller":"+","text":"1 ಥೆಸ. 2:3; 2 ಥೆಸ. 2:11","reference":{"chapter":4,"verse":2}},{"noteId":81,"caller":"+","text":"ಇಬ್ರಿ. 13:4","reference":{"chapter":4,"verse":3}},{"noteId":82,"caller":"+","text":"ರೋಮಾ. 14:6 14, 20","reference":{"chapter":4,"verse":3}},{"noteId":83,"caller":"+","text":"ಆದಿ 1:29; 9:3","reference":{"chapter":4,"verse":3}},{"noteId":84,"caller":"+","text":"ಕೊಲೊ 2:16","reference":{"chapter":4,"verse":3}},{"noteId":85,"caller":"+","text":"ಆದಿ 1:31","reference":{"chapter":4,"verse":4}},{"noteId":86,"caller":"+","text":"ಅ. ಕೃ. 10:15","reference":{"chapter":4,"verse":4}},{"noteId":87,"caller":"+","text":"2 ತಿಮೊ. 3:14, 15","reference":{"chapter":4,"verse":6}},{"noteId":88,"caller":"+","text":"1 ತಿಮೊ. 1:4","reference":{"chapter":4,"verse":7}},{"noteId":89,"caller":"+","text":"ಇಬ್ರಿ. 5:14","reference":{"chapter":4,"verse":7}},{"noteId":90,"caller":"+","text":"ದೇಹದಂಡನೆ; ಕೊಲೊ 2:23","reference":{"chapter":4,"verse":8}},{"noteId":91,"caller":"+","text":"1 ತಿಮೊ. 6:6","reference":{"chapter":4,"verse":8}},{"noteId":92,"caller":"+","text":"ಕೀರ್ತ 37:4,9,11; 84:11; 145:19; ಜ್ಞಾ. 19:23; ಮತ್ತಾ 6:33; ಮಾರ್ಕ 10:30","reference":{"chapter":4,"verse":8}},{"noteId":93,"caller":"+","text":"1 ತಿಮೊ. 1:15","reference":{"chapter":4,"verse":9}},{"noteId":94,"caller":"+","text":"1 ತಿಮೊ. 2:4; ಯೋಹಾ 4:42","reference":{"chapter":4,"verse":10}},{"noteId":95,"caller":"+","text":"1 ತಿಮೊ. 5:7; 6:2","reference":{"chapter":4,"verse":11}},{"noteId":96,"caller":"+","text":"1 ಕೊರಿ 16:11; ತೀತ 2:15","reference":{"chapter":4,"verse":12}},{"noteId":97,"caller":"+","text":"ತೀತ 2:7; 1 ಪೇತ್ರ 5:3","reference":{"chapter":4,"verse":12}},{"noteId":98,"caller":"+","text":"2 ತಿಮೊ. 1:6; 1 ಥೆಸ. 5:19","reference":{"chapter":4,"verse":14}},{"noteId":99,"caller":"+","text":"ಅ. ಕೃ. 20:17","reference":{"chapter":4,"verse":14}},{"noteId":100,"caller":"+","text":"1 ತಿಮೊ. 1:18","reference":{"chapter":4,"verse":14}},{"noteId":101,"caller":"+","text":"ಅ. ಕೃ. 6:6","reference":{"chapter":4,"verse":14}},{"noteId":102,"caller":"+","text":"ಕಾಣಿಸುವುದು","reference":{"chapter":4,"verse":15}},{"noteId":103,"caller":"+","text":"ಅ. ಕೃ. 20:28","reference":{"chapter":4,"verse":16}},{"noteId":104,"caller":"+","text":"ಯೆಹೆ. 33:9","reference":{"chapter":4,"verse":16}}]},"thisChapterLink":"/api/kan_irv/1TI/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_irv/1TI/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_irv/1TI/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}