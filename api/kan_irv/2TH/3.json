{"translation":{"id":"kan_irv","name":"ಇಂಡಿಯನ್ ರಿವೈಜ್ಡ್ ವರ್ಸನ್ (IRV) - ಕನ್ನಡ - 2019","website":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseNotes":null,"shortName":"IRV","englishName":"Kannada Indian Revised Version Bible","language":"kan","textDirection":"ltr","sha256":"82cc741009376c81c4416c230a757b2e30ef49b2e4672f9831adcedfc26b865f","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31031,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"2TH","translationId":"kan_irv","name":"2 ಥೆಸಲೋನಿಕದವರಿಗೆ","commonName":"2 ಥೆಸಲೋನಿಕದವರಿಗೆ","title":"2 ಥೆಸಲೋನಿಕದವರಿಗೆ","order":53,"numberOfChapters":3,"sha256":"3c8afad55e5416820f708c27345f6ce102dcd64963d499c0618d049dd8add14e","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_irv/2TH/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/kan_irv/2TH/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"heading","content":["ಪ್ರಾರ್ಥನೆಗಾಗಿ ವಿನಂತಿ"]},{"type":"verse","number":1,"content":["ಕಡೆಯದಾಗಿ,",{"noteId":48},"ಸಹೋದರರೇ, ನಮಗೋಸ್ಕರ ಪ್ರಾರ್ಥನೆಮಾಡಿರಿ. ಕರ್ತನ ವಾಕ್ಯವು ನಿಮ್ಮಲ್ಲಿ ಹಬ್ಬಿಹರಡಿದ ಪ್ರಕಾರವೇ",{"noteId":49},"ಅದು ಬೇಗನೆ ಪಸರಿಸಿ ಮಹಿಮೆ ಹೊಂದಲಿ,"]},{"type":"verse","number":2,"content":[{"noteId":50},"ದೇವರು ನಮ್ಮನ್ನು ಮೂರ್ಖರಾದ ದುಷ್ಟಜನರ ಕೈಯಿಂದ ತಪ್ಪಿಸುವ ಹಾಗೆಯೂ ಪ್ರಾರ್ಥಿಸಿರಿ, ಕ್ರಿಸ್ತ ನಂಬಿಕೆಯು ಎಲ್ಲರಲ್ಲಿ ಇರುವುದಿಲ್ಲವಲ್ಲಾ."]},{"type":"verse","number":3,"content":["ಆದರೆ",{"noteId":51},"ಕರ್ತನು ನಂಬಿಗಸ್ತನು, ಆತನು ನಿಮ್ಮನ್ನು ದೃಢಪಡಿಸಿ ನೀವು",{"noteId":52},"ಕೆಡುಕನ ಕೈಗೆ",{"noteId":53},"ಸಿಕ್ಕದಂತೆ ಕಾಪಾಡುವನು."]},{"type":"verse","number":4,"content":["ನಾವು ಆಜ್ಞಾಪಿಸುವ ಪ್ರಕಾರ ನೀವು ಮಾಡುತ್ತೀರೆಂತಲೂ ಮುಂದೆಯೂ ಮಾಡುವಿರೆಂತಲೂ, ನಿಮ್ಮ ವಿಷಯದಲ್ಲಿ ಕರ್ತನ ಮೂಲಕವಾಗಿ ನಮಗೆ ಭರವಸವುಂಟು."]},{"type":"verse","number":5,"content":["ನೀವು ದೇವರ ಪ್ರೀತಿಯಲ್ಲಿಯೂ",{"noteId":54},"ಕ್ರಿಸ್ತನ ತಾಳ್ಮೆಯಲ್ಲಿಯೂ ಸೇರುವಂತೆ ಕರ್ತನೇ ನಿಮ್ಮನ್ನು ನಡೆಸಲಿ."]},{"type":"heading","content":["ಮೈಗಳ್ಳರಿಗೆ ಎಚ್ಚರಿಕೆ"]},{"type":"verse","number":6,"content":["ಸಹೋದರರೇ, ನಾವು ಬೋಧಿಸಿದ ಸಂಪ್ರದಾಯವನ್ನು ಅನುಸರಿಸದೆ",{"noteId":55},"ಸೋಮಾರಿಯಾಗಿ ಜೀವಿಸುವ ಪ್ರತಿಯೊಬ್ಬ",{"noteId":56},"ಸಹೋದರನಿಂದ ನೀವು",{"noteId":57},"ದೂರವಾಗಿರಬೇಕೆಂದು",{"noteId":58},"ನಮ್ಮ ಕರ್ತನಾದ ಯೇಸು ಕ್ರಿಸ್ತನ ಹೆಸರಿನಲ್ಲಿ ನಿಮಗೆ ಆಜ್ಞಾಪಿಸುತ್ತೇವೆ."]},{"type":"verse","number":7,"content":[{"noteId":59},"ನೀವು ನಮ್ಮನ್ನು ಅನುಸರಿಸಿ ಹೇಗೆ ನಡೆಯಬೇಕೆಂಬುದನ್ನು ನೀವೇ ಬಲ್ಲಿರಿ,",{"noteId":60},"ನಾವು ನಿಮ್ಮಲ್ಲಿ ಸೋಮಾರಿಯಾಗಿ ನಡೆಯಲಿಲ್ಲ."]},{"type":"verse","number":8,"content":["ನಾವು ಹಣಕೊಡದೆ ಯಾರ ಬಳಿಯಲ್ಲಿಯೂ ಊಟ ಮಾಡಲಿಲ್ಲ,",{"noteId":61},"ನಿಮ್ಮಲ್ಲಿ ಯಾರಿಗೂ ಭಾರವಾಗಬಾರದೆಂದು ಹಗಲಿರುಳು ಕಷ್ಟದಿಂದಲೂ ಪ್ರಯಾಸದಿಂದಲೂ ದುಡಿದು ಜೀವನ ಮಾಡಿದೆವು."]},{"type":"verse","number":9,"content":[{"noteId":62},"ನಿಮ್ಮಿಂದ ಪೋಷಣೆ ಹೊಂದುವುದಕ್ಕೆ ನಮಗೆ ಹಕ್ಕಿಲ್ಲವೆಂದು ಹಾಗೆ ಮಾಡಲಿಲ್ಲ,",{"noteId":63},"ನೀವು ನಮ್ಮನ್ನು ಅನುಸರಿಸುವುದಕ್ಕಾಗಿ ನಿಮಗೆ ಮಾದರಿಯಾಗಿರಬೇಕೆಂದೇ ಹಾಗೆ ಮಾಡಿದೆವು."]},{"type":"verse","number":10,"content":["ಇದಲ್ಲದೆ ನಾವು ನಿಮ್ಮ ಸಂಗಡ ಇದ್ದಾಗ,",{"noteId":64},"“ಕೆಲಸ ಮಾಡಲೊಲ್ಲದವನು ಊಟಮಾಡಬಾರದು” ಎಂದು ನಿಮಗೆ ಆಜ್ಞಾಪಿಸಿದೆವಷ್ಟೆ."]},{"type":"verse","number":11,"content":["ಆದರೆ ನಿಮ್ಮಲ್ಲಿ ಕೆಲವರು ಯಾವ ಕೆಲಸವನ್ನೂ ಮಾಡದೆ,",{"noteId":65},"ಇತರರ ವಿಷಯದಲ್ಲಿ ಮಾತ್ರ ತಲೆ ಹಾಕಿ ಸೋಮಾರಿಯಾಗಿ ನಡೆಯುತ್ತಾರೆಂಬ ಸುದ್ದಿಯನ್ನು ಕೇಳಿದ್ದೇವೆ."]},{"type":"verse","number":12,"content":["ಇಂಥವರು ತಮ್ಮ ಕೆಲಸಕಾರ್ಯಗಳನ್ನು ನೋಡುತ್ತಾ ತಾವೇ ಸಂಪಾದಿಸಿದ್ದನ್ನು ಊಟಮಾಡಬೇಕೆಂದು ಕರ್ತನಾದ ಯೇಸು ಕ್ರಿಸ್ತನಲ್ಲಿ ನಾವು ಆಜ್ಞಾಪಿಸಿ ಬುದ್ಧಿ ಹೇಳುತ್ತೇವೆ."]},{"type":"verse","number":13,"content":["ಸಹೋದರರೇ,",{"noteId":66},"ನೀವಾದರೋ ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವುದರಲ್ಲಿ ಬೇಸರಗೊಳ್ಳಬೇಡಿರಿ."]},{"type":"verse","number":14,"content":["ಈ ಪತ್ರಿಕೆಯ ಮೂಲಕವಾಗಿ ಹೇಳಿರುವ ನಮ್ಮ ಮಾತಿಗೆ ಯಾವನಾದರೂ ಒಳಗಾಗದಿದ್ದರೆ ಅವನನ್ನು ಗುರುತಿಸಿ ಅವನಿಗೆ ನಾಚಿಕೆಯಾಗುವಂತೆ",{"noteId":67},"ಅವನ ಸಹವಾಸದಲ್ಲಿ ಸೇರಬೇಡಿರಿ."]},{"type":"verse","number":15,"content":["ಆದರೂ",{"noteId":68},"ಅವನನ್ನು ವೈರಿಯೆಂದು ಭಾವಿಸದೆ ಸಹೋದರನೆಂದು ಎಣಿಸಿಕೊಂಡು ಬುದ್ಧಿಹೇಳಿರಿ."]},{"type":"heading","content":["ಸಮಾಪ್ತಿ ವಾಕ್ಯಗಳು"]},{"type":"verse","number":16,"content":[{"noteId":69},"ಶಾಂತಿದಾಯಕನಾದ ಕರ್ತನು ತಾನೇ ಸದಾಕಾಲದಲ್ಲಿಯೂ ಸಕಲವಿಧದಲ್ಲಿಯೂ",{"noteId":70},"ನಿಮಗೆ ಶಾಂತಿಯನ್ನು ದಯಪಾಲಿಸಲಿ. ಕರ್ತನು ನಿಮ್ಮೆಲ್ಲರೊಂದಿಗಿರಲಿ."]},{"type":"verse","number":17,"content":[{"noteId":71},"ಪೌಲನೆಂಬ ನಾನು ಸ್ವಂತ ಕೈಯಿಂದ ವಂದನೆಯನ್ನು ಬರೆದಿದ್ದೇನೆ. ಎಲ್ಲಾ ಪತ್ರಿಕೆಗಳಲ್ಲಿಯೂ ಇದೇ ನನ್ನ ಗುರುತು, ಹೀಗೆಯೇ ನನ್ನ ಕೈ ಬರಹ."]},{"type":"verse","number":18,"content":[{"noteId":72},"ನಮ್ಮ ಕರ್ತನಾದ ಯೇಸು ಕ್ರಿಸ್ತನ ಕೃಪೆಯು ನಿಮ್ಮೆಲ್ಲರ ಸಂಗಡವಿರಲಿ."]}],"footnotes":[{"noteId":48,"caller":"+","text":"1 ಥೆಸ. 5:25:","reference":{"chapter":3,"verse":1}},{"noteId":49,"caller":"+","text":"ಕೀರ್ತ 147:15; 1 ಥೆಸ. 1:8:","reference":{"chapter":3,"verse":1}},{"noteId":50,"caller":"+","text":"ರೋಮಾ. 15:31:","reference":{"chapter":3,"verse":2}},{"noteId":51,"caller":"+","text":"1 ಕೊರಿ 1:9:","reference":{"chapter":3,"verse":3}},{"noteId":52,"caller":"+","text":"1 ಯೋಹಾ 2:14:","reference":{"chapter":3,"verse":3}},{"noteId":53,"caller":"+","text":"ಮತ್ತಾ 6:13; ಯೋಹಾ 17:15:","reference":{"chapter":3,"verse":3}},{"noteId":54,"caller":"+","text":"ಅಥವಾ, ಕ್ರಿಸ್ತನನ್ನು ಎದುರುನೋಡುವ.","reference":{"chapter":3,"verse":5}},{"noteId":55,"caller":"+","text":"ವ. 11; 1 ಥೆಸ. 5:14:","reference":{"chapter":3,"verse":6}},{"noteId":56,"caller":"+","text":"1 ಕೊರಿ 5:11:","reference":{"chapter":3,"verse":6}},{"noteId":57,"caller":"+","text":"ವ. 14; ಮತ್ತಾ 18:17; 2 ತಿಮೊ. 3:5; 1 ಕೊರಿ 5:9; 2 ಯೋಹಾ 10:","reference":{"chapter":3,"verse":6}},{"noteId":58,"caller":"+","text":"1 ಕೊರಿ 5:4:","reference":{"chapter":3,"verse":6}},{"noteId":59,"caller":"+","text":"ಅ. ಕೃ. 20:35; 1 ಥೆಸ. 1:6:","reference":{"chapter":3,"verse":7}},{"noteId":60,"caller":"+","text":"1 ಥೆಸ. 1:5","reference":{"chapter":3,"verse":7}},{"noteId":61,"caller":"+","text":"1 ಥೆಸ. 2:9:","reference":{"chapter":3,"verse":8}},{"noteId":62,"caller":"+","text":"1 ಕೊರಿ 9:4; 1 ಥೆಸ. 2:6:","reference":{"chapter":3,"verse":9}},{"noteId":63,"caller":"+","text":"ವ. 7; 1 ಪೇತ್ರ. 5:3:","reference":{"chapter":3,"verse":9}},{"noteId":64,"caller":"+","text":"ಆದಿ 3:19; 1 ಥೆಸ. 4:11:","reference":{"chapter":3,"verse":10}},{"noteId":65,"caller":"+","text":"1 ತಿಮೊ. 5:13; 1 ಪೇತ್ರ. 4:15:","reference":{"chapter":3,"verse":11}},{"noteId":66,"caller":"+","text":"ಗಲಾ. 6:9; 1 ಕೊರಿ 15:58:","reference":{"chapter":3,"verse":13}},{"noteId":67,"caller":"+","text":"ವ. 6:","reference":{"chapter":3,"verse":14}},{"noteId":68,"caller":"+","text":"ಯಾಜಕ. 19:17; ಮತ್ತಾ 18:15:","reference":{"chapter":3,"verse":15}},{"noteId":69,"caller":"+","text":"ರೋಮಾ. 15:33:","reference":{"chapter":3,"verse":16}},{"noteId":70,"caller":"+","text":"ಅರಣ್ಯ 6:26:","reference":{"chapter":3,"verse":16}},{"noteId":71,"caller":"+","text":"1 ಕೊರಿ 16:21:","reference":{"chapter":3,"verse":17}},{"noteId":72,"caller":"+","text":"ರೋಮಾ. 16:20:","reference":{"chapter":3,"verse":18}}]},"thisChapterLink":"/api/kan_irv/2TH/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_irv/1TI/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_irv/2TH/2.json","previousChapterAudioLinks":{},"numberOfVerses":18}