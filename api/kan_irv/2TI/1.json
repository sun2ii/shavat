r":"+","text":"1 ತಿಮೊ. 6:20","reference":{"chapter":1,"verse":14}},{"noteId":34,"caller":"+","text":"ರೋಮ. 8:9","reference":{"chapter":1,"verse":14}},{"noteId":35,"caller":"+","text":"ಅ. ಕೃ. 19:10","reference":{"chapter":1,"verse":15}},{"noteId":36,"caller":"+","text":"2 ತಿಮೊ. 4:19","reference":{"chapter":1,"verse":16}},{"noteId":37,"caller":"+","text":"ವ. 8; ಅ. ಕೃ. 28:20","reference":{"chapter":1,"verse":16}},{"noteId":38,"caller":"+","text":"ಮತ್ತಾ 25:36-40","reference":{"chapter":1,"verse":17}}]},"thisChapterLink":"/api/kan_irv/2TI/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_irv/2TI/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_irv/1TI/6.json","previousChapterAudioLinks":{},"numberOfVerses":18}