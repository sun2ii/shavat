{"translation":{"id":"kan_irv","name":"ಇಂಡಿಯನ್ ರಿವೈಜ್ಡ್ ವರ್ಸನ್ (IRV) - ಕನ್ನಡ - 2019","website":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseNotes":null,"shortName":"IRV","englishName":"Kannada Indian Revised Version Bible","language":"kan","textDirection":"ltr","sha256":"82cc741009376c81c4416c230a757b2e30ef49b2e4672f9831adcedfc26b865f","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31031,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"2TI","translationId":"kan_irv","name":"2 ತಿಮೊಥೆಯನಿಗೆ","commonName":"2 ತಿಮೊಥೆಯನಿಗೆ","title":"2 ತಿಮೊಥೆಯನಿಗೆ","order":55,"numberOfChapters":4,"sha256":"a2538e081a18478f8c58ae8542a16c1a4aba25a9ab0c63b1ed2463a45247ee6f","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_irv/2TI/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/kan_irv/2TI/4.json","totalNumberOfVerses":82},"chapter":{"number":3,"content":[{"type":"heading","content":["ಅಂತ್ಯ ದಿನಗಳು"]},{"type":"verse","number":1,"content":["ಆದರೆ",{"noteId":80},"ಕಡೆ ದಿನಗಳಲ್ಲಿ ಕಠಿಣಕಾಲಗಳು ಬರುವವೆಂಬುದನ್ನು ತಿಳಿದುಕೋ."]},{"type":"verse","number":2,"content":["ಮನುಷ್ಯರು",{"noteId":81},"ಸ್ವಾರ್ಥಚಿಂತಕರೂ,",{"noteId":82},"ಹಣದಾಸೆಯವರೂ, ಬಡಾಯಿಕೊಚ್ಚುವವರೂ, ಅಹಂಕಾರಿಗಳೂ, ದೂಷಕರೂ, ತಂದೆತಾಯಿಗಳಿಗೆ ಅವಿಧೇಯರೂ, ಉಪಕಾರ ನೆನಸದವರೂ, ದೇವಭಯವಿಲ್ಲದವರೂ,"]},{"type":"verse","number":3,"content":[{"noteId":83},"ಮಮತೆಯಿಲ್ಲದವರೂ, ಸಮಾಧಾನಹೊಂದದವರೂ, ಚಾಡಿಹೇಳುವವರೂ, ದಮೆಯಿಲ್ಲದವರೂ, ಕ್ರೂರರೂ,",{"noteId":84},"ಒಳ್ಳೆಯದನ್ನು ದ್ವೇಷಿಸುವವರೂ,"]},{"type":"verse","number":4,"content":["ದ್ರೋಹಿಗಳೂ, ದುಡುಕುವವರೂ,",{"noteId":85},"ದುರಹಂಕಾರವುಳ್ಳವರೂ,",{"noteId":86},"ದೇವರನ್ನು ಪ್ರೀತಿಸುವುದಕ್ಕಿಂತ ಅಧಿಕವಾಗಿ ಭೋಗವನ್ನೇ ಪ್ರೀತಿಸುವವರೂ,"]},{"type":"verse","number":5,"content":["ಭಕ್ತಿಯ ವೇಷವಿದ್ದು ಅದರ ಬಲವನ್ನು ಬೇಡವೆನ್ನುವವರೂ ಆಗಿರುವರು. ಇಂಥವರ ಸಹವಾಸವನ್ನೂ ಮಾಡದಿರು."]},{"type":"verse","number":6,"content":["ಅವರಲ್ಲಿ ಕೆಲವರು",{"noteId":87},"ಮನೆಗಳಲ್ಲಿ ನುಸುಳಿ, ಪಾಪಗಳಿಂದ ತುಂಬಿದವರೂ, ನಾನಾ ವಿಧವಾದ ಆಸೆಗಳಿಂದ ಪ್ರೇರಿತರೂ ಆಗಿರುವ ಅವಿವೇಕಿಗಳಾದ ಸ್ತ್ರೀಯರನ್ನು ವಶಮಾಡಿಕೊಳ್ಳುವವರು ಆಗಿರುತ್ತಾರೆ."]},{"type":"verse","number":7,"content":["ಆ ಸ್ತ್ರೀಯರು ಯಾವಾಗಲೂ ಉಪದೇಶ ಕೇಳುತ್ತಿದ್ದರೂ",{"noteId":88},"ಸತ್ಯದ ಪರಿಜ್ಞಾನವನ್ನು ಹೊಂದಲಾರದವರು."]},{"type":"verse","number":8,"content":[{"noteId":89},"ಯನ್ನ, ಯಂಬ್ರ ಎಂಬವರು ಮೋಶೆಯನ್ನು ವಿರೋಧಿಸಿದಂತೆಯೇ ಈ ಮನುಷ್ಯರು ಸಹ ಸತ್ಯಕ್ಕೆ ವಿರೋಧಿಗಳಾಗಿದ್ದು, ಬುದ್ಧಿಹೀನರೂ ನಂಬಿಕೆಯ ವಿಷಯದಲ್ಲಿ ನಿಷ್ಪ್ರಯೋಜಕರೂ ಆಗಿದ್ದಾರೆ."]},{"type":"verse","number":9,"content":["ಆದರೆ ಅವರು ಹೆಚ್ಚು ಮುಂದುವರಿಯಲು ಸಾಧ್ಯವಿಲ್ಲ.",{"noteId":90},"ಆ ಯನ್ನ ಯಂಬ್ರರ ಮೂರ್ಖತನವು ಎಲ್ಲರಿಗೂ ಪ್ರಕಟವಾಗಿ ಬಂದ ಹಾಗೆಯೇ ಇವರದೂ ಪ್ರಕಟವಾಗುವುದು."]},{"type":"verse","number":10,"content":[{"noteId":91},"ನೀನಾದರೋ ನನ್ನನ್ನು ಅನುಸರಿಸುವವನಾಗಿದ್ದು, ನನ್ನ ಬೋಧನೆ, ನಡತೆ, ಉದ್ದೇಶ, ನಂಬಿಕೆ, ದೀರ್ಘಶಾಂತಿ, ಪ್ರೀತಿ, ಸೈರಣೆ ಇವುಗಳನ್ನೂ,"]},{"type":"verse","number":11,"content":[{"noteId":92},"ಅಂತಿಯೋಕ್ಯ,",{"noteId":93},"ಇಕೋನ್ಯ,",{"noteId":94},"ಲುಸ್ತ್ರ ಎಂಬ ಪಟ್ಟಣಗಳಲ್ಲಿ ನನಗೆ ಸಂಭವಿಸಿದ ಹಿಂಸೆಗಳನ್ನೂ, ಕಷ್ಟಾನುಭವಗಳನ್ನೂ ತಿಳಿದವನಾಗಿದ್ದೀ. ನಾನು ಎಂಥೆಂಥ ಹಿಂಸೆಗಳನ್ನು ಸಹಿಸಿಕೊಂಡೆನು,",{"noteId":95},"ಅವೆಲ್ಲವುಗಳೊಳಗಿನಿಂದ",{"noteId":96},"ಕರ್ತನು ನನ್ನನ್ನು ಬಿಡಿಸಿದನು."]},{"type":"verse","number":12,"content":[{"noteId":97},"ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ ಸದ್ಭಕ್ತರಾಗಿ ಜೀವಿಸುವುದಕ್ಕೆ ಮನಸ್ಸು ಮಾಡುವವರೆಲ್ಲರೂ ಹಿಂಸೆಗೊಳಗಾಗುವರು."]},{"type":"verse","number":13,"content":["ಆದರೆ ದುಷ್ಟರೂ, ವಂಚಕರೂ ಇತರರನ್ನು ಮೋಸಮಾಡುತ್ತಾ ತಾವೇ ಮೋಸಹೋಗುತ್ತಾ",{"noteId":98},"ಹೆಚ್ಚಾದ ಕೆಟ್ಟತನಕ್ಕೆ ಹೋಗುವರು."]},{"type":"verse","number":14,"content":[{"noteId":99},"ನೀನಾದರೋ ಕಲಿತು ದೃಢವಾಗಿ ನಂಬಿದ ಬೋಧನೆಗಳಲ್ಲಿ ನೆಲೆಯಾಗಿರು. ಕಲಿಸಿಕೊಟ್ಟವರು ಯಾರೆಂಬುದನ್ನು ಆಲೋಚಿಸು."]},{"type":"verse","number":15,"content":[{"noteId":100},"ಚಿಕ್ಕಂದಿನಿಂದಲೂ ನಿನಗೆ",{"noteId":101},"ಪರಿಶುದ್ಧ ಗ್ರಂಥಗಳ ಪರಿಚಯವಾಗಿದೆಯಲ್ಲಾ. ಆ ಗ್ರಂಥಗಳು ಕ್ರಿಸ್ತಯೇಸುವಿನಲ್ಲಿರುವ ನಂಬಿಕೆಯ ಮೂಲಕ",{"noteId":102},"ರಕ್ಷಣೆಹೊಂದುವ ಜ್ಞಾನವನ್ನು ನಿನಗೆ ಕೊಡುವುದಕ್ಕೆ ಶಕ್ತವಾಗಿವೆ."]},{"type":"verse","number":16,"content":["ದೈವ ಪ್ರೇರಿತವಾದ",{"noteId":103},"ಪ್ರತಿಯೊಂದು ಶಾಸ್ತ್ರವು ಉಪದೇಶಕ್ಕೂ, ಖಂಡನೆಗೂ, ತಿದ್ದುಪಡಿಗೂ, ನೀತಿಶಿಕ್ಷೆಗೂ ಉಪಯುಕ್ತವಾಗಿದೆ."]},{"type":"verse","number":17,"content":["ಆದ್ದರಿಂದ",{"noteId":104},"ದೇವರ ಮನುಷ್ಯನು ಎಲ್ಲವನ್ನೂ ಬಲ್ಲವನಾಗಿದ್ದು ಸಕಲಸತ್ಕಾರ್ಯಗಳಿಗೆ ಸನ್ನದ್ಧನಾಗುವನು."]}],"footnotes":[{"noteId":80,"caller":"+","text":"1 ತಿಮೊ 4:1","reference":{"chapter":3,"verse":1}},{"noteId":81,"caller":"+","text":"ಫಿಲಿ 2:21","reference":{"chapter":3,"verse":2}},{"noteId":82,"caller":"+","text":"ಲೂಕ 16:14; 1 ತಿಮೊ 6:10","reference":{"chapter":3,"verse":2}},{"noteId":83,"caller":"+","text":"ರೋಮಾ. 1:31","reference":{"chapter":3,"verse":3}},{"noteId":84,"caller":"+","text":"ತೀತ 1:8","reference":{"chapter":3,"verse":3}},{"noteId":85,"caller":"+","text":"1 ತಿಮೊ 3:6; 6:4","reference":{"chapter":3,"verse":4}},{"noteId":86,"caller":"+","text":"ಫಿಲಿ 3:19","reference":{"chapter":3,"verse":4}},{"noteId":87,"caller":"+","text":"ತೀತ 1:11","reference":{"chapter":3,"verse":6}},{"noteId":88,"caller":"+","text":"1 ತಿಮೊ 2:4","reference":{"chapter":3,"verse":7}},{"noteId":89,"caller":"+","text":"ವಿಮೋ 7:11","reference":{"chapter":3,"verse":8}},{"noteId":90,"caller":"+","text":"ವಿಮೋ 7:12; 8:18; 9:11","reference":{"chapter":3,"verse":9}},{"noteId":91,"caller":"+","text":"ಫಿಲಿ 2:22","reference":{"chapter":3,"verse":10}},{"noteId":92,"caller":"+","text":"ಅ. ಕೃ 13:14; 45, 50","reference":{"chapter":3,"verse":11}},{"noteId":93,"caller":"+","text":"ಅ. ಕೃ 14:1,2,5","reference":{"chapter":3,"verse":11}},{"noteId":94,"caller":"+","text":"ಅ. ಕೃ 14:6,19","reference":{"chapter":3,"verse":11}},{"noteId":95,"caller":"+","text":"ಕೀರ್ತ 34:19","reference":{"chapter":3,"verse":11}},{"noteId":96,"caller":"+","text":"2 ತಿಮೊ 4:17","reference":{"chapter":3,"verse":11}},{"noteId":97,"caller":"+","text":"ಅ. ಕೃ 14:22","reference":{"chapter":3,"verse":12}},{"noteId":98,"caller":"+","text":"ಪ್ರಕ 22:11","reference":{"chapter":3,"verse":13}},{"noteId":99,"caller":"+","text":"2 ತಿಮೊ 1:13","reference":{"chapter":3,"verse":14}},{"noteId":100,"caller":"+","text":"2 ತಿಮೊ 1:5","reference":{"chapter":3,"verse":15}},{"noteId":101,"caller":"+","text":"ಯೋಹಾ 5:39","reference":{"chapter":3,"verse":15}},{"noteId":102,"caller":"+","text":"ಕೀರ್ತ 119:99","reference":{"chapter":3,"verse":15}},{"noteId":103,"caller":"+","text":"ರೋಮ 15:4; 2 ಪೇತ್ರ 1:20,21","reference":{"chapter":3,"verse":16}},{"noteId":104,"caller":"+","text":"1 ತಿಮೊ 6:11","reference":{"chapter":3,"verse":17}}]},"thisChapterLink":"/api/kan_irv/2TI/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_irv/2TI/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_irv/2TI/2.json","previousChapterAudioLinks":{},"numberOfVerses":17}