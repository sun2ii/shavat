{"translation":{"id":"kan_irv","name":"ಇಂಡಿಯನ್ ರಿವೈಜ್ಡ್ ವರ್ಸನ್ (IRV) - ಕನ್ನಡ - 2019","website":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseNotes":null,"shortName":"IRV","englishName":"Kannada Indian Revised Version Bible","language":"kan","textDirection":"ltr","sha256":"82cc741009376c81c4416c230a757b2e30ef49b2e4672f9831adcedfc26b865f","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31031,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"2TI","translationId":"kan_irv","name":"2 ತಿಮೊಥೆಯನಿಗೆ","commonName":"2 ತಿಮೊಥೆಯನಿಗೆ","title":"2 ತಿಮೊಥೆಯನಿಗೆ","order":55,"numberOfChapters":4,"sha256":"a2538e081a18478f8c58ae8542a16c1a4aba25a9ab0c63b1ed2463a45247ee6f","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_irv/2TI/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/kan_irv/2TI/4.json","totalNumberOfVerses":82},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":["ನಾನು ದೇವರ ಸಮಕ್ಷಮದಲ್ಲಿ ಮತ್ತು",{"noteId":105},"ಜೀವಿಸುವವರಿಗೂ ಸತ್ತವರಿಗೂ ನ್ಯಾಯತೀರಿಸುವುದಕ್ಕೆ ಬರುವ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ ಪ್ರತ್ಯಕ್ಷತೆಯನ್ನೂ,",{"noteId":106},"ಆತನ ರಾಜ್ಯವನ್ನೂ ಮುಂದಿಟ್ಟು ನಿನಗೆ ಖಂಡಿತವಾಗಿ ಹೇಳುವುದೇನಂದರೆ,"]},{"type":"verse","number":2,"content":["ದೇವರ ವಾಕ್ಯವನ್ನು ಸಾರು, ಅನುಕೂಲವಾದ ಕಾಲದಲ್ಲಿಯೂ ಅನುಕೂಲವಿಲ್ಲದ ಕಾಲದಲ್ಲಿಯೂ ಅದರಲ್ಲಿ ಆಸಕ್ತನಾಗಿರು. ಪೂರ್ಣ ದೀರ್ಘಶಾಂತಿಯಿಂದ ಉಪದೇಶಿಸುತ್ತಾ",{"noteId":107},"ಖಂಡಿಸು, ಗದರಿಸು, ಎಚ್ಚರಿಸು."]},{"type":"verse","number":3,"content":["ಯಾಕೆಂದರೆ ಜನರು",{"noteId":108},"ಸ್ವಸ್ಥಬೋಧನೆಯನ್ನು ಒಪ್ಪಲಾರದ",{"noteId":109},"ಕಾಲವು ಬರುತ್ತದೆ. ಅದರಲ್ಲಿ ಅವರು ಕಿವಿಗೆ ಇಂಪಾಗುವ ಹಾಗೆ ತಮ್ಮ ದುರಾಶೆಗಳಿಗೆ ಅನುಕೂಲವಾದ ಉಪದೇಶಗಳನ್ನು ನೀಡುವ ಅನೇಕ ಉಪದೇಶಕರನ್ನು ಇಟ್ಟುಕೊಳ್ಳುವರು."]},{"type":"verse","number":4,"content":["ಅವರು ಸತ್ಯ ಬೋಧನೆಗೆ ಕಿವಿಗೊಡದೆ",{"noteId":110},"ಕಟ್ಟುಕಥೆಗಳನ್ನು ಕೇಳುವುದಕ್ಕೆ ಇಚ್ಛಿಸುವರು."]},{"type":"verse","number":5,"content":["ಆದರೆ ನೀನು ಎಲ್ಲಾ ವಿಷಯಗಳಲ್ಲಿಯೂ",{"noteId":111},"ಸ್ವಸ್ಥಚಿತ್ತನಾಗಿರು,",{"noteId":112},"ಹಿಂಸೆಯನ್ನು ತಾಳಿಕೋ,",{"noteId":113},"ಸುವಾರ್ತಿಕನ ಕೆಲಸವನ್ನು ಮಾಡು, ನಿನಗೆ ನೇಮಿಸಿರುವ ಸೇವೆಯನ್ನು ಲೋಪವಿಲ್ಲದೆ ಮಾಡು."]},{"type":"verse","number":6,"content":["ಯಾಕೆಂದರೆ ನಾನಂತೂ",{"noteId":114},"ಈಗಲೇ ಪಾನದ್ರವ್ಯವಾಗಿ ಅರ್ಪಿತನಾಗುತ್ತಾ ಇದ್ದೇನೆ.",{"noteId":115},"ನನ್ನ ನಿರ್ಗಮನದ ಸಮಯವು ಸಮೀಪವಾಗುತ್ತಾ ಬಂದಿದೆ."]},{"type":"verse","number":7,"content":[{"noteId":116},"ಶ್ರೇಷ್ಠ ಹೋರಾಟವನ್ನು ಮಾಡಿದ್ದೇನೆ,",{"noteId":117},"ನನ್ನ ಓಟವನ್ನು ಓಡಿಮುಗಿಸಿದ್ದೇನೆ, ಕ್ರಿಸ್ತ ನಂಬಿಕೆಯನ್ನು ಕಾಪಾಡಿಕೊಂಡಿದ್ದೇನೆ."]},{"type":"verse","number":8,"content":[{"noteId":118},"ನೀತಿವಂತರಿಗೆ ದೊರಕುವ ಜಯಮಾಲೆಯು ಮುಂದೆ ನನಗಾಗಿ ಸಿದ್ಧವಾಗಿದೆ, ಅದನ್ನು",{"noteId":119},"ನೀತಿವಂತನಾದ ನ್ಯಾಯಾಧಿಪತಿಯಾಗಿರುವ ಕರ್ತನು",{"noteId":120},"ಆ ದಿನದಲ್ಲಿ ನನಗೆ ಕೊಡುವನು, ನನಗೆ ಮಾತ್ರವಲ್ಲದೆ ತನ್ನ ಪ್ರತ್ಯಕ್ಷತೆಯನ್ನು ಪ್ರೀತಿಸುವವರೆಲ್ಲರಿಗೂ ಕೊಡುವನು."]},{"type":"heading","content":["ಪೌಲನ ವೈಯುಕ್ತಿಕ ಆದೇಶಗಳು"]},{"type":"verse","number":9,"content":["ನೀನು",{"noteId":121},"ನನ್ನ ಬಳಿಗೆ ಬೇಗನೇ ಬರುವುದಕ್ಕೆ ಪ್ರಯತ್ನಪಡು,"]},{"type":"verse","number":10,"content":["ಯಾಕೆಂದರೆ",{"noteId":122},"ದೇಮನು ಇಹಲೋಕವನ್ನು",{"noteId":123},"ಪ್ರೀತಿಸಿ,",{"noteId":124},"ನನ್ನನ್ನು ಬಿಟ್ಟು ಥೆಸಲೋನಿಕಕ್ಕೆ ಹೋದನು. ಕ್ರೆಸ್ಕನು ಗಲಾತ್ಯಕ್ಕೂ",{"noteId":125},"ತೀತನು ದಲ್ಮಾತ್ಯಕ್ಕೂ ಹೋದರು."]},{"type":"verse","number":11,"content":[{"noteId":126},"ಲೂಕನು ಮಾತ್ರ ನನ್ನ ಜೊತೆಯಲ್ಲಿದ್ದಾನೆ.",{"noteId":127},"ಮಾರ್ಕನನ್ನು ನಿನ್ನ ಸಂಗಡ ಕರೆದುಕೊಂಡು ಬಾ, ಅವನು ನನಗೆ ಸೇವೆಯಲ್ಲಿ ಉಪಯುಕ್ತನಾಗಿದ್ದಾನೆ."]},{"type":"verse","number":12,"content":[{"noteId":128},"ತುಖಿಕನನ್ನು ಎಫೆಸಕ್ಕೆ ಕಳುಹಿಸಿದೆನು. ತ್ರೋವದಲ್ಲಿ ನಾನು ಕರ್ಪನ ಬಳಿಯಲ್ಲಿ ಬಿಟ್ಟು ಬಂದ ಮೇಲಂಗಿಯನ್ನೂ, ಪುಸ್ತಕಗಳನ್ನೂ, ಮುಖ್ಯವಾಗಿ ಚರ್ಮದ ಕಾಗದಗಳನ್ನೂ ನೀನು ಬರುವಾಗ ತೆಗೆದುಕೊಂಡು ಬಾ."]},{"type":"verse","number":14,"content":[{"noteId":129},"ಕಂಚುಗಾರನಾದ ಅಲೆಕ್ಸಾಂದ್ರನು ನನಗೆ ಬಹಳ ಕೇಡುಮಾಡಿದನು.",{"noteId":130},"ಕರ್ತನು ಅವನ ಕೃತ್ಯಗಳಿಗೆ ತಕ್ಕ ಪ್ರತಿಫಲವನ್ನು ಅವನಿಗೆ ಕೊಡುವನು."]},{"type":"verse","number":15,"content":["ನೀನು ಸಹ ಅವನ ವಿಷಯದಲ್ಲಿ ಎಚ್ಚರಿಕೆಯಾಗಿರು, ಅವನು ನಮ್ಮ ಮಾತುಗಳನ್ನು ಬಹಳವಾಗಿ ಎದುರಿಸಿದನು."]},{"type":"verse","number":16,"content":["ನಾನು ಮೊದಲನೆ ಸಾರಿ ಪ್ರತಿವಾದ ಮಾಡಿದಾಗ ಯಾರೂ ನನ್ನ ಸಂಗಡ ಇರಲಿಲ್ಲ, ಎಲ್ಲರೂ ನನ್ನನ್ನು ಕೈಬಿಟ್ಟರು.",{"noteId":131},"ಇದು ಅವರಿಗೆ ದೋಷವಾಗಿ ಎಣಿಸಲ್ಪಡದೆ ಇರಲಿ."]},{"type":"verse","number":17,"content":[{"noteId":132},"ಆದರೆ ಕರ್ತನು ನನ್ನ ಬಳಿಯಲ್ಲಿ ನಿಂತು ನನ್ನನ್ನು ಬಲಪಡಿಸಿ ನನ್ನ ಮೂಲಕ ಸುವಾರ್ತೆಯು ಸಂಪೂರ್ಣವಾಗಿ ಸಾರಲ್ಪಡುವಂತೆಯೂ,",{"noteId":133},"ಅನ್ಯ ಜನರೆಲ್ಲರೂ ಅದನ್ನು ಕೇಳುವಂತೆಯೂ ಮಾಡಿದನು. ಇದಲ್ಲದೆ ಆತನು ನನ್ನನ್ನು",{"noteId":134},"ಸಿಂಹದ ಬಾಯೊಳಗಿಂದ ತಪ್ಪಿಸಿದನು."]},{"type":"verse","number":18,"content":[{"noteId":135},"ಪ್ರತಿಯೊಂದು ದುಷ್ಕೃತ್ಯದಿಂದ ಕರ್ತನು ನನ್ನನ್ನು ಕಾಪಾಡಿ ತನ್ನೊಂದಿಗೆ ಪರಲೋಕ ರಾಜ್ಯಕ್ಕೆ ಸೇರಿಸುವನು.",{"noteId":136},"ಯುಗಯುಗಾಂತರಗಳಲ್ಲಿಯೂ ಆತನಿಗೆ ಸ್ತೋತ್ರ. ಆಮೆನ್."]},{"type":"heading","content":["ಅಂತಿಮ ವಂದನೆಗಳು"]},{"type":"verse","number":19,"content":[{"noteId":137},"ಪ್ರಿಸ್ಕಿಲ್ಲಳಿಗೂ, ಅಕ್ವಿಲ್ಲನಿಗೂ,",{"noteId":138},"ಒನೇಸಿಪೊರನ ಮನೆಯವರಿಗೂ ವಂದನೆಹೇಳು."]},{"type":"verse","number":20,"content":[{"noteId":139},"ಎರಸ್ತನು ಕೊರಿಂಥದಲ್ಲಿ ನಿಂತನು.",{"noteId":140},"ತ್ರೊಫಿಮನು ಅಸ್ವಸ್ಥನಾಗಿದ್ದುದರಿಂದ ಅವನನ್ನು ಮಿಲೇತದಲ್ಲಿ ಬಿಟ್ಟೆನು."]},{"type":"verse","number":21,"content":[{"noteId":141},"ಚಳಿಗಾಲಕ್ಕೆ ಮುಂಚೆಯೇ ಬರುವುದಕ್ಕೆ ಪ್ರಯತ್ನಿಸು. ಯುಬೂಲನು, ಪೊದೆಯನೂ, ಲೀನನೂ, ಕ್ಲೌದ್ಯಳೂ ಉಳಿದ ಸಹೋದರರೆಲ್ಲರೂ ನಿನಗೆ ವಂದನೆ ಹೇಳುತ್ತಾರೆ."]},{"type":"verse","number":22,"content":["ಕರ್ತನು",{"noteId":142},"ನಿನ್ನ ಆತ್ಮದೊಂದಿಗೆ ಇರಲಿ. ಆತನ",{"noteId":143},"ಕೃಪೆಯು ನಿಮ್ಮೊಂದಿಗಿರಲಿ."]}],"footnotes":[{"noteId":105,"caller":"+","text":"ಅ. ಕೃ 10:42; 17:31; 24:25; ಯೋಹಾ 5:22, 27; 2 ಕೊರಿ 5:10; 1 ಪೇತ್ರ 4:5","reference":{"chapter":4,"verse":1}},{"noteId":106,"caller":"+","text":"ವ. 8; 2 ಥೆಸ. 2:8","reference":{"chapter":4,"verse":1}},{"noteId":107,"caller":"+","text":"1 ತಿಮೊ 5:20; ತೀತ 1:13; 2:15","reference":{"chapter":4,"verse":2}},{"noteId":108,"caller":"+","text":"1 ತಿಮೊ 1:10","reference":{"chapter":4,"verse":3}},{"noteId":109,"caller":"+","text":"2 ತಿಮೊ 3:1","reference":{"chapter":4,"verse":3}},{"noteId":110,"caller":"+","text":"1 ತಿಮೊ 1:4,6","reference":{"chapter":4,"verse":4}},{"noteId":111,"caller":"+","text":"1 ಪೇತ್ರ 1:13","reference":{"chapter":4,"verse":5}},{"noteId":112,"caller":"+","text":"2 ತಿಮೊ 1:8; 2:3; 9","reference":{"chapter":4,"verse":5}},{"noteId":113,"caller":"+","text":"ಅ. ಕೃ 21:8; ಎಫೆ 4:11","reference":{"chapter":4,"verse":5}},{"noteId":114,"caller":"+","text":"ಫಿಲಿ 2:17","reference":{"chapter":4,"verse":6}},{"noteId":115,"caller":"+","text":"ಫಿಲಿ 1:23","reference":{"chapter":4,"verse":6}},{"noteId":116,"caller":"+","text":"1 ತಿಮೊ 6:12","reference":{"chapter":4,"verse":7}},{"noteId":117,"caller":"+","text":"ಅ ಕೃ 20:24","reference":{"chapter":4,"verse":7}},{"noteId":118,"caller":"+","text":"ಮೂಲ: ನೀತಿಯೆಂಬ","reference":{"chapter":4,"verse":8}},{"noteId":119,"caller":"+","text":"ಕೀರ್ತ 7:11","reference":{"chapter":4,"verse":8}},{"noteId":120,"caller":"+","text":"2 ತಿಮೊ 1:12","reference":{"chapter":4,"verse":8}},{"noteId":121,"caller":"+","text":"2 ತಿಮೊ. 1:4","reference":{"chapter":4,"verse":9}},{"noteId":122,"caller":"+","text":"ಕೊಲೊ 4:14; ಫಿಲಿ 24","reference":{"chapter":4,"verse":10}},{"noteId":123,"caller":"+","text":"1 ಯೋಹಾ 2:15","reference":{"chapter":4,"verse":10}},{"noteId":124,"caller":"+","text":"2 ತಿಮೊ 1:15","reference":{"chapter":4,"verse":10}},{"noteId":125,"caller":"+","text":"ತೀತ 3:12","reference":{"chapter":4,"verse":10}},{"noteId":126,"caller":"+","text":"1 ತಿಮೊ 1:15","reference":{"chapter":4,"verse":11}},{"noteId":127,"caller":"+","text":"ಅ. ಕೃ 12:12","reference":{"chapter":4,"verse":11}},{"noteId":128,"caller":"+","text":"-13 ಅ. ಕೃ 20:4; ಎಫೆ 6:21; ಕೊಲೊ 4:7; ತೀತ 3:12","reference":{"chapter":4,"verse":12}},{"noteId":129,"caller":"+","text":"1 ತಿಮೊ 1:20","reference":{"chapter":4,"verse":14}},{"noteId":130,"caller":"+","text":"ಕೀರ್ತ 62:12; ಜ್ಞಾ 24:12","reference":{"chapter":4,"verse":14}},{"noteId":131,"caller":"+","text":"ಅ. ಕೃ 7:60","reference":{"chapter":4,"verse":16}},{"noteId":132,"caller":"+","text":"ಅ. ಕೃ 23:11; 27:23; ಮತ್ತಾ 10:19","reference":{"chapter":4,"verse":17}},{"noteId":133,"caller":"+","text":"ಅ. ಕೃ 9:15","reference":{"chapter":4,"verse":17}},{"noteId":134,"caller":"+","text":"1 ಪೇತ್ರ 5:8; ಕೀರ್ತ 22:21","reference":{"chapter":4,"verse":17}},{"noteId":135,"caller":"+","text":"ಮತ್ತಾ 6:13","reference":{"chapter":4,"verse":18}},{"noteId":136,"caller":"+","text":"ರೋಮಾ 11:36","reference":{"chapter":4,"verse":18}},{"noteId":137,"caller":"+","text":"ಅ. ಕೃ. 18:2","reference":{"chapter":4,"verse":19}},{"noteId":138,"caller":"+","text":"2 ತಿಮೊ 1:16","reference":{"chapter":4,"verse":19}},{"noteId":139,"caller":"+","text":"ಅ. ಕೃ. 19:22; ರೋಮಾ 16:23","reference":{"chapter":4,"verse":20}},{"noteId":140,"caller":"+","text":"ಅ. ಕೃ 20:4; 21:29","reference":{"chapter":4,"verse":20}},{"noteId":141,"caller":"+","text":"ವ. 9","reference":{"chapter":4,"verse":21}},{"noteId":142,"caller":"+","text":"ಗಲಾ 6:18; ಫಿಲಿ 25","reference":{"chapter":4,"verse":22}},{"noteId":143,"caller":"+","text":"ಕೊಲೊ 4:18","reference":{"chapter":4,"verse":22}}]},"thisChapterLink":"/api/kan_irv/2TI/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_irv/TIT/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_irv/2TI/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}