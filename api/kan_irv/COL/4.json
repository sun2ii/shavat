{"translation":{"id":"kan_irv","name":"ಇಂಡಿಯನ್ ರಿವೈಜ್ಡ್ ವರ್ಸನ್ (IRV) - ಕನ್ನಡ - 2019","website":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseNotes":null,"shortName":"IRV","englishName":"Kannada Indian Revised Version Bible","language":"kan","textDirection":"ltr","sha256":"82cc741009376c81c4416c230a757b2e30ef49b2e4672f9831adcedfc26b865f","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31031,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"COL","translationId":"kan_irv","name":"ಕೊಲೊಸ್ಸೆಯವರಿಗೆ","commonName":"ಕೊಲೊಸ್ಸೆಯವರಿಗೆ","title":"ಕೊಲೊಸ್ಸೆಯವರಿಗೆ","order":51,"numberOfChapters":4,"sha256":"95c27e62ba702410bf06857e12e28e9fdda88b3a47d88bbb0be33313d37ac3d2","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_irv/COL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/kan_irv/COL/4.json","totalNumberOfVerses":94},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":["ಯಜಮಾನರೇ, ಪರಲೋಕದಲ್ಲಿ ನಿಮಗೂ ಯಜಮಾನನೊಬ್ಬನಿದ್ದಾನೆಂದು ತಿಳಿದು ನಿಮ್ಮ ದಾಸರೊಂದಿಗೆ ನೀತಿಯಿಂದಲೂ ನ್ಯಾಯದಿಂದಲೂ ವರ್ತಿಸಿರಿ."]},{"type":"heading","content":["ಪ್ರಾರ್ಥಿಸಲು ಉತ್ತೇಜನ"]},{"type":"verse","number":2,"content":[{"noteId":131},"ಪ್ರಾರ್ಥನೆಯನ್ನು ತಪ್ಪದೆ ಮಾಡುವವರಾಗಿ, ಎಚ್ಚರವಾಗಿದ್ದು ದೇವರಿಗೆ ಕೃತಜ್ಞತಾಸ್ತುತಿಮಾಡಿರಿ."]},{"type":"verse","number":3,"content":["ಕ್ರಿಸ್ತನ ಮರ್ಮವನ್ನು ಅಂದರೆ ಸುರ್ವಾತೆಯನ್ನು ನಾವು ಸಾರುವುದಕ್ಕೆ ದೇವರು ನಮಗೆ ಬಾಗಿಲನ್ನು ತೆರೆದು ಕೊಡುವುದಕ್ಕಾಗಿ ನಮಗೋಸ್ಕರವಾಗಿ ಪ್ರಾರ್ಥಿಸಿರಿ. ಈ ಸುರ್ವಾತೆಯ ನಿಮಿತ್ತವೇ",{"noteId":132},"ನಾನು ಸೆರೆಯಲ್ಲಿದ್ದೇನಲ್ಲಾ."]},{"type":"verse","number":4,"content":["ನಾನು ಆ",{"noteId":133},"ಸತ್ಯಾರ್ಥವನ್ನು ಹೇಳಬೇಕಾದ ರೀತಿಯಲ್ಲಿ ಸ್ಪಷ್ಟವಾಗಿ ಹೇಳುವಂತೆ ಪ್ರಾರ್ಥಿಸಿರಿ."]},{"type":"verse","number":5,"content":["ಸಮಯವನ್ನು ಸದುಪಯೋಗಿಸಿಕೊಂಡು",{"noteId":134},"ಹೊರಗಿನವರೊಂದಿಗೆ",{"noteId":135},"ಜ್ಞಾನವುಳ್ಳವರಾಗಿ ನಡೆದುಕೊಳ್ಳಿರಿ."]},{"type":"verse","number":6,"content":["ನಿಮ್ಮ ಸಂಭಾಷಣೆಯು ಯಾವಾಗಲೂ ಕೃಪೆಯುಳ್ಳದ್ದಾಗಿಯೂ, ಉಪ್ಪಿನಂತೆ",{"noteId":136},"ರುಚಿಕರವಾಗಿಯೂ ಇರಲಿ.",{"noteId":137},"ಹೀಗೆ ನೀವು ಪ್ರತಿಯೊಬ್ಬರಿಗೂ ಯಾವಾವ ರೀತಿಯಲ್ಲಿ ಉತ್ತರಹೇಳಬೇಕು ಎಂಬುದನ್ನು ತಿಳಿದುಕೊಳ್ಳುವಿರಿ."]},{"type":"heading","content":["ವಂದನೆಗಳು ಹಾಗೂ ಕಡೆ ಮಾತುಗಳು"]},{"type":"verse","number":7,"content":[{"noteId":138},"ಪ್ರಿಯ ಸಹೋದರನೂ, ನಂಬಿಗಸ್ತನಾದ ಸೇವಕನೂ ಮತ್ತು ಕರ್ತನಲ್ಲಿ ಜೊತೆಯ ದಾಸನೂ ಆಗಿರುವ ತುಖಿಕನು ನನ್ನ ವಿಷಯಗಳನ್ನೆಲ್ಲಾ ನಿಮಗೆ ತಿಳಿಸುವನು."]},{"type":"verse","number":8,"content":["ನೀವು ನಮ್ಮ ಕುರಿತು ತಿಳಿದುಕೊಳ್ಳುವಂತೆ, ಅವನು ನಿಮ್ಮ ಹೃದಯಗಳನ್ನು ಉರಿದುಂಬಿಸುವಂತೆ,"]},{"type":"verse","number":9,"content":["ಅವನನ್ನು ನಂಬಿಗಸ್ತನು ಮತ್ತು",{"noteId":139},"ಪ್ರಿಯ ಸಹೋದರನಾಗಿರುವ ನಿಮ್ಮ ಊರಿನವನೇ ಆದ",{"noteId":140},"ಓನೇಸಿಮನ ಜೊತೆಯಲ್ಲಿ ಕಳುಹಿಸಿದ್ದೇನೆ. ಅವರು ಇಲ್ಲಿ ನಡೆಯುತ್ತಿರುವ ವಿಷಯಗಳನ್ನೆಲ್ಲಾ ನಿಮಗೆ ತಿಳಿಸುವರು."]},{"type":"verse","number":10,"content":["ನನ್ನ ಜೊತೆ ಸೆರೆಯವನಾದ",{"noteId":141},"ಅರಿಸ್ತಾರ್ಕನೂ ಮತ್ತು",{"noteId":142},"ಬಾರ್ನಬನ ಸೋದರಸಂಬಂಧಿಯಾಗಿರುವ ಮಾರ್ಕನೂ ನಿಮಗೆ ವಂದನೆ ಹೇಳುತ್ತಾರೆ.",{"noteId":143},"ಅವನು ನಿಮ್ಮ ಬಳಿಗೆ ಬಂದರೆ ಅವನನ್ನು ಸೇರಿಸಿಕೊಳ್ಳಿರಿ. ಅವನ ವಿಷಯದಲ್ಲಿ ಅಪ್ಪಣೆಗಳನ್ನು ಹೊಂದಿದ್ದೀರಲ್ಲಾ."]},{"type":"verse","number":11,"content":["ಯುಸ್ತನೆನಿಸಿಕೊಳ್ಳುವ ಯೇಸು ಸಹ ನಿಮಗೆ ವಂದನೆ ಹೇಳುತ್ತಾನೆ.",{"noteId":144},"ಸುನ್ನತಿಯವರೊಳಗೆ ಇವರು ಮಾತ್ರವೇ ದೇವರ ರಾಜ್ಯಕ್ಕಾಗಿ ನನ್ನ ಜೊತೆಸೇವಕರಾಗಿದ್ದಾರೆ, ಇವರಿಂದ ನನಗೆ ಆದರಣೆ ಉಂಟಾಯಿತು."]},{"type":"verse","number":12,"content":["ಕ್ರಿಸ್ತಯೇಸುವಿನ ದಾಸನಾಗಿರುವ ನಿಮ್ಮ ಊರಿನವನಾದ",{"noteId":145},"ಎಪಫ್ರನು ನಿಮಗೆ ವಂದನೆ ಹೇಳುತ್ತಾನೆ, ನೀವು",{"noteId":146},"ಪ್ರವೀಣರಾಗಿಯೂ ದೇವರ ಎಲ್ಲಾ ಚಿತ್ತದಲ್ಲಿ ಪೂರ್ಣ ನಿಶ್ಚಯವುಳ್ಳವರಾಗಿರಬೇಕೆಂದು ನಿಮಗೋಸ್ಕರ ಯಾವಾಗಲೂ ಪ್ರಾರ್ಥನೆಯಲ್ಲಿ ಹೋರಾಡುತ್ತಾನೆ."]},{"type":"verse","number":13,"content":["ಇವನು ನಿಮಗಾಗಿಯೂ, ಲವೊದಿಕೀಯದವರಿಗಾಗಿಯೂ ಮತ್ತು ಹಿರಿಯಾಪೋಲಿಯದವರಿಗಾಗಿಯೂ ಬಹಳ ಪ್ರಯಾಸ ಪಡುತ್ತಾನೆಂದು ನಾನು ಸಾಕ್ಷಿಹೇಳುತ್ತೇನೆ."]},{"type":"verse","number":14,"content":["ಪ್ರಿಯ ವೈದ್ಯನಾಗಿರುವ",{"noteId":147},"ಲೂಕನು ಮತ್ತು",{"noteId":148},"ದೇಮನು ನಿಮಗೆ ವಂದನೆ ಹೇಳುತ್ತಾರೆ."]},{"type":"verse","number":15,"content":["ಲವೊದಿಕೀಯದಲ್ಲಿರುವ ಸಹೋದರರಿಗೂ ಮತ್ತು ನುಂಫಳಿಗೂ ಹಾಗೂ ಆಕೆಯ",{"noteId":149},"ಮನೆಯಲ್ಲಿ ಸೇರಿಬರುವ ಸಭೆಯವರಿಗೂ ವಂದನೆ ಹೇಳಿರಿ."]},{"type":"verse","number":16,"content":["ನಿಮ್ಮಲ್ಲಿ ಈ ಪತ್ರವನ್ನು ಓದಿದ ತರುವಾಯ ಲವೊದಿಕೀಯದವರ ಸಭೆಯಲ್ಲಿಯೂ ಇದನ್ನು ಓದಿಸಿರಿ ಮತ್ತು ನಾನು ಬರೆದ ಪತ್ರವನ್ನು ಲವೊದಿಕೀಯದಿಂದ ತರಿಸಿ ನೀವೂ ಓದಿಕೊಳ್ಳಿರಿ."]},{"type":"verse","number":17,"content":[{"noteId":150},"ಅರ್ಖಿಪ್ಪನಿಗೆ, “ನೀನು ಕರ್ತನಿಂದ ಹೊಂದಿರುವ ಸೇವೆಯನ್ನು ಎಚ್ಚರವಾಗಿದ್ದು ನೆರವೇರಿಸಬೇಕೆಂದು” ಹೇಳಿರಿ."]},{"type":"verse","number":18,"content":[{"noteId":151},"ಇದು ಪೌಲನೆಂಬ ನಾನು ಸ್ವಂತ ಕೈಯಿಂದಲೇ ಬರೆದ ವಂದನೆ.",{"noteId":152},"ನಾನು ಸೆರೆಯಲ್ಲಿದ್ದೇನೆಂಬುದನ್ನು ಜ್ಞಾಪಕ ಮಾಡಿಕೊಳ್ಳಿರಿ.",{"noteId":153},"ಕೃಪೆಯು ನಿಮ್ಮೊಂದಿಗಿರಲಿ."]}],"footnotes":[{"noteId":131,"caller":"+","text":"ವ. 2-4; ಎಫೆ 6:18-20","reference":{"chapter":4,"verse":2}},{"noteId":132,"caller":"+","text":"ಕೊಲೊ 4:18; ಎಫೆ 6:20; ಫಿಲಿ. 1:7","reference":{"chapter":4,"verse":3}},{"noteId":133,"caller":"+","text":"ರೋಮಾ. 16:25","reference":{"chapter":4,"verse":4}},{"noteId":134,"caller":"+","text":"ಮಾರ್ಕ 4:11","reference":{"chapter":4,"verse":5}},{"noteId":135,"caller":"+","text":"ಎಫೆ 5:15-17","reference":{"chapter":4,"verse":5}},{"noteId":136,"caller":"+","text":"ಉಪ್ಪಾಗಿಯೂ","reference":{"chapter":4,"verse":6}},{"noteId":137,"caller":"+","text":"1 ಪೇತ್ರ 3:15","reference":{"chapter":4,"verse":6}},{"noteId":138,"caller":"+","text":"ವ. 7-9; ಎಫೆ 6:21-22","reference":{"chapter":4,"verse":7}},{"noteId":139,"caller":"+","text":"ಫಿಲೆ. 16","reference":{"chapter":4,"verse":9}},{"noteId":140,"caller":"+","text":"ಫಿಲೆ. 10","reference":{"chapter":4,"verse":9}},{"noteId":141,"caller":"+","text":"ಅ. ಕೃ. 19:29; 20:4; 7:2; ಫಿಲೆ. 24","reference":{"chapter":4,"verse":10}},{"noteId":142,"caller":"+","text":"ಅ. ಕೃ. 15:37-39","reference":{"chapter":4,"verse":10}},{"noteId":143,"caller":"+","text":"ಅ. ಕೃ. 12:12","reference":{"chapter":4,"verse":10}},{"noteId":144,"caller":"+","text":"ಅ. ಕೃ. 11:2","reference":{"chapter":4,"verse":11}},{"noteId":145,"caller":"+","text":"ಕೊಲೊ 1:7; ಫಿಲೆ. 23","reference":{"chapter":4,"verse":12}},{"noteId":146,"caller":"+","text":"ಮತ್ತಾ 5:48","reference":{"chapter":4,"verse":12}},{"noteId":147,"caller":"+","text":"2 ತಿಮೊ. 4:11; ಅ. ರು. 16:10","reference":{"chapter":4,"verse":14}},{"noteId":148,"caller":"+","text":"2 ತಿಮೊ. 4:10; ಫಿಲೆ. 24","reference":{"chapter":4,"verse":14}},{"noteId":149,"caller":"+","text":"ರೋಮಾ. 16:5","reference":{"chapter":4,"verse":15}},{"noteId":150,"caller":"+","text":"ಫಿಲೆ. 2","reference":{"chapter":4,"verse":17}},{"noteId":151,"caller":"+","text":"1 ಕೊರಿ 16:21","reference":{"chapter":4,"verse":18}},{"noteId":152,"caller":"+","text":"ಫಿಲಿ. 1:7; ಕೊಲೊ 4:3; ಇಬ್ರಿ. 13:3","reference":{"chapter":4,"verse":18}},{"noteId":153,"caller":"+","text":"1 ತಿಮೊ. 6:21; 2 ತಿಮೊ. 4:22; ತೀತ. 3:15; ಇಬ್ರಿ. 13:25","reference":{"chapter":4,"verse":18}}]},"thisChapterLink":"/api/kan_irv/COL/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_irv/1TH/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_irv/COL/3.json","previousChapterAudioLinks":{},"numberOfVerses":18}