{"translation":{"id":"kan_irv","name":"ಇಂಡಿಯನ್ ರಿವೈಜ್ಡ್ ವರ್ಸನ್ (IRV) - ಕನ್ನಡ - 2019","website":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseNotes":null,"shortName":"IRV","englishName":"Kannada Indian Revised Version Bible","language":"kan","textDirection":"ltr","sha256":"82cc741009376c81c4416c230a757b2e30ef49b2e4672f9831adcedfc26b865f","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31031,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"EPH","translationId":"kan_irv","name":"ಎಫೆಸದವರಿಗೆ","commonName":"ಎಫೆಸದವರಿಗೆ","title":"ಎಫೆಸದವರಿಗೆ","order":49,"numberOfChapters":6,"sha256":"eb830f2a1ad19b20931d89d0b5cda61d7b3fbd8d4a2aff7c5d5166cd507d8f11","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_irv/EPH/1.json","lastChapterNumber":6,"lastChapterApiLink":"/api/kan_irv/EPH/6.json","totalNumberOfVerses":153},"chapter":{"number":2,"content":[{"type":"heading","content":["ಮರಣದಿಂದ ಜೀವಕ್ಕೆ"]},{"type":"verse","number":1,"content":[{"noteId":39},"ನೀವು ನಿಮ್ಮ ಅಪರಾಧಗಳ ಹಾಗೂ ಪಾಪಗಳ ದೆಸೆಯಿಂದ ಸತ್ತವರಾಗಿದ್ದೀರಿ."]},{"type":"verse","number":2,"content":["ಪೂರ್ವದಲ್ಲಿ",{"noteId":40},"ನೀವು ಇಹಲೋಕದ ಪದ್ಧತಿಗೆ ಅನುಸಾರವಾಗಿಯೂ,",{"noteId":41},"ವಾಯುಮಂಡಲದಲ್ಲಿ ಅಧಿಕಾರ ನಡಿಸುವ ಅಧಿಪತಿಗೆ ಅಂದರೆ ಅವಿಧೇಯತೆಯ ಮಕ್ಕಳಲ್ಲಿ ಈಗ ಕೆಲಸ ನಡೆಸುವ ಆತ್ಮನಿಗನುಸಾರವಾಗಿ ಜೀವನ ನಡಿಸಿದ್ದೀರಿ."]},{"type":"verse","number":3,"content":["ನಾವೆಲ್ಲರೂ ಪೂರ್ವದಲ್ಲಿ ಅವರ ಹಾಗೆಯೇ ಇದ್ದೆವು,",{"noteId":42},"ಶರೀರಭಾವದ ಆಸೆಗಳಿಗೆ ಅಧೀನರಾಗಿ, ಶಾರೀರಿಕ ಹಾಗೂ ಮಾನಸಿಕ ಇಚ್ಛೆಗಳನ್ನು ಈಡೇರಿಸುತ್ತಾ ಬಂದೆವು.",{"noteId":43},"ಸ್ವಭಾವತಃ ನಾವು ಸಹ ಇತರರಂತೆಯೇ ದೇವರ ಕೋಪಕ್ಕೆ ಗುರಿಯಾಗಿದ್ದೆವು."]},{"type":"verse","number":4,"content":["ಆದರೆ",{"noteId":44},"ಕರುಣಾನಿಧಿಯಾಗಿರುವ ದೇವರು",{"noteId":45},"ನಮ್ಮನ್ನು ಪ್ರೀತಿಸಿದ ಮಹಾ ಪ್ರೀತಿಯ ನಿಮಿತ್ತ,"]},{"type":"verse","number":5,"content":["ಅಪರಾಧಗಳ ದೆಸೆಯಿಂದ",{"noteId":46},"ಸತ್ತವರಾಗಿದ್ದ ನಮ್ಮನ್ನು ಕ್ರಿಸ್ತನೊಂದಿಗೆ ಬದುಕಿಸಿದನು.",{"noteId":47},"ಕೃಪೆಯಿಂದಲೇ ನೀವು ರಕ್ಷಣೆ ಹೊಂದಿದವರಾಗಿದ್ದೀರಿ."]},{"type":"verse","number":6,"content":["ಆತನು ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ ನಮ್ಮೊಂದಿಗಿರುವ",{"noteId":48},"ದಯೆಯ ಮೂಲಕ ತನ್ನ ಅಪಾರವಾದ ಕೃಪಾತಿಶಯವನ್ನು"]},{"type":"verse","number":7,"content":["ಮುಂದಿನ ಯುಗಗಳಲ್ಲಿ ನಮಗೆ ತೋರಿಸಬೇಕೆಂದು ಕ್ರಿಸ್ತಯೇಸುವಿನಲ್ಲಿರುವ ನಮ್ಮನ್ನು ಆತನೊಂದಿಗೆ ಎಬ್ಬಿಸಿ,",{"noteId":49},"ಪರಲೋಕದಲ್ಲಿ ಯೇಸುಕ್ರಿಸ್ತನೊಂದಿಗೆ ನಮ್ಮನ್ನು ಕೂರಿಸಿದ್ದಾನೆ."]},{"type":"verse","number":8,"content":[{"noteId":50},"ನಂಬಿಕೆಯ ಮೂಲಕ ಕೃಪೆಯಿಂದಲೇ ನೀವು ರಕ್ಷಣೆ ಹೊಂದಿದವರಾಗಿದ್ದೀರಿ.",{"noteId":51},"ಈ ರಕ್ಷಣೆಯು ನಿಮ್ಮಿಂದುಂಟಾದದ್ದಲ್ಲ,",{"noteId":52},"ಅದು ದೇವರ ದಾನವೇ."]},{"type":"verse","number":9,"content":[{"noteId":53},"ಈ ರಕ್ಷಣೆಯೂ ಪುಣ್ಯಕ್ರಿಯೆಗಳಿಂದ ಉಂಟಾದದ್ದಲ್ಲ,",{"noteId":54},"ಆದ್ದರಿಂದ ಹೊಗಳಿಕೊಳ್ಳುವುದಕ್ಕೆ ಯಾರಿಗೂ ಆಸ್ಪದವಿಲ್ಲ."]},{"type":"verse","number":10,"content":[{"noteId":55},"ನಾವಾದರೋ ದೇವರ ಕಲಾಕೃತಿಯಾಗಿದ್ದೇವೆ,",{"noteId":56},"ದೇವರು ಮೊದಲೇ ನಮಗಾಗಿ ಸಂಕಲ್ಪಿಸಿದ್ದ",{"noteId":57},"ಸತ್ಕಾರ್ಯಗಳನ್ನು ಮಾಡುವವರಾಗಿ ಬದುಕಬೇಕೆಂದು ಯೇಸು ಕ್ರಿಸ್ತನಲ್ಲಿ ಸೃಷ್ಟಿಸಲ್ಪಟ್ಟಿದ್ದೇವೆ."]},{"type":"heading","content":["ಕ್ರಿಸ್ತನಲ್ಲಿ ಒಂದೇ ಜನಾಂಗ"]},{"type":"verse","number":11,"content":["ಆದಕಾರಣ ಹಿಂದೊಮ್ಮೆ ನೀವು ಜನ್ಮದಿಂದ ಅನ್ಯಜನರಾಗಿದ್ದೀರಿ ಎಂಬುದು ನಿಮಗೆ ನೆನಪಿರಲಿ. ಶರೀರದಲ್ಲಿ ಮನುಷ್ಯನಿಂದ",{"noteId":58},"ಸುನ್ನತಿಯನ್ನು ಮಾಡಿಸಿಕೊಂಡು ಸುನ್ನತಿಯವರೆನ್ನಿಸಿಕೊಳ್ಳುವವರಿಂದ ‘ಸುನ್ನತಿಯಿಲ್ಲದವರು’ ಎಂದು ಕರೆಯಲ್ಪಟ್ಟಿದ್ದೀರಿ."]},{"type":"verse","number":12,"content":["ಅಂದು",{"noteId":59},"ನೀವು ಕ್ರಿಸ್ತನಿಂದ ದೂರವಿದವರೂ,",{"noteId":60},"ಇಸ್ರಾಯೇಲ್ಯರ ಹಕ್ಕಿನಲ್ಲಿ ಪಾಲಿಲ್ಲದವರೂ,",{"noteId":61},"ವಾಗ್ದಾನಕ್ಕೆ ಸಂಬಂಧವಾದ ಒಡಂಬಡಿಕೆಗಳಲ್ಲಿ ಪರಕೀಯರೂ, ಯಾವ ನಿರೀಕ್ಷೆಯಿಲ್ಲದವರೂ ಮತ್ತು",{"noteId":62},"ಲೋಕದಲ್ಲಿ ದೇವರಿಲ್ಲದವರೂ ಆಗಿದ್ದಿರೆಂಬುದನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ."]},{"type":"verse","number":13,"content":["ಈಗಲಾದರೋ,",{"noteId":63},"ಮೊದಲು ದೂರವಾಗಿದ್ದ ನೀವು ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ",{"noteId":64},"ಆತನ ರಕ್ತದ ಮೂಲಕ ಸಮೀಪಸ್ಥರಾಗಿದ್ದೀರಿ."]},{"type":"verse","number":14,"content":[{"noteId":65},"ನಿಮ್ಮನ್ನು ಮತ್ತು ನಮ್ಮನ್ನು ಒಂದುಮಾಡಿದವನಾದ",{"noteId":66},"ಆತನೇ ನಮಗೆ ಶಾಂತಿದಾತನಾಗಿದ್ದಾನೆ. ಆತನು",{"noteId":67},"ವಿಧಿನಿಯಮಗಳಿಂದ ಕೂಡಿದ್ದ ಆಜ್ಞೆಗಳುಳ್ಳ ಧರ್ಮಶಾಸ್ತ್ರವನ್ನು ನಿರರ್ಥಕಗೊಳಿಸಿ, ನಮ್ಮನ್ನು ಅಗಲಿಸಿದ್ದ ಹಗೆತನವೆಂಬ ಅಡ್ಡಗೋಡೆಯನ್ನು ತನ್ನ ಶರೀರದಿಂದಲೇ ಕೆಡವಿಹಾಕಿದ್ದಾನೆ."]},{"type":"verse","number":15,"content":["ಆತನು ಸಮಾಧಾನವನ್ನುಂಟು ಮಾಡುವವನಾಗಿ, ಉಭಯರನ್ನೂ ತನ್ನಲ್ಲಿ",{"noteId":68},"ಒಂದುಗೂಡಿಸಿ ನೂತನ ಮಾನವನನ್ನಾಗಿ ನಿರ್ಮಿಸಿದ್ದಾನೆ."]},{"type":"verse","number":16,"content":["ನಮ್ಮ ಮೇಲೆ ಇದ್ದ ಹಗೆತನವನ್ನು ತನ್ನ ಶಿಲುಬೆಯ ಮೇಲೆ",{"noteId":69},"ಇಲ್ಲವಾಗಿಸಿ,",{"noteId":70},"ಆ ಶಿಲುಬೆಯ ಮೂಲಕ ಉಭಯರನ್ನೂ ಒಂದೇ ಶರೀರವನ್ನಾಗಿ ಮಾಡಿ ದೇವರೊಂದಿಗೆ ಸಂಧಾನಪಡಿಸಿದ್ದಾನೆ."]},{"type":"verse","number":17,"content":["ಇದಲ್ಲದೆ ಆತನು ಬಂದು ದೂರವಾಗಿದ್ದ ನಿಮಗೂ ಮತ್ತು ಸಮೀಪವಾಗಿದ್ದವರಿಗೂ ಸಮಾಧಾನವನ್ನು ಸಾರಿದನು."]},{"type":"verse","number":18,"content":["ಇದರಿಂದ",{"noteId":71},"ಆತನ ಮೂಲಕ ಉಭಯತ್ರರು",{"noteId":72},"ಒಂದೇ ಆತ್ಮನಲ್ಲಿ",{"noteId":73},"ತಂದೆಯ ಬಳಿಗೆ",{"noteId":74},"ಪ್ರವೇಶಿಸಲು ಮಾರ್ಗವಾಯಿತು."]},{"type":"verse","number":19,"content":["ಹೀಗಿರಲಾಗಿ ನೀವು ಇನ್ನು ಮೇಲೆ",{"noteId":75},"ಪರದೇಶದವರೂ ಅನ್ಯರೂ ಆಗಿರದೇ",{"noteId":76},"ದೇವಜನರೊಂದಿಗೆ ಒಂದೇ ಸಂಸ್ಥಾನದವರೂ",{"noteId":77},"ದೇವರ ಮನೆಯವರೂ ಆಗಿದ್ದೀರಿ."]},{"type":"verse","number":20,"content":[{"noteId":78},"ಅಪೊಸ್ತಲರೂ",{"noteId":79},"ಪ್ರವಾದಿಗಳೂ ಎಂಬ",{"noteId":80},"ಅಡಿಪಾಯದ ಮೇಲೆ",{"noteId":81},"ನೀವೂ ಮಂದಿರದೋಪಾದಿಯಲ್ಲಿ ಕಟ್ಟಲ್ಪಟ್ಟಿದ್ದೀರಿ.",{"noteId":82},"ಯೇಸು ಕ್ರಿಸ್ತನೇ",{"noteId":83},"ಮುಖ್ಯವಾದ ಮೂಲೆಗಲ್ಲು."]},{"type":"verse","number":21,"content":[{"noteId":84},"ಆತನಲ್ಲಿ ಕಟ್ಟಡದ ಎಲ್ಲಾ ಭಾಗಗಳು ಒಂದಕ್ಕೊಂದು ಹೊಂದಿಕೆಯಾಗಿ, ಕಟ್ಟಡವು ವೃದ್ಧಿಯಾಗುತ್ತಾ ಕರ್ತನಲ್ಲಿ",{"noteId":85},"ಪರಿಶುದ್ಧ ದೇವಾಲಯವಾಗುತ್ತದೆ."]},{"type":"verse","number":22,"content":[{"noteId":86},"ಆತನಲ್ಲಿ ನೀವೂ ಸಹ ಪವಿತ್ರಾತ್ಮನ ಮೂಲಕವಾಗಿ",{"noteId":87},"ದೇವರಿಗೆ ವಾಸಸ್ಥಾನವಾಗುವುದಕ್ಕೆ ನಮ್ಮ ಜೊತೆಯಲ್ಲಿ ಕಟ್ಟಲ್ಪಡುತ್ತಾ ಇದ್ದೀರಿ."]}],"footnotes":[{"noteId":39,"caller":"+","text":"ಕೊಲೊ 1:21; 2:13:","reference":{"chapter":2,"verse":1}},{"noteId":40,"caller":"+","text":"ಎಫೆ 4:17,22; 5:8; ಕೊಲೊ 3:7; 1 ಕೊರಿ 6:7,8:","reference":{"chapter":2,"verse":2}},{"noteId":41,"caller":"+","text":"ಎಫೆ 6:12; ಯೋಹಾ 12:13:","reference":{"chapter":2,"verse":2}},{"noteId":42,"caller":"+","text":"ಗಲಾ 5:16:","reference":{"chapter":2,"verse":3}},{"noteId":43,"caller":"+","text":"ಕೀರ್ತ 51:5; ರೋಮಾ. 5:12. 2 ಪೇತ್ರ 2:14:","reference":{"chapter":2,"verse":3}},{"noteId":44,"cal