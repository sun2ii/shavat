{"translation":{"id":"kan_irv","name":"ಇಂಡಿಯನ್ ರಿವೈಜ್ಡ್ ವರ್ಸನ್ (IRV) - ಕನ್ನಡ - 2019","website":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseNotes":null,"shortName":"IRV","englishName":"Kannada Indian Revised Version Bible","language":"kan","textDirection":"ltr","sha256":"82cc741009376c81c4416c230a757b2e30ef49b2e4672f9831adcedfc26b865f","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31031,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"EPH","translationId":"kan_irv","name":"ಎಫೆಸದವರಿಗೆ","commonName":"ಎಫೆಸದವರಿಗೆ","title":"ಎಫೆಸದವರಿಗೆ","order":49,"numberOfChapters":6,"sha256":"eb830f2a1ad19b20931d89d0b5cda61d7b3fbd8d4a2aff7c5d5166cd507d8f11","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_irv/EPH/1.json","lastChapterNumber":6,"lastChapterApiLink":"/api/kan_irv/EPH/6.json","totalNumberOfVerses":153},"chapter":{"number":3,"content":[{"type":"heading","content":["ಅನ್ಯಜನರ ಬೋಧಕನಾದ ಪೌಲನು"]},{"type":"verse","number":1,"content":["ಹೀಗಿರುವುದರಿಂದ ಪೌಲನೆಂಬ ನಾನು ಅನ್ಯಜನರಾಗಿರುವ",{"noteId":88},"ನಿಮ್ಮ ನಿಮಿತ್ತ ಕ್ರಿಸ್ತ ಯೇಸುವಿನ",{"noteId":89},"ಸೆರೆಯಾಳಾಗಿದ್ದಾನೆ."]},{"type":"verse","number":2,"content":[{"noteId":90},"ನಿಮಗೋಸ್ಕರ ನಿರ್ವಹಿಸುವುದಕ್ಕಾಗಿ ದೇವರು ನನಗೆ",{"noteId":91},"ಕೃಪೆಯಾಗಿ ಕೊಟ್ಟ ಕಾರ್ಯಭಾರವನ್ನು ನೀವು ಕೇಳಿದ್ದೀರಿ,"]},{"type":"verse","number":3,"content":["ಆತನು ಮರ್ಮವನ್ನು",{"noteId":92},"ಪ್ರಕಟಣೆಯಿಂದ ನನಗೆ ತಿಳಿಯಪಡಿಸಿದನೆಂದು ಅದನ್ನು ಕುರಿತು",{"noteId":93},"ನಾನು ಮೊದಲೇ ನಿಮಗೆ ಸಂಕ್ಷಿಪ್ತವಾಗಿ ಬರೆದಿದ್ದೇನೆ."]},{"type":"verse","number":4,"content":["ಬರೆದದ್ದನ್ನು ನೀವು ಓದಿ ನೋಡಿದರೆ ಕ್ರಿಸ್ತನ ವಿಷಯವಾದ ಮರ್ಮವನ್ನು ಕುರಿತು",{"noteId":94},"ನನಗಿರುವ ಗ್ರಹಿಕೆಯನ್ನು ನೀವು ತಿಳಿದುಕೊಳ್ಳಬಹುದು."]},{"type":"verse","number":5,"content":["ಆ ಮರ್ಮವು ಈ ಕಾಲದಲ್ಲಿ ದೇವರ ಪರಿಶುದ್ಧ ಅಪೊಸ್ತಲರಿಗೂ ಪ್ರವಾದಿಗಳಿಗೂ ಪವಿತ್ರಾತ್ಮನಿಂದ ತಿಳಿಸಲ್ಪಟ್ಟಂತೆ ಬೇರೆ ಕಾಲಗಳಲ್ಲಿದ್ದ ಜನರಿಗೆ ತಿಳಿಸಲ್ಪಡಲಿಲ್ಲ."]},{"type":"verse","number":6,"content":["ಅದು ಯಾವುದೆಂದರೆ, ಅನ್ಯಜನರು ಸುವಾರ್ತೆಯ ಮೂಲಕ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿ",{"noteId":95},"ದೇವಜನರೊಂದಿಗೆ ಸಹಬಾಧ್ಯರೂ",{"noteId":96},"ಒಂದೇ ದೇಹದ ಅಂಗಗಳೂ, ವಾಗ್ದಾನದಲ್ಲಿ ಪಾಲುಗಾರರೂ ಆಗಿದ್ದಾರೆಂಬುದೇ."]},{"type":"verse","number":7,"content":["ದೇವರು",{"noteId":97},"ತನ್ನ ಶಕ್ತಿಯ ಪ್ರಯೋಗದ ಮೂಲಕ ನನಗೆ ಕೊಡಲ್ಪಟ್ಟ ಆತನ ಕೃಪಾದಾನಕ್ಕನುಸಾರವಾಗಿ",{"noteId":98},"ನಾನು ಈ ಸುವಾರ್ತೆಗೆ ಸೇವಕನಾದೆನು."]},{"type":"verse","number":8,"content":["ಕ್ರಿಸ್ತನ",{"noteId":99},"ಅಗಮ್ಯವಾದ ಐಶ್ವರ್ಯದ ಸುವಾರ್ತೆಯನ್ನು",{"noteId":100},"ಅನ್ಯಜನರಿಗೆ ಸಾರುವ ಹಾಗೆಯೂ"]},{"type":"verse","number":9,"content":["ಹಾಗೂ",{"noteId":101},"ಸಮಸ್ತವನ್ನು ಸೃಷ್ಟಿಸಿದ ದೇವರಲ್ಲಿ",{"noteId":102},"ಆದಿಯಿಂದ ಗುಪ್ತವಾಗಿದ ಮರ್ಮದ ಯೋಜನೆಯನ್ನು ಎಲ್ಲಾರಿಗೂ ತಿಳಿಸುವಂತಹ ಕೃಪೆಯು",{"noteId":103},"ದೇವಜನರೊಳಗೆ ಅತ್ಯಲ್ಪನಾದ ನನಗೆ ಕೊಡಲ್ಪಟ್ಟಿತು."]},{"type":"verse","number":10,"content":[{"noteId":104},"ದೇವರು ನಮ್ಮ ಕರ್ತನಾದ ಕ್ರಿಸ್ತಯೇಸುವಿನಲ್ಲಿ ಮಾಡಿದ",{"noteId":105},"ನಿತ್ಯಸಂಕಲ್ಪದ ಮೇರೆಗೆ ತನ್ನ",{"noteId":106},"ನಾನಾ ವಿಧವಾದ ಜ್ಞಾನವು, ಪರಲೋಕದಲ್ಲಿ",{"noteId":107},"ರಾಜತ್ವಗಳಿಗೂ, ಅಧಿಕಾರಗಳಿಗೂ ಈಗ ಸಭೆಯ ಮೂಲಕ ಗೊತ್ತಾಗಬೇಕೆಂದು ಉದ್ದೇಶಿಸಿದನು."]},{"type":"verse","number":12,"content":[{"noteId":108},"ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ಸೇರುವುದಕ್ಕೆ",{"noteId":109},"ನಮಗಿರುವ ಭರವಸೆಯೂ ಧೈರ್ಯವೂ ಕ್ರಿಸ್ತನಲ್ಲಿ ಇಟ್ಟಿರುವ ನಂಬಿಕೆಯ ಮೂಲಕ ಆತನಲ್ಲಿಯೇ ನಮಗಿದೆ."]},{"type":"verse","number":13,"content":["ಆದ್ದರಿಂದ",{"noteId":110},"ನಿಮ್ಮ ನಿಮಿತ್ತ ನನಗೆ ಉಂಟಾದ ಕಷ್ಟಗಳನ್ನು ನೋಡಿ ನೀವು ಧೈರ್ಯಗೆಡಬಾರದೆಂದು ನಿಮ್ಮನ್ನು ಬೇಡಿಕೊಳ್ಳುತ್ತೇನೆ.",{"noteId":111},"ಈ ಕಷ್ಟಗಳು ನಿಮಗೆ ಘನತೆಯನ್ನು ಉಂಟುಮಾಡುತ್ತವೆ."]},{"type":"heading","content":["ಎಫೆಸದವರಿಗಾಗಿ ಪ್ರಾರ್ಥನೆ"]},{"type":"verse","number":14,"content":["ಹೀಗಿರಲಾಗಿ",{"noteId":112},"ಯಾವ ತಂದೆಯಿಂದ ಭೂಪರಲೋಕಗಳಲ್ಲಿರುವ ಪ್ರತಿ ಜನವೂ ಹೆಸರುಗೊಂಡಿರುವುದೋ ಆ ತಂದೆಯ ಮುಂದೆ ನಾನು ಮೊಣಕಾಲೂರಿಕೊಂಡು,"]},{"type":"verse","number":16,"content":["ನೀವು ದೇವರಾತ್ಮನ ಮೂಲಕ ಆಂತರ್ಯದಲ್ಲಿ",{"noteId":113},"ವಿಶೇಷಬಲವನ್ನು ಹೊಂದುವಂತೆಯೂ,"]},{"type":"verse","number":17,"content":[{"noteId":114},"ಕ್ರಿಸ್ತನು ನಿಮ್ಮ ನಂಬಿಕೆಯ ಮೂಲಕ ನಿಮ್ಮ ಹೃದಯಗಳಲ್ಲಿ ವಾಸಮಾಡುವಂತೆಯೂ, ಆತನು",{"noteId":115},"ತನ್ನ ಮಹಿಮಾತಿಶಯದ ಪ್ರಕಾರ ಅನುಗ್ರಹಿಸಲಿ."]},{"type":"verse","number":18,"content":[{"noteId":116},"ನೀವು ದೇವರ ಪ್ರೀತಿಯಲ್ಲಿ ನೆಲೆಯಾಗಿ ನಿಂತು, ದೇವಜನರೆಲ್ಲರೊಂದಿಗೆ ಅದರ ಅಗಲ, ಉದ್ದ, ಎತ್ತರ, ಆಳ ಎಷ್ಟೆಂಬುದನ್ನು ಗ್ರಹಿಸುವುದಕ್ಕೆ ಶಕ್ತರಾಗುವಂತೆಯೂ,"]},{"type":"verse","number":19,"content":["ಬುದ್ಧಿಗಿಂತಲೂ ಮಿಗಿಲಾಗಿರುವ ಕ್ರಿಸ್ತನ ಪ್ರೀತಿಯನ್ನು ತಿಳಿದುಕೊಂಡು,",{"noteId":117},"ದೇವರ ಸಂಪೂರ್ಣತೆಯ ಮಟ್ಟಿಗೂ ಪರಿಪೂರ್ಣರಾಗುವ ಹಾಗೆ ದೇವರು ನಿಮಗೆ ದಯಪಾಲಿಸಲಿ ಎಂದು ಆತನನ್ನು ಬೇಡಿಕೊಳ್ಳುತ್ತೇನೆ."]},{"type":"verse","number":20,"content":[{"noteId":118},"ನಮ್ಮಲ್ಲಿ ಕಾರ್ಯಸಾಧಿಸುವ ತನ್ನ ಈ ಶಕ್ತಿಯ ಪ್ರಕಾರ",{"noteId":119},"ನಾವು ಬೇಡುವುದಕ್ಕಿಂತಲೂ ಯೋಚಿಸುವುದಕ್ಕಿಂತಲೂ ಅತ್ಯಧಿಕವಾದದ್ದನ್ನು ಮಾಡಲು ಶಕ್ತನಾದ ದೇವರಿಗೆ"]},{"type":"verse","number":21,"content":[{"noteId":120},"ಸಭೆಯಲ್ಲಿಯೂ ಕ್ರಿಸ್ತ ಯೇಸುವಿನಲ್ಲಿಯೂ ತಲತಲಾಂತರಕ್ಕೂ ಯುಗಯುಗಾಂತರಕ್ಕೂ ಮಹಿಮೆಯಾಗಲಿ. ಆಮೆನ್."]}],"footnotes":[{"noteId":88,"caller":"+","text":"ಎಫೆ 3:13; ಕೊಲೊ 1:24:","reference":{"chapter":3,"verse":1}},{"noteId":89,"caller":"+","text":"ಎಫೆ 4:1; ಅ. ಕೃ. 23:18. ಫಿಲಿ. 1:7. 2 ತಿಮೊ. 1:8 ಇತ್ಯಾದಿ.","reference":{"chapter":3,"verse":1}},{"noteId":90,"caller":"+","text":"ಎಫೆ 1:10; ಕೊಲೊ 1:25:","reference":{"chapter":3,"verse":2}},{"noteId":91,"caller":"+","text":"ವ. 7 ನೋಡಿರಿ.","reference":{"chapter":3,"verse":2}},{"noteId":92,"caller":"+","text":"ಅ. ಕೃ. 22:17,21; 26:18. ಗಲಾ. 1:12; 2 ಕೊರಿ 12:1 ನೋಡಿರಿ.","reference":{"chapter":3,"verse":3}},{"noteId":93,"caller":"+","text":"ಎಫೆ 1:9, 10 ನೋಡಿರಿ.","reference":{"chapter":3,"verse":3}},{"noteId":94,"caller":"+","text":"2 ಕೊರಿ 11:6 ನೋಡಿರಿ.","reference":{"chapter":3,"verse":4}},{"noteId":95,"caller":"+","text":"ಗಲಾ. 3:29 ನೋಡಿರಿ. ಯೆಹೂದ್ಯರೊಂದಿಗೆ","reference":{"chapter":3,"verse":6}},{"noteId":96,"caller":"+","text":"ಎಫೆ 2:16:","reference":{"chapter":3,"verse":6}},{"noteId":97,"caller":"+","text":"ಎಫೆ 3:20; 1:19 ನೋಡಿರಿ.","reference":{"chapter":3,"verse":7}},{"noteId":98,"caller":"+","text":"ಕೊಲೊ 1:23,25. 2 ಕೊರಿ 3:6 ನೋಡಿರಿ.","reference":{"chapter":3,"verse":7}},{"noteId":99,"caller":"+","text":"ಎಫೆ 1:18; ರೋಮಾ. 2:4; 11:33:","reference":{"chapter":3,"verse":8}},{"noteId":100,"caller":"+","text":"ಅ. ಕೃ. 9:15:","reference":{"chapter":3,"verse":8}},{"noteId":101,"caller":"+","text":"ಎಫೆ 3:2,3:","reference":{"chapter":3,"verse":9}},{"noteId":102,"caller":"+","text":"ಕೊಲೊ 1:26:","reference":{"chapter":3,"verse":9}},{"noteId":103,"caller":"+","text":"1 ಕೊರಿ 15:9:","reference":{"chapter":3,"verse":9}},{"noteId":104,"caller":"+","text":"-11 ಎಫೆ 1:11:","reference":{"chapter":3,"verse":10}},{"noteId":105,"caller":"+","text":"-11 ಅಥವಾ ನಿತ್ಯವಾದ ಉದ್ದೇಶದ ಪ್ರಕಾರ.","reference":{"chapter":3,"verse":10}},{"noteId":106,"caller":"+","text":"-11 ರೋಮಾ. 11:33:","reference":{"chapter":3,"verse":10}},{"noteId":107,"caller":"+","text":"-11 ಎಫೆ 1:21. ಎಫೆ 6:12:","reference":{"chapter":3,"verse":10}},{"noteId":108,"caller":"+","text":"ಎಫೆ 2:18:","reference":{"chapter":3,"verse":12}},{"noteId":109,"caller":"+","text":"ಇಬ್ರಿ. 4:16; 10:19:","reference":{"chapter":3,"verse":12}},{"noteId":110,"caller":"+","text":"ವ. 1 ನೋಡಿರಿ.","reference":{"chapter":3,"verse":13}},{"noteId":111,"caller":"+","text":"2 ಕೊರಿ 1:6:","reference":{"chapter":3,"verse":13}},{"noteId":112,"caller":"+","text":"-15 ಅಥವಾ, ಪ್ರತಿ ಜನವೂ ತನ್ನ ಮೂಲಜನಕನಿಂದ ಹೆಸರು ತೆಗೆದುಕೊಳ್ಳುತ್ತದಷ್ಟೆ; ಯಾವಾತನು ದೇವಜನರಾದ ನಮಗೆ ಮೂಲ ಜನಕನಾಗಿದ್ದಾನೋ.","reference":{"chapter":3,"verse":14}},{"noteId":113,"caller":"+","text":"ಎಫೆ 6:10; ಫಿಲಿ. 4:13; ಕೊಲೊ 1:11:","reference":{"chapter":3,"verse":16}},{"noteId":114,"caller":"+","text":"ಎಫೆ 2:22:","reference":{"chapter":3,"verse":17}},{"noteId":115,"caller":"+","text":"ವ. 8:","reference":{"chapter":3,"verse":17}},{"noteId":116,"caller":"+","text":"ಅಥವಾ, ಆ ಸತ್ಯರ್ಥದ.","reference":{"chapter":3,"verse":18}},{"noteId":117,"caller":"+","text":"ಎಫೆ 1:23; ಕೊಲೊ 2:10:","reference":{"chapter":3,"verse":19}},{"noteId":118,"caller":"+","text":"ವ. 7:","reference":{"chapter":3,"verse":20}},{"noteId":119,"caller":"+","text":"2 ಕೊರಿ 9:8:","reference":{"chapter":3,"verse":20}},{"noteId":120,"caller":"+","text":"ರೋಮಾ. 11:36:","reference":{"chapter":3,"verse":21}}]},"thisChapterLink":"/api/kan_irv/EPH/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_irv/EPH/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_irv/EPH/2.js