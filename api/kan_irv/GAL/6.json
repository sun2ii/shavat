{"translation":{"id":"kan_irv","name":"ಇಂಡಿಯನ್ ರಿವೈಜ್ಡ್ ವರ್ಸನ್ (IRV) - ಕನ್ನಡ - 2019","website":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseNotes":null,"shortName":"IRV","englishName":"Kannada Indian Revised Version Bible","language":"kan","textDirection":"ltr","sha256":"82cc741009376c81c4416c230a757b2e30ef49b2e4672f9831adcedfc26b865f","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31031,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"GAL","translationId":"kan_irv","name":"ಗಲಾತ್ಯದವರಿಗೆ","commonName":"ಗಲಾತ್ಯದವರಿಗೆ","title":"ಗಲಾತ್ಯದವರಿಗೆ","order":48,"numberOfChapters":6,"sha256":"325db5aa8a135a0cacc9a3ba8387be180e9c786fe23793dac4f97e575cf4b968","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_irv/GAL/1.json","lastChapterNumber":6,"lastChapterApiLink":"/api/kan_irv/GAL/6.json","totalNumberOfVerses":148},"chapter":{"number":6,"content":[{"type":"heading","content":["ಪರಸ್ಪರ ಭಾರವನ್ನು ಹೊತ್ತುಕೊಳ್ಳಿರಿ"]},{"type":"verse","number":1,"content":["ಸಹೋದರರೇ,",{"noteId":155},"ನಿಮ್ಮಲ್ಲಿ ಯಾರಾದರೂ ಯಾವುದಾದರೂ ಪಾಪದಲ್ಲಿ ಸಿಕ್ಕಿಹಾಕಿಕೊಂಡಿದ್ದರೆ",{"noteId":156},"ಅಂಥವರನ್ನು ಆತ್ಮಭರಿತರಾದ ನೀವು ಶಾಂತಭಾವದಿಂದ ತಿದ್ದಿ ಸರಿಮಾಡಿರಿ. ನೀವಾದರೂ ಶೋಧನೆಗೆ ಒಳಗಾಗದಂತೆ ನಿಮ್ಮ ವಿಷಯದಲ್ಲಿ ಎಚ್ಚರಿಕೆಯಾಗಿರಿ."]},{"type":"verse","number":2,"content":["ಒಬ್ಬರು ಮತ್ತೊಬ್ಬರ ಭಾರವನ್ನು ಹೊತ್ತುಕೊಳ್ಳಲಿ, ಹೀಗೆ ಕ್ರಿಸ್ತನ",{"noteId":157},"ನೀತಿನಿಯಮಗಳನ್ನು ನೆರವೇರಿಸಿರಿ."]},{"type":"verse","number":3,"content":[{"noteId":158},"ಯಾವನಾದರೂ ಅಲ್ಪನಾಗಿದ್ದು ತಾನು ದೊಡ್ಡವನೆಂದು ಭಾವಿಸಿಕೊಂಡರೆ ತನ್ನನ್ನು ತಾನೇ ಮೋಸಗೊಳಿಸಿಕೊಳ್ಳುವನಾಗಿದ್ದಾನೆ."]},{"type":"verse","number":4,"content":[{"noteId":159},"ಪ್ರತಿಯೊಬ್ಬನು ತಾನು ಮಾಡಿದ ಕೆಲಸವನ್ನು ಪರೀಕ್ಷಿಸಿಕೊಳ್ಳಲಿ. ಆಗ ಅವನು ತನ್ನ ನಿಮಿತ್ತದಿಂದ ಹೆಚ್ಚಳಪಡಬಹುದೇ ಹೊರತು ಮತ್ತೊಬ್ಬನೊಂದಿಗೆ ಹೋಲಿಸಿಕೊಂಡು ಹೆಚ್ಚಳಪಡಬೇಕಾಗಿರುವುದಿಲ್ಲ."]},{"type":"verse","number":5,"content":["ಏಕೆಂದರೆ",{"noteId":160},"ಪ್ರತಿಯೊಬ್ಬನು ತನ್ನ ಸ್ವಂತ ಹೊರೆಯನ್ನು ತಾನೇ ಹೊತ್ತುಕೊಳ್ಳಬೇಕು."]},{"type":"verse","number":6,"content":[{"noteId":161},"ದೇವರ ವಾಕ್ಯವನ್ನು ಕಲಿಯುವವನು, ಅದನ್ನು ಕಲಿಸುವವನಿಗೆ ತನ್ನಲ್ಲಿರುವ ಎಲ್ಲಾ ಮೇಲುಗಳಲ್ಲಿಯೂ ಪಾಲನ್ನು ಕೊಡಬೇಕು."]},{"type":"verse","number":7,"content":["ಮೋಸಹೋಗಬೇಡಿರಿ.",{"noteId":162},"ದೇವರನ್ನು ಅಪಹಾಸ್ಯ ಮಾಡಲಾಗುವುದಿಲ್ಲ.",{"noteId":163},"ಮನುಷ್ಯನು ತಾನು ಏನು ಬಿತ್ತುತ್ತಾನೋ ಅದನ್ನೇ ಕೊಯ್ಯಬೇಕು."]},{"type":"verse","number":8,"content":["ತನ್ನ",{"noteId":164},"ಶರೀರಭಾವವನ್ನು ಕುರಿತು ಬಿತ್ತುವವನು",{"noteId":165},"ಆ ಭಾವದಿಂದ ನಾಶವನ್ನು ಕೊಯ್ಯುವನು.",{"noteId":166},"ಆತ್ಮನ ಕುರಿತಾಗಿ ಬಿತ್ತುವವನು ಆತ್ಮನಿಂದ ನಿತ್ಯಜೀವವನ್ನು ಕೊಯ್ಯುವನು."]},{"type":"verse","number":9,"content":[{"noteId":167},"ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವುದರಲ್ಲಿ ಬೇಸರಗೊಳ್ಳದೇ ಇರೋಣ. ಏಕೆಂದರೆ ಮನಗುಂದದಿದ್ದರೆ ತಕ್ಕ ಸಮಯದಲ್ಲಿ ಬೆಳೆಯನ್ನು ಕೊಯ್ಯುವೆವು."]},{"type":"verse","number":10,"content":["ಆದ್ದರಿಂದ ಅವಕಾಶ ಸಿಕ್ಕಿದಾಗಲೆಲ್ಲಾ ಎಲ್ಲರಿಗೂ ಒಳ್ಳೆಯದನ್ನು ಮಾಡೋಣ, ವಿಶೇಷವಾಗಿ",{"noteId":168},"ಒಂದೇ ಮನೆಯವರಂತಿರುವ ಕ್ರೈಸ್ತ ವಿಶ್ವಾಸಿಗಳಿಗೆ ಮಾಡೋಣ."]},{"type":"heading","content":["ಕಡೆ ಎಚ್ಚರಿಕೆಗಳು ಮತ್ತು ವಂದನೆಗಳು"]},{"type":"verse","number":11,"content":["ಇಗೋ ನೋಡಿರಿ,",{"noteId":169},"ಸ್ವಂತ ಕೈಯಿಂದ ಎಂಥಾ ದೊಡ್ಡ ಅಕ್ಷರಗಳಲ್ಲಿ ನಿಮಗೆ ಬರೆಯುತ್ತಾ ಇದ್ದೇನೆ."]},{"type":"verse","number":12,"content":["ದೈಹಿಕವಾಗಿ ಪ್ರಶಂಸೆಯನ್ನು ಹೊಂದಬೇಕೆಂದಿರುವವರು ಸುನ್ನತಿ ಮಾಡಿಸಿಕೊಳ್ಳಿರಿ ಎಂಬುದಾಗಿ ನಿಮ್ಮನ್ನು ಒತ್ತಾಯಿಸುತ್ತಾರೆ.",{"noteId":170},"ಏಕೆಂದರೆ ಕ್ರಿಸ್ತನ ಶಿಲುಬೆಯ ದೆಸೆಯಿಂದ ತಮಗೆ ಹಿಂಸೆಯಾಗಬಾರದೆಂಬುದೇ ಅವರ ಉದ್ದೇಶ."]},{"type":"verse","number":13,"content":["ಸುನ್ನತಿ ಮಾಡಿಸಿಕೊಂಡವರೇ ಧರ್ಮಶಾಸ್ತ್ರವನ್ನು ಕೈಕೊಂಡು ನಡೆಯುತ್ತಿಲ್ಲವಲ್ಲಾ. ಅವರು ನಿಮ್ಮ ಶರೀರದ ವಿಷಯದಲ್ಲಿ ಹೆಚ್ಚಳಪಡುವುದಕ್ಕಾಗಿ ನಿಮಗೆ ಸುನ್ನತಿಯಾಗಬೇಕೆಂದು ಅಪೇಕ್ಷಿಸುತ್ತಾರೆ."]},{"type":"verse","number":14,"content":[{"noteId":171},"ನನಗಾದರೋ ನಮ್ಮ ಕರ್ತನಾದ ಯೇಸು ಕ್ರಿಸ್ತನ ಶಿಲುಬೆಯ ವಿಷಯದಲ್ಲಿಯೇ ಹೊರತು ಬೇರೆ ಯಾವ ವಿಷಯದಲ್ಲಿಯೂ ಹೆಚ್ಚಳಪಡುವುದು ಬೇಕಾಗಿಲ್ಲ. ಆತನ ಮೂಲಕ",{"noteId":172},"ನಾನು ಲೋಕಕ್ಕೂ, ಲೋಕವು ನನಗಾಗಿಯೂ ಶಿಲುಬೆಗೆ ಹಾಕಿಕೊಂಡು ಸತ್ತಿತು."]},{"type":"verse","number":15,"content":[{"noteId":173},"ಸುನ್ನತಿ ಮಾಡಿಸಿಕೊಳ್ಳುವುದೋ ಅಥವಾ ಮಾಡಿಸಿಕೊಳ್ಳದಿರುವುದೋ ಏನು ಅಲ್ಲ, ಆದರೆ",{"noteId":174},"ಹೊಸ ಸೃಷ್ಟಿಯಾಗುವುದೇ ಪ್ರಮುಖವಾದುದು."]},{"type":"verse","number":16,"content":["ಈ ನಿಯಮಗಳನ್ನು ಸರಿಯಾಗಿ ನಡೆಯುವವರೆಲ್ಲರಿಗೂ ಮತ್ತು ದೇವರ",{"noteId":175},"ಇಸ್ರಾಯೇಲ್ಯರಿಗೆ ಶಾಂತಿಯೂ, ಕರುಣೆಯೂ ಉಂಟಾಗಲಿ."]},{"type":"verse","number":17,"content":["ಇನ್ನು ಮೇಲೆ ಯಾರೂ ನನಗೆ ತೊಂದರೆಪಡಿಸಬಾರದು,",{"noteId":176},"ನನ್ನ ದೇಹದಲ್ಲಿ ಯೇಸುಕ್ರಿಸ್ತನ ಗುರುತುಗಳನ್ನು ಮುದ್ರಿಸಿಕೊಂಡಿದ್ದೇನೆ."]},{"type":"verse","number":18,"content":["ಸಹೋದರರೇ,",{"noteId":177},"ನಮ್ಮ ಕರ್ತನಾದ ಯೇಸು ಕ್ರಿಸ್ತನ ಕೃಪೆಯು",{"noteId":178},"ನಿಮ್ಮ ಆತ್ಮದೊಂದಿಗಿರಲಿ. ಆಮೆನ್."]}],"footnotes":[{"noteId":155,"caller":"+","text":"2 ಕೊರಿ 2:7, ಇಬ್ರಿ. 12:13, ಯಾಕೋಬ. 5:19","reference":{"chapter":6,"verse":1}},{"noteId":156,"caller":"+","text":"ರೋಮಾ. 15:1","reference":{"chapter":6,"verse":1}},{"noteId":157,"caller":"+","text":"ಧರ್ಮಶಾಸ್ತ್ರವನ್ನು, ಗಲಾ. 5:14","reference":{"chapter":6,"verse":2}},{"noteId":158,"caller":"+","text":"1 ಕೊರಿ 3:18","reference":{"chapter":6,"verse":3}},{"noteId":159,"caller":"+","text":"1 ಕೊರಿ 11:28, 2 ಕೊರಿ 13:5","reference":{"chapter":6,"verse":4}},{"noteId":160,"caller":"+","text":"ರೋಮಾ. 14:12","reference":{"chapter":6,"verse":5}},{"noteId":161,"caller":"+","text":"ರೋಮಾ. 15:27, 1 ಕೊರಿ 9:11","reference":{"chapter":6,"verse":6}},{"noteId":162,"caller":"+","text":"ಯೋಬ. 13:9","reference":{"chapter":6,"verse":7}},{"noteId":163,"caller":"+","text":"2 ಕೊರಿ 9:6","reference":{"chapter":6,"verse":7}},{"noteId":164,"caller":"+","text":"ಶರೀರಭಾವದಲ್ಲಿ, ಹೋಶೇ. 8:7, ಯೋಬ. 4:8","reference":{"chapter":6,"verse":8}},{"noteId":165,"caller":"+","text":"ರೋಮಾ. 6:21","reference":{"chapter":6,"verse":8}},{"noteId":166,"caller":"+","text":"ಯಾಕೋಬ. 3:18","reference":{"chapter":6,"verse":8}},{"noteId":167,"caller":"+","text":"2 ಥೆಸ. 3:13, 1 ಕೊರಿ 15:58","reference":{"chapter":6,"verse":9}},{"noteId":168,"caller":"+","text":"ಎಫೆ 2:19, ಇಬ್ರಿ. 3:6","reference":{"chapter":6,"verse":10}},{"noteId":169,"caller":"+","text":"1 ಕೊರಿ 16:21","reference":{"chapter":6,"verse":11}},{"noteId":170,"caller":"+","text":"ಗಲಾ. 5:11","reference":{"chapter":6,"verse":12}},{"noteId":171,"caller":"+","text":"1 ಕೊರಿ 2:2, ಫಿಲಿ. 3:3, 7-8","reference":{"chapter":6,"verse":14}},{"noteId":172,"caller":"+","text":"ರೋಮಾ. 6:6","reference":{"chapter":6,"verse":14}},{"noteId":173,"caller":"+","text":"ರೋಮಾ. 2:28, ಗಲಾ. 5:6","reference":{"chapter":6,"verse":15}},{"noteId":174,"caller":"+","text":"ಯೋಹಾ 3:5-7, ರೋಮಾ. 6:4, 2 ಕೊರಿ 5:17","reference":{"chapter":6,"verse":15}},{"noteId":175,"caller":"+","text":"ಗಲಾ. 3:7-9,29; ರೋಮಾ. 2:29, 4:12, 9:6-8","reference":{"chapter":6,"verse":16}},{"noteId":176,"caller":"+","text":"ಯೆಶಾ 44:5, ಯೆಹೆ. 9:4, ಪ್ರಕ 13:16","reference":{"chapter":6,"verse":17}},{"noteId":177,"caller":"+","text":"ಫಿಲೆ. 25, ರೋಮಾ. 16:20","reference":{"chapter":6,"verse":18}},{"noteId":178,"caller":"+","text":"2 ತಿಮೊ. 4:22","reference":{"chapter":6,"verse":18}}]},"thisChapterLink":"/api/kan_irv/GAL/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_irv/EPH/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_irv/GAL/5.json","previousChapterAudioLinks":{},"numberOfVerses":18}