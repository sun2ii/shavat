{"translation":{"id":"kan_irv","name":"ಇಂಡಿಯನ್ ರಿವೈಜ್ಡ್ ವರ್ಸನ್ (IRV) - ಕನ್ನಡ - 2019","website":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseNotes":null,"shortName":"IRV","englishName":"Kannada Indian Revised Version Bible","language":"kan","textDirection":"ltr","sha256":"82cc741009376c81c4416c230a757b2e30ef49b2e4672f9831adcedfc26b865f","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31031,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"HEB","translationId":"kan_irv","name":"ಇಬ್ರಿಯರಿಗೆ","commonName":"ಇಬ್ರಿಯರಿಗೆ","title":"ಇಬ್ರಿಯರಿಗೆ","order":58,"numberOfChapters":13,"sha256":"54341e944774d1e5236bd8073fdc14d2c32e51630b03cc26b3e6c2fb30de0615","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_irv/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/kan_irv/HEB/13.json","totalNumberOfVerses":296},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":["ಆದುದರಿಂದ ಕ್ರಿಸ್ತನ ವಿಷಯವಾದ ಪ್ರಾಥಮಿಕ ಉಪದೇಶವನ್ನು ಬಿಟ್ಟು,",{"noteId":91},"ನಿರ್ಜೀವ ಕ್ರಿಯೆಗಳಿಂದ ಮಾನಸಾಂತರವೂ, ದೇವರಲ್ಲಿ ನಂಬಿಕೆಯೂ,",{"noteId":92},"ದೀಕ್ಷಾಸ್ನಾನಗಳ ಬೋಧನೆಯೂ,",{"noteId":93},"ಹಸ್ತಾರ್ಪಣೆಯೂ,",{"noteId":94},"ಸತ್ತವರಿಗೆ ಪುನರುತ್ಥಾನವೂ ಮತ್ತು",{"noteId":95},"ನಿತ್ಯವಾದ ನ್ಯಾಯತೀರ್ಪೂ ಉಂಟೆಂಬುದರ ಕುರಿತು ಪದೇಪದೇ ಅಸ್ತಿವಾರವನ್ನೆ ಹಾಕುತಿರದೆ ನಾವು ಪರಿಪಕ್ವತೆಯೆಡೆಗೆ",{"noteId":96},"ಸಾಗೋಣ."]},{"type":"verse","number":3,"content":["ದೇವರು ಅನುಮತಿಸುವುದಾದರೆ ನಾವು ಇವುಗಳನ್ನು ಮಾಡುವೆವು."]},{"type":"verse","number":4,"content":["ಒಂದು ಸಾರಿ",{"noteId":97},"ಬೆಳಕಿನಲ್ಲಿ ಸೇರಿದವರು ಸ್ವರ್ಗೀಯ",{"noteId":98},"ದಾನವನ್ನು ಅನುಭವಿಸಿದವರು,",{"noteId":99},"ಪವಿತ್ರಾತ್ಮನಲ್ಲಿ ಪಾಲುಗಾರರಾದವರು,"]},{"type":"verse","number":5,"content":["ದೇವರ ವಾಕ್ಯದ ಶ್ರೇಷ್ಠತೆಯನ್ನೂ ಮುಂದಣ ಯುಗದ ಶಕ್ತಿಯನ್ನೂ ಅನುಭವಿಸಿದವರು ಅದರಿಂದ ಹಿಂಜಾರಿಹೋದರೆ,"]},{"type":"verse","number":6,"content":[{"noteId":100},"ಅವರಲ್ಲಿ ತಿರುಗಿ ಮಾನಸಾಂತರವನ್ನು ಹುಟ್ಟಿಸುವುದು ಅಸಾಧ್ಯ, ಯಾಕೆಂದರೆ",{"noteId":101},"ಅವರು ತಾವಾಗಿಯೇ ದೇವರ ಮಗನನ್ನು ಪುನಃ ಶಿಲುಬೆಗೆ ಹಾಕುವವರೂ ಆತನನ್ನು ಬಹಿರಂಗವಾಗಿ ಅವಮಾನಪಡಿಸುವವರೂ ಆಗಿರುತ್ತಾರೆ."]},{"type":"verse","number":7,"content":["ಭೂಮಿಯು ತನ್ನ ಮೇಲೆ ಅನೇಕಾವರ್ತಿ ಸುರಿಯುವ ಮಳೆಯನ್ನು ಹೀರಿಕೊಂಡು, ಅದು ಯಾರ ನಿಮಿತ್ತವಾಗಿ ವ್ಯವಸಾಯ ಮಾಡಲ್ಪಡುತ್ತದೋ, ಅವರಿಗೆ ಅನುಕೂಲವಾದ ಬೆಳೆಯನ್ನು ಕೊಡುತ್ತದೆ, ಅದು ದೇವರ ಆಶೀರ್ವಾದವನ್ನು ಹೊಂದುತ್ತದೆ."]},{"type":"verse","number":8,"content":[{"noteId":102},"ಆದರೆ ಅದು ಮುಳ್ಳುಗಿಡಗಳನ್ನೂ ಕಳೆಗಳನ್ನೂ ಬೆಳೆಸಿದರೆ, ಅಯೋಗ್ಯವಾದದ್ದಾಗಿ ಶಾಪಕ್ಕೆ ಗುರಿಯಾಗುತ್ತದೆ.",{"noteId":103},"ಕೊನೆಗದು ಸುಡಲ್ಪಡುತ್ತದೆ."]},{"type":"verse","number":9,"content":["ಪ್ರಿಯರೇ, ಈ ರೀತಿಯಾಗಿ ನಾವು ಮಾತನಾಡಿದರೂ ನಿಮ್ಮ ವಿಷಯವಾಗಿಯೂ ರಕ್ಷಣೆಗೆ ಸಂಬಂಧಿಸಿದವುಗಳಲ್ಲಿಯೂ ನೀವು ಉತ್ತಮರಾಗಿದ್ದೀರೆಂದು ನಂಬಿದ್ದೇವೆ."]},{"type":"verse","number":10,"content":[{"noteId":104},"ನೀವು ದೇವಜನರಿಗೆ ಉಪಚಾರ ಮಾಡಿದ್ದೀರಿ, ಇನ್ನೂ ಮಾಡುತ್ತಾ ಇದ್ದಿರಿ. ಈ ಕೆಲಸವನ್ನು ಮತ್ತು ಇದರಲ್ಲಿ ನೀವು ಆತನ ನಾಮದ ಕಡೆಗೆ ತೋರಿಸಿದ ಪ್ರೀತಿಯನ್ನು",{"noteId":105},"ಆತನು ಮರೆಯುವುದಿಲ್ಲ, ಯಾಕೆಂದರೆ ದೇವರು ಅನೀತಿಯುಳ್ಳವನಲ್ಲ."]},{"type":"verse","number":11,"content":["ನಿರೀಕ್ಷೆಯ ಸಂಪೂರ್ಣ ನಿಶ್ಚಯತ್ವವನ್ನು ಹೊಂದುವುದಕ್ಕಾಗಿ ಅಂತ್ಯದವರೆಗೂ ನೀವು ಅದೇ",{"noteId":106},"ಶ್ರದ್ಧೆಯನ್ನು ತೋರಿಸಬೇಕೆಂದು ನಾನು ಬಹಳವಾಗಿ ಅಪೇಕ್ಷಿಸುತ್ತೇವೆ."]},{"type":"verse","number":12,"content":["ನೀವು ಸೋಮಾರಿಗಳಾಗಿರಬೇಕೆಂದು ಅಪೇಕ್ಷಿಸುವುದಿಲ್ಲ, ಬದಲಿಗೆ ನಂಬಿಕೆಯಿಂದಲೂ, ತಾಳ್ಮೆಯಿಂದಲೂ, ವಾಗ್ದಾನಗಳನ್ನು ಬಾಧ್ಯವಾಗಿ",{"noteId":107},"ಹೊಂದುವವರನ್ನು ಅನುಸರಿಸುವವರಾಗಬೇಕೆಂದು ಕೋರುತ್ತೇನೆ."]},{"type":"heading","content":["ದೇವರ ವಾಗ್ದಾನಗಳು ಎಷ್ಟು ಮಾತ್ರಕ್ಕೂ ತಪ್ಪುವುದಿಲ್ಲ"]},{"type":"verse","number":13,"content":["ದೇವರು ಅಬ್ರಹಾಮನಿಗೆ ವಾಗ್ದಾನ ಮಾಡಿದಾಗ ತನಗಿಂತಲೂ ಹೆಚ್ಚಿನವರು ಯಾರೂ ಇಲ್ಲದ್ದರಿಂದ",{"noteId":108},"ತನ್ನ ಮೇಲೆ ಆಣೆಯಿಟ್ಟು,"]},{"type":"verse","number":14,"content":["“ಖಂಡಿತವಾಗಿಯೂ ನಾನು ನಿನ್ನನ್ನು ಆಶೀರ್ವದಿಸುವೆನು. ನಿನ್ನ ಸಂತಾನವನ್ನು ಅಭಿವೃದ್ಧಿಪಡಿಸುವೆನು” ಎಂದು ಹೇಳಿದನಷ್ಟೆ."]},{"type":"verse","number":15,"content":["ಹೀಗೆ",{"noteId":109},"ಅಬ್ರಹಾಮನು ತಾಳ್ಮೆಯಿಂದ ಕಾದುಕೊಂಡಿದ್ದು ವಾಗ್ದಾನವನ್ನು ಪಡೆದುಕೊಂಡನು."]},{"type":"verse","number":16,"content":["ಮನುಷ್ಯರು ತಮಗಿಂತಲೂ ಹೆಚ್ಚಿನವನ ಮೇಲೆ ಆಣೆಯಿಡುತ್ತಾರಷ್ಟೆ,",{"noteId":110},"ಆಣೆಯನ್ನು ದೃಢಪಡಿಸಿದ ಮೇಲೆ ವಿವಾದವು ಅಂತ್ಯವಾಗುವುದು."]},{"type":"verse","number":17,"content":["ಹಾಗೆಯೇ ದೇವರು",{"noteId":111},"ತನ್ನ ಸಂಕಲ್ಪವು ಬದಲಾಗಲಾರದ್ದೆಂಬುದನ್ನು,",{"noteId":112},"ವಾಗ್ದಾನದ ಬಾಧ್ಯಸ್ಥರಿಗೆ ಬಹು ಸ್ಪಷ್ಟವಾಗಿ ತೋರಿಸಬೇಕೆಂದು ಆಣೆಯಿಟ್ಟು ಸ್ಥಿರಪಡಿಸಿದನು."]},{"type":"verse","number":18,"content":["ದೇವರ ವಾಗ್ದಾನ ಮತ್ತು ಆಣೆ ಇವೆರಡೂ ನಿಶ್ಚಲವಾದ ಆಧಾರಗಳು ಏಕೆಂದರೆ ದೇವರು ಸುಳ್ಳಾಡುವವನಲ್ಲ. ಅದುದರಿಂದ ಆಶ್ರಯವನ್ನು ಹೊಂದಬೇಕೆಂದು ಓಡಿಬಂದು,",{"noteId":113},"ನಮ್ಮ ಮುಂದೆ ಇಟ್ಟಿರುವ ನಿರೀಕ್ಷೆಯನ್ನು ಹಿಡಿದುಕೊಂಡವರಾದ ನಮಗೆ ಬಲವಾದ ಪ್ರೋತ್ಸಾಹ ಉಂಟಾಯಿತು."]},{"type":"verse","number":19,"content":[{"noteId":114},"ಆ ನಿರೀಕ್ಷೆಯು ನಮ್ಮ ಪ್ರಾಣಕ್ಕೆ ವಿಶ್ವಾಸಾರ್ಹವಾದದ್ದೂ ಸ್ಥಿರವಾದದ್ದೂ ಆದ",{"noteId":115},"ಲಂಗರವಾಗಿದೆ. ಅದು ಅತಿ ಪರಿಶುದ್ಧ ಸ್ಥಳದ",{"noteId":116},"ತೆರೆಯ ಒಳಗಡೆ ಪ್ರವೇಶಿಸುವಂಥದ್ದಾಗಿದೆ."]},{"type":"verse","number":20,"content":["ಅಲ್ಲಿಗೆ",{"noteId":117},"ಯೇಸು ಸದಾಕಾಲವೂ ಮೆಲ್ಕಿಜೆದೇಕನ ತರಹದ ಮಹಾಯಾಜಕನಾಗಿ,",{"noteId":118},"ನಮಗೋಸ್ಕರ ಮುಂಚಿತವಾಗಿಯೇ ಹೋಗಿ ಆ ಸಾನ್ನಿಧ್ಯವನ್ನು ಪ್ರವೇಶಿಸಿದ್ದಾನೆ."]}],"footnotes":[{"noteId":91,"caller":"+","text":"-2 ಇಬ್ರಿ. 9:14:","reference":{"chapter":6,"verse":1}},{"noteId":92,"caller":"+","text":"-2 ಅ. ಕೃ. 19:4,5.","reference":{"chapter":6,"verse":1}},{"noteId":93,"caller":"+","text":"-2 ಅ. ಕೃ. 8:17; 19:6:","reference":{"chapter":6,"verse":1}},{"noteId":94,"caller":"+","text":"-2 ಅ. ಕೃ. 17:31, 32:","reference":{"chapter":6,"verse":1}},{"noteId":95,"caller":"+","text":"-2 ಅ. ಕೃ. 10:42; 17:31; 2 ಕೊರಿ 5:10:","reference":{"chapter":6,"verse":1}},{"noteId":96,"caller":"+","text":"-2 ಇಬ್ರಿ. 5:12; ಫಿಲಿ. 3:12-14:","reference":{"chapter":6,"verse":1}},{"noteId":97,"caller":"+","text":"ಇಬ್ರಿ. 10:32:","reference":{"chapter":6,"verse":4}},{"noteId":98,"caller":"+","text":"ಯೋಹಾ 4:10; ಎಫೆ 2:8:","reference":{"chapter":6,"verse":4}},{"noteId":99,"caller":"+","text":"ಗಲಾ. 3:2, 5:","reference":{"chapter":6,"verse":4}},{"noteId":100,"caller":"+","text":"1 ಯೋಹಾ 5:16:","reference":{"chapter":6,"verse":6}},{"noteId":101,"caller":"+","text":"ಇಬ್ರಿ. 10:29:","reference":{"chapter":6,"verse":6}},{"noteId":102,"caller":"+","text":"ಯೆಶಾ 5:1-7; ಲೂಕ 13:6-9:","reference":{"chapter":6,"verse":8}},{"noteId":103,"caller":"+","text":"ಮಲಾ. 4:1; ಯೋಹಾ 15:6:","reference":{"chapter":6,"verse":8}},{"noteId":104,"caller":"+","text":"ರೋಮಾ. 15:31; 2 ಕೊರಿ 8:4; 9:1, 12; 2 ತಿಮೊ. 1:18; ಪ್ರಕ 2:19:","reference":{"chapter":6,"verse":10}},{"noteId":105,"caller":"+","text":"ಜ್ಞಾ. 19:17; ಮತ್ತಾ 10:42; 25:40; ಮಾರ್ಕ 9:41:","reference":{"chapter":6,"verse":10}},{"noteId":106,"caller":"+","text":"ರೋಮಾ. 5:2-5:","reference":{"chapter":6,"verse":11}},{"noteId":107,"caller":"+","text":"ಇಬ್ರಿ. 13:7; ಇಬ್ರಿ. 10:36; 13:7:","reference":{"chapter":6,"verse":12}},{"noteId":108,"caller":"+","text":"ಆದಿ 22:16, 17:","reference":{"chapter":6,"verse":13}},{"noteId":109,"caller":"+","text":"ರೋಮಾ. 4:13:","reference":{"chapter":6,"verse":15}},{"noteId":110,"caller":"+","text":"ವಿಮೋ 22:11:","reference":{"chapter":6,"verse":16}},{"noteId":111,"caller":"+","text":"ವ. 18; ಕೀರ್ತ 110:4; ಜ್ಞಾ. 19:21:","reference":{"chapter":6,"verse":17}},{"noteId":112,"caller":"+","text":"ಇಬ್ರಿ. 11:9:","reference":{"chapter":6,"verse":17}},{"noteId":113,"caller":"+","text":"ಇಬ್ರಿ. 12:1,2.","reference":{"chapter":6,"verse":18}},{"noteId":114,"caller":"+","text":"ತೀತ. 1:2:","reference":{"chapter":6,"verse":19}},{"noteId":115,"caller":"+","text":"ಅಂದರೆ ಆಧಾರವಾಗಿರುವುದು.","reference":{"chapter":6,"verse":19}},{"noteId":116,"caller":"+","text":"ಇಬ್ರಿ. 9:7; ಯಾಜ 16:15:","reference":{"chapter":6,"verse":19}},{"noteId":117,"caller":"+","text":"ಇಬ್ರಿ. 3:1; 5:6, 10; 7:17, 21","reference":{"chapter":6,"verse":20}},{"noteId":118,"caller":"+","text":"ಇಬ್ರಿ. 4:14; 8:1; 9:24:","reference":{"chapter":6,"verse":20}}]},"thisChapterLink":"/api/kan_irv/HEB/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_irv/HEB/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_irv/HEB/5.json","previousChapterAudioLinks":{},"numberOfVerses":19}