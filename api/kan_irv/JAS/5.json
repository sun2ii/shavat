{"translation":{"id":"kan_irv","name":"ಇಂಡಿಯನ್ ರಿವೈಜ್ಡ್ ವರ್ಸನ್ (IRV) - ಕನ್ನಡ - 2019","website":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseNotes":null,"shortName":"IRV","englishName":"Kannada Indian Revised Version Bible","language":"kan","textDirection":"ltr","sha256":"82cc741009376c81c4416c230a757b2e30ef49b2e4672f9831adcedfc26b865f","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31031,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"JAS","translationId":"kan_irv","name":"ಯಾಕೋಬನು","commonName":"ಯಾಕೋಬನು","title":"ಯಾಕೋಬನು","order":59,"numberOfChapters":5,"sha256":"25e45e9dcd583a42e0dce480ecce1a4b17e2d235511ba0a76d4b970a0412abf6","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_irv/JAS/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/kan_irv/JAS/5.json","totalNumberOfVerses":108},"chapter":{"number":5,"content":[{"type":"heading","content":["ಐಶ್ವರ್ಯವಂತರ ನಡತೆಯ ಬಗ್ಗೆ ಎಚ್ಚರಿಕೆ"]},{"type":"verse","number":1,"content":["ಐಶ್ವರ್ಯವಂತರೇ,",{"noteId":117},"ನಿಮಗೆ ಬರುವ ಸಂಕಟಗಳಿಗಾಗಿ ಕಣ್ಣೀರಿಡಿರಿ, ಗೋಳಾಡಿರಿ."]},{"type":"verse","number":2,"content":[{"noteId":118},"ನಿಮ್ಮ ಐಶ್ವರ್ಯ, ಸಂಪತ್ತು ನಾಶವಾಗಿದೆ. ನಿಮ್ಮ ಬಟ್ಟೆಗಳಿಗೆ ನುಸಿ ಹಿಡಿದಿದೆ."]},{"type":"verse","number":3,"content":["ನಿಮ್ಮ ಚಿನ್ನ, ಬೆಳ್ಳಿಗಳು ತುಕ್ಕು ಹಿಡಿದು ಮಣ್ಣಿಗೆ ಸಮವಾಗಿದೆ. ಅವುಗಳ ತುಕ್ಕು ನಿಮಗೆ ವಿರೋಧವಾಗಿ ಸಾಕ್ಷಿಯಾಗಿದ್ದು, ಬೆಂಕಿಯಂತೆ ನಿಮ್ಮ ಮಾಂಸವನ್ನು ದಹಿಸಿಬಿಡುವುದು.",{"noteId":119},"ಅಂತ್ಯಕಾಲ ಬಂದರೂ ಸಂಪತ್ತನ್ನು",{"noteId":120},"ಕೂಡಿಸಿ ಇಟ್ಟುಕೊಂಡಿದ್ದೀರಿ."]},{"type":"verse","number":4,"content":["ಇಗೋ,",{"noteId":121},"ನಿಮ್ಮ ಹೊಲದಲ್ಲಿನ ಪೈರುಗಳನ್ನು ಕೊಯ್ದದವರ ಕೂಲಿಯನ್ನು ಕೊಡದೆ ವಂಚಿಸಿದಿರಿ. ಆ ಕೂಲಿಯ ಕೂಗು ಹಾಗು",{"noteId":122},"ಪೈರು ಕೊಯ್ದದವರ ಕೂಗು",{"noteId":123},"ಸೇನಾಧೀಶ್ವರನಾದ ಕರ್ತನ ಕಿವಿಗಳನ್ನು ಮುಟ್ಟಿವೆ."]},{"type":"verse","number":5,"content":["ಭೂಲೋಕದಲ್ಲಿ ನೀವು",{"noteId":124},"ಸುಖಭೋಗಿಗಳಾಗಿ ನಿಮ್ಮ ಇಚ್ಛೆಪೂರೈಸಿಕೊಳ್ಳುವವರಾಗಿ ಜೀವಿಸಿದ್ದೀರಿ; ವಧೆಯ ದಿನಕ್ಕಾಗಿಯೋ ಎಂಬಂತೆ ನಿಮ್ಮ ಹೃದಯಗಳನ್ನು ಕೊಬ್ಬಿಸಿಕೊಂಡಿದ್ದೀರಿ."]},{"type":"verse","number":6,"content":["ನೀವು ನೀತಿವಂತನನ್ನು ಖಂಡಿಸಿ",{"noteId":125},"ಕೊಂದು ಹಾಕಿದ್ದೀರಿ; ಅವನಾದರೋ ನಿಮ್ಮನ್ನು ವಿರೋಧಿಸುತ್ತಿಲ್ಲ."]},{"type":"heading","content":["ಹಿಂಸೆಪಡುವ ಕ್ರೈಸ್ತರಿಗೆ ಪ್ರೋತ್ಸಾಹವು"]},{"type":"verse","number":7,"content":["ಸಹೋದರರೇ, ಕರ್ತನು ಬರುವ ತನಕ ತಾಳ್ಮೆಯಿಂದಿರಿ. ವ್ಯವಸಾಯಮಾಡುವವರನ್ನು ನೋಡಿರಿ, ಅವನು ಭೂಮಿಯ ಬೆಲೆಬಾಳುವ ಫಲಕ್ಕಾಗಿ ಕಾದಿದ್ದು",{"noteId":126},"ಮುಂಗಾರು, ಹಿಂಗಾರು ಮಳೆಗಳು ಬರುವ ತನಕ ತಾಳ್ಮೆಯಿಂದಿರುವನು."]},{"type":"verse","number":8,"content":["ನೀವೂ ತಾಳ್ಮೆಯಿಂದಿರಿ,",{"noteId":127},"ನಿಮ್ಮ ಹೃದಯಗಳನ್ನು ದೃಢಪಡಿಸಿಕೊಳ್ಳಿರಿ; ಏಕೆಂದರೆ",{"noteId":128},"ಕರ್ತನ ಬರೋಣವು ಹತ್ತಿರವಾಯಿತು."]},{"type":"verse","number":9,"content":["ಸಹೋದರರೇ, ನೀವು ಒಬ್ಬರ ಮೇಲೊಬ್ಬರು ಆಪವಾದನೆ ಮಾಡಬೇಡಿರಿ; ಇದರಿಂದ",{"noteId":129},"ನ್ಯಾಯವಿಚಾರಣೆಗೆ ಗುರಿಯಾದಿರಿ. ಅಗೋ,",{"noteId":130},"ನ್ಯಾಯಾಧಿಪತಿಯು ಬಾಗಿಲಿನ ಮುಂದೆಯೇ ನಿಂತಿದ್ದಾನೆ."]},{"type":"verse","number":10,"content":["ಸಹೋದರರೇ, ಬಾಧೆಯನ್ನು ತಾಳ್ಮೆಯಿಂದ ಸಹಿಸಿಕೊಳ್ಳುವ ವಿಷಯದಲ್ಲಿ",{"noteId":131},"ಕರ್ತನ ಹೆಸರಿನಲ್ಲಿ ಮಾತನಾಡಿದ ಪ್ರವಾದಿಗಳನ್ನೇ ಮಾದರಿ ಮಾಡಿಕೊಳ್ಳಿರಿ."]},{"type":"verse","number":11,"content":["ಇಗೋ, ತಾಳಿಕೊಳ್ಳುವವರನ್ನು ಧನ್ಯರೆಂದು ನಾವು ಪರಿಗಣಿಸುತ್ತೇವಲ್ಲವೇ. ನೀವು",{"noteId":132},"ಯೋಬನಲ್ಲಿದ್ದ ತಾಳ್ಮೆಯ ವಿಷಯವಾಗಿ ಕೇಳಿ",{"noteId":133},"ಕರ್ತನು ಅವನಿಗೆ ಅಂತ್ಯದಲ್ಲಿ ಮಾಡಿದ್ದನ್ನು ನೋಡಿ",{"noteId":134},"ಕರ್ತನು ಬಹಳ ಕರುಣಾಸಾಗರನೂ ಮತ್ತು ದಯಾಳುವೂ ಆಗಿದ್ದಾನೆಂದು ತಿಳಿದಿರುವಿರಿ."]},{"type":"heading","content":["ನಂಬಿಕೆಯ ಪ್ರಾರ್ಥನೆ ಕುರಿತದ್ದು"]},{"type":"verse","number":12,"content":["ಮುಖ್ಯವಾಗಿ ನನ್ನ ಸಹೋದರರೇ,",{"noteId":135},"ಆಣೆಯಿಡಲೇ ಬೇಡಿರಿ. ಆಕಾಶದ ಮೇಲಾಗಲಿ, ಭೂಮಿಯ ಮೇಲಾಗಲಿ, ಇನ್ಯಾವುದರ ಮೇಲಾಗಲಿ ಆಣೆಯಿಡಬೇಡಿರಿ. ಹೌದೆಂದು ಹೇಳಬೇಕಾದರೆ ಹೌದೆನ್ನಿರಿ, ಅಲ್ಲವೆನ್ನಬೇಕಾದರೆ ಅಲ್ಲವೆನ್ನಿರಿ; ಹೀಗಾದರೆ ನೀವು ನ್ಯಾಯವಿಚಾರಣೆಗೆ ಗುರಿಯಾಗುವುದಿಲ್ಲ."]},{"type":"verse","number":13,"content":["ನಿಮ್ಮಲ್ಲಿ ಯಾವನಾದರೂ ಬಾಧೆಪಡುವವನು ಇದ್ದರೆ, ಅವನು ದೇವರನ್ನು ನಂಬಿಕೆಯಿಂದ ಪ್ರಾರ್ಥಿಸಲಿ. ನಿಮ್ಮಲ್ಲಿ ಯಾವನಾದರೂ ಸಂತೋಷಪಡುವವನು ಇದ್ದರೆ,",{"noteId":136},"ಅವನು ದೇವರಿಗೆ ಸ್ತುತಿಗೀತೆಗಳನ್ನು ಹಾಡಲಿ."]},{"type":"verse","number":14,"content":["ನಿಮ್ಮಲ್ಲಿ ಯಾವನಾದರೂ ಅಸ್ವಸ್ಥನಾಗಿರುವವನು ಇದ್ದರೆ, ಅವನು ಸಭೆಯ ಹಿರಿಯರನ್ನು ಕರೆದು ಪ್ರಾರ್ಥಿಸುವಂತೆ ವಿನಂತಿಸಲಿ. ಅವರು ಕರ್ತನ ಹೆಸರಿನಲ್ಲಿ ಅವನಿಗೆ",{"noteId":137},"ಎಣ್ಣೆ ಹಚ್ಚಿ ಅವನಿಗೋಸ್ಕರ ದೇವರನ್ನು ಪ್ರಾರ್ಥಿಸಲಿ."]},{"type":"verse","number":15,"content":["ನಂಬಿಕೆಯಿಂದ ಮಾಡಿದ ಪ್ರಾರ್ಥನೆಯು ರೋಗಿಯನ್ನು ಗುಣಪಡಿಸುವುದು ಮತ್ತು ಕರ್ತನು ಅವನನ್ನು ಎಬ್ಬಿಸುವನು; ಅವನು ಪಾಪ ಮಾಡಿದವನಾಗಿದ್ದರೆ, ದೇವರು ಆ",{"noteId":138},"ಪಾಪಗಳನ್ನು ಕ್ಷಮಿಸುವನು."]},{"type":"verse","number":16,"content":["ಹೀಗಿರಲು ನೀವು ಸ್ವಸ್ಥವಾಗಬೇಕಾದರೆ",{"noteId":139},"ನಿಮ್ಮ ಪಾಪಗಳನ್ನು ಒಬ್ಬರಿಗೊಬ್ಬರು ಅರಿಕೆ ಮಾಡಿ,, ಒಬ್ಬರಿಗೋಸ್ಕರ ಒಬ್ಬರು ಪ್ರಾರ್ಥಿಸಿರಿ.",{"noteId":140},"ನೀತಿವಂತನ ಅತ್ಯಾಸಕ್ತಿಯುಳ್ಳ ಪ್ರಾರ್ಥನೆಯು ಬಹು ಸಾಮರ್ಥ್ಯವುಳ್ಳದಾಗಿರುತ್ತದೆ."]},{"type":"verse","number":17,"content":["ಎಲೀಯನು ನಮಗೆ ಸಮಾನವಾದ ಸ್ವಭಾವವುಳ್ಳವನಾಗಿದ್ದನು,",{"noteId":141},"ಅವನು ಮಳೆ ಬರಬಾರದೆಂದು ಭಕ್ತಿಯಿಂದ ಪ್ರಾರ್ಥಿಸಲು",{"noteId":142},"ಮೂರು ವರ್ಷ ಆರು ತಿಂಗಳವರೆಗೂ ಭೂಮಿಯ ಮೇಲೆ ಮಳೆ ಬೀಳಲಿಲ್ಲ."]},{"type":"verse","number":18,"content":["ತಿರುಗಿ ಅವನು ಪ್ರಾರ್ಥನೆ ಮಾಡಲು ಆಕಾಶವು ಮಳೆಗರೆಯಿತು, ಭೂಮಿಯು ಫಲಕೊಟ್ಟಿತು."]},{"type":"verse","number":19,"content":["ನನ್ನ ಸಹೋದರರೇ,",{"noteId":143},"ನಿಮ್ಮಲ್ಲಿ ಯಾರಾದರು ಸತ್ಯ ಮಾರ್ಗವನ್ನು ಬಿಟ್ಟು ತಪ್ಪಿ ನಡೆಯುತ್ತಿದ್ದರೆ",{"noteId":144},"ಮತ್ತೊಬ್ಬನು ಅವನನ್ನು ಸನ್ಮಾರ್ಗಕ್ಕೆ ತಂದರೆ;"]},{"type":"verse","number":20,"content":["ಒಬ್ಬ ಪಾಪಿಯನ್ನು ತಪ್ಪಾದ ಮಾರ್ಗದಿಂದ ತಪ್ಪಿಸಿ, ಪರಿವರ್ತಿಸಿ",{"noteId":145},"ಅವನ ಆತ್ಮವನ್ನು ಮರಣದಿಂದ ತಪ್ಪಿಸಿ ಬಹು ಪಾಪಗಳನ್ನು ಮುಚ್ಚಿದವನಾದನೆಂದು ತಿಳಿದುಕೊಳ್ಳಲ್ಲಿ."]}],"footnotes":[{"noteId":117,"caller":"+","text":"ಲೂಕ 6:24; ಜ್ಞಾ. 11:28; ಆಮೋ. 6:1; 1 ತಿಮೊ. 6:9:","reference":{"chapter":5,"verse":1}},{"noteId":118,"caller":"+","text":"ಮತ್ತಾ 6:19, 20:","reference":{"chapter":5,"verse":2}},{"noteId":119,"caller":"+","text":"ಯಾಕೋಬ 5:8, 9:","reference":{"chapter":5,"verse":3}},{"noteId":120,"caller":"+","text":"ಮತ್ತಾ 6:19; ಲೂಕ 12:21; ರೋಮಾ. 2:5:","reference":{"chapter":5,"verse":3}},{"noteId":121,"caller":"+","text":"ಯಾಜ 19:13:","reference":{"chapter":5,"verse":4}},{"noteId":122,"caller":"+","text":"ಧರ್ಮೋ 24:15:","reference":{"chapter":5,"verse":4}},{"noteId":123,"caller":"+","text":"ರೋಮಾ. 9:29:","reference":{"chapter":5,"verse":4}},{"noteId":124,"caller":"+","text":"ಲೂಕ 16:19:","reference":{"chapter":5,"verse":5}},{"noteId":125,"caller":"+","text":"ಯಾಕೋಬ 4:2:","reference":{"chapter":5,"verse":6}},{"noteId":126,"caller":"+","text":"ಧರ್ಮೋ 11:14:","reference":{"chapter":5,"verse":7}},{"noteId":127,"caller":"+","text":"1 ಥೆಸ. 3:13:","reference":{"chapter":5,"verse":8}},{"noteId":128,"caller":"+","text":"1 ಪೇತ್ರ. 4:7; ರೋಮಾ. 13:11, 12; ಫಿಲಿ. 4:5; ಇಬ್ರಿ. 10:25, 37:","reference":{"chapter":5,"verse":8}},{"noteId":129,"caller":"+","text":"ಮತ್ತಾ 7:1:","reference":{"chapter":5,"verse":9}},{"noteId":130,"caller":"+","text":"1 ಪೇತ್ರ. 4:5; ಮತ್ತಾ 24:33; ಮಾರ್ಕ 13:29; 1 ಕೊರಿ 4:5; ಪ್ರಕ 22:12:","reference":{"chapter":5,"verse":9}},{"noteId":131,"caller":"+","text":"ಮತ್ತಾ 5:12; 23:34; ಅ. ಕೃ. 7:52; ಇಬ್ರಿ. 11:32,38.","reference":{"chapter":5,"verse":10}},{"noteId":132,"caller":"+","text":"ಯೋಬ. 1:21, 22; 2:10:","reference":{"chapter":5,"verse":11}},{"noteId":133,"caller":"+","text":"ಯೋಬ. 42:10, 12:","reference":{"chapter":5,"verse":11}},{"noteId":134,"caller":"+","text":"ವಿಮೋ 34:6:","reference":{"chapter":5,"verse":11}},{"noteId":135,"caller":"+","text":"ಮತ್ತಾ 5:34:","reference":{"chapter":5,"verse":12}},{"noteId":136,"caller":"+","text":"ಕೊಲೊ 3:16:","reference":{"chapter":5,"verse":13}},{"noteId":137,"caller":"+","text":"ಮಾರ್ಕ 6:13; ಮಾರ್ಕ 16:18:","reference":{"chapter":5,"verse":14}},{"noteId":138,"caller":"+","text":"ಯೆಶಾ 33:24; ಮತ್ತಾ 9:2; ಮಾರ್ಕ 2:5; ಲೂಕ 5:20:","reference":{"chapter":5,"verse":15}},{"noteId":139,"caller":"+","text":"ಅ. ಕೃ. 19:18:","reference":{"chapter":5,"verse":16}},{"noteId":140,"caller":"+","text":"ಆದಿ 18:23-32; 20:17; ಅರಣ್ಯ 11:2; 1 ಅರಸು. 13:6; 17:22; 2 ಅರಸು. 4:33; 19:15-20; 20:2, 5; ಯೋಬ. 42:8; ಜ್ಞಾ. 15:29:","reference":{"chapter":5,"verse":16}},{"noteId":141,"caller":"+","text":"1 ಅರಸು. 17:1; 18:1:","reference":{"chapter":5,"verse":17}},{"noteId":142,"caller":"+","text":"ಲೂಕ 4:25:","reference":{"chapter":5,"verse":17}},{"noteId":143,"caller":"+","text":"ಮತ್ತಾ 18:15; ಗಲಾ. 6:1:","reference":{"chapter":5,"verse":19}},{"noteId":144,"caller":"+","text":"ದಾನಿ. 12:3; ಮಲಾ. 2:6:","reference":{"chapter":5,"verse":19}},{"noteId":145,"caller":"+","text":"ರೋಮಾ. 11:14:","reference":{"chapter":5,"verse":20}}]},"thisChapterLink":"/api/kan_irv/JAS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_irv/1PE/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_irv/JAS/4.json","previousChapterAudioLinks":{},"numberOfVerses":20}