{"translation":{"id":"kan_irv","name":"ಇಂಡಿಯನ್ ರಿವೈಜ್ಡ್ ವರ್ಸನ್ (IRV) - ಕನ್ನಡ - 2019","website":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseNotes":null,"shortName":"IRV","englishName":"Kannada Indian Revised Version Bible","language":"kan","textDirection":"ltr","sha256":"82cc741009376c81c4416c230a757b2e30ef49b2e4672f9831adcedfc26b865f","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31031,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"JDG","translationId":"kan_irv","name":"ನ್ಯಾಯಸ್ಥಾಪಕರು","commonName":"ನ್ಯಾಯಸ್ಥಾಪಕರು","title":"ನ್ಯಾಯಸ್ಥಾಪಕರು","order":7,"numberOfChapters":21,"sha256":"ae55deb67e5a0f1e623ac4f5bda26f7f203276cd571a6ee496cd58332823d1b9","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_irv/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/kan_irv/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":5,"content":[{"type":"heading","content":["ದೆಬೋರಳ ಜಯಗೀತೆ"]},{"type":"verse","number":1,"content":["ಆ ದಿನದಲ್ಲಿ ದೆಬೋರಳೂ ಅಬೀನೋವಮನ ಮಗನಾದ ಬಾರಾಕನೂ ಈ ಗೀತೆಯನ್ನು ಹಾಡಿದರು:"]},{"type":"verse","number":2,"content":[{"text":"“","poem":1},{"noteId":23},{"text":"ಇಸ್ರಾಯೇಲರಲ್ಲಿ ಸೇನಾ ನಾಯಕರು ಎದ್ದಿದ್ದಾರೆ;","poem":1},{"text":"ಜನರು ಸ್ವಇಚ್ಛೆಯಿಂದ ಸೈನ್ಯದಲ್ಲಿ ಸೇರಿದ್ದಾರೆ,","poem":2},{"lineBreak":true},{"text":"ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡಿರಿ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“ಅರಸರೇ, ಕೇಳಿರಿ! ಪ್ರಭುಗಳೇ, ಕಿವಿಗೊಡಿರಿ!","poem":1},{"text":"ನಾನು ಯೆಹೋವನನ್ನು ಕೀರ್ತಿಸುವೆನು;","poem":2},{"lineBreak":true},{"text":"ನಾನು ಇಸ್ರಾಯೇಲ್ ದೇವರಾದ ಯೆಹೋವನಿಗೆ ಸ್ತುತಿ ಗೀತೆ ಹಾಡುವೆನು.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“ಯೆಹೋವನೇ, ನೀನು ಹೊರಟು","poem":1},{"text":"ಎದೋಮ್ಯರ ಪ್ರಾಂತ್ಯವಾದ ಸೇಯೀರಿನ ಮಾರ್ಗವಾಗಿ ಪಯಣಮಾಡುತ್ತಾ ಬರುವಾಗ","poem":2},{"lineBreak":true},{"noteId":24},{"text":"ಭೂಲೋಕವು ಕಂಪಿಸಿತು, ಆಕಾಶವು ನಡುಗಿತು;","poem":2},{"lineBreak":true},{"text":"ಮೇಘಮಂಡಲವು ಮಳೆಗರೆಯಿತು.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ಯೆಹೋವನ ಮುಂದೆ ಪರ್ವತಗಳು ಕರಗಿಹೋದವು,","poem":1},{"noteId":25},{"text":"ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವನ ಎದುರಿಗೆ ಆ ಸೀನಾಯಿಬೆಟ್ಟವೂ ನೀರಾಯಿತು.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“ಅನಾತನ ಮಗನಾದ ಶಮ್ಗರನ ಕಾಲದಲ್ಲಿಯೂ,","poem":1},{"text":"ಯಾಯೇಲಳ ದಿನಗಳಲ್ಲಿಯೂ ರಾಜಮಾರ್ಗಗಳಲ್ಲಿ ಸಂಚಾರವು ನಿಂತುಹೋಯಿತು.","poem":2},{"lineBreak":true},{"text":"ಪ್ರಯಾಣಿಕರು ಅಂಕುಡೊಂಕಾದ ದಾರಿಹಿಡಿದು ಹೋದರು.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ದೆಬೋರಳಾದ ನಾನು ಇಸ್ರಾಯೇಲರಲ್ಲಿ ತಾಯಿಯಂತೆ ಎದ್ದುಬರುವವರೆಗೆ","poem":1},{"text":"ಇಸ್ರಾಯೇಲ್ ಗ್ರಾಮಗಳು ಹಾಳುಬಿದ್ದಿದ್ದವು.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ಜನರು ಅನ್ಯದೇವತೆಗಳನ್ನು ಆರಿಸಿಕೊಂಡಿದ್ದರು;","poem":1},{"text":"ಯುದ್ಧವು ಉರುಬಾಗಿಲವರೆಗೂ ಬಂದಿತ್ತು.","poem":2},{"lineBreak":true},{"text":"ಇಸ್ರಾಯೇಲರ ನಲ್ವತ್ತು ಸಾವಿರ ಸೈನಿಕರ ಮಧ್ಯದಲ್ಲಿ ಗುರಾಣಿ ಬರ್ಜಿಗಳು ಇರಲೇ ಇಲ್ಲ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ನನ್ನ ಹೃದಯವು ಇಸ್ರಾಯೇಲರ ಸೇನಾಧಿಪತಿಗಳಲ್ಲಿಯೂ,","poem":1},{"text":"ಸ್ವಇಚ್ಛೆಯಿಂದ ಸೈನ್ಯದಲ್ಲಿ ಸೇರಿದ ಜನರಲ್ಲಿಯೂ ಸಂತೋಷಿಸುತ್ತದೆ;","poem":2},{"lineBreak":true},{"text":"ಅವರಿಗೋಸ್ಕರ ಯೆಹೋವನನ್ನು ಕೊಂಡಾಡುತ್ತೇವೆ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“ಬಿಳೀ ಕತ್ತೆಗಳ ಮೇಲೆ ಸವಾರಿಮಾಡುವವರೇ,","poem":1},{"text":"ರತ್ನಗಂಬಳಿಗಳ ಮೇಲೆ ಕುಳಿತುಕೊಳ್ಳುವವರೇ, ಕಾಲ್ನಡಿಗೆಯಲ್ಲಿ ಪ್ರಯಾಣಿಸುವವರೇ, ಗಾನಮಾಡಿರಿ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ಸೇದುವ ಬಾವಿಗಳ ಬಳಿಯಲ್ಲಿ","poem":1},{"noteId":26},{"text":"ಬಿಲ್ಲುಗಾರರ ಧ್ವನಿಗಿಂತ ಗಟ್ಟಿಯಾಗಿ","poem":1},{"text":"ಯೆಹೋವನ ನೀತಿಸಾಧನೆಯ ವರ್ಣನೆಯನ್ನು ಕೇಳಿರಿ.","poem":2},{"lineBreak":true},{"text":"ಆತನು ತನ್ನ ಪ್ರಜೆಗಳಾಗಿರುವ ಇಸ್ರಾಯೇಲ್ ಗ್ರಾಮಸ್ಥರ ನ್ಯಾಯವನ್ನು ಸ್ಥಾಪಿಸಿದ್ದಾನಲ್ಲಾ.","poem":2},{"lineBreak":true},{"text":"ಆ ಕಾಲದಲ್ಲಿ ಯೆಹೋವನ ಜನರು ಊರುಬಾಗಿಲುಗಳಿಗೆ ಇಳಿದು ಬಂದರು.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"‘ಎಚ್ಚರವಾಗು, ದೆಬೋರಳೇ! ಎಚ್ಚರವಾಗು,","poem":1},{"text":"ಎಚ್ಚರವಾಗು, ಎಚ್ಚರವಾಗಿ ಗಾನಮಾಡು.","poem":2},{"lineBreak":true},{"text":"ಬಾರಾಕನೇ, ಏಳು;","poem":2},{"lineBreak":true},{"text":"ಅಬೀನೋವಮನ ಮಗನೇ, ನೀನು ಸೆರೆಹಿಡಿದವರನ್ನು ಸಾಗಿಸಿಕೊಂಡು ಹೋಗು.’","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“ಆಗ ಚದರಿಹೋದವರು ನಾಯಕರ ಬಳಿಗೆ ಕೂಡಿಬಂದರು.","poem":1},{"text":"ಯೆಹೋವನ ಜನರು ವೀರರಾಗಿ ನನ್ನ ಸಹಾಯಕ್ಕೆ ನೆರೆದು ಬಂದರು.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ಅಮಾಲೇಕ್ಯರ ಪ್ರದೇಶದಲ್ಲಿ ನೆಲೆಗೊಂಡಿರುವ ಎಫ್ರಾಯೀಮ್ಯರೂ","poem":1},{"text":"ಅವರ ಜೊತೆಯಲ್ಲಿ ಬೆನ್ಯಾಮೀನ್ಯರೂ ಬಂದರು.","poem":2},{"lineBreak":true},{"text":"ಮಾಕೀರನ ಗೋತ್ರದಿಂದ ಪ್ರಧಾನರೂ","poem":2},{"lineBreak":true},{"text":"ಜೆಬುಲೂನ್ ಕುಲದಿಂದ ದಂಡಧಾರಿಗಳಾದ ಸೇನಾನಾಯಕರೂ","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ದೆಬೋರಳ ಜೊತೆಯಲ್ಲಿ ಇಸ್ಸಾಕಾರ್ ಕುಲಪ್ರಭುಗಳೂ","poem":1},{"text":"ಇಸ್ಸಾಕಾರರೊಡನೆ ಬಾರಾಕನೂ ಆಗಮಿಸಿದರು.","poem":2},{"lineBreak":true},{"text":"ಇವರೆಲ್ಲರೂ ಬಾರಾಕನ ಹೆಜ್ಜೆಹಿಡಿದು ತಟ್ಟನೆ ತಗ್ಗಿನ ಪ್ರದೇಶಕ್ಕೆ ಬಂದರು.","poem":2},{"lineBreak":true},{"text":"ರೂಬೇನ್ಯರ ಗೋತ್ರದವರು ಬಹಳಷ್ಟು ತಮ್ಮ ಹೃದಯಗಳಲ್ಲಿ ವಿಶ್ಲೇಷಿಸಿದರೂ ತೀರ್ಮಾನಿಸಲಾಗಲ್ಲಿಲ್ಲ","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ರೂಬೇನ್ಯರೇ, ನೀವು ಕುರಿಹಟ್ಟಿಗಳಲ್ಲಿ,","poem":1},{"text":"ಮಂದೆಗಳ ಮಧ್ಯದಲ್ಲಿ ಕೊಳಲೂದುವುದನ್ನು ಕೇಳಬೇಕೆಂದು ಅಲ್ಲಿಯೇ ಕುಳಿತಿರುವುದೇಕೆ?","poem":2},{"lineBreak":true},{"text":"ರೂಬೇನ್ಯರು ಗೋತ್ರದವರು ಬಹಳಷ್ಟು ತಮ್ಮ ಹೃದಯಗಳಲ್ಲಿ ವಿಶ್ಲೇಷಿಸಿದರೂ ತೀರ್ಮಾನಿಸಲಾಗಲ್ಲಿಲ್ಲ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ಗಿಲ್ಯಾದ್ಯರು ಯೊರ್ದನಿನ ಆಚೆಯಲ್ಲೇ ಉಳಿದರು.","poem":1},{"text":"ದಾನ್ ಕುಲದವರು ಹಡಗುಗಳಲ್ಲಿಯೇ ಉಳಿದದ್ದೇಕೆ?","poem":2},{"lineBreak":true},{"text":"ಆಶೇರ್ ಕುಲದವರು ತಮ್ಮ ರೇವುಗಳನ್ನು ಬಿಡದೆ ಸಮುದ್ರ ತೀರದಲ್ಲಿ ಸುಮ್ಮನೆ ಕುಳಿತುಬಿಟ್ಟರು.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ಜೆಬುಲೂನ್ಯರು ತಮ್ಮ ಜೀವವನ್ನು ಮರಣದ ಆಪತ್ತಿಗೆ ಒಪ್ಪಿಸಲು ಸಿದ್ಧರಿದರು,","poem":1},{"text":"ನಫ್ತಾಲ್ಯರು ಸಹ ರಣರಂಗದಲ್ಲಿಯೇ ಇದ್ದರು.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"“ಅರಸರು ಬಂದು ಯುದ್ಧಮಾಡಿದರು;","poem":1},{"text":"ಕಾನಾನ್ಯ ರಾಜರು ಮೆಗಿದ್ದೋ ನೀರಿನ ಕಾಲುವೆಗಳ ಬಳಿಯಲ್ಲಿರುವ ತಾನಾಕದಲ್ಲಿ ಕೂಡಿಬಂದು ಹೋರಾಡಿದರು.","poem":2},{"lineBreak":true},{"text":"ಅವರಿಗೆ ದ್ರವ್ಯವೇನೂ ಸಿಕ್ಕಲಿಲ್ಲ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ನಕ್ಷತ್ರಗಳೂ ಆಕಾಶಪಥದಲ್ಲಿದ್ದು ಸೀಸೆರನೊಡನೆ ಯುದ್ಧಮಾಡಿದವು.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ಪೂರ್ವಪ್ರಸಿದ್ಧವಾದ ಕೀಷೋನ್ ಹೊಳೆಯು ಶತ್ರುಗಳನ್ನು ಕೊಚ್ಚಿಕೊಂಡು ಹೋಯಿತು.","poem":1},{"text":"ನನ್ನ ಮನವೇ ನೀನು ಧೈರ್ಯದಿಂದ ಮುಂದಕ್ಕೆ ಹೊರಡು.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ಆಗ ಅತಿವೇಗವಾಗಿ ಓಡುತ್ತಿದ್ದ ಅವರ ಬಲವಾದ ಕುದುರೆಗಳ ಗೊರಸುಗಳ ಪೆಟ್ಟಿನಿಂದ ನೆಲವು ಕಂಪಿಸಿತು.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ಮೇರೋಜ್ ಊರನ್ನು ಶಪಿಸಿರೆಂದು ಯೆಹೋವನ ದೂತನು ಹೇಳುತ್ತಾನೆ.","poem":1},{"text":"‘ಅದರ ನಿವಾಸಿಗಳು ಯೆಹೋವನ ಸಹಾಯಕ್ಕೆ ಬರಲಿಲ್ಲ.","poem":2},{"lineBreak":true},{"text":"ಯುದ್ಧವೀರರ ಹೋರಾಟದ ವಿರುದ್ಧ ಯೆಹೋವನ ಸಹಾಯಕ್ಕೆ ಬರಲಿಲ್ಲವಲ್ಲಾ;","poem":2},{"lineBreak":true},{"text":"ಅವರನ್ನು ಶಪಿಸೇ ಶಪಿಸಿರಿ!’","poem":2}]},{"type":"verse","number":24,"content":[{"text":"“ಎಲ್ಲಾ ಸ್ತ್ರೀಯರಲ್ಲಿ ಕೇನ್ಯನಾದ ಹೆಬೆರನ ಹೆಂಡತಿ ಯಾಯೇಲಳೆ ಭಾಗ್ಯವಂತಳು.","poem":1},{"text":"ಗುಡಾರಗಳಲ್ಲಿ ವಾಸಿಸುವ ಸ್ತ್ರೀಯರಲ್ಲಿ ಆಕೆಯೇ ಆಶೀರ್ವದಿಸಲ್ಪಟ್ಟವಳು.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ನೀರು ಕೇಳಿದನು, ಹಾಲು ಕೊಟ್ಟಳು;","poem":1},{"text":"ಉತ್ತಮ ಪಾತ್ರೆಯಲ್ಲಿ ಮಜ್ಜಿಗೆ ಕೊಟ್ಟಳು.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ಕೈಚಾಚಿ ಗೂಟವನ್ನು ತೆಗೆದುಕೊಂಡಳು;","poem":1},{"text":"ಬಲಗೈಯಲ್ಲಿ ದೊಡ್ಡ ಸುತ್ತಿಗೆಯನ್ನು ಹಿಡಿದಳು;","poem":2},{"lineBreak":true},{"text":"ಆ ಸುತ್ತಿಗೆಯಿಂದ ಸೀಸೆರನ ತಲೆಯನ್ನು ಒಡೆದುಬಿಟ್ಟಳು.","poem":2},{"lineBreak":true},{"text":"ಅವನ ನೆತ್ತಿಗೆ ತಿವಿದು ಜಡಿದಳು.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ಅವನು ಆಕೆಯ ಕಾಲುಗಳ ಬಳಿಯಲ್ಲಿ ಉರುಳಿ ಬಿದ್ದನು;","poem":1},{"text":"ಅವನು ಆಕೆಯ ಕಾಲುಗಳ ಬಳಿಯಲ್ಲಿ ಮುದುರಿಕೊಂಡು ಉರುಳಿದನು.","poem":2},{"lineBreak":true},{"text":"ಅವನು ಬಿದ್ದಲ್ಲೇ ಸತ್ತನು.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"“ಸೀಸೆರನ ತಾಯಿಯು ಕಿಟಿಕಿಯಿಂದ ನೋಡಿದಳು;","poem":1},{"text":"ಸೀಸೆರನ ತಾಯಿಯು ಕಿಟಿಕಿಯ ಜಾಲರಿಗಳಿಂದ ಕೂಗಿದಳು.","poem":2},{"lineBreak":true},{"text":"‘ಅವನ ರಥವು ಬರುವುದಕ್ಕೆ ಏಕೆ ಇಷ್ಟುಹೊತ್ತಾಯಿತು!","poem":2},{"lineBreak":true},{"text":"ಅವನ ಕುದುರೆಗಳ ಗೊರಸುಗಳಿಗೆ ಇಷ್ಟು ಸಾವಕಾಶವೇಕೆ’ ಅಂದಳು.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ಬುದ್ಧಿವಂತೆಯರಾದ ಸ್ತ್ರೀಯರು ಕೊಟ್ಟ ಉತ್ತರವನ್ನೇ","poem":1},{"text":"ಈಕೆಯು ತನ್ನಲ್ಲಿ ತಾನೇ ಅಂದುಕೊಳ್ಳುತ್ತಿದ್ದದ್ದು ಏನೆಂದರೆ,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"‘ನಿಶ್ಚಯವಾಗಿ ಅವರಿಗೆ ಕೊಳ್ಳೆ ಸಿಕ್ಕಿರುತ್ತದೆ; ಅದನ್ನು ಹಂಚಿಕೊಳ್ಳುತ್ತಿದ್ದಾರಲ್ಲವೋ?.","poem":1},{"text":"ಪ್ರತಿಯೊಬ್ಬ ಪುರುಷನಿಗೆ ಒಬ್ಬಿಬ್ಬರು ಹೆಂಗಸರೂ, ಸೀಸೆರನಿಗೆ ನಾನಾ ವರ್ಣಗಳುಳ್ಳ ಬಟ್ಟೆಗಳೂ, ವಿಚಿತ್ರವಾಗಿ ಕಸೂತಿಹಾಕಿದ ಎರಡು ವಸ್ತ್ರಗಳೂ,","poem":2},{"noteId":27},{"text":"ಕಂಠಮಾಲೆಯೂ ದೊರಕಿರುತ್ತವೆ.’","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ಯೆಹೋವನ ಎಲ್ಲಾ ಶತ್ರುಗಳೂ ಹೀಗೆಯೇ ನಾಶವಾಗಲಿ.","poem":1},{"text":"ಆತನನ್ನು ಪ್ರೀತಿಸುವ ಭಕ್ತರು ಪ್ರಕಾಶದಿಂದ ಉದಯಿಸುವ ಸೂರ್ಯನಂತಿರಲಿ.”","poem":2},"ಅನಂತರ ದೇಶದಲ್ಲಿ ನಲವತ್ತು ವರ್ಷ ಸಮಾಧಾನವಿತ್ತು."]}],"footnotes":[{"noteId":23,"caller":"+","text":"ಅಥವಾ ಯೆಹೋವನು ಇಸ್ರಾಯೇಲರಿಗಾಗಿ ನೀತಿಯನ್ನು ಸ್ಥಾಪಿಸಿದ್ದಾನೆ.","reference":{"chapter":5,"verse":2}},{"noteId":24,"caller":"+","text":"2 ಸಮು 22:8; ನಹೂ. 1:5.","reference":{"chapter":5,"verse":4}},{"noteId":25,"caller":"+","text":"ಯೆಶಾ 64: 1","reference":{"chapter":5,"verse":5}},{"noteId":26,"caller":"+","text":"ಸಂಗೀತಗಾರರ.","reference":{"chapter":5,"verse":11}},{"noteId":27,"caller":"+","text":"ಕೊಳ್ಳೆಯವರ ಕಂಠ.","reference":{"chapter":5,"verse":30}}]},"thisChapterLink":"/api/kan_irv/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_irv/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_irv/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}