{"translation":{"id":"kan_irv","name":"ಇಂಡಿಯನ್ ರಿವೈಜ್ಡ್ ವರ್ಸನ್ (IRV) - ಕನ್ನಡ - 2019","website":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseNotes":null,"shortName":"IRV","englishName":"Kannada Indian Revised Version Bible","language":"kan","textDirection":"ltr","sha256":"82cc741009376c81c4416c230a757b2e30ef49b2e4672f9831adcedfc26b865f","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31031,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"JOB","translationId":"kan_irv","name":"ಯೋಬನು","commonName":"ಯೋಬನು","title":"ಯೋಬನು","order":18,"numberOfChapters":42,"sha256":"43107c035650de184c8120657dd44425eb19810043d8df6a718725500a8bf994","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/kan_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":14,"content":[{"type":"heading","content":["ಯೋಬನು ದೇವರೊಂದಿಗೆ ಪ್ರಾರ್ಥಿಸಿದ್ದು"]},{"type":"verse","number":1,"content":[{"text":"“ಮಾನವ ಜನ್ಮ ಪಡೆದವನು,","poem":1},{"lineBreak":true},{"text":"ಅಲ್ಪಾಯುಷ್ಯನಾಗಿಯೂ, ಕಳವಳದಿಂದ ತುಂಬಿದವನಾಗಿಯೂ ಇರುವನು.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ಹೂವಿನ ಹಾಗೆ ಅರಳಿ ಬಾಡುವನು,","poem":1},{"lineBreak":true},{"text":"ನೆರಳಿನಂತೆ ನಿಲ್ಲದೆ ಓಡಿಹೋಗುವನು.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ನೀನು ಇಂಥವನಾದ ನನ್ನ ಮೇಲೆ ಕಣ್ಣಿಟ್ಟು,","poem":1},{"lineBreak":true},{"text":"ನಿನ್ನ ನ್ಯಾಯಸ್ಥಾನಕ್ಕೆ ನನ್ನನ್ನು ಬರಮಾಡುವಿಯಾ?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ಅಶುದ್ಧದಿಂದ ಶುದ್ಧವು ಉಂಟಾದೀತೇ? ಎಂದಿಗೂ ಇಲ್ಲ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ಮನುಷ್ಯನ ದಿನಗಳು ಇಷ್ಟೇ ಎಂಬುದು ತೀರ್ಮಾನವಾಗಿದೆಯಲ್ಲಾ;","poem":1},{"lineBreak":true},{"text":"ಅವನ ತಿಂಗಳುಗಳ ಲೆಕ್ಕವು ನಿನಗೆ ಗೊತ್ತು;","poem":1},{"lineBreak":true},{"text":"ದಾಟಲಾರದ ಗಡಿಗಳನ್ನು ಅವನಿಗೆ ನೇಮಿಸಿದ್ದಿ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ನಿನ್ನ ದೃಷ್ಟಿಯನ್ನು ಅವನ ಕಡೆಯಿಂದ ತಿರುಗಿಸು,","poem":1},{"lineBreak":true},{"text":"ಅವನಿಗೆ ಸ್ವಲ್ಪ ವಿರಾಮವಿರಲಿ, ಕೂಲಿಯವನಿಗಿರುವಷ್ಟು ಸಂತೋಷದಿಂದಾದರೂ ತನ್ನ ದಿನವನ್ನು ಕಳೆಯಲಿ.","poem":1}]},{"type":"heading","content":["ಮರಣದ ಅನಿವಾರ್ಯತೆ"]},{"type":"verse","number":7,"content":[{"text":"ಕಡಿದ ಮರವೂ,","poem":1},{"lineBreak":true},{"text":"ತಾನು ಮೊಳೆಯುವುದನ್ನು ನಿಲ್ಲಿಸದೆ,","poem":1},{"lineBreak":true},{"text":"ಮತ್ತೆ ಚಿಗುರುವೆನೆಂದು ನಿರೀಕ್ಷಿಸುತ್ತದಲ್ಲವೇ!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ನೆಲದಲ್ಲಿ ಅದರ ಬೇರು ಹಳೆಯದಾದರೂ,","poem":1},{"lineBreak":true},{"text":"ಮಣ್ಣಿನಲ್ಲಿ ಸತ್ತರೂ,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ಮಳೆ ನೀರಿನ ವಾಸನೆಯಿಂದಲೇ ಅದು ಮೊಳೆತು, ಚಿಗುರಿ","poem":1},{"lineBreak":true},{"text":"ಗಿಡದ ಹಾಗೆ ಕವಲೊಡೆಯುವುದು.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ಮನುಷ್ಯನಾದರೋ ಸತ್ತು ಬೋರಲುಬೀಳುವನು,","poem":1},{"lineBreak":true},{"text":"ಪ್ರಾಣಹೋಗಲು ಅವನ ಅಂತ್ಯವಾಗುತ್ತದೆ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ಸರೋವರದ ನೀರು ಬತ್ತುವಂತೆ,","poem":1},{"lineBreak":true},{"text":"ನದಿಯ ನೀರು ಆವಿಯಾಗಿ ಒಣಗುವ ಹಾಗೆ,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ಮನುಷ್ಯರು ಮಲಗಿಕೊಂಡು ಏಳದೇ ಇರುವರು;","poem":1},{"lineBreak":true},{"text":"ಆಕಾಶವು ಅಳಿದು ಹೋಗುವ ತನಕ ಅವರು ನಿದ್ರೆಯನ್ನು,","poem":1},{"lineBreak":true},{"text":"ತಿಳಿಯುವುದಿಲ್ಲ, ಎಬ್ಬಿಸಲ್ಪಡುವುದಿಲ್ಲ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ನಿನ್ನ ಕೋಪವು ಇಳಿಯುವ ವರೆಗೆ ನನ್ನನ್ನು ಮರೆಮಾಡಿ,","poem":1},{"lineBreak":true},{"text":"ನೀನು ನನ್ನನ್ನು ಪಾತಾಳದಲ್ಲಿ ಬಚ್ಚಿಟ್ಟು,","poem":1},{"lineBreak":true},{"text":"ನನಗೆ ಅವಧಿಯನ್ನು ಗೊತ್ತುಮಾಡಿ ಕಡೆಯಲ್ಲಿ ನನ್ನನ್ನು ಜ್ಞಾಪಿಸಿಕೊಂಡರೆ ಎಷ್ಟೋ ಒಳ್ಳೇದು!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ಒಬ್ಬ ಮನುಷ್ಯನು ಸತ್ತು ಪುನಃ ಬದುಕುವನೇ?","poem":1},{"lineBreak":true},{"text":"ಹಾಗಾಗುವುದಾದರೆ ನನಗೆ ಬಿಡುಗಡೆಯಾಗುವವರೆಗೆ,","poem":1},{"lineBreak":true},{"text":"ನನ್ನ ವಾಯಿದೆಯ ದಿನಗಳಲ್ಲೆಲ್ಲಾ ಕಾದುಕೊಂಡಿರುವೆನು.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ನೀನು ಕರೆದರೆ ಉತ್ತರಕೊಡುವೆನು,","poem":1},{"lineBreak":true},{"text":"ನೀನು ಸೃಷ್ಟಿಸಿದ ನನ್ನ ಮೇಲೆ ನಿನಗೆ ಪ್ರೀತಿ ಹುಟ್ಟೀತು.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ಈಗ ನೀನು ನನ್ನ ಹೆಜ್ಜೆಗಳನ್ನು ಲೆಕ್ಕಿಸಿ,","poem":1},{"lineBreak":true},{"text":"ನನ್ನ ಪಾಪದ ಮೇಲೆ ಕಾವಲಾಗಿದ್ದೀಯಲ್ಲಾ!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ನನ್ನ ದ್ರೋಹವನ್ನು ಚೀಲದಲ್ಲಿಟ್ಟು ಮುದ್ರಿಸಿ,","poem":1},{"lineBreak":true},{"text":"ನನ್ನ ದೋಷವನ್ನು ಭದ್ರವಾಗಿ ಕಟ್ಟಿದ್ದೀ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ಆದರೆ ಪರ್ವತವೂ ಬಿದ್ದು ಕರಗಿಹೋಗುವುದು,","poem":1},{"lineBreak":true},{"text":"ಬಂಡೆಯು ತನ್ನ ಸ್ಥಳದಿಂದ ಜರುಗುವುದು,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ನೀರು ಕಲ್ಲುಗಳನ್ನು ಸವೆಯಿಸುವುದು,","poem":1},{"lineBreak":true},{"text":"ಜಲಪ್ರವಾಹಗಳು ಭೂಮಿಯ ಮಣ್ಣನ್ನು ಕೊಚ್ಚಿಕೊಂಡು ಹೋಗುವವು.","poem":1},{"lineBreak":true},{"text":"ಹೀಗೆಯೇ ಮನುಷ್ಯರ ನಿರೀಕ್ಷೆಯನ್ನು ಹಾಳುಮಾಡುವಿ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ನೀನು ಅವನಿಗೆ ಶಾಶ್ವತವಾದ ಅಪಜಯವನ್ನುಂಟು ಮಾಡಿದ್ದರಿಂದ ಅವನು ಗತಿಸಿ ಹೋಗುವನು.","poem":1},{"lineBreak":true},{"text":"ನೀನು ಅವನ ಮುಖವನ್ನು ಮಾರ್ಪಡಿಸಿ ಅವನನ್ನು ತೊಲಗಿಸಿಬಿಡುವಿ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ಅವನ ಮಕ್ಕಳು ಘನತೆಯನ್ನು ಹೊಂದುವುದು ಅವನಿಗೆ ತಿಳಿಯುವುದಿಲ್ಲ.","poem":1},{"lineBreak":true},{"text":"ಅವರು ಅಧೋಗತಿಗೆ ಗುರಿಯಾದರೂ ಅವನಿಗೆ ಗೋಚರವಾಗುವುದಿಲ್ಲ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ಆದರೂ ಅವನ ದೇಹದ ಕಣಕಣವು ನೋವನ್ನು ಅನುಭವಿಸುವುದು,","poem":1},{"lineBreak":true},{"text":"ಅವನ ಆತ್ಮವು ಪ್ರಲಾಪಿಸುವುದು.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kan_irv/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_irv/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_irv/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}