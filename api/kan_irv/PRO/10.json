{"translation":{"id":"kan_irv","name":"ಇಂಡಿಯನ್ ರಿವೈಜ್ಡ್ ವರ್ಸನ್ (IRV) - ಕನ್ನಡ - 2019","website":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseNotes":null,"shortName":"IRV","englishName":"Kannada Indian Revised Version Bible","language":"kan","textDirection":"ltr","sha256":"82cc741009376c81c4416c230a757b2e30ef49b2e4672f9831adcedfc26b865f","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31031,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"PRO","translationId":"kan_irv","name":"ಜ್ಞಾನೋಕ್ತಿಗಳು","commonName":"ಜ್ಞಾನೋಕ್ತಿಗಳು","title":"ಜ್ಞಾನೋಕ್ತಿಗಳು","order":20,"numberOfChapters":31,"sha256":"2c58aa5ad6d1e05e40439b2d5dd5f3d8d438cede4cfbad02cb65df37083214f0","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kan_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":10,"content":[{"type":"heading","content":["ಸೊಲೊಮೋನನ ಜ್ಞಾನೋಕ್ತಿಗಳು"]},{"type":"verse","number":1,"content":[{"text":"ಜ್ಞಾನಿಯಾದ ಮಗನಿಂದ ತಂದೆಗೆ ಆನಂದ,","poem":1},{"text":"ಅಜ್ಞಾನಿಯಾದ ಮಗನಿಂದ ತಾಯಿಗೆ ದುಃಖ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ಅನ್ಯಾಯದ ಸಂಪತ್ತು ವ್ಯರ್ಥ,","poem":1},{"text":"ಧರ್ಮವು ಮೃತ್ಯುವಿನಿಂದ ರಕ್ಷಿಸುವಂತದ್ದು.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ಯೆಹೋವನು ನೀತಿವಂತರನ್ನು ಹಸಿವೆಗೊಳಿಸನು,","poem":1},{"text":"ದುಷ್ಟನ ಆಶೆಯನ್ನು ಭಂಗಪಡಿಸುತ್ತಾನೆ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ಜೋಲುಗೈ ದಾರಿದ್ರ್ಯ,","poem":1},{"text":"ಚುರುಕು ಕೈ ತರುವುದು ಐಶ್ವರ್ಯ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ಸುಗ್ಗಿಯಲ್ಲಿ ಕೂಡಿಸುವವನು ಬುದ್ಧಿವಂತನು,","poem":1},{"text":"ಕೊಯ್ಲಿನಲ್ಲಿ ತೂಕಡಿಸುವವನು ನಾಚಿಕೆಗೆಟ್ಟವನು.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ಶಿಷ್ಟನ ತಲೆ ಆಶೀರ್ವಾದದ ನೆಲೆ,","poem":1},{"text":"ದುಷ್ಟನ ಬಾಯಿಗೆ ಬಲಾತ್ಕಾರವೇ ಮುಚ್ಚಳ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ಶಿಷ್ಟರ ಸ್ಮರಣೆಯು ಆಶೀರ್ವಾದಕ್ಕಾಸ್ಪದ,","poem":1},{"text":"ದುಷ್ಟರ ನಾಮವು ನಿರ್ನಾಮಕಾಸ್ಪದ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ಜ್ಞಾನಹೃದಯನು ಆಜ್ಞೆಗಳನ್ನು ಪಾಲಿಸುವನು,","poem":1},{"text":"ಹರಟೆಯ ಮೂರ್ಖನು ಕೆಡವಲ್ಪಡುವನು.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ನಿರ್ದೋಷದ ನಡತೆಯವನು ನಿರ್ಭಯವಾಗಿ ನಡೆಯುವನು,","poem":1},{"text":"ವಕ್ರಮಾರ್ಗಿಯು ಬೈಲಿಗೆ ಬೀಳುವನು.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ಕಣ್ಣು ಮಿಟಕಿಸುವವನು ಕಷ್ಟಕ್ಕೆ ಕಾರಣನು,","poem":1},{"noteId":3},{"text":"ಧೈರ್ಯದಿಂದ ಗದರಿಸುವವನು ಸಮಾಧಾನಕರನು.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ಶಿಷ್ಟನ ಬಾಯಿ ಜೀವದ ಬುಗ್ಗೆ,","poem":1},{"text":"ದುಷ್ಟನ ಬಾಯಲ್ಲಿ ಬಲಾತ್ಕಾರವು ತುಂಬಿ ತುಳುಕುತ್ತದೆ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ದ್ವೇಷವು ಜಗಳಗಳನ್ನೆಬ್ಬಿಸುತ್ತದೆ,","poem":1},{"text":"ಪ್ರೀತಿಯು ಪಾಪಗಳನ್ನೆಲ್ಲಾ ಮುಚ್ಚುತ್ತದೆ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ವಿವೇಕಿಯ ತುಟಿಗಳಿಂದ ಜ್ಞಾನ,","poem":1},{"text":"ಬುದ್ಧಿಹೀನನ ಬೆನ್ನಿಗೆ ಬೆತ್ತ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ಜ್ಞಾನಿಗಳು ತಿಳಿದ ಸಂಗತಿಯನ್ನು ಹೊರಪಡಿಸುವುದಿಲ್ಲ,","poem":1},{"text":"ಮೂರ್ಖನ ಭಾಷಣ ನಾಶನಕ್ಕೆ ಸಮೀಪ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ಐಶ್ವರ್ಯವಂತನಿಗೆ ಐಶ್ವರ್ಯವು ಬಲವಾದ ಕೋಟೆ,","poem":1},{"text":"ಬಡವನಿಗೆ ಅವನ ಬಡತನವೇ ನಾಶನ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ಶಿಷ್ಟನ ದುಡಿತ ಜೀವಾಸ್ಪದ,","poem":1},{"text":"ದುಷ್ಟನ ಆದಾಯ ಪಾಪಾಸ್ಪದ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ಶಿಕ್ಷೆಯನ್ನು ಕೈಕೊಳ್ಳುವವನು ಜೀವದ ಮಾರ್ಗವನ್ನು ತೋರಿಸುವನು,","poem":1},{"text":"ಗದರಿಕೆಯನ್ನು ಕೈಕೊಳ್ಳದವನು ಸನ್ಮಾರ್ಗದಿಂದ ತಪ್ಪಿಸುವನು.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ಹೊಟ್ಟೆಯಲ್ಲಿ ಹಗೆಯನ್ನಿಟ್ಟುಕೊಂಡವನು ಸುಳ್ಳುಗಾರ,","poem":1},{"text":"ಚಾಡಿಗಾರನು ಜ್ಞಾನಹೀನ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ಮಾತಾಳಿಗೆ ಪಾಪ ತಪ್ಪದು,","poem":1},{"text":"ಮೌನಿಯು ವಿವೇಕಿ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ಶಿಷ್ಟರ ನಾಲಿಗೆ ಚೊಕ್ಕ ಬೆಳ್ಳಿ,","poem":1},{"text":"ದುಷ್ಟನ ಹೃದಯ ಮೌಲ್ಯವಿಲ್ಲದ್ದು.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ಶಿಷ್ಟರ ಭಾಷಣ ಬಹುಜನ ಪೋಷಣ,","poem":1},{"text":"ಬುದ್ಧಿಯ ಕೊರತೆ ಮೂರ್ಖರ ನಾಶನ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ಯೆಹೋವನ ಆಶೀರ್ವಾದವು ಭಾಗ್ಯದಾಯಕವು,","poem":1},{"text":"ಅದು ವ್ಯಸನವನ್ನು ಸೇರಿಸದು.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ಅವಿವೇಕಿಗೆ ಕುಯುಕ್ತಿ ವಿನೋದ","poem":1},{"text":"ವಿವೇಕಿಗೆ ಜ್ಞಾನ ವಿನೋದ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ದುಷ್ಟನಿಗೆ ಶಂಕಿಸಿದ್ದೇ ಸಂಭವಿಸುವುದು,","poem":1},{"text":"ಶಿಷ್ಟನಿಗೆ ಇಷ್ಟವು ಲಭಿಸುವುದು.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ಬಿರುಗಾಳಿ ಬೀಸಿದರೆ ದುಷ್ಟನು ಎಲ್ಲೋ!","poem":1},{"text":"ಶಿಷ್ಟನು ಶಾಶ್ವತವಾದ ಕಟ್ಟಡ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ಹಲ್ಲುಗಳಿಗೆ ಹುಳಿಯೂ, ಕಣ್ಣುಗಳಿಗೆ ಹೊಗೆಯೂ ಹೇಗೋ,","poem":1},{"text":"ಯಜಮಾನನಿಗೆ ಸೋಮಾರಿಯು ಹಾಗೆ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ಯೆಹೋವನಿಗೆ ಭಯಪಡುವವರ ದಿನಗಳಿಗೆ ವೃದ್ಧಿ,","poem":1},{"text":"ದುಷ್ಟರ ವರ್ಷಗಳು ಅಲ್ಪ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ಶಿಷ್ಟನ ನಂಬಿಕೆಗೆ ಆನಂದವು ಫಲ,","poem":1},{"text":"ದುಷ್ಟನ ನಿರೀಕ್ಷೆ ನಿಷ್ಫಲ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ಯೆಹೋವನು ಸನ್ಮಾರ್ಗಿಗೆ ಆಶ್ರಯ,","poem":1},{"text":"ಕೆಡುಕನಿಗೆ ನಾಶನ.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ಶಿಷ್ಟರು ಎಂದಿಗೂ ಕದಲರು,","poem":1},{"text":"ದುಷ್ಟರು ದೇಶದಲ್ಲಿ ನಿಲ್ಲರು.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ಶಿಷ್ಟನ ಬಾಯಲ್ಲಿ ಜ್ಞಾನವು ಮೊಳೆಯುವುದು,","poem":1},{"text":"ನೀಚನ ನಾಲಿಗೆ ಕತ್ತರಿಸಲ್ಪಡುವುದು.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ಶಿಷ್ಟನ ತುಟಿಯಲ್ಲಿ ಹಿತವಚನ,","poem":1},{"text":"ದುಷ್ಟನ ಬಾಯಲ್ಲಿ ನೀಚವಚನ.","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"ಅಥವಾ ಹರಟೆಯ ಮೂರ್ಖನು ಕೆಡವಲ್ಪಡುವನು.","reference":{"chapter":10,"verse":10}}]},"thisChapterLink":"/api/kan_irv/PRO/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_irv/PRO/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_irv/PRO/9.json","previousChapterAudioLinks":{},"numberOfVerses":32}