{"translation":{"id":"kan_irv","name":"ಇಂಡಿಯನ್ ರಿವೈಜ್ಡ್ ವರ್ಸನ್ (IRV) - ಕನ್ನಡ - 2019","website":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseNotes":null,"shortName":"IRV","englishName":"Kannada Indian Revised Version Bible","language":"kan","textDirection":"ltr","sha256":"82cc741009376c81c4416c230a757b2e30ef49b2e4672f9831adcedfc26b865f","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31031,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"PRO","translationId":"kan_irv","name":"ಜ್ಞಾನೋಕ್ತಿಗಳು","commonName":"ಜ್ಞಾನೋಕ್ತಿಗಳು","title":"ಜ್ಞಾನೋಕ್ತಿಗಳು","order":20,"numberOfChapters":31,"sha256":"2c58aa5ad6d1e05e40439b2d5dd5f3d8d438cede4cfbad02cb65df37083214f0","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kan_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":11,"content":[{"type":"heading","content":["ದೋಷಿ ಮತ್ತು ನಿರ್ದೋಷಿ"]},{"type":"verse","number":1,"content":[{"text":"ಮೋಸದ ತಕ್ಕಡಿ ಯೆಹೋವನಿಗೆ ಅಸಹ್ಯ,","poem":1},{"text":"ನ್ಯಾಯದ ತೂಕ ಆತನಿಗೆ ಸಂತೋಷ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ಎಲ್ಲಿ ಹೆಮ್ಮೆಯೋ ಅಲ್ಲಿ ನಾಚಿಕೆ,","poem":1},{"text":"ದೀನತೆಯಲ್ಲಿ ಸುಜ್ಞಾನ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ಯಥಾರ್ಥವಂತರಿಗೆ ಸರಳತೆಯು ಮಾರ್ಗದರ್ಶಕ,","poem":1},{"text":"ವಂಚಕರಿಗೆ ವಕ್ರತೆಯು ನಾಶನ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ಧನವು ಕೋಪದ ದಿನದಲ್ಲಿ ವ್ಯರ್ಥ,","poem":1},{"text":"ಧರ್ಮವು ಮರಣವಿಮೋಚಕ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ನಿರ್ದೋಷಿಯ ಧರ್ಮವು ಅವನ ಮಾರ್ಗವನ್ನು ಸರಾಗಮಾಡುವುದು,","poem":1},{"text":"ದುಷ್ಟನು ತನ್ನ ದೋಷದಿಂದಲೇ ಬಿದ್ದುಹೋಗುವನು.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ಧರ್ಮವು ಯಥಾರ್ಥವಂತರನ್ನು ಉದ್ಧರಿಸುವುದು,","poem":1},{"text":"ವಂಚಕರು ತಮ್ಮ ಆಶಾಪಾಶಕ್ಕೆ ಸಿಕ್ಕಿಬೀಳುವರು.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ದುಷ್ಟನು ಸಾಯುವಾಗ ಅವನ ನಿರೀಕ್ಷೆಯು ಹಾಳಾಗುವುದು,","poem":1},{"text":"ಬಲದ ಮೇಲಣ ನಂಬಿಕೆಯು ಬಿದ್ದುಹೋಗುವುದು.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ಶಿಷ್ಟನು ಇಕ್ಕಟ್ಟಿನಿಂದ ಪಾರಾಗುವನು,","poem":1},{"text":"ದುಷ್ಟನು ಅವನಿಗೆ ಬದಲಾಗಿ ಅದರಲ್ಲಿ ಬೀಳುವನು.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ಧರ್ಮಭ್ರಷ್ಟನು ಬಾಯಿಂದ ನೆರೆಯವನನ್ನು ಹಾಳು ಮಾಡುವನು,","poem":1},{"text":"ಶಿಷ್ಟನು ತಿಳಿವಳಿಕೆಯಿಂದ ಉದ್ಧಾರವಾಗುವನು.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ಸಜ್ಜನರು ಸುಖಿಗಳಾದರೆ ಪಟ್ಟಣಕ್ಕೆ ಉಲ್ಲಾಸ,","poem":1},{"text":"ದುರ್ಜನರು ಹಾಳಾದರೆ ಜಯಘೋಷ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ಯಥಾರ್ಥವಂತರ ಆಶೀರ್ವಾದದಿಂದ ಪಟ್ಟಣವು ಉನ್ನತಿಗೆ ಬರುವುದು,","poem":1},{"text":"ಕೆಟ್ಟವರ ಬಾಯಿಂದ ಕೆಡವಲ್ಪಡುವುದು.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ನೆರೆಯವನನ್ನು ಹೀನೈಸುವವನು ಬುದ್ಧಿಹೀನನು,","poem":1},{"text":"ವಿವೇಕಿಯು ಮೌನವಾಗಿರುವನು.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ಚಾಡಿಕೋರನು ಗುಟ್ಟನ್ನು ರಟ್ಟು ಮಾಡುವನು,","poem":1},{"text":"ನಂಬಿಗಸ್ತನು ಸಂಗತಿಗಳನ್ನು ಗುಪ್ತವಾಗಿಡುವನು.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ಉಚಿತಾಲೋಚನೆಯಿಲ್ಲದ ಕಡೆ ಪ್ರಜೆಯು ಬಿದ್ದು ಹೋಗುವುದು,","poem":1},{"text":"ಬಹು ಮಂದಿ ಸಮಾಲೋಚಕರು ಇರುವಲ್ಲಿ","poem":2},{"noteId":4},{"text":"ಸಂರಕ್ಷಣೆ ಇರುವುದು.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ಅನ್ಯನ ಸಾಲಕ್ಕೆ ಹೊಣೆಯಾದರೆ ಹಾನಿ,","poem":1},{"text":"ಅಪರಿಚಿತನ ಹೊಣೆಗೆ ದೂರವಾದರೆ ನಿರ್ಭಯ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ದಯಾಳುವಾದ ಹೆಂಗಸು ಗೌರವವನ್ನು ಪಡೆಯುವಳು,","poem":1},{"text":"ಬಲಾತ್ಕಾರಿಗಳು ಧನವನ್ನು ಮಾತ್ರ ಕೂಡಿಸಿಕೊಳ್ಳುವರು.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ದಯಾಪರನಿಗೆ ಉಪಕಾರವಾಗುವುದು,","poem":1},{"text":"ಕ್ರೂರನು ತನ್ನ ಶರೀರವನ್ನು ಹಿಂಸಿಸುವನು.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ಅಧರ್ಮಿಯ ಸಂಬಳವು ಮೋಸ,","poem":1},{"text":"ನೀತಿಯನ್ನು ಬಿತ್ತುವವನು ಲಾಭವನ್ನು ಪಡೆಯುವನು.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ಧರ್ಮನಿರತನಿಗೆ ಜೀವ,","poem":1},{"text":"ಅಧರ್ಮಾಸಕ್ತನಿಗೆ ಮರಣ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ವಕ್ರಹೃದಯರು ಯೆಹೋವನಿಗೆ ಅಸಹ್ಯರು,","poem":1},{"text":"ಸನ್ಮಾರ್ಗಿಗಳು ಆತನ ದಯೆಗೆ ಪಾತ್ರರು.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ದುಷ್ಟನಿಗೆ ದಂಡನೆ ಖಂಡಿತ,","poem":1},{"text":"ಶಿಷ್ಟವಂಶಕ್ಕೆ ರಕ್ಷಣೆ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ಹಂದಿಯ ಮೂಗಿಗೆ ಚಿನ್ನದ ಮೂಗುತಿಯು ಹೇಗೋ,","poem":1},{"text":"ಅವಿವೇಕಳಿಗೆ ಸೌಂದರ್ಯವು ಹಾಗೆ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ಸಜ್ಜನರ ಆಶೆಯು ಮಂಗಳಾಸ್ಪದ,","poem":1},{"text":"ದುರ್ಜನರ ನಿರೀಕ್ಷೆಯು ರೋಷಾಸ್ಪದ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ಒಬ್ಬನು ತನ್ನ ಧನವನ್ನು ಚೆಲ್ಲಿದರೂ ಅವನಿಗೆ ವೃದ್ಧಿ,","poem":1},{"text":"ಮತ್ತೊಬ್ಬನು ನ್ಯಾಯವಾದದ್ದನ್ನು ಬಿಗಿಹಿಡಿದರೂ ಅವನಿಗೆ ಬಡತನ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ಉದಾರಿಯು ಪುಷ್ಟನಾಗುವನು,","poem":1},{"text":"ನೀರು ಹಾಯಿಸುವವನಿಗೆ ನೀರು ಸಿಕ್ಕುವುದು.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ಧಾನ್ಯವನ್ನು ಬಿಗಿಹಿಡಿಯುವವನ ಮೇಲೆ ಜನರ ಶಾಪ,","poem":1},{"text":"ಮಾರುವವನ ತಲೆಯ ಮೇಲೆ ಆಶೀರ್ವಾದ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ಧರ್ಮಕ್ಕೆ ಆತುರಪಡುವವನಿಗೆ ದಯೆ,","poem":1},{"text":"ಕೇಡನ್ನು ಹುಡುಕುವವನಿಗೆ ಕೇಡೇ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ಧನವನ್ನೇ ನಂಬಿದವನು ಬಿದ್ದುಹೋಗುವನು,","poem":1},{"text":"ಸದ್ಧರ್ಮಿಯು ಕುಡಿಯ ಹಾಗೆ ಚಿಗುರುವನು.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ತನ್ನ ಕುಟುಂಬವನ್ನು ಬಾಧಿಸುವವನಿಗೆ ಗಾಳಿಯೇ ಗಂಟು,","poem":1},{"text":"ಮೂರ್ಖನು ಜ್ಞಾನವಂತನ ಅಧೀನದಲ್ಲಿ ಬಿದ್ದಿರುವನು;","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ಧರ್ಮಾತ್ಮನ ಫಲ ಜೀವವೃಕ್ಷ,","poem":1},{"text":"ಜ್ಞಾನಿಯು ಆತ್ಮಗಳನ್ನು ಆಕರ್ಷಿಸುವನು.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ಶಿಷ್ಟನು ಭೂಮಿಯಲ್ಲಿ ತನ್ನ ಕ್ರಿಯಾಫಲವನ್ನು ಅನುಭವಿಸುವಲ್ಲಿ,","poem":1},{"text":"ದುಷ್ಟನೂ, ಪಾಪಿಯೂ ದಂಡನೆಯನ್ನು ಅನುಭವಿಸುವರು ಎಂದು ಹೇಳಬೇಕಾಗಿಲ್ಲ.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"ಅಥವಾ ಜಯ.","reference":{"chapter":11,"verse":14}}]},"thisChapterLink":"/api/kan_irv/PRO/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_irv/PRO/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_irv/PRO/10.json","previousChapterAudioLinks":{},"numberOfVerses":31}