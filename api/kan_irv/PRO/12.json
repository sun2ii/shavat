{"translation":{"id":"kan_irv","name":"ಇಂಡಿಯನ್ ರಿವೈಜ್ಡ್ ವರ್ಸನ್ (IRV) - ಕನ್ನಡ - 2019","website":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseNotes":null,"shortName":"IRV","englishName":"Kannada Indian Revised Version Bible","language":"kan","textDirection":"ltr","sha256":"82cc741009376c81c4416c230a757b2e30ef49b2e4672f9831adcedfc26b865f","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31031,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"PRO","translationId":"kan_irv","name":"ಜ್ಞಾನೋಕ್ತಿಗಳು","commonName":"ಜ್ಞಾನೋಕ್ತಿಗಳು","title":"ಜ್ಞಾನೋಕ್ತಿಗಳು","order":20,"numberOfChapters":31,"sha256":"2c58aa5ad6d1e05e40439b2d5dd5f3d8d438cede4cfbad02cb65df37083214f0","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kan_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"ತಿಳಿವಳಿಕೆಯನ್ನು ಪ್ರೀತಿಸುವವನು ಶಿಕ್ಷಣವನ್ನು ಪ್ರೀತಿಸುತ್ತಾನೆ,","poem":1},{"text":"ಮೂರ್ಖನು ಗದರಿಕೆಯನ್ನು ದ್ವೇಷಿಸುತ್ತಾನೆ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ಯೆಹೋವನು ಒಳ್ಳೆಯವನಿಗೆ ದಯೆತೋರಿಸುವನು,","poem":1},{"text":"ಕುಯುಕ್ತಿಯುಳ್ಳವನನ್ನು ಕೆಟ್ಟವನೆಂದು ನಿರ್ಣಯಿಸುವನು.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ಯಾರೂ ದುಷ್ಟತನದಿಂದ ಸ್ಥಿರನಾಗನು,","poem":1},{"text":"ಶಿಷ್ಟನು ಯಾವಾಗಲೂ ದೃಢಮೂಲನೇ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ಗುಣವತಿಯಾದ ಸ್ತ್ರೀಯು ಪತಿಯ ತಲೆಗೆ ಕಿರೀಟ,","poem":1},{"text":"ಮಾನ ಕಳೆಯುವವಳು ಪತಿಯ ಎಲುಬಿಗೆ ಕ್ಷಯ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ಶಿಷ್ಟರ ಉದ್ದೇಶ ನ್ಯಾಯ,","poem":1},{"text":"ದುಷ್ಟರ ಆಲೋಚನೆ ಮೋಸ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ಕೆಟ್ಟವರ ಮಾತು ರಕ್ತಕ್ಕೆ ಹೊಂಚು,","poem":1},{"text":"ಯಥಾರ್ಥವಂತರ ನುಡಿ ಪ್ರಾಣರಕ್ಷಣೆ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ದುರ್ಜನರು ಕೆಡವಲ್ಪಟ್ಟು ನಿರ್ಮೂಲರಾಗುವರು,","poem":1},{"text":"ಸಜ್ಜನರ ಮನೆಯು ಸ್ಥಿರವಾಗಿ ನಿಲ್ಲುವುದು.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ಬುದ್ಧಿವಂತನನ್ನು ಅವನ ಬುದ್ಧಿಗೆ ತಕ್ಕಂತೆ ಹೊಗಳುವರು,","poem":1},{"text":"ವಕ್ರಬುದ್ಧಿಯುಳ್ಳವನನ್ನು ತಿರಸ್ಕರಿಸುವರು.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ಹೊಟ್ಟೆಗಿಲ್ಲದ ಡಾಂಭಿಕನಿಗಿಂತಲೂ","poem":1},{"text":"ಸೇವಕನುಳ್ಳ ಸಾಧಾರಣ ಮನುಷ್ಯನ ಸ್ಥಿತಿಯೇ ಲೇಸು.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ಶಿಷ್ಟನು ತನ್ನ ಪಶುಗಳ ಕ್ಷೇಮವನ್ನು ಲಕ್ಷಿಸುತ್ತಾನೆ,","poem":1},{"text":"ದುಷ್ಟನ ವಾತ್ಸಲ್ಯವೋ ಕ್ರೂರತನವೇ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ದುಡಿದು ಹೊಲಗೇಯುವವನು ಹೊಟ್ಟೆತುಂಬಾ ಉಣ್ಣುವನು,","poem":1},{"text":"ವ್ಯರ್ಥಕಾರ್ಯಾಸಕ್ತನು ಬುದ್ಧಿಹೀನನೇ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ಕೆಡುಕರ ಕೊಳ್ಳೆಯು ದುಷ್ಟರಿಗೆ ಇಷ್ಟ,","poem":1},{"text":"ಆದರೆ ಶಿಷ್ಟರ ಬುಡ ಫಲದಾಯಕ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ದುಷ್ಟನು ತನ್ನ ತುಟಿಗಳ ದೋಷದಿಂದ ಬೋನಿಗೆ ಬೀಳುವನು,","poem":1},{"text":"ಶಿಷ್ಟನು ಇಕ್ಕಟ್ಟಿನಿಂದ ಪಾರಾಗುವನು.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ಬಾಯಿಯ ಫಲವಾಗಿ ಮನುಷ್ಯನು ಬೇಕಾದಷ್ಟು ಸುಖವನ್ನು ಅನುಭವಿಸುವನು,","poem":1},{"text":"ಅವನ ಕೈಕೆಲಸದ ಫಲವು ಅವನಿಗೆ ಪ್ರಾಪ್ತವಾಗುವುದು.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ಮೂರ್ಖನ ನಡತೆ ಅವನ ದೃಷ್ಟಿಗೆ ಸರಿ,","poem":1},{"text":"ಜ್ಞಾನಿಯು ಉಚಿತಾಲೋಚನೆಯನ್ನು ಗಮನಿಸುವನು.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ಮೂರ್ಖನ ಸಿಟ್ಟು ತಟ್ಟನೆ ರಟ್ಟಾಗುವುದು,","poem":1},{"text":"ಜಾಣನು ಅವಮಾನವನ್ನು ಮರೆಮಾಡುವನು.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ಸತ್ಯವನ್ನಾಡುವವನು ನ್ಯಾಯವನ್ನು ತೋರ್ಪಡಿಸುವನು,","poem":1},{"text":"ಸುಳ್ಳುಸಾಕ್ಷಿಯು ಅಸತ್ಯವನ್ನು ನುಡಿಯುವನು.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ಕತ್ತಿ ತಿವಿದ ಹಾಗೆ ದುಡುಕಿ ಮಾತನಾಡುವವರುಂಟು,","poem":1},{"text":"ಜ್ಞಾನವಂತರ ಮಾತು ಸ್ವಸ್ಥತೆಯನ್ನು ತರುವುದು.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ಸತ್ಯದ ತುಟಿ ಶಾಶ್ವತ,","poem":1},{"text":"ಸುಳ್ಳಿನ ನಾಲಿಗೆ ಕ್ಷಣಿಕ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ಕೇಡನ್ನು ಕಲ್ಪಿಸುವವರ ಹೃದಯದಲ್ಲಿ ಮೋಸ,","poem":1},{"text":"ಹಿತೋಪದೇಶಕರ ಮನಸ್ಸಿನಲ್ಲಿ ಉಲ್ಲಾಸ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ಸಜ್ಜನರಿಗೆ ಯಾವ ಹಾನಿಯೂ ಸಂಭವಿಸದು,","poem":1},{"text":"ದುರ್ಜನರಿಗೆ ಕೇಡು ತುಂಬಿ ತುಳುಕುವುದು.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ಸುಳ್ಳುತುಟಿ ಯೆಹೋವನಿಗೆ ಅಸಹ್ಯವಾಗಿವೆ.","poem":1},{"text":"ಸತ್ಯವಂತರು ಆತನಿಗೆ ಆನಂದ ತರುತ್ತಾರೆ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ಜಾಣನು ತನ್ನ ಜ್ಞಾನವನ್ನು ಗುಪ್ತಪಡಿಸುವನು,","poem":1},{"text":"ಮೂಢರ ಮನಸ್ಸು ಮೂರ್ಖತನವನ್ನು ಪ್ರಕಟಿಸುವುದು.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ಚುರುಕುಗೈಯವನಿಗೆ ರಾಜ್ಯಾಧಿಕಾರ,","poem":1},{"text":"ಮೈಗಳ್ಳನಿಗೆ ದಾಸತ್ವದ ಬದುಕು.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ಕಳವಳವು ಮನಸ್ಸನ್ನು ಕುಗ್ಗಿಸುವುದು,","poem":1},{"text":"ಕನಿಕರದ ಮಾತು ಅದನ್ನು ಹಿಗ್ಗಿಸುವುದು.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ಸನ್ಮಾರ್ಗಿಯು ನೆರೆಯವನಿಗೆ ಮಾರ್ಗತೋರಿಸುವನು,","poem":1},{"text":"ದುರ್ಮಾರ್ಗಿಯು ಮಾರ್ಗತಪ್ಪಿಸುವನು.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ಮೈಗಳ್ಳನು ಹಿಡಿದ ಬೇಟೆಯನ್ನೂ ಅನುಭವಿಸಲಾರನು,","poem":1},{"text":"ಸನ್ಮಾರ್ಗದಲ್ಲಿ ನಡೆಯುವವನಿಗೆ ಅಮೂಲ್ಯ ಸಂಪತ್ತು ದೊರಕುವುದು.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ಧರ್ಮಮಾರ್ಗದಿಂದ ಜೀವಲಾಭವು,","poem":1},{"text":"ಆ ಮಾರ್ಗದಲ್ಲಿ ಮರಣವಿಲ್ಲ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kan_irv/PRO/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_irv/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_irv/PRO/11.json","previousChapterAudioLinks":{},"numberOfVerses":28}