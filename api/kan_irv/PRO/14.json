{"translation":{"id":"kan_irv","name":"ಇಂಡಿಯನ್ ರಿವೈಜ್ಡ್ ವರ್ಸನ್ (IRV) - ಕನ್ನಡ - 2019","website":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseNotes":null,"shortName":"IRV","englishName":"Kannada Indian Revised Version Bible","language":"kan","textDirection":"ltr","sha256":"82cc741009376c81c4416c230a757b2e30ef49b2e4672f9831adcedfc26b865f","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31031,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"PRO","translationId":"kan_irv","name":"ಜ್ಞಾನೋಕ್ತಿಗಳು","commonName":"ಜ್ಞಾನೋಕ್ತಿಗಳು","title":"ಜ್ಞಾನೋಕ್ತಿಗಳು","order":20,"numberOfChapters":31,"sha256":"2c58aa5ad6d1e05e40439b2d5dd5f3d8d438cede4cfbad02cb65df37083214f0","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kan_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"ಜ್ಞಾನವಂತೆಯು ತನ್ನ ಮನೆಯನ್ನು ಕಟ್ಟಿಕೊಳ್ಳುವಳು,","poem":1},{"text":"ಜ್ಞಾನಹೀನಳು ಅದನ್ನು ಸ್ವಂತ ಕೈಯಿಂದ ನಾಶಮಾಡುವಳು.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ಸರಳಮಾರ್ಗಿಯು ಯೆಹೋವನಿಗೆ ಭಯಪಡುವನು,","poem":1},{"text":"ವಕ್ರಮಾರ್ಗಿಯು ಆತನನ್ನು ಅಸಡ್ಡೆಮಾಡುವನು.","poem":2}]},{"type":"verse","number":3,"content":[{"noteId":5},{"text":"ಮೂರ್ಖನ ಮಾತುಗಳು ಅವನ ಬೆನ್ನಿಗೆ ಬೆತ್ತ,","poem":1},{"text":"ಜ್ಞಾನಿಗಳ ತುಟಿಗಳು ಅವರನ್ನು ಕಾಯುವವು.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ಎತ್ತುಗಳಿಲ್ಲದಿರುವಾಗ ಗೋದಲಿಯು ಶುದ್ಧ,","poem":1},{"text":"ಆದರೆ ಎತ್ತಿನ ಶಕ್ತಿಯಿಂದಲೇ ಬೆಳೆಯ ವೃದ್ಧಿಯಾಗುವುದು.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ಸತ್ಯಸಾಕ್ಷಿಯು ಸುಳ್ಳಾಡನು,","poem":1},{"text":"ಸುಳ್ಳುಸಾಕ್ಷಿಯು ಅಸತ್ಯವನ್ನೇ ಆಡುವನು.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ಧರ್ಮನಿಂದಕನಲ್ಲಿ ಹುಡುಕಿದರೂ ಜ್ಞಾನವು ಸಿಕ್ಕದು,","poem":1},{"text":"ವಿವೇಕಿಗೆ ತಿಳಿವಳಿಕೆಯು ಸುಲಭವಾಗಿ ದೊರೆಯುವುದು.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ನೀನು ಜ್ಞಾನಹೀನನ ಬಳಿಗೆ ಹೋದರೆ ಅವನ ತುಟಿಗಳಲ್ಲಿ ಯಾವ ತಿಳಿವಳಿಕೆಯನ್ನೂ ಕಾಣಲಾರೆ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ಸನ್ಮಾರ್ಗವನ್ನು ಗ್ರಹಿಸಿಕೊಳ್ಳುವುದೇ ಜಾಣನ ಜ್ಞಾನ,","poem":1},{"text":"ಮೂಢರ ಮೂರ್ಖತನ ಮೋಸಕರ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ಮೂರ್ಖರನ್ನು ಅವರ ದೋಷವೇ ಹಾಸ್ಯಮಾಡುವುದು,","poem":1},{"text":"ಯಥಾರ್ಥವಂತರಲ್ಲಿ (ದೇವರ) ದಯೆಯಿರುವುದು.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ಪ್ರತಿಯೊಬ್ಬನು ತನ್ನ ಹೃದಯದ ವ್ಯಾಕುಲವನ್ನು ತಾನು ಗ್ರಹಿಸಿಕೊಳ್ಳುವನು,","poem":1},{"text":"ಅವನ ಆನಂದದಲ್ಲಿಯೂ ಬೇರೆಯವರು ಪಾಲುಗಾರರಾಗುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ದುಷ್ಟರ ಮನೆಗೆ ನಾಶನ,","poem":1},{"text":"ಶಿಷ್ಟರ ಗುಡಾರಕ್ಕೆ ಏಳಿಗೆ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ಮನುಷ್ಯನ ದೃಷ್ಟಿಗೆ ಸರಳವಾಗಿ ತೋರುವ ಒಂದು ದಾರಿಯುಂಟು.","poem":1},{"text":"ಅದು ಕಟ್ಟಕಡೆಗೆ ಮರಣಮಾರ್ಗವೇ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ನಗುವವನಿಗೂ ಮನೋವ್ಯಥೆಯುಂಟು,","poem":1},{"text":"ಉಲ್ಲಾಸದ ಅಂತ್ಯವು ವ್ಯಾಕುಲವೇ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ಭ್ರಷ್ಟನು ಕರ್ಮಫಲವನ್ನು ತಿಂದು ತಿಂದು ದಣಿಯುವನು,","poem":1},{"text":"ಶಿಷ್ಟನು ತನ್ನಲ್ಲಿ ತಾನೇ ತೃಪ್ತನಾಗುವನು.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ಮೂಢನು ಯಾವ ಮಾತನ್ನಾದರೂ ನಂಬುವನು,","poem":1},{"text":"ಜಾಣನು ತನ್ನ ನಡತೆಯನ್ನು ಚೆನ್ನಾಗಿ ಗಮನಿಸುವನು.","poem":2}]},{"type":"verse","number":16,"content":[{"noteId":6},{"text":"ಜ್ಞಾನಿಯು ಕೇಡಿಗೆ ಭಯಪಟ್ಟು ಓರೆಯಾಗುವನು,","poem":1},{"text":"ಜ್ಞಾನಹೀನನು ಸೊಕ್ಕಿನಿಂದ ಭಯವನ್ನು ಲಕ್ಷಿಸನು.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ಮುಂಗೋಪಿಯು ಬುದ್ಧಿಹೀನನಾಗಿ ವರ್ತಿಸುವನು,","poem":1},{"noteId":7},{"text":"ಕುಯುಕ್ತಿಯುಳ್ಳವನು ದ್ವೇಷಕ್ಕೆ ಪಾತ್ರನು.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ಮೂರ್ಖರಿಗೆ ಮೂರ್ಖತನವೇ ಸ್ವತ್ತು,","poem":1},{"text":"ಜಾಣರಿಗೆ ಜ್ಞಾನವೇ ಕಿರೀಟ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ಕೆಟ್ಟವರು ಒಳ್ಳೆಯವರಿಗೆ ಬಾಗುವರು,","poem":1},{"text":"ದುಷ್ಟರು ಶಿಷ್ಟರ ಬಾಗಿಲಲ್ಲಿ ಅಡ್ಡಬೀಳುವರು.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ಬಡವನು ನೆರೆಯವನಿಗೂ ಅಸಹ್ಯ,","poem":1},{"text":"ಧನವಂತನಿಗೆ ಬಹು ಜನ ಮಿತ್ರರು.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ನೆರೆಯವನನ್ನು ತಿರಸ್ಕರಿಸುವವನು ದೋಷಿ,","poem":1},{"text":"ದರಿದ್ರನನ್ನು ಕನಿಕರಿಸುವವನು ಧನ್ಯನು.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ಕುಯುಕ್ತಿಯುಳ್ಳವರು ದಾರಿತಪ್ಪಿದವರೇ ಸರಿ,","poem":1},{"text":"ಒಳ್ಳೆಯದನ್ನು ಕಲ್ಪಿಸುವವರು ಪ್ರೀತಿಸತ್ಯತೆಗಳಿಗೆ ಪಾತ್ರರು.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ಶ್ರಮೆಯಿಂದ ಸಮೃದ್ಧಿ,","poem":1},{"text":"ಹರಟೆಯಿಂದ ಕೊರತೆ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ಜ್ಞಾನಿಗಳ ಜ್ಞಾನಕಿರೀಟವೇ ಅವರ ಶ್ರೇಷ್ಠ ಸಂಪತ್ತು,","poem":1},{"text":"ಜ್ಞಾನಹೀನರ ಮೂರ್ಖತನವು ಬರೀ ಮೂರ್ಖತನವೇ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ಸತ್ಯಸಾಕ್ಷಿಯು ಪ್ರಾಣರಕ್ಷಕ,","poem":1},{"text":"ಸುಳ್ಳುಸಾಕ್ಷಿಯು ವಂಚಕ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ಯೆಹೋವನಿಗೆ ಭಯಪಡುವುದರಿಂದ ಕೇವಲ ನಿರ್ಭಯ,","poem":1},{"text":"ಆತನ ಮಕ್ಕಳಿಗೆ ಆಶ್ರಯವಿದ್ದೇ ಇರುವುದು.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ಯೆಹೋವನ ಭಯ ಜೀವದ ಬುಗ್ಗೆ,","poem":1},{"text":"ಮೃತ್ಯುಪಾಶದಿಂದ ತಪ್ಪಿಸಿಕೊಳ್ಳಲು ಅದು ಸಾಧನವಾಗಿದೆ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ಪ್ರಜೆಗಳ ವೃದ್ಧಿ ರಾಜನ ಮಹಿಮೆ,","poem":1},{"text":"ಪ್ರಜೆಗಳ ನಾಶ ಪ್ರಭುವಿಗೆ ಭಯ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ದೀರ್ಘಶಾಂತನು ಕೇವಲ ಬುದ್ಧಿವಂತನು,","poem":1},{"text":"ಮುಂಗೋಪಿಯು ಮೂರ್ಖತನವನ್ನು ಧ್ವಜವಾಗಿ ಎತ್ತುವನು.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ಶಾಂತಗುಣವು ದೇಹಕ್ಕೆ ಜೀವಾಧಾರವು,","poem":1},{"text":"ಕ್ರೋಧವು ಎಲುಬಿಗೆ ಕ್ಷಯವು.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ಬಡವರನ್ನು ಹಿಂಸಿಸುವವನು ಸೃಷ್ಟಿಕರ್ತನನ್ನು ಹೀನೈಸುವನು,","poem":1},{"text":"ಗತಿಯಿಲ್ಲದವರನ್ನು ಕರುಣಿಸುವವನು ಆತನನ್ನು ಘನಪಡಿಸುವನು.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ದುಷ್ಟನು ವಿಪತ್ತಿಗೊಳಗಾಗಿ ಹಾಳಾಗುವನು,","poem":1},{"text":"ಶಿಷ್ಟನು","poem":2},{"noteId":8},{"text":"ಮರಣಕಾಲದಲ್ಲಿಯೂ ಆಶ್ರಯಹೊಂದುವನು.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ವಿವೇಕಿಯ ಹೃದಯ ಜ್ಞಾನಾಶ್ರಯ,","poem":1},{"text":"ಜ್ಞಾನಹೀನನ ಹೃದಯದಲ್ಲಿ ಅದು ಕಾಣದು.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ಪ್ರಜೆಗೆ ಧರ್ಮವು ಉನ್ನತಿ,","poem":1},{"text":"ಅಧರ್ಮವು ಅವಮಾನ.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ಜಾಣನಾದ ಸೇವಕನಿಗೆ ರಾಜನ ಕೃಪೆ,","poem":1},{"text":"ಮಾನಗೇಡಿಗೆ ರಾಜನ ರೌದ್ರ.","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"ಅಥವಾ ಮೂರ್ಖನ ಬಾಯಲ್ಲಿ ಗರ್ವವು ಅಂಕುರಿಸುವದು,","reference":{"chapter":14,"verse":3}},{"noteId":6,"caller":"+","text":"ಅಥವಾ ಜ್ಞಾನಿಯು ಯೆಹೋವನಿಗೆ ಭಯಪಡುತ್ತಾನೆ","reference":{"chapter":14,"verse":16}},{"noteId":7,"caller":"+","text":"ಅಥವಾ ಜ್ಞಾನಿಗಳು ಮೌನವಾಗಿರುತ್ತಾರೆ.","reference":{"chapter":14,"verse":17}},{"noteId":8,"caller":"+","text":"ಅಥವಾ ತನ್ನ ಸತ್ಯದಲ್ಲಿ.","reference":{"chapter":14,"verse":32}}]},"thisChapterLink":"/api/kan_irv/PRO/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_irv/PRO/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_irv/PRO/13.json","previousChapterAudioLinks":{},"numberOfVerses":35}