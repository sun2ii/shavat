{"translation":{"id":"kan_irv","name":"ಇಂಡಿಯನ್ ರಿವೈಜ್ಡ್ ವರ್ಸನ್ (IRV) - ಕನ್ನಡ - 2019","website":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseNotes":null,"shortName":"IRV","englishName":"Kannada Indian Revised Version Bible","language":"kan","textDirection":"ltr","sha256":"82cc741009376c81c4416c230a757b2e30ef49b2e4672f9831adcedfc26b865f","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31031,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"PRO","translationId":"kan_irv","name":"ಜ್ಞಾನೋಕ್ತಿಗಳು","commonName":"ಜ್ಞಾನೋಕ್ತಿಗಳು","title":"ಜ್ಞಾನೋಕ್ತಿಗಳು","order":20,"numberOfChapters":31,"sha256":"2c58aa5ad6d1e05e40439b2d5dd5f3d8d438cede4cfbad02cb65df37083214f0","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kan_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"ಮೃದುವಾದ ಪ್ರತ್ಯುತ್ತರವು ಸಿಟ್ಟನ್ನಾರಿಸುವುದು,","poem":1},{"text":"ಬಿರುನುಡಿಯು ಸಿಟ್ಟನ್ನೇರಿಸುವುದು.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ಜ್ಞಾನಿಗಳ ನಾಲಿಗೆಯು ತಿಳಿವಳಿಕೆಯನ್ನು ಸಾರ್ಥಕ ಮಾಡುವುದು,","poem":1},{"text":"ಜ್ಞಾನಹೀನರ ಬಾಯಿಯು ಮೂರ್ಖತನವನ್ನು ಕಾರುವುದು.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ಯೆಹೋವನ ದೃಷ್ಟಿಯು ಎಲ್ಲೆಲ್ಲಿಯೂ ಇರುವುದು,","poem":1},{"text":"ಆತನು ಕೆಟ್ಟವರನ್ನು ಮತ್ತು ಒಳ್ಳೆಯವರನ್ನು ನೋಡುತ್ತಲೇ ಇರುವನು.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ಸಂತೈಸುವ ನಾಲಿಗೆ ಜೀವವೃಕ್ಷವು,","poem":1},{"text":"ಬಲತ್ಕರಿಸುವ ನಾಲಿಗೆ ಮನಮುರಿಯುವುದು.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ಮೂರ್ಖನು ತಂದೆಯ ಶಿಕ್ಷೆಯನ್ನು ತಿರಸ್ಕರಿಸುವನು,","poem":1},{"text":"ಗದರಿಕೆಯನ್ನು ಗಮನಿಸುವವನು ಜಾಣನು.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ಶಿಷ್ಟನ ಮನೆಯಲ್ಲಿ ದೊಡ್ಡ ನಿಧಿ,","poem":1},{"text":"ದುಷ್ಟನ ಆದಾಯವು ನಷ್ಟಕ್ಕೆ ದಾರಿ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ಜ್ಞಾನಿಗಳ ತುಟಿಗಳು ತಿಳಿವಳಿಕೆಯನ್ನು ಬಿತ್ತುವವು.","poem":1},{"text":"ಜ್ಞಾನಹೀನರ ಹೃದಯವು ಅದನ್ನು ಬಿತ್ತುವುದೇ ಇಲ್ಲ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ದುಷ್ಟರ ಯಜ್ಞ ಯೆಹೋವನಿಗೆ ಅಸಹ್ಯ,","poem":1},{"text":"ಶಿಷ್ಟರ ಬಿನ್ನಹ ಆತನಿಗೆ ಇಷ್ಟ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ದುಷ್ಟನ ನಡತೆಯು ಯೆಹೋವನಿಗೆ ಅಸಹ್ಯ,","poem":1},{"text":"ಧರ್ಮಾಸಕ್ತನು ಆತನಿಗೆ ಪ್ರಿಯ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ಧರ್ಮಮಾರ್ಗವನ್ನು ಬಿಟ್ಟವನಿಗೆ ತೀಕ್ಷ್ಣ ಶಿಕ್ಷಣ,","poem":1},{"text":"ಗದರಿಕೆಯನ್ನು ಕೇಳದವನಿಗೆ ಸಾವು.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ಪಾತಾಳವೂ, ನಾಶಲೋಕವೂ ಯೆಹೋವನಿಗೆ ಗೋಚರವಾಗಿರುವಲ್ಲಿ","poem":1},{"text":"ನರವಂಶದವರ ಹೃದಯಗಳು ಆತನಿಗೆ ಮತ್ತೂ ಸ್ಪಷ್ಟ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ಧರ್ಮನಿಂದಕನು ಗದರಿಕೆಯನ್ನು ಕೇಳನು,","poem":1},{"text":"ಜ್ಞಾನಿಗಳ ಸಂಗಡ ಸೇರನು.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ಹರ್ಷ ಹೃದಯದಿಂದ ಹಸನ್ಮುಖ,","poem":1},{"text":"ಮನೋವ್ಯಥೆಯಿಂದ ಆತ್ಮಭಂಗ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ವಿವೇಕಿಯ ಹೃದಯ ತಿಳಿವಳಿಕೆಯನ್ನು ಹುಡುಕುವುದು,","poem":1},{"text":"ಮೂಢರ ಬಾಯಿ ಮೂರ್ಖತನವನ್ನು ಮುಕ್ಕುವುದು.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ದೀನನ ದಿನಗಳೆಲ್ಲಾ ದುಃಖಭರಿತ,","poem":1},{"text":"ಹರ್ಷಹೃದಯನಿಗೆ ನಿತ್ಯವೂ ಔತಣ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ಕಳವಳದಿಂದ ಕೂಡಿದ ಬಹುಧನಕ್ಕಿಂತಲೂ","poem":1},{"text":"ಯೆಹೋವನ ಭಯದಿಂದ ಕೂಡಿದ ಅಲ್ಪ ಧನವೇ ಲೇಸು.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ದ್ವೇಷವಿರುವಲ್ಲಿ ಮೃಷ್ಟಾನ್ನಕ್ಕಿಂತಲೂ,","poem":1},{"text":"ಪ್ರೇಮವಿರುವಲ್ಲಿ ಸೊಪ್ಪಿನ ಊಟವೇ ಉತ್ತಮ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ಕೋಪಿಷ್ಠನು ವ್ಯಾಜ್ಯವನ್ನೆಬ್ಬಿಸುವನು,","poem":1},{"text":"ದೀರ್ಘಶಾಂತನು ಜಗಳವನ್ನು ಶಮನಪಡಿಸುವನು.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ಸೋಮಾರಿಯ ಮಾರ್ಗ ಮುಳ್ಳುಬೇಲಿ,","poem":1},{"text":"ಯಥಾರ್ಥವಂತನ ಮಾರ್ಗ ರಾಜಮಾರ್ಗ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ಜ್ಞಾನವಂತನಾದ ಮಗನು ತಂದೆಯನ್ನು ಉಲ್ಲಾಸಗೊಳಿಸುವನು,","poem":1},{"text":"ಜ್ಞಾನಹೀನನು ತಾಯಿಯನ್ನು ತಿರಸ್ಕರಿಸುವನು.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ಬುದ್ಧಿಹೀನನು ಮೂರ್ಖತನದಲ್ಲಿ ಆನಂದಿಸುವನು,","poem":1},{"text":"ಬುದ್ಧಿವಂತನು ತನ್ನ ಮಾರ್ಗವನ್ನು ಸರಳಮಾಡಿಕೊಳ್ಳುವನು.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ಆಲೋಚನೆ ಹೇಳುವವರಿಲ್ಲದೆ ಉದ್ದೇಶಗಳು ನೆರವೇರವು,","poem":1},{"text":"ಬಹು ಮಂದಿ ಆಲೋಚನಾಪರರು ಇರುವಲ್ಲಿ ಅವು ನೆರವೇರುವವು.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ತಕ್ಕ ಉತ್ತರಕೊಡುವವನಿಗೆ ಎಷ್ಟೋ ಸಂತೋಷ!","poem":1},{"text":"ಸಮಯೋಚಿತವಾದ ನುಡಿಯಲ್ಲಿ ಎಷ್ಟೋ ಸ್ವಾರಸ್ಯ!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ಜೀವದ ಮಾರ್ಗವು ವಿವೇಕಿಯನ್ನು ಮೇಲಕ್ಕೆತ್ತುವುದು;","poem":1},{"text":"ಅದು ಅವನನ್ನು ಪಾತಾಳದಿಂದ ತಪ್ಪಿಸುವುದು.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ಯೆಹೋವನು ಗರ್ವಿಷ್ಠನ ಮನೆಯನ್ನು ಕೆಡವಿಬಿಡುವನು;","poem":1},{"text":"ವಿಧವೆಯ ಮೇರೆಯನ್ನು ನೆಲೆಗೊಳಿಸುವನು.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ಕುಯುಕ್ತಿಯು ಯೆಹೋವನಿಗೆ ಅಸಹ್ಯ,","poem":1},{"text":"ನಯನುಡಿಯು ಆತನಿಗೆ ಪ್ರಿಯ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ಸೂರೆಮಾಡುವವನು ಸ್ವಂತ ಮನೆಯನ್ನು ಬಾಧಿಸುವನು.","poem":1},{"text":"ಲಂಚವನ್ನೊಪ್ಪದವನು ಸುಖವಾಗಿ ಬಾಳುವನು.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ಶಿಷ್ಟನ ಹೃದಯ ವಿವೇಚಿಸಿ ಉತ್ತರಕೊಡುತ್ತದೆ,","poem":1},{"text":"ದುಷ್ಟನ ಬಾಯಿ ಕೆಟ್ಟದ್ದನ್ನು ಕಾರುತ್ತದೆ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ಯೆಹೋವನು ದುಷ್ಟರಿಗೆ ದೂರ,","poem":1},{"text":"ಶಿಷ್ಟರ ಬಿನ್ನಹಕ್ಕೆ ಹತ್ತಿರ.","poem":2}]},{"type":"verse","number":30,"content":[{"noteId":9},{"text":"ಹಸನ್ಮುಖ ಹೃದಯಕ್ಕೆ ಆನಂದ,","poem":1},{"noteId":10},{"text":"ಶುಭಸಮಾಚಾರ ದೇಹಕ್ಕೆ ಆರೋಗ್ಯ.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ಜೀವಪ್ರದವಾದ ಗದರಿಕೆಗೆ ಕಿವಿಗೊಡುವವನು,","poem":1},{"text":"ಜ್ಞಾನಿಗಳ ನಡುವೆ ನೆಲೆಗೊಳ್ಳುವನು.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ಶಿಕ್ಷೆಯನ್ನು ತಿರಸ್ಕರಿಸುವವನು ತನ್ನನ್ನೇ ನಿರಾಕರಿಸಿಕೊಳ್ಳುವನು,","poem":1},{"text":"ಗದರಿಕೆಯನ್ನು ಕೇಳುವವನು ಬುದ್ಧಿಯನ್ನು ಪಡೆಯುವನು.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ಯೆಹೋವನ ಭಯವೇ ಜ್ಞಾನೋಪದೇಶ,","poem":1},{"text":"ಗೌರವಕ್ಕೆ ಮೊದಲು ವಿನಯ.","poem":2}]}],"footnotes":[{"noteId":9,"caller":"+","text":"ಮೂಲತಃ ಕಣ್ಣಿನ ಬೆಳಕು.","reference":{"chapter":15,"verse":30}},{"noteId":10,"caller":"+","text":"ಮೂಲತಃ ಕಿವಿಗೆ ಬಿದ್ದ ಒಳ್ಳೆಯ ಸುದ್ದಿ ಎಲುಬಿಗೆ ಪುಷ್ಟಿ.","reference":{"chapter":15,"verse":30}}]},"thisChapterLink":"/api/kan_irv/PRO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_irv/PRO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_irv/PRO/14.json","previousChapterAudioLinks":{},"numberOfVerses":33}