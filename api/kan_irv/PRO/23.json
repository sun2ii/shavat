{"translation":{"id":"kan_irv","name":"ಇಂಡಿಯನ್ ರಿವೈಜ್ಡ್ ವರ್ಸನ್ (IRV) - ಕನ್ನಡ - 2019","website":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseNotes":null,"shortName":"IRV","englishName":"Kannada Indian Revised Version Bible","language":"kan","textDirection":"ltr","sha256":"82cc741009376c81c4416c230a757b2e30ef49b2e4672f9831adcedfc26b865f","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31031,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"PRO","translationId":"kan_irv","name":"ಜ್ಞಾನೋಕ್ತಿಗಳು","commonName":"ಜ್ಞಾನೋಕ್ತಿಗಳು","title":"ಜ್ಞಾನೋಕ್ತಿಗಳು","order":20,"numberOfChapters":31,"sha256":"2c58aa5ad6d1e05e40439b2d5dd5f3d8d438cede4cfbad02cb65df37083214f0","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kan_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"ನೀನು ಅಧಿಪತಿಯ ಸಂಗಡ ಊಟಕ್ಕೆ ಕುಳಿತುಕೊಂಡಿರುವಾಗ,","poem":1},{"text":"ನಿನ್ನ ಮುಂದಿಟ್ಟಿರುವುದರ ಬಗ್ಗೆ ಎಚ್ಚರಿಕೆಯಾಗಿರು.","poem":2},{"noteId":13}]},{"type":"verse","number":2,"content":[{"text":"ನೀನು ಹೊಟ್ಟೆಬಾಕನಾಗಿದ್ದರೆ,","poem":1},{"text":"ನಿನ್ನ ಗಂಟಲಿಗೆ ಕತ್ತಿಹಾಕಿಕೋ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ಅವನ ರುಚಿಪದಾರ್ಥಗಳನ್ನು ಬಯಸಬೇಡ,","poem":1},{"text":"ಅದು ಮೋಸದ ಆಹಾರವೇ ಸರಿ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ದುಡ್ಡಿನಾಶೆಯಿಂದ ದುಡಿಯಬೇಡ,","poem":1},{"text":"ಸ್ವಬುದ್ಧಿಯನ್ನೇ ಆಶ್ರಯಿಸಬೇಡ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ನಿನ್ನ ದೃಷ್ಟಿಯು ಐಶ್ವರ್ಯದ ಮೇಲೆ ಎರಗುತ್ತದೋ?","poem":1},{"text":"ಐಶ್ವರ್ಯವು ಅಷ್ಟರೊಳಗೆ ಮಾಯವಾಗುವುದು,","poem":2},{"text":"ಆಕಾಶದ ಕಡೆಗೆ ಹಾರುವ ಹದ್ದಿನಂತೆ,","poem":1},{"text":"ಅದು ರೆಕ್ಕೆಗಳನ್ನು ಕಟ್ಟಿಕೊಂಡಿದೆ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ಲೋಭಿಯ ಅನ್ನವನ್ನು ಉಣ್ಣದಿರು,","poem":1},{"text":"ಅವನ ರುಚಿಪದಾರ್ಥಗಳನ್ನು ಬಯಸಬೇಡ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ಅವನು ತನ್ನ ಒಳಗಿನ ಯೋಚನೆಯಂತೆಯೇ ಇದ್ದಾನೆ,","poem":1},{"text":"ಉಣ್ಣು, ಕುಡಿ ಎಂದು ಹೇಳಿದರೂ ನಿನ್ನಲ್ಲಿ ಅವನಿಗೆ ಪ್ರೀತಿಯಿಲ್ಲ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ನೀನು ತಿಂದ ತುತ್ತನ್ನು ಕಕ್ಕಿಬಿಡುವಿ,","poem":1},{"text":"ನಿನ್ನ ಸವಿಮಾತುಗಳು ವ್ಯರ್ಥ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ಮೂಢನ ಸಂಗಡ ಮಾತನಾಡಬೇಡ,","poem":1},{"text":"ನಿನ್ನ ಮಾತುಗಳ ವಿವೇಕವನ್ನು ತಿರಸ್ಕರಿಸುವನು.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ಪೂರ್ವಕಾಲದ ಮೇರೆಯನ್ನು ತೆಗೆದುಹಾಕಬೇಡ,","poem":1},{"text":"ಅನಾಥರ ಹೊಲಗಳಲ್ಲಿ ನುಗ್ಗಬೇಡ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ಅವರ ರಕ್ಷಕನು ಬಲಶಾಲಿಯಾಗಿದ್ದಾನೆ,","poem":1},{"text":"ಅವರಿಗಾಗಿ ನಿನ್ನ ಸಂಗಡ ವ್ಯಾಜ್ಯವಾಡುವನು.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ಉಪದೇಶವನ್ನು ಮನಸ್ಸಿಗೆ ತೆಗೆದುಕೋ,","poem":1},{"text":"ತಿಳಿವಳಿಕೆಯ ಮಾತುಗಳಿಗೆ ಕಿವಿಗೊಡು.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ಹುಡುಗನ ಶಿಕ್ಷೆಗೆ ಹಿಂತೆಗೆಯಬೇಡ,","poem":1},{"text":"ಅವನು ಬೆತ್ತದ ಏಟಿಗೆ ಸಾಯನು.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ಬೆತ್ತದಿಂದ ಹೊಡೆ,","poem":1},{"text":"ಅವನ ಆತ್ಮವನ್ನು ಪಾತಾಳಕ್ಕೆ ಬೀಳದಂತೆ ಕಾಪಾಡು.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ಕಂದಾ, ನಿನ್ನ ಮನಸ್ಸಿಗೆ ಜ್ಞಾನವುಂಟಾದರೆ","poem":1},{"text":"ನನ್ನ ಮನಸ್ಸಿಗೂ ಉಲ್ಲಾಸವಾಗುವುದು.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ಹೌದು, ನಿನ್ನ ತುಟಿಗಳು ನೀತಿಯ ನುಡಿಗಳನ್ನಾಡಿದರೆ","poem":1},{"text":"ನನ್ನ ಅಂತರಾತ್ಮವು ಹಿಗ್ಗುವುದು.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ಪಾಪಿಗಳನ್ನು ನೋಡಿ ಹೊಟ್ಟೆಕಿಚ್ಚುಪಡಬೇಡ,","poem":1},{"text":"ಯೆಹೋವನಲ್ಲಿ ನಿರಂತರವಾಗಿ ಭಯಭಕ್ತಿಯುಳ್ಳವನಾಗಿರು.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ಒಂದು ಕಾಲ ಉಂಟು,","poem":1},{"text":"ನಿನ್ನ ನಿರೀಕ್ಷೆಯು ನಿರರ್ಥಕವಾಗದು.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ಕಂದಾ, ಕೇಳು, ಜ್ಞಾನವಂತನಾಗಿರು,","poem":1},{"text":"ನಿನ್ನ ಮನಸ್ಸನ್ನು ಜ್ಞಾನದ ಮಾರ್ಗದಲ್ಲಿ ಮುಂದೆ ನಡೆಯಿಸು.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ಕುಡುಕರಲ್ಲಿಯೂ,","poem":1},{"text":"ಅತಿಮಾಂಸಭಕ್ಷಕರಲ್ಲಿಯೂ ಸೇರದಿರು.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ಕುಡುಕರು, ಹೊಟ್ಟೆಬಾಕರು ದುರ್ಗತಿಗೆ ಬರುವರು,","poem":1},{"text":"ನಿದ್ರಾಸಕ್ತಿಯು ಹರಕು ಬಟ್ಟೆಗಳನ್ನು ಹೊದಿಸುವುದು.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ಹೆತ್ತ ತಂದೆಯ ಮಾತಿಗೆ ಕಿವಿಗೊಡು,","poem":1},{"text":"ಮುಪ್ಪಿನಲ್ಲಿಯೂ ತಾಯಿಯನ್ನು ಅಸಡ್ಡೆಮಾಡಬೇಡ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ಸತ್ಯವನ್ನು ಎಂದರೆ ಜ್ಞಾನ, ಸುಶಿಕ್ಷೆ, ವಿವೇಕಗಳನ್ನು ಕೊಂಡುಕೋ,","poem":1},{"text":"ಮಾರಿ ಬಿಡಬೇಡ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ಧರ್ಮಿಯ ತಂದೆಯು ಅತಿ ಸಂತೋಷಪಡುವನು,","poem":1},{"text":"ಜ್ಞಾನಿಯನ್ನು ಹೆತ್ತವನು ಅವನಲ್ಲಿ ಆನಂದಿಸುವನು.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ನಿನ್ನ ತಂದೆತಾಯಿಗಳು ಉಲ್ಲಾಸಗೊಳ್ಳಲಿ,","poem":1},{"text":"ನಿನ್ನನ್ನು ಹೆತ್ತವಳು ಆನಂದಪಡಲಿ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ಕಂದಾ, ನಿನ್ನ ಹೃದಯವನ್ನು ನನಗೆ ಕೊಡು,","poem":1},{"text":"ನಿನ್ನ ಕಣ್ಣುಗಳು ನನ್ನ ಮಾರ್ಗಗಳಲ್ಲಿ ಆನಂದಿಸಲಿ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ಸೂಳೆಯು ಆಳವಾದ ಹಳ್ಳ,","poem":1},{"text":"ಜಾರಸ್ತ್ರೀಯು ಇಕ್ಕಟ್ಟಾದ ಗುಂಡಿ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ಹೌದು, ಕಳ್ಳನಂತೆ ಹೊಂಚುಹಾಕುತ್ತಾಳೆ,","poem":1},{"text":"ಜನರಲ್ಲಿ ದ್ರೋಹಿಗಳನ್ನು ಹೆಚ್ಚಿಸುತ್ತಾಳೆ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ಅಯ್ಯಯ್ಯೋ ಅನ್ನುವವರು ಯಾರು?","poem":1},{"text":"ಅಕಟಾ ಎಂದು ಕೂಗಿಕೊಳ್ಳುವವರು ಯಾರು?","poem":2},{"text":"ಯಾರು ಜಗಳವಾಡುತ್ತಾರೆ? ಯಾರು ಗೋಳಾಡುತ್ತಾರೆ?","poem":1},{"text":"ಯಾರು ಸುಮ್ಮಸುಮ್ಮನೆ ಗಾಯಪಡುತ್ತಾರೆ?","poem":2},{"text":"ಕೆಂಪೇರಿದ ಕಣ್ಣುಳ್ಳವರು ಯಾರು?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"ಅವರು ಮಿಶ್ರಮದ್ಯಪಾನಾಸಕ್ತರಾಗಿ,","poem":1},{"text":"ದ್ರಾಕ್ಷಾರಸವನ್ನು ಕುಡಿಯುತ್ತಾ, ಕಾಲಹರಣಮಾಡುವವರೇ.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ಪಾತ್ರೆಯಲ್ಲಿ ಕೆಂಪಗೆ ಥಳಥಳಿಸುವ","poem":1},{"text":"ದ್ರಾಕ್ಷಾರಸದ ಮೇಲೆ ಕಣ್ಣಿಡಬೇಡ.","poem":2},{"lineBreak":true},{"text":"ಅದು ಗಂಟಲಿನೊಳಗೆ ಮೆಲ್ಲಗೆ ಇಳಿದುಹೋಗಿ","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ಆಮೇಲೆ ಹಾವಿನಂತೆ ಕಚ್ಚುತ್ತದೆ,","poem":1},{"text":"ಹೌದು, ನಾಗರ ಹಾವಿನ ಹಾಗೆ ಕಡಿಯುತ್ತದೆ.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ನಿನ್ನ ಕಣ್ಣು ಇಲ್ಲದ್ದನ್ನೇ ಕಾಣುವುದು,","poem":1},{"text":"ಮನಸ್ಸು ವಿಪರೀತಗಳನ್ನು ಹೊರಪಡಿಸುವುದು.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ನೀನು ಸಮುದ್ರದ ನಡುವೆಯಾಗಲಿ,","poem":1},{"text":"ಹಡಗಿನ ಕಂಬದ ತುದಿಯಲ್ಲಿಯಾಗಲಿ ಮಲಗಿರುವವನಂತೆ ಇರುವಿ.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ಜನರು ನನ್ನನ್ನು ಹೊಡೆದರೂ ನೋವಾಗಲಿಲ್ಲ,","poem":1},{"text":"ಬಡಿದರೂ ತಿಳಿಯಲಿಲ್ಲ,","poem":2},{"lineBreak":true},{"text":"ಯಾವಾಗ ಎಚ್ಚೆತ್ತೇನು? ಪುನಃ ಅದನ್ನೇ ಹುಡುಕೇನು ಎಂದುಕೊಳ್ಳುವಿ.","poem":2}]}],"footnotes":[{"noteId":13,"caller":"+","text":"ನಿನ್ನ ಮುಂದಿಟ್ಟಿರುವುದರ ಬಗ್ಗೆ ಎಚ್ಚರಿಕೆಯಾಗಿರು. ಅಥವಾ ಯಾರ ಸನ್ನಿಧಾನದಲ್ಲಿ ಇದ್ದೀ ಎಂಬುದನ್ನು ಮರೆಯದಿರು ಅಥವಾ ಯಾರ ಮುಂದಿರುವೆ ಎಂಬುದನ್ನು ಮರೆಯದಿರು.","reference":{"chapter":23,"verse":1}}]},"thisChapterLink":"/api/kan_irv/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_irv/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_irv/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":35}