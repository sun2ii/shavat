{"translation":{"id":"kan_irv","name":"ಇಂಡಿಯನ್ ರಿವೈಜ್ಡ್ ವರ್ಸನ್ (IRV) - ಕನ್ನಡ - 2019","website":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseNotes":null,"shortName":"IRV","englishName":"Kannada Indian Revised Version Bible","language":"kan","textDirection":"ltr","sha256":"82cc741009376c81c4416c230a757b2e30ef49b2e4672f9831adcedfc26b865f","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31031,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"PRO","translationId":"kan_irv","name":"ಜ್ಞಾನೋಕ್ತಿಗಳು","commonName":"ಜ್ಞಾನೋಕ್ತಿಗಳು","title":"ಜ್ಞಾನೋಕ್ತಿಗಳು","order":20,"numberOfChapters":31,"sha256":"2c58aa5ad6d1e05e40439b2d5dd5f3d8d438cede4cfbad02cb65df37083214f0","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kan_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"ಕೆಟ್ಟವರನ್ನು ನೋಡಿ ಹೊಟ್ಟೆಕಿಚ್ಚುಪಡಬೇಡ,","poem":1},{"text":"ಅವರ ಸಹವಾಸವನ್ನು ಬಯಸಬೇಡ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ಅವರ ಮನಸ್ಸು ಹಿಂಸೆಯನ್ನು ಯೋಚಿಸುತ್ತಿರುವುದು,","poem":1},{"text":"ಅವರ ತುಟಿಯು ಹಾನಿಯನ್ನು ಪ್ರಸ್ತಾಪಿಸುತ್ತಿರುವುದು.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ಮನೆಯನ್ನು ಕಟ್ಟುವುದಕ್ಕೆ ಜ್ಞಾನವೇ ಸಾಧನ,","poem":1},{"text":"ಅದನ್ನು ಸ್ಥಿರಪಡಿಸುವುದಕ್ಕೆ ವಿವೇಕವೇ ಆಧಾರ,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ಅದರ ಕೋಣೆಗಳನ್ನು ಅಮೂಲ್ಯವಾದ ಎಲ್ಲಾ,","poem":1},{"text":"ಇಷ್ಟ ಸಂಪತ್ತಿನಿಂದ ತುಂಬಿಸುವುದಕ್ಕೆ,","poem":2},{"lineBreak":true},{"text":"ತಿಳಿವಳಿಕೆಯೇ ಉಪಕರಣ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ಜ್ಞಾನಿಗೆ ತ್ರಾಣ,","poem":1},{"text":"ಬಲ್ಲವನಿಗೆ ಬಹು ಬಲ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ಮಂತ್ರಾಲೋಚನೆಯಿಂದ ಯುದ್ಧವನ್ನು ನಡೆಸು,","poem":1},{"text":"ಬಹು ಸುಮಂತ್ರಿಗಳು ಇರುವಲ್ಲಿ ಸುರಕ್ಷಣೆಯಿರುವುದು.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ಜ್ಞಾನವು ಮೂರ್ಖನಿಗೆ ನಿಲುಕದು,","poem":1},{"text":"ಅವನು ನ್ಯಾಯಸ್ಥಾನದಲ್ಲಿ ಬಾಯಿಬಿಡಲಾರನು.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ಕೇಡನ್ನು ಕಲ್ಪಿಸುವವನು,","poem":1},{"text":"ಕುಯುಕ್ತಿಯುಳ್ಳವನು ಎನಿಸಿಕೊಳ್ಳುವನು.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ಮೂರ್ಖನ ಸಂಕಲ್ಪವು ಪಾಪವೇ,","poem":1},{"text":"ಧರ್ಮನಿಂದಕನು ಮನುಷ್ಯರಿಗೆ ಅಸಹ್ಯ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ಇಕ್ಕಟ್ಟಿನ ದಿನದಲ್ಲಿ ನೀನು ಬಳಲಿಹೋದರೆ,","poem":1},{"text":"ನಿನ್ನ ಬಲವೂ ಇಕ್ಕಟ್ಟೇ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ಕೊಲೆಗೆ ಸೆಳೆಯಲ್ಪಟ್ಟವರನ್ನು ರಕ್ಷಿಸು,","poem":1},{"text":"ಸಂಹಾರಕ್ಕೆ ಗುರಿಯಾದವರನ್ನು ತಪ್ಪಿಸು.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“ಇದು ನನಗೆ ಗೊತ್ತಿರಲಿಲ್ಲ” ಎಂದು ನೀನು ನೆವ ಹೇಳಿದರೆ,","poem":1},{"text":"ಹೃದಯಶೋಧಕನು ಗ್ರಹಿಸುವುದಿಲ್ಲವೋ?","poem":2},{"text":"ನಿನ್ನ ಆತ್ಮವನ್ನು ಕಾಯುವಾತನು ತಿಳಿಯುವುದಿಲ್ಲವೋ?","poem":1},{"text":"ಪ್ರತಿಯೊಬ್ಬನ ಕರ್ಮಕ್ಕೆ ಪ್ರತಿಫಲವನ್ನು ಕೊಡದೆ ಬಿಟ್ಟಾನೇ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ಕಂದಾ, ಜೇನು ಚೆನ್ನಾಗಿದೆಯಲ್ಲವೆ,","poem":1},{"text":"ಜೇನುತುಪ್ಪವು ನಿನ್ನ ಬಾಯಿಗೆ ಸಿಹಿಯಷ್ಟೆ, ಅದನ್ನು ತಿನ್ನು.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ಜ್ಞಾನವು ನಿನ್ನ ಆತ್ಮಕ್ಕೆ ಹೀಗೆಯೇ ಇರುವುದೆಂದು ತಿಳಿದುಕೋ,","poem":1},{"text":"ಅದನ್ನು ಪಡೆದುಕೊಂಡರೆ ಮುಂದೆ ಫಲಕಾಲ ಬರುವುದು,","poem":2},{"lineBreak":true},{"text":"ನಿನ್ನ ನಿರೀಕ್ಷೆಯು ನಿರರ್ಥಕವಾಗದು.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ದುಷ್ಟನೇ, ಶಿಷ್ಟನ ಮನೆಗೆ ಹೊಂಚುಹಾಕಬೇಡ,","poem":1},{"text":"ಅವನ ನಿವಾಸವನ್ನು ಸೂರೆಮಾಡಬೇಡ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ಶಿಷ್ಟನು ಏಳು ಸಾರಿ ಬಿದ್ದರೂ ಮತ್ತೆ ಏಳುವನು,","poem":1},{"text":"ದುಷ್ಟನು ಕೇಡಿನಿಂದ ಬಿದ್ದೇಹೋಗುವನು.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ನಿನ್ನ ಶತ್ರು ಬಿದ್ದರೆ ಹಿಗ್ಗಬೇಡ,","poem":1},{"text":"ಎಡವಿದರೆ ನಿನ್ನ ಹೃದಯವು ಹರ್ಷಿಸದಿರಲಿ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ಯೆಹೋವನು ನಿನ್ನ ಹರ್ಷವನ್ನು ಕಂಡು ಬೇಸರಗೊಂಡು,","poem":1},{"text":"ತನ್ನ ಕೋಪವನ್ನು ಅವನ ಕಡೆಯಿಂದ ತಿರುಗಿಸಾನು.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ಕೆಡುಕರ ಮೇಲೆ ಉರಿಗೊಳ್ಳದಿರು,","poem":1},{"text":"ದುಷ್ಟರನ್ನು ನೋಡಿ ಹೊಟ್ಟೆಕಿಚ್ಚುಪಡದಿರು.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ಕೆಟ್ಟವನಿಗೆ ಶುಭಕಾಲವು ಬಾರದು,","poem":1},{"text":"ದುಷ್ಟರ ದೀಪವು ಆರಿಯೇ ಹೋಗುವುದು.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ಮಗನೇ, ಯೆಹೋವನಿಗೂ ಮತ್ತು ರಾಜನಿಗೂ ಭಯಪಡು,","poem":1},{"text":"ತಿರುಗಿಬೀಳುವವರ ಗೊಡವೆಗೆ ಹೋಗಬೇಡ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ಅವರಿಬ್ಬರು ವಿಧಿಸುವ ವಿಪತ್ತು ಫಕ್ಕನೆ ಸಂಭವಿಸುವುದು,","poem":1},{"text":"ಅವರಿಂದಾಗುವ ನಾಶವು ಯಾರಿಗೆ ತಿಳಿದೀತು?","poem":2}]},{"type":"heading","content":["ಬೇರೆ ಕೆಲವು ಹೇಳಿಕೆಗಳು"]},{"type":"verse","number":23,"content":[{"text":"ಇವು ಕೂಡ ಜ್ಞಾನಿಗಳ ಮಾತುಗಳು:","poem":1},{"text":"ನ್ಯಾಯವಿಚಾರಣೆಯಲ್ಲಿ ಪಕ್ಷಪಾತವು ಧರ್ಮವಲ್ಲ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ಯಾವನು ಅಧರ್ಮಿಗೆ, “ನೀನು ಧರ್ಮಾತ್ಮನು” ಎಂದು ಹೇಳುತ್ತಾನೋ,","poem":1},{"text":"ಅವನನ್ನು ಜನರು ಶಪಿಸುವರು, ಪ್ರಜೆಗಳು ದೂಷಿಸುವರು.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ದುಷ್ಟನನ್ನು ಗದರಿಸುವವರಿಗಾದರೋ ಶುಭವಾಗುವುದು,","poem":1},{"text":"ಸುಖಕರವಾದ ಆಶೀರ್ವಾದವೂ ಲಭಿಸುವುದು.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ಯಥಾರ್ಥವಾದ ಉತ್ತರವು,","poem":1},{"text":"ತುಟಿಗೆ ಮುದ್ದು.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ನಿನ್ನ ಕೆಲಸದ ಸಾಮಾನುಗಳನ್ನು ಸಿದ್ಧಮಾಡು,","poem":1},{"text":"ನಂತರ ಹೊಲಗದ್ದೆಗಳ ಕೆಲಸವನ್ನು ಮುಗಿಸು,","poem":2},{"lineBreak":true},{"text":"ಆಮೇಲೆ ನಿನ್ನ ಮನೆಯನ್ನು ಕಟ್ಟು.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ಕಾರಣವಿಲ್ಲದೆ ನೆರೆಯವನಿಗೆ ವಿರುದ್ಧವಾಗಿ ಸಾಕ್ಷಿ ಹೇಳಬೇಡ,","poem":1},{"text":"ಮಾತಿನಿಂದ ಮೋಸಮಾಡಬೇಡ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"“ಅವನು ನನಗೆ ಮಾಡಿದಂತೆ ನಾನೂ ಅವನಿಗೆ ಮಾಡುವೆನು,","poem":1},{"text":"ಅವನು ಮಾಡಿದ್ದಕ್ಕೆ ಸರಿಯಾಗಿ ಮುಯ್ಯಿತೀರಿಸುವೆನು” ಅಂದುಕೊಳ್ಳಬೇಡ.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ಸೋಮಾರಿಯ ಹೊಲದ ಮೇಲೆಯೂ,","poem":1},{"text":"ಬುದ್ಧಿಹೀನನ ದ್ರಾಕ್ಷಿಯ ತೋಟದ ಮೇಲೆಯೂ ಹಾದು ಹೋದೆನು.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ಆಹಾ, ಮುಳ್ಳುಗಿಡಗಳು ಅದರಲ್ಲಿ ಹರಡಿಕೊಂಡಿದ್ದವು,","poem":1},{"text":"ಕಳೆಗಳು ಅದನ್ನು ಮುಚ್ಚಿದ್ದವು,","poem":2},{"lineBreak":true},{"text":"ಅದರ ಕಲ್ಲಿನ ಗೋಡೆಯು ಹಾಳಾಗಿತ್ತು.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ಆಗ ನಾನು ನೋಡಿ ಆಲೋಚಿಸಿದೆನು,","poem":1},{"text":"ದೃಷ್ಟಿಸಿ ಶಿಕ್ಷಿತನಾದೆನು.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ಇನ್ನು ಸ್ವಲ್ಪ ನಿದ್ದೆ, ಇನ್ನು ತುಸ ತೂಕಡಿಕೆ,","poem":1},{"text":"ಇನ್ನೂ ಕೊಂಚ ನಿದ್ದೆಗಾಗಿ ಕೈಮುದುರಿಕೊಳ್ಳುವೆ ಅಂದುಕೊಳ್ಳುವಿಯಾ?","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ಬಡತನವು ದಾರಿಗಳ್ಳನ ಹಾಗೂ,","poem":1},{"text":"ಕೊರತೆಯು ಪಂಜುಗಳ್ಳನಂತೆಯೂ ನಿನ್ನ ಮೇಲೆ ಬೀಳುವವು.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kan_irv/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_irv/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_irv/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}