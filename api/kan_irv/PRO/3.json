{"translation":{"id":"kan_irv","name":"ಇಂಡಿಯನ್ ರಿವೈಜ್ಡ್ ವರ್ಸನ್ (IRV) - ಕನ್ನಡ - 2019","website":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseNotes":null,"shortName":"IRV","englishName":"Kannada Indian Revised Version Bible","language":"kan","textDirection":"ltr","sha256":"82cc741009376c81c4416c230a757b2e30ef49b2e4672f9831adcedfc26b865f","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31031,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"PRO","translationId":"kan_irv","name":"ಜ್ಞಾನೋಕ್ತಿಗಳು","commonName":"ಜ್ಞಾನೋಕ್ತಿಗಳು","title":"ಜ್ಞಾನೋಕ್ತಿಗಳು","order":20,"numberOfChapters":31,"sha256":"2c58aa5ad6d1e05e40439b2d5dd5f3d8d438cede4cfbad02cb65df37083214f0","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kan_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":3,"content":[{"type":"heading","content":["ಯೆಹೋವನಲ್ಲಿ ಭರವಸವಿಡು"]},{"type":"verse","number":1,"content":[{"text":"ಕಂದಾ, ನನ್ನ ಉಪದೇಶವನ್ನು ಮರೆಯಬೇಡ,","poem":1},{"text":"ನನ್ನ ಆಜ್ಞೆಗಳನ್ನು ಮನಃಪೂರ್ವಕವಾಗಿ ಕೈಗೊಳ್ಳು.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ಅವು ನಿನ್ನ ದಿನಗಳನ್ನು ಹೆಚ್ಚಿಸಿ, ನಿನ್ನ ಆಯುಷ್ಯವನ್ನು ವೃದ್ಧಿಗೊಳಿಸಿ,","poem":1},{"text":"ನಿನಗೆ ಸುಕ್ಷೇಮವನ್ನು ಉಂಟುಮಾಡುವವು.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ಪ್ರೀತಿ, ಸತ್ಯತೆಗಳು ನಿನ್ನನ್ನು ಬಿಡದಿರಲಿ, ಅವುಗಳನ್ನು ನಿನ್ನ ಕೊರಳಿಗೆ ಕಟ್ಟು,","poem":1},{"text":"ನಿನ್ನ ಹೃದಯದ ಹಲಗೆಯ ಮೇಲೆ ಅವುಗಳನ್ನು ಬರೆ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ಇದರಿಂದ ನೀನು ದೇವರ ಮತ್ತು ಮನುಷ್ಯರ ದಯೆಯನ್ನೂ,","poem":1},{"text":"ಸಮ್ಮತಿಯನ್ನೂ ಪಡೆದುಕೊಳ್ಳುವಿ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ಸ್ವಬುದ್ಧಿಯನ್ನೇ ಆಧಾರಮಾಡಿಕೊಳ್ಳದೆ","poem":1},{"text":"ಪೂರ್ಣಮನಸ್ಸಿನಿಂದ ಯೆಹೋವನಲ್ಲಿ ಭರವಸವಿಡು.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ನಿನ್ನ ಎಲ್ಲಾ ನಡವಳಿಕೆಯಲ್ಲಿ ಆತನ ಚಿತ್ತಕ್ಕೆ ವಿಧೇಯನಾಗಿರು;","poem":1},{"text":"ಆತನೇ ನಿನ್ನ ಮಾರ್ಗಗಳನ್ನು ಸರಾಗಮಾಡುವನು.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ನೀನೇ ಬುದ್ಧಿವಂತನು ಎಂದೆಣಿಸದೆ,","poem":1},{"text":"ಯೆಹೋವನಿಗೆ ಭಯಪಟ್ಟು ಕೆಟ್ಟದ್ದನ್ನು ತೊರೆದುಬಿಡು.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ಇದರಿಂದ ನಿನ್ನ ದೇಹಕ್ಕೆ ಆರೋಗ್ಯವೂ,","poem":1},{"text":"ಎಲುಬುಗಳಿಗೆ ಸಾರವೂ ಉಂಟಾಗುವವು.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ನಿನ್ನ ಆದಾಯದಿಂದಲೂ, ಬೆಳೆಯ ಪ್ರಥಮಫಲದಿಂದಲೂ","poem":1},{"text":"ಯೆಹೋವನನ್ನು ಸನ್ಮಾನಿಸು.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ಹೀಗೆ ಮಾಡಿದರೆ ನಿನ್ನ ಕಣಜಗಳು ಸಮೃದ್ಧಿಯಿಂದ ತುಂಬುವವು,","poem":1},{"text":"ತೊಟ್ಟಿಗಳಲ್ಲಿ ದ್ರಾಕ್ಷಾರಸವು ತುಂಬಿ ತುಳುಕುವುದು.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ಮಗನೇ, ಯೆಹೋವನ ಶಿಕ್ಷೆಯನ್ನು ತಾತ್ಸಾರ ಮಾಡಬೇಡ.","poem":1},{"text":"ಆತನು ನಿನ್ನನ್ನು ಗದರಿಸುವಾಗ ಬೇಸರಗೊಳ್ಳಬೇಡ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ತಂದೆಯು ತನ್ನ ಮುದ್ದುಮಗನನ್ನು ಗದರಿಸುವಂತೆ","poem":1},{"text":"ಯೆಹೋವನು ತಾನು ಪ್ರೀತಿಸುವವನನ್ನೇ ಗದರಿಸುತ್ತಾನೆ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ಜ್ಞಾನವನ್ನು ಪಡೆಯುವವನು ಧನ್ಯನು,","poem":1},{"text":"ವಿವೇಕವನ್ನು ಸಂಪಾದಿಸುವವನು ಭಾಗ್ಯವಂತನು.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ಅದರ ಲಾಭವು ಬೆಳ್ಳಿಯ ಲಾಭಕ್ಕಿಂತಲೂ,","poem":1},{"text":"ಅದರಿಂದಾಗುವ ಆದಾಯವು ಬಂಗಾರಕ್ಕಿಂತಲೂ ಅಮೂಲ್ಯವೇ ಸರಿ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ಅದರ ಬೆಲೆಯು ಹವಳಕ್ಕಿಂತಲೂ ಹೆಚ್ಚು,","poem":1},{"text":"ನಿನ್ನ ಇಷ್ಟವಸ್ತುಗಳೆಲ್ಲವೂ ಅದಕ್ಕೆ ಸಮವಲ್ಲ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ಜ್ಞಾನವೆಂಬಾಕೆಯ ಬಲಗೈಯಲ್ಲಿ ದೀರ್ಘಾಯುಷ್ಯವೂ,","poem":1},{"text":"ಎಡಗೈಯಲ್ಲಿ ಧನವೂ, ಘನತೆಯೂ ಉಂಟು.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ಆಕೆಯ ದಾರಿಗಳು ಸುಖಕರವಾಗಿವೆ,","poem":1},{"text":"ಆಕೆಯ ಮಾರ್ಗಗಳೆಲ್ಲಾ ಸಮಾಧಾನವೇ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ಜ್ಞಾನವು ತನ್ನನ್ನು ಹಿಡಿದುಕೊಳ್ಳುವವರಿಗೆ ಜೀವವೃಕ್ಷವಾಗಿದೆ.","poem":1},{"text":"ಅದನ್ನು ಅವಲಂಬಿಸುವ ಪ್ರತಿಯೊಬ್ಬನೂ ಧನ್ಯನು.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ಯೆಹೋವನು ಜ್ಞಾನದ ಮೂಲಕ ಭೂಮಿಯನ್ನು ಸ್ಥಾಪಿಸಿ,","poem":1},{"text":"ವಿವೇಕದ ಮುಖಾಂತರ ಆಕಾಶಮಂಡಲವನ್ನು ಸ್ಥಿರಪಡಿಸಿದನು.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ಭೂಮಿಯ ಕೆಳಗಿನ ಸಾಗರವು ಒಡೆದದ್ದಕ್ಕೂ,","poem":1},{"text":"ಆಕಾಶವು ಇಬ್ಬನಿಯನ್ನು ಸುರಿಸುವುದಕ್ಕೂ ಆತನ ತಿಳಿವಳಿಕೆಯೇ ಸಾಧನ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ನನ್ನ ಮಗನೇ, ಸುಜ್ಞಾನವನ್ನೂ ಮತ್ತು ಬುದ್ಧಿಯನ್ನೂ ಭದ್ರವಾಗಿಟ್ಟುಕೋ,","poem":1},{"text":"ನಿನ್ನ ದೃಷ್ಟಿಯು ಅವುಗಳ ಮೇಲೆ ತಪ್ಪದೇ ಇರಲಿ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ಅವು ನಿನಗೆ ಜೀವವೂ, ನಿನ್ನ ಕೊರಳಿಗೆ ಭೂಷಣವೂ ಆಗಿರುವವು.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ಆಗ ನೀನು ಎಡವದೆ ನಿನ್ನ ಮಾರ್ಗದಲ್ಲಿ ನಿರ್ಭಯವಾಗಿ ನಡೆಯುವಿ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ನೀನು ಮಲಗುವಾಗ ಹೆದರಿಕೆ ಇರುವುದಿಲ್ಲ,","poem":1},{"text":"ಮಲಗಿದ ಮೇಲೆ ಸುಖವಾಗಿ ನಿದ್ರೆಮಾಡುವಿ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ಪಕ್ಕನೆ ಬರುವ ಅಪಾಯಕ್ಕಾಗಲಿ ಅಥವಾ","poem":1},{"text":"ದುಷ್ಟರಿಗೆ ಸಂಭವಿಸುವ ನಾಶನಕ್ಕಾಗಲಿ ನೀನು ಅಂಜುವುದೇ ಇಲ್ಲ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ಯೆಹೋವನು ನಿನ್ನ ಭರವಸಕ್ಕೆ ಆಧಾರನಾಗಿದ್ದು,","poem":1},{"text":"ನಿನ್ನ ಕಾಲು ಮೋಸದ ಬಲೆಗೆ ಸಿಕ್ಕದಂತೆ ನಿನ್ನನ್ನು ಕಾಪಾಡುವನು.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ಉಪಕಾರಮಾಡುವುದಕ್ಕೆ ನಿನ್ನಿಂದ ಸಾಧ್ಯವಾಗುವಾಗ","poem":1},{"text":"ಹೊಂದತಕ್ಕವರಿಗೆ ಅದನ್ನು ತಪ್ಪಿಸಬೇಡ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ಕೊಡತಕ್ಕದ್ದು ನಿನ್ನಲ್ಲಿದ್ದರೆ ನೆರೆಯವನಿಗೆ, “ಹೋಗಿ ಬಾ,","poem":1},{"text":"ನಾಳೆ ಕೊಡುತ್ತೇನೆ” ಎಂದು ಹೇಳಬೇಡ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ನೆರೆಯವನಿಗೆ ಕೇಡನ್ನು ಕಲ್ಪಿಸಬಾರದು,","poem":1},{"text":"ಅವನು ನಿನ್ನ ಪಕ್ಕದಲ್ಲಿ ನಂಬಿಕೆಯಿಂದ ವಾಸಮಾಡುತ್ತಾನಲ್ಲವೇ?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ನಿನಗೆ ಅಪಕಾರ ಮಾಡದವನ ಸಂಗಡ","poem":1},{"text":"ಸುಮ್ಮನೆ ಜಗಳವಾಡಬೇಡ.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ಬಲಾತ್ಕಾರಿಯನ್ನು ನೋಡಿ ಹೊಟ್ಟೆಕಿಚ್ಚುಪಡದಿರು,","poem":1},{"text":"ಅವನ ನಡತೆಯನ್ನು ಎಷ್ಟು ಮಾತ್ರಕ್ಕೂ ಅನುಸರಿಸಬೇಡ.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ವಕ್ರಬುದ್ಧಿಯವನು ಯೆಹೋವನಿಗೆ ಅಸಹ್ಯನು,","poem":1},{"text":"ಯಥಾರ್ಥರಿಗೆ ಆತನ ಸ್ನೇಹವು ದೊರೆಯುವುದು.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ಯೆಹೋವನು ದುಷ್ಟನ ಮನೆಯನ್ನು ಶಪಿಸುವನು,","poem":1},{"text":"ನೀತಿವಂತರ ನಿವಾಸವನ್ನೋ ಆಶೀರ್ವದಿಸುವನು.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ಯಾರು ಧರ್ಮವನ್ನು ತಿರಸ್ಕರಿಸುವರೋ ಅವರನ್ನು ಆತನು ತಿರಸ್ಕರಿಸುವನು.","poem":1},{"text":"ದೀನರಿಗಾದರೋ ತನ್ನ ಕೃಪೆಯನ್ನು ಅನುಗ್ರಹಿಸುವನು.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ಜ್ಞಾನವಂತರು ಸನ್ಮಾನಕ್ಕೆ ಬಾಧ್ಯರಾಗುವರು,","poem":1},{"text":"ಜ್ಞಾನಹೀನರಿಗಾಗುವ ಬಹುಮಾನವು ಅವಮಾನವೇ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kan_irv/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_irv/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_irv/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}