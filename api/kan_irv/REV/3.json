{"translation":{"id":"kan_irv","name":"ಇಂಡಿಯನ್ ರಿವೈಜ್ಡ್ ವರ್ಸನ್ (IRV) - ಕನ್ನಡ - 2019","website":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanirv","licenseNotes":null,"shortName":"IRV","englishName":"Kannada Indian Revised Version Bible","language":"kan","textDirection":"ltr","sha256":"82cc741009376c81c4416c230a757b2e30ef49b2e4672f9831adcedfc26b865f","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31031,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"REV","translationId":"kan_irv","name":"ಪ್ರಕಟಣೆ","commonName":"ಪ್ರಕಟಣೆ","title":"ಪ್ರಕಟಣೆ","order":66,"numberOfChapters":22,"sha256":"dc0335d561354963e164f50821b870ff5b5fa0b7a3a2edfeaed5df25fb779fcf","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_irv/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/kan_irv/REV/22.json","totalNumberOfVerses":401},"chapter":{"number":3,"content":[{"type":"heading","content":["ಸಾರ್ದಿಸಿನ ಸಭೆಗೆ ಸಂದೇಶ"]},{"type":"verse","number":1,"content":[{"text":"“ಸಾರ್ದಿಸಿನಲ್ಲಿರುವ ಸಭೆಯ ದೂತನಿಗೆ ಬರೆ,","wordsOfJesus":true},{"noteId":110},{"text":"ದೇವರ ಏಳು ಆತ್ಮಗಳನ್ನು ಮತ್ತು ಏಳು ನಕ್ಷತ್ರಗಳನ್ನು ಹೊಂದಿರುವವನು ಹೇಳುವುದೇನಂದರೆ, ನಿನ್ನ ಕೃತ್ಯಗಳನ್ನು ನಾನು ಬಲ್ಲೆನು.","wordsOfJesus":true},{"noteId":111},{"text":"ಜೀವಿಸುವವನು ಎಂಬ ಹೆಸರು ನಿನಗಿದ್ದರೂ ನೀನು","wordsOfJesus":true},{"noteId":112},{"text":"ಸತ್ತವನಾಗಿರುವೆ.","wordsOfJesus":true}]},{"type":"verse","number":2,"content":[{"text":"“ಎಚ್ಚರವಾಗು, ಸಾಯುವ ಹಾಗಿರುವ","wordsOfJesus":true},{"noteId":113},{"text":"ಉಳಿದವುಗಳನ್ನು ಬಲಪಡಿಸು. ಏಕೆಂದರೆ ನನ್ನ ದೇವರ ಮುಂದೆ ನಿನ್ನ ಕೃತ್ಯಗಳಲ್ಲಿ ಒಂದಾದರೂ ಪರಿಪೂರ್ಣವಾದದ್ದೆಂದು ನನಗೆ ಕಂಡುಬರಲಿಲ್ಲ.","wordsOfJesus":true}]},{"type":"verse","number":3,"content":[{"text":"ಆದುದರಿಂದ ನೀನು ಹೊಂದಿಕೊಂಡಿದ್ದ ಉಪದೇಶವನ್ನೂ ಅದನ್ನು ಕೇಳಿದ ರೀತಿಯನ್ನೂ ನೆನಪಿಗೆ ತಂದು ಅದನ್ನು ಕಾಪಾಡಿಕೊಂಡು ಮಾನಸಾಂತರ ಹೊಂದಿ ದೇವರ ಕಡೆಗೆ ತಿರಿಗಿಕೋ. ನೀನು ಎಚ್ಚರಗೊಳ್ಳದಿದ್ದರೆ","wordsOfJesus":true},{"noteId":114},{"text":"ಕಳ್ಳನು ಬರುವಂತೆ ಬರುವೆನು. ನಾನು ಯಾವ ಗಳಿಗೆಯಲ್ಲಿ ನಿನ್ನಲ್ಲಿಗೆ ಬರುವೆನೆಂಬುದು ನಿನಗೆ ತಿಳಿಯುವುದೇ ಇಲ್ಲ.","wordsOfJesus":true}]},{"type":"verse","number":4,"content":[{"text":"ಆದರೂ","wordsOfJesus":true},{"noteId":115},{"text":"ತಮ್ಮ ಅಂಗಿಗಳನ್ನು ಮಲಿನ ಮಾಡಿಕೊಳ್ಳದಿರುವ ಸ್ವಲ್ಪ ಜನರು ಸಾರ್ದಿಸಿನಲ್ಲಿ ನಿನಗಿದ್ದಾರೆ. ಅವರು","wordsOfJesus":true},{"noteId":116},{"text":"ಯೋಗ್ಯರಾಗಿರುವುದರಿಂದ","wordsOfJesus":true},{"noteId":117},{"text":"ಶುಭ್ರವಸ್ತ್ರಗಳನ್ನು ಧರಿಸಿಕೊಂಡು ನನ್ನ ಜೊತೆಯಲ್ಲಿ ನಡೆಯುವರು.","wordsOfJesus":true}]},{"type":"verse","number":5,"content":[{"noteId":118},{"text":"ಜಯಹೊಂದುವವನು ಶುಭ್ರವಸ್ತ್ರಗಳನ್ನು ಧರಿಸುವನು.","wordsOfJesus":true},{"noteId":119},{"text":"ಜೀವಬಾಧ್ಯರ ಪುಸ್ತಕದಿಂದ ಅವನ ಹೆಸರನ್ನು ನಾನು ಅಳಿಸದೆ,","wordsOfJesus":true},{"noteId":120},{"text":"ಅವನು ನನ್ನವನೆಂದು ನನ್ನ ತಂದೆಯ ಎದುರಿನಲ್ಲಿಯೂ ಆತನ ದೂತರ ಮುಂದೆಯೂ ಒಪ್ಪಿಕೊಳ್ಳುವೆನು.","wordsOfJesus":true}]},{"type":"verse","number":6,"content":[{"noteId":121},{"text":"ದೇವರಾತ್ಮನು ಸಭೆಗಳಿಗೆ ಹೇಳುವುದನ್ನು ಕಿವಿಯುಳ್ಳವನು ಕೇಳಲಿ.","wordsOfJesus":true}]},{"type":"heading","content":["ಫಿಲದೆಲ್ಫಿಯ ಸಭೆಗೆ ಸಂದೇಶ"]},{"type":"verse","number":7,"content":[{"text":"“ಫಿಲದೆಲ್ಫಿಯದಲ್ಲಿರುವ ಸಭೆಯ ದೂತನಿಗೆ ಬರೆ,","wordsOfJesus":true},{"noteId":122},{"text":"ಪರಿಶುದ್ಧನೂ,","wordsOfJesus":true},{"noteId":123},{"text":"ಸತ್ಯವಂತನೂ,","wordsOfJesus":true},{"noteId":124},{"text":"ದಾವೀದನ ಬೀಗದಕೈಯುಳ್ಳವನೂ, ಯಾರಿಂದಲೂ ಮುಚ್ಚಲಾಗದಂತೆ ತೆರೆಯುವವನೂ,","wordsOfJesus":true},{"noteId":125},{"text":"ಯಾರಿಂದಲೂ ತೆರೆಯಲಾಗದಂತೆ ಮುಚ್ಚುವವನೂ ಆಗಿರುವಾತನು ಹೇಳುವುದೇನಂದರೆ,","wordsOfJesus":true}]},{"type":"verse","number":8,"content":[{"text":"ನಿನ್ನ ಕೃತ್ಯಗಳನ್ನು ಬಲ್ಲೆನು. ನಿನಗಿರುವ ಶಕ್ತಿ ಕೊಂಚವಾಗಿದ್ದರೂ ನೀನು ನನ್ನ ಹೆಸರನ್ನು ನಿರಾಕರಿಸದೆ, ನನ್ನ ವಾಕ್ಯವನ್ನು ಕಾಪಾಡಿದ್ದರಿಂದ ಇಗೋ","wordsOfJesus":true},{"noteId":126},{"text":"ನಿನ್ನೆದುರಿನಲ್ಲಿ ಒಂದು ಬಾಗಿಲನ್ನು ತೆರೆದಿಟ್ಟಿದ್ದೇನೆ. ಯಾರೂ ಅದನ್ನು ಮುಚ್ಚಲಾರರು.","wordsOfJesus":true}]},{"type":"verse","number":9,"content":[{"text":"ತಾವು ಯೆಹೂದ್ಯರೆಂದು ಸುಳ್ಳಾಗಿ ಕೊಚ್ಚಿಕೊಳ್ಳುವ ಕೆಲವರನ್ನು","wordsOfJesus":true},{"noteId":127},{"text":"ಸೈತಾನನ ಸಭಾಮಂದಿರದಿಂದ ಕರೆಯಿಸುವೆನು. ಅವರು","wordsOfJesus":true},{"noteId":128},{"text":"ನಿನ್ನ ಪಾದಕ್ಕೆ ಬಿದ್ದು ನಮಸ್ಕರಿಸುವಂತೆಯೂ, ನಿನ್ನ ಬಗ್ಗೆ ನನಗಿರುವ ಪ್ರೀತಿ ಅವರಿಗೆ ತಿಳಿಯುವಂತೆ ಮಾಡುವೆನು.","wordsOfJesus":true}]},{"type":"verse","number":10,"content":[{"text":"ಸೈರಣೆಯಿಂದಿರಬೇಕೆಂಬ","wordsOfJesus":true},{"noteId":129},{"text":"ನನ್ನ ಆಜ್ಞೆಯನ್ನು ನೀನು ಪಾಲಿಸಿದ್ದರಿಂದ,","wordsOfJesus":true},{"noteId":130},{"text":"ಭೂಲೋಕದ ನಿವಾಸಿಗಳೆಲ್ಲರನ್ನು ಪರೀಕ್ಷಿಸುವುದಕ್ಕಾಗಿ ಇಡೀ ಜಗತ್ತಿನ ಮೇಲೆ ಬರಲಿರುವ ಕಡುಶೋಧನೆಯ ಕಾಲದಲ್ಲಿ ನಾನು ನಿನ್ನನ್ನು ಸುರಕ್ಷಿತವಾಗಿ ಕಾಪಾಡುತ್ತೇನೆ.","wordsOfJesus":true}]},{"type":"verse","number":11,"content":[{"text":"ನಾನು","wordsOfJesus":true},{"noteId":131},{"text":"ಬೇಗನೇ ಬರುತ್ತೇನೆ,","wordsOfJesus":true},{"noteId":132},{"text":"ನಿನ್ನ ಕಿರೀಟವನ್ನು ಯಾರೂ ಕಸಿದುಕೊಳ್ಳದಂತೆ ನೀನು ಅವಲಂಬಿಸಿರುವುದನ್ನೇ ಆಶ್ರಯಿಸಿಕೊಂಡಿರು.","wordsOfJesus":true}]},{"type":"verse","number":12,"content":[{"noteId":133},{"text":"ಯಾವನು ಜಯಹೊಂದುತ್ತಾನೋ ಅವನನ್ನು ನನ್ನ ದೇವರ ಆಲಯದಲ್ಲಿ","wordsOfJesus":true},{"noteId":134},{"text":"ಸ್ತಂಭವಾಗಿ ನಿಲ್ಲಿಸುವೆನು.","wordsOfJesus":true},{"noteId":135},{"text":"ಅವನು ಎಂದಿಗೂ ಅಲ್ಲಿಂದ ಕದಲುವುದೇ ಇಲ್ಲ. ಇದಲ್ಲದೆ","wordsOfJesus":true},{"noteId":136},{"text":"ನನ್ನ ದೇವರ ಹೆಸರನ್ನು, ನನ್ನ","wordsOfJesus":true},{"noteId":137},{"text":"ದೇವರ ಬಳಿಯಿಂದ ಪರಲೋಕದೊಳಗಿಂದ ಇಳಿದುಬರುವ ಹೊಸ ಯೆರೂಸಲೇಮ್ ಪಟ್ಟಣವೆಂಬ ನನ್ನ ದೇವರ ಪಟ್ಟಣದ ಹೆಸರನ್ನೂ,","wordsOfJesus":true},{"noteId":138},{"text":"ನನ್ನ ಹೊಸ ಹೆಸರನ್ನೂ ಅವನ ಮೇಲೆ ಬರೆಯುವೆನು.","wordsOfJesus":true}]},{"type":"verse","number":13,"content":[{"noteId":139},{"text":"ದೇವರಾತ್ಮನು ಸಭೆಗಳಿಗೆ ಹೇಳುವುದನ್ನು ಕಿವಿಯುಳ್ಳವನು ಕೇಳಲಿ.","wordsOfJesus":true}]},{"type":"heading","content":["ಲವೊದಿಕೀಯ ಸಭೆಗೆ ಸಂದೇಶ"]},{"type":"verse","number":14,"content":[{"text":"“ಲವೊದಿಕೀಯದಲ್ಲಿರುವ ಸಭೆಯ ದೂತನಿಗೆ ಬರೆ, ನಂಬಿಗಸ್ತನೂ, ಸತ್ಯ ಸಾಕ್ಷಿಯೂ,","wordsOfJesus":true},{"noteId":140},{"text":"ದೇವರ ಸೃಷ್ಟಿಗೆ ಮೂಲನೂ ಆಗಿರುವ","wordsOfJesus":true},{"noteId":141},{"text":"‘ಆಮೆನ್’ ಎಂಬಾತನು","wordsOfJesus":true},{"noteId":142},{"text":"ಹೇಳುವುದೇನಂದರೆ,","wordsOfJesus":true}]},{"type":"verse","number":15,"content":[{"text":"ನಿನ್ನ ಕೃತ್ಯಗಳನ್ನು ಬಲ್ಲೆನು. ನೀನು ತಣ್ಣಗಿರುವವನೂ ಅಲ್ಲ ಬೆಚ್ಚಗಿರುವವನೂ ಅಲ್ಲ ನೀನು ತಣ್ಣಗಾಗಲಿ ಬೆಚ್ಚಗಾಗಲಿ ಇದ್ದಿದ್ದರೆ ಚೆನ್ನಾಗಿತ್ತು.","wordsOfJesus":true}]},{"type":"verse","number":16,"content":[{"text":"ನೀನು ಬೆಚ್ಚಗೂ ಅಲ್ಲದೆ ತಣ್ಣಗೂ ಅಲ್ಲದೆ ಉಗುರು ಬೆಚ್ಚಗಿರುವುದರಿಂದ ನಿನ್ನನ್ನು ನನ್ನ ಬಾಯೊಳಗಿಂದ ಉಗಿದು ಬಿಡುವೆನು.","wordsOfJesus":true}]},{"type":"verse","number":17,"content":[{"text":"ನೀನು ನಿನ್ನ ವಿಷಯದಲ್ಲಿ","wordsOfJesus":true},{"noteId":143},{"text":"ನಾನು ಐಶ್ವರ್ಯವಂತನು, ಸಂಪನ್ನನು, ಯಾವುದರಲ್ಲಿಯೂ ಕೊರತೆಯಿಲ್ಲದವನು ಎಂದು ಹೇಳಿಕೊಳ್ಳುತ್ತೀ. ಆದರೆ ನೀನು ಕೇವಲ ದುರವಸ್ಥೆಯಲ್ಲಿ ಬಿದ್ದಿರುವಂಥವನು, ದೌರ್ಭಾಗ್ಯನು, ದರಿದ್ರನು,","wordsOfJesus":true},{"noteId":144},{"text":"ಕುರುಡನು, ಬೆತ್ತಲೆಯಾಗಿರುವವನೂ ಆಗಿರುವುದನ್ನು ತಿಳಿಯದೇ ಇರುವೆ.","wordsOfJesus":true}]},{"type":"verse","number":18,"content":[{"text":"ನೀನು ಐಶ್ವರ್ಯವಂತನಾಗಲು ಬೆಂಕಿಯಲ್ಲಿ ಪುಟಾಹಾಕಿದ ಚಿನ್ನವನ್ನೂ,","wordsOfJesus":true},{"noteId":145},{"text":"ಲಜ್ಜಾಸ್ಪದವಾದ ನಿನ್ನ ಬೆತ್ತಲೆತನ ಕಾಣಿಸದಂತೆ ಧರಿಸಿಕೊಳ್ಳುವುದಕ್ಕಾಗಿ","wordsOfJesus":true},{"noteId":146},{"text":"ಬಿಳೀವಸ್ತ್ರಗಳನ್ನೂ, ಕಣ್ಣುಕಾಣುವಂತೆ ನಿನ್ನ ಕಣ್ಣುಗಳಿಗೆ ಹಚ್ಚುವುದಕ್ಕಾಗಿ ಅಂಜನವನ್ನೂ ನನ್ನಿಂದ","wordsOfJesus":true},{"noteId":147},{"text":"ಕೊಂಡುಕೊಳ್ಳಬೇಕೆಂದು ನಾನು ನಿನಗೆ ಬುದ್ಧಿ ಹೇಳುತ್ತೇನೆ.","wordsOfJesus":true}]},{"type":"verse","number":19,"content":[{"noteId":148},{"text":"ನಾನು ಯಾರಾರನ್ನು ಪ್ರೀತಿಸುತ್ತೇನೋ ಅವರನ್ನು ಗದರಿಸುತ್ತೇನೆ ಮತ್ತು ಶಿಕ್ಷಿಸುತ್ತೇನೆ. ಆದ್ದರಿಂದ ನೀನು ಜಾಗರೂಕನಾಗಿರು. ಮಾನಸಾಂತರ ಹೊಂದಿ ದೇವರ ಕಡೆಗೆ ತಿರಿಗಿಕೋ.","wordsOfJesus":true}]},{"type":"verse","number":20,"content":[{"text":"ಇಗೋ ಬಾಗಿಲಲ್ಲಿ ನಿಂತುಕೊಂಡು ತಟ್ಟುತ್ತಾ ಇದ್ದೇನೆ.","wordsOfJesus":true},{"noteId":149},{"text":"ಯಾವನಾದರೂ ನನ್ನ ಧ್ವನಿಯನ್ನು ಕೇಳಿ ಬಾಗಿಲನ್ನು ತೆರೆದರೆ","wordsOfJesus":true},{"noteId":150},{"text":"ನಾನು ಒಳಗೆ ಬಂದು ಅವನ ಸಂಗಡ ಊಟ ಮಾಡುವೆನು. ಅವನು ನನ್ನ ಸಂಗಡ ಊಟ ಮಾಡುವನು.","wordsOfJesus":true}]},{"type":"verse","number":21,"content":[{"noteId":151},{"text":"ನಾನು ಜಯಹೊಂದಿ ನನ್ನ ತಂದೆಯೊಡನೆ ಸಿಂಹಾಸನದಲ್ಲಿ ಕುಳಿತುಕೊಂಡ ಹಾಗೆಯೇ","wordsOfJesus":true},{"noteId":152},{"text":"ಜಯಶಾಲಿಯಾದವನಿಗೆ","wordsOfJesus":true},{"noteId":153},{"text":"ನನ್ನೊಡನೆ ಸಿಂಹಾಸನದಲ್ಲಿ ಕುಳಿತುಕೊಳ್ಳುವ ಹಕ್ಕನ್ನು ನಾನು ಕೊಡುತ್ತೇನೆ.","wordsOfJesus":true}]},{"type":"verse","number":22,"content":[{"text":"ದೇವರಾತ್ಮನು ಸಭೆಗಳಿಗೆ ಹೇಳುವುದನ್ನು ಕಿವಿಯುಳ್ಳವನು ಕೇಳಲಿ.”","wordsOfJesus":true}]}],"footnotes":[{"noteId":110,"caller":"+","text":"ಪ್ರಕ 1:4; 16, 20:","reference":{"chapter":3,"verse":1}},{"noteId":111,"caller":"+","text":"1 ತಿಮೊ. 5:6:","reference":{"chapter":3,"verse":1}},{"noteId":112,"caller":"+","text":"ಲೂಕ 15:24; ಎಫೆ 2:1; ಕೊಲೊ 2:13:","reference":{"chapter":3,"verse":1}},{"noteId":113,"caller":"+","text":"ಉಳಿದ ದೇಹದ ಅಂಗಗಳನ್ನು","reference":{"chapter":3,"verse":2}},{"noteId":114,"caller":"+","text":"ಪ್ರಕ 16:15; ಮತ್ತಾ 24:43; 1 ಥೆಸ. 5:2, 4; 2 ಪೇತ್ರ. 3:10; ಪ್ರಕ 2:5:","reference":{"chapter":3,"verse":3}},{"noteId":115,"caller":"+","text":"ಯೂದ. 23:","reference":{"chapter":3,"verse":4}},{"noteId":116,"caller":"+","text":"ಲೂಕ 20:35:","reference":{"chapter":3,"verse":4}},{"noteId":117,"caller":"+","text":"ಪ್ರಕ 6:11; 7:9; ಪ್ರಸಂಗಿ. 9:8:","reference":{"chapter":3,"verse":4}},{"noteId":118,"caller":"+","text":"ಪ್ರಕ 2:7:","reference":{"chapter":3,"verse":5}},{"noteId":119,"caller":"+","text":"ಕೀರ್ತ 69:28; ವಿಮೋ 32:32; ಲೂಕ 10:20; ಫಿಲಿ. 4:3:","reference":{"chapter":3,"verse":5}},{"noteId":120,"caller":"+","text":"ಮತ್ತಾ 10:32; ಲೂಕ 12:8:","reference":{"chapter":3,"verse":5}},{"noteId":121,"caller":"+","text":"ಪ್ರಕ 2:7:","reference":{"chapter":3,"verse":6}},{"noteId":122,"caller":"+","text":"ಪ್ರಕ 6:10:","reference":{"chapter":3,"verse":7}},{"noteId":123,"caller":"+","text":"ಪ್ರಕ 3:14; 6:10; 19:11; 1 ಯೋಹಾ 5:20:","reference":{"chapter":3,"verse":7}},{"noteId":124,"caller":"+","text":"ಯೆಶಾ 22:22:","reference":{"chapter":3,"verse":7}},{"noteId":125,"caller":"+","text":"ಯೋಬ. 12:14; ಯೆಶಾ 22:22; ಮತ್ತಾ 16:19:","reference":{"chapter":3,"verse":7}},{"noteId":126,"caller":"+","text":"ಅ. ಕೃ. 14:27; 1 ಕೊರಿ 16:9; 2 ಕೊರಿ 2:12; ಕೊಲೊ 4:3:","reference":{"chapter":3,"verse":8}},{"noteId":127,"caller":"+","text":"ಪ್ರಕ 2:9:","reference":{"chapter":3,"verse":9}},{"noteId":128,"caller":"+","text":"ಯೆಶಾ 45:14; 49:23; 60. 14:","reference":{"chapter":3,"verse":9}},{"noteId":129,"caller":"+","text":"ಪ್ರಕ 1:9; 2 ಥೆಸ. 3:5; 2 ಪೇತ್ರ. 2:9:","reference":{"chapter":3,"verse":10}},{"noteId":130,"c