{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"1CH","translationId":"kan_okcv","name":"1 ಪೂರ್ವಕಾಲ ವೃತ್ತಾಂತ","commonName":"1 ಪೂರ್ವಕಾಲ ವೃತ್ತಾಂತ","title":"ಪೂರ್ವಕಾಲ ವೃತ್ತಾಂತ ಪ್ರಥಮ ಭಾಗ","order":13,"numberOfChapters":29,"sha256":"578ed58b1a4c50fe1d8caae44709d69598a8de0728516c839652a7472a351558","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/kan_okcv/1CH/29.json","totalNumberOfVerses":942},"chapter":{"number":16,"content":[{"type":"heading","content":["ಯೆಹೋವ ದೇವರ ಮಂಜೂಷದ ಮುಂದೆ ಸೇವೆಮಾಡುವುದು"]},{"type":"verse","number":1,"content":["ಅವರು ದೇವರ ಮಂಜೂಷವನ್ನು ಒಳಗೆ ತಂದು, ದಾವೀದನು ಅದಕ್ಕೋಸ್ಕರ ಹಾಕಿದ ಗುಡಾರದೊಳಗೆ ಅದರ ನಿಯಮಿತ ಸ್ಥಳದಲ್ಲಿ ಅದನ್ನು ಇಟ್ಟ ತರುವಾಯ, ಅವರು ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ದಹನಬಲಿಗಳನ್ನೂ, ಸಮಾಧಾನದ ಬಲಿಗಳನ್ನೂ ಅರ್ಪಿಸಿದರು."]},{"type":"verse","number":2,"content":["ದಾವೀದನು ದಹನಬಲಿಗಳನ್ನೂ, ಸಮಾಧಾನದ ಬಲಿಗಳನ್ನೂ ಅರ್ಪಿಸಿದ ತರುವಾಯ, ಅವನು ಯೆಹೋವ ದೇವರ ಹೆಸರಿನಲ್ಲಿ ಜನರನ್ನು ಆಶೀರ್ವದಿಸಿ,"]},{"type":"verse","number":3,"content":["ಇಸ್ರಾಯೇಲಿನ ಪ್ರತಿಯೊಬ್ಬ ಪುರುಷನಿಗೂ ಸ್ತ್ರೀಗೂ, ಒಂದು ರೊಟ್ಟಿಯನ್ನೂ, ಖರ್ಜೂರದ ಉಂಡೆಯನ್ನೂ, ದ್ರಾಕ್ಷಿ ಹಣ್ಣಿನ ಉಂಡೆಯನ್ನೂ ಹಂಚಿದನು."]},{"type":"verse","number":4,"content":["ಇದಲ್ಲದೆ ಯೆಹೋವ ದೇವರ ಮಂಜೂಷದ ಮುಂದೆ ಸೇವೆಮಾಡಲೂ, ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಸ್ಮರಿಸುವುದಕ್ಕೂ, ಕೊಂಡಾಡುವುದಕ್ಕೂ, ಹೊಗಳುವುದಕ್ಕೂ ಲೇವಿಯರಲ್ಲಿ ಕೆಲವರನ್ನು ನೇಮಿಸಿದನು."]},{"type":"verse","number":5,"content":["ಅವರು ಯಾರೆಂದರೆ: ಮುಖ್ಯಸ್ಥನಾದ ಆಸಾಫನೂ, ಅವನ ತರುವಾಯ ಜೆಕರ್ಯನೂ, ಯೆಜೀಯೇಲನೂ, ಶೆಮೀರಾಮೋತನೂ, ಯೆಹೀಯೇಲನೂ, ಮತ್ತಿತ್ಯನೂ, ಎಲೀಯಾಬನೂ, ಬೆನಾಯನೂ, ಓಬೇದ್ ಏದೋಮನೂ, ಯೆಹಿಯೇಲನೂ ಇವರು ವೀಣೆಗಳನ್ನೂ, ಕಿನ್ನರಿಗಳನ್ನೂ ಬಾರಿಸುತ್ತಿದ್ದರು. ಆದರೆ ಆಸಾಫನು ತಾಳಗಳನ್ನು ಬಾರಿಸುತ್ತಿದ್ದನು."]},{"type":"verse","number":6,"content":["ಇದಲ್ಲದೆ ಯಾಜಕರಾದ ಬೆನಾಯನೂ, ಯಹಜಿಯೇಲನೂ ದೇವರ ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷದ ಮುಂದೆ ಯಾವಾಗಲೂ ತುತೂರಿಗಳನ್ನು ಊದುವವರಾಗಿದ್ದರು."]},{"type":"verse","number":7,"content":["ಆಸಾಫನಿಗೂ, ಅವನ ಜೊತೆ ಲೇವಿಯರಿಗೂ ಯೆಹೋವ ದೇವರ ಸ್ತೋತ್ರಗೀತೆ ಹಾಡಲು ದಾವೀದನು ಪ್ರಥಮವಾಗಿ ಆ ದಿನದಲ್ಲೇ ನೇಮಿಸಿದನು. ಅವರು ಹೀಗೆಂದು ಹಾಡಿದರು:"]},{"type":"verse","number":8,"content":[{"text":"ಯೆಹೋವ ದೇವರಿಗೆ ಉಪಕಾರಸ್ತುತಿ ಮಾಡಿರಿ, ಅವರ ಹೆಸರನ್ನು ಸಾರಿ ಹೇಳಿರಿ,","poem":1},{"text":"ಜನರಲ್ಲಿ ದೇವರ ಕ್ರಿಯೆಗಳನ್ನು ತಿಳಿಯಪಡಿಸಿರಿ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ದೇವರಿಗೆ ಹಾಡಿರಿ, ದೇವರಿಗೆ ಕೀರ್ತನೆ ಹಾಡಿರಿ,","poem":1},{"text":"ದೇವರ ಅದ್ಭುತ ಕ್ರಿಯೆಗಳ ವಿಷಯವಾಗಿ ಮಾತನಾಡಿರಿ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ದೇವರ ಪರಿಶುದ್ಧ ನಾಮವನ್ನು ಹೊಗಳಿರಿ,","poem":1},{"text":"ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕುವವರ ಹೃದಯವು ಸಂತೋಷಿಸಲಿ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ಯೆಹೋವ ದೇವರನ್ನೂ, ಅವರ ಬಲವನ್ನೂ ಆಶ್ರಯಿಸಿರಿ,","poem":1},{"text":"ಅವರ ಮುಖವನ್ನು ಯಾವಾಗಲೂ ಹುಡುಕಿರಿ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ದೇವರು ಮಾಡಿದ ಆಶ್ಚರ್ಯಕಾರ್ಯಗಳನ್ನೂ, ಅವರ ಅದ್ಭುತಗಳನ್ನೂ,","poem":1},{"text":"ಅವರ ಬಾಯಿಂದ ಹೊರಟ ನ್ಯಾಯ ನಿರ್ಣಯಗಳನ್ನೂ ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ಅವರ ಸೇವಕನಾದ ಇಸ್ರಾಯೇಲಿನ ಸಂತತಿಯೇ,","poem":1},{"text":"ಅವರು ಆಯ್ದುಕೊಂಡ ಯಾಕೋಬನ ಮಕ್ಕಳೇ,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ಅವರೇ ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ಆಗಿದ್ದಾರೆ.","poem":1},{"text":"ಅವರ ನ್ಯಾಯಗಳು ಸಮಸ್ತ ಭೂಮಿಯಲ್ಲಿ ಇವೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ದೇವರು ತಮ್ಮ ಒಡಂಬಡಿಕೆಯನ್ನೂ,","poem":1},{"text":"ಸಾವಿರ ತಲಾಂತರಗಳಿಗೆ ಆಜ್ಞಾಪಿಸಿದ ತಮ್ಮ ಮಾತನ್ನೂ,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ಅಬ್ರಹಾಮನ ಸಂಗಡ ಮಾಡಿದ ಒಡಂಬಡಿಕೆಯನ್ನೂ,","poem":1},{"text":"ಇಸಾಕನಿಗೆ ಇಟ್ಟ ಆಣೆಯನ್ನೂ ಯುಗಯುಗಕ್ಕೂ ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ದೇವರು ಅದನ್ನು ಯಾಕೋಬನಿಗೆ ತೀರ್ಪನ್ನಾಗಿ ದೃಢಪಡಿಸಿದರು,","poem":1},{"text":"ಅವರು ಇಸ್ರಾಯೇಲರಿಗೆ ನಿತ್ಯ ಒಡಂಬಡಿಕೆಯಾಗಿ ಸ್ಥಾಪಿಸಿ ಹೇಳಿದ್ದೇನೆಂದರೆ:","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“ನಾನು ನಿಮಗೆ ಕಾನಾನ್ ದೇಶವನ್ನು","poem":1},{"text":"ನಿಮ್ಮ ಬಾಧ್ಯತೆಯ ಪಾಲಾಗಿ ಕೊಡುವೆನು.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ಆಗ ಅವರು ಅಲ್ಪಸಂಖ್ಯಾತರೂ, ಬಹು ಸ್ವಲ್ಪ ಮಂದಿಯಾಗಿಯೂ,","poem":1},{"text":"ಪರದೇಶಸ್ಥರಾಗಿಯೂ ನಾಡಿನಲ್ಲಿ ಇದ್ದರು.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ಅವರು ಜನಾಂಗದಿಂದ ಜನಾಂಗಕ್ಕೂ,","poem":1},{"text":"ಒಂದು ರಾಜ್ಯದಿಂದ ಬೇರೊಂದು ರಾಜ್ಯಕ್ಕೂ ಹೋಗುತ್ತಿದ್ದರು.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ಜನರು ಅವರಿಗೆ ಕೇಡು ಮಾಡದಂತೆ ದೇವರು ತಡೆದರು.","poem":1},{"text":"ಹೌದು, ಅವರಿಗೋಸ್ಕರ ದೇವರು ಅರಸರನ್ನು ಗದರಿಸಿ:","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ನನ್ನ ಅಭಿಷಿಕ್ತರನ್ನು ಮುಟ್ಟಬೇಡಿರಿ.","poem":1},{"text":"ನನ್ನ ಪ್ರವಾದಿಗಳಿಗೆ ಕೇಡು ಮಾಡಬೇಡಿರಿ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ಸಮಸ್ತ ಭೂನಿವಾಸಿಗಳೇ, ಯೆಹೋವ ದೇವರಿಗೆ ಹಾಡಿರಿ.","poem":1},{"text":"ಅವರ ರಕ್ಷಣೆಯನ್ನು ದಿನಂಪ್ರತಿ ಸಾರಿ ಹೇಳಿರಿ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ಜನಾಂಗಗಳಲ್ಲಿ ಅವರ ಘನತೆಯನ್ನೂ,","poem":1},{"text":"ಎಲ್ಲಾ ಜನಾಂಗಗಳಲ್ಲಿ ಅವರ ಅದ್ಭುತಗಳನ್ನೂ ವಿವರಿಸಿರಿ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ಯೆಹೋವ ದೇವರು ಮಹೋನ್ನತರಾಗಿದ್ದಾರೆ, ಬಹು ಸ್ತುತಿಗೆ ಪಾತ್ರರೂ ಆಗಿದ್ದಾರೆ;","poem":1},{"text":"ಅವರು ಎಲ್ಲಾ ದೇವರುಗಳಿಗಿಂತ ಬಹುಭಯಭಕ್ತಿಗೆ ಪಾತ್ರರಾಗಿದ್ದಾರೆ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ಏಕೆಂದರೆ ಜನಾಂಗಗಳ ದೇವರುಗಳೆಲ್ಲಾ ವಿಗ್ರಹಗಳಾಗಿವೆ;","poem":1},{"text":"ಆದರೆ ಯೆಹೋವ ದೇವರು ಆಕಾಶಮಂಡಲವನ್ನು ನಿರ್ಮಿಸಿದವರು.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ಅವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ಘನತೆಯೂ ಪ್ರಭೆಯೂ;","poem":1},{"text":"ಅವರ ಪರಿಶುದ್ಧ ಸ್ಥಳದಲ್ಲಿ ಬಲವೂ ಸಂತೋಷವೂ ಇವೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ಜನಾಂಗದ ಕುಟುಂಬಗಳೇ, ಯೆಹೋವ ದೇವರ ಮುಂದೆ,","poem":1},{"text":"ನೀವು ಮಹಿಮೆಯನ್ನೂ ಬಲವನ್ನೂ ಅರ್ಪಿಸಿರಿ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ಯೆಹೋವ ದೇವರ ಹೆಸರಿಗೆ ಸಲ್ಲತಕ್ಕ ಗೌರವವನ್ನು ಸಲ್ಲಿಸಿರಿ;","poem":1},{"text":"ಕಾಣಿಕೆಯನ್ನು ತೆಗೆದುಕೊಂಡು ದೇವರ ಸನ್ನಿಧಿಗೆ ಬನ್ನಿರಿ.","poem":2},{"text":"ಪರಿಶುದ್ಧತೆ ಎಂಬ ಭೂಷಣದೊಡನೆ ಯೆಹೋವ ದೇವರನ್ನು ಆರಾಧಿಸಿರಿ.","poem":1}]},{"type":"verse","number":30,"content":[{"text":"ಸಮಸ್ತ ಭೂನಿವಾಸಿಗಳೇ, ಅವರ ಮುಂದೆ ಭಯಪಡಿರಿ.","poem":2},{"lineBreak":true},{"text":"ಲೋಕವು ಸ್ಥಿರವಾಗಿರುವುದು, ಕದಲುವುದಿಲ್ಲ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"ಆಕಾಶವು ಸಂತೋಷಿಸಲಿ, ಭೂಮಿಯು ಉಲ್ಲಾಸಪಡಲಿ.","poem":1},{"text":"ಯೆಹೋವ ದೇವರು ಆಳುತ್ತಾರೆಂದು ಜನಾಂಗಗಳಲ್ಲಿ ಹೇಳಲಿ.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ಸಮುದ್ರವೂ ಅದರಲ್ಲಿರುವುದೆಲ್ಲವೂ ಘೋಷಿಸಲಿ.","poem":1},{"text":"ಹೊಲಗಳೂ ಅವುಗಳಲ್ಲಿರುವ ಸಮಸ್ತವೂ ಉತ್ಸಾಹಪಡಲಿ.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ಆಗ ಅಡವಿಯ ಮರಗಳೆಲ್ಲಾ ಯೆಹೋವ ದೇವರ ಮುಂದೆಯೇ","poem":1},{"text":"ಉತ್ಸಾಹಧ್ವನಿ ಮಾಡಲಿ.","poem":2},{"lineBreak":true},{"text":"ದೇವರು ಭೂಮಿಗೆ ನ್ಯಾಯತೀರಿಸಲು ಬರುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"ಯೆಹೋವ ದೇವರಿಗೆ ಕೃತಜ್ಞತಾ ಸ್ತುತಿಮಾಡಿರಿ.","poem":1},{"text":"ಅವರು ಒಳ್ಳೆಯವರು; ಅವರ ಪ್ರೀತಿ ಶಾಶ್ವತವಾಗಿರುವುದು.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ನಮ್ಮ ರಕ್ಷಣೆಯ ದೇವರೇ,","poem":1},{"text":"“ನಾವು ನಿಮ್ಮ ಪರಿಶುದ್ಧ ಹೆಸರಿಗೆ ಉಪಕಾರಸ್ತುತಿ ಮಾಡಿ,","poem":2},{"text":"ನಿಮ್ಮ ಸ್ತೋತ್ರದಲ್ಲಿ ಜಯಘೋಷ ಮಾಡುವ ಹಾಗೆ ನಮ್ಮನ್ನು ರಕ್ಷಿಸಿರಿ,","poem":1},{"text":"ಜನಾಂಗಗಳೊಳಗಿಂದ ನಮ್ಮನ್ನು ಬಿಡುಗಡೆ ಮಾಡಿ ಒಂದುಗೂಡಿಸಿರಿ.”","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ಇಸ್ರಾಯೇಲ್ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ","poem":1},{"text":"ಯುಗಯುಗಕ್ಕೂ ಸ್ತುತಿಯುಂಟಾಗಲಿ,","poem":2},"ಜನರೆಲ್ಲರೂ, “ಆಮೆನ್,” ಎಂದು ಹೇಳಲಿ. ನೀವು, “ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ,” ಎಂದು ಹೇಳಿದರು."]},{"type":"line_break"},{"type":"verse","number":37,"content":["ಪ್ರತಿದಿನದ ಅವಶ್ಯಕತೆಗಳಿಗೆ ಅನುಗುಣವಾಗಿ ನಿಯಮಿತವಾಗಿ ಯೆಹೋವ ದೇವರ ಒಡಂಬಡಿಕೆಯ ಮಂಜೂಷದ ಮುಂದೆ ಸೇವೆ ಸಲ್ಲಿಸಲು ದಾವೀದನು ಆಸಾಫ್ ಮತ್ತು ಅವನ ಸಹಚರರನ್ನು ನೇಮಿಸಿದನು."]},{"type":"verse","number":38,"content":["ಓಬೇದ್ ಏದೋಮ್ ಮತ್ತು ಅವನ ಸಹಚರರಾದ ಅರವತ್ತೆಂಟು ಮಂದಿಯೂ, ದ್ವಾರಪಾಲಕರಾದ ಯೆದುತೂನನ ಮಗ ಓಬೇದ್ ಎದೋಮ್ ಮತ್ತು ಹೋಸ ನೇಮಕವಾಗಿದ್ದರು."]},{"type":"verse","number":39,"content":["ಗಿಬ್ಯೋನಿನಲ್ಲಿರುವ ಉನ್ನತ ಸ್ಥಳದಲ್ಲಿ ಯೆಹೋವ ದೇವರ ಗುಡಾರದ ಮುಂದೆ ಸೇವೆಮಾಡುವದಕ್ಕೆ ದಾವೀದನು ಯಾಜಕನಾದ ಚಾದೋಕನನ್ನೂ ಮತ್ತು ಅವನ ಸಹೋದರರನ್ನು ನೇಮಿಸಿದನು."]},{"type":"verse","number":40,"content":["ಯೆಹೋವ ದೇವರು ಇಸ್ರಾಯೇಲಿಗೆ ಆಜ್ಞಾಪಿಸಿದ ಮೋಶೆಯ ನಿಯಮದಲ್ಲಿ ಬರೆದಿದ್ದ ಎಲ್ಲಾದರ ಪ್ರಕಾರ ಮಾಡಲೂ ಅವರು ಪ್ರತಿದಿನವೂ ಉದಯಕಾಲದಲ್ಲಿ ಮತ್ತು ಸಾಯಂಕಾಲದಲ್ಲಿ ದಹನಬಲಿಪೀಠದ ಮೇಲೆ ಯೆಹೋವ ದೇವರಿಗೆ ದಹನಬಲಿಗಳನ್ನು ಅರ್ಪಿಸುತ್ತಿದ್ದರು."]},{"type":"verse","number":41,"content":["“ದೇವರ ಪ್ರೀತಿ ನಿತ್ಯವಾಗಿ ನೆಲೆಗೊಂಡಿರುವುದು,” ಎಂದು ಯೆಹೋವ ದೇವರನ್ನು ಕೊಂಡಾಡುವುದಕ್ಕೆ ಹೇಮಾನನೂ, ಯೆದುತೂನನೂ ಹೆಸರು ಹೆಸರಾಗಿ ಆಯ್ಕೆಗೊಂಡು, ನೇಮಕರಾಗಿದ್ದರು."]},{"type":"verse","number":42,"content":["ಅದರ ಸಂಗಡ ತುತೂರಿ ಊದಲು, ತಾಳ ಬಾರಿಸಲು, ದೇವರ ಗೀತವಾದ್ಯಗಳೂ ಸಹಿತವಾಗಿ ಹೇಮಾನನೂ, ಯೆದುತೂನನೂ ಮೇಲ್ವಿಚಾರಕರಾಗಿದ್ದರು. ಯೆದುತೂನನ ಪುತ್ರರು ದ್ವಾರಪಾಲಕರಾಗಿದ್ದರು."]},{"type":"verse","number":43,"content":["ತರುವಾಯ ಜನರೆಲ್ಲರು ತಮ್ಮ ತಮ್ಮ ಮನೆಗೆ ಹೋದರು. ದಾವೀದನು ತನ್ನ ಕುಟುಂಬವನ್ನು ಆಶೀರ್ವದಿಸುವುದಕ್ಕೆ ಹೋದನು."]}],"footnotes":[]},"thisChapterLink":"/api/kan_okcv/1CH/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/1CH/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/1CH/15.json","previousChapterAudioLinks":{},"numberOfVerses":43}