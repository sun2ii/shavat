{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"AMO","translationId":"kan_okcv","name":"ಆಮೋಸ","commonName":"ಆಮೋಸ","title":"ಆಮೋಸ","order":30,"numberOfChapters":9,"sha256":"d6aeda1449f28e3446e1594a55ce9763672f91118236af3c1fcb95cc4dbb35c7","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/kan_okcv/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"heading","content":["ಒಂದು ಪ್ರಲಾಪ ಮತ್ತು ಪಶ್ಚಾತ್ತಾಪಕ್ಕೆ ಕರೆ"]},{"type":"verse","number":1,"content":["ಇಸ್ರಾಯೇಲಿನ ಜನರೇ, ನಿಮ್ಮನ್ನು ಕುರಿತು ನಾನು ಹಾಡುವ ಈ ಶೋಕಗೀತೆಯ ವಾಕ್ಯವನ್ನು ಕೇಳಿರಿ:"]},{"type":"verse","number":2,"content":[{"text":"“ಇಸ್ರಾಯೇಲ್ ಎಂಬ ಕನ್ಯೆಯು ಬಿದ್ದಿದ್ದಾಳೆ.","poem":1},{"text":"ಇನ್ನು ಮೇಲೆ ಎದ್ದೇಳುವುದೇ ಇಲ್ಲ.","poem":2},{"text":"ಅವಳು ದಿಕ್ಕಿಲ್ಲದೆ ತನ್ನ ಭೂಮಿಯ ಮೇಲೆ ಒರಗಿದ್ದಾಳೆ.","poem":1},{"text":"ಅಲ್ಲಿ ಅವಳನ್ನು ಎಬ್ಬಿಸುವವರು ಯಾರೂ ಇಲ್ಲ.”","poem":2}]},{"type":"verse","number":3,"content":["ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ:",{"text":"“ಯುದ್ಧಕ್ಕೆ ಹೊರಟ ಸಾವಿರ ಮಂದಿ ಸೈನಿಕರಲ್ಲಿ,","poem":1},{"text":"ಪಟ್ಟಣಕ್ಕೆ ಮರಳಿದವರು ನೂರೇ ಮಂದಿ.","poem":2},{"text":"ರಣರಂಗಕ್ಕೆ ಹೊರಟ ನೂರು ಮಂದಿ ಯೋಧರಲ್ಲಿ,","poem":1},{"text":"ಇಸ್ರಾಯೇಲಿಗೆ ಮರಳಿದವರು ಹತ್ತೇ ಮಂದಿ.”","poem":2}]},{"type":"verse","number":4,"content":["ಯೆಹೋವ ದೇವರು ಇಸ್ರಾಯೇಲಿನ ಮನೆಯವರಿಗೆ ಹೀಗೆ ಹೇಳುತ್ತಾರೆ:",{"text":"“ನೀವು ನನ್ನನ್ನು ಹುಡುಕಿರಿ ಮತ್ತು ಬದುಕಿಕೊಳ್ಳಿರಿ.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"ಆದರೆ ಬೇತೇಲನ್ನು ಹುಡುಕಬೇಡಿರಿ.","poem":2},{"text":"ಗಿಲ್ಗಾಲಿಗೆ ಹೋಗಬೇಡಿರಿ.","poem":1},{"text":"ಬೇರ್ಷೆಬಕ್ಕೆ ಯಾತ್ರೆ ಹೋಗಬೇಡಿರಿ.","poem":2},{"text":"ಏಕೆಂದರೆ ಗಿಲ್ಗಾಲು ಸೆರೆಗೆ ನಿಶ್ವಯವಾಗಿ ಹೋಗುವುದು,","poem":1},{"text":"ಬೇತೇಲಿನ ಬಾಧೆಗಳು ಕೊನೆಗೊಳ್ಳುವುದಿಲ್ಲ","poem":2},{"noteId":1},{"text":".”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ನೀವು ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕಿರಿ ಮತ್ತು ಬದುಕಿರಿ.","poem":1},{"text":"ಇಲ್ಲದಿದ್ದರೆ, ಆತನು ಬೆಂಕಿಯಂತೆ ಯೋಸೇಫನ ಗೋತ್ರಗಳಲ್ಲಿ ಪ್ರವೇಶಿಸುವನು.","poem":2},{"text":"ಅದು ದಹಿಸಿಬಿಡುವುದು,","poem":1},{"text":"ಅದನ್ನು ಆರಿಸುವವರು ಬೇತೇಲಿನಲ್ಲಿ ಯಾರೂ ಇರುವುದಿಲ್ಲ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ನ್ಯಾಯವನ್ನು ಕಹಿಯಾಗಿ ತಿರುಗಿಸುವವರೇ,","poem":1},{"text":"ನೀತಿಯನ್ನು ಭೂಮಿಯಲ್ಲಿ ಬಿಡುವವರೇ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ವೃಷಭ ರಾಶಿಯನ್ನೂ, ಮೃಗಶಿರವನ್ನೂ ಉಂಟು ಮಾಡಿದವನನ್ನೂ","poem":1},{"text":"ಕಾರ್ಗತ್ತಲನ್ನು ಉದಯಕ್ಕೆ ಬದಲಿಸಿ,","poem":2},{"lineBreak":true},{"text":"ಹಗಲನ್ನು ರಾತ್ರಿಯಾಗುವ ಹಾಗೆ ಕತ್ತಲೆ ಮಾಡಿ,","poem":2},{"text":"ಸಮುದ್ರದ ನೀರನ್ನು ಬರಮಾಡಿ,","poem":1},{"text":"ಅವುಗಳನ್ನು ಭೂಮಿಯ ಮೇಲೆ ಸುರಿಸುವ","poem":2},{"lineBreak":true},{"text":"ಯೆಹೋವ ದೇವರು ಎಂಬ ಹೆಸರುಳ್ಳವರನ್ನೇ ಹುಡುಕಿರಿ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ಕಣ್ಣು ಮಿಟುಕಿಸುವುದರಲ್ಲಿ ಅವರು ಕೋಟೆಯನ್ನು ನಾಶಪಡಿಸುತ್ತಾರೆ","poem":1},{"text":"ಮತ್ತು ಕೋಟೆಯ ನಗರವನ್ನು ವಿನಾಶಪಡಿಸುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ಸಭೆಯಲ್ಲಿ ದೋಷವನ್ನು ಎತ್ತಿ ತೋರಿಸುವವನನ್ನು ನೀವು ದ್ವೇಷಿಸುತ್ತೀರಿ.","poem":1},{"text":"ನಿಮ್ಮ ವಿಷಯವಾಗಿ ಸತ್ಯವನ್ನು ಹೇಳುವವನನ್ನೇ ಹೀನೈಸುತ್ತೀರಿ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ಆದಕಾರಣ ನೀವು ಬಡವನನ್ನು ತುಳಿದು","poem":1},{"text":"ಅವರ ಧಾನ್ಯಕ್ಕೆ ತೆರಿಗೆ ವಿಧಿಸುತ್ತೀರಿ.","poem":2},{"text":"ಆದ್ದರಿಂದ ನೀವು ಕೆತ್ತಿದ ಕಲ್ಲಿನ ಮನೆಗಳನ್ನು ಕಟ್ಟಿದ್ದೀರಿ.","poem":1},{"text":"ಆದರೆ ನೀವು ಅವುಗಳಲ್ಲಿ ವಾಸ ಮಾಡದೇ ಇರುವಿರಿ.","poem":2},{"text":"ರಮ್ಯವಾದ ದ್ರಾಕ್ಷಿತೋಟಗಳನ್ನು ನೆಟ್ಟಿರಲ್ಲಾ,","poem":1},{"text":"ಆದರೆ ಅವುಗಳ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಕುಡಿಯಲಾರಿರಿ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ಏಕೆಂದರೆ ನಿಮ್ಮ ಅನೇಕ ಅಪರಾಧಗಳನ್ನೂ,","poem":1},{"text":"ನಿಮ್ಮ ಘೋರವಾದ ಪಾಪಗಳನ್ನೂ ನಾನು ಬಲ್ಲೆನು.","poem":2},{"lineBreak":true},{"text":"ಅವರು ನಿರಪರಾಧಿಯನ್ನು ಬಾಧೆಪಡಿಸಿ, ಲಂಚವನ್ನು ತೆಗೆದುಕೊಂಡರು","poem":1},{"text":"ಮತ್ತು ಬಾಗಿಲ ಬಳಿಯಲ್ಲಿರುವ ಬಡವರ ನ್ಯಾಯವನ್ನು ತೀರಿಸದೇ ಕಳುಹಿಸಿಬಿಟ್ಟಿರಿ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ಆದ್ದರಿಂದ ಆ ಕಾಲದಲ್ಲಿ ಬುದ್ಧಿವಂತನು ಮೌನವಾಗಿರುವನು,","poem":1},{"text":"ಏಕೆಂದರೆ ಅದು ಕೆಟ್ಟ ಕಾಲವಾಗಿದೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ನೀವು ಬದುಕುವ ಹಾಗೆ","poem":1},{"text":"ಒಳ್ಳೆಯದನ್ನು ಹುಡುಕಿ, ಕೆಟ್ಟದ್ದನ್ನಲ್ಲ.","poem":2},{"text":"ಆಗ ನೀವು ಹೇಳಿಕೊಳ್ಳುವಂತೆ","poem":1},{"text":"ಸರ್ವಶಕ್ತರಾದ ಯೆಹೋವ ದೇವರು ನಿಮ್ಮ ಸಂಗಡ ಇರುವರು.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ಕೆಟ್ಟದ್ದನ್ನು ದ್ವೇಷಿಸಿರಿ, ಒಳ್ಳೆಯದನ್ನು ಪ್ರೀತಿಸಿರಿ,","poem":1},{"text":"ಬಾಗಿಲಲ್ಲಿ ನ್ಯಾಯವನ್ನು ಸ್ಥಾಪಿಸಿರಿ.","poem":2},{"text":"ಒಂದು ವೇಳೆ ಸರ್ವಶಕ್ತರಾದ ಯೆಹೋವ ದೇವರು","poem":1},{"text":"ಯೋಸೇಫನ ಗೋತ್ರದಲ್ಲಿ ಉಳಿದವರಿಗೆ ಕನಿಕರಿಸಬಹುದು.","poem":2}]},{"type":"verse","number":16,"content":["ಆದ್ದರಿಂದ ಸರ್ವಶಕ್ತ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ:",{"text":"“ಎಲ್ಲಾ ಬೀದಿಗಳಲ್ಲೂ ವಿಲಾಪಗಳು,","poem":1},{"text":"ಎಲ್ಲಾ ಸಾರ್ವಜನಿಕ ಚೌಕದಲ್ಲಿ ದುಃಖದ ಗೋಳಾಟಗಳು ಎನ್ನುವರು.","poem":2},{"text":"ರೈತರನ್ನು ಕಣ್ಣೀರಿಡುವುದಕ್ಕೂ ಶೋಕವೃತ್ತಿಯವರನ್ನು,","poem":1},{"text":"ಗೋಳಾಡುವುದಕ್ಕೂ ಕರೆಯಲಾಗುವುದು.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ಎಲ್ಲಾ ದ್ರಾಕ್ಷಿ ತೋಟಗಳಲ್ಲೂ ಗೋಳಾಟವು ಇರುವುದು.","poem":1},{"text":"ಏಕೆಂದರೆ ನಾನು ನಿನ್ನ ಮಧ್ಯೆ ಹಾದು ಹೋಗುವೆನು,”","poem":2},{"lineBreak":true},{"text":"ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.","poem":2}]},{"type":"heading","content":["ಯೆಹೋವ ದೇವರ ದಿನ"]},{"type":"verse","number":18,"content":[{"text":"ಯೆಹೋವ ದೇವರ ದಿನವನ್ನು ಅಪೇಕ್ಷಿಸುವವರೇ,","poem":1},{"text":"ಅಯ್ಯೋ ನಿಮಗೆ ಕಷ್ಟ!","poem":2},{"text":"ಆ ದಿನವನ್ನು ನೀವು ಅಪೇಕ್ಷಿಸುವುದೇಕೆ?","poem":1},{"text":"ಯೆಹೋವ ದೇವರ ದಿವಸವು ನಿಮಗೆ ಬೆಳಕಲ್ಲ, ಕತ್ತಲೆಯೇ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ಇದು ಒಬ್ಬ ಮನುಷ್ಯನು ಸಿಂಹದಿಂದ ತಪ್ಪಿಸಿಕೊಂಡು ಓಡಿಹೋಗಿ,","poem":1},{"text":"ಕರಡಿಯನ್ನು ಎದುರುಗೊಂಡ ಹಾಗೆಯೂ,","poem":2},{"text":"ಇಲ್ಲವೆ ಅವನು ಮನೆಗೆ ಹೋಗಿ","poem":1},{"text":"ಗೋಡೆಗೆ ತನ್ನ ಕೈಯನ್ನು ಒರಗಿಸಿದಾಗ,","poem":2},{"lineBreak":true},{"text":"ಸರ್ಪವು ಕಚ್ಚಿದ ಹಾಗೆಯೂ ಇರುವುದು.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ಹೀಗೆ ಯೆಹೋವ ದೇವರ ದಿವಸವು ಬೆಳಕಲ್ಲ, ಕತ್ತಲೆಯೇ.","poem":1},{"text":"ಅದರಲ್ಲಿ ಪ್ರಕಾಶವೇನೂ ಇಲ್ಲದ ಕಾರ್ಗತ್ತಲೆಯೇ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ನಿಮ್ಮ ಹಬ್ಬಗಳನ್ನು ಹಗೆಮಾಡಿ ತುಚ್ಛೀಕರಿಸುತ್ತೇನೆ.","poem":1},{"text":"ನಿಮ್ಮ ಸಭೆಗಳು ನನಗೆ ದುರ್ವಾಸನೆ ಇದ್ದಂತೆ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ನೀವು ನನಗೆ ದಹನಬಲಿಗಳನ್ನೂ ಧಾನ್ಯ ಸಮರ್ಪಣೆಗಳನ್ನೂ ಅರ್ಪಿಸಿದರೂ,","poem":1},{"text":"ನಾನು ಅವುಗಳನ್ನು ಅಂಗೀಕರಿಸುವುದಿಲ್ಲ.","poem":2},{"text":"ನಿಮ್ಮ ಕೊಬ್ಬಿದ ಪ್ರಾಣಿಗಳ ಸಮಾಧಾನದ ಬಲಿಗಳನ್ನೂ","poem":1},{"text":"ನಾನು ಲಕ್ಷಿಸುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ನಿಮ್ಮ ಹಾಡುಗಳ ಬೊಬ್ಬೆಗಳನ್ನು ನನ್ನಿಂದ ತೊಲಗಿಸಿರಿ.","poem":1},{"text":"ನಿಮ್ಮ ವೀಣೆಗಳ ಮಧುರ ಸ್ವರವನ್ನು ನಾನು ಕೇಳುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ಆದರೆ ನ್ಯಾಯವು ನೀರಿನಂತೆಯೂ","poem":1},{"text":"ನೀತಿಯು ಬಲವಾದ ಪ್ರವಾಹದಂತೆಯೂ ಹರಿಯಲಿ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ಇಸ್ರಾಯೇಲಿನ ಮನೆತನದವರೇ,","poem":1},{"text":"ನೀವು ನನಗೆ ನಲವತ್ತು ವರ್ಷ ಮರುಭೂಮಿಯಲ್ಲಿ ಬಲಿಗಳನ್ನು, ಕಾಣಿಕೆಗಳನ್ನು ಅರ್ಪಿಸಿದಿರೋ?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ಆದರೆ ನೀವು ನಿಮಗೋಸ್ಕರ ಮಾಡಿಕೊಂಡ ಮೂರ್ತಿಗಳಾದ","poem":1},{"text":"ಸಿಕ್ಕೊತ್ ಎಂಬ ನಿಮ್ಮ ರಾಜನನ್ನೂ","poem":2},{"lineBreak":true},{"text":"ಕಿಯೂನ್ ಎಂಬ ನಿಮ್ಮ ನಕ್ಷತ್ರ ದೇವತೆಯನ್ನೂ","poem":2},{"lineBreak":true},{"text":"ನೀವೇ ಹೊತ್ತುಕೊಂಡು ಹೋಗಬೇಕಾಗುವುದು.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ಆದ್ದರಿಂದ ದಮಸ್ಕದ ಆಚೆ ನಿಮ್ಮನ್ನು ಸೆರೆಯಾಳುಗಳಾಗಿ ಕಳುಹಿಸುವೆ,","poem":1},{"text":"ಎಂದು ಸರ್ವಶಕ್ತರಾದ ದೇವರೆಂದು ಹೆಸರುಗೊಂಡ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"ಕೊನೆಗೊಳ್ಳುವುದಿಲ್ಲ ಹೋಶೇ 4:15ನೋಡಿರಿ","reference":{"chapter":5,"verse":5}}]},"thisChapterLink":"/api/kan_okcv/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}