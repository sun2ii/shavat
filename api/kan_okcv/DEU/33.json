{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"DEU","translationId":"kan_okcv","name":"ಧರ್ಮೋಪದೇಶಕಾಂಡ","commonName":"ಧರ್ಮೋಪದೇಶಕಾಂಡ","title":"ಧರ್ಮೋಪದೇಶಕಾಂಡ","order":5,"numberOfChapters":34,"sha256":"6112dbfc6f175459d1408db989fb96d276ccc4c75553f32e3fd9fc82cf77622e","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/kan_okcv/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":33,"content":[{"type":"heading","content":["ಮೋಶೆ ಗೋತ್ರಗಳನ್ನು ಆಶೀರ್ವದಿಸಿದ್ದು"]},{"type":"verse","number":1,"content":["ದೇವರ ಮನುಷ್ಯನಾದ ಮೋಶೆಯು ಮರಣ ಹೊಂದುವದಕ್ಕಿಂತ ಮುಂಚೆ ಇಸ್ರಾಯೇಲರಿಗೆ ಕೊಟ್ಟ ಆಶೀರ್ವಾದ:"]},{"type":"verse","number":2,"content":[{"text":"“ಯೆಹೋವ ದೇವರು ಸೀನಾಯಿ ಬೆಟ್ಟದಿಂದ ಬಂದು,","poem":1},{"text":"ಸೇಯೀರಿನಿಂದ ಅವರ ಮೇಲೆ ಉದಯಿಸಿದರು.","poem":2},{"lineBreak":true},{"text":"ಪಾರಾನ್ ಬೆಟ್ಟದಿಂದ ಪ್ರಕಾಶಿಸಿದರು.","poem":2},{"text":"ದೇವರು ದಕ್ಷಿಣದ ತಮ್ಮ ಪರ್ವತ ಶ್ರೇಣಿಯಿಂದ","poem":1},{"text":"ಲಕ್ಷಾಂತರ ಪರಿಶುದ್ಧರ ಸಂಗಡ ಬಂದರು.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ನಿಶ್ಚಯವಾಗಿ ನೀವು ಜನರನ್ನು ಪ್ರೀತಿಸುತ್ತೀರಿ.","poem":1},{"text":"ಪರಿಶುದ್ಧ ಜನರು ನಿಮ್ಮ ಆಶ್ರಯದಲ್ಲಿಯೇ ಇದ್ದಾರೆ.","poem":2},{"text":"ನಿಮ್ಮ ಪಾದಗಳಿಗೆ ಎಲ್ಲರೂ ಎರಗುವರು.","poem":1},{"text":"ನಿಮ್ಮಿಂದಲೇ ಬೋಧನೆ ಪಡೆಯುವರು.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ಯಾಕೋಬನ ಸಂತತಿಯವರಾದ ನಮಗೆ,","poem":1},{"text":"ಮೋಶೆಯು ನಿಯಮವನ್ನು ಸೊತ್ತಾಗಿ ಕೊಟ್ಟಿದ್ದಾನೆ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ಇಸ್ರಾಯೇಲರ ಮುಖ್ಯಸ್ಥರೂ","poem":1},{"text":"ಅವರ ಗೋತ್ರಗಳು ಒಟ್ಟಾಗಿ ಸೇರಿಬಂದಾಗ,","poem":2},{"lineBreak":true},{"text":"ದೇವರೇ ಯೆಶುರೂನಿನ ಮೇಲೆ ಅರಸನಾಗಿದ್ದರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“ರೂಬೇನನು ಸಾಯದೆ ಬದುಕಲಿ.","poem":1},{"text":"ಅವನ ಜನರು ಕಡಿಮೆಯಾಗದಿರಲಿ.”","poem":2}]},{"type":"verse","number":7,"content":["ಯೆಹೂದನ ಬಗ್ಗೆ ಮೋಶೆ ಹೇಳಿದ ಮಾತಿದು:",{"text":"“ಯೆಹೋವ ದೇವರೇ, ಯೆಹೂದನ ಮೊರೆಯನ್ನಾಲಿಸಿ,","poem":1},{"text":"ಅವರನ್ನು ಅವರ ಬಂಧುಗಳೊಡನೆ ಸೇರಿಸಿರಿ.","poem":2},{"text":"ಅವನ ಸ್ವಂತ ಕೈಗಳೇ ತನ್ನ ಹಕ್ಕು ಬಾಧ್ಯತೆಗಳನ್ನು ಕಾದಿರಿಸುತ್ತವೆ.","poem":1},{"text":"ಅವನ ಶತ್ರುಗಳಿಂದ ಅವನನ್ನು ತಪ್ಪಿಸಿರಿ.”","poem":2}]},{"type":"verse","number":8,"content":["ಲೇವಿ ಕುಲದ ವಿಷಯದಲ್ಲಿ ಹೇಳಿದ್ದೇನೆಂದರೆ:",{"text":"“ನಿಮ್ಮ ನಿರ್ಣಯವನ್ನು ತಿಳಿಸುವ ಊರೀಮ್, ತುಮ್ಮೀಮ್ ಎಂಬ ವಸ್ತುಗಳು","poem":1},{"text":"ನಿಮ್ಮ ಭಕ್ತರಾದ ಇವರ ವಶದಲ್ಲಿ ಉಂಟಷ್ಟೆ.","poem":2},{"text":"ನೀವು ಮಸ್ಸದಲ್ಲಿ ಅವರನ್ನು ಪರೀಕ್ಷಿಸಿದಿರಿ.","poem":1},{"text":"ಮೆರೀಬಾದಲ್ಲಿ ನೀರು ಹೊರಟ ಸ್ಥಳದ ಹತ್ತಿರ ಅವರೊಡನೆ ವಿವಾದ ಮಾಡಿದಿರಿ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ಅವನು ತನ್ನ ತಂದೆತಾಯಿಗಳ ಬಗ್ಗೆ,","poem":1},{"text":"‘ಅವರಿಗಾಗಿ ನನಗೆ ಗೌರವವಿಲ್ಲ.’","poem":2},{"text":"ಅವನು ತನ್ನ ಸಹೋದರರನ್ನೂ ಗುರುತಿಸಲಿಲ್ಲ","poem":1},{"text":"ತನ್ನ ಸ್ವಂತ ಮಕ್ಕಳನ್ನೂ ಅರಿಯಲಿಲ್ಲ,","poem":2},{"text":"ಏಕೆಂದರೆ ಅವನು ನಿಮ್ಮ ವಾಕ್ಯವನ್ನು ಕೈಗೊಂಡು","poem":1},{"text":"ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯನ್ನು ಕಾಪಾಡಿದ್ದಾನೆ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ಅವನು ಯಾಕೋಬನಿಗೆ ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನೂ,","poem":1},{"text":"ಇಸ್ರಾಯೇಲರಿಗೆ ನಿಮ್ಮ ನಿಯಮವನ್ನೂ ಬೋಧಿಸುವನು.","poem":2},{"text":"ನಿಮ್ಮ ಮುಂದೆ ಧೂಪವನ್ನೂ","poem":1},{"text":"ನಿಮ್ಮ ಬಲಿಪೀಠದ ಮೇಲೆ ಸರ್ವಾಂಗ ದಹನಬಲಿಯನ್ನೂ ಸಮರ್ಪಿಸುವನು.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ಯೆಹೋವ ದೇವರೇ, ಅವನ ಎಲ್ಲ ಕೌಶಲ್ಯಗಳನ್ನು ಆಶೀರ್ವದಿಸಿರಿ.","poem":1},{"text":"ಅವನ ಕೈಕೆಲಸವನ್ನು ಅಂಗೀಕರಿಸಿರಿ.","poem":2},{"text":"ಅವನಿಗೆ ವಿರೋಧವಾಗಿ ಏಳುವವರ ನಡು ಮುರಿದು ಹೋಗಲಿ.","poem":1},{"text":"ಅವನನ್ನು ದ್ವೇಷಿಸುವವರು ತಿರುಗಿ ಏಳದ ಹೋಗಲಿ.”","poem":2}]},{"type":"verse","number":12,"content":["ಮೋಶೆಯು ಬೆನ್ಯಾಮೀನನ ವಿಷಯವಾಗಿ ಹೇಳಿದ್ದೇನೆಂದರೆ:",{"text":"“ಯೆಹೋವ ದೇವರಿಗೆ ಪ್ರಿಯನಾದ ಇವನು ದೇವರ ಬಳಿಯಲ್ಲಿ ಸುರಕ್ಷಿತವಾಗಿ ವಾಸಮಾಡುವನು.","poem":1},{"text":"ದೇವರು ಅವನಿಗೆ ದಿನವೆಲ್ಲಾ ಆಸರೆಯಾಗಿರುವರು.","poem":2},{"lineBreak":true},{"text":"ಅವನು ದೇವರ ಭುಜಗಳ ನಡುವೆ ವಿಶ್ರಾಂತಿ ಪಡೆಯುವನು.”","poem":2}]},{"type":"verse","number":13,"content":["ಯೋಸೇಫನ ವಿಷಯವಾಗಿ ಹೇಳಿದ್ದೇನೆಂದರೆ:",{"text":"“ಅವನ ದೇಶವು","poem":1},{"text":"ಆಕಾಶದ ಅಮೂಲ್ಯವಾದ ಮಂಜಿನಿಂದಲೂ,","poem":2},{"lineBreak":true},{"text":"ಕೆಳಗೆ ಸಾಗರ ಸೆಲೆಯಿಂದಲೂ ಯೆಹೋವ ದೇವರ ಆಶೀರ್ವಾದ ಹೊಂದಲಿ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ಸೂರ್ಯನು ತರುವ ಉತ್ಕೃಷ್ಟವಾದವುಗಳಿಂದಲೂ","poem":1},{"text":"ಚಂದ್ರನು ದಯಪಾಲಿಸುವ ಅಮೂಲ್ಯವಾದವುಗಳಿಂದಲೂ","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ಪುರಾತನ ಪರ್ವತಗಳಿಂದ ದೊರೆಯುವ ಅತ್ಯುತ್ತಮ ಕಾಣಿಕೆಗಳಿಂದಲೂ","poem":1},{"text":"ಶಾಶ್ವತ ಪರ್ವತಗಳಿಂದ ಸಿಗುವ ಒಳಿತುಗಳಿಂದಲೂ,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ಭೂಮಿಯಲ್ಲಿ ಸಮೃದ್ಧಿಯಾಗಿ ಬೆಳೆಯುವ ಫಲಗಳಲ್ಲಿ ಉತ್ಕೃಷ್ಟವಾದುದೆಲ್ಲವೂ","poem":1},{"text":"ಸುಡುವ ಪೊದೆಯಲ್ಲಿ ವಾಸವಾಗಿದ್ದ ದೇವರ ದಯೆಯೂ","poem":2},{"text":"ಯೋಸೇಫನ ತಲೆಯ ಮೇಲೆ ನೆಲೆಗೊಳ್ಳಲಿ.","poem":1},{"text":"ಅವನು ತನ್ನ ಸಹೋದರರಲ್ಲಿ ರಾಜಕುಮಾರನಾಗಿರುವನು.","poem":2},{"lineBreak":true},{"text":"ಕುಲದವರ ಶಿರಸ್ಸಾಗಿರುವ ಅವನ ಮೇಲೆ ಆಶೀರ್ವಾದ ಉಂಟಾಗಲಿ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ಅವನ ವೈಭವವು ಚೊಚ್ಚಲ ಹೋರಿಯಂತೆ ಇರುವುದು,","poem":1},{"text":"ಅವನ ಕೊಂಬುಗಳು ಕಾಡುಕೋಣಗಳ ಕೊಂಬುಗಳಂತೆ ಇರುವುದು.","poem":2},{"text":"ಇವುಗಳಿಂದ ಜನಾಂಗಗಳನ್ನೆಲ್ಲಾ ಇರಿದು","poem":1},{"text":"ಒಟ್ಟಿಗೆ ಭೂಮಿಯ ಅಂಚಿನವರೆಗೆ ಓಡಿಸುವನು.","poem":2},{"text":"ಎಫ್ರಾಯೀಮ್ ಕುಲದ ಹತ್ತು ಸಾವಿರ ಜನರೂ ಇಂಥವರೇ.","poem":1},{"text":"ಮನಸ್ಸೆ ಕುಲದ ಸಹಸ್ರ ಜನರೂ ಇಂಥವರೇ ಆಗಿದ್ದಾರೆ.”","poem":2}]},{"type":"verse","number":18,"content":["ಮೋಶೆಯು ಜೆಬುಲೂನರ ವಿಷಯವಾಗಿ ಹೇಳಿದ್ದೇನೆಂದರೆ:",{"text":"“ಜೆಬೂಲೂನನೇ, ನಿನ್ನ ಪ್ರಯಾಣದಲ್ಲಿ ಸಂತೋಷಪಡು.","poem":1},{"text":"ಇಸ್ಸಾಕಾರನೇ, ನಿನ್ನ ಗುಡಾರಗಳಲ್ಲಿ ಸಂತೋಷಪಡು.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ಅವರು ಜನರನ್ನು ಬೆಟ್ಟಕ್ಕೆ ಕರೆಯಿಸಿ,","poem":1},{"text":"ಅಲ್ಲಿ ನೀತಿಯ ಬಲಿಗಳನ್ನು ಅರ್ಪಿಸುವರು.","poem":2},{"text":"ಏಕೆಂದರೆ ಅವರು ಸಮುದ್ರದಿಂದ ಐಶ್ವರ್ಯವನ್ನು ಹೊಂದಿ","poem":1},{"text":"ಮರಳಿನಲ್ಲಿ ಅಡಗಿರುವ ಸಂಪತ್ತನ್ನು ಪಡೆಯುವರು.”","poem":2}]},{"type":"verse","number":20,"content":["ಮೋಶೆಯು ಗಾದನ ವಿಷಯವಾಗಿ ಹೇಳಿದ್ದೇನೆಂದರೆ:",{"text":"“ಗಾದನ ರಾಜ್ಯವನ್ನು ವಿಸ್ತಾರ ಮಾಡಿದ ದೇವರು ಸ್ತುತಿಹೊಂದಲಿ.","poem":1},{"text":"ಅವನು ಸಿಂಹದಂತೆ ಜೀವಿಸಿ ತೋಳನ್ನೂ","poem":2},{"lineBreak":true},{"text":"ಶಿರಸ್ಸನ್ನೂ ಮುರಿಯುವನು.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ಅವನು ಉತ್ತಮವಾದ ನಾಡನ್ನು ತನಗಾಗಿ ಆಯ್ದುಕೊಂಡನು.","poem":1},{"text":"ನಾಯಕರ ಪಾಲು ಅವನಿಗಾಗಿ ದೊರಕಿತು.","poem":2},{"text":"ಅವನು ಜನರ ಮುಖ್ಯಸ್ಥರ ಸಂಗಡ ಬಂದು,","poem":1},{"text":"ಇಸ್ರಾಯೇಲರೊಡನೆ ಯೆಹೋವ ದೇವರ ನೀತಿಯನ್ನೂ","poem":2},{"lineBreak":true},{"text":"ದೇವರ ನ್ಯಾಯಗಳನ್ನೂ ಸ್ಥಾಪಿಸಿದನು.”","poem":2}]},{"type":"verse","number":22,"content":["ಮೋಶೆಯು ದಾನನ ವಿಷಯವಾಗಿ ಹೇಳಿದ್ದೇನೆಂದರೆ:",{"text":"“ದಾನನು ಬಾಷಾನಿನಿಂದ ಹಾರಿಬರುವ,","poem":1},{"text":"ಪ್ರಾಯದ ಸಿಂಹದಂತಿದ್ದಾನೆ.”","poem":2}]},{"type":"verse","number":23,"content":["ಮೋಶೆಯು ನಫ್ತಾಲಿಯ ವಿಷಯವಾಗಿ ಹೇಳಿದ್ದೇನೆಂದರೆ:",{"text":"“ನಫ್ತಾಲಿಯೇ, ಯೆಹೋವ ದೇವರ ಅನುಗ್ರಹದಿಂದ ತೃಪ್ತನಾದವನೇ,","poem":1},{"text":"ದೇವರ ಆಶೀರ್ವಾದದಿಂದ ತುಂಬಿದವನೇ;","poem":2},{"lineBreak":true},{"text":"ಸಮುದ್ರವೂ ದಕ್ಷಿಣ ಪ್ರದೇಶವೂ ನಿನಗೆ ಸೊತ್ತಾಗಲಿ.”","poem":2}]},{"type":"verse","number":24,"content":["ಮೋಶೆ ಆಶೇರನ ವಿಷಯವಾಗಿ ಹೇಳಿದ್ದೇನೆಂದರೆ:",{"text":"“ಪುತ್ರರಲ್ಲಿಯೇ ಶ್ರೇಷ್ಠನಾದ ಆಶೇರನು ಭಾಗ್ಯ ಹೊಂದಲಿ.","poem":1},{"text":"ಅವನ ಸಹೋದರರು ಅವನನ್ನು ಮೆಚ್ಚಿಕೊಳ್ಳಲಿ,","poem":2},{"lineBreak":true},{"text":"ಎಣ್ಣೆಯಲ್ಲಿ ಪಾದಸ್ನಾನ ಮಾಡುವಂತಾಗಲಿ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ನಿನ್ನ ದ್ವಾರಗಳ ಅಗುಳಿಗಳು ಕಬ್ಬಿಣದ ಮತ್ತು ಕಂಚಿನವುಗಳು ಆಗಿರಲಿ.","poem":1},{"text":"ನಿನ್ನ ಜೀವಮಾನಕಾಲವೆಲ್ಲಾ ನಿನಗೆ ಬಲವಿರುವುದು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“ಯೆಶುರೂನನ ದೇವರ ಹಾಗೆ ಯಾರೂ ಇಲ್ಲ.","poem":1},{"text":"ದೇವರು ನಿನ್ನ ಸಹಾಯಕ್ಕೆ ಆಕಾಶವನ್ನೇರಿ","poem":2},{"lineBreak":true},{"text":"ಮೇಘಾರೂಢನಾಗಿ ತಮ್ಮ ಘನತೆಯಲ್ಲಿ ಬರುತ್ತಾರೆ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ನಿತ್ಯ ದೇವರು ನಿನ್ನ ಆಶ್ರಯವು.","poem":1},{"text":"ದೇವರ ಶಾಶ್ವತ ತೋಳುಗಳು ನಿನಗೆ ಆಶ್ರಯ.","poem":2},{"text":"ನಿನ್ನ ವೈರಿಗಳನ್ನು ನಿನ್ನ ಮುಂದೆ ಓಡಿಸಿ,","poem":1},{"text":"‘ಅವರನ್ನು ಸಂಹರಿಸಿರಿ,’ ಎಂದು ಆಜ್ಞಾಪಿಸುವರು.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ಆದಕಾರಣ ಆಕಾಶದಿಂದ ಮಂಜನ್ನು ಸುರಿಯುವ,","poem":1},{"text":"ಧಾನ್ಯ, ಹೊಸ ದ್ರಾಕ್ಷಾರಸ ಸಮೃದ್ಧಿಯಾಗಿರುವ ನಾಡಿನಲ್ಲಿ,","poem":2},{"text":"ಯಾಕೋಬನ ವಂಶದವರು ಸುರಕ್ಷಿತರಾದರು.","poem":1},{"text":"ಇಸ್ರಾಯೇಲರು ನಿರ್ಭಯವಾಗಿ ವಾಸಿಸುವವರಾದರು.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ಇಸ್ರಾಯೇಲರೇ, ನೀವು ಎಷ್ಟೋ ಧನ್ಯರು.","poem":1},{"text":"ಯೆಹೋವ ದೇವರಿಂದ ರಕ್ಷಣೆಹೊಂದಿದ ಜನಾಂಗವೇ","poem":2},{"lineBreak":true},{"text":"ನಿಮ್ಮಂತೆ ಯಾರಿದ್ದಾರೆ?","poem":2},{"text":"ದೇವರೇ ನಿಮಗೆ ಗುರಾಣಿ ಹಾಗೂ ಸಹಾಯಕ.","poem":1},{"text":"ದೇವರು ನಿಮ್ಮ ಮಹಿಮಾ ಖಡ್ಗ.","poem":2},{"text":"ನಿಮ್ಮ ವೈರಿಗಳು ನಿಮ್ಮ ಮುಂದೆ ಮುದುರಿಕೊಳ್ಳುವರು","poem":1},{"text":"ಮತ್ತು ಅವರ ಉನ್ನತ ಸ್ಥಳಗಳನ್ನು ನೀವು ತುಳಿದುಬಿಡುವಿರಿ.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kan_okcv/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}