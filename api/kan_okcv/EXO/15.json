{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"EXO","translationId":"kan_okcv","name":"ವಿಮೋಚನಕಾಂಡ","commonName":"ವಿಮೋಚನಕಾಂಡ","title":"ವಿಮೋಚನಕಾಂಡ","order":2,"numberOfChapters":40,"sha256":"43d4cd09d7889b540d7a9239a2895f2ea65b5a79437ac45a9ac9c4d5632ef8f0","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/kan_okcv/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":15,"content":[{"type":"heading","content":["ಮೋಶೆ ಮತ್ತು ಮಿರ್ಯಾಮಳು ಹಾಡಿದ ಗೀತೆ"]},{"type":"verse","number":1,"content":["ಆಗ ಮೋಶೆ ಮತ್ತು ಇಸ್ರಾಯೇಲರು ಯೆಹೋವ ದೇವರಿಗೆ ಈ ಹಾಡನ್ನು ಹಾಡಿದರು:",{"text":"“ನಾನು ಯೆಹೋವ ದೇವರಿಗೆ ಹಾಡುತ್ತೇನೆ.","poem":1},{"text":"ಏಕೆಂದರೆ ಅವರು ಪ್ರಭಾವದಿಂದ ಜಯಶಾಲಿಯಾದರು.","poem":2},{"lineBreak":true},{"text":"ಕುದುರೆಗಳನ್ನೂ ರಾಹುತರನ್ನೂ ಸಮುದ್ರದಲ್ಲಿ ದಬ್ಬಿದ್ದಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“ಯೆಹೋವ ದೇವರು ನನ್ನ ಬಲವೂ ಕೀರ್ತನೆಯೂ ಆಗಿದ್ದಾರೆ;","poem":1},{"text":"ಅವರು ನನ್ನ ರಕ್ಷಣೆಯಾದರು;","poem":2},{"text":"ಅವರು ನನ್ನ ದೇವರು, ಅವರನ್ನು ಕೊಂಡಾಡುವೆನು;","poem":1},{"text":"ಅವರು ನನ್ನ ತಂದೆಯ ದೇವರು, ನಾನು ಅವರನ್ನು ಘನಪಡಿಸುವೆನು.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ಯೆಹೋವ ದೇವರು ಯುದ್ಧವೀರರು;","poem":1},{"text":"ಯೆಹೋವ ದೇವರು ಎಂಬುದೇ ಅವರ ಹೆಸರು.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ಅವರು ಫರೋಹನ ರಥಗಳನ್ನೂ,","poem":1},{"text":"ಅವನ ಸ್ಯೆನ್ಯವನ್ನೂ ಸಮುದ್ರದಲ್ಲಿ ಅಲ್ಲಾಡಿಸಿ ಎಸೆದಿದ್ದಾರೆ.","poem":2},{"text":"ಫರೋಹನ ಅತ್ಯುತ್ತಮ ಅಧಿಕಾರಿಗಳು ಸಹ","poem":1},{"text":"ಕೆಂಪು ಸಮುದ್ರದಲ್ಲಿ ಮುಳುಗಿ ಹೋದರು.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ಆಳವಾದ ಜಲರಾಶಿ ಅವರನ್ನು ಮುಚ್ಚಿಕೊಂಡವು.","poem":1},{"text":"ಅವರು ಕಲ್ಲಿನಂತೆ ಸಮುದ್ರದ ತಳಕ್ಕೆ ಮುಳುಗಿದರು.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಬಲಗೈ","poem":1},{"text":"ಶಕ್ತಿಯಲ್ಲಿ ಮಹಿಮೆಯುಳ್ಳದ್ದಾಗಿದೆ;","poem":2},{"text":"ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಬಲಗೈ","poem":1},{"text":"ಶತ್ರುವನ್ನು ಜಜ್ಜಿ ಪುಡಿ ಮಾಡಿತು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“ನಿಮ್ಮ ಮಹತ್ತಾದ ಘನತೆಯಲ್ಲಿ","poem":1},{"text":"ನಿಮಗೆ ವಿರೋಧವಾಗಿ ಎದ್ದವರನ್ನು ಕೆಡವಿಬಿಟ್ಟಿರುವಿರಿ.","poem":2},{"text":"ನಿಮ್ಮ ಕೋಪವು ಬೆಂಕಿಯಂತೆ ಕಾರಿದೆ;","poem":1},{"text":"ಅದು ಅವರನ್ನು ಕೋಲಿನಂತೆ ದಹಿಸಿತು.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ನೀವು ಬೀಸಿದ ಬಿರುಸಾದ ಗಾಳಿಯಿಂದ","poem":1},{"text":"ನೀರು ಒಟ್ಟುಗೂಡಿದವು.","poem":2},{"text":"ಪ್ರವಾಹಗಳು ರಾಶಿಯಂತೆ ನಿಂತವು.","poem":1},{"text":"ಜಲರಾಶಿಗಳು ಸಮುದ್ರದ ಮಧ್ಯದಲ್ಲಿ ಗಟ್ಟಿಯಾದವು.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ಶತ್ರುವು ಹೆಮ್ಮೆಯಿಂದ ಹೀಗೆ ಮಾತನಾಡಿಕೊಳ್ಳುತ್ತಿದ್ದರು,","poem":1},{"text":"‘ನಾನು ಹಿಂದಟ್ಟುವೆನು, ಅವರನ್ನು ಹಿಡಿಯುವೆನು,","poem":2},{"text":"ನಾನು ಅವರ ಕೊಳ್ಳೆಯನ್ನು ಹಂಚುವೆನು;","poem":1},{"text":"ನನ್ನ ಆಶೆಗಳು ಅವರಿಂದ ತೃಪ್ತಿ ಹೊಂದುವುವು;","poem":2},{"text":"ನಾನು ನನ್ನ ಖಡ್ಗವನ್ನು ಹಿರಿಯುವೆನು;","poem":1},{"text":"ನನ್ನ ಕೈ ಅವರನ್ನು ಸಂಹಾರ ಮಾಡುವುದು.’","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ನೀವು ನಿಮ್ಮ ಶ್ವಾಸ ಊದಿದಾಗ","poem":1},{"text":"ಸಮುದ್ರವು ಅವರನ್ನು ನುಂಗಿಕೊಂಡಿತು.","poem":2},{"text":"ಅವರು ಸೀಸದಂತೆ","poem":1},{"text":"ಮಹಾಸಾಗರದಲ್ಲಿ ಮುಳುಗಿ ಹೋದರು.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ಯೆಹೋವ ದೇವರೇ,","poem":1},{"text":"ನಿಮ್ಮ ಹಾಗೆ ಯಾರಿದ್ದಾರೆ?","poem":2},{"text":"ಪರಿಶುದ್ಧತ್ವದಲ್ಲಿ ವೈಭವ ಹೊಂದಿದವರೂ,","poem":1},{"text":"ಮಹಿಮೆಯಲ್ಲಿ ಅತಿಶಯರೂ,","poem":2},{"text":"ಅದ್ಭುತಗಳನ್ನು ಮಾಡುವವರೂ ಆದ","poem":1},{"text":"ನಿಮ್ಮ ಹಾಗೆ ಯಾರಿದ್ದಾರೆ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“ನೀವು ನಿಮ್ಮ ಬಲಗೈಯನ್ನು ಚಾಚಲು","poem":1},{"text":"ಭೂಮಿಯು ಅವರನ್ನು ನುಂಗಿತು.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ನೀವು ವಿಮೋಚಿಸಿದ ಜನರನ್ನು","poem":1},{"text":"ನೀವು ನಿಮ್ಮ ಪ್ರೀತಿಯಿಂದ ನಡೆಸಿದ್ದೀರಿ.","poem":2},{"text":"ನೀವು ಅವರನ್ನು ನಿಮ್ಮ ಬಲದಿಂದ","poem":1},{"text":"ನಿಮ್ಮ ಪರಿಶುದ್ಧ ನಿವಾಸಕ್ಕೆ ನಡೆಸಿದ್ದೀರಿ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ಜನರು ಇದನ್ನು ಕೇಳಿದಾಗ ಭಯಪಡುವರು.","poem":1},{"text":"ದುಃಖವು ಫಿಲಿಷ್ಟಿಯದಲ್ಲಿ ವಾಸಿಸುವವರನ್ನು ಹಿಡಿಯುವುದು.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ಆಗ ಎದೋಮಿನ ಪ್ರಭುಗಳು ದಿಗ್ಭ್ರಮೆಗೊಳ್ಳುವರು;","poem":1},{"text":"ಕಂಪನವು ಮೋವಾಬಿನ ಬಲಿಷ್ಠರನ್ನು ಹಿಡಿಯುವುದು;","poem":2},{"text":"ಕಾನಾನಿನ ನಿವಾಸಿಗಳೆಲ್ಲಾ","poem":1},{"noteId":4},{"text":"ಕರಗಿ ಹೋಗುವರು.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"ಭಯವೂ ಹೆದರಿಕೆಯೂ ಅವರಿಗಾಗುವುದು;","poem":2},{"text":"ನಿಮ್ಮ ಜನರು ದಾಟಿ ಹೋಗುವವರೆಗೆ ಯೆಹೋವ ದೇವರೇ,","poem":1},{"text":"ನೀವು ಕೊಂಡುಕೊಂಡ","poem":2},{"noteId":5},{"text":"ಜನರು ದಾಟಿಹೋಗುವವರೆಗೆ","poem":2},{"text":"ನಿಮ್ಮ ಬಾಹುವಿನ ದೊಡ್ಡಸ್ತಿಕೆಯಿಂದ","poem":1},{"text":"ಅವರು ಕಲ್ಲಿನಂತೆ ಸ್ತಬ್ಧರಾಗಿರುವರು.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ಅವರನ್ನು ಒಳಗೆ ಬರಮಾಡಿ, ಯೆಹೋವ ದೇವರೇ,","poem":1},{"text":"ನಿಮ್ಮ ಕೈಗಳು ಸ್ಥಾಪಿಸಿದ ಪರಿಶುದ್ಧ ನಿವಾಸದಲ್ಲಿಯೂ","poem":2},{"text":"ಯೆಹೋವ ದೇವರೇ, ನೀವು ವಾಸಿಸುವುದಕ್ಕೆ ಮಾಡಿಕೊಂಡಿರುವ","poem":1},{"text":"ನಿಮ್ಮ ಸ್ವತ್ತಾಗಿರುವ ಪರ್ವತದಲ್ಲಿಯೂ ಅವರನ್ನು ಸ್ಥಾಪಿಸುವಿರಿ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“ಯೆಹೋವ ದೇವರು","poem":1},{"text":"ಯುಗಯುಗಾಂತರಗಳವರೆಗೆ ಆಳುವರು.”","poem":2}]},{"type":"verse","number":19,"content":["ಫರೋಹನ ಕುದುರೆಗಳು ಅವನ ರಥಗಳ ಮತ್ತು ಸವಾರರ ಸಂಗಡ ಸಮುದ್ರದೊಳಗೆ ಬಂದಾಗ, ಯೆಹೋವ ದೇವರು ಸಮುದ್ರದ ನೀರನ್ನು ಅವರ ಮೇಲೆ ತಿರುಗಿ ಬರಮಾಡಿದರು. ಆದರೆ ಇಸ್ರಾಯೇಲರು ಸಮುದ್ರದ ಮಧ್ಯದಲ್ಲಿನ ಒಣನೆಲದ ಮೇಲೆ ದಾಟಿಹೋದರು."]},{"type":"verse","number":20,"content":["ಆಗ ಪ್ರವಾದಿನಿಯಾಗಿದ್ದ ಆರೋನನ ಸಹೋದರಿ ಮಿರ್ಯಾಮಳು ಕೈಯಲ್ಲಿ ತಾಳವನ್ನು ತೆಗೆದುಕೊಂಡಳು. ಸ್ತ್ರೀಯರೆಲ್ಲರೂ ತಾಳಗಳನ್ನು ಹಿಡಿದುಕೊಂಡು ನಾಟ್ಯವಾಡುತ್ತಾ, ಆಕೆಯನ್ನು ಹಿಂಬಾಲಿಸಿ ಹೊರಹೊರಟರು."]},{"type":"verse","number":21,"content":["ಮಿರ್ಯಾಮಳು ಅವರಿಗೆ ಹೀಗೆ ಹಾಡಿದಳು:",{"text":"“ಯೆಹೋವ ದೇವರಿಗೆ ನೀವು ಹಾಡಿರಿ,","poem":1},{"text":"ಅವರು ಮಹೋನ್ನತದಲ್ಲಿದ್ದಾರೆ;","poem":2},{"text":"ಕುದುರೆಯನ್ನೂ ಸವಾರರನ್ನೂ","poem":1},{"text":"ಸಮುದ್ರದಲ್ಲಿ ಮುಣುಗಿಸಿಬಿಟ್ಟರು.”","poem":2}]},{"type":"heading","content":["ಕಹಿ ನೀರು ಸಿಹಿಯಾದದ್ದು"]},{"type":"verse","number":22,"content":["ಆಮೇಲೆ ಮೋಶೆಯು ಇಸ್ರಾಯೇಲರನ್ನು ಕೆಂಪು ಸಮುದ್ರದಿಂದ ನಡೆಸಿದನು. ಅವರು ಶೂರಿನ ಮರುಭೂಮಿಯೊಳಗೆ ಹೋದರು. ಅವರು ಮರುಭೂಮಿಯಲ್ಲಿ ಮೂರು ದಿನಗಳು ಪ್ರಯಾಣಮಾಡಿದರೂ ನೀರನ್ನು ಕಂಡುಕೊಳ್ಳಲಿಲ್ಲ."]},{"type":"verse","number":23,"content":["ಅವರು ಮಾರಾ ಎಂಬಲ್ಲಿಗೆ ಬಂದ ಮೇಲೆ ಅಲ್ಲಿಯ ನೀರನ್ನು ಕುಡಿಯಲಾರದೆ ಇದ್ದರು; ಅದು ಕಹಿಯಾಗಿತ್ತು. ಆದಕಾರಣ ಅದರ ಹೆಸರು “ಮಾರಾ” ಎಂದು ಕರೆಯಲಾಯಿತು."]},{"type":"verse","number":24,"content":["ಆದ್ದರಿಂದ ಜನರು, “ನಾವು ಏನು ಕುಡಿಯೋಣ?” ಎಂದು ಹೇಳಿ, ಮೋಶೆಗೆ ವಿರೋಧವಾಗಿ ಗೊಣಗುಟ್ಟಿದರು."]},{"type":"verse","number":25,"content":["ಅವನು ಯೆಹೋವ ದೇವರಿಗೆ ಮೊರೆಯಿಟ್ಟನು. ಯೆಹೋವ ದೇವರು ಅವನಿಗೆ ಒಂದು ಗಿಡವನ್ನು ತೋರಿಸಿದರು. ಅವನು ಅದನ್ನು ನೀರಿನಲ್ಲಿ ಹಾಕಿದಾಗ, ನೀರು ಸಿಹಿಯಾಗಿ ಬಿಟ್ಟಿತು. ಅಲ್ಲಿ ದೇವರು ಅವರಿಗಾಗಿ ಒಂದು ನಿಯಮವನ್ನೂ ಒಂದು ಶಾಸನವನ್ನೂ ಮಾಡಿದರು. ಅಲ್ಲಿಯೇ ದೇವರು ಅವರನ್ನು ಪರೀಕ್ಷಿಸಿದರು."]},{"type":"verse","number":26,"content":["ದೇವರು, “ನೀವು ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಮಾತಿಗೆ ಶ್ರದ್ಧೆಯಿಂದ ಕಿವಿಗೊಟ್ಟು, ಅವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಸರಿಯಾದದ್ದನ್ನು ಮಾಡಿ, ಅವರ ಆಜ್ಞೆಗಳಿಗೆ ಕಿವಿಗೊಟ್ಟು, ಅವರ ನಿಯಮಗಳನ್ನು ಕೈಗೊಂಡರೆ, ಈಜಿಪ್ಟಿನ ಮೇಲೆ ಬರಮಾಡಿದ ಯಾವ ವ್ಯಾಧಿಯನ್ನೂ ನಿಮ್ಮ ಮೇಲೆ ಬರಮಾಡುವುದಿಲ್ಲ. ನಿಮ್ಮನ್ನು ಸ್ವಸ್ಥಪಡಿಸುವ ಯೆಹೋವ ದೇವರು ನಾನೇ ಆಗಿದ್ದೇನೆ,” ಎಂದು ಪ್ರಕಟಪಡಿಸಿದರು."]},{"type":"verse","number":27,"content":["ತರುವಾಯ ಇಸ್ರಾಯೇಲರು ಏಲೀಮಿಗೆ ಬಂದರು. ಅಲ್ಲಿ ಹನ್ನೆರಡು ನೀರಿನ ಬಾವಿಗಳೂ ಎಪ್ಪತ್ತು ಖರ್ಜೂರದ ಮರಗಳೂ ಇದ್ದವು. ಅವರು ಆ ನೀರಿನ ಬಳಿಯಲ್ಲಿ ಇಳಿದುಕೊಂಡರು."]}],"footnotes":[{"noteId":4,"caller":"+","text":"ಅಥವಾ ಆಳುವ","reference":{"chapter":15,"verse":15}},{"noteId":5,"caller":"+","text":"ಅಥವಾ ಸೃಷ್ಟಿಸಿದ","reference":{"chapter":15,"verse":16}}]},"thisChapterLink":"/api/kan_okcv/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}