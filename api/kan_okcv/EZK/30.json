{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"EZK","translationId":"kan_okcv","name":"ಯೆಹೆಜ್ಕೇಲನು","commonName":"ಯೆಹೆಜ್ಕೇಲನು","title":"ಯೆಹೆಜ್ಕೇಲನು","order":26,"numberOfChapters":48,"sha256":"cbd35ba0f759d591b87c081aef8b83b51c37b0f2f0c7ef2e6812584afd007cf3","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/kan_okcv/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":30,"content":[{"type":"heading","content":["ಈಜಿಪ್ಟ್ ಬಗ್ಗೆ ಪ್ರಲಾಪನೆ"]},{"type":"verse","number":1,"content":["ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವು ನನಗೆ ಬಂದಿತು,"]},{"type":"verse","number":2,"content":["“ಮನುಷ್ಯಪುತ್ರನೇ, ಪ್ರವಾದಿಸು ಮತ್ತು ಹೇಳು: ‘ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ:",{"text":"“ ‘ “ಅಯ್ಯೋ ಆ ದಿನ!” ಎಂದು,","poem":1},{"text":"ಅಳುತ್ತಾ ಹೇಳಿರಿ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ಏಕೆಂದರೆ ಆ ದಿನವು ಸಮೀಪವಾಯಿತು,","poem":1},{"text":"ಯೆಹೋವ ದೇವರ ದಿನವು,","poem":2},{"text":"ಆ ಕಾರ್ಮುಗಿಲಿನ ದಿನವು ಸಮೀಪವಾಯಿತು.","poem":1},{"text":"ಅದೇ ಜನಾಂಗಗಳಿಗೆ ನ್ಯಾಯತೀರಿಸುವ ಕಾಲವಾಗಿರುವದು.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ಖಡ್ಗವು ಈಜಿಪ್ಟಿಗೆ ವಿರುದ್ಧವಾಗಿ ಬರುವುದು.","poem":1},{"text":"ಕೂಷ್ ಪಟ್ಟಣವು ಸಂಕಟಪಡುವುದು.","poem":2},{"text":"ಈಜಿಪ್ಟಿನಲ್ಲಿ ಕೊಲ್ಲಲಾದವರು ಬಿದ್ದಾಗ,","poem":1},{"text":"ಅವಳ ಸಂಪತ್ತು ಸೂರೆಯಾಗುವುದು.","poem":2},{"lineBreak":true},{"text":"ಅವಳ ಅಡಿಪಾಯಗಳು ಕಿತ್ತುಹೋಗುವವು.","poem":2}]},{"type":"verse","number":5,"content":["ಕೂಷ್ಯರು, ಪೂಟ್ಯರು, ಲೂದ್ಯರು, ಎಲ್ಲಾ ಅರಬ್ಬಿಯರೂ ಕೂಬ್ಯರೂ ಒಡಂಬಡಿಕೆ ಮಾಡಿಕೊಂಡ ಮಿತ್ರ ರಾಜ್ಯದವರೂ ಅವರ ಸಂಗಡ ಖಡ್ಗದಿಂದ ಹತರಾಗುವರು."]},{"type":"verse","number":6,"content":["“ ‘ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ:",{"text":"“ ‘ಈಜಿಪ್ಟಿನ ಸಹಾಯಕರು ಬೀಳುವರು.","poem":1},{"text":"ಅದರ ಶಕ್ತಿಯ ಮದವು ಇಳಿದುಹೋಗುವುದು.","poem":2},{"text":"ಅಲ್ಲಿಯ ಜನರು ಮಿಗ್ದೋಲಿನಿಂದ ಸೆವೇನೆಯ ಗೋಪುರದವರೆಗೆ","poem":1},{"text":"ಖಡ್ಗದಿಂದ ಹತರಾಗುವರು","poem":2},{"lineBreak":true},{"text":"ಎಂದು ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ಆಗ ಅವರು ಹಾಳಾಗಿರುವ ದೇಶಗಳೊಳಗೆ","poem":1},{"text":"ತಾವೂ ಹಾಳಾಗುವರು.","poem":2},{"text":"ಹಾಳಾದ ಪಟ್ಟಣಗಳ ಮಧ್ಯದಲ್ಲಿ","poem":1},{"text":"ಅದರ ಪಟ್ಟಣಗಳು ಹಾಳಾಗಿ ಇರುವುವು.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ನಾನು ಈಜಿಪ್ಟಿನಲ್ಲಿ ಬೆಂಕಿಯಿಟ್ಟ ಮೇಲೆ","poem":1},{"text":"ಅದಕ್ಕೆ ಸಹಾಯ ಮಾಡುವವರೆಲ್ಲರೂ ನಾಶವಾದ ಮೇಲೆ","poem":2},{"lineBreak":true},{"text":"ಅವರಿಗೆ ನಾನೇ ಯೆಹೋವ ದೇವರೆಂದು ತಿಳಿಯುವುದು.","poem":2}]},{"type":"verse","number":9,"content":["“ ‘ಆ ದಿನದಲ್ಲಿ ದೂತರು ನನ್ನ ಸನ್ನಿಧಾನದಿಂದ ಹೊರಟು ಹಡಗುಗಳಲ್ಲಿ ಪ್ರಯಾಣಮಾಡಿ ನಿಶ್ಚಿಂತರಾದ ಕೂಷ್ಯರನ್ನು ಹೆದರಿಸುವರು. ಈಜಿಪ್ಟಿನ ದಿನದಲ್ಲಿ ಆದ ಹಾಗೆ ಅವರ ಮೇಲೆ ದೊಡ್ಡ ದುಃಖ ಉಂಟಾಗುವುದು, ಏಕೆಂದರೆ ಇಗೋ, ಆ ದಿನ ಬರುವುದು ನಿಶ್ಚಯ."]},{"type":"line_break"},{"type":"verse","number":10,"content":["“ ‘ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ :",{"text":"“ ‘ನಾನು ಬಾಬಿಲೋನಿನ ಅರಸನಾದ ನೆಬೂಕದ್ನೆಚ್ಚರನ ಕೈಯಿಂದ","poem":1},{"text":"ಈಜಿಪ್ಟಿನ ಜನಸಮೂಹವನ್ನು ಕೊನೆಗಾಣಿಸುವೆನು.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ಆ ದೇಶವನ್ನು ನಾಶಪಡಿಸುವುದಕ್ಕೆ ಅವನನ್ನು","poem":1},{"text":"ಅತಿಭಯಂಕರ ಜನಾಂಗದವರಾದ ಅವನ ಸೈನಿಕರೊಡನೆ ಬರಮಾಡುವೆನು.","poem":2},{"text":"ಅವರು ಈಜಿಪ್ಟಿಗೆ ವಿರೋಧವಾಗಿ ಖಡ್ಗ ಹಿರಿದು","poem":1},{"text":"ದೇಶವನ್ನು ಹತರಾದವರಿಂದ ತುಂಬಿಸುವರು.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ಇದಲ್ಲದೆ ನಾನು ನದಿಗಳನ್ನು ಒಣಗಿಸಿ","poem":1},{"text":"ದೇಶವನ್ನು ದುಷ್ಟರ ಕೈಗೆ ಮಾರಿಬಿಡುವೆನು.","poem":2},{"text":"ದೇಶವನ್ನೂ ಅದರಲ್ಲಿನ ಸಮಸ್ತವನ್ನೂ","poem":1},{"text":"ವಿದೇಶಿಯರ ಕೈಯಿಂದ ನಾಶಮಾಡಿಸುವೆನು.","poem":2},"ಯೆಹೋವ ದೇವರಾದ ನಾನೇ ಇದನ್ನು ನುಡಿದಿದ್ದೇನೆ."]},{"type":"line_break"},{"type":"verse","number":13,"content":["“ ‘ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ:",{"text":"“ ‘ನಾನು ಮೂರ್ತಿಗಳನ್ನು ನಾಶಮಾಡುವೆನು.","poem":1},{"text":"ಮತ್ತು ನೋಫಿನ","poem":2},{"noteId":4},{"text":"ವಿಗ್ರಹಗಳನ್ನು ಕೊನೆಗೊಳಿಸುವೆನು.","poem":2},{"text":"ಈಜಿಪ್ಟ್ ದೇಶದ ರಾಜಕುಮಾರ ಇನ್ನು ಮುಂದೆ ಇರುವುದಿಲ್ಲ,","poem":1},{"text":"ನಾನು ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿ ಭಯವನ್ನು ಉಂಟುಮಾಡುವೆನು.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ನಾನು ಪತ್ರೋಸನ್ನು","poem":1},{"noteId":5},{"text":"ನಾಶಮಾಡಿ,","poem":1},{"text":"ಚೋವನ್ ಪಟ್ಟಣಕ್ಕೆ ಬೆಂಕಿಯಿಡುವೆನು.","poem":2},{"lineBreak":true},{"text":"ತೆಬೆಸ್ ಪಟ್ಟಣವನ್ನು ದಂಡಿಸುವೆನು.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ಈಜಿಪ್ಟಿಗೆ ರಕ್ಷಣೆಯ ಕೋಟೆಯಾದ","poem":1},{"text":"ಪೆಲೂಸಿಯಮ್ ಪಟ್ಟಣದ ಮೇಲೆ ನನ್ನ ರೋಷಾಗ್ನಿಯನ್ನು ಸುರಿಸಿ,","poem":2},{"lineBreak":true},{"text":"ತೆಬೆಸಿನ ನಿವಾಸಿಗಳನ್ನೆಲ್ಲಾ ಕಡಿದುಬಿಡುವೆನು.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ನಾನು ಈಜಿಪ್ಟಿಗೆ ಕಿಚ್ಚನ್ನು ಹಚ್ಚಿಸಲು","poem":1},{"text":"ಪೆಲೂಸಿಯಮ್ ಪ್ರಾಣಸಂಕಟ ಪಡುವುದು.","poem":2},{"text":"ತೆಬೆಸವು ಬಿರುಗಾಳಿಯಿಂದ ತೆಗೆದುಕೊಳ್ಳಲಾಗುವುದು,","poem":1},{"text":"ನೋಫಿನ ಮೇಲೆ ನಿರಂತರವಾಗಿ ಇಕ್ಕಟ್ಟು ಇರುವುದು.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ಓನಿನ","poem":1},{"noteId":6},{"text":"ಮತ್ತು ಪಿಬೇಸೆತಿನ ಯೌವನಸ್ಥರು","poem":1},{"text":"ಖಡ್ಗದಿಂದ ಸಾಯುವರು.","poem":2},{"lineBreak":true},{"text":"ಈ ಪಟ್ಟಣಗಳ ನಿವಾಸಿಗಳು ತಾವಾಗಿಯೇ ಸೆರೆಯಾಗಿ ಹೋಗುವುವು.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ನಾನು ಈಜಿಪ್ಟಿನ ನೊಗಗಳನ್ನು ಮುರಿಯುವಾಗ","poem":1},{"text":"ತಹಪನೇಸಿನಲ್ಲಿ ಹಗಲು ಕತ್ತಲಾಗುವುದು.","poem":2},{"lineBreak":true},{"text":"ಅದರ ಶಕ್ತಿಯ ಮದವು ಅಡಗಿಹೋಗುವುದು.","poem":2},{"text":"ಅದನ್ನು ಮೇಘವು ಮುಚ್ಚುವುದು.","poem":1},{"text":"ಅದರ ಪುತ್ರಿಯರು ಸೆರೆಗೆ ಹೋಗುವರು.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ಹೀಗೆ ನಾನು ಈಜಿಪ್ಟನ್ನು ದಂಡಿಸುವೆನು.","poem":1},{"text":"ಆಗ ನಾನೇ ಯೆಹೋವ ದೇವರೆಂದು ಅವರಿಗೆ ತಿಳಿಯುವುದು.’ ”","poem":2}]},{"type":"heading","content":["ಫರೋಹನ ತೋಳುಗಳು ಮುರಿದದ್ದು"]},{"type":"verse","number":20,"content":["ಇದಲ್ಲದೆ ಹನ್ನೊಂದನೆಯ ವರ್ಷದ ಮೊದಲನೆಯ ತಿಂಗಳಿನ, ಏಳನೆಯ ದಿನದಲ್ಲಿ, ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವು ನನಗೆ ಬಂದು ಹೇಳಿದ್ದೇನೆಂದರೆ,"]},{"type":"verse","number":21,"content":["“ಮನುಷ್ಯಪುತ್ರನೇ, ನಾನು ಈಜಿಪ್ಟಿನ ಅರಸನಾದ ಫರೋಹನ ತೋಳನ್ನು ಮುರಿದು ಹಾಕಿದ್ದೇನೆ. ಇಗೋ, ಆ ದೇಶವನ್ನು ಯಾರೂ ಕಟ್ಟಲಿಲ್ಲ, ಔಷಧ ಹಚ್ಚಲಿಲ್ಲ. ಅದು ಖಡ್ಗ ಹಿಡಿಯುವಷ್ಟು ಬಲಗೊಳ್ಳುವಂತೆ ಯಾರೂ ಬಟ್ಟೆ ಸುತ್ತಿ ಅದನ್ನು ಬಿಗಿಸಲಿಲ್ಲ."]},{"type":"verse","number":22,"content":["ಆದ್ದರಿಂದ ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ. ಇಗೋ, ನಾನು ಈಜಿಪ್ಟ್ ದೇಶದ ಅರಸನಾದ ಫರೋಹನಿಗೆ ವಿರುದ್ಧವಾಗಿದ್ದೇನೆ. ಬಲವುಳ್ಳದ್ದೂ ಮುರಿದದ್ದೂ ಆಗಿರುವ ಅವನ ತೋಳುಗಳನ್ನು ಮುರಿಯುತ್ತೇನೆ. ಅವನ ಕೈಯಿಂದ ಖಡ್ಗವನ್ನು ಬೀಳಿಸುತ್ತೇನೆ."]},{"type":"verse","number":23,"content":["ಈಜಿಪ್ಟಿನವರನ್ನು ಜನಾಂಗಗಳಲ್ಲಿ ಚದರಿಸಿ ದೇಶಗಳ ಮೇಲೆ ಹರಡುವೆನು."]},{"type":"verse","number":24,"content":["ಬಾಬಿಲೋನಿನ ಅರಸನ ತೋಳುಗಳನ್ನು ನಾನು ಬಲಪಡಿಸುವೆನು, ಅವನ ಕೈಯಲ್ಲಿ ನನ್ನ ಖಡ್ಗವನ್ನಿಡುವೆನು. ಫರೋಹನ ತೋಳುಗಳು ಬಿದ್ದು ಹೋಗುವುವು. ಇವನು ಅವನ ಮುಂದೆ ಗಾಯ ಹೊಂದಿದವನಂತೆ ನರಳಾಡುವನು."]},{"type":"verse","number":25,"content":["ನಾನು ಬಾಬಿಲೋನಿನ ಅರಸನ ಕೈಗಳನ್ನು ಬಲಪಡಿಸುತ್ತೇನೆ, ಆದರೆ ಫರೋಹನ ಕೈಗಳು ಬಲಹೀನವಾಗುವುವು. ನಾನು ನನ್ನ ಖಡ್ಗವನ್ನು ಬಾಬಿಲೋನಿನ ಅರಸನ ಕೈಗೆ ಕೊಡುವೆನು. ಅವನು ಅದನ್ನು ಈಜಿಪ್ಟಿನ ವಿರೋಧವಾಗಿ ಪ್ರಯೋಗಿಸುವನು. ಆಗ ಅವರು ನಾನೇ ಯೆಹೋವ ದೇವರು ಎಂದು ತಿಳಿದುಕೊಳ್ಳುವರು."]},{"type":"verse","number":26,"content":["ನಾನು ಈಜಿಪ್ಟಿನವರನ್ನು ಜನಾಂಗಗಳೊಗೆ ಚದುರಿಸಿ ದೇಶಗಳಲ್ಲಿ ಹರಡಿಸುತ್ತೇನೆ; ಆಗ ನಾನೇ ಯೆಹೋವ ದೇವರೆಂದು ಅವರಿಗೆ ತಿಳಿಯುವುದು.”"]}],"footnotes":[{"noteId":4,"caller":"+","text":"ನೋಫಿನ ಇನ್ನೊಂದು ಹೆಸರು ಮೆಂಫೀಸ್","reference":{"chapter":30,"verse":13}},{"noteId":5,"caller":"+","text":"ಪತ್ರೋಸ ಅಂದರೆ ದಕ್ಷಿಣ ಈಜಿಪ್ಟ","reference":{"chapter":30,"verse":14}},{"noteId":6,"caller":"+","text":"ಓನಿನ ಕೆಲವು ಪ್ರತಿಗಳಲ್ಲಿ ಅವೆನ ಇನ್ನೊಂದು ಹೆಸರು ಸೂರ್ಯನಗರ","reference":{"chapter":30,"verse":17}}]},"thisChapterLink":"/api/kan_okcv/EZK/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/EZK/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/EZK/29.json","previousChapterAudioLinks":{},"numberOfVerses":26}