{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"EZR","translationId":"kan_okcv","name":"ಎಜ್ರ","commonName":"ಎಜ್ರ","title":"ಎಜ್ರ","order":15,"numberOfChapters":10,"sha256":"46a13e31f238003d1124ea52877fc0c89f326ffecc8ed9da5ce2f71c7269e867","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/EZR/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/kan_okcv/EZR/10.json","totalNumberOfVerses":280},"chapter":{"number":2,"content":[{"type":"heading","content":["ಸೆರೆಯಿಂದ ತಿರುಗಿ ಬಂದವರ ಸಂಖ್ಯೆ"]},{"type":"verse","number":1,"content":["ಬಾಬಿಲೋನಿನ ಅರಸನಾದ ನೆಬೂಕದ್ನೆಚ್ಚರನಿಂದ, ಬಾಬಿಲೋನಿಗೆ ಸೆರೆಯಾಗಿ ಹೋಗಿ, ಅನಂತರ ಬಂಧನದಿಂದ ಬಿಡುಗಡೆಯಾಗಿ ಯೆರೂಸಲೇಮಿಗೂ, ಯೆಹೂದಕ್ಕೂ, ತಮ್ಮ ತಮ್ಮ ಪಟ್ಟಣಗಳಿಗೂ"]},{"type":"verse","number":2,"content":["ಜೆರುಬ್ಬಾಬೆಲನ ಸಂಗಡ ಹಿಂದಿರುಗಿದವರು ಯಾರೆಂದರೆ: ಯೇಷೂವ, ನೆಹೆಮೀಯ, ಸೆರಾಯ, ರೆಲಾಯ, ಮೊರ್ದೆಕೈ, ಬಿಲ್ಷಾನ್, ಮಿಸ್ಪಾರ್, ಬಿಗ್ವೈ, ರೆಹೂಮ್ ಹಾಗೂ ಬಾಣ.",{"lineBreak":true},"ಇಸ್ರಾಯೇಲ್ ಜನಾಂಗದ ಪುರುಷರ ಸಂಖ್ಯೆ:"]},{"type":"verse","number":3,"content":["ಪರೋಷನ ವಂಶಜರು 2,172"]},{"type":"verse","number":4,"content":["ಶೆಫಟ್ಯನ ವಂಶಜರು 372"]},{"type":"verse","number":5,"content":["ಆರಹನ ವಂಶಜರು 775"]},{"type":"verse","number":6,"content":["ಯೇಷೂವ, ಯೋವಾಬ್ ಎಂಬವರ ಮಕ್ಕಳಲ್ಲಿ ಪಹತ್ ಮೋವಾಬನ ವಂಶಜರು 2,812"]},{"type":"verse","number":7,"content":["ಏಲಾಮನ ವಂಶಜರು 1,254"]},{"type":"verse","number":8,"content":["ಜತ್ತೂವಿನ ವಂಶಜರು 945"]},{"type":"verse","number":9,"content":["ಜಕ್ಕೈನ ವಂಶಜರು 760"]},{"type":"verse","number":10,"content":["ಬಾನೀಯ ವಂಶಜರು 642"]},{"type":"verse","number":11,"content":["ಬೇಬೈನ ವಂಶಜರು 623"]},{"type":"verse","number":12,"content":["ಅಜ್ಗಾದನ ವಂಶಜರು 1,222"]},{"type":"verse","number":13,"content":["ಅದೋನೀಕಾಮಿನ ವಂಶಜರು 666"]},{"type":"verse","number":14,"content":["ಬಿಗ್ವೈ ವಂಶಜರು 2,056"]},{"type":"verse","number":15,"content":["ಅದೀನನ ವಂಶಜರು 454"]},{"type":"verse","number":16,"content":["ಹಿಜ್ಕೀಯನ ಮಗನಾದ ಆಟೇರ್ ವಂಶಜರು 98"]},{"type":"verse","number":17,"content":["ಬೇಚೈಯ ವಂಶಜರು 323"]},{"type":"verse","number":18,"content":["ಯೋರನ ವಂಶಜರು 112"]},{"type":"verse","number":19,"content":["ಹಾಷುಮನ ವಂಶಜರು 223"]},{"type":"verse","number":20,"content":["ಗಿಬ್ಬಾರನ ವಂಶಜರು 95"]},{"type":"verse","number":21,"content":["ಬೇತ್ಲೆಹೇಮನ ವಂಶಜರು 123"]},{"type":"verse","number":22,"content":["ನೆಟೋಫದ ಜನರು 56"]},{"type":"verse","number":23,"content":["ಅನಾತೋತ್ ಊರಿನವರು 128"]},{"type":"verse","number":24,"content":["ಅಜ್ಮಾವೆತಿನವರು 42"]},{"type":"verse","number":25,"content":["ಕಿರ್ಯತ್ ಯಾರೀಮ್, ಕೆಫೀರಾ, ಬೇರೋತ್ ಎಂಬ ಪಟ್ಟಣದವರು 743"]},{"type":"verse","number":26,"content":["ರಾಮಾ ಗೆಬ ಎಂಬ ಪಟ್ಟಣದವರು 621"]},{"type":"verse","number":27,"content":["ಮಿಕ್ಮಾಷದ ಜನರು 122"]},{"type":"verse","number":28,"content":["ಬೇತೇಲ್ ಮತ್ತು ಆಯಿ ಎಂಬ ಪಟ್ಟಣದವರು 223"]},{"type":"verse","number":29,"content":["ನೆಬೋ ಊರಿನವರು 52"]},{"type":"verse","number":30,"content":["ಮಗ್ಬೀಷನ ಜನರು 156"]},{"type":"verse","number":31,"content":["ಮತ್ತೊಬ್ಬ ಏಲಾಮನ ವಂಶಜರು 1,254"]},{"type":"verse","number":32,"content":["ಹಾರಿಮನ ವಂಶಜರು 320"]},{"type":"verse","number":33,"content":["ಲೋದ್, ಹಾದೀದ್, ಓನೋ ಎಂಬ ಊರಿನ ಜನರು 725"]},{"type":"verse","number":34,"content":["ಯೆರಿಕೋವಿನ ವಂಶಜರು 345"]},{"type":"verse","number":35,"content":["ಸೆನಾಹನ ವಂಶಜರು 3,630."]},{"type":"line_break"},{"type":"verse","number":36,"content":["ಯಾಜಕರು: ಯೇಷೂವನ ಕುಟುಂಬದವರಾದ ಯೆದಾಯನ ವಂಶಜರು 973"]},{"type":"verse","number":37,"content":["ಇಮ್ಮೇರನ ವಂಶಜರು 1,052"]},{"type":"verse","number":38,"content":["ಪಷ್ಹೂರನ ವಂಶಜರು 1,247"]},{"type":"verse","number":39,"content":["ಹಾರಿಮನ ವಂಶಜರು 1,017."]},{"type":"line_break"},{"type":"verse","number":40,"content":["ಲೇವಿಯರು: ಹೋದವ್ಯನ ಸಂತತಿಯಾದ ಯೇಷೂವನ, ಕದ್ಮಿಯೇಲನ ವಂಶಜರು 74."]},{"type":"line_break"},{"type":"verse","number":41,"content":["ಹಾಡುಗಾರರು: ಆಸಾಫನ ವಂಶಜರು 128."]},{"type":"line_break"},{"type":"verse","number":42,"content":["ದೇವಾಲಯದ ದ್ವಾರಪಾಲಕರಾದ ಶಲ್ಲೂಮ್, ಆಟೇರ್, ಟಲ್ಮೋನ್, ಅಕ್ಕೂಬ್, ಹಟೀಟ, ಶೋಬೈ ಮುಂತಾದವರ ಮಕ್ಕಳು ಒಟ್ಟು 139."]},{"type":"line_break"},{"type":"verse","number":43,"content":["ದೇವಾಲಯದ ಸೇವಕರು: ಜೀಹ, ಹಸೂಫ, ಟಬ್ಬಾವೋತ್ ಇವರ ವಂಶಜರು."]},{"type":"verse","number":44,"content":["ಕೆರೋಸ್, ಸೀಯಹಾ, ಪದೋನ್,"]},{"type":"verse","number":45,"content":["ಲೆಬಾನ, ಹಗಾಬ, ಅಕ್ಕೂಬ್"]},{"type":"verse","number":46,"content":["ಹಗಾಬ್, ಶಲ್ಮೈ, ಹಾನಾನ್,"]},{"type":"verse","number":47,"content":["ಗಿದ್ದೇಲ್, ಗಹರ್, ರೆವಾಯ,"]},{"type":"verse","number":48,"content":["ರೆಚೀನ್, ನೆಕೋದ, ಗಜ್ಜಾಮ್,"]},{"type":"verse","number":49,"content":["ಉಜ್ಜ, ಪಾಸೇಹ, ಬೇಸೈ,"]},{"type":"verse","number":50,"content":["ಅಸ್ನ, ಮೆಯನೀಮ್, ನೆಫೀಸೀಮ್,"]},{"type":"verse","number":51,"content":["ಬಕ್ಬೂಕ್, ಹಕ್ಕೂಫ, ಹರ್ಹೂರ್,"]},{"type":"verse","number":52,"content":["ಬಚ್ಲೂತ್, ಮೆಹೀದ, ಹರ್ಷ,"]},{"type":"verse","number":53,"content":["ಬರ್ಕೋಸ್, ಸೀಸೆರ, ತೆಮಹ,"]},{"type":"verse","number":54,"content":["ನೆಚೀಹ, ಹಟೀಫ, ಇವರ ವಂಶಜರು."]},{"type":"verse","number":55,"content":["ಸೊಲೊಮೋನನ ಸೇವಕರ ವಂಶಜರು: ಸೋಟೈ, ಹಸ್ಸೋಫೆರೆತ್, ಪೆರೂದ,"]},{"type":"verse","number":56,"content":["ಯಾಲ, ದರ್ಕೋನ್, ಗಿದ್ದೇಲ್,"]},{"type":"verse","number":57,"content":["ಶೆಫಟ್ಯ, ಹಟ್ಟೀಲ್, ಪೋಕೆರೆತ್ ಹಚ್ಚೆಬಾಯೀಮ್, ಮತ್ತು ಆಮೀ ಇವರ ವಂಶಜರು."]},{"type":"verse","number":58,"content":["ದೇವಾಲಯದ ಸೇವಕರ ಹಾಗೂ ಸೊಲೊಮೋನನ ಸೇವಕರ ವಂಶಜರು ಒಟ್ಟು 392 ಮಂದಿ."]},{"type":"line_break"},{"type":"verse","number":59,"content":["ತೇಲ್ಮೆಲಹ, ತೇಲ್ಹರ್ಷ, ಕೆರೂಬ್, ಅದ್ದಾನ್, ಇಮ್ಮೇರ್ ಎಂಬ ಊರುಗಳಿಂದ ಹೊರಟುಬಂದವರಾಗಿದ್ದು, ತಮ್ಮ ಗೋತ್ರವಂಶಾವಳಿಗಳನ್ನು ತೋರಿಸಿ, ತಾವು ಇಸ್ರಾಯೇಲರೆಂಬುದನ್ನು ರುಜುಪಡಿಸಲಾಗದೇ ಇದ್ದವರು ಯಾರೆಂದರೆ:"]},{"type":"verse","number":60,"content":["ದೆಲಾಯ, ಟೋಬೀಯ, ನೆಕೋದ ಇವರ ಸಂತಾನದವರು ಒಟ್ಟು 652 ಮಂದಿ."]},{"type":"line_break"},{"type":"verse","number":61,"content":["ಯಾಜಕರಲ್ಲಿ: ಹಬಯ್ಯ, ಹಕ್ಕೋಚ್, ಬರ್ಜಿಲ್ಲೈ ಇವರ ಸಂತಾನದವರು. ಈ ಬರ್ಜಿಲ್ಲೈ ಎಂಬವನು ಗಿಲ್ಯಾದ್ಯನಾದ ಬರ್ಜಿಲ್ಲೈಯನ ಪುತ್ರಿಯರಲ್ಲಿ ಒಬ್ಬಳನ್ನು ಮದುವೆಮಾಡಿಕೊಂಡ ಕಾರಣ, ಅವನ ಹೆಸರನ್ನು ಇಟ್ಟುಕೊಂಡಿದ್ದನು."]},{"type":"verse","number":62,"content":["ಇವರು ತಮ್ಮ ವಂಶಾವಳಿಯ ದಾಖಲಾತಿಗಳಲ್ಲಿ ತಮ್ಮ ಹೆಸರುಗಳನ್ನು ಹುಡುಕಿದರು, ಆದರೆ ಅವು ಸಿಕ್ಕದೆ ಹೋದದ್ದರಿಂದ ಅವರು ಅಶುದ್ಧರೆಂದು ಪರಿಗಣಿಸಿ ಯಾಜಕ ಉದ್ಯೋಗದಿಂದ ಬಹಿಷ್ಕಾರವಾದರು."]},{"type":"verse","number":63,"content":["ಆದ್ದರಿಂದ ಊರೀಮ್, ತುಮ್ಮೀಮ್ ಮುಖಾಂತರ ದೈವನಿರ್ಣಯವನ್ನು ತಿಳಿಸಬಲ್ಲ ಯಾಜಕನು ದೊರೆಯುವ ತನಕ, ಇವರು ಮಹಾಪರಿಶುದ್ಧವಾದ ಪದಾರ್ಥಗಳನ್ನು ತಿನ್ನಬಾರದೆಂದು ರಾಜ್ಯಪಾಲನು ಆದೇಶಿಸಿದನು."]},{"type":"line_break"},{"type":"verse","number":64,"content":["ಹೀಗೆ ಹಿಂದಿರುಗಿ ಬಂದು, ಸಭೆ ಸೇರಿದ ಸರ್ವಸಮೂಹದ ಒಟ್ಟು ಸಂಖ್ಯೆ 42,360."]},{"type":"verse","number":65,"content":["ಅವರ ಹೊರತಾಗಿ ಅವರ ದಾಸರೂ, ದಾಸಿಯರೂ 7,337 ಮಂದಿಯೂ, ಅವರ ಹಾಡುಗಾರರೂ, ಹಾಡುಗಾರ್ತಿಯರೂ 200 ಮಂದಿ ಇದ್ದರು."]},{"type":"verse","number":66,"content":["ಅವರ 736 ಕುದುರೆಗಳು, ಅವರ 245 ಹೇಸರಕತ್ತೆಗಳು,"]},{"type":"verse","number":67,"content":["ಅವರ 435 ಒಂಟೆಗಳು, ಅವರ ಒಟ್ಟು 6,720 ಕತ್ತೆಗಳು."]},{"type":"line_break"},{"type":"verse","number":68,"content":["ಅವರು ಯೆರೂಸಲೇಮಿನಲ್ಲಿರುವ ಯೆಹೋವ ದೇವರ ಆಲಯಕ್ಕೆ ಬಂದ ತರುವಾಯ, ಕುಟುಂಬಗಳ ಕೆಲವು ಮುಖ್ಯಸ್ಥರು ದೇವರ ಆಲಯವನ್ನು ಅದರ ಸ್ಥಳದಲ್ಲಿ ಕಟ್ಟುವುದಕ್ಕೆ ಉಚಿತವಾದ ಕಾಣಿಕೆಗಳನ್ನು ಕೊಟ್ಟರು."]},{"type":"verse","number":69,"content":["ಅವರು ತಮ್ಮ ಶಕ್ತಿಗೆ ತಕ್ಕ ಹಾಗೆ ಕೆಲಸಕ್ಕಾಗಿ ಬೊಕ್ಕಸಕ್ಕೆ 400 ಕಿಲೋಗ್ರಾಂ ಬಂಗಾರವನ್ನೂ, 2,800 ಕಿಲೋಗ್ರಾಂ ಬೆಳ್ಳಿಯನ್ನೂ, ನೂರು ಯಾಜಕರ ಅಂಗಿಗಳನ್ನೂ ಕೊಟ್ಟರು."]},{"type":"verse","number":70,"content":["ಯಾಜಕರೂ, ಲೇವಿಯರೂ, ದ್ವಾರಪಾಲಕರೂ, ಹಾಡುಗಾರರೂ, ದೇವಾಲಯದ ಸೇವಕರೂ ತಮ್ಮ ತಮ್ಮ ಪಟ್ಟಣಗಳಲ್ಲಿಯೂ ಉಳಿದ ಇಸ್ರಾಯೇಲರು ತಮ್ಮ ಪಟ್ಟಣಗಳಲ್ಲಿಯೂ ವಾಸವಾಗಿದ್ದರು."]}],"footnotes":[]},"thisChapterLink":"/api/kan_okcv/EZR/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/EZR/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/EZR/1.json","previousChapterAudioLinks":{},"numberOfVerses":70}