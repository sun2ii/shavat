{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"ISA","translationId":"kan_okcv","name":"ಯೆಶಾಯ","commonName":"ಯೆಶಾಯ","title":"ಯೆಶಾಯ","order":23,"numberOfChapters":66,"sha256":"a11034a61d5633ecdcdf271fd5b056ef74c62cffd2f9b7f37e0b939fea173410","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/kan_okcv/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":19,"content":[{"type":"heading","content":["ಈಜಿಪ್ಟಿನ ವಿರೋಧವಾದ ಪ್ರವಾದನೆ"]},{"type":"verse","number":1,"content":["ಈಜಿಪ್ಟಿನವರ ವಿಷಯವಾದ ಪ್ರವಾದನೆ:",{"text":"ಇಗೋ, ಯೆಹೋವ ದೇವರು ವೇಗವುಳ್ಳ ಮೇಘವನ್ನು","poem":1},{"text":"ಹತ್ತಿಕೊಂಡು ಈಜಿಪ್ಟಿಗೆ ಬರುತ್ತಾರೆ.","poem":2},{"text":"ಅವರು ಸಮ್ಮುಖರಾದಾಗ ಈಜಿಪ್ಟಿನ ವಿಗ್ರಹಗಳು ನಡುಗುವುವು.","poem":1},{"text":"ಈಜಿಪ್ಟಿನವರ ಹೃದಯಗಳು ಅದರ ಮಧ್ಯೆ ಭಯದಿಂದ ಕರಗುವುವು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ಇದಲ್ಲದೆ ನಾನು ಈಜಿಪ್ಟಿನವನಿಗೆ ವಿರೋಧವಾಗಿ ಈಜಿಪ್ಟಿನವನನ್ನು ಎಬ್ಬಿಸುವೆನು.","poem":1},{"text":"ಸಹೋದರನಿಗೆ ವಿರುದ್ಧವಾಗಿ ಸಹೋದರನೂ,","poem":2},{"lineBreak":true},{"text":"ನೆರೆಯವನಿಗೆ ವಿರುದ್ಧವಾಗಿ ನೆರೆಯವನೂ,","poem":2},{"lineBreak":true},{"text":"ಪಟ್ಟಣಕ್ಕೆ ವಿರೋಧವಾಗಿ ಪಟ್ಟಣವೂ,","poem":2},{"lineBreak":true},{"text":"ರಾಜ್ಯಕ್ಕೆ ವಿರೋಧವಾಗಿ ರಾಜ್ಯವೂ ಹೊರಾಡುವವು.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ಈಜಿಪ್ಟಿನವರ ಮನಸ್ಸು ಭಯಗೊಳ್ಳುವುದು","poem":1},{"text":"ಅವರ ಆಲೋಚನೆಯನ್ನು ಭಂಗಪಡಿಸುವೆನು.","poem":2},{"text":"ಅಲ್ಲಿಯವರು ವಿಗ್ರಹಗಳನ್ನೂ, ಮಾಟಗಾರರನ್ನೂ,","poem":1},{"text":"ಯಕ್ಷಣಿಗಾರರನ್ನೂ, ಮಂತ್ರವಾದಿಗಳನ್ನೂ ಆಶ್ರಯಿಸುವರು.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ಈಜಿಪ್ಟಿನವರನ್ನು ಕ್ರೂರನಾದ","poem":1},{"text":"ಒಡೆಯನ ಕೈಗೆ ಒಪ್ಪಿಸುವೆನು.","poem":2},{"text":"ಭಯಂಕರನಾದ ರಾಜನು ಅವರನ್ನಾಳುವನು,","poem":1},{"text":"ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ನೈಲ್ ನದಿಯ ನೀರು ಬತ್ತಿಹೋಗುವುದು.","poem":1},{"text":"ನದಿ ತೀರವೂ ಇಂಗಿ ಒಣಗಿಹೋಗುವುದು.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ಕಾಲುವೆಗಳು ನಾರುವುವು.","poem":1},{"text":"ಈಜಿಪ್ಟನ ಉಪನದಿಗಳು ದೂರಕ್ಕೆ ಇಳಿದು ನೀರಿಲ್ಲದೆ ಹೋಗುವುವು.","poem":2},{"text":"ಜಂಬು ಹುಲ್ಲು ಬಾಡುವುದು.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"ನೈಲ್ ನದಿಯ ಹತ್ತಿರದ","poem":2},{"lineBreak":true},{"text":"ತೀರವು ಬರುಡಾಗುವುದು.","poem":2},{"text":"ನದಿಯ ಬಳಿಯಲ್ಲಿ ಬಿತ್ತಿದ ಬೀಜಗಳೆಲ್ಲವೂ","poem":1},{"text":"ಒಣಗಿ, ಗಾಳಿಗೆ ತೂರಿಹೋಗುವುವು.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ಮೀನುಗಾರರು ಕೂಡ ದುಃಖಿಸುವರು","poem":1},{"text":"ಮತ್ತು ನೈಲ್ ನದಿಯಲ್ಲಿ ಗಾಳ ಹಾಕುವವರು ಪ್ರಲಾಪಿಸುವರು.","poem":2},{"text":"ನೀರಿನ ಮೇಲೆ ಬಲೆ ಬೀಸುವವರು","poem":1},{"text":"ಕುಗ್ಗಿ ಹೋಗುವರು.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ನಯವಾದ ನಾರಿನ ಕೆಲಸದವರು","poem":1},{"text":"ಬಟ್ಟೆ ನೇಯುವವರು ನಿರಾಶರಾಗಿರುವರು.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ಬಟ್ಟೆಯಲ್ಲಿ ಕೆಲಸ ಮಾಡುವವರು ಖಿನ್ನರಾಗುತ್ತಾರೆ,","poem":1},{"text":"ಮತ್ತು ಎಲ್ಲಾ ವೇತನದಾರರು ಹೃದಯದಲ್ಲಿ ಅನಾರೋಗ್ಯಕ್ಕೆ ಒಳಗಾಗುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ಚೋವನ್ ಪಟ್ಟಣದ ಅಧಿಪತಿಗಳು ಕೇವಲ ಬುದ್ಧಿಹೀನರು;","poem":1},{"text":"ಫರೋಹನ ಮಂತ್ರಿಗಳಲ್ಲಿ ಜ್ಞಾನವುಳ್ಳ ಸಲಹೆಗಾರರ ಆಲೋಚನೆಯೂ ಜ್ಞಾನರಹಿತವಾಗಿದೆ.","poem":2},{"text":"ನೀವು ಫರೋಹನನಿಗೆ, “ನಾನು ಜ್ಞಾನಿಗಳ ಸಂತಾನದವನು,","poem":1},{"text":"ಪುರಾತನ ರಾಜನ ಶಿಷ್ಯನೆಂದು ಹೇಳುವುದು ಹೇಗೆ”?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ನಿನ್ನ ಜ್ಞಾನಿಗಳು ಎಲ್ಲಿ?","poem":1},{"text":"ನಿನಗೆ ಅವರು ಹೇಳಲಿ.","poem":2},{"text":"ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಈಜಿಪ್ಟಿನವರ ವಿರೋಧವಾಗಿ","poem":1},{"text":"ಉದ್ದೇಶಿಸಿದ್ದನ್ನು ಅವರು ತಿಳಿದುಕೊಳ್ಳಲಿ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ಚೋವನಿನ ಶ್ರೇಷ್ಠರು ಮೂರ್ಖರಾಗಿದ್ದಾರೆ.","poem":1},{"text":"ನೋಫಿನ","poem":2},{"noteId":4},{"text":"ಶ್ರೇಷ್ಠರು ಮೋಸ ಹೋಗಿದ್ದಾರೆ.","poem":2},{"text":"ಈಜಿಪ್ಟಿನ ಗೋತ್ರಗಳ ಪ್ರಮುಖರು ಅದನ್ನು ಭ್ರಮೆಗೊಳಿಸಿದ್ದಾರೆ.","poem":1},{"text":"ಅದನ್ನು ತಪ್ಪು ದಾರಿಗೆಳೆದಿದ್ದಾರೆ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ಯೆಹೋವ ದೇವರು ಅವರ ಮಧ್ಯದಲ್ಲಿ","poem":1},{"text":"ತತ್ತರಿಸುವ ಆತ್ಮವನ್ನು ಸುರಿಸಿದ್ದಾರೆ.","poem":2},{"text":"ಅಮಲೇರಿದವನು ಕಕ್ಕುತ್ತಾ ಓಲಾಡುವ ಪ್ರಕಾರ","poem":1},{"text":"ಈಜಿಪ್ಟ್ ತನ್ನ ಒಂದೊಂದು ಕೆಲಸದಲ್ಲಿಯೂ ಓಲಾಡುವಂತೆ ಮಾಡಿದ್ದಾರೆ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ಈಜಿಪ್ಟಿನಲ್ಲಿ ತಲೆಯಾಗಲಿ, ಬಾಲವಾಗಲಿ, ಕೊಂಬೆಯಾಗಲಿ,","poem":1},{"text":"ಒಂದು ಕಡ್ಡಿಯಾಗಲಿ ಸಾಧಿಸಲು ಸಾಧ್ಯವಾಗದ ಯಾವ ಕೆಲಸವೂ ಇರುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":16,"content":["ಆ ದಿನದಲ್ಲಿ ಈಜಿಪ್ಟಿನವರು ಹೆಂಗಸರ ಹಾಗೆ ಇರುವರು. ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಅದರ ಮೇಲೆ ಎತ್ತಿದ ಕೈಯನ್ನು ಬೀಸುತ್ತಿರುವುದರಿಂದ ಅವರು ಹೆದರಿ ಭಯಪಡುವರು."]},{"type":"verse","number":17,"content":["ಈಜಿಪ್ಟ್ ಬೆಚ್ಚಿ ಬೀಳುವುದಕ್ಕೆ ಯೆಹೂದ ದೇಶವು ಕಾರಣವಾಗುವುದು, ಈ ದೇಶದ ಹೆಸರನ್ನು ಕೇಳುವ ಪ್ರತಿಯೊಬ್ಬನು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಈಜಿಪ್ಟಿಗೆ ಪ್ರತಿಕೂಲವಾಗಿ ಮಾಡಿಕೊಂಡಿರುವ ಆಲೋಚನೆಯನ್ನು ತಿಳಿದು ಬೆರಗಾಗುವನು."]},{"type":"verse","number":18,"content":["ಆ ದಿವಸದಲ್ಲಿ ಈಜಿಪ್ಟಿನ ಐದು ಪಟ್ಟಣಗಳು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರಿಗೆ ಆಣೆಯಿಟ್ಟುಕೊಳ್ಳುವವು. ಕಾನಾನಿನ ಭಾಷೆಯನ್ನಾಡುವವರಿಂದ ತುಂಬಿದ ಐದು ಪಟ್ಟಣಗಳು ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿರುವುವು. ಅವುಗಳಲ್ಲಿ ಒಂದರ ಹೆಸರು “ನಾಶಪುರ",{"noteId":5},".”"]},{"type":"verse","number":19,"content":["ಆ ದಿನದಲ್ಲಿ ಈಜಿಪ್ಟ್ ದೇಶದ ಮಧ್ಯದಲ್ಲಿ ಯೆಹೋವ ದೇವರಿಗೆ ಬಲಿಪೀಠವು ದೇಶದ ಎಲ್ಲೆಯಲ್ಲಿ ಯೆಹೋವ ದೇವರಿಗೆ ಒಂದು ಸ್ತಂಭವು ಇರುವುದು."]},{"type":"verse","number":20,"content":["ಅದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರಿಗೆ ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿ ಗುರುತಾಗಿ ಸಾಕ್ಷಿಯಾಗಿರುವುದು. ಏಕೆಂದರೆ ಹಿಂಸಕರ ದೆಸೆಯಿಂದ ಯೆಹೋವ ದೇವರನ್ನು ಕೂಗಿಕೊಳ್ಳಲು, ದೇವರು ಅವರಿಗೆ ಒಬ್ಬ ಶೂರನಾದ ರಕ್ಷಕನನ್ನು ಕಳುಹಿಸಿ, ಅವರನ್ನು ಬಿಡುಗಡೆ ಮಾಡುವರು."]},{"type":"verse","number":21,"content":["ಯೆಹೋವ ದೇವರು ತಮ್ಮನ್ನು ಈಜಿಪ್ಟಿನವರಿಗೆ ತಿಳಿಯಪಡಿಸಲು, ಅವರು ಆ ದಿನದಲ್ಲಿ ಯೆಹೋವ ದೇವರನ್ನು ತಿಳಿದುಕೊಳ್ಳುವರು ಮತ್ತು ಬಲಿಕಾಣಿಕೆಗಳಿಂದ ಸೇವೆಮಾಡುವರು. ಹೌದು, ಅವರು ಯೆಹೋವ ದೇವರಿಗೆ ಪ್ರಮಾಣ ಮಾಡಿಕೊಂಡು ನೆರವೇರಿಸುವರು."]},{"type":"verse","number":22,"content":["ಇದಲ್ಲದೆ ಯೆಹೋವ ದೇವರು ಈಜಿಪ್ಟಿನವರನ್ನು ಹೊಡೆಯುವರು; ಗಾಯಮಾಡಿ ಸ್ವಸ್ಥ ಮಾಡುವರು. ಅವರು ಯೆಹೋವ ದೇವರ ಕಡೆಗೆ ತಿರುಗಿಕೊಳ್ಳುವರು, ದೇವರು ಅವರನ್ನು ಆಲೈಸಿ ಸ್ವಸ್ಥ ಮಾಡುವರು."]},{"type":"verse","number":23,"content":["ಆ ದಿವಸದಲ್ಲಿ ಈಜಿಪ್ಟಿನಿಂದ ಅಸ್ಸೀರಿಯಕ್ಕೆ ಹೋಗುವ ಒಂದು ರಾಜ ಮಾರ್ಗವಿರುವುದು. ಅಸ್ಸೀರಿಯದವರು ಈಜಿಪ್ಟಿಗೂ, ಈಜಿಪ್ಟಿನವರು ಅಸ್ಸೀರಿಯಕ್ಕೂ ಹೋಗಿ ಬರುವರು. ಈಜಿಪ್ಟಿನವರು, ಅಸ್ಸೀರಿಯರೊಂದಿಗೆ ಯೆಹೋವ ದೇವರನ್ನು ಆರಾಧಿಸುವರು."]},{"type":"verse","number":24,"content":["ಆ ದಿನದಲ್ಲಿ ಇಸ್ರಾಯೇಲು ಈಜಿಪ್ಟಿನವರ ಮತ್ತು ಅಸ್ಸೀರಿಯದವರ ಸಂಗಡ ಮೂರನೆಯದಾಗಿ ದೇಶದ ಮಧ್ಯದಲ್ಲಿ ಆಶೀರ್ವಾದವಾಗಿರುವುದು."]},{"type":"verse","number":25,"content":["ನನ್ನ ಪ್ರಜೆಯಾದ ಈಜಿಪ್ಟಿಗೂ, ನನ್ನ ಕೈಕೆಲಸವಾದ ಅಸ್ಸೀರಿಯಕ್ಕೂ ಮತ್ತು ನನ್ನ ಸೊತ್ತಾದ ಇಸ್ರಾಯೇಲಿಗೂ, “ನಿಮಗೆ ಆಶೀರ್ವಾದ,” ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಅವುಗಳನ್ನು ಆಶೀರ್ವಾದ ಮಾಡುವರು."]}],"footnotes":[{"noteId":4,"caller":"+","text":"ನೋಫ ಅಥವಾ ಮೆಂಫೀಸ್","reference":{"chapter":19,"verse":13}},{"noteId":5,"caller":"+","text":"ನಾಶಪುರ ಕೆಲವು ಹಸ್ತಪ್ರತಿಗಳಲ್ಲಿ ರವಿಪುರ","reference":{"chapter":19,"verse":18}}]},"thisChapterLink":"/api/kan_okcv/ISA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/ISA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/ISA/18.json","previousChapterAudioLinks":{},"numberOfVerses":25}