{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"ISA","translationId":"kan_okcv","name":"ಯೆಶಾಯ","commonName":"ಯೆಶಾಯ","title":"ಯೆಶಾಯ","order":23,"numberOfChapters":66,"sha256":"a11034a61d5633ecdcdf271fd5b056ef74c62cffd2f9b7f37e0b939fea173410","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/kan_okcv/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":65,"content":[{"type":"heading","content":["ನ್ಯಾಯತೀರ್ಪು ಮತ್ತು ರಕ್ಷಣೆ"]},{"type":"verse","number":1,"content":[{"text":"“ಕೇಳದವರಿಗೂ ನಾನು ನನ್ನನ್ನು ಪ್ರಕಟಿಸಿಕೊಂಡಿದ್ದೇನೆ.","poem":1},{"text":"ನನ್ನನ್ನು ಹುಡುಕದವರಿಗೆ ನಾನು ಸಿಕ್ಕಿದೆನು.","poem":2},{"text":"ನನ್ನ ಹೆಸರನ್ನು ಕರೆಯದ ಜನಾಂಗಕ್ಕೆ,","poem":1},{"text":"‘ಇಗೋ, ಇದ್ದೇನೆ; ಇಗೋ, ಇದ್ದೇನೆ,’ ಎಂದು ಹೇಳಿದೆನು.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ಒಳ್ಳೆಯದಲ್ಲದ ಮಾರ್ಗದಲ್ಲಿ","poem":1},{"text":"ತಮ್ಮ ಆಲೋಚನೆಗಳ ಪ್ರಕಾರ ನಡೆದುಕೊಂಡು","poem":2},{"text":"ತಿರುಗಿಬೀಳುವ ಜನರಿಗೆ ದಿನವೆಲ್ಲಾ","poem":1},{"text":"ನಾನು ಕೈಚಾಚಿ ಕರೆದೆನು.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ಇವರು ಯಾವಾಗಲೂ ನನ್ನ ಮುಖದ ಮುಂದೆ","poem":1},{"text":"ನನಗೆ ಕೋಪೋದ್ರೇಕವನ್ನು ಎಬ್ಬಿಸುವ ಜನರು.","poem":2},{"text":"ತೋಟಗಳಲ್ಲಿ ಬಲಿ ಅರ್ಪಿಸಿ,","poem":1},{"text":"ಇಟ್ಟಿಗೆಯ ಬಲಿಪೀಠದ ಮೇಲೆ ಧೂಪ ಸುಡುವರು.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ಸಮಾಧಿಗಳಲ್ಲಿ ಉಳಿದು,","poem":1},{"text":"ಗವಿಗಳಲ್ಲಿ ತಂಗುವರು.","poem":2},{"text":"ಹಂದಿಯ ಮಾಂಸವನ್ನು ತಿನ್ನುವರು","poem":1},{"text":"ತಮ್ಮ ಪಾತ್ರೆಗಳಲ್ಲಿ ಅಶುದ್ಧ ಪದಾರ್ಥಗಳ ಸಾರನ್ನು ಇಟ್ಟುಕೊಂಡು,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"‘ನಿನ್ನಷ್ಟಕ್ಕೆ ನೀನೇ ನಿಂತುಕೋ, ನನ್ನ ಬಳಿಗೆ ಬರಬೇಡ.","poem":1},{"text":"ಏಕೆಂದರೆ ನಿನಗಿಂತ ಪರಿಶುದ್ಧನಾಗಿದ್ದೇನೆ,’ ಎಂದು ಹೇಳುವರು.","poem":2},{"text":"ಇವರು ನನ್ನ ಮೂಗಿನಲ್ಲಿ ಹೊಗೆಯಾಗಿಯೂ,","poem":1},{"text":"ದಿನವೆಲ್ಲಾ ಉರಿಯುವ ಬೆಂಕಿಯಾಗಿಯೂ ಇದ್ದಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“ನನ್ನ ಮುಂದೆ ಅದು ಬರೆಯಲಾಗಿದೆ.","poem":1},{"text":"ನಾನು ಸುಮ್ಮನಿರದೆ ಪ್ರತಿಫಲ ಕೊಡುತ್ತೇನೆ.","poem":2},{"lineBreak":true},{"text":"ಅವರ ಮಡಿಲಲ್ಲಿ ಪ್ರತಿಫಲ ಕೊಡುತ್ತೇನೆ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ನಿಮ್ಮ ಪಾಪಗಳಿಗೂ, ನಿಮ್ಮ ತಂದೆಗಳ ಪಾಪಗಳಿಗೂ ಕೂಡ ಪ್ರತಿಫಲ ಕೊಡುತ್ತೇನೆ”","poem":1},{"text":"ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.","poem":2},{"text":"“ಅವರು ಬೆಟ್ಟಗಳ ಮೇಲೆ ಧೂಪ ಸುಟ್ಟು,","poem":1},{"text":"ಗುಡ್ಡಗಳ ಮೇಲೆ ನನ್ನನ್ನು ಪರಿಹಾಸ್ಯ ಮಾಡಿದರಲ್ಲಾ.","poem":2},{"text":"ಹೀಗಿರುವುದರಿಂದ ಅವರ ಹಿಂದಿನ ಕೆಲಸಗಳನ್ನು","poem":1},{"text":"ಅವರ ಮಡಿಲಲ್ಲಿ ಅಳೆದು ಸುರಿಸುವೆನು.”","poem":2}]},{"type":"verse","number":8,"content":["ಯೆಹೋವ ದೇವರು ಹೀಗೆನ್ನುತ್ತಾರೆ:",{"text":"“ರಸ ದೊರೆಯಬಹುದಾದ ದ್ರಾಕ್ಷಿ ಗೊಂಚಲನ್ನು","poem":1},{"text":"ಒಬ್ಬನು ನೋಡಿ, ‘ಹಾಳು ಮಾಡಬೇಡ,","poem":2},{"lineBreak":true},{"text":"ಅದರಲ್ಲಿ ಪ್ರಯೋಜನವಿದೆ,’","poem":2},{"text":"ಎನ್ನುವಂತೆ ನಾನು ನನ್ನ ಸೇವಕರನ್ನು ಲಕ್ಷ್ಯಕ್ಕೆ ತಂದು","poem":1},{"text":"ಇವರನ್ನೆಲ್ಲಾ ಹಾಳುಮಾಡಬಾರದು ಎಂದುಕೊಳ್ಳುವೆನು.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ಯಾಕೋಬಿನೊಳಗಿಂದ ಒಂದು ಸಂತಾನವನ್ನೂ,","poem":1},{"text":"ಯೆಹೂದದೊಳಗಿಂದ ನನ್ನ ಪರ್ವತಗಳಿಗೆ ಬಾಧ್ಯಸ್ಥನಾಗಿರುವವನನ್ನು ಹೊರಗೆ ಬರಮಾಡುವೆನು.","poem":2},{"text":"ನಾನು ಆಯ್ದುಕೊಂಡವರು ಅದನ್ನು ಸ್ವಾಧೀನಮಾಡಿಕೊಳ್ಳುವರು.","poem":1},{"text":"ನನ್ನ ಸೇವಕರು ಅದರಲ್ಲಿ ವಾಸವಾಗುವರು.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ನನ್ನನ್ನು ಹುಡುಕುವ ನನ್ನ ಜನರಿಗೋಸ್ಕರ ಶಾರೋನು ಮಂದೆಗಳ ಹಟ್ಟಿಯಾಗಿಯೂ,","poem":1},{"text":"ಆಕೋರಿನ ತಗ್ಗು, ದನಗಳು ಮಲಗುವ ಸ್ಥಳವಾಗಿಯೂ ಇರುವುದು,","poem":2},{"lineBreak":true},{"text":"ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“ಆದರೆ ಯೆಹೋವನಾದ ನನ್ನನ್ನು ತೊರೆದು,","poem":1},{"text":"ನನ್ನ ಪವಿತ್ರ ಪರ್ವತವನ್ನು ಮರೆತು,","poem":2},{"text":"ಶುಭದಾಯಕ ದೇವತೆಗೆ ಔತಣವನ್ನು ಅಣಿಮಾಡಿ,","poem":1},{"text":"ಗಾದ್ ಎಂಬ ಅದೃಷ್ಟ ದೇವತೆಗೆ ಮದ್ಯವನ್ನು ತುಂಬಾ ಬೆರೆಸಿದ ನಿಮಗೆ","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ಖಡ್ಗವನ್ನೇ ಗತಿಯಾಗ ಮಾಡುವೆನು.","poem":1},{"text":"ಆದ್ದರಿಂದ ನಿಮ್ಮನ್ನು ಖಡ್ಗಕ್ಕೆ ನೇಮಿಸುವೆನು.","poem":2},{"lineBreak":true},{"text":"ನೀವೆಲ್ಲರು ಕೊಲೆಗೆ ಬೊಗ್ಗಿಕೊಳ್ಳುವಿರಿ.","poem":2},{"text":"ಏಕೆಂದರೆ, ನಾನು ಕರೆಯಲು, ನೀವು ಉತ್ತರ ಕೊಡಲಿಲ್ಲ. ನಾನು ಹೇಳಿದಾಗ ನೀವು ಕೇಳಲಿಲ್ಲ.","poem":1},{"text":"ನನ್ನ ದೃಷ್ಟಿಯಲ್ಲಿ ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡಿದಿರಿ.","poem":2},{"lineBreak":true},{"text":"ನಾನು ಮೆಚ್ಚದ್ದನ್ನು ಆರಿಸಿಕೊಂಡಿರಿ.”","poem":2}]},{"type":"verse","number":13,"content":["ಹೀಗಿರುವುದರಿಂದ ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ:",{"text":"“ನನ್ನ ಸೇವಕರು ತಿನ್ನುವರು.","poem":1},{"text":"ಆದರೆ ನೀವು ಹಸಿದಿರುವಿರಿ.","poem":2},{"text":"ನನ್ನ ಸೇವಕರು ಕುಡಿಯುವರು,","poem":1},{"text":"ಆದರೆ ನೀವು ಬಾಯಾರಿ ಇರುವಿರಿ.","poem":2},{"text":"ಇಗೋ, ನನ್ನ ಸೇವಕರು ಸಂತೋಷಪಡುವರು,","poem":1},{"text":"ಆದರೆ ನೀವು ನಾಚಿಕೆ ಪಡುವಿರಿ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ಇಗೋ, ನನ್ನ ಸೇವಕರು","poem":1},{"text":"ಹೃದಯದ ಆನಂದದಿಂದ ಹಾಡುವರು,","poem":2},{"text":"ಆದರೆ ನೀವು ಹೃದಯದ ವ್ಯಸನದಿಂದ ಅಳುವಿರಿ","poem":1},{"text":"ಮತ್ತು ಮುರಿದ ಆತ್ಮದಿಂದ ಗೋಳಾಡುವಿರಿ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ನಿಮ್ಮ ಹೆಸರನ್ನು ನಾನು ಆಯ್ದುಕೊಂಡವರಿಗೆ","poem":1},{"text":"ಶಾಪವಾಗಿ ಉಳಿಸುವಿರಿ.","poem":2},{"text":"ಹೇಗೆಂದರೆ, ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಅಪನಂಬಿಗಸ್ತರಾದ ನಿಮ್ಮನ್ನು ಕೊಂದುಹಾಕಿ,","poem":1},{"text":"ತಮ್ಮ ಸೇವಕರಿಗಾದರೋ ಬೇರೆ ಹೆಸರನ್ನು ನೀಡುವರು.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ಆಗ ದೇಶದಲ್ಲಿ ತನ್ನನ್ನು ಆಶೀರ್ವದಿಸುವವನು,","poem":1},{"text":"ಸತ್ಯ ದೇವರಲ್ಲಿ ತನ್ನನ್ನು ಆಶೀರ್ವದಿಸಿಕೊಳ್ಳುವನು;","poem":2},{"text":"ದೇಶದಲ್ಲಿ ಆಣೆ ಇಟ್ಟುಕೊಳ್ಳುವವನು, ಸತ್ಯ ದೇವರಲ್ಲಿ ಆಣೆ ಇಟ್ಟುಕೊಳ್ಳುವನು.","poem":1},{"text":"ಏಕೆಂದರೆ ಮುಂಚಿನ ಕಷ್ಟಗಳು ಮರೆತು ಹೋಗಿವೆ,","poem":2},{"lineBreak":true},{"text":"ಮತ್ತು ಅವು ನನ್ನ ಕಣ್ಣಿಗೆ ಮರೆಯಾಗಿವೆ.","poem":2}]},{"type":"heading","content":["ಹೊಸ ಆಕಾಶವೂ, ಹೊಸ ಭೂಮಿಯೂ"]},{"type":"verse","number":17,"content":[{"text":"“ನಾನು ಹೊಸ ಆಕಾಶವನ್ನೂ,","poem":1},{"text":"ಹೊಸ ಭೂಮಿಯನ್ನೂ ಸೃಷ್ಟಿಸುತ್ತೇನೆ.","poem":2},{"text":"ಮುಂಚಿನವುಗಳು ಜ್ಞಾಪಕದಲ್ಲಿರುವುದಿಲ್ಲ","poem":1},{"text":"ಇಲ್ಲವೆ ಅವು ಸ್ಮರಣೆಗೆ ಬರುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ಆದರೆ ನಾನು ಸೃಷ್ಟಿಸುವುದರ ವಿಷಯದಲ್ಲಿ ಸಂತೋಷಿಸಿ,","poem":1},{"text":"ಎಂದೆಂದಿಗೂ ಉಲ್ಲಾಸಪಡಿರಿ.","poem":2},{"text":"ಏಕೆಂದರೆ ಇಗೋ, ನಾನು ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಉಲ್ಲಾಸವನ್ನೂ,","poem":1},{"text":"ನನ್ನ ಜನರಲ್ಲಿ ಸಂತೋಷವನ್ನೂ ಸೃಷ್ಟಿಸುತ್ತೇನೆ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ಯೆರೂಸಲೇಮಿನಲ್ಲಿ ಉಲ್ಲಾಸಿಸಿ,","poem":1},{"text":"ನನ್ನ ಜನರಲ್ಲಿ ಸಂತೋಷ ಪಡುವೆನು.","poem":2},{"text":"ಅದರಲ್ಲಿ ಅಳುವ ಧ್ವನಿಯೂ,","poem":1},{"text":"ಪ್ರಲಾಪದ ಧ್ವನಿಯೂ ಇನ್ನು ಕೇಳಿಬರುವುದಿಲ್ಲ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“ಅಲ್ಲಿ ಕೆಲವು ದಿನಗಳು ಮಾತ್ರ ಬದುಕತಕ್ಕ ಕೂಸೂ,","poem":1},{"text":"ವೃದ್ಧನೂ ಇರುವುದಿಲ್ಲ.","poem":2},{"text":"ಮಗುವು ನೂರು ವರುಷದವನಾಗಿ ಸಾಯುವುದು.","poem":1},{"text":"ಆದರೆ ನೂರು ವರುಷವನ್ನು ತಲುಪಲು ವಿಫಲನಾದವನನ್ನು ಶಾಪಗ್ರಸ್ತ ಎಂದು ಪರಿಗಣಿಸಲಾಗುತ್ತದೆ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ಇದಲ್ಲದೆ ಅವರು ಮನೆಗಳನ್ನು ಕಟ್ಟಿ, ವಾಸಮಾಡುವರು;","poem":1},{"text":"ದ್ರಾಕ್ಷಿತೋಟಗಳನ್ನು ನೆಟ್ಟು, ಅವುಗಳ ಫಲವನ್ನು ಉಣ್ಣುವರು.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ಅವರು ಕಟ್ಟಿದ ಮನೆಗಳಲ್ಲಿ ಬೇರೆಯವರು ವಾಸಮಾಡುವುದಿಲ್ಲ.","poem":1},{"text":"ಅವರು ನೆಟ್ಟ ತೋಟದ ಫಲವನ್ನು ಇನ್ನೊಬ್ಬರು ತಿನ್ನುವುದಿಲ್ಲ.","poem":2},{"text":"ಏಕೆಂದರೆ, ಮರಗಳ ಹಾಗೆ ನನ್ನ ಜನರು ಬಹುಕಾಲ ಬಾಳುವರು.","poem":1},{"text":"ನಾನು ಆಯ್ದುಕೊಂಡವರು ತಮ್ಮ ಕೈಕೆಲಸಗಳನ್ನು ಅನುಭವಿಸುವರು.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ಅವರು ವ್ಯರ್ಥವಾಗಿ ದುಡಿಯರು.","poem":1},{"text":"ಕಷ್ಟವನ್ನು ಎದುರುಗೊಳ್ಳುವುದಿಲ್ಲ.","poem":2},{"text":"ಏಕೆಂದರೆ ಅವರು ಯೆಹೋವ ದೇವರ ಆಶೀರ್ವಾದ ಹೊಂದಿದವರ ಸಂತಾನವಾಗಿದ್ದಾರೆ.","poem":1},{"text":"ಅವರ ಸಂಗಡ ಅವರ ಸಂತತಿಯು ಸಹ ಆಶೀರ್ವಾದ ಹೊಂದುವುದು.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ಅವರು ಕರೆಯುವುದಕ್ಕಿಂತ ಮುಂಚೆ ನಾನು ಉತ್ತರಕೊಡುವೆನು.","poem":1},{"text":"ಅವರು ಇನ್ನೂ ಮಾತನಾಡುತ್ತಿರುವಾಗಲೇ ನಾನು ಕೇಳುವೆನು.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ತೋಳವೂ ಕುರಿಮರಿಯೂ ಒಂದಾಗಿ ಮೇಯುವುವು;","poem":1},{"text":"ಸಿಂಹವು ಎತ್ತಿನ ಹಾಗೆ ಹುಲ್ಲು ತಿನ್ನುವುದು;","poem":2},{"lineBreak":true},{"text":"ಹಾವಿಗೆ ಮಣ್ಣೇ ಆಹಾರವಾಗುವುದು;","poem":2},{"text":"ಅವು ನನ್ನ ಪರಿಶುದ್ಧ ಪರ್ವತದಲ್ಲೆಲ್ಲಾ","poem":1},{"text":"ಯಾವ ಕೇಡೂ ಮಾಡುವುದಿಲ್ಲ, ನಾಶವೂ ಮಾಡುವುದಿಲ್ಲ,”","poem":2},{"lineBreak":true},{"text":"ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kan_okcv/ISA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/ISA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/ISA/64.json","previousChapterAudioLinks":{},"numberOfVerses":25}