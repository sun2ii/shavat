{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"JER","translationId":"kan_okcv","name":"ಯೆರೆಮೀಯ","commonName":"ಯೆರೆಮೀಯ","title":"ಯೆರೆಮೀಯ","order":24,"numberOfChapters":52,"sha256":"eb4350ed3369dcdab7f6196c7d77a35a47a52ee0148c43b1fadcf96ef2c850fb","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/kan_okcv/JER/52.json","totalNumberOfVerses":1362},"chapter":{"number":13,"content":[{"type":"heading","content":["ನಡುಕಟ್ಟಿನ ಸಾಮ್ಯ"]},{"type":"verse","number":1,"content":["ಯೆಹೋವ ದೇವರು ನನಗೆ, “ನೀನು ಹೋಗಿ, ನಾರಿನ ನಡುಕಟ್ಟು ಒಂದನ್ನು ಕೊಂಡುಕೊಂಡು ಸೊಂಟಕ್ಕೆ ಬಿಗಿದುಕೋ. ಅದನ್ನು ನೀರಿನಲ್ಲಿ ನೆನೆಸಬೇಡ,” ಎಂದು ಅಪ್ಪಣೆಕೊಟ್ಟರು."]},{"type":"verse","number":2,"content":["ನಾನು ಯೆಹೋವ ದೇವರ ಮಾತಿನಂತೆ ನಡುಕಟ್ಟನ್ನು ಕೊಂಡುಕೊಂಡು ಸೊಂಟಕ್ಕೆ ಬಿಗಿದುಕೊಂಡೆ."]},{"type":"verse","number":3,"content":["ಆಮೇಲೆ, “ನೀನು ಸೊಂಟಕ್ಕೆ ಬಿಗಿದ ಆ ನಡುಕಟ್ಟನ್ನು ತೆಗೆದುಕೊಂಡು,"]},{"type":"verse","number":4,"content":["ಯೂಫ್ರೇಟೀಸ್ ನದಿಗೆ ಹೋಗಿ ಅದನ್ನು ಅಲ್ಲಿಯ ಬಂಡೆಯ ಸಂದಿಯೊಳಗೆ ಬಚ್ಚಿಡು,” ಎಂಬುದಾಗಿ ಯೆಹೋವ ದೇವರ ಎರಡನೆಯ ಆದೇಶ ನನಗೆ ಬಂದಿತು."]},{"type":"verse","number":5,"content":["ಆಗ ಯೆಹೋವ ದೇವರ ಅಪ್ಪಣೆಯ ಮೇರೆಗೆ ನಾನು ಹೋಗಿ, ಯೂಫ್ರೇಟೀಸ್ ನದಿಯ ಬಳಿಯಲ್ಲಿ ಅದನ್ನು ಬಚ್ಚಿಟ್ಟೆ."]},{"type":"verse","number":6,"content":["ಬಹು ದಿನಗಳ ಮೇಲೆ ಯೆಹೋವ ದೇವರು ನನಗೆ, “ಹೊರಡು, ಯೂಫ್ರೇಟೀಸ್ ನದಿಗೆ ಅಲ್ಲಿ ಬಚ್ಚಿಡಬೇಕೆಂದು ನಾನು ಅಪ್ಪಣೆಕೊಟ್ಟ ನಡುಕಟ್ಟನ್ನು ಅಲ್ಲಿಂದ ತೆಗೆ,” ಎಂದು ಹೇಳಿದರು."]},{"type":"verse","number":7,"content":["ಆಗ ನಾನು ಯೂಫ್ರೇಟೀಸ್ ನದಿಗೆ ಹೋಗಿ ಹುಡುಕಿ, ನಾನು ಬಚ್ಚಿಟ್ಟ ಸ್ಥಳದಿಂದ ಆ ನಡುಕಟ್ಟನ್ನು ತೆಗೆದೆ. ಆದರೆ ಅದು ಕೆಟ್ಟು ಯಾವ ಕೆಲಸಕ್ಕೂ ಬಾರದ್ದಾಗಿತ್ತು."]},{"type":"verse","number":8,"content":["ಆಗ ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವು ನನಗೆ ಉಂಟಾಗಿ ಹೇಳಿದ್ದೇನೆಂದರೆ,"]},{"type":"verse","number":9,"content":["“ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ: ‘ಈ ಪ್ರಕಾರ ನಾನು ಯೆಹೂದದ ಗರ್ವವನ್ನೂ, ಯೆರೂಸಲೇಮಿನ ಮಹಾ ಗರ್ವವನ್ನು ಕೆಡಿಸುವೆನು."]},{"type":"verse","number":10,"content":["ನನ್ನ ವಾಕ್ಯಗಳನ್ನು ಕೇಳಲೊಲ್ಲದೆ ತಮ್ಮ ಹೃದಯದ ಕಲ್ಪನೆಯಂತೆ ನಡೆದುಕೊಂಡು, ಬೇರೆ ದೇವರುಗಳನ್ನು ಸೇವಿಸುವುದಕ್ಕೂ, ಅವುಗಳನ್ನು ಆರಾಧಿಸುವುದಕ್ಕೂ ಹಿಂಬಾಲಿಸುವ ಈ ದುಷ್ಟಜನರು ಯಾವ ಕೆಲಸಕ್ಕಾದರೂ ಬಾರದ ಈ ನಡುಕಟ್ಟಿನ ಹಾಗಿರುವರು."]},{"type":"verse","number":11,"content":["ಯಾವ ಪ್ರಕಾರ ಇದು ಮನುಷ್ಯನ ನಡುವಿಗೆ ಹತ್ತಿಕೊಳ್ಳುವುದೋ, ಅದೇ ಪ್ರಕಾರ ನಾನು ಇಸ್ರಾಯೇಲಿನ ಮನೆತನವನ್ನೆಲ್ಲವನ್ನೂ, ಯೆಹೂದದ ಮನೆತನವನ್ನೆಲ್ಲವನ್ನೂ ನನಗೆ ಜನರೂ ಹೆಸರೂ ಸ್ತೋತ್ರವೂ ಮಹಿಮೆಯೂ ಆಗುವ ಹಾಗೆ ನನಗೆ ಹತ್ತಿಕೊಳ್ಳುವಂತೆ ಮಾಡಿದೆನು, ಆದರೆ ಅವರು ಕೇಳದೇ ಹೋದರು ಎಂದು ಯೆಹೋವ ದೇವರ ಅನ್ನುತ್ತಾರೆ.’"]},{"type":"heading","content":["ದ್ರಾಕ್ಷಾರಸದ ಗಡಿಗೆಗಳು"]},{"type":"verse","number":12,"content":["“ಆದ್ದರಿಂದ ನೀನು ಅವರಿಗೆ ಈ ಮಾತನ್ನು ಹೇಳಬೇಕು: ‘ಇಸ್ರಾಯೇಲಿನ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ: ಗಡಿಗೆಗಳೆಲ್ಲಾ ದ್ರಾಕ್ಷಾರಸದಿಂದ ತುಂಬಿರುವುವು. ಆಗ ಅವರು ನಿನಗೆ ಗಡಿಗೆಗಳೆಲ್ಲಾ ದ್ರಾಕ್ಷಾರಸದಿಂದ ತುಂಬಿರುವುವೆಂದು ನಮಗೆ ಚೆನ್ನಾಗಿ ತಿಳಿಯಿತಲ್ಲವೋ,’ ಎಂದು ನಿನಗೆ ಹೇಳುವರು."]},{"type":"verse","number":13,"content":["ಆಗ ನೀನು ಅವರಿಗೆ ಹೇಳಬೇಕಾದದ್ದೇನೆಂದರೆ: ‘ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ, ಇಗೋ, ನಾನು ಈ ದೇಶದ ನಿವಾಸಿಗಳನ್ನೆಲ್ಲಾ ದಾವೀದನ ಸಿಂಹಾಸನದಲ್ಲಿ ಕುಳಿತುಕೊಳ್ಳುವ ಅರಸರನ್ನೂ, ಯಾಜಕರನ್ನೂ, ಪ್ರವಾದಿಗಳನ್ನೂ, ಯೆರೂಸಲೇಮಿನ ನಿವಾಸಿಗಳೆಲ್ಲರನ್ನೂ ಅಮಲಿನಿಂದ ತುಂಬಿಸುವೆನು."]},{"type":"verse","number":14,"content":["ಹಿರಿಕಿರಿಯರಾದ ಎಲ್ಲರನ್ನು ಒಬ್ಬರಿಗೊಬ್ಬರು ಬಡಿದಾಡುವಂತೆ ಮಾಡುವೆನು. ಅವರನ್ನು ಉಳಿಸೆನು, ಕನಿಕರಿಸೆನು, ಕರುಣಿಸೆನು ಹಾಗೂ ನಾಶಮಾಡದೆ ಬಿಡೆನು,’ ಇದು ಯೆಹೋವ ದೇವರಾದ ನನ್ನ ನುಡಿ.”"]},{"type":"heading","content":["ಸೆರೆಯ ಬೆದರಿಕೆ"]},{"type":"verse","number":15,"content":[{"text":"ಕೇಳಿರಿ, ಕಿವಿಗೊಡಿರಿ, ಗರ್ವಪಡಬೇಡಿರಿ;","poem":1},{"text":"ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ಮಾತನಾಡಿದ್ದಾರೆ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ಅವರು ಕತ್ತಲೆಯನ್ನು ತರುವುದಕ್ಕಿಂತ ಮೊದಲು","poem":1},{"text":"ನಿಮ್ಮ ಕಾಲುಗಳು ಮೊಬ್ಬಿನ ಬೆಟ್ಟಗಳಲ್ಲಿ ಮುಗ್ಗರಿಸುವುದಕ್ಕಿಂತ ಮುಂಚೆ","poem":2},{"lineBreak":true},{"text":"ನಿಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಮಹಿಮೆಪಡಿಸಿರಿ.","poem":2},{"text":"ನೀವು ಬೆಳಕನ್ನು ನಿರೀಕ್ಷಿಸಿದ್ದೀರಿ.","poem":1},{"text":"ಆದರೆ ಅವರು ಗಾಡಾಂಧಕಾರದ ಗುಡ್ಡಗಳನ್ನು ತಂದಾರು.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ನೀವು ಕೇಳದಿದ್ದರೆ,","poem":1},{"text":"ನನ್ನ ಆತ್ಮವು ಗುಟ್ಟಾದ ಸ್ಥಳದಲ್ಲಿ","poem":2},{"lineBreak":true},{"text":"ನಿಮ್ಮ ಗರ್ವದ ನಿಮಿತ್ತ ಗೋಳಾಡುವುದು,","poem":2},{"text":"ಯೆಹೋವ ದೇವರ ಮಂದೆಯು ಸೆರೆಯಾಗಿ ಹೋದದ್ದರಿಂದ","poem":1},{"text":"ಬಹಳವಾಗಿ ಅಳುವೆನು.","poem":2},{"lineBreak":true},{"text":"ನನ್ನ ನೇತ್ರವು ಅಶ್ರುಧಾರೆಯನ್ನು ಸುರಿಸುವುದು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ರಾಜನಿಗೂ ರಾಜಮಾತೆಗೂ ಹೀಗೆ ಹೇಳಿರಿ,","poem":1},{"text":"“ನೆಲದಲ್ಲಿ ಕೂತುಕೊಳ್ಳಿರಿ,","poem":2},{"text":"ನಿಮ್ಮ ಅಂದದ ಕಿರೀಟವು ನಿಮ್ಮ","poem":1},{"text":"ತಲೆಯಿಂದ ಕೆಳಗೆ ಬಿದ್ದಿದೆ.”","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ದಕ್ಷಿಣ ದೇಶದ ಪಟ್ಟಣಗಳು ಮುತ್ತಿಗೆಯಾಗಿವೆ,","poem":1},{"text":"ಅವುಗಳನ್ನು ಬಿಡಿಸಲು ಯಾರೂ ಇಲ್ಲ.","poem":2},{"text":"ಯೆಹೂದವೆಲ್ಲಾ ಸೆರೆಹೋಗಿದೆ,","poem":1},{"text":"ಸಂಪೂರ್ಣವಾಗಿ ಸೆರೆಯಾಗಿದೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ಚೀಯೋನೇ, ಕಣ್ಣೆತ್ತು,","poem":1},{"text":"ಉತ್ತರ ದಿಕ್ಕಿನಿಂದ ಬರುವವರನ್ನು ನೋಡು,","poem":2},{"text":"ನಿನಗೆ ಒಪ್ಪಿಸಿದ ಹಿಂಡು,","poem":1},{"text":"ನಿನ್ನ ಅಂದವಾದ ಹಿಂಡು ಎಲ್ಲಿ?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ನಿಮ್ಮ ವಿಶೇಷ ಮಿತ್ರರಾಗಿ ನೀವು ಬೆಳೆಸಿದವರನ್ನು","poem":1},{"text":"ಯೆಹೋವ ದೇವರು ನಿನಗೆ ತಲೆಯಾಗಿ ನೇಮಿಸುವಾಗ ಏನು ಹೇಳುವಿ?","poem":2},{"text":"ವೇದನೆಯು ನಿನ್ನನ್ನು ಹೆರುವವಳೋ","poem":1},{"text":"ಎಂಬಂತೆ ಹಿಡಿಯುವುದಲ್ಲವೆ?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ಒಂದು ವೇಳೆ, “ಇವು ನನಗೆ ಏಕೆ ಸಂಭವಿಸಿದವು?”","poem":1},{"text":"ಎಂದು ನೀನು ಮನದೊಳಗೆ ಅಂದುಕೊಂಡರೆ,","poem":2},{"text":"ನಿನ್ನ ನೆರಿಗೆಯು ಕೀಳಲಾಗುವುದು,","poem":1},{"text":"ನಿನ್ನ ಹಿಮ್ಮಡಿಯು ನಾಚಿಕೆಗೆ ಈಡಾದದ್ದಕ್ಕೆ","poem":2},{"lineBreak":true},{"text":"ನಿನ್ನ ಮಹಾಪಾಪವೇ ಕಾರಣ ಎಂದು ನಿನಗೆ ಗೊತ್ತಾಗುವುದು.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ಕೂಷ್ಯನು","poem":1},{"noteId":1},{"text":"ತನ್ನ ಚರ್ಮವನ್ನೂ,","poem":1},{"text":"ಚಿರತೆಯು ತನ್ನ ಮಚ್ಚೆಯನ್ನೂ ಮಾರ್ಪಡಿಸುವುದಕ್ಕಾಗುವುದೋ?","poem":2},{"text":"ಹಾಗಾದರೆ ಕೆಟ್ಟತನದ ಅಭ್ಯಾಸವುಳ್ಳವರಾದ ನೀವೂ ಸಹ","poem":1},{"text":"ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವುದಕ್ಕಾದೀತೇ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“ಅಡವಿಯ ಗಾಳಿಯಿಂದ ಹಾರಿಹೋಗುವ","poem":1},{"text":"ಹೊಟ್ಟಿನಂತೆ ಅವರನ್ನು ಚದರಿಸುವೆನು.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ಇದೇ ನಿನ್ನ ಭಾಗವು,","poem":1},{"text":"ನನ್ನಿಂದ ನಿನಗೆ ಅಳತೆ ಮಾಡಿದ ಪಾಲು,”","poem":2},{"lineBreak":true},{"text":"ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.","poem":2},{"text":"“ಏಕೆಂದರೆ ನನ್ನನ್ನು ಮರೆತುಬಿಟ್ಟು,","poem":1},{"text":"ಸುಳ್ಳು ದೇವರುಗಳಲ್ಲಿ ಭರವಸೆಯಿಟ್ಟಿದ್ದೀಯೇ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ಆದ್ದರಿಂದ ನಾನು ನಿನ್ನ ಬಟ್ಟೆಗಳನ್ನು ನಿನ್ನ ನಾಚಿಕೆ ಕಾಣುವ ಹಾಗೆ,","poem":1},{"text":"ನಿನ್ನ ಮುಖದ ಮೇಲೆ ಎತ್ತುವೆನು.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ನಾನು ನಿನ್ನ ವ್ಯಭಿಚಾರಗಳನ್ನು, ನಿನ್ನ ಕಾಮುಕತನವನ್ನು,","poem":1},{"text":"ನಿನ್ನ ಕೀಳಾದ ವೇಶ್ಯತನವನ್ನು ಗುಡ್ಡಗಳಲ್ಲಿಯೂ,","poem":2},{"text":"ಬಯಲಿನಲ್ಲಿಯೂ ನೀನು ನಡೆಸಿದ","poem":1},{"text":"ಅಸಹ್ಯ ಕಾರ್ಯಗಳನ್ನು ಕಂಡಿದ್ದೇನೆ.","poem":2},{"text":"ಯೆರೂಸಲೇಮೇ, ನಿನ್ನ ಗತಿಯನ್ನು ಏನೆಂದು ಹೇಳಲಿ!","poem":1},{"text":"ಇನ್ನೆಷ್ಟು ಕಾಲ ನೀನು ಅಶುದ್ಧಳಾಗಿರುವೆ?”","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"ಅಥವಾ ಇಥಿಯೋಪಿಯದವನು","reference":{"chapter":13,"verse":23}}]},"thisChapterLink":"/api/kan_okcv/JER/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/JER/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/JER/12.json","previousChapterAudioLinks":{},"numberOfVerses":27}