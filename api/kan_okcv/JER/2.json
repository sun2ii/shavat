{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"JER","translationId":"kan_okcv","name":"ಯೆರೆಮೀಯ","commonName":"ಯೆರೆಮೀಯ","title":"ಯೆರೆಮೀಯ","order":24,"numberOfChapters":52,"sha256":"eb4350ed3369dcdab7f6196c7d77a35a47a52ee0148c43b1fadcf96ef2c850fb","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/kan_okcv/JER/52.json","totalNumberOfVerses":1362},"chapter":{"number":2,"content":[{"type":"heading","content":["ಇಸ್ರಾಯೇಲರು ಯೆಹೋವ ದೇವರನ್ನು ತೃಣೀಕರಿಸಿದ್ದು"]},{"type":"verse","number":1,"content":["ಯೆಹೋವ ದೇವರು ನನಗೆ ದಯಪಾಲಿಸಿದ ಸಂದೇಶ ಇದು:"]},{"type":"verse","number":2,"content":["“ನೀನು ಹೋಗಿ ಯೆರೂಸಲೇಮ್ ನಗರಕ್ಕೆ ಕೇಳಿಸುವಂತೆ ಈ ಸಂದೇಶವನ್ನು ಸಾರು:",{"lineBreak":true},"“ಯೆಹೋವ ದೇವರು ಹೀಗೆನ್ನುತ್ತಾರೆ,",{"text":"“ ‘ನೀನು ಯೌವನದಲ್ಲಿ ನನ್ನ ಮೇಲಿಟ್ಟಿದ್ದ ಪ್ರೀತಿಯನ್ನು,","poem":1},{"text":"ನವವಧುವಾಗಿ ನನಗೆ ತೋರಿಸಿದ ಪ್ರೇಮವನ್ನು,","poem":2},{"text":"ಹಾಗು ಬಿತ್ತನೆ ಇಲ್ಲದ ಅರಣ್ಯ ಮಾರ್ಗವಾಗಿ ನನ್ನನ್ನು ಹಿಂಬಾಲಿಸಿದಾಗ ಅನುಸರಿಸುತ್ತಿದ್ದ","poem":1},{"text":"ನಿನ್ನ ಪಾತಿವ್ರತ್ಯವನ್ನು ನನ್ನ ನೆನಪಿನಲ್ಲಿ ಇಟ್ಟುಕೊಂಡಿದ್ದೇನೆ,","poem":2},{"lineBreak":true},{"text":"ಇದು ನಿನ್ನ ಹಿತಕ್ಕಾಗಿಯೇ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ಇಸ್ರಾಯೇಲು ಯೆಹೋವ ದೇವರಿಗೆ ಪರಿಶುದ್ಧವೂ,","poem":1},{"text":"ಆತನ ಹುಟ್ಟುವಳಿಯ ಪ್ರಥಮ ಫಲವೂ ಆಗಿದೆ","poem":2},{"text":"ಅವಳನ್ನು ತಿಂದು ಬಿಟ್ಟವರೆಲ್ಲರೂ ಅಪರಾಧಿಗಳಾಗುವರು.","poem":1},{"text":"ಅವರಿಗೆ ಕೇಡು ಬರುವುದು,’ ”","poem":2},{"lineBreak":true},{"text":"ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ಓ ಯಾಕೋಬಿನ ಮನೆತನವೇ,","poem":1},{"text":"ಇಸ್ರಾಯೇಲಿನ ಮನೆತನದ ಎಲ್ಲಾ ಕುಲಗಳೇ,","poem":2},{"lineBreak":true},{"text":"ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವನ್ನು ನೀವು ಕೇಳಿರಿ.","poem":2}]},{"type":"verse","number":5,"content":["ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ:",{"text":"“ನಿಮ್ಮ ತಂದೆಗಳು ನನಗೆ ದೂರವಾಗಿ","poem":1},{"text":"ವ್ಯರ್ಥತ್ವವನ್ನು ಹಿಂದಟ್ಟಿ,","poem":2},{"text":"ವ್ಯರ್ಥವಾಗುವ ಹಾಗೆ","poem":1},{"text":"ನನ್ನಲ್ಲಿ ಏನು ತಪ್ಪನ್ನು ಕಂಡಿದ್ದಾರೆ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ಅವರು, ‘ನಮ್ಮನ್ನು ಈಜಿಪ್ಟ್ ದೇಶದೊಳಗಿಂದ ಹೊರಗೆ ಬರಮಾಡಿ","poem":1},{"text":"ನಮ್ಮನ್ನು ಮರುಭೂಮಿಯಲ್ಲಿ ಕಾಡು ಕುಳಿಗಳು ಉಳ್ಳ ದೇಶದಲ್ಲಿ,","poem":2},{"text":"ಕ್ಷಾಮದ ಮತ್ತು ಮರಣದ ನೆರಳಾದಂಥ ದೇಶದಲ್ಲಿ,","poem":1},{"text":"ಒಬ್ಬರೂ ಹಾದುಹೋಗದೆ ಯಾರೂ ವಾಸಮಾಡದೆ ಇರುವಲ್ಲಿ ನಡೆಸಿದ ಯೆಹೋವ ದೇವರು ಎಲ್ಲಿ?’","poem":2},{"lineBreak":true},{"text":"ಎಂದು ಪ್ರಶ್ನೆ ಮಾಡಲಿಲ್ಲ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ನಾನು ನಿಮ್ಮನ್ನು ಸಮೃದ್ಧಿಯಾದ ದೇಶಕ್ಕೆ ಅದರ ಸಾರವನ್ನೂ,","poem":1},{"text":"ಮೇಲನ್ನೂ ತಿನ್ನುವ ಹಾಗೆ ಕರೆದುಕೊಂಡು ಬಂದೆನು.","poem":2},{"text":"ಆದರೆ ನೀವು ಬಂದು ನನ್ನ ದೇಶವನ್ನು ಅಶುದ್ಧಮಾಡಿ,","poem":1},{"text":"ನನ್ನ ಸೊತ್ತನ್ನು ಅಸಹ್ಯ ಮಾಡಿದಿರಿ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ಯಾಜಕರು, ‘ಯೆಹೋವ ದೇವರು ಎಲ್ಲಿ?’","poem":1},{"text":"ಎಂದು ಕೇಳಲಿಲ್ಲ.","poem":2},{"text":"ದೈವನಿಯಮವನ್ನು ಉಪದೇಶಿಸುವವರು ನನ್ನನ್ನು ತಿಳಿಯಲಿಲ್ಲ.","poem":1},{"text":"ನಾಯಕರು ನನಗೆ ವಿರೋಧವಾಗಿ ದ್ರೋಹಮಾಡಿದರು.","poem":2},{"text":"ಪ್ರವಾದಿಗಳು ಬಾಳನಿಂದ ಪ್ರವಾದಿಸಿದರು.","poem":1},{"text":"ಪ್ರಯೋಜನವಿಲ್ಲದವುಗಳನ್ನು ಹಿಂದಟ್ಟಿದರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ಆದ್ದರಿಂದ ಇನ್ನು ನಿಮ್ಮ ಸಂಗಡ ವ್ಯಾಜ್ಯವಾಡುವೆನು,”","poem":1},{"text":"ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.","poem":2},{"lineBreak":true},{"text":"“ಇದಲ್ಲದೆ ನಿಮ್ಮ ಮಕ್ಕಳ ಸಂಗಡ ವ್ಯಾಜ್ಯವಾಡುವೆನು.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ಕಿತ್ತೀಮ್ ದ್ವೀಪಗಳಿಗೆ ದಾಟಿ ಹೋಗಿ ನೋಡಿರಿ.","poem":1},{"text":"ಕೇದಾರಿಗೆ ಕಳುಹಿಸಿ ಚೆನ್ನಾಗಿ ತಿಳಿದುಕೊಳ್ಳಿರಿ.","poem":2},{"lineBreak":true},{"text":"ಅಂಥದ್ದು ಉಂಟೋ ಎಂದು ನೋಡಿರಿ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ಜನಾಂಗವು ತಮ್ಮ ದೇವರುಗಳನ್ನು","poem":1},{"text":"ಅವು ದೇವರುಗಳಲ್ಲದೆ ಇದ್ದರೂ ಬದಲು ಮಾಡಿದ್ದುಂಟೋ?","poem":2},{"text":"ಆದರೆ ನನ್ನ ಜನರು","poem":1},{"text":"ತಮ್ಮ ವೈಭವವಾದ ದೇವರನ್ನು ಪ್ರಯೋಜನವಿಲ್ಲದ್ದಕ್ಕೆ ಬದಲು ಮಾಡಿದ್ದಾರೆ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ಆಕಾಶಗಳೇ, ಇದಕ್ಕೆ ನೀವು ಆಶ್ಚರ್ಯಪಡಿರಿ,","poem":1},{"text":"ಭಯಭ್ರಾಂತಿಗೊಳ್ಳಿರಿ, ತೀರ ಹಾಳಾಗಿರಿ,”","poem":2},{"lineBreak":true},{"text":"ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“ನನ್ನ ಜನರು ಎರಡು ದುಷ್ಕೃತ್ಯಗಳನ್ನು ಮಾಡಿದ್ದಾರೆ.","poem":1},{"lineBreak":true},{"text":"ಜೀವವುಳ್ಳ ನೀರಿನ ಬುಗ್ಗೆಯಾಗಿರುವ ನನ್ನನ್ನು ಬಿಟ್ಟು,","poem":1},{"text":"ತಮಗೆ ನೀರು ಹಿಡಿಯಲಾರದ ಒಡಕ ತೊಟ್ಟಿಗಳನ್ನೂ ಕೆತ್ತಿದ್ದಾರೆ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ಇಸ್ರಾಯೇಲನು ಸೇವಕನೋ? ಮನೆಯಲ್ಲಿ ಹುಟ್ಟಿದ ಗುಲಾಮನೋ?","poem":1},{"text":"ಅವನು ಏಕೆ ಸುಲಿಗೆಯಾದನು?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ಪ್ರಾಯದ ಸಿಂಹಗಳು","poem":1},{"text":"ಅವನಿಗೆ ವಿರೋಧವಾಗಿ ಗರ್ಜಿಸಿ, ಅಬ್ಬರಿಸುತ್ತವೆ.","poem":2},{"text":"ಅವನ ದೇಶವನ್ನು ಹಾಳು ಮಾಡುತ್ತವೆ.","poem":1},{"text":"ಅವನ ಪಟ್ಟಣಗಳು ನಿವಾಸವಿಲ್ಲದೆ ಸುಟ್ಟುಹೋಗಿವೆ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ನೋಫ್ ಮತ್ತು ತಹಪನೇಸ್ ಪಟ್ಟಣಗಳವರು","poem":1},{"text":"ನಿನ್ನ ನೆತ್ತಿಯನ್ನೂ ನುಣ್ಣಗೆ ಮೇದುಬಿಟ್ಟಿದ್ದಾರೆ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ಆತನು ನಿನ್ನನ್ನು ದಾರಿಯಲ್ಲಿ ನಡೆಸುತ್ತಿರುವಾಗ","poem":1},{"text":"ನೀನು ನಿನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಬಿಟ್ಟಿದ್ದರಿಂದಲೇ","poem":2},{"lineBreak":true},{"text":"ಇದನ್ನು ನಿನಗೆ ನೀನೇ ಮಾಡಿಕೊಂಡೆಯಲ್ಲವೋ?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ಈಗ ಶೀಹೋರಿನ ನೀರು ಕುಡಿಯುವುದಕ್ಕಾಗಿ","poem":1},{"text":"ಈಜಿಪ್ಟಿನ ದಾರಿಯಲ್ಲಿ ನಿನಗೇನು ಕೆಲಸ?","poem":2},{"text":"ಯೂಫ್ರೇಟೀಸ್ ನದಿಯ ನೀರು ಕುಡಿಯುವುದಕ್ಕಾಗಿ","poem":1},{"text":"ಅಸ್ಸೀರಿಯದ ದಾರಿಯಲ್ಲಿ ನಿನಗೇನು ಕೆಲಸ?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ನಿನ್ನ ಕೆಟ್ಟತನವೇ ನಿನ್ನನ್ನು ತಿದ್ದುವುದು.","poem":1},{"text":"ನಿನ್ನ ಹಿಂಜಾರಿಕೆಗಳೇ ನಿನ್ನನ್ನು ಗದರಿಸುವುದು.","poem":2},{"text":"ಹೀಗಿರುವುದರಿಂದ ನೀನು","poem":1},{"text":"ನಿನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರನ್ನು ಬಿಟ್ಟದ್ದೂ,","poem":2},{"text":"ನನ್ನ ಭಯವು ನಿನ್ನಲ್ಲಿ ಇಲ್ಲದಿರುವುದೂ,","poem":1},{"text":"ಕೆಟ್ಟದ್ದೂ, ಕಹಿಯಾದದ್ದೂ ಎಂದು ತಿಳಿದುಕೊಂಡು ನೋಡು,”","poem":2},{"lineBreak":true},{"text":"ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“ಪೂರ್ವದಲ್ಲಿ ನಾನು ನಿನ್ನ ನೊಗವನ್ನು ಮುರಿದು,","poem":1},{"text":"ನಿನ್ನ ಬಂಧನಗಳನ್ನು ಹರಿದುಬಿಟ್ಟೆನು.","poem":2},{"lineBreak":true},{"text":"ಆದರೆ, ‘ನಾನು ಸೇವೆಮಾಡುವುದಿಲ್ಲ!’ ಎಂದು ನೀನು ಹೇಳಿದೆ.","poem":2},{"text":"ಒಂದೊಂದು ಎತ್ತರವಾದ ಗುಡ್ಡದ ಮೇಲೆಯೂ,","poem":1},{"text":"ಒಂದೊಂದು ಹಸುರಾದ ಮರದ ಕೆಳಗೂ","poem":2},{"lineBreak":true},{"text":"ನೀನು ವೇಶ್ಯೆಯಾಗಿ ನಡೆದಿದ್ದೀ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ಅತ್ಯುತ್ತಮ ಬೀಜದಿಂದ ಬೆಳೆದ","poem":1},{"text":"ಉತ್ಕೃಷ್ಟ ದ್ರಾಕ್ಷಾಲತೆಯನ್ನಾಗಿ ನಿನ್ನನ್ನು ನೆಟ್ಟಿದೆ.","poem":2},{"text":"ಆದರೆ ನೀನು ಕಾಡುದ್ರಾಕ್ಷಿಬಳ್ಳಿಯ","poem":1},{"text":"ಹಾಳು ರೆಂಬೆಗಳಾದದ್ದು ಹೇಗೆ?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ನೀನು ಸಾಬೂನಿನಿಂದ ತೊಳೆದುಕೊಂಡರೂ,","poem":1},{"text":"ಬಹಳ ಸಾಬೂನು ಹಾಕಿಕೊಂಡರೂ","poem":2},{"lineBreak":true},{"text":"ನಿನ್ನ ಅಕ್ರಮವು ನನ್ನ ಮುಂದೆ ಕಳಂಕವಾಗಿದೆ,”","poem":2},{"lineBreak":true},{"text":"ಎಂದು ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"“ಇದಲ್ಲದೆ ನೀನು, ‘ನಾನು ಅಶುದ್ಧನಲ್ಲ,","poem":1},{"text":"ಬಾಳನನ್ನು ಹಿಂಬಾಲಿಸಲಿಲ್ಲ,’ ಎಂದು ಹೇಳುವುದು ಹೇಗೆ?","poem":2},{"text":"ತಗ್ಗಿನಲ್ಲಿ ನಿನ್ನ ಮಾರ್ಗವನ್ನು ನೋಡು.","poem":1},{"text":"ನೀನು ಮಾಡಿದ್ದನ್ನು ತಿಳಿದುಕೋ.","poem":2},{"text":"ನೀನು ತೀವ್ರವಾಗಿ ಸಂಚಾರ ಮಾಡುವ","poem":1},{"text":"ಹೆಣ್ಣು ಒಂಟೆಯೇ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ಮರುಭೂಮಿಯ ಅಭ್ಯಾಸವುಳ್ಳ ಕಾಡುಕತ್ತೆಯೇ.","poem":1},{"text":"ಅವಳ ಅತ್ಯಾಶೆಯಲ್ಲಿ ಗಾಳಿಯನ್ನು ಹೀರಿಕೊಳ್ಳುತ್ತಾಳೆ.","poem":2},{"lineBreak":true},{"text":"ಅವಳ ಮದವನ್ನು ಯಾರು ತಡೆಯುವರು?","poem":2},{"text":"ಅವಳನ್ನು ಹುಡುಕುವವರೆಲ್ಲರೂ ಆಯಾಸ ಪಡುವುದಿಲ್ಲ.","poem":1},{"text":"ಅವಳ ಸಂಗಮಿಸುವ ಋತುಗಳಲ್ಲಿ ಅವಳನ್ನು ಕಾಣುವರು.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ಆದರೆ ನಾನು, ‘ನಿನ್ನ ಕಾಲು ಸವೆಯದಂತೆಯೂ,","poem":1},{"text":"ನಿನ್ನ ಗಂಟಲು ಆರದಂತೆಯೂ ತಡೆದುಕೋ,’ ಎಂದೆನು.","poem":2},{"text":"ಆದರೆ ನೀನು, ‘ಇಲ್ಲ, ನಿರೀಕ್ಷೆ ಇಲ್ಲ,","poem":1},{"text":"ನಾನು ಅನ್ಯದೇವರುಗಳನ್ನು ಪ್ರೀತಿಸುತ್ತೇನೆ,","poem":2},{"lineBreak":true},{"text":"ಅವುಗಳ ಹಿಂದೆ ನಾನು ಹೋಗುತ್ತೇನೆ,’ ಎಂದು ಹೇಳಿದೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“ಕಳ್ಳನು ಸಿಕ್ಕಿದ ಮೇಲೆ ನಾಚಿಕೆಪಡುವ ಪ್ರಕಾರ","poem":1},{"text":"ಇಸ್ರಾಯೇಲ್ ಜನರಿಗೆ ನಾಚಿಕೆ ಆಯಿತು.","poem":2},{"text":"ಅವರ ಅರಸರು, ಅಧಿಪತಿಗಳು,","poem":1},{"text":"ಯಾಜಕರು, ಪ್ರವಾದಿಗಳು, ಇವರೆಲ್ಲರೂ ನಾಚಿಕೆಗೆ ಈಡಾಗುವರು.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ಅವರು ಮರಕ್ಕೆ, ‘ನೀನು ನನ್ನ ತಂದೆ,’ ಎಂದೂ","poem":1},{"text":"ಕಲ್ಲಿಗೆ, ‘ನೀನು ನನ್ನನ್ನು ಹೆತ್ತಿದ್ದೀ,’ ಎಂದೂ ಹೇಳುತ್ತಾರಲ್ಲಾ.","poem":2},{"text":"ಏಕೆಂದರೆ ಅವರು ನನಗೆ ಮುಖವನ್ನಲ್ಲ ಬೆನ್ನನ್ನು ತಿರುಗಿಸಿದ್ದಾರೆ.","poem":1},{"text":"ಆದರೂ ಅವರ ಕಷ್ಟಕಾಲದಲ್ಲಿ ಎದ್ದು,","poem":2},{"lineBreak":true},{"text":"‘ನಮ್ಮನ್ನು ರಕ್ಷಿಸು,’ ಎಂದು ಮೊರೆಯಿಡುವರು.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ಆದರೆ ನೀನು ನಿನಗೋಸ್ಕರ ಮಾಡಿಕೊಂಡ","poem":1},{"text":"ನಿನ್ನ ದೇವರುಗಳು ಎಲ್ಲಿ?","poem":2},{"lineBreak":true},{"text":"ನಿನ್ನ ಕಷ್ಟಕಾಲದಲ್ಲಿ ನಿನ್ನನ್ನು ರಕ್ಷಿಸಲು ಸಾಧ್ಯವಾದರೆ ಅವರೇ ಏಳಲಿ,","poem":2},{"text":"ಓ ಯೆಹೂದವೇ, ನಿನ್ನ ಪಟ್ಟಣಗಳ ಲೆಕ್ಕದ ಹಾಗೆ","poem":1},{"text":"ನಿನ್ನ ದೇವರುಗಳು ಇದ್ದಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“ಏಕೆ ನನ್ನ ಸಂಗಡ ವಾದಿಸುತ್ತೀರಿ?","poem":1},{"text":"ನೀವೆಲ್ಲರೂ ನನಗೆ ವಿರೋಧವಾಗಿ ದ್ರೋಹ ಮಾಡಿದ್ದೀರಿ,”","poem":2},{"lineBreak":true},{"text":"ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"“ನಾನು ನಿಮ್ಮ ಜನರನ್ನು ದಂಡಿಸಿದ್ದು ವ್ಯರ್ಥವಾಯಿತು.","poem":1},{"text":"ಅವರು ಶಿಕ್ಷೆಯನ್ನು ತೆಗೆದುಕೊಳ್ಳಲಿಲ್ಲ.","poem":2},{"text":"ನಿಮ್ಮ ಸ್ವಂತ ಖಡ್ಗವು ನಾಶಮಾಡುವ ಸಿಂಹದಂತೆ","poem":1},{"text":"ನಿಮ್ಮ ಪ್ರವಾದಿಗಳನ್ನು ನುಂಗಿಬಿಟ್ಟಿವೆ.","poem":2}]},{"type":"verse","number":31,"content":["“ಇಸ್ರಾಯೇಲರೇ, ನೀವು ಯೆಹೋವ ದೇವರ ವಾಕ್ಯವನ್ನು ಗಮನಿಸಿರಿ:",{"text":"“ನಾನು ಇಸ್ರಾಯೇಲಿನ ಮರುಭೂಮಿಯಾದೆನೋ?","poem":1},{"text":"ಗಾಡಾಂಧಕಾರದ ದೇಶವಾದೆನೋ?","poem":2},{"text":"ನನ್ನ ಜನರು, ‘ನಾವು ಮನಬಂದಂತೆ ನಡೆದುಕೊಳ್ಳುತ್ತೇವೆ,","poem":1},{"text":"ನಾವು ಇನ್ನು ಮೇಲೆ ನಿನ್ನ ಬಳಿಗೆ ಎಂದೂ ಬರುವುದಿಲ್ಲ,’","poem":2},{"lineBreak":true},{"text":"ಎಂದು ಹೇಳುವುದು ಹೇಗೆ?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ಯುವತಿಯು ತನ್ನ ಆಭರಣಗಳನ್ನೂ","poem":1},{"text":"ಇಲ್ಲವೆ ಮದಲಗಿತ್ತಿ ತನ್ನ ಒಡ್ಯಾಣವನ್ನು ಮರೆತುಬಿಡುವಳೋ?","poem":2},{"text":"ಆದರೂ ನನ್ನ ಜನರು ಲೆಕ್ಕವಿಲ್ಲದಷ್ಟು ದಿನಗಳು","poem":1},{"text":"ನನ್ನನ್ನು ಮರೆತುಬಿಟ್ಟಿದ್ದಾರೆ.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ಪ್ರಿಯಕರರನ್ನು ಹುಡುಕುವ ಹಾಗೆ ನಿನ್ನ ಮಾರ್ಗವನ್ನು ಏಕೆ ಚಂದ ಮಾಡಿಕೊಳ್ಳುತ್ತೀ?","poem":1},{"text":"ಇದರಿಂದ ಕೆಟ್ಟ ಹೆಂಗಸರಿಗೂ ನಿನ್ನ ಮಾರ್ಗವನ್ನು ಕಲಿಸಿದ್ದೀ.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ಇದಲ್ಲದೆ ನಿನ್ನ ಸೆರಗುಗಳಲ್ಲಿ","poem":1},{"text":"ಅಪರಾಧವಿಲ್ಲದ ಬಡವರ ರಕ್ತವು ಸಿಕ್ಕಿದೆ.","poem":2},{"lineBreak":true},{"text":"ಅಂತರಂಗದ ಶೋಧನೆಯಿಂದಲ್ಲ,","poem":2},{"text":"ಆದರೆ ಇವರೆಲ್ಲರ ಮೇಲೆಯೇ ಅದನ್ನು ಕಂಡಿದ್ದೀ.","poem":1}]},{"type":"verse","number":35,"content":[{"text":"ಆದರೂ ನೀನು, ‘ನಾನು ನಿರಪರಾಧಿಯಾಗಿರುವ ಕಾರಣ","poem":2},{"lineBreak":true},{"text":"ನಿಶ್ಚಯವಾಗಿ ದೇವರ ಕೋಪವು ನನ್ನನ್ನು ಬಿಟ್ಟು ತಿರುಗುವುದು,’ ಎಂದು ಹೇಳುತ್ತೀ.","poem":2},{"text":"ನೀನು, ‘ನಾನು ಪಾಪಮಾಡಲಿಲ್ಲ’ ಎಂದು ಹೇಳುವುದರಿಂದ ಇಗೋ,","poem":1},{"text":"ನಾನು ನಿನಗೆ ನ್ಯಾಯತೀರಿಸುವೆನು.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ನಿನ್ನ ಮಾರ್ಗವನ್ನು ಬೇರೆ ಮಾಡಿಕೊಳ್ಳುವಷ್ಟು","poem":1},{"text":"ಏಕೆ ಬಹಳವಾಗಿ ತಿರುಗಾಡುತ್ತೀ?","poem":2},{"text":"ಅಸ್ಸೀರಿಯದ ನಿಮಿತ್ತ ನಾಚಿಕೆ ಪಟ್ಟ ಹಾಗೆ","poem":1},{"text":"ಈಜಿಪ್ಟಿನ ನಿಮಿತ್ತವೂ ನಾಚಿಕೆಪಡುವೆ.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"ಹೌದು, ಅಲ್ಲಿಂದ ಸಹ ನಿನ್ನ ಕೈಗಳನ್ನು ತಲೆಯ ಮೇಲೆ","poem":1},{"text":"ಇಟ್ಟುಕೊಂಡು ಹೊರಟು ಹೋಗುವೆ.","poem":2},{"text":"ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ನೀನು ಭರವಸೆ ಇಟ್ಟವುಗಳನ್ನು ತಿರಸ್ಕರಿಸಿದ್ದಾರೆ,","poem":1},{"text":"ಅವುಗಳ ಮುಖಾಂತರ ನಿನ್ನ ಕಾರ್ಯ ಸಫಲವಾಗುವುದಿಲ್ಲ.”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/kan_okcv/JER/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/JER/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/JER/1.json","previousChapterAudioLinks":{},"numberOfVerses":37}