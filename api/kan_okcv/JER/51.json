{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"JER","translationId":"kan_okcv","name":"ಯೆರೆಮೀಯ","commonName":"ಯೆರೆಮೀಯ","title":"ಯೆರೆಮೀಯ","order":24,"numberOfChapters":52,"sha256":"eb4350ed3369dcdab7f6196c7d77a35a47a52ee0148c43b1fadcf96ef2c850fb","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/kan_okcv/JER/52.json","totalNumberOfVerses":1362},"chapter":{"number":51,"content":[{"type":"verse","number":1,"content":["ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ,",{"text":"“ಇಗೋ, ನಾನು ಬಾಬಿಲೋನಿಗೆ ವಿರೋಧವಾಗಿಯೂ,","poem":1},{"text":"ನನಗೆದುರಾಗಿ ಎದ್ದಿರುವ ಲೇಬ್ ಕಾಮೈ","poem":2},{"noteId":13},{"text":"ಪ್ರಜೆಗಳ ವಿರೋಧವಾಗಿಯೂ ನಾಶಕಾರಿಯಾದ ಗಾಳಿಬೀಸುವಂತೆ ಮಾಡುವೆನು.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ವಿದೇಶಿಯರನ್ನು ಬಾಬಿಲೋನಿಗೆ ಕಳುಹಿಸುವೆನು;","poem":1},{"text":"ಅವರು ಅದನ್ನು ತೂರಿ ಅದರ ದೇಶವನ್ನು ಬರಿದು ಮಾಡುವರು;","poem":2},{"text":"ಏಕೆಂದರೆ ದುರ್ದಿನದಲ್ಲಿ ಸುತ್ತಲಾಗಿ","poem":1},{"text":"ಅದಕ್ಕೆ ವಿರೋಧವಾಗಿರುವರು.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ಬಿಲ್ಲು ಬಗ್ಗಿಸುವವನಿಗೆ ವಿರೋಧವಾಗಿಯೂ,","poem":1},{"text":"ಕವಚದಲ್ಲಿ ತನ್ನನ್ನು ಹೆಚ್ಚಿಸಿಕೊಳ್ಳುವವನಿಗೆ ವಿರೋಧವಾಗಿಯೂ","poem":2},{"lineBreak":true},{"text":"ಬಿಲ್ಲಿನವನು ತನ್ನ ಬಿಲ್ಲನ್ನು ಬಗ್ಗಿಸಲಿ;","poem":2},{"text":"ಅದರ ಯೌವನಸ್ಥರನ್ನು ಕನಿಕರಿಸಬೇಡಿರಿ;","poem":1},{"text":"ಅದರ ಸೈನ್ಯವನ್ನೆಲ್ಲಾ ಸಂಪೂರ್ಣವಾಗಿ ನಾಶಮಾಡಿರಿ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ಈ ಪ್ರಕಾರ ಬಾಬಿಲೋನಿಯರ ದೇಶದಲ್ಲಿ ಹತರಾಗಿ ಬೀಳುವರು.","poem":1},{"text":"ಅದರ ಬೀದಿಗಳಲ್ಲಿಯೇ ಕತ್ತಿಗೆ ತುತ್ತಾಗುವರು.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ಏಕೆಂದರೆ ಅವರ ದೇಶವು ಇಸ್ರಾಯೇಲಿನ","poem":1},{"text":"ಪರಿಶುದ್ಧನಿಗೆ ವಿರೋಧವಾದ ಪಾಪದಿಂದ ತುಂಬಿದ್ದಾಗ್ಯೂ","poem":2},{"text":"ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು","poem":1},{"text":"ಇಸ್ರಾಯೇಲನ್ನಾಗಲಿ, ಯೆಹೂದವನ್ನಾಗಲಿ ಕೈಬಿಡಲಿಲ್ಲ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“ಬಾಬಿಲೋನಿನೊಳಗಿಂದ ಓಡಿಹೋಗಿರಿ;","poem":1},{"text":"ಒಬ್ಬೊಬ್ಬನು ತನ್ನ ತನ್ನ ಪ್ರಾಣವನ್ನು ತಪ್ಪಿಸಿಕೊಳ್ಳಲಿ;","poem":2},{"lineBreak":true},{"text":"ಅದರ ಪಾಪದಲ್ಲಿ ನಾಶವಾಗಬೇಡಿರಿ;","poem":2},{"text":"ಏಕೆಂದರೆ ಇದು ಯೆಹೋವ ದೇವರ ಪ್ರತಿದಂಡನೆಯ ಕಾಲವು;","poem":1},{"text":"ಆತನೇ ಅದಕ್ಕೆ ಮುಯ್ಯಿಗೆ ಮುಯ್ಯಿ ಕೊಡುತ್ತಾನೆ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ಬಾಬಿಲೋನ್ ಯೆಹೋವ ದೇವರ ಕೈಯಲ್ಲಿ ಭೂಮಿಗೆಲ್ಲಾ","poem":1},{"text":"ಅಮಲೇರಿಸಿದ ಚಿನ್ನದ ಪಾತ್ರೆಯಾಗಿತ್ತು;","poem":2},{"text":"ಜನಾಂಗಗಳು ಅದರ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಕುಡಿದವು;","poem":1},{"text":"ಆದ್ದರಿಂದ ಜನಾಂಗಗಳು ಹುಚ್ಚರಾದರು.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ಇದ್ದಕ್ಕಿದ್ದ ಹಾಗೆ ಬಾಬಿಲೋನ್ ಬಿದ್ದು ಹಾಳಾಗಿದೆ;","poem":1},{"text":"ಅದರ ವಿಷಯ ಗೋಳಾಡಿರಿ;","poem":2},{"text":"ಅದರ ನೋವಿಗೆ ತೈಲ ತೆಗೆದುಕೊಳ್ಳಿರಿ;","poem":1},{"text":"ಒಂದು ವೇಳೆ ವಾಸಿಯಾದೀತು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ ‘ನಾವು ಬಾಬಿಲೋನನ್ನು ವಾಸಿಮಾಡಲು ಪ್ರಯತ್ನಿಸಿದೆವು;","poem":1},{"text":"ಆದರೆ ಅದು ವಾಸಿಯಾಗಲಿಲ್ಲ;","poem":2},{"text":"ಅದನ್ನು ಬಿಡು, ನಮ್ಮ ಸ್ವಂತ ದೇಶಗಳಿಗೆ ಹೋಗೋಣ;","poem":1},{"text":"ಅದರ ನ್ಯಾಯ ತೀರ್ವಿಕೆಯು ಆಕಾಶಗಳಿಗೆ ಮುಟ್ಟುತ್ತದೆ;","poem":2},{"lineBreak":true},{"text":"ಆಕಾಶಗಳವರೆಗೂ ಏರುತ್ತದೆ.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘ಯೆಹೋವ ದೇವರು ನಮ್ಮ ನೀತಿಯನ್ನು ಹೊರಗೆ ತಂದಿದ್ದಾರೆ;","poem":1},{"text":"ಬನ್ನಿ, ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರ ಕ್ರಿಯೆಯನ್ನು","poem":2},{"lineBreak":true},{"text":"ಚೀಯೋನಿನಲ್ಲಿ ಸಾರಿ ಹೇಳೋಣ.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“ಬಾಣಗಳನ್ನು ಮೆರುಗು ಮಾಡಿರಿ;","poem":1},{"text":"ಡಾಲುಗಳನ್ನು ಎತ್ತಿಕೊಳ್ಳಿರಿ,","poem":2},{"text":"ಯೆಹೋವ ದೇವರು ಮೇದ್ಯರ ಅರಸರ ಆತ್ಮವನ್ನು ಎಬ್ಬಿಸಿದ್ದಾರೆ;","poem":1},{"text":"ಆತನ ಆಲೋಚನೆ ಬಾಬಿಲೋನಿಗೆ ವಿರೋಧವಾಗಿ ಅದನ್ನು ನಾಶಮಾಡುವುದಕ್ಕೆ ಇದೆ.","poem":2},{"text":"ಏಕೆಂದರೆ ಇದು ಯೆಹೋವ ದೇವರ ಪ್ರತಿದಂಡನೆಯು,","poem":1},{"text":"ಅವರ ದೇವಾಲಯದ ಪ್ರತಿದಂಡನೆಯಾಗಿದೆ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ಬಾಬಿಲೋನಿನ ಗೋಡೆಯ ಮೇಲೆ ಧ್ವಜವನ್ನೆತ್ತಿರಿ;","poem":1},{"text":"ಪಹರೆಯನ್ನು ಬಲಪಡಿಸಿರಿ;","poem":2},{"text":"ಕಾವಲುಗಾರರನ್ನು ನಿಲ್ಲಿಸಿರಿ;","poem":1},{"text":"ಹೊಂಚಿಕೊಳ್ಳುವವರನ್ನು ಸಿದ್ಧಮಾಡಿರಿ;","poem":2},{"text":"ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ಬಾಬಿಲೋನಿನ ನಿವಾಸಿಗಳಿಗೆ ವಿರೋಧವಾಗಿ","poem":1},{"text":"ತಾನು ಹೇಳಿದ್ದನ್ನು ಯೋಚಿಸಿದ್ದನ್ನು ಮಾಡಿದ್ದಾರೆ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ಅನೇಕ ನೀರುಗಳ ಬಳಿಯಲ್ಲಿ ವಾಸವಾಗಿರುವವಳೇ,","poem":1},{"text":"ಬಹಳ ದ್ರವ್ಯಗಳುಳ್ಳವಳೇ,","poem":2},{"text":"ನಿನ್ನ ಅಂತ್ಯವೂ,","poem":1},{"text":"ನಿನ್ನ ನಾಶನದ ಕಾಲವು ಬಂತು.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಮೇಲೆ ಆಣೆಯಿಟ್ಟು:","poem":1},{"text":"ನಿಶ್ಚಯವಾಗಿ ನಾನು ಮಿಡತೆಗಳಷ್ಟು ಅಸಂಖ್ಯ ಜನರಿಂದ ನಿನ್ನನ್ನು ತುಂಬಿಸುತ್ತೇನೆಂದು","poem":2},{"lineBreak":true},{"text":"ಅವರು ನಿನಗೆ ವಿರೋಧವಾಗಿ ಆರ್ಭಟವನ್ನು ಎತ್ತುವರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“ಅವರು ತಮ್ಮ ಶಕ್ತಿಯಿಂದ ಭೂಮಿಯನ್ನು ಸೃಷ್ಟಿಸಿ,","poem":1},{"text":"ತಮ್ಮ ಜ್ಞಾನದಿಂದ ಲೋಕವನ್ನು ಸ್ಥಾಪಿಸಿ,","poem":2},{"lineBreak":true},{"text":"ತಮ್ಮ ವಿವೇಕದಿಂದ ಆಕಾಶವನ್ನು ವಿಸ್ತರಿಸಿದ್ದಾರೆ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ಅವರ ಗರ್ಜನೆಗೆ ಆಕಾಶದಲ್ಲಿನ ನೀರು ಭೋರ್ಗರೆಯುತ್ತದೆ,","poem":1},{"text":"ಅವರು ಭೂಮಿಯ ಕಟ್ಟಕಡೆಗಳಿಂದ ಮೋಡಗಳನ್ನು ಏಳುವಂತೆ ಮಾಡುತ್ತಾರೆ.","poem":2},{"text":"ಮಳೆಗೋಸ್ಕರ ಮಿಂಚನ್ನು ಉಂಟುಮಾಡುತ್ತಾರೆ;","poem":1},{"text":"ತಮ್ಮ ಭಂಡಾರದಿಂದ ಗಾಳಿಯನ್ನು ಬೀಸಮಾಡುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“ಪ್ರತಿ ಮನುಷ್ಯನು ತಿಳುವಳಿಕೆ ಇಲ್ಲದವನೂ ಬುದ್ಧಿಹೀನನೂ ಆಗಿದ್ದಾನೆ;","poem":1},{"text":"ತಾನು ಕೆತ್ತಿದ ವಿಗ್ರಹಕ್ಕೋಸ್ಕರ ಪ್ರತಿಯೊಬ್ಬ ಅಕ್ಕಸಾಲಿಗನೂ ನಾಚಿಕೆಪಡುತ್ತಾನೆ;","poem":2},{"text":"ಏಕೆಂದರೆ ಅವರ ಎರಕದ ವಿಗ್ರಹಗಳು ಸುಳ್ಳೇ;","poem":1},{"text":"ಅವುಗಳಲ್ಲಿ ಉಸಿರೇ ಇಲ್ಲ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ಅವು ವ್ಯರ್ಥ, ಹಾಸ್ಯಾಸ್ಪದದ ಕೆಲಸ;","poem":1},{"text":"ಅವುಗಳ ದಂಡನೆಯ ಕಾಲದಲ್ಲಿ ಅವು ನಾಶವಾಗುವುವು.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ಯಾಕೋಬ್ಯರ ಪಾಲಾಗಿರುವವರು ಇವುಗಳ ಹಾಗಲ್ಲ;","poem":1},{"text":"ಏಕೆಂದರೆ ಅವರು ಎಲ್ಲವನ್ನು ರೂಪಿಸಿದವರೇ,","poem":2},{"text":"ಇಸ್ರಾಯೇಲ್ ಅವರ ಸ್ವಾಸ್ತ್ಯವಾದ ವಂಶ.","poem":1},{"text":"ಅವರ ಹೆಸರು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರೇ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“ನೀನು ನನ್ನ ಗದೆಯೂ,","poem":1},{"text":"ನನ್ನ ಯುದ್ಧದ ಆಯುಧಗಳೇ,","poem":2},{"text":"ನಿನ್ನಿಂದ ಜನಾಂಗಗಳನ್ನು ಚೂರುಚೂರಾಗಿ ಒಡೆದು ಬಿಡುತ್ತೇನೆ,","poem":1},{"text":"ನಿನ್ನಿಂದ ರಾಜ್ಯಗಳನ್ನು ನಾಶಮಾಡುತ್ತೇನೆ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ನಿನ್ನಿಂದ ಕುದುರೆಯನ್ನೂ, ಅದರ ಮೇಲೆ ಹತ್ತಿದವನನ್ನೂ ಚೂರುಚೂರಾಗಿ ಒಡೆದು ಬಿಡುತ್ತೇನೆ;","poem":1},{"text":"ನಿನ್ನಿಂದ ರಥವನ್ನೂ, ಅದರಲ್ಲಿ ಸವಾರಿ ಮಾಡುವವನನ್ನೂ ಚೂರುಚೂರಾಗಿ ಒಡೆದು ಬಿಡುತ್ತೇನೆ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ನಿನ್ನಿಂದ ಗಂಡಸರನ್ನೂ, ಹೆಂಗಸರನ್ನೂ ಚೂರುಚೂರಾಗಿ ಒಡೆದು ಬಿಡುತ್ತೇನೆ;","poem":1},{"text":"ನಿನ್ನಿಂದ ಹಿರಿಯರನ್ನೂ, ಕಿರಿಯರನ್ನೂ ಚೂರುಚೂರಾಗಿ ಒಡೆದು ಬಿಡುತ್ತೇನೆ;","poem":2},{"lineBreak":true},{"text":"ನಿನ್ನಿಂದ ಯುವಕನನ್ನೂ ಯುವತಿಯನ್ನೂ ಚೂರುಚೂರಾಗಿ ಒಡೆದು ಬಿಡುತ್ತೇನೆ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ನಿನ್ನಿಂದ ಕುರುಬನನ್ನೂ ಅವನ ಮಂದೆಯನ್ನೂ ಚೂರುಚೂರಾಗಿ ಒಡೆದು ಬಿಡುತ್ತೇನೆ;","poem":1},{"text":"ನಿನ್ನಿಂದ ಒಕ್ಕಲಿಗನನ್ನೂ ಅವನ ನೊಗದ ಎತ್ತುಗಳನ್ನೂ ಚೂರುಚೂರಾಗಿ ಒಡೆದು ಬಿಡುತ್ತೇನೆ;","poem":2},{"lineBreak":true},{"text":"ನಿನ್ನಿಂದ ಅಧಿಪತಿಗಳನ್ನೂ ಅಧಿಕಾರಿಗಳನ್ನೂ ಚೂರುಚೂರಾಗಿ ಒಡೆದು ಬಿಡುತ್ತೇನೆ.","poem":2}]},{"type":"verse","number":24,"content":["“ಬಾಬಿಲೋನಿನವರು ಮತ್ತು ಕಸ್ದೀಯರು ಚೀಯೋನಿನಲ್ಲಿ ಮಾಡಿದ ಎಲ್ಲಾ ಕೇಡಿಗೆ ಪ್ರತಿಯಾಗಿ ನಾನು ಅವರೆಲ್ಲರಿಗೂ ಚೀಯೋನಿನವರ ಕಣ್ಣೆದುರಿಗೆ ಮುಯ್ಯಿತೀರಿಸುವೆನು” ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ."]},{"type":"verse","number":25,"content":[{"text":"“ಲೋಕವನ್ನೆಲ್ಲಾ ನಾಶಮಾಡುವ ನಾಶಕ ಪರ್ವತವೇ,","poem":1},{"text":"ಇಗೋ, ನಾನು ನಿನಗೆ ವಿರೋಧವಾಗಿದ್ದೇನೆ”","poem":2},{"lineBreak":true},{"text":"ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.","poem":2},{"text":"“ನಿನ್ನ ಮೇಲೆ ನನ್ನ ಕೈಯನ್ನು ಚಾಚಿ,","poem":1},{"text":"ಬಂಡೆಗಳ ಮೇಲಿನಿಂದ ನಿನ್ನನ್ನು ಹೊರಳಿಸಿ,","poem":2},{"lineBreak":true},{"text":"ನಿನ್ನನ್ನು ಸುಟ್ಟ ಬೆಟ್ಟವಾಗಿ ಮಾಡುತ್ತೇನೆ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ಒಬ್ಬರೂ ನಿನ್ನಿಂದ ಮೂಲೆಯ ಕಲ್ಲನ್ನಾಗಲಿ,","poem":1},{"text":"ಅಸ್ತಿವಾರದ ಕಲ್ಲನ್ನಾಗಲಿ ತೆಗೆಯರು.","poem":2},{"lineBreak":true},{"text":"ನೀನು ಎಂದೆಂದಿಗೂ ಹಾಳಾಗುವೆ,”","poem":2},{"lineBreak":true},{"text":"ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“ದೇಶದಲ್ಲಿ ಧ್ವಜವನ್ನೆತ್ತಿರಿ;","poem":1},{"text":"ಜನಾಂಗಗಳಲ್ಲಿ ತುತೂರಿಯನ್ನೂದಿರಿ;","poem":2},{"text":"ಅದಕ್ಕೆ ವಿರೋಧವಾಗಿ ಜನಾಂಗಗಳನ್ನು ಸಿದ್ಧಮಾಡಿರಿ;","poem":1},{"text":"ಅರಾರಾಟ್, ಮಿನ್ನಿ, ಅಷ್ಕೆನಜ್ ರಾಜ್ಯಗಳನ್ನು","poem":2},{"lineBreak":true},{"text":"ಅದಕ್ಕೆ ವಿರೋಧವಾಗಿ ಕರೆಯಿರಿ;","poem":2},{"text":"ಅದಕ್ಕೆ ವಿರೋಧವಾಗಿ ಸೈನ್ಯಾಧಿಪತಿಯನ್ನು ನೇಮಿಸಿರಿ;","poem":1},{"text":"ಬಿರುಸಾದ ಮಿಡತೆ ದಂಡಿನಂತೆ ಕುದುರೆಗಳನ್ನು ಬರಮಾಡಿರಿ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ಅದಕ್ಕೆ ವಿರೋಧವಾಗಿ ಜನಾಂಗಗಳನ್ನೂ,","poem":1},{"text":"ಮೇದ್ಯರ ಅರಸರನ್ನೂ,","poem":2},{"text":"ಅದರ ಅಧಿಪತಿಗಳನ್ನೂ, ಅಧಿಕಾರಿಗಳನ್ನೂ,","poem":1},{"text":"ಅವನ ರಾಜ್ಯದ ದೇಶವನ್ನೆಲ್ಲಾ ಸಿದ್ಧಮಾಡಿರಿ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ಆಗ ದೇಶವು ನೊಂದು ನಡುಗುವುದು.","poem":1},{"text":"ಏಕೆಂದರೆ ಬಾಬಿಲೋನ್ ದೇಶವು","poem":2},{"text":"ನಿರ್ಜನವಾಗಲಿ ಎಂದು ಅದರ ವಿರೋಧವಾಗಿ","poem":1},{"text":"ಯೆಹೋವ ದೇವರ ಉದ್ದೇಶಗಳು ಸ್ಥಿರವಾಗಿವೆ.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ಬಾಬಿಲೋನಿನ ಪರಾಕ್ರಮಶಾಲಿಗಳು ಯುದ್ಧಮಾಡುವುದನ್ನು ಬಿಟ್ಟಿದ್ದಾರೆ;","poem":1},{"text":"ಅವರ ಭದ್ರಸ್ಥಾನಗಳಲ್ಲಿ ನಿಂತಿದ್ದಾರೆ.","poem":2},{"text":"ಅವರ ಪರಾಕ್ರಮತನ ತಪ್ಪಿತು;","poem":1},{"text":"ಅವರು ಬಲಹೀನರಾಗಿದ್ದಾರೆ.","poem":2},{"text":"ಆ ದೇಶದ ನಿವಾಸಗಳನ್ನು ಸುಟ್ಟಿದ್ದಾರೆ;","poem":1},{"text":"ಅದರ ಹೆಬ್ಬಾಗಿಲುಗಳು ಮುರಿದುಹೋಗಿವೆ.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ಒಬ್ಬ ಸುದ್ದಿಗಾರ ಇನ್ನೊಬ್ಬ ಸುದ್ದಿಗಾರನ ಕಡೆ ಓಡುತ್ತಾನೆ.","poem":1},{"text":"ಒಬ್ಬ ದೂತ ಇನ್ನೊಬ್ಬ ದೂತನ ಕಡೆಗೆ ಓಡಿಹೋಗಿ,","poem":2},{"text":"ಬಾಬಿಲೋನಿನ ಅರಸನಿಗೆ ಈ ಸಮಾಚಾರವನ್ನು ತಿಳಿಸುತ್ತಾನೆ,","poem":1},{"text":"ನಿನ್ನ ರಾಜಧಾನಿಯನ್ನು ಎಲ್ಲಾ ಕಡೆಯಿಂದ ಆಕ್ರಮಿಸಿದ್ದಾರೆ,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ಹಾಯ್ಗಡಗಳನ್ನು ಹಿಡಿದಿದ್ದಾರೆ,","poem":1},{"text":"ಜೊಂಡು ಹುಲ್ಲನ್ನು ಸುಟ್ಟುಬಿಟ್ಟಿದ್ದಾರೆ,","poem":2},{"lineBreak":true},{"text":"ರಣವೀರರು ಬೆಚ್ಚಿಬಿದ್ದಿದ್ದಾರೆ.”","poem":2}]},{"type":"verse","number":33,"content":["ಏಕೆಂದರೆ ಇಸ್ರಾಯೇಲಿನ ದೇವರೂ, ಸರ್ವಶಕ್ತರಾಗಿರುವ ಯೆಹೋವ ದೇವರೂ ಹೇಳುವುದೇನೆಂದರೆ:",{"text":"“ತುಳಿಯುವ ವೇಳೆಯಲ್ಲಿ ಕಣವು ಹೇಗೋ,","poem":1},{"text":"ಹಾಗೆಯೇ ಬಾಬಿಲೋನಿನ ಮಗಳು ಇದ್ದಾಳೆ.","poem":2},{"lineBreak":true},{"text":"ಇನ್ನು ಸ್ವಲ್ಪ ಕಾಲವಾದ ಮೇಲೆ ಅವಳಿಗೆ ಸುಗ್ಗಿಕಾಲ ಬರುವುದು.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“ಬಾಬಿಲೋನಿನ ಅರಸನಾದ ನೆಬೂಕದ್ನೆಚ್ಚರನು ನಮ್ಮನ್ನು ನುಂಗಿಬಿಟ್ಟಿದ್ದಾನೆ.","poem":1},{"text":"ನಮ್ಮನ್ನು ಜಜ್ಜಿದ್ದಾನೆ.","poem":2},{"lineBreak":true},{"text":"ನಮ್ಮನ್ನು ಬರೀ ಪಾತ್ರೆಯಾಗಿ ಮಾಡಿದ್ದಾನೆ.","poem":2},{"text":"ಘಟಸರ್ಪದ ಹಾಗೆ ನಮ್ಮನ್ನು ನುಂಗಿಬಿಟ್ಟಿದ್ದಾನೆ.","poem":1},{"text":"ನಮ್ಮನ್ನು ರಮ್ಯವಾದವುಗಳಿಂದ ತನ್ನ ಹೊಟ್ಟೆ ತುಂಬಿಸಿದ್ದಾನೆ.","poem":2},{"lineBreak":true},{"text":"ನಮ್ಮನ್ನು ಉಗುಳಿಬಿಟ್ಟಿದ್ದಾನೆ.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ನಮಗೂ, ನಮ್ಮ ಶರೀರಕ್ಕೂ ಮಾಡಿರುವ ಬಲಾತ್ಕಾರವು","poem":1},{"text":"ಬಾಬಿಲೋನಿನ ಮೇಲೆ ಇರಲಿ,” ಎಂದು ಚೀಯೋನ್ ನಿವಾಸಿಗಳು ಹೇಳುತ್ತಾರೆ;","poem":2},{"text":"“ಕಸ್ದೀಯರ ನಿವಾಸಿಗಳ ಮೇಲೆ ನನ್ನ ರಕ್ತವು ಇರಲಿ,”","poem":1},{"text":"ಎಂದು ಯೆರೂಸಲೇಮು ಹೇಳುವುದು.","poem":2}]},{"type":"verse","number":36,"content":["ಆದ್ದರಿಂದ ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ.",{"text":"“ಇಗೋ, ನಾನು ನಿನ್ನ ನಿಮಿತ್ತ ವ್ಯಾಜ್ಯವಾಡುತ್ತೇನೆ.","poem":1},{"text":"ನಿನಗೋಸ್ಕರ ಪ್ರತಿದಂಡನೆ ಮಾಡುತ್ತೇನೆ.","poem":2},{"text":"ಅದರ ಸಮುದ್ರವನ್ನು ಒಣಗಿಸುತ್ತೇನೆ.","poem":1},{"text":"ಅದರ ಬುಗ್ಗೆಯನ್ನು ಬತ್ತಿಹೋಗುವಂತೆ ಮಾಡುತ್ತೇನೆ.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"ಬಾಬಿಲೋನ್ ದಿಬ್ಬಗಳಾಗುವುದು.","poem":1},{"text":"ನಿವಾಸಿಗಳು ಇಲ್ಲದೆ ನರಿಗಳ ವಾಸಸ್ಥಳವಾಗಿ","poem":2},{"text":"ಆಶ್ಚರ್ಯಕ್ಕೂ, ನಾಶಕ್ಕೂ,","poem":1},{"text":"ಸಿಳ್ಳಿಡುವಿಕೆಗೂ ಒಳಗಾಗುವುದು.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"ಅವರು ಸಿಂಹಗಳ ಹಾಗೆ ಒಟ್ಟಾಗಿ ಗರ್ಜಿಸುವರು.","poem":1},{"text":"ಸಿಂಹಗಳ ಮರಿಗಳ ಹಾಗೆ ಶಬ್ದಮಾಡುವರು.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"ಅವರು ಉರಿಗೊಂಡಿರುವಾಗ,","poem":1},{"text":"ನಾನು ಅವರಿಗೆ ಔತಣವನ್ನು ಸಿದ್ಧಪಡಿಸಿ,","poem":2},{"lineBreak":true},{"text":"ಅವರು ಅದರಿಂದ ಸಂಭ್ರಮಪಟ್ಟು,","poem":2},{"text":"ಎಂದಿಗೂ ಎಚ್ಚರಗೊಳ್ಳದೆ,","poem":1},{"text":"ದೀರ್ಘ ನಿದ್ರೆ ಮಾಡುವಂತೆ ತಲೆಗೇರುವತನಕ ಕುಡಿಸುವೆನು,”","poem":2},{"lineBreak":true},{"text":"ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"“ಕುರಿ, ಟಗರು, ಹೋತಗಳ ಹಾಗೆ","poem":1},{"text":"ಅವರನ್ನು ವಧ್ಯಸ್ಥಾನಕ್ಕೆ ಬರಮಾಡುವೆನು.","poem":2},{"lineBreak":true},{"text":"ಇದು ಯೆಹೋವನಾದ ನನ್ನ ನುಡಿ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"“ಶೇಷಕ್ ಹೇಗೆ ಶತ್ರುವಶವಾಗಿದೆ,","poem":1},{"text":"ಸಮಸ್ತ ಭೂಮಿಯ ಹೊಗಳಿಕೆಯು ಆಶ್ಚರ್ಯಗೊಂಡಿದೆ;","poem":2},{"text":"ಬಾಬಿಲೋನ್ ಜನಾಂಗಗಳೊಳಗೆ","poem":1},{"text":"ಹೇಗೆ ಎಷ್ಟು ನಿರ್ಜನವಾಯಿತು!","poem":2}]},{"type":"verse","number":42,"content":[{"text":"ಸಮುದ್ರವೇ ಬಾಬಿಲೋನಿನ ಮೇಲೆ ನುಗ್ಗಿಬಿಟ್ಟಿದೆ,","poem":1},{"text":"ಲೆಕ್ಕವಿಲ್ಲದೆ ತೆರೆಗಳು ಆ ರಾಜ್ಯವನ್ನು ಮುಚ್ಚಿಬಿಟ್ಟಿವೆ.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"ಕಾಡು, ಕಗ್ಗಾಡು, ಬೆಂಗಾಡು","poem":1},{"text":"ಆಗಿವೆ ಅದರ ನಗರಗಳು.","poem":2},{"text":"ಆ ದೇಶದೊಳು ಯಾರೂ ವಾಸಿಸರು,","poem":1},{"text":"ಯಾವ ಮನುಷ್ಯನೂ ಹಾದು ಹೋಗನು.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"ಏಕೆಂದರೆ ನಾನು ಬಾಬಿಲೋನಿನಲ್ಲಿರುವ ಬೇಲ್‌ನನ್ನು ದಂಡಿಸಿ,","poem":1},{"text":"ಅವನು ನುಂಗಿದ್ದನ್ನು ಅವನ ಬಾಯೊಳಗಿಂದ ಹೊರಗೆ ಕಕ್ಕಿಸುವೆನು.","poem":2},{"text":"ಇನ್ನು ಮೇಲೆ ಜನಾಂಗಗಳು ಅವನ ಬಳಿಗೆ ಪ್ರವಾಹವಾಗಿ ಬರುವುದಿಲ್ಲ.","poem":1},{"text":"ಹೌದು, ಬಾಬಿಲೋನಿನ ಗೋಡೆ ಬೀಳುವುದು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“ನನ್ನ ಜನರೇ, ಅದರೊಳಗಿಂದ ಹೊರಡಿರಿ.","poem":1},{"text":"ಒಬ್ಬೊಬ್ಬನು ತನ್ನ ತನ್ನ ಪ್ರಾಣವನ್ನು","poem":2},{"lineBreak":true},{"text":"ಯೆಹೋವ ದೇವರ ಕೋಪಕ್ಕೆ ತಪ್ಪಿಸಿರಿ.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"ನಿಮ್ಮ ಹೃದಯವು ಕುಂದದ ಹಾಗೆ","poem":1},{"text":"ದೇಶದಲ್ಲಿ ಕಿವಿಗೆ ಬೀಳುವ ಸುದ್ದಿಗೆ ನೀವು ಭಯಪಡದ ಹಾಗೆ,","poem":2},{"text":"ಒಂದು ವರ್ಷದಲ್ಲಿ ಒಂದು ಸುದ್ದಿಯೂ","poem":1},{"text":"ಇನ್ನೊಂದು ವರ್ಷದಲ್ಲಿ ಇನ್ನೊಂದು ಸುದ್ದಿಯೂ ಬರುವುದು.","poem":2},{"text":"ದೇಶದಲ್ಲಿ ಬಲಾತ್ಕಾರವಿರುವುದು,","poem":1},{"text":"ಆಳುವವನು ಆಳುವವನಿಗೆ ವಿರೋಧವಾಗಿರುವನು.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"ಆದ್ದರಿಂದ ಇಗೋ, ದಿನಗಳು ಬರುವುವು.","poem":1},{"text":"ಆಗ ನಾನು ಬಾಬಿಲೋನಿನ ವಿಗ್ರಹಗಳಿಗೆ ದಂಡಿಸುವೆನು.","poem":2},{"text":"ಆದರೆ ದೇಶವೆಲ್ಲಾ ನಾಚಿಕೆಪಡುವುದು.","poem":1},{"text":"ಹತರಾದವರ ದೇಹಗಳು ಅದರ ಮಧ್ಯದಲ್ಲಿ ಅಲ್ಲಿ ಇಲ್ಲಿ ಬಿದ್ದಿವೆ.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"ಆಗ ಭೂಮಿ ಆಕಾಶಗಳೂ,","poem":1},{"text":"ಅಲ್ಲಿನ ಸಮಸ್ತವೂ ಬಾಬಿಲೋನಿನ ನಾಶವನ್ನು ನೋಡಿ","poem":2},{"text":"ಜಯಘೋಷ ಮಾಡುವುವು.","poem":1},{"text":"ಹಾಳುಮಾಡುವರು, ಉತ್ತರದಿಂದ ಬಂದು ಹಾಳುಮಾಡುವರು,”","poem":2},{"lineBreak":true},{"text":"ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"“ಬಾಬಿಲೋನ್‌ನಿಂದಾಗಿ ಭೂಮಿಯಲ್ಲೆಲ್ಲಾ ಹತರಾದಂತೆಯೇ,","poem":1},{"text":"ಇಸ್ರಾಯೇಲಿನ ಹತ್ಯೆಯಿಂದಾಗಿ ಬಾಬಿಲೋನ್ ಬೀಳಬೇಕು.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"ಖಡ್ಗದಿಂದ ತಪ್ಪಿಸಿಕೊಂಡವರೇ,","poem":1},{"text":"ನಡೆಯಿರಿ, ನಿಲ್ಲಬೇಡಿರಿ.","poem":2},{"text":"ದೂರದಲ್ಲಿ ಯೆಹೋವ ದೇವರನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ,","poem":1},{"text":"ಯೆರೂಸಲೇಮು ನಿಮ್ಮ ಮನಸ್ಸಿಗೆ ಬರಲಿ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"“ನಾಚಿಕೆ ಪಡುತ್ತೇವೆ,","poem":1},{"text":"ಏಕೆಂದರೆ ನಿಂದೆಯನ್ನು ಕೇಳಿದ್ದೇವೆ.","poem":2},{"lineBreak":true},{"text":"ಅವಮಾನ ನಿಮ್ಮ ಮುಖಗಳನ್ನು ಮುಚ್ಚಿದೆ.","poem":2},{"text":"ಏಕೆಂದರೆ ವಿದೇಶಿಗಳು ಯೆಹೋವ ದೇವರ ಆಲಯದ","poem":1},{"text":"ಪರಿಶುದ್ಧ ಸ್ಥಳಗಳಲ್ಲಿ ಪ್ರವೇಶಿಸಿದ್ದಾರೆ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"“ಇಗೋ, ಅಂಥ ದಿನಗಳು ಬರುತ್ತವೆ,” ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ,","poem":1},{"text":"“ಅದು ನಾನು ಬಾಬಿಲೋನಿನ ವಿಗ್ರಹಗಳನ್ನು","poem":2},{"text":"ದಂಡಿಸುವ ದಿನಗಳು.","poem":1},{"text":"ಆಗ ಆ ದೇಶದೊಳೆಲ್ಲ ಗಾಯಪಟ್ಟವರು ನರಳಾಡುವರು.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"ಬಾಬಿಲೋನ್ ಆಕಾಶಕ್ಕೆ ಏರಿದರೂ,","poem":1},{"text":"ಅದರ ಬಲದ ಉನ್ನತಸ್ಥಾನವನ್ನು ಭದ್ರಮಾಡಿದರೂ,","poem":2},{"lineBreak":true},{"text":"ಸೂರೆಮಾಡುವವರು ನನ್ನಿಂದ ಅವಳಿಗೆ ವಿರೋಧವಾಗಿ ಬರುವರು,”","poem":2},{"lineBreak":true},{"text":"ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":54,"content":[{"text":"“ಬಾಬಿಲೋನಿನಿಂದ ಕೂಗುವ ಶಬ್ದವು!","poem":1},{"text":"ಕಸ್ದೀಯರ ದೇಶದಿಂದ ದೊಡ್ಡ ನಾಶದ ಶಬ್ದವೂ ಬರುವುದು.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ಬಾಬಿಲೋನನ್ನು ಸೂರೆಮಾಡಿದ್ದಾರೆ;","poem":1},{"text":"ಅವಳೊಳಗಿಂದ ಮಹಾ ಶಬ್ದವನ್ನು ತೆಗೆದುಹಾಕಿದ್ದಾರೆ;","poem":2},{"text":"ಅವಳ ತೆರೆಗಳು ನೀರಿನ ಹಾಗೆ ಘೋಷಿಸುವಾಗ,","poem":1},{"text":"ಅವುಗಳ ಶಬ್ದದ ಧ್ವನಿಯು ಹೊರಟಿತು.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"ಏಕೆಂದರೆ ವಿನಾಶ ಮಾಡುವವನು ಅದರ ಮೇಲೆ ಅಂದರೆ ಬಾಬಿಲೋನಿನ ಮೇಲೆಯೇ ಬಂದಿದ್ದಾನೆ.","poem":1},{"text":"ಅದರ ಪರಾಕ್ರಮಶಾಲಿಗಳು ಸೆರೆಯಾಗಿಬಿಟ್ಟಿದ್ದಾರೆ.","poem":2},{"lineBreak":true},{"text":"ಅವಳ ಬಿಲ್ಲುಗಳು ಮುರಿದುಹೋಗಿವೆ.","poem":2},{"text":"ಏಕೆಂದರೆ ಪ್ರತಿದಂಡನೆಗಳ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ನಿಶ್ಚಯವಾಗಿ","poem":1},{"text":"ಮುಯ್ಯಿಗೆ ಮುಯ್ಯಿ ತೀರಿಸುವರು.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"ಇದಲ್ಲದೆ ನಾನು ಅವಳ ಪ್ರಧಾನರನ್ನೂ,","poem":1},{"text":"ಅವಳ ಜ್ಞಾನಿಗಳನ್ನೂ, ಅವಳ ಅಧಿಪತಿಗಳನ್ನೂ,","poem":2},{"text":"ಅವಳ ಅಧಿಕಾರಿಗಳನ್ನೂ, ಅವಳ ಪರಾಕ್ರಮಶಾಲಿಗಳನ್ನೂ ಮತ್ತರಾಗಿ ಮಾಡುತ್ತೇನೆ.","poem":1},{"text":"ಅವರು ನಿತ್ಯ ನಿದ್ರೆ ಮಾಡುವರು, ಎಚ್ಚರವಾಗುವುದಿಲ್ಲ,”","poem":2},{"lineBreak":true},{"text":"ಎಂದು ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಎಂಬ ಹೆಸರುಳ್ಳ ರಾಜಾಧಿರಾಜರು ಸಾರುತ್ತಾರೆ.","poem":2}]},{"type":"verse","number":58,"content":["ಮಾತ್ರವಲ್ಲದೆ ಸೇನಾಧೀಶ್ವರ ಯೆಹೋವ ದೇವರು ಹೇಳುವುದೇನೆಂದರೆ:",{"text":"“ಬಾಬಿಲೋನಿನ ಅಗಲವಾದ ಪೌಳಿಗೋಡೆ ಪೂರ್ಣವಾಗಿ ನೆಲಸಮವಾಗುವುದು.","poem":1},{"text":"ಅವಳ ಎತ್ತರವಾದ ಬಾಗಿಲುಗಳು ಬೆಂಕಿಯಿಂದ ಸುಟ್ಟುಹೋಗುವುವು;","poem":2},{"text":"ಜನರು ವ್ಯರ್ಥಕ್ಕಾಗಿಯೂ,","poem":1},{"text":"ಪ್ರಜೆಗಳು ಬೆಂಕಿಗಾಗಿಯೂ ಕಷ್ಟಪಟ್ಟು ಆಯಾಸಪಡುವರು.”","poem":2}]},{"type":"verse","number":59,"content":["ಪ್ರವಾದಿಯಾದ ಯೆರೆಮೀಯನು ಮಹ್ಸೇಯನ ಮಗನಾದ ನೇರೀಯನ ಮಗ ಸೆರಾಯನಿಗೆ, ಅವನು ಯೆಹೂದದ ಅರಸನಾದ ಚಿದ್ಕೀಯನ ಸಂಗಡ, ಇವನ ಆಳ್ವಿಕೆಯ ನಾಲ್ಕನೆಯ ವರ್ಷದಲ್ಲಿ ಬಾಬಿಲೋನಿಗೆ ಹೋದಾಗ ಆಜ್ಞಾಪಿಸಿದ ವಾಕ್ಯವು. ಆ ಸೆರಾಯನು ಅಂಗರಕ್ಷಕ ಸೇನೆಯ ನಾಯಕನಾಗಿದ್ದನು."]},{"type":"verse","number":60,"content":["ಹೀಗೆ ಯೆರೆಮೀಯನು ಬಾಬಿಲೋನಿನ ಮೇಲೆ ಬರುವ ಕೇಡನ್ನೆಲ್ಲಾ ಬಾಬಿಲೋನಿಗೆ ವಿರೋಧವಾಗಿ ಬರೆದಿರುವ ಈ ವಾಕ್ಯಗಳನ್ನೆಲ್ಲಾ ಒಂದು ಗ್ರಂಥದಲ್ಲಿ ಬರೆದನು."]},{"type":"verse","number":61,"content":["ಯೆರೆಮೀಯನು ಸೆರಾಯನಿಗೆ ಹೇಳಿದ್ದೇನೆಂದರೆ, “ನೀನು ಬಾಬಿಲೋನಿಗೆ ಬಂದು"]},{"type":"verse","number":62,"content":["ಈ ವಾಕ್ಯಗಳನ್ನೆಲ್ಲಾ ಓದುತ್ತಿರುವಾಗ ಹೇಳತಕ್ಕದ್ದೇನೆಂದರೆ, ‘ಓ ಯೆಹೋವ ದೇವರೇ, ಈ ಸ್ಥಳಕ್ಕೆ ವಿರೋಧವಾಗಿ ಅದರಲ್ಲಿ ಮನುಷ್ಯರಾಗಲಿ, ಮೃಗಗಳಾಗಲಿ, ನಿವಾಸಿಗಳಾಗಲಿ ಎಂದಿಗೂ ಇರದಂತೆ, ಅದು ಸದಾಕಾಲ ಹಾಳಾಗಿಯೇ ಉಳಿಯಲಿ,’ ಎಂದು ನೀವೇ ಮಾತನಾಡ್ದಿದೀರಿ."]},{"type":"verse","number":63,"content":["ನೀನು ಈ ಗ್ರಂಥವನ್ನು ಓದಿ ಮುಗಿಸಿದ ಮೇಲೆ, ಅದಕ್ಕೆ ಕಲ್ಲು ಕಟ್ಟಿ, ಅದನ್ನು ಯೂಫ್ರೇಟೀಸಿನ ಮಧ್ಯದಲ್ಲಿ ಬಿಸಾಡಿ,"]},{"type":"verse","number":64,"content":["ಹೀಗೆ ಹೇಳು, ‘ಈ ಪ್ರಕಾರ ಬಾಬಿಲೋನ್ ಮುಳುಗಿ ಹೋಗುವುದು. ನಾನು ಅವಳ ಮೇಲೆ ತರುವ ಕೇಡಿನೊಳಗಿಂದ ಏಳದು. ಅವರು ಬೀಳುವರು.’ ”",{"lineBreak":true},{"lineBreak":true},"ಇಲ್ಲಿಯ ತನಕ ಯೆರೆಮೀಯನ ವಾಕ್ಯಗಳು."]},{"type":"line_break"}],"footnotes":[{"noteId":13,"caller":"+","text":"ಲೇಬ್ ಕಾಮೈ ರಹಸ್ಯ ಭಾಷೆಯಲ್ಲಿ ಬಾಬಿಲೋನ್.","reference":{"chapter":51,"verse":1}}]},"thisChapterLink":"/api/kan_okcv/JER/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/JER/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/JER/50.json","previousChapterAudioLinks":{},"numberOfVerses":64}