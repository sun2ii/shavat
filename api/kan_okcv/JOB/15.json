{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"JOB","translationId":"kan_okcv","name":"ಯೋಬ","commonName":"ಯೋಬ","title":"ಯೋಬ","order":18,"numberOfChapters":42,"sha256":"b0f83c520d9f9fe88a86928196fe42cb3f2ca42af0fcb52b6aedc35fc7902203","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/kan_okcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":15,"content":[{"type":"heading","content":["ಎಲೀಫಜನ ಪ್ರತಿವಾದ"]},{"type":"verse","number":1,"content":["ಆಗ ತೇಮಾನ್ಯನಾದ ಎಲೀಫಜನು ಹೀಗೆಂದನು:"]},{"type":"verse","number":2,"content":[{"text":"“ಜ್ಞಾನಿಯು ವ್ಯರ್ಥ ತಿಳುವಳಿಕೆಯನ್ನು ನುಡಿದು","poem":1},{"text":"ಪೂರ್ವದಿಕ್ಕಿನ ಗಾಳಿಯಿಂದ ತನ್ನ ಹೊಟ್ಟೆ ತುಂಬಿಸಿಕೊಳ್ಳುವುದು ಉಂಟೋ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ನಿಷ್ಪ್ರಯೋಜಕವಾದ ನುಡಿಗಳಿಂದಲೂ,","poem":1},{"text":"ಕೆಲಸಕ್ಕೆ ಬಾರದ ಮಾತುಗಳಿಂದಲೂ ಜ್ಞಾನಿಯು ವಾದಿಸುವನೋ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ನೀನಾದರೋ ದೇವರ ಭಯಭಕ್ತಿಯನ್ನು ಹಾಳುಮಾಡುತ್ತಿರುವೆ.","poem":1},{"text":"ದೇವರ ಮೇಲಿನ ಭಕ್ತಿಯನ್ನು ಕಡಿಮೆ ಮಾಡುತ್ತಿರುವೆ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ಏಕೆಂದರೆ ನಿನ್ನ ಪಾಪವೇ ನಿನ್ನ ಬಾಯಿಯನ್ನು ಪ್ರೇರೇಪಿಸುತ್ತದೆ;","poem":1},{"text":"ನೀನು ಕುಯುಕ್ತಿಯುಳ್ಳವರ ನಾಲಿಗೆಯನ್ನು ಆಯ್ದುಕೊಳ್ಳುತ್ತಿರುವೆ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ನಾನಲ್ಲ, ನಿನ್ನ ಬಾಯಿಯೇ ನಿನ್ನನ್ನು ಖಂಡಿಸುತ್ತದೆ;","poem":1},{"text":"ಹೌದು, ನಿನ್ನ ತುಟಿಗಳೇ ನಿನಗೆ ವಿರೋಧವಾಗಿ ಸಾಕ್ಷಿ ಕೊಡುತ್ತವೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“ನೀನು ಮೊದಲು ಹುಟ್ಟಿದ ಪುರುಷನೋ?","poem":1},{"text":"ಬೆಟ್ಟಗಳಿಗೆ ಮುಂಚಿತವಾಗಿ ಹುಟ್ಟಿದವನೋ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ನೀನು ದೇವರ ಆಲೋಚನಾ ಸಭೆಯಲ್ಲಿ ಸದಸ್ಯನೋ?","poem":1},{"text":"ಜ್ಞಾನವು ನಿನಗೆ ಮಾತ್ರ ಮೀಸಲೋ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ನಮಗೆ ತಿಳಿಯದೆ ಇರುವುದನ್ನು ನೀನು ಏನು ತಿಳಿದುಕೊಂಡಿರುವೆ?","poem":1},{"text":"ನಮ್ಮಲ್ಲಿ ಇಲ್ಲದ ಯಾವ ಒಳನೋಟವನ್ನು ನೀನು ಅರ್ಥಮಾಡಿಕೊಂಡಿರುವೆ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ತಲೆ ನರೆತವರೂ, ಹೆಚ್ಚು ಮುದುಕರಾದವರೂ,","poem":1},{"text":"ನಿನ್ನ ತಂದೆಗಿಂತ ವೃದ್ಧರಾದವರೂ ನಮ್ಮಲ್ಲಿ ಇದ್ದಾರೆ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ದೇವರ ಸಂತೈಸುವಿಕೆಗಳೂ","poem":1},{"text":"ಮೃದುವಾದ ಹಿತವಚನಗಳು ನಿನಗೆ ಸಾಕಾಗಿರುವುದಿಲ್ಲವೋ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ನಿನ್ನ ಹೃದಯವು ನಿನ್ನನ್ನು ಸೆಳೆದಿರುವುದು ಏಕೆ?","poem":1},{"text":"ಏಕೆ ನಿನ್ನ ಕಣ್ಣು ಕಿಡಿಕಾರುತ್ತಿದೆ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ನೀನು ದೇವರ ವಿರುದ್ಧ ನಿನ್ನ ಕೋಪವನ್ನು ಹೊರಹಾಕುತ್ತಿರುವೆ?","poem":1},{"text":"ನಿನ್ನ ಬಾಯಿಂದ ಕೋಪದ ಮಾತುಗಳನ್ನು ಹೊರಡಿಸುತ್ತೀಯಲ್ಲಾ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ಮನುಷ್ಯನು ಎಷ್ಟರವನು? ಅವನು ಶುದ್ಧನಿರಲು ಸಾಧ್ಯವೇ?","poem":1},{"text":"ಸ್ತ್ರೀಯರಲ್ಲಿ ಹುಟ್ಟಿದವನು ನೀತಿವಂತನಾಗಿರಬಹುದೆ?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ದೇವರು ತಮ್ಮ ಪರಿಶುದ್ಧರನ್ನು ಆತುಕೊಂಡಿರುವುದಿಲ್ಲ;","poem":1},{"text":"ಆಕಾಶಗಳೂ ದೇವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಶುದ್ಧವಲ್ಲ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ಹಾಗಿರುವಾಗ, ನೀರಿನಂತೆ ಅನ್ಯಾಯವನ್ನು ಕುಡಿಯುವ ಮನುಷ್ಯನು,","poem":1},{"text":"ದೇವರ ದೃಷ್ಟಿಯಲ್ಲಿ ಎಷ್ಟು ಅಲ್ಪನೂ ಅಶುದ್ಧನೂ ಆಗಿದ್ದಾನಲ್ಲವೇ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“ಕೇಳು, ನಾನು ನಿನಗೆ ವಿವರಿಸುತ್ತೇನೆ,","poem":1},{"text":"ನಾನು ನೋಡಿದ್ದನ್ನು ನಿನಗೆ ಹೇಳುತ್ತೇನೆ,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ಜ್ಞಾನಿಗಳು ತಮ್ಮ ಪೂರ್ವಜರಿಂದ ಕಲಿತಿದ್ದನ್ನೇ","poem":1},{"text":"ಮರೆಮಾಡದೆ ನಮಗೆ ಪ್ರಕಟಿಸಿದರು.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ಅವರಿಗೆ ದೇಶವು ಕೊಡಲಾಗಿತ್ತು;","poem":1},{"text":"ಅವರ ಮಧ್ಯದಲ್ಲಿ ಅಂದು ಪರದೇಶೀಯರು ಹಾದುಹೋಗುವಂತಿರಲಿಲ್ಲ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ಜ್ಞಾನಿಗಳು ಹೇಳಿದ್ದೇನೆಂದರೆ: ದುಷ್ಟನು ತನ್ನ ಜೀವಮಾನವೆಲ್ಲಾ ವೇದನೆಪಡುತ್ತಾನೆ;","poem":1},{"text":"ನಿರ್ದಯನು ತನ್ನ ವರ್ಷಗಳೆಲ್ಲ ತೊಂದರೆಗಳನ್ನು ಸಂಗ್ರಹಿಸುತ್ತಾನೆ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ಭಯಂಕರವಾದ ಸಂಗತಿಗಳು ಅವನ ಕಿವಿಗೆ ಬೀಳುತ್ತವೆ;","poem":1},{"text":"ಎಲ್ಲವು ಸುಖವಾಗಿರುವಾಗ ಸುಲಿಗೆ ಮಾಡುವವನು ದುಷ್ಟನ ಮೇಲೆ ದಾಳಿ ಮಾಡುತ್ತಾನೆ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ಕತ್ತಲೆಯೊಳಗಿಂದ ಪಾರಾಗುತ್ತೇನೆಂದು ದುಷ್ಟನು ನಂಬುವುದಿಲ್ಲ;","poem":1},{"text":"ಅವನ ಖಡ್ಗವು ಅವನಿಗಾಗಿ ಕಾದಿದೆ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ಅವನು ಆಹಾರ ಎಲ್ಲಿ ಎಂದು ರಣಹದ್ದಿನ ಹಾಗೆ ಅಲೆಯುತ್ತಾನೆ;","poem":1},{"text":"ಕತ್ತಲೆಯ ದಿನ ತನ್ನ ಕೈ ಹತ್ತಿರ ಸಿದ್ಧವಾಗಿದೆ ಎಂದು ತಿಳಿದಿದ್ದಾನೆ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ಇಕ್ಕಟ್ಟೂ, ಸಂಕಟವೂ ಅವನನ್ನು ಹೆದರಿಸಿ,","poem":1},{"text":"ಆಕ್ರಮಣ ಮಾಡಲು ಸಿದ್ಧನಾದ ರಾಜನಂತೆ ತೊಂದರೆಗಳು ಅವನನ್ನು ಆವರಿಸುತ್ತವೆ,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ಏಕೆಂದರೆ ದುಷ್ಟನು ದೇವರಿಗೆ ವಿರೋಧವಾಗಿ ಮುಷ್ಠಿ ತೋರಿಸಿದನಲ್ಲಾ,","poem":1},{"text":"ಸರ್ವಶಕ್ತರ ಎದುರು ನಿಂತು ಶೂರನಂತೆ ಮೆರೆದನಲ್ಲಾ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ದೇವರ ವಿರೋಧವಾಗಿ ಬಲವುಳ್ಳ ದೊಡ್ಡ","poem":1},{"text":"ಗುರಾಣಿಯೊಂದಿಗೆ ಓಡುತ್ತಾನೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“ದುಷ್ಟನು ತನ್ನ ಮುಖದಲ್ಲಿ ಕೊಬ್ಬೇರಿಸಿಕೊಂಡು,","poem":1},{"text":"ತನ್ನ ಸೊಂಟದಲ್ಲಿ ಬೊಜ್ಜನ್ನು ಬೆಳೆಸಿಕೊಂಡಿದ್ದಾನೆ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ಹಾಳಾದ ಪಟ್ಟಣಗಳಲ್ಲಿಯೂ,","poem":1},{"text":"ಯಾರೂ ವಾಸಿಸದ,","poem":2},{"lineBreak":true},{"text":"ಕುಸಿಯಲು ಸಿದ್ಧವಾದಂಥ ಮನೆಗಳಲ್ಲಿಯೂ ವಾಸಮಾಡಿಕೊಂಡಿದ್ದಾನೆ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ದುಷ್ಟನು ಐಶ್ವರ್ಯವಂತನಾಗುವುದಿಲ್ಲ; ಆದರೂ ಅವನ ಆಸ್ತಿಯು ಸ್ಥಿರವಲ್ಲ;","poem":1},{"text":"ಅವನ ಸೊತ್ತು ಭೂಮಿಯ ಮೇಲೆ ವಿಸ್ತಾರವಾಗುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ಕತ್ತಲೆಯೊಳಗಿಂದ ಅವನು ಪಾರಾಗುವದಿಲ್ಲ;","poem":1},{"text":"ಕಿಚ್ಚು ಅವನ ಕೊಂಬೆಗಳನ್ನು ಒಣಗಿಸುವುದು;","poem":2},{"lineBreak":true},{"text":"ದೇವರ ಬಾಯಿಯ ಶ್ವಾಸದಿಂದ ಅವನು ತೊಲಗಿ ಹೋಗುವನು.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ದುಷ್ಟನು ವ್ಯರ್ಥವಾದದ್ದನ್ನು ನಂಬಿ ಮೋಸಹೋಗದಿರಲಿ.","poem":1},{"text":"ಏಕೆಂದರೆ, ವ್ಯರ್ಥವಾದವುಗಳಿಂದ ಅವನಿಗಾಗುವ ಪ್ರತಿಫಲವು ಶೂನ್ಯವೇ.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ದುಷ್ಟನು ತನ್ನ ಸಮಯಕ್ಕಿಂತ ಮೊದಲು ಬತ್ತಿ ಹೋಗುವನು;","poem":1},{"text":"ಅವನ ಕೊಂಬೆಯು ಹಸಿರಾಗಿರುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ದ್ರಾಕ್ಷೆಯ ಬಳ್ಳಿಯಂತೆ ಅವನು ತನ್ನ ಮಾಗದ ಫಲವನ್ನು ಹಾಳುಮಾಡಿಕೊಳ್ಳುವನು;","poem":1},{"text":"ದುಷ್ಟನು ಹೂವುಗಳನ್ನು ಉದುರಿಸುವ ಓಲಿವ್ ಎಣ್ಣೆಯ ಮರದ ಹಾಗೆ ಇರುವನು.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ದೇವರಿಲ್ಲದವರ ಸಹವಾಸ ಬಂಜರು,","poem":1},{"text":"ಬೆಂಕಿಯು ಲಂಚಕೋರರ ಮನೆಗಳನ್ನು ಸುಟ್ಟುಹಾಕುವುದು.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ಅವರು ಹಿಂಸೆಯನ್ನು ಗರ್ಭಧರಿಸಿ, ಕೆಟ್ಟದ್ದನ್ನು ಹೆರುವರು;","poem":1},{"text":"ಅವರ ಹೊಟ್ಟೆಯು ವಂಚನೆಯಿಂದ ತುಂಬಿರುವುದು.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kan_okcv/JOB/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/JOB/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":35}