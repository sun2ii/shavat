{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"JOB","translationId":"kan_okcv","name":"ಯೋಬ","commonName":"ಯೋಬ","title":"ಯೋಬ","order":18,"numberOfChapters":42,"sha256":"b0f83c520d9f9fe88a86928196fe42cb3f2ca42af0fcb52b6aedc35fc7902203","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/kan_okcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":19,"content":[{"type":"heading","content":["ಯೋಬನ ಉತ್ತರ"]},{"type":"verse","number":1,"content":["ಯೋಬನು ಉತ್ತರಕೊಟ್ಟು ಹೇಳಿದ್ದೇನೆಂದರೆ:"]},{"type":"verse","number":2,"content":[{"text":"“ಎಷ್ಟರವರೆಗೆ ನನ್ನ ನೋಯಿಸಿ,","poem":1},{"text":"ನನ್ನನ್ನು ಮಾತುಗಳಿಂದ ಜಜ್ಜುವಿರಿ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ಈಗ ಹತ್ತು ಸಾರಿ ನನ್ನನ್ನು ನಿಂದಿಸಿದ್ದೀರಿ;","poem":1},{"text":"ನಾಚಿಕೆಯಿಲ್ಲದೆ ನೀವು ನನ್ನ ಮೇಲೆ ಆಕ್ರಮಣ ಮಾಡುತ್ತೀರಿ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ನಿಜವಾಗಿ ನಾನು ತಪ್ಪು ಮಾಡಿದ್ದರೆ ನಿಮಗೇನು?","poem":1},{"text":"ನನ್ನ ತಪ್ಪು ನನ್ನ ಸಂಗಡ ಇರಲಿ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ನೀವು ನನಗಿಂತ ಉತ್ತಮರು ಎಂದು ಭಾವಿಸುತ್ತಿದ್ದೀರಿ;","poem":1},{"text":"ನನಗಾದ ಹೀನಸ್ಥಿತಿಯನ್ನು ನನಗೆ ವಿರೋಧವಾಗಿ ಉಪಯೋಗಿಸುತ್ತೀರಿ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ದೇವರಿಂದಲೇ ನನಗೆ ಅನ್ಯಾಯವಾಗಿದೆ;","poem":1},{"text":"ದೇವರು ತಮ್ಮ ಬಲೆಯನ್ನು ನನ್ನ ಮೇಲೆ ಬೀಸಿದ್ದಾರೆಂದು ನಿಮಗೆ ತಿಳಿದಿರಲಿ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“ ‘ಹಿಂಸೆ,’ ಎಂದು ನಾನು ಕೂಗಿಕೊಂಡರೂ ನನಗೆ ಉತ್ತರ ಕೊಡುವವರಿಲ್ಲ;","poem":1},{"text":"ಗಟ್ಟಿಯಾಗಿ ಮೊರೆಯಿಟ್ಟರೂ ನ್ಯಾಯ ದೊರಕುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ನಾನು ಮುಂದೆ ಹೋಗದಂತೆ ದೇವರು ನನ್ನ ದಾರಿಗೆ ಬೇಲಿ ಹಾಕಿದ್ದಾರೆ;","poem":1},{"text":"ನನ್ನ ಹಾದಿಗಳನ್ನು ಕತ್ತಲು ಕವಿಯುವಂತೆ ಮಾಡಿದ್ದಾರೆ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ದೇವರು ನನ್ನ ಘನತೆಯನ್ನು ತೆಗೆದುಹಾಕಿದ್ದಾರೆ;","poem":1},{"text":"ನನ್ನ ಕಿರೀಟವನ್ನು ನನ್ನ ತಲೆಯಿಂದ ತೆಗೆದುಹಾಕಿದ್ದಾರೆ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ನನ್ನ ಸುತ್ತಲೂ ದಾಳಿಯಾಗಿದ್ದರಿಂದ, ನಾನು ಕ್ಷಯಿಸುತ್ತಿದ್ದೇನೆ;","poem":1},{"text":"ಮರವನ್ನು ಕೀಳುವ ಹಾಗೆ ದೇವರು ನನ್ನ ನಿರೀಕ್ಷೆಯನ್ನು ಕಿತ್ತುಹಾಕಿದ್ದಾರೆ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ದೇವರ ಶಿಕ್ಷೆಯು ನನ್ನ ಮೇಲೆ ಉರಿಯುತ್ತಿದೆ;","poem":1},{"text":"ನಾನು ದೇವರಿಗೆ ವೈರಿಯಂತೆ ಪರಿಗಣಿಸಲಾಗಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ದೇವರ ಸೇನೆ ಒಟ್ಟಿಗೆ ಬಂದು,","poem":1},{"text":"ನನಗೆ ವಿರೋಧವಾಗಿ ದಿಬ್ಬನ್ನು ಕಟ್ಟಿ,","poem":2},{"lineBreak":true},{"text":"ನನ್ನ ಗುಡಾರದ ಸುತ್ತಲೂ ಇಳಿದಿವೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ದೇವರು ನನ್ನ ಕುಟುಂಬದವರನ್ನು ನನ್ನಿಂದ ಅಗಲಿಸಿದ್ದಾರೆ;","poem":1},{"text":"ನನ್ನ ಪರಿಚಿತರೆಲ್ಲರೂ ನನ್ನನ್ನು ತೊರೆದಿದ್ದಾರೆ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ನನ್ನ ಬಂಧುಗಳು ನನ್ನನ್ನು ಕೈಬಿಟ್ಟಿದ್ದಾರೆ;","poem":1},{"text":"ನನ್ನ ಆಪ್ತ ಸ್ನೇಹಿತರು ನನ್ನನ್ನು ಮರೆತುಬಿಟ್ಟಿದ್ದಾರೆ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ನನ್ನ ಅತಿಥಿಗಳು, ನನ್ನ ದಾಸದಾಸಿಯರೂ ನನ್ನನ್ನು ಅನ್ಯನೆಂದು ಎಣಿಸುತ್ತಾರೆ;","poem":1},{"text":"ಅವರ ದೃಷ್ಟಿಯಲ್ಲಿ ನಾನು ಪರದೇಶದವನ ಹಾಗೆ ಇದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ನನ್ನ ಸೇವಕನನ್ನು ಕರೆದರೂ, ಅವನು ನನಗೆ ಉತ್ತರ ಕೊಡುವುದಿಲ್ಲ;","poem":1},{"text":"ನನ್ನ ಬಾಯಿತೆರೆದು ಅವನನ್ನು ಬೇಡಿಕೊಂಡರೂ ಅವನು ಬರುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ನನ್ನ ಶ್ವಾಸವು ನನ್ನ ಹೆಂಡತಿಗೆ ಅಸಹ್ಯವಾಗಿದೆ,","poem":1},{"text":"ನನ್ನ ಕುಟುಂಬದವರಿಗೆ ನಾನು ಹೇಸಿಕೆಯಾದೆ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ಚಿಕ್ಕವರೂ ಸಹ ನನ್ನನ್ನು ತಿರಸ್ಕರಿಸುತ್ತಾರೆ;","poem":1},{"text":"ನಾನು ಕಾಣಿಸಿಕೊಂಡಾಗ ನನ್ನನ್ನು ಹಾಸ್ಯಮಾಡುತ್ತಾರೆ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ನನ್ನ ಆಪ್ತ ಸ್ನೇಹಿತರೆಲ್ಲಾ ನನ್ನನ್ನು ಕಂಡು ಅಸಹ್ಯಪಡುತ್ತಾರೆ;","poem":1},{"text":"ನಾನು ಪ್ರೀತಿ ಮಾಡಿದವರೇ ನನಗೆ ವಿರೋಧವಾಗಿ ತಿರುಗಿಬಿದ್ದಿದ್ದಾರೆ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ನಾನು ಕೇವಲ ಎಲುಬೂ ತೊಗಲೂ ಆಗಿಬಿಟ್ಟಿದ್ದೇನೆ;","poem":1},{"text":"ನಾನು ನನ್ನ ಹಲ್ಲು ಚರ್ಮದಿಂದಲೇ ತಪ್ಪಿಸಿಕೊಂಡೆನು.","poem":2},{"noteId":7}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“ಕನಿಕರಿಸಿರಿ, ನನ್ನ ಸ್ನೇಹಿತರೇ, ನನ್ನನ್ನು ಕನಿಕರಿಸಿರಿ,","poem":1},{"text":"ಏಕೆಂದರೆ ದೇವರ ಕೈ ನನ್ನನ್ನು ದಂಡಿಸಿದೆ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ದೇವರಂತೆ ನೀವು ನನ್ನನ್ನು ಏಕೆ ಹಿಂಸಿಸುತ್ತೀರಿ?","poem":1},{"text":"ನನಗೆ ತೊಂದರೆಪಡಿಸಿದ್ದು ಸಾಲದೋ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“ಆಹಾ, ನನ್ನ ಮಾತುಗಳು ದಾಖಲಿಸಿದ್ದರೆ,","poem":1},{"text":"ಆ ಮಾತುಗಳನ್ನು ಸುರುಳಿಗಳಲ್ಲಿ ಬರೆದಿದ್ದರೆ,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ಕಬ್ಬಿಣದ ಉಳಿಯಿಂದ ಬಂಡೆಯ ಮೇಲೆ ಕೆತ್ತಿ, ಸೀಸೆ ಎರೆದು","poem":1},{"text":"ಅವುಗಳನ್ನು ಶಾಶ್ವತ ಶಾಸನವಾಗಿ ಮಾಡಿದ್ದರೆ ಎಷ್ಟೋ ಒಳಿತು!","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ನನ್ನ ವಿಮೋಚಕರು ಜೀವಿಸುತ್ತಿದ್ದಾರೆ ಎಂದು ತಿಳಿದಿದ್ದೇನೆ.","poem":1},{"text":"ಕಡೆಯ ದಿನದಲ್ಲಿ ಭೂಮಿಯ ಮೇಲೆ ನನ್ನ ವಿಮೋಚಕರು ಬಂದು ನಿಲ್ಲುವರೆಂದೂ ತಿಳಿದಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ನನ್ನ ಚರ್ಮವು ಬಿರಿದು ಹಾಳಾದ ಬಳಿಕವೂ,","poem":1},{"text":"ನಾನು ದೇಹದಾರಿಯಾಗಿಯೇ ದೇವರನ್ನು ನೋಡುವೆನು.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ದೇವರನ್ನು ನಾನೇ ನೋಡುವೆನು;","poem":1},{"text":"ಬೇರೆಯವರಲ್ಲ, ನನ್ನ ಕಣ್ಣಾರೆ ಅವರನ್ನು ಕಾಣುವೆನು;","poem":2},{"lineBreak":true},{"text":"ಅದಕ್ಕಾಗಿ ನನ್ನ ಹೃದಯವು ನನ್ನೊಳಗೆ ಹಂಬಲಿಕೆಯಿಂದ ಹಾರೈಸುತ್ತಿದೆ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“ ‘ಸ್ನೇಹಿತರೇ, ಅವನ ದುರ್ಗತಿಗೆ ಕಾರಣ ಅವನಲ್ಲಿಯೇ ಇದೆ,","poem":1},{"text":"ನಾವು ಅವನಿಗೆ ಹೇಗೆ ತೊಂದರೆಕೊಡೋಣ?’ ಎಂದು ನೀವು ಹೇಳಿದರೆ,","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ನೀವು ಖಡ್ಗಕ್ಕೆ ಭಯಪಡಬೇಕಾಗುತ್ತದೆ;","poem":1},{"text":"ಏಕೆಂದರೆ, ಕ್ರೋಧವು ದಂಡನೆಯನ್ನು ಖಡ್ಗದಿಂದ ತರುವುದು.","poem":2},{"lineBreak":true},{"text":"ಆಗ ನ್ಯಾಯತೀರ್ಪು ಉಂಟೆಂದು ನಿಮಗೆ ತಿಳಿಯುವುದು.”","poem":2}]}],"footnotes":[{"noteId":7,"caller":"+","text":"ಅಥವಾ ಕೂದಲೆಳೆ ಅಂತರದಲ್ಲಿ ಸಾವಿನಿಂದ ಪಾರಾದೆನು","reference":{"chapter":19,"verse":20}}]},"thisChapterLink":"/api/kan_okcv/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}