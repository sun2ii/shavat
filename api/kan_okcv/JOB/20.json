{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"JOB","translationId":"kan_okcv","name":"ಯೋಬ","commonName":"ಯೋಬ","title":"ಯೋಬ","order":18,"numberOfChapters":42,"sha256":"b0f83c520d9f9fe88a86928196fe42cb3f2ca42af0fcb52b6aedc35fc7902203","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/kan_okcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":20,"content":[{"type":"heading","content":["ಚೋಫರನ ವಾದ"]},{"type":"verse","number":1,"content":["ನಾಮಾಥ್ಯನಾದ ಚೋಫರನು ಉತ್ತರಕೊಟ್ಟು ಹೇಳಿದ್ದೇನೆಂದರೆ:"]},{"type":"verse","number":2,"content":[{"text":"“ನಾನು ತುಂಬಾ ಕಳವಳಗೊಂಡದ್ದರಿಂದ,","poem":1},{"text":"ನನ್ನ ಆಲೋಚನೆಗಳು ನನ್ನನ್ನು ಉತ್ತರಿಸಲು ಪ್ರೇರೇಪಿಸಿದವು.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ನನ್ನನ್ನು ಅವಮಾನಿಸುವ ಖಂಡನೆಯನ್ನು ನಾನು ಕೇಳಿದ್ದೇನೆ;","poem":1},{"text":"ಆದ್ದರಿಂದ ನನ್ನ ತಿಳುವಳಿಕೆಯು ನನ್ನನ್ನು ಉತ್ತರಿಸಲು ಪ್ರೇರೇಪಿಸುತ್ತದೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“ದೇವರು ಮನುಷ್ಯನನ್ನು","poem":1},{"noteId":8},{"text":"ಭೂಮಿಯಲ್ಲಿ ಇರಿಸಿದ ಕಾಲದಿಂದ ವಿಷಯ ಹೇಗಿದೆ ಎಂಬುದು ನಿನಗೆ ನಿಶ್ಚಯವಾಗಿ ಗೊತ್ತಿದೆ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ದುಷ್ಟರ ಜಯವು ಅಲ್ಪ ಕಾಲ,","poem":1},{"text":"ಭಕ್ತಿಹೀನರ ಸಂತೋಷವು ಕ್ಷಣ ಮಾತ್ರ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ಹೆಮ್ಮೆಯು ಆಕಾಶಕ್ಕೆ ಏರಿದರೂ,","poem":1},{"text":"ಅವನ ತಲೆ ಮೇಘಕ್ಕೆ ಮುಟ್ಟಿದರೂ,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ಗೊಬ್ಬರದ ಹಾಗೆ ಶಾಶ್ವತವಾಗಿ ಅವನು ನಾಶವಾಗುವನು;","poem":1},{"text":"ಅವನನ್ನು ನೋಡಿದವರು, ‘ಅವನೆಲ್ಲಿ?’ ಎಂದು ಕೇಳುವರು.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ಭಕ್ತಿಹೀನನು ಕನಸಿನ ಹಾಗೆ ಹಾರಿಹೋಗುವನು, ಇನ್ನೆಂದಿಗೂ ಸಿಗಲಾರನು;","poem":1},{"text":"ಅವನು ಕತ್ತಲೆಯ ಹಾಗೆ ಕಾಣದೆ ಹೋಗುವನು.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ಅವನನ್ನು ನೋಡಿದವರು ಇನ್ನು ಮುಂದೆ ನೋಡರು;","poem":1},{"text":"ಅವನ ಸ್ಥಳವು ಇನ್ನು ಅವನನ್ನು ಕಾಣದು.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ಅವನ ಮಕ್ಕಳು ಬಡವರ ದಯೆಯನ್ನು ಬೇಡುವರು;","poem":1},{"text":"ಅವನ ಮಕ್ಕಳ ಕೈಗಳು ಅವನ ಸಂಪತ್ತನ್ನು ಹಿಂತಿರುಗಿಸಬೇಕಾಗುವುದು.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ಅವನ ಎಲುಬುಗಳು ಯೌವನದ ಶಕ್ತಿಯಿಂದ ತುಂಬಿತ್ತು,","poem":1},{"text":"ಅದು ಅವನ ಸಂಗಡ ಧೂಳಿನಲ್ಲಿ ಮಲಗುವುದು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“ಅವನ ಕೆಟ್ಟತನವು ಬಾಯಿಗೆ ಸಿಹಿಯಾಗಿತ್ತು,","poem":1},{"text":"ಅವನು ನಾಲಿಗೆಯ ಕೆಳಗೆ ಅದನ್ನು ಬಚ್ಚಿಟ್ಟುಕೊಂಡಿದ್ದನು.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ಅದನ್ನು ಬಿಟ್ಟುಕೊಡಲು ಇಷ್ಟಪಡದೆ,","poem":1},{"text":"ತನ್ನ ಬಾಯಿಯೊಳಗೆ ದೀರ್ಘಸಮಯ ಇಟ್ಟುಕೊಂಡರೂ,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ಅವನ ಆಹಾರವು ಅವನ ಕರುಳಲ್ಲಿ ಹುಳಿಯಾಗಿ,","poem":1},{"text":"ಅದು ಅವನೊಳಗಿನ ಸರ್ಪಗಳ ವಿಷವಾಗುವುದು.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ಅವನು ನುಂಗಿದ ಐಶ್ವರ್ಯವನ್ನು ಕಾರಿಬಿಡುವನು;","poem":1},{"text":"ಅವನ ಹೊಟ್ಟೆಯೊಳಗಿಂದ ದೇವರು ಅದನ್ನು ಹೊರಡಿಸಿ ಬಿಡುವನು.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ಅವನು ಸರ್ಪಗಳ ವಿಷವನ್ನು ಹೀರುವನು;","poem":1},{"text":"ಹಾವಿನ ನಾಲಿಗೆ ಅವನನ್ನು ಕೊಲ್ಲುವುದು.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ಅವನು ಜೇನು, ಮೊಸರೂ ಹರಿಯುವ ಹಳ್ಳಗಳನ್ನೂ,","poem":1},{"text":"ಸಮೃದ್ಧಿಯಾಗಿ ಹರಿಯುವ ನದಿಗಳನ್ನೂ ನೋಡನು.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ಅವನು ತನ್ನ ಪ್ರಯಾಸದ ಫಲವನ್ನು ಸವಿಯದೆ ಪರರಿಗೆ ಕೊಡಬೇಕಾಗುವುದು;","poem":1},{"text":"ಅವನು ತಾನು ಪಡೆದ ಲಾಭದ ಆನಂದವನ್ನು ಅನುಭವಿಸುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ಏಕೆಂದರೆ ಅವನು ಬಡವರನ್ನು ಜಜ್ಜಿ ಅವರನ್ನು ನಿರ್ಗತಿಕರನ್ನಾಗಿ ಮಾಡಿದನು;","poem":1},{"text":"ತಾನು ನಿರ್ಮಿಸದ ಮನೆಗಳನ್ನು ವಶಪಡಿಸಿಕೊಂಡಿದ್ದಾನೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“ಖಂಡಿತವಾಗಿ ಅವನ ಆಕಾಂಕ್ಷೆಗೆ ತೃಪ್ತಿ ಇರುವುದಿಲ್ಲ;","poem":1},{"text":"ಅವನು ತನ್ನ ಇಷ್ಟ ಸಂಪತ್ತಿನಲ್ಲಿ ಏನೂ ಉಳಿಸಿಕೊಳ್ಳುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ಅವನಿಗೆ ಆಹಾರವು ಉಳಿಯದು;","poem":1},{"text":"ಆದ್ದರಿಂದ ಅವನ ಸಮೃದ್ಧಿಯು ಅಸ್ಥಿರವಾಗಿರುವುದು.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ಅವನ ಸಮೃದ್ಧಿಯಿಂದ ತುಂಬಿರುವಾಗಲೇ ಅವನಿಗೆ ಇಕ್ಕಟ್ಟಾಗುವುದು;","poem":1},{"text":"ಘೋರ ದುಃಖವು ಅವನ ಮೇಲೆ ಬರುವುದು.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ಅವನ ಹೊಟ್ಟೆ ತುಂಬುವಾಗ,","poem":1},{"text":"ದೇವದಂಡನೆ ಅವನ ಮೇಲೆ ಬರುವುದು;","poem":2},{"lineBreak":true},{"text":"ಹೌದು, ದೇವದಂಡನೆಯು ಅವನ ಮೇಲೆ ಸುರಿಯುವುದು.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ಅವನು ಕಬ್ಬಿಣದ ಆಯುಧಕ್ಕೆ ತಪ್ಪಿಸಿಕೊಂಡು ಓಡಿಹೋದರೆ,","poem":1},{"text":"ಕಂಚಿನ ಬಾಣ ಅವನನ್ನು ತಿವಿಯುವುದು.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ಅವನು ಆ ಬಾಣವನ್ನು ಎಳೆದರೆ, ಅದು ಬೆನ್ನಿನಿಂದ ಹೊರಡುವುದು;","poem":1},{"text":"ಅವನ ಪಿತ್ತಕೋಶದಿಂದ ಅದರ ಮಿಂಚುವ ಮೊನೆ ಬರುವುದು;","poem":2},{"text":"ಸಾವಿನ ಭಯವು ಅವನನ್ನೂ ಆವರಿಸುವುದು.","poem":1}]},{"type":"verse","number":26,"content":[{"text":"ಅವನ ನಿಕ್ಷೇಪಗಳಲ್ಲಿ ಅಂಧಕಾರವು ಪೂರ್ಣವಾಗಿ ಕವಿಯುವುದು;","poem":2},{"text":"ಯಾರೂ ಹೊತ್ತಿಸದ ಬೆಂಕಿ ಅವನನ್ನು ದಹಿಸುವುದು;","poem":1},{"text":"ಅವನ ಗುಡಾರದಲ್ಲಿ ಉಳಿದದ್ದೆಲ್ಲ ನಾಶವಾಗುವುದು.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ಆಕಾಶವು ಅವನ ಅಪರಾಧವನ್ನು ಪ್ರಕಟಿಸುವುದು;","poem":1},{"text":"ಭೂಮಿಯು ಅವನಿಗೆ ವಿರೋಧವಾಗಿ ಏಳುವುದು.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ಅವನ ಮನೆಯ ಧನಧಾನ್ಯವು ತೊಲಗಿ ಹೋಗುವುದು;","poem":1},{"text":"ದೇವದಂಡನೆಯ ದಿನದಲ್ಲಿ ಅದು ಪ್ರವಾಹದಿಂದ ಕೊಚ್ಚಿಕೊಂಡು ಹೋಗುವುದು.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ದುಷ್ಟನಿಗೆ ದೇವರಿಂದ ಬರುವ ಪಾಲೂ,","poem":1},{"text":"ಅವನಿಗೆ ನೇಮವಾಗಿರುವ ಬಾಧ್ಯತೆಯೂ ಇವೇ.”","poem":2}]}],"footnotes":[{"noteId":8,"caller":"+","text":"ಅಥವಾ ಆದಾಮ","reference":{"chapter":20,"verse":4}}]},"thisChapterLink":"/api/kan_okcv/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}