{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"JOB","translationId":"kan_okcv","name":"ಯೋಬ","commonName":"ಯೋಬ","title":"ಯೋಬ","order":18,"numberOfChapters":42,"sha256":"b0f83c520d9f9fe88a86928196fe42cb3f2ca42af0fcb52b6aedc35fc7902203","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/kan_okcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":23,"content":[{"type":"heading","content":["ಯೋಬನ ಉತ್ತರ"]},{"type":"verse","number":1,"content":["ಯೋಬನು ಉತ್ತರಕೊಟ್ಟು ಹೇಳಿದ್ದೇನೆಂದರೆ:"]},{"type":"verse","number":2,"content":[{"text":"“ಇಂದಿಗೂ ನನ್ನ ದೂರು ಕಹಿಯಾಗಿದೆ;","poem":1},{"text":"ನಾನು ನಿಟ್ಟುಸಿರಿಟ್ಟರೂ ದೇವರ ಹಸ್ತವು ಭಾರವಾಗಿದೆ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ದೇವರನ್ನು ಎಲ್ಲಿ ಕಂಡುಕೊಳ್ಳಬೇಕೆಂದು ನನಗೆ ತಿಳಿದಿದ್ದರೆ, ಎಷ್ಟೋ ಒಳ್ಳೆಯದು!","poem":1},{"text":"ಸಾಧ್ಯವಾದರೆ ನಾನು ದೇವರು ವಾಸಿಸುವ ಸ್ಥಳದ ತನಕ ಹೋಗುತ್ತಿದ್ದೆ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ನನ್ನ ನ್ಯಾಯವನ್ನು ದೇವರ ಮುಂದೆ ವಿವರಿಸುತ್ತಿದ್ದೆ;","poem":1},{"text":"ನನ್ನ ಬಾಯನ್ನು ಪ್ರತಿವಾದಗಳಿಂದ ತುಂಬಿಸುತ್ತಿದ್ದೆ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ದೇವರು ನನಗೆ ಉತ್ತರವಾಗಿ ಕೊಡುವ ಮಾತುಗಳನ್ನು ಕಂಡುಹಿಡಿದು,","poem":1},{"text":"ದೇವರು ನನಗೆ ಹೇಳುವುದನ್ನು ಪರಿಗಣಿಸುತ್ತಿದ್ದೆ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ದೇವರು ನನ್ನನ್ನು ಕಠಿಣವಾಗಿ ವಿರೋಧಿಸುತ್ತಾರೋ?","poem":1},{"text":"ಇಲ್ಲ, ಖಂಡಿತವಾಗಿ ಅವರು ನನ್ನ ವಿರುದ್ಧ ಆರೋಪಗಳನ್ನು ಹೊರಿಸುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ದೇವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ಯಥಾರ್ಥವಂತನು ತಾನು ನಿರಪರಾಧಿ ಎಂದು ದೃಢಪಡಿಸಲು ಸಾಧ್ಯ;","poem":1},{"text":"ಅಲ್ಲಿ ನನಗೆ ನನ್ನ ನ್ಯಾಯಾಧಿಪತಿಯಿಂದ ಶಾಶ್ವತವಾಗಿ ಬಿಡುಗಡೆಯಾಗುವುದು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ಒಂದು ವೇಳೆ ನಾನು ಪೂರ್ವದೆಡೆಗೆ ಹೋದರೂ ದೇವರು ನನಗೆ ಕಾಣಿಸುವುದಿಲ್ಲ;","poem":1},{"text":"ಪಶ್ಚಿಮದೆಡೆಗೆ ಹೋದರೂ ದೇವರು ಕಾಣಿಸುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ಉತ್ತರದಲ್ಲಿ ಹುಡುಕಿದರೂ ದೇವರನ್ನು ನೋಡಲಾರೆನು;","poem":1},{"text":"ದಕ್ಷಿಣದೆಡೆಗೆ ತಿರುಗಿಕೊಂಡರೂ ದೇವರು ಕಾಣಿಸುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ಆದರೆ ದೇವರು ನಾನು ಹೋಗುವ ಮಾರ್ಗವನ್ನು ತಿಳಿದಿದ್ದಾರೆ;","poem":1},{"text":"ದೇವರು ನನ್ನನ್ನು ಪರೀಕ್ಷಿಸಿದಾಗ, ನಾನು ಚೊಕ್ಕ ಬಂಗಾರವಾಗಿ ಹೊರಗೆ ಬರುವೆನು.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ನನ್ನ ಪಾದಗಳು ದೇವರ ಹೆಜ್ಜೆಯ ಜಾಡಿನಲ್ಲಿ ನಿಕಟವಾಗಿ ಅನುಸರಿಸಿವೆ;","poem":1},{"text":"ದೇವರ ಮಾರ್ಗವನ್ನು ಬಿಟ್ಟು ನಾನು ತೊಲಗದಂತೆ ನೋಡಿಕೊಂಡೆನು.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ದೇವರ ತುಟಿಗಳ ಆಜ್ಞೆಯಿಂದ ನಾನು ಹಿಂಜರಿಯಲಿಲ್ಲ;","poem":1},{"text":"ನನ್ನ ದೈನಂದಿನ ಆಹಾರಕ್ಕಿಂತ ದೇವರ ಬಾಯಿಯ ಮಾತುಗಳನ್ನು","poem":2},{"lineBreak":true},{"text":"ನನ್ನೆದೆಯಲ್ಲಿ ನಿಧಿಯನ್ನಾಗಿ ಬಚ್ಚಿಟ್ಟುಕೊಂಡಿದ್ದೇನೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ಆದರೆ ದೇವರು ಬದಲಾಗದವರು; ದೇವರನ್ನು ಬದಲಾಯಿಸುವವರು ಯಾರು?","poem":1},{"text":"ದೇವರು ತಾವು ಬಯಸಿದ್ದನ್ನು ಮಾಡುತ್ತಾರೆ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ನನಗೆ ನೇಮಿಸಿದ್ದನ್ನು ದೇವರು ಈಡೇರಿಸುತ್ತಾರೆ.","poem":1},{"text":"ಇಂಥ ಅನೇಕ ಯೋಜನೆಗಳು ದೇವರಲ್ಲಿವೆ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ಆದ್ದರಿಂದ ನಾನು ದೇವರ ಮುಂದೆ ಗಾಬರಿಗೊಳ್ಳುತ್ತೇನೆ;","poem":1},{"text":"ಇದನ್ನೆಲ್ಲಾ ಗ್ರಹಿಸಿಕೊಳ್ಳುವಾಗ ನಾನು ದೇವರಿಗೆ ಭಯಪಡುತ್ತೇನೆ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ದೇವರು ನನ್ನ ಹೃದಯವನ್ನು ಹೆದರಿಸಿದ್ದಾರೆ;","poem":1},{"text":"ಸರ್ವಶಕ್ತರು ನನ್ನನ್ನು ಗಾಬರಿಪಡಿಸಿದ್ದಾರೆ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ಆದರೂ ನಾನು ಅಂಧಕಾರದಿಂದ ಮೌನವಾಗಲಿಲ್ಲ;","poem":1},{"text":"ನನ್ನ ಮುಖವನ್ನು ಕವಿದಿರುವ ಕಾರ್ಗತ್ತಲಿನ ನಿಮಿತ್ತ ನಾನು ಮಾತಾಡದೆ ಇರುವುದಿಲ್ಲ.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/kan_okcv/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}