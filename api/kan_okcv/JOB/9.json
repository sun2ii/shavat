{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"JOB","translationId":"kan_okcv","name":"ಯೋಬ","commonName":"ಯೋಬ","title":"ಯೋಬ","order":18,"numberOfChapters":42,"sha256":"b0f83c520d9f9fe88a86928196fe42cb3f2ca42af0fcb52b6aedc35fc7902203","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/kan_okcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":9,"content":[{"type":"heading","content":["ಯೋಬನ ಪ್ರತಿವಾದ"]},{"type":"verse","number":1,"content":["ಅದಕ್ಕೆ ಯೋಬನು ಉತ್ತರಿಸುತ್ತಾ ಇಂತೆಂದನು:"]},{"type":"verse","number":2,"content":[{"text":"“ನಿಜಕ್ಕೂ, ಇದು ಸತ್ಯ ಎಂದು ಬಲ್ಲೆನು;","poem":1},{"text":"ಆದರೆ ಮನುಷ್ಯರು ದೇವರ ಮುಂದೆ ತಮ್ಮ ಮುಗ್ಧತೆಯನ್ನು ಪ್ರಮಾಣಿಕರಿಸುವುದು ಹೇಗೆ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ದೇವರ ಸಂಗಡ ವ್ಯಾಜ್ಯವಾಡಲು ಮನುಷ್ಯನು ಬಯಸಿದರೂ,","poem":1},{"text":"ದೇವರ ಸಾವಿರ ಪ್ರಶ್ನೆಗಳಲ್ಲಿ ಒಂದಕ್ಕೂ ಉತ್ತರ ಕೊಡಲಾರನು.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ದೇವರ ಜ್ಞಾನವು ಆಳವಾದದ್ದು, ಶಕ್ತಿಯಲ್ಲಿ ದೇವರು ಪ್ರಬಲರೂ ಆಗಿದ್ದಾರೆ;","poem":1},{"text":"ದೇವರ ವಿರೋಧವಾಗಿ ತನ್ನನ್ನು ಕಠಿಣಪಡಿಸಿಕೊಂಡು ವೃದ್ಧಿಯಾಗುವವನು ಯಾರು?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ದೇವರು ಪರ್ವತಗಳನ್ನು ಅವುಗಳಿಗೆ ತಿಳಿಯದ ಹಾಗೆ ಸರಿಸುತ್ತಾರೆ;","poem":1},{"text":"ತಮ್ಮ ಎದುರಿನಲ್ಲಿ ಅವುಗಳನ್ನು ತಿರುಗಿಸುತ್ತಾರೆ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ಭೂಮಿಯನ್ನು ಅದರ ಸ್ಥಳದೊಳಗಿಂದ ಕದಲಿಸುತ್ತಾರೆ;","poem":1},{"text":"ಅದರ ಸ್ತಂಭಗಳು ನಡುಗುತ್ತವೆ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ದೇವರು ಸೂರ್ಯನಿಗೆ ಪ್ರಕಾಶಿಸದಂತೆ ಅಪ್ಪಣೆ ಕೊಟ್ಟರೆ, ಪ್ರಕಾಶಿಸುತ್ತಿರಲಿಲ್ಲ;","poem":1},{"text":"ನಕ್ಷತ್ರಗಳಿಗೆ ಮುದ್ರೆ ಹಾಕಿದ್ದರೆ, ನಕ್ಷತ್ರವೂ ಮಿನುಗುತ್ತಿರಲಿಲ್ಲ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ದೇವರೊಬ್ಬರೇ ಆಕಾಶಗಳನ್ನು ಹರಡಿಸುತ್ತಾರೆ;","poem":1},{"text":"ದೇವರು ಸಮುದ್ರದ ತೆರೆಗಳ ಮೇಲೆ ನಡೆಯುತ್ತಾರೆ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ಸಪ್ತರ್ಷಿಮಂಡಲವನ್ನೂ, ಮೃಗಶಿರವನ್ನೂ,","poem":1},{"text":"ಕೃತ್ತಿಕೆಯನ್ನೂ ದಕ್ಷಿಣ ದಿಕ್ಕಿನ ನಕ್ಷತ್ರಗ್ರಹಗಳನ್ನೂ ನಿರ್ಮಿಸಿದವರು ದೇವರೇ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ದೇವರು ಕಂಡು ಹಿಡಿಯಲಾರದಂಥ ಮಹತ್ಕಾರ್ಯಗಳನ್ನೂ,","poem":1},{"text":"ಲೆಕ್ಕವಿಲ್ಲದಷ್ಟು ಅದ್ಭುತಗಳನ್ನೂ ಮಾಡುತ್ತಾರೆ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ದೇವರು ನನ್ನ ಮುಂದೆ ಹಾದುಹೋದಾಗ, ನನಗೆ ಅವರು ಕಾಣುವುದಿಲ್ಲ;","poem":1},{"text":"ದೇವರು ದಾಟಿ ಹೋಗುತ್ತಾರೆ; ಆದರೆ ನಾನು ಅವರನ್ನು ಗ್ರಹಿಸಿಕೊಳ್ಳುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ದೇವರು ತೆಗೆದುಕೊಂಡರೆ, ಅವರಿಗೆ ಅಡ್ಡಿ ಮಾಡುವವರು ಯಾರು?","poem":1},{"text":"ದೇವರನ್ನು, ‘ನೀವು ಏನು ಮಾಡುತ್ತೀರಿ?’ ಎಂದು ಕೇಳುವವರ‍್ಯಾರು.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ದೇವರು ತಮ್ಮ ಬೇಸರವನ್ನು ವ್ಯಕ್ತಪಡಿಸುತ್ತಾರೆ;","poem":1},{"text":"ರಹಾಬನ","poem":2},{"noteId":6},{"text":"ಸಹಾಯಕರು ಸಹ ದೇವರ ಕಾಲಿಗೆ ಅಡ್ಡಬಿದ್ದರಲ್ಲಾ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ದೇವರೊಂದಿಗೆ ವಾದಿಸಲು ನಾನು ಅಶಕ್ತನು;","poem":1},{"text":"ದೇವರಿಗೆ ತಕ್ಕ ಉತ್ತರ ಕೊಡಲು ನಾನು ಎಷ್ಟರವನು?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ನಾನು ನೀತಿವಂತನಾಗಿದ್ದರೂ ಉತ್ತರ ಕೊಡೆನು;","poem":1},{"text":"ಆದರೆ ನನ್ನ ನ್ಯಾಯಾಧಿಪತಿಗೆ ಕರುಣೆಗೋಸ್ಕರ ಮೊರೆಯಿಡುವೆನು.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ನಾನು ಕರೆಯಲು ದೇವರು ನನಗೆ ಉತ್ತರ ಕೊಟ್ಟರೂ,","poem":1},{"text":"ನನ್ನ ವಿಜ್ಞಾಪನೆಗೆ ದೇವರು ಕಿವಿಗೊಡುವರೆಂದು ನಾನು ನಂಬುತ್ತಿರಲಿಲ್ಲ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ಏಕೆಂದರೆ ದೇವರು ಬಿರುಗಾಳಿಯಿಂದ ನನ್ನನ್ನು ಬಡಿಯುತ್ತಾರೆ;","poem":1},{"text":"ನನ್ನ ಗಾಯಗಳನ್ನು ಕಾರಣವಿಲ್ಲದೆ ಹೆಚ್ಚಿಸುತ್ತಾರೆ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ನಾನು ಉಸಿರಾಡಲು ಕಷ್ಟಪಡುತ್ತಿದ್ದೇನೆ,","poem":1},{"text":"ದೇವರು ಕಹಿಯಾದವುಗಳಿಂದ ನನ್ನನ್ನು ತುಂಬಿಸುತ್ತಾರೆ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ಶಕ್ತಿಯ ವಿಷಯದಲ್ಲಿ ಹೇಳಬೇಕಾದರೆ, ಇಗೋ ದೇವರು ಬಲಶಾಲಿ!","poem":1},{"text":"ನ್ಯಾಯದ ವಿಷಯದಲ್ಲಿ ವಾದಿಸಬೇಕಾದರೆ, ದೇವರಿಗೆ ಸವಾಲು ಹಾಕುವವರು ಯಾರು?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ನಾನು ನೀತಿವಂತನಾಗಿದ್ದರೂ, ನನ್ನ ಸ್ವಂತ ಬಾಯೇ ನನ್ನನ್ನು ಖಂಡಿಸುತ್ತದೆ;","poem":1},{"text":"ನಾನು ನಿರ್ದೋಷಿಯಾಗಿದ್ದರೂ, ದೇವರು ನನ್ನನ್ನು ಅಪರಾಧಿ ಎಂದು ನಿರೂಪಿಸುವರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“ನಾನು ನಿರ್ದೋಷಿಯೇ ಹೌದು,","poem":1},{"text":"ನನ್ನ ಬಗ್ಗೆ ನನಗೆ ಚಿಂತೆ ಇಲ್ಲ;","poem":2},{"lineBreak":true},{"text":"ನನ್ನ ಬಾಳನ್ನೇ ತಿರಸ್ಕಾರ ಮಾಡುತ್ತೇನೆ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ಇದೆಲ್ಲಾ ಒಂದೇ ವಿಷಯ; ಆದ್ದರಿಂದ ನಾನು ಇದನ್ನು ಹೇಳುತ್ತೇನೆ:","poem":1},{"text":"‘ನಿರ್ದೋಷಿಯನ್ನೂ, ಕೆಟ್ಟವನನ್ನೂ ದೇವರು ದಂಡಿಸುತ್ತಾರೆ.’","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ವಿಪತ್ತು ಅಕಸ್ಮಾತ್ತಾಗಿ ಮರಣವನ್ನು ತಂದರೆ,","poem":1},{"text":"ನಿರಪರಾಧಿಯ ಬುದ್ಧಿಹೀನತೆಗೆ ದೇವರು ನಗುವರು.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ಲೋಕವು ಕೆಟ್ಟವರ ಕೈವಶವಾಗಿದೆ;","poem":1},{"text":"ನ್ಯಾಯಾಧಿಪತಿಗಳ ಮುಖಕ್ಕೆ ಮುಸುಕುಹಾಕಲಾಗಿದೆ;","poem":2},{"lineBreak":true},{"text":"ಇದನ್ನು ಅನುಮತಿಸಿದವರು ದೇವರಲ್ಲದೆ ಮತ್ತೆ ಯಾರು?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“ಆದರೆ ನನ್ನ ದಿನಗಳು ಅಂಚೆಯವನಿಗಿಂತಲೂ ತ್ವರೆಯಾಗಿವೆ;","poem":1},{"text":"ಆನಂದವನ್ನೂ ನೋಡದೆ ದಿನಗಳು ಓಡಿಹೋಗುತ್ತವೆ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ಆಪಿನ ದೋಣಿಗಳು ದಾಟಿ ಹೋಗುವಂತೆಯೂ,","poem":1},{"text":"ಹದ್ದು ತನ್ನ ಬೇಟೆಯ ಮೇಲೆ ಎರಗುವಂತೆಯೂ ದಿನಗಳು ವೇಗವಾಗಿ ಗತಿಸಿಹೋಗುತ್ತವೆ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"‘ನಾನು ನನ್ನ ದೂರುಗಳನ್ನು ಮರೆತು,","poem":1},{"text":"ನನ್ನ ಭಾರವನ್ನು ಬಿಟ್ಟು, ಆದರಣೆ ಹೊಂದುವೆನು,’ ಎಂದು ತೀರ್ಮಾನಿಸಿಕೊಂಡರೆ,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ನನಗಾದ ವ್ಯಥೆಗಳಿಗೆಲ್ಲಾ ನಾನು ಇನ್ನೂ ಹೆದರುತ್ತಿದ್ದೇನೆ;","poem":1},{"text":"ದೇವರು ನನ್ನನ್ನು ನಿರಪರಾಧಿ ಎಂದು ಎಣಿಸುವುದಿಲ್ಲವೆಂದು ಸಹ ನನಗೆ ಗೊತ್ತಿದೆ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ನಾನು ಈಗಾಗಲೇ ಅಪರಾಧಿ ಎಂದು ನಿರ್ಣಯವಾಗಿರುವಾಗ,","poem":1},{"text":"ನಾನು ಏಕೆ ವ್ಯರ್ಥವಾಗಿ ಹೋರಾಡಬೇಕು?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ನಾನು ಹಿಮದ ನೀರಿನಲ್ಲಿ ಸ್ನಾನಮಾಡಿ,","poem":1},{"text":"ಸಾಬೂನಿನಿಂದ ನನ್ನ ಕೈಗಳನ್ನು ತೊಳೆದುಕೊಂಡರೂ,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ದೇವರು ನನ್ನನ್ನು ಕುಣಿಯಲ್ಲಿ ಮುಳುಗಿಸಿ ಬಿಡುವರು;","poem":1},{"text":"ನನ್ನ ಸ್ವಂತ ವಸ್ತ್ರಗಳೇ ನನ್ನನ್ನು ಅಸಹ್ಯಪಡಬೇಕಾಗುವುದು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"“ದೇವರು ನನ್ನಂಥ ಕೇವಲ ಮನುಷ್ಯನಲ್ಲ, ನಾನು ದೇವರೊಂದಿಗೆ ವಾದಿಸುವುದು ಹೇಗೆ?","poem":1},{"text":"ನಾವಿಬ್ಬರೂ ನ್ಯಾಯಾಲಯದ ಮುಂದೆ ಕೂಡಿ ವಾದಿಸುವುದು ಹೇಗೆ?","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ನಮ್ಮಿಬ್ಬರನ್ನು ಒಟ್ಟು ಸೇರಿಸುವ","poem":1},{"text":"ಮಧ್ಯಸ್ಥ ಒಂದು ವೇಳೆ ನಮ್ಮ ನಡುವೆ ಇದ್ದಿದ್ದರೆ,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ದೇವರ ಶಿಕ್ಷೆಯಕೋಲನ್ನು ನನ್ನ ಮೇಲಿನಿಂದ ತೊಲಗಿಸುವ ಒಬ್ಬ ಮಧ್ಯಸ್ಥ ಇದ್ದಿದ್ದರೆ,","poem":1},{"text":"ದೇವರ ಭೀತಿಗೆ ನಾನು ಎಂದಿಗೂ ಹೆದರದೆ ಇರುತ್ತಿದ್ದೆ.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ಆಗ ನಾನು ದೇವರೊಂದಿಗೆ ಭಯಪಡದೆ ಮಾತನಾಡುತ್ತಿದ್ದೆ;","poem":1},{"text":"ನನ್ನ ಸ್ವಂತ ಶಕ್ತಿಯಿಂದ ಈಗ ನಾನು ಅದನ್ನೆಲ್ಲಾ ನನಗೆ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":6,"caller":"+","text":"ರಹಾಬನ ಅಥವಾ ಲೆವಿಯಾತಾನ ಎಂಬ ಪ್ರಾಣಿ","reference":{"chapter":9,"verse":13}}]},"thisChapterLink":"/api/kan_okcv/JOB/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/JOB/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/JOB/8.json","previousChapterAudioLinks":{},"numberOfVerses":35}