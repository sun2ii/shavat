{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"PRO","translationId":"kan_okcv","name":"ಜ್ಞಾನೋಕ್ತಿಗಳು","commonName":"ಜ್ಞಾನೋಕ್ತಿಗಳು","title":"ಜ್ಞಾನೋಕ್ತಿಗಳು","order":20,"numberOfChapters":31,"sha256":"db78a84ced0f5c6868005c76f5f2e0a81d61a265338d0405b06b96bd084f0f0e","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kan_okcv/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["ಇಸ್ರಾಯೇಲರ ಅರಸನೂ ದಾವೀದನ ಮಗನೂ ಆದ ಸೊಲೊಮೋನನ ಜ್ಞಾನೋಕ್ತಿಗಳು:"]},{"type":"verse","number":2,"content":[{"text":"ಜನರು ಜ್ಞಾನವನ್ನೂ ಶಿಸ್ತನ್ನೂ ಪಡೆದುಕೊಳ್ಳುವುದಕ್ಕೆ;","poem":1},{"text":"ವಿವೇಕದ ಮಾತುಗಳನ್ನು ಗ್ರಹಿಸುವುದಕ್ಕೆ;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ಅಂದರೆ, ಶಿಕ್ಷಣ, ವಿವೇಕ ನಡವಳಿ, ಸರಿಯಾದದ್ದನ್ನು ಮಾಡುವುದು","poem":1},{"text":"ನ್ಯಾಯ ಮತ್ತು ಯುಕ್ತವಾದವುಗಳನ್ನು ನಡೆಸುವ ಜ್ಞಾನೋಕ್ತಿಗಳು;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ಮುಗ್ಧರಿಗೆ ವಿವೇಕವನ್ನೂ ಯೌವನಸ್ಥರಿಗೆ ತಿಳುವಳಿಕೆ ಹಾಗೂ","poem":1},{"text":"ಸ್ವವಿವೇಚನೆಯನ್ನೂ ಕೊಡುವುದಕ್ಕಾಗಿ ಈ ಜ್ಞಾನೋಕ್ತಿಗಳಿವೆ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ಜ್ಞಾನಿಯು ಜ್ಞಾನೋಕ್ತಿಗಳನ್ನು ಕೇಳಿ, ಜ್ಞಾನವನ್ನು ಹೆಚ್ಚಿಸಿಕೊಳ್ಳಲಿ;","poem":1},{"text":"ವಿವೇಚಿಸುವವರು ಮಾರ್ಗದರ್ಶನವನ್ನು ಹೊಂದಿಕೊಳ್ಳಲಿ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ಜ್ಞಾನೋಕ್ತಿಗಳನ್ನು, ಸಾಮ್ಯಗಳನ್ನು, ಜ್ಞಾನಿಗಳ ಮಾತು ಹಾಗೂ ಒಗಟುಗಳನ್ನು","poem":1},{"text":"ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಇವು ಬರೆಯಲಾಗಿವೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ಯೆಹೋವ ದೇವರ ಭಯವೇ ಜ್ಞಾನದ ಮೂಲವಾಗಿದೆ.","poem":1},{"text":"ಆದರೆ ಮೂರ್ಖರು ಜ್ಞಾನವನ್ನೂ ಶಿಕ್ಷಣವನ್ನೂ ಅಸಡ್ಡೆ ಮಾಡುತ್ತಾರೆ.","poem":2}]},{"type":"heading","content":["ಪಾಪ ಸಂಬಧಿತ ಎಚ್ಚರಿಕೆ"]},{"type":"verse","number":8,"content":[{"text":"ಮಗನೇ, ನಿನ್ನ ತಂದೆಯ ಶಿಕ್ಷಣಗಳನ್ನು ಕೇಳು,","poem":1},{"text":"ನಿನ್ನ ತಾಯಿಯ ಉಪದೇಶವನ್ನು ತೊರೆಯಬೇಡ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ಅವು ನಿನ್ನ ತಲೆಗೆ ಸುಂದರ ಕಿರೀಟ","poem":1},{"text":"ನಿನ್ನ ಕೊರಳನ್ನು ಅಲಂಕರಿಸುವ ಹಾರ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ಮಗನೇ, ಪಾಪಿಗಳು ನಿನ್ನನ್ನು ಸೆಳೆದರೆ","poem":1},{"text":"ನೀನು ಒಪ್ಪಬೇಡ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ಒಂದು ವೇಳೆ ಅವರು ನಿನಗೆ, “ನಮ್ಮೊಂದಿಗೆ ಬಾ,","poem":1},{"text":"ಜನರ ರಕ್ತಕ್ಕಾಗಿ ಒಳಸಂಚು ಮಾಡೋಣ,","poem":2},{"lineBreak":true},{"text":"ನಿರಪರಾಧಿಯ ರಕ್ತಕ್ಕಾಗಿ;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ಸಮಾಧಿಯು ನುಂಗುವಂತೆ ಜೀವಂತವಾಗಿ ಅವರನ್ನು ದಾಳಿಮಾಡೋಣ","poem":1},{"text":"ಗುಂಡಿಯೊಳಕ್ಕೆ ಹೋಗುವವರನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ನಾವು ಅವರನ್ನು ನುಂಗಿಬಿಡೋಣ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ಅಮೂಲ್ಯವಾದ ಸೊತ್ತನ್ನೆಲ್ಲಾ ನಾವು ಕಂಡುಹಿಡಿದು","poem":1},{"text":"ಕೊಳ್ಳೆಹೊಡೆದು ನಮ್ಮ ಮನೆಗಳನ್ನು ತುಂಬಿಕೊಳ್ಳೋಣ;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ನೀನು ನಮ್ಮ ಮಧ್ಯದಲ್ಲಿ ಚೀಟನ್ನು ಹಾಕು,","poem":1},{"text":"ನಾವೆಲ್ಲರೂ ಹಣಹಂಚಿಕೊಳ್ಳೋಣ,” ಎಂದು ಹೇಳುವುದಾದರೆ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ಮಗನೇ, ಅವರೊಂದಿಗೆ ಸೇರಬೇಡ,","poem":1},{"text":"ಅವರ ಮಾರ್ಗದಲ್ಲಿ ಹೆಜ್ಜೆಯಿಡಬೇಡ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ಏಕೆಂದರೆ ಅವರ ಪಾದಗಳು ಕೇಡಿಗೆ ಓಡುತ್ತವೆ,","poem":1},{"text":"ರಕ್ತಸುರಿಸುವುದಕ್ಕೆ ಆತುರಪಡುತ್ತವೆ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ಪಕ್ಷಿಗಳ ಕಣ್ಣೆದುರಿಗೆ ಕಾಣುವಂತೆ","poem":1},{"text":"ಬಲೆಯನ್ನು ಹರಡುವುದು ವ್ಯರ್ಥವಲ್ಲವೇ!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ಈ ಜನರು ಒಳಸಂಚು ಮಾಡುವುದು ತಮ್ಮ ಸ್ವಂತ ರಕ್ತಕ್ಕೆ.","poem":1},{"text":"ಅವರು ಮಾಡುವ ದುರಾಲೋಚನೆ ಅವರನ್ನೇ ನಾಶಮಾಡುವುದು.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ಅಕ್ರಮ ಲಾಭದ ಬೆನ್ನಟ್ಟಿ ಹೋಗುವವರೆಲ್ಲರ ಗತಿ ಇದೇ.","poem":1},{"text":"ಕೊಳ್ಳೆಯು ಕೊಳ್ಳೆಗಾರರ ಜೀವವನ್ನೇ ಕೊಳ್ಳೆಮಾಡುವದು.","poem":2}]},{"type":"heading","content":["ಜ್ಞಾನವನ್ನು ತಿರಸ್ಕರಿಸುವವರ ವಿರುದ್ಧ ಎಚ್ಚರಿಕೆ"]},{"type":"verse","number":20,"content":[{"text":"ಜ್ಞಾನವೆಂಬಾಕೆಯು ಬೀದಿಯಲ್ಲಿ ಕೂಗುತ್ತಾಳೆ,","poem":1},{"text":"ಬಹಿರಂಗ ಸ್ಥಳಗಳಲ್ಲಿ ಆಕೆಯು ತನ್ನ ಧ್ವನಿಗೈಯುತ್ತಾಳೆ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ಜನಭರಿತ ಬೀದಿಗಳಲ್ಲಿ ಆಕೆ ಕರೆಯುತ್ತಾಳೆ,","poem":1},{"text":"ಪಟ್ಟಣದ ಹೆಬ್ಬಾಗಿಲುಗಳಲ್ಲಿ ಹೀಗೆಂದು ಭಾಷಣ ಮಾಡುತ್ತಾಳೆ:","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“ಮುಗ್ಧರೇ ನೀವು ಎಷ್ಟು ಕಾಲ ಮುಗ್ಧತೆಯನ್ನು ಪ್ರೀತಿಸುವಿರಿ.","poem":1},{"text":"ಕುಚೋದ್ಯಗಾರರೇ ಎಷ್ಟು ಕಾಲ ಕುಚೋದ್ಯಗಾರರಾಗಿರಲು ಇಚ್ಛಿಸುವಿರಿ?","poem":2},{"lineBreak":true},{"text":"ಜ್ಞಾನಹೀನರೇ, ಎಷ್ಟು ಕಾಲ ಪರಿಜ್ಞಾನವನ್ನು ಹಗೆ ಮಾಡುವಿರಿ?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ನನ್ನ ಗದರಿಕೆ ಕೇಳಿ ನೀವು ಪಶ್ಚಾತ್ತಾಪಪಡಿರಿ!","poem":1},{"text":"ಆಗ ನಿಮ್ಮ ಮೇಲೆ ನನ್ನ ಆತ್ಮವನ್ನು ಸುರಿಸಿ,","poem":2},{"lineBreak":true},{"text":"ನಿಮಗೆ ನನ್ನ ಬೋಧನೆಗಳನ್ನು ಪ್ರಕಟಿಸುವೆನು.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ನಾನು ಕರೆದಾಗ ನೀವು ನನ್ನನ್ನು ತಿರಸ್ಕರಿಸಿದ್ದೀರಿ","poem":1},{"text":"ನಾನು ನನ್ನ ಕೈಚಾಚಿದಾಗ ಯಾರೂ ಮನುಷ್ಯನೂ ಗಮನಿಸಲಿಲ್ಲ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ನನ್ನ ಆಲೋಚನೆಯನ್ನು ನೀವು ಲಕ್ಷಿಸದೆ;","poem":1},{"text":"ನನ್ನ ಗದರಿಕೆಯನ್ನು ನೀವು ಬೇಡವೆಂದು ತಳ್ಳಿಬಿಟ್ಟಿದ್ದರಿಂದ","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ಬಿರುಗಾಳಿಯಂತೆ ನಿಮಗೆ ವಿಪತ್ತು ಬಂದಾಗ ನಾನು ನಗುವೆನು.","poem":1},{"text":"ಆಪತ್ತು ನಿಮ್ಮನ್ನು ಹಿಂದಿಕ್ಕಿದಾಗ, ನಾನು ಪರಿಹಾಸ್ಯ ಮಾಡುವೆನು.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ಚಂಡಮಾರುತವು ನಿಮ್ಮನ್ನು ಬಿರುಗಾಳಿಯಂತೆ ತಾಕಿದಾಗ,","poem":1},{"text":"ವಿಪತ್ತು ಸುಂಟರಗಾಳಿಯಂತೆ ನಿಮ್ಮ ಮೇಲೆ ಬೀಸಿದಾಗ,","poem":2},{"lineBreak":true},{"text":"ಯಾತನೆ ಮತ್ತು ತೊಂದರೆ ನಿಮ್ಮನ್ನು ಆವರಿಸಿದಾಗಲೂ ಪರಿಹಾಸ್ಯಕ್ಕೆ ಒಳಗಾಗುವಿರಿ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“ಆಗ ಅವರು ನನಗೆ ಮೊರೆಯಿಡುವರು, ಆದರೆ ನಾನು ಅವರಿಗೆ ಉತ್ತರ ಕೊಡೆನು.","poem":1},{"text":"ಅವರು ನನ್ನನ್ನು ಆತುರದಿಂದ ಹುಡುಕುವರು, ಆದರೆ ಅವರು ನನ್ನನ್ನು ಕಂಡುಕೊಳ್ಳುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ಏಕೆಂದರೆ ಅವರು ಅರಿವನ್ನು ಹಗೆಮಾಡಿ,","poem":1},{"text":"ಯೆಹೋವ ದೇವರಿಗೆ ಭಯಪಡುವುದನ್ನು ಆರಿಸಿಕೊಳ್ಳದೆ ಹೋದರು.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ನನ್ನ ಬುದ್ಧಿವಾದವನ್ನು ಸ್ವೀಕರಿಸದೆ,","poem":1},{"text":"ನನ್ನ ಗದರಿಕೆಯನ್ನೆಲ್ಲಾ ಅಸಡ್ಡೆ ಮಾಡಿದರು.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ಅವರು ತಮ್ಮ ಸ್ವಂತ ನಡತೆಯ ಫಲವನ್ನು ಅನುಭವಿಸಿ,","poem":1},{"text":"ತಮ್ಮ ಸ್ವಂತ ಕುಯುಕ್ತಿಗಳಿಂದಲೇ ಹೊಟ್ಟೆ ತುಂಬಿಕೊಳ್ಳುವರು.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ಮುಗ್ಧರ ದಾರಿತಪ್ಪುವಿಕೆಯು ಅವರನ್ನು ಕೊಲ್ಲುವುದು.","poem":1},{"text":"ಜ್ಞಾನಹೀನರ ನಿಶ್ಚಿಂತೆಯು ಅವರನ್ನು ನಾಶಮಾಡುವುದು.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ನನಗೆ ಕಿವಿಗೊಡುವವರಾದರೋ ಸುರಕ್ಷಿತರಾಗಿ ಜೀವಿಸುವರು,","poem":1},{"text":"ಕೇಡಿನ ಭಯವಿಲ್ಲದೇ ನೆಮ್ಮದಿಯಿಂದ ಇರುವರು.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kan_okcv/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}