{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"PRO","translationId":"kan_okcv","name":"ಜ್ಞಾನೋಕ್ತಿಗಳು","commonName":"ಜ್ಞಾನೋಕ್ತಿಗಳು","title":"ಜ್ಞಾನೋಕ್ತಿಗಳು","order":20,"numberOfChapters":31,"sha256":"db78a84ced0f5c6868005c76f5f2e0a81d61a265338d0405b06b96bd084f0f0e","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kan_okcv/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"ಜ್ಞಾನಿಯಾದ ಸ್ತ್ರೀಯು ತನ್ನ ಮನೆಯನ್ನು ಕಟ್ಟುತ್ತಾಳೆ;","poem":1},{"text":"ಬುದ್ಧಿಹೀನಳೋ ತನ್ನ ಕೈಗಳಿಂದಲೇ ಅದನ್ನು ಕಿತ್ತುಹಾಕುತ್ತಾಳೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ತನ್ನ ಯಥಾರ್ಥತೆಯಲ್ಲಿ ನಡೆಯುವವನು ಯೆಹೋವ ದೇವರಿಗೆ ಭಯಪಡುತ್ತಾನೆ,","poem":1},{"text":"ಆದರೆ ಅವರನ್ನು ತಿರಸ್ಕರಿಸುವವರು ತಮ್ಮ ಮಾರ್ಗಗಳಲ್ಲಿ ಮೋಸ ಹೋಗುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ಬುದ್ಧಿಹೀನನ ಬಾಯಿಯಲ್ಲಿ ಗರ್ವದ ಅಂಕುರವಿದೆ,","poem":1},{"text":"ಆದರೆ ಜ್ಞಾನವಂತರ ತುಟಿಗಳು ಅವರನ್ನು ಕಾಪಾಡುವುವು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ಎತ್ತುಗಳು ಇಲ್ಲದೆ ಇರುವಲ್ಲಿ ಗೋದಲಿಯು ಶುಚಿಯಾಗಿರುತ್ತದೆ,","poem":1},{"text":"ಆದರೆ ಎತ್ತಿನ ಬಲದಿಂದಲೇ ಬೆಳೆಯು ಹೇರಳವಾಗಿ ವೃದ್ಧಿಯಾಗುತ್ತದೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ಪ್ರಾಮಾಣಿಕ ಸಾಕ್ಷಿಯು ಸುಳ್ಳಾಡನು,","poem":1},{"text":"ಆದರೆ ಸುಳ್ಳುಸಾಕ್ಷಿಯು ಅಸತ್ಯವನ್ನೇ ಆಡುವನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ಅಪಹಾಸ್ಯ ಮಾಡುವವನು ಜ್ಞಾನವನ್ನು ಹುಡುಕಿದರೂ ಅದನ್ನು ಕಂಡುಕೊಳ್ಳುವುದಿಲ್ಲ,","poem":1},{"text":"ಆದರೆ ವಿವೇಚಿಸುವವನಿಗೆ ಜ್ಞಾನವು ಸುಲಭವಾಗಿದೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ನೀನು ಬುದ್ಧಿಹೀನನ ತುಟಿಗಳಲ್ಲಿ ಪರಿಜ್ಞಾನವನ್ನು ಕಾಣದೆ ಹೋದರೆ,","poem":1},{"text":"ಅವನ ಬಳಿಯಿಂದ ಹೊರಟು ಹೋಗು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ಜಾಣನ ಜ್ಞಾನವು ತನ್ನ ಮಾರ್ಗಗಳಿಗೆ ಆಲೋಚನೆ ನೀಡುತ್ತದೆ.","poem":1},{"text":"ಮೂಢರ ಬುದ್ಧಿಹೀನತೆಯು ಮೋಸಕರ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ಬುದ್ಧಿಹೀನರು ಪಾಪಪರಿಹಾರವನ್ನು ಅಪಹಾಸ್ಯ ಮಾಡುವರು,","poem":1},{"text":"ಆದರೆ ನೀತಿವಂತರಿಗೆ ದಯೆಯಿದೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ಹೃದಯಕ್ಕೆ ತನ್ನ ವ್ಯಥೆಯು ಗೊತ್ತು;","poem":1},{"text":"ಪರನು ಅದರ ಸಂತೋಷದಲ್ಲಿ ಪಾಲಾಗುವುದಿಲ್ಲ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ದುಷ್ಟರ ಮನೆಯು ನಾಶವಾಗುವುದು,","poem":1},{"text":"ಆದರೆ ಯಥಾರ್ಥವಂತರ ಗುಡಾರವು ಏಳಿಗೆಯಾಗುವುದು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ಮನುಷ್ಯ ದೃಷ್ಟಿಗೆ ಸರಿ ತೋರುವ ಒಂದು ಮಾರ್ಗವಿದೆ,","poem":1},{"text":"ಆದರೆ ಅದರ ಅಂತ್ಯವು ಮರಣದ ಮಾರ್ಗಗಳೇ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ನಗೆಯಲ್ಲಿಯೂ ಹೃದಯವು ದುಃಖದಿಂದ ಇರುವುದು,","poem":1},{"text":"ಅದರ ಉಲ್ಲಾಸದ ಅಂತ್ಯವು ಸಂತಾಪವೇ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ಭ್ರಷ್ಟನು ತನ್ನ ದುಷ್ಕರ್ಮಗಳಿಂದ ದಣಿಯನು,","poem":1},{"text":"ಒಳ್ಳೆಯವನು ತನ್ನಲ್ಲಿ ತಾನೇ ತೃಪ್ತಿಹೊಂದುವನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ಅರಿವಿಲ್ಲದವರು ಯಾವ ಮಾತನ್ನಾದರೂ ನಂಬುತ್ತಾರೆ,","poem":1},{"text":"ಜಾಣನು ತನ್ನ ನಡತೆಯನ್ನು ಚೆನ್ನಾಗಿ ಗಮನಿಸುವನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ಜ್ಞಾನಿಯು ಯೆಹೋವ ದೇವರಿಗೆ ಭಯಪಟ್ಟು ಕೆಟ್ಟತನದಿಂದ ದೂರ ಹೋಗುವನು,","poem":1},{"text":"ಆದರೆ ಬುದ್ಧಿಹೀನನು ಯೋಚಿಸದೆ ಆತ್ಮವಿಶ್ವಾಸದಿಂದ ನಡೆಯುವನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ಮುಂಗೋಪಿಯು ಬುದ್ಧಿಹೀನನಾಗಿ ವರ್ತಿಸುತ್ತಾನೆ,","poem":1},{"text":"ಜನರು ಕುಯುಕ್ತಿಯುಳ್ಳವನನ್ನು ಹಗೆ ಮಾಡುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ಅರಿವಿಲ್ಲದವರು ಮೂರ್ಖತನಕ್ಕೆ ಬಾಧ್ಯರಾಗುತ್ತಾರೆ,","poem":1},{"text":"ಆದರೆ ಜಾಣರು ಪರಿಜ್ಞಾನದಿಂದ ಆವರಿಸುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ದುಷ್ಟರು ಒಳ್ಳೆಯವರಿಗೆ ಬಾಗುತ್ತಾರೆ,","poem":1},{"text":"ದುಷ್ಟರು ನೀತಿವಂತರ ದ್ವಾರಗಳಲ್ಲಿ ಅಡ್ಡ ಬೀಳುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ಬಡವನು ಅವನ ನೆರೆಯವನಿಂದಲೇ ಕಡೆಗಣಿಸಲಾಗುವನು;","poem":1},{"text":"ಆದರೆ ಐಶ್ವರ್ಯವಂತನಿಗೆ ಬಹುಜನ ಮಿತ್ರರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ತನ್ನ ನೆರೆಯವನನ್ನು ಅವಮಾನ ಮಾಡುವವನು ಪಾಪಮಾಡುತ್ತಾನೆ,","poem":1},{"text":"ಬಡವರ ಮೇಲೆ ಕನಿಕರ ತೋರಿಸುವವನು ಧನ್ಯನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ಕೆಟ್ಟದ್ದನ್ನು ಕಲ್ಪಿಸುವವರು ದಾರಿ ತಪ್ಪುವುದಿಲ್ಲವೇ?","poem":1},{"text":"ಆದರೆ ಒಳ್ಳೆಯದನ್ನು ಕಲ್ಪಿಸುವವರಿಗೆ ಪ್ರೀತಿ ಸತ್ಯತೆಯು ಇರುವುವು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ಎಲ್ಲಾ ಪ್ರಯಾಸದಲ್ಲಿ ಲಾಭವಿದೆ,","poem":1},{"text":"ಹರಟೆ ಮಾತು ಬಡತನಕ್ಕೆ ಮಾತ್ರ ದಾರಿ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ಜ್ಞಾನವಂತರ ಕಿರೀಟವೇ ಅವರ ಸಂಪತ್ತು,","poem":1},{"text":"ಆದರೆ ಬುದ್ಧಿಹೀನರ ಬುದ್ಧಿಹೀನತೆಯು ಅವರ ಮೂರ್ಖತನವನ್ನು ನೀಡುತ್ತದೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ಸತ್ಯಸಾಕ್ಷಿಯು ಪ್ರಾಣಗಳನ್ನು ರಕ್ಷಿಸುತ್ತಾನೆ,","poem":1},{"text":"ಸುಳ್ಳುಸಾಕ್ಷಿಯು ಮೋಸಗಾರನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ಯೆಹೋವ ದೇವರಿಗೆ ಭಯಪಡುವವನು ಭದ್ರಕೋಟೆಯನ್ನು ಹೊಂದಿದ್ದಾನೆ.","poem":1},{"text":"ಆತನ ಮಕ್ಕಳಿಗೆ ಆಶ್ರಯವು ಇರುವುದು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ಯೆಹೋವ ದೇವರ ಭಯವು ಜೀವದ ಬುಗ್ಗೆಯಾಗಿದೆ.","poem":1},{"text":"ಅದು ಮನುಷ್ಯನನ್ನು ಮರಣದ ಪಾಶಗಳಿಂದ ತಿರುಗಿಸುತ್ತದೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ಜನಸಮೂಹದಲ್ಲಿ ಅರಸನ ಘನತೆ ಇದೆ.","poem":1},{"text":"ಆದರೆ ಜನರ ಕೊರತೆಯಲ್ಲಿ ರಾಜಪುತ್ರನ ನಾಶ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"ತಾಳ್ಮೆಯುಳ್ಳವನು ಬಹು ವಿವೇಕಿ,","poem":1},{"text":"ಮುಂಗೋಪಿಯು ಮೂರ್ಖತನವನ್ನು ಎತ್ತಿಹಿಡಿಯುವನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"ಶಾಂತ ಹೃದಯವು ದೇಹಕ್ಕೆ ಜೀವ;","poem":1},{"text":"ಆದರೆ ಮತ್ಸರವು ಎಲುಬುಗಳಿಗೆ ಕ್ಷಯ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"ಬಡವರನ್ನು ಹಿಂಸಿಸುವವನು, ತನ್ನ ಸೃಷ್ಟಿಕರ್ತನನ್ನು ಹೀನೈಸುವನು,","poem":1},{"text":"ಆದರೆ ಬಡವರನ್ನು ಕನಿಕರಿಸುವವನು ದೇವರನ್ನು ಸನ್ಮಾನಿಸುವನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"ದುಷ್ಟನು ತನ್ನ ಆಪತ್ಕಾಲದಲ್ಲಿ ಹಾಳಾಗುತ್ತಾನೆ,","poem":1},{"text":"ಆದರೆ ನೀತಿವಂತನಿಗೆ ಮರಣದಲ್ಲಿಯೂ ಆಶ್ರಯ ಇದೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"ತಿಳುವಳಿಕೆಯುಳ್ಳವನ ಹೃದಯದಲ್ಲಿ ಜ್ಞಾನವು ನೆಲೆಯಾಗಿದೆ,","poem":1},{"text":"ಆದರೆ ಮೂರ್ಖರಲ್ಲಿ ಜ್ಞಾನವು ಕಂಡುಬರುವುದಿಲ್ಲ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"ನೀತಿಯು ಜನಾಂಗವನ್ನು ವೃದ್ಧಿಮಾಡುತ್ತದೆ;","poem":1},{"text":"ಆದರೆ ಯಾವ ಪ್ರಜೆಗಾದರೂ ಪಾಪವು ಅವಮಾನವಾಗಿದೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"ಜ್ಞಾನವುಳ್ಳ ಸೇವಕನ ಕಡೆಗೆ ಅರಸನ ದಯೆ ಇದೆ;","poem":1},{"text":"ಆದರೆ ಮಾನಗೇಡಿ ಸೇವಕನ ಮೇಲೆ ಅರಸನ ಕೋಪ ಎರಗುತ್ತದೆ.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/kan_okcv/PRO/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/PRO/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/PRO/13.json","previousChapterAudioLinks":{},"numberOfVerses":35}