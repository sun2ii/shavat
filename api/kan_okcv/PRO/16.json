{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"PRO","translationId":"kan_okcv","name":"ಜ್ಞಾನೋಕ್ತಿಗಳು","commonName":"ಜ್ಞಾನೋಕ್ತಿಗಳು","title":"ಜ್ಞಾನೋಕ್ತಿಗಳು","order":20,"numberOfChapters":31,"sha256":"db78a84ced0f5c6868005c76f5f2e0a81d61a265338d0405b06b96bd084f0f0e","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kan_okcv/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"ಮನುಷ್ಯನಲ್ಲಿ ತನ್ನ ಹೃದಯದ ಯೋಜನೆಗಳು,","poem":1},{"text":"ಆದರೆ ಸರಿಯಾದ ಉತ್ತರಕೊಡುವ ಶಕ್ತಿ ಯೆಹೋವ ದೇವರಿಂದಲೇ ಬರುವವು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ಮನುಷ್ಯನ ಮಾರ್ಗಗಳೆಲ್ಲಾ ತನ್ನ ದೃಷ್ಟಿಯಲ್ಲಿ ಶುದ್ಧವಾಗಿವೆ,","poem":1},{"text":"ಆದರೆ ಯೆಹೋವ ದೇವರು ಅವನ ಉದ್ದೇಶಗಳನ್ನು ಪರೀಕ್ಷಿಸುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ನಿನ್ನ ಕಾರ್ಯಗಳನ್ನು ಯೆಹೋವ ದೇವರಿಗೆ ಒಪ್ಪಿಸು,","poem":1},{"text":"ಆಗ ನಿನ್ನ ಯೋಜನೆಗಳು ಸ್ಥಿರವಾಗುವುವು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ಯೆಹೋವ ದೇವರು ಎಲ್ಲವುಗಳನ್ನು ಅದರದೇ ಆದ ಉದ್ದೇಶಗಳಿಗಾಗಿ ಮಾಡಿದ್ದಾರೆ.","poem":1},{"text":"ಹೌದು, ಕೇಡಿನ ದಿನಕ್ಕಾಗಿಯೂ ಕೆಡುಕರನ್ನು ಮಾಡಿದ್ದಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ಹೃದಯದಲ್ಲಿ ಗರ್ವಿಷ್ಠನಾದ ಪ್ರತಿಯೊಬ್ಬನೂ ಯೆಹೋವ ದೇವರಿಗೆ ಅಸಹ್ಯ.","poem":1},{"text":"ದುಷ್ಟನಿಗೆ ಶಿಕ್ಷೆಯು ತಪ್ಪುವುದಿಲ್ಲ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ಪ್ರೀತಿ ಮತ್ತು ಸತ್ಯತೆಗಳಿಂದ ಪಾಪಕ್ಕೆ ಪ್ರಾಯಶ್ಚಿತ್ತವಾಗುತ್ತದೆ.","poem":1},{"text":"ಯೆಹೋವ ದೇವರ ಭಯದ ಮೂಲಕ ಮನುಷ್ಯರು ಕೆಟ್ಟದ್ದರಿಂದ ತೊಲಗುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ಮನುಷ್ಯನ ಮಾರ್ಗಗಳು ಯೆಹೋವ ದೇವರನ್ನು ಮೆಚ್ಚಿಸಿದಾಗ,","poem":1},{"text":"ಅವರು ಅವನ ಶತ್ರುಗಳನ್ನು ಸಹ ಅವನೊಂದಿಗೆ ಸಮಾಧಾನದಲ್ಲಿರುವಂತೆ ಮಾಡುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ಅನ್ಯಾಯದ ದೊಡ್ಡ ಆದಾಯಕ್ಕಿಂತಲೂ","poem":1},{"text":"ನೀತಿಯೊಂದಿಗಿರುವ ಸ್ವಲ್ಪವೇ ಉತ್ತಮ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ಒಬ್ಬ ಮನುಷ್ಯನ ಹೃದಯವು ಅವನ ಮಾರ್ಗವನ್ನು ಕಲ್ಪಿಸುತ್ತದೆ,","poem":1},{"text":"ಆದರೆ ಯೆಹೋವ ದೇವರು ಅವನ ಹೆಜ್ಜೆಗಳನ್ನು ಸ್ಥಾಪಿಸುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ಅರಸನ ತುಟಿಗಳಲ್ಲಿ ದೈವೋಕ್ತಿ.","poem":1},{"text":"ನ್ಯಾಯತೀರ್ಪಿನಲ್ಲಿ ಅವನ ಬಾಯಿಯು ದೋಷ ಮಾಡುವುದಿಲ್ಲ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ನ್ಯಾಯದ ತೂಕವೂ ತಕ್ಕಡಿಯೂ ಯೆಹೋವ ದೇವರದೇ.","poem":1},{"text":"ಚೀಲದ ತೂಕಗಳು ಅವರ ಕೈಕೆಲಸವೇ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ಕೆಟ್ಟದ್ದನ್ನು ಮಾಡುವವರು ರಾಜರಿಗೆ ಅಸಹ್ಯರು.","poem":1},{"text":"ಏಕೆಂದರೆ ನೀತಿಯಿಂದ ಸಿಂಹಾಸನವು ಸ್ಥಾಪಿಸಲಾಗುತ್ತದೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ನೀತಿಯ ತುಟಿಗಳಲ್ಲಿ ಅರಸರು ಆನಂದಿಸುತ್ತಾರೆ,","poem":1},{"text":"ಯಥಾರ್ಥವಾದಿಯನ್ನು ಅವರು ಪ್ರೀತಿಸುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ಅರಸನ ಕೋಪವು ಮೃತ್ಯುವಿನ ದೂತರಂತೆ ಇರುತ್ತದೆ,","poem":1},{"text":"ಆದರೆ ಜ್ಞಾನಿಯು ಅದನ್ನು ಶಮನಪಡಿಸುವನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ಪ್ರಕಾಶಮಾನವಾದ ಅರಸನ ಮುಖದಲ್ಲಿ ಜೀವ,","poem":1},{"text":"ಅವನ ದಯೆಯು ಹಿಂಗಾರು ಮಳೆಯ ಮೇಘದಂತಿದೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ಬಂಗಾರಕ್ಕಿಂತ ಜ್ಞಾನವನ್ನು ಪಡೆಯುವುದು ಎಷ್ಟೋ ಮೇಲು!","poem":1},{"text":"ಬೆಳ್ಳಿಗಿಂತ ವಿವೇಕವನ್ನು ಆರಿಸಿಕೊಳ್ಳುವುದು ಎಷ್ಟೋ ಉತ್ತಮ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ಯಥಾರ್ಥವಂತರ ಹೆದ್ದಾರಿಯು ಕೆಟ್ಟತನದಿಂದ ಬಹುದೂರ.","poem":1},{"text":"ತನ್ನ ಮಾರ್ಗವನ್ನು ಕಾಯುವವನು ತನ್ನ ಪ್ರಾಣವನ್ನು ಕಾಪಾಡಿಕೊಳ್ಳುತ್ತಾನೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ನಾಶನಕ್ಕೆ ಮುಂದಾಗಿ ಗರ್ವ ಹೋಗುತ್ತದೆ.","poem":1},{"text":"ಬೀಳುವಿಕೆಯ ಮುಂಚೆ ಜಂಬದ ಆತ್ಮ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ಅಹಂಕಾರಿಗಳೊಂದಿಗೆ ಕೊಳ್ಳೆಯನ್ನು ಹಂಚಿಕೊಳ್ಳುವದಕ್ಕಿಂತ,","poem":1},{"text":"ದೀನರೊಂದಿಗೆ ದೀನ ಆತ್ಮವುಳ್ಳವರಾಗಿ ಇರುವುದು ಉತ್ತಮ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ಕಾರ್ಯವನ್ನು ಜ್ಞಾನದಿಂದ ನಡೆಸುವವನು ಒಳ್ಳೆಯದನ್ನು ಪಡೆಯುವನು.","poem":1},{"text":"ಯೆಹೋವ ದೇವರಲ್ಲಿ ಭರವಸೆ ಇಡುವವನು ಧನ್ಯನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ಹೃದಯದಲ್ಲಿ ಜ್ಞಾನವಂತರು ವಿವೇಚನೆಯುಳ್ಳವರು ಎಂದು ಕರೆಯಲಾಗುವರು.","poem":1},{"text":"ತುಟಿಗಳ ಮಾಧುರ್ಯ ಮನವೊಲಿಸುವವು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ವಿವೇಕವು ವಿವೇಕಿಗಳಿಗೆ ಜೀವನದ ಬುಗ್ಗೆ,","poem":1},{"text":"ಆದರೆ ಮೂರ್ಖತನವು ಮೂರ್ಖರಿಗೆ ಶಿಕ್ಷೆಯನ್ನು ತರುತ್ತದೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ಜ್ಞಾನಿಯ ಹೃದಯವು ಅವನ ಬಾಯಿಗೆ ಜಾಣತನವನ್ನೂ,","poem":1},{"text":"ಅವನ ತುಟಿಗಳಿಗೆ ಉಪದೇಶ ಶಕ್ತಿಯನ್ನೂ ಹೆಚ್ಚಿಸುವುದು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ವಿನಯದ ಮಾತುಗಳು ಜೇನುಗೂಡು ಪ್ರಾಣಕ್ಕೆ ಮಧುರವೂ,","poem":1},{"text":"ಎಲುಬುಗಳಿಗೆ ಕ್ಷೇಮವೂ ಆಗಿವೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ಮನುಷ್ಯರಿಗೆ ಸರಿಯಾಗಿ ತೋರುವ ಒಂದು ಮಾರ್ಗ ಉಂಟು,","poem":1},{"text":"ಆದರೆ ಅದರ ಅಂತ್ಯವು ಮರಣದ ಮಾರ್ಗವೇ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ದುಡಿಯುವವನಿಗೆ ಅವನ ಹಸಿವೇ ದುಡಿಯುವಂತೆ ಮಾಡುವುದು,","poem":1},{"text":"ಅವನ ಹಸಿವು ಅವನನ್ನು ಒತ್ತಾಯ ಮಾಡುವುದು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ಭಕ್ತಿಹೀನನು ಕೇಡಿನ ಕುಣಿ ಅಗೆಯುತ್ತಾನೆ.","poem":1},{"text":"ಅವನ ತುಟಿಗಳು ಉರಿಯುವ ಬೆಂಕಿಯಂತಿವೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ಮೂರ್ಖನು ಜಗಳವನ್ನು ಬಿತ್ತುತ್ತಾನೆ.","poem":1},{"text":"ಚಾಡಿಕೋರನು ಪ್ರಮುಖ ಸ್ನೇಹಿತರನ್ನು ಅಗಲಿಸುತ್ತಾನೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"ಬಲಾತ್ಕಾರಿಯು ನೆರೆಯವನನ್ನು ಮರುಳುಗೊಳಿಸಿ,","poem":1},{"text":"ದುರ್ಮಾರ್ಗಕ್ಕೆ ಎಳೆಯುತ್ತಾನೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"ವಕ್ರಬುದ್ಧಿಯ ಒಳಸಂಚುಗಳಿಗೆ ಅವನು ತನ್ನ ಕಣ್ಣುಗಳನ್ನು ಮುಚ್ಚಿಕೊಳ್ಳುತ್ತಾನೆ.","poem":1},{"text":"ತನ್ನ ತುಟಿಗಳನ್ನು ಕದಲಿಸುತ್ತಾ ಕೆಟ್ಟದ್ದು ಸಂಭವಿಸುವಂತೆ ಮಾಡುತ್ತಾನೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"ನರೆಗೂದಲು ಉಜ್ವಲ ಕಿರೀಟ,","poem":1},{"text":"ಅದು ನೀತಿಯ ಜೀವಿತದಲ್ಲಿ ಒದಗುತ್ತದೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"ದೀರ್ಘಶಾಂತನು ಶೂರರಿಗಿಂತಲೂ ಶ್ರೇಷ್ಠ,","poem":1},{"text":"ತನ್ನ ಮನಸ್ಸನ್ನು ಆಳುವವನು, ಪಟ್ಟಣವನ್ನು ಗೆದ್ದವನಿಗಿಂತಲೂ ಉತ್ತಮನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"ಉಡಿಯಲ್ಲಿ ಚೀಟು ಹಾಕಬಹುದು,","poem":1},{"text":"ಆದರೆ ಪ್ರತಿ ತೀರ್ಪು ಯೆಹೋವ ದೇವರದ್ದೇ.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/kan_okcv/PRO/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/PRO/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/PRO/15.json","previousChapterAudioLinks":{},"numberOfVerses":33}