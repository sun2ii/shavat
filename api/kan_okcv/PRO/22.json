{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"PRO","translationId":"kan_okcv","name":"ಜ್ಞಾನೋಕ್ತಿಗಳು","commonName":"ಜ್ಞಾನೋಕ್ತಿಗಳು","title":"ಜ್ಞಾನೋಕ್ತಿಗಳು","order":20,"numberOfChapters":31,"sha256":"db78a84ced0f5c6868005c76f5f2e0a81d61a265338d0405b06b96bd084f0f0e","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kan_okcv/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":[{"text":"ಬಹು ಐಶ್ವರ್ಯಕ್ಕಿಂತಲೂ ಒಳ್ಳೆಯ ಹೆಸರು ಉತ್ತಮ;","poem":1},{"text":"ಬೆಳ್ಳಿಬಂಗಾರಕ್ಕಿಂತಲೂ ಗೌರವದಿಂದಿರುವುದು ಉತ್ತಮ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ಧನಿಕರು, ಬಡವರು ಇದನ್ನು ಸಾಮಾನ್ಯವಾಗಿ ಹೊಂದಿರುವರು:","poem":1},{"text":"ಇವರೆಲ್ಲರನ್ನು ಸೃಷ್ಟಿಸಿದಾತ ಯೆಹೋವ ದೇವರೇ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ಜಾಣನು ಕೇಡನ್ನು ಮುಂದಾಗಿ ಕಂಡು ತಾನು ಅಡಗಿಕೊಳ್ಳುತ್ತಾನೆ;","poem":1},{"text":"ಆದರೆ ಮುಗ್ಧನು ಮುಂದೆ ಹೋಗಿ ಶಿಕ್ಷೆಯನ್ನು ಹೊಂದುತ್ತಾನೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ಯೆಹೋವ ದೇವರ ಭಯವೂ ದೀನತೆಯೂ ಕೊಡುವ ಪ್ರತಿಫಲ,","poem":1},{"text":"ಐಶ್ವರ್ಯವೂ ಮಾನವೂ ಜೀವವೂ ಆಗಿದೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ದುಷ್ಟರ ದಾರಿಯಲ್ಲಿ ಮುಳ್ಳುಗಳೂ, ಉರುಲುಗಳೂ ಇವೆ;","poem":1},{"text":"ತನ್ನ ಜೀವವನ್ನು ಕಾಪಾಡಿಕೊಳ್ಳುವವನು ಅವುಗಳಿಂದ ದೂರವಾಗಿರುವನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ನಡೆಯಬೇಕಾದ ಮಾರ್ಗಕ್ಕೆ ತಕ್ಕಂತೆ ಮಕ್ಕಳಿಗೆ ಶಿಕ್ಷಣವನ್ನು ಕೊಡು;","poem":1},{"text":"ಆಗ ಮುಪ್ಪಿನಲ್ಲಿಯೂ ಅವನು ಅದರಿಂದ ದೂರ ಹೋಗುವುದಿಲ್ಲ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ಐಶ್ವರ್ಯವಂತನು ಬಡವನ ಮೇಲೆ ಆಳುತ್ತಾನೆ;","poem":1},{"text":"ಸಾಲಗಾರನು ಸಾಲಕೊಟ್ಟವನಿಗೆ ಗುಲಾಮನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ಕೆಟ್ಟತನವನ್ನು ಬಿತ್ತುವವನು ಕೇಡನ್ನು ಕೊಯ್ಯುವನು;","poem":1},{"text":"ಅವನ ಕೋಪದ ಬೆತ್ತವು ಮುರಿದು ಹೋಗುವುದು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ಉದಾರವಾಗಿ ಕೊಡುವವನು ಆಶೀರ್ವಾದವನ್ನು ಹೊಂದುವನು,","poem":1},{"text":"ಏಕೆಂದರೆ ತನಗಿದ್ದ ಆಹಾರದಲ್ಲಿ ಬಡವರಿಗೆ ಕೊಡುತ್ತಾನೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ಪರಿಹಾಸ್ಯ ಮಾಡುವವನನ್ನು ಹೊರಗೆ ತಳ್ಳಿಬಿಟ್ಟರೆ ಕಲಹವು ನಿಲ್ಲುವುದು;","poem":1},{"text":"ವಿವಾದವೂ ನಿಂದೆಯೂ ನಿಂತುಹೋಗುವುವು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ಶುದ್ಧ ಹೃದಯವನ್ನು ಪ್ರೀತಿಸಿ, ಕೃಪೆಯಿಂದ ಮಾತನಾಡುವವನಿಗೆ","poem":1},{"text":"ಅರಸನು ಸ್ನೇಹಿತನಾಗಿರುವನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ಯೆಹೋವ ದೇವರ ಕಣ್ಣುಗಳು ತಿಳುವಳಿಕೆಯನ್ನು ಕಾಯುತ್ತವೆ;","poem":1},{"text":"ಅವರು ದ್ರೋಹಿಯ ಮಾತುಗಳನ್ನು ಕೆಡವಿ ಹಾಕುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ಸೋಮಾರಿಯು, “ಹೊರಗೆ ಸಿಂಹವಿದೆ!","poem":1},{"text":"ಅದು ನನ್ನನ್ನು ಬೀದಿಗಳಲ್ಲಿ ಕೊಂದುಹಾಕುತ್ತದೆ,” ಎಂದು ಹೇಳುತ್ತಾನೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ವ್ಯಭಿಚಾರಿಣಿಯ ಬಾಯಿ ಆಳವಾದ ಬಾವಿ;","poem":1},{"text":"ಯೆಹೋವ ದೇವರಿಗೆ ಸಿಟ್ಟನ್ನು ಎಬ್ಬಿಸುವವನು ಅದರಲ್ಲಿ ಬೀಳುವನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ಮೂರ್ಖತನ ಯುವಕನ ಹೃದಯದಲ್ಲಿ ಬಂಧಿಸಲಾಗಿದೆ;","poem":1},{"text":"ಆದರೆ ಶಿಕ್ಷೆಯ ಬೆತ್ತವು ಅದನ್ನು ಅವನಿಂದ ದೂರವಾಗಿ ಓಡಿಸಿಬಿಡುವುದು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ತನ್ನ ಸಂಪತ್ತನ್ನು ವೃದ್ಧಿಗೊಳಿಸುವುದಕ್ಕೆ ಬಡವರನ್ನು ಹಿಂಸಿಸುವವನೂ","poem":1},{"text":"ಐಶ್ವರ್ಯವಂತರಿಗೆ ದಾನ ಕೊಡುವವನೂ ನಿಶ್ಚಯವಾಗಿ ಕೊರತೆಪಡುವನು.","poem":2}]},{"type":"heading","content":["ಮೊದಲನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":17,"content":[{"text":"ಜ್ಞಾನಿಗಳ ಮಾತುಗಳನ್ನು ಕಿವಿಗೊಟ್ಟು ಕೇಳು;","poem":1},{"text":"ನನ್ನ ಬೋಧನೆಯನ್ನು ನಿನ್ನ ಹೃದಯವು ಅನ್ವಯಿಸಲಿ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ಏಕೆಂದರೆ ಅವುಗಳನ್ನು ನಿನ್ನ ಹೃದಯದಲ್ಲಿ ಇಟ್ಟು ಕಾಪಾಡು,","poem":1},{"text":"ಅವು ನಿನ್ನ ತುಟಿಗಳ ಮೇಲೆ ಸಿದ್ಧವಿದ್ದರೆ ಮೆಚ್ಚುಗೆಯಾಗಿವೆ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ನಿನ್ನ ಭರವಸೆಯು ಯೆಹೋವ ದೇವರಲ್ಲಿ ಇರುವಂತೆ","poem":1},{"text":"ಈ ದಿವಸ ನಿನಗೇ ತಿಳಿಯಪಡಿಸಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ನಾನು ನಿಮಗಾಗಿ ಮೂವತ್ತು ಹೇಳಿಕೆಗಳನ್ನು ಬರೆದಿಲ್ಲವೋ?","poem":1},{"text":"ಸಲಹೆ ಮತ್ತು ಪರಿಜ್ಞಾನದ ಹೇಳಿಕೆಗಳು,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ಪ್ರಾಮಾಣಿಕವಾಗಿರಲು ಮತ್ತು ಸತ್ಯವನ್ನು ಮಾತನಾಡಲು ನಿಮಗೆ ಕಲಿಸುವುದು,","poem":1},{"text":"ಆದ್ದರಿಂದ ನೀವು ಸೇವೆ ಸಲ್ಲಿಸುವವರಿಗೆ","poem":2},{"lineBreak":true},{"text":"ಸತ್ಯವಾದ ವರದಿಗಳನ್ನು ಹಿಂತಿರುಗಿಸುವಂತೆ ನಾನು ನಿಮಗೆ ಬರೆದಿದ್ದೇನೆ.","poem":2}]},{"type":"heading","content":["ಎರಡನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":22,"content":[{"text":"ಬಡವರಿಗೆ ದಿಕ್ಕಿಲ್ಲವೆಂದು ತಿಳಿದು ಅವರನ್ನು ಸೂರೆಮಾಡಬೇಡ;","poem":1},{"text":"ನ್ಯಾಯಾಲಯದಲ್ಲಿ ದರಿದ್ರರನ್ನು ತುಳಿಯಬೇಡ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ಅವರ ವ್ಯಾಜ್ಯವನ್ನು ನಡೆಸಿ,","poem":1},{"text":"ಸೂರೆ ಮಾಡಿದವರ ಪ್ರಾಣವನ್ನು ಸೂರೆ ಮಾಡುವರು.","poem":2}]},{"type":"heading","content":["ಮೂರನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":24,"content":[{"text":"ಮುಂಗೊಪಿಯೊಂದಿಗೆ ಸ್ನೇಹ ಬೆಳೆಸಬೇಡ;","poem":1},{"text":"ಸುಲಭವಾಗಿ ಕೋಪಗೊಳ್ಳುವವರೊಂದಿಗೆ ಸಹವಾಸ ಮಾಡಬೇಡ;","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ಹಾಗೆ ಮಾಡಿದರೆ ನೀನು ಅವನ ನಡತೆಗಳನ್ನು ಕಲಿತು,","poem":1},{"text":"ನಿನ್ನನ್ನೇ ಉರುಲಿಗೆ ಸಿಕ್ಕಿಸಿಕೊಳ್ಳುವೆ.","poem":2}]},{"type":"heading","content":["ನಾಲ್ಕನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":26,"content":[{"text":"ಬೇರೆಯವರ ಸಾಲವನ್ನು ಖಾತರಿಪಡಿಸಲೂ","poem":1},{"text":"ಬೇರೊಬ್ಬರಿಗೆ ಭದ್ರತೆಯನ್ನು ನೀಡಲು ಒಪ್ಪಬೇಡ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ಸಾಲ ತೀರಿಸಲು ನಿನಗೆ ಏನೂ ಇಲ್ಲದೆ ಹೋದರೆ","poem":1},{"text":"ನಿನ್ನ ಕೆಳಗಿನ ಹಾಸಿಗೆಯನ್ನು ಅವನು ತೆಗೆದುಕೊಂಡು ಹೋಗುವನಲ್ಲವೇ?","poem":2}]},{"type":"heading","content":["ಐದನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":28,"content":[{"text":"ನಿನ್ನ ಪಿತೃಗಳು ಹಾಕಿದ ಪೂರ್ವಕಾಲದ","poem":1},{"text":"ಮೇರೆಯನ್ನು ತೆಗೆಯಬೇಡ.","poem":2}]},{"type":"heading","content":["ಆರನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":29,"content":[{"text":"ತನ್ನ ಕೆಲಸದಲ್ಲಿ ಶ್ರದ್ಧೆಯುಳ್ಳವನನ್ನು ನೀನು ನೋಡಿದ್ದೀಯಾ?","poem":1},{"text":"ಅವನು ನೀಚರ ಮುಂದೆ ಅಲ್ಲ,","poem":2},{"lineBreak":true},{"text":"ಅರಸರ ಮುಂದೆಯೇ ಸೇವೆ ಸಲ್ಲಿಸುವನು.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kan_okcv/PRO/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/PRO/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/PRO/21.json","previousChapterAudioLinks":{},"numberOfVerses":29}