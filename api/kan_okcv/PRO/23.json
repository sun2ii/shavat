{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"PRO","translationId":"kan_okcv","name":"ಜ್ಞಾನೋಕ್ತಿಗಳು","commonName":"ಜ್ಞಾನೋಕ್ತಿಗಳು","title":"ಜ್ಞಾನೋಕ್ತಿಗಳು","order":20,"numberOfChapters":31,"sha256":"db78a84ced0f5c6868005c76f5f2e0a81d61a265338d0405b06b96bd084f0f0e","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kan_okcv/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":23,"content":[{"type":"heading","content":["ಏಳನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":1,"content":[{"text":"ಆಳುವವನ ಸಂಗಡ ನೀನು ಊಟಕ್ಕೆ ಕುಳಿತಿರುವಾಗ,","poem":1},{"text":"ನಿನ್ನ ಎದುರಿನಲ್ಲಿ ಏನಿದೆ ಎಂದು ಶ್ರದ್ಧೆಯಿಂದ ಗಮನಿಸು.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ನೀನು ಹೊಟ್ಟೆಬಾಕನಾಗಿದ್ದರೆ,","poem":1},{"text":"ನಿನ್ನ ಕುತ್ತಿಗೆಗೆ ಖಡ್ಗವನ್ನು ಇಟ್ಟುಕೋ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ಅವನ ರುಚಿ ಪದಾರ್ಥಗಳನ್ನು ಅಪೇಕ್ಷಿಸಬೇಡ;","poem":1},{"text":"ಏಕೆಂದರೆ ಅದು ಮೋಸದ ಆಹಾರವು.","poem":2}]},{"type":"heading","content":["ಎಂಟನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":4,"content":[{"text":"ಐಶ್ವರ್ಯವಂತನಾಗುವುದಕ್ಕೆ ಪ್ರಯಾಸಪಡಬೇಡ;","poem":1},{"text":"ಅದಕ್ಕಾಗಿ ಸ್ವಬುದ್ಧಿಯನ್ನೇ ಆಶ್ರಯಿಸಬೇಡ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ಕಣ್ಣು ಮಿಟುಕಿಸುವುದರಲ್ಲಿ ಐಶ್ವರ್ಯ ಕಣ್ಮರೆಯಾಗುತ್ತದೆ.","poem":1},{"text":"ಅದು ನಿಸ್ಸಂದೇಹವಾಗಿ ರೆಕ್ಕೆಗಳನ್ನು ಕಟ್ಟಿಕೊಂಡು","poem":2},{"lineBreak":true},{"text":"ಹದ್ದಿನಂತೆ ಆಕಾಶದ ಕಡೆಗೆ ಹಾರಿಹೋಗುವುದು.","poem":2}]},{"type":"heading","content":["ಒಂಬತ್ತನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":6,"content":[{"text":"ಜಿಪುಣನ ಆಹಾರವನ್ನು ತಿನ್ನಬೇಡ;","poem":1},{"text":"ಅವನ ರುಚಿ ಪದಾರ್ಥಗಳನ್ನು ಆಶಿಸಬೇಡ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ಏಕೆಂದರೆ, ಅವನು ಎಲ್ಲದಕ್ಕೂ ಬೆಲೆ ಕಟ್ಟುವ","poem":1},{"text":"ಯೋಚನೆಯುಳ್ಳವನಂತೆ ಇದ್ದಾನೆ;","poem":2},{"text":"ಅವನು, “ತಿನ್ನು, ಕುಡಿ,” ಎಂದು ಹೇಳುತ್ತಾನೆ;","poem":1},{"text":"ಆದರೆ ಅವನ ಹೃದಯವು ನಿನ್ನೊಂದಿಗಿಲ್ಲ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ನೀನು ತಿಂದ ಸ್ವಲ್ಪ ತುತ್ತನ್ನು ಕಕ್ಕಿಬಿಡುವೆ;","poem":1},{"text":"ನಿನ್ನ ಸವಿಮಾತುಗಳೆಲ್ಲಾ ವ್ಯರ್ಥವೇ.","poem":2}]},{"type":"heading","content":["ಹತ್ತನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":9,"content":[{"text":"ಬುದ್ಧಿಹೀನರ ಸಂಗಡ ಮಾತಾಡಬೇಡ;","poem":1},{"text":"ಏಕೆಂದರೆ ನಿನ್ನ ಜ್ಞಾನದ ಮಾತುಗಳನ್ನು ಅವರು ತಿರಸ್ಕರಿಸುವನು.","poem":2}]},{"type":"heading","content":["ಹನ್ನೊಂದನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":10,"content":[{"text":"ಪೂರ್ವಕಾಲದ ಮೇರೆಯನ್ನು ತೆಗೆಯಬೇಡ;","poem":1},{"text":"ಅನಾಥರ ಹೊಲಗಳನ್ನು ಅತಿಕ್ರಮಿಸಬೇಡ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ಏಕೆಂದರೆ ಅವನ ವಿಮೋಚಕನು ಬಲಶಾಲಿಯಾಗಿದ್ದಾನೆ;","poem":1},{"text":"ಅವರ ವ್ಯಾಜ್ಯಕ್ಕಾಗಿ ಆತನು ವಾದಿಸುವನು.","poem":2}]},{"type":"heading","content":["ಹನ್ನೆರಡನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":12,"content":[{"text":"ಶಿಸ್ತಿಗೆ ನಿನ್ನ ಹೃದಯವನ್ನೂ","poem":1},{"text":"ತಿಳುವಳಿಕೆಯ ಮಾತುಗಳಿಗೆ ನಿನ್ನ ಕಿವಿಗಳನ್ನೂ ಕೊಡು.","poem":2}]},{"type":"heading","content":["ಹದಿಮೂರನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":13,"content":[{"text":"ಮಕ್ಕಳನ್ನು ಶಿಕ್ಷಿಸಲು ಹಿಂದೆಗೆಯಬೇಡ;","poem":1},{"text":"ಬೆತ್ತದಿಂದ ಹೊಡೆದರೆ, ಅವರು ಸಾಯುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ಅವರನ್ನು ಬೆತ್ತದಿಂದ ಹೊಡೆದು,","poem":1},{"text":"ಪಾತಾಳದಿಂದ ಅವರ ಮರಣವನ್ನು ತಪ್ಪಿಸುವೆ.","poem":2}]},{"type":"heading","content":["ಹದಿನಾಲ್ಕನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":15,"content":[{"text":"ಮಗನೇ, ನಿನ್ನ ಹೃದಯವು ಜ್ಞಾನವುಳ್ಳದ್ದಾಗಿದ್ದರೆ,","poem":1},{"text":"ನನ್ನ ಹೃದಯವು ಹರ್ಷಿಸುವುದು.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ನಿನ್ನ ತುಟಿಗಳು ಯಥಾರ್ಥವಾದವುಗಳನ್ನು ಮಾತಾಡಿದರೆ,","poem":1},{"text":"ನನ್ನ ಅಂತರಾತ್ಮವು ಸಂತೋಷಿಸುವುದು.","poem":2}]},{"type":"heading","content":["ಹದಿನೈದನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":17,"content":[{"text":"ಪಾಪಿಗಳನ್ನು ನೋಡಿ ನಿನ್ನ ಹೃದಯವು ಅಸೂಯೆಪಡದಿರಲಿ;","poem":1},{"text":"ಆದರೆ ಯೆಹೋವ ದೇವರ ಭಯದಲ್ಲಿರಲು ಯಾವಾಗಲೂ ಆಸಕ್ತನಾಗಿರು.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ಖಂಡಿತವಾಗಿಯೂ ನಿನಗೆ ಮುಂದಿನ ನಿರೀಕ್ಷೆಯಿದೆ;","poem":1},{"text":"ನಿನ್ನ ನಿರೀಕ್ಷೆಯು ನಿರರ್ಥಕವಾಗದು.","poem":2}]},{"type":"heading","content":["ಹದಿನಾರನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":19,"content":[{"text":"ಮಗನೇ, ಕೇಳಿ ಜ್ಞಾನವಂತನಾಗು;","poem":1},{"text":"ನೀತಿ ಮಾರ್ಗದಲ್ಲಿ ನಿನ್ನ ಹೃದಯವನ್ನು ನಡೆಸು.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ಅತಿ ಮದ್ಯಪಾನ ಮಾಡುವವರಲ್ಲಿ","poem":1},{"text":"ಅತಿ ಮಾಂಸಭಕ್ಷರಲ್ಲಿಯೂ ಸೇರಬೇಡ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ಏಕೆಂದರೆ ಕುಡುಕರೂ ಹೊಟ್ಟೆಬಾಕರೂ ದುರ್ಗತಿಗೆ ಬರುವರು;","poem":1},{"text":"ತೂಕಡಿಕೆಯು ಹರಕು ಬಟ್ಟೆಗಳನ್ನು ಹೊದಿಸುವದು.","poem":2}]},{"type":"heading","content":["ಹದಿನೇಳನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":22,"content":[{"text":"ನಿನ್ನನ್ನು ಹೆತ್ತ ತಂದೆಯ ಮಾತಿಗೆ ಕಿವಿಗೊಡು,","poem":1},{"text":"ನಿನ್ನ ತಾಯಿ ಮುಪ್ಪಿನವಳಾದಾಗ ಆಕೆಯನ್ನು ಅಸಡ್ಡೆ ಮಾಡಬೇಡ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ಸತ್ಯವನ್ನೂ ಜ್ಞಾನವನ್ನೂ ಶಿಕ್ಷಣವನ್ನೂ ವಿವೇಕವನ್ನೂ ಕೊಂಡುಕೋ;","poem":1},{"text":"ಆದರೆ ಅವುಗಳನ್ನು ಮಾರಬೇಡ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ನೀತಿವಂತನ ತಂದೆಯು ಬಹಳವಾಗಿ ಸಂತೋಷಪಡುವನು;","poem":1},{"text":"ಜ್ಞಾನಿಯಾದ ಮಗುವನ್ನು ಪಡೆದವನಿಗೆ ಅವನಿಂದ ಆನಂದವಾಗುವುದು.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ನಿನ್ನ ತಂದೆತಾಯಿಗಳು ಸಂತೋಷಿಸುವರು;","poem":1},{"text":"ನಿನ್ನ ಹೆತ್ತ ತಾಯಿ ಆನಂದಿಸುವಳು.","poem":2}]},{"type":"heading","content":["ಹದಿನೆಂಟನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":26,"content":[{"text":"ಮಗನೇ, ನಿನ್ನ ಮನಸ್ಸನ್ನು ನನಗೆ ಕೊಡು;","poem":1},{"text":"ನನ್ನ ಮಾರ್ಗಗಳನ್ನು ಅನುಸರಿಸುವಲ್ಲಿ ನಿಮ್ಮ ಕಣ್ಣುಗಳು ಆನಂದಿಸಲಿ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ವೇಶ್ಯೆಯು ಆಳವಾದ ಕುಣಿ;","poem":1},{"text":"ವ್ಯಭಿಚಾರಿಣಿಯು ಇಕ್ಕಟ್ಟಾದ ಗುಂಡಿ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ಕಳ್ಳನಂತೆ ಅವಳು ಹೊಂಚು ಹಾಕಿ","poem":1},{"text":"ಮನುಷ್ಯರಲ್ಲಿ ದ್ರೋಹಿಗಳನ್ನು ಹೆಚ್ಚಿಸುತ್ತಾಳೆ.","poem":2}]},{"type":"heading","content":["ಹತ್ತೊಂಬತ್ತನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":29,"content":[{"text":"ಯಾರಿಗೆ ಕಷ್ಟ? ಯಾರಿಗೆ ದುಃಖ?","poem":1},{"text":"ಯಾರಿಗೆ ಕಲಹಗಳು? ಯಾರು ಗೊಣಗುಟ್ಟುತ್ತಾರೆ?","poem":2},{"lineBreak":true},{"text":"ಯಾರು ಸುಮ್ಮಸುಮ್ಮನೆ ಗಾಯಪಡುತ್ತಾರೆ? ಯಾರಿಗೆ ಕೆಂಪೇರಿದ ಕಣ್ಣುಗಳು?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ಮದ್ಯಪಾನದಲ್ಲಿ ಆಸಕ್ತರಾಗಿ,","poem":1},{"text":"ಮಿಶ್ರ ಮದ್ಯಪಾನವನ್ನು ಕುಡಿಯ ಬಯಸುವವರೇ ಅಲ್ಲವೇ!","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ದ್ರಾಕ್ಷಾರಸವು ಕೆಂಪಾಗಿದ್ದು,","poem":1},{"text":"ಪಾತ್ರೆಯಲ್ಲಿ ಥಳಥಳಿಸುತ್ತಾ ಚಲಿಸಿದರೆ,","poem":2},{"lineBreak":true},{"text":"ಅದನ್ನು ನೋಡಬೇಡ.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ಕೊನೆಗೆ ಅದು ಹಾವಿನಂತೆ ಕಚ್ಚುವುದು","poem":1},{"text":"ಮತ್ತು ಸರ್ಪದಂತೆ ವಿಷವುಕ್ಕಿಸುವುದು.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ನಿಮ್ಮ ಕಣ್ಣುಗಳು ವಿಚಿತ್ರ ದೃಶ್ಯಗಳನ್ನು ನೋಡುತ್ತವೆ.","poem":1},{"text":"ನಿಮ್ಮ ಮನಸ್ಸು ಗೊಂದಲಮಯ ವಿಷಯಗಳನ್ನು ಕಲ್ಪಿಸುತ್ತದೆ.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ನೀನು ಸಮುದ್ರದ ಮಧ್ಯದಲ್ಲಿ ಮಲಗಿರುವವನಂತೆ","poem":1},{"text":"ಇಲ್ಲವೆ ಹಡಗಿನ ಕಂಬದ ತುದಿಯಲ್ಲಿ ಇರುವಿ.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"“ಜನರು ನನ್ನನ್ನು ಹೊಡೆದರೂ","poem":1},{"text":"ನನಗೆ ನೋವಾಗಲಿಲ್ಲ;","poem":2},{"text":"ನಾನು ಎಚ್ಚರವಾಗುವುದು ಯಾವಾಗ?","poem":1},{"text":"ಪುನಃ ನಾನು ಅದನ್ನು ಕುಡಿದೇನು?” ಎಂದುಕೊಳ್ಳುವೆ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kan_okcv/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":35}