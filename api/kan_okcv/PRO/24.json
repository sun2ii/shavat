{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"PRO","translationId":"kan_okcv","name":"ಜ್ಞಾನೋಕ್ತಿಗಳು","commonName":"ಜ್ಞಾನೋಕ್ತಿಗಳು","title":"ಜ್ಞಾನೋಕ್ತಿಗಳು","order":20,"numberOfChapters":31,"sha256":"db78a84ced0f5c6868005c76f5f2e0a81d61a265338d0405b06b96bd084f0f0e","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kan_okcv/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":24,"content":[{"type":"heading","content":["ಇಪ್ಪತ್ತನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":1,"content":[{"text":"ಕೆಟ್ಟವರಿಗೆ ವಿರೋಧವಾಗಿ ನೀನು ಅಸೂಯೆ ಪಡದಿರು;","poem":1},{"text":"ಇಲ್ಲವೆ ಅವರ ಸಂಗಡ ಇರುವುದಕ್ಕೆ ಅಪೇಕ್ಷಿಸಬೇಡ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ಏಕೆಂದರೆ ಅವರ ಹೃದಯವು ಹಿಂಸೆಯನ್ನು ಯೋಜಿಸುತ್ತದೆ;","poem":1},{"text":"ಅವರ ತುಟಿಗಳು ಹಾನಿಯನ್ನು ಪ್ರಸ್ತಾಪಿಸುತ್ತವೆ.","poem":2}]},{"type":"heading","content":["ಇಪ್ಪತ್ತೊಂದನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":3,"content":[{"text":"ಜ್ಞಾನದಿಂದ ಮನೆಯು ಕಟ್ಟಲಾಗುತ್ತದೆ.","poem":1},{"text":"ತಿಳುವಳಿಕೆಯಿಂದ ಅದು ಸ್ಥಿರಗೊಳ್ಳುತ್ತದೆ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ತಿಳುವಳಿಕೆಯಿಂದ ಅದರ ಕೋಣೆಗಳು ಅಮೂಲ್ಯವಾದ","poem":1},{"text":"ಎಲ್ಲಾ ಇಷ್ಟ ಸಂಪತ್ತಿನಿಂದ ತುಂಬುವುದು.","poem":2}]},{"type":"heading","content":["ಇಪ್ಪತ್ತೇರಡನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":5,"content":[{"text":"ಬಲವುಳ್ಳವನಿಗಿಂತ ಜ್ಞಾನಿಯು ಶಕ್ತಿಶಾಲಿ;","poem":1},{"text":"ತಿಳುವಳಿಕೆಯುಳ್ಳವನು ಬಲವನ್ನು ಹೆಚ್ಚಿಸಿಕೊಳ್ಳುತ್ತಾನೆ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ಖಂಡಿತವಾಗಿಯೂ ನಿಮಗೆ ಯುದ್ಧಮಾಡಲು ಮಾರ್ಗದರ್ಶನ ಬೇಕು,","poem":1},{"text":"ಬಹುಮಂದಿ ಸಲಹೆಗಾರರು ಇರುವಲ್ಲಿ ಜಯವಿರುವುದು.","poem":2}]},{"type":"heading","content":["ಇಪ್ಪತ್ಮೂರನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":7,"content":[{"text":"ಜ್ಞಾನವು ಬುದ್ಧಿಹೀನನಿಗೆ ನಿಲುಕದು;","poem":1},{"text":"ಪುರದ್ವಾರದಲ್ಲಿ ಕೂಡಿಬಂದ ಸಭೆಯಲ್ಲಿ ಅವನು ತನ್ನ ಬಾಯಿಯನ್ನು ತೆರೆಯುವುದೇ ಇಲ್ಲ.","poem":2}]},{"type":"heading","content":["ಇಪ್ಪತ್ತನಾಲ್ಕನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":8,"content":[{"text":"ಕೇಡನ್ನು ಕಲ್ಪಿಸುವವನು","poem":1},{"text":"ಕುಚೋದ್ಯಗಾರನೆಂದು ಕರೆಯಲ್ಪಡುವನು.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ಬುದ್ಧಿಹೀನನ ಆಲೋಚನೆಯು ಪಾಪಮಯ;","poem":1},{"text":"ಪರಿಹಾಸ್ಯಗಾರನು ಮನುಷ್ಯರಿಗೆ ಅಸಹ್ಯ.","poem":2}]},{"type":"heading","content":["ಇಪ್ಪತ್ತೈದನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":10,"content":[{"text":"ಇಕ್ಕಟ್ಟಿನ ಸಮಯದಲ್ಲಿ ನೀನು ಬಳಲಿ ಹೋದರೆ,","poem":1},{"text":"ನಿನ್ನ ಬಲವು ಕೊಂಚವಾಗಿದೆ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ಅನ್ಯಾಯವಾಗಿ ಮರಣಕ್ಕೆ ಸಾಗಿಸುವನನ್ನು ಬಿಡಿಸುವುದಕ್ಕೆ ಯತ್ನಿಸು;","poem":1},{"text":"ಕೊಲೆಗೆ ನೇಮಿತವಾದವರನ್ನು ನೀನು ರಕ್ಷಿಸು.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ನೀನು, “ಅದು ನನಗೆ ಏನೂ ಗೊತ್ತಿಲ್ಲ” ಎಂದು ಹೇಳಿದರೆ,","poem":1},{"text":"ಹೃದಯವನ್ನು ಪರಿಶೋಧಿಸುವ ದೇವರು ಅದನ್ನು ತಿಳಿಯುವದಿಲ್ಲವೋ?","poem":2},{"text":"ನಿನ್ನ ಜೀವವನ್ನು ಕಾಯುವಾತನು ಅದನ್ನು ತಿಳಿಯುವುದಿಲ್ಲವೋ?","poem":1},{"text":"ಪ್ರತಿಯೊಬ್ಬನ ಕಾರ್ಯಗಳಿಗನುಸಾರವಾಗಿ ಆತನು ಪ್ರತಿಫಲವನ್ನು ಕೊಡದೆ ಇರುವನೇ?","poem":2}]},{"type":"heading","content":["ಇಪ್ಪತ್ತಾರನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":13,"content":[{"text":"ಮಗನೇ, ಜೇನನ್ನು ತಿನ್ನು, ಅದು ಚೆನ್ನಾಗಿದೆ;","poem":1},{"text":"ಜೇನು ಗೂಡಿನ ಜೇನುತುಪ್ಪವು ನಿನ್ನ ಬಾಯಿಗೆ ಸಿಹಿಯಾಗಿದೆ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ಅಂತೆಯೇ ಜ್ಞಾನವು ನಿನಗೆ ಜೇನುತುಪ್ಪದಂತೆ ತಿಳಿದುಕೋ.","poem":1},{"text":"ಅದು ಸಿಕ್ಕಿದಾಗ ನಿನಗೆ ಉಜ್ವಲ ಭವಿಷ್ಯವಿದೆ.","poem":2},{"lineBreak":true},{"text":"ನಿನ್ನ ನಿರೀಕ್ಷೆಯು ನಿರರ್ಥಕವಾಗುವುದಿಲ್ಲ.","poem":2}]},{"type":"heading","content":["ಇಪ್ಪತ್ತೇಳನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":15,"content":[{"text":"ದುಷ್ಟನೇ, ನೀತಿವಂತನ ನಿವಾಸಕ್ಕೆ ಹೊಂಚು ಹಾಕಬೇಡ;","poem":1},{"text":"ಅವನ ವಿಶ್ರಾಂತಿಯ ಸ್ಥಳವನ್ನು ಸೂರೆಮಾಡಬೇಡ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ಏಕೆಂದರೆ ನೀತಿವಂತನು ಏಳು ಸಾರಿ ಬಿದ್ದರೂ ಮತ್ತೆ ಏಳುತ್ತಾನೆ;","poem":1},{"text":"ಆದರೆ ದುಷ್ಟನು ಕೇಡು ಬಂದಾಗ ಬೀಳುವನು.","poem":2}]},{"type":"heading","content":["ಇಪ್ಪತ್ತೆಂಟನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":17,"content":[{"text":"ನಿನ್ನ ಶತ್ರು ಬಿದ್ದರೆ ಆನಂದಿಸಬೇಡ;","poem":1},{"text":"ಅವನು ಎಡವಿದರೆ ನಿನ್ನ ಹೃದಯವು ಹರ್ಷಿಸದಿರಲಿ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ಯೆಹೋವ ದೇವರು ಅದನ್ನು ಕಂಡು, ಅದು ಅವರಿಗೆ ಇಷ್ಟವಿಲ್ಲದ್ದರಿಂದ,","poem":1},{"text":"ಅವರು ಅವನ ಕಡೆಯಿಂದ ತನ್ನ ಕೋಪವನ್ನು ತಿರುಗಿಸಿಬಿಟ್ಟಾರು.","poem":2}]},{"type":"heading","content":["ಇಪ್ಪತ್ತೊಂಬತ್ತನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":19,"content":[{"text":"ಕೆಟ್ಟವರನ್ನು ಕಂಡು ಉರಿಗೊಳ್ಳಬೇಡ;","poem":1},{"text":"ಇಲ್ಲವೆ ದುಷ್ಟರನ್ನು ಕಂಡು ಅಸೂಯೆಪಡಬೇಡ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ಏಕೆಂದರೆ ಕೆಡುಕನಿಗೆ ಭವಿಷ್ಯದ ನಿರೀಕ್ಷೆ ಇರುವುದಿಲ್ಲ;","poem":1},{"text":"ದುಷ್ಟರ ದೀಪವು ಆರಿಹೋಗುವುದು.","poem":2}]},{"type":"heading","content":["ಮೂವತ್ತನೆಯ ಹೇಳಿಕೆ"]},{"type":"verse","number":21,"content":[{"text":"ಮಗನೇ, ಯೆಹೋವ ದೇವರಿಗೂ, ಅರಸನಿಗೂ ಭಯಪಡು;","poem":1},{"text":"ತಿರುಗಿಬೀಳುವವರ ಸಹವಾಸ ಮಾಡಬೇಡ,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ಏಕೆಂದರೆ ಅವರಿಬ್ಬರು ವಿಧಿಸುವ ವಿಪತ್ತು ಫಕ್ಕನೆ ಸಂಭವಿಸುವದು;","poem":1},{"text":"ಅವರು ಯಾವ ವಿಪತ್ತುಗಳನ್ನು ತರಬಹುದು ಎಂದು ಯಾರಿಗೆ ತಿಳಿದಿದೆ?","poem":2}]},{"type":"verse","number":23,"content":["ಇವು ಜ್ಞಾನಿಗಳ ಹೇಳಿಕೆಗಳಾಗಿವೆ:",{"text":"ನ್ಯಾಯ ವಿಚಾರಣೆಯಲ್ಲಿ ಪಕ್ಷಪಾತವು ಸರಿಯಲ್ಲ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ಯಾವನು ದುಷ್ಟನಿಗೆ, “ನೀನು ನೀತಿವಂತನು” ಎಂದು ಹೇಳುತ್ತಾನೋ","poem":1},{"text":"ಅವನನ್ನು ಜನರು ಶಪಿಸುವರು; ಜನಾಂಗಗಳು ಅವನನ್ನು ದೂಷಿಸುವರು.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ಆದರೆ ತಪ್ಪುಮಾಡಿದವರನ್ನು ತಿದ್ದುವವರಿಗೆ ಶುಭವಾಗುವುದು;","poem":1},{"text":"ಅವರ ಮೇಲೆ ಒಳ್ಳೆಯ ಆಶೀರ್ವಾದವು ಬರುವುದು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ಪ್ರಾಮಾಣಿಕವಾದ ಉತ್ತರವು","poem":1},{"text":"ತುಟಿಗೆ ಮುದ್ದಿಟ್ಟಂತೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ನಿನ್ನ ಹೊರಗಿನ ಕೆಲಸವನ್ನು ಕ್ರಮವಾಗಿ ಇರಿಸು.","poem":1},{"text":"ನಿನ್ನ ಹೊಲಗಳನ್ನು ಸಿದ್ಧಪಡಿಸು;","poem":2},{"lineBreak":true},{"text":"ತರುವಾಯ ನಿನ್ನ ಮನೆಯನ್ನು ಕಟ್ಟಿಕೋ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ಕಾರಣವಿಲ್ಲದೆ ನೆರೆಯವನಿಗೆ ವಿರುದ್ಧವಾಗಿ ಸಾಕ್ಷಿ ಹೇಳಬೇಡ;","poem":1},{"text":"ನಿನ್ನ ಮಾತುಗಳಿಂದ ಅವನಿಗೆ ಮೋಸ ಮಾಡಬೇಡ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ನನಗೆ, “ಅವನು ಮಾಡಿದಂತೆ ನಾನೂ ಅವನಿಗೆ ಮಾಡುವೆನು;","poem":1},{"text":"ಅವನು ಮಾಡಿದ್ದಕ್ಕೆ ಸರಿಯಾಗಿ ಮುಯ್ಯಿತೀರಿಸುವೆನು,” ಎಂದು ಹೇಳಬೇಡ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"ನಾನು ಸೋಮಾರಿಯ ಹೊಲದ ಪಕ್ಕದಲ್ಲಿ","poem":1},{"text":"ಬುದ್ಧಿಹೀನನ ದ್ರಾಕ್ಷಿತೋಟದ ಕಡೆಯಲ್ಲಿ ಹಾದು ಹೋದೆನು.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ಆಗ ಇಗೋ, ಹೊಲವೆಲ್ಲವೂ ಮುಳ್ಳು ಗಿಡಗಳಿಂದ ಬೆಳೆದು","poem":1},{"text":"ಕಳೆಗಳು ಅವುಗಳನ್ನು ಮುಚ್ಚಿ","poem":2},{"lineBreak":true},{"text":"ಅದರ ಕಲ್ಲಿನ ಗೋಡೆಯು ಬಿದ್ದುಹೋಗಿತ್ತು.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ಆಗ ನಾನು ಅದನ್ನು ನೋಡಿ ಚಿಂತಿಸತೊಡಗಿದೆ;","poem":1},{"text":"ನಾನು ಕಂಡದ್ದರಿಂದ ಪಾಠ ಕಲಿತೆನು.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ಇನ್ನು ಸ್ವಲ್ಪ ನಿದ್ರೆ, ಇನ್ನು ಸ್ವಲ್ಪ ತೂಕಡಿಕೆ,","poem":1},{"text":"ಇನ್ನು ಸ್ವಲ್ಪ ವಿಶ್ರಾಂತಿಗಾಗಿ ಕೈ ಮುದುರಿಕೊಳ್ಳುವೆ ಎನ್ನುವೆಯಾ?","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ಹೀಗೆ ನಿನಗೆ ಬಡತನವು ಕಳ್ಳನಂತೆಯೂ","poem":1},{"text":"ಕೊರತೆಯು ಶಸ್ತ್ರಧಾರಿಯಂತೆಯೂ ನಿನ್ನ ಮೇಲೆ ಬರುವುವು.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kan_okcv/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}