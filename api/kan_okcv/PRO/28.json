{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"PRO","translationId":"kan_okcv","name":"ಜ್ಞಾನೋಕ್ತಿಗಳು","commonName":"ಜ್ಞಾನೋಕ್ತಿಗಳು","title":"ಜ್ಞಾನೋಕ್ತಿಗಳು","order":20,"numberOfChapters":31,"sha256":"db78a84ced0f5c6868005c76f5f2e0a81d61a265338d0405b06b96bd084f0f0e","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kan_okcv/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"ಹಿಂದಟ್ಟುವವನು ಇಲ್ಲದಿದ್ದರೂ ದುಷ್ಟನು ಓಡಿಹೋಗುತ್ತಾನೆ.","poem":1},{"text":"ಆದರೆ ಸಿಂಹದ ಹಾಗೆ ನೀತಿವಂತರು ಧೈರ್ಯದಿಂದ ಇರುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ದೇಶದ ದಂಗೆಯಿಂದ ಅನೇಕರು ನಾಯಕರಾಗುತ್ತಾರೆ.","poem":1},{"text":"ಆದರೆ ಒಳನೋಟ ಹಾಗು ತಿಳುವಳಿಕೆಯ ನಾಯಕನಿಂದಲೇ ದೇಶವು ಸುಸ್ಥಿರವಾಗುವುದು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ಬಡವರನ್ನು ಹಿಂಸಿಸುವ ಅಧಿಕಾರಿಯು","poem":1},{"text":"ಆಹಾರವನ್ನು ಉಳಿಸದಂತೆ ಸುರಿಯುವ ಮಳೆಯಂತಿದ್ದಾನೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ಬೋಧನೆಯನ್ನು ತ್ಯಜಿಸುವವರು ದುಷ್ಟರನ್ನು ಹೊಗಳುತ್ತಾರೆ;","poem":1},{"text":"ಆದರೆ ಬೋಧನೆಯನ್ನು ಕೈಗೊಳ್ಳುವವರು ಅವರೊಂದಿಗೆ ಹೋರಾಡುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ನ್ಯಾಯವನ್ನು ದುಷ್ಟರು ಗ್ರಹಿಸುವುದಿಲ್ಲ;","poem":1},{"text":"ಆದರೆ ಯೆಹೋವ ದೇವರನ್ನು ಹುಡುಕುವವರು ಎಲ್ಲವುಗಳನ್ನು ಗ್ರಹಿಸುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ಐಶ್ವರ್ಯವಂತನಾಗಿದ್ದರೂ ತನ್ನ ಮಾರ್ಗದಲ್ಲಿ ವಕ್ರವಾಗಿರುವವನಿಗಿಂತ","poem":1},{"text":"ನಿರ್ದೋಷಿಯಾಗಿ ನಡೆಯುವ ದರಿದ್ರನು ಶ್ರೇಷ್ಠನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ವಿವೇಚನೆಯ ಮಗನು ದೇವರ ಶಿಕ್ಷಣವನ್ನು ಕೈಗೊಳ್ಳುವನು.","poem":1},{"text":"ಆದರೆ ಹೊಟ್ಟೆಬಾಕರ ಸಂಗಡಿಗನು ತನ್ನ ತಂದೆಯನ್ನು ಅವಮಾನಪಡಿಸುತ್ತಾನೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ಬಡ್ಡಿಯಿಂದಲೂ ಅನ್ಯಾಯದ ಲಾಭದಿಂದಲೂ ತನ್ನ ಆಸ್ತಿಯನ್ನು ವೃದ್ಧಿಗೊಳಿಸುವವನು,","poem":1},{"text":"ಬಡವರ ಮೇಲೆ ದಯೆ ತೋರಿಸುವವನಿಗೆ ಅದನ್ನು ಕೂಡಿಸುವನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ಶಿಕ್ಷಣವನ್ನು ಕೇಳದಂತೆ ತನ್ನ ಕಿವಿ ಮುಚ್ಚಿಕೊಳ್ಳುವವನ","poem":1},{"text":"ಪ್ರಾರ್ಥನೆಯು ದೇವರಿಗೆ ಅಸಹ್ಯ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ಪ್ರಾಮಾಣಿಕರನ್ನು ದುರ್ಮಾರ್ಗದಲ್ಲಿ ದಾರಿತಪ್ಪಿಸುವವನು,","poem":1},{"text":"ತಾನೇ ತೋಡಿದ ಗುಂಡಿಯಲ್ಲಿ ಬೀಳುವನು.","poem":2},{"lineBreak":true},{"text":"ನಿರ್ದೋಷಿಗಳಾದರೋ ಒಳ್ಳೆಯ ಸೊತ್ತನ್ನು ಪಡೆಯುವರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ಐಶ್ವರ್ಯವಂತನು ತನ್ನ ಸ್ವಂತ ಅಭಿಪ್ರಾಯದಲ್ಲಿ ಜ್ಞಾನಿಯಾಗಿದ್ದಾನೆ.","poem":1},{"text":"ಆದರೆ ವಿವೇಚನೆಯುಳ್ಳ ಬಡವನು ಅವನ ವಂಚನೆಯನ್ನು ನೋಡಬಲ್ಲನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ನೀತಿವಂತರಿಗೆ ಜಯವಾದರೆ, ದೊಡ್ಡ ಘನತೆ ಇರುವುದು.","poem":1},{"text":"ಆದರೆ ದುಷ್ಟರಿಗೆ ಏಳಿಗೆಯಾದರೆ, ಮನುಷ್ಯರು ಅಡಗಿಕೊಳ್ಳುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ತನ್ನ ಪಾಪಗಳನ್ನು ಮುಚ್ಚಿಕೊಳ್ಳುವವನಿಗೆ ಏಳಿಗೆ ಆಗುವುದಿಲ್ಲ.","poem":1},{"text":"ಆದರೆ ಪಾಪಗಳನ್ನು ಒಪ್ಪಿಕೊಂಡು ಬಿಟ್ಟುಬಿಡುವವನಿಗೆ ಕರುಣೆ ದೊರಕುವುದು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ಯಾವಾಗಲೂ ಯೆಹೋವ ದೇವರ ಭಯಭಕ್ತಿಯಲ್ಲಿ ನಡೆದುಕೊಳ್ಳುವವನು ಧನ್ಯನು.","poem":1},{"text":"ಆದರೆ ಹೃದಯವನ್ನು ಕಠಿಣಪಡಿಸಿಕೊಳ್ಳುವವನು ಕೇಡಿಗೆ ಸಿಕ್ಕಿಬೀಳುವನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ಗರ್ಜಿಸುವ ಸಿಂಹದಂತೆಯೂ ಅಲೆದಾಡುವ ಕರಡಿಯಂತೆಯೂ,","poem":1},{"text":"ಬಡವರನ್ನು ದುಷ್ಟನು ಆಳುವನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ಗ್ರಹಿಕೆಯಿಲ್ಲದ ಅಧಿಕಾರಿಯು ಮಹಾ ಸುಲಿಗೆಗಾರನು.","poem":1},{"text":"ಆದರೆ ಲೋಭವನ್ನು ಹಗೆಮಾಡುವವನು ದೀರ್ಘಾಯುಷ್ಯನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ನರಹತ್ಯದ ಅಪರಾಧ ಭಾವನೆಯಿಂದ ಇರುವವನು,","poem":1},{"text":"ಮರಣದೆಡೆಗೆ ಓಡುತ್ತಿರುವನು,","poem":2},{"lineBreak":true},{"text":"ಅವನನ್ನು ಯಾರೂ ತಡೆಯದಿರಲಿ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ನಿರ್ದೋಷಿಯಾಗಿ ನಡೆಯುವವನು ಸಂರಕ್ಷಣೆ ಹೊಂದುವನು.","poem":1},{"text":"ವಕ್ರಮಾರ್ಗಿಯು ತಟ್ಟನೆ ಬೀಳುವನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ತನ್ನ ಹೊಲವನ್ನು ವ್ಯವಸಾಯ ಮಾಡುವವನು ಆಹಾರದಿಂದ ತೃಪ್ತಿಹೊಂದುವನು.","poem":1},{"text":"ಆದರೆ ವ್ಯರ್ಥ ಕಾರ್ಯವನ್ನು ಹಿಂಬಾಲಿಸುವವನಿಗೆ ಸಾಕಾದಷ್ಟು ಬಡತನವು ಇರುವುದು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ನಂಬಿಗಸ್ತನಾದ ಮನುಷ್ಯನು ಆಶೀರ್ವಾದಗಳಲ್ಲಿ ತುಂಬಿತುಳುಕುವನು;","poem":1},{"text":"ಆದರೆ ಧನವಂತನಾಗಲು ಆತುರಪಡುವವನು, ನಿರ್ದೋಷಿಯಾಗಿರುವುದಿಲ್ಲ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ಪಕ್ಷಪಾತವು ಸರಿಯಲ್ಲ;","poem":1},{"text":"ತುತ್ತು ರೊಟ್ಟಿಗಾಗಿ ಒಬ್ಬನು ದ್ರೋಹ ಮಾಡುವನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ಧನವಂತನಾಗಲು ಆತುರಪಡುವವನು ಕೆಟ್ಟ ಕಣ್ಣುಳ್ಳವನಾಗಿದ್ದಾನೆ;","poem":1},{"text":"ತನಗೆ ಬಡತನವು ಬರುವುದನ್ನು ಅವನು ಯೋಚಿಸುವುದಿಲ್ಲ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ತನ್ನ ನಾಲಿಗೆಯಿಂದ ಮುಖಸ್ತುತಿ ಮಾಡುವವನಿಗಿಂತ,","poem":1},{"text":"ಒಬ್ಬನನ್ನು ಗದರಿಸುವವನು ತರುವಾಯ ಹೆಚ್ಚು ದಯಾಪಾತ್ರನಾಗುವನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ತನ್ನ ತಂದೆಯಾನ್ನಾಗಲಿ,","poem":1},{"text":"ತಾಯಿಯನ್ನಾಗಲಿ ದೋಚಿಕೊಂಡು,","poem":2},{"lineBreak":true},{"text":"“ಇದು ದೋಷವಲ್ಲ,” ಎಂದು ಹೇಳುವವನು ಕೆಡುಕನಿಗೆ ಜೊತೆಗಾರನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ದುರಾಶೆಯುಳ್ಳವನು ಕಲಹವನ್ನೆಬ್ಬಿಸುವನು;","poem":1},{"text":"ಯೆಹೋವ ದೇವರಲ್ಲಿ ಭರವಸವಿಡುವವನು ಪುಷ್ಟನಾಗುವನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ತನ್ನ ಬುದ್ಧಿಯಲ್ಲಿಯೇ ಭರವಸವಿಡುವವನು ಬುದ್ಧಿಹೀನನು;","poem":1},{"text":"ಆದರೆ ಜ್ಞಾನದಿಂದ ನಡೆಯುವವನು ಉದ್ಧಾರ ಹೊಂದುವನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ಬಡವರಿಗೆ ದಾನ ಮಾಡುವವನು, ಕೊರತೆ ಪಡುವುದಿಲ್ಲ;","poem":1},{"text":"ಆದರೆ ತನ್ನ ಕಣ್ಣುಗಳನ್ನು ಮುಚ್ಚಿಕೊಳ್ಳುವವನಿಗೆ ಅನೇಕ ಶಾಪಗಳು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ದುಷ್ಟರು ಎದ್ದರೆ ಜನರು ಅಡಗಿಕೊಳ್ಳುತ್ತಾರೆ,","poem":1},{"text":"ಆದರೆ ಅವರು ನಾಶವಾದಾಗ ನೀತಿವಂತರು ವೃದ್ಧಿಯಾಗುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/kan_okcv/PRO/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/PRO/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/PRO/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}