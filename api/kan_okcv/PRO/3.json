{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"PRO","translationId":"kan_okcv","name":"ಜ್ಞಾನೋಕ್ತಿಗಳು","commonName":"ಜ್ಞಾನೋಕ್ತಿಗಳು","title":"ಜ್ಞಾನೋಕ್ತಿಗಳು","order":20,"numberOfChapters":31,"sha256":"db78a84ced0f5c6868005c76f5f2e0a81d61a265338d0405b06b96bd084f0f0e","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kan_okcv/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":3,"content":[{"type":"heading","content":["ಜ್ಞಾನದಿಂದ ಇನ್ನಷ್ಟು ಲಾಭಗಳು"]},{"type":"verse","number":1,"content":[{"text":"ಮಗನೇ, ನನ್ನ ಉಪದೇಶವನ್ನು ಮರೆಯಬೇಡ;","poem":1},{"text":"ನನ್ನ ಆಜ್ಞೆಗಳನ್ನು ನಿನ್ನ ಹೃದಯದಲ್ಲಿ ಇಟ್ಟುಕೋ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ಏಕೆಂದರೆ ಅವು ನಿನ್ನ ದಿನಗಳನ್ನು ಹೆಚ್ಚಿಸಿ ದೀರ್ಘಾಯುಷ್ಯವನ್ನು ನೀಡುವುದು,","poem":1},{"text":"ಸಮಾಧಾನವನ್ನೂ ಸಮೃದ್ಧಿಯನ್ನೂ ನಿನಗೆ ಕೊಡುವುದು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ಪ್ರೀತಿ, ನಂಬಿಗಸ್ತಿಕೆಗಳು ನಿನ್ನನ್ನು ಬಿಡದಿರಲಿ;","poem":1},{"text":"ಅವು ನಿನ್ನ ಕೊರಳಿನ ಸುತ್ತಲೂ ಕಟ್ಟಿರಲಿ,","poem":2},{"lineBreak":true},{"text":"ನಿನ್ನ ಹೃದಯದ ಹಲಗೆಯ ಮೇಲೆ ಅವು ಬರೆದಿರಲಿ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ಆಗ ದೇವರ ಮುಂದೆಯೂ ಮನುಷ್ಯರ ಮುಂದೆಯೂ ದಯೆಯನ್ನೂ,","poem":1},{"text":"ಒಳ್ಳೆಯ ಹೆಸರನ್ನೂ ನೀನು ಪಡೆದುಕೊಳ್ಳುವೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ಪೂರ್ಣಹೃದಯದಿಂದ ಯೆಹೋವ ದೇವರಲ್ಲಿ ಭರವಸೆ ಇಡು","poem":1},{"text":"ನಿನ್ನ ಸ್ವಂತ ಬುದ್ಧಿಯ ಮೇಲೆಯೇ ಆಧಾರಗೊಳ್ಳಬೇಡ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ನಿನ್ನ ಎಲ್ಲಾ ಮಾರ್ಗಗಳಲ್ಲಿ ದೇವರಿಗೆ ಅಧೀನವಾಗಿರು.","poem":1},{"text":"ಆಗ ದೇವರು ನಿನ್ನ ಮಾರ್ಗಗಳನ್ನು ಸರಾಗ ಮಾಡುವರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ನಿನ್ನ ದೃಷ್ಟಿಯಲ್ಲಿ ನೀನೇ ಜ್ಞಾನಿ ಎಂದು ಇರಬೇಡ;","poem":1},{"text":"ಯೆಹೋವ ದೇವರಿಗೆ ಭಯಪಟ್ಟು, ಕೆಟ್ಟದ್ದನ್ನು ತೊರೆದುಬಿಡು.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ನಿನ್ನ ದೇಹಕ್ಕೆ ಅದು ಆರೋಗ್ಯವನ್ನು ತರುವುದು;","poem":1},{"text":"ನಿನ್ನ ಎಲುಬುಗಳಿಗೆ ಅದು ಪೋಷಣೆಯನ್ನೂ ತರುವುದು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ನಿನ್ನ ಆಸ್ತಿಯಿಂದಲೂ","poem":1},{"text":"ನಿನ್ನ ಎಲ್ಲಾ ಬೆಳೆಯ ಪ್ರಥಮ ಫಲದಿಂದಲೂ ಯೆಹೋವ ದೇವರನ್ನು ಸನ್ಮಾನಿಸು.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ಆಗ ನಿನ್ನ ಕಣಜಗಳು ಸಮೃದ್ಧಿಯಿಂದ ತುಂಬುವವು;","poem":1},{"text":"ಹೊಸ ದ್ರಾಕ್ಷಾರಸದಿಂದ ನಿನ್ನ ತೊಟ್ಟಿಗಳು ತುಂಬಿರುವುದು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ಮಗನೇ, ಯೆಹೋವ ದೇವರ ಶಿಕ್ಷೆಯನ್ನು ತಾತ್ಸಾರ ಮಾಡಬೇಡ;","poem":1},{"text":"ಅವರು ನಿನ್ನನ್ನು ಗದರಿಸುವಾಗ ಬೇಸರಗೊಳ್ಳಬೇಡ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ಏಕೆಂದರೆ ತಂದೆಯು ತನ್ನ ಮುದ್ದುಮಗನನ್ನು ಶಿಕ್ಷಿಸುವಂತೆ,","poem":1},{"text":"ಯೆಹೋವ ದೇವರು ಯಾರನ್ನು ಪ್ರೀತಿಸುತ್ತಾರೋ, ಅವರನ್ನು ಶಿಸ್ತುಗೊಳಿಸುವರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ಜ್ಞಾನವನ್ನು ಕಂಡುಕೊಳ್ಳುವವನು ಧನ್ಯನು,","poem":1},{"text":"ವಿವೇಕವನ್ನು ಸಂಪಾದಿಸಿಕೊಳ್ಳುವವನೂ ಧನ್ಯನು.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ಏಕೆಂದರೆ ಜ್ಞಾನವು ಬೆಳ್ಳಿಗಿಂತ ಹೆಚ್ಚು ಲಾಭವೂ;","poem":1},{"text":"ಬಂಗಾರಕ್ಕಿಂತ ಹೆಚ್ಚು ಆದಾಯವನ್ನು ಕೊಡುವುದು.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ಜ್ಞಾನವು ಮಾಣಿಕ್ಯಗಳಿಗಿಂತಲೂ ಬಹು ಅಮೂಲ್ಯ;","poem":1},{"text":"ನಿನ್ನ ಇಷ್ಟ ವಸ್ತುಗಳೆಲ್ಲವೂ ಅದಕ್ಕೆ ಸಮವಾಗುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ಜ್ಞಾನದ ಬಲಗೈಯಲ್ಲಿ ದೀರ್ಘಾಯುಷ್ಯವಿದೆ;","poem":1},{"text":"ಎಡಗೈಯಲ್ಲಿ ಐಶ್ವರ್ಯವೂ ಘನತೆಯೂ ಇವೆ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ಜ್ಞಾನದ ಮಾರ್ಗಗಳು ಸಂತೋಷಕರ;","poem":1},{"text":"ಅದರ ದಾರಿಗಳೆಲ್ಲಾ ಶಾಂತಿಯ ದಾರಿಗಳೇ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ಜ್ಞಾನವನ್ನು ಹಿಡಿದುಕೊಳ್ಳುವವರಿಗೆ ಜ್ಞಾನವು ಜೀವವೃಕ್ಷವಾಗಿದೆ;","poem":1},{"text":"ಅದನ್ನು ಭದ್ರವಾಗಿ ಇಟ್ಟುಕೊಳ್ಳುವವರು ಧನ್ಯರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ಯೆಹೋವ ದೇವರು ಜ್ಞಾನದಿಂದ ಭೂಮಿಯನ್ನು ಸ್ಥಾಪಿಸಿದರು,","poem":1},{"text":"ತಮ್ಮ ತಿಳುವಳಿಕೆಯ ಮೂಲಕ ಅವರು ಆಕಾಶಗಳನ್ನು ಸ್ಥಿರಪಡಿಸಿದರು.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ದೇವರು ತಮ್ಮ ಅರಿವಿನಿಂದಲೇ ಸೆಲೆಗಳು ಒಡೆದು,","poem":1},{"text":"ಮೇಘಗಳು ಇಬ್ಬನಿಯನ್ನು ಸುರಿಸುತ್ತವೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ಮಗನೇ, ಜ್ಞಾನವನ್ನೂ ತಿಳುವಳಿಕೆಯನ್ನೂ ಕಾಪಾಡಿಕೋ,","poem":1},{"text":"ನಿನ್ನ ಕಣ್ಣುಗಳಿಂದ ಅವು ತಪ್ಪಿಹೋಗದೆ ಇರಲಿ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ಅವು ನಿನಗೆ ಜೀವವಾಗಿರಲಿ.","poem":1},{"text":"ನಿನ್ನ ಕೊರಳಿಗೆ ಆಭರಣವೂ ಆಗಿರುವುವು.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ಆಗ ನಿನ್ನ ಮಾರ್ಗದಲ್ಲಿ ಸುರಕ್ಷಿತವಾಗಿರುವೆ;","poem":1},{"text":"ನೀನು ಎಡವದೆ ನಡೆಯುವೆ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ನೀನು ಮಲಗುವಾಗ ನಿನಗೆ ಹೆದರಿಕೆ ಇರುವುದಿಲ್ಲ;","poem":1},{"text":"ನೀನು ಮಲಗಿದಾಗ ನಿದ್ರೆಯು ಸುಖವಾಗಿರುವುದು.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ಆಕಸ್ಮಿಕ ವಿಪತ್ತಿಗೆ ನೀನು ಅಂಜುವುದಿಲ್ಲ;","poem":1},{"text":"ದುಷ್ಟರ ಮೇಲೆ ಬರುವ ನಾಶನಕ್ಕೂ ನೀನು ಭಯಪಡದಿರುವೆ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರೇ ನಿನಗೆ ಭರವಸೆ ಆಗಿದ್ದಾರೆ,","poem":1},{"text":"ನಿನ್ನ ಪಾದವು ಉರುಲಿಗೆ ಸಿಕ್ಕದಂತೆ ಅವರು ಕಾಪಾಡುವರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ನಿನಗೆ ಶಕ್ತಿಯಿರುವಾಗಲೇ ಇತರರಿಗೆ ಉಪಕಾರಮಾಡು","poem":1},{"text":"ಒಳಿತು ಮಾಡುವುದನ್ನು ನಿನ್ನಲ್ಲಿಯೇ ಇಟ್ಟುಕೊಳ್ಳಬೇಡ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ಕೊಡತಕ್ಕದ್ದು ಈಗಾಗಲೇ ನಿನ್ನಲ್ಲಿರುವಾಗ,","poem":1},{"text":"“ಹೋಗಿ ಬಾ, ನಾಳೆ ನಿನಗೆ ಕೊಡುತ್ತೇನೆ,”","poem":2},{"lineBreak":true},{"text":"ಎಂದು ನಿನ್ನ ನೆರೆಯವನಿಗೆ ಹೇಳಬೇಡ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ನಿನ್ನ ನೆರೆಯವನು ಭರವಸೆಯಿಂದ ನಿನ್ನ ಪಕ್ಕದಲ್ಲಿ ವಾಸಮಾಡುತ್ತಿರುವಾಗ,","poem":1},{"text":"ಅವನಿಗೆ ವಿರೋಧವಾಗಿ ಕೇಡನ್ನು ಕಲ್ಪಿಸಬೇಡ.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ಒಬ್ಬನು ನಿನಗೆ ಯಾವ ತೊಂದರೆ ಮಾಡದಿದ್ದರೆ,","poem":1},{"text":"ಅವನೊಂದಿಗೆ ಕಾರಣವಿಲ್ಲದೆ ದೂರು ನುಡಿಯಬೇಡ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"ಬಲಾತ್ಕಾರಿಯ ವಿಷಯದಲ್ಲಿ ನೀನು ಹೊಟ್ಟೆಕಿಚ್ಚುಪಡಬೇಡ;","poem":1},{"text":"ಅವನ ಮಾರ್ಗಗಳಲ್ಲಿ ಯಾವುದನ್ನೂ ನೀನು ಆರಿಸಿಕೊಳ್ಳಬೇಡ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"ಏಕೆಂದರೆ ವಕ್ರಬುದ್ಧಿ ಯೆಹೋವ ದೇವರಿಗೆ ಅಸಹ್ಯ;","poem":1},{"text":"ಆದರೆ ದೇವರ ನಂಬಿಗಸ್ತಿಕೆ ನೀತಿವಂತರೊಂದಿಗೆ ಇದೆ.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ದುಷ್ಟರ ಮನೆಯ ಮೇಲೆ ದೈವಶಾಪವಿದೆ.","poem":1},{"text":"ಆದರೆ ನೀತಿವಂತರ ನಿವಾಸದ ಮೇಲೆ ದೈವಾಶೀರ್ವಾದವಿರುವುದು.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ದೇವರು ಗರ್ವಿಷ್ಠ ಪರಿಹಾಸ್ಯಗಾರರನ್ನು ಪರಿಹಾಸ್ಯ ಮಾಡುತ್ತಾರೆ;","poem":1},{"text":"ದೀನರಿಗಾದರೋ ದೇವರು ಕೃಪೆಯನ್ನು ಕೊಡುತ್ತಾರೆ.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ಜ್ಞಾನಿಗಳು ಸನ್ಮಾನಕ್ಕೆ ಬಾಧ್ಯನಾಗುವರು;","poem":1},{"text":"ಆದರೆ ಜ್ಞಾನಹೀನರ ಪ್ರತಿಫಲವು ಅವಮಾನವೆ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kan_okcv/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}