{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"PRO","translationId":"kan_okcv","name":"ಜ್ಞಾನೋಕ್ತಿಗಳು","commonName":"ಜ್ಞಾನೋಕ್ತಿಗಳು","title":"ಜ್ಞಾನೋಕ್ತಿಗಳು","order":20,"numberOfChapters":31,"sha256":"db78a84ced0f5c6868005c76f5f2e0a81d61a265338d0405b06b96bd084f0f0e","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kan_okcv/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":4,"content":[{"type":"heading","content":["ಹೇಗಾದರೂ ಜ್ಞಾನವನ್ನು ಪಡೆಯಿರಿ"]},{"type":"verse","number":1,"content":[{"text":"ಮಕ್ಕಳೇ, ತಂದೆಯ ಶಿಕ್ಷಣವನ್ನು ಕೇಳಿರಿ;","poem":1},{"text":"ತಿಳುವಳಿಕೆಯನ್ನು ಗ್ರಹಿಸಲಿಕ್ಕೆ ಗಮನಕೊಡಿರಿ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ಏಕೆಂದರೆ ನಾನು ನಿಮಗೆ ಸದುಪದೇಶವನ್ನು ಮಾಡುವೆನು,","poem":1},{"text":"ನನ್ನ ಉಪದೇಶವನ್ನು ಬಿಟ್ಟುಬಿಡಬೇಡಿರಿ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ನಾನೂ ಕೂಡ ನನ್ನ ತಂದೆಗೆ ನೆಚ್ಚಿನ ಮಗನೂ","poem":1},{"text":"ನನ್ನ ತಾಯಿಗೆ ಮುದ್ದು ಮಗನೂ ಆಗಿದ್ದೆನು.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ನನ್ನ ತಂದೆ ನನಗೆ ಬೋಧಿಸಿ ಹೇಳಿದ್ದೇನೆಂದರೆ,","poem":1},{"text":"“ನನ್ನ ಮಾತುಗಳನ್ನು ಮನಃಪೂರ್ವಕವಾಗಿ ಪಾಲಿಸು;","poem":2},{"lineBreak":true},{"text":"ನನ್ನ ಆಜ್ಞೆಗಳನ್ನು ಕೈಗೊಳ್ಳು, ಆಗ ನೀನು ಬಾಳುವೆ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ಜ್ಞಾನವನ್ನು ಪಡೆ, ತಿಳುವಳಿಕೆಯನ್ನು ಸಂಪಾದಿಸು;","poem":1},{"text":"ನನ್ನ ಮಾತುಗಳನ್ನು ಮರೆಯದಿರು, ಅವುಗಳಿಂದ ದೂರವಾಗಬೇಡ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ಜ್ಞಾನವನ್ನು ಬಿಟ್ಟುಬಿಡಬೇಡ, ಆಕೆ","poem":1},{"noteId":0},{"text":"ನಿನ್ನನ್ನು ಕಾಪಾಡುವಳು;","poem":1},{"text":"ಆಕೆಯನ್ನು ಪ್ರೀತಿಸು, ಆಕೆ ನಿನ್ನನ್ನು ಕಾಯುವಳು.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ಜ್ಞಾನವೇ ಮುಖ್ಯವಾದದ್ದು, ಆದ್ದರಿಂದ ಜ್ಞಾನವನ್ನು ಸಂಪಾದಿಸು;","poem":1},{"text":"ನಿನ್ನಲ್ಲಿರುವ ಎಲ್ಲಾ ಸಂಪತ್ತನ್ನು ವ್ಯಯಮಾಡಿದರೂ ತಿಳುವಳಿಕೆಯನ್ನು ಪಡೆದುಕೋ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ಜ್ಞಾನವನ್ನು ನೀನು ಅಮೂಲ್ಯವೆಂದು ಎಣಿಸು, ಆಕೆಯು ನಿನ್ನನ್ನು ಮೇಲೆತ್ತುವಳು;","poem":1},{"text":"ಆಕೆಯನ್ನು ನೀನು ಅಪ್ಪಿಕೊ, ಆಕೆಯು ನಿನ್ನನ್ನು ಘನಪಡಿಸುವಳು.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ಆಕೆಯನ್ನು ನಿನ್ನ ತಲೆಗೆ ಮಹಿಮೆಯ ಕಿರೀಟವಾಗಿರುವಳು;","poem":1},{"text":"ಆಕೆಯನ್ನು ನಿನಗೆ ಘನತೆಯ ಕಿರೀಟವನ್ನು ಸಮರ್ಪಿಸುವಳು.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ಮಗನೇ, ಆಲಿಸಿ ನನ್ನ ಮಾತುಗಳನ್ನು ಸ್ವೀಕರಿಸು,","poem":1},{"text":"ಆಗ ನಿನ್ನ ಜೀವನದ ವರ್ಷಗಳು ಹೆಚ್ಚುವವು.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ಜ್ಞಾನ ಮಾರ್ಗದಲ್ಲಿ ನಾನು ನಿನಗೆ ಶಿಕ್ಷಣಕೊಡುವೆನು,","poem":1},{"text":"ನೇರ ಮಾರ್ಗಗಳಲ್ಲಿ ನಿನ್ನನ್ನು ಮುನ್ನಡಿಸುವೆನು.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ನೀನು ನಡೆಯುವಾಗ ನಿನ್ನ ಹೆಜ್ಜೆಗೆ ತಡೆಯಾಗದು;","poem":1},{"text":"ನೀನು ಓಡುವಾಗ ಮುಗ್ಗರಿಸಿ ಬೀಳುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ಶಿಕ್ಷಣವನ್ನು ಗಟ್ಟಿಯಾಗಿ ಹಿಡಿದುಕೋ, ಅದು ನಿನ್ನಿಂದ ತೊಲಗದೆ ಇರಲಿ;","poem":1},{"text":"ಸದುಪದೇಶವನ್ನು ಕಾಪಾಡಿಕೋ, ಏಕೆಂದರೆ ಅದು ನಿನ್ನ ಜೀವವಾಗಿದೆ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ದುಷ್ಟರ ದಾರಿಯೊಳಗೆ ನೀನು ಪ್ರವೇಶಿಸದಿರು","poem":1},{"text":"ಕೆಟ್ಟವರ ಮಾರ್ಗದಲ್ಲಿ ನೀನು ಹೋಗಬೇಡ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ಆ ದಾರಿಯಿಂದ ತೊಲಗು, ಅದರ ಪಕ್ಕದಲ್ಲಿ ಹಾದು ಹೋಗಬೇಡ;","poem":1},{"text":"ಅದರಿಂದ ತಪ್ಪಿಸಿಕೊಂಡು, ನಿನ್ನ ಮಾರ್ಗದಲ್ಲಿ ಮುಂದೆ ನಡೆ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ಕೇಡು ಮಾಡದಿದ್ದರೆ ದುಷ್ಟರಿಗೆ ನಿದ್ರೆಬಾರದು;","poem":1},{"text":"ಯಾರನ್ನಾದರೂ ಬೀಳಿಸದಿದ್ದರೆ, ಅವರಿಗೆ ನಿದ್ರೆ ಹತ್ತುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ಅವರಿಗೆ ದುಷ್ಟತನವೇ ಆಹಾರ,","poem":1},{"text":"ಬಲಾತ್ಕಾರವೇ ಅವರಿಗೆ ದ್ರಾಕ್ಷಾರಸ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ನೀತಿವಂತರ ಮಾರ್ಗವು ಮುಂಜಾನೆಯ ಸೂರ್ಯನ ಬೆಳಕಿನಂತೆ ಇದ್ದು,","poem":1},{"text":"ದಿನದ ಪೂರ್ಣ ಬೆಳಕಿನವರೆಗೂ ಪ್ರಕಾಶಿಸಿ ಹೊಳೆಯುತ್ತಾ ಇರುವುದು.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ಆದರೆ, ದುಷ್ಟರ ಮಾರ್ಗವು ಕಗ್ಗತ್ತಲಿನಂತಿದೆ.","poem":1},{"text":"ಅವರು ಯಾವುದಕ್ಕೆ ಎಡವಿ ಬೀಳುತ್ತಾರೋ ಅದು ಅವರಿಗೆ ಗೊತ್ತಾಗದು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ಮಗನೇ, ನನ್ನ ಮಾತುಗಳಿಗೆ ಗಮನಕೊಡು;","poem":1},{"text":"ನನ್ನ ನುಡಿಗಳಿಗೆ ಕಿವಿಗೊಡು.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ಆ ನುಡಿಗಳು ನಿನ್ನ ಕಣ್ಣುಗಳಿಂದ ತಪ್ಪಿ ಹೋಗದಿರಲಿ;","poem":1},{"text":"ಅವುಗಳನ್ನು ನಿನ್ನ ಹೃದಯದೊಳಗೆ ಇಟ್ಟುಕೋ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ಏಕೆಂದರೆ ಆ ನುಡಿಗಳನ್ನು ಕಂಡುಕೊಳ್ಳುವವರಿಗೆ ಅವು ಜೀವವೂ,","poem":1},{"text":"ದೇಹಕ್ಕೆಲ್ಲಾ ಆರೋಗ್ಯವೂ ಆಗಿವೆ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ಬಹು ಜಾಗ್ರತೆಯಿಂದ ನಿನ್ನ ಹೃದಯವನ್ನು ಕಾಪಾಡಿಕೋ;","poem":1},{"text":"ಏಕೆಂದರೆ ಅದರೊಳಗಿಂದ ನಿನ್ನ ಕೃತ್ಯಗಳು ಜೀವಧಾರೆಯಾಗಿ ಹೊರಡುತ್ತವೆ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ವಕ್ರಮಾತುಗಳನ್ನು ನಿನ್ನ ಬಾಯಿಂದ ತೊಲಗಿಸಿ;","poem":1},{"text":"ಕೆಟ್ಟ ಮಾತುಗಳು ನಿನ್ನ ತುಟಿಗಳಿಂದ ದೂರವಿರಲಿ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ನಿನ್ನ ದೃಷ್ಟಿ ನೇರವಾಗಿಯೇ ನೋಡಲಿ;","poem":1},{"text":"ನಿನ್ನ ನೋಟವು ನೇರವಾಗಿ ನಿನ್ನ ಮುಂದೆಯೇ ನಾಟಿರಲಿ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ನೀನು ನಡೆಯುವ ದಾರಿಯ ಬಗ್ಗೆ ಗಮನವಿರಲಿ;","poem":1},{"text":"ನೀನು ಕೈಗೊಳ್ಳುವ ಹಾದಿ ಸ್ಥಿರವಾಗಿರಲಿ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ನಿನ್ನ ಬಲಕ್ಕಾಗಲಿ, ಎಡಕ್ಕಾಗಲಿ ತಿರುಗಬೇಡ;","poem":1},{"text":"ಕೇಡಿನಿಂದ ನಿನ್ನ ಕಾಲುಗಳು ದೂರವಿರಲಿ.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"ಆಕೆ ಅಂದರೆ ಜ್ಞಾನ","reference":{"chapter":4,"verse":6}}]},"thisChapterLink":"/api/kan_okcv/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}