{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"PRO","translationId":"kan_okcv","name":"ಜ್ಞಾನೋಕ್ತಿಗಳು","commonName":"ಜ್ಞಾನೋಕ್ತಿಗಳು","title":"ಜ್ಞಾನೋಕ್ತಿಗಳು","order":20,"numberOfChapters":31,"sha256":"db78a84ced0f5c6868005c76f5f2e0a81d61a265338d0405b06b96bd084f0f0e","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kan_okcv/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":6,"content":[{"type":"heading","content":["ಬುದ್ಧಿಹೀನತೆಯ ವಿರುದ್ಧ ಎಚ್ಚರಿಕೆಗಳು"]},{"type":"verse","number":1,"content":[{"text":"ಮಗನೇ, ನಿನ್ನ ನೆರೆಯವನಿಗೆ ನೀನು ಹೊಣೆಯಾಗಿದ್ದರೆ,","poem":1},{"text":"ಪರನಿಗಾಗಿ ನಿನ್ನ ಕೈಯನ್ನು ಒಡ್ಡಿದ್ದರೆ,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ನೀನು ನುಡಿದ ನಿನ್ನ ಬಾಯಿ ಮಾತುಗಳಿಂದಲೇ ಸಿಕ್ಕಿಕೊಂಡಿರುವೆ.","poem":1},{"text":"ನಿನ್ನ ಬಾಯಿ ಮಾತುಗಳೇ ನಿನ್ನನ್ನು ಸೆರೆಹಿಡಿದಿದೆ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ಮಗನೇ, ನೀನು ನಿನ್ನ ನೆರೆಯವನ ಕೈಗೆ ಸಿಕ್ಕಿಕೊಂಡದರಿಂದ,","poem":1},{"text":"ನಿನ್ನನ್ನು ನೀನು ತಪ್ಪಿಸಿಕೊಳ್ಳಲು ಇದನ್ನು ಮಾಡು:","poem":2},{"text":"ಹೋಗಿ ನಿನ್ನನ್ನು ನೀನು ತಗ್ಗಿಸಿಕೋ,","poem":1},{"text":"ನಿನ್ನ ನೆರೆಯವನಿಗೆ ವಿಶ್ರಾಂತಿಯನ್ನು ಕೊಡಬೇಡ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ನಿನ್ನ ಕಣ್ಣುಗಳಿಗೆ ನಿದ್ರೆಯನ್ನೂ","poem":1},{"text":"ನಿನ್ನ ರೆಪ್ಪೆಗಳಿಗೆ ತೂಕಡಿಕೆಯನ್ನೂ ಕೊಡಬೇಡ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ಬೇಟೆಗಾರನ ಕೈಯಿಂದ ಜಿಂಕೆಯೂ,","poem":1},{"text":"ಬಲೆ ಬೀಸುವವನ ಕೈಯಿಂದ ಪಕ್ಷಿಯೂ ತಪ್ಪಿಸಿಕೊಳ್ಳುವಂತೆ ನೀನು ತಪ್ಪಿಸಿಕೋ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ಸೋಮಾರಿಯೇ, ನೀನು ಇರುವೆಯ ಹತ್ತಿರ ಹೋಗಿ,","poem":1},{"text":"ಅದರ ನಡವಳಿಕೆಯನ್ನು ನೋಡಿ ಜ್ಞಾನವಂತನಾಗು.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ನಾಯಕನಾಗಲೀ, ಮೇಲ್ವಿಚಾರಕನಾಗಲೀ,","poem":1},{"text":"ಅಧಿಕಾರಿಯಾಗಲೀ ಇರುವೆಗೆ ಇಲ್ಲದೆ ಹೋದರೂ,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ಬೇಸಿಗೆಯಲ್ಲಿ ಅದು ತನ್ನ ಆಹಾರವನ್ನು ಸಂಗ್ರಹಿಸುತ್ತದೆ.","poem":1},{"text":"ಸುಗ್ಗಿಯಲ್ಲಿ ತನ್ನ ಆಹಾರವನ್ನು ಕೂಡಿಸಿಕೊಳ್ಳುತ್ತದೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ಸೋಮಾರಿಯೇ, ಎಷ್ಟು ಹೊತ್ತು ನೀನು ನಿದ್ರೆ ಮಾಡುವುದು?","poem":1},{"text":"ನಿನ್ನ ನಿದ್ರೆಯಿಂದ ಯಾವಾಗ ಎಚ್ಚರಗೊಳ್ಳುವೆ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ಇನ್ನು ಸ್ವಲ್ಪ ನಿದ್ರೆ, ಇನ್ನು ಸ್ವಲ್ಪ ತೂಕಡಿಕೆ,","poem":1},{"text":"ಇನ್ನೂ ಸ್ವಲ್ಪ ವಿಶ್ರಾಂತಿಗಾಗಿ ಕೈ ಮುದುರಿಕೊಳ್ಳುವೆ ಎನ್ನುವೆಯಾ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ಹೀಗೆ ನಿನಗೆ ಬಡತನವು ಕಳ್ಳನಂತೆಯೂ","poem":1},{"text":"ಕೊರತೆಯು ಶಸ್ತ್ರಧಾರಿಯಂತೆಯೂ ನಿನ್ನ ಮೇಲೆ ಬರುವುವು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ತೊಂದರೆಕೊಡುವವನೂ ಕೆಡುಕನೂ","poem":1},{"text":"ಆಗಿರುವವನ ಬಾಯಿಂದ ಕುಟಿಲ ಮಾತೇ ಬರುವುದು.","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ಅವನು ಕಣ್ಣು ಮಿಟುಕಿಸುತ್ತಾನೆ,","poem":2},{"lineBreak":true},{"text":"ಕಾಲು ಕೆರೆಯುತ್ತಾನೆ,","poem":2},{"lineBreak":true},{"text":"ಬೆರಳು ಸನ್ನೆಮಾಡುತ್ತಾನೆ,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ಅವನು ತನ್ನ ಹೃದಯದಲ್ಲಿ ಮೋಸಕರ ಯೋಜನೆಯನ್ನೇ ಮಾಡುತ್ತಾನೆ;","poem":2},{"lineBreak":true},{"text":"ಯಾವಾಗಲೂ ಅವನು ಜಗಳವನ್ನು ಕಲ್ಪಿಸುತ್ತಾನೆ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ಆದ್ದರಿಂದ ಅವನಿಗೆ ವಿಪತ್ತು ಬೇಗ ಬರುವುದು;","poem":1},{"text":"ಯಾವ ಪರಿಹಾರವಿಲ್ಲದೆ ಅವನು ತಟ್ಟನೆ ನಾಶವಾಗುವನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":["ಈ ಆರು ವಿಷಯಗಳನ್ನು ಯೆಹೋವ ದೇವರು ಹಗೆ ಮಾಡುತ್ತಾರೆ; ಹೌದು, ಏಳು ದೇವರಿಗೆ ಅಸಹ್ಯವಾಗಿವೆ, ಅವು ಯಾವವೆಂದರೆ:"]},{"type":"verse","number":17,"content":["ಹೆಮ್ಮೆಯ ದೃಷ್ಟಿ, ಸುಳ್ಳಾಡುವ ನಾಲಿಗೆ, ನಿರಪರಾಧಿಯ ರಕ್ತವನ್ನು ಸುರಿಸುವ ಕೈಗಳು,"]},{"type":"verse","number":18,"content":["ದುರಾಲೋಚನೆಗಳನ್ನು ಕಲ್ಪಿಸುವ ಹೃದಯ, ಕೇಡಿಗೆ ನುಗ್ಗಲು ತ್ವರೆಪಡುವ ಕಾಲುಗಳು,"]},{"type":"verse","number":19,"content":["ಅಸತ್ಯವನ್ನಾಡುವ ಸುಳ್ಳುಸಾಕ್ಷಿ ಮತ್ತು ಸಹೋದರರಲ್ಲಿ ಜಗಳ ಹುಟ್ಟಿಸುವ ವ್ಯಕ್ತಿ."]},{"type":"heading","content":["ವ್ಯಭಿಚಾರಕ್ಕೆ ವಿರುದ್ಧವಾಗಿ ಎಚ್ಚರಿಕೆ"]},{"type":"verse","number":20,"content":[{"text":"ಮಗನೇ, ನಿನ್ನ ತಂದೆಯ ಆಜ್ಞೆಯನ್ನು ಕೈಗೊಳ್ಳು,","poem":1},{"text":"ನಿನ್ನ ತಾಯಿಯ ಬೋಧನೆಯನ್ನು ತ್ಯಜಿಸಬೇಡ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ಅವುಗಳನ್ನು ಯಾವಾಗಲೂ ನಿನ್ನ ಹೃದಯದಲ್ಲಿ ಬಂಧಿಸಿಕೋ.","poem":1},{"text":"ಅವುಗಳನ್ನು ನಿನ್ನ ಕೊರಳಿಗೆ ಧರಿಸಿಕೋ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ನೀನು ನಡೆಯುವಾಗ ಅವು ನಿನಗೆ ಮಾರ್ಗದರ್ಶಿಯಾಗಿರುತ್ತವೆ.","poem":1},{"text":"ನೀನು ಮಲಗುವಾಗ ಅವು ನಿನ್ನನ್ನು ಕಾಯುತ್ತವೆ.","poem":2},{"lineBreak":true},{"text":"ನೀನು ಎಚ್ಚರಗೊಂಡಾಗ ಅವು ನಿನ್ನೊಂದಿಗೆ ಮಾತಾಡುತ್ತವೆ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ಆಜ್ಞೆಯೇ ದೀಪವಾಗಿದೆ,","poem":1},{"text":"ಬೋಧನೆಯೇ ಬೆಳಕಾಗಿದೆ;","poem":2},{"text":"ಶಿಕ್ಷಣದ ತಿದ್ದುವಿಕೆಗಳು","poem":1},{"text":"ಜೀವ ಮಾರ್ಗವಾಗಿವೆ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ಅವು ಕೆಟ್ಟ ಹೆಂಗಸಿನಿಂದಲೂ,","poem":1},{"text":"ಪರಸ್ತ್ರೀಯ ವಂಚಕ ಮಾತಿನಿಂದಲೂ ನಿನ್ನನ್ನು ತಪ್ಪಿಸಿ ಕಾಪಾಡಬಲ್ಲವು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ನಿನ್ನ ಹೃದಯ ಅವಳ ಸೌಂದರ್ಯವನ್ನು ಮೋಹಿಸದಿರಲಿ.","poem":1},{"text":"ಅವಳ ಕಣ್ಣುರೆಪ್ಪೆಗಳಿಂದ ಅವಳು ನಿನ್ನನ್ನು ವಶಮಾಡಿಕೊಳ್ಳದೆ ಇರಲಿ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ಏಕೆಂದರೆ ವೇಶ್ಯೆಯನ್ನು ಊಟದಿಂದ ಕೊಂಡುಕೊಳ್ಳಬಹುದು,","poem":1},{"text":"ಆದರೆ ವ್ಯಭಿಚಾರಿಣಿ ಅಮೂಲ್ಯ ಜೀವವನ್ನೇ ಬೇಟೆಯಾಡುವಳು.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ಒಬ್ಬನು ತನ್ನ ಮಡಿಲಲ್ಲಿ ಬೆಂಕಿಯನ್ನು ಇಟ್ಟುಕೊಂಡರೆ,","poem":1},{"text":"ಅವನ ವಸ್ತ್ರಗಳು ಸುಡುವುದಿಲ್ಲವೋ?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ಒಬ್ಬನು ಧಗಧಗಿಸುವ ಕೆಂಡದ ಮೇಲೆ ನಡೆದರೆ,","poem":1},{"text":"ಅವನ ಪಾದಗಳು ಸುಡುವುದಿಲ್ಲವೋ?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ಪರನ ಹೆಂಡತಿಯನ್ನು ಕೂಡುವವನ ಗತಿಯು ಹೀಗೆಯೇ ಇರುವದು.","poem":1},{"text":"ಅವಳನ್ನು ಮುಟ್ಟುವ ಯಾವನೂ ದಂಡನೆಯಿಂದ ತಪ್ಪಿಸಿಕೊಳ್ಳನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"ಹಸಿದಾಗ ಕಳ್ಳನು ತನ್ನ ಹಸಿವೆಯನ್ನು ತೃಪ್ತಿಪಡಿಸಲು ಕಳವು ಮಾಡಿದರೆ,","poem":1},{"text":"ಜನರು ಅವನನ್ನು ಹೀಯಾಳಿಸುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ಅವನು ಸಿಕ್ಕಿಕೊಂಡರೆ ಏಳರಷ್ಟು ಹಿಂದಕ್ಕೆ ಕೊಡಬೇಕಾಗುವುದು.","poem":1},{"text":"ತನ್ನ ಮನೆಯ ಆಸ್ತಿಯನ್ನೆಲ್ಲಾ ಸಹ ಅವನು ಕೊಡಬೇಕಾಗುವುದು.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ವ್ಯಭಿಚಾರಿಯು ಬುದ್ಧಿಹೀನನಾಗಿದ್ದಾನೆ.","poem":1},{"text":"ಹಾಗೆ ಮಾಡುವವನು ತನ್ನನ್ನೇ ನಾಶಮಾಡಿಕೊಳ್ಳುವನು.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ಅವನಿಗೆ ಗಾಯವೂ ಅವಮಾನವೂ ಆಗುತ್ತವೆ.","poem":1},{"text":"ಅವನ ನಿಂದೆಯು ಎಂದಿಗೂ ಅಳಿಸಲಾಗದು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"ಏಕೆಂದರೆ ಮತ್ಸರವು ಪತಿಯ ಕ್ರೋಧವನ್ನು ಉದ್ರೇಕಿಸುವುದು.","poem":1},{"text":"ಆದ್ದರಿಂದ ಮುಯ್ಯಿ ತೀರಿಸುವಾಗ ಅವನು ಕರುಣೆ ತೋರನು.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ಅವನು ಯಾವ ಪರಿಹಾರವನ್ನು ಒಪ್ಪುವುದಿಲ್ಲ;","poem":1},{"text":"ಎಷ್ಟು ದೊಡ್ಡ ಲಂಚ ಕೊಟ್ಟರೂ ಅವನು ಅದನ್ನು ತಿರಸ್ಕರಿಸುವನು.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kan_okcv/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}