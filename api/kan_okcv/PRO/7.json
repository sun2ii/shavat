{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"PRO","translationId":"kan_okcv","name":"ಜ್ಞಾನೋಕ್ತಿಗಳು","commonName":"ಜ್ಞಾನೋಕ್ತಿಗಳು","title":"ಜ್ಞಾನೋಕ್ತಿಗಳು","order":20,"numberOfChapters":31,"sha256":"db78a84ced0f5c6868005c76f5f2e0a81d61a265338d0405b06b96bd084f0f0e","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kan_okcv/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":7,"content":[{"type":"heading","content":["ವ್ಯಭಿಚಾರಿಣಿಯ ವಿರುದ್ಧ ಎಚ್ಚರಿಕೆ"]},{"type":"verse","number":1,"content":[{"text":"ಮಗನೇ, ನನ್ನ ಮಾತುಗಳನ್ನು ಅನುಸರಿಸಿ,","poem":1},{"text":"ನನ್ನ ಆಜ್ಞೆಗಳನ್ನು ನಿನ್ನಲ್ಲಿ ಇಟ್ಟುಕೋ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ನನ್ನ ಆಜ್ಞೆಗಳನ್ನು ಅನುಸರಿಸಿ ಬಾಳು;","poem":1},{"text":"ನಿನ್ನ ಕಣ್ಣುಗುಡ್ಡೆಯಂತೆ ನನ್ನ ಕಟ್ಟಳೆಗಳನ್ನು ಕಾಪಾಡು.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ಅವುಗಳನ್ನು ನಿನ್ನ ಬೆರಳುಗಳಿಗೆ ಉಂಗುರವಾಗಿಟ್ಟುಕೋ;","poem":1},{"text":"ನಿನ್ನ ಹೃದಯದ ಹಲಗೆಯಲ್ಲಿ ಅವುಗಳನ್ನು ಬರೆ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ಜ್ಞಾನಕ್ಕೆ, “ನೀನು ನನ್ನ ಸಹೋದರಿ,” ಎಂದೂ,","poem":1},{"text":"ಒಳನೋಟಕ್ಕೆ, “ನನ್ನ ಬಂಧು” ಎಂದೂ ಹೇಳು.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ಅವು ವ್ಯಭಿಚಾರಿಣಿಯಿಂದಲೂ","poem":1},{"text":"ಸವಿಮಾತನಾಡುವ ದಾರಿತಪ್ಪಿದ ಸ್ತ್ರೀಯಿಂದಲೂ ನಿನ್ನನ್ನು ಕಾಪಾಡುತ್ತವೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ನಾನು ನನ್ನ ಮನೆಯ ಕಿಟಿಕಿಯ","poem":1},{"text":"ಜಾಲರಿಯಿಂದ ಇಣಕಿ ನೋಡಿದಾಗ,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ಮುಗ್ಧರ ನಡುವೆ,","poem":1},{"text":"ಯುವಕರ ಮಧ್ಯದಲ್ಲಿ,","poem":2},{"lineBreak":true},{"text":"ತಿಳುವಳಿಕೆಯಿಲ್ಲದ ಯೌವನಸ್ಥನನ್ನು ಕಂಡೆನು.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ಅವನು ಅವಳ ಮೂಲೆ ಮನೆಯ ದಿಕ್ಕಿನಲ್ಲಿ","poem":1},{"text":"ಬೀದಿಯಿಂದ ಹಾದುಹೋಗುತ್ತಿದ್ದನು.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ಸಂಜೆಯ ಮಬ್ಬಿನಲ್ಲಿ","poem":1},{"text":"ರಾತ್ರಿಯ ಕತ್ತಲೆಯು ಕವಿಯುತ್ತಿತ್ತು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ಇಗೋ, ವೇಶ್ಯೆಯ ವಸ್ತ್ರವನ್ನು ಧರಿಸಿಕೊಂಡು","poem":1},{"text":"ಒಬ್ಬ ಕಪಟ ಸ್ತ್ರೀಯು ಅವನನ್ನು ಎದುರುಗೊಂಡಳು.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ಅವಳು ಕೂಗಾಟದವಳು, ಹಟಮಾರಿ;","poem":1},{"text":"ಅವಳ ಪಾದಗಳು ಮನೆಯಲ್ಲಿ ನಿಲ್ಲುವುದೇ ಇಲ್ಲ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ಒಮ್ಮೆ ಬೀದಿಯಲ್ಲಿ ಮತ್ತೊಮ್ಮೆ ಚೌಕಗಳಲ್ಲಿ ಹೀಗೆ","poem":1},{"text":"ಅವಳು ಮೂಲೆ ಮೂಲೆಗೂ ಹೊಂಚು ಹಾಕುತ್ತಾಳೆ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ಅವಳು ಆ ಯುವಕನನ್ನು ಹಿಡಿದುಕೊಂಡು ಮುದ್ದಿಟ್ಟು,","poem":1},{"text":"ನಾಚಿಕೆಯಿಲ್ಲದೆ ಅವಳು ಹೀಗೆನ್ನುತ್ತಾಳೆ:","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ಈ ದಿವಸ ನನ್ನ ಹರಕೆಗಳನ್ನು ನಾನು ಸಲ್ಲಿಸಿದ್ದೇನೆ.","poem":1},{"text":"ನಾನು ನನ್ನ ಸಮಾಧಾನದ ಯಜ್ಞವನ್ನು ಅರ್ಪಿಸಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ಆದಕಾರಣ ನಾನು ನಿನ್ನನ್ನು ಎದುರುಗೊಳ್ಳುವುದಕ್ಕೆ ಬಂದೆನು;","poem":1},{"text":"ಅತ್ಯಾಶೆಯಿಂದ ನಿನ್ನನ್ನು ಹುಡುಕಿ ಕಂಡುಕೊಂಡಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ಈಜಿಪ್ಟಿನ ನಯವಾದ ನಾರು ಮಡಿಯಿಂದಲೂ","poem":1},{"text":"ನನ್ನ ಹಾಸಿಗೆಯನ್ನು ಅಲಂಕರಿಸಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ರಕ್ತಬೋಳ, ಅಗರು, ಲವಂಗ, ಚಕ್ಕೆಗಳಿಂದ","poem":1},{"text":"ನನ್ನ ಹಾಸಿಗೆಯನ್ನು ಸುವಾಸನೆಗೊಳಿಸಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ಬಾ, ಬೆಳಗಿನವರೆಗೂ ತೃಪ್ತಿಯಾಗುವ ತನಕ","poem":1},{"text":"ಪ್ರೀತಿಯ ವಶದಲ್ಲಿ ತುಂಬಿಕೊಂಡು ಕಾಮ ವಿಲಾಸಗಳಿಂದ ನಾವು ಸಂತೋಷಿಸೋಣ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ಏಕೆಂದರೆ ಯಜಮಾನನು ಮನೆಯಲ್ಲಿ ಇಲ್ಲ;","poem":1},{"text":"ಅವನು ದೀರ್ಘ ಪ್ರಯಾಣದಲ್ಲಿದ್ದಾನೆ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ಅವನು ತನ್ನೊಂದಿಗೆ ಹಣದ ಗಂಟನ್ನು ತೆಗೆದುಕೊಂಡು ಹೋಗಿದ್ದಾನೆ;","poem":1},{"text":"ಹುಣ್ಣಿಮೆಗೆ ಮುಂಚೆ ಅವನು ಮನೆಗೆ ಬರುವುದಿಲ್ಲ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ಮನವೊಲಿಸುವ ಮಾತುಗಳಿಂದ ಅವಳು ಅವನನ್ನು ದಾರಿ ತಪ್ಪಿಸಿ,","poem":1},{"text":"ಅವಳು ತನ್ನ ಮೋಹಕ ಮಾತುಗಳಿಂದ ಅವನನ್ನು ಆಕರ್ಷಿಸುತ್ತಾಳೆ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ಎತ್ತು ವಧೆಯ ಸ್ಥಾನಕ್ಕೆ ಹೋಗುವಂತೆ,","poem":1},{"text":"ಅಥವಾ ಜಿಂಕೆಯು","poem":2},{"noteId":1},{"text":"ಬಲೆಗೆ ಸಿಕ್ಕಿಬೀಳುವಂತೆ,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ಅವನು ತನ್ನ ಪ್ರಾಣವು ಅಪಾಯದಲ್ಲಿರುವುದನ್ನು ತಿಳಿಯದೆ,","poem":1},{"lineBreak":true},{"text":"ಒಂದು ಬಾಣವು ತನ್ನ ಕಾಳಿಜವನ್ನು ತಿವಿಯುವವರೆಗೆ,","poem":1},{"text":"ಪಕ್ಷಿಯು ಬಲೆಯ ಕಡೆಗೆ ಓಡುವ ಹಾಗೆ ಅವನು ತಟ್ಟನೆ ಅವಳ ಹಿಂದೆ ಹೋಗುತ್ತಾನೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ಆದ್ದರಿಂದ ನನ್ನ ಮಕ್ಕಳೇ, ನನಗೆ ಕಿವಿಗೊಡಿರಿ,","poem":1},{"text":"ನನ್ನ ಮಾತುಗಳನ್ನು ಆಲಿಸಿರಿ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ಅವಳ ಮಾರ್ಗಗಳಿಗೆ ನಿಮ್ಮ ಹೃದಯವು ತಿರುಗದೆ ಇರಲಿ;","poem":1},{"text":"ತಪ್ಪಿಯೂ ಅವಳ ದಾರಿಯಲ್ಲಿ ಹೋಗಬೇಡಿರಿ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ಏಕೆಂದರೆ ಅನೇಕರು ಅವಳಿಗೆ ಬಲಿಯಾಗಿ ಬಿದ್ದಿದ್ದಾರೆ.","poem":1},{"text":"ಬಲಿಷ್ಠರಾದ ಅನೇಕ ಪುರುಷರು ಅವಳಿಂದ ಹತರಾಗಿದ್ದಾರೆ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ಅವಳ ಮನೆಯು ಪಾತಾಳಕ್ಕೆ ಹೆದ್ದಾರಿ,","poem":1},{"text":"ಅದು ಮೃತ್ಯುವಿನ ಕೊಠಡಿಗೆ ಇಳಿದು ಹೋಗುತ್ತದೆ.","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"ಜಿಂಕೆಯು ಹಿಬ್ರೂವಿನಲ್ಲಿ ಮಾಡಿದ ಭಾಷಾಂತರ ಮೂರ್ಖನು","reference":{"chapter":7,"verse":22}}]},"thisChapterLink":"/api/kan_okcv/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}