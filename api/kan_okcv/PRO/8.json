{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"PRO","translationId":"kan_okcv","name":"ಜ್ಞಾನೋಕ್ತಿಗಳು","commonName":"ಜ್ಞಾನೋಕ್ತಿಗಳು","title":"ಜ್ಞಾನೋಕ್ತಿಗಳು","order":20,"numberOfChapters":31,"sha256":"db78a84ced0f5c6868005c76f5f2e0a81d61a265338d0405b06b96bd084f0f0e","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kan_okcv/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":8,"content":[{"type":"heading","content":["ಜ್ಞಾನದ ಕರೆ"]},{"type":"verse","number":1,"content":[{"text":"ಜ್ಞಾನವು ಕರೆಯುತ್ತದಲ್ಲವೋ?","poem":1},{"text":"ತಿಳುವಳಿಕೆ ಎಂಬಾಕೆಯು ತನ್ನ ಸ್ವರವನ್ನು ಎತ್ತಿ ಕೂಗಿ ಕರೆಯುವುದಿಲ್ಲವೋ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ಉನ್ನತ ಸ್ಥಳಗಳ ತುದಿಯಲ್ಲಿಯೂ,","poem":1},{"text":"ಹಾದಿಗಳ ಸಂಧಿಗಳಲ್ಲಿಯೂ ನಿಂತುಕೊಳ್ಳುತ್ತಾಳೆ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ಪಟ್ಟಣದ ಪ್ರವೇಶ ದ್ವಾರಗಳಲ್ಲಿಯೂ","poem":1},{"text":"ಒಳಗೆ ಬರುವಾಗ ಅವಳು ಸ್ವರವೆತ್ತಿ ಹೇಳುವುದೇನೆಂದರೆ,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“ಮನುಷ್ಯರೇ, ನಾನು ಕರೆಯುತ್ತಿರುವುದು ನಿಮ್ಮನ್ನೇ,","poem":1},{"text":"ಮಾನವರಿಗಾಗಿಯೇ ನಾನು ಧ್ವನಿಗೈಯುತ್ತೇನೆ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ಮುಗ್ಧರೇ, ಜ್ಞಾನವನ್ನು ಗ್ರಹಿಸಿರಿ.","poem":1},{"text":"ಬುದ್ಧಿಹೀನರೇ, ನೀವು ತಿಳುವಳಿಕೆಯ ಹೃದಯದವರಾಗಿರಿ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ಕೇಳಿರಿ, ಉತ್ಕೃಷ್ಟ ಸಂಗತಿಗಳನ್ನು ನಾನು ಮಾತಾಡುವೆನು;","poem":1},{"text":"ನ್ಯಾಯವಾದ ಸಂಗತಿಗಳಿಗಾಗಿ ನನ್ನ ತುಟಿಗಳನ್ನು ತೆರೆಯುವೆನು.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ನನ್ನ ಬಾಯಿಯು ಸತ್ಯವನ್ನು ಮಾತಾಡುವುದು;","poem":1},{"text":"ನನ್ನ ತುಟಿಗಳಿಗೆ ಕೆಟ್ಟತನವು ಅಸಹ್ಯವಾಗಿದೆ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ನನ್ನ ಬಾಯಿಯ ಮಾತುಗಳೆಲ್ಲಾ ನೀತಿಯುಕ್ತವಾಗಿವೆ;","poem":1},{"text":"ಮೂರ್ಖತನವಾಗಲಿ, ವಕ್ರತೆಯಾಗಲಿ ಅವುಗಳಲ್ಲಿ ಇಲ್ಲ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ವಿವೇಚಿಸುವವನಿಗೆ ನನ್ನ ಎಲ್ಲ ಮಾತುಗಳು ನೇರವಾಗಿರುವುದು.","poem":1},{"text":"ತಿಳುವಳಿಕೆ ಉಳ್ಳವನಿಗೆ ಅವು ಪ್ರಾಮಾಣಿಕವಾಗಿಯೂ ಇರುವುದು.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ಬೆಳ್ಳಿಗಿಂತ ನನ್ನ ಬೋಧನೆಯನ್ನು ಆರಿಸಿಕೋ","poem":1},{"text":"ಉತ್ತಮ ಬಂಗಾರಕ್ಕಿಂತ ಮಿಗಿಲಾದ ತಿಳುವಳಿಕೆಯನ್ನು ಪಡೆದುಕೋ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ಏಕೆಂದರೆ ಮಾಣಿಕ್ಯಗಳಿಗಿಂತ ಜ್ಞಾನವು ಅಮೂಲ್ಯವಾದದ್ದು.","poem":1},{"text":"ಅಪೇಕ್ಷಿಸತಕ್ಕ ಯಾವ ವಸ್ತುಗಳನ್ನು ಅದಕ್ಕೆ ಹೋಲಿಸಲಾಗದು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“ಜ್ಞಾನವೆಂಬ ನಾನು ವಿವೇಕದೊಂದಿಗೆ ವಾಸವಾಗಿದ್ದೇನೆ.","poem":1},{"text":"ತಿಳುವಳಿಕೆಯನ್ನೂ ವಿವೇಚನೆಯನ್ನೂ ನಾನು ಹೊಂದಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ಕೆಟ್ಟದ್ದನ್ನು ಹಗೆ ಮಾಡುವುದೇ ಯೆಹೋವ ದೇವರ ಭಯವಾಗಿದೆ;","poem":1},{"text":"ಗರ್ವ, ಅಹಂಕಾರ, ಕೆಟ್ಟನಡವಳಿಕೆ,","poem":2},{"lineBreak":true},{"text":"ವಕ್ರ ಭಾಷಣಗಳನ್ನು ನಾನು ಹಗೆಮಾಡುತ್ತೇನೆ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ಸಮಾಲೋಚನೆಯೂ ಒಳ್ಳೆಯ ನ್ಯಾಯವೂ ನನ್ನಲ್ಲಿದೆ.","poem":1},{"text":"ನನ್ನಲ್ಲಿ ಒಳನೋಟವೂ ಶಕ್ತಿಯೂ ಇವೆ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ನನ್ನ ಮೂಲಕ ರಾಜರು ಆಳುವರು;","poem":1},{"text":"ಪ್ರಧಾನರು ನ್ಯಾಯವಾದ ತೀರ್ಪು ಕೊಡುವರು.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ನನ್ನಿಂದ ಅಧಿಪತಿಗಳು ಆಳುತ್ತಾರೆ,","poem":1},{"text":"ಕೀರ್ತಿವಂತರೆಲ್ಲರೂ ಭೂಮಿಯ ಮೇಲೆ ಆಳುವರು.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ನನ್ನನ್ನು ಪ್ರೀತಿಸುವವರನ್ನು ನಾನು ಪ್ರೀತಿಸುತ್ತೇನೆ;","poem":1},{"text":"ಹಂಬಲಿಸಿ ನನ್ನನ್ನು ಹುಡುಕುವವರು ನನ್ನನ್ನು ಕಂಡುಕೊಳ್ಳುವರು.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ಐಶ್ವರ್ಯವೂ ಘನತೆಯೂ,","poem":1},{"text":"ಶಾಶ್ವತ ಸಂಪತ್ತು ಹಾಗೂ ಸಮೃದ್ಧಿಯು ನನ್ನೊಂದಿಗಿವೆ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ನನ್ನ ಫಲವು ಬಂಗಾರಕ್ಕಿಂತಲೂ,","poem":1},{"text":"ನನ್ನ ಆದಾಯವು ಉತ್ತಮವಾದ ಬೆಳ್ಳಿಗಿಂತಲೂ ಶ್ರೇಷ್ಠವಾಗಿವೆ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ನೀತಿಯ ಮಾರ್ಗದಲ್ಲಿಯೂ","poem":1},{"text":"ನ್ಯಾಯದ ದಾರಿ ನಡುವೆಯೂ ನಾನು ನಡೆಯುತ್ತೇನೆ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ನನ್ನನ್ನು ಪ್ರೀತಿಸುವವರು ಸಂಪತ್ತನ್ನು ಬಾಧ್ಯವಾಗಿ ಹೊಂದುವರು.","poem":1},{"text":"ನಾನು ಅವರ ಬೊಕ್ಕಸಗಳನ್ನು ತುಂಬಿಸುವೆನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಸೃಷ್ಟಿಕ್ರಮದಲ್ಲಿ ನನ್ನನ್ನು ಮೊದಲು ನಿರ್ಮಿಸಿದರು,","poem":1},{"text":"ದೇವರ ಪುರಾತನ ಕಾರ್ಯಗಳಲ್ಲಿ ನಾನೇ ಮೊದಲು;","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ಪ್ರಾರಂಭದಲ್ಲಿ ಜಗದುತ್ಪತ್ತಿಗೆ ಮುಂಚೆಯೇ","poem":1},{"text":"ಅನಾದಿಕಾಲದಲ್ಲಿ ದೇವರು ನನ್ನನ್ನು ಸೃಷ್ಟಿಸಿದರು.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ಆಗಾಧಗಳು ಇಲ್ಲದೆ ಇರುವಾಗ ನಾನು ಹುಟ್ಟಿ ಬಂದೆನು,","poem":1},{"text":"ನೀರಿನ ಬುಗ್ಗೆಗಳು ಇಲ್ಲದೆ ಇರುವಾಗಲೇ ನಾನಿದ್ದೆನು.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ಪರ್ವತಗಳು ಸ್ಥಾಪಿತವಾಗುವುದಕ್ಕಿಂತ ಮುಂಚೆಯೂ","poem":1},{"text":"ಬೆಟ್ಟಗುಡ್ಡಗಳಿಗಿಂತ ಮೊದಲು ನಾನು ಜನಿಸಿದೆನು.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ಭೂಮಿಯನ್ನೂ ಹೊಲಗಳನ್ನೂ ಲೋಕದ ಅಣುಗಳನ್ನೂ","poem":1},{"text":"ಅವರು ನಿರ್ಮಿಸದೆ ಇರುವಾಗಲೇ ನಾನು ಜನಿಸಿದೆನು.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ಅವರು ಆಕಾಶಗಳನ್ನು ಸಿದ್ಧಪಡಿಸಿದಾಗ","poem":1},{"text":"ಸಾಗರದ ಮೇಲೆ ಚಕ್ರವನ್ನು ಹಾಕಿದಾಗ,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ಮೇಲೆ ಮೇಘಗಳನ್ನು ಅವರು ಸ್ಥಾಪಿಸಿದಾಗ","poem":1},{"text":"ಅಗಾಧದ ಬುಗ್ಗೆಗಳನ್ನು ಅವರು ಬಲಪಡಿಸಿದಾಗ,","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ಪ್ರವಾಹಗಳು ತನ್ನ ಆಜ್ಞೆಯನ್ನು ಮೀರದಂತೆ ಸಮುದ್ರಕ್ಕೆ","poem":1},{"text":"ಅವರು ಮೇರೆಯನ್ನು ಮಾಡಿ","poem":2},{"text":"ಭೂಮಿಯ ಅಸ್ತಿವಾರಗಳನ್ನು ನೇಮಿಸಿದಾಗ, ನಾನು ಅಲ್ಲಿ ಇದ್ದೆನು.","poem":1}]},{"type":"verse","number":30,"content":[{"text":"ಆಗ ನಾನು ಅವರೊಂದಿಗೆ ಕುಶಲ ಶಿಲ್ಪಿಯಂತೆ","poem":2},{"text":"ಅವರ ಹತ್ತಿರ ಇದ್ದೆನು.","poem":1},{"text":"ಅವರ ಸನ್ನಿಧಿಯಲ್ಲಿ ಯಾವಾಗಲೂ ಆನಂದಿಸುತ್ತಾ ಅನುದಿನವೂ ಸಂತೋಷಿಸುತ್ತಿದ್ದೆನು.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ಅವರ ಭೂಮಿಯ ವಾಸಸ್ಥಳದ ಭಾಗದಲ್ಲಿ ಸಂತೋಷಿಸುತ್ತಿದ್ದೆನು;","poem":1},{"text":"ಮಾನವರೊಂದಿಗೆ ಆನಂದಿಸುತ್ತಿದ್ದೆನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"“ಆದ್ದರಿಂದ ಮಕ್ಕಳೇ, ಈಗ ನನ್ನ ಕಡೆಗೆ ಕಿವಿಗೊಡಿರಿ;","poem":1},{"text":"ನನ್ನ ಮಾರ್ಗಗಳನ್ನು ಅನುಸರಿಸುವವರು ಧನ್ಯರು.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ನನ್ನ ಬೋಧನೆಯನ್ನು ಕೇಳಿ ಬುದ್ಧಿವಂತರಾಗಿರಿ;","poem":1},{"text":"ಅದನ್ನು ನೀವು ತಿರಸ್ಕರಿಸಬೇಡಿರಿ.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ನನ್ನ ದ್ವಾರಗಳ ಬಳಿಯಲ್ಲಿ ಪ್ರತಿದಿನ ಕಾಯುತ್ತಾ,","poem":1},{"text":"ನನ್ನ ಬಾಗಿಲುಗಳ ನಿಲುವುಗಳಲ್ಲಿ ನಿರೀಕ್ಷಿಸುತ್ತಾ,","poem":2},{"lineBreak":true},{"text":"ನನ್ನ ಮಾತುಗಳನ್ನು ಕೇಳುವವರು ಧನ್ಯರು.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ಏಕೆಂದರೆ ನನ್ನನ್ನು ಕಂಡುಕೊಳ್ಳುವವನು ಜೀವವನ್ನು ಕಂಡುಕೊಂಡು","poem":1},{"text":"ಯೆಹೋವ ದೇವರ ಕೃಪೆಯನ್ನು ಹೊಂದುವನು.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ಆದರೆ ನನ್ನನ್ನು ಬಿಟ್ಟು ದೂರಹೋಗುವವನು","poem":1},{"text":"ತನ್ನ ಸ್ವಂತ ಪ್ರಾಣಕ್ಕೆ ಕೇಡುಮಾಡಿಕೊಳ್ಳುತ್ತಾನೆ,","poem":2},{"lineBreak":true},{"text":"ನನ್ನನ್ನು ಹಗೆಮಾಡುವವರೆಲ್ಲರೂ ಮರಣವನ್ನು ಪ್ರೀತಿಸುತ್ತಾರೆ.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kan_okcv/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}