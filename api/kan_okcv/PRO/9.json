{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"PRO","translationId":"kan_okcv","name":"ಜ್ಞಾನೋಕ್ತಿಗಳು","commonName":"ಜ್ಞಾನೋಕ್ತಿಗಳು","title":"ಜ್ಞಾನೋಕ್ತಿಗಳು","order":20,"numberOfChapters":31,"sha256":"db78a84ced0f5c6868005c76f5f2e0a81d61a265338d0405b06b96bd084f0f0e","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kan_okcv/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":9,"content":[{"type":"heading","content":["ಜ್ಞಾನದ ಹಾಗೂ ಮೂರ್ಖತನದ ಕರೆ"]},{"type":"verse","number":1,"content":[{"text":"ಜ್ಞಾನ ಎಂಬಾಕೆಯು ತನ್ನ ಮನೆಯನ್ನು ಕಟ್ಟಿಕೊಂಡಿದ್ದಾಳೆ;","poem":1},{"text":"ಆಕೆಯು ತನ್ನ ಏಳು ಕಂಬಗಳನ್ನು ಕೆತ್ತಿಸಿದ್ದಾಳೆ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ಆಕೆಯು ಮಾಂಸದ ಆಹಾರನ್ನು ತಯಾರಿಸಿ, ತನ್ನ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಬೆರೆಸಿ,","poem":1},{"text":"ತನ್ನ ಮೇಜನ್ನು ಸಹ ಸಿದ್ಧಪಡಿಸಿದಳು.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ಆಕೆಯು ತನ್ನ ದಾಸಿಯರನ್ನು ಕಳುಹಿಸುತ್ತಾಳೆ;","poem":1},{"text":"ಆಕೆಯು ಪಟ್ಟಣದ ಅತಿ ಉನ್ನತ ಸ್ಥಳದಿಂದ ಕೂಗುತ್ತಾಳೆ,","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"“ಯಾರು ಮುಗ್ಧರೋ ಅವರು ನನ್ನ ಮನೆಗೆ ಬರಲಿ,”","poem":2},{"text":"ಬುದ್ಧಿ ಇಲ್ಲದೆ ಇರುವವನಿಗೆ ಆಕೆಯು ಹೇಳುತ್ತಾಳೆ,","poem":1}]},{"type":"verse","number":5,"content":[{"text":"“ಬಾ, ನನ್ನ ಆಹಾರವನ್ನು ತಿಂದು,","poem":2},{"lineBreak":true},{"text":"ನಾನು ಬೆರೆಸಿದ ದ್ರಾಕ್ಷಾರಸವನ್ನು ಕುಡಿ,” ಎಂದೂ","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“ನಿಮ್ಮ ಮೂಢತ್ವವನ್ನು ಬಿಟ್ಟು ಬಾಳಿರಿ","poem":1},{"text":"ಮತ್ತು ವಿವೇಕದ ಮಾರ್ಗದಲ್ಲಿ ಹೋಗು,” ಎಂದೂ ಕೂಗುತ್ತಾಳೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ಪರಿಹಾಸ್ಯ ಮಾಡುವವನನ್ನು ಗದರಿಸುವವನು ತನ್ನನ್ನು ತಾನೇ ಅವಮಾನಕ್ಕೆ ಗುರಿಮಾಡಿಕೊಳ್ಳುವನು;","poem":1},{"text":"ದುಷ್ಟನನ್ನು ಗದರಿಸುವವನು ತನಗೆ ತಾನೇ ಕಳಂಕವನ್ನು ತಂದುಕೊಳ್ಳುವನು.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ಪರಿಹಾಸ್ಯ ಮಾಡುವವನನ್ನು ಗದರಿಸಬೇಡ ಅವನು ನಿನ್ನನ್ನು ಹಗೆ ಮಾಡುವನು;","poem":1},{"text":"ಜ್ಞಾನಿಯನ್ನು ಗದರಿಸಿದರೆ ಅವನು ನಿನ್ನನ್ನು ಪ್ರೀತಿ ಮಾಡುವನು.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ಜ್ಞಾನಿಗೆ ಶಿಕ್ಷಣ ನೀಡಿದರೆ ಅವನು ಇನ್ನೂ ಹೆಚ್ಚಾಗಿ ಜ್ಞಾನವಂತನಾಗಿರುವನು;","poem":1},{"text":"ನೀತಿವಂತನಿಗೆ ಬೋಧಿಸಿದರೆ ಅವನು ಜ್ಞಾನವನ್ನು ಹೆಚ್ಚಿಸಿಕೊಳ್ಳುವನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ಯೆಹೋವ ದೇವರ ಭಯವೇ ಜ್ಞಾನಕ್ಕೆ ಮೂಲವು.","poem":1},{"text":"ಪರಿಶುದ್ಧರ ಪರಿಜ್ಞಾನವೇ ತಿಳುವಳಿಕೆಯಾಗಿದೆ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ಏಕೆಂದರೆ ಜ್ಞಾನದ ಮೂಲಕ ನಿನ್ನ ಜೀವನದ ದಿನಗಳು ಹೆಚ್ಚುವುವು;","poem":1},{"text":"ನಿನ್ನ ಜೀವನದ ವರ್ಷಗಳು ವೃದ್ಧಿಯಾಗುವುವು.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ನೀನು ಜ್ಞಾನಿಯಾದರೆ, ನಿನ್ನ ಜ್ಞಾನವು ನಿನಗೆ ಪ್ರತಿಫಲ ಕೊಡುವುದು;","poem":1},{"text":"ನೀನು ನಿಂದಿಸುವವನಾದರೆ, ನೀನೇ ಅದರ ಫಲವನ್ನು ಅನುಭವಿಸುವಿ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ಬುದ್ಧಿಹೀನಳಾದ ಸ್ತ್ರೀಯು ಕೂಗಾಟದವಳು;","poem":1},{"text":"ಅವಳು ಅರಿವಿಲ್ಲದವಳು, ಏನೂ ತಿಳಿಯದವಳು.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ಅವಳು ತನ್ನ ಮನೆಯ ಬಾಗಿಲಿನಲ್ಲಿ ಕುಳಿತು,","poem":1},{"text":"ಪಟ್ಟಣದ ಎತ್ತರವಾದ ಸ್ಥಳಗಳ ಪೀಠದ ಮೇಲೆ ನಿಂತು,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ತಮ್ಮ ಮಾರ್ಗವನ್ನು ಹಿಡಿದು ಹೋಗುವ","poem":1},{"text":"ಪ್ರಯಾಣಿಕರನ್ನು ಕರೆಯುತ್ತಾಳೆ,","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"“ಯಾರು ಮುಗ್ಧರೋ ಅವರು ನನ್ನ ಮನೆಗೆ ಬರಲಿ,”","poem":2},{"text":"ಬುದ್ಧಿ ಇಲ್ಲದೆ ಇರುವವನಿಗೆ ಆಕೆಯು ಹೇಳುತ್ತಾಳೆ,","poem":1}]},{"type":"verse","number":17,"content":[{"text":"“ಕದ್ದ ನೀರು ಸಿಹಿಯಾಗಿದೆ;","poem":2},{"lineBreak":true},{"text":"ರಹಸ್ಯದಲ್ಲಿ ತಿನ್ನುವ ಆಹಾರವು ರುಚಿಯಾಗಿದೆ,” ಎಂದು ಹೇಳುತ್ತಾಳೆ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ಆದರೆ ಆ ಮನೆ ಸತ್ತವರ ಸ್ಥಾನವಾಗಿದೆ.","poem":1},{"text":"ಅವಳ ಅತಿಥಿಗಳು ಪಾತಾಳದ ಅಗಾಧದಲ್ಲಿ ಬಿದ್ದಿದ್ದಾರೆಂದು ಅವನಿಗೆ ತಿಳಿಯದು.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kan_okcv/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}