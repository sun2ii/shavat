{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"PSA","translationId":"kan_okcv","name":"ಕೀರ್ತನೆಗಳು","commonName":"ಕೀರ್ತನೆಗಳು","title":"ಕೀರ್ತನೆಗಳು","order":19,"numberOfChapters":150,"sha256":"8fda6557d2590d4e512d2801111ece4ef0438ce426c3b9b41fc862a02e5e2271","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kan_okcv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":106,"content":[{"type":"verse","number":1,"content":[{"text":"ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.","poem":1},{"lineBreak":true},{"text":"ಯೆಹೋವ ದೇವರಿಗೆ ಉಪಕಾರಸ್ತುತಿ ಮಾಡಿರಿ; ಅವರು ಒಳ್ಳೆಯವರು.","poem":1},{"text":"ಅವರ ಪ್ರೀತಿ ಶಾಶ್ವತವಾಗಿರುವುದು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ಯೆಹೋವ ದೇವರ ಪರಾಕ್ರಮ ಕ್ರಿಯೆಗಳನ್ನು ಪ್ರಕಟಿಸಿರಿ,","poem":1},{"text":"ದೇವರನ್ನು ತಕ್ಕಂತೆ ಸ್ತುತಿಸುವವರು ಯಾರಿಗೆ ಸಾಧ್ಯ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ನ್ಯಾಯವನ್ನು ಕಾಪಾಡಿಕೊಂಡು ಯಾವಾಗಲೂ","poem":1},{"text":"ಸರಿಯಾದವುಗಳನ್ನು ಪಾಲಿಸುವವರು ಧನ್ಯರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ದೇವರೇ, ನಿಮ್ಮ ಜನರ ಮೇಲಿರುವ ಮೆಚ್ಚುಗೆಯಿಂದ ನನ್ನನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ,","poem":1},{"text":"ನಿಮ್ಮ ರಕ್ಷಣೆಯಿಂದ ನನ್ನನ್ನು ದರ್ಶಿಸಿರಿ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ಯೆಹೋವ ದೇವರೇ, ನಾನು ನೀವು ಆಯ್ದುಕೊಂಡವರ ಸುಖವನ್ನು ಕಂಡು,","poem":1},{"text":"ನಿಮ್ಮ ಜನರ ಸಂತೋಷದೊಂದಿಗೆ ಸಂತೋಷಿಸಿ,","poem":2},{"lineBreak":true},{"text":"ನಿಮ್ಮ ಸ್ವಕೀಯರ ಸಂಗಡ ಹೊಗಳಿಕೊಳ್ಳುವೆನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ನಮ್ಮ ಪಿತೃಗಳಂತೆ ನಾವು ಕೂಡಾ ಪಾಪಮಾಡಿದ್ದೇವೆ;","poem":1},{"text":"ಅಕ್ರಮ ಮಾಡಿದ್ದೇವೆ; ದುಷ್ಟಕೃತ್ಯಗಳನ್ನು ನಡೆಸಿದ್ದೇವೆ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ನಮ್ಮ ಪಿತೃಗಳು ಈಜಿಪ್ಟಿನಲ್ಲಿ","poem":1},{"text":"ನಿಮ್ಮ ಅದ್ಭುತಗಳಿಗೆ ಲಕ್ಷಕೊಡದೆ,","poem":2},{"text":"ನಿಮ್ಮ ಕರುಣಾತಿಶಯವನ್ನು ನೆನಸದೆ,","poem":1},{"text":"ಸಮುದ್ರದ ಬಳಿಯಲ್ಲಿ ಅಂದರೆ ಕೆಂಪುಸಮುದ್ರದ ಹತ್ತಿರ ತಿರುಗಿಬಿದ್ದರು.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ಆದರೂ ದೇವರು ತಮ್ಮ ಮಹಾಶಕ್ತಿಯನ್ನು ಅವರಿಗೆ ತಿಳಿಯಮಾಡುವ ಹಾಗೆ,","poem":1},{"text":"ತಮ್ಮ ಹೆಸರಿನ ನಿಮಿತ್ತ ಅವರನ್ನು ರಕ್ಷಿಸಿದರು.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ದೇವರು ಕೆಂಪು ಸಮುದ್ರವನ್ನು ಗದರಿಸಲು, ಅದು ಒಣಗಿ ಹೋಯಿತು;","poem":1},{"text":"ಹೀಗೆ ಮರುಭೂಮಿಯಲ್ಲಿ ನಡೆದು ಹೋದಂತೆ ಜಲಾಗಾಧದಲ್ಲಿ ಇಸ್ರಾಯೇಲರನ್ನು ನಡೆಸಿದರು.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ವೈರಿಯ ಕೈಯೊಳಗಿಂದ ಅವರನ್ನು ರಕ್ಷಿಸಿದರು,","poem":1},{"text":"ಶತ್ರುವಿನ ಕೈಯಿಂದ ಅವರನ್ನು ಬಿಡುಗಡೆ ಮಾಡಿದರು.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ಪ್ರವಾಹಗಳು ಅವರ ವೈರಿಗಳನ್ನು ಮುಚ್ಚಿಬಿಟ್ಟವು,","poem":1},{"text":"ವೈರಿಗಳಲ್ಲಿ ಒಬ್ಬನೂ ಉಳಿಯಲಿಲ್ಲ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ಆಗ ಅವರು ದೇವರ ಮಾತುಗಳನ್ನು ನಂಬಿ,","poem":1},{"text":"ದೇವರಿಗೆ ಸ್ತೋತ್ರವನ್ನು ಹಾಡಿದರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ಆದರೆ ಬೇಗನೇ ದೇವರು ಮಾಡಿದ ಕೆಲಸಗಳನ್ನು ಮರೆತುಬಿಟ್ಟು,","poem":1},{"text":"ದೇವರ ಸಂಕಲ್ಪಕ್ಕೆ ಅವರು ಕಾದುಕೊಳ್ಳದೆ ಹೋದರು.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ಮರುಭೂಮಿಯಲ್ಲಿ ದುರಾಶೆಯಿಂದ ಆಶಿಸಿ,","poem":1},{"text":"ಹಾಳು ಪ್ರದೇಶದಲ್ಲಿ ದೇವರನ್ನು ಪರೀಕ್ಷಿಸಿದರು.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ಆಗ ದೇವರು ಅವರ ಬೇಡಿಕೆಯಂತೆಯೇ ಅವರಿಗೆ ಕೊಟ್ಟುಬಿಟ್ಟರು;","poem":1},{"text":"ಆದರೆ ಅವರ ದೇಹಕ್ಕೆ ಭೀಕರ ರೋಗವನ್ನು ಸಹ ಅನುಮತಿಸಿದರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ಇಸ್ರಾಯೇಲರು ಪಾಳೆಯದಲ್ಲಿ ಮೋಶೆಯ ಮೇಲೆಯೂ,","poem":1},{"text":"ಯೆಹೋವ ದೇವರಿಗೆ ಪ್ರತಿಷ್ಠಿತನಾದ ಆರೋನನ ಮೇಲೆಯೂ ಹೊಟ್ಟೆಕಿಚ್ಚುಪಟ್ಟರು.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ಆಗ ಭೂಮಿಯು ಬಾಯಿತೆರೆದು ದಾತಾನನನ್ನು ನುಂಗಿ,","poem":1},{"text":"ಅಬೀರಾಮನ ಗುಂಪನ್ನು ಮುಚ್ಚಿಬಿಟ್ಟಿತು.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ಬೆಂಕಿಯು ಅವರ ಗುಂಪಿನಲ್ಲಿ ಉರಿದು,","poem":1},{"text":"ಜ್ವಾಲೆಯು ದುಷ್ಟರನ್ನು ಸುಟ್ಟಿತು.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ಅವರು ಹೋರೇಬಿನಲ್ಲಿ ಎರಕದ ಕರುವನ್ನು ಮಾಡಿ,","poem":1},{"text":"ಆ ವಿಗ್ರಹಕ್ಕೆ ಅಡ್ಡಬಿದ್ದರು.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ಹೀಗೆ ಅವರು ತಮ್ಮ ಮಹಿಮೆಯುಳ್ಳ ದೇವರನ್ನು","poem":1},{"text":"ಹುಲ್ಲು ತಿನ್ನುವ ಎತ್ತಿನ ರೂಪಕ್ಕೆ ಬದಲಾಯಿಸಿದರು.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ಅವರು ತಮ್ಮನ್ನು ರಕ್ಷಿಸಿದ ದೇವರನ್ನು ಬೇಗ ಮರೆತುಬಿಟ್ಟರು.","poem":1},{"text":"ಹೌದು, ಈಜಿಪ್ಟ್ ದೇಶದಲ್ಲಿ ಮಹತ್ಕಾರ್ಯಗಳನ್ನೂ,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ಹಾಮ ದೇಶದಲ್ಲಿ ಅದ್ಭುತಗಳನ್ನೂ,","poem":1},{"text":"ಕೆಂಪುಸಮುದ್ರದ ಬಳಿಯಲ್ಲಿ ಅತಿಶಯವಾದವುಗಳನ್ನೂ ಮಾಡಿದ ದೇವರನ್ನು ಮರೆತುಬಿಟ್ಟರು.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ಆದ್ದರಿಂದ ದೇವರು ಅವರಿಗೆ ಪೂರ್ಣದಂಡನೆ ಕೊಡುವುದಾಗಿ ಹೇಳಿದರು.","poem":1},{"text":"ಆದರೆ ಅವರು ಆಯ್ದುಕೊಂಡ ಮೋಶೆಯು,","poem":2},{"text":"ದೇವರ ಕಠಿಣ ತೀರ್ಮಾನವನ್ನು ಶಾಂತಪಡಿಸಲು ಆಪತ್ತಿನಲ್ಲಿ","poem":1},{"text":"ದೇವರ ಮುಂದೆ ಮಧ್ಯಸ್ಥನಾಗಿ ನಿಂತುಕೊಂಡನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ಹೌದು, ಇಸ್ರಾಯೇಲರು ಮನೋಹರವಾದ ದೇಶವನ್ನು ಹೀನೈಸಿ,","poem":1},{"text":"ದೇವರ ಮಾತನ್ನು ನಂಬದೆ ಹೋದರು.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ತಮ್ಮ ಗುಡಾರಗಳಲ್ಲಿ ಗೊಣಗುಟ್ಟಿ","poem":1},{"text":"ಯೆಹೋವ ದೇವರ ಮಾತನ್ನು ಹೇಳದೆ ಹೋದರು.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ಆದ್ದರಿಂದ ದೇವರು ಅವರನ್ನು ಮರುಭೂಮಿಯಲ್ಲಿ ಬೀಳುವಂತೆಯೂ,","poem":1},{"lineBreak":true},{"text":"ಅವರ ಸಂತತಿಯರು ದೇಶಗಳಲ್ಲಿ ಚದರಿಸುವಂತೆಯೂ","poem":1}]},{"type":"verse","number":27,"content":[{"text":"ತಮ್ಮ ಕೈಯನ್ನು ಎತ್ತಿ ಅವರಿಗೆ ಪ್ರಮಾಣ ಮಾಡಬೇಕಾಯಿತು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ಇಸ್ರಾಯೇಲರು ಬಾಳ್ ಪೆಯೋರನ ದೇವತೆಗೆ ತಮ್ಮನ್ನು ಒಪ್ಪಿಸಿಕೊಟ್ಟರು;","poem":1},{"text":"ಜೀವವಿಲ್ಲದ ದೇವರುಗಳಿಗೆ ಅರ್ಪಿಸಿದ ಯಜ್ಞಗಳನ್ನು ತಿಂದರು.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ತಮ್ಮ ಕ್ರಿಯೆಗಳಿಂದ ದೇವರನ್ನು ಅಸಂತೋಷಪಡಿಸಿದರು.","poem":1},{"text":"ಆದ್ದರಿಂದ ವ್ಯಾಧಿಯು ಅವರಲ್ಲಿ ಹಬ್ಬಿತು.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ಆಗ ಫೀನೆಹಾಸನು ಎದ್ದು ಬಂದು ದಂಡಿಸಿದ್ದರಿಂದ","poem":1},{"text":"ವ್ಯಾಧಿ ನಿಂತುಹೋಯಿತು.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ಇದು ತಲತಲಾಂತರಕ್ಕೂ, ಯುಗಯುಗಕ್ಕೂ","poem":1},{"text":"ಫೀನೆಹಾಸನಿಗೆ ನೀತಿ ಎಂದು ಎಣಿಸಲಾಯಿತು.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ಮೆರೀಬಾದ","poem":1},{"noteId":24},{"text":"ನೀರಿನ ಬಳಿಯಲ್ಲಿ ಆತನಿಗೆ ಕೋಪವನ್ನೆಬ್ಬಿಸಿದರು.","poem":1},{"text":"ಅಲ್ಲಿ ಅವರ ನಿಮಿತ್ತ ಮೋಶೆಗೆ ಕೇಡು ಬಂತು.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ಏಕೆಂದರೆ ಇಸ್ರಾಯೇಲರು ದೇವರ ಆತ್ಮನಿಗೆ ತಿರುಗಿ ಬಿದ್ದದ್ದರಿಂದ,","poem":1},{"text":"ಮೋಶೆ ದುಡುಕಿ ಮಾತನಾಡಿದನು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"ಯೆಹೋವ ದೇವರು ಅವರಿಗೆ ಆಜ್ಞಾಪಿಸಿದ ಜನಗಳನ್ನು","poem":1},{"text":"ಅವರು ದಂಡಿಸದೆ ಹೋದರು.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ಆದರೆ ಇತರ ಜನಾಂಗಗಳ ಸಂಗಡ ಕೂಡಿಕೊಂಡು,","poem":1},{"text":"ಅವರ ಪದ್ಧತಿಗಳನ್ನು ಕಲಿತುಕೊಂಡರು.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ಅವರ ವಿಗ್ರಹಗಳಿಗೆ ಆರಾಧನೆ ಮಾಡಿದರು;","poem":1},{"text":"ಅವು ಅವರಿಗೆ ಉರುಲಿನಂತಾದವು.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"ತಮ್ಮ ಗಂಡು ಮಕ್ಕಳನ್ನೂ,","poem":1},{"text":"ಹೆಣ್ಣು ಮಕ್ಕಳನ್ನೂ ಸುಳ್ಳು ದೇವರುಗಳಿಗೆ ಬಲಿಕೊಟ್ಟರು.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"ಇದಲ್ಲದೆ ತಮ್ಮ ಗಂಡು ಹೆಣ್ಣು ಮಕ್ಕಳ","poem":1},{"text":"ನಿರಪರಾಧದ ರಕ್ತವನ್ನು ಚೆಲ್ಲಿ,","poem":2},{"text":"ಕಾನಾನಿನ ವಿಗ್ರಹಗಳಿಗೆ ಅರ್ಪಿಸಿ,","poem":1},{"text":"ದೇಶವನ್ನು ರಕ್ತದಿಂದ ಅಶುದ್ಧ ಮಾಡಿದರು.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"ಹೀಗೆ ತಮ್ಮ ದುಷ್ಕೃತ್ಯಗಳಿಂದ ತಮ್ಮನ್ನು ಅಪವಿತ್ರ ಮಾಡಿಕೊಂಡು,","poem":1},{"text":"ತಮ್ಮ ಕ್ರಿಯೆಗಳಿಂದ ದುರಾಚಾರಿಗಳಾದರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"ಆಗ ಯೆಹೋವ ದೇವರು ತಮ್ಮ ಜನರ ಮೇಲೆ ಬಹು ಬೇಸರಗೊಂಡರು.","poem":1},{"text":"ದೇವರು ತಮ್ಮ ವಾರಸುದಾರರಾದ ಇಸ್ರಾಯೇಲರ ಮೇಲೆ ಅಸಂತೋಷಗೊಂಡು,","poem":2}]},{"type":"verse","number":41,"content":[{"text":"ಅವರನ್ನು ಇತರ ಜನಾಂಗಗಳ ಕೈಗೆ ಒಪ್ಪಿಸಿಕೊಟ್ಟರು.","poem":1},{"text":"ಹೀಗೆ ಅವರ ವೈರಿಗಳು ಅವರನ್ನು ಆಳಿದರು.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"ಅವರ ಶತ್ರುಗಳು ಅವರನ್ನು ಬಾಧೆಪಡಿಸಿದರು;","poem":1},{"text":"ಅವರ ಕೈಕೆಳಗೆ ಅವರು ಅಧೀನರಾದರು.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"ಅನೇಕ ಸಾರಿ ದೇವರು ಇಸ್ರಾಯೇಲರನ್ನು ಬಿಡಿಸಿದರು,","poem":1},{"text":"ಆದರೆ ಅವರು ತಿರುಗಿಬೀಳುತ್ತಲೇ ಇದ್ದರು;","poem":2},{"lineBreak":true},{"text":"ತಮ್ಮ ಅಕ್ರಮದಿಂದಲೇ ಅವರು ಕುಗ್ಗಿಹೋದರು;","poem":2}]},{"type":"verse","number":44,"content":[{"text":"ಆದರೂ ಅವರ ಕೂಗನ್ನು ದೇವರು ಕೇಳಿದಾಗ ಇಕ್ಕಟ್ಟಿನಲ್ಲಿದ್ದ","poem":1},{"text":"ಅವರ ಮೇಲೆ ಲಕ್ಷ್ಯವಿಟ್ಟು,","poem":2}]},{"type":"verse","number":45,"content":[{"text":"ಅವರಿಗಾಗಿ ತಮ್ಮ ಒಡಂಬಡಿಕೆಯನ್ನು ಜ್ಞಾಪಕಮಾಡಿಕೊಂಡು,","poem":1},{"text":"ತಮ್ಮ ಅತಿಶಯವಾದ ಪ್ರೀತಿಯ ಪ್ರಕಾರ,","poem":2}]},{"type":"verse","number":46,"content":[{"text":"ಅವರನ್ನು ಸೆರೆಹಿಡಿದವರ","poem":1},{"text":"ಕರುಣೆ ತೋರುವಂತೆ ಮಾಡಿದರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"ನಮ್ಮ ದೇವರಾದ ಯೆಹೋವ ದೇವರೇ,","poem":1},{"text":"ನಾವು ನಿಮ್ಮ ಪರಿಶುದ್ಧ ಹೆಸರಿಗೆ ಉಪಕಾರಸ್ತುತಿ ಮಾಡಿ,","poem":2},{"text":"ನಿಮ್ಮ ಸ್ತೋತ್ರದಲ್ಲಿ ಜಯಘೋಷ ಮಾಡುವ ಹಾಗೆ,","poem":1},{"text":"ನಮ್ಮನ್ನು ರಕ್ಷಿಸಿರಿ.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":48,"content":[{"text":"ಇಸ್ರಾಯೇಲ್ ದೇವರಾದ ಯೆಹೋವ ದೇವರಿಗೆ","poem":1},{"text":"ಯುಗಯುಗಕ್ಕೂ ಸ್ತುತಿಯುಂಟಾಗಲಿ.","poem":2},{"lineBreak":true},{"text":"ಜನರೆಲ್ಲರೂ, “ಆಮೆನ್!” ಎಂದು ಹೇಳಲಿ.","poem":1},{"lineBreak":true},{"text":"ನೀವು ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.","poem":1}]}],"footnotes":[{"noteId":24,"caller":"+","text":"ಮೆರೀಬಾದ ಅಂದರೆ ಜಗಳ ಎಂದು ಅರ್ಥ. ನೋಡಿರಿ ವಿಮೋ 17:7","reference":{"chapter":106,"verse":32}}]},"thisChapterLink":"/api/kan_okcv/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}