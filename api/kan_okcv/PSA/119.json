{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"PSA","translationId":"kan_okcv","name":"ಕೀರ್ತನೆಗಳು","commonName":"ಕೀರ್ತನೆಗಳು","title":"ಕೀರ್ತನೆಗಳು","order":19,"numberOfChapters":150,"sha256":"8fda6557d2590d4e512d2801111ece4ef0438ce426c3b9b41fc862a02e5e2271","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kan_okcv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":119,"content":[{"type":"verse","number":1,"content":[{"text":"ಯೆಹೋವ ದೇವರ ನಿಯಮಕ್ಕೆ ಅನುಸಾರವಾಗಿದ್ದು,","poem":1},{"text":"ದೋಷರಹಿತ ಮಾರ್ಗದಲ್ಲಿ ನಡೆದುಕೊಳ್ಳುವವರೂ ಧನ್ಯರು.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ಸಂಪೂರ್ಣ ಹೃದಯದಿಂದ ದೇವರನ್ನು ಹುಡುಕುತ್ತಾ","poem":1},{"text":"ಅವರ ಶಾಸನಗಳನ್ನು ಕೈಗೊಳ್ಳುವವರೂ ಧನ್ಯರು","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ಅಂಥವರು ಅನ್ಯಾಯವನ್ನು ಮಾಡದೆ,","poem":1},{"text":"ದೇವರ ಮಾರ್ಗಗಳಲ್ಲಿ ನಡೆದುಕೊಳ್ಳುವರು.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ದೇವರೇ, ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ಪೂರ್ಣವಾಗಿ ಕೈಗೊಳ್ಳಬೇಕೆಂದು","poem":1},{"text":"ನೀವು ಆಜ್ಞಾಪಿಸಿದ್ದೀರಿ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ಪಾಲಿಸುವುದರಲ್ಲಿ","poem":1},{"text":"ನನ್ನ ಮಾರ್ಗಗಳು ಸ್ಥಿರವಾಗಿರಲಿ!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ನಿಮ್ಮ ಎಲ್ಲಾ ಅಪ್ಪಣೆಗಳನ್ನು ಪರಿಗಣಿಸುವಾಗ","poem":1},{"text":"ನಾನು ನಾಚಿಕೆಗೆ ಗುರಿಯಾಗುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ನಾನು ನಿಮ್ಮ ನೀತಿಯುಳ್ಳ ನಿಯಮಗಳನ್ನು ಕಲಿಯುತ್ತಿರುವಾಗೆಲ್ಲಾ,","poem":1},{"text":"ಯಥಾರ್ಥ ಹೃದಯದಿಂದ ನಿಮ್ಮನ್ನು ಕೊಂಡಾಡುವೆನು.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ನಾನು ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ಪಾಲಿಸುವೆನು;","poem":1},{"text":"ನನ್ನನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ಕೈಬಿಡಬೇಡಿರಿ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ಯೌವನಸ್ಥನು ಯಾವುದರಿಂದ ತನ್ನ ನಡತೆಯನ್ನು ಶುದ್ಧವಾಗಿಟ್ಟುಕೊಳ್ಳುವನು?","poem":1},{"text":"ನಿಮ್ಮ ವಾಕ್ಯದ ಪ್ರಕಾರ ಜೀವಿಸುವುದರಿಂದಲೇ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ನನ್ನ ಪೂರ್ಣಹೃದಯದಿಂದ ನಿಮ್ಮನ್ನು ಹುಡುಕಿದ್ದೇನೆ;","poem":1},{"text":"ನಿಮ್ಮ ಆಜ್ಞೆಗಳಿಂದ ನಾನು ತಪ್ಪಿಹೋಗದಂತೆ ಮಾಡಿರಿ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ನಿಮಗೆ ವಿರೋಧವಾಗಿ ಪಾಪಮಾಡದ ಹಾಗೆ","poem":1},{"text":"ನನ್ನ ಹೃದಯದಲ್ಲಿ ನಿಮ್ಮ ವಾಕ್ಯವನ್ನು ಬಚ್ಚಿಟ್ಟುಕೊಂಡಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ಯೆಹೋವ ದೇವರೇ, ನಿಮಗೆ ಸ್ತುತಿಯುಂಟಾಗಲಿ;","poem":1},{"text":"ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ನನಗೆ ಕಲಿಸಿಕೊಡಿರಿ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ನಿಮ್ಮ ಬಾಯಿಂದ ಬರುವ ನಿಯಮಗಳನ್ನೆಲ್ಲಾ","poem":1},{"text":"ನನ್ನ ತುಟಿಗಳಿಂದ ನಾನು ವರ್ಣಿಸಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ಮಹಾ ಸಂಪತ್ತಿನಲ್ಲಿ ಒಬ್ಬ ವ್ಯಕ್ತಿ ಆನಂದಿಸುವ ಹಾಗೆ","poem":1},{"text":"ನಾನು ನಿಮ್ಮ ಶಾಸನಗಳನ್ನು ಅನುಸರಿಸುವುದರಲ್ಲಿ ಆನಂದಿಸುವೆನು.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ಧ್ಯಾನಮಾಡಿ,","poem":1},{"text":"ನಿಮ್ಮ ಮಾರ್ಗಗಳನ್ನು ದೃಷ್ಟಿಸುವೆನು.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ನಿಮ್ಮ ತೀರ್ಪುಗಳಲ್ಲಿ ಉಲ್ಲಾಸಗೊಂಡು,","poem":1},{"text":"ನಿಮ್ಮ ವಾಕ್ಯವನ್ನು ತಿರಸ್ಕರಿಸದಿರುವೆನು.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ನಾನು ಜೀವದಿಂದಿದ್ದು ನಿಮ್ಮ ವಾಕ್ಯವನ್ನು ಕೈಗೊಳ್ಳುವಂತೆ","poem":1},{"text":"ನಿಮ್ಮ ಸೇವಕನ ಮೇಲೆ ದಯೆಯಿಡಿರಿ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ನಿಮ್ಮ ನಿಯಮದೊಳಗಿನ ಅದ್ಭುತಗಳನ್ನು ಕಾಣುವಂತೆ","poem":1},{"text":"ನನ್ನ ಕಣ್ಣುಗಳನ್ನು ತೆರೆಯಿರಿ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ಈ ಭೂಮಿಯಲ್ಲಿ ನಾನೊಬ್ಬ ಪ್ರವಾಸಿಯಾಗಿದ್ದೇನೆ;","poem":1},{"text":"ನಿಮ್ಮ ಆಜ್ಞೆಗಳನ್ನು ನನಗೆ ಮರೆಮಾಡಬೇಡಿರಿ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ನಿಮ್ಮ ನಿಯಮಗಳನ್ನು ಯಾವಾಗಲೂ ಹಂಬಲಿಸುತ್ತಿರುವುದರಿಂದ,","poem":1},{"text":"ನನ್ನ ಪ್ರಾಣವು ಕರಗಿಹೋಗುತ್ತಿದೆ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ನಿಮ್ಮ ಆಜ್ಞೆಗಳನ್ನು ಅನುಸರಿಸದೆ ತಪ್ಪಿಹೋಗುವ ಶಾಪಗ್ರಸ್ತರಾದ","poem":1},{"text":"ಗರ್ವಿಷ್ಠರನ್ನು ನೀವು ಗದರಿಸುತ್ತೀರಿ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ನಾನು ನಿಮ್ಮ ಶಾಸನಗಳನ್ನು ಕೈಗೊಂಡ ಕಾರಣ,","poem":1},{"text":"ಗರ್ವಿಷ್ಠರ ನಿಂದೆಯನ್ನೂ, ತಿರಸ್ಕಾರವನ್ನೂ ನನ್ನಿಂದ ತೊಲಗಿಸಿರಿ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ಅಧಿಕಾರಿಗಳು ನನಗೆ ವಿರೋಧವಾಗಿ ಕುಳಿತುಕೊಂಡು ಮಾತನಾಡಿಕೊಂಡರೂ,","poem":1},{"text":"ನಿಮ್ಮ ಸೇವಕನು ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನೇ ಧ್ಯಾನಿಸುತ್ತಿರುವೆನು.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ನಿಮ್ಮ ಶಾಸನಗಳು ನನಗೆ ಉಲ್ಲಾಸಕರವಾಗಿವೆ;","poem":1},{"text":"ಅವೇ ನನ್ನ ಸಮಾಲೋಚಕರು.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ನಾನು ಧೂಳಿನಲ್ಲಿ ಬಿದ್ದಿದ್ದೇನೆ;","poem":1},{"text":"ನಿಮ್ಮ ವಾಕ್ಯದ ಪ್ರಕಾರ ನನ್ನನ್ನು ಉಜ್ಜೀವಿಸಿರಿ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ನಾನು ನನ್ನ ಮಾರ್ಗಗಳನ್ನು ಲೆಕ್ಕ ಒಪ್ಪಿಸಲು,","poem":1},{"text":"ನೀವು ನನಗೆ ಸದುತ್ತರವನ್ನು ಕೊಟ್ಟಿರುವಿರಿ;","poem":2},{"lineBreak":true},{"text":"ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ನನಗೆ ಕಲಿಸಿಕೊಡಿರಿ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ನಿಮ್ಮ ಸೂತ್ರಗಳ ಮಾರ್ಗವನ್ನು ನಾನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಸಹಾಯಿಸಿರಿ,","poem":1},{"text":"ಆಗ ನಿಮ್ಮ ಅದ್ಭುತಕಾರ್ಯಗಳನ್ನು ಧ್ಯಾನ ಮಾಡುವೆನು.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ನನ್ನ ಪ್ರಾಣವು ದುಃಖದಿಂದ ಬಲಹೀನವಾಗಿದೆ;","poem":1},{"text":"ನಿಮ್ಮ ವಾಕ್ಯದಿಂದ ನನ್ನನ್ನು ಬಲಪಡಿಸಿರಿ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ವಂಚನೆಯುಳ್ಳ ಮಾರ್ಗದಿಂದ ನನ್ನನ್ನು ಕಾಪಾಡಿರಿ;","poem":1},{"text":"ನನಗೆ ಕೃಪೆ ನೀಡಿ ನಿಮ್ಮ ನಿಯಮವನ್ನು ನನಗೆ ಬೋಧನೆ ಮಾಡಿರಿ.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ನಂಬಿಗಸ್ತಿಕೆಯ ಮಾರ್ಗವನ್ನು ಆರಿಸಿಕೊಂಡಿದ್ದೇನೆ;","poem":1},{"text":"ನಾನು ನಿಮ್ಮ ನಿಯಮಗಳ ಮೇಲೆ ನನ್ನ ಹೃದಯವನ್ನಿಟ್ಟುಕೊಂಡಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ಯೆಹೋವ ದೇವರೇ, ನಾನು ನಿಮ್ಮ ಶಾಸನಗಳನ್ನು ಬಿಗಿಯಾಗಿಟ್ಟುಕೊಂಡಿದ್ದೇನೆ;","poem":1},{"text":"ನನ್ನನ್ನು ನಾಚಿಕೆಗೆ ಗುರಿಪಡಿಸಬೇಡಿರಿ.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ನಿಮ್ಮ ಆಜ್ಞೆಗಳ ಮಾರ್ಗದಲ್ಲಿ ಓಡುವೆನು,","poem":1},{"text":"ಏಕೆಂದರೆ ನೀವು ನನ್ನ ವಿವೇಕವನ್ನು ವಿಸ್ತಾರ ಮಾಡಿದ್ದೀರಿ.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ತೀರ್ಪುಗಳ ವಿವರವನ್ನು ನನಗೆ ಬೋಧಿಸಿರಿ;","poem":1},{"text":"ಆಗ ನಾನು ಅವುಗಳನ್ನು ಅಂತ್ಯದವರೆಗೂ ಹಿಂಬಾಲಿಸುವೆನು.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ನಿಮ್ಮ ನಿಯಮವನ್ನು ಹಿಂಬಾಲಿಸಿ,","poem":1},{"text":"ಅದನ್ನು ಪೂರ್ಣಹೃದಯದಿಂದ ಕೈಕೊಳ್ಳಲು ನನಗೆ ವಿವೇಚನೆಯನ್ನು ನೀಡಿರಿ.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ನಿಮ್ಮ ಆಜ್ಞೆಗಳ ಮಾರ್ಗದಲ್ಲಿ ನನ್ನನ್ನು ನಡೆಸಿರಿ,","poem":1},{"text":"ಏಕೆಂದರೆ ನಾನು ಅದರಲ್ಲಿ ಆನಂದಿಸುತ್ತೇನೆ.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ಸ್ವಾರ್ಥದ ಲಾಭಗಳ ಕಡೆಗಲ್ಲ,","poem":1},{"text":"ಆದರೆ ನಿಮ್ಮ ಶಾಸನಗಳ ಕಡೆಗೆ ನನ್ನ ಹೃದಯವನ್ನು ತಿರುಗಿಸಿರಿ.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"ವ್ಯರ್ಥವಾದವುಗಳಿಂದ ನನ್ನ ಕಣ್ಣುಗಳನ್ನು ತಿರುಗಿಸಿ,","poem":1},{"text":"ನಿಮ್ಮ ವಾಕ್ಯದ ಅನುಸಾರವಾಗಿ ನನ್ನ ಜೀವವನ್ನು ಕಾಪಾಡಿರಿ.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"ನಿಮಗೆ ಭಯಪಡುವವರಿಗಾಗಿ ನೀಡುವ ವಾಗ್ದಾನವನ್ನು","poem":1},{"text":"ನಿಮ್ಮ ಸೇವಕನಿಗೆ ನೆರವೇರಿಸಿರಿ.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"ನಾನು ಭಯಪಡುವ ನನ್ನ ನಿಂದೆಯನ್ನು ನನ್ನಿಂದ ತೊಲಗಿಸಿರಿ,","poem":1},{"text":"ಏಕೆಂದರೆ ನಿಮ್ಮ ನಿಯಮಗಳು ಒಳ್ಳೆಯವುಗಳೇ.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"ಇಗೋ ನಿಮ್ಮ ಸೂತ್ರಗಳಿಗಾಗಿ ನಾನು ಎಷ್ಟೋ ಹಂಬಲಿಸುತ್ತೇನೆ!","poem":1},{"text":"ನಿಮ್ಮ ನೀತಿಗನುಸಾರವಾಗಿ ನನ್ನ ಜೀವವನ್ನು ಕಾಪಾಡಿರಿ.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯು ನನಗೆ ದೊರಕಲಿ,","poem":1},{"text":"ನಿಮ್ಮ ವಾಗ್ದಾನದ ರಕ್ಷಣೆಯು ನನಗೆ ಉಂಟಾಗಲಿ;","poem":2}]},{"type":"verse","number":42,"content":[{"text":"ಆಗ ನನ್ನನ್ನು ನಿಂದಿಸುವವನಿಗೆ ಉತ್ತರಕೊಡುವೆನು,","poem":1},{"text":"ಏಕೆಂದರೆ ನಾನು ನಿಮ್ಮ ವಾಕ್ಯದಲ್ಲಿ ಭರವಸೆಯಿಟ್ಟಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"ಸತ್ಯವಾಕ್ಯವನ್ನು ನನ್ನ ಬಾಯಿಂದ ತೆಗೆಯಬೇಡಿರಿ,","poem":1},{"text":"ಏಕೆಂದರೆ ನಿಮ್ಮ ನಿಯಮಗಳಲ್ಲಿ ನಾನು ನನ್ನ ನಿರೀಕ್ಷೆಯನ್ನಿಟ್ಟಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"ನಾನು ನಿಮ್ಮ ನಿಯಮವನ್ನು ಯಾವಾಗಲೂ","poem":1},{"text":"ಮತ್ತು ಎಂದೆಂದಿಗೂ ಪಾಲಿಸುವೆನು.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ನಾನು ಹುಡುಕುವುದರಿಂದ,","poem":1},{"text":"ನಾನು ಸ್ವತಂತ್ರವಾಗಿಯೇ ಜೀವಿಸುವೆನು.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"ಅರಸರ ಮುಂದೆ ನಿಮ್ಮ ಶಾಸನಗಳನ್ನು ಮಾತಾಡುವೆನು,","poem":1},{"text":"ಅವುಗಳ ಬಗ್ಗೆ ನಾನೆಂದೂ ನಾಚಿಕೆಪಡುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"ನಿಮ್ಮ ಆಜ್ಞೆಗಳನ್ನು ನಾನು ಪ್ರೀತಿಸುವುದರಿಂದ,","poem":1},{"text":"ನಾನು ಅವುಗಳಲ್ಲಿ ಆನಂದಿಸುವೆನು.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"ನಾನು ಪ್ರೀತಿಸುವ ನಿಮ್ಮ ಆಜ್ಞೆಗಳ ಕಡೆಗೆ ನನ್ನ ಕೈಗಳನ್ನೆತ್ತಿ,","poem":1},{"text":"ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ಧ್ಯಾನ ಮಾಡುವೆನು.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"ನಿಮ್ಮ ಸೇವಕನಿಗೋಸ್ಕರ ನಿಮ್ಮ ವಾಕ್ಯವನ್ನು ನೀವು ಜ್ಞಾಪಕಮಾಡಿಕೊಳ್ಳಿರಿ,","poem":1},{"text":"ಏಕೆಂದರೆ ನೀವು ನನಗೆ ನಿರೀಕ್ಷೆಯನ್ನು ಕೊಟ್ಟಿದ್ದೀರಿ.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"ನಿಮ್ಮ ವಾಗ್ದಾನವು ನನ್ನ ಜೀವದ ಸಂರಕ್ಷಣೆಯಾಗಿದೆ.","poem":1},{"text":"ಅವು ನನ್ನ ಸಂಕಷ್ಟಗಳಲ್ಲಿ ಆದರಣೆಯಾಗಿವೆ.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"ಅಹಂಕಾರಿಗಳು ನನ್ನನ್ನು ಕರುಣಿಸದೆ ಹಾಸ್ಯ ಮಾಡಿದರೂ,","poem":1},{"text":"ನಾನು ನಿಮ್ಮ ನಿಯಮದಿಂದ ತೊಲಗುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಪುರಾತನ ನಿಯಮಗಳನ್ನು ನಾನು ನೆನಪು ಮಾಡಿಕೊಂಡು,","poem":1},{"text":"ಅವುಗಳಲ್ಲಿ ಆದರಣೆಯನ್ನು ಪಡೆದುಕೊಂಡಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"ನಿಮ್ಮ ನಿಯಮವನ್ನು ಬಿಟ್ಟುಬಿಡುವ ದುಷ್ಟರ ನಿಮಿತ್ತ,","poem":1},{"text":"ರೋಷವು ನನ್ನನ್ನು ಆವರಿಸಿಕೊಂಡಿದೆ.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"ನನ್ನ ಪ್ರವಾಸದ ಮನೆಯಲ್ಲಿ","poem":1},{"text":"ನಿಮ್ಮ ತೀರ್ಪುಗಳು ನನಗೆ ಗಾನ ವಿಷಯವಾಗಿದೆ.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"ಯೆಹೋವ ದೇವರೇ, ರಾತ್ರಿಯಲ್ಲಿ ನಿಮ್ಮ ನಾಮಸ್ಮರಣೆ ಮಾಡುವುದರಿಂದ,","poem":1},{"text":"ನಿಮ್ಮ ನಿಯಮವನ್ನು ಕೈಕೊಳ್ಳುತ್ತೇನೆ.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"ನಾನು ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ಕೈಗೊಂಡಿದ್ದೇನೆ:","poem":1},{"text":"ಇದೇ ನನ್ನ ಜೀವನದ ಶೈಲಿಯಾಗಿದೆ.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"ಯೆಹೋವ ದೇವರೇ, ನೀವೇ ನನ್ನ ಪಾಲು;","poem":1},{"text":"ನಿಮ್ಮ ವಾಕ್ಯಗಳನ್ನು ಪಾಲಿಸುವೆನೆಂದು ನಾನು ಪ್ರಮಾಣ ಮಾಡಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"ಪೂರ್ಣಹೃದಯದಿಂದ ನಾನು ನಿಮ್ಮ ಮುಖವನ್ನು ಹುಡುಕಿದ್ದೇನೆ;","poem":1},{"text":"ನಿಮ್ಮ ವಾಕ್ಯದ ಪ್ರಕಾರ ನನ್ನನ್ನು ಕರುಣಿಸಿರಿ.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"ನಾನು ನನ್ನ ನಡತೆಯನ್ನು ಪರಿಶೋಧಿಸುತ್ತಾ","poem":1},{"text":"ನನ್ನ ಹೆಜ್ಜೆಗಳನ್ನು ನಿಮ್ಮ ಶಾಸನಗಳ ಕಡೆಗೆ ತಿರುಗಿಸಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"ನಿಮ್ಮ ಆಜ್ಞೆಗಳನ್ನು ಪಾಲಿಸಲು ನಾನು","poem":1},{"text":"ತಡಮಾಡದೆ ತ್ವರೆಪಟ್ಟಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"ದುಷ್ಟರ ಪಾಶಗಳು ನನ್ನನ್ನು ಸುತ್ತಿಕೊಂಡಿದ್ದರೂ,","poem":1},{"text":"ನಿಮ್ಮ ನಿಯಮವನ್ನು ನಾನು ಮರೆಯಲಿಲ್ಲ.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"ನಿಮ್ಮ ನೀತಿಯುಳ್ಳ ನಿಯಮಗಳಿಗಾಗಿ","poem":1},{"text":"ನಿಮಗೆ ಕೃತಜ್ಞತೆ ಸಲ್ಲಿಸಲು ಮಧ್ಯರಾತ್ರಿಯಲ್ಲಿ ಏಳುವೆನು.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"ನಿಮಗೆ ಭಯಪಡುವವರೆಲ್ಲರಿಗೂ,","poem":1},{"text":"ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ಹಿಂಬಾಲಿಸುವವರಿಗೂ ನಾನು ಮಿತ್ರನಾಗಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":64,"content":[{"text":"ಯೆಹೋವ ದೇವರೇ, ಭೂಮಿಯು ನಿಮ್ಮ ಪ್ರೀತಿಯಿಂದ ತುಂಬಿದೆ;","poem":1},{"text":"ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ನನಗೆ ಬೋಧಿಸಿರಿ.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ವಾಕ್ಯದ ಪ್ರಕಾರ","poem":1},{"text":"ನಿಮ್ಮ ಸೇವಕನಿಗೆ ಒಳ್ಳೆಯದನ್ನು ಮಾಡಿರಿ.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"ತಿಳುವಳಿಕೆಯನ್ನೂ ಒಳ್ಳೆಯ ವಿವೇಚನೆಯನ್ನೂ, ನನಗೆ ಕಲಿಸಿರಿ,","poem":1},{"text":"ಏಕೆಂದರೆ ನಿಮ್ಮ ಆಜ್ಞೆಗಳಲ್ಲಿ ಭರವಸೆ ಇಟ್ಟಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"ನಾನು ಬಾಧೆಪಡುವುದಕ್ಕಿಂತ ಮುಂಚೆ ದಾರಿತಪ್ಪಿಹೋಗುತ್ತಿದ್ದೆನು,","poem":1},{"text":"ಆದರೆ ಈಗ ನಿಮ್ಮ ವಾಕ್ಯವನ್ನು ಪಾಲಿಸುತ್ತಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":68,"content":[{"text":"ನೀವು ಒಳ್ಳೆಯವರೂ, ಒಳ್ಳೆಯದನ್ನು ಮಾಡುವವರೂ ಆಗಿದ್ದೀರಿ;","poem":1},{"text":"ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ನನಗೆ ಕಲಿಸಿರಿ.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"ಅಹಂಕಾರಿಗಳು ನನಗೆ ವಿರೋಧವಾಗಿ ಸುಳ್ಳು ಕಲ್ಪಿಸಿದರು,","poem":1},{"text":"ನಾನಾದರೋ ಪೂರ್ಣಹೃದಯದಿಂದ ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ಕೈಗೊಳ್ಳುವೆನು.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"ಅವರ ಹೃದಯವು ಕಠಿಣವೂ ಮಂದವೂ ಆಗಿದೆ,","poem":1},{"text":"ನಾನಾದರೋ ನಿಮ್ಮ ನಿಯಮದಲ್ಲಿ ಆನಂದಪಡುತ್ತೇನೆ.","poem":2}]},{"type":"verse","number":71,"content":[{"text":"ನಾನು ಶ್ರಮೆಪಟ್ಟದ್ದು ನನಗೆ ಒಳ್ಳೆಯದಾಯಿತು","poem":1},{"text":"ಅದರಿಂದ ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ಕಲಿತೆನು.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"ಸಾವಿರಾರು ಬೆಳ್ಳಿಬಂಗಾರ ನಾಣ್ಯಗಳಿಗಿಂತಲೂ","poem":1},{"text":"ನಿಮ್ಮ ಬಾಯಿಯ ನಿಯಮವು ನನಗೆ ಹೆಚ್ಚು ಅಮೂಲ್ಯವಾದದ್ದಾಗಿದೆ.","poem":2}]},{"type":"verse","number":73,"content":[{"text":"ನಿಮ್ಮ ಕೈಗಳು ನನ್ನನ್ನು ನಿರ್ಮಿಸಿ ರೂಪಿಸಿದವು;","poem":1},{"text":"ನಿಮ್ಮ ಆಜ್ಞೆಗಳನ್ನು ಕಲಿತುಕೊಳ್ಳಲು ನನಗೆ ಅರಿವನ್ನು ನೀಡಿರಿ.","poem":2}]},{"type":"verse","number":74,"content":[{"text":"ನಿಮಗೆ ಭಯಪಡುವವರು ನನ್ನನ್ನು ನೋಡಿ ಆನಂದಿಸಲಿ,","poem":1},{"text":"ಏಕೆಂದರೆ ನಾನು ನಿಮ್ಮ ವಾಕ್ಯದಲ್ಲಿ ನಿರೀಕ್ಷಿಸಿಕೊಂಡಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":75,"content":[{"text":"ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ನಿಯಮಗಳು ನೀತಿಯುಳ್ಳವುಗಳು;","poem":1},{"text":"ನಿಮ್ಮ ನಂಬಿಗಸ್ತಿಕೆಯಿಂದಲೇ ನೀವು ನನ್ನನ್ನು ಕಷ್ಟಪಡಿಸಿದ್ದೀರಿ ಎಂದು ನನಗೆ ಗೊತ್ತಿದೆ.","poem":2}]},{"type":"verse","number":76,"content":[{"text":"ನೀವು ನಿಮ್ಮ ಸೇವಕನಿಗೆ ನೀಡಿದ ವಾಗ್ದಾನದ ಪ್ರಕಾರ,","poem":1},{"text":"ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯು ನನಗೆ ಆದರಣೆಯಾಗಿರಲಿ.","poem":2}]},{"type":"verse","number":77,"content":[{"text":"ನಾನು ಜೀವಿಸುವಂತೆ ನಿಮ್ಮ ಅನುಕಂಪವು ನನಗೆ ಬರಲಿ,","poem":1},{"text":"ಏಕೆಂದರೆ ನಿಮ್ಮ ನಿಯಮವೇ ನನ್ನ ಆನಂದವಾಗಿದೆ.","poem":2}]},{"type":"verse","number":78,"content":[{"text":"ಅಹಂಕಾರಿಗಳು ಕಾರಣವಿಲ್ಲದೆ ನನಗೆ ಕೇಡು ಮಾಡಿದ್ದರಿಂದ ನಾಚಿಕೆಪಡಲಿ;","poem":1},{"text":"ಆದರೆ ನಾನು ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ಧ್ಯಾನಿಸುತ್ತಿರುವೆನು.","poem":2}]},{"type":"verse","number":79,"content":[{"text":"ನಿಮಗೆ ಭಯಪಡುವವರು ನನ್ನ ಬಳಿಗೆ ಬರಲಿ,","poem":1},{"text":"ನಿಮ್ಮ ಶಾಸನಗಳನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳುವವರೂ ನನ್ನ ಬಳಿಗೆ ಬರಲಿ.","poem":2}]},{"type":"verse","number":80,"content":[{"text":"ನಿಷ್ಕಳಂಕ ಹೃದಯದಿಂದ ನಾನು ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ಪಾಲಿಸುವೆನು,","poem":1},{"text":"ಅದರಿಂದ ನಾನು ನಾಚಿಕೆಗೆ ಗುರಿಯಾಗದಿರುವೆನು.","poem":2}]},{"type":"verse","number":81,"content":[{"text":"ನನ್ನ ಪ್ರಾಣವು ನಿಮ್ಮ ರಕ್ಷಣೆಯ ಬಯಕೆಯಿಂದಲೇ ಕುಗ್ಗಿ ಹೋಗುತ್ತಿದೆ,","poem":1},{"text":"ಆದರೂ ನಾನು ನಿಮ್ಮ ವಾಕ್ಯದಲ್ಲಿ ನಿರೀಕ್ಷೆ ಇಟ್ಟಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":82,"content":[{"text":"ನನ್ನ ಕಣ್ಣುಗಳು ನಿಮ್ಮ ವಾಗ್ದಾನಕ್ಕಾಗಿ ಕಾಯುತ್ತಾ ಮಂದವಾಗುತ್ತಿವೆ;","poem":1},{"text":"“ನೀವು ಯಾವಾಗ ನನಗೆ ಆದರಣೆ ನೀಡುವಿರಿ?” ಎಂದು ನಾನು ಕೇಳುತ್ತಿರುವೆನು.","poem":2}]},{"type":"verse","number":83,"content":[{"text":"ನಾನು ಹೊಗೆಯಲ್ಲಿರುವ ದ್ರಾಕ್ಷಾರಸದ ಚರ್ಮಚೀಲದಂತ್ತಿದ್ದರೂ,","poem":1},{"text":"ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ನಾನು ಮರೆಯಲಿಲ್ಲ.","poem":2}]},{"type":"verse","number":84,"content":[{"text":"ಎಷ್ಟು ಕಾಲ ನಿಮ್ಮ ಸೇವಕನು ಕಾಯಬೇಕು?","poem":1},{"text":"ನನ್ನ ಹಿಂಸಕರಿಗೆ ಯಾವಾಗ ನೀವು ಶಿಕ್ಷಿಸುವಿರಿ?","poem":2}]},{"type":"verse","number":85,"content":[{"text":"ನಿಮ್ಮ ನಿಯಮಕ್ಕೆ ವಿರೋಧವಾಗಿ","poem":1},{"text":"ಅಹಂಕಾರಿಗಳು ನನಗೆ ಬಲೆಹಿಡಿಯಲು ಕುಣಿಗಳನ್ನು ಅಗೆದಿದ್ದಾರೆ.","poem":2}]},{"type":"verse","number":86,"content":[{"text":"ನಿಮ್ಮ ಆಜ್ಞೆಗಳೆಲ್ಲಾ ಭರವಸೆಗೆ ಯೋಗ್ಯವಾದವುಗಳೇ;","poem":1},{"text":"ಕಾರಣವಿಲ್ಲದೆ ಜನರು ನನ್ನನ್ನು ಹಿಂಸಿಸುವುದರಿಂದ ನನಗೆ ಸಹಾಯಮಾಡಿರಿ.","poem":2}]},{"type":"verse","number":87,"content":[{"text":"ಅವರು ನನ್ನನ್ನು ಬಹುಮಟ್ಟಿಗೆ ಭೂಮಿಯಿಂದ ಅಳಿಸಿಹಾಕಲು ನೋಡಿದರು,","poem":1},{"text":"ಆದರೆ ನಾನು ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ತಿರಸ್ಕರಿಸಲಿಲ್ಲ.","poem":2}]},{"type":"verse","number":88,"content":[{"text":"ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಯಿಂದ ನನ್ನ ಜೀವನವನ್ನು ಪರಿಪಾಲಿಸಿರಿ,","poem":1},{"text":"ಆಗ ನಿಮ್ಮ ಬಾಯಿಂದ ಹೊರಡುವ ಶಾಸನಗಳನ್ನು ಪಾಲಿಸುವೆನು.","poem":2}]},{"type":"verse","number":89,"content":[{"text":"ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ವಾಕ್ಯವು ಶಾಶ್ವತವಾಗಿದೆ;","poem":1},{"text":"ಅದು ಪರಲೋಕದಲ್ಲಿ ಸ್ಥಿರವಾಗಿದೆ.","poem":2}]},{"type":"verse","number":90,"content":[{"text":"ನಿಮ್ಮ ನಂಬಿಗಸ್ತಿಕೆಯು ಎಲ್ಲಾ ತಲೆಮಾರಿಗೂ ಮುಂದುವರಿಯುವುದು;","poem":1},{"text":"ನೀವು ಸ್ಥಾಪಿಸಿದ ಭೂಮಿಯು ನೆಲೆಯಾಗಿರುವುದು.","poem":2}]},{"type":"verse","number":91,"content":[{"text":"ನಿಮ್ಮ ನಿಯಮಗಳು ಇಂದಿನವರೆಗೂ ನಿಂತಿರುತ್ತವೆ,","poem":1},{"text":"ಏಕೆಂದರೆ ಸೃಷ್ಟಿಗಳೆಲ್ಲವೂ ನಿಮ್ಮ ಸೇವೆಯನ್ನು ಮಾಡುತ್ತವೆ.","poem":2}]},{"type":"verse","number":92,"content":[{"text":"ನಿಮ್ಮ ನಿಯಮವು ನನಗೆ ಆನಂದವಾಗಿರದಿದ್ದರೆ,","poem":1},{"text":"ನನ್ನ ಕಷ್ಟದಲ್ಲಿ ನಾನು ನಾಶವಾಗುತ್ತಿದ್ದೆನು.","poem":2}]},{"type":"verse","number":93,"content":[{"text":"ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ನಾನು ಎಂದಿಗೂ ಮರೆಯುವುದಿಲ್ಲ,","poem":1},{"text":"ಏಕೆಂದರೆ ಅವುಗಳಿಂದ ನನ್ನ ಜೀವವನ್ನು ಪರಿಪಾಲಿಸಿದ್ದೀರಿ.","poem":2}]},{"type":"verse","number":94,"content":[{"text":"ನನ್ನನ್ನು ರಕ್ಷಿಸಿರಿ, ಏಕೆಂದರೆ ನಾನು ನಿಮ್ಮವನೇ;","poem":1},{"text":"ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ನಾನು ಹುಡುಕಿದ್ದೇನಲ್ಲಾ.","poem":2}]},{"type":"verse","number":95,"content":[{"text":"ದುಷ್ಟರು ನನ್ನನ್ನು ನಾಶಮಾಡುವುದಕ್ಕೆ ನನಗಾಗಿ ಕಾಯುತ್ತಿದ್ದಾರೆ,","poem":1},{"text":"ನಾನಾದರೋ ನಿಮ್ಮ ಶಾಸನಗಳನ್ನು ಆಲೋಚಿಸುತ್ತಿರುವೆನು.","poem":2}]},{"type":"verse","number":96,"content":[{"text":"ಸರ್ವ ಸಂಪೂರ್ಣತೆಗೂ ಒಂದು ಮಿತಿಯಿರುವುದನ್ನು ನಾನು ನೋಡಿದ್ದೇನೆ;","poem":1},{"text":"ಆದರೆ ನಿಮ್ಮ ಆಜ್ಞೆಗಳು ಮಿತಿಯಿಲ್ಲದವುಗಳಾಗಿವೆ.","poem":2}]},{"type":"verse","number":97,"content":[{"text":"ನಿಮ್ಮ ನಿಯಮವನ್ನು ನಾನು ಎಷ್ಟೋ ಪ್ರೀತಿಮಾಡುತ್ತೇನೆ!","poem":1},{"text":"ದಿನವೆಲ್ಲಾ ಅದನ್ನೇ ಧ್ಯಾನಿಸುತ್ತೇನೆ.","poem":2}]},{"type":"verse","number":98,"content":[{"text":"ನಿಮ್ಮ ಆಜ್ಞೆಗಳು ಯಾವಾಗಲೂ ನನ್ನೊಂದಿಗೆ ಇರುವುದರಿಂದ ಅವು ನನ್ನನ್ನು","poem":1},{"text":"ನನ್ನ ಶತ್ರುಗಳಿಗಿಂತ ಜ್ಞಾನಿಯಾಗಿ ಮಾಡಿವೆ.","poem":2}]},{"type":"verse","number":99,"content":[{"text":"ನನ್ನ ಒಳನೋಟ ನನ್ನ ಬೋಧಕರೆಲ್ಲರಿಗಿಂತ ದೊಡ್ಡದಾಗಿದೆ.","poem":1},{"text":"ಏಕೆಂದರೆ ನಿಮ್ಮ ಶಾಸನಗಳು ನನ್ನ ಧ್ಯಾನವಾಗಿವೆ.","poem":2}]},{"type":"verse","number":100,"content":[{"text":"ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ಕೈಗೊಂಡಿರುವುದರಿಂದ","poem":1},{"text":"ನಾನು ಹಿರಿಯರಿಗಿಂತಲೂ ವಿವೇಕಿಯಾಗಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":101,"content":[{"text":"ನಿಮ್ಮ ವಾಕ್ಯವನ್ನು ಅನುಸರಿಸಬೇಕೆಂದು,","poem":1},{"text":"ನಾನು ಪ್ರತಿಯೊಂದು ದುರ್ಮಾರ್ಗದಿಂದ ನನ್ನ ಹೆಜ್ಜೆಗಳನ್ನು ಹಿಂದೆಗೆದಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":102,"content":[{"text":"ನಿಮ್ಮ ನಿಯಮಗಳಿಂದ ನಾನು ತಪ್ಪಿಹೋಗಲಿಲ್ಲ,","poem":1},{"text":"ಏಕೆಂದರೆ ನೀವೇ ನನಗೆ ಉಪದೇಶಿಸಿದ್ದೀರಿ.","poem":2}]},{"type":"verse","number":103,"content":[{"text":"ನಿಮ್ಮ ಮಾತುಗಳು ನನ್ನ ರುಚಿಗೆ ಎಷ್ಟೋ ಸಿಹಿಯಾಗಿವೆ!","poem":1},{"text":"ಅವು ನನ್ನ ಬಾಯಿಗೆ ಜೇನುತುಪ್ಪಕ್ಕಿಂತಲೂ ಸಿಹಿಯಾಗಿವೆ!","poem":2}]},{"type":"verse","number":104,"content":[{"text":"ನಾನು ನಿಮ್ಮ ಸೂತ್ರಗಳಿಂದ ತಿಳುವಳಿಕೆಯನ್ನು ಸಂಪಾದಿಸಿಕೊಂಡಿದ್ದೇನೆ;","poem":1},{"text":"ಆದ್ದರಿಂದ ಪ್ರತಿಯೊಂದು ದುರ್ಮಾರ್ಗವನ್ನೂ ದ್ವೇಷಿಸುತ್ತೇನೆ.","poem":2}]},{"type":"verse","number":105,"content":[{"text":"ನಿಮ್ಮ ವಾಕ್ಯವು ನನ್ನ ಪಾದಕ್ಕೆ ದೀಪವೂ","poem":1},{"text":"ನನ್ನ ದಾರಿಗೆ ಬೆಳಕೂ ಆಗಿದೆ.","poem":2}]},{"type":"verse","number":106,"content":[{"text":"ನಿಮ್ಮ ನೀತಿಯ ನಿಯಮಗಳನ್ನು ಪಾಲಿಸುವೆನೆಂದು ನಾನು ಒಂದು ಶಪಥಮಾಡಿದ್ದೇನೆ;","poem":1},{"text":"ಅದನ್ನು ನಾನು ದೃಢಪಡಿಸುವೆನು.","poem":2}]},{"type":"verse","number":107,"content":[{"text":"ನಾನು ಬಹಳ ಕಷ್ಟ ಅನುಭವಿಸಿದ್ದೇನೆ;","poem":1},{"text":"ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ವಾಕ್ಯದ ಅನುಸಾರವಾಗಿ ನನ್ನ ಜೀವನವನ್ನು ಕಾಪಾಡಿರಿ.","poem":2}]},{"type":"verse","number":108,"content":[{"text":"ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಬಾಯಿಂದ ಸಿದ್ಧಮನಸ್ಸಿನ ಸ್ತೋತ್ರಗಳನ್ನು ಸ್ವೀಕರಿಸಿರಿ,","poem":1},{"text":"ನಿಮ್ಮ ನಿಯಮಗಳನ್ನು ನನಗೆ ಬೋಧಿಸಿರಿ.","poem":2}]},{"type":"verse","number":109,"content":[{"text":"ನನ್ನ ಜೀವನ ಆಗಾಗ ಅಪಾಯದಲ್ಲಿದೆ,","poem":1},{"text":"ಆದಾಗ್ಯೂ ನಾನು ನಿಮ್ಮ ನಿಯಮವನ್ನು ಮರೆಯುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":110,"content":[{"text":"ದುಷ್ಟರು ನನಗೆ ಬಲೆಯೊಡ್ಡಿದ್ದಾರೆ;","poem":1},{"text":"ಆದರೂ ನಾನು ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ಬಿಟ್ಟು ತಪ್ಪಿಹೋಗಲಿಲ್ಲ.","poem":2}]},{"type":"verse","number":111,"content":[{"text":"ನಿಮ್ಮ ಶಾಸನಗಳನ್ನು ನಿತ್ಯ ಸೊತ್ತಾಗಿ ತೆಗೆದುಕೊಂಡಿದ್ದೇನೆ;","poem":1},{"text":"ಏಕೆಂದರೆ ಅವು ನನ್ನ ಹೃದಯಕ್ಕೆ ಉಲ್ಲಾಸಕರವಾಗಿದೆ.","poem":2}]},{"type":"verse","number":112,"content":[{"text":"ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ಕಡೆವರೆಗೂ ಪಾಲಿಸುವುದಕ್ಕೆ","poem":1},{"text":"ನಾನು ನನ್ನ ಹೃದಯದಲ್ಲಿ ದೃಢಮಾಡಿಕೊಂಡಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":113,"content":[{"text":"ಎರಡು ಮನಸ್ಸುಳ್ಳವರನ್ನು ನಾನು ದ್ವೇಷಿಸುತ್ತೇನೆ,","poem":1},{"text":"ಆದರೂ ನಿಮ್ಮ ನಿಯಮವನ್ನು ನಾನು ಪ್ರೀತಿಸುತ್ತೇನೆ.","poem":2}]},{"type":"verse","number":114,"content":[{"text":"ನೀವೇ ನನ್ನ ಆಶ್ರಯವೂ, ಗುರಾಣಿಯೂ ಆಗಿದ್ದೀರಿ;","poem":1},{"text":"ನಾನು ನನ್ನ ನಿರೀಕ್ಷೆಯನ್ನು ನಿಮ್ಮ ವಾಕ್ಯದಲ್ಲಿ ಇಟ್ಟುಕೊಂಡಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":115,"content":[{"text":"ನಿಯಮ ಮೀರುವವರೇ, ನನ್ನಿಂದ ತೊಲಗಿರಿ,","poem":1},{"text":"ನಾನು ನನ್ನ ದೇವರ ಆಜ್ಞೆಗಳನ್ನು ಪಾಲಿಸಲು ಬಿಡಿರಿ!","poem":2}]},{"type":"verse","number":116,"content":[{"text":"ನನ್ನ ದೇವರೇ, ನಿಮ್ಮ ವಾಕ್ಯದ ಪ್ರಕಾರ ನನ್ನನ್ನು ನೆಲೆಗೊಳಿಸಿರಿ, ಆಗ ನಾನು ಬದುಕುವೆನು;","poem":1},{"text":"ನನ್ನ ನಿರೀಕ್ಷೆ ಮುರಿದುಹೋಗದಿರಲಿ.","poem":2}]},{"type":"verse","number":117,"content":[{"text":"ನನ್ನನ್ನು ಎತ್ತಿ ಹಿಡಿಯಿರಿ, ಆಗ ನಾನು ಬಿಡುಗಡೆಯಾಗುವೆನು;","poem":1},{"text":"ನಿಮ್ಮ ತೀರ್ಪುಗಳಿಗೆ ಯಾವಾಗಲೂ ಗಮನಕೊಡುವೆನು.","poem":2}]},{"type":"verse","number":118,"content":[{"text":"ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ಮೀರಿದವರನ್ನೆಲ್ಲಾ ನೀವು ತಿರಸ್ಕರಿಸುತ್ತೀರಿ,","poem":1},{"text":"ಏಕೆಂದರೆ ಅವರ ಕುಯುಕ್ತಿಯು ವ್ಯರ್ಥವಾಗುವುದು.","poem":2}]},{"type":"verse","number":119,"content":[{"text":"ಭೂಮಿಯಲ್ಲಿರುವ ದುಷ್ಟರೆಲ್ಲರನ್ನು ಕಸದ ಹಾಗೆ ತೆಗೆದು ಹಾಕುತ್ತೀರಿ;","poem":1},{"text":"ಆದ್ದರಿಂದ ನಾನು ನಿಮ್ಮ ಶಾಸನಗಳನ್ನು ಪ್ರೀತಿಸುತ್ತೇನೆ.","poem":2}]},{"type":"verse","number":120,"content":[{"text":"ನಿಮ್ಮ ಭಯದಿಂದ ನನ್ನ ಶರೀರವು ನಡುಗುತ್ತದೆ;","poem":1},{"text":"ನಿಮ್ಮ ನಿಯಮಗಳಿಗೆ ನಾನು ಭಯಭಕ್ತಿಯುಳ್ಳವನಾಗಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":121,"content":[{"text":"ನಾನು ನೀತಿನ್ಯಾಯವನ್ನು ನಡೆಸಿದ್ದೇನೆ;","poem":1},{"text":"ನನ್ನ ಹಿಂಸಕರಿಗೆ ನನ್ನನ್ನು ಒಪ್ಪಿಸಬೇಡಿರಿ.","poem":2}]},{"type":"verse","number":122,"content":[{"text":"ನಿಮ್ಮ ಸೇವಕನ ಕ್ಷೇಮವನ್ನು ದೃಢಪಡಿಸಿರಿ;","poem":1},{"text":"ಅಹಂಕಾರಿಗಳು ನನ್ನನ್ನು ಬಾಧಿಸದಿರಲಿ.","poem":2}]},{"type":"verse","number":123,"content":[{"text":"ನಿಮ್ಮ ರಕ್ಷಣೆಯನ್ನೂ ನಿಮ್ಮ ನೀತಿಯ ವಾಗ್ದಾನವನ್ನೂ ಕಾಯುತ್ತಾ,","poem":1},{"text":"ನನ್ನ ಕಣ್ಣುಗಳು ಮಂದವಾದವು.","poem":2}]},{"type":"verse","number":124,"content":[{"text":"ನಿಮ್ಮ ಪ್ರೀತಿಗೆ ಅನುಸಾರವಾಗಿ ನಿಮ್ಮ ಸೇವಕನೊಂದಿಗೆ ವ್ಯವಹರಿಸಿ,","poem":1},{"text":"ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ನನಗೆ ಬೋಧಿಸಿರಿ.","poem":2}]},{"type":"verse","number":125,"content":[{"text":"ನಾನು ನಿಮ್ಮ ಸೇವಕನು, ನಿಮ್ಮ ಶಾಸನಗಳನ್ನು ನಾನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳುವಂತೆ","poem":1},{"text":"ನನಗೆ ವಿವೇಚನೆಯನ್ನು ಕೊಡಿರಿ.","poem":2}]},{"type":"verse","number":126,"content":[{"text":"ಯೆಹೋವ ದೇವರೇ, ಇದು ನೀವು ಕಾರ್ಯಸಾಧಿಸಲು ಸಮಯವಾಗಿದೆ,","poem":1},{"text":"ಏಕೆಂದರೆ ನಿಮ್ಮ ನಿಯಮವು ಉಲ್ಲಂಘಿಸಲಾಗಿದೆ.","poem":2}]},{"type":"verse","number":127,"content":[{"text":"ಆದ್ದರಿಂದ ನಾನು ನಿಮ್ಮ ಆಜ್ಞೆಗಳನ್ನು ಬಂಗಾರಕ್ಕಿಂತಲೂ ಹೌದು,","poem":1},{"text":"ಅಪರಂಜಿಗಿಂತಲೂ ಹೆಚ್ಚಾಗಿ ಪ್ರೀತಿಸುತ್ತೇನೆ,","poem":2}]},{"type":"verse","number":128,"content":[{"text":"ಅದರ ನಿಮಿತ್ತ ನಿಮ್ಮ ಸೂತ್ರಗಳೆಲ್ಲವೂ ಸರಿಯಾದವುಗಳೆಂದು ನಾನು ಅಂಗೀಕರಿಸುತ್ತೇನೆ,","poem":1},{"text":"ಪ್ರತಿಯೊಂದು ಮೋಸ ಮಾರ್ಗವನ್ನೂ ದ್ವೇಷಿಸುತ್ತೇನೆ.","poem":2}]},{"type":"verse","number":129,"content":[{"text":"ನಿಮ್ಮ ಶಾಸನಗಳು ಅದ್ಭುತವಾದವುಗಳೇ;","poem":1},{"text":"ಆದ್ದರಿಂದ ನಾನು ಅವುಗಳನ್ನು ಅನುಸರಿಸುತ್ತೇನೆ.","poem":2}]},{"type":"verse","number":130,"content":[{"text":"ನಿಮ್ಮ ವಾಕ್ಯಗಳನ್ನು ತೆರೆಯುವಾಗ, ಅದು ಬೆಳಕನ್ನು ಕೊಡುವುದು;","poem":1},{"text":"ಅದು ಮುಗ್ಧರಿಗೆ ಅರಿವನ್ನು ನೀಡುವುದು.","poem":2}]},{"type":"verse","number":131,"content":[{"text":"ನಿಮ್ಮ ಆಜ್ಞೆಗಳಿಗಾಗಿರುವ ಬಯಕೆಯು,","poem":1},{"text":"ನಾನು ಬಾಯಿತೆರೆದು ಹಂಬಲಿಸುವಂತೆ ಮಾಡುತ್ತದೆ.","poem":2}]},{"type":"verse","number":132,"content":[{"text":"ನಿಮ್ಮ ನಾಮವನ್ನು ಪ್ರೀತಿಸುವವರಿಗೆ ನೀವು ಯಾವಾಗಲೂ ಮಾಡುವಂತೆ,","poem":1},{"text":"ನೀವು ನನ್ನ ಕಡೆಗೆ ತಿರುಗಿಕೊಂಡು, ನನ್ನನ್ನು ಕರುಣಿಸಿರಿ.","poem":2}]},{"type":"verse","number":133,"content":[{"text":"ನನ್ನ ಹೆಜ್ಜೆಗಳನ್ನು ನಿಮ್ಮ ವಾಕ್ಯದ ಪ್ರಕಾರ ಮುನ್ನಡೆಸಿರಿ;","poem":1},{"text":"ಯಾವ ಪಾಪವಾದರೂ ನನ್ನನ್ನು ಆಳದಿರಲಿ.","poem":2}]},{"type":"verse","number":134,"content":[{"text":"ಜನರ ಬಲಾತ್ಕಾರದಿಂದ ನನ್ನನ್ನು ತಪ್ಪಿಸಿರಿ,","poem":1},{"text":"ಆಗ ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ನಾನು ಪಾಲಿಸುವೆನು.","poem":2}]},{"type":"verse","number":135,"content":[{"text":"ನಿಮ್ಮ ಮುಖವನ್ನು ನಿಮ್ಮ ಸೇವಕನ ಮೇಲೆ ಪ್ರಕಾಶಿಸಿರಿ","poem":1},{"text":"ಮತ್ತು ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ನನಗೆ ಬೋಧಿಸಿರಿ.","poem":2}]},{"type":"verse","number":136,"content":[{"text":"ನಿಮ್ಮ ನಿಯಮವನ್ನು ಕೈಗೊಳ್ಳದೇ ಇರುವಾಗ","poem":1},{"text":"ನನ್ನ ಕಣ್ಣಿನಿಂದ ಕಣ್ಣೀರು ಧಾರೆಯಾಗಿ ಹರಿಯುತ್ತಿವೆ.","poem":2}]},{"type":"verse","number":137,"content":[{"text":"ಯೆಹೋವ ದೇವರೇ, ನೀವು ನೀತಿವಂತರು,","poem":1},{"text":"ನಿಮ್ಮ ನಿಯಮಗಳು ಸರಿಯಾದವುಗಳೇ.","poem":2}]},{"type":"verse","number":138,"content":[{"text":"ನೀವು ಕೊಟ್ಟ ನಿಮ್ಮ ಶಾಸನಗಳು ನೀತಿಯುಳ್ಳವುಗಳು;","poem":1},{"text":"ಪೂರ್ಣ ಭರವಸೆಗೆ ಅವು ಯೋಗ್ಯವಾದವುಗಳು.","poem":2}]},{"type":"verse","number":139,"content":[{"text":"ನನ್ನ ವೈರಿಗಳು ನಿಮ್ಮ ಮಾತುಗಳನ್ನು ತಿರಸ್ಕರಿಸುವುದರಿಂದ,","poem":1},{"text":"ನನ್ನ ಆಸಕ್ತಿಯು ನನ್ನನ್ನು ದಹಿಸಿಬಿಟ್ಟಿದೆ.","poem":2}]},{"type":"verse","number":140,"content":[{"text":"ನಿಮ್ಮ ವಾಗ್ದಾನಗಳು ಬಹು ಪರಿಶೋಧಿತವಾಗಿವೆ,","poem":1},{"text":"ಆದ್ದರಿಂದ ನಿಮ್ಮ ಸೇವಕನು ಅವುಗಳನ್ನು ಪ್ರೀತಿಸುತ್ತಾನೆ.","poem":2}]},{"type":"verse","number":141,"content":[{"text":"ನಾನು ಅಲ್ಪನೂ, ತಿರಸ್ಕಾರ ಹೊಂದಿದವನು ಆಗಿದ್ದರೂ,","poem":1},{"text":"ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ನಾನು ಮರೆಯುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":142,"content":[{"text":"ನಿಮ್ಮ ನೀತಿಯು ನಿತ್ಯವಾದದ್ದು","poem":1},{"text":"ನಿಮ್ಮ ನಿಯಮವು ಸತ್ಯವಾದದ್ದು.","poem":2}]},{"type":"verse","number":143,"content":[{"text":"ಕಷ್ಟಸಂಕಟಗಳು ನನ್ನನ್ನು ಹಿಡಿದಿವೆ,","poem":1},{"text":"ಆದರೂ ನಿಮ್ಮ ಆಜ್ಞೆಗಳು ನನಗೆ ಆನಂದದಾಯಕವಾಗಿವೆ.","poem":2}]},{"type":"verse","number":144,"content":[{"text":"ನಿಮ್ಮ ಶಾಸನಗಳು ಯಾವಾಗಲೂ ನೀತಿಯುಕ್ತವಾಗಿವೆ;","poem":1},{"text":"ನಾನು ಬದುಕುವಂತೆ ನನಗೆ ವಿವೇಕವನ್ನು ಕೊಡಿರಿ.","poem":2}]},{"type":"verse","number":145,"content":[{"text":"ಯೆಹೋವ ದೇವರೇ, ಪೂರ್ಣಹೃದಯದಿಂದ ನಾನು ಮೊರೆಯಿಟ್ಟಿದ್ದೇನೆ; ನನಗೆ ಸದುತ್ತರ ನೀಡಿರಿ;","poem":1},{"text":"ನಾನು ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ಪಾಲಿಸುವೆನು.","poem":2}]},{"type":"verse","number":146,"content":[{"text":"ನಿಮಗೇ ಮೊರೆಯಿಟ್ಟಿದ್ದೇನೆ; ನನ್ನನ್ನು ರಕ್ಷಿಸಿರಿ","poem":1},{"text":"ನಾನು ನಿಮ್ಮ ಶಾಸನಗಳನ್ನು ಪಾಲಿಸುವೆನು.","poem":2}]},{"type":"verse","number":147,"content":[{"text":"ನಾನು ಸೂರ್ಯೋದಯಕ್ಕೆ ಮೊದಲು ಎದ್ದು ನಿಮಗೆ ಮೊರೆ ಇಟ್ಟಿದ್ದೇನೆ;","poem":1},{"text":"ನಾನು ನನ್ನ ನಿರೀಕ್ಷೆಯನ್ನು ನಿಮ್ಮ ವಾಕ್ಯದಲ್ಲಿ ಇಟ್ಟಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":148,"content":[{"text":"ನಾನು ನಿಮ್ಮ ವಾಕ್ಯವನ್ನು ಧ್ಯಾನ ಮಾಡುವಂತೆ,","poem":1},{"text":"ರಾತ್ರಿಜಾವದಲ್ಲಿ ನನ್ನ ಕಣ್ಣುಗಳು ತೆರೆದಿರುತ್ತವೆ.","poem":2}]},{"type":"verse","number":149,"content":[{"text":"ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಗೆ ಅನುಸಾರವಾಗಿ ನನ್ನ ಮೊರೆಯನ್ನು ಕೇಳಿರಿ;","poem":1},{"text":"ನಿಮ್ಮ ನಿಯಮಗಳ ಅನುಸಾರವಾಗಿ ನನ್ನ ಬದುಕನ್ನು ಕಾಪಾಡಿರಿ.","poem":2}]},{"type":"verse","number":150,"content":[{"text":"ದುಷ್ಟತನಕ್ಕೆ ಒಳಸಂಚು ಮಾಡುವವರು ನನಗೆ ಸಮೀಪವಾಗಿದ್ದಾರೆ;","poem":1},{"text":"ಆದರೆ ಅವರು ನಿಮ್ಮ ನಿಯಮಕ್ಕೆ ಅವರು ದೂರವಾಗಿದ್ದಾರೆ.","poem":2}]},{"type":"verse","number":151,"content":[{"text":"ಯೆಹೋವ ದೇವರೇ, ನೀವು ಸಮೀಪವಾಗಿದ್ದೀರಿ,","poem":1},{"text":"ನಿಮ್ಮ ಆಜ್ಞೆಗಳೆಲ್ಲಾ ಸತ್ಯವಾಗಿವೆ.","poem":2}]},{"type":"verse","number":152,"content":[{"text":"ನಿಮ್ಮ ಶಾಸನಗಳು ಸದಾಕಾಲಕ್ಕೂ ಇರುವಂತೆ ಅವುಗಳನ್ನು ಸ್ಥಾಪಿಸಿದ್ದೀರೆಂದು","poem":1},{"text":"ಬಹುಕಾಲದ ಹಿಂದೆಯೇ ನಾನು ಕಲಿತುಕೊಂಡಿದ್ದೇವೆ.","poem":2}]},{"type":"verse","number":153,"content":[{"text":"ನನ್ನ ಕಷ್ಟವನ್ನು ನೋಡಿ ನನ್ನನ್ನು ಬಿಡಿಸಿರಿ;","poem":1},{"text":"ಏಕೆಂದರೆ ನಿಮ್ಮ ನಿಯಮವನ್ನು ನಾನು ಮರೆತಿಲ್ಲ.","poem":2}]},{"type":"verse","number":154,"content":[{"text":"ನನ್ನ ಪರವಾಗಿ ವಾದಿಸಿ, ನನ್ನನ್ನು ವಿಮೋಚಿಸಿರಿ;","poem":1},{"text":"ನಿಮ್ಮ ವಾಗ್ದಾನದ ಪ್ರಕಾರ ನನ್ನ ಬದುಕನ್ನು ಕಾಪಾಡಿರಿ.","poem":2}]},{"type":"verse","number":155,"content":[{"text":"ದುಷ್ಟರಿಗೆ ರಕ್ಷಣೆಯು ದೂರವಾಗಿದೆ;","poem":1},{"text":"ಏಕೆಂದರೆ ಅವರು ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ಹುಡುಕುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":156,"content":[{"text":"ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಅನುಕಂಪವು ಮಹತ್ತಾದವುಗಳು;","poem":1},{"text":"ನಿಮ್ಮ ನಿಯಮಗಳ ಪ್ರಕಾರ ನನ್ನ ಬದುಕನ್ನು ಕಾಪಾಡಿರಿ.","poem":2}]},{"type":"verse","number":157,"content":[{"text":"ನನ್ನನ್ನು ಹಿಂಸಿಸುವ ನನ್ನ ವೈರಿಗಳು ಅನೇಕರಾಗಿದ್ದಾರೆ,","poem":1},{"text":"ನಾನಾದರೋ ನಿಮ್ಮ ಶಾಸನಗಳನ್ನು ಬಿಟ್ಟುಬಿಡಲಿಲ್ಲ.","poem":2}]},{"type":"verse","number":158,"content":[{"text":"ನಾನು ಅಪನಂಬಿಗಸ್ತರನ್ನು ಕಂಡು ಅಸಹ್ಯಪಡುತ್ತೇನೆ,","poem":1},{"text":"ಅವರು ನಿಮ್ಮ ಮಾತನ್ನು ಅಂಗೀಕರಿಸುತ್ತಾಯಿಲ್ಲಾ.","poem":2}]},{"type":"verse","number":159,"content":[{"text":"ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ನಾನು ಎಷ್ಟು ಪ್ರೀತಿಸುತ್ತೇನೆ ನೋಡಿರಿ;","poem":1},{"text":"ಯೆಹೋವ ದೇವರೇ, ನಿಮ್ಮ ಒಡಂಬಡಿಕೆಯ ಪ್ರೀತಿಗೆ ಅನುಸಾರವಾಗಿ ನನ್ನ ಬದುಕನ್ನು ಕಾಪಾಡಿರಿ.","poem":2}]},{"type":"verse","number":160,"content":[{"text":"ನಿಮ್ಮ ಮಾತುಗಳೆಲ್ಲಾ ಸತ್ಯವಾದವುಗಳೇ;","poem":1},{"text":"ನಿಮ್ಮ ನೀತಿ ನಿಯಮಗಳೆಲ್ಲಾ ನಿತ್ಯವಾದವುಗಳೇ.","poem":2}]},{"type":"verse","number":161,"content":[{"text":"ಅಧಿಕಾರಿಗಳು ಕಾರಣವಿಲ್ಲದೆ ನನ್ನನ್ನು ಹಿಂಸಿಸುತ್ತಾರೆ,","poem":1},{"text":"ಆದರೆ ನನ್ನ ಹೃದಯವು ನಿಮ್ಮ ವಾಕ್ಯಗಳಿಗೆ ನಡುಗುತ್ತದೆ.","poem":2}]},{"type":"verse","number":162,"content":[{"text":"ದೊಡ್ಡ ಕೊಳ್ಳೆಯನ್ನು ಕಂಡುಹಿಡಿದವರಂತೆ","poem":1},{"text":"ನಾನು ನಿಮ್ಮ ವಾಗ್ದಾನದಲ್ಲಿ ಆನಂದಿಸುತ್ತೇನೆ.","poem":2}]},{"type":"verse","number":163,"content":[{"text":"ಸುಳ್ಳುತನವನ್ನು ನಾನು ದ್ವೇಷಿಸಿ ಅಸಹ್ಯಪಡುತ್ತೇನೆ","poem":1},{"text":"ಆದರೆ ನಾನು ನಿಮ್ಮ ನಿಯಮವನ್ನು ಪ್ರೀತಿಸುತ್ತೇನೆ.","poem":2}]},{"type":"verse","number":164,"content":[{"text":"ನಿಮ್ಮ ನೀತಿಯ ನಿಯಮಗಳ ನಿಮಿತ್ತ,","poem":1},{"text":"ನಾನು ದಿನಕ್ಕೆ ಏಳು ಸಾರಿ ನಿಮ್ಮನ್ನು ಸ್ತುತಿಸುತ್ತೇನೆ.","poem":2}]},{"type":"verse","number":165,"content":[{"text":"ನಿಮ್ಮ ನಿಯಮ ಪ್ರಿಯರಿಗೆ ಅಪಾರ ಸಮಾಧಾನವಿರುತ್ತದೆ,","poem":1},{"text":"ಅಂಥವರಿಗೆ ಆತಂಕವೇನೂ ಇರುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":166,"content":[{"text":"ಯೆಹೋವ ದೇವರೇ, ನಾನು ನಿಮ್ಮ ರಕ್ಷಣೆಗಾಗಿ ಕಾದುಕೊಂಡಿದ್ದೇನೆ;","poem":1},{"text":"ನಾನು ನಿಮ್ಮ ಆಜ್ಞೆಗಳನ್ನು ಹಿಂಬಾಲಿಸುತ್ತಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":167,"content":[{"text":"ನಾನು ನಿಮ್ಮ ಶಾಸನಗಳನ್ನು ಅನುಸರಿಸುವದರಿಂದ,","poem":1},{"text":"ಅವುಗಳನ್ನು ಅತ್ಯಧಿಕವಾಗಿ ಪ್ರೀತಿಸುತ್ತೇನೆ.","poem":2}]},{"type":"verse","number":168,"content":[{"text":"ನಾನು ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನೂ ಶಾಸನಗಳನ್ನೂ ಪಾಲಿಸುತ್ತೇನೆ,","poem":1},{"text":"ಏಕೆಂದರೆ ನನ್ನ ಮಾರ್ಗಗಳೆಲ್ಲವೂ ನಿಮಗೆ ತಿಳಿದಿರುತ್ತವೆ.","poem":2}]},{"type":"verse","number":169,"content":[{"text":"ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಮೊರೆ ನಿಮ್ಮ ಸನ್ನಿಧಿ ಸೇರಲಿ;","poem":1},{"text":"ನಿಮ್ಮ ವಾಕ್ಯದ ಪ್ರಕಾರ ನನಗೆ ಅರಿವನ್ನು ನೀಡಿರಿ.","poem":2}]},{"type":"verse","number":170,"content":[{"text":"ನನ್ನ ಬೇಡಿಕೆಯು ನಿಮ್ಮ ಸನ್ನಿಧಿ ಸೇರಲಿ;","poem":1},{"text":"ನಿಮ್ಮ ವಾಗ್ದಾನದ ಪ್ರಕಾರ ನನ್ನನ್ನು ಬಿಡಿಸಿರಿ.","poem":2}]},{"type":"verse","number":171,"content":[{"text":"ನೀವು ನಿಮ್ಮ ತೀರ್ಪುಗಳನ್ನು ನನಗೆ ಬೋಧಿಸಿದಾಗ,","poem":1},{"text":"ನನ್ನ ತುಟಿಗಳಿಂದ ಸ್ತೋತ್ರವು ಪ್ರವಾಹಿಸಲಿ.","poem":2}]},{"type":"verse","number":172,"content":[{"text":"ನಿಮ್ಮ ಆಜ್ಞೆಗಳೆಲ್ಲಾ ನೀತಿಯುಳ್ಳವುಗಳಾಗಿವೆ,","poem":1},{"text":"ಆದುದರಿಂದ ನನ್ನ ನಾಲಿಗೆಯು ನಿಮ್ಮ ವಾಕ್ಯವನ್ನು ಹಾಡಿ ಹರಸಲಿ.","poem":2}]},{"type":"verse","number":173,"content":[{"text":"ನಾನು ನಿಮ್ಮ ಸೂತ್ರಗಳನ್ನು ಆರಿಸಿಕೊಂಡಿರುವುದರಿಂದ,","poem":1},{"text":"ನಿಮ್ಮ ಕೈ ನನಗೆ ನೆರವಾಗಲಿ.","poem":2}]},{"type":"verse","number":174,"content":[{"text":"ಯೆಹೋವ ದೇವರೇ, ನಾನು ನಿಮ್ಮ ರಕ್ಷಣೆಗಾಗಿ ಬಯಸುತ್ತಿದ್ದೇನೆ,","poem":1},{"text":"ನಿಮ್ಮ ನಿಯಮವೇ ನನಗೆ ಆನಂದವಾಗಿದೆ.","poem":2}]},{"type":"verse","number":175,"content":[{"text":"ನಿಮ್ಮನ್ನು ಸ್ತುತಿಸಲು ನಾನು ಬದುಕಿರಲಿ;","poem":1},{"text":"ನಿಮ್ಮ ನಿಯಮಗಳು ನನ್ನನ್ನು ಕಾಪಾಡಲಿ.","poem":2}]},{"type":"verse","number":176,"content":[{"text":"ತಪ್ಪಿಹೋದ ಕುರಿಯಂತೆ ನಾನು ದಾರಿತಪ್ಪಿದ್ದೇನೆ.","poem":1},{"text":"ನಿಮ್ಮ ಸೇವಕನಾದ ನನ್ನನ್ನು ಬಂದು ಹುಡುಕಿರಿ,","poem":2},{"lineBreak":true},{"text":"ಏಕೆಂದರೆ ನಿಮ್ಮ ಆಜ್ಞೆಗಳನ್ನು ನಾನು ಮರೆಯುವುದಿಲ್ಲ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kan_okcv/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/PSA/120.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":176}