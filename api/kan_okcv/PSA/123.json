{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"PSA","translationId":"kan_okcv","name":"ಕೀರ್ತನೆಗಳು","commonName":"ಕೀರ್ತನೆಗಳು","title":"ಕೀರ್ತನೆಗಳು","order":19,"numberOfChapters":150,"sha256":"8fda6557d2590d4e512d2801111ece4ef0438ce426c3b9b41fc862a02e5e2271","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kan_okcv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":123,"content":[{"type":"hebrew_subtitle","content":["ಯಾತ್ರಾ ಗೀತೆ."]},{"type":"verse","number":1,"content":[{"text":"ಪರಲೋಕದಲ್ಲಿ ಸಿಂಹಾಸನರಾಗಿರುವವರೇ,","poem":1},{"text":"ನಿಮ್ಮ ಕಡೆಗೆ ನನ್ನ ಕಣ್ಣುಗಳನ್ನು ಎತ್ತಿದ್ದೇನೆ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ಇಗೋ, ದಾಸರ ಕಣ್ಣುಗಳು ತಮ್ಮ ಯಜಮಾನರ ಕೈಯನ್ನು ನೋಡುವ ಪ್ರಕಾರ,","poem":1},{"text":"ಮತ್ತು ದಾಸಿಯ ಕಣ್ಣುಗಳು ತನ್ನ ಯಜಮಾನಿಯ ಕೈಯನ್ನೂ ನೋಡುವ ಪ್ರಕಾರ,","poem":2},{"text":"ನಮ್ಮ ಕಣ್ಣುಗಳು ನಮ್ಮ ಯೆಹೋವ ದೇವರು,","poem":1},{"text":"ನಮ್ಮನ್ನು ಕರುಣಿಸುವವರೆಗೆ ನಿರೀಕ್ಷೆಯಿಂದ ನೋಡುತ್ತಿರುವುದು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ನಮ್ಮನ್ನು ಕರುಣಿಸು, ಯೆಹೋವ ದೇವರೇ, ನಮ್ಮನ್ನು ಕರುಣಿಸು;","poem":1},{"text":"ಏಕೆಂದರೆ ನಾವು ಬಹಳವಾಗಿ ತಿರಸ್ಕಾರವನ್ನು ಅನುಭವಿಸಿದ್ದೇವೆ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ನಾವು ಸುಖಭೋಗಿಗಳ ಗೇಲಿಯನ್ನೂ","poem":1},{"text":"ಗರ್ವಿಷ್ಠರಿಂದ ತಿರಸ್ಕಾರವನ್ನೂ ಅನುಭವಿಸಿದ್ದೇವೆ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kan_okcv/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}