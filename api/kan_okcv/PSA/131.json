{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"PSA","translationId":"kan_okcv","name":"ಕೀರ್ತನೆಗಳು","commonName":"ಕೀರ್ತನೆಗಳು","title":"ಕೀರ್ತನೆಗಳು","order":19,"numberOfChapters":150,"sha256":"8fda6557d2590d4e512d2801111ece4ef0438ce426c3b9b41fc862a02e5e2271","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kan_okcv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":131,"content":[{"type":"hebrew_subtitle","content":["ದಾವೀದನ ಯಾತ್ರಾ ಗೀತೆ."]},{"type":"verse","number":1,"content":[{"text":"ಯೆಹೋವ ದೇವರೇ, ನನ್ನ ಹೃದಯವು ಗರ್ವದ್ದಲ್ಲ,","poem":1},{"text":"ನನಗೆ ಸೊಕ್ಕಿನ ಕಣ್ಣಿಲ್ಲ","poem":2},{"text":"ದೊಡ್ಡ ವಿಷಯಗಳಲ್ಲಿಯೂ ನನಗೆ ನಿಲುಕಲಾರದವುಗಳಲ್ಲಿಯೂ","poem":1},{"text":"ನಾನು ಕೈ ಹಾಕುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ಆದರೆ ಹಾಲುಬಿಡಿಸಿದ ಕೂಸು ತನ್ನ ತಾಯಿಯ ಮಡಿಲಲ್ಲಿರುವಂತೆ","poem":1},{"text":"ನನ್ನ ಪ್ರಾಣವನ್ನು ಸಮಾಧಾನ ಪಡಿಸಿದ್ದೇನೆ.","poem":2},{"lineBreak":true},{"text":"ನಾನು ತಾಯಿಯ ಮಡಿಲಲ್ಲಿರುವ ಕೂಸಿನಂತೆ ಸಂತೃಪ್ತಿಯಿಂದ ಇದ್ದೇನೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ಇಸ್ರಾಯೇಲೇ, ಯೆಹೋವ ದೇವರಲ್ಲಿ ನಿನ್ನ ನಿರೀಕ್ಷೆಯನ್ನಿಡು.","poem":1},{"text":"ಈಗಲೂ, ಎಂದೆಂದಿಗೂ ನಿರೀಕ್ಷೆಯಿಂದಿರು.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kan_okcv/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}