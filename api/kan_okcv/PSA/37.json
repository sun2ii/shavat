{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"PSA","translationId":"kan_okcv","name":"ಕೀರ್ತನೆಗಳು","commonName":"ಕೀರ್ತನೆಗಳು","title":"ಕೀರ್ತನೆಗಳು","order":19,"numberOfChapters":150,"sha256":"8fda6557d2590d4e512d2801111ece4ef0438ce426c3b9b41fc862a02e5e2271","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kan_okcv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":37,"content":[{"type":"hebrew_subtitle","content":["ದಾವೀದನ ಕೀರ್ತನೆ."]},{"type":"verse","number":1,"content":[{"text":"ಕೆಟ್ಟವರನ್ನು ನೋಡಿ ಕೋಪಿಸಿಕೊಳ್ಳಬೇಡ.","poem":1},{"text":"ಇಲ್ಲವೆ ಅಕ್ರಮ ಮಾಡುವವರ ಬಗ್ಗೆ ಹೊಟ್ಟೆಕಿಚ್ಚುಪಡಬೇಡ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ಏಕೆಂದರೆ, ಅವರು ಹುಲ್ಲಿನ ಹಾಗೆ ಬೇಗ ಒಣಗಿ ಹೋಗುವರು.","poem":1},{"text":"ಹಸಿರಾದ ಸೊಪ್ಪಿನ ಹಾಗೆ ಬಾಡಿಹೋಗುವರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ಯೆಹೋವ ದೇವರಲ್ಲಿ ಭರವಸೆ ಇಟ್ಟು ಒಳ್ಳೆಯದನ್ನು ಮಾಡು;","poem":1},{"text":"ಆಗ ದೇಶದಲ್ಲಿ ವಾಸಮಾಡಿ ಹಸಿರುಗಾವಲನ್ನು ಅನುಭವಿಸುವಿ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ಯೆಹೋವ ದೇವರಲ್ಲಿ ಆನಂದವಾಗಿರು;","poem":1},{"text":"ಆಗ ಅವರು ನಿನ್ನ ಹೃದಯದ ಅಪೇಕ್ಷೆಗಳನ್ನು ಈಡೇರಿಸುವರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ನಿನ್ನ ಮಾರ್ಗವನ್ನು ಯೆಹೋವ ದೇವರಿಗೆ ಒಪ್ಪಿಸು;","poem":1},{"text":"ಅವರಲ್ಲಿ ಭರವಸೆ ಇಡು; ಅವರು ನಿನಗೆ ಇದನ್ನು ಮಾಡುವರು:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ಅವರು ನಿನ್ನ ನೀತಿಯನ್ನು ಉದಯದ ಬೆಳಕಿನ ಹಾಗೆ ಮಾಡುವರು,","poem":1},{"text":"ಅವರು ನಿನ್ನ ನ್ಯಾಯವನ್ನು ಮಧ್ಯಾಹ್ನದ ಸೂರ್ಯನ ಹಾಗೆ ಹೊಳೆಯುವಂತೆ ಮಾಡುವರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ಯೆಹೋವ ದೇವರ ಮುಂದೆ ಶಾಂತನಾಗಿರು;","poem":1},{"text":"ಮೌನವಾಗಿದ್ದು ಅವರಿಗಾಗಿ ಎದುರು ನೋಡು;","poem":2},{"text":"ತಮ್ಮ ಮಾರ್ಗದಲ್ಲಿ ಸಫಲವಾಗುವವರನ್ನು ಕಂಡು ಸಿಡುಕಬೇಡ.","poem":1},{"text":"ಕುಯುಕ್ತಿಗಳನ್ನು ನಡೆಸುವ ಮನುಷ್ಯರನ್ನು ಕಂಡು ಕೋಪ ಮಾಡಿಕೊಳ್ಳಬೇಡ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ಕೋಪವನ್ನು ಅಡಗಿಸು ಮತ್ತು ರೋಷವನ್ನು ಬಿಡು.","poem":1},{"text":"ಸಿಡುಕಬೇಡ, ಅದು ಕೆಟ್ಟತನಕ್ಕೆ ನಡೆಸುತ್ತದೆ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ಏಕೆಂದರೆ, ದುರ್ಮಾರ್ಗಿಗಳು ನಾಶವಾಗುವರು;","poem":1},{"text":"ಯೆಹೋವ ದೇವರನ್ನು ನಿರೀಕ್ಷಿಸುವವರೇ ಭೂಮಿಯನ್ನು ಸ್ವಾಧೀನಮಾಡಿಕೊಳ್ಳುವರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ಇನ್ನು ಸ್ವಲ್ಪ ಸಮಯದಲ್ಲಿ ದುಷ್ಟನು ಕಾಣದೆ ಹೋಗುವನು.","poem":1},{"text":"ಅವನನ್ನು ಹುಡುಕಿದರೂ ಸಿಕ್ಕುವುದೇ ಇಲ್ಲ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ಆದರೆ ಸಾತ್ವಿಕರು ಭೂಮಿಯನ್ನು ಸ್ವಾಧೀನಮಾಡಿಕೊಳ್ಳುವರು.","poem":1},{"text":"ದೀನರು ಬಹಳ ಸಮಾಧಾನವನ್ನೂ ಸಮೃದ್ಧಿಯನ್ನು ಅನುಭವಿಸುವರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ದುಷ್ಟನು ನೀತಿವಂತನಿಗಾಗಿ ಒಳಸಂಚು ಮಾಡುತ್ತಾನೆ,","poem":1},{"text":"ಆದರೆ ಅವನನ್ನು ಕಂಡು ಹಲ್ಲು ಕಡಿಯುತ್ತಾನೆ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ದುಷ್ಟನ ದಿವಸ ಬರುತ್ತದೆಂದು ತಿಳಿದು","poem":1},{"text":"ಯೆಹೋವ ದೇವರು ನಗುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ದುಷ್ಟರು ಬಡವನನ್ನೂ ದೀನನನ್ನೂ ಬೀಳಿಸಬೇಕೆಂದು","poem":1},{"text":"ಖಡ್ಗವನ್ನು ಹಿರಿದಿದ್ದಾರೆ,","poem":2},{"text":"ಸನ್ಮಾರ್ಗದವರನ್ನು ಕೊಲ್ಲುವುದಕ್ಕೂ","poem":1},{"text":"ತಮ್ಮ ಬಿಲ್ಲುಗಳನ್ನು ಬಗ್ಗಿಸಿದ್ದಾರೆ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ಆದರೆ ಅವರ ಖಡ್ಗ ಅವರ ಹೃದಯದಲ್ಲಿ ಇರಿದು ಬಿಡುವುದು;","poem":1},{"text":"ಅವರ ಬಿಲ್ಲುಗಳು ಮುರಿದುಹೋಗುವವು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ದುಷ್ಟರ ಐಶ್ವರ್ಯಕ್ಕಿಂತ","poem":1},{"text":"ನೀತಿವಂತರ ಅಲ್ಪವೇ ಲೇಸು.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ಏಕೆಂದರೆ ದುಷ್ಟರ ತೋಳುಗಳು ಮುರಿದುಹೋಗುವವು,","poem":1},{"text":"ಆದರೆ ನೀತಿವಂತರನ್ನು ಯೆಹೋವ ದೇವರು ಉದ್ಧಾರ ಮಾಡುವರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ನಿರ್ದೋಷಿಗಳು ತಮ್ಮ ದಿವಸಗಳನ್ನು ಯೆಹೋವ ದೇವರ ಪರಾಮರಿಕೆಯಲ್ಲಿ ಕಳೆಯುವರು.","poem":1},{"text":"ನಿರಪರಾಧಿಯ ಬಾಧ್ಯತೆಯು ಯುಗಯುಗಕ್ಕೂ ಇರುವುದು.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ಆಪತ್ಕಾಲದಲ್ಲಿ ಅವರು ಕುಂದುವುದಿಲ್ಲ;","poem":1},{"text":"ಕ್ಷಾಮದ ದಿವಸಗಳಲ್ಲಿ ಸಮೃದ್ಧಿಯನ್ನು ಅನುಭವಿಸುವರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ಆದರೆ ದುಷ್ಟರು ನಾಶವಾಗುವರು;","poem":1},{"text":"ಯೆಹೋವ ದೇವರ ಶತ್ರುಗಳು ಗದ್ದೆಯ ಹೂಗಳಂತೆ ಬಾಡಿಹೋಗುವರು;","poem":2},{"lineBreak":true},{"text":"ಹೊಗೆಯಂತೆ ಮಾಯವಾಗುವರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ದುಷ್ಟನು ಸಾಲ ಮಾಡಿ ಹಿಂದಿರುಗಿ ಕೊಡದೆ ಹೋಗುವನು.","poem":1},{"text":"ಆದರೆ ನೀತಿವಂತನು ಧಾರಾಳವಾಗಿ ಕೊಡುತ್ತಾನೆ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ಯೆಹೋವ ದೇವರು ಆಶೀರ್ವದಿಸುವವರು,","poem":1},{"text":"ಭೂಮಿಯನ್ನು ಸ್ವಾಧೀನಪಡಿಸಿಕೊಳ್ಳುವರು;","poem":2},{"lineBreak":true},{"text":"ಆದರೆ ದೇವರ ಶಾಪಕ್ಕೆ ಗುರಿಯಾಗುವವರು ನಾಶವಾಗುವರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ಯೆಹೋವ ದೇವರಲ್ಲಿ ಯಾರು ಹರ್ಷಿಸುತ್ತಾರೋ","poem":1},{"text":"ಅವರ ಹೆಜ್ಜೆಗಳನ್ನು ಸ್ಥಿರಪಡಿಸುವರು.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ಅವನು ಎಡವಿದರೂ ಬಿದ್ದುಹೋಗುವುದಿಲ್ಲ.","poem":1},{"text":"ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ತಾವೇ ತಮ್ಮ ಕೈಯಿಂದ ಅವನನ್ನು ಎತ್ತಿಹಿಡಿಯುವರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ನಾನು ಬಾಲಕನಾಗಿದ್ದೆನು, ಈಗ ಮುದುಕನಾಗಿದ್ದೇನೆ;","poem":1},{"text":"ಆದರೆ ನೀತಿವಂತನು ಕೈಬಿಟ್ಟಿರುವುದನ್ನಾಗಲಿ","poem":2},{"lineBreak":true},{"text":"ಅವನ ಸಂತತಿಯು ರೊಟ್ಟಿಗಾಗಿ ಭಿಕ್ಷೆ ಬೇಡುವುದನ್ನಾಗಲಿ ಎಂದೂ ನಾನು ನೋಡಲಿಲ್ಲ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ಅವರು ಯಾವಾಗಲೂ ಧಾರಾಳವಾಗಿ ಸಾಲ ಕೊಡುತ್ತಾರೆ;","poem":1},{"text":"ನೀತಿವಂತನ ಸಂತತಿಯವರು ಆಶೀರ್ವಾದ ಹೊಂದುವರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ಕೇಡಿನಿಂದ ತೊಲಗಿ ಒಳ್ಳೆಯದನ್ನು ಮಾಡು,","poem":1},{"text":"ಆಗ ಯುಗಯುಗಕ್ಕೂ ನಾಡಿನಲ್ಲಿ ವಾಸಮಾಡುವೆ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ಏಕೆಂದರೆ ಯೆಹೋವ ದೇವರು ನ್ಯಾಯವನ್ನು ಪ್ರೀತಿಸುತ್ತಾರೆ;","poem":1},{"text":"ತಮ್ಮ ನಂಬಿಗಸ್ತ ಜನರನ್ನು ತೊರೆದುಬಿಡರು.","poem":2},{"lineBreak":true},{"text":"ನೀತಿವಂತರು ಸದಾಕಾಲಕವೂ ಸುರಕ್ಷಿತರಾಗಿರುವರು;","poem":1},{"text":"ಆದರೆ ದುಷ್ಟರ ಸಂತತಿಯು ಅಳಿದುಹೋಗುವುದು.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ನೀತಿವಂತರು ಭೂಮಿಯನ್ನು ಸ್ವಾಧೀನಮಾಡಿಕೊಂಡು","poem":1},{"text":"ಎಂದೆಂದಿಗೂ ಅದರಲ್ಲಿ ವಾಸವಾಗಿರುವರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"ನೀತಿವಂತನ ಬಾಯಿ ಜ್ಞಾನವನ್ನು ನುಡಿಯುವುದು;","poem":1},{"text":"ಅವನ ನಾಲಿಗೆ ನ್ಯಾಯವನ್ನು ಮಾತನಾಡುವುದು.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ಅವನ ದೇವರ ನಿಯಮವೂ ಅವನ ಹೃದಯದಲ್ಲಿ ಇದೆ;","poem":1},{"text":"ಅವನ ಹೆಜ್ಜೆ ಕದಲುವುದಿಲ್ಲ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"ದುಷ್ಟನು ನೀತಿವಂತನಿಗಾಗಿ ಒಳಸಂಚು ಮಾಡುತ್ತಾನೆ;","poem":1},{"text":"ಅವನನ್ನು ಕೊಲ್ಲಲು ಹುಡುಕುತ್ತಾನೆ.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ಆದರೆ ಯೆಹೋವ ದೇವರು ಅವನನ್ನು ದುಷ್ಟನ ಕೈಯಲ್ಲಿ ಬಿಡುವುದಿಲ್ಲ;","poem":1},{"text":"ನ್ಯಾಯ ವಿಚಾರಣೆಯಲ್ಲಿ ನೀತಿವಂತನನ್ನು ಅಪರಾಧಿಯೆಂದು ತೀರ್ಪು ಕೊಡುವುದಿಲ್ಲ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"ಯೆಹೋವ ದೇವರನ್ನು ನಿರೀಕ್ಷಿಸು;","poem":1},{"text":"ಅವರ ಮಾರ್ಗದಲ್ಲಿ ನಡೆ;","poem":2},{"text":"ಆಗ ಭೂಮಿಯನ್ನು ಸ್ವಾಧೀನ ಮಾಡಿಕೊಳ್ಳುವಂತೆ ನಿನ್ನನ್ನು ಅವರು ಉನ್ನತಕ್ಕೆ ತರುವರು;","poem":1},{"text":"ದುಷ್ಟರ ವಿನಾಶವನ್ನು ನೀವು ಕಾಣುವಿರಿ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"ದುಷ್ಟರು ದೊಡ್ಡ ಅಧಿಕಾರದಲ್ಲಿರುವುದನ್ನು ನಾನು ಕಂಡೆನು;","poem":1},{"text":"ಅವರು ಹಸಿರಾಗಿ ವಿಸ್ತರಿಸಿಕೊಂಡ ಮರದ ಹಾಗೆ ಇದ್ದರು.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ಆದರೆ ಅವರು ಅಳಿದೇ ಹೋದರು;","poem":1},{"text":"ಅವರನ್ನು ಹುಡುಕಿದೆನು; ಆದರೆ ಅವರು ಸಿಕ್ಕಲಿಲ್ಲ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"ನಿರ್ದೋಷಿಯನ್ನು ಗಮನಿಸು;","poem":1},{"text":"ಯಥಾರ್ಥನನ್ನು ನೋಡು;","poem":2},{"lineBreak":true},{"text":"ಸಮಾಧಾನ ಹುಡುಕುವವರಿಗೆ ಒಳ್ಳೆಯ ಭವಿಷ್ಯವಿದೆ.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"ಆದರೆ ದ್ರೋಹಿಗಳೆಲ್ಲರೂ ನಾಶವಾಗುವರು;","poem":1},{"text":"ದುಷ್ಟರಿಗೆ ಒಳ್ಳೆಯ ಭವಿಷ್ಯವಿಲ್ಲ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"ನೀತಿವಂತರ ರಕ್ಷಣೆಯು ಯೆಹೋವ ದೇವರಿಂದಲೇ;","poem":1},{"text":"ಇಕ್ಕಟ್ಟಿನ ಕಾಲದಲ್ಲಿ ದೇವರೇ ಅವರ ಕೋಟೆ.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"ಯೆಹೋವ ದೇವರು ಅವರಿಗೆ ಸಹಾಯಮಾಡಿ ಅವರನ್ನು ಬಿಡಿಸುವರು.","poem":1},{"text":"ದುಷ್ಟರಿಂದ ಅವರನ್ನು ತಪ್ಪಿಸಿ ಬಿಡಿಸುವರು.","poem":2},{"lineBreak":true},{"text":"ಏಕೆಂದರೆ ಅವರು ದೇವರಲ್ಲಿ ಆಶ್ರಯ ಪಡೆದಿದ್ದಾರೆ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kan_okcv/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}