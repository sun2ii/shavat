{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"PSA","translationId":"kan_okcv","name":"ಕೀರ್ತನೆಗಳು","commonName":"ಕೀರ್ತನೆಗಳು","title":"ಕೀರ್ತನೆಗಳು","order":19,"numberOfChapters":150,"sha256":"8fda6557d2590d4e512d2801111ece4ef0438ce426c3b9b41fc862a02e5e2271","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kan_okcv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":68,"content":[{"type":"hebrew_subtitle","content":["ಸಂಗೀತ ನಿರ್ದೇಶಕನಿಗಾಗಿರುವ ಕೀರ್ತನೆ. ದಾವೀದನ ಕೀರ್ತನೆ. ಒಂದು ಗೀತೆ."]},{"type":"verse","number":1,"content":[{"text":"ದೇವರು ಕ್ರಿಯಾಶೀಲರಾಗಲಿ. ಅವರ ಶತ್ರುಗಳು ಚದರಿಹೋಗಲಿ.","poem":1},{"text":"ದೇವರನ್ನು ವಿರೋಧಿಸುವವರು ಅವರ ಸಮ್ಮುಖದಿಂದ ಓಡಿಹೋಗಲಿ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ಗಾಳಿಯಿಂದ ಹೊಗೆ ಹಾರಿಹೋಗುವಂತೆ ಅವರು ಹಾರಿಹೋಗಲಿ.","poem":1},{"text":"ಮೇಣವು ಬೆಂಕಿಯ ಮುಂದೆ ಕರಗುವಂತೆ,","poem":2},{"lineBreak":true},{"text":"ದುಷ್ಟರು ದೇವರ ಮುಂದೆ ನಾಶವಾಗಲಿ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ಆದರೆ ನೀತಿವಂತರು ಸಂತೋಷಿಸಲಿ.","poem":1},{"text":"ದೇವರ ಮುಂದೆ ಉಲ್ಲಾಸಪಡಲಿ.","poem":2},{"lineBreak":true},{"text":"ಹೌದು, ಅವರು ಹರ್ಷಾನಂದರಾಗಲಿ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ದೇವರಿಗೆ ಹಾಡಿರಿ, ದೇವರ ಹೆಸರಿಗೆ ಸ್ತುತಿಗಳನ್ನು ಹಾಡಿರಿ.","poem":1},{"text":"ಮೇಘಾರೂಢರಾಗಿರುವ ದೇವರನ್ನು ಕೊಂಡಾಡಿರಿ.","poem":2},{"lineBreak":true},{"text":"ಅವರ ಹೆಸರು ಯೆಹೋವ ದೇವರು, ಅವರ ಮುಂದೆ ಉಲ್ಲಾಸಪಡಿರಿ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ದೇವರು ತಮ್ಮ ಪರಿಶುದ್ಧ ಸ್ಥಳದಲ್ಲಿ ದಿಕ್ಕಿಲ್ಲದವರಿಗೆ ತಂದೆ,","poem":1},{"text":"ವಿಧವೆಯರಿಗೆ ರಕ್ಷಕರಾಗಿದ್ದಾರೆ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ದೇವರು ಒಂಟಿಗರನ್ನು ಕುಟುಂಬಸ್ತರನ್ನಾಗಿ ಮಾಡುತ್ತಾರೆ.","poem":1},{"text":"ಸೆರೆಯವರನ್ನು ಹರ್ಷಗೊಳಿಸಿ ಬಿಡುಗಡೆ ಮಾಡುತ್ತಾರೆ.","poem":2},{"lineBreak":true},{"text":"ಆದರೆ ಎದುರು ಬೀಳುವವರು ಒಣಭೂಮಿಯಲ್ಲಿ ವಾಸಿಸುತ್ತಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ದೇವರೇ, ನೀವು ನಿಮ್ಮ ಜನರ ಮುಂದೆ ಹೊರಟು","poem":1},{"text":"ಕಾಡಿನಲ್ಲಿ ನಡೆದಾಗ,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ಭೂಮಿಯು ಕದಲಿತು, ಆಕಾಶಗಳು ಸಹ ನಿಮ್ಮ ಮುಂದೆ ಮಳೆಗರೆದವು.","poem":1},{"text":"ಇಸ್ರಾಯೇಲರ ದೇವರ ಮುಂದೆ, ಹೌದು,","poem":2},{"lineBreak":true},{"text":"ದೇವರ ಮುಂದೆಯೇ ಸೀನಾಯಿ ಸಹ ಕದಲಿತು.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ದೇವರೇ, ನೀವು ಹೇರಳವಾಗಿ ಮಳೆಯನ್ನು ಸುರಿಸಿ,","poem":1},{"text":"ದಣಿದ ನಿಮ್ಮ ಬಾಧ್ಯತೆಯನ್ನು ನೀವು ಉತ್ಸಾಹಪಡಿಸಿದಿರಿ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ನಿಮ್ಮ ಪ್ರಜೆಗಳು ಅದರಲ್ಲಿ ವಾಸಮಾಡಿದರು.","poem":1},{"text":"ದೇವರೇ, ನಿಮ್ಮ ಒಳ್ಳೆಯತನದಿಂದ ಬಡವರಿಗೋಸ್ಕರ ಒದಗಿಸಿದ್ದೀರಿ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ಯೆಹೋವ ದೇವರು ವಾಕ್ಯವನ್ನು ಕೊಟ್ಟರು.","poem":1},{"text":"ಆ ವಾಕ್ಯವನ್ನು ಹೀಗೆಂದು ಪ್ರಕಟಿಸಿದ ಮಹಿಳೆಯರ ಗುಂಪು ದೊಡ್ಡದಾಗಿತ್ತು:","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“ಸೈನ್ಯದೊಡನೆ ಅರಸರು ಓಡಿಹೋದರು.","poem":1},{"text":"ಪಾಳೆಯದಲ್ಲಿರುವ ಮಹಿಳೆಯರು ಕೊಳ್ಳೆಯನ್ನು ಹಂಚಿಕೊಳ್ಳುವರು.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ನೀವು ಪಾಳೆಯದ ಬೆಂಕಿಯ","poem":1},{"noteId":15},{"text":"ಬಳಿ ಮಲಗಿದರೂ,","poem":1},{"text":"ಪಾರಿವಾಳದ ರೆಕ್ಕೆಗಳು ಬೆಳ್ಳಿಯಿಂದಲೂ,","poem":2},{"lineBreak":true},{"text":"ಅದರ ಗರಿಗಳು ಬಂಗಾರದಿಂದಲೂ ಹೊಳೆಯುವಂತಿರುವಿರಿ.”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ಸರ್ವಶಕ್ತರಾದ ದೇವರು ಅರಸರನ್ನು ಅಲ್ಲಿ ಚದರಿಸಿದಾಗ","poem":1},{"text":"ಸಲ್ಮೋನಿನಲ್ಲಿ ಬಿಳೀ ಹಿಮ ಬಿದ್ದಂತಿತ್ತು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ಬಾಷಾನ್ ಬೆಟ್ಟವು ದೇವರ ಬೆಟ್ಟದಂತೆ ಇದೆ;","poem":1},{"text":"ಬಾಷಾನ್ ಬೆಟ್ಟವು ಉನ್ನತ ಬೆಟ್ಟವಾಗಿದೆ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ಉನ್ನತ ಬೆಟ್ಟಗಳೇ, ಏಕೆ ಕುಣಿಯುತ್ತೀರಿ?","poem":1},{"text":"ದೇವರು ನಿವಾಸಕ್ಕಾಗಿ ಅಪೇಕ್ಷಿಸುವ ಬೆಟ್ಟವು ಇದೇ ಹೌದು,","poem":2},{"lineBreak":true},{"text":"ಯೆಹೋವ ದೇವರು ಅದರಲ್ಲಿ ಸದಾಕಾಲವೂ ವಾಸಿಸುವರು.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ದೇವರಿಗೆ ಸಹಸ್ರಾರು ಮಾತ್ರವಲ್ಲ ಲಕ್ಷಾಂತರ ರಥಗಳು ಇವೆ.","poem":1},{"text":"ಕರ್ತ ಆಗಿರುವ ಯೆಹೋವ ದೇವರು ಅವುಗಳ ಸಮೇತವಾಗಿ","poem":2},{"lineBreak":true},{"text":"ಸೀನಾಯಿ ಬೆಟ್ಟದಲ್ಲಿದ್ದ ಹಾಗೆ ಪವಿತ್ರಾಲಯದಲ್ಲಿದ್ದಾರೆ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ನೀವು ಅನೇಕ ಸೆರೆಯವರ ಹಿಡಿದುಕೊಂಡು ಉನ್ನತಕ್ಕೆ ಹೋದಾಗ,","poem":1},{"text":"ಯೆಹೋವ ದೇವರು ತಿರುಗಿಬೀಳುವವರ ಮಧ್ಯದಲ್ಲಿ ಸಹ ನಿವಾಸಿಸುವಂತೆ","poem":2},{"lineBreak":true},{"text":"ಆ ತಿರುಗಿಬಿದ್ದ ಮನುಷ್ಯರಿಂದ ದಾನಗಳನ್ನು ಅಂಗೀಕರಿಸಿದ್ದೀರಿ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ಪ್ರತಿದಿನವೂ ನಮ್ಮ ಭಾರವನ್ನು ಹೊರುವ ಕರ್ತದೇವರಿಗೆ ಸ್ತೋತ್ರ.","poem":1},{"text":"ನಮ್ಮನ್ನು ರಕ್ಷಿಸುವ ದೇವರು ಸ್ತುತಿಹೊಂದಲಿ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ನಮ್ಮ ದೇವರು ರಕ್ಷಣೆಯ ದೇವರಾಗಿದ್ದಾರೆ.","poem":1},{"text":"ಸಾರ್ವಭೌಮ ಯೆಹೋವ ದೇವರು ಮರಣದಿಂದ ಬಿಡುಗಡೆ ಮಾಡುತ್ತಾರೆ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ದೇವರು ತಮ್ಮ ಶತ್ರುಗಳ ತಲೆಯನ್ನೂ,","poem":1},{"text":"ತನ್ನ ಅಪರಾಧಗಳಲ್ಲಿ ಇನ್ನೂ ಮುಂದುವರಿಯುವವರ ಕೂದಲುಳ್ಳ ಮಂಡೆಯನ್ನೂ ಗಾಯಮಾಡುವರು.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ಯೆಹೋವ ದೇವರು ಹೀಗೆ ಹೇಳುತ್ತಾರೆ,","poem":1},{"text":"“ಬಾಷಾನಿನಿಂದ ಅವರನ್ನು ತಿರುಗಿ ಬರಮಾಡುವೆನು;","poem":2},{"lineBreak":true},{"text":"ಸಮುದ್ರದ ಅಗಾಧಗಳಿಂದ ಜನರನ್ನು ತಿರುಗಿ ಬರಮಾಡುವೆನು.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ಆಗ ನಿಮ್ಮ ಪಾದಗಳು ನಿಮ್ಮ ವೈರಿಗಳ ರಕ್ತದ ಮೇಲಿರಲಿ.","poem":1},{"text":"ನಾಯಿಗಳು ಅದನ್ನು ನೆಕ್ಕಲಿ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ದೇವರೇ, ನಿಮ್ಮ ಮೆರವಣಿಗೆಯು ಪ್ರಕಟವಾಗಿದೆ.","poem":1},{"text":"ನನ್ನ ಅರಸರಾಗಿರುವ ದೇವರ ಮೆರವಣಿಗೆಯು ಪರಿಶುದ್ಧ ಸ್ಥಳವನ್ನು ಪ್ರವೇಶಿಸುವುದು.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ಹಾಡುವವರು ಮುಂದಾಗಿಯೂ, ಬಾರಿಸುವವರು ಹಿಂದಾಗಿಯೂ,","poem":1},{"text":"ದಮ್ಮಡಿ ಬಡಿಯುವ ಕನ್ಯೆಯರು ಮಧ್ಯದಲ್ಲಿಯೂ ಹಿಂಬಾಲಿಸುವರು.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ಮಹಾಸಭೆಯಲ್ಲಿ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.","poem":1},{"text":"ಇಸ್ರಾಯೇಲರ ಸಮೂಹದವರಲ್ಲಿ ಯೆಹೋವ ದೇವರನ್ನು ಸ್ತುತಿಸಿರಿ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ಬೆನ್ಯಾಮೀನನ ಚಿಕ್ಕ ಗೋತ್ರವು ಅವರನ್ನು ನಡೆಸುವುದು.","poem":1},{"text":"ಯೆಹೂದದ ಪ್ರಧಾನರೂ,","poem":2},{"lineBreak":true},{"text":"ಜೆಬುಲೂನನ ಪ್ರಧಾನರೂ ನಫ್ತಾಲಿಯ ಪ್ರಧಾನರೂ ಅಲ್ಲಿ ಇದ್ದಾರೆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ದೇವರೇ, ನಿಮ್ಮ ಶಕ್ತಿಯನ್ನು ಪ್ರಕಟಿಸಿರಿ, ಮೊದಲು ಮಾಡಿದಂತೆಯೇ","poem":1},{"text":"ಈಗಲೂ ನಿಮ್ಮ ಸಾಮರ್ಥ್ಯವನ್ನು ಪ್ರದರ್ಶಿಸಿರಿ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ಯೆರೂಸಲೇಮಿನ ನಿಮ್ಮ ಮಂದಿರದ ನಿಮಿತ್ತ","poem":1},{"text":"ಅರಸರು ನಿಮಗೆ ಕಾಣಿಕೆಗಳನ್ನು ಸಮರ್ಪಿಸಲಿ.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ಆಪು ಹುಲ್ಲಿನ ಮಧ್ಯದಲ್ಲಿರುವ ಕಾಡುಮೃಗಗಳ ಹಾಗೆಯೂ","poem":1},{"text":"ಕರುಗಳ ಮಧ್ಯದಲ್ಲಿರುವ ಹೋರಿಗಳ ಹಾಗೆಯೂ ಇರುವ ಜನಾಂಗವನ್ನು ಗದರಿಸಿರಿ.","poem":2},{"text":"ಮೃಗದಂಥವರು ತಗ್ಗಿಸಿಕೊಂಡು ಬೆಳ್ಳಿ ಗಟ್ಟಿಗಳನ್ನು ನಿಮಗೆ ತರಲಿ.","poem":1},{"text":"ಆದರೆ ಯುದ್ಧದಲ್ಲಿ ಆನಂದಿಸುವ ರಾಷ್ಟ್ರಗಳನ್ನು ಚದರಿಸಿರಿ.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ಈಜಿಪ್ಟಿನಿಂದ ರಾಯಭಾರಿಗಳು ಬರುವರು.","poem":1},{"text":"ಕೂಷ್ ದೇಶದವರು ತಾವಾಗಿಯೇ ಬಂದು ದೇವರಿಗೆ ಅಧೀನವಾಗುವರು.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"ಭೂಮಿಯ ರಾಜ್ಯಗಳೇ, ದೇವರಿಗೆ ಹಾಡಿರಿ.","poem":1},{"text":"ಯೆಹೋವ ದೇವರನ್ನು ಕೀರ್ತಿಸಿರಿ.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ಪೂರ್ವದ ಆಕಾಶಗಳಲ್ಲಿ ಸವಾರಿ ಮಾಡುವ ದೇವರಿಗೆ ಹಾಡಿರಿ.","poem":1},{"text":"ದೇವರ ಸ್ವರವು ಗುಡುಗಿನಂತೆ ಇರುವುದು.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ದೇವರ ಶಕ್ತಿಯನ್ನು ಘೋಷಿಸಿರಿ.","poem":1},{"text":"ಇಸ್ರಾಯೇಲರ ಮೇಲೆ ಅವರ ಪ್ರಭಾವವಿರುತ್ತದೆ.","poem":2},{"lineBreak":true},{"text":"ಮೇಘಗಳಲ್ಲಿ ಅವರ ಶಕ್ತಿಯು ಇರುತ್ತದೆ.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ದೇವರೇ, ನಿಮ್ಮ ಪರಿಶುದ್ಧ ಸ್ಥಳದಲ್ಲಿ ನೀವು ಅತಿಶಯವಾಗಿದ್ದೀರಿ.","poem":1},{"text":"ಇಸ್ರಾಯೇಲರ ದೇವರೇ ಜನರಿಗೆ ಬಲವನ್ನೂ ಶಕ್ತಿಯನ್ನೂ ಕೊಡುವರು.","poem":2},{"lineBreak":true},{"text":"ದೇವರಿಗೆ ಸ್ತುತಿಯಾಗಲಿ.","poem":1}]}],"footnotes":[{"noteId":15,"caller":"+","text":"ಪಾಳೆಯದ ಬೆಂಕಿಯ ಕೆಲವು ಪ್ರತಿಗಳಲ್ಲಿ ಕುರಿಹಟ್ಟಿ","reference":{"chapter":68,"verse":13}}]},"thisChapterLink":"/api/kan_okcv/PSA/68.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":35}