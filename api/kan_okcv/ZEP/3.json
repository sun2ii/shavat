{"translation":{"id":"kan_okcv","name":"Biblica® ಉಚಿತ ಕನ್ನಡ ಸಮಕಾಲಿಕ ಭಾಷಾಂತರ","website":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kanokcv","licenseNotes":null,"shortName":"OKCV","englishName":"Kanada Open Contemporary Version Bible","language":"kan","textDirection":"ltr","sha256":"579eda1a2f0787e978bfdd1e238e1f22be5be659c98add6930ad2d796778f705","availableFormats":["json"],"listOfBooksApiLink":"/api/kan_okcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31090,"languageName":"ಕನ್ನಡ","languageEnglishName":"Kannada"},"book":{"id":"ZEP","translationId":"kan_okcv","name":"ಚೆಫನ್ಯ","commonName":"ಚೆಫನ್ಯ","title":"ಚೆಫನ್ಯ","order":36,"numberOfChapters":3,"sha256":"b523a53b7ec28c4abc08d142b0d8a0176936bc9b269b4c1b08764037ca547cc2","firstChapterNumber":1,"firstChapterApiLink":"/api/kan_okcv/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/kan_okcv/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"heading","content":["ಯೆರೂಸಲೇಮಿನ ಭವಿಷ್ಯತ್ತು"]},{"type":"verse","number":1,"content":[{"text":"ಅಸಹ್ಯವಾದ, ಮೈಲಿಗೆಯಾದ,","poem":1},{"text":"ಶ್ರಮೆಪಡಿಸುವ ಪಟ್ಟಣಕ್ಕೆ ಕಷ್ಟ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ಅವಳು ಯಾರಿಗೂ ವಿಧೇಯಳಾಗಲಿಲ್ಲ;","poem":1},{"text":"ಶಿಕ್ಷೆಯನ್ನು ತೆಗೆದುಕೊಳ್ಳಲಿಲ್ಲ;","poem":2},{"text":"ಯೆಹೋವ ದೇವರಲ್ಲಿ ಭರವಸೆ ಇಡಲಿಲ್ಲ;","poem":1},{"text":"ತನ್ನ ದೇವರ ಸಮೀಪಕ್ಕೆ ಬರಲಿಲ್ಲ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ಅವಳ ಪ್ರಮುಖರು","poem":1},{"text":"ಗರ್ಜಿಸುವ ಸಿಂಹಗಳು.","poem":2},{"text":"ಅವಳ ನ್ಯಾಯಾಧಿಪತಿಗಳು ಸಂಜೆಯ ತೋಳಗಳು.","poem":1},{"text":"ಕಡಿಯುವುದಕ್ಕೆ ಎಲುಬನ್ನು ಕೂಡ ಮರುದಿನದವರೆಗೆ ಉಳಿಸವು.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ಅವಳ ಪ್ರವಾದಿಗಳು ಬಡಾಯಿ ಕೊಚ್ಚಿಕೊಳ್ಳುವವರೂ","poem":1},{"text":"ವಿಶ್ವಾಸದ್ರೋಹಿಗಳೂ ಆಗಿದ್ದಾರೆ.","poem":2},{"text":"ಅವಳ ಯಾಜಕರು ಪರಿಶುದ್ಧ ಸ್ಥಳವನ್ನು ಅಪವಿತ್ರಮಾಡುತ್ತಾರೆ,","poem":1},{"text":"ದೈವನಿಯಮವನ್ನು ಭಂಗಪಡಿಸುತ್ತಾರೆ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ನೀತಿಯುಳ್ಳ ಯೆಹೋವ ದೇವರು ಅವಳ ಮಧ್ಯದಲ್ಲಿ ಇದ್ದಾರೆ.","poem":1},{"text":"ಅವರು ಅನ್ಯಾಯ ಮಾಡುವುದಿಲ್ಲ;","poem":2},{"text":"ಪ್ರತಿ ಬೆಳಿಗ್ಗೆ ತಮ್ಮ ನ್ಯಾಯತೀರ್ಪನ್ನು ಬೆಳಕಿಗೆ ತರುತ್ತಾರೆ;","poem":1},{"text":"ಅವರು ತಪ್ಪುವವರಲ್ಲ.","poem":2},{"lineBreak":true},{"text":"ಆದರೆ ಅನ್ಯಾಯವಂತನು ನಾಚಿಕೆಯನ್ನು ಅರಿಯನು.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“ನಾನು ಜನಾಂಗಗಳನ್ನು ಕಡಿದು ಬಿಟ್ಟಿದ್ದೇನೆ.","poem":1},{"text":"ಅವುಗಳ ಗೋಪುರಗಳು ಹಾಳಾಗಿವೆ.","poem":2},{"text":"ಅವುಗಳ ಬೀದಿಗಳನ್ನು ಯಾರೂ ಹಾದುಹೋಗದ ಹಾಗೆ ಹಾಳುಮಾಡಿದ್ದೆನೆ.","poem":1},{"text":"ಅವುಗಳ ಪಟ್ಟಣಗಳು ನಾಶವಾದವು.","poem":2},{"text":"ಹೀಗೆ ಅಲ್ಲಿ ಯಾವನೂ ಇರುವುದಿಲ್ಲ;","poem":1},{"text":"ಯಾವ ಮನುಷ್ಯನೂ ಅಲ್ಲಿ ವಾಸಿಸುವುದೂ ಇಲ್ಲ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"‘ನಿಶ್ಚಯವಾಗಿ ನೀನು ನನಗೆ ಭಯಪಟ್ಟು","poem":1},{"text":"ಶಿಕ್ಷಣವನ್ನು ಹೊಂದುವೆ,’","poem":2},{"lineBreak":true},{"text":"ಹೀಗೆ ನಾನು ಅವರಿಗೆ ಶಿಕ್ಷೆ ವಿಧಿಸಿದರೂ","poem":2},{"text":"ಅವರ ನಿವಾಸವು ನಾಶವಾಗುವುದಿಲ್ಲ.","poem":1},{"text":"ಆದರೆ ಅವರು ಬೇಗನೆ ಎದ್ದು","poem":2},{"lineBreak":true},{"text":"ತಮ್ಮ ನಡತೆಯನ್ನೆಲ್ಲಾ ಕೆಡಿಸಿಕೊಂಡರು.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ಆದ್ದರಿಂದ ಯೆಹೋವ ದೇವರು ಹೀಗೆನ್ನುತ್ತಾರೆ:","poem":1},{"text":"ನಾನು ಬೇಟೆ ಹಿಡಿಯಲಿಕ್ಕೆ ಏಳುವ ದಿವಸದವರೆಗೂ ನನಗೆ ಕಾದುಕೊಳ್ಳಿರಿ.”","poem":2},{"text":"ಏಕೆಂದರೆ ಜನಾಂಗಗಳನ್ನು ಕೂಡಿಸುವುದಕ್ಕೂ","poem":1},{"text":"ರಾಜ್ಯಗಳನ್ನು ಒಟ್ಟು ಸೇರಿಸುವುದಕ್ಕೂ","poem":2},{"text":"ಅವುಗಳ ಮೇಲೆ ನನ್ನ ರೌದ್ರವನ್ನೂ","poem":1},{"text":"ನನ್ನ ಕೋಪದ ಎಲ್ಲಾ ಉರಿಯನ್ನೂ","poem":2},{"text":"ಹೊಯ್ಯುವುದಕ್ಕೂ ತೀರ್ಮಾನಿಸಿಕೊಂಡಿದ್ದೇನೆ.","poem":1},{"text":"ಏಕೆಂದರೆ ನನ್ನ ರೋಷದ ಬೆಂಕಿಯಿಂದ ಭೂಮಿಯೆಲ್ಲಾ ದಹಿಸಲಾಗುವುದು.","poem":2}]},{"type":"heading","content":["ಇಸ್ರಾಯೇಲಿನ ಅವಶೇಷಗಳ ಪುನಃಸ್ಥಾಪನೆ"]},{"type":"verse","number":9,"content":[{"text":"“ಆಗ ನಾನು ಜನರ ತುಟಿಗಳನ್ನು ಶುದ್ಧೀಕರಿಸುವೆನು.","poem":1},{"text":"ಅವರೆಲ್ಲರೂ ಯೆಹೋವ ದೇವರ ಹೆಸರಿನಿಂದ ಮೊರೆಯಿಡುವರು.","poem":2},{"lineBreak":true},{"text":"ಏಕಮನಸ್ಸಿನಿಂದ ಆತನಿಗೆ ಸೇವೆಮಾಡುವರು.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ಕೂಷಿನ ನದಿಗಳ ಆಚೆಯಿಂದ ನನ್ನ ಭಕ್ತರೂ ಚದರಿಹೋದ","poem":1},{"text":"ನನ್ನ ಜನರೂ ನನಗೆ ಕಾಣಿಕೆಗಳನ್ನು ತರುವರು.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ಆ ದಿವಸದಲ್ಲಿ ನೀನು ನನಗೆ ವಿರೋಧವಾಗಿ ಮಾಡಿದ","poem":1},{"text":"ದುಷ್ಕೃತ್ಯಗಳಿಗಾಗಿ ನಾಚಿಕೆಗೆ ಗುರಿಯಾಗುವುದಿಲ್ಲ;","poem":2},{"text":"ಏಕೆಂದರೆ ಆಗ ಗರ್ವದಿಂದ ಹೊಗಳಿಕೊಳ್ಳುವವರನ್ನು","poem":1},{"text":"ನಿನ್ನ ಮಧ್ಯದೊಳಗಿಂದ ತೆಗೆದುಹಾಕುವೆನು.","poem":2},{"text":"ನನ್ನ ಪರಿಶುದ್ಧ ಪರ್ವತದಲ್ಲಿ ಇನ್ನು ಮೇಲೆ","poem":1},{"text":"ನೀನು ಗರ್ವಪಡದೇ ಬಾಳುವೆ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ಆದರೆ ನಿನ್ನ ಮಧ್ಯದಲ್ಲಿ","poem":1},{"text":"ಸೌಮ್ಯರನ್ನೂ ದೀನರನ್ನೂ ಉಳಿಸುವೆನು.","poem":2},{"text":"ಇವರು ಯೆಹೋವ ದೇವರ ಹೆಸರಿನಲ್ಲಿ ನಂಬಿಕೆ ಇಡುವರು.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ಇಸ್ರಾಯೇಲಿನಲ್ಲಿ ಉಳಿದವರು","poem":1},{"text":"ಅನ್ಯಾಯ ಮಾಡರು; ಸುಳ್ಳಾಡರು,","poem":2},{"text":"ಅವರ ಬಾಯಲ್ಲಿ ಮೋಸವಿರದು.","poem":1},{"text":"ಅವರು ಮಂದೆಯಂತೆ ಮೇದು ಮಲಗುವರು.","poem":2},{"lineBreak":true},{"text":"ಅವರನ್ನು ಭಯಪಡಿಸುವವನು ಒಬ್ಬನೂ ಇರುವುದಿಲ್ಲ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ಚೀಯೋನಿನ ಪುತ್ರಿಯೇ, ಹಾಡು.","poem":1},{"text":"ಇಸ್ರಾಯೇಲೇ ಆರ್ಭಟಿಸು;","poem":2},{"text":"ಯೆರೂಸಲೇಮಿನ ಪುತ್ರಿಯೇ,","poem":1},{"text":"ಪೂರ್ಣಹೃದಯದಿಂದ ಸಂಭ್ರಮಿಸಿ ಉಲ್ಲಾಸಪಡು.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ಯೆಹೋವ ದೇವರು ನಿನ್ನ ಶಿಕ್ಷೆಗಳನ್ನು ದೂರಮಾಡಿ","poem":1},{"text":"ನಿನ್ನ ಶತ್ರುವನ್ನು ತೆಗೆದುಹಾಕಿದ್ದಾರೆ.","poem":2},{"text":"ಇಸ್ರಾಯೇಲಿನ ಅರಸನಾದ ಯೆಹೋವ ದೇವರು ನಿನ್ನ ಮಧ್ಯದಲ್ಲಿ ಇದ್ದಾರೆ.","poem":1},{"text":"ಇನ್ನು ಮೇಲೆ ನಿನಗೆ ಯಾವ ಕೇಡಿನ ಭಯವಿರುವುದಿಲ್ಲ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ಆ ದಿವಸದಲ್ಲಿ ಯೆರೂಸಲೇಮಿಗೆ ಹೀಗೆಂದು ಹೇಳುವರು,","poem":1},{"text":"“ಚೀಯೋನೇ, ನೀನು ಭಯಪಡಬೇಡ;","poem":2},{"lineBreak":true},{"text":"ನಿನ್ನ ಕೈಗಳು ಬಲಹೀನವಾಗದಿರಲಿ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ನಿನ್ನ ದೇವರಾದ ಯೆಹೋವ ದೇವರು ನಿನ್ನೊಂದಿಗಿದ್ದಾರೆ.","poem":1},{"text":"ನಿನ್ನನ್ನು ರಕ್ಷಿಸಲು ಶಕ್ತರಾಗಿದ್ದಾರೆ.","poem":2},{"text":"ನಿನ್ನಲ್ಲಿ ಬಹಳವಾಗಿ ಹರ್ಷಾನಂದಗೊಳ್ಳುವರು.","poem":1},{"text":"ತಮ್ಮ ಪ್ರೀತಿಯ ನಿಮಿತ್ತ ಅವರು ಇನ್ನು ಮುಂದೆ ನಿನ್ನನ್ನು ಖಂಡಿಸುವುದಿಲ್ಲ,","poem":2},{"lineBreak":true},{"text":"ಆದರೆ ಆನಂದ ಸ್ವರದಿಂದ ನಿನ್ನ ಮೇಲೆ ಉಲ್ಲಾಸಿಸುವರು.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“ನೇಮಕವಾದ ಹಬ್ಬಗಳ ನಷ್ಟಕ್ಕಾಗಿರುವ ನಿಮ್ಮ ದುಃಖವನ್ನು","poem":1},{"text":"ನಿಮ್ಮಿಂದ ನಾನು ತೆಗೆದುಬಿಡುವೆನು.","poem":2},{"lineBreak":true},{"text":"ಅವು ನಿನಗೆ ಭಾರವಾಗಿಯೂ ನಿಂದೆಯಾಗಿಯೂ ಇದ್ದವು.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ಆ ಕಾಲದಲ್ಲಿ","poem":1},{"text":"ನಿನ್ನನ್ನು ಪೀಡಿಸುವವರನ್ನೆಲ್ಲಾ ದಂಡಿಸುವೆನು,","poem":2},{"text":"ಕುಂಟಾದದ್ದನ್ನು ರಕ್ಷಿಸಿ,","poem":1},{"text":"ಚದರಿಹೋದವರನ್ನು ಕೂಡಿಸುವೆನು;","poem":2},{"text":"ಅವರು ಅವಮಾನ ಹೊಂದಿದ ದೇಶಗಳಲ್ಲೆಲ್ಲಾ","poem":1},{"text":"ಅವರಿಗೆ ಹೊಗಳಿಕೆಯನ್ನೂ ಕೀರ್ತಿಯನ್ನೂ ಉಂಟುಮಾಡುವೆನು.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ಆ ಕಾಲದಲ್ಲಿ ನಾನು ನಿಮ್ಮನ್ನು ಒಟ್ಟುಗೂಡಿಸುವೆನು.","poem":1},{"text":"ಆ ಸಮಯದಲ್ಲಿ ನಾನು ಮನೆಗೆ ನಿಮ್ಮನ್ನು ಕರೆದುಕೊಂಡು ಬರುವೆನು.","poem":2},{"text":"ನಾನು ನಿಮ್ಮ ಸೌಭಾಗ್ಯವನ್ನು","poem":1},{"text":"ನಿಮ್ಮ ಕಣ್ಣೆದುರಿಗೆ ಪುನಃಸ್ಥಾಪಿಸಿ","poem":2},{"text":"ಭೂಮಿಯ ಎಲ್ಲಾ ಜನರಲ್ಲಿ","poem":1},{"text":"ನಿಮಗೆ ಕೀರ್ತಿಯನ್ನೂ ಹೊಗಳಿಕೆಯನ್ನೂ ಉಂಟುಮಾಡುವೆನು,”","poem":2},{"lineBreak":true},{"text":"ಎಂದು ಯೆಹೋವ ದೇವರು ಹೇಳುತ್ತಾರೆ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kan_okcv/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kan_okcv/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kan_okcv/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}