{"translation":{"id":"kca_ibt","name":"Хӑнты Перевод Библии","website":"https://ebible.org/Scriptures/details.php?id=kca","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kca","licenseNotes":null,"shortName":"IBT","englishName":"Khanty Bible","language":"kca","textDirection":"ltr","sha256":"38c2cb2ad42b6bffda016086baf4f7dbcc495ab7cfbc72226c6a77846e413e8f","availableFormats":["json"],"listOfBooksApiLink":"/api/kca_ibt/books.json","numberOfBooks":4,"totalNumberOfChapters":106,"totalNumberOfVerses":3736,"languageName":"Khanty","languageEnglishName":"Khanty"},"book":{"id":"JON","translationId":"kca_ibt","name":"Турәм айкеԓ туты ху Иона нэпек","commonName":"Турәм айкеԓ туты ху Иона нэпек","title":"Турәм айкеԓ туты ху Иона нэпек","order":32,"numberOfChapters":4,"sha256":"fb1cb775f91bf47b2e7cd1b96aead5754d9e70e1762ada34e355354d1427c5fa","firstChapterNumber":1,"firstChapterApiLink":"/api/kca_ibt/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/kca_ibt/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Иона пойәк"]},{"type":"verse","number":1,"content":["Турәм Куща ун веса",{"noteId":0},"Иона йŏхи ԓавемәты партсәԓы; Иона щи вес хŏн ԓыпийән хуԓәм хӑтәԓ пӑ хуԓәм ат ус."]},{"type":"verse","number":2,"content":["Иона Турәм Куща ԓўв Турмәԓ пеԓа вес хŏн ԓыпи эԓты пойәкщәс."]},{"type":"verse","number":3,"content":["Пӑ йастәс:",{"text":"«Шука ма питмем урәӈән Турам Куща пеԓа пойәкщәсәм,","poem":1},{"lineBreak":true},{"text":"пӑ Ԓўв мӑнэм хуԓсәԓы;","poem":1},{"lineBreak":true},{"text":"ма иԓта турәм эԓты уваԓсәм,","poem":1},{"lineBreak":true},{"text":"пӑ Нӑӈ ма тўр сыйэм хуԓсэн.","poem":1}]},{"type":"verse","number":4,"content":["Нӑӈ мӑнэм мӑԓ йиӈка, щарәс сӑма, шуйԓәптәсэн,",{"text":"ма йикән лӑп ўсайәм,","poem":1},{"lineBreak":true},{"text":"иса Нӑӈ йикԓан, Нӑӈ хўпԓан","poem":1},{"lineBreak":true},{"text":"ма нўмпемән йӑӈхиԓысәт.","poem":1}]},{"type":"verse","number":5,"content":["Ма йастәсәм:",{"text":"Нӑӈ мӑнэм куш сэм сайа йэԓ воштәсэн,","poem":1},{"lineBreak":true},{"text":"ма ищи пӑ Нӑӈ йэмәӈ хотэн шийаԓәԓэм.","poem":1}]},{"type":"verse","number":6,"content":["Ԓыԓэм сŏхәнты унты ма йиӈкәтән ӑпәԓтсайәм,",{"text":"пӑтыԓы тӑхайа ма щи тухәрсайәм;","poem":1},{"lineBreak":true},{"text":"щарәс лывәщән ŏхем лӑп йŏвәртса.","poem":1}]},{"type":"verse","number":7,"content":["Кев вŏш унты ма иԓ шуйԓәсәм,",{"text":"мўв ԓўв йэртэпԓаԓән мӑнэм веккеша лӑп петсәԓы;","poem":1},{"lineBreak":true},{"text":"Нӑӈ пӑ, Турәм Куща, ма Турмем,","poem":1},{"lineBreak":true},{"text":"ма ԓыԓэм иԓта турәм эԓты нŏх туԓэн.","poem":1}]},{"type":"verse","number":8,"content":["Хун ма ԓыԓэм сŏхәнты питәс,",{"text":"ма Турәм Куща эԓты нумәԓмәсәм,","poem":1},{"lineBreak":true},{"text":"пӑ ма пойкем Нӑӈ хуԓсэн,","poem":1},{"lineBreak":true},{"text":"Нӑӈ йэмәӈ хотэна пойкем йŏхтәс.","poem":1}]},{"type":"verse","number":9,"content":["Хŏй йурԓы пӑ нэмәԓтыйа ӑт рӑхты ŏтԓаԓ пеԓа пойәкщәԓәт,",{"text":"Йӑм Сӑмәӈ Ŏтэԓ хӑйԓәт.","poem":1}]},{"type":"verse","number":10,"content":["Ма пӑ ишкаԋщәп арән Нӑӈен йирән туԓәм;",{"text":"мўй йастыԓысәм, верԓэм:","poem":1},{"lineBreak":true},{"text":"Турәм Куща хŏща нŏх пайтәсты щир уԓ!»","poem":1}]},{"type":"verse","number":11,"content":["Турәм Куща ун веса партәс, пӑ ԓўв сорәм мўва Иона ким охтаԓсәԓы."]}],"footnotes":[{"noteId":0,"caller":"+","text":"вес - щарәс вой-хўԓ (кит, морское чудовище);","reference":{"chapter":2,"verse":1}}]},"thisChapterLink":"/api/kca_ibt/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kca_ibt/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kca_ibt/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":11}