{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"2SA","translationId":"kdc_pbt","name":"2 Samweli","commonName":"2 Samweli","title":"Kitabu cha Kabili cha Samweli","order":10,"numberOfChapters":24,"sha256":"aab56efee0f124ead9956481a8b1610cdc02608b03a794ae509b966e40b2e7c4","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/kdc_pbt/2SA/24.json","totalNumberOfVerses":695},"chapter":{"number":22,"content":[{"type":"heading","content":["Lwila lwa Daudi lwa kuhuma"]},{"type":"verse","number":1,"content":["Daudi kamwimbila Mndewa Imulungu lwila viyamgombole kulawa mmakono ga wanhu wamwihile, na kulawa mmakono ga Sauli."]},{"type":"verse","number":2,"content":["Kalonga,",{"text":"Mndewa Imulungu ayo dibwe jangu,","poem":1},{"lineBreak":true},{"text":"heyo ayo ngome yangu,","poem":1},{"lineBreak":true},{"text":"heyo ayo mkombola wangu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Imulungu wangu ayo dibwe jangu,","poem":1},{"lineBreak":true},{"text":"kumwake nokimbilila,","poem":1},{"lineBreak":true},{"text":"heyo ayo ngao yangu,","poem":1},{"lineBreak":true},{"text":"heyo ayo nguvu ya ukombola wangu,","poem":1},{"lineBreak":true},{"text":"heyo ayo ngome yangu","poem":1},{"lineBreak":true},{"text":"heyo ayo kimbililo jangu.","poem":1},{"lineBreak":true},{"text":"Heyo ayo mkombola wangu,","poem":1},{"lineBreak":true},{"text":"yang'hombole kulawa kwa iwanhu wasede.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nomkema Mndewa Imulungu yolondigwa kutogoligwa,","poem":1},{"lineBreak":true},{"text":"kanikombola kulawa kwa iwanhu onihila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kwavija mazi mengi ga ifa gakala ganizunguluke,","poem":1},{"lineBreak":true},{"text":"ng'humbi ingubika.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nzabi za kuzimu zinizingiliza,","poem":1},{"lineBreak":true},{"text":"mitego ya ifa ingoga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mmagazo gangu nimkema Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"nimkema Imulungu wangu,","poem":1},{"lineBreak":true},{"text":"kulawa mng'anda yake kahulika sauti yangu,","poem":1},{"lineBreak":true},{"text":"na kililo changu kimvikila mmagwiti gake.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Aho isi igwaya na kutigisika,","poem":1},{"lineBreak":true},{"text":"chandusilo cha ulanga kisinhuka na kugwaya,","poem":1},{"lineBreak":true},{"text":"kwavija Imulungu kagevuzika.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yosi difililika kulawa mmhula zake,","poem":1},{"lineBreak":true},{"text":"moto usakaza ulawa mmulomo wake,","poem":1},{"lineBreak":true},{"text":"makala ga moto gazipuka kulawa kumwake.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kaunamiza ulanga kahumuluka hasi,","poem":1},{"lineBreak":true},{"text":"mawingu matitu gakala hasi ya magulu gake.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kakwela kiumbe kili na mabawa kaguluka,","poem":1},{"lineBreak":true},{"text":"kahumuluka mdibeho kamba ndege.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kaigubika ziza,","poem":1},{"lineBreak":true},{"text":"kaigubika mawingu gazamile gamemile mazi gailundize.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mumng'alo wake mawingu gasegela,","poem":1},{"lineBreak":true},{"text":"mabwe ga moto gamwemwesa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu kaduma kulawa kuulanga,","poem":1},{"lineBreak":true},{"text":"Imulungu yeli Uchanha Ng'hani kalava sauti yake.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Katowa misale kawaswaswanya,","poem":1},{"lineBreak":true},{"text":"kagala mimwesa kawawinga.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Abaho hasi kuna ibahali koneka,","poem":1},{"lineBreak":true},{"text":"ichandusilo cha isi kigubuka,","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu viyakomhoke,","poem":1},{"lineBreak":true},{"text":"kwa ukubuma mhumuzi ya mhula yake.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Imulungu kagolosa mkono wake kulawa uchanha kangoga,","poem":1},{"lineBreak":true},{"text":"kanivabula kulawa mmazi mengi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kanikombola na wanhu onihila weli na nguvu,","poem":1},{"lineBreak":true},{"text":"na kanihonya kulawa kwa awo onihila,","poem":1},{"lineBreak":true},{"text":"kwavija wakala na nguvu kubanza niye.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wanivamila ving'halile mmagazo,","poem":1},{"lineBreak":true},{"text":"lakini Mndewa Imulungu kanitaza.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kanigala hanhu hana inyafasi,","poem":1},{"lineBreak":true},{"text":"kanikombola kwavija kaninogela.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Mndewa Imulungu kanhunza kamba haki yangu viili,","poem":1},{"lineBreak":true},{"text":"kanhunza kwavija makono gangu gabule ubananzi,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"kwavija niikweleleza nzila ya Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"na sitendile gehile na kumuleka Imulungu wangu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Kwavija malagizo gake gose nigagoga,","poem":1},{"lineBreak":true},{"text":"na mafundizo gake sigalekile.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Na niye nitelela kuulongozi wake,","poem":1},{"lineBreak":true},{"text":"niigomesa sikunitende nzambi.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Avo Mndewa Imulungu kanhunza kamba vinitendile,","poem":1},{"lineBreak":true},{"text":"kanhunza kwavija makono gangu gabule ubananzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Gweye kotamaniligwa kwa wanhu otamaniligwa,","poem":1},{"lineBreak":true},{"text":"kwa yelibule kitala koilagusa kwabule kitala.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Gweye kung'ala kwa waja wang'alile,","poem":1},{"lineBreak":true},{"text":"lakini kwa wanhu otenda gehile omona heyo kamba msede.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Gweye kowakombola iwanhu wahole,","poem":1},{"lineBreak":true},{"text":"lakini kowahumulusa iwanhu oitapa.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Gweye Mndewa Imulungu kwa taa yangu,","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu konimwemwesela mdiziza jangu.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Gweye wahanitaza, nodihuma bumbila da wakalizi,","poem":1},{"lineBreak":true},{"text":"kwa Imulungu wangu nodaha kuzumha luwa.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Sang'hano za Imulungu zitelela,","poem":1},{"lineBreak":true},{"text":"imbuli ya Mndewa Imulungu ya kweli,","poem":1},{"lineBreak":true},{"text":"heyo ayo ngao kwa iwanhu wose omkimbilila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Haduhu yeli Imulungu ila Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"haduhu yeli dibwe ila Imulungu wetu.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Ino Imulungu ayo ngome yangu igangamale,","poem":1},{"lineBreak":true},{"text":"kaitenda nzila yangu itelele.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Kaigangamiza migulu yangu iwe kamba ya nhelembo,","poem":1},{"lineBreak":true},{"text":"kanika goya uchanha kuinhembeti.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Kogafunza makono gangu kuitowa ng'hondo,","poem":1},{"lineBreak":true},{"text":"makono gangu gana nguvu ya kuvedula upinde wa shaba ya kiguzi.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Kunigwaa ngao yako ya kunikombola,","poem":1},{"lineBreak":true},{"text":"ukombola wako unhenda munhu mkulu.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Kuitanula nzila yangu,","poem":1},{"lineBreak":true},{"text":"na migulu yangu haitelebuke bule.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Niwakweleleza iwanhu onihila na niwahonda,","poem":1},{"lineBreak":true},{"text":"sibwelile kuchugu mbaka viwabanangigwe wose.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Niwabananga niwabwanha hasi mbaka hawadahile kwinuka kabili,","poem":1},{"lineBreak":true},{"text":"wagwa hasi ya magulu gangu.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Gweye kunigwaa nguvu ya kuitowa kung'hondo,","poem":1},{"lineBreak":true},{"text":"kuwabwanha iwanhu onilema hasi yangu.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Kuwatenda iwanhu onihila wakimbile,","poem":1},{"lineBreak":true},{"text":"na awo onilema niwabananga.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Walola lakini kukala haduhu munhu yoyose wa kuwataza,","poem":1},{"lineBreak":true},{"text":"wamulilila Mndewa Imulungu lakini heyo hawedike bule.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Niwahonda wagaluka kamba timbwisi,","poem":1},{"lineBreak":true},{"text":"niwaduluga na kuwabojoga kamba tope da mnzila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"Gweye kunikombola kulawa mmakono ga wanhu zangu,","poem":1},{"lineBreak":true},{"text":"kunitenda niwe mtawala wa isi zose,","poem":1},{"lineBreak":true},{"text":"iwanhu siwajuwile wanisang'hanila.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Wanhu baki weza kumwangu kuno onifugamila,","poem":1},{"lineBreak":true},{"text":"bahaja viwahulike nolonga wanitegeleza.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Wageni wakala wabule tamanilo,","poem":1},{"lineBreak":true},{"text":"weza kumwangu kulawa mzingome zao akuno ogwaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"Mndewa Imulungu kamgima,","poem":1},{"lineBreak":true},{"text":"yatogoligwe dibwe jangu,","poem":1},{"lineBreak":true},{"text":"yatogoligwe Imulungu wangu,","poem":1},{"lineBreak":true},{"text":"dibwe wa ukombola wangu.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Imulungu ayo yanidahize kuwalihiza gehile,","poem":1},{"lineBreak":true},{"text":"na kaweka hasi yangu iwanhu wa isi zose.","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"Kanikombola kulawa kwa iwanhu onihila,","poem":1},{"lineBreak":true},{"text":"kaninula uchanha ya awo onilema niye,","poem":1},{"lineBreak":true},{"text":"na kanigala kutali ya iwanhu iwasede.","poem":1}]},{"type":"line_break"},{"type":"verse","number":50,"content":[{"text":"Kwa mbuli ayo, nokutogola gweye Mndewa Imulungu hagati ya iwanhu wa isi zose,","poem":1},{"lineBreak":true},{"text":"na nokwimba na kulonga twaga jako kulu.","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Imulungu kamgwaa mndewa wake mhumo ng'hulu,","poem":1},{"lineBreak":true},{"text":"na kalagusa unogelo wake kwa ayo iyamsagule,","poem":1},{"lineBreak":true},{"text":"kwa Daudi na ulelo wake milele.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/2SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":51}