{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"DEU","translationId":"kdc_pbt","name":"Kumbukumbu","commonName":"Kumbukumbu","title":"Kitabu cha tano cha Musa kikemigwa Kumbukumbu da Malagizo","order":5,"numberOfChapters":34,"sha256":"a375f4a60d512f1f7ac133edd5c79ef0e5c4f1643fd9549a65d7cbc95a8d30f5","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/kdc_pbt/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":32,"content":[{"type":"verse","number":1,"content":[{"text":"“Tegeleza gweye ulanga, gano gonilonga,","poem":1},{"lineBreak":true},{"text":"tegeleza gweye isi, mbuli za mulomo wangu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mafundizo gangu godwendweka kamba mvula,","poem":1},{"lineBreak":true},{"text":"mbuli zangu zolagala kamba kungugu,","poem":1},{"lineBreak":true},{"text":"kamba mawaga mna iminoga mideke,","poem":1},{"lineBreak":true},{"text":"kamba mvula mna gamajani mabisi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nodisimulila twaga da Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"na mweye mulonge, ‘Imulungu wetu Mkulu!’","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mndewa Imulungu ayo Dibwe kulu da kuifisila,","poem":1},{"lineBreak":true},{"text":"nzila zake za haki.","poem":1},{"lineBreak":true},{"text":"Imulungu yotamaniligwa na yelibule kitala chochose,","poem":1},{"lineBreak":true},{"text":"heyo kotenda kwa haki na katelela.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lakini mweye mswela kutamaniligwa kumwake,","poem":1},{"lineBreak":true},{"text":"mweye siyo wanage mbuli ya nzambi zenu,","poem":1},{"lineBreak":true},{"text":"mweye mwa ulelo wihile na upotele.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Vino habali momuliha Mndewa Imulungu kamba avo,","poem":1},{"lineBreak":true},{"text":"mweye wanhu wabozi na mulibule nzewele?","poem":1},{"lineBreak":true},{"text":"Vino heyo siyo tataenu yawalumbile,","poem":1},{"lineBreak":true},{"text":"kawatenda na kuwasimika?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kumbukeni siku za umwaka,","poem":1},{"lineBreak":true},{"text":"gelegezeni miyaka mingi ibitile,","poem":1},{"lineBreak":true},{"text":"wauzeni iwahenga zenu, owalagusila,","poem":1},{"lineBreak":true},{"text":"wauzeni iwavele wenu, owalongela mbuli za umwaka.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ayo yeli Uchanha Ng'hani viyawagwelele wanhu wa isi uhazi wao,","poem":1},{"lineBreak":true},{"text":"viyawagolile iwanhu wose,","poem":1},{"lineBreak":true},{"text":"kila wanhu na isi yao na kawekila imbaka yao,","poem":1},{"lineBreak":true},{"text":"kamba viweli iwana wa Izilaeli.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lakini Mndewa Imulungu kaweka wanhu wa Yakobo wawe wake,","poem":1},{"lineBreak":true},{"text":"awo kawasagula wawe uhazi wake.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kawona Waizilaeli owegela kuluwala,","poem":1},{"lineBreak":true},{"text":"ako kuna dibeho.","poem":1},{"lineBreak":true},{"text":"Kawakaliza na kawalola goya,","poem":1},{"lineBreak":true},{"text":"kawalela kamba munhu viyokaliza imwana wa siso jake.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kamba mhungu yokaliza kisanza chake,","poem":1},{"lineBreak":true},{"text":"na kozumha zumha uchanha ya makinda gake,","poem":1},{"lineBreak":true},{"text":"na koganzanza mabawa gake ili yawagoge,","poem":1},{"lineBreak":true},{"text":"na kowapapa mna gamabawa gake.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu mwenyego kawalongoza,","poem":1},{"lineBreak":true},{"text":"na kuduhu imulungu iyagwe yawatazile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kawabitiza kuvigongo,","poem":1},{"lineBreak":true},{"text":"na waja ndiya yotile mmigunda.","poem":1},{"lineBreak":true},{"text":"Kawagwaa uki kulawa mzimhango za mibwe waje,","poem":1},{"lineBreak":true},{"text":"na mizeituni yotile kulawa mdibwe dala.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kawagwaa mtindi na maziwa ga ng'ombe na mbuzi,","poem":1},{"lineBreak":true},{"text":"mavuta ga ng'hondolo,","poem":1},{"lineBreak":true},{"text":"ng'hondolo mbigalo na mbuzi wa Bashani.","poem":1},{"lineBreak":true},{"text":"Kawagwaa ngano inogile,","poem":1},{"lineBreak":true},{"text":"na divai ya sambi wang'we.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Wanhu wa Izilaeli waneneha na wavitowa mateke,","poem":1},{"lineBreak":true},{"text":"waneneha na wakala na vitambi na wagilimbala,","poem":1},{"lineBreak":true},{"text":"abaho wamuleka Imulungu yawalumbile,","poem":1},{"lineBreak":true},{"text":"wambeza Dibwe kulu imkombola wao.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wamtenda yakone migongo kwa imilungu yao","poem":1},{"lineBreak":true},{"text":"na kwa vinhu vigevuza wamtenda yagevuzike.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wavilavila nhosa vinyamkela weli siyo Imulungu,","poem":1},{"lineBreak":true},{"text":"waicholela imilungu hawaijuwile,","poem":1},{"lineBreak":true},{"text":"imilungu izile sambi sambi,","poem":1},{"lineBreak":true},{"text":"ayo haitegelezigwe na iwahenga zao.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mmuleka Dibwe yawagwelele ugima,","poem":1},{"lineBreak":true},{"text":"mumsemwa Imulungu yeli chanduso cha ugima wenu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Mndewa Imulungu kayona mbuli ayo na kawaleka,","poem":1},{"lineBreak":true},{"text":"kagevuzigwa na wanage wa ikimbigalo na wa ikitwanzi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kalonga, ‘Nokifisa kihanga changu,","poem":1},{"lineBreak":true},{"text":"ndole kimambukizo chao chokuwaze,’","poem":1},{"lineBreak":true},{"text":"kwavija awo ulelo wihile,","poem":1},{"lineBreak":true},{"text":"na wana hawatamaniligwa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wanitenda nyone migongo kwa kinhu hakili imulungu,","poem":1},{"lineBreak":true},{"text":"wanigevuza kwa vinyago vao.","poem":1},{"lineBreak":true},{"text":"Avo nowatenda wone migongo mbuli ya iwanhu okoneka siyo wanhu goya,","poem":1},{"lineBreak":true},{"text":"na nowagevuza kubitila wanhu wa isi ya wabozi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ng'hasiliki yangu yokwaka moto,","poem":1},{"lineBreak":true},{"text":"yosoma mbaka hasi kowochola wanhu wafile,","poem":1},{"lineBreak":true},{"text":"yosakaza isi yose na vose vili mumo,","poem":1},{"lineBreak":true},{"text":"yolukuza migimbo ya vigongo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"‘Nowagalila magayo hogomala,","poem":1},{"lineBreak":true},{"text":"nomambukiza misale yangu kumwao.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Osoka kwa nzala,","poem":1},{"lineBreak":true},{"text":"na wofa kwa mitamu na mikubulo.","poem":1},{"lineBreak":true},{"text":"Nowagalila ming'onyo mikali iwalumize,","poem":1},{"lineBreak":true},{"text":"na mizoka itambala ili na sumu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ng'hondo yogala ifa kudibuga,","poem":1},{"lineBreak":true},{"text":"na mzing'anda wanhu okuwa na bwembwe ng'hani,","poem":1},{"lineBreak":true},{"text":"wabwanga na wandele okomigwa,","poem":1},{"lineBreak":true},{"text":"hata ving'hele na wavele weli na uhenga.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nahawabanange wose,","poem":1},{"lineBreak":true},{"text":"na kutenda sikuwakumbukigwe kabili na munhu yoyose,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ila nidumba kuitapa kwa awo owehila,","poem":1},{"lineBreak":true},{"text":"ili awo owehila sikuwagese kamba wawabananga,","poem":1},{"lineBreak":true},{"text":"na niye Mndewa Imulungu sitendile kinhu!’","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Wanhu wa isi ya Izilaeli awo wanhu welibule nzewele,","poem":1},{"lineBreak":true},{"text":"na iwanhu hawagelegeza goya.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Maza wakalile na nzewele wahajuwile habali wahumwa,","poem":1},{"lineBreak":true},{"text":"na wahajuwile kimambukizo chao chokuwa vilihi.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Munhu imoja kodaha vilihi kuwahuma wanhu elufu imoja","poem":1},{"lineBreak":true},{"text":"hebu wanhu wabili odaha vilihi kuwahuma wanhu elufu kumi?","poem":1},{"lineBreak":true},{"text":"Yodahika kamba Dibwe jao kulu kawaleka,","poem":1},{"lineBreak":true},{"text":"na Mndewa Imulungu wao mkulu kawadonha.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Hata iwanhu otwihila ojuwa kamba,","poem":1},{"lineBreak":true},{"text":"Dibwe jao siyo kamba Dibwe jetu.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Kwavija mizabibu yao yolawa Sodoma,","poem":1},{"lineBreak":true},{"text":"ilawa mmigunda ya Gomola,","poem":1},{"lineBreak":true},{"text":"zabibu zake zina sumu,","poem":1},{"lineBreak":true},{"text":"vimvaba vake va usungu.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Divai yao kamba sumu ya nyoka,","poem":1},{"lineBreak":true},{"text":"ina sumu kali kamba ya muyombo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Vino, gano sigekile goya kumwangu,","poem":1},{"lineBreak":true},{"text":"na kugeka mkihenge changu?","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Niye ayo yonda nilihe gehile,","poem":1},{"lineBreak":true},{"text":"niye nowaliha gehile mna ikipindi vonda walemelwe,","poem":1},{"lineBreak":true},{"text":"kwavija siku da kubanangigwa kwao divika,","poem":1},{"lineBreak":true},{"text":"na kimambukizo chao cha mmabehi.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu kowagombela wanhu zake,","poem":1},{"lineBreak":true},{"text":"na kowonela bazi iwasang'hanaji zake,","poem":1},{"lineBreak":true},{"text":"yahakona nguvu zao zimala,","poem":1},{"lineBreak":true},{"text":"na kuduhu yasigale, mfungwa hebu yalekesigwe.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Abaho Mndewa Imulungu kowauza wanhu zake,","poem":1},{"lineBreak":true},{"text":"‘Yakwahi ayo imilungu yenu,","poem":1},{"lineBreak":true},{"text":"dibwe dimucholile kuifisa kumwake?’","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Yakwahi ayo imilungu idile sadaka zenu,","poem":1},{"lineBreak":true},{"text":"na kung'wa divai na nhosa zenu za kung'wa?","poem":1},{"lineBreak":true},{"text":"Avo lekeni inuke iwataze,","poem":1},{"lineBreak":true},{"text":"lekeni iwahonye!","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"‘Loleni kamba niye ayo Imulungu,","poem":1},{"lineBreak":true},{"text":"na kuduhu iyagwe ila niye.","poem":1},{"lineBreak":true},{"text":"Niye nokoma na nokwika ugima,","poem":1},{"lineBreak":true},{"text":"nolumiza na kuhonya,","poem":1},{"lineBreak":true},{"text":"kuduhu yodaha kumuhonya yoyose mmakono gangu.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Nogolosa mkono wangu kuulanga,","poem":1},{"lineBreak":true},{"text":"na noiduwila kamba vinili mgima milele,","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"mwahajona sime jangu dimelemeta,","poem":1},{"lineBreak":true},{"text":"na nogolosa mkono kutagusa,","poem":1},{"lineBreak":true},{"text":"nowaliha gehile awo onilema,","poem":1},{"lineBreak":true},{"text":"na nowakoboza awo onihila.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Misale yangu yokoligwa damu,","poem":1},{"lineBreak":true},{"text":"sime jangu dokwiguta nyama,","poem":1},{"lineBreak":true},{"text":"sime jangu dododa kwa damu ya vilonda va wafungwa,","poem":1},{"lineBreak":true},{"text":"na awo onihila weli na mvili nhali.’","poem":1}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Mweye wanhu wa isi ziyagwe, wadeng'heleleni wanhu zake,","poem":1},{"lineBreak":true},{"text":"kwavija heyo koliha kwa damu ya wasang'hanaji zake,","poem":1},{"lineBreak":true},{"text":"kowaliha awo omulema,","poem":1},{"lineBreak":true},{"text":"na koisunha isi ya wanhu zake.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":44,"content":["Musa na Yoshua, mwanage Nuni, weza kuulongozi wa iwanhu, Musa kazibwelela mbuli za lwila uno, avo Waizilaeli wose wauhulike."]},{"type":"verse","number":45,"content":["Musa viyamambukize kuwalongela wanhu wa Izilaeli mbuli zino zose,"]},{"type":"verse","number":46,"content":["kawalongela, “Zikeni mmizoyo yenu mbuli zose ziniwagwelele lelo. Molondigwa muwalongele wanenu ili wazigoge kwa kutamaniligwa mbuli zose za malagizo gano."]},{"type":"verse","number":47,"content":["Kwavija malagizo gano siyo mbuli ziiyeka ila ago ugima wenu, kubitila malagizo gano mokala siku nyingi mwiisi yumuchola kuisola, mwambu wa lwanda lwa Yolidani.”"]},{"type":"heading","content":["Ifa ya Musa yolongigwa"]},{"type":"verse","number":48,"content":["Siku didijo Mndewa Imulungu kamulongela Musa,"]},{"type":"verse","number":49,"content":["“Kwela kulugongo luno lwa Abalimu, lugongo lwa Nebo mwiisi ya Moabu, mwambu kwa mwambu na buga da Yeliko, uilole isi ya Kanaani iniwagwelela Waizilaeli iwe yao."]},{"type":"verse","number":50,"content":["Abaho kuko kulugongo kofa na koiting'hana na wahenga zako wafile mwaka kamba viyafile mkulu wako Haluni kulugongo lwa Holi na kaiting'hana na wahenga zake,"]},{"type":"verse","number":51,"content":["kwavija mweye wabili mubena lagizo jangu mgameso ga Waizilaeli. Vimukalile ako kugamazi ga Meliba behi na buga da Kadeshi kuna uluwala lwa Sini, hamungwelele ukulu mgameso ga iwanhu."]},{"type":"verse","number":52,"content":["Avo koyona isi kwa kutali, lakini honda wingile bule mna iisi iniwagwelela wanhu wa Izilaeli.”"]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/DEU/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/DEU/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/DEU/31.json","previousChapterAudioLinks":{},"numberOfVerses":52}