{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"DEU","translationId":"kdc_pbt","name":"Kumbukumbu","commonName":"Kumbukumbu","title":"Kitabu cha tano cha Musa kikemigwa Kumbukumbu da Malagizo","order":5,"numberOfChapters":34,"sha256":"a375f4a60d512f1f7ac133edd5c79ef0e5c4f1643fd9549a65d7cbc95a8d30f5","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/kdc_pbt/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":33,"content":[{"type":"heading","content":["Musa kogatambikila makabila ga Izilaeli"]},{"type":"verse","number":1,"content":["Zino azo mbuli za kutambikila ziyalongile Musa, munhu wa Imulungu, kawalongela wanhu wa Izilaeli yang'hali hanakufa."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Mndewa Imulungu keza kulawa kulugongo lwa Sinai,","poem":1},{"lineBreak":true},{"text":"katulawila kulawa kulugongo lwa Seili,","poem":1},{"lineBreak":true},{"text":"katumwemwesela kulawa kulugongo lwa Palani.","poem":1},{"lineBreak":true},{"text":"Kalawa hagati ya wasenga elufu kumi wa kuulanga,","poem":1},{"lineBreak":true},{"text":"na moto ukwaka mumkono wake wa ukudila.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu kawanogela wanhu zake,","poem":1},{"lineBreak":true},{"text":"na kowakaliza wanhu zake wang'alile.","poem":1},{"lineBreak":true},{"text":"Avo wakweleleza lwayo lwake,","poem":1},{"lineBreak":true},{"text":"na wagoga gayawalongele.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Musa katulagiza tugagoge malagizo,","poem":1},{"lineBreak":true},{"text":"mbuli ino ayo ngama yetu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu kawa Mndewa wa Izilaeli,","poem":1},{"lineBreak":true},{"text":"kipindi vilongozi wao viwaiting'hane,","poem":1},{"lineBreak":true},{"text":"na makabila gose vigaiting'hane.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":["Musa kalonga mbuli ya kabila da Lubeni,",{"text":"“Lubeni yawe mgima na wala sikuyafe,","poem":1},{"lineBreak":true},{"text":"hamoja wanhu wake okuwa wadodo.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":["Kwa kabila da Yuda kalonga,",{"text":"“Go Mndewa Imulungu utegeleze kililo cha kabila da Yuda,","poem":1},{"lineBreak":true},{"text":"umbweze kabili kwa ndugu zake.","poem":1},{"lineBreak":true},{"text":"Mgombele kwa makono gako mbuli yake,","poem":1},{"lineBreak":true},{"text":"uditaze kabila da Yuda mbuli ya awo omwihila.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":["Kwa kabila da Lawi kalonga,",{"text":"“Go Mndewa Imulungu uwalongele wanhu wa kabila da Lawi gaja goulonda kwa mabwe","poem":1},{"noteId":3},{"text":"ga kujuwa gaja goulonda,","poem":1},{"lineBreak":true},{"text":"awo wauwagezile ako Masa,","poem":1},{"lineBreak":true},{"text":"na kugomba nao ako Meliba.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Walawi wawaleka tata zao na mama zao,","poem":1},{"lineBreak":true},{"text":"wawasemwa ndugu zao,","poem":1},{"lineBreak":true},{"text":"hawawajuwile hata wanao kwavija wagagoga malagizo gako,","poem":1},{"lineBreak":true},{"text":"na wagoga lagano jako.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Na owafunza wana wa Yakobo mafundizo gako,","poem":1},{"lineBreak":true},{"text":"owafunza wanhu wa Izilaeli malagizo gako.","poem":1},{"lineBreak":true},{"text":"Walawi osoma ubani mgameso gako,","poem":1},{"lineBreak":true},{"text":"na nhosa za kusoma moto uchanha ya upango wako wa nhosa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Go Mndewa Imulungu uwatende wamwede kwa nguvu zao,","poem":1},{"lineBreak":true},{"text":"utogole sang'hano za makono gao, ubene nguvu za awo owehila,","poem":1},{"lineBreak":true},{"text":"na uwatende sikuwenuke kabili.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":["Kwa kabila da Benjamini kalonga,",{"text":"“Dino dijo kabila diyodinogela Mndewa Imulungu na kodikaliza,","poem":1},{"lineBreak":true},{"text":"kowakaliza imisi yose,","poem":1},{"lineBreak":true},{"text":"na kokala mvigongo vake.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":["Kwa kabila da Yusufu kalonga,",{"text":"“Mndewa Imulungu na yaitende imwede isi yake,","poem":1},{"lineBreak":true},{"text":"yaitende imwede kwa mvula kulawa kuulanga,","poem":1},{"lineBreak":true},{"text":"na mbwibwi kulawa hasi ya isi,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"yaitende imwede kwa matunda gepile goya kwa zuwa,","poem":1},{"lineBreak":true},{"text":"matunda goleligwa kila msimu,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"kwa ndiya inogile na ndiya nyingi ya vigongo va umwaka.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Isi yake imeme ganogile gose,","poem":1},{"lineBreak":true},{"text":"imwede kwa ganogile golawa kwa Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"yalawile mkisolo kikwaka.","poem":1},{"lineBreak":true},{"text":"Kumweda kuko kuwavikile wanhu wa kabila da Yusufu,","poem":1},{"lineBreak":true},{"text":"yakalile mkulu hagati ya ndugu zake.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ukulu wake kamba ukulu wa ng'ombe mbigalo wa ichanduso,","poem":1},{"lineBreak":true},{"text":"mhembe zake kamba mhembe za nyati mbigalo.","poem":1},{"lineBreak":true},{"text":"Kozitumia kuwasung'ha wanhu wa isi ziyagwe,","poem":1},{"lineBreak":true},{"text":"kowasung'ha mbaka kuuhelelo wa isi.","poem":1},{"lineBreak":true},{"text":"Efulaimu kokuwa na wakalizi wa ng'hondo maelufu mengi,","poem":1},{"lineBreak":true},{"text":"na Manase kokuwa na wakalizi wa ng'hondo maelufu.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":["Kwa kabila da Zabuloni na kabila da Isakali kalonga,",{"text":"“Zabuloni deng'helela mmwanza wako,","poem":1},{"lineBreak":true},{"text":"na gweye Isakali deng'helela mvibanda vako.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Owagoneka wageni mvigongo vao,","poem":1},{"lineBreak":true},{"text":"na kuko wanhu olava nhosa zilondigwa.","poem":1},{"lineBreak":true},{"text":"Kwavija awo opata utajili kulawa mbahali,","poem":1},{"lineBreak":true},{"text":"na okuwa na ngama mumsanga wa mwhani.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":["Kwa kabila da Gadi kalonga,",{"text":"“Yagweleligwe ukulu Imulungu yomgwelela Gadi isi ng'hulu.","poem":1},{"lineBreak":true},{"text":"Gadi kokala kamba simba,","poem":1},{"lineBreak":true},{"text":"yopalula mkono na pala.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Kosagula isi inogile,","poem":1},{"lineBreak":true},{"text":"isi inogile ya kilongozi kekiligwa heyo.","poem":1},{"lineBreak":true},{"text":"Wahaiting'hana iwakulu wa iwanhu,","poem":1},{"lineBreak":true},{"text":"heyo kogoga gose goyolonda Mndewa Imulungu kwa kuwatagusa goya Waizilaeli.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":["Kwa kabila da Dani kalonga,",{"text":"“Dani kamba mwana simba,","poem":1},{"lineBreak":true},{"text":"yozumha kulawa Bashani.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":["Kwa kabila da Nafutali kalonga,",{"text":"“Nafutali kumema bazi dilawa kwa Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kumema ganogile golawa kwa Imulungu,","poem":1},{"lineBreak":true},{"text":"isi yako ya kusini na kudihongela zuwa.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":["Kwa kabila da Asheli kalonga,",{"text":"“Asheli yamwede kubanza wana wose wa Yakobo,","poem":1},{"lineBreak":true},{"text":"ndugu zako wose wakunogele,","poem":1},{"lineBreak":true},{"text":"na yavabike mgulu wake mna gamavuta ga mizeituni.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Mabuga gako gakalizigwe kwa nyivi za mizuma na shaba ya kiguzi,","poem":1},{"lineBreak":true},{"text":"na siku zose ugangamale!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Gweye Izilaeli haduhu kamba Imulungu wako,","poem":1},{"lineBreak":true},{"text":"heyo kabita kuulanga keza kukutaza,","poem":1},{"lineBreak":true},{"text":"kabita uchanha kuna uukulu wake.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Imulungu wa milele heyo wakumkimbilila mweye,","poem":1},{"lineBreak":true},{"text":"kawapapa mmakono gake milele.","poem":1},{"lineBreak":true},{"text":"Kawawinga wanhu owehila mgameso genu,","poem":1},{"lineBreak":true},{"text":"kawalagiza, “Wabanangeni.”","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Avo wanhu wa Izilaeli wakala goya,","poem":1},{"lineBreak":true},{"text":"wanage Yakobo waiyeka,","poem":1},{"lineBreak":true},{"text":"mna iisi imemile ndiya na divai,","poem":1},{"lineBreak":true},{"text":"na ulanga wake olagaza kungugu.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Mmweda mweye Waizilaeli.","poem":1},{"lineBreak":true},{"text":"Nani kamba mweye,","poem":1},{"lineBreak":true},{"text":"mweye mukomboligwe na Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"heyo yeli ngao yenu,","poem":1},{"lineBreak":true},{"text":"na sime diwatenda muhume.","poem":1},{"lineBreak":true},{"text":"Wanhu owehila okwiza kuno onyawanyawa mgameso genu,","poem":1},{"lineBreak":true},{"text":"na mweye mowabojoga.","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"Kwa Kiebulania gago gamabwe gokemigwa Ulimu na Tumimu.","reference":{"chapter":33,"verse":8}}]},"thisChapterLink":"/api/kdc_pbt/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}