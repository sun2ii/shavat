{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"GEN","translationId":"kdc_pbt","name":"Mwanduso","commonName":"Mwanduso","title":"Kitabu cha ichanduso cha Musa kikemigwa Mwanduso","order":1,"numberOfChapters":50,"sha256":"e3c9334a32caa41fb2f72ee01b3611d0b7f12d6e31352cfd66ac541afa856258","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/kdc_pbt/GEN/50.json","totalNumberOfVerses":1533},"chapter":{"number":49,"content":[{"type":"heading","content":["Yakobo kolonga na wanage"]},{"type":"verse","number":1,"content":["Yakobo kawakema wanage kawalongela, “Kweseni behi niwalongele gaja gonda gawalawilile baho kumwande.”"]},{"type":"verse","number":2,"content":[{"text":"“Kaleni hamoja mutegeleze, mweye wana wa Yakobo,","poem":1},{"lineBreak":true},{"text":"nhegelezeni niye Izilaeli tataenu.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Gweye Lubeni kwa mwanangu wa chaudele, gweye kwa nguvu zangu,","poem":1},{"lineBreak":true},{"text":"na tunda da ubwanga wangu,","poem":1},{"lineBreak":true},{"text":"gweye kuwabanza wayagwe kwa ukulu na nguvu,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"gweye kuigala na mazi ga sika kulu,","poem":1},{"lineBreak":true},{"text":"lakini honda uwe mkulu kabili,","poem":1},{"lineBreak":true},{"text":"kwavija kumuwasa msang'hanaji wangu yeli kamba mwehe wangu,","poem":1},{"lineBreak":true},{"text":"gweye kulufitiza lusazi lwangu.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Simeoni na Lawi ni ndugu,","poem":1},{"lineBreak":true},{"text":"osang'hanila misime yao kwa kubananga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lakini niye siilumba nao mna ikija kiwolonda kutenda,","poem":1},{"lineBreak":true},{"text":"niye siilumba nao mumting'hano wao,","poem":1},{"lineBreak":true},{"text":"kwavija kwa ng'hasiliki yao wawakoma wanhu na kwa utundu wao wakanha migiha ya ng'ombe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Noiduwila ng'hasiliki yao kwavija ibanza ukwiha","poem":1},{"lineBreak":true},{"text":"na kugevuzika kwao kwabule bazi.","poem":1},{"lineBreak":true},{"text":"Nowapwililisa mwiisi ya Yakobo,","poem":1},{"lineBreak":true},{"text":"nowatimulila mwiisi ya Izilaeli.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Gweye Yuda ndugu zako okugwaa nhogolwa.","poem":1},{"lineBreak":true},{"text":"Wanhu wakwihile kowabota singo","poem":1},{"lineBreak":true},{"text":"na ndugu zako okufugamila.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gweye Yuda mwanangu kuigala na simba yapatile kija kiyasakile na kubwela hoyokala.","poem":1},{"lineBreak":true},{"text":"Kamba simba koigolola na kutambalala hasi,","poem":1},{"lineBreak":true},{"text":"simba yeli na nguvu nani yonda yamulamuse?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mkongoja wa ukulu honda usegele mmakono ga Yuda,","poem":1},{"lineBreak":true},{"text":"na mkongoja wa utawala honda usegele muulelo wake","poem":1},{"lineBreak":true},{"text":"mbaka vonda yeze ija mwenyego","poem":1},{"lineBreak":true},{"text":"heyo makabila gose gomtegeleza.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kwavija kokuwa na mizabibu mingi","poem":1},{"lineBreak":true},{"text":"komfunga kihongwe wake mumzabibu","poem":1},{"lineBreak":true},{"text":"ili yaje majani ga mzabibu.","poem":1},{"lineBreak":true},{"text":"Kwavija kokuwa na divai nyingi","poem":1},{"lineBreak":true},{"text":"kofuwila viwalo vake","poem":1},{"lineBreak":true},{"text":"na makanzu gake kogafuwila mna idivai inogile ng'hani.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Meso gake madung'hu mbuli ya kung'wa divai","poem":1},{"lineBreak":true},{"text":"na meno gake mazelu mbuli ya kung'wa maziwa.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Zabuloni kokala mwiimwhani,","poem":1},{"lineBreak":true},{"text":"mwhani yake yokuwa hanhu ha kwika ngalawa ng'hulu.","poem":1},{"lineBreak":true},{"text":"Isi yake yoibakana na isi ya Sidoni.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Isakali kaigala na kihongwe yeli na nguvu","poem":1},{"lineBreak":true},{"text":"yotambalala mna zimbahasha zake.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kaona kamba hanhu ha kubwihila hanoga","poem":1},{"lineBreak":true},{"text":"na kaona isi inoga,","poem":1},{"lineBreak":true},{"text":"kainama mgongo wake yapape mzigo,","poem":1},{"lineBreak":true},{"text":"kawa mtumwa kusang'hana sang'hano ndala.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Dani kokuwa msemi wa wanhu zake","poem":1},{"lineBreak":true},{"text":"kokuwa kamba makabila gayagwe ga Izilaeli.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Dani kokuwa mgendela hasi mnzila,","poem":1},{"lineBreak":true},{"text":"mgendela hasi yeli na sumu mumgwazo wa nzila,","poem":1},{"lineBreak":true},{"text":"yoluma visiginho va falasi,","poem":1},{"lineBreak":true},{"text":"nayo munhu yamkwelile kogwa.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Go, Mndewa Imulungu nobeta unihonye.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Gadi kokumbigwa na wabavi,","poem":1},{"lineBreak":true},{"text":"lakini heyo kowasondelela kukisogo na kowabunda.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Isi yookala Asheli yolela ndiya ng'hani","poem":1},{"lineBreak":true},{"text":"nayo kolava ndiya iyolonda mndewa.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Nafutali kaigala na mhala yalekesigwe,","poem":1},{"lineBreak":true},{"text":"yolela wana wanogile.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Yusufu kaigala na biki dilela matunda,","poem":1},{"lineBreak":true},{"text":"biki dilela mumgwazo wa nzasa, matambi gake gokwenela mbaka mna uluwa.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Wanhu oitowa kwa migoha wammemela ng'hani","poem":1},{"lineBreak":true},{"text":"wampigisila migoha na wamgaza.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Lakini upinde wake ukala goya mmakono gake,","poem":1},{"lineBreak":true},{"text":"na makono gake gang'hali na nguvu,","poem":1},{"lineBreak":true},{"text":"kwa udahi wa ija Yodaha wa Yakobo","poem":1},{"lineBreak":true},{"text":"na Msusilaji na Dibwe da Izilaeli,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"mbuli ya Imulungu wa tatako, yakutazile,","poem":1},{"lineBreak":true},{"text":"mbuli ya Imulungu yeli na Udahi wose yakutendile umwede","poem":1},{"lineBreak":true},{"text":"kwa mbuli zinogile za kuulanga,","poem":1},{"lineBreak":true},{"text":"na kumweda kulawa hasi mwiibahali,","poem":1},{"lineBreak":true},{"text":"kumweda kwa kuwa na fugo nyingi na wana heleketwaa.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Kumweda kwa tatako kukula ng'hani","poem":1},{"lineBreak":true},{"text":"kubanza kumweda kwa vigongo va umwaka.","poem":1},{"lineBreak":true},{"text":"Kumweda ako kuwe kudipala da Yusufu,","poem":1},{"lineBreak":true},{"text":"kuwe mkihanga cha ayo yatendigwe mkulu kwa ndugu zake.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Benjamini kaigala na mbwizi mkali,","poem":1},{"lineBreak":true},{"text":"imitondo koja kiyasakile na ichungulo kogola kija kiyasakile.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":["Gano gago makabila longo na mabili ga Izilaeli na zino azo mbuli ziyalongile tatao kuwatambikila kamba viilondigwa."]},{"type":"heading","content":["Ifa ya Yakobo"]},{"type":"verse","number":29,"content":["Abaho Izilaeli kawalagiza vino wanage, “Niye sambi nofa na kuilumba na wahenga zangu wafile umwaka, nizikeni hamoja na wavele zangu mna imhango ili mumgunda wa Efuloni Muhiti,"]},{"type":"verse","number":30,"content":["ako Makipela, mwambu wa kudilawila zuwa wa Mamule, mwiisi ya Kanaani. Abulahamu kagula mhango na mgunda awo kwa Efuloni Muhiti, uwe mhango ya kuzikila."]},{"type":"verse","number":31,"content":["Kuko kuwazikigwe Abulahamu na mwehe wake Sala, vivija kuko kuwazikigwe Isaka na mwehe wake Lebeka na vivija kuko nimzikile mwehe wangu Lea."]},{"type":"verse","number":32,"content":["Mgunda awo na mhango ayo viguligwa kwa Wahiti.”"]},{"type":"verse","number":33,"content":["Yakobo viyamambukize kuwalagiza wanage keka magulu gake mulusazi, kakanha loho, kailumba na wahenga zake wafile umwaka."]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}