{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"JDG","translationId":"kdc_pbt","name":"Wasemi","commonName":"Wasemi","title":"Kitabu cha Wasemi Wasemi","order":7,"numberOfChapters":21,"sha256":"14624a36268db3a5a1af6f06c78470cec03a75b0146c9004fa25e15b4c5c40ca","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/kdc_pbt/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":5,"content":[{"type":"heading","content":["Wila wa Debola na Balaki"]},{"type":"verse","number":1,"content":["Abaho siku dijo Debola na Balaki mwanage Abinoamu, wemba wila uno."]},{"type":"verse","number":2,"content":[{"text":"“Vilongozi viwawalongoze Waizilaeli kuing'hondo,","poem":1},{"lineBreak":true},{"text":"wanhu viwailavile kwa kulonda wenyego,","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu yatogolwe!","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hulikeni, mweye iwandewa!","poem":1},{"lineBreak":true},{"text":"Tegelezeni, mweye iwakulu!","poem":1},{"lineBreak":true},{"text":"Nomwimbila Mndewa Imulungu.","poem":1},{"lineBreak":true},{"text":"Nomtowela lukenze Mndewa Imulungu, Imulungu wa Izilaeli.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Go, Mndewa Imulungu, viulawile kulugongo lwa Seili,","poem":1},{"lineBreak":true},{"text":"viusegele mwiisi ya Edomu,","poem":1},{"lineBreak":true},{"text":"isi igwaya,","poem":1},{"lineBreak":true},{"text":"ulanga ulagaza mazi,","poem":1},{"lineBreak":true},{"text":"ona mawingu kalava mvula.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Vigongo vitigisika mgameso ga Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"ona kigongo cha Sinai kitigisika mgameso ga Mndewa Imulungu, Imulungu wa Izilaeli.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mna ikipindi cha Shamugali, mwanage Anati,","poem":1},{"lineBreak":true},{"text":"mna ikipindi cha Yaeli,","poem":1},{"lineBreak":true},{"text":"miyanza ikala kuduhu mzinzila zing'hulu,","poem":1},{"lineBreak":true},{"text":"wanhu wabitila mnzila za kuvisolo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Walimaji waleka kulima,","poem":1},{"lineBreak":true},{"text":"na waleka mbaka vinizile niye Debola,","poem":1},{"lineBreak":true},{"text":"niye nili kamba mama wa Waizilaeli.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Waizilaeli viwasolile imilungu iyagwe,","poem":1},{"lineBreak":true},{"text":"ng'hondo ivika kuulwivi lwa dibuga.","poem":1},{"lineBreak":true},{"text":"Lakini kukala kuduhu munhu yeli na panga hebu ngao,","poem":1},{"lineBreak":true},{"text":"mna iwanhu elufu alobaini wa Izilaeli.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nowatogola ivilongozi wa Waizilaeli,","poem":1},{"lineBreak":true},{"text":"nowatogola iwanhu wailavile kwa kulonda wenyego.","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu yatogolwe!","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mweye mukwelaga vihongwe wazelu,","poem":1},{"lineBreak":true},{"text":"na mukalilaga migolole inogile,","poem":1},{"lineBreak":true},{"text":"mweye mugenda mnzila.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tegelezeni sauti za iwanhu weli hana gamasima gamazi,","poem":1},{"lineBreak":true},{"text":"viwolonga viyahumile Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"ukuhuma kwa iwanhu wa Izilaeli.","poem":1},{"lineBreak":true},{"text":"Abaho wanhu wa Mndewa Imulungu wahumuluka kuulwivi lwa dibuga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Lamuka, lamuka, Debola!","poem":1},{"lineBreak":true},{"text":"Lamuka! Lamuka wimbe wila!","poem":1},{"lineBreak":true},{"text":"Lamuka, Balaki mwanage Abinoamu,","poem":1},{"lineBreak":true},{"text":"usole wanhu uwasolile kuna ing'hondo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Iwanhu wasigale wachola kwa iwakulu,","poem":1},{"lineBreak":true},{"text":"wanhu wa Mndewa Imulungu weza kumwangu niye na ivilongozi,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kulawa Efulaimu wahumuluka kubonde,","poem":1},{"lineBreak":true},{"text":"wawakweleleza ndugu zao wanhu wa Benjamini,","poem":1},{"lineBreak":true},{"text":"kulawa Makili wahumuluka awo ivilongozi wa kuna ing'hondo,","poem":1},{"lineBreak":true},{"text":"kulawa Zabuloni wahumuluka iwakulu wa kuna ing'hondo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Iwakulu wa wakalizi kulawa kwa Isakali wamkweleleza Debola,","poem":1},{"lineBreak":true},{"text":"wanhu wa Isakali awo otamanilwa na Balaki,","poem":1},{"lineBreak":true},{"text":"wakweleleza kuno okimbila mbaka kubonde.","poem":1},{"lineBreak":true},{"text":"Lakini mna iwanhu wa kabila da Lubeni,","poem":1},{"lineBreak":true},{"text":"kukala na wanhu osinhagila.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Habali wasigala mna gamabumba?","poem":1},{"lineBreak":true},{"text":"Ili wategeleze vifengwa va ng'hondolo?","poem":1},{"lineBreak":true},{"text":"Mna iwanhu wa kabila da Lubeni,","poem":1},{"lineBreak":true},{"text":"wanhu wasinhagila ng'hani.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kabila da Gadi disigala umwambu wa Yolidani.","poem":1},{"lineBreak":true},{"text":"Kabila da Dani disigala mzimeli.","poem":1},{"lineBreak":true},{"text":"Kabila da Asheli disigala ako kuna imwhani ya bahali,","poem":1},{"lineBreak":true},{"text":"wakala mmaloko.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wanhu wa Zabuloni wauhonza ugima wao.","poem":1},{"lineBreak":true},{"text":"Vivija wanhu wa Nafutali wauhonza ugima wao,","poem":1},{"lineBreak":true},{"text":"na kuitowa mna imigunda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ako Taanaki, behi ya nzasa za Megido,","poem":1},{"lineBreak":true},{"text":"wandewa weza, waitowa,","poem":1},{"lineBreak":true},{"text":"wandewa wa Kanaani waitowa,","poem":1},{"lineBreak":true},{"text":"lakini hawapatile chochose.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nhondo za kuulanga vivija ziwatowa,","poem":1},{"lineBreak":true},{"text":"kulawa kuko kuzikalile ziitowa na Sisela.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ng'humbi ya lwanda lwa Kishoni iwazola mbaka kutali,","poem":1},{"lineBreak":true},{"text":"ona ikidibo cha lwanda lwa Kishoni.","poem":1},{"lineBreak":true},{"text":"Niye nogenda kumwande kwa nguvu!","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Falasi wabita kuno okwangula hasi,","poem":1},{"lineBreak":true},{"text":"watowa hasi na mibang'ho yao.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Msenga wa Mndewa Imulungu kalonga vino,","poem":1},{"lineBreak":true},{"text":"‘Diduwileni buga da Melosi,","poem":1},{"lineBreak":true},{"text":"waduwileni wenekae wake,","poem":1},{"lineBreak":true},{"text":"kwavija hawezile kumtaza Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"hawamtazile Mndewa Imulungu mbuli ya iwanhu wene nguvu.’","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Yamwede kubanza watwanzi wose,","poem":1},{"lineBreak":true},{"text":"Yaeli, mwehe wa Hebeli, Imkeni.","poem":1},{"lineBreak":true},{"text":"Ona, yamwede kubanza watwanzi wose iwokala mvibanda.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Sisela kampula mazi,","poem":1},{"lineBreak":true},{"text":"na heyo kamgwaa maziwa,","poem":1},{"lineBreak":true},{"text":"kamgalila siagi mdibakuli da iwageni.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Mkono wa kumoso kagoga kigingi cha ikibanda,","poem":1},{"lineBreak":true},{"text":"na mkono wa ukudila kagoga nyundo ya ufundi,","poem":1},{"lineBreak":true},{"text":"kambiga Sisela kudipala,","poem":1},{"lineBreak":true},{"text":"kamtula ikihanga.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Sisela kaidulika, kalagala,","poem":1},{"lineBreak":true},{"text":"kawasa tuluu mmagulu gake.","poem":1},{"lineBreak":true},{"text":"Aho hayaidulike aho hayalagalile,","poem":1},{"lineBreak":true},{"text":"baho kadanganika!","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Mamake Sisela kasungulila mdidilisha,","poem":1},{"lineBreak":true},{"text":"kaiyalala,","poem":1},{"lineBreak":true},{"text":"‘Habali mtuka wake ukawa kuvika?","poem":1},{"lineBreak":true},{"text":"Habali ukuduma kwa mituka yake kukawa kuvika?’","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Iwatwanzi wake iwabala wamwidika.","poem":1},{"lineBreak":true},{"text":"Kaiuza mwenyego miyanza mingi viwamwidike vino,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"‘Ona ozahila na kuigolela vija viwasolile,","poem":1},{"lineBreak":true},{"text":"mndele imoja hebu wabili kwa kila mkalizi,","poem":1},{"lineBreak":true},{"text":"kiwalo cha langi mbuli ya Sisela.","poem":1},{"lineBreak":true},{"text":"Kiwalo kigeligwe ulembo,","poem":1},{"lineBreak":true},{"text":"na viwalo vinogile mbuli ya singo!’","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Go, Mndewa Imulungu, iwanhu okwihila wapotele!","poem":1},{"lineBreak":true},{"text":"Lakini awo okunogela gweye wawe kamba zuwa,","poem":1},{"lineBreak":true},{"text":"vidilawa na kumwemwesa ng'hani!”","poem":1},{"lineBreak":true},"Isi ikala itindiwale kwa miyaka malongo mane."]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}