{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PRO","translationId":"kdc_pbt","name":"Nongezi","commonName":"Nongezi","title":"Kitabu cha Nongezi Nongezi","order":20,"numberOfChapters":31,"sha256":"2463ed81d5cb7be5ed030cdceabb0efd8e5793b30c3eb1aae48c0b22f2c69c47","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kdc_pbt/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":1,"content":[{"type":"heading","content":["Kusonga kwa nongezi"]},{"type":"verse","number":1,"content":["Zino azo nongezi za Sulemani mndewa wa Izilaeli, mwanage Daudi."]},{"type":"verse","number":2,"content":["Nongezi zino zowatenda wanhu watange ubala na mafundizo, na kutambula mbuli za nzewele,"]},{"type":"verse","number":3,"content":["zowafunza wanhu kutanga mbuli zili na nzewele, haki na kusang'hana ganogile na kusang'hana kamba viilondeka."]},{"type":"verse","number":4,"content":["Zowagwaa ubala mizozolo, zowagwaa wabwanga kutanga vinhu na kusagula goya."]},{"type":"verse","number":5,"content":["Yeli na ubala yategeleze na yongeze ubala wake, na mwene nzewele zomfunza."]},{"type":"verse","number":6,"content":["Odaha kutanga nongezi na mafambulo gake, ozitanga mbuli za wanhu weli na ubala na vitendawili vao."]},{"type":"verse","number":7,"content":[{"text":"Kumdumba Mndewa Imulungu acho chanduso cha kutanga vinhu,","poem":1},{"lineBreak":true},{"text":"lakini wabozi obezeli ubala na kuzumwa.","poem":1}]},{"type":"heading","content":["Usenga kwa wana"]},{"type":"verse","number":8,"content":[{"text":"Mwanangu, tegeleza vuuzumwa na tatako,","poem":1},{"lineBreak":true},{"text":"na sikuugabezeli mafundizo ga mamako.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ago gokuwa kilemba cha ganogile uchanha ha pala jako,","poem":1},{"lineBreak":true},{"text":"kamba mkufu msingo yako.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mwanangu, sambi utogole kuviziligwa na wene nzambi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wahalonga, “Tuchole tukampelembe munhu na kumkoma,","poem":1},{"lineBreak":true},{"text":"izo tuwatowe welibule kitala chochose bila kilamuso.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tuwameze wang'hali wagima kamba kuzimu,","poem":1},{"lineBreak":true},{"text":"okuwa kamba waja ohumulukila mdikolongo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Topata mali zose za bei ng'hulu,","poem":1},{"lineBreak":true},{"text":"tovika mng'anda zetu vinhu vose vituwabokile.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Izo uilumbe na siye,","poem":1},{"lineBreak":true},{"text":"vinhu vose vonda tupate toigolela.”","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mwanangu, sikuuilumbe na hewo,","poem":1},{"lineBreak":true},{"text":"ugomese mgulu wako sikuuchole na hewo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kwavija hewo wa mnzila ya kusang'hana gehile,","poem":1},{"lineBreak":true},{"text":"pwisapwisa jao jose da kwita damu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mtego utegigwa kuno ndege kolola,","poem":1},{"lineBreak":true},{"text":"mtego awo utegigwa bule.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hewo opelemba kwita damu yao wenyego,","poem":1},{"lineBreak":true},{"text":"oitendela mtego wa kuinamata wenyego.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Vivo iwaga kwa wanhu opata vinhu kwa kuwaboka wayagwe,","poem":1},{"lineBreak":true},{"text":"osegesa ugima wao.","poem":1}]},{"type":"heading","content":["Ubala okemelela"]},{"type":"verse","number":20,"content":[{"text":"Ubala oguta kwa nyangi mna zinzila,","poem":1},{"lineBreak":true},{"text":"okema kwa nyangi ng'hulu mmabugano,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"okema mmiting'hano mikulu ya wanhu,","poem":1},{"lineBreak":true},{"text":"hana zinyivi ng'hulu za gamabuga otambula mbuli zake.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"“Mweye mizozolo! Mokuwa mizozolo mbaka lini?","poem":1},{"lineBreak":true},{"text":"Mbaka lini weli na bezi odeng'helela kubezeli kwao,","poem":1},{"lineBreak":true},{"text":"na wabozi okwihila kutanga vinhu?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tegelezeni viniwazuma,","poem":1},{"lineBreak":true},{"text":"nowagidila magesa gangu,","poem":1},{"lineBreak":true},{"text":"nowalongela mbuli zangu.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Kwavija niwakema mulema kunhegeleza,","poem":1},{"lineBreak":true},{"text":"niwahungila mkono mwize mulema,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"mugalema magesa gangu,","poem":1},{"lineBreak":true},{"text":"wala hamugesile kuzumwa kwangu.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Avo noisekelela mikubulo yenu,","poem":1},{"lineBreak":true},{"text":"nowazeha vonda mugwae,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"bwembwe dahawagoga kamba kukuzumbi,","poem":1},{"lineBreak":true},{"text":"kubanangika kwenu vonda kulawilile kamba kivulavumbi,","poem":1},{"lineBreak":true},{"text":"magazo na lusikisiki vahawapata.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Baho mong'hema, lakini honda niwedike bule,","poem":1},{"lineBreak":true},{"text":"monizahila ng'hani, lakini honda mnyone bule,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"kwavija mukwihila kutanga vinhu,","poem":1},{"lineBreak":true},{"text":"na mulema kumdumba Mndewa Imulungu,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"kwavija mugalema magesa gangu,","poem":1},{"lineBreak":true},{"text":"mukubezeli kuwazuma kwangu kose,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"avo moja matunda ga sang'hano zenu,","poem":1},{"lineBreak":true},{"text":"movimbilwa kwa mbuli zenu wenyego.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Kwavija mizozolo oikoma kwa kulema nzewele,","poem":1},{"lineBreak":true},{"text":"wabozi oibananga kwa kulema kugesa.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Lakini kila yotegeleza kokala goya,","poem":1},{"lineBreak":true},{"text":"kokala bila kudumba gehile.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}