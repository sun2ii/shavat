{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PRO","translationId":"kdc_pbt","name":"Nongezi","commonName":"Nongezi","title":"Kitabu cha Nongezi Nongezi","order":20,"numberOfChapters":31,"sha256":"2463ed81d5cb7be5ed030cdceabb0efd8e5793b30c3eb1aae48c0b22f2c69c47","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kdc_pbt/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":2,"content":[{"type":"heading","content":["Nhunza za ubala"]},{"type":"verse","number":1,"content":[{"text":"Mwanangu, wahazitogola mbuli zangu,","poem":1},{"lineBreak":true},{"text":"na kugagoga malagizo gangu,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"wahatega gwiti jako kutegeleza ubala,","poem":1},{"lineBreak":true},{"text":"na kuwika moyo wako upate nzewele ng'hani,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"wahapula ugweleligwe ubala,","poem":1},{"lineBreak":true},{"text":"na wahapula ugweleligwe nzewele ng'hani,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"wahauzahila ubala kamba sente,","poem":1},{"lineBreak":true},{"text":"na kuulonda kamba mali ifisigwe,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"baho kotanga choni kumdumba Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kotambula choni kumtanga Imulungu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kwavija Mndewa Imulungu kowagwaa wanhu ubala,","poem":1},{"lineBreak":true},{"text":"mmulomo wake molawa kutanga vinhu na kutanga goya.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kowekila ngama ya ubala waja osang'hana ganogile,","poem":1},{"lineBreak":true},{"text":"heyo ayo ngao kwa waja otenda kwa moyo kwatu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kokikaliza kila kinhu kiwosang'hana wanhu otenda haki,","poem":1},{"lineBreak":true},{"text":"na kuzilola goya nzila za wanhu omtamanila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Wahanitegeleza kotanga nhaguso na haki,","poem":1},{"lineBreak":true},{"text":"kotanga kusang'hana kamba viilondeka,","poem":1},{"lineBreak":true},{"text":"na koitanga kila nzila inogile.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kwavija ubala okwingila muumoyo wako,","poem":1},{"lineBreak":true},{"text":"na kutanga vinhu koinogeza loho yako,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"kusagula goya kokulola goya,","poem":1},{"lineBreak":true},{"text":"kuwa na nzewele ng'hani kokukaliza.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yokwika kutali na nzila za gehile,","poem":1},{"lineBreak":true},{"text":"na wanhu olonga mbuli zihile,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"na wanhu oleka nzila zigoloke,","poem":1},{"lineBreak":true},{"text":"ili wachole mnzila za ziza,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"na wanhu odeng'helela kusang'hana gehile,","poem":1},{"lineBreak":true},{"text":"na wanhu onogelwa kona gehile gosang'hanwa,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"na wanhu nzila zao hazigoloke,","poem":1},{"lineBreak":true},{"text":"na hawatamanilwa bule.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ubala okutenda ukale kutali na mtwanzi mgoni,","poem":1},{"lineBreak":true},{"text":"mtwanzi mgoni yotongoza.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mtwanzi yomuleka mbigalo wake wa undele wake,","poem":1},{"lineBreak":true},{"text":"kodibezeli lagano diyatendile kuulongozi wa Imulungu wake.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ng'anda yake yodidimila mwiiifa,","poem":1},{"lineBreak":true},{"text":"na nzila zake zochola kuzimu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Munhu yoyose yomcholela habule yonda yabwele,","poem":1},{"lineBreak":true},{"text":"na honda yavike mzinzila zichola muugima.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Avo upate kubita nzila ya wanhu wene haki,","poem":1},{"lineBreak":true},{"text":"na kuzigoga nzila za wang'alile.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Kwavija waja obita nzila igoloke opata isi,","poem":1},{"lineBreak":true},{"text":"na wang'alile ogendelela kukala mgati yake.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Lakini wehile osegesigwa mwiisi,","poem":1},{"lineBreak":true},{"text":"na wanhu osang'hana gehile ong'oligwa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}