{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PRO","translationId":"kdc_pbt","name":"Nongezi","commonName":"Nongezi","title":"Kitabu cha Nongezi Nongezi","order":20,"numberOfChapters":31,"sha256":"2463ed81d5cb7be5ed030cdceabb0efd8e5793b30c3eb1aae48c0b22f2c69c47","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kdc_pbt/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":23,"content":[{"type":"heading","content":["Nongezi ya 6"]},{"type":"verse","number":1,"content":[{"text":"Wahakala hamoja na mtawala kuna indiya,","poem":1},{"lineBreak":true},{"text":"mulole heyo yeli kuulongozi wako.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ikimile ng'hani kusulukila kwako ndiya,","poem":1},{"lineBreak":true},{"text":"hata kamba gweye kujaga ng'hani.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sikuusulukile ndiya zake zinogile,","poem":1},{"lineBreak":true},{"text":"vodaha kukuvizila.","poem":1}]},{"type":"heading","content":["Nongezi ya 7"]},{"type":"verse","number":4,"content":[{"text":"Sambi uigaze kuzahila ugoli,","poem":1},{"lineBreak":true},{"text":"uwe na nzewele na leka kutenda avo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kufing'hiliza na kufumbula ugoli ulawanya,","poem":1},{"lineBreak":true},{"text":"kamba ota mbawa,","poem":1},{"lineBreak":true},{"text":"uguluka kuulanga kamba mhungu.","poem":1}]},{"type":"heading","content":["Nongezi ya 8"]},{"type":"verse","number":6,"content":[{"text":"Sambi uje lujo lwa munhu mgila,","poem":1},{"lineBreak":true},{"text":"na sambi usulukile ndiya zake zinogile,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"kwavija moyo wake opeta chuuja.","poem":1},{"lineBreak":true},{"text":"Kokulongela, “Diya na ing'wa!”","poem":1},{"lineBreak":true},{"text":"Lakini moyo wake hauli hamoja na gweye.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kodeka kija kiudile,","poem":1},{"lineBreak":true},{"text":"na mbuli zose ziulavile za kumtogola zokuwa bule.","poem":1}]},{"type":"heading","content":["Nongezi ya 9"]},{"type":"verse","number":9,"content":[{"text":"Sikuulonge mbuli zako hamoja na mbozi,","poem":1},{"lineBreak":true},{"text":"kwavija kozibezeli mbuli zako za nzewele.","poem":1}]},{"type":"heading","content":["Nongezi ya 10"]},{"type":"verse","number":10,"content":[{"text":"Sambi usegese zimbaka za umwaka,","poem":1},{"lineBreak":true},{"text":"hebu kuwaboka wakiwa migunda yao,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"kwavija Imulungu ayo mkombola wao, kana udahi,","poem":1},{"lineBreak":true},{"text":"koigombela haki yao na gweye kokoneka kubananga.","poem":1}]},{"type":"heading","content":["Nongezi ya 11"]},{"type":"verse","number":12,"content":[{"text":"Tumia nzewele zako kukweleleza kuzumwa,","poem":1},{"lineBreak":true},{"text":"tumia magwiti gako kuhulika mbuli za kutanga vinhu.","poem":1}]},{"type":"heading","content":["Nongezi ya 12"]},{"type":"verse","number":13,"content":[{"text":"Sambi uleke kumzuma mwana,","poem":1},{"lineBreak":true},{"text":"wahamzabula mbalati hafa bule.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wahamzabula mbalati,","poem":1},{"lineBreak":true},{"text":"koukombola ugima wake na kuzimu.","poem":1}]},{"type":"heading","content":["Nongezi ya 13"]},{"type":"verse","number":15,"content":[{"text":"Mwanangu, kamba moyo wako wahawa na ubala,","poem":1},{"lineBreak":true},{"text":"moyo wangu vivija okuwa na deng'ho.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Moyo wangu odeng'helela,","poem":1},{"lineBreak":true},{"text":"mulomo wako wahalonga mbuli zinogile.","poem":1}]},{"type":"heading","content":["Nongezi ya 14"]},{"type":"verse","number":17,"content":[{"text":"Moyo wako sambi uwonele migongo weli na nzambi,","poem":1},{"lineBreak":true},{"text":"lakini gweye gendelela kumdumba Mndewa Imulungu siku zose.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kweli kuna siku zinogile ako kumwande,","poem":1},{"lineBreak":true},{"text":"na tamanilo jako honda jage bule.","poem":1}]},{"type":"heading","content":["Nongezi ya 15"]},{"type":"verse","number":19,"content":[{"text":"Tegeleza mwanangu, uwe na ubala,","poem":1},{"lineBreak":true},{"text":"na ulongoze moyo wako mwiinzila inogile.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Sambi uwe imoja wa wang'waji ugimbi,","poem":1},{"lineBreak":true},{"text":"na wamelo wa kulonda nyama,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"kwavija wang'waji na wamelo ohelela muukiwa,","poem":1},{"lineBreak":true},{"text":"na utulo owatenda wavale viwalo videgeke.","poem":1}]},{"type":"heading","content":["Nongezi ya 16"]},{"type":"verse","number":22,"content":[{"text":"Mtegeleze tatako yakulelile,","poem":1},{"lineBreak":true},{"text":"sambi umbezeli mamako yahawa mvele.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Gula ukweli, sambi uuchuuze,","poem":1},{"lineBreak":true},{"text":"gula ubala na mafundizo na nzewele,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tata wa mwana yeli na haki komema deng'ho,","poem":1},{"lineBreak":true},{"text":"na yolela mwana yeli na ubala kodeng'helela.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Wanogeze tatako na mamako,","poem":1},{"lineBreak":true},{"text":"mamako yakulelile yadeng'helele.","poem":1}]},{"type":"heading","content":["Nongezi ya 17"]},{"type":"verse","number":26,"content":[{"text":"Mwanangu, nitegeleze kwa moyo wako wose,","poem":1},{"lineBreak":true},{"text":"meso gako gakweleleze nzila zangu.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Mtwanzi mgoni kaigala na kolongo tali,","poem":1},{"lineBreak":true},{"text":"mwehe mgoni kaigala na kisima kisisili.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Heyo konyaluka kamba mbokaji,","poem":1},{"lineBreak":true},{"text":"kowahonza wambigalo wengi sambi watamaniligwe.","poem":1}]},{"type":"heading","content":["Nongezi ya 18"]},{"type":"verse","number":29,"content":[{"text":"Nani yotowa lukenze?","poem":1},{"lineBreak":true},{"text":"Nani yeli na lusikisiki?","poem":1},{"lineBreak":true},{"text":"Nani yeli na ndwagi?","poem":1},{"lineBreak":true},{"text":"Nani yoiyalala?","poem":1},{"lineBreak":true},{"text":"Nani yalumile bila chanduso?","poem":1},{"lineBreak":true},{"text":"Nani yeli na meso madung'hu?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Waja waiyeka kipindi chose wa mwiidivai,","poem":1},{"lineBreak":true},{"text":"waja ozahila divai ihanganyigwe.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Sambi uisulukile divai hata kamba yahawa ndung'hu,","poem":1},{"lineBreak":true},{"text":"hata kamba yometameta mkikonha,","poem":1},{"lineBreak":true},{"text":"na yohulumuka goya wahaing'wa.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Wahesha kuing'wa yoluma kamba nyoka,","poem":1},{"lineBreak":true},{"text":"yohoma kamba nyoka yeli na sumu.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Meso gako gokona maluweluwe,","poem":1},{"lineBreak":true},{"text":"moyo wako olava mbuli za chakachaka.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Koyona kotigisika kamba munhu yowasa mwiimeli kuno kuna kukuzumbi,","poem":1},{"lineBreak":true},{"text":"hebu munhu yatambalale mwiinzabi ya meli.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Kolonga, “Wanizabula, lakini silumile,","poem":1},{"lineBreak":true},{"text":"wanitowa, lakini sigesa.","poem":1},{"lineBreak":true},{"text":"Nolamuka lini?","poem":1},{"lineBreak":true},{"text":"Leka nizahile king'waji kiyagwe.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":35}