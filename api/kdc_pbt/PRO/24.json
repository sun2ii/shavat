{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PRO","translationId":"kdc_pbt","name":"Nongezi","commonName":"Nongezi","title":"Kitabu cha Nongezi Nongezi","order":20,"numberOfChapters":31,"sha256":"2463ed81d5cb7be5ed030cdceabb0efd8e5793b30c3eb1aae48c0b22f2c69c47","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kdc_pbt/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":24,"content":[{"type":"heading","content":["Nongezi ya 19"]},{"type":"verse","number":1,"content":[{"text":"Sikuuwonele migongo wanhu wehile,","poem":1},{"lineBreak":true},{"text":"na sikuusulukile kuwa hamoja nao,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"kwavija magesa gao gose ga muusede,","poem":1},{"lineBreak":true},{"text":"habule mbuli yoyose inogile ilawa mmilomo yao.","poem":1}]},{"type":"heading","content":["Nongezi ya 20"]},{"type":"verse","number":3,"content":[{"text":"Ng'anda yozengigwa kwa ubala,","poem":1},{"lineBreak":true},{"text":"na yogangamala kwa nzewele.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kwa kutanga vinhu magati gomemezwa,","poem":1},{"lineBreak":true},{"text":"gomemezwa vinhu va bei ng'hulu na vinogile.","poem":1}]},{"type":"heading","content":["Nongezi ya 21"]},{"type":"verse","number":5,"content":[{"text":"Munhu mwene ubala kana nguvu,","poem":1},{"lineBreak":true},{"text":"munhu yotanga vinhu kogangamala.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kwavija kwa ulongozi unogile kodaha kuitowa ng'hondo,","poem":1},{"lineBreak":true},{"text":"na mhumo yopatikana kwa kuwa na walava magesa wengi.","poem":1}]},{"type":"heading","content":["Nongezi ya 22"]},{"type":"verse","number":7,"content":[{"text":"Kwa munhu mbozi vidala kuutanga ubala,","poem":1},{"lineBreak":true},{"text":"mumting'hano halonga mbuli.","poem":1}]},{"type":"heading","content":["Nongezi ya 23"]},{"type":"verse","number":8,"content":[{"text":"Yogesa kusang'hana gehile,","poem":1},{"lineBreak":true},{"text":"kokemigwa galu wa gehile.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chochose choogesa mbozi kusang'hana nzambi,","poem":1},{"lineBreak":true},{"text":"na munhu yeli na bezi, ngevuzo kwa wanhu.","poem":1}]},{"type":"heading","content":["Nongezi ya 24"]},{"type":"verse","number":10,"content":[{"text":"Wahabwela kuchugu mmagazo,","poem":1},{"lineBreak":true},{"text":"nguvu zako ndodo.","poem":1}]},{"type":"heading","content":["Nongezi ya 25"]},{"type":"verse","number":11,"content":[{"text":"Wakombole wanhu ogaligwa kukomigwa,","poem":1},{"lineBreak":true},{"text":"sambi usinhagile kumkombola munhu yonda kukomigwa bila kitala.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kumwande sambi ulonge, “Hatutangile,”","poem":1},{"lineBreak":true},{"text":"kwavija Imulungu ayo yopima gaja geli mmizoyo ya wanhu,","poem":1},{"lineBreak":true},{"text":"heyo ayo yokaliza ugima wako,","poem":1},{"lineBreak":true},{"text":"komuliha kila munhu kwa sang'hano zake.","poem":1}]},{"type":"heading","content":["Nongezi ya 26"]},{"type":"verse","number":13,"content":[{"text":"Mwanangu, diya uki, uki unoga,","poem":1},{"lineBreak":true},{"text":"uki ulawa mdilala wamulile mmulomo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Vivo vonda uwe ubala muumoyo wako,","poem":1},{"lineBreak":true},{"text":"wahaupata kokuwa na siku zinogile ako kumwande,","poem":1},{"lineBreak":true},{"text":"na tamanilo jako honda jage bule.","poem":1}]},{"type":"heading","content":["Nongezi ya 27"]},{"type":"verse","number":15,"content":[{"text":"Sikuusepe kamba munhu yehile yovamila ukazi wa munhu mwene haki,","poem":1},{"lineBreak":true},{"text":"hebu kuinanga ng'anda yake.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kwavija hamoja munhu mwene haki kogwa miyanza mingi ila kokwinuka kabili,","poem":1},{"lineBreak":true},{"text":"lakini munhu yehile kobwanhigwa hasi na magazo.","poem":1}]},{"type":"heading","content":["Nongezi ya 28"]},{"type":"verse","number":17,"content":[{"text":"Sambi udeng'helele kugwa kwa ija yokwihila,","poem":1},{"lineBreak":true},{"text":"moyo wako sambi udeng'helele yahaikwala.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu yahagona ago honda yanogelwe,","poem":1},{"lineBreak":true},{"text":"na koisegesa kutali na heyo ng'hasiliki yake.","poem":1}]},{"type":"heading","content":["Nongezi ya 29"]},{"type":"verse","number":19,"content":[{"text":"Sambi ugevuzike mbuli ya wasang'hana gehile,","poem":1},{"lineBreak":true},{"text":"hebu kuwonela migongo wanhu wehile,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"kwavija yehile honda yawe na ganogile ako kumwande,","poem":1},{"lineBreak":true},{"text":"mulenge wa ugima wake ozimika.","poem":1}]},{"type":"heading","content":["Nongezi ya 30"]},{"type":"verse","number":21,"content":[{"text":"Mwanangu, mdumbe Mndewa Imulungu na mndewa,","poem":1},{"lineBreak":true},{"text":"sambi uilumbe na waja hawawategeleza.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Kwavija nhaguso yao yowapata kwa kusinhukiza,","poem":1},{"lineBreak":true},{"text":"habule yotanga madununzo gonda wagapate.","poem":1}]},{"type":"heading","content":["Mbuli ziyagwe za wanhu weli na ubala"]},{"type":"verse","number":23,"content":[{"text":"Zino nongezi za wanhu weli na ubala.","poem":1},{"lineBreak":true},{"text":"Kutagusa kwa kulola kihanga cha munhu hakunogile bule.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Munhu yoyose yomulongela munhu yabanange, “Gweye hubanange bule,”","poem":1},{"lineBreak":true},{"text":"koduwiligwa na wanhu wose,","poem":1},{"lineBreak":true},{"text":"na kokwihiligwa na wanhu wa isi zose.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Lakini wanhu owakoboza wasang'hana gehile opata deng'ho,","poem":1},{"lineBreak":true},{"text":"na ganogile gowezila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Waja owedika wayagwe kwa ukweli,","poem":1},{"lineBreak":true},{"text":"olagusa hewo mbwiga wa ukweli.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Tanhu sang'hana sang'hano zako kunze,","poem":1},{"lineBreak":true},{"text":"tanda migunda yako,","poem":1},{"lineBreak":true},{"text":"abaho zenga ng'anda yako.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Sikuulave usindila kwa miyago kwa mbuli haitendile,","poem":1},{"lineBreak":true},{"text":"hebu kumulonga kwa uvizi.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Sambi ulonge, “Nomtendela kamba heyo viyanitendele!","poem":1},{"lineBreak":true},{"text":"Nombwelezela kamba viyanitendele.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Nibita behi ya mgunda wa mnyeke,","poem":1},{"lineBreak":true},{"text":"mgunda wa mizabibu wa munhu hagelegeza goya.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Nikanganya kona ota miba,","poem":1},{"lineBreak":true},{"text":"mijani igubika mgunda wose,","poem":1},{"lineBreak":true},{"text":"na luwa lwake lwa mabwe lubomoka.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Ndola na kugelegeza ng'hani,","poem":1},{"lineBreak":true},{"text":"mhata mafundizo.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Wasa kidogo, kukila kidogo,","poem":1},{"lineBreak":true},{"text":"kunza mkono wako uhumule kidogo,","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"avo, ukiwa wako okuvamila kamba mbokaji,","poem":1},{"lineBreak":true},{"text":"na kuhungukilwa kokukweleleza kamba munhu mwene mgoha.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}