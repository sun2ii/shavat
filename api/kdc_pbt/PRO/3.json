{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PRO","translationId":"kdc_pbt","name":"Nongezi","commonName":"Nongezi","title":"Kitabu cha Nongezi Nongezi","order":20,"numberOfChapters":31,"sha256":"2463ed81d5cb7be5ed030cdceabb0efd8e5793b30c3eb1aae48c0b22f2c69c47","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kdc_pbt/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":3,"content":[{"type":"heading","content":["Usenga kwa wana"]},{"type":"verse","number":1,"content":[{"text":"Mwanangu, sikuugasemwe mafundizo gangu,","poem":1},{"lineBreak":true},{"text":"kwa moyo wako ugagoge malagizo gangu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kwavija zokongezela siku nyingi,","poem":1},{"lineBreak":true},{"text":"na miyaka ya ugima na tindiwalo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Unogelo hawishaga na kutamanilwa sambi viwe kutali na gweye.","poem":1},{"lineBreak":true},{"text":"Zifunge msingo yako,","poem":1},{"lineBreak":true},{"text":"zandike muumoyo wako.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Avo kotogoligwa na kugweleligwa nhogolwa kwa Imulungu na iwanhu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mtamanile Mndewa Imulungu kwa moyo wako wose,","poem":1},{"lineBreak":true},{"text":"sambi utamanile nzewele zako mwenyego.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Umtambule Imulungu mzisang'hano zako,","poem":1},{"lineBreak":true},{"text":"heyo kozigolosa nzila zako.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sikuuiyone gweye mwenyego kwa mbala,","poem":1},{"lineBreak":true},{"text":"mdumbe Mndewa Imulungu na uinege na gehile.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ayo yokuwa dawa mulukuli lwako,","poem":1},{"lineBreak":true},{"text":"na mavuta mmizege yako.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mtegeleze Mndewa Imulungu kwa vinhu vako na vija va ichanduso kusengigwa mmigunda yako yose.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Baho makanho gako gomemezigwa,","poem":1},{"lineBreak":true},{"text":"na viya vako vomema divai ya sambi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mwanangu sikuubeze kukobozigwa na Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"na sikuugevuzike vonda yakuzume.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kwavija Mndewa Imulungu komzuma ija yomnogela,","poem":1},{"lineBreak":true},{"text":"kamba tata viyomzuma mwanage iyomnogela.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kamweda munhu ija yopata ubala,","poem":1},{"lineBreak":true},{"text":"na munhu ija yopata nzewele ng'hani,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"avo vinoga kubanza shaba,","poem":1},{"lineBreak":true},{"text":"na vina faida kubanza zahabu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ubala unoga kubanza mabwe ga bei ng'hulu,","poem":1},{"lineBreak":true},{"text":"vinhu vose viusulukila haviigala na ubala.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ubala mumkono wake wa kudila kana siku nyingi,","poem":1},{"lineBreak":true},{"text":"na mumkono wake wa kumoso kuna utajili na kutegelezigwa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nzila zake zinoga, zose zolozela mditindiwalo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ubala ajo biki da ugima kwa wose omgoga,","poem":1},{"lineBreak":true},{"text":"wamweda wanhu wose omgoga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kwa ubala Mndewa Imulungu kaisimika isi,","poem":1},{"lineBreak":true},{"text":"kwa nzewele nyingi kawimiza ulanga.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kwa kutanga vinhu vidibo vitulika,","poem":1},{"lineBreak":true},{"text":"na mawingu galagaza tungwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Mwanangu, ugogeleze ubala na kusagula goya,","poem":1},{"lineBreak":true},{"text":"sikuuvileke visegele mgameso gako.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Avo vokuwa ugima muumoyo wako,","poem":1},{"lineBreak":true},{"text":"na dokuwa hambo dinogile mwiisingo yako.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Baho kodaha kuchola bila shaka,","poem":1},{"lineBreak":true},{"text":"na mgulu wako honda uikwale.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Wahawasa honda uwase kwa minyagu nyagu, kowasa utulo unogile.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Sikuudumbe ng'hondo ya kusinhukiza,","poem":1},{"lineBreak":true},{"text":"hebu unanzi onda uwavikile awo wehile,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"kwavija Mndewa Imulungu ajo tamanilo jako,","poem":1},{"lineBreak":true},{"text":"heyo kokukombola sikuwingile mumtego.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Sikuumwime munhu yolonda kutazigwa kuno gweye kodaha kumtaza.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Sikuumulongele miyago,","poem":1},{"lineBreak":true},{"text":"“Genda, mayo ubwele nokugwaa,” na kinhu acho choolonda kodaha kumgwaa lelo.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Sikuugelegeze gehile kwa miyago,","poem":1},{"lineBreak":true},{"text":"yokala behi na gweye na hakonela shaka.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Sikuugombe na munhu kamba kuduhu mbuli yoyose,","poem":1},{"lineBreak":true},{"text":"na munhu ayo hakutendile chochose.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Sikuumonele migongo munhu msede,","poem":1},{"lineBreak":true},{"text":"hebu kwiga nzila zake.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Kwavija wehile omgevuza Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"lakini heyo mbwiga wa waja osang'hana ganogile.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu koziduwila ng'anda za wehile,","poem":1},{"lineBreak":true},{"text":"na kozitambikila ng'anda za wene haki.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Heyo kowabezeli weli na bezi,","poem":1},{"lineBreak":true},{"text":"lakini kowagwaa ng'hekewa waja oibwanha hasi.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Weli na ubala ohazi kutegelezigwa,","poem":1},{"lineBreak":true},{"text":"lakini wabozi ogwa kinyala.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}