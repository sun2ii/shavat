{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PRO","translationId":"kdc_pbt","name":"Nongezi","commonName":"Nongezi","title":"Kitabu cha Nongezi Nongezi","order":20,"numberOfChapters":31,"sha256":"2463ed81d5cb7be5ed030cdceabb0efd8e5793b30c3eb1aae48c0b22f2c69c47","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kdc_pbt/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":30,"content":[{"type":"heading","content":["Ulonzi wa nzewele wa Aguli"]},{"type":"verse","number":1,"content":[{"text":"Mbuli za Aguli mwanage Yake, mbuli ziyawalongele Itieli na Ukali.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Niye na mbozi ng'hani, wala sili munhu,","poem":1},{"lineBreak":true},{"text":"nabule nzewele za kiunhu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Siifunzile kuwa na ubala,","poem":1},{"lineBreak":true},{"text":"vivija simtanga Imulungu yong'ala.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nani yakwelile kuulanga na kahulumuka hasi?","poem":1},{"lineBreak":true},{"text":"Nani yagogile beho mumkono?","poem":1},{"lineBreak":true},{"text":"Nani yafungile mazi mkitambala?","poem":1},{"lineBreak":true},{"text":"Nani yekile mbaka zose mwiisi?","poem":1},{"lineBreak":true},{"text":"Twaga jake nani?","poem":1},{"lineBreak":true},{"text":"Twaga da mwanage nani?","poem":1},{"lineBreak":true},{"text":"Nilongele kamba koditanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mbuli zose za Imulungu za kutamanilwa,","poem":1},{"lineBreak":true},{"text":"heyo ayo ngao ya wose omkimbilila.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sikuwengeze mbuli mzimbuli zake,","poem":1},{"lineBreak":true},{"text":"sambi yakukomhokele na gweye kokoneka kwa mvizi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mbuli zino mbili nokupula go Imulungu,","poem":1},{"lineBreak":true},{"text":"sambi unilemele ning'hali sinadanganika.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Unisegesele uvizi na bunyiko,","poem":1},{"lineBreak":true},{"text":"sikuunigwelele ukiwa hebu ugoli,","poem":1},{"lineBreak":true},{"text":"ungwelele ndiya ya kila siku,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"kwavija nahapata vinhu vingi nokulema na nolonga,","poem":1},{"lineBreak":true},{"text":"“Mndewa Imulungu ayo nani?”","poem":1},{"lineBreak":true},{"text":"Hebu sikuniwe mkiwa na kuwa mbavi,","poem":1},{"lineBreak":true},{"text":"na kudigela kinyala twaga da Imulungu wangu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Sikuumulongeleze mtumwa kwa mkulu wake,","poem":1},{"lineBreak":true},{"text":"buleavo kokuduwila na kokoneka kuna kitala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Hana wanhu owaduwila tata zao,","poem":1},{"lineBreak":true},{"text":"na hawawatambikila mama zao.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hana wanhu oyona wana haki,","poem":1},{"lineBreak":true},{"text":"kumbe wang'hali hawana sunhigwa gehile gao.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hana wanhu meso gao kamema kibuli,","poem":1},{"lineBreak":true},{"text":"obezeli kila kinhu chookona.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Hana wanhu meno gao kamba panga,","poem":1},{"lineBreak":true},{"text":"na magego gao kamba mwele,","poem":1},{"lineBreak":true},{"text":"waitanda kuwadafuna wakiwa weli mwiisi,","poem":1},{"lineBreak":true},{"text":"na welibule vinhu weli hagati ya wanhu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Luba kana wandele wabili olonga, “Ngwaa, ngwaa!”","poem":1},{"lineBreak":true},{"text":"Hana vinhu vidatu havitosheka, ona vinhu vine havilonga, “Yotosha!”","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kuzimu,","poem":1},{"lineBreak":true},{"text":"munda wa mtwanzi mgumba,","poem":1},{"lineBreak":true},{"text":"ulongo uleka kutosheka mazi,","poem":1},{"lineBreak":true},{"text":"na moto uleka kulonga, “Yotosha!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kamba munhu yahambezeli tatake,","poem":1},{"lineBreak":true},{"text":"na kumzalau mamake,","poem":1},{"lineBreak":true},{"text":"bondwa wa kudibonde ogadonyola meso gake,","poem":1},{"lineBreak":true},{"text":"na makinda ga mhungu ogaja.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Hana mbuli ndatu za unzonza kumwangu,","poem":1},{"lineBreak":true},{"text":"ona, mbuli nne sizitanga goya.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nzila ya mhungu kuulanga,","poem":1},{"lineBreak":true},{"text":"nzila ya mgendela hasi mdibwe,","poem":1},{"lineBreak":true},{"text":"nzila ya meli mbahali,","poem":1},{"lineBreak":true},{"text":"na kimkwega mbigalo kwa mtwanzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Nzila ya mtwanzi mgoni ya vino,","poem":1},{"lineBreak":true},{"text":"heyo kosang'hana ugoni na kokoga,","poem":1},{"lineBreak":true},{"text":"na kolonga, “Sibanange kinhu chochose!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Hana mbuli ndatu ziitigisa isi,","poem":1},{"lineBreak":true},{"text":"ona, mbuli nne haidaha kuzigoga.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mtumwa yokuwa mndewa,","poem":1},{"lineBreak":true},{"text":"munhu hakona kinyala kutenda gehile yokwiguta ndiya,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"mtwanzi yokwihiligwa kosoligwa,","poem":1},{"lineBreak":true},{"text":"na mtumwa wa kitwanzi yosola hanhu ha mama wa ing'anda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Hana viumbe vine vidodo ng'hani mwiisi,","poem":1},{"lineBreak":true},{"text":"lakini vina nzewele ng'hani.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Nyenyele wang'onyo welibule nguvu,","poem":1},{"lineBreak":true},{"text":"lakini oikila ndiya kipindi cha zuwa kali.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ndezi wanyama wadodo welibule nguvu,","poem":1},{"lineBreak":true},{"text":"lakini oitendela ng'anda mna gamabwe.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Nzige wabule mndewa,","poem":1},{"lineBreak":true},{"text":"lakini wose ochola hamoja kwa madali.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Guluguja kodaha kumgoga mmakono,","poem":1},{"lineBreak":true},{"text":"lakini kokwingila mng'anda ya mndewa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Hana viumbe vidatu vili na ugenzi wa magoda,","poem":1},{"lineBreak":true},{"text":"ona, hana viumbe vine vili na ugenzi wa magoda,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"simba mnyama yeli na nguvu kubanza wose,","poem":1},{"lineBreak":true},{"text":"heyo hamdumba mnyama yoyose iyagwe,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"nzogolo yotembela kwa magoda na mbuzi mbigalo,","poem":1},{"lineBreak":true},{"text":"na mndewa hamoja na wakalizi wake wamzunguluke.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Kamba kukala mbozi abaho koitapa,","poem":1},{"lineBreak":true},{"text":"hebu kukala ugesa gehile, leka na ugelegeze.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Kwavija wahakologa maziwa kopata siagi,","poem":1},{"lineBreak":true},{"text":"wahamtowa munhu mmhula kolawa mfung'hunyula,","poem":1},{"lineBreak":true},{"text":"vivija wahawasindilila wanhu olawilila ugomvi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PRO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}