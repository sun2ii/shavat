{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PRO","translationId":"kdc_pbt","name":"Nongezi","commonName":"Nongezi","title":"Kitabu cha Nongezi Nongezi","order":20,"numberOfChapters":31,"sha256":"2463ed81d5cb7be5ed030cdceabb0efd8e5793b30c3eb1aae48c0b22f2c69c47","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kdc_pbt/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":4,"content":[{"type":"heading","content":["Mafunzo ga ubala kulawa kwa tata"]},{"type":"verse","number":1,"content":[{"text":"Wanangu, tegelezeni mafunzo ga tataenu,","poem":1},{"lineBreak":true},{"text":"tegeni magwiti mupate nzewele.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kwavija nowagwaa malagizo ganogile,","poem":1},{"lineBreak":true},{"text":"sambi mugaleme mafundizo gangu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Niye vivija ng'hala mwana kwa tatangu,","poem":1},{"lineBreak":true},{"text":"ng'hala muhole, na mnogelwa wa mamangu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tatangu kanifunza kino,","poem":1},{"lineBreak":true},{"text":"“Zigoge mbuli zangu kwa moyo wako wose,","poem":1},{"lineBreak":true},{"text":"goga malagizo gangu na gweye kokuwa mgima.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bokela ubala bokela nzewele,","poem":1},{"lineBreak":true},{"text":"sambi uzisemwe hebu kuzileka mbuli zangu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sambi uuleke ubala nao okwika goya,","poem":1},{"lineBreak":true},{"text":"uunogele nao okukaliza.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ubala unoga kubanza vinhu vose,","poem":1},{"lineBreak":true},{"text":"avo upate ubala.","poem":1},{"lineBreak":true},{"text":"Kwa vinhu vako vose viuli navo upate nzewele.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Unogele ng'hani ubala nao okukweza,","poem":1},{"lineBreak":true},{"text":"ufagatile nao okugwaa nhogolwa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Okuvaza kilemba cha ng'hekewa mdipala jako,","poem":1},{"lineBreak":true},{"text":"okuvaza taji dinogile.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mwanangu, tegeleza na kuzibokela mbuli zangu,","poem":1},{"lineBreak":true},{"text":"ili ukale miyaka mingi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nikufunza nzila ya ubala,","poem":1},{"lineBreak":true},{"text":"nikulongoza mwiinzila igoloke.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wahatembela hatuwa zako honda zikimiligwe,","poem":1},{"lineBreak":true},{"text":"na wahakimbila honda uikwale.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gagoge mafundizo ga nzewele sikuugaleke gakupulusuke,","poem":1},{"lineBreak":true},{"text":"gagoge kwavija awo ugima wako.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sikuuingize mnzila za wehile,","poem":1},{"lineBreak":true},{"text":"hebu kukweleleza nzila za wehile.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Inege na nzila ayo, sambi ubite behi nayo,","poem":1},{"lineBreak":true},{"text":"inege kutali uchole.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wanhu wehile hawawasa mbaka wasang'hane gehile,","poem":1},{"lineBreak":true},{"text":"hawapata utulo mbaka wamgevuze munhu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kwavija gehile ayo ndiya yao,","poem":1},{"lineBreak":true},{"text":"usede ayo divai yao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Nzila za wanhu wene haki ziigala na zuwa da imitondo,","poem":1},{"lineBreak":true},{"text":"viding'ala ng'hani mbaka imisi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Lakini nzila za wehile kamba ziza kulu,","poem":1},{"lineBreak":true},{"text":"hawakitanga kiwahonzile waikwale.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mwanangu, zitegeleze goya mbuli zangu,","poem":1},{"lineBreak":true},{"text":"tega magwiti gako utegeleze ulonzi wangu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Sambi uzileke zisegele mgameso gako,","poem":1},{"lineBreak":true},{"text":"zike muumoyo wako.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Kwavija azo awo ugima kwa munhu yeli nazo,","poem":1},{"lineBreak":true},{"text":"na dawa mulukuli lwake lose.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ulole goya moyo wako kubanza vose viuvilola goya,","poem":1},{"lineBreak":true},{"text":"kwavija mumo muulawa ugima.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Inege kutali na ulonzi wihile,","poem":1},{"lineBreak":true},{"text":"na mulomo wako sikuulonge mbuli za uvizi.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Meso gako galole kuulongozi,","poem":1},{"lineBreak":true},{"text":"na ng'humbitu zako sikuzibwenze zilole bunhuu kuulongozi.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Uigelegeze ng'hani nzila yonda ubite,","poem":1},{"lineBreak":true},{"text":"na kila honda ukanyage hokuwa hanoga.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Sikuuhinduke ukudila hebu ukumoso,","poem":1},{"lineBreak":true},{"text":"usegese mgulu wako kutali na gehile.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}