{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PRO","translationId":"kdc_pbt","name":"Nongezi","commonName":"Nongezi","title":"Kitabu cha Nongezi Nongezi","order":20,"numberOfChapters":31,"sha256":"2463ed81d5cb7be5ed030cdceabb0efd8e5793b30c3eb1aae48c0b22f2c69c47","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kdc_pbt/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":5,"content":[{"type":"heading","content":["Kuzumwa mbuli ya ugoni"]},{"type":"verse","number":1,"content":[{"text":"Mwanangu, tegeleza ubala wangu,","poem":1},{"lineBreak":true},{"text":"tegeleza nzewele zangu nyingi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Vivo vonda udahe kusagula goya,","poem":1},{"lineBreak":true},{"text":"na mulomo wako ukalize vinhu vuutanga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mulomo wa mtwanzi mgoni wamulile kamba uki,","poem":1},{"lineBreak":true},{"text":"na mbuli zake zotelebuka kubanza mavuta,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"lakini kuuhelelo za usungu kamba sungu,","poem":1},{"lineBreak":true},{"text":"ng'hali kamba panga dili na makali kuno na kuno.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Migulu yake yolozela mwiifa,","poem":1},{"lineBreak":true},{"text":"hatua zake zolozela kuzimu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hayona nzila ichola kuugima,","poem":1},{"lineBreak":true},{"text":"nzila zake za kutanga tanga na hatanga bule.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Avo wanangu munitegeleze,","poem":1},{"lineBreak":true},{"text":"sikumuzisemwe mbuli zilawa mmulomo wangu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Inegeni kutali nzila zenu na heyo,","poem":1},{"lineBreak":true},{"text":"na sikumukwese behi ya mulango wa ng'anda yake.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sikuuwagwee wayagwe nguvu zako,","poem":1},{"lineBreak":true},{"text":"na wasede miyaka yako,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"na wageni sikuwegute mali zako,","poem":1},{"lineBreak":true},{"text":"na fuguti jako sikudishile mwiing'anda ya munhu iyagwe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kuuhelelo wa ugima wako kolila kwa usungu,","poem":1},{"lineBreak":true},{"text":"kipindi nyama na lukuli lwako vonda vilale,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"baho kolonga, “Habali nigehila mafundizo?","poem":1},{"lineBreak":true},{"text":"Na ndema kuzumigwa mmoyo wangu?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Na siihulike sauti ya wafundiza wangu,","poem":1},{"lineBreak":true},{"text":"na siwategeleze wanifundize.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sambi na mmabehi kubanangwa,","poem":1},{"lineBreak":true},{"text":"mumting'hano wa wanhu.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ing'wa mazi kulawa mkisima chako mwenyego","poem":1},{"noteId":0},{"text":",","poem":1},{"lineBreak":true},{"text":"mazi gokilima kulawa mkisima chako mwenyego.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Habali nzasa zako zipwililike kutali,","poem":1},{"lineBreak":true},{"text":"na vizanda va mazi mnzila?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Viwe vako wiiyeka,","poem":1},{"lineBreak":true},{"text":"sambi uilumbe na wanhu wayagwe.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nzasa yako inogeligwe,","poem":1},{"lineBreak":true},{"text":"umdeng'helele mwehe wako wa ubwanga wako.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Kanoga na kotembela goya kamba mhala,","poem":1},{"lineBreak":true},{"text":"matombo gake gakunogeze siku zose,","poem":1},{"lineBreak":true},{"text":"na gweye unogezwe na unogelo wake.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mwanangu habali kosoligwa na mtwanzi mgoni?","poem":1},{"lineBreak":true},{"text":"Habali kofagatila matombo ga mtwanzi wa munhu iyagwe?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Kwavija nzila za munhu za kuulongozi wa Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"heyo kochona kila kinhu chonda yasang'hane munhu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Gehile ga munhu yehile gomnamata heyo mwenyego,","poem":1},{"lineBreak":true},{"text":"nzabi za nzambi zake zomfunga heyo mwenyego.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Heyo kodanganika kwa kuswela kuzumwa,","poem":1},{"lineBreak":true},{"text":"na kwa ubozi wake kopotela.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Kung'wa mazi kulawa mkisima chako mwenyego, kwa kiebulaniya yofambula umuwase mwehe wako yaiyeka","reference":{"chapter":5,"verse":15}}]},"thisChapterLink":"/api/kdc_pbt/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PRO/4.json","previousChapterAudioLinks":{},"numberOfVerses":23}