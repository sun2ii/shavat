{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PRO","translationId":"kdc_pbt","name":"Nongezi","commonName":"Nongezi","title":"Kitabu cha Nongezi Nongezi","order":20,"numberOfChapters":31,"sha256":"2463ed81d5cb7be5ed030cdceabb0efd8e5793b30c3eb1aae48c0b22f2c69c47","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kdc_pbt/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":6,"content":[{"type":"heading","content":["Mazumo gayagwe"]},{"type":"verse","number":1,"content":[{"text":"Mwanangu, kamba kuilava kumzamini mbwigako,","poem":1},{"lineBreak":true},{"text":"na kamba kuilagana na munhu baki,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"kuifunga kwa mbuli zako mwenyego,","poem":1},{"lineBreak":true},{"text":"kuigoga kwa lagano jako diutendile mwenyego.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Avo, mwanangu tenda vino uikombole,","poem":1},{"lineBreak":true},{"text":"kwavija kuigela mmakono ga mbwigako,","poem":1},{"lineBreak":true},{"text":"wahalonda kuikombola genda kwa mbwigako ukaibwanhe na umpule yakulekese.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sikuuleke meso gako gapate utulo,","poem":1},{"lineBreak":true},{"text":"hebu ng'humbitu zako zikukile.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ikombole kwa kuilava mumtego awo,","poem":1},{"lineBreak":true},{"text":"ihonye kamba vija kigunga hebu ndege viyomtoloka msakaji.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Gweye mnyeke, kawalole muswa,","poem":1},{"lineBreak":true},{"text":"gelegeza viwokala upate ubala.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kwavija muswa kabule kilongozi,","poem":1},{"lineBreak":true},{"text":"hebu mkulu, hebu mndewa,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"lakini koikila ngama ya ndiya kipindi cha zuwa,","poem":1},{"lineBreak":true},{"text":"koilundiza hamoja ndiya yake kipindi cha kusenga.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gweye mnyeke kowasa aho mbaka lini?","poem":1},{"lineBreak":true},{"text":"Kolamuka lini muutulo wako?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kolonga, “Leka niwase kidogo, leka nikukile kidogo,","poem":1},{"lineBreak":true},{"text":"ndeke ng'hunze makono nihumule kidogo.”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kipindi acho ukiwa okuvamila kamba mbokaji,","poem":1},{"lineBreak":true},{"text":"na kuhungukilwa kokukweleleza kamba munhu mwene mgoha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Munhu yehile, hafaya kinhu,","poem":1},{"lineBreak":true},{"text":"kokwanga yolonga mbuli za uvizi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kokonyeza siso na kolava kilaguso kwa magulu,","poem":1},{"lineBreak":true},{"text":"na kolava kilaguso kwa vidole,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"kuno kamema gehile mgati ya moyo wake,","poem":1},{"lineBreak":true},{"text":"kopanga gehile.","poem":1},{"lineBreak":true},{"text":"Kogala migomvi kila hanhu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kwa mbuli ayo, gehile gomvika kwa kusinhukiza,","poem":1},{"lineBreak":true},{"text":"kwa kusinhukiza kobeneka vihile na honda yahone bule.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Hana vinhu sita vimgevuza Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"ona saba vimgela ludoko,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"meso ga kibuli,","poem":1},{"lineBreak":true},{"text":"lulimi luviza,","poem":1},{"lineBreak":true},{"text":"makono gokwita damu ilibule kitala,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"moyo ugesa magesa gehile,","poem":1},{"lineBreak":true},{"text":"magulu gabuhile kusang'hana gehile,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"munhu yolava usindila wa uvizi,","poem":1},{"lineBreak":true},{"text":"na munhu yogala migomvi hagati ha ndugu.","poem":1}]},{"type":"heading","content":["Kuzumwa mbuli ya ugoni"]},{"type":"verse","number":20,"content":[{"text":"Mwanangu goga malagizo ga tatako,","poem":1},{"lineBreak":true},{"text":"na sikuugaleke mafundizo ga mamako.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Siku zose kala nago muumoyo wako,","poem":1},{"lineBreak":true},{"text":"gafunge mwiisingo yako.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Gokulongoza mnzila zako,","poem":1},{"lineBreak":true},{"text":"gokukaliza kipindi wahawasa,","poem":1},{"lineBreak":true},{"text":"na gokugwaa magesa kipindi vonda ulamuke.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Kwavija malagizo gago, acho kiwenge,","poem":1},{"lineBreak":true},{"text":"na mafunzo gago, awo mulenge.","poem":1},{"lineBreak":true},{"text":"Mbuli azo zomzuma na zomfundiza munhu nzila ya ugima.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Gokwika kutali na mtwanzi yehile,","poem":1},{"lineBreak":true},{"text":"gokwika kutali na mbuli za kutewenza za mtwanzi mgoni.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Sikuumsulukile mtwanzi ayo kwa kunoga kwake,","poem":1},{"lineBreak":true},{"text":"na sikuutogole kunamatwa mzing'humbitu za meso gake.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Munhu kokwagiza kihande cha gate kwa mtwanzi mgoni,","poem":1},{"lineBreak":true},{"text":"lakini kwa mwehe wa munhu kokwagiza ugima wake wose.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Vino, kodaha kwika moto mhambaga yako abaho viwalo vako sikuvilukule?","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Vino, kodaha kukanyaga makala ga moto abaho migulu yako sikuilukule?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Vivo, vonda yawe mbigalo yonda yawase na mwehe wa miyage,","poem":1},{"lineBreak":true},{"text":"yoyose yonda yamkwase mtwanzi ayo honda yalekigwe bila kutagusigwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Munhu yaheba mbuli ya nzala, wanhu odaha kumgombela,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"lakini yahagogigwa kolondigwa yalihe miyanza saba,","poem":1},{"lineBreak":true},{"text":"na yalave vinhu vake vose viyeli navo.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Munhu yowasa na mwehe wa munhu hagelegeza goya,","poem":1},{"lineBreak":true},{"text":"kosang'hana mbuli yonda imbanange mwenyego.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Kopata vilonda na kubezigwa,","poem":1},{"lineBreak":true},{"text":"na kinyala chake honda kisemwigwe bule.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Kwavija wivu wa mbigalo okuwa mkulu ng'hani,","poem":1},{"lineBreak":true},{"text":"vonda yambwelezele kokuwa kabule bazi.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Honda yatogole malipo gogose,","poem":1},{"lineBreak":true},{"text":"honda yatogole hata kamba kogweleligwa nhunza nyingi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}