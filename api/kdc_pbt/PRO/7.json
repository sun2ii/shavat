{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PRO","translationId":"kdc_pbt","name":"Nongezi","commonName":"Nongezi","title":"Kitabu cha Nongezi Nongezi","order":20,"numberOfChapters":31,"sha256":"2463ed81d5cb7be5ed030cdceabb0efd8e5793b30c3eb1aae48c0b22f2c69c47","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kdc_pbt/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"Mwanangu, zigoge mbuli zangu,","poem":1},{"lineBreak":true},{"text":"geke goya malagizo gangu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gakweleleze malagizo gangu na gweye kokuwa mgima,","poem":1},{"lineBreak":true},{"text":"gakalize mafundizo gangu kamba mwana wa siso jako.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gafunge mvidole vako,","poem":1},{"lineBreak":true},{"text":"ugandike muumoyo wako.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Umulongele ubala, “Gweye kwa lumbu jangu,”","poem":1},{"lineBreak":true},{"text":"na nzewele, “Gweye kwa mbwigangu.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Vokwika kutali na mtwanzi yehile,","poem":1},{"lineBreak":true},{"text":"vokwika kutali na mbuli za kutewenza za mtwanzi mgoni.","poem":1}]},{"type":"heading","content":["Mtwanzi mgoni"]},{"type":"verse","number":6,"content":[{"text":"Siku dimoja nisungulila kunze,","poem":1},{"lineBreak":true},{"text":"mdidilisha da ng'anda yangu,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"nyona wabwanga wengi mizozolo,","poem":1},{"lineBreak":true},{"text":"hagati yao mbwanga imoja hagelegeza goya.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ayo kakala yotembela mnzila,","poem":1},{"lineBreak":true},{"text":"kakala behi na aho hoyokala mtwanzi imoja.","poem":1},{"lineBreak":true},{"text":"Avo kagoga nzila kachola kuna ing'anda ya mtwanzi ayo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ikala kipindi cha ichungulo ziza disonga kwingila.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ayo imbwanga kamting'hana ija imtwanzi kavala viwalo va ugoni na kakala na magesa ga uvizi mmoyo wake.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kakala mtwanzi yeli na gubu na mdulu,","poem":1},{"lineBreak":true},{"text":"magulu gake hagasinya mng'anda yake.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mala kamnzila mala kamdigulilo,","poem":1},{"lineBreak":true},{"text":"hahunguka mzimbwega mbwega za nzila kopelemba.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kamfagatila mbwanga ayo kamnonela,","poem":1},{"lineBreak":true},{"text":"na bila kinyala mkihanga kamulongela,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"“Kumwangu kuna nyama isigala kulawa kuna inhosa indavile,","poem":1},{"lineBreak":true},{"text":"lelo nigavikiza gaja ganiiduwile.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Lekaavo ndawa kukubokela,","poem":1},{"lineBreak":true},{"text":"nikuzahila ng'hani na nikona.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nhandika lusazi lwangu vinogile,","poem":1},{"lineBreak":true},{"text":"kwa bulangeti da langi ya kitani kulawa Misili.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nilugela mavumba ga manemane,","poem":1},{"lineBreak":true},{"text":"udi, na mdalasini.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Izo tuiwase mbaka imitondo,","poem":1},{"lineBreak":true},{"text":"avo tudeng'helele mapenzi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mkasano wangu kahabule mng'anda kachola mwanza mtali.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kasola mkoba wa sente,","poem":1},{"lineBreak":true},{"text":"kobwela mbalamwezi ikangale.”","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Kamtewenza kwa mbuli nyingi za kutewenza,","poem":1},{"lineBreak":true},{"text":"mbwanga ayo katogola kwa mbuli zake za umulile.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Kamuwinza ayo imtwanzi dimwe kwa dimwe,","poem":1},{"lineBreak":true},{"text":"kamba ng'ombe yochola kuchinjigwa,","poem":1},{"lineBreak":true},{"text":"kamba mbozi yafungigwe na yochola kukobozigwa.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Hatangile kamba ugima wake wa mdizumozumo,","poem":1},{"lineBreak":true},{"text":"mbaka viyonile kamba kahomigwa msale muumoyo,","poem":1},{"lineBreak":true},{"text":"kawa kamba ndege yanamate muulwavu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Avo wanangu zitegelezeni,","poem":1},{"lineBreak":true},{"text":"mbuli zilawa mmulomo wangu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Sambi mutogole kulongozigwa na mtwanzi kamba ayo,","poem":1},{"lineBreak":true},{"text":"hebu sambi mubite nzila zake.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Kwavija kawabwanha wambigalo wengi,","poem":1},{"lineBreak":true},{"text":"wengi ng'hani yawachinjile.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ng'anda yake nzila ya kuchola kuzimu.","poem":1},{"lineBreak":true},{"text":"Hanhu ha kuhulumukila mwiifa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}