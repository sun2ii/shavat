{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PRO","translationId":"kdc_pbt","name":"Nongezi","commonName":"Nongezi","title":"Kitabu cha Nongezi Nongezi","order":20,"numberOfChapters":31,"sha256":"2463ed81d5cb7be5ed030cdceabb0efd8e5793b30c3eb1aae48c0b22f2c69c47","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kdc_pbt/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":8,"content":[{"type":"heading","content":["Usenga wa ubala"]},{"type":"verse","number":1,"content":[{"text":"Tegelezeni ubala kokemelela,","poem":1},{"lineBreak":true},{"text":"nzewele yotowa lukenze.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Uchanha kulugongo behi na nzila mhanda,","poem":1},{"lineBreak":true},{"text":"baho kuyemile.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Behi na milango ya kwingilila kudibuga,","poem":1},{"lineBreak":true},{"text":"hanhu kuwokwingilila wanhu kokema kwa sauti,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"“Mweye wanhu wose,","poem":1},{"lineBreak":true},{"text":"nowakema mweye!","poem":1},{"lineBreak":true},{"text":"lukemo lwangu mbuli ya mweye iwanhu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mweye mizozolo, ifunzeni ubala,","poem":1},{"lineBreak":true},{"text":"mweye wabozi, gelegezeni goya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Munhegeleze kwavija gaja ganilonda kulonga ganoga,","poem":1},{"lineBreak":true},{"text":"mmulomo wangu molawa mbuli za haki.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mulomo wangu olonga ukweli wiiyeka,","poem":1},{"lineBreak":true},{"text":"nowihila uvizi kulawa mmulomo wangu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mulomo wangu olonga gaja ga haki,","poem":1},{"lineBreak":true},{"text":"mbuli za mulomo wangu hazipindile hebu kwiha.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kwa munhu mwene nzewele kila kinhu kigoloka,","poem":1},{"lineBreak":true},{"text":"kwa waja otanga vinhu gose ga haki.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sagula kuzumwa kwangu, badala ya shaba,","poem":1},{"lineBreak":true},{"text":"na kutanga vinhu badala ya zahabu ing'alile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kwavija ubala nofaya kubanza mabwe ga bei ng'hulu,","poem":1},{"lineBreak":true},{"text":"chochose chonda usulukile hakiigala na niye.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Niye ubala nokala na nzewele, na notanga vinhu na nosagula goya.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kumdumba Mndewa Imulungu kuigala na kwihila gehile,","poem":1},{"lineBreak":true},{"text":"nokihila kibuli na kuitapa,","poem":1},{"lineBreak":true},{"text":"na ukazi wihile, na ulonzi wihile.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nina udahi wa kulava ubala na kulamula vinogile.","poem":1},{"lineBreak":true},{"text":"Nina nzewele na nguvu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kubitila niye wandewa otawala,","poem":1},{"lineBreak":true},{"text":"wakulu otagusa kwa haki.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kwa bazi jangu vilongozi otawala,","poem":1},{"lineBreak":true},{"text":"na wakulu olamula.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nowanogela waja oninogela,","poem":1},{"lineBreak":true},{"text":"na waja onizahila onyona.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ugoli na heshima va kumwangu,","poem":1},{"lineBreak":true},{"text":"ugoli ukalaga na kumweda.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Matunda gangu ganoga kubanza zahabu ing'alile,","poem":1},{"lineBreak":true},{"text":"faida yangu inoga kubanza shaba inogile.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Notembela mwiinzila ya gaja golondigwa na Imulungu,","poem":1},{"lineBreak":true},{"text":"nokweleleza nzila ya haki.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Niye nowagwaa uhazi waja oninogela,","poem":1},{"lineBreak":true},{"text":"nozimemeza ngama zao waja oninogela.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Mndewa Imulungu kanilumba mwanduso wa sang'hano yake,","poem":1},{"lineBreak":true},{"text":"yang'hali hanalumba chochose.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Nitendigwa mwanduso kipindi acho,","poem":1},{"lineBreak":true},{"text":"isi ing'hali hainalumbigwa.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Nivumbuka ving'hali vidibo va bahali havinalumbigwa,","poem":1},{"lineBreak":true},{"text":"hebu nzasa hazikalile baho bule.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Vigongo ving'hali havinalumbigwa","poem":1},{"lineBreak":true},{"text":"na visugulu havinasimikigwa hanhu hake niye ng'hala baho,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"yang'hali hana ilumba isi na migunda,","poem":1},{"lineBreak":true},{"text":"wala timbwisi da isi hadinalumbigwa.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ng'hala baho kipindi viyalumbile ulanga,","poem":1},{"lineBreak":true},{"text":"viyacholile msitali wakulola kwa meso mkihanga cha bahali,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"kipindi viyaugangamize ulanga,","poem":1},{"lineBreak":true},{"text":"na kuzigwaa nguvu mbwibwi za mbahali,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"kipindi viyekile imbaka ya bahali,","poem":1},{"lineBreak":true},{"text":"mazi sikugabene lagizo jake,","poem":1},{"lineBreak":true},{"text":"na kipindi viyekile chandusilo cha isi.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ng'hala hamoja nayo kamba galu wa sang'hano,","poem":1},{"lineBreak":true},{"text":"ng'hala deng'helelo yake kila siku,","poem":1},{"lineBreak":true},{"text":"nideng'helela siku zose,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"noideng'helela isi na vose vikala mumo,","poem":1},{"lineBreak":true},{"text":"na deng'ho jangu dikala kwa wanhu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Avo, wanangu, nitegelezeni,","poem":1},{"lineBreak":true},{"text":"kwavija wamweda hewo okweleleza nzila zangu.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Tegelezeni mafundizo gangu mupate ubala,","poem":1},{"lineBreak":true},{"text":"sambi mugaleme.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Kamweda munhu yonitegeleza,","poem":1},{"lineBreak":true},{"text":"iyokala kila siku mmulango wangu,","poem":1},{"lineBreak":true},{"text":"iyokala behi na ikizingiti changu.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Yomhata niye kapata ugima,","poem":1},{"lineBreak":true},{"text":"konogeligwa na Mndewa Imulungu.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Yong'hosa niye koinanga mwenyego,","poem":1},{"lineBreak":true},{"text":"wose onihila niye onogelwa na ifa.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}