{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PRO","translationId":"kdc_pbt","name":"Nongezi","commonName":"Nongezi","title":"Kitabu cha Nongezi Nongezi","order":20,"numberOfChapters":31,"sha256":"2463ed81d5cb7be5ed030cdceabb0efd8e5793b30c3eb1aae48c0b22f2c69c47","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kdc_pbt/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":9,"content":[{"type":"heading","content":["Nzila ya ubala"]},{"type":"verse","number":1,"content":[{"text":"Ubala kamba munhu yazengile ng'anda yake,","poem":1},{"lineBreak":true},{"text":"ng'anda ili na mhanda saba","poem":1},{"noteId":1},{"text":".","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kachinja wanyama wa nyimwilinyimwili,","poem":1},{"lineBreak":true},{"text":"kaihanganya divai yake,","poem":1},{"lineBreak":true},{"text":"vivija kaitanda meza.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kawatuma wasang'hanaji zake wa kitwanzi kudibuga,","poem":1},{"lineBreak":true},{"text":"wawakeme wanhu kulawa kila hanhu henuke.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"“Munhu yoyose yeli zozolo yeze hano!”","poem":1},{"lineBreak":true},{"text":"Na kwa yoyose hagelegeza goya,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"“Izo uje ndiya,","poem":1},{"lineBreak":true},{"text":"na ung'we divai inihanganye.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mweye mizozolo lekeni kukala kamba avo ili mupate kuwa wagima,","poem":1},{"lineBreak":true},{"text":"kwelelezeni nzila ya nzewele.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yomzuma munhu yeli na bezi kokwambulila maligo,","poem":1},{"lineBreak":true},{"text":"yomkomhokela mtenda gehile kokwambulila kulumila.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sambi umzume munhu yeli na bezi kwavija kokwihila,","poem":1},{"lineBreak":true},{"text":"mzume munhu yeli na ubala, heyo kokunogela.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mfunze munhu yeli na ubala,","poem":1},{"lineBreak":true},{"text":"na heyo kokwengeza kuwa na ubala.","poem":1},{"lineBreak":true},{"text":"Mfunze mwene haki na heyo kogendelela kuifunza.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kumdumba Mndewa Imulungu awo mwanduso wa ubala,","poem":1},{"lineBreak":true},{"text":"na kumtanga ija yang'alile ako kuwa na nzewele.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kwa kutazigwa na niye ubala siku zako zokwengezigwa,","poem":1},{"lineBreak":true},{"text":"kokwengeziligwa miyaka mingi muugima wako.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kamba kuna ubala, okufaya gweye mwenyego,","poem":1},{"lineBreak":true},{"text":"na kamba wahaubezeli, gweye mwenyego ayo yonda upate hasala.","poem":1}]},{"type":"heading","content":["Nzila ya ubozi"]},{"type":"verse","number":13,"content":[{"text":"Mtwanzi mbozi kana gubu,","poem":1},{"lineBreak":true},{"text":"mbozi na hatanga kinhu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kokala hamulango wa ng'anda yake,","poem":1},{"lineBreak":true},{"text":"kokwika kigoda chake hanhu henuke kudibuga.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kowakema wanhu obita nzila,","poem":1},{"lineBreak":true},{"text":"awo ochola mna izisang'hano zao.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"“Munhu yoyose yeli zozolo yeze hano!”","poem":1},{"lineBreak":true},{"text":"Na kwa yoyose hagelegeza goya,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"“Mazi gebigwe gamulile ng'hani,","poem":1},{"lineBreak":true},{"text":"na gate didigwa kinyelegezi damulile ng'hani.”","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Lakini hatanga kamba wafile wamumo,","poem":1},{"lineBreak":true},{"text":"wageni wa mtwanzi ayo wa hasi kuzimu.","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Namba saba yolagusa kinhu kitelele","reference":{"chapter":9,"verse":1}}]},"thisChapterLink":"/api/kdc_pbt/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}