{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"heading","content":["ZABULI YA 1"]},{"type":"verse","number":1,"content":[{"text":"Kamweda imunhu hacholaga mvitala va iwanhu otenda gehile,","poem":1},{"lineBreak":true},{"text":"na hakwima bule mnzila ya iwanhu otenda nzambi,","poem":1},{"lineBreak":true},{"text":"na hakala bule mvigoda va iwanhu wagewezi,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"lakini kogadeng'helela malagizo ga Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"na kogagelegeza imisi na ikilo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ayo kaigala na biki dihandigwe kumgwazo wa vizanda,","poem":1},{"lineBreak":true},{"text":"dolela matunda mkipindi chake,","poem":1},{"lineBreak":true},{"text":"mijani yake hainyalaga.","poem":1},{"lineBreak":true},{"text":"Kila kinhu kiyotenda chomweda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Iwanhu wehile haweli vivo,","poem":1},{"lineBreak":true},{"text":"lakini waigala na mipepe ihembeluswa na beho.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Avo iwanhu wehile ogwa kipindi cha nhaguso,","poem":1},{"lineBreak":true},{"text":"na iwanhu wene nzambi honda wawe mumo mumting'hano wa iwanhu wanogile,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"kwavija Mndewa Imulungu koijuwa inzila ya iwanhu wanogile,","poem":1},{"lineBreak":true},{"text":"lakini inzila ya iwanhu wehile yohelela mkupotela.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/2SA/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}