{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"heading","content":["ZABULI YA 101"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Nokwimba unogelo wako hawishaga na haki yako,","poem":1},{"lineBreak":true},{"text":"gweye Mndewa Imulungu nokwimbila lwila lwa nhogolwa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Noigoga nzila igoloke.","poem":1},{"lineBreak":true},{"text":"Kokwiza lini kumwangu?","poem":1},{"lineBreak":true},{"text":"Niye nosang'hana kwa moyo unogile mng'anda yangu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sikwika mgameso gangu mbuli ya gehile.","poem":1},{"lineBreak":true},{"text":"Sang'hano ya awo otenda gehile noihila,","poem":1},{"lineBreak":true},{"text":"na niye siilumba na hewo bule.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Moyo wa udulu usegele kumwangu,","poem":1},{"lineBreak":true},{"text":"noinega na kila kinhu kihile.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Munhu yomdeta miyage niye nomsegesa,","poem":1},{"lineBreak":true},{"text":"simuleka imunhu yoitapa na mwene kibuli.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nowalola kwa ganogile iwanhu otamanilwa,","poem":1},{"lineBreak":true},{"text":"ili wakale hamoja na niye.","poem":1},{"lineBreak":true},{"text":"Wanhu weli na mizoyo inogile awo onda wanisang'hanile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Chakubimbi hakala bule mng'anda yangu,","poem":1},{"lineBreak":true},{"text":"Imunhu yolonga uvizi,","poem":1},{"lineBreak":true},{"text":"honda yeme kuulongozi wa meso gangu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Imitondo mbaka imitondo nowabananga,","poem":1},{"lineBreak":true},{"text":"wanhu wose wehile mwiisi.","poem":1},{"lineBreak":true},{"text":"Nowatenda wainege wose otenda gehile,","poem":1},{"lineBreak":true},{"text":"okala kutali na buga da Mndewa Imulungu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}