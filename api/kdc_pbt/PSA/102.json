{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":102,"content":[{"type":"heading","content":["ZABULI YA 102"]},{"type":"hebrew_subtitle","content":["(Kupula kwa munhu yeli mmagazo na yomulongela Mndewa Imulungu ago gomgaza.)"]},{"type":"verse","number":1,"content":[{"text":"Gweye Mndewa Imulungu, uhulike vinikupula,","poem":1},{"lineBreak":true},{"text":"kililo changu kikuvikile.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sikuufise kihanga chako siku ya magazo gangu,","poem":1},{"lineBreak":true},{"text":"utege gwiti jako unihulike,","poem":1},{"lineBreak":true},{"text":"siku nahakukema unidike himahima.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kwavija siku zangu zolawanya kamba yosi,","poem":1},{"lineBreak":true},{"text":"na mizege yangu yolukula kamba biwi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Moyo wangu utowigwa kamba mijani na kunyala,","poem":1},{"lineBreak":true},{"text":"ona noisemwa kuja ndiya yangu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mbuli ya kuiyalala kwa magazo,","poem":1},{"lineBreak":true},{"text":"mizege yangu iilumba na nyama yangu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nilinga kamba bundi yokala kuluwala,","poem":1},{"lineBreak":true},{"text":"na niigala na bundi yokala kuvihame.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nokala meso kamba kinega,","poem":1},{"lineBreak":true},{"text":"yokala yaiyeka uchanha ya ng'anda.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Iwanhu onihila onilonga imisi yose,","poem":1},{"lineBreak":true},{"text":"awo oiduwila akuno onitambula niye.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Noiyalala ng'hani na tozi diwa kamba ndiya yangu,","poem":1},{"lineBreak":true},{"text":"na king'waji changu nikihanganya na mahozi,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"mbuli ya ng'hasiliki yako na kugevuzika kwako,","poem":1},{"lineBreak":true},{"text":"na kwavija kuninula na kunitupa kutali.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Siku zangu kamba sisila da ichungulo,","poem":1},{"lineBreak":true},{"text":"ona nonyala kamba mijani.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Lakini gweye Mndewa Imulungu kokala na kutawala milele,","poem":1},{"lineBreak":true},{"text":"na twaga jako dokumbukigwa ulelo mbaka ulelo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gweye mwenyego kokwima na kojonela bazi buga da Sayuni,","poem":1},{"lineBreak":true},{"text":"kwavija ayo saa ya kujonela bazi,","poem":1},{"lineBreak":true},{"text":"kipindi kikigwe kivika,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"kwavija wasang'hanaji wako oganogela mabwe gake,","poem":1},{"lineBreak":true},{"text":"na wajonela bazi timbwisi jake.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Abaho iwanhu wa isi zose odidumba twaga da Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"na wandewa wose wa mwiisi odumba ukulu wake.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu vonda yadizenge Sayuni,","poem":1},{"lineBreak":true},{"text":"vonda yoneke muukulu wake,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"vonda yalole ukupula kwa iwanhu wakiwa,","poem":1},{"lineBreak":true},{"text":"hakubezeli kupula kwao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ulelo onda wize okwandikilwa gago,","poem":1},{"lineBreak":true},{"text":"wanhu onda walumbigwe omtogola Mndewa Imulungu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Kwavija kalola kulawa hanhu hake hong'ala,","poem":1},{"lineBreak":true},{"text":"kulawa kuulanga Mndewa Imulungu kailola isi,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ili yahulike kililo cha ayo yafungigwe,","poem":1},{"lineBreak":true},{"text":"na yawafungulile watagusigwe ifa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wanhu wadilonge twaga da Mndewa Imulungu ako Sayuni,","poem":1},{"lineBreak":true},{"text":"nhogolwa zake zolongwa ako Yelusalemu,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"wanhu wa isi ziyagwe na wandewa wahaiting'hana hamoja,","poem":1},{"lineBreak":true},{"text":"ili wamtambikile Mndewa Imulungu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Imulungu kazihungula nguvu zangu mnzila,","poem":1},{"lineBreak":true},{"text":"kazihungula siku zangu za ugima.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Avo nilonga, “Go Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"sikuunisegese hagati ha siku zangu,","poem":1},{"lineBreak":true},{"text":"gweye Mndewa miyaka yako yogendelela ulelo wose.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Aho haichanduso kusimika mhanda za isi,","poem":1},{"lineBreak":true},{"text":"na ulanga sang'hano ya makono gako.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Avo vosegela lakini gweye kosigala,","poem":1},{"lineBreak":true},{"text":"vose volala kamba viwalo,","poem":1},{"lineBreak":true},{"text":"na kamba viwalo kovisaula,","poem":1},{"lineBreak":true},{"text":"navo volawanya.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Lakini gweye kwa vivija,","poem":1},{"lineBreak":true},{"text":"na miyaka yako yabule uhelelo.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Wana wa iwasang'hanaji zako osigala,","poem":1},{"lineBreak":true},{"text":"na ulelo wao okala kuulongozi wako.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}