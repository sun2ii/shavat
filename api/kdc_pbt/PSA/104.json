{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":104,"content":[{"type":"heading","content":["ZABULI YA 104"]},{"type":"verse","number":1,"content":[{"text":"Gweye moyo wangu mtogole Mndewa Imulungu.","poem":1},{"lineBreak":true},{"text":"Gweye Mndewa Imulungu, Imulungu wangu,","poem":1},{"lineBreak":true},{"text":"gweye kwa mkulu ng'hani,","poem":1},{"lineBreak":true},{"text":"gweye kuivaza ukulu na nhogolwa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kuvala mulenge kamba kiwalo,","poem":1},{"lineBreak":true},{"text":"kuukunzula ulanga kamba panziya.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kazenga ukazi wake uchanha ya mazi ga kuulanga.","poem":1},{"lineBreak":true},{"text":"Kagatenda mawingu kamba mtuka wake,","poem":1},{"lineBreak":true},{"text":"kazumha uchanha ya mabawa ga beho.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kaditenda beho diwe msenga wake,","poem":1},{"lineBreak":true},{"text":"moto na milambi ya moto iwe wasang'hanaji wake.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kuisimika isi uchanha ya chandusilo chake,","poem":1},{"lineBreak":true},{"text":"sikuitigisike siku zose na milele.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kuigubika isi kwa bahali kamba kiwalo,","poem":1},{"lineBreak":true},{"text":"na mazi gavigubika vigongo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kukomhoka na mazi gakimbila,","poem":1},{"lineBreak":true},{"text":"kwa sauti ya ng'huwa mazi gakilima.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gakilima kulawa kuvigongo na gahumuluka kubonde,","poem":1},{"lineBreak":true},{"text":"mbaka hanhu haulondile.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kuchaga imbaka sikugabite,","poem":1},{"lineBreak":true},{"text":"na sikugabwele kuigubika isi yose.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kogala nzasa kubonde,","poem":1},{"lineBreak":true},{"text":"zobita hagati ya vigongo,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"zomng'weza kila mng'onyo wa kubonde,","poem":1},{"lineBreak":true},{"text":"mhunda luwala kokanha ng'hilu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kumgwazo okala ndege wa kuulanga,","poem":1},{"lineBreak":true},{"text":"hagati ya matambi olava sauti zao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kulawa kuulanga wako koving'weza vigongo,","poem":1},{"lineBreak":true},{"text":"isi iguta ndiya ya sang'hano yako.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Koyoteza mijani mbuli ya ng'ombe,","poem":1},{"lineBreak":true},{"text":"minoga mbuli ya munhu,","poem":1},{"lineBreak":true},{"text":"ili yapate ndiya kulawa mwiisi ayo,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"na divai imsamhuse munhu,","poem":1},{"lineBreak":true},{"text":"na mavuta yaking'aze kihanga chake,","poem":1},{"lineBreak":true},{"text":"na gate dimtende munhu yawe mgima.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mibiki ya Mndewa Imulungu nayo ishiba,","poem":1},{"lineBreak":true},{"text":"mielezi ya Lebanoni ayo ihandigwe.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mumo ndege ozenga mvulu zao,","poem":1},{"lineBreak":true},{"text":"na nyamkuta kazenga kae mdibiki.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kuvigongo vitali kuko kuweli mbuzi luwala,","poem":1},{"lineBreak":true},{"text":"mmihango mumo oifisaga ndezi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kuilumba mbalamwezi mbuli ya vipindi,","poem":1},{"lineBreak":true},{"text":"zuwa dojuwa saa ya kwingila.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Gweye kogala ziza na yokuwa ikilo,","poem":1},{"lineBreak":true},{"text":"abaho kila mnyama wa kumuhulo kolawa kunze.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wana simba ong'ula ozahila ndiya,","poem":1},{"lineBreak":true},{"text":"ozahila ndiya yao kulawa kwa Mndewa Imulungu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Zuwa dahalawa olawanya,","poem":1},{"lineBreak":true},{"text":"na otambalala mmihango yao.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Munhu kolawa kochola kuisang'hano,","poem":1},{"lineBreak":true},{"text":"na kosang'hana mbaka ichungulo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"lola vizili nyingi sang'hano zako,","poem":1},{"lineBreak":true},{"text":"kwa ubala kuvitenda vose.","poem":1},{"lineBreak":true},{"text":"Isi yose imema viumbe vako.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Bahali ya kuko ng'hulu na ina ugazi,","poem":1},{"lineBreak":true},{"text":"mumo vili vitembelaga havidahika kupetwa,","poem":1},{"lineBreak":true},{"text":"viumbe vili na ugima vidodo na vikulu.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Mumo zibita meli ng'hulu,","poem":1},{"lineBreak":true},{"text":"mumo yokala somba mkulu yokemigwa Lewiasani,","poem":1},{"lineBreak":true},{"text":"kumulumba yadambwae mumo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Awo wose okubeta gweye,","poem":1},{"lineBreak":true},{"text":"uwagwelele ndiya yao mkipindi chao.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Wahawagwelela, hewo okidondola,","poem":1},{"lineBreak":true},{"text":"wahaugolosa mkono wako,","poem":1},{"lineBreak":true},{"text":"hewo oshiba ganogile.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Wahakifisa kihanga chako,","poem":1},{"lineBreak":true},{"text":"hewo ogwaya,","poem":1},{"lineBreak":true},{"text":"wahaisegesa mhumuzi yao odanganika,","poem":1},{"lineBreak":true},{"text":"na odibwelela timbwisi jao.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Wahagala loho yako olumbigwa,","poem":1},{"lineBreak":true},{"text":"na gweye kokibweza kabili kihanga cha isi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Ukulu wa Mndewa Imulungu osigala milele.","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu yaideng'helele sang'hano yake.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Heyo koilola isi, nayo yogwaya,","poem":1},{"lineBreak":true},{"text":"kovikwasa vigongo, navo volava yosi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Nomwimbila Mndewa Imulungu ugima wangu wose,","poem":1},{"lineBreak":true},{"text":"nomtambikila Imulungu wangu vivino vinili mgima.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Go Mndewa Imulungu, unogezwe na kugesa kwangu,","poem":1},{"lineBreak":true},{"text":"kwavija niye nodeng'helela kukujuwa gweye.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Wanhu wene nzambi wasegeswe mwiisi,","poem":1},{"lineBreak":true},{"text":"wanhu otenda gehile sikuwoneke kabili.","poem":1},{"lineBreak":true},{"text":"Gweye moyo wangu mtogole Mndewa Imulungu.","poem":1},{"lineBreak":true},{"text":"Mtogoleni Mndewa Imulungu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}