{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":105,"content":[{"type":"heading","content":["ZABULI YA 105"]},{"type":"verse","number":1,"content":[{"text":"Mshukuluni Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"dikemeni twaga jake,","poem":1},{"lineBreak":true},{"text":"walongeleni iwanhu wa isi zose sang'hano zake.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mwimbileni heyo, mwimbileni nhogolwa,","poem":1},{"lineBreak":true},{"text":"walongeleni iwanhu sang'hano zake za unzonza.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Muigodele twaga jake ding'ala,","poem":1},{"lineBreak":true},{"text":"mizoyo ya awo omzahila Mndewa Imulungu ideng'helele.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mzahileni Mndewa Imulungu na nguvu zake,","poem":1},{"lineBreak":true},{"text":"zahileni kihanga chake siku zose.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kumbukeni sang'hano zake za unzonza ziyasang'hane,","poem":1},{"lineBreak":true},{"text":"vilaguso vake na nhaguso ziyalongile.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mweye ulelo wa msang'hanaji wake Abulahamu,","poem":1},{"lineBreak":true},{"text":"mweye wanage Yakobo yawasagule.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Heyo Mndewa Imulungu ayo Imulungu wetu,","poem":1},{"lineBreak":true},{"text":"isi yose imema nhaguso zake.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kodikumbuka lagano jake milele,","poem":1},{"lineBreak":true},{"text":"mbuli ija yailagize kwa ulelo elufu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lagano diyatendile na Abulahamu,","poem":1},{"lineBreak":true},{"text":"na kuiduwila kwake kwa Isaka.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kadigangamiza kwa Yakobo kamba lagizo,","poem":1},{"lineBreak":true},{"text":"na kwa Izilaeli kamba lagano da milele.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kalonga, “Nokugwaa gweye isi ya Kanaani,","poem":1},{"lineBreak":true},{"text":"iwe fungu da uhazi wako.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Viwakalile iwanhu wadodo,","poem":1},{"lineBreak":true},{"text":"ona wanhu kidogo na wanhu baki mgati yake,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"wakala tanga nzulule kulawa isi mbaka isi,","poem":1},{"lineBreak":true},{"text":"kulawa undewa umoja mbaka undewa uyagwe.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Hamulekile munhu yoyose yawagaze,","poem":1},{"lineBreak":true},{"text":"hata iwandewa kawakomhokela mbuli ya hewo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kalonga, “Sikumuwakwase iwanhu zangu niwasagule,","poem":1},{"lineBreak":true},{"text":"na sikumuwalumize watula ndagu zangu.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mndewa Imulungu kaikema nzala ize mwiisi,","poem":1},{"lineBreak":true},{"text":"kainanga ndiya yose waitamanile.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kamgala munhu kuulongozi wao,","poem":1},{"lineBreak":true},{"text":"Yusufu kauzigwa muutumwa.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wamulumiza magulu gake kwa mhingu,","poem":1},{"lineBreak":true},{"text":"wamfunga mizabi ya mizuma msingo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mbaka mkipindi cha kuvikiza mbuli yake,","poem":1},{"lineBreak":true},{"text":"gayalongile Mndewa Imulungu gamwizila.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mndewa wa Misili katuma wanhu wamfungula,","poem":1},{"lineBreak":true},{"text":"imkulu wa iwanhu kamulekesa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Kamtenda mkulu mng'anda yake,","poem":1},{"lineBreak":true},{"text":"kawa mwimilizi wa vinhu vake vose.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Kawalongoza iwakulu zake kamba viyalondile,","poem":1},{"lineBreak":true},{"text":"na kawafunza nzewele iwavele zake.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Izilaeli nayo kengila Misili,","poem":1},{"lineBreak":true},{"text":"Yakobo kawa munhu baki mwiisi ya Hamu.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu kawatenda iwanhu zake walele ng'hani,","poem":1},{"lineBreak":true},{"text":"kawatenda wengi kubanza awo owehila.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Kawahindula mizoyo wawehile wanhu zake,","poem":1},{"lineBreak":true},{"text":"wawatendela gehile wasang'hanaji zake.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Kamtuma msang'hanaji wake Musa,","poem":1},{"lineBreak":true},{"text":"na Haluni ayo iyamsagule.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Keka mbuli za unzonza hagati ya hewo,","poem":1},{"lineBreak":true},{"text":"na katenda unzonza mwiisi ya Hamu.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Kagala ziza na isi yose ikala ziza,","poem":1},{"lineBreak":true},{"text":"kwavija wailema mbuli yake.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Kagahindula mazi gao gawa damu,","poem":1},{"lineBreak":true},{"text":"kawakoma iwasomba wao.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Isi yao imema mibula,","poem":1},{"lineBreak":true},{"text":"mbaka kudigati da mndewa wao.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Imulungu viyalongile, mikonzi iza,","poem":1},{"lineBreak":true},{"text":"na mhani mwiisi yao yose.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Kawagalila mvula ya mabwe,","poem":1},{"lineBreak":true},{"text":"na mimwesa mwiisi yao.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Kaitowa mizabibu yao na mitini yao,","poem":1},{"lineBreak":true},{"text":"kaibena imibiki ili mwiisi yao.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Imulungu viyalongile mbalangulu weza,","poem":1},{"lineBreak":true},{"text":"na nzige hawapetwa.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Waija iminoga yose ya isi yao,","poem":1},{"lineBreak":true},{"text":"waija ndiya ya isi yao.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Kawakoma wana wose wa chaudele wa isi yao,","poem":1},{"lineBreak":true},{"text":"nguvu za ubwanga wao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Kawalava Waizilaeli akuno wapapa shaba na zahabu,","poem":1},{"lineBreak":true},{"text":"haduhu hata munhu imoja yaikwalile.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Misili ideng'helela viwasegele,","poem":1},{"lineBreak":true},{"text":"kwavija mbuli ya hewo wengilwa bwembwe.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Kakunzula wingu diwa ngubiko,","poem":1},{"lineBreak":true},{"text":"na moto umwemwesa ikilo.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Viwalondile kagala ng'hwale,","poem":1},{"lineBreak":true},{"text":"kawagwaa ndiya ya kuulanga mbaka washiba.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Kadigubula dibwe, mbwibwi ya mazi ilawa,","poem":1},{"lineBreak":true},{"text":"mazi gakilima kuluwala kamba lwanda.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Kwavija kaikumbuka mbuli yake ing'ala,","poem":1},{"lineBreak":true},{"text":"iyamgwelele Abulahamu imsang'hanaji wake.","poem":1}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Kawalava iwanhu zake kwa deng'ho,","poem":1},{"lineBreak":true},{"text":"awo yawasagule kwa nyila za deng'ho.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Kawagwaa isi za iwanhu wayagwe,","poem":1},{"lineBreak":true},{"text":"waihazi sang'hano ya iwenekae,","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"ili wagagoge malagizo gake,","poem":1},{"lineBreak":true},{"text":"na kugoga gaja goyolonga.","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu yatogolwe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/105.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/106.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/104.json","previousChapterAudioLinks":{},"numberOfVerses":45}