{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":106,"content":[{"type":"heading","content":["ZABULI YA 106"]},{"type":"verse","number":1,"content":[{"text":"Mtogoleni Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"Mshukuluni Mndewa Imulungu kwavija kanoga,","poem":1},{"lineBreak":true},{"text":"na unogelo wake hawishaga osigala milele.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nani yodaha kuzilonga sang'hano za Mndewa Imulungu?","poem":1},{"lineBreak":true},{"text":"Nani yodaha kuzilonga nhogolwa zake zose?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wamweda iwanhu otenda haki,","poem":1},{"lineBreak":true},{"text":"waja otenda ganogile kamba viilondigwa siku zose.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Gweye Mndewa Imulungu unikumbuke niye,","poem":1},{"lineBreak":true},{"text":"wahawanogela iwanhu zako.","poem":1},{"lineBreak":true},{"text":"Wahawakombola unitaze,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ili nigalole ganogile ga waja wauwasagule,","poem":1},{"lineBreak":true},{"text":"na nideng'helele hamoja na iwanhu wa isi yako,","poem":1},{"lineBreak":true},{"text":"na kuigoda hamoja na iwanhu wa uhazi wako.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tutenda nzambi hamoja na iwahenga zetu,","poem":1},{"lineBreak":true},{"text":"tutenda gehile, tubananga.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wahenga zetu ako Misili hawagelegeze mbuli zako za unzonza,","poem":1},{"lineBreak":true},{"text":"hawakumbuke ukulu wa unogelo wako hawishaga,","poem":1},{"lineBreak":true},{"text":"wakulema kuingema ya bahali ya Shamu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lakini kawakombola mbuli ya twaga jake,","poem":1},{"lineBreak":true},{"text":"kalagusa nguvu zake.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kaikomhokela bahali ya Shamu, nayo inyala,","poem":1},{"lineBreak":true},{"text":"kawalongoza mmazi mengi kamba kuluwala.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kawakombola na imunhu yowehila,","poem":1},{"lineBreak":true},{"text":"na kawahonya na iwanhu owehila.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mazi gawagubika awo owadeta,","poem":1},{"lineBreak":true},{"text":"hasigale hata munhu imoja.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Abaho wazitogola mbuli zake,","poem":1},{"lineBreak":true},{"text":"wamwimbila nhogolwa zake.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Lakini wazisemwa sang'hano zake himahima,","poem":1},{"lineBreak":true},{"text":"hawagabetile magesa gake.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ako kuluwala wakala osulukila ndiya ng'hani,","poem":1},{"lineBreak":true},{"text":"wamgeza Imulungu ako kudibawe.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kawagwelela gawalondile,","poem":1},{"lineBreak":true},{"text":"lakini kawagalila utamu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Wamonela migongo Musa ako kuing'hambi,","poem":1},{"lineBreak":true},{"text":"na Haluni ayo yong'ala wa Mndewa Imulungu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Isi igubuka immeza Datani,","poem":1},{"lineBreak":true},{"text":"igubika mting'hano wa Abilamu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Moto ukwaka kwa iwanhu owakweleleza,","poem":1},{"lineBreak":true},{"text":"milambi ya moto iwasakaza iwanhu wehile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Watenda kinyago cha ng'ombe ako Holebu,","poem":1},{"lineBreak":true},{"text":"wakitambikila kinyago kilumbuka.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Wauhindula ukulu wa Imulungu,","poem":1},{"lineBreak":true},{"text":"kwa kutambikila kinyago cha ng'ombe yajaga mijani.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wamsemwa Imulungu, mkombola wao,","poem":1},{"lineBreak":true},{"text":"yatendile vinhu vikulu mwiisi ya Misili.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Katenda mbuli za unzonza mwiisi ya Hamu,","poem":1},{"lineBreak":true},{"text":"na mbuli ng'hulu mna ibahali ya Shamu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Imulungu kalonga kamba kowabananga,","poem":1},{"lineBreak":true},{"text":"ila Musa ayo iyamsagule kema kuulongozi wake,","poem":1},{"lineBreak":true},{"text":"na kaikimila ng'hasiliki yake sikuiwanange.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Waibezeli isi ija inogile,","poem":1},{"lineBreak":true},{"text":"hawagatogole gaja gayalongile.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Waiyalala mvibanda vao,","poem":1},{"lineBreak":true},{"text":"hawaitegeleze sauti ya Mndewa Imulungu.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Abaho kawenulila mkono wake kaiduwila,","poem":1},{"lineBreak":true},{"text":"kamba kowakoma ako kuluwala,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"na kuwapwililisa ulelo wao hagati ya iwanhu wa isi ziyagwe,","poem":1},{"lineBreak":true},{"text":"na kuwaswaswanya isi ya kutali.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Wailumba kumtambikila Baali Peoli,","poem":1},{"lineBreak":true},{"text":"wazija zinhosa zilavigwe kwa imilungu ilibule ugima.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Wamgevuza Mndewa Imulungu kwa sang'hano zao,","poem":1},{"lineBreak":true},{"text":"mikubulo igaligwa hagati yao.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Abaho Finehasi kema kagala nhaguso,","poem":1},{"lineBreak":true},{"text":"mikubulo ikimilwa.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Kagesigwa kamba kana haki,","poem":1},{"lineBreak":true},{"text":"ulelo mbaka ulelo milele.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Wamgevuza hana gamazi ga Meliba,","poem":1},{"lineBreak":true},{"text":"Musa kagaya mbuli ya hewo.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Kwavija wamulema loho wa Imulungu,","poem":1},{"lineBreak":true},{"text":"kalonga bila kugesa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Hawawanangile iwanhu wa isi,","poem":1},{"lineBreak":true},{"text":"kamba Mndewa Imulungu viyawalagize.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Lakini waihanganya na iwanhu wa isi,","poem":1},{"lineBreak":true},{"text":"waifunza kusang'hana mbuli zao.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Wavitambikila vinyago vao,","poem":1},{"lineBreak":true},{"text":"kinhu acho kikala mtego kumwao.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Ona, walava wanao wa kimbigalo na wa ikitwanzi,","poem":1},{"lineBreak":true},{"text":"walava nhosa kwa vinyamkela.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Weta damu ilibule kitala,","poem":1},{"lineBreak":true},{"text":"damu ya wanao wa kimbigalo na wa ikitwanzi,","poem":1},{"lineBreak":true},{"text":"wawalava nhosa kwa vinyago va Kanaani,","poem":1},{"lineBreak":true},{"text":"isi igeligwa dikwe kwa damu.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Avo, wageligwa dikwe kwa sang'hano yao,","poem":1},{"lineBreak":true},{"text":"waleka kutamanilwa kwa Imulungu kamba wagoni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Avo Mndewa Imulungu kawagevuzikila wanhu zake,","poem":1},{"lineBreak":true},{"text":"kawehila iwanhu wa uhazi wake.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Kawagela mmakono ga iwanhu wa isi ziyagwe,","poem":1},{"lineBreak":true},{"text":"awo iwasede wawatawala.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Iwanhu owehila wawonela,","poem":1},{"lineBreak":true},{"text":"na wawatawala kwa nguvu.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Miyanza mingi Imulungu kawakombola wanhu zake,","poem":1},{"lineBreak":true},{"text":"lakini hewo wasagula kumulema,","poem":1},{"lineBreak":true},{"text":"wadidimila mzinzambi zao.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Lakini kagalola magazo gao,","poem":1},{"lineBreak":true},{"text":"viyahulike kililo chao.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Mbuli yao kadikumbuka lagano jake,","poem":1},{"lineBreak":true},{"text":"kawonela bazi kamba unogelo wake hawishaga viwili mkulu.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Kawatenda awo wawagogile wawonele bazi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"Go Mndewa Imulungu, Imulungu wetu,","poem":1},{"lineBreak":true},{"text":"tukombole, twike hamoja kulawa kwa iwanhu wa isi ziyagwe,","poem":1},{"lineBreak":true},{"text":"ili tudishukulu twaga jako ding'ala,","poem":1},{"lineBreak":true},{"text":"na tuzigodele nhogolwa zako.","poem":1}]},{"type":"line_break"},{"type":"verse","number":48,"content":[{"text":"Yatogolwe Mndewa Imulungu, Imulungu wa Izilaeli,","poem":1},{"lineBreak":true},{"text":"kulawa milele mbaka milele.","poem":1},{"lineBreak":true},{"text":"Wanhu wose walonge, “Ona!”","poem":1},{"lineBreak":true},{"text":"Yatogolwe Mndewa Imulungu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}