{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":107,"content":[{"type":"heading","content":["ZABULI YA 107"]},{"type":"verse","number":1,"content":[{"text":"Mshukuluni Mndewa Imulungu kwavija kanoga,","poem":1},{"lineBreak":true},{"text":"unogelo wake hawishaga okala milele.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wanhu wakomboligwe na Mndewa Imulungu walonge vivo,","poem":1},{"lineBreak":true},{"text":"awo yawakombole mmagazo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kawating'haniza kulawa mziisi zose,","poem":1},{"lineBreak":true},{"text":"kulawa mwambu wa kudilawila zuwa na kudihongela,","poem":1},{"lineBreak":true},{"text":"kulawa kasikazini na kusini.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wakala tanga nzulule kuluwala,","poem":1},{"lineBreak":true},{"text":"hawajone buga da kukala.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wona nzala na ng'hilu,","poem":1},{"lineBreak":true},{"text":"mizoyo yao isinduka.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wamulilila Mndewa Imulungu mmagazo gao,","poem":1},{"lineBreak":true},{"text":"kawakombola mmadununzo gao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kawalongoza kwa nzila igoloke,","poem":1},{"lineBreak":true},{"text":"mbaka wavika kudibuga da kukala.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Avo, wamshukulu Mndewa Imulungu kwa unogelo wake hawishaga,","poem":1},{"lineBreak":true},{"text":"na unzonza wake kwa iwanhu wose.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Heyo kodigwaa mazi zoyo dikona ng'hilu,","poem":1},{"lineBreak":true},{"text":"na loho ikona nzala koigwaa ganogile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Wayagwe wakala kudiziza na vihame,","poem":1},{"lineBreak":true},{"text":"wafungwa mmagazo na minyololo,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"kwavija wailema mbuli ya Imulungu,","poem":1},{"lineBreak":true},{"text":"wagabezeli magesa ga ayo yeli Uchanha Ng'hani.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wadonha kwa sang'hano ngaga,","poem":1},{"lineBreak":true},{"text":"wagwa hasi, kuduhu munhu wa kuwataza.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wamulilila Mndewa Imulungu mmagazo gao,","poem":1},{"lineBreak":true},{"text":"kawakombola mmadununzo gao.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kawalava kudiziza na ukiwa,","poem":1},{"lineBreak":true},{"text":"minyololo yao kaibena bena.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Avo, wamshukulu Mndewa Imulungu kwa unogelo wake hawishaga,","poem":1},{"lineBreak":true},{"text":"na unzonza wake kwa iwanhu wose.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kwavija kaibena milango ya shaba,","poem":1},{"lineBreak":true},{"text":"kaibena mizuma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Wayagwe wakala wabozi mbuli ya nzambi zao,","poem":1},{"lineBreak":true},{"text":"wagazwa kwa gehile gao,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ndiya ikala usungu kumwao,","poem":1},{"lineBreak":true},{"text":"walonda kudanganika.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Avo mmagazo gao wamulilila Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"heyo kawakombola mmadununzo gao.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Koituma mbuli yake iwahonye,","poem":1},{"lineBreak":true},{"text":"kowalava mwiiifa yao.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Avo, wamshukulu Mndewa Imulungu kwa unogelo wake hawishaga,","poem":1},{"lineBreak":true},{"text":"na unzonza wake kwa iwanhu wose.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Wamulavile nhosa za kumshukulu,","poem":1},{"lineBreak":true},{"text":"na wazilonge sang'hano zake kwa nyila za deng'ho.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Wayagwe wakala mmwanza mbahali kwa meli,","poem":1},{"lineBreak":true},{"text":"awo wasang'hane mmazi mengi.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Awo wazona sang'hano za Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"na unzonza wake mgamazi mengi.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Kalonga na kukuzumbi dilawila,","poem":1},{"lineBreak":true},{"text":"ng'humbi ya bahali inuka uchanha.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Gakwela uchanha kuulanga,","poem":1},{"lineBreak":true},{"text":"abaho hasi mvidibo,","poem":1},{"lineBreak":true},{"text":"mizoyo yao ilumbuka kwa mbuli ayo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Wachola wahembeluka kamba munhu yakoligwe,","poem":1},{"lineBreak":true},{"text":"ubala wao wose upotela.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Wamulilila Mndewa Imulungu mmagazo gao,","poem":1},{"lineBreak":true},{"text":"kawakombola mmadununzo gao.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Kaihoza ng'humbi nayo inyamala tuluu,","poem":1},{"lineBreak":true},{"text":"mazi gasafuke ganyamala.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Avo wadeng'helela kwavija inyamala tuluu,","poem":1},{"lineBreak":true},{"text":"kawagala mbaka kudiloko diwalondile.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Avo, wamshukulu Mndewa Imulungu kwa unogelo wake hawishaga,","poem":1},{"lineBreak":true},{"text":"na unzonza wake kwa iwanhu wose.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Wamtogole hagati ha umting'hano wa iwanhu,","poem":1},{"lineBreak":true},{"text":"wamgwee ukulu mkitala cha iwavele.","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Kavihindula vizanda viwa luwala,","poem":1},{"lineBreak":true},{"text":"na mbwibwi za mazi zigalamuka isi inyalile.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Isi ya matunda mengi igalamuka isi ya mkele,","poem":1},{"lineBreak":true},{"text":"kwa gehile ga awo okala mumo.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Kahindula luwala luwa lamba,","poem":1},{"lineBreak":true},{"text":"isi inyalile iwa mazi gokilima.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Kaweka wene nzala kuko,","poem":1},{"lineBreak":true},{"text":"na watenda buga da kukala.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Wahanda mbeyu mmigunda,","poem":1},{"lineBreak":true},{"text":"na vivija mgunda uyagwe wahanda mizabibu,","poem":1},{"lineBreak":true},{"text":"wasenga ndiya na matunda.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Kawatenda wamwede na kongezeka ng'hani,","poem":1},{"lineBreak":true},{"text":"na fugo yao haihungule.","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Abaho iwanhu wa Imulungu wahunguka na kuhumuluswa,","poem":1},{"lineBreak":true},{"text":"kwavija oneligwa na gehile na wanyunyuwala.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Kawabezeli iwakulu wawadununze,","poem":1},{"lineBreak":true},{"text":"kawawegeza kuluwala hanhu haduhu nzila.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Lakini kawakombola iwanhu mmagazo gao,","poem":1},{"lineBreak":true},{"text":"kawongeza ulelo wao kamba bumbila da ng'hondolo.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Wanhu wanogile viwachone kinhu acho wadeng'helela,","poem":1},{"lineBreak":true},{"text":"lakini wanhu wehile wanyamala tuluu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Wanhu wene ubala wagalole gago,","poem":1},{"lineBreak":true},{"text":"na waugelegeze unogelo hawishaga wa Mndewa Imulungu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/107.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/108.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/106.json","previousChapterAudioLinks":{},"numberOfVerses":43}