{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":108,"content":[{"type":"heading","content":["ZABULI YA 108"]},{"type":"hebrew_subtitle","content":["(Lwila na Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Gweye Imulungu, moyo wangu ugangamala,","poem":1},{"lineBreak":true},{"text":"nokwimba lwila lwa nhogolwa kwa moyo wangu wose.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lamuka gweye bango na kilimba,","poem":1},{"lineBreak":true},{"text":"noulamusa imitondo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gweye Mndewa Imulungu nokushukulu hagati ha iwanhu,","poem":1},{"lineBreak":true},{"text":"nokwimbila lwila hagati ha iwanhu wa isi zose.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kwavija unogelo wako hawishaga uvika mbaka uchanha kuulanga,","poem":1},{"lineBreak":true},{"text":"na kutamanilwa kwako mbaka mmawingu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Gweye Imulungu utogolwe uchanha kuulanga,","poem":1},{"lineBreak":true},{"text":"na hasi mwiisi ukale ukulu wako.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Awo wauwanogela wakomboligwe,","poem":1},{"lineBreak":true},{"text":"ukombole kwa mkono wako wa ukudila na unidike.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Imulungu kalonga kwa ukung'ala kwake,","poem":1},{"lineBreak":true},{"text":"“Kwa kuhuma noigola isi ya Shekemu,","poem":1},{"lineBreak":true},{"text":"na nodipima vihande vihande bonde da Sukoti.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Isi ya Gileadi yangu niye na isi ya Manase yangu niye,","poem":1},{"lineBreak":true},{"text":"isi ya Efulaimu ayo kamba kofia yangu ya zuma,","poem":1},{"lineBreak":true},{"text":"isi ya Yuda ayo kamba fimbo yangu ya utawala.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Isi ya Moabu ayo kamba bakuli jangu da kunawila,","poem":1},{"lineBreak":true},{"text":"kwa isi ya Edomu notupa kilatu changu,","poem":1},{"lineBreak":true},{"text":"na niye nodeng'helela kwa kuwahuma Wafilisiti.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nani yonda yanigale kudibuga dizungulukwe na luwa lwa mabwe?","poem":1},{"lineBreak":true},{"text":"Nani yonda yanilongoze mbaka Edomu?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gweye, Imulungu siyo gweye utulemile siye?","poem":1},{"lineBreak":true},{"text":"Gweye Imulungu hucholile na siye kuing'hondo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ututaze mbuli ya iwanhu otwihila,","poem":1},{"lineBreak":true},{"text":"kwavija msaada wa munhu haufaya kinhu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Imulungu yahakala na siye tohuma,","poem":1},{"lineBreak":true},{"text":"na heyo kowabojoga hasi iwanhu otwihila.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}