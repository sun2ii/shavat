rue},{"text":"kwa meso gake kowalola iwanhu,","poem":1},{"lineBreak":true},{"text":"na kojuwa gose gotendigwa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu, kowageza iwanhu wanogile,","poem":1},{"lineBreak":true},{"text":"lakini kowehila iwanhu wehile na iwanhu wasede.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kowatowela iwanhu wehile mvula ya makala ga moto,","poem":1},{"lineBreak":true},{"text":"moto na mabwe gokwaka na vuke dokuwa fungu jao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kwavija Mndewa Imulungu kotenda ganogile,","poem":1},{"lineBreak":true},{"text":"konogezwa na ganogile,","poem":1},{"lineBreak":true},{"text":"iwanhu wanogile ochona kihanga chake.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}