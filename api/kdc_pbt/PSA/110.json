{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"heading","content":["ZABULI YA 110"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Mndewa Imulungu komulongela Mndewa wangu,","poem":1},{"lineBreak":true},{"text":"“Kala umwambu wa mkono wangu wa ukudila","poem":1},{"lineBreak":true},{"text":"mbaka niwatende iwanhu okwihila kigoda cha kwikila magulu gako.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mndewa Imulungu koweneza undewa wako kulawa Sayuni,","poem":1},{"lineBreak":true},{"text":"uwatawale hagati ya wose okwihila gweye.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wanhu zako okwizila kwa kulonda wenyego siku yako ya ng'hondo.","poem":1},{"lineBreak":true},{"text":"Kuno kuvala viwalo ving'ala,","poem":1},{"lineBreak":true},{"text":"wabwanga zako okwizila kamba tungwe da imitondo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mndewa Imulungu kaiduwila na hagimbula bule,","poem":1},{"lineBreak":true},{"text":"“Gweye kwa mulava nhosa milele,","poem":1},{"lineBreak":true},{"text":"muulava nhosa wa Melikizedeki.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mndewa ka umwambu wa mkono wako wa ukudila.","poem":1},{"lineBreak":true},{"text":"Kowahonda wandewa siku ya kugevuzika kwake.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kowatagusa wanhu wa isi zose,","poem":1},{"lineBreak":true},{"text":"isi yose yomema mitufi ya wanhu wadanganike,","poem":1},{"lineBreak":true},{"text":"kowahonda iwakulu kila hanhu mwiisi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mndewa kong'wa mazi ga lwanda mnzila,","poem":1},{"lineBreak":true},{"text":"na kokwinula pala jake kwa mhumo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}