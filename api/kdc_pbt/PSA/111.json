{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":111,"content":[{"type":"heading","content":["ZABULI YA 111"]},{"type":"verse","number":1,"content":[{"text":"Mtogoleni Mndewa Imulungu!","poem":1},{"lineBreak":true},{"text":"Nomshukulu Mndewa Imulungu kwa moyo wangu wose,","poem":1},{"lineBreak":true},{"text":"mumting'hano wa iwanhu weli na mizoyo igoloke.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sang'hano za Mndewa Imulungu ukulu bae,","poem":1},{"lineBreak":true},{"text":"wose ozideng'helela ozigelegeza.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kila kinhu kiyotenda kimema ukulu na unovu,","poem":1},{"lineBreak":true},{"text":"haki yake yosigala milele.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Katenda sang'hano zake za unzonza zikumbukwe,","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu kanoga na kana bazi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kowagwaa ndiya awo omdumba,","poem":1},{"lineBreak":true},{"text":"haisemwa ng'o lagano jake.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kawalagusila wanhu zake nguvu ya sang'hano zake,","poem":1},{"lineBreak":true},{"text":"kawagwaa uhazi wa iwanhu wayagwe uwe wao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sang'hano zake za haki na kweli,","poem":1},{"lineBreak":true},{"text":"malagizo gake gose gotamanilwa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Malagizo gake gosigala siku zose na milele,","poem":1},{"lineBreak":true},{"text":"kagalonga mna ihaki na ukweli.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kawakombola wanhu zake,","poem":1},{"lineBreak":true},{"text":"katenda nao lagano dikalaga milele.","poem":1},{"lineBreak":true},{"text":"Twaga jake ding'ala na dodumbigwa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kumdumba Mndewa Imulungu acho chandusilo cha ubala,","poem":1},{"lineBreak":true},{"text":"wose ogagoga malagizo gake ogweleligwa nzewele.","poem":1},{"lineBreak":true},{"text":"Nhogolwa zake zosigala milele.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}