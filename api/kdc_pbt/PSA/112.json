{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"heading","content":["ZABULI YA 112"]},{"type":"verse","number":1,"content":[{"text":"Mtogoleni Mndewa Imulungu!","poem":1},{"lineBreak":true},{"text":"Kamweda imunhu yomdumba Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"imunhu yodeng'helela ng'hani kugoga malagizo gake.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ulelo wake okuwa na nguvu mwiisi,","poem":1},{"lineBreak":true},{"text":"wana wa iwanhu wanogile omweda.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mng'anda yake kokuwa na mali nyingi,","poem":1},{"lineBreak":true},{"text":"haki yake yosigala milele.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Munhu yanogile komwemweselwa mulenge kuziza,","poem":1},{"lineBreak":true},{"text":"munhu mwene bazi na moyo unogile na haki.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Munhu yokopesha bila kulonda nyongeza, komweda ng'hani,","poem":1},{"lineBreak":true},{"text":"munhu yotenda sang'hano zake kwa haki.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mwene haki halemelwa ng'o,","poem":1},{"lineBreak":true},{"text":"heyo kokumbukwa milele.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Hadumba yahapata usenga wihile,","poem":1},{"lineBreak":true},{"text":"moyo wake ugangamala na komtamanila Mndewa Imulungu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Moyo wake ugangamala na hadumba kinhu,","poem":1},{"lineBreak":true},{"text":"na kowona iwanhu omwihila olemelwa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kowagwaa wakiwa vinhu kwa moyo unogile,","poem":1},{"lineBreak":true},{"text":"haki yake yosigala milele.","poem":1},{"lineBreak":true},{"text":"Heyo kokuwa na nguvu na kotegelezwa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wanhu wehile ogona gago na ogevuzika,","poem":1},{"lineBreak":true},{"text":"odafuna meno kwa usungu na ohomba,","poem":1},{"lineBreak":true},{"text":"kusulukila kwa munhu yehile hakulawila bule.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}