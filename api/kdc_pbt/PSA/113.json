{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"heading","content":["ZABULI YA 113"]},{"type":"verse","number":1,"content":[{"text":"Mndewa Imulungu yatogolwe!","poem":1},{"lineBreak":true},{"text":"Mtogoleni Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"mweye iwasang'hanaji zake,","poem":1},{"lineBreak":true},{"text":"ditogoleni twaga da Mndewa Imulungu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Twaga da Mndewa Imulungu ditogolwe,","poem":1},{"lineBreak":true},{"text":"sambi na milele.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kulawa kudilawa zuwa mbaka kudiswela,","poem":1},{"lineBreak":true},{"text":"twaga da Mndewa Imulungu ditogolwe!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kotawala uchanha ya iwanhu wa isi zose,","poem":1},{"lineBreak":true},{"text":"ukulu wake uvika uchanha kuulanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nani kamba Mndewa Imulungu, Imulungu wetu?","poem":1},{"lineBreak":true},{"text":"Heyo kakala uchanha kuulanga,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"kolola hasi yalole ulanga na isi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Komwinula mkiwa kulawa mmitimbwisi,","poem":1},{"lineBreak":true},{"text":"na komkweza ngaengae kulawa mdizalala.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Komwika hamoja na iwakulu,","poem":1},{"lineBreak":true},{"text":"hamoja na iwakulu wa wanhu zake.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Komgwaa deng'ho mtwanzi mgumba mng'anda yake,","poem":1},{"lineBreak":true},{"text":"komsekeza kwa kumgwaa wana.","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu yatogolwe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}