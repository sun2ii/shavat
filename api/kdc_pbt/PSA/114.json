{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"heading","content":["ZABULI YA 114"]},{"type":"verse","number":1,"content":[{"text":"Wanhu wa Izilaeli viwasegele Misili,","poem":1},{"lineBreak":true},{"text":"iwanhu wa ulelo wa Yakobo viwasegele mwiisi ya ugeni,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yuda iwa kae ing'ala ya Imulungu,","poem":1},{"lineBreak":true},{"text":"Izilaeli iwa hanhu hake mwenyego.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bahali igona gago ikimbila,","poem":1},{"lineBreak":true},{"text":"lwanda lwa Yolidani luleka kukilima!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Vigongo vizumha kamba ng'hondolo mbigalo,","poem":1},{"lineBreak":true},{"text":"visugulu vizumha kamba wana ng'hondolo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Gweye bahali iwaze mbaka kokimbila?","poem":1},{"lineBreak":true},{"text":"Na gweye Yolidani habali koleka kukilima?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mweye vigongo, habali muzumha kamba ng'hondolo mbigalo?","poem":1},{"lineBreak":true},{"text":"Na mweye visugulu, habali muzumha kamba wana ng'hondolo?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gwaya gweye isi yose kuulongozi wa Mndewa,","poem":1},{"lineBreak":true},{"text":"gwaya kuulongozi wa Imulungu wa Yakobo,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"heyo kadikwasa dibwe diwa lamba da mazi,","poem":1},{"lineBreak":true},{"text":"na dibwe dala diwa mbwibwi ya mazi!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}