{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":115,"content":[{"type":"heading","content":["ZABULI YA 115"]},{"type":"verse","number":1,"content":[{"text":"Go Mndewa Imulungu, sikututogoligwe siye,","poem":1},{"lineBreak":true},{"text":"ila ditogole twaga jako,","poem":1},{"lineBreak":true},{"text":"mbuli ya unogelo wako hawishaga,","poem":1},{"lineBreak":true},{"text":"na mbuli ya kutamanilwa kwako.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Habali iwanhu wa isi ziyagwe olonga,","poem":1},{"lineBreak":true},{"text":"“Imulungu wao kakwahi?”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lakini Imulungu wetu ka kuulanga,","poem":1},{"lineBreak":true},{"text":"kotenda chochose kimnogela.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Milungu yao itendigwa kwa shaba na zahabu,","poem":1},{"lineBreak":true},{"text":"azo sang'hano za makono ga iwanhu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Vina milomo lakini havilonga,","poem":1},{"lineBreak":true},{"text":"vina meso lakini havilola,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"vina magwiti lakini havihulika bule,","poem":1},{"lineBreak":true},{"text":"vina mhula lakini havinusa bule,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"vina makono lakini havigoga kinhu,","poem":1},{"lineBreak":true},{"text":"vina magulu lakini havigenda bule,","poem":1},{"lineBreak":true},{"text":"havidaha kulava sauti kulawa mmitundu melo yao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wose ovitenda waigala navo,","poem":1},{"lineBreak":true},{"text":"vivija na iwanhu ovitamanila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mweye iwanhu wa Izilaeli, mtamanileni Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"heyo ayo yowataza na ngao yenu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mweye ulelo wa Haluni,","poem":1},{"lineBreak":true},{"text":"mtamanileni Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"heyo ayo yowataza na ngao yenu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mweye mumdumba Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"mtamanileni Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"heyo ayo yowataza na ngao yenu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mndewa Imulungu kotukumbuka na kotutenda tumwede,","poem":1},{"lineBreak":true},{"text":"kowatendela ganogile iwanhu wa Izilaeli,","poem":1},{"lineBreak":true},{"text":"kowatendela ganogile ulelo wa Haluni.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kowatendela ganogile wose omdumba,","poem":1},{"lineBreak":true},{"text":"kowatendela ganogile wakulu na wadodo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mndewa Imulungu yawatende mwengezeke,","poem":1},{"lineBreak":true},{"text":"yawatende mwengezeke mweye na ulelo wenu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu yalumbile ulanga na isi yawatendele ganogile.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ulanga wake Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"ila isi kawagwaa iwanhu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Iwanhu wafile hawamtogola Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"awo iwanhu ochola mwiisi ya kunyamala tuluu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ila siye tuli wagima tomtogola Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"tomtogola sambi na milele.","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu yatogolwe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}