{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":116,"content":[{"type":"heading","content":["ZABULI YA 116"]},{"type":"verse","number":1,"content":[{"text":"Nomnogela Mndewa Imulungu kwavija konihulika,","poem":1},{"lineBreak":true},{"text":"kanihulika vinimpulile yanyonele bazi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kwavija kahinduka yanitegeleze,","poem":1},{"lineBreak":true},{"text":"avo nomkema heyo siku zose za ugima wangu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nzabi za ifa zinizunguluka,","poem":1},{"lineBreak":true},{"text":"bwembwe da ifa dingubika,","poem":1},{"lineBreak":true},{"text":"nimema magazo na usungu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Abaho nipula kwa twaga da Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"“Go Mndewa Imulungu, chonde mhonye!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mndewa Imulungu kana moyo unogile na kana haki,","poem":1},{"lineBreak":true},{"text":"Imulungu wetu kamema bazi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu kowakaliza wanyunyuwale,","poem":1},{"lineBreak":true},{"text":"viwanyonele kanikombola.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gweye moyo wangu bwihila kabili,","poem":1},{"lineBreak":true},{"text":"kwavija Mndewa Imulungu kanitendela ganogile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kwavija gweye Mndewa Imulungu kumhonya na ifa,","poem":1},{"lineBreak":true},{"text":"na kuhangusa mahozi gangu,","poem":1},{"lineBreak":true},{"text":"kunihonya sikuniikwale mmagulu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Notembela kuulongozi wa Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"mwiisi ya iwanhu wagima.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nimtamanila Mndewa Imulungu vinongile,","poem":1},{"lineBreak":true},{"text":"“Niye nigazika ng'hani.”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Vivija nilonga kwa bwembwe jangu,","poem":1},{"lineBreak":true},{"text":"“Wanhu wose wavizi.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nimbwezele choni Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kwa ganogile gose gayanhendele?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nomulavila nhosa ya divai kwa kunikombola,","poem":1},{"lineBreak":true},{"text":"nopula kwa twaga da Mndewa Imulungu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nomvikizila Mndewa Imulungu gaja ganilongile,","poem":1},{"lineBreak":true},{"text":"kuulongozi wa iwanhu wake wose.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ifa ya iwanhu omtamanila Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"siyo mbuli ndodo mgameso gake.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Go Mndewa Imulungu, niye na msang'hanaji wako,","poem":1},{"lineBreak":true},{"text":"niye msang'hanaji wako,","poem":1},{"lineBreak":true},{"text":"mwana wa mtumwa wako, kunifungula nzabi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nokulavila nhosa ya kushukulu,","poem":1},{"lineBreak":true},{"text":"na nopula kwa twaga da Mndewa Imulungu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nigavikiza gaja gose ganongile kwa Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kuulongozi wa iwanhu wake wose,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"waiting'hane muuluwa lwa Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"mgati yako gweye Yelusalemu.","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu yatogolwe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}