{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":118,"content":[{"type":"heading","content":["ZABULI YA 118"]},{"type":"verse","number":1,"content":[{"text":"Mshukuluni Mndewa Imulungu kwavija kanoga,","poem":1},{"lineBreak":true},{"text":"na unogelo wake hawishaga osigala milele.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wanhu wa Izilaeli walonge,","poem":1},{"lineBreak":true},{"text":"“Unogelo wake hawishaga osigala milele.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wanhu wa ulelo wa Haluni walonge,","poem":1},{"lineBreak":true},{"text":"“Unogelo wake hawishaga osigala milele.”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wanhu omdumba Mndewa Imulungu walonge,","poem":1},{"lineBreak":true},{"text":"“Unogelo wake hawishaga osigala milele.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mmagazo gangu nimpula Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"heyo kanihulika na kandekesa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu kahamoja na niye, sidumba kinhu.","poem":1},{"lineBreak":true},{"text":"Munhu konitenda choni?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu kahamoja na niye,","poem":1},{"lineBreak":true},{"text":"heyo konitaza,","poem":1},{"lineBreak":true},{"text":"iwanhu onihila nowona ohumwa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Vinoga kumkimbilila Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kubanza kuwatamanila wanhu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Vinoga kumkimbilila Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kubanza kuwatamanila iwakulu wa mwiisi ino.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Iwanhu wa isi zose wanizunguluka,","poem":1},{"lineBreak":true},{"text":"lakini kwa twaga da Mndewa Imulungu niwakanha wose.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wanizunguluka kila mwambu,","poem":1},{"lineBreak":true},{"text":"lakini kwa twaga da Mndewa Imulungu niwakanha wose.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wanimemela kamba nyuki,","poem":1},{"lineBreak":true},{"text":"lakini wasakazwa kamba miba ilukule,","poem":1},{"lineBreak":true},{"text":"kwa twaga da Mndewa Imulungu niwakanha wose.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nisung'higwa kuchugu na nilonda kugwa,","poem":1},{"lineBreak":true},{"text":"lakini Mndewa Imulungu kanitaza.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu ayo nguvu yangu na lwila lwangu,","poem":1},{"lineBreak":true},{"text":"heyo ayo ukombola wangu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Sauti za deng'ho zohulikigwa mvibanda va iwanhu wene haki,","poem":1},{"lineBreak":true},{"text":"“Mkono wa ukudila wa Mndewa Imulungu utenda mbuli ng'hulu!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mkono wa ukudila wa Mndewa Imulungu uhuma,","poem":1},{"lineBreak":true},{"text":"mkono wa ukudila wa Mndewa Imulungu utenda mbuli ng'hulu!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Sidanganika bule ila nokala mgima,","poem":1},{"lineBreak":true},{"text":"na nogasimulila gaja gayatendile Mndewa Imulungu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu kanikoboza ng'hani,","poem":1},{"lineBreak":true},{"text":"lakini handekile nife.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Nivugulileni imilango ya haki ya ng'anda ya Imulungu,","poem":1},{"lineBreak":true},{"text":"niye nokwingila na nomshukulu Mndewa Imulungu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Uno awo mulango wa Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"wanhu wene haki obitila mumo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Nokushukulu kwavija kunidika,","poem":1},{"lineBreak":true},{"text":"gweye kwa ukombola wangu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Dibwe dilemigwe na wazengaji,","poem":1},{"lineBreak":true},{"text":"diwa dibwe kulu da chandusilo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mbuli ayo kaitenda Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"na siye yotukanganya.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ino ayo siku yaitendile Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"tudeng'helele na kusekelela.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Go Mndewa Imulungu, tukombole,","poem":1},{"lineBreak":true},{"text":"go Mndewa Imulungu, ututende tumwede.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Yamwede ayo yokwiza kwa twaga da Mndewa Imulungu!","poem":1},{"lineBreak":true},{"text":"Kulawa mng'anda ya Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"tokugwaa nhogolwa.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu ayo Imulungu,","poem":1},{"lineBreak":true},{"text":"kautenda mulangaza wake umwemwese kumwetu.","poem":1},{"lineBreak":true},{"text":"Gogeni mibunho ya nyimwilinyimwili,","poem":1},{"lineBreak":true},{"text":"muchole mbaka muupango wa nhosa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Gweye kwa Imulungu wangu,","poem":1},{"lineBreak":true},{"text":"na niye nokushukulu,","poem":1},{"lineBreak":true},{"text":"gweye kwa Imulungu wangu,","poem":1},{"lineBreak":true},{"text":"na niye nokwinula.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Mshukuluni Mndewa Imulungu kwavija kanoga,","poem":1},{"lineBreak":true},{"text":"na unogelo wake hawishaga osigala milele.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}