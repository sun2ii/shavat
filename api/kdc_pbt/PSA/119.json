":1},{"lineBreak":true},{"text":"ajo deng'ho da moyo wangu.","poem":1}]},{"type":"verse","number":112,"content":[{"lineBreak":true},{"text":"Nisagula kulawa mmoyo wangu,","poem":1},{"lineBreak":true},{"text":"kugagoga malagizo gako milele.","poem":1}]},{"type":"line_break"},{"type":"verse","number":113,"content":[{"text":"Nowehila iwanhu watapitapi,","poem":1},{"lineBreak":true},{"text":"ila noganogela malagizo gako.","poem":1}]},{"type":"verse","number":114,"content":[{"lineBreak":true},{"text":"Gweye kwa ngao yangu, kumwako nokimbilila,","poem":1},{"lineBreak":true},{"text":"nodika tamanilo jangu mmbuli yako.","poem":1}]},{"type":"verse","number":115,"content":[{"lineBreak":true},{"text":"Segeleni kumwangu mweye iwanhu wehile,","poem":1},{"lineBreak":true},{"text":"ili nigagoge malagizo ga Imulungu wangu.","poem":1}]},{"type":"verse","number":116,"content":[{"lineBreak":true},{"text":"Unigangamize kamba vuulongile na niye nokuwa mgima,","poem":1},{"lineBreak":true},{"text":"sikuutogole mhate kinyala mditamanilo jangu.","poem":1}]},{"type":"verse","number":117,"content":[{"lineBreak":true},{"text":"Unigoge ng'hale goya,","poem":1},{"lineBreak":true},{"text":"siku zose nigategeleze malagizo gako.","poem":1}]},{"type":"verse","number":118,"content":[{"lineBreak":true},{"text":"Gweye kowalema wose ogaleka malagizo gako,","poem":1},{"lineBreak":true},{"text":"avo ogaya bule kuviza.","poem":1}]},{"type":"verse","number":119,"content":[{"lineBreak":true},{"text":"Wanhu wose wehile kuwasegesa kamba mikupi,","poem":1},{"lineBreak":true},{"text":"avo niye nozinogela amuli zako.","poem":1}]},{"type":"verse","number":120,"content":[{"lineBreak":true},{"text":"Nogwaya kwa kukudumba gweye,","poem":1},{"lineBreak":true},{"text":"nimema bwembwe kwa nhaguso zako.","poem":1}]},{"type":"line_break"},{"type":"verse","number":121,"content":[{"text":"Nitenda ganogile na ga haki,","poem":1},{"lineBreak":true},{"text":"sikuundeke mmakono ga iwanhu onihila.","poem":1}]},{"type":"verse","n