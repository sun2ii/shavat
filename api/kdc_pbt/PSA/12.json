{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"heading","content":["ZABULI YA 12"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi. Kwa kilanja, yatumie nyuzi za bango na modeli wa Sheminiti.)"]},{"type":"verse","number":1,"content":[{"text":"Tukombole gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kwavija iwanhu wa Imulungu opotela,","poem":1},{"lineBreak":true},{"text":"kwavija iwanhu otamanilwa wasegela hagati ha iwanhu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kila munhu komvizila miyage,","poem":1},{"lineBreak":true},{"text":"olonga kwa ulonzi wa kutewenza,","poem":1},{"lineBreak":true},{"text":"na mizoyo ya utapitapi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"uikanhe imilomo ilonga ulonzi wa kutewenza,","poem":1},{"lineBreak":true},{"text":"na imilimi ilonga mbuli za kuitapa,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"iwanhu wose olonga, “Kwa milimi yetu tohuma,","poem":1},{"lineBreak":true},{"text":"milomo tunayo, nani yodaha kututawala?”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lakini Mndewa Imulungu kolonga,","poem":1},{"lineBreak":true},{"text":"“Kwavija iwanhu wakiwa odununzwa,","poem":1},{"lineBreak":true},{"text":"ngaengae olila kwa usungu,","poem":1},{"lineBreak":true},{"text":"sambi nokwiza nowakaliza kamba viwobeta.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mbuli ya Mndewa Imulungu ing'ala,","poem":1},{"lineBreak":true},{"text":"ing'ala kamba shaba isunhigwe mna ditanuli,","poem":1},{"lineBreak":true},{"text":"ona kamba shaba isunhigwe miyanza saba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gweye Mndewa Imulungu, utukalize,","poem":1},{"lineBreak":true},{"text":"utukalize siku zose na iwanhu wa ulelo uno wihile.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Iwanhu wehile ozunguluka kila hanhu,","poem":1},{"lineBreak":true},{"text":"gehile gotogoligwa hagati ha iwanhu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}