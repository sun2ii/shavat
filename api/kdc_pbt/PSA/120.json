{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"heading","content":["ZABULI YA 120"]},{"type":"hebrew_subtitle","content":["(Lwila lwa kuchola uchanha.)"]},{"type":"verse","number":1,"content":[{"text":"Mmagazo gangu nimkema Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"na heyo kanidika.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Unikombole go Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kulawa kwa wanhu wavizi,","poem":1},{"lineBreak":true},{"text":"na kulawa kwa iwanhu owabunyika wayao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mweye wanhu wavizi, mugweleligwe choni?","poem":1},{"lineBreak":true},{"text":"Mwengezeligwe choni?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Imulungu kowatagusa kwa misale mikali ya wakalizi,","poem":1},{"lineBreak":true},{"text":"kowatagusa kwa makala ga msagati.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nogaya niye kamba nokala Mesheki,","poem":1},{"lineBreak":true},{"text":"nokala kamba munhu baki mmahema ga lukolo lwa Kedali.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ng'hala nao kwa kipindi kitali,","poem":1},{"lineBreak":true},{"text":"waja odihila tindiwalo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Niye na munhu wa tindiwalo,","poem":1},{"lineBreak":true},{"text":"lakini nahalonga hewo olonda ng'hondo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}