{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"heading","content":["ZABULI YA 122"]},{"type":"hebrew_subtitle","content":["(Lwila lwa kuchola uchanha wa Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Ndeng'helela viwanilongele,","poem":1},{"lineBreak":true},{"text":"“Tuchole mng'anda ya Mndewa Imulungu.”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Avo, twima mdilango jako,","poem":1},{"lineBreak":true},{"text":"gweye Yelusalemu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Buga da Yelusalemu dizengwa,","poem":1},{"lineBreak":true},{"text":"ili wanhu waiting'hane hamoja.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mumo amo makabila ga Izilaeli gochola,","poem":1},{"lineBreak":true},{"text":"makabila ga Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kamba viwalagizwe,","poem":1},{"lineBreak":true},{"text":"ili waditogole twaga da Mndewa Imulungu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mumo vikigwa vigoda va undewa va nhaguso,","poem":1},{"lineBreak":true},{"text":"vigoda va undewa va ulelo wa Daudi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Dipulileni tindiwalo buga da Yelusalemu,","poem":1},{"lineBreak":true},{"text":"Wose okunogela gweye wakale goya.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tindiwalo dikale mgati kuluwa lwako,","poem":1},{"lineBreak":true},{"text":"usalama ukale mzingome zako!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mbuli ya ndugu zangu na mbwiga zangu,","poem":1},{"lineBreak":true},{"text":"nolonga, ‘Tindiwalo dikale na gweye.’","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mbuli ya ng'anda ya Mndewa Imulungu, Imulungu wetu,","poem":1},{"lineBreak":true},{"text":"‘Nokupulila umwede.’ ”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}