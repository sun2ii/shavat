"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tusitamili bezeli za wanhu wene kibuli,","poem":1},{"lineBreak":true},{"text":"na bezeli za wanhu oitapa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}