ak"},{"type":"verse","number":6,"content":[{"text":"Yatogoligwe Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"hatulekile tung'walanyuligwe na mizino yao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tuhonyeka kamba ndege mumtego wa msakaji,","poem":1},{"lineBreak":true},{"text":"mtego ubeneka na siye tuhonyeka.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kutazigwa kwetu kolawa mditwaga da Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"yalumbile ulanga na isi yose.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}