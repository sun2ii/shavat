{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"heading","content":["ZABULI YA 126"]},{"type":"hebrew_subtitle","content":["(Lwila lwa kuchola uchanha.)"]},{"type":"verse","number":1,"content":[{"text":"Mndewa Imulungu viyawabwezile ako Sayuni,","poem":1},{"lineBreak":true},{"text":"tona kamba wanhu olota nzozi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Baho milomo yetu imema seko,","poem":1},{"lineBreak":true},{"text":"na milimi yetu imema nyila za deng'ho.","poem":1},{"lineBreak":true},{"text":"Wanhu wa isi ziyagwe walonga,","poem":1},{"lineBreak":true},{"text":"“Mndewa Imulungu kawatendela mbuli ng'hulu!”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu katutendela mbuli ng'hulu,","poem":1},{"lineBreak":true},{"text":"tudeng'helela kweli.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Go Mndewa Imulungu, ututende kamba vitukalile umwaka,","poem":1},{"lineBreak":true},{"text":"kamba mazi vigokilima mvizanda va Negebu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Waja ohanda kwa mahozi,","poem":1},{"lineBreak":true},{"text":"osenga kwa nyila za deng'ho.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Heyo yosola mbeyu za kuhanda akuno kolila,","poem":1},{"lineBreak":true},{"text":"kobwela ukae kwa nyila za deng'ho,","poem":1},{"lineBreak":true},{"text":"kuno kakapa mgelo wa ndiya.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}