se","number":4,"content":[{"lineBreak":true},{"text":"Kamba misale mumkono wa galu,","poem":1},{"lineBreak":true},{"text":"vivo viweli wana iwolela munhu muubwanga wake.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kamweda munhu yeli na misale ayo mingi.","poem":1},{"lineBreak":true},{"text":"Honda yahumwe yahalonga na iwanhu omwihila mkitala","poem":1},{"noteId":11},{"text":".","poem":1}]}],"footnotes":[{"noteId":11,"caller":"+","text":"Kwa Kiebulania olonga hadilango da dibuga.","reference":{"chapter":127,"verse":5}}]},"thisChapterLink":"/api/kdc_pbt/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}