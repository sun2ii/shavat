":true},{"text":"ugone ganogile ga Yelusalemu siku zose za ugima wako.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Uwe mgima mbaka wone wazukulu zako.","poem":1},{"lineBreak":true},{"text":"Tindiwalo dikale na Izilaeli.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}