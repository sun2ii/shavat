{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"heading","content":["ZABULI YA 13"]},{"type":"hebrew_subtitle","content":["(Kwa kilanja, Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Mbaka lini gweye Mndewa Imulungu, konisemwa?","poem":1},{"lineBreak":true},{"text":"Gweye konisemwa milele?","poem":1},{"lineBreak":true},{"text":"Mbaka lini konifisa kihanga chako?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mbaka lini nogelegeza?","poem":1},{"lineBreak":true},{"text":"Mbaka lini nokuwa na lusikisiki mmoyo wangu kila siku?","poem":1},{"lineBreak":true},{"text":"Mbaka lini iwanhu onihila odeng'helela magazo gangu?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mndewa Imulungu, Imulungu wangu, ulole na unidike,","poem":1},{"lineBreak":true},{"text":"ugamwemwesele meso gangu,","poem":1},{"lineBreak":true},{"text":"buleavo nowasa utulo wa ifa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sikuuleke iwanhu onihila walonge, “Kahumwa!”","poem":1},{"lineBreak":true},{"text":"Iwanhu onideta sambi wadeng'helele kwavija nigwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lakini niye noutamanila unogelo wako hawishaga,","poem":1},{"lineBreak":true},{"text":"moyo wangu odeng'helela ukombola wako.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nomwimbila Mndewa Imulungu, kwavija kanitendela ganogile.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}