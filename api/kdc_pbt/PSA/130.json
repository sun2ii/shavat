{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"heading","content":["ZABULI YA 130"]},{"type":"hebrew_subtitle","content":["(Lwila lwa kuchola uchanha.)"]},{"type":"verse","number":1,"content":[{"text":"Kulawa mmagazo gangu,","poem":1},{"lineBreak":true},{"text":"nokulilila go Mndewa Imulungu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Go Mndewa Imulungu, uihulike sauti yangu,","poem":1},{"lineBreak":true},{"text":"magwiti gako gahulike kupula kwangu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Go Mndewa Imulungu, maza gweye ugapetile gehile getu,","poem":1},{"lineBreak":true},{"text":"Go Mndewa, nani yahadahile kwima kuulongozi wako?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lakini kumwako kuna kugela kumgongo,","poem":1},{"lineBreak":true},{"text":"ili gweye udumbigwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nombeta Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"loho yangu yombeta heyo,","poem":1},{"lineBreak":true},{"text":"mna imbuli yake notamanila.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Loho yangu yombeta Mndewa,","poem":1},{"lineBreak":true},{"text":"kubanza wakalizi viwobeta imotondo ivike,","poem":1},{"lineBreak":true},{"text":"ona, kubanza wakalizi viwobeta usiku uche.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gweye Izilaeli mtamanile Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kwavija kwa Mndewa Imulungu kuna unogelo hawishaga,","poem":1},{"lineBreak":true},{"text":"na kumwake kuna ugombola mkulu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Heyo kowagombola wanhu wa Izilaeli,","poem":1},{"lineBreak":true},{"text":"na nzambi zao zose.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}