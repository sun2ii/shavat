{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":132,"content":[{"type":"heading","content":["ZABULI YA 132"]},{"type":"hebrew_subtitle","content":["(Lwila lwa kuchola uchanha.)"]},{"type":"verse","number":1,"content":[{"text":"Go Mndewa Imulungu, mkumbuke Daudi,","poem":1},{"lineBreak":true},{"text":"na magazo gake gose gayasitahimili.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Heyo kaiduwila kwa Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"heyo kailagana na heyo mwene udahi wose wa Yakobo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"“Singila mwiing'anda yangu,","poem":1},{"lineBreak":true},{"text":"hebu kuwasa mulusazi wangu,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sigaleka meso gangu gapate utulo,","poem":1},{"lineBreak":true},{"text":"hebu ng'humbitu zangu kukukila,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"mbaka mhate hanhu mbuli ya Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"ukazi mbuli ya heyo yeli na udahi wose wa Yakobo!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tuhulika olonga, “Sanduku da lagano da ako Efulata,","poem":1},{"lineBreak":true},{"text":"tudivika mmigunda ya Yealimu.”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Avo tulonga, “Tucholeni mwiing'anda ya Imulungu,","poem":1},{"lineBreak":true},{"text":"tukatambike kuulongozi wa kigoda chake cha kwikila magulu.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Go Mndewa Imulungu, inuka uchole hanhu hako ha kukala,","poem":1},{"lineBreak":true},{"text":"winuke na sanduku jako da lagano dili na udahi wako.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Iwalava nhosa zako wavazigwe haki,","poem":1},{"lineBreak":true},{"text":"wanhu wako otamanilwa wembe kwa deng'ho.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kwa mbuli ya Daudi msang'hanaji wako,","poem":1},{"lineBreak":true},{"text":"sikuumuleme ayo yuumsagule.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mndewa Imulungu kaiduwila kwa Daudi,","poem":1},{"lineBreak":true},{"text":"kaiduwila kinhu hakisegesigwa,","poem":1},{"lineBreak":true},{"text":"“Imoja wa ulelo wako,","poem":1},{"lineBreak":true},{"text":"nomtenda yawe mndewa hanhu hako.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kamba wanago wahadigoga lagano jangu,","poem":1},{"lineBreak":true},{"text":"na amuli ziniwafunza,","poem":1},{"lineBreak":true},{"text":"vivija wanao ohazi undewa wako milele.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kwavija Mndewa Imulungu kaisagula Sayuni,","poem":1},{"lineBreak":true},{"text":"kalonda hawe hanhu hake ha kukala.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Heyo kalonga, “Hano baho hanhu hangu ha kukala milele,","poem":1},{"lineBreak":true},{"text":"hano nokala kuno notawala,","poem":1},{"lineBreak":true},{"text":"kwavija nohalonda.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Noditendela ganogile kwa kudigwaa ndiya,","poem":1},{"lineBreak":true},{"text":"nowagwaa ndiya wakiwa mbaka wegute.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Iwalava nhosa zake nowavaza ukombola,","poem":1},{"lineBreak":true},{"text":"na wanhu zake otamanilwa okwimba kwa deng'ho.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Baho nomtenda imoja wa ulelo wa Daudi yawe mndewa mkulu,","poem":1},{"lineBreak":true},{"text":"nitanda taa mbuli ya ayo inimsagule.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wanhu omwihila nowavaza kinyala,","poem":1},{"lineBreak":true},{"text":"lakini heyo nomvaza taji ing'ala ng'hani.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}