{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":135,"content":[{"type":"heading","content":["ZABULI YA 135"]},{"type":"verse","number":1,"content":[{"text":"Mgweleleni nhogolwa Mndewa Imulungu.","poem":1},{"lineBreak":true},{"text":"Digweleleni nhogolwa twaga da Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"mweye wasang'hanaji wa Mndewa Imulungu mgweleleni nhogolwa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mgweleleni nhogolwa,","poem":1},{"lineBreak":true},{"text":"mweye msang'hana mng'anda ya Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"mgati muuluwa lwa ng'anda ya Imulungu wetu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mgweleleni nhogolwa Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kwavija Mndewa Imulungu kanoga,","poem":1},{"lineBreak":true},{"text":"dimbileni nhogolwa twaga jake, kwavija donogeza.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu kamsagula Yakobo kuwa wake mwenyego,","poem":1},{"lineBreak":true},{"text":"kamsagula Izilaeli kamba kinhu chake kinogile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nojuwa kamba Mndewa Imulungu mkulu,","poem":1},{"lineBreak":true},{"text":"na Mndewa wetu mkulu kubanza imilungu yose.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu kotenda chochose kiyolonda,","poem":1},{"lineBreak":true},{"text":"kuulanga na mwiisi, mwiibahali na mvizanda vose.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Heyo kogatenda mawingu gakwele uchanha kulawa kuuhelelo wa isi,","poem":1},{"lineBreak":true},{"text":"kogala lumwesa hamoja na mvula,","poem":1},{"lineBreak":true},{"text":"na kodibumiza beho kulawa kukanho jake.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kawakoma wana wa chaudele ako Misili,","poem":1},{"lineBreak":true},{"text":"wose wana wa chaudele wa wanhu na wanyama.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Katenda vilaguso na unzonza kumwako, gweye Misili,","poem":1},{"lineBreak":true},{"text":"kwa Falao na wasang'hanaji zake wose.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Heyo kawatowa wanhu wa isi nyingi,","poem":1},{"lineBreak":true},{"text":"kawakoma wandewa wakalile na nguvu,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"kamba vija kwa Sihoni mndewa wa Waamoli,","poem":1},{"lineBreak":true},{"text":"na Ogu mndewa wa Bashani,","poem":1},{"lineBreak":true},{"text":"na wandewa wose wa Kanaani.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kazisola isi zao zose na kawagwelela wanhu zake,","poem":1},{"lineBreak":true},{"text":"kamba uhazi wa wanhu zake wa Izilaeli.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Go Mndewa Imulungu, twaga jako dokala milele,","poem":1},{"lineBreak":true},{"text":"go Mndewa Imulungu, kokumbukigwa ulelo mbaka ulelo,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"kwavija Mndewa Imulungu kowagombela wanhu zake,","poem":1},{"lineBreak":true},{"text":"na kowonela bazi wasang'hanaji zake.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Vinyago va isi ziyagwe azo shaba na zahabu,","poem":1},{"lineBreak":true},{"text":"zitendigwe kwa makono ga wanhu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ina milomo lakini hailonga bule,","poem":1},{"lineBreak":true},{"text":"na ina meso lakini hailola bule.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ina magwiti lakini haihulika bule,","poem":1},{"lineBreak":true},{"text":"na haidaha kuhumula.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wose oitenda waigala navo,","poem":1},{"lineBreak":true},{"text":"na kila imoja yoitamanila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Mweye wanhu wa Izilaeli,","poem":1},{"lineBreak":true},{"text":"mgweleleni nhogolwa Mndewa Imulungu!","poem":1},{"lineBreak":true},{"text":"Mweye ulelo wa Haluni,","poem":1},{"lineBreak":true},{"text":"mgweleleni nhogolwa Mndewa Imulungu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mweye Walawi,","poem":1},{"lineBreak":true},{"text":"mgweleleni nhogolwa Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"mweye mumdumba Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"mgweleleni nhogolwa Mndewa Imulungu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mgweleleni nhogolwa Mndewa Imulungu kulawa Sayuni,","poem":1},{"lineBreak":true},{"text":"mgweleleni nhogolwa heyo yokala Yelusalemu.","poem":1},{"lineBreak":true},{"text":"Mgweleleni nhogolwa Mndewa Imulungu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}