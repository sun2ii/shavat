{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"heading","content":["ZABULI YA 137"]},{"type":"verse","number":1,"content":[{"text":"Mzimbwega mbwega za vizanda va Babeli tukala,","poem":1},{"lineBreak":true},{"text":"tulila vituikumbuke Sayuni.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mmibiki ya isi ija,","poem":1},{"lineBreak":true},{"text":"tutumbika mabango getu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kwavija awo watugogile, watulonda tuwembile lwila,","poem":1},{"lineBreak":true},{"text":"awo otudeta watulonda tuwembile lwila lwa deng'ho,","poem":1},{"lineBreak":true},{"text":"walonga, “Twimbileni lwila lumoja mzinyila za Sayuni.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tokwimbaze nyila za Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kuno twa mwiisi baki?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gweye Yelusalemu nahakusemwa gweye,","poem":1},{"lineBreak":true},{"text":"mkono wangu wa ukudila unyale.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lulimi lwangu luilumbe na mulomo wangu wa uchanha,","poem":1},{"lineBreak":true},{"text":"kamba sikukumbuka gweye,","poem":1},{"lineBreak":true},{"text":"kamba sikutenda gweye Yelusalemu deng'ho jangu kulu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Go Mndewa Imulungu, sambi uisemwe kiwatendile Waedomu,","poem":1},{"lineBreak":true},{"text":"siku dija Yelusalemu viisoligwe,","poem":1},{"lineBreak":true},{"text":"kumbuka kiwalongile,","poem":1},{"lineBreak":true},{"text":"“Dibomoleni buga da Yelusalemu,","poem":1},{"lineBreak":true},{"text":"mbaka kuna ichandusilo chake!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gweye Babeli, utagusigwe na kubanangwa,","poem":1},{"lineBreak":true},{"text":"komweda munhu yonda yakulihe gehile gako gaututendele siye.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Komweda munhu ija yonda yawasole wanago,","poem":1},{"lineBreak":true},{"text":"na kuwahonda honda uchanha ya dibwe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}