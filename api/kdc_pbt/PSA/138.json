{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":138,"content":[{"type":"heading","content":["ZABULI YA 138"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Go Mndewa Imulungu, nokushukulu kwa moyo wangu wose,","poem":1},{"lineBreak":true},{"text":"haulongozi wa imilungu nokwimba nhogolwa zako.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Noidulika mbaka hasi,","poem":1},{"lineBreak":true},{"text":"kulozela ng'anda yako ing'alile,","poem":1},{"lineBreak":true},{"text":"nodigwaa nhogolwa twaga jako,","poem":1},{"lineBreak":true},{"text":"mbuli ya unogelo wako hawishaga na kutamanilwa kwako,","poem":1},{"lineBreak":true},{"text":"kwavija kudigwaa ukulu twaga jako na mbuli yako,","poem":1},{"lineBreak":true},{"text":"kubanza vinhu vose.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Siku dija dinikulilile, gweye kunidika,","poem":1},{"lineBreak":true},{"text":"na kunigangamiza kwa nguvu zako.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wandewa wose wa mwiisi wakugwee nhogolwa gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kwavija wazihulika mbuli zako ziulongile.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wembe mbuli ya sang'hano za Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kwavija ukulu wa Mndewa Imulungu mkulu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hamoja Mndewa Imulungu ka uchanha,","poem":1},{"lineBreak":true},{"text":"komulola goya munhu yabwezigwe hasi,","poem":1},{"lineBreak":true},{"text":"lakini komtanga munhu yoitapa kulawa kutali.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Hata nahabita mmagazo,","poem":1},{"lineBreak":true},{"text":"gweye koukaliza ugima wangu,","poem":1},{"lineBreak":true},{"text":"golosa mkono wako kuikimila ng'hasiliki ya iwanhu onihila,","poem":1},{"lineBreak":true},{"text":"kwa mkono wako wa ukudila unikombole.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Go Mndewa Imulungu, gavikize gaja goulonda kumwangu,","poem":1},{"lineBreak":true},{"text":"unogelo wako hawishaga okala milele,","poem":1},{"lineBreak":true},{"text":"sikuuisemwe sang'hano ya makono gako.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}