{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":139,"content":[{"type":"heading","content":["ZABULI YA 139"]},{"type":"hebrew_subtitle","content":["(Kwa kilanja, Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Go Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"gweye kunilola goya vinili,","poem":1},{"lineBreak":true},{"text":"kunjuwa mbaka mgati.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gweye kojuwa kukala kwangu na kwinuka kwangu,","poem":1},{"lineBreak":true},{"text":"gweye kogajuwa magesa gangu kulawa kutali.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gweye kojuwa kutembela kwangu na kuhumula kwangu,","poem":1},{"lineBreak":true},{"text":"gweye kozijuwa nzila zangu zose.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ning'hali sinalonga mbuli bule,","poem":1},{"lineBreak":true},{"text":"gweye Mndewa Imulungu kujuwa gose gonilonda kulonga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kila mwambu wangu kwa baho, kuchugu na kuulongozi,","poem":1},{"lineBreak":true},{"text":"kunikila mkono wako kunikaliza.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Maalifa gako kobanza nzewele zangu,","poem":1},{"lineBreak":true},{"text":"makulu ng'hani sidaha kugajuwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nikimbilile kwahi niinege na loho yako?","poem":1},{"lineBreak":true},{"text":"Nichole kwahi nikikimbile kihanga chako?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kamba nahakwela uchanha kuulanga,","poem":1},{"lineBreak":true},{"text":"gweye kwa uko,","poem":1},{"lineBreak":true},{"text":"nahachola kuzimu gweye vivija kwa uko.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nahaguluka mbaka uhelelo wa mwambu wa kudilawila zuwa,","poem":1},{"lineBreak":true},{"text":"hebu nahakala kuuhelelo wa bahali,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"vivija kuko gweye kwa uko konilongoza,","poem":1},{"lineBreak":true},{"text":"mkono wako wa ukudila onigoga goya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kamba nahapulile ziza dinigubike,","poem":1},{"lineBreak":true},{"text":"mulenge unimwemweselaga uwe ziza,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"kumwako kuduhu ziza,","poem":1},{"lineBreak":true},{"text":"ikilo yong'ala kamba imisi,","poem":1},{"lineBreak":true},{"text":"kumwako ziza kamba mulenge.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kwavija gweye iyo ulumbile mgati yangu,","poem":1},{"lineBreak":true},{"text":"kunilumba mwiinda ya mamangu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nokushukulu kwavija kunilumba kwa unzonza mkulu na kudumbiza.","poem":1},{"lineBreak":true},{"text":"Sang'hano zako za unzonza,","poem":1},{"lineBreak":true},{"text":"mbuli ayo noijuwa goya.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Lukuli lwangu lwabule kifiso kumwako,","poem":1},{"lineBreak":true},{"text":"nilumbigwa hanhu hakifiso,","poem":1},{"lineBreak":true},{"text":"nilumbigwa kwa ufundi mwiinda ya mamangu","poem":1},{"noteId":12},{"text":".","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Meso gako gawona lukuli lwangu lung'hali halunakwisha,","poem":1},{"lineBreak":true},{"text":"na kwandika kila kinhu mkitabu chako,","poem":1},{"lineBreak":true},{"text":"siku zangu zose kuzipanga,","poem":1},{"lineBreak":true},{"text":"hata siku ya ichanduso hainakuwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Go Imulungu, magesa gako ganoga ng'hani kumwangu,","poem":1},{"lineBreak":true},{"text":"na magesa gako hagadahika kupetigwa!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kamba nahagapetile mengi kubanza msanga.","poem":1},{"lineBreak":true},{"text":"Nahalamuka ning'hali na hamoja na gweye.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Go Imulungu, maza uhawakomile awo otenda gehile!","poem":1},{"lineBreak":true},{"text":"Segeleni kumwangu mweye mwitaga damu!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Okulonga vihile akuno ogelegeza gehile,","poem":1},{"lineBreak":true},{"text":"iwanhu okwihila oditambula bule twaga jako.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Go Mndewa Imulungu, sikuniwehile awo okwihila gweye?","poem":1},{"lineBreak":true},{"text":"Sikuniwehile ng'hani awo okulema gweye?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Wanhu okwihila gweye na niye nowehila,","poem":1},{"lineBreak":true},{"text":"nowehila ng'hani.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Go Imulungu, unilolese, ujuwe moyo wangu,","poem":1},{"lineBreak":true},{"text":"unigeze, ugajuwe magesa gangu.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ulole kamba mgati yangu kuna nzila ikugevuza,","poem":1},{"lineBreak":true},{"text":"unilongoze mwiinzila ikalaga milele.","poem":1}]}],"footnotes":[{"noteId":12,"caller":"+","text":"Mwiinda ya mamangu kwa Kiebulania olonga mgati ya isi.","reference":{"chapter":139,"verse":15}}]},"thisChapterLink":"/api/kdc_pbt/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}