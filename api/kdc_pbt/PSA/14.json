{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"heading","content":["ZABULI YA 14"]},{"type":"hebrew_subtitle","content":["(Kwa kilanja, Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Mbozi kolonga mmoyo wake,","poem":1},{"lineBreak":true},{"text":"“Kuduhu Imulungu.”","poem":1},{"lineBreak":true},{"text":"Wose wabanangika, osang'hana gehile,","poem":1},{"lineBreak":true},{"text":"haduhu munhu yotenda ganogile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mndewa Imulungu kowasungulila iwanhu kulawa kuulanga,","poem":1},{"lineBreak":true},{"text":"yalole kamba hana munhu mwene nzewele,","poem":1},{"lineBreak":true},{"text":"na kamba hana munhu komzahila Imulungu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wose wahinduka,","poem":1},{"lineBreak":true},{"text":"wose wabanangika,","poem":1},{"lineBreak":true},{"text":"haduhu yotenda ganogile,","poem":1},{"lineBreak":true},{"text":"haduhu hata imoja.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Vino awo otenda gehile wabule nzewele?","poem":1},{"lineBreak":true},{"text":"Owadafuna wanhu zangu kamba magate,","poem":1},{"lineBreak":true},{"text":"na hawamgelegeza Mndewa Imulungu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Baho wengilwa na bwembwe,","poem":1},{"lineBreak":true},{"text":"kwavija Imulungu kahamoja na iwanhu otenda ganogile.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Modaha kugananga ago goyolonda kutenda imunhu mkiwa,","poem":1},{"lineBreak":true},{"text":"lakini Mndewa Imulungu ayo yomkaliza.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Maza ukombola wa Izilaeli wize kulawa Sayuni!","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu, vonda yabweze ng'hekewa ya wanhu zake,","poem":1},{"lineBreak":true},{"text":"Yakobo yadeng'helele,","poem":1},{"lineBreak":true},{"text":"Izilaeli yadeng'he.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}