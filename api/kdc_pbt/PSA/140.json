{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":140,"content":[{"type":"heading","content":["ZABULI YA 140"]},{"type":"hebrew_subtitle","content":["(Kwa kilanja, Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Go Mndewa Imulungu, ung'hombole na wanhu wehile,","poem":1},{"lineBreak":true},{"text":"unikalize na wanhu wasede,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"awo opanga gehile mmizoyo yao,","poem":1},{"lineBreak":true},{"text":"oding'hula ndwagi siku zose.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Milimi yao oitenda mikali kamba zoka,","poem":1},{"lineBreak":true},{"text":"sumu ya futa ya mmilomo yao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Go Mndewa Imulungu, unihonye na makono ga wanhu wehile,","poem":1},{"lineBreak":true},{"text":"unikimile na wanhu wasede,","poem":1},{"lineBreak":true},{"text":"wapangile kunigwisa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Weli na kibuli wanitegela mitego kwa kifiso,","poem":1},{"lineBreak":true},{"text":"na wanzanza nzabi za lwavu lwao,","poem":1},{"lineBreak":true},{"text":"wanikila mitego mwiinzila yangu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Go Mndewa Imulungu, nokulongela, “Gweye iyo Imulungu wangu.”","poem":1},{"lineBreak":true},{"text":"Go Mndewa, uhulike kililo changu na unyonele bazi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Go Mndewa Imulungu, Mndewa wangu, mkombola wangu mwene nguvu,","poem":1},{"lineBreak":true},{"text":"kunikaliza kipindi chose cha ng'hondo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Go Mndewa Imulungu, sikuuwagwelele iwanhu wehile gaja gowosulukila,","poem":1},{"lineBreak":true},{"text":"na sikuuivikize mipango yao,","poem":1},{"lineBreak":true},{"text":"buleavo oitapa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mapala ga awo onizunguluka gagubikwe,","poem":1},{"lineBreak":true},{"text":"na magazo golawa mmilomo yao.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Makala ga moto gawalagalile,","poem":1},{"lineBreak":true},{"text":"wasigwe muumoto mdisimo,","poem":1},{"lineBreak":true},{"text":"na sikuwenuke kabili.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Awo owadeta wayao sikuwamwede mwiisi,","poem":1},{"lineBreak":true},{"text":"gehile gawasake wanhu wasede.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nojuwa kamba Mndewa Imulungu kowagombela wakiwa,","poem":1},{"lineBreak":true},{"text":"na kowagwaa haki ngaengae.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kweli wene haki odigwaa nhogolwa twaga jako,","poem":1},{"lineBreak":true},{"text":"na waja watelele okala kumwako.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}