{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":141,"content":[{"type":"heading","content":["ZABULI YA 141"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Go Mndewa Imulungu, nokukema gweye,","poem":1},{"lineBreak":true},{"text":"wize kumwangu himahima,","poem":1},{"lineBreak":true},{"text":"uhulike sauti yangu nahakukema.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kupula kwangu kuvike kuulongozi wako kamba yosi da ubani usomigwa,","poem":1},{"lineBreak":true},{"text":"kwinula kwangu makono uchanha kuwe kamba nhosa ya ichungulo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Go Mndewa Imulungu, ika mkalizi kumulomo wangu,","poem":1},{"lineBreak":true},{"text":"ika ukalizi mmulomo wangu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sambi uutogolele moyo wangu utende gehile,","poem":1},{"lineBreak":true},{"text":"sambi undeke nhende gehile,","poem":1},{"lineBreak":true},{"text":"sambi niilumbe na wanhu otenda gehile,","poem":1},{"lineBreak":true},{"text":"hebu kuja ndiya mzinyimwilinyimwili zao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Vinoga munhu mwene haki yanizume kwa kunikoboza,","poem":1},{"lineBreak":true},{"text":"mbuli ayo ya bazi,","poem":1},{"lineBreak":true},{"text":"leka yanikomhokele,","poem":1},{"lineBreak":true},{"text":"mbuli ayo mavuta mdipala jangu,","poem":1},{"lineBreak":true},{"text":"pala jangu hadiilema bule.","poem":1},{"lineBreak":true},{"text":"Lakini kupula kwangu siku zose mbuli ya gehile ga wanhu wehile.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Watawala zao otupigwa hasi kulawa kumibwe,","poem":1},{"lineBreak":true},{"text":"wanhu wehile oifunza kamba mbuli zangu zikala kweli.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mizege yao yopwililisigwa kuzimu,","poem":1},{"lineBreak":true},{"text":"kamba ngodi zituligwe vihande vihande!","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lakini niye nokutamanila gweye Mndewa Imulungu, Imulungu wangu,","poem":1},{"lineBreak":true},{"text":"nokukimbilila gweye,","poem":1},{"lineBreak":true},{"text":"sambi unileke nidanganike.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Unikalize na mitego iwanitegele,","poem":1},{"lineBreak":true},{"text":"mitego itegigwe na awo otenda gehile.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wanhu wehile wanamate mmizavu yao wenyego,","poem":1},{"lineBreak":true},{"text":"kipindi niye nobita vinogile.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}