{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"heading","content":["ZABULI YA 142"]},{"type":"hebrew_subtitle","content":["(Ulonzi wa Daudi mbuli ya kipindi viyakalile mmhango. Zabuli ya kupula.)",{"noteId":13}]},{"type":"verse","number":1,"content":[{"text":"Nomulilila Mndewa Imulungu kwa sauti,","poem":1},{"lineBreak":true},{"text":"nompula Mndewa Imulungu kwa sauti yangu yanyonele bazi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nogida kuiyalala kwangu kuulongozi wake,","poem":1},{"lineBreak":true},{"text":"kuulongozi wake nolonga magazo gangu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nahalonda kukanha tamanilo,","poem":1},{"lineBreak":true},{"text":"gweye kotanga nzila zangu!","poem":1},{"lineBreak":true},{"text":"Mwiinzila inibita wanhu wanitegela mitego.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lola mwambu wangu wa ukudila,","poem":1},{"lineBreak":true},{"text":"kuduhu hata munhu yonitanga,","poem":1},{"lineBreak":true},{"text":"nabule hanhu ha kukimbilila,","poem":1},{"lineBreak":true},{"text":"kuduhu munhu yonigesa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Go Mndewa Imulungu, nokulilila,","poem":1},{"lineBreak":true},{"text":"nolonga, “Gweye ayo kimbililo jangu,","poem":1},{"lineBreak":true},{"text":"gweye ayo fungu jangu hano mwiisi ya wagima.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Uhulike kililo changu,","poem":1},{"lineBreak":true},{"text":"kwavija niye namdodo,","poem":1},{"lineBreak":true},{"text":"nikombole na awo onikweleleza,","poem":1},{"lineBreak":true},{"text":"kwavija wana nguvu kubanza niye.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Undave mkifungo changu,","poem":1},{"lineBreak":true},{"text":"ili niditogole twaga jako.","poem":1},{"lineBreak":true},{"text":"Wanhu wene haki wanizunguluke,","poem":1},{"lineBreak":true},{"text":"kwavija kunhendela mengi ganogile.","poem":1}]}],"footnotes":[{"noteId":13,"caller":"+","text":"Lola kitabu cha 1 Samweli 22:1-2.","reference":{"chapter":142,"verse":0}}]},"thisChapterLink":"/api/kdc_pbt/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}