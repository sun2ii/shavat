{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":143,"content":[{"type":"heading","content":["ZABULI YA 143"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Go Mndewa Imulungu, uhulike kupula kwangu,","poem":1},{"lineBreak":true},{"text":"uhulike kupula kwangu na unyonele bazi,","poem":1},{"lineBreak":true},{"text":"mkutamanilwa kwako na haki wize unitaze.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sikuumtaguse msang'hanaji wako,","poem":1},{"lineBreak":true},{"text":"kwavija kuduhu munhu yokala kuno kana haki kuulongozi wako.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Munhu yehile koikweleleza loho yangu,","poem":1},{"lineBreak":true},{"text":"koubwanha hasi ugima wangu.","poem":1},{"lineBreak":true},{"text":"Konitenda nikale mdiziza kamba munhu yadanganike toka mwaka.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Avo, loho yangu yosinduka mgati yangu,","poem":1},{"lineBreak":true},{"text":"moyo wangu mgati yangu odumba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nizikumbuka siku za umwaka,","poem":1},{"lineBreak":true},{"text":"nogelegeza sang'hano zako,","poem":1},{"lineBreak":true},{"text":"nogesa sang'hano zitendigwe kwa makono gako.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nogolosa makono gangu kumwako,","poem":1},{"lineBreak":true},{"text":"loho yangu yokonela ng'hilu kamba isi inyalile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Go Mndewa Imulungu, ulopole kunidika,","poem":1},{"lineBreak":true},{"text":"loho yangu yosinduka.","poem":1},{"lineBreak":true},{"text":"Sikuunifise kihanga chako,","poem":1},{"lineBreak":true},{"text":"buleavo nokuwa kamba awo ohumuluka kuzimu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Imitondo unilagusile unogelo wako hawishaga,","poem":1},{"lineBreak":true},{"text":"kwavija tamanilo jangu da kumwako,","poem":1},{"lineBreak":true},{"text":"nilagusile nzila yakubita,","poem":1},{"lineBreak":true},{"text":"kwavija noulava moyo wangu kumwako.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Go Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"unihonye na iwanhu onihila,","poem":1},{"lineBreak":true},{"text":"niye nikukimbilila gweye unifise.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Unifunze kutenda gaja goulonda,","poem":1},{"lineBreak":true},{"text":"kwavija gweye ayo Imulungu wangu,","poem":1},{"lineBreak":true},{"text":"Loho wako yanogile yanilongoze mwiinzila igoloke.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Go Mndewa Imulungu, mbuli ya twaga jako, ukalize ugima wangu,","poem":1},{"lineBreak":true},{"text":"mbuli ya haki yako, unilave mmagazo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kwa unogelo wako hawishaga,","poem":1},{"lineBreak":true},{"text":"uwabanange iwanhu onihila,","poem":1},{"lineBreak":true},{"text":"uwabanange wose onideta,","poem":1},{"lineBreak":true},{"text":"kwavija niye msang'hanaji wako.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}