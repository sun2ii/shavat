{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":144,"content":[{"type":"heading","content":["ZABULI YA 144"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Yatogoligwe Mndewa Imulungu, dibwe jangu,","poem":1},{"lineBreak":true},{"text":"yogagwaa nguvu makono gangu mwiing'hondo,","poem":1},{"lineBreak":true},{"text":"na kuvifundiza vidole vangu kuitowa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Heyo ayo unogelo wangu hawishaga na ngome yangu,","poem":1},{"lineBreak":true},{"text":"mkombola wangu na ngome yangu,","poem":1},{"lineBreak":true},{"text":"ngao yangu inimkimbilile,","poem":1},{"lineBreak":true},{"text":"heyo koweka hasi yangu wanhu wa isi ziyagwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Go Mndewa Imulungu, munhu kinhu gani mbaka umgese?","poem":1},{"lineBreak":true},{"text":"Munhu kinhu gani mbaka umgelegeze?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Munhu kaigala na mhumuzi,","poem":1},{"lineBreak":true},{"text":"siku zake kamba sisila vidibita.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Go Mndewa Imulungu, vugula ulanga uhumuluke hasi,","poem":1},{"lineBreak":true},{"text":"ukwase vigongo vilawe yosi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gala lumwesa, uwapwililise iwanhu okwihila,","poem":1},{"lineBreak":true},{"text":"utowe misale yako uwakimbize.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ugolose mkono wako kulawa uchanha,","poem":1},{"lineBreak":true},{"text":"unikombole na unihonye kulawa mmazi mengi,","poem":1},{"lineBreak":true},{"text":"unisegese mmakono ga iwanhu baki,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"awo milomo yao imema uvizi,","poem":1},{"lineBreak":true},{"text":"na awo oiduwila kwa uvizi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Go Imulungu, nokwimbila lwila lwa sambi,","poem":1},{"lineBreak":true},{"text":"kwa bango dili na nzabi longo nokwimbila,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"kumwako gweye uwagwaa mhumo wandewa,","poem":1},{"lineBreak":true},{"text":"komkombola msang'hanaji wako Daudi,","poem":1},{"lineBreak":true},{"text":"kulawa mdisime digala ifa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Unikombole na unihonye kulawa mmakono ga wanhu baki,","poem":1},{"lineBreak":true},{"text":"awo milomo yao yolonga uvizi,","poem":1},{"lineBreak":true},{"text":"na awo oiduwila kwa uvizi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Abaho wanetu muubwanga wao okuwa kamba minoga iloligwe goya,","poem":1},{"lineBreak":true},{"text":"na wandele zetu okuwa kamba mhanda zichongigwe kwa kuhambila goya ng'anda ya kindewa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Makanho getu gameme aina zose za ndiya na vinhu vilondigwa.","poem":1},{"lineBreak":true},{"text":"Ng'hondolo zetu olela maelufu,","poem":1},{"lineBreak":true},{"text":"olela maelufu kwa maelufu mmigunda,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ng'ombe zetu opapa mizigo mikulu,","poem":1},{"lineBreak":true},{"text":"sikukuwe na ng'hondo, hebu kuhamizigwa,","poem":1},{"lineBreak":true},{"text":"na sikukuwe na ndilo mzinzila zetu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Wamweda wanhu weli vivo,","poem":1},{"lineBreak":true},{"text":"wamweda wanhu awo Mndewa Imulungu, iyo Imulungu wao.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}