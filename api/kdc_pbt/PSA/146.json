lineBreak":true},{"text":"tamanilo jake da kwa Mndewa Imulungu, Imulungu wake,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Heyo yalumbile ulanga na isi,","poem":1},{"lineBreak":true},{"text":"bahali na vose vili mumo.","poem":1},{"lineBreak":true},{"text":"Heyo yotamaniligwa milele.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Heyo kowagwaa haki waja okoneligwa,","poem":1},{"lineBreak":true},{"text":"na kowagwaa ndiya weli na nzala.","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu kowalekesa waja wafungigwe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu kowafumbula meso wasuwameso,","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu kowenula waja olemelwa na mizigo yao,","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu kowanogela wene haki.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu kowakaliza wanhu baki,","poem":1},{"lineBreak":true},{"text":"kowataza wana wakiwa na wagane,","poem":1},{"lineBreak":true},{"text":"lakini kozibananga nzila za wanhu wehile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mndewa Imulungu kotawala milele,","poem":1},{"lineBreak":true},{"text":"Imulungu wako, gweye Sayuni,","poem":1},{"lineBreak":true},{"text":"kotawala ulelo mbaka ulelo.","poem":1},{"lineBreak":true},{"text":"Mtogoleni Mndewa Imulungu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}