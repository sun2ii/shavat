{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":147,"content":[{"type":"heading","content":["ZABULI YA 147"]},{"type":"verse","number":1,"content":[{"text":"Mtogoleni Mndewa Imulungu.","poem":1},{"lineBreak":true},{"text":"Vinoga kumgwaa nhogolwa Imulungu wetu,","poem":1},{"lineBreak":true},{"text":"kwavija yonogeza na vivo ilondigwa kumwimbila nhogolwa heyo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu kodizenga kabili buga da Yelusalemu,","poem":1},{"lineBreak":true},{"text":"kowabweza Waizilaeli wagaligwe kuuhamizo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kowahonya wahondigwe mizoyo,","poem":1},{"lineBreak":true},{"text":"na kovifunga vilonda vao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kopanga nhondo zokuwa nyingahi,","poem":1},{"lineBreak":true},{"text":"na kozigwaa kila imoja twaga jake.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mndewa wetu mkulu na kana udahi ng'hani,","poem":1},{"lineBreak":true},{"text":"nzewele zake hazidahika kupimigwa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu kowenula wahole,","poem":1},{"lineBreak":true},{"text":"lakini kowabwanha hasi mditimbwisi wanhu wehile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mwimbileni Mndewa Imulungu nyila za kumgwaa nhogolwa,","poem":1},{"lineBreak":true},{"text":"mtoweleni bango Imulungu wetu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Heyo kougubika ulanga kwa mingu,","poem":1},{"lineBreak":true},{"text":"koitowela mvula isi,","poem":1},{"lineBreak":true},{"text":"na koteza minoga kuvigongo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kowagwaa wanyama ndiya yao,","poem":1},{"lineBreak":true},{"text":"na kogadima makinda ga bondwa gahalila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Heyo halonda nguvu za falasi,","poem":1},{"lineBreak":true},{"text":"na hanogelwa na nguvu za wakalizi,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"lakini konogezwa na wanhu omdumba,","poem":1},{"lineBreak":true},{"text":"wanhu otamanila unogelo wake hawishaga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Gweye Yelusalemu, mtogole Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"gweye Sayuni, mtogole Imulungu wako.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kwavija heyo kaigangamiza mhalalingwe ya mulango wako,","poem":1},{"lineBreak":true},{"text":"na kowatendela ganogile wanhu weli mgati yako.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kokugwaa tindiwalo mzimbaka zako,","poem":1},{"lineBreak":true},{"text":"kokutenda ushibe kwa ngano inogile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Heyo kogala lagizo jake mwiisi,","poem":1},{"lineBreak":true},{"text":"na mbuli yake yokimbila hima hima.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kokwanzanza seluji kamba mgolole wa sufi,","poem":1},{"lineBreak":true},{"text":"kodipwililisa tungwe kamba tozi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kogala mvula ya mabwe kamba msele,","poem":1},{"lineBreak":true},{"text":"kuduhu munhu yodaha kwima mbuli ya beho jake.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Koituma mbuli yake navo volumbuka,","poem":1},{"lineBreak":true},{"text":"kogala beho jake na mazi gokilima.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Komulongela Yakobo mbuli yake,","poem":1},{"lineBreak":true},{"text":"malagizo gake na mafundizo gake kwa Izilaeli.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Hanatenda vivo kwa wanhu wa isi yoyose iyagwe,","poem":1},{"lineBreak":true},{"text":"hewo hawagajuwile malagizo gake.","poem":1},{"lineBreak":true},{"text":"Mtogoleni Mndewa Imulungu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}