{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":148,"content":[{"type":"heading","content":["ZABULI YA 148"]},{"type":"verse","number":1,"content":[{"text":"Mtogoleni Mndewa Imulungu.","poem":1},{"lineBreak":true},{"text":"Mtogoleni Mndewa Imulungu kulawa kuulanga,","poem":1},{"lineBreak":true},{"text":"mtogoleni kuko kuyeli uchanha.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mtogoleni heyo, mweye wasenga zake wose wa kuulanga,","poem":1},{"lineBreak":true},{"text":"mtogoleni heyo, mweye wakalizi wose wa kuulanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mtogoleni heyo, mweye zuwa na mbalamwezi,","poem":1},{"lineBreak":true},{"text":"mtogoleni heyo, mweye nhondo zose zing'ala.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mtogoleni heyo, mweye ulanga wa uchanha ng'hani,","poem":1},{"lineBreak":true},{"text":"na mweye mazi geli uchanha ya ulanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Vose viditogole twaga da Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kwavija heyo kalagiza na vose vilumbigwa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Heyo kavika hanhu hao siku zose na milele,","poem":1},{"lineBreak":true},{"text":"kalava lagizo hadibenigwa bule.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mtogoleni Mndewa Imulungu kulawa mwiisi,","poem":1},{"lineBreak":true},{"text":"mweye viumbe vikulu vili mbahali na vidibo va bahali,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"mimwesa na mvula ya mabwe, seluji na kungugu,","poem":1},{"lineBreak":true},{"text":"na kukuzumbi vose vovikiza mbuli yako.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mtogoleni heyo, mweye migongo na vigongo vose,","poem":1},{"lineBreak":true},{"text":"mibiki ya matunda na mielezi yose.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mtogoleni heyo, mweye wanyama wa kumuhulo na ofugigwa,","poem":1},{"lineBreak":true},{"text":"na wang'onyo otambala na ndege oguluka.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mtogoleni heyo, mweye wandewa wa isi yose,","poem":1},{"lineBreak":true},{"text":"na wakulu na watawala wa mwiisi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mtogoleni heyo, mweye wabwanga na wandele,","poem":1},{"lineBreak":true},{"text":"wavele na wana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Wose waditogole twaga da Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kwavija twaga jake diiyeka dijo kulu,","poem":1},{"lineBreak":true},{"text":"ukulu wake wa uchanha ya isi na ulanga.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Heyo kawagwaa wanhu zake nguvu,","poem":1},{"lineBreak":true},{"text":"na nhogolwa kwa wanhu zake wose otamaniligwa,","poem":1},{"lineBreak":true},{"text":"wanhu wa Izilaeli weli behi na moyo wake.","poem":1},{"lineBreak":true},{"text":"Mtogoleni Mndewa Imulungu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}