1},{"lineBreak":true},{"text":"na wembe kwa deng'ho mvisazi vao.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wamgwee nhogolwa Imulungu kwa sauti ng'hulu,","poem":1},{"lineBreak":true},{"text":"mmakono gao wagoge masime gokanha kuno na kuno,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ili wawabwezele gehile wanhu wa isi ziyagwe,","poem":1},{"lineBreak":true},{"text":"wawakoboze makabila ga isi,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"wawafunge wandewa zao kwa minyololo,","poem":1},{"lineBreak":true},{"text":"na vilongozi zao kwa mhingu za zuma,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ili kuwatendela nhaguso ilondeka kumwao.","poem":1},{"lineBreak":true},{"text":"Uno awo ukulu wa wanhu otamaniligwa.","poem":1},{"lineBreak":true},{"text":"Mtogoleni Mndewa Imulungu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}