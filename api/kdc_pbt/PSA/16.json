{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":16,"content":[{"type":"heading","content":["ZABULI YA 16"]},{"type":"hebrew_subtitle","content":["(Lwila lwa Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Unikalize gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kwavija kumwako nikukimbilila.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nomulongela Mndewa Imulungu, “Gweye kwa Mndewa wangu,","poem":1},{"lineBreak":true},{"text":"nabule dinogile ila gweye.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Iwanhu wang'alile weli mwiisi awo wanogile,","poem":1},{"lineBreak":true},{"text":"awo ninogezwa na hewo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lakini iwanhu oitambikila imilungu iyagwe,","poem":1},{"lineBreak":true},{"text":"ogaya ng'hani.","poem":1},{"lineBreak":true},{"text":"Nhosa yao ya damu siilava bule,","poem":1},{"lineBreak":true},{"text":"na matwaga gao sigatambula mmulomo wangu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Gweye Mndewa Imulungu ayo fungu jangu na kikasi changu,","poem":1},{"lineBreak":true},{"text":"gweye ayo ugoga ugima wangu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Zimbaka zangu zibitila hanhu hanogile,","poem":1},{"lineBreak":true},{"text":"ona nipata uhazi unogile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nomtogola Mndewa Imulungu, ayo yonigwaa magesa,","poem":1},{"lineBreak":true},{"text":"vivija ikilo moyo wangu onifunza.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Siku zose nimwika Mndewa Imulungu kuulongozi wangu,","poem":1},{"lineBreak":true},{"text":"kwavija kaubanzi wangu wa ukudila avo sigwaya bule.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Avo moyo wangu odeng'helela na lulimi lwangu lotowa lukenze,","poem":1},{"lineBreak":true},{"text":"na lukuli lose lodeng'helela na niye nokala goya.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kwavija honda undeke kuzimu,","poem":1},{"lineBreak":true},{"text":"na hundeka niye imunhu wako yotamanilwa nyone kukola.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Konilagusila nzila ya ugima,","poem":1},{"lineBreak":true},{"text":"kuulongozi wako kuna deng'ho,","poem":1},{"lineBreak":true},{"text":"na mumkono wako wa ukudila kuna ganogile gakalaga milele.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}