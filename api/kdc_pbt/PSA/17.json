{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":17,"content":[{"type":"heading","content":["ZABULI YA 17"]},{"type":"hebrew_subtitle","content":["(Kupula kwa Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"utegeleze kitala changu cha haki,","poem":1},{"lineBreak":true},{"text":"utegeleze kililo changu,","poem":1},{"lineBreak":true},{"text":"utegeleze ukupula kwangu,","poem":1},{"lineBreak":true},{"text":"vinipula bila uvizi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Haki yangu na ilawe kumwako,","poem":1},{"lineBreak":true},{"text":"na meso gako galole ganogile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gweye kuujuwa moyo wangu,","poem":1},{"lineBreak":true},{"text":"kunizila ikilo kunilola,","poem":1},{"lineBreak":true},{"text":"kunigeza na hugonile gehile mgati yangu,","poem":1},{"lineBreak":true},{"text":"silongile giladi gehile mmulomo wangu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kwa gaja gotendigwa na wanhu,","poem":1},{"lineBreak":true},{"text":"niigoga mbuli ya mulomo wako,","poem":1},{"lineBreak":true},{"text":"nizilema nzila za awo otenda gehile.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Magulu gangu gatembela mnzila zako,","poem":1},{"lineBreak":true},{"text":"magulu gangu hagatelebuke bule.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nokukema gweye Mndewa Imulungu, kwavija konidika,","poem":1},{"lineBreak":true},{"text":"uhulike kwa gwiti jako na utegeleze gonilonga.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lagusa unogelo wako hawishaga,","poem":1},{"lineBreak":true},{"text":"gweye ukombolaga iwanhu okukimbilila,","poem":1},{"lineBreak":true},{"text":"kwa mkono wako wa ukudila uwakalize kulawa kwa iwanhu owehila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Unikalize kamba imwana wa siso jako,","poem":1},{"lineBreak":true},{"text":"unifise mna imbeho ya mabawa gako,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"sikunyoneke na iwanhu onihila,","poem":1},{"lineBreak":true},{"text":"na awo wanizunguluke.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Awo wabule bazi mmizoyo yao,","poem":1},{"lineBreak":true},{"text":"wamema mbuli za kuitapa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Onikweleleza na kunizunguluka,","poem":1},{"lineBreak":true},{"text":"ozahila nyafasi wanibwanhe hasi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hewo waigala na simba yolonda kuvamila,","poem":1},{"lineBreak":true},{"text":"na kamba mwana wa simba yaifisile ili kuvamila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Winuke, Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"uwavamile na kuwabwanha hasi.","poem":1},{"lineBreak":true},{"text":"Kwa sime uikombole loho yangu kulawa mmakono ga awo wehile.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kwa mkono wako unikombole kulawa kwa wanhu awo,","poem":1},{"lineBreak":true},{"text":"iwanhu wa mwiisi ino awo fungu jao da muugima uno.","poem":1},{"lineBreak":true},{"text":"Uwakoboze ng'hani,","poem":1},{"lineBreak":true},{"text":"wanao wapate nhaguso ng'hulu kubanza ayo.","poem":1},{"lineBreak":true},{"text":"Nhaguso ayo igendelele mbaka kwa wazukulu zao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Lakini niye nokilola kihanga chako mna ihaki,","poem":1},{"lineBreak":true},{"text":"nahalamuka nokwiguta kihanga chako.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}