{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":18,"content":[{"type":"heading","content":["ZABULI YA 18"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi iyamwimbile Mndewa Imulungu mbuli ya kipindi viyakomboligwe kulawa mmakono ga Sauli na wanhu wayagwe omwihila.)",{"noteId":1}]},{"type":"verse","number":1,"content":[{"text":"Nokunogela gweye Mndewa Imulungu, nguvu yangu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu ayo dibwe jangu,","poem":1},{"lineBreak":true},{"text":"na ngome yangu na mkombola wangu,","poem":1},{"lineBreak":true},{"text":"Imulungu wangu na dibwe jangu dinikimbilile,","poem":1},{"lineBreak":true},{"text":"na ngao ya ukombola wangu na ngome yangu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nomkema Mndewa Imulungu yolondigwa kutogoligwa,","poem":1},{"lineBreak":true},{"text":"kanikombola kulawa kwa iwanhu onihila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nzabi za ifa zinizunguluka,","poem":1},{"lineBreak":true},{"text":"ng'humbi ingubika.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nzabi za kuzimu zinizingiliza,","poem":1},{"lineBreak":true},{"text":"mitego ya ifa ingoga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mmagazo gangu nimkema Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"nimulilila Imulungu wangu yanitaze.","poem":1},{"lineBreak":true},{"text":"Kulawa mng'anda yake kahulika sauti yangu,","poem":1},{"lineBreak":true},{"text":"na kililo changu kimvikila mmagwiti gake.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Aho isi igwaya na kutigisika,","poem":1},{"lineBreak":true},{"text":"imigimbo ya vigongo igwaya,","poem":1},{"lineBreak":true},{"text":"kwavija Imulungu kagevuzika.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yosi difililika kulawa mmhula zake,","poem":1},{"lineBreak":true},{"text":"moto usakaza ulawa mmulomo wake,","poem":1},{"lineBreak":true},{"text":"makala ga moto gazipuka kulawa kumwake.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Katula ulanga kahumuluka hasi,","poem":1},{"lineBreak":true},{"text":"mawingu matitu gakala hasi ya magulu gake.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kakwela kiumbe kili na mabawa kaguluka,","poem":1},{"lineBreak":true},{"text":"kahumuluka mdibeho kamba ndege.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kaigubika ziza kila mwambu,","poem":1},{"lineBreak":true},{"text":"mawingu gazamile gamemile mazi gamzunguluka.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kwa mng'alo wake mawingu gasegela,","poem":1},{"lineBreak":true},{"text":"itowa mvula ya mabwe na mimwesa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mndewa Imulungu kaduma kulawa kuulanga,","poem":1},{"lineBreak":true},{"text":"heyo yeli Uchanha Ng'hani kalava sauti yake,","poem":1},{"lineBreak":true},{"text":"mvula ya mabwe na mabwe gokwaka moto vilagala.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Katowa misale yake kawaswaswanya iwanhu omwihila,","poem":1},{"lineBreak":true},{"text":"kagala mimwesa kawawinga.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Abaho hasi kuna ibahali koneka,","poem":1},{"lineBreak":true},{"text":"ichandusilo cha isi kigubuka,","poem":1},{"lineBreak":true},{"text":"gweye Mndewa Imulungu vuukomhoke,","poem":1},{"lineBreak":true},{"text":"kwa ukubuma kwa mhumuzi ya mhula yako.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Imulungu kagolosa mkono wake kulawa uchanha kangoga,","poem":1},{"lineBreak":true},{"text":"kanivabula kulawa mmazi mengi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kanikombola kulawa kwa wanhu onihila weli na nguvu,","poem":1},{"lineBreak":true},{"text":"na kanihonya kulawa kwa awo onihila,","poem":1},{"lineBreak":true},{"text":"kwavija wakala na nguvu kubanza niye.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wanivamila ving'halile mmagazo,","poem":1},{"lineBreak":true},{"text":"lakini Mndewa Imulungu kanitaza.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Kanigala hanhu hana inyafasi,","poem":1},{"lineBreak":true},{"text":"kanikombola kwavija kaninogela.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mndewa Imulungu kanhendela kamba haki yangu viili,","poem":1},{"lineBreak":true},{"text":"kanhunza kwavija makono gangu gabule ubananzi,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"kwavija niikweleleza nzila ya Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"na sitendile gehile na kumuleka Imulungu wangu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Kwavija malagizo gake gose nigagoga,","poem":1},{"lineBreak":true},{"text":"na mafundizo gake sigalekile.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Na niye nitelela kuulongozi wake,","poem":1},{"lineBreak":true},{"text":"niigomesa sikunitende nzambi.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Avo Mndewa Imulungu kanitunza kamba vinitendile,","poem":1},{"lineBreak":true},{"text":"kanhunza kwavija makono gangu gabule ubananzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Gweye kotamaniligwa kwa wanhu otamaniligwa,","poem":1},{"lineBreak":true},{"text":"kwa yelibule kitala koilagusa kwabule kitala.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Gweye kung'ala kwa waja wang'alile,","poem":1},{"lineBreak":true},{"text":"lakini kwa wanhu otenda gehile kolagusa usede.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Gweye kowakombola iwanhu wahole,","poem":1},{"lineBreak":true},{"text":"lakini kowahumulusa iwanhu oitapa.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Kwavija gweye koibwinha taa yangu,","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu konimwemwesela mdiziza.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Gweye wahanitaza nodihuma bumbila da wakalizi,","poem":1},{"lineBreak":true},{"text":"kwa Imulungu wangu nodaha kuzumha luwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Sang'hano za Imulungu zitelela,","poem":1},{"lineBreak":true},{"text":"imbuli ya Mndewa Imulungu ya kweli,","poem":1},{"lineBreak":true},{"text":"heyo ayo ngao kwa iwanhu wose omkimbilila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Haduhu yeli Imulungu ila Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"haduhu yeli dibwe ila Imulungu wetu.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Imulungu ayo yanigwelele nguvu,","poem":1},{"lineBreak":true},{"text":"na kaitenda nzila yangu itelele.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Kaigangamiza migulu yangu sikuitelebuke kamba ya nhelembo,","poem":1},{"lineBreak":true},{"text":"kanika goya uchanha kunhembeti.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Kogafunza makono gangu kuitowa ng'hondo,","poem":1},{"lineBreak":true},{"text":"makono gangu gana nguvu ya kuvedula upinde uli na nguvu.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Kunigwaa ngao yako ya kunikombola,","poem":1},{"lineBreak":true},{"text":"mkono wako wa ukudila unigoga,","poem":1},{"lineBreak":true},{"text":"ukunoga kwako unitenda mkulu.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Kuitanula nzila yangu,","poem":1},{"lineBreak":true},{"text":"na migulu yangu haitelebuke bule.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Niwakweleleza iwanhu onihila na niwagoga,","poem":1},{"lineBreak":true},{"text":"sibwelile kuchugu mbaka vuwabanangigwe wose.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Niwabwanha hasi na hawadahile kwinuka kabili,","poem":1},{"lineBreak":true},{"text":"wagwa hasi ya magulu gangu.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Gweye kunigwaa nguvu ya kuitowa kung'hondo.","poem":1},{"lineBreak":true},{"text":"Kuwabwanha hasi yangu iwanhu onilema.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Kuwatenda iwanhu onihila wakimbile,","poem":1},{"lineBreak":true},{"text":"na awo onilema niye niwabananga.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Waguta mizangi lakini hakala haduhu munhu yoyose wa kuwataza,","poem":1},{"lineBreak":true},{"text":"wamulilila Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"lakini heyo hawedike bule.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Niwahonda wagaluka kamba timbwisi vidihembeluswa na beho,","poem":1},{"lineBreak":true},{"text":"niwabojoga kamba tope da mnzila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Gweye kunikombola kulawa kwa iwanhu wanivamile,","poem":1},{"lineBreak":true},{"text":"kunitenda niwe mtawala wa isi zose,","poem":1},{"lineBreak":true},{"text":"iwanhu siwajuwile wanisang'hanila.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Wanhu baki weza kumwangu kuno onifugamila,","poem":1},{"lineBreak":true},{"text":"bahaja viwahulike nolonga wanitegeleza.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Wageni wakala wabule tamanilo,","poem":1},{"lineBreak":true},{"text":"weza kumwangu kulawa mzingome zao akuno ogwaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"Mndewa Imulungu kamgima!","poem":1},{"lineBreak":true},{"text":"Yatogoligwe dibwe jangu!","poem":1},{"lineBreak":true},{"text":"Yatogoligwe Imulungu wa ukombola wangu!","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Imulungu ayo yanidahize kuwalihiza gehile,","poem":1},{"lineBreak":true},{"text":"na kaweka hasi yangu iwanhu wa isi zose.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Kanikombola kulawa kwa iwanhu onihila,","poem":1},{"lineBreak":true},{"text":"kaninula uchanha ya awo onilema niye,","poem":1},{"lineBreak":true},{"text":"na kanigala kutali ya iwanhu iwasede.","poem":1}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"Kwa mbuli ayo, nokutogola gweye Mndewa Imulungu hagati ya iwanhu wa isi zose,","poem":1},{"lineBreak":true},{"text":"na nokwimba na kulonga twaga jako kulu.","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Imulungu kamgwaa mndewa wake mhumo ng'hulu,","poem":1},{"lineBreak":true},{"text":"kalagusa unogelo wake hawishaga kwa ayo iyamsagule,","poem":1},{"lineBreak":true},{"text":"kwa Daudi na ulelo wake milele.","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Lola kitabu cha 1 Samweli 23:7-14 na 2 Samweli 22:1-51.","reference":{"chapter":18,"verse":0}}]},"thisChapterLink":"/api/kdc_pbt/PSA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/17.json","previousChapterAudioLinks":{},"numberOfVerses":50}