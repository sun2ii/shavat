{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":19,"content":[{"type":"heading","content":["ZABULI YA 19"]},{"type":"hebrew_subtitle","content":["(Kwa kilanja, Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Ulanga olonga ukulu wa Imulungu,","poem":1},{"lineBreak":true},{"text":"na langa da uchanha dosimulila sang'hano ya makono gake.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Imisi yolonga na imisi iyagwe,","poem":1},{"lineBreak":true},{"text":"ikilo yosimulila na ikilo kiyagwe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Haduhu kulonga hebu ulonzi,","poem":1},{"lineBreak":true},{"text":"sauti yao haihulikwa,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ila, sauti yao yenela mwiisi yose,","poem":1},{"lineBreak":true},{"text":"na mbuli zao zovika mbaka kuihelela isi yose.","poem":1},{"lineBreak":true},{"text":"Imulungu kadikila zuwa ukazi wake ako kuulanga,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"dolawa kamba mbigalo yodeng'helela kupata mwehe,","poem":1},{"lineBreak":true},{"text":"dodeng'ha kamba imunhu galu viyoitanda kukimbila.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dosomoka kulawa kuuhelela ulanga,","poem":1},{"lineBreak":true},{"text":"na dozunguluka mbaka mwambu uyagwe,","poem":1},{"lineBreak":true},{"text":"haduhu kinhu kidaha kuifisa na vuke jake.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Malagizo ga Mndewa Imulungu gatelela,","poem":1},{"lineBreak":true},{"text":"goideng'heza loho,","poem":1},{"lineBreak":true},{"text":"Amuli za Mndewa Imulungu za ukweli,","poem":1},{"lineBreak":true},{"text":"zomgwaa ubala imunhu yauswelile.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nzila za Mndewa Imulungu zinoga,","poem":1},{"lineBreak":true},{"text":"zoudeng'heza moyo,","poem":1},{"lineBreak":true},{"text":"lagizo da Mndewa Imulungu ding'ala,","poem":1},{"lineBreak":true},{"text":"dogamwemwesela meso.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kumdumba Mndewa Imulungu kunoga,","poem":1},{"lineBreak":true},{"text":"kokala milele.","poem":1},{"lineBreak":true},{"text":"Malagizo ga Mndewa Imulungu ga kweli","poem":1},{"lineBreak":true},{"text":"na gose gana haki.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ago ga kusulukila kubanza zahabu,","poem":1},{"lineBreak":true},{"text":"na kubanza zahabu ing'ala ng'hani.","poem":1},{"lineBreak":true},{"text":"Gamulile kubanza uki,","poem":1},{"lineBreak":true},{"text":"kubanza uki unogile.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Msang'hanaji wako kozumwa kwa gago,","poem":1},{"lineBreak":true},{"text":"munhu yahagagoga kopata nhunza ng'hulu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nani yodaha kugona gehile gake mwenyego?","poem":1},{"lineBreak":true},{"text":"Gagele kumgongo gehile gangu sigajuwile.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Unikalize niye msang'hanaji wako na nzambi zitendagwa giladi,","poem":1},{"lineBreak":true},{"text":"sikuutogole gago ganitawale!","poem":1},{"lineBreak":true},{"text":"Aho nokuwa ning'ala na nokuwa nabule kitala kikulu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Leka mbuli za mulomo wangu na magesa ga nzewele zangu,","poem":1},{"lineBreak":true},{"text":"gatogoligwe kuulongozi wako gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"dibwe jangu na mkombola wangu!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}