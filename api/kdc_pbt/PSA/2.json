{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"heading","content":["ZABULI YA 2"]},{"type":"verse","number":1,"content":[{"text":"Habali iwanhu wa isi ziyagwe opanga gehile?","poem":1},{"lineBreak":true},{"text":"Habali iwanhu okala kiseto cha ubozi?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Iwandewa wa mwiisi waitanda,","poem":1},{"lineBreak":true},{"text":"na iwakulu okala kiseto,","poem":1},{"lineBreak":true},{"text":"mbuli ya Mndewa Imulungu na mbuli ya ayo iyamsagule, olonga,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"“Leka tukanhe minyololo yao,","poem":1},{"lineBreak":true},{"text":"na tuvitupe ivifungilo vao.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Heyo yokala kuulanga koseka,","poem":1},{"lineBreak":true},{"text":"Mndewa kowabezeli vuwogelegeza.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Abaho kolonga na hewo mna ing'hasiliki yake,","poem":1},{"lineBreak":true},{"text":"na kowadumbiza mna ing'hasiliki, kolonga,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"“Na niye nimwika mndewa wangu uchanha ya Sayuni,","poem":1},{"lineBreak":true},{"text":"ulugongo lwangu lung'ala.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nodipeta lagizo da Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu kanilongela,","poem":1},{"lineBreak":true},{"text":"“Gweye kwa mwanangu, lelo niye nikulela.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nipule na niye nokugwaa iwanhu wa isi zose wawe uhazi wako,","poem":1},{"lineBreak":true},{"text":"na isi yose yokuwa yako gweye.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kowabena kwa fimbo ya zuma","poem":1},{"lineBreak":true},{"text":"na kowahonda vihande vihande kamba nongo ya mulumba.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Avo sambi, mweye wandewa, muwe na nzewele,","poem":1},{"lineBreak":true},{"text":"tegelezeni vimzumwa, mweye iwakulu wa isi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mumsang'hanile Mndewa Imulungu kwa kumdumba,","poem":1},{"lineBreak":true},{"text":"na mudeng'helele kwa kugwaya.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mtambikileni imwana,","poem":1},{"lineBreak":true},{"text":"buleavo kogevuzika na kuwabananga,","poem":1},{"lineBreak":true},{"text":"kwavija ng'hasiliki yake yodaha kwaka himahima.","poem":1},{"lineBreak":true},{"text":"Wamweda wose omkimbilila.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}