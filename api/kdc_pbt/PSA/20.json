{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"heading","content":["ZABULI YA 20"]},{"type":"hebrew_subtitle","content":["(Kwa kilanja, Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Mndewa Imulungu yakwidike mna isiku ya magazo.","poem":1},{"lineBreak":true},{"text":"Twaga da Imulungu wa Yakobo dikukalize.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yakutaze kulawa hanhu hong'ala,","poem":1},{"lineBreak":true},{"text":"na yakutaze kulawa kulugongo lwa Sayuni.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yazikumbuke sadaka zako zose,","poem":1},{"lineBreak":true},{"text":"na yazitogole nhosa zako za kusoma moto.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yakugwee gaja goulonda mmoyo wako,","poem":1},{"lineBreak":true},{"text":"na ugavikize gose gougelegeza kutenda.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Todeng'helela kwa ukombola wako,","poem":1},{"lineBreak":true},{"text":"tokwinula bendela kuditogola twaga da Imulungu wetu.","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu yakugwee gose guupula.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nojuwa Mndewa Imulungu komkombola imndewa iyamsagule,","poem":1},{"lineBreak":true},{"text":"komwidika kulawa hanhu hong'ala ako kuulanga,","poem":1},{"lineBreak":true},{"text":"kwa mkono wake wa kudila komgwaa mhumo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Iwanhu wayagwe oitapa kwa mituka ya ng'hondo,","poem":1},{"lineBreak":true},{"text":"na iwanhu wayagwe oitapa kwa falasi wao.","poem":1},{"lineBreak":true},{"text":"Lakini siye toigodela Mndewa Imulungu, Imulungu wetu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hewo oikwala na kugwa,","poem":1},{"lineBreak":true},{"text":"lakini siye tokwinuka na kwima.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"umuhonye imndewa!","poem":1},{"lineBreak":true},{"text":"Utwidike twahakukema.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}