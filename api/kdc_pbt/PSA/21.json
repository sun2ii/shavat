{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":21,"content":[{"type":"heading","content":["ZABULI YA 21"]},{"type":"hebrew_subtitle","content":["(Kwa kilanja, Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Go Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"mndewa kodeng'helela kwa nguvu zako,","poem":1},{"lineBreak":true},{"text":"kodeng'helela ng'hani kwavija kumkombola.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kumgwelela gaja goyolonda mmoyo wake,","poem":1},{"lineBreak":true},{"text":"na hugalemile gaja gayapulile kwa mulomo wake.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kumwizila na kumgwaa gaja ganogile,","poem":1},{"lineBreak":true},{"text":"kumvaza taji ya zahabu inogile kupala jake.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kakupula ugima na gweye kumgwaa,","poem":1},{"lineBreak":true},{"text":"kumtenda yakale siku nyingi siku zose na milele.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kapata ukulu kubitila ukombola wako,","poem":1},{"lineBreak":true},{"text":"gweye kumgwelela ukulu na nhogolwa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kwavija kumtenda yamwede milele,","poem":1},{"lineBreak":true},{"text":"komtenda yadeng'he kwavija gweye kwa hamoja na heyo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kwavija mndewa komtamanila Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"na kubitila unogelo hawishaga wa ayo yeli uchanha ng'hani honda yasegesigwe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mkono wako owazahila iwanhu okwihila,","poem":1},{"lineBreak":true},{"text":"mkono wako wa ukudila owazahila iwanhu wose okulema.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wahalawila kowabananga kamba tanuli da moto.","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu kowameza mna ing'hasiliki yake,","poem":1},{"lineBreak":true},{"text":"na moto owasakaza.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kowabananga iwanhu wa ulelo wao kulawa mwiisi,","poem":1},{"lineBreak":true},{"text":"na iwana wa hewo kulawa kwa iwanhu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Wahalonda kukutendela gehile,","poem":1},{"lineBreak":true},{"text":"kwa kugelegeza gehile olemelwa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kwavija kowaswaswanya na kowatenda wakimbile,","poem":1},{"lineBreak":true},{"text":"kwa upinde wako uuvutile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Utogoligwe gweye Mndewa Imulungu, mbuli ya nguvu zako.","poem":1},{"lineBreak":true},{"text":"Siye tokwimba na kuutogola udahi wako.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}