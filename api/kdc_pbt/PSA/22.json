{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":22,"content":[{"type":"heading","content":["ZABULI YA 22"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi. Kwa kilanja, yatumie lwila lwa, “Nhelembo wa ulukwili.”)"]},{"type":"verse","number":1,"content":[{"text":"Imulungu wangu, Imulungu wangu,","poem":1},{"lineBreak":true},{"text":"habali kundeka?","poem":1},{"lineBreak":true},{"text":"Habali kwa kutali na ukombola wangu?","poem":1},{"lineBreak":true},{"text":"Habali kwa kutali na kililo changu?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Go Imulungu wangu, imisi nolila lakini hunidika bule,","poem":1},{"lineBreak":true},{"text":"ikilo noguta lakini sidaha kubwihila bule.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Lakini gweye kung'ala,","poem":1},{"lineBreak":true},{"text":"gweye kokala mkigoda kamba mndewa,","poem":1},{"lineBreak":true},{"text":"na kotogoligwa na wanhu wa Izilaeli.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kumwako gweye iwahenga zetu watamanila,","poem":1},{"lineBreak":true},{"text":"wakutamanila na gweye kuwakombola.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wakulilila gweye, na wakomboligwa,","poem":1},{"lineBreak":true},{"text":"kumwako gweye watamanila na hawagwile kinyala bule.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lakini niye kamba mng'onyo, sili munhu bule,","poem":1},{"lineBreak":true},{"text":"ndemigwa na kubezigwa na iwanhu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wose onilola oniseka ng'hani,","poem":1},{"lineBreak":true},{"text":"oniliga na ominula milomo yao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Olonga, “Kamtamanila Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"leka Imulungu yamkombole!","poem":1},{"lineBreak":true},{"text":"Kamba Imulungu komnogela beta yamkombole!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Lakini gweye ayo unilavile mmunda wa mamangu,","poem":1},{"lineBreak":true},{"text":"kunitenda nikutamanile gweye mmatombo ga mamangu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nikutamanila gweye tangu nileleke.","poem":1},{"lineBreak":true},{"text":"Tangu nileligwe gweye ayo Imulungu wangu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sikuukale kutali na niye kwavija magazo ga behi,","poem":1},{"lineBreak":true},{"text":"na haduhu munhu yodaha kunitaza.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Iwanhu wehile wanizunguluka kamba ng'ombe mbigalo,","poem":1},{"lineBreak":true},{"text":"wanimemela kamba ng'ombe mbigalo weli na nguvu kulawa ako Bashani.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wagubula milomo yao kamba simba,","poem":1},{"lineBreak":true},{"text":"kobuma na kunipalula.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Nitika kamba mazi,","poem":1},{"lineBreak":true},{"text":"na mizege yangu yose yogedela,","poem":1},{"lineBreak":true},{"text":"moyo wangu kamba uhota,","poem":1},{"lineBreak":true},{"text":"olumbuka mgati yangu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nguvu za lukuli lwangu zinyala kamba zae,","poem":1},{"lineBreak":true},{"text":"lulimi lwangu lonata mmulomo wangu.","poem":1},{"lineBreak":true},{"text":"Kunileka mna inhimbwisi ya ifa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Umbwa wanizunguluka,","poem":1},{"lineBreak":true},{"text":"iwanhu wehile wanizunguluka,","poem":1},{"lineBreak":true},{"text":"wanitobola mmagulu na mmakono.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nisigala mizege iyeka,","poem":1},{"lineBreak":true},{"text":"iwanhu onihila onilola na kunisimanga.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Oigolela viwalo vangu,","poem":1},{"lineBreak":true},{"text":"wakibwanhila simbi kiwalo changu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Lakini gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"sikuukale kutali na niye,","poem":1},{"lineBreak":true},{"text":"Gweye kwa nguvu zangu,","poem":1},{"lineBreak":true},{"text":"wize himahima unitaze.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Uhonye ugima wangu na sime,","poem":1},{"lineBreak":true},{"text":"uhonye ugima wangu unogile kulawa kwa iwaumbwa wano.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nihonye kulawa mdilomo da simba,","poem":1},{"lineBreak":true},{"text":"na ihonye loho yangu kulawa mzimhembe za ng'ombe poli wano.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Nowasimulila ndugu zangu twaga jako,","poem":1},{"lineBreak":true},{"text":"mna umting'hano nokutogola.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mweye mumdumba Mndewa Imulungu, mtogoleni!","poem":1},{"lineBreak":true},{"text":"Mtogoleni mweye iwanhu wa ulelo wa Yakobo!","poem":1},{"lineBreak":true},{"text":"Mdumbeni Mndewa Imulungu mweye iwanhu wa ulelo wa Izilaeli.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Kwavija heyo hamwehula wala kumbezeli mkiwa,","poem":1},{"lineBreak":true},{"text":"na haifisa kutali na heyo,","poem":1},{"lineBreak":true},{"text":"ila komtegeleza yahampula.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Mbuli yako nokutogola mna umting'hano wa iwanhu wengi,","poem":1},{"lineBreak":true},{"text":"nogavikiza gaja ganongile kuulongozi wa awo okudumba.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Wakiwa oja na kushiba,","poem":1},{"lineBreak":true},{"text":"iwanhu omzahila Mndewa Imulungu omtogola.","poem":1},{"lineBreak":true},{"text":"Imulungu yawagwee ugima milele.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Uhelelo wa isi yose okumbuka na kumbwelela Mndewa Imulungu.","poem":1},{"lineBreak":true},{"text":"Iwanhu wa isi zose omtambikila,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"kwavija Mndewa Imulungu ayo mndewa,","poem":1},{"lineBreak":true},{"text":"na kowatawala iwanhu wa isi zose.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Iwanhu weli na kibuli mwiisi omtambikila kuulongozi wake,","poem":1},{"lineBreak":true},{"text":"iwanhu wose ofa omfugamila,","poem":1},{"lineBreak":true},{"text":"iwanhu wose hawadaha kugoga ugima wao.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ulelo ukwiza omtambikila,","poem":1},{"lineBreak":true},{"text":"na ulelo onda wize osimuliligwa mbuli za Mndewa.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Osimulila mbuli za haki yake.","poem":1},{"lineBreak":true},{"text":"Iwanhu wang'hali hawanaleligwa olongeligwa,","poem":1},{"lineBreak":true},{"text":"“Mndewa Imulungu ayo yatendile mbuli ayo!”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}