{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"heading","content":["ZABULI YA 23"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Mndewa Imulungu ayo msusilaji wangu,","poem":1},{"lineBreak":true},{"text":"niye siswela kinhu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Konihumuza mmajani mabisi,","poem":1},{"lineBreak":true},{"text":"konilongoza behi na mazi gatindiwale.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Koibwezela nguvu loho yangu.","poem":1},{"lineBreak":true},{"text":"Konilongoza mnzila inogile mbuli ya twaga jake.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nahabita kudikonde da ziza kulu,","poem":1},{"lineBreak":true},{"text":"sidumba kinhu chochose,","poem":1},{"lineBreak":true},{"text":"kwavija gweye Mndewa Imulungu kwa hamoja na niye,","poem":1},{"lineBreak":true},{"text":"mkongoja wako na fimbo yako vonikaliza.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Konitendela nyimwilinyimwili kuulongozi wa iwanhu onihila,","poem":1},{"lineBreak":true},{"text":"kunigidila mavuta kudipala jangu,","poem":1},{"lineBreak":true},{"text":"kikasi changu kukimemeza mbaka chokwitika.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kweli kunoga kwako na unogelo wako hawishaga vokuwa hamoja na niye,","poem":1},{"lineBreak":true},{"text":"siku zose za ugima wangu,","poem":1},{"lineBreak":true},{"text":"niye nokala mng'anda ya Mndewa Imulungu milele.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}