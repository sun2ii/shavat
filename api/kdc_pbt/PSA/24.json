"lineBreak":true},{"text":"Munhu ayo kobokela ganogile kulawa kwa Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"na haki kulawa kwa Imulungu mkombola wake.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Uno awo ulelo wa iwanhu omkweleleza heyo,","poem":1},{"lineBreak":true},{"text":"iwanhu ozahila kihanga chako, gweye Imulungu wa Yakobo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Vugukeni mweye milango,","poem":1},{"lineBreak":true},{"text":"vugukeni mweye milango ya umwaka,","poem":1},{"lineBreak":true},{"text":"ili Mndewa yeli na udahi wose yengile.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nani ayo Mndewa yeli na udahi wose?","poem":1},{"lineBreak":true},{"text":"Ayo Mndewa Imulungu, yeli na nguvu na mdaha gose,","poem":1},{"lineBreak":true},{"text":"heyo ayo Mndewa Imulungu, hahumwaga kung'hondo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Vugukeni mweye milango,","poem":1},{"lineBreak":true},{"text":"vugukeni mweye milango ya umwaka,","poem":1},{"lineBreak":true},{"text":"ili Mndewa yeli na udahi wose yengile.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nani ayo Mndewa yeli na udahi wose?","poem":1},{"lineBreak":true},{"text":"Ayo Mndewa Imulungu, Imulungu wa ukulu,","poem":1},{"lineBreak":true},{"text":"heyo ayo Mndewa Imulungu yeli na udahi wose.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}