{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":25,"content":[{"type":"heading","content":["ZABULI YA 25"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Mndewa Imulungu, kumwako noika loho yangu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu, kumwako notamanila,","poem":1},{"lineBreak":true},{"text":"sikuunhende nyone kinyala,","poem":1},{"lineBreak":true},{"text":"sikuuwatende awo onihila waniseke nahahumwa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sikuumuleke imunhu yokutamanila yakone kinyala,","poem":1},{"lineBreak":true},{"text":"ila wagwe kinyala wose okulema gweye giladi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Unongele nzila zako, gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"unifunze ago goulonda.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Unilongoze mna ikweli yako na unifunze,","poem":1},{"lineBreak":true},{"text":"kwavija gweye ayo Imulungu mkombola wangu,","poem":1},{"lineBreak":true},{"text":"nokutamanila gweye kila siku.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kumbuka bazi jako gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kumbuka unogelo wako hawishaga,","poem":1},{"lineBreak":true},{"text":"kwavija avo kunavo tangu mwaka.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sikuuzikumbuke nzambi na gehile ga ubwanga wangu,","poem":1},{"lineBreak":true},{"text":"unikumbuke kamba unogelo wako hawishaga viwili,","poem":1},{"lineBreak":true},{"text":"kwavija gweye Mndewa Imulungu kunoga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mndewa Imulungu kanoga na katelela,","poem":1},{"lineBreak":true},{"text":"avo kowafunza wene nzambi nzila zake.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kowalongoza wahole mzimbuli zinogile,","poem":1},{"lineBreak":true},{"text":"na kowafunza wahole nzila zake.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu, kotenda kwa unogelo wake hawishaga na kutamanilwa,","poem":1},{"lineBreak":true},{"text":"kwa awo ogoga lagano jake na amuli zake.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mbuli ya twaga jako, gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"ugele kumgongo nzambi yangu ino kwavija ng'hulu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kila munhu yomdumba Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu komulagusila nzila ya kubita.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Munhu kamba ayo komweda siku zose,","poem":1},{"lineBreak":true},{"text":"na ulelo wake oihazi isi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu mbwiga wa awo omdumba,","poem":1},{"lineBreak":true},{"text":"heyo kowakumbusa lagano jake.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Nomulola Mndewa Imulungu siku zose,","poem":1},{"lineBreak":true},{"text":"heyo koilava migulu yangu mumtego.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu, unilole na unyonele bazi,","poem":1},{"lineBreak":true},{"text":"kwavija niye namkiwa na nogaya.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Unisegesele magazo ga mmoyo wangu,","poem":1},{"lineBreak":true},{"text":"unisegese mmadununzo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ugalole magazo gangu na madununzo gangu,","poem":1},{"lineBreak":true},{"text":"uzigele kumgongo nzambi zangu zose.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Lola iwanhu onihila viwali wengi,","poem":1},{"lineBreak":true},{"text":"lola viwonihila kwa usede.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Uulole goya ugima wangu, unikombole nokukimbilila gweye,","poem":1},{"lineBreak":true},{"text":"nokimbilila ukalizi wako,","poem":1},{"lineBreak":true},{"text":"sikuutogole nigwe kinyala.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ganogile na haki vinikalize,","poem":1},{"lineBreak":true},{"text":"kwavija nokutamanila gweye.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Imulungu, uwakombole wanhu wako wa Izilaeli,","poem":1},{"lineBreak":true},{"text":"uwakombole kulawa mmagazo gao gose.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}