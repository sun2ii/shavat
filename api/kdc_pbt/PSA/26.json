{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"heading","content":["ZABULI YA 26"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Mndewa Imulungu, uwalihe,","poem":1},{"lineBreak":true},{"text":"kwavija nikala bila kitala,","poem":1},{"lineBreak":true},{"text":"nikutamanila gweye bila kunyawanyawa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Unigeze na kunipima gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"uulole moyo wangu na nzewele zangu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Unogelo wako hawishaga wa kuulongozi wa meso gangu,","poem":1},{"lineBreak":true},{"text":"nokala mbuli ya kukutamanila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Sikala na wanhu wavizi,","poem":1},{"lineBreak":true},{"text":"sikala na wanhu watapitapi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Noihila miting'hano ya iwanhu wehile,","poem":1},{"lineBreak":true},{"text":"na sikala na iwanhu wehile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Go Mndewa Imulungu, nonawa makono gangu kulagusa sitendile dihile,","poem":1},{"lineBreak":true},{"text":"nouzunguluka upango wako wa nhosa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nokwimba lwila lwa kukutogola gweye,","poem":1},{"lineBreak":true},{"text":"nosimulila sang'hano zako zose za unzonza.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mndewa Imulungu, nonogezwa na ng'anda yako aho houkala,","poem":1},{"lineBreak":true},{"text":"aho houkala ukulu wako.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sikuunibanange hamoja na wene nzambi,","poem":1},{"lineBreak":true},{"text":"na sikuunitupe hamoja na awo iwakomaji,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"iwanhu awo watendaga gehile siku zose,","poem":1},{"lineBreak":true},{"text":"iwanhu wamemile hongo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Lakini niye nokala kwa moyo unogile,","poem":1},{"lineBreak":true},{"text":"unyonele bazi na unikombole.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Niye nima wima hanhu helibule magazo,","poem":1},{"lineBreak":true},{"text":"nomtogola Mndewa Imulungu mumting'hano mkulu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}