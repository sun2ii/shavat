{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":27,"content":[{"type":"heading","content":["ZABULI YA 27"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Mndewa Imulungu ayo mulenge wangu,","poem":1},{"lineBreak":true},{"text":"na ukombola wangu,","poem":1},{"lineBreak":true},{"text":"niye nimdumbe nani?","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu ayo ngome ya ugima wangu,","poem":1},{"lineBreak":true},{"text":"simdumba munhu yoyose.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Wanhu wehile wahanivamila ili wanikome,","poem":1},{"lineBreak":true},{"text":"awo iwanhu onihila oikwala na kugwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hata wakalizi wahanizunguluka,","poem":1},{"lineBreak":true},{"text":"moyo wangu haudumba kinhu,","poem":1},{"lineBreak":true},{"text":"hata nahengila mna ing'hondo,","poem":1},{"lineBreak":true},{"text":"ning'hali nokutamanila gweye.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mbuli imoja nimpula Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"na mbuli ayo noilonda ng'hani,","poem":1},{"lineBreak":true},{"text":"nikale mng'anda ya Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"siku zose za ugima wangu,","poem":1},{"lineBreak":true},{"text":"nilole ukunoga kwa Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"na nizahile ulongozi wake mng'anda yake.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Siku ya magazo konifisa mkibanda chake,","poem":1},{"lineBreak":true},{"text":"konifisa mdihema jake,","poem":1},{"lineBreak":true},{"text":"na konika uchanha mdibwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Na niye kwa deng'ho nowalola iwanhu onihila onizunguluka.","poem":1},{"lineBreak":true},{"text":"Nomulavila nhosa kwa deng'ho mng'anda yake,","poem":1},{"lineBreak":true},{"text":"nomwimbila na kumdeng'helela Mndewa Imulungu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Utegeleze gweye Mndewa Imulungu, nokulilila,","poem":1},{"lineBreak":true},{"text":"unyonele bazi na unidike.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Moyo wangu onilongela, “Izo umkweleleze Imulungu!”","poem":1},{"lineBreak":true},{"text":"Avo nokwiza kumwako gweye Mndewa Imulungu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Sikuuleke kunilola kwa bazi.","poem":1},{"lineBreak":true},{"text":"Sikuundeme kwa ng'hasiliki yako niye msang'hanaji wako,","poem":1},{"lineBreak":true},{"text":"gweye ayo unitaza siku zose.","poem":1},{"lineBreak":true},{"text":"Sikuunitupe wala kundeka, Imulungu Mkombola wangu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hata kamba tatangu na mamangu wahanyasa,","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu konibokela kumwake.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Unifunze nzila zako gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"unilongoze mnzila igoloke,","poem":1},{"lineBreak":true},{"text":"mbuli ya iwanhu onihila.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sikuundeke iwanhu onihila wanitende viwolonda,","poem":1},{"lineBreak":true},{"text":"kwavija iwanhu osindila uvizi wanikweleleza,","poem":1},{"lineBreak":true},{"text":"na hewo onikomhokela kwa usede.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nojuwa nogona ganogile ga Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"mna ikae ya iwanhu wagima.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mtamanile Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"wamba, ufunye umoyo,","poem":1},{"lineBreak":true},{"text":"mbete Mndewa Imulungu!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}