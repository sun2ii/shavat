{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":28,"content":[{"type":"heading","content":["ZABULI YA 28"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Nokulilila gweye Mndewa Imulungu!","poem":1},{"lineBreak":true},{"text":"Gweye dibwe da ugima wangu,","poem":1},{"lineBreak":true},{"text":"sikuuwe kamba mvugu kumwangu.","poem":1},{"lineBreak":true},{"text":"Kamba hunitegeleza,","poem":1},{"lineBreak":true},{"text":"nokuwa kamba iwanhu ochola kudisimo da kuzimu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Utegeleze kililo changu,","poem":1},{"lineBreak":true},{"text":"unyonele bazi nahakukema unitaze,","poem":1},{"lineBreak":true},{"text":"nahenula makono gangu ako kuing'anda yako ing'ala.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sikuunitupe hamoja na iwanhu wehile,","poem":1},{"lineBreak":true},{"text":"hamoja na iwanhu otenda gehile.","poem":1},{"lineBreak":true},{"text":"Iwanhu awo olonga na wayao mbuli zinogile,","poem":1},{"lineBreak":true},{"text":"kumbe wamema gehile mmizoyo yao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Walihe kamba viwasang'hane na kamba viwatendile gehile,","poem":1},{"lineBreak":true},{"text":"wagwelele kamba sang'hano ya makono gao viili,","poem":1},{"lineBreak":true},{"text":"uwalihe gaja golondigwa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hewo hawaigelegeza isang'hano ya Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"hebu sang'hano ya makono gake,","poem":1},{"lineBreak":true},{"text":"kwa mbuli ayo kowabomola,","poem":1},{"lineBreak":true},{"text":"na hawazenga kabili.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yatogolwe Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kwavija kahulika kupula kwangu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu ayo nguvu zangu na ngao yangu,","poem":1},{"lineBreak":true},{"text":"niye nomtamanila heyo.","poem":1},{"lineBreak":true},{"text":"Heyo kanitaza na niye nodeng'helela kwa moyo wangu,","poem":1},{"lineBreak":true},{"text":"kwa lwila lwangu nomshukulu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mndewa Imulungu ayo nguvu ya wanhu zake,","poem":1},{"lineBreak":true},{"text":"heyo ayo yokimbililwa na mndewa iyamsagule.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Imulungu uwakombole wanhu zako,","poem":1},{"lineBreak":true},{"text":"uwatende wamwede iwanhu awo weli wako.","poem":1},{"lineBreak":true},{"text":"Uwasusile na kuwataza milele.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}