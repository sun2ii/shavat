u ibanza ukulu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Sauti ya Mndewa Imulungu yobena mielezi,","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu kobena bena mielezi ya Lebanoni.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kovitigisa vigongo va Lebanoni kamba mibiki viitigiswa na beho,","poem":1},{"lineBreak":true},{"text":"vigongo va Silioni kamba misanze.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sauti ya Mndewa Imulungu yolava lumwesa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sauti ya Mndewa Imulungu yotigisa luwala,","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu kotigisa luwala lwa Kadeshi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Sauti ya Mndewa Imulungu yotigisa mibiki mikulu,","poem":1},{"lineBreak":true},{"text":"na yokwanyula mibiki kumuhulo,","poem":1},{"lineBreak":true},{"text":"na mng'anda yake wose olonga,","poem":1},{"lineBreak":true},{"text":"“Ukulu kwa Imulungu!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mndewa Imulungu kotawala masika makulu,","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu kotawala kamba Mndewa milele.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu yawagwee wanhu zake nguvu!","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu yawatendele wanhu zake ganogile na yawagwee tindiwalo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}