{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"heading","content":["ZABULI YA 3"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi mbuli ya kipindi viyamkimbile imwana Abisalomu.)",{"noteId":0}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Go Mndewa Imulungu, iwanhu onihila wengi ng'hani,","poem":1},{"lineBreak":true},{"text":"wanhu wengi ondema.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wengi onongela, “Haduhu ukombola kumwake kulawa kwa Imulungu.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Lakini gweye Mndewa Imulungu kwa ngao yangu kila mwambu,","poem":1},{"lineBreak":true},{"text":"kwa ukulu wangu, na konigangamiza.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nimulilila Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"na heyo kanidika kulawa kulugongo lwake lung'ala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nitambalala na kuwasa,","poem":1},{"lineBreak":true},{"text":"nilamuka kabili kwavija Mndewa Imulungu kanidahiza.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Siwadumba iwanhu maelufu kwa maelufu onihila wanizunguluke kila mwambu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Go Mndewa Imulungu, winuke!","poem":1},{"lineBreak":true},{"text":"Nihonye gweye Imulungu wangu!","poem":1},{"lineBreak":true},{"text":"Gweye kowabena zisaya iwanhu wose onihila,","poem":1},{"lineBreak":true},{"text":"kowabena imizino iwanhu wehile.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ukombola olawa kwa Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"ukumweda kwako kukale kwa iwanhu wako.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Lola kitabu cha 2 Samweli 15-17.","reference":{"chapter":3,"verse":0}}]},"thisChapterLink":"/api/kdc_pbt/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}