{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":30,"content":[{"type":"heading","content":["ZABULI YA 30"]},{"type":"hebrew_subtitle","content":["(Zabuli ya kuipulila ng'anda ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Gweye Mndewa Imulungu nokutogola,","poem":1},{"lineBreak":true},{"text":"kwavija kunikombola,","poem":1},{"lineBreak":true},{"text":"huwalekile iwanhu onihila waniseke.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gweye Mndewa Imulungu, Imulungu wangu,","poem":1},{"lineBreak":true},{"text":"nikulilila unitaze,","poem":1},{"lineBreak":true},{"text":"na gweye kunihonya.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu, kunikombola kulawa kuzimu,","poem":1},{"lineBreak":true},{"text":"kunigwaa kabili ugima,","poem":1},{"lineBreak":true},{"text":"kunisegesa mna iwanhu ochola kuzimu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mwimbileni nhogolwa Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"mweye mutamanila,","poem":1},{"lineBreak":true},{"text":"kumbukeni ukung'ala kwake na kumshukulu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ng'hasiliki yake yokala kwa siku ndodo,","poem":1},{"lineBreak":true},{"text":"kunoga kwake kumwetu kokala siku zose.","poem":1},{"lineBreak":true},{"text":"Kililo chodaha kukala kilo chose,","poem":1},{"lineBreak":true},{"text":"lakini imitondo modeng'ha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Niye vinimwedile nilonga,","poem":1},{"lineBreak":true},{"text":"“Sidaha ng'o kuhumwa!”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kwa ganogile gako gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kunigangamiza kamba kigongo kikulu.","poem":1},{"lineBreak":true},{"text":"Lakini vuifisile kutali na niye,","poem":1},{"lineBreak":true},{"text":"na niye nigwaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nikulilila gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"nikupula gweye Mndewa unitaze.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"“Kopata choni nahafa na kuchola kuzimu?","poem":1},{"lineBreak":true},{"text":"Vino timbwisi da iwanhu wafile dodaha kukugwaa nhogolwa?","poem":1},{"lineBreak":true},{"text":"Vino dodaha kusimulila kutamanila kwako?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Utegeleze gweye Mndewa Imulungu, na unyonele bazi,","poem":1},{"lineBreak":true},{"text":"gweye Mndewa Imulungu, unitaze!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Gweye kuhindula kuiyalala kwangu kamba ngoma ya deng'ho.","poem":1},{"lineBreak":true},{"text":"Kunisegesela giogio jangu,","poem":1},{"lineBreak":true},{"text":"kunizungulusila deng'ho.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Niye nokutogola na sinyamala bule.","poem":1},{"lineBreak":true},{"text":"Gweye Mndewa Imulungu, Imulungu wangu nokushukulu milele.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}