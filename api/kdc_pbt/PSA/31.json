{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":31,"content":[{"type":"heading","content":["ZABULI YA 31"]},{"type":"hebrew_subtitle","content":["(Kwa kilanja, Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Kumwako gweye Mndewa Imulungu, nokimbilila,","poem":1},{"lineBreak":true},{"text":"sikuundeke ng'o nigwe kinyala,","poem":1},{"lineBreak":true},{"text":"kwa haki yako unikombole.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Unihulike na unikombole sambi baha,","poem":1},{"lineBreak":true},{"text":"uwe kumwangu kamba dibwe da kukimbilila,","poem":1},{"lineBreak":true},{"text":"ngome ya kunikombola.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kwavija gweye ayo dibwe jangu na ngome yangu.","poem":1},{"lineBreak":true},{"text":"Mbuli ya twaga jako unilongoze na undole goya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kunilava mna ulwavu wanitegele,","poem":1},{"lineBreak":true},{"text":"kwavija gweye ayo kimbililo da ugima wangu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mmakono gako noika loho yangu,","poem":1},{"lineBreak":true},{"text":"kunikombola, gweye Mndewa Imulungu, Imulungu utamaniligwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Niye nowehila iwanhu otambikila vinyago,","poem":1},{"lineBreak":true},{"text":"lakini niye nokutamanila gweye Mndewa Imulungu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nodeng'helela na kusekelela unogelo wako hawishaga,","poem":1},{"lineBreak":true},{"text":"kwavija gweye konyona vinigaya,","poem":1},{"lineBreak":true},{"text":"kojuwa magazo ga moyo wangu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gweye hunilekile nigeligwe mmakono ga iwanhu onihila,","poem":1},{"lineBreak":true},{"text":"kunimiza hanhu hana inyafasi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Go Mndewa Imulungu, unyonele bazi,","poem":1},{"lineBreak":true},{"text":"niye nogaya na meso gangu gadonha kwa kugaya,","poem":1},{"lineBreak":true},{"text":"nabule nguvu mulukuli lwangu na mna iloho.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ugima wangu udonha kwa lusikisiki,","poem":1},{"lineBreak":true},{"text":"ayo imiyaka yangu kwa kuiyalala.","poem":1},{"lineBreak":true},{"text":"Nabule nguvu mbuli ya kugaya,","poem":1},{"lineBreak":true},{"text":"hata mizege yangu inyala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Iwanhu onihila onibezeli,","poem":1},{"lineBreak":true},{"text":"sambi nosekigwa na iwanhu weli behi na niye.","poem":1},{"lineBreak":true},{"text":"Mbwiga zangu onyona kamba kilozo,","poem":1},{"lineBreak":true},{"text":"wahanyona mnzila onikimbila.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nisemwigwa kamba munhu yadanganike,","poem":1},{"lineBreak":true},{"text":"niye kamba nongo ibeneke beneke.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nohulika wanhu wengi oinyong'onyela,","poem":1},{"lineBreak":true},{"text":"vinhu avo vogala bwembwe kila mwambu,","poem":1},{"lineBreak":true},{"text":"oisasala mbuli yangu, olonda kunikoma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Lakini niye nokutamanila gweye, Mndewa Imulungu.","poem":1},{"lineBreak":true},{"text":"Nolonga, “Gweye kwa Imulungu wangu!”","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ugima wangu wammakono gako,","poem":1},{"lineBreak":true},{"text":"unikombole na iwanhu onihila,","poem":1},{"lineBreak":true},{"text":"unikombole na iwanhu onidununza.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Unimwemwesele kihanga chako niye msang'hanaji wako,","poem":1},{"lineBreak":true},{"text":"unikombole kwa unogelo wako hawishaga.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Sikuundeke nigwe kinyala gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kwavija niye nokupula,","poem":1},{"lineBreak":true},{"text":"lakini waleke iwanhu wehile wagwe kinyala,","poem":1},{"lineBreak":true},{"text":"waleke wapotele tulu tulu ako kuzimu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ifunge imilomo ya iwanhu awo iwavizi,","poem":1},{"lineBreak":true},{"text":"wanhu awo oitapa na kubezeli,","poem":1},{"lineBreak":true},{"text":"awo owabezeli iwanhu wanogile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Lola unogelo wako viwili mkulu,","poem":1},{"lineBreak":true},{"text":"kuwekila iwanhu okudumba gweye,","poem":1},{"lineBreak":true},{"text":"kutenda avo mbuli ya wose okukimbilila gweye,","poem":1},{"lineBreak":true},{"text":"mgameso ga iwanhu wose.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kowafisa hanhu hanogile aho houkala,","poem":1},{"lineBreak":true},{"text":"kutali na magesa gehile ga iwanhu,","poem":1},{"lineBreak":true},{"text":"kowakaliza goya mdihema jako,","poem":1},{"lineBreak":true},{"text":"kutali na gehile golawa mmilomo ya wanhu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Yatogolwe Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kwavija kanilagusila unogelo wake hawishaga viwili wa unzonza,","poem":1},{"lineBreak":true},{"text":"viwanizunguluke kamba buga divamilwe.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Na niye nilonga kwa bwembwe jangu,","poem":1},{"lineBreak":true},{"text":"“Nitupigwa kutali na meso gako.”","poem":1},{"lineBreak":true},{"text":"Lakini kuihulika sauti ya kupula kwangu,","poem":1},{"lineBreak":true},{"text":"vinikupulile unyonele bazi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Mnogeleni Mndewa Imulungu, mweye iwanhu zake wose.","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu kowalola goya iwanhu omtamanila,","poem":1},{"lineBreak":true},{"text":"lakini kowakoboza kamba viilondigwa iwanhu oigoda.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Mugangamale na mufunge umoyo,","poem":1},{"lineBreak":true},{"text":"mweye mose mumbeta Mndewa Imulungu!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}