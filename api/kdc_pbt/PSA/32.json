{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":32,"content":[{"type":"heading","content":["ZABULI YA 32"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi. Kufunza.)"]},{"type":"verse","number":1,"content":[{"text":"Kamweda imunhu nzambi zake zigeligwa kumgongo,","poem":1},{"lineBreak":true},{"text":"imunhu nzambi zake zisegesigwa kabisa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kamweda imunhu Mndewa Imulungu hagelegeza gehile gake,","poem":1},{"lineBreak":true},{"text":"imunhu yelibule uvizi mmoyo wake.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Vinikalile sinatogola kamba nhenda nzambi,","poem":1},{"lineBreak":true},{"text":"nikala nidonhile kwa kulila imisi yose.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Imisi na ikilo mkono wake undemela,","poem":1},{"lineBreak":true},{"text":"nguvu zangu zifonzigwa,","poem":1},{"lineBreak":true},{"text":"kamba mazi kipindi cha zuwa kali.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Abaho nizitambula nzambi zangu kumwako,","poem":1},{"lineBreak":true},{"text":"na sigafisile gehile gangu.","poem":1},{"lineBreak":true},{"text":"Nilonga, “Nozitogola nzambi zangu kumwako gweye Mndewa Imulungu.”","poem":1},{"lineBreak":true},{"text":"Abaho gweye kuzigela kumgongo nzambi zangu zose.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Avo, kila imunhu yotamanilwa yakupule gweye,","poem":1},{"lineBreak":true},{"text":"mkipindi cha magazo,","poem":1},{"lineBreak":true},{"text":"mazi ga masika gahenuka,","poem":1},{"lineBreak":true},{"text":"hagamkulula heyo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gweye ayo hanhu hangu ha kuifisila,","poem":1},{"lineBreak":true},{"text":"gweye konikaliza mmagazo.","poem":1},{"lineBreak":true},{"text":"Kunigubika kwa nyila za ukombola.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Imulungu kolonga,","poem":1},{"lineBreak":true},{"text":"“Nokufunza na kukulagusila nzila yuulondigwa kubita,","poem":1},{"lineBreak":true},{"text":"nokuzuma na siso jangu dokulola gweye.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sikuuwe mbozi kamba falasi hebu kihongwe,","poem":1},{"lineBreak":true},{"text":"awo walemaga kukukwesela gweye,","poem":1},{"lineBreak":true},{"text":"mbaka wakwegigwe kwa nzabi.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Iwanhu wehile opata magazo mengi,","poem":1},{"lineBreak":true},{"text":"lakini iwanhu omtamanila Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"ozungulukwa na unogelo wake hawishaga.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mdeng'heleleni Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"deng'heleleni mweye iwanhu wanogile,","poem":1},{"lineBreak":true},{"text":"toweni ng'henze za deng'ho,","poem":1},{"lineBreak":true},{"text":"mweye iwanhu muli na mizoyo inogile.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}