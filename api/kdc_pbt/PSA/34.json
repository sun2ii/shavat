{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":34,"content":[{"type":"heading","content":["ZABULI YA 34"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi mbuli ya kipindi viyaitendile kana lukwale kuulongozi wa Abimeleki, abaho kawingigwa.)",{"noteId":2}]},{"type":"verse","number":1,"content":[{"text":"Go Mndewa Imulungu, nokutogola siku zose,","poem":1},{"lineBreak":true},{"text":"nhogolwa zako zokala mmulomo wangu siku zose.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Niye nodeng'helela mbuli ya Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"wakiwa wahulike na kudeng'helela.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mtogoleni Mndewa Imulungu hamoja na niye,","poem":1},{"lineBreak":true},{"text":"wose hamoja tuditogole twaga jake.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nimpula Mndewa Imulungu na heyo kanidika,","poem":1},{"lineBreak":true},{"text":"na kanisegesela kudumba kwangu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wanhu omuhindukila Imulungu odeng'helela,","poem":1},{"lineBreak":true},{"text":"na vihanga vao vabule kinyala.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mkiwa kamulilila Mndewa Imulungu na heyo kamuhulika,","poem":1},{"lineBreak":true},{"text":"na kamkombola na magazo gake gose.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Msenga wa Mndewa Imulungu kowakaliza iwanhu wose omdumba Imulungu,","poem":1},{"lineBreak":true},{"text":"na kowakombola mmagazo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gezeni mulole Mndewa Imulungu viyanogile.","poem":1},{"lineBreak":true},{"text":"Kamweda imunhu yomkimbilila heyo ili yakale goya.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mdumbeni Mndewa Imulungu mweye iwanhu zake wang'alile,","poem":1},{"lineBreak":true},{"text":"kwavija iwanhu omdumba heyo hawaswela kinhu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wana simba oswela kinhu na okona nzala,","poem":1},{"lineBreak":true},{"text":"lakini iwanhu omkweleleza Mndewa Imulungu hawaswela kinhu chochose kinogile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Izoni mweye iwana munitegeleze,","poem":1},{"lineBreak":true},{"text":"na niye nowafunza kumdumba Mndewa Imulungu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Vino kolonda kudeng'helela ugima,","poem":1},{"lineBreak":true},{"text":"na kukala miyaka mingi na kudeng'helela ganogile?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Avo, leka kulonga gehile,","poem":1},{"lineBreak":true},{"text":"na leka kulonga uvizi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Leka gehile, utende ganogile,","poem":1},{"lineBreak":true},{"text":"uzahile tindiwalo na udigoge.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mndewa Imulungu kowalola iwanhu wanogile,","poem":1},{"lineBreak":true},{"text":"na kotegeleza kililo chao,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"lakini kowalema iwanhu otenda gehile,","poem":1},{"lineBreak":true},{"text":"kofuta matwaga gao mwiisi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Iwanhu wanogile wahamulilila Mndewa Imulungu, heyo kowategeleza,","poem":1},{"lineBreak":true},{"text":"na kowakombola kulawa mmagazo gao gose.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu kabehi na iwanhu wali na lusikisiki,","poem":1},{"lineBreak":true},{"text":"kowakombola wose wahondigwe mmizoyo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Magazo ga imunhu yanogile mengi,","poem":1},{"lineBreak":true},{"text":"lakini Mndewa Imulungu komsegesela gose.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kolukaliza lukuli lwake lose,","poem":1},{"lineBreak":true},{"text":"haduhu hata zege jake donda dibenigwe.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Gehile gomkoma imunhu yotenda gehile,","poem":1},{"lineBreak":true},{"text":"iwanhu omwihila mwene haki otagusigwa.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu kouhonya ugima wa wasang'hanaji wake,","poem":1},{"lineBreak":true},{"text":"wose omkimbilila hawatagusigwa.","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"Lola kitabu cha 1 Samweli 21:10-22:1.","reference":{"chapter":34,"verse":0}}]},"thisChapterLink":"/api/kdc_pbt/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}