{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":35,"content":[{"type":"heading","content":["ZABULI YA 35"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Go Mndewa Imulungu, uwaleme iwanhu onilema niye,","poem":1},{"lineBreak":true},{"text":"uwatowe iwanhu onitowa niye.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Usole ngao yako na kikimilo chako,","poem":1},{"lineBreak":true},{"text":"winuke wize unitaze.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ulave mgoha wako na sime jako uwakimile awo onikweleleza,","poem":1},{"lineBreak":true},{"text":"ilongele loho yangu kamba konikombola.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Waleke wagwe kinyala na wabezigwe,","poem":1},{"lineBreak":true},{"text":"awo okweleleza ugima wangu.","poem":1},{"lineBreak":true},{"text":"Wabwele kuchugu kwa kinyala,","poem":1},{"lineBreak":true},{"text":"awo ogelegeza gehile kumwangu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Waleke wawe kamba mipepe ihembelusigwa na beho,","poem":1},{"lineBreak":true},{"text":"na imsenga wa Mndewa Imulungu yawawinge!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Leka nzila zao ziwe na ziza na kutelebuka,","poem":1},{"lineBreak":true},{"text":"na msenga wa Mndewa Imulungu yawakweleleze.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sitendile dihile ila wanitegela lwavu,","poem":1},{"lineBreak":true},{"text":"sitendile dihile ila wanihimbila simo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Leka gehile gampate kwa kusinhukiza.","poem":1},{"lineBreak":true},{"text":"Leka ulwavu luyategile lumgoge heyo mwenyego,","poem":1},{"lineBreak":true},{"text":"leka yagwile mumo na yafe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Abaho loho yangu yomdeng'helela Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"koninula muukombola wake.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mizege yangu yose yolonga,","poem":1},{"lineBreak":true},{"text":"“Go Mndewa Imulungu, nani kamba gweye?","poem":1},{"lineBreak":true},{"text":"Komkombola mkiwa kulawa kwa ayo yeli na nguvu,","poem":1},{"lineBreak":true},{"text":"komkombola mkiwa na ngaengae kulawa wa ayo yomwibila.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Wasindila wa gehile okwima,","poem":1},{"lineBreak":true},{"text":"oniuza mbuli sizijuwile.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Oniliha gehile hanhu ha ganogile,","poem":1},{"lineBreak":true},{"text":"hata loho yangu ina lusikisiki.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Lakini viwakugule hewo, niye nivala magunia kulagusa kuiyalala,","poem":1},{"lineBreak":true},{"text":"niye nifunga kuja, nipula akuno niidulika pala jangu,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"nhenda avo kamba mbwigangu hebu ndugu yangu.","poem":1},{"lineBreak":true},{"text":"Niidulika pala jangu kwa lusikisiki,","poem":1},{"lineBreak":true},{"text":"kamba munhu yomuyalalila mamake.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Lakini niye vinigwile waiting'hana kunilonga.","poem":1},{"lineBreak":true},{"text":"Waiting'hana kunivamila,","poem":1},{"lineBreak":true},{"text":"wanhu siwajuwile wanivamila bila kuleka,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"bila hishima wanibezeli,","poem":1},{"lineBreak":true},{"text":"na wanidafunila meno gao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mbaka lini gweye Mndewa kolola tu?","poem":1},{"lineBreak":true},{"text":"Unikombole kulawa mmagazo,","poem":1},{"lineBreak":true},{"text":"ukombole ugima wangu unogile,","poem":1},{"lineBreak":true},{"text":"kulawa kwa iwanhu onivamila kamba simba.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nokushukulu mna umting'hano mkulu,","poem":1},{"lineBreak":true},{"text":"mna ikibumbila cha wanhu nokutogola.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Sikuuwaleke iwanhu onihila ng'hani wanilonge vihile,","poem":1},{"lineBreak":true},{"text":"awo onihila bila kilamuso wadeng'helele vinigaya.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kwavija hawalonga tindiwalo,","poem":1},{"lineBreak":true},{"text":"ila olonga gehile kwa awo iwahole mwiisi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Na hewo ogubula milomo yao onilonga vihile,","poem":1},{"lineBreak":true},{"text":"olonga, “Amweye! Amweye! Meso getu gona.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Kona mwenyego gweye Mndewa Imulungu, sikuunyamale!","poem":1},{"lineBreak":true},{"text":"Sikuuwe kutali na niye!","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Lamuka, ukale meso ili utaguse mbuli ya ayo onihila,","poem":1},{"lineBreak":true},{"text":"Imulungu wangu na Mndewa wangu.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Unitaguse kwa haki yako,","poem":1},{"lineBreak":true},{"text":"gweye Mndewa Imulungu, Imulungu wangu,","poem":1},{"lineBreak":true},{"text":"na sikuuwaleke wanilonge.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Sikuwalonge mmizoyo yao,","poem":1},{"lineBreak":true},{"text":"Ona, vivo vitulonda,","poem":1},{"lineBreak":true},{"text":"sambi walonge “Tummeza.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Wagwe kinyala, waumbuke hamoja,","poem":1},{"lineBreak":true},{"text":"awo odeng'helela mbuli zangu vizichola vihile.","poem":1},{"lineBreak":true},{"text":"Wagwe kinyala na kugaya awo oikweza kumwangu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Iwanhu odeng'helela haki yangu,","poem":1},{"lineBreak":true},{"text":"walonge, “Mndewa Imulungu mkulu,","poem":1},{"lineBreak":true},{"text":"konogezwa na ukumweda kwa msang'hanaji wake.”","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Lulimi lwangu lolonga haki yako,","poem":1},{"lineBreak":true},{"text":"na lolonga nhogolwa zako siku zose.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}