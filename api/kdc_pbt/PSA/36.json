{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":36,"content":[{"type":"heading","content":["ZABULI YA 36"]},{"type":"hebrew_subtitle","content":["(Kwa kilanja, Zabuli ya Daudi msang'hanaji wa Mndewa Imulungu.)"]},{"type":"verse","number":1,"content":[{"text":"Nzambi yolonga na imunhu yehile,","poem":1},{"lineBreak":true},{"text":"mgati mmoyo wake,","poem":1},{"lineBreak":true},{"text":"haduhu kumdumba Imulungu mgameso gake.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Imunhu yehile koinogela mwenyego,","poem":1},{"lineBreak":true},{"text":"na kogelegeza kamba gehile gake hagajuwigwa na kuduwiligwa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mbuli za mulomo wake ziha na za uvizi,","poem":1},{"lineBreak":true},{"text":"kaleka kugelegeza goya na kutenda ganogile.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kogelegeza gehile mulusazi lwake,","poem":1},{"lineBreak":true},{"text":"koika mwenyego mnzila hainogile, hagalema gehile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Unogelo wako hawishaga gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"uvika mbaka kuulanga,","poem":1},{"lineBreak":true},{"text":"kotamanilwa mbaka mmawingu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Haki yako kamba lugongo lwa Imulungu,","poem":1},{"lineBreak":true},{"text":"nhaguso yako kamba kidibo,","poem":1},{"lineBreak":true},{"text":"kowakaliza iwanhu na iwanyama,","poem":1},{"lineBreak":true},{"text":"gweye Mndewa Imulungu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Unogelo wako hawishaga gweye Mndewa Imulungu, unoga ng'hani!","poem":1},{"lineBreak":true},{"text":"Wana wa iwanhu okimbilila sisila da mabawa gako.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Okwiguta ukunona kwa ivinhu va mng'anda yako,","poem":1},{"lineBreak":true},{"text":"na kowagwaa king'waji kulawa kuulwanda lwa ganogile gako.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kumwako gweye kuna nzasa ya ugima,","poem":1},{"lineBreak":true},{"text":"kudilenge jako tokona mulenge.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Gendeleza unogelo wako hawishaga kwa awo okujuwa gweye,","poem":1},{"lineBreak":true},{"text":"na haki yako kwa awo wene mizoyo inogile.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sikuutogole wanhu oitapa wanivamile,","poem":1},{"lineBreak":true},{"text":"hebu iwanhu wehile wanikimbize.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Iwanhu otenda gehile wa hasi,","poem":1},{"lineBreak":true},{"text":"wakandamizwa na hawadaha kwinuka.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}