{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":37,"content":[{"type":"heading","content":["ZABULI YA 37"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Sikuuigaze mbuli ya iwanhu otenda gehile,","poem":1},{"lineBreak":true},{"text":"sikuuwonele migongo iwanhu wehile.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kwavija onyala himahima kamba mijani,","poem":1},{"lineBreak":true},{"text":"na ofa kamba minoga mibisi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mtamanile Mndewa Imulungu, na utende ganogile,","poem":1},{"lineBreak":true},{"text":"ukale mwiisi na udeng'helele goya ganogile.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Zahila deng'ho jako kwa Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"na heyo kokugwaa gaja gousulukila mmoyo wako.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mgwelele Mndewa Imulungu nzila zako,","poem":1},{"lineBreak":true},{"text":"mtamanile heyo, na heyo kokutendela vino.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Koilava kunze haki yako kamba mulenge,","poem":1},{"lineBreak":true},{"text":"na haki ya kitala chako kamba zuwa da imisi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ukale tuluu kuulongozi wa Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"na umbete kwa kufunga umoyo,","poem":1},{"lineBreak":true},{"text":"sikuuigaze mbuli ya imunhu yomweda mnzila yake,","poem":1},{"lineBreak":true},{"text":"na imunhu yogelegeza gehile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Sikuugevuzike na uleke ludoko,","poem":1},{"lineBreak":true},{"text":"sikuugevuzike buleavo kotenda gehile.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kwavija iwanhu otenda gehile okanhigwa,","poem":1},{"lineBreak":true},{"text":"lakini iwanhu ombeta Mndewa Imulungu oihazi isi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kwavija kisigala kipindi kidodo iwanhu wehile olawanya,","poem":1},{"lineBreak":true},{"text":"kowazahila kuwakalile lakini okuwa kuduhu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lakini iwanhu wahole oihazi isi,","poem":1},{"lineBreak":true},{"text":"na odeng'helela mna iditindiwalo kulu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Imunhu yehile kogelegeza mbuli ya imunhu mwene haki,","poem":1},{"lineBreak":true},{"text":"na kodafuna meno gake mbuli yake,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"lakini Mndewa komseka,","poem":1},{"lineBreak":true},{"text":"kwavija kolola kamba siku yake yokwiza.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Iwanhu wehile osomola sime na upinde wao,","poem":1},{"lineBreak":true},{"text":"ili wamkome mkiwa na ngaengae,","poem":1},{"lineBreak":true},{"text":"na wawachinje iwanhu otenda ganogile.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Lakini misime yao ingile mmizoyo yao wenyego,","poem":1},{"lineBreak":true},{"text":"na pinde zao zibeneke.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kidodo kiyelinacho mwene haki kinoga,","poem":1},{"lineBreak":true},{"text":"kubanza ivingi viwelinavo iwanhu wehile.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kwavija nguvu za iwanhu wehile zobenigwa,","poem":1},{"lineBreak":true},{"text":"lakini Mndewa Imulungu komgoga mwene haki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Mndewa Imulungu koukaliza ugima wa iwanhu wanogile,","poem":1},{"lineBreak":true},{"text":"na uhazi wao okala milele,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"zahavika siku zihile hawagwa kinyala,","poem":1},{"lineBreak":true},{"text":"mna zisiku za nzala okuwa na vingi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Lakini iwanhu wehile opotela,","poem":1},{"lineBreak":true},{"text":"awo omwihila Mndewa Imulungu onyala kamba maluwa,","poem":1},{"lineBreak":true},{"text":"na osegela kamba yosi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Iwanhu wehile okopa lakini hawabweza,","poem":1},{"lineBreak":true},{"text":"lakini wene haki olava kwa moyo unogile.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Kwavija awo otambikilwa na Mndewa Imulungu oihazi isi,","poem":1},{"lineBreak":true},{"text":"lakini awo waduwiligwe okanhigwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Kamba Mndewa Imulungu yahanogezwa na nzila ya munhu,","poem":1},{"lineBreak":true},{"text":"kozikaliza ngayo zake.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Hamoja kogwa, hasigala hasi siku zose,","poem":1},{"lineBreak":true},{"text":"kwavija Mndewa Imulungu komtaza.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Nikala mbwanga, na sambi namvele,","poem":1},{"lineBreak":true},{"text":"lakini sinamona mwene haki kalekigwa,","poem":1},{"lineBreak":true},{"text":"hebu wanage opula ndiya.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Siku zose heyo kokopesha kwa moyo unogile,","poem":1},{"lineBreak":true},{"text":"wanage okuwa nhunza.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Leka gehile utende ganogile,","poem":1},{"lineBreak":true},{"text":"na gweye kokala milele.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Kwavija Mndewa Imulungu konogezwa na haki,","poem":1},{"lineBreak":true},{"text":"hawaleka iwanhu wake otamanilwa,","poem":1},{"lineBreak":true},{"text":"kowakaliza milele,","poem":1},{"lineBreak":true},{"text":"lakini iwana wa iwanhu wehile osegesigwa.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Iwanhu wanogile oihazi isi,","poem":1},{"lineBreak":true},{"text":"na okala mwiisi ayo milele.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Mulomo wa imunhu yanogile olonga mbuli za ubala,","poem":1},{"lineBreak":true},{"text":"na lulimi lwake lolonga mbuli za haki.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Malagizo ga Imulungu wake ga mmoyo wake,","poem":1},{"lineBreak":true},{"text":"magulu gake hagatelebuka.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Wanhu wehile waifisa kuwavamila wene haki,","poem":1},{"lineBreak":true},{"text":"olonda kuwakoma.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu hamgela imunhu yanogile mmakono ga iwanhu wehile,","poem":1},{"lineBreak":true},{"text":"na hamuleka yahumwe yahagaligwa mkitala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Mtamanile Mndewa Imulungu na ugoge nzila zake,","poem":1},{"lineBreak":true},{"text":"na heyo kokukuza uitawale isi,","poem":1},{"lineBreak":true},{"text":"na kowona iwanhu wehile vonda wabanangwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Nimona imunhu yehile msede,","poem":1},{"lineBreak":true},{"text":"kaikweza uchanha ya wose kamba mwelezi wa Lebanoni.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Lakini kalawanya hakoneke kabili,","poem":1},{"lineBreak":true},{"text":"hamoja nimzahila hakoneke kabili.","poem":1}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Muloleni imunhu yelibule kitala na imunhu yanogile,","poem":1},{"lineBreak":true},{"text":"kwavija imunhu yodinogela tindiwalo kana siku nyingi za kukala ako kumwande.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Lakini iwanhu wose otenda nzambi obanangwa,","poem":1},{"lineBreak":true},{"text":"ugima wa ako kumwande wa awo wehile okanhigwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Ukombola wa iwanhu wanogile olawa kwa Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"heyo ayo ngome yao mmagazo.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu kowataza na kowakombola,","poem":1},{"lineBreak":true},{"text":"kowakombola kulawa mmakono ga iwanhu wehile na kowalekesa,","poem":1},{"lineBreak":true},{"text":"kwavija hewo wamkimbilila heyo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}