{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":38,"content":[{"type":"heading","content":["ZABULI YA 38"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi. Kopula yakumbukigwe na Imulungu.)"]},{"type":"verse","number":1,"content":[{"text":"Go Mndewa Imulungu, sikuunizume kwa ng'hasiliki yako,","poem":1},{"lineBreak":true},{"text":"sikuunikoboze wahagevuzika.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Misale yako inihoma,","poem":1},{"lineBreak":true},{"text":"na mkono wako unizila niye kulawa uchanha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Haduhu hanhu haholile mulukuli lwangu,","poem":1},{"lineBreak":true},{"text":"kwavija gweye kugevuzika,","poem":1},{"lineBreak":true},{"text":"haduhu zege digangamale,","poem":1},{"lineBreak":true},{"text":"mbuli ya nzambi yangu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nzambi zangu zinigubika,","poem":1},{"lineBreak":true},{"text":"kamba zigo kulu dimulemelaga munhu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Milonda yangu yola na yonung'ha,","poem":1},{"lineBreak":true},{"text":"mbuli ya ubozi wangu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ninamizwa hasi na kuhumuluswa,","poem":1},{"lineBreak":true},{"text":"imisi yose nozunguluka kuno noiyalala.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kigudi changu kimema usungu,","poem":1},{"lineBreak":true},{"text":"haduhu ugima mulukuli lwangu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nonyolila na kuhondigwa,","poem":1},{"lineBreak":true},{"text":"nogutilila mbuli ya usungu uli mmoyo wangu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Go Mndewa, vose vinisulukila kuvijuwa,","poem":1},{"lineBreak":true},{"text":"kugutilila kwangu kokujuwa goya.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Moyo wangu odunda,","poem":1},{"lineBreak":true},{"text":"nguvu nabule, hata meso gangu gavulala.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mbwiga zangu na wayangu, okala kutali na niye mbuli ya utamu wangu,","poem":1},{"lineBreak":true},{"text":"iwanhu okala behi na niye okwima kutali.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Waja ozahila ugima wangu, otega mitego yao,","poem":1},{"lineBreak":true},{"text":"waja olonda niye nilumile onilonga vihile,","poem":1},{"lineBreak":true},{"text":"na ogelegeza gehile siku zose.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Niye na kamba mvugu, sihulika,","poem":1},{"lineBreak":true},{"text":"kamba imunhu bubui hodaha bule kulonga.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ona na kamba munhu hahulika, imunhu hedikaga mbuli bule.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Go Mndewa Imulungu, niye nokubeta gweye,","poem":1},{"lineBreak":true},{"text":"gweye kokwidika gweye Mndewa, Imulungu wangu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kwavija niye nilonga, “Sikuuwaleke wadeng'helele mbuli yangu,","poem":1},{"lineBreak":true},{"text":"na sambi waitape mbuli ya kugwa kwangu.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kwavija na mmabehi kugwa,","poem":1},{"lineBreak":true},{"text":"na usungu wangu onigaza siku zose.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nolonga gehile gangu,","poem":1},{"lineBreak":true},{"text":"nogazika kwa nzambi yangu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Iwanhu onihila wana nguvu,","poem":1},{"lineBreak":true},{"text":"iwanhu onihila bila mbuli yoyose wengi ng'hani.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Oniliha gehile kwa gaja ganogile ganitendile,","poem":1},{"lineBreak":true},{"text":"onilema nahatenda ganogile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Go Mndewa Imulungu, sikuundeke,","poem":1},{"lineBreak":true},{"text":"sikuukale kutali na niye, gweye Imulungu wangu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Go Mndewa, Mkombola wangu, wize hima unitaze.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}