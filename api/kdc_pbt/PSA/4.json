{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"heading","content":["ZABULI YA 4"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi. Kwa kilanja, yatumie nyuzi za bango.)"]},{"type":"verse","number":1,"content":[{"text":"Gweye Imulungu wa haki yangu,","poem":1},{"lineBreak":true},{"text":"unidike nahakupula.","poem":1},{"lineBreak":true},{"text":"Ving'halile mmagazo, gweye kunitaza.","poem":1},{"lineBreak":true},{"text":"Unyonele bazi na utegeleze kupula kwangu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Mweye iwanhu, mbaka lini ukulu wangu ogalamuka kinyala?","poem":1},{"lineBreak":true},{"text":"Mbaka lini monogelwa na ubozi na kulonga uvizi?”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lakini muvijuwe kamba Mndewa Imulungu, kaisagulila iwanhu wake otamanilwa,","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu kohulika nahamkema.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Gwaeni kwa bwembwe na sikumutende nzambi,","poem":1},{"lineBreak":true},{"text":"mkale mvisazi venu na mugelegeze mmizoyo yenu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Laveni nhosa zilondigwa,","poem":1},{"lineBreak":true},{"text":"na mumtamanile Mndewa Imulungu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wanhu wengi olonga, “Nani yonda yatulagusile ganogile?”","poem":1},{"lineBreak":true},{"text":"Gweye Mndewa Imulungu utumwemwesele mng'alo wa ikihanga chako.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gweye kuumemeza moyo wangu deng'ho kulu kubanza indiya na divai nyingi iwasengile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kwa tindiwalo notambalala na kuwasa utulo,","poem":1},{"lineBreak":true},{"text":"kwavija gweye wiiyeka Mndewa Imulungu konitenda nikale goya.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}