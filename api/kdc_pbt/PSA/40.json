{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":40,"content":[{"type":"heading","content":["ZABULI YA 40"]},{"type":"hebrew_subtitle","content":["(Kwa kilanja, Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Nimbeta Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"na heyo kaninamila na kategeleza kulila kwangu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kanilava kulawa mdisimo da kubanangigwa,","poem":1},{"lineBreak":true},{"text":"kulawa mmatope na utelevu,","poem":1},{"lineBreak":true},{"text":"kanimiza goya uchanha ya dibwe,","poem":1},{"lineBreak":true},{"text":"na kanigwaa hanhu hanogile ha kwima.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Keka lwila lwa sambi mmulomo wangu,","poem":1},{"lineBreak":true},{"text":"lwila lwa kumtogola Mndewa Imulungu wetu.","poem":1},{"lineBreak":true},{"text":"Wengi wone na wadumbe na wamtamanile Mndewa Imulungu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kamweda imunhu yomtamanila Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"yoleka kuwatamanila wene nyodo,","poem":1},{"lineBreak":true},{"text":"awo oukweleleza uvizi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Go Mndewa Imulungu, Imulungu wangu kutenda mbuli za unzonza.","poem":1},{"lineBreak":true},{"text":"Mbuli ziutwikile haduhu munhu yoyose kamba gweye,","poem":1},{"lineBreak":true},{"text":"maza nilongile na kugasimulila gahandemele.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Gweye hulonda nhosa na sadaka,","poem":1},{"lineBreak":true},{"text":"lakini kuvugula magwiti gangu,","poem":1},{"lineBreak":true},{"text":"nhosa za kusoma moto na nhosa za kusegesa nzambi huzilondile.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Abaho nilonga, “Lola niye niza,","poem":1},{"lineBreak":true},{"text":"nyandikigwa mna ikitabu cha malagizo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Go Mndewa Imulungu, nosulukila kutenda gaja goulonda,","poem":1},{"lineBreak":true},{"text":"malagizo gako gammoyo wangu.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Niwapetela iwanhu mbuli ya haki na ukombola wako mumting'hano mkulu,","poem":1},{"lineBreak":true},{"text":"sinyamale bule, go Mndewa Imulungu gweye kojuwa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sifisile haki yako mmoyo wangu,","poem":1},{"lineBreak":true},{"text":"nolonga mbuli ya kutamanilwa kwako na ukombola wako.","poem":1},{"lineBreak":true},{"text":"Sifisile unogelo wako hawishaga na kutamaniligwa kwako,","poem":1},{"lineBreak":true},{"text":"kuulongozi wa umting'hano wa iwanhu wengi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Go Mndewa Imulungu, sikuudikimilize bazi jako,","poem":1},{"lineBreak":true},{"text":"unogelo wako hawishaga na kweli yako siku zose vinikalize.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kwavija magazo hagapetigwa ganizunguluka,","poem":1},{"lineBreak":true},{"text":"nzambi zangu zinigoga mbaka sidaha kulola.","poem":1},{"lineBreak":true},{"text":"Ziwa nyingi kubanza mvili zili mdipala jangu,","poem":1},{"lineBreak":true},{"text":"na moyo osinduka mgati mmwangu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Go Mndewa Imulungu, utogole kunikombola,","poem":1},{"lineBreak":true},{"text":"go Mndewa Imulungu, wize himahima unitaze.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wose ozahila kuusegesa ugima wangu,","poem":1},{"lineBreak":true},{"text":"wagwe kinyala na kugazwa,","poem":1},{"lineBreak":true},{"text":"wose olonda niye nigaye,","poem":1},{"lineBreak":true},{"text":"wabwezigwe kuchugu kwa kinyala.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Waja okala onisimanga,","poem":1},{"lineBreak":true},{"text":"wagazwe mbuli ya kinyala chao.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Avo wose okuzahila,","poem":1},{"lineBreak":true},{"text":"wadeng'helele na kukemelela mbuli yako.","poem":1},{"lineBreak":true},{"text":"Waja oulonda ukombola wako,","poem":1},{"lineBreak":true},{"text":"walonge siku zose, “Mndewa Imulungu ayo Imkulu!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Lakini niye mkiwa na nolonda vinhu,","poem":1},{"lineBreak":true},{"text":"Mndewa yanigelegeze.","poem":1},{"lineBreak":true},{"text":"Gweye ayo mtazaji wangu na mkombola wangu,","poem":1},{"lineBreak":true},{"text":"go Imulungu, sikuukawe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}