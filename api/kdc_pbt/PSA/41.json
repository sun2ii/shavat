{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":41,"content":[{"type":"heading","content":["ZABULI YA 41"]},{"type":"hebrew_subtitle","content":["(Kwa kilanja, Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Kamweda imunhu yomkumbuka mkiwa,","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu komuhonya siku da magazo gake.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu komkaliza na kuwika goya ugima wake,","poem":1},{"lineBreak":true},{"text":"komtenda yamwede mwiisi,","poem":1},{"lineBreak":true},{"text":"na hamgela mmakono ga imunhu yomwihila.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu komgangamiza yahawasa mulusazi kokugula,","poem":1},{"lineBreak":true},{"text":"muutamu wake komuhonya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Niye nilonga, “Go Mndewa Imulungu, nyonela bazi,","poem":1},{"lineBreak":true},{"text":"nihonye kwavija niye nikutenda nzambi.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wanhu onihila ogelegeza,","poem":1},{"lineBreak":true},{"text":"“Kodanganika lini, twaga jake dipotele?”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kila munhu yokwiza kundola kolonga uvizi,","poem":1},{"lineBreak":true},{"text":"moyo wake okuba gehile,","poem":1},{"lineBreak":true},{"text":"abaho kosegela na kogabwililisa kila hanhu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Iwanhu wose onihila oinyong'onyela kunilema niye,","poem":1},{"lineBreak":true},{"text":"ogelegeza gehile,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"olonga, “Utamu wihile umgoga, heyo henuka kabili mulusazi.”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hata mbwigangu wa kisima,","poem":1},{"lineBreak":true},{"text":"heyo inimtamanila,","poem":1},{"lineBreak":true},{"text":"ayo yajaga ndiya yangu,","poem":1},{"lineBreak":true},{"text":"hata heyo kononga vihile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Lakini gweye, Mndewa Imulungu, unyonele bazi,","poem":1},{"lineBreak":true},{"text":"umhonye na niye nowabwezela gehile.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Avo nojuwa kamba konogezwa na niye,","poem":1},{"lineBreak":true},{"text":"kwavija imunhu yonihila honda yanihume.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mna ukunoga kwangu kunigangamiza,","poem":1},{"lineBreak":true},{"text":"leka nikale kuulongozi wako milele.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yatogolwe Mndewa Imulungu, Imulungu wa Izilaeli,","poem":1},{"lineBreak":true},{"text":"kulawa milele mbaka milele.","poem":1},{"lineBreak":true},{"text":"Ona.","poem":1},{"lineBreak":true},{"text":"Ona.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}