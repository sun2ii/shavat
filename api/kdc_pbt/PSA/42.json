{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":42,"content":[{"type":"heading","content":["ZABULI YA 42"]},{"type":"hebrew_subtitle","content":["(Kwa kilanja, Lwila lwa ulelo wa Kola.)"]},{"type":"verse","number":1,"content":[{"text":"Kamba mhala viyogasulukila mazi ga ulwanda,","poem":1},{"lineBreak":true},{"text":"vivo vinikusulukila, gweye Mndewa Imulungu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Loho yangu yomonela ng'hilu Imulungu, Imulungu yeli mgima.","poem":1},{"lineBreak":true},{"text":"Lini nochola koneka kuulongozi wa Imulungu?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mahozi gagalamuka ndiya yangu imisi na ikilo,","poem":1},{"lineBreak":true},{"text":"akuno iwanhu onongela imisi yose, “Imulungu wako kakwahi?”","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Novikumbuka vinhu vino, nahaigubula loho yangu.","poem":1},{"lineBreak":true},{"text":"Vinicholile na wanhu bwando, niwalongoza kuchola mng'anda ya Imulungu,","poem":1},{"lineBreak":true},{"text":"tuchola kwa deng'ho na nyila za kumtogola,","poem":1},{"lineBreak":true},{"text":"tuigoga nyimwilinyimwili.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Loho yangu habali konyuluka?","poem":1},{"lineBreak":true},{"text":"Habali kuhomba mgati yangu?","poem":1},{"lineBreak":true},{"text":"Mtamanile Imulungu,","poem":1},{"lineBreak":true},{"text":"kwavija niye nomtogola kabili,","poem":1},{"lineBreak":true},{"text":"heyo ayo mkombola wangu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Imulungu wangu, loho yangu yonyuluka mgati yangu,","poem":1},{"lineBreak":true},{"text":"avo nokukumbuka gweye mwiisi ya Yolidani na kulugongo lwa Helimoni,","poem":1},{"lineBreak":true},{"text":"na kulawa kulugongo lwa Mizali.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nigaligwa mgamazi mengi,","poem":1},{"lineBreak":true},{"text":"ng'huta za mazi za behi yangu,","poem":1},{"lineBreak":true},{"text":"gogala mibulumo iyagwe,","poem":1},{"lineBreak":true},{"text":"ng'humbi yako ng'hulu ingubika.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mndewa Imulungu kolagusa unogelo wake hawishaga imisi,","poem":1},{"lineBreak":true},{"text":"ikilo lwila lwake lwa hamoja na niye,","poem":1},{"lineBreak":true},{"text":"lwila alo lwa kumpula Imulungu wa ugima wangu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nomulongela Imulungu, dibwe jangu,","poem":1},{"lineBreak":true},{"text":"“Habali kunisemwa?","poem":1},{"lineBreak":true},{"text":"Habali nigendelele kuiyalala kwa koneligwa na iwanhu onihila?”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wanhu onihila oniliga kamba onihonda mizege yangu,","poem":1},{"lineBreak":true},{"text":"onilonga imisi yose,","poem":1},{"lineBreak":true},{"text":"“Imulungu wako kakwahi?”","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Loho yangu habali konyuluka?","poem":1},{"lineBreak":true},{"text":"Habali kuhomba mgati yangu?","poem":1},{"lineBreak":true},{"text":"Mtamanile Imulungu,","poem":1},{"lineBreak":true},{"text":"kwavija niye nomtogola kabili,","poem":1},{"lineBreak":true},{"text":"heyo ayo mkombola wangu na Imulungu wangu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}