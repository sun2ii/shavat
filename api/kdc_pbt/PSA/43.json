{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"heading","content":["ZABULI YA 4343:1 Kwa Kiebulania ino Zabuli ya 42 yogendelela."]},{"type":"verse","number":1,"content":[{"text":"Go Imulungu, unitaguse,","poem":1},{"lineBreak":true},{"text":"nigombele mbuli ya iwanhu wa isi hawamdumba Imulungu,","poem":1},{"lineBreak":true},{"text":"unikombole na iwanhu wavizi na wehile.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gweye kwa Imulungu ngome yangu.","poem":1},{"lineBreak":true},{"text":"Habali kunilema?","poem":1},{"lineBreak":true},{"text":"Habali nigendelele kuiyalala nahoneligwa na iwanhu onihila?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nitumile mulenge wako na kweli yako vinilongoze,","poem":1},{"lineBreak":true},{"text":"vinigale mbaka kulugongo lwako lung'ala,","poem":1},{"lineBreak":true},{"text":"mbaka hanhu houkala.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Abaho nochola kuupango wa nhosa wa Imulungu,","poem":1},{"lineBreak":true},{"text":"heyo konigwaa deng'ho na konitenda niseke.","poem":1},{"lineBreak":true},{"text":"Nokushukulu kwa bango gweye Imulungu, Imulungu wangu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Loho yangu habali konyuluka,","poem":1},{"lineBreak":true},{"text":"Habali kuhomba mgati yangu?","poem":1},{"lineBreak":true},{"text":"Mtamanile Imulungu,","poem":1},{"lineBreak":true},{"text":"kwavija niye nomtogola kabili,","poem":1},{"lineBreak":true},{"text":"heyo ayo mkombola wangu na Imulungu wangu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}