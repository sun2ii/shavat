{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":44,"content":[{"type":"heading","content":["ZABULI YA 44"]},{"type":"hebrew_subtitle","content":["(Kwa kilanja, Lwila lwa ulelo wa Kola.)"]},{"type":"verse","number":1,"content":[{"text":"Go Imulungu, siye tuhulika kwa magwiti getu,","poem":1},{"lineBreak":true},{"text":"iwahenga wetu watulongela gaja gausang'hane kuzisiku zao,","poem":1},{"lineBreak":true},{"text":"ona gaja gausang'hane siku za ako umwaka.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kwa mkono wako kuwaswaswanya wanhu wakalile mwiisi ino,","poem":1},{"lineBreak":true},{"text":"na kuwahanda iwahenga zetu,","poem":1},{"lineBreak":true},{"text":"kuwabananga wanhu wa isi azo,","poem":1},{"lineBreak":true},{"text":"lakini kuwatenda wahenga zetu wamwede.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kwavija siyo kwa sime jao waisola isi ayo,","poem":1},{"lineBreak":true},{"text":"wala siyo mkono wao uwakombole,","poem":1},{"lineBreak":true},{"text":"lakini mkono wako wa ukudila na mng'alo wa ikihanga chako,","poem":1},{"lineBreak":true},{"text":"kwavija kuwanogela.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Imulungu, gweye kwa Mndewa wangu,","poem":1},{"lineBreak":true},{"text":"gweye kolagiza mhumo kwa ulelo wa Yakobo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kwa udahi wako towasung'ha kuchugu iwanhu otwihila,","poem":1},{"lineBreak":true},{"text":"kwa twaga jako towabojoga iwanhu otwihila.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Niye siutamanila upinde wangu,","poem":1},{"lineBreak":true},{"text":"wala sime jangu hadidaha kunikombola.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gweye ayo ututenda tuwahume iwanhu otwihila,","poem":1},{"lineBreak":true},{"text":"wagwe kinyala iwanhu otwihila.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kwa Imulungu wetu toitapa imisi yose,","poem":1},{"lineBreak":true},{"text":"na siye toditogola twaga jako milele.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Lakini sambi kutulema na kutugela kinyala,","poem":1},{"lineBreak":true},{"text":"sambi huchola na iwakalizi zetu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kututenda tubwele kuchugu ya iwanhu otwihila,","poem":1},{"lineBreak":true},{"text":"iwanhu otudeta watuboka vinhu vetu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kutuleka tudafunwe kamba ng'hondolo,","poem":1},{"lineBreak":true},{"text":"na kutupwililisa mziisi ziyagwe.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kuwachuuza wanhu zako kwa sente ndodo,","poem":1},{"lineBreak":true},{"text":"wala hupatile chochose vuuwachuuze.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kututenda kilozo kwa iwanhu okala behi na siye,","poem":1},{"lineBreak":true},{"text":"kututenda tubezigwe na kugewezwa na iwanhu otuzunguluka.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kututenda wasekwa hagati ha iwanhu wa isi ziyagwe,","poem":1},{"lineBreak":true},{"text":"wanhu wa isi ziyagwe otigisa mapala gao.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kinyala changu cha kuulongozi wa wanhu imisi yose,","poem":1},{"lineBreak":true},{"text":"kihanga changu kimema kinyala,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"mbuli ya ugewezi wa iwanhu oniliga,","poem":1},{"lineBreak":true},{"text":"na kunilonga vihile mbuli ya imunhu yonihila yolonda kunibwezela.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Gose gago gatupata,","poem":1},{"lineBreak":true},{"text":"hamoja hatukusemwile,","poem":1},{"lineBreak":true},{"text":"na hatubenile lagano jako.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mizoyo yetu haibwelile kuchugu,","poem":1},{"lineBreak":true},{"text":"wala migulu yetu hailekile nzila yako.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Lakini kutuhonda na kututenda kae ya mbweha,","poem":1},{"lineBreak":true},{"text":"na kutugubika kwa sisila da ifa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Maza tudisemwile twaga da Imulungu wetu,","poem":1},{"lineBreak":true},{"text":"hebu kumgolosela makono getu imulungu iyagwe,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"vino Imulungu sambi yajuwe?","poem":1},{"lineBreak":true},{"text":"Kwavija heyo ayo yagajuwile magesa ga kinyelegezi geli mmoyo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mbuli yako tokomigwa imisi yose,","poem":1},{"lineBreak":true},{"text":"siye kamba ng'hondolo ochola kuchinjwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Lamuka gweye Mndewa.","poem":1},{"lineBreak":true},{"text":"Habali kowasa?","poem":1},{"lineBreak":true},{"text":"Inuka, sikuutuleme milele.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Habali kofisa kihanga chako?","poem":1},{"lineBreak":true},{"text":"Habali koisemwa magazo getu na madununzo getu?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tuhumuluswa mbaka mditimbwisi,","poem":1},{"lineBreak":true},{"text":"ng'huli zetu zinanahilwa na ulongo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Inuka na ututaze,","poem":1},{"lineBreak":true},{"text":"utukombole kwavija unogelo wako hawishaga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}