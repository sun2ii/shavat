{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":45,"content":[{"type":"heading","content":["ZABULI YA 45"]},{"type":"hebrew_subtitle","content":["(Kwa kilanja, yatumie modeli ya lwila lwa besa. Lwila lwa ulelo wa Kola, lwila lwa mapenzi.)"]},{"type":"verse","number":1,"content":[{"text":"Moyo wangu umema magesa ganogile.","poem":1},{"lineBreak":true},{"text":"Nomulongela mndewa mashaili gangu,","poem":1},{"lineBreak":true},{"text":"lulimi lwangu kamba kalamu ya mwandikaji yanogile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Gweye kunoga kubanza iwanhu wose,","poem":1},{"lineBreak":true},{"text":"bazi digidigwa kululimi lwako,","poem":1},{"lineBreak":true},{"text":"avo Imulungu kakutambikila milele.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Funga sime jako mdihaza jako, gweye mwene nguvu,","poem":1},{"lineBreak":true},{"text":"gweye imkulu na utogoligwa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Muukulu wako gendelela kwa kuhuma,","poem":1},{"lineBreak":true},{"text":"mbuli ya kweli na uhole na haki,","poem":1},{"lineBreak":true},{"text":"mkono wako wa ukudila ulaguse mbuli ng'hulu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Misale yako ina nhonga,","poem":1},{"lineBreak":true},{"text":"yohoma mizoyo ya wanhu omwihila mndewa,","poem":1},{"lineBreak":true},{"text":"wanhu ogwa hasi yako.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Go Imulungu, kigoda chako cha ukulu chosigala siku zose na milele,","poem":1},{"lineBreak":true},{"text":"fimbo ya undewa wako yokuwa fimbo ya haki.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Koinogela haki na kogehila gehile,","poem":1},{"lineBreak":true},{"text":"avo Imulungu, Imulungu wako kakusagula,","poem":1},{"lineBreak":true},{"text":"kwa kukugwaa deng'ho kubanza wayago wose.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Viwalo vako vose vonung'hila manemane na udi na mdalasini,","poem":1},{"lineBreak":true},{"text":"kulawa mding'anda da kindewa dihambigwe kwa mhembe zinogile, iwanhu okwimbila kwa bango.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wandele wa wandewa wa mumo mna iwatwanzi wako,","poem":1},{"lineBreak":true},{"text":"mkono wa ukudila kema mndewa wa ikitwanzi yaihambile zahabu ya Ofili.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tegeleza gweye mndele,","poem":1},{"lineBreak":true},{"text":"gelegeza na utege digwiti.","poem":1},{"lineBreak":true},{"text":"Uwasemwe wanhu wako,","poem":1},{"lineBreak":true},{"text":"na iwanhu wa mng'anda ya tatako.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mndewa koulonda unovu wako.","poem":1},{"lineBreak":true},{"text":"Kwavija heyo ayo mkulu wako,","poem":1},{"lineBreak":true},{"text":"avo idulike mbaka hasi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wanhu wa Tilo okugalila nhunza,","poem":1},{"lineBreak":true},{"text":"wanhu matajili ozahila unogelo wako.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Unovu wose wa mndele wa mndewa wa mdigati jake,","poem":1},{"lineBreak":true},{"text":"kiwalo chake kilukigwa kwa nzabi za zahabu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kuno kavala viwalo vihambigwe langi nyingi kolongozwa kwa mndewa,","poem":1},{"lineBreak":true},{"text":"wali wayage omkweleleza na ogaligwa kumwake.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Olongozwa kwa deng'ho na daba,","poem":1},{"lineBreak":true},{"text":"na okwingila mng'anda ya mndewa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Wana wenu osola nyafasi za tata zenu,","poem":1},{"lineBreak":true},{"text":"mowatenda wana wa kindewa mwiisi yose.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nokutenda ukumbukwe ulelo wose.","poem":1},{"lineBreak":true},{"text":"Avo wanhu wa isi zose okutogola siku zose na milele.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":17}