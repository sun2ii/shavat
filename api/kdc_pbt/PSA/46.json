{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":46,"content":[{"type":"heading","content":["ZABULI YA 46"]},{"type":"hebrew_subtitle","content":["(Zabuli ya ulelo wa Kola. Kwa kilanja, yatumie modeli wa Alamoti.)"]},{"type":"verse","number":1,"content":[{"text":"Imulungu kumwetu siye ayo kimbililo na nguvu,","poem":1},{"lineBreak":true},{"text":"msaada ukoneka kipindi chose cha magazo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Avo hatudumba hata isi yahatigisika,","poem":1},{"lineBreak":true},{"text":"na vigongo vahatulika,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"hata kamba mazi gahabuma na kutibuka,","poem":1},{"lineBreak":true},{"text":"na vigongo vahamong'onyoligwa kwa ng'humbi yake.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kuna lwanda awo miloka yake yodideng'heza dibuga da Imulungu,","poem":1},{"lineBreak":true},{"text":"hanhu hong'ala aho hoyokala ayo Yeli Uchanha Ng'hani.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Imulungu kahagati ya dibuga na hadihumuluswa,","poem":1},{"lineBreak":true},{"text":"Imulungu koditaza ulukwili na imitondo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wanhu wa isi ziyagwe odumba na oding'huka na undewa ogwa,","poem":1},{"lineBreak":true},{"text":"heyo kokwinula sauti yake, isi yose yolumbuka.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mndewa Imulungu yeli na udahi wose kahamoja na siye,","poem":1},{"lineBreak":true},{"text":"Imulungu wa Yakobo ayo ngome yetu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mwize mulole gaja gayatendile Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"loleni viyaitendile isi vihame.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Koimiza ng'hondo mbaka kuihelela isi.","poem":1},{"lineBreak":true},{"text":"Koubena upinde na koubenabena mgoha,","poem":1},{"lineBreak":true},{"text":"koisoma moto mituka.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"“Nyamaleni mjuwe kamba niye ayo Imulungu,","poem":1},{"lineBreak":true},{"text":"notogolwa hagati ha iwanhu wa isi zose,","poem":1},{"lineBreak":true},{"text":"notogolwa na isi yose.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mndewa Imulungu yeli na udahi wose kahamoja na siye,","poem":1},{"lineBreak":true},{"text":"Imulungu wa Yakobo ayo ngome yetu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}