ya nyangi za deng'ho,","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu kahagati ya sauti za mhalati.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mwimbileni Imulungu nyila za kumtogola,","poem":1},{"lineBreak":true},{"text":"imbeni nhogolwa,","poem":1},{"lineBreak":true},{"text":"mwimbileni nhogolwa Mndewa wetu,","poem":1},{"lineBreak":true},{"text":"imbeni nhogolwa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kwavija Imulungu ayo Mndewa wa isi yose,","poem":1},{"lineBreak":true},{"text":"mwimbileni zabuli za nhogolwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Imulungu kotawala iwanhu wa isi zose,","poem":1},{"lineBreak":true},{"text":"Imulungu kakala uchanha ya kigoda chake cha undewa king'ala.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ivilongozi wa iwanhu wa isi waiting'hana,","poem":1},{"lineBreak":true},{"text":"wailumba na iwanhu wa Imulungu wa Abulahamu,","poem":1},{"lineBreak":true},{"text":"kwavija wandewa wa mwiisi mwenyego Imulungu,","poem":1},{"lineBreak":true},{"text":"heyo kenuligwa ng'hani.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}