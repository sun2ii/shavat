{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":48,"content":[{"type":"heading","content":["ZABULI YA 48"]},{"type":"hebrew_subtitle","content":["(Zabuli ya ulelo wa Kola.)"]},{"type":"verse","number":1,"content":[{"text":"Mndewa Imulungu ayo imkulu na kofaya kutogolwa,","poem":1},{"lineBreak":true},{"text":"kudibuga da Imulungu wetu, lugongo lwake lung'ala,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"lunoga na lutali ng'hani, deng'ho da isi yose.","poem":1},{"lineBreak":true},{"text":"Nhembeti za Safoni kamba lugongo lwa Sayuni,","poem":1},{"lineBreak":true},{"text":"dibuga da Mndewa Imkulu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Imulungu kamzingome zake,","poem":1},{"lineBreak":true},{"text":"kailagusa mwenyego kamba mkalizi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lola iwandewa viwailumbile na kuchola hamoja,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"bahaja viwamone wakanganya,","poem":1},{"lineBreak":true},{"text":"wakimbila kwa bwembwe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wasonga kugwaya kuko,","poem":1},{"lineBreak":true},{"text":"wona usungu kamba wa mtwanzi yolonda kulela.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wabanangwa kamba meli ng'hulu za Talishishi,","poem":1},{"lineBreak":true},{"text":"zibenigwe na beho da umwambu wa kudilawila zuwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kamba vituhulike,","poem":1},{"lineBreak":true},{"text":"vivo vitone kudibuga da Mndewa Imulungu yeli na udahi wose,","poem":1},{"lineBreak":true},{"text":"kudibuga da Imulungu wetu, Imulungu kodikaliza milele.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Go Imulungu, mng'anda yako tougelegeza unogelo wako hawishaga.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kamba twaga jako vidijuwika kila hanhu,","poem":1},{"lineBreak":true},{"text":"vivo kila munhu yakutogole gweye mbaka kuihelela isi yose,","poem":1},{"lineBreak":true},{"text":"mkono wako wa ukudila umemezwa haki.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lugongo lwa Sayuni lodeng'helela,","poem":1},{"lineBreak":true},{"text":"vijiji va Yuda vodeng'helela,","poem":1},{"lineBreak":true},{"text":"kwa nhaguso zako.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tembeleni Sayuni, zungulukeni kudibuga,","poem":1},{"lineBreak":true},{"text":"muvipete ivilingo vake.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gelegezeni ziluwa zake,","poem":1},{"lineBreak":true},{"text":"loleni ngome zake,","poem":1},{"lineBreak":true},{"text":"ili musimulile mbuli zake kwa ulelo ukwiza.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kwavija ino Imulungu ayo Imulungu wetu,","poem":1},{"lineBreak":true},{"text":"siku zose na milele kokuwa kilongozi wetu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}