{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":49,"content":[{"type":"heading","content":["ZABULI YA 49"]},{"type":"hebrew_subtitle","content":["(Kwa kilanja, Zabuli ya ulelo wa Kola.)"]},{"type":"verse","number":1,"content":[{"text":"Tegelezeni gano mweye iwanhu wa isi zose,","poem":1},{"lineBreak":true},{"text":"Hulikeni mweye mose mkala mwiisi ino.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wose, iwakulu na iwadodo,","poem":1},{"lineBreak":true},{"text":"matajili na wakiwa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mulomo wangu olonga mbuli za ubala,","poem":1},{"lineBreak":true},{"text":"magesa gangu golava nzewele.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Notega gwiti jangu nhegeleze nongezi,","poem":1},{"lineBreak":true},{"text":"notegula kitendawili kwa bango.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Habali nidumbe siku za magazo,","poem":1},{"lineBreak":true},{"text":"iwanhu wavizi wahanizunguluka?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Awo otamanila vinhu vao,","poem":1},{"lineBreak":true},{"text":"na oitapa kwa utajili wao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Haduhu munhu yoyose yodaha kuugombola ugima wa munhu iyagwe,","poem":1},{"lineBreak":true},{"text":"hebu yamlihe Imulungu bei ya ugima wake mwenyego,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"kwavija bei ya ugima ibanza ng'hani,","poem":1},{"lineBreak":true},{"text":"na yokala vivo milele,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ili yakale mgima milele,","poem":1},{"lineBreak":true},{"text":"na sikuyengile mdipanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Avo wose okona kamba iwanhu wabala odanganika,","poem":1},{"lineBreak":true},{"text":"na wabozi na mizozolo vivija opotela,","poem":1},{"lineBreak":true},{"text":"na owalekela iwanhu wayagwe vinhu vao vose.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mapanga gao gokuwa ng'anda zao milele,","poem":1},{"lineBreak":true},{"text":"kae za ulelo wose,","poem":1},{"lineBreak":true},{"text":"hamoja wakala na migunda ikemigwe kwa matwaga gao.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Munhu muutajili wake hasigala siku zose,","poem":1},{"lineBreak":true},{"text":"heyo kodanganika kamba mng'onyo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kino acho kimambukizo cha awo oitamanila mwenyego,","poem":1},{"lineBreak":true},{"text":"na awo owakweleleza na onogelwa na ulonzi wao.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kamba ng'hondolo ochola kuzimu,","poem":1},{"lineBreak":true},{"text":"na ifa yowalongoza.","poem":1},{"lineBreak":true},{"text":"Iwanhu wanogile owatawala imitondo,","poem":1},{"lineBreak":true},{"text":"na ng'huli zao zokola kudipanga,","poem":1},{"lineBreak":true},{"text":"okala kutali na ming'anda yao inogile.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Lakini Imulungu konigombola kulawa kuzimu,","poem":1},{"lineBreak":true},{"text":"ona konisola kumwake.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Sambi udumbe munhu yahapata utajili,","poem":1},{"lineBreak":true},{"text":"ukulu wa ng'anda yake wahongezeka,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"kwavija yahadanganika hasola kinhu chochose,","poem":1},{"lineBreak":true},{"text":"ukulu wake hachola nao.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hamoja viyakalile mgima kayona kamweda,","poem":1},{"lineBreak":true},{"text":"na iwanhu wamtogola kamba katenda goya,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"kochola kwa iwahenga zake wadanganike mwaka,","poem":1},{"lineBreak":true},{"text":"kuko hawawona umulenge milele.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Munhu yeli tajili lakini kabule nzewele,","poem":1},{"lineBreak":true},{"text":"kaigala na wang'onyo ofa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":20}