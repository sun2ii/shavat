{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":5,"content":[{"type":"heading","content":["ZABULI YA 5"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi. Kwa kilanja, yatumie filimbi.)"]},{"type":"verse","number":1,"content":[{"text":"Utegeleze mbuli zangu,","poem":1},{"lineBreak":true},{"text":"gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"ulole kugutilila kwangu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Utegeleze sauti ya kililo changu,","poem":1},{"lineBreak":true},{"text":"Mndewa wangu na Imulungu wangu,","poem":1},{"lineBreak":true},{"text":"gweye ayo nikupula.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Go Mndewa Imulungu, imitondo kotegeleza sauti yangu,","poem":1},{"lineBreak":true},{"text":"imitondo nokupula abaho nobeta.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kwavija gweye huli Imulungu yodeng'helela gehile,","poem":1},{"lineBreak":true},{"text":"kumwako haduhu gehile.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Iwanhu oitapa hawadaha kwima wima kuulongozi wako,","poem":1},{"lineBreak":true},{"text":"gweye kowehila wose otenda gehile.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kowabananga wose olonga uvizi,","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu kowehila wakomaji na wose obunyika wayagwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lakini niye kwa unogelo wako hawishaga,","poem":1},{"lineBreak":true},{"text":"nokwingila mng'anda yako.","poem":1},{"lineBreak":true},{"text":"Nogwa kingubanguba kuulongozi wa ng'anda yako ing'ala,","poem":1},{"lineBreak":true},{"text":"kwa kukudumba gweye.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Go Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"unilongoze kwa haki yako,","poem":1},{"lineBreak":true},{"text":"mbuli ya awo onihila,","poem":1},{"lineBreak":true},{"text":"unigolosele nzila yako kuulongozi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kwavija haduhu ukweli mmilomo yao,","poem":1},{"lineBreak":true},{"text":"mizoyo yao imema kubananga,","poem":1},{"lineBreak":true},{"text":"mitundu melo yao kamba panga hadisiligwe,","poem":1},{"lineBreak":true},{"text":"milimi yao imema uvizi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gweye Mndewa Imulungu uwakoboze kwa gehile gao,","poem":1},{"lineBreak":true},{"text":"wagwe kwa viseto vao vihile,","poem":1},{"lineBreak":true},{"text":"wawinge kunze mbuli ya ukumema kwa gehile gao,","poem":1},{"lineBreak":true},{"text":"kwavija wakulema gweye.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Lakini wose okukimbilila gweye wadeng'helele,","poem":1},{"lineBreak":true},{"text":"waleke wagute mizangi ya deng'ho siku zose.","poem":1},{"lineBreak":true},{"text":"Uweke goya wose odinogela twaga jako,","poem":1},{"lineBreak":true},{"text":"ili wadeng'helele mbuli yako.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kwavija gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kowatenda wamwede iwanhu wanogile,","poem":1},{"lineBreak":true},{"text":"kowakaliza kwa unogelo wako kamba kwa ngao.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}