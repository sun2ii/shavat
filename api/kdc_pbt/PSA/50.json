{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":50,"content":[{"type":"heading","content":["ZABULI YA 50"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Asafu.)"]},{"type":"verse","number":1,"content":[{"text":"Imulungu mwene nguvu,","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu kolonga na kuikema isi yose,","poem":1},{"lineBreak":true},{"text":"tangu kudilawila zuwa na kudiswela.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kulawa Sayuni, hanhu hatelele kwa unovu,","poem":1},{"lineBreak":true},{"text":"Imulungu komwemwesa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Imulungu wetu kokwiza na hanyamala bule,","poem":1},{"lineBreak":true},{"text":"moto usakaza omulongolela,","poem":1},{"lineBreak":true},{"text":"akuno kazungulukwa na kukuzumbi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Koukema ulanga ukalaga uchanha ng'hani,","poem":1},{"lineBreak":true},{"text":"na koikema isi ili vilole vonda yawataguse wanhu zake.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"“Wating'hanizeni iwanhu wangu otamanilwa,","poem":1},{"lineBreak":true},{"text":"awo watendile lagano na niye kwa nhosa.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ulanga osimulila haki yake,","poem":1},{"lineBreak":true},{"text":"kwavija Imulungu mwenyego ayo msemi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Tegelezeni mweye wanhu zangu, na niye nolonga,","poem":1},{"lineBreak":true},{"text":"gweye Izilaeli na niye nowasindila.","poem":1},{"lineBreak":true},{"text":"Niye ayo Imulungu, Imulungu wenu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sikukomhokela mbuli ya nhosa zako,","poem":1},{"lineBreak":true},{"text":"hebu nhosa zako za kusoma moto.","poem":1},{"lineBreak":true},{"text":"Siku zose za kuulongozi wangu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Siwalonda ng'ombe wa banda jako,","poem":1},{"lineBreak":true},{"text":"hebu mbuzi kulawa kudibumba jako.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kwavija kila mnyama wa kumuhulo wangu niye,","poem":1},{"lineBreak":true},{"text":"fugo uchanha ya vigongo elufu wangu niye.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nimtanga kila ndege kulugongo,","poem":1},{"lineBreak":true},{"text":"nao viumbe weli kukonde wangu niye.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Maza ng'halile na nzala sambi niwalongele mweye,","poem":1},{"lineBreak":true},{"text":"kwavija isi yose na vose vikala mumo vangu niye.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Vino, niye noja nyama ya ng'ombe mbigalo,","poem":1},{"lineBreak":true},{"text":"hebu nong'wa damu ya mbuzi?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mulavile Imulungu nhosa za kumtogola,","poem":1},{"lineBreak":true},{"text":"na uvikize gaja gaulongile kwa ayo yokala Uchanha Ng'hani.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Unikeme siku ya magazo,","poem":1},{"lineBreak":true},{"text":"na niye nokuhonya na gweye konitogola.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Lakini kwa iwanhu wehile, Imulungu kolonga,","poem":1},{"lineBreak":true},{"text":"“Gweye kuna haki gani kulonga malagizo gangu,","poem":1},{"lineBreak":true},{"text":"na kulonga lagano jangu mmulomo wako?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kwavija gweye kulema kuzumwa,","poem":1},{"lineBreak":true},{"text":"na kugalema malagizo gangu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Uhamona mbavi koilumba na heyo,","poem":1},{"lineBreak":true},{"text":"koilumba na wagoni.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Kuleka mulomo wako ulonge gehile,","poem":1},{"lineBreak":true},{"text":"na lulimi lwako lolonga bunyiko.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Siku zose komdeta ndugu yako,","poem":1},{"lineBreak":true},{"text":"na komtendela uchakubimbi mwana wa mamako.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Gago gose kugatenda na niye ninyamala tuluu,","poem":1},{"lineBreak":true},{"text":"kogizaga niye na kamba gweye.","poem":1},{"lineBreak":true},{"text":"Lakini niye nokuzuma na nokukomhokela.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Gelegezeni gano mweye munisemwaga niye Imulungu,","poem":1},{"lineBreak":true},{"text":"ama nowadega vihande vihande,","poem":1},{"lineBreak":true},{"text":"na haduhu munhu yodaha kuwakombola.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Imunhu yolava nhosa za kunitogola,","poem":1},{"lineBreak":true},{"text":"ayo iyo yonitegeleza niye,","poem":1},{"lineBreak":true},{"text":"imunhu yokweleleza nzila yangu,","poem":1},{"lineBreak":true},{"text":"ayo nomulagusila ukombola wangu niye Imulungu.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}