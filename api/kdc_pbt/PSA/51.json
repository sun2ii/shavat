{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":51,"content":[{"type":"heading","content":["ZABULI YA 51"]},{"type":"hebrew_subtitle","content":["(Kwa kilanja. Zabuli ya Daudi viyeshilize kukomhokeligwa na mtula ndagu Natani mbuli ya kutenda ugoni na Batisheba.)",{"noteId":3}]},{"type":"verse","number":1,"content":[{"text":"Go Imulungu, unyonele bazi,","poem":1},{"lineBreak":true},{"text":"kamba unogelo wako hawishaga viwili mkulu,","poem":1},{"lineBreak":true},{"text":"kamba vidili kulu bazi jako,","poem":1},{"lineBreak":true},{"text":"ugasegese gehile gangu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ugakoshe gehile gangu,","poem":1},{"lineBreak":true},{"text":"uzisegese nzambi zangu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kwavija nogatanga gehile gangu,","poem":1},{"lineBreak":true},{"text":"na nzambi yangu ya kuulongozi wangu siku zose.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kumwako gweye uiyeka nhenda nzambi,","poem":1},{"lineBreak":true},{"text":"na nhenda gehile mgameso gako,","poem":1},{"lineBreak":true},{"text":"avo magesa gako ga haki,","poem":1},{"lineBreak":true},{"text":"nhaguso yako itelela.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lola niye nileligwa kamba mwene nzambi,","poem":1},{"lineBreak":true},{"text":"niye na mwene nzambi tangu mamangu viyageligwe inda yangu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Gweye konogezwa na kweli ilawa mmoyo,","poem":1},{"lineBreak":true},{"text":"mgati mmoyo wangu konifunza ubala.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Unikoshe kwa bunho da hisopo na niye nong'ala,","poem":1},{"lineBreak":true},{"text":"unikoshe na niye nokuwa mzelu kubanza pamba.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Unitende nihulike seko na deng'ho,","poem":1},{"lineBreak":true},{"text":"mizege yangu yuuhondile ideng'helele.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ukifise kihanga chako sambi ulole nzambi yangu,","poem":1},{"lineBreak":true},{"text":"na ugafute gehile gangu gose.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Gweye Imulungu unilumbile moyo ung'alile,","poem":1},{"lineBreak":true},{"text":"uilumbe kabili loho itindiwale mgati mmwangu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sambi unitupe kutali na gweye,","poem":1},{"lineBreak":true},{"text":"sikuunisegesele loho wako yang'alile.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Unibwezele kabili deng'ho jangu da ukombola,","poem":1},{"lineBreak":true},{"text":"unigwelele loho ya kugoga igako.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Abaho nowafunza iwanhu wehile nzila zako,","poem":1},{"lineBreak":true},{"text":"na wene nzambi okuhindukila gweye.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Gweye Imulungu unikombole na nzambi ya kwita damu,","poem":1},{"lineBreak":true},{"text":"gweye Imulungu mkombola wangu,","poem":1},{"lineBreak":true},{"text":"lulimi lwangu lokwimba haki yako.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Go Mndewa, fungula mulomo wangu,","poem":1},{"lineBreak":true},{"text":"na lulimi lwangu lolonga ukulu wako.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Gweye hunogezwa na nhosa,","poem":1},{"lineBreak":true},{"text":"maza ikalile ivo nahakulavile,","poem":1},{"lineBreak":true},{"text":"gweye hunogezwa na nhosa za kusoma moto.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ila nhosa zilondigwa na Imulungu ayo loho ihondeke,","poem":1},{"lineBreak":true},{"text":"na moyo uhondeke na ulongaga ng'hosa,","poem":1},{"lineBreak":true},{"text":"gweye Imulungu huubezeli bule.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kwa ganogile gako uitende Sayuni igendelele,","poem":1},{"lineBreak":true},{"text":"uluzenge kabili luwa lwa Yelusalemu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Abaho hokuwa na nhosa zitelele,","poem":1},{"lineBreak":true},{"text":"na nhosa zose za kusoma moto zikunogeza ng'hani,","poem":1},{"lineBreak":true},{"text":"na ng'ombe mbigalo olavigwa muupango wako wa nhosa.","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"Lola kitabu cha 2 Samweli 11.1-12:15.","reference":{"chapter":51,"verse":0}}]},"thisChapterLink":"/api/kdc_pbt/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":19}