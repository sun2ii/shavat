{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":52,"content":[{"type":"heading","content":["ZABULI YA 52"]},{"type":"hebrew_subtitle","content":["(Kwa kilanja, Zabuli ya Daudi mbuli ya kipindi Doegi Mwedomu viyamcholele Sauli na kumulongela, “Daudi kengila mng'anda ya Ahimeleki.”)",{"noteId":4}]},{"type":"verse","number":1,"content":[{"text":"Gweye zinhu, habali koigodela gehile?","poem":1},{"lineBreak":true},{"text":"Unogelo hawishaga wa Imulungu okala siku zose.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gweye utendaga gehile,","poem":1},{"lineBreak":true},{"text":"lulimi lwako lopanga ubananzi,","poem":1},{"lineBreak":true},{"text":"kamba lwembe mkali.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Konogezwa na gehile kubanza ganogile,","poem":1},{"lineBreak":true},{"text":"na uvizi kubanza kulonga ukweli.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Konogezwa na ulonzi wa usede,","poem":1},{"lineBreak":true},{"text":"gweye lulimi lumemile uvizi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Imulungu kokuhumulusa hasi milele,","poem":1},{"lineBreak":true},{"text":"kokuzomola na kokusegesa kulawa mkibanda chako,","poem":1},{"lineBreak":true},{"text":"kokung'ola kulawa mwiisi ya iwanhu weli wagima.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wene haki okona na kudumba,","poem":1},{"lineBreak":true},{"text":"omseka na kulonga,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"“Ino ayo munhu ija hamtendile Imulungu kamba ngome yake,","poem":1},{"lineBreak":true},{"text":"lakini katamanila utajili wake,","poem":1},{"lineBreak":true},{"text":"kakala galu kwa kuwabananga wayagwe.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lakini niye kamba biki da mzeituni,","poem":1},{"lineBreak":true},{"text":"dihandigwe mng'anda ya Imulungu,","poem":1},{"lineBreak":true},{"text":"noutamanila unogelo hawishaga wa Imulungu ukalaga siku zose na milele.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Go Imulungu, nokushukulu milele kwa gaja gautendile,","poem":1},{"lineBreak":true},{"text":"noditamanila twaga jako kwavija twaga jako dinoga.","poem":1},{"lineBreak":true},{"text":"Nokutogola kuulongozi wa iwanhu wako wang'alile.","poem":1}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Lola kitabu cha 1 Samweli 21:7, 22:9-10.","reference":{"chapter":52,"verse":0}}]},"thisChapterLink":"/api/kdc_pbt/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}