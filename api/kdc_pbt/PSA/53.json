{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":53,"content":[{"type":"heading","content":["ZABULI YA 53"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi. Kwa kilanja, yatumie modeli wa Mahalati.)"]},{"type":"verse","number":1,"content":[{"text":"Mbozi kolonga mmoyo wake,","poem":1},{"lineBreak":true},{"text":"“Kuduhu Imulungu.”","poem":1},{"lineBreak":true},{"text":"Wose wanangika,","poem":1},{"lineBreak":true},{"text":"otenda gaja gogevuza,","poem":1},{"lineBreak":true},{"text":"haduhu hata imoja yotenda ganogile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Imulungu kowasungulila iwanhu hasi kulawa kuulanga,","poem":1},{"lineBreak":true},{"text":"kolola kamba hana munhu kana nzewele,","poem":1},{"lineBreak":true},{"text":"na komzahila Imulungu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kila munhu kahindukila kutali,","poem":1},{"lineBreak":true},{"text":"wabanangika wose hamoja,","poem":1},{"lineBreak":true},{"text":"haduhu hata imoja yotenda ganogile,","poem":1},{"lineBreak":true},{"text":"ona! hata imoja haduhu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Vino, iwanhu otenda gehile hawajuwa bule?","poem":1},{"lineBreak":true},{"text":"Owaja iwanhu zangu kamba munhu yoja gate,","poem":1},{"lineBreak":true},{"text":"na hawamgesa Imulungu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Avo ogwaya kwa bwembwe,","poem":1},{"lineBreak":true},{"text":"hata kamba haduhu kinhu cha kudumba.","poem":1},{"lineBreak":true},{"text":"Imulungu kaipwililisa imizege ya iwanhu wakuvamile,","poem":1},{"lineBreak":true},{"text":"gweye kowatenda wakone kinyala,","poem":1},{"lineBreak":true},{"text":"kwavija Imulungu kawabezeli.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Maza ukombola wa Izilaeli wize kulawa Sayuni.","poem":1},{"lineBreak":true},{"text":"Imulungu vonda yawabweze iwafungwa wa wanhu zake,","poem":1},{"lineBreak":true},{"text":"Yakobo yadeng'helele,","poem":1},{"lineBreak":true},{"text":"Izilaeli yasekelele.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}