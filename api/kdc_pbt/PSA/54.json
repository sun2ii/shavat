{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"heading","content":["ZABULI YA 54"]},{"type":"hebrew_subtitle","content":["(Kwa kilanja, yatumie nyuzi za bango. Zabuli ya Daudi mbuli ya kipindi Wazifu viwamcholele Sauli na kumulongela kamba Daudi kaifisa kumwao.)",{"noteId":5}]},{"type":"verse","number":1,"content":[{"text":"Gweye Imulungu, nikombole kwa twaga jako,","poem":1},{"lineBreak":true},{"text":"unilekese kwa nguvu zako.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gweye Imulungu, tegeleza kupula kwangu,","poem":1},{"lineBreak":true},{"text":"uhulike mbuli zinilonga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wanhu baki onivamila,","poem":1},{"lineBreak":true},{"text":"wanhu wasede ozahila ugima wangu,","poem":1},{"lineBreak":true},{"text":"iwanhu hawamgesa Imulungu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lakini Imulungu ayo yonitaza,","poem":1},{"lineBreak":true},{"text":"Mndewa ayo yougoga ugima wangu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Heyo kowabwezela gehile iwanhu onihila niye.","poem":1},{"lineBreak":true},{"text":"Kwa kutamanilwa kwako gweye Imulungu uwabanange.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nokulavila nhosa za kulonda mwenyego,","poem":1},{"lineBreak":true},{"text":"Go Mndewa Imulungu, noditogola twaga jako kwavija dinoga.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kwavija kanikombola kulawa mmagazo gangu gose,","poem":1},{"lineBreak":true},{"text":"meso gangu gona kuhumwa kwa iwanhu onihila.","poem":1}]}],"footnotes":[{"noteId":5,"caller":"+","text":"Lola kitabu cha 1 Samweli 23:15-24, 26:1-5.","reference":{"chapter":54,"verse":0}}]},"thisChapterLink":"/api/kdc_pbt/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}