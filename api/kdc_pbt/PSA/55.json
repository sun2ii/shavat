{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":55,"content":[{"type":"heading","content":["ZABULI YA 55"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi. Kwa kilanja, yatumie nyuzi za bango.)"]},{"type":"verse","number":1,"content":[{"text":"Gweye Imulungu tegeleza kupula kwangu,","poem":1},{"lineBreak":true},{"text":"na sikuubezeli ulonzi wangu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nitegeleze na unidike.","poem":1},{"lineBreak":true},{"text":"Magesa gangu gonigaza na kunyuluka.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mbuli ya sauti ya imunhu yonihila,","poem":1},{"lineBreak":true},{"text":"kwa kuloligwa na iwanhu onihila,","poem":1},{"lineBreak":true},{"text":"kwavija ongalila magazo,","poem":1},{"lineBreak":true},{"text":"na oniliga kwa kugevuzika.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Moyo wangu umema usungu,","poem":1},{"lineBreak":true},{"text":"bwembwe da ifa dingubika.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bwembwe na kugwaya vinizunguluka,","poem":1},{"lineBreak":true},{"text":"bwembwe kulu dingoga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nilonga, “Maza ng'halile na mabawa kamba njiwa!","poem":1},{"lineBreak":true},{"text":"Nahaguluke nichole kutali nikabwihile.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nahacholile kutali ng'hani,","poem":1},{"lineBreak":true},{"text":"nahakalile kuluwala.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nahalopole kuchola hanhu hanogile,","poem":1},{"lineBreak":true},{"text":"kutali na kukuzumbi na magazo.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Go Mndewa, uwabanange iwanhu onihila,","poem":1},{"lineBreak":true},{"text":"na uwatende sikuwaitogolele viwolonga,","poem":1},{"lineBreak":true},{"text":"kwavija nyona migomvi na ndwagi kudibuga.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Imisi na ikilo ozunguluka uchanha ya luwa lwake,","poem":1},{"lineBreak":true},{"text":"gehile na magazo va mgati yake.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nguvu za ubananzi zosang'hana kudibuga,","poem":1},{"lineBreak":true},{"text":"bwembwe na uvizi havisegela kudigulilo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Maza imunhu yonihila yaniligile,","poem":1},{"lineBreak":true},{"text":"nahagelile kumgongo,","poem":1},{"lineBreak":true},{"text":"maza imunhu yonihila yainule kumwangu,","poem":1},{"lineBreak":true},{"text":"nahaifisile sikuyanyone.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Lakini kumbe gweye miyangu,","poem":1},{"lineBreak":true},{"text":"mbwigangu nikutangile ng'hani.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ayo tukalile toisekela kimbwiga,","poem":1},{"lineBreak":true},{"text":"vitukalile tochola hamoja na wanhu wayagwe mng'anda ya Imulungu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Leka ifa iwezile himahima iwanhu onihila,","poem":1},{"lineBreak":true},{"text":"na wachole kuzimu kuno wang'hali wagima,","poem":1},{"lineBreak":true},{"text":"kwavija gehile ga mgati yao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Lakini nomkema Imulungu,","poem":1},{"lineBreak":true},{"text":"na Mndewa Imulungu konikombola.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Imitondo, imisi na ichungulo,","poem":1},{"lineBreak":true},{"text":"nolila kwa magazo,","poem":1},{"lineBreak":true},{"text":"na heyo koihulika sauti yangu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Konikombola na nokala goya kulawa kung'hondo,","poem":1},{"lineBreak":true},{"text":"hamoja iwanhu wengi onilema.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Imulungu yotawala kulawa milele,","poem":1},{"lineBreak":true},{"text":"kowahulika na kowakoboza iwanhu onihila,","poem":1},{"lineBreak":true},{"text":"kwavija hawahindula nzila zao,","poem":1},{"lineBreak":true},{"text":"na hawamdumba Imulungu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Miyangu kawavamila mbwiga zake,","poem":1},{"lineBreak":true},{"text":"na kabena lagano jake.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mbuli zake zamulile kubanza uki,","poem":1},{"lineBreak":true},{"text":"hata ivo mmoyo wake kuna ng'hondo,","poem":1},{"lineBreak":true},{"text":"mbuli zake zonyilibuka kubanza mavuta,","poem":1},{"lineBreak":true},{"text":"lakini zokanha kamba sime dinoligwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Mdikwe Mndewa Imulungu magazo gako,","poem":1},{"lineBreak":true},{"text":"na heyo kokudahiza,","poem":1},{"lineBreak":true},{"text":"hamuleka ng'o imunhu mwene haki yagwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Lakini gweye Imulungu kowagala hasi kudisimo da ubananzi,","poem":1},{"lineBreak":true},{"text":"wanhu okwita damu na wehile,","poem":1},{"lineBreak":true},{"text":"hawakala wagima nusu ya siku zao.","poem":1},{"lineBreak":true},{"text":"Lakini niye nokutamanila gweye.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}