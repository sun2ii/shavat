{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":56,"content":[{"type":"heading","content":["ZABULI YA 56"]},{"type":"hebrew_subtitle","content":["(Kwa kilanja, yatumie modeli wa, “Huwa yalawile kutali yahumule.” Zabuli ya Daudi mbuli ya kipindi viyagogigwe na Wafilisiti ako Gati.)",{"noteId":6}]},{"type":"verse","number":1,"content":[{"text":"Gweye Imulungu unyonele bazi,","poem":1},{"lineBreak":true},{"text":"kwavija wanhu onivamila ng'hani,","poem":1},{"lineBreak":true},{"text":"imisi yose okwengeza kunidununza.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Awo iwanhu onihila onikweleleza imisi yose,","poem":1},{"lineBreak":true},{"text":"onivamila kwa kuitapa kwao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bwembwe dahangoga,","poem":1},{"lineBreak":true},{"text":"nokutamanila gweye.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kwa Imulungu kumwake noditogola twaga jake,","poem":1},{"lineBreak":true},{"text":"kwa Imulungu notamanila, sidumba bule.","poem":1},{"lineBreak":true},{"text":"Imunhu yofa konitenda choni?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Imisi yose ozihindula mbuli zangu,","poem":1},{"lineBreak":true},{"text":"siku zose ogelegeza kunilumiza.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Oilumba kunitendela gehile na oifisa,","poem":1},{"lineBreak":true},{"text":"olola kila hanhu kunibita,","poem":1},{"lineBreak":true},{"text":"kuno osulukila kunikoma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gweye Imulungu uwakoboze mna ing'hasiliki yako,","poem":1},{"lineBreak":true},{"text":"uwabwanhe iwanhu wa isi ziyagwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yandika kuiyalala kwangu,","poem":1},{"lineBreak":true},{"text":"gandike mkitabu chako mahozi gangu.","poem":1},{"lineBreak":true},{"text":"Vino gago gakuduhu mkitabu chako cha kumbukumbu?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Avo iwanhu onihila obwela kuchugu,","poem":1},{"lineBreak":true},{"text":"nahakukema unitaze.","poem":1},{"lineBreak":true},{"text":"Kwa mbuli ayo,","poem":1},{"lineBreak":true},{"text":"notanga kamba Imulungu ka ubanzi wangu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nomtamanila Imulungu na noitogola mbuli yake,","poem":1},{"lineBreak":true},{"text":"nomtamanila Mndewa Imulungu na noitogola mbuli yake.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kwa Imulungu notamanila na sidumba bule.","poem":1},{"lineBreak":true},{"text":"Imunhu konitenda choni?","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Gweye Imulungu niye niiduwila kumwako,","poem":1},{"lineBreak":true},{"text":"nokulavila sadaka za kukutogola.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kwavija kunikombola kulawa mkifo,","poem":1},{"lineBreak":true},{"text":"na kunikaliza sikunigwe hasi,","poem":1},{"lineBreak":true},{"text":"ili nichole kuulongozi wa Imulungu kudilenge da ugima.","poem":1}]}],"footnotes":[{"noteId":6,"caller":"+","text":"Lola kitabu cha 1 Samweli 21:10-15, 27:1-4.","reference":{"chapter":56,"verse":0}}]},"thisChapterLink":"/api/kdc_pbt/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}