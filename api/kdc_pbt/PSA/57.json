{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":57,"content":[{"type":"heading","content":["ZABULI YA 57"]},{"type":"hebrew_subtitle","content":["(Kwa kilanja, yatumie modeli wa, “Sikuubanange!” Zabuli ya Daudi mbuli ya kipindi viyamkimbile Sauli kuimhango.)",{"noteId":7}]},{"type":"verse","number":1,"content":[{"text":"Unyonele bazi, gweye Imulungu, unyonele bazi,","poem":1},{"lineBreak":true},{"text":"kwavija moyo wangu okukimbilila gweye.","poem":1},{"lineBreak":true},{"text":"Kuna imbeho ya mabawa gako nokimbilila,","poem":1},{"lineBreak":true},{"text":"mbaka kukuzumbi dibite.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nomlilila Imulungu yeli uchanha ng'hani,","poem":1},{"lineBreak":true},{"text":"Imulungu yovikizaga gaja goyolonda kumwangu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Konitaza kulawa kuulanga na konikombola,","poem":1},{"lineBreak":true},{"text":"kowakomhokela iwanhu onikweleleza ng'hani,","poem":1},{"lineBreak":true},{"text":"Imulungu kogala unogelo wake hawishaga na kutamanilwa kwake.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Niye na hagati ya simba,","poem":1},{"lineBreak":true},{"text":"niwasa hagati ya iming'onyo ili na nzala ng'hulu,","poem":1},{"lineBreak":true},{"text":"iwanhu meno gao kamba migoha na misale,","poem":1},{"lineBreak":true},{"text":"milimi yao kamba sime dinoligwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Gweye Imulungu, utogolwe uchanha kuulanga,","poem":1},{"lineBreak":true},{"text":"na isi yose imemezwe ukulu wako.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Waitegela lwavu migulu yangu,","poem":1},{"lineBreak":true},{"text":"moyo wangu una lusikisiki,","poem":1},{"lineBreak":true},{"text":"wahimba simo kuulongozi wangu,","poem":1},{"lineBreak":true},{"text":"lakini wadumbukila mgati yake.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gweye Imulungu moyo wangu ugangamala,","poem":1},{"lineBreak":true},{"text":"ona, moyo wangu ugangamala,","poem":1},{"lineBreak":true},{"text":"nokwimba,","poem":1},{"lineBreak":true},{"text":"nokwimba lwila.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lamuka gweye loho yangu,","poem":1},{"lineBreak":true},{"text":"lamuka gweye bango na kilimba,","poem":1},{"lineBreak":true},{"text":"noilamusa imitondo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nokushukulu gweye, Mndewa hagati ha iwanhu wose,","poem":1},{"lineBreak":true},{"text":"hagati ya iwanhu wa isi zose nokwimba nhogolwa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kwavija unogelo wako hawishaga okwenela mbaka kuulanga,","poem":1},{"lineBreak":true},{"text":"na kutamanilwa kwako mbaka mmawingu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gweye Imulungu, utogolwe uchanha kuulanga,","poem":1},{"lineBreak":true},{"text":"na isi yose imemezwe ukulu wako.","poem":1}]}],"footnotes":[{"noteId":7,"caller":"+","text":"Lola kitabu cha 1 Samweli 24.","reference":{"chapter":57,"verse":0}}]},"thisChapterLink":"/api/kdc_pbt/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}