{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":58,"content":[{"type":"heading","content":["ZABULI YA 58"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi. Kwa kilanja, yatumie modeli wa, “Sikuubanange!”)"]},{"type":"verse","number":1,"content":[{"text":"Mweye iwatawala, vino molonga kwa haki?","poem":1},{"lineBreak":true},{"text":"Vino motagusa viilondigwa hagati ya iwanhu?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bule! Mmizoyo yenu mogelegeza gehile,","poem":1},{"lineBreak":true},{"text":"kwa makono genu mogala gehile mwiisi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Wanhu wehile wainega tangu kuleligwa kwao.","poem":1},{"lineBreak":true},{"text":"Tangu mmunda wapotela na olonga uvizi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sumu yao kamba sumu ya zoka,","poem":1},{"lineBreak":true},{"text":"kamba muyombo yasilile magwiti gake,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ayo hohulika sauti ya mganga yolagula,","poem":1},{"lineBreak":true},{"text":"hata mganga yolagula kwa kutowa nyanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Gweye Imulungu ibene imizino mmilomo yao,","poem":1},{"lineBreak":true},{"text":"gweye, Mndewa Imulungu uibene misaya ya simba.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Waleke wasegele kamba mazi gokilima himahima,","poem":1},{"lineBreak":true},{"text":"wahakwega upinde misale yao iwe dugi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kamba kola difile,","poem":1},{"lineBreak":true},{"text":"kamba king'hele yaleligwe yafile sikuwajone zuwa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nongo zenu hazinapata moto kwa ngodi za miba,","poem":1},{"lineBreak":true},{"text":"mibisi hebu inyalile awo okuwa wasegeswa wose.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Wene haki odeng'helela wahawona wehile obwezelwa,","poem":1},{"lineBreak":true},{"text":"na oibojoga damu ya iwanhu wehile.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Avo iwanhu olonga, “Wene haki wana nhunza,","poem":1},{"lineBreak":true},{"text":"kweli kauko Imulungu yoitagusa isi.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}