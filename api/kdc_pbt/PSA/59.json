{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":59,"content":[{"type":"heading","content":["ZABULI YA 59"]},{"type":"hebrew_subtitle","content":["(Kwa kilanja, yatumie modeli wa, “Sikuubanange!” Zabuli ya Daudi mbuli ya kipindi Sauli viyatumile wanhu wampelembe ili wamkome.)",{"noteId":8}]},{"type":"verse","number":1,"content":[{"text":"Gweye Imulungu unihonye mmakono ga iwanhu onihila,","poem":1},{"lineBreak":true},{"text":"unikalize kulawa kwa awo onivamila.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Unikombole kulawa kwa awo otenda gehile,","poem":1},{"lineBreak":true},{"text":"na unikombole kulawa kwa awo wetaga damu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Lola, oifisa olonda kunikoma,","poem":1},{"lineBreak":true},{"text":"iwanhu wasede ogala migomvi kumwangu,","poem":1},{"lineBreak":true},{"text":"hamoja niye sitendile nzambi hebu gehile, go Mndewa Imulungu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Niye sitendile dihile ila hewo waitanda kunivamila.","poem":1},{"lineBreak":true},{"text":"Go Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"wize unitaze ulole sambi vinili.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gweye, Mndewa Imulungu kuna udahi wose.","poem":1},{"lineBreak":true},{"text":"Winuke uwakoboze iwanhu wa isi zose,","poem":1},{"lineBreak":true},{"text":"sikuumuleke mgima hata imoja hagati ya awo otenda gehile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kila ichungulo obwela,","poem":1},{"lineBreak":true},{"text":"obwaka kamba umbwa,","poem":1},{"lineBreak":true},{"text":"na ozunguluka mgati ya dibuga.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Galole gaja gowotema kulawa mmilomo yao,","poem":1},{"lineBreak":true},{"text":"otema misime inoligwe mmilimi yao.","poem":1},{"lineBreak":true},{"text":"Na hewo olonga, “Nani yonda yatuhulike?”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lakini gweye, Mndewa Imulungu kowaseka,","poem":1},{"lineBreak":true},{"text":"kowabezeli iwanhu wa isi zose.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gweye kwa nguvu yangu nokulola gweye,","poem":1},{"lineBreak":true},{"text":"gweye Imulungu ayo ngome yangu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Imulungu wangu kwa unogelwa wake hawishaga konizila,","poem":1},{"lineBreak":true},{"text":"Imulungu konitenda niwalole iwanhu onihila viwohumwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Sikuuwakome,","poem":1},{"lineBreak":true},{"text":"buleavo iwanhu zangu oisemwa vuuwakoboze.","poem":1},{"lineBreak":true},{"text":"Kwa udahi wako uwatende tanga nzulule na uwabwanhe hasi,","poem":1},{"lineBreak":true},{"text":"gweye Mndewa ayo ngao yetu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mbuli ya nzambi za milomo yao,","poem":1},{"lineBreak":true},{"text":"na kwa mbuli za milomo yao,","poem":1},{"lineBreak":true},{"text":"waleke wagogwe kwa kuitapa kwao.","poem":1},{"lineBreak":true},{"text":"Mbuli ya makungu na uvizi wao,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"uwasakaze kwa ng'hasiliki yako,","poem":1},{"lineBreak":true},{"text":"uwasakaze mbaka wasegesigwe,","poem":1},{"lineBreak":true},{"text":"ili wanhu watange kamba Imulungu ayo yotawala kwa Yakobo,","poem":1},{"lineBreak":true},{"text":"na kotawala mbaka kuihelela isi yose.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kila ichungulo obwela,","poem":1},{"lineBreak":true},{"text":"obwaka kamba umbwa,","poem":1},{"lineBreak":true},{"text":"na ozunguluka mgati ya dibuga.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Obemhela kuzahila ndiya,","poem":1},{"lineBreak":true},{"text":"kamba hawegute owasilila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Lakini niye nokwimba mbuli ya nguvu zako.","poem":1},{"lineBreak":true},{"text":"Nokwimba kwa sauti imitondo kwa unogelwa wako hawishaga.","poem":1},{"lineBreak":true},{"text":"Kwavija kumwangu niye gweye kwa ngome yangu,","poem":1},{"lineBreak":true},{"text":"na hanhu ha kukimbilila mwiisiku ya magazo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gweye kwa nguvu zangu,","poem":1},{"lineBreak":true},{"text":"niye nokwimbila kwa deng'ho,","poem":1},{"lineBreak":true},{"text":"kwavija Imulungu ayo ngome yangu,","poem":1},{"lineBreak":true},{"text":"Imulungu umemile unogelwa hawishaga.","poem":1}]}],"footnotes":[{"noteId":8,"caller":"+","text":"Lola kitabu cha 1 Samweli 19:11-17.","reference":{"chapter":59,"verse":0}}]},"thisChapterLink":"/api/kdc_pbt/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}