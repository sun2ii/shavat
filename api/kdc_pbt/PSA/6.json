{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":6,"content":[{"type":"heading","content":["ZABULI YA 6"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi. Kwa kilanja, yatumie nyuzi za bango na modeli wa Sheminiti.)"]},{"type":"verse","number":1,"content":[{"text":"Go Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"sikuunikomhokele kwa ng'hasiliki yako,","poem":1},{"lineBreak":true},{"text":"sikuunikoboze kwa kwihilwa kwako.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Unyonele bazi gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kwavija nonyolila,","poem":1},{"lineBreak":true},{"text":"Unihonye gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kwavija nogaya mbaka mmizege.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nogazika ng'hani mmoyo wangu,","poem":1},{"lineBreak":true},{"text":"gweye Mndewa Imulungu kokawa mbaka lini?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Go Mndewa Imulungu ubwele,","poem":1},{"lineBreak":true},{"text":"unihoze moyo wangu,","poem":1},{"lineBreak":true},{"text":"unikombole mbuli ya unogelo wako hawishaga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Haduhu munhu yokukumbuka gweye akuno kafa.","poem":1},{"lineBreak":true},{"text":"Nani yodaha kukutogola yahawa ako kuzimu?","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nidonha kwa kugula kwangu,","poem":1},{"lineBreak":true},{"text":"kila ikilo noludodeza lusazi lwangu kwa kulila,","poem":1},{"lineBreak":true},{"text":"noudodeza mkeka wangu kwa mahozi gangu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Meso gangu ganangika kwa usungu,","poem":1},{"lineBreak":true},{"text":"nodonha mbuli ya awo onihila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Segeleni kumwangu, mweye msang'hana gehile,","poem":1},{"lineBreak":true},{"text":"kwavija Mndewa Imulungu kahulika kililo changu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu kahulika kililo changu,","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu katogola kupula kwangu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Iwanhu wose onihila wagwe kinyala na wapate magazo,","poem":1},{"lineBreak":true},{"text":"wabwele kuchugu himahima kwa kinyala.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}