{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"heading","content":["ZABULI YA 61"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi. Kwa kilanja, yatumie nyuzi za bango.)"]},{"type":"verse","number":1,"content":[{"text":"Gweye Imulungu utegeleze kililo changu,","poem":1},{"lineBreak":true},{"text":"uhulike kupula kwangu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kulawa kuuhelelo wa isi nokukema gweye,","poem":1},{"lineBreak":true},{"text":"moyo wangu uhasinduka,","poem":1},{"lineBreak":true},{"text":"nilongoze hanhu heli na tindiwalo kamba kudibwe dili tali kubanza niye,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"kwavija gweye ayo kimbililo jangu,","poem":1},{"lineBreak":true},{"text":"gweye ayo ngome yangu na kowagomesa iwanhu onihila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Leka nikale mkibanda chako milele.","poem":1},{"lineBreak":true},{"text":"Leka nikimbilile hana imbeho ya mabawa gako.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kwavija gweye Imulungu kuhulika kuiduwila kwangu,","poem":1},{"lineBreak":true},{"text":"kunigwaa uhazi hamoja na awo okudumba gweye.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Umgwelele mndewa siku nyingi,","poem":1},{"lineBreak":true},{"text":"miyaka yake iwe kwa ulelo mwingi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yatawale milele kuulongozi wako gweye Imulungu.","poem":1},{"lineBreak":true},{"text":"Lagiza unogelo wako hawishaga na kutamanilwa kwako vimkalize.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Avo niye nodimbila nhogolwa twaga jako,","poem":1},{"lineBreak":true},{"text":"nogavikiza gaja ganiiduwile kila siku.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}