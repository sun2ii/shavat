{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":62,"content":[{"type":"heading","content":["ZABULI YA 62"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi. Kwa kilanja, yatumie modeli wa Yedutuni.)"]},{"type":"verse","number":1,"content":[{"text":"Kwa Imulungu yaiyeka loho yangu yobwihila,","poem":1},{"lineBreak":true},{"text":"ukombola wangu olawa kumwake.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Heyo yaiyeka ayo dibwe jangu na ukombola wangu,","poem":1},{"lineBreak":true},{"text":"heyo ayo ngome yangu, niye sigwaya bule.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mbaka lini monivamila?","poem":1},{"lineBreak":true},{"text":"Mbaka lini mweye mose monibwanha hasi,","poem":1},{"lineBreak":true},{"text":"kamba kiwambaza kisonga kubomoka?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Waitanda kunilagaza kulawa hanhu ha heshima,","poem":1},{"lineBreak":true},{"text":"odeng'helela uvizi.","poem":1},{"lineBreak":true},{"text":"Kwa imilomo yao otambika,","poem":1},{"lineBreak":true},{"text":"lakini mgati mmizoyo yao oduwila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kwa Imulungu yaiyeka loho yangu yobwihila,","poem":1},{"lineBreak":true},{"text":"tamanilo jangu dolawa kumwake.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Heyo ayo dibwe jangu na ukombola wangu,","poem":1},{"lineBreak":true},{"text":"heyo ayo ngome yangu niye sigwaya bule.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ukombola wangu na ukulu volawa kwa Imulungu,","poem":1},{"lineBreak":true},{"text":"heyo ayo dibwe da nguvu na kimbililo jangu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mweye wanhu, mtamanileni Imulungu siku zose,","poem":1},{"lineBreak":true},{"text":"Ifunhuleni mizoyo yenu kumwake heyo,","poem":1},{"lineBreak":true},{"text":"Imulungu ayo kimbililo jetu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Iwanhu wose kamba mhumuzi,","poem":1},{"lineBreak":true},{"text":"wose wakulu kwa wadodo hawafaya kinhu.","poem":1},{"lineBreak":true},{"text":"Uhawapima hawavika kilo imoja,","poem":1},{"lineBreak":true},{"text":"hewo wose wabewe kubanza mhumuzi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sikuutamanile uzulumati,","poem":1},{"lineBreak":true},{"text":"hebu kwika tamanilo mna ivinhu va ubavi,","poem":1},{"lineBreak":true},{"text":"utajili wako wahongezeka sikuuwike mmoyo wako.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mwanza umoja Imulungu kalonga,","poem":1},{"lineBreak":true},{"text":"miyanza mibili niihulika mbuli ino,","poem":1},{"lineBreak":true},{"text":"kamba udahi wa Imulungu,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"na unogelwa hawishaga wa Mndewa,","poem":1},{"lineBreak":true},{"text":"na heyo komuliha kila munhu kamba viyasang'hane.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}