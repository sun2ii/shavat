{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"heading","content":["ZABULI YA 63"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi mbuli ya kipindi viyakalile kuluwala lwa Yuda.)"]},{"type":"verse","number":1,"content":[{"text":"Go Imulungu, gweye kwa Imulungu wangu,","poem":1},{"lineBreak":true},{"text":"na niye nokuzahila kwa moyo wose.","poem":1},{"lineBreak":true},{"text":"Moyo wangu okusulukila kamba munhu mwene ng'hilu,","poem":1},{"lineBreak":true},{"text":"nina ng'hilu kamba isi inyalile ilibule mazi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nikona hanhu hako hong'ala,","poem":1},{"lineBreak":true},{"text":"nizona nguvu zako na ukulu wako.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kwavija unogelo wako hawishaga unoga kubanza ugima,","poem":1},{"lineBreak":true},{"text":"na niye nokutogola kwa mulomo wangu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nokutogola ugima wangu wose,","poem":1},{"lineBreak":true},{"text":"nokwinula makono gangu na nokupula.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Moyo wangu odeng'helela kamba kuja ndiya inogile ng'hani,","poem":1},{"lineBreak":true},{"text":"kwa deng'ho nokwimbila nhogolwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mulusazi lwangu nokukumbuka,","poem":1},{"lineBreak":true},{"text":"kilo chose nokugelegeza.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kwavija gweye konitaza,","poem":1},{"lineBreak":true},{"text":"mmbeho ya mabawa gako nokwimba kwa deng'ho.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Moyo wangu okugoga gweye,","poem":1},{"lineBreak":true},{"text":"mkono wako wa ukudila onidahiza.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Lakini wose olonda kunikoma niye,","poem":1},{"lineBreak":true},{"text":"odumbukila hasi mdisimo da ifa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Okomigwa kwa sime,","poem":1},{"lineBreak":true},{"text":"okuwa ndiya ya mbagile.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lakini mndewa kodeng'helela kwa Imulungu.","poem":1},{"lineBreak":true},{"text":"Wose oiduwila kwa twaga da Imulungu okwinuligwa,","poem":1},{"lineBreak":true},{"text":"kwavija milomo ya wavizi yogubikwa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}