{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":64,"content":[{"type":"heading","content":["ZABULI YA 64"]},{"type":"hebrew_subtitle","content":["(Kwa kilanja, Zabuli ya Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Unhegeleze gweye Imulungu, kuiyalala kwangu,","poem":1},{"lineBreak":true},{"text":"ukalize ugima wangu kwa awo onihila.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Unifise kulawa kwa awo wehile ogelegeza vihile,","poem":1},{"lineBreak":true},{"text":"unike kutali na mting'hano wa iwanhu otenda gehile.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Onola milimi yao kamba sime,","poem":1},{"lineBreak":true},{"text":"olava mbuli za usede kamba misale.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kulawa kuko kuwaifisile wamvamila munhu yelibule kitala,","poem":1},{"lineBreak":true},{"text":"omvamila kwa kusinhukiza bila kudumba.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Opanga kinhu kimoja kwa magesa gao gehile,","poem":1},{"lineBreak":true},{"text":"oilumba hanhu ha kufisa mitego yao.","poem":1},{"lineBreak":true},{"text":"Ogelegeza, “Haduhu yodaha kuyona.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Otenda njama zao na kulonga,","poem":1},{"lineBreak":true},{"text":"“Tumambukiza mpango uno, nani yojuwa kinhu kino?”","poem":1},{"lineBreak":true},{"text":"Mipango ya kifiso ifisigwa mmoyo wa munhu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lakini Imulungu kowatowa kwa misale,","poem":1},{"lineBreak":true},{"text":"na bahaja olagazwa hasi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kowabananga kwa mbuli zao wenyego,","poem":1},{"lineBreak":true},{"text":"wose onda wawone ominula milomo yao kwa kuwabezeli.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Aho iwanhu wose odumba,","poem":1},{"lineBreak":true},{"text":"ogasimulila gayatendile Imulungu,","poem":1},{"lineBreak":true},{"text":"na ogagelegeza gaja gayatendile.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wanhu wanogile wadeng'helele kwa Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"na wamkimbilile heyo.","poem":1},{"lineBreak":true},{"text":"Wanhu wose wanogile omtogola heyo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}