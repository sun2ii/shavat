{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":65,"content":[{"type":"heading","content":["ZABULI YA 65"]},{"type":"hebrew_subtitle","content":["(Kwa kilanja, Zabuli ya Daudi na lwila.)"]},{"type":"verse","number":1,"content":[{"text":"Go Imulungu, gweye kofaya kutogoligwa ako Sayuni,","poem":1},{"lineBreak":true},{"text":"kumwako gweye iwanhu ogavikiza gaja gawalongile.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gweye widikaga kupula,","poem":1},{"lineBreak":true},{"text":"avo wanhu wose okwizila gweye.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nzambi nyingi zahatugoga,","poem":1},{"lineBreak":true},{"text":"gweye ayo ugelaga kumgongo gehile getu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kamweda imunhu yumsagule na kumgala behi na gweye,","poem":1},{"lineBreak":true},{"text":"ili yakale kuuluwa lwako.","poem":1},{"lineBreak":true},{"text":"Siye toshiba ganogile ga ng'anda yako,","poem":1},{"lineBreak":true},{"text":"ganogile geli mng'anda yako ing'ala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kwa unzonza kotwidika kwa haki,","poem":1},{"lineBreak":true},{"text":"gweye Imulungu wa ukombola wetu,","poem":1},{"lineBreak":true},{"text":"gweye ayo tamanilo da wanhu wose okala kuihelela isi,","poem":1},{"lineBreak":true},{"text":"na wanhu okala umwambu wa bahali.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gweye ulumbile vigongo kwa udahi wako,","poem":1},{"lineBreak":true},{"text":"gweye kuna nguvu zose,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"gweye uzitendaga ng'humbi za bahali zinyamale,","poem":1},{"lineBreak":true},{"text":"na kubuma kwa ng'humbi na ndwagi za iwanhu wa isi zose.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wose okala kuihelela isi okanganya vilaguso vako.","poem":1},{"lineBreak":true},{"text":"Kotenda isi kudilawila zuwa na kudihongela zuwa ideng'he.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Koitembelela isi na koigelela mazi,","poem":1},{"lineBreak":true},{"text":"koitenda imwede,","poem":1},{"lineBreak":true},{"text":"vizanda va Imulungu vimema mazi,","poem":1},{"lineBreak":true},{"text":"kowagwelela ndiya iwanhu,","poem":1},{"lineBreak":true},{"text":"kwavija gweye vivo ulondile.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kuidodeza miloka yake,","poem":1},{"lineBreak":true},{"text":"na kugatelebusa matuta gake,","poem":1},{"lineBreak":true},{"text":"kovitelebusa kwa luwaga,","poem":1},{"lineBreak":true},{"text":"na kuitenda iminoga imwede.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kwavija kuimwedeza isi, kuna ndiya nyingi mumsimu wa kusenga,","poem":1},{"lineBreak":true},{"text":"kokose kuucholile kuna ndiya nyingi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Luwala lumema mijani ya kudimila fugo,","poem":1},{"lineBreak":true},{"text":"vigongo vimema deng'ho.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hanhu ha kulugongo hamema fugo,","poem":1},{"lineBreak":true},{"text":"makonde ganogezwa kwa ndiya,","poem":1},{"lineBreak":true},{"text":"vose vokemelela na kwimba kwa deng'ho.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}