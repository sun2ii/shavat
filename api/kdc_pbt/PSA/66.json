{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":66,"content":[{"type":"heading","content":["ZABULI YA 66"]},{"type":"hebrew_subtitle","content":["(Kwa kilanja, lwila na Zabuli.)"]},{"type":"verse","number":1,"content":[{"text":"Mweye wanhu wa isi yose guteni nyangi za deng'ho kwa Imulungu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ditogoleni twaga jake,","poem":1},{"lineBreak":true},{"text":"mumgwee heyo nhogolwa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mulongeleni Imulungu, “Sang'hano zako za unzonza!","poem":1},{"lineBreak":true},{"text":"Nguvu zako zibanza ng'hani,","poem":1},{"lineBreak":true},{"text":"mbaka iwanhu okwihila oidulika na kudumba.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Iwanhu wa isi yose okutambikila gweye,","poem":1},{"lineBreak":true},{"text":"na okwimbila nhogolwa na oditogola twaga jako.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Izoni mulole gaja gayatendile Imulungu.","poem":1},{"lineBreak":true},{"text":"Sang'hano zake za unzonza kwa iwanhu wa mwiisi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kahindula bahali iwa isi inyalile,","poem":1},{"lineBreak":true},{"text":"waloka kwa magulu mgamazi.","poem":1},{"lineBreak":true},{"text":"Avo, siye tomdeng'helela heyo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Heyo kotawala kwa udahi wake milele,","poem":1},{"lineBreak":true},{"text":"meso gake kowalola iwanhu wa mwiisi,","poem":1},{"lineBreak":true},{"text":"iwanhu omulema sambi wenuke.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mtogoleni Imulungu wetu mweye iwanhu,","poem":1},{"lineBreak":true},{"text":"longeni sauti ya nhogolwa zake na wayagwe wahulike.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Heyo katutenda tuwe wagima,","poem":1},{"lineBreak":true},{"text":"na hagalekile magulu getu gatelebuke.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kwavija gweye Imulungu kutugeza,","poem":1},{"lineBreak":true},{"text":"kutusunha kamba shaba viisunhigwa mmoto.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kutuleka tugogwe muulwavu,","poem":1},{"lineBreak":true},{"text":"kutupapiza mizigo mikulu mmigongo yetu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kuwaleka iwanhu watubojoge,","poem":1},{"lineBreak":true},{"text":"tugenda mmoto na mmazi,","poem":1},{"lineBreak":true},{"text":"lakini kutugala mwiisi ya kumweda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nokwiza mng'anda yako na nhosa za kusoma moto,","poem":1},{"lineBreak":true},{"text":"nogavikiza gaja ganiiduwile kumwako.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Gaja ganongile kwa mulomo wangu,","poem":1},{"lineBreak":true},{"text":"na kuiduwila ving'halile mmagazo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nokulavila nhosa za kusoma moto za wanyama wanenehe,","poem":1},{"lineBreak":true},{"text":"na nhosa za kusoma moto za ng'hondolo mbigalo,","poem":1},{"lineBreak":true},{"text":"nokulavila nhosa za ng'ombe na mbuzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mwize mtegeleze mweye mose mumdumba Imulungu,","poem":1},{"lineBreak":true},{"text":"nowalongela gaja gayatendile muugima wangu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nimulilila kwa mulomo wangu,","poem":1},{"lineBreak":true},{"text":"na nhogolwa zikala mululimi lwangu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Maza nifisile gehile mmoyo wangu,","poem":1},{"lineBreak":true},{"text":"Mndewa sambi yanitegeleze.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Lakini Imulungu kanihulika,","poem":1},{"lineBreak":true},{"text":"ona, kanitegeleza vinimpulile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Imulungu yatogolwe,","poem":1},{"lineBreak":true},{"text":"kwavija handemele bule vinimpulile,","poem":1},{"lineBreak":true},{"text":"hebu kusegesa unogelo wake hawishaga kumwangu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}