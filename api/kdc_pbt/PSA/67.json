rse","number":5,"content":[{"lineBreak":true},{"text":"Leka iwanhu wakutogole gweye Imulungu,","poem":1},{"lineBreak":true},{"text":"leka iwanhu wakutogole gweye.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Isi ilela ng'hani ndiya,","poem":1},{"lineBreak":true},{"text":"leka Imulungu, Imulungu wetu yatutende tumwede.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Imulungu yatutende tumwede,","poem":1},{"lineBreak":true},{"text":"na wanhu wose wa mwiisi wamdumbe heyo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}