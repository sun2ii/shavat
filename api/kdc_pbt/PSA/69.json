{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":69,"content":[{"type":"heading","content":["ZABULI YA 69"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi. Kwa kilanja, yatumie modeli ya lwila lwa Besa.)"]},{"type":"verse","number":1,"content":[{"text":"Gweye Imulungu unikombole,","poem":1},{"lineBreak":true},{"text":"kwavija mazi ganivikila msingo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nodidimila mnhope,","poem":1},{"lineBreak":true},{"text":"hanhu sidaha kwima wima,","poem":1},{"lineBreak":true},{"text":"nivika mmazi mengi,","poem":1},{"lineBreak":true},{"text":"sika kulu dinigubika.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nidonha kukulilila,","poem":1},{"lineBreak":true},{"text":"tundu melo jangu dinyala.","poem":1},{"lineBreak":true},{"text":"Meso gangu gavulala,","poem":1},{"lineBreak":true},{"text":"kwa kukubeta gweye Imulungu wangu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Iwanhu onihila bila kilamuso wengi kubanza mvili zangu,","poem":1},{"lineBreak":true},{"text":"wengi onivamila kwa mbuli za uvizi.","poem":1},{"lineBreak":true},{"text":"Nolondigwa kubweza kinhu sikibile.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gweye Imulungu, gweye kojuwa ubozi wangu,","poem":1},{"lineBreak":true},{"text":"nzambi zangu hazifisika kumwako.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wose okutamanila gweye Mkulu Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"sikuwagwe kinyala mbuli yangu.","poem":1},{"lineBreak":true},{"text":"Mndewa uli na udahi wose,","poem":1},{"lineBreak":true},{"text":"wose okuzahila gweye Imulungu wa Izilaeli,","poem":1},{"lineBreak":true},{"text":"sikuwagwe kinyala mbuli yangu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kwavija nisitamili kubezeligwa mbuli yako,","poem":1},{"lineBreak":true},{"text":"kinyala kigubika kihanga changu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Niwa mgeni kwa ndugu zangu,","poem":1},{"lineBreak":true},{"text":"niwa mgeni kwa wanage mamangu mwenyego.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kwavija unogelwa wangu kwa ng'anda yako osoma mgati mmwangu kamba moto,","poem":1},{"lineBreak":true},{"text":"maligo ga awo okuliga ganizila.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nahalila na kufunga,","poem":1},{"lineBreak":true},{"text":"hewo onibezeli habali nhendile vivo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Vinivalile viwalo va gunia kwa kuiyalala,","poem":1},{"lineBreak":true},{"text":"nikala kinhu cha kusekwa na iwanhu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Waja okala mmulango onigeweza,","poem":1},{"lineBreak":true},{"text":"iwanhu wakoligwe otunga nyila mbuli yangu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Lakini niye nokupula gweye Mndewa Imulungu.","poem":1},{"lineBreak":true},{"text":"Mkipindi kikunogeza, muunogelo wako hawishaga mkulu,","poem":1},{"lineBreak":true},{"text":"gweye Imulungu unidike kwa ukombola wako wa kweli.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Unitaze sikuunileke nididimile mnhope,","poem":1},{"lineBreak":true},{"text":"nilave mmakono ga awo onihila,","poem":1},{"lineBreak":true},{"text":"ndave kulawa mmazi mengi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Sikuundeke nzoligwe na sika kulu,","poem":1},{"lineBreak":true},{"text":"hebu nididimile mmazi,","poem":1},{"lineBreak":true},{"text":"hebu nimezwe na ifa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Gweye Mndewa Imulungu unidike,","poem":1},{"lineBreak":true},{"text":"kwavija unogelo wako hawishaga mkulu,","poem":1},{"lineBreak":true},{"text":"unihindukile kamba bazi jako vidili.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Sikuufise kihanga chako kwa msang'hanaji wako,","poem":1},{"lineBreak":true},{"text":"ulopole kunidika kwavija nammagazo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wize behi na unikombole,","poem":1},{"lineBreak":true},{"text":"unigombole kulawa kwa iwanhu onihila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Gweye kotanga vindigigwa,","poem":1},{"lineBreak":true},{"text":"kotanga iwanhu viwongela kinyala na kunibezeli,","poem":1},{"lineBreak":true},{"text":"wose onihila gweye kowatanga.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Awo onibezeli wanibena nguvu na niye nifa umoyo,","poem":1},{"lineBreak":true},{"text":"nozahila imunhu wa kunyonela bazi,","poem":1},{"lineBreak":true},{"text":"lakini simpatile yoyose wa kunihoza.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wanikila sumu mna ndiya yangu,","poem":1},{"lineBreak":true},{"text":"na ving'halile na ng'hilu wangwaa divai isasile.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Imeza itandigwe kuulongozi wa hewo iwe mtego,","poem":1},{"lineBreak":true},{"text":"na wagogwe mzinyimwilinyimwili zao.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Meso gao gageligwe ziza sikuwalole,","poem":1},{"lineBreak":true},{"text":"na migongo yao iveduke siku zose.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Uwakutulile ng'hasiliki yako,","poem":1},{"lineBreak":true},{"text":"kugevuzika kwako ng'hani kuwapate.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Kae yao iwe vihame,","poem":1},{"lineBreak":true},{"text":"sikuyakale munhu yoyose mvibanda vao.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Kwavija owadununza awo uwadununze,","poem":1},{"lineBreak":true},{"text":"na olonga mbuli ya usungu wa awo uwalumize.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Walihe gehile kwa gehile gao,","poem":1},{"lineBreak":true},{"text":"sikuuwaleke wailumbe muukombola wako.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Wasegeswe mkitabu cha wagima,","poem":1},{"lineBreak":true},{"text":"sikuwandikigwe mumsafa wa matwaga ga iwanhu otenda ganogile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Lakini niye nogaya na nina usungu,","poem":1},{"lineBreak":true},{"text":"gweye Imulungu unikombole na unike goya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Noditogola twaga da Imulungu kwa lwila,","poem":1},{"lineBreak":true},{"text":"na nomtogola kwa kumgwaa nhogolwa.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Mbuli ayo yomnogeza Mndewa Imulungu kubanza ng'ombe mbigalo,","poem":1},{"lineBreak":true},{"text":"kubanza ng'ombe mgima mgima.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Wakiwa ogona gago na kudeng'helela,","poem":1},{"lineBreak":true},{"text":"mweye mumzahila Imulungu mizoyo yenu ipate nguvu.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu kowategeleza ngaengae,","poem":1},{"lineBreak":true},{"text":"hawasemwa wanhu zake wafungigwe mkifungo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Ulanga na isi vimtogole,","poem":1},{"lineBreak":true},{"text":"bahali na vose vikalaga mumo.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Kwavija Imulungu kodikombola buga da Sayuni,","poem":1},{"lineBreak":true},{"text":"na kogazenga kabili mabuga ga Yuda.","poem":1},{"lineBreak":true},{"text":"Wanhu zake okala mumo na kutawala.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Wana wa iwasang'hanaji wa Imulungu odihazi,","poem":1},{"lineBreak":true},{"text":"na iwanhu wose odinogela twaga jake okala mumo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}