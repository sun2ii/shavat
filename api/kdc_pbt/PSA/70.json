{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"heading","content":["ZABULI YA 70"]},{"type":"hebrew_subtitle","content":["(Kwa kilanja, Zabuli ya Daudi kopula yakumbukigwe na Imulungu.)"]},{"type":"verse","number":1,"content":[{"text":"Gweye Imulungu ulopole kunikombola,","poem":1},{"lineBreak":true},{"text":"gweye Mndewa Imulungu wize unitaze.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wose olonda ugima wangu,","poem":1},{"lineBreak":true},{"text":"wagwe kinyala na wapate lukwale,","poem":1},{"lineBreak":true},{"text":"wose olonda gehile gamhate,","poem":1},{"lineBreak":true},{"text":"wabwele kuchugu na wagwe kinyala.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Waja onibeza, “Amweye! Amweye!”","poem":1},{"lineBreak":true},{"text":"wabwele kuchugu mbuli ya kinyala chao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lakini wose okuzahila gweye wadeng'helele,","poem":1},{"lineBreak":true},{"text":"na kusekelela kumwako.","poem":1},{"lineBreak":true},{"text":"Wose ounogela ukombola wako walonge,","poem":1},{"lineBreak":true},{"text":"“Imulungu yatogolwe!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lakini niye na mkiwa na ngaengae,","poem":1},{"lineBreak":true},{"text":"gweye Imulungu wize himahima kumwangu.","poem":1},{"lineBreak":true},{"text":"Gweye ayo unitazaga na mkombola wangu,","poem":1},{"lineBreak":true},{"text":"gweye Mndewa Imulungu, sikuukawe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}