{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":72,"content":[{"type":"heading","content":["ZABULI YA 72"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Sulemani.)"]},{"type":"verse","number":1,"content":[{"text":"Gweye Imulungu, mgwelele nzewele mndewa yataguse kwa haki yako,","poem":1},{"lineBreak":true},{"text":"mwana wa mndewa kwa haki yako.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kowatagusa wanhu wako kwa haki,","poem":1},{"lineBreak":true},{"text":"iwanhu wako wakiwa kwa haki.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Vigongo vogala ukumweda kwa iwanhu,","poem":1},{"lineBreak":true},{"text":"vigongo vimeme matunda ga haki.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kowagombela oneligwe mna iwanhu,","poem":1},{"lineBreak":true},{"text":"kowakombola wana wa ngaengae,","poem":1},{"lineBreak":true},{"text":"wahonde iwanhu owadununza wayagwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kosigala kamba zuwa na mbalamwezi ulelo wose.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kokuwa kamba mvula itowa mumgunda ulimigwe,","poem":1},{"lineBreak":true},{"text":"kamba luwaga lutowa mwiisi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kipindi chake wene haki omweda,","poem":1},{"lineBreak":true},{"text":"ukumweda kokuwa kuko mbaka mbalamwezi yahafa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kotawala kulawa bahali mbaka bahali,","poem":1},{"lineBreak":true},{"text":"na kulawa kuulwanda mbaka kuihelela isi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Makabila ga kuluwala omfugamila,","poem":1},{"lineBreak":true},{"text":"na iwanhu omwihila ohumwa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wandewa wa Talishishi na iwandewa wa mhwani omgalila nhosa,","poem":1},{"lineBreak":true},{"text":"wandewa wa Sheba na Seba omgalila nhunza.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wandewa wose omfugamila,","poem":1},{"lineBreak":true},{"text":"na iwanhu wa isi zose omsang'hanila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Heyo komuhonya mkiwa yomulilila,","poem":1},{"lineBreak":true},{"text":"imunhu yoneligwe yelibule munhu wa kumtaza.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kowonela bazi wakiwa na ngaengae,","poem":1},{"lineBreak":true},{"text":"na kowakombola welibule kinhu kulawa mkifo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kowakombola sikuwoneligwe na iwasede,","poem":1},{"lineBreak":true},{"text":"kwavija ugima wao ubanza kunoga kumwake.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Heyo yakale mgima,","poem":1},{"lineBreak":true},{"text":"na yabokele zahabu za Sheba,","poem":1},{"lineBreak":true},{"text":"wanhu wampulile kwa Imulungu siku zose,","poem":1},{"lineBreak":true},{"text":"na yamwede imisi yose.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ndiya imeme mwiisi yose,","poem":1},{"lineBreak":true},{"text":"kunhembeti ya vigongo kumeme.","poem":1},{"lineBreak":true},{"text":"Kuwe na ndiya kamba muhulo wa Lebanoni,","poem":1},{"lineBreak":true},{"text":"wanhu mmabuga wamwede kamba mijani ya kubonde.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Twaga jake disigale milele,","poem":1},{"lineBreak":true},{"text":"na disigale kamba zuwa.","poem":1},{"lineBreak":true},{"text":"Iwanhu wa isi zose wamwede kubitila heyo,","poem":1},{"lineBreak":true},{"text":"na hewo wamkeme kamweda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Mndewa Imulungu, Imulungu wa Izilaeli yatogolwe,","poem":1},{"lineBreak":true},{"text":"heyo yaiyeka yotenda mbuli za unzonza.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Twaga jake kulu ditogolwe milele,","poem":1},{"lineBreak":true},{"text":"isi yose imeme ukulu wake. Ona, Ona.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Uno awo uhelelo wa kupula kwa Daudi, imwana wa Yese.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}