{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":73,"content":[{"type":"heading","content":["ZABULI YA 73"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Asafu.)"]},{"type":"verse","number":1,"content":[{"text":"Kweli Imulungu kanoga kwa iwanhu wa Izilaeli,","poem":1},{"lineBreak":true},{"text":"kwa iwanhu waja mizoyo yao inoga.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lakini kumwangu niye, migulu ikala yolonda kutelebuka,","poem":1},{"lineBreak":true},{"text":"mgulu wangu ulonda kutelebuka hanhu aho hanimile.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kwavija niwonela migongo iwanhu oitapa,","poem":1},{"lineBreak":true},{"text":"vinyonile ukumweda kwa iwanhu wehile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hewo hawapata magazo mbaka ifa yao,","poem":1},{"lineBreak":true},{"text":"ng'huli zao zineneha na zina nguvu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hawagaya kamba iwanhu wayagwe,","poem":1},{"lineBreak":true},{"text":"na hawapata magazo kamba viwopata iwanhu wayagwe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Avo kuitapa kwao kamba mkufu wao msingo,","poem":1},{"lineBreak":true},{"text":"kubezeli kamba kiwalo chao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gehile golawa mmizoyo yao ifile ganzi,","poem":1},{"lineBreak":true},{"text":"mipango yao ihile yolawa mmizoyo yao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Obezeli na kulonga kwa usede,","poem":1},{"lineBreak":true},{"text":"oitapa na olonda kuwadununza wayagwe.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Milomo yao yolonga gehile hata kwa ulanga,","poem":1},{"lineBreak":true},{"text":"na olonga kwa kuitapa kwa wanhu wayagwe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Avo iwanhu zao owahindukila,","poem":1},{"lineBreak":true},{"text":"na hawona kilozo chochose.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Olonga, “Imulungu kotangaze?","poem":1},{"lineBreak":true},{"text":"Vino heyo yeli Uchanha Ng'hani kotanga kinhu?”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Vino, vivo weli wene nzambi,","poem":1},{"lineBreak":true},{"text":"hawagelegeza kinhu siku zose okwengeza utajili.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nigaya bule kuwika moyo wangu unogile,","poem":1},{"lineBreak":true},{"text":"na kunawa makono gangu sikuniwe na kitala.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Imisi yose nigazwa,","poem":1},{"lineBreak":true},{"text":"nitagusigwa kila imitondo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Maza nilongile, “Nolonga vino,”","poem":1},{"lineBreak":true},{"text":"nahawahinduke wanago.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Vinigezile kugajuwa gose,","poem":1},{"lineBreak":true},{"text":"gakala ngaga kumwangu kugajuwa,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"mbaka viningile hanhu hong'ala ha Imulungu,","poem":1},{"lineBreak":true},{"text":"aho nijuwa uhelelo wao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kweli koweka hanhu hana lungwi,","poem":1},{"lineBreak":true},{"text":"kowabwanha hasi kwa ubananzi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Lola viwobanangwa himahima,","poem":1},{"lineBreak":true},{"text":"osegeswa kwa bwembwe.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kamba nzozi munhu viyolamuka,","poem":1},{"lineBreak":true},{"text":"vivo vuwinuka gweye Mndewa,","poem":1},{"lineBreak":true},{"text":"kowasegesa kamba nzozi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Moyo wangu vuugeligwe lusikisiki,","poem":1},{"lineBreak":true},{"text":"na loho yangu viigeligwe usungu,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"nikala mbozi na sijuwile kinhu,","poem":1},{"lineBreak":true},{"text":"nikala kamba ng'onyo kumwako.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Lakini nahamoja na gweye siku zose,","poem":1},{"lineBreak":true},{"text":"kunigoga mkono wangu wa ukudila.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Konilongoza kwa gaja goulonda,","poem":1},{"lineBreak":true},{"text":"abaho konibokela kwa ukulu wako.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Nani iyagwe inilinayo kuulanga ila gweye?","poem":1},{"lineBreak":true},{"text":"Mwiisi haduhu kinhu kinisulukila kubanza gweye.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Lukuli lwangu na moyo wangu vodaha kulemelwa,","poem":1},{"lineBreak":true},{"text":"ila Imulungu ayo nguvu ya moyo wangu na fungu jangu milele.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Wose okala kutali na gweye obanangwa,","poem":1},{"lineBreak":true},{"text":"kowabananga wose hawakutamanila gweye.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Kumwangu niye kukala behi na Imulungu kinhu kinogile,","poem":1},{"lineBreak":true},{"text":"nimtenda Mkulu Mndewa Imulungu kimbililo jangu,","poem":1},{"lineBreak":true},{"text":"nolonga gose gausang'hane.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}