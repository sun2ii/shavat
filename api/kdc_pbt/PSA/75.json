{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":75,"content":[{"type":"heading","content":["ZABULI YA 75"]},{"type":"hebrew_subtitle","content":["(Lwila na Zabuli ya Asafu. Kwa kilanja, yatumie modeli wa, “Sikuubanange.”)"]},{"type":"verse","number":1,"content":[{"text":"Gweye Imulungu, tokushukulu,","poem":1},{"lineBreak":true},{"text":"tokushukulu gweye kwavija twaga jako da behi,","poem":1},{"lineBreak":true},{"text":"wanhu osimulila mbuli zako za unzonza.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Imulungu kolonga, “Nosagula kipindi kinogile,","poem":1},{"lineBreak":true},{"text":"niye notagusa kwa haki.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kipindi isi yose na iwanhu okala mumo yahatigisika,","poem":1},{"lineBreak":true},{"text":"niye ayo nigogeleza mhanda zake sikuzilagale.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kwa iwanhu oitapa nolonga, ‘Sikumuitape kabili,’","poem":1},{"lineBreak":true},{"text":"kwa iwanhu wehile nolonga, ‘Sikumwinule mhembe zenu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sikumwinule mhembe zenu mbuli ya ulanga,","poem":1},{"lineBreak":true},{"text":"sikumulonge kwa kibuli.’ ”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Haduhu yoyose yolawa umwambu wa kudilawila zuwa,","poem":1},{"lineBreak":true},{"text":"hebu umwambu wa kudihongela zuwa,","poem":1},{"lineBreak":true},{"text":"hebu umwambu wa kuluwala yodaha kumkweza munhu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lakini Imulungu ayo yotagusa,","poem":1},{"lineBreak":true},{"text":"komuhumulusa imoja na komkweza iyagwe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mumkono wa Mndewa Imulungu kuna kikasi kimemile divai kali,","poem":1},{"lineBreak":true},{"text":"yolava holovu na ihanganyigwa na usongo,","poem":1},{"lineBreak":true},{"text":"kowagidila iwanhu wehile weli mwiisi,","poem":1},{"lineBreak":true},{"text":"ong'wa mbaka dwendwe da mwisho.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Lakini niye nolonga gayasang'hane milele,","poem":1},{"lineBreak":true},{"text":"nomwimbila nhogolwa Imulungu wa Yakobo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nguvu za iwanhu wehile nozibena,","poem":1},{"lineBreak":true},{"text":"lakini nguvu za wene haki zokwinuligwa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}