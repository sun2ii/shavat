{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":76,"content":[{"type":"heading","content":["ZABULI YA 76"]},{"type":"hebrew_subtitle","content":["(Lwila na Zabuli ya Asafu. Kwa kilanja, yatumie nyuzi za bango.)"]},{"type":"verse","number":1,"content":[{"text":"Ako mwiisi ya Yuda Imulungu kojuwigwa,","poem":1},{"lineBreak":true},{"text":"twaga jake kulu mwiisi ya Izilaeli.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kibanda chake kizengigwa ako Salemu","poem":1},{"noteId":10},{"text":",","poem":1},{"lineBreak":true},{"text":"ukazi wake wa ako Sayuni.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ako kabena misale ikwaka,","poem":1},{"lineBreak":true},{"text":"kabena ngao na sime na migoha ya ng'hondo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Gweye kong'ala kwa mulenge,","poem":1},{"lineBreak":true},{"text":"mwene unovu kubanza vigongo vili na utajili wa wanyama.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Magalu wabokigwa vinhu vao,","poem":1},{"lineBreak":true},{"text":"owasa utulo wa kimambukizo,","poem":1},{"lineBreak":true},{"text":"haduhu hata munhu imoja yodaha kuitowa ng'hondo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kwa kukomhokela kwako,","poem":1},{"lineBreak":true},{"text":"gweye Imulungu wa Yakobo,","poem":1},{"lineBreak":true},{"text":"falasi na mtuka wa ng'hondo vikala tuluu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gweye wiiyeka ayo wakudumbigwa.","poem":1},{"lineBreak":true},{"text":"Nani yodaha kwima kuulongozi wako wahagevuzika?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kulawa kuulanga kulonga nhaguso yako,","poem":1},{"lineBreak":true},{"text":"na isi idumba inyamala tuluu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gweye Mndewa Imulungu vuwinuke kutagusa,","poem":1},{"lineBreak":true},{"text":"kuwakombola wose oneligwe mwiisi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ng'hasiliki yako kwa wanhu yogala ukulu kumwako,","poem":1},{"lineBreak":true},{"text":"na waja wasigale mwiing'hasiliki yako otenda nyimwilinyimwili.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Iduwileni kwa Mndewa Imulungu, Imulungu wenu, na vikizeni gaja gamuiduwile,","poem":1},{"lineBreak":true},{"text":"wose omzunguluka heyo wamgalile nhunza, heyo yodumbigwa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Heyo kokanha loho za watawala,","poem":1},{"lineBreak":true},{"text":"heyo kodumbigwa na iwandewa wa isi yose.","poem":1}]}],"footnotes":[{"noteId":10,"caller":"+","text":"Dino dikala twaga da umwaka da buga da Yelusalemu","reference":{"chapter":76,"verse":2}}]},"thisChapterLink":"/api/kdc_pbt/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}