{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":77,"content":[{"type":"heading","content":["ZABULI YA 77"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Asafu. Kwa kilanja, yatumie modeli wa Yedutuni.)"]},{"type":"verse","number":1,"content":[{"text":"Nomulilila Imulungu,","poem":1},{"lineBreak":true},{"text":"nomulilila Imulungu na heyo konihulika.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Siku da magazo gangu nimzahila Mndewa,","poem":1},{"lineBreak":true},{"text":"ikilo ninula uchanha makono gangu bila kudonha,","poem":1},{"lineBreak":true},{"text":"na moyo wangu ulema kuhozwa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gweye Imulungu nikukumbuka,","poem":1},{"lineBreak":true},{"text":"nilila kwa giogio,","poem":1},{"lineBreak":true},{"text":"nigelegeza na niye nisinduka.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kugatenda meso gangu sikugafing'hilize,","poem":1},{"lineBreak":true},{"text":"nikala nogaya mbaka ndemelwa kulonga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nigelegeza siku zibitile,","poem":1},{"lineBreak":true},{"text":"na miyaka mingi ibitile.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nilonga, “Leka nikumbuke nyila zangu ikilo,","poem":1},{"lineBreak":true},{"text":"leka nigelegeze mmoyo wangu.”","poem":1},{"lineBreak":true},{"text":"Abaho loho yangu izahila.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"“Vino Mndewa kotulema milele?","poem":1},{"lineBreak":true},{"text":"Vino hatenda ganogile kabili?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Vino unogelo wake hawishaga usegela milele?","poem":1},{"lineBreak":true},{"text":"Vino gaja gayalongile hagavikizwa milele?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Vino Imulungu kaisemwa kona bazi?","poem":1},{"lineBreak":true},{"text":"Vino heyo yahagevuzika kosegesa bazi jake?”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Abaho nigelegeza, “Kinilumiza acho kino, Imulungu yeli na Uchanha Ng'hani hatenda chochose mbuli yetu.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nozikumbuka sang'hano za Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"ona noukumbuka unzonza wako wa umwaka.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nozigelegeza sang'hano zako zose,","poem":1},{"lineBreak":true},{"text":"na nozigesa mbuli zako ng'hulu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Gweye Imulungu, nzila zako zing'ala.","poem":1},{"lineBreak":true},{"text":"Imulungu gani yeli mkulu kamba Imulungu wetu?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Gweye ayo Imulungu utendaga unzonza,","poem":1},{"lineBreak":true},{"text":"kulagusa ukulu wako hagati ya iwanhu wa isi zose.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kwa mkono wako uli na nguvu kuwagombola wanhu wako,","poem":1},{"lineBreak":true},{"text":"ulelo wa Yakobo na Yusufu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mazi gakona gweye Imulungu,","poem":1},{"lineBreak":true},{"text":"mazi gakona na kukimbila,","poem":1},{"lineBreak":true},{"text":"hasi mwiibahali kugwaya.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mawingu geta mazi,","poem":1},{"lineBreak":true},{"text":"ulanga uduma na ng'huwa,","poem":1},{"lineBreak":true},{"text":"misale yako imwemwesa kila mwambu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ng'huwa yako ihulikigwa mdibeho da kivulavumbi,","poem":1},{"lineBreak":true},{"text":"lumwesa lwako lumwemwesa isi yose,","poem":1},{"lineBreak":true},{"text":"isi yose igwaya na kutigisika.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nzila yako ibita mbahali,","poem":1},{"lineBreak":true},{"text":"kubita mmazi mengi,","poem":1},{"lineBreak":true},{"text":"hamoja ngayo zako hazoneke.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kuwalongoza wanhu zako kamba bumbila da fugo,","poem":1},{"lineBreak":true},{"text":"kwa mkono wa Musa na Haluni.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}