"type":"verse","number":5,"content":[{"text":"Kalava amuli kwa Yakobo,","poem":1},{"lineBreak":true},{"text":"na keka malagizo mwiisi ya Izilaeli,","poem":1},{"lineBreak":true},{"text":"na kawalagiza iwahenga zetu wawafunze wanao,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ili iwanhu wa ulelo ukwiza wagajuwe,","poem":1},{"lineBreak":true},{"text":"hamoja na iwana onda waleligwe,","poem":1},{"lineBreak":true},{"text":"na hewo vivija kwa kipindi chao wawalongele wanao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aho okwika tamanilo jao kwa Imulungu,","poem":1},{"lineBreak":true},{"text":"na hawaisemwa mbuli zake ng'hulu,","poem":1},{"lineBreak":true},{"text":"lakini ogagoga malagizo gake.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Na sikuwaigale na iwahenga zao,","poem":1},{"lineBreak":true},{"text":"wakalile ulelo wa iwanhu wadulu,","poem":1},{"lineBreak":true},{"text":"na walema kutegeleza,","poem":1},{"lineBreak":true},{"text":"wanhu hawatamaniligwa kumwake,","poem":1},{"lineBreak":true},{"text":"awo loho zao hazimgogile Imulungu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kamba iwanhu wa Efulaimu hamoja wagoga upinde,","poem":1},{"lineBreak":true},{"text":"wakimbila siku da ing'hondo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hawadigogile lagano da Imulungu,","poem":1},{"lineBreak":true},{"text":"na walema kukala kwa malagizo gake.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Waisemwa gaja gayawatendele,","poem":1},{"lineBreak":true},{"text":"unzonza yaulaguse kumwao.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Katenda unzonza mgameso ga iwahenga zao,","poem":1},{"lineBreak":true},{"text":"ako Soani mwiisi ya Misili.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kaigola bahali na kawalongoza mbaka wabita,","poem":1},{"lineBreak":true},{"text":"kagatenda mazi gema kamba kisugulu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kawalongoza kwa wingu imisi,","poem":1},{"lineBreak":true},{"text":"na kwa mulenge kulawa mmoto kilo kigima.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Katula mibwe kuluwala,","poem":1},{"lineBreak":true},{"text":"kawagwaa mazi mengi kamba bahali,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"katenda mbwibwi kulawa mdibwe,","poem":1},{"lineBreak":true},{"text":"kagatenda mazi gakilime kamba lwanda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Lakini wagendelela kumtendela nzambi,","poem":1},{"lineBreak":true},{"text":"ako kuluwala wamulema ayo yeli Uchanha Ng'hani.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wamgeza Imulungu giladi,","poem":1},{"lineBreak":true},{"text":"walonda ndiya waisulukile wenyego.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wamdeta Imulungu, walonga,","poem":1},{"lineBreak":true},{"text":"“Vino Imulungu kodaha kutanda meza ya ndiya kuluwala?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ona, katowa dibwe na mazi galawa,","poem":1},{"lineBreak":true},{"text":"mbwibwi zilava mazi mengi.","poem":1},{"lineBreak":true},{"text":"Lakini heyo vivija kodaha kutugwaa ndiya,","poem":1},{"lineBreak":true},{"text":"hebu kutugwaa nyama?”","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Mndewa Imulungu viyawahulike kagevuzika ng'hani,","poem":1},{"lineBreak":true},{"text":"moto wake ukala kwa ulelo wa Yakobo,","poem":1},{"lineBreak":true},{"text":"na ng'hasiliki yake iwakila wanhu wa Izilaeli,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"kwavija hawamtamanile Imulungu,","poem":1},{"lineBreak":true},{"text":"na hawatogole kamba yahadahile kuwakombola.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Avo, kalagiza ulanga uli uchanha,","poem":1},{"lineBreak":true},{"text":"na kavugula milango ya kuulanga,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"kawalagazila mana kamba ndiya,","poem":1},{"lineBreak":true},{"text":"kawagwaa ndiya ya kuulanga.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Wanhu waja ndiya ya wasenga wa kuulanga,","poem":1},{"lineBreak":true},{"text":"kawagwaa ndiya kamba vuwadahile kuja.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Kagala beho da umwambu wa kudilawila zuwa kulawa kuulanga,","poem":1},{"lineBreak":true},{"text":"na kwa udahi wake kadilongoza beho da mwambu wa kusini.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Kawalagazila nyama kamba timbwisi,","poem":1},{"lineBreak":true},{"text":"ndege oguluka kamba msanga wa mwhani.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Kawatenda wagwe mng'hambi yao,","poem":1},{"lineBreak":true},{"text":"na wazunguluka vibanda vao vose.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Wanhu waja na kusigasa,","poem":1},{"lineBreak":true},{"text":"kwavija kawagwaa kija kiwasulukile.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Wang'hali hawana mambukiza kuja acho kiwasulukile,","poem":1},{"lineBreak":true},{"text":"ndiya viikalile ing'hali mmulomo,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Imulungu kawagevuzikila,","poem":1},{"lineBreak":true},{"text":"kawakoma awo wakalile na nguvu hagati yao,","poem":1},{"lineBreak":true},{"text":"kawabwanha iwabwanga wa Izilaeli.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Hamoja ago gose galawila,","poem":1},{"lineBreak":true},{"text":"hewo wagendelela kutenda nzambi,","poem":1},{"lineBreak":true},{"text":"na hawatamanile unzonza wake.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Avo kazitenda siku zao zilawanye kamba mhumuzi,","poem":1},{"lineBreak":true},{"text":"na miyaka yao ishila mkudumba.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Viyawakomile wamzahila,","poem":1},{"lineBreak":true},{"text":"waleka gehile gao na wambwelela Imulungu kabili kwa mizoyo yao yose.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Wakumbuka kamba Imulungu kalala dibwe jao,","poem":1},{"lineBreak":true},{"text":"Imulungu yeli Uchanha Ng'hani ayo mkombola wao.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Lakini wamvizila kwa milomo yao,","poem":1},{"lineBreak":true},{"text":"walonga uvizi kwa milimi yao,","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"mizoyo yao haimgogile heyo,","poem":1},{"lineBreak":true},{"text":"na hawatamanilwe mdilagano jake.","poem":1}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"Hata ivo heyo kakala na bazi,","poem":1},{"lineBreak":true},{"text":"kagela kumgongo gehile gao na hawabanange bule.","poem":1},{"lineBreak":true},{"text":"Miyanza mingi kaikimila ng'hasiliki yake,","poem":1},{"lineBreak":true},{"text":"na haibwinhile ng'hasiliki yake yose.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Kakumbuka kamba hewo wakala wanhu tu,","poem":1},{"lineBreak":true},{"text":"na kamba beho dibita na kulawanya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Miyanza mingi wamulema kuluwala,","poem":1},{"lineBreak":true},{"text":"na wamgela usungu kudibawe.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Wamgeza Imulungu kabili na kabili,","poem":1},{"lineBreak":true},{"text":"na wamgevuza ay