":"aho haakalile hagati ya iwanhu.","poem":1}]},{"type":"verse","number":61,"content":[{"lineBreak":true},{"text":"Katogola disanduku da lagano disoligwe,","poem":1},{"lineBreak":true},{"text":"ukulu wake kaugala mmakono ga awo omwihila.","poem":1}]},{"type":"verse","number":62,"content":[{"lineBreak":true},{"text":"Kawaleka iwanhu zake wakomigwe kwa sime,","poem":1},{"lineBreak":true},{"text":"kawagevuzikila ng'hani iwanhu wa uhazi wake.","poem":1}]},{"type":"verse","number":63,"content":[{"lineBreak":true},{"text":"Moto uwasakaza iwabwanga wao,","poem":1},{"lineBreak":true},{"text":"iwandele wao hawembiligwe nyila za zengele.","poem":1}]},{"type":"verse","number":64,"content":[{"lineBreak":true},{"text":"Iwalava nhosa wao wakomigwa kwa sime,","poem":1},{"lineBreak":true},{"text":"na ivizuka hawadahile kulila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":65,"content":[{"text":"Abaho Mndewa kalamuka kamba munhu yawasile utulo,","poem":1},{"lineBreak":true},{"text":"kamba munhu yoguta mbuli ya kung'wa ugimbi.","poem":1}]},{"type":"verse","number":66,"content":[{"lineBreak":true},{"text":"Kawatowa na kawahuma iwanhu omwihila,","poem":1},{"lineBreak":true},{"text":"na kawagela mkinyala cha milele.","poem":1}]},{"type":"verse","number":67,"content":[{"lineBreak":true},{"text":"Abaho kadilema hema da Yusufu,","poem":1},{"lineBreak":true},{"text":"hadisagule kabila da Efulaimu,","poem":1}]},{"type":"verse","number":68,"content":[{"lineBreak":true},{"text":"lakini kadisagula kabila da Yuda,","poem":1},{"lineBreak":true},{"text":"lugongo lwa Sayuni, alo kalunogela.","poem":1}]},{"type":"verse","number":69,"content":[{"lineBreak":true},{"text":"Kazenga hanhu hake hong'ala kamba ulanga,","poem":1},{"lineBreak":true},{"text":"kamba isi iyailumbile ikale milele.","poem":1}]},{"type":"line_break"},{"type":"verse","number":70,"content":[{"text":"Kamsagula Daudi msang'hanaji wake,","poem":1},{"lineBreak":true},{"text":"na kamulava kulawa mmabumba ga ng'hondolo,","poem":1}]},{"type":"verse","number":71,"content":[{"lineBreak":true},{"text":"kulawa kususila ng'hondolo kamgala yawe msusilaji wa iwanhu wa Yakobo,","poem":1},{"lineBreak":true},{"text":"na Izilaeli wanhu wake.","poem":1}]},{"type":"verse","number":72,"content":[{"lineBreak":true},{"text":"Na Daudi kawasusila kwa moyo unogile,","poem":1},{"lineBreak":true},{"text":"kwa mikono ya ufundi kawalongoza.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/78.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/79.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/77.json","previousChapterAudioLinks":{},"numberOfVerses":72}