{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":8,"content":[{"type":"heading","content":["ZABULI YA 8"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi. Kwa kilanja, yatumie modeli wa Gititi.)"]},{"type":"verse","number":1,"content":[{"text":"Go Mndewa Imulungu, Mndewa wetu,","poem":1},{"lineBreak":true},{"text":"twaga jako kulu mwiisi yose!","poem":1},{"lineBreak":true},{"text":"Gweye kwika ukulu wako ako uchanha kuulanga.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mmilomo ya wana na ving'hele kuikila ngome kwa awo okwihila,","poem":1},{"lineBreak":true},{"text":"kuwatenda wanyamale awo okwihila na awo okulema.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nahaulola ulanga wako, ayo isang'hano ya vidole vako,","poem":1},{"lineBreak":true},{"text":"mbalamwezi na nhondo avo viwikile,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"munhu ayo nani, mbaka umgelegeze?","poem":1},{"lineBreak":true},{"text":"Mwana wa munhu ayo nani, mbaka umulole goya?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kumtenda mdodo kubanza iwasenga wa kuulanga,","poem":1},{"lineBreak":true},{"text":"na kumvaza ukulu na nhogolwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kumtenda yaitawale sang'hano ya makono gako,","poem":1},{"lineBreak":true},{"text":"kuvika hasi ya magulu gake vinhu vose,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ng'hondolo na ng'ombe,","poem":1},{"lineBreak":true},{"text":"na vivija iming'onyo ya kumuhulo,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"iwandege wa kuulanga na somba wa mbahali,","poem":1},{"lineBreak":true},{"text":"na vose vikogelela mbahali.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Go Mndewa Imulungu, Mndewa wetu,","poem":1},{"lineBreak":true},{"text":"twaga jako kulu mwiisi yose!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}