{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":80,"content":[{"type":"heading","content":["ZABULI YA 80"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Asafu. Kwa kilanja, yatumie modeli ya lwila lwa Besa.)"]},{"type":"verse","number":1,"content":[{"text":"Gweye msusilaji wa Izilaeli tutegeleze,","poem":1},{"lineBreak":true},{"text":"gweye umulongoza Yusufu kamba fugo,","poem":1},{"lineBreak":true},{"text":"gweye ukalaga mkigoda cha ukulu hagati ya viumbe wa kuulanga, umwemwese.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kuulongozi wa Efulaimu, Benjamini na Manase.","poem":1},{"lineBreak":true},{"text":"Inula nguvu zako, wize utukombole.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gweye Imulungu utubweze,","poem":1},{"lineBreak":true},{"text":"utumwemwesele kihanga chako, ili tukomboligwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Gweye Mndewa Imulungu uli na nguvu zose,","poem":1},{"lineBreak":true},{"text":"mbaka lini ng'hasiliki yako yokwaka na kulava yosi,","poem":1},{"lineBreak":true},{"text":"kwa kupula kwa iwanhu zako?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kuwadima gate da mahozi,","poem":1},{"lineBreak":true},{"text":"kuwatenda wang'we mahozi bakuli dimemile.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kuwatenda iwanhu wa isi zituzunguluke wagombe mbuli ya isi yetu,","poem":1},{"lineBreak":true},{"text":"na iwanhu otwihila otuseka.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gweye Imulungu uli na Udahi wose,","poem":1},{"lineBreak":true},{"text":"utubweze na tumwemwesele kihanga chako,","poem":1},{"lineBreak":true},{"text":"ili siye tukomboligwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kugala mzabibu kulawa Misili,","poem":1},{"lineBreak":true},{"text":"kowawinga iwanhu wa isi ziyagwe,","poem":1},{"lineBreak":true},{"text":"kuuhanda mwiisi yao.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kuuhalilila ili ukule,","poem":1},{"lineBreak":true},{"text":"wota na mizizi yake yenela mwiisi yao yose.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Vigongo vigubikwa kwa sisila jake,","poem":1},{"lineBreak":true},{"text":"matambi gake gagubika mielezi mikulu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Matambi gake genela mbaka mmbahali,","poem":1},{"lineBreak":true},{"text":"nzukila zake mbaka kulwanda.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mbona kubomola senyenge zake,","poem":1},{"lineBreak":true},{"text":"ili iwanhu obita behi wabawe zabibu zake?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nguluwe luwala ounanga,","poem":1},{"lineBreak":true},{"text":"na wanyama wa kubonde odimiligwa mumo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tubwelele gweye Imulungu uli na Udahi wose.","poem":1},{"lineBreak":true},{"text":"Lola hasi kulawa kuulanga wone.","poem":1},{"lineBreak":true},{"text":"Ukalize mzabibu uno,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"kigongi cha mzabibu chuuhandile kwa mkono wako wa ukudila,","poem":1},{"lineBreak":true},{"text":"mwana yumulelile mbuli yako mwenyego.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mzabibu wako ukanhigwa na usomigwa moto,","poem":1},{"lineBreak":true},{"text":"kwa kuwakomhokela wanhu wako obanangwa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mkono wako ukale kwa munhu yokala mkono wako wa ukudila,","poem":1},{"lineBreak":true},{"text":"mwana wa munhu yumulelile mbuli yako mwenyego.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Abaho hatukuleka kabili,","poem":1},{"lineBreak":true},{"text":"utubwezele loho zetu na todikema twaga jako.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Gweye Mndewa Imulungu uli na Udahi wose,","poem":1},{"lineBreak":true},{"text":"utubweze na tumwemwesele kihanga chako,","poem":1},{"lineBreak":true},{"text":"ili siye tukomboligwe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}