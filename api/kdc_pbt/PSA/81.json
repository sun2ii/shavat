{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":81,"content":[{"type":"heading","content":["ZABULI YA 81"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Asafu. Kwa kilanja, yatumie modeli wa Gititi.)"]},{"type":"verse","number":1,"content":[{"text":"Mwimbileni kwa deng'ho Imulungu yeli na nguvu zose,","poem":1},{"lineBreak":true},{"text":"guteni kwa deng'ho kwa Imulungu wa Yakobo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Songeni lwila, toweni ngoma ndodo,","poem":1},{"lineBreak":true},{"text":"toweni bango kwa sauti inogile.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Toweni mhalati mbalamwezi yahema,","poem":1},{"lineBreak":true},{"text":"na kipindi cha mbalamwezi yahakangala,","poem":1},{"lineBreak":true},{"text":"kipindi cha nyimwilinyimwili yetu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dino lagizo kwa Izilaeli,","poem":1},{"lineBreak":true},{"text":"na lagizo da Imulungu wa Yakobo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kaditenda diwe amuli kwa iwanhu wa Izilaeli,","poem":1},{"lineBreak":true},{"text":"viwasegele mwiisi ya Misili,","poem":1},{"lineBreak":true},{"text":"kuko kutuhulike ulonzi hatuutangile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Nisegesa mzigo mmaega gao,","poem":1},{"lineBreak":true},{"text":"makono gao gafunguligwa mkigelo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mmagazo gako kunikema na niye nikukombola,","poem":1},{"lineBreak":true},{"text":"nikwidika mmawingu ga kuduma,","poem":1},{"lineBreak":true},{"text":"nikugeza mmazi ga Meliba.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mweye wanhu zangu tegelezeni na niye nowazuma,","poem":1},{"lineBreak":true},{"text":"maza mnitegeleze niye mweye Izilaeli.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sikumuwe na imulungu iyagwe hagati yenu,","poem":1},{"lineBreak":true},{"text":"sikumumtambikile imulungu iyagwe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Niye ayo Mndewa Imulungu wako,","poem":1},{"lineBreak":true},{"text":"nikulavile mwiisi ya Misili.","poem":1},{"lineBreak":true},{"text":"Yahama mulomo wako na niye nokudima.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Lakini wanhu zangu hawalondile kunihulika,","poem":1},{"lineBreak":true},{"text":"Waizilaeli walema kunitegeleza.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Avo niwaleka muudulu wa mizoyo yao,","poem":1},{"lineBreak":true},{"text":"wakweleleze nzila zao wenyego.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Maza wanhu wangu wanitegeleze,","poem":1},{"lineBreak":true},{"text":"maza iwanhu wa Izilaeli wahakweleleze nzila zangu,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"nahawagomese iwanhu owehila himahima,","poem":1},{"lineBreak":true},{"text":"na kuhindula mkono wangu kwa awo owehila.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Waja omwihila Mndewa Imulungu wahaidulike kumwake,","poem":1},{"lineBreak":true},{"text":"na nhaguso yao yahasigale milele.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Lakini mweye mwahagweleligwe ngano inogile,","poem":1},{"lineBreak":true},{"text":"na kushiba kwa uki ulawa kudibwe.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}