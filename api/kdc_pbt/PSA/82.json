{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"heading","content":["ZABULI YA 82"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Asafu.)"]},{"type":"verse","number":1,"content":[{"text":"Imulungu kolongoza mting'hano mkulu,","poem":1},{"lineBreak":true},{"text":"hagati ya imulungu iyagwe heyo kotagusa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mbaka lini gweye kogendelela kutagusa bila haki,","poem":1},{"lineBreak":true},{"text":"na kulagusa unogelo kwa iwanhu otenda gehile?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wagombele iwanhu onyolila na iwana wakiwa,","poem":1},{"lineBreak":true},{"text":"tenda ganogile kwa iwanhu wakiwa na iwanhu obezigwa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mkombole imunhu yonyolila na yelibule kinhu,","poem":1},{"lineBreak":true},{"text":"wakombole kulawa mmakono ga iwanhu wehile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Hewo hawatanga chochose na hawagelegeza chochose.","poem":1},{"lineBreak":true},{"text":"Otembela kuziza.","poem":1},{"lineBreak":true},{"text":"Vandusilo vose va haki mwiisi votigiswa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"“Niye nilonga, ‘Mweye mwa milungu,","poem":1},{"lineBreak":true},{"text":"mweye mose mwa wana wa ayo yeli Uchanha Ng'hani.’","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lakini mofa kamba iwanhu wose viwofa,","poem":1},{"lineBreak":true},{"text":"molagala kamba mtawala yoyose iyagwe.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gweye Imulungu, inuka uitaguse isi yose,","poem":1},{"lineBreak":true},{"text":"kwavija isi yose awo uhazi wako.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}