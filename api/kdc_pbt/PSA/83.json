{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":83,"content":[{"type":"heading","content":["ZABULI YA 83"]},{"type":"hebrew_subtitle","content":["(Lwila na Zabuli ya Asafu.)"]},{"type":"verse","number":1,"content":[{"text":"Gweye Imulungu, sikuunyamale tuluu,","poem":1},{"lineBreak":true},{"text":"sikuunyamale gweye Imulungu ututaze.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lola iwanhu okudeta ogala ndwagi,","poem":1},{"lineBreak":true},{"text":"lola iwanhu okwihila okwinula mapala gao.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kwa moyo wihile opanga kutenda gehile kwa iwanhu wako,","poem":1},{"lineBreak":true},{"text":"opanga kutenda gehile kwa awo uwanogela.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Olonga, “Izoni, tuwabanange kamba isi,","poem":1},{"lineBreak":true},{"text":"ili twaga da Izilaeli sikudikumbukwe kabili.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kwa nzila imoja ogelegeza gehile,","poem":1},{"lineBreak":true},{"text":"oilumba mbuli yako,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"wanhu wa Edomu na Waishimaeli,","poem":1},{"lineBreak":true},{"text":"Wamoabu na Wahagali,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"wanhu wa Gebali na Amoni na Amaleki,","poem":1},{"lineBreak":true},{"text":"na Ufilisiti, hamoja na iwanhu wa Tilo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Vivija Ashulu wailumba na hewo,","poem":1},{"lineBreak":true},{"text":"kuwagwaa nguvu ulelo wa Lutu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Uwatendele kamba vuuwatendele Wamidiani,","poem":1},{"lineBreak":true},{"text":"na kamba vuuwatendele Sisela na Yabini ako kuulwanda lwa Kishoni,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"awo wakomigwe ako Endoli,","poem":1},{"lineBreak":true},{"text":"na wakala kamba zalala mwiisi yose.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Watende iwakulu wao kamba Olebu na Zeebu,","poem":1},{"lineBreak":true},{"text":"na iwatawala wao kamba Zeba na Zalimuna,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"walongile, “Leka tuhasole hanhu ha kudimila ha Imulungu.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Gweye Imulungu wangu wahembeluse,","poem":1},{"lineBreak":true},{"text":"kamba timbwisi da kivula vumbi,","poem":1},{"lineBreak":true},{"text":"kamba mipepe ihembeluswa na beho.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kamba moto ulukuza muhulo,","poem":1},{"lineBreak":true},{"text":"hebu kamba lambi da moto dilukuza kigongo,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"avo wakweleleze kwa beho jako,","poem":1},{"lineBreak":true},{"text":"na uwadumbize kwa ng'humbi yako.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gubika vihanga vao kwa kinyala,","poem":1},{"lineBreak":true},{"text":"ili wadizahile twaga jako, gweye Mndewa Imulungu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hewo wagwe kinyala na kuwa na bwembwe milele,","poem":1},{"lineBreak":true},{"text":"hewo na wapotele kwa kinyala.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Waleke wajuwe kamba gweye wiiyeka,","poem":1},{"lineBreak":true},{"text":"gweye twaga jako Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"gweye ayo ukalaga Uchanha Ng'hani ya isi yose.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}