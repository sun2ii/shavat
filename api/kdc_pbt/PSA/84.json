{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":84,"content":[{"type":"heading","content":["ZABULI YA 84"]},{"type":"hebrew_subtitle","content":["(Kwa kilanja, yatumie modeli wa Gititi. Zabuli ya wanhu wa ulelo wa Kola.)"]},{"type":"verse","number":1,"content":[{"text":"Gweye Mndewa Imulungu, uli na nguvu zose,","poem":1},{"lineBreak":true},{"text":"ako kuukala kunoga ng'hani.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Moyo wangu osulukila ng'hani ng'anda ya Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"moyo wangu na lukuli lwangu vomwimbila Imulungu yeli mgima.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hata nhongwa kazenga mvulu ya kuwasa,","poem":1},{"lineBreak":true},{"text":"kinega kazenga kisanza chake,","poem":1},{"lineBreak":true},{"text":"mumo kageka makinda gake,","poem":1},{"lineBreak":true},{"text":"behi na upango wako wa nhosa,","poem":1},{"lineBreak":true},{"text":"gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"Mndewa wangu na Imulungu wangu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wamweda iwanhu okala mng'anda yako,","poem":1},{"lineBreak":true},{"text":"okutogola gweye siku zose.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wamweda iwanhu wene nguvu zako,","poem":1},{"lineBreak":true},{"text":"na nzila za kuchola Sayuni zammo mmizoyo yao.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wahabita kubonde da Baka,","poem":1},{"lineBreak":true},{"text":"oditenda hanhu ha nzasa,","poem":1},{"lineBreak":true},{"text":"vivija mvula za vuli zomemeza masimo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ogendelela kulawa nguvu mbaka nguvu,","poem":1},{"lineBreak":true},{"text":"mbaka kila imoja yovika kuulongozi wa Imulungu ako Sayuni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gweye Mndewa Imulungu uli na nguvu zose,","poem":1},{"lineBreak":true},{"text":"tegeleza vinikupula,","poem":1},{"lineBreak":true},{"text":"tegeleza gweye Imulungu wa Yakobo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gweye Imulungu umulole mndewa yeli ngao yetu,","poem":1},{"lineBreak":true},{"text":"mulole kwa ganogile imunhu yumsagule.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Siku dimoja kukala kuuluwa lwako,","poem":1},{"lineBreak":true},{"text":"kunoga kubanza kukala siku elufu imoja hanhu hayagwe,","poem":1},{"lineBreak":true},{"text":"vinoga nahakuwile mkalizi wa ng'anda ya Imulungu wangu,","poem":1},{"lineBreak":true},{"text":"kubanza kukala mmahema ga iwanhu wehile.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kwavija gweye Mndewa Imulungu ayo zuwa na ngao,","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu kolava ganogile na ukulu,","poem":1},{"lineBreak":true},{"text":"huwanyima kinhu chochose kinogile,","poem":1},{"lineBreak":true},{"text":"iwanhu welibule kitala.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gweye Mndewa Imulungu uli na nguvu zose,","poem":1},{"lineBreak":true},{"text":"kamweda imunhu yokutamanila gweye.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}