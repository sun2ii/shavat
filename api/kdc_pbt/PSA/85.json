{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":85,"content":[{"type":"heading","content":["ZABULI YA 85"]},{"type":"hebrew_subtitle","content":["(Kwa kilanja, Zabuli ya wanhu wa ulelo wa Kola.)"]},{"type":"verse","number":1,"content":[{"text":"Gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kulagusa ganogile kwa isi yako,","poem":1},{"lineBreak":true},{"text":"kumbwezela Yakobo ganogile gake.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kugela kumgongo nzambi za wanhu zako,","poem":1},{"lineBreak":true},{"text":"kuzilohola nzambi zao zose.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kuikimila ng'hasiliki yako yose,","poem":1},{"lineBreak":true},{"text":"kuleka kugevuzika kwako.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Utubweze kabili gweye Imulungu mkombola wetu,","poem":1},{"lineBreak":true},{"text":"usegese ng'hasiliki yako kumwetu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Vino, kotugevuzikila milele?","poem":1},{"lineBreak":true},{"text":"Kogendeleza ng'hasiliki yako kwa ulelo wetu wose?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Vino, hutubweza kabili,","poem":1},{"lineBreak":true},{"text":"avo iwanhu wako wakudeng'helele?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Utulagusile unogelo wako hawishaga,","poem":1},{"lineBreak":true},{"text":"gweye Mndewa Imulungu utugwelele ukombola wako.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Notegeleza goyolonga Imulungu yeli Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kalagiza tindiwalo jake kwa iwanhu zake wang'alile,","poem":1},{"lineBreak":true},{"text":"lakini sikuwabwelele ubozi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ona ukombola wake wa behi na awo omdumba,","poem":1},{"lineBreak":true},{"text":"ili ukulu wake usigale mwiisi yetu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Unogelo hawishaga na kutamanilwa voiting'hana,","poem":1},{"lineBreak":true},{"text":"haki na tindiwalo voilamusa kwa kuinonela.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kutamanilwa kozuka kulawa mwiisi,","poem":1},{"lineBreak":true},{"text":"haki yolola hasi kulawa kuulanga.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ona, Mndewa Imulungu, kalava kinhu kinogile,","poem":1},{"lineBreak":true},{"text":"isi yetu yolela ndiya yake.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Haki yolongola kuulongozi,","poem":1},{"lineBreak":true},{"text":"na kutenda nzila kwa kutausa kwake.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}