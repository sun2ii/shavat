{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":86,"content":[{"type":"heading","content":["ZABULI YA 86"]},{"type":"hebrew_subtitle","content":["(Kupula kwa Daudi.)"]},{"type":"verse","number":1,"content":[{"text":"Gweye Mndewa Imulungu tegeleza na widike,","poem":1},{"lineBreak":true},{"text":"kwavija niye na mkiwa na ngaengae.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kaliza ugima wangu, kwavija niilava kumwako,","poem":1},{"lineBreak":true},{"text":"gweye ayo Imulungu wangu,","poem":1},{"lineBreak":true},{"text":"mkombole msang'hanaji wako yokutamanila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gweye Mndewa, unyonele bazi niye,","poem":1},{"lineBreak":true},{"text":"kwavija nokukema imisi yose.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mgwelele msang'hanaji wako deng'ho,","poem":1},{"lineBreak":true},{"text":"kwavija kumwako gweye Mndewa,","poem":1},{"lineBreak":true},{"text":"nokwinula loho yangu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gweye Mndewa gweye kunoga,","poem":1},{"lineBreak":true},{"text":"na gweye kogela kumgongo,","poem":1},{"lineBreak":true},{"text":"kumema unogelo hawishaga kwa iwanhu wose okukema.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Gweye Mndewa Imulungu, tegeleza vinikupula,","poem":1},{"lineBreak":true},{"text":"tegeleza kililo changu unyonele bazi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mna gamagazo gangu nokukema,","poem":1},{"lineBreak":true},{"text":"kwavija gweye konidika.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gweye Mndewa,","poem":1},{"lineBreak":true},{"text":"hagati ya imilungu haduhu kamba gweye,","poem":1},{"lineBreak":true},{"text":"haduhu yotenda kamba gweye.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gweye Mndewa,","poem":1},{"lineBreak":true},{"text":"iwanhu wa isi zose ziulumbile okwiza na okutambikila gweye,","poem":1},{"lineBreak":true},{"text":"oditogola twaga jako.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kwavija gweye ayo imkulu na kotenda mbuli za kukanganya,","poem":1},{"lineBreak":true},{"text":"gweye wiiyeka ayo Imulungu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Gweye Mndewa Imulungu nifunze nzila zako,","poem":1},{"lineBreak":true},{"text":"na niye nochola mnzila yako ya kweli,","poem":1},{"lineBreak":true},{"text":"nigwelele moyo hauigolile,","poem":1},{"lineBreak":true},{"text":"ili ndahe kudidumba twaga jako.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gweye Mndewa, Imulungu wangu,","poem":1},{"lineBreak":true},{"text":"nokushukulu kwa moyo wose,","poem":1},{"lineBreak":true},{"text":"noditogola twaga jako milele.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kwavija unogelo wako hawishaga mkulu kumwangu,","poem":1},{"lineBreak":true},{"text":"kunikombola kulawa kuzimu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Imulungu iwanhu oitapaga onivamila,","poem":1},{"lineBreak":true},{"text":"bumbila da iwanhu wasede dozahila ugima wangu,","poem":1},{"lineBreak":true},{"text":"hawakugelegeza gweye.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Lakini gweye Mndewa,","poem":1},{"lineBreak":true},{"text":"kwa Imulungu umemile bazi na ng'hekewa,","poem":1},{"lineBreak":true},{"text":"hugevuzika himahima,","poem":1},{"lineBreak":true},{"text":"ila kumema unogelo hawishaga na kutamanilwa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nihindukile na nyonele bazi,","poem":1},{"lineBreak":true},{"text":"mgwelele msang'hanaji wako nguvu zako,","poem":1},{"lineBreak":true},{"text":"mkombole mwana wa msang'hanaji wako wa kitwanzi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ngwaa kilaguso cha ganogile,","poem":1},{"lineBreak":true},{"text":"ili iwanhu onihila wachone na wagwe kinyala,","poem":1},{"lineBreak":true},{"text":"kwavija gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kunitaza na kunihembekeza.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}