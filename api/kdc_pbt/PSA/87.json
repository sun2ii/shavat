type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mbuli ya Sayuni olonga vino,","poem":1},{"lineBreak":true},{"text":"“Ino na ija waleligwa mumo,","poem":1},{"lineBreak":true},{"text":"na ayo yeli uchanha ng'hani mwenyego kodigwaa nguvu.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu kokwandika matwaga ga iwanhu wa isi zose.","poem":1},{"lineBreak":true},{"text":"“Ino kaleligwa Sayuni.”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Vonda watowe bango okwimba,","poem":1},{"lineBreak":true},{"text":"“Nzasa zangu zose za kumwako.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}