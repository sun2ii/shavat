{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":88,"content":[{"type":"heading","content":["ZABULI YA 88"]},{"type":"hebrew_subtitle","content":["(Lwila na Zabuli ya wanhu wa ulelo wa Kola. Kwa kilanja, yatumie modeli wa Mahalati Leanoti. Zabuli ya Hemani Mwezilahi.)"]},{"type":"verse","number":1,"content":[{"text":"Gweye Mndewa Imulungu unikombole,","poem":1},{"lineBreak":true},{"text":"nilila kuulongozi wako imisi na ikilo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kupula kwangu kuvike kuulongozi wako,","poem":1},{"lineBreak":true},{"text":"uhulike ndilo yangu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kwavija zoyo jangu dimema magazo,","poem":1},{"lineBreak":true},{"text":"ugima wangu wabehi kwisha.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nipetwa mna iwao ochola kudisimo,","poem":1},{"lineBreak":true},{"text":"sambi nokala kamba munhu yelibule nguvu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nibagulwa hamoja na iwanhu wadanganike,","poem":1},{"lineBreak":true},{"text":"kamba iwanhu wachinjigwe owasa mmapanga,","poem":1},{"lineBreak":true},{"text":"awo hawakumbuka chochose,","poem":1},{"lineBreak":true},{"text":"awo walekigwe na ukalizi wako.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kunitupa mdisimo dingile gidigidi,","poem":1},{"lineBreak":true},{"text":"kugati kudiziza totolo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ng'hasiliki yako ibanza kumwangu,","poem":1},{"lineBreak":true},{"text":"kunizola kwa ng'humbi yako.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kunibagula na iwambwiga zangu wose,","poem":1},{"lineBreak":true},{"text":"na kunitenda ngevuzo kumwao,","poem":1},{"lineBreak":true},{"text":"kunikimilila na sidaha kutoloka.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Meso gangu gaziza mbuli ya giogio.","poem":1},{"lineBreak":true},{"text":"Gweye Mndewa Imulungu nokukema kila siku,","poem":1},{"lineBreak":true},{"text":"nokwinulila gweye makono gangu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Vino kowalagusila iwanhu wadanganike unzonza wako?","poem":1},{"lineBreak":true},{"text":"Vino mizimu yokwinuka na kukugwaa nhogolwa?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Vino unogelo wako hawishaga olongigwa ako kudipanga?","poem":1},{"lineBreak":true},{"text":"Vino wanhu osimulila vuutamanilwa ako kuubananzi?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Vino unzonza wako ojuwigwa kudiziza?","poem":1},{"lineBreak":true},{"text":"Vino sang'hano zako za haki zojuwigwa mwiisi ya wasemwigwe?","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Lakini nokulilila gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"imitondo kupula kwangu kokuvikila gweye.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"habali konilema na kokifisa kihanga chako?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tangu ubwanga wangu nigazwa na nilonda kufa,","poem":1},{"lineBreak":true},{"text":"nogaya kwa bwembwe jako na niye nibwela kuchugu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ng'hasiliki yako ibita uchanha yangu,","poem":1},{"lineBreak":true},{"text":"bwembwe jako dinibananga.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Imisi yose vonisuwilila kamba mazi mengi,","poem":1},{"lineBreak":true},{"text":"nizungulukwa wose.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kuwasegesa mbwiga zangu na awo niwanogela,","poem":1},{"lineBreak":true},{"text":"ziza digalamuka mbwiga zangu wa behi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}