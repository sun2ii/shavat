{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":89,"content":[{"type":"heading","content":["ZABULI YA 89"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Etani Mwezilahi.)"]},{"type":"verse","number":1,"content":[{"text":"Go Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"nokwimba unogelo wako hawishaga milele,","poem":1},{"lineBreak":true},{"text":"kwa mulomo wangu nolonga kutamanilwa kwako,","poem":1},{"lineBreak":true},{"text":"ujuwigwe ulelo wose.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nolonga kamba unogelo wako hawishaga okala milele,","poem":1},{"lineBreak":true},{"text":"na kutamanilwa kwako kugangamala kamba ulanga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kulonga, “Nitenda lagano na ija inimsagule,","poem":1},{"lineBreak":true},{"text":"niiduwila kwa msang'hanaji wangu Daudi,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"‘Nowimiza ulelo wako milele,","poem":1},{"lineBreak":true},{"text":"na nougangamiza undewa wako ulelo wose.’”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Gweye Mndewa Imulungu, ulanga otogola unzonza wako,","poem":1},{"lineBreak":true},{"text":"vivija kutamanilwa kwako mumting'hano wa iwanhu ong'ala.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kwavija nani uchanha kuulanga yoilinga na Mndewa Imulungu?","poem":1},{"lineBreak":true},{"text":"Nani mna iviumbe va kuulanga yalingile kamba Mndewa Imulungu?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kumting'hano wa iwanhu wa Imulungu, Imulungu kodumbigwa ng'hani,","poem":1},{"lineBreak":true},{"text":"kodumbigwa kubanza wose omzunguluka.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gweye Mndewa Imulungu uli na udahi wose,","poem":1},{"lineBreak":true},{"text":"nani kamba gweye?","poem":1},{"lineBreak":true},{"text":"Gweye Mndewa Imulungu, gweye mwene nguvu,","poem":1},{"lineBreak":true},{"text":"na kutamanilwa kwako kokuzunguluka.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gweye kotawala bahali imemile ng'humbi,","poem":1},{"lineBreak":true},{"text":"kipindi ng'humbi yake viinuke gweye koihoza.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gweye kudihonda dizoka Lahabu kamba imoja wa iwanhu wachinjigwe,","poem":1},{"lineBreak":true},{"text":"kwa mkono wako wenye nguvu kuwapwililisa iwanhu okwihila.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ulanga wako gweye na isi vivija yako,","poem":1},{"lineBreak":true},{"text":"kwika chandusilo mwiisi hamoja na vose vili mumo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kulumba kasikazini na kusini,","poem":1},{"lineBreak":true},{"text":"Lugongo lwa Taboli na Helimoni vokwimba twaga jako kwa deng'ho.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mkono wako umema udahi,","poem":1},{"lineBreak":true},{"text":"mkono wako una nguvu,","poem":1},{"lineBreak":true},{"text":"mkono wako wa ukudila otogoligwa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Haki na nhaguso acho chandusilo cha kigoda chako cha undewa,","poem":1},{"lineBreak":true},{"text":"unogelo hawishaga na kutamanilwa vokulongolela.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Wamweda iwanhu oifunza kukutogola kwa deng'ho,","poem":1},{"lineBreak":true},{"text":"otembela mdilenge da kung'ala kwako, gweye Mndewa Imulungu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Odeng'helela twaga jako imisi yose,","poem":1},{"lineBreak":true},{"text":"odeng'helela mna ihaki yako.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kwavija gweye kwa ukulu na nguvu yao,","poem":1},{"lineBreak":true},{"text":"kwa ganogile gako topata mhumo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Go Mndewa Imulungu, mkalizi wetu kalawa kumwako,","poem":1},{"lineBreak":true},{"text":"mndewa wetu kolawa kumwako gweye Ung'alile wa Izilaeli.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kulonga mkipindi fulani mzinzozi,","poem":1},{"lineBreak":true},{"text":"kwa iwanhu wako otamanilwa kulonga,","poem":1},{"lineBreak":true},{"text":"“Nimgwaa nguvu digalu,","poem":1},{"lineBreak":true},{"text":"nimwinula mbwanga hagati ya iwanhu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nimpata Daudi msang'hanaji wangu,","poem":1},{"lineBreak":true},{"text":"nimgidila mavuta gangu gong'ala.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ganza jangu domgogeleza,","poem":1},{"lineBreak":true},{"text":"mkono wangu omgela nguvu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Haduhu imunhu yomwihila yonda yamuhume,","poem":1},{"lineBreak":true},{"text":"haduhu munhu yehile yonda yamonele.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Nowahonda iwanhu omwihila kuulongozi wake,","poem":1},{"lineBreak":true},{"text":"na awo omdeta nowabananga.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Kutamanilwa kwangu na unogelo wangu hawishaga okala hamoja na heyo,","poem":1},{"lineBreak":true},{"text":"kwa twaga jangu kopata mhumo ng'hulu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Nougangamiza utawala wake na nguvu,","poem":1},{"lineBreak":true},{"text":"kulawa bahali mbaka lwanda.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Na heyo konikema, ‘Gweye kwa tatangu,","poem":1},{"lineBreak":true},{"text":"Imulungu wangu, dibwe da ukombola wangu.’","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Vivija nomsagula yawe chaudele wangu,","poem":1},{"lineBreak":true},{"text":"yeli mkulu kubanza iwandewa wose wa mwiisi.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Nowika unogelo wangu hawishaga kumwake milele,","poem":1},{"lineBreak":true},{"text":"na lagano jangu na heyo dogangamala.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Nowika ulelo wake milele,","poem":1},{"lineBreak":true},{"text":"kigoda chake cha undewa kamba ulanga vuukala milele.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Kamba wanage ogaleka malagizo gangu,","poem":1},{"lineBreak":true},{"text":"hawagakweleleza mafundizo gangu,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"kamba odilema lagizo jangu,","poem":1},{"lineBreak":true},{"text":"na ogasemwa gaja ganiwalongele,","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"noikoboza nzambi yao kwa fimbo,","poem":1},{"lineBreak":true},{"text":"gehile gao kwa kuwatowa.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Lakini siusegesa unogelo wangu hawishaga kumwake,","poem":1},{"lineBreak":true},{"text":"na sileka kutamanilwa kwangu.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Niye sibena lagano jangu,","poem":1},{"lineBreak":true},{"text":"na sihindusa dija dilongigwe na mulomo wangu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Mwanza umoja na kwa siku zose,","poem":1},{"lineBreak":true},{"text":"niiduwila kwa kung'ala kwangu,","poem":1},{"lineBreak":true},{"text":"na niye simvizila Daudi,","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"kamba ulelo wake osigala milele,","poem":1},{"lineBreak":true},{"text":"na kigoda chake cha ukulu chosigala kuulongozi wangu kamba zuwa.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Chosigala milele kamba mbalamwezi,","poem":1},{"lineBreak":true},{"text":"msindila yotamanilwa kuulanga.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"Lakini sambi gweye kumulema,","poem":1},{"lineBreak":true},{"text":"kumbezeli na kumgevuzikila ayo yuumgidile mavuta gako.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Kudilema lagano jako na msang'hanaji wako,","poem":1},{"lineBreak":true},{"text":"na kuifitiza taji yake kuditimbwisi.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Kubomola ng'huta zake zose,","poem":1},{"lineBreak":true},{"text":"na ngome zake zose kuzitenda kamba vihame.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Wanhu obita behi wamboka vinhu vake,","poem":1},{"lineBreak":true},{"text":"kagalamka kilozo kwa iwanhu okala behi na heyo.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Kuwagwaa mhumo iwanhu omwihila,","poem":1},{"lineBreak":true},{"text":"kuwatenda iwanhu omdeta wadeng'helele.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Kuhindusa ukali wa sime jake,","poem":1},{"lineBreak":true},{"text":"na humtazile kung'hondo.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Kumambukiza kuitapa kwake,","poem":1},{"lineBreak":true},{"text":"na kukibwanha kigoda chake cha undewa.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Kuzihungula siku za ubwanga wake,","poem":1},{"lineBreak":true},{"text":"kumgubika kwa kiwalo cha kinyala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"Mbaka lini gweye Mndewa Imulungu koifisa milele?","poem":1},{"lineBreak":true},{"text":"Ng'hasiliki yako yokwaka kamba moto mbaka lini?","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Kumbuka ugima wangu vuubita himahima.","poem":1},{"lineBreak":true},{"text":"Kwa kinhu gani kuwalumba iwanhu wa mwiisi?","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Nani yokala mgima na hafa bule?","poem":1},{"lineBreak":true},{"text":"Hebu kodaha kuikombola mwenyego mwiiifa?","poem":1}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"Mndewa Imulungu wa kwahi unogelo wako hawishaga wa aho haichanduso,","poem":1},{"lineBreak":true},{"text":"kwa kutamanilwa kwako kuiduwila kwa Daudi?","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu kumbuka msang'hanaji wako viyolongigwa,","poem":1},{"lineBreak":true},{"text":"lola vinigela kumgongo kubezeli kwa iwanhu wa isi yose.","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Wanhu wanideta na kunyonela,","poem":1},{"lineBreak":true},{"text":"gweye Mndewa Imulungu.","poem":1},{"lineBreak":true},{"text":"Wanilonga kila kinhu kinhenda niye yuunigidile mavuta gako.","poem":1}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Mndewa Imulungu yatogolwe, milele.","poem":1},{"lineBreak":true},{"text":"Ona na Ona.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":52}