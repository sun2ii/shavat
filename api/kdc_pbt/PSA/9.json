{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":9,"content":[{"type":"heading","content":["ZABULI YA 9"]},{"type":"hebrew_subtitle","content":["(Zabuli ya Daudi. Kwa kilanja, yatumie modeli ya lwila lwa, “Ifa ya Mwana wa Kimbigalo.”)"]},{"type":"verse","number":1,"content":[{"text":"Nokushukulu Mndewa Imulungu kwa moyo wangu wose,","poem":1},{"lineBreak":true},{"text":"nogasimulila gose ga unzonza gautendile.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nodeng'helela na kukwinula gweye,","poem":1},{"lineBreak":true},{"text":"noditogola twaga jako, gweye uli Uchanha Ng'hani.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Iwanhu onihila wabwela kuchugu,","poem":1},{"lineBreak":true},{"text":"waikwala na kupotela kuulongozi wako.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kwavija kuigombela haki yangu,","poem":1},{"lineBreak":true},{"text":"kukala mkigoda chako cha undewa,","poem":1},{"lineBreak":true},{"text":"na kotagusa kamba viilondigwa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kuwakomhokela iwanhu wa isi ziyagwe,","poem":1},{"lineBreak":true},{"text":"na kuwabananga iwanhu wehile,","poem":1},{"lineBreak":true},{"text":"matwaga gao kugasegesa siku zose na milele.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Iwanhu otwihila wabanangwa milele,","poem":1},{"lineBreak":true},{"text":"kugang'ola mabuga gao na wose wasemwigwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lakini Mndewa Imulungu kotawala milele,","poem":1},{"lineBreak":true},{"text":"keka kigoda chake cha undewa ili yataguse,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"kowatagusa iwanhu wa mwiisi yose kwa haki,","poem":1},{"lineBreak":true},{"text":"kowatawala iwanhu kamba viilondigwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mndewa Imulungu ayo ngome ya awo odununzwa,","poem":1},{"lineBreak":true},{"text":"heyo ayo ngome mkipindi cha magazo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wose odijuwa twaga jako okutamanila,","poem":1},{"lineBreak":true},{"text":"kwavija gweye Mndewa Imulungu huwasemwile bule wose okwizila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mtogoleni Mndewa Imulungu, yokala Sayuni!","poem":1},{"lineBreak":true},{"text":"Walongeleni iwanhu wose sang'hano zake!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kwavija ayo yolihaga mbuli ya kwita damu kokumbuka,","poem":1},{"lineBreak":true},{"text":"haisemwile ikililo cha wakiwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Go Mndewa Imulungu, unyonele bazi,","poem":1},{"lineBreak":true},{"text":"lola magazo gangu kulawa kwa awo onihila,","poem":1},{"lineBreak":true},{"text":"uninule kulawa mmilango ya ifa,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ili nizisimulile nhogolwa zako mmilango ya biti Sayuni,","poem":1},{"lineBreak":true},{"text":"na kuko nideng'helele ukombola wako.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Iwanhu wa isi ziyagwe wadumbukila mdisimo diwahimbile,","poem":1},{"lineBreak":true},{"text":"kuna ulwavu waufisile, onzeka magulu gao.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu kaigubula mwenyego kwa haki yake,","poem":1},{"lineBreak":true},{"text":"iwanhu wehile wagogigwa mna umtego wa sang'hano za makono gao wenyego.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Iwanhu otenda gehile obwela kuzimu,","poem":1},{"lineBreak":true},{"text":"iwanhu wa isi zose omsemwa Imulungu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Lakini ngaengae hawasemwigwa milele,","poem":1},{"lineBreak":true},{"text":"na tamanilo da wakiwa hadisegela milele.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Go Mndewa Imulungu, winuke,","poem":1},{"lineBreak":true},{"text":"sikuumuleke munhu yehile yahume,","poem":1},{"lineBreak":true},{"text":"leka iwanhu wa isi zose watagusigwe kuulongozi wako.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Go Mndewa Imulungu, wagele bwembwe,","poem":1},{"lineBreak":true},{"text":"leka iwanhu wa isi zose wajuwe kamba hewo wanhu tu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}