{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":90,"content":[{"type":"heading","content":["ZABULI YA 90"]},{"type":"hebrew_subtitle","content":["(Kupula kwa Musa, munhu wa Imulungu.)"]},{"type":"verse","number":1,"content":[{"text":"Go Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"gweye kwa kae yetu muulelo wose.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Vigongo ving'hali havinakoneka,","poem":1},{"lineBreak":true},{"text":"na gweye ung'hali hunalumba isi yose,","poem":1},{"lineBreak":true},{"text":"gweye kwa Imulungu kulawa milele mbaka milele.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kowabweza iwanhu kuditimbwisi,","poem":1},{"lineBreak":true},{"text":"gweye kolonga, “Bweleni kuditimbwisi, mweye iwanhu.”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kwavija kumwako miyaka elufu kamba siku imoja ibitile,","poem":1},{"lineBreak":true},{"text":"hebu kamba kuwasilila kilo kimoja.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kowasegesa iwanhu muutulo wa ifa,","poem":1},{"lineBreak":true},{"text":"na hewo kamba mijani mibisi ya imitondo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hamoja imitondo yozuka,","poem":1},{"lineBreak":true},{"text":"ichungulo yoholola na kunyala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tubanangwa kwa ng'hasiliki yako,","poem":1},{"lineBreak":true},{"text":"na ukali wako otudumbiza.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kugeka gehile getu kuulongozi wako,","poem":1},{"lineBreak":true},{"text":"nzambi zetu za kinyelegezi zokoneka mumng'alo wako.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tukala siku zetu zose hasi ya ng'hasiliki yako,","poem":1},{"lineBreak":true},{"text":"twishiliza miyaka yetu kamba mhumuzi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Siku zetu za kukala miyaka malongo saba,","poem":1},{"lineBreak":true},{"text":"kamba tuna nguvu tokala miyaka malongo nane,","poem":1},{"lineBreak":true},{"text":"lakini miyaka yose imema magazo na madununzo,","poem":1},{"lineBreak":true},{"text":"na yobita himahima na siye tolawanya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nani yojuwa nguvu ya ng'hasiliki yako?","poem":1},{"lineBreak":true},{"text":"Kwihilwa kwako kamba vitulondigwa kukudumba gweye.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tufunze kuzipeta siku zetu vinogile,","poem":1},{"lineBreak":true},{"text":"ili tupate ubala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Gweye Mndewa Imulungu, uwe na bazi!","poem":1},{"lineBreak":true},{"text":"Kokawa mbaka lini?","poem":1},{"lineBreak":true},{"text":"Tonele bazi wasang'hanaji wako.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Imitondo unishibishe unogelo wako hawishaga,","poem":1},{"lineBreak":true},{"text":"ili twimbe kwa deng'ho na tudeng'helele siku zose.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Utudeng'heze kamba zisiku vuutukoboze,","poem":1},{"lineBreak":true},{"text":"kamba miyaka itugazigwe.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Sang'hano zako zoneke kwa wasang'hanaji wako,","poem":1},{"lineBreak":true},{"text":"ukulu wako kwa wanao.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Utonele bazi gweye Mndewa Imulungu, Imulungu wetu,","poem":1},{"lineBreak":true},{"text":"uzimize sang'hano za makono getu,","poem":1},{"lineBreak":true},{"text":"ona uzimize sang'hano za makono getu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}