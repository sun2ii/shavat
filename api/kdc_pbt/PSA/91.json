{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":91,"content":[{"type":"heading","content":["ZABULI YA 91"]},{"type":"verse","number":1,"content":[{"text":"Heyo yokala hana uukalizi wa ayo yeli Uchanha Ng'hani,","poem":1},{"lineBreak":true},{"text":"yokala kudisisila da ayo yeli na udahi wose.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nomulongela Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"“Gweye ayo kimbililo jangu na ngome yangu,","poem":1},{"lineBreak":true},{"text":"Imulungu wangu, nikutamanila.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Heyo kokukombola na mtego wa imunhu yosaka,","poem":1},{"lineBreak":true},{"text":"na utamu wa kulokeza ukomaga iwanhu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kokugubika kwa mitipilo yake,","poem":1},{"lineBreak":true},{"text":"hasi ya mabawa gake kopata kimbililo,","poem":1},{"lineBreak":true},{"text":"kutamanilwa kwake kokuwa kamba ngao na zindiko.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sikuudumbe vinhu vidumbiza va ikilo,","poem":1},{"lineBreak":true},{"text":"hebu msale ubitaga imisi,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"hebu utamu wa kulokeza uwasepaga iwanhu kudiziza,","poem":1},{"lineBreak":true},{"text":"na utamu ukomaga imisi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kamba iwanhu elufu olagala behi yako,","poem":1},{"lineBreak":true},{"text":"iwanhu elufu kumi mwambu wako wa ukudila,","poem":1},{"lineBreak":true},{"text":"lakini gehile hagakukwesela gweye.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kolola kwa meso gako mwenyego,","poem":1},{"lineBreak":true},{"text":"na kokona iwanhu wehile viwokobozwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kwavija gweye kumtenda Mndewa Imulungu kimbililo jako,","poem":1},{"lineBreak":true},{"text":"na ayo yeli Uchanha Ng'hani kumtenda ukazi wako.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Avo haduhu gehile gonda gakupate gweye,","poem":1},{"lineBreak":true},{"text":"na mikubulo honda idikwesele hema jako.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kwavija Imulungu kowalagiza wasenga zake mbuli yako,","poem":1},{"lineBreak":true},{"text":"wakukalize mnzila yako.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mmakono gao okugoga,","poem":1},{"lineBreak":true},{"text":"ili sikuuikwale mgulu wako mdibwe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kowakanyaga simba na zoka,","poem":1},{"lineBreak":true},{"text":"mwana simba na nyoka kowahonda kwa magulu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mndewa Imulungu, kolonga,","poem":1},{"lineBreak":true},{"text":"“Nomkombola ayo yoninogela,","poem":1},{"lineBreak":true},{"text":"nomkaliza kwavija kodijuwa twaga jangu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yahanikema nomwidika,","poem":1},{"lineBreak":true},{"text":"nokuwa hamoja na heyo mmagazo,","poem":1},{"lineBreak":true},{"text":"nomkombola na nomgwaa ukulu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nomgwaa nhunza ya kukala mgima siku nyingi,","poem":1},{"lineBreak":true},{"text":"na nomulagusila ukombola wangu.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}