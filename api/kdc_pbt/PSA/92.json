verse","number":5,"content":[{"text":"Go Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"lola vizili ng'hulu sang'hano zako,","poem":1},{"lineBreak":true},{"text":"lola vigeli mazito magesa gako.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Zozolo hadaha kujuwa kinhu,","poem":1},{"lineBreak":true},{"text":"mbozi hadaha kujuwa gano,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"kamba iwanhu wehile odaha kuzuka kamba mijani,","poem":1},{"lineBreak":true},{"text":"wose otenda gehile odaha kugendelela,","poem":1},{"lineBreak":true},{"text":"lakini kimambukizo chao obanangigwa milele.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lakini gweye Mndewa Imulungu kwa uchanha milele.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Gweye Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"wanhu okwihila obanangwa,","poem":1},{"lineBreak":true},{"text":"wose otenda gehile opwililika.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gweye kunisagula kwa kunigidila mavuta ganogile uchanha yangu,","poem":1},{"lineBreak":true},{"text":"kunigwaa nguvu kamba za ng'ombe poli.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Meso gangu gawona iwanhu onihila walemelwa,","poem":1},{"lineBreak":true},{"text":"magwiti gangu gahulika kubanangwa kwa iwanhu otenda gehile kumwangu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Wene haki omweda kamba mtende,","poem":1},{"lineBreak":true},{"text":"okula kamba mwelezi wa Lebanoni.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Okuwa kamba mibiki ihandigwe mng'anda ya Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"omweda kuing'hambi ya Imulungu wetu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Muuvele okuwa wang'hali olela matunda,","poem":1},{"lineBreak":true},{"text":"okuwa wabisi kuno wamema nguvu,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"olonga, “Mndewa Imulungu katelela,","poem":1},{"lineBreak":true},{"text":"heyo ayo dibwe jangu, mmwake mduhu gehile.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}