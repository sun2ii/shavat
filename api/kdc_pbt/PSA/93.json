{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"heading","content":["ZABULI YA 93"]},{"type":"verse","number":1,"content":[{"text":"Mndewa Imulungu kotawala,","poem":1},{"lineBreak":true},{"text":"kavala ukulu,","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu kavala ukulu na nguvu.","poem":1},{"lineBreak":true},{"text":"Isi yose kaika goya, na haitigiswa ng'o.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kigoda chako cha ukulu kikala goya tangu umwaka,","poem":1},{"lineBreak":true},{"text":"gweye kukala kuko tangu umwaka yose.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Go Mndewa Imulungu, bahali ilava sauti,","poem":1},{"lineBreak":true},{"text":"bahali ibuma,","poem":1},{"lineBreak":true},{"text":"bahali ilava sauti ya ng'humbi yake.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Heyo mkulu kubanza mazi mengi vigobuma,","poem":1},{"lineBreak":true},{"text":"heyo mkulu kubanza ng'humbi ya bahali,","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu yokala uchanha ng'hani ayo mkulu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Go Mndewa Imulungu, amuli zako zotamanilwa,","poem":1},{"lineBreak":true},{"text":"kung'ala kwako kogela ulembo mng'anda yako milele.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}