{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":94,"content":[{"type":"heading","content":["ZABULI YA 94"]},{"type":"verse","number":1,"content":[{"text":"Go Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"Imulungu uwabwezelaga iwanhu gehile,","poem":1},{"lineBreak":true},{"text":"gweye Imulungu uwabwezelaga iwanhu gehile,","poem":1},{"lineBreak":true},{"text":"umwemwese sambi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Inuka gweye uwatagusaga iwanhu wa isi yose,","poem":1},{"lineBreak":true},{"text":"uwabwezele gaja golondigwa iwanhu wamemile bezi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mbaka lini iwanhu otenda gehile odeng'helela?","poem":1},{"lineBreak":true},{"text":"Go Mndewa Imulungu, mbaka lini?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ogida mbuli za bezi,","poem":1},{"lineBreak":true},{"text":"wose otenda gehile wamema kuitapa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Go Mndewa Imulungu, lola owahonda wanhu zako,","poem":1},{"lineBreak":true},{"text":"owadununza uhazi wako.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Omkoma mgane na munhu baki,","poem":1},{"lineBreak":true},{"text":"owachinja wana wakiwa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Na hewo olonga, “Mndewa Imulungu halola,","poem":1},{"lineBreak":true},{"text":"Imulungu wa Yakobo hajuwa bule.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tegelezeni mweye iwabozi hagati ha iwanhu zangu,","poem":1},{"lineBreak":true},{"text":"mweye wabozi lini mokuwa na nzewele?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Vino ayo yekile gwiti sikuyahulike?","poem":1},{"lineBreak":true},{"text":"Ayo yalumbile siso sikuyalole?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ayo yowazuma iwanhu wa isi yose sikuyakoboze?","poem":1},{"lineBreak":true},{"text":"Ayo yowafunza iwanhu sikuyajuwe?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu kogajuwa magesa ga iwanhu,","poem":1},{"lineBreak":true},{"text":"kojuwa kamba hagafaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Go Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kamweda imunhu yozumwa na gweye,","poem":1},{"lineBreak":true},{"text":"imunhu yofunzwa kwa malagizo gako.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Komtenda yabwihile siku za magazo,","poem":1},{"lineBreak":true},{"text":"mbaka simo vonda dihimbigwe mbuli ya iwanhu wehile.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kwavija Mndewa Imulungu hawalema wanhu zake,","poem":1},{"lineBreak":true},{"text":"hauleka uhazi wake.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nhaguso yokwima kabili kuna ihaki,","poem":1},{"lineBreak":true},{"text":"wose wene mizoyo igoloke oikweleleza.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nani yonda yanigombele niye mbuli ya iwanhu wehile?","poem":1},{"lineBreak":true},{"text":"Nani yonda yanitaze mbuli ya iwanhu wehile?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Maza Mndewa Imulungu sambi yanitaze himahima,","poem":1},{"lineBreak":true},{"text":"nahakalile tuluu mwiifa.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Vinongile, “Mgulu wangu otelebuka.”","poem":1},{"lineBreak":true},{"text":"Go Mndewa Imulungu, unogelo wako hawishaga unigoga.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ving'halile nogwaya mmoyo wangu,","poem":1},{"lineBreak":true},{"text":"tamanilo jako dinigwaa deng'ho mmoyo wangu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Gweye hudaha kuilumba na watawala olema haki,","poem":1},{"lineBreak":true},{"text":"otunga malagizo ga kugombela gehile.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Oilumba kuwavamila wene haki,","poem":1},{"lineBreak":true},{"text":"kuwatagusa ifa iwanhu hawatendile gehile.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Lakini Mndewa Imulungu kawa ngome yangu,","poem":1},{"lineBreak":true},{"text":"Imulungu wangu kawa dibwe da kuifisila.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Heyo kowaliha kwa nzambi zao,","poem":1},{"lineBreak":true},{"text":"na kowabananga kwa gehile gao,","poem":1},{"lineBreak":true},{"text":"Mndewa Imulungu, Imulungu wetu kowabananga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}