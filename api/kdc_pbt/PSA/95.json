{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"heading","content":["ZABULI YA 95"]},{"type":"verse","number":1,"content":[{"text":"Izoni tumwimbile Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"tumdeng'helele dibwe wa ukombola wetu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tuchole kuulongozi wake kwa nhogolwa,","poem":1},{"lineBreak":true},{"text":"tumdeng'helele kwa nyila.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kwavija Mndewa Imulungu ayo Imulungu mkulu,","poem":1},{"lineBreak":true},{"text":"na heyo ayo Mndewa mkulu kwa imilungu yose.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mmakono gake kagagoga mabonde ga isi yose,","poem":1},{"lineBreak":true},{"text":"hata kunhembeti ya vigongo vake heyo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bahali yake heyo, heyo kailumba,","poem":1},{"lineBreak":true},{"text":"na makono gake galumba isi inyalile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Izoni tumtambikile,","poem":1},{"lineBreak":true},{"text":"tumfugamile Mndewa Imulungu yatulumbile.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kwavija heyo ayo Imulungu wetu,","poem":1},{"lineBreak":true},{"text":"na siye twa wanhu zake na ng'hondolo wake yotulola goya.","poem":1},{"lineBreak":true},{"text":"Vinoga lelo mwahategeleze sauti yake.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sikumuitende mizoyo yenu midala kamba vimutendile ako Meliba,","poem":1},{"lineBreak":true},{"text":"na kamba vimutendile ako Masa kuluwala.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kuko iwahenga zenu wanigeza na wanipima,","poem":1},{"lineBreak":true},{"text":"hamoja wazona sang'hano zangu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Miyaka malongo mane nyona usungu kwa ulelo awo,","poem":1},{"lineBreak":true},{"text":"nilonga, “Wanhu wano mizoyo yao ipotela,","poem":1},{"lineBreak":true},{"text":"hawazitangile bule nzila zangu.”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Avo, niiduwila kwa ng'hasiliki yangu,","poem":1},{"lineBreak":true},{"text":"“Hawengila ng'o hanhu hangu ha kubwihila.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}