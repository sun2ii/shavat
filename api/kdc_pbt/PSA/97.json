{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":97,"content":[{"type":"heading","content":["ZABULI YA 97"]},{"type":"verse","number":1,"content":[{"text":"Mndewa Imulungu kotawala na isi ideng'helele,","poem":1},{"lineBreak":true},{"text":"visiwa videng'helele.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mawingu na ziza vomzunguluka,","poem":1},{"lineBreak":true},{"text":"haki na kutagusa avo chanduso cha kigoda chake.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Moto olongola kuulongozi wake,","poem":1},{"lineBreak":true},{"text":"na owasakaza iwanhu omdeta kila mwambu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lumwesa lwake lomwemwesa isi yose,","poem":1},{"lineBreak":true},{"text":"isi ilola na igwaya kwa bwembwe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Vigongo vilumbuka kamba uhota kuulongozi wa Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"kuulongozi wa Mndewa wa isi yose.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ulanga olonga haki yake,","poem":1},{"lineBreak":true},{"text":"na wanhu wose wawona ukulu wake.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wakone kinyala wose otambikila vinyago,","poem":1},{"lineBreak":true},{"text":"awo oitapa kwa vinhu havifaya,","poem":1},{"lineBreak":true},{"text":"mweye imilungu yose mfugamileni Mndewa Imulungu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sayuni ihulika na kudeng'helela,","poem":1},{"lineBreak":true},{"text":"mabuga ga Yuda gasekelela,","poem":1},{"lineBreak":true},{"text":"kwa nhaguso zako gweye Mndewa Imulungu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kwavija gweye Mndewa Imulungu ayo ukala uchanha,","poem":1},{"lineBreak":true},{"text":"uchanha ng'hani kubanza isi yose,","poem":1},{"lineBreak":true},{"text":"gweye kwa mkulu ng'hani kubanza imilungu yose.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mweye mumnogela Mndewa Imulungu, galemeni gehile,","poem":1},{"lineBreak":true},{"text":"heyo kozikaliza loho za wanhu zake,","poem":1},{"lineBreak":true},{"text":"na kowakombola kulawa mmakono ga iwanhu wehile.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mulenge umwizila mwene haki,","poem":1},{"lineBreak":true},{"text":"na deng'ho dimwizila munhu mwene moyo unogile.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mweye wene haki mdeng'heleleni Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"na mditogole twaga jake ding'ala.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}