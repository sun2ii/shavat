{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"heading","content":["ZABULI YA 98"]},{"type":"verse","number":1,"content":[{"text":"Mwimbileni Mndewa Imulungu lwila lwa sambi,","poem":1},{"lineBreak":true},{"text":"kwavija katenda sang'hano za unzonza.","poem":1},{"lineBreak":true},{"text":"Mkono wake ung'ala umgalila mhumo,","poem":1},{"lineBreak":true},{"text":"mkono wake mwenyego wene nguvu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu kaugubula ukombola wake,","poem":1},{"lineBreak":true},{"text":"mgameso ga iwanhu wa isi zose kaigubula haki yake.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kaukumbuka unogelo wake hawishaga na kutamanilwa kwake kwa ng'anda ya Izilaeli.","poem":1},{"lineBreak":true},{"text":"Kose kuihelela isi wawona ukombola wa Imulungu wetu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Isi yose imdeng'helele Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"inuleni sauti imbeni kwa deng'ho, imbeni lwila.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mtambikileni Mndewa Imulungu lwila kwa bango,","poem":1},{"lineBreak":true},{"text":"imbeni kwa bango na kwa sauti ya lwila.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kwa mhalati na ng'ombe sugu.","poem":1},{"lineBreak":true},{"text":"Deng'heleleni kuulongozi wa Mndewa Imulungu yeli Mndewa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bahali ibume na vose vikalaga mumo,","poem":1},{"lineBreak":true},{"text":"isi yose na awo okala mgati yake.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Vizanda vitowe makofi,","poem":1},{"lineBreak":true},{"text":"vigongo vimbe hamoja kwa deng'ho,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"kuulongozi wa Mndewa Imulungu,","poem":1},{"lineBreak":true},{"text":"yokwiza yaitaguse isi yose.","poem":1},{"lineBreak":true},{"text":"Koitagusa isi yose kwa haki,","poem":1},{"lineBreak":true},{"text":"na iwanhu wose wa mwiisi kamba viilondigwa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}