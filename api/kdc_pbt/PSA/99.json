{"translation":{"id":"kdc_pbt","name":"Biblia Kikutu","website":"https://ebible.org/Scriptures/details.php?id=kdc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdc","licenseNotes":null,"shortName":"PBT","englishName":"Kutu NT","language":"kdc","textDirection":"ltr","sha256":"4081d35689e868a5ead092e1f740667bbe1a492749271a4b14fbb478158f9454","availableFormats":["json"],"listOfBooksApiLink":"/api/kdc_pbt/books.json","numberOfBooks":39,"totalNumberOfChapters":732,"totalNumberOfVerses":20053,"languageName":"Kutu","languageEnglishName":"Kutu"},"book":{"id":"PSA","translationId":"kdc_pbt","name":"Zabuli","commonName":"Zabuli","title":"Kitabu cha Zabuli Zabuli","order":19,"numberOfChapters":150,"sha256":"755313b9968c95747035a1b44cf5cfcb59a1418d1e0953cc4274f2bcf8aca5b8","firstChapterNumber":1,"firstChapterApiLink":"/api/kdc_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kdc_pbt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"heading","content":["ZABULI YA 99"]},{"type":"verse","number":1,"content":[{"text":"Mndewa Imulungu kotawala,","poem":1},{"lineBreak":true},{"text":"wanhu wa isi zose wagwaye.","poem":1},{"lineBreak":true},{"text":"Kakala mkigoda cha undewa hagati ya viumbe weli na mabawa,","poem":1},{"lineBreak":true},{"text":"isi itigisike.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mndewa Imulungu mkulu ako Sayuni,","poem":1},{"lineBreak":true},{"text":"na heyo kauchanha ya iwanhu wa isi yose.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wanhu waditogole twaga jake kulu da kudumbiza,","poem":1},{"lineBreak":true},{"text":"heyo ayo yong'ala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mndewa kana nguvu na koinogela haki,","poem":1},{"lineBreak":true},{"text":"gweye ayo uitawala haki,","poem":1},{"lineBreak":true},{"text":"kugala nhaguso na haki kwa Izilaeli.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mtogoleni Mndewa Imulungu, Imulungu wetu,","poem":1},{"lineBreak":true},{"text":"fugameni hana ikigoda cha magulu gake,","poem":1},{"lineBreak":true},{"text":"heyo ayo yong'ala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Musa na Haluni wa hagati ya iwalava nhosa wake,","poem":1},{"lineBreak":true},{"text":"na Samweli mna iwao odikema twaga jake,","poem":1},{"lineBreak":true},{"text":"viwamkemile Mndewa Imulungu kawedika.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mmhanda ya wingu kakala kolonga na hewo.","poem":1},{"lineBreak":true},{"text":"Wazigoga amuli zake na lagizo diyawagwelele.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gweye Mndewa Imulungu, Imulungu wetu,","poem":1},{"lineBreak":true},{"text":"gweye ayo uwedike Waizilaeli,","poem":1},{"lineBreak":true},{"text":"kumwao kukala Imulungu ugela kumgongo,","poem":1},{"lineBreak":true},{"text":"hamoja kugatagusa gehile gao.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mtogoleni Mndewa Imulungu, Imulungu wetu,","poem":1},{"lineBreak":true},{"text":"fugameni kulozela kulugongo lwake lung'ala,","poem":1},{"lineBreak":true},{"text":"kwavija Mndewa Imulungu, Imulungu wetu kong'ala.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kdc_pbt/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdc_pbt/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kdc_pbt/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}