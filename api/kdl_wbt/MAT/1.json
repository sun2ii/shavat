{"translation":{"id":"kdl_wbt","name":"Kazuwamgbani ka savu n Tsikimba n aɓon a ɗa a ɗanga̱sai a kazuwamgbani ka cau","website":"https://ebible.org/Scriptures/details.php?id=kdlNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kdlNT","licenseNotes":null,"shortName":"WBT","englishName":"Tsikimba NT","language":"kdl","textDirection":"ltr","sha256":"10e25ae697ee892d10a229b76678824b381e235e6752dd552fbb822e46dbd222","availableFormats":["json"],"listOfBooksApiLink":"/api/kdl_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7910,"languageName":"Tsikimba","languageEnglishName":"Tsikimba"},"book":{"id":"MAT","translationId":"kdl_wbt","name":"Matiyu","commonName":"Matiyu","title":"Kadyanshi ka Shinga ka Matiyu","order":40,"numberOfChapters":28,"sha256":"a89ead35e7a98c07f3252f108bd1d0d14196bc3474e34ce6bcd7f292f0b16650","firstChapterNumber":1,"firstChapterApiLink":"/api/kdl_wbt/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/kdl_wbt/MAT/28.json","totalNumberOfVerses":1071},"chapter":{"number":1,"content":[{"type":"heading","content":["Nkoshi n cau n Yesu"]},{"type":"verse","number":1,"content":["Yesu† Kawauwi† u wuta̱ ta̱ a kuwa ku Dawuda† Magono, matsikaya ma Ibirahi.† Makeci ma nkoshi n cau n ne ma na:"]},{"type":"verse","number":2,"content":[{"text":"Ibirahi ɗa tata u Ishaku.†","poem":1},{"lineBreak":true},{"text":"Ishaku ɗa tata u Yakubu.†","poem":1},{"lineBreak":true},{"text":"Yakubu ɗa tata u Yahuza† na̱ mmuku ma aꞌali n roku.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yahuza ɗa tata u mpeshe n ɗa a ka isa̱ Farisa n Zera.","poem":1},{"lineBreak":true},{"text":"(Mma u le ɗa Tama.)","poem":1},{"lineBreak":true},{"text":"Farisa ɗa tata u Hesuruna.","poem":1},{"lineBreak":true},{"text":"Hesuruna ɗa tata u Aram.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aram ɗa tata u Aminadabu.","poem":1},{"lineBreak":true},{"text":"Aminadabu ɗa tata u Nashon.","poem":1},{"lineBreak":true},{"text":"Nashon ɗa tata u Salumuna.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Salumuna ɗa tata u Boza.","poem":1},{"lineBreak":true},{"text":"(Mma u ne kpam Raha.)†","poem":1},{"noteId":0},{"lineBreak":true},{"text":"Boza ɗa tata u Ubida.","poem":1},{"lineBreak":true},{"text":"(Mma u ne kpam Rutu.)","poem":1},{"noteId":1},{"lineBreak":true},{"text":"Ubida ɗa tata u Yese.†","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yese ɗa tata u Dawuda Magono.","poem":1},{"lineBreak":true},{"text":"Dawuda ɗa tata u Solomo.","poem":1},{"lineBreak":true},{"text":"(Mma u ne kpam Beteshaba ɗa uza ɗa Dawuda bokoi ara Uriya.)","poem":1},{"noteId":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Solomo ɗa tata u Rihobuwam.","poem":1},{"lineBreak":true},{"text":"Rihobuwam kpam tata u Abija.","poem":1},{"lineBreak":true},{"text":"Abija ɗa tata u Asa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asa ɗa tata u Johoshafa.","poem":1},{"lineBreak":true},{"text":"Johoshafa kpam tata u Joram.","poem":1},{"lineBreak":true},{"text":"Joram ɗa tata u Azariya.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Azariya ɗa tata u Jotam.","poem":1},{"lineBreak":true},{"text":"Jotam ɗa tata u Ahazu.","poem":1},{"lineBreak":true},{"text":"Ahazu ɗa tata u Hazikaya.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hazikaya ɗa tata u Manase.","poem":1},{"lineBreak":true},{"text":"Manase ɗa tata u Amo.","poem":1},{"lineBreak":true},{"text":"Amo ɗa tata u Josaya.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Josaya ɗa tata u Jakoniya na̱ mmuku ma aꞌali n roku. (Aꞌayin yi a ɗa a ka̱na̱ le ubana a uyamba u Babila.)†","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"An a bidya le ubana a Babila:","poem":1},{"lineBreak":true},{"text":"Jakoniya ɗa tata u Shayala̱tiya.","poem":1},{"lineBreak":true},{"text":"Shayala̱tiya ɗa tata u Zerubabe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zerubabe ɗa tata u Abihuda.","poem":1},{"lineBreak":true},{"text":"Abihuda ɗa tata u Eliyakim.","poem":1},{"lineBreak":true},{"text":"Eliyakim ɗa tata u Azuro.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Azuro ɗa tata u Saduku.","poem":1},{"lineBreak":true},{"text":"Saduku ɗa tata u Akimu.","poem":1},{"lineBreak":true},{"text":"Akimu ɗa tata u Aliyuda.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aliyuda ɗa tata u Iliyazara.","poem":1},{"lineBreak":true},{"text":"Iliyazara ɗa tata u Matan.","poem":1},{"lineBreak":true},{"text":"Matan ɗa tata u Yakubu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yakubu ɗa tata u Isuhu.†","poem":1},{"lineBreak":true},{"text":"Isuhu ɗa vali u Meri.†","poem":1},{"lineBreak":true},{"text":"Meri kpam aya mma u Yesu uza ɗa ama a ka isa̱ Kirisiti† Kawauwi.","poem":1}]},{"type":"verse","number":17,"content":["Gba̱ aza ɗa a kecei nala vi, akaya a ɗa aꞌa̱ri pini a ɗa; akaya kupa n a nishi ili iꞌya i ka̱na̱i Ibirahi hal ubana aꞌayin a Dawuda Magono, n akaya kupa n a nishi ili iꞌya i ka̱na̱i aꞌayin a Dawuda hal ubana aꞌayin a ɗa a pura̱ le ubana a Babila tsugbashi. N akaya kupa n a nishi ili iꞌya i ka̱na̱i aꞌayin a ɗa a pura̱ le ubana a Babila tsugbashi utuwa̱ aꞌayin a Kawauwi."]},{"type":"heading","content":["Ilimaci i Yesu Kawauwi"]},{"type":"verse","number":18,"content":["Tyoku ɗa ilimaci i Yesu Kawauwi iꞌa̱ri ɗa na: Mma u ne u ɗa Meri uza ɗa Isuhu kenei tsumana. Shegai eyi a makere bawu u revei vali, aku u ka̱na̱i katsuma̱ n Kulu Keri.†"]},{"type":"verse","number":19,"content":["Isuhu kamana ka Meri, vuma ɗa u tsu rongo uyan ili iꞌya iꞌa̱ri derere, wa ciga u nei Meri vi uwono a aꞌeshi a ama wa, aku u yawunsai u a̱sa̱ka̱ yi usokongi."]},{"type":"verse","number":20,"content":["Aꞌayin a ɗa wa̱ri pini uyawunsa ukuna vi, aku katsumate ka zuba† ka Magono ma Zuba ka wenikei kaci ka ne ara ne a asuvu a alavutanshi, u danai, “Isuhu, matsikaya ma Dawuda, kotsu vu pana uwonvo u ɗa va zuwa kamana ka vunu Meri wa, kpaci Kulu Keri ka ku zuwa yi u ka̱na̱ katsuma̱ ki."]},{"type":"verse","number":21,"content":["Wa matsa ta̱ maku ma vali, aku vu neke yi kala Yesu,",{"noteId":3},"kpaci wa wauwa ta̱ ama a asuvu a unyushi u cingi u le.”"]},{"type":"verse","number":22,"content":["Ukuna u na vi u gita̱ ta̱ tsa̱ra̱ kazuwamgbani ka Magono ma Zuba ka shaɗangu, tyoku ɗa Ishaya† matsumate† u danai caupa,"]},{"type":"verse","number":23,"content":[{"text":"“Makere ma bawu ma revei vali ma yan ta̱ katsuma̱,","poem":1},{"lineBreak":true},{"text":"u matsa maku ma vali,","poem":1},{"lineBreak":true},{"text":"aku a isa̱ yi Imanuwe.”","poem":1},"Kalen ka kala ki ka, “Kashila̱ ka̱ ta̱ kaɓolo n a̱tsu.”"]},{"type":"verse","number":24,"content":["Aꞌayin a ɗa Isuhu rikpa̱na̱ka̱i, aku u yain dere tyoku ɗa katsumate ki ka tonuko yi. U tukoi Meri a kuwa u woko uka u ne."]},{"type":"verse","number":25,"content":["Shegai u vaku n eyi wa hal u matsai maku mi. Aku Isuhu neke yi kala Yesu."]}],"footnotes":[{"noteId":0,"caller":"+","text":"Raha kashankala ka Awulawa ka.","reference":{"chapter":1,"verse":5}},{"noteId":1,"caller":"+","text":"Rutu Kawulawa ka.","reference":{"chapter":1,"verse":5}},{"noteId":2,"caller":"+","text":"Dawuda vaku ta̱ n Beteshaba eyi n u woli Uriya, aku u yain ili i roku tsa̱ra̱ vali u ne Uriya u kuwa̱. A ka tsa̱ra̱ ta̱ alabari a na yi a tagara̱da u 2 Samaꞌila 11:1-27.","reference":{"chapter":1,"verse":6}},{"noteId":3,"caller":"+","text":"Kalen ka kala ka “Yesu” ka “Iwauwi.”","reference":{"chapter":1,"verse":21}}]},"thisChapterLink":"/api/kdl_wbt/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kdl_wbt/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":25}