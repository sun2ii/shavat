{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"ISA","translationId":"kij_png","name":"AISEA","commonName":"AISEA","title":"AISEALa Buki","order":23,"numberOfChapters":66,"sha256":"35c36b40b323f0012a0b003dfcd84fce7b1617aec6fbcdcee7f4132e12033561","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/kij_png/ISA/66.json","totalNumberOfVerses":1285},"chapter":{"number":51,"content":[{"type":"heading","content":["Yerusalem kala kabwaila"]},{"type":"verse","number":1,"content":[{"text":"E Guyau ikaibiga kawala,","poem":1},{"lineBreak":true},{"text":"“Kunakaigalaigusi availa yokomi magimi bakatumovaimi,","poem":1},{"text":"yokomi goli lokumakaiagusi paila pilasi.","poem":2},{"text":"Biyelu ninami bukuninamsaisi pwaipwaia","poem":1},{"text":"makwaina yokomi lokutoyasi lokumaisi","poem":2},{"lineBreak":true},{"text":"baisa goli tubumyou makwaina lokusunapulasi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Biyelu ninami bukuninamsaisi tubumi Eberaam,","poem":1},{"text":"deli minana Sera, dalem leitetila leima metoya matausina.","poem":2},{"text":"Tuta matutona Eberaam gala litula, yeigu adaubogwi wala matauna;","poem":1},{"text":"yeigu amitukwaii matauna e asaiki litula.","poem":2},{"text":"E avigaki dalela saina bidugaga sainela.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Yeigu banokapisi Yerusalem,","poem":1},{"text":"deli komwaidona tomotala isisuaisi olumoulela mavilouna viloudadaimi.","poem":2},{"text":"Ilagoli pwaipwaiala bogwa eiviloupakala","poem":1},{"text":"mitaga yeigu bavigaki wala bimila bagula","poem":2},{"lineBreak":true},{"text":"makawala bagula makwaina lakaibiguli mapilana Ideni.","poem":2},{"text":"Mwasawa deli lagisa basaili baisa","poem":1},{"text":"e tomota biusiwosisi deli si yakaula deli binokagutokisi baisa yeigu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ulo tomota, kunakaigalaigusi,","poem":1},{"text":"kunakaigalaisi avaka balivali.","poem":2},{"text":"Yeigu avituloki boda ituwoli ituwoli,","poem":1},{"text":"e ulo karaiwaga bivigaki si lumalama.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yeigu bogwa bananakwa bama paila bakatumovi matausina,","poem":1},{"text":"tutala ulo tomgaga bogwa leivakatitaikina.","poem":2},{"text":"Yeigu wala titoulegu baguyoi boda komwaidona.","poem":1},{"lineBreak":true},{"text":"Availa availa isisuaisi omiloutala itutulaigusi paila bawa,","poem":1},{"text":"matausina itulotulasi deli si pikwaku paila bakatumovi matausina.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kukounakailasi labuma, kukululukwaisi valu watanawa!","poem":1},{"lineBreak":true},{"text":"Labuma bitamwau makawala mseu","poem":1},{"text":"e valu watanawa bidadaimi makawala karekwa yadidadaimi,","poem":2},{"lineBreak":true},{"text":"e tomotala komwaidona bikaligasi makawala nigunagu.","poem":2},{"text":"Mitaga ulo katumova bamai makwaina","poem":1},{"text":"kwekanuvagasi tuta gala biwokuva","poem":2},{"lineBreak":true},{"text":"e ulo tomgaga baisa vavagi kala vigimkovila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Kunakaigalaigusi, availa yokomi kunikolaisi avaka duwosisia.","poem":1},{"lineBreak":true},{"text":"E yokomi goli kuyosikikitaisi ulo vituloki metoya oninami.","poem":1},{"lineBreak":true},{"text":"Taga kukokolasi avai tuta tomota bikapokaimi deli bibigigagaimi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Matausina bitamwausi makawala karekwa liwoliusa bitadidaimisi!","poem":1},{"lineBreak":true},{"text":"Mitaga ulo katumova bikanuvagasi,","poem":1},{"text":"ulo tomgwaga bikanigaga goli tuta gala wala biwokuva.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mwa Guyau, kumamata, e kupilasaimasi!","poem":1},{"text":"Kukolaimasi metoya om peula","poem":2},{"lineBreak":true},{"text":"kuvigaki makawala lokuuvagi tuta omitibogwa.","poem":2},{"text":"Yoku wala matoulem lokutagigai minana dokanikani obolita yagala Reyabi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tuvaila yoku wala lokuvigaki bolita leimada","poem":1},{"text":"e lokukivi keda eisuwalai sopi,","poem":2},{"lineBreak":true},{"text":"e matausina lokukoli gagabila biluvapelasi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Matausina availa lokukoli","poem":1},{"text":"biviloubusisi Yerusalem deli si mwasawa,","poem":2},{"lineBreak":true},{"text":"iusiwosisi deli govasi paila si mwasawa.","poem":2},{"text":"Matausina biluva uwosi metoya ninamwau deli valam,","poem":1},{"text":"e si mwasawa bikanuvagasi tuta gala biwokuva,","poem":2},{"lineBreak":true},{"text":"e gala avai tuta bibodasi ninamwau deli valam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":["E Guyau ilivala kawala,",{"text":"“Yeigu goli lakatupewolaimi.","poem":1},{"lineBreak":true},{"text":"Avaka paila bukukukolaisi tomota?","poem":1},{"lineBreak":true},{"text":"Ka, matausina gala bisivagasisi makawala mnumonu wala!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ki, kaina bogwa lokulumwelavaisi Guyau","poem":1},{"text":"matauna kami tobubuli,","poem":2},{"lineBreak":true},{"text":"matauna leikatuvakai labuma","poem":2},{"lineBreak":true},{"text":"e ivitau valu watanawa tumilela?","poem":2},{"text":"Avaka paila tuta komwaidona bukusisuaisi deli wala kami kokola","poem":1},{"text":"metoya okasi leiya matausina eilamidadaimi,","poem":2},{"lineBreak":true},{"text":"deli matausina eikatubaiasasi mwada bikatumataimi.","poem":2},{"text":"Matausina kasi leiya gala goli gagabila bikabikonaimi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tuta pikekita availa availa matausina mina katupipi bibanaisi taneku,","poem":1},{"text":"matausina bisisuaisi tuta kaduwonaku","poem":2},{"lineBreak":true},{"text":"e bibanaisi komwaidona kaula bibudoki matausina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Yeigu Guyau mi Yaubada,","poem":1},{"text":"e yeigu bakatuluwi bolita","poem":2},{"lineBreak":true},{"text":"e bavigaki kaisai bikawoula.","poem":2},{"text":"Yeigu yagagu Guyau Topeuligaga!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Lakatuvakai labuma kala beiyaya","poem":1},{"text":"e lavitau valu watanawa tumilela.","poem":2},{"text":"Aluki mina Yerusalem kawagu, ‘Yokomi ulo tomota!","poem":1},{"text":"Bogwa lasakaimi ulo vituloki","poem":2},{"text":"e oyamagu bogwa lakolaimi.’”","poem":1}]},{"type":"heading","content":["Yerusalem kala mmayuyu kala vigimkovila"]},{"type":"verse","number":17,"content":[{"text":"Yerusalem, kumamata!","poem":1},{"lineBreak":true},{"text":"Kusimalaula e kutokaia!","poem":1},{"lineBreak":true},{"text":"Yoku bogwa lokumom ovigala mipuki","poem":1},{"text":"baisa Guyau ola gibuluwa bogwa leivimomwaim,","poem":2},{"lineBreak":true},{"text":"yoku lokumom lokukwatukovi makwelana leivigakaim kusilibeibeu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Gala wala taitala isisu paila bikugwaiyaim,","poem":1},{"text":"e gala taitala oluwalaisi m tomota","poem":2},{"lineBreak":true},{"text":"biyosaim oyamam bivakadaim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ka, kabomwau kwaiyu bogwa lokubodasi.","poem":1},{"lineBreak":true},{"text":"Mi pwaipwaia bogwa leiyogagaisi metoya okabilia,","poem":1},{"text":"e mi tomota kasi molu wala.","poem":2},{"text":"Gala wala availa ibodi binokapisaimi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Okatugulugelu keda kadatala kadatala","poem":1},{"text":"mi tomota immaki uwosi ikikapusisi,","poem":2},{"lineBreak":true},{"text":"matausina makawala ugiwagi dia biwaisi okasi sikula toweiga.","poem":2},{"text":"Matausina bogwa leilumkolaisi lutula Yaubada la gibuluwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Yokomi mina Yerusalem lokubodasi mmayuyu,","poem":1},{"text":"yokomi goli lokusilubeibeusi makawala lokumommatasi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Guyau mi Yaubada matauna ikolaimi eilivala kawala,","poem":1},{"lineBreak":true},{"text":"“Ka, bogwa bakau baligaim viga makwelana","poem":1},{"text":"lasakaimi metoya ogu gibuluwa.","poem":2},{"text":"E gala tuvaila bukumomwaisi kami waini makwaina","poem":1},{"text":"tuta komwaidona leivigakaimi lokusilubeibeusi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yeigu bakau makwelana basaiki availa matausina leilamidadaimi,","poem":1},{"text":"deli basaiki availa matausina leivigakaimi lokukwanukwenusi olopola valu","poem":2},{"lineBreak":true},{"text":"e iuvakikilaimi makawala tubumyou.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kij_png/ISA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":23}