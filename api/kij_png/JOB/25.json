{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"JOB","translationId":"kij_png","name":"YOBI","commonName":"YOBI","title":"YOBILa Buki","order":18,"numberOfChapters":42,"sha256":"8af9afc9b4bf6f559be3e9baf6c5e41227ba9dc5eb9b5a27204f276e738064bc","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/kij_png/JOB/42.json","totalNumberOfVerses":1036},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":[{"text":"Yaubada saina Topeuligaga, e komwaidosi wala ibodi bikamiabaisi matauna;","poem":1},{"text":"paila labuma la valu viluwela vakota.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ki, availa ibodi bikalau anelosi kasi bawa eiwotitalaisi matauna?","poem":1},{"lineBreak":true},{"text":"Ki kudoki avai valu Yaubada la lumalama gala ivisigili?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Avai tau gagabila bidoki titoulela tomitukwaibwaila deli migileu nanola omatala Yaubada?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Omatala Yaubada tubukona lumalamela gala ipeula,","poem":1},{"text":"deli utuyam visigasi gala wala migileu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"E ammakawalaga tomota, matauna saina towatanawa","poem":1},{"text":"makawala mwatemwata kaina minumauna?","poem":2},{"text":"E ammakawalaga Yaubada bigigisi kala bwaina tomota, ki isim dimlela kaina?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kij_png/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":5}