{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"JOB","translationId":"kij_png","name":"YOBI","commonName":"YOBI","title":"YOBILa Buki","order":18,"numberOfChapters":42,"sha256":"8af9afc9b4bf6f559be3e9baf6c5e41227ba9dc5eb9b5a27204f276e738064bc","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/kij_png/JOB/42.json","totalNumberOfVerses":1036},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":[{"text":"Mitaga baisa tuta tubovau bikikatudeuwaigusi wala!","poem":1},{"lineBreak":true},{"text":"Matausina tumisia tuta komwaidona gala wala dimlesi,","poem":1},{"text":"e yeigu gala wala ibodi batugwali matausina bipilasaisi","poem":2},{"lineBreak":true},{"text":"ulo kaukwa paila biyamatasi sipi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Matausina budotala tomamama","poem":1},{"text":"saina mama uwosi gala gagabila bipilasaigusi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Matausina saina tonamakava,","poem":1},{"text":"deli bigigadi wala molu","poem":2},{"lineBreak":true},{"text":"avai tuta bibogi ovilouwokuva,","poem":2},{"lineBreak":true},{"text":"e mwada kailawalisi kai bivigakaisi kʹasi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"E avai vavagi wala bisususinasi oviloupakala","poem":1},{"text":"matausina ivigakaisi kʹasi,","poem":2},{"lineBreak":true},{"text":"deli goli avai vavagi","poem":2},{"lineBreak":true},{"text":"gala takamkoma matausina bikomasi wala!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"E tomota komwaidona ikawotasi ikaliyabaisi matausina,","poem":1},{"text":"makawala wala kasi kavilaki toveilau.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Matausina isipepunisi wa lagi kaina onobwala","poem":1},{"text":"eikelaisi opapala dibodebula.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Olumoulela udila matausina bigougwausi","poem":1},{"text":"makawala mauna bigougwausi,","poem":2},{"lineBreak":true},{"text":"e bikanapitukwaisi wala gulitinidesi olawodila.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Matausina gweiluva deli gala wala dimlesi","poem":1},{"text":"gala bitadoki tauwau,","poem":2},{"lineBreak":true},{"text":"bogwa eikaliyabaisi matausina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mitaga baisa tuta matausina imaisi e igigilaigusi wala;","poem":1},{"text":"ivigakaigusi si kaboyousokana wala.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Matausina ikayuwaigusi;","poem":1},{"text":"si nanamsa mwada avaka si lamamada baisa yeigu","poem":2},{"lineBreak":true},{"text":"ivigakaisi si kabomwasawa sainela,","poem":2},{"lineBreak":true},{"text":"deli goli imaisi igiuwaisi migigu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Paila Yaubada bogwa eiyomami wowogu mamawokuva wala,","poem":1},{"text":"mauula deli kasi leiya ilamidadaigusi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tomota mabudona ikabiliaigusi e ikalisalaigusi;","poem":1},{"text":"matausina ikatuliloiyaigusi wala;","poem":2},{"lineBreak":true},{"text":"e ikatubaiasasiga avaka si nanamsa kala vigimkovila paila yeigu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Matausina ivabodaisi ulo keda mwada bikatumataigusi;","poem":1},{"text":"e gala wala availa bisibodi matausina.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ambaisa lavigaki ulo kabokwala matausina ikodidaimsi,","poem":1},{"text":"e iwokaiagusi wala ikanakailagusi;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"e kokola wala ikatumataigu;","poem":1},{"text":"yeigu ulo sisu walakaiwa iwokuva makawala myala yagila, bimya wala bima, bimyeia;","poem":2},{"lineBreak":true},{"text":"deli goli ulo kaisisu kala bwaina eitamwau makawala lowalowa, bibeu wala bimai e bilau.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mapaila makateki wala bakaliga;","poem":1},{"text":"paila gala wala sitana abani agu yovaiwasi","poem":2},{"lineBreak":true},{"text":"metoya agu mmayuyu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Avai tuta bibogi totuwanegu komwaidona bikamkumku","poem":1},{"text":"wala biwokuva metoya gidageda makwaina,","poem":2},{"lineBreak":true},{"text":"gala iukuwokuva, tuta komwaidona bigweimilaigu wala.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yaubada ilitaki agu kwarekwa okaigadugu;","poem":1},{"text":"e ikodidaimi wala dadaimiwokuva miyasina.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Matauna ilavaigu ala opwadidiweta;","poem":1},{"text":"e agu gigisa gala tagiligali makawala wala pwadidiweta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"O Yaubada, adou baisa yoku,","poem":1},{"text":"mitaga gala wala avai tuta kuvitakaulokaigu;","poem":2},{"lineBreak":true},{"text":"e avai tuta banigada gala wala kulilagi ulo nigada.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yoku kuvakatutukwaigu saina mmayuyu;","poem":1},{"text":"deli kulamidadaigu metoya om peula komwaidona.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yoku kutugwali yagila biyuvisauwaigu;","poem":1},{"text":"deli kukwatuvivilaigu wala metoya outuyagila.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bogwa lanikoli makateki bukuvakaligaigu,","poem":1},{"text":"e balokaia oviluwela kaliga,","poem":2},{"lineBreak":true},{"text":"baisa goli lokukwatubiasi paila tomota komwaidona.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mwa, avaka paila kuyomiyuyu tau matauna togweiluva,","poem":1},{"text":"matauna goli gala kali yeiwau mesinaku binigada wala","poem":2},{"lineBreak":true},{"text":"baisa yoku paila bukunokapisi matauna?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ki kudoki gala auvilam tomota","poem":1},{"text":"matausina eibudobodasi mwau,","poem":2},{"lineBreak":true},{"text":"deli anokapisi tonamakava?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Yeigu lapikwaku babani ulo mwasawa deli babani lumalama","poem":1},{"text":"mitaga kaimapula abani mwau deli dudubila.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ninamwau deli mmayuyu bogwa wala eiyogagaigu,","poem":1},{"text":"yam kwaitala kwaitala agu mmayuyu isisiniveka wala.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Yeigu baliloula todubiyou wala, gala sitana subusobula wowogu;","poem":1},{"text":"yeigu batowala omitasi e bakayubabai paila pilasi.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Kaigagu butula saina kakapisi lula makawala kaigala","poem":1},{"text":"natana ugiwagi bigougwau; kaina makawala kasuwari bigilagela.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Kanuvinegu bogwa eivabwau;","poem":1},{"text":"e kuluyuviyavi eilulu wala olumoulegu.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Igau otobwailagu ulo kaisisu saina bwaina,","poem":1},{"text":"e gita deli loloni butusi kabomwasawa,","poem":2},{"lineBreak":true},{"text":"mitaga baisa tuta ninamwau deli valam eiyogibwaigu tuta komwaidona.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kij_png/JOB/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/JOB/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/JOB/29.json","previousChapterAudioLinks":{},"numberOfVerses":31}