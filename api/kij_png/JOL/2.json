{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"JOL","translationId":"kij_png","name":"YOWELI","commonName":"YOWELI","title":"YOWELILa Buki","order":29,"numberOfChapters":3,"sha256":"e8655a4fed3482b0429eda387222580b534a0e2b942c6b68ecc1c575eedf10ab","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/kij_png/JOL/3.json","totalNumberOfVerses":72},"chapter":{"number":2,"content":[{"type":"heading","content":["Nipawa bidubadu makawala kwaitala katumatila paila Guyau la yam"]},{"type":"verse","number":1,"content":[{"text":"Kuyuvaisi tauya. Kuyuvidousi odabala mapilana Saiyoni,","poem":1},{"noteId":0},{"text":"Yaubada la koya kwebumaboma.","poem":1},{"lineBreak":true},{"text":"Kutatuvasi yokomi mina Yuda!","poem":1},{"text":"Guyau la yam bogwa eivilalamila.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yam makwaina kwedudubila deli yam kwegugugu,","poem":1},{"text":"bivigaki kala bwau deli lowalowa.","poem":2},{"text":"Nipawa yuwoveka makawala tokwabilia bisuyaisi kulusi,","poem":1},{"text":"makawala dubilikitakita bikuboli odubasi koya.","poem":2},{"text":"Gala kwaitala vavagi makawala makwaina omitibogwa,","poem":1},{"text":"deli gala tuvaila bikaloubusi makawala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bikamdabwaisi kai makawala kova.","poem":1},{"text":"Omitasi isisu kwabila makawala Bigulela Ideni,","poem":2},{"lineBreak":true},{"text":"mitaga otuboulosi baisa katubakana viloupakala.","poem":2},{"lineBreak":true},{"text":"Gala kwaitala vavagi bikesa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kasi gigisa makawala wosa.","poem":1},{"text":"Bisakaulasi makawala wosala kabilia.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Biyuweitaulasi odubasi koya,","poem":1},{"text":"e bikogoregorasi makawala wogala kabilia kaibibiu.","poem":2},{"lineBreak":true},{"text":"Bisilakakupwanasi makawala mnumonu lubulabu wa kova.","poem":2},{"text":"Bitodelisi makawala budoveka tokwabilia bogwa eikatubaiasasi paila kabilia.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tutala imaisi, tomota ikokolasi","poem":1},{"text":"e taitala taitala migisi idavilasi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iyowaisi makawala tokwabilia,","poem":1},{"text":"e makawala tokwabilia imweimwenasi wa kali.","poem":2},{"text":"Komwaidosi ivautuutusi isaitaulasi duwosisia,","poem":1},{"text":"e gala isuvilasi","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"kaina isuwaisi osi keda sesia.","poem":2},{"text":"Imwenaisi okabosilaboda,","poem":1},{"text":"deli gala avaka gagabila bisilibodi minasina.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isuvaisi kulusi ovilouveka.","poem":1},{"text":"Iyuweitaulasi wa kali.","poem":2},{"lineBreak":true},{"text":"Imwenasi wa bwala","poem":2},{"lineBreak":true},{"text":"deli isuvisi owinidowa makawala touveilau.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Pwaipwaia iigayega avai tuta bisuyaisi kulusi,","poem":1},{"text":"e labuma imotatina.","poem":2},{"text":"Kalasia deli tubukona idudubilasi,","poem":1},{"text":"deli utuyam gala tuvaila bikatasi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Guyau ibutupilapala la karaiwaga baisa la tokwabilia.","poem":1},{"text":"Mabudosina tokwabilia ikabikuwolaisi matauna","poem":2},{"lineBreak":true},{"text":"tobobawa deli mina papeula.","poem":2},{"text":"Guyau la yam kaiyokwaila woula.","poem":1},{"text":"Availa gagabila bimova?","poem":2}]},{"type":"heading","content":["Guyau iluki bininavilasi"]},{"type":"verse","number":12,"content":[{"text":"Guyau ikaibiga, kawala, “Baisa tuta goli","poem":1},{"text":"kuninavilasi mokwita deli bukukweiitasi baisa yeigu,","poem":2},{"lineBreak":true},{"text":"deli mi posuma, deli mi valam e deli mi kavinavina.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kutugwalaisi ninami bikamituli mi ninamwau.","poem":1},{"text":"Gala wala ibodi bukusikammakavaisi kami kakapula.”","poem":2},{"lineBreak":true},{"text":"Kukwaimilavausi baisa Guyau mi Yaubada.","poem":1},{"text":"Matauna tolilalasi deli ivakasau nokapisi.","poem":2},{"lineBreak":true},{"text":"Matauna topeuloki, deli ivagi makawala la biga katotila.","poem":2},{"lineBreak":true},{"text":"Tuta komwaidona matauna ikatubaiasabogwa paila biligaiwa mitugaga e gala bimipuki.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kaina matauna Guyau mi Yaubada bivigivau nanola","poem":1},{"text":"e bimitukwaiyaimi metoya kabinaila mi pwaipwaia.","poem":2},{"text":"Oluvi yokomi gagabila bukululasi kaula deli waini baisa matauna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kuyuvaisi tauya wa Koya Saiyoni.","poem":1},{"text":"Kusakaisi tomota kasi karaiwaga biposumasi e kudousi tomota bisigugulasi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kukougugulaisi tomota.","poem":1},{"text":"Kukwatubiasaisi matausina paila sigugulela tapwaroru.","poem":2},{"lineBreak":true},{"text":"Kumaiyaisi tommoya.","poem":2},{"lineBreak":true},{"text":"Kumaiyaisi gugwadi,","poem":2},{"lineBreak":true},{"text":"deli goli pwapwawa.","poem":2},{"lineBreak":true},{"text":"E tuvaila matausina vavaigilavau","poem":2},{"lineBreak":true},{"text":"ibodi bisilavaisi si bwala e bimaisi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tolula matausina iwotitalaisi Guyau","poem":1},{"text":"oluwalela kabolula deli okabosusuvi wa Bwala Kwebumaboma.","poem":2},{"text":"Ibodi bivalamsi deli binigadasi, kawasi,","poem":1},{"text":"“Mwa Guyau! Kunokapisaimasi yakamaisi m tomota.","poem":2},{"lineBreak":true},{"text":"Taga kutagwala tuwoli tomota bikaluwouwaimasi deli biyosokanaimasi","poem":2},{"lineBreak":true},{"text":"kawasi, ‘Weei, ammatauwenaga mi Yaubada?’”","poem":2}]},{"type":"heading","content":["Yaubada ivigivau pwaipwaia kala kabinai"]},{"type":"verse","number":18,"content":[{"text":"Oluvi Guyau ininavila paila la pwaipwaia,","poem":1},{"text":"e inokapisi la tomota.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bogwa ivitakauloki si nigada,","poem":1},{"lineBreak":true},{"text":"kawala, “Baisa tuta basakaimi","poem":1},{"text":"kaula deli waini deli bulamila olibe,","poem":2},{"lineBreak":true},{"text":"e baisa avaka lasakaimi bibodaimi wala.","poem":2},{"lineBreak":true},{"text":"Boda ituwoli ituwoli gala tuvaila bikaluwouwaimi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bavabutu minasina nipawa leimaisi metoyasi opiliyavata makawala budotala tokwabilia.","poem":1},{"text":"Babokavili mimilisi minasina bilosi oviloupakala.","poem":2},{"text":"Kasi kasa okatumatala babokavili bilosi Milaveta Pilamata,","poem":1},{"text":"e kasi kasa oluvi bilosi oBolita Kwaiveka.","poem":2},{"lineBreak":true},{"text":"Uwosi biboginasi.","poem":2},{"text":"Bakatudoum minasina paila uula komwaidona avaka bogwa eivigakaimi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“E buyagu, ka, taga kukokolasi","poem":1},{"text":"mitaga ibodi bimwamwasila ninami e bukumwasawasi","poem":2},{"lineBreak":true},{"text":"paila komwaidona avaka Guyau bogwa leivagi paila yokomi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yokomi mauna, taga kukokolasi.","poem":1},{"text":"Mnumonu isemitamatasi.","poem":2},{"lineBreak":true},{"text":"Kai iwouwasi,","poem":2},{"lineBreak":true},{"text":"deli bidubadu kaiuwasi seuseu deli waini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“Yokomi mina Saiyoni,","poem":1},{"noteId":1},{"text":"bimwamwasila ninami.","poem":1},{"text":"Bukumwasawasi paila avaka Guyau mi Yaubada bogwa eivagi paila yokomi.","poem":2},{"lineBreak":true},{"text":"Bogwa isakaimi kuna okala tuta sopu,","poem":2},{"lineBreak":true},{"text":"e iligabu kuna otutala katubugibogi.","poem":2},{"lineBreak":true},{"text":"Kala kunobasi tayoyuwa isakaimi makawala tuta tuta eiuvagi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kabotutu makwaisina bikasewoki witi,","poem":1},{"text":"e mesi opapala kabopola bikasewoki kaiuwasi waini deli olibe.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Basakaivauwaimi avaka bogwa lokukitumouwaisi","poem":1},{"text":"wa taitu makwaisina mayuwosina nipawa leikomasi mi bagula.","poem":2},{"lineBreak":true},{"text":"Ka, yeigu goli lawitali mabudona nipawa leimaisi iyogagaimi.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Baisa tuta bukuyosisi bidubadu paila bukukwamsi, e bukukomatasi.","poem":1},{"text":"Bukuyakawolaigusi yeigu Guyau mi Yaubada","poem":2},{"lineBreak":true},{"text":"paila bogwa lavagi vavagi kabokatubau paila yokomi.","poem":2},{"lineBreak":true},{"text":"Yokomi ulo tomota gala availa tuvaila bikaluwouwaimi.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"E mina Isireli, ka - bukunikolaisi kidamwa yeigu asisu oluwalaimi,","poem":1},{"text":"deli yeigu goli Guyau mi Yaubada,","poem":2},{"lineBreak":true},{"text":"e gala avai Yaubada ituwoli isisu.","poem":2},{"lineBreak":true},{"text":"Yokomi ulo tomota gala availa tuvaila bikaluwouwaimi.","poem":2}]},{"type":"heading","content":["Guyau la yam"]},{"type":"verse","number":28,"content":[{"text":"“Igau oluvi baligabu ulo baloma baisa tomota komwaidosi.","poem":1},{"text":"Litumia tauwau deli vivila igau bikamitulaisi nanogu.","poem":2},{"lineBreak":true},{"text":"Mi tommoya mimi bimimisi,","poem":2},{"lineBreak":true},{"text":"deli mi totubovau bigisaisi kilisala.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Wa tuta makwaina baligabu ulo baloma","poem":1},{"text":"baisa touwata goli, tauwau deli vivila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"“Basaiki katumamatila paila yam makwaina","poem":1},{"text":"wa labuma deli ovalu watanawa,","poem":2},{"lineBreak":true},{"text":"baisa makawala bibubusi buyavi, e kova, deli kubowala mseu.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kalasia igau bidavila binadudubila","poem":1},{"text":"deli tubukona bikulubweyani makawala buyavi","poem":2},{"lineBreak":true},{"text":"igau gala bivitoulai la yam Guyau,","poem":2},{"lineBreak":true},{"text":"yam makwaiwena tubulela yam saina kabokokola sainela.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Mitaga komwaidona availa availa matausina inigadasi baisa yeigu Guyau paila pilasi,","poem":1},{"text":"e yeigu bogwa bakoli matausina.","poem":2},{"text":"Makawala yeigu Guyau lakaibiga, kawagu,","poem":1},{"text":"‘Mimilisi olopola Yerusalem bisakaulasi bibwainasi.","poem":2},{"lineBreak":true},{"text":"Availa availa matausina lanagi bogwa bimovasi.’”","poem":2}]}],"footnotes":[{"noteId":0,"caller":"a","text":"Makwaina koya mapilana Yerusalem tumilesi Bwala Kwebumaboma deli guyau la ligisa.","reference":{"chapter":2,"verse":1}},{"noteId":1,"caller":"b","text":"Baisa tuta ikibuboti kaina Yuda komwaidona kainaga mapilana Yerusalem.","reference":{"chapter":2,"verse":23}}]},"thisChapterLink":"/api/kij_png/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}