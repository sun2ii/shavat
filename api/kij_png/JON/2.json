{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"JON","translationId":"kij_png","name":"YOUNA","commonName":"YOUNA","title":"YOUNALa Buki","order":32,"numberOfChapters":4,"sha256":"a4b80219384784ebddd1672aad43c23916110349000ff6cbb711723eaab99276","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/kij_png/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Youna la nigada"]},{"type":"verse","number":1,"content":["Yena olopola, Youna inigada baisa Guyau la Yaubada. Ikaibiga, kawala,"]},{"type":"verse","number":2,"content":[{"text":"“Bogwa alumkoli agu mmayuyu mapaila ladouwaim yoku Guyau,","poem":1},{"text":"e lokumapu ulo biga.","poem":2},{"text":"Wa Tuma","poem":1},{"noteId":3},{"text":"lasisu adoudou mwada bukupilasaigu,","poem":1},{"text":"e kaigagu bogwa lokulagi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bogwa kulavaigu otulubwabwau","poem":1},{"text":"e ala otukutaku yelu itavinaigusi.","poem":2},{"lineBreak":true},{"text":"Kaisai kala kawoula komwaidona odabagu ikatutuwolaigu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nanogu adoki bogwa latamwau metoya omatam,","poem":1},{"text":"deli adokila gala bagisivau m Bwala Kwebumaboma.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Paila sopi bogwa leikubolaigu deli itabodi ulo yagisa.","poem":1},{"text":"Bolita ikubolaigu deli doudom ikatukwani okulugu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bogwa labusi osikowala koya,","poem":1},{"noteId":4},{"text":"valu makwaina","poem":2},{"noteId":5},{"text":"kala taboda ikatubodivigasi.","poem":2},{"text":"Mitaga yoku Guyau ulo Yaubada,","poem":1},{"text":"yoku kukwaimilivauwaigu metoya wa lagi kidamwa bamova.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tutala alumkoli ulo yagisa ikusokusa,","poem":1},{"text":"e ulo Guyau anigadaim,","poem":2},{"lineBreak":true},{"text":"e metoya om Bwala Kwebumaboma kunakaigalaigu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Matausina ititapwarorusi baisa tokolu gala isim dimlesi,","poem":1},{"text":"e matausina bogwa eiulilavaimsi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mitaga yeigu bawosi kam yakaula.","poem":1},{"text":"Bogwa basakaim kam lula,","poem":2},{"lineBreak":true},{"text":"e bogwa bavagi makawala ulo biga katotila.","poem":2},{"text":"Katumova leima metoya baisa Guyau.”","poem":1}]},{"type":"verse","number":10,"content":["Mapaila Guyau ikaraiwogi yena, e minana ilagobi Youna e ikasau ila okawolawa."]}],"footnotes":[{"noteId":3,"caller":"d","text":"Baisa si valu tomata.","reference":{"chapter":2,"verse":2}},{"noteId":4,"caller":"e","text":"Idokaisi koya kwevakaveka isim tumilesi otilibwabwau osikowala pwaipwaia.","reference":{"chapter":2,"verse":6}},{"noteId":5,"caller":"f","text":"Baisa si valu tomata saina watanawa osikowala pwaipwaia. Kugisi kaikobu deli kala katumiki Vit 7.11.","reference":{"chapter":2,"verse":6}}]},"thisChapterLink":"/api/kij_png/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}