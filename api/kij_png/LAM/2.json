{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"LAM","translationId":"kij_png","name":"KAVINAVINA","commonName":"KAVINAVINA","title":"KAVINAVINA","order":25,"numberOfChapters":5,"sha256":"f28589ce93d39bbdcb7fe3092c5af56ad928cd6e151f5b4aff92a632be92376b","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/kij_png/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"heading","content":["Guyau la mipuki baisa Yerusalem"]},{"type":"verse","number":1,"content":[{"text":"Metoya Guyau ola gibuluwa dudubalela","poem":1},{"text":"ikuboli viloumwaidona Saiyoni.","poem":2},{"lineBreak":true},{"text":"E avaka visigala kala gigisa makawala labuma guyugwayula","poem":2},{"lineBreak":true},{"text":"bogwa leivigaki eimila dubilawawa wala.","poem":2},{"lineBreak":true},{"text":"E wa yam makwaina eigibuluwa","poem":2},{"lineBreak":true},{"text":"matauna isilavi la Bwala Kwebumaboma goli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Guyau eikatudidaimi komwaidona mavilousina valu olopola Yuda,","poem":1},{"text":"gala wala deli la nokapisi.","poem":2},{"lineBreak":true},{"text":"Deli ivadidaimi makwaisina bolesi kabilia","poem":2},{"lineBreak":true},{"text":"mwada valu kala kabokwala.","poem":2},{"lineBreak":true},{"text":"Matauna iyomsili Yuda kabokaraiwaga","poem":2},{"lineBreak":true},{"text":"deli goli kala tokwaraiwaga komwaidosi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Metoya ola gidimleiya matauna ikatudidaimi mina Isireli si peula.","poem":1},{"text":"Matauna ivigili yamala avai tuta kama tilaulasi leimakaiamasi.","poem":2},{"lineBreak":true},{"text":"La gidimleiya baisa yakamaisi makawala kovatala kova,","poem":2},{"lineBreak":true},{"text":"leivakakovi vavagi komwaidona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Matauna leiyamwasaimasi okaiyala makawala goli tilaula yakamaisi.","poem":1},{"text":"Matauna ikatumati komwaidosi toulemasi,","poem":2},{"lineBreak":true},{"text":"matausina goli uulela ma mwasawasi.","poem":2},{"lineBreak":true},{"text":"E yakamaisi lakasisuaisi olopola Yerusalem","poem":2},{"lineBreak":true},{"text":"kalumkolaisi tigininila la gibuluwa makawala kova.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"E Guyau eivigaki Isireli makawala tilaula,","poem":1},{"text":"e bogwa eikodidaimi mavilouna.","poem":2},{"lineBreak":true},{"text":"Makwaisina bolela kabilia deli makwaisina ligisa","poem":2},{"lineBreak":true},{"text":"ikodidaimi wala imoi iligaim.","poem":2},{"lineBreak":true},{"text":"Matauna bogwa eiyomiyuyu sainela tomotala Yuda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"E ikatudidaimi Bwala Kwebumaboma","poem":1},{"text":"makwaina ma kabotapwarorusi;","poem":2},{"lineBreak":true},{"text":"matauna bogwa eikatubodi makwaisina yam kwebumaboma","poem":2},{"lineBreak":true},{"text":"deli goli yam Sabate.","poem":2},{"lineBreak":true},{"text":"E guyoula valu deli tolula ilumkolaisi lutula la gibuluwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"E Guyau bogwa eipaiki la kabogwabu lula","poem":1},{"text":"deli eisilavi la Bwala Kwebumaboma.","poem":2},{"lineBreak":true},{"text":"Matauna eiulisali tilaula bivakubalaisi kalila valu.","poem":2},{"lineBreak":true},{"text":"Mapaila matausina igovasi govala tomgwaga","poem":2},{"lineBreak":true},{"text":"ambaisa omitibogwa lakatitapwarorusi deli ma mwasawasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Guyau bogwa eitobu nanola paila kalila Saiyoni ibodi bidadaimi;","poem":1},{"text":"mapaila matauna ivisaikoli makwaisina","poem":2},{"lineBreak":true},{"text":"paila binikoli ammakawala kala siniveka kodadaimi.","poem":2},{"lineBreak":true},{"text":"E bolela vatoi makwaisina deli kalila valu","poem":2},{"lineBreak":true},{"text":"tuta baisa kwedidadaimi wala eikanukwenusi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"E kalapisilela bogwa eividuboli wawa,","poem":1},{"text":"e youdulela ikatumimisaisi wala.","poem":2},{"lineBreak":true},{"text":"Valu guyoula deli goli kaidadala valu","poem":2},{"lineBreak":true},{"text":"bogwa leikatupipaisi leilauwaisi okatupipi.","poem":2},{"lineBreak":true},{"text":"E Yaubada la Karaiwaga gala wala ivitulokisi,","poem":2},{"lineBreak":true},{"text":"deli tovitoubobuta gala wala avai kilisala igisaisi metoya baisa Guyau.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tommoyela Yerusalem isikulukululusi wala opwaipwaia gala vitakaula,","poem":1},{"text":"e ikumsi koula deli isikamsi si saigala.","poem":2},{"lineBreak":true},{"text":"E tubovau vivila isikulukululusi wala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Matagu bogwa eisupilaki valam,","poem":1},{"text":"e nanogu saina mmayuyugaga sainela.","poem":2},{"lineBreak":true},{"text":"Bogwa lasomata ninamwau,","poem":2},{"lineBreak":true},{"text":"paila ulo tomota bogwa eidaminasi.","poem":2},{"lineBreak":true},{"text":"Gugwadi deli pwapwawa eimitamata wala uwosi olopola valu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mesinaku bikapulokaisi baisa inisia kawasi,","poem":1},{"text":"“Bakam, bamom.”","poem":2},{"lineBreak":true},{"text":"Magudisina eiuwaki molu olopola valu","poem":2},{"lineBreak":true},{"text":"makawala matausina availa eikagagumasi;","poem":2},{"lineBreak":true},{"text":"E oyumasi wala inisia magudisina ikikaligasi goli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"O Yerusalem, ulo viloukeya Yerusalem, avai vavagi ibodi balivali?","poem":1},{"text":"Ammakawala bavigaki bavisimolaim?","poem":2},{"lineBreak":true},{"text":"Gala avai tuta availa ilumkoli mmayuyu","poem":2},{"lineBreak":true},{"text":"makawala yoku lokulumkoli lagaila.","poem":2},{"lineBreak":true},{"text":"Kam mmayuyu saina vakaigaga makawala goli bolita gala isim katupwaila.","poem":2},{"lineBreak":true},{"text":"Gala wala ambaisa m pikwaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Matausina m tovitoubobuta gala wala bivitokaisi tolosila si vitoubobuta, bisipulokaimsi wala;","poem":1},{"text":"si katuloluta ikatigamwaisi wala lopom","poem":2},{"lineBreak":true},{"text":"paila gala avai tuta ikamitulaisi m mitugaga.","poem":2},{"lineBreak":true},{"text":"Isinapwaimsi wala mwada gala bikaiki wowom paila bukuninavila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Tomota bililoulasi bigigisaimsi deli wala si yousokana.","poem":1},{"text":"Matausina ikatugougeunasi deli gigilesi","poem":2},{"lineBreak":true},{"text":"avai tuta bigisaisi Yerusalem deli wowala eikaupuwopu.","poem":2},{"lineBreak":true},{"text":"E ililivalasi kawasi,","poem":2},{"lineBreak":true},{"text":"“Mwada mavilouwenala viloumatabwaila ke?","poem":2},{"lineBreak":true},{"text":"Deli mina watanawa eiyakawolaisi ke?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Komwaidosi kam tilaula ikatudeuwaimsi","poem":1},{"text":"e deli si gibuluwa igigisaimsi wala.","poem":2},{"lineBreak":true},{"text":"Matausina ikapinumsi kasi gabula deli ikavitauwaisi kudusi","poem":2},{"lineBreak":true},{"text":"ilulukwaisi kawasi, “Bogwa takatudidaimisi!","poem":2},{"lineBreak":true},{"text":"Tapupuyaisi wala lagaila bogwa tatomgwagasi!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"E avaka Guyau eininamsi bivagi bogwa leivagi makawala.","poem":1},{"text":"matauna leikatudoumwaimasi gala wala deli la nokapisi,","poem":2},{"lineBreak":true},{"text":"makawala goli bogwa eilukwaibogwaimasi.","poem":2},{"lineBreak":true},{"text":"Ivigaki kama tilaulasi bitomgwagasi","poem":2},{"lineBreak":true},{"text":"deli goli bimwasawasi paila bogwa kamamasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"O Yerusalem, ibodi wala kam kwali bidousi baisa Guyau!","poem":1},{"text":"E yumyam deli bugibogi ibodi mitilagim bititayelu wala","poem":2},{"lineBreak":true},{"text":"makawala sopi wa waya;","poem":2},{"lineBreak":true},{"text":"ibodi bukusomata valam deli goli ninamwau!","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Bogi kwaitala kwaitala ibodi bukusivavila simalaula","poem":1},{"text":"e bukudoudou baisa Guyau;","poem":2},{"lineBreak":true},{"text":"kulupisau m nanamsa komwaidona","poem":2},{"lineBreak":true},{"text":"e bukukwayubabai baisa matauna kidamwa binokapisi litumwa -","poem":2},{"lineBreak":true},{"text":"ka, gugwadi molusaula wala eikikimati","poem":2},{"lineBreak":true},{"text":"ambaisa ambaisa okatugulugwelu keda!","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ka, Guyau! Avaka paila lokuyokili mitamaisi.","poem":1},{"text":"Nunumoya bogwa eikamkomasi litusia tatousi!","poem":2},{"lineBreak":true},{"text":"Tolula deli tovitoubobuta ikikatumataisi wala","poem":2},{"lineBreak":true},{"text":"olumoulela Bwala Kwebumaboma goli!","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tubovau deli tommoya makawala goli, ikikaligasi wala olopola valu.","poem":1},{"text":"Tubovau tauwau deli vivila, tilaula ikatumataisi metoya osi kema.","poem":2},{"lineBreak":true},{"text":"Yam makwaina m gibuluwa leikaloubusi","poem":2},{"lineBreak":true},{"text":"e yoku kukwatudoum matausina gala deli m nokapisi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"E kudou agu tilaula imaisi gulitinidesi","poem":1},{"text":"imwalaisi kalagila kabilia e ivaulaigusi ivapataigusi.","poem":2},{"lineBreak":true},{"text":"E gala availa ibodi bisakaula wa yam makwaina lokugibuluwa.","poem":2},{"lineBreak":true},{"text":"Ikatumataisi litugwa, matausina lavitubwi deli layebwaili.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kij_png/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}