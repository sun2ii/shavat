{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"OBA","translationId":"kij_png","name":"OBEDAIA","commonName":"OBEDAIA","title":"OBEDAIALa Buki","order":31,"numberOfChapters":1,"sha256":"1d98d2a09d90cbcf190b71e105622f439a1f5bb38a4b9dc1e0f832836d6f8438","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/OBA/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/kij_png/OBA/1.json","totalNumberOfVerses":21},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Baisa makawala Obedaia la vitoubobuta avaka Guyau Yaubada eilivala paila mina Edom. Guyau bimipuki Edom",{"text":"Guyau bogwa eiwitali la touwata baisa boda ituwoli ituwoli,","poem":1},{"text":"e yakidasi bogwa talagaisi la biga kawala,","poem":2},{"lineBreak":true},{"text":"“Kukwalumasi! E bitasuvisi, takabiliasi deli mina Edom!”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Guyau iluki mina Edom kawala,","poem":1},{"text":"“Yeigu bavigakaimi bukumamasi.","poem":2},{"lineBreak":true},{"text":"Tomota komwaidona bivakaluwouwaimi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ninami kala kaiveka bogwa eisipulokaimi.","poem":1},{"lineBreak":true},{"text":"Mi vilouveka kuvigakaisi kami kali kwaipeula makawala dukutotu.","poem":1},{"text":"Mi valu itotusi odubiliwotala koya;","poem":2},{"text":"mapaila kulivalasi kawami,","poem":1},{"text":"‘Availa ibodi bivabwaimasi watanawa?’","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ilagoli yokomi mi valu itotu walakaiwa","poem":1},{"text":"makawala mluveka biyoula kala nigwa saina walakaiwa","poem":2},{"lineBreak":true},{"text":"mapaila ivigaki makawala kusilomlasi deli utuyam,","poem":2},{"text":"mitaga yeigu bavabwaimi watanawa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Avai tuta mina uveilau bimaisi wa bogi,","poem":1},{"text":"matausina bikauwaisi avaka wala eililoki ninasi.","poem":2},{"text":"Avai tuta tomota bitayoyuwasi waini kaiuwala,","poem":1},{"text":"tuta komwaidona biligaiwaisi mimilisi ulumwaidona.","poem":2},{"text":"Mitaga kami tilaula bogwa leipeulasi e lokudoumlabasi goli!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yokomi dalela Iso mi veiguwa komwaidona bogwa leikwaiyaisi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Matausina semia mwada deli lokuvasosusi bogwa leiwabwaimi;","poem":1},{"text":"matausina bogwa leibokavilaimi metoya omi valu.","poem":2},{"text":"Mabudona tomota mwada deli lokuvasosusi bogwa leitomgwagasi odubami.","poem":1},{"text":"Matausina lubaimia mwada kaitala kami kaboma bogwa leileiyasi kami sikula","poem":2},{"lineBreak":true},{"text":"e matausina ikikaluwouwaimi kawasi,","poem":2},{"lineBreak":true},{"text":"‘Ambaisa mesakaisi si kabitam komwaidona?’","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Wa yam makwaina bamipuki Edom,","poem":1},{"text":"yeigu bakatumati komwaidona si tokabitam","poem":2},{"lineBreak":true},{"text":"e bakatutuli ninalela si kabitam komwaidona biwokuva.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"E matausina tokabilia mina Temani bogwa bibulukukoli,","poem":1},{"text":"deli komwaidona tokabilia olopola Edom bogwa bikaligasi goli.","poem":2}]},{"type":"heading","content":["Uulela mina Edom bibodasi mipuki"]},{"type":"verse","number":10,"content":[{"text":"“Paila wala yokomi kulilebwaisi","poem":1},{"lineBreak":true},{"text":"deli kukwatumataisi budamia, matausina Yekobe dalela,","poem":1},{"text":"yokomi bukulumkolaisi mmosila deli bukudoumlabasi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Avai tuta tilaula leikodidaimisi","poem":1},{"text":"si kalapisila makwaisina,","poem":2},{"lineBreak":true},{"text":"yokomi kutopalasi wala wa yam makwaina.","poem":2},{"text":"Yokomi lokububunasi makawala","poem":1},{"text":"matausina mitawasi itapeilisi Yerusalem guguwala ilauwaisi","poem":2},{"lineBreak":true},{"text":"isigalaisi oluwalaisi titoulesi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yokomi gala ibodi bukuyousokanasi","poem":1},{"text":"paila budamia si kaisisu kala mwau olumoulela Yuda.","poem":2},{"text":"Yokomi gala ibodi bukumwasawasi","poem":1},{"text":"wa yam makwaina leikodidaimisi si valu.","poem":2},{"text":"Yokomi gala ibodi bukugigilaisi matausina","poem":1},{"text":"osi tuta mmayuyu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wa yam makwaina leibodasi mwau","poem":1},{"text":"yokomi gala avaka uula bukusuvisi","poem":2},{"lineBreak":true},{"text":"osi valu ulo tomota","poem":2},{"lineBreak":true},{"text":"e bukuyosokanaisi paila kasi mmayuyu;","poem":2},{"lineBreak":true},{"text":"deli bukulebwaisi komwaidona si veiguwa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wa yam makwaina leibodasi kasi mmayuyu","poem":1},{"text":"yokomi gala avaka uula lokuvabodaisi makadasina kadilalai","poem":2},{"lineBreak":true},{"text":"e lokuyosisi matausina mwada bisakaulasi.","poem":2},{"text":"Yokomi gala avaka uula lokukwasalaisi matausina baisa kasi tilaula.","poem":1}]},{"type":"heading","content":["Yaubada biyakali boda ituwoli ituwoli"]},{"type":"verse","number":15,"content":[{"text":"“Ka, yam makwaina bogwa eivakatitaikina,","poem":1},{"text":"yeigu Guyau bayakali boda ituwoli ituwoli.","poem":2},{"text":"Ka, mina Edom avaka bogwa lokuvagaisi","poem":1},{"text":"e mapula makawala wala bivigakaimi.","poem":2},{"lineBreak":true},{"text":"E yokomi bukukwaimalaisi avaka lokusakaisi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Odabala ulo koya kwebumaboma","poem":1},{"text":"ulo tomota bogwa eimomsi makwelana vigala mipuki kwelayayana.","poem":2},{"text":"Mitaga igau, komwaidona boda makwaisina opapasi eitainaisi eitapataisi bimomwaisi makwelana viga,","poem":1},{"text":"mipuki vigala kwelayayana sainela;","poem":2},{"lineBreak":true},{"text":"matausina bimomwaisi bikatukukopwaisi e bidoumsi.","poem":2}]},{"type":"heading","content":["Mina Isireli si tomgwaga"]},{"type":"verse","number":17,"content":[{"text":"“Mitaga odabala Koya Saiyoni mimilisi igau bisakaulasi","poem":1},{"text":"e bivigaki valu makatupona katupobumaboma.","poem":2},{"text":"E Yekobe dalela biyosisi mapilana valu paila baisa viloutabusi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ka, dalesi Yekobe sola Yosepa bavigaki makawala kova;","poem":1},{"text":"matausina bimtulaisi Iso dalela makawala","poem":2},{"lineBreak":true},{"text":"kova bigabu bivakovi yonitaitu.","poem":2},{"lineBreak":true},{"text":"E gala taitala Iso dalela bimova.","poem":2},{"text":"Yeigu Guyau bogwa lalivala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Matausina mina Yuda opilibolimila bisikaisi valu Edom;","poem":1},{"text":"e matausina opilikwaibwaga eisisuaisi okuvalila koya biyoulisi Pilisitia.","poem":2},{"text":"Mina Isireli bikaraiwogaisi viluwesi Epereim deli Sameria;","poem":1},{"text":"e mina Beniamina bikauwaisi Giliadi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"E mabudona mina Isireli opiliyavata","poem":1},{"text":"eilosi okatupipi bogwa bikaimilavausi","poem":2},{"lineBreak":true},{"text":"e biyoulisi mapilana Pinisia bilagʹo","poem":2},{"lineBreak":true},{"text":"itobu Sarepata opiliyavata.","poem":2},{"text":"E matausina mina Yerusalem eisisuaisi","poem":1},{"text":"okatupipi mapilana Sadisi","poem":2},{"lineBreak":true},{"text":"bogwa bimaisi biyoulisi valu mavilousina Yuda opilibolimila.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"E matausina totomgwaga mina Yerusalem","poem":1},{"text":"bisuvisi ikabiliasi Edom,","poem":2},{"lineBreak":true},{"text":"biyoulisi e bikaraiwogaisi goli.","poem":2},{"text":"E Guyau titoulela wala biguyoi matausina.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kij_png/OBA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/JON/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/AMO/9.json","previousChapterAudioLinks":{},"numberOfVerses":21}