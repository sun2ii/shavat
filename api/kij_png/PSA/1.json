{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":1,"content":[{"type":"heading","content":["Mwasawa mokwita"]},{"type":"verse","number":1,"content":[{"text":"Availaga bimwasawa?","poem":1},{"lineBreak":true},{"text":"Ka, kidamwa bitapaiki tomitugaga si katuloluta,","poem":1},{"text":"e kidamwa gala bitabokuli tomitugaga si kidakeda","poem":2},{"lineBreak":true},{"text":"e gala bitatoulala osi deili matausina eipakaisi Yaubada,","poem":2},{"lineBreak":true},{"text":"e bogwala bitamwasawa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Paila kidamwa bitakabikuwoli Guyau la Karaiwaga","poem":1},{"noteId":0},{"text":"baisa bivigaki da kabomwasawa.","poem":1},{"text":"Yumyam bugibogi goli bitatakutu karaiwaga makwaina onanoda.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Availa availa si bubunela makawala,","poem":1},{"text":"e matausina makawala kai itotu opapala sakala.","poem":2},{"lineBreak":true},{"text":"Makaina biwouwa okala kweluva,","poem":2},{"lineBreak":true},{"text":"e yekwesila gala wala bimwailela.","poem":2},{"text":"Ka, tomota matausina biyubwailasi","poem":1},{"text":"paila komwaidona vavagi avaka avaka iuvagaisi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mitaga tomitugaga gala goli makawala.","poem":1},{"text":"Matausina makawala wawa yagila iiyuvisau.","poem":2},{"noteId":1}]},{"type":"verse","number":5,"content":[{"text":"Yaubada bikamogi","poem":1},{"noteId":2},{"text":"tomitugaga,","poem":1},{"text":"deli bitavilevi","poem":2},{"noteId":3},{"text":"metoya ola tomota tatoula.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Paila Guyau Yaubada iuvakadi deli iiyamati tomitukwaibwaila,","poem":1},{"text":"mitaga tomitugaga bidoumlabasi wala.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"a","text":"Mapilasina buki pilalima Vitouula bila Karaiwaga Kwaiyuwela.","reference":{"chapter":1,"verse":2}},{"noteId":1,"caller":"b","text":"Otutala tayoyuwa mina Isireli bitavilevi witi deli wowala metoya ola pilasi yagila; bilavaisi witi deli wawa bila walakaiwa, e witi kwemomwau nani bikapusi bim opwaipwaia mitaga wawa yagila biyuvisau bila.","reference":{"chapter":1,"verse":4}},{"noteId":2,"caller":"c","text":"Bibodaisi kasi kamwaga wa yamla yakala.","reference":{"chapter":1,"verse":5}},{"noteId":3,"caller":"d","text":"Gala bibanaisi kasi vilavila bwaina deli tomitukwaibwaila.","reference":{"chapter":1,"verse":5}}]},"thisChapterLink":"/api/kij_png/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}