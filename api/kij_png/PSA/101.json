{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":101,"content":[{"type":"heading","content":["Taitala guyau la biga katotila"]},{"type":"verse","number":1,"content":[{"text":"Mwa Guyau! Bawosi baisa yoku,","poem":1},{"text":"e bawosi butusi ninatotila deli karaiwaga duwosisia.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Komwaidona ulo wotetila bisisu bwainawokuva wala.","poem":1},{"text":"Ki, avai tutaga bukumakaiagu?","poem":2},{"noteId":215},{"lineBreak":true},{"text":"Yeigu basisu ogu bwala tomigileu wala,","poem":1}]},{"type":"verse","number":3,"content":[{"text":"e deli gala batagwala avai mitugaga bisisu baisa.","poem":2},{"text":"Matausina itotubulokaisi metoya baisa Yaubada,","poem":1},{"text":"si kidakeda avigaki kwekukologu goli.","poem":2},{"lineBreak":true},{"text":"Gala wala sitana bimmweiki wowogu paila vavagi makwaisina.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yeigu gala wala basasopa,","poem":1},{"text":"e deli gala wala avai tuta batagwala vavagi gaga mwada bipilasi ulo kaisisu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yeigu bogwa wala bayabi availa availa matausina","poem":1},{"text":"ikikasilamsi mitugaga paila tomota ituwoli.","poem":2},{"text":"Yeigu gala batugwali tomota matauna","poem":1},{"text":"availa saina tokaluvalova deli tokamnomwana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yeigu babigibwaili matausina availa availa deli si kimadagi baisa Yaubada,","poem":1},{"text":"e batugwali bisisuaisi ogu ligisa.","poem":2},{"text":"Matausina mokwitatoula wala tokamokwita","poem":1},{"text":"ibodi batugwali matausina biwotitalaigusi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gala batagwala avai tosasopa bisisu ogu ligisa,","poem":1},{"text":"e deli gala avai tokwatudewa gaga batagwala bitotu omatagu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yumyambwata yeigu bakatumati","poem":1},{"text":"tomitugaga oma valusi.","poem":2},{"text":"Yeigu babokavili komwaidosi tomitugaga","poem":1},{"text":"metoya ola valu Guyau.","poem":2},{"noteId":216}]}],"footnotes":[{"noteId":215,"caller":"j","text":"Guyau Debida ipikwaku mwada Yaubada bimakaia biyomitali nanola deli la peula.","reference":{"chapter":101,"verse":2}},{"noteId":216,"caller":"k","text":"Mapilawena Yerusalem.","reference":{"chapter":101,"verse":8}}]},"thisChapterLink":"/api/kij_png/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}