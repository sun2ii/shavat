{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":102,"content":[{"type":"heading","content":["La nigada totubovau ola tuta mwau"]},{"type":"verse","number":1,"content":[{"text":"Mwa Guyau! Kunakaigali ulo nigada,","poem":1},{"text":"deli kulagi ulo dou paila pilasi!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Avai tuta wala baboda mwau,","poem":1},{"text":"gala bukutotubulokaigu!","poem":2},{"text":"Kunakaigalaigu,","poem":1},{"text":"deli nanakwa kumapwaigu avai tuta badou.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ulo momova eititamwau makawala mseu,","poem":1},{"text":"e wowogu ilululu makawala kova.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yeigu iwaigusi akapusi makawala mnumonu yamitamata,","poem":1},{"text":"e kaula kala nanamsa alumwelavi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Akapiniveka kayagigila.","poem":1},{"text":"Yeigu eideli wowogu totuwanawokuva wala yeigu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yeigu makawala mauna nabubolodila oviloupakala,","poem":1},{"text":"e makawala kuru itotu oviloububu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Akanukwenu wala ammamata,","poem":1},{"text":"e yeigu makawala nagumalawa mauna nayoyowa itotu okulumwala.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yam kwemwaidona agu tilaula ibigigagaigusi.","poem":1},{"text":"Matausina iyosokanaigusi, yagagu ivigakaisi si bolata","poem":2},{"noteId":217},{"text":"baisa sesia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Paila wala m gibuluwa deli kam leiya","poem":1},{"noteId":218},{"text":"tubwaga avigaki kʹagu,","poem":2},{"lineBreak":true},{"text":"e deli mitilagigu itaguliki agu sopi.","poem":2},{"text":"Yoku kulupaigu e kulavaigu alʹo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ulo momova makawala dubilikoyavi,","poem":1},{"text":"e yeigu makawala mnumonu yamitamata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"E yoku Guyau, yoku goli Guyau Tosivagasi.","poem":1},{"text":"Tubwa komwaidona biluluwaimsi goli.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yoku igau bukutokaia e bukunokapisi mapilana Saiyoni,","poem":1},{"noteId":219},{"text":"paila tuta bogwa leima paila mapilana ibodi bibani kala nokapisi,","poem":2},{"lineBreak":true},{"text":"e baisa tuta kala tuta mokwita.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"M towotetila komwaidona iyebwailisi wala mapilana,","poem":1},{"text":"ilagoli kaina bogwa eidadaimi.","poem":2},{"text":"Matausina inokapisaisi wala mapilana,","poem":1},{"text":"ilagoli kaina bogwa eiviloububu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Boda ituwoli ituwoli bikukolaisi Guyau,","poem":1},{"text":"e guyousi watanawa komwaidosi bikukolaisi la peula.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"E avai tuta Guyau bikaliivau mapilana Saiyoni,","poem":1},{"text":"e matauna igau biyomitali la tovakaigaga.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Matauna igau bilagi la tomota matausina omitibogwa eisilavi","poem":1},{"text":"e binakaigali si nigada.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ibodi bitagini avaka Guyau bogwa leivagi","poem":1},{"text":"paila tubwa igau bima bikalawasi,","poem":2},{"lineBreak":true},{"text":"e mapaila baisa tomota matausina igau gala bikaloubusisi ibodi biyakawolaisi matauna.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Guyau ikululuki metoya ola kabosisu kwebumaboma walakaiwa,","poem":1},{"text":"e metoya wa labuma ikululukiga valu watanawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"E ilagi si kayagigila tokatupipi,","poem":1},{"text":"deli itaneku matausina availa availa kasi mipuki kaliga.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"E avai tuta boda ituwoli ituwoli deli kabokwaraiwaga ituwoli ituwoli bimaisi gulitinidesi","poem":1},{"text":"e bitapwarorusi baisa Guyau.","poem":2},{"text":"E matausina bikamitulaisi yagala mapilana Saiyoni,","poem":1},{"text":"e deli biyakawolaisi matauna mapilana Yerusalem.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Igau otubovaugu Guyau ivigaki wowogu kala mama,","poem":1},{"text":"e matauna iutupwi ulo momova.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mwa Yaubada! Gala bukukwatumataigu,","poem":1},{"text":"paila igau gala bilokaia agu tomoya.","poem":2},{"lineBreak":true},{"text":"Yokugwa Guyau tosivagasi goli!","poem":1}]},{"type":"verse","number":25,"content":[{"text":"Omitibogwa yoku kububuli watanawa,","poem":2},{"lineBreak":true},{"text":"e yamam titoulem kububuli labuma.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Komwaidona bitamwausi, mitaga yoku bukusisu wala.","poem":1},{"text":"Komwaidona bigagasi makawala kakapula yadadaimi.","poem":2},{"text":"Yoku bukuligaim makawala kakapula,","poem":1},{"text":"e komwaidona bitamwausi.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Mitaga yoku tuta komwaidona migim migitinidesi wala,","poem":1},{"text":"e deli m momova gala kala kalitutila.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Litumaiasi bisisuaisi luvala wala uwosi,","poem":1},{"text":"E tubusia bisibwabwailasi metoya om yamata.","poem":2}]}],"footnotes":[{"noteId":217,"caller":"l","text":"Matausina ininigadasi mwada makwaisina vavagi mwau avaka avaka eibodi bikaloubusisi baisa sesia.","reference":{"chapter":102,"verse":8}},{"noteId":218,"caller":"m","text":"Kugisi Sam 79.5.","reference":{"chapter":102,"verse":9}},{"noteId":219,"caller":"n","text":"Mapilana Yerusalem.","reference":{"chapter":102,"verse":13}}]},"thisChapterLink":"/api/kij_png/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":26}