{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":104,"content":[{"type":"heading","content":["Kala yakaula Yaubada Tobubuli"]},{"type":"verse","number":1,"content":[{"text":"Bilomagu, kuyakawoli Guyau.","poem":1},{"text":"E Guyau ulo Yaubada, saina tovakaigaga yoku.","poem":2},{"text":"Lokusikam kam kwalugologusa saina guyugwayu.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Kuvakanunuvaim lumalamawokuva wala.","poem":2},{"text":"Valu walakaiwa kukwatuvakai makawala laya","poem":1}]},{"type":"verse","number":3,"content":[{"text":"e kumili valu odabala sopi walakaiwa.","poem":2},{"noteId":222},{"text":"Lowalowa kuvigaki m waga,","poem":1},{"text":"e kukoukewa odabala yagila.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yagila lokuvigaki m touwata,","poem":1},{"text":"e kavikavila kuvigaki m towotetila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lokusaili valu watanawa okabala,","poem":1},{"noteId":223},{"text":"e makwaina gala avai tuta bimotatina.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kuvigaki bolita kala kakapula valu watanawa,","poem":1},{"text":"e sopi ikatukuwosi koya.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Avai tuta kukwamitilaki sopi, itabai wala.","poem":1},{"text":"Sopi ilagi m kwaraiwaga deli kaigam kaigaveka kulivala, e isakaula.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ititayelu odubasi koya ibubusi ila wa sakala,","poem":1},{"text":"bila okabala ambaisa bogwa lokukwatubiasi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Okusaili kala kalitutila, e gala gagabila biluvapela,","poem":1},{"text":"e gala gagabila bikatukuwosi valu watanawa tuvaila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yoku kuvigaki sopi igigibwabula wa sakala,","poem":1},{"text":"e waya ititayelu metoya oluwalaisi koya.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"E ivigaki kasi sopi mauna nabubolodila.","poem":1},{"text":"Baisa goli ase nabubolodila ivakapwaisi kasi daka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Makaisina kai otalila sopi","poem":1},{"text":"baisa mauna nayoyowa iyoulasi kasi nigwa deli iusiwosi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Metoya wa labuma kuwitali kuna bikuna wa koya,","poem":1},{"text":"e valu watanawa ikasuwoki m mitakwai bidubadu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kuvigaki mnumonu bisusina mwada bikamsi bulutuvalu,","poem":1},{"text":"e kusaiki avai kai avai kai bipilasi tomota,","poem":2},{"text":"e gagabila tomota bikaibigulaisi,","poem":1}]},{"type":"verse","number":15,"content":[{"text":"deli bitaiyauwaisi waini kidamwa bimwasawasi,","poem":2},{"lineBreak":true},{"text":"e bulamila olibe kidamwa biyomwasali ninasi,","poem":2},{"lineBreak":true},{"text":"e kaula kidamwa bikatupewoli uwosi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mina Lebanoni si kai kweisila","poem":1},{"noteId":224},{"text":"ibubanaisi kasi sopi bidubadu,","poem":1},{"text":"makaisina kai Guyau la kai eivaula titoulela.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Baisa mauna iiyoulasi kasi nigwa.","poem":1},{"text":"Minasina boi iiyoulasi kasi nigwa osisila kaga.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Gota nabubolodila isisuaisi wa koya,","poem":1},{"text":"e minasina kwakwau isim kasi nobwala opwaipwaia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kububuli tubukona bikibuboti kweluva,","poem":1},{"text":"e kalasia bogwa inikoli kala tuta salili.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kububuli bogi, e otutala dudubila","poem":1},{"text":"mauna nagigasisi isunapulasi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Minasina laiyoni nagugwadi iguguvavilasi e inainevisi kʹasi,","poem":1},{"text":"avaka Yaubada bisaiki.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Igau iyuwoula kalasia ikeiitasi","poem":1},{"text":"e ikenusi okasi nobwala.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"E oluvi tomota itokaiasi isunapulasi bipaisewasi,","poem":1},{"text":"e ipupaisewasi wala bila bibogi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Mwa Guyau! M bubuli saina bidugaga","poem":1},{"text":"lokububuli metoya om kwabitam.","poem":2},{"lineBreak":true},{"text":"Valu watanawa ikasewoki m bubuli.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ka, milaveta kala maloula kala beiyaya,","poem":1},{"text":"e m bubuli baisa obolita gala gagabila bitakalau,","poem":2},{"lineBreak":true},{"text":"navakaveka deli goli nakikekita!","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Waga ikokewasi odabala bolita, e minana bosu immwasawa baisa,","poem":1},{"text":"minawena makawala Dokanikani","poem":2},{"noteId":225},{"text":"okububuli goli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Komwaidosi minasina ikikanasi baisa yoku,","poem":1},{"text":"e mwada yoku bukusaiki kʹasi avai tuta magisi.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Yokugwa kusisaiki e ikamsi.","poem":1},{"text":"Yoku kutugwali kaula e bogwa ikomatasi.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Avai tuta yoku kutotubuloki, minasina ikokolasi.","poem":1},{"text":"Avai tuta kukwau si yagisa ikaligasi wala,","poem":2},{"lineBreak":true},{"text":"e idavilasi imila pwaipwaiasi tuvaila.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Mitaga avai tuta kusaiki si yagisa,","poem":1},{"noteId":226},{"text":"imovavausi,","poem":1},{"text":"E yoku kuvigaki valu watanawa imovavau.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Ibodi Guyau kala katububula bikanuvagasi,","poem":1},{"text":"e ibodi bimwasawa paila avaka avaka eibubuli.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Imitakavati pwaipwaia, e pwaipwaia iyega.","poem":1},{"text":"Ikabikoni koya e mseu isusunapula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Ogu momova komwaidona bausiwosi baisa wala Guyau,","poem":1},{"text":"e ogu tuta tomomova yeigu bawosi kala yakaula Yaubada.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Saina magigu agu wosi biyomwasali matauna,","poem":1},{"text":"paila ulo mwasawa eimaima metoya baisa matauna.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ibodi Guyau bimtuli komwaidosi tomitugaga,","poem":1},{"text":"e bidoumlabasi wala.","poem":2},{"lineBreak":true},{"text":"Bilomagu, kuyakawoli Guyau.","poem":1},{"lineBreak":true},{"text":"Kala yakaula Guyau!","poem":1}]}],"footnotes":[{"noteId":222,"caller":"q","text":"Ilivala paila bolita makwaina idokaisi isisu odabala labuma. Kugisi kaikobula isisu Vit 7.11.","reference":{"chapter":104,"verse":3}},{"noteId":223,"caller":"r","text":"Kugisi Sam 18.15.","reference":{"chapter":104,"verse":5}},{"noteId":224,"caller":"s","text":"Kugisi Sam 92.12 kala katumiki.","reference":{"chapter":104,"verse":16}},{"noteId":225,"caller":"t","text":"Kugisi Sam 74.14.","reference":{"chapter":104,"verse":26}},{"noteId":226,"caller":"u","text":"si yagisa.Gagabila bitagini “avai tuta kusaiki m baloma”.","reference":{"chapter":104,"verse":30}}]},"thisChapterLink":"/api/kij_png/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}