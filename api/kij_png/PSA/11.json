{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":11,"content":[{"type":"heading","content":["Dubumi baisa Guyau matauna kabokwala"]},{"type":"verse","number":1,"content":[{"text":"Adubumi Guyau, paila matauna ulo kabokwala.","poem":1},{"text":"Kaina tonagowa yoku lokulukwaigu kawam,","poem":2},{"text":"“Kuyowa kula wa koya makawala mauna,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"paila tomitugaga ikatuvigilaisi si kaiyala e iiyamwasisi","poem":2},{"lineBreak":true},{"text":"kidamwa bibasaisi tobubwaila odudubila.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Avai tuta tobwaila uulela la kaisisu bigaga,","poem":1},{"text":"avakaga gagabila matauna bivagi?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Guyau isisu ola Bwala Kwebumaboma.","poem":1},{"text":"Matauna la takaikaia wa labuma.","poem":2},{"text":"Imitakavati tomota ambaisa ambaisa","poem":1},{"text":"e inikoli matausina avaka leiuvagaisi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Iwakoli tomitukwaibwaila deli tomitugaga makawala wala.","poem":1},{"text":"Mitaga tokowolova karaiwaga ivigaki tokukolola goli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Iwitali dukupolu kweyuviyavi deli salipa kwelululu","poem":1},{"noteId":27},{"text":"baisa tomitugaga,","poem":1},{"text":"e imipuki matausina metoya waigigi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Guyau matauna tomitukwaibwaila, deli iyebwaili mitukwaibwaila.","poem":1},{"text":"Matausina availa availa ibubunasi makawala bisisuaisi deli matauna.","poem":2}]}],"footnotes":[{"noteId":27,"caller":"c","text":"Kugisi liliula kasi katudoum Sodom deli Gomora, Vit 19.24-25. Kugisi tuvaila makasana Biga Kala Katumiki.","reference":{"chapter":11,"verse":6}}]},"thisChapterLink":"/api/kij_png/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}