{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":110,"content":[{"type":"heading","content":["Guyau Yaubada deli guyau matauna einagi"]},{"type":"verse","number":1,"content":[{"text":"Matauna Guyau iluki ulo guyau,","poem":1},{"text":"“Kusili ogu kwakata","poem":2},{"noteId":238},{"lineBreak":true},{"text":"tatoula wala bavigakaim bukukwalisau kam tilaula.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Guyau Yaubada bikatumkulovi m guyau metoya mapilana Saiyoni.","poem":1},{"noteId":239},{"text":"Kawala, “Bukuguyoi kam tilaula.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wa yam makwaina bukukwabilia deli kam tilaula,","poem":1},{"text":"e m tomota bitugwalaisi titoulesi paila kabilia.","poem":2},{"text":"E makawala igau bikikivi visiga saina numla,","poem":1},{"text":"e makawala goli m totubovau bimakaiamsi wa koya kwebumaboma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Guyau bogwa eikatupewoli la biga katotila, e galaga bikatumapu nanola,","poem":1},{"text":"“Yokula tolula tosivagasi","poem":2},{"lineBreak":true},{"text":"odalela tolula Melikisedeki.”","poem":2},{"noteId":240}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Guyau isisu om kwakata.","poem":1},{"text":"Avai tuta bigibuluwa, bogwa bikalisuwoli gweguya.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bikamogi boda ituwoli ituwoli,","poem":1},{"text":"e okawakali bikasewoki tomata.","poem":2},{"lineBreak":true},{"text":"Bogwa bikalisuwoli gweguya ambaisa ambaisa ovalu watanawa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Matauna guyau bimom wa waya opapala keda,","poem":1},{"text":"e bogwa bipeula wowola. Mapaila bogwa goli bitomgwaga.","poem":2}]}],"footnotes":[{"noteId":238,"caller":"g","text":"Kebila makwaina kabotaimamila goli, mitaga okikiwama sitana wala taimamila.","reference":{"chapter":110,"verse":1}},{"noteId":239,"caller":"h","text":"Mapilana Yerusalem.","reference":{"chapter":110,"verse":2}},{"noteId":240,"caller":"i","text":"Matauna tokinabogwa guyoula Yerusalem deli goli tolula, matauna eikabwaili Eberaam; kugisi Vit 14.18-20.","reference":{"chapter":110,"verse":4}}]},"thisChapterLink":"/api/kij_png/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}