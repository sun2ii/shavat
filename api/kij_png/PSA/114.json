{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":114,"content":[{"type":"heading","content":["Wosi paila Luvapela Pakala"]},{"type":"verse","number":1,"content":[{"text":"Avai tuta mina Isireli isilavaisi mapilana Itipita,","poem":1},{"text":"e matutona Yekobe tubula isilavaisi mapilana si valu togilagala,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"mina Yuda matausina Yaubada ivigaki la tomota mina bumaboma,","poem":1},{"text":"e mina Isireli ivigaki la vavagi tatoula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bolita Pilabweyani igigisaimasi e isakaula ilʹo,","poem":1},{"text":"deli goli Waya Yoridani isim titayelu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Koya kwevakaveka ipeipelasi makawala gota,","poem":1},{"text":"deli koya kwekikekita iyuweitaulasi","poem":2},{"noteId":247},{"text":"makawala lam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mwa! Yoku Bolita, avaka paim lokusakaula lokula?","poem":1},{"text":"Wo, Yoridani, yoku deli, avaka paim lokusim titayelu?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yokomi koya kwevakaveka, avaka paimi kupeipelasi makawala gota,","poem":1},{"text":"e yokomi koya kwekikekita, avaka paimi kuyuweitaulasi makawala minasina lam?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yokugwa pwaipwaia, ibodaim bukuigayega tutala Guyau bima,","poem":1},{"text":"e tutala Yekobe la Yaubada isisu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Matauna bikatumapu dukutotu bimila katuwotu,","poem":1},{"text":"deli goli beibega bimila utuwotu.","poem":2}]}],"footnotes":[{"noteId":247,"caller":"p","text":"Koya isim kasi kokola paila uula Guyau bogwa leima; kugisi Sun 19.18; Tok 5.5; Sam 68.8.","reference":{"chapter":114,"verse":4}}]},"thisChapterLink":"/api/kij_png/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}