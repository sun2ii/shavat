{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":116,"content":[{"type":"heading","content":["Taitala tosilagi iyakawoli Yaubada"]},{"type":"verse","number":1,"content":[{"text":"Yeigu ayebwaili Guyau, paila ililagaigu.","poem":1},{"text":"Inakaigali ulo nigada.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Avai tuta badou baisa matauna","poem":1},{"text":"e tuta tuta inakaigalaigu goli.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kabosilagi mwau itoulaigusi,","poem":1},{"text":"kala kakayuwa laka iyosaigu","poem":2},{"lineBreak":true},{"text":"e agu kokola sainela iwouwouya nanogu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"E mapaila ayokakapisi baisa Guyau,","poem":1},{"text":"kawagu, “Mwa Guyau! Anigadaim bukukolaigu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Matauna Guyau tonokapisi deli giyoubwaila","poem":1},{"text":"Da Yaubadasi matauna kada kwabusi oda tutasi mwau.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Guyau ikoli tomamama.","poem":1},{"text":"Avai tuta laboda kabosilagi e matauna ikolaigu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gala wala ibodi baninayuwa,","poem":1},{"text":"paila Guyau bogwa eimitukwaibwailigu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Guyau ikolaigu metoya kaliga","poem":1},{"text":"ikatupewolaigu e gala basilibeibeu,","poem":2},{"lineBreak":true},{"text":"e baisa ivigaki waisala mitilagigu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"E mapaila aliloula wala omatala Guyau","poem":1},{"text":"baisa osi valu tommomova.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yeigu kawagu, “Ka, bogwa laboda saina mwaugaga,”","poem":1},{"text":"mitaga adubumi wala Guyau.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kalubikoya akokola e kawagu, “Gala badubumi availa!”","poem":1},{"text":"mitaga gala wala asim kala dubumi Guyau.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Avai vavagi ibodi basaiki Guyau","poem":1},{"text":"mwada bamapu la bobwailila baisa yeigu?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bogwa basemakavi waini bavigaki lula baisa Guyau,","poem":1},{"text":"e makawala banokagutoki baisa matauna paila eikolaigu,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"e baisa osi sigugula","poem":1},{"noteId":249},{"text":"la tomota","poem":1},{"text":"bogwa goli basaiki matauna makawala ulo biga katotila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kidamwa taitala Guyau la tomota bikaliga,","poem":1},{"text":"bogwa goli bimmayuyu nanola Guyau.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"E Guyau, yeigu m towotetila,","poem":1},{"text":"e awotitalaim makawala inagu eivigakaim.","poem":2},{"text":"Yoku goli lokukolaigu metoya kaliga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Bogwa basakaim ulo lula lulela nokagutoki,","poem":1},{"text":"e banigada baisa yoku.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Baisa osi sigugula komwaidosi m tomota","poem":1},{"text":"e olumoulela m Bwala Kwebumaboma mapilana Yerusalem,","poem":2},{"lineBreak":true},{"text":"bogwa goli basakaim makawala ulo biga katotila.","poem":2},{"lineBreak":true},{"text":"Kala yakaula Guyau!","poem":1}]}],"footnotes":[{"noteId":249,"caller":"r","text":"Kugisi Sam 26.12.","reference":{"chapter":116,"verse":14}}]},"thisChapterLink":"/api/kij_png/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":18}