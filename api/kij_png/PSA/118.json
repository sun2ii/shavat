{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":118,"content":[{"type":"heading","content":["Totomgwaga la nigada nokagutoki"]},{"type":"verse","number":1,"content":[{"text":"Bitanokagutokisi baisa Guyau, paila matauna giyoubwaila.","poem":1},{"text":"La yebwaili gala wala biwokuva, bikanigaga goli.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ibodi mina Isireli bikaibigasi,","poem":1},{"text":"“La yebwaili bikanigaga goli.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ibodi Yaubada la tolula bikaibigasi,","poem":1},{"text":"“La yebwaili bikanigaga goli.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ibodi komwaidosi totapwaroru bikaibigasi,","poem":1},{"text":"“La yebwaili bikanigaga goli.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Metoya ogu mmayuyu adou baisa Guyau.","poem":1},{"text":"Imapu ulo dou, e itanekwaigu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Guyau deli yeigu, e gala wala bakokola.","poem":1},{"text":"Avakaga gagabila tomota bivigakaigusi?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Paila Guyau goli ipipilasaigu,","poem":1},{"text":"e bogwa bagisi agu tilaula bimamasi goli.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ibodi sainela bitadubumaisi Guyau,","poem":1},{"text":"e gala wala ibodi bitadubumaisi tomota.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ibodi sainela bitadubumaisi Guyau,","poem":1},{"text":"e gala wala ibodi bitadubumaisi tokugwala valu watanawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Agu tilaula bidubadu","poem":1},{"noteId":250},{"text":"eitoulaigusi,","poem":1},{"text":"mitaga akatumtuwoli matausina metoya ola peula Guyau.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"E ititoulaigusi wala itapataigusi,","poem":1},{"text":"mitaga akatumtuwoli matausina metoya ola peula Guyau.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ivaulaigusi makawala budotala tubuyusapi,","poem":1},{"text":"mitaga agabu matausina e saina nanakwa eigibimkulovi, makawala susupa,","poem":2},{"lineBreak":true},{"text":"e metoya ola peula Guyau akatumtuwoli matausina.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Iwawaigusi saina minimani e makateki wala bamama,","poem":1},{"text":"mitaga Guyau ipilasaigu goli.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Guyau bikatupewolaigu e bogwa bapeula.","poem":1},{"text":"Matauna goli bogwa eikolaigu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ka, kulegasi govala tomgwaga, ikatugougovasi deli mwasawa osi buliyoyova Yaubada la tomota.","poem":1},{"text":"Kawasi, “E, tatomgwagasi uula goli Guyau la peuligaga.","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bogwa tatomgwagasi paila uula wala Guyau la peula,","poem":2},{"lineBreak":true},{"text":"e la peuligaga tutala takakabiliasi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Yeigu gala wala bakaliga. Mitaga tomomova yeigu","poem":1},{"text":"bakamituli Guyau avaka eivagi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bogwa leimipukwaigu saina mwau,","poem":1},{"text":"mitaga gala itugwalaigu bakaliga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kuulaimwaisi kalapisilela Bwala Kwebumaboma","poem":1},{"text":"e yeigu basuvi e banokagutoki baisa Guyau.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ka, baisa Guyau la kalapisila.","poem":1},{"text":"Tomitukwaibwaila wala bisuvisi baisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Mwa Guyau! Ayakawolaim, paila lokulagaigu,","poem":1},{"text":"e lokusakaigu peula kidamwa batomgwaga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Dakuna itakilaisi tokwaliai bwala,","poem":1},{"text":"makwaina ivigaki makawala lipumatala.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Baisa ivagi Guyau,","poem":1},{"text":"makwaina kabokatubau omatadasi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yam lagaila goli Guyau eitomgwaga.","poem":1},{"text":"Ibodi bitamwasawasi e bitapakasi.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bukukolaimasi! Mwa Guyau! Bukukolaimasi!","poem":1},{"text":"E Guyau, bukuvigakaimasi bakapeulasi goli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ibodi Yaubada bimitukwaii matauna imaima metoya baisa Guyau.","poem":1},{"text":"Kayakawolaimsi metoya Guyau la Bwala Kwebumaboma.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Guyau matauna Yaubada, e matauna imitukwaibwailidasi.","poem":1},{"text":"Oyumami bukuyosisi kai sisila bukuvitouulasi paka makwaina,","poem":2},{"lineBreak":true},{"text":"e bukukwatudelisi bukutavinaisi kabolula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Yoku ulo Yaubada e anokagutoki baisa yoku.","poem":1},{"text":"Bogwa bakamitulaim yoku Tovakaigaga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Bitanokagutokisi baisa Guyau, paila matauna giyoubwaila.","poem":1},{"text":"La yebwaili gala wala biwokuva, bikanigaga goli.","poem":2}]}],"footnotes":[{"noteId":250,"caller":"s","text":"Matausina goli ituwoli boda ituwoli boda si tokwabilia.","reference":{"chapter":118,"verse":10}}]},"thisChapterLink":"/api/kij_png/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}