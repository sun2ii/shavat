{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":120,"content":[{"type":"heading","content":["Nigada paila pilasi"]},{"type":"verse","number":1,"content":[{"text":"Avai tuta laboda mwau, adou baisa Guyau,","poem":1},{"text":"e matauna imapu ulo nigada.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mwa Guyau! Kukolaigu metoya matausina","poem":1},{"text":"tosisasopa deli toubuwabu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yokomi tosisasopa, avaka Yaubada bivigakaimi?","poem":1},{"text":"E ammakawala bimipukwaimi?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bimipukwaimi metoya tokwabilia si kaiyala kaikikakata,","poem":1},{"text":"deli goli pwanosi eikikapolu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ulo sisu oluwalaimi makawala kala gaga bitasisu oluwalaisi mina Meseki,","poem":1},{"text":"kaina oluwalaisi mina Kedara.","poem":2},{"noteId":256}]},{"type":"verse","number":6,"content":[{"text":"Tuta kaduwonaku yeigu asisu deli matausina kukolosi vakota.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Avai tuta balivala livalela vakota,","poem":1},{"text":"matausinaga magisi wala kabilia.","poem":2}]}],"footnotes":[{"noteId":256,"caller":"y","text":"Mabudosina mina Meseka deli mina Kedara si valu piliyuwelʹo, e tomota idokaisi mabudosina tobubeikam wala.","reference":{"chapter":120,"verse":5}}]},"thisChapterLink":"/api/kij_png/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}