ext":"Kalasia gala bikalilavi dabam wa yam.","poem":1},{"text":"e wa bogi gala biyogagaim tubukona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Guyau bikolaim metoya kabosilagi komwaidona.","poem":1},{"text":"Matauna goli bikolaim.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ambaisa ambaisa bukula, e matauna bikolaim,","poem":1},{"text":"tuta baisa e tuta gala wala biwokuva.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kij_png/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}