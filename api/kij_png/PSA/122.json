{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":122,"content":[{"type":"heading","content":["Kala yakaula mapilana Yerusalem"]},{"type":"verse","number":1,"content":[{"text":"Yeigu lamwasawa tutala eilukwaigusi,","poem":1},{"text":"“Kuma bitalosi Guyau ola bwala.”","poem":2},{"noteId":257}]},{"type":"verse","number":2,"content":[{"text":"E ka, tuta baisa bogwa taviloubusisi mapilana Yerusalem","poem":1},{"text":"eitasuvisi okalapisilela e tatotusi olumoulela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mapilana valu Yerusalem eivigivauwaisi","poem":1},{"text":"e tuta baisa kala leilai bwaina deli tomotala taigaluva taigasi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mapilana goli madilasina dalela Isireli si kaboboda,","poem":1},{"text":"paila binokagutokisi baisa Guyau,","poem":2},{"lineBreak":true},{"text":"makawala eikaraiwogi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mapilana goli guyousi mina Isireli","poem":1},{"text":"eisilaisi paila biyakalaisi si tomota.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ibodi bukunigadasi kidamwa mina Yerusalem si valu bivakota wala.","poem":1},{"text":"Kawami, “Ibodi matausina idokaimsi kwembwailisi biyubwailasi wala.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ibodi bivakota valu","poem":2},{"lineBreak":true},{"text":"deli kabokwala om ligisa.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mwada bapilasi veyagwa deli segwaia","poem":1},{"text":"e mauula baluki mina Yerusalem, kawagu,","poem":2},{"lineBreak":true},{"text":"“Vakota baisa yokomi.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mwada bapilasi la bwala Guyau da Yaubadasi,","poem":1},{"text":"e mauula aninigada kidamwa Yaubada bimitukwaiyaimi.","poem":2}]}],"footnotes":[{"noteId":257,"caller":"z","text":"Baisa Bwala Kwebumaboma mapilana Yerusalem.","reference":{"chapter":122,"verse":1}}]},"thisChapterLink":"/api/kij_png/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}