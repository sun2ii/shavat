{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":124,"content":[{"type":"heading","content":["Yaubada ikoli la tomota"]},{"type":"verse","number":1,"content":[{"text":"E tauwau, avaka kudokaisi?","poem":1},{"text":"Kidamwa Guyau gala bitovidulaidasi otutala kabilia, avakaga bivitoulai?","poem":2},{"lineBreak":true},{"text":"Tauwau mina Isireli, kumapwaisi ulo katupoi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“E mokwita wala, tuta matutona kada tilaulasi eiwaidasi,","poem":1},{"text":"Guyau eitovidulaidasi e mauula bogwala tapeulasi.","poem":2},{"text":"Mitaga kidamwa Guyau gala bitovidulaidasi,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"e matausina kada tilaulasi osi gidaleiya","poem":1},{"text":"bogwa bilupolaidasi tommomova wala.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Oluvi sakala saina minimani bidumyelaidasi.","poem":1},{"noteId":258},{"text":"Sopi bikubolaidasi,","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"e bitakanopulasi wa waya.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ibodi bitanokagutokisi baisa Guyau,","poem":1},{"text":"paila gala itugwalaidasi kidamwa kada tilaulasi bikatumtuwolaidasi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bogwa goli tasakaulasi, makawala mauna nayoyowa biyowa metoya wa sikula.","poem":1},{"text":"Ka, eikotuni sikula e yakidasi tasakaulasi tabwabwainasi wala.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kada pilasisi leimaima metoya baisa Guyau,","poem":1},{"text":"matauna kala tobubuli labuma deli valu watanawa.","poem":2}]}],"footnotes":[{"noteId":258,"caller":"a","text":"Sakala minimani kabutuvitusila kabosilagi goli; kugisi Sam 69.1.","reference":{"chapter":124,"verse":4}}]},"thisChapterLink":"/api/kij_png/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}