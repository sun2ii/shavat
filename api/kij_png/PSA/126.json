{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":126,"content":[{"type":"heading","content":["Nigada paila kaimilavau"]},{"type":"verse","number":1,"content":[{"text":"Tutala Guyau ikaimilivauwaidasi mapilana Yerusalem,","poem":1},{"noteId":261},{"text":"e kala lumkola makawala mimi!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gala yomala gigila, e kawosisi deli mwasawa.","poem":1},{"text":"Tuta matutona boda ituwoli ituwoli eilivalasi paila yakidasi,","poem":2},{"lineBreak":true},{"text":"kawasi, “Guyau bogwa eivagi vavagi topilaveka paila matausina.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"E mokwita goli eivagi vavagi topilaveka paila yakidasi.","poem":1},{"text":"Da mwasawasi gala wala bitakaibiga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mwa Guyau! Kukwaimilivauwaimasi oma valusi,","poem":1},{"noteId":262},{"text":"makawala kuna bikaimali sopi bilau okabala.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ibodi matausina availa availa eivalaisi kasi yagogu deli si valam,","poem":1},{"text":"e bitayoyuwasi deli si mwasawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Matausina availa availa eisunapulasi ikokeulasi kasi yagogu deli si valam","poem":1},{"text":"bikaimilavausi iusiwosisi deli mwasawa","poem":2},{"lineBreak":true},{"text":"tutala igogebilasi si tayoyuwa.","poem":2}]}],"footnotes":[{"noteId":261,"caller":"d","text":"ikaimilivauwaidasi mapilana Yerusalem.Gagabila bitagini “imitukwaii mina Yerusalem”.","reference":{"chapter":126,"verse":1}},{"noteId":262,"caller":"e","text":"oma valusi.Gagabila bitagini “kumitukwaivauwaimasi”.","reference":{"chapter":126,"verse":4}}]},"thisChapterLink":"/api/kij_png/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}