{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":127,"content":[{"type":"heading","content":["Tayakawolaisi Guyau la mitakwai"]},{"type":"verse","number":1,"content":[{"text":"Kidamwa Guyau gala bikaliai bwala,","poem":1},{"noteId":263},{"text":"e tokwaliai iyoudulimakavasi wala.","poem":2},{"text":"Kidamwa Guyau gala bikoli valu,","poem":1},{"text":"e toyausa si yausa gala wala isim dimlela.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kaina magidasi bitatitakunasi kadasi metoya avai wotetila mwau.","poem":1},{"text":"Eiyam bulubuvisiga tatokaiasi tawotetilasi e igau bila olubulotoula tamasisisi.","poem":2},{"text":"Mitaga baisa gala avaka dimlela,","poem":1},{"text":"paila Guyau imitukwaii matausina mina mbwailila tutala immasisisi goli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Litudoiasi baisa Guyau la bobwailila isisakaidasi.","poem":1},{"text":"Ibodi magudisina bitadoki veiguwatoula.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kidamwa taitala biunai litula tauwau ola tuta tubovau,","poem":1},{"text":"e bogwa bibani kala pilasi metoya baisa magudisina,","poem":2},{"lineBreak":true},{"text":"makawala kaiyala oyamala tokabilia bipilasi okabilia.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kidamwa availa yamala ikasewoki la kaiyala makawala magudisina,","poem":1},{"text":"matauna gala avai tuta bimama","poem":2},{"lineBreak":true},{"text":"tutala ibudoboda kala tilaula okaboyakala.","poem":2}]}],"footnotes":[{"noteId":263,"caller":"f","text":"Kaina tomota si bwala kainaga Bwala Kwebumaboma, baisaga Yaubada la bwala.","reference":{"chapter":127,"verse":1}}]},"thisChapterLink":"/api/kij_png/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}