{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":128,"content":[{"type":"heading","content":["Kabikaula baisa Guyau deli mapula"]},{"type":"verse","number":1,"content":[{"text":"Imwasawasi availa availa matausina ikabikuwolaisi Guyau,","poem":1},{"text":"e isisuaisi olopola makwaisina la kwaraiwaga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mwa! Kidamwa bukukwabikuwoli Guyau,","poem":1},{"text":"mokwita wala bukubani kam mitakwai makawala baisa -","poem":2},{"lineBreak":true},{"text":"om paisewa bukubani avaka avaka ibodaim.","poem":2},{"lineBreak":true},{"text":"Yoku bukumwasawa, deli bukuyubwaila goli.","poem":2},{"lineBreak":true},{"text":"M kwava la pilasi kala bwaina makawala simsimwai la pilasi om valu,","poem":2},{"lineBreak":true},{"text":"deli litumwa om kwaukweda si pilasi kala bwaina makawala makaisina luya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ibodi Guyau bimitukwaiyaim metoya mapilana Saiyoni.","poem":1},{"noteId":264},{"text":"Ibodi bukugisi mapilana Yerusalem bibani kala bwaina,","poem":2},{"lineBreak":true},{"text":"om tuta komwaidona tomomova goli.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ibodaim bukusigaga igau bukugisi tubumwa!","poem":1},{"lineBreak":true},{"text":"Ibodi yokomi mina Isireli bitalaguva lupomi!","poem":1}]}],"footnotes":[{"noteId":264,"caller":"g","text":"Kaina mapilana Yerusalem kainaga pilamwaidona mapilana Isireli.","reference":{"chapter":128,"verse":5}}]},"thisChapterLink":"/api/kij_png/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":4}