{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":13,"content":[{"type":"heading","content":["Nigada paila pilasi"]},{"type":"verse","number":1,"content":[{"text":"Mwa! Guyau, ki, ammakawalaga kala woloula bukulumwelavaigu?","poem":1},{"text":"Tuta gala biwokuva kaina?","poem":2},{"lineBreak":true},{"text":"Ki, ammakawalaga kala woloula tuvaila bukukwatupwanaim titoulem metoya baisa yeigu?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ki, ammakawalaga kala woloula yeigu babudoboda mwau?","poem":1},{"text":"Ammakawalaga kala woloula ninamwau bivakasau nanogu yam deli bogi?","poem":2},{"lineBreak":true},{"text":"Ammakawalaga kala woloula agu tilaula bitomgwagasi odabagu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mwa! Guyau ulo Yaubada, kugisaigu e kuvitakaulokaigu.","poem":1},{"text":"Kukwatupewolaigu, taga kutagwala bakaliga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Taga kutagwala agu tilaula bilivalasi kawasi, “Bogwa takalisauwaisi matauna.”","poem":1},{"text":"Taga kutagwala matausina bidabumasi paila ulo kapusi.","poem":2},{"noteId":29}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yeigu lakakana wala om mitakwai.","poem":1},{"text":"Yeigu bamwasawa paila yoku bukukolaigu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mwa Guyau! Bawosi baisa yoku,","poem":1},{"text":"paila yoku lokumitukwaibwailigu.","poem":2}]}],"footnotes":[{"noteId":29,"caller":"e","text":"Kaina ililivala paila la veiguwa biwokuva, kainaga paila la kaliga.","reference":{"chapter":13,"verse":4}}]},"thisChapterLink":"/api/kij_png/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}