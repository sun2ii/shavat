{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":130,"content":[{"type":"heading","content":["Nigada paila pilasi"]},{"type":"verse","number":1,"content":[{"text":"Mwa Guyau! Bogwa lakitumou ulo pikwaku komwaidona,","poem":1},{"text":"e adoudou baisa yoku.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mwa Guyau! Kulagi ulo dou.","poem":1},{"text":"Bukunakaigali ulo dou paila pilasi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kidamwa yoku bukululuwai ma mitugagasi,","poem":1},{"text":"e availaga gagabila bipeula otutala yakala?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mitaga yoku kuligaiwa ma mitugagasi,","poem":1},{"text":"e mapaila ibodi goli bakatemmalaimsi sainela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Atutuli Guyau, akamamalu deli ulo vinagai mwada bipilasaigu,","poem":1},{"text":"e adubumi la biga matauna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yeigu atutuli Guyau,","poem":1},{"text":"e ulo kamamalu ikalisau toyausa si kamamalu tutala itulotulasi mwada nani biyam.","poem":2},{"lineBreak":true},{"text":"Ka, ulo vinagai ikalisau toyausa si vinagai tutala itulotulasi magisi nani biyam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mina Isireli, bukudubumaisi Guyau,","poem":1},{"text":"paila la yebwaili ikanuvagasi goli,","poem":2},{"lineBreak":true},{"text":"e tuta komwaidona itagwala paila bikatumova.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bogwa bikatumovi la tomota mina Isireli","poem":1},{"text":"metoya osi mitugaga komwaidona.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kij_png/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}