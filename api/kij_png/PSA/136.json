{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":136,"content":[{"type":"heading","content":["Wosila nokagutoki"]},{"type":"verse","number":1,"content":[{"text":"Ibodi bitanokagutokisi baisa Guyau, paila matauna goli giyoubwaila,","poem":1},{"text":"e la yebwaili ikanuvagasi goli.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ibodi bitanokagutokisi baisa matauna tovakaigaga ikalisuwoli komwaidona minasina yaubada.","poem":1},{"text":"e la yebwaili ikanuvagasi goli.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ibodi bitanokagutokisi baisa matauna topeuligaga ikalisuwoli komwaidona gweguya,","poem":1},{"text":"e la yebwaili ikanuvagasi goli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Matauna goli kalamwaleta iuvagi vavagi topilaveka,","poem":1},{"text":"e la yebwaili ikanuvagasi goli.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Metoya ola kabitam, matauna ibubuli labuma,","poem":1},{"text":"e la yebwaili ikanuvagasi goli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Matauna ibubuli valu watanawa odabala tukutaku,","poem":1},{"noteId":279},{"text":"e la yebwaili ikanuvagasi goli.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Matauna ibubuli kalasia deli tubukona,","poem":1},{"text":"e la yebwaili ikanuvagasi goli.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ibubuli kalasia kidamwa bikaraiwogi yam,","poem":1},{"text":"e la yebwaili ikanuvagasi goli.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"E ibubuli tubukona deli utuyam, kidamwa bikaraiwogaisi bogi,","poem":1},{"text":"e la yebwaili ikanuvagasi goli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Matauna ikatumati si kuluta tauwau mina Itipita,","poem":1},{"text":"e la yebwaili ikanuvagasi goli.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Matauna ikugwai mina Isireli e ivisunupuloi metoya mapilana Itipita,","poem":1},{"text":"e la yebwaili ikanuvagasi goli,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"metoya oyamala goli, makweyana kweyapeuligaga,","poem":1},{"text":"e la yebwaili ikanuvagasi goli.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Matauna ivigaki mapilana Bolita Pilabweyani bitabai,","poem":1},{"text":"e la yebwaili ikanuvagasi goli,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"e ikugwai la tomota oluwalela bolita goli,","poem":1},{"text":"e la yebwaili ikanuvagasi goli.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mitaga ikatudoum guyoula Itipita deli la tokwabilia,","poem":1},{"text":"e la yebwaili ikanuvagasi goli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Matauna ikugwai la tomota oluwalela viloupakala,","poem":1},{"text":"e la yebwaili ikanuvagasi goli.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Matauna ikatumati gweguya matausina topapeula,","poem":1},{"text":"e la yebwaili ikanuvagasi goli.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Matauna ikatumati gweguya matausina isim bulogasi,","poem":1},{"text":"e la yebwaili ikanuvagasi goli.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yagasi Siyoni, matauna mina Amora si guyau,","poem":1},{"text":"e la yebwaili ikanuvagasi goli,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"deli Ogi,","poem":1},{"noteId":280},{"text":"matauna guyoula Basani,","poem":1},{"text":"e la yebwaili ikanuvagasi goli.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Matauna ikau si pwaipwaia e isaiki la tomota,","poem":1},{"text":"e la yebwaili ikanuvagasi goli,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"e isaiki baisa mina Isireli la towotetila,","poem":1},{"text":"e la yebwaili ikanuvagasi goli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Matauna gala wala ilumwelavaidasi, avai tuta yakidasi bogwa tamamasi,","poem":1},{"text":"e la yebwaili ikanuvagasi goli.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Matauna itanekwaidasi metoya kada tilaulasi,","poem":1},{"text":"e la yebwaili ikanuvagasi goli.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Matauna iuvakoma komwaidona la bubuli tommomova,","poem":1},{"text":"e la yebwaili ikanuvagasi goli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ibodi bitanokagutokisi baisa matauna labuma la Yaubada,","poem":1},{"text":"e la yebwaili ikanuvagasi goli.","poem":2}]}],"footnotes":[{"noteId":279,"caller":"v","text":"Kugisi Sam 24.2.","reference":{"chapter":136,"verse":6}},{"noteId":280,"caller":"w","text":"Sioni…deli Ogi: Kugisi Sam 135.11.","reference":{"chapter":136,"verse":20}}]},"thisChapterLink":"/api/kij_png/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}