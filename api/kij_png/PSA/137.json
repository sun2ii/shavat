{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":137,"content":[{"type":"heading","content":["Mina Isireli eigalasi e ikavinavinasi"]},{"type":"verse","number":1,"content":[{"text":"Oitayatila makwaisina waya mapilana Babiloni tasilaisi,","poem":1},{"text":"e baisa tavalamsi tutala taluluwaisi mapilana Saiyoni.","poem":2},{"noteId":281}]},{"type":"verse","number":2,"content":[{"text":"Makaisina guvagava tasagaisi da gitasi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Matausina eikatupipaidasi ilukwaidasi mwada bitawosisi.","poem":1},{"text":"Ilukwaidasi kidamwa bitayomwasalaisi matausina.","poem":2},{"lineBreak":true},{"text":"Kawasi, “Bukuwosisi sitana wosila mapilana Saiyoni kalegasi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ammakawala bitawosisi baisa Guyau","poem":1},{"text":"osi valu togilagala?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mwa, Yerusalem! Kidamwa balumwelavaim,","poem":1},{"text":"ibodi gala avai tuta bawai gita tuvaila.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ibodi gala avai tuta bawosivau tuvaila,","poem":1},{"text":"kidamwa gala baluluwaim,","poem":2},{"lineBreak":true},{"text":"e kidamwa gala badokaim uulela ulo mwasawa kala siligaga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"E Guyau, ibodi bukululuwai avaka mina Edom eivagaisi","poem":1},{"noteId":282},{"text":"wa yam makwaina eiyoulisi mapilana Yerusalem.","poem":2},{"text":"Kululuwai ammakawala eililivalasi kawasi,","poem":1},{"text":"“Ka, bitakodidaimisi komwaidona bila opwaipwaia!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"E Babiloni, bogwa bikodidaimimsi.","poem":1},{"lineBreak":true},{"text":"Availa matauna bikau kama lugwasi paila avaka lokuvigakaimasi,","poem":1},{"text":"e matauna bimwasawa goli.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Matauna bikau litumia pwapwawa,","poem":2},{"lineBreak":true},{"text":"e bikatupituki odakuna bikaligasi.","poem":2}]}],"footnotes":[{"noteId":281,"caller":"x","text":"Kugisi Sam 132.13 kala katumiki.","reference":{"chapter":137,"verse":1}},{"noteId":282,"caller":"y","text":"Mabudona mina Edom eipilasaisi mina Babilonia wa tuta matutona eiyoulisi Yerusalem wa taitu 587 BC; kugisi Isi 35.5, Oba 10-14.","reference":{"chapter":137,"verse":7}}]},"thisChapterLink":"/api/kij_png/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}