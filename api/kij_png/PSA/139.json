{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":139,"content":[{"type":"heading","content":["Yaubada inikolaigu e iyamataigu"]},{"type":"verse","number":1,"content":[{"text":"Mwa Guyau! Lokugisimlilaigu tomwaidogu e kunikolaigu wala.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Komwaidona avaka avaka lauvagi yoku kunikoli wala.","poem":1},{"text":"Kusikaduwonaku mitaga kukwateta ulo nanamsa komwaidona.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yeigu kaina lauwotetila kainaga lauvaiwasi,","poem":1},{"text":"mitaga yoku kugigisaigu goli.","poem":2},{"lineBreak":true},{"text":"Kunikoli komwaidona avaka avaka lauvagi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Igau gala balivala,","poem":1},{"text":"e yoku kunikolibogwi avaka bakaibigi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yokugwa kutoulaigu ambaisa ambaisa,","poem":1},{"text":"e metoya om peula kukolaigu goli.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gala gagabila bakateta kala vakaila m nikoli paila yeigu,","poem":1},{"text":"paila kunikoli tomwaidogu e itutuvakau nanogu m nikoli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mwada basakaula metoya baisa yoku, e ambaisaga bam?","poem":1},{"text":"E ammakawala basakaula metoya omatam?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kidamwa bamwena bala labuma, yoku bogwa kusisu baisa.","poem":1},{"text":"Kainaga balokaia Tuma akenu, e yoku bogwa kusisu baisa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kidamwa balokaia mapilana opilibomatu","poem":1},{"text":"kainaga bamili valu mapilana opilikwaibwaga,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ka, yoku kusibogwa paila bukuvakadaigu,","poem":1},{"text":"e mapilawena kusisu paila bukupilasaigu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"kaina gagabila baluki dudubila bikubolaigu,","poem":1},{"text":"kaina lumalama ititapaigu baluki bidavila bimila bogi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mitaga dudubila yoku gala wala bukudoki dudubila,","poem":1},{"text":"e yoku kudoki bogi saina lumalama makawala yam.","poem":2},{"lineBreak":true},{"text":"Dudubila deli lumalama kudoki makawala wala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yoku bogwa kububuli katuputupwaila wowogu","poem":1},{"text":"e kuvisosaigu olopola inagu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Aiyakawolaim, paila ibodi kam kokola bisisu.","poem":1},{"text":"Komwaidona avaka avaka kuuvagi saina kabokatubau,","poem":2},{"lineBreak":true},{"text":"e baisa bogwa anikoli deli nanogu komwaidona.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tutala tutuwanegu ibububulasi,","poem":1},{"text":"e kububulaigu goli olopola inagu.","poem":2},{"text":"Akanupepuni baisa akakaitubwa,","poem":1},{"text":"e yokugwa kunikolibogwi makanakila baisa.","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Igau gala akaloubusi yoku bogwa kugisibogwaigu.","poem":2},{"text":"Tutala ulo yam gala bivitouula,","poem":1},{"text":"yoku bogwa lokuginibogwi om buki","poem":2},{"noteId":284},{"lineBreak":true},{"text":"avaka kala bawa yam makwaisina babani.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mwa Yaubada! M nanamsa saina kwevakaigaga,","poem":1},{"noteId":285},{"text":"e makwaisina saina bidugaga goli.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kidamwa bakalau makwaisina,","poem":1},{"text":"bogwa bikalisau kanakenuva kala bawa.","poem":2},{"lineBreak":true},{"text":"E ka, tutalaga bamamata,","poem":2},{"noteId":286},{"text":"yoku wala mayeigu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Mwa Guyau! Saina magigu bukukwatumati tomitugaga.","poem":1},{"text":"Saina magigu togigasisi bisilavaigusi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ibigigagaimsi e ipakaimsi,","poem":1},{"text":"e ilivalaisi vavagi gaga paila yoku.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"E Guyau, mina kukologu wala matausina ikikoulovaimsi,","poem":1},{"text":"e akaluwou matausina availa availa bogwa eipakaimsi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ulo kowolova paila matausina mina kukologu gala wala isim kala kalitutila,","poem":1},{"text":"e matausina ladoki agu tilaula goli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Mwa Guyau! Bukugisimlilaigu tomwaidogu e bukunikoli nanogu.","poem":1},{"text":"Bukuwakolaigu e bukubani ulo nanamsa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bukunevikoli kaina bukubani avai vavagi gaga olumoulegu,","poem":1},{"text":"e bukuvakadaigu bala keda makadana kadakanigaga","poem":2},{"noteId":287},{"text":"babani momova.","poem":2}]}],"footnotes":[{"noteId":284,"caller":"a","text":"Kugisi Sam 56.8.","reference":{"chapter":139,"verse":16}},{"noteId":285,"caller":"b","text":"saina kwevakaigaga.Gagabila bitagini “m nanamsa saina kwembwailigu”.","reference":{"chapter":139,"verse":17}},{"noteId":286,"caller":"c","text":"tutalaga bamamata.Gagabila bitagini “tutalaga bavenoku kakalawa”.","reference":{"chapter":139,"verse":18}},{"noteId":287,"caller":"d","text":"makadana kadakanigaga.Gagabila bitagini “makadana si keda tubugwa.”","reference":{"chapter":139,"verse":24}}]},"thisChapterLink":"/api/kij_png/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}