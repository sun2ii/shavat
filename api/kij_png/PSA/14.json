{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":14,"content":[{"type":"heading","content":["Tomota si mitugaga"]},{"type":"verse","number":1,"content":[{"text":"Toninagowa","poem":1},{"noteId":30},{"text":"ininamsaisi titoulesi kawasi,","poem":1},{"text":"“Yaubada gala wala avaka!”","poem":2},{"noteId":31},{"text":"Komwaidosi matausina saina gaga,","poem":1},{"text":"e ivagaisi vavagi makwaisina kabokakayuwa.","poem":2},{"lineBreak":true},{"text":"Gala avai tomota isisu tomitukwaibwaila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Guyau wa labuma ikululuki mina watanawa,","poem":1},{"text":"mwada bigisi availa isisu tokabitam,","poem":2},{"lineBreak":true},{"text":"e availa ititapwaroru baisa matauna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mitaga komwaidosi wala bogwa eisulasi,","poem":1},{"text":"komwaidosi goli kasi gaga makawala wala.","poem":2},{"text":"Gala avai tomota isisu tomitukwaibwaila,","poem":1},{"text":"gala goli availa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"E Guyau ikatupoi kawala, “Ki, kaina gala inikolaisi?","poem":1},{"text":"Matausina tomitugaga komwaidosi wala tobubeikam, kadai?","poem":2},{"text":"Paila ititakunasi kʹasi metoya ililebwaisi ulo tomota,","poem":1},{"text":"e gala avai tuta bininigadasi baisa yeigu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Igau wala matausina bikokoluvagasisi,","poem":1},{"text":"paila Yaubada isikaili wala matausina availa availa ikabikuwolaisi matauna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tomitugaga isilibodaisi tomanum avaka la nanamsa mwada bivagi,","poem":1},{"text":"mitaga Guyau matauna kala tokwala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Baisa ulo nigada, kidamwa mina Isireli","poem":1},{"text":"bibanaisi si tomgwaga bima metoya mapilana Saiyoni.","poem":2},{"noteId":32},{"text":"E matutona Guyau bimitukwaii mina Isireli tuvaila,","poem":1},{"text":"bogwa goli bimwasawasi, si mwasawa saina kwevakaigaga.","poem":2}]}],"footnotes":[{"noteId":30,"caller":"f","text":"Baisa availa availa matausina ipakaisi Yaubada e gala wala bikabikuwolaisi matauna (kugisi Big 9.10); mitaga availa availa matausina ititaimamilasi baisa Yaubada, matausina goli tokabitam (kugisi mailela 2).","reference":{"chapter":14,"verse":1}},{"noteId":31,"caller":"g","text":"Kugisi Sam 10.4 deli kala katumiki.","reference":{"chapter":14,"verse":1}},{"noteId":32,"caller":"h","text":"Kugisi Sam 2.6 kala katumiki.","reference":{"chapter":14,"verse":7}}]},"thisChapterLink":"/api/kij_png/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}