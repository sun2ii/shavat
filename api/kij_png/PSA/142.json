{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":142,"content":[{"type":"heading","content":["Nigada paila pilasi"]},{"type":"verse","number":1,"content":[{"text":"Adou baisa Guyau paila pilasi.","poem":1},{"text":"Yeigu akayubabai baisa matauna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amiaki matauna komwaidona ulo takulukulu.","poem":1},{"text":"E aluki matauna komwaidona agu mwau.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Avai tuta magigu baligaim ulo peuloki,","poem":1},{"text":"e matauna inikolibogwi avaka ibodi bavagi.","poem":2},{"text":"Ammakadana yeigu aliloula,","poem":1},{"text":"agu tilaula eikatupwanaisi agu sikula.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Avai tuta agisi okaipapagu,","poem":1},{"text":"gala wala abani availa bipilasaigu.","poem":2},{"text":"Gala availa bikolaigu,","poem":1},{"text":"e gala availa bivaulaigu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mwa Guyau! Adou baisa yoku paila pilasi.","poem":1},{"text":"E Guyau, yoku wala agu Tokwala.","poem":2},{"lineBreak":true},{"text":"Kammwaleta wala yoku magigu ogu tuta tomomova.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kulagi ulo dou paila pilasi,","poem":1},{"text":"paila nanogu kala mmayuyu eivakapusiaigu.","poem":2},{"text":"Kukwatumovaigu metoya agu tilaula.","poem":1},{"text":"Matausina saina mina papeula, e ikikalisauwaigusi wala.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kutanekwaigu metoya kala kaikai nanogu,","poem":1},{"text":"e mapaila osi sigugula","poem":2},{"noteId":293},{"text":"m tomota, yeigu baiyakawolaim,","poem":2},{"lineBreak":true},{"text":"paila uula m bobwailila baisa yeigu.","poem":2}]}],"footnotes":[{"noteId":293,"caller":"j","text":"Kugisi Sam 26.12.","reference":{"chapter":142,"verse":7}}]},"thisChapterLink":"/api/kij_png/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}