{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":22,"content":[{"type":"heading","content":["Taitala idoudou deli kala kaikai nanola, e oluvi iwosi wosila yakaula"]},{"type":"verse","number":1,"content":[{"text":"Ulo Yaubada, ulo Yaubada,","poem":1},{"noteId":49},{"text":"avaka dimlela lokusilavaigu?","poem":1},{"lineBreak":true},{"text":"Deli kala kaikai nanogu ladou paila pilasi,","poem":1},{"text":"mitaga gala wala abani avaka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wa yam adidouwaim yoku ulo Yaubada,","poem":1},{"text":"mitaga gala wala kuvitakaula.","poem":2},{"text":"Wa bogi adoudou,","poem":1},{"text":"mitaga gala wala abani vaiwasi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mitaga yoku om takaikaia idokaimsi Tobumaboma,","poem":1},{"text":"e yoku goli mina Isireli iyakawolaimsi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tubumaiasi eidubumaimsi.","poem":1},{"text":"Eidubumaimsi, e yoku kukoli matausina.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Eidousi baisa yoku, e kukoli matausina.","poem":1},{"text":"Matausina eidubumaimsi, e gala wala avaka biyomwau ninasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mitaga yeigu gala tuvaila bukudokaigusi taitala tau.","poem":1},{"lineBreak":true},{"text":"Yeigu mwatemwata wala,","poem":1},{"text":"e komwaidosi ikaluwouwaigusi ikavilivilaigusi wala!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Availa availa igigisaigusi iyosokanaigusi.","poem":1},{"text":"Ikanumonumsasi mayesi, deli dubasi ikatugougeunasi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kawasi, “Mm! Ka, lokukwakana baisa Guyau.","poem":1},{"text":"Avakaga uula gala bikolaim?","poem":2},{"noteId":50},{"text":"Kidamwa Guyau bogwa idokaim tombwailila yoku,","poem":1},{"text":"Avakaga uula gala bipilasaim? Weei!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ogu tuta kaloubusi, yoku goli kuyomovaigu,","poem":1},{"text":"e ogu tuta pwapwawa yoku goli lokuyamataigu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Igau ogu yam kaloubusi e lagaila, lakakana wala baisa yoku.","poem":1},{"text":"e yoku goli ulo Yaubada tuta komwaidona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Taga kusikaduwonaku metoya baisa yeigu,","poem":1},{"text":"paila makateki baboda mwau,","poem":2},{"lineBreak":true},{"text":"e gala availa isisu paila bipilasaigu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tilaula bidubadu ititoulaigusi,","poem":1},{"text":"makawala bulumakau","poem":2},{"noteId":51},{"text":"nammwala bitoulaisi avaka mwada bivapupoiyaisi.","poem":2},{"lineBreak":true},{"text":"Ititoulaigusi makawala mina Basani si bulumakau nammwala,","poem":2},{"lineBreak":true},{"text":"minasina saina nagigasisi goli.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wodosi ikapogegasi makawala udosi laiyoni,","poem":1},{"text":"e iguguvavilasi mwada bigadaigusi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ulo peula bogwa leiwokuva,","poem":1},{"text":"makawala takatusou sopi bila opwaipwaia, e nani bitamwau.","poem":2},{"text":"Tutuwanegu komwaidona ikasakalasi,","poem":1},{"text":"e ikiuta nanogu sainela.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ipakalaki kaiyogu agu daka goli,","poem":1},{"text":"e mayegu ikapituki tubokawagu,","poem":2},{"text":"e kudoki bogwa lakaliga e kusilavaigu wala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Budotala tomitugaga itoulaigusi,","poem":1},{"text":"e makawala yuwotala kaukwa ivevasi imakaiagusi","poem":2},{"lineBreak":true},{"text":"e igigadaisi yamagu deli kaikegu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tutuwanegu komwaidona isisilasi wala.","poem":1},{"text":"Agu tilaula itobu mitasi igigisaigusi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ikowobobutasi paila agu kwama,","poem":1},{"text":"e isigalaisi miyasina oluwalaisi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"E Guyau, taga kusikaduwonaku metoya baisa yeigu.","poem":1},{"text":"Nani goli bukumakaiagu kukolaigu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bukukolaigu kidamwa gala basilagi metoya opuluta.","poem":1},{"text":"Kukolaigu metoya minasina kaukwa nagigasisi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bukukolaigu metoya minasina laiyoni.","poem":1},{"text":"Bogwa goli bukukolaigu metoya minasina bulumakau nammwala nagigasisi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Bogwa baluki ulo tomota avaka lokuvagi,","poem":1},{"text":"e bayakawolaim osi tuta sigugula.","poem":2},{"noteId":52}]},{"type":"verse","number":23,"content":[{"text":"Kawagu, “Tauwau, yokomi Guyau la towotetila - ka, kuyakawolaisi matauna.","poem":1},{"text":"Yokomi Yekobe dalela, kutemmalaisi matauna,","poem":2},{"lineBreak":true},{"text":"e yokomi mina Isireli, kutapwarorusi baisa matauna.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Matauna gala wala bigigisaki tonamakava,","poem":1},{"text":"kaina bilumwelavi kasi mmayuyu.","poem":2},{"text":"Avai tuta idousi baisa matauna paila pilasi,","poem":1},{"text":"gala wala bitotubuloki matausina.","poem":2},{"lineBreak":true},{"text":"Bogwa bimapu si nigada e bipilasi wala.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Osigugula kwaiveka bayakawolaim paila avaka lokuvagi.","poem":1},{"text":"Omitasi totapwaroru matausina balula avaka bogwa lakatotila.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Tonamakava bikamsi bikomatasi metoya lula makwaina.","poem":1},{"noteId":53},{"text":"Availa availa bimakaiasi Guyau biyakawolaisi matauna.","poem":2},{"text":"Ibodi biyubwailasi si guguwa bidubadu, e gala wala biwokuva.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Komwaidona boda ituwoli ituwoli biluluwaisi Guyau.","poem":1},{"text":"Tomota metoyasi ambaisa ambaisa ovalu watanawa bitovilasi baisa matauna.","poem":2},{"lineBreak":true},{"text":"Tomota komwaidosi avai migila avai migila bitapwarorusi baisa matauna.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Paila Guyau Yaubada matauna Guyau,","poem":1},{"text":"e iguguyoi boda ituwoli ituwoli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Tokamnomwana komwaidosi bikavaginasi baisa matauna.","poem":1},{"text":"Komwaidosi mina watanawa bogwa bikavaginasi baisa omatala matauna.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Tubwa matubosina igau bikaloubusisi biwotitalaisi matauna.","poem":1},{"text":"Tomota bililivalasi paila Guyau baisa matubona oluvi.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Tomota igau gala bikaloubusisi,","poem":1},{"text":"matausina bogwa bilagaisi ammakawala Guyau eikoli la tomota.","poem":2}]}],"footnotes":[{"noteId":49,"caller":"z","text":"Mabigasina Yesu eidou metoya wa korose; kugisi Md 27.46; Mk 15.34.","reference":{"chapter":22,"verse":1}},{"noteId":50,"caller":"a","text":"Yesu kala tilaula eilivalasi mailana mailela wa tuta matutona eikatudeuwaisi matauna wa korose; kugisi Md 27.41-43.","reference":{"chapter":22,"verse":8}},{"noteId":51,"caller":"b","text":"Mapilana Basani mnumonula saina bwaina ibudoki bulumakau bikaitubwasi sainela.","reference":{"chapter":22,"verse":12}},{"noteId":52,"caller":"c","text":"Baisa otutala tapwaroru olumoulela Bwala Kwebumaboma; kugisi tuvaila mailela 25.","reference":{"chapter":22,"verse":22}},{"noteId":53,"caller":"d","text":"Baisa Kalubaila Lulela; wa tuta makwaina kabilatala wala mauna bigabwaisi okabolula, e kesala tobobawa bikamsi wa Bwala Kwebumaboma; kugisi Tol 3.1-5.","reference":{"chapter":22,"verse":26}}]},"thisChapterLink":"/api/kij_png/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}