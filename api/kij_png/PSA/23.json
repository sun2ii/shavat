{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":23,"content":[{"type":"heading","content":["Guyau kada toyamatasi e yakidasi la sipi"]},{"type":"verse","number":1,"content":[{"text":"Guyau matauna agu toyamata, e yeigu goli la sipi.","poem":1},{"text":"Bogwa ayosi komwaidona avaka ibodaigu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Itugwalaigu bavaiwasi okubilela mnumonu semitamata.","poem":1},{"text":"Ilauwaigu okatuwotu kauniwavila sopila sumokainia mwada bamom wala.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ikatupewolaigu e amovavau.","poem":1},{"lineBreak":true},{"text":"Ivakadaigu okedala duwosisia,","poem":1},{"text":"makawala eikatotila bivagi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kainaga baboda dudubila dubilikitakita,","poem":1},{"text":"mitaga gala wala bakokola.","poem":2},{"lineBreak":true},{"text":"E Guyau, yoku goli deli yeigu.","poem":2},{"text":"M lewa","poem":1},{"noteId":54},{"text":"deli m kwaitukwa","poem":1},{"noteId":55},{"text":"bogwa bikolaigu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yoku lokukwatubiasi kamkwam, e kuyeyai kʹagu,","poem":1},{"text":"ambaisa agu tilaula komwaidosi gagabila bigisaigusi.","poem":2},{"text":"Kubodaigu wa lulu e asuvi deli agu taimamila,","poem":1},{"text":"e kuvakasau agu viga.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Anikoli bukumitukwaiyaigu deli bukuyebwailigu ogu tuta tomomova komwaidona,","poem":1},{"text":"e yeigu basivagasi om bwala","poem":2},{"noteId":56},{"text":"ogu tuta komwaidona.","poem":2}]}],"footnotes":[{"noteId":54,"caller":"e","text":"Makaina lewa matauna toyamata bibutugigai mauna nagigasisi.","reference":{"chapter":23,"verse":4}},{"noteId":55,"caller":"f","text":"Avai tuta sipi bikapusisi kaina bililoulasi wa keda gaga, toyamata biyosi makaina la kaitukwa e bikalidagi tosilibeibeu.","reference":{"chapter":23,"verse":4}},{"noteId":56,"caller":"g","text":"Baisa Bwala Kwebumaboma, baisa goli Yaubada isikailiki la tomota.","reference":{"chapter":23,"verse":6}}]},"thisChapterLink":"/api/kij_png/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}