{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":24,"content":[{"type":"heading","content":["Guyau matauna Giyouveka"]},{"type":"verse","number":1,"content":[{"text":"Valu watanawa deli uvagila komwaidona, baisa Guyau la vavagi.","poem":1},{"text":"Valu valu komwaidona deli kala tosisu komwaidosi, baisa matauna la vavagi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Eikaliai valu watanawa odabala sopi osikowala pwaipwaia,","poem":1},{"noteId":57},{"text":"e isaim tumilela","poem":2},{"noteId":58},{"text":"otulubwabwau.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ki, availa ibodi","poem":1},{"noteId":59},{"text":"bimwena ola koya Guyau,","poem":1},{"noteId":60},{"text":"e availa ibodi bisuvi ola Bwala Kwebumaboma?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kidamwa matauna kweyamigileu yamala e la nanamsa migileuwokuva wala,","poem":1},{"text":"kidamwa gala eitapwaroru baisa avai tokolu,","poem":2},{"lineBreak":true},{"text":"e gala ilivala katotila sasopa,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"e Guyau bimitukwaii deli bikoli matauna.","poem":1},{"text":"Yaubada bidoki matauna tobwaila wala.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tomota makawala matauna","poem":1},{"noteId":61},{"text":"ibodi bilokaiasi Yaubada,","poem":1},{"text":"deli bisuvisi bimaisi omatala Yekobe la Yaubada.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kuulaimwaisi kalapisila","poem":1},{"noteId":62},{"text":"bikabauwaiasi,","poem":1},{"text":"e lulu kaduyobubogwa bikapogegasi,","poem":2},{"lineBreak":true},{"text":"e matauna Giyouveka bogwa bisuvi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ki, availaga matauna Giyouveka?","poem":1},{"lineBreak":true},{"text":"Matauna goli Guyau, Topeuligaga sainela.","poem":1},{"text":"Matauna Guyau, Tokwalisewa otutala kabilia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kuulaimwaisi kalapisila bikabauwaiasi,","poem":1},{"text":"e lulu kaduyobubogwa bikapogegasi,","poem":2},{"lineBreak":true},{"text":"e matauna Giyouveka bogwa bisuvi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ki, availaga matauna Giyouveka?","poem":1},{"lineBreak":true},{"text":"Matauwena Guyau Totomgwaga, matauwena goli Giyouveka.","poem":1}]}],"footnotes":[{"noteId":57,"caller":"h","text":"Idokaisi bolita kwaitala kwevakaigaga isisu osikowala pwaipwaia, makwaina goli uulela komwaidona waya deli iluyelu ovalu watanawa.","reference":{"chapter":24,"verse":2}},{"noteId":58,"caller":"i","text":"Kugisi Sam 18.15.","reference":{"chapter":24,"verse":2}},{"noteId":59,"caller":"j","text":"Kugisi Sam 15.1.","reference":{"chapter":24,"verse":3}},{"noteId":60,"caller":"k","text":"Baisa tumilela Bwala Kwebumaboma mapilana Yerusalem; kugisi Sam 2.6.","reference":{"chapter":24,"verse":3}},{"noteId":61,"caller":"l","text":"Kugisi Sam 15.2-5.","reference":{"chapter":2