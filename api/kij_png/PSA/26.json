"poem":1},{"text":"e aleili matausina goli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Guyau, ka, awini yamagu paila bikamituli mwada yeigu tobwaila wala,","poem":1},{"text":"deli atitavina om kwabolula e atitapwaroru.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Avitau pilatala wosila nokagutoki","poem":1},{"text":"e deli alivali komwaidona avaka avaka lokuvagi saina kabokatubau.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mwa Guyau! Ayebwaili bwala makwaina lokusisiki,","poem":1},{"noteId":65},{"text":"baisa goli bolela kam kwatububula.","poem":2},{"noteId":66}]},{"type":"verse","number":9,"content":[{"text":"Taga bukukwatumataigu tutala kukwatumati tomitugaga.","poem":1},{"text":"Kukolaigu metoya okasi mipuki tokatumata -","poem":2}]},{"type":"verse","number":10,"content":[{"text":"tomota matausina eiuvagaisi vavagi gaga tuta komwaidona,","poem":1},{"text":"e deli itulotulasi paila bikauwaisi avaka katupatula udosi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mitaga yeigu, ka, avagi avaka duwosisia wala.","poem":1},{"text":"Kunokapisaigu deli kukwatumovaigu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yeigu bogwa lakwala metoya komwaidona kabosilagi.","poem":1},{"text":"E osi sigugula","poem":2},{"noteId":67},{"text":"la tomota ayakawoli Guyau.","poem":2}]}],"footnotes":[{"noteId":65,"caller":"p","text":"Bwala Kwebumaboma mapilana Yerusalem.","reference":{"chapter":26,"verse":8}},{"noteId":66,"caller":"q","text":"Bwala Kwebumaboma kala katububula komwaidona baisa kabutuvitusila Yaubada kala katububula.","reference":{"chapter":26,"verse":8}},{"noteId":67,"caller":"r","text":"Mina Isireli tuta tuta bisigugulasi wa Bwala Kwebumaboma bitapwarorusi baisa Yaubada; kugisi Sam 22.22.","reference":{"chapter":26,"verse":12}}]},"thisChapterLink":"/api/kij_png/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}