{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":27,"content":[{"type":"heading","content":["Nigadela yakaula"]},{"type":"verse","number":1,"content":[{"text":"Guyau matauna ulo kaitapa","poem":1},{"noteId":68},{"text":"deli agu tokwatumova.","poem":1},{"text":"Yeigu gala wala bakukoli availa.","poem":2},{"text":"Guyau bikolaigu e gala basilagi,","poem":1},{"text":"mapaila gala wala avai tuta bakokola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kidamwa tomitugaga iyosaigusi mwada bikatumataigusi,","poem":1},{"text":"isilibeibeusi e ikapusisi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kaina goli tokwabilia budumwaidona bitoulaigusi,","poem":1},{"text":"e gala wala bakokola.","poem":2},{"text":"Kainaga tilaula biyosaigusi,","poem":1},{"text":"mitaga badubumi wala Yaubada.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bogwa lanigada baisa Guyau mwada kwaitala wala vavagi bisakaigu,","poem":1},{"text":"e kwaitinidesi wala vavagi magigu.","poem":2},{"text":"Magigu basisu Guyau ola bwala","poem":1},{"noteId":69},{"text":"ogu tuta komwaidona,","poem":1},{"text":"e baisa batulaula paila la bobwailila","poem":2},{"lineBreak":true},{"text":"deli banigadi bivakadaigu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Paila matauna bikatupwanaigu kidamwa avai tuta baboda mwau.","poem":1},{"text":"Bikolaigu ola Bwala Kwebumaboma,","poem":2},{"lineBreak":true},{"text":"e bisailigu bakwala odabala dukutotu kwaiveka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"E mapaila yeigu batomgwaga odubasi agu tilaula eitoulaigusi.","poem":1},{"text":"Bagova deli mwasawa e bagabu lula ola Bwala Kwebumaboma.","poem":2},{"lineBreak":true},{"text":"Bausiwosi e bayakawoli Guyau.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mwa, Guyau! Bukulagaigu tutala adidouwaim.","poem":1},{"text":"Bukunokapisaigu e bukumapu ulo dou.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tuta matutona lokukwaibiga, “Kumaisi bukutapwarorusi baisa yeigu,”","poem":1},{"lineBreak":true},{"text":"e yeigu lavitakaula, kawagu, “Guyau, bogwa bawa.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Taga bukukwatupwanaim metoya baisa yeigu!”","poem":2},{"lineBreak":true},{"text":"Taga kugibuluwaigu,","poem":1},{"text":"e gala bukuyabaigu, yeigu m towotetila.","poem":2},{"text":"Yoku bogwa lokupilasaigu.","poem":1},{"text":"Mwa! Yaubada agu tokwatumova,","poem":2},{"lineBreak":true},{"text":"taga kusilavaigu e taga kuligaimwaigu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kaina tamagu inagu biligaimwaigusi","poem":1},{"text":"mitaga yoku Guyau bukuvaulaigu goli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"E Guyau, bukuvitulokaigu avaka nanom mwada bavagi,","poem":1},{"text":"e kuvakadaigu ambaisa gala baboda silagi,","poem":2},{"lineBreak":true},{"text":"paila uula bidubadu agu tilaula isisuaisi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Taga bukuligaiwaigu baisa agu tilaula","poem":1},{"text":"paila iwaigusi osi sasopa deli si vitukokola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Anikoli kidamwa igau wala basisu tomomova","poem":1},{"text":"e bagisi Guyau la bobwailila.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kudubumaisi Guyau.","poem":1},{"text":"Kupapeulasi wala, taga kusaimwaisi pikwaku.","poem":2},{"text":"E kudubumaisi Guyau.","poem":1}]}],"footnotes":[{"noteId":68,"caller":"s","text":"Baisa kabutuvitusila momova deli peula; kugisi Sam 18.26 kala katumiki.","reference":{"chapter":27,"verse":1}},{"noteId":69,"caller":"t","text":"Bwala Kwebumaboma mapilana Yerusalem; kugisi Sam 23.6.","reference":{"chapter":27,"verse":4}}]},"thisChapterLink":"/api/kij_png/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}