availa availa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kumipuki matausina paila avaka avaka bogwa eivagaisi,","poem":1},{"text":"paila avai mitugaga avai mitugaga eivagaisi.","poem":2},{"text":"Kumipuki matausina paila komwaidona avaka leiuvagaisi,","poem":1},{"text":"e kusaiki avaka bibudoki kasi mipuki.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gala itovilakaisi avaka Guyau bogwa eivagi,","poem":1},{"text":"Kaina itovilakaisi avaka bogwa eibubuli.","poem":2},{"text":"Mapaila baisa bimipuki matausina,","poem":1},{"text":"deli bikatudoum wala matausina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kuyakawolaisi Guyau.","poem":1},{"text":"Matauna bogwa eilagi ulo dou paila pilasi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Guyau itabodaigu e ikolaigu.","poem":1},{"text":"Yeigu adubumi matauna.","poem":2},{"text":"Ipilasaigu deli iyomwasalaigu.","poem":1},{"text":"E yeigu deli ulo mwasawa ausiwosi kala yakaula matauna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Guyau itabodi la tomota,","poem":1},{"text":"e ikoli deli ikatumovi matauna guyau availa bogwa einagi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mwa Guyau! Kukwatumovi m tomota,","poem":1},{"text":"deli kumitukwaii matausina.","poem":2},{"text":"Kuvigakaim yoku kasi toyamata,","poem":1},{"text":"e deli kuyamati matausina taitu taitu.","poem":2}]}],"footnotes":[{"noteId":70,"caller":"u","text":"Baisa si valu tomata; kugisi tuvaila 6.5 kala katumiki.","reference":{"chapter":28,"verse":1}},{"noteId":71,"caller":"v","text":"Biyosali yamala avai tuta binigada.","reference":{"chapter":28,"verse":2}}]},"thisChapterLink":"/api/kij_png/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}