{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":29,"content":[{"type":"heading","content":["Kaigala Guyau outuyagila"]},{"type":"verse","number":1,"content":[{"text":"Kuyakawolaisi Guyau yokomi mina labuma.","poem":1},{"noteId":72},{"text":"Kuyakawolaisi la guyugwayu deli la peuligaga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kuyakawolaisi Guyau toguyugwayu sainela,","poem":1},{"text":"kukululusi omatala matauna Tobumaboma avai tuta biviloubusi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ka, kaigala Guyau talilagi odabala milaveta.","poem":1},{"text":"Yaubada toguyugwayu ibutupilapala","poem":2},{"lineBreak":true},{"text":"e kaigala saina kaigaveka obolita.","poem":2},{"noteId":73}]},{"type":"verse","number":4,"content":[{"text":"Kaigala Guyau talagaisi saina peula.","poem":1},{"text":"Kaigala Guyau butula itutuvakau nona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kaigala Guyau bikouwoli kweisila.","poem":1},{"text":"Kaina goli kweisilela mapilana Lebanoni,","poem":2},{"noteId":74},{"lineBreak":true},{"text":"mitaga bikouwoli wala.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ivigaki koyala mapilana Lebanoni","poem":1},{"text":"biyuweitaulasi makawala bulumakau nagugwadi,","poem":2},{"lineBreak":true},{"text":"e ivigaki makwaina Koya Emoni","poem":2},{"noteId":75},{"lineBreak":true},{"text":"bipela makawala bulumakau namwala natubovau.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kaigala Guyau ivigaki kavikavila bikavila.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kaigala ivigaki viloupakala biyega","poem":1},{"text":"e iiyagi mapilana viloupakalela Kadesi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Guyau kaigala iiyiku yawa,","poem":1},{"text":"e ikatudebali yekwesisi makaisina kai.","poem":2},{"lineBreak":true},{"text":"E komwaidosiga ola Bwala Kwebumaboma","poem":2},{"lineBreak":true},{"text":"idoudousi kawasi, “Yaubada Toguyugwayu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Guyau ikaraiwogi komwaidona tilibwabwau.","poem":1},{"text":"Matauna Guyau la karaiwaga gala wala biwokuva.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Guyau ikatupewoli la tomota,","poem":1},{"text":"e ikatiligavi luposi matausina.","poem":2}]}],"footnotes":[{"noteId":72,"caller":"w","text":"Kaina anelosi kainaga yaubada ituwoli ituwoli iwotitalaisi Yaubada; kugisi Yob 3.6.","reference":{"chapter":29,"verse":1}},{"noteId":73,"caller":"x","text":"Baisa Bolita Kwaiveka — kugisi maps.","reference":{"chapter":29,"verse":3}},{"noteId":74,"caller":"y","text":"Kweisila makaisina goli saina kaiminibwaina deli kaivakaveka, idokaisi kaimatala kai komwaidona.","reference":{"chapter":29,"verse":5}},{"noteId":75,"caller":"z","text":"Makwaina koya kwewonaku odabala koyala mapilana Siria.","reference":{"chapter":29,"verse":6}}]},"thisChapterLink":"/api/kij_png/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}