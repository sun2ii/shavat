{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":3,"content":[{"type":"heading","content":["Nigadela kaukwau paila pilasi"]},{"type":"verse","number":1,"content":[{"text":"Mwa Guyau! Agu tilaula saina bidugaga,","poem":1},{"text":"saina bidugaga inopakaigusi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Matausina ililivalaigusi e kawasi,","poem":1},{"text":"“Yaubada gala wala bipilasi matauna.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mitaga yoku Guyau tuta komwaidona ulo vayoula metoya okabosilagi.","poem":1},{"text":"Kuvigakaigu batomgwaga","poem":2},{"lineBreak":true},{"text":"e kuvatuviluwi wowogu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Adoudou baisa Guyau paila pilasi,","poem":1},{"text":"e metoya ola koya kwebumaboma","poem":2},{"noteId":7},{"text":"matauna immapu ulo dou.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yeigu bakenu bamasisi,","poem":1},{"text":"e bogi kwemwaidona Guyau bikolaigu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tailakatuluwovila tilaula itoulaigusi itopataigusi,","poem":1},{"text":"mitaga yeigu gala wala akukoli matausina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mwa! Guyau ulo Yaubada, kumakaiagu kukolaigu.","poem":1},{"lineBreak":true},{"text":"Paila lokumipuki komwaidosi agu tilaula,","poem":1},{"text":"e lokukodidaimi si peula kidamwa gala gagabila biyogagaigusi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bitatomgwagasi metoya baisa wala Guyau.","poem":1},{"text":"Ibodi wala matauna bimitukwaiyaidasi yakidasi la tomota.","poem":2}]}],"footnotes":[{"noteId":7,"caller":"h","text":"Kugisi Sam 2.6.","reference":{"chapter":3,"verse":4}}]},"thisChapterLink":"/api/kij_png/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}