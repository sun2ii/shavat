eivagi","poem":1},{"text":"e kunokagutokisi baisa matauna!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Matauna la gibuluwa gala wala imomwa biwokuva,","poem":1},{"text":"e la bobwailila isisu tubwa komwaidona.","poem":2},{"text":"Kaina mitalogi ibodi bibubusisi wa bogi,","poem":1},{"text":"mitaga eiyam kaukwau mwasawa biviloubusi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yeigu bogwa lalumkoli eiluva wala wowogu,","poem":1},{"text":"e kawagu, “Gala wala availa bikalisauwaigu.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mwa Guyau! Yoku lokumitukwaibwailigu.","poem":1},{"text":"Lokukolaigu makawala kwaitala bolela kabilia wa koya bikoli tomota.","poem":2},{"text":"Mitaga oluvi yoku kukwatupwanaim metoya baisa yeigu,","poem":1},{"text":"e yeigu bogwa lakokola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mwa Guyau! Yeigu ladou baisa yoku","poem":1},{"text":"e akayubabai paila bukupilasaigu,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"e kawagu, “Avai vavagi bwaina bukubani metoya ogu kwaliga?","poem":1},{"text":"Avaka tuvaila bukubani kidamwa yeigu bala wa laka?","poem":2},{"text":"Ki, igagabila tokwaliga biyakawolaimsi?","poem":1},{"noteId":77},{"text":"Kaina igagabila bikamitulaisi m bobwailila kwekanuvagasi ke?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mwa Guyau! Kunakaigalaigu e bukunokapisaigu.","poem":1},{"text":"Mwa Guyau! Kupilasaigu!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yoku lokuvigaki ulo ninamwau biwokuva,","poem":1},{"text":"e akakaiwosi deli ulo mwasawa.","poem":2},{"lineBreak":true},{"text":"Yoku bogwa lokuvisimolaigu,","poem":2},{"lineBreak":true},{"text":"e kuvakasauwaiguga mwasawa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mapaila galaga bakapatu.","poem":1},{"text":"Bausiwosi wala kam yakaula.","poem":2},{"text":"Mwa Guyau! Yoku wala ulo Yaubada,","poem":1},{"text":"e tuta komwaidona banokagutoki baisa yoku.","poem":2}]}],"footnotes":[{"noteId":76,"caller":"a","text":"Mapilana si valu tomata; kugisi Sam 6.5.","reference":{"chapter":30,"verse":3}},{"noteId":77,"caller":"b","text":"Mapilana Tuma gala availa biyakawoli Yaubada; kugisi Sam 6.5 kala katumiki.","reference":{"chapter":30,"verse":9}}]},"thisChapterLink":"/api/kij_png/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}