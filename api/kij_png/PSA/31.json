{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":31,"content":[{"type":"heading","content":["Nigadela dubumi baisa Yaubada"]},{"type":"verse","number":1,"content":[{"text":"Mwa Guyau! Lamakaiam paila bukukolaigu.","poem":1},{"text":"Gala avai tuta bukutagwala bikalisauwaigusi.","poem":2},{"text":"Yoku Yaubada saina tomitukwaibwaila.","poem":1},{"text":"Anigadaim kukwatumovaigu!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kulagaigu, e kukwatumovaigu tuta baisa!","poem":1},{"lineBreak":true},{"text":"Bukuvigakaim agu tokwala e bukukolaigu,","poem":1},{"text":"deli bukuvigakaim agu taboda yoku","poem":2},{"lineBreak":true},{"text":"e bukukwatumovaigu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yoku agu tokwala deli agu taboda.","poem":1},{"text":"Kuvakadaigu deli kukugwaiyaigu","poem":2},{"lineBreak":true},{"text":"makawala m biga katotila.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kuyamataigu metoya wa sikula makaina","poem":1},{"text":"eileiyasi paila yeigu,","poem":2},{"lineBreak":true},{"text":"e kukolaigu metoya okabosilagi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Atugwalaigu baisa yoku kidamwa bukuyamataigu.","poem":1},{"noteId":78},{"lineBreak":true},{"text":"Yoku Guyau bukukwatumovaigu.","poem":1},{"text":"Yoku Yaubada saina tokimadagi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yoku kukoulovi availa availa matausina","poem":1},{"text":"itapwarorusi baisa minasina yaubada sasopa.","poem":2},{"lineBreak":true},{"text":"Mitaga yeigu adubumaim wala.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yeigu goli bamwasawa deli bakaimwana","poem":1},{"text":"paila uula m mitakwai.","poem":2},{"text":"Yoku kugisi kagu mmayuyu","poem":1},{"text":"e kunikoli agu mwau.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yoku gala kutagwala agu tilaula bikatupipaigusi.","poem":1},{"text":"E yoku bogwa kutanekwaigu","poem":2},{"lineBreak":true},{"text":"e bala wala ambaisa magigu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mwa Guyau! Kunokapisaigu,","poem":1},{"text":"paila uula yeigu bogwa laboda mwau.","poem":2},{"text":"Matagu bogwa eisomata saina auvalam,","poem":1},{"text":"e yeigu mokwitatoula wala bogwa eimitaki wowogu","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yeigu bogwa leisomitakaigu wala ninamwau,","poem":1},{"text":"e valam wala iutupwi ulo momova.","poem":2},{"text":"Bogwa wala lamama metoya komwaidona agu mwau,","poem":1},{"text":"e ivigaki goli tutuwanegu isisilasi wala iwokuva.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Komwaidosi wala agu tilaula ikaluwouwaigusi,","poem":1},{"text":"e isiligaga goli segwaia ikaluwouwaigusi makawala.","poem":2},{"text":"Matausina availa availa inikolaigusi","poem":1},{"text":"bogwa wala eikukolaigusi.","poem":2},{"lineBreak":true},{"text":"Avai tuta bigisaigusi wa keda bisakaulasi wala.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Komwaidosi wala bogwa eilumwelavaigusi,","poem":1},{"text":"makawala idokaigusi bogwa lakaliga.","poem":2},{"lineBreak":true},{"text":"Yeigu makawala kwaitala vavagi bogwa talavi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Alilagi bidubadu tilaula ikikasilamsi.","poem":1},{"lineBreak":true},{"text":"Ikikeiwalaigusi paila bikatumataigusi,","poem":1},{"text":"e kokola itavinaigu itapataigu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mwa Guyau! Yoku wala adubumaim.","poem":1},{"text":"Yoku wala ulo Yaubada.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yeigu tuta komwaidona kuiyamataigu.","poem":1},{"text":"Kukolaigu metoya agu tilaula,","poem":2},{"lineBreak":true},{"text":"e metoya baisa matausina ilamidadaigusi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kugisaigu yeigu m towotetila deli m ninabwaila,","poem":1},{"text":"e kukwatumovaigu metoya om mitakwai.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mwa Guyau! Adou baisa yoku.","poem":1},{"text":"Gala bukutagwala yeigu bammosila.","poem":2},{"text":"Kuvigaki tomitugaga bimmosilasi,","poem":1},{"text":"e bivasilamsi bilosi Tuma.","poem":2},{"noteId":79}]},{"type":"verse","number":18,"content":[{"text":"Kukwatupatu udosi matausina tosisasopa.","poem":1},{"text":"Komwaidosi matausina ninasi walakaiwa","poem":2},{"lineBreak":true},{"text":"deli matausina ikaiveka ninasi,","poem":2},{"lineBreak":true},{"text":"matausina ikikaluwouwaisi tomitukwaibwaila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Isa bwainigaga makwaisina vavagi bwaina","poem":1},{"text":"yoku kukwatubiasi paila matausina","poem":2},{"lineBreak":true},{"text":"availa availa ititemmalaimsi.","poem":2},{"lineBreak":true},{"text":"Komwaidosi wala inikolaimsi yoku saina bwaina,","poem":2},{"lineBreak":true},{"text":"e inikolaisi ammakawala lokukoli matausina","poem":2},{"lineBreak":true},{"text":"availa availa idubumaimsi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kukwatupwani matausina ikwalasi baisa yoku,","poem":1},{"text":"e gala bisilagisi metoya tomota matausina ikikeiwalaisi.","poem":2},{"text":"Kukwatupwani matausina okabokwala bwaina","poem":1},{"text":"mwada kasi tilaula gala bikavilakaisi matausina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kala yakaula Guyau!","poem":1},{"lineBreak":true},{"text":"Avai tuta tilaula eivaulaigusi e iwaigusi,","poem":1},{"text":"Guyau saina bwainigaga eimitukwaiyaigu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yeigu agu kokola adoki wala","poem":1},{"text":"bogwa eibokavilaigu metoya omatala.","poem":2},{"text":"Mitaga avai tuta ladou baisa matauna paila pilasi,","poem":1},{"text":"matauna ilagi ulo dou.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Komwaidomi yokomi la tomota tokimadagi,","poem":1},{"text":"kuyebwailisi Guyau.","poem":2},{"text":"Guyau matauna ikoli tokimadagi matausina,","poem":1},{"text":"mitaga imipuki matausina ninasi walakaiwa,","poem":2},{"lineBreak":true},{"text":"makawala avaka bibudoki kasi mipuki.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Komwaidomi yokomi availa availa kupikwakusi baisa Guyau,","poem":1},{"text":"bukutotusi peula, e bukutuvaluwasi.","poem":2}]}],"footnotes":[{"noteId":78,"caller":"c","text":"Yesu eilivala mabigana metoya wa korose; kugisi Lk 23.46.","reference":{"chapter":31,"verse":5}},{"noteId":79,"caller":"d","text":"Kugisi Sam 6.5.","reference":{"chapter":31,"verse":17}}]},"thisChapterLink":"/api/kij_png/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}