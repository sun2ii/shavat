{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":47,"content":[{"type":"heading","content":["Yaubada matauna Giyoumatala"]},{"type":"verse","number":1,"content":[{"text":"Komwaidomi tomota bukukwatupatusi yumami deli mi mwasawa.","poem":1},{"text":"E bukuwosisi yakaula kaigaveka baisa Yaubada.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Guyau Towalakaiwa Sainela","poem":1},{"noteId":112},{"text":"isim kala kokola.","poem":1},{"text":"Matauna Giyouveka iguguyoi komwaidona valu watanawa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Matauna eivigakaidasi tatomgwagasi odubasi mabudosina tomota.","poem":1},{"text":"Eivigakaidasi takaraiwagasi odubasi boda ituwoli ituwoli.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Matauna inagi da valusi, e baisa goli tasisikaisi.","poem":1},{"text":"Makwaina goli da valusi viloumatabwaila, paila yakidasi la tomota,","poem":2},{"lineBreak":true},{"text":"e yakidasi goli mina mbwailila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yaubada imweimwena bisili ola takaikaia.","poem":1},{"text":"Guyau imweimwena,","poem":2},{"lineBreak":true},{"text":"e tagovasi deli mwasawa, e deli tauya itagilulu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bukuwosisi yakaula baisa Yaubada.","poem":1},{"text":"Bukuwosisi yakaula baisa da Guyausi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Matauna iguguyoi komwaidona valu watanawa.","poem":1},{"text":"Bukuyakawolaisi matauna deli wosi!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yaubada isili ola takaikaia kwebumaboma.","poem":1},{"text":"Iguguyoi odubasi boda ituwoli ituwoli.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Si gweguya mabudosina boda ituwoli ituwoli itogugulasi","poem":1},{"text":"itotusi deli Yaubada la tomota, matauna Eberaam la Yaubada goli.","poem":2},{"text":"Matauna saina Topeuligaga ikalisuwoli tokwabilia budumwaidosi.","poem":1},{"text":"Matauna goli Giyoumatala.","poem":2}]}],"footnotes":[{"noteId":112,"caller":"k","text":"Kugisi Sam 7.17 kala katumiki.","reference":{"chapter":47,"verse":2}}]},"thisChapterLink":"/api/kij_png/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}