{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":55,"content":[{"type":"heading","content":["La nigada taitala tau lubaila eikasali matauna"]},{"type":"verse","number":1,"content":[{"text":"Mwa Yaubada! Kulagi ulo nigada.","poem":1},{"text":"Taga kutotubuloki ulo yokakapisi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kunakaigalaigu deli kuvitakaulokaigu.","poem":1},{"text":"Ulo nokubukubu bogwa eiyogagaigu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Si kapoi agu tilaula bogwa eiyokukolaigu,","poem":1},{"text":"e tomitugaga si lamadada bogwa eisomitaki wowogu.","poem":2},{"text":"Matausina iyomwauwaigusi.","poem":1},{"text":"Igibuluwaigusi, deli goli tokukolosi yeigu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yeigu ibulukukolaigu,","poem":1},{"text":"deli kaliga kokolela iyomami nanogu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yeigu bogwa lakokola deli atatuva.","poem":1},{"text":"Kabokakayuwa saina immakiusa wowogu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"O kidamwa isim pinupanegu, makawala bubuna.","poem":1},{"text":"Gagabila bayowa balʹo babani vaiwasi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mokwita goli bayowa bala kaduwonaku","poem":1},{"text":"e bamili valu oviloupakala.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gagabila bananakwa basipepuni","poem":1},{"text":"metoya yagila saina minimani deli utuyagila.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mwa Guyau! Kusipinigu si bigatona agu tilaula.","poem":1},{"lineBreak":true},{"text":"Bogwa lagisi tomota iiyowaisi deli ikukwaiyaisi ovalu.","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Ivaulaisi ivapataisi valu yam deli bogi,","poem":2},{"lineBreak":true},{"text":"e valu ivakasau sula deli vavagi mwau.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kodadaimi isisu ambaisa ambaisa.","poem":1},{"text":"Kedala valu ikasewa lamadada deli wabu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kidamwa taitala tilaula biyosokanaigu,","poem":1},{"text":"gagabila bapeuloki.","poem":2},{"text":"E kidamwa taitala tokominimani bikaluvalova baisa yeigu,","poem":1},{"text":"yeigu gagabila basipepuni metoya baisa matauna.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mitaga baisa yoku kalogu lokuyosokanaigu!","poem":1},{"text":"Yoku sogu deli lubaigu tatougu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bogwa tabigikium kadataiyu,","poem":1},{"text":"deli kadataiyu tatapwaroru wa Bwala Kwebumaboma.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bibodi agu tilaula bikaligasi igau gala bibodi si tuta.","poem":1},{"text":"Ibodi matausina bibusisi tommomova bilosi Tuma!","poem":2},{"noteId":121},{"text":"Mitugagawokuva wala isisu osi bwala deli oninasi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mitaga yeigu adou baisa Guyau Yaubada paila pilasi,","poem":1},{"text":"e matauna bikatumovaigu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kaukwau, lalavi deli bogi","poem":1},{"noteId":122},{"text":"ulo kavilavila deli ulo kayagigila imwena baisa matauna,","poem":2},{"lineBreak":true},{"text":"e matauna bogwa bilagi kaigagu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Matauna bikaimalaigu bwainawokuva wala","poem":1},{"text":"metoya okabilia makwaisina laiyowai,","poem":2},{"lineBreak":true},{"text":"baisa tilaula saina bidugaga.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yaubada matauna bogwa eigiyoubogwa metoya tuta kala vitouula,","poem":1},{"text":"e matauna bilagaigu deli bikalisau matausina.","poem":2},{"text":"Paila ipakaisi bininavilasi,","poem":1},{"text":"deli gala sitana ikukolaisi matauna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kalogu tobogwa iwaiya lubaila matausina.","poem":1},{"text":"Bogwa eikotuni la biga katotila.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"La biga kala posa ikalisau mona posala,","poem":1},{"text":"mitaga kowolova wala isisu onanola.","poem":2},{"text":"La biga saina dumokikina makawala bulami dumokikinela,","poem":1},{"text":"mitaga bitai makawala kema kala kakata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Kuvakalisi m koni mwau baisa Guyau,","poem":1},{"text":"e matauna bikolaim.","poem":2},{"lineBreak":true},{"text":"Matauna gala wala bitagwala tokamokwita bimamasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Mitaga yoku, ulo Yaubada, bukumipuki matausina tokatumata deli tosasopa bikaligasi","poem":1},{"text":"igau gala mabila kasi tomoya bikalisau.","poem":2},{"text":"Mitaga yeigula badubumaim wala.","poem":1}]}],"footnotes":[{"noteId":121,"caller":"t","text":"Kugisi Baw 16.31-33. Mapilana Tuma baisa si valu tomata, mina Isireli idokaisi isisu osikowala pwaipwaia.","reference":{"chapter":55,"verse":15}},{"noteId":122,"caller":"u","text":"kaukwau, lalavi deli bogi. Tuta matutosina tutala nigada yam yam.","reference":{"chapter":55,"verse":17}}]},"thisChapterLink":"/api/kij_png/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}