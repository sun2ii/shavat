{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":61,"content":[{"type":"heading","content":["Nigada paila kabokwala"]},{"type":"verse","number":1,"content":[{"text":"Mwa Yaubada! Kulagi ulo dou,","poem":1},{"text":"e kunakaigali ulo nigada.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tutala ulo pikwaku eiwokuva deli asikaduwonaku metoya ogu valu,","poem":1},{"text":"mapaila adou baisa yoku.","poem":2},{"lineBreak":true},{"text":"Kukwauwaigu kulauwaigu kwaitala kabokwala bwaina,","poem":1}]},{"type":"verse","number":3,"content":[{"text":"paila yoku wala agu tokwala,","poem":2},{"lineBreak":true},{"text":"e yoku agu taboda peula metoya agu tilaula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kutagwala basisu om Bwala Kwebumaboma","poem":1},{"noteId":131},{"text":"ogu tuta komwaidona,","poem":1},{"text":"e basisu luvala wowogu osikowala pinupanem.","poem":2},{"noteId":132}]},{"type":"verse","number":5,"content":[{"text":"Mwa Yaubada! Yoku bogwa kulagi komwaidona ulo biga katotila,","poem":1},{"text":"e bogwa lokusakaigu avaka ibodi bakayosisi komwaidomasi yakamaisi availa availa katemmalaimsi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kukwatumkulovi guyau kala taitu bibidubadu,","poem":1},{"text":"e kutagwala matauna bisisu tuta kaduwonaku!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mwa Yaubada! Ibodi matauna la karaiwaga gala kala vigimkovila metoya omatam.","poem":1},{"text":"Kukoli matauna e kumitukwaii deli m kimadagi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mapaila tuta komwaidona bausiwosi kam yakaula,","poem":1},{"text":"e yam kwaitala kwaitala basisakaim avaka bogwa lakatotila.","poem":2}]}],"footnotes":[{"noteId":131,"caller":"d","text":"Makwaina isisu mapilana Yerusalem.","reference":{"chapter":61,"verse":4}},{"noteId":132,"caller":"e","text":"Kugisi Sam 17.8; mitaga tuta baisa kaina ililivala paila Kabutu Didawogala deli nayu minasina si tokolu odabala makwaina, baisa goli idokaisi Yaubada la takaikaia baisa ovalu watanawa (kugisi Sam 18.10)","reference":{"chapter":61,"verse":4}}]},"thisChapterLink":"/api/kij_png/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}