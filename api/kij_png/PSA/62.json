{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":62,"content":[{"type":"heading","content":["Tadubumi Yaubada kada taboda"]},{"type":"verse","number":1,"content":[{"text":"Bavinagai paila Yaubada bikolaigu.","poem":1},{"text":"Yeigu akakana baisa wala matauna kalamwaleta.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kalamwaleta wala Yaubada itabodaigu e ikolaigu.","poem":1},{"text":"Matauna wala agu taboda,","poem":2},{"lineBreak":true},{"text":"deli gala avai tuta bamama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ki, ammakawala woloula komwaidomi bukuwawaigusi?","poem":1},{"text":"Paila yeigu ulo peula makawala kwaitala kali kwedadaimi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yokomi mesinaku wala kudokaisi mwada bukuvabwaigusi metoya ogu kwabosisu walakaiwa.","poem":1},{"text":"Yokomi kuyebwailisi wala sopa.","poem":2},{"text":"Yokomi kami udokaiwa wala kukwabwailigusi,","poem":1},{"text":"mitaga olumoulemi kubulotaigusi wala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yeigu akakana wala baisa Yaubada kalamwaleta,","poem":1},{"text":"e ulo pikwaku basaili baisa wala matauna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kalamwaleta wala Yaubada itabodaigu e ikolaigu.","poem":1},{"text":"Matauna wala agu taboda,","poem":2},{"lineBreak":true},{"text":"deli gala avai tuta bamama.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Agu kwatumova deli agu taimamila metitoya baisa Yaubada.","poem":1},{"text":"Matauna agu tokwala topeula.","poem":2},{"lineBreak":true},{"text":"Matauna ulo kabokwala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yokomi ulo tomota,","poem":1},{"noteId":133},{"text":"kudubumaisi Yaubada tuta komwaidona.","poem":1},{"text":"Kukwamitulaisi komwaidona kami mwau baisa matauna,","poem":2},{"lineBreak":true},{"text":"paila matauna da kabokwalasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tomota komwaidona makawala tiliawai wala.","poem":1},{"text":"Gweguya deli tokai makawala wala gala isim dimlesi.","poem":2},{"text":"Kusaili matausina odabala kaivisaikola e gala wala mokaisi.","poem":1},{"text":"Yagisa goli isim mokaila, mitaga matausina gala wala mokaisi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Taga bukudubumaisi mi gasisi,","poem":1},{"text":"e taga bukunakusisi mwada bukubanaisi avaka metoya olubulebu.","poem":2},{"text":"Kaina goli mi guguwa bukukwatumkulovi,","poem":1},{"text":"mitaga gala bukudubumi vavagi makwaisina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mimilisi tuta lalilagi Yaubada eilivala","poem":1},{"text":"kidamwa peula baisa matauna la vavagi,","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"deli kidamwa la yebwaili gala isim kala kalitutila.","poem":2},{"text":"Mwa Guyau! Yoku wala titoulem kumapu tomota taitala taitala","poem":1},{"text":"makawala avaka bibudoki la wotetila.","poem":2}]}],"footnotes":[{"noteId":133,"caller":"f","text":"Matauna guyau Debida ililivala baisa la tomota mina Isireli.","reference":{"chapter":62,"verse":8}}]},"thisChapterLink":"/api/kij_png/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}