{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":63,"content":[{"type":"heading","content":["Avinagai paila Yaubada"]},{"type":"verse","number":1,"content":[{"text":"Mwa Yaubada! Yoku ulo Yaubada.","poem":1},{"text":"Yeigu avinagai paila yoku,","poem":2},{"lineBreak":true},{"text":"e tomwaidogu goli magigu yoku.","poem":2},{"text":"Yeigu makawala viloupakala valu vilouwokuva wala,","poem":1},{"text":"e makawala valu magila sopi, yeigu magigu yoku.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bukutagwala bagisaim om Bwala Kwebumaboma,","poem":1},{"text":"e mwada bagisaim yoku Topeuligaga e Toguyugwayu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"M mitakwai ikalisuwoli momova kala bwaina,","poem":1},{"text":"e mauula bayakawolaim.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ogu tuta momova komwaidona, banokagutoki baisa yoku,","poem":1},{"text":"e bayosali yamagu banigada baisa yoku.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bilomagu bikam e bikomata,","poem":1},{"text":"e deli ulo mwasawa bawosi kam yakaula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wa bogi akanukwenu e aluluwaim.","poem":1},{"text":"Wa bogi kwemwaidona aninamsaim.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Paila yoku tuta tuta lokupilasaigu.","poem":2},{"text":"Okaikonigulela pinupanem","poem":1},{"noteId":134},{"text":"ausiwosi deli ulo mwasawa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yeigu akaipapaim,","poem":1},{"text":"e yamam ikolaigu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Matausina availa availa mwada bikatumataigusi","poem":1},{"text":"bibusisi wala bilosi mapilana Tuma.","poem":2},{"noteId":135}]},{"type":"verse","number":10,"content":[{"text":"Bikaligasi wala okabilia,","poem":1},{"text":"e ugiwagi nagigasisi bikomasi uwosi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yaubada bivigaki guyau bitomgwaga,","poem":1},{"text":"e mapaila guyau matauna bimwasawa!","poem":2},{"text":"Availa availa ikatotilasi omatala Yaubada, matausina goli biyakawolaisi matauna.","poem":1},{"text":"Mitaga Yaubada bikatupatu udosi toubuwabu.","poem":2}]}],"footnotes":[{"noteId":134,"caller":"g","text":"Kugisi Sam 17.8.","reference":{"chapter":63,"verse":7}},{"noteId":135,"caller":"h","text":"Baisa si valu tomata.","reference":{"chapter":63,"verse":9}}]},"thisChapterLink":"/api/kij_png/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}