{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":67,"content":[{"type":"heading","content":["Wosila nokagutoki"]},{"type":"verse","number":1,"content":[{"text":"Mwa Yaubada! Bukunokapisaimasi e bukumitukwaiyaimasi.","poem":1},{"text":"Metoya om ninabwaila bukupilasaimasi,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kidamwa valu watanawa komwaidona binikolaisi nanom,","poem":1},{"text":"e komwaidona boda ituwoli ituwoli bilumkolaisi m kwatumova.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mwa Yaubada! Ibodi tomota biyakawolaimsi.","poem":1},{"text":"Ibodi tomota komwaidosi biyakawolaimsi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ibodi boda ituwoli ituwoli ninasi bimwamwasila, e deli si mwasawa biusiwosisi goli.","poem":1},{"text":"Paila yoku lokuyakali mina watanawa metoya om kwaraiwaga duwosisia,","poem":2},{"lineBreak":true},{"text":"e yoku wala kasi tovakeda boda kwaitala kwaitala ovalu watanawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mwa Yaubada! Ibodi tomota biyakawolaimsi.","poem":1},{"text":"Ibodi tomota komwaidosi biyakawolaimsi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Da pwaipwaiasi bogwa ivigaki taluvabwailasi.","poem":1},{"text":"E Yaubada, matauna da Yaubadasi goli, bogwa eimitukwaiyaidasi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ka, Yaubada bogwa eimitukwaiyaidasi.","poem":1},{"text":"Ibodi komwaidosi mina watanawa ambaisa ambaisa bitemmalaisi matauna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kij_png/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}