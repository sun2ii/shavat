{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":70,"content":[{"type":"heading","content":["Nigada paila pilasi"]},{"type":"verse","number":1,"content":[{"text":"Mwa Yaubada! Kukwatumovaigu.","poem":1},{"text":"E Guyau, tuta baisa wala bukupilasaigu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ibodi matausina availa availa mwada bikatumataigusi","poem":1},{"text":"bimamasi deli bitakainowasi.","poem":2},{"text":"Ibodi matausina availa availa imwasawasi paila uula yeigu aboda mwau","poem":1},{"text":"bitovilasi bikaimilavausi deli kasi mmosila.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ibodi matausina availa availa iyosokanaigusi","poem":1},{"text":"biyowa luposi sainela paila leimamasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ibodi komwaidosi availa availa imakaiamsi","poem":1},{"text":"bimwasawasi deli ninasi kala mwamwasila.","poem":2},{"text":"Ibodi komwaidosi availa availa ilivalasi biga nokagutoki paila m kwatumova","poem":1},{"text":"tuta tuta bililivalasi kawasi, “Mwa Yaubada! Saina Tovakaigaga yoku.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"E Yaubada, yeigu tomama e togumalawa goli yeigu.","poem":1},{"text":"Kunanakwa bukumakaiagu.","poem":2},{"text":"E Guyau, yoku agu tokwatumova.","poem":1},{"text":"Mwa! Nani bukuma kupilasaigu!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kij_png/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}