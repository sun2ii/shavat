{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":75,"content":[{"type":"heading","content":["Yaubada Toyakala"]},{"type":"verse","number":1,"content":[{"text":"Kanokagutokisi baisa yoku ma Yaubadasi,","poem":1},{"text":"kanokagutokisi baisa yoku!","poem":2},{"lineBreak":true},{"text":"Kakamitulaimsi yoku saina Tovakaigaga,","poem":2},{"lineBreak":true},{"text":"deli kalivalaisi vavagi makwaisina kabokatubau avaka avaka bogwa lokuvagi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yaubada eikaibiga, kawala, “Yeigu bogwa laluvituti yamla yakala,","poem":1},{"text":"deli bayakala duwosisia wala.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kaina goli bubuli nammomova natana natana bitatuvasi,","poem":1},{"text":"deli valu watanawa titoulela bimotatina,","poem":2},{"lineBreak":true},{"text":"yeigu goli bakikuloti tumilela","poem":2},{"noteId":157},{"text":"bipeula.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Aluki tomitugaga gala bikaiveka ninasi,","poem":1}]},{"type":"verse","number":5,"content":[{"text":"e akatuloki matausina bisaimwaisi si kamnomwana.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yakala gala bima metoya opilibomatu kaina metoya opilikwaibwaga,","poem":1},{"text":"kaina metoya opiliyavata kainaga metoya opilibolimila.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yaubada goli matauna toyakala,","poem":1},{"text":"e mimilisi bikamogi mimilisiga bikabwaili.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Guyau iyosi kwelatala viga","poem":1},{"noteId":158},{"text":"oyamala,","poem":1},{"text":"ikasewa deli waini kaipeula, baisa la gibuluwa.","poem":2},{"text":"Matauna iligabu, e komwaidona tomitugaga imomsi,","poem":1},{"text":"e imomwaisi matausina ikatukopwaisi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mitaga yeigu gala avai tuta basim livalela Yekobe la Yaubada,","poem":1},{"text":"kainaga basim usiwosi paila kala yakaula.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Matauna bikatudidaimi si peula tomitugaga,","poem":1},{"text":"mitaga si peula tomitukwaibwaila bikatumkulovi goli.","poem":2}]}],"footnotes":[{"noteId":157,"caller":"d","text":"Kugisi Sam 18.15 kala katumiki.","reference":{"chapter":75,"verse":3}},{"noteId":158,"caller":"e","text":"Baisa ikibuboti Yaubada la mipuki; kugisi tuvaila Sam 60.3.","reference":{"chapter":75,"verse":8}}]},"thisChapterLink":"/api/kij_png/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}