{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":80,"content":[{"type":"heading","content":["Nigada paila mina Isireli bikaimilavausi"]},{"type":"verse","number":1,"content":[{"text":"Mwa! Yoku kasi Toyamata mina Isireli, kulagaimasi.","poem":1},{"text":"M yawa kala tokugwa yoku, kulagi ma bigasi.","poem":2},{"text":"Yoku kusili om takaikaia odubasi minasina bubuli isim pinupanesi.","poem":1},{"noteId":171}]},{"type":"verse","number":2,"content":[{"text":"Kuyomitalaim baisa madilasina dalesi Epereim, Beniamina deli Manasa.","poem":2},{"noteId":172},{"text":"Kuvitulokaimasi m peula,","poem":1},{"text":"e kuma bukukwatumovaimasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mwa Yaubada! Kukwaimilivauwaimasi.","poem":1},{"text":"Kunokapisaimasi, e bakabanaisi kama katumovasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mwa! Guyau Yaubada Topeuligaga,","poem":1},{"text":"ammakawala kala woloula bukugibuluwi","poem":2},{"noteId":173},{"text":"ma nigadasi yakamaisi m tomota?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yoku lokusakaimasi ninamwau okuvigaki kamasi bakakamsi,","poem":1},{"text":"e kwelaveka bolula mitalogi okuvigaki kama sopisi bakamomsi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lokutugwali mabudosina boda ituwoli ituwoli otalila bikabiliasi mwada biyoulisi ma valusi,","poem":1},{"text":"e kama tilaulasi ibigigagaimasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mwa! Yaubada Topeuligaga, kukwaimilivauwaimasi.","poem":1},{"text":"Kunokapisaimasi, e bakabanaisi kama katumovasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lokukwalitati tamtala waini","poem":1},{"noteId":174},{"text":"metoya mapilana Itipita,","poem":1},{"text":"e kubokavili boda ituwoli ituwoli, e lokuvali matamna osi valu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"E kutamigileu matamna,","poem":1},{"text":"e kaiviliwalila eisonusi sainela e tammla itetila wala ikaligiaki valu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kuyowala ikuboli koya komwaidona,","poem":1},{"text":"e sisila goli ikalisuwolaisi kweisila kaivakaveka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sisila matamna ilovasi ilosi opilikwaibwaga, mapilana Bolita Kwaiveka,","poem":1},{"text":"e opilibomatu maduyona Waya Yupereiti.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Avaka uula lokukwatudidaimi kalila matamna?","poem":1},{"text":"Ka, availa ililoula opapala gagabila bikoumakavi kaiuwala.","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Bolodila","poem":2},{"noteId":175},{"text":"ivapupoiyaisi,","poem":2},{"lineBreak":true},{"text":"e avai mauna avai mauna isusuvisi ikamkomasi kaiuwala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mwa! Yaubada Topeuligaga, kutovilakaimasi!","poem":1},{"text":"Kukululukwaimasi metoya wa labuma.","poem":2},{"lineBreak":true},{"text":"E kuma kukolaimasi yakamaisi m tomota.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kuma bukukoli matamna lokuvali,","poem":1},{"text":"matamna goli lokuvigaki bitamveka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kama tilaulasi ikapitunaisi matamna e igabwaisi.","poem":1},{"text":"Kukululuki deli m ninamwau, e kumtuli matausina.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bukukolaimasi deli bukutabodaimasi yakamaisi lokunagaimasi mwada m tomota,","poem":1},{"text":"paila omitibogwa kukwatupewolaimasi sainela.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Gala tuvaila bakatotubulokaimsi.","poem":1},{"text":"Kuyomovaimasi, e bakayakawolaimsi goli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Mwa! Guyau Yaubada Topeuligaga, kukwaimilivauwaimasi.","poem":1},{"text":"Kunokapisaimasi, e bakabanaisi kama katumovasi.","poem":2}]}],"footnotes":[{"noteId":171,"caller":"r","text":"Kugisi Sam 18.10.","reference":{"chapter":80,"verse":1}},{"noteId":172,"caller":"s","text":"Epereim deli Manasa madilasina dilivakaveka oluwalaisi madilasina mina Isireli, e sivabidubadu bikalaumgulisi madilana Beniamina deli madilasina.","reference":{"chapter":80,"verse":2}},{"noteId":173,"caller":"t","text":"Kugisi Sam 79.5.","reference":{"chapter":80,"verse":4}},{"noteId":174,"caller":"u","text":"Baisa kabutuvitusila mina Isireli.","reference":{"chapter":80,"verse":8}},{"noteId":175,"caller":"v","text":"Baisa kabutuvitusila kasi tilaula mina Isireli.","reference":{"chapter":80,"verse":13}}]},"thisChapterLink":"/api/kij_png/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}