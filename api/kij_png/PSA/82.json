{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":82,"content":[{"type":"heading","content":["Yaubada matauna Giyoumatala"]},{"type":"verse","number":1,"content":[{"text":"Yaubada matauna kasi tokugwa mina labuma osi sigugula.","poem":1},{"noteId":178},{"text":"Osi sigugula yaubada bidubadu, Yaubada ilivala avaka la karaiwaga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kawala, “Yokomi gala tuvaila bukuyakalasi doudoga.","poem":1},{"text":"Yokomi gala tuvaila bukutakilaisi tomitugaga!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bukupilasaisi matausina tonamakava deli weilova,","poem":1},{"text":"kidamwa bibanaisi avaka bibodi si kaisisu.","poem":2},{"lineBreak":true},{"text":"Bukukibobutasi bwaina paila matausina gumalawa deli tomamama.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kukoli matausina metoya osi peula tomitugaga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Ina tobubeikam yokomi! Ina toninagowa goli!","poem":1},{"text":"Yokomi gagawokuva wala,","poem":2},{"lineBreak":true},{"text":"deli karaiwaga duwosisia bogwa wala eitamwau metoya ovalu watanawa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"E yeigu laluki matausina, kawagu, ‘Komwaidomi wala yaubada.","poem":1},{"text":"Yokomi komwaidomi wala litula","poem":2},{"noteId":179},{"text":"matauna Towalakaiwa Sainela.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mitaga yokomi igau bukukwaligasi makawala tomota,","poem":1},{"text":"e mi momova igau biwokuva makawala goli avai guyau.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mwa Guyau! Kuma e kukwaraiwogi valu watanawa.","poem":1},{"text":"Komwaidona boda ituwoli ituwoli baisa m vavagi goli.","poem":2}]}],"footnotes":[{"noteId":178,"caller":"y","text":"Kugisi Sam 89.5-7; Yob 1.6, 2.1.","reference":{"chapter":82,"verse":1}},{"noteId":179,"caller":"z","text":"Baisa Yaubada ililivala; iluluki matausina osi sigugula; ibodi bibubunasi makawala litula, mitaga kidamwa bimitugagasi, bogwa wala bikaligasi makawala mina watanawa.","reference":{"chapter":82,"verse":6}}]},"thisChapterLink":"/api/kij_png/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}