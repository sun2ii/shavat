{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":87,"content":[{"type":"heading","content":["Kala kavisi Yerusalem"]},{"type":"verse","number":1,"content":[{"text":"Guyau eikaliai mapilana la valu ola koya kwebumaboma.","poem":1},{"noteId":185}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"E la yebwaili paila Yerusalem","poem":1},{"text":"ikalisau la yebwaili paila avai valu avai valu mapilana Isireli.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"E yoku Yaubada la valu,","poem":1},{"text":"bukulagi vavagi makwaisina saina kabokatubau avaka Yaubada eililivala paila yoku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kawala, “Avai tuta bakalawa mabudosina boda availa availa ikabikuwolaigusi,","poem":1},{"text":"e bogwa bakalaumguliki mapilasina Itipita deli Babiloni.","poem":2},{"text":"E avai tuta bakalawa Yerusalem kala tosisu,","poem":1},{"text":"e bogwa bakalaumguliki mina Pilisitia, mina Taia e mina Sudani.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mina watanawa bilivalasi paila mapilana Saiyoni.","poem":1},{"text":"Bikaibigasi kidamwa ibodi wala komwaidona boda ituwoli ituwoli bisisuaisi baisa,","poem":2},{"lineBreak":true},{"text":"deli kidamwa matauna Topeuligaga bikatupewoli mapilana valu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Guyau bigini yagasi komwaidosi mina watanawa,","poem":1},{"text":"e bikalaumguliki deli tosisula Yerusalem.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ikikaiwosisi e iusiwosisi kawasi,","poem":1},{"text":"“Uulela kada mitakwaisi komwaidona metitoya mapilana Saiyoni.”","poem":2}]}],"footnotes":[{"noteId":185,"caller":"f","text":"Kugisi Sam 2.6.","reference":{"chapter":87,"verse":1}}]},"thisChapterLink":"/api/kij_png/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}