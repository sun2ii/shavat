{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":91,"content":[{"type":"heading","content":["Yaubada kada Tokwalasi"]},{"type":"verse","number":1,"content":[{"text":"Availa bilokaia Guyau paila bikwala,","poem":1},{"text":"e availa Yaubada Topeuligaga bikoli,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"matauna gagabila biluki matauna, kawala,","poem":1},{"text":"“Yoku agu taboda e agu tokwala.","poem":2},{"lineBreak":true},{"text":"Yoku ulo Yaubada, e yoku goli adubumaim.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Matauna biyamataim metoya avai kabosilagi kwekatupwana,","poem":1},{"text":"e metoya avai lelia saina mwaugaga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Matauna bivakanunuvaim opinupanela,","poem":1},{"noteId":201},{"text":"biyamataim e yoku bukusibwabwaila.","poem":2},{"lineBreak":true},{"text":"Matauna Tokimadagi bikolaim e bitabodaim.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gala ibodi bukukukoli avai silagi wa bogi,","poem":1},{"text":"kaina availa biwaim wa yam,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"kaina avai lelia biyogagaim odudubila,","poem":1},{"text":"kainaga avai vavagi mwau bikatumataim lalavi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kaina lakatuluwotala bikaligasi otalim,","poem":1},{"text":"kainaga lakatuluwovila bibodasi kaliga om kwakata,","poem":2},{"lineBreak":true},{"text":"mitaga yoku gala avaka biyogagaim.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bukumitakavati e bukugisi","poem":1},{"text":"ammakawala tomitugaga bibodaisi kasi mipuki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Paila Guyau lokuvigaki m vayoula,","poem":1},{"text":"e Yaubada Towalakaiwa","poem":2},{"noteId":202},{"text":"kam tokwala.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gala avai kabosilagi biyogagaim.","poem":1},{"text":"e gala avai togigasisi bivakatitaikina om valu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yaubada bisaiki la anelosi kasi pakula","poem":1},{"noteId":203},{"text":"biyamataimsi","poem":1},{"text":"e bikolaimsi ambaisa ambaisa bukula.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Oyumasi bikauwaimsi,","poem":1},{"text":"taga biwaiya kaikem dakuna.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bukuvapupoi laiyoni deli keiyuna,","poem":1},{"noteId":204},{"text":"laiyoni nagigasisi deli keiyuna naiyayana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Yaubada kawala, “Availa availa iyebwailigusi bakatumovi,","poem":1},{"text":"e bakoli availa availa idokaigusi Guyau.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Avai tuta bidouwaigusi, yeigu bamapu matausina.","poem":1},{"text":"Avai tuta bibodasi mwau, yeigu basikaili matausina.","poem":2},{"lineBreak":true},{"text":"Bogwa bakoli e balupi okabasi walakaiwa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yeigu basaiki kasi mapu si momova bakatududuli","poem":1},{"text":"e yeigu bakoli matausina.”","poem":2}]}],"footnotes":[{"noteId":201,"caller":"v","text":"Kugisi Sam 17.8.","reference":{"chapter":91,"verse":4}},{"noteId":202,"caller":"w","text":"Kugisi Sam 7.17.","reference":{"chapter":91,"verse":9}},{"noteId":203,"caller":"x","text":"Baisa makawala anelosi biwotitalaisi Yaubada deli la tomota; kugisi kala katumiki 34.7.","reference":{"chapter":91,"verse":11}},{"noteId":204,"caller":"y","text":"Minasina ikibubotaisi kasi tilaula mina Isireli deli tuvaila kabosilagi.","reference":{"chapter":91,"verse":13}}]},"thisChapterLink":"/api/kij_png/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}