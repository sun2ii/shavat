{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":93,"content":[{"type":"heading","content":["Yaubada matauna Guyau"]},{"type":"verse","number":1,"content":[{"text":"Guyau matauna ulo Guyau.","poem":1},{"text":"Eisikam kala kalugologusa deli peuligaga.","poem":2},{"text":"Eisaili valu watanawa okabala,","poem":1},{"text":"e gala availa gagabila biyagi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mwa Guyau! Yoku m takaikaia eitokikita metoya okala vitouula.","poem":1},{"text":"E igau gala isim valu gala isim tuta, yoku goli lokusibogwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"E Guyau, bolita otulubwabwau","poem":1},{"noteId":206},{"text":"ikawota bilivala,","poem":1},{"text":"e tilibwabwau kaigaveka ipaisaga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Guyau matauna Giyoumatala iguguyoi wa labuma.","poem":1},{"text":"Ikalisau bolita kala paisaga sainela,","poem":2},{"lineBreak":true},{"text":"ipeuluvagasi odabala kaisai saina kaitabubogwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"E Guyau, makwaisina m kwaraiwaga gala biwokuva, bikanuvagasi,","poem":1},{"text":"e mokwita goli m Bwala Kwebumaboma saina kwebumaboma sainela,","poem":2},{"lineBreak":true},{"text":"bikanigaga goli, gala biwokuva, gala biwokuva.","poem":2}]}],"footnotes":[{"noteId":206,"caller":"a","text":"Igau gala ibubuli valu watanawa, gala avaka isisu mesinaku wala bolitawokuva wala ambaisa ambaisa; e avai tuta Yaubada ibubuli valu, matauna ikalisuwoli bolita e isaili okabala. Kugisi Sam 33.7; 74.13-17; 89.9-10.","reference":{"chapter":93,"verse":3}}]},"thisChapterLink":"/api/kij_png/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}