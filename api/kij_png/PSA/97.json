{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"PSA","translationId":"kij_png","name":"SAM","commonName":"SAM","title":"BUKILA SAM","order":19,"numberOfChapters":150,"sha256":"3134dd9f16a6eff9eea6ed9152f3cf58b7d883b7c881a748798ccf61d92f9ad7","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kij_png/PSA/150.json","totalNumberOfVerses":2447},"chapter":{"number":97,"content":[{"type":"heading","content":["Yaubada matauna Giyoumatala"]},{"type":"verse","number":1,"content":[{"text":"Guyau matauna da Guyausi!","poem":1},{"noteId":207},{"text":"Yoku valu watanawa kumwasawa!","poem":1},{"text":"Kumwasawasi, yokomi simla obolita!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lowalowa deli dudubila itavinaisi itapataisi matauna.","poem":1},{"text":"Matauna iguyau metoya ola giyoubwaila e deli karaiwaga duwosisia.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kova ikukugwa omatala matauna,","poem":1},{"text":"e igibuwoli kala tilaula eitavinaisi eitapataisi matauna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Matauna la kavikavila ititapi ovalu watanawa.","poem":1},{"text":"e valu watanawa igigisi makwaina iigayega.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Koya ikaligeyaisi omatala Guyau,","poem":1},{"text":"e omatala matauna Guyoula valu watanawa komwaidona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mina labuma ikamitulaisi matauna tomitukwaibwaila,","poem":1},{"text":"deli komwaidona boda ituwoli ituwoli igisaisi kala katububula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Matausina availa availa itapwarorusi baisa tokolu ivigaki kasi mmosila.","poem":1},{"text":"Komwaidona minasina yaubada tokolu ikavaginasi omatala Guyau.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mwa Guyau! Mina Saiyoni","poem":1},{"noteId":208},{"text":"imwamwasila ninasi,","poem":1},{"text":"e mapilasina Yuda imwasawasi,","poem":2},{"lineBreak":true},{"text":"paila m kwaraiwaga makwaisina.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Guyau Topeuligaga, yoku goli kala tokwaraiwaga valu watanawa komwaidona.","poem":1},{"text":"Yoku saina tovakaigaga metoya komwaidona minasina yaubada.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Guyau iyebwaili matausina kwekukolosi mitugaga.","poem":1},{"text":"Matauna ikoli si momova la tomota,","poem":2},{"lineBreak":true},{"text":"e ikoli matausina metoya oyumasi tomitugaga.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Lumalama","poem":1},{"noteId":209},{"text":"ivisigili matausina tomitukwaibwaila,","poem":1},{"text":"e mwasawa baisa matausina bubunesi bwaina.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Komwaidomi yokomi tomitukwaibwaila ibodi bukumwasawasi","poem":1},{"text":"paila avaka Guyau bogwa leivagi!","poem":2},{"text":"Kululuwaisi avaka Guyau Tobumaboma bogwa leivagi,","poem":1},{"text":"e kunokagutokisi baisa matauna.","poem":2}]}],"footnotes":[{"noteId":207,"caller":"b","text":"Kugisi Sam 8.1.","reference":{"chapter":97,"verse":1}},{"noteId":208,"caller":"c","text":"Matausina tolesi Yerusalem.","reference":{"chapter":97,"verse":8}},{"noteId":209,"caller":"d","text":"Lumalama ikibuboti momova deli peulela.","reference":{"chapter":97,"verse":11}}]},"thisChapterLink":"/api/kij_png/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}