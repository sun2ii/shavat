{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"SNG","translationId":"kij_png","name":"SOLOMONI KALA WOSI","commonName":"SOLOMONI KALA WOSI","title":"SOLOMONI KALA WOSI","order":22,"numberOfChapters":8,"sha256":"fa4a98a2947e7353931cd920aa8561aa5dceddbf8a3b4858e5b5894c92f25a25","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/kij_png/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Mapilasina Solomoni la butubutu e saina pilaminabwaita."]},{"type":"heading","content":["Wosi Pilimatala"]},{"type":"verse","number":2,"content":[{"text":"M vayaula namwaidogu wala iiyosigu;","poem":1},{"text":"e m yebwaili kala bwaina ikalisau waini.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yoku saina simasimina wowom,","poem":1},{"text":"e yagam kibila udomaisi vivila.","poem":2},{"text":"Mapaila vivila komwaidosi tombwailisi wala yoku.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mwa, kuma kuvakouligu, e kusakawolaigu,","poem":1},{"text":"kulauwaigu om bwala, e bavigakaim ulo guyau.","poem":2},{"text":"E kadataiyu wala bitamwasawa,","poem":1},{"text":"bitamommata, deli bituliki taigila yobobu.","poem":2},{"text":"Woo! Ina kwaita sopa, isiaga vivila komwaidosi tombwailisi yoku!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yokomi vilemi Yerusalem, yeigu mokwitala nabwabwau,","poem":1},{"text":"mitaga agu migibwabwau,","poem":2},{"text":"wowogu kala bwabwau makawala buliyoyova","poem":1},{"text":"makwaisina oviloupakala mapilana Kedara,","poem":2},{"text":"mitaga agu naminabwaita makawala miyasina taboda","poem":1},{"text":"Solomoni okabala saina yamminibwaita.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Segwaia, taga kukwagibwaigusi paila agu gigisa,","poem":1},{"text":"paila kalasia eikalaigu e wowogu eibwabwau.","poem":2},{"text":"Luguta igibuluwaigusi e ikopitukwaigusi wala paisewa obuyagu.","poem":1},{"text":"E gala wala sitana ulo tuta paila bawaisomi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mwa, lubaigu, kuma kulukwaigu,","poem":1},{"text":"Ambaisa bukulau m yawa ikabubunasi ke?","poem":2},{"text":"Ambaisa bukulau isipepunisi avai tuta kalasia bitokitoki?","poem":1},{"lineBreak":true},{"text":"Mwa, avaka uula leikaiki wowogu baninevaim","poem":1},{"text":"oluwalaisi si yawa ituwoli toyamata sipi?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yoku vivila saina namatabwaila,","poem":1},{"lineBreak":true},{"text":"Ki, gala kunikoli ambaisa kabosikaiwa?","poem":1},{"lineBreak":true},{"text":"Ka, kula kubokuli mayuwona yawa","poem":1},{"text":"e bukubani mnumonu bwaina paila bikamsi m gota,","poem":2},{"lineBreak":true},{"text":"otalisi si buliyoyova toyamata sipi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ve, lubaigu, yoku wala kaiyoulalela mitasi tauwau,","poem":1},{"text":"makawala natana navivila wosa biuvamwali wowola","poem":2},{"lineBreak":true},{"text":"namwala wosa minasina bibibiusi la waga Pero.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ka, kulum saina yamminabwaita leima iwawai okimwam","poem":1},{"text":"deli eikapusi wala leila okaiyom makawala soulava.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mitaga igau bitasui katupotala kam kuwekuwa goulawokuva wala,","poem":1},{"text":"e butobotala silibawokuva wala.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ka, ulo guyau eikanukwenu okabala,","poem":1},{"text":"e ulo bulami simanela ipuyumi bwala.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ka, avai tuta lubaigu bikenu ovitakogu,","poem":1},{"text":"matauna makawala mro kala simasimina.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Lubaigu makawala lala kebubolodila,","poem":1},{"text":"makaisina eilalalasi obuyagu mapilana Enigedi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ve, lubaigu, saina namatabwaila yoku,","poem":1},{"text":"e saina migimbwailigu yoku!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mwa, lubaigu, saina tomatabwaila yoku","poem":1},{"text":"deli saina tombwailigu yoku!","poem":2},{"text":"Mnumonu semitamata bitavigaki kabada.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kweisila bitavigaki da bwala youdulela,","poem":1},{"text":"e reiyava bitavigaki tabodala yuviyavi.","poem":2},{"noteId":0}]}],"footnotes":[{"noteId":0,"caller":"a","text":"Baisa talivalasi paila mabigana ceiling.","reference":{"chapter":1,"verse":17}}]},"thisChapterLink":"/api/kij_png/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}