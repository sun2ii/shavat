{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"SNG","translationId":"kij_png","name":"SOLOMONI KALA WOSI","commonName":"SOLOMONI KALA WOSI","title":"SOLOMONI KALA WOSI","order":22,"numberOfChapters":8,"sha256":"fa4a98a2947e7353931cd920aa8561aa5dceddbf8a3b4858e5b5894c92f25a25","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/kij_png/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Yeigu makawala lalela Saroni kebolodila,","poem":1},{"text":"makawala bwaimwara eitotusi oitayatila.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Makawala kaitala bwaimwara eitowalai kaigunigwaini","poem":1},{"text":"e makawala goli minawena lubaigu oluwalaisi vivila komwaidona.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Makawala kaitala mokolu eitowalai kai komwaidona,","poem":1},{"text":"e makawala goli matauna lubaigu oluwalaisi tauwau komwaidona.","poem":2},{"text":"Saina ayebwaili basisu okaikonigulela,","poem":1},{"text":"e uwala la kamkoni saina simokainigaga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ilauwaigu obolela la kabokamkwam","poem":1},{"text":"e matauna iyomitali agu yebwaili.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ka, bukukwatupewolaigu metoya kaiuwala waini,","poem":1},{"text":"kuyomosalaisu metoya mokolu!","poem":2},{"text":"Mapaila namwaidogu wala nakaliga baisa matauna.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yamala kikiwama avigaki agu kwabaikunu","poem":1},{"text":"e yamala kakata iyobobwaigu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yokomi vilemi Yerusalem, ibodaimi bukukwatotilasi mwau,","poem":1},{"text":"mwada gala bukuyobosaimasi sogu lubaigu.","poem":2}]},{"type":"heading","content":["Wosi Piliyuwela"]},{"type":"verse","number":8,"content":[{"text":"Aligitoi kaigala lubaigu.","poem":1},{"lineBreak":true},{"text":"Odubiluwotala koya leisisakaula leima,","poem":1},{"text":"leiluvapela odubadabila leimmakaiagu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Lubaigu makawala natana dia,","poem":1},{"text":"makawala natana namwala dia natubovau.","poem":2},{"text":"Matauna itotu opapala taboda.","poem":1},{"lineBreak":true},{"text":"E ititadoyai oponana","poem":1},{"text":"e immitikipwana wa ninuva.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lubaigu ilukwaigu kawala.","poem":1},"Tau",{"text":"Ve, lubaigu, kumakaiagu,","poem":1},{"text":"nambwailigu, kuma bitam.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ka, tula kweluvala bogwa leiwokuva","poem":1},{"text":"e kuna bogwa leidoudewa;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"valu viloutuboulola, lala bogwa leikatuyawaisi.","poem":1},{"lineBreak":true},{"text":"E baisa tuta la tuta wosi wala;","poem":1},{"text":"ka, kulegʹe bubuna leikukumdusi osaivau.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Seuseu bogwa leimwenakavalasi;","poem":1},{"text":"e matamsina waini lalela eipuyumi valu.","poem":2},{"text":"Ve, lubaigu, kumakaiagu,","poem":1},{"text":"nambwailigu, kuma bitam.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yoku makawala natana bubuna","poem":1},{"text":"minana eikanupepuni okatakila dakuna.","poem":2},{"text":"Ve, kusunapula bagisi migim bwaikwanela,","poem":1},{"text":"e sitana balagi kaigam, biluba lopogu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kuyosisi minasina ugiwagi, minasina nakikekita,","poem":1},{"text":"taga bivagudaisi da sobulasi matamsina da wainisi,","poem":2},{"lineBreak":true},{"text":"paila tuta baisa goli eilalalasi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yeigu lubaigu matauna, e matauna lubaila yeigu.","poem":1},{"text":"Iuvakam la yawa olukuvala bwaimwara","poem":2}]},{"type":"verse","number":17,"content":[{"text":"e biyayosa wala tatoula bulubuvisiga bimya kala suwonumla bima","poem":1},{"text":"e kawala yam biyumki.","poem":2},{"text":"Mwa, lubaigu, kukwaimilavau kuma, makawala natana dia,","poem":1},{"text":"kaina makawala natana nagwadi dia namwala","poem":2},{"lineBreak":true},{"text":"odubiluwotala koyala Beteri.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kij_png/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}