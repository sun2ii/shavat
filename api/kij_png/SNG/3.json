{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"SNG","translationId":"kij_png","name":"SOLOMONI KALA WOSI","commonName":"SOLOMONI KALA WOSI","title":"SOLOMONI KALA WOSI","order":22,"numberOfChapters":8,"sha256":"fa4a98a2947e7353931cd920aa8561aa5dceddbf8a3b4858e5b5894c92f25a25","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/kij_png/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Bogi kwaitala kwaitala, avai tuta lakenu okabagu","poem":1},{"text":"ammimi wala lubaigu matauna tombwailigu.","poem":2},{"text":"Tuta komwaidona anainevi matauna,","poem":1},{"text":"mitaga gala wala abani.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ala ovilouveka atitavina wala","poem":1},{"text":"okadumalaga deli goli olilagala valu.","poem":2},{"text":"Nevigu wala matauna tombwailigu.","poem":1},{"text":"Mitaga anainevi wala asomata, gala wala abani matauna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"E matausina toyausa eiyuuyausasi valu igisaigusi.","poem":1},{"text":"E akatupoi matausina kawagu,","poem":2},{"lineBreak":true},{"text":"“Ki, gala sitana kubodaisi lubaigu?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"E momwaila lavalai matausina,","poem":1},{"text":"avataina goli abani matauna.","poem":2},{"text":"E ayosa wala, e gala atagwala bakilova tatoula wala","poem":1},{"text":"lakatuvisuvi matauna ola bwala inagu.","poem":2},{"text":"E alau wala matabudona inagu leiunaigu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yokomi vilemi Yerusalem,","poem":1},{"text":"ibodaimi bukukwatotilasi mwau,","poem":2},{"lineBreak":true},{"text":"mwada gala bukuyobosaimasi sogu lubaigu.","poem":2}]},{"type":"heading","content":["Pilitolula Wosi"]},{"type":"verse","number":6,"content":[{"text":"Ka, avai vavagi baisa oviloupakala","poem":1},{"text":"makawala mseu leibulitoumoi leima?","poem":2},{"text":"Maiinela saina simasimina deli mro,","poem":1},{"text":"makaisina kaisimasimina togigimwala eigigimolaisi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ka, Solomoni leikatikeuwaisi ola takaikaia leimaiyaisi;","poem":1},{"text":"e kala tovakwabu leimaiyaisi kasi bawa tailuwolima tailuwotala tokabilia,","poem":2},{"lineBreak":true},{"text":"matausina wala dabala si wota mina Isireli.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"E komwaidosi wala matausina kasi tokwabi kema","poem":1},{"text":"e deli pwataboda.","poem":2},{"text":"E taitala taitala ikibubwasaisi si kema,","poem":1},{"text":"paila gala tanikoli kaina bivitoulai kabilia wa bogi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"E guyau Solomoni leikatikeuwaisi ola takaikaia","poem":1},{"text":"makwaina leiyoudulaisi metoya kai kaimoya.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"E kokolela makaisina ikubolaisi metoya silibawokuva wala;","poem":1},{"text":"e karekwala miyasina leibisikaisi goulawokuva wala.","poem":2},{"text":"E makwaisina kabala kwaimmanum karekwala kala vau dairarugu,","poem":1},{"text":"e saina yammanum miyasina vilesi Yerusalem leiyoudulaisi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Veve, yokomi vilemi Saiyoni, kumaisi kugisaisi guyau Solomoni.","poem":1},{"lineBreak":true},{"text":"Matauna leisisikoma kala kulupaipi makwaina","poem":1},{"text":"inala leivisikoma oyamla la veivai,","poem":2},{"lineBreak":true},{"text":"yam makwaina yamla nanola kala mwamwasila deli la kabomwasawa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kij_png/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}