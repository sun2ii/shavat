{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"SNG","translationId":"kij_png","name":"SOLOMONI KALA WOSI","commonName":"SOLOMONI KALA WOSI","title":"SOLOMONI KALA WOSI","order":22,"numberOfChapters":8,"sha256":"fa4a98a2947e7353931cd920aa8561aa5dceddbf8a3b4858e5b5894c92f25a25","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/kij_png/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Ve, lubaigu, yoku kagu vaigwadi","poem":1},{"text":"yeigu bogwa lala ogu bagula,","poem":2},{"lineBreak":true},{"text":"e akouguguli vana deli mro.","poem":2},{"text":"E lakamkwam agu kitorina deli kaboiyousala","poem":1},{"text":"e lamomom agu waini deli agu nunu.","poem":2},"Vivila komwaidosi",{"text":"Lubemaiasi kukwamsi deli kumomsi tatoula wala bibwaimi kabotutu som lubaim!","poem":1}]},{"type":"heading","content":["Pilivasila Wosi"]},{"type":"verse","number":2,"content":[{"text":"Avai tuta lammasisi, akupakopita wala,","poem":1},{"text":"e amimi mwada lubaigu leinopipisi wa lulu.","poem":2},"Tau",{"text":"Ve lubaigu, yoku nambwailigu deli ulo bubuna kutugwalaigu basuvi.","poem":1},{"lineBreak":true},{"text":"Paila sikukula bogwa leiyopututu dabagu","poem":1},{"text":"e numla bogwa leikatoguna okulugu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mwa, bogwa lakatulovi agu kwarekwa;","poem":1},{"text":"avaka dimlela basikamvau miyasina karekwa?","poem":2},{"text":"Bogwa lawini kaikegu;","poem":1},{"text":"avaka dimlela bayopigigatu tuvaila?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mapaila lubaigu ilitaki yoyu,","poem":1},{"text":"e iyowa lopogu adoki lubaigu bogwa leivakatitaikina.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"E asimalaula adoki baulaim yoyu paila matauna bisuvi.","poem":1},{"lineBreak":true},{"text":"E matutona lalitaki woyai paila baulaim yoyu,","poem":1},{"text":"yamagu bogwa wala lakeputumi mro,","poem":2},{"lineBreak":true},{"text":"e misikwaikwegu ivakasau bulamila mro.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"E aulaim yoyu paila lubaigu bisuvi,","poem":1},{"text":"mitaga lamokaia bogwa leila.","poem":2},{"text":"Saina magigu balagi sitana kaigala!","poem":1},{"text":"Mapaila anevi matauna, mitaga gala gagabila babani.","poem":2},{"text":"Adoukoli matauna, mitaga gala wala sitana anakaigali mapula.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"E matausina toyausa eiyuuyausasi valu igisaigusi,","poem":1},{"text":"e iwaigusi deli ikatubuyavaigusi.","poem":2},{"text":"E matausina eiyuuyausasi okalila valu,","poem":1},{"text":"ikisaisi miyana kagu seikeula.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Veve, yokomi vilemi Yerusalem,","poem":1},{"text":"kukwatotilasi baisa yeigu,","poem":2},{"text":"kidamwa bukugisaisi lubaigu,","poem":1},{"text":"bukulukwaisi matauna kawami,","poem":2},{"lineBreak":true},{"text":"“Lubaim namwaidona wala nakaliga baisa yoku.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ve, yoku saina wala kutubosaki,","poem":1},{"text":"vivila komwaidosi kasi kaimatala wala yoku.","poem":2},{"lineBreak":true},{"text":"Ki, avaka kala tuwoli metoya baisa lubaim deli tauwau komwaidosi ke?","poem":2},{"text":"Ki, kudoki wala itubosaki","poem":1},{"text":"e bukulukwaimasiga mwada bakakatotilasi baisa yoku.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lubaigu tomatabwaila deli topeula,","poem":1},{"lineBreak":true},{"text":"Matauna migila ikalisuwoli lakatuluwovila tauwau migisi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Migila kwedudubuna deli subusobu,","poem":1},{"text":"kulula yasisiai deli yabubwabwau","poem":2},{"lineBreak":true},{"text":"makawala digulesi bulibuli bwabwaula.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"E matala kwegigigia makawala bubuna mitasi minasina eitotusi opapala waya,","poem":1},{"text":"kala migileu tadoki wala tavakakai wa nunu,","poem":2},{"lineBreak":true},{"text":"deli itotusi opapala waya.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Matauna kimwala kala bwaina makawala kwaitala bagula,","poem":1},{"text":"ivakasau lokwai deli vana ituwoli ituwoli.","poem":2},{"text":"Bilubalola makawala bwaimwara,","poem":1},{"text":"giula makawala mro bulamila.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yamala saina kweyamanabwaita","poem":1},{"text":"e kala kakalougwa lesisikoma isim katububulela,","poem":2},{"lineBreak":true},{"text":"wowola kala dudubuna makawala doga dudubunela,","poem":2},{"lineBreak":true},{"text":"makaina ikatububulaisi deli dakuna yagala sapaya.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kwaipiapala kala gigisa makawala kokola leiyoudulaisi metoya dakuna alabasita,","poem":1},{"text":"makaisina si kabototu goula wala.","poem":2},{"text":"Matauna itubosaki, makawala Koyala Lebanoni","poem":1},{"text":"kaila makaisina kweisila itubosakisi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bitavayaula owodola saina sumokainia,","poem":1},{"text":"e kala kaibisibasi komwaidona ikikau wala nanogu.","poem":2},{"text":"Ka, yokomi vilemi Yerusalem,","poem":1},{"text":"baisa makawala lubaigu kala gigisa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kij_png/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}