{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"SNG","translationId":"kij_png","name":"SOLOMONI KALA WOSI","commonName":"SOLOMONI KALA WOSI","title":"SOLOMONI KALA WOSI","order":22,"numberOfChapters":8,"sha256":"fa4a98a2947e7353931cd920aa8561aa5dceddbf8a3b4858e5b5894c92f25a25","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/kij_png/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Ve, yoku saina wala kutubosaki,","poem":1},{"text":"vivila komwaidosi kasi kaimatala yoku,","poem":2},{"lineBreak":true},{"text":"lubaim ambaisa leila?","poem":2},{"text":"Kulukwaimasi lubaim ammakadana la keda leim,","poem":1},{"text":"e gagabila bakapilasaimsi bitanevaisi matauna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lubaigu bogwa leila ola bagula","poem":1},{"text":"makwaina bigulela paninita,","poem":2},{"lineBreak":true},{"text":"matauna eiuvakam la yawa obuyagu,","poem":2},{"lineBreak":true},{"text":"ikikipoi kala bwaimwara.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yeigu lubaigu matauna, e matauna lubaila yeigu,","poem":1},{"text":"eiuvakam la yawa olukuvasi bwaimwara.","poem":2}]},{"type":"heading","content":["Pililimela Wosi"]},{"type":"verse","number":4,"content":[{"text":"Lubaigu, yoku saina namatabwaila makawala valu Yerusalem saina viloumatabwaila,","poem":1},{"text":"kaina makawala valu Tesa saina viloumatabwaila.","poem":2},{"text":"Yoku kam gigisa itututu wala wowogu","poem":1},{"text":"makawala mavilousina valu vilouvakaveka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ve, kuligaiwa gisamapu,","poem":1},{"text":"paila saina iguguti wowogu.","poem":2},{"text":"Kulum leiuwaimimila makawala yuwotala gota","poem":1},{"text":"leidadailisi metoya wa koyala Giliadi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kudum pupwakaula makawala sipi minana makateki wala leivakakayaisi,","poem":1},{"text":"gala kaitala kudum isasa,","poem":2},{"lineBreak":true},{"text":"komwaidona wala saina kasakutukutu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"E bwaikwanelaga kimwam lokukwapoli.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ibodi guyau bivilayawa naluwolima naluwotala giyouvila,","poem":1},{"text":"e naluwolima naluwotolu la ula bivigaki makawala la kukova,","poem":2},{"lineBreak":true},{"text":"e tuvaila goli kapugopugula gala bitakalau!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mitaga yeigu ayebwaili natinidesi wala,","poem":1},{"text":"minana kala namanabwaita makawala natana bubuna.","poem":2},{"text":"Minana inala leiuni kalamwaleta wala vivila,","poem":1},{"text":"e inala saina iyebwaili minana,","poem":2},{"lineBreak":true},{"text":"e ivigaki minana latula nambwailila goli.","poem":2},{"text":"Komwaidosi vivila avai tuta bigisaisi minana saina ikavisaisi,","poem":1},{"text":"e giyouvila deli minasina ula eivigaki makawala la kukova iusiwosisi iyakawolaisi minana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Avaivila minana la mitakavati leiyuwoula makawala visiga?","poem":1},{"lineBreak":true},{"text":"Minana namanabwaita deli eilululu kanivala,","poem":1},{"text":"makawala kalasia kainaga tubukona visigala.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yeigu lama latotu ouula makaisina saida","poem":1},{"text":"mwada bavakawoli kai itumtamsi ogu bagula oitayatila,","poem":2},{"lineBreak":true},{"text":"e bagisi sobulesi ulo waini leiulisalalasi","poem":2},{"lineBreak":true},{"text":"deli goli bavakawoli lalela makaisina gigiku leisisisisi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ve, yeigu bogwa latatatuva, paila lokukwammalaigu bitasivaduli","poem":1},{"text":"makawala taitala kumatoula itulotula bibasi okawakali.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ve, yoku vilakapugula vilem Sulam,","poem":1},{"text":"kuma kukwaiwosi, e bakagigisaimsi.","poem":2},"Vivila",{"text":"Avaka uula magimi bukugigisaigusi","poem":1},{"text":"avai tuta akakaiwosi oluwalaisi togigisa, ke?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kij_png/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}