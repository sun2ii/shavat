{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"SNG","translationId":"kij_png","name":"SOLOMONI KALA WOSI","commonName":"SOLOMONI KALA WOSI","title":"SOLOMONI KALA WOSI","order":22,"numberOfChapters":8,"sha256":"fa4a98a2947e7353931cd920aa8561aa5dceddbf8a3b4858e5b5894c92f25a25","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/kij_png/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"Ve, saina namanabwaita yoku!","poem":1},{"lineBreak":true},{"text":"Bwaikwanelaga lokuvakouya kapolela kwaibakwaim.","poem":1},{"lineBreak":true},{"text":"Kwaipiapam dodogala","poem":1},{"text":"tadoki wala si katuduvidavi toyoudulesi tokolu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ka, kwelatala bolu mekikanaikila baisa,","poem":1},{"text":"e makwelana sopila gala avai tuta bimada.","poem":2},{"text":"Gulotala taitu makawala geu metitokila baisa,","poem":1},{"text":"e bwaimwara itavini itapatu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nunum nupiakwa, kala gigisa makawala nupoyu dia,","poem":1},{"text":"kaina makawala nayu nagugugwadi dia.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kaiyom kala gigisa saina bwaina","poem":1},{"text":"makawala kwaitala bolela vatoi leikatububulaisi metoya doga.","poem":2},{"lineBreak":true},{"text":"E matam kala gigisa makawala sopila vilouveka","poem":2},{"lineBreak":true},{"text":"Esiboni makwaisina opapala kalapisilela mavilouna vilouveka.","poem":2},{"text":"Kabulum saina keminabwaita,","poem":1},{"text":"tadoki wala mina Lebanoni si bwala vatoi makwaina leikounakaila valu Damasiko.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dabam leikuva makawala Koya Kamela.","poem":1},{"lineBreak":true},{"text":"E kulum lokuvili leivivivila makawala miyasina","poem":1},{"text":"karekwa yammanum deli yakavikavila,","poem":2},{"lineBreak":true},{"text":"e kala gigisa wala ibodi bikau nanola guyau.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ve, bwaikwanelaga kam gigisa, saina namatabwaila yoku,","poem":1},{"text":"m kwatugweimila ketigamla wala lopogu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kam kwebisibasi makawala kaitala pulopola,","poem":1},{"text":"e nunum makawala goli mabikosina kaiuwala.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yeigu bamweni makaina pulopola","poem":1},{"text":"e bakiuya kaiuwala.","poem":2},{"text":"Nunum kala lumkola makawala bukulela waini,","poem":1},{"text":"e m yagisa kubowala makawala mokolu maiinela,","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"e wodom kakamwenala makawala dilimoya waini.","poem":2},"Vivila",{"text":"Ibodi wala waini makwaina bitayelu bisaitaula bilokaia lubaigu,","poem":1},{"text":"bitayelu bila obilubalola deli okudula.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Namwaidogu wala lubaigu la vavagi,","poem":1},{"text":"e matauna saina nambwailila yeigu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mwa lubaigu, kuma bitam wa lolia,","poem":1},{"text":"e bitakanawa wala obuliyamata.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"E kaukwautoula wala bitamamata e bitavakawoli matamsina da sobula","poem":1},{"text":"kaina bogwa leiulisalalasi deli makaisina gigiku lalela bogwa leisisisi.","poem":2},{"text":"E makatupona wala bayomitali ulo yebwaili.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ka bogwa lokusikoni maiinela koiwaga,","poem":1},{"text":"deli komwaidona makwaisina kawailuwa","poem":2},{"lineBreak":true},{"text":"kwemmatabwaila oda kaukweda.","poem":2},{"text":"Mwa lubaigu, ka, da katudabuma makwaisina","poem":1},{"text":"kwaibubogwa deli kwaiwovau lasisii wala.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/kij_png/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}