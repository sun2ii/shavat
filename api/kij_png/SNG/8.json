{"translation":{"id":"kij_png","name":"Buki Pilabumaboma Kabutubogwa Deli Kabutuvau","website":"https://ebible.org/Scriptures/details.php?id=kij","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kij","licenseNotes":null,"shortName":"PNG","englishName":"Kilivila: Buki Pilabumaboma Kabutubogwa Deli Kabutuvau Bible","language":"kij","textDirection":"ltr","sha256":"d04577ed037b57858f0ee39755faffb44dc2f48a7e2eb8e51b001cb5d6a14ba8","availableFormats":["json"],"listOfBooksApiLink":"/api/kij_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30172,"languageName":"Kilivila","languageEnglishName":"Kilivila"},"book":{"id":"SNG","translationId":"kij_png","name":"SOLOMONI KALA WOSI","commonName":"SOLOMONI KALA WOSI","title":"SOLOMONI KALA WOSI","order":22,"numberOfChapters":8,"sha256":"fa4a98a2947e7353931cd920aa8561aa5dceddbf8a3b4858e5b5894c92f25a25","firstChapterNumber":1,"firstChapterApiLink":"/api/kij_png/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/kij_png/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"Ka, mwada yoku luguta yoku,","poem":1},{"text":"deli inagu leivinunaim onunula.","poem":2},{"text":"E kidamwa babodaim wa keda,","poem":1},{"text":"bogwa wala baviyuwolaim e gala availa ibodi bikayuwaigu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"E bavakoulim balauwaim ola bwala inagu,","poem":1},{"text":"e baisa bukuvitulokaigu yebwaili kidikedala.","poem":2},{"text":"E, bogwa bavimomwaim wainitoula,","poem":1},{"text":"ulo waini metoya gigiku bukumom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mwa, yamam kikiwama avigaki agu kwabaikunu,","poem":1},{"text":"e yamam kakata kuyobobwaigu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Veve, yokomi vilemi Yerusalem, kukwatotilasi baisa yeigu,","poem":1},{"text":"taga kuyobosaimasi sogu lubaigu.","poem":2}]},{"type":"heading","content":["Pilalima Pilitalela Wosi"]},{"type":"verse","number":5,"content":[{"text":"Avaivila minana leimaima metoya oviloupakala","poem":1},{"text":"leikaipapasi wala sola lubaila leimaisi?","poem":2},"Vivila",{"text":"Ouula makaina mokolu lavigulaim,","poem":1},{"text":"ovalu makwaina leikapusiki kulum.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gala avaivila bitagagi nanom,","poem":1},{"text":"mesinaku agumwaguta wala lubaim.","poem":2},{"text":"Gala avaivila bukukwaipapi mesinaku agumwaguta wala.","poem":1},{"lineBreak":true},{"text":"Kunikoli yebwaili la peula makawala kaliga kala peula.","poem":1},{"text":"Kalubaila mokwita lutula makawala wala kaliga.","poem":2},{"text":"Kalubaila kala lumkola makawala kova yuviyavila,","poem":1},{"text":"bisubeilulu makawala kovatala kovasupa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sopi gala gagabila biumati;","poem":1},{"text":"dadoya gala gagabila bisuluwi.","poem":2},{"text":"Mitaga kidamwa availa bivigikoli mwada","poem":1},{"text":"bigimoli yebwaili metoya ola guguwa komwaidona,","poem":2},{"lineBreak":true},{"text":"matauna bivigakaisi kabokakayuwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ka, lumetasi nagwadi wala,","poem":1},{"text":"e nunula igau wala einupisi.","poem":2},{"text":"Ammakawala bakavigakaisi","poem":1},{"text":"kidamwa taitala tau bikasemwali minana?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kidamwa minana makawala valu kalila","poem":1},{"text":"yakamaisi bakakaliaiyasi kwaitala la bulukubukwabuya silibawokuva wala.","poem":2},{"text":"Mitaga kidamwa minana makawala kalapisilela valu","poem":1},{"text":"ibodi bakakalitulaisi metoya makaina kweisila tabudotala la bwala paila bakayamataisi minana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ka, yeigu makawala valu kalila,","poem":1},{"text":"deli nunugu nupiakwa makawala bolela vatoi.","poem":2},{"text":"Matauna lubaigu bogwa inikolaigu","poem":1},{"text":"mapaila ayubwaila wala, abani ulo sibwabwaila.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kwaitala Solomoni la bagula bigulela waini","poem":1},{"text":"mapilana goli Beali Amoni.","poem":2},{"text":"E tobigubagula iwotitalaisi bagula makwaina,","poem":1},{"text":"e mapula uwala bagula,","poem":2},{"lineBreak":true},{"text":"taitala taitala matausina bimpumapu lakatuluwotala siliba baisa matauna.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"E desi wala Solomoni ibodi biyosi mani magulona","poem":1},{"text":"e matausina tobigubagula taitala taitala","poem":2},{"lineBreak":true},{"text":"biyosi lakatuyu siliba paila kasi vilavila.","poem":2},{"text":"Mitaga yeigu ulo bagula bigulela waini,","poem":1},{"text":"agumwaleta wala gala taiyuwegu!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ve, lubaigu, kuvitakaula balagi kaigam olumoulela bagula,","poem":1},{"text":"paila segwaia eitulotulasi wala bilagaisi kaigam.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mwa lubaigu, kumakaiagu,","poem":1},{"text":"kuma makawala natana dia,","poem":2},{"text":"kaina makawala natana nagwadi dia namwala","poem":1},{"text":"odubiluwotala koya ambaisa avai vana avai vana eisususinasi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kij_png/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kij_png/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kij_png/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}