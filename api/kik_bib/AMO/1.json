{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"AMO","translationId":"kik_bib","name":"Amosi","commonName":"Amosi","title":"AMOSI","order":30,"numberOfChapters":9,"sha256":"1296161f1f62594e215b50658d2fd35d4427e6bd9130433d72434db5828fe47d","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/kik_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Ũyũ nĩguo ũhoro wa Amosi, ũmwe wa arĩithi arĩa maarĩithagia Tekoa,",{"noteId":0},"wa ũndũ ũrĩa onire ũkoniĩ Isiraeli mĩaka ĩĩrĩ mbere ya gĩthingithia, hĩndĩ ĩrĩa Uzia aarĩ mũthamaki wa Juda nake Jeroboamu mũrũ wa Joashu aarĩ mũthamaki wa Isiraeli."]},{"type":"verse","number":2,"content":["Oigire atĩrĩ:",{"text":"“Jehova araramaga arĩ Zayuni,","poem":1},{"text":"na akaruruma arĩ Jerusalemu;","poem":2},{"text":"ũrĩithio wa arĩithi a mbũri nĩũkooma,","poem":1},{"text":"nako gacũmbĩrĩ ga Karimeli kahoohe.”","poem":2}]},{"type":"heading","content":["Ituĩro rĩa Ciira kũrĩ Andũ arĩa Mariganĩtie na Isiraeli"]},{"type":"verse","number":3,"content":["Jehova ekuuga atĩrĩ:",{"text":"“Nĩ ũndũ wa mehia matatũ ma Dameski, o na mana-rĩ,","poem":1},{"text":"niĩ ndikahũndũra mangʼũrĩ makwa.","poem":2},{"text":"Tondũ nĩahũũrire Gileadi na ibũi","poem":1},{"text":"irĩ na magego ma kĩgera,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"nĩngaitĩrĩria nyũmba ya Hazaeli mwaki","poem":1},{"text":"ũrĩa ũgaacina ciĩhitho iria nũmu cia Beni-Hadadi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nĩngoinanga kĩhingo kĩa Dameski;","poem":1},{"text":"nĩngananga mũthamaki ũrĩa ũtũũraga Gĩtuamba kĩa Aveni,","poem":2},{"text":"na niine ũrĩa ũnyiitĩte njũgũma ya wathani kũu Bethi-Edeni.","poem":1},{"text":"Andũ a Suriata nĩmagatahwo matwarwo Kiri,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"verse","number":6,"content":["Jehova ekuuga atĩrĩ:",{"text":"“Nĩ ũndũ wa mehia matatũ ma Gaza,","poem":1},{"noteId":1},{"text":"o na mana-rĩ,","poem":1},{"text":"niĩ ndikahũndũra mangʼũrĩ makwa.","poem":2},{"text":"Tondũ nĩanyiitire kĩrĩndĩ gĩothe mĩgwate,","poem":1},{"text":"agĩkĩendia kũu Edomu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nĩngaitĩrĩria thingo cia Gaza mwaki","poem":1},{"text":"ũrĩa ũgaacina ciĩhitho iria nũmu ciakuo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nĩngananga mũthamaki wa Ashidodi,","poem":1},{"text":"na niine ũrĩa ũnyiitĩte njũgũma ya wathani kũu Ashikeloni.","poem":2},{"text":"Guoko gwakwa nĩgũgokĩrĩra Ekironi,","poem":1},{"text":"o nginya hĩndĩ ĩrĩa Mũfilisti wa mũthia agaakua,”","poem":2},{"text":"ũguo nĩguo Mwathani Jehova ekuuga.","poem":4}]},{"type":"verse","number":9,"content":["Ningĩ Jehova ekuuga atĩrĩ:",{"text":"“Nĩ ũndũ wa mehia matatũ ma Turo, o na mana-rĩ,","poem":1},{"text":"niĩ ndikahũndũra mangʼũrĩ makwa.","poem":2},{"text":"Tondũ nĩendirie kĩrĩndĩ gĩothe kĩa mĩgwate kũu Edomu,","poem":1},{"text":"akĩaga gũtĩĩa kĩrĩkanĩro kĩa ũiguano kĩa ariũ a ithe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nĩngaitĩrĩria thingo cia Turo mwaki","poem":1},{"text":"ũrĩa ũgaacina ciĩhitho iria nũmu ciakuo.”","poem":2}]},{"type":"verse","number":11,"content":["Jehova ekuuga atĩrĩ:",{"text":"“Nĩ ũndũ wa mehia matatũ ma Edomu, o na mana-rĩ,","poem":1},{"text":"niĩ ndikahũndũra mangʼũrĩ makwa.","poem":2},{"text":"Tondũ nĩatengʼeririe mũrũ wa nyina na rũhiũ rwa njora,","poem":1},{"text":"atarĩ na tha,","poem":2},{"text":"tondũ marakara make mahiũ matiathiraga,","poem":1},{"text":"na mangʼũrĩ make makĩrĩrĩmbũka matekũhoreka,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"nĩĩngaitĩrĩria Temani mwaki","poem":1},{"text":"ũrĩa ũgaacina ciĩhitho iria nũmu cia Bozara.”","poem":2}]},{"type":"verse","number":13,"content":["Jehova ekuuga atĩrĩ:",{"text":"“Nĩ ũndũ wa mehia matatũ ma Amoni, o na mana-rĩ,","poem":1},{"text":"niĩ ndikahũndũra mangʼũrĩ makwa.","poem":2},{"text":"Tondũ nĩatarũrire nda cia andũ-a-nja a Gileadi arĩa maarĩ na nda,","poem":1},{"text":"nĩgeetha aaramie mĩhaka ya gwake.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nĩngaitĩrĩria thingo cia Raba mwaki","poem":1},{"text":"ũrĩa ũgaacina ciĩhitho iria nũmu ciakuo,","poem":2},{"text":"gatagatĩ-inĩ ka mbugĩrĩrio ya mbaara mũthenya ũcio wa mbaara,","poem":1},{"text":"ũhaana ta rũhuho rũnene mũthenya wa kĩhuhũkanio.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mũthamaki wakuo nĩagatahwo, athaamio,","poem":1},{"text":"we mwene, hamwe na anene ake,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"line_break"}],"footnotes":[{"noteId":0,"caller":"+","text":"Tekoa rĩarĩ itũũra rĩa Juda, gũthini wa itũũra rĩa Bethilehemu.","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"Gaza rĩarĩ itũũra rĩmwe rĩa bata rĩa matũũra matano ma Afilisti, hamwe na matũũra ma Ashidodi, na Ashikeloni, na Ekironi, o na Gathu.","reference":{"chapter":1,"verse":6}}]},"thisChapterLink":"/api/kik_bib/AMO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/AMO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}