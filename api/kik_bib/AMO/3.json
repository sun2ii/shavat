{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"AMO","translationId":"kik_bib","name":"Amosi","commonName":"Amosi","title":"AMOSI","order":30,"numberOfChapters":9,"sha256":"1296161f1f62594e215b50658d2fd35d4427e6bd9130433d72434db5828fe47d","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/kik_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":3,"content":[{"type":"heading","content":["Aira Gwĩtwo Marute Ũira wa Gũũkĩrĩra Isiraeli"]},{"type":"verse","number":1,"content":["Ta iguai ũhoro ũyũ Jehova aarĩtie wa kũmũũkĩrĩra, inyuĩ andũ a Isiraeli, ũira wa gũũkĩrĩra nyũmba yothe ĩrĩa ndaarutire bũrũri wa Misiri:"]},{"type":"verse","number":2,"content":[{"text":"“Inyuĩ no inyuĩ ndĩthuurĩire","poem":1},{"text":"kuuma harĩ nyũmba ciothe cia thĩ;","poem":2},{"text":"nĩ ũndũ ũcio nĩngamũherithia","poem":1},{"text":"tondũ wa mehia manyu mothe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Andũ eerĩ maahota gũtwarana atĩa","poem":1},{"text":"matarĩ na karĩĩko?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mũrũũthi-rĩ, nĩũraramaga kĩhinga-inĩ","poem":1},{"text":"ũtarĩ kĩndũ ũnyiitĩte?","poem":2},{"text":"Nĩũraramaga ũrĩ kĩmamo-inĩ","poem":1},{"text":"ũtanyiitĩte kĩndũ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nyoni-rĩ, no ĩgwe thĩ mũtego-inĩ","poem":1},{"text":"hatarĩ kĩndũ gĩa kũmĩheenereria?","poem":2},{"text":"Mũtego-rĩ, no ũtegũke, uume thĩ","poem":1},{"text":"ũtagwatĩtie kĩndũ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Karumbeta no kahuhwo itũũra-inĩ inene,","poem":1},{"text":"na andũ mage gwĩtigĩra?","poem":2},{"text":"Mũtino no ũũke itũũra-inĩ inene,","poem":1},{"text":"na gũtuĩke ti Jehova ũũrehete?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ti-itherũ Mwathani Jehova ndarĩ ũndũ angĩĩka","poem":1},{"text":"atamenyithĩtie anabii, ndungata ciake,","poem":2},{"lineBreak":true},{"text":"ũrĩa atuĩte gwĩka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mũrũũthi nĩũraramĩte,","poem":1},{"text":"nũũ ũtangĩĩtigĩra?","poem":2},{"text":"Mwathani Jehova nĩarĩtie,","poem":1},{"text":"nũũ ũtangĩratha maũndũ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Anĩrĩrai mwĩre ciĩhitho iria nũmu cia Ashidodi,","poem":1},{"text":"na ciĩhitho iria nũmu cia bũrũri wa Misiri ũciĩre atĩrĩ:","poem":2},{"text":"“Ũnganai irĩma igũrũ cia Samaria,","poem":1},{"text":"mwĩonere inegene inene rĩrĩa rĩrĩ kuo,","poem":2},{"lineBreak":true},{"text":"na ũhinyanĩrĩria ũrĩa ũrĩ thĩinĩ wa andũ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Jehova ekuuga atĩrĩ:","poem":1},{"text":"“Andũ arĩa mahĩbaga indo cia gũtunyana","poem":2},{"text":"na indo cia ndaho kũu ciĩhitho-inĩ nũmu ciao,","poem":1},{"text":"matiũĩ gwĩka ũrĩa kwagĩrĩire.”","poem":2}]},{"type":"verse","number":11,"content":["Nĩ ũndũ ũcio Mwathani Jehova ekuuga atĩrĩ,",{"text":"“Thũ nĩĩkaharagania bũrũri;","poem":1},{"text":"nĩĩgatharia ciĩgitĩro cianyu cia hinya,","poem":2},{"lineBreak":true},{"text":"na ciĩhitho cianyu nũmu nĩigatahwo.”","poem":2}]},{"type":"verse","number":12,"content":["Jehova ekuuga atĩrĩ:",{"text":"“O ta ũrĩa mũrĩithi angĩteithũra","poem":1},{"text":"magũrũ meerĩ kana gacunjĩ ga gũtũ kuuma kanua ka mũrũũthi,","poem":2},{"lineBreak":true},{"text":"ũguo noguo andũ a Isiraeli makaahonokio,","poem":2},{"text":"acio maikaraga Samaria","poem":1},{"text":"maikarĩire mĩthia ya marĩrĩ mao,","poem":2},{"lineBreak":true},{"text":"o na arĩa maikarĩire itanda ciao marĩ Dameski.”","poem":2}]},{"type":"verse","number":13,"content":["Mwathani Jehova, Ngai Mwene-Hinya-Wothe, ekuuga atĩrĩ: “Ta iguai ũhoro ũyũ, na inyuĩ mũrute ũira wa gũũkĩrĩra nyũmba ya Jakubu."]},{"type":"verse","number":14,"content":[{"text":"“Mũthenya ũrĩa ngaaherithia Isiraeli nĩ ũndũ wa mehia make-rĩ,","poem":1},{"text":"nĩngananga igongona cia Betheli;","poem":2},{"text":"na ndinie hĩa cia kĩgongona kĩu","poem":1},{"text":"igwe thĩ.","poem":2},{"noteId":3}]},{"type":"verse","number":15,"content":[{"text":"Nĩngatharia nyũmba ya hĩndĩ ya gathano,","poem":1},{"text":"o hamwe na nyũmba ya hĩndĩ ya riũa;","poem":2},{"text":"nyũmba iria ngʼemie na mĩguongo nĩikaanangwo,","poem":1},{"text":"nacio nyũmba iria nene mũno nĩikamomorwo,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]}],"footnotes":[{"noteId":3,"caller":"+","text":"Mehia ma Isiraeli maagĩire mĩri marĩ Betheli rĩrĩa Mũthamaki Jeroboamu aathondekire ngai ya gacaũ, na akĩmĩakĩra kĩgongona kuo.","reference":{"chapter":3,"verse":14}}]},"thisChapterLink":"/api/kik_bib/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}