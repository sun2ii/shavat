{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"AMO","translationId":"kik_bib","name":"Amosi","commonName":"Amosi","title":"AMOSI","order":30,"numberOfChapters":9,"sha256":"1296161f1f62594e215b50658d2fd35d4427e6bd9130433d72434db5828fe47d","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/kik_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":4,"content":[{"type":"heading","content":["Isiraeli Kwaga Gũcookerera Ngai"]},{"type":"verse","number":1,"content":[{"text":"Ta iguai ũhoro ũyũ, inyuĩ ngʼombe cia Bashani","poem":1},{"text":"mũrĩ kũu igũrũ rĩa Kĩrĩma gĩa Samaria,","poem":2},{"text":"o inyuĩ andũ-a-nja arĩa mũhinyagĩrĩria athĩĩni","poem":1},{"text":"na mũkahehenja arĩa abatari,","poem":2},{"text":"na mũkeeraga athuuri anyu atĩrĩ:","poem":1},{"text":"“Tũreherei ndibei tũnyue!”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mwathani Jehova nĩehĩtĩte na ũtheru wake, akoiga atĩrĩ,","poem":1},{"text":"“Ti-itherũ ihinda nĩrĩroka","poem":2},{"text":"rĩrĩa mũkaguucũrũrio na mboorio,","poem":1},{"text":"na ũrĩa wanyu ũgaatigara aguucũrũrio na ndwano.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mũkoimio nja ũmwe kwa ũmwe,","poem":1},{"text":"muumĩrio mĩanya-inĩ ya rũthingo,","poem":2},{"lineBreak":true},{"text":"na mũikanio na kũu Harimoni,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"verse","number":4,"content":[{"text":"“Thiĩi Betheli mũkeehie;","poem":1},{"text":"o na thiĩi Giligali mũgakĩrĩrĩrie kwĩhia.","poem":2},{"noteId":4},{"text":"Rutagai magongona manyu o rũciinĩ,","poem":1},{"text":"mũrutage gĩcunjĩ kĩanyu gĩa ikũmi o mĩaka ĩtatũ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Cinagai mĩgate ĩĩkĩrĩtwo ndawa ya kũimbia,","poem":1},{"text":"ĩtuĩke igongona rĩa gũcookia ngaatho,","poem":2},{"text":"na mwĩrahage nĩ ũndũ wa maruta manyu ma kwĩyendera,","poem":1},{"text":"na mwĩtĩĩage nĩ ũndũ wamo, inyuĩ andũ a Isiraeli,","poem":2},{"text":"nĩgũkorwo ũguo nĩguo mwendaga gwĩka,”","poem":1},{"text":"ũguo nĩguo Mwathani Jehova ekuuga.","poem":4}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Ndaatũmire mũhũte mũrĩ matũũra-inĩ manyu manene,","poem":1},{"text":"na ngĩtũma mwage irio matũũra-inĩ,","poem":2},{"lineBreak":true},{"text":"no rĩrĩ, inyuĩ mũtiigana kũnjookerera,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“O na ningĩ ngĩmũima mbura,","poem":1},{"text":"hĩndĩ ĩrĩa magetha maatigĩtie o mĩeri ĩtatũ.","poem":2},{"text":"Nĩndoiririe mbura itũũra rĩmwe,","poem":1},{"text":"no ngĩaga kuuria itũũra rĩrĩa rĩngĩ.","poem":2},{"text":"Mũgũnda ũmwe ũkiurĩrwo;","poem":1},{"text":"ũrĩa ũngĩ ũkĩaga kuurĩrwo, ũkĩũma.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Andũ magĩtũgũũga kuuma itũũra rĩmwe nginya rĩrĩa rĩngĩ","poem":1},{"text":"magĩcaria maaĩ,","poem":2},{"text":"no mationire maaĩ maiganu ma kũnyua,","poem":1},{"text":"no rĩrĩ, inyuĩ mũtiigana kũnjookerera,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Mahinda maingĩ nĩndahũũrire mĩgũnda yanyu ya irio na ya mĩthabibũ,","poem":1},{"text":"ngĩmĩhũũra na mbaa, na mbuu.","poem":2},{"text":"Ngigĩ nĩciarĩire mĩtĩ yanyu ya mĩkũyũ na ya mĩtamaiyũ,","poem":1},{"text":"no rĩrĩ, inyuĩ mũtiigana kũnjookerera,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Nĩndamũrehithĩirie mĩthiro","poem":1},{"text":"ta ũrĩa ndeekire bũrũri wa Misiri.","poem":2},{"text":"Aanake anyu ngĩmoragithia na rũhiũ rwa njora,","poem":1},{"text":"na ngĩmũtunya mbarathi cianyu.","poem":2},{"text":"Ngĩtũma mũnungo wa ciimba kuuma kambĩ yanyu","poem":1},{"text":"ũnungĩrĩre maniũrũ manyu,","poem":2},{"lineBreak":true},{"text":"no rĩrĩ, inyuĩ mũtiigana kũnjookerera,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Nĩndangʼaũranirie amwe anyu","poem":1},{"text":"ta ũrĩa ndangʼaũranirie Sodomu na Gomora.","poem":2},{"text":"Mwahaanaga ta gĩcinga kĩraakana kĩrutĩtwo mwaki-inĩ,","poem":1},{"text":"no rĩrĩ, inyuĩ mũtiigana kũnjookerera,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Nĩ ũndũ ũcio, ũũ nĩguo ngũgwĩka wee Isiraeli,","poem":1},{"text":"na tondũ nĩngũgwĩka ũguo-rĩ,","poem":2},{"lineBreak":true},{"text":"wĩhaarĩrie gũtũngana na Ngai waku, wee Isiraeli.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ũrĩa ũmbaga irĩma","poem":1},{"text":"nowe ũmbaga rũhuho,","poem":2},{"lineBreak":true},{"text":"na akaguũrĩria mũndũ meciiria make,","poem":2},{"text":"o we ũtũmaga rũciinĩ kũgĩe nduma,","poem":1},{"text":"na agathiĩra thĩ kũrĩa gũtũũgĩru,","poem":2},{"lineBreak":true},{"text":"rĩĩtwa rĩake nĩ Jehova Ngai Mwene-Hinya-Wothe.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Betheli na Giligali maarĩ matũũra ma bata, na nĩkuo andũ maathiiaga gũkũngũĩra ũrĩa Jehova anamateithia.","reference":{"chapter":4,"verse":4}}]},"thisChapterLink":"/api/kik_bib/AMO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/AMO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/AMO/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}