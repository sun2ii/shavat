{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"AMO","translationId":"kik_bib","name":"Amosi","commonName":"Amosi","title":"AMOSI","order":30,"numberOfChapters":9,"sha256":"1296161f1f62594e215b50658d2fd35d4427e6bd9130433d72434db5828fe47d","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/kik_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"heading","content":["Andũ a Isiraeli kwĩrwo Meerire"]},{"type":"verse","number":1,"content":["Ta iguai ũhoro ũyũ, inyuĩ nyũmba ya Isiraeli, mũigue ngĩcakaya nĩ ũndũ wanyu:"]},{"type":"verse","number":2,"content":[{"text":"“Mũirĩtu gathirange, nĩwe Isiraeli, nĩagwĩte,","poem":1},{"text":"na ndagookĩra rĩngĩ,","poem":2},{"text":"atiganĩirio bũrũri-nĩ wake mwene,","poem":1},{"text":"hatarĩ na mũndũ wa kũmũũkĩria.”","poem":2}]},{"type":"verse","number":3,"content":["Mwathani Jehova ekuuga atĩrĩ:",{"text":"“Itũũra inene rĩrĩa rĩatũmaga thigari ngiri cia Isiraeli-rĩ,","poem":1},{"text":"no thigari igana igaatigara;","poem":2},{"text":"narĩo itũũra rĩrĩa rĩatũmaga thigari igana-rĩ,","poem":1},{"text":"no thigari ikũmi igaatigara.”","poem":2}]},{"type":"verse","number":4,"content":["Jehova ekwĩra nyũmba ya Isiraeli atĩrĩ:",{"text":"“Njariai mũtũũre muoyo;","poem":1}]},{"type":"verse","number":5,"content":[{"text":"tigai kũrongooria Betheli,","poem":2},{"text":"tigai gũthiĩ Giligali,","poem":1},{"text":"na mũtikanyiite rũgendo rwa gũthiĩ Birishiba.","poem":2},{"text":"Tondũ andũ a Giligali ti-itherũ nĩmagatahwo,","poem":1},{"text":"na andũ a Betheli matuuo kĩndũ hatarĩ.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Rongoriai Jehova, mũtũũre muoyo,","poem":1},{"text":"ndakae gũtuthũkĩra nyũmba ya Jusufu ta mwaki;","poem":2},{"text":"naguo mwaki ũcio nĩũkaniinana,","poem":1},{"text":"nakuo Betheli kwage mũndũ ũngĩhota kũũhoria.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Inyuĩ arĩa mũgarũraga kĩhooto gĩgatuĩka ũrũrũ,","poem":1},{"text":"na mũkarangĩrĩria ũthingu thĩ","poem":2}]},{"type":"verse","number":8,"content":[{"text":"(we ũrĩa wombire njata iria ciĩtagwo Kĩrĩmĩra na Karaũ,","poem":1},{"text":"o we ũrĩa ũgarũraga nduma ndumanu ĩgatuĩka rũciinĩ,","poem":2},{"lineBreak":true},{"text":"na agatumania mũthenya ũgatuĩka ũtukũ,","poem":2},{"text":"ũrĩa wĩtaga maaĩ ma iria rĩrĩa inene","poem":1},{"text":"akamaitũrũra gũkũ thĩ-rĩ:","poem":2},{"lineBreak":true},{"text":"Jehova nĩrĩo rĩĩtwa rĩake;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"areehagĩra kĩĩhitho kĩrũmu mwanangĩko o rĩmwe ta rũheni,","poem":1},{"text":"narĩo itũũra inene rĩrĩa rĩirigĩre akarĩanangithia),","poem":2}]},{"type":"verse","number":10,"content":[{"text":"inyuĩ mũthũũraga ũrĩa ũkananagia maũndũ iciirĩro-inĩ,","poem":1},{"text":"nake ũrĩa waragia ũhoro wa ma mũkamũmena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mũrangagĩrĩria mũthĩĩni,","poem":1},{"text":"na mũkamũtunya ngano na hinya.","poem":2},{"text":"Nĩ ũndũ ũcio, o na gũtuĩka nĩmwakĩte nyũmba nene cia mahiga-rĩ,","poem":1},{"text":"mũtigacitũũra;","poem":2},{"text":"o na gũtuĩka nĩmũhaandĩte mĩgũnda mĩega ya mĩthabibũ-rĩ,","poem":1},{"text":"mũtikanyua ndibei yayo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tondũ niĩ nĩnjũũĩ ũrĩa mahĩtia manyu maigana,","poem":1},{"text":"na ngamenya ũrĩa mehia manyu marĩ manene.","poem":2},{"lineBreak":true},{"text":"Inyuĩ mũhinyagĩrĩria andũ arĩa athingu,","poem":1},{"text":"na mũkaamũkĩra mahaki,","poem":2},{"lineBreak":true},{"text":"na mũkaagithia athĩĩni kĩhooto maciirĩro-inĩ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tondũ ũcio mũndũ ũrĩa mũbacĩrĩri","poem":1},{"text":"no gũkira akiraga ki mahinda ta macio,","poem":2},{"lineBreak":true},{"text":"tondũ nĩ mahinda mooru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Rongoriai maũndũ marĩa mega, no ti marĩa mooru,","poem":1},{"text":"nĩguo mũtũũre muoyo.","poem":2},{"text":"Nake Jehova Ngai Mwene-Hinya-Wothe","poem":1},{"text":"nĩarĩkoragwo hamwe na inyuĩ,","poem":2},{"lineBreak":true},{"text":"o ta ũrĩa mũtũire muugaga.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Thũũrai maũndũ marĩa mooru,","poem":1},{"text":"mwendage marĩa mega;","poem":2},{"lineBreak":true},{"text":"tũũriai kĩhooto maciirĩro-inĩ.","poem":2},{"text":"Jehova Ngai Mwene-Hinya-Wothe","poem":1},{"text":"ahota kũiguĩra matigari ma Jusufu tha.","poem":2}]},{"type":"verse","number":16,"content":["Tondũ ũcio-rĩ, Jehova Ngai Mwene-Hinya-Wothe, o we Mwathani, ekuuga atĩrĩ:",{"text":"“Nĩgũkaagĩa na mũcakayo njĩra-inĩ ciothe iria nene,","poem":1},{"text":"na kĩrĩro kĩa ruo rwa ngoro ihaaro-inĩ ciothe.","poem":2},{"text":"Arĩmi nĩmagatũmanĩrwo moke marĩre,","poem":1},{"text":"nao arĩa macakayaga moke macakae.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nĩgũkaagĩa mũcakayo mĩgũnda-inĩ yothe ya mĩthabibũ,","poem":1},{"text":"nĩgũkorwo nĩngatuĩkanĩria gatagatĩ-inĩ kanyu,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"heading","content":["Mũthenya wa Jehova"]},{"type":"verse","number":18,"content":[{"text":"Kaĩ inyuĩ mwĩriragĩria mũthenya wa Jehova","poem":1},{"text":"mũrĩ na haaro-ĩ!","poem":2},{"text":"Nĩ kĩĩ gĩtũmaga mwĩrirĩrie mũthenya ũcio wa Jehova?","poem":1},{"text":"Mũthenya ũcio ũgaatuĩka nduma, no ti ũtheri.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ũgaatuĩka ta mũndũ akĩũrĩra mũrũũthi,","poem":1},{"text":"agatũngana na nduba,","poem":2},{"text":"kana atoonye nyũmba yake,","poem":1},{"text":"nake aigĩrĩra guoko gwake rũthingo-inĩ,","poem":2},{"lineBreak":true},{"text":"arũmwo nĩ nyoka.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Githĩ mũthenya ũcio wa Jehova ndũgaagĩtuĩka nduma, no ti ũtheri;","poem":1},{"text":"ĩĩ, nduma ndumanu, gũtarĩ na mũrũri wa ũtheri?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Niĩ nĩthũire na nganyarara ciathĩ cianyu;","poem":1},{"text":"ndingĩkirĩrĩria ciũngano cianyu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"O na mũngĩndehera maruta ma njino,","poem":1},{"text":"na maruta ma ngano-rĩ,","poem":2},{"lineBreak":true},{"text":"ndikametĩkĩra.","poem":2},{"text":"O na mũngĩkarehe maruta marĩa mega ma ũiguano-rĩ,","poem":1},{"text":"ndikamarũmbũiya.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Thengiai inegene rĩu rĩa nyĩmbo cianyu!","poem":1},{"text":"Ndigathikĩrĩria mĩgambo ya inanda cianyu cia mũgeeto.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"No kĩhooto nĩkĩrekwo gĩthererage ta rũũĩ,","poem":1},{"text":"na ũthingu ũthererage ta karũũĩ gatahũũaga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Inyuĩ nyũmba ya Isiraeli-rĩ,","poem":1},{"text":"nĩmwandutagĩra magongona na maruta","poem":2},{"lineBreak":true},{"text":"mĩaka mĩrongo ĩna mũrĩ kũu werũ-inĩ?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nĩmũtũũgĩrĩtie ihooero rĩa mũthamaki wanyu,","poem":1},{"text":"o na njikarĩro ya mĩhianano yanyu,","poem":2},{"lineBreak":true},{"text":"o njata ĩyo ya ngai yanyu,","poem":2},{"lineBreak":true},{"text":"ĩrĩa mwethondekeire inyuĩ ene.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Tondũ ũcio-rĩ, nĩngatũma mũtahwo mũtwarwo mbere ya Dameski,”","poem":1},{"text":"ũguo nĩguo Jehova ekuuga, ũrĩa wĩtagwo Ngai Mwene-Hinya-Wothe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}