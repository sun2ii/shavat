{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"AMO","translationId":"kik_bib","name":"Amosi","commonName":"Amosi","title":"AMOSI","order":30,"numberOfChapters":9,"sha256":"1296161f1f62594e215b50658d2fd35d4427e6bd9130433d72434db5828fe47d","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/kik_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":9,"content":[{"type":"heading","content":["Isiraeli Nĩgũkanangwo"]},{"type":"verse","number":1,"content":["Nĩndonire Mwathani arũgamĩte kĩgongona-inĩ, nake akiuga atĩrĩ:",{"text":"“Gũtha ciongo cia itugĩ,","poem":1},{"text":"nĩgeetha hingĩro cia nyũmba cienyenye.","poem":2},{"text":"Hingĩro icio nĩigwĩre mĩtwe ya andũ othe,","poem":1},{"text":"na arĩa magatigara nĩngamooraga na rũhiũ rwa njora.","poem":2},{"text":"Gũtirĩ o na ũmwe ũkoora;","poem":1},{"text":"gũtirĩ ũkaahonoka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"O na mangĩkenja thĩ makinye kwa ngoma,","poem":1},{"text":"guoko gwakwa no gũkaamaruta kuo.","poem":2},{"text":"O na mangĩkaahaica igũrũ,","poem":1},{"text":"nĩngamaharũrũkia kuuma kuo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O na mangĩkehitha igũrũ rĩa kĩrĩma gĩa Karimeli,","poem":1},{"text":"nĩngamaguĩma kuo ndĩmanyiite.","poem":2},{"text":"O na mangĩkehitha mathiĩ rungu rwa iria-rĩ,","poem":1},{"text":"o nakuo nĩngatha nyoka ĩmarũme.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"O na mangĩgaatwarwo ithaamĩrio nĩ thũ ciao,","poem":1},{"text":"nĩngathana mooragĩrwo kuo na rũhiũ rwa njora.","poem":2},{"text":"Ngamakũũrĩra maitho makwa,","poem":1},{"text":"maitho ma ũũru, no ti ma wega.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mwathani, o we Jehova Mwene-Hinya-Wothe,","poem":1},{"text":"ũrĩa ũhutagia thĩ, ĩgatweka,","poem":2},{"lineBreak":true},{"text":"nao arĩa othe matũũraga kuo magacakaya,","poem":2},{"text":"bũrũri wothe nĩkũiyũra ũiyũrĩte ta Rũũĩ rwa Nili,","poem":1},{"text":"ningĩ ũkahũcũka ta rũũĩ rwa Misiri,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"we ũrĩa wakaga gĩikaro gĩake kĩa ũthamaki kĩraihu kũu igũrũ,","poem":1},{"text":"na akahaanda gĩtina gĩakĩo gũkũ thĩ,","poem":2},{"text":"ũrĩa wĩtaga maaĩ ma iria rĩrĩa inene,","poem":1},{"text":"na akamaitũrũra gũkũ thĩ-rĩ,","poem":2},{"lineBreak":true},{"text":"Jehova nĩrĩo rĩĩtwa rĩake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Jehova ekuuga atĩrĩ:","poem":1},{"lineBreak":true},{"text":"“Githĩ inyuĩ andũ a Isiraeli","poem":1},{"text":"mũtihaana andũ a Kushi harĩ niĩ?","poem":2},{"text":"Githĩ ti niĩ ndaarutire na ngĩambatia andũ a Isiraeli kuuma bũrũri wa Misiri,","poem":1},{"text":"na Afilisti kuuma Kafitori,","poem":2},{"lineBreak":true},{"text":"na Asuriata ngĩmaruta Kiri?","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Ti-itherũ, maitho ma Mwathani Jehova","poem":1},{"text":"nĩmacũthagĩrĩria makona ũthamaki ũrĩa wĩhagia.","poem":2},{"text":"Nĩngawananga,","poem":1},{"text":"ũthire gũkũ thĩ,","poem":2},{"text":"no ndikaananga","poem":1},{"text":"nyũmba ya Jakubu biũ,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"“Nĩgũkorwo nĩngathana,","poem":1},{"text":"na nĩngainainia nyũmba ya Isiraeli","poem":2},{"lineBreak":true},{"text":"gatagatĩ-inĩ ka ndũrĩrĩ ciothe,","poem":2},{"text":"o ta ũrĩa ngano ĩinainagio ĩrĩ gĩcungi-inĩ,","poem":1},{"text":"na gũkaaga kahĩndĩ kangĩgũa thĩ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Andũ arĩa othe ehia thĩinĩ wa andũ akwa","poem":1},{"text":"makooragwo na rũhiũ rwa njora,","poem":2},{"text":"o arĩa othe moigaga atĩrĩ,","poem":1},{"text":"‘Tũtingĩkorererwo nĩ mũtino, kana ũtũtũnge.’","poem":2}]},{"type":"heading","content":["Gũcookio kwa Isiraeli"]},{"type":"verse","number":11,"content":[{"text":"“Mũthenya ũcio nĩngacookereria","poem":1},{"text":"hema ya Daudi ĩrĩa ĩgwĩte,","poem":2},{"text":"thondeke kũrĩa yunĩkangĩte,","poem":1},{"text":"na njookererie kũrĩa yanangĩtwo,","poem":2},{"lineBreak":true},{"text":"na ndĩmĩake o ta ũrĩa yatariĩ mbere,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"nĩgeetha makegwatĩra matigari ma Edomu,","poem":1},{"text":"na ndũrĩrĩ ciothe iria ciĩtanagio na rĩĩtwa rĩakwa,”","poem":2},"ũguo nĩguo Jehova ekuuga,",{"text":"ũrĩa ũgeeka maũndũ macio.","poem":4}]},{"type":"verse","number":13,"content":["Jehova ekuuga atĩrĩ, “Matukũ nĩmarooka,",{"text":"“rĩrĩa mũgethi agaakorererwo nĩ mũciimbi,","poem":1},{"text":"nake mũhaandi akorererwo nĩ mũndũ ũrĩa ũhihaga thabibũ.","poem":2},{"text":"Ndibei ya mũhihano ĩgaatataga kuuma irĩma-inĩ,","poem":1},{"text":"na ĩthererage kuuma tũrĩma-inĩ tuothe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nĩngacookia andũ akwa a Isiraeli arĩa maatahĩtwo,","poem":1},{"text":"nao macookererie matũũra manene marĩa maanangĩtwo, matũũre kuo;","poem":2},{"text":"ningĩ marĩme mĩgũnda ya mĩthabibũ na manyuuage ndibei yayo.","poem":1},{"text":"Magathondeka mĩgũnda ya irio na marĩĩage maciaro mayo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Niĩ ngaahaanda Isiraeli bũrũri wao ene,","poem":1},{"text":"na matigacooka kũrutwo rĩngĩ bũrũri ũcio niĩ ndĩmaheete,”","poem":2},{"lineBreak":true},{"text":"ũguo nĩguo Jehova Ngai wanyu ekuuga.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/AMO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/OBA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/AMO/8.json","previousChapterAudioLinks":{},"numberOfVerses":15}