{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"DEU","translationId":"kik_bib","name":"Gũcookerithia","commonName":"Gũcookerithia","title":"GŨCOOKERITHIA MAATHANI","order":5,"numberOfChapters":34,"sha256":"ecef5893687c99d87e12be991cf46b7d12df63a5246b29d87eaf247e73a6daf1","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/kik_bib/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":33,"content":[{"type":"heading","content":["Musa Kũrathima Mĩhĩrĩga"]},{"type":"verse","number":1,"content":["Gĩkĩ nĩkĩo kĩrathimo kĩrĩa Musa mũndũ wa Ngai aarathimire andũ a Isiraeli atanakua."]},{"type":"verse","number":2,"content":["Akiuga atĩrĩ:",{"text":"“Jehova nĩokire kuuma Sinai,","poem":1},{"text":"na akĩmathererũkĩra kuuma Seiru;","poem":2},{"lineBreak":true},{"text":"akĩmaarĩra kuuma kĩrĩma gĩa Parani.","poem":2},{"text":"Ookire na ikundi cia arĩa atheru kuuma gũthini,","poem":1},{"text":"akiuma iharũrũka-inĩ cia irĩma ciake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ti-itherũ wee nĩwe wendete andũ;","poem":1},{"text":"arĩa othe atheru marĩ guoko-inĩ gwaku.","poem":2},{"text":"Othe mainamagĩrĩra magũrũ-inĩ maku,","poem":1},{"text":"makaamũkĩra ũrutani kuuma harĩwe,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"watho ũrĩa twaheirwo nĩ Musa,","poem":1},{"text":"nĩguo igai rĩa ũngano wa Jakubu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nĩwe warĩ mũthamaki wa Jeshuruni,","poem":1},{"text":"rĩrĩa atongoria a andũ moonganĩte,","poem":2},{"lineBreak":true},{"text":"marĩ hamwe na mĩhĩrĩga ya Isiraeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Rubeni arotũũra na ndagakue,","poem":1},{"text":"o na kana andũ ake manyiihe.”","poem":2}]},{"type":"verse","number":7,"content":["Na ha ũhoro wa Juda akiuga atĩrĩ,",{"text":"“Wee Jehova, thikĩrĩria kĩrĩro kĩa Juda;","poem":1},{"text":"mũrehe kũrĩ andũ ake.","poem":2},{"text":"Nĩarũagĩrĩra maũndũ make na guoko gwake.","poem":1},{"text":"Wee-rĩ, tuĩka wa kũmũteithia akĩrũa na thũ ciake.”","poem":2}]},{"type":"verse","number":8,"content":["Ũndũ wĩgiĩ Lawi oigire atĩrĩ:",{"text":"“Thumimu yaku na Urimu yaku","poem":1},{"text":"nĩ cia mũndũ ũrĩa ũkenagio nĩwe.","poem":2},{"text":"Nĩwamũgeririe arĩ kũu Masa;","poem":1},{"text":"ũkĩmũrũithia kũu maaĩ-inĩ ma Meriba.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ũhoro wa ithe na nyina oigire atĩrĩ,","poem":1},{"text":"‘Ndirameciiria.’","poem":2},{"text":"Ndaigana kũmenya ariũ a ithe,","poem":1},{"text":"kana akĩrũmbũiya ciana ciake mwene,","poem":2},{"text":"no nĩamenyereire kiugo gĩaku,","poem":1},{"text":"na akĩgitĩra kĩrĩkanĩro gĩaku.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nĩarutaga Jakubu kĩrĩra kĩa watho waku,","poem":1},{"text":"na akaruta Isiraeli watho waku.","poem":2},{"text":"Nĩarutagĩra ũbumba mbere yaku,","poem":1},{"text":"na akarutĩra magongona ma njino marĩ magima kĩgongona-inĩ gĩaku.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Rathima ũmenyi wake wa wĩra, Wee Jehova,","poem":1},{"text":"na ũkenagĩre wĩra wa moko make.","poem":2},{"text":"Gũtha njohero cia arĩa mekũmũũkĩrĩra;","poem":1},{"text":"ringa thũ ciake itigacooke kwarahũka rĩngĩ.”","poem":2}]},{"type":"verse","number":12,"content":["Ũndũ wĩgiĩ Benjamini oigire atĩrĩ:",{"text":"“Reke ũrĩa wendetwo nĩ Jehova ahurũke atarĩ na ũgwati harĩ we,","poem":1},{"text":"nĩgũkorwo amũgitagĩra mũthenya wothe,","poem":2},{"lineBreak":true},{"text":"nake ũrĩa Jehova endete ahurũkaga gatagatĩ-inĩ ga ciande ciake.”","poem":2}]},{"type":"verse","number":13,"content":["Ũndũ wĩgiĩ Jusufu oigire atĩrĩ:",{"text":"“Jehova arorathima bũrũri wake","poem":1},{"text":"na ime rĩega rĩa kuuma igũrũ,","poem":2},{"lineBreak":true},{"text":"na maaĩ ma kũrĩa kũriku marĩa marĩ na thĩ;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"hamwe na indo iria njega mũno ireehagwo nĩ riũa,","poem":1},{"text":"na kĩrĩa kĩega mũno kĩngiuma kũrĩ mweri;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"aũrathime na iheo iria thuuranĩre cia irĩma-inĩ cia tene,","poem":1},{"text":"na maciaro ma tũrĩma twa tene na tene;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"hamwe na iheo iria njega mũno cia thĩ,","poem":1},{"text":"na indo iria ciyũrĩte kuo, na ũtugi ũrĩa waikarĩte kĩhinga-inĩ kĩrĩa kĩahĩaga.","poem":2},{"text":"Maũndũ maya mothe maroikara mũtwe-inĩ wa Jusufu,","poem":1},{"text":"maroikara ũthiũ-inĩ wa mũriũ wa mũthamaki arĩ harĩ ariũ a ithe.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ũnene-inĩ wake ahaana ta ndegwa ya irigithathi;","poem":1},{"text":"hĩa ciake igakĩhaana ta cia ndegwa ya gĩthaka-inĩ.","poem":2},{"text":"Nĩagatheeca ndũrĩrĩ na cio,","poem":1},{"text":"o na ndũrĩrĩ iria irĩ ituri cia thĩ.","poem":2},{"text":"Ũguo nĩguo kũrĩ makũmi-inĩ ma ngiri ma Efiraimu;","poem":1},{"text":"ũguo noguo kũrĩ harĩ ngiri na ngiri cia Manase.”","poem":2}]},{"type":"verse","number":18,"content":["Ũndũ wĩgiĩ Zebuluni oigire atĩrĩ:",{"text":"“Kena, wee Zebuluni, ũkiumagara,","poem":1},{"text":"nawe Isakaru ũkene ũrĩ hema-inĩ ciaku.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nĩmagatũmanĩra andũ moke irĩma-inĩ","poem":1},{"text":"marutĩre magongona ma ũthingu kuo;","poem":2},{"text":"nĩmakaarĩa indo nyingĩ cia iria-inĩ,","poem":1},{"text":"na marĩe mĩthithũ ĩrĩa mĩhithe mũthanga-inĩ.”","poem":2}]},{"type":"verse","number":20,"content":["Ũndũ wĩgiĩ Gadi oigire atĩrĩ:",{"text":"“Kũrathimwo nĩ ũrĩa ũkwaramia mĩhaka ya Gadi!","poem":1},{"text":"Gadi atũũraga kuo ta mũrũũthi,","poem":2},{"lineBreak":true},{"text":"atambuuraga guoko kana mũtwe.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ethuurĩire bũrũri ũrĩa mwega mũno;","poem":1},{"text":"akĩigĩrwo gĩcunjĩ kĩa mũtongoria.","poem":2},{"text":"Rĩrĩa anene a andũ moonganire,","poem":1},{"text":"nĩ eekire maũndũ ma kĩhooto kĩa Jehova,","poem":2},{"lineBreak":true},{"text":"na matua makoniĩ Isiraeli.”","poem":2}]},{"type":"verse","number":22,"content":["Ũndũ wĩgiĩ Dani oigire atĩrĩ:",{"text":"“Dani nĩ kĩana kĩa mũrũũthi,","poem":1},{"text":"kĩguthũkĩte kiumĩte Bashani.”","poem":2}]},{"type":"verse","number":23,"content":["Ũndũ wĩgiĩ Nafitali oigire atĩrĩ:",{"text":"“Nafitali nĩaingĩhĩirwo nĩ ũtugi wa Jehova,","poem":1},{"text":"na aiyũrĩtwo nĩ kĩrathimo gĩake;","poem":2},{"lineBreak":true},{"text":"nĩakagaya mwena wa gũthini o nginya iria-inĩ.”","poem":2}]},{"type":"verse","number":24,"content":["Ũndũ wĩgiĩ Asheri oigire atĩrĩ:",{"text":"“Mũriũ ũrĩa mũrathime gũkĩra arĩa angĩ othe nĩ Asheri;","poem":1},{"text":"ariũ a ithe maroomwendaga,","poem":2},{"lineBreak":true},{"text":"na arothambagia nyarĩrĩ ciake na maguta.","poem":2},{"noteId":14}]},{"type":"verse","number":25,"content":[{"text":"Hingĩro cia ihingo ciaku","poem":1},{"text":"igaakorwo irĩ cia kĩgera na cia gĩcango,","poem":2},{"text":"naguo hinya waku","poem":1},{"text":"ũkaaiganana na matukũ maku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Gũtirĩ ngai ũhaana ta Mũrungu wa Jeshuruni,","poem":1},{"text":"o we ũgeragĩra igũrũ oke agũteithie,","poem":2},{"lineBreak":true},{"text":"na agaikarĩra matu onanie ũnene wake.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ngai ũrĩa ũtũũraga tene na tene nĩwe kĩĩhitho gĩaku,","poem":1},{"text":"namo moko make matũũraga nginya tene na tene marĩ mũhuro waku.","poem":2},{"text":"Nĩakarutũrũra thũ yaku yehere mbere yaku,","poem":1},{"text":"akiugaga atĩrĩ, ‘Mĩniine!’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Nĩ ũndũ ũcio Isiraeli agaatũũra arĩ wiki atarĩ na ũgwati;","poem":1},{"text":"gĩthima kĩa Jakubu nĩkĩgitĩre","poem":2},{"text":"o kũu bũrũri wa ngano, na ndibei ya mũhihano,","poem":1},{"text":"kũrĩa ime rĩa igũrũ rĩtataga.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Kũrathimwo-rĩ, nĩwe Isiraeli!","poem":1},{"text":"Nũũ ũkĩhaana ta we,","poem":2},{"lineBreak":true},{"text":"rũrĩrĩ rũhonoketio nĩ Jehova?","poem":2},{"text":"Nĩwe ngo yaku na mũgũteithia,","poem":1},{"text":"na nowe rũhiũ rwaku rwa njora rũrĩ riiri.","poem":2},{"text":"Thũ ciaku nĩikaaigua guoya irĩ mbere yaku,","poem":1},{"text":"nawe nĩũkarangĩrĩria kũndũ gwacio kũrĩa gũtũũgĩru.”","poem":2}]}],"footnotes":[{"noteId":14,"caller":"+","text":"Maguta maarĩ kĩonereria kĩa ũtonga ũrĩa woimanaga na ũrĩmi.","reference":{"chapter":33,"verse":24}}]},"thisChapterLink":"/api/kik_bib/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}