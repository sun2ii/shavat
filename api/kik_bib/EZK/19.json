{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"EZK","translationId":"kik_bib","name":"Ezekieli","commonName":"Ezekieli","title":"EZEKIELI","order":26,"numberOfChapters":48,"sha256":"aed5346994575e651115c6c101b5f01e4bd91d7f372182a42031284ddb0fdeed","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/kik_bib/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":19,"content":[{"type":"heading","content":["Macakaya nĩ ũndũ wa Athamaki a Isiraeli"]},{"type":"verse","number":1,"content":["“Ningĩ ambĩrĩria macakaya",{"noteId":13},"makoniĩ athamaki a Isiraeli,"]},{"type":"verse","number":2,"content":["ũmeere atĩrĩ:",{"text":"“ ‘Atĩrĩrĩ, maitũguo ahaanaga ta mũrũũthi wa mũgoma","poem":1},{"text":"arĩ gatagatĩ ka mĩrũũthi ĩrĩa ĩngĩ!","poem":2},{"text":"Wakomire kĩmamo-inĩ kĩa mĩrũũthi mĩĩthĩ,","poem":1},{"text":"na ũkĩrera ciana ciaguo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Warerire kĩana kĩmwe kĩaguo,","poem":1},{"text":"gĩgĩtuĩka mũrũũthi ũrĩ hinya.","poem":2},{"text":"Mũrũũthi ũcio ũkĩmenyera gũtambuuranga kĩrĩa wanyiita,","poem":1},{"text":"na ũkarĩĩaga andũ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nacio ndũrĩrĩ ikĩigua ũhoro waguo,","poem":1},{"text":"naguo ũkĩgwatĩrio irima-inĩ rĩao.","poem":2},{"text":"Ũgĩtwarwo bũrũri wa Misiri","poem":1},{"text":"ũguucĩtio na icũhĩ cia maniũrũ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ ‘Na rĩrĩa nyina ya mũrũũthi ũcio yoonire mwĩhoko wayo ndũnahinga,","poem":1},{"text":"na itanya rĩayo nĩrĩatuĩka rĩa tũhũ-rĩ,","poem":2},{"text":"ĩkĩoya kĩana kĩngĩ kĩayo,","poem":1},{"text":"ĩgĩgĩtua mũrũũthi ũrĩ hinya.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Naguo ũgĩcangacanga gatagatĩ ka mĩrũũthi ĩrĩa ĩngĩ,","poem":1},{"text":"nĩgũkorwo nĩwatuĩkĩte mũrũũthi ũrĩ hinya.","poem":2},{"text":"Mũrũũthi ũcio ũkĩmenyera gũtambuuranga kĩrĩa wanyiita,","poem":1},{"text":"na ũkarĩĩaga andũ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nĩwamomorire ciĩhitho ciao iria nũmu,","poem":1},{"text":"na ũkĩananga matũũra mao.","poem":2},{"text":"Bũrũri ũcio na andũ arĩa othe maatũũraga kuo,","poem":1},{"text":"makĩiyũrwo nĩ guoya wa mũraramo waguo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hĩndĩ ĩyo, ndũrĩrĩ ikĩũũkĩrĩra,","poem":1},{"text":"ndũrĩrĩ iria cioimĩte ngʼongo iria ciagũthiũrũrũkĩirie.","poem":2},{"text":"Ikĩwambĩra mũtego,","poem":1},{"text":"naguo mũrũũthi ũcio ũkĩgwatĩrio irima-inĩ rĩao.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Makĩũguucũrũria na icũhĩ cia maniũrũ, makĩũingĩria kĩaga-ini,","poem":1},{"text":"makĩũtwarĩra mũthamaki wa Babuloni.","poem":2},{"text":"Makĩũikia njeera,","poem":1},{"text":"na nĩ ũndũ ũcio mũraramo waguo ndwacookire kũiguuo","poem":2},{"lineBreak":true},{"text":"kũu irĩma-inĩ cia Isiraeli rĩngĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘Maitũguo aatariĩ ta mũthabibũ","poem":1},{"text":"ũhaandĩtwo thĩinĩ wa mũgũnda waku wa mĩthabibũ","poem":2},{"lineBreak":true},{"text":"hakuhĩ na maaĩ;","poem":2},{"text":"nĩwaciarĩte mũno, na ũkagĩa na honge nyingĩ","poem":1},{"text":"tondũ wa maaĩ kũingĩha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Honge ciaguo ciarĩ hinya,","poem":1},{"text":"igakĩagĩrĩra gũtuuo mũthĩgi wa mũthamaki.","poem":2},{"text":"Mũthabibũ ũcio ũkĩraiha na igũrũ,","poem":1},{"text":"ũgĩkĩra mahuti marĩa matumanu,","poem":2},{"text":"na nĩwonekaga wega nĩ ũndũ wa ũrĩa waraihĩte na igũrũ,","poem":1},{"text":"na nĩ ũndũ wa honge ciaguo nyingĩ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"No nĩwamunyirwo na mĩri yaguo nĩ ũndũ wa marakara,","poem":1},{"text":"na ũgĩikanio thĩ.","poem":2},{"text":"Naruo rũhuho rũrĩa ruumaga mwena wa irathĩro rũgĩtũma ũhoohe,","poem":1},{"text":"na maciaro maguo makĩhũrũrwo;","poem":2},{"text":"honge ciaguo iria ciarĩ hinya ikĩũma,","poem":1},{"text":"ikĩhĩa nĩ mwaki, ũgĩciniina.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Na rĩrĩ, rĩu ũhaandĩtwo werũ-inĩ wa mũthanga,","poem":1},{"text":"bũrũri ũrĩa mũũmũ, ũrĩ nyoota.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mwaki woimire rũhonge-inĩ rũmwe rwa iria nene,","poem":1},{"text":"ũgĩcina maciaro maguo, magĩthira.","poem":2},{"text":"Gũtirĩ rũhonge rũrĩ hinya rũtigaire harĩ guo","poem":1},{"text":"rũngĩtuuo mũthĩgi wa mũthamaki.’","poem":2},"Maya nĩ macakaya, na nĩmo maũndũ marĩa marĩcakayanagĩrwo namo.”"]}],"footnotes":[{"noteId":13,"caller":"+","text":"Icakaya rĩĩrĩ rĩatungagwo na rĩkainwo hĩndĩ ya mathiko ma mũtongoria (2Sam 1:17-27).","reference":{"chapter":19,"verse":1}}]},"thisChapterLink":"/api/kik_bib/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}