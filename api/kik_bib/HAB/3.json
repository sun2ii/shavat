{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"HAB","translationId":"kik_bib","name":"Habakuku","commonName":"Habakuku","title":"HABAKUKU","order":35,"numberOfChapters":3,"sha256":"76dac96ce5bc89d6611c1e8af6e555816ffbe7ffebc334d138e35e30b39ee3d6","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/kik_bib/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["Ihooya rĩa Habakuku"]},{"type":"verse","number":1,"content":["Rĩrĩ nĩ ihooya rĩa mũnabii Habakuku, rĩa kũinwo ta rwĩmbo."]},{"type":"verse","number":2,"content":[{"text":"Atĩrĩrĩ Jehova, nĩnjiguĩte ũhoro wa ngumo yaku,","poem":1},{"text":"nganyiitwo nĩ guoya nĩ ũndũ wa ciĩko ciaku.","poem":2},{"text":"Rurumũkia ciĩko ciaku matukũ-inĩ maya maitũ,","poem":1},{"text":"ũtũme imenyeke matukũ-inĩ maitũ;","poem":2},{"lineBreak":true},{"text":"o na hĩndĩ ĩrĩa ũrĩ mũrakaru, iguanagĩra tha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ngai ookire oimĩte Temani,","poem":1},{"text":"ũcio Mũtheru agĩũka oimĩte Kĩrĩma kĩa Parani.","poem":2},{"text":"Riiri wake ũkĩhumbĩra igũrũ,","poem":1},{"text":"naguo ũgooci wake ũkĩiyũra thĩ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ũkengi wake wahaanaga ta riũa rĩkĩratha;","poem":1},{"text":"mĩrũri yahenũkaga kuuma guoko-inĩ gwake,","poem":2},{"lineBreak":true},{"text":"naho hau nĩho hinya wake wahithĩtwo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mũthiro nĩguo wamũtongoragia;","poem":1},{"text":"mũrimũ wa mũthiro ũkamuuma thuutha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Aarũgamire, agĩthingithia thĩ;","poem":1},{"text":"agĩcũthĩrĩria agĩtũma ndũrĩrĩ ciinaine.","poem":2},{"text":"Irĩma cia tene ikĩmumuthũka,","poem":1},{"text":"natuo tũrĩma twa tene tũkĩmomoka.","poem":2},{"lineBreak":true},{"text":"Mĩthiĩre yake-rĩ, nĩ ya tene na tene.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nĩndonire andũ arĩa matũũraga hema cia Kushani marĩ na mĩnyamaro,","poem":1},{"text":"nao arĩa matũũraga Midiani maiyũrĩtwo nĩ ruo rũnene.","poem":2},{"noteId":0}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Wee Jehova-rĩ, nĩ njũũĩ warakarĩire?","poem":1},{"text":"Mangʼũrĩ maku-rĩ, nĩ tũrũũĩ mokĩrĩire?","poem":2},{"text":"Wee-rĩ, wokĩrĩire iria na mangʼũrĩ maku","poem":1},{"text":"rĩrĩa wahaicĩte mbarathi ciaku","poem":2},{"lineBreak":true},{"text":"na ngaari ciaku cia ũhootani cia ita?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nĩwarutire ũta waku, ũkĩwoya na igũrũ,","poem":1},{"text":"na ũgĩĩtia mĩguĩ mĩingĩ.","poem":2},{"noteId":1},{"text":"Nayo thĩ ũkĩmĩgayania na njũũĩ;","poem":1}]},{"type":"verse","number":10,"content":[{"text":"irĩma ciakuonire ikĩĩnyogonda.","poem":2},{"text":"Kĩguũ kĩa maaĩ nakĩo gĩgĩtherera;","poem":1},{"text":"maaĩ ma kũrĩa kũriku makĩhũũyũka,","poem":2},{"lineBreak":true},{"text":"na makĩambararia makũmbĩ mamo na igũrũ taarĩ moko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Riũa na mweri nĩciarũgamire o ro ũguo kũu igũrũ,","poem":1},{"text":"ciona ũtheri wa mĩguĩ yaku ĩkĩrathũka,","poem":2},{"lineBreak":true},{"text":"na ciona kũhenia gwa itimũ rĩaku rĩkĩmenũka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Watuĩkanĩirie thĩ na mangʼũrĩ,","poem":1},{"text":"na ũkĩhũũra ndũrĩrĩ ũrĩ na marakara.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wokire kũhonokia andũ aku,","poem":1},{"text":"na ũhonokie ũrĩa waku mũitĩrĩrie maguta.","poem":2},{"text":"Wahehenjire kĩongo kĩa nyũmba ya waganu,","poem":1},{"text":"ũkĩmĩtharia nginya itina-inĩ ciayo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wamũtheecire mũtwe na itimũ rĩake mwene,","poem":1},{"text":"rĩrĩa njamba ciake cia ita ciatũtharĩkĩire itũharaganie;","poem":2},{"lineBreak":true},{"text":"cigakenagĩrĩra ta igũtambuura athĩĩni arĩa mehithĩte.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wee wakinyire iria igũrũ na mbarathi ciaku,","poem":1},{"text":"ũgĩthuka maaĩ macio maingĩ, magĩtuĩka makũmbĩ manene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ndaiguire ũhoro ũcio,","poem":1},{"text":"ngoro yakwa ĩgĩtumatuuma,","poem":2},{"text":"nacio iromo ciakwa ikĩinaina nĩ mũgambo ũcio;","poem":1},{"text":"mahĩndĩ makwa makĩonja,","poem":2},{"lineBreak":true},{"text":"namo magũrũ makwa makĩinaina.","poem":2},{"text":"No niĩ nĩngweterera ngirĩrĩirie,","poem":1},{"text":"nginya mũthenya ũrĩa wa kũnyariirĩka ũgaakinya,","poem":2},{"lineBreak":true},{"text":"ũkore rũrĩrĩ rũrĩa rũtũtharĩkagĩra.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Atĩrĩrĩ, o na mũkũyũ ũngĩaga kũruta kĩro,","poem":1},{"text":"nayo mĩthabibũ yaage thabibũ,","poem":2},{"text":"o naguo mũtamaiyũ wage maciaro,","poem":1},{"text":"nayo mĩgũnda yaage irio;","poem":2},{"text":"o na kũngĩaga ngʼondu gĩcegũ","poem":1},{"text":"na kwage ngʼombe ciugũ-inĩ-rĩ,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"niĩ no ndĩrĩkenagĩra Jehova,","poem":1},{"text":"njanjamũkage nĩ ũndũ wa Ngai Mũhonokia wakwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Mwathani Jehova nĩwe hinya wakwa,","poem":1},{"text":"atũmaga magũrũ makwa magĩe ihenya ta magũrũ ma thwariga,","poem":2},{"lineBreak":true},{"text":"nake aahotithagia kũhaica kũrĩa gũtũũgĩru.","poem":2},{"lineBreak":true},{"text":"Kũrĩ mũtongoria wa nyĩmbo. Rwĩmbo rũrũ nĩ rwa kũinwo na inanda cia mũgeeto.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Andũ a Kushani na Midiani maarĩ Aarabu arĩa matũũraga gũkuhĩ na Edomu.","reference":{"chapter":3,"verse":7}},{"noteId":1,"caller":"+","text":"Mĩguĩ haha nĩ heni na marurumĩ iria Mwathani aahũthĩrire.","reference":{"chapter":3,"verse":9}}]},"thisChapterLink":"/api/kik_bib/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}