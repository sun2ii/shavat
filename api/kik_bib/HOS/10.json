{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"HOS","translationId":"kik_bib","name":"Hosea","commonName":"Hosea","title":"HOSEA","order":28,"numberOfChapters":14,"sha256":"803d742f8cf815b8e5a47015d8634e28771a689b7ed25328450a37daff7e2923","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/kik_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Isiraeli aarĩ ta mũthabibũ watheeremaga,","poem":1},{"text":"nake agĩĩciarĩra maciaro.","poem":2},{"text":"O ũrĩa maciaro make maingĩhaga-rĩ,","poem":1},{"text":"noguo nake aakaga igongona nyingĩ;","poem":2},{"text":"o ũrĩa bũrũri wake wagaacagĩra-rĩ,","poem":1},{"text":"noguo aagemagia mahiga make marĩa maamũre ma kũhooyagwo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngoro ciao nĩ cia maheeni,","poem":1},{"text":"na rĩu no nginya marĩhio wĩhia wao.","poem":2},{"text":"Jehova nĩakamomora igongona ciao,","poem":1},{"text":"na athũkangie mahiga macio mao maamũre ma kũhooyagwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ningĩ nĩmakoiga atĩrĩ, “Tũtirĩ na mũthamaki,","poem":1},{"text":"tondũ tũtiigana gũtĩĩa Jehova.","poem":2},{"text":"No o na korwo twarĩ na mũthamaki-rĩ,","poem":1},{"text":"nĩ atĩa angĩahotire gũtwĩkĩra?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Meranagĩra ciĩranĩro nyingĩ,","poem":1},{"text":"na makehĩta mĩĩhĩtwa ya maheeni,","poem":2},{"lineBreak":true},{"text":"na magathondeka irĩkanĩro;","poem":2},{"text":"nĩ ũndũ ũcio maciira makunũkaga","poem":1},{"text":"ta mahuti marĩ ũrogi marĩa mameraga hianyũ-inĩ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Andũ arĩa matũũraga Samaria metangaga","poem":1},{"text":"nĩ ũndũ wa mũhianano wa njaũ ĩrĩa ya Bethi-Aveni.","poem":2},{"text":"Amu andũ akuo nĩmakamĩcakaĩra,","poem":1},{"text":"na noguo athĩnjĩri-ngai a mĩhianano ĩyo mageeka","poem":2},{"text":"arĩa makenagĩra riiri wayo,","poem":1},{"text":"tondũ nĩyeheretio kuuma kũrĩ o, ĩgathaamĩrio kũndũ kũngĩ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nayo ĩgaatwarwo Ashuri,","poem":1},{"text":"ĩtuĩke kĩheo kũrĩ mũthamaki ũcio mũnene.","poem":2},{"text":"Efiraimu nĩagaconorithio;","poem":1},{"text":"Isiraeli nake nĩagaconoka nĩ ũndũ wa mĩhianano ĩyo yake ya mĩtĩ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Samaria na mũthamaki wakuo magaathererio","poem":1},{"text":"ta karũhonge karĩ igũrũ wa maaĩ, maniinwo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kũndũ kũrĩa gũtũũgĩru gwĩkagĩrwo waganu nĩgũkanangwo,","poem":1},{"text":"na nĩkuo kwene wĩhia wa Isiraeli.","poem":2},{"text":"Mĩigua na mahiũ ma nyeki-inĩ nĩcio igaakũra kuo,","poem":1},{"text":"nacio ihumbĩre igongona ciao.","poem":2},{"text":"Nao andũ nĩmakeera irĩma atĩrĩ, “Tũhumbĩrei!”","poem":1},{"text":"na macooke meere tũrĩma atĩrĩ, “Tũgwĩrei!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Wee Isiraeli-rĩ, kuuma o matukũ-inĩ ma Gibea","poem":1},{"text":"ũtũũrĩte wĩhagia, na ũguo noguo ũtũũraga.","poem":2},{"text":"Githĩ mbaara ndĩakinyĩire eeki ũũru kũu Gibea?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Rĩrĩa niĩ ngenda, nĩngamaherithia;","poem":1},{"text":"ndũrĩrĩ nĩigacookanĩrĩra,","poem":2},{"text":"imokĩrĩre nĩguo imoohe imatahe","poem":1},{"text":"nĩ ũndũ wa mehia mao kũingĩha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Efiraimu nĩ moori menyerie wĩra","poem":1},{"text":"ĩrĩa yendete gũkonyora ngano;","poem":2},{"text":"nĩ ũndũ ũcio nĩngamĩoha icooki","poem":1},{"text":"ngingo-inĩ yayo thaka.","poem":2},{"text":"Nĩngatwarithia Efiraimu,","poem":1},{"text":"Juda no nginya agaacimba na mũraũ,","poem":2},{"lineBreak":true},{"text":"nake Jakubu no nginya agaacimba gĩtira.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Rĩu-rĩ, mwĩhaandĩrei ũhoro wa ũthingu,","poem":1},{"text":"nĩguo mwĩgethere maciaro ma wendo ũtathiraga,","poem":2},{"text":"na mũciimbe mĩgũnda yanyu ya ngamba;","poem":1},{"text":"nĩgũkorwo ihinda nĩ ikinyu rĩa kũrongooria Jehova,","poem":2},{"text":"nginya rĩrĩa agooka,","poem":1},{"text":"oirie mbura ya ũthingu igũrũ rĩanyu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"No rĩrĩ, inyuĩ mũhaandĩte waganu,","poem":1},{"text":"mũkagetha ũũru;","poem":2},{"lineBreak":true},{"text":"inyuĩ mũrĩĩte maciaro ma maheeni.","poem":2},{"text":"Tondũ mwĩhokaga hinya wanyu inyuĩ ene,","poem":1},{"text":"o na wa njamba cianyu nyingĩ cia ita-rĩ,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"mũrurumo wa mbaara nĩũgokĩrĩra andũ aku.","poem":1},{"text":"Nĩ ũndũ ũcio ciikaro ciaku iria nũmu nĩikaanangwo,","poem":2},{"text":"o ta ũrĩa Shalimani aanangire Bethi-Arabeli mũthenya ũrĩa wa mbaara,","poem":1},{"text":"rĩrĩa manyina ma twana maatungumanirio thĩ hamwe na twana twao.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ũguo noguo ũgeekwo wee Betheli,","poem":1},{"text":"nĩ ũndũ wa waganu waku mũnene.","poem":2},{"text":"Rĩrĩa mũthenya ũcio ũgaakĩa-rĩ,","poem":1},{"text":"mũthamaki wa Isiraeli nĩakaniinwo biũ.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}