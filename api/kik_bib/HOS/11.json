{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"HOS","translationId":"kik_bib","name":"Hosea","commonName":"Hosea","title":"HOSEA","order":28,"numberOfChapters":14,"sha256":"803d742f8cf815b8e5a47015d8634e28771a689b7ed25328450a37daff7e2923","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/kik_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"“Rĩrĩa Isiraeli aarĩ kaana-rĩ, nĩndamwendete,","poem":1},{"text":"ngĩgĩĩta mũrũ ũcio wakwa oime bũrũri wa Misiri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"No o ũrĩa ndaakĩragĩrĩria gwĩta Isiraeli,","poem":1},{"text":"noguo maakĩragĩrĩria kũnjũrĩra.","poem":2},{"text":"Nao makĩrutĩra Baali magongona,","poem":1},{"text":"na magĩcinĩra mĩhianano ũbumba.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Niĩ nĩ niĩ ndaarutire andũ a Efiraimu gwĩtwara na magũrũ,","poem":1},{"text":"ndĩmanyiitĩte moko;","poem":2},{"text":"no matiigana kũmenya","poem":1},{"text":"atĩ nĩ niĩ ndamahonagia.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nĩndamatongoragia na mĩkanda ya ũtugi wa ũmũndũ,","poem":1},{"text":"ngamaguucĩrĩria na mĩhĩndo ya wendo;","poem":2},{"text":"ngĩmaruta icooki ngingo,","poem":1},{"text":"na ngĩinamĩrĩra kũmahe irio.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Githĩ matigagĩcooka o kũu bũrũri wa Misiri,","poem":1},{"text":"o na githĩ matigaathwo nĩ Ashuri,","poem":2},{"lineBreak":true},{"text":"tondũ nĩmaregete kwĩrira, manjookerere?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hiũ cia njora ikaahenũkaga matũũra-inĩ mao manene,","poem":1},{"text":"ikaananga mĩgĩĩko ya ihingo ciao,","poem":2},{"lineBreak":true},{"text":"na ikinyie mĩbango yao mũthia.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Andũ akwa nĩmatuĩte itua maahuutatĩre.","poem":1},{"text":"O na mangĩgaakaĩra Ũrĩa-ũrĩ-Igũrũ-Mũno-rĩ,","poem":2},{"lineBreak":true},{"text":"ndakamatũgĩria o na atĩa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Ndahota atĩa gũgũtirika, wee Efiraimu?","poem":1},{"text":"Ndahota atĩa gũkũrekereria, wee Isiraeli?","poem":2},{"text":"Ndahota atĩa gũtũma ũtuĩke ta Adima?","poem":1},{"lineBreak":true},{"text":"Ndahota atĩa gũgũtua ta Zeboimu?","poem":1},{"lineBreak":true},{"text":"Ngoro yakwa nĩĩreganĩte na ũhoro ũcio,","poem":1},{"text":"nacio tha ciakwa ciothe nĩciarahũkĩte.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndikamũkinyĩria marakara makwa mahiũ,","poem":1},{"text":"o na kana hũgũkĩre Efiraimu ndĩmũniine.","poem":2},{"text":"Nĩgũkorwo niĩ nĩ niĩ Ngai, ndirĩ mũndũ,","poem":1},{"text":"Ngai Ũrĩa Mũtheru gatagatĩ-inĩ kanyu.","poem":2},{"lineBreak":true},{"text":"Ndigooka kũrĩ we ndĩ na mangʼũrĩ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nĩmakarũmĩrĩra Jehova;","poem":1},{"text":"nake nĩakararama ta mũrũũthi.","poem":2},{"text":"Hĩndĩ ĩrĩa akaararama-rĩ,","poem":1},{"text":"ciana ciake nĩigooka ikĩinainaga ciumĩte mwena wa ithũĩro.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Igooka ikĩinainaga","poem":1},{"text":"ta nyoni ikiuma bũrũri wa Misiri,","poem":2},{"lineBreak":true},{"text":"na ta ndutura ikiuma bũrũri wa Ashuri.","poem":2},{"text":"Nĩngatũma matũũre mĩciĩ-inĩ yao ene,”","poem":1},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"heading","content":["Mehia ma Isiraeli"]},{"type":"verse","number":12,"content":[{"text":"Efiraimu andigiicĩirie na maheeni,","poem":1},{"text":"nyũmba ya Isiraeli ĩkandigiicĩria na kũheenania.","poem":2},{"text":"Nake Juda akaremera Ngai,","poem":1},{"text":"o na agookĩrĩra Ũrĩa Mũtheru mwĩhokeku.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}