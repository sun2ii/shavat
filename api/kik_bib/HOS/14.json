{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"HOS","translationId":"kik_bib","name":"Hosea","commonName":"Hosea","title":"HOSEA","order":28,"numberOfChapters":14,"sha256":"803d742f8cf815b8e5a47015d8634e28771a689b7ed25328450a37daff7e2923","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/kik_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"heading","content":["Kwĩrira kũrĩa Kũrehaga Kĩrathimo"]},{"type":"verse","number":1,"content":[{"text":"Wee Isiraeli-rĩ, cookerera Jehova Ngai waku.","poem":1},{"lineBreak":true},{"text":"Mehia maku nĩmo makũgũithĩtie!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Thiĩ na ciugo ũcookerere Jehova,","poem":1},{"lineBreak":true},{"text":"ũmwĩre atĩrĩ,","poem":1},{"text":"“Tũrekere mehia maitũ mothe,","poem":2},{"text":"na ũtwamũkĩre na wega waku,","poem":1},{"text":"nĩguo tũhote gũkũrutĩra igongona rĩa gũkũgooca na mĩromo iitũ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ashuri ndangĩhota gũtũhonokia;","poem":1},{"text":"tũtikũhaica mbarathi cia ita.","poem":2},{"text":"Tũtirĩ hĩndĩ ĩngĩ tũgaacooka","poem":1},{"text":"gwĩta kĩrĩa tũthondekete na moko maitũ ‘ngai ciitũ,’","poem":2},{"lineBreak":true},{"text":"nĩgũkorwo thĩinĩ waku ciana cia ngoriai nĩciiguagĩrwo tha.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Nĩngamahonia kũrĩa maanoora njĩra,","poem":1},{"text":"na ndĩmende ndĩyendeire;","poem":2},{"lineBreak":true},{"text":"nĩgũkorwo marakara makwa nĩmamehereire.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngaatuĩka ta ime harĩ Isiraeli;","poem":1},{"text":"nake akaarirũka ta gĩtoka.","poem":2},{"text":"Agaikũrũkia mĩri yake","poem":1},{"text":"ehaande o ta mĩtarakwa ya Lebanoni.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Thuuna ciake nĩigakũra.","poem":2},{"text":"Ũthaka wake ũgaatuĩka ta wa mũtĩ wa mũtamaiyũ,","poem":1},{"text":"naguo mũtararĩko wake ũtuĩke ta mũtarakwa wa Lebanoni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Andũ nĩmagatũũra rĩngĩ kĩĩruru-inĩ gĩake.","poem":1},{"text":"Nake akaarura ta ngano.","poem":2},{"text":"Akaarirũka ta mũthabibũ,","poem":1},{"text":"nayo ngumo yake ĩtuĩke ta ya ndibei ya kuuma Lebanoni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wee Efiraimu, ndĩ na ũhoro ũngĩ ũrĩkũ na mĩhianano ya kũhooywo?","poem":1},{"text":"Nĩngamũcookeria ũhoro na ndĩmũmenyerere.","poem":2},{"text":"Haana ta mũkarakaba mũruru;","poem":1},{"text":"gũciara gwaku kuumaga harĩ niĩ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nũũ mũũgĩ? Ũcio nĩakamenya maũndũ macio.","poem":1},{"text":"Nũũ ũkũũranaga maũndũ? Ũcio nĩakamamenya.","poem":2},{"text":"Njĩra cia Jehova nĩ njagĩrĩru;","poem":1},{"text":"arĩa athingu nĩcio mathiiagĩra,","poem":2},{"lineBreak":true},{"text":"no arĩa aremi mahĩngagwo marĩ o njĩra-inĩ icio.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":9}