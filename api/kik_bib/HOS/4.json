{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"HOS","translationId":"kik_bib","name":"Hosea","commonName":"Hosea","title":"HOSEA","order":28,"numberOfChapters":14,"sha256":"803d742f8cf815b8e5a47015d8634e28771a689b7ed25328450a37daff7e2923","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/kik_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":4,"content":[{"type":"heading","content":["Thitango ya Gũũkĩrĩra Isiraeli"]},{"type":"verse","number":1,"content":[{"text":"Iguai ũhoro wa Jehova, inyuĩ andũ a Isiraeli,","poem":1},{"text":"tondũ Jehova nĩekũmũthitanga,","poem":2},{"lineBreak":true},{"text":"inyuĩ mũtũũraga thĩinĩ wa bũrũri ũyũ:","poem":2},{"text":"“Nĩ ũndũ-rĩ, gũtirĩ na wĩhokeku kana wendo,","poem":1},{"text":"kana kũmenya Ngai thĩinĩ wa bũrũri ũyũ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kĩrĩa kũrĩ no kũrumana, na kũheenania, na ũragani,","poem":1},{"text":"na ũici, na ũtharia;","poem":2},{"text":"maũndũ macio makaingĩha mũno,","poem":1},{"text":"na ũiti wa thakame ũkarũmĩrĩra ũiti wa thakame.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nĩ ũndũ wa gĩtũmi kĩu bũrũri nĩũracakaya,","poem":1},{"text":"na arĩa othe matũũraga thĩinĩ waguo makahinyara;","poem":2},{"text":"nyamũ cia gĩthaka, na nyoni cia rĩera-inĩ,","poem":1},{"text":"na thamaki cia iria-inĩ nĩgũkua irakua.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“No rĩrĩ, ndũkareke mũndũ arehe thitango,","poem":1},{"text":"mũndũ ndagathitange ũrĩa ũngĩ,","poem":2},{"text":"nĩgũkorwo andũ anyu mahaana andũ arĩa","poem":1},{"text":"mathitangaga mũthĩnjĩri-Ngai.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mũhĩngagwo mũthenya na ũtukũ,","poem":1},{"text":"na anabii makahĩngwo hamwe na inyuĩ.","poem":2},{"text":"Nĩ ũndũ ũcio nĩnganiina maitũguo.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Andũ akwa maniinagwo nĩ ũndũ wa kwaga ũmenyo.","poem":2},{"lineBreak":true},{"text":"“Tondũ nĩmũregete ũmenyo,","poem":1},{"text":"o na niĩ nĩndĩmũregete mũtuĩke athĩnjĩri-Ngai akwa;","poem":2},{"text":"tondũ nĩmũtiganĩirie watho wa Ngai wanyu,","poem":1},{"text":"o na niĩ nĩngatiganĩria ciana cianyu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"O ũrĩa athĩnjĩri-Ngai maingĩhaga,","poem":1},{"text":"noguo maakĩragĩrĩria kũnjĩhĩria;","poem":2},{"lineBreak":true},{"text":"nao magĩkũũrania riiri wao na kĩndũ gĩa thoni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mehũũnagia na mehia ma andũ akwa,","poem":1},{"text":"na magakenera waganu wao.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Na nĩgũgatuĩka atĩrĩ: O ta ũrĩa andũ makaahaana,","poem":1},{"text":"no taguo athĩnjĩri-Ngai makaahaana.","poem":2},{"text":"Nĩngamaherithia othe nĩ ũndũ wa mĩthiĩre yao,","poem":1},{"text":"na ndĩmarĩhe kũringana na ciĩko ciao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Makaarĩĩaga no matikahũũna,","poem":1},{"text":"makaahũũraga ũmaraya no matikaingĩha,","poem":2},{"text":"tondũ nĩmatiganĩirie Jehova","poem":1},{"text":"nĩguo meheane","poem":2}]},{"type":"verse","number":11,"content":[{"text":"kũrĩ ũmaraya,","poem":2},{"text":"na kũnyua ndibei ĩrĩa ngũrũ na ya mũhihano,","poem":1},{"text":"iria cieheragia ũmenyo","poem":2}]},{"type":"verse","number":12,"content":[{"text":"wa andũ akwa.","poem":2},{"text":"Mahooyaga kĩrĩra kuuma kũrĩ mũhianano mũicũhie,","poem":1},{"text":"naruo rũthanju rwa ũragũri rũkamacookeria ũhoro.","poem":2},{"text":"Roho wa ũmaraya nĩũmahĩtithagia njĩra;","poem":1},{"text":"makaaga kwĩhokeka kũrĩ Ngai wao.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Marutagĩra igongona irĩma igũrũ,","poem":1},{"text":"na magacinĩra maruta ma njino tũrĩma-inĩ,","poem":2},{"text":"na rungu rwa mũtĩ wa mũgandi, na wa mũribina, o na mũceceni,","poem":1},{"text":"tondũ kĩĩruru kĩayo nĩ kĩega.","poem":2},{"text":"Nĩkĩo airĩtu anyu mahũũraga ũmaraya,","poem":1},{"text":"na atumia a ariũ anyu magatharia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Ndikaherithia airĩtu anyu maahũũra ũmaraya,","poem":1},{"text":"kana herithie atumia a ariũ anyu maatharia,","poem":2},{"text":"tondũ arũme o ene mathiiaga thiritũ na maraya,","poem":1},{"text":"na makarutaga igongona hamwe na maraya ma mahooero-inĩ:","poem":2},{"lineBreak":true},{"text":"nĩ ũndũ ũcio andũ matarĩ ũmenyo nĩmakanangĩka!","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Atĩrĩ wee Isiraeli, o na gũtuĩka nĩũtharagia-rĩ,","poem":1},{"text":"Juda nĩagĩtige kwĩhia.","poem":2},{"lineBreak":true},{"text":"“Ndũgathiĩ Giligali;","poem":1},{"text":"o na ndũkambate Bethi-Aveni.","poem":2},{"noteId":8},{"lineBreak":true},{"text":"Na ndũkehĩte uuge atĩrĩ, ‘Ti-itherũ o ta ũrĩa Jehova atũũraga muoyo!’","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Andũ a Isiraeli mangʼathĩtie","poem":1},{"text":"o ta moori ngʼathia.","poem":2},{"text":"Kũngĩhoteka atĩa Jehova amarĩithie","poem":1},{"text":"ta tũgondu tũrĩ nyeki-inĩ nduru?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Efiraimu nĩegwatanĩtie na mĩhianano;","poem":1},{"text":"tiganai nake!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"O na rĩrĩa kĩndũ kĩao gĩa kũnyua gĩthirĩte-rĩ,","poem":1},{"text":"no mathiiaga na mbere na ũmaraya wao;","poem":2},{"lineBreak":true},{"text":"aathani ao nĩmendete mũno njĩra cia thoni.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kĩhuhũkanio kĩnene gĩkaamahaata kĩmombũkie,","poem":1},{"text":"na magongona mao nĩmakamaconorithia.","poem":2}]}],"footnotes":[{"noteId":8,"caller":"+","text":"Bethi-Aveni rĩarĩ rĩĩtwa rĩa kũnyũrũria Betheli, tondũ Bethi-Aveni nĩ kuuga “Nyũmba ya waganu”, naguo Betheli nĩ kuuga “Nyũmba ya Ngai”.","reference":{"chapter":4,"verse":15}}]},"thisChapterLink":"/api/kik_bib/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}