{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"HOS","translationId":"kik_bib","name":"Hosea","commonName":"Hosea","title":"HOSEA","order":28,"numberOfChapters":14,"sha256":"803d742f8cf815b8e5a47015d8634e28771a689b7ed25328450a37daff7e2923","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/kik_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":5,"content":[{"type":"heading","content":["Isiraeli Gũtuĩrwo Ciira"]},{"type":"verse","number":1,"content":[{"text":"“Iguai ũhoro ũyũ, inyuĩ athĩnjĩri-Ngai!","poem":1},{"text":"Tegai matũ, inyuĩ andũ a Isiraeli!","poem":2},{"text":"Thikĩrĩria, wee nyũmba ya ũthamaki!","poem":1},{"text":"Nĩ inyuĩ mũgũtuĩrwo ciira ũyũ:","poem":2},{"text":"Mũkoretwo mũrĩ mũtego kũu Mizipa,","poem":1},{"text":"na mũrĩ wabu ya gũtegana yarĩtwo kũu Taboru.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Aregi a watho nĩmarikĩire ũragani-inĩ.","poem":1},{"text":"Niĩ nĩngamaherithia othe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Niĩ nĩnjũũĩ maũndũ mothe ma Efiraimu;","poem":1},{"text":"Isiraeli ndahithĩtwo kuuma kũrĩ niĩ.","poem":2},{"text":"Wee Efiraimu, rĩu nĩũhũrĩte ũmaraya;","poem":1},{"text":"Isiraeli nake nĩathũkĩte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ciĩko ciao itingĩmetĩkĩria","poem":1},{"text":"gũcookerera Ngai wao.","poem":2},{"text":"Roho wa ũmaraya ũrĩ ngoro-inĩ ciao,","poem":1},{"text":"nao makaaga kũmenya Jehova.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mwĩtĩĩo wa Isiraeli nĩũrutaga ũira wa kũmookĩrĩra;","poem":1},{"text":"andũ a Isiraeli na Efiraimu mahĩngagwo nĩ mehia mao;","poem":2},{"lineBreak":true},{"text":"Juda o nake akahĩngwo hamwe nao.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hĩndĩ ĩrĩa magaathiĩ na ndũũru ciao cia mbũri na cia ngʼombe","poem":1},{"text":"kũrongooria Jehova-rĩ,","poem":2},{"lineBreak":true},{"text":"matikamuona; we nĩamehereire.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nĩmagĩte kwĩhokeka harĩ Jehova;","poem":1},{"text":"nao magaciara ciana itarĩ na ũngai.","poem":2},{"text":"Na rĩrĩ, ciathĩ ciao cia Karũgamo ka Mweri","poem":1},{"text":"nĩikaamameria, o hamwe na mĩgũnda yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Huhai karumbeta kũu Gibea,","poem":1},{"text":"na mũhuhe coro kũu Rama.","poem":2},{"text":"Muuge mbu ya gwĩtana mbaara kũu Bethi-Aveni;","poem":1},{"text":"wee Benjamini, wĩhũũge.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Efiraimu nĩgũgakira ihooru","poem":1},{"text":"mũthenya ũcio wa ituĩro.","poem":2},{"text":"Gatagatĩ-inĩ ka mĩhĩrĩga ya Isiraeli-rĩ,","poem":1},{"text":"niĩ ngwanĩrĩra ũrĩa kũrĩ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Atongoria a Juda mahaana","poem":1},{"text":"andũ arĩa meheragia mahiga ma mĩhaka.","poem":2},{"text":"Nĩngamaitĩrĩria mangʼũrĩ makwa,","poem":1},{"text":"taarĩ kĩguũ kĩa maaĩ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Efiraimu nĩmũhinyĩrĩrie,","poem":1},{"text":"akarangĩrĩrio ituĩro-inĩ rĩa ciira,","poem":2},{"lineBreak":true},{"text":"nĩ ũndũ wa kwenda kũrũmĩrĩra mĩhianano.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Niĩ haana memenyi kũrĩ Efiraimu,","poem":1},{"text":"na ngahaana ta ũbuthu kũrĩ andũ a Juda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Rĩrĩa Efiraimu oonire ndwari yake,","poem":1},{"text":"nake Juda akĩona ironda ciake-rĩ,","poem":2},{"text":"hĩndĩ ĩyo Efiraimu agĩthiĩ kũrĩ Ashuri,","poem":1},{"text":"na agĩtũmana kũrĩ mũthamaki ũcio mũnene nĩguo amũteithie.","poem":2},{"text":"Nowe ndangĩhota gũkũhonia,","poem":1},{"text":"o na kana ahonie ironda ciaku.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Niĩ ngaatuĩka ta mũrũũthi kũrĩ Efiraimu,","poem":1},{"text":"nduĩke ta mũrũũthi ũrĩ hinya kũrĩ Juda.","poem":2},{"text":"Ngaamatambuuranga, njooke ndĩthiĩre;","poem":1},{"text":"ngaamataha, na gũtirĩ mũndũ ũkaamahonokia.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ningĩ niĩ nĩngacooka gwakwa,","poem":1},{"text":"nginya rĩrĩa magetĩkĩra mahĩtia mao.","poem":2},{"text":"Nao nĩmakarongooria ũthiũ wakwa;","poem":1},{"text":"nao mona mathĩĩna nĩmakanongoria na kĩo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}