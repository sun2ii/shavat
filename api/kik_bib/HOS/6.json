{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"HOS","translationId":"kik_bib","name":"Hosea","commonName":"Hosea","title":"HOSEA","order":28,"numberOfChapters":14,"sha256":"803d742f8cf815b8e5a47015d8634e28771a689b7ed25328450a37daff7e2923","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/kik_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"heading","content":["Isiraeli Kwaga Kwĩrira"]},{"type":"verse","number":1,"content":[{"text":"“Ũkai, rekei tũcookerere Jehova.","poem":1},{"lineBreak":true},{"text":"Nĩatũtambuurangĩte,","poem":1},{"text":"no nĩegũtũhonia;","poem":2},{"text":"nĩatũtihangĩtie,","poem":1},{"text":"no nĩegũtuoha ironda ciitũ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Thuutha wa matukũ meerĩ, nĩagatwarahũra;","poem":1},{"text":"mũthenya wa ĩtatũ nĩagatũcookereria","poem":2},{"lineBreak":true},{"text":"nĩguo tũtũũre muoyo mbere yake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nĩtũmenyei Jehova,","poem":1},{"text":"na tũkĩrĩrĩrie kũmũmenya.","poem":2},{"text":"Ti-itherũ o ta ũrĩa riũa rĩrathaga-rĩ,","poem":1},{"text":"noguo o nake akooneka;","poem":2},{"text":"agooka kũrĩ ithuĩ ta mbura ya hĩndĩ ya heho,","poem":1},{"text":"kana ta mbura ya gũkũria irio ĩrĩa yuraga thĩ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Wee Efiraimu-rĩ, ingĩgwĩka atĩa?","poem":1},{"text":"Na wee Juda-rĩ, ngũgwĩka atĩa?","poem":2},{"text":"Wendo waku ũhaana ta kĩbii kĩa rũciinĩ,","poem":1},{"text":"ũkahaana ta ime rĩa rũciinĩ rĩrĩa rĩcookaga rĩgathira.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nĩkĩo ndaagũtinangirie icunjĩ na tũnua twa anabii akwa,","poem":1},{"text":"ngĩkũũraga na ciugo cia kanua gakwa;","poem":2},{"lineBreak":true},{"text":"matuĩro makwa magĩkĩhenũka ta rũheni igũrũ rĩaku.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nĩgũkorwo nyendaga tha no ti igongona,","poem":1},{"text":"na kũmenya Ngai gũkĩra maruta ma njino.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"O ta ũrĩa Adamu aathũkirie kĩrĩkanĩro gĩakwa,","poem":1},{"text":"noguo maagire kwĩhokeka ũndũ-inĩ ũcio.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gileadi nĩ itũũra inene rĩa andũ aaganu,","poem":1},{"text":"rĩhakĩtwo imeni nĩ makinya marĩ na thakame.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"O ta ũrĩa ikundi cia atunyani ciĩhithagĩra mũndũ,","poem":1},{"text":"no taguo ikundi cia athĩnjĩri-Ngai ciĩkaga;","poem":2},{"text":"moraganagĩra njĩra-inĩ ya gũthiĩ Shekemu,","poem":1},{"text":"makagera ngero cia thoni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Niĩ nĩnyonete ũndũ mũũru mũno","poem":1},{"text":"nyũmba-inĩ ya Isiraeli.","poem":2},{"text":"Kũu nĩkuo Efiraimu eheanĩte ahũũre ũmaraya,","poem":1},{"text":"nake Isiraeli nĩakanyiitwo nĩ thaahu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“O na kũrĩ we, wee Juda,","poem":1},{"text":"nĩwathĩrĩirio ihinda rĩa magetha.","poem":2},{"lineBreak":true},{"text":"“O hĩndĩ ĩrĩa ndaacookeria andũ akwa maũndũ ma kũmaguna,","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}