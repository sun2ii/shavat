{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"HOS","translationId":"kik_bib","name":"Hosea","commonName":"Hosea","title":"HOSEA","order":28,"numberOfChapters":14,"sha256":"803d742f8cf815b8e5a47015d8634e28771a689b7ed25328450a37daff7e2923","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/kik_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"o rĩrĩa ndenda kũhonia Isiraeli-rĩ,","poem":1},{"lineBreak":true},{"text":"mehia ma Efiraimu makonanio,","poem":1},{"text":"nacio ngero cia Samaria ikaguũrio.","poem":2},{"text":"Maaragia maũndũ ma maheeni,","poem":1},{"text":"na aici magatua nyũmba, magatoonya,","poem":2},{"lineBreak":true},{"text":"nacio njangiri igatunyana indo njĩra-inĩ;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"no rĩrĩ, matimenyaga","poem":1},{"text":"atĩ nĩndirikanaga ciĩko icio ciao njũru ciothe.","poem":2},{"text":"Mehia mao nĩmamarigiicĩirie;","poem":1},{"text":"makoragwo mbere yakwa hĩndĩ ciothe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Makenagia mũthamaki na waganu wao,","poem":1},{"text":"magakenia anene na maheeni mao.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Othe nĩ itharia,","poem":1},{"text":"maakanaga ta riiko rĩa kũrugĩra mĩgate,","poem":2},{"text":"rĩrĩa mũrugi wa mĩgate atabataragio nĩ gwakĩrĩria","poem":1},{"text":"kuuma gũkanda mũtu nginya ũimbe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mũthenya wa gĩathĩ kĩa mũthamaki witũ-rĩ,","poem":1},{"text":"we na anene ake manyuuaga ndibei makarĩĩo,","poem":2},{"lineBreak":true},{"text":"nake akanyiitana moko na arĩa manyũrũranagia.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngoro ciao nĩ ta riiko rĩa kũrugĩra mĩgate;","poem":1},{"text":"mathiiaga harĩ we marĩ na waara.","poem":2},{"text":"Thuti ciao ciakanaga kahora ũtukũ wothe;","poem":1},{"text":"nakuo gwakĩa rũciinĩ igaakana ta mwaki wa rũrĩrĩmbĩ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Othe mahiũhĩte ta riiko rĩa kũrugĩra mĩgate;","poem":1},{"text":"moragaga aathani ao.","poem":2},{"text":"Athamaki ao othe maniinagwo,","poem":1},{"text":"na gũtirĩ o na ũmwe wao ũngayagĩra.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Efiraimu nĩetukanĩtie na ndũrĩrĩ;","poem":1},{"text":"Efiraimu nĩ mũgate ũtarĩ mũgarũre.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Andũ a kũngĩ marĩĩaga hinya wake,","poem":1},{"text":"nowe ndamenyaga ũguo.","poem":2},{"text":"Njuĩrĩ ciake irĩ na mbuĩ,","poem":1},{"text":"nowe ndoonaga ũguo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mwĩtĩĩo wa Isiraeli nĩũrutaga ũira wa kũmũũkĩrĩra,","poem":1},{"text":"no o na kũrĩ ũguo-rĩ,","poem":2},{"text":"we ndacookagĩrĩra Jehova Ngai wake,","poem":1},{"text":"kana akamũrongooria.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Efiraimu ahaana ta ndutura,","poem":1},{"text":"ĩrĩa ĩheenekaga narua, ĩtarĩ ũmenyo;","poem":2},{"text":"rĩmwe akayagĩra bũrũri wa Misiri","poem":1},{"text":"na rĩrĩa rĩngĩ agathiĩ Ashuri.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Rĩrĩa magaathiĩ-rĩ, nĩngaikia wabu yakwa igũrũ rĩao;","poem":1},{"text":"nĩngamaharũrũkia ta nyoni cia rĩera-inĩ.","poem":2},{"text":"Rĩrĩa ngaigua nĩmaracookanĩrĩra-rĩ,","poem":1},{"text":"nĩngamanyiita.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kaĩ marĩ na haaro-ĩ,","poem":1},{"text":"tondũ nĩmandiganĩirie!","poem":2},{"text":"Maroniinwo,","poem":1},{"text":"tondũ nĩmanemeire!","poem":2},{"text":"Niĩ nĩnyendaga kũmahonokia,","poem":1},{"text":"no-o no igenyo manjigagĩrĩra.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Matingayagĩra kuuma ngoro-inĩ ciao,","poem":1},{"text":"no kũgirĩka magirĩkaga marĩ marĩrĩ-inĩ mao.","poem":2},{"text":"Monganaga hamwe nĩ ũndũ wa ngano, na ndibei ya mũhihano,","poem":1},{"text":"no niĩ makaahutatĩra.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndaamathomithirie na ngĩmekĩra hinya,","poem":1},{"text":"no-o mathugundaga kũnjĩka ũũru.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Maticookagĩrĩra Ũrĩa-ũrĩ-Igũrũ-Mũno;","poem":1},{"text":"mahaana ta ũta ũrĩa ũhĩtagia wathi.","poem":2},{"text":"Atongoria ao makooragwo na rũhiũ rwa njora,","poem":1},{"text":"nĩ ũndũ wa ciugo ciao cia rũtũrĩko.","poem":2},{"text":"Nĩ ũndũ wa ũguo nĩmakanyũrũrio","poem":1},{"text":"kũu bũrũri wa Misiri.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/HOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/HOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}