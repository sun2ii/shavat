{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"HOS","translationId":"kik_bib","name":"Hosea","commonName":"Hosea","title":"HOSEA","order":28,"numberOfChapters":14,"sha256":"803d742f8cf815b8e5a47015d8634e28771a689b7ed25328450a37daff7e2923","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/kik_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"heading","content":["Isiraeli Kũgetha Kĩhuhũkanio"]},{"type":"verse","number":1,"content":[{"text":"“Huhai karumbeta mwĩhũge!","poem":1},{"text":"Thũ ĩrerete igũrũ rĩa nyũmba ya Jehova ta nderi,","poem":2},{"text":"tondũ andũ nĩmathũkĩtie kĩrĩkanĩro gĩakwa,","poem":1},{"text":"na makarega watho wakwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Isiraeli nĩarangaĩra, akoiga atĩrĩ,","poem":1},{"text":"‘Wee Ngai witũ, nĩtũkũmenyete!’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"No Isiraeli nĩaregete ũndũ ũrĩa mwega;","poem":1},{"text":"nĩ ũndũ ũcio thũ nĩĩkamũingatithia.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Marũgamagia athamaki matarĩ na rũtha rwakwa,","poem":1},{"text":"magathuura anene itametĩkĩrĩtie.","poem":2},{"text":"Methondekagĩra mĩhianano","poem":1},{"text":"na betha na thahabu ciao,","poem":2},{"lineBreak":true},{"text":"nayo ĩgatuĩka ya kũmaniina.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wee Samaria-rĩ, te mũhianano wa ngai ĩyo ya njaũ!","poem":1},{"text":"Marakara makwa nĩmakanĩte harĩ yo.","poem":2},{"text":"Nĩ nginya-rĩ megũtũũra maremetwo nĩgũikara marĩ atheru?","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Acio moimĩte Isiraeli!","poem":2},{"text":"Njaũ ĩno nĩ mũturi ũmĩthondekete;","poem":1},{"text":"yo ti Ngai.","poem":2},{"text":"Njaũ ĩyo ya Samaria-rĩ,","poem":1},{"text":"nĩĩkoinangwo icunjĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Mahaandaga rũhuho,","poem":1},{"text":"makagetha kĩhuhũkanio;","poem":2},{"text":"ngano ndĩrĩ na magira,","poem":1},{"text":"ndĩngiumia mũtu;","poem":2},{"text":"korwo no ĩciare ngano,","poem":1},{"text":"andũ a kũngĩ nĩo mangĩmĩrĩa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Isiraeli nĩameretio;","poem":1},{"text":"rĩu arĩ gatagatĩ ka ndũrĩrĩ","poem":2},{"lineBreak":true},{"text":"ahaana ta kĩndũ gĩtarĩ bata.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nĩgũkorwo nĩmambatĩte, magathiĩ Ashuri,","poem":1},{"text":"ta ndigiri ya gĩthaka ĩkĩũrũra ĩrĩ iiki.","poem":2},{"lineBreak":true},{"text":"Efiraimu nĩeyendetie kũrĩ endwa ake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"O na gũtuĩka nĩmeyendetie gatagatĩ-inĩ ka ndũrĩrĩ,","poem":1},{"text":"rĩu nĩngũmacookanĩrĩria hamwe.","poem":2},{"text":"Mekwambĩrĩria kũhinyara,","poem":1},{"text":"mahinyĩrĩirio nĩ mũthamaki ũrĩa ũrĩ hinya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“O na gũtuĩka Efiraimu nĩakĩte igongona nyingĩ","poem":1},{"text":"cia kũrutagĩrwo maruta ma kũhoroherio mehia,","poem":2},{"lineBreak":true},{"text":"icio ituĩkĩte igongona cia kwĩhagĩria.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndaamandĩkĩire maũndũ maingĩ watho-inĩ wakwa,","poem":1},{"text":"no makĩmatua taarĩ maũndũ mageni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Marutaga magongona marĩa ndeheirwo,","poem":1},{"text":"magacooka makarĩa nyama icio,","poem":2},{"lineBreak":true},{"text":"no Jehova ndakenagio nĩmo.","poem":2},{"text":"Na rĩrĩ, nĩekũririkana waganu wao,","poem":1},{"text":"na aherithie mehia mao.","poem":2},{"lineBreak":true},{"text":"Nao nĩmagacooka bũrũri wa Misiri.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Isiraeli nĩariganĩirwo nĩ ũrĩa wamũmbire,","poem":1},{"text":"na agaaka nyũmba cia ũnene;","poem":2},{"lineBreak":true},{"text":"Juda nĩairigĩire matũũra maingĩ na thingo cia hinya.","poem":2},{"text":"No nĩngarehere matũũra mao manene mwaki","poem":1},{"text":"ũrĩa ũgaacina ciikaro ciao iria ciirigĩtwo na hinya.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}