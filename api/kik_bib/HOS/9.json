{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"HOS","translationId":"kik_bib","name":"Hosea","commonName":"Hosea","title":"HOSEA","order":28,"numberOfChapters":14,"sha256":"803d742f8cf815b8e5a47015d8634e28771a689b7ed25328450a37daff7e2923","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/kik_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"heading","content":["Kũherithio kwa Isiraeli"]},{"type":"verse","number":1,"content":[{"text":"Wee Isiraeli-rĩ, tiga gũkena;","poem":1},{"text":"tiga gũkũngũĩra ta ndũrĩrĩ iria ingĩ.","poem":2},{"text":"Nĩgũkorwo ũkoretwo ũtarĩ mwĩhokeku harĩ Ngai waku;","poem":1},{"text":"wee nĩwendete mũcaara wa maraya,","poem":2},{"lineBreak":true},{"text":"ũkaũcaragia kũrĩa guothe kũhuhagĩrwo ngano.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ihuhĩro cia ngano na ihihĩro cia ndibei itikahũũnia andũ,","poem":1},{"text":"o na gũtigakorwo na ndibei ya mũhihano.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Matigaatũũra bũrũri wa Jehova;","poem":1},{"text":"Efiraimu agaacooka bũrũri wa Misiri,","poem":2},{"lineBreak":true},{"text":"na arĩe irio irĩ thaahu kũu Ashuri.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Matigaitĩra Jehova maruta ma ndibei,","poem":1},{"text":"kana magongona mao mamũkenie.","poem":2},{"text":"Kũrĩo magongona ta macio makaahaana ta mũgate wa andũ megũcakaya;","poem":1},{"text":"arĩa othe makaamarĩa nĩmakanyiitwo nĩ thaahu.","poem":2},{"text":"Irio icio igaakorwo irĩ ciao o ene;","poem":1},{"text":"itikareehwo hekarũ-inĩ ya Jehova.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mũgeeka atĩa mũthenya ũrĩa mwamũre wa ciathĩ cianyu,","poem":1},{"text":"mĩthenya ĩyo ya gĩathĩ kĩa Jehova?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"O na mangĩkaahonoka kwanangwo,","poem":1},{"text":"andũ a bũrũri wa Misiri nĩmakamacookereria,","poem":2},{"lineBreak":true},{"text":"nao andũ a Memufisi mamathike.","poem":2},{"text":"Congʼe nĩguo ũgaacooka handũ ha igĩĩna ciao cia betha,","poem":1},{"text":"nayo mĩigua ĩhumbĩre hema ciao.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Matukũ ma kũherithio nĩmakinyu,","poem":1},{"text":"ĩĩ, matukũ ma kũrĩhania nĩmakinyĩte.","poem":2},{"lineBreak":true},{"text":"Isiraeli nĩamenye ũguo.","poem":2},{"text":"Tondũ mehia manyu nĩ maingĩ mũno,","poem":1},{"text":"na rũmena rwanyu rũkaneneha mũno,","poem":2},{"text":"mũnabii akoonagwo arĩ mũndũ mũkĩĩgu,","poem":1},{"text":"na mũndũ ũrĩa ũrĩ na ũrathi akonwo arĩ mũgũrũki.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mũnabii nĩwe ũtuĩtwo mũrangĩri","poem":1},{"noteId":9},{"text":"wa Efiraimu nĩ Ngai wakwa;","poem":1},{"lineBreak":true},{"text":"no rĩrĩ, mĩtego ĩmwetereire njĩra-inĩ ciake ciothe,","poem":1},{"text":"na rũmena rũkamweterera nyũmba-inĩ ya Ngai wake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nĩmatoonyereire, makarikĩra mũno ũũru-inĩ,","poem":1},{"text":"o ta ũrĩa meekire matukũ-inĩ ma Gibea.","poem":2},{"text":"Nake Ngai nĩakaririkana waganu wao,","poem":1},{"text":"na amaherithie nĩ ũndũ wa mehia mao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Rĩrĩa ndaamenyire Isiraeli,","poem":1},{"text":"kwarĩ ta mũndũ onete thabibũ werũ-inĩ;","poem":2},{"text":"rĩrĩa ndonire maithe manyu-rĩ,","poem":1},{"text":"kwarĩ ta mũndũ onete matunda ma mũtĩ wa mũkũyũ marĩa maambaga kwĩrua.","poem":2},{"text":"No rĩrĩa Isiraeli mookire Baali-Peoru,","poem":1},{"text":"nĩmeyamũrĩire mũhianano ũcio wa gĩconoko,","poem":2},{"lineBreak":true},{"text":"na magĩthũka, magĩtuĩka o ta kĩndũ kĩu mendete.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Riiri wa Efiraimu ũkoombũka ta nyoni ũũre:","poem":1},{"text":"gũtigakorwo ũhoro wa gũciara, kana gũkuua nda, o na kana kũgĩa nda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"O na mangĩkaarera ciana-rĩ,","poem":1},{"text":"nĩngaciũraga ciothe.","poem":2},{"text":"Rĩrĩa ngaagarũrũka ndĩmatige,","poem":1},{"text":"kaĩ nĩmagakorwo na haaro-ĩ!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nĩnyonete Efiraimu,","poem":1},{"text":"ahaandĩtwo handũ hega, o ta Turo.","poem":2},{"text":"No rĩrĩ, Efiraimu akaaruta ciana ciake,","poem":1},{"text":"acineane kũrĩ mũũragani.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mahe, Wee Jehova;","poem":1},{"text":"no nĩ kĩĩ ũkũmahe?","poem":2},{"text":"Mahe nda iria ihunaga,","poem":1},{"text":"na ũmahe nyondo iria itarĩ iria.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Nĩ ũndũ wa waganu wao wothe marĩ kũu Giligali,","poem":1},{"text":"nĩkĩo ndamamenire marĩ o kũu.","poem":2},{"text":"Nĩ ũndũ wa ciĩko ciao cia mehia-rĩ,","poem":1},{"text":"nĩngamarutũrũra moime nyũmba yakwa,","poem":2},{"text":"na ndigacooka kũmenda rĩngĩ;","poem":1},{"text":"atongoria ao othe nĩ aremi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Andũ a Efiraimu nĩacine nĩ mbaa,","poem":1},{"text":"naguo mũri wao nĩũhoohete,","poem":2},{"lineBreak":true},{"text":"maticiaraga maciaro.","poem":2},{"text":"O na mangĩciara ciana-rĩ,","poem":1},{"text":"nĩngooraga ciana icio ciao mendete.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ngai wakwa nĩakamarega,","poem":1},{"text":"nĩgũkorwo matiamwathĩkĩire;","poem":2},{"lineBreak":true},{"text":"magaatuĩka andũ a kũũrũũraga ndũrĩrĩ-inĩ.","poem":2}]}],"footnotes":[{"noteId":9,"caller":"+","text":"Arangĩri maarĩ anabii arĩa a ma, na nĩo matendetwo nĩ andũ a Isiraeli.","reference":{"chapter":9,"verse":8}}]},"thisChapterLink":"/api/kik_bib/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}