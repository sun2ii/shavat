{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"ISA","translationId":"kik_bib","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"2c733ef2b791070eea52024a01836239af096a74d88c91a64c062ab51e86b6e5","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/kik_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Maya nĩmo maũndũ marĩa maaguũrĩirio Isaia mũrũ wa Amozu, makoniĩ Juda na Jerusalemu hĩndĩ ya wathani wa Uzia, na wa Jothamu, na wa Ahazu, na wa Hezekia, arĩa maarĩ athamaki a Juda."]},{"type":"heading","content":["Rũrĩrĩ Rũremi"]},{"type":"verse","number":2,"content":[{"text":"Atĩrĩrĩ, wee igũrũ, ta thikĩrĩria! Nawe thĩ ta igua!","poem":1},{"text":"Nĩgũkorwo Jehova nĩarĩtie akoiga atĩrĩ:","poem":2},{"text":"“Niĩ heete ciana irio, ngacirera igakũra,","poem":1},{"text":"no cio ikaanemera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndegwa nĩyũũĩ mwene yo,","poem":1},{"text":"nayo ndigiri ĩkamenya mũharatĩ wa mwene yo,","poem":2},{"text":"no Isiraeli ndarĩ ũndũ ooĩ,","poem":1},{"text":"andũ akwa nĩmagĩte ũmenyo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hĩ! Kaĩ mũrĩ rũrĩrĩ rwĩhagia-ĩ.","poem":1},{"text":"Mũrĩ andũ matitikĩte mahĩtia,","poem":2},{"text":"na rũruka rwa andũ mekaga ũũru,","poem":1},{"text":"na ciana ciĩrutĩire gũthũkia maũndũ!","poem":2},{"text":"Nĩmatiganĩirie Jehova;","poem":1},{"text":"nĩmamenete Ũrĩa Mũtheru wa Isiraeli,","poem":2},{"lineBreak":true},{"text":"makamũhutatĩra, magacooka na thuutha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nĩ kĩĩ gĩgũtũma mwende gũikara mũkĩhũũragwo?","poem":1},{"text":"Nĩ kĩĩ gĩgũtũma mũthiĩ o na mbere kũrema?","poem":2},{"text":"Mũtwe wothe nĩmũtihangie,","poem":1},{"text":"nayo ngoro yothe ĩkanyamarĩka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kuuma ikinya rĩa kũgũrũ nginya mũtwe","poem":1},{"text":"gũtirĩ handũ hagima:","poem":2},{"text":"no nguraro theri, na mĩtũnda,","poem":1},{"text":"na ironda cia ndĩĩra","poem":2},{"text":"itarĩ thambie, kana ikoohwo,","poem":1},{"text":"kana ikororoiyo na maguta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bũrũri wanyu ũkirĩte ihooru,","poem":1},{"text":"matũũra manyu manene magacinwo na mwaki;","poem":2},{"text":"mĩgũnda yanyu ĩramathwo ĩgatigwo ũtheri nĩ andũ a kũngĩ","poem":1},{"text":"o mũkĩonaga,","poem":2},{"lineBreak":true},{"text":"ĩkoonũhwo ta ĩngʼaũranĩtio nĩ ageni.","poem":2},{"noteId":0}]},{"type":"verse","number":8,"content":[{"text":"Mwarĩ wa Zayuni atiganĩirio","poem":1},{"text":"ta gĩthũnũ kĩrĩ mũgũnda wa mĩthabibũ,","poem":2},{"text":"agatiganĩrio ta kanyũmba karĩ mũgũnda wa marenge,","poem":1},{"text":"o na ta itũũra inene rĩthiũrũrũkĩirio nĩ thũ ikĩenda kũrĩtunyana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tiga Jehova Mwene-Hinya-Wothe","poem":1},{"text":"aatũtigĩirie matigari manini ma andũ-rĩ,","poem":2},{"text":"tũngĩtuĩkĩte ta Sodomu,","poem":1},{"text":"na tũkahaana ta Gomora!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Thikĩrĩriai kiugo kĩa Jehova,","poem":1},{"text":"inyuĩ mwathanaga Sodomu;","poem":2},{"text":"na mũigue watho wa Ngai witũ,","poem":1},{"text":"inyuĩ andũ a Gomora!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Magongona macio manyu mũndutagĩra maingĩ-rĩ,","poem":1},{"text":"nĩ ma kĩ kũrĩ niĩ?” Ũguo nĩguo Jehova ekũũria.","poem":2},{"text":"“Nĩnjiganĩtwo nĩ magongona ma njino,","poem":1},{"text":"na magongona ma ndũrũme, na maguta ma nyamũ noru;","poem":2},{"text":"niĩ ndikenagĩra thakame ya ndegwa,","poem":1},{"text":"na ya tũtũrũme, o na ya mbũri.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nũũ ũkoragwo amwĩrĩte mũndutĩre magongona macio","poem":1},{"text":"rĩrĩa mũgũũka mbere yakwa kũũhooya,","poem":2},{"lineBreak":true},{"text":"mũkĩrangaga nja cia nyũmba yakwa?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tigai gũcooka kũrehe maruta ma tũhũ!","poem":1},{"text":"Ũbumba wanyu nĩ kĩndũ kĩa magigi harĩ niĩ.","poem":2},{"text":"Ndingĩhota gũkirĩrĩria ciũngano cianyu cia waganu:","poem":1},{"text":"mĩcemanio yanyu ya Karũgamo ka Mweri, na Thabatũ, o na ciathĩ iria njathane.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngoro yakwa nĩĩthũire ciathĩ cianyu","poem":1},{"text":"cia Karũgamo ka Mweri, o na ciathĩ iria njathane.","poem":2},{"text":"Maũndũ macio matuĩkĩte mũrigo harĩ niĩ,","poem":1},{"text":"nĩmanogetie.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hĩndĩ ĩrĩa mwambararia moko manyu na igũrũ mũkĩhooya,","poem":1},{"text":"nĩndĩrĩmũhithaga maitho makwa ndikamuone;","poem":2},{"text":"o na mũngĩhooya mahooya maingĩ ndirĩmũiguaga.","poem":1},{"lineBreak":true},{"text":"Nĩgũkorwo moko manyu maiyũrĩtwo nĩ thakame;","poem":1}]},{"type":"verse","number":16,"content":[{"text":"mwĩthambei mwĩtherie.","poem":2},{"text":"Eheriai ciĩko cianyu njũru maitho-inĩ makwa!","poem":1},{"lineBreak":true},{"text":"Tigai gwĩka maũndũ mooru,","poem":1}]},{"type":"verse","number":17,"content":[{"text":"mwĩrutei gwĩkaga wega!","poem":2},{"text":"Thingatagai ciira wa kĩhooto,","poem":1},{"text":"na mũkoomĩrĩria arĩa ahinyĩrĩrie.","poem":2},{"text":"Tuagai ciira wa ciana cia ngoriai na kĩhooto,","poem":1},{"text":"na mũthaithanagĩrĩre mũtumia wa ndigwa.”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Jehova ekuuga atĩrĩ,","poem":1},{"text":"“Ũkai tũciire.","poem":2},{"text":"O na mehia manyu mangĩkorwo matunĩhĩte ta gakarakũ-rĩ,","poem":1},{"text":"nĩmagathera o ta ira;","poem":2},{"text":"o na maatuĩka matunĩhĩte ta thakame,","poem":1},{"text":"nĩmakerũha o ta guoya wa ngʼondu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mũngĩnjigua na mũnjathĩkĩre,","poem":1},{"text":"nĩ mũrĩrĩĩaga indo iria njega mũno cia bũrũri;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"no mũngĩrema na mũrege gwathĩka,","poem":1},{"text":"mũkaaniinwo na rũhiũ rwa njora.”","poem":2},{"text":"Nĩgũkorwo nĩ kanua ka Jehova koigĩte ũguo.","poem":4}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Hĩ! Kaĩ itũũra inene rĩrĩa rĩĩhokeku","poem":1},{"text":"nĩrĩtuĩkĩte ta mũmaraya-ĩ!","poem":2},{"text":"Hĩndĩ ĩmwe rĩaiyũrĩte ũtuanĩri ciira wa kĩhooto;","poem":1},{"text":"ũthingu nĩguo watũũraga thĩinĩ warĩo,","poem":2},{"lineBreak":true},{"text":"no rĩu nĩ oragani matũũraga kuo!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Betha yanyu ĩtuĩkĩte gĩko,","poem":1},{"text":"ndibei yanyu ĩrĩa njega mũno ĩgatukanio na maaĩ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Andũ anyu arĩa mamwathaga nĩ kũrema maremete,","poem":1},{"text":"magatuĩka a thiritũ ya aici;","poem":2},{"text":"othe nĩmendete mahaki,","poem":1},{"text":"nao mahanyũkanagia na indo cia kũheo.","poem":2},{"text":"Maticiiragĩra ciana cia ngoriai na kĩhooto;","poem":1},{"text":"na matithikagĩrĩria ciira wa mũtumia wa ndigwa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nĩ ũndũ ũcio, Mwathani, Jehova Mwene-Hinya-Wothe,","poem":1},{"text":"O we Mwene Hinya wa Isiraeli, ekuuga atĩrĩ,","poem":2},{"text":"“Hĩ! Nĩngaitĩrĩria amuku akwa mangʼũrĩ makwa,","poem":1},{"text":"na ndĩĩrĩhĩrie harĩ thũ ciakwa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nĩngagũũkĩrĩra na guoko gwakwa;","poem":1},{"text":"ngagũtheria gĩko gĩaku gĩthire biũ,","poem":2},{"lineBreak":true},{"text":"na maũndũ maku mothe marĩa matarĩ matheru ndĩmatherie.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Aciirithania aku ngaatũma matuĩke o ta ũrĩa maatariĩ matukũ-inĩ ma tene,","poem":1},{"text":"na aheani kĩrĩra aku o ta ũrĩa maatariĩ kĩambĩrĩria-inĩ.","poem":2},{"text":"Thuutha ũcio ũgeetagwo","poem":1},{"text":"Itũũra Inene rĩa Ũthingu,","poem":2},{"lineBreak":true},{"text":"o na Itũũra Inene Rĩĩhokeku.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Itũũra rĩa Zayuni rĩgaakũũrwo na ciira wa kĩhooto,","poem":1},{"text":"nao andũ a rĩo arĩa merirĩte makũũrwo na ũthingu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"No andũ arĩa aremi na arĩa ehia makaaniinwo hamwe,","poem":1},{"text":"nao arĩa matiganagĩria Jehova nĩmagathira biũ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"“Nĩmũgaconoka nĩ ũndũ wa mĩgandi ĩyo mĩamũre","poem":1},{"text":"mũtũire mũkenagĩra;","poem":2},{"text":"nĩmũkaigua thoni nĩ ũndũ wa mĩgũnda","poem":1},{"text":"ĩyo mwĩthuurĩire.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Mũgaatuĩka ta mũgandi ũrahooha mathangũ,","poem":1},{"text":"mũtuĩke ta mũgũnda ũtarĩ maaĩ.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Mũndũ ũrĩa ũrĩ hinya agaatuĩka maragara,","poem":1},{"text":"naguo wĩra wake ũtuĩke thandĩ;","poem":2},{"text":"we na wĩra wake nĩmakahĩa hamwe,","poem":1},{"text":"haage mũndũ wa kũhoria mwaki ũcio.”","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Ũndũ ũyũ wekĩkĩte rĩrĩa Senakeribu aatharĩkĩire Jerusalemu (1Ath 18:13).","reference":{"chapter":1,"verse":7}}]},"thisChapterLink":"/api/kik_bib/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}