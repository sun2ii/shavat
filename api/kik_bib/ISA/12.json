{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"ISA","translationId":"kik_bib","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"2c733ef2b791070eea52024a01836239af096a74d88c91a64c062ab51e86b6e5","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/kik_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["Nyĩmbo cia Kũgooca"]},{"type":"verse","number":1,"content":["Na rĩrĩ, mũthenya ũcio nĩũkoiga atĩrĩ,",{"text":"“Nĩngũkũgooca, Wee Jehova.","poem":2},{"text":"O na gũtuĩka nĩwaandakarĩire-rĩ,","poem":1},{"text":"nĩũnjehereirie marakara maku na ũkaahooreria.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ti-itherũ Mũrungu nĩwe ũhonokio wakwa;","poem":1},{"text":"nĩwe ndĩrĩĩhokaga na ndigage gwĩtigĩra.","poem":2},{"text":"Jehova, o we Jehova, nĩwe hinya wakwa na rwĩmbo rwakwa;","poem":1},{"text":"nĩatuĩkĩte ũhonokio wakwa.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mũrĩtahaga maaĩ ithima-inĩ cia ũhonokio mũkenete.","poem":1}]},{"type":"verse","number":4,"content":["Mũthenya ũcio nĩmũkoiga atĩrĩ:",{"text":"“Cookeriai Jehova ngaatho, kaĩrai rĩĩtwa rĩake;","poem":1},{"text":"menyithaniai ndũrĩrĩ-inĩ ũrĩa ekĩte,","poem":2},{"lineBreak":true},{"text":"na mũhunjie muuge atĩ rĩĩtwa rĩake nĩ itũũgĩrie mũno.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Inĩrai Jehova, nĩgũkorwo nĩekĩte maũndũ marĩ riiri;","poem":1},{"text":"na mũtũme ũndũ ũcio ũmenywo nĩ thĩ yothe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Anĩrĩrai mũine mũrĩ na gĩkeno, inyuĩ andũ a Zayuni,","poem":1},{"text":"nĩgũkorwo Ũrĩa Mũtheru wa Isiraeli, o ũcio ũrĩ gatagatĩ-inĩ kanyu, nĩ mũnene mũno.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}