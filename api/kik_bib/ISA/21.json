{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"ISA","translationId":"kik_bib","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"2c733ef2b791070eea52024a01836239af096a74d88c91a64c062ab51e86b6e5","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/kik_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":21,"content":[{"type":"heading","content":["Ũrathi wa Gũũkĩrĩra Babuloni"]},{"type":"verse","number":1,"content":["Ĩno nĩyo ndũmĩrĩri nditũ ĩkoniĩ Werũ ũrĩa ũrĩ Hũgũrũrũ-inĩ cia Iria:",{"text":"Atĩrĩrĩ, o ta ũrĩa ihuhũkanio iria nene ihurutanaga ituĩkanĩirie bũrũri wa gũthini,","poem":1},{"text":"ũguo noguo mũtharĩkĩri agooka oimĩte werũ-inĩ,","poem":2},{"lineBreak":true},{"text":"kuuma bũrũri wa kũguoyohania.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Niĩ nĩnyonetio kĩoneki gĩa kũmakania mũno:","poem":1},{"text":"Mũkunyanĩri no arakunyanĩra, nake mũtahani no aratahana.","poem":2},{"text":"Wee Elamu tharĩkĩra! Nawe Media, thiũrũrũkĩria!","poem":1},{"text":"Gũcaaya kũrĩa anagũcaaithia nĩngagũkinyia mũthia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nĩ ũndũ wa ũguo mwĩrĩ wakwa nĩũiyũrĩtwo nĩ ruo,","poem":1},{"text":"ruo rũnene nĩrũũnyiitĩte, o ta ruo rwa mũtumia akĩrũmwo;","poem":2},{"text":"ngagĩtururio nĩ maũndũ marĩa ndĩraigua,","poem":1},{"text":"na ngagegeario nĩ maũndũ marĩa ndĩrona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngoro yakwa nĩĩratumatuuma,","poem":1},{"text":"na ngainaina nĩ guoya;","poem":2},{"text":"hwaĩ-inĩ ũrĩa ndĩriragĩria","poem":1},{"text":"ũtuĩkĩte ũndũ wa kũũmakia mũno.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nao nĩmaarĩte metha,","poem":1},{"text":"na makaara mĩgeka,","poem":2},{"text":"nĩguo marĩe na manyue!","poem":1},{"text":"Ũkĩrai inyuĩ anene,","poem":2},{"lineBreak":true},{"text":"mũhake ngo maguta!","poem":2}]},{"type":"verse","number":6,"content":["Jehova anjĩĩrĩte atĩrĩ:",{"text":"“Thiĩ, ũige mũrangĩri wa gũcũthĩrĩria","poem":1},{"text":"na ũmwĩre amenyithanie ũrĩa aroona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Rĩrĩa angĩona ngaari cia ita","poem":1},{"text":"irĩ na mbarathi ihaanaine,","poem":2},{"text":"na andũ magĩũka mahaicĩte ndigiri kana ngamĩĩra-rĩ,","poem":1},{"text":"nĩaikare eiguĩte, akeigua biũ.”","poem":2}]},{"type":"verse","number":8,"content":["Nake mũrangĩri akĩanĩrĩra, akiuga atĩrĩ,",{"text":"“Mũthenya o mũthenya, mwathi wakwa, ndũgamaga gĩtara-inĩ kĩa mũrangĩri;","poem":1},{"text":"na ũtukũ o ũtukũ njikaraga handũ hakwa ha kũrangĩra.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Atĩrĩrĩ, nĩharooka mũndũ akuuĩtwo nĩ ngaari ya ita,","poem":1},{"text":"ĩrĩ na mbarathi ihaanaine.","poem":2},{"text":"Nake aracookia ũhoro akoiga atĩrĩ:","poem":1},{"text":"‘Babuloni nĩrĩgũu, ĩĩ nĩrĩgwĩte!","poem":2},{"text":"Mĩhianano yothe ya ngai ciakuo","poem":1},{"text":"nĩmĩhehenje, ĩkaharagana thĩ!’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Inyuĩ andũ akwa, o inyuĩ mũthuthĩirwo kĩhuhĩro-inĩ kĩa ngano-rĩ,","poem":1},{"text":"ngũmwĩra ũrĩa njiguĩte","poem":2},{"text":"kuuma kũrĩ Jehova Mwene-Hinya-Wothe,","poem":1},{"text":"kuuma kũrĩ Ngai wa Isiraeli.","poem":2}]},{"type":"heading","content":["Ũrathi wa Gũũkĩrĩra Edomu"]},{"type":"verse","number":11,"content":["Ĩno nĩ ndũmĩrĩri nditũ ĩkoniĩ Duma:",{"text":"Atĩrĩrĩ, nĩ harĩ mũndũ ũraanjĩta kuuma Seiru,","poem":1},{"text":"akanjũũria atĩrĩ, “Mũrangĩri, ũtukũ ũkinyĩte ha?","poem":2},{"lineBreak":true},{"text":"Mũrangĩri ũyũ, ũtukũ ũkinyĩte ha?”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nake mũrangĩri akamũcookeria atĩrĩ,","poem":1},{"text":"“Gũkiriĩ gũkĩa, no rĩrĩ, nĩgũgũcooka gũtuke.","poem":2},{"text":"Angĩkorwo kũrĩ ũndũ ũkũũria-rĩ, ũria;","poem":1},{"text":"ũcooke ũũke hĩndĩ ĩngĩ.”","poem":2}]},{"type":"heading","content":["Ũrathi wa Gũũkĩrĩra Arabia"]},{"type":"verse","number":13,"content":["Ĩno nĩyo ndũmĩrĩri nditũ ĩkoniĩ bũrũri wa Arabia:",{"text":"Inyuĩ ikundi cia agendi a Adedani,","poem":1},{"text":"o inyuĩ mwambĩte hema ithaka-inĩ cia Arabia-rĩ,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"twarĩrai andũ arĩa anyootu maaĩ;","poem":2},{"text":"na inyuĩ mũtũũraga bũrũri wa Tema,","poem":1},{"text":"tũngiai andũ acio maroora irio","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nĩgũkorwo maroorĩra rũhiũ rwa njora,","poem":1},{"text":"o rũhiũ rwa njora rũrĩa rũcomoretwo,","poem":2},{"text":"makoorĩra ũta mũgeete,","poem":1},{"text":"na makoima kũrĩa mbaara ĩĩhĩire.","poem":2}]},{"type":"verse","number":16,"content":["Mwathani aranjĩĩra atĩrĩ: “Mwaka ũmwe ũtanathira, ũtarĩtwo ta ũrĩa mĩaka ya mũndũ wa kwandĩkwo wĩra ĩrĩkanagĩrwo-rĩ, riiri wothe wa Kedari nĩũgaathira."]},{"type":"verse","number":17,"content":["Andũ arĩa magaatigario nĩ thigari iria ciikagia mĩguĩ, o acio njamba cia ita cia Kedari-rĩ, magaakorwo marĩ o anini.” Jehova Ngai wa Isiraeli nĩwe warĩtie ũhoro ũcio."]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}