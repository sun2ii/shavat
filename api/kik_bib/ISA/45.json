{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"ISA","translationId":"kik_bib","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"2c733ef2b791070eea52024a01836239af096a74d88c91a64c062ab51e86b6e5","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/kik_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":45,"content":[{"type":"verse","number":1,"content":[{"text":"Atĩrĩrĩ, ũyũ nĩguo ũhoro ũrĩa Jehova areera Kurusu,","poem":1},{"text":"ũrĩa wake mũitĩrĩrie maguta,","poem":2},{"text":"o ũcio niĩ nyitĩte guoko gwake kwa ũrĩo","poem":1},{"text":"nĩguo ndoorie ndũrĩrĩ iria irĩ mbere yake,","poem":2},{"text":"na njaũre athamaki indo ciao cia mbaara,","poem":1},{"text":"nĩgeetha ndĩmũhingũrĩre mĩrango mbere yake,","poem":2},{"lineBreak":true},{"text":"na nĩguo ndakanakore ihingo ihingĩtwo:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nĩngagũtongoria","poem":1},{"text":"na nĩngaragania irĩma;","poem":2},{"text":"nĩngoinanga ihingo cia gĩcango,","poem":1},{"text":"na ndinangie mĩgĩĩko ya kĩgera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nĩngakũhe igĩĩna iria ihithĩtwo nduma-inĩ,","poem":1},{"text":"ngũhe ũtonga ũrĩa mũhithe,","poem":2},{"text":"nĩguo ũmenye atĩ niĩ nĩ niĩ Jehova,","poem":1},{"text":"o we Ngai wa Isiraeli, ũrĩa ũgwĩtĩte na rĩĩtwa rĩaku.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nĩngwĩtĩte na rĩĩtwa rĩaku,","poem":1},{"text":"nĩ ũndũ wa ndungata yakwa Jakubu,","poem":2},{"text":"o na nĩ ũndũ wa Isiraeli ũcio niĩ ndĩthuurĩire,","poem":1},{"text":"na ngakũhe rĩĩtwa rĩa gĩtĩĩo,","poem":2},{"lineBreak":true},{"text":"o na gũtuĩka wee ndũnjũũĩ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Niĩ nĩ niĩ Jehova, na gũtirĩ ũngĩ;","poem":1},{"text":"tiga niĩ gũtirĩ Ngai ũngĩ.","poem":2},{"text":"Nĩndĩrĩkuongagĩrĩra hinya,","poem":1},{"text":"o na gũtuĩka wee ndũnjũũĩ,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"nĩgeetha kuuma irathĩro rĩa riũa","poem":1},{"text":"nginya ithũĩro rĩarĩo,","poem":2},{"text":"andũ mamenye atĩ gũtirĩ ũngĩ tiga niĩ.","poem":1},{"text":"Niĩ nĩ niĩ Jehova, na gũtirĩ ũngĩ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nĩ niĩ ndũmaga kũgĩe ũtheri, o na ngatũma kũgĩe nduma,","poem":1},{"text":"nĩ niĩ ndehaga ũgaacĩru na ngatũma kũgĩe mwanangĩko;","poem":2},{"lineBreak":true},{"text":"Nĩ niĩ, Jehova, ũrĩa wĩkaga maũndũ macio mothe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Atĩrĩrĩ inyuĩ matu ma igũrũ, urĩriai thĩ ũthingu;","poem":1},{"text":"o na inyuĩ matu ma mbura itĩrĩriai thĩ ũthingu.","poem":2},{"text":"Thĩ nayo nĩyathamie kanua,","poem":1},{"text":"naguo ũhonokio nĩũkunũke, ũmere,","poem":2},{"text":"ũkũranĩre na ũthingu.","poem":1},{"text":"Niĩ Jehova-rĩ, nĩ niĩ ndũmĩte igĩe kuo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Ũrĩa ũgianaga na Mũmũũmbi, kaĩ arĩ na haaro-ĩ!","poem":1},{"text":"Ũcio ahaana o ta rũgĩo thĩinĩ wa ngĩĩo iria irĩ thĩ.","poem":2},{"text":"Rĩũmba rĩahota kũũria ũrĩa ũmbaga indo narĩo atĩrĩ,","poem":1},{"text":"‘Nĩ kĩĩ kĩu ũromba?’","poem":2},{"text":"O na kana wĩra waku no uuge atĩrĩ,","poem":1},{"text":"‘Ndarĩ na moko’?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hĩ, kaĩ ũrĩa ũragia ithe atĩrĩ,","poem":1},{"text":"‘Nĩ kĩĩ kĩu wagĩire?’","poem":2},{"text":"kana akooria nyina atĩrĩ,","poem":1},{"text":"‘Nĩ kĩĩ kĩu waciara?’","poem":2},{"lineBreak":true},{"text":"Kaĩ arĩ na haaro-ĩ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Jehova, Ũrĩa Mũtheru wa Isiraeli,","poem":1},{"text":"na Mũũmbi wake, ekuuga atĩrĩ:","poem":2},{"text":"Ha ũhoro ũkoniĩ maũndũ marĩa magooka-rĩ,","poem":1},{"text":"anga no mũkĩnjũũrie ũhoro wa ciana ciakwa,","poem":2},{"lineBreak":true},{"text":"kana mũnjathĩre wĩra wa moko makwa?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nĩ niĩ ndombire thĩ,","poem":1},{"text":"na ngĩũmba andũ arĩa marĩ kuo.","poem":2},{"text":"Moko makwa nĩmo maatambũrũkirie kũu igũrũ,","poem":1},{"text":"na ngĩatha mbũtũ cia igũrũ igĩe ho.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nĩngarahũra Kurusu nĩ ũndũ wa ũthingu wakwa:","poem":1},{"text":"Nĩngatũma mĩthiĩre yake ĩrũngĩrĩre.","poem":2},{"text":"We nĩagaaka itũũra rĩakwa rĩrĩa inene rĩngĩ,","poem":1},{"text":"na ohorithie andũ akwa arĩa matahĩtwo,","poem":2},{"text":"no rĩrĩ, matikarutĩrwo kĩndũ gĩa kũmakũũra kana marutĩrwo kĩheo,","poem":1},{"text":"ũguo nĩguo Jehova Mwene-Hinya-Wothe ekuuga.”","poem":2}]},{"type":"verse","number":14,"content":["Jehova ekuuga atĩrĩ:",{"text":"“Maciaro ma bũrũri wa Misiri, na indo cia wonjorithia cia Kushi,","poem":1},{"text":"o na andũ acio araihu a Sabea,","poem":2},{"text":"nĩmagooka kũrĩ we matuĩke aku;","poem":1},{"text":"nĩmagakuuma thuutha,","poem":2},{"text":"na moke kũrĩ we mohetwo na mĩnyororo.","poem":1},{"text":"Nĩmagakũinamĩrĩra, magũthaithe, makwĩre atĩrĩ,","poem":2},{"text":"‘Ti-itherũ Mũrungu arĩ hamwe nawe, na gũtirĩ ũngĩ tiga we;","poem":1},{"text":"ti-itherũ gũtirĩ ngai ĩngĩ.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ti-itherũ wee ũrĩ Mũrungu ũrĩa ũikaraga ehithĩte,","poem":1},{"text":"Wee Ngai na Mũhonokia wa Isiraeli.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Arĩa othe mathondekaga mĩhianano ya kũhooywo","poem":1},{"text":"nĩmagaconorithio na manyararithio;","poem":2},{"lineBreak":true},{"text":"makoimagara mathiĩ manyararithio othe hamwe.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"No rĩrĩ, Isiraeli nĩakahonokio nĩ Jehova","poem":1},{"text":"na ũhonokio wake ũrĩa ũtũũraga tene na tene;","poem":2},{"text":"wee ndũgaconorithio kana ũnyararithio","poem":1},{"text":"nginya tene na tene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Nĩgũkorwo Jehova ekuuga atĩrĩ,","poem":1},{"lineBreak":true},{"text":"ũcio wombire igũrũ,","poem":1},{"text":"o we Ngai,","poem":2},{"text":"o ũcio wombire thĩ na akĩmĩthondeka,","poem":1},{"text":"agĩcooka akĩmĩrũmia wega;","poem":2},{"text":"na ndaamĩũmbire ĩtũũre ĩrĩ ũtheri,","poem":1},{"text":"no aamĩũmbire ĩtũũragwo nĩ andũ;","poem":2},{"text":"we ekuuga atĩrĩ:","poem":1},{"lineBreak":true},{"text":"“Niĩ nĩ niĩ Jehova,","poem":1},{"text":"na gũtirĩ ũngĩ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ndirĩ ndaaria na hitho,","poem":1},{"text":"ndĩ handũ bũrũri-inĩ ũrĩ nduma;","poem":2},{"text":"ndirĩ ndeera njiaro cia Jakubu atĩrĩ,","poem":1},{"text":"‘Nongoriai o ũguo tũhũ.’","poem":2},{"text":"Niĩ Jehova, njaragia ũhoro wa ma;","poem":1},{"text":"nyumbũraga maũndũ marĩa magĩrĩire.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Cookanĩrĩrai hamwe, mũũke;","poem":1},{"text":"ũnganai, inyuĩ arĩa mũũrĩte kuuma kũrĩ ndũrĩrĩ.","poem":2},{"text":"Kwaga ũmenyi-rĩ, nĩ andũ arĩa makuuaga mĩhianano ya kũhooywo ya mĩtĩ,","poem":1},{"text":"na makahooya ngai itangĩhota kũmahonokia.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Umbũrai ũhoro wa ũrĩa gũgaikara, na mũũheane,","poem":1},{"text":"na andũ marekwo maciire marĩ hamwe.","poem":2},{"text":"Nũũ waheanire ũhoro ũyũ kuuma o tene?","poem":1},{"text":"Ningĩ nũũ waumbũrĩte matukũ-inĩ macio ma tene mũno?","poem":2},{"text":"Githĩ ti niĩ, niĩ Jehova?","poem":1},{"text":"Gũtirĩ Ngai ũngĩ tiga niĩ,","poem":2},{"text":"Mũrungu mũthingu na Mũhonokia;","poem":1},{"text":"ti-itherũ gũtirĩ ũngĩ tiga niĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Atĩrĩrĩ, inyuĩ ituri ciothe cia thĩ,","poem":1},{"text":"njookererai mũhonokio,","poem":2},{"lineBreak":true},{"text":"nĩgũkorwo niĩ nĩ niĩ Mũrungu, na gũtirĩ ũngĩ tiga niĩ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nĩndĩhĩtĩte ngĩĩgwetaga rĩĩtwa rĩakwa niĩ mwene,","poem":1},{"text":"naguo ũhoro ũkoima kanua gakwa na kĩhooto,","poem":2},{"lineBreak":true},{"text":"naguo ndũkagarũrũka o na atĩa:","poem":2},{"text":"Maru mothe nĩmagaturio mbere yakwa;","poem":1},{"text":"nacio nĩmĩ ciothe nĩcikeehĩta na rĩĩtwa rĩakwa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nĩmakaaria ũhoro wakwa, moige atĩrĩ,","poem":1},{"text":"‘Ũthingu na hinya cionekaga harĩ Jehova o we wiki.’ ”","poem":2},{"text":"Andũ arĩa othe maarakarire makĩmũũkĩrĩra,","poem":1},{"text":"nĩmagooka harĩ we maconorithio.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"No njiaro ciothe cia Isiraeli","poem":1},{"text":"nĩikoonekaga irĩ na ũthingu nĩ ũndũ wa Jehova,","poem":2},{"lineBreak":true},{"text":"na nĩigakena mũno.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}