{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"ISA","translationId":"kik_bib","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"2c733ef2b791070eea52024a01836239af096a74d88c91a64c062ab51e86b6e5","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/kik_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":47,"content":[{"type":"heading","content":["Kũgũa kwa Babuloni"]},{"type":"verse","number":1,"content":[{"text":"“Atĩrĩrĩ, harũrũka ũikare thĩ rũkũngũ-inĩ,","poem":1},{"text":"wee Mũirĩtu Gathirange wa Babuloni;","poem":2},{"text":"ikara thĩ ũtaikarĩire gĩtĩ kĩa ũnene,","poem":1},{"text":"wee Mwarĩ wa andũ a Babuloni.","poem":2},{"text":"Ndũgacooka gũtuĩka mũndũ wa kũmenyererwo,","poem":1},{"text":"kana mũndũ mũnyoroku ũtarĩ ũndũ angĩĩkĩra.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Oya mahiga ma gĩthĩi, ũthĩe mũtu;","poem":1},{"text":"eheria gĩtambaya gĩa kwĩhumbĩra ũthiũ.","poem":2},{"text":"Heta nguo ciaku na ũguũrie magũrũ maku,","poem":1},{"text":"ũtoboke maaĩ-inĩ ũringe tũrũũĩ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nĩũkarutwo nguo ũtigwo njaga,","poem":1},{"text":"ũikare ũconorithĩtio.","poem":2},{"text":"Nĩngerĩhĩria,","poem":1},{"text":"na gũtirĩ mũndũ ngaiguĩra tha.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mũkũũri witũ, Jehova Mwene-Hinya-Wothe nĩrĩo Rĩĩtwa rĩake,","poem":1},{"text":"nĩwe Ũrĩa Mũtheru wa Isiraeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Wee Mwarĩ wa andũ a Babuloni,","poem":1},{"text":"ikara thĩ ũkirĩte ki, ũthiĩ ũkinye nduma-inĩ;","poem":2},{"text":"ndũgacooka gwĩtwo","poem":1},{"text":"mũthamaki-mũndũ-wa-nja wa gwatha mothamaki.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nĩkũrakara ndaarakarĩĩtio nĩ andũ akwa,","poem":1},{"text":"na ngĩtũma igai rĩakwa rĩthaahe;","poem":2},{"text":"ngĩmaneana moko-inĩ maku,","poem":1},{"text":"nawe ũkĩaga kũmaiguĩra tha.","poem":2},{"text":"O na andũ arĩa akũrũ","poem":1},{"text":"ũkĩmaigĩrĩra icooki iritũ mũno.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nawe ũkiuga atĩrĩ, ‘Ngũtũũra ndĩ mũthamaki-mũndũ-wa-nja nginya tene!’","poem":1},{"text":"No wee ndũigana gũcũũrania maũndũ maya,","poem":2},{"text":"o na kana wĩciirie ũrĩa ũhoro wamo wa kũrigĩrĩria ũgaikara.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Na rĩrĩ, ta thikĩrĩria, wee wendete ikeno,","poem":1},{"text":"na ũikaraga ũtarĩ ũgwati ũngĩĩtigĩra,","poem":2},{"text":"na ũkeĩraga atĩrĩ,","poem":1},{"text":"‘Niĩ no niĩ, na gũtirĩ ũngĩ tiga niĩ.","poem":2},{"text":"Ndirĩ hĩndĩ ngaatuĩka mũtumia wa ndigwa,","poem":1},{"text":"kana menye ũhoro wa gũkuĩrwo nĩ ciana.’","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Maũndũ macio meerĩ nĩmagagũkorerera o rĩmwe,","poem":1},{"text":"mũthenya o ro ũmwe:","poem":2},{"lineBreak":true},{"text":"nĩũgakuĩrwo nĩ ciana, na ũtuĩke mũtumia wa ndigwa.","poem":2},{"text":"Maũndũ macio magaagũkorerera na ũiyũru biũ,","poem":1},{"text":"o na gũtuĩka ũrĩ na ũrogi mũingĩ,","poem":2},{"lineBreak":true},{"text":"na ũgo waku ũkaingĩha mũno.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ũtũire wĩhokete waganu waku,","poem":1},{"text":"ũkoiga atĩrĩ, ‘Gũtirĩ mũndũ ũnyonaga.’","poem":2},{"text":"Ũũgĩ na ũmenyo waku nĩikũhĩtithagia rĩrĩa ũkwĩĩra atĩrĩ,","poem":1},{"text":"‘Niĩ no niĩ, na gũtirĩ ũngĩ tiga niĩ.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nĩ ũndũ ũcio mwanangĩko nĩũgagũkora,","poem":1},{"text":"na ndũkaamenya ũrĩa ũngĩũũrĩra.","poem":2},{"text":"Nĩũgakorererwo nĩ mũtino","poem":1},{"text":"ũrĩa ũtangĩhota gwĩkũũra kuuma kũrĩ guo;","poem":2},{"text":"ningĩ nĩũgakorererwo o ro rĩmwe","poem":1},{"text":"nĩ ihooru rĩa maũndũ ũterĩgĩrĩire.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Wee thiĩ na mbere na ciama ciaku cia ũgo,","poem":1},{"text":"na ũrogi waku mũingĩ ũrĩa ũtũire wĩkaga kuuma ũrĩ mũnini.","poem":2},{"text":"No gũkorwo hihi nĩũkona kĩguni kĩa mo,","poem":1},{"text":"kana hihi ũtũme kũgĩe na itua-nda inene.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Irĩra iria ciothe ũheetwo no gũkũnogia ikũnogetie!","poem":1},{"text":"Ago aku arĩa maroraga igũrũ matu-inĩ nĩmeyumĩrie,","poem":2},{"text":"acio matuĩragia njata na makaratha mohoro o mweri, o mweri-rĩ,","poem":1},{"text":"nĩmagĩkũhonokie kuuma kũrĩ maũndũ marĩa megũgũkorerera.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ti-itherũ, andũ acio mahaana ta itira iria itigĩtwo mũgũnda;","poem":1},{"text":"nĩgũcinwo magaacinwo nĩ mwaki mathire.","poem":2},{"text":"Matikahota kwĩhonokia kuuma kũrĩ hinya wa rũrĩrĩmbĩ rwa mwaki,","poem":1},{"text":"nĩgũkorwo hatigaakorwo makara mangĩotwo mwaki;","poem":2},{"lineBreak":true},{"text":"hatirĩ mwaki haha ũngĩotwo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ũguo noguo mangĩgwĩkĩra,","poem":1},{"text":"aya mwanarutithania wĩra na mũkonjorithia nao","poem":2},{"lineBreak":true},{"text":"kuuma rĩrĩa warĩ mũnini.","poem":2},{"text":"O mũndũ wao athiiaga o na mbere kũhĩtia;","poem":1},{"text":"gũtigakorwo mũndũ o na ũmwe ũngĩgĩkũhonokia.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}