{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"ISA","translationId":"kik_bib","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"2c733ef2b791070eea52024a01836239af096a74d88c91a64c062ab51e86b6e5","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/kik_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":52,"content":[{"type":"verse","number":1,"content":[{"text":"Arahũka, arahũka, wee Zayuni,","poem":1},{"text":"wĩĩkĩre hinya.","poem":2},{"text":"Ĩkĩra nguo ciaku iria irĩ riiri,","poem":1},{"text":"o wee Jerusalemu, itũũra rĩrĩa inene na rĩamũre.","poem":2},{"text":"Nĩgũkorwo kuuma rĩu thĩinĩ waku","poem":1},{"text":"gũtigacooka gũtoonya mũndũ ũtarĩ mũruu","poem":2},{"lineBreak":true},{"text":"kana mũndũ ũrĩ na thaahu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wĩribaribe rũkũngũ;","poem":1},{"text":"ũkĩra, ũikarĩre gĩtĩ kĩa ũnene, wee Jerusalemu.","poem":2},{"text":"Wĩohore mĩnyororo ĩyo ĩrĩ ngingo yaku,","poem":1},{"text":"wee mwarĩ wa Zayuni, o wee ũtũire ũrĩ muohe.","poem":2}]},{"type":"verse","number":3,"content":["Nĩgũkorwo Jehova ekuuga atĩrĩ:",{"text":"“Wee wendirio ũtarutĩirwo kĩndũ,","poem":1},{"text":"na ũgaakũũrwo ũtarutĩirwo mbeeca.”","poem":2}]},{"type":"verse","number":4,"content":["Nĩgũkorwo Mwathani Jehova ekuuga atĩrĩ:",{"text":"“Tene andũ akwa maikũrũkire bũrũri wa Misiri","poem":1},{"text":"magĩthiĩ gũtũũra marĩ ageni kuo;","poem":2},{"lineBreak":true},{"text":"thuutha ũyũ andũ a Ashuri nĩmamahinyĩrĩirie.”","poem":2}]},{"type":"verse","number":5,"content":["Jehova ekũũria atĩrĩ, “Rĩu-rĩ, nĩ kĩĩ ndĩ nakĩo?",{"text":"“Nĩgũkorwo andũ akwa maatahirwo o ũguo tũhũ,","poem":1},{"text":"nao andũ arĩa mamaathaga no kũmanyũrũria.","poem":2},{"text":"Narĩo rĩĩtwa rĩakwa rĩcambagio hĩndĩ ciothe,”","poem":1},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"verse","number":6,"content":[{"text":"“Nĩ ũndũ ũcio andũ akwa nĩmakamenya rĩĩtwa rĩakwa;","poem":1},{"text":"mũthenya ũcio nĩmakamenya","poem":2},{"text":"atĩ nĩ niĩ ndaaririe ũhoro ũcio o tene.","poem":1},{"text":"Ĩĩ nĩguo, nĩ niĩ ndawaririe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kaĩ magũrũ ma mũndũ ũrĩa ũrarehe ũhoro mwega,","poem":1},{"text":"nĩmagĩrĩire kũu irĩma-inĩ igũrũ-ĩ,","poem":2},{"text":"o ũcio ũrahunjanĩria ũhoro wa thayũ,","poem":1},{"text":"na akarehe ũhoro mwega wa maũndũ magĩrĩru,","poem":2},{"lineBreak":true},{"text":"o na akahunjanĩria ũhoro wa kũhonokania,","poem":2},{"text":"o we ũrĩa ũreera Zayuni atĩrĩ,","poem":1},{"text":"“Ngai waku nĩwe ũrathamaka!”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Atĩrĩrĩ, ta thikĩrĩria! Arangĩri aku nĩmaranĩrĩra;","poem":1},{"text":"maranĩrĩra nĩ gũkena marĩ hamwe.","poem":2},{"text":"Rĩrĩa Jehova agaacooka Zayuni,","poem":1},{"text":"nĩmakeyonera na maitho mao.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Atĩrĩrĩ, inyuĩ kũndũ kũrĩa kwanangĩtwo kwa Jerusalemu,","poem":1},{"text":"ambĩrĩriai kũina nyĩmbo cia gĩkeno,","poem":2},{"text":"nĩgũkorwo Jehova nĩahooreretie andũ ake,","poem":1},{"text":"na agakũũra Jerusalemu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Jehova nĩakaguũria guoko gwake gũtheru","poem":1},{"text":"harĩ ndũrĩrĩ ciothe, ikuone na maitho mao,","poem":2},{"text":"nacio ituri ciothe cia thĩ nĩcikoona","poem":1},{"text":"ũhonokanio wa Ngai witũ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Eherai, eherai, umai kũu!","poem":1},{"text":"Mũtikahutie kĩndũ kĩrĩ thaahu!","poem":2},{"text":"Umai kũu na mwĩtherie,","poem":1},{"text":"inyuĩ mũkuuaga indo cia Jehova.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"No rĩrĩ, mũtikoima na ihenya,","poem":1},{"text":"kana mũthiĩ mũhanyũkĩte;","poem":2},{"text":"nĩgũkorwo Jehova nĩwe ũkaamũtongoria,","poem":1},{"text":"Ngai wa Isiraeli nĩwe ũkaamuuma thuutha, amũgitĩre.","poem":2}]},{"type":"heading","content":["Ndungata Gũthĩĩnĩka"]},{"type":"verse","number":13,"content":[{"text":"Atĩrĩrĩ, ndungata yakwa ĩgeekaga maũndũ na ũũgĩ;","poem":1},{"text":"nĩĩkambarario na yambatĩrio, o na ĩtũũgĩrio mũno.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"O ta ũrĩa andũ aingĩ maagegirio mũno nĩ ũndũ wake,","poem":1},{"text":"tondũ gĩthiithi gĩake nĩgĩathũkĩtio mũno, gĩgakĩra kĩa mũndũ o wothe,","poem":2},{"lineBreak":true},{"text":"na mũhianĩre wake ũgathũkio gũkĩra mũhianĩre wa andũ,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ũguo noguo akaamakia ndũrĩrĩ nyingĩ,","poem":1},{"text":"nao athamaki nĩmagatumia tũnua twao nĩ ũndũ wake.","poem":2},{"text":"Nĩgũkorwo maũndũ marĩa materĩtwo, nĩmakamoona,","poem":1},{"text":"na maũndũ marĩa mataiguĩte, nĩmakamenya ũhoro wamo.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}