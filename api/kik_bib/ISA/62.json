{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"ISA","translationId":"kik_bib","name":"Isaia","commonName":"Isaia","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"2c733ef2b791070eea52024a01836239af096a74d88c91a64c062ab51e86b6e5","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/kik_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":62,"content":[{"type":"heading","content":["Rĩĩtwa Rĩerũ rĩa Zayuni"]},{"type":"verse","number":1,"content":[{"text":"Ha ũhoro wa kũrũĩrĩra Zayuni-rĩ, ndigakira,","poem":1},{"text":"o na kana ndigithĩrie gũtetera Jerusalemu,","poem":2},{"text":"nginya hĩndĩ ĩrĩa ũthingu wake ũkaara o ta ũtheri wa rũciinĩ,","poem":1},{"text":"naguo ũhoro wake wa kũhonokio wonekane o ta tawa ũrĩa ũrĩrĩmbũkaga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndũrĩrĩ nĩikoona ũthingu waku,","poem":1},{"text":"nao athamaki othe mone riiri waku;","poem":2},{"text":"nawe ũgeetagwo na rĩĩtwa rĩerũ,","poem":1},{"text":"rĩrĩa rĩkaagwetwo na kanua ka Jehova.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ningĩ ũgaatuĩka ta tanji ya ũthaka","poem":1},{"text":"ũnyiitĩtwo guoko-inĩ kwa Jehova,","poem":2},{"text":"na ũhaana ta thũmbĩ ya ũthamaki","poem":1},{"text":"ĩnyiitĩtwo guoko-inĩ kwa Ngai waku.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wee ndũgacooka gwĩtwo Mũtiganĩrie,","poem":1},{"text":"kana bũrũri waku wĩtwo Mũkiri-Ihooru.","poem":2},{"text":"No rĩrĩ, ũrĩĩtagwo Hefiziba,","poem":1},{"text":"na bũrũri waku wĩtagwo Beula;","poem":2},{"text":"nĩgũkorwo Jehova nĩagakenagio nĩwe,","poem":1},{"text":"naguo bũrũri waku ũgaatuĩka o ta mũhiki ũhikĩtio.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"O ta ũrĩa mwanake ahikagia mũirĩtu,","poem":1},{"text":"ũguo noguo ariũ aku magaakũhikia;","poem":2},{"text":"na o ta ũrĩa mũhikania akenagĩrĩra mũhiki wake,","poem":1},{"text":"ũguo noguo Ngai waku agaagũkenerera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nĩnjigĩte arangĩri a thingo ciaku, wee Jerusalemu,","poem":1},{"text":"nao matigakira mũthenya kana ũtukũ.","poem":2},{"text":"Inyuĩ arĩa mũkayagĩra Jehova-rĩ,","poem":1},{"text":"mũtikanahurũke,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"o na kana mũmũhe ũhurũko nginya rĩrĩa akahaanda Jerusalemu,","poem":1},{"text":"na arĩtue itũũra rĩrĩ igweta thĩ yothe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Jehova nĩehĩtĩte ambararĩtie guoko gwake kwa ũrĩo,","poem":1},{"text":"na akehĩta na guoko gwake kũrĩ hinya, akoiga atĩrĩ:","poem":2},{"text":"“Ndigacooka kũhe thũ ciaku ngano yaku","poem":1},{"text":"ĩtuĩke irio ciao,","poem":2},{"text":"na gũtirĩ hĩndĩ ĩngĩ andũ a kũngĩ makaanyua ndibei ya mũhihano","poem":1},{"text":"ĩrĩa wee ũrutĩire wĩra;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"no rĩrĩ, andũ arĩa marĩgethaga ngano nĩo marĩmĩrĩĩaga,","poem":1},{"text":"na magoocage Jehova,","poem":2},{"text":"nao arĩa monganagia thabibũ nĩo marĩnyuuaga ndibei yacio","poem":1},{"text":"maikarĩte nja ya handũ hakwa harĩa haamũre.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Hĩtũkĩrai, mũhĩtũkĩre ihingo-inĩ, mumagare!","poem":1},{"text":"Thondekerai andũ njĩra.","poem":2},{"text":"Akaai, mwake njĩra njariĩ!","poem":1},{"text":"Ũnganiai mahiga, mũmeherie kuo.","poem":2},{"text":"Ambarariai bendera na igũrũ nĩguo yonwo nĩ ndũrĩrĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Jehova nĩanĩrĩire ũhoro ũyũ","poem":1},{"text":"ituri-inĩ ciothe cia thĩ, akoiga atĩrĩ:","poem":2},{"text":"“Ĩrai Mwarĩ wa Zayuni ũũ,","poem":1},{"text":"‘Atĩrĩrĩ ũrĩa ũgaakũhonokia nĩarooka!","poem":2},{"text":"Arooka arĩ na kĩheo gĩake,","poem":1},{"text":"na irĩhi rĩake arĩ o narĩo.’ ”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Acio marĩĩtagwo Andũ arĩa Aamũre,","poem":1},{"text":"o arĩa Jehova Akũũrĩte;","poem":2},{"text":"nawe ũrĩĩtagwo Wa Kwendeka,","poem":1},{"text":"Itũũra-Inene-rĩrĩa-Rĩtagacooka-Gũthaamwo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}