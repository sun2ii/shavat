{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"JER","translationId":"kik_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"17989884b95932aa36d8a178f6b035416cf55caeb126c9185fe9c4377fae3fcc","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/kik_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":["Ningĩ Jehova akĩnjĩĩra atĩrĩ: “O na korwo Musa na Samũeli maarũgama mbere yakwa-rĩ, ngoro yakwa ndĩngĩerekera kũrĩ andũ aya. Maingatei mehere mbere yakwa! Nĩmarekwo mathiĩ!"]},{"type":"verse","number":2,"content":["Nao mangĩkũũria atĩrĩ, ‘Tũgũgĩthiĩ kũ?’ Ũmeere atĩrĩ, ‘Ũũ nĩguo Jehova ekuuga:",{"text":"“ ‘Arĩa maathĩrĩirio gũkua-rĩ, magakue;","poem":1},{"lineBreak":true},{"text":"arĩa maathĩrĩirio kũũragwo na rũhiũ rwa njora-rĩ, makooragwo na rũhiũ rwa njora;","poem":1},{"lineBreak":true},{"text":"arĩa maathĩrĩirio ngʼaragu-rĩ, makooragwo nĩ ngʼaragu;","poem":1},{"lineBreak":true},{"text":"arĩa maathĩrĩirio gũtahwo-rĩ, matahwo matwarwo bũrũri ũngĩ.’","poem":1}]},{"type":"verse","number":3,"content":["“Nĩngamarehithĩria mĩthemba ĩna ya aniinani mamookĩrĩre.” ũguo nĩguo Jehova ekuuga, “Rũhiũ rwa njora rũgooka rũũrage andũ, namo magui mamakururie, nacio nyoni cia rĩera-inĩ, o na nyamũ cia gũkũ thĩ imatambuure, imaniine."]},{"type":"verse","number":4,"content":["Nĩngatũma matuĩke andũ a gũthũũrwo nĩ mothamaki mothe ma gũkũ thĩ, nĩ ũndũ wa ũrĩa Manase mũrũ wa Hezekia mũthamaki wa Juda eekire gũkũ itũũra-inĩ rĩa Jerusalemu."]},{"type":"verse","number":5,"content":[{"text":"“Nũũ ũgaakũiguĩra tha, wee Jerusalemu?","poem":1},{"text":"Nũũ ũgaagũcakaĩra?","poem":2},{"lineBreak":true},{"text":"Nũũ ũgaakerũra gwaku oke akũũrie ũrĩa ũhoro waku ũtariĩ?”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Jehova ekuuga atĩrĩ,","poem":1},{"text":"“Wee nĩũndegete,","poem":2},{"text":"wee ũtũũrĩte ũcookaga na thuutha.","poem":1},{"text":"Nĩ ũndũ ũcio nĩngũgũtambũrũkĩria moko ngũniine;","poem":2},{"lineBreak":true},{"text":"ndingĩĩricũkwo rĩngĩ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nĩngamahuha ta mahuti makĩhuhwo na gĩtarũrũ","poem":1},{"text":"ihingo-inĩ cia itũũra inene rĩa bũrũri.","poem":2},{"text":"Nĩngarehe gĩkuũ na mwanangĩko kũrĩ andũ akwa,","poem":1},{"text":"nĩgũkorwo nĩmagĩte kũgarũrĩra mĩthiĩre yao.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nĩngatũma atumia ao a ndigwa maingĩhe,","poem":1},{"text":"makĩre mũthanga wa iria-inĩ.","poem":2},{"text":"Nĩngarehithia mũniinani hĩndĩ ya mĩaraho","poem":1},{"text":"okĩrĩre manyina ma aanake ao;","poem":2},{"text":"ngaamarehera ruo rũnene","poem":1},{"text":"na makorererwo nĩ kĩeha kĩnene o rĩmwe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nyina wa ciana mũgwanja","poem":1},{"text":"nĩakaringĩka, akue.","poem":2},{"text":"Nĩagathũĩrĩrwo nĩ riũa kũrĩ o mũthenya barigici;","poem":1},{"text":"nĩagaconorithio na anyararwo.","poem":2},{"text":"Arĩa magaatigara ngaamaneana kũrĩ thũ ciao,","poem":1},{"text":"maniinwo na rũhiũ rwa njora,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Wũi-ĩiya-wakwa maitũ-ĩ, wee wanjiarire!","poem":1},{"text":"Nduĩkĩte mũndũ wa kũgianagwo na kũhũũranagwo na niĩ nĩ bũrũri wothe!","poem":2},{"text":"Niĩ ndikombithĩtie kana ngakomberwo kĩndũ nĩ mũndũ,","poem":1},{"text":"no numagwo nĩ andũ othe.","poem":2}]},{"type":"verse","number":11,"content":["Jehova oigĩte atĩrĩ,",{"text":"“Ti-itherũ nĩngagũkũũra ndĩ na muoroto mwega harĩwe;","poem":1},{"text":"ti-itherũ nĩngatũma thũ ciaku igũthaithe mahinda ma mwanangĩko","poem":2},{"lineBreak":true},{"text":"na mahinda ma mĩnyamaro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Mũndũ no oine kĩgera:","poem":1},{"text":"kĩgera kĩrĩa kiumĩte gathigathini,","poem":2},{"lineBreak":true},{"text":"kana oine gĩcango?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nĩnganeana ũtonga waku na igĩĩna ciaku","poem":1},{"text":"itahwo hatarĩ irĩhi,","poem":2},{"text":"nĩ ũndũ wa mehia maku mothe","poem":1},{"text":"marĩa maneekwo bũrũri-inĩ waku wothe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nĩngamũtua ngombo cia thũ cianyu","poem":1},{"text":"thĩinĩ wa bũrũri mũtooĩ,","poem":2},{"text":"nĩ ũndũ marakara makwa","poem":1},{"text":"nĩmagaakana ta mwaki, ũmũcine.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Wee Jehova-rĩ, nĩwe ũũĩ;","poem":1},{"text":"ndirikana na ũũmenyagĩrĩre.","poem":2},{"lineBreak":true},{"text":"Ndĩhĩria kũrĩ arĩa maanyariiraga.","poem":2},{"text":"Wee nĩũkiragĩrĩria; ndũkanjeherie;","poem":1},{"text":"ririkana ũrĩa ndananyariirĩka nĩ ũndũ waku.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Rĩrĩa ciugo ciaku cianginyĩrĩire-rĩ, nĩndacirĩire;","poem":1},{"text":"ciarĩ gĩkeno gĩakwa, na igĩcanjamũra ngoro yakwa,","poem":2},{"text":"nĩgũkorwo nĩnjĩtanĩtio na rĩĩtwa rĩaku,","poem":1},{"text":"Wee Jehova Ngai-Mwene-Hinya-Wothe.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ndirĩ ndaikara thiritũ-inĩ ya arĩa mekenagia,","poem":1},{"text":"o na kana ngĩĩkenia magĩĩkenia;","poem":2},{"text":"ndaikarire ndĩ wiki nĩ ũndũ guoko gwaku kwarĩ igũrũ rĩakwa,","poem":1},{"text":"nawe nĩwanjiyũrĩtie marakara.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nĩ kĩĩ gĩtũmĩte ruo rwakwa rwage gũthira,","poem":1},{"text":"na kĩronda gĩakwa gĩkeeha, gĩkaaga kũhona?","poem":2},{"text":"Anga ũgũtuĩka harĩ niĩ ta karũũĩ gatangĩĩhokwo,","poem":1},{"text":"kana ta gĩthima kĩa maaĩ kĩrĩa kĩhũũaga?","poem":2}]},{"type":"verse","number":19,"content":["Nĩ ũndũ ũcio Jehova ekuuga atĩrĩ:",{"text":"“Ũngĩĩrira, nĩngũgũcookereria","poem":1},{"text":"nĩgeetha ũndungatagĩre;","poem":2},{"text":"akorwo nĩũrĩaragia maũndũ marĩa marĩ bata,","poem":1},{"text":"no ti marĩa matarĩ bata,","poem":2},{"lineBreak":true},{"text":"nĩũgũtuĩka wa kũnjarĩrĩria.","poem":2},{"text":"Andũ aya nĩmagũcookerere,","poem":1},{"text":"no wee ndũkamacookerere.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nĩngagũtua ta rũthingo harĩ andũ aya,","poem":1},{"text":"ngũtue rũthingo rũrũmu rwa gĩcango;","poem":2},{"text":"nĩmakarũa nawe,","poem":1},{"text":"no matigagũtooria,","poem":2},{"text":"nĩgũkorwo niĩ ndĩ hamwe nawe,","poem":1},{"text":"nĩguo ngũteithũre na ngũhonokie,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"verse","number":21,"content":[{"text":"“Nĩngakũhonokia kuuma moko-inĩ ma andũ arĩa aaganu,","poem":1},{"text":"na ngũkũũre ngũrute moko-inĩ ma andũ arĩa matarĩ tha.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/JER/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/JER/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/JER/14.json","previousChapterAudioLinks":{},"numberOfVerses":21}