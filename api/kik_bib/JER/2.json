{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"JER","translationId":"kik_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"17989884b95932aa36d8a178f6b035416cf55caeb126c9185fe9c4377fae3fcc","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/kik_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":2,"content":[{"type":"heading","content":["Isiraeli Gũtirika Ngai"]},{"type":"verse","number":1,"content":["Ningĩ ndũmĩrĩri ya Jehova nĩyanginyĩrire, ngĩĩrwo atĩrĩ:"]},{"type":"verse","number":2,"content":["“Thiĩ ũkaanĩrĩre ũkĩiguagwo nĩ andũ a Jerusalemu, ũmeere atĩrĩ:",{"text":"“ ‘Nĩndirikanaga ũrĩa weheanĩte kũrĩ niĩ rĩrĩa warĩ mwĩthĩ,","poem":1},{"text":"na ũrĩa wanyendete rĩrĩa ndakũhikirie","poem":2},{"text":"na ũkĩnũmĩrĩra kũu werũ-inĩ,","poem":1},{"text":"tũgĩtuĩkanĩria kũu bũrũri ũcio ũtaahandagwo irio.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isiraeli-rĩ, aatũũrĩte aamũrĩirwo Jehova,","poem":1},{"text":"arĩ maciaro ma mbere ma magetha make;","poem":2},{"text":"arĩa othe maamũtambuuraga maatuirwo ahĩtia,","poem":1},{"text":"nao magĩkinyĩrĩrwo nĩ mwanangĩko,’ ”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Thikĩrĩriai mũigue ndũmĩrĩri ya Jehova, inyuĩ andũ a nyũmba ya Jakubu,","poem":1},{"text":"inyuĩ inyuothe andũ a mĩhĩrĩga yothe ya nyũmba ya Isiraeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Jehova ekuuga atĩrĩ:","poem":2},{"text":"“Nĩ mahĩtia marĩkũ maithe manyu maanyonire namo,","poem":1},{"text":"atĩ nĩkĩo maandirikire, makĩndaihĩrĩria ũguo?","poem":2},{"text":"Maarũmĩrĩire mĩhianano ĩtarĩ kĩene,","poem":1},{"text":"nao ene makĩaga kĩene.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Matiigana kũũria atĩrĩ: ‘Jehova arĩ ha,","poem":1},{"text":"ũrĩa watũrutire bũrũri wa Misiri,","poem":2},{"text":"agĩtũgereria werũ-inĩ ũtaarĩ kĩndũ,","poem":1},{"text":"tũkĩgerera bũrũri warĩ wa werũ na iharũrũka,","poem":2},{"text":"bũrũri ũtoiraga mbura, na warĩ nduma ta ya gĩkuũ,","poem":1},{"text":"bũrũri ũtaageragĩrwo na ũtaatũũragwo nĩ mũndũ?’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nĩndamũrehire bũrũri mũnoru,","poem":1},{"text":"nĩguo mũrĩĩage matunda maguo,","poem":2},{"lineBreak":true},{"text":"na mwĩgune na indo ciakuo iria njega.","poem":2},{"text":"No inyuĩ muokire, mũgĩthaahia bũrũri wakwa","poem":1},{"text":"na mũgĩtũma igai rĩakwa rĩthũũrwo mũno.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Athĩnjĩri-Ngai matiigana kũũria atĩrĩ:","poem":1},{"text":"‘Jehova arĩ ha?’","poem":2},{"text":"Arĩa marũmbũyagia watho matiigana kũũmenya;","poem":1},{"text":"atongoria ao nĩmanemeire.","poem":2},{"text":"Anabii maarathaga mohoro makĩgwetaga Baali,","poem":1},{"text":"marũmĩrĩire mĩhianano ĩtarĩ kĩene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Nĩ ũndũ ũcio nĩngũmũciirithia o rĩngĩ,”","poem":1},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4},{"text":"“Ningĩ nĩngaciirithia ciana cia ciana cianyu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ringai mũthiĩ hũgũrũrũ-inĩ cia Kitimu mũkerorere,","poem":1},{"text":"ningĩ mũtũmane gũthiio Kedari gũgatuĩrio wega,","poem":2},{"noteId":1},{"lineBreak":true},{"text":"muone kana kũrĩ kuoneka ũndũ ta ũyũ:","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Atĩrĩrĩ, nĩ kũrĩ rũrĩrĩ rũrĩ rwatirika ngai ciaruo, rũkĩgarũrũkĩra ngai ingĩ?","poem":1},{"text":"(O na harĩa ngai icio itarĩ ngai.)","poem":2},{"text":"No rĩrĩ, andũ akwa nĩmakũũranĩtie Riiri wao","poem":1},{"text":"na mĩhianano ĩtarĩ kĩene.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Inyuĩ igũrũ-rĩ, makaai nĩ ũndũ wa ũhoro ũcio,","poem":1},{"text":"inainai mũrĩ na kĩeha kĩnene,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"“Andũ akwa nĩmekĩte mehia meerĩ:","poem":1},{"lineBreak":true},{"text":"Nĩmandirikĩte,","poem":1},{"text":"o niĩ gĩthima kĩa maaĩ ma muoyo,","poem":2},{"text":"na makeyenjera marima mangĩ ma maaĩ,","poem":1},{"text":"namo nĩ marima mamethũkangu, matangĩiga maaĩ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Rĩu-rĩ, anga Isiraeli nĩ ndungata, o mũndũ ũciarĩirwo ũkombo-inĩ?","poem":1},{"text":"Nĩ kĩĩ gĩtũmĩte atuĩke mũndũ wa gũtahwo?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mĩrũũthi nĩĩraramĩte;","poem":1},{"text":"nĩĩmũraramĩire.","poem":2},{"text":"Nĩyanangĩte bũrũri wake;","poem":1},{"text":"matũũra make macinĩtwo na mwaki, na magatigwo matarĩ mũndũ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"O na andũ a Memufisi, na a Tahapanahesi","poem":1},{"text":"nĩmagũtiihĩtie, magagwĩkĩra rũhara ruototia rwa mũtwe.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Githĩ tiwe mwene wĩrehereire maũndũ maya","poem":1},{"text":"nĩ ũndũ wa gũtirika Jehova Ngai waku,","poem":2},{"lineBreak":true},{"text":"o rĩrĩa we aagũtongoragia na njĩra ĩrĩa wageraga?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Rĩu-rĩ, nĩ kĩĩ gĩgũtũma ũcooke bũrũri wa Misiri","poem":1},{"text":"ũkanyue maaĩ ma Shihoru?","poem":2},{"text":"Na ningĩ-rĩ, ũgũthiĩ Ashuri nĩkĩ,","poem":1},{"text":"ũkanyue maaĩ ma Rũũĩ rwa Farati?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Waganu waku nĩguo ũgaakũherithia,","poem":1},{"text":"nakuo gũcooka na thuutha gwaku nĩgũgakũrũithia.","poem":2},{"text":"Tondũ ũcio wĩciirie wega na ũmenye","poem":1},{"text":"ũrĩa arĩ ũndũ mũũru mũno na ũrĩ ruo harĩwe,","poem":2},{"text":"rĩrĩa ũtirikĩte Jehova Ngai waku,","poem":1},{"text":"na rĩrĩa ũkwaga kwĩĩndigĩra,”","poem":2},{"text":"ũguo nĩguo Mwathani, o we Jehova Mwene-Hinya-Wothe, ekuuga.","poem":4}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Nĩwoinangire icooki rĩaku rĩa ngingo o tene,","poem":1},{"text":"na ũgĩtuuanga mĩhĩndo yaku;","poem":2},{"lineBreak":true},{"text":"woigire atĩrĩ, ‘Ndigũcooka gũgũtungata!’","poem":2},{"text":"Tondũ-rĩ, tũrĩma-inĩ tũrĩa tuothe tũraihu na igũrũ,","poem":1},{"text":"na rungu rwa mũtĩ o wothe mũruru","poem":2},{"lineBreak":true},{"text":"nĩkuo wakomaga ũkĩhũũra ũmaraya.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Niĩ ndaakũhaandĩte ũrĩ ta mũthabibũ mũthuuranĩre","poem":1},{"text":"wa mũthemba ũrĩa mwega.","poem":2},{"text":"Wagĩcookire kũngarũrũka atĩa,","poem":1},{"text":"ũgĩthũka, ũgĩtuĩka ta mũthabibũ wa gĩthaka?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"O na ũngĩĩthamba na igata,","poem":1},{"text":"o na ũhũthĩre thabuni mũingĩ mũno-rĩ,","poem":2},{"lineBreak":true},{"text":"kĩmeni kĩa wĩhia waku ndingĩtiga gũkĩona,”","poem":2},{"text":"ũguo nĩguo Mwathani Jehova ekuuga.","poem":4}]},{"type":"verse","number":23,"content":[{"text":"“Rĩu-rĩ, ũngĩhota atĩa kuuga atĩrĩ: ‘Niĩ ndiĩthaahĩtie;","poem":1},{"text":"ndirũmĩrĩire kĩrĩra kĩa Mabaali’?","poem":2},{"text":"Ta rora wone mĩtugo yaku kũu gĩtuamba-inĩ;","poem":1},{"text":"wĩcũũranie wega maũndũ marĩa wĩkĩte.","poem":2},{"text":"Wee ũhaana ta moori ya ngamĩĩra","poem":1},{"text":"ĩgĩcangacanga kũndũ na kũndũ,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ũkahaana ta njagĩ ĩrĩa ĩmenyerete gũikara werũ-inĩ,","poem":1},{"text":"ĩrĩa ĩnuhanuhaga rĩrĩa ĩkwenda kũhaicwo;","poem":2},{"lineBreak":true},{"text":"rĩrĩa ĩrĩ na mũrukĩ-rĩ, nũũ ũngĩhota kũmĩrigĩrĩria?","poem":2},{"text":"Njamba iria ingĩmĩenda, itingĩĩnogia ikĩmĩcaria;","poem":1},{"text":"mweri wayo wakinya, nĩikamĩona.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Tiga kũhanyũka nginya ũthirĩrwo nĩ iraatũ magũrũ,","poem":1},{"text":"naguo mũmero waku ũngʼare.","poem":2},{"text":"No wee ũkiuga atĩrĩ, ‘Hatirĩ bata!","poem":1},{"text":"nĩnyendete ngai cia kũngĩ,","poem":2},{"lineBreak":true},{"text":"na no nginya ndĩciume thuutha.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“O ta ũrĩa mũici aconorithagio aanyiitwo,","poem":1},{"text":"ũguo no taguo nyũmba ĩno ya Isiraeli ĩconorithĩtio:","poem":2},{"text":"o ene, na athamaki ao, na anene ao,","poem":1},{"text":"na athĩnjĩri-Ngai ao, na anabii ao.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Meeraga mũtĩ atĩrĩ, ‘Wee nĩwe Baba,’","poem":1},{"text":"na makeera ihiga atĩrĩ, ‘Wee nĩwe wanjiarire.’","poem":2},{"text":"Nĩmahutatĩire,","poem":1},{"text":"makaaga kũnyonia mothiũ mao;","poem":2},{"text":"no rĩrĩa marĩ thĩĩna-inĩ manjĩĩraga atĩrĩ,","poem":1},{"text":"‘Ũka ũtũhonokie!’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ikĩrĩ kũ ngai icio mwethondekeire?","poem":1},{"text":"Kĩrekei ciũke, aakorwo no imũhonokie","poem":2},{"lineBreak":true},{"text":"rĩrĩa mũrĩ thĩĩna-inĩ!","poem":2},{"text":"Nĩgũkorwo ngai ciaku cingĩhĩte","poem":1},{"text":"o ta matũũra maku, wee Juda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Mũgũkĩndũithia nĩ ũndũ kĩ?","poem":1},{"text":"Inyuothe nĩmũũnemeire,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"verse","number":30,"content":[{"text":"“Nĩ wĩra wa tũhũ ndaarutire ngĩherithia andũ anyu;","poem":1},{"text":"matiigana kũigua maakaanio magarũrũke.","poem":2},{"text":"Rũhiũ rwaku rwa njora nĩrũniinĩte anabii anyu,","poem":1},{"text":"o ta mũrũũthi ũrĩa mũrĩĩani.","poem":2}]},{"type":"verse","number":31,"content":["“Atĩrĩrĩ, inyuĩ andũ a rũciaro rũrũ, mwĩcũraniei wega ũhoro wa ndũmĩrĩri ĩno ya Jehova:",{"text":"“Kaĩ nduĩkĩte ta werũ harĩ Isiraeli,","poem":1},{"text":"kana ta bũrũri ũrĩ nduma nene?","poem":2},{"text":"Nĩ kĩĩ gĩtũmaga andũ akwa moige atĩrĩ,","poem":1},{"text":"‘Ithuĩ tũrĩĩkaga ũrĩa tũkwenda;","poem":2},{"lineBreak":true},{"text":"tũtigagũcookerera rĩngĩ’?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Rĩu-rĩ, mũirĩtu ahota kũriganĩrwo nĩ mathaga make ma kwĩgemia,","poem":1},{"text":"kana mũhiki ariganĩrwo nĩ nguo ciake cia ũhiki?","poem":2},{"text":"No rĩrĩ, andũ akwa nĩmariganĩirwo nĩ niĩ,","poem":1},{"text":"matukũ maingĩ matangĩtarĩka.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Kaĩ nĩ ũrĩ ũũgĩ mũingĩ rĩrĩa ũgũcaria wendo-ĩ!","poem":1},{"text":"Nĩ ũndũ ũcio o na atumia arĩa aaganu mũno","poem":2},{"lineBreak":true},{"text":"no merute na mĩthiĩre yaku.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Nguo-inĩ ciaku-rĩ, andũ nĩmoonaga","poem":1},{"text":"thakame ya athĩĩni arĩa matarĩ ũũru mekĩte,","poem":2},{"lineBreak":true},{"text":"o na aakorwo ndwamanyiitire magĩtua nyũmba.","poem":2},{"text":"No rĩrĩ, o na gũtariĩ ũguo","poem":1}]},{"type":"verse","number":35,"content":[{"text":"wee uugaga atĩrĩ, ‘Niĩ ndirĩ ũndũ mũũru njĩkĩte;","poem":2},{"lineBreak":true},{"text":"we ndandaakarĩire.’","poem":2},{"text":"No niĩ nĩngũgũtuĩra ciira,","poem":1},{"text":"tondũ uugaga atĩrĩ, ‘Niĩ ndiĩhĩtie.’","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ũriũngariũngaga nĩkĩ,","poem":1},{"text":"ũkĩgarũraga mĩthiĩre yaku?","poem":2},{"text":"Nĩũgaconorithio nĩ bũrũri wa Misiri,","poem":1},{"text":"o ta ũrĩa waconorithirio nĩ Ashuri.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Ũgaacooka uume kũndũ kũu","poem":1},{"text":"ũigĩrĩire moko mũtwe,","poem":2},{"text":"nĩgũkorwo Jehova nĩaregete acio wĩhokete,","poem":1},{"text":"o matigagũteithia.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":1,"caller":"+","text":"Kitimu ũmũthĩ nĩ Kuporo hamwe na ndwere-inĩ cia mwena wa ithũĩro, nakuo Kedari nĩkuo iruka cia Beduni ciatũũraga.","reference":{"chapter":2,"verse":10}}]},"thisChapterLink":"/api/kik_bib/JER/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/JER/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/JER/1.json","previousChapterAudioLinks":{},"numberOfVerses":37}