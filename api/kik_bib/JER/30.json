{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"JER","translationId":"kik_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"17989884b95932aa36d8a178f6b035416cf55caeb126c9185fe9c4377fae3fcc","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/kik_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":30,"content":[{"type":"heading","content":["Gũcookererio kwa Isiraeli"]},{"type":"verse","number":1,"content":["Ĩno nĩyo ndũmĩrĩri ĩrĩa yakinyĩrĩire Jeremia yumĩte kũrĩ Jehova:"]},{"type":"verse","number":2,"content":["“Jehova, Ngai wa Isiraeli, ekuuga atĩrĩ: ‘Andĩka ũhoro ũrĩa wothe ngwarĩirie ibuku-inĩ.’"]},{"type":"verse","number":3,"content":["Tondũ Jehova ekuuga atĩrĩ, ‘Matukũ nĩmarooka, rĩrĩa ngaarehe andũ akwa a Isiraeli na a Juda moime kũrĩa maatwarirwo maatahwo na ndĩmacookie bũrũri ũrĩa ndaheire maithe mao mawĩgwatĩre,’ ũguo nĩguo Jehova ekuuga.”"]},{"type":"verse","number":4,"content":["Ũyũ nĩguo ũhoro ũrĩa Jehova aaririe ũkoniĩ Isiraeli na Juda:"]},{"type":"line_break"},{"type":"verse","number":5,"content":["“Jehova ekuuga atĩrĩ:",{"text":"“ ‘Nĩtũiguĩte mũkayũrũrũko wa kũmakania,","poem":1},{"text":"wa itua-nda, no ti wa thayũ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ta tuĩriai ũhoro, muone:","poem":1},{"text":"Hihi mũndũ mũrũme no ahote gũciara mwana?","poem":2},{"text":"Nĩ kĩĩ kĩragĩtũma nyone arũme othe arĩa marĩ hinya","poem":1},{"text":"menyiitĩte nda ta mũtumia ũkũrũmwo,","poem":2},{"lineBreak":true},{"text":"na o mũndũ akagarũrũka agatukia gĩthiithi?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kaĩ mũthenya ũcio nĩũgakorwo ũrĩ mũrũrũ-ĩ!","poem":1},{"text":"Gũtirĩ ũngĩ ũkahaana taguo.","poem":2},{"text":"Gũgaakorwo kũrĩ ihinda rĩa kũnyariirĩka rĩa Jakubu,","poem":1},{"text":"no nĩakahonokio kuuma harĩ guo.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Jehova Mwene-Hinya-Wothe ekuuga atĩrĩ,","poem":1},{"text":"‘Mũthenya ũcio nĩngoinanga icooki rĩu","poem":2},{"lineBreak":true},{"text":"ndĩrĩeherie ngingo-inĩ ciao,","poem":2},{"text":"na nduuange nga iria mohetwo nacio;","poem":1},{"text":"nacio ndũrĩrĩ itigacooka kũmatua ngombo ciao rĩngĩ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Handũ ha ũguo, magaatungatagĩra Jehova Ngai wao,","poem":1},{"text":"na Daudi mũthamaki wao,","poem":2},{"lineBreak":true},{"text":"ũrĩa niĩ ngaamarahũrĩra.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘Nĩ ũndũ ũcio tiga gwĩtigĩra, wee Jakubu ndungata yakwa;","poem":1},{"text":"tiga kũmaka, wee Isiraeli,’","poem":2},{"text":"nĩguo Jehova ekuuga.","poem":4},{"text":"‘Ti-itherũ nĩngakũhonokia ngũrute kũu kũraya,","poem":1},{"text":"na njiaro ciaku ndĩcirute bũrũri ũrĩa maathaamĩirio.","poem":2},{"text":"Jakubu nĩagacookererwo nĩ thayũ o na ũgitĩri,","poem":1},{"text":"na gũtirĩ mũndũ o na ũmwe ũgaatũma etigĩre.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndĩ hamwe nawe na nĩngakũhonokia,’","poem":1},{"text":"ũguo nĩguo Jehova ekuuga.","poem":2},{"text":"‘O na ingĩniina ndũrĩrĩ ciothe","poem":1},{"text":"cia kũrĩa guothe ngũharaganĩirie,","poem":2},{"lineBreak":true},{"text":"wee ndigakũniina biũ.","poem":2},{"text":"No nĩngakũherithia na kĩhooto;","poem":1},{"text":"ndikaareka ũthiĩ o ro ũguo itakũherithĩtie.’","poem":2}]},{"type":"verse","number":12,"content":["“Nĩ ũndũ Jehova ekuuga atĩrĩ:",{"text":"“ ‘Kĩronda gĩaku gĩtingĩhona,","poem":1},{"text":"nguraro ciaku itirĩ kĩhonia.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hatirĩ na wa gũgũthaithanĩrĩra,","poem":1},{"text":"kana ndawa ya kĩronda gĩaku,","poem":2},{"lineBreak":true},{"text":"o na kana gĩa gũkũhonia.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Athiritũ aku othe nĩmariganĩirwo nĩwe;","poem":1},{"text":"ndũrĩ kĩene harĩo.","poem":2},{"text":"Ngũgũthĩte o ta ũrĩa thũ ĩngĩkũgũtha,","poem":1},{"text":"na ngaakũherithia o ta ũrĩa mũndũ ũtarĩ tha aherithanagia,","poem":2},{"text":"nĩ ũndũ mahĩtia maku nĩ manene mũno,","poem":1},{"text":"namo mehia maku makaingĩha makĩria.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nĩ kĩĩ kĩratũma ũrĩrĩre kĩronda gĩaku,","poem":1},{"text":"ũkarĩrĩra ruo rwaku rũtarĩ na kĩhonia?","poem":2},{"text":"Nĩ ũndũ wa ũrĩa mahĩtia maku manenehete","poem":1},{"text":"na mehia maku magakĩingĩha rĩ,","poem":2},{"lineBreak":true},{"text":"nĩkĩo ngwĩkĩte maũndũ macio.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“ ‘No rĩrĩ, andũ arĩa othe magaakũngʼaũrania","poem":1},{"text":"o nao nĩmakangʼaũranio;","poem":2},{"lineBreak":true},{"text":"thũ ciaku ciothe nĩigatwarwo ithaamĩrio.","poem":2},{"text":"Arĩa magũtahaga indo ciaku nĩmagatahwo;","poem":1},{"text":"arĩa othe magũtunyaga indo na niĩ nĩngamatunya.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"No nĩngagũcookeria ũgima waku,","poem":1},{"text":"na ngũhonie nguraro ciaku,’","poem":2},{"text":"ũguo nĩguo Jehova ekuuga,","poem":4},{"text":"‘tondũ wĩtagwo mũndũ mũte,","poem":1},{"text":"Zayuni itũũra rĩtarĩ mũndũ ũrĩrũmbũyagia.’","poem":2}]},{"type":"verse","number":18,"content":["“Ũũ nĩguo Jehova ekuuga:",{"text":"“ ‘Nĩngacookia ũgaacĩru wa Jakubu hema-inĩ ciake,","poem":1},{"text":"nacio ciikaro ciake ndĩciiguĩre tha;","poem":2},{"text":"itũũra rĩu inene nĩrĩgaakwo rĩngĩ o kũu rĩanangĩirwo,","poem":1},{"text":"nayo nyũmba ya ũthamaki nĩĩkarũgama harĩa hamĩagĩrĩire.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kuuma kũu nĩgũkaiguuagwo gũkĩinĩrwo nyĩmbo cia gũcookia ngaatho,","poem":1},{"text":"na kũiguuagwo mĩgambo ya gĩkeno.","poem":2},{"text":"Nĩngamaingĩhia","poem":1},{"text":"na matikanyihanyiiha;","poem":2},{"text":"nĩngamaheithia gĩtĩĩo,","poem":1},{"text":"na matikaagithio kĩene.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ciana ciao igaikaraga o ta matukũ-inĩ marĩa ma tene,","poem":1},{"text":"nakĩo kĩrĩndĩ kĩao gĩtũũre kĩrũmĩte wega mbere yakwa;","poem":2},{"lineBreak":true},{"text":"nĩngaherithia arĩa othe mamahinyagĩrĩria.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mũtongoria wao agaakorwo arĩ ũmwe wa andũ ao kĩũmbe;","poem":1},{"text":"o nake mwathi wao akoima o kũu thĩinĩ wa andũ ao.","poem":2},{"text":"Nĩngamũreharehe nake oke hakuhĩ na niĩ,","poem":1},{"text":"nĩ ũndũ-rĩ, nĩ mũndũ ũrĩkũ ũngĩĩrutĩra","poem":2},{"lineBreak":true},{"text":"gũũka hakuhĩ na niĩ?’","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"verse","number":22,"content":[{"text":"‘Nĩ ũndũ ũcio nĩmũgatuĩka andũ akwa,","poem":1},{"text":"na niĩ nduĩke Ngai wanyu.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Atĩrĩrĩ, mangʼũrĩ ma Jehova","poem":1},{"text":"nĩmagatuthũka mahaana ta kĩhuhũkanio;","poem":2},{"text":"ti-itherũ makaahaana ta rũhuho rũkũhurutana mũno,","poem":1},{"lineBreak":true},{"text":"igũrũ rĩa andũ arĩa aaganu.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Marakara mahiũ ma Jehova matigaathira,","poem":1},{"text":"o nginya rĩrĩa akaahingia","poem":2},{"lineBreak":true},{"text":"muoroto wa ngoro yake biũ.","poem":2},{"text":"Matukũ-inĩ marĩa magooka-rĩ,","poem":1},{"text":"nĩmũgataũkĩrwo nĩ ũhoro ũcio wega.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/JER/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/JER/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/JER/29.json","previousChapterAudioLinks":{},"numberOfVerses":24}