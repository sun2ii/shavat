{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"JER","translationId":"kik_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"17989884b95932aa36d8a178f6b035416cf55caeb126c9185fe9c4377fae3fcc","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/kik_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"“Atĩrĩrĩ wee Isiraeli, ũngĩkorwo nĩũgũcooka-rĩ,","poem":1},{"text":"njookerera,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4},{"text":"“Ũngĩeheria mĩhianano ĩyo yaku ĩrĩ magigi,","poem":1},{"text":"na ũtige gũcooka kũũrũũra rĩngĩ,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ningĩ ũngĩrũmia ũhoro wa ma, na ũtuanĩri ciira wa kĩhooto, na wa ũthingu,","poem":1},{"text":"na wĩhĩte ũkiugaga atĩrĩ, ‘Ti-itherũ o ta ũrĩa Jehova atũũraga muoyo,’","poem":2},{"text":"hĩndĩ ĩyo ndũrĩrĩ nĩikarathimwo nĩwe,","poem":1},{"text":"na thĩinĩ wake nĩikaagĩa na riiri.”","poem":2}]},{"type":"verse","number":3,"content":["Atĩrĩrĩ, Jehova areera andũ a Juda, o na andũ a Jerusalemu ũũ:",{"text":"“Cimbai mĩgũnda yanyu ĩrĩa ĩrĩ ngamba,","poem":1},{"text":"na mũtikahaande irio mĩigua-inĩ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mwĩamũrĩrei Jehova,","poem":1},{"text":"na ũndũ wa kũruithia ngoro cianyu","poem":2},{"lineBreak":true},{"text":"inyuĩ andũ aya a Juda, na inyuĩ mũtũũraga Jerusalemu,","poem":2},{"text":"nĩgeetha mangʼũrĩ makwa matigaakane ta mwaki,","poem":1},{"text":"nĩ ũndũ wa ũũru ũrĩa mwĩkĩte,","poem":2},{"lineBreak":true},{"text":"maakane mage mũndũ wa kũmahoria.","poem":2}]},{"type":"heading","content":["Mwanangĩko uumĩte Mwena wa Gathigathini"]},{"type":"verse","number":5,"content":[{"text":"“Anĩrĩrai kũu Juda, na mũhunjie ũhoro kũu Jerusalemu, muuge ũũ:","poem":1},{"text":"‘Huhai tũrumbeta bũrũri-inĩ guothe!’","poem":2},{"text":"Anĩrĩrai na kayũ muuge atĩrĩ:","poem":1},{"text":"‘Mwĩcookanĩrĩriei!","poem":2},{"lineBreak":true},{"text":"Nĩtũũrĩrei matũũra-inĩ marĩa manene mairigĩre!’","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Haandai bendera mũthiĩ mwerekeire Zayuni!","poem":1},{"text":"Mwĩtharei narua mwĩhonokie!","poem":2},{"text":"Nĩgũkorwo nĩndĩrarehithia mwanangĩko uumĩte mwena wa gathigathini,","poem":1},{"text":"o na kũniinanwo kũnene.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mũrũũthi","poem":1},{"noteId":2},{"text":"nĩumĩte kĩmamo-inĩ kĩaguo;","poem":1},{"text":"mũniinani wa kũniina ndũrĩrĩ nĩoimagarĩte.","poem":2},{"text":"Oimĩte gwake","poem":1},{"text":"oke aanange bũrũri waku.","poem":2},{"text":"Matũũra maku makaanangĩka,","poem":1},{"text":"mage mũndũ wa gũtũũra kuo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nĩ ũndũ ũcio-rĩ, mwĩhumbei nguo cia makũnia,","poem":1},{"text":"cakayai na mũrĩre,","poem":2},{"text":"nĩ ũndũ tũtirĩ tũrehererwo","poem":1},{"text":"nĩ mangʼũrĩ macio mahiũ ma Jehova.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Jehova ekuuga atĩrĩ, “Mũthenya ũcio-rĩ,","poem":1},{"text":"mũthamaki na anene ake nĩmagakua ngoro,","poem":2},{"text":"nao athĩnjĩri-Ngai nĩmakagegeara,","poem":1},{"text":"nao anabii mamake.”","poem":2}]},{"type":"verse","number":10,"content":["Hĩndĩ ĩyo ngiuga atĩrĩ: “Hĩ! Mwathani Jehova, ti-itherũ nĩ ta ũkĩheenetie andũ aya biũ, o na ũkaheenia Jerusalemu, nĩ ũndũ wa kũmeera atĩrĩ, ‘Nĩmũkaagĩa na thayũ,’ o rĩrĩa tũigĩrĩirwo rũhiũ rwa njora mĩmero.”"]},{"type":"verse","number":11,"content":["Ihinda rĩu andũ aya o hamwe na Jerusalemu nĩmakeerwo atĩrĩ, “Rũhuho rũhiũ ruumĩte kũndũ kũrĩa gũtarĩ kĩndũ kũu gũtũũgĩru werũ-inĩ nĩrũkahurutana rwerekeire kũrĩ andũ akwa, no rĩrĩ, ti ta rũrĩa rwa kũhuha irio kana rwa gũcitheria;"]},{"type":"verse","number":12,"content":["nĩ rũhuho rũrĩ na hinya kũrĩ rũu ruumĩte kũrĩ niĩ. Rĩu nĩngũmatuĩra matuĩro ma ciira.”"]},{"type":"verse","number":13,"content":[{"text":"Ta rorai muone! Mũndũ ũcio aroka ta matu,","poem":1},{"text":"ngaari ciake cia ita irooka ta kĩhuhũkanio,","poem":2},{"text":"nacio mbarathi ciake ihanyũkaga gũkĩra nderi.","poem":1},{"text":"Ĩiya witũ-ĩ! Tũrĩ aniine biũ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wee Jerusalemu-rĩ, theria ũũru kuuma ngoro-inĩ yaku nĩguo ũhonoke.","poem":1},{"text":"Ũgũtũũra ũthugundaga ũũru meciiria-inĩ maku nginya-rĩ?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nĩ kũrĩ na mũgambo wa mũndũ ũranĩrĩra kũu Dani,","poem":1},{"text":"ũkaanĩrĩra ũhoro wa mwanangĩko kũu irĩma-inĩ cia Efiraimu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Ĩrai ndũrĩrĩ ũhoro ũcio,","poem":1},{"text":"hunjĩriai Jerusalemu muuge atĩrĩ:","poem":2},{"text":"‘Ita inene rĩa gũgũũkĩrĩra nĩrĩroka riumĩte bũrũri wa kũraya,","poem":1},{"text":"na rĩroka na mbugĩrĩrio ya mbaara","poem":2},{"lineBreak":true},{"text":"ya gũũkĩrĩra matũũra mothe manene ma Juda.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Marĩrigiicĩirie o ta andũ marangĩire mũgũnda,","poem":1},{"text":"tondũ itũũra rĩu nĩrĩnemeire, rĩkanjũkĩrĩra,’ ”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"verse","number":18,"content":[{"text":"“Mĩthiĩre yaku mwene na ciĩko ciaku","poem":1},{"text":"nĩcio ikũreheire maũndũ macio.","poem":2},{"text":"Rĩĩrĩ nĩrĩo iherithia rĩaku.","poem":1},{"text":"Na kaĩ nĩ irũrũ-ĩ!","poem":2},{"lineBreak":true},{"text":"Kaĩ nĩrĩgũtheeca ngoro-ĩ!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Wũi, ruo-ĩ, wũi ruo-ĩ!","poem":1},{"text":"Ndĩrenyogonda nĩ ruo.","poem":2},{"text":"Wũi, ruo rũnene ngoro-inĩ yakwa-ĩ!","poem":1},{"text":"Ngoro yakwa nĩĩratumatuuma,","poem":2},{"lineBreak":true},{"text":"ndingĩhota gũkirĩrĩria.","poem":2},{"text":"Nĩgũkorwo nĩnjiguĩte mũgambo wa karumbeta;","poem":1},{"text":"nĩnjiguĩte mbugĩrĩrio ya mbaara.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mwanangĩko ũrarũmanĩrĩra na mwanangĩko;","poem":1},{"text":"bũrũri wothe nĩwanangĩtwo.","poem":2},{"text":"O rĩmwe hema ciakwa nĩthũkangie,","poem":1},{"text":"o kahinda gatarĩ cooho kĩĩgitio gĩakwa gĩgathũkangio.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nĩ nginya rĩ ngũtũũra nyonaga bendera ya mbaara,","poem":1},{"text":"na ngaigua mũgambo wa karumbeta?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Andũ akwa nĩ irimũ;","poem":1},{"text":"matinjũũĩ.","poem":2},{"text":"Nĩ ciana iteciiragia,","poem":1},{"text":"na ikaaga ũmenyo.","poem":2},{"text":"Ũũgĩ ũrĩa marĩ naguo no wa gwĩka ũũru;","poem":1},{"text":"matiũĩ gwĩka wega.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ndaacũthĩrĩirie thĩ,","poem":1},{"text":"ngĩkĩona atĩ ndĩarĩ ũrĩa yatariĩ na ndĩarĩ na kĩndũ;","poem":2},{"text":"ningĩ ngĩcũthĩrĩria matu-inĩ,","poem":1},{"text":"ngĩona atĩ gũtiarĩ na ũtheri.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ndaacũthĩrĩria irĩma,","poem":1},{"text":"ngĩona atĩ nĩgũthingitha ciathingithaga;","poem":2},{"lineBreak":true},{"text":"natuo tũrĩma tuothe nĩ kwereera twereeraga.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ngĩcũthĩrĩria, ngĩona atĩ gũtiarĩ na andũ;","poem":1},{"text":"nyoni ciothe cia rĩera-inĩ nĩciombũkĩte ikoora.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ngĩcũthĩrĩria, ngĩona bũrũri ũrĩa waciaraga maciaro maingĩ, watuĩkĩte o werũ mũtheri,","poem":1},{"text":"matũũra makuo mothe nĩmamomokeire hau mbere ya Jehova,","poem":2},{"lineBreak":true},{"text":"makagũa thĩ nĩ ũndũ wa marakara make mahiũ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ũũ nĩguo Jehova ekuuga:","poem":1},{"lineBreak":true},{"text":"“Bũrũri wothe nĩũkanangwo,","poem":1},{"text":"o na gũtuĩka ndikaũniina biũ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Nĩ ũndũ ũcio thĩ nĩĩgacakaya,","poem":1},{"text":"narĩo igũrũ rĩgĩe nduma,","poem":2},{"text":"tondũ ũguo nĩguo njugĩte, na ndingĩĩricũkwo.","poem":1},{"text":"Nĩnduĩte itua na ndikũgarũrũka.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Rĩrĩa kwaiguuo mũrurumo wa andũ arĩa mathiiaga mahaicĩte mbarathi","poem":1},{"text":"na wa andũ arĩa maikagia mĩguĩ-rĩ,","poem":2},{"lineBreak":true},{"text":"andũ a matũũra mothe no makoora.","poem":2},{"text":"Amwe ao makoorĩra ihinga-inĩ,","poem":1},{"text":"nao amwe ao makahaica ndwaro-inĩ cia mahiga.","poem":2},{"text":"Matũũra macio mothe nĩmathaamĩtwo;","poem":1},{"text":"gũtirĩ mũndũ ũikaraga kuo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Ũreka atĩa, wee ũnũhĩtwo?","poem":1},{"text":"Ũkwĩhumba nguo ndune","poem":2},{"lineBreak":true},{"text":"na ũkegemia na mathaga ma thahabu nĩkĩ?","poem":2},{"text":"Ũrahaka mbutu ciaku cia maitho rangi nĩkĩ?","poem":1},{"noteId":3},{"text":"Atĩrĩrĩ, kwĩgemia gwaku no gwa tũhũ.","poem":2},{"text":"Endwa aku nĩmakwagĩire bata;","poem":1},{"text":"rĩu maracaria ũrĩa mangĩkũruta muoyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Nĩndĩraigua kĩrĩro ta kĩa mũndũ-wa-nja akĩrũmwo,","poem":1},{"text":"arĩ na mũcaayo ta wa mũtumia agĩciara mwana wake wa irigithathi:","poem":2},{"text":"nĩ kĩrĩro kĩa Mwarĩ wa Zayuni agĩteeha,","poem":1},{"text":"atambũrũkĩtie moko make, akiugaga atĩrĩ,","poem":2},{"text":"“Wũi-ĩ-iya-wakwa-ĩ! Nĩndĩraringĩka;","poem":1},{"text":"muoyo wakwa nĩmũneane kũrĩ oragani.”","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"Mũrũũthi warĩ rũũri rwa Babuloni, na bũrũri ũyũ woĩkaine ta mũnyariirani (2:15).","reference":{"chapter":4,"verse":7}},{"noteId":3,"caller":"+","text":"Ũyũ nĩ rangi wehakagwo maitho arĩ njĩra ĩmwe ya ũthaka na gũtũma maitho moneke marĩ manene (2Ath 9:30; Ezek 23:40).","reference":{"chapter":4,"verse":30}}]},"thisChapterLink":"/api/kik_bib/JER/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/JER/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/JER/3.json","previousChapterAudioLinks":{},"numberOfVerses":31}