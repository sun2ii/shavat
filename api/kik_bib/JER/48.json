{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"JER","translationId":"kik_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"17989884b95932aa36d8a178f6b035416cf55caeb126c9185fe9c4377fae3fcc","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/kik_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":48,"content":[{"type":"heading","content":["Ndũmĩrĩri ĩkoniĩ Moabi"]},{"type":"verse","number":1,"content":["Ha ũhoro ũkoniĩ bũrũri wa Moabi:",{"lineBreak":true},"Jehova Mwene-Hinya-Wothe, Ngai wa Isiraeli ekuuga atĩrĩ:",{"text":"“Wũi-ĩiya, nĩ ũndũ Nebo nĩgũkwanangwo-ĩ.","poem":1},{"text":"Kiriathaimu nĩgũgaconorithio na gũtunyanwo;","poem":2},{"lineBreak":true},{"text":"kĩĩgitĩro kĩrĩa kĩrũmu nĩgĩgaconorithio na kĩharaganio.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Moabi gũtigacooka kũgaathĩrĩrio rĩngĩ;","poem":1},{"text":"kũu Heshiboni andũ nĩmagathugunda ũrĩa megũgũũkĩrĩra, makoiga atĩrĩ:","poem":2},{"lineBreak":true},{"text":"‘Ũkai, nĩtũniinei rũrĩrĩ rũu.’","poem":2},{"text":"O nawe itũũra rĩa Madimeni-rĩ, nĩũgakirio ki;","poem":1},{"text":"rũhiũ rwa njora nĩrũgagũtengʼeria.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ta thikĩrĩria mbu ĩyo ĩroigwo kũu Horonaimu,","poem":1},{"text":"mbu nĩ ũndũ wa kũniinanwo kũnene na mwanangĩko.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bũrũri wa Moabi nĩũkonũhwo:","poem":1},{"text":"ciana ciakuo cia ngenge nĩikaarĩra ciugĩrĩirie.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Marambata na njĩra ya gũthiĩ Luhithu,","poem":1},{"text":"makĩrĩraga na ruo rũnene o magĩthiiaga;","poem":2},{"text":"marĩ njĩra-inĩ ya gũikũrũka Horonaimu","poem":1},{"text":"nĩmaiguĩte kĩrĩro kĩa ruo ruumĩte ngoro nĩ ũndũ wa ũrĩa kwanangĩtwo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mwĩtharei! Honokiai mĩoyo yanyu,","poem":1},{"text":"tuĩkai ta kahinga karĩ werũ-inĩ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tondũ wa ũrĩa wee wĩhokete ciĩko ciaku o na ũtonga waku-rĩ,","poem":1},{"text":"o nawe nĩũgatahwo,","poem":2},{"text":"nayo ngai ĩrĩa ĩtagwo Kemoshu","poem":1},{"noteId":27},{"text":"nĩĩgatwarwo ithaamĩrio,","poem":1},{"text":"ĩrĩ hamwe na athĩnjĩri-ngai, o na anene a yo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mũniinani nĩagookĩrĩra itũũra o itũũra,","poem":1},{"text":"na gũtirĩ itũũra rĩkahonoka.","poem":2},{"text":"Gĩtuamba nĩgĩkaharaganio,","poem":1},{"text":"naguo werũ ũrĩa mwaraganu wanangwo,","poem":2},{"lineBreak":true},{"text":"tondũ Jehova nĩwe ugĩte ũguo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Itĩrĩriai Moabi cumbĩ,","poem":1},{"text":"tondũ nĩrĩkonũhwo;","poem":2},{"text":"matũũra makuo nĩmagakira ihooru,","poem":1},{"text":"kwage mũndũ o na ũmwe ũngĩmatũũra.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Kũrumwo-rĩ, nĩ mũndũ ũrĩa ũkũruta wĩra wa Jehova arĩ na ũgũũta!","poem":1},{"text":"Kũrumwo-rĩ, nĩ mũndũ ũrĩa ũkũgirĩrĩria rũhiũ rwake rwa njora gũita thakame!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Moabi atũũrĩte agaacĩire kuuma arĩ mwĩthĩ,","poem":1},{"text":"ta ndibei ĩrĩa ĩĩkeerete,","poem":2},{"text":"ĩkarika kĩnyita ĩtarĩ nyonoranie;","poem":1},{"text":"we ndarĩ aatahwo agatwarwo bũrũri ũngĩ.","poem":2},{"text":"Nĩ ũndũ ũcio mũcamo wake no ta ũrĩa warĩ tene,","poem":1},{"text":"naguo mũtararĩko wake ndũrĩ wagarũrũka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"No matukũ nĩmarooka,","poem":1},{"lineBreak":true},{"text":"rĩrĩa ngaatũma andũ arĩa monoranagia moke,","poem":1},{"text":"nao mamuonorerie thĩ;","poem":2},{"text":"matige ndigithũ ciake irĩ theri,","poem":1},{"text":"na moragaange nyũngũ ciake,” ũguo nĩguo Jehova ekuuga.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Hĩndĩ ĩyo Moabi nĩagaconoka nĩ ũndũ wa ngai ĩrĩa ĩtagwo Kemoshu,","poem":1},{"text":"o ta ũrĩa nyũmba ya Isiraeli yaconokire,","poem":2},{"lineBreak":true},{"text":"rĩrĩa meehokete Betheli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Mwakĩhota atĩa kuuga atĩrĩ, ‘Ithuĩ tũrĩ njamba irĩ hinya,","poem":1},{"text":"andũ marĩ ũrũme ita-inĩ’?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Moabi nĩgũkanangwo na matũũra makuo matharĩkĩrwo;","poem":1},{"text":"aanake ake arĩa ega mũno magaikũrũka rĩũraganĩro-inĩ makooragwo,”","poem":2},{"lineBreak":true},{"text":"nĩguo Mũthamaki ekuuga, o we ũrĩa wĩtagwo Jehova Mwene-Hinya-Wothe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Kũgũa kwa Moabi nĩgũkinyu;","poem":1},{"text":"mũtino wake nĩũgũũka o na ihenya.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mũcakaĩrei inyuĩ arĩa othe mũtũũraga mũmũthiũrũrũkĩirie,","poem":1},{"text":"inyuothe arĩa mũũĩ ngumo yake;","poem":2},{"text":"ugai atĩrĩ, ‘Kaĩ rũthanju rwa ũnene nĩrunĩkangu-ĩ!","poem":1},{"text":"Kaĩ mũthĩgi ũrĩa ũrĩ riiri nĩmunangĩku-ĩ!’","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Harũrũkai mwehere riiri-inĩ ũcio wanyu,","poem":1},{"text":"mũikare thĩ kũrĩa kũngʼaru,","poem":2},{"lineBreak":true},{"text":"inyuĩ atũũri a kũu kwa Mwarĩ wa Diboni,","poem":2},{"text":"nĩgũkorwo ũrĩa ũkaananga Moabi","poem":1},{"text":"nĩakamũũkĩrĩra,","poem":2},{"lineBreak":true},{"text":"aharaganie matũũra manyu marĩa mairigĩre na hinya.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Rũgamai mũkĩra-inĩ wa barabara mwĩrorere,","poem":1},{"text":"inyuĩ arĩa mũtũũraga Aroeri.","poem":2},{"text":"Hooyai kĩrĩra harĩ mũndũ ũcio ũrethara, o na harĩ mũndũ-wa-nja ũcio ũroora,","poem":1},{"text":"mũmoorie atĩrĩ, ‘Kaĩ gwĩkĩkĩte atĩa?’","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Moabi nĩmũconorithie, nĩ ũndũ nĩmũhehenje.","poem":1},{"text":"Kayũrũrũkai na mũrĩre!","poem":2},{"text":"Heanai ũhoro ũcio kũu Arinoni,","poem":1},{"text":"atĩ Moabi nĩ mwanange.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Matuĩro ma ciira nĩmakinyĩte bũrũri-inĩ ũrĩa mwaraganu:","poem":1},{"text":"magakinya Holoni, na Jahaza, na Mefaathu,","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"na magakinya Diboni, na Nebo, na Bethi-Dibilathaimu,","poem":2}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"na magakinya Kiriathaimu, na Bethi-Gamuli, na Bethi-Meoni,","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"na magakinya Keriothu, na Bozara:","poem":2},{"lineBreak":true},{"text":"ĩĩ, nginya matũũra mothe ma Moabi,","poem":2},{"lineBreak":true},{"text":"marĩ kũraya na marĩ gũkuhĩ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Rũhĩa rwa Moabi nĩrũrengetwo;","poem":1},{"text":"guoko gwake nĩ kuunĩtwo,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Mũheei njoohi anyue arĩĩo,","poem":1},{"text":"tondũ nĩangʼathĩirie Jehova.","poem":2},{"text":"Moabi nĩarekwo egaragarie matahĩko-inĩ make;","poem":1},{"text":"nĩarekwo atuĩke kĩndũ gĩa gũthekererwo.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Githĩ Isiraeli ndatuĩkĩte kĩndũ gĩa gũthekererwo nĩwe?","poem":1},{"text":"Kaĩ aanyiitirwo arĩ gatagatĩ ka aici,","poem":2},{"text":"atĩ nĩkĩo ũinagia kĩongo nĩkũmũnyarara,","poem":1},{"text":"rĩrĩa rĩothe ũkwaria ũhoro wake?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Tiganĩriai matũũra manyu mũgatũũre ndwaro-inĩ cia mahiga,","poem":1},{"text":"inyuĩ arĩa mũtũũraga Moabi.","poem":2},{"text":"Tuĩkai ta ndutura ĩrĩa ĩyakagĩra gĩtara","poem":1},{"text":"mũromo-inĩ wa ngurunga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Nĩtũiguĩte ũhoro wa mwĩtĩĩo wa Moabi,","poem":1},{"text":"ũrĩa aarĩ mwĩĩkĩrĩri na akeyona,","poem":2},{"text":"tũkaigua ũhoro wa mwĩtĩĩo wake o na mwĩtũũgĩrio,","poem":1},{"text":"o na tũkaigua ũhoro wa mwĩgaatho wa ngoro yake.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Nĩnjũũĩ rũngʼathio rwake, no nĩ rwa tũhũ,","poem":1},{"text":"naguo mwĩraho wake ndũrĩ ũndũ ũhingĩtie,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"verse","number":31,"content":[{"text":"“Nĩ ũndũ ũcio nĩndĩrarĩrĩra Moabi,","poem":1},{"text":"nĩ Moabi guothe ndĩrarĩrĩra,","poem":2},{"lineBreak":true},{"text":"ndĩracakaĩra andũ a Kiri-Haresethi.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ndĩrarĩra nĩ ũndũ wanyu, o ta ũrĩa Jazeri arĩraga,","poem":1},{"text":"inyuĩ mĩthabibũ ya Sibima.","poem":2},{"text":"Honge cianyu itambũrũkĩte igakinya iria-inĩ;","poem":1},{"text":"itambũrũkĩte nginya iria-inĩ rĩa Jazeri.","poem":2},{"text":"Mũniinani nĩagũĩrĩire matunda maku","poem":1},{"text":"marĩa meeru, o na akagwĩra thabibũ.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Gĩkeno na gũcanjamũka nĩithirĩte","poem":1},{"text":"kũu mĩgũnda-inĩ ya matunda, o na kũu mĩgũnda-inĩ ya Moabi.","poem":2},{"text":"Nĩndũmĩte ndibei yage ihihĩro-inĩ ciayo;","poem":1},{"text":"gũtirĩ mũndũ ũhihaga thabibũ kuo arĩ na mbugĩrĩrio ya gĩkeno.","poem":2},{"text":"O na gũtuĩka nĩ kũrĩ na mbugĩrĩrio,","poem":1},{"text":"ti mbugĩrĩrio cia gĩkeno.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Mĩgambo ya kĩrĩro kĩao ĩraiguuo","poem":1},{"text":"kuuma Heshiboni o nginya Eleale na Jahazu,","poem":2},{"text":"na kuuma Zoari o nginya Horonaimu na Egilathu-Shelishiya,","poem":1},{"text":"tondũ o na maaĩ ma Nimurimu nĩmahũĩte.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Kũu Moabi nĩnganiina","poem":1},{"text":"arĩa othe marutagĩra maruta kũndũ kũrĩa gũtũũgĩru,","poem":2},{"lineBreak":true},{"text":"na magacinĩra ngai ciao ũbumba,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"verse","number":36,"content":[{"text":"“Nĩ ũndũ ũcio ngoro yakwa nĩĩracakaĩra Moabi, nganĩrĩra o ta mũtũrirũ;","poem":1},{"text":"ĩracakaya yanĩrĩire ta mũtũrirũ nĩ ũndũ wa andũ a Kiri-Haresethi,","poem":2},{"lineBreak":true},{"text":"tondũ ũtonga ũrĩa megĩrĩire nĩmũthiru biũ.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Mĩtwe yothe nĩmĩenje","poem":1},{"text":"na nderu ciothe cikenjwo;","poem":2},{"text":"guoko guothe nĩgũteme,","poem":1},{"text":"na njohero o yothe ĩhumbĩtwo na nguo ya ikũnia.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Nyũmba-igũrũ guothe kũu Moabi,","poem":1},{"text":"o na kũu iwanja-inĩ cia mũingĩ,","poem":2},{"text":"gũtirĩ ũndũ ũngĩ tiga o gũcakaya,","poem":1},{"text":"nĩgũkorwo nĩnjũragĩte Moabi","poem":2},{"lineBreak":true},{"text":"o ta ndigithũ ya rĩũmba ĩrĩa ĩtangĩendeka nĩ mũndũ,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"verse","number":39,"content":[{"text":"“Hĩ! Kaĩ nĩkũmomore-ĩ! Kaĩ nĩmararĩra-ĩ!","poem":1},{"text":"Kaĩ Moabi nĩahũndũkĩte na thuutha nĩ thoni-ĩ!","poem":2},{"text":"Moabi atuĩkĩte kĩndũ gĩa gũthekererwo,","poem":1},{"text":"na agatuĩka kĩndũ kĩrĩ magigi harĩ arĩa othe mamũrigiicĩirie.”","poem":2}]},{"type":"verse","number":40,"content":["Jehova ekuuga atĩrĩ:",{"text":"“Atĩrĩrĩ! Nderi nĩĩracuuhũka,","poem":1},{"text":"ĩtambũrũkĩtie mathagu mayo igũrũ rĩa Moabi.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Keriothu nĩgũgũtunyanwo,","poem":1},{"text":"nacio ciĩhitho iria cia hinya kuo itahwo.","poem":2},{"text":"Mũthenya ũcio-rĩ, ngoro cia njamba iria irĩ hinya cia Moabi","poem":1},{"text":"igaatuĩka ta ngoro ya mũndũ-wa-nja akĩrũmwo.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Moabi nĩakaniinwo atige gũtuĩka rũrĩrĩ rĩngĩ,","poem":1},{"text":"tondũ nĩangʼathĩirie Jehova.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Inyuĩ andũ a Moabi,","poem":1},{"text":"guoya, na kũgũa marima, o na kũgwatio na mĩtego nĩcio imwetereire,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"verse","number":44,"content":[{"text":"“Ũrĩa wothe ũkoora nĩ ũndũ wa guoya,","poem":1},{"text":"ũcio akaagũa irima,","poem":2},{"text":"nake ũrĩa ũkaahaica oime irima-rĩ,","poem":1},{"text":"akaagwatio nĩ mũtego;","poem":2},{"text":"nĩ ũndũ nĩngũtũma Moabi akinyĩrwo","poem":1},{"text":"nĩ mwaka wa kũherithio,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“Andũ arĩa metharĩte makoorĩra ciĩruru-inĩ cia Heshiboni","poem":1},{"text":"matirĩ na ũteithio,","poem":2},{"text":"nĩgũkorwo mwaki nĩumĩte Heshiboni,","poem":1},{"text":"rũrĩrĩmbĩ rũkoima gatagatĩ ka Sihoni;","poem":2},{"text":"rũracina mothiũ ma Moabi,","poem":1},{"text":"na rũgacina ciongo cia acio merahaga makarehe ngũĩ.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Wee Moabi, kaĩ ũrĩ na haaro-ĩ!","poem":1},{"text":"Andũ a Kemoshu nĩaniine;","poem":2},{"text":"aanake aku manyiitĩtwo mĩgwate magathaamio","poem":1},{"text":"nao airĩtu aku magatahwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"“No rĩrĩ, nĩngacookia ũgaacĩru wa Moabi","poem":1},{"text":"matukũ-inĩ marĩa magooka,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4},"Hau nĩho mũthia wa ituĩro rĩa Moabi."]}],"footnotes":[{"noteId":27,"caller":"+","text":"Kemoshu yarĩ ngai ya andũ a Moabi (1Ath 11:7, 33; 2Ath 23:13).","reference":{"chapter":48,"verse":7}}]},"thisChapterLink":"/api/kik_bib/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}