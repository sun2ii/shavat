{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"JER","translationId":"kik_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"17989884b95932aa36d8a178f6b035416cf55caeb126c9185fe9c4377fae3fcc","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/kik_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":6,"content":[{"type":"heading","content":["Jerusalemu Kũrigiicĩrio"]},{"type":"verse","number":1,"content":[{"text":"“Mwĩtharei mwĩhonokie, inyuĩ andũ a Benjamini!","poem":1},{"text":"Mwĩtharei muume Jerusalemu!","poem":2},{"text":"Huhai karumbeta mũrĩ kũu Tekoa!","poem":1},{"text":"Ĩkĩrai kĩmenyithia kũu Bethi-Hakeremu!","poem":2},{"text":"Nĩgũkorwo ũũru nĩũũkĩte uumĩte na mwena wa gathigathini,","poem":1},{"text":"na nĩ ũũru wa kũniinanwo kũnene mũno.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nĩngananga Mwarĩ wa Zayuni,","poem":1},{"text":"o ũcio mũthaka na mwĩbacĩrĩri mũno.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Arĩithi marĩ na ndũũru ciao cia mbũri nĩmagooka nĩguo mamũũkĩrĩre;","poem":1},{"text":"nĩmakaamba hema ciao imũthiũrũrũkĩirie mĩena yothe,","poem":2},{"lineBreak":true},{"text":"o mũndũ o mũndũ akarangĩra handũ hake.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Mwĩhaarĩriei tũrũe nake!","poem":1},{"text":"Arahũkai, rekei tũmũtharĩkĩre mĩaraho!","poem":2},{"text":"No rĩrĩ, wũi-ĩiya-ĩ! Nĩkũratuka,","poem":1},{"text":"nacio ciĩruru cia hwaĩ-inĩ nĩiraraiha.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nĩ ũndũ ũcio, arahũkai, tũtharĩkĩre kũrĩ ũtukũ,","poem":1},{"text":"tũharaganie ciĩgitio ciake iria nũmu!”","poem":2}]},{"type":"verse","number":6,"content":["Jehova Mwene-Hinya-Wothe ekuuga atĩrĩ:",{"text":"“Temai mĩtĩ","poem":1},{"text":"mũmĩige ihũba nene ingʼetheire Jerusalemu.","poem":2},{"text":"Itũũra rĩrĩ inene no nginya rĩherithio;","poem":1},{"text":"nĩ ũndũ rĩiyũrĩte ũhoro wa kũhinyanĩrĩria.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"O ta ũrĩa gĩthima gĩtherũkaga maaĩ-rĩ,","poem":1},{"text":"ũguo noguo itũũra rĩu rĩtherũkaga waganu.","poem":2},{"text":"Maũndũ ma ũhinya na wanangi no mo maiguagwo kuo;","poem":1},{"text":"ndwari ciakuo na nguraro nĩcio ndũũraga nyonaga.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Atĩrĩrĩ, wee Jerusalemu,","poem":1},{"text":"ĩtĩkĩra gũtaarwo,","poem":2},{"text":"kwaga ũguo nĩngũkũhutatĩra na ndũme bũrũri waku ũkire ihooru,","poem":1},{"text":"nginya kwage mũndũ ũngĩtũũra kuo.”","poem":2}]},{"type":"verse","number":9,"content":["Ũũ nĩguo Jehova Mwene-Hinya-Wothe ekuuga:",{"text":"“Atĩrĩrĩ, andũ nĩmarekwo mahaare matigari ma Isiraeli mahinyĩtie,","poem":1},{"text":"o ta ũrĩa mũthabibũ ũhaaragwo;","poem":2},{"text":"cookerithia guoko honge-inĩ rĩngĩ,","poem":1},{"text":"o ta ũrĩa mũcookereria wa thabibũ ekaga.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nũũ ingĩkĩarĩria ndĩmũkaanie na anjigue?","poem":1},{"text":"Nũũ ũngĩĩthikĩrĩria?","poem":2},{"text":"Matũ mao nĩmahinge,","poem":1},{"text":"nĩ ũndũ ũcio matiingĩigua.","poem":2},{"text":"Ndũmĩrĩri ya Jehova nĩĩmahĩtagĩria,","poem":1},{"text":"na matingĩmĩkenera.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"No rĩrĩ, niĩ njiyũrĩtwo nĩ mangʼũrĩ ma Jehova,","poem":1},{"text":"ndingĩhota kũmahingĩrĩria.","poem":2},{"lineBreak":true},{"text":"“Maitĩrĩrie ciana iria irĩ barabara-inĩ,","poem":1},{"text":"na ũmaitĩrĩrie aanake arĩa monganĩte hamwe;","poem":2},{"text":"mũthuuri na mũtumia wake, maitĩkĩrwo nĩmo,","poem":1},{"text":"o ũndũ ũmwe na andũ arĩa akũrũ, arĩa maingĩhĩtie mĩaka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nyũmba ciao igaatuĩka cia andũ angĩ,","poem":1},{"text":"o hamwe na mĩgũnda yao na atumia ao,","poem":2},{"text":"rĩrĩa ngaatambũrũkia guoko gwakwa","poem":1},{"text":"njũkĩrĩre andũ arĩa matũũraga bũrũri ũcio,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"“Kuuma ũrĩa mũnini nginya ũrĩa mũnene,","poem":1},{"text":"othe nĩmakoroketio nĩ kwenda kwĩguna;","poem":2},{"text":"anabii o hamwe na athĩnjĩri-Ngai,","poem":1},{"text":"othe nĩmaheenanagia.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mohaga kĩronda kĩa andũ akwa","poem":1},{"text":"taarĩ kĩronda kĩa andũ matagurarĩtio mũno,","poem":2},{"text":"makĩmeeraga atĩrĩ: ‘Gwĩ thayũ, gwĩ thayũ,’","poem":1},{"text":"o rĩrĩa gũtarĩ thayũ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hihi nĩmaconokaga nĩ mũtugo ũcio wao ũrĩ magigi?","poem":1},{"text":"Aca, maticonokaga o na hanini;","poem":2},{"lineBreak":true},{"text":"o na matirĩ rũkobe.","poem":2},{"text":"Nĩ ũndũ ũcio o nao makaagũanĩra na arĩa makaagũa;","poem":1},{"text":"nĩmakarũndwo rĩrĩa ngaamaherithia,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"verse","number":16,"content":["Jehova ekuuga atĩrĩ:",{"text":"“Rũgamai magomano-inĩ ma njĩra, mũtuĩrie ũhoro;","poem":1},{"text":"ũrĩrĩriai njĩra iria ciageragwo tene,","poem":2},{"text":"mũũrie harĩa njĩra ĩrĩa njega ĩrĩ, nĩguo mũmĩgerere,","poem":1},{"text":"nacio ngoro cianyu nĩikahurũka.","poem":2},{"lineBreak":true},{"text":"No inyuĩ mũkiuga atĩrĩ, ‘Ithuĩ tũtikũmĩgerera.’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nĩndaigire arangĩri nĩguo mamũrangĩre, ngiuga atĩrĩ,","poem":1},{"text":"‘Ta thikĩrĩriai karumbeta!’","poem":2},{"lineBreak":true},{"text":"No inyuĩ mũkiuga atĩrĩ, ‘Ithuĩ tũtigũthikĩrĩria.’","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nĩ ũndũ ũcio, thikĩrĩriai inyuĩ ndũrĩrĩ;","poem":1},{"text":"rorai wega inyuĩ aira,","poem":2},{"lineBreak":true},{"text":"nĩguo mũmenye ũrĩa gũgekĩka kũrĩ andũ akwa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ta thikĩrĩria, wee thĩ:","poem":1},{"lineBreak":true},{"text":"nĩngũrehere andũ aya mwanangĩko,","poem":1},{"text":"ũrĩ maciaro ma maũndũ marĩa mathugundaga,","poem":2},{"text":"tondũ nĩmagĩte gũthikĩrĩria ndũmĩrĩri yakwa,","poem":1},{"text":"na nĩmaregete watho wakwa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ngĩrĩ na bata ũrĩkũ na ũbumba ũcio wa kuuma Sheba,","poem":1},{"noteId":5},{"text":"kana igwa cia mũrĩo cia kuuma bũrũri wa kũraya?","poem":2},{"text":"Maruta manyu ma njino matingĩĩtĩkĩrĩka;","poem":1},{"text":"magongona manyu matingenagia.”","poem":2}]},{"type":"verse","number":21,"content":["Nĩ ũndũ ũcio, Jehova ekuuga atĩrĩ:",{"text":"“Nĩngwĩkĩra mĩhĩnga mbere ya andũ aya.","poem":1},{"text":"Maithe na ariũ ao nĩmakahĩngagwo nĩyo;","poem":2},{"lineBreak":true},{"text":"andũ a itũũra hamwe na arata ao nĩmagakua.”","poem":2}]},{"type":"verse","number":22,"content":["Jehova ekuuga atĩrĩ:",{"text":"“Ta rorai muone, nĩ harĩ na ita rĩroka","poem":1},{"text":"riumĩte bũrũri wa mwena wa gathigathini;","poem":2},{"text":"rũrĩrĩ rũnene nĩ rwarahũrĩtwo","poem":1},{"text":"kuuma ituri-inĩ cia thĩ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Manyiitĩte mĩguĩ na matimũ;","poem":1},{"text":"nĩ andũ ooru matarĩ tha.","poem":2},{"text":"Mũrurumo wao magĩũka mahaicĩte mbarathi,","poem":1},{"text":"nĩ ta wa ndiihũ cia iria rĩrĩa inene;","poem":2},{"text":"maroka mehaarĩirie ta andũ moka mbaara","poem":1},{"text":"nĩguo magũtharĩkĩre, wee Mwarĩ wa Zayuni.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Nĩtũiguĩte ũhoro wa andũ acio,","poem":1},{"text":"namo moko maitũ nĩmorĩtwo nĩ hinya.","poem":2},{"text":"Nĩtũnyiitĩtwo nĩ ruo rũnene,","poem":1},{"text":"ruo rũhaana ta rwa mũtumia ũkũrũmwo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mũtikoimagare mũthiĩ mĩgũnda,","poem":1},{"text":"kana mũthiĩ na njĩra,","poem":2},{"text":"nĩ ũndũ thũ ĩyo ĩrĩ na rũhiũ rwa njora,","poem":1},{"text":"na kũrĩ na imakania irigiicĩirie mĩena yothe.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Inyuĩ andũ akwa, mwĩhumbei nguo ya ikũnia,","poem":1},{"text":"na mwĩgaragarie mũhu-inĩ;","poem":2},{"text":"rĩrai na kĩgi,","poem":1},{"text":"ta ũrĩa mwana wa mũmwe arĩragĩrwo,","poem":2},{"text":"nĩgũkorwo mwanangi ũcio","poem":1},{"text":"agaatũhithũkĩra o rĩmwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Wee nawe nĩngũtuĩte mũgeria wa cuuma,","poem":1},{"text":"nao andũ akwa matariĩ ta kĩgera,","poem":2},{"text":"nĩguo wee ũrorage","poem":1},{"text":"na ũthimage mĩthiĩre yao.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Nĩ aremi momĩtie ngoro,","poem":1},{"text":"mathiiaga magĩcambanagia.","poem":2},{"text":"Mahaana o ta gĩcango na kĩgera;","poem":1},{"text":"othe mekaga maũndũ mathũku mũno.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ihuruti nĩirahurutĩra mwaki na hinya","poem":1},{"text":"nĩguo ũcine ngocorai,","poem":2},{"text":"no rĩrĩ, wĩra ũcio ũrarutwo wa kũmatheria no wa tũhũ;","poem":1},{"text":"arĩa aaganu matirathera.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Andũ acio marĩĩtagwo betha-ĩrĩa-ĩregetwo,","poem":1},{"text":"nĩ ũndũ Jehova nĩamaregeete.”","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"Itũũra rĩa Sheba rĩarĩ mwena wa gũthini wa irathĩro wa Arabia, na nĩkuo kwarĩ na wonjoria wa ũbumba.","reference":{"chapter":6,"verse":20}}]},"thisChapterLink":"/api/kik_bib/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/JER/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/JER/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}