{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"JER","translationId":"kik_bib","name":"Jeremia","commonName":"Jeremia","title":"JEREMIA","order":24,"numberOfChapters":52,"sha256":"17989884b95932aa36d8a178f6b035416cf55caeb126c9185fe9c4377fae3fcc","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/kik_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["“ ‘Jehova ekuuga atĩ ihinda rĩu, mahĩndĩ ma athamaki na ma anene a Juda, na mahĩndĩ ma athĩnjĩri-Ngai na ma anabii, o na mahĩndĩ ma andũ a Jerusalemu nĩmakarutwo mbĩrĩra-inĩ ciao.",{"noteId":6}]},{"type":"verse","number":2,"content":["Makaanĩkĩrwo riũa, na mweri, na njata ciothe cia igũrũ, icio mendete na magacitungatĩra, o icio maarũmĩrĩire, na magatuĩria kĩrĩra harĩ cio, na magacihooya. Mahĩndĩ macio matikoonganio kana mathikwo, no magaatuĩka ta rũrua rũharaganĩtio gũkũ thĩ."]},{"type":"verse","number":3,"content":["Kũrĩa guothe ngaamathaamĩria, matigari mothe ma rũrĩrĩ rũrũ rwaganu, makeeriragĩria gũkua handũ ha gũtũũra muoyo, ũguo nĩguo Jehova Mwene-Hinya-Wothe ekuuga.’"]},{"type":"heading","content":["Mehia na Kũherithio"]},{"type":"verse","number":4,"content":["“Meere atĩrĩ, ‘Ũũ nĩguo Jehova ekuuga,",{"text":"“ ‘Andũ mangĩgũa thĩ-rĩ, githĩ maticookaga gũũkĩra?","poem":1},{"text":"Mũndũ angĩhĩtia njĩra-rĩ, githĩ ndamĩcookagĩrĩra?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nĩ kĩĩ gĩtũmĩte andũ aya mathiĩ na mbere kũũhutatĩra?","poem":1},{"text":"Andũ a Jerusalemu maahutatagĩra nĩkĩ?","poem":2},{"text":"Matũũrĩte marũmĩtie maũndũ ma maheeni,","poem":1},{"text":"makarega gũcooka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nĩndĩmathikĩrĩirie wega mũno,","poem":1},{"text":"no matiaragia ũndũ ũrĩa wagĩrĩire.","poem":2},{"text":"Gũtirĩ o na ũmwe wao wĩriraga waganu wake,","poem":1},{"text":"akoiga atĩrĩ, “Njĩkĩte ũguo nĩkĩ?”","poem":2},{"text":"O mũndũ wao arũmagĩrĩra njĩra yake","poem":1},{"text":"o ta mbarathi ĩtengʼerete ĩtoonye mbaara-inĩ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mũrũaru ũrĩ rĩera-inĩ","poem":1},{"text":"nĩũmenyaga mahinda maguo ma gũcooka,","poem":2},{"text":"o nacio ndirahũgĩ, na thũngũrũrũ, na nyamĩndigi","poem":1},{"text":"nĩcimenyaga mahinda ma cio ma gũcooka.","poem":2},{"text":"No andũ akwa matiũĩ","poem":1},{"text":"maũndũ marĩa Jehova endaga mekwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ ‘Mwakĩhota atĩa kuuga atĩrĩ, “Tũrĩ oogĩ,","poem":1},{"text":"nĩ ũndũ tũrĩ na watho wa Jehova,”","poem":2},{"text":"o rĩrĩa karamu ka maheeni ka aandĩki-marũa","poem":1},{"text":"kaũgarũrĩte gakaũtua wa maheeni?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Andũ arĩa oogĩ nĩmagaconorithio;","poem":1},{"text":"nĩmakagega na magwatio nĩ mũtego.","poem":2},{"text":"Kuona atĩ nĩmareganĩte na ndũmĩrĩri ya Jehova,","poem":1},{"text":"ũũgĩ ũrĩa makĩrĩ naguo nĩ ũrĩkũ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nĩ ũndũ ũcio-rĩ, atumia ao nĩngamaheana kũrĩ arũme angĩ,","poem":1},{"text":"nayo mĩgũnda yao ndĩmĩheane kũrĩ andũ ageni.","poem":2},{"text":"Kuuma ũrĩa mũnini nginya ũrĩa mũnene,","poem":1},{"text":"othe nĩmakoroketio nĩ kwenda kwĩguna;","poem":2},{"text":"anabii o hamwe na athĩnjĩri-Ngai,","poem":1},{"text":"othe nĩmaheenanagia.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mohaga kĩronda kĩa andũ akwa","poem":1},{"text":"taarĩ kĩronda kĩa andũ matagurarĩtio mũno.","poem":2},{"text":"Moigaga atĩrĩ, “Gwĩ thayũ, gwĩ thayũ,”","poem":1},{"text":"o rĩrĩa gũtarĩ thayũ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hihi nĩmaconokaga nĩ mũtugo ũcio wao ũrĩ magigi?","poem":1},{"text":"Aca, maticonokaga o na hanini;","poem":2},{"lineBreak":true},{"text":"o na matirĩ rũkobe.","poem":2},{"text":"Nĩ ũndũ ũcio o nao makaagũanĩra na arĩa makaagũa;","poem":1},{"text":"nĩmakarũndwo rĩrĩa makaaherithio,","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ ‘Jehova ekuuga atĩrĩ,","poem":1},{"text":"nĩnganina magetha mao,","poem":2},{"text":"mĩthabibũ ndĩgaakorwo ĩrĩ na thabibũ.","poem":1},{"lineBreak":true},{"text":"Gũtikagĩa na ngũyũ mĩkũyũ-inĩ,","poem":1},{"text":"namo mathangũ mayo nĩmakahooha.","poem":2},{"text":"Kĩndũ kĩrĩa gĩothe ndĩmaheete","poem":1},{"text":"nĩmagatunywo.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Tũikarĩte haha nĩkĩ?","poem":1},{"text":"Cookanĩrĩrai hamwe!","poem":2},{"text":"Nĩtũũrei, tũtoonye matũũra marĩa mairigĩirwo na hinya","poem":1},{"text":"tũgakuĩre kuo!","poem":2},{"text":"Nĩgũkorwo Jehova Ngai witũ nĩwe ũtwathĩrĩirie gĩkuũ,","poem":1},{"text":"agatũhe maaĩ maroge tũnyue,","poem":2},{"lineBreak":true},{"text":"nĩ ũndũ nĩtũmwĩhĩirie.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tũtũũrĩte twĩrĩgĩrĩire atĩ nĩgũkũgĩa thayũ,","poem":1},{"text":"no gũtirĩ ũndũ mwega ũtũkorete,","poem":2},{"text":"tũkerĩgĩrĩra ihinda rĩa kũhonio,","poem":1},{"text":"no rĩrĩ, no kĩmako kĩonekaga.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mũtiihĩre wa mbarathi cia thũ","poem":1},{"text":"ũraiguuo kuuma Dani;","poem":2},{"text":"mbarathi ciao cia njamba iraania","poem":1},{"text":"bũrũri wothe ũkainaina.","poem":2},{"text":"Mookĩte kũrĩa","poem":1},{"text":"bũrũri na kĩrĩa gĩothe kĩrĩ kuo,","poem":2},{"lineBreak":true},{"text":"na marĩe itũũra inene na arĩa othe matũũraga kuo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Atĩrĩrĩ, nĩngamũrehithĩria nyoka irĩ thumu gatagatĩ kanyu,","poem":1},{"text":"ndĩmũrehithĩrie nduĩra iria itangĩhoorereka,","poem":2},{"lineBreak":true},{"text":"nacio nĩikamũrũma,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Wee ũũhooreragia rĩrĩa ndĩ na kĩeha-rĩ,","poem":1},{"text":"ngoro yakwa nĩĩringĩkĩte.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ta thikĩrĩria kĩrĩro kĩa andũ akwa","poem":1},{"text":"marĩ bũrũri wa kũraya:","poem":2},{"text":"“Atĩrĩrĩ, githĩ Jehova ndarĩ kũu Zayuni?","poem":1},{"text":"Mũthamaki wakuo-rĩ, kaĩ atatũũraga kuo?”","poem":2},{"lineBreak":true},{"text":"“Nĩ kĩĩ gĩtũmĩte maathirĩkie nĩguo ndaakare","poem":1},{"text":"na ũndũ wa mĩhianano ĩyo yao methondekeire,","poem":2},{"lineBreak":true},{"text":"makandakaria na mĩhianano ĩyo yao ya kũngĩ ĩtarĩ kĩene?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Ihinda rĩa magetha nĩrĩhĩtũku,","poem":1},{"text":"nayo hĩndĩ ya riũa ĩgathira,","poem":2},{"lineBreak":true},{"text":"na tũtihonoketio.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kuona atĩ andũ akwa nĩmahehenjetwo-rĩ, o na niĩ ndĩmũhehenje;","poem":1},{"text":"nĩndĩracaaya na nĩnyiitĩtwo nĩ kĩmako kĩnene.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kaĩ gũtarĩ ndawa kũu Gileadi?","poem":1},{"noteId":7},{"text":"Gũtirĩ mũthondekani kuo?","poem":2},{"text":"Ironda cia andũ akwa","poem":1},{"text":"cikĩagĩte kũhona nĩkĩ?","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"Gĩĩko gĩa kũruta mahĩndĩ mbĩrĩra kĩarĩ gĩa kuonania kwaga mũndũ gĩtĩĩo o na bata.","reference":{"chapter":8,"verse":1}},{"noteId":7,"caller":"+","text":"Bũrũri wa Gileadi nĩwoĩkaine nĩ ũndũ wa indo cia mũtararĩko mwega, o na mĩtĩ ya ndawa (Kĩam 37:25).","reference":{"chapter":8,"verse":22}}]},"thisChapterLink":"/api/kik_bib/JER/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/JER/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/JER/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}