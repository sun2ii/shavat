{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"JOB","translationId":"kik_bib","name":"Ayubu","commonName":"Ayubu","title":"AYUBU","order":18,"numberOfChapters":42,"sha256":"00ca8d537f2f83872db7dacc2222f8cbd8cb3d06002e48439fbbc4ea667a7538","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/kik_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"“Atĩrĩrĩ, maitho makwa nĩmonete maũndũ macio mothe,","poem":1},{"text":"matũ makwa nĩmamaiguĩte na magataũkĩrwo nĩmo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ũrĩa mũũĩ o na niĩ nĩnjũũĩ;","poem":1},{"text":"mũtirĩ oogĩ kũngĩra.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"No niĩ ndĩrenda kwaria na Mwene-Hinya-Wothe,","poem":1},{"text":"na ngerirĩria gũciira na Mũrungu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"No inyuĩ-rĩ, mũranjigĩrĩra ndeto cia maheeni;","poem":1},{"text":"inyuothe mũrĩ athondekani a tũhũ!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Naarĩ korwo mwakira ki!","poem":1},{"text":"Ũndũ ũcio ũngĩtuĩka ũũgĩ harĩ inyuĩ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Na rĩrĩ, thikĩrĩriai kĩhooto gĩakwa;","poem":1},{"text":"iguai gũthaithana kwa mĩromo yakwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kaĩ mũngĩaria ũũru mũkĩarĩrĩria Mũrungu?","poem":1},{"text":"Kaĩ mũngĩaria maheeni igũrũ rĩake?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kaĩ mũngĩmuonia kĩmenyano?","poem":1},{"text":"Kaĩ mũgũciirĩrĩra Mũrungu?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Angĩmũtuĩria inyuĩ-rĩ, ũndũ ũcio no ũtuĩke mwega?","poem":1},{"text":"No mũmũheenie ta ũrĩa mũngĩheenia mũndũ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ti-itherũ no amũrũithie","poem":1},{"text":"mũngĩtuĩka a kuonania kĩmenyano na hitho.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hĩ, riiri wake ndũngĩmũmakia?","poem":1},{"text":"Mũtingĩnyiitwo nĩ guoya nĩ ũndũ wake?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mĩario yanyu ya ũũgĩ nĩ thimo hũthũ o ta mũhu;","poem":1},{"text":"ihooto cianyu no ta kwĩgitĩra na rĩũmba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Kirai ki, mũreke njarie;","poem":1},{"text":"o ũrĩa ndĩrĩona-rĩ, rekei nyone.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nĩ kĩĩ gĩgũtũma ndĩtoonyie ũgwati-inĩ","poem":1},{"text":"na ngaiga muoyo wakwa moko-inĩ makwa?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"O na angĩnjũraga-rĩ, niĩ nowe ndĩrĩĩhokaga;","poem":1},{"text":"na ti-itherũ nĩ ngatetera mĩthiĩre yakwa hau mbere yake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ti-itherũ, ũndũ ũyũ noguo ũgaatuĩka wa kũũhonokia,","poem":1},{"text":"nĩgũkorwo mũndũ ũtooĩ Ngai ndangĩũmĩrĩria gũũka mbere yake!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Thikĩrĩriai wega ũhoro wakwa;","poem":1},{"text":"matũ manyu nĩmakĩigue ũrĩa nguuga.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ti-itherũ nĩhaarĩirie ciira wakwa,","poem":1},{"text":"na nĩnjũũĩ nĩ nguoneka ndĩ wa kĩhooto.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nĩ kũrĩ mũndũ ũngĩhota gũũthitanga?","poem":1},{"text":"Angĩkorwo nĩ kũrĩ-rĩ, no gũkira ngũkira ngue.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Wee Ngai, ta kĩĩhe o maũndũ maya meerĩ,","poem":1},{"text":"na ndigũcooka gũkwĩhitha:","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Atĩrĩ, eheria guoko gwaku, gũikare kũraya na niĩ,","poem":1},{"text":"na ũtige kũũmakia na imakania ciaku.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ningĩ ũnjĩte na nĩngwĩtĩka,","poem":1},{"text":"kana ũkĩreke njarie, nawe ũnjookerie.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nĩ mahĩtia na mehia maigana niĩ njĩkĩte?","poem":1},{"text":"Nyonia ihĩtia na rĩĩhia rĩakwa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ũraahitha ũthiũ waku nĩkĩ,","poem":1},{"text":"na ũkandua thũ yaku?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nĩũngĩnyamaria ithangũ rĩrahurutwo nĩ rũhuho?","poem":1},{"text":"Nĩũgũtengʼerania na maragara momũ?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nĩgũkorwo nĩ wandĩkĩte maũndũ marũrũ ma kũnjũkĩrĩra,","poem":1},{"text":"na ũkaangaĩra igai rĩa mehia ma ũnini wakwa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Wohaga magũrũ makwa na mĩnyororo;","poem":1},{"text":"ũrangagĩra njĩra ciakwa ciothe","poem":2},{"lineBreak":true},{"text":"na ũndũ wa gũcora njoro makinya ma magũrũ makwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Nĩ ũndũ ũcio mũndũ amocaga ta kĩndũ kĩbuthĩte,","poem":1},{"text":"agathira ta nguo ĩrĩĩtwo nĩ memenyi.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}