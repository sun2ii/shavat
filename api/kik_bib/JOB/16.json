{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"JOB","translationId":"kik_bib","name":"Ayubu","commonName":"Ayubu","title":"AYUBU","order":18,"numberOfChapters":42,"sha256":"00ca8d537f2f83872db7dacc2222f8cbd8cb3d06002e48439fbbc4ea667a7538","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/kik_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":16,"content":[{"type":"heading","content":["Mĩario ya Ayubu"]},{"type":"verse","number":1,"content":["Ningĩ Ayubu agĩcookia atĩrĩ:"]},{"type":"verse","number":2,"content":[{"text":"“Nĩnjiguĩte maũndũ maingĩ ta macio;","poem":1},{"text":"inyuothe mũrĩ ahoorerania a kũnyamarania!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mĩario ĩyo yanyu mĩingĩ ya mũhũhũtĩko-rĩ, ndĩrĩĩthira?","poem":1},{"text":"Nĩ kĩĩ kĩramũthĩĩnia, gĩgatũma mũtinde mũgĩkararania?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"O na niĩ no njarie ta inyuĩ, korwo nĩ inyuĩ mũrĩ harĩa ndĩ;","poem":1},{"text":"niĩ no njarie mĩario mĩega ya kũmũciirithia na ndĩmũinainĩrie mũtwe.","poem":2},{"noteId":6}]},{"type":"verse","number":5,"content":[{"text":"No rĩrĩ, kanua gakwa no kamũũmĩrĩrie;","poem":1},{"text":"ũhoorerania uumĩte mĩromo-inĩ yakwa no ũmũhoorerie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“No o na ndaaria-rĩ, ruo rwakwa rũtirathira;","poem":1},{"text":"o na ndegirĩrĩria kwaria-rĩ, rũtiranjeherera.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ti-itherũ, Wee Ngai nĩũũnogeetie;","poem":1},{"text":"nĩũharaganĩtie nyũmba yakwa yothe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wee nĩũnjoheete, naguo ũndũ ũcio ũgatuĩka ũira;","poem":1},{"text":"ũhĩnju ũyũ ndĩ naguo nĩwambararĩte ũkaanyumbũra ũrĩa ndariĩ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngai nĩandooretie na akandembũranga nĩ ũrĩa arakarĩte,","poem":1},{"text":"akaahagaranĩria magego;","poem":2},{"lineBreak":true},{"text":"ũcio thũ yakwa nĩangũũrĩire maitho.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Andũ nĩmathamĩtie tũnua twao maathekerere;","poem":1},{"text":"mangũthaga rũthĩa makĩĩnyũrũragia,","poem":2},{"lineBreak":true},{"text":"na makanyiitana hamwe manjũkĩrĩre.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mũrungu nĩandekereirie kũrĩ andũ arĩa ooru,","poem":1},{"text":"na akanjikia mĩtego-inĩ ya arĩa aaganu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Niĩ ndaikarĩte wega, nowe agĩĩthethera;","poem":1},{"text":"aanyiitire mũmero, akĩĩhehenja.","poem":2},{"text":"We anduĩte cabaa wake wa kũrathagwo;","poem":1}]},{"type":"verse","number":13,"content":[{"text":"aikia a mĩguĩ ake nĩmandigiicĩirie.","poem":2},{"text":"Aratheeca higo ciakwa atarĩ na tha,","poem":1},{"text":"na agaita maaĩ makwa ma nyongo thĩ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Aatharĩkagĩra maita maingĩ maingĩ;","poem":1},{"text":"anguthũkagĩra ta njamba ya ita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Ndumĩire gĩkonde gĩakwa kĩa mwĩrĩ nguo ya ikũnia,","poem":1},{"text":"na ngahitha thiithi wakwa rũkũngũ-inĩ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ũthiũ wakwa nĩũtunĩhĩte nĩkũrĩra,","poem":1},{"text":"nduma nene ĩgakĩhumbĩra maitho makwa;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"no rĩrĩ, moko makwa matirĩ ũndũ wa ũhinya mekĩte","poem":1},{"text":"namo mahooya makwa nĩ matheru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Wee thĩ-rĩ, ndũkahumbĩre thakame yakwa;","poem":1},{"text":"kĩrĩro gĩakwa kĩroaga gũkaahuurũkio!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"O na rĩu-rĩ, mũira wakwa arĩ igũrũ;","poem":1},{"text":"ũcio mũnjiirĩrĩri arĩ o igũrũ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mũũthaithanĩrĩri nĩ mũrata wakwa","poem":1},{"text":"rĩrĩa maitho makwa maraita maithori harĩ Ngai;","poem":2}]},{"type":"verse","number":21,"content":[{"text":"nĩathaithanagĩrĩra mũndũ kũrĩ Ngai,","poem":1},{"text":"o ta ũrĩa mũndũ athaithanagĩrĩra mũratawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“No mĩaka mĩnini ĩgũthira,","poem":1},{"text":"thiĩ rũgendo rũrĩa mũndũ athiiaga na ndacooke.","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"Kũinainĩria mũndũ mũtwe kuonanagia kũnyarara mũndũ ũcio, na kũu kwarĩ kũmũruma.","reference":{"chapter":16,"verse":4}}]},"thisChapterLink":"/api/kik_bib/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}