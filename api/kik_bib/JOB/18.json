{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"JOB","translationId":"kik_bib","name":"Ayubu","commonName":"Ayubu","title":"AYUBU","order":18,"numberOfChapters":42,"sha256":"00ca8d537f2f83872db7dacc2222f8cbd8cb3d06002e48439fbbc4ea667a7538","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/kik_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":18,"content":[{"type":"heading","content":["Mĩario ya Bilidadi"]},{"type":"verse","number":1,"content":["Ningĩ Bilidadi ũrĩa Mũshuhi agĩcookia, akĩũria atĩrĩ:"]},{"type":"verse","number":2,"content":[{"text":"“Ũrĩĩtiga kwaria mĩario ĩno rĩ?","poem":1},{"text":"Gĩa na ũũgĩ nĩguo o na ithuĩ tũhote kwaria.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nĩ kĩĩ kĩratũma ũtuone tũhaana ta ngʼombe,","poem":1},{"text":"na tũgatuuo irimũ maitho-inĩ maku?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wee ũrehanyũrũra nĩ ũndũ wa ũrĩa ũrakarĩte-rĩ,","poem":1},{"text":"thĩ no ĩthaamwo nĩ ũndũ waku?","poem":2},{"lineBreak":true},{"text":"Kana no nginya ndwaro cia mahiga cieherio harĩa itũire?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Tawa wa mũndũ mwaganu nĩmũhorie;","poem":1},{"text":"rũrĩrĩmbĩ rwa mwaki wake nĩrũtigĩte gwakana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ũtheri ũrĩa ũrĩ thĩinĩ wa hema yake ũtuĩkĩte nduma;","poem":1},{"text":"naguo tawa ũrĩa ũrĩ hakuhĩ nake ũkahora.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hinya wa mũkinyũkĩrie wake nĩmũhũthie;","poem":1},{"text":"namo mathugunda make makamũgũithia thĩ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Makinya make mamũikagia wabu-inĩ,","poem":1},{"text":"nake akoorũraga thĩinĩ wa marima mayo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mũtego ũmũnyiitĩire ndiira-inĩ ya kũgũrũ;","poem":1},{"text":"mũtego ũgakĩmũrũmia biũ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ahithĩirwo kĩana kĩa rũrigi tĩĩri-inĩ,","poem":1},{"text":"akaambĩrwo mũtego njĩra-inĩ yake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Imakania imuumagĩrĩra na mĩena yothe,","poem":1},{"text":"na ikamũtengʼeragia harĩa hothe aagerera.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mũtino nĩũmũhũũtĩire;","poem":1},{"text":"mwanangĩko wetereire agwe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mũtino ũrĩĩaga icunjĩ cia gĩkonde gĩake;","poem":1},{"text":"narĩo irigithathi rĩa gĩkuũ rĩgatambuuranga ciĩga ciake.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Aguucĩtio, akarutwo ũgitĩri-inĩ wa hema yake,","poem":1},{"text":"na agatwarwo kũrĩ mũthamaki wa imakania.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mwaki nĩguo ũtũũraga hema-inĩ yake;","poem":1},{"text":"ũbiriti ũgwakana nĩũhurunjĩtwo gĩikaro gĩake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mĩri yake yũmagĩra tĩĩri-inĩ,","poem":1},{"text":"nacio honge ciake ikahooha na igũrũ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kĩririkano gĩake nĩ gĩgaathira thĩ;","poem":1},{"text":"ndarĩ rĩĩtwa bũrũri-inĩ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Akaarutũrũrwo ũtheri-inĩ atwarwo nduma-inĩ","poem":1},{"text":"na nĩakaingatwo oime thĩ ĩno.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ndarĩ ciana kana njiaro thĩinĩ wa andũ ao,","poem":1},{"text":"o na ndarĩ mũndũ wake ũgaatigara kũrĩa aatũũraga.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Andũ a mwena wa ithũĩro nĩmakagegio nĩ maũndũ marĩa mamũkorete;","poem":1},{"text":"andũ a mwena wa irathĩro manyiitwo nĩ kĩmako.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ti-itherũ ũguo nĩguo gĩikaro kĩa mũndũ mwaganu gũkahaana;","poem":1},{"text":"kũndũ kwa mũndũ ũrĩa ũtooĩ Mũrungu-rĩ, gwake kũhaana ũguo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}