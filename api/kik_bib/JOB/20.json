{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"JOB","translationId":"kik_bib","name":"Ayubu","commonName":"Ayubu","title":"AYUBU","order":18,"numberOfChapters":42,"sha256":"00ca8d537f2f83872db7dacc2222f8cbd8cb3d06002e48439fbbc4ea667a7538","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/kik_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":20,"content":[{"type":"heading","content":["Mĩario ya Zofaru"]},{"type":"verse","number":1,"content":["Nake Zofaru ũrĩa Mũnaamathi agĩcookia atĩrĩ:"]},{"type":"verse","number":2,"content":[{"text":"“Meciiria makwa nĩ mathĩĩnĩku, na nĩkĩo ngũcookia,","poem":1},{"text":"nĩ ũndũ nĩndangĩkĩte mũno.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndĩraigua irũithia rĩa kũnjonorithia,","poem":1},{"text":"naguo ũmenyo wakwa nĩũranjĩkĩra hinya wa gũcookia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ti-itherũ nĩũũĩ ũrĩa gũtũire kuuma tene","poem":1},{"text":"rĩrĩa mũndũ aigirwo gũkũ thĩ ĩno,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"atĩ kũrũũhia kwa arĩa aaganu no gwa kahinda,","poem":1},{"text":"o nakĩo gĩkeno kĩa andũ arĩa matooĩ Ngai no gĩa kahinda kanini.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"O na gũtuĩka mwĩtĩĩo wake nĩ ũkinyaga o igũrũ,","poem":1},{"text":"naguo mũtwe wake ũkahutia matu-rĩ,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"agaathira nginya tene o ta mai make mwene;","poem":1},{"text":"arĩa manamuona mooragie atĩrĩ, ‘Kaĩ aathiire kũ?’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Airagĩria ta kĩroto, akaaga kuoneka rĩngĩ,","poem":1},{"text":"akaingatwo ta kĩoneki kĩa ũtukũ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Riitho rĩrĩa rĩamuonaga rĩtikamuona rĩngĩ;","poem":1},{"text":"harĩa aaikaraga hatikamuona rĩngĩ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ciana ciake ikaageragia kwĩiguithania na athĩĩni;","poem":1},{"text":"moko make mwene no nginya magaacookia ũtonga wake kũrĩa aaũrutire.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hinya wa wĩthĩ ũrĩa ũiyũrĩte mahĩndĩ-inĩ make","poem":1},{"text":"ũgaakoma hamwe nake rũkũngũ-inĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“O na gũtuĩka ũũru ũrĩ mũrĩo ũrĩ kanua gake,","poem":1},{"text":"na nĩaũhithaga rungu rwa rũrĩmĩ rwake,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"o na gũtuĩka ndangĩhota kũũrekia","poem":1},{"text":"na aũigaga kanua gake-rĩ,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"irio ciake nĩikarũra irĩ nda yake;","poem":1},{"text":"igaatuĩka ũrũrũ wa nduĩra thĩinĩ wake.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nĩagatahĩka ũtonga ũrĩa ameretie;","poem":1},{"text":"Mũrungu nĩagatũma aũtahĩke.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nĩakoonga thumu wa nyoka;","poem":1},{"text":"magego ma nyoka nĩmo makaamũũraga.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ndagakenera tũrũũĩ,","poem":1},{"text":"njũũĩ iria ithereraga ũũkĩ na ngorono.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kĩndũ kĩrĩa anogeire no nginya agagĩcookia atakĩrĩte;","poem":1},{"text":"ndagakenera uumithio wa wonjoria wake.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nĩgũkorwo nĩahinyĩrĩirie athĩĩni, akamatiga matarĩ na kĩndũ;","poem":1},{"text":"nĩatunyanĩte nyũmba iria ataakire.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Ti-itherũ merirĩria make matingĩthira;","poem":1},{"text":"ndangĩĩhonokia na indo iria eigĩire.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Gũtirĩ kĩndũ atigĩirio gĩa kũrĩa;","poem":1},{"text":"ũtonga wake ndũgatũũra.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hĩndĩ ĩrĩa aiganĩire nĩ ũndũ wa kũingĩhia indo, mĩnyamaro nĩĩkamũnyiita;","poem":1},{"text":"ũkĩa nĩũkamũkora na nditi nene.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hĩndĩ ĩrĩa aiyũrĩtie nda yake-rĩ,","poem":1},{"text":"nĩguo Ngai akaarekereria marakara make mahiũ mamũkore","poem":2},{"lineBreak":true},{"text":"na amuurĩrie mahũũra make.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"O na angĩũrĩra indo cia mbaara cia kĩgera,","poem":1},{"text":"akaarathwo na mũguĩ wa gĩcango.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Aũcomoraga kuuma ngʼongʼo wake,","poem":1},{"text":"mũtheece ũcio mũkengu akaũcomora kuuma ini-inĩ rĩake.","poem":2},{"text":"Imakania nĩikamũkorerera;","poem":1}]},{"type":"verse","number":26,"content":[{"text":"nduma nene nĩyetereire igĩĩna ciake.","poem":2},{"text":"Mwaki ũtarĩ mũhurutĩre nĩũkamũcina,","poem":1},{"text":"na ũniine kĩrĩa gĩtigaire thĩinĩ wa hema yake.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Igũrũ nĩrĩkaguũria wĩhia wake;","poem":1},{"text":"thĩ nayo nĩĩkarahũka ĩmũũkĩrĩre.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kĩguũ nĩgĩgathereria nyũmba yake,","poem":1},{"text":"indo cia nyũmba yake ithererio nĩ kĩguũ mũthenya ũcio wa mangʼũrĩ ma Ngai.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ũcio nĩguo ũndũ ũrĩa Ngai agayagĩra arĩa aaganu,","poem":1},{"text":"igai rĩrĩa maathĩrĩirwo nĩ Mũrungu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}