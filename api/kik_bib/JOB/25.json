{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"JOB","translationId":"kik_bib","name":"Ayubu","commonName":"Ayubu","title":"AYUBU","order":18,"numberOfChapters":42,"sha256":"00ca8d537f2f83872db7dacc2222f8cbd8cb3d06002e48439fbbc4ea667a7538","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/kik_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":25,"content":[{"type":"heading","content":["Mĩario ya Bilidadi"]},{"type":"verse","number":1,"content":["Nake Bilidadi ũrĩa Mũshuhi agĩcookia atĩrĩ:"]},{"type":"verse","number":2,"content":[{"text":"“Wathani na gwĩtigĩrwo nĩ cia Ngai;","poem":1},{"text":"nĩwe ũhaandaga watho kũu igũrũ o igũrũ mũno.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mbũtũ ciake no itarĩke?","poem":1},{"text":"Nũũ ũtaaragĩrwo nĩ ũtheri wake?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mũndũ aakĩhota atĩa gũkorwo arĩ mũthingu mbere ya Mũrungu?","poem":1},{"text":"Mũndũ ũciarĩtwo nĩ mũndũ-wa-nja-rĩ, akĩhota atĩa gũtuĩka mũtheru?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Angĩkorwo o na mweri ti mũcangararu,","poem":1},{"text":"na njata ti theru maitho-inĩ make-rĩ,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"mũndũ na no ta kĩgunyũ, o we mũrũ wa mũndũ-rĩ,","poem":1},{"text":"ndakĩrĩ mũnyiihĩre mũno makĩrĩa!”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}