{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"JOB","translationId":"kik_bib","name":"Ayubu","commonName":"Ayubu","title":"AYUBU","order":18,"numberOfChapters":42,"sha256":"00ca8d537f2f83872db7dacc2222f8cbd8cb3d06002e48439fbbc4ea667a7538","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/kik_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":36,"content":[{"type":"verse","number":1,"content":["Elihu agĩthiĩ na mbere kwaria, akiuga atĩrĩ:"]},{"type":"verse","number":2,"content":[{"text":"“Ngirĩrĩria hanini, na nĩngũkuonia","poem":1},{"text":"atĩ harĩ maũndũ mangĩ mangiugwo ma gũciirĩrĩra Ngai.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ũmenyo wakwa ndĩũrutĩte kũraihu;","poem":1},{"text":"niĩ ngũtũũgĩria kĩhooto kĩa ũcio Mũnyũũmbi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Menya wega atĩ ndeto ciakwa ti cia maheeni;","poem":1},{"text":"ũyũ mũrĩ nake arĩ na ũmenyo mũkinyanĩru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Mũrungu nĩwe mwene hinya, no ndairaga andũ;","poem":1},{"text":"we nĩ mwene hinya, na nĩarũmagia muoroto wake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndatũũragia arĩa aaganu muoyo,","poem":1},{"text":"no nĩaheaga arĩa anyariire kĩhooto kĩao.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndeheragia maitho make harĩ arĩa athingu;","poem":1},{"text":"amaikaragĩria gĩtĩ kĩa ũnene hamwe na athamaki,","poem":2},{"lineBreak":true},{"text":"na akamatũũgĩria nginya tene.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"No rĩrĩ, andũ mangĩkorwo mohetwo na mĩnyororo,","poem":1},{"text":"makanyiitio na mĩhĩndo ya mĩnyamaro,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"we nĩameeraga ũrĩa mekĩte,","poem":1},{"text":"atĩ mehĩtie na ũtũrĩka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"We nĩatũmaga mathikĩrĩrie ũtaaro,","poem":1},{"text":"na akamaatha merire ũũru wao.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mangĩmwathĩkĩra na mamũtungatĩre,","poem":1},{"text":"megũtũũra matukũ mao marĩa matigaru magaacĩire,","poem":2},{"lineBreak":true},{"text":"na mĩaka yao o maiganĩire.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"No mangĩaga kũigua,","poem":1},{"text":"nĩmakaniinwo na rũhiũ rwa njora,","poem":2},{"lineBreak":true},{"text":"na makue matarĩ na ũmenyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Arĩa matarĩ na Ngai ngoro-inĩ meiigagĩra marakara;","poem":1},{"text":"o na rĩrĩa aramooha na mĩnyororo, matikayaga mateithio.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Makuuaga marĩ ethĩ,","poem":1},{"text":"magakua hamwe na arũme arĩa maraya ma mahooero-inĩ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"No arĩa mathĩĩnĩkaga, nĩamakũũraga kuuma thĩĩna-inĩ wao;","poem":1},{"text":"nĩamaragĩria marĩ mĩnyamaro-inĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“We-rĩ, nĩarakũguucĩrĩria uume magego-inĩ ma mĩnyamaro,","poem":1},{"text":"agũtware handũ haariĩ hatarĩ na ũkunderu,","poem":2},{"lineBreak":true},{"text":"na agũtware akũhurũkie metha-inĩ yaku ĩiyũrĩte irio iria njega.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"No rĩu-rĩ, ũtitikithĩtio ituĩro rĩrĩa rĩagĩrĩire arĩa aaganu;","poem":1},{"text":"ituĩro rĩa ciira na kĩhooto nĩcigũkumbatĩte.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wĩmenyerere mũndũ o na ũrĩkũ ndakanakũheenererie na ũtonga;","poem":1},{"text":"ndũgetĩkĩrie ihaki inene rĩkũhĩtithie njĩra.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ũtonga waku o na kana kĩyo gĩaku kĩnene-rĩ,","poem":1},{"text":"no ikũnyiitĩrĩre nĩguo ndũgatoonye mĩnyamaro-inĩ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Tiga kwĩrirĩria ũtukũ,","poem":1},{"text":"nĩguo ũguucũrũrie andũ kuuma kwao mĩciĩ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Wĩmenyerere ndũkeerekere ũũru-inĩ,","poem":1},{"text":"tondũ ũkuoneka taarĩ guo wendete gũkĩra gũthĩĩnĩka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Mũrungu nĩatũgĩrĩtio nĩ ũndũ wa ũhoti wake.","poem":1},{"text":"Nũũ mũrutani take?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nũũ ũmwathĩrĩire njĩra ciake,","poem":1},{"text":"kana akamwĩra atĩrĩ, ‘Wee nĩwĩkĩte ũũru’?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ririkanaga gwĩkĩrĩra wĩra wake,","poem":1},{"text":"ũrĩa andũ manakumia na rwĩmbo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Andũ othe nĩmawonete;","poem":1},{"text":"andũ mawĩroragĩra marĩ o kũraya.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ĩ Mũrungu ndakĩrĩ mũnene; nĩ mũnene gũkĩra ũmenyi witũ!","poem":1},{"text":"Mũigana wa mĩaka yake ndũngĩtuĩrĩka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Ambatagia matata ma maaĩ,","poem":1},{"text":"marĩa macookaga gũtaatĩra tũrũũĩ ta mbura;","poem":2}]},{"type":"verse","number":28,"content":[{"text":"matu magaita ũigũ wamo,","poem":1},{"text":"nayo mbura nyingĩ ĩkoirĩra andũ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Nũũ ũngĩmenya ũrĩa atambũrũkagia matu,","poem":1},{"text":"kana ũhoro wa marurumĩ marĩa moimaga hema-inĩ yake?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Kĩone ũrĩa ahurunjaga rũheni rwake rũkamũthiũrũrũkĩria,","poem":1},{"text":"agathambia iria kũrĩa kũriku.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ũũ nĩguo aathaga ndũrĩrĩ","poem":1},{"text":"na akaheana irio nyingĩ.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Akumbatagĩria rũheni na moko make,","poem":1},{"text":"na akarwatha rũringe kĩrĩa kĩorotetwo.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Marurumĩ make nĩmanagĩrĩra kĩhuhũkanio kĩrĩa kĩroka;","poem":1},{"text":"o na ngʼombe nĩimenyithanagia atĩ kũrĩ kĩhuhũkanio kĩroka.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/JOB/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/JOB/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/JOB/35.json","previousChapterAudioLinks":{},"numberOfVerses":33}