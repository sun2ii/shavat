{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"JOB","translationId":"kik_bib","name":"Ayubu","commonName":"Ayubu","title":"AYUBU","order":18,"numberOfChapters":42,"sha256":"00ca8d537f2f83872db7dacc2222f8cbd8cb3d06002e48439fbbc4ea667a7538","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/kik_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":9,"content":[{"type":"heading","content":["Mĩario ya Ayubu"]},{"type":"verse","number":1,"content":["Ningĩ Ayubu agĩcookia, akiuga atĩrĩ:"]},{"type":"verse","number":2,"content":[{"text":"“Ti-itherũ nĩnjũũĩ ũhoro ũcio nĩ wa ma.","poem":1},{"text":"No rĩrĩ, mũndũ angĩhota atĩa gũkorwo arĩ mũthingu mbere ya Mũrungu?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O na korwo mũndũ enda gũkararania na Ngai-rĩ,","poem":1},{"text":"ndangĩhota kũmũcookeria kĩũria o na kĩmwe harĩ ciũria ngiri.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ũũgĩ wake nĩ mũingĩ mũno, na ũhoti wake nĩ mũnene.","poem":1},{"text":"Nũũ wanaregana nake akĩgaacĩra?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Eeheragia irĩma itekũmenya,","poem":1},{"text":"na agacingʼaũrania nĩ kũrakara.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Athingithagia thĩ ĩkoima handũ hayo,","poem":1},{"text":"na akainainia itugĩ ciayo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Aathaga riũa rĩkaaga kũratha;","poem":1},{"text":"nake agiragĩrĩria ũtheri wa njata.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nĩwe watambũrũkirie igũrũ arĩ o wiki,","poem":1},{"text":"na athiiaga agĩkinyangaga makũmbĩ ma iria.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nĩwe Mũũmbi wa njata iria ciĩtagwo Nduba, na Karaũ,","poem":1},{"text":"na Kĩrĩmĩra, o na ikundi cia njata cia mwena wa gũthini.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nĩekaga magegania matangĩmenyeka,","poem":1},{"text":"na akaringa ciama itangĩtarĩka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Rĩrĩa aahĩtũkĩra harĩa ndĩ, ndingĩmuona;","poem":1},{"text":"o na rĩrĩa aathiĩra harĩa ndĩ ndimenyaga.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Angĩgutha kĩndũ-rĩ, nũũ ũngĩhota kũmũgiria?","poem":1},{"text":"Nũũ ũngĩmũũria atĩrĩ, ‘Nĩ atĩa ũreka?’","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngai ndahingagĩrĩria marakara make;","poem":1},{"text":"o na arĩa maateithagĩrĩria Rahabu nĩmamũinamagĩrĩra.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Niĩ-rĩ, ndaakĩhota atĩa kũmũkararia?","poem":1},{"text":"Ingĩruta kũ ciugo cia kũmũcookeria?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"O na korwo ndihĩtĩtie-rĩ, ndingĩhota kũmũcookeria ũndũ;","poem":1},{"text":"ũrĩa ingĩĩka no gũthaitha ingĩthaitha Mũnjiirithia anjiguĩre tha.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"O na ingĩamwĩtire nake anjĩtĩke-rĩ,","poem":1},{"text":"ndingĩĩtĩkia nĩangĩathikĩrĩirie.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"We angĩamemendire na kĩhuhũkanio,","poem":1},{"text":"na aingĩhie ironda ciakwa hatarĩ gĩtũmi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ndarekaga njookererwo nĩ mĩhũmũ,","poem":1},{"text":"no nĩahatagĩrĩria na mathĩĩna.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Korwo no ũhoro wa hinya-rĩ, we arĩ hinya mũno!","poem":1},{"text":"Na korwo no ũhoro wa ciira wa kĩhooto-rĩ, nũũ ũngĩmwĩta?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"O na korwo ndiahĩtĩtie-rĩ, kanua gakwa no kandue mũhĩtia;","poem":1},{"text":"korwo ndiarĩ na ũcuuke-rĩ, nĩkangĩanduire mũhĩtia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“O na gũtuĩka ndirĩ na ũcuuke-rĩ, ndikwĩrĩrĩra;","poem":1},{"text":"muoyo wakwa nĩndĩwagĩire kĩene.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ũhoro no ũrĩa ũmwe; nĩkĩo ndĩroiga atĩrĩ,","poem":1},{"text":"‘Aniinaga arĩa matarĩ ũcuuke o na akaniina arĩa aaganu.’","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hĩndĩ ĩrĩa ihũũra rĩarehe gĩkuũ kĩa narua,","poem":1},{"text":"nĩathekagĩrĩra kũũrwo nĩ hinya kwa arĩa matarĩ na mahĩtia.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Hĩndĩ ĩrĩa bũrũri wagĩa moko-inĩ ma andũ aaganu,","poem":1},{"text":"nĩahingaga aciirithania maitho.","poem":2},{"lineBreak":true},{"text":"Akorwo ti we-rĩ, nũũ wĩkaga ũguo?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Matukũ makwa marahanyũka gũkĩra mũkinyia-ũhoro;","poem":1},{"text":"mombũkaga matarĩ na gĩkeno o na kĩnini.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mahĩtũkaga na ihenya mũno ta tũtarũ twa irura,","poem":1},{"noteId":4},{"text":"kana ta nderi igũcuuhũkĩra kĩndũ gĩa kũrĩa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ingiuga atĩrĩ, ‘Nĩngũriganĩrwo nĩ mateta makwa,","poem":1},{"text":"nĩngũtiga gũtukia gĩthiithi, ngene,’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"no ngeetigĩra mĩnyamaro yakwa yothe,","poem":1},{"text":"nĩgũkorwo nĩnjũũĩ ndũkandua atĩ ndiĩhĩtie.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Kuona atĩ nĩndĩkĩtie gũtuuo mũhĩtia-rĩ,","poem":1},{"text":"nĩ kĩĩ gĩgũtũma ndĩĩnogie tũhũ?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"O na ingĩĩthamba na thabuni,","poem":1},{"text":"na ndĩĩthambe moko na igata-rĩ,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"no ũndikirie irima rĩa gĩcoro","poem":1},{"text":"nĩgeetha o na nguo ciakwa iithũũre.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"“We ti mũndũ ta niĩ atĩ nĩguo ndĩmũcookerie,","poem":1},{"text":"nĩguo tũngʼethanĩre igooti-inĩ.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Naarĩ korwo nĩ harĩ mũndũ ũngĩtũiguithania,","poem":1},{"text":"atũigĩrĩre guoko gwake ithuĩ eerĩ,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"mũndũ wa kũnjehereria rũthanju rwa Ngai,","poem":1},{"text":"nĩgeetha ndigacooke kũmakio nĩ itebeebania rĩake.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Hĩndĩ ĩyo nĩingĩacooka kwaragia itekũmwĩtigĩra,","poem":1},{"text":"no ũrĩa ndariĩ rĩu-rĩ, ndingĩhota.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":4,"caller":"+","text":"Tũtarũ tũtaarĩ tũnene twa ithanjĩ twathondekagĩrwo Misiri.","reference":{"chapter":9,"verse":26}}]},"thisChapterLink":"/api/kik_bib/JOB/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/JOB/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/JOB/8.json","previousChapterAudioLinks":{},"numberOfVerses":35}