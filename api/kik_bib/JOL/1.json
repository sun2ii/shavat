{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"JOL","translationId":"kik_bib","name":"Joeli","commonName":"Joeli","title":"JOELI","order":29,"numberOfChapters":3,"sha256":"432f250a57a06e580a4f8a2064f1d6d9f67401b21d1e74fac0d62acee2fd623a","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/kik_bib/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Ĩno nĩyo ndũmĩrĩri ya Jehova, ĩrĩa yakinyĩrĩire Joeli mũrũ wa Pethueli."]},{"type":"heading","content":["Gũtharĩkĩrwo nĩ Ngigĩ"]},{"type":"verse","number":2,"content":[{"text":"Ta iguai ũhoro, inyuĩ athuuri;","poem":1},{"text":"o na inyuĩ inyuothe arĩa mũtũũraga bũrũri ũyũ thikĩrĩriai.","poem":2},{"text":"Kũrĩ gwekĩka ũndũ ta ũyũ matukũ-inĩ manyu,","poem":1},{"text":"o na kana matukũ-inĩ ma maithe manyu ma tene?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Heei ciana cianyu ũhoro ũcio,","poem":1},{"text":"na mũreke ciana cianyu ciĩre ciana ciacio,","poem":2},{"lineBreak":true},{"text":"nacio ciana ciacio ikeera rũciaro rũrĩa rũkaarũmĩrĩra.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kĩndũ kĩrĩa gĩtigĩtio nĩ mũrumbĩ wa ngigĩ-rĩ,","poem":1},{"text":"nĩkĩrĩtwo nĩ ngigĩ iria nene;","poem":2},{"text":"kĩrĩa gĩtigĩtio nĩ ngigĩ iria nene-rĩ,","poem":1},{"text":"nĩkĩrĩtwo nĩ itono;","poem":2},{"text":"kĩrĩa itono icio itigĩtie-rĩ,","poem":1},{"text":"nĩkĩrĩtwo nĩ ngigĩ ingĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Arahũkai, inyuĩ arĩĩu aya mũrĩre!","poem":1},{"text":"Girĩkai, inyuothe anyui a ndibei;","poem":2},{"text":"girĩkai nĩ ũndũ wa ndibei ya mũhihano,","poem":1},{"text":"nĩgũkorwo nĩĩhurĩtio kuuma tũnua-inĩ twanyu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Harĩ rũrĩrĩ rũtharĩkĩire bũrũri wakwa,","poem":1},{"text":"rũrĩrĩ rũrĩ hinya na rũtangĩtarĩka;","poem":2},{"text":"rũrĩ na magego mahaana ta ma mũrũũthi,","poem":1},{"text":"magego manene ta ma mũrũũthi wa mũgoma.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nĩ rwanangĩte mĩthabibũ yakwa,","poem":1},{"text":"na rũgathũkia mĩkũyũ yakwa.","poem":2},{"text":"Nĩrũmĩũnũrĩte makoni rũkamate,","poem":1},{"text":"rũgatiga honge ciayo irĩ nyũnũre.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Cakayai ta mũirĩtu gathirange ehumbĩte nguo ya ikũnia,","poem":1},{"text":"akĩrĩrĩra mũthuuriwe wa wĩthĩ wake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Maruta ma ngano, o na maruta ma kũnyuuo","poem":1},{"text":"nĩmatigĩte kũrehwo nyũmba-inĩ ya Jehova.","poem":2},{"text":"Athĩnjĩri-Ngai nĩmaracakaya,","poem":1},{"text":"o acio matungatagĩra Jehova.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mĩgũnda nĩmĩthũkie,","poem":1},{"text":"nayo thĩ ĩkooma;","poem":2},{"text":"ngano nĩnyanange,","poem":1},{"text":"ndibei ya mũhihano nĩĩniarĩte,","poem":2},{"lineBreak":true},{"text":"o namo maguta magathira.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ũrwoi nĩ hinya, inyuĩ arĩmi,","poem":1},{"text":"na mũgirĩke, inyuĩ arĩa mũkũragia mĩthabibũ;","poem":2},{"text":"mwĩthikĩrei nĩ ũndũ wa ngano na cairi,","poem":1},{"text":"tondũ magetha ma mĩgũnda nĩmanangĩtwo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mĩthabibũ nĩyũmĩte,","poem":1},{"text":"nayo mĩkũyũ ĩkahooha;","poem":2},{"text":"mĩkomamanga, na mĩtende, na mĩcungwa:","poem":1},{"text":"ĩĩ, mĩtĩ yothe ya mũgũnda nĩyũmĩte.","poem":2},{"text":"Ti-itherũ gĩkeno kĩa andũ a thĩ nĩgĩthirĩte.","poem":1}]},{"type":"heading","content":["Andũ kwĩrwo Meerire"]},{"type":"verse","number":13,"content":[{"text":"Mwĩhumbei nguo cia makũnia, inyuĩ athĩnjĩri-Ngai, na mũcakae;","poem":1},{"text":"girĩkai, inyuĩ mũtungataga kĩgongona-inĩ.","poem":2},{"text":"Ũkai, mũraare mwĩhumbĩte nguo cia makũnia,","poem":1},{"text":"inyuĩ mũtungatagĩra Ngai wakwa;","poem":2},{"text":"nĩgũkorwo maruta ma ngano, na maruta ma kũnyuuo-rĩ,","poem":1},{"text":"nĩmagĩte gũtwarwo nyũmba-inĩ ya Ngai wanyu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Anĩrĩrai gĩathĩ kĩamũre gĩa kwĩhinga kũrĩa irio;","poem":1},{"text":"ĩtanai kĩũngano gĩtheru.","poem":2},{"text":"Tũmanĩrai athuuri","poem":1},{"text":"na andũ arĩa othe matũũraga bũrũri ũyũ","poem":2},{"text":"moke nyũmba ya Jehova Ngai wanyu,","poem":1},{"text":"nĩguo mũkaĩre Jehova.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Wũi, kaĩ mũthenya ũcio ũrĩ na haaro-ĩ!","poem":1},{"text":"Nĩgũkorwo mũthenya wa Jehova","poem":2},{"noteId":0},{"text":"ũrĩ hakuhĩ;","poem":2},{"text":"mũthenya ũcio ũgooka ta mwanangĩko","poem":1},{"text":"uumĩte kũrĩ Mwene-Hinya-Wothe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Githĩ irio itithirĩte","poem":1},{"text":"o tũkĩĩonagĩra na maitho maitũ:","poem":2},{"text":"gĩkeno na gũcanjamũka","poem":1},{"text":"igathira kuuma kũu nyũmba ya Ngai witũ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mbeũ nĩkũbutha irabuthĩra","poem":1},{"text":"tĩĩri-inĩ kũrĩa ihaandĩtwo.","poem":2},{"text":"Nyũmba cia kũigwo indo nĩnyanange,","poem":1},{"text":"namo makũmbĩ ma irio makamomorwo,","poem":2},{"lineBreak":true},{"text":"nĩgũkorwo ngano nĩyũmĩte.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kaĩ ngʼombe nĩicaaĩte-ĩ.","poem":1},{"text":"Ndũũru cia ngʼombe iroorũũra o ũguo,","poem":2},{"text":"tondũ itirĩ na gwa kũrĩithio;","poem":1},{"text":"o nacio ndũũru cia ngʼondu nĩirathĩĩnĩka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Wee Jehova, nĩwe ndĩrakaĩra,","poem":1},{"text":"nĩgũkorwo mwaki nĩũniinĩte ũrĩithio wa werũ-inĩ,","poem":2},{"text":"nacio nĩnĩmbĩ igacina mĩtĩ yothe ya gĩthaka.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"O na nyamũ cia gĩthaka nĩirakwanĩria;","poem":1},{"text":"tũrũũĩ nĩtũhwĩte,","poem":2},{"lineBreak":true},{"text":"naguo mwaki nĩũniinĩte ũrĩithio wa werũ-inĩ.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Mũthenya wa Jehova nĩ mũthenya ũrĩa Ngai agatooria thũ ciake, na rĩmwe ũtũmagĩrwo kuuga mũthenya ũrĩa Kristũ agaacooka thĩ.","reference":{"chapter":1,"verse":15}}]},"thisChapterLink":"/api/kik_bib/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}