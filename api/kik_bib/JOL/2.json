{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"JOL","translationId":"kik_bib","name":"Joeli","commonName":"Joeli","title":"JOELI","order":29,"numberOfChapters":3,"sha256":"432f250a57a06e580a4f8a2064f1d6d9f67401b21d1e74fac0d62acee2fd623a","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/kik_bib/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"heading","content":["Mbũtũ ya Ngigĩ"]},{"type":"verse","number":1,"content":[{"text":"Huhai karumbeta kũu Zayuni,","poem":1},{"text":"na muuge mbu kũu kĩrĩma-inĩ gĩakwa gĩtheru!","poem":2},{"text":"Andũ arĩa othe matũũraga bũrũri ũyũ nĩmainaine,","poem":1},{"text":"nĩgũkorwo mũthenya wa Jehova nĩũrooka.","poem":2},{"text":"Mũthenya ũcio nĩ ta mũkinyu:","poem":1}]},{"type":"verse","number":2,"content":[{"text":"nĩ mũthenya wa nduma na wa mairia,","poem":2},{"lineBreak":true},{"text":"mũthenya wa matu na nduma ndumanu.","poem":2},{"text":"Mbũtũ nene na ĩrĩ hinya ya ngigĩ nĩĩroka","poem":1},{"text":"ta ruoro rũgĩtema irĩma-inĩ,","poem":2},{"text":"na gũtirĩ kwagĩa ĩngĩ tayo kuuma tene,","poem":1},{"text":"na gũtikagĩa ĩngĩ tayo matukũ marĩa magooka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mbere yacio nĩ mwaki wa kũniina,","poem":1},{"text":"na thuutha wacio nĩ rũrĩrĩmbĩ rũracina bũrũri.","poem":2},{"text":"Bũrũri ũrĩa ũrĩ mbere yacio ũhaana ta mũgũnda wa Edeni,","poem":1},{"text":"no thuutha wacio ũgaatigwo ũhaana ta werũ mwanangĩku:","poem":2},{"lineBreak":true},{"text":"gũtirĩ kĩndũ kĩngĩĩhonokia harĩ cio.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mũhianĩre wacio nĩ ta wa mbarathi cia ita;","poem":1},{"text":"ihanyũkaga ta thigari ihaicĩte mbarathi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Irĩ na mũrurumo ta wa ngaari cia ita;","poem":1},{"text":"irũgaga tũcũmbĩrĩ twa irĩma","poem":2},{"text":"ta mwaki ũracarĩka ũgĩcina itira cia ngano,","poem":1},{"text":"ihaana ta mbũtũ ya ita ĩrĩ hinya ĩthagathagĩtwo nĩ ũndũ wa mbaara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Na rĩrĩa cionwo-rĩ, ndũrĩrĩ nĩinyiitagwo nĩ ruo rũnene;","poem":1},{"text":"andũ othe magatukia ithiithi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Itharĩkagĩra ta njamba cia ita;","poem":1},{"text":"ihaicaga thingo ta thigari.","poem":2},{"text":"Ithiiaga ciothe na mĩhari,","poem":1},{"text":"itekũhĩtia kũrĩa cierekeire.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Itihatĩkanaga ĩmwe na ĩrĩa ĩngĩ;","poem":1},{"text":"o ĩmwe ĩthiiaga yerekeire mbere.","poem":2},{"text":"Itoonyaga kũrĩa kũgitĩre,","poem":1},{"text":"gũtirĩ kĩndũ kĩngĩcigiria.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iguthũkagĩra itũũra inene,","poem":1},{"text":"igatengʼerera rũthingo-inĩ.","poem":2},{"text":"Ikahaica, igatoonya nyũmba,","poem":1},{"text":"igatoonyera ndirica ta aici.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Thĩ ĩthingithaga mbere yacio,","poem":1},{"text":"na igũrũ rĩkainaina,","poem":2},{"text":"riũa na mweri ikagĩa nduma,","poem":1},{"text":"na njata igatiga kwara.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jehova araruruma ta ngwa","poem":1},{"text":"atongoretie ita;","poem":2},{"text":"thigari ciake itingĩtarĩka,","poem":1},{"text":"arĩa maathĩkagĩra watho wake marĩ hinya.","poem":2},{"text":"Mũthenya wa Jehova nĩ mũnene,","poem":1},{"text":"na nĩ wa gwĩtigĩrwo.","poem":2},{"lineBreak":true},{"text":"Nũũ ũngĩkĩhota kũwĩtiiria?","poem":2}]},{"type":"heading","content":["Tembũrangai Ngoro Cianyu"]},{"type":"verse","number":12,"content":[{"text":"Jehova aroiga atĩrĩ,","poem":1},{"text":"“O na rĩu-rĩ, njokererai na ngoro cianyu ciothe,","poem":2},{"lineBreak":true},{"text":"mwĩhingĩte kũrĩa irio, mũkĩrĩraga na mũgĩcakayaga.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tembũrangai ngoro cianyu","poem":1},{"text":"no ti nguo cianyu.","poem":2},{"text":"Cookererai Jehova Ngai wanyu,","poem":1},{"text":"nĩgũkorwo nĩ mũtugi na nĩ mũigua-tha,","poem":2},{"text":"ndahiũhaga kũrakara, na aiyũrĩtwo nĩ wendo,","poem":1},{"text":"na nĩericũkagwo, akaaga gwĩka andũ ũũru.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nũũ ũngĩmenya? Hihi no agarũrũke na aigue tha,","poem":1},{"text":"atige atũrathima:","poem":2},{"text":"atũhe indo iria irutagwo magongona ma mũtu,","poem":1},{"text":"na iria irutagwo magongona ma kũnyuuo,","poem":2},{"lineBreak":true},{"text":"cia kũrutĩrwo Jehova Ngai wanyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Huhai karumbeta kũu Zayuni,","poem":1},{"text":"anĩrĩrai gĩathĩ kĩamũre gĩa kwĩhinga kũrĩa irio,","poem":2},{"lineBreak":true},{"text":"ĩtanai kĩũngano gĩtheru.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Cookanĩrĩriai andũ,","poem":1},{"text":"amũrai kĩũngano kĩu;","poem":2},{"text":"rehei athuuri hamwe,","poem":1},{"text":"na mũcookanĩrĩrie ciana, o na tũkenge tũrĩa tũronga.","poem":2},{"text":"Mũhikania nĩoime kanyũmba gake,","poem":1},{"text":"nake mũhiki nĩoime kĩrĩrĩ gĩake.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Athĩnjĩri-Ngai, arĩa matungataga mbere ya Jehova,","poem":1},{"text":"nĩmarĩrĩre gatagatĩ ga gĩthaku kĩa Hekarũ na kĩgongona.","poem":2},{"text":"Nĩmoige atĩrĩ, “Kĩhonokie andũ aku, Wee Jehova.","poem":1},{"text":"Ndũkareke igai rĩaku rĩtuĩke kĩndũ gĩa kũnyũrũrio,","poem":2},{"lineBreak":true},{"text":"kana tuunagwo thimo gatagatĩ-inĩ ka ndũrĩrĩ.","poem":2},{"text":"Nĩ kĩĩ kĩngĩtũma ndũrĩrĩ ciũranagie atĩrĩ,","poem":1},{"text":"‘Kaĩ Ngai wao akĩrĩ ha?’ ”","poem":2}]},{"type":"heading","content":["Icookia rĩa Jehova"]},{"type":"verse","number":18,"content":[{"text":"Ningĩ Jehova nĩakaigua ũiru nĩ ũndũ wa bũrũri wake,","poem":1},{"text":"na aiguĩre andũ ake tha.","poem":2}]},{"type":"verse","number":19,"content":["Jehova nĩakamacookeria atĩrĩ:",{"text":"“Nĩngũmũrehithĩria ngano, na ndibei ya mũhihano, na maguta,","poem":1},{"text":"indo cia kũmũigana biũ;","poem":2},{"text":"na ndigacooka kũreka mũtuĩke","poem":1},{"text":"kĩndũ gĩa kũnyũrũrio nĩ ndũrĩrĩ rĩngĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Nĩngaingata mbũtũ ĩyo ya ita ya kuuma gathigathini ĩthiĩ kũraya na inyuĩ,","poem":1},{"text":"ndĩmĩtindĩkĩrĩrie bũrũri mũũmũ na mũhĩnju, ũtangĩgĩa irio.","poem":2},{"text":"Mbũtũ yao ĩrĩa ĩtoongoretie ndĩmĩitĩrĩre iria-inĩ rĩa mwena wa irathĩro,","poem":1},{"text":"na ĩrĩa ĩrĩ thuutha ndĩmĩitĩrĩre iria-inĩ rĩa mwena wa ithũĩro.","poem":2},{"text":"Nakĩo kĩheera gĩa ciimba ciayo kĩambate na igũrũ;","poem":1},{"text":"mũnungo wayo naguo ũiguĩke.”","poem":2},{"lineBreak":true},{"text":"Ti-itherũ nĩekĩte maũndũ manene.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wee bũrũri, tiga gwĩtigĩra;","poem":1},{"text":"kena na ũcanjamũke.","poem":2},{"text":"Ti-itherũ Jehova nĩekĩte maũndũ manene.","poem":1}]},{"type":"verse","number":22,"content":[{"text":"Inyuĩ nyamũ cia gĩthaka, tigai gwĩtigĩra,","poem":2},{"lineBreak":true},{"text":"nĩgũkorwo ũrĩithio wa werũ-inĩ nĩũramera nyeki.","poem":2},{"text":"Mĩtĩ nĩĩraciara maciaro mayo,","poem":1},{"text":"nayo mĩkũyũ na mĩthabibũ ĩgaciara mũno.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Inyuĩ andũ a Zayuni, canjamũkai,","poem":1},{"text":"mũkenere Jehova Ngai wanyu,","poem":2},{"text":"nĩgũkorwo nĩamũheete mbura ya mbere","poem":1},{"text":"nĩ ũndũ wa ũthingu wake.","poem":2},{"text":"Nĩamuurĩirie mbura nyingĩ","poem":1},{"text":"ya mbere na ya thuutha, o ta mbere.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nacio ihuhĩro cia ngano nĩikaiyũra ngano;","poem":1},{"text":"mĩtũngi nayo nĩĩkaiyũrĩrĩra","poem":2},{"text":"ndibei ya mũhihano na maguta.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Nĩngamũrĩha mĩaka ĩrĩa yothe irio cianyu ciarĩirwo nĩ ngigĩ:","poem":1},{"text":"ngigĩ iria nene, na itono cia ngigĩ,","poem":2},{"text":"na ngigĩ iria ingĩ, na mĩrumbĩ ya ngigĩ;","poem":1},{"text":"icio nĩ mbũtũ ciakwa nene cia ita iria ndaatũmĩte thĩinĩ wanyu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nĩmũkagĩa na irio nyingĩ cia kũrĩa, o nginya mũhũũne,","poem":1},{"text":"na inyuĩ nĩmũkagoocaga rĩĩtwa rĩa Jehova Ngai wanyu,","poem":2},{"lineBreak":true},{"text":"ũrĩa ũmwĩkĩire maũndũ ma magegania;","poem":2},{"text":"andũ akwa matigacooka gũconorithio rĩngĩ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Hĩndĩ ĩyo nĩmũkamenya atĩ niĩ ndĩ thĩinĩ wa Isiraeli,","poem":1},{"text":"na atĩ niĩ nĩ niĩ Jehova Ngai wanyu,","poem":2},{"lineBreak":true},{"text":"na atĩ gũtirĩ ũngĩ;","poem":2},{"text":"andũ akwa matigacooka gũconorithio rĩngĩ.","poem":1}]},{"type":"heading","content":["Mũthenya wa Jehova"]},{"type":"verse","number":28,"content":[{"text":"“Na thuutha wa maũndũ macio-rĩ,","poem":1},{"text":"nĩngaitĩrĩria andũ othe Roho wakwa.","poem":2},{"text":"Ariũ anyu na airĩtu anyu nĩmakarathaga mohoro,","poem":1},{"text":"nao athuuri anyu nĩmakarootaga irooto,","poem":2},{"lineBreak":true},{"text":"nao aanake anyu monage cioneki.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"O na ningĩ ndungata ciakwa cia arũme, na cia andũ-a-nja,","poem":1},{"text":"nĩngaciitĩrĩria Roho wakwa matukũ-inĩ macio.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Nĩngonania morirũ kũu igũrũ, o na gũkũ thĩ,","poem":1},{"text":"namo nĩ ma thakame, na ma mwaki,","poem":2},{"lineBreak":true},{"text":"o na ma ndogo ĩkwambata na igũrũ.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Riũa nĩrĩkagarũrwo rĩtuĩke nduma,","poem":1},{"text":"naguo mweri ũtuĩke ta thakame,","poem":2},{"lineBreak":true},{"text":"mbere ya mũthenya ũcio mũnene na wa kũmakania wa Jehova ũtanakinya.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Na nĩgũgakinya atĩrĩ,","poem":1},{"text":"atĩ mũndũ o wothe ũgaakaĩra rĩĩtwa rĩa Jehova nĩakahonoka;","poem":2},{"text":"nĩgũkorwo kĩrĩma-inĩ gĩa Zayuni na Jerusalemu","poem":1},{"text":"nĩgũgakorwo na ũhonokio,","poem":2},{"lineBreak":true},{"text":"o ta ũrĩa Jehova oigĩte,","poem":2},{"text":"atĩ gatagatĩ-inĩ ka matigari","poem":1},{"text":"nĩgũgakorwo na arĩa Jehova eĩtĩire.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}