{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"JON","translationId":"kik_bib","name":"Jona","commonName":"Jona","title":"JONA","order":32,"numberOfChapters":4,"sha256":"89e085c11bb68c50b9e92d202cb9890a08d93d28206f59b53f4be15ff14aa01b","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/kik_bib/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Ihooya rĩa Jona"]},{"type":"verse","number":1,"content":["Na rĩrĩ, Jona arĩ kũu nda ya thamaki ĩyo nene mũno akĩhooya Jehova Ngai wake."]},{"type":"verse","number":2,"content":["Akiuga atĩrĩ:",{"text":"“Ndakaĩire Jehova ndĩ mĩnyamaro-inĩ,","poem":1},{"text":"nake akĩnjĩtĩka.","poem":2},{"text":"Ngĩhooya ũteithio ndĩ o kũu mbĩrĩra-inĩ kũrĩa kũriku,","poem":1},{"text":"nawe ũkĩigua gũkaya gwakwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wee wathinĩkanirie nginya kũrĩa kũriku,","poem":1},{"text":"o gatagatĩ ka iria rĩrĩa inene,","poem":2},{"lineBreak":true},{"text":"naguo mũiyũro wa maaĩ ũgĩĩthiũrũrũkĩria;","poem":2},{"text":"makũmbĩ maku mothe","poem":1},{"text":"na ndiihũ cia maaĩ ikĩĩhubanĩria.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngiuga atĩrĩ, ‘Ndĩ mũingate,","poem":1},{"text":"ngeherio maitho-inĩ maku;","poem":2},{"text":"no rĩrĩ, nĩngerorera","poem":1},{"text":"hekarũ yaku theru hĩndĩ ĩngĩ.’","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Maaĩ macio maandigiicĩirie makenda kũnjũraga,","poem":1},{"text":"nakuo kũu kũriku gũgaathiũrũrũkĩria;","poem":2},{"lineBreak":true},{"text":"riya rĩa iria-inĩ rĩeohereire mũtwe wakwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngĩrikĩra o nginya itina-inĩ cia irĩma;","poem":1},{"text":"thĩ ya kũu rungu ĩkĩĩhingĩrĩria nginya tene.","poem":2},{"text":"No Wee Jehova, Ngai wakwa,","poem":1},{"text":"nĩwarutire muoyo wakwa kuuma irima rĩu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Hĩndĩ ĩrĩa muoyo wakwa wathiraga,","poem":1},{"text":"nĩndakũririkanire Wee Jehova,","poem":2},{"text":"namo mahooya makwa magĩkinya o harĩwe,","poem":1},{"text":"o thĩinĩ wa hekarũ yaku theru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Andũ arĩa mahooyaga mĩhianano ya tũhũ,","poem":1},{"text":"nĩmoragĩrwo nĩ ũtugi ũrĩa ũngĩkorwo ũrĩ wao.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"No niĩ-rĩ, ndĩrĩkũrutagĩra igongona","poem":1},{"text":"ngĩinaga rwĩmbo rwa gũcookia ngaatho.","poem":2},{"text":"Nĩngahingia mĩĩhĩtwa yakwa ĩrĩa niĩ ndanehĩta.","poem":1},{"lineBreak":true},{"text":"Ũhonokio uumaga kũrĩ Jehova.”","poem":1}]},{"type":"verse","number":10,"content":["Nake Jehova agĩatha thamaki ĩyo nene, nayo ĩgĩtahĩka Jona thĩ nyũmũ."]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}