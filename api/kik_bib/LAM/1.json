{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"LAM","translationId":"kik_bib","name":"Macakaya","commonName":"Macakaya","title":"MACAKAYA","order":25,"numberOfChapters":5,"sha256":"d8a78d9299834b471498a5ff1aab0072c7ad8c06ab22aa4cddb9ce6cda8d7796","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/kik_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Hĩ! Kaĩ itũũra rĩu inene nĩrĩikarĩte rĩtiganĩirio,","poem":1},{"text":"o rĩu rĩratũire rĩiyũrĩte andũ-ĩ!","poem":2},{"text":"Kaĩ rĩĩkũhaana o ta mũtumia wa ndigwa,","poem":1},{"text":"ũcio ũraarĩ mũnene gatagatĩ ka ndũrĩrĩ-ĩ!","poem":2},{"text":"O we ũratũire arĩ mũthamaki-mũndũ-wa-nja ngʼongo-inĩ cia bũrũri-rĩ,","poem":1},{"text":"rĩu atuĩkĩte ngombo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ũtukũ araaraga akĩrĩra na ruo,","poem":1},{"text":"maithori makanyũrũrũkĩra makai-inĩ make.","poem":2},{"text":"Arĩa othe marendanĩte nake-rĩ,","poem":1},{"text":"hatirĩ o na ũmwe wa kũmũhooreria.","poem":2},{"text":"Arata ake othe nĩmamũkunyanĩire;","poem":1},{"text":"othe matuĩkĩte thũ ciake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Thuutha wa thĩĩna na mawĩra maritũ,","poem":1},{"text":"Juda nĩatwarĩtwo ithaamĩrio.","poem":2},{"text":"Atũũraga gatagatĩ ka ndũrĩrĩ;","poem":1},{"text":"agakĩaga handũ ha kũhurũka.","poem":2},{"text":"Arĩa othe mamũingatithagia nĩmamũkinyĩrĩire","poem":1},{"text":"arĩ hatĩka-inĩ ciake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Njĩra cia gũthiĩ Zayuni no macakaya,","poem":1},{"text":"nĩ ũndũ gũtirĩ andũ mookaga ciathĩ ciake iria njathane.","poem":2},{"text":"Matoonyero make mothe makirĩte ihooru,","poem":1},{"text":"athĩnjĩri-Ngai ake no gũcaaya maracaaya,","poem":2},{"text":"airĩtu ake no kũgirĩka,","poem":1},{"text":"nake arĩ na ruo rũnene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Amuku ake matuĩkĩte nĩo mamwathaga;","poem":1},{"text":"thũ ciake nĩcio igaacĩire.","poem":2},{"text":"Jehova nĩamũrehithĩirie kĩeha","poem":1},{"text":"nĩ ũndũ wa mehia make maingĩ.","poem":2},{"text":"Ciana ciake itahĩtwo igatwarwo bũrũri ũngĩ,","poem":1},{"text":"igatuĩka mĩgwate ya thũ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mwarĩ wa Zayuni nĩehereirwo nĩ riiri wake.","poem":1},{"text":"Anene ake mahaanĩte ta thwariga ciagĩte ũrĩithio;","poem":2},{"text":"moorĩte matarĩ na hinya,","poem":1},{"text":"moimĩtwo thuutha nĩ arĩa mamaingatithĩtie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Matukũ-inĩ ma thĩĩna na kũũrũũra gwake-rĩ,","poem":1},{"text":"Jerusalemu aririkanaga igĩĩna ciothe","poem":2},{"lineBreak":true},{"text":"iria ciarĩ ciake matukũ ma tene.","poem":2},{"text":"Rĩrĩa andũ ake maagũire moko-inĩ ma thũ-rĩ,","poem":1},{"text":"gũtiarĩ mũndũ o na ũmwe wa kũmũteithia.","poem":2},{"text":"Thũ ciake ikĩmũrora,","poem":1},{"text":"igĩthekerera mwanangĩko wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Jerusalemu nĩehĩtie mũno,","poem":1},{"text":"na nĩ ũndũ ũcio akanyiitwo nĩ thaahu.","poem":2},{"text":"Arĩa othe maamũtĩĩte-rĩ, rĩu nĩmamũnyararĩte,","poem":1},{"text":"nĩ ũndũ nĩmonete njaga yake;","poem":2},{"text":"we mwene no gũcaaya aracaaya,","poem":1},{"text":"na akamahutatĩra.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Gĩko gĩake nĩkĩnyiitĩte nguo ciake;","poem":1},{"text":"nake ndaigana gwĩcũũrania mũtũũrĩre wake wa thuutha.","poem":2},{"text":"Kũgũa gwake kwarĩ gwa kũmakania;","poem":1},{"text":"gũtiarĩ mũndũ o na ũmwe wa kũmũhooreria.","poem":2},{"text":"“Wee Jehova, ta kĩone mathĩĩna makwa,","poem":1},{"text":"nĩgũkorwo thũ yakwa nĩhootanĩte.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Thũ ĩyo nĩyegwatĩire","poem":1},{"text":"igĩĩna-inĩ ciake ciothe;","poem":2},{"text":"nake akĩĩonera ndũrĩrĩ iria itooĩ Ngai","poem":1},{"text":"igĩtoonya handũ harĩa hake haamũre:","poem":2},{"text":"o arĩa wee wathanĩte","poem":1},{"text":"matikanatoonye kĩũngano-inĩ gĩaku.","poem":2},{"noteId":0}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Andũ ake othe nĩgũcaaya maracaaya","poem":1},{"text":"magĩetha gĩa kũrĩa;","poem":2},{"text":"magagĩkũũrania igĩĩna ciao","poem":1},{"text":"na irio nĩguo matũũre muoyo.","poem":2},{"text":"“Wee Jehova, ta cũrania wone,","poem":1},{"text":"nĩgũkorwo ndĩ mũmeneku.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Atĩrĩrĩ, inyuĩ mũrahĩtũka,","poem":1},{"text":"anga mũkuona ũndũ ũyũ ta ũtamũkoniĩ?","poem":2},{"text":"Ta rorai muone.","poem":1},{"text":"Nĩ kũrĩ thĩĩna ũiganaine na thĩĩna ũyũ wakwa,","poem":2},{"text":"thĩĩna ũrĩa njigĩrĩirwo,","poem":1},{"text":"o ũcio Jehova aandehithĩirie","poem":2},{"lineBreak":true},{"text":"mũthenya wa marakara make mahiũ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“We aandũmĩire mwaki uumĩte igũrũ,","poem":1},{"text":"akĩũikũrũkia, ũgĩtoonya nginya mahĩndĩ-inĩ makwa.","poem":2},{"text":"Aambĩire magũrũ makwa wabu wa kũmatega, akĩĩhũndũra.","poem":1},{"text":"Nake agĩtũma nyiitwo nĩ ihooru, ngĩkĩringĩka mũthenya wothe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Mehia makwa mohanĩtio, magatuĩka icooki.","poem":1},{"text":"Moko make mamogothanĩtie hamwe.","poem":2},{"text":"Magagĩĩkĩrwo ngingo-inĩ yakwa,","poem":1},{"text":"nake Mwathani agakĩĩniina hinya.","poem":2},{"text":"Akaaneana moko-inĩ ma arĩa itangĩhota gwĩtiiria.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Mwathani nĩaregete","poem":1},{"text":"njamba ciothe cia ita iria ndĩ nacio,","poem":2},{"text":"akanjĩtĩra ita nĩguo rĩnjũkĩrĩre,","poem":1},{"text":"rĩmemende aanake akwa.","poem":2},{"text":"Kĩhihĩro-inĩ gĩake kĩa ndibei-rĩ,","poem":1},{"text":"Mwathani nĩarangĩrĩirie","poem":2},{"text":"Mwarĩ Gathirange wa Juda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Maũndũ macio nĩmo maratũma ndĩre,","poem":1},{"text":"namo maitho makwa makanyũrũrũkia maithori.","poem":2},{"text":"Gũtirĩ mũndũ ũrĩ hakuhĩ wa kũũhooreria,","poem":1},{"text":"gũtirĩ mũndũ wa kũnyũmĩrĩria ngoro.","poem":2},{"text":"Ciana ciakwa ituĩkĩte cia kũnyamarĩka","poem":1},{"text":"tondũ thũ nĩyo ĩhootanĩte.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Zayuni atambũrũkĩtie moko,","poem":1},{"text":"no gũtirĩ mũndũ wa kũmũhooreria.","poem":2},{"text":"Jehova nĩathanĩte ũhoro wa Jakubu","poem":1},{"text":"atĩ arĩa mariganĩtie nake matuĩke thũ ciake;","poem":2},{"text":"Jerusalemu nĩatuĩkĩte","poem":1},{"text":"kĩndũ kĩrĩ thaahu gatagatĩ-inĩ kao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Jehova nĩ mũthingu,","poem":1},{"text":"no rĩrĩ, nĩndaremeire watho wake.","poem":2},{"text":"Thikĩrĩriai, inyuĩ andũ othe,","poem":1},{"text":"na mũrore gũthĩĩnĩka gwakwa.","poem":2},{"text":"Aanake akwa na airĩtu akwa","poem":1},{"text":"nĩmatahĩtwo magatwarwo thĩ ngʼeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Ndaatũmanĩire arĩa twarĩ ngwatanĩro,","poem":1},{"text":"no-o makĩngunyanĩra.","poem":2},{"text":"Athĩnjĩri-Ngai akwa, na athuuri akwa","poem":1},{"text":"marakuĩrĩire itũũra-inĩ rĩu inene,","poem":2},{"text":"o magĩcaragia irio cia kũmatũũria muoyo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Wee Jehova, ta rora wone ũrĩa ndĩ hatĩka-inĩ!","poem":1},{"text":"Nĩndĩratangĩka thĩinĩ wakwa,","poem":2},{"text":"na ngathĩĩnĩka thĩinĩ wa ngoro yakwa,","poem":1},{"text":"nĩ ũndũ ngoretwo ndĩ mũremi mũno.","poem":2},{"text":"Na kũu nja, hiũ cia njora nĩirooraga andũ,","poem":1},{"text":"nakuo thĩinĩ no gĩkuũ kũrĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Andũ nĩmaiguĩte mũcaayo wakwa,","poem":1},{"text":"no gũtirĩ mũndũ o na ũmwe wa kũũhooreria.","poem":2},{"text":"Thũ ciakwa ciothe nĩciguĩte ũhoro wa hatĩka ciakwa,","poem":1},{"text":"nacio igakena nĩ ũndũ wa ũguo wĩkĩte.","poem":2},{"text":"Nawe gĩkinyie mũthenya ũrĩa wanĩrĩire","poem":1},{"text":"nĩguo nao mahaane ta niĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Waganu wao wothe nĩũgĩkinye mbere yaku,","poem":1},{"text":"nawe ũmeke o ta ũrĩa ũnjĩkĩte","poem":2},{"text":"nĩ ũndũ wa mehia makwa mothe.","poem":1},{"lineBreak":true},{"text":"Mĩcaayo yakwa nĩ mĩingĩ,","poem":1},{"text":"nayo ngoro yakwa nĩĩringĩkĩte.”","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Andũ a ndũrĩrĩ matietĩkĩrĩtio gũtoonya hekarũ matikamĩthaahie (Ezek 44:7-9).","reference":{"chapter":1,"verse":10}}]},"thisChapterLink":"/api/kik_bib/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}