{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"LAM","translationId":"kik_bib","name":"Macakaya","commonName":"Macakaya","title":"MACAKAYA","order":25,"numberOfChapters":5,"sha256":"d8a78d9299834b471498a5ff1aab0072c7ad8c06ab22aa4cddb9ce6cda8d7796","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/kik_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Hĩ! Kaĩ Mwathani nĩakĩhumbĩrĩte Mwarĩ wa Zayuni","poem":1},{"text":"na itu rĩa marakara make-ĩ!","poem":2},{"text":"Nĩatungumanĩtie riiri wa Isiraeli,","poem":1},{"text":"akaũharũrũkia kuuma igũrũ nginya thĩ;","poem":2},{"text":"ndaaririkanire gaturwa ka magũrũ make,","poem":1},{"text":"mũthenya ũrĩa aarakarire.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mwathani-rĩ, nĩameretie","poem":1},{"text":"itũũro ciothe cia Jakubu atarĩ na tha;","poem":2},{"text":"nĩamomorete ciĩhitho iria nũmu","poem":1},{"text":"cia Mwarĩ wa Juda arĩ na marakara.","poem":2},{"text":"Nĩagũithĩtie ũthamaki wa Mwarĩ wa Juda,","poem":1},{"text":"na akagũithia anene ake, akamaconorithia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Rũhĩa rwa Isiraeli ruothe","poem":1},{"text":"arũrengete arĩ na marakara mahiũ.","poem":2},{"text":"Nĩeheretie guoko gwake kwa ũrĩo,","poem":1},{"text":"gũkameeherera o rĩrĩa thũ ciamakuhĩrĩria.","poem":2},{"text":"Nĩgũcina acinĩte Jakubu ta mwaki ũkũrĩrĩmbũka,","poem":1},{"text":"ũrĩa ũcinaga kĩrĩa gĩothe kĩrĩ hakuhĩ naguo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ageetete ũta wake o ta thũ;","poem":1},{"text":"guoko gwake kwa ũrĩo nĩ kwĩhaarĩirie.","poem":2},{"text":"Arĩa othe maatũire makenagia maitho-rĩ,","poem":1},{"text":"amooragĩte o ta marĩ thũ;","poem":2},{"text":"hema ya Mwarĩ wa Zayuni","poem":1},{"text":"amĩitĩrĩirie mangʼũrĩ make mahaana ta mwaki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mwathani-rĩ, atuĩkĩte ta thũ;","poem":1},{"text":"nĩameretie Isiraeli.","poem":2},{"text":"Nĩameretie nyũmba ciake ciothe cia ũthamaki,","poem":1},{"text":"na akaananga ciĩhitho ciake iria nũmu.","poem":2},{"text":"Nĩaingĩhĩirie Mwarĩ wa Juda","poem":1},{"text":"gũcakaya na kũgirĩka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nĩonũhĩte gĩikaro gĩake ta mũgũnda;","poem":1},{"text":"nĩanangĩte handũ hake ha gũtũnganĩrwo.","poem":2},{"text":"Jehova nĩatũmĩte Zayuni ariganĩrwo","poem":1},{"text":"nĩ ciathĩ ciake iria njathane, o hamwe na Thabatũ ciake;","poem":2},{"text":"nĩ ũndũ wa marakara make mahiũ-rĩ,","poem":1},{"text":"akanyarara mũthamaki, o hamwe na mũthĩnjĩri-Ngai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mwathani nĩaregete kĩgongona gĩake,","poem":1},{"text":"na agatiganĩria handũ hake harĩa haamũre.","poem":2},{"text":"Nĩaneanĩte thingo cia nyũmba ciake cia ũthamaki kũrĩ thũ;","poem":1},{"text":"iraanĩrĩra irĩ thĩinĩ wa nyũmba ya Jehova,","poem":2},{"lineBreak":true},{"text":"o taarĩ mũthenya wa gĩathĩ kĩrĩa gĩathane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Jehova nĩatuire itua rĩa kũmomora","poem":1},{"text":"rũthingo rũrĩa rũthiũrũrũkĩirie Mwarĩ wa Zayuni.","poem":2},{"text":"Nĩatambũrũkirie rũrigi rwa gũthima,","poem":1},{"text":"na ndaagiririe guoko gwake gũtige kũrwananga.","poem":2},{"text":"Nĩatũmire njirigo na thingo icakaye;","poem":1},{"text":"o cierĩ igĩgĩtuĩka cia kwanangĩka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ihingo ciakuo nĩihorokeire na thĩ;","poem":1},{"text":"mĩgĩĩko yacio nĩamiunangĩte, akamĩananga.","poem":2},{"text":"Mũthamaki na anene akuo nĩmatahĩtwo magatwarwo ndũrĩrĩ-inĩ,","poem":1},{"text":"watho rĩu ndũrutanagwo,","poem":2},{"text":"na anabii akuo nĩmatigire kuona cioneki","poem":1},{"text":"ciumĩte kũrĩ Jehova.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Athuuri a kũu kwa Mwarĩ wa Zayuni","poem":1},{"text":"maikarĩte thĩ makirĩte ki;","poem":2},{"text":"nao nĩmehurĩirie rũkũngũ mĩtwe,","poem":1},{"text":"na makehumba nguo cia makũnia.","poem":2},{"text":"Airĩtu a Jerusalemu","poem":1},{"text":"mainamĩrĩire maturumithĩtie mĩtwe yao thĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Maitho makwa nĩmaroora nĩ kũrĩra,","poem":1},{"text":"ngatangĩka thĩinĩ wakwa,","poem":2},{"text":"naguo roho wakwa nĩũitũrũrĩirwo thĩ","poem":1},{"text":"nĩ ũndũ wa andũ akwa kwanangwo,","poem":2},{"text":"nĩgũkorwo twana na tũkenge","poem":1},{"text":"tũraringĩkĩra njĩra-inĩ cia itũũra rĩrĩa inene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tũrooria manyina atĩrĩ,","poem":1},{"text":"“Irio na ndibei irĩ ha?”","poem":2},{"text":"o tũkĩringĩkaga ta andũ matiihĩirio","poem":1},{"text":"njĩra-inĩ cia itũũra rĩrĩa inene,","poem":2},{"text":"o mĩoyo yatuo ĩgĩthiragĩra","poem":1},{"text":"moko-inĩ ma manyina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ingĩkiuga atĩa nĩ ũndũ waku?","poem":1},{"text":"Ingĩkũgerekania nakĩ,","poem":2},{"lineBreak":true},{"text":"wee Mwarĩ ũyũ wa Jerusalemu?","poem":2},{"text":"Ingĩkũhaanania nakĩ,","poem":1},{"text":"nĩguo ngũhoorerie,","poem":2},{"lineBreak":true},{"text":"wee Mwarĩ ũyũ Gathirange wa Zayuni?","poem":2},{"text":"Kĩronda gĩaku kĩrikĩte o ta iria.","poem":1},{"text":"Nũũ ũngĩhota gũkũhonia?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Cioneki iria anabii aku moonaga","poem":1},{"text":"ciarĩ cia tũhũ na cia maheeni;","poem":2},{"text":"matiigana kũmũguũrĩria mehia manyu","poem":1},{"text":"nĩguo magirĩrĩrie gũtahwo kwanyu.","poem":2},{"text":"Ndũmĩrĩri iria maamũheire","poem":1},{"text":"ciarĩ cia maheeni, na cia kũmũhĩtithia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ehĩtũkĩri othe mahũũraga hĩ;","poem":1},{"text":"mathekaga makĩinainagĩria Mwarĩ ũyũ wa Jerusalemu mĩtwe,","poem":2},{"text":"makĩũragia atĩrĩ:","poem":1},{"text":"“Ĩĩ rĩĩrĩ nĩrĩo itũũra inene rĩrĩa rĩetagwo","poem":2},{"text":"ũthaka ũrĩa mũkinyanĩru biũ,","poem":1},{"text":"na rĩgeetwo gĩkeno gĩa thĩ yothe?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Thũ ciaku ciothe","poem":1},{"text":"ciathamagia tũnua igũũkĩrĩre;","poem":2},{"text":"igũthekagĩrĩra na ikahagarania magego,","poem":1},{"text":"ikoiga atĩrĩ, “Ithuĩ nĩtũmũmeretie.","poem":2},{"text":"Ũyũ nĩguo mũthenya ũrĩa tũtũire twetereire,","poem":1},{"text":"na rĩu nĩtũwonete.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Jehova nĩarĩkĩtie gwĩka ũrĩa aathugundĩte;","poem":1},{"text":"we nĩahingĩtie kiugo gĩake,","poem":2},{"lineBreak":true},{"text":"kĩrĩa aathanire o matukũ ma tene.","poem":2},{"text":"Akũngʼaũranĩtie ategũkũiguĩra tha,","poem":1},{"text":"atũmĩte thũ igũkenerere,","poem":2},{"lineBreak":true},{"text":"rũhĩa rwa amuku aku nĩruo atũgĩrĩtie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ngoro cia andũ nĩirakaĩra Mwathani.","poem":1},{"text":"Atĩrĩrĩ, wee rũthingo rũrũ rwa Mwarĩ wa Zayuni,","poem":2},{"text":"reke maithori maku manyũrũrũke ta rũũĩ","poem":1},{"text":"mũthenya na ũtukũ;","poem":2},{"text":"ndũkahurũke,","poem":1},{"text":"kana ũreke maitho maku mahurũke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Arahũka, ũkayũrũrũke ũtukũ,","poem":1},{"text":"rĩrĩa ũrangĩri wa ũtukũ wambagĩrĩria;","poem":2},{"text":"itũrũraga ngoro yaku ta maaĩ","poem":1},{"text":"mbere ya Mwathani.","poem":2},{"text":"Ambararia moko maku na igũrũ kũrĩ we","poem":1},{"text":"nĩ ũndũ wa mĩoyo ya ciana ciaku,","poem":2},{"text":"o icio iraringĩka nĩ ngʼaragu","poem":1},{"text":"magomano-inĩ ma njĩra ciothe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Wee Jehova, ta rora, na ũcũũranie:","poem":1},{"text":"Nũũ ũngĩ wee ũrĩ weka ũguo?","poem":2},{"text":"Andũ-a-nja nĩmagĩrĩirwo nĩ kũrĩa maciaro mao,","poem":1},{"text":"o ciana iria marerete?","poem":2},{"text":"Mũthĩnjĩri-Ngai na mũnabii nĩmagĩrĩire","poem":1},{"text":"kũũragagĩrwo handũ-harĩa-haamũre ha Mwathani?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Andũ ethĩ o na arĩa akũrũ","poem":1},{"text":"makomete hamwe rũkũngũ-inĩ rwa njĩra,","poem":2},{"text":"aanake akwa na airĩtu","poem":1},{"text":"moragĩtwo na rũhiũ rwa njora.","poem":2},{"text":"Ũmoragĩte mũthenya ũrĩa ũrakarĩte;","poem":1},{"text":"ũmoragĩte ũtekũmaiguĩra tha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“O ta ũrĩa wĩtanaga mũthenya wa gĩathĩ-rĩ,","poem":1},{"text":"noguo ũnjĩtĩire maũndũ ma kũnguoyohia,","poem":2},{"text":"makandigiicĩria mĩena yothe","poem":1},{"text":"o taarĩ mũthenya wa gĩathĩ.","poem":2},{"text":"Mũthenya wa marakara ma Jehova-rĩ,","poem":1},{"text":"gũtirĩ mũndũ o na ũmwe wahonokire kana agĩtigara;","poem":2},{"text":"arĩa ndarũmbũirie na ngĩrera-rĩ,","poem":1},{"text":"thũ yakwa nĩĩmanangĩte.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}