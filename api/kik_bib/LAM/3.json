{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"LAM","translationId":"kik_bib","name":"Macakaya","commonName":"Macakaya","title":"MACAKAYA","order":25,"numberOfChapters":5,"sha256":"d8a78d9299834b471498a5ff1aab0072c7ad8c06ab22aa4cddb9ce6cda8d7796","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/kik_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Niĩ ndĩ mũndũ wonete thĩĩna","poem":1},{"text":"nĩ ũndũ wa kũhũũrwo na rũthanju rwa mangʼũrĩ make.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Andwarĩte akangereria nduma-inĩ","poem":1},{"text":"handũ ha ũtheri-inĩ;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ti-itherũ, atũmĩte guoko gwake kũnjũkĩrĩre","poem":1},{"text":"rĩngĩ na rĩngĩ, mũthenya wothe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nĩatũmĩte nyama cia mwĩrĩ wakwa","poem":1},{"text":"na gĩkonde kĩaguo ihinyare,","poem":2},{"lineBreak":true},{"text":"na akoinanga mahĩndĩ makwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nĩandigiicĩirie, na agaathiũrũrũkĩria","poem":1},{"text":"na marũrũ, na thĩĩna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Atũmĩte ndũũre nduma-inĩ","poem":1},{"text":"o ta andũ arĩa maakuire tene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nĩanjirigĩire na rũthingo nĩguo ndikae kũũra;","poem":1},{"text":"mĩnyororo yakwa nĩamĩritũhĩtie mũno.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"O na rĩrĩa ndetana kana ndakaya ngĩenda ũteithio-rĩ,","poem":1},{"text":"nĩ kũhingĩrĩria ahingagĩrĩria mahooya makwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nĩahingĩte njĩra yakwa na mahiga maicũhie;","poem":1},{"text":"atũmĩte tũcĩra twakwa tuogome.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kũrĩ niĩ aatuĩkĩte o ta nduba rĩrĩa yoheirie,","poem":1},{"text":"kana ta mũrũũthi rĩrĩa wĩhithĩte,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"akĩngururia kuuma gacĩra-inĩ,","poem":1},{"text":"akĩndambuura, akĩndiganĩria itarĩ na ũteithio.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ageetete ũta wake, akangereka,","poem":1},{"text":"nduĩke cabaa ya kũrathagwo nĩ mĩguĩ yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nĩatheecire ngoro yakwa","poem":1},{"text":"na mĩguĩ kuuma thiaka-inĩ wake.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngĩgĩtuĩka wa gũthekagĩrĩrwo nĩ andũ akwa othe;","poem":1},{"text":"maanyũrũragia na rwĩmbo mũthenya wothe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Anjiyũrĩtie maũndũ marũrũ,","poem":1},{"text":"na akaahũũnia na maaĩ ma nyongo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nĩangʼethũrangĩte magego makwa na kagoto;","poem":1},{"text":"anangĩrĩirie rũkũngũ-inĩ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nĩnjagithĩtio thayũ;","poem":1},{"text":"nĩndiganĩirwo ũgaacĩru nĩ kĩĩ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nĩ ũndũ ũcio nguuga atĩrĩ, “Riiri wakwa nĩũthirĩte,","poem":1},{"text":"o hamwe na maũndũ marĩa mothe ndũire njĩrĩgĩrĩire kuuma kũrĩ Jehova.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Nĩngũririkana thĩĩna wakwa, na kũũrũũra gwakwa,","poem":1},{"text":"na ngaririkana maũndũ marũrũ, o na maaĩ ma nyongo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ngoro yakwa no ĩraririkana maũndũ macio,","poem":1},{"text":"nayo ĩkaringĩka thĩinĩ wakwa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"O na gũtariĩ ũguo nĩndirikanaga ũndũ ũyũ,","poem":1},{"text":"na tondũ wa ũguo ngagĩa na kĩĩrĩgĩrĩro:","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Tondũ wa wendo mũnene wa Jehova, nĩkĩo tũtaniinĩtwo biũ,","poem":1},{"text":"nĩgũkorwo tha ciake itirĩ hĩndĩ ithiraga.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Tha ciaku ikoragwo irĩ njerũ rũciinĩ o rũciinĩ,","poem":1},{"text":"wĩhokeku waku nĩ mũnene mũno.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ngoro yakwa yugaga atĩrĩ,","poem":1},{"text":"“Jehova nĩwe igai rĩakwa; tondũ ũcio nĩwe ndĩrĩetagĩrĩra.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Jehova nĩ mwega kũrĩ arĩa mamwĩhokaga,","poem":1},{"text":"kũrĩ ngoro ĩyo ĩmũrongoragia;","poem":2}]},{"type":"verse","number":26,"content":[{"text":"nĩ wega mũndũ gweterera","poem":1},{"text":"ũhonokio wa Jehova o akirĩte.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nĩ wega mũndũ gũkuua icooki","poem":1},{"text":"hĩndĩ ĩrĩa arĩ mũnini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Nĩaikare arĩ wiki akirĩte,","poem":1},{"text":"nĩgũkorwo nĩ Jehova ũmũigĩrĩire rĩo.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Nĩaturumithie ũthiũ wake rũkũngũ-inĩ,","poem":1},{"text":"no gũkorwo aahota kũgĩa na kĩĩrĩgĩrĩro.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Nĩerekererie rũthĩa kũrĩ mũndũ ũrĩa ũkũmũgũtha,","poem":1},{"text":"na aiyũrwo nĩ thoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Nĩgũkorwo Jehova","poem":1},{"text":"ndateanagĩria andũ nginya tene.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"O na gũtuĩka nĩarehaga kĩeha-rĩ, we nĩaiguanagĩra tha,","poem":1},{"text":"nĩgũkorwo wendo ũcio wake ũtathiraga nĩ mũnene mũno.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Nĩgũkorwo ndarehagĩra andũ mĩnyamaro,","poem":1},{"text":"kana akarehere ciana cia andũ kĩeha akĩendaga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Rĩrĩa andũ a bũrũri arĩa othe mohetwo","poem":1},{"text":"maarangĩrĩrio na makinya-rĩ,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"rĩrĩa mũndũ aagithio kĩhooto gĩake","poem":1},{"text":"mbere ya Ũrĩa-ũrĩ-Igũrũ-Mũno-rĩ,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"o na rĩrĩa mũndũ atuĩrwo ciira hatarĩ kĩhooto-rĩ,","poem":1},{"text":"githĩ Mwathani ndonaga maũndũ macio?","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Nũũ ũngĩaria na atũme ũndũ ũcio ũhinge,","poem":1},{"text":"Mwathani ataathanĩte gũtuĩke ũguo?","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Githĩ kanua-inĩ ka Ũrĩa-ũrĩ-Igũrũ-Mũno","poem":1},{"text":"tiho hoimaga maũndũ mooru, na hakoima maũndũ mega?","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Mũndũ o wothe ũrĩ muoyo-rĩ, atetaga nĩkĩ","poem":1},{"text":"rĩrĩa ekũherithio nĩ ũndũ wa mehia make?","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Nĩtũthuthuurie-i mĩthiĩre iitũ na tũmĩtuĩrie,","poem":1},{"text":"tũcokerere Jehova.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Nĩtwambararie ngoro ciitũ na moko maitũ na igũrũ","poem":1},{"text":"kũrĩ Mũrungu ũrĩa ũrĩ igũrũ, tuuge atĩrĩ:","poem":2}]},{"type":"verse","number":42,"content":[{"text":"“Ithuĩ-rĩ, nĩtwĩhĩtie na tũgakũremera,","poem":1},{"text":"wee nawe ũkaaga gũtũrekera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"“Wee wĩhumbĩrĩte na marakara, ũgatũingatithia;","poem":1},{"text":"ũũraganĩte ũtekũiguanĩra tha.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Wee wĩhumbĩrĩte na itu","poem":1},{"text":"nĩgeetha gũtikagĩe na ihooya rĩngĩgũkinyĩra.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Wee ũtũmĩte tũtuĩke ta gĩko,","poem":1},{"text":"na ta mahuti gatagatĩ ka ndũrĩrĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"“Thũ ciitũ ciothe itwathamĩirie tũnua itũũkĩrĩre.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Nĩtũkorereirwo nĩ kĩmako kĩnene, na tũkenjerwo marima,","poem":1},{"text":"tũgakorwo nĩ ũniinani, na mwanangĩko.”","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Maitho makwa maranyũrũrũkia tũrũũĩ twa maithori","poem":1},{"text":"nĩ ũndũ andũ akwa nĩmanangĩtwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"Maitho makwa marĩnyũrũrũkagia maithori mategũtigithĩria,","poem":1},{"text":"magaikara o makĩnyũrũrũkaga,","poem":2}]},{"type":"verse","number":50,"content":[{"text":"nginya rĩrĩa Jehova agaacũthĩrĩria arĩ igũrũ oone.","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Maũndũ marĩa ndĩrona nĩmaranjiguithia kĩeha ngoro,","poem":1},{"text":"tondũ wa andũ-a-nja othe a itũũra rĩakwa inene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Andũ arĩa maatuĩkĩte thũ ciakwa hatarĩ gĩtũmi","poem":1},{"text":"nĩo maanguĩmaga ta nyoni.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Maanjikirie irima makĩenda kũnjũraga,","poem":1},{"text":"na makĩĩhũũra na mahiga;","poem":2}]},{"type":"verse","number":54,"content":[{"text":"ndaahubanĩirio nĩ maaĩ maingĩ,","poem":1},{"text":"magĩikũrũkĩra igũrũ rĩa mũtwe wakwa,","poem":2},{"lineBreak":true},{"text":"na niĩ ngĩĩciiria ndĩ hakuhĩ kũniinwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":55,"content":[{"text":"Ngĩkaĩra rĩĩtwa rĩaku Wee Jehova,","poem":1},{"text":"ndĩ kũu irima-inĩ rĩu iriku.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Na we ũkĩigua ithaithana rĩakwa, ngĩkwĩra atĩrĩ,","poem":1},{"text":"“Tiga kũhinga matũ maku ngĩgũkaĩra ũndeithie.”","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Nawe ũkĩnguhĩrĩria rĩrĩa ndagũkaĩire,","poem":1},{"text":"ũkĩnjĩĩra atĩrĩ, “Tiga gwĩtigĩra.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":58,"content":[{"text":"Wee Mwathani-rĩ, nĩwe wanjiirĩrĩire;","poem":1},{"text":"nawe ũgĩgĩkũũra muoyo wakwa.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Wee Jehova, nĩwonete ũũru ũrĩa njĩkĩtwo.","poem":1},{"text":"Tua ciira wakwa arĩ we!","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Wee nĩwonete kwĩrĩhĩria kwao guothe,","poem":1},{"text":"o na mathugunda mao mothe ma kũnjũkĩrĩra.","poem":2}]},{"type":"line_break"},{"type":"verse","number":61,"content":[{"text":"Wee Jehova-rĩ, nĩũiguĩte irumi iria manumĩte nacio,","poem":1},{"text":"o na mathugunda mao mothe ma kũnjũkĩrĩra:","poem":2}]},{"type":"verse","number":62,"content":[{"text":"maũndũ marĩa thũ ciakwa ciaragia na mĩheehũ ikĩngʼungʼuanaga","poem":1},{"text":"injũkĩrĩre mũthenya wothe.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Ta kĩmarore! Magĩikara thĩ kana magĩũkĩra,","poem":1},{"text":"maanyũrũragia na nyĩmbo ciao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":64,"content":[{"text":"Wee Jehova-rĩ, marĩhe kũringana na ũrĩa mekĩte,","poem":1},{"text":"kũringana na wĩra wa moko mao.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"Ũmia ngoro ciao, nakĩo kĩrumi gĩaku kĩroikara nao!","poem":1}]},{"type":"verse","number":66,"content":[{"lineBreak":true},{"text":"Maingatithie ũrĩ na marakara,","poem":1},{"text":"na ũmaniine mathire gũkũ mũhuro wa igũrũ rĩa Jehova.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}