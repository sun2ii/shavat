{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"LAM","translationId":"kik_bib","name":"Macakaya","commonName":"Macakaya","title":"MACAKAYA","order":25,"numberOfChapters":5,"sha256":"d8a78d9299834b471498a5ff1aab0072c7ad8c06ab22aa4cddb9ce6cda8d7796","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/kik_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Hĩ! Kaĩ thahabu ĩyo nĩĩthirĩte ũkengu wayo-ĩ,","poem":1},{"text":"thahabu ĩrĩa therie kaĩ ĩrĩ gũthita-ĩ!","poem":2},{"text":"Tũhiga twa goro tũrĩa twamũre","poem":1},{"text":"nĩtũhurunjĩtwo magomano-inĩ ma njĩra ciothe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ariũ a Zayuni arĩa me bata,","poem":1},{"text":"arĩa rĩmwe mangĩaringithanirio na thogora wa thahabu,","poem":2},{"text":"kaĩ rĩu moonagwo ta nyũngũ cia rĩũmba-ĩ,","poem":1},{"text":"o ta wĩra wa moko ma mũũmbi!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"O na mbwe nĩciongithagia ciana ciacio,","poem":1},{"text":"no andũ akwa matuĩkĩte andũ matarĩ tha,","poem":2},{"lineBreak":true},{"text":"o ta nyaga cia werũ-inĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Rũrĩmĩ rwa gakenge","poem":1},{"text":"rũnyiitanĩte na karakara nĩ ũndũ wa kũnyoota;","poem":2},{"text":"twana tũhooyaga irio,","poem":1},{"text":"no gũtirĩ mũndũ ũtũheaga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Andũ arĩa rĩmwe maarĩĩaga irio njega,","poem":1},{"text":"rĩu maikaraga njĩra-inĩ mekonotete,","poem":2},{"text":"arĩa maarerirwo makĩhumbagwo nguo cia rangi wa ndathi-rĩ,","poem":1},{"text":"rĩu makomaga ciara-inĩ cia mũhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Iherithia rĩa andũ akwa","poem":1},{"text":"nĩ inene gũkĩra rĩa itũũra rĩa Sodomu,","poem":2},{"text":"rĩrĩa rĩangʼaũranirio o rĩmwe,","poem":1},{"text":"gũtarĩ guoko kwarĩteithirie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Anene akuo maatherete gũkĩra tharunji,","poem":1},{"text":"na makeerũha gũkĩra iria,","poem":2},{"text":"maarĩ atune mĩĩrĩ gũkĩra ruru ĩrĩa ndune,","poem":1},{"text":"magakĩhaana ta kahiga ka goro karĩa getagwo yakuti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"No rĩu mairĩte o na gũkĩra mbiro;","poem":1},{"text":"matikũũrĩkanaga marĩ njĩra-inĩ.","poem":2},{"text":"Ikonde cia mĩĩrĩ yao ciũmanĩrĩire na mahĩndĩ;","poem":1},{"text":"ciumĩte o ta rũthanju.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kaba arĩa mooragagwo na rũhiũ rwa njora,","poem":1},{"text":"kũrĩ arĩa makuuaga nĩ ngʼaragu;","poem":2},{"text":"matooragio nĩkũhũũta,","poem":1},{"text":"makamoca nĩ ũndũ wa kwaga irio cia kuuma mũgũnda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Moko ma andũ-a-nja arĩa marĩ tha","poem":1},{"text":"nĩmarugire ciana ciao ene,","poem":2},{"text":"igĩtuĩka irio ciao","poem":1},{"text":"hĩndĩ ĩyo andũ akwa manangirwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Jehova nĩarekereirie mangʼũrĩ make biũ;","poem":1},{"text":"aitũrũrĩte marakara make mahiũ.","poem":2},{"text":"Nĩakĩtie mwaki kũu Zayuni","poem":1},{"text":"ũrĩa ũcinĩte mĩthingi yakuo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Athamaki a thĩ matingĩetĩkirie,","poem":1},{"text":"o na kana kĩrĩndĩ o na kĩmwe gĩa gũkũ thĩ,","poem":2},{"text":"atĩ thũ na amuku nĩmangĩahotire","poem":1},{"text":"gũtoonya ihingo cia Jerusalemu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"No ũndũ ũcio wekĩkire nĩ ũndũ wa mehia ma anabii akuo,","poem":1},{"text":"na mawaganu ma athĩnjĩri-Ngai akuo","poem":2},{"text":"arĩa manaita thakame","poem":1},{"text":"ya andũ arĩa athingu kũu thĩinĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Rĩu maturuuraga njĩra-inĩ","poem":1},{"text":"ta andũ atumumu.","poem":2},{"text":"Mathaahĩtio nĩ thakame ũũ atĩ","poem":1},{"text":"gũtirĩ mũndũ o na ũmwe ũngĩgeria kũhutia nguo ciao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Andũ mamakayagĩrĩria, makoiga atĩrĩ,","poem":1},{"text":"“Thiĩi nakũu! Mũrĩ na thaahu! Thiĩi! Thiĩi! Mũtigatũhutie!”","poem":2},{"noteId":1},{"text":"Ningĩ moora na maatuĩka orũũri,","poem":1},{"text":"makeerwo atĩrĩ kũu ndũrĩrĩ-inĩ,","poem":2},{"lineBreak":true},{"text":"“Matingĩikara gũkũ rĩngĩ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Jehova we mwene nĩwe ũmahurunjĩte;","poem":1},{"text":"nĩatigĩte kũmarũmbũiya.","poem":2},{"text":"Athĩnjĩri-Ngai matiheagwo gĩtĩĩo,","poem":1},{"text":"o na makarega gũtuga athuuri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Makĩria ma ũguo-rĩ, maitho maitũ nĩmathirire hinya,","poem":1},{"text":"o tũcũthĩrĩirie ũteithio ũrĩa tũtoonire;","poem":2},{"text":"kuuma mĩthiringo iitũ ĩrĩa mĩraihu-rĩ,","poem":1},{"text":"twetereire rũrĩrĩ rũtangĩahotire gũtũhonokia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Andũ maatũcemaga ikinya gwa ikinya,","poem":1},{"text":"nĩ ũndũ ũcio tũtingĩathiĩrĩire njĩra-inĩ ciitũ.","poem":2},{"text":"Ithirĩro riitũ rĩgĩkuhĩrĩria, namo matukũ maitũ maarĩ matare,","poem":1},{"text":"nĩgũkorwo ithirĩro riitũ nĩrĩakinyĩte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Andũ arĩa matũingatithĩtie-rĩ,","poem":1},{"text":"maarĩ na ihenya gũkĩra nderi irĩ rĩera-inĩ;","poem":2},{"text":"maatũhanyũkagĩria irĩma-inĩ,","poem":1},{"text":"na magatuoheria werũ-inĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mũndũ ũrĩa mũitĩrĩrie maguta nĩ Jehova,","poem":1},{"text":"o we ũrĩa warĩ ta mĩhũmũ iitũ-rĩ,","poem":2},{"lineBreak":true},{"text":"nĩagwatirio nĩ mĩtego yao.","poem":2},{"text":"Tweciiragia atĩ tũrĩ kĩĩruru-inĩ gĩake-rĩ,","poem":1},{"text":"no tũtũũre gatagatĩ ka ndũrĩrĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kena na ũcanjamũke, wee Mwarĩ wa Edomu,","poem":1},{"text":"o wee ũtũũraga bũrũri wa Uzu.","poem":2},{"text":"No rĩrĩ, o nawe gĩkombe gĩkĩ nĩgĩgagũkora;","poem":1},{"text":"ũgaakĩnyuĩra ũrĩĩo, na ũrutwo nguo, ũtigwo njaga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Wee Mwarĩ wa Zayuni-rĩ, iherithia rĩaku nĩrĩgathira;","poem":1},{"text":"ndakoongerera ihinda rĩaku rĩa gũikara ũrĩ mũtahe.","poem":2},{"text":"No wee, Mwarĩ wa Edomu-rĩ, nĩagakũherithĩria mehia maku","poem":1},{"text":"na aguũrie waganu waku.","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Andũ arĩa maakoragwo na mangũ maanagĩrĩra nĩguo andũ matikamahutie tondũ maakoragwo na thaahu (Alaw 13:45).","reference":{"chapter":4,"verse":15}}]},"thisChapterLink":"/api/kik_bib/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}