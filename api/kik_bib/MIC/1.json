{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"MIC","translationId":"kik_bib","name":"Mika","commonName":"Mika","title":"MIKA","order":33,"numberOfChapters":7,"sha256":"b0f43d13850978b558899f2d01cfcba7fafd5d5a11d32fcac7c21d3aea8c0ffd","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/kik_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Ĩno nĩyo ndũmĩrĩri ya Jehova ĩrĩa yakinyĩrĩire Mika",{"noteId":0},"ũrĩa warĩ wa itũũra rĩa Moreshethu, ĩkoniĩ Samaria na Jerusalemu, hĩndĩ ya ũthamaki wa Jothamu, na wa Ahazu, na wa Hezekia, athamaki a Juda."]},{"type":"verse","number":2,"content":[{"text":"Atĩrĩrĩ, ta thikĩrĩriai inyuĩ andũ aya inyuothe;","poem":1},{"text":"o nawe thĩ ta igua, na arĩa othe matũũraga kuo,","poem":2},{"text":"nĩgeetha Mwathani Jehova arute ũira wa kũmũũkĩrĩra,","poem":1},{"text":"o we Mwathani arĩ thĩinĩ wa hekarũ yake theru.","poem":2}]},{"type":"heading","content":["Ituĩro rĩa Gũũkĩrĩra Samaria na Jerusalemu"]},{"type":"verse","number":3,"content":[{"text":"Atĩrĩrĩ! Jehova nĩarooka oimĩte gĩikaro gĩake;","poem":1},{"text":"araikũrũka arangĩrĩrie kũrĩa gũtũũgĩru gũkũ thĩ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Irĩma itwekaga irĩ rungu rwake,","poem":1},{"text":"nayo mĩkuru ĩgaatũkana;","poem":2},{"text":"itwekaga ta mũhũra ũrĩ mwaki-inĩ,","poem":1},{"text":"igaikũrũka ta maaĩ maikũrũkĩte na ihenya kĩgaragaro-inĩ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ũndũ ũyũ wonekete nĩ ũndũ wa ũremi wa Jakubu,","poem":1},{"text":"na nĩ ũndũ wa mehia ma nyũmba ya Isiraeli.","poem":2},{"text":"Ũremi wa Jakubu-rĩ, nĩ ũrĩkũ?","poem":1},{"text":"Githĩ ti Samaria?","poem":2},{"text":"Kũndũ kũrĩa gũtũũgĩru kwa Juda-rĩ, nĩ kũ?","poem":1},{"text":"Githĩ ti Jerusalemu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Nĩ ũndũ ũcio, ngaatua Samaria hĩba ya mahiga,","poem":1},{"text":"gũtuĩke kũndũ gwa kũhaandagwo mĩthabibũ.","poem":2},{"text":"Nĩngaita mahiga marĩo mũkuru-inĩ","poem":1},{"text":"na thikũrie mĩthingi yarĩo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mĩhianano yarĩo yothe nĩĩkoinangwo icunjĩ;","poem":1},{"text":"nacio iheo ciothe cia hekarũ yarĩo icinwo na mwaki.","poem":2},{"text":"Nĩngananga mĩhianano yothe yarĩo.","poem":1},{"text":"Tondũ rĩonganirie iheo ciarĩo kuuma mũcaara wa ũmaraya,","poem":2},{"text":"na igaatũmĩrwo rĩngĩ irĩ mũcaara wa kũrĩha maraya.”","poem":1}]},{"type":"heading","content":["Maithori na Kĩrĩro"]},{"type":"verse","number":8,"content":[{"text":"Tondũ ũcio-rĩ, ngũrĩra na ngirĩke,","poem":1},{"text":"na thiĩ ndĩ magũrũ matheri na ndĩ njaga.","poem":2},{"text":"Ngũgirĩka o ta mbwe,","poem":1},{"text":"na ndĩre ta ndundu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nĩgũkorwo kĩronda kĩarĩo gĩtingĩhona;","poem":1},{"text":"gĩũkĩte gĩgakinya Juda.","poem":2},{"text":"Nĩgĩkinyĩte o kĩhingo‑inĩ kĩa andũ akwa,","poem":1},{"text":"gĩgakinya Jerusalemu kuo kwene.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mũtikaheane ũhoro ũcio kũu Gathu,","poem":1},{"text":"mũtikarĩre o na hanini.","poem":2},{"text":"Ningĩ kũu Bethi-Ofara","poem":1},{"text":"mwĩgaragariei rũkũngũ‑inĩ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inyuĩ andũ arĩa mũtũũraga Shafiri,","poem":1},{"text":"thiĩi mũrĩ njaga na mũconokete.","poem":2},{"text":"Andũ arĩa matũũraga Zaanani","poem":1},{"text":"matingiuma itũũra rĩao.","poem":2},{"text":"Narĩo itũũra rĩa Bethi-Ezeli no gũcaaya rĩracaaya,","poem":1},{"text":"itũũra rĩu rĩtingĩhota gũkũgitĩra.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Andũ arĩa matũũraga Marothu-rĩ,","poem":1},{"text":"menyogondaga nĩ ruo, o metereire ũteithio,","poem":2},{"text":"nĩ ũndũ mwanangĩko ũikũrũkĩte kuuma kũrĩ Jehova,","poem":1},{"text":"ũgakinya o kĩhingo-inĩ kĩa Jerusalemu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Inyuĩ mũtũũraga Lakishi,","poem":1},{"noteId":1},{"text":"ngaari cianyu cia ita ciohererei mbarathi.","poem":2},{"text":"Nĩ inyuĩ mwatoonyirie Mwarĩ wa Zayuni mehia-inĩ,","poem":1},{"text":"nĩgũkorwo ũremi wa Isiraeli woimanire na inyuĩ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nĩ ũndũ ũcio nĩmũkahe Moreshethu-Gathu","poem":1},{"text":"iheo cia kuuganĩra ũhoro.","poem":2},{"text":"Itũũra rĩa Akizibu no rĩa kũheenereria","poem":1},{"text":"athamaki a Isiraeli.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Inyuĩ mũtũũraga Maresha","poem":1},{"text":"nĩngamũrehithĩria mũndũ wa kũmũũkĩrĩra, amũtoorie.","poem":2},{"text":"Ũrĩa we ũrĩ Riiri wa Isiraeli","poem":1},{"text":"nĩagooka Adulamu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Enjwoi mĩtwe mũcakaĩre","poem":1},{"text":"ciana cianyu iria mũkenagĩra;","poem":2},{"text":"mwĩenjei kĩhara mũhaane ta nderi,","poem":1},{"text":"nĩgũkorwo ciana icio cianyu nĩigatahwo.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Rĩĩtwa Mika rĩgĩtaũrwo nĩ kuuga “Nũũ ũhaana ta Jehova”.","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"Lakishi rĩarĩ itũũra rĩmwe rĩa marĩa manene mũno ma Juda.","reference":{"chapter":1,"verse":13}}]},"thisChapterLink":"/api/kik_bib/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}