{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"MIC","translationId":"kik_bib","name":"Mika","commonName":"Mika","title":"MIKA","order":33,"numberOfChapters":7,"sha256":"b0f43d13850978b558899f2d01cfcba7fafd5d5a11d32fcac7c21d3aea8c0ffd","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/kik_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":2,"content":[{"type":"heading","content":["Mĩbango ya Mũndũ na Mĩbango ya Ngai"]},{"type":"verse","number":1,"content":[{"text":"Kaĩ andũ arĩa mathugundaga waganu,","poem":1},{"text":"o acio meciiragia maũndũ mooru marĩ ũrĩrĩ, marĩ na haaro-ĩ!","poem":2},{"text":"Rũciinĩ gwakĩa mekaga o ũguo,","poem":1},{"text":"tondũ hinya wa gwĩka ũguo marĩ naguo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Macumĩkagĩra mĩgũnda makamĩtunyana,","poem":1},{"text":"na makeerirĩria nyũmba magacioya na hinya.","poem":2},{"text":"Maheenagia mũndũ makamũtunya mũciĩ wake,","poem":1},{"text":"makaheenia mũndũ wao, makamũtunya igai rĩake.","poem":2}]},{"type":"verse","number":3,"content":["Nĩ ũndũ ũcio, Jehova ekuuga atĩrĩ:",{"text":"“Nĩndĩrathugunda mwanangĩko wa gũũkĩrĩra andũ aya,","poem":1},{"text":"ũrĩa mũtakahota kwĩhonokia.","poem":2},{"text":"Mũtigacooka gũthiiaga na mwĩtĩĩo,","poem":1},{"text":"nĩgũkorwo ihinda rĩu nĩ rĩa mũtino.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mũthenya ũcio andũ nĩmakamũthekerera;","poem":1},{"text":"na mamũnyũrũrie na rwĩmbo rũrũ rwa kĩrĩro, maine atĩrĩ,","poem":2},{"text":"‘Tũrĩ anange biũ;","poem":1},{"text":"indo cia andũ akwa nĩngayane.","poem":2},{"text":"Nĩacieheretie kuuma kũrĩ niĩ!","poem":1},{"text":"Aragaya mĩgũnda iitũ kũrĩ andũ arĩa matũkunyanagĩra.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nĩ ũndũ mũtigakorwo na mũndũ o na ũmwe kĩũngano-inĩ kĩa Jehova","poem":1},{"text":"wa kũgaya ithaka na ũndũ wa gũcicuukĩra mĩtĩ.","poem":2}]},{"type":"heading","content":["Anabii a Maheeni"]},{"type":"verse","number":6,"content":[{"text":"Anabii ao moigaga atĩrĩ, “Mũtikarathe ũhoro.","poem":1},{"text":"Tigagai kũratha ũhoro ũkoniĩ maũndũ maya;","poem":2},{"lineBreak":true},{"text":"gĩconoko gĩtigatũkinyĩrĩra.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ningĩ nĩ kwagĩrĩire kũũranagio atĩrĩ,","poem":1},{"text":"wee nyũmba ya Jakubu:","poem":2},{"text":"“Kaĩ Roho wa Jehova arĩ mũrakaru?","poem":1},{"text":"We no eke maũndũ ta macio?”","poem":2},{"lineBreak":true},{"text":"“Githĩ ciugo ciakwa itigunaga","poem":1},{"text":"mũndũ ũrĩa ũthiiaga na mĩthiĩre mĩrũngĩrĩru?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ica‑ikuhĩ‑rĩ, andũ akwa maarahũkĩte magatuĩka ta thũ.","poem":1},{"text":"Mũtunyaga andũ arĩa mahooreire nguo ciao cia goro,","poem":2},{"text":"mũgatunya ehĩtũkĩri arĩa marahĩtũka matekũmaka,","poem":1},{"text":"o acio matakoragwo na meciiria ma mbaara na inyuĩ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mũingataga andũ‑a‑nja a andũ akwa","poem":1},{"text":"kuuma mĩciĩ yao ĩrĩa mĩega.","poem":2},{"text":"Mũgatunya ciana ciao","poem":1},{"text":"kĩrathimo gĩakwa nginya tene.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ũkĩrai mũthiĩ, mwehere!","poem":1},{"text":"Nĩgũkorwo gĩikaro gĩkĩ ti kĩo kĩhurũko kĩanyu,","poem":2},{"text":"tondũ nĩgĩthaahie,","poem":1},{"text":"kĩanangĩtwo ũndũ gĩtangĩcookererio.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mũndũ wa maheeni na ũtaaragia ma angĩũka oige atĩrĩ,","poem":1},{"text":"‘Ndaamũrathĩra gũkorwo na ndibei na njoohi nyingĩ,’","poem":2},{"lineBreak":true},{"text":"ũcio nĩwe ũngĩtĩkĩrĩka nĩ andũ aya!","poem":2}]},{"type":"heading","content":["Ũhonokio Kwĩranĩrwo"]},{"type":"verse","number":12,"content":[{"text":"“Atĩrĩrĩ, inyuĩ andũ a Jakubu,","poem":1},{"text":"ti‑itherũ nĩngamũcookanĩrĩria, inyuothe,","poem":2},{"text":"o na inyuĩ matigari ma Isiraeli nĩngamũrehe hamwe.","poem":1},{"text":"Ngamarehe hamwe ta ngʼondu irĩ kiugũ,","poem":2},{"text":"matuĩke ta rũũru rwa mbũri rũrĩ ũrĩithio-inĩ waruo;","poem":1},{"text":"nakĩo kĩrĩndĩ kĩa andũ kĩiyũre kuo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mũhingũri njĩra, nĩakambata arĩ mbere yao;","poem":1},{"text":"nao nĩmakamomora kĩhingo moime nja.","poem":2},{"text":"Mũthamaki wao nĩakoimagara arĩ mbere yao,","poem":1},{"text":"Jehova amatongoretie.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/MIC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/MIC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/MIC/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}