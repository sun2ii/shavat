{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"MIC","translationId":"kik_bib","name":"Mika","commonName":"Mika","title":"MIKA","order":33,"numberOfChapters":7,"sha256":"b0f43d13850978b558899f2d01cfcba7fafd5d5a11d32fcac7c21d3aea8c0ffd","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/kik_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"heading","content":["Atongoria na Anabii Gũkũũmwo"]},{"type":"verse","number":1,"content":["Ningĩ ngiuga atĩrĩ,",{"text":"“Ta iguai, inyuĩ atongoria a Jakubu,","poem":1},{"text":"o inyuĩ aathani a nyũmba ya Isiraeli.","poem":2},{"text":"Githĩ mũtiagĩrĩirwo nĩkũmenya ũhoro wa gũtuanĩra ciira na kĩhooto.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"No inyuĩ mũthũire maũndũ mega no mũkenda marĩa mooru;","poem":2},{"text":"inyuĩ mũnũraga andũ akwa ikonde,","poem":1},{"text":"na mũgathoora nyama mahĩndĩ-inĩ mao.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inyuĩ mũrĩĩaga nyama cia mĩĩrĩ ya andũ akwa,","poem":1},{"text":"mũkamonũra ikonde","poem":2},{"lineBreak":true},{"text":"na mũkoinanga mahĩndĩ mao tũcunjĩ;","poem":2},{"text":"O inyuĩ mũmatinangagia ta nyama cia gũkarangwo na rũgĩo,","poem":1},{"text":"o na ta nyama cia gũtherũkio na nyũngũ.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hĩndĩ ĩyo magaakaĩra Jehova,","poem":1},{"text":"nowe ndakamacookeria.","poem":2},{"text":"Hĩndĩ ĩyo nĩakahitha ũthiũ wake kuuma kũrĩ o,","poem":1},{"text":"tondũ wa ũũru ũrĩa mekĩte.","poem":2}]},{"type":"verse","number":5,"content":["Jehova ekuuga atĩrĩ,",{"text":"“Ha ũhoro wa anabii acio","poem":1},{"text":"mahĩtithagia andũ akwa,","poem":2},{"text":"mũndũ aamahe irio,","poem":1},{"text":"maanagĩrĩra makiugaga ‘thayũ,’","poem":2},{"text":"no angĩmaima irio,","poem":1},{"text":"makahaarĩria mbaara ya kũmũũkĩrĩra.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tondũ ũcio, ũtukũ nĩũkamũhubanĩria,","poem":1},{"text":"mwage kuona cioneki,","poem":2},{"text":"mũhubanĩrio nĩ nduma mwage ũguũrio.","poem":1},{"text":"Riũa nĩrĩgathũĩra anabii,","poem":2},{"text":"naguo mũthenya ũmatuĩkĩre nduma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ooni-maũndũ nĩmagaconoka,","poem":1},{"text":"nao aragũri maconorithio.","poem":2},{"text":"Othe nĩmakahumbĩra mothiũ mao,","poem":1},{"text":"tondũ gũtirĩ ũhoro magaacookerio nĩ Ngai.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"No hakwa-rĩ, niĩ njiyũrĩtwo nĩ hinya,","poem":1},{"text":"na ngaiyũrwo nĩ Roho wa Jehova,","poem":2},{"lineBreak":true},{"text":"o na ngaiyũrwo nĩ kĩhooto na ũhoti,","poem":2},{"text":"nĩguo nyumbũrĩre Jakubu ũremi wake,","poem":1},{"text":"na nyumbũrĩre Isiraeli mehia make.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ta thikĩrĩriai, inyuĩ atongoria a nyũmba ya Jakubu,","poem":1},{"text":"o inyuĩ aathani a nyũmba ya Isiraeli,","poem":2},{"text":"inyuĩ mũmenaga kĩhooto,","poem":1},{"text":"na mũkoogomia maũndũ marĩa ma ma;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"inyuĩ mwakaga Zayuni na ũiti wa thakame,","poem":1},{"text":"na mũgaaka Jerusalemu na waganu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Atongoria akuo matuaga ciira maahakwo,","poem":1},{"text":"athĩnjĩri-Ngai akuo marutanaga maarĩhwo,","poem":2},{"text":"na anabii akuo marathaga mohoro maheo mbeeca.","poem":1},{"text":"No rĩrĩ, megiritanagia na Jehova makoiga atĩrĩ,","poem":2},{"text":"“Githĩ Jehova ndakĩrĩ gatagatĩ-inĩ gaitũ?","poem":1},{"text":"Gũtirĩ ũũru ũngĩtũkora.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nĩ tondũ wanyu-rĩ,","poem":1},{"text":"Zayuni gũgaaciimbwo ta mũgũnda,","poem":2},{"text":"Jerusalemu gũtuĩke hĩba ya mahiga,","poem":1},{"text":"nakĩo kĩrĩma kĩrĩa gĩakĩtwo hekarũ","poem":2},{"lineBreak":true},{"text":"gĩtuĩke kĩhumbu kĩmereirwo nĩ ihinga.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}