{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"MIC","translationId":"kik_bib","name":"Mika","commonName":"Mika","title":"MIKA","order":33,"numberOfChapters":7,"sha256":"b0f43d13850978b558899f2d01cfcba7fafd5d5a11d32fcac7c21d3aea8c0ffd","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/kik_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["Kĩrĩma kĩa Jehova"]},{"type":"verse","number":1,"content":["Matukũ-inĩ ma kũrigĩrĩria,",{"text":"kĩrĩma kĩrĩa kĩa hekarũ ya Jehova nĩgĩkahaandwo","poem":1},{"text":"kĩrĩ kĩo kĩnene gatagatĩ ka irĩma iria ingĩ;","poem":2},{"text":"nĩgĩkambarario igũrũ rĩa tũrĩma tũrĩa tũngĩ,","poem":1},{"text":"nao andũ a ndũrĩrĩ nĩkuo magaathiiaga.","poem":2}]},{"type":"verse","number":2,"content":["Ndũrĩrĩ nyingĩ igaathiĩ kuo, ikiugaga atĩrĩ,",{"text":"“Ũkai twambate tũthiĩ kĩrĩma‑inĩ kĩa Jehova,","poem":1},{"text":"tũthiĩ nyũmba ya Ngai wa Jakubu.","poem":2},{"text":"Nĩagatũruta ũhoro wa mĩthiĩre yake,","poem":1},{"text":"nĩgeetha tũgeragĩre njĩra ciake.”","poem":2},{"text":"Nĩgũkorwo Zayuni nĩgũkoima ũtaarani,","poem":1},{"text":"nakuo Jerusalemu kuume ndũmĩrĩri ya Jehova.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nĩagatuithania ndũrĩrĩ nyingĩ ciira,","poem":1},{"text":"nacio ndũrĩrĩ iria irĩ hinya cia kuuma kũraya aciiguithanie.","poem":2},{"text":"Magaatura hiũ ciao cia njora ituĩke hiũ cia mĩraũ,","poem":1},{"text":"namo matimũ mao maturwo hiũ cia gũceeha mĩtĩ.","poem":2},{"text":"Gũtirĩ rũrĩrĩ rũgaacooka kũrũa na rũrĩa rũngĩ na hiũ cia njora,","poem":1},{"text":"kana rũcooke kwĩruta ũhoro wa mbaara rĩngĩ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"O mũndũ agaikaraga gĩtina-inĩ kĩa mũthabibũ wake","poem":1},{"text":"na aikarage gĩtina-inĩ kĩa mũkũyũ wake,","poem":2},{"text":"na gũtirĩ mũndũ ũkaamamakia,","poem":1},{"text":"nĩgũkorwo ũguo nĩguo Jehova Mwene-Hinya-Wothe oigĩte.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Andũ a ndũrĩrĩ ciothe no marũmĩrĩre","poem":1},{"text":"kĩrĩra kĩa ngai ciao;","poem":2},{"text":"no ithuĩ tũrĩrũmagĩrĩra kĩrĩra kĩa Jehova Ngai witũ","poem":1},{"text":"nginya tene na tene.","poem":2}]},{"type":"heading","content":["Mũbango wa Jehova"]},{"type":"verse","number":6,"content":["Jehova ekuuga atĩrĩ:",{"text":"“Mũthenya ũcio-rĩ,","poem":1},{"text":"nĩngacookanĩrĩria ithua;","poem":2},{"text":"na nĩngacookanĩrĩria arĩa matahĩtwo,","poem":1},{"text":"o na arĩa nyariirithĩtie.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ithua nĩngacitua matigari,","poem":1},{"text":"na arĩa maingatĩtwo ndĩmatue rũrĩrĩ rũrĩ hinya.","poem":2},{"text":"Jehova nĩwe ũkamaathaga arĩ Kĩrĩma-inĩ gĩa Zayuni,","poem":1},{"text":"kuuma mũthenya ũcio nginya tene.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ha ũhoro waku, wee mũthiringo ũyũ mũraihu na igũrũ","poem":1},{"text":"wa kũrangĩra rũũru rwa mbũri,","poem":2},{"lineBreak":true},{"text":"o wee kĩĩhitho kĩrũmu kĩa Mwarĩ wa Zayuni-rĩ,","poem":2},{"text":"wathani ũrĩa warĩ naguo mbere nĩũgagũcookerera;","poem":1},{"text":"naguo ũthamaki wa Mwarĩ wa Jerusalemu ũmũcookerere.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Atĩrĩrĩ, nĩkĩ kĩratũma ũrĩre wanĩrĩire,","poem":1},{"text":"kaĩ ũtarĩ na mũthamaki?","poem":2},{"text":"Kaĩ ũkuĩrĩirwo nĩ mũkũhei kĩrĩra,","poem":1},{"text":"tondũ wanyiitwo nĩ ruo rũhaana ta rwa mũndũ-wa-nja akĩrũmwo?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wĩnyogonde nĩ ruo, wee Mwarĩ wa Zayuni,","poem":1},{"text":"o ta mũndũ-wa-nja akĩrũmwo,","poem":2},{"text":"nĩgũkorwo rĩu no nginya uume itũũra inene","poem":1},{"text":"ũgaikare nja werũ-inĩ.","poem":2},{"text":"Nĩũgathiĩ Babuloni;","poem":1},{"text":"kũu nĩkuo ũkaahonokerio.","poem":2},{"text":"Kũu nĩkuo Jehova agaagũkũũra","poem":1},{"text":"kuuma guoko-inĩ gwa thũ ciaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"No rĩrĩ, ndũrĩrĩ nyingĩ","poem":1},{"text":"nĩicookanĩrĩire, igũũkĩrĩre.","poem":2},{"text":"Iroiga atĩrĩ, “Rekei anyiitwo nĩ thaahu,","poem":1},{"text":"rekei maitho maitũ mathekerere Zayuni!”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"No cio itingĩmenya meciiria ma Jehova;","poem":1},{"text":"o na itiũĩ mũbango wake,","poem":2},{"text":"o we ũrĩa ũcicookanagĩrĩria","poem":1},{"text":"ta itĩĩa cia ngano kĩhũrĩro-inĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Arahũka, wee Mwarĩ wa Zayuni, ũhũũre ngano ĩyo,","poem":1},{"text":"nĩgũkorwo nĩngakũhe hĩa cia kĩgera;","poem":2},{"text":"nĩngakũhe mahũngũ ma gĩcango","poem":1},{"text":"nawe nĩũkahehenja ndũrĩrĩ nyingĩ.”","poem":2},{"text":"Uumithio ũcio meyoeire na njĩra ĩtarĩ ya kĩhooto nĩũkawamũrĩra Jehova,","poem":1},{"text":"ũtonga wao ũwamũrĩre Mwathani wa thĩ yothe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}