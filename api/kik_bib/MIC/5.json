{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"MIC","translationId":"kik_bib","name":"Mika","commonName":"Mika","title":"MIKA","order":33,"numberOfChapters":7,"sha256":"b0f43d13850978b558899f2d01cfcba7fafd5d5a11d32fcac7c21d3aea8c0ffd","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/kik_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":5,"content":[{"type":"heading","content":["Mũthamaki kuuma Bethilehemu"]},{"type":"verse","number":1,"content":[{"text":"Thagathaga mbũtũ ciaku cia mbaara,","poem":1},{"text":"wee itũũra inene rĩa mbũtũ cia mbaara,","poem":2},{"lineBreak":true},{"text":"nĩgũkorwo matũrigiicĩirie matũũkĩrĩre.","poem":2},{"text":"Nĩmakaringa mwathi wa Isiraeli","poem":1},{"text":"rũthĩa-inĩ na rũthanju.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“No rĩrĩ, wee Bethilehemu Efiratha,","poem":1},{"text":"o na harĩa arĩ we mũnini mũno mĩhĩrĩga-inĩ ya Juda,","poem":2},{"text":"thĩinĩ waku nĩkuo gũkoima","poem":1},{"text":"ũrĩa ũgaatuĩka mwathi wa Isiraeli,","poem":2},{"text":"ũrĩa kĩhumo gĩake nĩ gĩa kuuma tene,","poem":1},{"text":"kuuma mĩndĩ na mĩndĩ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tondũ ũcio, Isiraeli nĩagatiganĩrio","poem":1},{"text":"nginya ihinda rĩkinye,","poem":2},{"lineBreak":true},{"text":"rĩrĩa ũrĩa ũraarũmwo agaaciara,","poem":2},{"text":"nao ariũ-a-ithe arĩa angĩ","poem":1},{"text":"magaacookerera andũ a Isiraeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nĩagookĩra arĩithie rũũru rwa mbũri ciake","poem":1},{"text":"arĩ na hinya wa Jehova,","poem":2},{"lineBreak":true},{"text":"na ũnene wa rĩĩtwa rĩa Jehova Ngai wake.","poem":2},{"text":"Nao nĩmagatũũra marĩ agitĩre, nĩgũkorwo hĩndĩ ĩyo","poem":1},{"text":"ũnene wake ũgaakinya o nginya ituri ciothe cia thĩ.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nake nĩagatuĩka thayũ wao.","poem":2},"Ũhonokania na Mwanangĩko",{"text":"Hĩndĩ ĩrĩa Ashuri makaahithũkĩra bũrũri witũ,","poem":1},{"text":"na matuĩkanĩrie ciĩhitho ciitũ nũmu,","poem":2},{"text":"nĩtũkamaarahũrĩra arĩithi mũgwanja,","poem":1},{"text":"o na anene anana mamokĩrĩre.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nĩmagaatha bũrũri wa Ashuri na rũhiũ rwa njora;","poem":1},{"text":"maathe bũrũri wa Nimurodi na hiũ cia njora icomoretwo.","poem":2},{"text":"Nĩagatũhonokia kuuma kũrĩ Aashuri","poem":1},{"text":"hĩndĩ ĩrĩa magaatharĩkĩra bũrũri witũ","poem":2},{"lineBreak":true},{"text":"na matuĩkanĩirie mĩhaka-inĩ iitũ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Matigari ma Jakubu magaatuĩka","poem":1},{"text":"ta ime riumĩte harĩ Jehova","poem":2},{"lineBreak":true},{"text":"gatagatĩ-inĩ ka ndũrĩrĩ nyingĩ,","poem":2},{"text":"o na ta mbura ya rũthuthuũ yurĩte nyeki-inĩ,","poem":1},{"text":"ĩrĩa ĩtarehagwo nĩ mũndũ kana ĩkoirio nĩ andũ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Matigari ma Jakubu magaakoragwo gatagatĩ ka ndũrĩrĩ,","poem":1},{"text":"o gatagatĩ ka ndũrĩrĩ nyingĩ,","poem":2},{"text":"ta mũrũũthi ũrĩ thĩinĩ wa nyamũ cia mũtitũ,","poem":1},{"text":"na ta kĩana kĩa mũrũũthi kĩrĩ thĩinĩ wa ndũũru cia ngʼondu,","poem":2},{"text":"kĩrĩa gĩthiiaga gĩgĩcitihangagia na gĩgĩcitambuuraga","poem":1},{"text":"na gũtirĩ mũndũ ũngĩcihonokia.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Guoko gwaku nĩgũkambarario na igũrũ kuonanie ũhootani harĩ thũ ciaku,","poem":1},{"text":"na amuku aku othe nĩmakaniinwo.","poem":2}]},{"type":"verse","number":10,"content":["Jehova ekuuga atĩrĩ, “Mũthenya ũcio-rĩ,",{"text":"“nĩngananga mbarathi ciaku ikweherere biũ,","poem":1},{"text":"nacio ngaari ciaku cia ita ndĩcitharie.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nĩngananga matũũra marĩa manene ma bũrũri wanyu,","poem":1},{"text":"na tharũrie ciĩhitho iria nũmu cianyu ciothe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nĩngananga ũgo wanyu,","poem":1},{"text":"na mũtigacooka kũragũra rĩngĩ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nĩngananga mĩhianano yanyu ya gwacũhio,","poem":1},{"text":"na nyanange mahiga manyu marĩa maamũre mũrĩ namo;","poem":2},{"text":"mũtigacooka kũinamĩrĩra","poem":1},{"text":"wĩra wa moko manyu rĩngĩ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Itugĩ cia Ashera iria mũrĩ nacio nĩngacimunya","poem":1},{"text":"na momore matũũra manyu manene.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nĩngerĩhĩria ndĩ na marakara na mangʼũrĩ","poem":1},{"text":"kũrĩ ndũrĩrĩ iria itanjathĩkagĩra.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/MIC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}