{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"MIC","translationId":"kik_bib","name":"Mika","commonName":"Mika","title":"MIKA","order":33,"numberOfChapters":7,"sha256":"b0f43d13850978b558899f2d01cfcba7fafd5d5a11d32fcac7c21d3aea8c0ffd","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/kik_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"heading","content":["Mĩnyamaro ya Isiraeli"]},{"type":"verse","number":1,"content":[{"text":"Hĩ, kaĩ ndĩ mũnyamarĩku-ĩ!","poem":1},{"text":"Ndariĩ ta mũndũ ũrongania maciaro maarĩkia kũgethwo hĩndĩ ya riũa,","poem":2},{"lineBreak":true},{"text":"o ta mũndũ ũrahaara thabibũ thuutha wa magetha;","poem":2},{"text":"gũtirĩ kĩmanjĩka gĩa thabibũ kĩngĩrĩĩo,","poem":1},{"text":"o na kana ngũyũ iria ciambaga kwĩrua iria ngoro yakwa ĩĩriragĩria.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Andũ arĩa eetigĩri Ngai nĩmathirĩte bũrũri‑inĩ,","poem":1},{"text":"gũtirĩ mũndũ o na ũmwe mũrũngĩrĩru ũtigarĩte.","poem":2},{"text":"Andũ othe maikarĩte metereire gũita thakame;","poem":1},{"text":"o mũndũ araguĩma mũrũ wa nyina na wabu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mahũthagĩra moko mao meerĩ gwĩka ũũru;","poem":1},{"text":"mũtongoria etagia iheo na hinya,","poem":2},{"text":"nake mũciirithania aamũkagĩra mahaki;","poem":1},{"text":"arĩa marĩ hinya nĩo moigaga kĩrĩa mekwenda:","poem":2},{"lineBreak":true},{"text":"othe makagĩa ndundu ya gwĩka ũũru.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ũrĩa mwega mũno wao ahaana ta congʼe,","poem":1},{"text":"ũrĩa mũrũngĩrĩru mũno nĩ mũũru gũkĩra rũgiri rwa mĩigua.","poem":2},{"text":"Mũthenya ũrĩa arangĩri aku matũire makwĩraga ũhoro waguo nĩmũkinyu,","poem":1},{"text":"mũthenya ũrĩa Ngai agaagũceerera.","poem":2},{"lineBreak":true},{"text":"Rĩĩrĩ nĩrĩo ihinda rĩa kĩrigiicano kĩao.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndũkanehoke mũndũ wa itũũra;","poem":1},{"text":"ndũkanehoke o na mũrataguo.","poem":2},{"text":"Menyerera ciugo cia kanua gaku,","poem":1},{"text":"ndũkaanahe mũtumia waku ũcio ũkomaga gĩthũri‑inĩ gĩaku ũhoro.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nĩgũkorwo mũriũ nĩagĩte gũtĩĩa ithe,","poem":1},{"text":"nake mũirĩtu akaremera nyina,","poem":2},{"text":"o nake mũtumia wa mũriũ akaremera nyaciarawe,","poem":1},{"text":"thũ cia mũndũ igaatuĩka andũ a nyũmba yake mwene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"No rĩrĩ, niĩ hakwa‑rĩ, ndĩcũthagĩrĩria Jehova","poem":1},{"text":"ndĩ na kĩĩrĩgĩrĩro,","poem":2},{"text":"njetereire Ngai Mũhonokia wakwa;","poem":1},{"text":"Ngai wakwa-rĩ, nĩakanjigua.","poem":2}]},{"type":"heading","content":["Isiraeli Kwĩhaanda Rĩngĩ"]},{"type":"verse","number":8,"content":[{"text":"Atĩrĩrĩ, wee thũ yakwa-rĩ, tiga kũngenerera!","poem":1},{"text":"O na ingĩgũa gũtirĩ hĩndĩ itagookĩra!","poem":2},{"text":"O na ingĩikara nduma-inĩ-rĩ,","poem":1},{"text":"Jehova nĩwe ũrĩtuĩkaga ũtheri wakwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tondũ nĩ niĩ ndĩmwĩhĩirie,","poem":1},{"text":"nĩngũkirĩrĩria mangʼũrĩ ma Jehova","poem":2},{"text":"nginya rĩrĩa we akaanjiirĩrĩra,","poem":1},{"text":"na onanie kĩhooto gĩakwa.","poem":2},{"text":"Nĩakanduta nduma-inĩ, andehe ũtheri-inĩ,","poem":1},{"text":"na niĩ nĩngeyonera ũthingu wake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hĩndĩ ĩyo thũ yakwa nĩĩkeyonera ũguo,","poem":1},{"text":"na ĩhumbwo thoni,","poem":2},{"text":"o ĩyo yanjũũragia atĩrĩ,","poem":1},{"text":"“Jehova Ngai waku akĩrĩ ha?”","poem":2},{"text":"Rĩu nĩ hĩndĩ maitho makwa mekwĩonera kũgũa kwayo,","poem":1},{"text":"o na ĩkarangĩrĩrio thĩ ta ndooro ya njĩra-inĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mũthenya wa gwaka thingo ciaku nĩũgakinya,","poem":1},{"text":"o guo mũthenya wa kwaramia mĩhaka yaku.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mũthenya ũcio, andũ nĩmagooka kũrĩ we","poem":1},{"text":"moimĩte Ashuri na matũũra manene ma Misiri,","poem":2},{"text":"na bũrũri ũrĩa ũrĩ gatagatĩ ka bũrũri wa Misiri","poem":1},{"text":"na Rũũĩ rwa Farati,","poem":2},{"text":"na kuuma iria rĩmwe nginya rĩrĩa rĩngĩ,","poem":1},{"text":"na kuuma kĩrĩma kĩmwe nginya kĩrĩa kĩngĩ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Thĩ nĩĩkanangĩka ĩkire ihooru nĩ ũndũ wa andũ arĩa matũũraga kuo,","poem":1},{"text":"marĩ maciaro ma ciĩko ciao.","poem":2}]},{"type":"heading","content":["Mahooya na Kĩgooco"]},{"type":"verse","number":14,"content":[{"text":"Rĩithia andũ aku na mũthĩgi waku,","poem":1},{"text":"nĩo rũũru rwa igai rĩaku,","poem":2},{"text":"rũrĩa rwĩrĩithagia rũrĩ rwiki mũtitũ-inĩ,","poem":1},{"text":"kũrĩa kũrĩ ũrĩithio mũnoru.","poem":2},{"text":"Reke irĩe o kũu Bashani na Gileadi,","poem":1},{"text":"o ta ũrĩa ciarĩĩaga matukũ ma tene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Ta ũrĩa gwatariĩ matukũ marĩa mwoimire bũrũri wa Misiri,","poem":1},{"text":"nĩngamoonia morirũ makwa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ndũrĩrĩ nĩikoona na iconoke,","poem":1},{"text":"itunyĩtwo hinya wacio wothe.","poem":2},{"text":"Nĩikenyiita tũnua twacio,","poem":1},{"text":"na ihingare matũ ciage kũigua.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Igaacũnaga rũkũngũ ta nyoka,","poem":1},{"text":"ta ciũmbe iria ikurumaga thĩ.","poem":2},{"text":"Nĩikoimĩra kuuma imamo-inĩ ciacio ikĩinainaga;","poem":1},{"text":"nĩigacookerere Jehova Ngai witũ na guoya,","poem":2},{"lineBreak":true},{"text":"na nĩigagwĩtigĩra.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nĩ Ngai ũrĩkũ ũhaana tawe,","poem":1},{"text":"ũrĩa ũrekagĩra matigari ma igai rĩake mehia na ũremi wao?","poem":2},{"text":"Ndũtũũraga ũrakarĩte nginya tene,","poem":1},{"text":"no nĩũkenagio nĩ kũiguanĩra tha.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nĩũgatũiguĩra tha rĩngĩ,","poem":1},{"text":"mehia maitũ nĩũkamarangĩrĩria na makinya,","poem":2},{"lineBreak":true},{"text":"na waganu witũ wothe ũũnyugute iria-inĩ kũrĩa kũriku.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nĩũgatũũria kĩrĩkanĩro gĩaku kũrĩ Jakubu,","poem":1},{"text":"na ũiguĩre Iburahĩmu tha,","poem":2},{"text":"o ta ũrĩa werĩire maithe maitũ na mwĩhĩtwa","poem":1},{"text":"matukũ-inĩ macio ma tene.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}