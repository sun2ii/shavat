{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"NAM","translationId":"kik_bib","name":"Nahumu","commonName":"Nahumu","title":"NAHUMU","order":34,"numberOfChapters":3,"sha256":"712519ae01c468cf3bb3effe51fdc1cd979e516b2dd40b95e0a8c57879112310","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/kik_bib/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Ĩno nĩyo ndũmĩrĩri nditũ ĩkoniĩ Nineve. Rĩĩrĩ nĩrĩo ibuku rĩa kĩoneki kĩa Nahumu, ũrĩa Mũelikoshi."]},{"type":"heading","content":["Jehova Kũrakarĩra Nineve"]},{"type":"verse","number":2,"content":[{"text":"Jehova nĩ Mũrungu ũrĩ ũiru na mwĩrĩhĩria;","poem":1},{"text":"Jehova nĩerĩhagĩria na akaiyũrwo nĩ mangʼũrĩ.","poem":2},{"text":"Jehova nĩerĩhagĩria harĩ thũ ciake,","poem":1},{"text":"na agatũũria mangʼũrĩ make harĩ amuku ake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jehova ndahiũhaga kũrakara na nĩarĩ hinya mũnene;","poem":1},{"text":"Jehova ndakaaga kũherithia mũndũ mwaganu.","poem":2},{"text":"Njĩra yake ĩrĩ thĩinĩ wa rũhuho rũnene na thĩinĩ wa kĩhuhũkanio,","poem":1},{"noteId":0},{"text":"matu namo nĩ rũkũngũ rwa makinya make.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Akũũmaga iria, agatũma rĩhũe;","poem":1},{"text":"ahũithagia njũũĩ ciothe.","poem":2},{"text":"Bashani na Karimeli nĩkũhoohete,","poem":1},{"text":"na kĩro kĩa Lebanoni gĩkaragatha.","poem":2},{"noteId":1}]},{"type":"verse","number":5,"content":[{"text":"Irĩma ithingithaga mbere yake,","poem":1},{"text":"natuo tũrĩma tũgatweka.","poem":2},{"text":"Thĩ ĩinainaga ĩrĩ mbere yake,","poem":1},{"text":"o na mabũrũri mothe makainaina,","poem":2},{"lineBreak":true},{"text":"na arĩa othe matũũraga kuo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nũũ ũngĩĩtiiria mathirĩ make?","poem":1},{"text":"Nũũ ũngĩkĩũmĩrĩria marakara make mahiũ?","poem":2},{"text":"Mangʼũrĩ make-rĩ, maitĩkaga ta mwaki;","poem":1},{"text":"ndwaro cia mahiga igathethereka mbere yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Jehova nĩ mwega,","poem":1},{"text":"nĩ kĩĩhitho hĩndĩ ya thĩĩna.","poem":2},{"text":"Arĩa mamwĩhokete-rĩ, nĩamamenyagĩrĩra,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"no rĩrĩ, nĩakaniina Nineve","poem":2},{"text":"na kĩguũ kĩnene kĩa maaĩ;","poem":1},{"text":"nĩakaingata thũ ciake nginya nduma-inĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ũrĩa wothe magaaciirĩra gwĩka Jehova-rĩ,","poem":1},{"text":"we nĩakaũniina;","poem":2},{"lineBreak":true},{"text":"o na thĩĩna ndũgooka hĩndĩ ya keerĩ.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Makaarigiicwo mĩigua-inĩ","poem":2},{"text":"na marĩĩo nĩ ndibei yao;","poem":1},{"text":"nao magaacinwo ta maragara momũ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nĩ harĩ ũmwe wĩyumĩrĩtie thĩinĩ waku wee Nineve,","poem":1},{"text":"ũrĩa ũthugundaga ũũru wa gũũkĩrĩra Jehova,","poem":2},{"lineBreak":true},{"text":"na akaheanaga irĩra cia waganu.","poem":2}]},{"type":"verse","number":12,"content":["Jehova ekuuga atĩrĩ:",{"text":"“O na aakorwo marĩ na arata, na nĩ aingĩ mũno-rĩ,","poem":1},{"text":"nĩmakaniinwo, meherio.","poem":2},{"text":"O na aakorwo nĩngũnyariirĩte, wee Juda-rĩ,","poem":1},{"text":"ndigacooka gũkũnyariira rĩngĩ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Na rĩrĩ, nĩnguunanga icooki rĩao riume ngingo-inĩ yaku,","poem":1},{"text":"na nduange mĩnyororo ĩrĩa woheetwo nayo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Jehova nĩarutĩte watho ũgũkoniĩ,","poem":1},{"text":"wee Nineve, akoiga atĩrĩ,","poem":2},{"lineBreak":true},{"text":"“Ndũkagĩa na njiaro cia gũtũũria rĩĩtwa rĩaku.","poem":2},{"text":"Nĩngananga mĩhianano ĩyo mĩicũhie o na ĩyo ya gũtwekio","poem":1},{"text":"ĩrĩa ĩrĩ kũu hekarũ ya ngai ciaku.","poem":2},{"text":"Nĩngũhaarĩria mbĩrĩra yaku,","poem":1},{"text":"nĩgũkorwo ũrĩ kĩndũ kĩũru biũ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ta cũthĩrĩriai kũũrĩa irĩma-igũrũ,","poem":1},{"text":"muone magũrũ ma mũndũ ũrĩa ũrarehe ũhoro mwega,","poem":2},{"lineBreak":true},{"text":"ũrĩa wanagĩrĩra thayũ!","poem":2},{"text":"Wee Juda-rĩ, kũngũĩra ciathĩ ciaku,","poem":1},{"text":"na ũhingie mĩĩhĩtwa yaku.","poem":2},{"text":"Andũ aaganu matigagũtharĩkĩra rĩngĩ,","poem":1},{"text":"nĩgũkorwo nĩmakaniinwo biũ.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Ihuhũkanio na huho nene Kĩrĩkanĩro-inĩ cionanagia hinya na riiri wa Jehova.","reference":{"chapter":1,"verse":3}},{"noteId":1,"caller":"+","text":"Bashani, na Karimeli, na Lebanoni kuoĩkaine nĩ ũndũ wa ũnoru na ũruru wakuo.","reference":{"chapter":1,"verse":4}}]},"thisChapterLink":"/api/kik_bib/NAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/NAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/MIC/7.json","previousChapterAudioLinks":{},"numberOfVerses":15}