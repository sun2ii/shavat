{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"NAM","translationId":"kik_bib","name":"Nahumu","commonName":"Nahumu","title":"NAHUMU","order":34,"numberOfChapters":3,"sha256":"712519ae01c468cf3bb3effe51fdc1cd979e516b2dd40b95e0a8c57879112310","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/kik_bib/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["Kũgũa kwa Nineve"]},{"type":"verse","number":1,"content":[{"text":"Atĩrĩrĩ, wee Nineve, mũgũtharĩkĩri nĩokĩte gũgũtharĩkĩra.","poem":1},{"text":"Rangĩra kĩĩgitĩro kĩa hinya,","poem":2},{"lineBreak":true},{"text":"na ũgitĩre njĩra;","poem":2},{"lineBreak":true},{"text":"wĩhotore,","poem":2},{"lineBreak":true},{"text":"na wĩĩkĩre hinya mũno!","poem":2}]},{"type":"verse","number":2,"content":["Jehova nĩagacookeria Jakubu riiri wake,",{"text":"ũhaane ta riiri wa Isiraeli,","poem":2},{"text":"o na aakorwo aanangi nĩmamonũhĩte,","poem":1},{"text":"na makaananga mĩthabibũ yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ngo cia thigari ciake nĩ cia rangi mũtune,","poem":1},{"text":"njamba cia ita ciĩhumbĩte nguo ndune ta gakarakũ.","poem":2},{"text":"Igera cia ngaari cia ita irahenia","poem":1},{"text":"mũthenya ũrĩa ciahaarĩrio;","poem":2},{"text":"matimũ mahangĩrĩtwo mĩtĩ ya mĩkarakaba","poem":1},{"text":"namo makahenũka maahiũrio.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngaari cia ita iraguthũka ituĩkanĩirie njĩra cia itũũra,","poem":1},{"text":"irahanyũka na mbere, ningĩ na thuutha,","poem":2},{"lineBreak":true},{"text":"ituĩkanĩirie ihaaro-inĩ cia itũũra.","poem":2},{"text":"Ihaana ta imũrĩ irakana;","poem":1},{"text":"irahiũka ta rũheni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Acookanĩrĩirie mbũtũ cia thigari iria njamba,","poem":1},{"text":"no ciũkaga ikĩhĩngagwo.","poem":2},{"text":"Iguthũkaga nginya rũthingo-inĩ rwa itũũra inene;","poem":1},{"text":"ituĩkaga ta ngo ya kũrĩgitĩra.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hingĩrĩrio cia rũũĩ nĩ hingũre,","poem":1},{"noteId":2},{"text":"naguo mũciĩ wa ũthamaki ũkamomoka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nĩ gwathanĩtwo itũũra rĩu inene","poem":1},{"text":"rĩtahwo na rĩthaamio.","poem":2},{"text":"Ngombo ciarĩo cia airĩtu iragirĩka na mĩgambo ta ya ndutura,","poem":1},{"text":"na ikehũũra ithũri.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nineve kũhaana ta ndia,","poem":1},{"text":"na maaĩ makuo nĩkũhwa marahwa.","poem":2},{"text":"Kũraanĩrĩrwo, gũkeerwo atĩrĩ, “Ta rũgamai! Ta rũgamai!”","poem":1},{"text":"No gũtirĩ mũndũ ũngĩĩhũgũra.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tahai betha!","poem":1},{"text":"Tahai thahabu!","poem":2},{"lineBreak":true},{"text":"Ũtonga ũrĩa ũrĩ igĩĩna-inĩ ciao ciothe ndũngĩthira!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nineve nĩgũtahe, na indo igatunyanwo gũgatigwo ũtheri!","poem":1},{"text":"Ngoro nĩikuĩte, na maru makaregera,","poem":2},{"lineBreak":true},{"text":"na mĩĩrĩ ĩkainaina, o na andũ othe magathita ithiithi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Atĩrĩrĩ, imamo cia mĩrũũthi irĩ ha,","poem":1},{"text":"kũndũ kũrĩa yarereire ciana ciayo,","poem":2},{"text":"kũrĩa mĩrũũthi ya njamba na ya nga yathiiaga","poem":1},{"text":"na ciana ciayo ĩtegwĩtigĩra?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mũrũũthi wa njamba nĩwatambuurĩire ciana ciaguo nyama cia gũciigana,","poem":1},{"text":"na ũgĩitĩra mũgoma waguo gĩa kũrĩa,","poem":2},{"text":"ũkĩiyũria imamo ciaguo na kĩrĩa woragĩte,","poem":1},{"text":"na ũkĩiyũria ngurunga ciaguo na kĩrĩa waguĩmĩte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Jehova Mwene-Hinya-Wothe ekuuga atĩrĩ,","poem":1},{"text":"“Niĩ nĩngũũkĩrĩire.","poem":2},{"text":"Nĩngacina ngaari ciaku cia ita na mwaki,","poem":1},{"text":"naruo rũhiũ rwa njora nĩrũkaniina mĩrũũthi yaku ĩrĩa mĩĩthĩ.","poem":2},{"lineBreak":true},{"text":"Ndigagũtigĩria kĩndũ gĩa kũguĩma gũkũ thĩ.","poem":2},{"text":"Nayo mĩgambo ya andũ arĩa ũtũmaga","poem":1},{"text":"ndĩgaacooka kũiguuo rĩngĩ.”","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"Hingĩrĩrio cia njũũĩ nĩ kuuga kũrĩa Rũũĩ rwa Koseri rwahingĩrĩirio, naguo mũiyũro ũcio wahingũrĩrwo ũkĩgũithia thingo.","reference":{"chapter":2,"verse":6}}]},"thisChapterLink":"/api/kik_bib/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}