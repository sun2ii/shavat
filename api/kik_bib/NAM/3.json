{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"NAM","translationId":"kik_bib","name":"Nahumu","commonName":"Nahumu","title":"NAHUMU","order":34,"numberOfChapters":3,"sha256":"712519ae01c468cf3bb3effe51fdc1cd979e516b2dd40b95e0a8c57879112310","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/kik_bib/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"heading","content":["Mwanangĩko Ũtangĩgirĩrĩka Nineve"]},{"type":"verse","number":1,"content":[{"text":"Kaĩ itũũra inene rĩa Nineve rĩrĩa rĩitaga thakame rĩrĩ na haaro-ĩ!","poem":1},{"text":"Itũũra rĩu rĩiyũrĩtwo nĩ maheeni","poem":2},{"text":"na indo cia ũtunyani,","poem":1},{"text":"na rĩtiagaga andũ moragĩtwo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Rĩ na mwanũko wa mĩcaarica,","poem":1},{"text":"na mũrurumo wa magũrũ ma ngaari,","poem":2},{"text":"na mbarathi itengʼerete,","poem":1},{"text":"na ngaari cia ita ikũrũgarũga!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Thigari cia mbarathi irahithũka,","poem":1},{"text":"ikahenũkia hiũ cia njora","poem":2},{"lineBreak":true},{"text":"na matimũ marahenia!","poem":2},{"text":"Andũ aingĩ nĩmooragĩtwo,","poem":1},{"text":"gũkagĩa na hĩba cia arĩa makuĩte,","poem":2},{"text":"na ciimba itangĩtarĩka,","poem":1},{"text":"nao andũ makahĩngwo nĩ ciimba icio:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"maũndũ maya mothe marekĩka nĩ ũndũ wa ũingĩ wa merirĩria ma mũmaraya,","poem":1},{"text":"ũrĩa ũguucĩrĩirie mũndũ-wa-nja ũcio mũrogi,","poem":2},{"text":"ũrĩa watuire ndũrĩrĩ ngombo na ũmaraya wake,","poem":1},{"text":"na agĩtua kĩrĩndĩ ngombo na ũragũri wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Jehova Mwene-Hinya-Wothe ekuuga atĩrĩ,","poem":1},{"text":"“Niĩ nĩngũgũũkĩrĩra.","poem":2},{"text":"Ngũkũheta nguo ikũhumbĩre ũthiũ.","poem":1},{"text":"Nguonia ndũrĩrĩ njaga yaku,","poem":2},{"lineBreak":true},{"text":"na ngũconorithie mbere ya mothamaki.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngũgũikĩria gĩko kĩrĩ magigi,","poem":1},{"text":"ngũnyarare ũtuĩke kĩndũ gĩa kũmakania gĩkĩonwo nĩ andũ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Arĩa othe magaakuona nĩmakoora makiugaga atĩrĩ,","poem":1},{"text":"‘Hĩ, Nineve nĩrĩanange, nũũ ũkaarĩcakaĩra?’","poem":2},{"lineBreak":true},{"text":"Mũndũ wa gũkũhooreria-rĩ, ingĩmũruta kũ?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Wee-rĩ, ũkĩrĩ mwega gũkĩra Thebesi,","poem":1},{"noteId":3},{"text":"itũũra rĩrĩa rĩakĩtwo Rũũĩ-inĩ rwa Nili,","poem":2},{"lineBreak":true},{"text":"o rĩo rĩrigiicĩirio nĩ maaĩ?","poem":2},{"text":"Rũũĩ rũu nĩruo rũrĩgitagĩra,","poem":1},{"text":"naruo rũthingo rwarĩo nĩ maaĩ macio.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kushi na Misiri nĩcio ciarĩ hinya warĩo ũtangĩathirire;","poem":1},{"text":"Putu na Lubimu maarĩ amwe a thiritũ narĩo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"No rĩrĩ, nĩrĩatahirwo,","poem":1},{"text":"na andũ aarĩo magĩthaamio.","poem":2},{"text":"Tũkenge twarĩo twatungumanirio,","poem":1},{"text":"tũgĩtuĩka icunjĩ magomano-inĩ mothe ma njĩra.","poem":2},{"text":"Mĩtĩ nĩyacuukĩirwo andũ aarĩo arĩa maarĩ igweta,","poem":1},{"text":"anene othe aarĩo makĩohwo na mĩnyororo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wee nawe nĩũkarĩĩo,","poem":1},{"text":"na nĩũkoora, wĩhithe,","poem":2},{"lineBreak":true},{"text":"wethe kĩĩhitho ũũrĩre thũ ciaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ciĩhitho ciaku nũmu ciothe ihaana ta mĩtĩ ya mĩkũyũ,","poem":1},{"text":"ĩrĩ na ngũyũ iria ciambĩte kwĩrua,","poem":2},{"text":"yainainio-rĩ,","poem":1},{"text":"ngũyũ ikagũa kanua-inĩ ka mũrĩi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tarora, mbũtũ ciaku cia ita,","poem":1},{"text":"hĩ, ciothe ihaana ta andũ-a-nja!","poem":2},{"text":"Ihingo cia bũrũri waku","poem":1},{"text":"nĩ hingũrĩre thũ ciaku biũ,","poem":2},{"lineBreak":true},{"text":"mĩgĩĩko yacio ĩgacinwo na mwaki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Taha maaĩ ũige, ũgaakorwo namo hĩndĩ ya kũrigiicĩrio,","poem":1},{"text":"ciĩgitĩro ciaku cia hinya ũcirũmie wega!","poem":2},{"text":"Haarĩria rĩũmba,","poem":1},{"text":"kia ndoro,","poem":2},{"lineBreak":true},{"text":"ũthondeke maturubarĩ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kũu nĩkuo mwaki ũgaakũniinĩra,","poem":1},{"text":"na rũhiũ rwa njora rũgũtemenge ũthire biũ,","poem":2},{"lineBreak":true},{"text":"rũkũrĩe o ta ũrĩa ũngĩrĩĩo nĩ itono.","poem":2},{"text":"Ciaranai ta itono,","poem":1},{"text":"mũciarane, mũingĩhe ta ngigĩ!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Onjoria aku ũmaingĩhĩtie,","poem":1},{"text":"makaingĩha gũkĩra njata cia igũrũ,","poem":2},{"text":"no mahaana ta ngigĩ iria cianangaga bũrũri,","poem":1},{"text":"igacooka ikeyũmbũkĩra.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Arangĩri aku matariĩ ta ngigĩ,","poem":1},{"text":"anene aku nao nĩ ta mĩrumbĩ ya ngigĩ,","poem":2},{"lineBreak":true},{"text":"ĩrĩa yũmbaga thingo-inĩ ciaku mũthenya wa heho,","poem":2},{"text":"no riũa rĩara, ĩkombũka ĩgathiĩ,","poem":1},{"text":"na gũtirĩ mũndũ ũngĩmenya kũrĩa yathiĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Atĩrĩrĩ, wee mũthamaki wa Ashuri, arĩithi aku nĩmakomete;","poem":1},{"text":"andũ aku arĩa marĩ igweta nĩmahuurũkĩte.","poem":2},{"text":"Andũ aku othe mahurunjũkĩire irĩma-inĩ,","poem":1},{"text":"na gũtirĩ wa kũmacookanĩrĩria.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kĩronda gĩaku gĩtingĩhona;","poem":1},{"text":"nguraro yaku nĩ ya gũkũũraga.","poem":2},{"text":"Mũndũ o wothe ũiguĩte ũhoro waku","poem":1},{"text":"arahũũra hĩ tondũ nĩũgwĩte,","poem":2},{"text":"nũũ ũtarĩ wahutio","poem":1},{"text":"nĩ kĩnyariirano gĩaku gĩtarĩ mũthia?","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"Thebesi rĩarĩ itũũra inene rĩa mwena wa rũgongo wa Rũũĩ rwa Nili. No rĩo rĩetagwo No kana No-Amoni.","reference":{"chapter":3,"verse":8}}]},"thisChapterLink":"/api/kik_bib/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}