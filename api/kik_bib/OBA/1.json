{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"OBA","translationId":"kik_bib","name":"Obadia","commonName":"Obadia","title":"OBADIA","order":31,"numberOfChapters":1,"sha256":"c66f9df26f8f142fafc931a2ce410139bc6d1b87d6e658ad4b8a7a2ebd2d4f24","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/OBA/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/kik_bib/OBA/1.json","totalNumberOfVerses":21},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Kĩoneki kĩa Obadia.",{"text":"Mwathani Jehova ekuuga ũũ ũhoro ũkoniĩ Edomu:","poem":1},{"lineBreak":true},{"text":"Nĩtũiguĩte ũhoro uumĩte kũrĩ Jehova.","poem":1},{"text":"Mũtũmwo nĩatũmirwo kũrĩ ndũrĩrĩ oige atĩrĩ,","poem":2},{"text":"“Arahũkai, tũthiĩ tũmũũkĩrĩre, tũrũe nake”:","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Atĩrĩrĩ, nĩngakũnyiihia maitho-inĩ ma ndũrĩrĩ;","poem":1},{"text":"nawe nĩũkameneka biũ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mwĩtĩĩo wa ngoro yaku nĩũkũheenetie,","poem":1},{"text":"wee ũtũũraga kũu ngurunga-inĩ cia mahiga,","poem":2},{"lineBreak":true},{"text":"na ũgathondeka gĩikaro gĩaku kũrĩa gũtũũgĩru,","poem":2},{"text":"o wee wĩĩraga na ngoro atĩrĩ,","poem":1},{"text":"‘Nũũ ũngĩhota kũũharũrũkia andehe nginya thĩ?’","poem":2}]},{"type":"verse","number":4,"content":[{"text":"O na ũngĩkorwo ũmbũkaga na igũrũ ta nderi,","poem":1},{"text":"na ũgaaka gĩtara gĩaku o kũu njata irĩ,","poem":2},{"lineBreak":true},{"text":"nĩngakũharũrũkia thĩ ngũrute kuo,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]},{"type":"verse","number":5,"content":[{"text":"“Ũngĩkorwo nĩ aici,","poem":1},{"text":"o na kana ũkorwo nĩ atunyani ũtukũ-rĩ,","poem":2},{"text":"kaĩ mwanangĩko nĩũgwetereire-ĩ!","poem":1},{"text":"Githĩ matingĩiya o nginya maiganie?","poem":2},{"text":"Atui a thabibũ mangĩũka gwaku-rĩ,","poem":1},{"text":"githĩ to matigie tũthabibũ tũnini tũngĩhaarwo?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"No kaĩ Esaũ nĩakongũrũrio-ĩ,","poem":1},{"text":"nakĩo kĩgĩĩna gĩake kĩrĩa kĩhithe gĩgĩtahwo-ĩ!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Andũ othe arĩa mũgwatanagĩra nao nĩmagakũingata nginya mũhaka-inĩ;","poem":1},{"text":"arata aku nĩmagakũheenia na magũtoorie;","poem":2},{"text":"arĩa marĩĩaga irio ciaku nĩmagakũigĩra mũtego,","poem":1},{"text":"no wee ndũkamenya.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Jehova ekuuga atĩrĩ,","poem":1},{"text":"“Githĩ mũthenya ũcio ndikaananga andũ arĩa oogĩ a Edomu,","poem":2},{"lineBreak":true},{"text":"na nyanange andũ arĩa marĩ ũmenyo kũu irĩma-inĩ cia Esaũ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Atĩrĩrĩ, wee Temani,","poem":1},{"noteId":0},{"text":"njamba ciaku cia ita nĩikaamaka,","poem":1},{"text":"na andũ othe arĩa matũũraga irĩma-inĩ cia Esaũ","poem":2},{"lineBreak":true},{"text":"mooragwo, maniinwo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nĩ ũndũ wa ngũĩ ya gũũkĩrĩra mũrũ wa nyũkwa Jakubu,","poem":1},{"text":"nĩũgaconorithio;","poem":2},{"lineBreak":true},{"text":"nĩũkaniinwo nginya tene.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mũthenya ũrĩa wamũtiganĩirie,","poem":1},{"text":"rĩrĩa andũ a kũngĩ maatahire ũtonga wake,","poem":2},{"text":"nao ageni magĩtoonyera ihingo-inĩ ciake,","poem":1},{"text":"na magĩcuukĩra Jerusalemu mĩtĩ-rĩ,","poem":2},{"lineBreak":true},{"text":"we watariĩ o ta ũmwe wao.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"No wee ndũngĩanyararire mũrũ wa nyũkwa","poem":1},{"text":"mũthenya wake wa mũtino,","poem":2},{"text":"kana ũkenerere andũ a Juda","poem":1},{"text":"mũthenya ũrĩa maaniinagwo,","poem":2},{"text":"o na kana wĩtĩĩe mũno","poem":1},{"text":"mũthenya ũrĩa maarĩ na thĩĩna.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wee ndũngĩatuĩkanĩirie ihingo-inĩ cia andũ akwa","poem":1},{"text":"mũthenya wao wa mwanangĩko,","poem":2},{"text":"kana ũmanyarare hĩndĩ ĩrĩa maarĩ na mũnyarirĩko","poem":1},{"text":"mũthenya wao wa kwanangwo,","poem":2},{"text":"kana ũtahe ũtonga wao","poem":1},{"text":"mũthenya ũcio wa mwanangĩko.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wee ndwagĩrĩirwo kũmooheria magomano-inĩ ma njĩra","poem":1},{"text":"nĩguo ũũrage arĩa mooraga,","poem":2},{"text":"kana ũneane matigari mao","poem":1},{"text":"mũthenya ũcio maarĩ na thĩĩna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Mũthenya wa Jehova ũrĩ hakuhĩ","poem":1},{"text":"gũkinyĩra ndũrĩrĩ ciothe.","poem":2},{"text":"O ũrĩa wĩkĩte, noguo nawe ũgeekwo;","poem":1},{"text":"ciĩko ciaku nĩigagũcookerera.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"O ta ũrĩa inyuĩ mwanyuĩrĩire gĩkombe gĩakwa kĩa iherithia kũu kĩrĩma-inĩ gĩakwa gĩtheru-rĩ,","poem":1},{"text":"ũguo noguo ndũrĩrĩ ciothe igaakĩnyuĩra itegũtigithĩria.","poem":2},{"text":"Ikaanyua ikĩhũhũte,","poem":1},{"text":"ininũkio, nacio ihaane ta itarĩ ciakorwo kuo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"No rĩrĩ, kũu Kĩrĩma-inĩ gĩa Zayuni nĩgũgakorwo na ũhonokio;","poem":1},{"text":"nakĩo kĩrĩma kĩu gĩgaakorwo kĩrĩ gĩtheru,","poem":2},{"text":"nayo nyũmba ya Jakubu","poem":1},{"text":"nĩĩkegwatĩra igai rĩayo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nyũmba ya Jakubu ĩgaatuĩka ta mwaki,","poem":1},{"text":"nayo nyũmba ya Jusufu ĩtuĩke ta rũrĩrĩmbĩ;","poem":2},{"text":"nayo nyũmba ya Esaũ ĩgaatuĩka ta maragara ma mahuti,","poem":1},{"text":"na nĩmakamĩmundia mwaki, ũmĩniine biũ.","poem":2},{"text":"Gũtirĩ mũndũ ũgaatigara","poem":1},{"text":"wa kuuma nyũmba ya Esaũ.”","poem":2},{"text":"Jehova nĩwe uugĩte ũguo.","poem":4}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Andũ a Negevu nĩmagaikara","poem":1},{"text":"irĩma-inĩ cia Esaũ,","poem":2},{"text":"nao andũ arĩa maikaraga magũrũ-inĩ ma tũrĩma","poem":1},{"text":"megwatĩre bũrũri wa Afilisti.","poem":2},{"text":"Nĩmagaikara mĩgũnda-inĩ ya Efiraimu, na ya Samaria,","poem":1},{"text":"nake Benjamini egwatĩre Gileadi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Gĩkundi kĩrĩa gĩatahĩtwo kĩa andũ a Isiraeli kĩrĩa kĩrĩ kũu Kaanani,","poem":1},{"text":"gĩkeegwatĩra bũrũri ũcio o nginya Zarefathu;","poem":2},{"noteId":1},{"text":"nao andũ arĩa maatahirwo kuuma Jerusalemu, acio marĩ kũu Sefaradi,","poem":1},{"text":"nĩo makegwatĩra matũũra ma Negevu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Andũ a kũhonokania nĩmakambata Kĩrĩma-inĩ gĩa Zayuni","poem":1},{"text":"nĩguo maathanage kũu irĩma-inĩ cia Esaũ.","poem":2},{"lineBreak":true},{"text":"Naguo ũthamaki ũgaatuĩka wa Jehova.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Rĩĩtwa Temani nĩ kuuga Edomu guothe, na rĩgĩtaũrwo nĩ kuuga “Gũthini.”","reference":{"chapter":1,"verse":9}},{"noteId":1,"caller":"+","text":"Zarefathu gwĩciiragĩrio nokuo Sefaradi, itũũra rĩa Asia Nini.","reference":{"chapter":1,"verse":20}}]},"thisChapterLink":"/api/kik_bib/OBA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/JON/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/AMO/9.json","previousChapterAudioLinks":{},"numberOfVerses":21}