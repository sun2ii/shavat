{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PRO","translationId":"kik_bib","name":"Thimo","commonName":"Thimo","title":"THIMO","order":20,"numberOfChapters":31,"sha256":"5e9e596f42fa2a123c547496be925f805dd7888517ea58850539744cb4759d7c","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kik_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":30,"content":[{"type":"heading","content":["Mĩario ya Aguri"]},{"type":"verse","number":1,"content":["Ĩno nĩyo mĩario ya Aguri mũrũ wa Jake, na nĩ ndũmĩrĩri nditũ:",{"text":"Mũndũ ũcio eerire Ithieli,","poem":1},{"text":"akĩĩra Ithieli na Ukali atĩrĩ:","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Niĩ ndĩ mũndũ mũriitu gũkĩra andũ arĩa angĩ;","poem":1},{"text":"ndirĩ na ũtaũku ta wa mũndũ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndiĩrutĩte kũgĩa na ũũgĩ,","poem":1},{"text":"o na kana ngamenya Ũrĩa Mũtheru.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nũũ wanambata igũrũ na agacooka agaikũrũka gũkũ thĩ?","poem":1},{"text":"Nũũ wanacookereria rũhuho ngundi-inĩ ciake?","poem":2},{"text":"Maaĩ namo-rĩ, nũũ ũrĩ wamoohania na nguo yake ya igũrũ?","poem":1},{"text":"Nũũ wahaandire ituri ciothe cia thĩ?","poem":2},{"text":"Etagwo atĩa, nake mũriũ etagwo atĩa?","poem":1},{"text":"Akorwo nĩũũĩ-rĩ, ndũkĩnjĩĩre!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Kiugo gĩothe kĩa Ngai gĩtirĩ mahĩtia;","poem":1},{"text":"nĩwe ngo ya arĩa moragĩra harĩ we.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndũkanongerere ciugo ciake,","poem":1},{"text":"ndakae gũkũrũithia wonekane ũrĩ wa maheeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Nĩngũkũhooya maũndũ meerĩ, Wee Jehova;","poem":1},{"text":"ndũkanarege kũhe mo mbere ya ngue:","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Atĩrĩrĩ, njehereria maũndũ matarĩ ma ma, na ma maheeni, cindaihĩrĩrie mũno;","poem":1},{"text":"ningĩ ndũkaahe ũthĩĩni kana ũtonga,","poem":2},{"lineBreak":true},{"text":"no ũũheage irio cia o mũthenya.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndikaagĩe na indo nyingĩ mũno, ngũkaane,","poem":1},{"text":"njũũrie atĩrĩ, ‘Jehova nũũ?’","poem":2},{"text":"Kana thĩĩne mũno, njiye,","poem":1},{"text":"na nĩ ũndũ ũcio ngĩmenererie rĩĩtwa rĩa Ngai wakwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Ndũgacambie ndungata kũrĩ mũnene wayo,","poem":1},{"text":"ndĩgagĩkũrume, nawe ũrĩhio ũũru ũcio.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Nĩ kũrĩ andũ marumaga maithe mao","poem":1},{"text":"o na matangĩrathima manyina mao;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"kũrĩ andũ arĩa meyonaga marĩ atheru maitho-inĩ mao,","poem":1},{"text":"o rĩrĩa matathambĩtio gĩko kĩao;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"nĩ arĩa marĩ maitho ma mwĩtĩĩo,","poem":1},{"text":"o arĩa maroraga andũ manyiira;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"nĩo arĩa magego mao mahaana ta hiũ cia njora,","poem":1},{"text":"na ngambucu ciao ihaana ta tũhiũ","poem":2},{"text":"twa gũtambuura arĩa athĩĩni, mahuke thĩ,","poem":1},{"text":"na arĩa abatari, mathire andũ-inĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Thambara ĩrĩ airĩtu eerĩ.","poem":1},{"text":"Matitigithagĩria kuuga, ‘Tũhei! Tũhei!’","poem":2},{"lineBreak":true},{"text":"“Kũrĩ indo ithatũ itarĩ hĩndĩ ihũũnaga,","poem":1},{"text":"o na nĩ inya itarĩ hĩndĩ ingiuga, ‘Nĩndaigania!’","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nacio nĩ mbĩrĩra, na nda thaata,","poem":1},{"text":"na thĩ tondũ ndĩrĩ hĩndĩ ĩiganagia maaĩ,","poem":2},{"lineBreak":true},{"text":"na mwaki tondũ ndũrĩ hĩndĩ uugaga, ‘Nĩndaigania!’","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Riitho rĩa mũndũ ũrĩa ũnyũrũragia ithe,","poem":1},{"text":"na akarurũka kũiguaga nyina,","poem":2},{"text":"rĩgaakũũrwo nĩ mahuru ma kĩanda-inĩ,","poem":1},{"text":"na rĩkaarĩĩo nĩ nderi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Kũrĩ maũndũ matatũ mangegagia mũno makĩria,","poem":1},{"text":"o na nĩ mana marĩa niĩ itakuũkagĩrwo nĩmo:","poem":2}]},{"type":"verse","number":19,"content":[{"text":"namo nĩ mũthiĩre wa nderi rĩera-inĩ,","poem":1},{"text":"na mũthiĩre wa nyoka rwaro-inĩ rwa ihiga,","poem":2},{"text":"na mũthiĩre wa marikabu ĩrĩ iria-inĩ gatagatĩ,","poem":1},{"text":"na mũthiĩre wa mũndũ makĩendana na mũirĩtu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Ũyũ nĩguo mũthiĩre wa mũndũ-wa-nja mũtharia:","poem":1},{"text":"Arĩĩaga na akehuura mĩromo,","poem":2},{"lineBreak":true},{"text":"akoiga atĩrĩ, ‘Ndirĩ ũndũ mũũru njĩkĩte.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Kũrĩ maũndũ matatũ matũmaga thĩ ĩthingithe,","poem":1},{"text":"o na nĩ mana ĩtangĩĩtiiria:","poem":2}]},{"type":"verse","number":22,"content":[{"text":"namo nĩ ndungata ĩtuĩkĩte mũthamaki,","poem":1},{"text":"na mũndũ mũkĩĩgu ahũũnĩte irio,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"na mũndũ-wa-nja ũtangĩendeka ahikĩte,","poem":1},{"text":"na ndungata ya mũirĩtu ĩtuĩkĩte mũtumia wa mũthuuri wa mũmĩathi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“Nĩ kũrĩ nyamũ inya nini gũkũ thĩ,","poem":1},{"text":"no nĩ njũgĩ mũno:","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Thigiriri-rĩ, nĩ ciũmbe itarĩ hinya,","poem":1},{"text":"no nĩciĩigagĩra mũthiithũ wa irio hĩndĩ ya riũa;","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ikami nĩ ciũmbe itarĩ ũhoti,","poem":1},{"text":"no nĩciĩthondekagĩra ciikaro ciacio ndwaro-inĩ cia mahiga;","poem":2},{"noteId":2}]},{"type":"verse","number":27,"content":[{"text":"ngigĩ itirĩ mũthamaki wacio,","poem":1},{"text":"no nĩitwaranaga hamwe irĩ mbũtũ;","poem":2}]},{"type":"verse","number":28,"content":[{"text":"njagathi no inyiitwo na rũhĩ,","poem":1},{"text":"no ĩtũũraga thĩinĩ wa nyũmba cia athamaki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Kũrĩ indo ithatũ irĩ mũkinyũkĩrie mũgaacĩru,","poem":1},{"text":"o na nĩ inya ngaacĩru rĩrĩa igũthiĩ:","poem":2}]},{"type":"verse","number":30,"content":[{"text":"nĩ mũrũũthi, arĩ guo ũrĩ hinya mũno gatagatĩ ka nyamũ iria ingĩ ciothe,","poem":1},{"text":"na ndũngĩeherera nyamũ ĩrĩkũ kana ĩrĩkũ njĩra;","poem":2}]},{"type":"verse","number":31,"content":[{"text":"nĩ njamba ya ngũkũ ĩrĩa ĩkinyũkagia na nguthi, na thenge,","poem":1},{"text":"na mũthamaki mũthiũrũrũkĩrie nĩ mbũtũ ciake cia ita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"“Angĩkorwo nĩwĩtuĩte mũndũ mũkĩĩgu, na ũgetũũgĩria,","poem":1},{"text":"kana ũkorwo nĩũthugundĩte gwĩka ũũru-rĩ,","poem":2},{"lineBreak":true},{"text":"humbĩra kanua gaku na rũhĩ!","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Nĩgũkorwo o ta ũrĩa iria rĩthũcagwo, rĩkoima thiagĩ,","poem":1},{"text":"na o ta ũrĩa iniũrũ rĩthioragwo rĩkoira thakame-rĩ,","poem":2},{"lineBreak":true},{"text":"ũguo noguo gũthogotha marakara kũrehaga ngũĩ.”","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"Ikami nĩ mũthemba wa mbũkũ ciikaraga marima-inĩ ma irĩma irĩ ikundi.","reference":{"chapter":30,"verse":26}}]},"thisChapterLink":"/api/kik_bib/PRO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}