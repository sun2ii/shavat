{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PRO","translationId":"kik_bib","name":"Thimo","commonName":"Thimo","title":"THIMO","order":20,"numberOfChapters":31,"sha256":"5e9e596f42fa2a123c547496be925f805dd7888517ea58850539744cb4759d7c","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/kik_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":7,"content":[{"type":"heading","content":["Gũkaanio kũgĩa Ndũgũ na Mũndũ-wa-Nja Mũtharia"]},{"type":"verse","number":1,"content":[{"text":"Mũrũ wakwa, tũũra ũrũmĩtie ciugo ciakwa,","poem":1},{"text":"na wĩigĩre maathani makwa thĩinĩ waku.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Rũmia maathani makwa,","poem":1},{"text":"na nĩũgatũũra muoyo;","poem":2},{"lineBreak":true},{"text":"gitagĩra morutani makwa o ta kĩũma kĩa riitho rĩaku.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mohagĩrĩre ciara-inĩ ciaku;","poem":1},{"text":"ũmaandĩke kĩhengere-inĩ kĩa ngoro yaku.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ĩra ũũgĩ atĩrĩ, “Wee nĩwe mwarĩ wa maitũ,”","poem":1},{"text":"naguo ũtaũku ũwĩtage mũndũ wa nyũmba yanyu;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"nĩcirĩkweheragia harĩ mũndũ-wa-nja ũcio mũtharia,","poem":1},{"text":"o na kuuma kũrĩ mũtumia ũcio ũtarĩ mwĩhokeku,","poem":2},{"lineBreak":true},{"text":"hamwe na ciugo ciake cia kũheenanĩrĩria.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ndĩ ndirica-inĩ ya nyũmba yakwa-rĩ,","poem":1},{"text":"nĩndacũthĩrĩirie na nja kamwanya-inĩ,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ngĩona kĩmwana gatagatĩ ka arĩa matarĩ oogĩ,","poem":1},{"text":"na ngĩkũũrana gatagatĩ ka aanake,","poem":2},{"lineBreak":true},{"text":"mũndũ mwĩthĩ ũtaarĩ na ũũgĩ wa gũkũũrana maũndũ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Aikũrũkaga na njĩra ĩrĩa yarĩ hakuhĩ na koine ya kwa mũndũ-wa-nja ũcio,","poem":1},{"text":"agĩthiĩ na njĩra ĩyo yerekeire na gwake mũciĩ,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"na kwarĩ na mairia o kahwaĩ-inĩ gũgĩtukatuka,","poem":1},{"text":"gũkĩambĩrĩria kũgĩa nduma ya ũtukũ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Na rĩrĩ, hagĩũka mũndũ-wa-nja kũmũtũnga,","poem":1},{"text":"wehumbĩte nguo ta mũmaraya, arĩ na wara ngoro-inĩ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"(Nĩ mũnegeni na mũngʼathia,","poem":1},{"text":"na magũrũ make matikiragĩrĩria mũciĩ;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"rĩmwe arĩ njĩra-inĩ, na rĩrĩa rĩngĩ arĩ ihaaro-inĩ,","poem":1},{"text":"ehithagĩre andũ koine-inĩ ciothe cia njĩra.)","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nake akĩnyiita mwanake ũcio, akĩmũmumunya,","poem":1},{"text":"na akĩmwĩra atĩrĩ ategũconoka,","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Ndĩ na maruta ma ngwatanĩro mũciĩ,","poem":1},{"text":"tondũ ũmũthĩ nĩhingirie mĩĩhĩtwa yakwa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nĩ ũndũ ũcio ndoimagara, ndooka gũgũtũnga;","poem":1},{"text":"ngũgũcarĩtie mũno, na rĩu nĩndakuona!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nĩnjarĩte ũrĩrĩ wakwa","poem":1},{"text":"na macuka ma gatani ma marangi kuuma Misiri.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ũrĩrĩ ũcio wakwa nĩndĩũitĩrĩirie indo nungi wega ta manemane,","poem":1},{"text":"na thubiri, o na mũndarathini.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ũka twĩhũũnie wendo nginya rũciinĩ;","poem":1},{"text":"reke twĩkenie na wendo!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mũthuuri wakwa ndarĩ mũciĩ;","poem":1},{"text":"nĩathiĩte rũgendo rũraihu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nĩathiire na mũhuko wake ũiyũrĩte mbeeca,","poem":1},{"text":"na akainũka mũciĩ o rĩrĩa mweri ũkaiganana.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Agĩkĩmũheenereria na ciugo, akĩmũhĩtithia;","poem":1},{"text":"agĩkĩmuuha na mĩario yake mĩnyoroku.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"O rĩmwe akĩmũrũmĩrĩra ta ndegwa ĩgĩthiĩ gũthĩnjwo,","poem":1},{"text":"kana ta thwariga ĩgĩtoonya kĩana-inĩ kĩa mũtego,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"nginya akaaya gũtheecwo ini nĩ mĩguĩ,","poem":1},{"text":"akahaana ta nyoni ĩguthũkĩte mũtego-inĩ,","poem":2},{"lineBreak":true},{"text":"ĩtekũmenya o na hanini atĩ ũndũ ũcio no ũmĩrute muoyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Atĩrĩrĩ, ariũ akwa, ta thikĩrĩriai;","poem":1},{"text":"tegai matũ mũigue ũrĩa ngũmwĩra.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mũtikanareke ngoro cianyu ĩrũmĩrĩre mĩthiĩre yake,","poem":1},{"text":"kana mũingĩre njĩra-inĩ ciake.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nĩ andũ aingĩ arĩkĩtie kũrũnda;","poem":1},{"text":"arĩa oragĩte nĩ kĩrĩndĩ kĩingĩ mũno.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nyũmba yake nĩ njĩra njariĩ ya gũthiĩ mbĩrĩra,","poem":1},{"text":"nayo yerekagĩria andũ nyũmba-inĩ cia gĩkuũ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}