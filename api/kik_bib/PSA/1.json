{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"heading","content":["Gĩkeno Kĩrĩa kĩa Ma"]},{"type":"verse","number":1,"content":[{"text":"Kũrathimwo-rĩ, nĩ mũndũ","poem":1},{"text":"ũrĩa ũtatwaranaga na ũtaaro wa andũ arĩa aaganu,","poem":2},{"text":"kana akarũgama njĩra-inĩ ya andũ arĩa mehagia,","poem":1},{"text":"o na kana agaikarĩra gĩtĩ kĩa arĩa manyũrũranagia.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"No rĩrĩ, nĩ watho wa Jehova akenagĩra,","poem":1},{"text":"na agecũũranagia ũhoro wa watho wake kũrĩ mũthenya kana ũtukũ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mũndũ ũcio ahaana ta mũtĩ mũhaande tũmĩtaro-inĩ twa maaĩ,","poem":1},{"text":"naguo ũciaraga maciaro maguo hĩndĩ ya mo yakinya,","poem":2},{"text":"namo mathangũ maguo matihoohaga.","poem":1},{"text":"Na rĩrĩ, ũndũ o wothe ekaga nĩũgaacagĩra.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"No andũ arĩa aaganu matihaana ũguo!","poem":1},{"text":"Mahaana ta mũũngũ","poem":2},{"lineBreak":true},{"text":"ũrĩa ũmbũragwo nĩ rũhuho.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nĩ ũndũ ũcio andũ arĩa aaganu matigetiiria ciira-inĩ,","poem":1},{"text":"kana andũ arĩa ehia metiirie kĩũngano-inĩ kĩa andũ arĩa athingu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nĩgũkorwo Jehova nĩamenyagĩrĩra njĩra ya andũ arĩa athingu,","poem":1},{"text":"no andũ arĩa aaganu marĩ njĩra-inĩ ya kũũra.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}