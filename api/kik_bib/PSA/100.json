eBreak":true},{"text":"wĩhokeku wake nĩ wa nginya njiarwa na njiarwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}