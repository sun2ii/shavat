{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"heading","content":["Wĩhokeku wa Mũthamaki harĩ Ngai"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Niĩ ndĩinaga ũhoro wa wendo na wa kĩhooto gĩaku;","poem":1},{"text":"Wee Jehova nĩwe ndĩrĩgoocaga na rwĩmbo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nĩngwĩmenyerera ndũũre mũtũũrĩre ũtarĩ ũcuuke:","poem":1},{"text":"nĩ rĩ ũgaagĩũka kũrĩ niĩ?","poem":2},{"lineBreak":true},{"text":"Nĩndĩrĩikaraga mũciĩ gwakwa","poem":1},{"text":"ndĩ na ngoro ĩtarĩ ũcuuke.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gũtirĩ ũndũ mũũru","poem":1},{"text":"ndĩrĩigaga mbere ya maitho makwa.","poem":2},{"lineBreak":true},{"text":"Nĩthũire ciĩko cia andũ arĩa matarĩ wĩtĩkio;","poem":1},{"text":"ndingĩĩtĩkĩra menyiitĩrĩre harĩ niĩ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndĩrĩikaraga haraihu na andũ arĩa marĩ ngoro nemi;","poem":1},{"text":"ũũru-rĩ, ndirĩ hĩndĩ ngaanyiitanĩra naguo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mũndũ o wothe ũngĩcambia mũndũ wa itũũra rĩake na hitho,","poem":1},{"text":"ũcio nĩngamũniina;","poem":2},{"text":"mũndũ o wothe ũrĩ maitho ma rũngʼathio na ngoro ya mwĩtĩĩo,","poem":1},{"text":"ũcio ndikamũkirĩrĩria.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Maitho makwa-rĩ, marĩroraga andũ arĩa ehokeku bũrũri-inĩ,","poem":1},{"text":"nĩguo maikaranagie na niĩ;","poem":2},{"text":"mũndũ ũrĩa mĩthiĩre yake ĩtarĩ ũcuuke-rĩ,","poem":1},{"text":"ũcio nĩarĩndungatagĩra.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gũtirĩ mũndũ wĩkaga maũndũ ma mawara","poem":1},{"text":"ũgaikara nyũmba-inĩ yakwa;","poem":2},{"text":"gũtirĩ mũndũ waragia maheeni","poem":1},{"text":"ũkaarũgama mbere yakwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"O rũciinĩ nĩndĩrĩkiragia","poem":1},{"text":"arĩa othe aaganu bũrũri-inĩ;","poem":2},{"text":"nĩngeheria andũ arĩa othe mekaga ũũru","poem":1},{"text":"mathire itũũra-inĩ rĩrĩa inene rĩa Jehova.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}