{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":106,"content":[{"type":"heading","content":["Kuumbũra Mehia ma Isiraeli"]},{"type":"verse","number":1,"content":[{"text":"Goocai Jehova.","poem":1},{"lineBreak":true},{"text":"Cookeriai Jehova ngaatho, nĩgũkorwo nĩ mwega;","poem":1},{"text":"wendo wake ũtũũraga nginya tene.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nũũ ũngiuga ciĩko cia hinya cia Jehova,","poem":1},{"text":"kana aanĩrĩre kũna ũgooci wake wothe?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kũrathimwo-rĩ, nĩ arĩa marũmagia kĩhooto,","poem":1},{"text":"arĩa meekaga ũrĩa kwagĩrĩire hĩndĩ ciothe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndirikanaga, Wee Jehova, hĩndĩ ĩrĩa ũgwĩka andũ aku wega,","poem":1},{"text":"ũndeithagie rĩrĩa ũkũmahonokia,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"nĩguo ngenagĩre ũgaacĩru wa andũ aku athuure,","poem":1},{"text":"nĩguo ngwatanagĩre gĩkeno-inĩ kĩa rũrĩrĩ rwaku,","poem":2},{"lineBreak":true},{"text":"na nyiitanagĩre na igai rĩaku tũgĩkũgooca.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ithuĩ nĩtwĩhĩtie, o ta ũrĩa maithe maitũ meehirie;","poem":1},{"text":"nĩtwĩkĩte ũũru na tũkaagana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Rĩrĩa maithe maitũ maarĩ Misiri,","poem":1},{"text":"matiarũmbũirie ciama ciaku;","poem":2},{"text":"matiigana kũririkana ũtugi waku mũingĩ,","poem":1},{"text":"na makĩrema marĩ hũgũrũrũ-inĩ cia iria, o Iria rĩu Itune.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"No nĩamahonokirie nĩ ũndũ wa rĩĩtwa rĩake,","poem":1},{"text":"nĩguo atũme hinya wake mũnene ũmenyeke.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nĩakũũmire Iria Itune, narĩo rĩkĩhũa;","poem":1},{"text":"akĩmagereria kũu kũriku taarĩ werũ-inĩ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nĩamahonokirie guoko-inĩ kwa andũ arĩa maamathũire;","poem":1},{"text":"akĩmakũũra kuuma guoko-inĩ gwa thũ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Maaĩ macio nĩmahubanĩirie amuku ao;","poem":1},{"text":"gũtirĩ o na ũmwe wao watigarire.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hĩndĩ ĩyo magĩĩtĩkia ciĩranĩro ciake,","poem":1},{"text":"na makĩmũinĩra, makĩmũgooca.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"No makĩriganĩrwo o narua nĩ ũrĩa ekĩte,","poem":1},{"text":"na matiigana gweterera ũtaaro wake.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Marĩ kũu werũ-inĩ makĩnyiitwo nĩ thuti;","poem":1},{"text":"makĩgeria Mũrungu marĩ kũu gũtagĩĩaga kĩndũ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nĩ ũndũ ũcio akĩmahe kĩrĩa maamwĩtirie,","poem":1},{"text":"no akĩmatũmĩra mũrimũ wa kũmanyariira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ningĩ nĩmaiguĩrĩire Musa ũiru marĩ kũu kambĩ-inĩ,","poem":1},{"text":"o na makĩiguĩra Harũni ũiru, o ũcio wamũrĩirwo Jehova.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Thĩ ĩgĩatũka na ĩkĩmeria Dathani;","poem":1},{"text":"ningĩ ĩgĩthika thiritũ ya Abiramu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mwaki ũgĩakana gatagatĩ-inĩ ka arũmĩrĩri ao;","poem":1},{"text":"rũrĩrĩmbĩ rũgĩcina andũ acio aaganu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Nĩmathondekire gacaũ marĩ kũu Horebu,","poem":1},{"text":"makĩhooya mũhianano ũtweketio kuuma kũrĩ kĩgera.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Maakũũranirie Riiri wa Ngai","poem":1},{"text":"na mũhianano wa ndegwa ĩrĩa ĩrĩĩaga nyeki.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Makĩriganĩrwo nĩ Mũrungu ũrĩa wamahonokirie,","poem":1},{"text":"ũrĩa wekĩte maũndũ manene kũu bũrũri wa Misiri,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"akĩringa ciama bũrũri wa Hamu,","poem":1},{"text":"na agĩĩka mawĩko ma gwĩtigĩrwo Iria-inĩ Itune.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nĩ ũndũ ũcio akiuga nĩekũmaniina,","poem":1},{"text":"tiga nĩ Musa, ũrĩa we aathurĩte,","poem":2},{"text":"warũgamire mbere yake,","poem":1},{"text":"akĩmũthaitha ndakamaniine na mangʼũrĩ make.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ningĩ makĩnyarara bũrũri ũcio mwega,","poem":1},{"text":"makĩaga gwĩtĩkia kĩĩranĩro gĩake.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Makĩnuguna marĩ hema-inĩ ciao,","poem":1},{"text":"na makĩaga gwathĩkĩra Jehova.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nĩ ũndũ ũcio akĩoya guoko na igũrũ,","poem":1},{"text":"akĩĩhĩta atĩ nĩakamangʼaũranĩria kũu werũ-inĩ,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"angʼaũranĩrie njiaro ciao kũu gatagatĩ-inĩ ka ndũrĩrĩ,","poem":1},{"text":"aciharaganĩrie kũu mabũrũri-inĩ guothe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Nĩmeyohanirie na Baali ya Peoru,","poem":1},{"text":"na makĩrĩa magongona maarutĩirwo ngai itarĩ muoyo;","poem":2}]},{"type":"verse","number":29,"content":[{"text":"magĩtũma Jehova arakare nĩ ũndũ wa ciĩko ciao cia waganu,","poem":1},{"text":"naguo mũthiro ũgĩtuthũka gatagatĩ-inĩ kao.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"No Finehasi akĩrũgama na igũrũ, akĩherithia arĩa maarĩ na mahĩtia,","poem":1},{"text":"naguo mũthiro ũgĩthira.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ũhoro ũcio ũgĩtũma atuuo nĩ mũthingu","poem":1},{"text":"kũrĩ njiarwa na njiarwa nginya tene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Nao makĩrakaria Jehova hau maaĩ-inĩ ma Meriba,","poem":1},{"text":"nake Musa agĩkinyĩrĩrwo nĩ thĩĩna nĩ ũndũ wao;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"nĩgũkorwo nĩmaremeire Roho wa Ngai,","poem":1},{"text":"nake Musa akĩaria ciugo itaagĩrĩire.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Matiigana kũniina ndũrĩrĩ icio","poem":1},{"text":"ta ũrĩa Jehova aamaathĩte,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"no nĩgũtukana maatukanire na ndũrĩrĩ,","poem":1},{"text":"na makĩrũmĩrĩra mĩtugo yao.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Makĩhooya mĩhianano yao,","poem":1},{"text":"ĩrĩa yatuĩkire mũtego kũrĩ o.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Makĩrutĩra ndaimono","poem":1},{"text":"aanake na airĩtu ao marĩ magongona.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Magĩita thakame ĩteehĩtie,","poem":1},{"text":"thakame ya aanake na airĩtu ao,","poem":2},{"text":"arĩa maarutire marĩ magongona kũrĩ mĩhianano ya Kaanani,","poem":1},{"text":"naguo bũrũri ũgĩthaahio nĩ thakame yao.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Nĩmethaahirie o ene nĩ gwĩka ũguo meekire;","poem":1},{"text":"na ũndũ wa ciĩko ciao makĩhũũra ũmaraya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Nĩ ũndũ ũcio Jehova akĩrakarĩra andũ ake,","poem":1},{"text":"na agĩthũũra igai rĩake mũno.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Akĩmaneana kũrĩ ndũrĩrĩ,","poem":1},{"text":"nĩguo maathagwo nĩ thũ ciao.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Thũ ciao ikĩmahinyĩrĩria,","poem":1},{"text":"na ikĩmaiga rungu rwa wathani wao.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Nake akĩmateithũra mahinda maingĩ,","poem":1},{"text":"no-o makĩrema,","poem":2},{"lineBreak":true},{"text":"makĩrikĩra mehia-inĩ mao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"Nowe akĩona mĩnyamaro yao","poem":1},{"text":"rĩrĩa aaiguire magĩkaya;","poem":2}]},{"type":"verse","number":45,"content":[{"text":"nĩ ũndũ wao akĩririkana kĩrĩkanĩro gĩake,","poem":1},{"text":"na nĩ ũndũ wa wendo wake mũnene akĩringwo nĩ tha.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Agĩtũma maiguĩrwo tha","poem":1},{"text":"nĩ arĩa othe maamatahĩte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"Tũhonokie, Wee Jehova Ngai witũ,","poem":1},{"text":"na ũtũcookanĩrĩrie ũtũrute kũrĩ ndũrĩrĩ,","poem":2},{"text":"nĩguo tũcookagĩrie rĩĩtwa rĩaku itheru ngaatho,","poem":1},{"text":"na twĩrahagĩre ũgooci waku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":48,"content":[{"text":"Jehova arogoocwo, o we Ngai wa Isiraeli,","poem":1},{"text":"kuuma tene wa tene, nginya o tene na tene.","poem":2},{"text":"Nao andũ othe nĩmakiuge, “Ameni!”","poem":1},{"lineBreak":true},{"text":"Goocai Jehova.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}