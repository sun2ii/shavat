{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"heading","content":["Rwĩmbo rwa Kwĩhoka Jehova"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Niĩ njũragĩra harĩ Jehova.","poem":1},{"text":"Mwahota atĩa kũnjĩĩra atĩrĩ:","poem":2},{"lineBreak":true},{"text":"“Ũmbũka ta nyoni ũũrĩre kĩrĩma-inĩ gĩaku.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ta rora, andũ arĩa aaganu nĩmageetete mota mao,","poem":1},{"text":"makahagĩka mĩguĩ yao ndigi-inĩ","poem":2},{"text":"nĩguo mehithĩte nduma-inĩ","poem":1},{"text":"marathe andũ arĩa atheru ngoro.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hĩndĩ ĩrĩa mĩthingi ĩraanangwo-rĩ,","poem":1},{"text":"andũ arĩa athingu mangĩhota gwĩka atĩa?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Jehova arĩ thĩinĩ wa hekarũ yake theru;","poem":1},{"text":"Jehova arĩ gĩtĩ-inĩ gĩake kĩa ũnene kũu igũrũ.","poem":2},{"text":"Acũthagĩrĩria ariũ a andũ;","poem":1},{"text":"maitho make nĩmamaroragia.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Jehova nĩaroragia andũ arĩa athingu,","poem":1},{"text":"no andũ arĩa aaganu na arĩa mendete haaro-rĩ,","poem":2},{"lineBreak":true},{"text":"ngoro yake nĩĩmathũire.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Andũ arĩa aaganu nĩakamoirĩria","poem":1},{"text":"marakara maraakana na ũbiriti ũgwakana;","poem":2},{"lineBreak":true},{"text":"igai rĩao nĩ rũhuho rũrĩa rũcinaga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nĩgũkorwo Jehova nĩ mũthingu,","poem":1},{"text":"na nĩendete ciira wa kĩhooto;","poem":2},{"lineBreak":true},{"text":"andũ arĩa arũngĩrĩru nĩo marĩonaga ũthiũ wake.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}