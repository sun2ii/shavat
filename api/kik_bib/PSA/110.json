{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"heading","content":["Ũhootani wa Mũthamaki Ũrĩa Mũthĩnjĩri-Ngai"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Jehova nĩerire Mwathani wakwa atĩrĩ:","poem":1},{"text":"“Ikara guoko-inĩ gwakwa kwa ũrĩo,","poem":2},{"text":"nginya rĩrĩa ngaatũma thũ ciaku","poem":1},{"text":"ituĩke gaturwa ka makinya maku.”","poem":2},{"noteId":22}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mũthĩgi wa hinya waku-rĩ,","poem":1},{"text":"Jehova nĩakaũtambũrũkia kuuma Zayuni;","poem":2},{"lineBreak":true},{"text":"nĩũgaathana ũrĩ gatagatĩ ga thũ ciaku.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ikundi ciaku cia ita nĩikerutĩra","poem":1},{"text":"mũthenya waku wa mbaara.","poem":2},{"text":"Igooka irĩ na ũgemu wa ũtheru,","poem":1},{"text":"aanake aku mahaana ta ime rĩoima nda","poem":2},{"lineBreak":true},{"text":"ya rũciinĩ ruoro rũgĩtema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Jehova nĩehĩtĩte","poem":1},{"text":"na ndangĩĩricũkwo, akoiga atĩrĩ:","poem":2},{"text":"“Wee ũrĩ mũthĩnjĩri-Ngai nginya tene,","poem":1},{"text":"o ta ũrĩa Melikisedeki aatariĩ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mwathani arĩ guoko-inĩ gwaku kwa ũrĩo;","poem":1},{"text":"nĩakahehenja athamaki mũthenya wa mangʼũrĩ make.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nĩagatuĩra ndũrĩrĩ ciira, aige ciimba irũndo,","poem":1},{"text":"na ahehenje aathani a thĩ yothe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nĩakanyua maaĩ ma karũũĩ karĩ mũkĩra-inĩ;","poem":1},{"text":"nĩ ũndũ ũcio nĩakambararia mũtwe wake.","poem":2}]}],"footnotes":[{"noteId":22,"caller":"+","text":"Itĩ cia ũnene cia tene ciakoragwo handũ hatũũgĩru harĩa haambatagwo na ngathĩ.","reference":{"chapter":110,"verse":1}}]},"thisChapterLink":"/api/kik_bib/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}