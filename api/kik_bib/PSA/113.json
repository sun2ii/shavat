{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"heading","content":["Ngai Mũteithia wa Andũ arĩa Abatari"]},{"type":"verse","number":1,"content":[{"text":"Goocai Jehova.","poem":1},{"lineBreak":true},{"text":"Mũgoocei, inyuĩ ndungata cia Jehova,","poem":1},{"text":"mũgooce rĩĩtwa rĩa Jehova.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Rĩĩtwa rĩa Jehova rĩrogoocwo,","poem":1},{"text":"kuuma rĩu nginya tene na tene.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kuuma o irathĩro rĩa riũa nginya ithũĩro rĩarĩo,","poem":1},{"text":"rĩĩtwa rĩa Jehova nĩrĩgoocagwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Jehova nĩatũũgĩrĩtio igũrũ rĩa ndũrĩrĩ ciothe,","poem":1},{"text":"riiri wake ũrĩ igũrũ rĩa igũrũ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nũũ ũhaana ta Jehova Ngai witũ,","poem":1},{"text":"o Ũcio ũikaragĩra gĩtĩ kĩa ũnene kũu igũrũ,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"o ũcio ũinamagĩrĩra arorererie","poem":1},{"text":"maũndũ ma igũrũ o na ma thĩ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Oyaga athĩĩni na igũrũ kuuma rũkũngũ-inĩ,","poem":1},{"text":"na agokĩria arĩa abatari, akamaruta kĩhumbu-inĩ kĩa mũhu;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"amaikaragia hamwe na anene,","poem":1},{"text":"o hamwe na anene a andũ ao.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Atũmaga mũtumia thaata atũũre gwake mũciĩ,","poem":1},{"text":"agatuĩka nyina wa ciana, agakenaga.","poem":2},{"lineBreak":true},{"text":"Goocai Jehova.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}