{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"heading","content":["Rwĩmbo rwa Bathaka"]},{"type":"verse","number":1,"content":[{"text":"Rĩrĩa Isiraeli moimire bũrũri wa Misiri,","poem":1},{"text":"nyũmba ya Jakubu ĩkiuma kũrĩ andũ a rũthiomi rũngĩ-rĩ,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Juda gwatuĩkire handũ ha Ngai haamũre,","poem":1},{"text":"na Isiraeli gũgĩtuĩka nĩkuo arĩathanaga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Iria rĩonire ũguo rĩkĩũra,","poem":1},{"text":"naruo Rũũĩ rwa Jorodani rũgĩcooka na thuutha;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Irĩma igĩtũhatũũha ta ndũrũme,","poem":1},{"text":"natuo tũrĩma tũgĩtũhatũũha ta tũgondu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kaĩ wonire atĩa, wee iria, nĩguo ũre,","poem":1},{"text":"nawe Jorodani, tondũ wacookire na thuutha?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inyuĩ irĩma, muonete kĩ, nĩguo mũtũhatũũhe ta ndũrũme,","poem":1},{"text":"na inyuĩ tũrĩma, nĩguo mũtũhatũũhe ta tũgondu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wee thĩ, ta kĩinaine ũrĩ mbere ya Mwathani,","poem":1},{"text":"ũrĩ hau mbere ya Ngai ũcio wa Jakubu,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"o we ũcio wagarũrire rwaro rwa ihiga rũgĩtuĩka karia ka maaĩ,","poem":1},{"text":"narĩo ihiga rĩũmũ rĩgĩtuĩka ithima cia maaĩ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}