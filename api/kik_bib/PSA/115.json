{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":115,"content":[{"type":"heading","content":["Ũnene wa Ngai, na Mĩhianano kwaga Kĩene"]},{"type":"verse","number":1,"content":[{"text":"Ti ithuĩ, Wee Jehova, ti ithuĩ twagĩrĩire kũgoocwo,","poem":1},{"text":"no goocithia rĩĩtwa rĩaku,","poem":2},{"lineBreak":true},{"text":"tondũ wa wendo na wĩhokeku waku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nĩ kĩĩ gĩtũmaga ndũrĩrĩ ciũrie atĩrĩ,","poem":1},{"text":"“Ngai wao akĩrĩ ha?”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngai witũ arĩ o igũrũ;","poem":1},{"text":"we ekaga o ũrĩa endaga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"No mĩhianano yao nĩ betha na thahabu,","poem":1},{"text":"wĩra ũthondeketwo na moko ma andũ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nĩĩrĩ tũnua, no ndĩaragia,","poem":1},{"text":"nĩĩrĩ maitho, no ndĩonaga;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"nĩĩrĩ matũ, no ndĩiguaga,","poem":1},{"text":"nĩĩrĩ na maniũrũ, no ndĩiguaga mũnungo;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"nĩĩrĩ moko, no ndĩngĩhambata kĩndũ,","poem":1},{"text":"nĩĩrĩ magũrũ, no ndĩngĩĩtwara;","poem":2},{"lineBreak":true},{"text":"o na nĩĩrĩ mĩmero, no ndĩngĩnyuria.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Andũ arĩa mamĩthondekaga makaahaana o tayo,","poem":1},{"text":"na noguo arĩa othe mamĩĩhokaga makaahaana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Wee nyũmba ya Isiraeli, wĩhokage Jehova:","poem":1},{"text":"we nĩwe ũteithio wao o na ngo yao.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wee nyũmba ya Harũni, wĩhokage Jehova:","poem":1},{"text":"we nĩwe ũteithio wao o na ngo yao.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inyuĩ arĩa mũmwĩtigĩrĩte, mwĩhokagei Jehova:","poem":1},{"text":"we nĩwe ũteithio wao na ngo yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Jehova nĩatũririkanĩte na nĩegũtũrathima:","poem":1},{"text":"Nĩekũrathima nyũmba ya Isiraeli,","poem":2},{"lineBreak":true},{"text":"nĩekũrathima nyũmba ya Harũni,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"nĩekũrathima arĩa metigĩrĩte Jehova,","poem":1},{"text":"anini na anene o ũndũ ũmwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Jehova arotũma mũingĩhe,","poem":1},{"text":"inyuĩ na ciana cianyu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mũrorathimwo nĩ Jehova,","poem":1},{"text":"Mũmbi wa igũrũ na thĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kũu igũrũ mũno nĩ kwa Jehova,","poem":1},{"text":"no thĩ nĩamĩheanĩte kũrĩ andũ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Andũ arĩa akuũ matigoocaga Jehova,","poem":1},{"text":"acio maikũrũkaga kũu ũkiri-inĩ;","poem":2}]},{"type":"verse","number":18,"content":[{"text":"nĩ ithuĩ tũrĩkumagia Jehova,","poem":1},{"text":"kuuma rĩu nginya tene na tene.","poem":2},{"lineBreak":true},{"text":"Goocai Jehova.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}