{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":116,"content":[{"type":"heading","content":["Kũgooca Ngai nĩ ũndũ wa Kũhonio Ndwari"]},{"type":"verse","number":1,"content":[{"text":"Nĩnyendete Jehova, nĩgũkorwo nĩaiguĩte mũgambo wakwa;","poem":1},{"text":"nĩaiguire ngĩmũthaitha anjiguĩre tha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tondũ nĩathikĩrĩirie-rĩ,","poem":1},{"text":"ndĩrĩmũkayagĩra rĩrĩa rĩothe ngũtũũra muoyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ndarigiicĩirio nĩ mĩhĩndo ya gĩkuũ,","poem":1},{"text":"ngĩkinyĩrĩrwo nĩ ruo rwa mbĩrĩra;","poem":2},{"lineBreak":true},{"text":"ngĩhootwo nĩ mĩtangĩko o na kĩeha.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hĩndĩ ĩyo ngĩkaĩra rĩĩtwa rĩa Jehova, ngĩmwĩra atĩrĩ:","poem":1},{"text":"“Wee Jehova, honokia!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Jehova nĩ mũtugi na nĩ mũthingu;","poem":1},{"text":"Ngai witũ aiyũrĩtwo nĩ tha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Jehova nĩagitagĩra andũ arĩa matarĩ oogĩ;","poem":1},{"text":"rĩrĩa ndahinyĩrĩirio mũno, nĩahonokirie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wee ngoro yakwa-rĩ, cookerera ũhurũko waku,","poem":1},{"text":"nĩgũkorwo Jehova nĩagwĩkĩte wega.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nĩgũkorwo Wee Jehova nĩũhonoketie muoyo wakwa kuuma kũrĩ gĩkuũ,","poem":1},{"text":"namo maitho makwa ũkamagiria maithori,","poem":2},{"lineBreak":true},{"text":"na ũkagiria magũrũ makwa mahĩngwo,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"nĩgeetha thiiage ndĩ mbere ya Jehova","poem":1},{"text":"bũrũri-inĩ wa arĩa marĩ muoyo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"No ndetĩkirie ũhoro wake; nĩ ũndũ ũcio ndoigire atĩrĩ,","poem":1},{"text":"“Nĩthĩĩnĩkĩte mũno.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nĩ ũndũ wa ũrĩa ndamakĩte, ngiuga atĩrĩ,","poem":1},{"text":"“Andũ othe nĩ a maheeni.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nĩ kĩĩ ingĩthukĩra Jehova nakĩo","poem":1},{"text":"nĩ ũndũ wa wega wake wothe ũrĩa anjĩkĩte?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nĩkuoya nguoya gĩkombe kĩa ũhonokio na igũrũ,","poem":1},{"text":"ngaĩre rĩĩtwa rĩa Jehova.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nĩngũhingĩria Jehova mĩĩhĩtwa ĩrĩa ndehĩtire,","poem":1},{"text":"andũ ake othe marĩ ho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Andũ arĩa athingu marĩ bata mũno harĩ Jehova,","poem":1},{"text":"nĩ ũndũ ũcio ndakenaga rĩrĩa makua o ro ũguo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wee Jehova, ti-itherũ niĩ ndĩ ndungata yaku;","poem":1},{"text":"niĩ ndĩ ndungata yaku, mũriũ wa ndungata yaku ya mũndũ-wa-nja;","poem":2},{"lineBreak":true},{"text":"wee nĩũnjohorithĩtie mĩnyororo-inĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Nĩngũkũrutĩra igongona rĩa gũgũcookeria ngaatho,","poem":1},{"text":"na ngaĩre rĩĩtwa rĩa Jehova.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nĩngũhingĩria Jehova mĩĩhĩtwa ĩrĩa ndehĩtire","poem":1},{"text":"andũ ake othe marĩ ho,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"kũu nja-inĩ cia nyũmba ya Jehova,","poem":1},{"text":"o thĩinĩ waku, wee Jerusalemu.","poem":2},{"lineBreak":true},{"text":"Goocai Jehova.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}