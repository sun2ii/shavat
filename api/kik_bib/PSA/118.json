atĩa angĩhota kũnjĩka?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Jehova arĩ hamwe na niĩ; nĩwe mũndeithia.","poem":1},{"text":"Nĩngerorera thũ ciakwa ikĩhootwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nĩ kaba kũũrĩra harĩ Jehova,","poem":1},{"text":"gũkĩra kwĩhoka mũndũ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nĩ kaba kũũrĩra harĩ Jehova,","poem":1},{"text":"gũkĩra kwĩhoka anene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ndarigiicĩirio nĩ ndũrĩrĩ ciothe,","poem":1},{"text":"no tondũ wa kwĩhoka rĩĩtwa rĩa Jehova, ngĩciananga.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ciandigiicĩirie mĩena yothe,","poem":1},{"text":"no tondũ wa kwĩhoka rĩĩtwa rĩa Jehova, ngĩciananga.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ciathiũrũrũkĩirie na mĩena yothe ta njũkĩ,","poem":1},{"text":"no ikĩhora narua o ta mwaki wa mĩigua;","poem":2},{"lineBreak":true},{"text":"tondũ wa kwĩhoka rĩĩtwa rĩa Jehova ngĩciananga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ndahatĩkĩtwo mũno nĩ thũ hakuhĩ ngwe,","poem":1},{"text":"no Jehova akĩndeithia.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Jehova nĩwe hinya wakwa na nĩwe ũtũmaga nyine;","poem":1},{"text":"nake nĩatuĩkĩte ũhonokio wakwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mbugĩrĩrio ya gĩkeno na ya ũhootani","poem":1},{"text":"ĩiyũrĩte hema-inĩ cia andũ arĩa athingu, atĩ:","poem":2},{"text":"“Guoko kwa ũrĩo kwa Jehova nĩ gwĩkĩte maũndũ manene!","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Guoko kwa ũrĩo kwa Jehova nĩ kwambararie;","poem":2},{"lineBreak":true},{"text":"guoko kwa ũrĩo kwa Jehova nĩ gwĩkĩte maũndũ manene!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Niĩ gũkua ndigũkua, no nĩngũtũũra muoyo,","poem":1},{"text":"ngʼanage ũrĩa Jehova ekĩte.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Jehova nĩaherithĩtie mũno,","poem":1},{"text":"no ndandekereirie ngue.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Hingũrĩrai ihingo cia ũthingu;","poem":1},{"text":"nĩngũtoonya njookerie Jehova ngaatho.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Gĩkĩ nĩkĩo kĩhingo kĩa Jehova","poem":1},{"text":"kĩrĩa andũ arĩa athingu mangĩtoonyera.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nĩ ngaatho ngũgũcookeria, nĩgũkorwo nĩwanjĩtĩkire;","poem":1},{"text":"nĩũtuĩkĩte ũhonokio wakwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ihiga rĩrĩa aaki maaregire","poem":1},{"text":"nĩrĩo rĩtuĩkĩte ihiga inene rĩa koine;","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Jehova nĩwe wĩkĩte ũndũ ũcio,","poem":1},{"text":"naguo nĩ wa magegania tũkĩwona.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mũthenya ũyũ nĩ Jehova ũtũmĩte ũgĩe;","poem":1},{"text":"nĩtũcanjamũkei, tũkĩũkenere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Wee Jehova, tũhonokie;","poem":1},{"text":"Wee Jehova, tũma tũgaacĩre.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kũrathimwo-rĩ, nĩ mũndũ ũrĩa ũgũũka na rĩĩtwa rĩa Jehova.","poem":1},{"text":"Ithuĩ nĩtwamũrathima tũrĩ thĩinĩ wa nyũmba ya Jehova.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Jehova nĩwe Mũrungu,","poem":1},{"text":"na nĩatũmĩte ũtheri wake ũtwarĩre.","poem":2},{"text":"Ambĩrĩriai gũkũngũiya, mũrĩ na mathĩgĩ moko,","poem":1},{"text":"mũthiĩ nginya hĩa-inĩ cia kĩgongona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Wee nĩwe Mũrungu wakwa, nĩngũgũcookeria ngaatho;","poem":1},{"text":"Wee nĩwe Ngai wakwa, nĩngũgũtũũgĩria.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Cookeriai Jehova ngaatho, nĩgũkorwo we nĩ mwega;","poem":1},{"text":"wendo wake nĩ wa tene na tene.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}