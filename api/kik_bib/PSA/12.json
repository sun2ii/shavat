{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"heading","content":["Ihooya rĩa kũũria Ũteithio"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Jehova, tũteithie, nĩgũkorwo andũ arĩa etigĩri Ngai nĩmaniinĩtwo;","poem":1},{"text":"andũ arĩa ehokeku nĩmathirĩte makoima gatagatĩ-inĩ ka andũ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"O mũndũ aheenagia mũndũ wa itũũra rĩake;","poem":1},{"text":"mĩromo yao ya ũhinga yaragia maheeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Jehova aroeheria mĩromo yothe ya ũhinga,","poem":1},{"text":"o na nĩmĩ ciothe iria ciaragia na mwĩgaatho,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"iria ciugaga atĩrĩ, “Tũkũhootana nĩ ũndũ wa nĩmĩ ciitũ;","poem":1},{"text":"mĩromo ĩno tũrĩ nayo nĩ iitũ; mwathi witũ akĩrĩ ũ?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Tondũ wa kũhinyĩrĩrio kwa andũ arĩa matarĩ hinya,","poem":1},{"text":"na gũcaaya kwa arĩa abatari-rĩ,","poem":2},{"text":"rĩu nĩngwarahũka,” ũguo nĩguo Jehova ekuuga.","poem":1},{"text":"“Nĩngũmagitĩra kuuma kũrĩ andũ arĩa mamacambagia.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nacio ciugo cia Jehova itirĩ mahĩtia,","poem":1},{"text":"ihaana ta betha ĩthereirio kĩrugutĩro-inĩ kĩa rĩũmba,","poem":2},{"lineBreak":true},{"text":"ĩtheretio maita mũgwanja.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wee Jehova nĩũrĩtũmenyagĩrĩra wega,","poem":1},{"text":"na ũtũgitagĩre kuuma kũrĩ andũ ta acio nginya tene.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Andũ arĩa aaganu macangacangaga marĩ na mwĩtĩĩo,","poem":1},{"text":"rĩrĩa ũndũ ũrĩa mũũru ũragathĩrĩrio nĩ andũ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}