{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"heading","content":["Ihooya rĩa kũũria Ũteithio"]},{"type":"hebrew_subtitle","content":["Thaburi ya Agendi"]},{"type":"verse","number":1,"content":[{"text":"Ndakaĩire Jehova ndĩ mĩnyamaro-inĩ,","poem":1},{"text":"nake akĩnjĩtĩka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wee Jehova, honokia harĩ mĩromo ĩrĩa yaragia maheeni,","poem":1},{"text":"na harĩ nĩmĩ iria iheenanagia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Agaagwĩka atĩa, na nĩ atĩa ũngĩ makĩria ya ũguo,","poem":1},{"text":"wee rũrĩmĩ rũrũ rũheenanagia?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Agaakũherithia na mĩguĩ mĩnoore ya njamba ya ita,","poem":1},{"text":"na makara marĩrĩmbũkĩte mwaki ma mũtĩ wa mũkoigo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kaĩ ndĩ na haaro-ĩ, nĩgũtũũra gũkũ Mesheki,","poem":1},{"text":"na ngaikara hema-inĩ cia Kedari-ĩ!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nĩndũũrĩte hĩndĩ ndaaya","poem":1},{"text":"gatagatĩ-inĩ ka arĩa mathũire thayũ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Niĩ ndĩ mũndũ wa thayũ;","poem":1},{"text":"no rĩrĩa ndaaria-rĩ, o mendaga o mbaara.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}