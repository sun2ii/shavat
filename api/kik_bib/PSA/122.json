{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"heading","content":["Rwĩmbo rwa Kũgaathĩrĩria Jerusalemu"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Nĩndakenire hamwe na arĩa maanjĩĩrire atĩrĩ,","poem":1},{"text":"“Nĩtũthiĩ nyũmba ya Jehova.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Magũrũ maitũ marũgamĩte","poem":1},{"text":"ihingo-inĩ ciaku, wee Jerusalemu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Jerusalemu rĩakĩtwo ta itũũra inene","poem":1},{"text":"rĩnyitithanĩtio wega.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kũu nĩkuo mĩhĩrĩga yambataga,","poem":1},{"text":"o yo mĩhĩrĩga ya Jehova,","poem":2},{"text":"ĩgathiĩ kũgooca rĩĩtwa rĩa Jehova","poem":1},{"text":"kũringana na mawatho marĩa aheete Isiraeli.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kũu nĩkuo kũigĩtwo itĩ cia ũnene cia atuanĩri ciira,","poem":1},{"text":"o cio itĩ cia ũnene cia nyũmba ya Daudi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Hoerai Jerusalemu thayũ:","poem":1},{"text":"“Arĩa makwendete marotũũra na thayũ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kũrĩa thingo ciaku ciirigĩire kũrogĩa na thayũ,","poem":1},{"text":"naguo ũgitĩri ũgĩe ciikaro-inĩ ciaku cia ũthamaki.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nĩ ũndũ wa ariũ a baba na arata, nguuga atĩrĩ,","poem":1},{"text":"“Thayũ ũrogĩa thĩinĩ waku.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nĩ ũndũ wa nyũmba ya Jehova Ngai witũ,","poem":1},{"text":"caragia ũgaacĩru waku.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}