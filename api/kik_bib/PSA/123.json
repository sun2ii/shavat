{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":123,"content":[{"type":"heading","content":["Ihooya rĩa kũũria Tha cia Ngai"]},{"type":"hebrew_subtitle","content":["Thaburi ya Agendi"]},{"type":"verse","number":1,"content":[{"text":"Nĩngũtiira maitho makwa na kũrĩ we,","poem":1},{"text":"o Wee ũikarĩire gĩtĩ gĩaku kĩa ũnene kũu igũrũ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"O ta ũrĩa maitho ma ndungata maroragĩrĩria guoko kwa mwathi wayo,","poem":1},{"text":"na o ta ũrĩa maitho ma mũirĩtu ndungata maroragĩrĩria guoko kwa mũtumia mwathi wayo,","poem":2},{"noteId":24},{"text":"ũguo noguo maitho maitũ maroragĩrĩria Jehova Ngai witũ,","poem":1},{"text":"o nginya atũiguĩre tha ciake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tũiguĩre tha, Wee Jehova, tũiguĩre tha,","poem":1},{"text":"nĩgũkorwo nĩtũkirĩrĩirie kũnyararwo kũnene.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nĩtũkirĩrĩirie kĩnyũrũri kĩnene kĩa andũ arĩa menenehagia,","poem":1},{"text":"o na rũmena rũingĩ rwa andũ arĩa etĩĩi.","poem":2}]}],"footnotes":[{"noteId":24,"caller":"+","text":"Aathi a ngombo maaciaragĩria na maitho kana na moko.","reference":{"chapter":123,"verse":2}}]},"thisChapterLink":"/api/kik_bib/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}