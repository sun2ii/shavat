{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":125,"content":[{"type":"heading","content":["Thayũ wa Andũ a Ngai"]},{"type":"verse","number":1,"content":[{"text":"Andũ arĩa mehokete Jehova matariĩ ta Kĩrĩma gĩa Zayuni,","poem":1},{"text":"kĩrĩa gĩtangĩenyenyeka, no gĩtũũraga nginya tene.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"O ta ũrĩa irĩma ithiũrũrũkĩirie Jerusalemu","poem":1},{"text":"ũguo noguo Jehova athiũrũrũkagĩria andũ ake,","poem":2},{"lineBreak":true},{"text":"kuuma rĩu nginya tene na tene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mũthĩgi wa andũ arĩa aaganu ndũgũtũũra wathanaga","poem":1},{"text":"bũrũri ũrĩa ũgaĩirwo andũ arĩa athingu,","poem":2},{"text":"nĩguo andũ acio athingu","poem":1},{"text":"matikae gũtambũrũkia moko mao meeke ũũru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wee Jehova, andũ arĩa ega mekaga o maũndũ mega,","poem":1},{"text":"o acio arũngĩrĩru ngoro.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"No rĩrĩ, andũ arĩa maahũkaga makagera njĩra iria njogomu-rĩ,","poem":1},{"text":"Jehova nĩakamaingatanĩria hamwe na arĩa mekaga ũũru.","poem":2},{"lineBreak":true},{"text":"Isiraeli kũrogĩa thayũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}