{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"heading","content":["Magetha ma Gĩkeno"]},{"type":"hebrew_subtitle","content":["Thaburi ya Agendi"]},{"type":"verse","number":1,"content":[{"text":"Rĩrĩa Jehova aacookirie andũ a Zayuni arĩa maatahĩtwo akĩmainũkia-rĩ,","poem":1},{"text":"twahaanire ta andũ mekũroota.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tũnua twitũ twaiyũrire mĩtheko,","poem":1},{"text":"nacio nĩmĩ ciitũ ikĩina nyĩmbo cia gĩkeno.","poem":2},{"text":"Hĩndĩ ĩyo ndũrĩrĩ-inĩ gũkĩĩranwo atĩrĩ,","poem":1},{"text":"“Jehova nĩekĩire andũ aya maũndũ manene.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jehova nĩatwĩkĩire maũndũ manene,","poem":1},{"text":"na ithuĩ tũkaiyũrwo nĩ gĩkeno.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tũma tũgaacĩre rĩngĩ, Wee Jehova,","poem":1},{"text":"ta ũrĩa njũũĩ cia Negevu icookaga kũiyũra.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Andũ arĩa mahaandaga na maithori,","poem":1},{"text":"nĩmakagetha makĩinaga nyĩmbo cia gĩkeno.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mũndũ o na angiumagara akĩrĩraga,","poem":1},{"text":"akuuĩte mbeũ cia kũhaanda,","poem":2},{"text":"agaacooka akĩinaga nyĩmbo cia gĩkeno,","poem":1},{"text":"akuuĩte itĩĩa ciake cia ngano.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}