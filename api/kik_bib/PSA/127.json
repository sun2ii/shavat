{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"heading","content":["Kũgaatha Ngai nĩ ũndũ wa Wega Wake"]},{"type":"verse","number":1,"content":[{"text":"Tiga nyũmba yakirwo nĩ Jehova,","poem":1},{"text":"andũ arĩa mamĩakaga marutaga wĩra o wa tũhũ.","poem":2},{"text":"Tiga itũũra inene rĩmenyereirwo nĩ Jehova,","poem":1},{"text":"arangĩri maraaraga mehũũgĩte o tũhũ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nĩ tũhũ andũ kũrooka gũũkĩra rũciinĩ tene,","poem":1},{"text":"na gũkoma magakoma macereirwo,","poem":2},{"text":"makĩnogera irio cia kũrĩa,","poem":1},{"text":"nĩgũkorwo andũ arĩa Jehova endete,","poem":2},{"text":"we nĩamaheaga o na marĩ toro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ciana nĩ igai kuuma kũrĩ Jehova,","poem":1},{"text":"ciana nĩ kĩheo kuuma kũrĩ we.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ciana iria mũndũ aciarĩte arĩ mũnini","poem":1},{"text":"no ta mĩguĩ ĩrĩ moko-inĩ ma njamba ya ita.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kũrathimwo nĩ mũndũ","poem":1},{"text":"ũrĩa thiaka wake ũiyũrĩte mĩguĩ.","poem":2},{"text":"Matigaaconorithio","poem":1},{"text":"rĩrĩa magaakorwo magĩciira na thũ ciao hau kĩhingo-inĩ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}