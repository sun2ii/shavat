{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":128,"content":[{"type":"heading","content":["Kĩrathimo kĩa Mũciĩ Wĩtigĩrĩte Jehova"]},{"type":"hebrew_subtitle","content":["Thaburi ya Agendi"]},{"type":"verse","number":1,"content":[{"text":"Kũrathimwo nĩ mũndũ o wothe wĩtigĩrĩte Jehova,","poem":1},{"text":"o ũcio ũgeragĩra njĩra ciake.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nĩũkarĩĩaga maciaro ma wĩra waku;","poem":1},{"text":"irathimo na kũgaacĩra nĩigatuĩka ciaku.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mũtumia waku egũtuĩka ta mũthabibũ ũrĩa ũciaraga mũno","poem":1},{"text":"arĩ kũu nyũmba-inĩ yaku thĩinĩ;","poem":2},{"text":"ciana ciaku ituĩke ta thuuna cia mũtamaiyũ","poem":1},{"text":"ithiũrũrũkĩirie metha yaku.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ũguo nĩguo mũndũ arĩrathimagwo,","poem":1},{"text":"ũrĩa wĩtigĩrĩte Jehova.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Jehova arokũrathimaga arĩ Zayuni","poem":1},{"text":"matukũ mothe ma muoyo waku;","poem":2},{"text":"ũroona kũgaacĩra kwa Jerusalemu,","poem":1}]},{"type":"verse","number":6,"content":[{"text":"na ũtũũre muoyo, ũkoona ciana cia ciana ciaku.","poem":2},{"lineBreak":true},{"text":"Thayũ ũrogĩa Isiraeli.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}