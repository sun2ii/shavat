{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"heading","content":["Ihooya rĩa kũũria Ngai okĩrĩre Thũ cia Isiraeli"]},{"type":"hebrew_subtitle","content":["Thaburi ya Agendi"]},{"type":"verse","number":1,"content":[{"text":"Maanahinyĩrĩria mũno kuuma ũnini-inĩ wakwa,","poem":1},{"text":"Isiraeli nĩmakiuge ũguo,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"maanahinyĩrĩria mũno kuuma ũnini-inĩ wakwa,","poem":1},{"text":"no rĩrĩ, matirĩ maahota kũndooria.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Andũ arĩa marĩmaga na mũraũ marĩmĩte ngʼongʼo wakwa,","poem":1},{"text":"magatema mĩtaro mĩraihu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"No rĩrĩ, Jehova nĩ mũthingu;","poem":1},{"text":"nĩanjohorithĩtie harĩ mĩhĩndo ya andũ arĩa aaganu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Andũ arĩa othe mathũire Zayuni","poem":1},{"text":"marocookio na thuutha maconokete.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Marohaana ta nyeki ĩrĩ nyũmba igũrũ,","poem":1},{"text":"ĩrĩa ĩhoohaga ĩtanamera;","poem":2},{"noteId":25}]},{"type":"verse","number":7,"content":[{"text":"mũmĩtui ndangĩmĩiyũria hĩ-inĩ ciake,","poem":1},{"text":"o na kana ũrĩa ũmĩũnganagia amĩiyũrie moko-inĩ make.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Andũ arĩa mahĩtũkagĩra kuo maroaga kuuga atĩrĩ,","poem":1},{"text":"“Kĩrathimo kĩa Jehova kĩrogĩa igũrũ rĩanyu;","poem":2},{"text":"nĩtwamũrathima thĩinĩ wa rĩĩtwa rĩa Jehova.”","poem":1}]}],"footnotes":[{"noteId":25,"caller":"+","text":"Riya nĩrĩameraga nyũmba igũrũ no rĩkooma o na ihenya nĩ ũndũ wa kwaga tĩĩri.","reference":{"chapter":129,"verse":6}}]},"thisChapterLink":"/api/kik_bib/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}