{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"heading","content":["Gweterera Ũhonokio wa Ngai"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Nĩ nginya rĩ, Wee Jehova?","poem":1},{"text":"Ũgũtũũra ũriganĩirwo nĩ niĩ nginya tene?","poem":2},{"lineBreak":true},{"text":"Nĩ nginya rĩ ũgũtũũra ũũhithĩte ũthiũ waku?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nĩ nginya rĩ ngũtũũra ngianaga na meciiria makwa,","poem":1},{"text":"na o mũthenya ngoragwo na ihooru ngoro-inĩ yakwa?","poem":2},{"lineBreak":true},{"text":"Nĩ nginya rĩ thũ yakwa ĩgũtũũra ĩĩhootaga?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Wee Jehova, Ngai wakwa, ndora na ũnjookerie ũhoro.","poem":1},{"text":"Tũma maitho makwa mone, nĩguo ndikae gũkoma toro wa gĩkuũ;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"nĩguo thũ yakwa ndĩkoige atĩrĩ, “Nĩndĩmũhootete,”","poem":1},{"text":"nao arĩa marĩ muku na niĩ magĩkenere kũgũa gwakwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"No niĩ ndĩhokete wendo waku ũrĩa ũtathiraga;","poem":1},{"text":"ngoro yakwa ĩkenagĩra ũhonokio waku.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nĩngũinĩra Jehova,","poem":1},{"text":"nĩgũkorwo nĩanjĩkĩte wega mũno.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}