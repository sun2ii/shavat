{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"heading","content":["Ihooya rĩa kũũria Ũteithio"]},{"type":"hebrew_subtitle","content":["Thaburi ya Agendi"]},{"type":"verse","number":1,"content":[{"text":"Wee Jehova-rĩ, ndĩragũkaĩra ndĩ o kũrĩa kũriku;","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Wee Jehova, igua mũgambo wakwa.","poem":2},{"text":"Matũ maku nĩmaigue","poem":1},{"text":"ngĩgũkaĩra ũnjiguĩre tha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Wee Jehova, korwo no ũtare maita marĩa tũkwĩhagĩria-rĩ,","poem":1},{"text":"nũũ ũngĩgwĩtiiria, Wee Jehova?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"No rĩrĩ, Wee nĩũrekanagĩra;","poem":1},{"text":"nĩ ũndũ ũcio nĩwĩtigĩrĩtwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Njetagĩrĩra Jehova, ngoro yakwa nĩĩmwetereire,","poem":1},{"text":"niĩ ndĩĩhokaga kiugo gĩake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngoro yakwa yetagĩrĩra Jehova,","poem":1},{"text":"gũkĩra ũrĩa arangĩri metagĩrĩra rũciinĩ gũkĩe,","poem":2},{"lineBreak":true},{"text":"ĩĩ-ni, gũkĩra ũrĩa arangĩri metagĩrĩra rũciinĩ gũkĩe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wee Isiraeli, wĩhokage Jehova,","poem":1},{"text":"nĩgũkorwo harĩ Jehova he wendo ũrĩa ũtathiraga,","poem":2},{"lineBreak":true},{"text":"na ningĩ harĩ we harĩ na ũhonokio kũna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"We mwene nĩagakũũra Isiraeli","poem":1},{"text":"kuuma mehia-inĩ mao mothe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}