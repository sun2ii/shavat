{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":132,"content":[{"type":"heading","content":["Gĩikaro kĩa Ngai gĩa Tene na Tene kũu Zayuni"]},{"type":"hebrew_subtitle","content":["Thaburi ya Agendi"]},{"type":"verse","number":1,"content":[{"text":"Wee Jehova, ririkana Daudi","poem":1},{"text":"na mathĩĩna marĩa mothe omĩrĩirie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nĩehĩtire mwĩhĩtwa harĩ Jehova,","poem":1},{"text":"akĩĩhĩta harĩ ũcio Mwene-Hinya,","poem":2},{"lineBreak":true},{"text":"o we Ngai wa Jakubu, akiuga ũũ:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Ndigatoonya nyũmba yakwa,","poem":1},{"text":"kana haice ũrĩrĩ wakwa,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ndikaareke maitho makwa mone toro,","poem":1},{"text":"kana ndeke imone ciakwa icũnge,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"o nginya ngoonera Jehova handũ ha gũikara,","poem":1},{"text":"ũcio Mwene-Hinya, o we Ngai wa Jakubu,","poem":2},{"lineBreak":true},{"text":"ndĩmuonere gĩikaro.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nĩtwaiguire ũhoro tũrĩ Efiratha,","poem":1},{"text":"na tũkĩũkora mĩgũnda-inĩ ya Kiriathu Jearimu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tũkiuga atĩrĩ, “Nĩtũthiĩi gĩikaro-inĩ gĩake;","poem":1},{"text":"nĩtũinamĩrĩre tũmũhooe tũrĩ gaturwa-inĩ ka makinya make;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"arahũka, Wee Jehova, ũũke kĩhurũko-inĩ gĩaku,","poem":1},{"text":"wee na ithandũkũ rĩa kĩrĩkanĩro rĩa hinya waku.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Athĩnjĩri aku marohumbwo na ũthingu;","poem":1},{"text":"andũ aku aamũre nĩmakĩine nĩ gũkena.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nĩ ũndũ wa ndungata yaku Daudi,","poem":1},{"text":"ndũkarega ũrĩa we ũitĩrĩirie maguta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Jehova nĩehĩtire na mwĩhĩtwa harĩ Daudi,","poem":1},{"text":"mwĩhĩtwa atangĩĩricũkwo, akĩmwĩra atĩrĩ:","poem":2},{"text":"“Nĩngaikarĩria ũmwe wa rũciaro rwaku","poem":1},{"text":"Gĩtĩ-inĩ gĩaku kĩa ũnene,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ariũ aku mangĩkaamenyerera kĩrĩkanĩro gĩakwa","poem":1},{"text":"na mawatho makwa marĩa ndĩrĩmarutaga,","poem":2},{"text":"hĩndĩ ĩyo ariũ ao nĩmagaikarĩra","poem":1},{"text":"gĩtĩ gĩaku kĩa ũnene nginya tene na tene.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nĩgũkorwo Jehova nĩathuurĩte Zayuni,","poem":1},{"text":"akerirĩria gũtuĩke gĩikaro gĩake, akoiga atĩrĩ:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“Gĩkĩ nĩkĩo kĩhurũko gĩakwa nginya tene na tene;","poem":1},{"text":"gũkũ nĩkuo ngũtũũra njikarĩire gĩtĩ kĩa ũnene,","poem":2},{"lineBreak":true},{"text":"nĩgũkorwo nĩ niĩ ndĩyendeire;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"nĩngakũrathima na ũmaathi mũingĩ mũno;","poem":1},{"text":"athĩĩni akuo ndĩmahũũnie na irio.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nĩngahumba athĩnjĩri-Ngai akuo ũhonokio,","poem":1},{"text":"na andũ akuo arĩa aamũre matũũre mainaga nĩ gũkena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Kũu nĩkuo ngaatũma rũhĩa rwa Daudi rũthundũke","poem":1},{"text":"na njigĩre ũrĩa njitĩrĩirie maguta tawa ũgwakana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Thũ ciake nĩngacihumba thoni,","poem":1},{"text":"no thũmbĩ ya ũnene ĩrĩa ĩrĩ mũtwe wake nĩĩgakenga na riiri.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}