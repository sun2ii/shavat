{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"heading","content":["Gũcakaya kwa Isiraeli rĩrĩa Maatahĩtwo"]},{"type":"verse","number":1,"content":[{"text":"Ngurumo-inĩ cia njũũĩ cia Babuloni nĩkuo twaikaraga thĩ tũkarĩra,","poem":1},{"text":"twaririkana Zayuni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kũu mĩtĩ-inĩ ya mĩethia nĩkuo","poem":1},{"text":"twacuuragia inanda ciitũ cia mũgeeto,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"nĩgũkorwo tũrĩ kũu andũ arĩa maatũtahĩte nĩmatwĩraga tũmainĩre nyĩmbo,","poem":1},{"text":"o acio atũnyariiri magatwĩra tũmainĩre nyĩmbo tũkenete,","poem":2},{"lineBreak":true},{"text":"magatwĩra atĩrĩ, “Tũinĩrei rwĩmbo rũmwe rwa iria mwainaga mũrĩ Zayuni!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tũngĩhota atĩa kũina nyĩmbo cia Jehova","poem":1},{"text":"tũrĩ bũrũri wa ũgeni?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ingĩkariganĩrwo nĩwe, Wee Jerusalemu-rĩ,","poem":1},{"text":"guoko gwakwa kwa ũrĩo kũrokĩriganĩrwo nĩ ũũgĩ wakuo wa gwĩka maũndũ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Rũrĩmĩ rwakwa rũronyiitana na karakara","poem":1},{"text":"ingĩkaaga gũkũririkana,","poem":2},{"text":"ingĩkaaga gũtua Jerusalemu","poem":1},{"text":"gĩkeno gĩakwa kĩrĩa kĩnene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wee Jehova, ririkana ũrĩa andũ a Edomu","poem":1},{"noteId":26},{"text":"meekire,","poem":1},{"text":"mũthenya ũrĩa itũũra rĩa Jerusalemu rĩanyiitirwo.","poem":2},{"text":"Maanĩrĩire, makiuga atĩrĩ, “Rĩmomorei,","poem":1},{"text":"rĩmomorei o nginya mũthingi-inĩ warĩo!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Wee mwarĩ wa Babuloni, o wee ũtuĩrĩirwo kũniinwo,","poem":1},{"text":"gũkena nĩ mũndũ ũrĩa ũgũgwĩka","poem":2},{"lineBreak":true},{"text":"o ta ũguo ũtwĩkĩte:","poem":2}]},{"type":"verse","number":9,"content":[{"text":"gũkena nĩ mũndũ ũrĩa ũhuragia tũkenge twaku,","poem":1},{"text":"agatũgũthithia ndwaro-inĩ cia mahiga.","poem":2},{"noteId":27}]}],"footnotes":[{"noteId":26,"caller":"+","text":"Andũ a Edomu maarĩ a rũciaro rwa Esaũ.","reference":{"chapter":137,"verse":7}},{"noteId":27,"caller":"+","text":"Nĩguo njiaro cia andũ arĩa maatoorio mbaara-inĩ ithire-rĩ, tũkenge twaringithagio mĩtwe mahiga-inĩ tũgakua.","reference":{"chapter":137,"verse":9}}]},"thisChapterLink":"/api/kik_bib/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}