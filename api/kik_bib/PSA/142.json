{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"heading","content":["Ihooya rĩa kũũria Gũkũũrwo kuuma Mĩnyamaro-inĩ"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Ngayagĩra Jehova nyanĩrĩire;","poem":1},{"text":"ngwambararia mũgambo wakwa kũrĩ Jehova anjiguĩre tha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Njitũrũraga mateta makwa mbere yake;","poem":1},{"text":"ndĩrĩmwĩraga thĩĩna wakwa ndĩ mbere yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Rĩrĩa roho wakwa waringĩka thĩinĩ wakwa,","poem":1},{"text":"Wee nĩwe ũmenyaga njĩra ĩrĩa ndĩrĩgera.","poem":2},{"text":"Njĩra-inĩ ĩrĩa thiiagĩra-rĩ,","poem":1},{"text":"andũ nĩmahithĩire mũtego.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ta rora mwena wakwa wa ũrĩo wone;","poem":1},{"text":"gũtirĩ o na ũmwe ũranũmbũiya.","poem":2},{"text":"Ndirĩ na ha kũũrĩra;","poem":1},{"text":"muoyo wakwa gũtirĩ mũndũ o na ũmwe ũngĩũmenyerera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wee Jehova, nĩwe ngayagĩra;","poem":1},{"text":"njugaga atĩrĩ, “Wee nĩwe rĩũrĩro rĩakwa,","poem":2},{"lineBreak":true},{"text":"na igai rĩakwa bũrũri-inĩ wa arĩa marĩ muoyo.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Thikĩrĩria gũkaya gwakwa,","poem":1},{"text":"nĩgũkorwo ndĩĩmũhinyĩrĩrie mũno;","poem":2},{"text":"ndeithũra kuuma kũrĩ andũ arĩa mathingatanĩte na niĩ,","poem":1},{"text":"nĩgũkorwo marĩ na hinya mũno kũngĩra.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Njohorithia kuuma kĩoho-inĩ gĩakwa,","poem":1},{"text":"nĩguo ngoocage rĩĩtwa rĩaku.","poem":2},{"lineBreak":true},{"text":"Hĩndĩ ĩyo andũ arĩa athingu nĩmakandigiicĩria,","poem":1},{"text":"nĩ ũndũ wa ũrĩa ũnjĩkĩte wega.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}