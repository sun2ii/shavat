{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":143,"content":[{"type":"heading","content":["Ihooya rĩa kũũria Kũhonokio"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Igua ihooya rĩakwa, Wee Jehova,","poem":1},{"text":"thikĩrĩria kĩrĩro gĩakwa ũnjiguĩre tha;","poem":2},{"text":"ũka ũndeithie,","poem":1},{"text":"nĩ ũndũ wa wĩhokeku waku na ũthingu waku.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndũgaciirithie ndungata yaku,","poem":1},{"text":"nĩgũkorwo maitho-inĩ maku gũtirĩ mũndũ ũrĩ muoyo ũngĩtuuo mũthingu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Thũ nĩĩthingatĩte,","poem":1},{"text":"ĩkangurumania thĩ tĩĩri-inĩ;","poem":2},{"text":"ĩtũmaga ndũũre nduma-inĩ","poem":1},{"text":"ta arĩa maakuire tene.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nĩ ũndũ ũcio roho wakwa ũkaringĩka thĩinĩ wakwa;","poem":1},{"text":"ngoro yakwa nĩĩmakĩte mũno thĩinĩ wakwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nĩndĩrĩririkanaga matukũ marĩa ma tene;","poem":1},{"text":"ndĩrĩcũũranagia mawĩko maku mothe","poem":2},{"lineBreak":true},{"text":"na ngatarania maũndũ marĩa moko maku meekĩte.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndambũrũkĩtie moko makwa na kũrĩ we;","poem":1},{"text":"muoyo wakwa ũkũnyootagĩra ta bũrũri ũrĩa mũũmũ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wee Jehova, hiũha kũnjĩtĩka;","poem":1},{"text":"roho wakwa nĩũthirĩtwo nĩ hinya.","poem":2},{"text":"Tiga kũũhitha ũthiũ waku,","poem":1},{"text":"ndikahaane ta arĩa matoonyaga irima.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"O rũciinĩ reke njiguage kiugo kĩa wendo waku ũrĩa ũtathiraga,","poem":1},{"text":"nĩgũkorwo nĩwe ndĩĩhokete.","poem":2},{"text":"Nyonia njĩra ĩrĩa njagĩrĩirwo nĩkũgera,","poem":1},{"text":"nĩgũkorwo muoyo wakwa ndĩwerekeirie igũrũ kũrĩ we.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndeithũra kuuma kũrĩ thũ ciakwa, Wee Jehova,","poem":1},{"text":"nĩgũkorwo ndĩĩhithaga harĩwe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nduta gwĩkaga wendi waku,","poem":1},{"text":"nĩgũkorwo Wee nĩwe Ngai wakwa;","poem":2},{"text":"Roho waku mwega arondongoragia,","poem":1},{"text":"ngeragĩre kũrĩa kwaraganu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Wee Jehova, nĩ ũndũ wa rĩĩtwa rĩaku, tũũria muoyo wakwa;","poem":1},{"text":"nĩ ũndũ wa ũthingu waku-rĩ, nduta kuuma mĩnyamaro-inĩ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nĩ ũndũ wa wendo waku ũtathiraga, kiria thũ ciakwa;","poem":1},{"text":"niina arĩa othe maathũire,","poem":2},{"lineBreak":true},{"text":"nĩgũkorwo niĩ ndĩ ndungata yaku.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}