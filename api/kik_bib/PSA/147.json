{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":147,"content":[{"type":"heading","content":["Kũgooca Ngai nĩ ũndũ wa Kũmenyerera Jerusalemu"]},{"type":"verse","number":1,"content":[{"text":"Goocai Jehova.","poem":1},{"lineBreak":true},{"text":"Kaĩ nĩ ũndũ mwega kũgooca Ngai witũ na rwĩmbo-ĩ,","poem":1},{"text":"kaĩ nĩ ũndũ mwega na mwagĩrĩru kũmũgooca-ĩ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Jehova nĩwe wakaga Jerusalemu;","poem":1},{"lineBreak":true},{"text":"nĩwe ũcookagĩrĩria andũ a Isiraeli arĩa matahĩtwo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nĩwe ũhonagia arĩa athuthĩku ngoro,","poem":1},{"text":"na akamooha ironda ciao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nĩwe ũmenyaga mũigana wa njata,","poem":1},{"text":"na akahe njata o njata rĩĩtwa rĩayo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mwathani witũ nĩwe mũnene na nĩ arĩ hinya mũingĩ;","poem":1},{"text":"ũmenyo wake ndũrĩ mũthia.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Jehova nĩwe ũtiiragĩrĩra andũ arĩa ahooreri,","poem":1},{"text":"no arĩa aaganu amatungumanagia thĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Inĩrai Jehova mũmũcookerie ngaatho;","poem":1},{"text":"inĩrai Ngai witũ na kĩnanda kĩa mũgeeto.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nĩahumbagĩra igũrũ na matu;","poem":1},{"text":"nĩwe uuragĩria thĩ mbura,","poem":2},{"lineBreak":true},{"text":"na agatũma nyeki ĩmere tũrĩma-inĩ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nĩwe ũheaga ngʼombe irio,","poem":1},{"text":"na akahe tũcui twa mahuru irio rĩrĩa twamũkaĩra.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"We ndakenagĩra hinya wa mbarathi,","poem":1},{"text":"o na kana agakenera magũrũ ma mũndũ;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jehova akenagio nĩ andũ arĩa mamwĩtigagĩra,","poem":1},{"text":"o arĩa maigaga mwĩhoko wao harĩ wendo wake ũrĩa ũtathiraga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Wee Jerusalemu, kumia Jehova;","poem":1},{"text":"gooca Ngai waku, wee Zayuni,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"nĩgũkorwo nĩwe wĩkagĩra mĩgĩĩko ya ihingo ciaku hinya,","poem":1},{"text":"na akarathima andũ aku arĩa marĩ thĩinĩ waku.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nĩatũmĩte kũgĩe thayũ mĩhaka-inĩ yaku,","poem":1},{"text":"na agakũhũũnia na ngano ĩrĩa njega mũno.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Atũmaga wathani wake ũkinye gũkũ thĩ;","poem":1},{"text":"kiugo gĩake kĩhanyũkaga narua mũno.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Oiragia tharunji ĩhaana ta guoya mwerũ cua,","poem":1},{"text":"nayo mbaa akamĩhurunja ta mũhu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mbura ya mbembe amiuragia taarĩ kagoto karoira.","poem":1},{"text":"Nũũ ũngĩhota gwĩtiiria heho ĩyo yake?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Atũmaga kiugo gĩake agatũma itwekũke;","poem":1},{"text":"ahurutithanagia rũhuho, namo maaĩ magatherera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Nĩaguũrĩtie kiugo gĩake harĩ Jakubu,","poem":1},{"text":"akaguũrĩria Isiraeli mawatho make","poem":2},{"lineBreak":true},{"text":"na kĩrĩra kĩa watho wake wa kũrũmĩrĩrwo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ndarĩ ekĩra rũrĩrĩ rũngĩ ta ũguo,","poem":1},{"text":"mawatho macio make ndũrĩrĩ itirĩ ciamamenya.","poem":2},{"lineBreak":true},{"text":"Goocai Jehova.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}