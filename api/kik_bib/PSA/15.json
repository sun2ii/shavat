{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":15,"content":[{"type":"heading","content":["Maũndũ marĩa Jehova Endaga"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Jehova, nũũ ũngĩtũũra hema-inĩ yaku?","poem":1},{"text":"Nũũ ũngĩtũũra kĩrĩma-inĩ gĩaku kĩrĩa kĩamũre?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nĩ mũndũ ũrĩa mĩthiĩre yake ĩtarĩ ũcuuke,","poem":1},{"text":"na ũrĩa wĩkaga maũndũ ma ũthingu,","poem":2},{"text":"na kwaria aragia ũhoro wa ma kuuma ngoro-inĩ yake,","poem":1}]},{"type":"verse","number":3,"content":[{"text":"na ndarĩ njambanio rũrĩmĩ-inĩ rwake,","poem":2},{"text":"na ndeekaga mũndũ wa itũũra rĩake ũũru,","poem":1},{"text":"o na kana akamenereria mũndũ ũrĩa ũngĩ;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"mũndũ ũcio nĩathũire mũndũ ũrĩa wĩkaga maũndũ mooru,","poem":1},{"text":"no nĩatĩĩte arĩa etigĩri Jehova,","poem":2},{"text":"na ndagaga kũhingia mwĩhĩtwa wake,","poem":1},{"text":"o na ũngĩkorwo ũrĩ wa kũmũtuuria,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ndakombanagĩra mbeeca ciake nĩguo one uumithio,","poem":1},{"text":"na ndangĩoya ihaki nĩguo ahatĩrĩrie mũndũ ũteehĩtie.","poem":2},{"lineBreak":true},{"text":"Mũndũ ũrĩa wĩkaga maũndũ ta macio","poem":1},{"text":"ndarĩ hĩndĩ akeenyenyeka.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}