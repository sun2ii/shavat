_break"},{"type":"verse","number":6,"content":[{"text":"Kĩndũ gĩothe kĩrĩ mĩhũmũ nĩkĩgooce Jehova.","poem":1},{"lineBreak":true},{"text":"Goocai Jehova.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}