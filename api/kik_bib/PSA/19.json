{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":19,"content":[{"type":"heading","content":["Ũũmbi wa Ngai Wonanagia Riiri Wake"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Igũrũ riumbũraga riiri wa Mũrungu;","poem":1},{"text":"namo matu mamemerekagia wĩra wa moko make.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mũthenya ũkinyagĩria mũthenya ũrĩa ũngĩ ũhoro;","poem":1},{"text":"naguo ũtukũ ũkamenyithia ũtukũ ũrĩa ũngĩ ũhoro wa riiri ũcio.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gũtirĩ mĩario kana rũthiomi","poem":1},{"text":"kũrĩa mũgambo wacio ũtaiguĩkaga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mũgambo wacio ũthiiaga thĩ yothe,","poem":1},{"text":"nacio ciugo ciacio igakinya ituri cia thĩ.","poem":2},{"lineBreak":true},{"text":"Ngai nĩambĩire riũa hema kũu igũrũ,","poem":1}]},{"type":"verse","number":5,"content":[{"text":"narĩo riumaga rĩhaana ta mũhikania akiuma nyũmba yake,","poem":2},{"lineBreak":true},{"text":"o na kana ta mũtengʼeri njoorua akĩhĩĩahĩĩa gũtengʼera.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Rĩrathagĩra mwena-inĩ ũmwe wa kũu igũrũ,","poem":1},{"text":"na rĩgathiũrũrũka nginya mwena ũrĩa ũngĩ;","poem":2},{"lineBreak":true},{"text":"gũtirĩ kĩndũ gĩtakinyagĩrwo nĩ ũrugarĩ warĩo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Watho wa Jehova nĩ mũkinyanĩru,","poem":1},{"text":"ũriũkagia ngoro ya mũndũ.","poem":2},{"text":"Kĩrĩra kĩa Jehova nĩ gĩa kwĩhokeka,","poem":1},{"text":"nĩkĩũhĩgagia mũndũ ũrĩa ũtarĩ mũũgĩ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mataaro ma Jehova nĩmarũngĩrĩru,","poem":1},{"text":"nĩ makenagia ngoro.","poem":2},{"text":"Maathani ma Jehova nĩ macangararu,","poem":1},{"text":"maheaga maitho ũtheri.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gwĩtigĩra Jehova nĩ ũndũ mũtheru,","poem":1},{"text":"gũtũũraga nginya tene.","poem":2},{"text":"Matua ma Jehova nĩ ma ma,","poem":1},{"text":"na mothe nĩ ma kĩhooto.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Maũndũ macio nĩ ma goro gũkĩra thahabu,","poem":1},{"text":"o na gũkĩra thahabu ĩrĩa therie mũno;","poem":2},{"text":"marĩ mũrĩo gũkĩra ũũkĩ,","poem":1},{"text":"o ũũkĩ ũrĩa uumĩte igua-inĩ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ningĩ nĩmo mataaraga ndungata yaku;","poem":1},{"text":"kũmamenyerera nĩ ũndũ ũrĩ irĩhi inene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nũũ ũngĩhota gũkũũrana mahĩtia make?","poem":1},{"lineBreak":true},{"text":"Ndekera mahĩtia makwa ma hitho-inĩ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ningĩ rigagĩrĩria ndungata yaku ndĩkeehie mehia ma mwĩĩro o namo;","poem":1},{"text":"ndũkanareke mehia macio manjathe.","poem":2},{"text":"Nĩguo ndĩrĩikaraga itarĩ na ũcuuke,","poem":1},{"text":"na itarĩ na mehia ma kwagarara watho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ciugo cia kanua gakwa na matarania ma ngoro yakwa","poem":1},{"text":"irogũkenia maitho-inĩ maku,","poem":2},{"lineBreak":true},{"text":"Wee Jehova, o Wee Rwaro rwakwa rwa Ihiga, na Mũkũũri wakwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}