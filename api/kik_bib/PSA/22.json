{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":22,"content":[{"type":"heading","content":["Ruo Rũnene na Rwĩmbo rwa Kũgooca"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Ngai wakwa, Ngai wakwa, ũndiganĩirie nĩkĩ?","poem":1},{"text":"Ũndaihĩrĩirie ũguo nĩkĩ, ũkaaga kũũhonokia,","poem":2},{"lineBreak":true},{"text":"ũkaraihĩrĩria ciugo cia mũcaayo wakwa?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wee Ngai wakwa, ngũkayagĩra mũthenya, no ndũnjĩtĩkaga,","poem":1},{"text":"ngũkayagĩra ũtukũ, na ndingĩkira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"No rĩrĩ, Wee ũrĩ Mũtheru, Wee ũikarĩire gĩtĩ kĩa ũnene;","poem":1},{"text":"Wee nĩwe ũgoocagwo nĩ Isiraeli.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Maithe maitũ nĩwe meehokaga;","poem":1},{"text":"maakwĩhokire nawe ũkĩmahonokia.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Maagũkaĩire nao makĩhonokio;","poem":1},{"text":"maakwĩhokire na matiigana gũconorithio.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"No niĩ nduĩkĩte o ta kĩgunyũ, no ti ta mũndũ,","poem":1},{"text":"nganyararwo nĩ andũ na ngamenwo nĩ kĩrĩndĩ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Andũ arĩa othe maanyonaga nĩmanyũrũragia;","poem":1},{"text":"makaanuma makĩinainagia mĩtwe, makoiga atĩrĩ:","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Ehokaga Jehova; Jehova nĩakĩmũhatũre.","poem":1},{"text":"Nĩakĩmũteithũre, nĩgũkorwo nĩakenagio nĩwe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"No rĩrĩ, Wee nĩwe wandutire nda ya maitũ;","poem":1},{"text":"watũmire ngwĩhoke ndĩ o nyondo-inĩ cia maitũ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kuuma ndaaciarwo ndaikirio o harĩwe;","poem":1},{"text":"kuuma ndoima nda ya maitũ ũkoretwo ũrĩ Mũrungu wakwa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndũkandaihĩrĩrie,","poem":1},{"text":"nĩgũkorwo thĩĩna ũrĩ o hakuhĩ,","poem":2},{"lineBreak":true},{"text":"na gũtirĩ mũndũ o na ũmwe wa kũndeithia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ndegwa nyingĩ nĩindigicĩirie;","poem":1},{"text":"thiũrũrũkĩirio nĩ ndegwa irĩ hinya cia Bashani.","poem":2},{"noteId":3}]},{"type":"verse","number":13,"content":[{"text":"Mĩrũũthi ĩkũrarama, ĩgĩtambuuranga kĩrĩa ĩgwatĩtie,","poem":1},{"text":"ĩnjathamĩirie tũnua twayo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Njitĩtwo thĩ ta maaĩ,","poem":1},{"text":"namo mahĩndĩ makwa mothe nĩmarekanĩtie.","poem":2},{"text":"Ngoro yakwa yororoete ta mũhũra;","poem":1},{"text":"ĩtwekete ĩrĩ thĩinĩ wakwa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hinya wakwa ũniarĩte ta rũgĩo,","poem":1},{"text":"naruo rũrĩmĩ rwakwa rũkanyiitana na karakara nĩkũngʼara;","poem":2},{"lineBreak":true},{"text":"ũngometie rũkũngũ-inĩ rwa gĩkuũ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ndĩĩmũrigiicĩrie nĩ magui;","poem":1},{"text":"ndĩĩmũthiũrũrũkĩrie nĩ gĩkundi kĩa andũ arĩa meekaga ũũru,","poem":2},{"lineBreak":true},{"text":"nĩmatheecangĩte moko na magũrũ makwa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mahĩndĩ makwa no hote kũmatara mothe;","poem":1},{"text":"andũ marandora na makangũũrĩra maitho.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Maragayana nguo ciakwa,","poem":1},{"text":"nayo kanjũ yakwa makamĩcuukĩra mĩtĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"No rĩrĩ, Wee Jehova, ndũkandaihĩrĩrie mũno;","poem":1},{"text":"Wee Hinya wakwa, hiũha ũũke ũndeithie.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Teithũra muoyo wakwa kuuma harĩ rũhiũ rwa njora,","poem":1},{"text":"ũteithũre muoyo wakwa wa goro harĩ hinya wa magui.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Thara kuuma kanua-inĩ ka mĩrũũthi;","poem":1},{"text":"honokia kuuma hĩa-inĩ cia mbogo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Nĩngumbũra rĩĩtwa rĩaku kũrĩ ariũ a baba;","poem":1},{"text":"ndĩrĩkũgoocaga ndĩ kĩũngano-inĩ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Inyuĩ andũ aya mwĩtigĩrĩte Jehova, mũgoocei!","poem":1},{"text":"Inyuothe a njiaro cia Jakubu, mũkumiei,","poem":2},{"lineBreak":true},{"text":"inyuĩ a njiaro cia Isiraeli, mũtĩĩei.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nĩgũkorwo we ndaamenire","poem":1},{"text":"kana akĩnyarara gũthĩĩnĩka kwa ũrĩa mũnyamarĩku;","poem":2},{"text":"ndaahithire ũthiũ wake kuuma kũrĩ we,","poem":1},{"text":"no nĩathikĩrĩirie kĩrĩro gĩake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Gĩtũmi kĩa ngũgooce ũrĩa ngũgoocaga ndĩ kĩũngano-inĩ kĩnene kiumĩte harĩwe;","poem":1},{"text":"niĩ nĩndĩrĩhingagia mĩĩhĩtwa yakwa ndĩ mbere ya arĩa magwĩtigĩrĩte.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Andũ arĩa athĩĩni marĩrĩĩaga na makahũũna,","poem":1},{"text":"arĩa marongoragia Jehova, nĩmarĩmũgoocaga;","poem":2},{"lineBreak":true},{"text":"ngoro cianyu irotũũra nginya tene.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Andũ arĩa othe matũũraga ituri ciothe cia thĩ","poem":1},{"text":"nĩmakaririkana na macookerere Jehova,","poem":2},{"text":"andũ a nyũmba ciothe cia ndũrĩrĩ","poem":1},{"text":"nĩmakainamĩrĩra mbere yake,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"nĩgũkorwo ũthamaki nĩ wa Jehova,","poem":1},{"text":"na nĩwe wathaga ndũrĩrĩ ciothe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Andũ arĩa othe atongu a thĩ makaarĩa na mamũhooe;","poem":1},{"text":"arĩa othe makuuaga magathikwo nĩmagaturia ndu mbere yake,","poem":2},{"lineBreak":true},{"text":"o acio matangĩhota gwĩtũũria muoyo.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ciana nĩikamũtungatĩra;","poem":1},{"text":"nacio nĩikaahe njiarwa iria igooka ũhoro wa Mwathani.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Acio nĩmakahunjia ũthingu wake","poem":1},{"text":"kũrĩ andũ arĩa magaaciarwo,","poem":2},{"lineBreak":true},{"text":"nĩgũkorwo nĩwe wĩkĩte ũguo.","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"Bashani kwarĩ mwena wa gathigathini-irathĩro wa Palestina; nĩ kwoĩkaine nĩ ũndũ wa ndegwa ciakuo cia hinya na ngʼombe noru.","reference":{"chapter":22,"verse":12}}]},"thisChapterLink":"/api/kik_bib/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}