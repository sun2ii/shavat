{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"heading","content":["Jehova nĩwe Mũrĩithi Wakwa"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Jehova nĩwe mũrĩithi wakwa, ndirĩ kĩndũ ingĩaga.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Atũmaga njarahe ũrĩithio-inĩ ũrĩ nyeki nduru,","poem":2},{"text":"aandongoragia maaĩ-inĩ marĩ na ũhurũko.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Nĩariũkagia ngoro yakwa,","poem":2},{"text":"akandongoragia njĩra-inĩ cia ũthingu,","poem":1},{"text":"nĩ ũndũ wa rĩĩtwa rĩake.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"O na ingĩtuĩka ndĩrahungurĩra","poem":1},{"text":"mũkuru ũrĩ nduma ta ya gĩkuũ,","poem":2},{"text":"ndirĩ ũũru ingĩĩtigĩra,","poem":1},{"text":"nĩgũkorwo ũrĩ hamwe na niĩ;","poem":2},{"text":"thiarĩ waku na mũthĩgi waku","poem":1},{"text":"nĩciihooreragia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ũnjaragĩra metha mbere yakwa","poem":1},{"text":"o harĩa thũ ciakwa irĩ.","poem":2},{"noteId":4},{"text":"Ũnjitagĩrĩria maguta mũtwe;","poem":1},{"noteId":5},{"text":"gĩkombe gĩakwa nĩkĩiyũrĩrĩire.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ti-itherũ wega na wendani nĩirĩrũmanagĩrĩra na niĩ","poem":1},{"text":"matukũ mothe ma muoyo wakwa,","poem":2},{"text":"na niĩ ngũtũũra nyũmba ya Jehova nginya tene.","poem":1}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Matukũ ma tene irĩkanĩro ciahũũragwo mũhũũri na ũhoro wa kũrĩanĩra irio cia kuonania gĩkeno na ũrata.","reference":{"chapter":23,"verse":5}},{"noteId":5,"caller":"+","text":"Mũgeni wa gĩtĩĩo nĩahakagwo maguta manungi wega mũtwe hĩndĩ ya iruga.","reference":{"chapter":23,"verse":5}}]},"thisChapterLink":"/api/kik_bib/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}