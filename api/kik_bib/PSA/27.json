{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":27,"content":[{"type":"heading","content":["Kũgĩa na Ũũmĩrĩru harĩ Jehova"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Jehova nĩwe ũtheri wakwa na ũhonokio wakwa;","poem":1},{"text":"ingĩgĩĩtigĩra ũ?","poem":2},{"text":"Jehova nĩwe kĩĩhitho kĩa muoyo wakwa;","poem":1},{"text":"ingĩkĩmakio nũũ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Rĩrĩa andũ arĩa ooru manjũkĩrĩra","poem":1},{"text":"nĩguo matambuure nyama cia mwĩrĩ wakwa,","poem":2},{"text":"o acio thũ ciakwa na arĩa marĩ muku na niĩ maatharĩkĩra-rĩ,","poem":1},{"text":"marĩhĩngagwo makagũa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O na mbũtũ cia ita ingĩndigiicĩria,","poem":1},{"text":"ngoro yakwa ndĩngĩĩtigĩra;","poem":2},{"lineBreak":true},{"text":"o na ingĩũkĩrĩrwo nĩ ita,","poem":2},{"lineBreak":true},{"text":"ndingĩgĩa na nganja.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ndĩ o ũndũ ũmwe njũũragia harĩ Jehova,","poem":1},{"text":"na noguo thingataga:","poem":2},{"text":"atĩ njikarage nyũmba ya Jehova","poem":1},{"text":"matukũ mothe ma muoyo wakwa,","poem":2},{"text":"ndĩĩonagĩre wega wa Jehova,","poem":1},{"text":"na nduĩragie kĩrĩra ndĩ thĩinĩ wa hekarũ yake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nĩgũkorwo mũthenya wa thĩĩna-rĩ,","poem":1},{"text":"akaangitĩra ndĩ hau gĩikaro-inĩ gĩake;","poem":2},{"text":"nĩakahitha kĩĩgunyĩ-inĩ kĩa hema yake,","poem":1},{"text":"na andũgamie igũrũ wa rwaro rwa ihiga.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hĩndĩ ĩyo mũtwe wakwa nĩũkambarario","poem":1},{"text":"igũrũ wa thũ iria iithiũrũrũkĩirie;","poem":2},{"text":"nĩngaruta igongona ngĩanagĩrĩra na gĩkeno ndĩ hema-inĩ yake;","poem":1},{"text":"nĩngainĩra Jehova na ndĩmũgooce.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wee Jehova, igua mũgambo wakwa rĩrĩa ndagũkaĩra;","poem":1},{"text":"njiguagĩra tha na ũnjĩtĩkage.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ha ũhoro waku, ngoro yakwa yugaga atĩrĩ, “Rongoria ũthiũ wake!”","poem":1},{"text":"Na niĩ ngoiga atĩrĩ, Wee Jehova, ũthiũ waku nĩguo ndĩ rongoragia.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndũkaahithe ũthiũ waku,","poem":1},{"text":"tiga kũingata ndungata yaku na marakara;","poem":2},{"lineBreak":true},{"text":"Wee nĩwe ũtũũrĩte ũndeithagia.","poem":2},{"text":"Ndũkandege kana ũndiganĩrie,","poem":1},{"text":"Wee Ngai Mũhonokia wakwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"O na baba na maitũ mangĩndiganĩria,","poem":1},{"text":"Jehova nĩakanyamũkĩra.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wee Jehova nyonagĩrĩria njĩra yaku,","poem":1},{"text":"na ũngeragĩrie njĩra ĩrĩa nũngarũ,","poem":2},{"lineBreak":true},{"text":"nĩ ũndũ wa thũ ciakwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndũkaneane kũrĩ arĩa marĩ muku na niĩ,","poem":1},{"text":"nĩgũkorwo aira a maheeni nĩmanjũkĩrĩire,","poem":2},{"lineBreak":true},{"text":"makaheeha mĩheehũ ya kũnjĩka ũũru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Niĩ nĩnjĩtĩkĩtie ũũ:","poem":1},{"text":"atĩ nĩngeyonera wega wa Jehova","poem":2},{"lineBreak":true},{"text":"ndĩ bũrũri wa arĩa marĩ muoyo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Eterera o Jehova:","poem":1},{"text":"gĩa na hinya na ũũmĩrĩrie ngoro,","poem":2},{"lineBreak":true},{"text":"na weterere Jehova.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}