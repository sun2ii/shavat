{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"heading","content":["Ihooya rĩa Rũciinĩ rĩa kũũria Ũteithio"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Wee Jehova, kaĩ thũ ciakwa nĩ nyingĩ-ĩ!","poem":1},{"text":"Andũ arĩa manjũkĩrĩire nĩ aingĩ mũno!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Aingĩ nĩ arĩa maraaria ũhoro wakwa, makoiga atĩrĩ,","poem":1},{"text":"“Ngai ndangĩmũhonokia.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"No rĩrĩ, Wee Jehova nĩwe ngo ya kũngitĩra mĩena yothe;","poem":1},{"text":"Wee nowe ũũheaga riiri na ũgatũũgĩria mũtwe wakwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngayagĩra Jehova na mũgambo mũnene,","poem":1},{"text":"nake akanjĩtĩka arĩ kĩrĩma-inĩ gĩake kĩamũre.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Niĩ ngomaga na ngoona toro;","poem":1},{"text":"ngacooka ngokĩra rĩngĩ, tondũ Jehova nĩwe ũndũũragia.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndingĩĩtigĩra andũ makũmi ma ngiri,","poem":1},{"text":"acio mehaarĩirie kũnjũkĩrĩra na mĩena yothe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Arahũka, Wee Jehova!","poem":1},{"text":"Wee Ngai wakwa, honokia!","poem":2},{"text":"Thũ ciakwa ciothe nĩwe ũcigũthĩte thĩa,","poem":1},{"text":"na ũkoinanga magego ma andũ arĩa aaganu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ũhonokio uumaga harĩ Jehova.","poem":1},{"text":"Irathimo ciaku irotũũra na andũ aku.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}