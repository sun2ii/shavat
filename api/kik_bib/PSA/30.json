{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":30,"content":[{"type":"heading","content":["Ihooya rĩa Gũcookia Ngaatho"]},{"type":"verse","number":1,"content":[{"text":"Wee Jehova-rĩ, nĩngũgũtũũgĩria","poem":1},{"text":"nĩgũkorwo wandutire kũrĩa kũriku,","poem":2},{"lineBreak":true},{"text":"na ũkĩgiria thũ ciakwa ingenerere.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wee Jehova Ngai wakwa,","poem":1},{"text":"ndagũkaĩire ũndeithie nawe ũkĩĩhonia.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wee Jehova, wandutire kuuma mbĩrĩra-inĩ;","poem":1},{"text":"ũkĩgiria njikũrũke, ndoonye irima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Inĩrai Jehova mũmũgooce, inyuĩ andũ ake aamũre;","poem":1},{"text":"mũgooce rĩĩtwa rĩu rĩake itheru,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"nĩgũkorwo marakara make nĩ ma kahinda o kanini,","poem":1},{"text":"no ũtugi wake nĩwagũtũũria mũndũ muoyo;","poem":2},{"text":"kĩrĩro no kĩraarĩre ũtukũ wothe","poem":1},{"text":"no rũciinĩ gwakĩa kũrooke gĩkeno.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Hĩndĩ ĩrĩa ndagaacĩire, ndoigire atĩrĩ,","poem":1},{"text":"“Ndirĩ hĩndĩ ngenyenyeka.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wee Jehova, rĩrĩa wanyonirie ũtugi waku-rĩ,","poem":1},{"text":"watũmire ndĩhaande o ta kĩrĩma;","poem":2},{"text":"no rĩrĩa wahithire ũthiũ waku-rĩ,","poem":1},{"text":"nĩndamakire.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Wee Jehova nĩwe ndakaĩire;","poem":1},{"text":"ngĩthaitha Mwathani anjiguĩre tha:","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Mwanangĩko wakwa ũngĩkorwo na uumithio ũrĩkũ,","poem":1},{"text":"ingĩtoonyerera irima-inĩ?","poem":2},{"text":"Rũkũngũ-rĩ, no rũkũgooce?","poem":1},{"text":"No rwanĩrĩre wĩhokeku waku?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wee Jehova, thikĩrĩria na ũnjiguĩre tha;","poem":1},{"text":"Wee Jehova, tuĩka ũteithio wakwa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Wagarũrire kĩgirĩko gĩakwa gĩgĩtuĩka rwĩmbo rwa gĩkeno;","poem":1},{"text":"ũkĩnduta nguo yakwa ya ikũnia, ũkĩhumba gĩkeno,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"nĩgeetha ngoro yakwa ĩkũinĩre na ndĩgakire.","poem":1},{"text":"Wee Jehova Ngai wakwa, ngũtũũra ngũcookagĩria ngaatho nginya tene.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}