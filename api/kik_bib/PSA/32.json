{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":32,"content":[{"type":"heading","content":["Gĩkeno gĩa Kũrekerwo Mehia"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Kũrathimwo-rĩ,","poem":1},{"text":"nĩ ũrĩa ũrekeirwo mahĩtia make,","poem":2},{"lineBreak":true},{"text":"o ũrĩa mehia make mahumbĩrĩtwo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kũrathimwo-rĩ,","poem":1},{"text":"nĩ mũndũ ũrĩa Jehova atatuaga mwĩhia,","poem":2},{"lineBreak":true},{"text":"na ũrĩa ũtarĩ ũhinga ngoro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Rĩrĩa ndakirĩte ki,","poem":1},{"text":"mahĩndĩ makwa nĩmahinyarire","poem":2},{"lineBreak":true},{"text":"nĩ ũndũ wa gũcaaya gwakwa mũthenya wothe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nĩgũkorwo guoko gwaku","poem":1},{"text":"nĩ kwanditũhagĩra mũthenya na ũtukũ;","poem":2},{"text":"hinya wakwa wathirire","poem":1},{"text":"o ta ũrĩa ime rĩthiraga hĩndĩ ya riũa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hĩndĩ ĩyo ngĩkumbũrĩra mehia makwa,","poem":1},{"text":"na ndiahithire waganu wakwa,","poem":2},{"text":"ndoigire atĩrĩ, “Nĩngumbũra mahĩtia makwa kũrĩ Jehova,”","poem":1},{"text":"nawe ũkĩndekera ũũru wa mehia makwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nĩ ũndũ ũcio mũndũ wothe mwĩtigĩri Ngai","poem":1},{"text":"nĩakũhooe rĩrĩa ũngĩoneka;","poem":2},{"text":"ti-itherũ rĩrĩa maaĩ maingĩ marĩ hinya maambũrũrũka,","poem":1},{"text":"matingĩmũkinyĩra.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wee nĩwe kĩĩhitho gĩakwa;","poem":1},{"text":"nĩũkangitĩra hĩndĩ ya mathĩĩna,","poem":2},{"lineBreak":true},{"text":"na ũũthiũrũrũkĩrie na nyĩmbo cia ũhonokio.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nĩndĩrĩkũrutaga na ngakuonereria njĩra ĩrĩa wagĩrĩirwo nĩ kũgera;","poem":1},{"text":"ndĩrĩgũtaaraga na ngũmenyagĩrĩre.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndũkahaane ta mbarathi kana nyũmbũ,","poem":1},{"text":"iria itarĩ ũmenyo,","poem":2},{"text":"iria arĩ o nginya ciĩkĩrwo matamu na mĩkwa kanua,","poem":1},{"text":"kwaga ũguo itingĩgũkuhĩrĩria.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Andũ arĩa aaganu monaga maruo maingĩ,","poem":1},{"text":"no mũndũ ũrĩa wĩhokaga Jehova","poem":2},{"lineBreak":true},{"text":"egũtũũra arigiicĩirio nĩ wendo ũrĩa ũtathiraga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Inyuĩ arĩa athingu kenerai Jehova na mũcanjamũke;","poem":1},{"text":"mũinĩrei, inyuothe arĩa arũngĩrĩru ngoro!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}