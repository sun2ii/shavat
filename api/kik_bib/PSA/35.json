{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":35,"content":[{"type":"heading","content":["Kũhooya Kũhonokio kuuma kũrĩ Thũ"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Wee Jehova, hũũrana na arĩa marahũũrana na niĩ;","poem":1},{"text":"rũa na arĩa mararũa na niĩ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Oya ngo nene na gako kanini;","poem":1},{"text":"arahũka ũũke ũndeithie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hiũria itimũ na mĩcengi,","poem":1},{"text":"ũũkĩrĩre arĩa maathingatĩte.","poem":2},{"text":"Ĩra ngoro yakwa atĩrĩ,","poem":1},{"text":"“Niĩ nĩ niĩ ũhonokio waku.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Andũ arĩa mendaga kũnduta muoyo","poem":1},{"text":"maroconorithio na maagithio gĩtĩĩo,","poem":2},{"text":"arĩa mathugundaga kũnyũnũha","poem":1},{"text":"marocookio na thuutha mamakĩte.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Marohaana ta mahuti mombũrĩtwo nĩ rũhuho,","poem":1},{"text":"na mũraika wa Jehova amaingatithĩtie;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"njĩra yao ĩrogĩa nduma na ĩtendere,","poem":1},{"text":"nake mũraika wa Jehova ahanyũkanie nao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kuona atĩ nĩmahithĩire wabu wa kũndega hatarĩ gĩtũmi,","poem":1},{"text":"na makanyenjera irima hatarĩ gĩtũmi,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"marokorererwo nĩ mwanangĩko matehaarĩirie,","poem":1},{"text":"wabu ũcio manyambĩire ũromanyiita o ene,","poem":2},{"lineBreak":true},{"text":"marogwa irima rĩu manyenjeire.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hĩndĩ ĩyo ngoro yakwa ĩgaacanjamũka nĩ ũndũ wa Jehova,","poem":1},{"text":"na ĩkenagĩre ũhonokio wake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nĩngwanĩrĩra na ngoro yakwa yothe, njũũrie atĩrĩ,","poem":1},{"text":"“Nũũ ũhaana tawe, Wee Jehova?","poem":2},{"text":"O Wee ũhatũraga andũ arĩa athĩĩni harĩ arĩa marĩ hinya kũmakĩra,","poem":1},{"text":"ũkahatũra athĩĩni na abatari harĩ arĩa mamatunyaga indo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nĩkuumĩrĩte aira a maheeni,","poem":1},{"text":"makanjũũria ũhoro wa maũndũ itooĩ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wega wakwa mandĩhaga na ũũru,","poem":1},{"text":"magatiga ngoro yakwa ĩrĩ na ihooru.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"No rĩrĩa o maarĩ arũaru, niĩ ndehumbire nguo ya ikũnia,","poem":1},{"text":"na ngĩĩnyiihia na ũndũ wa kwĩhinga kũrĩa irio.","poem":2},{"text":"Rĩrĩa mahooya makwa maagire macookio-rĩ,","poem":1}]},{"type":"verse","number":14,"content":[{"text":"ndaikarire ngĩcakayaga,","poem":2},{"lineBreak":true},{"text":"o taarĩ mũrata wakwa kana mũrũ wa maitũ ndaacakayagĩra.","poem":2},{"text":"Ndethikĩire ndĩ na ihooru,","poem":1},{"text":"o taarĩ mũndũ ũracakaĩra nyina.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"No rĩrĩa ndahĩngirwo ngĩgwa, o moonganire hamwe mangenerere;","poem":1},{"text":"atharĩkĩri makĩũngana maatharĩkĩre itekũmenya.","poem":2},{"lineBreak":true},{"text":"Manjaambirie mategũtigithĩria.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Maanyũrũragia ta andũ matooĩ Ngai,","poem":1},{"text":"makaahagaranĩria magego mao.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wee Jehova-rĩ, nĩ nginya rĩ ũgũikara wĩroreire?","poem":1},{"text":"Hatũra muoyo wakwa kuuma harĩ wanangi wao,","poem":2},{"lineBreak":true},{"text":"ũhatũre muoyo wakwa wa goro kuuma harĩ mĩrũũthi ĩno.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nĩ niĩ ngũgũcookeria ngaatho kĩũngano-inĩ kĩrĩa kĩnene;","poem":1},{"text":"ndĩkũgoocaga ndĩ gatagatĩ ka andũ aingĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ndũkareke arĩa maathũire tũhũ","poem":1},{"text":"mangũũrĩre maitho, mangenerere;","poem":2},{"text":"kana acio maamenete hatarĩ gĩtũmi","poem":1},{"text":"moinanĩre maitho.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Matiaragia ndeto cia thayũ,","poem":1},{"text":"no mathugundaga maũndũ ma maheeni,","poem":2},{"lineBreak":true},{"text":"ma gũũkĩrĩra andũ arĩa maikaraga na thayũ bũrũri-inĩ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Manjathamagĩria tũnua twao makoiga atĩrĩ,","poem":1},{"text":"“Haiya! Haiya! Maitho maitũ nĩmeyoneire ũguo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Wee Jehova, nĩwĩoneire ũguo; tiga gũkira.","poem":1},{"text":"Wee Mwathani-rĩ, ndũgaikare haraaya na niĩ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Arahũka, ũkĩra ũngitĩre!","poem":1},{"text":"Hũũranĩra, Wee Ngai wakwa na Mwathani wakwa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Wee Jehova, nduĩra kũringana na ũthingu waku, Wee Ngai wakwa;","poem":1},{"text":"ndũkareke mangũũrĩre maitho, mangenerere.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ndũkareke meciirie atĩrĩ, “Haiya, ũguo noguo tũrendaga gwĩkĩke!”","poem":1},{"text":"Kana moige atĩrĩ, “Nĩtũmũmeretie.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Arĩa othe mangũũragĩra maitho mangenerere nĩ ũndũ wa mĩnyamaro yakwa","poem":1},{"text":"maroconorithio na manyiitwo nĩ kĩrigiicano;","poem":2},{"text":"arĩa othe metũũgagĩria igũrũ rĩakwa","poem":1},{"text":"maroconorithio na maagithio gĩtĩĩo.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Arĩa makenaga ndaatuĩrwo ciira na kĩhooto,","poem":1},{"text":"nĩmanĩrĩre na gĩkeno na gũcanjamũka;","poem":2},{"text":"nĩmatũũre moigaga atĩrĩ, “Jehova arotũgĩrio,","poem":1},{"text":"o we ũkenagĩra ũgaacĩru wa ndungata yake.”","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Rũrĩmĩ rwakwa rũrĩaragia ũhoro wa ũthingu waku,","poem":1},{"text":"na ngũgoocage mũthenya wothe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}