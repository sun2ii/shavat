{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"heading","content":["Ihooya rĩa Hwaĩ-inĩ"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Njĩtĩka rĩrĩa ndagũkaĩra,","poem":1},{"text":"Wee Ngai wakwa, o Wee mũthingu.","poem":2},{"text":"Ũndeithagie rĩrĩa ndĩ mĩnyamaro-inĩ;","poem":1},{"text":"njiguĩra tha na ũigue mahooya makwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Inyuĩ, andũ aya, nĩ nginya rĩ mũgũtũũra mũtũmaga riiri wakwa ũnyararwo?","poem":1},{"text":"Nĩ nginya rĩ mũgũtũũra mwendete maũndũ ma tũhũ,","poem":2},{"lineBreak":true},{"text":"na mũkarongoragia ngai cia maheeni?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Menyai atĩ Jehova nĩeyamũrĩire arĩa mamwendete;","poem":1},{"text":"Jehova nĩarĩiguaga rĩrĩa ndamũkaĩra.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mũngĩrakara mũtikehie;","poem":1},{"text":"rĩrĩa mũrĩ marĩrĩ-inĩ manyu-rĩ,","poem":2},{"lineBreak":true},{"text":"thuthuuragiai ngoro cianyu mwĩkirĩire.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Rutagai magongona marĩa magĩrĩire,","poem":1},{"text":"na mwĩhokage Jehova.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kũrĩ andũ aingĩ maroria atĩrĩ,","poem":1},{"text":"“Nũũ ũngĩtuonia maũndũ mega?”","poem":2},{"lineBreak":true},{"text":"Wee Jehova reke ũtheri wa gĩthiithi gĩaku ũtwarĩre.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wee nĩũnjiyũrĩtie gĩkeno kĩnene ngoro-inĩ yakwa,","poem":1},{"text":"gũkĩra kĩrĩa makoragwo nakĩo hĩndĩ ya bũthi wa ngano na ndibei ya mũhihano.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Niĩ ndĩrĩkomaga na nyonage toro ndĩ na thayũ,","poem":1},{"text":"nĩgũkorwo Wee Jehova nĩwe","poem":2},{"lineBreak":true},{"text":"ũikaraga ũũmenyereire wega.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}