{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":40,"content":[{"type":"heading","content":["Rwĩmbo rwa Gũcookia Ngaatho"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Ndetereire Jehova o ngirĩrĩirie;","poem":1},{"text":"nake agĩĩthikĩrĩria akĩigua kĩrĩro gĩakwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nĩ aandutire irima rĩa mũũro,","poem":1},{"text":"thĩinĩ wa ndoro yarĩ ndenderũ,","poem":2},{"text":"agĩkinyithia magũrũ makwa igũrũ rĩa rwaro rwa ihiga,","poem":1},{"text":"na agĩtũma ndĩhaande wega.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Eekĩrire rwĩmbo rwerũ kanua-inĩ gakwa,","poem":1},{"text":"rwĩmbo rwa kũgoocaga Ngai witũ naruo.","poem":2},{"text":"Andũ aingĩ marĩonaga ũguo magetigĩra,","poem":1},{"text":"nao makehoka Jehova.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kũrathimwo nĩ mũndũ","poem":1},{"text":"ũrĩa ũtuĩte atĩ arĩĩhokaga o Jehova,","poem":2},{"text":"na nderĩgagĩrĩra andũ arĩa etĩĩi,","poem":1},{"text":"o acio marũmagĩrĩra ngai cia maheeni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wee Jehova Ngai wakwa-rĩ,","poem":1},{"text":"magegania marĩa wĩkĩte nĩ maingĩ.","poem":2},{"text":"Maũndũ marĩa ũtũbangĩire","poem":1},{"text":"gũtirĩ mũndũ ũngĩhota gũgũtaarĩria;","poem":2},{"text":"korwo ndaaria heane ũhoro wamo-rĩ,","poem":1},{"text":"mangĩkorwo marĩ maingĩ mũno kũmoiga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wee-rĩ, ti magongona na maruta weriragĩria,","poem":1},{"text":"no nĩũũheete matũ ma gũkũigua;","poem":2},{"lineBreak":true},{"text":"maruta ma njino na maruta ma kũhoroheria mehia","poem":2},{"lineBreak":true},{"text":"ti mo maakũbatairie.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ningĩ ngiuga atĩrĩ, “Niĩ ũyũ haha, nĩndooka,","poem":1},{"text":"o ta ũrĩa kwandĩkĩtwo ũhoro wakwa ibuku-inĩ rĩa gĩkũnjo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Niĩ ndĩriragĩria gwĩka wendi waku, Wee Ngai wakwa;","poem":1},{"text":"watho waku ũrĩ ngoro-inĩ yakwa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nyanagĩrĩra ũhoro wa ũthingu ndĩ kĩũngano-inĩ kĩnene;","poem":1},{"text":"o ta ũrĩa ũũĩ, Wee Jehova,","poem":2},{"lineBreak":true},{"text":"niĩ ndihingaga mĩromo yakwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Niĩ ndihithagĩrĩra ũthingu waku ngoro-inĩ yakwa;","poem":1},{"text":"njaragia ũhoro wa wĩhokeku na ũhonokio waku.","poem":2},{"text":"Wendo waku na ũhoro waku wa ma","poem":1},{"text":"ndirĩ ndacihitha kĩũngano kĩrĩa kĩnene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Wee Jehova-rĩ, ndũkagirĩrĩrie tha ciaku inginyĩrĩre;","poem":1},{"text":"wendo waku na ũhoro waku wa ma irongitagĩra hĩndĩ ciothe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nĩgũkorwo mathĩĩna matangĩtarĩka nĩmandigiicĩirie;","poem":1},{"text":"mehia makwa nĩmanginyĩrĩire, ngaremwo nĩkuona.","poem":2},{"text":"Maingĩhĩte gũkĩra njuĩrĩ cia mũtwe wakwa,","poem":1},{"text":"na ngoro yakwa nĩyũrĩtwo nĩ hinya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Wee Jehova-rĩ, ĩtĩkĩra kũũhonokia,","poem":1},{"text":"Wee Jehova-rĩ, ũka narua ũndeithie.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Andũ arĩa othe mendaga kũnjũraga","poem":1},{"text":"maroconorithio na manyiitwo nĩ kĩrigiicano;","poem":2},{"text":"arĩa othe mendaga nyanangwo","poem":1},{"text":"marocooka na thuutha maconokete.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Andũ arĩa maathekagĩrĩra makiugaga atĩrĩ, “Haiya! Haiya!”","poem":1},{"text":"Maroiyũrwo nĩ ihooru nĩ ũndũ wa thoni ciao.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"No arĩa makũrongoragia","poem":1},{"text":"marokena na macanjamũke nĩ ũndũ waku;","poem":2},{"text":"arĩa mendete ũhonokio waku marotũũra moigaga atĩrĩ,","poem":1},{"text":"“Jehova arotũgĩrio!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"No rĩrĩ, niĩ ndĩ mũthĩĩni na mũbatari;","poem":1},{"text":"Mwathani arondirikana.","poem":2},{"text":"Wee nĩwe ũteithio wakwa na mũndeithũri;","poem":1},{"text":"Wee Ngai wakwa-rĩ, hiuha ũkĩndeithie.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}