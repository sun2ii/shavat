{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":42,"content":[{"type":"hebrew_subtitle","content":["Kwĩhoka Ũhonokio wa Mwathani. Thaburi ya Ariũ a Kora"]},{"type":"verse","number":1,"content":[{"text":"O ta ũrĩa thwariga ĩnyootagĩra tũrũũĩ twa maaĩ,","poem":1},{"text":"no taguo ngoro yakwa ĩkũnyootagĩra, Wee Ngai.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngoro yakwa nĩ Ngai ĩnyootagĩra, O we Mũrungu ũrĩa ũrĩ muoyo.","poem":1},{"text":"Ĩ nĩ rĩ ngaathiĩ ngacemanie na Ngai?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Maithori makwa matuĩkĩte nĩmo irio ciakwa","poem":1},{"text":"mũthenya o na ũtukũ,","poem":2},{"text":"nao andũ manjũũragia mũthenya wothe atĩrĩ,","poem":1},{"text":"“Ngai waku akĩrĩ ha?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Maũndũ maya ndĩmaririkanaga","poem":1},{"text":"o ngĩitũrũraga ngoro yakwa:","poem":2},{"text":"ngaririkana ũrĩa ndatwaranaga na kĩrĩndĩ,","poem":1},{"text":"ndongoretie mũtongoro nginya nyũmba-inĩ ya Ngai,","poem":2},{"text":"tũkĩanagĩrĩra na gĩkeno na tũgĩcookagia ngaatho,","poem":1},{"text":"ndĩ kĩrĩndĩ-inĩ hĩndĩ ya ciathĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wee ngoro yakwa, ũkĩritũhĩirwo nĩkĩ?","poem":1},{"text":"Ũrathĩĩnĩka ũguo nĩkĩ ũrĩ thĩinĩ wakwa?","poem":2},{"text":"Wĩrĩgagĩrĩre Ngai, nĩgũkorwo no ndĩrĩmũgoocaga,","poem":1},{"text":"o we Mũhonokia wakwa, na Ngai wakwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ngoro yakwa nĩnditũhĩre ĩrĩ thĩinĩ wakwa;","poem":1},{"text":"nĩ ũndũ ũcio nĩngũkũririkana","poem":2},{"text":"ndĩ bũrũri wa Jorodani,","poem":1},{"text":"o kũu irĩma-inĩ cia Herimoni,","poem":2},{"noteId":8},{"text":"kuuma Kĩrĩma-inĩ kĩa Mizari.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndia ĩmwe nĩĩreta ndia ĩrĩa ĩngĩ","poem":1},{"text":"na mũgambo wa mũrurumo wa ndururumo ciaku cia maaĩ;","poem":2},{"text":"makũmbĩ maku mothe o na ndiihũ nĩciũkĩte, ikaahubanĩria.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mũthenya-rĩ, Jehova nĩarĩathagĩrĩra wendo wake harĩ niĩ,","poem":1},{"text":"na ũtukũ nĩ rwĩmbo ndĩrĩmũinagĩra,","poem":2},{"lineBreak":true},{"text":"rũrĩ ihooya rĩa kũhooya Mũrungu wa muoyo wakwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Njũũragia Mũrungu, o we rwaro rwakwa rwa Ihiga, atĩrĩ,","poem":1},{"text":"“Ũriganĩirwo nĩ niĩ nĩkĩ?","poem":2},{"text":"Ingĩthiĩ ngĩcakayaga nĩkĩ,","poem":1},{"text":"nĩ ũndũ wa kũhinyĩrĩirio nĩ thũ?”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nĩ ta ngũhehenjwo mahĩndĩ makwa,","poem":1},{"text":"rĩrĩa amuku akwa mekũnyũrũria,","poem":2},{"text":"magatinda mũthenya wothe makĩnjũũria atĩrĩ,","poem":1},{"text":"“Ngai waku akĩrĩ ha?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Wee ngoro yakwa, ũkĩritũhĩirwo nĩkĩ?","poem":1},{"text":"Ũrathĩĩnĩka ũguo nĩkĩ ũrĩ thĩinĩ wakwa?","poem":2},{"text":"Wĩrĩgagĩrĩre Ngai,","poem":1},{"text":"nĩgũkorwo no ndĩrĩmũgoocaga,","poem":2},{"text":"o we Mũhonokia wakwa na Ngai wakwa.","poem":1}]}],"footnotes":[{"noteId":8,"caller":"+","text":"Herimoni kwarĩ mũhaka-inĩ wa mwena wa gathigathini wa bũrũri wa Isiraeli.","reference":{"chapter":42,"verse":6}}]},"thisChapterLink":"/api/kik_bib/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}