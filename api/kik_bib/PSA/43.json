{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"heading","content":["Kwĩhoka Ũhonokio wa Mwathani"]},{"type":"verse","number":1,"content":[{"text":"Nduĩra ciira wakwa, Wee Ngai,","poem":1},{"text":"na ũnjiirĩrĩre harĩ rũrĩrĩ rũrũ rũtagwĩtĩkĩtie;","poem":2},{"lineBreak":true},{"text":"ndeithũra kuuma kũrĩ andũ aya aaganu na maaragia maheeni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wee Ngai nĩwe kĩirigo gĩakwa kĩa hinya.","poem":1},{"text":"Ũndiganĩirie nĩkĩ?","poem":2},{"text":"Ingĩthiĩ ngĩcakayaga nĩkĩ","poem":1},{"text":"nĩ ũndũ wa kũhinyĩrĩirio nĩ thũ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tũma ũtheri waku na ũhoro waku wa ma,","poem":1},{"text":"ũreke indongorie arĩ cio;","poem":2},{"text":"reke inginyie kĩrĩma-inĩ gĩaku kĩrĩa kĩamũre,","poem":1},{"text":"o kũu gĩikaro-inĩ gĩaku.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hĩndĩ ĩyo nĩngathiĩ kĩgongona-inĩ kĩa Ngai,","poem":1},{"text":"nginye harĩ Mũrungu, o we gĩkeno gĩakwa, na o we ngenagĩra.","poem":2},{"text":"Nĩndĩrĩkũgoocaga ngĩhũũraga kĩnanda kĩa mũgeeto,","poem":1},{"text":"Wee Ngai, o Wee Ngai wakwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wee ngoro yakwa, ũkĩritũhĩirwo nĩkĩ?","poem":1},{"text":"Ũrathĩĩnĩka ũguo nĩkĩ ũrĩ thĩinĩ wakwa?","poem":2},{"text":"Wĩrĩgagĩrĩre o Ngai,","poem":1},{"text":"nĩgũkorwo no ndĩrĩmũgoocaga,","poem":2},{"lineBreak":true},{"text":"o we Mũhonokia wakwa na Ngai wakwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}