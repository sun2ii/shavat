{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":53,"content":[{"type":"heading","content":["Ngai Ndakenagio nĩ Irimũ"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Kĩrimũ kĩĩraga na ngoro atĩrĩ,","poem":1},{"text":"“Gũtirĩ Ngai.”","poem":2},{"text":"Nao amaramari, ciĩko ciao irĩ magigi;","poem":1},{"text":"gũtirĩ mũndũ o na ũmwe wĩkaga wega.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ngai aroraga ciana cia andũ","poem":1},{"text":"arĩ o igũrũ,","poem":2},{"text":"one kana nĩ harĩ ũrĩ na ũmenyo,","poem":1},{"text":"o na kana nĩ harĩ ũrongoragia Ngai.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Othe nĩmacookete na thuutha,","poem":1},{"text":"othe marĩ hamwe nĩmatuĩkĩte amaramari;","poem":2},{"text":"gũtirĩ o na ũmwe wĩkaga wega,","poem":1},{"text":"gũtirĩ o na ũmwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Andũ acio mekaga maũndũ mooru kaĩ matarĩ ũmenyo,","poem":1},{"text":"o acio marĩĩaga andũ akwa o ta ũrĩa andũ marĩĩaga irio,","poem":2},{"lineBreak":true},{"text":"o acio matakayagĩra Ngai?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"O hau-rĩ, makanyiitwo nĩ guoya mũnene,","poem":1},{"text":"o na gũtarĩ kĩndũ gĩa gũtũma metigĩre.","poem":2},{"text":"Nĩgũkorwo Ngai nĩahurunjĩte mahĩndĩ ma andũ acio magũtharĩkĩire;","poem":1},{"text":"nĩwamaconorithirie, nĩgũkorwo Ngai nĩamamenete.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Naarĩ korwo ũhonokio wa Isiraeli no ũgĩũke kuuma Zayuni!","poem":1},{"text":"Rĩrĩa Ngai agacookereria andũ ake na indo ciao-rĩ,","poem":2},{"lineBreak":true},{"text":"Jakubu nĩagakena na Isiraeli acanjamũke!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}