{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"heading","content":["Ngai Nĩwe Ũteithio Wakwa"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Wee Ngai, honokia nĩ ũndũ wa rĩĩtwa rĩaku;","poem":1},{"text":"ndĩhĩria na hinya waku.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wee Ngai, igua ihooya rĩakwa;","poem":1},{"text":"thikĩrĩria ciugo cia kanua gakwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Andũ ageni nĩmanjũkĩrĩire;","poem":1},{"text":"nao andũ matarĩ tha nĩmaracaria muoyo wakwa,","poem":2},{"lineBreak":true},{"text":"o andũ acio matarũmbũyagia Ngai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ti-itherũ Ngai nĩwe ũteithio wakwa;","poem":1},{"text":"Mwathani nĩwe ũndiiragĩrĩra.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Cookereria andũ arĩa manjambagia ũũru wao;","poem":1},{"text":"Wee maniine nĩ ũndũ wa wĩhokeku waku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nĩngũkũrutĩra igongona rĩa kwĩyendera;","poem":1},{"text":"nĩngũgooca rĩĩtwa rĩaku, Wee Jehova,","poem":2},{"lineBreak":true},{"text":"tondũ nĩ rĩega.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nĩgũkorwo nĩahonoketie mathĩĩna-inĩ makwa mothe,","poem":1},{"text":"na maitho makwa nĩmeyoneire gũtoorio gwa thũ ciakwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}