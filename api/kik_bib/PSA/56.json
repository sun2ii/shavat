{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":56,"content":[{"type":"heading","content":["Kwĩhoka Ngai"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Wee Ngai, njiguĩra tha,","poem":1},{"text":"nĩgũkorwo andũ nĩmaingatanĩte na niĩ mũno;","poem":2},{"lineBreak":true},{"text":"mũthenya wothe mendaga o gũũtharĩkĩra.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Andũ arĩa manjambagia","poem":1},{"text":"maingatanaga na niĩ mũthenya wothe;","poem":2},{"lineBreak":true},{"text":"aingĩ nĩ arĩa maraatharĩkĩra na mwĩtĩĩo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Rĩrĩa ndetigĩra-rĩ,","poem":1},{"text":"nĩwe ndĩrĩhokaga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nĩ ũndũ wa hinya wa Ngai, nĩndĩrĩgoocaga kiugo gĩake,","poem":1},{"text":"ndĩhokete o Ngai; ndingĩĩtigĩra.","poem":2},{"lineBreak":true},{"text":"Mũndũ ũrĩ na mwĩrĩ angĩnjĩka atĩa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mũthenya wothe matindaga makĩogomia ciugo ciakwa;","poem":1},{"text":"hĩndĩ ciothe mathugundaga kũnjĩka ũũru.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Manjiiragĩra na makanjoheria,","poem":1},{"text":"na makarĩithania na mĩthiĩre yakwa,","poem":2},{"lineBreak":true},{"text":"makĩenda kũnjũraga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wee Ngai, ndũkareke mahonoke o na atĩa;","poem":1},{"text":"ngʼaũrania ndũrĩrĩ na marakara maku.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Andĩka ũhoro wa gũcakaya gwakwa;","poem":1},{"text":"maithori makwa mekĩre cuba-inĩ yaku,","poem":2},{"lineBreak":true},{"text":"githĩ matirĩ maandĩko-inĩ maku?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Rĩrĩa ngaakaya ndeithio","poem":1},{"text":"thũ ciakwa nĩikahũndũka.","poem":2},{"lineBreak":true},{"text":"Ũndũ ũcio nĩũgatũma menye atĩ Ngai arĩ hamwe na niĩ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nĩ ũndũ wa hinya wa Ngai, ũrĩa ngoocaga kiugo gĩake,","poem":1},{"text":"nĩ ũndũ wa hinya wa Jehova, ũrĩa ngoocaga kiugo gĩake,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ndĩhokete o Ngai; ndingĩĩtigĩra.","poem":1},{"text":"Mũndũ-rĩ, angĩnjĩka atĩa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Wee Ngai, mĩĩhĩtwa ĩrĩa ndĩĩhĩtĩte ndĩ o nayo,","poem":1},{"text":"nĩndĩrĩkũrutagĩra maruta ma gũgũcookeria ngaatho.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nĩgũkorwo nĩũũhonoketie kuuma gĩkuũ-inĩ,","poem":1},{"text":"na ũkagirĩrĩria magũrũ makwa kũhĩngwo,","poem":2},{"text":"nĩguo thiiage mbere ya Ngai","poem":1},{"text":"ngĩonaga ũtheri ũrĩa wonagwo nĩ arĩa marĩ muoyo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}