{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":57,"content":[{"type":"heading","content":["Ihooya rĩa kũũria Ngai Ũteithio"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Wee Ngai, njiguĩra tha, ũnjiguĩre tha,","poem":1},{"text":"nĩgũkorwo nĩ harĩwe njũragĩra.","poem":2},{"text":"Niĩ ngũũrĩra kĩĩruru-inĩ kĩa mathagu maku,","poem":1},{"text":"o nginya mwanangĩko ũhĩtũke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ngũkaĩra Ngai-Ũrĩa-ũrĩ-Igũrũ-Mũno,","poem":1},{"text":"o kũrĩ Mũrungu, ũrĩa ũũhingagĩria maũndũ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Atũmaga ũteithio kuuma igũrũ akaahonokia,","poem":1},{"text":"akarũithia arĩa maahanyũkagia mũno;","poem":2},{"lineBreak":true},{"text":"Ngai agakĩndũmĩra wendani na wĩhokeku wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Niĩ ndĩ gatagatĩ-inĩ ka mĩrũũthi;","poem":1},{"text":"ngomete gatagatĩ ka nyamũ ndĩĩani,","poem":2},{"text":"na nĩo andũ arĩa magego mao mahaana ta matimũ na mĩguĩ,","poem":1},{"text":"o acio nĩmĩ ciao ihaana ta hiũ cia njora njũgĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wee Ngai, tũũgĩra, ũtũũgĩrio igũrũ rĩa igũrũ;","poem":1},{"text":"riiri waku nĩũgĩe igũrũ rĩa thĩ yothe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Thũ ciakwa nĩciambĩire magũrũ makwa mũtego wa wabu,","poem":1},{"text":"na niĩ ngĩĩthikĩra nĩ kũnyamarĩka.","poem":2},{"text":"Cienjete irima njĩra-inĩ yakwa,","poem":1},{"text":"no nĩcio igũĩte thĩinĩ warĩo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wee Ngai, ngoro yakwa nĩĩkindĩirie,","poem":1},{"text":"ngoro yakwa no ĩkindĩirie;","poem":2},{"lineBreak":true},{"text":"nĩkũina ngũina, ngũgooce na rwĩmbo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wee muoyo wakwa arahũka!","poem":1},{"text":"Arahũka wee kĩnanda kĩa mũgeeto, o nawe kĩnanda gĩa kĩnũbi!","poem":2},{"lineBreak":true},{"text":"Ngwarahũka ruoro rũgĩtema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Wee Mwathani, nĩngũkũgooca, gatagatĩ-inĩ ka ndũrĩrĩ;","poem":1},{"text":"nĩngũkũinĩra ngũgooce ndĩ gatagatĩ-inĩ ka andũ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nĩgũkorwo wendo waku nĩ mũnene, ũgagĩkinya o igũrũ;","poem":1},{"text":"wĩhokeku waku ũkinyĩte o matu-inĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Wee Ngai, tũũgĩra, ũtũũgĩrio igũrũ rĩa igũrũ;","poem":1},{"text":"riiri waku nĩũgĩe igũrũ rĩa thĩ yothe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}