{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":59,"content":[{"type":"heading","content":["Ihooya rĩa kũhooya Ũgitĩri"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Wee Ngai, honokia kuuma kũrĩ thũ ciakwa;","poem":1},{"text":"ngitĩra harĩ arĩa manjũkagĩrĩra.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Honokia kuuma kũrĩ arĩa mekaga ũũru,","poem":1},{"text":"na ũũhonokie kuuma kũrĩ acio aiti thakame.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ta kĩone ũrĩa manjoheirie!","poem":1},{"text":"Andũ ooru maranjiirĩra manjũkĩrĩre,","poem":2},{"lineBreak":true},{"text":"o na itekĩte ũũru kana ngehia, Wee Jehova.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndirĩ ũndũ mũũru njĩkĩte,","poem":1},{"text":"no rĩrĩ, nĩmehaarĩirie maatharĩkĩre.","poem":2},{"lineBreak":true},{"text":"Arahũka ũndeithie; wĩonere ũrĩa thĩĩnĩkĩte!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wee Jehova, Ngai Mwene-Hinya-Wothe, o Wee Ngai wa Isiraeli,","poem":1},{"text":"arahũka ũherithie ndũrĩrĩ ciothe;","poem":2},{"lineBreak":true},{"text":"ndũkaiguĩre andũ aaganu tha, o acio makunyanagĩra andũ arĩa angĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Macookaga hwaĩ-inĩ makĩraramaga ta ngui,","poem":1},{"text":"makĩũrũraga itũũra-inĩ inene.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ta kĩone kĩrĩa marerũka na tũnua twao,","poem":1},{"text":"nĩ ta marerũka hiũ cia njora kuuma mĩromo-inĩ yao,","poem":2},{"lineBreak":true},{"text":"makooria atĩrĩ, “Nũũ ũngĩtũigua?”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"No Wee Jehova-rĩ, mathekerere;","poem":1},{"text":"ndũrĩrĩ icio ciothe nĩũcinyararĩte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Wee Hinya wakwa-rĩ, nowe njũũthĩrĩirie;","poem":1},{"text":"Wee Ngai-rĩ, nĩwe kĩirigo gĩakwa kĩa hinya,","poem":2},{"lineBreak":true},{"text":"o Wee Ngai wakwa mũnyendi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ngai nĩegũthiĩ mbere yakwa,","poem":1},{"text":"na nĩekũnjĩtĩkĩria ngenerere arĩa manjambagia.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"No ndũkamoorage,","poem":1},{"text":"nĩguo andũ akwa matikanariganĩrwo.","poem":2},{"text":"Nĩ ũndũ wa hinya waku, tũma matũũre morũũraga,","poem":1},{"text":"nginya ũmatoorie, Wee Mwathani ngo iitũ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nĩ ũndũ wa mehia ma tũnua twao,","poem":1},{"text":"na nĩ ũndũ wa ciugo cia mĩromo yao,","poem":2},{"lineBreak":true},{"text":"tũma magwatio nĩ mũtego wa mwĩtĩĩo wao.","poem":2},{"text":"Nĩ ũndũ wa irumi na maheeni marĩa maaragia,","poem":1}]},{"type":"verse","number":13,"content":[{"text":"maniine na marakara maku,","poem":2},{"lineBreak":true},{"text":"maniine nginya mathire biũ.","poem":2},{"text":"Hĩndĩ ĩyo nĩgũkamenyeka nginya ituri cia thĩ,","poem":1},{"text":"atĩ Ngai nĩwe wathaga Jakubu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Macookaga hwaĩ-inĩ makĩraramaga ta ngui,","poem":1},{"text":"makĩũrũraga itũũra-inĩ inene.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Morũũraga magĩcaria irio,","poem":1},{"text":"na makoigĩrĩria maga kũhũũna.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"No niĩ-rĩ, ndĩinaga ũhoro wa hinya waku,","poem":1},{"text":"o rũciinĩ ngaina ũhoro wa wendo waku;","poem":2},{"text":"nĩgũkorwo Wee nĩwe kĩirigo gĩakwa kĩa hinya,","poem":1},{"text":"na rĩũrĩro rĩakwa hĩndĩ ya mathĩĩna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Wee Hinya wakwa-rĩ, nĩngũkũinĩra ngũgooce;","poem":1},{"text":"nĩgũkorwo Wee nĩwe kĩirigo gĩakwa kĩa hinya,","poem":2},{"lineBreak":true},{"text":"o Wee Ngai ũrĩa ũnyendete.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}