{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"heading","content":["Kũhooya Ũgitĩri wa Ngai"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Wee Ngai, igua kĩrĩro gĩakwa;","poem":1},{"text":"thikĩrĩria ihooya rĩakwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ndĩragũkaĩra kuuma ituri cia thĩ,","poem":1},{"text":"ndĩragũkaĩra o ngoro yakwa ĩgĩthiragwo nĩ hinya;","poem":2},{"lineBreak":true},{"text":"ndongoria nginye rwaro-inĩ rwa ihiga rũrĩa rũraihu na igũrũ kũngĩra.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nĩgũkorwo nĩwe ũkoretwo ũrĩ rĩũrĩro rĩakwa,","poem":1},{"text":"mũthiringo mũraihu na igũrũ wa hinya wa kwĩhitha kuuma kũrĩ thũ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ndĩĩriragĩria gũtũũra hema-inĩ yaku nginya tene,","poem":1},{"text":"na ndĩĩhithage kĩĩruru-inĩ kĩa mathagu maku.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nĩgũkorwo Wee Ngai nĩũiguĩte mĩĩhĩtwa yakwa,","poem":1},{"text":"nĩũngaĩire igai rĩa andũ arĩa metigĩrĩte rĩĩtwa rĩaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ongerera matukũ ma mũthamaki ma gũtũũra muoyo,","poem":1},{"text":"mĩaka yake ĩigane ta ya njiarwa nyingĩ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Aroikarĩra gĩtĩ kĩa ũnene arĩ mbere ya Ngai nginya tene;","poem":1},{"text":"tũma wendo na wĩhokeku waku imũgitagĩre.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Hĩndĩ ĩyo ngatũũra nyinaga rwĩmbo rwa kũgooca rĩĩtwa rĩaku,","poem":1},{"text":"na hingagie mĩĩhĩtwa yakwa mũthenya o mũthenya.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}