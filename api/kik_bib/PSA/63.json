{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"heading","content":["Kũnyootera Ngai"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Wee Ngai, nĩwe Mũrungu wakwa,","poem":1},{"text":"Wee-rĩ, nĩwe nongoragia na kĩyo;","poem":2},{"text":"ngoro yakwa nĩwe ĩnyootagĩra,","poem":1},{"text":"na mwĩrĩ wakwa nĩwe wĩriragĩria,","poem":2},{"text":"ndĩ bũrũri-inĩ ũyũ mũũmũ na wa mĩnoga,","poem":1},{"text":"o ũyũ ũtarĩ maaĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nĩnguonete ũrĩ handũ-harĩa-haamũre,","poem":1},{"text":"na ngeyonera hinya waku na riiri waku.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tondũ wendo waku nĩ mwega gũkĩra muoyo guo mwene-rĩ,","poem":1},{"text":"mĩromo yakwa nĩĩrĩkũgoocaga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndĩrĩkũgoocaga hĩndĩ ĩrĩa yothe ngũtũũra muoyo,","poem":1},{"text":"ngoocage rĩĩtwa rĩaku nyambararĩtie moko makwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngoro yakwa ĩiganĩire ta ĩrĩĩte irio iria njega mũno;","poem":1},{"text":"nako kanua gakwa nĩkarĩkũgoocaga, mĩromo yakwa ĩgakũinĩra.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ngũririkanaga ndĩ ũrĩrĩ;","poem":1},{"text":"ndĩciiragia ũhoro waku ũtukũ wothe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tondũ Wee nĩwe ũteithio wakwa-rĩ,","poem":1},{"text":"nyinagĩra kĩĩruru-inĩ kĩa mathagu maku.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngoro yakwa nĩĩnyiitĩrĩire harĩwe;","poem":1},{"text":"guoko gwaku kwa ũrĩo gũkaanyiitĩrĩra.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Andũ arĩa macaragia muoyo wakwa nĩguo maũniine nĩmakanangwo;","poem":1},{"text":"magaatoonyerera na thĩ nginya kũrĩa kũriku mũno.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Makooragwo na rũhiũ rwa njora","poem":1},{"text":"matuĩke irio cia mbwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"No rĩrĩ, mũthamaki nĩagakena nĩ ũndũ wa Ngai;","poem":1},{"text":"andũ arĩa othe mehĩtaga makĩgwetaga rĩĩtwa rĩa Ngai nĩmakamũgooca,","poem":2},{"lineBreak":true},{"text":"natuo tũnua twa arĩa maaragia maheeni nĩtũgaakirio.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}