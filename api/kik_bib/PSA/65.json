{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":65,"content":[{"type":"heading","content":["Gũcookia Ngaatho nĩ ũndũ wa Irathimo"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Wee Ngai, twetereire gũkũgooca tũrĩ Zayuni;","poem":1},{"text":"nĩ harĩwe mĩĩhĩtwa iitũ ĩkaahingio.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wee ũiguaga mahooya-rĩ,","poem":1},{"text":"andũ othe marĩũkaga harĩwe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Rĩrĩa twahubanĩirio nĩ mehia,","poem":1},{"text":"Wee nĩwatũrekeire mahĩtia maitũ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kũrathimwo-rĩ, nĩ andũ arĩa ũthuurĩte,","poem":1},{"text":"na ũkamarehe hakuhĩ matũũrage kũu nja ciaku!","poem":2},{"text":"Ithuĩ tũrĩiganagĩra nĩ maũndũ mega ma nyũmba yaku,","poem":1},{"text":"o macio ma hekarũ yaku theru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ũtũcookagĩria ũhoro na ciĩko cia magegania na cia kĩhooto,","poem":1},{"text":"Wee Ngai Mũhonokia witũ,","poem":2},{"text":"o Wee nĩwe mwĩhoko wa andũ arĩa marĩ ituri-inĩ ciothe cia thĩ,","poem":1},{"text":"na arĩa marĩ iria-inĩ kũndũ kũraya mũno,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"o Wee wombire irĩma na hinya waku,","poem":1},{"text":"wĩohete ũhoti taarĩ mũcibi,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"o Wee wahooreririe mũrurumo wa maria,","poem":1},{"text":"ũkĩhooreria mũrurumo wa ndiihũ ciamo,","poem":2},{"lineBreak":true},{"text":"na ũgĩkiria inegene rĩa ndũrĩrĩ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Andũ arĩa matũũraga kũraya nĩmetigagĩra magegania maku;","poem":1},{"text":"ũtũmaga thĩ yothe ĩkene,","poem":2},{"lineBreak":true},{"text":"kuuma kũrĩa rũciinĩ rũrathaga nginya kũrĩa hwaĩ-inĩ ũthũaga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Wee nĩwe ũmenyagĩrĩra thĩ na ũkamiurĩria mbura;","poem":1},{"text":"ũtũmaga ĩgĩe na bũthi mũingĩ.","poem":2},{"text":"Rũũĩ rwa Ngai rũiyũrĩte maaĩ","poem":1},{"text":"ma gũkũrĩria andũ irio,","poem":2},{"lineBreak":true},{"text":"nĩgũkorwo ũguo nĩguo wathĩrĩirie gwĩkagwo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ũiyũragia mĩtaro yakuo maaĩ,","poem":1},{"text":"na ũkaaragania mĩkũmũkũmũ yakuo;","poem":2},{"text":"ũmĩororoagia na mbura ya rũthuthuũ,","poem":1},{"text":"na ũkarathima kĩmera kĩayo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mwaka ũwĩkĩrĩte thũmbĩ ya wega waku,","poem":1},{"text":"namo makaari maku makaiyũrĩrĩra bũthi mũingĩ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nyeki ya werũ nĩ nduru mũno,","poem":1},{"text":"natuo tũrĩma tũiyũrĩtwo nĩ gĩkeno.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Cieni ciyũrĩte ndũũru cia ngʼondu,","poem":1},{"text":"nacio ituamba ikaiyũra ngano;","poem":2},{"lineBreak":true},{"text":"indo ciothe iroigĩrĩria ikaina nĩ gũkena.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}