{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"heading","content":["Rwĩmbo rwa Kũgooca Ngai"]},{"type":"hebrew_subtitle","content":["Rwĩmbo rwa Thaburi"]},{"type":"verse","number":1,"content":[{"text":"Ngai arotũkinyĩria wega wake, na atũrathime,","poem":1},{"text":"na atũme ũthiũ wake ũtwarĩre,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"nĩguo njĩra ciaku imenyeke gũkũ thĩ,","poem":1},{"text":"ũhonokio waku ũmenywo nĩ ndũrĩrĩ ciothe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Andũ marokũgooca, Wee Ngai;","poem":1},{"text":"andũ othe marogũkumia.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndũrĩrĩ nĩicanjamũke na cikũinĩre nĩ gũkena,","poem":1},{"text":"nĩgũkorwo wathaga andũ na kĩhooto,","poem":2},{"lineBreak":true},{"text":"na ũgatongoria ndũrĩrĩ iria irĩ gũkũ thĩ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Andũ marokũgooca, Wee Ngai;","poem":1},{"text":"andũ othe marogũkumia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Hĩndĩ ĩyo bũrũri nĩũkaruta magetha maguo,","poem":1},{"text":"na Ngai, o we Ngai witũ, nĩagatũrathima.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngai nĩagatũrathima,","poem":1},{"text":"nacio ituri ciothe cia thĩ nĩikamwĩtigĩra.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}