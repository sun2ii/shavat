{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":69,"content":[{"type":"heading","content":["Ihooya rĩa kũũria Ũteithio"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Wee Ngai-rĩ, honokia,","poem":1},{"text":"nĩgũkorwo maaĩ maanginyĩte o ngingo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndĩratoonyerera mũtondo-inĩ mũriku,","poem":1},{"text":"handũ hatarĩ na ha gũkinyithia kũgũrũ.","poem":2},{"text":"Nginyĩte maaĩ-inĩ harĩa hariku;","poem":1},{"text":"mũiyũro wa maaĩ nĩũhumbĩkanĩtie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nĩnogete mũno nĩ gũkaya ndeithio;","poem":1},{"text":"mũmero wakwa nĩ mũngʼaru.","poem":2},{"text":"Maitho makwa nĩmorĩtwo nĩ hinya","poem":1},{"text":"nĩgũcũthĩrĩria Ngai wakwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Andũ arĩa maathũire hatarĩ gĩtũmi","poem":1},{"text":"nĩ aingĩ gũkĩra njuĩrĩ cia mũtwe wakwa;","poem":2},{"text":"thũ ciakwa iria iithũire hatarĩ gĩtũmi nĩ nyingĩ,","poem":1},{"text":"o icio injaragia iniine.","poem":2},{"text":"Hatagĩrĩrio njookie kĩndũ itaiyĩte.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wee Ngai nĩũũĩ ũrimũ wakwa;","poem":1},{"text":"mahĩtia makwa matingĩhithĩka harĩwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Andũ arĩa makwĩhokete,","poem":1},{"text":"maroaga gũconorithio nĩ ũndũ wakwa,","poem":2},{"lineBreak":true},{"text":"Wee Mwathani, Jehova Mwene-Hinya-wothe;","poem":2},{"text":"arĩa makũrongoragia","poem":1},{"text":"maroaga kũnyararwo nĩ ũndũ wakwa,","poem":2},{"lineBreak":true},{"text":"Wee Ngai wa Isiraeli.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nĩgũkorwo nĩngirĩrĩirie kũmenwo nĩ ũndũ waku,","poem":1},{"text":"naguo ũthiũ wakwa nĩũhumbĩtwo thoni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nduĩkĩte ta mũgeni harĩ ariũ a baba,","poem":1},{"text":"ngatuĩka ta mũndũ wa kũngĩ harĩ ariũ a maitũ;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"kĩyo kĩrĩa ndĩ nakĩo kĩa nyũmba yaku nĩkĩo kĩrandĩa,","poem":1},{"text":"irumi cia arĩa makũrumaga nĩ niĩ igũĩrĩire.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Rĩrĩa ngũrĩra na ngehinga kũrĩa irio,","poem":1},{"text":"no nginya ngirĩrĩrie kũnyũrũrio;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"rĩrĩa ndehumba nguo ya ikũnia,","poem":1},{"text":"andũ no gũũthekerera.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Andũ arĩa maikaraga kĩhingo-inĩ gĩa itũũra nĩ niĩ manyũrũragia,","poem":1},{"text":"na nduĩkĩte rwĩmbo rwa arĩĩu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Wee Jehova, nĩndakũhooya","poem":1},{"text":"hĩndĩ ĩrĩa ya gwĩtĩkĩrĩka nĩwe;","poem":2},{"text":"Wee Ngai, nĩ ũndũ wa wendo waku mũnene,","poem":1},{"text":"ũnjĩtĩke na ũhonokio waku wa ma.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Honokia ũndute mũtondo-inĩ,","poem":1},{"text":"ndũkareke ndoonyerere;","poem":2},{"text":"ndeithũra kuuma kũrĩ arĩa maathũire,","poem":1},{"text":"ũndute kuuma maaĩ-inĩ marĩa mariku.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndũkareke mũiyũro wa maaĩ ũũhubĩkanie,","poem":1},{"text":"kana merio nĩ kũrĩa kũriku,","poem":2},{"lineBreak":true},{"text":"o na kana ndumĩrio kanua nĩ irima rĩa gĩkuũ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wee Jehova, njĩtĩka nĩ ũndũ wa wega wa wendo waku;","poem":1},{"text":"nĩ ũndũ wa tha ciaku nyingĩ wĩhũgũre ũnjookerere.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ndũkahithe ndungata yaku ũthiũ waku;","poem":1},{"text":"njĩtĩka narua, nĩgũkorwo ndĩ thĩĩna-inĩ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ũka hakuhĩ ũndeithũre;","poem":1},{"text":"honokia kuuma kũrĩ thũ ciakwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"We nĩũũĩ ũrĩa nyũrũrĩtio, na ngaconorithio na ngahumbwo thoni;","poem":1},{"text":"thũ ciakwa ciothe irĩ mbere yaku.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kũnyũrũrio nĩ gũũthuthĩte ngoro","poem":1},{"text":"ngatigwo itarĩ na mwĩhoko;","poem":2},{"text":"ndeetereire nyone wa kũnjiguĩra tha, no ndiigana kũmuona,","poem":1},{"text":"ngĩeterera nyone andũ a kũũhooreria, no ndiamonire.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Maanjĩkĩrĩire maaĩ ma nyongo irio-inĩ ciakwa,","poem":1},{"text":"na ndanyoota makĩĩhe thiki nyue.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Metha ĩrĩa maarĩirwo ĩrotuĩka mũtego;","poem":1},{"text":"ĩrotuĩka ihũũra o na mũtego wa kũmagwatia.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Maitho mao marogĩa nduma matige gũcooka kuona,","poem":1},{"text":"nayo mĩgongo yao ĩrohocerera nginya tene.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Maitũrũrĩre mangʼũrĩ maku;","poem":1},{"text":"makinyĩrie marakara maku mahiũ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mĩciĩ yao ĩrokira ihooru;","poem":1},{"text":"kũroaga mũndũ wa gũtũũra hema-inĩ ciao.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nĩgũkorwo manyariiraga arĩa wee ũgurarĩtie,","poem":1},{"text":"na makaaria ũhoro wa ruo rwa arĩa ũtiihĩtie.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Mathitangĩre o ngero thuutha wa ĩrĩa ĩngĩ;","poem":1},{"text":"ndũkanareke magatoonya ũhonokanio-inĩ waku.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Marothario ibuku-inĩ rĩa muoyo,","poem":1},{"text":"mage kwandĩkwo mũtaratara-inĩ wa andũ arĩa athingu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Ndĩ na ruo na ngathĩĩnĩka;","poem":1},{"text":"Wee Ngai kĩĩhonokie na ũngitĩre.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Nĩngũgooca rĩĩtwa rĩa Ngai na rwĩmbo,","poem":1},{"text":"na ndĩmũtũũgĩrie ngĩmũcookagĩria ngaatho.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Naguo ũndũ ũcio nĩũgũgĩkenia Jehova gũkĩra kũmũhe ndegwa,","poem":1},{"text":"na gũkĩra ndegwa nene ĩrĩ na hĩa na mahũngũ.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Andũ arĩa athĩĩni mona ũguo nĩmagakena;","poem":1},{"text":"inyuĩ arĩa mũrongoragia Ngai, ngoro cianyu iroarahũka!","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Jehova nĩathikagĩrĩria arĩa abatari,","poem":1},{"text":"na ndangĩnyarara andũ ake moohetwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Igũrũ na thĩ nĩimũgooce,","poem":1},{"text":"o na maria marĩa manene na kĩrĩa gĩothe gĩthiiagĩra thĩinĩ wamo,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"nĩgũkorwo Ngai nĩakahonokia Zayuni,","poem":1},{"text":"na aake matũũra marĩa manene ma Juda rĩngĩ.","poem":2},{"text":"Hĩndĩ ĩyo andũ nĩmagatũũra kuo na makwĩgwatĩre;","poem":1}]},{"type":"verse","number":36,"content":[{"text":"ciana cia ndungata ciake nĩigakũgaya,","poem":2},{"lineBreak":true},{"text":"nao arĩa mendete rĩĩtwa rĩake nĩmagatũũra kuo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}