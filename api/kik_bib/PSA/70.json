{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"heading","content":["Rwĩmbo rwa kũũria Ũteithio"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Wee Ngai, hiũha ũũhonokie;","poem":1},{"text":"Wee Jehova ũka narua ũndeithie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Andũ arĩa mendaga kũnjũraga","poem":1},{"text":"maroconorithio na manyiitwo nĩ kĩrigiicano;","poem":2},{"text":"arĩa othe mendaga nyanangwo","poem":1},{"text":"marocooka na thuutha maconokete.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Andũ arĩa mathekagĩrĩra makiugaga atĩrĩ, “Haiya! Haiya!”","poem":1},{"text":"marocooka na thuutha maconokete.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"No arĩa othe makũrongoragia","poem":1},{"text":"marokena na macanjamũke;","poem":2},{"text":"arĩa mendete ũhonokio waku marotũũra moigaga atĩrĩ,","poem":1},{"text":"“Ngai arotũgĩrio!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"No rĩrĩ, niĩ ndĩ mũthĩĩni na mũbatari;","poem":1},{"text":"Wee Ngai, hiuha ũũke kũrĩ niĩ.","poem":2},{"text":"Wee nĩwe ũteithio wakwa na mũhonokia wakwa;","poem":1},{"text":"Wee Jehova, ndũkagonderere gũũka kũndeithia.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}