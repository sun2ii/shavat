{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":71,"content":[{"type":"heading","content":["Ihooya rĩa kũũria Ũgitĩri"]},{"type":"verse","number":1,"content":[{"text":"Wee Jehova-rĩ, njũrĩire harĩwe;","poem":1},{"text":"ndũkanakĩreke njonorithio.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndeithũra na ũũhonokie nĩ ũndũ wa ũthingu waku;","poem":1},{"text":"thikĩrĩria ũũhonokie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tuĩka rwaro rwakwa rwa ihiga rwa kũũrĩra,","poem":1},{"text":"harĩa ingĩthiĩ hĩndĩ ciothe;","poem":2},{"text":"athana honokio,","poem":1},{"text":"nĩgũkorwo nĩwe rwaro rwakwa rwa ihiga na kĩirigo gĩakwa kĩa hinya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Honokia, Wee Ngai wakwa, kuuma guoko-inĩ kwa andũ arĩa aaganu,","poem":1},{"text":"ũndeithũre kuuma ngumbaco ya andũ arĩa ooru na matarĩ tha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nĩgũkorwo ũkoretwo ũrĩ kĩĩrĩgĩrĩro gĩakwa, Wee Mwathani Jehova,","poem":1},{"text":"ũtũũrĩte ũrĩ mwĩhoko wakwa kuuma ndĩ o mũnini.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kuuma gũciarwo gwakwa ndũũrĩte ngwĩhokete;","poem":1},{"text":"nĩwe wandutire nda ya maitũ.","poem":2},{"lineBreak":true},{"text":"Ngũtũũra ngũgoocaga.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nĩnduĩkĩte ta kĩndũ gĩa kũgegania harĩ andũ aingĩ,","poem":1},{"text":"no nĩwe rĩũrĩro rĩakwa rĩa hinya.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kanua gakwa kaiyũrĩte ũgooci waku,","poem":1},{"text":"gatindaga gakĩgana riiri waku mũthenya wothe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ndũkande hĩndĩ ya ũkũrũ;","poem":1},{"text":"ndũkanandiganĩrie rĩrĩa itarĩ na hinya.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nĩgũkorwo thũ ciakwa ciaragia ũhoro wa kũnjũkĩrĩra;","poem":1},{"text":"acio metagĩrĩra kũnjũraga nĩmacokanĩtie ndundu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Moigaga atĩrĩ, “Ngai nĩamũtiganĩirie;","poem":1},{"text":"hanyũkaniai nake mũmũnyiite,","poem":2},{"lineBreak":true},{"text":"nĩgũkorwo ndarĩ mũndũ wa kũmũteithũra.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wee Ngai, tiga kũndaihĩrĩria;","poem":1},{"text":"Wee Ngai wakwa, ũka narua ũndeithie.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Acio maathitangaga-rĩ, maroconoka na maniinwo;","poem":1},{"text":"acio mendaga kũnjĩka ũũru,","poem":2},{"lineBreak":true},{"text":"maronyararwo na maconorwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"No niĩ-rĩ, ndĩrĩkoragwo na kĩĩrĩgĩrĩro hĩndĩ ciothe;","poem":1},{"text":"ndĩrĩkĩragĩrĩria gũkũgooca mũno makĩria.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kanua gakwa karĩganaga ũthingu waku,","poem":1},{"text":"ndindage o ngĩgana ũhonokio waku mũthenya wothe,","poem":2},{"lineBreak":true},{"text":"o na gũtuĩka ndiũĩ mũigana waguo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wee Mwathani Jehova, ngũũka ngĩanagĩrĩra ciĩko ciaku cia hinya,","poem":1},{"text":"nyanĩrĩre ũthingu waku, o ũthingu waku wiki.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kuuma ndĩ o mũnini, Wee Ngai, ũtũũrĩte ũndutaga,","poem":1},{"text":"na nginyagia ũmũthĩ no nyumbũraga ciĩko ciaku cia magegania.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wee Ngai, o na ndakũra ngĩe mbuĩ,","poem":1},{"text":"ndũkanandiganĩrie,","poem":2},{"text":"o nginya nyumbũre ũhoro wa ũhoti waku kũrĩ rũciaro rũrĩa rũrooka,","poem":1},{"text":"na nyumbũre ũhoro wa hinya waku kũrĩ arĩa othe magooka thuutha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Wee Ngai-rĩ, ũthingu waku ũkinyĩte o matu-inĩ,","poem":1},{"text":"Wee wĩkĩte maũndũ manene.","poem":2},{"lineBreak":true},{"text":"Wee Ngai-rĩ, nũũ ũngĩ ũhaana ta we?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"O na gũtuĩka nĩũtũmĩte nyone mathĩĩna maingĩ na marũrũ-rĩ,","poem":1},{"text":"nĩũkariũkia muoyo wakwa rĩngĩ;","poem":2},{"text":"nĩũkandiũkia rĩngĩ","poem":1},{"text":"kuuma thĩ kũrĩa kũriku.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nĩũkongerera gĩtĩĩo gĩakwa,","poem":1},{"text":"na ũũhoorerie o rĩngĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ndĩrĩkũgoocaga na kĩnanda kĩa mũgeeto","poem":1},{"text":"nĩ ũndũ wa wĩhokeku waku, Wee Ngai wakwa;","poem":2},{"text":"ndĩrĩinaga ngũgoocage na kĩnanda gĩa kĩnũbi,","poem":1},{"lineBreak":true},{"text":"Wee Mũtheru wa Isiraeli.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mĩromo yakwa nĩrĩanagĩrĩra nĩ gũkena","poem":1},{"text":"rĩrĩa ngũina ngũgooce,","poem":2},{"lineBreak":true},{"text":"o niĩ, ũrĩa Wee ũkũũrĩte.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Rũrĩmĩ rwakwa rũrĩrahaga ũhoro wa ciĩko ciaku cia ũthingu","poem":1},{"text":"mũthenya wothe,","poem":2},{"text":"nĩgũkorwo arĩa meendaga kũnjĩka ũũru","poem":1},{"text":"nĩmaconorithĩtio na makarigiicwo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}