{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":77,"content":[{"type":"heading","content":["Kũririkana Ciĩko cia Ngai cia Hinya"]},{"type":"hebrew_subtitle","content":["Thaburi ya Asafu"]},{"type":"verse","number":1,"content":[{"text":"Ndakaĩire Ngai andeithie;","poem":1},{"text":"ndakaĩire Ngai nĩguo anjigue.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Rĩrĩa ndaarĩ mĩnyamaro-inĩ, nĩ Mwathani ndarongoririe;","poem":1},{"text":"ũtukũ ndamwambararĩirie moko itekũnoga,","poem":2},{"lineBreak":true},{"text":"no muoyo wakwa ũkĩrega kũhoorerio.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Wee Ngai, ndakũririkanire ngĩcaaya;","poem":1},{"text":"ndataranirie maũndũ, naguo roho wakwa ũkĩringĩka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wee watũmire njũrwo nĩ toro,","poem":1},{"text":"ngĩthĩĩnĩka mũno, ngĩremwo nĩ kwaria.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndeciiririe ũhoro wa matukũ ma tene,","poem":1},{"text":"ngĩririkana mĩaka o ĩrĩa yarĩ ya tene;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ngĩkĩĩririkania ũrĩa ndainaga ũtukũ,","poem":1},{"text":"ngoro yakwa ĩgĩtarania maũndũ,","poem":2},{"lineBreak":true},{"text":"naguo roho wakwa ũkĩyũũria atĩrĩ:","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Mwathani egũtũũra atũregete nginya tene?","poem":1},{"text":"Ndarĩ hĩndĩ agacooka gũtũkenera?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wendo wake ũtathiraga-rĩ, nĩkũbuĩria ũbuĩrĩtie nginya tene?","poem":1},{"text":"Kĩĩranĩro gĩake gĩgũtũũra gĩtahingĩte nginya tene?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kaĩ Mũrungu ariganĩirwo nĩkũiguanĩra tha?","poem":1},{"text":"Kaĩ marakara make matũmĩte atige gũtugana?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ngĩcooka ngĩĩciiria atĩrĩ, “Ũndũ ũyũ nĩguo ngwĩtiiria naguo:","poem":1},{"text":"kũririkana mĩaka ya guoko kwa ũrĩo kwa Ũrĩa-ũrĩ-Igũrũ-Mũno.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nĩngũririkana ciĩko cia Jehova;","poem":1},{"text":"ĩĩ nĩguo, nĩngũririkana ciama ciaku cia tene.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndĩrĩtaranagia mawĩra maku mothe,","poem":1},{"text":"na ngecũũrania ũhoro wa ciĩko ciaku cia hinya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Njĩra ciaku, Wee Ngai, nĩ theru.","poem":1},{"text":"Nĩ ngai ĩrĩkũ nene ta Ngai witũ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wee nĩwe Mũrungu ũrĩa ũringaga ciama;","poem":1},{"text":"wonanagia ũhoti waku kũrĩ ndũrĩrĩ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nĩwakũũrire andũ aku na guoko gwaku kwa hinya,","poem":1},{"text":"o acio njiaro cia Jakubu na Jusufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Maaĩ nĩmakuonire, Wee Ngai,","poem":1},{"text":"maaĩ macio maakuonire makĩigua guoya,","poem":2},{"lineBreak":true},{"text":"nakuo kũrĩa kũriku mũno gũkĩĩnyogonda.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Matu mooiririe mbura,","poem":1},{"text":"nacio ngwa ikĩruruma igũrũ guothe;","poem":2},{"lineBreak":true},{"text":"heni ciahenũkire ikĩrathũka mĩena yothe","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngwa yaku yaiguĩkanire kĩhuhũkanio-inĩ,","poem":1},{"text":"rũheni rwaku rũkĩmũrĩka thĩ yothe,","poem":2},{"lineBreak":true},{"text":"nayo thĩ ĩkĩinaina na ĩgĩthingitha.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Njĩra yaku yatuĩkanĩirie iria-inĩ,","poem":1},{"text":"njĩra yaku ĩgĩtuĩkanĩria maaĩ-inĩ maingĩ,","poem":2},{"lineBreak":true},{"text":"o na gũtuĩka makinya maku mationekire.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Watongoririe andũ aku o ta ũrĩa mũrĩithi atongoragia rũũru,","poem":1},{"text":"ũkĩmatongoria na guoko kwa Musa na kwa Harũni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}