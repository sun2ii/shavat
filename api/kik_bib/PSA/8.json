{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":8,"content":[{"type":"heading","content":["Ũũmbi Wonanagia Riiri wa Ngai"]},{"type":"hebrew_subtitle","content":["Thaburi ya Daudi"]},{"type":"verse","number":1,"content":[{"text":"Wee Jehova, o Wee Mwathani witũ,","poem":1},{"text":"kaĩ rĩĩtwa rĩaku nĩ inene gũkũ thĩ yothe-ĩ!","poem":2},{"lineBreak":true},{"text":"Nĩũigĩte riiri waku o igũrũ matu-inĩ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nĩũtũmĩte rũgooco ruume tũnua-inĩ twa ciana na twa ngenge,","poem":1},{"lineBreak":true},{"text":"nĩ tondũ wa thũ ciaku,","poem":1},{"text":"nĩguo ũkirie ũrĩa ũrĩ muku nawe o na mwĩrĩhĩria.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Rĩrĩa ndecũũrania ũhoro ũkoniĩ igũrũ rĩu rĩaku,","poem":1},{"text":"ngoona wĩra wa ciara ciaku,","poem":2},{"text":"mweri na njata icio wĩkĩrĩte kuo-rĩ,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"mũndũ akĩrĩ kĩ tondũ ũikaraga ũkĩmwĩciiragia,","poem":1},{"text":"nake mũrũ wa mũndũ akĩrĩ kĩ atĩ nĩkĩo ũmũmenyagĩrĩra?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Watũmire atigie o hanini aiganane nawe,","poem":1},{"text":"na ũkĩmũhumba thũmbĩ ya riiri o na gĩtĩĩo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wamũtuire wa gwathaga mawĩra ma moko maku;","poem":1},{"text":"ũkĩiga indo ciothe rungu rwa makinya make:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ndũũru ciothe cia mbũri na cia ngʼombe,","poem":1},{"text":"na nyamũ cia gĩthaka,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"na nyoni cia rĩera-inĩ,","poem":1},{"text":"na thamaki cia iria-inĩ,","poem":2},{"lineBreak":true},{"text":"na kĩrĩa gĩothe kĩgeragĩra kũu iria-inĩ thĩinĩ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Wee Jehova, o Wee Mwathani witũ,","poem":1},{"text":"kaĩ rĩĩtwa rĩaku nĩ inene gũkũ thĩ yothe-ĩ!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}