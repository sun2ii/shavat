{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":80,"content":[{"type":"heading","content":["Kũhoera Rũrĩrĩ Rũgaacĩre Rĩngĩ"]},{"type":"hebrew_subtitle","content":["Thaburi ya Asafu"]},{"type":"verse","number":1,"content":[{"text":"Wee Mũrĩithi wa Isiraeli, tũigue,","poem":1},{"text":"o Wee ũtongoragia Jusufu ta ũrĩa mũrĩithi atongoragia rũũru;","poem":2},{"text":"Wee ũikarĩire gĩtĩ kĩa ũnene gatagatĩ ka makerubi-rĩ, cangarara","poem":1}]},{"type":"verse","number":2,"content":[{"text":"ũrĩ mbere ya Efiraimu, na Benjamini, na Manase.","poem":2},{"noteId":17},{"text":"Arahũra ũhoti waku,","poem":1},{"text":"ũũke ũtũhonokie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Wee Ngai-rĩ, tũma tũgaacĩre rĩngĩ;","poem":1},{"text":"tũma ũthiũ waku ũtwarĩre,","poem":2},{"lineBreak":true},{"text":"nĩguo tũhonoke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wee Jehova Ngai mwene hinya wothe,","poem":1},{"text":"marakara maku megũtooga nginya rĩ","poem":2},{"lineBreak":true},{"text":"ũgĩũkĩrĩra mahooya ma andũ aku?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nĩũmahũũnĩtie na irio cia maithori;","poem":1},{"text":"ũtũmĩte manyue maithori maiyũrĩte mbakũri riita.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ũtũtuĩte kĩndũ gĩa kũrũagĩrwo nĩ arĩa tũriganĩtie nao,","poem":1},{"text":"nacio thũ ciitũ igatũnyũrũria.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wee Ngai-Mwene-Hinya-Wothe-rĩ, tũma tũgaacĩre rĩngĩ;","poem":1},{"text":"tũma ũthiũ waku ũtwarĩre,","poem":2},{"lineBreak":true},{"text":"nĩguo tũhonoke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Wareehire mũthabibũ kuuma bũrũri wa Misiri;","poem":1},{"text":"warutũrũrire ndũrĩrĩ ũkĩũhaanda arĩ guo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nĩwaũthereirie mũgũnda,","poem":1},{"text":"naguo ũkĩgwata, na ũkĩiyũra bũrũri wothe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Irĩma nĩciahumbĩrirwo nĩ kĩĩruru kĩaguo,","poem":1},{"text":"nayo mĩtarakwa ĩrĩa mĩnene ĩkĩhumbĩrwo nĩ honge ciaguo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Watambũrũkirie honge ciaguo o nginya Iria-inĩ rĩrĩa Inene,","poem":1},{"text":"na thuuna ciaguo ũgĩcikinyia o nginya Rũũĩ-inĩ rwa Farati.","poem":2},{"noteId":18}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nĩ kĩĩ gĩtũmĩte ũmomore njirigo ciaguo,","poem":1},{"text":"ũgagĩtũma ehĩtũkĩri othe matuage thabibũ ciaguo?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ũrangarangagwo nĩ ngũrwe cia gĩthaka,","poem":1},{"text":"na ũkarĩĩo nĩ nyamũ cia werũ-inĩ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wee Ngai Mwene-Hinya-Wothe, tũcookerere!","poem":1},{"text":"Rora ũrĩ igũrũ wone!","poem":2},{"text":"Rũmbũiya mũthabibũ ũyũ,","poem":1}]},{"type":"verse","number":15,"content":[{"text":"mũri ũrĩa guoko gwaku kwa ũrĩo kwahaandire,","poem":2},{"lineBreak":true},{"text":"mũriũ ũrĩa wee mwene wĩrereire.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mũthabibũ waku nĩũtemetwo, ũgacinwo na mwaki;","poem":1},{"text":"thũ ciaku irothira nĩ ũndũ wa irũithia rĩaku.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Guoko gwaku kũroikara na mũndũ ũrĩa ũrĩ guoko-inĩ gwaku kwa ũrĩo,","poem":1},{"text":"ũcio mũrũ wa mũndũ wĩrereire wee mwene.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"No ithuĩ-rĩ, tũtigatigana nawe o rĩ;","poem":1},{"text":"tũrurumũkie na nĩtũrĩkayagĩra rĩĩtwa rĩaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Wee Jehova Ngai Mwene-Hinya-Wothe, tũma tũgaacĩre rĩngĩ;","poem":1},{"text":"tũma ũthiũ waku ũtwarĩre,","poem":2},{"lineBreak":true},{"text":"nĩguo tũhonoke.","poem":2}]}],"footnotes":[{"noteId":17,"caller":"+","text":"Mĩhĩrĩga ĩno ĩtatũ yarĩ njiarwa cia Rakeli, na nĩcio ciarĩ cia mbere kũrũmĩrĩra ithandũkũ rĩa kĩrĩkanĩro rĩrĩa Isiraeli mangĩoimagarire marĩ werũ-inĩ.","reference":{"chapter":80,"verse":2}},{"noteId":18,"caller":"+","text":"Ũthamaki wa Daudi na Solomoni woimĩte Iria rĩrĩa Inene nginya Rũũĩ rwa Farati.","reference":{"chapter":80,"verse":11}}]},"thisChapterLink":"/api/kik_bib/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}