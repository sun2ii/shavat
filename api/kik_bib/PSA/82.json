{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"heading","content":["Kũhooya Ciira wa Kĩhooto"]},{"type":"hebrew_subtitle","content":["Thaburi ya Asafu"]},{"type":"verse","number":1,"content":[{"text":"Ngai arũgamĩte kĩũngano-inĩ kĩrĩa kĩnene;","poem":1},{"text":"aratuĩra “ngai” ciira arĩ gatagatĩ ga cio.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Nĩ nginya rĩ mũgũtũũra mũciiragĩrĩra andũ arĩa matarũgamagĩrĩra kĩhooto,","poem":1},{"text":"na mũgatĩĩra arĩa aaganu maũthĩ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Ciiragĩrĩrai kĩhooto kĩa arĩa matarĩ hinya na arĩa matarĩ maithe;","poem":1},{"text":"tũũriai ihooto cia andũ arĩa athĩĩni o na arĩa ahinyĩrĩrie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hatũragai arĩa matarĩ hinya na arĩa abatari;","poem":1},{"text":"mateithũrei kuuma moko-inĩ ma arĩa aaganu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Andũ acio matirĩ ũndũ mooĩ, na matirĩ ũndũ makũũranaga.","poem":1},{"text":"Macangacangaga nduma-inĩ;","poem":2},{"lineBreak":true},{"text":"mĩthingi yothe ya thĩ nĩyenyenyete.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Ndoigire atĩrĩ, ‘Inyuĩ mũrĩ “ngai”;","poem":1},{"text":"inyuothe mũrĩ ariũ a Ũrĩa-ũrĩ-Igũrũ-Mũno.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"No mũgaakua o ta ũrĩa andũ makuuaga;","poem":1},{"text":"mũkaagũa o ta aathani arĩa angĩ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Arahũka, Wee Ngai, ũtuĩre thĩ ciira,","poem":1},{"text":"nĩgũkorwo ndũrĩrĩ ciothe nĩ igai rĩaku.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}