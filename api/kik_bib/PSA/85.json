{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":85,"content":[{"type":"heading","content":["Ihooya rĩa kũũria Ũtugi wa Ngai"]},{"type":"hebrew_subtitle","content":["Thaburi ya Ariũ a Kora"]},{"type":"verse","number":1,"content":[{"text":"Wee Jehova, nĩ wekire bũrũri waku wega;","poem":1},{"text":"nĩwacookeirie Jakubu ũtonga wake.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nĩwarekeire andũ aku waganu wao,","poem":1},{"text":"na ũkĩhumbĩra mehia mao mothe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nĩweheririe mangʼũrĩ maku mothe,","poem":1},{"text":"na ũgĩthirwo nĩ marakara maku mahiũ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tũma tũgaacĩre rĩngĩ, Wee Ngai Mũhonokia witũ,","poem":1},{"text":"na ũtige gũikara ũtũrakarĩire.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ũgũtũũra ũtũrakarĩire nginya tene?","poem":1},{"text":"Marakara maku megũkinyĩra njiarwa na njiarwa?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kaĩ ũtangĩtũrurumũkia ngoro ciitũ,","poem":1},{"text":"nĩguo andũ aku magũkenere?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wee Jehova-rĩ, tuonie wendo waku ũrĩa ũtathiraga,","poem":1},{"text":"na ũtũhe ũhonokio waku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nĩngũthikĩrĩria njigue ũrĩa Mũrungu, o we Jehova, ekuuga;","poem":1},{"text":"eranagĩra thayũ kũrĩ andũ ake, o acio ake aamũre:","poem":2},{"lineBreak":true},{"text":"no ndũkareke macookerere ũrimũ wao.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ti-itherũ ũhonokio wake ũrĩ hakuhĩ na arĩa mamwĩtigĩrĩte,","poem":1},{"text":"nĩgeetha riiri wake ũtũũre bũrũri-inĩ witũ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Wendo na wĩhokeku nĩicemanĩtie;","poem":1},{"text":"ũthingu na thayũ nĩikĩmumunyanĩte.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wĩhokeku ũkunũkaga kuuma na thĩ,","poem":1},{"text":"naguo ũthingu ũcũthagĩrĩrie ũrĩ o igũrũ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ti-itherũ Jehova no aheane kĩndũ o gĩothe kĩega,","poem":1},{"text":"naguo bũrũri witũ ũciarage magetha maguo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ũthingu nĩguo ũmũthiiaga mbere,","poem":1},{"text":"ũkahaaragĩria makinya make njĩra.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}