{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":86,"content":[{"type":"heading","content":["Ihooya rĩa Ũteithio wa gũtooria Thũ"]},{"type":"hebrew_subtitle","content":["Ihooya rĩa Daudi"]},{"type":"verse","number":1,"content":[{"text":"Wee Jehova, njigua na ũnjĩtĩke,","poem":1},{"text":"nĩgũkorwo ndĩ mũthĩĩni na mũbatari.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gitĩra muoyo wakwa,","poem":1},{"text":"nĩgũkorwo nĩndĩheanĩte harĩwe.","poem":2},{"text":"Wee nĩwe Ngai wakwa;","poem":1},{"text":"honokia ndungata yaku ĩno ĩkwĩhokete.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Njiguĩra tha, Wee Mwathani,","poem":1},{"text":"nĩgũkorwo ngũkayagĩra mũthenya wothe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"He ndungata yaku gĩkeno,","poem":1},{"text":"nĩgũkorwo nĩ kũrĩ we, Wee Mwathani,","poem":2},{"lineBreak":true},{"text":"ndorereirie ngoro yakwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nĩgũkorwo Wee Mwathani ũrĩ mwega na nĩũrekanagĩra,","poem":1},{"text":"ũkaingĩhia wendo kũrĩ arĩa othe magũkayagĩra.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Igua ihooya rĩakwa, Wee Jehova;","poem":1},{"text":"thikĩrĩria ikaya rĩakwa ũnjiguĩre tha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mũthenya ũrĩa ngaakorwo na thĩĩna nĩngagũkaĩra,","poem":1},{"text":"nĩgũkorwo nĩũkanjĩtĩka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Wee Mwathani, thĩinĩ wa ngai ciothe gũtirĩ ĩngĩ tawe;","poem":1},{"text":"gũtirĩ ciĩko ingĩhaananio na ciaku.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndũrĩrĩ ciothe iria ũmbĩte","poem":1},{"text":"nĩigooka igũthathaiye irĩ mbere yaku, Wee Mwathani;","poem":2},{"lineBreak":true},{"text":"nĩikarehera rĩĩtwa rĩaku riiri.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nĩgũkorwo Wee ũrĩ mũnene, na nĩwĩkaga ciĩko cia kũgegania;","poem":1},{"text":"Wee wiki nowe Ngai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Wee Jehova, nyonagĩrĩria njĩra ciaku,","poem":1},{"text":"nĩgeetha thiiage na mĩthiĩre ya ma;","poem":2},{"text":"he ngoro ĩĩrutĩire kũna,","poem":1},{"text":"nĩguo ndĩĩtigagĩre rĩĩtwa rĩaku.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nĩndĩrĩkũgoocaga na ngoro yakwa yothe,","poem":1},{"text":"Wee Mwathani Ngai wakwa;","poem":2},{"lineBreak":true},{"text":"ngũtũũra ngumagia rĩĩtwa rĩaku nginya tene.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nĩgũkorwo wendo waku nĩ mũnene harĩ niĩ;","poem":1},{"text":"nĩũndeithũrĩte kuuma mbĩrĩra-inĩ o kũrĩa kũriku mũno.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Wee Ngai, andũ arĩa etĩĩi nĩmaraatharĩkĩra;","poem":1},{"text":"gĩkundi kĩa andũ matarĩ tha nĩmaracaria muoyo wakwa,","poem":2},{"lineBreak":true},{"text":"o andũ acio matakũrũmbũyagia.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"No Wee, Wee Mwathani, ũrĩ Mũrungu mũigua tha na ũrĩ mũtugi,","poem":1},{"text":"ndũhiũhaga kũrakara, na ũiyũrĩtwo nĩ wendo na wĩhokeku.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wĩhũgũre ũndore na ũnjiguĩre tha;","poem":1},{"text":"he ndungata ĩno yaku hinya waku,","poem":2},{"lineBreak":true},{"text":"na ũhonokie mũriũ wa ndungata yaku ya mũndũ-wa-nja.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nyonia kĩmenyithia kĩa wega waku,","poem":1},{"text":"nĩguo thũ ciakwa ikĩone iconorithio,","poem":2},{"lineBreak":true},{"text":"nĩgũkorwo Wee, Wee Jehova, nĩũndeithĩtie na ũkaahooreria.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}