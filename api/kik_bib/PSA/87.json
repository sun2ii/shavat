{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"heading","content":["Gĩkeno gĩa Gũtũũra Zayuni"]},{"type":"hebrew_subtitle","content":["Thaburi ya Ariũ a Kora"]},{"type":"verse","number":1,"content":[{"text":"Nĩahaandĩte mũthingi wa itũũra rĩake igũrũ rĩa kĩrĩma kĩrĩa kĩamũre;","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Jehova nĩendete ihingo cia Zayuni","poem":2},{"lineBreak":true},{"text":"gũkĩra ciikaro iria ingĩ ciothe cia Jakubu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Maũndũ mega nĩmaragio igũrũ rĩaku,","poem":1},{"text":"wee itũũra inene rĩa Ngai:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Nĩngwandĩka ũhoro wa Rahabu na wa Babuloni","poem":1},{"text":"thĩinĩ wa arĩa manjũũĩ,","poem":2},{"text":"Filistia o nakuo, na Turo, hamwe na Kushi,","poem":1},{"text":"njuge atĩrĩ, ‘Ũyũ aaciarĩirwo Zayuni.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ti-itherũ, ũhoro wa Zayuni ũkĩario nĩgũkagwetagwo atĩrĩ,","poem":1},{"text":"“Ũyũ o na ũũrĩa maaciarĩirwo kuo,","poem":2},{"lineBreak":true},{"text":"na Ũrĩa-ũrĩ-Igũrũ-Mũno we mwene nĩagatũma gũtũũre kũrĩ kũrũmu.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Jehova nĩakandĩka ibuku-inĩ rĩa kĩrĩndĩ ũũ:","poem":1},{"text":"“Ũyũ aaciarĩirwo Zayuni.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nao magĩtunga nyĩmbo makaina atĩrĩ,","poem":1},{"text":"“Ithima ciakwa ciothe irĩ thĩinĩ waku.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}