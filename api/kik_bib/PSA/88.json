{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":88,"content":[{"type":"heading","content":["Ihooya rĩa kũũria Ũteithio Hĩndĩ ya Kũhinyĩrĩrĩka"]},{"type":"hebrew_subtitle","content":["Thaburi ya Ariũ a Kora"]},{"type":"verse","number":1,"content":[{"text":"Wee Jehova, o Wee Ngai ũrĩa ũũhonokagia,","poem":1},{"text":"ngũkayagĩra mũthenya na ũtukũ ndĩ mbere yaku.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ihooya rĩakwa rĩrokinya harĩwe;","poem":1},{"text":"inamĩrĩria gũtũ gwaku ũigue gũkaya gwakwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nĩgũkorwo muoyo wakwa ũiyũrĩtwo nĩ thĩĩna,","poem":1},{"text":"na niĩ ngirie gũkua.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Niĩ ndaranĩirio na arĩa makiriĩ gũkua;","poem":1},{"text":"haana ta mũndũ ũtarĩ na hinya.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Niĩ njiganĩirio na arĩa akuũ,","poem":1},{"text":"o ta arĩa moragĩtwo magakoma mbĩrĩra,","poem":2},{"text":"o acio ũtacookaga kũririkana,","poem":1},{"text":"arĩa meheretio kuuma ũmenyereri-inĩ waku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ũnjikĩtie irima rĩrĩa iriku mũno,","poem":1},{"text":"o kũu kũriku kũrĩ nduma ndumanu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mangʼũrĩ maku nĩmanditũhĩire mũno;","poem":1},{"text":"nĩũũhubĩkanĩtie na ndiihũ ciaku ciothe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nĩũnjehereirie arata akwa arĩa twendanĩte mũno,","poem":1},{"text":"na ũgatũma nduĩke kĩndũ kĩrĩ magigi harĩo.","poem":2},{"text":"Ndĩĩmũhingĩrĩrie ndingĩhota kũũra;","poem":1}]},{"type":"verse","number":9,"content":[{"text":"maitho makwa nĩmaroora nĩ kĩeha.","poem":2},{"lineBreak":true},{"text":"Wee Jehova, ngũkayagĩra o mũthenya;","poem":1},{"text":"ngũtambũrũkagĩria moko makwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Andũ arĩa akuũ-rĩ, wee nĩũmonagia magegania maku?","poem":1},{"text":"Acio makuĩte-rĩ, nĩmarahũkaga, magakũgooca?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wendo waku nĩumbũragwo mbĩrĩra-inĩ,","poem":1},{"text":"kana wĩhokeku waku ũgakiumbũrwo Mwanangĩko-inĩ?","poem":2},{"noteId":20}]},{"type":"verse","number":12,"content":[{"text":"Magegania maku nĩmonagwo kũndũ kũu kwa nduma,","poem":1},{"text":"kana ciĩko ciaku cia ũthingu ikamenyeka","poem":2},{"lineBreak":true},{"text":"bũrũri-inĩ ũcio wa kĩriganĩro?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"No nĩngũgũkaĩra ũndeithie, Wee Jehova;","poem":1},{"text":"rũciinĩ mahooya makwa mokaga harĩwe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wee Jehova, nĩ kĩĩ gĩtũmĩte ũndiganĩrie","poem":1},{"text":"na ũkaahitha ũthiũ waku?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kuuma o ũnini wakwa ndũũrĩte nyamarĩtio na ngakuhĩrĩria gĩkuũ;","poem":1},{"text":"nĩnyamaarĩkĩte nĩ imakania ciaku, igatũma njage mwĩhoko.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mangʼũrĩ maku nĩmahubĩkanĩtie,","poem":1},{"text":"nacio imakania ciaku ikanyananga.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Maathiũrũrũkagĩria mũthenya wothe ta mũiyũro wa maaĩ;","poem":1},{"text":"hingĩrĩirio nĩmo na mĩena yothe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nĩũnjehereirie athiritũ akwa na arĩa nyendete;","poem":1},{"text":"nduma nĩyo mũrata wakwa ũrĩa ũnguhĩrĩirie mũno.","poem":2}]}],"footnotes":[{"noteId":20,"caller":"+","text":"Nĩ Abadoni na Kĩhibirania","reference":{"chapter":88,"verse":11}}]},"thisChapterLink":"/api/kik_bib/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}