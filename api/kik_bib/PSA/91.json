{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":91,"content":[{"type":"heading","content":["Ngai Nĩwe Mũgitĩri Witũ"]},{"type":"verse","number":1,"content":[{"text":"Mũndũ ũrĩa ũikaraga agitĩirwo nĩ Ũrĩa-ũrĩ-Igũrũ-Mũno","poem":1},{"text":"arĩhurũkaga kĩĩruru-inĩ kĩa Mwene-Hinya-Wothe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngũkiuga ũhoro wa Jehova atĩrĩ,","poem":1},{"text":"“Wee nĩwe rĩũrĩro rĩakwa na kĩirigo gĩakwa kĩrĩ hinya,","poem":2},{"lineBreak":true},{"text":"nĩwe Ngai wakwa, ũrĩa ndĩĩhokete.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ti-itherũ nĩegũgũteithũra gĩkerenge-inĩ kĩa mũtegi,","poem":1},{"text":"o na kuuma mũrimũ-inĩ ũrĩa mũũru wa kũũraga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Arĩkũhumbagĩra na njoya ciake,","poem":1},{"text":"na rungu rwa mathagu make nĩho ũrĩĩgitagia;","poem":2},{"lineBreak":true},{"text":"wĩhokeku wake nĩũgatuĩka ngo yaku na kĩĩhitho gĩaku.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndũrĩĩtigagĩra imakania cia ũtukũ,","poem":1},{"text":"kana mũguĩ ũrĩa ũthĩrĩrĩkaga mũthenya,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"o na kana mũrimũ ũrĩa ũceemaga nduma-inĩ,","poem":1},{"text":"kana mũthiro ũrĩa ũniinanaga mũthenya gatagatĩ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Andũ ngiri no magũe mwena waku,","poem":1},{"text":"nao ngiri ikũmi magũe guoko-inĩ gwaku kwa ũrĩo,","poem":2},{"lineBreak":true},{"text":"no ndũngĩkuhĩrĩrio nĩguo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wee no kwĩrorera ũkerorera na maitho maku","poem":1},{"text":"wĩonere iherithia rĩa andũ arĩa aaganu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ũngĩtua Ũrĩa-ũrĩ-Igũrũ-Mũno gĩikaro gĩaku,","poem":1},{"text":"o we Jehova, ũrĩa arĩ we rĩũrĩro rĩakwa,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"hĩndĩ ĩyo gũtirĩ ũũru ũgaagũkorerera,","poem":1},{"text":"gũtirĩ mwanangĩko ũgaakuhĩrĩria hema yaku.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nĩgũkorwo nĩagaatha araika ake nĩ ũndũ waku,","poem":1},{"text":"makũgitagĩre mĩthiĩre-inĩ yaku yothe;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"nĩmagakuoya na igũrũ na moko mao","poem":1},{"text":"nĩgeetha ndũkaringwo kũgũrũ nĩ ihiga.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nĩũgakinyĩrĩria mũrũũthi, o na nduĩra;","poem":1},{"text":"ũkarangĩrĩria mũrũũthi ũrĩa mũnene, o na nyoka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Jehova ekuuga atĩrĩ, “Kuona atĩ nĩanyendete,","poem":1},{"text":"nĩngamũhatũra hatĩka-inĩ;","poem":2},{"lineBreak":true},{"text":"nĩndĩrĩmũgitagĩra, nĩgũkorwo nĩamenyete rĩĩtwa rĩakwa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Arĩngayagĩra, na niĩ ngamwĩtĩka;","poem":1},{"text":"ndĩrĩkoragwo hamwe nake hĩndĩ ya thĩĩna,","poem":2},{"lineBreak":true},{"text":"ndĩrĩmũteithũraga na ngamũtĩĩithia.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ngũmũtũũria muoyo matukũ maingĩ nginya aiganie,","poem":1},{"text":"na ndĩmuonagie ũhonokio wakwa.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}