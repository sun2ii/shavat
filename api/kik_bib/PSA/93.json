{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"heading","content":["Ũkaru wa Wathani wa Ngai"]},{"type":"verse","number":1,"content":[{"text":"Jehova nĩarathamaka, ehumbĩte ũkaru;","poem":1},{"text":"Jehova ehumbĩte ũkaru","poem":2},{"lineBreak":true},{"text":"na akeoha hinya ta mũcibi.","poem":2},{"text":"Thĩ nĩĩhaandĩtwo ĩkarũma ki,","poem":1},{"text":"ndĩrĩ hĩndĩ ĩngĩenyenyeka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gĩtĩ gĩaku kĩa ũnene gĩtũũrĩte kĩrĩ kĩrũmu kuuma o tene;","poem":1},{"text":"wee ũtũũrĩte kuo kuuma tene na tene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Wee Jehova-rĩ, maria nĩmaranĩrĩra,","poem":1},{"text":"maria maranĩrĩra na mĩgambo yamo;","poem":2},{"lineBreak":true},{"text":"maria maranĩrĩra makahũũrithia makũmbĩ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"We nĩarĩ hinya gũkĩra makũmbĩ ma iria,","poem":1},{"text":"arĩ hinya gũkĩra marurumĩ macio ma maaĩ maingĩ,","poem":2},{"lineBreak":true},{"text":"Jehova arĩ igũrũ nĩ arĩ hinya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wee Jehova, mawatho maku maikaraga marĩ marũmu;","poem":1},{"text":"naguo ũtheru ũgũtũũra ũgemetie nyũmba yaku","poem":2},{"lineBreak":true},{"text":"matukũ matarĩ mũthia.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}