{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"heading","content":["Ngai Nĩwe wathaga Thĩ Yothe"]},{"type":"verse","number":1,"content":[{"text":"Inĩrai Jehova rwĩmbo rwerũ,","poem":1},{"text":"nĩgũkorwo nĩekĩte maũndũ ma kũgegania;","poem":2},{"text":"guoko gwake kwa ũrĩo na gĩcoka gĩake gĩtheru","poem":1},{"text":"nĩcio imũhonokanĩirie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jehova nĩamenyithanĩtie ũhonokio wake","poem":1},{"text":"na akaguũria ũthingu wake kũrĩ andũ a ndũrĩrĩ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nĩaririkanĩte wendo wake","poem":1},{"text":"na wĩhokeku wake ũrĩa erĩire nyũmba ya Isiraeli;","poem":2},{"text":"ituri ciothe cia thĩ nĩcionete","poem":1},{"text":"ũhonokanio wa Ngai witũ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Anĩrĩrai mũkenete mũrĩ mbere ya Jehova, inyuĩ andũ othe a thĩ,","poem":1},{"text":"tumũkai mũkenũrũrũke na nyĩmbo mũkĩinaga;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"inĩrai Jehova na kĩnanda kĩa mũgeeto,","poem":1},{"text":"mũmũinĩre na kĩnanda kĩa mũgeeto","poem":2},{"lineBreak":true},{"text":"o na mũgambo ũrĩa mwega mũno,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"inai na tũrumbeta, na mũgambo wa coro:","poem":1},{"text":"anĩrĩrai na gĩkeno mũrĩ mbere ya Jehova, o ũcio Mũthamaki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Iria rĩrĩa inene nĩrĩrurume, na kĩrĩa gĩothe kĩrĩ thĩinĩ warĩo,","poem":1},{"text":"mabũrũri mothe, na arĩa othe matũũraga kuo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Njũũĩ nacio nĩikĩhũũre hĩ,","poem":1},{"text":"o nacio irĩma nĩciine hamwe nĩ gũkena;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"nĩciine irĩ mbere ya Jehova,","poem":1},{"text":"nĩgũkorwo nĩarooka nĩguo athamakĩre thĩ.","poem":2},{"text":"Agatuĩra mabũrũri ciira na ũthingu,","poem":1},{"text":"nakĩo kĩrĩndĩ agĩtuithanagie na werekereru.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}