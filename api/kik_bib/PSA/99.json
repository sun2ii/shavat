{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"PSA","translationId":"kik_bib","name":"Thaburi","commonName":"Thaburi","title":"THABURI","order":19,"numberOfChapters":150,"sha256":"61f32a3e34d2c2c836cbf01ea46a8e69b99156a293ec292979e9f9e8f5fe4cc0","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kik_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"heading","content":["Kũgooca Ngai nĩ ũndũ wa Ũthingu Wake"]},{"type":"verse","number":1,"content":[{"text":"Jehova nĩarathamaka,","poem":1},{"text":"ndũrĩrĩ nĩcikĩinaine;","poem":2},{"text":"aikarĩire gĩtĩ kĩa ũnene arĩ gatagatĩ ka makerubi,","poem":1},{"text":"thĩ nĩĩthingithe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jehova nĩ mũnene Zayuni;","poem":1},{"text":"nĩatũũgĩrĩte igũrũ rĩa ndũrĩrĩ ciothe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Andũ nĩmakĩgooce rĩĩtwa rĩaku inene na rĩa gwĩtigĩrwo:","poem":1},{"text":"we nĩwe mũtheru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mũthamaki nĩ arĩ hinya, na nĩendete kĩhooto:","poem":1},{"text":"nĩũrũmĩtie ũtuithania wa ciira ũrĩa mwerekereru;","poem":2},{"text":"nĩwĩkĩte maũndũ ma kĩhooto na ma ũthingu","poem":1},{"text":"thĩinĩ wa Jakubu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tũũgĩriai Jehova Ngai witũ,","poem":1},{"text":"na mũmũinamĩrĩre, mũmũhooe mũrĩ gĩturwa-inĩ kĩa makinya make;","poem":2},{"lineBreak":true},{"text":"we nĩwe mũtheru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Musa na Harũni maarĩ amwe a athĩnjĩri-Ngai ake,","poem":1},{"text":"nake Samũeli aarĩ ũmwe wa arĩa maakayagĩra rĩĩtwa rĩake;","poem":2},{"text":"maakayagĩra Jehova","poem":1},{"text":"nake akametĩka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Aamaragĩria arĩ thĩinĩ wa gĩtugĩ kĩa itu;","poem":1},{"text":"makĩrũmia mawatho make","poem":2},{"lineBreak":true},{"text":"na kĩrĩra kĩa watho wake wa kũrũmĩrĩrwo kĩrĩa aamaheete.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Wee Jehova Ngai witũ-rĩ,","poem":1},{"text":"nĩwametĩkaga;","poem":2},{"text":"harĩ Isiraeli warĩ Mũrungu mũrekanĩri,","poem":1},{"text":"o na gũtuĩka nĩwamaherithagia nĩ ũndũ wa ciĩko ciao njũru.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tũũgĩriai Jehova Ngai witũ,","poem":1},{"text":"na mũmũhooyage mũrĩ kĩrĩma-inĩ gĩake kĩamũre,","poem":2},{"lineBreak":true},{"text":"nĩgũkorwo Jehova Ngai witũ nĩ mũtheru.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}