{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"SNG","translationId":"kik_bib","name":"Rwĩmbo","commonName":"Rwĩmbo","title":"RWĨMBO RŨRĨA RWEGA MŨNO","order":22,"numberOfChapters":8,"sha256":"55b0648517293b9ee8b52214ea69d094b03ec5a16a30c86209d80e8e7f029159","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/kik_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Niĩ ndĩ ihũa rĩa Sharoni,","poem":1},{"text":"ningĩ gĩtoka gĩa ituamba-inĩ.","poem":2},{"noteId":3}]},{"type":"verse","number":2,"content":[{"text":"O ta gĩtoka kĩrĩ mĩigua-inĩ-rĩ,","poem":1},{"text":"nĩguo mwendwa wakwa atariĩ arĩ gatagatĩ ka airĩtu arĩa angĩ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O ta mũtĩ wa mũtunda ũrĩ mĩtĩ-inĩ ya gĩthaka-rĩ,","poem":1},{"text":"nĩguo mũnyendi atariĩ arĩ gatagatĩ ka aanake arĩa angĩ.","poem":2},{"text":"Ngenagĩra gũikara kĩĩgunyĩ-inĩ gĩake,","poem":1},{"text":"namo matunda make ngĩmacama njiguaga marĩ mũrĩo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nĩandoonyetie nyũmba nene ĩrĩa ĩrĩĩagĩrwo iruga,","poem":1},{"text":"nayo bendera ĩrĩa ahaicĩtie igũrũ rĩakwa nĩ wendo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Njĩkĩrai hinya na thabibũ iria nyũmithie,","poem":1},{"text":"mũnjerũhĩrie hinya na matunda,","poem":2},{"lineBreak":true},{"text":"nĩ ũndũ ndĩ mũcuce nĩ wendo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Guoko gwake kwa ũmotho akũigĩte rungu rwa mũtwe wakwa,","poem":1},{"text":"nakuo guoko gwake kwa ũrĩo gũkaahĩmbĩria.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inyuĩ aarĩ a Jerusalemu, ndamwĩhĩtithia na thiiya,","poem":1},{"text":"na mĩgoma ya thwariga cia werũ-inĩ atĩrĩ:","poem":2},{"text":"Mũtikoimbuthũre wendo o na kana mũwarahũre,","poem":1},{"text":"o nginya wĩrirĩrie kwarahũka guo mwene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ta thikĩrĩria, ũcio nĩ mwendwa wakwa!","poem":1},{"text":"Ta rora! Ĩĩ nĩwe ũyũ ũroka,","poem":2},{"text":"akĩrũgaga akĩrĩire irĩma-inĩ,","poem":1},{"text":"arooka agĩtũrũhaga tũrĩma-inĩ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mwendwa wakwa ahaana ta thiiya, kana ta thwariga ĩrĩa nyanake.","poem":1},{"text":"Ta kĩrore! Nĩwe ũũrĩa ũrũngiĩ thuutha wa rũthingo rwitũ,","poem":2},{"text":"ararorera ndirica-inĩ,","poem":1},{"text":"agacũthĩrĩria mĩanya-inĩ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mwendwa wakwa aaririe akĩnjĩĩra atĩrĩ,","poem":1},{"text":"“Mũrata wakwa, o wee mũthaka,","poem":2},{"lineBreak":true},{"text":"ũkĩra tũthiĩ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Atĩrĩrĩ! Hĩndĩ ya heho nĩ thiru;","poem":1},{"text":"nayo mbura nĩĩkĩĩte ĩgatiga kuura.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nĩ hĩndĩ mahũa marakunũka thĩ;","poem":1},{"text":"ihinda rĩa kũina nĩikinyu,","poem":2},{"text":"mĩgambo ya ndutura","poem":1},{"text":"nĩĩraiguuo bũrũri-inĩ witũ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mũkũyũ-rĩ, nĩũrutĩte ngũyũ cia mbere;","poem":1},{"noteId":4},{"text":"mĩthabibũ ĩrĩa ĩratumũra kĩro nĩĩraruta mũtararĩko wayo wega.","poem":2},{"text":"Ũkĩra, ũka mũrata wakwa;","poem":1},{"text":"o wee wakwa mũthaka, ũkĩra tũthiĩ.”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndutura yakwa wee ũrĩ mĩatũka-inĩ ya rwaro rwa ihinga,","poem":1},{"text":"kũu ciĩhitho-inĩ cia hurũrũka cia irĩma,","poem":2},{"text":"nyonia ũthiũ waku,","poem":1},{"text":"ta reke njigue mũgambo waku;","poem":2},{"text":"nĩ ũndũ mũgambo waku nĩ mwororo,","poem":1},{"text":"na ũthiũ waku nĩ mũthaka.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tũnyitĩrei mbwe,","poem":1},{"text":"o tũbwe tũu tũnini,","poem":2},{"text":"tũrĩa tũthũkagia mĩgũnda ya mĩthabibũ,","poem":1},{"text":"o mĩthabibũ ĩyo iitũ ĩratumũra kĩro.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mwendwa wakwa nĩ wakwa na niĩ ndĩ wake;","poem":1},{"text":"arĩithagia kũrĩa kũrĩ itoka.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hũndũka nginya rĩrĩa kũrĩĩrura,","poem":1},{"text":"nacio ciĩruru ciirĩrie.","poem":2},{"text":"Hũndũka mwendwa wakwa,","poem":1},{"text":"tuĩka ta thiiya,","poem":2},{"text":"kana ta thwariga nyanake,","poem":1},{"text":"ĩrĩ irĩma-inĩ cia Betheri.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":3,"caller":"+","text":"Gĩtuamba-inĩ gĩa Kĩrĩma gĩa Karimeli nĩ gwakũraga mahũa ma mĩmera ĩtarĩ mĩraihu, na maarĩ ma rangi mwerũ, kana wa ndathi, kana wa ngoikoni.","reference":{"chapter":2,"verse":1}},{"noteId":4,"caller":"+","text":"Kũu Isiraeli mĩkũyũ yaciaraga maita meerĩ mwaka.","reference":{"chapter":2,"verse":13}}]},"thisChapterLink":"/api/kik_bib/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}