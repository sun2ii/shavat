{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"SNG","translationId":"kik_bib","name":"Rwĩmbo","commonName":"Rwĩmbo","title":"RWĨMBO RŨRĨA RWEGA MŨNO","order":22,"numberOfChapters":8,"sha256":"55b0648517293b9ee8b52214ea69d094b03ec5a16a30c86209d80e8e7f029159","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/kik_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Wee mwarĩ wa maitũ o wee mũhiki wakwa, nĩndoka mũgũnda-inĩ wakwa;","poem":1},{"text":"nĩnjookanĩrĩirie manemane makwa na mahuti makwa marĩa mangĩ manungi wega.","poem":2},{"text":"Nĩndĩĩte magua makwa, o na ũũkĩ wakwa;","poem":1},{"text":"nĩnyuĩte ndibei yakwa, o na iria rĩakwa.","poem":2},"Arata",{"text":"Inyuĩ arata-rĩ, rĩai na mũnyue;","poem":1},{"text":"inyuĩ mwendaine-rĩ, nyuai nginya mũiganie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndĩrarĩ toro, no ngoro yakwa nĩĩreiguĩte.","poem":1},{"text":"Ta thikĩrĩria! Mwendwa wakwa nĩararingaringa mũrango, akiugaga atĩrĩ:","poem":2},{"text":"“Mwarĩ wa maitũ, wee mwendwa wakwa, wee ndutura yakwa,","poem":1},{"text":"o wee wakwa ũtarĩ kaũcuuke-rĩ, hingũrĩra.","poem":2},{"text":"Mũtwe wakwa nĩũihũgĩtio nĩ ime,","poem":1},{"text":"njuĩrĩ yakwa ĩkaiyũra ireera rĩa ũtukũ.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nĩndutĩte nguo yakwa ya igũrũ:","poem":1},{"text":"no nginya ndĩmĩĩhumbe rĩngĩ?","poem":2},{"text":"Ningĩ nĩndĩthambĩte magũrũ:","poem":1},{"text":"no nginya ndĩmekĩre gĩko rĩngĩ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mwendwa wakwa araikirie guoko gwake kamwanya-inĩ ka mũrango,","poem":1},{"text":"nayo ngoro yakwa ĩrambĩrĩria kũmwĩrirĩria.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndĩrokĩra kũhingũrĩra mwendwa wakwa,","poem":1},{"text":"moko makwa magĩtaataga manemane,","poem":2},{"text":"nacio ciara ciakwa ikanyũrũrũkia manemane,","poem":1},{"text":"nyiitĩro-inĩ ya mũrango.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndĩrahingũrĩire mwendwa wakwa,","poem":1},{"text":"no mwendwa wakwa ndararĩ ho, nĩarathiĩte;","poem":2},{"lineBreak":true},{"text":"Nayo ngoro yakwa ĩroorwo nĩ hinya nĩ ũndũ wake gũthiĩ.","poem":2},{"text":"Ndĩramwethire, no ndinamuona.","poem":1},{"text":"Ndĩramwĩtire, no ndananjĩtĩka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Arangĩri maranyona","poem":1},{"text":"magĩthiũrũrũka itũũra-inĩ rĩu inene.","poem":2},{"text":"Nao marahũũrire, marandihangia;","poem":1},{"text":"marandunya nguo yakwa ya igũrũ,","poem":2},{"lineBreak":true},{"text":"arangĩri acio a thingo!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Inyuĩ aarĩ aya a Jerusalemu, ndamwĩhĩtithia atĩrĩ:","poem":1},{"text":"mũngĩona mwendwa wakwa-rĩ,","poem":2},{"text":"mũkũmwĩra atĩa?","poem":1},{"text":"Mwĩrei atĩ ndĩ mũcuce nĩ wendo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wee mũthaka gũkĩra andũ-a-nja arĩa angĩ othe-rĩ,","poem":1},{"text":"mwendwa waku aagĩrĩte agakĩra endwa arĩa angĩ na kĩ?","poem":2},{"text":"Mwendwa waku akĩrĩte endwa arĩa angĩ nakĩ,","poem":1},{"text":"nĩguo ũtwĩhĩtithie ũguo?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mwendwa wakwa nĩ mũthaka na agatunĩha,","poem":1},{"text":"nĩekũũranĩte harĩ arũme ngiri ikũmi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mũtwe wake ũhaana ta thahabu theru mũno;","poem":1},{"text":"njuĩrĩ yake ĩrĩ na mĩkumba,","poem":2},{"lineBreak":true},{"text":"na ĩkaira ta ihuru.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Maitho make mahaana ta ma ndutura","poem":1},{"text":"ciũmbĩte tũrũũĩ-inĩ,","poem":2},{"text":"mahaana ta mathambĩtio na iria,","poem":1},{"text":"o ta maigĩtwo wega makaagĩrĩra ta mathaga.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Makai make namo mahaana ta tũmĩgũnda","poem":1},{"text":"tũtumanĩte mahuti manungi wega magĩtararĩka.","poem":2},{"text":"Mĩromo yake no ta itoka igũita manemane.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Moko make mahaana ta thanju cia thahabu,","poem":1},{"text":"itheecereirwo tũhiga-inĩ tũrĩa twĩtagwo thumarati;","poem":2},{"text":"mwĩrĩ wake ũhaana ta mũguongo ũrĩa mũnyorokie,","poem":1},{"text":"ũgemetio na yakuti ĩrĩa theru.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Magũrũ make matariĩ ta itugĩ cia mahiga ma mũthemba wa marimari,","poem":1},{"text":"ihaandĩrĩirwo itina-inĩ cia thahabu ĩrĩa therie.","poem":2},{"text":"Maũthĩ make matariĩ ta Lebanoni,","poem":1},{"text":"agathakara ta mĩtarakwa yakuo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kanua gake akĩaria karĩ mũrĩo mũno;","poem":1},{"text":"we nĩ wa kwendeka biũ.","poem":2},{"text":"Atĩrĩrĩ, ũyũ nĩwe mwendwa wakwa,","poem":1},{"text":"ũyũ nĩwe mũrata wakwa, inyuĩ aarĩ a Jerusalemu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}