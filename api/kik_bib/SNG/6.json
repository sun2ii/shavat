{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"SNG","translationId":"kik_bib","name":"Rwĩmbo","commonName":"Rwĩmbo","title":"RWĨMBO RŨRĨA RWEGA MŨNO","order":22,"numberOfChapters":8,"sha256":"55b0648517293b9ee8b52214ea69d094b03ec5a16a30c86209d80e8e7f029159","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/kik_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Wee mũthaka gũkĩra andũ-a-nja arĩa angĩ othe-rĩ,","poem":1},{"text":"mwendwa waku athiĩte kũ?","poem":2},{"text":"Mwendwa waku arorire na kũ,","poem":1},{"text":"nĩguo tũmũcarie nawe?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mwendwa wakwa aikũrũkire mũgũnda-inĩ wake,","poem":1},{"text":"o tũmĩgũnda-inĩ tũrĩa tũtumanĩte mahuti marĩa manungi wega,","poem":2},{"text":"athiĩte kũrĩithia kũu mĩgũnda-inĩ,","poem":1},{"text":"agĩtuaga mahũa ma itoka.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Niĩ ndĩ wa mwendwa wakwa, nake nĩ wakwa;","poem":1},{"text":"we arĩithagia itoka-inĩ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wee mwendwa wakwa, ũrĩ mũthaka, o ta bũrũri wa Tiriza,","poem":1},{"noteId":8},{"text":"ũrĩ wa kwendeka o ta Jerusalemu,","poem":2},{"lineBreak":true},{"text":"na ũkamakania o ta ita rĩrĩ na bendera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wĩhũgũre na kũngĩ, ũtige kũndora;","poem":1},{"text":"maitho maku nĩmarahoota.","poem":2},{"text":"Njuĩrĩ yaku no ta rũũru rwa mbũri","poem":1},{"text":"rũgĩikũrũka Kĩrĩma kĩa Gileadi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Magego maku mahaana ta rũũru rwa ngʼondu","poem":1},{"text":"ikĩambata ciumĩte gũthambio.","poem":2},{"text":"O ĩmwe yacio ĩrĩ na ihatha rĩayo,","poem":1},{"text":"hatirĩ o na ĩmwe yacio ĩrĩ iiki.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Thĩa ciaku ihaana ta ciatũ igĩrĩ cia itunda rĩa mũkomamanga,","poem":1},{"text":"ikĩonerwo hau taama-inĩ ũcio ũkũhumbĩrĩte ũthiũ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"No gũkorwo na atumia athamaki mĩrongo ĩtandatũ,","poem":1},{"text":"na thuriya mĩrongo ĩnana,","poem":2},{"lineBreak":true},{"text":"na airĩtu gathirange matangĩtarĩka;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"no ndutura yakwa, ũcio wakwa ũtarĩ ũcuuke-rĩ, gũtirĩ ũngĩ mahaanaine,","poem":1},{"text":"nowe mũirĩtu wa nyina wiki,","poem":2},{"lineBreak":true},{"text":"o we gĩtũnio kĩa ũcio mũmũciari.","poem":2},{"text":"Airĩtu maamuonire makĩmwĩta mũrathime;","poem":1},{"text":"nao atumia athamaki o na thuriya makĩmũkumia.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nũũ ũyũ ũroimĩra ta ruoro rũgĩtema,","poem":1},{"text":"athakarĩte ta mweri, na agathera ta riũa,","poem":2},{"lineBreak":true},{"text":"arĩ na ũkengu ta wa njata irũrũnganĩte?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nĩndĩraikũrũkire mũgũnda wa mĩkombokombo,","poem":1},{"text":"ngarore tũmĩtĩ tũrĩa tũmerete kũu gĩtuamba-inĩ,","poem":2},{"text":"nĩguo nyone kana mĩthabibũ nĩĩthundũrĩte,","poem":1},{"text":"o na kana mĩkomamanga nĩĩrutĩte kĩro.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"O na itanamenya ũrĩa gũtariĩ-rĩ,","poem":1},{"text":"merirĩria ma ngoro yakwa marandwara","poem":2},{"lineBreak":true},{"text":"gatagatĩ-inĩ ka ngaari cia mũthamaki cia ita cia andũ aitũ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Cooka, cooka, wee Mũshulamu;","poem":1},{"text":"cooka, cooka, nĩgeetha tũkwĩrorere!","poem":2},"Mwendani",{"text":"Mũkwenda kwĩrorera Mũshulamu ũyũ nĩkĩ,","poem":1},{"text":"taarĩ rwĩmbo rwa Mahanaimu mũreerorera?","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":8,"caller":"+","text":"Itũũra rĩa Tiriza nĩrĩo Jeroboamu aathuurire rĩtuĩke itũũra inene rĩa Ũthamaki wa Gathigathini.","reference":{"chapter":6,"verse":4}}]},"thisChapterLink":"/api/kik_bib/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}