{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"SNG","translationId":"kik_bib","name":"Rwĩmbo","commonName":"Rwĩmbo","title":"RWĨMBO RŨRĨA RWEGA MŨNO","order":22,"numberOfChapters":8,"sha256":"55b0648517293b9ee8b52214ea69d094b03ec5a16a30c86209d80e8e7f029159","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/kik_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"Naarĩ korwo no ũtuĩke ta mũrũ wa maitũ,","poem":1},{"text":"ũrĩa wongire nyondo cia maitũ!","poem":2},{"text":"Hĩndĩ ĩyo, ingĩgũtũnga nja,","poem":1},{"text":"ndaakũmumunya,","poem":2},{"lineBreak":true},{"text":"na gũtirĩ mũndũ o na ũrĩkũ ũngĩĩmena.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ingĩgũtongoria,","poem":1},{"text":"ngũtware nyũmba ya maitũ,","poem":2},{"lineBreak":true},{"text":"ũcio wandutire maũndũ.","poem":2},{"text":"Ingĩkũhe ndibei ĩrĩa njamithie wega ũnyue,","poem":1},{"text":"o yo ngogoyo ya mĩkomamanga yakwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Guoko gwake kwa ũmotho akũigĩte rungu rwa mũtwe wakwa,","poem":1},{"text":"nakuo guoko gwake kwa ũrĩo gũkaahĩmbĩria.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inyuĩ aarĩ a Jerusalemu, ndamwĩhĩtithia atĩrĩ:","poem":1},{"text":"Mũtikoimbuthũre wendo o na kana mũwarahũre,","poem":2},{"lineBreak":true},{"text":"o nginya wĩrirĩrie kwarahũka guo mwene.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nũũ ũyũ ũroka ambatĩte oimĩte werũ-inĩ,","poem":1},{"text":"etiiranĩtie na mwendwa wake?","poem":2},"Mwendwa",{"text":"Rungu-inĩ rwa mũtĩ wa matunda nĩho ndakwarahũrire ũrĩ toro;","poem":1},{"text":"hau nĩho nyũkwa aagĩĩrĩire nda yaku,","poem":2},{"lineBreak":true},{"text":"o hau nĩho ũcio warĩ na ruo rwa kũrũmwo aagũciarĩire.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Njĩkĩra ta mũhũũri ngoro-inĩ yaku,","poem":1},{"text":"ũũhũũre ta mũhũũri guoko-inĩ gwaku;","poem":2},{"text":"amu wendo ũrĩ hinya o ta gĩkuũ,","poem":1},{"text":"ũiru waguo ũmĩtie ngoro o ta mbĩrĩra.","poem":2},{"text":"Ũcinaga o ta mwaki ũrakana,","poem":1},{"text":"na o ta rũrĩrĩmbĩ rũnene mũno rwa Jehova.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Maaĩ maingĩ matingĩhota kũhoria wendo;","poem":1},{"text":"njũũĩ itingĩhota kũũthereria.","poem":2},{"text":"Korwo mũndũ no aheane","poem":1},{"text":"ũtonga wothe wa nyũmba yake nĩ ũndũ wa wendo-rĩ,","poem":2},{"lineBreak":true},{"text":"no kũnyũrũrio ũngĩnyũrũrio o biũ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nĩtũrĩ na kairĩtu ka maitũ,","poem":1},{"text":"nako gatiumĩtie nyondo.","poem":2},{"text":"Tũgeka atĩa nĩ ũndũ wa kairĩtu kau gaitũ,","poem":1},{"text":"mũthenya ũrĩa gagaatuĩka ga kũũrio?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Korwo nĩ rũthingo-rĩ,","poem":1},{"text":"tũngĩaka mĩthiringo mĩraihu na igũrũ ya betha igũrũ rĩako.","poem":2},{"text":"Korwo nĩ mũrango-rĩ,","poem":1},{"text":"tũngĩkahingĩrĩria na mbaũ cia mũtarakwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Niĩ ndĩ rũthingo,","poem":1},{"text":"nacio nyondo ciakwa ihaana ta mĩthiringo mĩraihu na igũrũ.","poem":2},{"text":"Nĩ ũndũ ũcio maitho-inĩ make-rĩ,","poem":1},{"text":"nduĩkĩte o ta mũndũ ũtũmaga aiganĩre.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Solomoni aarĩ na mũgũnda wa mĩthabibũ kũu Baali-Hamoni;","poem":1},{"text":"mũgũnda ũcio wa mĩthabibũ akĩũkomborithia kũrĩ akombori.","poem":2},{"text":"O mũndũ aarĩ arehage cekeri 1,000","poem":1},{"noteId":9},{"text":"cia betha","poem":1},{"text":"nĩ ũndũ wa maciaro maguo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"No mũgũnda wakwa wa mĩthabibũ nĩ wakwa o niĩ nyiki;","poem":1},{"text":"cekeri icio 1,000 nĩ ciaku wee Solomoni;","poem":2},{"lineBreak":true},{"text":"nacio cekeri 200","poem":2},{"noteId":10},{"text":"nĩ cia arĩa marĩmagĩra maciaro maguo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Atĩrĩrĩ, wee ũikaraga mĩgũnda-inĩ","poem":1},{"text":"hamwe na arata a thiritũ yaku,","poem":2},{"lineBreak":true},{"text":"reke o na niĩ njigue mũgambo waku.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Umagara na ihenya mwendwa wakwa,","poem":1},{"text":"ũtuĩke ta thiiya,","poem":2},{"text":"kana ta thwariga nyanake","poem":1},{"text":"ĩrĩ irĩma-inĩ iria ĩrĩ mahuti manungi wega.","poem":2}]}],"footnotes":[{"noteId":9,"caller":"+","text":"nĩ ta kilo ikũmi na ĩmwe na nuthu (11.5)","reference":{"chapter":8,"verse":11}},{"noteId":10,"caller":"+","text":"nĩ ta kilo igĩrĩ na robo (2.25)","reference":{"chapter":8,"verse":12}}]},"thisChapterLink":"/api/kik_bib/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}