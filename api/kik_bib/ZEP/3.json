{"translation":{"id":"kik_bib","name":"Biblica® Kiugo Gĩtheru Kĩa Ngai Kĩhingũre","website":"https://ebible.org/Scriptures/details.php?id=kik","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kik","licenseNotes":null,"shortName":"BIB","englishName":"Kikuyu Bible","language":"kik","textDirection":"ltr","sha256":"d84ee99cae5acc483b4fffe41a26bd533cd6b6fe217f914fa249088974f363ff","availableFormats":["json"],"listOfBooksApiLink":"/api/kik_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31101,"languageName":"Gikuyu","languageEnglishName":"Kikuyu"},"book":{"id":"ZEP","translationId":"kik_bib","name":"Zefania","commonName":"Zefania","title":"ZEFANIA","order":36,"numberOfChapters":3,"sha256":"a8c93e77ab4a54fc7c01792122f850832709817d0463dec7b6e061dfe2fa3490","firstChapterNumber":1,"firstChapterApiLink":"/api/kik_bib/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/kik_bib/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"heading","content":["Mehia ma Jerusalemu"]},{"type":"verse","number":1,"content":[{"text":"Kaĩ itũũra rĩĩrĩ inene rĩa andũ aremi, na rĩgwatĩtio thaahu,","poem":1},{"text":"o na rĩiyũrĩte maũndũ ma kũhinyanĩrĩria rĩrĩ na haaro-ĩ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Rĩtirĩ mũndũ rĩathĩkagĩra, rĩtiĩtĩkagĩra gũtaarwo.","poem":1},{"text":"Rĩtiĩhokaga Jehova, na rĩtikuhagĩrĩria Ngai warĩo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Anene aarĩo mahaana ta mĩrũũthi ĩkũrarama,","poem":1},{"text":"aathani aarĩo mahaana ta njũũi iria icangacangaga hwaĩ-inĩ,","poem":2},{"lineBreak":true},{"text":"gũtirĩ kĩndũ matigagia gĩkinyie rũciinĩ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Anabii aarĩo nĩ etĩĩi;","poem":1},{"text":"nĩ andũ a ungumania.","poem":2},{"text":"Athĩnjĩri-Ngai aarĩo mathaahĩtie handũ-harĩa-haamũre,","poem":1},{"text":"na magathũkia watho.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Jehova ũrĩa ũrĩ thĩinĩ warĩo nĩ mũthingu;","poem":1},{"text":"we ndeekaga ũũru.","poem":2},{"text":"Rũciinĩ o rũciinĩ nĩatuanagĩra ciira na kĩhooto,","poem":1},{"text":"mũthenya o mũthenya ndagaga gwĩka ũguo,","poem":2},{"lineBreak":true},{"text":"no arĩa matarĩ athingu matirĩ thoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Nĩniinĩte ndũrĩrĩ;","poem":1},{"text":"ciĩgitĩro ciao cia hinya nĩ momore.","poem":2},{"text":"Nacio barabara ciao ndũmĩte itiganĩrio,","poem":1},{"text":"gũtirĩ mũndũ ũracigerera.","poem":2},{"text":"Matũũra mao manene nĩmanange;","poem":1},{"text":"gũtirĩ mũndũ o na ũmwe ũtigarĩte, gũtirĩ o na ũmwe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndeerire itũũra rĩu inene atĩrĩ,","poem":1},{"text":"‘Ti-itherũ nĩũkanjĩtigĩra,","poem":2},{"lineBreak":true},{"text":"na wĩtĩkĩre gũtaarwo!’","poem":2},{"text":"Hĩndĩ ĩyo itũũro ciake itikaniinwo,","poem":1},{"text":"o na kana maherithia makwa mamũkore.”","poem":2},{"text":"No o meeriragĩria o gwĩka ũũru","poem":1},{"text":"maũndũ-inĩ mao mothe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nĩ ũndũ ũcio Jehova ekuuga atĩrĩ,","poem":1},{"text":"“Ikarai mũnjetereire,","poem":2},{"text":"mweterere mũthenya ũrĩa ngaarũgama ndute ũira.","poem":1},{"text":"Nĩnduĩte atĩ nĩngacookanĩrĩria ndũrĩrĩ hamwe,","poem":2},{"text":"na nyũnganie mothamaki,","poem":1},{"text":"nĩguo ndĩmaitĩrĩrie mangʼũrĩ makwa,","poem":2},{"text":"nĩmo marakara makwa mahiũ.","poem":1},{"text":"Thĩ yothe nĩĩkaniinwo","poem":2},{"lineBreak":true},{"text":"nĩ mwaki wa marakara ma ũiru wakwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Hĩndĩ ĩyo nĩngatheria mĩromo ya ndũrĩrĩ,","poem":1},{"text":"nĩguo othe makayagĩre rĩĩtwa rĩa Jehova,","poem":2},{"lineBreak":true},{"text":"na mamũtungatagĩre marĩ na ũrũmwe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Andũ akwa arĩa mahurunjũkĩire","poem":1},{"text":"mũrĩmo ũrĩa ũngĩ wa njũũĩ cia Kushi,","poem":2},{"lineBreak":true},{"text":"o acio maahooyaga,","poem":2},{"lineBreak":true},{"text":"nĩmakandehera maruta.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mũthenya ũcio wee ndũgaconorithio","poem":1},{"text":"nĩ ũndũ wa maũndũ mothe marĩa mooru wananjĩka,","poem":2},{"text":"tondũ nĩngeheria arĩa othe makenagĩra mwĩtĩĩo wao,","poem":1},{"text":"ndĩmarute kuuma itũũra-inĩ rĩĩrĩ inene.","poem":2},{"text":"Ndũgacooka gwĩtũũgĩria","poem":1},{"text":"ũrĩ kĩrĩma-inĩ gĩakwa gĩtheru.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"No rĩrĩ, nĩngatigia gatagatĩ-inĩ kanyu","poem":1},{"text":"andũ arĩa ahooreri na enyiihia,","poem":2},{"lineBreak":true},{"text":"arĩa mehokete rĩĩtwa rĩa Jehova.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Matigari ma Isiraeli matigekaga ũũru;","poem":1},{"text":"matikaheenanagia,","poem":2},{"lineBreak":true},{"text":"kana ũhinga woneke tũnua-inĩ twao.","poem":2},{"text":"Makaarĩĩaga na magakoma,","poem":1},{"text":"na gũtirĩ mũndũ ũkaamamakia.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Atĩrĩrĩ, wee Mwarĩ wa Zayuni, ina rwĩmbo;","poem":1},{"text":"o nawe, Isiraeli anĩrĩra!","poem":2},{"text":"Nawe Mwarĩ wa Jerusalemu","poem":1},{"text":"kena na ũcanjamũke na ngoro yaku yothe!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Jehova nĩeheretie ihũũra rĩaku,","poem":1},{"text":"nacio thũ ciaku nĩacingatĩte.","poem":2},{"text":"Jehova mũthamaki wa Isiraeli arĩ hamwe nawe;","poem":1},{"text":"ndũgacooka gwĩtigĩra mwanangĩko rĩngĩ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mũthenya ũcio nĩmakeera Jerusalemu atĩrĩ,","poem":1},{"text":"“Wee Zayuni, ndũgacooke gwĩtigĩra","poem":2},{"lineBreak":true},{"text":"na ndũkaregerie moko maku.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Jehova Ngai waku arĩ hamwe nawe,","poem":1},{"text":"o we ũrĩa ũrĩ hinya wa kũhonokania.","poem":2},{"text":"Nĩarĩgũkenagĩra mũno,","poem":1},{"text":"na nĩarĩkũhooragĩria na wendo wake,","poem":2},{"lineBreak":true},{"text":"agũkũngũĩre akĩinaga nyĩmbo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Kĩeha gĩa ciathĩ iria njathane nĩngamwehereria;","poem":1},{"text":"icio ikoretwo irĩ mũrigo na cia thoni harĩ inyuĩ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hĩndĩ ĩyo nĩngaherithia","poem":1},{"text":"arĩa othe maamũhinyagĩrĩria;","poem":2},{"text":"nĩngahonokia arĩa ithua,","poem":1},{"text":"na njookererie arĩa mahurunjĩtwo.","poem":2},{"text":"Nĩngatũma magĩe igweta na ndĩmagoocithie","poem":1},{"text":"mabũrũri-inĩ mothe kũrĩa manaconorithio.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ihinda rĩu nĩngamũcookanĩrĩria;","poem":1},{"text":"hĩndĩ ĩyo nĩngamũcookia mũciĩ.","poem":2},{"text":"Nĩngatũma mũgĩe igweta na ndĩmũgoocithie","poem":1},{"text":"gatagatĩ-inĩ ka ndũrĩrĩ ciothe cia thĩ,","poem":2},{"text":"hĩndĩ ĩrĩa ngaatũma mũgaacĩre rĩngĩ,","poem":1},{"text":"o mũkĩĩonagĩra na maitho manyu,”","poem":2},{"text":"ũguo nĩguo Jehova ekuuga.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/kik_bib/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kik_bib/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kik_bib/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}