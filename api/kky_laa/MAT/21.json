{"translation":{"id":"kky_laa","name":"Matthew sample","website":"https://ebible.org/Scriptures/details.php?id=kky","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kky","licenseNotes":null,"shortName":"LAA","englishName":"Gugu Yimidhirr Matthew Sample","language":"kky","textDirection":"ltr","sha256":"d8557b5fe980139fd405cecede1cbb2fc50602e2f6c4ac1691cfe4aeefb6fb20","availableFormats":["json"],"listOfBooksApiLink":"/api/kky_laa/books.json","numberOfBooks":1,"totalNumberOfChapters":1,"totalNumberOfVerses":9,"languageName":"Guugu Yimidhirr","languageEnglishName":"Guugu Yimidhirr"},"book":{"id":"MAT","translationId":"kky_laa","name":"Matthew","commonName":"Matthew","title":"Matthew","order":40,"numberOfChapters":1,"sha256":"dd57c9e0641bc3cec52dcc81f569eab9a326febbea065b81c09f7e62c790fdaa","firstChapterNumber":21,"firstChapterApiLink":"/api/kky_laa/MAT/21.json","lastChapterNumber":21,"lastChapterApiLink":"/api/kky_laa/MAT/21.json","totalNumberOfVerses":9},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":["Tana jubaiko Jerusalem kadai je mon Bethphage jubaiko milnkol mantjal Jesus nulu kortiva jerkangāi nangu tegai"]},{"type":"verse","number":2,"content":["nulu koko jerba damangan: “Jubale date jambanai, jura natinujina jemon, jubale mamalma jereman kadeiga kankaltjir gumbin darngal, jina ngato mante."]},{"type":"verse","number":3,"content":["Bama jendu koko batal; ngani? jubale jerba: ‘Master ngantanan tegai’, ujurke nulu tana tegala.”"]},{"type":"verse","number":4,"content":["Jinarana jitaranu, koko propetawai manuputan merilil, nulu jerba:"]},{"type":"verse","number":5,"content":[{"text":"“Nudi koko batala ngutur Sion:","poem":1},{"lineBreak":true},{"text":"Namala master nganu kada nganunka,","poem":1},{"text":"dauun ningankal dagarkar jeremantjir.”","poem":2}]},{"type":"verse","number":6,"content":["Nangu jerkangai datai m balkalkai, wandare Jesus koko banti danangan."]},{"type":"verse","number":7,"content":["Tana mante jereman kankaltjir marar tanangan pirbai dagargar m jitare nangu jemon."]},{"type":"verse","number":8,"content":["Bama warkangamu dambare marar tanangan dutanwai mundal jokungan pinda bantila m najun dutanwai dambare."]},{"type":"verse","number":9,"content":["Bama warkangamu gurir datai m dagalbai. Kadai ganal bantil jerba:",{"text":"“Hosianna jumur David,","poem":1},{"text":"nundu kadai puriwai masterngan,","poem":2},{"text":"Hosianna wankarwai.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kky_laa/MAT/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":null,"nextChapterAudioLinks":null,"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":9}