{"translation":{"id":"klv_wbt","name":"Nasoruan siGot len nasoruan ta Uluveu","website":"https://ebible.org/Scriptures/details.php?id=klv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=klv","licenseNotes":null,"shortName":"WBT","englishName":"Maskelynes NT","language":"klv","textDirection":"ltr","sha256":"b82d64c9afec82f82159c58128ee51fa0da3ddd4a6fd96d01ad3cbe73bf73983","availableFormats":["json"],"listOfBooksApiLink":"/api/klv_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7912,"languageName":"Maskelynes","languageEnglishName":"Maskelynes"},"book":{"id":"MAT","translationId":"klv_wbt","name":"Mattiu","commonName":"Mattiu","title":"Mattiu Na-kel-uri-an tovoi aMattiu totosi","order":40,"numberOfChapters":28,"sha256":"6a567c3a939bece2a89294c7e5b857e4f8cc9b012f58a1b7ca37fdb28426e058","firstChapterNumber":1,"firstChapterApiLink":"/api/klv_wbt/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/klv_wbt/MAT/28.json","totalNumberOfVerses":1065},"chapter":{"number":1,"content":[{"type":"heading","content":["Nǝbathuyah siYesu"]},{"type":"verse","number":1,"content":["Egai evi na-tos-gati-an sua hǝn nǝbathuyah siYesu Kristo, topat len nǝpasusan siTevit, topat len nǝpasusan siApraham:"]},{"type":"verse","number":2,"content":[{"text":"AApraham evi atǝman aIsak.","poem":1},{"lineBreak":true},{"text":"AIsak evi atǝman aJakop,","poem":1},{"lineBreak":true},{"text":"tovi atǝman aJutah mai aṽan aJutah gail.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"AJutah evi atǝman aPeres mai aSerah, analaru tovi aTamar.","poem":1},{"lineBreak":true},{"text":"APeres evi atǝman aHesron.","poem":1},{"lineBreak":true},{"text":"AHesron evi atǝman aRam.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ARam evi atǝman aAmminatap.","poem":1},{"lineBreak":true},{"text":"AAmminatap evi atǝman aNahson,","poem":1},{"text":"tovi atǝman aSalmon.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ASalmon evi atǝman aPoas, anan tovi Rahap.","poem":1},{"lineBreak":true},{"text":"APoas evi atǝman aOpet, anan tovi aRut.","poem":1},{"lineBreak":true},{"text":"AOpet evi atǝman aJesse.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ale aJesse evi atǝman aTevit tovi kiŋ.","poem":1},{"lineBreak":true},{"text":"Ale aTevit evi atǝman aSolomon,","poem":1},{"text":"anan tovi asoan aUriah a m̃o.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ale aSolomon evi atǝman aRehopoam.","poem":1},{"lineBreak":true},{"text":"Ale aRehopoam evi atǝman aApijah.","poem":1},{"lineBreak":true},{"text":"Ale aApijah evi atǝman aAsa.","poem":1},{"noteId":0}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ale aAsa evi atǝman aJehosafat.","poem":1},{"lineBreak":true},{"text":"Ale aJehosafat evi atǝman aJoram.","poem":1},{"lineBreak":true},{"text":"Ale aJoram evi atǝman aUsiah.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ale aUsiah evi atǝman aJotam.","poem":1},{"lineBreak":true},{"text":"Ale aJotam evi atǝman aAhas.","poem":1},{"lineBreak":true},{"text":"Ale aAhas evi atǝman aHesekiah.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ale aHesekiah evi atǝman aManasseh.","poem":1},{"lineBreak":true},{"text":"AManasseh evi atǝman aAmon.","poem":1},{"lineBreak":true},{"text":"Ale aAmon evi atǝman aJosiah.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ale aJosiah evi atǝman aJekoniah","poem":1},{"lineBreak":true},{"text":"mai aṽan gail len nǝboŋ","poem":1},{"text":"lotomap̃ip̃iriah vi Papilon.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Husur nǝmap̃ip̃iriahan vi Papilon:","poem":1},{"lineBreak":true},{"text":"aJekoniah evi atǝman aSealtiel,","poem":1},{"lineBreak":true},{"text":"ale aSealtiel evi atǝman aSeruppapel.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ale aSeruppapel evi atǝman aApiut,","poem":1},{"lineBreak":true},{"text":"tovi atǝman aEliakim.","poem":1},{"lineBreak":true},{"text":"Ale aEliakim evi atǝman aAsor.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"AAsor evi atǝman aSatok.","poem":1},{"lineBreak":true},{"text":"Ale aSatok evi atǝman aAkim.","poem":1},{"lineBreak":true},{"text":"Ale aAkim evi atǝman aEliut.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ale aEliut evi atǝman aEleasar.","poem":1},{"lineBreak":true},{"text":"Ale aEleasar evi atǝman aMattan.","poem":1},{"lineBreak":true},{"text":"Ale aMattan evi atǝman aJakop.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ale aJakop evi atǝman aJosef tovi asoan aMeri,","poem":1},{"text":"topas aYesu, lotokisi hǝn aKristo, aGot totabtabuh lan.","poem":2}]},{"type":"verse","number":17,"content":["Imagenan, tub̃at len aApraham vǝbar aTevit ikad naur lotovi 14 p̃isi, ale tub̃at len aTevit vǝbar nǝmap̃ip̃iriahan vi Papilon ikad naur lotovi 14 am, ale tub̃at len nǝmap̃ip̃iriahan vi Papilon vǝbar aKristo, aGot totabtabuh lan, ikad naur lotovi 14 tǝtas."]},{"type":"heading","content":["AMeri ipas aYesu"]},{"type":"verse","number":18,"content":["Nǝpasian siYesu Kristo evisi magegai. Anan aYesu, aMeri ikel gati ke tilah mai aJosef, be a tahw hǝn arb̃ib̃on, isab̃i ke etian, aNunun aGot togole."]},{"type":"verse","number":19,"content":["Husur ke ahaṽut san, aJosef tovi nǝvanuan tonor, nǝboŋ tosǝsǝloŋ hǝn aMeri totian, emǝtahun b̃igol nahurun aMeri b̃isa, ŋa isab̃ sǝhoti len nǝnauan san ke teriŋ aMeri, be emǝtahun avan ideh b̃elǝboii."]},{"type":"verse","number":20,"content":["Nǝboŋ tonau natgalenan sal, aŋel sua siNasub̃ evisi hǝni len nab̃ǝb̃er. Ike, “Josef anatun ulum̃an siTevit, sagemǝtahw hǝn gǝb̃esǝhar aMeri hǝn b̃evi asoam̃, bathut natǝtai totian hǝni, aNunun aGot gatolavi maii."]},{"type":"verse","number":21,"content":["Alitenan dereh tipas anatun ulum̃an balai, ale geriŋ nahǝsan aYesu lan, husur gai tilav kuv nǝvanuan san gail dan nǝsaan salit balai.”"]},{"type":"verse","number":22,"content":["Natgalen p̃isi evisi hǝn b̃igol nǝsa aGot tokele len nabuŋon ahai kelkel ur b̃isarpoh. Ike:"]},{"type":"verse","number":23,"content":[{"text":"“Mǝteris! Navensus dereh tetian,","poem":1},{"text":"ale tipas anatun ulum̃an,","poem":2},{"text":"ale lekis nahǝsan aImmanuel,”","poem":1},{"text":"namilen tovi","poem":2},{"lineBreak":true},{"text":"“AGot itah mai gadito.”","poem":2}]},{"type":"verse","number":24,"content":["Nǝboŋ aJosef tolele, igol nǝsa aŋel siNasub̃ tokel maii. Esǝhar aMeri tovi asoan"]},{"type":"verse","number":25,"content":["be sagol naitian maii van vǝbar nǝboŋ topas anatun ulum̃an sua. AJosef eriŋ nǝhes Yesu lan."]}],"footnotes":[{"noteId":0,"caller":"+","text":"1.7 Nalob̃ulat galevis ta sutuai luke Asaf lǝsake Asa.","reference":{"chapter":1,"verse":7}}]},"thisChapterLink":"/api/klv_wbt/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/klv_wbt/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":25}