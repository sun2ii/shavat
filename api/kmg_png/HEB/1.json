{"translation":{"id":"kmg_png","name":"Kâte Bible","website":"https://ebible.org/Scriptures/details.php?id=kmg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kmg","licenseNotes":null,"shortName":"PNG","englishName":"Kâte NT","language":"kmg","textDirection":"ltr","sha256":"aa1e7a563c461c3fc8411cfa1d45920f2f46a88390a94a181bbe8bb6209d5d94","availableFormats":["json"],"listOfBooksApiLink":"/api/kmg_png/books.json","numberOfBooks":25,"totalNumberOfChapters":214,"totalNumberOfVerses":6158,"languageName":"Kâte","languageEnglishName":"Kâte"},"book":{"id":"HEB","translationId":"kmg_png","name":"HEBIRAIO","commonName":"HEBIRAIO","title":"HEBIRAIO","order":58,"numberOfChapters":13,"sha256":"0f56065d8c67fd257559e898ea593ce0b87be193e8b6039867bc36dff33fe384","firstChapterNumber":1,"firstChapterApiLink":"/api/kmg_png/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/kmg_png/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Jesu e miti mujaŋgeŋke-nâre tarawec"]},{"type":"verse","number":1,"content":["Anutu e mârâc jaha porofete ejareme jaŋe mimiŋnefâc-nâŋec dâŋ hawarine fuŋne fuŋne â hatane fuŋne fuŋne jaza warekuhapie"]},{"type":"verse","number":2,"content":["ine šâhec tataranao, dameŋ šira hâcne, Ŋokâ ecneme dâŋ nâzâwec. ŋokâ e wiac sasawa irec rune juocte mucnewec, ehec hâcne wiac bâfua-fârepic."]},{"type":"verse","number":3,"content":["Anutu eri tatamac-ticnere qâreŋ erao fuawec fokacte â ju ju-ticnere sâc juekacte tâpiri dâŋticnezi wiac sasawa dope siŋsiŋ ecneha foekac. Eki sâqocne šure bataniŋ gie bafârerâ faic fekicne sâko ere fâreo fewec ŋekac."]},{"type":"verse","number":4,"content":["Aŋelo hucjopa-fârewec jukac, irec sâcko aŋelo šâŋe siricke-fârehuc šâŋe fekicne hotâckewec."]},{"type":"heading","content":["Aŋelo jaŋe wahakicne, Ŋokâ e fekicne"]},{"type":"verse","number":5,"content":["Anutuzi mo aŋelo mo kecšiŋuc moc âzâcnewec:",{"text":"“Go hâcne ŋokâ-nane,","poem":1},{"lineBreak":true},{"text":"no miŋecgac bâfuacgukopac”?","poem":1},"Me kecšiŋuc:",{"text":"“Noni Mamac ecnerâ jupemu","poem":1},{"lineBreak":true},{"text":"â eki Ŋokâ enarerâ juzejec”?","poem":1}]},{"type":"verse","number":6,"content":["Moc ine juku mârâc fufua e mâreŋko râeme wahaocmu irec dâŋ šiŋuc muwec:",{"text":"“Anuture aŋelofâc jaŋe dieŋzi hecne-fârenšepieŋ.”","poem":1}]},{"type":"verse","number":7,"content":["Aŋelo jaŋere kecšiŋuc mukicne:",{"text":"“E aŋelofâcne hawari-jeŋic bâtikieme mâŋâŋ eeŋgopieŋ,","poem":1},{"lineBreak":true},{"text":"â kiŋaŋ qaqafâcne hawari-jeŋic bâtikieme šocbâruŋ eeŋgopieŋ","poem":1}]},{"type":"verse","number":8,"content":["Ŋokâre ine šiŋuc mukicne:",{"text":"“Anutu go ŋicwofuŋ ŋeŋege i ŋeŋe sanaŋ ŋerašihuc juocmu,","poem":1},{"lineBreak":true},{"text":"â ŋicwofuŋ gunuge i bâbâtiŋ gunu biaŋ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Go tiŋnere egareekac â hehesic ine râsi ecneekic.","poem":1},{"lineBreak":true},{"text":"Irec Anutu, gore Anutu, eki šeri wokemaŋ rua-garewec,","poem":1},{"lineBreak":true},{"text":"i âgofâcge jaŋere sâc jâuruhuc rua-garewec.”","poem":1}]},{"type":"verse","number":10,"content":["Moc šiŋuc mucnekicne:",{"text":"“Wofuŋ go fufuŋkenao mâreŋte hobeteŋ râemeŋ,","poem":1},{"lineBreak":true},{"text":"â sambâŋne sambâŋne jaŋe megere qâreŋ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Jaŋe siroweniŋmu, go ine jusanaŋkekic,","poem":1},{"lineBreak":true},{"text":"jaŋe ŋaqi iŋucne raŋɋaŋkeniŋmu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ŋaqi iŋucne epie goki bataforiec-jopacmu,","poem":1},{"lineBreak":true},{"text":"eme jaŋe hawari moc eniŋmu.","poem":1},{"lineBreak":true},{"text":"Goki ine juekic ijaha juekic,","poem":1},{"lineBreak":true},{"text":"â jara dameŋge i moc mi taraocmu.”","poem":1}]},{"type":"verse","number":13,"content":["Anutu e mo aŋelo mo šiŋuc moc âzâcnewec:",{"text":"“Ware fâre-naneo ŋehaŋtec","poem":1},{"lineBreak":true},{"text":"râsifâcge guruc-jopape","poem":1},{"lineBreak":true},{"text":"kikegere ââtesiŋ enšepieŋ”?","poem":1}]},{"type":"verse","number":14,"content":["Aŋelo sasawa jaŋe mârozi kiŋaŋ qaqa, ŋic bâbâpiaŋ rauckeniŋte mukicne jaŋe bafic-jopaniŋte sorec-jopakicne."]}],"footnotes":[]},"thisChapterLink":"/api/kmg_png/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kmg_png/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kmg_png/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}