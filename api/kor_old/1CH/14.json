ntent":["블레셋 사람이 그 우상을 그곳에 버렸으므로 다윗이 명하여 불에 사르니라"]},{"type":"verse","number":13,"content":["블레셋 사람이 다시 골짜기를 침범한지라"]},{"type":"verse","number":14,"content":["다윗이 또 하나님께 묻자온대 하나님이 이르시되 마주 올라가지 말고 저희 뒤로 돌아 뽕나무 수풀 맞은편에서 저희를 엄습하되"]},{"type":"verse","number":15,"content":["뽕나무 꼭대기에서 걸음 걷는 소리가 들리거든 곧 나가서 싸우라 하나님이 네 앞서 나아가서 블레셋 사람의 군대를 치리라 하신지라"]},{"type":"verse","number":16,"content":["이에 다윗이 하나님의 명대로 행하여 블레셋 사람의 군대를 쳐서 기브온에서부터 게셀까지 이르렀더니"]},{"type":"verse","number":17,"content":["다윗의 명성이 열국에 퍼졌고 여호와께서 열국으로 저를 두려워하게 하셨더라"]}],"footnotes":[]},"thisChapterLink":"/api/kor_old/1CH/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kor_old/1CH/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kor_old/1CH/13.json","previousChapterAudioLinks":{},"numberOfVerses":17}