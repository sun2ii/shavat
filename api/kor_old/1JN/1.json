에 있지 아니하니라"]}],"footnotes":[]},"thisChapterLink":"/api/kor_old/1JN/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kor_old/1JN/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kor_old/2PE/3.json","previousChapterAudioLinks":{},"numberOfVerses":10}