e","number":12,"content":["분노 중에 뽑혀서 땅에 던짐을 당하매 그 실과는 동풍에 마르고 그 견강한 가지들은 꺾이고 말라 불에 탔더니"]},{"type":"verse","number":13,"content":["이제는 광야,메마르고 가물이 든 땅에 심긴바 되고"]},{"type":"verse","number":14,"content":["불이 그 가지 중 하나에서부터 나와서 그 실과를 태우니 권세 잡은 자의 홀이 될만한 견강한 가지가 없도다 이것이 애가라 후에도 애가가 되리라"]}],"footnotes":[]},"thisChapterLink":"/api/kor_old/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kor_old/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kor_old/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}