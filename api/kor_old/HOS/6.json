 정하였느니라"]}],"footnotes":[]},"thisChapterLink":"/api/kor_old/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kor_old/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kor_old/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}