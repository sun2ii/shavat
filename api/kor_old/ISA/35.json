에 이르러 그 머리 위에 영영한 희락을 띠고 기쁨과 즐거움을 얻으리니 슬픔과 탄식이 달아나리로다"]}],"footnotes":[]},"thisChapterLink":"/api/kor_old/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kor_old/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kor_old/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}