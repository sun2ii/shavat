이니라"]}],"footnotes":[]},"thisChapterLink":"/api/kor_old/JOS/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kor_old/JOS/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kor_old/JOS/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}