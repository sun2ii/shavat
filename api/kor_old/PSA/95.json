ks":{},"nextChapterApiLink":"/api/kor_old/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kor_old/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}