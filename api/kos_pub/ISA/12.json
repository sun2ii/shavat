{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"ISA","translationId":"kos_pub","name":"ISAIAH","commonName":"ISAIAH","title":"ISAIAH","order":23,"numberOfChapters":66,"sha256":"a3231274a11b5d9ac8b9577f16e08e9aed2656ba49a7e7833da82405f44b9d44","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/kos_pub/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["On In Sang Kulo"]},{"type":"verse","number":1,"content":["Sie len fah tuku ke mwet uh ac fah on,",{"text":"“Nga kaksakin kom, LEUM GOD! Kom tuh kasrkusrak sik,","poem":1},{"text":"A inge, kom akwoyeyu ac tila mulat.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"God El lango luk;","poem":1},{"text":"Nga fah lulalfongel ac tia sangeng.","poem":2},{"text":"LEUM GOD El ase ku lun monuk ac ku lun lulalfongi;","poem":1},{"text":"El mwet lango luk.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Oana ke kof nasnas uh akinsewowoye mwet su malu,","poem":1},{"text":"Ouinge mwet lun God fah enganak ke El molelosla.”","poem":2}]},{"type":"verse","number":4,"content":["Sie len fah tuku ke mwet uh ac fah on,",{"text":"“Sang kulo nu sin LEUM GOD! Pang nu sel Elan kasrekowos!","poem":1},{"text":"Fahkak nu sin mutunfacl nukewa ke ma El oru!","poem":2},{"lineBreak":true},{"text":"Fahkak nu selos lupan fulat lal!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"On nu sin LEUM GOD ke sripen orekma wolana lal.","poem":1},{"text":"Sulkakin pweng se inge nu fin faclu nufon.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lela mwet nukewa su muta in Zion in wowoyak ac on!","poem":1},{"text":"God mutal lun Israel El fulat,","poem":2},{"lineBreak":true},{"text":"Ac El muta inmasrlon mwet lal.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}