,","poem":2},{"lineBreak":true},{"text":"Ac oaru lal nu sin fwil nukewa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}