{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["[Psalm Lal David]"]},{"type":"heading","content":["Wulela Lun Sie Tokosra"]},{"type":"verse","number":1,"content":[{"text":"Nga fah onkakin oaru ac suwohs,","poem":1},{"text":"Ac nga fah on nu sum, LEUM GOD.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ouiyen moul luk ac fah suwosna.","poem":1},{"text":"Kom ac tuku nu yuruk ngac?","poem":2},{"lineBreak":true},{"text":"Nga fah moulkin moul nasnas in lohm sik.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Nga fah tia misla ke kutena ma koluk.","poem":2},{"text":"Nga kwase orekma lun mwet su forla liki God;","poem":1},{"text":"Ac fah wangin ip luk yorolos.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nga fah tiana oru kutena ma sesuwos","poem":1},{"text":"Ac nga fah tia kupasr nu ke kutena ma koluk.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nga fah lusla kutena mwet","poem":1},{"text":"Su lesriki sie pac mwet,","poem":2},{"text":"Ac nga fah tia muteng kutena mwet","poem":1},{"text":"Su filang ac inse fulat.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nga fah insese nu selos su pwaye nu sin God","poem":1},{"text":"Ac lela elos in muta inkul fulat sik.","poem":2},{"text":"Elos su suwosna","poem":1},{"text":"Nga fah lela in kulansap nu sik.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wangin mwet kikiap fah muta ke inkul fulat sik;","poem":1},{"text":"Wangin mwet kutasrik fah muta yuruk.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Len nu ke len nga fah kunausla","poem":1},{"text":"Mwet koluk in acn sesr;","poem":2},{"text":"Nga fah lusla mwet koluk nukewa","poem":1},{"text":"Liki siti lun LEUM GOD.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}