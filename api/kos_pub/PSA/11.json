{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["[Psalm lal David]"]},{"type":"heading","content":["Lulalfongi In LEUM GOD"]},{"type":"verse","number":1,"content":[{"text":"Nga lulalfongi tuh LEUM GOD El nien molela luk.","poem":1},{"text":"Fuka lupan nikin lom ke kom fahk nu sik,","poem":2},{"text":"“Sohkla oana sie won sohksok nu fineol uh,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Mweyen mwet koluk elos kifusya mwe pisr natulos ac ngasla sukan pisr natulos","poem":2},{"lineBreak":true},{"text":"Liki acn lohsr tuh elos in pisrki mwet suwoswos.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mea pac sie mwet suwoswos ku in oru,","poem":1},{"text":"Pwelung uh fin kunausyukla?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"LEUM GOD El muta in Tempul mutal sel;","poem":1},{"text":"Tron lal oasr inkusrao.","poem":2},{"text":"El liye mwet nukewa in acn nukewa","poem":1},{"text":"Ac El etu lah mea elos oru.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"El srike na kewa mwet wo ac mwet koluk;","poem":1},{"text":"Ac El arulana kwase mwet su lungse oru ma sulallal.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"El fah kahkin mulut ngeng ac fofosr in sulfur nu fin mwet koluk;","poem":1},{"text":"El ac akkeokyalos ke eng follana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tuh LEUM GOD El suwoswos ac El lungse orekma wo;","poem":1},{"text":"Elos su oru ma wo, elos mutana yorol.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}