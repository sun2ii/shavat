{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["[Psalm lal David]"]},{"type":"heading","content":["LEUM GOD Ac Tokosra Su El Sulela"]},{"type":"verse","number":1,"content":[{"text":"LEUM GOD El fahk nu sin tokosra, su leum luk,","poem":1},{"text":"“Muta siskuk layot","poem":2},{"lineBreak":true},{"text":"Nwe ke nga filiya mwet lokoalok lom ye niom.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"LEUM GOD El fah oru tuh ku lom in fahla Zion lac nu saya.","poem":1},{"text":"El fahk, “Kom fah leum fin mwet lokoalok lom.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"In len se kom ac mweuni mwet lokoalok lom,","poem":1},{"text":"Mwet srahm elos ac fah engan in sifacna eisalosyang in wi mweun.","poem":2},{"text":"Mwet fusr lom ac fah tuku nu yurum nu fineol mutal,","poem":1},{"text":"Oana sikyak lun aunfong ke lotutang.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"LEUM GOD El orala wulela ku lal, su El ac fah tia ekulla.","poem":1},{"text":"El fahk ouinge: “Kom ac fah sie mwet tol nwe tok","poem":2},{"lineBreak":true},{"text":"In oana Melchizedek.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"LEUM GOD El tu siskom layot;","poem":1},{"text":"Ke pacl El kasrkusrak, El ac kutangla tokosra uh.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"El ac fah nununku mutunfacl uh","poem":1},{"text":"Ac oru tuh nien mweun in sessesla ke monin mwet misa;","poem":2},{"lineBreak":true},{"text":"El ac fah kutangla tokosra yen nukewa fin faclu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tokosra el ac fah nim kof ke infacl srisrik sisken inkanek uh,","poem":1},{"text":"Ac el fah eis ku lal kac, ac keyak ac kutangla.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}