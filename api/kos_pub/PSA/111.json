{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":111,"content":[{"type":"heading","content":["Psalm In Kaksakin LEUM GOD"]},{"type":"verse","number":1,"content":[{"text":"Kaksakin LEUM GOD!","poem":1},{"lineBreak":true},{"text":"Ke insiuk nufon nga fah sang kulo nu sin LEUM GOD","poem":1},{"text":"In walil lun mwet lal.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Fuka woiyen orekma lun LEUM GOD!","poem":1},{"text":"Elos nukewa su engan kac elos ke etu kalmeya.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ma nukewa El oru uh fahkak ke ku ac wal fulat lal.","poem":1},{"text":"Suwoswos lal ac fah oan ma pahtpat.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"LEUM GOD El tia lela kut in mulkunla orekma wolana lal;","poem":1},{"text":"El kulang ac pakoten.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"El sang mwe mongo nu selos su akfulatyal;","poem":1},{"text":"El tiana mulkunla wuleang lal.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"El akkalemye ku lal nu sesr, mwet lal,","poem":1},{"text":"Ke El ase nu sesr acn sin mwet in mutunfacl saya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"El oaru ac suwoswos in ma nukewa El oru.","poem":1},{"text":"Sap lal nukewa fal in lulalfongiyuk.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sap lal inge oakwuki na nwe tok,","poem":1},{"text":"Ituku ke pwaye ac suwoswos.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"El aksukosokye mwet lal","poem":1},{"text":"Ac oru sie muleang kawil yorolos.","poem":2},{"lineBreak":true},{"text":"El mutallana ac kulana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sangeng","poem":1},{"noteId":32},{"text":"sin LEUM GOD pa mutaweyen lalmwetmet.","poem":1},{"text":"Nu selos nukewa su akos ma sap lal, El sang elos in etu in oru sulela wo.","poem":2},{"text":"Fal in kaksakinyuk El ma pahtpat.","poem":1}]}],"footnotes":[{"noteId":32,"caller":"+","text":"sangeng: akfulatye, ku sunakin.","reference":{"chapter":111,"verse":10}}]},"thisChapterLink":"/api/kos_pub/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}