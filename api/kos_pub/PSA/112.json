{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"heading","content":["Engan Lun Sie Mwet Wo"]},{"type":"verse","number":1,"content":[{"text":"Kaksakin LEUM GOD!","poem":1},{"lineBreak":true},{"text":"Insewowo el su sunakin LEUM GOD,","poem":1},{"text":"Su arulana engan in akos ma sap lal.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tulik nutin sie mwet wo fah ku in facl Israel;","poem":1},{"text":"Fwil natul fah akinsewowoyeyuk.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sou lal ac fah arulana kasrup,","poem":1},{"text":"Mwe insewowo lal ac fah yokyokelik nwe tok.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kalem tolak in lohsr uh nu sin mwet wo,","poem":1},{"text":"Aok, yorolos su kulang, pakoten, ac suwoswos.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Insewowo mwet se su engan in sangwin","poem":1},{"noteId":33},{"text":"mwe kasru nu sin mwet,","poem":1},{"text":"Ac su oru orekma lal ke pwaye ac suwohs.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sie mwet suwoswos el fah tu na ku.","poem":1},{"text":"El ac fah esamyuk in pacl nukewa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"El tia motok in lohng pweng koluk;","poem":1},{"text":"Lulalfongi lal oakiyuki ku in LEUM GOD.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"El tia fosrnga ku sangeng;","poem":1},{"text":"El etu na lah el ac liye ke mwet lokoalok lal ah kutangyukla.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"El sang yohk nu sin mwet enenu,","poem":1},{"text":"Ac kulang lal tiana srikeni;","poem":2},{"lineBreak":true},{"text":"El ac fah ku, ac ac fah akfulatyeyuk el.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mwet koluk elos liye ma inge ac kasrkusrak;","poem":1},{"text":"Elos suilya in srunga lalos, ac tilelik;","poem":2},{"lineBreak":true},{"text":"Finsrak lalos nukewa wanginla pac.","poem":2}]}],"footnotes":[{"noteId":33,"caller":"+","text":"sangwin: oana fahk mu “loan” in kas English.","reference":{"chapter":112,"verse":5}}]},"thisChapterLink":"/api/kos_pub/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}