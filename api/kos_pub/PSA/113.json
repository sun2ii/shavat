{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"heading","content":["Psalm In Kaksakin Wolana Lun LEUM GOD"]},{"type":"verse","number":1,"content":[{"text":"Kaksakin LEUM GOD!","poem":1},{"lineBreak":true},{"text":"Kowos mwet kulansap lun LEUM GOD,","poem":1},{"text":"Kaksakin Inel.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lela tuh Inel in kaksakinyuk","poem":1},{"text":"Inge ac nu tok ma pahtpat.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Liki kutulap nu roto","poem":1},{"text":"Lela Inen LEUM GOD in kaksakinyuk.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"LEUM GOD El leum fin mutunfacl nukewa;","poem":1},{"text":"Ac wolana lal oan lucng liki kusrao.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wangin sie oana LEUM GOD lasr.","poem":1},{"lineBreak":true},{"text":"El muta lucng yen fulat,","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Tusruktu El ngeta nu ten","poem":2},{"lineBreak":true},{"text":"Tuh Elan liye kusrao ac faclu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"El tulokunak mwet sukasrup liki nien sisi kutkut;","poem":1},{"text":"El srukak mwet enenu liki infohk uh","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ac oru tuh elos in mwet kawuk lun fisrak,","poem":1},{"text":"Aok, mwet fisrak lun mwet lal.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"El akfulatye mutan talap in lohm sel sifacna,","poem":1},{"text":"Ac akenganyal ke El sang in oasr tulik natul.","poem":2},{"lineBreak":true},{"text":"Kaksakin LEUM GOD!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}