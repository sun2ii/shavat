{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"hebrew_subtitle","content":["[Psalm lal David]"]},{"type":"heading","content":["Sie Pre In Suk Kasru"]},{"type":"verse","number":1,"content":[{"text":"O LEUM GOD, kasrekut!","poem":1},{"text":"Wangin sie mwet wo lula,","poem":2},{"lineBreak":true},{"text":"Ac mwet suwoswos tia ku in sifilpa koneyukyak.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mwet nukewa kikiap nu sin sie sin sie;","poem":1},{"text":"Elos kiapu sie sin sie ke kaskas in aklukuk.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"O LEUM GOD, kutongya loh ma kaskas in aklukuk inge,","poem":1},{"text":"Ac kaliya oalin mwet filang su fahk mu,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Ke kas na lasr kut eis ma kut lungse.","poem":1},{"text":"Kut ac fahk na ma kut lungse fahk,","poem":2},{"lineBreak":true},{"text":"Ac wangin mwet ku in kutongkuti.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"LEUM GOD El fahk, “Inge nga ac fah tuyak,","poem":1},{"text":"Ke sripen mwet enenu elos akkeokyeyuk,","poem":2},{"lineBreak":true},{"text":"Ac mwet kalyeiyuk elos keoklana.","poem":2},{"text":"Nga ac sang molela nu selos oana elos kena kac.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wulela lun LEUM GOD nasnas ac fal in lulalfongiyuk;","poem":1},{"text":"Wulela lal nasnas oana silver","poem":2},{"lineBreak":true},{"text":"Ma liklikiyuki pacl itkosr ke funyu in aknasnas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"LEUM GOD, kom fah karinginkutme;","poem":1},{"text":"Kom fah liyekutyang liki kain mwet inge.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mwet koluk uh oasr yen nukewa","poem":1},{"text":"Ac mwet nukewa kaksakinna ma koluk uh.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}