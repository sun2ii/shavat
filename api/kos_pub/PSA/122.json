{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["[Psalm lal David]"]},{"type":"heading","content":["Soko On In Kaksakin Jerusalem"]},{"type":"verse","number":1,"content":[{"text":"Nga engan ke elos fahk nu sik,","poem":1},{"text":"“Lela kut in som nu in lohm sin LEUM GOD.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ac inge kut utyak tari","poem":1},{"text":"Nu in kalkal lom, O Jerusalem!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Jerusalem, sie siti su sifil musaiyukla,","poem":1},{"text":"Ac arulana naweyukla wo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pa inge acn ma sruf uh tuku nu we,","poem":1},{"text":"Sruf lun Israel,","poem":2},{"text":"In sang kulo nu sin LEUM GOD","poem":1},{"text":"Fal nu ke ma El sapkin.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Pa inge acn se tokosra lun Israel","poem":1},{"text":"Elos muta we in kol mwet lalos ke suwoswos.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Pre tu Jerusalem in misla:","poem":1},{"text":"“Lela tu elos su lungse kom in kapkapak.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lela tu in oasr misla in kalkal lom,","poem":2},{"lineBreak":true},{"text":"A in wangin ma aklokoalokye inkul fulat we.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ke sripen mwet in sou luk a mwet kawuk luk","poem":1},{"text":"Nga fahk nu sin Jerusalem, “Mutana in misla.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ke sripen lohm sin LEUM GOD lasr","poem":1},{"text":"Nga pre tu in wo ouiyom.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}