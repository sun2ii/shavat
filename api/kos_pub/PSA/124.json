{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":124,"content":[{"type":"hebrew_subtitle","content":["[Psalm lal David]"]},{"type":"heading","content":["God El Mwe Loang Nu Sin Mwet Lal"]},{"type":"verse","number":1,"content":[{"text":"LEUM GOD El funu tia wi kut la, lukun fuka?","poem":1},{"text":"O Israel, kowos in topuk!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“LEUM GOD El funu tia wi kut le,","poem":1},{"text":"Ke mwet lokoalok elos mweun lain kut","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kut lukun moul na elos ukumkutla","poem":1},{"text":"Ke sripen kasrkusrak lulap lalos sesr;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Na sronot u pokkutla,","poem":1},{"text":"Kof u afwinkutla,","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A kof pulkulak akwalomyekutla.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lela kut in sang kulo nu sin LEUM GOD,","poem":1},{"text":"Su tia filikutyang nu in poun mwet lokoalok lasr.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kut tu kaingla oana sie won su kaingla liki sruf lun mwet sru won;","poem":1},{"text":"Sruf u musalla a kut sukosokla!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kasru lasr tuku sin LEUM GOD,","poem":1},{"text":"Su orala kusrao ac faclu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}