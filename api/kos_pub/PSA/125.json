1}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}