":"verse","number":5,"content":[{"text":"Insewowo mwet se su pus sukan pisr natul.","poem":1},{"lineBreak":true},{"text":"El ac fah tiana kutangyukla","poem":1},{"text":"Ke el osun nu sin mwet lokoalok lal ke acn in nununku.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}