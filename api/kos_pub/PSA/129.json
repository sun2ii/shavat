{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"heading","content":["Sie Pre Lain Mwet Lokoalok Lun Israel"]},{"type":"verse","number":1,"content":[{"text":"Israel, srumun luman akkeok lun mwet lokoalok nu suwos","poem":1},{"text":"Oe ke kowos fusr ah me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Oe ke nga fusr ah me nwe inge,","poem":1},{"text":"Mwet lokoalok luk elos akkeokyeyu arulana upa,","poem":2},{"lineBreak":true},{"text":"Tusruktu elos tiana kutangyula.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Elos kanteya fintukuk arulana loal","poem":1},{"text":"Oana ke elos pikin acn in orek ima lalos uh.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tusruktu LEUM GOD, su arulana suwoswos,","poem":1},{"text":"El aksukosokyeyula liki moul in kohs.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lela tuh elos nukewa su srunga Zion","poem":1},{"text":"In kutangyukla ac lillilyak.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lela tuh elos in oana mah su yoki oan fin mangon lohm uh,","poem":1},{"text":"Su paola ac tia ku in kapak.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wangin mwet sifelosyak inpaolos,","poem":2},{"lineBreak":true},{"text":"Ku losani ac usla.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wangin mwet su fahsr alukela acn se inge fah fahk,","poem":2},{"lineBreak":true},{"text":"“Lela God Elan akinsewowoye kom!","poem":2},{"lineBreak":true},{"text":"Kut akinsewowoye kom ke Inen LEUM GOD.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}