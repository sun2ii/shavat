{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"hebrew_subtitle","content":["[Psalm lal David]"]},{"type":"heading","content":["Sie Pre In Suk Kasru"]},{"type":"verse","number":1,"content":[{"text":"LEUM GOD, kom ac mulkinyula putaka?","poem":1},{"text":"Ya kom ac mulkinyula ma pahtpat?","poem":2},{"lineBreak":true},{"text":"Kom ac wikinkomla likiyu nwe ngac?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Putaka nga ac muteng mwe keok nu sik?","poem":1},{"text":"Ac putaka insiuk ac toasrkin ma inge ke len ac fong?","poem":2},{"lineBreak":true},{"text":"Putaka mwet lokoalok luk ac kutangyula?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ngetma nu sik, O LEUM GOD luk, ac topukyu.","poem":1},{"text":"Folokonak ku luk, ac tia lela nga in misa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nikmet lela tuh mwet lokoalok luk in fahk, “Kut kutangulla.”","poem":1},{"text":"Nikmet lela elos in isrunyu ke munasla luk.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nga lulalfongi na lungse pwaye lom;","poem":1},{"text":"Nga ac fah insewowo mweyen kom ac fah moliyula.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nga ac fah on nu sum, O LEUM GOD,","poem":1},{"text":"Mweyen kom nuna wo nu sik.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}