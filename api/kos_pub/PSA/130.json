{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"heading","content":["Sie Pre In Suk Kasru"]},{"type":"verse","number":1,"content":[{"text":"Liki acn loal in moul in keok luk, nga pang nu sum, LEUM GOD.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lohng tung luk, LEUM GOD;","poem":1},{"text":"Porongo pusren mwe siyuk luk tuh kom in kasreyu!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kom fin oakla ma koluk lasr in ma simusla lom,","poem":1},{"text":"Su ac ku in kaingkunla nununku nu sel?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"A kom nunak munas nu sesr,","poem":1},{"text":"Ouinge fal tuh kut in arulana akfulatye kom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nga tupan kasru sin LEUM GOD ke insiuk nufon,","poem":1},{"text":"Ac lulalfongi luk oan in kas lal.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nga soano LEUM GOD","poem":1},{"text":"Yohk liki na mwet san su kena in lenelik,","poem":2},{"lineBreak":true},{"text":"Aok, yohk liki na mwet san su ke in tari lenelik.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Israel, kowos in lulalfongi LEUM GOD,","poem":1},{"text":"Mweyen lungse lal kawil,","poem":2},{"lineBreak":true},{"text":"Ac pacl nukewa El engan in molela.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"El ac fah molela Israel, mwet lal,","poem":1},{"text":"Liki ma koluk lalos nukewa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}