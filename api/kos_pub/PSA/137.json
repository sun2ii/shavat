{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"heading","content":["Eoksra Lun Mwet Israel Su Muta In Sruoh"]},{"type":"verse","number":1,"content":[{"text":"Ke kut muta sisken infacl Babylon,","poem":1},{"text":"Kut tung we ke kut esamak Zion.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kut srupusrak harp natusr","poem":1},{"text":"Ulun sak willow su tu siskasr.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Elos su sruokkuti elos sap kut in on;","poem":1},{"text":"Elos sap kut in akpwaryalos,","poem":2},{"lineBreak":true},{"text":"Ac fahk, “Yuk soko on ke acn Zion kut in lohng.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kut ac on fuka soko on nu sin LEUM GOD","poem":1},{"text":"In sie facl sac?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lela tuh nga in tia sifil ku in srital ke harp","poem":1},{"text":"Nga fin mulkinkomla, Jerusalem!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lela nga in tia sifil ku in on","poem":1},{"text":"Nga fin tia esam kom,","poem":2},{"lineBreak":true},{"text":"Nga fin tia nunku mu kom pa mwe insewowo yohk emeet luk uh!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"O LEUM GOD, esam ma mwet Edom elos tuh oru","poem":1},{"text":"Ke len se sruhu acn Jerusalem.","poem":2},{"text":"Esam lah elos tuh fahk,","poem":1},{"text":"“Sukella! Sukella nwe ke musalsalu fin fohk uh!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Babylon, kom ac fah kunausyukla.","poem":1},{"lineBreak":true},{"text":"Insewowo elos su fah folokin nu sum","poem":1},{"text":"Ma kom tuh oru nu sesr —","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Su ac fah eisla tulik fusr nutuwos","poem":2},{"lineBreak":true},{"text":"Ac sakunulos fin eot uh.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}