{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":138,"content":[{"type":"hebrew_subtitle","content":["[Psalm lal David]"]},{"type":"heading","content":["Sie Pre In Sang Kulo"]},{"type":"verse","number":1,"content":[{"text":"Nga sot kulo nu sum, LEUM GOD, ke insiuk nufon,","poem":1},{"text":"Nga on kaksakin kom ye mutun god uh.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nga forla nu ke Tempul mutal sum,","poem":1},{"text":"Ac pasrla, ac kaksakin Inem","poem":2},{"text":"Ke sripen lungse kawil ac pwaye lom,","poem":1},{"text":"Oayapa ke kom akkalemye lah Inem, ac sap lom, fulat liki ma nukewa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kom topukyu ke nga tuh pang nu sum;","poem":1},{"text":"Ke ku lom, kom tuh akkeyeyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tokosra nukewa fin faclu elos fah kaksakin kom, LEUM GOD,","poem":1},{"text":"Mweyen elos lohng wulela lom.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Elos ac fah onkakin orekma lom","poem":1},{"text":"Ac ke wolana yohk lom.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kom finne muta yen fulat,","poem":1},{"text":"A kom nunku kaclos su pusisel,","poem":2},{"lineBreak":true},{"text":"Ac kom suiya mwet filang yen loesla me.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ke pacl mwe lokoalok rauniyula","poem":1},{"text":"Kom karingyume.","poem":2},{"text":"Kom lain kasrkusrak lun mwet lokoalok luk","poem":1},{"text":"Ac kom moliyula ke po ku lom.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kom fah oru ma nukewa ma kom wulela kac;","poem":1},{"text":"LEUM GOD, lungse lom oan ma pahtpat.","poem":2},{"lineBreak":true},{"text":"Aksafyela orekma su kom mutawauk oru.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}