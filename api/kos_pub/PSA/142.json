{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["[Psalm lal David ke el muta in luf sac]"]},{"type":"heading","content":["Sie Pre In Suk Kasru142:0 Sifa 1 Sam 22:1; 24:3"]},{"type":"verse","number":1,"content":[{"text":"Nga pang nu sin LEUM GOD Elan kasreyu;","poem":1},{"text":"Aok, nga kwafe nu sel.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nga use mwe torkaskas luk nukewa nu yorol,","poem":1},{"text":"Nga fahkak ongoiya nukewa luk nu sel.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ke nga apkuran in fuhleak,","poem":1},{"text":"El etu lah mea fal nga in oru.","poem":2},{"text":"Ke inkanek su nga fahsr kac","poem":1},{"text":"Mwet lokoalok luk elos okanla mwe kwasrip in sruokyuwi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ke nga ngetnget nu siskuk,","poem":1},{"text":"Nga liye tuh wanginna mwet in kasreyu.","poem":2},{"lineBreak":true},{"text":"Wangin mwet in karinginyu,","poem":2},{"text":"Wanginna mwet nunku keik.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"LEUM GOD, nga pang nu sum tuh kom in kasreyu;","poem":1},{"text":"Kom nien molela luk, LEUM GOD.","poem":2},{"lineBreak":true},{"text":"Kom mukena pa nga enenu in moul se inge.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Porongo ke nga pang,","poem":1},{"text":"Tuh nga arulana muta in ongoiya.","poem":2},{"text":"Moliyula liki mwet lokoalok luk;","poem":1},{"text":"Elos arulana ku likiyu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Aksukosokyeyu liki mwe keok luk,","poem":1},{"text":"Na nga fah kaksakin kom in walil lun mwet lom","poem":2},{"lineBreak":true},{"text":"Ke sripen orekma wo lom nu sik.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}