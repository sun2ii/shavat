{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"heading","content":["Kaksakin God, Mwet Lango"]},{"type":"verse","number":1,"content":[{"text":"Kaksakin LEUM GOD!","poem":1},{"lineBreak":true},{"text":"Kaksakin LEUM GOD, O ngunik!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nga fah kaksakin LEUM GOD in moul luk nufon;","poem":1},{"text":"Nga fah on ac kaksakin God luk ke lusenna moul luk.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nik kom filiya lulalfongi lom fin mwet kol lun faclu.","poem":1},{"text":"Wangin mwet ku in molikomla.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ke elos misa, elos folokla nu ke kutkut;","poem":1},{"text":"In len sacnna akoo lalos nukewa wanginla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Insewowo mwet se su eis God lal Jacob tuh Elan kasrel,","poem":1},{"text":"Ac su filiya lulalfongi lal in LEUM GOD lal,","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Su orala kusrao, ac faclu, ac meoa,","poem":2},{"lineBreak":true},{"text":"Ac ma nukewa loac.","poem":2},{"text":"El karingin wulela lal pacl e nukewa.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"El oru nununku suwohs nu sin mwet su akkeokyeyuk,","poem":2},{"lineBreak":true},{"text":"Ac El sang mwe mongo nu selos su masrinsral.","poem":2},{"text":"LEUM GOD El tulala mwet kapir,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Ac El sang liyaten nu sin mwet kun.","poem":2},{"text":"El tulokunulosyak su ikori.","poem":1},{"text":"El lungse mwet suwoswos lal.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"El karingin mwetsac su muta in facl sesr;","poem":1},{"text":"El kasru mwet mukaimtal ac katinmas,","poem":2},{"lineBreak":true},{"text":"Ac El usla mwet koluk nu ke kunausten.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"LEUM GOD El tokosra ma pahtpat.","poem":1},{"text":"God lom, O Zion, fah leum ke fwil nu ke fwil.","poem":2},{"lineBreak":true},{"text":"Kaksakin LEUM GOD!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}