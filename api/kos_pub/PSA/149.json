{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"heading","content":["Soko On In Kaksak"]},{"type":"verse","number":1,"content":[{"text":"Kaksakin LEUM GOD!","poem":1},{"lineBreak":true},{"text":"Yuk soko on sasu nu sin LEUM GOD;","poem":1},{"text":"Kaksakunul in walil lun mwet su inse pwaye nu sel!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Israel, kowos in engan ke sripen El su orekowosla;","poem":1},{"text":"Enganak, kowos mwet Zion, ke sripen tokosra lowos!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kaksakin Inel ke onsrosro;","poem":1},{"text":"Srital ke harp ac drum ke kowos kaksakunul.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"LEUM GOD El insewowo ke mwet lal.","poem":1},{"text":"El akfulatye mwet pusisel ke El sang kutangla nu selos.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lela mwet lun God in enganak ke kutangla lalos,","poem":1},{"text":"Ac on ke engan ke fong nufon.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ke elos kaksakin God, lela elos in sasa ke pusra lulap,","poem":1},{"text":"Oayapa elos in sruok cutlass kosro natulos in paolos","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tuh elos in kutangla mutunfacl","poem":2},{"lineBreak":true},{"text":"Ac in kai mwet we.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Elos in kapriya tokosra lalos ke sein,","poem":2},{"lineBreak":true},{"text":"Oayapa mwet kol lalos ke sein osra,","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"In kai mutanfahl uh in oana ma God El sapkin.","poem":2},{"text":"Pa inge kutangla lun mwet lun God.","poem":1},{"lineBreak":true},{"text":"Kaksakin LEUM GOD!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}