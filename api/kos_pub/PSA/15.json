{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":15,"content":[{"type":"hebrew_subtitle","content":["[Psalm lal David]"]},{"type":"heading","content":["Ma God El Enenu Sesr"]},{"type":"verse","number":1,"content":[{"text":"LEUM GOD, ku su fal in utyak nu in lohm sum in alu nu sum?","poem":1},{"text":"Su ac ku in alu nu sum fin acn Zion, eol mutal","poem":2},{"noteId":4},{"text":"sum?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"El su akos God in ma nukewa","poem":1},{"text":"Ac oru ma suwohs pacl e nukewa.","poem":2},{"text":"El kaskas suwohs ac pwaye,","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Ac el tia fahk kas in akkolukye mwet ngia.","poem":2},{"text":"El tia oru ma sufal nu sin mwet kawuk lal","poem":1},{"text":"Ku lesriki mwet tulan lal.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"El kwase mwet su God El srunga,","poem":1},{"text":"Ac el akfulatye mwet su akos LEUM GOD.","poem":2},{"text":"El akfalye wulela lal pacl nukewa,","poem":1},{"text":"Finne arulana upa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"El sang mani lal in kasru mwet, ac tia eis laesla kac,","poem":1},{"text":"Ac el tia lela mwet in moli nu sel tuh elan fahk kas kikiap lain mwet wangin mwata.","poem":2},{"lineBreak":true},{"text":"El su oru ouinge, el ac fah arulana oakwuk ac tia mukuikui.","poem":1}]}],"footnotes":[{"noteId":4,"caller":"+","text":"eol mutal: liye Psa 2:6","reference":{"chapter":15,"verse":1}}]},"thisChapterLink":"/api/kos_pub/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}