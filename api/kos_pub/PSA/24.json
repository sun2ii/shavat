{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":24,"content":[{"type":"hebrew_subtitle","content":["[Psalm lal David]"]},{"type":"heading","content":["Sie Tokosra Fulat"]},{"type":"verse","number":1,"content":[{"text":"Faclu ac koano ma lun LEUM GOD;","poem":1},{"text":"Faclu ac elos nukewa su muta fac ma pac lun LEUM GOD.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"El tulokinya fin kof lulap ye faclu,","poem":1},{"text":"Ac oakiya ke acn loal meoa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Su ac fah ku in fanyak nu fineol sin LEUM GOD?","poem":1},{"noteId":8},{"text":"Ac su ac ku in utyak nu in acn mutal sel?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"El su nasnas pao ac mutal insia;","poem":1},{"text":"El tia alu nu ke ma sruloala","poem":2},{"lineBreak":true},{"text":"Ku orek wulela kikiap.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"LEUM GOD, su langoella,","poem":1},{"text":"El ac fah akinsewowoyal ac fahkak lah wangin mwatal.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mwet ouinge pa elos su sokol,","poem":1},{"text":"Su suk in tuku nu ye mutun God lal Jacob.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Keyak sifowos, O kowos mutunpot;","poem":1},{"text":"Ac srukak na nu lucng, kowos mutunpot omeet me,","poem":2},{"lineBreak":true},{"text":"Tuh Tokosra lun wolana Elan utyak.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Su Tokosra lun wolana?","poem":1},{"lineBreak":true},{"text":"LEUM GOD su ku ac kulana,","poem":1},{"text":"LEUM GOD su kutangla ke mweun.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Keyak sifowos, O kowos mutunpot;","poem":1},{"text":"Ac srukak na nu lucng, kowos mutunpot omeet me,","poem":2},{"lineBreak":true},{"text":"Tuh Tokosra lun wolana Elan utyak.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Su Tokosra lun wolana?","poem":1},{"lineBreak":true},{"text":"LEUM GOD lun un mwe mweun — El pa Tokosra lun wolana!","poem":1}]}],"footnotes":[{"noteId":8,"caller":"+","text":"fineol sin LEUM GOD: eol soko in acn Jerusalem, yen Tempul musa we.","reference":{"chapter":24,"verse":3}}]},"thisChapterLink":"/api/kos_pub/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}