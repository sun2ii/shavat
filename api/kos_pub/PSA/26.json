{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"hebrew_subtitle","content":["[Psalm lal David]"]},{"type":"heading","content":["Pre Lun Sie Mwet Wo"]},{"type":"verse","number":1,"content":[{"text":"O LEUM GOD, akkalemye lah wangin mwetik,","poem":1},{"text":"Mweyen nga oru ma suwohs","poem":2},{"lineBreak":true},{"text":"Ac nga lulalfongi kom ke insiuk nufon.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tuniyu ac srikeyu, LEUM GOD;","poem":1},{"text":"Liye insiuk ac nunak luk.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tuh lungse kawil lom atolyu;","poem":1},{"text":"Ac oaru lom kolyu pacl e nukewa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nga tia asruoki yurin mwet lusrongten;","poem":1},{"text":"Wangin ip luk yurin mwet wosounkas.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nga tia lungse asruoki nu sin mwet koluk,","poem":1},{"text":"Ac nga fahsr liki mwet sulallal.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"LEUM GOD, nga ohlla pouk in akkalemye lah nga nasnas na,","poem":1},{"text":"Ac nga fahsr rauni loang lom.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nga yuk soko on in sang kulo,","poem":1},{"text":"Ac nga fahkak ke orekma wowo lom nukewa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"LEUM GOD, nga lungsik lohm su kom muta we,","poem":1},{"text":"Acn su wolana lom oan we.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nikmet uniyuwi yurin mwet koluk;","poem":1},{"text":"Moliyula liki ouiyen misa lun mwet akmas,","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mwet su orekma koluk in pacl e nukewa","poem":2},{"lineBreak":true},{"text":"Ac akola in eis mwe moul kutasrik.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"A funu nga, nga oru ma suwoswos.","poem":1},{"text":"Pakomutuk ac moliyula!","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nga muta in misla liki mwe ongoiya nukewa;","poem":1},{"text":"Nga fah kaksakin LEUM GOD ke nga muta inmasrlon mwet lal.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}