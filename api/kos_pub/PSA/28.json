{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":28,"content":[{"type":"hebrew_subtitle","content":["[Psalm lal David]"]},{"type":"heading","content":["Sie Pre In Suk Kasru"]},{"type":"verse","number":1,"content":[{"text":"O LEUM GOD su langoeyu, nga pang nu sum.","poem":1},{"text":"Lohng tung luk!","poem":2},{"text":"Kom fin tia topukyu,","poem":1},{"text":"Nga ac fah welulos su tufokla nu infulan misa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lohngyu ke nga pang in suk kasru sum,","poem":1},{"text":"Ke nga asroeak pouk nu ke Tempul mutal sum.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nikmet nununkeyu yurin mwet koluk,","poem":1},{"text":"Yurin mwet su oru ma koluk —","poem":2},{"lineBreak":true},{"text":"Mwet su kulang na likin pusraclos,","poem":2},{"lineBreak":true},{"text":"A insialos sessesla ke srunga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Sang kai nu selos ke orekma koluk lalos,","poem":1},{"text":"Ke ma koluk elos orala.","poem":2},{"text":"Kaelos ke ma nukewa elos oru.","poem":1},{"text":"Sang nu selos topken orekma koluk lalos!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Elos tiana lohang nu ke ma LEUM GOD El oru","poem":1},{"text":"Ku nu ke orekma lun paol.","poem":2},{"text":"Ke ma inge El ac fah kaelos","poem":1},{"text":"Ac kunauselosla nwe tok.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kaksakin LEUM GOD,","poem":1},{"text":"Tuh El lohng pusren kwafe luk.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"LEUM GOD El karinginyu ac kasreyu;","poem":1},{"text":"Nga lulalfongi in El.","poem":2},{"text":"El kasreyu ac akenganyeyu;","poem":1},{"text":"Nga kaksakunul ke pusren on in engan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"LEUM GOD El karingin mwet lal;","poem":1},{"text":"El kasru ac molela tokosra su El sulela.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"LEUM GOD, molela mwet lom,","poem":1},{"text":"Ac akinsewowoyalos su ma lom.","poem":2},{"text":"Kom in mwet shepherd lalos,","poem":1},{"text":"Ac karinganulos nwe tok ma pahtpat.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}