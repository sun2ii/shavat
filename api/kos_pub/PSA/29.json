{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":29,"content":[{"type":"hebrew_subtitle","content":["[Psalm lal David]"]},{"type":"heading","content":["Lohngyuk Pusren LEUM GOD In Paka Uh"]},{"type":"verse","number":1,"content":[{"text":"Kaksakin LEUM GOD, kowos lipufan inkusrao;","poem":1},{"text":"Kaksakin wolana lal ac ku lal.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kaksakin Ine wolana lun LEUM GOD;","poem":1},{"text":"Epasrla ye mutun El su Mutal ke El sikme in wolana lal.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Pusren LEUM GOD lohngyuk fin kof uh.","poem":1},{"text":"Ke God lun wolana El kaskas, pusracl oana pusren pulahl","poem":2},{"lineBreak":true},{"text":"Ngirngir fin meoa uh.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pusren LEUM GOD lohngyuk —","poem":1},{"text":"Pusra kulana ac fulatlana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Pusren LEUM GOD koteya sak cedar,","poem":1},{"text":"Finne sak cedar in Lebanon.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"El oru fineol in acn Lebanon in srosro oana ke soko cow fusr el srosro,","poem":1},{"text":"Oayapa tuh Fineol Hermon in srosro oana soko cow mukul.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Pusren LEUM GOD oru tuh sarom in sarmelik.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pusracl oru tuh acn mwesis uh in kusrusr;","poem":1},{"text":"El osrokak acn mwesis in Kadesh.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Pusren LEUM GOD osrokak sak oak","poem":1},{"text":"Ac osrokla sra nukewa insak uh,","poem":2},{"lineBreak":true},{"text":"Ac elos nukewa su muta in Tempul lal elos wowoyak ac fahk, “Wolana nu sin God!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"LEUM GOD El leum fin kof loal,","poem":1},{"text":"El leum oana sie tokosra nwe tok ma pahtpat.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"LEUM GOD El sang ku nu sin mutanfahl sel,","poem":1},{"text":"Ac akinsewowoyalos ke misla.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}