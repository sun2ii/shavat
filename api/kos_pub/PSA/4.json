{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"hebrew_subtitle","content":["[Psalm lal David]"]},{"type":"heading","content":["Sie Pre In Suk Kasru Ke Eku"]},{"type":"verse","number":1,"content":[{"text":"O God, su loangeyu,","poem":1},{"text":"Topukyu ke nga pre.","poem":2},{"text":"Ke nga muta in ongoiya, kom kasreyu.","poem":1},{"text":"Pakomutuk, ac lohng pre luk.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Putaka kowos ac akkolukye inek?","poem":1},{"text":"Putaka kowos ac lungse ma lusrongten","poem":2},{"lineBreak":true},{"text":"Ac suk ma kikiap?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Esam lah LEUM GOD El sulela mwet suwoswos tuh elos in ma lal,","poem":1},{"text":"Ac El lohngyu ke nga pang nu sel.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kowos in rarrar ke sangeng, ac tia sifil oru ma koluk;","poem":1},{"text":"Nunku akloalya ke ma se inge","poem":2},{"lineBreak":true},{"text":"Ke kowos oan in misla fin mwe oan kiowos.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kisakin mwe kisa fal nu sin LEUM GOD,","poem":1},{"text":"Ac filiya lulalfongi lowos in El.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Oasr mwet puspis su pre ac fahk,","poem":1},{"text":"“O LEUM GOD, saok kom in sifilpa akinsewowoye kut,","poem":2},{"lineBreak":true},{"text":"Ac ngetnget kulang lom in srekuti!”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tusruktu, engan su kom ase nu sik","poem":1},{"text":"Yohk liki na engankinyen mut lalos","poem":2},{"lineBreak":true},{"text":"Ke wheat ac wain.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ke nga ona, nga motulla in misla;","poem":1},{"text":"Mweyen kom mukena, LEUM GOD, ku in karinginyu wo. s","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}