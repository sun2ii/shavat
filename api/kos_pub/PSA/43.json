{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"heading","content":["Pre Lun Sie Mwet Muta In Sruoh"]},{"type":"heading","content":["(Tafweyen na Psalm 42)"]},{"type":"verse","number":1,"content":[{"text":"O God, fahkak lah wangin mwetik,","poem":1},{"text":"Ac kasreyu ke sripa su mwet ma tia etu God elos lainyu kac;","poem":2},{"lineBreak":true},{"text":"Moliyula liki mwet kikiap ac mwet koluk.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kom pa God su langoeyula;","poem":1},{"text":"Efu kom ku sisyula?","poem":2},{"text":"Efu ku nga in keok na","poem":1},{"text":"Ke sulallal lun mwet lokoalok luk?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Supwama kalem lom ac pwaye lom;","poem":1},{"text":"Lela tuh in mwe kolyu","poem":2},{"lineBreak":true},{"text":"Ac folokinyume nu Zion, fineol mutal sum,","poem":2},{"lineBreak":true},{"text":"Ac nu in Tempul lom yen kom muta we.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Na nga ac fah som nu ke loang lom, O God;","poem":1},{"text":"Tuh engan luk tuku sum me.","poem":2},{"text":"Nga ac fah srital ke harp nutik ac on in kaksakin kom,","poem":1},{"text":"O God, God luk.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Efu ku nga arulana supwar?","poem":1},{"text":"Efu ku nga arulana fohs?","poem":2},{"text":"Nga ac filiya finsrak luk in God,","poem":1},{"text":"Ac nga fah sifilpa kaksakunul,","poem":2},{"lineBreak":true},{"text":"Mwet Lango luk ac God luk.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}