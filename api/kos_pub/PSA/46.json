{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":46,"content":[{"type":"hebrew_subtitle","content":["[Psalm Lun Tulik Natul Korah]"]},{"type":"heading","content":["God El Wi Kut"]},{"type":"verse","number":1,"content":[{"text":"God El nien molela lasr ac ku lasr,","poem":1},{"text":"Su arulana apkuran nu sesr ke pacl in keok in kasrekut.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ke ma inge kut ac fah tiana sangeng","poem":1},{"text":"Finne kusrusr faclu ac eol uh mokukla nu in acn loal meoa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Meoa finne ngirngir ac pulkulak,","poem":1},{"text":"Ac eol uh finne rarrar ke kusrusr la.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Oasr soko infacl su ase mwe engan nu ke siti lun God,","poem":1},{"text":"Nu in lohm mutal sin El Su Fulatlana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"God El muta in siti sac, ouinge ac fah tiana kunausyukla;","poem":1},{"text":"El ac fah tuku kasru siti sac ke srakna toang.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mutanfahl uh sangeng, tokosrai uh usrusryak;","poem":1},{"text":"God El kouyak ke pusren pulahl, ac faclu kofelik.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"LEUM GOD Kulana El wi kut;","poem":1},{"text":"God lal Jacob El nien molela lasr.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Fahsru ac liye ma LEUM GOD El orala;","poem":1},{"text":"Liye ma sakirik El oru fin faclu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"El tulokinya mweun fin faclu nufon;","poem":1},{"text":"El koteya mwe pisr, kunausla osra,","poem":2},{"lineBreak":true},{"text":"Ac esukak mwe loang uh.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ac El fahk, “Kowos in tia sifil mweun, ac etu lah nga God,","poem":1},{"text":"Nga fulat inmasrlon mutunfacl uh,","poem":2},{"lineBreak":true},{"text":"Nga fulatlana fin faclu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"LEUM GOD Kulana El wi kut;","poem":1},{"text":"God lal Jacob El nien molela lasr.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}