{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["[Psalm Lun Tulik Natul Korah]"]},{"type":"heading","content":["Mwet Kol Fulatlana"]},{"type":"verse","number":1,"content":[{"text":"Paspas ke engan, kowos mwet nukewa!","poem":1},{"text":"On ac kaksakin God ke pusra lulap!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"LEUM GOD, El Su Fulatlana, fal mwet in sangeng sel;","poem":1},{"text":"El sie tokosra kulana, su leumi faclu nufon.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"El ase kutangla nu sesr fin mwet uh;","poem":1},{"text":"El oru tuh kut in kol mutanfahl uh.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"El sulela facl se kut in muta we, ac kut insewowo kac,","poem":1},{"text":"Kut tulik natul Jacob, su God El lungse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"God El fahsryak nu ke tron lal.","poem":1},{"text":"Mwet uh wowoyak ke engan, ac yohk pusren mwe ukuk","poem":2},{"lineBreak":true},{"text":"Ke LEUM GOD El utyak.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yuk on in kaksak nu sin God;","poem":1},{"text":"On kaksak nu sin tokosra lasr!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"God El tokosra fin faclu nufon;","poem":1},{"text":"Kaksakunul ke on!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"God El muta fin tron mutal lal;","poem":1},{"text":"El leum fin mutunfacl uh.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mwet kol lun mutunfacl uh elos tukeni","poem":1},{"text":"Nu yurin mwet lun God lal Abraham.","poem":2},{"text":"El ku liki un mwet mweun nukewa;","poem":1},{"text":"El fulat liki leum nukewa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}