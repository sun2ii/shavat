{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":53,"content":[{"type":"hebrew_subtitle","content":["[Psalm lal David]"]},{"type":"heading","content":["Orekma Koluk Lun Mwet"]},{"type":"verse","number":1,"content":[{"text":"Mwet lalfon elos fahk insialos,","poem":1},{"text":"“Wangin God!”","poem":2},{"text":"Elos nukewa koluklana,","poem":1},{"text":"Ac elos oru ma na srungayuk;","poem":2},{"lineBreak":true},{"text":"Wangin sie selos oru ma suwohs.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"God El muta inkusrao ac ngeti nu fin mwet uh","poem":1},{"text":"In liye lah oasr mwet lalmwetmet,","poem":2},{"lineBreak":true},{"text":"Ku oasr mwet alu nu sel.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tusruktu, elos nukewa kuhfla liki inkanek pwaye;","poem":1},{"text":"Mwet nukewa oana sie ke koluk lalos.","poem":2},{"text":"Wangin sie selos oru ma suwohs,","poem":1},{"text":"Tia siefanna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"God El siyuk, “Ya elos tia etu?","poem":1},{"text":"Ya pwaye mwet orekma koluk inge nukewa wangin nanka?","poem":2},{"text":"Elos moulkin ma elos pisre sin mwet luk,","poem":1},{"text":"Ac elos tiana pre nu sik.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tusruk elos ac fah arulana tuninfongla","poem":1},{"text":"Yohk liki ke kutena pacl somla,","poem":2},{"lineBreak":true},{"text":"Ke sripen God El ac fah sisalik srin mwet lokoalok lun mwet lal.","poem":2},{"text":"God El siselosla,","poem":1},{"text":"Ke ma inge Israel ac fah arulana kutangulosla.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nga arulana pre tuh kutangla","poem":1},{"text":"In tuku nu sin mwet Israel Zion me.","poem":2},{"text":"Ac fuka lupan engan lun mwet Israel","poem":1},{"text":"Ke God El ac sifilpa akkasrupyalos!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}