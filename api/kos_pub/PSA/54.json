{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["[Psalm lal David tukun mwet tuku Ziph me nu yorol Saul a fahk nu sel la David el wikwik oan in acn selos.]"]},{"type":"heading","content":["Sie Pre Ke Molela Liki Mwet Lokoalok54:0 Sifa 1 Sam 23:19; 26:1"]},{"type":"verse","number":1,"content":[{"text":"O God, moliyula ke ku lom;","poem":1},{"text":"Aksukosokyeyu ke ku lulap lom!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lohng pre luk, O God;","poem":1},{"text":"Porongo kas luk.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mwet inse fulat elos tuku in lainyu,","poem":1},{"text":"Ac mwet sulallal elos srike in uniyuwi —","poem":2},{"lineBreak":true},{"text":"Mwet su tia akfulatye God.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tusruk God El mwet kasru luk.","poem":1},{"text":"Leum El mwe loango luk.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lela tuh God Elan lain mwet lokoalok luk ke ma koluk lalos sifacna.","poem":1},{"text":"El ac fah kunauselosla mweyen El oaru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nga ac fah engan in oru mwe kisa nu sum, O LEUM GOD;","poem":1},{"text":"Nga fah sot kulo nu sum","poem":2},{"lineBreak":true},{"text":"Mweyen kom wo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tuh kom moliyula liki ongoiya luk nukewa,","poem":1},{"text":"Ac nga liye ke mwet lokoalok luk elos kutangyukla.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}