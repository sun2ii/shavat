{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":6,"content":[{"type":"hebrew_subtitle","content":["[Psalm lal David]"]},{"type":"heading","content":["Sie Pre In Suk Kasru In Pacl Koluk"]},{"type":"verse","number":1,"content":[{"text":"O LEUM GOD, nik kom kutongyu in mulat lom,","poem":1},{"text":"Ku kaiyu in kasrkusrak lom.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"O LEUM GOD, pakomutuk tuh nga arulana totola.","poem":1},{"text":"Ase ku nu sik tuh nga munaslana,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ac ngunik arulana foroti.","poem":2},{"text":"O LEUM GOD, kom ac tupan putaka?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"LEUM GOD, fahsru ac moliyula;","poem":1},{"text":"Loangeyula liki misa, ke lungkulang lom.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"In facl sin mwet misa wangin esamyom.","poem":1},{"text":"Wangin mwet ac kaksakin kom ingo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nga totola ke sripen asor luk;","poem":1},{"text":"Fong nukewa mwe oan kiuk sroksrok ke sroninmutuk,","poem":2},{"lineBreak":true},{"text":"Ac ilul luk uh sroksroki ke tung luk.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nga koflana ngetnget wo;","poem":1},{"text":"Mutuk fafwak","poem":2},{"lineBreak":true},{"text":"Ke tungiyen orekma lun mwet lokoalok luk.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Fahsr likiyu, kowos mwet orekma koluk!","poem":1},{"lineBreak":true},{"text":"LEUM GOD El lohng pusren tung luk;","poem":1}]},{"type":"verse","number":9,"content":[{"text":"El lipsre pusren kwafe luk,","poem":2},{"lineBreak":true},{"text":"Ac El ac fah topuk pre luk.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mwet lokoalok luk elos ac fah pulakin mwekin lulap ke kutangyukla elos;","poem":1},{"text":"Elos fah sa na in akfohsyeyukyak ac lillilla.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}