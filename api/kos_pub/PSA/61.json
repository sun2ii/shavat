{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["[Psalm lal David]"]},{"type":"heading","content":["Sie Pre Ke Molela"]},{"type":"verse","number":1,"content":[{"text":"Lohng tung luk, O God;","poem":1},{"text":"Porongo pre luk!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nga pang nu sum","poem":1},{"text":"Ke nga muta loesla liki acn sik ac nga fuhleak finsrak luk.","poem":2},{"lineBreak":true},{"text":"Usyu nu ke sie acn in molela,","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Tuh kom nien wikla luk,","poem":2},{"lineBreak":true},{"text":"Ac mwet kasru ku luk in lain mwet lokoalok luk.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lela nga in muta in lohm mutal sum in moul luk nufon;","poem":1},{"text":"Lela nga in konauk nien molela luk ye lulin poum.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tuh kom lohng wulela luk, O God,","poem":1},{"text":"Ac kom ase nu sik mwe usru lun mwet su sunakin kom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Akloesye moul lun tokosra;","poem":1},{"text":"Lela tuh elan moul paht!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lela tuh elan leum ma pahtpat ye motom, O God;","poem":1},{"text":"Karinganul ke lungse kawil ac oaru lom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ke ma inge nga fah on ac kaksakin kom pacl e nukewa,","poem":1},{"text":"Oana ke nga oru mwe kisa luk nu sum len nukewa, fal nu ke wulela luk.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}