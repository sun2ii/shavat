{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":75,"content":[{"type":"hebrew_subtitle","content":["[Psalm lal Asaph]"]},{"type":"heading","content":["God, El Su Nununku"]},{"type":"verse","number":1,"content":[{"text":"Kut sot kulo nu sum, O God, kut sot kulo nu sum!","poem":1},{"text":"Kut fahkak lupan ku lulap lom","poem":2},{"lineBreak":true},{"text":"Ac srumun orekma sakirik lom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"God El fahk, “Nga oakiya tari pacl in nununku,","poem":1},{"text":"Ac nga ac fah nununku ke suwoswos.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ma moul nukewa finne rarrar,","poem":1},{"text":"Ac faclu kusrusryak,","poem":2},{"lineBreak":true},{"text":"Nga ac fah oru tuh pwelung lun faclu in okak na.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nga fahk nu sin mwet filang elos in tia sifacna yukunulos,","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Ac nu sin mwet koluk elos in tia tungak.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nununku ac fah tia tuku kutulap me, ku roto me,","poem":1},{"text":"Ac tia tuku epang me, ku eir me;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tuh God pa ac sang nununku.","poem":1},{"text":"El ac fah kalyei kutu selos, ac aksukosokye kutu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Oasr sie cup inpoun LEUM GOD,","poem":1},{"text":"Su nwanala ke wain kulana lun kasrkusrak lal.","poem":2},{"text":"El okoala, ac mwet koluk nukewa elos nim;","poem":1},{"text":"Elos numla nwe ke na lisr.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tusruk nga ac fah tiana tui in sramsramkin God lal Jacob,","poem":1},{"text":"Ac yuk on in kaksak nu sel.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"El ac fah kunausla ku lun mwet koluk,","poem":1},{"text":"A ku lun mwet suwoswos fah yokyokelik.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}