{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":8,"content":[{"type":"hebrew_subtitle","content":["[Psalm lal David]"]},{"type":"heading","content":["Wolana Lun God Ac Saok Lun Mwet Uh"]},{"type":"verse","number":1,"content":[{"text":"O LEUM GOD, kom Leum lasr;","poem":1},{"text":"Fulat lom akilenyuk fin faclu nufon!","poem":2},{"text":"Kaksakinyom sowak sun kusrao,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Onkakinyuk sin tulik srisrik ac tulik fusr.","poem":2},{"text":"Kom oakiya sie pot ku in kosrala mwet lokoalok lom","poem":1},{"text":"Tuh kom in tulokinya kutena mwet su lain kom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ke nga ngetak ac liye kusrao su kom orala,","poem":1},{"text":"Malem ac itu, su kom oakiya in acn selos,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mea mwet, tuh kom in nunku kacl;","poem":1},{"text":"Ac mea se mwet uh, tuh kom in saokkin?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nwe ouinge, kom oru tuh elos in pusisel kutu srisrik liki kom,","poem":1},{"text":"Ac sonelosi ke wolana ac sunak.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kom oru tuh elos in leum fin orekma nukewa lun poum;","poem":1},{"text":"Ac filiya ma nukewa ye nialos:","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sheep ac cow, oayapa kosro nukewa inimae,","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Won yen engyeng uh, ac ik in meoa,","poem":2},{"lineBreak":true},{"text":"Ac ma moul nukewa inkof uh.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"O LEUM GOD, kom Leum lasr,","poem":1},{"text":"Fulat lom akilenyuk fin faclu nufon!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}