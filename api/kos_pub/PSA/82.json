{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["[Psalm lal Asaph]"]},{"type":"heading","content":["God El Leum Fulatlana"]},{"type":"verse","number":1,"content":[{"text":"God El muta fin tron lal ye mutun mwet kulansap mutal lal inkusrao;","poem":1},{"text":"Ke tukeni lalos El akkalemye wotela lal ouinge:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“Nik kowos sifil oru nununku sesuwos;","poem":1},{"text":"Ac kowos in tia sifil insese yurin mwet koluk!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Oru nununku suwohs nu sin mwet sukasrup ac mwet mukaimtal,","poem":1},{"text":"Ac oru suwohs nu sin mwet enenu ac mwet munas.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Molelosla liki poun mwet sulallal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Yohk lupan nikin ac lohsr lowos!","poem":1},{"text":"Kowos arulana koluk,","poem":2},{"lineBreak":true},{"text":"Ac nununku suwohs wanginla fin faclu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Na nga fahk, ‘Kowos god uh,","poem":1},{"text":"Kowos nukewa wen nutin El Su Fulatlana.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tusruktu, kowos ac misa oana mwet uh,","poem":1},{"text":"Ac moul lowos ac safla oana sie fisrak.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Fahsru, O God, ac nununku faclu,","poem":1},{"text":"Tuh mutunfacl nukewa ma lom.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}