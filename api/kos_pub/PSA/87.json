,","poem":2},{"lineBreak":true},{"text":"Ac El su Kulana fah oru tuh Zion in ku.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"LEUM GOD El ac simusla inen mwet inge,","poem":1},{"text":"Ac oakalosyang nukewa nu ke mwet Jerusalem.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Elos ac fah onsrosro ac fahk,","poem":1},{"text":"“Mwe insewowo lasr nukewa tuku Zion me.”","poem":2}]}],"footnotes":[{"noteId":21,"caller":"+","text":"fineol mutal: liye Psa 2:6","reference":{"chapter":87,"verse":1}}]},"thisChapterLink":"/api/kos_pub/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}