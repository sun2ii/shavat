a pahtpat a ma pahtpat.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}