{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"heading","content":["Soko On In Kaksak"]},{"type":"verse","number":1,"content":[{"text":"O fahsru, lela kut in kaksakin LEUM GOD,","poem":1},{"text":"Lela kut in on ke engan nu sin God su langoekut.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lela kut in tuku nu ye mutal ke kulo,","poem":1},{"text":"Ac yuk on in engan ke kaksak.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tuh LEUM GOD El sie God ku,","poem":1},{"text":"El sie tokosra kulana fin god nukewa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"El Leum fin faclu nufon,","poem":1},{"text":"Liki yen loal in luf uh nu yen fulat in eol uh.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"El Leum fin meoa, su El orala,","poem":1},{"text":"Oayapa faclu su El lumahla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Fahsru, lela kut in epasr ac alu nu sel,","poem":1},{"text":"Lela kut in sikukmutunte ye mutun LEUM GOD, su orekutla!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tuh El God lasr,","poem":1},{"text":"Ac kut mwet su El nunku kac,","poem":2},{"lineBreak":true},{"text":"Ac un sheep natul su El karingin.","poem":2},{"lineBreak":true},{"text":"Misenge, porongo ma El fahk:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"“Nik kowos srangesr lohng kas, oana mwet matu lowos ke elos muta in Meribah,","poem":1},{"text":"Oana ke len se elos muta yen mwesis Massah.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Elos tuh srikeyu we,","poem":1},{"text":"Elos ne liye ma nga oru nu selos.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nga tuh arulana toasr selos yac angngaul,","poem":1},{"text":"Ac nga fahk, ‘Mwet inge arulana likkeke!","poem":2},{"lineBreak":true},{"text":"Elos tia lungse in akos ma sap luk.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nga tuh kasrkusrak ac orala wulela na ku se, fahk mu,","poem":1},{"text":"‘Kowos ac fah tiana ilyak nu in acn in mongla se","poem":2},{"lineBreak":true},{"text":"Nga tuh akoo in sot nu suwos.’”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}