{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":97,"content":[{"type":"heading","content":["God El Leum Fulatlana"]},{"type":"verse","number":1,"content":[{"text":"LEUM GOD El tokosra! Lela faclu in engan!","poem":1},{"text":"Lela tuka in meoa uh in arulana insewowo!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pukunyeng ac lohsr apnulla;","poem":1},{"text":"El nununku ke suwoswos ac pwaye.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"E uh fahsr meet lukel","poem":1},{"text":"Ac esukak mwet lokoalok lal su apnulla.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sarom lal kalmeak faclu,","poem":1},{"text":"Ac faclu liye ac rarrar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Eol uh kofelik oana kiris ye mutun LEUM GOD,","poem":1},{"text":"Ye mutun LEUM GOD lun faclu nufon.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kusrao fahkak suwoswos lal,","poem":1},{"text":"Ac mutunfacl nukewa liye wolana lal.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Elos nukewa su alu nu ke ma sruloala, elos akmwekinyeyuk,","poem":1},{"text":"Ac god nukewa lun faclu epasr nu sin LEUM GOD.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mwet in Zion elos insewowo,","poem":1},{"text":"Ac siti nukewa in acn Judah elos engan","poem":2},{"lineBreak":true},{"text":"Ke sripen nununku suwoswos lom, O LEUM GOD.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"LEUM GOD Kulana, kom leum fin faclu nufon,","poem":1},{"text":"Kom arulana fulat liki god nukewa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"LEUM GOD El lungse elos su kwase ma koluk.","poem":1},{"text":"El karingin moul lun mwet lal.","poem":2},{"lineBreak":true},{"text":"El molelosla liki ku lun mwet koluk.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kalem uh sreya mwet suwoswos,","poem":1},{"text":"Ac insewowo tuku nu sin mwet wo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kowos nukewa su suwohs in enganak","poem":1},{"text":"Ke sripen ma LEUM GOD El oru!","poem":2},{"text":"Esam ma God mutal El oru,","poem":1},{"text":"Ac sang kulo nu sel.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}