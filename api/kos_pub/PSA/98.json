{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"heading","content":["God, Leum Lun Faclu"]},{"type":"verse","number":1,"content":[{"text":"Yuk soko on sasu nu sin LEUM GOD,","poem":1},{"text":"Tu El oru ma wolana!","poem":2},{"text":"Ke ku lal a ke mutal lal","poem":1},{"text":"El eis kutangla.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"LEUM GOD El fahkak kutangla lal,","poem":1},{"text":"El fahkak ku in molela lal nu sin mutanfahl uh.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"El esam wulela lal nu sin mwet Israel","poem":1},{"text":"Ke inse pwaye ac lungse kawil lal nu selos.","poem":2},{"text":"Mwet in acn nukewa elos liye kutangla lun God lasr.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"On ke engan nu sin LEUM GOD, faclu nufon;","poem":1},{"text":"Kaksakunul ke pusren on, ac sasa ke engan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"On ac kaksakin LEUM GOD.","poem":1},{"text":"Fahkak pusren on ke harp u.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Uk mwe ukuk,","poem":1},{"text":"A sasa ke engan nu sin LEUM GOD, su tokosra lasr.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lela meoa in ngirngir, a ma nukewa loac,","poem":1},{"text":"Faclu in on, a elos su muta fac!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lela infacl u in paspas,","poem":1},{"text":"A eol u in tukeni on ke engan ye mutun LEUM GOD,","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mweyen El tuku in leumi faclu.","poem":2},{"text":"El ac fah leum fin mwet faclu","poem":1},{"text":"Ke suwoswos ac wo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kos_pub/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}