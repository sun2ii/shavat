{"translation":{"id":"kos_pub","name":"BIBLE MUTAL","website":"https://ebible.org/Scriptures/details.php?id=kos","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kos","licenseNotes":null,"shortName":"PUB","englishName":"Kosraean Bible","language":"kos","textDirection":"ltr","sha256":"dac641b1dfa8b117a7c88121f229ab7d44225c37a4a4d401632efcf81a30ba0d","availableFormats":["json"],"listOfBooksApiLink":"/api/kos_pub/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30946,"languageName":"Kosraean","languageEnglishName":"Kosraean"},"book":{"id":"PSA","translationId":"kos_pub","name":"PSALM","commonName":"PSALM","title":"PSALM","order":19,"numberOfChapters":150,"sha256":"3801119b2ff008b1a5f6dbbea188c6fbf5221a98b7b87df2f5ba2eb5d4cf7029","firstChapterNumber":1,"firstChapterApiLink":"/api/kos_pub/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kos_pub/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"heading","content":["God, Tokosra Fulatlana"]},{"type":"verse","number":1,"content":[{"text":"LEUM GOD El tokosra,","poem":1},{"text":"Ac mwet uh rarrar.","poem":2},{"text":"El muta fin tron lal lucng liki cherub uh,","poem":1},{"noteId":25},{"text":"Ac faclu kusrusrsrusr.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"LEUM GOD El ku in acn Zion,","poem":1},{"text":"Ac El fulat liki mutunfacl nukewa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mwet nukewa in kaksakin Ine fulat ac ku lal.","poem":1},{"text":"El mutal!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tokosra kulana, kom lungse ma suwohs;","poem":1},{"text":"Kom oakiya nununku suwohs in Israel,","poem":2},{"lineBreak":true},{"text":"Ac kom ase suwoswos ac ma wolana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kaksakin LEUM GOD lasr,","poem":1},{"text":"Alu nu sel ye mutun tron lal.","poem":2},{"lineBreak":true},{"text":"El mutal!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Moses ac Aaron eltal mwet tol lal,","poem":1},{"text":"Ac Samuel el sie su pre nu sel.","poem":2},{"lineBreak":true},{"text":"Elos pang nu sin LEUM GOD, ac El topkolos.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"El kaskas nu selos liki sru in pukunyeng.","poem":1},{"text":"Elos akos ma sap ac ma oakwuk lal su El sang nu selos.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"O LEUM GOD lasr, kom topuk mwet lom.","poem":1},{"text":"Kom akkalemye nu selos lah kom sie God su nunak munas,","poem":2},{"lineBreak":true},{"text":"Kom finne kaelos ke ma koluk lalos.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kaksakin LEUM GOD lasr,","poem":1},{"text":"Ac alu nu sel ke eol mutal","poem":2},{"noteId":26},{"text":"sel!","poem":2},{"text":"LEUM GOD lasr El mutal.","poem":1}]}],"footnotes":[{"noteId":25,"caller":"+","text":"cherub uh: liye ke Kalmen Kutu Kas.","reference":{"chapter":99,"verse":1}},{"noteId":26,"caller":"+","text":"eol mutal: liye Psa 2:6","reference":{"chapter":99,"verse":9}}]},"thisChapterLink":"/api/kos_pub/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kos_pub/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kos_pub/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}