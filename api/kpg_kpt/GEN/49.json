{"translation":{"id":"kpg_kpt","name":"Beebaa Dabu","website":"https://ebible.org/Scriptures/details.php?id=kpg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpg","licenseNotes":null,"shortName":"KPT","englishName":"Kapingamarangi Bible","language":"kpg","textDirection":"ltr","sha256":"613a92619e262bf704b5b709432437e061e768142de6913dcb21bdd318239f97","availableFormats":["json"],"listOfBooksApiLink":"/api/kpg_kpt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30240,"languageName":"Kapingamarangi","languageEnglishName":"Kapingamarangi"},"book":{"id":"GEN","translationId":"kpg_kpt","name":"Genesis","commonName":"Genesis","title":"GENESIS Di Beebaa Genesis","order":1,"numberOfChapters":50,"sha256":"07d9e55af7b5c1d87e2f6ae557d74694657257dca5e177fdcf2d9525c98f588d","firstChapterNumber":1,"firstChapterApiLink":"/api/kpg_kpt/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/kpg_kpt/GEN/50.json","totalNumberOfVerses":1507},"chapter":{"number":49,"content":[{"type":"heading","content":["Nia helekai kokohp a Jacob i ana dama"]},{"type":"verse","number":1,"content":["Jacob ga gahi mai ana dama daane, ga helekai, “Goodou dagabuli mai gi ogu mua. Au ga hagi adu gi goodou nia mee ala ga kila adu gi goodou i nia madagoaa ala ga lloomoi:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Goodou go nia dama a Jacob,","poem":1},{"lineBreak":true},{"text":"goodou dagabuli mai gi di gowaa","poem":1},{"lineBreak":true},{"text":"e dahi.","poem":1},{"lineBreak":true},{"text":"Hagalongo mai gi di godou damana","poem":1},{"lineBreak":true},{"text":"go Israel.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Reuben, goe go dagu dama madua,","poem":1},{"lineBreak":true},{"text":"goe go ogu mahi.","poem":1},{"lineBreak":true},{"text":"Goe go di tama matagidagi","poem":1},{"lineBreak":true},{"text":"o dogu madagoaa nogo dama daane.","poem":1},{"lineBreak":true},{"text":"Goe koia e hagamuamua","poem":1},{"lineBreak":true},{"text":"ge koia e maaloo i lodo","poem":1},{"lineBreak":true},{"text":"agu dama daane huogodoo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Goe e hai gadoo be di mmidi","poem":1},{"lineBreak":true},{"text":"o di labagee, malaa,","poem":1},{"lineBreak":true},{"text":"goe hagalee dahidamee,","poem":1},{"lineBreak":true},{"text":"idimaa, goe dela ne kii goolua","poem":1},{"lineBreak":true},{"text":"mo dogu lodo hege,","poem":1},{"lineBreak":true},{"text":"gu haga milimilia di moenge","poem":1},{"lineBreak":true},{"text":"o do damana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Simeon mo Levi la taga haanau.","poem":1},{"lineBreak":true},{"text":"Meemaa e hai nau heebagi hagahuaidu","poem":1},{"lineBreak":true},{"text":"gi nau hulumanu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Au hagalee hagabuni gi meemaa","poem":1},{"lineBreak":true},{"text":"i lodo nau hagataele hagammuni.","poem":1},{"lineBreak":true},{"text":"Au hagalee hana i nia haga","poem":1},{"lineBreak":true},{"text":"dagabuli meemaa,","poem":1},{"lineBreak":true},{"text":"idimaa, meemaa ne daaligi","poem":1},{"lineBreak":true},{"text":"nau daangada gii mmade","poem":1},{"lineBreak":true},{"text":"i lodo nau hagawelewele.","poem":1},{"lineBreak":true},{"text":"Meemaa ne hadihadi","poem":1},{"lineBreak":true},{"text":"nia wae nia kau daane gi habehabe,","poem":1},{"lineBreak":true},{"text":"belee hai nau dadaagala gi nia maa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Meemaa gi halauwa i lodo","poem":1},{"lineBreak":true},{"text":"nau hagawelewele,","poem":1},{"lineBreak":true},{"text":"idimaa nia hagawelewele meemaa","poem":1},{"lineBreak":true},{"text":"e deemee di dugu,","poem":1},{"lineBreak":true},{"text":"dela e hagamadagudagudia huoloo.","poem":1},{"lineBreak":true},{"text":"Au ga haga modoho meemaa","poem":1},{"lineBreak":true},{"text":"gi lodo nia henua o Israel,","poem":1},{"lineBreak":true},{"text":"ga duwweduwwe meemaa","poem":1},{"lineBreak":true},{"text":"laa lodo digau Israel.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Judah, o duaahina daane","poem":1},{"lineBreak":true},{"text":"e hagaamu goe.","poem":1},{"lineBreak":true},{"text":"Goe e kumi nia uwa o hagadaumee,","poem":1},{"lineBreak":true},{"text":"e maaloo i digaula.","poem":1},{"lineBreak":true},{"text":"O duaahina gaa pala gi lala i oo mua.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Judah le e hai gadoo be di laion,","poem":1},{"lineBreak":true},{"text":"e daaligi dana manu,","poem":1},{"lineBreak":true},{"text":"ga hanimoi laa gi dono gowaa e noho ai,","poem":1},{"lineBreak":true},{"text":"gaa moe hagadaaholo","poem":1},{"lineBreak":true},{"text":"gi hongo di gelegele.","poem":1},{"lineBreak":true},{"text":"Deai di mee maaloo e haga deaadee","poem":1},{"lineBreak":true},{"text":"a mee ai.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Judah ga daahi togodogo king,","poem":1},{"lineBreak":true},{"text":"di mogobuna dela e dagi nia mee","poem":1},{"lineBreak":true},{"text":"le e noho hua i baahi dono hagadili","poem":1},{"lineBreak":true},{"text":"gaa hana hua beelaa.","poem":1},{"lineBreak":true},{"text":"Nia henua ala i golo","poem":1},{"lineBreak":true},{"text":"ga gaamai nadau dagitedi gi mee","poem":1},{"lineBreak":true},{"text":"gaa pala gi mua o mee.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mee e daula dana ‘donkey’","poem":1},{"lineBreak":true},{"text":"gi di laagau ‘grape’,","poem":1},{"lineBreak":true},{"text":"gi nia manga ala koia e humalia.","poem":1},{"lineBreak":true},{"text":"Mee e gaugau ono gahu","poem":1},{"lineBreak":true},{"text":"gi nia waini mmee be nia dodo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nia golomada o maa e mada luuli","poem":1},{"lineBreak":true},{"text":"i nia waini.","poem":1},{"lineBreak":true},{"text":"Nia niha o maa e mada kene","poem":1},{"lineBreak":true},{"text":"i nia milugu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Zebulun gaa noho i tongotai.","poem":1},{"lineBreak":true},{"text":"Dono dongotai gaa hai di gowaa","poem":1},{"lineBreak":true},{"text":"e dadaula nia wagabaalii.","poem":1},{"lineBreak":true},{"text":"Dono guongo le e damana adu loo","poem":1},{"lineBreak":true},{"text":"gi Sidon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Issachar la di ‘donkey’ maaloo","poem":1},{"lineBreak":true},{"text":"e moe i mehanga ana mee ala e kae.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mee gaa mmada bolo","poem":1},{"lineBreak":true},{"text":"di gowaa hagamolooloo","poem":1},{"lineBreak":true},{"text":"le e humalia ge tenua le e madamada,","poem":1},{"lineBreak":true},{"text":"geia ga haga madabouli,","poem":1},{"lineBreak":true},{"text":"gaa kae ana mee,","poem":1},{"lineBreak":true},{"text":"gei mee ga haga ngalua be di hege.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dan gaa hai di tagi ni digau","poem":1},{"lineBreak":true},{"text":"o dono henua,","poem":1},{"lineBreak":true},{"text":"digaula gaa hai gadoo","poem":1},{"lineBreak":true},{"text":"be nia madawaawa Israel ala i golo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Dan le e hai gadoo","poem":1},{"lineBreak":true},{"text":"be di gihaa i taalinga di ala,","poem":1},{"lineBreak":true},{"text":"e hai be di gihaa poisin huaidu","poem":1},{"lineBreak":true},{"text":"dela e kii talitali i taalinga di ala,","poem":1},{"lineBreak":true},{"text":"dela e gadigadi nia wae ni hoodo","poem":1},{"lineBreak":true},{"text":"gii doo tangada dela i nonua.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Meenei Dimaadua,","poem":1},{"lineBreak":true},{"text":"au e talitali do hagamouli.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Gad ga heebagi ginai digau gaiaa,","poem":1},{"lineBreak":true},{"text":"gei mee gaa huli gi muli","poem":1},{"lineBreak":true},{"text":"ga waluwalu digaula.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Tenua o Asher gaa huwa","poem":1},{"lineBreak":true},{"text":"nia huwa laagau humalia.","poem":1},{"lineBreak":true},{"text":"Mee e dahi aga nia meegai","poem":1},{"lineBreak":true},{"text":"ala e humalia e tau ang gi nia king.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Naphtali le e hai gadoo","poem":1},{"lineBreak":true},{"text":"be di ee dela ne hagamehede,","poem":1},{"lineBreak":true},{"text":"dela e hahaanau ana dama humalia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Joseph le e hai gadoo","poem":1},{"lineBreak":true},{"text":"be di ‘donkey’ lodo geinga","poem":1},{"noteId":59},{"lineBreak":true},{"text":"i taalinga tama monowai uwa aga,","poem":1},{"lineBreak":true},{"text":"e hai be tama ‘donkey’ lodo geinga","poem":1},{"lineBreak":true},{"text":"i taalinga di gonduu.","poem":1},{"noteId":60}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Nia hagadaumee o maa","poem":1},{"lineBreak":true},{"text":"e heheebagi gi mee,","poem":1},{"lineBreak":true},{"text":"e waluwalu a mee mo nadau maalei.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Gei mee gaa puu dana maalei","poem":1},{"lineBreak":true},{"text":"la hagalee bolebole.","poem":1},{"lineBreak":true},{"text":"Nia lima o maa la guu hai gi maaloo","poem":1},{"lineBreak":true},{"text":"mai i nia mogobuna mahi","poem":1},{"lineBreak":true},{"text":"o di God o Jacob,","poem":1},{"lineBreak":true},{"text":"mo mai i baahi di Hagaloohi siibi,","poem":1},{"lineBreak":true},{"text":"dela go di Hagaloohi o Israel.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Mee go di God o do damana","poem":1},{"lineBreak":true},{"text":"dela e hagamaamaa goe,","poem":1},{"lineBreak":true},{"text":"di God Koia e Aamua dela e haga","poem":1},{"lineBreak":true},{"text":"maluagina goe gi nia uwa mai i di langi","poem":1},{"lineBreak":true},{"text":"mo nia wai ala i lala di gelegele o tenua,","poem":1},{"lineBreak":true},{"text":"gei e haga maluagina goe","poem":1},{"lineBreak":true},{"text":"gi nia kau e logowaahee,","poem":1},{"lineBreak":true},{"text":"mo nia dama e dogologowaahee,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"gei e haga maluagina goe","poem":1},{"lineBreak":true},{"text":"gi nia ‘wheat’ mono huwa laagau,","poem":1},{"lineBreak":true},{"text":"gei e haga maluagina goe","poem":1},{"lineBreak":true},{"text":"i hongo nia gonduu namua,","poem":1},{"lineBreak":true},{"text":"mai i nia hagadilinga haga","poem":1},{"lineBreak":true},{"text":"manawa lamalia ala mai i nia gonduu","poem":1},{"lineBreak":true},{"text":"ala e noho hua beelaa hagalee ngala.","poem":1},{"lineBreak":true},{"text":"Nia haga maluagina aanei","poem":1},{"lineBreak":true},{"text":"la gii noho i hongo di libogo o Joseph,","poem":1},{"lineBreak":true},{"text":"i hongo di lae o tangada","poem":1},{"lineBreak":true},{"text":"dela gu dugu hagalabagau","poem":1},{"lineBreak":true},{"text":"laa hongo ono duaahina daane.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Benjamin le e hai gadoo","poem":1},{"lineBreak":true},{"text":"be di paana lodo geinga.","poem":1},{"lineBreak":true},{"text":"Nia luada mo nia hiahi","poem":1},{"lineBreak":true},{"text":"gei mee e daaligi ana manu e gai.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":["Aanei nia madawaawa e madangaholu maa lua o Israel. Malaa, aanei nia helekai haga maewae a tamana digaula ne hai gi tangada nei mo tangada nei i ana dama daane."]},{"type":"heading","content":["Di made mo di danu o Jacob"]},{"type":"verse","number":29,"content":["Jacob gaa hai dana boloagi gi ana dama daane, “Dolomeenei gei au gaa hana gi baahi ogu daangada ala ne mmade. Goodou danumia au i baahi ogu damana i lodo di bongoo hadugalaa dela i lodo di gowaa a Ephron tangada Hittite,"]},{"type":"verse","number":30,"content":["i Machpelah i baahi gi dua o Mamre i tenua go Canaan. Di bongoo hadugalaa deenei mo dono henua deenei ne hui go Abraham mai i Ephron, belee hai di gowaa daalunga."]},{"type":"verse","number":31,"content":["Deelaa di gowaa ne danu ai a Abraham mo dono lodo go Sarah, deelaa di gowaa ne danu ai a Isaac mo dono lodo go Rebecca, deelaa di gowaa ne danu ai a Leah ko au."]},{"type":"verse","number":32,"content":["Di gowaa mo di bongoo hadugalaa ne hui mai i digau Hittite. Goodou danumia au i golo.”"]},{"type":"verse","number":33,"content":["Jacob gaa lawa loo di hai ana boloagi gi ana dama daane, gei mee gaa moe gi lala, guu made."]}],"footnotes":[{"noteId":59,"caller":"+","text":"49.22 le e hai gadoo be di ‘donkey’ lodo geinga be: le e hai gadoo be di laagau ‘grape’","reference":{"chapter":49,"verse":22}},{"noteId":60,"caller":"+","text":"49.22 e hai be tama ‘donkey’ lodo geinga dela i taalinga nia gonduu be tama ‘donkey’ lodo geinga dela i taalinga nia gonduu be: e hai be di laagau hai hua dela e modoho i hongo di abaaba","reference":{"chapter":49,"verse":22}}]},"thisChapterLink":"/api/kpg_kpt/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpg_kpt/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpg_kpt/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}