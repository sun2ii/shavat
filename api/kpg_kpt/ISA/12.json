{"translation":{"id":"kpg_kpt","name":"Beebaa Dabu","website":"https://ebible.org/Scriptures/details.php?id=kpg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpg","licenseNotes":null,"shortName":"KPT","englishName":"Kapingamarangi Bible","language":"kpg","textDirection":"ltr","sha256":"613a92619e262bf704b5b709432437e061e768142de6913dcb21bdd318239f97","availableFormats":["json"],"listOfBooksApiLink":"/api/kpg_kpt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30240,"languageName":"Kapingamarangi","languageEnglishName":"Kapingamarangi"},"book":{"id":"ISA","translationId":"kpg_kpt","name":"Isaiah","commonName":"Isaiah","title":"ISAIAH Di Beebaa Isaiah","order":23,"numberOfChapters":66,"sha256":"76659800c05337381178ad8b0ddf6a0134426f3d42368bc408cf1a47f606fd44","firstChapterNumber":1,"firstChapterApiLink":"/api/kpg_kpt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/kpg_kpt/ISA/66.json","totalNumberOfVerses":1288},"chapter":{"number":12,"content":[{"type":"heading","content":["Taahili hagaamu tumaalia"]},{"type":"verse","number":1,"content":["Dahi laangi ga dau mai, gei nia daangada ga daahili,",{"text":"“Gimaadou e hagaamu Goe, meenei Dimaadua,","poem":1},{"lineBreak":true},{"text":"Goe gu hagawelewele mai gi gimaadou,","poem":1},{"lineBreak":true},{"text":"gei dolomeenei Goe e haga manawa lamalia gimaadou,","poem":1},{"lineBreak":true},{"text":"gu hagalee hagawelewele mai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"God go dogu hagamouli,","poem":1},{"lineBreak":true},{"text":"au ga hagadagadagagee gi Mee","poem":1},{"lineBreak":true},{"text":"ga hagalee madagu.","poem":1},{"lineBreak":true},{"text":"Dimaadua e gaamai gi di au di mahi mo di mogobuna,","poem":1},{"lineBreak":true},{"text":"Mee go dogu hagamouli.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gadoo be nia wai magalillili ma ga hagamanawa lamalia tangada hieinu,","poem":1},{"lineBreak":true},{"text":"nia dama a God ga tenetene gi nadau hagamouli.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Di laangi ga dau mai, gei nia daangada ga daahili,","poem":1},{"lineBreak":true},{"text":"“Di mee bolo mee gi Dimaadua!","poem":1},{"lineBreak":true},{"text":"Gahigahia a Mee gi hagamaamaa ina goe!","poem":1},{"lineBreak":true},{"text":"Hagamodongoohia ina gi henuailala ana mee ala ne hai.","poem":1},{"lineBreak":true},{"text":"Hagianga ina gi digaula di aamua o maa!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Daahili ang gi Dimaadua i ana mee humalia huogodoo ala ne hai.","poem":1},{"lineBreak":true},{"text":"Henuailala hagatau gi hagalongo gi nia longo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nia daangada huogodoo i Zion gi wwolowwolo dadaahili tenetene,","poem":1},{"lineBreak":true},{"text":"di God dabuaahia o Israel le e aamua,","poem":1},{"lineBreak":true},{"text":"e noho madalia ana daangada.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kpg_kpt/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpg_kpt/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpg_kpt/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}