{"translation":{"id":"kpg_kpt","name":"Beebaa Dabu","website":"https://ebible.org/Scriptures/details.php?id=kpg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpg","licenseNotes":null,"shortName":"KPT","englishName":"Kapingamarangi Bible","language":"kpg","textDirection":"ltr","sha256":"613a92619e262bf704b5b709432437e061e768142de6913dcb21bdd318239f97","availableFormats":["json"],"listOfBooksApiLink":"/api/kpg_kpt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30240,"languageName":"Kapingamarangi","languageEnglishName":"Kapingamarangi"},"book":{"id":"JOB","translationId":"kpg_kpt","name":"Job","commonName":"Job","title":"JOB Di Kai o Job","order":18,"numberOfChapters":42,"sha256":"dd4ec308d1f7ff8e6c33338b7c7fc75c375e44d02d0d31cc4096522936d86642","firstChapterNumber":1,"firstChapterApiLink":"/api/kpg_kpt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/kpg_kpt/JOB/42.json","totalNumberOfVerses":1055},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":["Bildad tangada Shuah ga helekai:"]},{"type":"verse","number":2,"content":[{"text":"“God e koia e mogobuna.","poem":1},{"lineBreak":true},{"text":"Nia daangada huogodoo gi hagamadagudia a Mee.","poem":1},{"lineBreak":true},{"text":"Mee e daahi dono henua i di langi i di aumaalia.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma iai tangada e mee di dau digau di langi ala e hege gi Mee?","poem":1},{"lineBreak":true},{"text":"Ma iai di gowaa i golo e hagalee maalama i di maahina a Maa?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma iai tangada e mee di donu gei e madammaa i mua o God?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I dono mmada, di malama la hagalee e maahina","poem":1},{"lineBreak":true},{"text":"ge nia heduu le hagalee e madammaa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Malaa e hai behee go tangada dangada, dela e hai gadoo be di badubadu,","poem":1},{"lineBreak":true},{"text":"tama manu geinga tolo dulii loo?","poem":1},{"lineBreak":true},{"text":"Dehee tahidamee o di mouli tangada i mua o God?”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kpg_kpt/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpg_kpt/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpg_kpt/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}