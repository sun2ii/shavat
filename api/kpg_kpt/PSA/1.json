{"translation":{"id":"kpg_kpt","name":"Beebaa Dabu","website":"https://ebible.org/Scriptures/details.php?id=kpg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpg","licenseNotes":null,"shortName":"KPT","englishName":"Kapingamarangi Bible","language":"kpg","textDirection":"ltr","sha256":"613a92619e262bf704b5b709432437e061e768142de6913dcb21bdd318239f97","availableFormats":["json"],"listOfBooksApiLink":"/api/kpg_kpt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30240,"languageName":"Kapingamarangi","languageEnglishName":"Kapingamarangi"},"book":{"id":"PSA","translationId":"kpg_kpt","name":"Psalm","commonName":"Psalm","title":"PSALMS Di Beebaa Pisalem","order":19,"numberOfChapters":150,"sha256":"5d959d36cec9b93b5217ebd4703f734c225bd0920f474f5ebf8830bd0af1cfac","firstChapterNumber":1,"firstChapterApiLink":"/api/kpg_kpt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpg_kpt/PSA/150.json","totalNumberOfVerses":2454},"chapter":{"number":1,"content":[{"type":"heading","content":["Di tenetene dela e donu"]},{"type":"verse","number":1,"content":[{"text":"E maluagina go tangada dela e hagalee hagalongo gi digau huaidu,","poem":1},{"lineBreak":true},{"text":"ge hagalee daudali nia hangaahai o digau hai mee hala,","poem":1},{"lineBreak":true},{"text":"ge hagalee hagabuni anga gi digau ala e haga balumee a God.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gei e tenetene hua di hagalongo gi nia haganoho a Dimaadua,","poem":1},{"lineBreak":true},{"text":"mo di hagamaumau nia maa i di boo mo di aa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mee e hai gadoo be di laagau dela e tomo i taalinga di monowai,","poem":1},{"lineBreak":true},{"text":"dela e huwa i dono madagoaa dela belee huwa ai.","poem":1},{"lineBreak":true},{"text":"Nia lau o di maa hagalee mae.","poem":1},{"lineBreak":true},{"text":"Nia mee a maa ma gaa hai le e kila humalia huogodoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Gei digau huaidu la hagalee loo e hai beelaa.","poem":1},{"lineBreak":true},{"text":"Digaula e hai gadoo be nia lau laagau maangoo ma ga iliili go di madangi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Deenei laa, digau ala e haihai di huaidu ga hagaduadua go God,","poem":1},{"lineBreak":true},{"text":"ga dugu gee mo ana daangada donu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dimaadua le e dagi ge e abaaba digau ala e haihai nia mee donu,","poem":1},{"lineBreak":true},{"text":"gei digau huaidu le e hula i hongo di nadau ala gi di hagaduadua.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kpg_kpt/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpg_kpt/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpg_kpt/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}