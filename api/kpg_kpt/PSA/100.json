{"translation":{"id":"kpg_kpt","name":"Beebaa Dabu","website":"https://ebible.org/Scriptures/details.php?id=kpg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpg","licenseNotes":null,"shortName":"KPT","englishName":"Kapingamarangi Bible","language":"kpg","textDirection":"ltr","sha256":"613a92619e262bf704b5b709432437e061e768142de6913dcb21bdd318239f97","availableFormats":["json"],"listOfBooksApiLink":"/api/kpg_kpt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30240,"languageName":"Kapingamarangi","languageEnglishName":"Kapingamarangi"},"book":{"id":"PSA","translationId":"kpg_kpt","name":"Psalm","commonName":"Psalm","title":"PSALMS Di Beebaa Pisalem","order":19,"numberOfChapters":150,"sha256":"5d959d36cec9b93b5217ebd4703f734c225bd0920f474f5ebf8830bd0af1cfac","firstChapterNumber":1,"firstChapterApiLink":"/api/kpg_kpt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpg_kpt/PSA/150.json","totalNumberOfVerses":2454},"chapter":{"number":100,"content":[{"type":"heading","content":["Taahili danggee hagaamu"]},{"type":"verse","number":1,"content":[{"text":"Nia daangada huogodoo o henuailala gi daahili ang gi Dimaadua!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Daumaha ang gi Dimaadua i di tenetene.","poem":1},{"lineBreak":true},{"text":"Lloomoi gi mua o Mee mo nia daahili tenetene!","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Heia gi iloo bolo Dimaadua la go God.","poem":1},{"lineBreak":true},{"text":"Ma go Mee dela ne hai gidaadou, gei gidaadou la nia mee ni Mee.","poem":1},{"lineBreak":true},{"text":"Gidaadou la nia daangada ni Mee, gidaadou la di hagabuulinga siibi ni Mee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ulu adu gi lodo di Hale Daumaha mo di daahili i nia daahili danggee.","poem":1},{"lineBreak":true},{"text":"Ulu adu gi lodo di gowaa di Hale Dabu mo di daahili hagaamu.","poem":1},{"lineBreak":true},{"text":"Heia godou danggee ang gi Mee mo di hagaamu a Mee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dimaadua le e humalia, dono aloho e dee modu,","poem":1},{"lineBreak":true},{"text":"ge dono manawa dahi e waalooloo hua beelaa dono hagaodi ai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kpg_kpt/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpg_kpt/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpg_kpt/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}