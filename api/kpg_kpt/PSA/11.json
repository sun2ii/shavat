{"translation":{"id":"kpg_kpt","name":"Beebaa Dabu","website":"https://ebible.org/Scriptures/details.php?id=kpg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpg","licenseNotes":null,"shortName":"KPT","englishName":"Kapingamarangi Bible","language":"kpg","textDirection":"ltr","sha256":"613a92619e262bf704b5b709432437e061e768142de6913dcb21bdd318239f97","availableFormats":["json"],"listOfBooksApiLink":"/api/kpg_kpt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30240,"languageName":"Kapingamarangi","languageEnglishName":"Kapingamarangi"},"book":{"id":"PSA","translationId":"kpg_kpt","name":"Psalm","commonName":"Psalm","title":"PSALMS Di Beebaa Pisalem","order":19,"numberOfChapters":150,"sha256":"5d959d36cec9b93b5217ebd4703f734c225bd0920f474f5ebf8830bd0af1cfac","firstChapterNumber":1,"firstChapterApiLink":"/api/kpg_kpt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpg_kpt/PSA/150.json","totalNumberOfVerses":2454},"chapter":{"number":11,"content":[{"type":"heading","content":["Hagadagadagagee gi Dimaadua 11.0 Taahili ni David"]},{"type":"verse","number":1,"content":[{"text":"Au e hagadagadagagee gi Dimaadua dela e haga dagaloaha au.","poem":1},{"lineBreak":true},{"text":"Goodou e boiboi ala e helekai mai gi di au boloo,","poem":1},{"lineBreak":true},{"text":"“Lele gi tomo nia gonduu gadoo be di manu,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"idimaa digau huaidu la guu hudi nadau maalei,","poem":1},{"lineBreak":true},{"text":"gu madagiwi nadau amu maalei mai i lodo di gowaa bouli","poem":1},{"lineBreak":true},{"text":"belee puu digau humalia.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma di mee e mee di hai go tangada humalia ai","poem":1},{"lineBreak":true},{"text":"i di madagoaa nia mee huogodoo gu mooho.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dimaadua e noho i lodo dono hale haga madagu.","poem":1},{"lineBreak":true},{"text":"Mee dono lohongo king i di langi.","poem":1},{"lineBreak":true},{"text":"Mee e mmada iha gi nia daangada i nia madagoaa huogodoo,","poem":1},{"lineBreak":true},{"text":"e iloo Ia nia mee ala e haihai go digaula.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mee e hagadina digau humalia mo digau huaidu be di mee e dahi.","poem":1},{"lineBreak":true},{"text":"Mee e hagadugina Ia huoloo digau ala e oho ana haganoho.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mee e hagadoo iha dana ahi mo nia malala gaa gi hongo digau huaidu.","poem":1},{"lineBreak":true},{"text":"Mee e hagaduadua digaula gi di madangi welengina.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dimaadua le e donu, Mee e hiihai gi nia hangahaihai donu.","poem":1},{"lineBreak":true},{"text":"Digau ala e hai nia maa la ga mouli i mua o Mee.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kpg_kpt/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpg_kpt/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpg_kpt/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}