{"translation":{"id":"kpg_kpt","name":"Beebaa Dabu","website":"https://ebible.org/Scriptures/details.php?id=kpg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpg","licenseNotes":null,"shortName":"KPT","englishName":"Kapingamarangi Bible","language":"kpg","textDirection":"ltr","sha256":"613a92619e262bf704b5b709432437e061e768142de6913dcb21bdd318239f97","availableFormats":["json"],"listOfBooksApiLink":"/api/kpg_kpt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30240,"languageName":"Kapingamarangi","languageEnglishName":"Kapingamarangi"},"book":{"id":"PSA","translationId":"kpg_kpt","name":"Psalm","commonName":"Psalm","title":"PSALMS Di Beebaa Pisalem","order":19,"numberOfChapters":150,"sha256":"5d959d36cec9b93b5217ebd4703f734c225bd0920f474f5ebf8830bd0af1cfac","firstChapterNumber":1,"firstChapterApiLink":"/api/kpg_kpt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpg_kpt/PSA/150.json","totalNumberOfVerses":2454},"chapter":{"number":110,"content":[{"type":"heading","content":["Dimaadua mo dana king dela ne hilihili110.0 Di pisalem ni David"]},{"type":"verse","number":1,"content":[{"text":"Dimaadua gu helekai gi dogu dagi:","poem":1},{"lineBreak":true},{"text":"“Noho i ginei i dogu baahi gau donu gaa dae loo","poem":1},{"lineBreak":true},{"text":"gi dogu madagoaa ma gaa dugu o hagadaumee gi lala o babaawae.”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dimaadua ga haga palaha o mogobuna king e dagi nia henua e logo mai i Zion.","poem":1},{"lineBreak":true},{"text":"Mee e helekai, “Dagia o hagadaumee.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Doo laangi dela ma ga heebagi iei Goe gi o hagadaumee,","poem":1},{"lineBreak":true},{"text":"au daangada ga hiihai e heebagi madalia Goe.","poem":1},{"lineBreak":true},{"text":"Au dama daane ga lloomoi gi di Goe i hongo nia gonduu haga madagu,","poem":1},{"lineBreak":true},{"text":"gadoo be nia magalillili o di luada.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dimaadua guu hai dana hagababa hagamodu ge hagalee huli dono manawa:","poem":1},{"lineBreak":true},{"text":"“Goe gaa hai tangada hai mee dabu tugi dangi nei gaa hana hua beelaa,","poem":1},{"lineBreak":true},{"text":"i di ala o Melchizedek.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tagi la i doo baahi gau donu.","poem":1},{"lineBreak":true},{"text":"Di madagoaa a Mee ma ga hagawelewele, gei Mee ga daaligi nia king gii mmade.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mee ga hagi aga nia henua, ga haga honu nia gowaa hai dauwa gi nia gau mmade.","poem":1},{"lineBreak":true},{"text":"Mee ga haga magedaa nia king i henuailala hagatau.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Di king ga inu i tama monowai i taalinga di ala, gaa hai ono mahi,","poem":1},{"lineBreak":true},{"text":"ga duu aga i lodo dono aali.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kpg_kpt/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpg_kpt/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpg_kpt/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}