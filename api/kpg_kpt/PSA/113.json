{"translation":{"id":"kpg_kpt","name":"Beebaa Dabu","website":"https://ebible.org/Scriptures/details.php?id=kpg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpg","licenseNotes":null,"shortName":"KPT","englishName":"Kapingamarangi Bible","language":"kpg","textDirection":"ltr","sha256":"613a92619e262bf704b5b709432437e061e768142de6913dcb21bdd318239f97","availableFormats":["json"],"listOfBooksApiLink":"/api/kpg_kpt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30240,"languageName":"Kapingamarangi","languageEnglishName":"Kapingamarangi"},"book":{"id":"PSA","translationId":"kpg_kpt","name":"Psalm","commonName":"Psalm","title":"PSALMS Di Beebaa Pisalem","order":19,"numberOfChapters":150,"sha256":"5d959d36cec9b93b5217ebd4703f734c225bd0920f474f5ebf8830bd0af1cfac","firstChapterNumber":1,"firstChapterApiLink":"/api/kpg_kpt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpg_kpt/PSA/150.json","totalNumberOfVerses":2454},"chapter":{"number":113,"content":[{"type":"heading","content":["Di hagaamu tumaalia o Dimaadua"]},{"type":"verse","number":1,"content":[{"text":"Hagaamu ina Yihowah!","poem":1},{"lineBreak":true},{"text":"Goodou ala go digau hai hegau a Dimaadua, goodou hagaamu ina di ingoo o Maa!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hagaamu ina di ingoo o Maa, dolomeenei gaa hana hua beelaa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mai baahi gi dua gaa hana gi baahi gi dai,","poem":1},{"lineBreak":true},{"text":"goodou hagaamu ina di ingoo Dimaadua!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dimaadua e dagi nia henua huogodoo,","poem":1},{"lineBreak":true},{"text":"nia madamada o Maa la i hongo di langi i nua.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ma tangada e hai be Dimaadua go tadau God ai. Mee e noho i nua loo,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"gei Mee e bala iha gi lala e mmada gi di langi mo henuailala.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mee e dahi aga digau hagaloale mai i nia gelegele.","poem":1},{"lineBreak":true},{"text":"Mee e hagahumalia digau ala gu nadau hagamaamaa ai gi daha mo nadau haingadaa,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"gaa hai digaula gii hai nia hoo ni digau aamua, go digau aamua ni ana daangada.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mee e hagalaamua nia ahina hagalee huwa ala e noho i nadau hale,","poem":1},{"lineBreak":true},{"text":"gaa hai digaula gi tenetene e hai nadau dama.","poem":1},{"lineBreak":true},{"text":"Hagaamu ina Dimaadua!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kpg_kpt/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpg_kpt/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpg_kpt/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}