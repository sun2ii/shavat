{"translation":{"id":"kpg_kpt","name":"Beebaa Dabu","website":"https://ebible.org/Scriptures/details.php?id=kpg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpg","licenseNotes":null,"shortName":"KPT","englishName":"Kapingamarangi Bible","language":"kpg","textDirection":"ltr","sha256":"613a92619e262bf704b5b709432437e061e768142de6913dcb21bdd318239f97","availableFormats":["json"],"listOfBooksApiLink":"/api/kpg_kpt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30240,"languageName":"Kapingamarangi","languageEnglishName":"Kapingamarangi"},"book":{"id":"PSA","translationId":"kpg_kpt","name":"Psalm","commonName":"Psalm","title":"PSALMS Di Beebaa Pisalem","order":19,"numberOfChapters":150,"sha256":"5d959d36cec9b93b5217ebd4703f734c225bd0920f474f5ebf8830bd0af1cfac","firstChapterNumber":1,"firstChapterApiLink":"/api/kpg_kpt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpg_kpt/PSA/150.json","totalNumberOfVerses":2454},"chapter":{"number":114,"content":[{"type":"heading","content":["Taahili di Pasoobaa"]},{"type":"verse","number":1,"content":[{"text":"Di madagoaa digau Israel ne hula gi daha mo Egypt,","poem":1},{"lineBreak":true},{"text":"di madagoaa di hagadili o Jacob ne hagatanga gi daha mo tenua deelaa,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"gei Judah guu hai nia daangada haga madagu ni Tagi,","poem":1},{"lineBreak":true},{"text":"gei Israel guu hai nia mee ni Mee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Di Tai Mmee ne mmada hua gaa lele gi daha,","poem":1},{"lineBreak":true},{"text":"di monowai Jordan guu noho hagalee mmidi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nia gonduu gu hobohobo gadoo be nia kuudi,","poem":1},{"lineBreak":true},{"text":"nia gonduu lligi gu hobohobo haganiganiga be nia dama siibi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Di Tai Mmee, goe ne lele gi daha eiaha?","poem":1},{"lineBreak":true},{"text":"Mo goe go Jordan, goe e aha dela ne noho hagalee mmidi?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Goodou go nia gonduu, goodou e hobohobo be nia kuudi beleiaha?","poem":1},{"lineBreak":true},{"text":"Mo goodou go nia gonduu lligi,","poem":1},{"lineBreak":true},{"text":"goodou e hobohobo haganiganiga be nia dama siibi beleiaha?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gei goe, go henuailala, goe gi bolebole gi di hanimoi o Tagi,","poem":1},{"lineBreak":true},{"text":"goe gi bolebole i mua di God o Jacob,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"dela ne huli di hadugalaa gii hai di monowai wai,","poem":1},{"lineBreak":true},{"text":"mo nia hadu hamaaloo gi hali mai nia wai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kpg_kpt/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpg_kpt/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpg_kpt/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}