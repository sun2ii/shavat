{"translation":{"id":"kpg_kpt","name":"Beebaa Dabu","website":"https://ebible.org/Scriptures/details.php?id=kpg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpg","licenseNotes":null,"shortName":"KPT","englishName":"Kapingamarangi Bible","language":"kpg","textDirection":"ltr","sha256":"613a92619e262bf704b5b709432437e061e768142de6913dcb21bdd318239f97","availableFormats":["json"],"listOfBooksApiLink":"/api/kpg_kpt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30240,"languageName":"Kapingamarangi","languageEnglishName":"Kapingamarangi"},"book":{"id":"PSA","translationId":"kpg_kpt","name":"Psalm","commonName":"Psalm","title":"PSALMS Di Beebaa Pisalem","order":19,"numberOfChapters":150,"sha256":"5d959d36cec9b93b5217ebd4703f734c225bd0920f474f5ebf8830bd0af1cfac","firstChapterNumber":1,"firstChapterApiLink":"/api/kpg_kpt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpg_kpt/PSA/150.json","totalNumberOfVerses":2454},"chapter":{"number":120,"content":[{"type":"heading","content":["Talodalo e madau di hagamaamaa120.0 Taahili dela e daahili go digau ala e hula gi Jerusalem belee daumaha i golo"]},{"type":"verse","number":1,"content":[{"text":"Dogu madagoaa ne haingadaa mai gi di au,","poem":1},{"lineBreak":true},{"text":"gei au ne gahigahi a Dimaadua, gei Mee gu helekai mai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Meenei Dimaadua, haga dagaloaha ina au gi daha mo digau hai kai tilikai,","poem":1},{"lineBreak":true},{"text":"mo digau halahalau dangada.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Goodou go digau hai kai tilikai, ma di aha dela gaa hai go God adu gi goodou?","poem":1},{"lineBreak":true},{"text":"Mee ga daaligi goodou behee?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mee ga daaligi goodou gi nia amu maalei gaa o tangada dauwa,","poem":1},{"lineBreak":true},{"text":"mo nia hadu wele mai i lodo di imu!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dogu noho i godou baahi le e manawa gee","poem":1},{"lineBreak":true},{"text":"gadoo be dogu noho i Meshech be i baahi digau Kedar.","poem":1},{"noteId":8}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Au guu noho waalooloo huoloo i baahi nia daangada","poem":1},{"lineBreak":true},{"text":"ala e de hiihai di noho i di aumaalia!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dogu madagoaa ma ga helekai gi digaula i di noho i di aumaalia,","poem":1},{"lineBreak":true},{"text":"digaula e hiihai hua bolo e hai tauwa.","poem":1}]}],"footnotes":[{"noteId":8,"caller":"+","text":"120.5 Meshech mo Kedar la nia henua mogowaa loo i Canaan ala nogo noho ai digau bouli","reference":{"chapter":120,"verse":5}}]},"thisChapterLink":"/api/kpg_kpt/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpg_kpt/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpg_kpt/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}