{"translation":{"id":"kpg_kpt","name":"Beebaa Dabu","website":"https://ebible.org/Scriptures/details.php?id=kpg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpg","licenseNotes":null,"shortName":"KPT","englishName":"Kapingamarangi Bible","language":"kpg","textDirection":"ltr","sha256":"613a92619e262bf704b5b709432437e061e768142de6913dcb21bdd318239f97","availableFormats":["json"],"listOfBooksApiLink":"/api/kpg_kpt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30240,"languageName":"Kapingamarangi","languageEnglishName":"Kapingamarangi"},"book":{"id":"PSA","translationId":"kpg_kpt","name":"Psalm","commonName":"Psalm","title":"PSALMS Di Beebaa Pisalem","order":19,"numberOfChapters":150,"sha256":"5d959d36cec9b93b5217ebd4703f734c225bd0920f474f5ebf8830bd0af1cfac","firstChapterNumber":1,"firstChapterApiLink":"/api/kpg_kpt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpg_kpt/PSA/150.json","totalNumberOfVerses":2454},"chapter":{"number":121,"content":[{"type":"heading","content":["Dimaadua la go tadau Hagaloohi121.0 Taahili dela e daahili go digau ala e hula gi Jerusalem belee daumaha i golo"]},{"type":"verse","number":1,"content":[{"text":"Au e hila aga gi tomo nia gonduu, dogu hagamaamaa la ga hanimoi i hee?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dogu hagamaamaa la ga hanimoi i baahi o Dimaadua,","poem":1},{"lineBreak":true},{"text":"dela ne hai di langi mo henuailala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mee hagalee diiagi goe gii doo. Do Hagaloohi la hagalee kii.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Di Hagaloohi o Israel la hagalee molemoe be e kii!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dimaadua ga hagaloohi la goe.","poem":1},{"lineBreak":true},{"text":"Mee e noho i doo baahi belee madamada humalia i di goe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Di laa hagalee mmae ana mee adu gi di goe i di aa,","poem":1},{"lineBreak":true},{"text":"be go di malama ma gaa boo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dimaadua ga abaaba la goe gi daha mo nia hagadilinga haingadaa huogodoo,","poem":1},{"lineBreak":true},{"text":"Mee ga benebene goe hagahumalia.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mee ga abaaba la goe i do hanimoi mo doo hana, dolomeenei gaa hana hua beelaa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kpg_kpt/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpg_kpt/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpg_kpt/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}