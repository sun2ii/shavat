{"translation":{"id":"kpg_kpt","name":"Beebaa Dabu","website":"https://ebible.org/Scriptures/details.php?id=kpg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpg","licenseNotes":null,"shortName":"KPT","englishName":"Kapingamarangi Bible","language":"kpg","textDirection":"ltr","sha256":"613a92619e262bf704b5b709432437e061e768142de6913dcb21bdd318239f97","availableFormats":["json"],"listOfBooksApiLink":"/api/kpg_kpt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30240,"languageName":"Kapingamarangi","languageEnglishName":"Kapingamarangi"},"book":{"id":"PSA","translationId":"kpg_kpt","name":"Psalm","commonName":"Psalm","title":"PSALMS Di Beebaa Pisalem","order":19,"numberOfChapters":150,"sha256":"5d959d36cec9b93b5217ebd4703f734c225bd0920f474f5ebf8830bd0af1cfac","firstChapterNumber":1,"firstChapterApiLink":"/api/kpg_kpt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpg_kpt/PSA/150.json","totalNumberOfVerses":2454},"chapter":{"number":123,"content":[{"type":"heading","content":["Talodalo e madau tumaalia123.0 Taahili dela e daahili go digau ala e hula gi Jerusalem belee daumaha i golo"]},{"type":"verse","number":1,"content":[{"text":"Meenei Dimaadua, au e daumada aga Goe gi di langi i do gowaa dela e dagi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"E hai gadoo be tangada hai hegau daane be ahina dela e gana gi dono dagi,","poem":1},{"lineBreak":true},{"text":"deelaa gadoo di madau hai e gana adu gi di Goe, meenei Dimaadua,","poem":1},{"lineBreak":true},{"text":"gaa dae loo gi do dumaalia mai gi gimaadou.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Meenei Dimaadua, Goe dumaalia mai, dumaalia mai gi gimaadou.","poem":1},{"lineBreak":true},{"text":"Gimaadou guu hai haga huaidu huoloo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gimaadou gu waalooloo huoloo di madau haganneennee go digau maluagina,","poem":1},{"lineBreak":true},{"text":"mo di haga balumee go digau e hagaamu ginaadou ala e hai haga huaidu gimaadou.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kpg_kpt/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpg_kpt/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpg_kpt/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}