{"translation":{"id":"kpg_kpt","name":"Beebaa Dabu","website":"https://ebible.org/Scriptures/details.php?id=kpg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpg","licenseNotes":null,"shortName":"KPT","englishName":"Kapingamarangi Bible","language":"kpg","textDirection":"ltr","sha256":"613a92619e262bf704b5b709432437e061e768142de6913dcb21bdd318239f97","availableFormats":["json"],"listOfBooksApiLink":"/api/kpg_kpt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30240,"languageName":"Kapingamarangi","languageEnglishName":"Kapingamarangi"},"book":{"id":"PSA","translationId":"kpg_kpt","name":"Psalm","commonName":"Psalm","title":"PSALMS Di Beebaa Pisalem","order":19,"numberOfChapters":150,"sha256":"5d959d36cec9b93b5217ebd4703f734c225bd0920f474f5ebf8830bd0af1cfac","firstChapterNumber":1,"firstChapterApiLink":"/api/kpg_kpt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpg_kpt/PSA/150.json","totalNumberOfVerses":2454},"chapter":{"number":124,"content":[{"type":"heading","content":["Dimaadua la di Hagaloohi ni ana daangada124.0 Taahili dela e daahili go digau ala e hula gi Jerusalem belee daumaha i golo. Di pisalem mai baahi o David"]},{"type":"verse","number":1,"content":[{"text":"Maa nei bolo Dimaadua digi huli mai i tadau baahi?","poem":1},{"lineBreak":true},{"text":"Digau Israel nei, helekai aga!","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Maa nei bolo Dimaadua digi huli mai i tadau baahi","poem":1},{"lineBreak":true},{"text":"i di madagoaa o tadau hagadaumee ne heebagi mai gi gidaadou,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"gei digaula gaa holo mouli gidaadou","poem":1},{"lineBreak":true},{"text":"i nadau hagawelewele huoloo mai gi gidaadou,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"gei gidaadou ga daahee gi daha i di mmidi o di monowai,","poem":1},{"lineBreak":true},{"text":"nia wai guu gahu gidaadou.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nia wai mmidi gu haga maalemu gidaadou!","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Gidaadou e hai tadau danggee gi Dimaadua","poem":1},{"lineBreak":true},{"text":"i Mee dela digi dugua anga gidaadou gi tadau hagadaumee gi daaligidia.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gidaadou guu too gi daha, gadoo be di manu mamaangi ne doo gi daha","poem":1},{"lineBreak":true},{"text":"mo di hele a tangada hele manu. Di hele la gu mooho, gei gidaadou gu maahede!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tadau hagamaamaa le e hanimoi i baahi o Dimaadua","poem":1},{"lineBreak":true},{"text":"dela ne hai di langi mo henuailala.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kpg_kpt/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpg_kpt/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpg_kpt/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}