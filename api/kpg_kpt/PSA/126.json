{"translation":{"id":"kpg_kpt","name":"Beebaa Dabu","website":"https://ebible.org/Scriptures/details.php?id=kpg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpg","licenseNotes":null,"shortName":"KPT","englishName":"Kapingamarangi Bible","language":"kpg","textDirection":"ltr","sha256":"613a92619e262bf704b5b709432437e061e768142de6913dcb21bdd318239f97","availableFormats":["json"],"listOfBooksApiLink":"/api/kpg_kpt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30240,"languageName":"Kapingamarangi","languageEnglishName":"Kapingamarangi"},"book":{"id":"PSA","translationId":"kpg_kpt","name":"Psalm","commonName":"Psalm","title":"PSALMS Di Beebaa Pisalem","order":19,"numberOfChapters":150,"sha256":"5d959d36cec9b93b5217ebd4703f734c225bd0920f474f5ebf8830bd0af1cfac","firstChapterNumber":1,"firstChapterApiLink":"/api/kpg_kpt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpg_kpt/PSA/150.json","totalNumberOfVerses":2454},"chapter":{"number":126,"content":[{"type":"heading","content":["Talodalo i di haga dagaloaha126.0 Taahili dela e daahili go digau ala e hula gi Jerusalem belee daumaha i golo"]},{"type":"verse","number":1,"content":[{"text":"Di madagoaa hua Dimaadua dela ne laha mai gidaadou gi muli gi Jerusalem,","poem":1},{"lineBreak":true},{"text":"gidaadou nogo hai gadoo be digau ne hai nadau midi!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gidaadou gu gadagada huoloo!","poem":1},{"lineBreak":true},{"text":"Gidaadou gu dadaahili mo di momoogo i tadau tenetene huoloo!","poem":1},{"lineBreak":true},{"text":"Gei nia henua ala i golo gu helekai boloo,","poem":1},{"lineBreak":true},{"text":"“Dimaadua guu hai ana mee humalia huoloo gi digaula.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"E donu, Mee guu hai ana mee humalia huoloo mai gi gidaadou,","poem":1},{"lineBreak":true},{"text":"gidaadou gu tenetene huoloo!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Meenei Dimaadua, heia gimaadou gi haadanga lamalia labelaa!","poem":1},{"lineBreak":true},{"text":"gadoo be di uwa ma ga gaamai ana wai gi nia anga monowai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Digau ala e dogi nadau hagadili mo di tangitangi,","poem":1},{"lineBreak":true},{"text":"la gi haadia nia huwa o nadau gowaa mo di tenetene!","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Digau ala e kae nadau lii laagau mo di tangitangi,","poem":1},{"lineBreak":true},{"text":"la ga lloomoi mo nia huwa o nadau gowaa mo di daahili momoogo tenetene.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kpg_kpt/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpg_kpt/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpg_kpt/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}