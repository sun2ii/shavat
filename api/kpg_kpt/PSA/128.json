{"translation":{"id":"kpg_kpt","name":"Beebaa Dabu","website":"https://ebible.org/Scriptures/details.php?id=kpg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpg","licenseNotes":null,"shortName":"KPT","englishName":"Kapingamarangi Bible","language":"kpg","textDirection":"ltr","sha256":"613a92619e262bf704b5b709432437e061e768142de6913dcb21bdd318239f97","availableFormats":["json"],"listOfBooksApiLink":"/api/kpg_kpt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30240,"languageName":"Kapingamarangi","languageEnglishName":"Kapingamarangi"},"book":{"id":"PSA","translationId":"kpg_kpt","name":"Psalm","commonName":"Psalm","title":"PSALMS Di Beebaa Pisalem","order":19,"numberOfChapters":150,"sha256":"5d959d36cec9b93b5217ebd4703f734c225bd0920f474f5ebf8830bd0af1cfac","firstChapterNumber":1,"firstChapterApiLink":"/api/kpg_kpt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpg_kpt/PSA/150.json","totalNumberOfVerses":2454},"chapter":{"number":128,"content":[{"type":"heading","content":["Di hui tangada hagalongo gi Dimaadua128.0 Taahili dela e daahili go digau ala e hula gi Jerusalem belee daumaha i golo"]},{"type":"verse","number":1,"content":[{"text":"E maluagina go digau ala e hagalongo gi Dimaadua, ge e daudali ana haganoho.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Goe gaa kae o hagahumalia mai i au hegau ala ne hai.","poem":1},{"lineBreak":true},{"text":"Goe ga tenetene ga humalia adu gi di goe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Doo lodo gaa hai gadoo be di laagau ‘grape’ dela e huwa daulogo i lodo doo hale,","poem":1},{"lineBreak":true},{"text":"gei au dama daane gaa hai gadoo be nia dama laagau olib ala e haganiga dau deebele.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Taane dela e hagalongo gi Dimaadua le e hai loo gi haga maluagina gadoo beenei.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dimaadua gi haga maluagina ina goe mai i Zion!","poem":1},{"lineBreak":true},{"text":"Goe gii mee hualaa di mmada gi di gila humalia o Jerusalem","poem":1},{"lineBreak":true},{"text":"i di waalooloo o do mouli!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Goe gi mouli hualaa gii mee goe di mmada gi nia dama o au dama!","poem":1},{"lineBreak":true},{"text":"Di aumaalia gi noho hua beelaa i baahi Israel!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kpg_kpt/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpg_kpt/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpg_kpt/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}