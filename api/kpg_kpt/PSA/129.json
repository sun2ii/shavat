{"translation":{"id":"kpg_kpt","name":"Beebaa Dabu","website":"https://ebible.org/Scriptures/details.php?id=kpg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpg","licenseNotes":null,"shortName":"KPT","englishName":"Kapingamarangi Bible","language":"kpg","textDirection":"ltr","sha256":"613a92619e262bf704b5b709432437e061e768142de6913dcb21bdd318239f97","availableFormats":["json"],"listOfBooksApiLink":"/api/kpg_kpt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30240,"languageName":"Kapingamarangi","languageEnglishName":"Kapingamarangi"},"book":{"id":"PSA","translationId":"kpg_kpt","name":"Psalm","commonName":"Psalm","title":"PSALMS Di Beebaa Pisalem","order":19,"numberOfChapters":150,"sha256":"5d959d36cec9b93b5217ebd4703f734c225bd0920f474f5ebf8830bd0af1cfac","firstChapterNumber":1,"firstChapterApiLink":"/api/kpg_kpt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpg_kpt/PSA/150.json","totalNumberOfVerses":2454},"chapter":{"number":129,"content":[{"type":"heading","content":["Talodalo hai baahi gi nia hagadaumee o Israel129.0 Taahili dela e daahili go digau ala e hula gi Jerusalem belee daumaha i golo"]},{"type":"verse","number":1,"content":[{"text":"Israel, hagia mai malaa gi gimaadou","poem":1},{"lineBreak":true},{"text":"be o hagadaumee nogo dadaaligi goe behee mai loo i do damagiigi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Mai i dogu madagoaa nogo damagiigi,","poem":1},{"lineBreak":true},{"text":"ogu hagadaumee nogo dadaaligi au haga huaidu, malaa digaula digi haga magedaa au.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Digaula guu tuu dogu dua, gu mahaa loo gi lodo,","poem":1},{"lineBreak":true},{"text":"guu hai gadoo be di gowaa ne geli belee dogi nia lii laagau.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gei Dimaadua, dela koia e donu, gu hagamehede au gi daha mo di noho hege.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Digau huogodoo ala e de hiihai gi Zion la gi magedaa,","poem":1},{"lineBreak":true},{"text":"gii llele gi muli mo di langaadia.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Digaula huogodoo gii hai gadoo be nia geinga tolo e tomo i tuatala di hale,","poem":1},{"lineBreak":true},{"text":"ala e maangoo hua i mua nia maa digi tomo llauehe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tangada e hagabudu nia maa be e kae nia maa ai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Deai tangada e hana laa baahi nia maa e helekai boloo:","poem":1},{"lineBreak":true},{"text":"“Dimaadua gi haga maluagina goodou!","poem":1},{"lineBreak":true},{"text":"Gimaadou e haga maluagina goodou i di ingoo o Dimaadua.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kpg_kpt/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpg_kpt/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpg_kpt/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}