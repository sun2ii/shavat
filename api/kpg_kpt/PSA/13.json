{"translation":{"id":"kpg_kpt","name":"Beebaa Dabu","website":"https://ebible.org/Scriptures/details.php?id=kpg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpg","licenseNotes":null,"shortName":"KPT","englishName":"Kapingamarangi Bible","language":"kpg","textDirection":"ltr","sha256":"613a92619e262bf704b5b709432437e061e768142de6913dcb21bdd318239f97","availableFormats":["json"],"listOfBooksApiLink":"/api/kpg_kpt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30240,"languageName":"Kapingamarangi","languageEnglishName":"Kapingamarangi"},"book":{"id":"PSA","translationId":"kpg_kpt","name":"Psalm","commonName":"Psalm","title":"PSALMS Di Beebaa Pisalem","order":19,"numberOfChapters":150,"sha256":"5d959d36cec9b93b5217ebd4703f734c225bd0920f474f5ebf8830bd0af1cfac","firstChapterNumber":1,"firstChapterApiLink":"/api/kpg_kpt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpg_kpt/PSA/150.json","totalNumberOfVerses":2454},"chapter":{"number":13,"content":[{"type":"heading","content":["Talodalo i di hagamaamaa13.0 Taahili ni David"]},{"type":"verse","number":1,"content":[{"text":"Meenei Dimaadua, e waalooloo behee go do haga delangahia e Goe au?","poem":1},{"lineBreak":true},{"text":"E de langahia gaa hana hua beelaa?","poem":1},{"lineBreak":true},{"text":"E waalooloo behee go do hagammuni Goe i di au?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Au belee hai gii noho waalooloo behee i lodo ogu haingadaa?","poem":1},{"lineBreak":true},{"text":"E waalooloo behee go dogu manawa gee i di boo mo di aa?","poem":1},{"lineBreak":true},{"text":"E waalooloo behee go ogu hagadaumee ala e haga magedaa au?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Meenei Dimaadua go dogu God,","poem":1},{"lineBreak":true},{"text":"mmada mai gi di au, helekai mai gi agu helekai.","poem":1},{"lineBreak":true},{"text":"Hagamaaloo ina aga au, hudee heia au gii made.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hudee heia ogu hagadaumee gi helekai boloo,","poem":1},{"lineBreak":true},{"text":"“Gidaadou gu haga magedaa a mee.”","poem":1},{"lineBreak":true},{"text":"Hudee heia digaula gii mmada tene gi dogu doo gi lala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Au e hagadagadagagee gi do manawa aloho dee modu.","poem":1},{"lineBreak":true},{"text":"Au ga tenetene idimaa Goe dela ga haga dagaloaha au.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Meenei Dimaadua, au ga daahili adu gi di Goe,","poem":1},{"lineBreak":true},{"text":"idimaa Goe dela e humalia mai gi di au.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kpg_kpt/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpg_kpt/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpg_kpt/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}