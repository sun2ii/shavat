{"translation":{"id":"kpg_kpt","name":"Beebaa Dabu","website":"https://ebible.org/Scriptures/details.php?id=kpg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpg","licenseNotes":null,"shortName":"KPT","englishName":"Kapingamarangi Bible","language":"kpg","textDirection":"ltr","sha256":"613a92619e262bf704b5b709432437e061e768142de6913dcb21bdd318239f97","availableFormats":["json"],"listOfBooksApiLink":"/api/kpg_kpt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30240,"languageName":"Kapingamarangi","languageEnglishName":"Kapingamarangi"},"book":{"id":"PSA","translationId":"kpg_kpt","name":"Psalm","commonName":"Psalm","title":"PSALMS Di Beebaa Pisalem","order":19,"numberOfChapters":150,"sha256":"5d959d36cec9b93b5217ebd4703f734c225bd0920f474f5ebf8830bd0af1cfac","firstChapterNumber":1,"firstChapterApiLink":"/api/kpg_kpt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpg_kpt/PSA/150.json","totalNumberOfVerses":2454},"chapter":{"number":149,"content":[{"type":"heading","content":["Taahili hagaamu"]},{"type":"verse","number":1,"content":[{"text":"Hagaamu ina Dimaadua!","poem":1},{"lineBreak":true},{"text":"Goodou daahili ang gi Dimaadua i taahili hoou,","poem":1},{"lineBreak":true},{"text":"hagaamu ina a Mee i mua nia dagabuli o ana daangada manawa dahi!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Israel, goe gi manawa lamalia, idimaa go Mee dela ne hai goe.","poem":1},{"lineBreak":true},{"text":"Goodou, go nia daangada o Zion, goodou tenetene, idimaa go di godou king!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Goodou gaalege hagaamuina di ingoo o Maa.","poem":1},{"lineBreak":true},{"text":"Goodou daahili gi godou ‘drum’ mono ‘harp’ e hagahagaamu a Mee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dimaadua e manawa tene gi ana daangada.","poem":1},{"lineBreak":true},{"text":"Mee e hagalaamua digau ala e hila gi lala e hai digaula gi aali.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nia daangada a God la gi tenetene idimaa ginaadou gu aali,","poem":1},{"lineBreak":true},{"text":"mo di dadaahili tenetene i di boo dogomaalia.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Digaula gii wwolo gi nua ma ga hagaamu a God,","poem":1},{"lineBreak":true},{"text":"mo nadau hulumanu dauwa gaa i nadau lima,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"e hagamagedaa nia henua ge e daaligi nia daangada,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"e lawalawa nia king digaula gi nia daula baalanga,","poem":1},{"lineBreak":true},{"text":"gei nia dagi digaula e lawalawa gi nia daula baalanga mau,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"e daaligi nia henua llauehe gii hai be di hai dela gu haga noho go God.","poem":1},{"lineBreak":true},{"text":"Deenei di aali o nia daangada a God.","poem":1},{"lineBreak":true},{"text":"Hagaamuina Dimaadua!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kpg_kpt/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpg_kpt/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpg_kpt/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}