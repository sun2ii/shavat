{"translation":{"id":"kpg_kpt","name":"Beebaa Dabu","website":"https://ebible.org/Scriptures/details.php?id=kpg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpg","licenseNotes":null,"shortName":"KPT","englishName":"Kapingamarangi Bible","language":"kpg","textDirection":"ltr","sha256":"613a92619e262bf704b5b709432437e061e768142de6913dcb21bdd318239f97","availableFormats":["json"],"listOfBooksApiLink":"/api/kpg_kpt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30240,"languageName":"Kapingamarangi","languageEnglishName":"Kapingamarangi"},"book":{"id":"PSA","translationId":"kpg_kpt","name":"Psalm","commonName":"Psalm","title":"PSALMS Di Beebaa Pisalem","order":19,"numberOfChapters":150,"sha256":"5d959d36cec9b93b5217ebd4703f734c225bd0920f474f5ebf8830bd0af1cfac","firstChapterNumber":1,"firstChapterApiLink":"/api/kpg_kpt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpg_kpt/PSA/150.json","totalNumberOfVerses":2454},"chapter":{"number":23,"content":[{"type":"heading","content":["Dimaadua go tadau Hagaloohi23.0 Taahili ni David"]},{"type":"verse","number":1,"content":[{"text":"Dimaadua go dogu Hagaloohi.","poem":1},{"lineBreak":true},{"text":"Au guu dohu i nia mee huogodoo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mee e hai au gi hagamolooloo i lodo di gowaa geinga tolo humalia,","poem":1},{"lineBreak":true},{"text":"gaa dagi au gi nia monowai madammaa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mee e hagamaaloo aga au, e dagi au i lodo nia ala e donu,","poem":1},{"lineBreak":true},{"text":"e hagalaamua ai dono ingoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Meenei Dimaadua,","poem":1},{"lineBreak":true},{"text":"ma e aha maa au gaa hana i lodo di gowaa bouli dongoeho,","poem":1},{"lineBreak":true},{"text":"gei au hagalee madagu, idimaa Goe dela e madalia au.","poem":1},{"lineBreak":true},{"text":"Dau madaagoo mo dau dogodogo hagaloohi siibi e hagaloohi au.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Goe e hagatogomaalia dau hagamiami mai gi di au","poem":1},{"lineBreak":true},{"text":"i di gowaa dela e mee di mmada ai ogu hagadaumee huogodoo mai gi di au.","poem":1},{"lineBreak":true},{"text":"Goe e hagalaamua au mo di hagatulu dogu libogo gi nia lolo kala,","poem":1},{"lineBreak":true},{"text":"mo di haga hau dagu ibu gii honu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Au gu iloo bolo o humalia mo do aloho la ga noho mau madalia au","poem":1},{"lineBreak":true},{"text":"i nia laangi huogodoo ala e mouli iei au,","poem":1},{"lineBreak":true},{"text":"gei au gaa noho i doo hale i di waalooloo o dogu mouli.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kpg_kpt/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpg_kpt/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpg_kpt/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}