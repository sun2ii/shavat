{"translation":{"id":"kpg_kpt","name":"Beebaa Dabu","website":"https://ebible.org/Scriptures/details.php?id=kpg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpg","licenseNotes":null,"shortName":"KPT","englishName":"Kapingamarangi Bible","language":"kpg","textDirection":"ltr","sha256":"613a92619e262bf704b5b709432437e061e768142de6913dcb21bdd318239f97","availableFormats":["json"],"listOfBooksApiLink":"/api/kpg_kpt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30240,"languageName":"Kapingamarangi","languageEnglishName":"Kapingamarangi"},"book":{"id":"PSA","translationId":"kpg_kpt","name":"Psalm","commonName":"Psalm","title":"PSALMS Di Beebaa Pisalem","order":19,"numberOfChapters":150,"sha256":"5d959d36cec9b93b5217ebd4703f734c225bd0920f474f5ebf8830bd0af1cfac","firstChapterNumber":1,"firstChapterApiLink":"/api/kpg_kpt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpg_kpt/PSA/150.json","totalNumberOfVerses":2454},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Meenei God, haga modongoohia ina bolo au ogu huaidu ai,","poem":1},{"lineBreak":true},{"text":"gei Goe gi hagamaamaa ina au i dagu gabunga e hai baahi gi digau huaidu.","poem":1},{"lineBreak":true},{"text":"Duulia au gi daha mo digau hai kai tilikai mo digau hai mee huaidu!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Goe go dogu hagaloohi, Goe ne diiagi au beleiaha?","poem":1},{"lineBreak":true},{"text":"Ma e aha dela au e hai loo gi hagaduadua","poem":1},{"lineBreak":true},{"text":"gi haga mmaemmae go ogu hagadaumee?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hagau ina mai do maalama mo di tonu e dagi au,","poem":1},{"lineBreak":true},{"text":"ge lahi labelaa au gi muli gi dau gonduu haga madagu go Zion,","poem":1},{"lineBreak":true},{"text":"gi di gowaa dela e noho iei Goe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Meenei God, au ga hana laa gi dau gowaa dudu tigidaumaha.","poem":1},{"lineBreak":true},{"text":"Ma deelaa hua Kooe dela go di gowaa iai dogu tene.","poem":1},{"lineBreak":true},{"text":"Meenei God, au ga daahili i di ‘harp’ e hagaamu Goe, dela go dogu God.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Au e manawa gee huoloo beleiaha?","poem":1},{"lineBreak":true},{"text":"Au e de nnoomaalia huoloo beleiaha?","poem":1},{"lineBreak":true},{"text":"Ge deeai, au ga hagadagadagagee hua gi God,","poem":1},{"lineBreak":true},{"text":"gei au ga hagaamu labelaa a Mee,","poem":1},{"lineBreak":true},{"text":"dela go dogu Dangada Hagamouli mo dogu God.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kpg_kpt/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpg_kpt/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpg_kpt/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}