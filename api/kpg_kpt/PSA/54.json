{"translation":{"id":"kpg_kpt","name":"Beebaa Dabu","website":"https://ebible.org/Scriptures/details.php?id=kpg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpg","licenseNotes":null,"shortName":"KPT","englishName":"Kapingamarangi Bible","language":"kpg","textDirection":"ltr","sha256":"613a92619e262bf704b5b709432437e061e768142de6913dcb21bdd318239f97","availableFormats":["json"],"listOfBooksApiLink":"/api/kpg_kpt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30240,"languageName":"Kapingamarangi","languageEnglishName":"Kapingamarangi"},"book":{"id":"PSA","translationId":"kpg_kpt","name":"Psalm","commonName":"Psalm","title":"PSALMS Di Beebaa Pisalem","order":19,"numberOfChapters":150,"sha256":"5d959d36cec9b93b5217ebd4703f734c225bd0920f474f5ebf8830bd0af1cfac","firstChapterNumber":1,"firstChapterApiLink":"/api/kpg_kpt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpg_kpt/PSA/150.json","totalNumberOfVerses":2454},"chapter":{"number":54,"content":[{"type":"heading","content":["Talodalo abaaba nia hagadaumee54.0 Taahili ni David, ne huwa i muli digau Ziph guu hula gi Saul mo di hagamodongoohia ang gi mee bolo David la i nadau guongo. (1-Samuel 23.19, 26.1) "]},{"type":"verse","number":1,"content":[{"text":"Meenei God, haga dagaloaha ina au gi o maaloo.","poem":1},{"lineBreak":true},{"text":"Hagamehede ina au gi oo mahi!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Meenei God, hagalongo mai gi dagu dalodalo.","poem":1},{"lineBreak":true},{"text":"Hagalongo mai gi agu helekai!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Digau hagamuamua e lloomoi e heebagi mai gi di au.","poem":1},{"lineBreak":true},{"text":"Digau hagawelewele e hagamada bolo ginaadou e daaligi au gii made,","poem":1},{"lineBreak":true},{"text":"nia hagadilinga daangada ala hagalee e hagalaamua a God.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Gei God go dogu hagamaamaa. Di Tagi go dogu dangada daa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"God gi daaligidia ogu hagadaumee i nia hegau huaidu digaula ala e hai.","poem":1},{"lineBreak":true},{"text":"Mee ga daaligi digaula gi daha, idimaa Mee e manawa dahi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Meenei Dimaadua, au gaa hai dagu tigidaumaha adu gi di Goe","poem":1},{"lineBreak":true},{"text":"mo di tenetene.","poem":1},{"lineBreak":true},{"text":"Au gaa hai dagu hagaamu adu gi di Goe, idimaa Goe dela e humalia.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Goe dela ne haga dagaloaha au gi daha mo ogu haingadaa huogodoo,","poem":1},{"lineBreak":true},{"text":"gei au gu gidee ogu hagadaumee ala ne paagege.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kpg_kpt/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpg_kpt/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpg_kpt/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}