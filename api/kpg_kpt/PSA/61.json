{"translation":{"id":"kpg_kpt","name":"Beebaa Dabu","website":"https://ebible.org/Scriptures/details.php?id=kpg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpg","licenseNotes":null,"shortName":"KPT","englishName":"Kapingamarangi Bible","language":"kpg","textDirection":"ltr","sha256":"613a92619e262bf704b5b709432437e061e768142de6913dcb21bdd318239f97","availableFormats":["json"],"listOfBooksApiLink":"/api/kpg_kpt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30240,"languageName":"Kapingamarangi","languageEnglishName":"Kapingamarangi"},"book":{"id":"PSA","translationId":"kpg_kpt","name":"Psalm","commonName":"Psalm","title":"PSALMS Di Beebaa Pisalem","order":19,"numberOfChapters":150,"sha256":"5d959d36cec9b93b5217ebd4703f734c225bd0920f474f5ebf8830bd0af1cfac","firstChapterNumber":1,"firstChapterApiLink":"/api/kpg_kpt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpg_kpt/PSA/150.json","totalNumberOfVerses":2454},"chapter":{"number":61,"content":[{"type":"heading","content":["Talodalo i di abaaba61.0 Taahili ni David"]},{"type":"verse","number":1,"content":[{"text":"Meenei God, hagalongo mai gi dagu gahigahi.","poem":1},{"lineBreak":true},{"text":"Hagalongo mai gi dagu dalodalo!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I lodo hua dogu manawa gee mo dogu mogowaa i dogu guongo,","poem":1},{"lineBreak":true},{"text":"gei au e gahigahi Goe! Lahia au gi di gowaa dela e noho iei au humalia,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"idimaa Goe go dogu abaaba, dogu Dangada daa maaloo","poem":1},{"lineBreak":true},{"text":"dela e hai baahi gi ogu hagadaumee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Heia au gii noho i lodo doo hale dabu i di waalooloo o dogu mouli,","poem":1},{"lineBreak":true},{"text":"mo di noho humalia i lala di malu o bakau.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Meenei God, Goe gu longono agu hagababa,","poem":1},{"lineBreak":true},{"text":"gei Goe gu gaamai gi di au nia mee o digau ala e hagalaamua Goe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Haga waalooloo ina di mouli o di king. Heia a mee gi mouli hua beelaa!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Meenei God, heia a mee gi dagi hua beelaa i oo mua","poem":1},{"lineBreak":true},{"text":"gaa hana hua beelaa, dono hagaodi ai.","poem":1},{"lineBreak":true},{"text":"Abaaba ina a mee gi do aloho dee modu mo do manawa dahi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gei au ga dadaahili laa i nia madagoaa huogodoo e hagaamu Goe,","poem":1},{"lineBreak":true},{"text":"i dogu madagoaa ma gaa hai agu tigidaumaha","poem":1},{"lineBreak":true},{"text":"i nia laangi huogodoo adu gi di Goe i agu mee ala ne hagababa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kpg_kpt/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpg_kpt/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpg_kpt/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}