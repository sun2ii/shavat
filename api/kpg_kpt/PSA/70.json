{"translation":{"id":"kpg_kpt","name":"Beebaa Dabu","website":"https://ebible.org/Scriptures/details.php?id=kpg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpg","licenseNotes":null,"shortName":"KPT","englishName":"Kapingamarangi Bible","language":"kpg","textDirection":"ltr","sha256":"613a92619e262bf704b5b709432437e061e768142de6913dcb21bdd318239f97","availableFormats":["json"],"listOfBooksApiLink":"/api/kpg_kpt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30240,"languageName":"Kapingamarangi","languageEnglishName":"Kapingamarangi"},"book":{"id":"PSA","translationId":"kpg_kpt","name":"Psalm","commonName":"Psalm","title":"PSALMS Di Beebaa Pisalem","order":19,"numberOfChapters":150,"sha256":"5d959d36cec9b93b5217ebd4703f734c225bd0920f474f5ebf8830bd0af1cfac","firstChapterNumber":1,"firstChapterApiLink":"/api/kpg_kpt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpg_kpt/PSA/150.json","totalNumberOfVerses":2454},"chapter":{"number":70,"content":[{"type":"heading","content":["Talodalo i di hagamaamaa 70.0 Taahili manawa gee ni David"]},{"type":"verse","number":1,"content":[{"text":"Meenei God, haga dagaloaha ina au!","poem":1},{"lineBreak":true},{"text":"Meenei Dimaadua, hagamaamaa ina mai au dolomeenei!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Heia digau ala e hagamada bolo ginaadou e daaligi au gii made,","poem":1},{"lineBreak":true},{"text":"la gi paagege mo di hinihini.","poem":1},{"lineBreak":true},{"text":"Heia digau ala e tenetene gi ogu haingadaa,","poem":1},{"lineBreak":true},{"text":"la gii hula gi muli gi langaadia.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Heia digau ala e haganneennee au","poem":1},{"lineBreak":true},{"text":"la gi uli nadau gai i nadau paagege.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Heia digau huogodoo ala e lloomoi gi di Goe","poem":1},{"lineBreak":true},{"text":"la gi manawa lamalia mo di tenetene.","poem":1},{"lineBreak":true},{"text":"Heia digau ala e danggee adu gi di Goe i dau hagamouli,","poem":1},{"lineBreak":true},{"text":"la gi helehelekai i nia madagoaa huogodoo boloo, “God la koia e aamua!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Meenei God, au e bagege ge e hagaloale. Hanimoi gi di au hagalimalima.","poem":1},{"lineBreak":true},{"text":"Goe go Dimaadua, go dogu Dangada hagamouli.","poem":1},{"lineBreak":true},{"text":"Hagalimalima mai e hagamaamaa au!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kpg_kpt/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpg_kpt/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpg_kpt/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}