{"translation":{"id":"kpg_kpt","name":"Beebaa Dabu","website":"https://ebible.org/Scriptures/details.php?id=kpg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpg","licenseNotes":null,"shortName":"KPT","englishName":"Kapingamarangi Bible","language":"kpg","textDirection":"ltr","sha256":"613a92619e262bf704b5b709432437e061e768142de6913dcb21bdd318239f97","availableFormats":["json"],"listOfBooksApiLink":"/api/kpg_kpt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30240,"languageName":"Kapingamarangi","languageEnglishName":"Kapingamarangi"},"book":{"id":"PSA","translationId":"kpg_kpt","name":"Psalm","commonName":"Psalm","title":"PSALMS Di Beebaa Pisalem","order":19,"numberOfChapters":150,"sha256":"5d959d36cec9b93b5217ebd4703f734c225bd0920f474f5ebf8830bd0af1cfac","firstChapterNumber":1,"firstChapterApiLink":"/api/kpg_kpt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpg_kpt/PSA/150.json","totalNumberOfVerses":2454},"chapter":{"number":82,"content":[{"type":"heading","content":["God Tagi Aamua Huoloo82.0 Taahili ni Asaph"]},{"type":"verse","number":1,"content":[{"text":"God e dagi nia dagabuli o di langi,","poem":1},{"lineBreak":true},{"text":"i lodo nia dagabuli o nia god, gei Mee e hai dana maanadu boloo,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“Goodou hudee heia godou gabunga hai gee,","poem":1},{"lineBreak":true},{"text":"goodou hudee hegeege ina digau huaidu!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hagamaamaa ina nia donu o digau ala e hagaloale","poem":1},{"lineBreak":true},{"text":"mo nia dama ala gu deai nadau maadua ai.","poem":1},{"lineBreak":true},{"text":"Hai gabunga gi humalia gi digau ala nadau mee ai","poem":1},{"lineBreak":true},{"text":"mo digau ala nadau hagamaamaa ai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hagadagaloaha ina digaula gi daha mo nia mogobuna o digau huaidu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Goodou e de iloo beleiaha?","poem":1},{"lineBreak":true},{"text":"Goodou e de kabemee beleiaha!","poem":1},{"lineBreak":true},{"text":"Goodou e hala huoloo, deelaa di mee ne hidi ai nia donu gu hagalee","poem":1},{"lineBreak":true},{"text":"gi daha mo henuailala nei.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gei Au guu hai bolo goodou la nia god,","poem":1},{"lineBreak":true},{"text":"goodou huogodoo la nia dama ni di Gowaa Aamua huoloo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Malaa, goodou la gaa mmade gadoo be nia daangada dangada.","poem":1},{"lineBreak":true},{"text":"Godou mouli la ga hagalee gadoo be nia mouli nia dama daane di king.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Meenei God, hanimoi e dagi henuailala.","poem":1},{"lineBreak":true},{"text":"Nia henua llauehe huogodoo la nia mee ni aau.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kpg_kpt/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpg_kpt/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpg_kpt/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}