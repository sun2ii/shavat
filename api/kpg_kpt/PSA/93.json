{"translation":{"id":"kpg_kpt","name":"Beebaa Dabu","website":"https://ebible.org/Scriptures/details.php?id=kpg","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpg","licenseNotes":null,"shortName":"KPT","englishName":"Kapingamarangi Bible","language":"kpg","textDirection":"ltr","sha256":"613a92619e262bf704b5b709432437e061e768142de6913dcb21bdd318239f97","availableFormats":["json"],"listOfBooksApiLink":"/api/kpg_kpt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30240,"languageName":"Kapingamarangi","languageEnglishName":"Kapingamarangi"},"book":{"id":"PSA","translationId":"kpg_kpt","name":"Psalm","commonName":"Psalm","title":"PSALMS Di Beebaa Pisalem","order":19,"numberOfChapters":150,"sha256":"5d959d36cec9b93b5217ebd4703f734c225bd0920f474f5ebf8830bd0af1cfac","firstChapterNumber":1,"firstChapterApiLink":"/api/kpg_kpt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpg_kpt/PSA/150.json","totalNumberOfVerses":2454},"chapter":{"number":93,"content":[{"type":"heading","content":["Dimaadua la di King"]},{"type":"verse","number":1,"content":[{"text":"Dimaadua la di King.","poem":1},{"lineBreak":true},{"text":"Mee e laagei gi nia mahi mo nia madamada.","poem":1},{"lineBreak":true},{"text":"Henuailala gu mau dangihi gi dono lohongo, gu deemee di ngalungalua.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Meenei Dimaadua, do lohongo king la nogo mau dangihi mai loo i taamada,","poem":1},{"lineBreak":true},{"text":"gaa dae mai gi dangi nei, gei Goe nogo i golo mai taamada.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Meenei Dimaadua, di llala di moana e ngoloolo, digaula e ngoloolo loo gi nua.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dimaadua e dagi di langi i ono mogobuna.","poem":1},{"lineBreak":true},{"text":"Ono mogobuna koia e mahi i di ngoloolo o di moana,","poem":1},{"lineBreak":true},{"text":"ge koia e maaloo i nia beau llauehaa o di moana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Meenei Dimaadua, au haganoho le e waalooloo hua beelaa,","poem":1},{"lineBreak":true},{"text":"gei do Hale Daumaha la koia e dabuaahia huoloo, gaa hana hua beelaa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kpg_kpt/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpg_kpt/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpg_kpt/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}