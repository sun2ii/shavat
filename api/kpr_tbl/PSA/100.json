{"translation":{"id":"kpr_tbl","name":"God Da Geka Seka","website":"https://ebible.org/Scriptures/details.php?id=kpr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpr","licenseNotes":null,"shortName":"TBL","englishName":"Korafe NT+Psalms","language":"kpr","textDirection":"ltr","sha256":"e4fec1273e818d263fec764dd7d3b93a6206d5d8adde54591259292f615bef01","availableFormats":["json"],"listOfBooksApiLink":"/api/kpr_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10065,"languageName":"Korafe-Yegha","languageEnglishName":"Korafe-Yegha"},"book":{"id":"PSA","translationId":"kpr_tbl","name":"Yaru Divariri","commonName":"Yaru Divariri","title":"Banungari Da Yaruri","order":19,"numberOfChapters":150,"sha256":"52a67016f8c953ee0f4b75319b1ce45a66578472daf567660c25c24e17d3f9eb","firstChapterNumber":1,"firstChapterApiLink":"/api/kpr_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpr_tbl/PSA/150.json","totalNumberOfVerses":2422},"chapter":{"number":100,"content":[{"type":"heading","content":["Aiyakoe Sari Da Yaruri."]},{"type":"verse","number":1,"content":[{"text":"Namonde isambu endada irera, dubo evevaghae beka fainghedo, Bajari kena yaru divore!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nunda geka ningido, ivugaghae yaru didivuse,","poem":1},{"text":"nunda dombuda tere fetore!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Aminguse, namonde kasama arera:","poem":1},{"text":"God nu Bajariri! Namonde jo namondeda kotariimi siroraeri.","poem":2},{"lineBreak":true},{"text":"Namonde, God nune setiri siroruseri. Namonde nunda natofori, nu namonde kaifa eraira.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nunda kambo guro teria afigetiri irira aminda, “aiyakoe” sise, ya terore!","poem":1},{"text":"Ya nundae sakai sise, jokáda terore!","poem":2},{"lineBreak":true},{"text":"Nundae “aiyakoe” sise, nunda javo kakara aore!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ainda beká mo: Bajari sifo ghousa evia veka eveva use irira.","poem":1},{"text":"Nu kavevera ari kato a joka ari katori.","poem":2},{"lineBreak":true},{"text":"Nu namonde joka use, dubo budo ghusira, dubo buraira, a dubo ruruse irarira.","poem":2},{"lineBreak":true},{"text":"Nunda kaifa ari mo, namondeda imemesiri siroruse itatamudo yarera.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kpr_tbl/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpr_tbl/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpr_tbl/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}