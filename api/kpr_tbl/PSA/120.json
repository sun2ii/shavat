{"translation":{"id":"kpr_tbl","name":"God Da Geka Seka","website":"https://ebible.org/Scriptures/details.php?id=kpr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpr","licenseNotes":null,"shortName":"TBL","englishName":"Korafe NT+Psalms","language":"kpr","textDirection":"ltr","sha256":"e4fec1273e818d263fec764dd7d3b93a6206d5d8adde54591259292f615bef01","availableFormats":["json"],"listOfBooksApiLink":"/api/kpr_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10065,"languageName":"Korafe-Yegha","languageEnglishName":"Korafe-Yegha"},"book":{"id":"PSA","translationId":"kpr_tbl","name":"Yaru Divariri","commonName":"Yaru Divariri","title":"Banungari Da Yaruri","order":19,"numberOfChapters":150,"sha256":"52a67016f8c953ee0f4b75319b1ce45a66578472daf567660c25c24e17d3f9eb","firstChapterNumber":1,"firstChapterApiLink":"/api/kpr_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpr_tbl/PSA/150.json","totalNumberOfVerses":2422},"chapter":{"number":120,"content":[{"type":"heading","content":["Sonemba Dae Banungariri"]},{"type":"verse","number":1,"content":[{"text":"Na darada fetedo ghusena da sifo aminda,","poem":1},{"text":"Bajari namo sonembare dae banungedo ghuseni.","poem":2},{"text":"Banungeono ningido na nune sonembedo ghusira.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Arie Bajari, namoa gungubo kakato","poem":1},{"text":"a derari kakato eikena bu darigaso dae resena.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gungubo kakato, God nendae nange ari?","poem":1},{"text":"Nu nendae kau nange ari ghamo barevu?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne taká isoro emboda feva da goroba mendó sighonogo aimi gae babasiguse,","poem":1},{"text":"avaraka imo kokoigo beká aimi dungari avareva.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nenda jokáda irari mo, eko bekári, kau esa yavai ya,","poem":1},{"text":"evetu genembo nenda otu ekoko reighi Meseki o Keda","poem":2},{"noteId":48},{"text":"embo ainda irari da kaugori.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Na evetu genembo beisiga tataya kakatode ghousa futo irana,","poem":1},{"text":"imboe beká erira.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Na dubo jama da genembori,","poem":1},{"text":"avata ne nanjigo beisiga tataya dodo iroro dae sarena amo,","poem":3},{"lineBreak":true},{"text":"ne isoro ari dae sarera.","poem":3}]}],"footnotes":[{"noteId":48,"caller":"+","text":"Meseki o Keda: reighi etoto naká emo jo utua iraeri, sokari. Evetu genembo aminda iritirera amo ekoko beká, nenda otu ekokori.","reference":{"chapter":120,"verse":5}}]},"thisChapterLink":"/api/kpr_tbl/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpr_tbl/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpr_tbl/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}