{"translation":{"id":"kpr_tbl","name":"God Da Geka Seka","website":"https://ebible.org/Scriptures/details.php?id=kpr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpr","licenseNotes":null,"shortName":"TBL","englishName":"Korafe NT+Psalms","language":"kpr","textDirection":"ltr","sha256":"e4fec1273e818d263fec764dd7d3b93a6206d5d8adde54591259292f615bef01","availableFormats":["json"],"listOfBooksApiLink":"/api/kpr_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10065,"languageName":"Korafe-Yegha","languageEnglishName":"Korafe-Yegha"},"book":{"id":"PSA","translationId":"kpr_tbl","name":"Yaru Divariri","commonName":"Yaru Divariri","title":"Banungari Da Yaruri","order":19,"numberOfChapters":150,"sha256":"52a67016f8c953ee0f4b75319b1ce45a66578472daf567660c25c24e17d3f9eb","firstChapterNumber":1,"firstChapterApiLink":"/api/kpr_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpr_tbl/PSA/150.json","totalNumberOfVerses":2422},"chapter":{"number":123,"content":[{"type":"heading","content":["Bajari Nange Joka Aetira, Ainda Banungariri."]},{"type":"verse","number":1,"content":[{"text":"Arie Bajari, ni utu ominda irise utu enda kaifa eraesa aindae,","poem":1},{"text":"nanda dombu nimokena faingherena.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Arie Bajari, namaneda God, kau sabua kakato gegenembo o evevetu bayau a sonemba nenda","poem":1},{"text":"babojegarikena buraera aminga ava, namaneda dombu nimokena","poem":2},{"lineBreak":true},{"text":"fifituse iroro, namanendae joka edo sonembaetesi!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Arie Bajari, namanedae joka e! Namanendae joka beká aso dae resena.","poem":1},{"text":"Ai resira, evetu genembo namane ighagha use, sino fukadae ari geraera.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iti fafo gugua ghayafade aimi namane ava teria futo ighagha use,","poem":1},{"text":"jo evetu genembo irae sise, sero, namane irari barago erera.","poem":2},{"text":"Ainghae dabade, meka irae ivuga tefo tefo ari kakatoimi namane ava kateyavara beká use irera.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kpr_tbl/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpr_tbl/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpr_tbl/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}