{"translation":{"id":"kpr_tbl","name":"God Da Geka Seka","website":"https://ebible.org/Scriptures/details.php?id=kpr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpr","licenseNotes":null,"shortName":"TBL","englishName":"Korafe NT+Psalms","language":"kpr","textDirection":"ltr","sha256":"e4fec1273e818d263fec764dd7d3b93a6206d5d8adde54591259292f615bef01","availableFormats":["json"],"listOfBooksApiLink":"/api/kpr_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10065,"languageName":"Korafe-Yegha","languageEnglishName":"Korafe-Yegha"},"book":{"id":"PSA","translationId":"kpr_tbl","name":"Yaru Divariri","commonName":"Yaru Divariri","title":"Banungari Da Yaruri","order":19,"numberOfChapters":150,"sha256":"52a67016f8c953ee0f4b75319b1ce45a66578472daf567660c25c24e17d3f9eb","firstChapterNumber":1,"firstChapterApiLink":"/api/kpr_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpr_tbl/PSA/150.json","totalNumberOfVerses":2422},"chapter":{"number":124,"content":[{"type":"heading","content":["Nunda Natofo Da Gagara Ari Kato, God Numori."]},{"type":"verse","number":1,"content":[{"text":"Bajari, namonde jo sorae aetira amo, namonde nange aeteri?","poem":1},{"text":"Arie, Israel embo sevu!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“Gitofui janje ekoko beká use, namonde dedo gaedo ghari dae isoro edo ghusera ainda sifo aminda,","poem":1},{"text":"Bajari namonde jo sorae aetira amo, ne namonde diti jebuga dukunghaeteri.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Useghai roera bu sivari guse,","poem":1},{"text":"uvuimi fati tifughari geraira aminga ava, gitofuimi namondekena aeteri.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"O eva babai aimi ghasemo fatari,","poem":1},{"text":"natofo mindi sirivo arigaetera aminga ava, gitofuimi namondekena aeteri.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Avata erevu! Namonde Bajari dae aiyakoe saore,","poem":1},{"text":"nu jo doyari gitofui namonde sosighi aeri.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Namonde kau rika vatafa fitari kakato da vatafada kosughe buvari guseri,","poem":1},{"text":"vatafa da asi tafusegetiri, namonde jebuguseri.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Namondeda sonemba Bajari utu enda ari katoimi nusuka nune eraira.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kpr_tbl/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpr_tbl/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpr_tbl/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":7}