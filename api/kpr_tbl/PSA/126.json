{"translation":{"id":"kpr_tbl","name":"God Da Geka Seka","website":"https://ebible.org/Scriptures/details.php?id=kpr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpr","licenseNotes":null,"shortName":"TBL","englishName":"Korafe NT+Psalms","language":"kpr","textDirection":"ltr","sha256":"e4fec1273e818d263fec764dd7d3b93a6206d5d8adde54591259292f615bef01","availableFormats":["json"],"listOfBooksApiLink":"/api/kpr_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10065,"languageName":"Korafe-Yegha","languageEnglishName":"Korafe-Yegha"},"book":{"id":"PSA","translationId":"kpr_tbl","name":"Yaru Divariri","commonName":"Yaru Divariri","title":"Banungari Da Yaruri","order":19,"numberOfChapters":150,"sha256":"52a67016f8c953ee0f4b75319b1ce45a66578472daf567660c25c24e17d3f9eb","firstChapterNumber":1,"firstChapterApiLink":"/api/kpr_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpr_tbl/PSA/150.json","totalNumberOfVerses":2422},"chapter":{"number":126,"content":[{"type":"heading","content":["Gitofukena Bu Darigusera Aindae Sakai Siseri."]},{"type":"verse","number":1,"content":[{"text":"Bajari namonde gitofu reighida ghedo","poem":1},{"text":"bu jovereghe sekago Jerusalem eminda,","poem":2},{"text":"bu fusira amo, namonde jo tumondaeri.","poem":1},{"text":"Kau aturu ari guseri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amingedo, namonde ava ivuga use,","poem":1},{"lineBreak":true},{"text":"ivugai gegha kekeku sise jighi fumbu aruguseri.","poem":1},{"text":"Aminguse irero, oro mendeni gido namondedae eminge siseri,","poem":2},{"lineBreak":true},{"text":"“Bajari, nendae roera babaigo erira.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Ai bekári,” siseri. Nu namondedae roera babaigo ava usira.","poem":1},{"text":"Etiri, namonde dubo jama erera.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Arie Bajari, kau iji feteari uvu saghedo iriari borija sekago dise,","poem":1},{"text":"uvu gaunghe viti betu bamburaira aminga ava, namane enda eminda irari kena esimbugaso sekago iti fafode aore!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mave soraraghae govusera, ivugaghae je gambedo gharera.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mave jivu menjuga gutuse, roera veka fumbu govari dae isera,","poem":1},{"text":"je gambedo sigina sagina edo,","poem":2},{"text":"jovereghe kuvai ghae furarera.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/kpr_tbl/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpr_tbl/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpr_tbl/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}