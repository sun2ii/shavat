{"translation":{"id":"kpr_tbl","name":"God Da Geka Seka","website":"https://ebible.org/Scriptures/details.php?id=kpr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpr","licenseNotes":null,"shortName":"TBL","englishName":"Korafe NT+Psalms","language":"kpr","textDirection":"ltr","sha256":"e4fec1273e818d263fec764dd7d3b93a6206d5d8adde54591259292f615bef01","availableFormats":["json"],"listOfBooksApiLink":"/api/kpr_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10065,"languageName":"Korafe-Yegha","languageEnglishName":"Korafe-Yegha"},"book":{"id":"PSA","translationId":"kpr_tbl","name":"Yaru Divariri","commonName":"Yaru Divariri","title":"Banungari Da Yaruri","order":19,"numberOfChapters":150,"sha256":"52a67016f8c953ee0f4b75319b1ce45a66578472daf567660c25c24e17d3f9eb","firstChapterNumber":1,"firstChapterApiLink":"/api/kpr_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpr_tbl/PSA/150.json","totalNumberOfVerses":2422},"chapter":{"number":127,"content":[{"type":"heading","content":["God Da Ari Evevago Aindae Sakai Saore!"]},{"type":"verse","number":1,"content":[{"text":"Bajari kambo jo itae arira amo, kambo itari embo nenda fakina soesa arera.","poem":1},{"text":"Reighi bogu begaya ava Bajari jo gagara ae arira amo,","poem":2},{"text":"gitofu kato ari embo nenda fakina soesa arera.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Oka bayaudae sifo ataeda ere tumba jirari soroda avido ghari mo,","poem":1},{"text":"jo eveva iraeri. Ai resira, Bajari mavejoa dubo buraira aikena,","poem":2},{"text":"ne aviroro nune muturaira.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mandi sasingu mo fuyori, Bajari muturaira. Esimbugari beká nemori.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Vide jamena genembo seka bajarikena siroreraera amo,","poem":1},{"lineBreak":true},{"text":"kau isoro embo feva da goroba eni afari dae sise, fitiri irira, amingori.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Genembo mave vide jamena digari sari sirorarera amo,","poem":1},{"text":"koto sifoda, nunda geka bouvu arira.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kpr_tbl/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpr_tbl/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpr_tbl/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}