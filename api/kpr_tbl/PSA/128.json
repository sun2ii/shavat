{"translation":{"id":"kpr_tbl","name":"God Da Geka Seka","website":"https://ebible.org/Scriptures/details.php?id=kpr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpr","licenseNotes":null,"shortName":"TBL","englishName":"Korafe NT+Psalms","language":"kpr","textDirection":"ltr","sha256":"e4fec1273e818d263fec764dd7d3b93a6206d5d8adde54591259292f615bef01","availableFormats":["json"],"listOfBooksApiLink":"/api/kpr_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10065,"languageName":"Korafe-Yegha","languageEnglishName":"Korafe-Yegha"},"book":{"id":"PSA","translationId":"kpr_tbl","name":"Yaru Divariri","commonName":"Yaru Divariri","title":"Banungari Da Yaruri","order":19,"numberOfChapters":150,"sha256":"52a67016f8c953ee0f4b75319b1ce45a66578472daf567660c25c24e17d3f9eb","firstChapterNumber":1,"firstChapterApiLink":"/api/kpr_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpr_tbl/PSA/150.json","totalNumberOfVerses":2422},"chapter":{"number":128,"content":[{"type":"heading","content":["Bajari Da Uju Mave Arera, Aikena Mino Mutarira."]},{"type":"verse","number":1,"content":[{"text":"Mave Bajari da uju ava use, nunda amboda amboda arira amo,","poem":1},{"text":"ne ivugaghae irarera.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ni rejodae saramana eraesa,","poem":1},{"text":"ainda beká ava sirorari baresa.","poem":2},{"text":"Budo, susu iti fafode edo, ivugaghae iraresa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nearo kau vaini da asi jigharigo amingori,","poem":1},{"text":"sasingu ghagurago beká fumbarira.","poem":2},{"text":"Ni bayau mindari dae anumbaresa amo, ninda vide jamena ghaguruimi anumbe jimbe birurugharera ava,","poem":1},{"text":"kau ika orivi tamonda batuno sasangi birurugheraira, amingori.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Genembo mave Bajari da uju ava use irá gheraira amo,","poem":1},{"text":"Bajari nu setena ava, aminguse esimbugarira.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bajari Saion irise,","poem":1},{"noteId":50},{"text":"ni esimbugare! Ni jo ambae ghousa mavega ava","poem":1},{"text":"iraresa, Jerusalem aminda gugua ghayafa iti fafode arira gaso dae resena!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"A kotugo, ni jo ambae irise, ninda imemesiri siroraoro gaso dae resena.","poem":1},{"lineBreak":true},{"text":"Dubo jama Israel embokena irare!","poem":1}]}],"footnotes":[{"noteId":50,"caller":"+","text":"Afige, geka eni Saion dae gefusera, tuturo 2:6 duruda tege, garesa!","reference":{"chapter":128,"verse":5}}]},"thisChapterLink":"/api/kpr_tbl/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpr_tbl/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpr_tbl/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}