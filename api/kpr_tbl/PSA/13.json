{"translation":{"id":"kpr_tbl","name":"God Da Geka Seka","website":"https://ebible.org/Scriptures/details.php?id=kpr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpr","licenseNotes":null,"shortName":"TBL","englishName":"Korafe NT+Psalms","language":"kpr","textDirection":"ltr","sha256":"e4fec1273e818d263fec764dd7d3b93a6206d5d8adde54591259292f615bef01","availableFormats":["json"],"listOfBooksApiLink":"/api/kpr_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10065,"languageName":"Korafe-Yegha","languageEnglishName":"Korafe-Yegha"},"book":{"id":"PSA","translationId":"kpr_tbl","name":"Yaru Divariri","commonName":"Yaru Divariri","title":"Banungari Da Yaruri","order":19,"numberOfChapters":150,"sha256":"52a67016f8c953ee0f4b75319b1ce45a66578472daf567660c25c24e17d3f9eb","firstChapterNumber":1,"firstChapterApiLink":"/api/kpr_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpr_tbl/PSA/150.json","totalNumberOfVerses":2422},"chapter":{"number":13,"content":[{"type":"heading","content":["Sonemba Bari Da Banungariri."]},{"type":"verse","number":1,"content":[{"text":"Arie Bajari, ni ghousa kau mavega ava na kotae aresi?","poem":1},{"text":"Ai, kotae beká usesi.","poem":2},{"text":"Ghousa mavega ava na nimo geono dae sise jungeraesi?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Atá ghousa mavega ava mema bouvu ghae irareni?","poem":1},{"text":"Sifo tumba evia inono nanda ghamo joká memaimi bedo edo, irá gheraira amo, mavegori?","poem":2},{"lineBreak":true},{"text":"Nanda gitofui na de atai fafotusera ava, na ghousa mavega irareni?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Arie Bajari, nanda God, namoá fuge gido, nanda benunu ningido, mino saetesi!","poem":1},{"text":"Nanda fakina sekago mutaso baeteni, erá doyeoso na ambeone!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Erá doyeoso, nanda gitofuimi, “Namane nu de atai fateri!” seore!","poem":1},{"text":"Kotugo, doyeoso, nandae, “Makoede, durira!” seore!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"O ni nandae veka eveva use, na dubo buraesa, aminda gaiga gayeraena.","poem":1},{"text":"Na saso jebugarena aindae, na riria arena.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Arie Bajari, na nindae yaru divarena da beká mo,","poem":1},{"text":"namokena veka eveva eraesa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kpr_tbl/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpr_tbl/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpr_tbl/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}