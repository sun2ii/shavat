{"translation":{"id":"kpr_tbl","name":"God Da Geka Seka","website":"https://ebible.org/Scriptures/details.php?id=kpr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpr","licenseNotes":null,"shortName":"TBL","englishName":"Korafe NT+Psalms","language":"kpr","textDirection":"ltr","sha256":"e4fec1273e818d263fec764dd7d3b93a6206d5d8adde54591259292f615bef01","availableFormats":["json"],"listOfBooksApiLink":"/api/kpr_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10065,"languageName":"Korafe-Yegha","languageEnglishName":"Korafe-Yegha"},"book":{"id":"PSA","translationId":"kpr_tbl","name":"Yaru Divariri","commonName":"Yaru Divariri","title":"Banungari Da Yaruri","order":19,"numberOfChapters":150,"sha256":"52a67016f8c953ee0f4b75319b1ce45a66578472daf567660c25c24e17d3f9eb","firstChapterNumber":1,"firstChapterApiLink":"/api/kpr_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpr_tbl/PSA/150.json","totalNumberOfVerses":2422},"chapter":{"number":131,"content":[{"type":"heading","content":["Tumbedo Irise Tumondari Da Banungari."]},{"type":"verse","number":1,"content":[{"text":"Arie Bajari, na ivuga use, nandae sakai saore dae edo ghusena","poem":1},{"text":"ava imboe edo dotutuse, meka irae namo gaore dae jajaghedo","poem":2},{"text":"ghusena ava dotutuseni.","poem":1},{"text":"Na roera babaigo garigarigo kokotofu kasama kakato da ari","poem":2},{"text":"jo nanda ari da kaugo irae ava ari dae jo kotari futo ae eraena.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tatera, na durumugeteno nanda janje joká jama etira.","poem":1},{"text":"Kau sasingu ami mindari noi da ami gambu beka do","poem":2},{"text":"songhe fase irá gheraira aminga ava,","poem":1},{"text":"nanda janje joká isambu songhetira.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Arie Israel embo, oroko eitano sifo ghousa evovodae","poem":1},{"text":"nenda tumondari Bajari kena fifituse irivu!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kpr_tbl/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpr_tbl/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpr_tbl/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}