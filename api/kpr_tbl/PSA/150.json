{"translation":{"id":"kpr_tbl","name":"God Da Geka Seka","website":"https://ebible.org/Scriptures/details.php?id=kpr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpr","licenseNotes":null,"shortName":"TBL","englishName":"Korafe NT+Psalms","language":"kpr","textDirection":"ltr","sha256":"e4fec1273e818d263fec764dd7d3b93a6206d5d8adde54591259292f615bef01","availableFormats":["json"],"listOfBooksApiLink":"/api/kpr_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10065,"languageName":"Korafe-Yegha","languageEnglishName":"Korafe-Yegha"},"book":{"id":"PSA","translationId":"kpr_tbl","name":"Yaru Divariri","commonName":"Yaru Divariri","title":"Banungari Da Yaruri","order":19,"numberOfChapters":150,"sha256":"52a67016f8c953ee0f4b75319b1ce45a66578472daf567660c25c24e17d3f9eb","firstChapterNumber":1,"firstChapterApiLink":"/api/kpr_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpr_tbl/PSA/150.json","totalNumberOfVerses":2422},"chapter":{"number":150,"content":[{"type":"heading","content":["Bajari dae Sakai Sari Yarure."]},{"type":"verse","number":1,"content":[{"text":"Bajari dae sakai sevu!","poem":1},{"lineBreak":true},{"text":"God nunda Kambo Kakara jokáda irira, nundae sakai sevu!","poem":1},{"text":"Nu utuda irise, nunda fakina ijugeraira aindae, nundae sakai sevu!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nunda ari fakina rea edo ghusira aindae, nundae sakai sevu!","poem":1},{"text":"Numo teria bekári aindae, nundae sakai sevu!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tavuya bu fusise, nundae sakai sevu!","poem":1},{"text":"Gita","poem":2},{"noteId":63},{"text":"dombu eni dombu eni roera mendeni avavaga bu doruse, nundae sakai sevu!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Divari sino bu doruse ivisa use, nundae sakai sevu!","poem":1},{"text":"Sino (guitars) bu doruse, a feku fusise, nundae sakai sevu!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Roera ghasaghasa, baighara avavaga bu ivisa use, nundae sakai sevu!","poem":1},{"text":"Roera eni simbaro (cymbals) seraera, mereki da kaugo ava","poem":2},{"lineBreak":true},{"text":"ungo soveni-soveni bu doruse, fumbu aruguse,","poem":2},{"text":"nundae sakai sevu!","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Evetu genembo, sino fuka, ã roera jebuga irise,","poem":1},{"text":"ghamo asegeraera isambu, nundae sakai sevu!","poem":2},{"text":"Bajari dae sakai sevu!","poem":1}]}],"footnotes":[{"noteId":63,"caller":"+","text":"Afige, geka eni gita o uka dae gefusera, tuturo 32:2 duruda tege, garesa!","reference":{"chapter":150,"verse":3}}]},"thisChapterLink":"/api/kpr_tbl/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpr_tbl/MAT/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpr_tbl/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}