{"translation":{"id":"kpr_tbl","name":"God Da Geka Seka","website":"https://ebible.org/Scriptures/details.php?id=kpr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpr","licenseNotes":null,"shortName":"TBL","englishName":"Korafe NT+Psalms","language":"kpr","textDirection":"ltr","sha256":"e4fec1273e818d263fec764dd7d3b93a6206d5d8adde54591259292f615bef01","availableFormats":["json"],"listOfBooksApiLink":"/api/kpr_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10065,"languageName":"Korafe-Yegha","languageEnglishName":"Korafe-Yegha"},"book":{"id":"PSA","translationId":"kpr_tbl","name":"Yaru Divariri","commonName":"Yaru Divariri","title":"Banungari Da Yaruri","order":19,"numberOfChapters":150,"sha256":"52a67016f8c953ee0f4b75319b1ce45a66578472daf567660c25c24e17d3f9eb","firstChapterNumber":1,"firstChapterApiLink":"/api/kpr_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpr_tbl/PSA/150.json","totalNumberOfVerses":2422},"chapter":{"number":3,"content":[{"type":"heading","content":["Sonemba Da Benunuri"]},{"type":"verse","number":1,"content":[{"text":"Arie, Bajari, nanda gitofu digarigo eredo,","poem":1},{"text":"namokena osogo bu refera.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne namoá ava sise eminge resera,","poem":1},{"text":"“God ni jo sonembae arira.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Avata arie, Bajari, ni sifo ghousa evia inono nanda dara jokáda nanda beredae buraena.","poem":1},{"lineBreak":true},{"text":"Ni nandae ninda duró muturaesa.","poem":1},{"text":"Edo nanda fakina mutari kato nimori.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Na Bajari da sonembadae kori sirureono,","poem":1},{"text":"nu nunda doriri kakara aminda irise,","poem":2},{"text":"nanda kori ningiraira.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Na tumba ghousa eveva aviraena da beká mo,","poem":1},{"text":"Bajari nu na kaifa eraira.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nanda gitofu nanjogoimi na jimbe birurugherera aindae,","poem":1},{"text":"na jo oju ae arena.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Arie, Bajari, ere fu! Namo sonembase, nanda God!","poem":1},{"text":"Nanda gitofu sovoda dege, nenda fakina rojare!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sonemba mo, Bajari kena ghe foa gheraira.","poem":1},{"text":"Nunda esimbugari nunda natofokena irare!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kpr_tbl/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpr_tbl/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpr_tbl/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}