{"translation":{"id":"kpr_tbl","name":"God Da Geka Seka","website":"https://ebible.org/Scriptures/details.php?id=kpr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpr","licenseNotes":null,"shortName":"TBL","englishName":"Korafe NT+Psalms","language":"kpr","textDirection":"ltr","sha256":"e4fec1273e818d263fec764dd7d3b93a6206d5d8adde54591259292f615bef01","availableFormats":["json"],"listOfBooksApiLink":"/api/kpr_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10065,"languageName":"Korafe-Yegha","languageEnglishName":"Korafe-Yegha"},"book":{"id":"PSA","translationId":"kpr_tbl","name":"Yaru Divariri","commonName":"Yaru Divariri","title":"Banungari Da Yaruri","order":19,"numberOfChapters":150,"sha256":"52a67016f8c953ee0f4b75319b1ce45a66578472daf567660c25c24e17d3f9eb","firstChapterNumber":1,"firstChapterApiLink":"/api/kpr_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpr_tbl/PSA/150.json","totalNumberOfVerses":2422},"chapter":{"number":54,"content":[{"type":"heading","content":["Bajari Nu Nange Gitofukena Gagara Aetira, Ainda Banungariri."]},{"type":"verse","number":1,"content":[{"text":"Arie, God, ninda javo fakinagoimi na sonembuse, vujege jebugaone!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Arie, God, nanda benunu resena evia, ningaso dae resena!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ivuga kakato namo dari dae refera. Evetu genembo joka ari tefo, God ningi ningae eraera,","poem":1},{"text":"aimi namo tambu doaro ambono dae refera.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Avata, nanda sonemba a sorega fumbari kato mo, God numori.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gitofu nandae ari ekoko ari seraera, aimi jovereghe nemoa gayare! Nu rea ari sisira ava use, ne sosighi arira.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Arie Bajari, na ivugaghae joba nimokena mutarena.","poem":1},{"text":"Ni kavevera eraesa aindae, na nimokena aiyakoe sise sakai sarena.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Na dara nanjogo da jokáda ireno, na bu darigeteso jebuguseni.","poem":1},{"text":"Nanda gitofo doreso, nanda diti mokoi gosuseni.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/kpr_tbl/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpr_tbl/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpr_tbl/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}