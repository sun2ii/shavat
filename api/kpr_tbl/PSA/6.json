{"translation":{"id":"kpr_tbl","name":"God Da Geka Seka","website":"https://ebible.org/Scriptures/details.php?id=kpr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpr","licenseNotes":null,"shortName":"TBL","englishName":"Korafe NT+Psalms","language":"kpr","textDirection":"ltr","sha256":"e4fec1273e818d263fec764dd7d3b93a6206d5d8adde54591259292f615bef01","availableFormats":["json"],"listOfBooksApiLink":"/api/kpr_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10065,"languageName":"Korafe-Yegha","languageEnglishName":"Korafe-Yegha"},"book":{"id":"PSA","translationId":"kpr_tbl","name":"Yaru Divariri","commonName":"Yaru Divariri","title":"Banungari Da Yaruri","order":19,"numberOfChapters":150,"sha256":"52a67016f8c953ee0f4b75319b1ce45a66578472daf567660c25c24e17d3f9eb","firstChapterNumber":1,"firstChapterApiLink":"/api/kpr_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpr_tbl/PSA/150.json","totalNumberOfVerses":2422},"chapter":{"number":6,"content":[{"type":"heading","content":["Dara Itatama Use Sonemba Bari Da Benunuri."]},{"type":"verse","number":1,"content":[{"text":"Arie Bajari, erá nandae janje eko use na dombuda seose!","poem":1},{"text":"Ninda dubo ekoko ariimi erá nandae mema muteose!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Arie Bajari, namokena fakina dadabetira, nandae joka aetesi.","poem":1},{"text":"Na gofedo irena, ava sedo fakina bofu baone.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nanda jebuga isambu fakarago, dara bouvugo beká ava itatama eraena.","poem":2},{"text":"Arie Bajari, ni nanjigo nembo na sonembaresi?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Fu, na sonembase!","poem":1},{"text":"Bajari, nandae joka use, erá ambeono dae sise, na saghimbe bu!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ambari embo da vasa aminda mave ni jo kotae eraera.","poem":1},{"text":"Aminda mave eniimi nindae jo sakai sae eraera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Na dubo mema aimi tumba evia mema itatama use, gevei erena. Nanda avari vasa jivui safegeraira.","poem":1},{"text":"Nanda guto jivuimi sasaka eraira.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gitofuimi mema futero","poem":1},{"text":"na sorara eno diti babojegetiri, gari erebunena.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bajari, nanda sorara ningira. Ava sedo, ari eko embo nemokena resena, na do darige esike fetevu!","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Namo sonembare dae sorara eraena, nu nininguse,","poem":2},{"lineBreak":true},{"text":"nanda benunu da mino muturaira.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nanda gitofu mo, ne meka gosuse manamana arera.","poem":1},{"text":"Edo, dudukughe manamana ururoro, ondari darigarera.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kpr_tbl/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpr_tbl/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpr_tbl/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}