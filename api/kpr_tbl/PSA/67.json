{"translation":{"id":"kpr_tbl","name":"God Da Geka Seka","website":"https://ebible.org/Scriptures/details.php?id=kpr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpr","licenseNotes":null,"shortName":"TBL","englishName":"Korafe NT+Psalms","language":"kpr","textDirection":"ltr","sha256":"e4fec1273e818d263fec764dd7d3b93a6206d5d8adde54591259292f615bef01","availableFormats":["json"],"listOfBooksApiLink":"/api/kpr_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10065,"languageName":"Korafe-Yegha","languageEnglishName":"Korafe-Yegha"},"book":{"id":"PSA","translationId":"kpr_tbl","name":"Yaru Divariri","commonName":"Yaru Divariri","title":"Banungari Da Yaruri","order":19,"numberOfChapters":150,"sha256":"52a67016f8c953ee0f4b75319b1ce45a66578472daf567660c25c24e17d3f9eb","firstChapterNumber":1,"firstChapterApiLink":"/api/kpr_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpr_tbl/PSA/150.json","totalNumberOfVerses":2422},"chapter":{"number":67,"content":[{"type":"heading","content":["God Kena Aiyakoe Sari Da Yaruri."]},{"type":"verse","number":1,"content":[{"text":"Arie God namanendae joka use esimbugase! Namanendae kavevera ase!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Amingaresa amo, natofo tomanakogo endada irera ninda uju ava kasama arera.","poem":1},{"text":"Kotugo, jebuga mutari da fakina ninda tofo edo irira, ábarago natofo isambu kasama arera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Arie God, nanda uju mo, evetu genembo isasambu nindae sakai sise,","poem":1},{"text":"ninda javo jighoro erarira.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Na uju erena amo, oro oro isasambu dubo jeuro use vurejasore.","poem":1},{"text":"Ainda susu mo, ni natofo isambu inono da ijujeraesa.","poem":2},{"lineBreak":true},{"text":"Kotugo endada oro isasambudae emboro eveva nine ijugeraesa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Arie God nanda uju mo, evetu genembo isasambu nindae sakai sise, ninda javo jighoro erarira.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Namondeda vasada bayau eveva gaveva ava beká jijighusira. God, namondeda God, namonde esimbugusira.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Beká resena, God namonde esimbugusira. Oro nunda nunda utu gambari utu gambari aminda irera,","poem":1},{"text":"nundae igheghi aoro dae resena.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/kpr_tbl/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpr_tbl/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpr_tbl/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}