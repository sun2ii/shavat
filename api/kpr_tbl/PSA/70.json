{"translation":{"id":"kpr_tbl","name":"God Da Geka Seka","website":"https://ebible.org/Scriptures/details.php?id=kpr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpr","licenseNotes":null,"shortName":"TBL","englishName":"Korafe NT+Psalms","language":"kpr","textDirection":"ltr","sha256":"e4fec1273e818d263fec764dd7d3b93a6206d5d8adde54591259292f615bef01","availableFormats":["json"],"listOfBooksApiLink":"/api/kpr_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10065,"languageName":"Korafe-Yegha","languageEnglishName":"Korafe-Yegha"},"book":{"id":"PSA","translationId":"kpr_tbl","name":"Yaru Divariri","commonName":"Yaru Divariri","title":"Banungari Da Yaruri","order":19,"numberOfChapters":150,"sha256":"52a67016f8c953ee0f4b75319b1ce45a66578472daf567660c25c24e17d3f9eb","firstChapterNumber":1,"firstChapterApiLink":"/api/kpr_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpr_tbl/PSA/150.json","totalNumberOfVerses":2422},"chapter":{"number":70,"content":[{"type":"heading","content":["Genembo Eni God Kena Sonemba Dae Banungusira."]},{"type":"verse","number":1,"content":[{"text":"Arie God, nine namoa dara kena sainghimbe baso jebugaone. Bajari,","poem":1},{"text":"oroko nembo foa na sonembase!","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Gegenembo mendeni namoa daoro ambono dae erera, ava dedo atai dubo da fatido aso,","poem":1},{"text":"dubo bunedo meka gaore! Kotugo gegenembo mendeni, na dara jokáda irena aindae,","poem":3},{"lineBreak":true},{"text":"ivugai jaruterera, ava ondaso jovereghe yaoro, aso nenda binó dadabare!","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Gegenembo aimi namoa sise dere jido gherera, ava fugaso gofedo meka gaore!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"O evetu genembo nimokena ya gheraera amo, aso ne dubo jama use vure jasedo ghaore!","poem":1},{"text":"Evetu genembo nine saghimbe beso jebugusera aimi,","poem":2},{"text":"nindae aiyakoe sise eminge sise irore,","poem":3},{"lineBreak":true},{"text":"“God nusukako numóa teriagori!”","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Arie God, na rojari a kotugo na makasi bekári. Ava sedo tavareghe, namokena fu!","poem":1},{"text":"Arie Bajari, nanda sonemba kato eni tefori. Erá gaimbo eose, totoigo fu, na sonembase!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kpr_tbl/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpr_tbl/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpr_tbl/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}