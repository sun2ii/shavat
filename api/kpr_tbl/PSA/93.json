{"translation":{"id":"kpr_tbl","name":"God Da Geka Seka","website":"https://ebible.org/Scriptures/details.php?id=kpr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpr","licenseNotes":null,"shortName":"TBL","englishName":"Korafe NT+Psalms","language":"kpr","textDirection":"ltr","sha256":"e4fec1273e818d263fec764dd7d3b93a6206d5d8adde54591259292f615bef01","availableFormats":["json"],"listOfBooksApiLink":"/api/kpr_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10065,"languageName":"Korafe-Yegha","languageEnglishName":"Korafe-Yegha"},"book":{"id":"PSA","translationId":"kpr_tbl","name":"Yaru Divariri","commonName":"Yaru Divariri","title":"Banungari Da Yaruri","order":19,"numberOfChapters":150,"sha256":"52a67016f8c953ee0f4b75319b1ce45a66578472daf567660c25c24e17d3f9eb","firstChapterNumber":1,"firstChapterApiLink":"/api/kpr_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kpr_tbl/PSA/150.json","totalNumberOfVerses":2422},"chapter":{"number":93,"content":[{"type":"heading","content":["God Numo Namondeda Kiniri (king)."]},{"type":"verse","number":1,"content":[{"text":"Bajari numo Kiniri (king). Nunda fakina duroghae, inono embo asugeraera aminga ava, asugedo irira.","poem":1},{"text":"Enda nune fitiri, fete gogoghomberira.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Arie Bajari, utu enda ae gitida ni iriasi. Ni sifo aminda kini edo, amingudo refesa.","poem":1},{"text":"Ninda avo anumba da fakina jo nanjigo dadabae arira.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Arie Bajari, kafuru ghighi beka duka javi eraira, eva anje gugugugheraira.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Avata, Bajari, fakinago beká utuda irá gheraira, nunda fakina mindafugo bekári,","poem":1},{"text":"jo kafuru eva da gugugughari amingo iraeri. Eva fumbasa eraira da fakina barago, jo numongo iraeri.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Arie Bajari, ninda Agho Dari mo evovodae irarira.","poem":1},{"text":"Ninda tafaroro kambo kakara kakarago beká edo irira, a evovodae amingudo yarira.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/kpr_tbl/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpr_tbl/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kpr_tbl/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}