{"translation":{"id":"kpx_tbl","name":"Buka Tumute","website":"https://ebible.org/Scriptures/details.php?id=kpx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kpx","licenseNotes":null,"shortName":"TBL","englishName":"Mountain Koiali NT","language":"kpx","textDirection":"ltr","sha256":"15593895217f81fbab99ee5268a0e4fbe0f85ac4fa3b35c858c67695858fe103","availableFormats":["json"],"listOfBooksApiLink":"/api/kpx_tbl/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7814,"languageName":"Mountain Koiali","languageEnglishName":"Mountain Koiali"},"book":{"id":"MAT","translationId":"kpx_tbl","name":"Matiu","commonName":"Matiu","title":"Matiu","order":40,"numberOfChapters":28,"sha256":"466e2c6e293006611b67cb55b8763691f2f8bedf9ef0027bb96a8a29dcec1548","firstChapterNumber":1,"firstChapterApiLink":"/api/kpx_tbl/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/kpx_tbl/MAT/28.json","totalNumberOfVerses":1059},"chapter":{"number":1,"content":[{"type":"heading","content":["Iesu valadae deiada"]},{"type":"verse","number":1,"content":["Kou Iesu Keliso buluve deiadaike ko. Iesuu Ebalahamuta Deividita valadamo lohonu."]},{"type":"verse","number":2,"content":[{"text":"Subuta mole Ebalahamuu Aisiki mamonu.","poem":1},{"lineBreak":true},{"text":"Ige Aisikiu Diekobo mamonu.","poem":1},{"lineBreak":true},{"text":"Ige Diekobou Diuda isi hohuvuiabe houevenu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ige Diudau Tamati Belesita Silata houevelu.","poem":1},{"lineBreak":true},{"text":"Ige Belesiu Heseloni mamonu.","poem":1},{"lineBreak":true},{"text":"Ige Heseloniu Alamu mamonu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ige Alamuu Aminadabu mamonu.","poem":1},{"lineBreak":true},{"text":"Ige Aminadabuu Nasoni mamonu.","poem":1},{"lineBreak":true},{"text":"Ige Nasoniu Samoni mamonu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ige Samoniu Leiabuti Boasi mavolu.","poem":1},{"lineBreak":true},{"text":"Ige Boasiu Lutati Obedi mavolu.","poem":1},{"lineBreak":true},{"text":"Ige Obediu Diesi mamonu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ige Diesiu kosive Deividi mamonu.","poem":1},{"lineBreak":true},{"text":"Ige Deividiu Ulaia mahina melamei Solomoni mamonu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ige Solomoniu Liabomu mamonu.","poem":1},{"lineBreak":true},{"text":"Ige Liabomuu Abaisa mamonu.","poem":1},{"lineBreak":true},{"text":"Ige Abaisau Esa mamonu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ige Esau Diosabati mamonu.","poem":1},{"lineBreak":true},{"text":"Ige Diosabatiu Diolamu mamonu.","poem":1},{"lineBreak":true},{"text":"Ige Diolamuu Usaia mamonu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ige Usaiau Diotamu mamonu.","poem":1},{"lineBreak":true},{"text":"Ige Diotamuu Ahasi mamonu.","poem":1},{"lineBreak":true},{"text":"Ige Ahasiu Hesekaia mamonu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ige Hesekaiau Manasa mamonu.","poem":1},{"lineBreak":true},{"text":"Ige Manasau Amoni mamonu.","poem":1},{"lineBreak":true},{"text":"Ige Amoniu Diosaia mamonu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ige Diosaia keu Diekonaia mamoi hohuvuiabeta houevenu. Vani kela Babulonia ataeau lohoale Iselala ata moaga umudievei malevei abu vatae tilu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kebia malevei tisege iaeabe Diekonaia keu Siatieli mamonu.","poem":1},{"lineBreak":true},{"text":"Ige Siatieliu Selubabeli mamonu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ige Selubabeliu Abudi mamonu.","poem":1},{"lineBreak":true},{"text":"Ige Abudiu Eliakimi mamonu.","poem":1},{"lineBreak":true},{"text":"Ige Eliakimiu Eso mamonu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ige Esou Sadoki mamonu.","poem":1},{"lineBreak":true},{"text":"Ige Sadokiu Akimi mamonu.","poem":1},{"lineBreak":true},{"text":"Ige Akimiu Eludi mamonu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ige Eludiu Eliesa mamonu.","poem":1},{"lineBreak":true},{"text":"Ige Eliesau Matani mamonu.","poem":1},{"lineBreak":true},{"text":"Ige Mataniu Diekobo mamonu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ige Diekobou Dioseba mamonu.","poem":1},{"lineBreak":true},{"text":"Ige Diosebau Meli melamenu.","poem":1},{"lineBreak":true},{"text":"Ige Meliu Iesu mamonu.","poem":1},"Ige Iesu ke abu ivihai avoe, “Keliso.” Ivi ke ihu koseanu. Keu ata tedaevemale kosive."]},{"type":"verse","number":17,"content":["Ebalahamu isi Deividi kebia vigomo valada bahata votiniu (14) ua. Ige Deividi vanimo lamisi lohoale Iselala ataeau Babuloniae timale ke vigomo valada votini (14) moleta ua. Ige Iselala ataeau Babuloniae timale isi Kelisou uale ke vigotamo valada mole votini (14) keta ua."]},{"type":"heading","content":["Iesuu uale deiada"]},{"type":"verse","number":18,"content":["Iesu Kelisou uale keu koseanu. Diosebau Meli kokovaito avuti ladeveholisege Munanae Tumuu Meli vuvunetige au ese manu."]},{"type":"verse","number":19,"content":["Ige koliave Dioseba keu inutolotolote ata. Katealemo isiviholinu atae nimo Meli mai matitiliho. Kateaime isiviale tobekai au keate ke halei."]},{"type":"verse","number":20,"content":["Isi kateai huhuisege Kosive anelu moleu tababumo avue lohoale namihai avoe, “Dioseba, au Deividi valadamo lohonu. Ainaho Meli melameveve ke vabuhavolive. Keu Munana Tumue vuvunemoike au ese ke manu. Iale momoleai melamenela."]},{"type":"verse","number":21,"content":["Ige au mo mamoge ke ivihai kosea, ‘Iesu.’ Ivi ke ihuu koseanu. Auna au ata tedaevei vaveveabe toelamo malevei.”"]},{"type":"verse","number":22,"content":["Kateai louale keu beloveta hoto mole mai selevetinu. Dilavau subuta beloveta ke namihage keu hoto koseale hisalianu."]},{"type":"verse","number":23,"content":["Avoe, “Ma molena au koliati lahaholisito ese mai. Ige ese keu uge abuna ivihai kosea, ‘Imanuelo.’” Ihuve keu koseanu. Dilavau nahehi ua."]},{"type":"verse","number":24,"content":["Ige Diosebau hovelahai Dilava aneluu namihale ke nahate vai Meli melamenu."]},{"type":"verse","number":25,"content":["Isito avuti lahaholisege eseveu uge au ke ivihai avoe, “Iesu.”"]}],"footnotes":[]},"thisChapterLink":"/api/kpx_tbl/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kpx_tbl/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":25}