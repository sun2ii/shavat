{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"JOB","translationId":"ksd_png","name":"Iob","commonName":"Iob","title":"IOB","order":18,"numberOfChapters":42,"sha256":"0892b2415acacea03f7ae920a8507e4347c94189c56f8cf4d6b2a64168536ec0","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/ksd_png/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":25,"content":[{"type":"heading","content":["Bildad i biti ba pa i tale ra tarai pi diat a takodo ta ra mata i God"]},{"type":"verse","number":1,"content":[{"text":"Ma Bildad ra te Sua i ga tata ma i ga biti:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"God i varkurai ma ra dekdek na varkurai;","poem":1},{"lineBreak":true},{"text":"I vamalmal ra gunan arama liu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"To ia bar na luk valar pa kana umana loko na tarai na vinarubu?","poem":1},{"lineBreak":true},{"text":"Ma to ia bar kana kapa pa i pupua taun ia?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A tutana na takodo dave ta ra mata i God?","poem":1},{"lineBreak":true},{"text":"Ma nina ba ra vavina i kava na gomgom dave?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ea, a gai iat pa i bagabagele pirana,","poem":1},{"lineBreak":true},{"text":"Ma ra umana tagul pa dia gomgom ta ra luaina matana;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma dave bar ra tutana, nina a kalolo ko,","poem":1},{"lineBreak":true},{"text":"1 Ma ra natu i ra tutana, nina a kariuriu ka!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}