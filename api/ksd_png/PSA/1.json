{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"heading","content":["A LUAINA BUK A dovot na gugu"]},{"type":"verse","number":1,"content":[{"text":"I ti doan nam ra tutuna ba pa i mur ra nuknuk i ra kaina tarai,","poem":1},{"lineBreak":true},{"text":"Ma pa i tur ta ra nga kai ra umana tena vana rara,","poem":1},{"lineBreak":true},{"text":"Ma pa dia ki varurung ma ra umana tena varkulumai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ia kaka i manga gugu ka ta ra vartovo kai ra Luluai;","poem":1},{"lineBreak":true},{"text":"Ma i nununuk ta kana vartovo a bungbung na keake ma ra bungbung na marum bula.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Na varogop ma ra davai di ga vaume ta ra papar a tava alir,","poem":1},{"lineBreak":true},{"text":"I vuavuai ta kana e,","poem":1},{"lineBreak":true},{"text":"A mapmapina bula pa i makuk;","poem":1},{"lineBreak":true},{"text":"Ma ra lavur magit par i pait diat, diat a tavua.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"A umana tena varpiam pa dia damana;","poem":1},{"lineBreak":true},{"text":"Dia varogop uka ma ra pal i ra vit a vuvu i kapkap vue.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kari a umana tena varpiam pa diat a pila ta ra varkurai,","poem":1},{"lineBreak":true},{"text":"Ma ra umana tena vana rara pa diat a ki varurung ma ra umana tena takodo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tago ra Luluai i nunure ra mangamangana kai ra tena takodo,","poem":1},{"lineBreak":true},{"text":"Ma ra mangamangana kai ra tena varpiam na virua.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}