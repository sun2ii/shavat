{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":100,"content":[{"type":"heading","content":["A kakailai na pite varpa"]},{"type":"hebrew_subtitle","content":["A kakailai na pite varpa."]},{"type":"verse","number":1,"content":[{"text":"Avat a umana gunagunan par, avat a kukula na gugu tadav ra Luluai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Avat a toratorom tai ra Luluai ma ra gina;","poem":1},{"lineBreak":true},{"text":"Avat a vana rikai ta ra matana ma ra kakailai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Avat a matoto ba ra Luluai ia God;","poem":1},{"lineBreak":true},{"text":"Ia iat i ga vaki dat, ma dat kana iat;","poem":1},{"lineBreak":true},{"text":"Dat kana tarai, ma kana kikil na sip ba i balabalaure.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Avat a olo ta kana umana mataniolo ma ra tinabar na pite varpa,","poem":1},{"lineBreak":true},{"text":"Ma ta kana gunan ma ra varmananai;","poem":1},{"lineBreak":true},{"text":"Avat a pite pa ia, ma avat a tata vadoane ra iangina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tago ra Luluai i boina; kana varmari i tur pa na mutu;","poem":1},{"lineBreak":true},{"text":"Ma ra dovot na maukuana na tuk tar ta ra lavur taun tarai par.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}