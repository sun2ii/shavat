{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"heading","content":["Ra vavalima kai ra King"]},{"type":"hebrew_subtitle","content":["A kakailai kai David."]},{"type":"verse","number":1,"content":[{"text":"Ina kakailai ure ra varmari ma ure ra varkurai,","poem":1},{"lineBreak":true},{"text":"Tadav u, Luluai, ina kakailai na pite varpa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ina mal bulu pa kaugu mangamangana, ma ina vanavana bulbulu;","poem":1},{"lineBreak":true},{"text":"Vingaia bar una tadav iau?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ina ki ra kubagu ma ra ko na balagu.","poem":1},{"lineBreak":true},{"text":"Pa ina nuk upi ta bilak na magit,","poem":1},{"lineBreak":true},{"text":"Iau milmilikuane ra kaina mangamangana kadiat dia vana rara;","poem":1},{"lineBreak":true},{"text":"Pa na ki petep piragu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A gegagege na nuknuk na vana kan iau,","poem":1},{"lineBreak":true},{"text":"Pa amir a varmaliurai ma ra kaina;","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ina vamutue nina i takun ivaive talaina ma i vaongo ko tana;","poem":1},{"lineBreak":true},{"text":"Ma pa ina mari nina i malamala lululuai ma i kolakolo ra nuknukina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ina nuk upi ra dovot na tarai ta ra gunan upi diat a ki piragu;","poem":1},{"lineBreak":true},{"text":"Nina i vanavana ta ra nga ba i ko tuna, nam na torom tagu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nam ba na pait ra lavur vavagu pa na ki ra kubagu;","poem":1},{"lineBreak":true},{"text":"Nam i tatike ra vaongo pa na tur vatikai ta ra luaina matagu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"A bungbung par ta ra malana ina vamutue ra umana tena varpiam par ta ra gunagunan,","poem":1},{"lineBreak":true},{"text":"Upi ina re vue ra lavut tena pait ra kaina par ta ra pia na pal kai ra Luluai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}