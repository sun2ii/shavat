{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"heading","content":["A nurnur tai God"]},{"type":"hebrew_subtitle","content":["Kai nina i lue ra kakailai; kai David."]},{"type":"verse","number":1,"content":[{"text":"Iau rivarivan tai ra Luluai; Dave ava biti tagu:","poem":1},{"lineBreak":true},{"text":"Una lop tar ta kaum luana da ra beo?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tago, gire, a umana tena varpiam dia lele ra panak,","poem":1},{"lineBreak":true},{"text":"Dia vung vaninare kadia pu ta ra vinau,","poem":1},{"lineBreak":true},{"text":"Upi diat a tut nina i takodo ta ra bobotoi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gala di vakaina vue ra vunapaina,","poem":1},{"lineBreak":true},{"text":"Ava ra umana tena takodo diat a gala pait ia?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ra Luluai i ki ta kana pal tabu,","poem":1},{"lineBreak":true},{"text":"Ra Luluai, kana kiki na king i tur arama ra bala na bakut,","poem":1},{"lineBreak":true},{"text":"A kiau na matana i gire ra umana natu i ra tarai, ma ra pilpil na matana i valar diat.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ra Luluai i valar ra umana tena takodo.","poem":1},{"lineBreak":true},{"text":"Ma ra tulungeana i pidimuane ra tena varpiam ma nina bula i varvakaina.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Na vapeal ra umana kun pire ra umana tena varpiam;","poem":1},{"lineBreak":true},{"text":"A iap ma ra pakar ma ra malamalapang na vuvu, nam kadia tiniba.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tago ra Luluai i takodo,","poem":1},{"lineBreak":true},{"text":"I mainge muka ra mangamangana takodo;","poem":1},{"lineBreak":true},{"text":"A umana tena takodo diat a gire ra matana.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}