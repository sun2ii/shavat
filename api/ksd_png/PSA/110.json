{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"heading","content":["Ra Luluai ma ra king nina i ga pilak pa ia"]},{"type":"hebrew_subtitle","content":["A kakailai kai David."]},{"type":"verse","number":1,"content":[{"text":"Ra Luluai i ga tatike ta kaugu luluai dari:","poem":1},{"lineBreak":true},{"text":"Una ki ta ra papar a limagu tuna,","poem":1},{"lineBreak":true},{"text":"Upi ina vadiop kaum lavur ebar upi ra ruarua na kakim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ra Luluai na tulue vaarike kaum dekdek na buka na varkurai maro Sion;","poem":1},{"lineBreak":true},{"text":"Una ki na varkurai limlivuan ta kaum lavur ebar.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kaum tarai dia ga upi diat a tul tar mule diat ta ra bung ba u varurue diat tana,","poem":1},{"lineBreak":true},{"text":"Ma diat a mamar ma ra gomgom na minamar;","poem":1},{"lineBreak":true},{"text":"U vatur vake kaum lavur barmana dia da ra mavoko i vana rikai ta ra lar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ra Luluai i tar vavalima ma pa na pukue ra nuknukina;","poem":1},{"lineBreak":true},{"text":"U a tena tinabar tukum","poem":1},{"lineBreak":true},{"text":"Varogop ma Melkisedek.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ra Luluai, nina i tur ta ra papar a limam tuna,","poem":1},{"lineBreak":true},{"text":"Na pamar gigi ra umana king ta ra bung ba na vaarike kana kankan tana.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Na varvarkurai limlivuan ta ra umana Tematana,","poem":1},{"lineBreak":true},{"text":"Na vabuka ra umana bala na kamara ma ra umana virua;","poem":1},{"lineBreak":true},{"text":"Na pamar gigi ra umana luluai i ra rakarakan a gunagunan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Na momo ta ra tava i alir ta ra papar a nga;","poem":1},{"lineBreak":true},{"text":"Kari na vatur ra uluna urama.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}