{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"heading","content":["A pite varpa tadav ra Luluai tago ia ra tena pait ra boina"]},{"type":"verse","number":1,"content":[{"text":"Avat a pite pa ra Luluai.","poem":1},{"lineBreak":true},{"text":"Avat a umana tultul kai ra Luluai, avat a pite pa ia,","poem":1},{"lineBreak":true},{"text":"Avat a pite pa ra iang i ra Luluai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Da pite pa ra iang i ra Luluai","poem":1},{"lineBreak":true},{"text":"Papa gori ma pa na mutu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Maro ra ngu na gunan a keake i kuma rikai tana tuk tar ta ra nguna i ki ong tana,","poem":1},{"lineBreak":true},{"text":"Da pite pa ra iang i ra Luluai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ra Luluai i ki ak ta ra lavur vuna tarai,","poem":1},{"lineBreak":true},{"text":"Ma kana minamar i ngala ta dir ma ra minamar i ra bala na bakut.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"To ia dir varogop ma ra Luluai kada God,","poem":1},{"lineBreak":true},{"text":"Nina i ki arama liu,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nina i tur rururu upi na gigira ba","poem":1},{"lineBreak":true},{"text":"Taun ra maup ma ra rakarakan a gunagunan?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I vatut ra luveana kan ra tobon,","poem":1},{"lineBreak":true},{"text":"Ma i puak vairop ra viloi kan ra ul a buta;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Upi na vaki ia varurung ma ra umana luluai,","poem":1},{"lineBreak":true},{"text":"Maia, varurung ma ra umana luluai kai kana vuna tarai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I tul tar ra vavina i biu ba na ki ra kubana,","poem":1},{"lineBreak":true},{"text":"Ma na gugu ure ra umana natuna.","poem":1},{"lineBreak":true},{"text":"Avat a pite pa ra Luluai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}