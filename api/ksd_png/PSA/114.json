{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"heading","content":["A kakailai ure ra Lukara na Bolo Lake"]},{"type":"verse","number":1,"content":[{"text":"Ba Israel i ga irop kan Aigipto,","poem":1},{"lineBreak":true},{"text":"Ra kuba i Iakob kan ra tarai ba i enana kadia tinata;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ra Luluai i ga pilak pa Iuda upi kana pal tabu,","poem":1},{"lineBreak":true},{"text":"Ma Israel upi kana pakana ba i varkurai tana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"A ta i gire ma i lop,","poem":1},{"lineBreak":true},{"text":"Iordan i alir murmur.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A umana buabuana dia pil da ra me, a tomotoina,","poem":1},{"lineBreak":true},{"text":"A umana ilil da ra nat na sip.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"U ti dave ra ta, tago u lop?","poem":1},{"lineBreak":true},{"text":"U Iordan, u dave, tago u alir murmur?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I dave avat a umana buana, tago ava pipil da ra me?","poem":1},{"lineBreak":true},{"text":"Avat a umana ilil, tago ava pipil da ra umana nat na sip?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"U ra rakarakan a gunagunan, una dadadar, tago ra Luluai i bang ati;","poem":1},{"lineBreak":true},{"text":"Tago ra God kai Iakob go kari;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nina i pukue ra vat ki upi ra kabipolo,","poem":1},{"lineBreak":true},{"text":"Ma ra dekdek na vat upi ra mata na tava.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}