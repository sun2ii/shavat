{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"heading","content":["A niaring upi ra maramaravut"]},{"type":"hebrew_subtitle","content":["A kakailai na nitutua."]},{"type":"verse","number":1,"content":[{"text":"Ba iau ga ki na malari iau ga kail tadav ra Luluai,","poem":1},{"lineBreak":true},{"text":"Ma i ga torom tagu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Una valaun iau, Luluai, kan ra tena vavaongo,","poem":1},{"lineBreak":true},{"text":"Ma kan ra tena vavagu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ava da tul tar ia tam? Ba ava da pait ia piram,","poem":1},{"lineBreak":true},{"text":"U ra tena vavagu?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A umana pu, a umana lamiana, kai ra tena vinarubu,","poem":1},{"lineBreak":true},{"text":"Ma ra lakit na iap.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"I kaina tagu tago iau ki na vaira ati Mesek,","poem":1},{"lineBreak":true},{"text":"Ma ra kubagu i tur livuan ta ra umana pal na mal Kedar!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A tulungeagu i ga ki vavuan","poem":1},{"lineBreak":true},{"text":"Pire nina i milmilikuane ra malmal.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Iau mainge ra malmal;","poem":1},{"lineBreak":true},{"text":"Ma ba iau tatata dia mainge ke ra vinarubu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}