{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":121,"content":[{"type":"heading","content":["Ra Luluai kada Tena Balabalaure"]},{"type":"hebrew_subtitle","content":["A kakailai na nitutua."]},{"type":"verse","number":1,"content":[{"text":"Ina tadarake ra lualuana;","poem":1},{"lineBreak":true},{"text":"Kaugu valavalaun na vana rikai mamave?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kaugu valavalaun i vana rikai tai ra Luluai,","poem":1},{"lineBreak":true},{"text":"Nina i ga vaki ra bala na bakut ma ra rakarakan a gunagunan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Pa na nur vue ra kakim upi na tagalir;","poem":1},{"lineBreak":true},{"text":"Nina i mataure u pa na va mat!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ea nina i mataure Israel,","poem":1},{"lineBreak":true},{"text":"Pa na mata vava, ma pa na va mat.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ra Luluai ia kaum monamono;","poem":1},{"lineBreak":true},{"text":"Ra Luluai i vamalur u ta ra papar a limam tuna;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A matana keake pa na tup u ta ra keake,","poem":1},{"lineBreak":true},{"text":"Ma ra gai ta ra marum, pata bula.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ra Luluai na balaure bat u kan ra lavur kaina magit;","poem":1},{"lineBreak":true},{"text":"Na balaure kaum nilaun.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ra Luluai na balaure kaum niirop ma kaum niolo,","poem":1},{"lineBreak":true},{"text":"Papa gori ma pa na mutu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}