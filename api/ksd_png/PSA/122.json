{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"heading","content":["A pite varpa ure Ierusalem"]},{"type":"hebrew_subtitle","content":["A kakailai na nitutua."]},{"type":"verse","number":1,"content":[{"text":"Iau ga gugu ba dia ga biti tagu dari:","poem":1},{"lineBreak":true},{"text":"Dat a vana oai upi ra kuba i ra Luluai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A kak i vevet dia tur","poem":1},{"lineBreak":true},{"text":"Ta kaum mataniolo, Ierusalem.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ierusalem di ga papait ia,","poem":1},{"lineBreak":true},{"text":"A pia na pal ba i tur varurung bulu;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A umana vuna tarai dia vana oai upi ia, a umana vuna tarai kai ra Luluai,","poem":1},{"lineBreak":true},{"text":"Dia vana, tago damana ra varkurai ure Israel,","poem":1},{"lineBreak":true},{"text":"Upi diat a tul tar ra pite varpa tadav ra iang i ra Luluai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A umana ngala na kiki na varkurai abara,","poem":1},{"lineBreak":true},{"text":"A umana kiki na king kai ra kuba i David.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Avat a araring upi Ierusalem na ki na malmal;","poem":1},{"lineBreak":true},{"text":"Diat dia mari u diat a tavua.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A malmal na tur ta kaum bala na gunan,","poem":1},{"lineBreak":true},{"text":"Ma ra peal magit ta kaum lavur pal na luluai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ure ra tara na turagu ma ure ra umana talaigu,","poem":1},{"lineBreak":true},{"text":"Ina biti go: A malmal na ki tam.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ure ra kuba i ra Luluai kada God,","poem":1},{"lineBreak":true},{"text":"Ina ongor upi una ki mamal.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}