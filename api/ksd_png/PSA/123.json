{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":123,"content":[{"type":"heading","content":["A niaring upi ra varmari"]},{"type":"hebrew_subtitle","content":["A kakailai na nitutua."]},{"type":"verse","number":1,"content":[{"text":"A matagu i tadaraka piram,","poem":1},{"lineBreak":true},{"text":"U ba u ki ra bala na bakut.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ea, da ra mata i ra umana tultul, a umana tutana, i gire upi ra lima i kadia umana luluai,","poem":1},{"lineBreak":true},{"text":"Da ra mata i ra tultul, a vavina, i gire upi ra lima i kana tadar vavina,","poem":1},{"lineBreak":true},{"text":"Damana ra mata i dat i gire upi ra Luluai kada God,","poem":1},{"lineBreak":true},{"text":"Tuk tar ta ra bung ba na mari dat.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Luluai, una mari avet, una mari avet,","poem":1},{"lineBreak":true},{"text":"Tago i tup tuna avet ra varvul.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A varkulumai kadiat dia ki vakuku","poem":1},{"lineBreak":true},{"text":"I tup tuna ra tulungea i vevet,","poem":1},{"lineBreak":true},{"text":"Ma damana bula ra varvul kadiat i kolakolo ra nuknuk i diat.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}