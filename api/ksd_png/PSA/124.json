{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":124,"content":[{"type":"heading","content":["God i valaun pa kana tarai"]},{"type":"hebrew_subtitle","content":["A kakailai na nitutua; kai David."]},{"type":"verse","number":1,"content":[{"text":"Boina ba gori Israel na biti dari:","poem":1},{"lineBreak":true},{"text":"Gala ra Luluai pa i ga tur maravut dat,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gala ra Luluai pa i ga tur maravut dat,","poem":1},{"lineBreak":true},{"text":"Ba ra tarai dia ga tut na vinarubu ure dat,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gala dia ga konom pa dat, a umana launa,","poem":1},{"lineBreak":true},{"text":"Ba kadia kulot i ga tut ure dat;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gala na ga tup dat da ra ngala na tava,","poem":1},{"lineBreak":true},{"text":"Gala da ga kongo ta ra lovon ta,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma gala da ga virua ta ra polo i buabuai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Da pite pa ra Luluai,","poem":1},{"lineBreak":true},{"text":"Tago pa i ga nur tar dat ta ra ngie i diat da ra mangana di kinim karat pa ia.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Da tar pila ta ra kun kai ra tena kapi kun da ra beo,","poem":1},{"lineBreak":true},{"text":"A kun i takunu, ma da tar pila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kada maramaravut i vana rikai ta ra iang i ra Luluai,","poem":1},{"lineBreak":true},{"text":"Nina i ga vaki ra bala na bakut ma ra rakarakan a gunagunan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}