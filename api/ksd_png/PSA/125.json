{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":125,"content":[{"type":"heading","content":["A bo na kini kai ra tarai kal God"]},{"type":"hebrew_subtitle","content":["A kakailai na nitutua."]},{"type":"verse","number":1,"content":[{"text":"Diat dia nurnur tai ra Luluai dia da ra luana Sion,","poem":1},{"lineBreak":true},{"text":"Nina ba pa na takari, na tur padikat ika pa na mutu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Da ra umana lualuana dia tur kikil Ierusalem,","poem":1},{"lineBreak":true},{"text":"Damana ra Luluai i tur kikil ra taraina,","poem":1},{"lineBreak":true},{"text":"Papa gori ma pa na mutu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tago ra buka na varkurai kai ra umana tena varpiam pa na ki vatikai","poem":1},{"lineBreak":true},{"text":"Taun ra tiniba kai ra umana tena takodo;","poem":1},{"lineBreak":true},{"text":"Kan ra umana tena takodo diat a tulue vaarike ra lima i diat upi ra varpiam.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Luluai, una mari maravut diat dia boina,","poem":1},{"lineBreak":true},{"text":"Ma diat bula i dovot ra bala i diat.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma diat dia vana irai upi kadia lavur nga i gegagege,","poem":1},{"lineBreak":true},{"text":"Ra Luluai na ben vaire vue diat varurung ma ra umana tena pait ra kaina.","poem":1},{"lineBreak":true},{"text":"A malmal na ki pire Israel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}