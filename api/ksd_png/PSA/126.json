{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"heading","content":["A niaring upi ra varvalaun"]},{"type":"hebrew_subtitle","content":["A kakailai na nitutua."]},{"type":"verse","number":1,"content":[{"text":"Ba ra Luluai i ga ben valilikun mule diat dia talil uro Sion,","poem":1},{"lineBreak":true},{"text":"Da ga varogop ma diat dia ririvon.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ta nam ra bung i tup dat ra ninongon,","poem":1},{"lineBreak":true},{"text":"Ma da ga kakailai ma ra gugu.","poem":1},{"lineBreak":true},{"text":"Ta nam ra bung a umana Tematana dia biti dari:","poem":1},{"lineBreak":true},{"text":"Ra Luluai i tar pait ra umana ngala na magit ure diat.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ra Luluai i ga pait ra umana ngala na magit ure dat;","poem":1},{"lineBreak":true},{"text":"Da gugu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Luluai, una vadoane mule avet,","poem":1},{"lineBreak":true},{"text":"Da ra umana tava alir aro Negeb.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Diat dia vavauma ma i lur ra mata i diat,","poem":1},{"lineBreak":true},{"text":"Diat a varurue boko ra magit ma diat a ngenge na gugu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ba tikai i vana ma i tangi,","poem":1},{"lineBreak":true},{"text":"Ba i kap voe ra patpat na davai upi na vaume,","poem":1},{"lineBreak":true},{"text":"A dovotina na lilikun ma ra ngenge na gigi,","poem":1},{"lineBreak":true},{"text":"Ba i kap ra vuai na uma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}