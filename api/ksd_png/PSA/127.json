{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"heading","content":["A pite varpa tadav God tago ia ra tena pait ra boina"]},{"type":"hebrew_subtitle","content":["A kakailai na nitutua; kai Solomon."]},{"type":"verse","number":1,"content":[{"text":"Ona ra Luluai pa i vatur ra pal,","poem":1},{"lineBreak":true},{"text":"Diat dia papait dia papalum vakuku tana;","poem":1},{"lineBreak":true},{"text":"Ona ra Luluai pa i balaure ra pia na pal,","poem":1},{"lineBreak":true},{"text":"Ra monamono i mono vakuku.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A magit vakuku pire vavat, ba ava tut ra malana ikilik ma ba ava ki vavuan ta ra marum,","poem":1},{"lineBreak":true},{"text":"Ma ba ava en ra nian ba i ga tup avat ra papalum ure;","poem":1},{"lineBreak":true},{"text":"Tago i tabar kana lavur vakak ba dia diadiop.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ea, ra Luluai i tul tar ra umana bul tutana;","poem":1},{"lineBreak":true},{"text":"A vuai ra tatal na bul i da ra vapuak.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A umana bul di kava diat ba ra tavu i diat dia ongor boko,","poem":1},{"lineBreak":true},{"text":"Dia da ra umana pu ta ra lima i ra tena ongor.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I ti doan nam ra tutana ba kana popopoi i buka ma diat;","poem":1},{"lineBreak":true},{"text":"Pa na vavirvir,","poem":1},{"lineBreak":true},{"text":"Ba dia pirpir ma kana umana ebar ta ra mataniolo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}