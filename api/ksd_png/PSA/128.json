{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":128,"content":[{"type":"heading","content":["A balbali ure ra tinorom tai ra Luluai"]},{"type":"hebrew_subtitle","content":["A kakailai na nitutua."]},{"type":"verse","number":1,"content":[{"text":"Diat par dia ru ra Luluai dia ti doan tikatikai,","poem":1},{"lineBreak":true},{"text":"Nina diat dia murmur kana lavur nga.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tago una en ra magit i vuna ta ra papalum na limam;","poem":1},{"lineBreak":true},{"text":"Una ti doan, ma una ki mamal.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kaum taulai i ki ara iat ra kubam, ma na da ra davai na vain i manga vuai;","poem":1},{"lineBreak":true},{"text":"A lavur natum kikil kaum vuvuvung na nian dia da ra lavur boro na vudu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ea, damana na ti doan nam ra tutana","poem":1},{"lineBreak":true},{"text":"Ba i ru ra Luluai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ra Luluai na vadoane u maro Sion,","poem":1},{"lineBreak":true},{"text":"Ma una gire ra nidoan kai ra gunan Ierusalem ta ra lavur bungbung u laun tana ati ra pia.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Maia, una gire ra umana bul mur tam, a umana tubum.","poem":1},{"lineBreak":true},{"text":"A malmal na ki pire Israel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}