{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"heading","content":["A niaring upi ra Luluai na tur bat ra umana ebar kal Israel"]},{"type":"hebrew_subtitle","content":["A kakailai na nitutua."]},{"type":"verse","number":1,"content":[{"text":"Gori Israel na biti dari:","poem":1},{"lineBreak":true},{"text":"Di ga vakavakaina milate iau papa ra kilala iau ga bul boko tana;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Di ga vakavakaina milate iau papa ra kilala iau ga bul boko tana;","poem":1},{"lineBreak":true},{"text":"Ma pa dia ga uvia pa iau.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A umana tena niipuk dia ga ipipuk ra tamurugu;","poem":1},{"lineBreak":true},{"text":"Dia ga pait ra umana lolovina nga na ipipuk tana.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ra Luluai a tena takodo,","poem":1},{"lineBreak":true},{"text":"I poko kutu varbaiane ra vivi umana tena varpiam.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Boina ba diat a vavirvir, ma da pukue vatalil diat,","poem":1},{"lineBreak":true},{"text":"Diat par dia milikuane Sion.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Boina ba diat a da ra vura ta ra ul a pal,","poem":1},{"lineBreak":true},{"text":"I makuk ba pa i pupu boko;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma ra tena nidodoko pa i vatur ia ma ra limana,","poem":1},{"lineBreak":true},{"text":"Ma nina i vivi pa i vung ia ta ra bongobongono.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Diat bula dia vana pakit pa dia biti:","poem":1},{"lineBreak":true},{"text":"A varvadoan kai ra Luluai na ki ta vavat;","poem":1},{"lineBreak":true},{"text":"Ave tata vadoane avat ta ra iang i ra Luluai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}