{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"heading","content":["A niaring upi ra maramaravut"]},{"type":"hebrew_subtitle","content":["Kai nina i lue ra kakailai, a kakailai kai David."]},{"type":"verse","number":1,"content":[{"text":"Luluai, na tuk vingai bar? Una valubane vatikene iau vang?","poem":1},{"lineBreak":true},{"text":"Aivia ra bung boko una ive ra matam kan iau?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aivia ra bung boko ina nununuk ta ra balagu,","poem":1},{"lineBreak":true},{"text":"Ma ra niligur na ki ta ra balagu ra bungbung par?","poem":1},{"lineBreak":true},{"text":"Aivia ra bung boko kaugu ebar na ngala ta mimir?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Luluai, kaugu God, una nuk pa iau, ma una torom tagu;","poem":1},{"lineBreak":true},{"text":"Una vakapa ra kiau na matagu kan ina diadiop ma ra niva na minat;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kan kaugu ebar na biti: Iau tar uvia pa ia;","poem":1},{"lineBreak":true},{"text":"Kan kaugu lavur ebar diat a manga gugu ba iau takari.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ma iau tar nurnur ta kaum varmari;","poem":1},{"lineBreak":true},{"text":"A balagu na manga gugu ta kaum varvalaun;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ina kakailai tadav ra Luluai,","poem":1},{"lineBreak":true},{"text":"Tago i tar vapeal kana bo na mangamangana piragu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}