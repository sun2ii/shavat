{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"heading","content":["A niaring upi ra maramaravut"]},{"type":"hebrew_subtitle","content":["A kakailai na nitutua. kai ra"]},{"type":"verse","number":1,"content":[{"text":"Luluai, iau kail u mara ra maluluvinana iat.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Luluai, una torom tagu;","poem":1},{"lineBreak":true},{"text":"Boina ba ra talingam na valongore","poem":1},{"lineBreak":true},{"text":"Ra nilaigu ba iau lul vovo pa u.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Luluai, ba u nuk vakilang vake ra lavur varpiam,","poem":1},{"lineBreak":true},{"text":"Luluai, ia na tur?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma ga u, a tena pupupun vuai u,","poem":1},{"lineBreak":true},{"text":"Upi da ru u.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Iau ki pa ra Luluai, a tulungeagu i kiki pa ia;","poem":1},{"lineBreak":true},{"text":"Ma iau nurnur ta kana tinata.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A tulungeagu i nuk upi ra Luluai,","poem":1},{"lineBreak":true},{"text":"I manga nuk upi ia, ma ra monamono pa i manga nuk upi ra malana.","poem":1},{"lineBreak":true},{"text":"Maia, a monamono pa i manga nuk upi ra malana.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Israel, una nurnur tai ra Luluai;","poem":1},{"lineBreak":true},{"text":"Tago a bala na varmari i tur pirana,","poem":1},{"lineBreak":true},{"text":"Ma ra ngala na varvalaun bula.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma ia iat na valaun Israel","poem":1},{"lineBreak":true},{"text":"Kan kana lavur varpiam.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}