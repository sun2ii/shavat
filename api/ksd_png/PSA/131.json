:[]},"thisChapterLink":"/api/ksd_png/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}