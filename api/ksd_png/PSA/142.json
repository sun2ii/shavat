{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"heading","content":["A niaring upi ra maramaravut"]},{"type":"hebrew_subtitle","content":["A mari na kakailai kai David, ba i ga ki ta ra babang; a niaring."]},{"type":"verse","number":1,"content":[{"text":"Iau manga kail tadav ra Luluai;","poem":1},{"lineBreak":true},{"text":"Iau lul vovo ra Luluai ma ra nilaigu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Iau rada kaugu nginarao ta ra luaina matana,","poem":1},{"lineBreak":true},{"text":"Iau vaarike kaugu purpuruan pirana.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ba ra tulungeagu i matmat ika tagu, u nunure kaugu nga;","poem":1},{"lineBreak":true},{"text":"A tarai dia ga kapi ive ra kun ta nam ra nga ba ina vanavana tana.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Una gire ra papar a limagu tuna, tago pa ta na piragu ba na kapupi iau;","poem":1},{"lineBreak":true},{"text":"Pa ta gunan na bakbakit mulai ure iau, pa ta na i mari iau.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Iau tangi tadav u, Luluai;","poem":1},{"lineBreak":true},{"text":"Iau biti dari: U kaugu rivarivan","poem":1},{"lineBreak":true},{"text":"Ma kaugu tiniba ta ra gunan kai ra umana launa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Una kapupi kaugu tinangi, tago iau bilua tuna.","poem":1},{"lineBreak":true},{"text":"Una valangalanga iau kan diat dia vakavakaina iau, tago dia lia ma ra niongor tagu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Una pala vue iau ta ra pal na banubat,","poem":1},{"lineBreak":true},{"text":"Upi ina tul tar ra pite varpa ta ra iangim;","poem":1},{"lineBreak":true},{"text":"A umana tena takodo diat a tur kikil boko iau,","poem":1},{"lineBreak":true},{"text":"Tago una ga mari maravut iau.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}