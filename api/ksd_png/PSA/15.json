{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":15,"content":[{"type":"heading","content":["Nam ra magit God i mainge"]},{"type":"hebrew_subtitle","content":["A kakailai kai David."]},{"type":"verse","number":1,"content":[{"text":"Luluai, ia na kiki ta ra kubam? la na ki ta kaum luana gomgom?","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nina ba i ko tuna kana mangamangana, ma i papait ra magit i takodo,","poem":1},{"lineBreak":true},{"text":"Nina ba i tatike ra dovotina ta ra balana.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nina ba pa i varurai kakaina ma ra karameana,","poem":1},{"lineBreak":true},{"text":"Ma pa i vakaina talaina,","poem":1},{"lineBreak":true},{"text":"Ma pa i kapupi ra kaina varvai ure nina dir ki varurung me.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nina i milmilikuane ra bilak na tutana;","poem":1},{"lineBreak":true},{"text":"Ma i ruru diat dia ru ra Luluai.","poem":1},{"lineBreak":true},{"text":"Nina ba i vavalima, ma ona ia iat i kaina tana, i pait ot pa ia ka, pa i vaenana pa ia.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nina i kaiane ra tarai ma kana mani, ma pa i vatur vake ra ngala na kubika tana,","poem":1},{"lineBreak":true},{"text":"Ma pa i alube pa ta varkul upi na takun nina pa i rara.","poem":1},{"lineBreak":true},{"text":"Nina i papait ra dari pa na takari muka.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}