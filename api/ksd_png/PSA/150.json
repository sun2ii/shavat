":5,"content":[{"lineBreak":true},{"text":"Avat a pite pa ia ma ra tidir ba i tangi;","poem":1},{"lineBreak":true},{"text":"Avat a pite pa ia ma ra tutupele ba i tangi mat.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Boina ba ra lavur mangana i laun diat a pite pa ra Luluai.","poem":1},{"lineBreak":true},{"text":"Avat a pite pa ra Luluai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}