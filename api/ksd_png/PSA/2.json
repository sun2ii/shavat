{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"heading","content":["Ra King nina ba God i ga pilak ia"]},{"type":"verse","number":1,"content":[{"text":"Upi ra ava ra umana Tematana dia urung,","poem":1},{"lineBreak":true},{"text":"Ma ra lavur tarai dia nuknuk ra magit vakuku?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A umana king mati ra pia dia tut na vinarubu,","poem":1},{"lineBreak":true},{"text":"Ma ra lavur luluai dia kiki vung varbat","poem":1},{"lineBreak":true},{"text":"Ure ra Luluai ma nina i ga pilak pa ia; dia biti:","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dat a al kutu kadir umana vivi,","poem":1},{"lineBreak":true},{"text":"Ma dat a vue kadir lavur vinau kan dat.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nina i ki ra bala na bakut na nongon ika,","poem":1},{"lineBreak":true},{"text":"A Luluai na kulume diat.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Namur na tata pire diat ta kana kulot,","poem":1},{"lineBreak":true},{"text":"Ma na vapurpuruan diat ta kana karvuvu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma iau tar vaki kaugu king arama Sion kaugu luana gomgom.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ina vaarike ra varkurai;","poem":1},{"lineBreak":true},{"text":"A Luluai i ga biti tagu dari: U natugu;","poem":1},{"lineBreak":true},{"text":"Gori iau tar vangala u,","poem":1},{"lineBreak":true},{"text":"Una lul iau,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma ina tibe tar ra lavur Tematana tam,","poem":1},{"lineBreak":true},{"text":"Ma kaum ra lavur ngungu na rakarakan a gunagunan aro iat.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Una puar diat ma ra buka na palariam,","poem":1},{"lineBreak":true},{"text":"Una pamar gigi diat da ra la na pia.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kari avat a matoto, a umana king,","poem":1},{"lineBreak":true},{"text":"Avat a kapupi ra varpit, a umana tena varkurai mamati ra pia.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Avat a toratorom tai ra Luluai ma ra bunurut,","poem":1},{"lineBreak":true},{"text":"Avat a gugu ma ra nidadar.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Avat a galum natuna, kan na kulot,","poem":1},{"lineBreak":true},{"text":"Ma avat a virua na nga,","poem":1},{"lineBreak":true},{"text":"Tago kana kankan na arikai lulut.","poem":1},{"lineBreak":true},{"text":"Diat dia nurnur tana dia ti doan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}