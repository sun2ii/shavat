{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"heading","content":["A niaring upi ra niuvia"]},{"type":"hebrew_subtitle","content":["Kai nina i lue ra kakailai; a kakailai kai David."]},{"type":"verse","number":1,"content":[{"text":"Ra Luluai na torom tam ta ra bung na purpuruan;","poem":1},{"lineBreak":true},{"text":"A iang i ra God kai Iakob na balaure bat u;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Na tulue ra maramaravut piram maro ra kubana,","poem":1},{"lineBreak":true},{"text":"Ma na vapadikat u maro Sion;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Na nuk vake kaum lavur vartabar,","poem":1},{"lineBreak":true},{"text":"Ma na vatur vake kaum tinabar di tun tar ia;","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Na tabar u ma ra magit a balam i mainge,","poem":1},{"lineBreak":true},{"text":"Ma na pait ot pa ra nuknukim.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Avet a malalongo na gugu ure kaum niuvia,","poem":1},{"lineBreak":true},{"text":"Ma dat a vatur kada lavur vakilang ta ra iang i kada God;","poem":1},{"lineBreak":true},{"text":"Ra Luluai na pait ot pa kaum lavur nilul.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Go iau nunure ba ra Luluai i valaun nina i ga pilak pa ia;","poem":1},{"lineBreak":true},{"text":"Na torom tana marama ra bala na bakut ta kana kiki tabu.","poem":1},{"lineBreak":true},{"text":"Ma na valaun ia ma ra dekdek na limana tuna.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ta umana dia nurnur ta ra kiki na vinavana, ma ta ra umana ta ra lavur os;","poem":1},{"lineBreak":true},{"text":"Ma avet, avet a vatang ika ra iang i ra","poem":1},{"lineBreak":true},{"text":"Luluai, kaveve God.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dia tar pa rururu ma dia tar bura;","poem":1},{"lineBreak":true},{"text":"Ma avet ave tar tut, ma ave tur takodo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Luluai, una maravut ra king;","poem":1},{"lineBreak":true},{"text":"Una torom ta vevet ba ave oro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}