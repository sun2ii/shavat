{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"heading","content":["Ra Luluai kada Tena Varbalaurai"]},{"type":"hebrew_subtitle","content":["A kakailai kai David."]},{"type":"verse","number":1,"content":[{"text":"Ra Luluai kaugu tena varbalaurai; pa ina iba upi ta magit.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I vadiop iau ta ra vura i lubalubang,","poem":1},{"lineBreak":true},{"text":"I agure pa iau ta ra papar a tava na ningo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"I valagar pa kaugu nilaun;","poem":1},{"lineBreak":true},{"text":"I lue rap iau ta ra lavur nga i ra mangamangana takodo ure ra iangina.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Maia, ma ba ina alalu ta ra male na malur na minat,","poem":1},{"lineBreak":true},{"text":"Pa ina burut ure ta kaina magit; tago u ki piragu;","poem":1},{"lineBreak":true},{"text":"Kaum ram ma kaum buka dir vamaram iau.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"U vung togotogo ra nian piragu ta ra luaina mata i kaugu lavur ebar;","poem":1},{"lineBreak":true},{"text":"U tar ku ra ulugu ma ra dangi; kaugu momamomo i buka leke.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A dovot, ra boina ma ra varmari dir a mur iau ta ra lavur bungbung ina laun tana,","poem":1},{"lineBreak":true},{"text":"Ma ina ki ta ra kuba i ra Luluai pa na mutu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}