pa i vavalima vavaongo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ia iat na alube pa ra varvadoan tai ra Luluai,","poem":1},{"lineBreak":true},{"text":"Ma ra takodo na mangamangana tai","poem":1},{"lineBreak":true},{"text":"God kana tena valaun.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nina ra taun tarai ba dia toratorom tana, dia damana,","poem":1},{"lineBreak":true},{"text":"Diat dia tikan upi ra matam, u ra God kai Iakob. Sela.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"A umana mataniolo, avat a tadaraka,","poem":1},{"lineBreak":true},{"text":"Ma ra umana matakilalat pa ania, avat a manga tapapa,","poem":1},{"lineBreak":true},{"text":"Upi ra King na minamar na olo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"To ia ra King na minamar?","poem":1},{"lineBreak":true},{"text":"Ra Luluai, i ongor ma i dekdek,","poem":1},{"lineBreak":true},{"text":"Ra Luluai ra tena ongor ta ra vinarubu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A umana mataniolo, avat a tadaraka,","poem":1},{"lineBreak":true},{"text":"Maia, avat a manga tapapa, avat a umana matakilalat pa ania,","poem":1},{"lineBreak":true},{"text":"Ma ra King na minamar na olo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"To ia go ra King na minamar?","poem":1},{"lineBreak":true},{"text":"Ra Luluai kai ra lavur kor,","poem":1},{"lineBreak":true},{"text":"Ia iat ra King na minamar.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}