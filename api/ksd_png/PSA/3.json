{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"heading","content":["A niaring ta ra malana upi ra maramaravut"]},{"type":"hebrew_subtitle","content":["A kakailai kai David, ba i vilau kan natuna Absalom."]},{"type":"verse","number":1,"content":[{"text":"Luluai, kaugu umana ebar dia tar peal!","poem":1},{"lineBreak":true},{"text":"Mangoro dia tut na tur varbat ure iau.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mangoro dia biti ure iau dari:","poem":1},{"lineBreak":true},{"text":"Pa ta maramaravut kai God pirana. Sela.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ma u, Luluai, u a ramravit kikil iau;","poem":1},{"lineBreak":true},{"text":"U kaugu minamar, ma u vatur ra ulugu urama.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Iau tangi tadav ra Luluai ma ra nilaigu,","poem":1},{"lineBreak":true},{"text":"Ma i torom tagu maro ta kana luana gomgom. Sela.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Iau ga va ma iau ga diop;","poem":1},{"lineBreak":true},{"text":"Iau ga tavangun, tago ra Luluai i maramaravut iau.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pa ina burutue ra ngala na kor na tarai,","poem":1},{"lineBreak":true},{"text":"Nina dia tur kikil bat iau.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Luluai, una tut; una valaun iau, kaugu God.","poem":1},{"lineBreak":true},{"text":"Tago u ga rapu ra pagupagu na ngie i diat par kaugu umana ebar,","poem":1},{"lineBreak":true},{"text":"U tar bubur ra pal a ngie i ra umana tena varpiam.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A valavalaun i tur uka pire ra Luluai;","poem":1},{"lineBreak":true},{"text":"Kaum varvadoan na ki taun kaum tarai. Sela.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}