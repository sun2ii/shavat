{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"heading","content":["A niaring kai ta tikai nina i ki irai kan kana gunan"]},{"type":"verse","number":1,"content":[{"text":"Una kure maravut iau God, ma una tata maravut iau ure ra tarai vakuku.","poem":1},{"lineBreak":true},{"text":"Una valangalanga iau kan ra tarai dia vartuam ma i gegagege ra maukua i diat.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tago u God, u ra dekdekigu; u vung vue iau dave?","poem":1},{"lineBreak":true},{"text":"Ta ra ava ina tenten vurvurbit ma ra tinabun ure ra ebar, nina i arung bat iau?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Una tulue vaarike kaum kapa ma kaum dovotina; boina dir a rap lue iau;","poem":1},{"lineBreak":true},{"text":"Boina ba dir a agure iau ta kaum luana gomgom,","poem":1},{"lineBreak":true},{"text":"Ma tadav ra lavur kubam.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Upi ina tadav ra uguugu kai God,","poem":1},{"lineBreak":true},{"text":"Tadav God, nina iau manga gugu tana,","poem":1},{"lineBreak":true},{"text":"Ma ina pite pa u ma ra pagol, u God, kaugu God.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tulungeagu, u ti lingligur dave?","poem":1},{"lineBreak":true},{"text":"Ma ta ra ava u ngarangarao?","poem":1},{"lineBreak":true},{"text":"Una nurnur tai God, tago ina pite pa ia boko, la iat kaugu tena maramaravut, ma kaugu God.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}